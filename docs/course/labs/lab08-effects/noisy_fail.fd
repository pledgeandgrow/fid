// Lab 8, task 3: a closure that prints, called from a `!{}` function.
// `fid check` rejects it: map_vec's effects at this call include the
// closure's IO, and scaled_total declares none.
//! lab: 8
//! check: rejected
//! error: IO

fn map_vec(v: &Vec<i64>, f: fn(i64) -> i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    for i in 0..v.len() { out.push(f(v.get(i))); }
    return out;
}

fn scaled_total(v: &Vec<i64>, k: i64) -> i64 !{} {
    val scaled: Vec<i64> = map_vec(v, fn(x: i64) -> i64 {
        println("scaling " + int_to_str(x));
        return x * k;
    });
    var s: i64 = 0;
    for i in 0..scaled.len() { s = s + scaled.get(i); }
    return s;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    println(int_to_str(scaled_total(&v, 3)));
    return 0;
}
