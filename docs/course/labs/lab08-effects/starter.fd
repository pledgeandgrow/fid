// Lab 8 starter: a pure core, an effectful shell, and closures.
//! lab: 8
//! check: runs
//
// Tasks (see README.md):
//   1. Write `map_vec(v: &Vec<i64>, f: fn(i64) -> i64) -> Vec<i64>`.
//   2. Write `scaled_total(v: &Vec<i64>, k: i64) -> i64 !Alloc` that
//      calls `map_vec` with a closure capturing `k`, and sums the result.
//      It must keep its `!Alloc` declaration.
//   3. Write `noisy_fail.fd`: the same function with a closure that
//      prints. `fid check` must reject it; explain the error.
//   4. `report` prints "mean" and "max": compute both in the pure
//      `stats` and keep all printing in `report`.

fn celsius_to_f(c: i64) -> i64 !{} {
    return c * 9 / 5 + 32;
}

// TODO 4: return mean and max, without printing
fn stats(temps: &Vec<i64>) -> i64 !{} {
    var s: i64 = 0;
    for i in 0..temps.len() { s = s + temps.get(i); }
    return s / temps.len();
}

fn report(day: str, temps: &Vec<i64>) -> void !{IO, Alloc} {
    println(day + ": mean " + int_to_str(celsius_to_f(stats(temps))) + "F");
}

fn main() -> i64 {
    var mon: Vec<i64> = Vec::new();
    mon.push(8);
    mon.push(14);
    mon.push(11);
    report("mon", &mon);
    // TODO 2: print scaled_total(&mon, 3)
    return 0;
}
