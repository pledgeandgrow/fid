// Lab 8 solution: a pure core, an effectful shell, and closures.
//! lab: 8
//! check: runs
//! playground: no

fn celsius_to_f(c: i64) -> i64 !{} {
    return c * 9 / 5 + 32;
}

fn map_vec(v: &Vec<i64>, f: fn(i64) -> i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    for i in 0..v.len() { out.push(f(v.get(i))); }
    return out;
}

// The closure only reads its capture: map_vec's effects at this call
// are its own Alloc (it builds a Vec) and the closure's, which are none,
// so `!Alloc` holds.
fn scaled_total(v: &Vec<i64>, k: i64) -> i64 !Alloc {
    val scaled: Vec<i64> = map_vec(v, fn(x: i64) -> i64 { return x * k; });
    var s: i64 = 0;
    for i in 0..scaled.len() { s = s + scaled.get(i); }
    return s;
}

struct Stats { mean: i64, max: i64 }

fn stats(temps: &Vec<i64>) -> Stats !{} {
    var s: i64 = 0;
    var m: i64 = temps.get(0);
    for i in 0..temps.len() {
        val t: i64 = temps.get(i);
        s = s + t;
        if t > m { m = t; }
    }
    return Stats { mean: s / temps.len(), max: m };
}

fn report(day: str, temps: &Vec<i64>) -> void !{IO, Alloc} {
    val st: Stats = stats(temps);
    println(day + ": mean " + int_to_str(celsius_to_f(st.mean)) + "F, max "
        + int_to_str(celsius_to_f(st.max)) + "F");
}

fn main() -> i64 {
    var mon: Vec<i64> = Vec::new();
    mon.push(8);
    mon.push(14);
    mon.push(11);
    report("mon", &mon);
    println("scaled total " + int_to_str(scaled_total(&mon, 3)));
    return 0;
}
