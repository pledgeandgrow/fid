// Lab 2 starter: an expression evaluator that cannot panic.
//! lab: 2
//! check: runs
//
// Tasks (see README.md):
//   1. Add a variant `Div(Box<Expr>, Box<Expr>)` and handle it in `eval`
//      and `show`. Read what `fid check` reports before you extend them.
//   2. Make `eval` return `Result<i64, str>`: a division by zero is
//      `Err("division by zero")`, never a panic.
//   3. Write `simplify` so that it folds `x * 1`, `x + 0` and `-(-x)`.

enum Expr {
    Num(i64),
    Add(Box<Expr>, Box<Expr>),
    Mul(Box<Expr>, Box<Expr>),
    Neg(Box<Expr>),
}

fn eval(e: &Expr) -> i64 {
    match e {
        Expr::Num(n) => { return n; }
        Expr::Add(a, b) => { return eval(a) + eval(b); }
        Expr::Mul(a, b) => { return eval(a) * eval(b); }
        Expr::Neg(a) => { return 0 - eval(a); }
    }
}

fn show(e: &Expr) -> str {
    match e {
        Expr::Num(n) => { return int_to_str(n); }
        Expr::Add(a, b) => { return "(" + show(a) + " + " + show(b) + ")"; }
        Expr::Mul(a, b) => { return "(" + show(a) + " * " + show(b) + ")"; }
        Expr::Neg(a) => { return "-" + show(a); }
    }
}

// TODO 3: fold x * 1, x + 0 and -(-x), at every depth.
fn simplify(e: &Expr) -> Expr {
    return Expr::Num(0);
}

fn num(n: i64) -> Box<Expr> { return Box::new(Expr::Num(n)); }

fn report(e: &Expr) {
    println(show(e) + " = " + int_to_str(eval(e)));
}

fn main() -> i64 {
    val e1: Expr = Expr::Mul(Box::new(Expr::Add(num(2), num(3))), Box::new(Expr::Neg(num(4))));
    report(&e1);
    // TODO 1, 2: report (7 + 5) / 4 and 1 / (2 + -2) here
    val messy: Expr = Expr::Add(Box::new(Expr::Mul(Box::new(Expr::Neg(Box::new(Expr::Neg(num(9))))), num(1))), num(0));
    val tidy: Expr = simplify(&messy);
    println(show(&messy) + "  simplifies to  " + show(&tidy));
    return 0;
}
