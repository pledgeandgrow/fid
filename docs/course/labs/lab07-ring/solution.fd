// Lab 7 solution: take the unsafe code out of a ring buffer.
//! lab: 7
//! check: runs
//! playground: no
//! forbid: unsafe
//! forbid: p_malloc

// The slots are a Vec of 8 elements: every access is bounds-checked
// (or the check is removed because (head + i) % 8 is provably in 0..8),
// and the buffer is freed when the Ring goes out of scope.
struct Ring { slots: Vec<i64>, head: i64, count: i64 }

fn ring_new() -> Ring {
    var slots: Vec<i64> = Vec::new();
    for i in 0..8 { slots.push(0); }
    return Ring { slots: slots, head: 0, count: 0 };
}

fn ring_push(r: &mut Ring, x: i64) {
    val slot: i64 = (r.head + r.count) % 8;
    r.slots.set(slot, x);
    if r.count < 8 { r.count = r.count + 1; } else { r.head = (r.head + 1) % 8; }
}

fn ring_sum(r: &Ring) -> i64 {
    var s: i64 = 0;
    for i in 0..r.count { s = s + r.slots.get((r.head + i) % 8); }
    return s;
}

fn ring_items(r: &Ring) -> str {
    var out: str = "";
    for i in 0..r.count {
        if i > 0 { out = out + " "; }
        out = out + int_to_str(r.slots.get((r.head + i) % 8));
    }
    return out;
}

fn main() -> i64 {
    var r: Ring = ring_new();
    for i in 1..11 { ring_push(&mut r, i); }
    println("last 8 sum to " + int_to_str(ring_sum(&r)));
    println("oldest to newest: " + ring_items(&r));
    var total: i64 = 0;
    for frame in 0..3 {
        region scratch {
            var fr: Ring = ring_new();
            for i in 0..20 { ring_push(&mut fr, (frame * 7 + i) % 13); }
            total = total + ring_sum(&fr);
        }
    }
    println("three frames total " + int_to_str(total));
    return 0;
}
