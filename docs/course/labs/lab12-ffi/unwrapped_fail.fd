// Lab 12, task 1: a C call outside `unsafe` is rejected. The compiler
// cannot check what C does, so every call to an extern "C" function must
// sit in an `unsafe` block that says why it is safe.
//! lab: 12
//! check: rejected
//! error: unsafe

extern "C" include "<stdlib.h>" {
    fn atoi as c_atoi(s: str) -> i32;
}

fn main() -> i64 {
    val n: i32 = c_atoi("42");
    println(int_to_str(n as i64));
    return 0;
}
