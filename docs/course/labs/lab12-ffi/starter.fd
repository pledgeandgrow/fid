fn main() -> i64 {
    println("port " + int_to_str(env_int("FID_LAB_PORT", 80)));
    println("unset " + int_to_str(env_int("FID_LAB_UNSET", 80)));
    println("bad " + int_to_str(env_int("FID_LAB_BAD", 80)));
