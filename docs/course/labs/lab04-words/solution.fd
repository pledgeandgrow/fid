// Lab 4 solution: word frequencies, the top n, and a closure.
//! lab: 4
//! check: runs
//! playground: yes

fn words(text: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    for w in str_split(str_to_lower(text), " ") {
        if str_len(w) > 0 { out.push(w); }
    }
    return out;
}

fn frequencies(ws: &Vec<str>) -> HashMap<str, i64> {
    var counts: HashMap<str, i64> = HashMap::new();
    for i in 0..ws.len() {
        val w: str = ws.get(i);
        counts.insert(w, counts.get_or(w, 0) + 1);
    }
    return counts;
}

// true when a sorts before b, byte by byte
fn before(a: str, b: str) -> bool {
    var i: i64 = 0;
    while i < str_len(a) && i < str_len(b) {
        val x: i64 = str_byte_at(a, i);
        val y: i64 = str_byte_at(b, i);
        if x != y { return x < y; }
        i = i + 1;
    }
    return str_len(a) < str_len(b);
}

fn contains(v: &Vec<str>, w: str) -> bool {
    for i in 0..v.len() {
        if v.get(i) == w { return true; }
    }
    return false;
}

// n rounds, each a scan of all k keys for the best one not taken yet:
// O(n * k * n) word comparisons. Sorting the k keys once would be
// O(k log k), better when n is close to k.
fn top(counts: &HashMap<str, i64>, n: i64) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var round: i64 = 0;
    while round < n && round < counts.len() {
        var best: str = "";
        var best_n: i64 = 0;
        for w in counts.keys() {
            if !contains(&out, w) {
                val c: i64 = counts.get(w);
                if c > best_n || (c == best_n && before(w, best)) {
                    best = w;
                    best_n = c;
                }
            }
        }
        out.push(best);
        round = round + 1;
    }
    return out;
}

fn map_words(ws: &Vec<str>, f: fn(str) -> str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    for i in 0..ws.len() { out.push(f(ws.get(i))); }
    return out;
}

fn join(ws: &Vec<str>) -> str {
    var s: str = "";
    for i in 0..ws.len() {
        if i > 0 { s = s + " "; }
        s = s + ws.get(i);
    }
    return s;
}

fn main() -> i64 {
    val text: str = "the cat and the dog and the bird saw a cat chase the dog";
    val ws: Vec<str> = words(text);
    val counts: HashMap<str, i64> = frequencies(&ws);
    println(int_to_str(ws.len()) + " words, " + int_to_str(counts.len()) + " distinct");
    val best: Vec<str> = top(&counts, 4);
    for w in best { println(w + " x" + int_to_str(counts.get(w))); }
    val limit: i64 = 3;
    val loud: Vec<str> = map_words(&ws, fn(w: str) -> str {
        if str_len(w) > limit { return str_to_upper(w); }
        return w;
    });
    println(join(&loud));
    return 0;
}
