fn join(ws: &Vec<str>) -> str {
    var s: str = "";
    for i in 0..ws.len() {
        if i > 0 { s = s + " "; }
        s = s + ws.get(i);
    }
    return s;
}

fn main() -> i64 {
    val text: str = "the cat and the dog and the bird saw a cat chase the dog";
    val ws: Vec<str> = words(text);
    val counts: HashMap<str, i64> = frequencies(&ws);
    println(int_to_str(ws.len()) + " words, " + int_to_str(counts.len()) + " distinct");
    val best: Vec<str> = top(&counts, 4);
    for w in best { println(w + " x" + int_to_str(counts.get(w))); }
    // TODO 3: a closure that captures `limit`
    val limit: i64 = 3;
    println(join(&ws));
    return 0;
}
