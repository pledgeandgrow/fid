// Lab 4 starter: word frequencies, the top n, and a closure.
//! lab: 4
//! check: runs
//
// Tasks (see README.md):
//   1. Write `top(counts, n)`: the n most frequent words, most frequent
//      first, ties broken alphabetically. HashMap keys come in no fixed
//      order, so the result must not depend on it.
//   2. Write `map_words(ws, f)` that applies `f` to every word.
//   3. In `main`, call `map_words` with a closure that upper-cases the
//      words longer than a captured `limit`.

fn words(text: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    for w in str_split(str_to_lower(text), " ") {
        if str_len(w) > 0 { out.push(w); }
    }
    return out;
}

fn frequencies(ws: &Vec<str>) -> HashMap<str, i64> {
    var counts: HashMap<str, i64> = HashMap::new();
    for i in 0..ws.len() {
        val w: str = ws.get(i);
        counts.insert(w, counts.get_or(w, 0) + 1);
    }
    return counts;
}

// true when a sorts before b, byte by byte
fn before(a: str, b: str) -> bool {
    var i: i64 = 0;
    while i < str_len(a) && i < str_len(b) {
        val x: i64 = str_byte_at(a, i);
        val y: i64 = str_byte_at(b, i);
        if x != y { return x < y; }
        i = i + 1;
    }
    return str_len(a) < str_len(b);
}

