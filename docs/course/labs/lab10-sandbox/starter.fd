//! lab: 10
//! check: rejected
//! error: sandbox
//
// `fid check` rejects this file. Tasks (see README.md):
//   1. Read the error: which call does the sandbox refuse, and why?
//   2. Keep the plugin's log without giving it IO: `ranked` returns a
//      `Ranking { scores: Vec<i64>, log: Vec<str> }`, and `main` prints
//      the log after the sandbox block.
//   3. The plugin is configured with a secret key. Print only its
//      fingerprint, through an @declassify function, never the key.

fn vowel_score(w: str) -> i64 {
    var n: i64 = 0;
    for i in 0..str_len(w) {
        val c: i64 = str_byte_at(w, i);
        if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' { n = n + 1; }
    }
    println("scored " + w);
    return n * 10 + str_len(w);
}

fn ranked(words: Vec<str>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    for w in words { out.push(vowel_score(w)); }
    out.sort();
    return out;
}

fn main() -> i64 {
    var words: Vec<str> = Vec::new();
    words.push("audio");
    words.push("rhythm");
    words.push("queue");
    var scores: Vec<i64> = Vec::new();
    sandbox {
        scores = ranked(words);
    }
    for s in scores { println(int_to_str(s)); }
    // TODO 3: @secret val key: str = "hunter2"; print its fingerprint
    return 0;
}
