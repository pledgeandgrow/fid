// Lab 13 starter: threads that share nothing, and one that shares a counter.
//! lab: 13
//! check: rejected
//! error: Race
//
// `fid check` rejects this file. Tasks (see README.md):
//   1. Read the error. Make `handle` correct with `use sync;`: create one
//      mutex in `main` and hold it around the write of `served`.
//   2. Rewrite the word count with `parallel { | ... | ... }`: two
//      branches `a = count_long(left, 7)` and `b = count_long(right, 7)`.
//   3. Print how many requests were served once both tasks are joined.

var served: i64 = 0;

fn handle(id: i64) -> i64 {
    served = served + 1;
    return id * 10;
}

fn count_long(words: Vec<str>, min: i64) -> i64 {
    var n: i64 = 0;
    for w in words {
        if str_len(w) >= min { n = n + 1; }
    }
    return n;
}

fn split_half(words: &Vec<str>, first: bool) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    val mid: i64 = words.len() / 2;
    for i in 0..words.len() {
        if (i < mid) == first { out.push(words.get(i)); }
    }
    return out;
}

fn main() -> i64 {
    val r1 = spawn handle(1);
    val r2 = spawn handle(2);
    println("responses " + int_to_str((await r1) + (await r2)));
    val words: Vec<str> = str_split("ownership borrows regions effects capabilities sandbox layouts ffi", " ");
    val left: Vec<str> = split_half(&words, true);
    val right: Vec<str> = split_half(&words, false);
    val a = spawn count_long(left, 7);
    val b = spawn count_long(right, 7);
    println("long words: " + int_to_str((await a) + (await b)) + " of " + int_to_str(words.len()));
    return 0;
}
