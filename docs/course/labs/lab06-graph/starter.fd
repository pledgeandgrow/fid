// Lab 6 starter: a graph without references between nodes.
//! lab: 6
//! check: rejected
//! error: borrow
//
// `fid check` rejects this file. Tasks (see README.md):
//   1. Read the error. Then replace `link`, which needs two `&mut Node`
//      at once, by `add_edge(g: &mut Graph, x: i64, y: i64)`: edges are
//      indexes into `g.nodes`, and a self-loop (x == y) must work.
//   2. Write `dfs(g: &Graph, start: i64, seen: &mut Vec<bool>) -> Vec<i64>`:
//      the nodes reachable from `start`, in depth-first order, lower
//      indexes first, with an explicit stack (no recursion).
//   3. Print the visit order from node 0 and the number of connected
//      components.

struct Node { name: str, edges: Vec<i64> }
struct Graph { nodes: Vec<Node> }

fn node(name: str) -> Node { return Node { name: name, edges: Vec::new() }; }

fn link(a: &mut Node, b: &mut Node, a_id: i64, b_id: i64) {
    a.edges.push(b_id);
    b.edges.push(a_id);
}

fn main() -> i64 {
    var a: Node = node("a");
    var b: Node = node("b");
    var d: Node = node("d");
    link(&mut a, &mut b, 0, 1);
    link(&mut b, &mut d, 1, 3);
    link(&mut d, &mut d, 3, 3);      // a self-loop
    var g: Graph = Graph { nodes: Vec::new() };
    g.nodes.push(a);
    g.nodes.push(b);
    g.nodes.push(node("c"));
    g.nodes.push(d);
    println(int_to_str(g.nodes.len()) + " nodes");
    return 0;
}
