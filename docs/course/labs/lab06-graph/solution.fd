// Lab 6 solution: a graph without references between nodes.
//! lab: 6
//! check: runs
//! playground: yes

struct Node { name: str, edges: Vec<i64> }
struct Graph { nodes: Vec<Node> }

fn node(name: str) -> Node { return Node { name: name, edges: Vec::new() }; }

fn add_node(g: &mut Graph, name: str) -> i64 {
    g.nodes.push(node(name));
    return g.nodes.len() - 1;
}

// A Node read out of the Vec is a value: change it, then store it back.
// One &mut (to the graph) is held at a time, so x == y is no special case.
fn add_edge(g: &mut Graph, x: i64, y: i64) {
    var a: Node = g.nodes.get(x);
    a.edges.push(y);
    g.nodes.set(x, a);
    var b: Node = g.nodes.get(y);
    b.edges.push(x);
    g.nodes.set(y, b);
}

fn dfs(g: &Graph, start: i64, seen: &mut Vec<bool>) -> Vec<i64> {
    var order: Vec<i64> = Vec::new();
    var stack: Vec<i64> = Vec::new();
    stack.push(start);
    while stack.len() > 0 {
        val x: i64 = stack.pop();
        if !seen.get(x) {
            seen.set(x, true);
            order.push(x);
            val n: Node = g.nodes.get(x);
            // push the neighbours highest first, so the lowest is visited first
            var i: i64 = n.edges.len() - 1;
            while i >= 0 {
                val y: i64 = n.edges.get(i);
                if !seen.get(y) { stack.push(y); }
                i = i - 1;
            }
        }
    }
    return order;
}

fn names(g: &Graph, ids: &Vec<i64>) -> str {
    var s: str = "";
    for i in 0..ids.len() {
        if i > 0 { s = s + " "; }
        val n: Node = g.nodes.get(ids.get(i));
        s = s + n.name;
    }
    return s;
}

fn main() -> i64 {
    var g: Graph = Graph { nodes: Vec::new() };
    val a: i64 = add_node(&mut g, "a");
    val b: i64 = add_node(&mut g, "b");
    val c: i64 = add_node(&mut g, "c");
    val d: i64 = add_node(&mut g, "d");
    val e: i64 = add_node(&mut g, "e");
    val f: i64 = add_node(&mut g, "f");
    add_edge(&mut g, a, b);
    add_edge(&mut g, b, d);
    add_edge(&mut g, d, d);
    add_edge(&mut g, a, c);
    add_edge(&mut g, c, d);
    add_edge(&mut g, e, f);
    println(int_to_str(g.nodes.len()) + " nodes");
    var seen: Vec<bool> = Vec::new();
    for i in 0..g.nodes.len() { seen.push(false); }
    val first: Vec<i64> = dfs(&g, a, &mut seen);
    println("from a: " + names(&g, &first));
    var components: i64 = 1;
    for i in 0..g.nodes.len() {
        if !seen.get(i) {
            val more: Vec<i64> = dfs(&g, i, &mut seen);
            println("another component: " + names(&g, &more));
            components = components + 1;
        }
    }
    println(int_to_str(components) + " components");
    return 0;
}
