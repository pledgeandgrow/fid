// Lab 9 starter: functions the compiler proves cannot crash.
//! lab: 9
//! check: rejected
//! error: crashfree
//
// `fid check` rejects this file. Tasks (see README.md):
//   1. Make `safe_div` pass @crashfree: it returns Option<i64>, None for
//      a zero divisor.
//   2. Write `average(v: &Vec<i64>) -> Option<i64>` that passes
//      @crashfree (None for an empty Vec).
//   3. Make `fact` pass @crashfree and @no-recursion, returning Some for
//      n in 0..=20 and None otherwise.
//   4. Print the results listed at the end of `main`.

@crashfree
fn safe_div(a: i64, b: i64) -> i64 {
    return a / b;
}

@crashfree @no-recursion
fn fact(n: i64) -> i64 {
    if n <= 1 { return 1; }
    return n * fact(n - 1);
}

fn show(o: Option<i64>) -> str {
    match o {
        Option::Some(x) => { return int_to_str(x); }
        Option::None => { return "none"; }
    }
}

fn main() -> i64 {
    println(int_to_str(safe_div(10, 3)));
    println(int_to_str(fact(5)));
    // TODO 4: safe_div(7, 0), average of [3, 4, 8], average of [],
    //         fact(20), fact(21), fact(-1)
    return 0;
}
