// Lab 9 solution: functions the compiler proves cannot crash.
//! lab: 9
//! check: runs
//! playground: yes

@crashfree @no-alloc @no-recursion
fn safe_div(a: i64, b: i64) -> Option<i64> {
    if b == 0 { return Option::None; }
    if b == -1 { return Option::None; }    // MIN / -1 overflows; a / -1 is -a
    return Option::Some(a / b);
}

// A `for` over the Vec itself: no index, so nothing can be out of
// bounds. The sum and the count wrap instead of panicking (@wrapping),
// the price of @crashfree here; the division goes through safe_div,
// which handles the empty Vec.
@crashfree @no-recursion @wrapping
fn average(v: Vec<i64>) -> Option<i64> {
    var s: i64 = 0;
    var n: i64 = 0;
    for x in v {
        s = s + x;
        n = n + 1;
    }
    return safe_div(s, n);
}

// A for loop instead of recursion (a while loop is unbounded, which
// @crashfree rejects); 20! is the largest factorial in i64, so the
// product cannot wrap for the n it accepts.
@crashfree @no-alloc @no-recursion @wrapping
fn fact(n: i64) -> Option<i64> {
    if n < 0 || n > 20 { return Option::None; }
    var p: i64 = 1;
    for i in 2..n + 1 { p = p * i; }
    return Option::Some(p);
}

fn show(o: Option<i64>) -> str {
    match o {
        Option::Some(x) => { return int_to_str(x); }
        Option::None => { return "none"; }
    }
}

fn main() -> i64 {
    println("10 / 3 = " + show(safe_div(10, 3)));
    println("7 / 0 = " + show(safe_div(7, 0)));
    var v: Vec<i64> = Vec::new();
    v.push(3);
    v.push(4);
    v.push(8);
    println("average of 3 4 8 = " + show(average(v)));
    val empty: Vec<i64> = Vec::new();
    println("average of nothing = " + show(average(empty)));
    println("5! = " + show(fact(5)));
    println("20! = " + show(fact(20)));
    println("21! = " + show(fact(21)));
    println("(-1)! = " + show(fact(-1)));
    return 0;
}
