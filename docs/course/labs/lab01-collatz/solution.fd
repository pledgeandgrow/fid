// Lab 1 solution: the longest Collatz chain, and how high it climbs.
//! lab: 1
//! check: runs
//! playground: yes

fn steps(start: i64) -> i64 {
    var n: i64 = start;
    var count: i64 = 0;
    while n != 1 {
        if n % 2 == 0 { n = n / 2; } else { n = 3 * n + 1; }
        count = count + 1;
    }
    return count;
}

// The chain never leaves i64 below 10,000: its peak is under 3 * 10^7.
fn peak(start: i64) -> i64 {
    var n: i64 = start;
    var top: i64 = start;
    while n != 1 {
        if n % 2 == 0 { n = n / 2; } else { n = 3 * n + 1; }
        if n > top { top = n; }
    }
    return top;
}

// A million bytes of at most 255 sum to at most 255,000,000: an i64
// accumulator cannot overflow, a u8 one overflows at the second 200.
fn sum_bytes(v: Vec<u8>) -> i64 {
    var s: i64 = 0;
    for b in v { s = s + (b as i64); }
    return s;
}

fn main() -> i64 {
    val limit: i64 = 10000;
    var best: i64 = 0;
    var arg: i64 = 1;
    for i in 1..limit {
        val s: i64 = steps(i);
        if s > best { best = s; arg = i; }
    }
    println(f"longest below {limit}: {arg} takes {best} steps");
    println(f"its peak: {peak(arg)}");
    var bytes: Vec<u8> = Vec::new();
    for i in 0..300 { bytes.push(200); }
    println(f"sum of {bytes.len()} bytes: {sum_bytes(bytes)}");
    return 0;
}
