// Lab 1 starter: the longest Collatz chain, and how high it climbs.
//! lab: 1
//! check: runs
//
// Tasks (see README.md):
//   1. Search every start below 10,000 instead of below 30.
//   2. Write `peak(start)`: the largest value the chain reaches.
//   3. Write `sum_bytes(v)` so that adding up to a million u8 values
//      can never overflow, and print the sum of 300 bytes of 200.

fn steps(start: i64) -> i64 {
    var n: i64 = start;
    var count: i64 = 0;
    while n != 1 {
        if n % 2 == 0 { n = n / 2; } else { n = 3 * n + 1; }
        count = count + 1;
    }
    return count;
}

// TODO 2: return the largest value of n on the way from start to 1.
fn peak(start: i64) -> i64 {
    return start;
}

// TODO 3: this panics on overflow for 2 bytes of 200. Change the
// accumulator (not the parameter) so that it cannot.
fn sum_bytes(v: Vec<u8>) -> u8 {
    var s: u8 = 0;
    for b in v { s = s + b; }
    return s;
}

fn main() -> i64 {
    val limit: i64 = 30;            // TODO 1
    var best: i64 = 0;
    var arg: i64 = 1;
    for i in 1..limit {
        val s: i64 = steps(i);
        if s > best { best = s; arg = i; }
    }
    println(f"longest below {limit}: {arg} takes {best} steps");
    println(f"its peak: {peak(arg)}");
    var bytes: Vec<u8> = Vec::new();
    for i in 0..1 { bytes.push(200); }   // TODO 3: 300 bytes
    println(f"sum of {bytes.len()} bytes: {sum_bytes(bytes)}");
    return 0;
}
