// Lab 11 starter: layouts in memory and on the wire.
//! lab: 11
//! check: runs
//
// Tasks (see README.md):
//   1. Reorder Header's fields so that its @repr(C) size is as small as
//      it can be. State the rule you used; struct_size checks it.
//   2. Write `encode(h: Header) -> Vec<u8>`: the 13 bytes of the @packed
//      layout (tag, then len, then id), little-endian, without `unsafe`.
//   3. Write `decode(b: &Vec<u8>) -> Option<Header>` (None unless there
//      are exactly 13 bytes) and check that decode(encode(h)) gives h
//      back for the edge values in `main`.

@repr(C)
struct Header {
    tag: u8,
    id: u64,
    len: u32,
}

@packed
struct Wire {
    tag: u8,
    len: u32,
    id: u64,
}

fn hex2(x: i64) -> str {
    val digits: str = "0123456789abcdef";
    return str_slice(digits, (x >> 4) & 15, ((x >> 4) & 15) + 1) + str_slice(digits, x & 15, (x & 15) + 1);
}

// TODO 2
fn encode(h: Header) -> Vec<u8> {
    var out: Vec<u8> = Vec::new();
    return out;
}

// TODO 3
fn decode(b: &Vec<u8>) -> Option<Header> {
    return Option::None;
}

fn main() -> i64 {
    println("Header: " + int_to_str(comptime struct_size(Header)) + " bytes");
    println("Wire:   " + int_to_str(comptime struct_size(Wire)) + " bytes");
    val h: Header = Header { tag: 7, id: 4294967295, len: 513 };
    var line: str = "";
    for b in encode(h) {
        if str_len(line) > 0 { line = line + " "; }
        line = line + hex2(b as i64);
    }
    println("encoded: " + line);
    return 0;
}
