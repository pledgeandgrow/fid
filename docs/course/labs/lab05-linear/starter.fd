// Lab 5 starter: a file handle that must be closed exactly once.
//! lab: 5
//! check: rejected
//! error: linear
//
// `fid check` rejects this file. Tasks (see README.md):
//   1. Read the error, then fix `load` so that every path closes the
//      handle exactly once.
//   2. Add a second error path (a file whose text starts with '#' is
//      "commented out": return -2) and keep the checker happy.
//   3. Make `copies` print what the comments say: a copy of a Vec is a
//      new value, and changing it leaves the original alone.

@linear
struct Handle { name: str, pos: i64 }

fn open(name: str) -> Handle {
    println("open " + name);
    return Handle { name: name, pos: 0 };
}

// Borrows the handle: the caller still owns it and must close it.
fn read_all(h: &mut Handle) -> str {
    if h.name == "empty.txt" { return ""; }
    h.pos = 12;
    if h.name == "notes.txt" { return "# draft only"; }
    return "hello, world";
}

fn close(h: Handle) {
    println("close " + h.name + " at " + int_to_str(h.pos));
}

fn load(name: str) -> i64 {
    var h: Handle = open(name);
    val text: str = read_all(&mut h);
    if str_len(text) == 0 {
        return -1;                  // the handle is lost on this path
    } else {
        close(h);
        return str_len(text);
    }
}

fn copies() {
    var a: Vec<i64> = Vec::new();
    a.push(1);
    a.push(2);
    var b: Vec<i64> = a;
    // TODO 3: push 3 onto b, then print both lengths: "a has 2, b has 3"
}

fn main() -> i64 {
    println(int_to_str(load("hello.txt")));
    println(int_to_str(load("empty.txt")));
    println(int_to_str(load("notes.txt")));
    copies();
    return 0;
}
