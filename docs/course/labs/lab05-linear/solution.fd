// Lab 5 solution: a file handle that must be closed exactly once.
//! lab: 5
//! check: runs
//! playground: no

@linear
struct Handle { name: str, pos: i64 }

fn open(name: str) -> Handle {
    println("open " + name);
    return Handle { name: name, pos: 0 };
}

// Borrows the handle: the caller still owns it and must close it.
fn read_all(h: &mut Handle) -> str {
    if h.name == "empty.txt" { return ""; }
    h.pos = 12;
    if h.name == "notes.txt" { return "# draft only"; }
    return "hello, world";
}

fn close(h: Handle) {
    println("close " + h.name + " at " + int_to_str(h.pos));
}

// Every return is preceded by exactly one close: the @linear check
// rejects a path that loses the handle and a path that closes it twice.
fn load(name: str) -> i64 {
    var h: Handle = open(name);
    val text: str = read_all(&mut h);
    if str_len(text) == 0 {
        close(h);
        return -1;
    }
    if str_byte_at(text, 0) == '#' {
        close(h);
        return -2;
    }
    close(h);
    return str_len(text);
}

fn copies() {
    var a: Vec<i64> = Vec::new();
    a.push(1);
    a.push(2);
    var b: Vec<i64> = a;
    b.push(3);
    println("a has " + int_to_str(a.len()) + ", b has " + int_to_str(b.len()));
}

fn main() -> i64 {
    println(int_to_str(load("hello.txt")));
    println(int_to_str(load("empty.txt")));
    println(int_to_str(load("notes.txt")));
    copies();
    return 0;
}
