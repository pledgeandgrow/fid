// test_ct_asm_fail.fd — @constant_time violation that only the post-codegen
// assembly verifier catches.
//
// The source-level check (TypeChecker::verify_constant_time) enforces only:
// no IO/Net/Spawn effects, no early returns, transitive @constant_time calls.
// It does NOT reject `if` on data. So this file type-checks, runs in the
// interpreter, compiles via C and emits a PE — it is a valid program and is
// NOT in the expected-fail list of `fidesc test`.
//
// What fails: `fidesc build test_ct_asm_fail.fd --target x86-64`, because
// the x86-64 text of `leaky_eq` contains `cmpq ... / sete / testq / jne`
// (a data-dependent conditional jump) and `jo` overflow traps. The unit test
// `ct_asm_fail_fixture_is_rejected` in src/codegen_x64.rs asserts this.

@constant_time
fn leaky_eq(a: i64, b: i64) -> i64 {
    var result = 0;
    if a == b {
        result = 1;
    } else {
        result = 0;
    }
    return result;
}

fn main() {
    print(leaky_eq(5, 5));
    print(leaky_eq(5, 6));
}
