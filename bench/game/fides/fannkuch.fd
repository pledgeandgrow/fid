// fannkuch-redux (the Benchmarks Game, roadmap BM3): every permutation of
// 0..n-1 in the reference order and the pancake flips of each, n = 11.
// Prints checksum * 1000 + the most flips (one integer: 556355 and 51 for
// n = 11 print 556355051). tests/bootstrap/test_verify_bm_fannkuch.fd is
// this program with n = 7 (228 and 16).
fn fannkuch(n: i64) -> i64 {
    var perm1: Vec<i64> = Vec::new();
    var count: Vec<i64> = Vec::new();
    var perm: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        perm1.push(i);
        count.push(0);
        perm.push(0);
        i = i + 1;
    }
    var maxflips: i64 = 0;
    var checksum: i64 = 0;
    var permcount: i64 = 0;
    var r: i64 = n;
    var done: bool = false;
    while !done {
        while r != 1 {
            count.set(r - 1, r);
            r = r - 1;
        }
        i = 0;
        while i < n {
            perm.set(i, perm1.get(i));
            i = i + 1;
        }
        // flip the first k + 1 until 0 is in front
        var flips: i64 = 0;
        var k: i64 = perm.get(0);
        while k != 0 {
            var a: i64 = 0;
            var b: i64 = k;
            while a < b {
                val t: i64 = perm.get(a);
                perm.set(a, perm.get(b));
                perm.set(b, t);
                a = a + 1;
                b = b - 1;
            }
            flips = flips + 1;
            k = perm.get(0);
        }
        if flips > maxflips {
            maxflips = flips;
        }
        if permcount % 2 == 0 {
            checksum = checksum + flips;
        } else {
            checksum = checksum - flips;
        }
        // the next permutation: rotate the first r + 1 elements
        var next: bool = false;
        while !next && !done {
            if r == n {
                done = true;
            } else {
                val p0: i64 = perm1.get(0);
                i = 0;
                while i < r {
                    perm1.set(i, perm1.get(i + 1));
                    i = i + 1;
                }
                perm1.set(r, p0);
                count.set(r, count.get(r) - 1);
                if count.get(r) > 0 {
                    next = true;
                } else {
                    r = r + 1;
                }
            }
        }
        permcount = permcount + 1;
    }
    return checksum * 1000 + maxflips;
}

fn main() -> i64 {
    println(fannkuch(11));
    return 0;
}
