// pidigits (the Benchmarks Game, roadmap BM3): the first 10000 digits of
// pi from Gibbons' unbounded spigot, the benchmark's algorithm and order of
// operations: for k = 1, 2, ..: acc = (acc + 2 num) (2k + 1),
// den = den (2k + 1), num = num k; when num <= acc and (3 num + acc) / den
// equals (4 num + acc) / den, that quotient is the next digit d, and
// acc = 10 (acc - d den), num = 10 num. Big integers from stdlib/bigint.fd.
// Instead of printing the digits, the program folds them into a 32-bit hash,
// h = h * 31 + d, and prints it (bench/game/reference.py gives the value).
// tests/bootstrap/test_verify_bm_pidigits.fd is this program with 50
// digits.
use bigint;

fn pidigits(count: i64) -> i64 {
    var num: BigInt = bigint_one();
    var acc: BigInt = bigint_zero();
    var den: BigInt = bigint_one();
    var k: i64 = 0;
    var i: i64 = 0;
    var h: i64 = 0;
    while i < count {
        k = k + 1;
        val k2: i64 = 2 * k + 1;
        acc = bigint_mul_i64(bigint_add(acc, bigint_mul_i64(num, 2)), k2);
        den = bigint_mul_i64(den, k2);
        num = bigint_mul_i64(num, k);
        if bigint_gt(num, acc) {
            continue;
        }
        val d: i64 = bigint_to_i64(bigint_div(bigint_add(bigint_mul_i64(num, 3), acc), den));
        val d4: i64 = bigint_to_i64(bigint_div(bigint_add(bigint_mul_i64(num, 4), acc), den));
        if d != d4 {
            continue;
        }
        h = (h * 31 + d) & 4294967295;
        i = i + 1;
        acc = bigint_mul_i64(bigint_sub(acc, bigint_mul_i64(den, d)), 10);
        num = bigint_mul_i64(num, 10);
    }
    return h;
}

fn main() -> i64 {
    println(pidigits(10000));
    return 0;
}
