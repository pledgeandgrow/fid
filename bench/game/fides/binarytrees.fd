// binary-trees (the Benchmarks Game, roadmap BM3): allocate and walk
// perfect binary trees. A stretch tree of depth max + 1, a long-lived tree
// of depth max kept to the end, and for each depth d = min, min + 2, .., max
// 2^(max - d + min) trees of depth d, each built, counted and dropped
// (min 4, max 16). Prints the sum of every tree's node count (14985902).
// tests/bootstrap/test_verify_bm_binarytrees.fd is this program with max 6.
enum Tree {
    Leaf,
    Node(Box<Tree>, Box<Tree>),
}

fn make(d: i64) -> Box<Tree> {
    if d == 0 {
        return Box::new(Tree::Node(Box::new(Tree::Leaf), Box::new(Tree::Leaf)));
    }
    return Box::new(Tree::Node(make(d - 1), make(d - 1)));
}

// the nodes of a tree; a Leaf is no node
fn check(t: Box<Tree>) -> i64 {
    match t {
        Tree::Leaf => { return 0; }
        Tree::Node(l, r) => { return 1 + check(l) + check(r); }
    }
}

fn trees(min_depth: i64, max_depth: i64) -> i64 {
    var total: i64 = check(make(max_depth + 1));
    val long_lived: Box<Tree> = make(max_depth);
    var d: i64 = min_depth;
    while d <= max_depth {
        val iters: i64 = 1 << (max_depth - d + min_depth);
        var i: i64 = 0;
        while i < iters {
            total = total + check(make(d));
            i = i + 1;
        }
        d = d + 2;
    }
    return total + check(long_lived);
}

fn main() -> i64 {
    println(trees(4, 16));
    return 0;
}
