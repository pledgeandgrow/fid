// mandelbrot (the Benchmarks Game, roadmap BM3): the n x n points of
// [-1.5, 0.5] x [-1, 1], at most 50 iterations each, n = 4000. The game
// writes the bitmap; this prints how many points stay in the set (one
// integer, the same in every language: the iteration is the reference one,
// in the same order). tests/bootstrap/test_verify_bm_mandelbrot.fd is this
// program with n = 64.
fn mandelbrot(n: i64) -> i64 {
    var count: i64 = 0;
    val nf: f64 = n as f64;
    var y: i64 = 0;
    while y < n {
        val ci: f64 = 2.0 * (y as f64) / nf - 1.0;
        var x: i64 = 0;
        while x < n {
            val cr: f64 = 2.0 * (x as f64) / nf - 1.5;
            var zr: f64 = 0.0;
            var zi: f64 = 0.0;
            var tr: f64 = 0.0;
            var ti: f64 = 0.0;
            var i: i64 = 0;
            while i < 50 && tr + ti <= 4.0 {
                zi = 2.0 * zr * zi + ci;
                zr = tr - ti + cr;
                tr = zr * zr;
                ti = zi * zi;
                i = i + 1;
            }
            if tr + ti <= 4.0 {
                count = count + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return count;
}

fn main() -> i64 {
    println(mandelbrot(4000));
    return 0;
}
