// spectral-norm (the Benchmarks Game, roadmap BM3): the spectral norm of
// the infinite matrix A(i, j) = 1 / ((i + j)(i + j + 1) / 2 + i + 1), by ten
// rounds of the power method on A^T A, n = 2000. Prints the norm times 1e9,
// truncated toward zero (one integer). Each product returns a new Vec (40
// in all); the sums run in index order, as in every other language.
// tests/bootstrap/test_verify_bm_spectral.fd is this program with n = 50.
use math;

fn eval_a(i: i64, j: i64) -> f64 {
    return 1.0 / ((((i + j) * (i + j + 1)) / 2 + i + 1) as f64);
}

// A v
fn mul_av(v: Vec<f64>, n: i64) -> Vec<f64> {
    var out: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var s: f64 = 0.0;
        var j: i64 = 0;
        while j < n {
            s = s + eval_a(i, j) * v.get(j);
            j = j + 1;
        }
        out.push(s);
        i = i + 1;
    }
    return out;
}

// A^T v
fn mul_atv(v: Vec<f64>, n: i64) -> Vec<f64> {
    var out: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var s: f64 = 0.0;
        var j: i64 = 0;
        while j < n {
            s = s + eval_a(j, i) * v.get(j);
            j = j + 1;
        }
        out.push(s);
        i = i + 1;
    }
    return out;
}

// A^T A v
fn mul_atav(v: Vec<f64>, n: i64) -> Vec<f64> {
    val t: Vec<f64> = mul_av(v, n);
    return mul_atv(t, n);
}

fn spectral(n: i64) -> i64 {
    var u: Vec<f64> = Vec::new();
    var v: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        u.push(1.0);
        i = i + 1;
    }
    var k: i64 = 0;
    while k < 10 {
        v = mul_atav(u, n);
        u = mul_atav(v, n);
        k = k + 1;
    }
    var vbv: f64 = 0.0;
    var vv: f64 = 0.0;
    i = 0;
    while i < n {
        vbv = vbv + u.get(i) * v.get(i);
        vv = vv + v.get(i) * v.get(i);
        i = i + 1;
    }
    return (math_sqrt(vbv / vv) * 1000000000.0) as i64;
}

fn main() -> i64 {
    println(spectral(2000));
    return 0;
}
