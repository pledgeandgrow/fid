fn main() -> i64 {
    val n: i64 = 1000000;
    var m: HashMap<str, i64> = HashMap::new();
    var i: i64 = 0;
    while i < n {
        m.insert("key" + int_to_str(i), i);
        i = i + 1;
    }
    var sum: i64 = 0;
    i = 0;
    while i < n {
        sum = sum + m.get("key" + int_to_str(i));
        i = i + 1;
    }
    println(sum);
    return 0;
}
