fn main() -> i64 {
    val n: i64 = 20000000;
    var is: Vec<u8> = Vec::filled(n, 1);
    var i: i64 = 0;
    is.set(0, 0);
    is.set(1, 0);
    var p: i64 = 2;
    while p * p < n {
        if is.get(p) == 1 {
            var m: i64 = p * p;
            while m < n { is.set(m, 0); m = m + p; }
        }
        p = p + 1;
    }
    var count: i64 = 0;
    i = 0;
    while i < n { count = count + (is.get(i) as i64); i = i + 1; }
    println(count);
    return 0;
}
