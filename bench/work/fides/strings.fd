// strings (roadmap BM4, real work): "0,1,2,...," for 2,000,000 numbers built
// with the language's string builder, then a hash of every byte of the
// result. Prints hash * 100000000 + length (one integer).
// tests/bootstrap/test_verify_bm_strings.fd: n = 1000.
fn strings(n: i64) -> i64 {
    var sb: StringBuilder = StringBuilder::new();
    var i: i64 = 0;
    while i < n {
        sb.append_int(i);
        sb.append_char(44);
        i = i + 1;
    }
    val s: str = sb.to_str();
    val len: i64 = str_len(s);
    var h: i64 = 0;
    i = 0;
    while i < len {
        h = (h * 31 + str_byte_at(s, i)) % 1000000007;
        i = i + 1;
    }
    return h * 100000000 + len;
}

fn main() -> i64 {
    println(strings(2000000));
    return 0;
}
