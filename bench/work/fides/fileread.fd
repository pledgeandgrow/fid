// fileread (roadmap BM4, real work): read a 50 MB text file three times and
// sum the numbers in it, the same algorithm in every language. The file,
// out/fileread.dat (run.sh runs the programs from bench/, so it lands in
// bench/out/), is 2150000 lines "rec<k> <a> x<b>\n" from a fixed linear
// congruential generator, 49994158 bytes; a program writes it first when it
// is missing or has another size, so the first language to run pays for
// that once. A scan adds up every run of digits and the number of lines.
// Prints the sum over the three reads: 10099325147547.
// tests/bootstrap/test_verify_bm_fileread.fd: 200 lines, 3 reads (277425888).

fn fr_generate(path: str, lines: i64) {
    var sb: StringBuilder = StringBuilder::new();
    var s: i64 = 1;
    var k: i64 = 0;
    while k < lines {
        s = (s * 1103515245 + 12345) % 2147483648;
        val r1: i64 = s >> 8;
        s = (s * 1103515245 + 12345) % 2147483648;
        val r2: i64 = s >> 8;
        sb.append_str("rec");
        sb.append_int(k);
        sb.append_char(32);
        sb.append_int(r1 % 1000000);
        sb.append_str(" x");
        sb.append_int(r2 % 10000);
        sb.append_char(10);
        k = k + 1;
    }
    val text: str = sb.to_str();
    p_file_write(path, text);
}

fn fr_scan(d: str) -> i64 {
    val n: i64 = str_len(d);
    var tot: i64 = 0;
    var cur: i64 = 0;
    var ind: bool = false;
    var lines: i64 = 0;
    var i: i64 = 0;
    while i < n {
        val b: i64 = str_byte_at(d, i);
        if b >= 48 && b <= 57 {
            cur = cur * 10 + b - 48;
            ind = true;
        } else {
            if ind {
                tot = tot + cur;
                cur = 0;
                ind = false;
            }
            if b == 10 {
                lines = lines + 1;
            }
        }
        i = i + 1;
    }
    if ind {
        tot = tot + cur;
    }
    return tot + lines;
}

fn fileread(path: str, lines: i64, size: i64, reads: i64) -> i64 {
    // the size from the file system (-1 when it is missing), not a read
    if p_file_size(path) != size {
        fr_generate(path, lines);
    }
    var total: i64 = 0;
    var r: i64 = 0;
    while r < reads {
        match read_file(path) {
            Option::Some(d) => {
                total = total + fr_scan(d);
            }
            Option::None => {
                println("cannot read " + path);
                return -1;
            }
        }
        r = r + 1;
    }
    return total;
}

fn main() -> i64 {
    println(fileread("out/fileread.dat", 2150000, 49994158, 3));
    return 0;
}
