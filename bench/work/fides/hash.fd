// hash (roadmap BM4, real work): FNV-1a 64 over a 50 MB byte buffer, four
// times. Prints the hash as a signed 64-bit integer. The hash wraps, so
// its function is `@wrapping` (reference §3.5).
// tests/bootstrap/test_verify_bm_hash.fd: 1000 bytes, two rounds.
@wrapping
fn fnv(data: Vec<u8>, rounds: i64) -> i64 {
    var h: i64 = -3750763034362895579;
    val n: i64 = data.len();
    var r: i64 = 0;
    while r < rounds {
        var i: i64 = 0;
        while i < n {
            h = (h ^ (data.get(i) as i64)) * 1099511628211;
            i = i + 1;
        }
        r = r + 1;
    }
    return h;
}

fn hash(n: i64, rounds: i64) -> i64 {
    var data: Vec<u8> = Vec::filled(n, 0);
    var i: i64 = 0;
    while i < n {
        data.set(i, ((i * 7 + i / 256) % 256) as u8);
        i = i + 1;
    }
    return fnv(data, rounds);
}

fn main() -> i64 {
    println(hash(50000000, 4));
    return 0;
}
