// sort (roadmap BM4, real work): 5,000,000 pseudo-random integers (a
// linear congruential generator, the same in every language) sorted with
// the language's own sort, then a checksum of the sorted order. Prints one
// integer. tests/bootstrap/test_verify_bm_sort.fd: n = 1000.
fn sortsum(n: i64) -> i64 {
    var v: Vec<i64> = Vec::new();
    var x: i64 = 12345;
    var i: i64 = 0;
    while i < n {
        x = (x * 1103515245 + 12345) % 2147483648;
        v.push(x);
        i = i + 1;
    }
    v.sort();
    var s: i64 = 0;
    i = 0;
    while i < n {
        s = (s + v.get(i) * (i % 1000)) % 1000000007;
        i = i + 1;
    }
    return s;
}

fn main() -> i64 {
    println(sortsum(5000000));
    return 0;
}
