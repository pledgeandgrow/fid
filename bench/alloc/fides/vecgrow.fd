// alloc/vecgrow (competitive roadmap RT8, item 1): growing Vecs, the
// buffers core allocates and fills before anything reads them
// (vec_buf_alloc_uninit: a grown buffer's elements are copied in, the room
// after them written by the pushes that take it). 300 rounds; each grows a
// Vec<i64> to 20,000 elements, a Vec<u8> to 20,000 bytes and a Vec<str> to
// 2,000 strings by push, takes a copy of the first and changes it (the copy
// gets a buffer of its own), and fills a Vec::filled. Prints a checksum
// (deterministic: the same on every backend, before and after).

struct Pt {
    x: i64,
    y: i64,
}

fn round(r: i64) -> i64 {
    var ints: Vec<i64> = Vec::new();
    var bytes: Vec<u8> = Vec::new();
    var i: i64 = 0;
    while i < 20000 {
        ints.push(i * 3 + r);
        bytes.push(((i + r) % 251) as u8);
        i = i + 1;
    }
    var strs: Vec<str> = Vec::new();
    var pts: Vec<Pt> = Vec::new();
    var j: i64 = 0;
    while j < 2000 {
        strs.push(int_to_str(j + r));
        pts.push(Pt { x: j, y: r });
        j = j + 1;
    }
    var cp: Vec<i64> = ints.clone();
    cp.set(7, 1000000);
    cp.push(5);
    val filled: Vec<i64> = Vec::filled(5000, r);
    var sum: i64 = ints.len() + cp.len() + cp.get(7) + ints.get(7) + ints.get(19999);
    sum = sum + (bytes.get(12345) as i64) + bytes.len();
    sum = sum + str_len(strs.get(1999)) + strs.len();
    sum = sum + pts.get(1500).x + pts.get(1500).y + filled.get(4999) + filled.len();
    return sum;
}

fn main() -> i64 {
    var total: i64 = 0;
    var r: i64 = 0;
    while r < 300 {
        total = total + round(r);
        r = r + 1;
    }
    println(total);
    return 0;
}
