// alloc/strings (competitive roadmap RT8, item 1): building strings, the
// allocations core's string producers make and write whole (p_str_alloc_
// uninit: no zeroing of bytes they overwrite anyway). 200 rounds; each
// grows a string by `s = s + x` (p_str_append's doubling buffer), appends
// numbers (`s + int_to_str(n)`, p_str_concat_int), and takes copies,
// slices, upper-case copies, a replace and a rebuild from bytes of it.
// Prints a checksum of the lengths and of some bytes (deterministic: the
// same on every backend, before and after).

fn round(r: i64) -> i64 {
    var s: str = "";
    var i: i64 = 0;
    while i < 2000 {
        s = s + "ab";
        s = s + int_to_str(i * 7 + r);
        i = i + 1;
    }
    var sum: i64 = str_len(s);
    var k: i64 = 0;
    while k < 200 {
        val a: i64 = (k * 37 + r) % (str_len(s) - 64);
        val piece: str = str_slice(s, a, a + 48);
        val up: str = str_to_upper(piece);
        val cp: str = str_clone(up) + str_repeat("-", k % 5);
        val num: str = cp + int_to_str(k);
        sum = sum + str_len(num) + str_byte_at(num, 3) + str_byte_at(up, 0);
        k = k + 1;
    }
    val rep: str = str_replace(str_slice(s, 0, 4000), "ab", "xyz");
    sum = sum + str_len(rep);
    val bytes: Vec<i64> = str_bytes(str_slice(s, 0, 2000));
    val back: str = str_from_bytes(bytes);
    sum = sum + str_len(back) + str_byte_at(back, 1999);
    return sum;
}

fn main() -> i64 {
    var total: i64 = 0;
    var r: i64 = 0;
    while r < 200 {
        total = total + round(r);
        r = r + 1;
    }
    println(total);
    return 0;
}
