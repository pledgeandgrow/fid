use pmod::probe_mod;

fn alen(h: &PHolder3) -> i64 {
    return h.a.len();
}

fn main() -> i64 {
    var v1: Vec<i64> = Vec::new(); v1.push(1); v1.push(2);
    var v2x: Vec<i64> = Vec::new(); v2x.push(3);
    var v3: Vec<f64> = Vec::new(); v3.push(9.0);
    var h: PHolder3 = ph3_new(v1, v2x, v3);
    print(h.a.len());
    print(alen(&h));
    return 0;
}
