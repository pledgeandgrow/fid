use compiler::tensor;

fn v2(a: i64, b: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(a); v.push(b);
    return v;
}

fn main() -> i64 {
    var t: TensorData = Tensor_filled(v2(2, 2), 1.5);
    Tensor_set(&mut t, v2(0, 0), 3.0);
    print(Tensor_ndim(&t));
    print(Tensor_size(&t));
    var v: f64 = Tensor_get(&t, v2(0, 0));
    print(v);
    var s: f64 = Tensor_sum(&t);
    print(s);
    match Tensor_matmul(&t, &t) {
        ResultTensor::Ok(m) => { print(Tensor_get(&m, v2(0, 0))); }
        ResultTensor::Err(e) => { print("matmul err: " + e); }
    }
    var cache: KvCache = KvCache_new(2, 8, 4, 4);
    KvCache_append(&mut cache, 0, &t, &t);
    print(KvCache_len(&cache, 0));
    return 0;
}
