module test_strconcat;

use core;

pub struct Foo {
    pub out: str,
}

fn make_foo(a: str, b: str) -> str {
    var result: str = a + b + "\n";
    return result;
}

fn update_foo(self: &mut Foo, s: str) -> void {
    self.out = self.out + s + "\n";
}

pub fn main() -> i64 {
    var f: Foo = Foo { out: "hello" };
    update_foo(&mut f, " world");
    print(f.out);
    return 0;
}
