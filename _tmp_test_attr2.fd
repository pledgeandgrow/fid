#[test]
fn test_basic() {
    val x = 1 + 2;
    assert_eq(x, 3);
}

#[test]
#[should_panic]
fn test_should_panic() {
    panic("this should panic");
}

#[test]
#[ignore]
fn test_ignored() {
    panic("this should never run");
}

#[test]
fn test_assert_ne() {
    val a = 5;
    val b = 10;
    assert_ne(a, b);
}

fn main() {
    print("main runs\n");
}
