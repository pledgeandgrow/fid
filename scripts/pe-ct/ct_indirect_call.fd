// A @constant_time function that calls through a function value: the
// target is chosen at run time and was not checked to be constant time.
// Rejected by the backend's check (compiler/pe_ir.fd peir_ct_check, and
// nat_ir.fd ng_ct_check on --nat). Run by scripts/pe-ct-check.sh;
// expected: "indirect call".

@constant_time
@wrapping
fn ct_double(x: i64) -> i64 {
    return x + x;
}

@constant_time
@wrapping
fn ct_triple(x: i64) -> i64 {
    return x + x + x;
}

@constant_time
fn ct_apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x);
}

fn main() {
    // two targets, so no pass can turn the call into a direct one
    print(ct_apply(ct_double, 21));
    print("\n");
    print(ct_apply(ct_triple, 14));
    print("\n");
}
