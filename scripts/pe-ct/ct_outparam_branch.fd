// A secret reaches a loop bound through an `&mut` out-parameter. The
// source-level check follows names, not calls that store through a
// reference, so it accepts this; the backend's check (compiler/pe_ir.fd
// peir_ct_check) rejects the loop: its exit branch depends on x.
// Run by scripts/pe-ct-check.sh; expected: "conditional branch on secret data".

@constant_time
fn ct_store(out: &mut i64, v: i64) {
    *out = v;
}

@constant_time
@wrapping
fn leaky_count(x: i64) -> i64 {
    var n: i64 = 0;
    ct_store(&mut n, x);
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        acc = acc + 1;
        i = i + 1;
    }
    return acc;
}

fn main() {
    // two different arguments, so no pass can fold x into a constant
    print(leaky_count(5));
    print("\n");
    print(leaky_count(3));
    print("\n");
}
