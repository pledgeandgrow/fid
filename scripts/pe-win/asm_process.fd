// LG13 (scripts/pe-win-check.sh): asm! templates run in a Windows process
// built by `fid emit` (pe_ir). Native only: the interpreter and the C path
// give 0 for every asm!. A privileged instruction (cli) is not run there
// (it would fault): the template gives 0, as it always did.
//
// Expected output (fid emit, Windows x64):
// 33
// 42
// 0
// cpuid ok
// rdtsc ok
// 0

fn add3(a: i64, b: i64) -> i64 {
    return asm!("mov rax, rcx; add rax, rdx; add rax, 3", in("rcx") a, in("rdx") b, out("rax") a);
}

fn ident(x: i64) -> i64 {
    return asm!("mov rbx, r8; mov rax, rbx", in("r8") x, out("rax") x);
}

fn main() {
    val z = 0;
    print(add3(10, 20));
    print("\n");
    print(ident(42));
    print("\n");
    // an output nothing writes starts at 0
    print(asm!("nop", out("rdx") z));
    print("\n");
    val leaf = asm!("xor rcx, rcx; cpuid", in("rax") z, out("rax") z);
    if leaf > 0 {
        print("cpuid ok\n");
    } else {
        print("cpuid gave 0\n");
    }
    val t = asm!("rdtsc; shl rdx, 32; or rax, rdx", out("rax") z);
    if t != 0 {
        print("rdtsc ok\n");
    } else {
        print("rdtsc gave 0\n");
    }
    print(asm!("cli", out("rax") z));
    print("\n");
    return 0;
}
