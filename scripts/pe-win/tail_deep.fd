// OP13 (scripts/pe-win-check.sh): 100 million mutually recursive calls in
// tail position. Built by `fid emit` (pe_ir) each `return is_odd(n - 1)` is
// a jump, so the stack does not grow; as calls (FID_PE_OFF=tail) the frames
// (at least 64 bytes each) would need more than the 4 GB stack reserve.
// Native only: the interpreter and C -O0 make every call.
//
// Expected output (fid emit, Windows x64):
// true
// false

fn is_even(n: i64) -> bool {
    if n == 0 {
        return true;
    }
    return is_odd(n - 1);
}

fn is_odd(n: i64) -> bool {
    if n == 0 {
        return false;
    }
    return is_even(n - 1);
}

fn main() {
    print(is_even(100000000));
    print("\n");
    print(is_odd(100000000));
    print("\n");
    return 0;
}
