// A live check of TLS 1.3 (release I7, competitive SL4): it needs the
// network, so it is not in the suite (tests/bootstrap/test_tls13_local.fd
// is the suite's check, over loopback). Run it after a change to
// stdlib/tls_windows.fd or stdlib/tls_unix.fd:
//
//   fid ccompile scripts/verify/tls13_live.fd -o tls13.exe && ./tls13.exe [host]
//   (or `fid emit` on Windows)
//
// It connects to `host` (default github.com) port 443 twice: once with
// tls_connect (the system's choice of version) and once with tls_connect13
// (TLS 1.3 only). Over each it sends a GET and reads the start of the
// answer, which on TLS 1.3 comes after the server's NewSessionTicket
// (Schannel hands that to the client as SEC_I_RENEGOTIATE). It prints the
// negotiated version as its wire number (772 is TLS 1.3, 771 is 1.2, 0
// means the connection failed) and the answer's first word. It exits
// with 1 when the 1.3-only connection fails, negotiates anything but 1.3,
// or reads no HTTP answer. Needs Windows 11 / Server 2022 (Schannel) or
// OpenSSL 1.1.1. Nov 17: on Windows 11, tls_connect now goes through
// SCH_CREDENTIALS too and gets 772 from github.com (it was 771).
//
// Expected output (exit 0; the first line may say 771 on older systems):
//   tls_connect   github.com: 772 HTTP/1.1
//   tls_connect13 github.com: 772 HTTP/1.1
//   ok
use tls;

var g_reply: str = "";

@unsafe
fn first_word(s: i64, host: str) -> str {
    val req: str = "GET / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n";
    if tls_session_send(s, req as i64, str_len(req)) != str_len(req) {
        return "(send failed)";
    }
    var buf: i64 = 0;
    // SAFETY: a 64-byte block of our own; tls_session_recv writes at most
    // 63 bytes into it and the loop reads only the n it wrote
    unsafe { buf = p_malloc(64); }
    val n: i64 = tls_session_recv(s, buf, 63, 15000);
    var bytes: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        val b: i64 = p_volatile_load8(buf + i);
        if b == 32 {
            break;
        }
        bytes.push(b);
        i = i + 1;
    }
    unsafe { p_free(buf); }
    if n <= 0 {
        return "(no answer: " + int_to_str(n) + ")";
    }
    return str_from_bytes(bytes);
}

fn version_of(s: i64, host: str) -> i64 {
    g_reply = "";
    if s == 0 {
        return 0;
    }
    val v: i64 = tls_session_version(s);
    g_reply = first_word(s, host);
    val fd: i64 = tls_session_fd(s);
    tls_session_close(s);
    p_socket_close(fd);
    return v;
}

fn main() -> i64 {
    var host: str = "github.com";
    match arg_at(1) {
        Option::Some(h) => {
            host = h;
        }
        Option::None => {}
    }
    val any: i64 = version_of(tls_connect(host, 443), host);
    println("tls_connect   " + host + ": " + int_to_str(any) + " " + g_reply);
    val any_reply: str = g_reply;
    val only13: i64 = version_of(tls_connect13(host, 443), host);
    println("tls_connect13 " + host + ": " + int_to_str(only13) + " " + g_reply);
    if only13 != 772 {
        println("FAIL: the TLS 1.3-only connection did not negotiate TLS 1.3");
        return 1;
    }
    if !str_starts_with(g_reply, "HTTP/") || !str_starts_with(any_reply, "HTTP/") {
        println("FAIL: no HTTP answer read over TLS");
        return 1;
    }
    println("ok");
    return 0;
}
