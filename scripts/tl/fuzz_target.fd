// TL1 (docs/roadmap/competitive-roadmap.md): the input of `fid fuzz` in
// scripts/tl-check.sh. A file for `fid test`/`fid fuzz` holds no main:
// `fid fuzz` runs each fn fuzz_*(data: Vec<u8>) on --seeds deterministic
// inputs; `fid test` runs the fn test_*().

use vec;

/// The sum of the bytes of any input lies in [0, 255 * len].
fn fuzz_sum_in_range(data: Vec<u8>) {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < data.len() {
        total = total + (data.get(i) as i64);
        i = i + 1;
    }
    if total < 0 || total > data.len() * 255 {
        panic("sum out of range");
    }
}

fn test_empty_sum() {
    var v: Vec<u8> = Vec::new();
    fuzz_sum_in_range(v);
}
