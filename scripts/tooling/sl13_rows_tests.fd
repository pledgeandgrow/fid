// SL13 (docs/roadmap/competitive-roadmap.md): the input of `fid test -run`
// in scripts/driver-goals-check.sh. A file for `fid test` holds no main.
//   fid test sl13_rows_tests.fd -run test_parse/neg
//       runs test_parse only, and of its table only the rows named *neg*:
//       "table parse: 1 passed, 2 skipped"; test_other does not run
//   fid test sl13_rows_tests.fd --row big
//       runs both tests; test_parse's table runs the row "big" only
//   fid test sl13_rows_tests.fd -run test_parse
//       test_parse with every row: "table parse: 3 passed"
use test;

fn test_parse() {
    var t: TableTest = table_new("parse");
    table_int(& mut t, "zero", str_parse_int("0"), 0);
    table_int(& mut t, "neg", str_parse_int("-12"), 0 - 12);
    table_int(& mut t, "big", str_parse_int("123456789"), 123456789);
    table_done(t);
}

fn test_other() {
    println("other ran");
}
