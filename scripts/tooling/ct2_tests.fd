// CT2 (docs/roadmap/complaint-roadmap.md): the input of `fid test` in
// scripts/tooling-goals-check.sh. A file for `fid test` holds no main.
//   fid test ct2_tests.fd --filter add     runs test_add_small, test_add_big
//   fid test ct2_tests.fd --jobs 3         runs all four, three at a time,
//                                          each one's output before its verdict
// test_mul_fails fails on purpose: the run reports "3 passed, 1 failed".

fn test_add_small() {
    println("add small");
    if 2 + 2 != 4 {
        panic("2 + 2");
    }
}

fn test_add_big() {
    println("add big");
    if 1000000 + 1000000 != 2000000 {
        panic("big sum");
    }
}

fn test_sub() {
    println("sub");
    if 5 - 7 != 0 - 2 {
        panic("5 - 7");
    }
}

fn test_mul_fails() {
    println("mul");
    if 6 * 7 != 41 {
        panic("6 * 7 is not 41");
    }
}
