// CT3 (docs/roadmap/complaint-roadmap.md): the input of the fixed-clock
// check in scripts/tooling-goals-check.sh. Under `fid test` each test sees
// the clock fixed at 1700000000 (FIDES_TEST_NOW, read by dt_now) and the
// seed fixed at 1 (FIDES_TEST_SEED, read by random_seed_time), except a test
// whose name ends in `_real_clock`, and every test under --real-clock.
//   fid test ct3_clock_tests.fd                 3 passed, 0 failed
//   fid test ct3_clock_tests.fd --real-clock    test_clock_is_fixed and
//                                               test_seed_is_fixed fail

use datetime;
use time;

fn test_clock_is_fixed() {
    if dt_to_seconds(dt_now()) != 1700000000 {
        p_panic("dt_now is not the fixed test clock");
    }
}

fn test_seed_is_fixed() {
    match env_var("FIDES_TEST_SEED") {
        Option::Some(s) => {
            if s != "1" {
                p_panic("FIDES_TEST_SEED is not 1");
            }
        }
        Option::None => {
            p_panic("FIDES_TEST_SEED is not set");
        }
    }
}

fn test_clock_real_clock() {
    if dt_to_seconds(dt_now()) == 1700000000 {
        p_panic("a _real_clock test got the fixed clock");
    }
}
