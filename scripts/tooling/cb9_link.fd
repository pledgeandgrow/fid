// CB9 (docs/roadmap/complaint-roadmap.md): the input of the link-error
// check in scripts/tooling-goals-check.sh. `fid ccompile` of this file
// fails at link time: no library provides fides_cb9_missing. The report is
// a Fides error naming the function and the line of its declaration:
//   error: link: the C function 'fides_cb9_missing' is not in any library the program links
//     --> scripts/tooling/cb9_link.fd:9: declared in an extern "C" block that names no library

extern "C" {
    fn fides_cb9_missing(x: i64) -> i64;
}

@unsafe
fn main() -> i64 {
    println(fides_cb9_missing(1));
    return 0;
}
