// SL13 (docs/roadmap/competitive-roadmap.md): the input of the fuzzing
// checks of scripts/tooling/sl13-fuzz-check.sh (and of
// scripts/driver-goals-check.sh). A file for `fid test` holds no main.
//
//   fid test sl13_fuzz_tests.fd --fuzz -run fuzz_magic --seeds 20000
//       coverage-guided: the harness is built with `ccompile --fuzz-cov`,
//       so an input that gets one byte further into the "FUZ" check
//       reaches a new block and joins the corpus; the 3-byte magic is
//       found well within 20000 inputs (blind random inputs would need
//       about 16 million). The run fails, and the failing input is saved
//       as testdata/fuzz/fuzz_magic/<hash> beside this file.
//   fid test sl13_fuzz_tests.fd
//       runs test_plain and, as the test fuzz_magic/<hash>, the saved
//       input again: it fails until the bug is fixed.
//   fid test sl13_fuzz_tests.fd --fuzz -run fuzz_shapes --seeds 300
//       passes; the corpus grows past the first seed input
//       ("corpus N" with N > 1, "B blocks reached" with B > 0).

/// Panics on any input that starts with "FUZ": the bug to find.
fn fuzz_magic(data: Vec<u8>) {
    if data.len() >= 3 {
        if data.get(0) == 70 {
            if data.get(1) == 85 {
                if data.get(2) == 90 {
                    panic("fuzz_magic: the input starts with FUZ");
                }
            }
        }
    }
}

/// Never fails; its branches give the fuzzer blocks to reach.
fn fuzz_shapes(data: Vec<u8>) {
    var kind: i64 = 0;
    if data.len() == 0 {
        kind = 1;
    } else if data.len() < 4 {
        kind = 2;
    } else if data.len() < 64 {
        kind = 3;
    } else {
        kind = 4;
    }
    var i: i64 = 0;
    var digits: i64 = 0;
    var letters: i64 = 0;
    while i < data.len() {
        val b: i64 = data.get(i) as i64;
        if b >= 48 && b <= 57 {
            digits = digits + 1;
        } else if b >= 97 && b <= 122 {
            letters = letters + 1;
        }
        i = i + 1;
    }
    if digits > 0 && letters > 0 {
        kind = kind + 10;
    }
    if kind < 0 {
        panic("fuzz_shapes: impossible");
    }
}

fn test_plain() {
    var v: Vec<u8> = Vec::new();
    v.push(65 as u8);
    fuzz_shapes(v);
    println("plain ran");
}
