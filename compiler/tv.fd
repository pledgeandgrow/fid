// compiler/tv.fd — translation validation of the mid-end (own-backend roadmap
// RL5, competitive roadmap VF6; design: docs/verification/translation-validation.md).
//
// With `--validate` on the command line (or FID_VALIDATE=1), the pass
// manager (compiler/iropt.fd iro_time, and iropt_me for the SSA round trip)
// keeps each function as it was before a pass (tv_before) and asks this
// module whether the result means the same (tv_after). A result that is
// rejected is reported on stderr and the function gets back its IR from
// before the pass, so the program is built from IR that passed.
//
// Two checks, each much smaller than the passes it checks:
//
//   1. witnesses (VF6), for passes that keep value ids (fold, dce, gvn, and
//      the SSA round trip `ssa` of compiler/ssa.fd): the witness is the id
//      correspondence itself, and each rewrite it implies is checked
//      locally. The instructions with an effect (calls, stores, prints,
//      terminators) must stay, in their order, with operands of equal value;
//      an instruction that may panic must stay or be replaced by an equal
//      one that comes first (gvn); a value is equal to another when both are
//      the same constant (a fold is checked by evaluating the operation at
//      its type, checked arithmetic included), or the same pure operation
//      on equal operands, or the same load with nothing written between.
//      For `ssa` the values of the locals it promoted are left to check 2.
//   2. random inputs (RL5), for every pass: when both functions use only
//      integer values, locals that only loads and stores touch, calls and
//      prints, both are run by a small evaluator on the same inputs (edge
//      values, small and large random ones). Calls are uninterpreted: the
//      result is a hash of the callee and the arguments, and of the call's
//      place in the order of calls with effects, which go into a trace with
//      the prints. The outcome (returned value, panic, unreachable reached)
//      and the trace must agree. Runs that take too long are not counted.
//
// The checks trust the IR's effect annotations (a call site marked pure is
// a function of its arguments) and leave dominance to the IR verifier
// (compiler/irverify.fd, FID_VERIFY=1). A result neither check applies to
// is counted as not checkable. tv_report prints the totals at the end of
// the mid-end.
//
// Added Nov 17 (VF6):
//   - witnesses for LICM (tv_licm: ids kept, instructions only move into the
//     block that enters their loop, under the rules of iropt.fd iro_licm)
//     and devirtualization (tv_devirt);
//   - the module passes (tv_mod_before/tv_mod_after around each of inline,
//     inline2, hofspec, ipcp, spec, gconst, icf): every function the pass
//     changed is checked against its copy from before it, by the pass's
//     witness where one is written (inline, inline2: the call is a copy of
//     the callee's one block; spec: the call goes to a clone of the callee
//     for a constant it passes; gconst: the folded loads read a global nothing
//     writes; icf: the call goes to a function with the same body; ipcp: the
//     parameter replaced is one every call passes that constant for), and by
//     runs on random inputs where calls into the module are evaluated in
//     the module before or after the pass (tv_wrandom). A rejected module
//     pass is undone as a whole;
//   - SMT-LIB obligations for straight-line pairs (FID_VALIDATE_SMT=<dir>,
//     tests/tooling/tv-check.sh runs z3 on them; tv_smt_examples writes
//     nine pairs whose answer is known);
//   - FID_TV_INJECT=<passes> puts a fault into what those passes produce
//     (FID_TV_INJECT_IN=<prefix>: only into functions named so), which the
//     checks must reject, and FID_TV_SELFTEST=1 runs tv_selftest: pairs
//     (before, after) each check must accept or reject.

module compiler::tv; use core; use vec; use string; use compiler::ast; use compiler::ir; use compiler::checks; use compiler::ssa; use compiler::ir_ser;  /// Runs of each function pair on random inputs.
const TV_RUNS: i64 = 12;  /// Instructions one run of the function before the pass may execute.
const TV_STEPS: i64 = 20000;  /// How deep two values are compared, and how many comparisons one check may make.
const TV_DEPTH: i64 = 8; const TV_BUDGET: i64 = 200000;

var g_tv_state: i64 = 0;  // 0 unread, 1 on, -1 off
var g_tv_checked: i64 = 0;
var g_tv_rejected: i64 = 0;
var g_tv_unchecked: i64 = 0;
var g_tv_injected: i64 = 0;
var g_tv_caught: i64 = 0;
var g_tv_pairs_done: bool = false;
// RL5: the last tv_structural left a value to the random runs (ssa)
var g_tv_deferred: bool = false;
// RL5 triage: results no check applied to, per pass (tv_note_na)
var g_tv_na_map: i64 = 0;
var g_tv_na_order: str = "";

/// Is translation validation on (`--validate`, or FID_VALIDATE set and not 0)?
pub fn tv_on() -> bool {
    if g_tv_state == 0 {
        g_tv_state = 0 - 1;
        var ev: str = p_getenv("FID_VALIDATE");
        if (ev as i64) != 0 && str_len(ev) > 0 && ev != "0" {
            g_tv_state = 1;
        }
        var n: i64 = p_argc();
        var i: i64 = 1;
        while i < n {
            var a: str = p_argv(i);
            if (a as i64) != 0 {
                if a == "--validate" {
                    g_tv_state = 1;
                }
            }
            i = i + 1;
        }
    }
    return g_tv_state == 1;
}

// --- Keeping the function before a pass -------------------------------------

/// A copy of `f` that the pass cannot change: every Vec a pass edits in
/// place is copied (instruction payloads are only ever replaced whole).
pub fn tv_snapshot(f: & IrFunction) -> IrFunction {
    var nf: IrFunction = IrFunction_new(f.name, f.ret_ty);
    nf.params = f.params.clone();
    var nbl: Vec<BasicBlock> = Vec::new();
    var bi: i64 = 0;
    while bi < f.blocks.len() {
        var bb: BasicBlock = f.blocks.get(bi);
        bb.instructions = bb.instructions.clone();
        bb.predecessors = bb.predecessors.clone();
        bb.params = bb.params.clone();
        nbl.push(bb);
        bi = bi + 1;
    }
    nf.blocks = nbl;
    nf.value_metas = f.value_metas.clone();
    nf.insts = f.insts.clone();
    nf.inst_at = f.inst_at.clone();
    var neff: EffectSet = f.effects;
    neff.effects = f.effects.effects.clone();
    nf.effects = neff;
    nf.next_value = f.next_value;
    nf.next_block = f.next_block;
    nf.current_block_idx = f.current_block_idx;
    nf.entry = f.entry;
    nf.locals = f.locals.clone();
    nf.persist_vars = f.persist_vars.clone();
    nf.drop_locals = f.drop_locals.clone();
    nf.zeroize_locals = f.zeroize_locals.clone();
    nf.is_wrapping = f.is_wrapping;
    nf.is_constant_time = f.is_constant_time;
    nf.internal_conv = f.internal_conv;
    return nf;
}

/// Give `f` back the IR of `s` (a tv_snapshot of it).
fn tv_restore(f: & mut IrFunction, s: & IrFunction) {
    f.params = s.params;
    f.blocks = s.blocks;
    f.value_metas = s.value_metas;
    f.insts = s.insts;
    f.inst_at = s.inst_at;
    f.effects = s.effects;
    f.next_value = s.next_value;
    f.next_block = s.next_block;
    f.current_block_idx = s.current_block_idx;
    f.entry = s.entry;
    f.locals = s.locals;
    f.persist_vars = s.persist_vars;
    f.drop_locals = s.drop_locals;
    f.zeroize_locals = s.zeroize_locals;
}

/// Before a pass: the function as it is when validation is on (an empty
/// function otherwise, which tv_after never reads).
pub fn tv_before(f: & IrFunction) -> IrFunction {
    if !tv_on() {
        return IrFunction_new("", IrType::Void);
    }
    return tv_snapshot(f);
}

/// After pass `pass` changed `f` (from `pre`, a tv_before): true when the
/// result is accepted; false when it was rejected, and `f` is `pre` again.
pub fn tv_after(pname: str, pre: & IrFunction, f: & mut IrFunction) -> bool {
    if !tv_on() {
        return true;
    }
    // FID_TV_INJECT (VF6 negative tests): a fault put into the result on
    // purpose, which the check must reject
    var inj: bool = false;
    if tv_inject_on(pname, f.name) {
        inj = tv_inject_fn(f);
    }
    var why: str = tv_check(pname, pre, f);
    return tv_settle(pname, why, inj, pre, f);
}

/// The verdict `why` on `f` after pass `pname` ("" accepted, "n/a" not
/// checkable, else rejected: `f` gets back the IR of `pre`), counted and
/// reported; with FID_VALIDATE_SMT the pair is also written as an SMT-LIB
/// obligation (straight-line code only).
fn tv_settle(pname: str, why: str, inj: bool, pre: & IrFunction, f: & mut IrFunction) -> bool {
    tv_smt_pair(pname, pre, f, inj, why);
    if inj {
        g_tv_injected = g_tv_injected + 1;
    }
    if why == "n/a" {
        g_tv_unchecked = g_tv_unchecked + 1;
        tv_note_na(pname);
        if inj {
            p_eprint_str("tv: injected a fault into " + f.name + " after pass " + pname + ": NOT caught (no check applies)\n");
        }
        return true;
    }
    g_tv_checked = g_tv_checked + 1;
    if str_len(why) == 0 {
        if inj {
            p_eprint_str("tv: injected a fault into " + f.name + " after pass " + pname + ": NOT caught\n");
        }
        return true;
    }
    g_tv_rejected = g_tv_rejected + 1;
    p_eprint_str("tv: " + f.name + ": pass " + pname + " rejected: " + why + "; the function keeps its IR from before the pass\n");
    if inj {
        g_tv_caught = g_tv_caught + 1;
        p_eprint_str("tv: injected a fault into " + f.name + " after pass " + pname + ": caught\n");
    }
    tv_restore(f, pre);
    return false;
}

/// RL5 triage: count a result of pass `pname` no check applied to (in the
/// order the passes first had one), for tv_report.
fn tv_note_na(pname: str) {
    if g_tv_na_map == 0 {
        g_tv_na_map = HashMap_new();
    }
    if HashMap_contains(g_tv_na_map, pname) {
        HashMap_insert(g_tv_na_map, pname, HashMap_get(g_tv_na_map, pname) + 1);
    } else {
        HashMap_insert(g_tv_na_map, pname, 1);
        g_tv_na_order = g_tv_na_order + pname + ",";
    }
}

/// The totals, once the mid-end is done (when validation is on); with
/// FID_TV_SELFTEST the self-test of the checks first (tv_selftest).
pub fn tv_report() {
    if tv_selftest_wanted() {
        var _st_bad: i64 = tv_selftest();
    }
    // RL5: FID_TV_PAIRS=<file or directory>, the pairs of tests/verify/tv
    if !g_tv_pairs_done {
        g_tv_pairs_done = true;
        var pairs: str = p_getenv("FID_TV_PAIRS");
        if (pairs as i64) != 0 && str_len(pairs) > 0 {
            var _tp_bad: i64 = tv_pairs_run(pairs, false);
        }
    }
    if !tv_on() {
        return;
    }
    p_eprint_str("tv: " + int_to_str(g_tv_checked) + " pass results checked, " + int_to_str(g_tv_rejected) + " rejected, " + int_to_str(g_tv_unchecked) + " not checkable\n");
    // RL5 triage: which passes' results no check applied to
    if g_tv_unchecked > 0 && g_tv_na_map != 0 {
        var line: str = "tv: not checkable, by pass:";
        var names: Vec<str> = str_split(g_tv_na_order, ",");
        var i: i64 = 0;
        while i < names.len() {
            var nm: str = names.get(i);
            if str_len(nm) > 0 {
                line = line + " " + nm + " " + int_to_str(HashMap_get(g_tv_na_map, nm));
            }
            i = i + 1;
        }
        p_eprint_str(line + "\n");
    }
    if g_tv_injected > 0 {
        p_eprint_str("tv: " + int_to_str(g_tv_injected) + " faults injected, " + int_to_str(g_tv_caught) + " caught\n");
    }
    if g_tv_smt_n > 0 {
        p_eprint_str("tv: " + int_to_str(g_tv_smt_n) + " SMT-LIB obligations in " + tv_smt_dir() + "\n");
    }
}

/// Does `post` mean what `pre` meant, after pass `pass`? "" yes, "n/a" no
/// check applies, else why not.
pub fn tv_check(pname: str, pre: & IrFunction, post: & IrFunction) -> str {
    // VF6: LICM keeps value ids and only moves instructions (tv_licm)
    if pname == "licm" {
        var lw: str = tv_licm(pre, post);
        if str_len(lw) > 0 {
            return lw;
        }
        var lr: str = tv_random(pre, post);
        if str_len(lr) > 0 && lr != "n/a" {
            return lr;
        }
        return "";
    }
    var s: str = tv_structural(pname, pre, post);
    if str_len(s) > 0 && s != "n/a" {
        return s;
    }
    // a self tail call made a loop: calls are uninterpreted here, so the
    // call the pass removed cannot be compared with the loop it became
    if pname == "tailcall" {
        return s;
    }
    var deferred: bool = g_tv_deferred;
    var r: str = tv_random(pre, post);
    if str_len(r) > 0 && r != "n/a" {
        return r;
    }
    if s == "n/a" && r == "n/a" {
        return "n/a";
    }
    // RL5: the witness left promoted values to runs that could not be made
    if deferred && r == "n/a" {
        return "n/a";
    }
    return "";
}

// --- Values at a type ------------------------------------------------------------

/// A value, a panic, or a value this evaluator does not compute.
pub struct TvK {
    pub kind: i64,
    // 0 a value, 1 a panic, 2 not computed
    pub v: i64,
}

fn tv_k(kind: i64, v: i64) -> TvK {
    return TvK {
        kind: kind, v: v
    };
}

fn tv_bits(t: IrType) -> i64 {
    match t {
        IrType::I8 => {
            return 8;
        }
        IrType::U8 => {
            return 8;
        }
        IrType::I16 => {
            return 16;
        }
        IrType::U16 => {
            return 16;
        }
        IrType::I32 => {
            return 32;
        }
        IrType::U32 => {
            return 32;
        }
        IrType::Bool => {
            return 1;
        }
        _ => {
            return 64;
        }
    }
}

fn tv_signed(t: IrType) -> bool {
    match t {
        IrType::I8 => {
            return true;
        }
        IrType::I16 => {
            return true;
        }
        IrType::I32 => {
            return true;
        }
        IrType::I64 => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

fn tv_is_u64(t: IrType) -> bool {
    match t {
        IrType::U64 => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

fn tv_is_float(t: IrType) -> bool {
    match t {
        IrType::F32 => {
            return true;
        }
        IrType::F64 => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// `v` as a value of type `t`: the low bits, sign-extended for a signed
/// type; 0 or 1 for bool; all 64 bits for anything else.
@wrapping fn tv_narrow(v: i64, t: IrType) -> i64 {
    var bits: i64 = tv_bits(t);
    if bits >= 64 {
        return v;
    }
    if bits == 1 {
        return v & 1;
    }
    var mask: i64 = (1 << bits) - 1;
    var r: i64 = v & mask;
    if tv_signed(t) && (r & (1 << (bits - 1))) != 0 {
        r = r - (1 << bits);
    }
    return r;
}

/// a < b as unsigned 64-bit values.
@wrapping fn tv_ult(a: i64, b: i64) -> bool {
    var top: i64 = 1 << 63;
    return (a ^ top) < (b ^ top);
}

@wrapping fn tv_mix(h: i64, v: i64) -> i64 {
    var x: i64 = (h ^ v) * 1099511628211;
    return x ^ (x >> 31);
}

@wrapping fn tv_hash_str(s: str) -> i64 {
    var h: i64 = 1469598103934665603;
    var i: i64 = 0;
    var n: i64 = str_len(s);
    while i < n {
        h = h ^ (str_byte_at(s, i) & 0xFF);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}

fn tv_cmp(op: BinOp) -> bool {
    return binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::GtEq);
}

fn tv_quiet_op(op: BinOp) -> bool {
    return tv_cmp(op) || binop_eq(op, BinOp::BitAnd) || binop_eq(op, BinOp::BitOr) || binop_eq(op, BinOp::BitXor) || binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or);
}

/// `a op b` with operands of type `ot` and a result of type `rt`, as the
/// program computes it: arithmetic is checked (an overflow or a division by
/// zero panics) unless the function is @wrapping. Unsigned 64-bit
/// multiplication, division and remainder, shifts by the width or more,
/// and floats are not computed.
@wrapping fn tv_binop(op: BinOp, a: i64, b: i64, ot: IrType, rt: IrType, wrapping: bool) -> TvK {
    if tv_is_float(ot) || tv_is_float(rt) {
        return tv_k(2, 0);
    }
    var bits: i64 = tv_bits(ot);
    var sgn: bool = tv_signed(ot);
    var isu: bool = tv_is_u64(ot);
    var mn: i64 = 1 << 63;
    var r: i64 = 0;
    if tv_cmp(op) {
        var t: bool = false;
        if binop_eq(op, BinOp::Eq) {
            t = a == b;
        } else if binop_eq(op, BinOp::Neq) {
            t = a != b;
        } else if isu {
            if binop_eq(op, BinOp::Lt) {
                t = tv_ult(a, b);
            } else if binop_eq(op, BinOp::Gt) {
                t = tv_ult(b, a);
            } else if binop_eq(op, BinOp::LtEq) {
                t = !tv_ult(b, a);
            } else {
                t = !tv_ult(a, b);
            }
        } else {
            if binop_eq(op, BinOp::Lt) {
                t = a < b;
            } else if binop_eq(op, BinOp::Gt) {
                t = a > b;
            } else if binop_eq(op, BinOp::LtEq) {
                t = a <= b;
            } else {
                t = a >= b;
            }
        }
        if t {
            return tv_k(0, 1);
        }
        return tv_k(0, 0);
    }
    if binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or) {
        if bits != 1 {
            return tv_k(2, 0);
        }
        var la: bool = a != 0;
        var lb: bool = b != 0;
        if binop_eq(op, BinOp::And) {
            if la && lb {
                return tv_k(0, 1);
            }
            return tv_k(0, 0);
        }
        if la || lb {
            return tv_k(0, 1);
        }
        return tv_k(0, 0);
    }
    if binop_eq(op, BinOp::BitAnd) {
        return tv_k(0, tv_narrow(a & b, rt));
    }
    if binop_eq(op, BinOp::BitOr) {
        return tv_k(0, tv_narrow(a | b, rt));
    }
    if binop_eq(op, BinOp::BitXor) {
        return tv_k(0, tv_narrow(a ^ b, rt));
    }
    if bits == 1 {
        return tv_k(2, 0);
    }
    if binop_eq(op, BinOp::Shl) || binop_eq(op, BinOp::Shr) {
        if b < 0 || b >= bits {
            return tv_k(2, 0);
        }
        if binop_eq(op, BinOp::Shl) {
            return tv_k(0, tv_narrow(a << b, rt));
        }
        if isu && b > 0 {
            return tv_k(0, (a >> b) & ((1 << (64 - b)) - 1));
        }
        return tv_k(0, tv_narrow(a >> b, rt));
    }
    if binop_eq(op, BinOp::Add) {
        r = a + b;
        if wrapping {
            return tv_k(0, tv_narrow(r, rt));
        }
        if bits < 64 {
            if tv_narrow(r, ot) != r {
                return tv_k(1, 0);
            }
        } else if isu {
            if tv_ult(r, a) {
                return tv_k(1, 0);
            }
        } else if ((a ^ r) & (b ^ r)) < 0 {
            return tv_k(1, 0);
        }
        return tv_k(0, r);
    }
    if binop_eq(op, BinOp::Sub) {
        r = a - b;
        if wrapping {
            return tv_k(0, tv_narrow(r, rt));
        }
        if bits < 64 {
            if tv_narrow(r, ot) != r {
                return tv_k(1, 0);
            }
        } else if isu {
            if tv_ult(a, b) {
                return tv_k(1, 0);
            }
        } else if ((a ^ b) & (a ^ r)) < 0 {
            return tv_k(1, 0);
        }
        return tv_k(0, r);
    }
    if binop_eq(op, BinOp::Mul) {
        if wrapping {
            return tv_k(0, tv_narrow(a * b, rt));
        }
        if isu {
            return tv_k(2, 0);
        }
        if bits < 64 {
            r = a * b;
            if tv_narrow(r, ot) != r {
                return tv_k(1, 0);
            }
            return tv_k(0, r);
        }
        if a == 0 || b == 0 {
            return tv_k(0, 0);
        }
        if a == 0 - 1 {
            if b == mn {
                return tv_k(1, 0);
            }
            return tv_k(0, 0 - b);
        }
        if b == 0 - 1 {
            if a == mn {
                return tv_k(1, 0);
            }
            return tv_k(0, 0 - a);
        }
        r = a * b;
        if r / a != b {
            return tv_k(1, 0);
        }
        return tv_k(0, r);
    }
    if binop_eq(op, BinOp::Div) || binop_eq(op, BinOp::Mod) {
        if b == 0 {
            return tv_k(1, 0);
        }
        if isu {
            return tv_k(2, 0);
        }
        if a == mn && b == 0 - 1 {
            if binop_eq(op, BinOp::Div) && wrapping {
                return tv_k(0, mn);
            }
            if binop_eq(op, BinOp::Div) {
                return tv_k(1, 0);
            }
            return tv_k(2, 0);
        }
        if binop_eq(op, BinOp::Mod) {
            return tv_k(0, a % b);
        }
        r = a / b;
        if wrapping {
            return tv_k(0, tv_narrow(r, rt));
        }
        if bits < 64 && tv_narrow(r, ot) != r {
            return tv_k(1, 0);
        }
        return tv_k(0, r);
    }
    return tv_k(2, 0);
}

@wrapping fn tv_unop(op: UnaryOp, a: i64, t: IrType, wrapping: bool) -> TvK {
    if tv_is_float(t) {
        return tv_k(2, 0);
    }
    var bits: i64 = tv_bits(t);
    match op {
        UnaryOp::Neg => {
            if bits == 1 || !tv_signed(t) {
                return tv_k(2, 0);
            }
            var r: i64 = 0 - a;
            if wrapping {
                return tv_k(0, tv_narrow(r, t));
            }
            if bits == 64 && a == (1 << 63) {
                return tv_k(1, 0);
            }
            if tv_narrow(r, t) != r {
                return tv_k(1, 0);
            }
            return tv_k(0, r);
        }
        UnaryOp::Not => {
            if bits == 1 {
                if a == 0 {
                    return tv_k(0, 1);
                }
                return tv_k(0, 0);
            }
            return tv_k(0, tv_narrow(a ^ (0 - 1), t));
        }
        UnaryOp::BitNot => {
            return tv_k(0, tv_narrow(a ^ (0 - 1), t));
        }
    }
    return tv_k(2, 0);
}

// --- The evaluator (RL5) ---------------------------------------------------------

/// Whether the evaluator can run `f`, its plain locals (allocas only loads
/// and stores touch, per value) and its blocks by id (-1: none).
pub struct TvShape {
    pub ok: bool,
    pub plain: Vec<i64>,
    pub bindex: Vec<i64>,
}

fn tv_bidx(sh: & TvShape, bid: i64) -> i64 {
    if bid >= 0 && bid < sh.bindex.len() {
        return sh.bindex.get(bid);
    }
    return - 1;
}

fn tv_get(v: & Vec<i64>, id: i64) -> i64 {
    if id >= 0 && id < v.len() {
        return v.get(id);
    }
    return 0;
}

fn tv_shape_of(f: & IrFunction) -> TvShape {
    return tv_shape_x(f, 0, false);
}

/// tv_shape_of, and with `wide` (the module checks, tv_wrandom) also the
/// addresses of the globals in `gc` (name -> value, tv_gconst_facts) that
/// only loads read (plain 2), and calls through a pointer.
fn tv_shape_x(f: & IrFunction, gc: i64, wide: bool) -> TvShape {
    var nv: i64 = f.next_value + 1;
    var plain: Vec<i64> = peir_zeros(nv);
    var maxid: i64 = 0;
    var b: i64 = 0;
    while b < f.blocks.len() {
        if f.blocks.get(b).id > maxid {
            maxid = f.blocks.get(b).id;
        }
        b = b + 1;
    }
    var bindex: Vec<i64> = Vec::new();
    while bindex.len() <= maxid {
        bindex.push(- 1);
    }
    b = 0;
    while b < f.blocks.len() {
        bindex.set(f.blocks.get(b).id, b);
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            match peir_inst_of(f, id) {
                Inst::Alloca(_, _) => {
                    if id >= 0 && id < nv {
                        plain.set(id, 1);
                    }
                }
                Inst::GlobalAddr(gname, _) => {
                    // (2g.90: also the function passes' runs, tv_random,
                    // with the module's facts, g_tv_gc)
                    if gc != 0 && id >= 0 && id < nv && HashMap_contains(gc, gname) {
                        plain.set(id, 2);
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    b = 0;
    while b < f.blocks.len() {
        var ids2: Vec<i64> = f.blocks.get(b).instructions;
        var k2: i64 = 0;
        while k2 < ids2.len() {
            var inst: Inst = peir_inst_of(f, ids2.get(k2));
            var ops: Vec<i64> = Vec::new();
            peir_inst_operands(inst, & mut ops);
            var o: i64 = 0;
            while o < ops.len() {
                var v: i64 = ops.get(o);
                if v >= 0 && v < nv && plain.get(v) >= 1 {
                    var good: bool = false;
                    match inst {
                        Inst::Load(p, _) => {
                            good = p == v;
                        }
                        Inst::Store(p, sv, _) => {
                            // a constant global's address is only ever loaded
                            good = p == v && sv != v && plain.get(v) == 1;
                        }
                        _ => {
                        }
                    }
                    if !good {
                        plain.set(v, 0);
                    }
                }
                o = o + 1;
            }
            k2 = k2 + 1;
        }
        b = b + 1;
    }
    var ok: bool = f.blocks.len() > 0;
    b = 0;
    while b < f.blocks.len() && ok {
        var ids3: Vec<i64> = f.blocks.get(b).instructions;
        var k3: i64 = 0;
        while k3 < ids3.len() && ok {
            var iid: i64 = ids3.get(k3);
            match peir_inst_of(f, iid) {
                Inst::ConstInt(_, _) => {
                }
                Inst::ConstBool(_) => {
                }
                Inst::ConstNull(_) => {
                }
                Inst::ConstStr(_) => {
                }
                Inst::ConstFnRef(_) => {
                }
                Inst::Alloca(_, _) => {
                    ok = iid >= 0 && iid < nv && plain.get(iid) == 1;
                }
                Inst::Load(p, _) => {
                    ok = p >= 0 && p < nv && plain.get(p) >= 1;
                }
                Inst::Store(p, _, _) => {
                    ok = p >= 0 && p < nv && plain.get(p) == 1;
                }
                Inst::GlobalAddr(_, _) => {
                    ok = iid >= 0 && iid < nv && plain.get(iid) == 2;
                }
                Inst::CallPtr(_, _, _, _, _) => {
                    ok = wide;
                }
                Inst::BinOp(_, l, _, t) => {
                    ok = !tv_is_float(t) && !tv_is_float(ssa_vty(f, l));
                }
                Inst::UnaryOp(_, _, t) => {
                    ok = !tv_is_float(t);
                }
                Inst::Jump(t) => {
                    ok = tv_bidx_of(& bindex, t) >= 0;
                }
                Inst::Branch(_, t, e) => {
                    ok = tv_bidx_of(& bindex, t) >= 0 && tv_bidx_of(& bindex, e) >= 0;
                }
                Inst::Return(_) => {
                }
                Inst::Unreachable => {
                }
                Inst::Panic(_) => {
                }
                Inst::Call(_, _, _, _) => {
                }
                Inst::Print(_, _) => {
                }
                Inst::IntExtend(_, a, t) => {
                    ok = !tv_is_float(a) && !tv_is_float(t);
                }
                Inst::IntTrunc(_, a, t) => {
                    ok = !tv_is_float(a) && !tv_is_float(t);
                }
                Inst::BitCast(_, a, t) => {
                    ok = !tv_is_float(a) && !tv_is_float(t);
                }
                _ => {
                    ok = false;
                }
            }
            k3 = k3 + 1;
        }
        b = b + 1;
    }
    return TvShape {
        ok: ok, plain: plain, bindex: bindex
    };
}

/// 2g.90 (VF6): the module's constant globals (tv_gconst_facts: an integer
/// literal that nothing stores to and whose address only loads read), for
/// the runs of the function passes (tv_random); 0: none known. iropt.fd
/// iropt_native sets it before its per-function loop and forgets it after.
var g_tv_gc: i64 = 0;

pub fn tv_note_globals(module: & IrModule) {
    g_tv_gc = 0;
    if !tv_on() {
        return;
    }
    var fns: Vec<IrFunction> = Vec::new();
    var i: i64 = 0;
    while i < module.functions.len() {
        fns.push(module.functions.get(i).func);
        i = i + 1;
    }
    g_tv_gc = tv_gconst_facts(& fns, & module.globals);
}

pub fn tv_forget_globals() {
    g_tv_gc = 0;
}

/// The literal of the constant global (g_tv_gc) whose address is `p` in `f`.
fn tv_fglobal(f: & IrFunction, p: i64) -> i64 {
    match peir_inst_of(f, p) {
        Inst::GlobalAddr(gn, _) => {
            if g_tv_gc != 0 && HashMap_contains(g_tv_gc, gn) {
                return HashMap_get(g_tv_gc, gn);
            }
        }
        _ => {
        }
    }
    return 0;
}

fn tv_bidx_of(bindex: & Vec<i64>, bid: i64) -> i64 {
    if bid >= 0 && bid < bindex.len() {
        return bindex.get(bid);
    }
    return - 1;
}

/// What one run did: kind 0 returned `val`, 1 panicked, 2 reached
/// Unreachable, 3 fell off a block, 4 ran out of steps, 5 met something it
/// does not evaluate; `trace` hashes the calls with effects and the prints.
pub struct TvOut {
    pub kind: i64,
    pub val: i64,
    pub trace: i64,
    pub steps: i64,
}

fn tv_eval(f: & IrFunction, sh: & TvShape, args: & Vec<i64>, limit: i64) -> TvOut {
    var nv: i64 = f.next_value + 1;
    var vals: Vec<i64> = peir_zeros(nv);
    var mem: Vec<i64> = peir_zeros(nv);
    var pi: i64 = 0;
    while pi < f.params.len() && pi < args.len() {
        var pid: i64 = f.params.get(pi).id;
        if pid >= 0 && pid < nv {
            vals.set(pid, args.get(pi));
        }
        pi = pi + 1;
    }
    var out: TvOut = TvOut {
        kind: 5, val: 0, trace: 0, steps: 0
    };
    var trace: i64 = 7;
    var ncalls: i64 = 0;
    var steps: i64 = 0;
    var b: i64 = 0;
    var done: bool = false;
    while !done {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        var nxt: i64 = - 1;
        while k < ids.len() && nxt < 0 && !done {
            var id: i64 = ids.get(k);
            steps = steps + 1;
            if steps > limit {
                out.kind = 4;
                done = true;
            } else if id < 0 || id >= nv {
                out.kind = 5;
                done = true;
            } else {
                match peir_inst_of(f, id) {
                    Inst::ConstInt(c, t) => {
                        vals.set(id, tv_narrow(c, t));
                    }
                    Inst::ConstBool(bv) => {
                        if bv {
                            vals.set(id, 1);
                        } else {
                            vals.set(id, 0);
                        }
                    }
                    Inst::ConstNull(_) => {
                        vals.set(id, 0);
                    }
                    Inst::ConstStr(s) => {
                        vals.set(id, tv_hash_str(s));
                    }
                    Inst::ConstFnRef(s) => {
                        vals.set(id, tv_mix(tv_hash_str(s), 3));
                    }
                    Inst::Alloca(_, _) => {
                        vals.set(id, id);
                    }
                    Inst::GlobalAddr(gn, _) => {
                        vals.set(id, tv_hash_str(gn));
                    }
                    Inst::Load(p, t) => {
                        if tv_get(& sh.plain, p) == 2 {
                            // a constant global of the module (g_tv_gc)
                            vals.set(id, tv_narrow(tv_fglobal(f, p), t));
                        } else {
                            vals.set(id, tv_narrow(tv_get(& mem, p), t));
                        }
                    }
                    Inst::Store(p, v, _) => {
                        if p >= 0 && p < nv {
                            mem.set(p, tv_get(& vals, v));
                        }
                    }
                    Inst::BinOp(op, l, r, t) => {
                        var res: TvK = tv_binop(op, tv_get(& vals, l), tv_get(& vals, r), ssa_vty(f, l), t, f.is_wrapping);
                        if res.kind == 0 {
                            vals.set(id, res.v);
                        } else if res.kind == 1 {
                            out.kind = 1;
                            done = true;
                        } else {
                            out.kind = 5;
                            done = true;
                        }
                    }
                    Inst::UnaryOp(op, x, t) => {
                        var ru: TvK = tv_unop(op, tv_get(& vals, x), t, f.is_wrapping);
                        if ru.kind == 0 {
                            vals.set(id, ru.v);
                        } else if ru.kind == 1 {
                            out.kind = 1;
                            done = true;
                        } else {
                            out.kind = 5;
                            done = true;
                        }
                    }
                    Inst::IntExtend(x, _, to) => {
                        vals.set(id, tv_narrow(tv_get(& vals, x), to));
                    }
                    Inst::IntTrunc(x, _, to) => {
                        vals.set(id, tv_narrow(tv_get(& vals, x), to));
                    }
                    Inst::BitCast(x, _, _) => {
                        vals.set(id, tv_get(& vals, x));
                    }
                    Inst::Call(nm, cargs, rt, eff) => {
                        var h: i64 = tv_hash_str(nm);
                        var ai: i64 = 0;
                        while ai < cargs.len() {
                            h = tv_mix(h, tv_get(& vals, cargs.get(ai)));
                            ai = ai + 1;
                        }
                        var es: EffectSet = eff;
                        if !EffectSet_is_pure(& es) {
                            ncalls = ncalls + 1;
                            h = tv_mix(h, ncalls);
                            trace = tv_mix(tv_mix(trace, 11), h);
                        }
                        vals.set(id, tv_narrow(h, rt));
                    }
                    Inst::Print(x, _) => {
                        trace = tv_mix(tv_mix(trace, 13), tv_get(& vals, x));
                    }
                    Inst::Jump(t) => {
                        nxt = tv_bidx(sh, t);
                        if nxt < 0 {
                            out.kind = 5;
                            done = true;
                        }
                    }
                    Inst::Branch(c, t, e) => {
                        if tv_get(& vals, c) != 0 {
                            nxt = tv_bidx(sh, t);
                        } else {
                            nxt = tv_bidx(sh, e);
                        }
                        if nxt < 0 {
                            out.kind = 5;
                            done = true;
                        }
                    }
                    Inst::Return(rv) => {
                        match rv {
                            OptValueId::Some(x) => {
                                out.val = tv_get(& vals, x);
                            }
                            OptValueId::None => {
                            }
                        }
                        out.kind = 0;
                        done = true;
                    }
                    Inst::Panic(_) => {
                        out.kind = 1;
                        done = true;
                    }
                    Inst::Unreachable => {
                        out.kind = 2;
                        done = true;
                    }
                    _ => {
                        out.kind = 5;
                        done = true;
                    }
                }
            }
            k = k + 1;
        }
        if !done {
            if nxt < 0 {
                out.kind = 3;
                done = true;
            } else {
                b = nxt;
            }
        }
    }
    out.trace = trace;
    out.steps = steps;
    return out;
}

/// The input of one run for a parameter of type `t`: 0, 1, -1, then small
/// values (loop bounds), then larger and full-width random ones.
@wrapping fn tv_arg(t: IrType, run: i64, r: i64) -> i64 {
    var v: i64 = r;
    if run == 0 {
        v = 0;
    } else if run == 1 {
        v = 1;
    } else if run == 2 {
        v = 0 - 1;
    } else if run < 8 {
        v = (r % 21) - 10;
    } else if run < 10 {
        v = r % 1000;
    }
    if tv_is_float(t) {
        return 0;
    }
    return tv_narrow(v, t);
}

fn tv_out_str(o: & TvOut) -> str {
    if o.kind == 0 {
        return "returned " + int_to_str(o.val);
    }
    if o.kind == 1 {
        return "panicked";
    }
    if o.kind == 2 {
        return "reached Unreachable";
    }
    return "fell off the end of a block";
}

fn tv_args_str(args: & Vec<i64>) -> str {
    var s: str = "(";
    var i: i64 = 0;
    while i < args.len() {
        if i > 0 {
            s = s + ", ";
        }
        s = s + int_to_str(args.get(i));
        i = i + 1;
    }
    return s + ")";
}

/// RL5: run `pre` and `post` on the same inputs; "" when every run that
/// finished agrees, "n/a" when none could be run, else the first
/// disagreement.
pub fn tv_random(pre: & IrFunction, post: & IrFunction) -> str {
    if pre.params.len() != post.params.len() {
        return "n/a";
    }
    // 2g.90: a function reading a constant global of the module is run too
    // (its loads give the literal; tv_note_globals)
    var sa: TvShape = tv_shape_x(pre, g_tv_gc, false);
    if !sa.ok {
        return "n/a";
    }
    var sb: TvShape = tv_shape_x(post, g_tv_gc, false);
    if !sb.ok {
        return "n/a";
    }
    var seed: i64 = tv_hash_str(pre.name);
    var conclusive: i64 = 0;
    var run: i64 = 0;
    while run < TV_RUNS {
        var args: Vec<i64> = Vec::new();
        var pi: i64 = 0;
        while pi < pre.params.len() {
            seed = tv_mix(seed, run * 131 + pi + 1);
            args.push(tv_arg(pre.params.get(pi).ty, run, seed));
            pi = pi + 1;
        }
        var oa: TvOut = tv_eval(pre, & sa, & args, TV_STEPS);
        if oa.kind < 4 {
            var ob: TvOut = tv_eval(post, & sb, & args, oa.steps * 8 + 1000);
            if ob.kind < 4 {
                conclusive = conclusive + 1;
                var same: bool = oa.kind == ob.kind && oa.trace == ob.trace;
                if same && oa.kind == 0 {
                    same = oa.val == ob.val;
                }
                if !same {
                    if oa.trace != ob.trace && oa.kind == ob.kind {
                        return "on inputs " + tv_args_str(& args) + " the calls or prints differ";
                    }
                    return "on inputs " + tv_args_str(& args) + " the function " + tv_out_str(& oa) + " before the pass and " + tv_out_str(& ob) + " after it";
                }
            }
        }
        run = run + 1;
    }
    if conclusive == 0 {
        return "n/a";
    }
    return "";
}

// --- Witnesses (VF6) ---------------------------------------------------------------

/// What a pass may do with an instruction: 0 drop it or compute its value
/// another way (pure, cannot panic), 1 keep it or reuse an equal one that
/// comes first (it may panic), 2 keep it in its order (an effect, the end
/// of a block).
fn tv_class(f: & IrFunction, plain: & Vec<i64>, inst: Inst) -> i64 {
    match inst {
        Inst::ConstInt(_, _) => {
            return 0;
        }
        Inst::ConstFloat(_, _) => {
            return 0;
        }
        Inst::ConstBool(_) => {
            return 0;
        }
        Inst::ConstStr(_) => {
            return 0;
        }
        Inst::ConstNull(_) => {
            return 0;
        }
        Inst::ConstFnRef(_) => {
            return 0;
        }
        Inst::GlobalAddr(_, _) => {
            return 0;
        }
        Inst::GetFieldPtr(_, _, _) => {
            return 0;
        }
        Inst::GetElemPtr(_, _, _) => {
            return 0;
        }
        Inst::BitCast(_, _, _) => {
            return 0;
        }
        Inst::IntExtend(_, _, _) => {
            return 0;
        }
        Inst::IntTrunc(_, _, _) => {
            return 0;
        }
        Inst::IntToFloat(_, _, _) => {
            return 0;
        }
        Inst::FloatToInt(_, _, _) => {
            return 1;
        }
        Inst::BinOp(op, _, _, _) => {
            if tv_quiet_op(op) {
                return 0;
            }
            if f.is_wrapping && (binop_eq(op, BinOp::Add) || binop_eq(op, BinOp::Sub) || binop_eq(op, BinOp::Mul)) {
                return 0;
            }
            return 1;
        }
        Inst::UnaryOp(op, _, _) => {
            match op {
                UnaryOp::Neg => {
                    if f.is_wrapping {
                        return 0;
                    }
                    return 1;
                }
                _ => {
                    return 0;
                }
            }
        }
        Inst::Load(p, _) => {
            if tv_get(plain, p) == 1 {
                return 0;
            }
            return 1;
        }
        _ => {
            return 2;
        }
    }
}

fn tv_opt_ty(ot: OptIrType) -> str {
    match ot {
        OptIrType::Some(t) => {
            return ir_type_to_str(t);
        }
        OptIrType::None => {
            return "-";
        }
    }
}

/// An instruction without its value operands: two instructions of one
/// shape on equal operands compute the same thing.
fn tv_shape(inst: Inst) -> str {
    match inst {
        Inst::ConstInt(v, t) => {
            return "ci " + int_to_str(v) + " " + ir_type_to_str(t);
        }
        Inst::ConstBool(v) => {
            if v {
                return "cb 1";
            }
            return "cb 0";
        }
        Inst::ConstStr(s) => {
            return "cs " + s;
        }
        Inst::ConstNull(t) => {
            return "cn " + ir_type_to_str(t);
        }
        Inst::ConstFnRef(s) => {
            return "cf " + s;
        }
        Inst::GlobalAddr(s, t) => {
            return "ga " + s + " " + ir_type_to_str(t);
        }
        Inst::BinOp(op, _, _, t) => {
            return "b " + ir_binop_str(op) + " " + ir_type_to_str(t);
        }
        Inst::UnaryOp(op, _, t) => {
            return "u " + ir_unop_str(op) + " " + ir_type_to_str(t);
        }
        Inst::Alloca(t, _) => {
            return "al " + ir_type_to_str(t);
        }
        Inst::Load(_, t) => {
            return "ld " + ir_type_to_str(t);
        }
        Inst::Store(_, _, ot) => {
            return "st " + tv_opt_ty(ot);
        }
        Inst::GetFieldPtr(_, i, t) => {
            return "gf " + int_to_str(i) + " " + ir_type_to_str(t);
        }
        Inst::GetElemPtr(_, _, t) => {
            return "ge " + ir_type_to_str(t);
        }
        Inst::Jump(t) => {
            return "j " + int_to_str(t);
        }
        Inst::Branch(_, t, e) => {
            return "br " + int_to_str(t) + " " + int_to_str(e);
        }
        Inst::Return(rv) => {
            match rv {
                OptValueId::Some(_) => {
                    return "ret 1";
                }
                OptValueId::None => {
                    return "ret 0";
                }
            }
        }
        Inst::Unreachable => {
            return "unr";
        }
        Inst::Panic(s) => {
            return "pa " + s;
        }
        Inst::Call(nm, args, t, _) => {
            return "call " + nm + " " + int_to_str(args.len()) + " " + ir_type_to_str(t);
        }
        Inst::CallPtr(_, args, t, _, z) => {
            if z {
                return "cp 1 " + int_to_str(args.len()) + " " + ir_type_to_str(t);
            }
            return "cp 0 " + int_to_str(args.len()) + " " + ir_type_to_str(t);
        }
        Inst::DynCall(a1, a2, args, t, _) => {
            return "dc " + a1 + " " + a2 + " " + int_to_str(args.len()) + " " + ir_type_to_str(t);
        }
        Inst::MakeDyn(_, a1, a2) => {
            return "md " + a1 + " " + a2;
        }
        Inst::BitCast(_, a, b) => {
            return "bc " + ir_type_to_str(a) + " " + ir_type_to_str(b);
        }
        Inst::IntExtend(_, a, b) => {
            return "ie " + ir_type_to_str(a) + " " + ir_type_to_str(b);
        }
        Inst::IntTrunc(_, a, b) => {
            return "it " + ir_type_to_str(a) + " " + ir_type_to_str(b);
        }
        Inst::IntToFloat(_, a, b) => {
            return "if " + ir_type_to_str(a) + " " + ir_type_to_str(b);
        }
        Inst::FloatToInt(_, a, b) => {
            return "fi " + ir_type_to_str(a) + " " + ir_type_to_str(b);
        }
        Inst::Print(_, t) => {
            return "pr " + ir_type_to_str(t);
        }
        Inst::StructCopy(_, _, t) => {
            return "sc " + ir_type_to_str(t);
        }
        _ => {
            // operands included: such an instruction must not change at all
            return "? " + inst_detail_str(inst);
        }
    }
}

/// The value of `v` when it is a constant: a ConstInt or ConstBool, or an
/// operation on constants evaluated at its type. Kind 0 a value, 1 the
/// operation panics, 3 constants this evaluator does not compute, 2 not a
/// constant.
pub fn tv_constk(f: & IrFunction, v: i64, d: i64) -> TvK {
    if d > 6 || v < 0 {
        return tv_k(2, 0);
    }
    match IrFunction_get_inst(f, v) {
        OptInst::Some(inst) => {
            match inst {
                Inst::ConstInt(c, t) => {
                    return tv_k(0, tv_narrow(c, t));
                }
                Inst::ConstBool(bv) => {
                    if bv {
                        return tv_k(0, 1);
                    }
                    return tv_k(0, 0);
                }
                Inst::BinOp(op, l, r, t) => {
                    var ka: TvK = tv_constk(f, l, d + 1);
                    if ka.kind == 0 {
                        var kb: TvK = tv_constk(f, r, d + 1);
                        if kb.kind == 0 {
                            var res: TvK = tv_binop(op, ka.v, kb.v, ssa_vty(f, l), t, f.is_wrapping);
                            if res.kind == 2 {
                                return tv_k(3, 0);
                            }
                            return res;
                        }
                    }
                }
                Inst::IntExtend(x, _, to) => {
                    var kx: TvK = tv_constk(f, x, d + 1);
                    if kx.kind == 0 {
                        return tv_k(0, tv_narrow(kx.v, to));
                    }
                }
                Inst::IntTrunc(x, _, to) => {
                    var ky: TvK = tv_constk(f, x, d + 1);
                    if ky.kind == 0 {
                        return tv_k(0, tv_narrow(ky.v, to));
                    }
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return tv_k(2, 0);
}

fn tv_has_inst(f: & IrFunction, v: i64) -> bool {
    match IrFunction_get_inst(f, v) {
        OptInst::Some(_) => {
            return true;
        }
        OptInst::None => {
            return false;
        }
    }
}

/// What one witness check knows: the pass, the plain locals of both
/// functions, where each instruction of the function before the pass is
/// (block index, position), its CFG, the comparisons left, and for each
/// value before the pass the value that stands for it after (+ 1).
pub struct TvCtx {
    pub pname: str,
    pub plain_a: Vec<i64>,
    pub plain_b: Vec<i64>,
    pub blk_a: Vec<i64>,
    pub pos_a: Vec<i64>,
    pub cfg_a: IroCfg,
    pub budget: i64,
    pub rep: Vec<i64>,
}

fn tv_is_slot_load(plain: & Vec<i64>, inst: Inst) -> bool {
    match inst {
        Inst::Load(p, _) => {
            return tv_get(plain, p) == 1;
        }
        _ => {
            return false;
        }
    }
}

/// Is load `b` before load `a` (of pointer `p`) in one block of the
/// function before the pass, with nothing between that may write what they
/// read: for a plain local a store to it, else anything with an effect?
fn tv_quiet_between(pre: & IrFunction, cx: & TvCtx, b: i64, a: i64, p: i64) -> bool {
    var ba: i64 = tv_get(& cx.blk_a, a);
    if b < 0 || b >= cx.blk_a.len() || a < 0 || a >= cx.blk_a.len() {
        return false;
    }
    if ba < 0 || cx.blk_a.get(b) != ba || cx.pos_a.get(b) >= cx.pos_a.get(a) {
        return false;
    }
    var ids: Vec<i64> = pre.blocks.get(ba).instructions;
    var is_local: bool = tv_get(& cx.plain_a, p) == 1;
    var k: i64 = cx.pos_a.get(b) + 1;
    while k < cx.pos_a.get(a) {
        var inst: Inst = peir_inst_of(pre, ids.get(k));
        if is_local {
            match inst {
                Inst::Store(q, _, _) => {
                    if q == p {
                        return false;
                    }
                }
                _ => {
                }
            }
        } else if tv_class(pre, & cx.plain_a, inst) == 2 {
            return false;
        }
        k = k + 1;
    }
    return true;
}

/// Does value `b` after the pass equal value `a` before it?
fn tv_val_eq(pre: & IrFunction, post: & IrFunction, cx: & mut TvCtx, a: i64, b: i64, d: i64) -> bool {
    cx.budget = cx.budget - 1;
    if cx.budget < 0 {
        // out of comparisons: only an unchanged name passes
        return a == b;
    }
    var ka: TvK = tv_constk(pre, a, 0);
    if ka.kind != 2 {
        var kb: TvK = tv_constk(post, b, 0);
        if kb.kind == 0 {
            if ka.kind == 0 {
                return ka.v == kb.v;
            }
            // a fold of an operation that panics is wrong; one of constants
            // this evaluator does not compute is not checked here
            return ka.kind == 3;
        }
    }
    var ha: bool = tv_has_inst(pre, a);
    var hb: bool = tv_has_inst(post, b);
    if cx.pname == "ssa" {
        // a promoted local's value, or a phi's: left to the random runs
        // (RL5, tests/verify/tv/licm_ssa.tvp ssa_promote: the value that
        // replaces a promoted load may be a parameter, which has no
        // instruction, so this comes before the parameters' rule). The
        // check then says "not checkable" when no run can be made.
        var sa: bool = ha && tv_is_slot_load(& cx.plain_a, peir_inst_of(pre, a));
        var sb: bool = hb && tv_is_slot_load(& cx.plain_b, peir_inst_of(post, b));
        if sa || sb {
            g_tv_deferred = true;
            return true;
        }
    }
    if !ha || !hb {
        // parameters: the same one
        return !ha && !hb && a == b;
    }
    var ia: Inst = peir_inst_of(pre, a);
    var ib: Inst = peir_inst_of(post, b);
    if tv_shape(ia) != tv_shape(ib) {
        return false;
    }
    if d >= TV_DEPTH {
        return a == b;
    }
    var cl: i64 = tv_class(pre, & cx.plain_a, ia);
    if cl == 2 {
        // the result of a call or an effect is only itself
        return a == b;
    }
    match ia {
        Inst::Load(lp, _) => {
            if a != b && !tv_quiet_between(pre, cx, b, a, lp) {
                return false;
            }
        }
        _ => {
        }
    }
    var oa: Vec<i64> = Vec::new();
    peir_inst_operands(ia, & mut oa);
    var ob: Vec<i64> = Vec::new();
    peir_inst_operands(ib, & mut ob);
    if oa.len() != ob.len() {
        return false;
    }
    var i: i64 = 0;
    while i < oa.len() {
        if !tv_val_eq(pre, post, cx, oa.get(i), ob.get(i), d + 1) {
            return false;
        }
        i = i + 1;
    }
    if a != b && a >= 0 && a < cx.rep.len() {
        cx.rep.set(a, b + 1);
    }
    return true;
}

/// The instructions of block `ids` that must stay in order (class 2). The
/// SSA round trip may remove and add allocas and the stores of plain locals.
fn tv_kept(f: & IrFunction, plain: & Vec<i64>, ids: Vec<i64>, pname: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < ids.len() {
        var id: i64 = ids.get(k);
        var inst: Inst = peir_inst_of(f, id);
        if tv_class(f, plain, inst) == 2 {
            var keep: bool = true;
            if pname == "ssa" {
                match inst {
                    Inst::Alloca(_, _) => {
                        keep = false;
                    }
                    Inst::Store(p, _, _) => {
                        keep = tv_get(plain, p) == 0;
                    }
                    _ => {
                    }
                }
            }
            if keep {
                out.push(id);
            }
        }
        k = k + 1;
    }
    return out;
}

/// A removed instruction `id` that may panic is covered by an equal one
/// that is kept and runs first (in its block before it, or in a block that
/// dominates it).
fn tv_covered(pre: & IrFunction, post: & IrFunction, cx: & mut TvCtx, in_b: & Vec<i64>, id: i64) -> bool {
    var r: i64 = tv_get(& cx.rep, id);
    var cands: Vec<i64> = Vec::new();
    if r > 0 {
        cands.push(r - 1);
    } else {
        // no use named its replacement: look for an equal computation
        var sh: str = tv_shape(peir_inst_of(pre, id));
        var b: i64 = 0;
        while b < pre.blocks.len() {
            var ids: Vec<i64> = pre.blocks.get(b).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                var y: i64 = ids.get(k);
                if y != id && tv_get(in_b, y) == 1 && tv_shape(peir_inst_of(pre, y)) == sh {
                    cands.push(y);
                }
                k = k + 1;
            }
            b = b + 1;
        }
    }
    var ci: i64 = 0;
    while ci < cands.len() {
        var y2: i64 = cands.get(ci);
        var by: i64 = tv_get(& cx.blk_a, y2);
        var bx: i64 = tv_get(& cx.blk_a, id);
        var first: bool = false;
        if by >= 0 && bx >= 0 && y2 < cx.blk_a.len() {
            if by == bx {
                first = cx.pos_a.get(y2) < cx.pos_a.get(id);
            } else {
                first = iro_dominates(& cx.cfg_a, by, bx);
            }
        }
        if first && tv_get(in_b, y2) == 1 {
            var oa: Vec<i64> = Vec::new();
            peir_inst_operands(peir_inst_of(pre, id), & mut oa);
            var ob: Vec<i64> = Vec::new();
            peir_inst_operands(peir_inst_of(post, y2), & mut ob);
            var same: bool = oa.len() == ob.len() && tv_shape(peir_inst_of(pre, id)) == tv_shape(peir_inst_of(post, y2));
            var i: i64 = 0;
            while same && i < oa.len() {
                same = tv_val_eq(pre, post, cx, oa.get(i), ob.get(i), 1);
                i = i + 1;
            }
            if same {
                return true;
            }
        }
        ci = ci + 1;
    }
    return false;
}

/// VF6: check the rewrites of a pass that keeps value ids (fold, dce, gvn,
/// ssa). "" accepted, "n/a" another pass, else what is wrong.
pub fn tv_structural(pname: str, pre: & IrFunction, post: & IrFunction) -> str {
    g_tv_deferred = false;
    if pname != "fold" && pname != "dce" && pname != "gvn" && pname != "ssa" {
        return "n/a";
    }
    if pre.blocks.len() != post.blocks.len() {
        return "the blocks changed";
    }
    var bi: i64 = 0;
    while bi < pre.blocks.len() {
        if pre.blocks.get(bi).id != post.blocks.get(bi).id {
            return "the blocks changed";
        }
        bi = bi + 1;
    }
    var sa: TvShape = tv_shape_of(pre);
    var sb: TvShape = tv_shape_of(post);
    var nva: i64 = pre.next_value + 1;
    var blk_a: Vec<i64> = Vec::new();
    var pos_a: Vec<i64> = Vec::new();
    var z: i64 = 0;
    while z < nva {
        blk_a.push(- 1);
        pos_a.push(- 1);
        z = z + 1;
    }
    bi = 0;
    while bi < pre.blocks.len() {
        var ids: Vec<i64> = pre.blocks.get(bi).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < nva {
                blk_a.set(id, bi);
                pos_a.set(id, k);
            }
            k = k + 1;
        }
        bi = bi + 1;
    }
    var in_b: Vec<i64> = peir_zeros(post.next_value + 1);
    bi = 0;
    while bi < post.blocks.len() {
        var idb: Vec<i64> = post.blocks.get(bi).instructions;
        var kb: i64 = 0;
        while kb < idb.len() {
            var x: i64 = idb.get(kb);
            if x >= 0 && x < in_b.len() {
                in_b.set(x, 1);
            }
            kb = kb + 1;
        }
        bi = bi + 1;
    }
    var cx: TvCtx = TvCtx {
        pname: pname, plain_a: sa.plain, plain_b: sb.plain, blk_a: blk_a, pos_a: pos_a, cfg_a: iro_cfg(pre), budget: TV_BUDGET, rep: peir_zeros(nva)
    };
    // 1. what has an effect stays, in its order, on equal operands
    bi = 0;
    while bi < pre.blocks.len() {
        var la: Vec<i64> = tv_kept(pre, & cx.plain_a, pre.blocks.get(bi).instructions, pname);
        var lb: Vec<i64> = tv_kept(post, & cx.plain_b, post.blocks.get(bi).instructions, pname);
        var bid: str = int_to_str(pre.blocks.get(bi).id);
        if la.len() != lb.len() {
            return "an instruction with an effect was added or removed in block " + bid;
        }
        var j: i64 = 0;
        while j < la.len() {
            var e: i64 = la.get(j);
            if lb.get(j) != e {
                return "instructions with effects were replaced or reordered in block " + bid;
            }
            var ia: Inst = peir_inst_of(pre, e);
            var ib: Inst = peir_inst_of(post, e);
            if tv_shape(ia) != tv_shape(ib) {
                return "%" + int_to_str(e) + " changed";
            }
            var oa: Vec<i64> = Vec::new();
            peir_inst_operands(ia, & mut oa);
            var ob: Vec<i64> = Vec::new();
            peir_inst_operands(ib, & mut ob);
            if oa.len() != ob.len() {
                return "%" + int_to_str(e) + " changed its operands";
            }
            var o: i64 = 0;
            while o < oa.len() {
                if !tv_val_eq(pre, post, & mut cx, oa.get(o), ob.get(o), 0) {
                    return "an operand of %" + int_to_str(e) + " changed its value";
                }
                o = o + 1;
            }
            j = j + 1;
        }
        bi = bi + 1;
    }
    // 2. what may panic stays (a fold must give its constant) ...
    bi = 0;
    while bi < pre.blocks.len() {
        var ids2: Vec<i64> = pre.blocks.get(bi).instructions;
        var k2: i64 = 0;
        while k2 < ids2.len() {
            var p: i64 = ids2.get(k2);
            if tv_class(pre, & cx.plain_a, peir_inst_of(pre, p)) == 1 && tv_get(& in_b, p) == 1 {
                if !tv_val_eq(pre, post, & mut cx, p, p, 0) {
                    return "%" + int_to_str(p) + " (it may panic) changed its value";
                }
            }
            k2 = k2 + 1;
        }
        bi = bi + 1;
    }
    // ... or an equal one that comes first stands for it
    bi = 0;
    while bi < pre.blocks.len() {
        var ids3: Vec<i64> = pre.blocks.get(bi).instructions;
        var k3: i64 = 0;
        while k3 < ids3.len() {
            var q: i64 = ids3.get(k3);
            if tv_class(pre, & cx.plain_a, peir_inst_of(pre, q)) == 1 && tv_get(& in_b, q) == 0 {
                if !tv_covered(pre, post, & mut cx, & in_b, q) {
                    return "%" + int_to_str(q) + " (it may panic) was removed with nothing equal before it";
                }
            }
            k3 = k3 + 1;
        }
        bi = bi + 1;
    }
    return "";
}

// --- Shared by the witnesses below ---------------------------------------------

/// How deep the module checks follow calls into the module, and the largest
/// function written as an SMT obligation (instructions).
const TV_CALL_DEPTH: i64 = 6; const TV_SMT_MAX: i64 = 400;

/// Per value of a function (ids below `n`): the index of the block holding
/// it and its position there; -1 in no block, -2 in more than one place.
pub struct TvPos {
    pub blk: Vec<i64>,
    pub pos: Vec<i64>,
}

fn tv_pos_of(f: & IrFunction, n: i64) -> TvPos {
    var blk: Vec<i64> = Vec::new();
    var pos: Vec<i64> = Vec::new();
    var z: i64 = 0;
    while z < n {
        blk.push(- 1);
        pos.push(- 1);
        z = z + 1;
    }
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < n {
                if blk.get(id) != - 1 {
                    blk.set(id, - 2);
                } else {
                    blk.set(id, b);
                    pos.set(id, k);
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return TvPos {
        blk: blk, pos: pos
    };
}

/// The larger of the two functions' value counts.
fn tv_nvals(a: & IrFunction, b: & IrFunction) -> i64 {
    if a.next_value > b.next_value {
        return a.next_value + 1;
    }
    return b.next_value + 1;
}

fn tv_same_ids(a: & Vec<i64>, b: & Vec<i64>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    var i: i64 = 0;
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// The same instruction on the same operands (value ids)?
fn tv_same_inst(ia: Inst, ib: Inst) -> bool {
    if tv_shape(ia) != tv_shape(ib) {
        return false;
    }
    var oa: Vec<i64> = Vec::new();
    peir_inst_operands(ia, & mut oa);
    var ob: Vec<i64> = Vec::new();
    peir_inst_operands(ib, & mut ob);
    return tv_same_ids(& oa, & ob);
}

/// "" when both functions have the same blocks holding the same ids, in
/// the same order; else what differs.
fn tv_same_blocks(pre: & IrFunction, post: & IrFunction) -> str {
    if pre.blocks.len() != post.blocks.len() {
        return "the blocks changed";
    }
    var bi: i64 = 0;
    while bi < pre.blocks.len() {
        var ba: BasicBlock = pre.blocks.get(bi);
        var bb: BasicBlock = post.blocks.get(bi);
        if ba.id != bb.id {
            return "the blocks changed";
        }
        if !tv_same_ids(& ba.instructions, & bb.instructions) {
            return "the instructions of block " + int_to_str(ba.id) + " changed";
        }
        bi = bi + 1;
    }
    return "";
}

/// Is `y` of `f` neither able to panic nor seen (tv_class 0), or a stack slot?
fn tv_quiet_id(f: & IrFunction, plain: & Vec<i64>, y: i64) -> bool {
    var inst: Inst = peir_inst_of(f, y);
    match inst {
        Inst::Alloca(_, _) => {
            return true;
        }
        _ => {
        }
    }
    return tv_class(f, plain, inst) == 0;
}

// --- LICM's witness (VF6) --------------------------------------------------------

/// Calls the pass manager vouches for when LICM moved them (iropt.fd
/// iro_tv_licm_calls, from its effect masks): name -> 1 no effect but a
/// panic, 2 ends, never panics and touches no memory. Trusted, as the call
/// sites' effect annotations are.
var g_tv_calls: i64 = 0;

/// Vouch for calls of `name` (kind 1 or 2, see g_tv_calls).
pub fn tv_trust_call(name: str, kind: i64) {
    if g_tv_calls == 0 {
        g_tv_calls = HashMap_new();
    }
    HashMap_insert(g_tv_calls, name, kind);
}

fn tv_call_kind(name: str) -> i64 {
    if g_tv_calls == 0 {
        return 0;
    }
    return HashMap_get(g_tv_calls, name);
}

/// Does a block of loop `body` (flags per block index) of `f` store local `p`?
fn tv_loop_stores(f: & IrFunction, body: & Vec<i64>, p: i64) -> bool {
    var b: i64 = 0;
    while b < f.blocks.len() && b < body.len() {
        if body.get(b) == 1 {
            var ids: Vec<i64> = f.blocks.get(b).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                match peir_inst_of(f, ids.get(k)) {
                    Inst::Store(q, _, _) => {
                        if q == p {
                            return true;
                        }
                    }
                    _ => {
                    }
                }
                k = k + 1;
            }
        }
        b = b + 1;
    }
    return false;
}

/// May something in loop `body` of `f` write memory other than its plain
/// locals? With `lens`, calls that keep every Vec's length (`get`, `set`,
/// `len`) do not count.
fn tv_loop_writes(f: & IrFunction, plain: & Vec<i64>, body: & Vec<i64>, lens: bool) -> bool {
    var b: i64 = 0;
    while b < f.blocks.len() && b < body.len() {
        if body.get(b) == 1 {
            var ids: Vec<i64> = f.blocks.get(b).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                var inst: Inst = peir_inst_of(f, ids.get(k));
                match inst {
                    Inst::Store(q, _, _) => {
                        if tv_get(plain, q) != 1 {
                            return true;
                        }
                    }
                    Inst::Call(cn, _, _, ce) => {
                        var es: EffectSet = ce;
                        var fine: bool = EffectSet_is_pure(& es) || tv_call_kind(cn) > 0;
                        if lens && (cn == "Vec_get" || cn == "Vec_set" || cn == "Vec_len" || cn == "p_vec_get" || cn == "p_vec_set" || cn == "p_vec_len") {
                            fine = true;
                        }
                        if !fine {
                            return true;
                        }
                    }
                    Inst::Jump(_) => {
                    }
                    Inst::Branch(_, _, _) => {
                    }
                    Inst::Switch(_, _, _, _) => {
                    }
                    Inst::Return(_) => {
                    }
                    Inst::Unreachable => {
                    }
                    Inst::Panic(_) => {
                    }
                    Inst::Print(_, _) => {
                    }
                    Inst::Alloca(_, _) => {
                    }
                    _ => {
                        if tv_class(f, plain, inst) == 2 {
                            return true;
                        }
                    }
                }
                k = k + 1;
            }
        }
        b = b + 1;
    }
    return false;
}

/// Is block index `p` the one way into the loop headed by block index `h`
/// (whose blocks `body` flags), ending in a jump to it?
fn tv_enters(f: & IrFunction, cfg: & IroCfg, body: & Vec<i64>, h: i64, p: i64) -> bool {
    if h < 0 || h >= cfg.preds.len() || p < 0 || p >= f.blocks.len() {
        return false;
    }
    var hp: Vec<i64> = cfg.preds.get(h);
    var seen: bool = false;
    var i: i64 = 0;
    while i < hp.len() {
        var q: i64 = hp.get(i);
        if q >= 0 && q < body.len() && body.get(q) == 0 {
            if q != p {
                return false;
            }
            seen = true;
        }
        i = i + 1;
    }
    if !seen {
        return false;
    }
    var ids: Vec<i64> = f.blocks.get(p).instructions;
    if ids.len() == 0 {
        return false;
    }
    match peir_inst_of(f, ids.get(ids.len() - 1)) {
        Inst::Jump(t) => {
            return t == f.blocks.get(h).id;
        }
        _ => {
        }
    }
    return false;
}

/// Did `v` (in block index `from` of the loop headed by `head`), before the
/// pass, run each time the loop was entered and before anything that can
/// panic or be seen? Only quiet instructions stay ahead of it in its block,
/// and from the header to its block the way is a chain of inner loops, each
/// entered by a jump from a block of quiet instructions.
fn tv_licm_first(pre: & IrFunction, cfg: & IroCfg, loops: & IroLoops, pa: & TvPos, pb: & TvPos, plain: & Vec<i64>, v: i64, src: i64, head: i64) -> bool {
    var ids: Vec<i64> = pre.blocks.get(src).instructions;
    var k: i64 = 0;
    while k < pa.pos.get(v) && k < ids.len() {
        var y: i64 = ids.get(k);
        if y >= 0 && y < pb.blk.len() && pb.blk.get(y) == src && !tv_quiet_id(pre, plain, y) {
            return false;
        }
        k = k + 1;
    }
    var cur: i64 = src;
    var steps: i64 = 0;
    while cur != head {
        steps = steps + 1;
        if steps > 16 {
            return false;
        }
        var cb: Vec<i64> = iro_loop_body(loops, cur);
        if cur >= cb.len() || cb.get(cur) != 1 {
            return false;
        }
        var hp: Vec<i64> = cfg.preds.get(cur);
        var q: i64 = - 1;
        var i: i64 = 0;
        while i < hp.len() {
            var r: i64 = hp.get(i);
            if r >= 0 && r < cb.len() && cb.get(r) == 0 {
                if q >= 0 && q != r {
                    return false;
                }
                q = r;
            }
            i = i + 1;
        }
        if q < 0 || !tv_enters(pre, cfg, & cb, cur, q) {
            return false;
        }
        var qi: Vec<i64> = pre.blocks.get(q).instructions;
        var kq: i64 = 0;
        while kq + 1 < qi.len() {
            var yq: i64 = qi.get(kq);
            if yq >= 0 && yq < pb.blk.len() && pb.blk.get(yq) == q && !tv_quiet_id(pre, plain, yq) {
                return false;
            }
            kq = kq + 1;
        }
        cur = q;
    }
    return true;
}

/// May `v`, which LICM moved from block index `from` to `to`, run there?
/// "" yes, else why not.
fn tv_licm_move(pre: & IrFunction, post: & IrFunction, cfg: & IroCfg, loops: & IroLoops, pa: & TvPos, pb: & TvPos, plain: & Vec<i64>, v: i64, src: i64, to: i64) -> str {
    // the loop it left: one holding block `src` that block `to` enters
    var head: i64 = - 1;
    var body: Vec<i64> = Vec::new();
    var hi: i64 = 0;
    while hi < loops.headers.len() && head < 0 {
        var hh: i64 = loops.headers.get(hi);
        var bd: Vec<i64> = iro_loop_body(loops, hh);
        if src < bd.len() && bd.get(src) == 1 && to >= 0 && to < bd.len() && bd.get(to) == 0 && tv_enters(post, cfg, & bd, hh, to) {
            head = hh;
            body = bd;
        }
        hi = hi + 1;
    }
    if head < 0 {
        return "moved to a block that is not the way into a loop holding it";
    }
    var inst: Inst = peir_inst_of(pre, v);
    // its operands come from outside the loop, or moved ahead of it
    var ops: Vec<i64> = Vec::new();
    peir_inst_operands(inst, & mut ops);
    var o: i64 = 0;
    while o < ops.len() {
        var x: i64 = ops.get(o);
        if x >= 0 && x < pa.blk.len() && pa.blk.get(x) >= 0 {
            var xa: i64 = pa.blk.get(x);
            if xa < body.len() && body.get(xa) == 1 {
                if pb.blk.get(x) != to || pb.pos.get(x) >= pb.pos.get(v) {
                    return "reads %" + int_to_str(x) + ", which the loop computes";
                }
            }
        }
        o = o + 1;
    }
    var cl: i64 = tv_class(pre, plain, inst);
    match inst {
        Inst::Load(lp, _) => {
            if tv_get(plain, lp) == 1 {
                if tv_loop_stores(pre, & body, lp) {
                    return "loads a local the loop stores";
                }
                return "";
            }
            if tv_loop_writes(pre, plain, & body, false) {
                return "loads memory the loop may write";
            }
            cl = 1;
        }
        Inst::Call(cn, _, _, ce) => {
            if cn == "Vec_len" || cn == "p_vec_len" {
                if tv_loop_writes(pre, plain, & body, true) {
                    return "is `len` of a Vec the loop may resize";
                }
                return "";
            }
            var es: EffectSet = ce;
            var kind: i64 = tv_call_kind(cn);
            if kind == 2 {
                return "";
            }
            if kind != 1 && !EffectSet_is_pure(& es) {
                return "is a call that may have an effect";
            }
            cl = 1;
        }
        _ => {
        }
    }
    if cl == 0 {
        return "";
    }
    if cl == 2 {
        return "has an effect";
    }
    if !tv_licm_first(pre, cfg, loops, pa, pb, plain, v, src, head) {
        return "may panic, and did not run first each time the loop was entered";
    }
    return "";
}

/// VF6: LICM's witness (iropt.fd iro_licm, OP9/OP25). The pass keeps every
/// value id and only moves instructions, each into the block that is the
/// way into a loop holding it (that block ends in a jump to the loop's
/// header). Checked: the same instructions on the same operands; in every
/// block those that stayed keep their order; and each one that moved may
/// run there: its operands come from outside the loop (or moved ahead of
/// it), and
///   - one that can neither panic nor be seen (tv_class 0) may come from any
///     block of the loop; a load of a local only if the loop never stores it;
///   - one that may panic (checked arithmetic, a call with no effect but a
///     panic, a load from memory nothing in the loop writes) only when it
///     ran, before the pass, first thing each time the loop was entered
///     (tv_licm_first);
///   - `len` of a Vec when nothing in the loop can resize one.
pub fn tv_licm(pre: & IrFunction, post: & IrFunction) -> str {
    if pre.blocks.len() != post.blocks.len() {
        return "the blocks changed";
    }
    var bi: i64 = 0;
    while bi < pre.blocks.len() {
        if pre.blocks.get(bi).id != post.blocks.get(bi).id {
            return "the blocks changed";
        }
        bi = bi + 1;
    }
    var n: i64 = tv_nvals(pre, post);
    var pa: TvPos = tv_pos_of(pre, n);
    var pb: TvPos = tv_pos_of(post, n);
    var sa: TvShape = tv_shape_of(pre);
    var plain: Vec<i64> = sa.plain;
    var v: i64 = 0;
    while v < n {
        var ba: i64 = pa.blk.get(v);
        var bb: i64 = pb.blk.get(v);
        if ba == - 2 || bb == - 2 {
            return "%" + int_to_str(v) + " is in two places";
        }
        if (ba < 0 && bb >= 0) || (ba >= 0 && bb < 0) {
            return "%" + int_to_str(v) + " was added or removed";
        }
        if ba >= 0 && !tv_same_inst(peir_inst_of(pre, v), peir_inst_of(post, v)) {
            return "%" + int_to_str(v) + " changed";
        }
        v = v + 1;
    }
    // what stayed keeps its order
    bi = 0;
    while bi < pre.blocks.len() {
        var ia: Vec<i64> = pre.blocks.get(bi).instructions;
        var ib: Vec<i64> = post.blocks.get(bi).instructions;
        var sa_ids: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < ia.len() {
            var x: i64 = ia.get(k);
            if x >= 0 && x < n && pb.blk.get(x) == bi {
                sa_ids.push(x);
            }
            k = k + 1;
        }
        var sb_ids: Vec<i64> = Vec::new();
        var k2: i64 = 0;
        while k2 < ib.len() {
            var y: i64 = ib.get(k2);
            if y >= 0 && y < n && pa.blk.get(y) == bi {
                sb_ids.push(y);
            }
            k2 = k2 + 1;
        }
        if !tv_same_ids(& sa_ids, & sb_ids) {
            return "the instructions of block " + int_to_str(pre.blocks.get(bi).id) + " were reordered";
        }
        bi = bi + 1;
    }
    // what moved may run where it went
    var cfg: IroCfg = iro_cfg(pre);
    var loops: IroLoops = iro_loops(& cfg);
    v = 0;
    while v < n {
        var src: i64 = pa.blk.get(v);
        var to: i64 = pb.blk.get(v);
        if src >= 0 && src != to {
            var why: str = tv_licm_move(pre, post, & cfg, & loops, & pa, & pb, & plain, v, src, to);
            if str_len(why) > 0 {
                return "%" + int_to_str(v) + " " + why;
            }
        }
        v = v + 1;
    }
    return "";
}

// --- Devirtualization's witness (VF6) --------------------------------------------

/// Is `ib` (after the pass) the direct call iro_devirt makes of `ia`, a
/// trait call on a value just made from a known type? "" yes, else why not.
fn tv_devirt_call(module: & IrModule, pre: & IrFunction, post: & IrFunction, pa: & TvPos, ia: Inst, ib: Inst) -> str {
    match ia {
        Inst::DynCall(_tr, method, args, ret, _de) => {
            match ib {
                Inst::Call(cn, nargs, ret2, _ce) => {
                    if args.len() == 0 {
                        return "has no receiver";
                    }
                    match peir_inst_of(pre, args.get(0)) {
                        Inst::MakeDyn(dv, tname, _tn) => {
                            var want: str = tname + "_" + method;
                            if cn != want {
                                return "calls " + cn + ", not " + want;
                            }
                            if nargs.len() != args.len() + 1 {
                                return "passes " + int_to_str(nargs.len()) + " arguments to " + cn;
                            }
                            if !ir_type_eq(ret, ret2) {
                                return "changed its result type";
                            }
                            var e0: i64 = nargs.get(0);
                            if e0 >= 0 && e0 < pa.blk.len() && pa.blk.get(e0) >= 0 {
                                return "passes an old value as the env";
                            }
                            match peir_inst_of(post, e0) {
                                Inst::ConstInt(c0, _) => {
                                    if c0 != 0 {
                                        return "passes an env other than 0";
                                    }
                                }
                                _ => {
                                    return "passes an env that is not a constant";
                                }
                            }
                            if nargs.get(1) != dv {
                                return "does not pass the value the dyn was made of";
                            }
                            var ai: i64 = 1;
                            while ai < args.len() {
                                if nargs.get(ai + 1) != args.get(ai) {
                                    return "changed an argument";
                                }
                                ai = ai + 1;
                            }
                            match IrModule_get_function(module, cn) {
                                OptIrFunction::Some(cf) => {
                                    if cf.blocks.len() > 0 && cf.params.len() != nargs.len() {
                                        return "calls " + cn + ", which takes " + int_to_str(cf.params.len()) + " parameters, with " + int_to_str(nargs.len());
                                    }
                                }
                                OptIrFunction::None => {
                                    return "calls " + cn + ", which is not a function of the module";
                                }
                            }
                            return "";
                        }
                        _ => {
                            return "is not a call on a value made from a known type";
                        }
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return "changed";
}

/// VF6: devirtualization's witness (iropt.fd iro_devirt, WP16): a trait
/// call on a value made from a known type T is a direct call of T's method:
/// DynCall(trait, m, [MakeDyn(v, T, ..), a...]) -> Call(T_m, [0, v, a...]),
/// with the same result type, T_m a function of the module with that many
/// parameters, and the 0 (the env slot) a new constant just before it.
/// Nothing else may change.
pub fn tv_devirt(module: & IrModule, pre: & IrFunction, post: & IrFunction) -> str {
    if pre.blocks.len() != post.blocks.len() {
        return "the blocks changed";
    }
    var n: i64 = tv_nvals(pre, post);
    var pa: TvPos = tv_pos_of(pre, n);
    var bi: i64 = 0;
    while bi < pre.blocks.len() {
        if pre.blocks.get(bi).id != post.blocks.get(bi).id {
            return "the blocks changed";
        }
        var bid: str = int_to_str(pre.blocks.get(bi).id);
        var ia: Vec<i64> = pre.blocks.get(bi).instructions;
        var ib: Vec<i64> = post.blocks.get(bi).instructions;
        var ka: i64 = 0;
        var kb: i64 = 0;
        while kb < ib.len() {
            var y: i64 = ib.get(kb);
            if y < 0 || y >= n || pa.blk.get(y) < 0 {
                match peir_inst_of(post, y) {
                    Inst::ConstInt(cy, _) => {
                        if cy != 0 {
                            return "%" + int_to_str(y) + " is new, and not the env slot of a call";
                        }
                    }
                    _ => {
                        return "%" + int_to_str(y) + " is a new instruction";
                    }
                }
            } else {
                if ka >= ia.len() || ia.get(ka) != y {
                    return "the instructions of block " + bid + " changed";
                }
                var xa: Inst = peir_inst_of(pre, y);
                var xb: Inst = peir_inst_of(post, y);
                if !tv_same_inst(xa, xb) {
                    var why: str = tv_devirt_call(module, pre, post, & pa, xa, xb);
                    if str_len(why) > 0 {
                        return "%" + int_to_str(y) + " " + why;
                    }
                }
                ka = ka + 1;
            }
            kb = kb + 1;
        }
        if ka != ia.len() {
            return "an instruction of block " + bid + " was removed";
        }
        bi = bi + 1;
    }
    return "";
}

/// tv_after for iro_devirt, which reads the module.
pub fn tv_after_devirt(module: & IrModule, pre: & IrFunction, f: & mut IrFunction) -> bool {
    if !tv_on() {
        return true;
    }
    var inj: bool = false;
    if tv_inject_on("devirt", f.name) {
        inj = tv_inject_fn(f);
    }
    var why: str = tv_devirt(module, pre, f);
    if str_len(why) == 0 {
        var r: str = tv_random(pre, f);
        if str_len(r) > 0 && r != "n/a" {
            why = r;
        }
    }
    return tv_settle("devirt", why, inj, pre, f);
}

// --- Faults put in on purpose (FID_TV_INJECT, VF6 negative tests) ---------------

var g_tv_inj_read: bool = false;
var g_tv_inj_list: str = "";
var g_tv_inj_in: str = "";

/// Is a fault to be put into what pass `pname` made of function `fname`?
/// FID_TV_INJECT is a comma list of passes ("all": every one);
/// FID_TV_INJECT_IN, when set, a prefix the function's name must have.
fn tv_inject_on(pname: str, fname: str) -> bool {
    if !g_tv_inj_read {
        g_tv_inj_read = true;
        var ev: str = p_getenv("FID_TV_INJECT");
        if (ev as i64) != 0 && str_len(ev) > 0 {
            g_tv_inj_list = "," + ev + ",";
        }
        var ei: str = p_getenv("FID_TV_INJECT_IN");
        if (ei as i64) != 0 && str_len(ei) > 0 {
            g_tv_inj_in = ei;
        }
    }
    if str_len(g_tv_inj_list) == 0 {
        return false;
    }
    if str_len(g_tv_inj_in) > 0 && !str_starts_with(fname, g_tv_inj_in) {
        return false;
    }
    return str_contains(g_tv_inj_list, "," + pname + ",") || str_contains(g_tv_inj_list, ",all,");
}

/// Compute value `x` of `f` wrongly: an addition becomes a subtraction, a
/// subtraction, product, xor or or an addition, an integer constant gets its
/// low bit flipped. False when `x` is none of these.
fn tv_inject_at(f: & mut IrFunction, x: i64) -> bool {
    match IrFunction_get_inst(f, x) {
        OptInst::Some(inst) => {
            match inst {
                Inst::BinOp(op, l, r, t) => {
                    if !ir_type_is_int(t) {
                        return false;
                    }
                    var nop: BinOp = BinOp::Add;
                    if binop_eq(op, BinOp::Add) {
                        nop = BinOp::Sub;
                    } else if !(binop_eq(op, BinOp::Sub) || binop_eq(op, BinOp::Mul) || binop_eq(op, BinOp::BitXor) || binop_eq(op, BinOp::BitOr)) {
                        return false;
                    }
                    IrFunction_set_inst(f, x, Inst::BinOp(nop, l, r, t));
                    return true;
                }
                Inst::ConstInt(c, ct) => {
                    if !ir_type_is_int(ct) {
                        return false;
                    }
                    IrFunction_set_inst(f, x, Inst::ConstInt(c ^ 1, ct));
                    return true;
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return false;
}

/// An instruction that only computes a value (no effect, no control):
/// what the program does depends on it only through its uses.
fn tv_pure_value(inst: Inst) -> bool {
    match inst {
        Inst::ConstInt(_, _) => {
            return true;
        }
        Inst::ConstFloat(_, _) => {
            return true;
        }
        Inst::ConstBool(_) => {
            return true;
        }
        Inst::ConstStr(_) => {
            return true;
        }
        Inst::ConstNull(_) => {
            return true;
        }
        Inst::ConstFnRef(_) => {
            return true;
        }
        Inst::GlobalAddr(_, _) => {
            return true;
        }
        Inst::Alloca(_, _) => {
            return true;
        }
        Inst::Load(_, _) => {
            return true;
        }
        Inst::GetFieldPtr(_, _, _) => {
            return true;
        }
        Inst::GetElemPtr(_, _, _) => {
            return true;
        }
        Inst::BitCast(_, _, _) => {
            return true;
        }
        Inst::IntExtend(_, _, _) => {
            return true;
        }
        Inst::IntTrunc(_, _, _) => {
            return true;
        }
        Inst::IntToFloat(_, _, _) => {
            return true;
        }
        Inst::FloatToInt(_, _, _) => {
            return true;
        }
        Inst::BinOp(_, _, _, _) => {
            return true;
        }
        Inst::UnaryOp(_, _, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// 2g.90 (VF6): per value of `f` (1), whether an effect, a branch or a
/// return depends on it. A fault put into any other value changes nothing
/// the program does, and the checks rightly accept the result: most of the
/// faults reported "NOT caught" went into such values (alone, each left the
/// program's output as it was). A store into a plain local (an alloca only
/// loads and stores touch) counts when a load that counts reads the local;
/// every instruction that is not a pure value (tv_pure_value) counts.
fn tv_live_of(f: & IrFunction) -> Vec<i64> {
    var nv: i64 = f.next_value + 1;
    var live: Vec<i64> = peir_zeros(nv);
    var sh: TvShape = tv_shape_of(f);
    var changed: bool = true;
    while changed {
        changed = false;
        var b: i64 = 0;
        while b < f.blocks.len() {
            var ids: Vec<i64> = f.blocks.get(b).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                var id: i64 = ids.get(k);
                var inst: Inst = peir_inst_of(f, id);
                var on: bool = tv_get(& live, id) == 1;
                match inst {
                    Inst::Store(p, _, _) => {
                        on = tv_get(& sh.plain, p) != 1 || tv_get(& live, p) == 1;
                    }
                    _ => {
                        if !tv_pure_value(inst) {
                            on = true;
                        }
                    }
                }
                if on {
                    var ops: Vec<i64> = Vec::new();
                    peir_inst_operands(inst, & mut ops);
                    var o: i64 = 0;
                    while o < ops.len() {
                        var x: i64 = ops.get(o);
                        if x >= 0 && x < nv && live.get(x) == 0 {
                            live.set(x, 1);
                            changed = true;
                        }
                        o = o + 1;
                    }
                }
                k = k + 1;
            }
            b = b + 1;
        }
    }
    return live;
}

/// Put a fault into `f`: the value its first return returns is computed
/// wrongly (tv_inject_at), else the first value anywhere that can be and
/// that what the function does depends on (tv_live_of; 2g.90). False when
/// `f` has none.
fn tv_inject_fn(f: & mut IrFunction) -> bool {
    var live: Vec<i64> = tv_live_of(f);
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            match peir_inst_of(f, ids.get(k)) {
                Inst::Return(rv) => {
                    match rv {
                        OptValueId::Some(x) => {
                            if tv_inject_at(f, x) {
                                return true;
                            }
                        }
                        OptValueId::None => {
                        }
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var b2: i64 = 0;
    while b2 < f.blocks.len() {
        var ids2: Vec<i64> = f.blocks.get(b2).instructions;
        var k2: i64 = 0;
        while k2 < ids2.len() {
            if tv_get(& live, ids2.get(k2)) == 1 && tv_inject_at(f, ids2.get(k2)) {
                return true;
            }
            k2 = k2 + 1;
        }
        b2 = b2 + 1;
    }
    return false;
}

// --- SMT obligations for straight-line code (VF6, design step 4) -----------------
//
// With FID_VALIDATE_SMT=<dir>, every pair (before, after a pass) of which
// both are one block of integer code without calls is written to
// <dir>/tv<N>.smt2: both functions as bit-vector terms over the same
// parameters, and the assertion that they differ (in whether they panic,
// or, when neither does, in what they return). `unsat` from z3 proves the
// pass right on that function; tests/tooling/tv-check.sh runs them.
// Values are 64-bit vectors holding what tv_narrow holds; checked
// arithmetic is computed exactly on 128 bits, and it panics when the result
// does not fit its type.

var g_tv_smt_read: bool = false;
var g_tv_smt_dir: str = "";
var g_tv_smt_n: i64 = 0;

/// FID_VALIDATE_SMT: the directory the obligations go to ("" none).
fn tv_smt_dir() -> str {
    if !g_tv_smt_read {
        g_tv_smt_read = true;
        var d: str = p_getenv("FID_VALIDATE_SMT");
        if (d as i64) != 0 && str_len(d) > 0 {
            g_tv_smt_dir = d;
        }
    }
    return g_tv_smt_dir;
}

/// One function as SMT-LIB: the definitions of its values (named prefix +
/// id; parameter i is p<i>), what it returns, and when it panics. ok is
/// false when it is not one block of integer code without calls.
pub struct TvSmt {
    pub ok: bool,
    pub defs: str,
    pub ret: str,
    pub pan: str,
}

/// One operation: its term, and when it panics ("": never).
pub struct TvSmtE {
    pub ok: bool,
    pub term: str,
    pub cond: str,
}

fn tv_smt_e(ok: bool, term: str, cond: str) -> TvSmtE {
    return TvSmtE {
        ok: ok, term: term, cond: cond
    };
}

fn tv_hex(d: i64) -> str {
    if d < 10 {
        return int_to_str(d);
    }
    if d == 10 {
        return "a";
    }
    if d == 11 {
        return "b";
    }
    if d == 12 {
        return "c";
    }
    if d == 13 {
        return "d";
    }
    if d == 14 {
        return "e";
    }
    return "f";
}

/// `v` as a 64-bit SMT-LIB literal.
@wrapping fn tv_smt_lit(v: i64) -> str {
    var s: str = "#x";
    var i: i64 = 0;
    while i < 16 {
        s = s + tv_hex((v >> (60 - 4 * i)) & 15);
        i = i + 1;
    }
    return s;
}

/// Term `x` as a value of type `t` (what tv_narrow does).
fn tv_smt_narrow(x: str, t: IrType) -> str {
    var bits: i64 = tv_bits(t);
    if bits >= 64 {
        return x;
    }
    var ext: str = "zero_extend";
    if tv_signed(t) {
        ext = "sign_extend";
    }
    return "((_ " + ext + " " + int_to_str(64 - bits) + ") ((_ extract " + int_to_str(bits - 1) + " 0) " + x + "))";
}

fn tv_smt_ext(x: str, sgn: bool) -> str {
    if sgn {
        return "((_ sign_extend 64) " + x + ")";
    }
    return "((_ zero_extend 64) " + x + ")";
}

/// Checked `op` (bvadd, bvsub, bvmul) computed exactly on 128 bits:
/// the low 64 bits, and the condition that the result does not fit `ot`.
fn tv_smt_checked(op: str, a: str, b: str, ot: IrType) -> TvSmtE {
    var sgn: bool = tv_signed(ot);
    var e: str = "(" + op + " " + tv_smt_ext(a, sgn) + " " + tv_smt_ext(b, sgn) + ")";
    var lo: str = "((_ extract 63 0) " + e + ")";
    return tv_smt_e(true, lo, "(not (= " + e + " " + tv_smt_ext(tv_smt_narrow(lo, ot), sgn) + "))");
}

/// `a op b` (terms) with operands of type `ot` and a result of type `rt`;
/// `rid` is the right operand's value (a shift needs a constant amount).
@wrapping fn tv_smt_binop(f: & IrFunction, op: BinOp, a: str, b: str, rid: i64, ot: IrType, rt: IrType, wrap: bool) -> TvSmtE {
    var no: TvSmtE = tv_smt_e(false, "", "");
    if tv_is_float(ot) || tv_is_float(rt) {
        return no;
    }
    var bits: i64 = tv_bits(ot);
    var sgn: bool = tv_signed(ot);
    var one: str = tv_smt_lit(1);
    var zero: str = tv_smt_lit(0);
    if tv_cmp(op) {
        var c: str = "";
        var pf: str = "bvu";
        if sgn {
            pf = "bvs";
        }
        if binop_eq(op, BinOp::Eq) {
            c = "(= " + a + " " + b + ")";
        } else if binop_eq(op, BinOp::Neq) {
            c = "(not (= " + a + " " + b + "))";
        } else if binop_eq(op, BinOp::Lt) {
            c = "(" + pf + "lt " + a + " " + b + ")";
        } else if binop_eq(op, BinOp::Gt) {
            c = "(" + pf + "gt " + a + " " + b + ")";
        } else if binop_eq(op, BinOp::LtEq) {
            c = "(" + pf + "le " + a + " " + b + ")";
        } else {
            c = "(" + pf + "ge " + a + " " + b + ")";
        }
        return tv_smt_e(true, "(ite " + c + " " + one + " " + zero + ")", "");
    }
    if binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or) {
        if bits != 1 {
            return no;
        }
        if binop_eq(op, BinOp::And) {
            return tv_smt_e(true, "(bvand " + a + " " + b + ")", "");
        }
        return tv_smt_e(true, "(bvor " + a + " " + b + ")", "");
    }
    if binop_eq(op, BinOp::BitAnd) {
        return tv_smt_e(true, tv_smt_narrow("(bvand " + a + " " + b + ")", rt), "");
    }
    if binop_eq(op, BinOp::BitOr) {
        return tv_smt_e(true, tv_smt_narrow("(bvor " + a + " " + b + ")", rt), "");
    }
    if binop_eq(op, BinOp::BitXor) {
        return tv_smt_e(true, tv_smt_narrow("(bvxor " + a + " " + b + ")", rt), "");
    }
    if bits == 1 {
        return no;
    }
    if binop_eq(op, BinOp::Shl) || binop_eq(op, BinOp::Shr) {
        var kb: TvK = tv_constk(f, rid, 0);
        if kb.kind != 0 || kb.v < 0 || kb.v >= bits {
            return no;
        }
        if binop_eq(op, BinOp::Shl) {
            return tv_smt_e(true, tv_smt_narrow("(bvshl " + a + " " + b + ")", rt), "");
        }
        if sgn {
            return tv_smt_e(true, tv_smt_narrow("(bvashr " + a + " " + b + ")", rt), "");
        }
        return tv_smt_e(true, tv_smt_narrow("(bvlshr " + a + " " + b + ")", rt), "");
    }
    var zc: str = "(= " + b + " " + zero + ")";
    if binop_eq(op, BinOp::Add) || binop_eq(op, BinOp::Sub) || binop_eq(op, BinOp::Mul) {
        var o: str = "bvadd";
        if binop_eq(op, BinOp::Sub) {
            o = "bvsub";
        }
        if binop_eq(op, BinOp::Mul) {
            o = "bvmul";
        }
        if wrap {
            return tv_smt_e(true, tv_smt_narrow("(" + o + " " + a + " " + b + ")", rt), "");
        }
        return tv_smt_checked(o, a, b, ot);
    }
    if binop_eq(op, BinOp::Div) {
        if !sgn {
            return tv_smt_e(true, tv_smt_narrow("(bvudiv " + a + " " + b + ")", rt), zc);
        }
        // exact on 64 bits (the operands hold sign-extended values, and a
        // 128-bit division is too slow for the solver): it overflows only
        // for the type's minimum divided by -1
        var q: str = "(bvsdiv " + a + " " + b + ")";
        if wrap {
            return tv_smt_e(true, tv_smt_narrow(q, rt), zc);
        }
        var ov: str = "(not (= " + q + " " + tv_smt_narrow(q, ot) + "))";
        if bits >= 64 {
            ov = "(and (= " + a + " " + tv_smt_lit(1 << 63) + ") (= " + b + " " + tv_smt_lit(0 - 1) + "))";
        }
        return tv_smt_e(true, q, "(or " + zc + " " + ov + ")");
    }
    if binop_eq(op, BinOp::Mod) {
        if !sgn {
            return tv_smt_e(true, tv_smt_narrow("(bvurem " + a + " " + b + ")", rt), zc);
        }
        var mc: str = zc;
        if bits == 64 && !wrap {
            mc = "(or " + zc + " (and (= " + a + " " + tv_smt_lit(1 << 63) + ") (= " + b + " " + tv_smt_lit(0 - 1) + ")))";
        }
        return tv_smt_e(true, "(bvsrem " + a + " " + b + ")", mc);
    }
    return no;
}

fn tv_smt_unop(op: UnaryOp, a: str, t: IrType, wrap: bool) -> TvSmtE {
    var no: TvSmtE = tv_smt_e(false, "", "");
    if tv_is_float(t) {
        return no;
    }
    var bits: i64 = tv_bits(t);
    match op {
        UnaryOp::Neg => {
            if bits == 1 || !tv_signed(t) {
                return no;
            }
            if wrap {
                return tv_smt_e(true, tv_smt_narrow("(bvneg " + a + ")", t), "");
            }
            var e: str = "(bvneg " + tv_smt_ext(a, true) + ")";
            var lo: str = "((_ extract 63 0) " + e + ")";
            return tv_smt_e(true, lo, "(not (= " + e + " " + tv_smt_ext(tv_smt_narrow(lo, t), true) + "))");
        }
        UnaryOp::Not => {
            if bits == 1 {
                return tv_smt_e(true, "(bvxor " + a + " " + tv_smt_lit(1) + ")", "");
            }
            return tv_smt_e(true, tv_smt_narrow("(bvnot " + a + ")", t), "");
        }
        UnaryOp::BitNot => {
            return tv_smt_e(true, tv_smt_narrow("(bvnot " + a + ")", t), "");
        }
    }
    return no;
}

/// The term of value `v` of `f`: p<i> for parameter i, else prefix + id
/// when defined already; "" otherwise.
fn tv_smt_val(f: & IrFunction, pfx: str, defd: & Vec<i64>, v: i64) -> str {
    var i: i64 = 0;
    while i < f.params.len() {
        if f.params.get(i).id == v {
            return "p" + int_to_str(i);
        }
        i = i + 1;
    }
    if v >= 0 && v < defd.len() && defd.get(v) == 1 {
        return pfx + int_to_str(v);
    }
    return "";
}

fn tv_smt_fn(f: & IrFunction, pfx: str) -> TvSmt {
    var r: TvSmt = TvSmt {
        ok: false, defs: "", ret: tv_smt_lit(0), pan: "false"
    };
    if f.blocks.len() != 1 {
        return r;
    }
    var ids: Vec<i64> = f.blocks.get(0).instructions;
    if ids.len() == 0 || ids.len() > TV_SMT_MAX {
        return r;
    }
    var sh: TvShape = tv_shape_of(f);
    var nv: i64 = f.next_value + 1;
    var defd: Vec<i64> = peir_zeros(nv);
    var mem: Vec<str> = Vec::new();
    while mem.len() < nv {
        mem.push(tv_smt_lit(0));
    }
    var defs: str = "";
    var pan: str = "false";
    var ret: str = tv_smt_lit(0);
    var ended: bool = false;
    var k: i64 = 0;
    while k < ids.len() {
        var id: i64 = ids.get(k);
        if ended || id < 0 || id >= nv {
            return r;
        }
        var term: str = "";
        var cond: str = "";
        var good: bool = true;
        match peir_inst_of(f, id) {
            Inst::ConstInt(c, ct) => {
                if tv_is_float(ct) {
                    good = false;
                } else {
                    term = tv_smt_lit(tv_narrow(c, ct));
                }
            }
            Inst::ConstBool(bv) => {
                if bv {
                    term = tv_smt_lit(1);
                } else {
                    term = tv_smt_lit(0);
                }
            }
            Inst::Alloca(_, _) => {
                good = tv_get(& sh.plain, id) == 1;
            }
            Inst::Load(lp, lt) => {
                if tv_get(& sh.plain, lp) == 1 && lp < mem.len() {
                    term = tv_smt_narrow(mem.get(lp), lt);
                } else {
                    good = false;
                }
            }
            Inst::Store(sp, sv, _) => {
                var svt: str = tv_smt_val(f, pfx, & defd, sv);
                if tv_get(& sh.plain, sp) == 1 && sp < mem.len() && str_len(svt) > 0 {
                    mem.set(sp, svt);
                } else {
                    good = false;
                }
            }
            Inst::BinOp(op, l, rr, bt) => {
                var la: str = tv_smt_val(f, pfx, & defd, l);
                var lb: str = tv_smt_val(f, pfx, & defd, rr);
                if str_len(la) == 0 || str_len(lb) == 0 {
                    good = false;
                } else {
                    var be: TvSmtE = tv_smt_binop(f, op, la, lb, rr, ssa_vty(f, l), bt, f.is_wrapping);
                    good = be.ok;
                    term = be.term;
                    cond = be.cond;
                }
            }
            Inst::UnaryOp(uop, ux, ut) => {
                var ua: str = tv_smt_val(f, pfx, & defd, ux);
                if str_len(ua) == 0 {
                    good = false;
                } else {
                    var ue: TvSmtE = tv_smt_unop(uop, ua, ut, f.is_wrapping);
                    good = ue.ok;
                    term = ue.term;
                    cond = ue.cond;
                }
            }
            Inst::IntExtend(ex, ea, et) => {
                var xe: str = tv_smt_val(f, pfx, & defd, ex);
                if str_len(xe) == 0 || tv_is_float(ea) || tv_is_float(et) {
                    good = false;
                } else {
                    term = tv_smt_narrow(xe, et);
                }
            }
            Inst::IntTrunc(tx, ta, tt) => {
                var xt: str = tv_smt_val(f, pfx, & defd, tx);
                if str_len(xt) == 0 || tv_is_float(ta) || tv_is_float(tt) {
                    good = false;
                } else {
                    term = tv_smt_narrow(xt, tt);
                }
            }
            Inst::BitCast(cx, ca, cb) => {
                var xc: str = tv_smt_val(f, pfx, & defd, cx);
                if str_len(xc) == 0 || tv_is_float(ca) || tv_is_float(cb) {
                    good = false;
                } else {
                    term = xc;
                }
            }
            Inst::Return(rv) => {
                match rv {
                    OptValueId::Some(x) => {
                        var xr: str = tv_smt_val(f, pfx, & defd, x);
                        if str_len(xr) == 0 {
                            good = false;
                        } else {
                            ret = xr;
                        }
                    }
                    OptValueId::None => {
                    }
                }
                ended = true;
            }
            Inst::Panic(_) => {
                pan = "true";
                ended = true;
            }
            _ => {
                good = false;
            }
        }
        if !good {
            return r;
        }
        if str_len(term) > 0 {
            defs = defs + "(define-fun " + pfx + int_to_str(id) + " () (_ BitVec 64) " + term + ")\n";
            defd.set(id, 1);
        }
        if str_len(cond) > 0 {
            pan = "(or " + pan + " " + cond + ")";
        }
        k = k + 1;
    }
    if !ended {
        return r;
    }
    r.ok = true;
    r.defs = defs;
    r.ret = ret;
    r.pan = pan;
    return r;
}

/// With FID_VALIDATE_SMT: write the obligation that `post` (after pass
/// `pname`) means what `pre` meant, when both are straight-line code.
/// `why` is the validator's verdict and `inj` whether a fault was put in
/// (both go into the first line, which the tooling reads).
fn tv_smt_pair(pname: str, pre: & IrFunction, post: & IrFunction, inj: bool, why: str) {
    if str_len(tv_smt_dir()) == 0 {
        return;
    }
    if pre.params.len() != post.params.len() {
        return;
    }
    var verdict: str = "accepted";
    if why == "n/a" {
        verdict = "not checkable";
    } else if str_len(why) > 0 {
        verdict = "rejected";
    }
    var note: str = "tv: " + pre.name + " after pass " + pname;
    if inj {
        note = note + " (injected fault)";
    }
    var text: str = tv_smt_text(note + ", validator " + verdict, pre, post);
    if str_len(text) == 0 {
        return;
    }
    g_tv_smt_n = g_tv_smt_n + 1;
    p_file_write(tv_smt_dir() + "/tv" + int_to_str(g_tv_smt_n) + ".smt2", text);
}

/// The SMT-LIB obligation that `post` means what `pre` meant: both as
/// bit-vector terms over the same parameters and the assertion that they
/// differ (in whether they panic, or in what they return when neither
/// does), so `unsat` proves them the same. `note` is the first line's
/// comment. "" when either is not one block of integer code without calls.
pub fn tv_smt_text(note: str, pre: & IrFunction, post: & IrFunction) -> str {
    if pre.params.len() != post.params.len() {
        return "";
    }
    var a: TvSmt = tv_smt_fn(pre, "a");
    if !a.ok {
        return "";
    }
    var b: TvSmt = tv_smt_fn(post, "b");
    if !b.ok {
        return "";
    }
    var text: str = "; " + note + "; unsat proves the two the same\n(set-logic QF_BV)\n";
    var i: i64 = 0;
    while i < pre.params.len() {
        var pn: str = "p" + int_to_str(i);
        text = text + "(declare-const " + pn + " (_ BitVec 64))\n(assert (= " + pn + " " + tv_smt_narrow(pn, pre.params.get(i).ty) + "))\n";
        i = i + 1;
    }
    text = text + a.defs + b.defs + "(assert (not (and (= " + a.pan + " " + b.pan + ") (or " + a.pan + " (= " + a.ret + " " + b.ret + ")))))\n(check-sat)\n";
    return text;
}

// --- The module passes (VF6) -----------------------------------------------------
//
// tv_mod_before keeps a copy of every function before a module pass;
// tv_mod_after checks each function the pass changed against its copy, by
// the pass's witness where one is written and by runs on random inputs in
// which calls into the module are evaluated (tv_weval), the function
// before the pass in the module before it and the one after in the module
// after it. Functions the pass added (clones) are checked through their
// callers. A rejection undoes the whole pass: the module gets back its
// functions from before it.

/// The module before a module pass: a copy of every function, the hash of
/// each (ir_ser.fd mec_fn_hash), and where each name is (+ 1).
pub struct TvMod {
    pub on: bool,
    pub entries: Vec<IrFunctionEntry>,
    pub hashes: Vec<i64>,
    pub index: i64,
    pub has_main: bool,
}

/// A copy of `f` the passes cannot change, every field kept (tv_snapshot
/// keeps what a function pass edits).
fn tv_copy(f: IrFunction) -> IrFunction {
    var nf: IrFunction = f;
    var s: IrFunction = tv_snapshot(& f);
    nf.params = s.params;
    nf.blocks = s.blocks;
    nf.value_metas = s.value_metas;
    nf.insts = s.insts;
    nf.inst_at = s.inst_at;
    nf.effects = s.effects;
    nf.locals = s.locals;
    nf.persist_vars = s.persist_vars;
    nf.drop_locals = s.drop_locals;
    nf.zeroize_locals = s.zeroize_locals;
    nf.workgroup_size = f.workgroup_size.clone();
    return nf;
}

/// Before a module pass: the module as it is when validation is on (an
/// empty TvMod otherwise, which tv_mod_after does not read).
pub fn tv_mod_before(module: & IrModule) -> TvMod {
    var m: TvMod = TvMod {
        on: false, entries: Vec::new(), hashes: Vec::new(), index: 0, has_main: false
    };
    if !tv_on() {
        return m;
    }
    m.on = true;
    m.index = HashMap_new();
    var i: i64 = 0;
    while i < module.functions.len() {
        var e: IrFunctionEntry = module.functions.get(i);
        var c: IrFunction = tv_copy(e.func);
        m.hashes.push(mec_fn_hash(c));
        m.entries.push(IrFunctionEntry_new(e.name, c));
        if !HashMap_contains(m.index, e.name) {
            HashMap_insert(m.index, e.name, i + 1);
        }
        if e.name == "main" {
            m.has_main = true;
        }
        i = i + 1;
    }
    return m;
}

/// The functions of one side of a module check: names, bodies, where each
/// name is (+ 1), whether each can be run (0 not known yet, 1 yes, 2 no)
/// and its shape, function pointers (tv_fnref_val, as a string) -> position
/// + 1, and the constant globals (tv_gconst_facts).
pub struct TvWorld {
    pub names: Vec<str>,
    pub fns: Vec<IrFunction>,
    pub index: i64,
    pub st: Vec<i64>,
    pub shapes: Vec<TvShape>,
    pub fref: i64,
    pub gc: i64,
}

/// The value a ConstFnRef of `nm` has in the evaluators.
fn tv_fnref_val(nm: str) -> i64 {
    return tv_mix(tv_hash_str(nm), 3);
}

fn tv_world(names: Vec<str>, fns: Vec<IrFunction>, gc: i64) -> TvWorld {
    var w: TvWorld = TvWorld {
        names: names, fns: fns, index: HashMap_new(), st: Vec::new(), shapes: Vec::new(), fref: HashMap_new(), gc: gc
    };
    var i: i64 = 0;
    while i < w.names.len() {
        var nm: str = w.names.get(i);
        if !HashMap_contains(w.index, nm) {
            HashMap_insert(w.index, nm, i + 1);
            HashMap_insert(w.fref, int_to_str(tv_fnref_val(nm)), i + 1);
        }
        w.st.push(0);
        var blank: TvShape = TvShape {
            ok: false, plain: Vec::new(), bindex: Vec::new()
        };
        w.shapes.push(blank);
        i = i + 1;
    }
    return w;
}

fn tv_world_of(module: & IrModule, gc: i64) -> TvWorld {
    var names: Vec<str> = Vec::new();
    var fns: Vec<IrFunction> = Vec::new();
    var i: i64 = 0;
    while i < module.functions.len() {
        var e: IrFunctionEntry = module.functions.get(i);
        names.push(e.name);
        fns.push(e.func);
        i = i + 1;
    }
    return tv_world(names, fns, gc);
}

fn tv_world_pre(m: & TvMod, gc: i64) -> TvWorld {
    var names: Vec<str> = Vec::new();
    var fns: Vec<IrFunction> = Vec::new();
    var i: i64 = 0;
    while i < m.entries.len() {
        var e: IrFunctionEntry = m.entries.get(i);
        names.push(e.name);
        fns.push(e.func);
        i = i + 1;
    }
    return tv_world(names, fns, gc);
}

/// 1 when the evaluator can run the function at `at` of `w`, else 0 (its
/// shape is found once).
fn tv_w_ok(w: & mut TvWorld, at: i64) -> i64 {
    if at < 0 || at >= w.st.len() {
        return 0;
    }
    if w.st.get(at) == 0 {
        var g: IrFunction = w.fns.get(at);
        var s: TvShape = tv_shape_x(& g, w.gc, true);
        if s.ok {
            w.st.set(at, 1);
        } else {
            w.st.set(at, 2);
        }
        w.shapes.set(at, s);
    }
    if w.st.get(at) == 1 {
        return 1;
    }
    return 0;
}

/// -1 when `w` has no function `nm`, 1 when the evaluator can run it, else 0.
fn tv_w_ev(w: & mut TvWorld, nm: str) -> i64 {
    var at: i64 = HashMap_get(w.index, nm) - 1;
    if at < 0 {
        return - 1;
    }
    return tv_w_ok(w, at);
}

/// How a call of `nm` is made on side `side` (0 the module before the pass,
/// 1 after it): 1 the callee is run, 0 it is uninterpreted (a hash of its
/// name and arguments), 2 the run is not conclusive. A callee both modules
/// have is run on one side only when it is on the other too, so the two
/// runs treat the same call alike; one only the module after the pass has
/// (a clone) must be run.
fn tv_call_how(wa: & mut TvWorld, wb: & mut TvWorld, side: i64, nm: str) -> i64 {
    var ea: i64 = tv_w_ev(wa, nm);
    var eb: i64 = tv_w_ev(wb, nm);
    var mine: i64 = ea;
    var other: i64 = eb;
    if side == 1 {
        mine = eb;
        other = ea;
    }
    if mine < 0 && other < 0 {
        // neither module has it: an extern or a builtin
        return 0;
    }
    if mine < 0 {
        return 2;
    }
    if other < 0 {
        if mine == 1 {
            return 1;
        }
        return 2;
    }
    if mine == 1 && other == 1 {
        return 1;
    }
    if mine == 0 && other == 0 {
        return 0;
    }
    return 2;
}

/// The name of the function `v` points to on side `side` ("" none).
fn tv_wfn_at(wa: & TvWorld, wb: & TvWorld, side: i64, v: i64) -> str {
    if side == 0 {
        var at: i64 = HashMap_get(wa.fref, int_to_str(v)) - 1;
        if at >= 0 {
            return wa.names.get(at);
        }
        return "";
    }
    var bt: i64 = HashMap_get(wb.fref, int_to_str(v)) - 1;
    if bt >= 0 {
        return wb.names.get(bt);
    }
    return "";
}

/// The value of the constant global whose address is `p` in `f`.
fn tv_wglobal(w: & TvWorld, f: & IrFunction, p: i64) -> i64 {
    match peir_inst_of(f, p) {
        Inst::GlobalAddr(gn, _) => {
            if w.gc != 0 && HashMap_contains(w.gc, gn) {
                return HashMap_get(w.gc, gn);
            }
        }
        _ => {
        }
    }
    return 0;
}

/// What a run has done so far across the calls it followed: the trace of
/// effects, the calls with effects not followed, the steps, and the limit.
pub struct TvRun {
    pub trace: i64,
    pub ncalls: i64,
    pub steps: i64,
    pub limit: i64,
}

/// A call of `nm` with arguments `argv` (values) and result type `rt`.
fn tv_wcall(wa: & mut TvWorld, wb: & mut TvWorld, side: i64, nm: str, argv: & Vec<i64>, rt: IrType, eff: EffectSet, run: & mut TvRun, depth: i64) -> TvOut {
    var out: TvOut = TvOut {
        kind: 5, val: 0, trace: 0, steps: 0
    };
    var how: i64 = tv_call_how(wa, wb, side, nm);
    if how == 1 && depth >= TV_CALL_DEPTH {
        how = 2;
    }
    if how == 1 {
        var co: TvOut = out;
        if side == 0 {
            var at: i64 = HashMap_get(wa.index, nm) - 1;
            var cf: IrFunction = wa.fns.get(at);
            var csh: TvShape = wa.shapes.get(at);
            if cf.params.len() == argv.len() {
                co = tv_weval(wa, wb, 0, & cf, & csh, argv, run, depth + 1);
            }
        } else {
            var bt: i64 = HashMap_get(wb.index, nm) - 1;
            var bf: IrFunction = wb.fns.get(bt);
            var bsh: TvShape = wb.shapes.get(bt);
            if bf.params.len() == argv.len() {
                co = tv_weval(wa, wb, 1, & bf, & bsh, argv, run, depth + 1);
            }
        }
        if co.kind == 0 {
            co.val = tv_narrow(co.val, rt);
        }
        return co;
    }
    if how == 0 {
        var h: i64 = tv_hash_str(nm);
        var ai: i64 = 0;
        while ai < argv.len() {
            h = tv_mix(h, argv.get(ai));
            ai = ai + 1;
        }
        var es: EffectSet = eff;
        if !EffectSet_is_pure(& es) {
            run.ncalls = run.ncalls + 1;
            h = tv_mix(h, run.ncalls);
            run.trace = tv_mix(tv_mix(run.trace, 11), h);
        }
        out.kind = 0;
        out.val = tv_narrow(h, rt);
    }
    return out;
}

/// tv_eval across the module: calls are followed into the functions of the
/// side's module (tv_call_how), loads of constant globals read their value,
/// calls through a pointer to a function of the module are calls of it.
fn tv_weval(wa: & mut TvWorld, wb: & mut TvWorld, side: i64, f: & IrFunction, sh: & TvShape, args: & Vec<i64>, run: & mut TvRun, depth: i64) -> TvOut {
    var nv: i64 = f.next_value + 1;
    var vals: Vec<i64> = peir_zeros(nv);
    var mem: Vec<i64> = peir_zeros(nv);
    var pi: i64 = 0;
    while pi < f.params.len() && pi < args.len() {
        var pid: i64 = f.params.get(pi).id;
        if pid >= 0 && pid < nv {
            vals.set(pid, tv_narrow(args.get(pi), f.params.get(pi).ty));
        }
        pi = pi + 1;
    }
    var out: TvOut = TvOut {
        kind: 5, val: 0, trace: 0, steps: 0
    };
    var b: i64 = 0;
    var done: bool = false;
    while !done {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        var nxt: i64 = - 1;
        while k < ids.len() && nxt < 0 && !done {
            var id: i64 = ids.get(k);
            run.steps = run.steps + 1;
            if run.steps > run.limit {
                out.kind = 4;
                done = true;
            } else if id < 0 || id >= nv {
                out.kind = 5;
                done = true;
            } else {
                match peir_inst_of(f, id) {
                    Inst::ConstInt(c, ct) => {
                        vals.set(id, tv_narrow(c, ct));
                    }
                    Inst::ConstBool(bv) => {
                        if bv {
                            vals.set(id, 1);
                        } else {
                            vals.set(id, 0);
                        }
                    }
                    Inst::ConstNull(_) => {
                        vals.set(id, 0);
                    }
                    Inst::ConstStr(s) => {
                        vals.set(id, tv_hash_str(s));
                    }
                    Inst::ConstFnRef(s) => {
                        vals.set(id, tv_fnref_val(s));
                    }
                    Inst::GlobalAddr(gn, _) => {
                        vals.set(id, tv_hash_str(gn));
                    }
                    Inst::Alloca(_, _) => {
                        vals.set(id, id);
                    }
                    Inst::Load(p, lt) => {
                        if tv_get(& sh.plain, p) == 2 {
                            vals.set(id, tv_narrow(tv_wglobal(wa, f, p), lt));
                        } else {
                            vals.set(id, tv_narrow(tv_get(& mem, p), lt));
                        }
                    }
                    Inst::Store(p, v, _) => {
                        if p >= 0 && p < nv {
                            mem.set(p, tv_get(& vals, v));
                        }
                    }
                    Inst::BinOp(op, l, r, bt) => {
                        var res: TvK = tv_binop(op, tv_get(& vals, l), tv_get(& vals, r), ssa_vty(f, l), bt, f.is_wrapping);
                        if res.kind == 0 {
                            vals.set(id, res.v);
                        } else if res.kind == 1 {
                            out.kind = 1;
                            done = true;
                        } else {
                            out.kind = 5;
                            done = true;
                        }
                    }
                    Inst::UnaryOp(uop, x, ut) => {
                        var ru: TvK = tv_unop(uop, tv_get(& vals, x), ut, f.is_wrapping);
                        if ru.kind == 0 {
                            vals.set(id, ru.v);
                        } else if ru.kind == 1 {
                            out.kind = 1;
                            done = true;
                        } else {
                            out.kind = 5;
                            done = true;
                        }
                    }
                    Inst::IntExtend(ex, _, eto) => {
                        vals.set(id, tv_narrow(tv_get(& vals, ex), eto));
                    }
                    Inst::IntTrunc(tx, _, tto) => {
                        vals.set(id, tv_narrow(tv_get(& vals, tx), tto));
                    }
                    Inst::BitCast(cx, _, _) => {
                        vals.set(id, tv_get(& vals, cx));
                    }
                    Inst::Call(nm, cargs, rt, eff) => {
                        var argv: Vec<i64> = Vec::new();
                        var ai: i64 = 0;
                        while ai < cargs.len() {
                            argv.push(tv_get(& vals, cargs.get(ai)));
                            ai = ai + 1;
                        }
                        var co: TvOut = tv_wcall(wa, wb, side, nm, & argv, rt, eff, run, depth);
                        if co.kind == 0 {
                            vals.set(id, co.val);
                        } else {
                            out.kind = co.kind;
                            done = true;
                        }
                    }
                    Inst::CallPtr(fp, pargs, prt, peff, _) => {
                        var pargv: Vec<i64> = Vec::new();
                        var pj: i64 = 0;
                        while pj < pargs.len() {
                            pargv.push(tv_get(& vals, pargs.get(pj)));
                            pj = pj + 1;
                        }
                        var cname: str = tv_wfn_at(wa, wb, side, tv_get(& vals, fp));
                        if str_len(cname) > 0 {
                            var po: TvOut = tv_wcall(wa, wb, side, cname, & pargv, prt, peff, run, depth);
                            if po.kind == 0 {
                                vals.set(id, po.val);
                            } else {
                                out.kind = po.kind;
                                done = true;
                            }
                        } else {
                            // a pointer to no function of the module: uninterpreted
                            var ph: i64 = tv_mix(tv_get(& vals, fp), 5);
                            var pk: i64 = 0;
                            while pk < pargv.len() {
                                ph = tv_mix(ph, pargv.get(pk));
                                pk = pk + 1;
                            }
                            var pes: EffectSet = peff;
                            if !EffectSet_is_pure(& pes) {
                                run.ncalls = run.ncalls + 1;
                                ph = tv_mix(ph, run.ncalls);
                                run.trace = tv_mix(tv_mix(run.trace, 11), ph);
                            }
                            vals.set(id, tv_narrow(ph, prt));
                        }
                    }
                    Inst::Print(x, _) => {
                        run.trace = tv_mix(tv_mix(run.trace, 13), tv_get(& vals, x));
                    }
                    Inst::Jump(t) => {
                        nxt = tv_bidx(sh, t);
                        if nxt < 0 {
                            out.kind = 5;
                            done = true;
                        }
                    }
                    Inst::Branch(c, t, e) => {
                        if tv_get(& vals, c) != 0 {
                            nxt = tv_bidx(sh, t);
                        } else {
                            nxt = tv_bidx(sh, e);
                        }
                        if nxt < 0 {
                            out.kind = 5;
                            done = true;
                        }
                    }
                    Inst::Return(rv) => {
                        match rv {
                            OptValueId::Some(x) => {
                                out.val = tv_get(& vals, x);
                            }
                            OptValueId::None => {
                            }
                        }
                        out.kind = 0;
                        done = true;
                    }
                    Inst::Panic(_) => {
                        out.kind = 1;
                        done = true;
                    }
                    Inst::Unreachable => {
                        out.kind = 2;
                        done = true;
                    }
                    _ => {
                        out.kind = 5;
                        done = true;
                    }
                }
            }
            k = k + 1;
        }
        if !done {
            if nxt < 0 {
                out.kind = 3;
                done = true;
            } else {
                b = nxt;
            }
        }
    }
    out.trace = run.trace;
    out.steps = run.steps;
    return out;
}

/// RL5 across the module: `fa` (in the module before the pass) and `fb`
/// (after it) on the same inputs; a parameter `fixed` gives a constant to
/// (pairs: 1 and the value) takes that value. "" when every run that
/// finished agrees, "n/a" when none could be run, else the first
/// disagreement.
fn tv_wrandom(wa: & mut TvWorld, wb: & mut TvWorld, fa: & IrFunction, fb: & IrFunction, fixed: & Vec<i64>) -> str {
    if fa.params.len() != fb.params.len() {
        return "n/a";
    }
    var sa: TvShape = tv_shape_x(fa, wa.gc, true);
    if !sa.ok {
        return "n/a";
    }
    var sb: TvShape = tv_shape_x(fb, wb.gc, true);
    if !sb.ok {
        return "n/a";
    }
    var seed: i64 = tv_hash_str(fa.name);
    var conclusive: i64 = 0;
    var rn: i64 = 0;
    while rn < TV_RUNS {
        var args: Vec<i64> = Vec::new();
        var pi: i64 = 0;
        while pi < fa.params.len() {
            seed = tv_mix(seed, rn * 131 + pi + 1);
            var av: i64 = tv_arg(fa.params.get(pi).ty, rn, seed);
            if 2 * pi + 1 < fixed.len() && fixed.get(2 * pi) == 1 {
                av = tv_narrow(fixed.get(2 * pi + 1), fa.params.get(pi).ty);
            }
            args.push(av);
            pi = pi + 1;
        }
        var ra: TvRun = TvRun {
            trace: 7, ncalls: 0, steps: 0, limit: TV_STEPS
        };
        var oa: TvOut = tv_weval(wa, wb, 0, fa, & sa, & args, & mut ra, 0);
        if oa.kind < 4 {
            var rb: TvRun = TvRun {
                trace: 7, ncalls: 0, steps: 0, limit: ra.steps * 8 + 1000
            };
            var ob: TvOut = tv_weval(wa, wb, 1, fb, & sb, & args, & mut rb, 0);
            if ob.kind < 4 {
                conclusive = conclusive + 1;
                var same: bool = oa.kind == ob.kind && oa.trace == ob.trace;
                if same && oa.kind == 0 {
                    same = oa.val == ob.val;
                }
                if !same {
                    if oa.trace != ob.trace && oa.kind == ob.kind {
                        return "on inputs " + tv_args_str(& args) + " the calls or prints differ";
                    }
                    return "on inputs " + tv_args_str(& args) + " the function " + tv_out_str(& oa) + " before the pass and " + tv_out_str(& ob) + " after it";
                }
            }
        }
        rn = rn + 1;
    }
    if conclusive == 0 {
        return "n/a";
    }
    return "";
}

/// Called by name by the runtime or the backends, with arguments the IR
/// does not show.
fn tv_backend_name(nm: str) -> bool {
    return str_starts_with(nm, "p_") || str_starts_with(nm, "pe_") || str_starts_with(nm, "pet_") || str_starts_with(nm, "ped_") || str_starts_with(nm, "pert_") || str_starts_with(nm, "nat_") || str_starts_with(nm, "__") || str_starts_with(nm, "Vec_") || str_starts_with(nm, "HashMap_");
}

/// WP13's fact, found here again: for each function that only direct calls
/// reach (not named by a function pointer, a string, a dyn method or a C
/// callback, not main, not one the runtime or the backends call by name),
/// per parameter the constant every call passes. at: name -> slot + 1; a
/// slot holds per parameter its state (1 one constant, 2 not) and value.
pub struct TvFacts {
    pub at: i64,
    pub slots: Vec<Vec<i64>>,
}

fn tv_ipcp_facts(wa: & TvWorld, module: & IrModule) -> TvFacts {
    var fx: TvFacts = TvFacts {
        at: HashMap_new(), slots: Vec::new()
    };
    var taken: i64 = HashMap_new();
    var dtys: Vec<str> = Vec::new();
    var dseen: i64 = HashMap_new();
    var dms: Vec<str> = Vec::new();
    var mseen: i64 = HashMap_new();
    var i: i64 = 0;
    while i < wa.fns.len() {
        var g: IrFunction = wa.fns.get(i);
        var b: i64 = 0;
        while b < g.blocks.len() {
            var ids: Vec<i64> = g.blocks.get(b).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                match peir_inst_of(& g, ids.get(k)) {
                    Inst::ConstFnRef(fr) => {
                        HashMap_insert(taken, fr, 1);
                        HashMap_insert(taken, c_fn_target(fr), 1);
                    }
                    Inst::ConstStr(cs) => {
                        if HashMap_contains(wa.index, cs) {
                            HashMap_insert(taken, cs, 1);
                        }
                    }
                    Inst::MakeDyn(_, dty, _) => {
                        if !HashMap_contains(dseen, dty) {
                            HashMap_insert(dseen, dty, 1);
                            dtys.push(dty);
                        }
                    }
                    Inst::DynCall(_, dm, _, _, _) => {
                        if !HashMap_contains(mseen, dm) {
                            HashMap_insert(mseen, dm, 1);
                            dms.push(dm);
                        }
                    }
                    _ => {
                    }
                }
                k = k + 1;
            }
            b = b + 1;
        }
        i = i + 1;
    }
    var di: i64 = 0;
    while di < dtys.len() {
        var mi: i64 = 0;
        while mi < dms.len() {
            HashMap_insert(taken, dtys.get(di) + "_" + dms.get(mi), 1);
            mi = mi + 1;
        }
        di = di + 1;
    }
    var ci: i64 = 0;
    while ci < module.c_callbacks.len() {
        HashMap_insert(taken, module.c_callbacks.get(ci), 1);
        ci = ci + 1;
    }
    HashMap_insert(taken, "main", 1);
    i = 0;
    while i < wa.fns.len() {
        var g2: IrFunction = wa.fns.get(i);
        var b2: i64 = 0;
        while b2 < g2.blocks.len() {
            var ids2: Vec<i64> = g2.blocks.get(b2).instructions;
            var k2: i64 = 0;
            while k2 < ids2.len() {
                match peir_inst_of(& g2, ids2.get(k2)) {
                    Inst::Call(cn, cargs, _, _) => {
                        if !HashMap_contains(taken, cn) && HashMap_contains(wa.index, cn) && !tv_backend_name(cn) {
                            var slot: i64 = HashMap_get(fx.at, cn) - 1;
                            if slot < 0 {
                                slot = fx.slots.len();
                                HashMap_insert(fx.at, cn, slot + 1);
                                fx.slots.push(peir_zeros(2 * cargs.len()));
                            }
                            var st: Vec<i64> = fx.slots.get(slot);
                            if st.len() != 2 * cargs.len() {
                                // calls with different numbers of arguments: no fact
                                var z: i64 = 0;
                                while z < st.len() {
                                    st.set(z, 2);
                                    z = z + 2;
                                }
                            } else {
                                var a: i64 = 0;
                                while a < cargs.len() {
                                    var ka: TvK = tv_constk(& g2, cargs.get(a), 0);
                                    var s0: i64 = st.get(2 * a);
                                    if ka.kind == 0 {
                                        if s0 == 0 {
                                            st.set(2 * a, 1);
                                            st.set(2 * a + 1, ka.v);
                                        } else if s0 == 1 && st.get(2 * a + 1) != ka.v {
                                            st.set(2 * a, 2);
                                        }
                                    } else {
                                        st.set(2 * a, 2);
                                    }
                                    a = a + 1;
                                }
                            }
                            fx.slots.set(slot, st);
                        }
                    }
                    _ => {
                    }
                }
                k2 = k2 + 1;
            }
            b2 = b2 + 1;
        }
        i = i + 1;
    }
    return fx;
}

/// The facts of function `name` with `np` parameters (pairs: state, value),
/// or none.
fn tv_fixed(fx: & TvFacts, name: str, np: i64) -> Vec<i64> {
    var none: Vec<i64> = Vec::new();
    if fx.at == 0 {
        return none;
    }
    var slot: i64 = HashMap_get(fx.at, name) - 1;
    if slot < 0 {
        return none;
    }
    var st: Vec<i64> = fx.slots.get(slot);
    if st.len() != 2 * np {
        return none;
    }
    return st;
}

/// WP18's fact, found here again: the globals with an integer literal for
/// initializer whose address, in every function of `fns`, is only loaded
/// (never stored through, passed or kept): name -> that value.
fn tv_gconst_facts(fns: & Vec<IrFunction>, globals: & Vec<GlobalEntry>) -> i64 {
    var cand: i64 = HashMap_new();
    var bad: i64 = HashMap_new();
    var gi: i64 = 0;
    while gi < globals.len() {
        var ge: GlobalEntry = globals.get(gi);
        var lit: bool = false;
        var lv: i64 = 0;
        match ge.init {
            Expr::IntLit(iv) => {
                lit = true;
                lv = iv;
            }
            _ => {
            }
        }
        if HashMap_contains(cand, ge.name) || HashMap_contains(bad, ge.name) {
            // two globals of one name: no fact
            HashMap_insert(bad, ge.name, 1);
        } else if lit {
            HashMap_insert(cand, ge.name, lv);
        }
        gi = gi + 1;
    }
    var fi: i64 = 0;
    while fi < fns.len() {
        var f: IrFunction = fns.get(fi);
        var nv: i64 = f.next_value + 1;
        var gaddr: Vec<i64> = peir_zeros(nv);
        var any: bool = false;
        var b: i64 = 0;
        while b < f.blocks.len() {
            var ids: Vec<i64> = f.blocks.get(b).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                var id: i64 = ids.get(k);
                match peir_inst_of(& f, id) {
                    Inst::GlobalAddr(gn, _) => {
                        if id >= 0 && id < nv && HashMap_contains(cand, gn) {
                            gaddr.set(id, 1);
                            any = true;
                        }
                    }
                    _ => {
                    }
                }
                k = k + 1;
            }
            b = b + 1;
        }
        if any {
            var b2: i64 = 0;
            while b2 < f.blocks.len() {
                var ids2: Vec<i64> = f.blocks.get(b2).instructions;
                var k2: i64 = 0;
                while k2 < ids2.len() {
                    var inst: Inst = peir_inst_of(& f, ids2.get(k2));
                    var ops: Vec<i64> = Vec::new();
                    peir_inst_operands(inst, & mut ops);
                    var o: i64 = 0;
                    while o < ops.len() {
                        var x: i64 = ops.get(o);
                        if x >= 0 && x < nv && gaddr.get(x) == 1 {
                            var isload: bool = false;
                            match inst {
                                Inst::Load(lp, _) => {
                                    isload = lp == x;
                                }
                                _ => {
                                }
                            }
                            if !isload {
                                match peir_inst_of(& f, x) {
                                    Inst::GlobalAddr(bn, _) => {
                                        HashMap_insert(bad, bn, 1);
                                    }
                                    _ => {
                                    }
                                }
                            }
                        }
                        o = o + 1;
                    }
                    k2 = k2 + 1;
                }
                b2 = b2 + 1;
            }
        }
        fi = fi + 1;
    }
    var gc: i64 = HashMap_new();
    gi = 0;
    while gi < globals.len() {
        var gn2: str = globals.get(gi).name;
        if HashMap_contains(cand, gn2) && !HashMap_contains(bad, gn2) {
            HashMap_insert(gc, gn2, HashMap_get(cand, gn2));
        }
        gi = gi + 1;
    }
    return gc;
}

/// VF6: gconst's witness (iropt.fd iro_const_globals, WP18): only loads
/// changed, each into the value, at the load's type, of a global with a
/// literal initializer that nothing writes (`gc`, tv_gconst_facts).
fn tv_gconst_witness(pre: & IrFunction, post: & IrFunction, gc: i64) -> str {
    var sb: str = tv_same_blocks(pre, post);
    if str_len(sb) > 0 {
        return sb;
    }
    var bi: i64 = 0;
    while bi < pre.blocks.len() {
        var ids: Vec<i64> = pre.blocks.get(bi).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            var ia: Inst = peir_inst_of(pre, id);
            var ib: Inst = peir_inst_of(post, id);
            if !tv_same_inst(ia, ib) {
                var good: bool = false;
                match ia {
                    Inst::Load(p, lt) => {
                        match peir_inst_of(pre, p) {
                            Inst::GlobalAddr(gn, _) => {
                                match ib {
                                    Inst::ConstInt(c, _) => {
                                        good = gc != 0 && HashMap_contains(gc, gn) && tv_narrow(c, lt) == tv_narrow(HashMap_get(gc, gn), lt);
                                    }
                                    _ => {
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                if !good {
                    return "%" + int_to_str(id) + " changed, and it is not a load of a global nothing writes folded to its value";
                }
            }
            k = k + 1;
        }
        bi = bi + 1;
    }
    return "";
}

/// Do functions `n1` and `n2` of `w` have the same body (parameters, result
/// type, wrapping arithmetic, blocks and instructions, value for value)?
fn tv_same_body(w: & TvWorld, n1: str, n2: str) -> bool {
    var x: i64 = HashMap_get(w.index, n1) - 1;
    var y: i64 = HashMap_get(w.index, n2) - 1;
    if x < 0 || y < 0 {
        return false;
    }
    var f1: IrFunction = w.fns.get(x);
    var f2: IrFunction = w.fns.get(y);
    if f1.blocks.len() == 0 || f2.blocks.len() == 0 || f1.params.len() != f2.params.len() {
        return false;
    }
    if ir_type_to_str(f1.ret_ty) != ir_type_to_str(f2.ret_ty) || f1.is_wrapping != f2.is_wrapping {
        return false;
    }
    var i: i64 = 0;
    while i < f1.params.len() {
        if f1.params.get(i).id != f2.params.get(i).id || ir_type_to_str(f1.params.get(i).ty) != ir_type_to_str(f2.params.get(i).ty) {
            return false;
        }
        i = i + 1;
    }
    if str_len(tv_same_blocks(& f1, & f2)) > 0 {
        return false;
    }
    var bi: i64 = 0;
    while bi < f1.blocks.len() {
        var ids: Vec<i64> = f1.blocks.get(bi).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            if !tv_same_inst(peir_inst_of(& f1, ids.get(k)), peir_inst_of(& f2, ids.get(k))) {
                return false;
            }
            k = k + 1;
        }
        bi = bi + 1;
    }
    return true;
}

/// VF6: icf's witness (iropt.fd iro_fold_identical, WP19): only direct calls
/// changed, each to a function whose body (in the module before the pass,
/// `wa`) is the same as the one it called.
fn tv_icf_witness(wa: & TvWorld, pre: & IrFunction, post: & IrFunction) -> str {
    var sb: str = tv_same_blocks(pre, post);
    if str_len(sb) > 0 {
        return sb;
    }
    var bi: i64 = 0;
    while bi < pre.blocks.len() {
        var ids: Vec<i64> = pre.blocks.get(bi).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            var ia: Inst = peir_inst_of(pre, id);
            var ib: Inst = peir_inst_of(post, id);
            if !tv_same_inst(ia, ib) {
                var why: str = "changed, and it is not a call sent to a function with the same body";
                match ia {
                    Inst::Call(n1, a1, r1, _) => {
                        match ib {
                            Inst::Call(n2, a2, r2, _) => {
                                if tv_same_ids(& a1, & a2) && ir_type_eq(r1, r2) {
                                    if tv_same_body(wa, n1, n2) {
                                        why = "";
                                    } else {
                                        why = "calls " + n2 + " in place of " + n1 + ", whose body is not the same";
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                if str_len(why) > 0 {
                    return "%" + int_to_str(id) + " " + why;
                }
            }
            k = k + 1;
        }
        bi = bi + 1;
    }
    return "";
}

/// Is `b` (after the pass) a new constant, in the entry block, of the value
/// `fixed` gives parameter `a` (before the pass)?
fn tv_ipcp_arg(pre: & IrFunction, post: & IrFunction, pa: & TvPos, pb: & TvPos, fixed: & Vec<i64>, a: i64, b: i64) -> bool {
    var at: i64 = - 1;
    var pi: i64 = 0;
    while pi < pre.params.len() {
        if pre.params.get(pi).id == a {
            at = pi;
        }
        pi = pi + 1;
    }
    if at < 0 || 2 * at + 1 >= fixed.len() || fixed.get(2 * at) != 1 {
        return false;
    }
    if b < 0 || b >= pb.blk.len() || pb.blk.get(b) != 0 {
        return false;
    }
    if b < pa.blk.len() && pa.blk.get(b) >= 0 {
        return false;
    }
    var kb: TvK = tv_constk(post, b, 0);
    if kb.kind != 0 {
        return false;
    }
    var pty: IrType = pre.params.get(at).ty;
    return tv_narrow(kb.v, pty) == tv_narrow(fixed.get(2 * at + 1), pty);
}

/// VF6: ipcp's witness (iropt.fd iro_ipcp, WP13): the parameters stay; new
/// constants appear in the entry block; and an operand changed only from a
/// parameter to a new constant of the value every call passes for it
/// (`fixed`, tv_ipcp_facts).
fn tv_ipcp_witness(pre: & IrFunction, post: & IrFunction, fixed: & Vec<i64>) -> str {
    if pre.params.len() != post.params.len() {
        return "the parameters changed";
    }
    var pi: i64 = 0;
    while pi < pre.params.len() {
        if pre.params.get(pi).id != post.params.get(pi).id {
            return "the parameters changed";
        }
        pi = pi + 1;
    }
    if pre.blocks.len() != post.blocks.len() {
        return "the blocks changed";
    }
    var n: i64 = tv_nvals(pre, post);
    var pa: TvPos = tv_pos_of(pre, n);
    var pb: TvPos = tv_pos_of(post, n);
    var bi: i64 = 0;
    while bi < pre.blocks.len() {
        if pre.blocks.get(bi).id != post.blocks.get(bi).id {
            return "the blocks changed";
        }
        var bid: str = int_to_str(pre.blocks.get(bi).id);
        var ia: Vec<i64> = pre.blocks.get(bi).instructions;
        var ib: Vec<i64> = post.blocks.get(bi).instructions;
        var kept: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < ib.len() {
            var y: i64 = ib.get(k);
            if y >= 0 && y < n && pa.blk.get(y) >= 0 {
                kept.push(y);
            } else {
                if bi != 0 {
                    return "%" + int_to_str(y) + " is new, outside the entry block";
                }
                var ky: TvK = tv_constk(post, y, 0);
                if ky.kind != 0 {
                    return "%" + int_to_str(y) + " is new, and not a constant";
                }
            }
            k = k + 1;
        }
        if !tv_same_ids(& kept, & ia) {
            return "the instructions of block " + bid + " changed";
        }
        var j: i64 = 0;
        while j < ia.len() {
            var x: i64 = ia.get(j);
            var xa: Inst = peir_inst_of(pre, x);
            var xb: Inst = peir_inst_of(post, x);
            if tv_shape(xa) != tv_shape(xb) {
                return "%" + int_to_str(x) + " changed";
            }
            var oa: Vec<i64> = Vec::new();
            peir_inst_operands(xa, & mut oa);
            var ob: Vec<i64> = Vec::new();
            peir_inst_operands(xb, & mut ob);
            if oa.len() != ob.len() {
                return "%" + int_to_str(x) + " changed its operands";
            }
            var o: i64 = 0;
            while o < oa.len() {
                if oa.get(o) != ob.get(o) && !tv_ipcp_arg(pre, post, & pa, & pb, fixed, oa.get(o), ob.get(o)) {
                    return "%" + int_to_str(x) + " reads %" + int_to_str(ob.get(o)) + " in place of %" + int_to_str(oa.get(o)) + ", and not every call passes that constant";
                }
                o = o + 1;
            }
            j = j + 1;
        }
        bi = bi + 1;
    }
    return "";
}

/// Is `run` (new values of the function after the pass), followed by the
/// call's value turned into a move of `r`, a copy of callee `g` as `w` has
/// it, with its parameters read as `args`? "" yes, else why not.
fn tv_inline_copy(w: & TvWorld, g: str, caller: & IrFunction, post: & IrFunction, args: & Vec<i64>, run: & Vec<i64>, r: i64) -> str {
    var at: i64 = HashMap_get(w.index, g) - 1;
    if at < 0 {
        return "inlines " + g + ", which is not a function of the module";
    }
    var c: IrFunction = w.fns.get(at);
    if c.blocks.len() != 1 {
        return "inlines " + g + ", which has more than one block";
    }
    if c.is_wrapping != caller.is_wrapping {
        return "inlines " + g + ", whose arithmetic wraps where the caller's does not, or the other way";
    }
    if c.params.len() != args.len() {
        return "inlines " + g + " with " + int_to_str(args.len()) + " arguments for " + int_to_str(c.params.len()) + " parameters";
    }
    var body: Vec<i64> = c.blocks.get(0).instructions;
    if body.len() != run.len() + 1 {
        return "is not a copy of " + g + " (" + int_to_str(run.len()) + " instructions for its " + int_to_str(body.len() - 1) + ")";
    }
    var rv: i64 = - 1;
    match peir_inst_of(& c, body.get(body.len() - 1)) {
        Inst::Return(ov) => {
            match ov {
                OptValueId::Some(x) => {
                    rv = x;
                }
                OptValueId::None => {
                }
            }
        }
        _ => {
        }
    }
    if rv < 0 {
        return "inlines " + g + ", which does not end returning a value";
    }
    // the callee's values -> the caller's (+ 1)
    var map: Vec<i64> = peir_zeros(c.next_value + 1);
    var p: i64 = 0;
    while p < c.params.len() {
        var pid: i64 = c.params.get(p).id;
        if pid >= 0 && pid < map.len() {
            map.set(pid, args.get(p) + 1);
        }
        p = p + 1;
    }
    var q: i64 = 0;
    while q < run.len() {
        var cid: i64 = body.get(q);
        var ci: Inst = peir_inst_of(& c, cid);
        var ni: Inst = peir_inst_of(post, run.get(q));
        if tv_shape(ci) != tv_shape(ni) {
            return "is not a copy of " + g + " (its instruction " + int_to_str(q) + " differs)";
        }
        var oc: Vec<i64> = Vec::new();
        peir_inst_operands(ci, & mut oc);
        var on: Vec<i64> = Vec::new();
        peir_inst_operands(ni, & mut on);
        if oc.len() != on.len() {
            return "is not a copy of " + g + " (its instruction " + int_to_str(q) + " differs)";
        }
        var o: i64 = 0;
        while o < oc.len() {
            if tv_get(& map, oc.get(o)) - 1 != on.get(o) {
                return "is not a copy of " + g + " (an operand of its instruction " + int_to_str(q) + " differs)";
            }
            o = o + 1;
        }
        if cid >= 0 && cid < map.len() {
            map.set(cid, run.get(q) + 1);
        }
        q = q + 1;
    }
    if tv_get(& map, rv) - 1 != r {
        return "does not give the value " + g + " returns";
    }
    return "";
}

/// Is `y` (a call in `pre`, `ia`) after the pass (`ib`) a move of the value
/// its callee's copy, `run`, computes? The callee is taken as the module
/// after the pass has it, or before (the inliner reads callees as it
/// changes them).
fn tv_inline_site(wa: & TvWorld, wb: & TvWorld, pre: & IrFunction, post: & IrFunction, ia: Inst, ib: Inst, run: & Vec<i64>) -> str {
    match ia {
        Inst::Call(g, args, _, _) => {
            match ib {
                Inst::BitCast(r, _, _) => {
                    var w1: str = tv_inline_copy(wb, g, pre, post, & args, run, r);
                    if str_len(w1) == 0 {
                        return "";
                    }
                    return tv_inline_copy(wa, g, pre, post, & args, run, r);
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return "changed, and it is not an inlined call";
}

/// VF6: the inliner's witness (iropt.fd iro_inline): the blocks stay; in
/// each, the instructions of the function before the pass stay in order,
/// and where new instructions come in, they are, with the call after them
/// turned into a move of their result, a copy of the callee's one block
/// with its parameters read as the call's arguments (tv_inline_copy).
fn tv_inline_witness(wa: & TvWorld, wb: & TvWorld, pre: & IrFunction, post: & IrFunction) -> str {
    if pre.blocks.len() != post.blocks.len() {
        return "the blocks changed";
    }
    var n: i64 = tv_nvals(pre, post);
    var pa: TvPos = tv_pos_of(pre, n);
    var bi: i64 = 0;
    while bi < pre.blocks.len() {
        if pre.blocks.get(bi).id != post.blocks.get(bi).id {
            return "the blocks changed";
        }
        var bid: str = int_to_str(pre.blocks.get(bi).id);
        var ia: Vec<i64> = pre.blocks.get(bi).instructions;
        var ib: Vec<i64> = post.blocks.get(bi).instructions;
        var ka: i64 = 0;
        var run: Vec<i64> = Vec::new();
        var kb: i64 = 0;
        while kb < ib.len() {
            var y: i64 = ib.get(kb);
            if y < 0 || y >= n || pa.blk.get(y) < 0 {
                run.push(y);
            } else {
                if ka >= ia.len() || ia.get(ka) != y {
                    return "the instructions of block " + bid + " changed";
                }
                var xa: Inst = peir_inst_of(pre, y);
                var xb: Inst = peir_inst_of(post, y);
                if run.len() > 0 || !tv_same_inst(xa, xb) {
                    var why: str = tv_inline_site(wa, wb, pre, post, xa, xb, & run);
                    if str_len(why) > 0 {
                        return "%" + int_to_str(y) + " " + why;
                    }
                }
                run = Vec::new();
                ka = ka + 1;
            }
            kb = kb + 1;
        }
        if run.len() > 0 {
            return "new instructions end block " + bid;
        }
        if ka != ia.len() {
            return "an instruction of block " + bid + " was removed";
        }
        bi = bi + 1;
    }
    return "";
}

// --- Specialization's witness (VF6) ---------------------------------------------

/// Is `g` (a function only the module after spec has) `f` with parameter
/// `j` replaced by a new constant of value `v` at the head of the entry
/// block (iropt.fd iro_specialize: iro_clone_function, then
/// iro_emit_param_const)? Every other instruction is the same, on the same
/// operands, with the parameter's uses moved to the constant.
fn tv_spec_clone_at(f: & IrFunction, g: & IrFunction, j: i64, v: i64) -> bool {
    var pty: IrType = f.params.get(j).ty;
    var pj: i64 = f.params.get(j).id;
    var g0: Vec<i64> = g.blocks.get(0).instructions;
    var f0: Vec<i64> = f.blocks.get(0).instructions;
    if g0.len() != f0.len() + 1 {
        return false;
    }
    var nid: i64 = g0.get(0);
    var n: i64 = tv_nvals(f, g);
    if nid < 0 || nid >= n {
        return false;
    }
    var pf: TvPos = tv_pos_of(f, n);
    if pf.blk.get(nid) != - 1 {
        return false;
    }
    var pi: i64 = 0;
    while pi < f.params.len() {
        if f.params.get(pi).id == nid {
            return false;
        }
        pi = pi + 1;
    }
    match peir_inst_of(g, nid) {
        Inst::ConstInt(_, _) => {
        }
        Inst::ConstBool(_) => {
        }
        _ => {
            return false;
        }
    }
    var kn: TvK = tv_constk(g, nid, 0);
    if kn.kind != 0 || tv_narrow(kn.v, pty) != tv_narrow(v, pty) {
        return false;
    }
    var bi: i64 = 0;
    while bi < f.blocks.len() {
        var fa: Vec<i64> = f.blocks.get(bi).instructions;
        var gb: Vec<i64> = g.blocks.get(bi).instructions;
        var off: i64 = 0;
        if bi == 0 {
            off = 1;
        }
        if f.blocks.get(bi).id != g.blocks.get(bi).id || gb.len() != fa.len() + off {
            return false;
        }
        var k: i64 = 0;
        while k < fa.len() {
            var x: i64 = fa.get(k);
            if gb.get(k + off) != x {
                return false;
            }
            var xa: Inst = peir_inst_of(f, x);
            var xb: Inst = peir_inst_of(g, x);
            if tv_shape(xa) != tv_shape(xb) {
                return false;
            }
            var oa: Vec<i64> = Vec::new();
            peir_inst_operands(xa, & mut oa);
            var ob: Vec<i64> = Vec::new();
            peir_inst_operands(xb, & mut ob);
            if oa.len() != ob.len() {
                return false;
            }
            var o: i64 = 0;
            while o < oa.len() {
                var want: i64 = oa.get(o);
                if want == pj {
                    want = nid;
                }
                if ob.get(o) != want {
                    return false;
                }
                o = o + 1;
            }
            k = k + 1;
        }
        bi = bi + 1;
    }
    return true;
}

/// Is `g` a clone of `f` for a constant the call (in `caller`, arguments
/// `args`) passes: the same signature, and tv_spec_clone_at for one of the
/// parameters whose argument is a constant?
fn tv_spec_clone(f: & IrFunction, g: & IrFunction, caller: & IrFunction, args: & Vec<i64>) -> bool {
    if f.params.len() != g.params.len() || args.len() != f.params.len() || f.params.len() == 0 {
        return false;
    }
    if f.blocks.len() == 0 || f.blocks.len() != g.blocks.len() {
        return false;
    }
    if ir_type_to_str(f.ret_ty) != ir_type_to_str(g.ret_ty) || f.is_wrapping != g.is_wrapping {
        return false;
    }
    var i: i64 = 0;
    while i < f.params.len() {
        if f.params.get(i).id != g.params.get(i).id || ir_type_to_str(f.params.get(i).ty) != ir_type_to_str(g.params.get(i).ty) {
            return false;
        }
        i = i + 1;
    }
    var j: i64 = 0;
    while j < args.len() {
        var kc: TvK = tv_constk(caller, args.get(j), 0);
        if kc.kind == 0 && tv_spec_clone_at(f, g, j, kc.v) {
            return true;
        }
        j = j + 1;
    }
    return false;
}

/// VF6: spec's witness (iropt.fd iro_specialize, WP14): only direct calls
/// changed, each to a function the module before the pass did not have
/// that is a clone of the callee for a constant the call passes
/// (tv_spec_clone).
fn tv_spec_witness(wa: & TvWorld, wb: & TvWorld, pre: & IrFunction, post: & IrFunction) -> str {
    var sb: str = tv_same_blocks(pre, post);
    if str_len(sb) > 0 {
        return sb;
    }
    var bi: i64 = 0;
    while bi < pre.blocks.len() {
        var ids: Vec<i64> = pre.blocks.get(bi).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            var ia: Inst = peir_inst_of(pre, id);
            var ib: Inst = peir_inst_of(post, id);
            if !tv_same_inst(ia, ib) {
                var good: bool = false;
                match ia {
                    Inst::Call(n1, a1, r1, _) => {
                        match ib {
                            Inst::Call(n2, a2, r2, _) => {
                                var x: i64 = HashMap_get(wa.index, n1) - 1;
                                var y: i64 = HashMap_get(wb.index, n2) - 1;
                                var fresh: bool = HashMap_get(wa.index, n2) == 0;
                                if tv_same_ids(& a1, & a2) && ir_type_eq(r1, r2) && x >= 0 && y >= 0 && fresh {
                                    var cf: IrFunction = wa.fns.get(x);
                                    var cg: IrFunction = wb.fns.get(y);
                                    good = tv_spec_clone(& cf, & cg, pre, & a1);
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                if !good {
                    return "%" + int_to_str(id) + " changed, and it is not a call sent to a clone of its callee for a constant it passes";
                }
            }
            k = k + 1;
        }
        bi = bi + 1;
    }
    return "";
}

/// Does `fb` (after module pass `pname`) mean what `fa` meant? The pass's
/// witness first; where it has none, or it does not hold, the runs across
/// the module decide (a witness that does not hold is the verdict when no
/// run can be made). "" yes, "n/a" nothing applies, else why not.
fn tv_mod_check(pname: str, wa: & mut TvWorld, wb: & mut TvWorld, fa: & IrFunction, fb: & IrFunction, fixed: & Vec<i64>) -> str {
    var w: str = "n/a";
    // inlineclo (iropt_me ime_inline_closures) is inline2's rule for closures
    if pname == "inline" || pname == "inline2" || pname == "inlineclo" {
        w = tv_inline_witness(wa, wb, fa, fb);
        // 2g.90: the witness is iro_inline's (a call becomes a copy of its
        // callee's one block, the blocks stay). inline2 also copies callees
        // of several blocks, splitting the caller's block and adding the
        // copy's blocks (iropt_me.fd ime_inline_with): a result whose
        // blocks changed is outside the witness, not a fault of it, and
        // the runs across the module decide (Str_drop was rejected so)
        if pname != "inline" && !tv_blocks_kept(fa, fb) {
            w = "n/a";
        }
    } else if pname == "spec" {
        w = tv_spec_witness(wa, wb, fa, fb);
    } else if pname == "gconst" {
        w = tv_gconst_witness(fa, fb, wa.gc);
    } else if pname == "icf" {
        w = tv_icf_witness(wa, fa, fb);
    } else if pname == "ipcp" {
        w = tv_ipcp_witness(fa, fb, fixed);
    }
    if str_len(w) == 0 {
        return "";
    }
    var r: str = tv_wrandom(wa, wb, fa, fb, fixed);
    if w == "n/a" || str_len(r) == 0 {
        return r;
    }
    if r != "n/a" {
        return r;
    }
    return w;
}

/// Has `post` the blocks of `pre`, by id and in order?
fn tv_blocks_kept(pre: & IrFunction, post: & IrFunction) -> bool {
    if pre.blocks.len() != post.blocks.len() {
        return false;
    }
    var bi: i64 = 0;
    while bi < pre.blocks.len() {
        if pre.blocks.get(bi).id != post.blocks.get(bi).id {
            return false;
        }
        bi = bi + 1;
    }
    return true;
}

/// After module pass `pname` changed `module` (from `pre`, a tv_mod_before):
/// true when every function it changed is accepted; false when one was
/// rejected, and the module has its functions from before the pass again.
pub fn tv_mod_after(pname: str, pre: & TvMod, module: & mut IrModule) -> bool {
    if !pre.on {
        return true;
    }
    // what the pass changed (what it added is checked through its callers)
    var todo: Vec<i64> = Vec::new();
    var froms: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < module.functions.len() {
        var e: IrFunctionEntry = module.functions.get(i);
        var at: i64 = HashMap_get(pre.index, e.name) - 1;
        if at >= 0 && mec_fn_hash(e.func) != pre.hashes.get(at) {
            todo.push(i);
            froms.push(at);
        }
        i = i + 1;
    }
    if todo.len() == 0 {
        return true;
    }
    // FID_TV_INJECT: a fault in the first changed function it may go into
    var inj: bool = false;
    var injname: str = "";
    var t: i64 = 0;
    while t < todo.len() && !inj {
        var ie: IrFunctionEntry = module.functions.get(todo.get(t));
        if tv_inject_on(pname, ie.name) {
            var ifn: IrFunction = ie.func;
            if tv_inject_fn(& mut ifn) {
                ie.func = ifn;
                module.functions.set(todo.get(t), ie);
                inj = true;
                injname = ie.name;
                g_tv_injected = g_tv_injected + 1;
            }
        }
        t = t + 1;
    }
    var afns: Vec<IrFunction> = Vec::new();
    i = 0;
    while i < pre.entries.len() {
        afns.push(pre.entries.get(i).func);
        i = i + 1;
    }
    var gc: i64 = tv_gconst_facts(& afns, & module.globals);
    var wa: TvWorld = tv_world_pre(pre, gc);
    var wb: TvWorld = tv_world_of(module, gc);
    var fx: TvFacts = TvFacts {
        at: 0, slots: Vec::new()
    };
    if pre.has_main {
        fx = tv_ipcp_facts(& wa, module);
    }
    t = 0;
    while t < todo.len() {
        var fb: IrFunction = module.functions.get(todo.get(t)).func;
        var fa: IrFunction = pre.entries.get(froms.get(t)).func;
        var fname: str = pre.entries.get(froms.get(t)).name;
        var fixed: Vec<i64> = tv_fixed(& fx, fname, fa.params.len());
        var why: str = tv_mod_check(pname, & mut wa, & mut wb, & fa, & fb, & fixed);
        if why == "n/a" {
            g_tv_unchecked = g_tv_unchecked + 1;
            tv_note_na(pname);
        } else {
            g_tv_checked = g_tv_checked + 1;
            if str_len(why) > 0 {
                g_tv_rejected = g_tv_rejected + 1;
                p_eprint_str("tv: " + fname + ": pass " + pname + " rejected: " + why + "; the module keeps its IR from before the pass\n");
                if inj {
                    g_tv_caught = g_tv_caught + 1;
                    p_eprint_str("tv: injected a fault into " + injname + " after pass " + pname + ": caught\n");
                }
                module.functions = pre.entries;
                HashMap_clear(module.fn_index);
                return false;
            }
        }
        t = t + 1;
    }
    if inj {
        p_eprint_str("tv: injected a fault into " + injname + " after pass " + pname + ": NOT caught\n");
    }
    return true;
}

// --- Self-test (FID_TV_SELFTEST=1) -------------------------------------------------
//
// Pairs (before, after) built by hand, one per rule a check must accept and
// one per mistake it must reject: VF6's negative tests that need no pass to
// go wrong. tv_report runs it; tests/tooling/tv-check.sh reads the line
// "tv selftest: N cases, M as expected".

var g_tv_selftest_done: bool = false;

fn tv_selftest_wanted() -> bool {
    if g_tv_selftest_done {
        return false;
    }
    var ev: str = p_getenv("FID_TV_SELFTEST");
    if (ev as i64) != 0 && str_len(ev) > 0 && ev != "0" {
        g_tv_selftest_done = true;
        return true;
    }
    return false;
}

fn tvs_fn(name: str, np: i64) -> IrFunction {
    var f: IrFunction = IrFunction_new(name, IrType::I64);
    var i: i64 = 0;
    while i < np {
        var id: i64 = IrFunction_new_value(& mut f, ValueMeta_new(IrType::I64));
        f.params.push(ValueIdType_new(id, IrType::I64));
        i = i + 1;
    }
    return f;
}

fn tvs_ci(f: & mut IrFunction, v: i64) -> i64 {
    return IrFunction_emit(f, Inst::ConstInt(v, IrType::I64));
}

fn tvs_op(f: & mut IrFunction, op: BinOp, a: i64, b: i64) -> i64 {
    return IrFunction_emit(f, Inst::BinOp(op, a, b, IrType::I64));
}

fn tvs_ret(f: & mut IrFunction, v: i64) {
    var _r: i64 = IrFunction_emit(f, Inst::Return(OptValueId::Some(v)));
}

/// Take `id` out of the block holding it.
fn tvs_drop(f: & mut IrFunction, id: i64) {
    var b: i64 = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var keep: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < blk.instructions.len() {
            if blk.instructions.get(k) != id {
                keep.push(blk.instructions.get(k));
            }
            k = k + 1;
        }
        blk.instructions = keep;
        f.blocks.set(b, blk);
        b = b + 1;
    }
}

/// Put `id` into block index `b`, before instruction `before`.
fn tvs_put(f: & mut IrFunction, id: i64, b: i64, before: i64) {
    tvs_drop(f, id);
    var blk: BasicBlock = f.blocks.get(b);
    var out: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < blk.instructions.len() {
        var y: i64 = blk.instructions.get(k);
        if y == before {
            out.push(id);
        }
        out.push(y);
        k = k + 1;
    }
    blk.instructions = out;
    f.blocks.set(b, blk);
}

/// A new instruction in block index `b`, before `before`.
fn tvs_new(f: & mut IrFunction, inst: Inst, b: i64, before: i64) -> i64 {
    f.current_block_idx = b;
    var id: i64 = IrFunction_emit(f, inst);
    tvs_put(f, id, b, before);
    return id;
}

/// 1, after noting in `bad` when verdict `why` is not what case `name`
/// expects (accepted: ""; rejected: a reason).
fn tvs_expect(name: str, why: str, accept: bool, bad: & mut Vec<str>) -> i64 {
    var tr: str = p_getenv("FID_TV_SELFTEST_TRACE");
    if (tr as i64) != 0 && str_len(tr) > 0 {
        p_eprint_str("tv selftest: ran " + name + ": " + why + "\n");
    }
    var ok: bool = false;
    if accept {
        ok = str_len(why) == 0;
    } else {
        ok = str_len(why) > 0 && why != "n/a";
    }
    if !ok {
        var want: str = "rejected";
        if accept {
            want = "accepted";
        }
        var got: str = why;
        if str_len(got) == 0 {
            got = "accepted";
        }
        bad.push(name + ": want " + want + ", got " + got);
    }
    return 1;
}

/// fold: x + 2 * 3, the product folded to `c`.
fn tvs_fold(c: i64) -> str {
    var f: IrFunction = tvs_fn("tvs_fold", 1);
    var x: i64 = f.params.get(0).id;
    var two: i64 = tvs_ci(& mut f, 2);
    var three: i64 = tvs_ci(& mut f, 3);
    var m: i64 = tvs_op(& mut f, BinOp::Mul, two, three);
    var s: i64 = tvs_op(& mut f, BinOp::Add, x, m);
    tvs_ret(& mut f, s);
    var g: IrFunction = tv_snapshot(& f);
    IrFunction_set_inst(& mut g, m, Inst::ConstInt(c, IrType::I64));
    return tv_check("fold", & f, & g);
}

/// fold of i64::MAX + 1 (which panics) into a constant.
fn tvs_fold_panic() -> str {
    var f: IrFunction = tvs_fn("tvs_foldp", 1);
    var x: i64 = f.params.get(0).id;
    var big: i64 = tvs_ci(& mut f, 9223372036854775807);
    var one: i64 = tvs_ci(& mut f, 1);
    var o: i64 = tvs_op(& mut f, BinOp::Add, big, one);
    tvs_ret(& mut f, x);
    var g: IrFunction = tv_snapshot(& f);
    IrFunction_set_inst(& mut g, o, Inst::ConstInt(0 - 9223372036854775807 - 1, IrType::I64));
    return tv_check("fold", & f, & g);
}

/// dce of an unused `x op y`.
fn tvs_dce(op: BinOp) -> str {
    var f: IrFunction = tvs_fn("tvs_dce", 2);
    var x: i64 = f.params.get(0).id;
    var y: i64 = f.params.get(1).id;
    var d: i64 = tvs_op(& mut f, op, x, y);
    tvs_ret(& mut f, x);
    var g: IrFunction = tv_snapshot(& f);
    tvs_drop(& mut g, d);
    return tv_check("dce", & f, & g);
}

/// gvn: (x + y) ^ (x + y) with the second addition replaced by the first.
fn tvs_gvn_ok() -> str {
    var f: IrFunction = tvs_fn("tvs_gvn", 2);
    var x: i64 = f.params.get(0).id;
    var y: i64 = f.params.get(1).id;
    var a: i64 = tvs_op(& mut f, BinOp::Add, x, y);
    var a2: i64 = tvs_op(& mut f, BinOp::Add, x, y);
    var r: i64 = tvs_op(& mut f, BinOp::BitXor, a, a2);
    tvs_ret(& mut f, r);
    var g: IrFunction = tv_snapshot(& f);
    IrFunction_set_inst(& mut g, r, Inst::BinOp(BinOp::BitXor, a, a, IrType::I64));
    tvs_drop(& mut g, a2);
    return tv_check("gvn", & f, & g);
}

/// gvn of a load across a store to the same local: s = x; l1 = s; s = y;
/// l2 = s; return l1 ^ l2, with l2 replaced by l1.
fn tvs_gvn_store() -> str {
    var f: IrFunction = tvs_fn("tvs_gvns", 2);
    var x: i64 = f.params.get(0).id;
    var y: i64 = f.params.get(1).id;
    var s: i64 = IrFunction_emit(& mut f, Inst::Alloca(IrType::I64, Region::Stack));
    var _s1: i64 = IrFunction_emit(& mut f, Inst::Store(s, x, OptIrType::None));
    var l1: i64 = IrFunction_emit(& mut f, Inst::Load(s, IrType::I64));
    var _s2: i64 = IrFunction_emit(& mut f, Inst::Store(s, y, OptIrType::None));
    var l2: i64 = IrFunction_emit(& mut f, Inst::Load(s, IrType::I64));
    var r: i64 = tvs_op(& mut f, BinOp::BitXor, l1, l2);
    tvs_ret(& mut f, r);
    var g: IrFunction = tv_snapshot(& f);
    IrFunction_set_inst(& mut g, r, Inst::BinOp(BinOp::BitXor, l1, l1, IrType::I64));
    tvs_drop(& mut g, l2);
    return tv_check("gvn", & f, & g);
}

/// LICM on `i = 0; acc = 0; while i < n { acc = q; i = i + 1 }; return acc`:
/// what 0 moves q = n & 7 from the loop body to the block before the loop
/// (right); 1 moves q = 100 / n there (wrong: with n <= 0 the body never
/// runs, and n = 0 divides by zero); 2 moves the header's load of i there
/// (wrong: the loop stores i).
fn tvs_licm(what: i64) -> str {
    var f: IrFunction = tvs_fn("tvs_licm", 1);
    var n: i64 = f.params.get(0).id;
    var iv: i64 = IrFunction_emit(& mut f, Inst::Alloca(IrType::I64, Region::Stack));
    var acc: i64 = IrFunction_emit(& mut f, Inst::Alloca(IrType::I64, Region::Stack));
    var zero: i64 = tvs_ci(& mut f, 0);
    var one: i64 = tvs_ci(& mut f, 1);
    var c7: i64 = tvs_ci(& mut f, 7);
    var c100: i64 = tvs_ci(& mut f, 100);
    var _s0: i64 = IrFunction_emit(& mut f, Inst::Store(iv, zero, OptIrType::None));
    var _s1: i64 = IrFunction_emit(& mut f, Inst::Store(acc, zero, OptIrType::None));
    var h: i64 = IrFunction_new_block(& mut f);
    var body: i64 = IrFunction_new_block(& mut f);
    var exb: i64 = IrFunction_new_block(& mut f);
    f.current_block_idx = 0;
    var j0: i64 = IrFunction_emit(& mut f, Inst::Jump(h));
    f.current_block_idx = h;
    var li: i64 = IrFunction_emit(& mut f, Inst::Load(iv, IrType::I64));
    var c: i64 = IrFunction_emit(& mut f, Inst::BinOp(BinOp::Lt, li, n, IrType::Bool));
    var _br: i64 = IrFunction_emit(& mut f, Inst::Branch(c, body, exb));
    f.current_block_idx = body;
    var q: i64 = 0;
    if what == 1 {
        q = tvs_op(& mut f, BinOp::Div, c100, n);
    } else {
        q = tvs_op(& mut f, BinOp::BitAnd, n, c7);
    }
    var _s2: i64 = IrFunction_emit(& mut f, Inst::Store(acc, q, OptIrType::None));
    var li2: i64 = IrFunction_emit(& mut f, Inst::Load(iv, IrType::I64));
    var nx: i64 = tvs_op(& mut f, BinOp::Add, li2, one);
    var _s3: i64 = IrFunction_emit(& mut f, Inst::Store(iv, nx, OptIrType::None));
    var _jb: i64 = IrFunction_emit(& mut f, Inst::Jump(h));
    f.current_block_idx = exb;
    var la: i64 = IrFunction_emit(& mut f, Inst::Load(acc, IrType::I64));
    tvs_ret(& mut f, la);
    var g: IrFunction = tv_snapshot(& f);
    if what == 2 {
        tvs_put(& mut g, li, 0, j0);
    } else {
        tvs_put(& mut g, q, 0, j0);
    }
    return tv_check("licm", & f, & g);
}

/// inline: tvs_g(a) = a + 1 inlined into tvs_h(x) = tvs_g(x) * 3; `wrong`:
/// the copy subtracts.
fn tvs_inline(wrong: bool) -> str {
    var g: IrFunction = tvs_fn("tvs_g", 1);
    var ga: i64 = g.params.get(0).id;
    var gone: i64 = tvs_ci(& mut g, 1);
    var gs: i64 = tvs_op(& mut g, BinOp::Add, ga, gone);
    tvs_ret(& mut g, gs);
    var h: IrFunction = tvs_fn("tvs_h", 1);
    var x: i64 = h.params.get(0).id;
    var args: Vec<i64> = Vec::new();
    args.push(x);
    var cl: i64 = IrFunction_emit(& mut h, Inst::Call("tvs_g", args, IrType::I64, EffectSet_new()));
    var three: i64 = tvs_ci(& mut h, 3);
    var m: i64 = tvs_op(& mut h, BinOp::Mul, cl, three);
    tvs_ret(& mut h, m);
    var h2: IrFunction = tv_snapshot(& h);
    var one2: i64 = tvs_new(& mut h2, Inst::ConstInt(1, IrType::I64), 0, cl);
    var op: BinOp = BinOp::Add;
    if wrong {
        op = BinOp::Sub;
    }
    var s2: i64 = tvs_new(& mut h2, Inst::BinOp(op, x, one2, IrType::I64), 0, cl);
    IrFunction_set_inst(& mut h2, cl, Inst::BitCast(s2, IrType::I64, IrType::I64));
    var an: Vec<str> = Vec::new();
    an.push("tvs_g");
    an.push("tvs_h");
    var af: Vec<IrFunction> = Vec::new();
    af.push(g);
    af.push(h);
    var bn: Vec<str> = Vec::new();
    bn.push("tvs_g");
    bn.push("tvs_h");
    var bf: Vec<IrFunction> = Vec::new();
    bf.push(g);
    bf.push(h2);
    var wa: TvWorld = tv_world(an, af, 0);
    var wb: TvWorld = tv_world(bn, bf, 0);
    var none: Vec<i64> = Vec::new();
    return tv_mod_check("inline", & mut wa, & mut wb, & h, & h2, & none);
}

/// gconst: a load of tvs_G (initializer 5) folded to 5; `stored`: another
/// function stores 9 into it.
fn tvs_gconst(stored: bool) -> str {
    var u: IrFunction = tvs_fn("tvs_u", 0);
    var ga: i64 = IrFunction_emit(& mut u, Inst::GlobalAddr("tvs_G", IrType::I64));
    var l: i64 = IrFunction_emit(& mut u, Inst::Load(ga, IrType::I64));
    tvs_ret(& mut u, l);
    var u2: IrFunction = tv_snapshot(& u);
    IrFunction_set_inst(& mut u2, l, Inst::ConstInt(5, IrType::I64));
    var fns: Vec<IrFunction> = Vec::new();
    fns.push(u);
    if stored {
        var s: IrFunction = tvs_fn("tvs_s", 0);
        var sa: i64 = IrFunction_emit(& mut s, Inst::GlobalAddr("tvs_G", IrType::I64));
        var nine: i64 = tvs_ci(& mut s, 9);
        var _st: i64 = IrFunction_emit(& mut s, Inst::Store(sa, nine, OptIrType::None));
        tvs_ret(& mut s, nine);
        fns.push(s);
    }
    var globals: Vec<GlobalEntry> = Vec::new();
    globals.push(GlobalEntry_new("tvs_G", IrType::I64, Expr::IntLit(5)));
    var gc: i64 = tv_gconst_facts(& fns, & globals);
    return tv_gconst_witness(& u, & u2, gc);
}

fn tvs_addc(name: str, c: i64) -> IrFunction {
    var f: IrFunction = tvs_fn(name, 1);
    var a: i64 = f.params.get(0).id;
    var k: i64 = tvs_ci(& mut f, c);
    var r: i64 = tvs_op(& mut f, BinOp::Add, a, k);
    tvs_ret(& mut f, r);
    return f;
}

/// icf: a call of tvs_k1 (a + 1) sent to tvs_k2, whose body is a + 1
/// (`same`) or a + 2.
fn tvs_icf(same: bool) -> str {
    var k1: IrFunction = tvs_addc("tvs_k1", 1);
    var k2: IrFunction = tvs_addc("tvs_k2", 1);
    if !same {
        k2 = tvs_addc("tvs_k2", 2);
    }
    var c: IrFunction = tvs_fn("tvs_c", 1);
    var x: i64 = c.params.get(0).id;
    var args: Vec<i64> = Vec::new();
    args.push(x);
    var cl: i64 = IrFunction_emit(& mut c, Inst::Call("tvs_k1", args, IrType::I64, EffectSet_new()));
    tvs_ret(& mut c, cl);
    var c2: IrFunction = tv_snapshot(& c);
    var args2: Vec<i64> = Vec::new();
    args2.push(x);
    IrFunction_set_inst(& mut c2, cl, Inst::Call("tvs_k2", args2, IrType::I64, EffectSet_new()));
    var an: Vec<str> = Vec::new();
    an.push("tvs_k1");
    an.push("tvs_k2");
    an.push("tvs_c");
    var af: Vec<IrFunction> = Vec::new();
    af.push(k1);
    af.push(k2);
    af.push(c);
    var wa: TvWorld = tv_world(an, af, 0);
    return tv_icf_witness(& wa, & c, & c2);
}

/// A function calling tvs_q(a, b) with two constants.
fn tvs_caller(name: str, a: i64, b: i64) -> IrFunction {
    var f: IrFunction = tvs_fn(name, 0);
    var ca: i64 = tvs_ci(& mut f, a);
    var cb: i64 = tvs_ci(& mut f, b);
    var args: Vec<i64> = Vec::new();
    args.push(ca);
    args.push(cb);
    var cl: i64 = IrFunction_emit(& mut f, Inst::Call("tvs_q", args, IrType::I64, EffectSet_new()));
    tvs_ret(& mut f, cl);
    return f;
}

/// ipcp: tvs_q(a, b) = a + b with b replaced by 5; its callers pass (1, 5)
/// and (2, 5), or (`agree` false) (2, 6).
fn tvs_ipcp(agree: bool) -> str {
    var q: IrFunction = tvs_fn("tvs_q", 2);
    var a: i64 = q.params.get(0).id;
    var b: i64 = q.params.get(1).id;
    var s: i64 = tvs_op(& mut q, BinOp::Add, a, b);
    tvs_ret(& mut q, s);
    var q2: IrFunction = tv_snapshot(& q);
    var k: i64 = tvs_new(& mut q2, Inst::ConstInt(5, IrType::I64), 0, s);
    IrFunction_set_inst(& mut q2, s, Inst::BinOp(BinOp::Add, a, k, IrType::I64));
    var m1: IrFunction = tvs_caller("tvs_m1", 1, 5);
    var m2: IrFunction = tvs_caller("tvs_m2", 2, 5);
    if !agree {
        m2 = tvs_caller("tvs_m2", 2, 6);
    }
    var an: Vec<str> = Vec::new();
    an.push("tvs_q");
    an.push("tvs_m1");
    an.push("tvs_m2");
    var af: Vec<IrFunction> = Vec::new();
    af.push(q);
    af.push(m1);
    af.push(m2);
    var bn: Vec<str> = Vec::new();
    bn.push("tvs_q");
    bn.push("tvs_m1");
    bn.push("tvs_m2");
    var bf: Vec<IrFunction> = Vec::new();
    bf.push(q2);
    bf.push(m1);
    bf.push(m2);
    var wa: TvWorld = tv_world(an, af, 0);
    var wb: TvWorld = tv_world(bn, bf, 0);
    var module: IrModule = IrModule_new();
    var fx: TvFacts = tv_ipcp_facts(& wa, & module);
    var fixed: Vec<i64> = tv_fixed(& fx, "tvs_q", 2);
    return tv_mod_check("ipcp", & mut wa, & mut wb, & q, & q2, & fixed);
}

/// spec: tvs_q(a, b) = a * b; its caller passes (3, 5) and is sent to the
/// clone tvs_q_sc1_5, whose b is the constant 5 (`right`) or 6.
fn tvs_spec(right: bool) -> str {
    var q: IrFunction = tvs_fn("tvs_q", 2);
    var a: i64 = q.params.get(0).id;
    var b: i64 = q.params.get(1).id;
    var s: i64 = tvs_op(& mut q, BinOp::Mul, a, b);
    tvs_ret(& mut q, s);
    var q2: IrFunction = tv_snapshot(& q);
    q2.name = "tvs_q_sc1_5";
    var cv: i64 = 5;
    if !right {
        cv = 6;
    }
    var k: i64 = tvs_new(& mut q2, Inst::ConstInt(cv, IrType::I64), 0, s);
    IrFunction_set_inst(& mut q2, s, Inst::BinOp(BinOp::Mul, a, k, IrType::I64));
    var m: IrFunction = tvs_fn("tvs_m", 0);
    var c3: i64 = tvs_ci(& mut m, 3);
    var c5: i64 = tvs_ci(& mut m, 5);
    var args: Vec<i64> = Vec::new();
    args.push(c3);
    args.push(c5);
    var cl: i64 = IrFunction_emit(& mut m, Inst::Call("tvs_q", args, IrType::I64, EffectSet_new()));
    tvs_ret(& mut m, cl);
    var m2: IrFunction = tv_snapshot(& m);
    var args2: Vec<i64> = Vec::new();
    args2.push(c3);
    args2.push(c5);
    IrFunction_set_inst(& mut m2, cl, Inst::Call("tvs_q_sc1_5", args2, IrType::I64, EffectSet_new()));
    var an: Vec<str> = Vec::new();
    an.push("tvs_q");
    an.push("tvs_m");
    var af: Vec<IrFunction> = Vec::new();
    af.push(q);
    af.push(m);
    var bn: Vec<str> = Vec::new();
    bn.push("tvs_q");
    bn.push("tvs_m");
    bn.push("tvs_q_sc1_5");
    var bf: Vec<IrFunction> = Vec::new();
    bf.push(af.get(0));
    bf.push(m2);
    bf.push(q2);
    var wa: TvWorld = tv_world(an, af, 0);
    var wb: TvWorld = tv_world(bn, bf, 0);
    var pre: IrFunction = wa.fns.get(1);
    var post: IrFunction = wb.fns.get(1);
    return tv_spec_witness(& wa, & wb, & pre, & post);
}

/// devirt: a trait call `m` on a value made from type TvsT made a direct
/// call of TvsT_m (`right`) or of TvsU_m.
fn tvs_devirt(right: bool) -> str {
    var module: IrModule = IrModule_new();
    var tm: IrFunction = tvs_fn("TvsT_m", 2);
    var tm1: i64 = tm.params.get(1).id;
    tvs_ret(& mut tm, tm1);
    var um: IrFunction = tvs_fn("TvsU_m", 2);
    var um0: i64 = um.params.get(0).id;
    tvs_ret(& mut um, um0);
    IrModule_add_function(& mut module, tm);
    IrModule_add_function(& mut module, um);
    var f: IrFunction = tvs_fn("tvs_dv", 1);
    var x: i64 = f.params.get(0).id;
    var d: i64 = IrFunction_emit(& mut f, Inst::MakeDyn(x, "TvsT", "TvsTr"));
    var dargs: Vec<i64> = Vec::new();
    dargs.push(d);
    var r: i64 = IrFunction_emit(& mut f, Inst::DynCall("TvsTr", "m", dargs, IrType::I64, EffectSet_new()));
    tvs_ret(& mut f, r);
    var g: IrFunction = tv_snapshot(& f);
    var e0: i64 = tvs_new(& mut g, Inst::ConstInt(0, IrType::I64), 0, r);
    var nargs: Vec<i64> = Vec::new();
    nargs.push(e0);
    nargs.push(x);
    var target: str = "TvsT_m";
    if !right {
        target = "TvsU_m";
    }
    IrFunction_set_inst(& mut g, r, Inst::Call(target, nargs, IrType::I64, EffectSet_new()));
    return tv_devirt(& module, & f, & g);
}

/// A fault tv_inject_fn puts into gvn's right result must be caught.
fn tvs_inject() -> str {
    var f: IrFunction = tvs_fn("tvs_inj", 2);
    var x: i64 = f.params.get(0).id;
    var y: i64 = f.params.get(1).id;
    var a: i64 = tvs_op(& mut f, BinOp::Add, x, y);
    var r: i64 = tvs_op(& mut f, BinOp::BitXor, a, x);
    tvs_ret(& mut f, r);
    var g: IrFunction = tv_snapshot(& f);
    if !tv_inject_fn(& mut g) {
        return "";
    }
    return tv_check("gvn", & f, & g);
}

/// Straight-line code is written as SMT-LIB ("" yes).
fn tvs_smt() -> str {
    var f: IrFunction = tvs_fn("tvs_smt", 2);
    var x: i64 = f.params.get(0).id;
    var y: i64 = f.params.get(1).id;
    var a: i64 = tvs_op(& mut f, BinOp::Mul, x, y);
    var k: i64 = tvs_ci(& mut f, 3);
    var d: i64 = tvs_op(& mut f, BinOp::Div, a, k);
    tvs_ret(& mut f, d);
    var s: TvSmt = tv_smt_fn(& f, "a");
    if !s.ok || str_len(s.defs) == 0 || s.pan == "false" {
        return "not written as SMT-LIB";
    }
    return "";
}

/// Write the obligation of one example pair to <dir>/tvx<n>.smt2, its first
/// line naming the answer z3 must give ("expect unsat": the two are the
/// same; "expect sat": they differ). 1 when written.
fn tvs_smt_put(dir: str, n: i64, name: str, same: bool, pre: & IrFunction, post: & IrFunction) -> i64 {
    var want: str = "expect sat";
    if same {
        want = "expect unsat";
    }
    var text: str = tv_smt_text("tv example " + int_to_str(n) + ": " + name + "; " + want, pre, post);
    if str_len(text) == 0 {
        p_eprint_str("tv smt examples: " + name + ": not straight-line code\n");
        return 0;
    }
    p_file_write(dir + "/tvx" + int_to_str(n) + ".smt2", text);
    return 1;
}

/// `x op k` (k a constant), returned.
fn tvs_smt_opk(name: str, op: BinOp, k: i64) -> IrFunction {
    var f: IrFunction = tvs_fn(name, 1);
    var x: i64 = f.params.get(0).id;
    var c: i64 = tvs_ci(& mut f, k);
    var r: i64 = tvs_op(& mut f, op, x, c);
    tvs_ret(& mut f, r);
    return f;
}

/// `x + a * b`, the product of two constants, returned.
fn tvs_smt_fold(name: str, a: i64, b: i64) -> IrFunction {
    var f: IrFunction = tvs_fn(name, 1);
    var x: i64 = f.params.get(0).id;
    var ca: i64 = tvs_ci(& mut f, a);
    var cb: i64 = tvs_ci(& mut f, b);
    var m: i64 = tvs_op(& mut f, BinOp::Mul, ca, cb);
    var r: i64 = tvs_op(& mut f, BinOp::Add, x, m);
    tvs_ret(& mut f, r);
    return f;
}

/// `x + k`, returned.
fn tvs_smt_addk(name: str, k: i64) -> IrFunction {
    return tvs_smt_opk(name, BinOp::Add, k);
}

/// VF6 (SMT for straight-line code): example pairs written as SMT-LIB to
/// `dir` (tests/tooling/tv-check.sh runs z3 on them and compares each
/// answer with the one its first line expects): rewrites a pass may make
/// (unsat) and mistakes (sat), the overflow and signedness traps among
/// them. The number written.
pub fn tv_smt_examples(dir: str) -> i64 {
    var n: i64 = 0;
    // x * 2 as x + x: both panic on the same overflow
    var f1: IrFunction = tvs_smt_opk("tvx_mul2", BinOp::Mul, 2);
    var g1: IrFunction = tvs_fn("tvx_mul2", 1);
    var x1: i64 = g1.params.get(0).id;
    var s1: i64 = tvs_op(& mut g1, BinOp::Add, x1, x1);
    tvs_ret(& mut g1, s1);
    n = n + tvs_smt_put(dir, n + 1, "x * 2 as x + x", true, & f1, & g1);
    // x + y - y as x: the panic of the overflowing addition is lost
    var f2: IrFunction = tvs_fn("tvx_addsub", 2);
    var x2: i64 = f2.params.get(0).id;
    var y2: i64 = f2.params.get(1).id;
    var a2: i64 = tvs_op(& mut f2, BinOp::Add, x2, y2);
    var b2: i64 = tvs_op(& mut f2, BinOp::Sub, a2, y2);
    tvs_ret(& mut f2, b2);
    var g2: IrFunction = tvs_fn("tvx_addsub", 2);
    var p2: i64 = g2.params.get(0).id;
    tvs_ret(& mut g2, p2);
    n = n + tvs_smt_put(dir, n + 1, "x + y - y as x (checked arithmetic)", false, & f2, & g2);
    // a fold of 6 * 7 into 42, and into 43
    var f3: IrFunction = tvs_smt_fold("tvx_fold", 6, 7);
    var g3: IrFunction = tvs_smt_addk("tvx_fold", 42);
    n = n + tvs_smt_put(dir, n + 1, "x + 6 * 7 folded to x + 42", true, & f3, & g3);
    var g4: IrFunction = tvs_smt_addk("tvx_fold", 43);
    n = n + tvs_smt_put(dir, n + 1, "x + 6 * 7 folded to x + 43", false, & f3, & g4);
    // an unused x / y removed: y == 0 panicked
    var f5: IrFunction = tvs_fn("tvx_div", 2);
    var x5: i64 = f5.params.get(0).id;
    var y5: i64 = f5.params.get(1).id;
    var _d5: i64 = tvs_op(& mut f5, BinOp::Div, x5, y5);
    tvs_ret(& mut f5, x5);
    var g5: IrFunction = tvs_fn("tvx_div", 2);
    var p5: i64 = g5.params.get(0).id;
    tvs_ret(& mut g5, p5);
    n = n + tvs_smt_put(dir, n + 1, "an unused x / y removed", false, & f5, & g5);
    // (x ^ y) ^ y as x
    var f6: IrFunction = tvs_fn("tvx_xor", 2);
    var x6: i64 = f6.params.get(0).id;
    var y6: i64 = f6.params.get(1).id;
    var a6: i64 = tvs_op(& mut f6, BinOp::BitXor, x6, y6);
    var b6: i64 = tvs_op(& mut f6, BinOp::BitXor, a6, y6);
    tvs_ret(& mut f6, b6);
    var g6: IrFunction = tvs_fn("tvx_xor", 2);
    var p6: i64 = g6.params.get(0).id;
    tvs_ret(& mut g6, p6);
    n = n + tvs_smt_put(dir, n + 1, "(x ^ y) ^ y as x", true, & f6, & g6);
    // x / 4 as x >> 2: not for negative x (signed division rounds to 0)
    var f7: IrFunction = tvs_smt_opk("tvx_div4", BinOp::Div, 4);
    var g7: IrFunction = tvs_smt_opk("tvx_div4", BinOp::Shr, 2);
    n = n + tvs_smt_put(dir, n + 1, "x / 4 as x >> 2 (signed)", false, & f7, & g7);
    // x * 8 as x << 3: not with checked arithmetic (the shift does not panic)
    var f8: IrFunction = tvs_smt_opk("tvx_mul8", BinOp::Mul, 8);
    var g8: IrFunction = tvs_smt_opk("tvx_mul8", BinOp::Shl, 3);
    n = n + tvs_smt_put(dir, n + 1, "x * 8 as x << 3 (checked arithmetic)", false, & f8, & g8);
    // x - x as 0
    var f9: IrFunction = tvs_fn("tvx_subself", 1);
    var x9: i64 = f9.params.get(0).id;
    var s9: i64 = tvs_op(& mut f9, BinOp::Sub, x9, x9);
    tvs_ret(& mut f9, s9);
    var g9: IrFunction = tvs_fn("tvx_subself", 1);
    var z9: i64 = tvs_ci(& mut g9, 0);
    tvs_ret(& mut g9, z9);
    n = n + tvs_smt_put(dir, n + 1, "x - x as 0", true, & f9, & g9);
    return n;
}

/// Run every case: the number not as expected (each is printed).
pub fn tv_selftest() -> i64 {
    var bad: Vec<str> = Vec::new();
    var n: i64 = 0;
    n = n + tvs_expect("fold of 2 * 3 into 6", tvs_fold(6), true, & mut bad);
    n = n + tvs_expect("fold of 2 * 3 into 7", tvs_fold(7), false, & mut bad);
    n = n + tvs_expect("fold of an addition that overflows", tvs_fold_panic(), false, & mut bad);
    n = n + tvs_expect("dce of an unused bit operation", tvs_dce(BinOp::BitAnd), true, & mut bad);
    n = n + tvs_expect("dce of a division that may panic", tvs_dce(BinOp::Div), false, & mut bad);
    n = n + tvs_expect("gvn of an equal addition", tvs_gvn_ok(), true, & mut bad);
    n = n + tvs_expect("gvn of a load across a store", tvs_gvn_store(), false, & mut bad);
    n = n + tvs_expect("licm of a bit operation", tvs_licm(0), true, & mut bad);
    n = n + tvs_expect("licm of a division out of the loop body", tvs_licm(1), false, & mut bad);
    n = n + tvs_expect("licm of a load of a local the loop stores", tvs_licm(2), false, & mut bad);
    n = n + tvs_expect("inline of a copy of the callee", tvs_inline(false), true, & mut bad);
    n = n + tvs_expect("inline of a wrong copy", tvs_inline(true), false, & mut bad);
    n = n + tvs_expect("gconst of a global nothing stores", tvs_gconst(false), true, & mut bad);
    n = n + tvs_expect("gconst of a global a function stores", tvs_gconst(true), false, & mut bad);
    n = n + tvs_expect("icf to the same body", tvs_icf(true), true, & mut bad);
    n = n + tvs_expect("icf to another body", tvs_icf(false), false, & mut bad);
    n = n + tvs_expect("ipcp of a constant every call passes", tvs_ipcp(true), true, & mut bad);
    n = n + tvs_expect("ipcp of a parameter the calls differ on", tvs_ipcp(false), false, & mut bad);
    n = n + tvs_expect("spec to a clone for the constant passed", tvs_spec(true), true, & mut bad);
    n = n + tvs_expect("spec to a clone for another constant", tvs_spec(false), false, & mut bad);
    n = n + tvs_expect("devirt to the type's method", tvs_devirt(true), true, & mut bad);
    n = n + tvs_expect("devirt to another type's method", tvs_devirt(false), false, & mut bad);
    n = n + tvs_expect("an injected fault", tvs_inject(), false, & mut bad);
    n = n + tvs_expect("SMT-LIB of straight-line code", tvs_smt(), true, & mut bad);
    p_eprint_str("tv selftest: " + int_to_str(n) + " cases, " + int_to_str(n - bad.len()) + " as expected\n");
    var i: i64 = 0;
    while i < bad.len() {
        p_eprint_str("tv selftest: " + bad.get(i) + "\n");
        i = i + 1;
    }
    return bad.len();
}

// --- Before/after pairs from text (RL5, tests/verify/tv) ------------------------
//
// A pair file (.tvp) holds pairs of functions, each as it was before a pass
// and as the pass left it, with the verdict the checks must give:
//
//   pair fold_ok              starts a pair (its name)
//   pass fold                 the pass whose check applies
//   expect accept             accept, reject or n/a (no check applies)
//   why changed its value     optional: a reject's reason must contain this
//   check f                   optional: the function compared (default: the
//                             first one before the pass)
//   global G i64 5            optional: a global and its initializer
//   before                    the functions before the pass ...
//   fn f(%0: i64) -> i64      parameters are values like any other
//   b0:                       a block; the first one is the entry
//     %1 = const i64 2
//     %2 = mul i64 %0 %1
//     %3 = ret %2
//   after                     ... and after it (the same value ids where
//   fn f(%0: i64) -> i64      the pass kept a value)
//   b0:
//     %2 = add i64 %0 %0
//     %3 = ret %2
//
// Every instruction names its value id. Types: i8 i16 i32 i64 u8 u16 u32
// u64 bool ptr void. Instructions: const T n (n may be min or max) | const
// bool true/false | OP T %a %b (add sub mul div mod eq ne lt gt le ge and
// or band bor bxor shl shr; T the result type) | neg/not/bnot T %a |
// alloca T | load T %p | store %p %v | jump bN | br %c bT bE | ret [%v] |
// unreachable | panic | print T %v | call T name(%a, ...) [!io !write !read
// !alloc !diverge] (no effect named: a pure call) | ext/trunc/bitcast FROM
// TO %a | global T NAME (its address) | fnref NAME | makedyn %v Type Trait
// | dyncall T Trait method(%a, ...). `fn ... -> T wrapping` makes the
// function @wrapping. `#` starts a comment, as does a line's leading `//`.
//
// The verdict is the one the compiler gives (tv_pair_check): fold, dce,
// gvn, ssa the witness then runs on random inputs; licm its witness; devirt
// its witness; the module passes (hofspec, inline, inline2, inlineclo,
// ipcp, spec, gconst, icf) their witness and runs across the functions of
// the pair; any other pass runs on random inputs.
//
// FID_TV_PAIRS=<file or directory> runs every pair once the mid-end is done
// (tv_report); tests/tooling/tv_pairs_main.fd runs them without a build of
// the compiler (tests/tooling/tv-check.sh does both).

pub struct TvpP {
    pub lines: Vec<str>,
    pub at: i64,
    pub err: str,
}

pub struct TvpPair {
    pub name: str,
    pub pname: str,
    pub expect: str,
    pub why: str,
    pub check: str,
    pub an: Vec<str>,
    pub af: Vec<IrFunction>,
    pub bn: Vec<str>,
    pub bf: Vec<IrFunction>,
    pub globals: Vec<GlobalEntry>,
    // 0 before the pass, 1 after it, -1 neither said yet
    pub side: i64,
}

fn tvp_pair_new(name: str) -> TvpPair {
    return TvpPair {
        name: name, pname: "", expect: "", why: "", check: "", an: Vec::new(), af: Vec::new(), bn: Vec::new(), bf: Vec::new(), globals: Vec::new(), side: 0 - 1
    };
}

/// Note the first error of the pair being read (with its line).
fn tvp_err(p: & mut TvpP, msg: str) {
    if str_len(p.err) == 0 {
        p.err = "line " + int_to_str(p.at + 1) + ": " + msg;
    }
}

/// The words of a line: split at spaces, tabs, commas, parentheses, colons
/// and `=`; nothing from a `#` on; none for a line starting with `//`.
fn tvp_words(line: str) -> Vec<str> {
    var s: str = line;
    var hash: i64 = str_find(s, "#");
    if hash >= 0 {
        s = str_slice(s, 0, hash);
    }
    var out: Vec<str> = Vec::new();
    var n: i64 = str_len(s);
    var i: i64 = 0;
    var start: i64 = 0 - 1;
    while i <= n {
        var sep: bool = true;
        if i < n {
            var c: i64 = str_byte_at(s, i);
            sep = c == 32 || c == 9 || c == 13 || c == 44 || c == 40 || c == 41 || c == 58 || c == 61;
        }
        if sep {
            if start >= 0 {
                out.push(str_slice(s, start, i));
                start = 0 - 1;
            }
        } else if start < 0 {
            start = i;
        }
        i = i + 1;
    }
    if out.len() > 0 && str_starts_with(out.get(0), "//") {
        return Vec::new();
    }
    return out;
}

fn tvp_w(ws: & Vec<str>, i: i64) -> str {
    if i >= 0 && i < ws.len() {
        return ws.get(i);
    }
    return "";
}

/// Is `w` a decimal integer (an optional minus, at most 19 digits)?
fn tvp_isnum(w: str) -> bool {
    var n: i64 = str_len(w);
    var i: i64 = 0;
    if n > 0 && str_byte_at(w, 0) == 45 {
        i = 1;
    }
    if i >= n || n - i > 19 {
        return false;
    }
    while i < n {
        var c: i64 = str_byte_at(w, i);
        if c < 48 || c > 57 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// The integer `w`, or i64's `min` or `max`.
fn tvp_num(p: & mut TvpP, w: str) -> i64 {
    if w == "max" {
        return 9223372036854775807;
    }
    if w == "min" {
        return 0 - 9223372036854775807 - 1;
    }
    if !tvp_isnum(w) {
        tvp_err(p, "not a number: '" + w + "'");
        return 0;
    }
    var n: i64 = str_len(w);
    var neg: bool = str_byte_at(w, 0) == 45;
    var i: i64 = 0;
    if neg {
        i = 1;
    }
    // built as a negative number, which reaches i64's min
    var v: i64 = 0;
    var lim: i64 = 0 - 922337203685477580;
    while i < n {
        var d: i64 = str_byte_at(w, i) - 48;
        if v < lim || (v == lim && d > 8) {
            tvp_err(p, "out of range: " + w);
            return 0;
        }
        v = v * 10 - d;
        i = i + 1;
    }
    if neg {
        return v;
    }
    if v == 0 - 9223372036854775807 - 1 {
        tvp_err(p, "out of range: " + w);
        return 0;
    }
    return 0 - v;
}

fn tvp_ty(p: & mut TvpP, w: str) -> IrType {
    if w == "i64" {
        return IrType::I64;
    }
    if w == "i32" {
        return IrType::I32;
    }
    if w == "i16" {
        return IrType::I16;
    }
    if w == "i8" {
        return IrType::I8;
    }
    if w == "u64" {
        return IrType::U64;
    }
    if w == "u32" {
        return IrType::U32;
    }
    if w == "u16" {
        return IrType::U16;
    }
    if w == "u8" {
        return IrType::U8;
    }
    if w == "bool" {
        return IrType::Bool;
    }
    if w == "void" {
        return IrType::Void;
    }
    if w == "ptr" {
        return IrType::Ptr(Box::new(IrType::I64));
    }
    tvp_err(p, "not a type: '" + w + "'");
    return IrType::I64;
}

/// `%N` (a value) or `bN` (a block, `mark` 98): N.
fn tvp_ref(p: & mut TvpP, w: str, mark: i64) -> i64 {
    if str_len(w) < 2 || str_byte_at(w, 0) != mark {
        if mark == 98 {
            tvp_err(p, "not a block: '" + w + "'");
        } else {
            tvp_err(p, "not a value: '" + w + "'");
        }
        return 0;
    }
    var rest: str = str_slice(w, 1, str_len(w));
    if !tvp_isnum(rest) || str_byte_at(rest, 0) == 45 {
        tvp_err(p, "not a value or block: '" + w + "'");
        return 0;
    }
    return tvp_num(p, rest);
}

fn tvp_val(p: & mut TvpP, w: str) -> i64 {
    return tvp_ref(p, w, 37);
}

fn tvp_blk(p: & mut TvpP, w: str) -> i64 {
    return tvp_ref(p, w, 98);
}

fn tvp_is_binop(w: str) -> bool {
    return w == "add" || w == "sub" || w == "mul" || w == "div" || w == "mod" || w == "eq" || w == "ne" || w == "lt" || w == "gt" || w == "le" || w == "ge" || w == "and" || w == "or" || w == "band" || w == "bor" || w == "bxor" || w == "shl" || w == "shr";
}

fn tvp_binop(w: str) -> BinOp {
    if w == "sub" {
        return BinOp::Sub;
    }
    if w == "mul" {
        return BinOp::Mul;
    }
    if w == "div" {
        return BinOp::Div;
    }
    if w == "mod" {
        return BinOp::Mod;
    }
    if w == "eq" {
        return BinOp::Eq;
    }
    if w == "ne" {
        return BinOp::Neq;
    }
    if w == "lt" {
        return BinOp::Lt;
    }
    if w == "gt" {
        return BinOp::Gt;
    }
    if w == "le" {
        return BinOp::LtEq;
    }
    if w == "ge" {
        return BinOp::GtEq;
    }
    if w == "and" {
        return BinOp::And;
    }
    if w == "or" {
        return BinOp::Or;
    }
    if w == "band" {
        return BinOp::BitAnd;
    }
    if w == "bor" {
        return BinOp::BitOr;
    }
    if w == "bxor" {
        return BinOp::BitXor;
    }
    if w == "shl" {
        return BinOp::Shl;
    }
    if w == "shr" {
        return BinOp::Shr;
    }
    return BinOp::Add;
}

/// The arguments (`%N` words) and effects (`!name` words) of a call, from
/// word `from` on.
pub struct TvpArgs {
    pub args: Vec<i64>,
    pub eff: EffectSet,
}

fn tvp_args(p: & mut TvpP, ws: & Vec<str>, from: i64) -> TvpArgs {
    var a: TvpArgs = TvpArgs {
        args: Vec::new(), eff: EffectSet_new()
    };
    var i: i64 = from;
    while i < ws.len() {
        var w: str = ws.get(i);
        if str_byte_at(w, 0) == 33 {
            if w == "!io" {
                EffectSet_add(& mut a.eff, Effect::IO);
            } else if w == "!write" {
                EffectSet_add(& mut a.eff, Effect::Write);
            } else if w == "!read" {
                EffectSet_add(& mut a.eff, Effect::Read);
            } else if w == "!alloc" {
                EffectSet_add(& mut a.eff, Effect::Alloc);
            } else if w == "!diverge" {
                EffectSet_add(& mut a.eff, Effect::Diverge);
            } else {
                tvp_err(p, "not an effect: '" + w + "'");
            }
        } else {
            a.args.push(tvp_val(p, w));
        }
        i = i + 1;
    }
    return a;
}

/// The instruction of words `ws` (`%N OP ...`).
fn tvp_inst(p: & mut TvpP, ws: & Vec<str>) -> Inst {
    var op: str = tvp_w(ws, 1);
    if op == "const" {
        var ct: IrType = tvp_ty(p, tvp_w(ws, 2));
        var cw: str = tvp_w(ws, 3);
        if cw == "true" {
            return Inst::ConstBool(true);
        }
        if cw == "false" {
            return Inst::ConstBool(false);
        }
        return Inst::ConstInt(tvp_num(p, cw), ct);
    }
    if tvp_is_binop(op) {
        var bt: IrType = tvp_ty(p, tvp_w(ws, 2));
        var bl: i64 = tvp_val(p, tvp_w(ws, 3));
        var br: i64 = tvp_val(p, tvp_w(ws, 4));
        return Inst::BinOp(tvp_binop(op), bl, br, bt);
    }
    if op == "neg" || op == "not" || op == "bnot" {
        var ut: IrType = tvp_ty(p, tvp_w(ws, 2));
        var ux: i64 = tvp_val(p, tvp_w(ws, 3));
        if op == "neg" {
            return Inst::UnaryOp(UnaryOp::Neg, ux, ut);
        }
        if op == "not" {
            return Inst::UnaryOp(UnaryOp::Not, ux, ut);
        }
        return Inst::UnaryOp(UnaryOp::BitNot, ux, ut);
    }
    if op == "alloca" {
        return Inst::Alloca(tvp_ty(p, tvp_w(ws, 2)), Region::Stack);
    }
    if op == "load" {
        var lt: IrType = tvp_ty(p, tvp_w(ws, 2));
        return Inst::Load(tvp_val(p, tvp_w(ws, 3)), lt);
    }
    if op == "store" {
        var sp: i64 = tvp_val(p, tvp_w(ws, 2));
        var sv: i64 = tvp_val(p, tvp_w(ws, 3));
        return Inst::Store(sp, sv, OptIrType::None);
    }
    if op == "jump" {
        return Inst::Jump(tvp_blk(p, tvp_w(ws, 2)));
    }
    if op == "br" {
        var bc: i64 = tvp_val(p, tvp_w(ws, 2));
        var bthen: i64 = tvp_blk(p, tvp_w(ws, 3));
        var belse: i64 = tvp_blk(p, tvp_w(ws, 4));
        return Inst::Branch(bc, bthen, belse);
    }
    if op == "ret" {
        if ws.len() > 2 {
            return Inst::Return(OptValueId::Some(tvp_val(p, tvp_w(ws, 2))));
        }
        return Inst::Return(OptValueId::None);
    }
    if op == "unreachable" {
        return Inst::Unreachable;
    }
    if op == "panic" {
        return Inst::Panic("tvp");
    }
    if op == "print" {
        var pt: IrType = tvp_ty(p, tvp_w(ws, 2));
        return Inst::Print(tvp_val(p, tvp_w(ws, 3)), pt);
    }
    if op == "call" {
        var ct2: IrType = tvp_ty(p, tvp_w(ws, 2));
        var cname: str = tvp_w(ws, 3);
        if str_len(cname) == 0 {
            tvp_err(p, "a call names no function");
        }
        var ca: TvpArgs = tvp_args(p, ws, 4);
        return Inst::Call(cname, ca.args, ct2, ca.eff);
    }
    if op == "ext" || op == "trunc" || op == "bitcast" {
        var from: IrType = tvp_ty(p, tvp_w(ws, 2));
        var to: IrType = tvp_ty(p, tvp_w(ws, 3));
        var cx: i64 = tvp_val(p, tvp_w(ws, 4));
        if op == "ext" {
            return Inst::IntExtend(cx, from, to);
        }
        if op == "trunc" {
            return Inst::IntTrunc(cx, from, to);
        }
        return Inst::BitCast(cx, from, to);
    }
    if op == "global" {
        var gt: IrType = tvp_ty(p, tvp_w(ws, 2));
        return Inst::GlobalAddr(tvp_w(ws, 3), gt);
    }
    if op == "fnref" {
        return Inst::ConstFnRef(tvp_w(ws, 2));
    }
    if op == "makedyn" {
        var mv: i64 = tvp_val(p, tvp_w(ws, 2));
        return Inst::MakeDyn(mv, tvp_w(ws, 3), tvp_w(ws, 4));
    }
    if op == "dyncall" {
        var dt: IrType = tvp_ty(p, tvp_w(ws, 2));
        var da: TvpArgs = tvp_args(p, ws, 5);
        return Inst::DynCall(tvp_w(ws, 3), tvp_w(ws, 4), da.args, dt, da.eff);
    }
    tvp_err(p, "not an instruction: '" + op + "'");
    return Inst::Unreachable;
}

/// Is `w` a block label (`bN`, the line's only word)?
fn tvp_is_label(ws: & Vec<str>) -> bool {
    if ws.len() != 1 {
        return false;
    }
    var w: str = ws.get(0);
    return str_len(w) > 1 && str_byte_at(w, 0) == 98 && tvp_isnum(str_slice(w, 1, str_len(w)));
}

/// The function whose header (`fn name(%0: T, ...) -> T [wrapping]`) is
/// line `p.at`, with the blocks and instructions that follow it; `p.at` is
/// then the first line that is neither.
fn tvp_fn(p: & mut TvpP, head: & Vec<str>) -> IrFunction {
    var name: str = tvp_w(head, 1);
    if str_len(name) == 0 {
        tvp_err(p, "a function without a name");
    }
    var params: Vec<ValueIdType> = Vec::new();
    var ret: IrType = IrType::Void;
    var wrapping: bool = false;
    var i: i64 = 2;
    while i < head.len() {
        var w: str = head.get(i);
        if w == "->" {
            ret = tvp_ty(p, tvp_w(head, i + 1));
            i = i + 2;
        } else if w == "wrapping" {
            wrapping = true;
            i = i + 1;
        } else {
            var pid: i64 = tvp_val(p, w);
            var pty: IrType = tvp_ty(p, tvp_w(head, i + 1));
            params.push(ValueIdType_new(pid, pty));
            i = i + 2;
        }
    }
    var blocks: Vec<BasicBlock> = Vec::new();
    var items: Vec<ValueIdInst> = Vec::new();
    p.at = p.at + 1;
    var going: bool = true;
    while going && p.at < p.lines.len() {
        var ws: Vec<str> = tvp_words(p.lines.get(p.at));
        if ws.len() == 0 {
            p.at = p.at + 1;
        } else if str_byte_at(ws.get(0), 0) == 37 {
            if blocks.len() == 0 {
                blocks.push(BasicBlock_new(0));
            }
            var id: i64 = tvp_val(p, ws.get(0));
            var inst: Inst = tvp_inst(p, & ws);
            items.push(ValueIdInst_new(id, inst));
            var last: i64 = blocks.len() - 1;
            var blk: BasicBlock = blocks.get(last);
            blk.instructions.push(id);
            blocks.set(last, blk);
            p.at = p.at + 1;
        } else if tvp_is_label(& ws) {
            blocks.push(BasicBlock_new(tvp_blk(p, ws.get(0))));
            p.at = p.at + 1;
        } else {
            going = false;
        }
    }
    return tvp_build(p, name, ret, params, blocks, items, wrapping);
}

/// The IrFunction of what tvp_fn read: values by the ids written (one
/// meta per id up to the largest, in order), the first block the entry,
/// predecessors from the terminators.
fn tvp_build(p: & mut TvpP, name: str, ret: IrType, params: Vec<ValueIdType>, blocks: Vec<BasicBlock>, items: Vec<ValueIdInst>, wrapping: bool) -> IrFunction {
    var f: IrFunction = IrFunction_new(name, ret);
    if blocks.len() == 0 {
        tvp_err(p, "function " + name + " has no instructions");
        return f;
    }
    var maxid: i64 = 0 - 1;
    var k: i64 = 0;
    while k < params.len() {
        if params.get(k).id > maxid {
            maxid = params.get(k).id;
        }
        k = k + 1;
    }
    k = 0;
    while k < items.len() {
        if items.get(k).id > maxid {
            maxid = items.get(k).id;
        }
        k = k + 1;
    }
    if maxid > 100000 {
        tvp_err(p, "function " + name + ": value ids above 100000");
        return f;
    }
    // where each id is defined: item position + 1, or -(param position + 1)
    var at: Vec<i64> = peir_zeros(maxid + 1);
    k = 0;
    while k < params.len() {
        var pid: i64 = params.get(k).id;
        if at.get(pid) != 0 {
            tvp_err(p, "function " + name + ": %" + int_to_str(pid) + " defined twice");
        }
        at.set(pid, 0 - k - 1);
        k = k + 1;
    }
    k = 0;
    while k < items.len() {
        var iid: i64 = items.get(k).id;
        if at.get(iid) != 0 {
            tvp_err(p, "function " + name + ": %" + int_to_str(iid) + " defined twice");
        }
        at.set(iid, k + 1);
        k = k + 1;
    }
    var metas: Vec<ValueIdMeta> = Vec::new();
    var insts: Vec<ValueIdInst> = Vec::new();
    var inst_at: Vec<i64> = Vec::new();
    var id: i64 = 0;
    while id <= maxid {
        var a: i64 = at.get(id);
        if a > 0 {
            var inst: Inst = items.get(a - 1).inst;
            var meta: ValueMeta = ValueMeta_new(inst_result_type(inst));
            meta.effects = inst_effects(& inst);
            metas.push(ValueIdMeta_new(id, meta));
            insts.push(ValueIdInst_new(id, inst));
            inst_at.push(insts.len());
        } else {
            var vty: IrType = IrType::I64;
            if a < 0 {
                vty = params.get(0 - a - 1).ty;
            }
            metas.push(ValueIdMeta_new(id, ValueMeta_new(vty)));
            inst_at.push(0);
        }
        id = id + 1;
    }
    // predecessors (block ids) from each block's last instruction
    var bl: Vec<BasicBlock> = blocks;
    var maxb: i64 = 0;
    var b: i64 = 0;
    while b < bl.len() {
        if bl.get(b).id > maxb {
            maxb = bl.get(b).id;
        }
        var c: i64 = 0;
        while c < b {
            if bl.get(c).id == bl.get(b).id {
                tvp_err(p, "function " + name + ": block b" + int_to_str(bl.get(b).id) + " twice");
            }
            c = c + 1;
        }
        b = b + 1;
    }
    b = 0;
    while b < bl.len() {
        var ids: Vec<i64> = bl.get(b).instructions;
        if ids.len() > 0 {
            var lid: i64 = ids.get(ids.len() - 1);
            var tg: Vec<i64> = Vec::new();
            match items.get(at.get(lid) - 1).inst {
                Inst::Jump(t) => {
                    tg.push(t);
                }
                Inst::Branch(_, t, e) => {
                    tg.push(t);
                    tg.push(e);
                }
                _ => {
                }
            }
            var j: i64 = 0;
            while j < tg.len() {
                var found: bool = false;
                var x: i64 = 0;
                while x < bl.len() {
                    if bl.get(x).id == tg.get(j) {
                        found = true;
                        var tb: BasicBlock = bl.get(x);
                        var seen: bool = false;
                        var q: i64 = 0;
                        while q < tb.predecessors.len() {
                            if tb.predecessors.get(q) == bl.get(b).id {
                                seen = true;
                            }
                            q = q + 1;
                        }
                        if !seen {
                            tb.predecessors.push(bl.get(b).id);
                            bl.set(x, tb);
                        }
                    }
                    x = x + 1;
                }
                if !found {
                    tvp_err(p, "function " + name + ": a jump to b" + int_to_str(tg.get(j)) + ", which is not a block");
                }
                j = j + 1;
            }
        }
        b = b + 1;
    }
    f.params = params;
    f.blocks = bl;
    f.value_metas = metas;
    f.insts = insts;
    f.inst_at = inst_at;
    f.next_value = maxid + 1;
    f.next_block = maxb + 1;
    f.entry = f.blocks.get(0).id;
    f.current_block_idx = 0;
    f.is_wrapping = wrapping;
    return f;
}

fn tvp_index(names: & Vec<str>, nm: str) -> i64 {
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == nm {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/// Is `pname` a module pass (checked by tv_mod_after in the mid-end)?
pub fn tv_is_module_pass(pname: str) -> bool {
    return pname == "hofspec" || pname == "inline" || pname == "inline2" || pname == "inlineclo" || pname == "ipcp" || pname == "spec" || pname == "gconst" || pname == "icf";
}

/// RL5: the verdict the mid-end gives on function `fname` after pass
/// `pname`, for a module whose functions were `an`/`af` (and globals
/// `globals`) before the pass and are `bn`/`bf` after it: "" accepted,
/// "n/a" no check applies, else why it is rejected. The same checks as
/// tv_after (function passes), tv_after_devirt and tv_mod_after (module
/// passes) make.
pub fn tv_pair_check(pname: str, an: Vec<str>, af: Vec<IrFunction>, bn: Vec<str>, bf: Vec<IrFunction>, globals: Vec<GlobalEntry>, fname: str) -> str {
    var ia: i64 = tvp_index(& an, fname);
    var ib: i64 = tvp_index(& bn, fname);
    if ia < 0 || ib < 0 {
        return "n/a";
    }
    var fa: IrFunction = af.get(ia);
    var fb: IrFunction = bf.get(ib);
    if pname == "devirt" {
        var module: IrModule = IrModule_new();
        var i: i64 = 0;
        while i < af.len() {
            IrModule_add_function(& mut module, af.get(i));
            i = i + 1;
        }
        var why: str = tv_devirt(& module, & fa, & fb);
        if str_len(why) == 0 {
            var r: str = tv_random(& fa, & fb);
            if str_len(r) > 0 && r != "n/a" {
                why = r;
            }
        }
        return why;
    }
    if tv_is_module_pass(pname) {
        var gc: i64 = tv_gconst_facts(& af, & globals);
        var wa: TvWorld = tv_world(an, af, gc);
        var wb: TvWorld = tv_world(bn, bf, gc);
        var fixed: Vec<i64> = Vec::new();
        if pname == "ipcp" {
            var m2: IrModule = IrModule_new();
            var fx: TvFacts = tv_ipcp_facts(& wa, & m2);
            fixed = tv_fixed(& fx, fname, fa.params.len());
        }
        return tv_mod_check(pname, & mut wa, & mut wb, & fa, & fb, & fixed);
    }
    return tv_check(pname, & fa, & fb);
}

/// Check pair `pr` of file `src` (read with error `err`): counts[0] + 1,
/// counts[1] + 1 when the verdict is the one expected. A pair not as
/// expected is printed on stderr; with `each` every pair is.
fn tvp_finish(src: str, pr: & TvpPair, err0: str, each: bool, counts: & mut Vec<i64>) {
    var err: str = err0;
    if str_len(err) == 0 && str_len(pr.pname) == 0 {
        err = "no `pass` line";
    }
    if str_len(err) == 0 && pr.expect != "accept" && pr.expect != "reject" && pr.expect != "n/a" {
        err = "`expect` must be accept, reject or n/a";
    }
    var fname: str = pr.check;
    if str_len(fname) == 0 && pr.an.len() > 0 {
        fname = pr.an.get(0);
    }
    if str_len(err) == 0 && (tvp_index(& pr.an, fname) < 0 || tvp_index(& pr.bn, fname) < 0) {
        err = "no function " + fname + " both before and after the pass";
    }
    var why: str = "";
    var ok: bool = false;
    var got: str = "";
    if str_len(err) > 0 {
        got = "error: " + err;
    } else {
        why = tv_pair_check(pr.pname, pr.an, pr.af, pr.bn, pr.bf, pr.globals, fname);
        if str_len(why) == 0 {
            got = "accepted";
            ok = pr.expect == "accept";
        } else if why == "n/a" {
            got = "not checkable";
            ok = pr.expect == "n/a";
        } else {
            got = "rejected: " + why;
            ok = pr.expect == "reject" && (str_len(pr.why) == 0 || str_contains(why, pr.why));
        }
    }
    counts.set(0, counts.get(0) + 1);
    var line: str = src + ": " + pr.name + " (" + pr.pname + "): want " + pr.expect;
    if str_len(pr.why) > 0 {
        line = line + " (" + pr.why + ")";
    }
    line = line + ", got " + got;
    if ok {
        counts.set(1, counts.get(1) + 1);
        if each {
            p_eprint_str("tv pairs: ok   " + line + "\n");
        }
    } else {
        p_eprint_str("tv pairs: FAIL " + line + "\n");
    }
}

/// Run the pairs of file text `text` (named `src` in the report).
pub fn tv_pairs_text(src: str, text: str, each: bool, counts: & mut Vec<i64>) {
    var p: TvpP = TvpP {
        lines: str_lines(text), at: 0, err: ""
    };
    var pr: TvpPair = tvp_pair_new("(before the first pair)");
    var open: bool = false;
    while p.at < p.lines.len() {
        var ws: Vec<str> = tvp_words(p.lines.get(p.at));
        if ws.len() == 0 {
            p.at = p.at + 1;
        } else {
            var w0: str = ws.get(0);
            var w1: str = tvp_w(& ws, 1);
            if w0 == "pair" {
                if open {
                    tvp_finish(src, & pr, p.err, each, counts);
                }
                pr = tvp_pair_new(w1);
                p.err = "";
                open = true;
                p.at = p.at + 1;
            } else if w0 == "fn" {
                open = true;
                var f: IrFunction = tvp_fn(& mut p, & ws);
                if pr.side == 0 {
                    pr.an.push(f.name);
                    pr.af.push(f);
                } else if pr.side == 1 {
                    pr.bn.push(f.name);
                    pr.bf.push(f);
                } else {
                    tvp_err(& mut p, "a function before `before` or `after`");
                }
            } else {
                open = true;
                if w0 == "pass" {
                    pr.pname = w1;
                } else if w0 == "expect" {
                    pr.expect = w1;
                } else if w0 == "why" {
                    var raw: str = str_trim(p.lines.get(p.at));
                    var hash: i64 = str_find(raw, "#");
                    if hash >= 0 {
                        raw = str_trim(str_slice(raw, 0, hash));
                    }
                    pr.why = str_trim(str_slice(raw, 3, str_len(raw)));
                } else if w0 == "check" {
                    pr.check = w1;
                } else if w0 == "global" {
                    var gty: IrType = tvp_ty(& mut p, tvp_w(& ws, 2));
                    var gv: i64 = tvp_num(& mut p, tvp_w(& ws, 3));
                    pr.globals.push(GlobalEntry_new(w1, gty, Expr::IntLit(gv)));
                } else if w0 == "before" {
                    pr.side = 0;
                } else if w0 == "after" {
                    pr.side = 1;
                } else if w0 != "end" {
                    tvp_err(& mut p, "not a line of a pair: '" + w0 + "'");
                }
                p.at = p.at + 1;
            }
        }
    }
    if open {
        tvp_finish(src, & pr, p.err, each, counts);
    }
}

/// Run the pairs of `path`: a .tvp file, or every .tvp file of a
/// directory. Prints "tv pairs: N pairs, M as expected" on stderr (with
/// `each` a line per pair before it) and returns the number not as
/// expected (a file that cannot be read counts as one).
pub fn tv_pairs_run(path: str, each: bool) -> i64 {
    var files: Vec<str> = Vec::new();
    if str_ends_with(path, ".tvp") {
        files.push(path);
    } else {
        var listing: str = p_dir_list(path);
        if (listing as i64) != 0 {
            var names: Vec<str> = str_split(listing, "\n");
            var i: i64 = 0;
            while i < names.len() {
                var nm: str = str_trim(names.get(i));
                if str_ends_with(nm, ".tvp") {
                    files.push(path + "/" + nm);
                }
                i = i + 1;
            }
        }
    }
    var counts: Vec<i64> = Vec::new();
    counts.push(0);
    counts.push(0);
    var unread: i64 = 0;
    if files.len() == 0 {
        p_eprint_str("tv pairs: no .tvp file in " + path + "\n");
        unread = 1;
    }
    var k: i64 = 0;
    while k < files.len() {
        match read_file(files.get(k)) {
            Option::Some(text) => {
                tv_pairs_text(files.get(k), text, each, & mut counts);
            }
            Option::None => {
                p_eprint_str("tv pairs: cannot read " + files.get(k) + "\n");
                unread = unread + 1;
            }
        }
        k = k + 1;
    }
    p_eprint_str("tv pairs: " + int_to_str(counts.get(0)) + " pairs, " + int_to_str(counts.get(1)) + " as expected\n");
    return counts.get(0) - counts.get(1) + unread;
}
