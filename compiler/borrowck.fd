// borrowck.fd -- Borrow checker for Fides, rewritten from src/borrowck.rs (1221 LOC)
//
// Runs as a separate pass AFTER typechecking succeeds and BEFORE comptime
// substitution / monomorphization. Catches three classes of bugs at zero
// runtime cost:
//
// 1. Creating &mut x while any borrow (& or &mut) on x is active.
// 2. Creating &x while &mut x is active.
// 3. Mutating x (assign, index-assign, deref-assign, method call on x)
//    while any borrow on x is active.
//
// unsafe { ... } blocks skip all checks (reuses the same escape hatch as
// raw pointers).
//
// Borrows end lexically: when the borrower goes out of scope or is
// reassigned. NLL (non-lexical lifetimes) releases borrows at the borrower's
// last use rather than at scope end.
//
// Adaptations from Rust:
// 1. HashMap<K,V> -> Vec-based maps with helper structs (Fides HashMap is i64->i64)
// 2. HashSet<T> -> Vec<T> with contains() helper
// 3. String -> str, usize -> i64
// 4. Option<T> -> OptStr / custom Opt enums
// 5. Box<Expr> auto-unboxes in match patterns
// 6. format! -> string concatenation with int_to_str
// 7. .clone() -> not needed (Fides values are copied by value)
// 8. matches! macro -> explicit match with _ => false
// 9. No module-level mutable state -> mode passed as parameter / stored in struct
//
// Dependencies: compiler::ast

module compiler::borrowck;
use core;
use vec;
use string;
use compiler::ast;
use compiler::escape;
// --- Vec-based map entry structs ------------------------------------------
// These replace HashMap<String, T> with Vec<Entry> + linear search.

// shared_borrows: var -> set of borrowers (Vec<str>)
pub struct SharedBorrowEntry {
    pub key: str,
    pub borrowers: Vec<str>,
}

pub fn SharedBorrowEntry_new(key: str) -> SharedBorrowEntry {
    return SharedBorrowEntry {
        key: key, borrowers: Vec::new()
    };
}

// mut_borrow: var -> optional single borrower
pub struct MutBorrowEntry {
    pub key: str,
    pub borrower: OptStr,
}

pub fn MutBorrowEntry_new(key: str, borrower: OptStr) -> MutBorrowEntry {
    return MutBorrowEntry {
        key: key, borrower: borrower
    };
}

// borrow_of: borrower -> (borrowed_var, is_mut, line the borrow was made on)
pub struct BorrowOfEntry {
    pub borrower: str,
    pub borrowed: str,
    pub is_mut: bool,
    pub line: i64,
}

pub fn BorrowOfEntry_new(borrower: str, borrowed: str, is_mut: bool, line: i64) -> BorrowOfEntry {
    return BorrowOfEntry {
        borrower: borrower, borrowed: borrowed, is_mut: is_mut, line: line
    };
}

// reserved_mut_borrows: Vec<(path, borrower, line)>
pub struct ReservedMutBorrow {
    pub path: str,
    pub borrower: str,
    pub line: i64,
}

pub fn ReservedMutBorrow_new(path: str, borrower: str, line: i64) -> ReservedMutBorrow {
    return ReservedMutBorrow {
        path: path, borrower: borrower, line: line
    };
}

// last_use: var -> last statement index
pub struct StringI64Entry {
    pub key: str,
    pub val: i64,
}

pub fn StringI64Entry_new(key: str, val: i64) -> StringI64Entry {
    return StringI64Entry {
        key: key, val: val
    };
}

// Wrapper for Vec<str> to avoid Vec<Vec<str>> >> parse issue
pub struct StringVec {
    pub items: Vec<str>,
}

pub fn StringVec_new() -> StringVec {
    return StringVec {
        items: Vec::new()
    };
}

// --- Box unbox helper ----------------------------------------------------
// Fides match patterns on Box<Expr> auto-unbox for matching, but the extracted
// fields are still Box<Expr>. This helper converts Box<Expr> back to Expr
// for passing to functions that expect unboxed values.

pub fn bc_box_expr_unbox(b: Box<Expr>) -> Expr {
    match b {
        Expr::IntLit(v) => {
            return Expr::IntLit(v);
        }
        Expr::FloatLit(v) => {
            return Expr::FloatLit(v);
        }
        Expr::StringLit(v) => {
            return Expr::StringLit(v);
        }
        Expr::BoolLit(v) => {
            return Expr::BoolLit(v);
        }
        Expr::Ident(n) => {
            return Expr::Ident(n);
        }
        Expr::Binary(op, l, r) => {
            return Expr::Binary(op, l, r);
        }
        Expr::Unary(op, e) => {
            return Expr::Unary(op, e);
        }
        Expr::Call(c, args) => {
            return Expr::Call(c, args);
        }
        Expr::FieldAccess(e, f) => {
            return Expr::FieldAccess(e, f);
        }
        Expr::OptionalFieldAccess(e, f) => {
            return Expr::OptionalFieldAccess(e, f);
        }
        Expr::StructLit(n, fields, spread) => {
            return Expr::StructLit(n, fields, spread);
        }
        Expr::If(c, t, e) => {
            return Expr::If(c, t, e);
        }
        Expr::Range(s, e, inclusive) => {
            return Expr::Range(s, e, inclusive);
        }
        Expr::Block(stmts) => {
            return Expr::Block(stmts);
        }
        Expr::MethodCall(recv, m, args) => {
            return Expr::MethodCall(recv, m, args);
        }
        Expr::ArrayLit(et, elems) => {
            return Expr::ArrayLit(et, elems);
        }
        Expr::Index(arr, idx) => {
            return Expr::Index(arr, idx);
        }
        Expr::FString(parts) => {
            return Expr::FString(parts);
        }
        Expr::Match(e, arms) => {
            return Expr::Match(e, arms);
        }
        Expr::EnumLit(en, vn, args) => {
            return Expr::EnumLit(en, vn, args);
        }
        Expr::Ref(e, is_mut) => {
            return Expr::Ref(e, is_mut);
        }
        Expr::Deref(e) => {
            return Expr::Deref(e);
        }
        Expr::StrConcat(l, r) => {
            return Expr::StrConcat(l, r);
        }
        Expr::Try(e) => {
            return Expr::Try(e);
        }
        Expr::Coalesce(e, d) => {
            return Expr::Coalesce(e, d);
        }
        Expr::IsCheck(e, t) => {
            return Expr::IsCheck(e, t);
        }
        Expr::TryBlock(body) => {
            return Expr::TryBlock(body);
        }
        Expr::TupleLit(elems) => {
            return Expr::TupleLit(elems);
        }
        Expr::Closure(p, b, r) => {
            return Expr::Closure(p, b, r);
        }
        Expr::Cast(e, ty) => {
            return Expr::Cast(e, ty);
        }
        Expr::Asm(s, ops) => {
            return Expr::Asm(s, ops);
        }
        Expr::Comptime(e) => {
            return Expr::Comptime(e);
        }
        Expr::ComptimeBlock(s) => {
            return Expr::ComptimeBlock(s);
        }
        Expr::ComptimeReflect(op, ty) => {
            return Expr::ComptimeReflect(op, ty);
        }
        Expr::PipeForward(l, r) => {
            return Expr::PipeForward(l, r);
        }
        Expr::QuantCast(e, ty) => {
            return Expr::QuantCast(e, ty);
        }
        Expr::Await(e) => {
            return Expr::Await(e);
        }
        Expr::Spawn(e) => {
            return Expr::Spawn(e);
        }
        Expr::Yield(e) => {
            return Expr::Yield(e);
        }
        Expr::NamedArg(name, e) => {
            return Expr::NamedArg(name, e);
        }
    }
    return Expr::IntLit(0);
}

// --- BorrowckMode ---------------------------------------------------------
// Borrow checker mode, controlled by --borrowck=off|warn|on.
// 0 = Off, 1 = Warn, 2 = On. Default is 2 (On).

pub enum BorrowckMode {
    Off,
    Warn,
    On,
}

// Parse from a string (used by CLI flag --borrowck=...).
pub fn borrowck_mode_parse(s: str) -> OptBorrowckMode {
    var lower: str = str_to_lower(s);
    if lower == "off" {
        return OptBorrowckMode::Some(BorrowckMode::Off);
    }
    if lower == "0" {
        return OptBorrowckMode::Some(BorrowckMode::Off);
    }
    if lower == "no" {
        return OptBorrowckMode::Some(BorrowckMode::Off);
    }
    if lower == "warn" {
        return OptBorrowckMode::Some(BorrowckMode::Warn);
    }
    if lower == "warning" {
        return OptBorrowckMode::Some(BorrowckMode::Warn);
    }
    if lower == "w" {
        return OptBorrowckMode::Some(BorrowckMode::Warn);
    }
    if lower == "on" {
        return OptBorrowckMode::Some(BorrowckMode::On);
    }
    if lower == "1" {
        return OptBorrowckMode::Some(BorrowckMode::On);
    }
    if lower == "yes" {
        return OptBorrowckMode::Some(BorrowckMode::On);
    }
    if lower == "err" {
        return OptBorrowckMode::Some(BorrowckMode::On);
    }
    if lower == "error" {
        return OptBorrowckMode::Some(BorrowckMode::On);
    }
    return OptBorrowckMode::None;
}

pub enum OptBorrowckMode {
    Some(BorrowckMode),
    None,
}

// --- BorrowChecker struct -------------------------------------------------
// Holds maps that together encode the borrow state of every variable in the
// current function.

pub struct BorrowChecker {
    // var -> set of variables currently holding a shared borrow (&x) of it.
    pub shared_borrows: Vec<SharedBorrowEntry>,

    // var -> the single variable currently holding a mutable borrow (&mut x).
    // OptStr::None means no active mutable borrow.
    pub mut_borrow: Vec<MutBorrowEntry>,

    // borrower -> (borrowed_var, is_mut). Used to release a borrow when the
    // borrower goes out of scope or is reassigned.
    pub borrow_of: Vec<BorrowOfEntry>,

    // Stack of scopes; each scope is the set of variable names declared in it.
    // On scope pop, all borrows held by names in that scope are released.
    pub scope_stack: Vec<StringVec>,

    // Current unsafe { ... } nesting depth. When > 0, all checks are skipped.
    pub unsafe_depth: i64,

    // Current function name (for error messages).
    pub current_func: OptStr,

    // Counter for synthetic temporary borrower names (e.g. __tmp_ref_0).
    pub temp_counter: i64,

    // Line of the statement being checked (expressions carry none).
    pub stmt_line: i64,

    // Stack of checkpoints -- each records temp_counter at the start of a
    // Call/MethodCall. After the call, all temps >= checkpoint are released.
    pub temp_checkpoints: Vec<i64>,

    // Phase 4: Two-phase borrow support. Reserved &mut borrows.
    pub reserved_mut_borrows: Vec<ReservedMutBorrow>,

    // Phase 4: When true, &mut borrows are collected as "reserved" instead
    // of immediately activated.
    pub in_reservation_phase: bool,

    // Phase 6: NLL. Maps each variable name to the last statement index.
    // dead_at[i]: borrowers to release once stmt_index reaches i. Lets
    // release_dead_borrows check one bucket per statement instead of
    // scanning every live borrow (CS3: was stmts x borrows quadratic).
    pub dead_at: Vec<StringVec>,
    pub last_use: Vec<StringI64Entry>,
    // name -> index in last_use + 1 (release D8: the lists were searched by
    // name on every statement, quadratic in the size of a function)
    pub last_use_index: i64,
    // CS3: eagerly-maintained indexes. Vec entries are tombstoned instead
    // of removed (clear borrowers / OptStr::None / borrower == ""), so
    // positions never shift and these maps never go stale inside a
    // function. They are rebuilt cheaply by .clear() at function start.
    pub sb_ix: i64,
    // key -> shared_borrows index + 1
    pub mb_ix: i64,
    // key -> mut_borrow index + 1
    pub bo_ix: i64,
    // borrower -> borrow_of index + 1
    // Prefix -> count of live borrowers on that path or any path under it
    // (key "x.y.z" counts toward "x.y.z", "x.y" and "x"). Turns the
    // inclusive queries from scans into one lookup each.
    pub sb_pfx: i64,
    pub mb_pfx: i64,
    // Variables a `for` loop is iterating over, innermost last (release K4):
    // changing one inside the loop body is an error
    pub iterating: Vec<str>,
    // Functions not to check: "fn:name", "impl:Type:method" (core, when an
    // earlier build checked this same core clean; release D9). 0 = none.
    pub skip_bodies: i64,

    // Phase 6: Current statement index within the function body.
    pub stmt_index: i64,

    // Collected errors (only populated in On mode; Warn uses warnings).
    pub errors: Vec<str>,

    // Collected warnings (populated in Warn mode).
    pub warnings: Vec<str>,

    // Active mode -- controls whether violations become errors or warnings.
    pub mode: BorrowckMode,

    // CS5: a worker of the parallel check reads the LG3 tables from copies
    // of its own (par_lt: lt_ties and lt_self_mut, made by the worker from
    // g_bc_lt_ties and g_bc_lt_self_mut); the sequential check reads those.
    pub par_lt: bool,
    pub lt_ties: Vec<Vec<i64>>,
    pub lt_self_mut: Vec<bool>,
    // LG3: a `&mut` passed on (`val m = &mut a; val r = f(m)`): mh_to[i]
    // took over the mutable borrow mh_from[i] held, which gets it back if
    // mh_to[i] ends first (bc_hand_over_mut, release_borrow_one)
    pub mh_to: Vec<str>,
    pub mh_from: Vec<str>,
    // LG3: some borrower holds further borrows under `name#k` (bc_tie_borrow),
    // so release_borrow_by looks for them
    pub alias_seen: bool,
    // LG3: HashMap name -> 1 for the variables bound to a reference
    // (`val q = &a`): a method called on one borrows what it points to,
    // not the variable (bc_record_method_borrow)
    pub ref_vars: i64,
}

/// Free the borrow checker's index maps (raw handles) once checked.
pub fn BorrowChecker_free_maps(self: &mut BorrowChecker) {
    HashMap_drop(self.last_use_index);
    self.last_use_index = HashMap_new();
    HashMap_drop(self.sb_ix);
    self.sb_ix = HashMap_new();
    HashMap_drop(self.mb_ix);
    self.mb_ix = HashMap_new();
    HashMap_drop(self.bo_ix);
    self.bo_ix = HashMap_new();
    HashMap_drop(self.sb_pfx);
    self.sb_pfx = HashMap_new();
    HashMap_drop(self.mb_pfx);
    self.mb_pfx = HashMap_new();
    HashMap_drop(self.ref_vars);
    self.ref_vars = HashMap_new();
}

pub fn BorrowChecker_new(mode: BorrowckMode) -> BorrowChecker {
    var scope: StringVec = StringVec_new();
    var scope_stack: Vec<StringVec> = Vec::new();
    scope_stack.push(scope);
    return BorrowChecker {
        shared_borrows: Vec::new(), mut_borrow: Vec::new(), borrow_of: Vec::new(), scope_stack: scope_stack, unsafe_depth: 0, current_func: OptStr::None, temp_counter: 0, stmt_line: 0, temp_checkpoints: Vec::new(), reserved_mut_borrows: Vec::new(), in_reservation_phase: false, dead_at: Vec::new(), last_use: Vec::new(), last_use_index: HashMap_new(), sb_ix: HashMap_new(), mb_ix: HashMap_new(), bo_ix: HashMap_new(), sb_pfx: HashMap_new(), mb_pfx: HashMap_new(), iterating: Vec::new(), skip_bodies: 0, stmt_index: 0, errors: Vec::new(), warnings: Vec::new(), mode: mode, par_lt: false, lt_ties: Vec::new(), lt_self_mut: Vec::new(), mh_to: Vec::new(), mh_from: Vec::new(), alias_seen: false, ref_vars: HashMap_new(),
    };
}

// --- Check entry points ---------------------------------------------------

// CS5: worker count for the parallel borrow check. FID_PAR=N opts in;
// default 1 keeps the sequential path (also the only path when warnings
// must be collected, and on backends where spawn is a green task there is
// no speedup but the code stays correct).
// The units a parallel check walks, shared read-only with the workers for
// the duration of the spawn/await block: spawn arguments must be @send and
// Vec<Func> is not, so the worker receives only chunk bounds.
pub var g_bc_units: Vec<Func> = Vec::new();
pub fn bc_par_workers() -> i64 {
    var r: i64 = p_getenv("FID_PAR");
    if r == 0 {
        return 1;
    }
    var s: str = p_str_adopt(r);
    var n: i64 = 0;
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c < 48 || c > 57 {
            return 1;
        }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    if n < 1 {
        return 1;
    }
    if n > 16 {
        return 16;
    }
    return n;
}

// Worker for the parallel borrow check (CS5). A spawned worker checks a
// contiguous chunk of functions with its own BorrowChecker; concatenating
// the chunks' results in order reproduces the sequential diagnostic order
// exactly. Owner counts are not atomic, so no two threads may copy or drop
// the same Vec or string (escape.fd "Parallel reporting pass"): a worker
// reads the LG3 tables from copies of its own (made here; the globals are
// only read), passes its units to check_func without keeping them, and the
// chunks never split an impl block or the trait impls (par_chunk_bounds),
// the only places where two functions' ASTs share pieces.
pub fn bc_par_worker(s: i64, e: i64) -> Vec<str> {
    var bc: BorrowChecker = BorrowChecker_new(BorrowckMode::On);
    bc.lt_ties = par_own_i64ss(g_bc_lt_ties);
    bc.lt_self_mut = par_own_bools(g_bc_lt_self_mut);
    bc.par_lt = true;
    var i: i64 = s;
    while i < e {
        check_func(&mut bc, g_bc_units.get(i));
        i = i + 1;
    }
    var out: Vec<str> = bc.errors;
    BorrowChecker_free_maps(&mut bc);
    return out;
}

// LG3: function name -> index + 1 into g_bc_lt_ties (0: not built yet), and
// for each such function the parameters its result borrows from by its
// signature (`fn f<'a>(x: &'a T, y: &T) -> &'a T`: [0]). Module globals,
// so the parallel workers of check() read them as they read g_bc_units.
var g_bc_lt_index: i64 = 0;
var g_bc_lt_ties: Vec<Vec<i64>> = Vec::new();
// LG3: for each entry of g_bc_lt_ties, whether parameter 0 is `&mut` (a
// method's receiver is borrowed the way its `self` is), and whether any
// entry ties more than one parameter (then a borrower can hold several
// borrows: `r`, `r#1`, `r#2`, ..., released together by release_borrow_by).
var g_bc_lt_self_mut: Vec<bool> = Vec::new();
var g_bc_lt_multi: bool = false;
// LG3: method name -> 1 when every user method of that name (impls, trait
// impls, trait declarations) takes its receiver as `&` or by value, so a
// call only reads it; 2 when one takes `&mut self` (bc_user_read_method).
// Struct name -> 1 for a struct with lifetime parameters
// (`struct View<'a> { r: &'a i64 }`): its values hold references.
// Built once before the walk; the parallel workers only read them.
var g_bc_meth_kind: i64 = 0;
var g_bc_lt_structs: i64 = 0;

/// LG3: the parameters entry `k` of g_bc_lt_ties ties; a parallel worker
/// reads its own copy (CS5).
fn bc_lt_ties_at(self: &BorrowChecker, k: i64) -> Vec<i64> {
    if self.par_lt {
        return self.lt_ties.get(k);
    }
    return g_bc_lt_ties.get(k);
}

fn bc_lt_self_mut_at(self: &BorrowChecker, k: i64) -> bool {
    if self.par_lt {
        return self.lt_self_mut.get(k);
    }
    return g_bc_lt_self_mut.get(k);
}

/// LG3: the parameters `f`'s result borrows from. With lifetimes, those its
/// signature ties (`func_lifetime_ties`); without lifetimes, a result of
/// reference type may borrow from any reference parameter (the escape check
/// infers which; the borrow checker takes all of them, which is sound).
/// Empty: the result borrows nothing.
pub fn bc_sig_ties(f: Func) -> Vec<i64> {
    if func_has_lifetimes(f) {
        return func_lifetime_ties(f);
    }
    return bc_elided_ties(f.params, f.ret_ty);
}

/// LG3: the same for a trait's method declaration (its `@lifetime`
/// annotations, or every reference parameter without them).
fn bc_trait_sig_ties(tm: TraitMethod) -> Vec<i64> {
    if ann_lifetimes(tm.annotations).len() > 0 {
        return trait_method_lifetime_ties(tm);
    }
    return bc_elided_ties(tm.params, tm.ret_ty);
}

/// A signature without lifetimes: a result holding a reference may borrow
/// from every parameter holding one.
fn bc_elided_ties(params: Vec<Param>, ret_ty: Type) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if !bc_is_ref_type(ret_ty) {
        return out;
    }
    var i: i64 = 0;
    while i < params.len() {
        if bc_is_ref_type(params.get(i).ty) {
            out.push(i);
        }
        i = i + 1;
    }
    return out;
}

/// A reference, or a value of a struct with lifetime parameters (it holds
/// references: `View<'a>`).
fn bc_is_ref_type(t: Type) -> bool {
    match t {
        Type::Ref(_, _) => {
            return true;
        }
        Type::Named(n) => {
            return g_bc_lt_structs != 0 && HashMap_get(g_bc_lt_structs, n) != 0;
        }
        Type::Generic(gn, _) => {
            return g_bc_lt_structs != 0 && HashMap_get(g_bc_lt_structs, gn) != 0;
        }
        _ => {
            return false;
        }
    }
}

/// LG3: method name -> 1 (reads its receiver) or 2 (`&mut self`), for
/// `f` with a `self` first parameter; the strongest kind wins.
fn bc_meth_kind_add(name: str, params: Vec<Param>) {
    if params.len() == 0 {
        return;
    }
    if params.get(0).name != "self" {
        return;
    }
    var kind: i64 = 1;
    match params.get(0).ty {
        Type::Ref(_, m) => {
            if m {
                kind = 2;
            }
        }
        _ => {
        }
    }
    if HashMap_get(g_bc_meth_kind, name) < kind {
        HashMap_insert(g_bc_meth_kind, name, kind);
    }
}

/// Builtin methods that change their receiver: a user method of the same
/// name taking `&self` does not make `v.push(x)` on a Vec a read.
fn bc_builtin_mut_method(m: str) -> bool {
    return m == "push" || m == "pop" || m == "set" || m == "insert" || m == "remove" || m == "clear" || m == "extend" || m == "append" || m == "truncate" || m == "sort" || m == "sort_by" || m == "reverse" || m == "swap" || m == "drain" || m == "retain" || m == "push_str" || m == "push_back" || m == "push_front" || m == "pop_back" || m == "pop_front" || m == "resize" || m == "dedup" || m == "fill" || m == "reserve" || m == "take" || m == "replace" || m == "get_mut" || m == "iter_mut" || m == "split_off" || m == "shrink_to_fit" || m == "write" || m == "set_len";
}

/// LG3: whether `recv.m(..)` only reads `recv` because every user method
/// called `m` takes `self` as `&` or by value (a struct value is a copy).
fn bc_user_read_method(m: str) -> bool {
    if g_bc_meth_kind == 0 || bc_builtin_mut_method(m) {
        return false;
    }
    return HashMap_get(g_bc_meth_kind, m) == 1;
}

fn bc_param0_mut(f: Func) -> bool {
    if f.params.len() == 0 {
        return false;
    }
    match f.params.get(0).ty {
        Type::Ref(_, m) => {
            return m;
        }
        _ => {
            return false;
        }
    }
}

/// Record `key` -> ties. A key seen before (one method name in several
/// impls: the borrow checker does not know the receiver's type) gets the
/// union of the ties, which over-approximates each.
fn bc_lt_add(key: str, ties: Vec<i64>, self_mut: bool) {
    if ties.len() == 0 {
        return;
    }
    if ties.len() > 1 {
        g_bc_lt_multi = true;
    }
    var slot: i64 = HashMap_get(g_bc_lt_index, key);
    if slot == 0 {
        g_bc_lt_ties.push(ties);
        g_bc_lt_self_mut.push(self_mut);
        HashMap_insert(g_bc_lt_index, key, g_bc_lt_ties.len());
        return;
    }
    var old: Vec<i64> = g_bc_lt_ties.get(slot - 1);
    var merged: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < old.len() {
        merged.push(old.get(k));
        k = k + 1;
    }
    var i: i64 = 0;
    while i < ties.len() {
        var t: i64 = ties.get(i);
        var have: bool = false;
        var j: i64 = 0;
        while j < merged.len() {
            if merged.get(j) == t {
                have = true;
            }
            j = j + 1;
        }
        if !have {
            merged.push(t);
        }
        i = i + 1;
    }
    if merged.len() > 1 {
        g_bc_lt_multi = true;
    }
    g_bc_lt_ties.set(slot - 1, merged);
    if self_mut {
        g_bc_lt_self_mut.set(slot - 1, true);
    }
}

fn bc_collect_lifetime_ties(program: Program) {
    if g_bc_lt_index == 0 {
        g_bc_lt_index = HashMap_new();
    } else {
        HashMap_clear(g_bc_lt_index);
    }
    g_bc_lt_ties = Vec::new();
    g_bc_lt_self_mut = Vec::new();
    g_bc_lt_multi = false;
    if g_bc_meth_kind == 0 {
        g_bc_meth_kind = HashMap_new();
    } else {
        HashMap_clear(g_bc_meth_kind);
    }
    if g_bc_lt_structs == 0 {
        g_bc_lt_structs = HashMap_new();
    } else {
        HashMap_clear(g_bc_lt_structs);
    }
    // Structs with lifetime parameters first: bc_sig_ties counts their
    // values as holding references
    var si: i64 = 0;
    while si < program.structs.len() {
        var sd: StructDef = program.structs.get(si);
        if ann_lifetimes(sd.annotations).len() > 0 {
            HashMap_insert(g_bc_lt_structs, sd.name, 1);
            // a literal holding several references: `v`, `v#1`, ...
            g_bc_lt_multi = true;
        }
        si = si + 1;
    }
    var i: i64 = 0;
    while i < program.funcs.len() {
        var f: Func = program.funcs.get(i);
        if HashMap_get(g_bc_lt_index, f.name) == 0 {
            bc_lt_add(f.name, bc_sig_ties(f), bc_param0_mut(f));
        }
        i = i + 1;
    }
    // Methods: `recv.m(args)` under ".m" (parameter 0 is the receiver), and
    // `Type_m(&recv, args)` under the name a method is called by as a function
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var m: Func = imp.methods.get(mi);
            var ties: Vec<i64> = bc_sig_ties(m);
            var smut: bool = bc_param0_mut(m);
            bc_meth_kind_add(m.name, m.params);
            bc_lt_add("." + m.name, ties, smut);
            if HashMap_get(g_bc_lt_index, imp.struct_name + "_" + m.name) == 0 {
                bc_lt_add(imp.struct_name + "_" + m.name, ties, smut);
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    // Trait-impl methods: a call through the trait reaches one of them, so
    // ".m" holds the union over every implementation
    var ti: i64 = 0;
    while ti < program.trait_impls.len() {
        var timp: TraitImpl = program.trait_impls.get(ti);
        var tm: i64 = 0;
        while tm < timp.methods.len() {
            var m2: Func = timp.methods.get(tm);
            bc_meth_kind_add(m2.name, m2.params);
            bc_lt_add("." + m2.name, bc_sig_ties(m2), bc_param0_mut(m2));
            tm = tm + 1;
        }
        ti = ti + 1;
    }
    // Trait declarations: a call through `dyn Tr` (or a default method)
    // reaches an impl the program may not contain; the trait's signature
    // (its lifetimes, which every impl's must stay within) covers it
    var tdi: i64 = 0;
    while tdi < program.traits.len() {
        var td: TraitDef = program.traits.get(tdi);
        var tmi: i64 = 0;
        while tmi < td.methods.len() {
            var tmeth: TraitMethod = td.methods.get(tmi);
            var tsm: bool = false;
            if tmeth.params.len() > 0 {
                match tmeth.params.get(0).ty {
                    Type::Ref(_, rm) => {
                        tsm = rm;
                    }
                    _ => {
                    }
                }
            }
            bc_meth_kind_add(tmeth.name, tmeth.params);
            bc_lt_add("." + tmeth.name, bc_trait_sig_ties(tmeth), tsm);
            tmi = tmi + 1;
        }
        tdi = tdi + 1;
    }
}

/// LG3: the borrow number `count` of `name`: `name` itself for the first,
/// `name#k` for each further one (released with `name`).
fn bc_alias(name: str, count: i64) -> str {
    if count == 0 {
        return name;
    }
    return name + "#" + int_to_str(count);
}

/// LG3: the borrows `n` holds: its own and those of `n#1`, `n#2`, ...
fn bc_held_borrows(self: &BorrowChecker, n: str) -> Vec<BorrowOfEntry> {
    var out: Vec<BorrowOfEntry> = Vec::new();
    var bi: i64 = HashMap_get(self.bo_ix, n);
    if bi > 0 {
        out.push(self.borrow_of.get(bi - 1));
    }
    if g_bc_lt_multi || self.alias_seen {
        var k: i64 = 1;
        var ai: i64 = HashMap_get(self.bo_ix, n + "#1");
        while ai > 0 {
            out.push(self.borrow_of.get(ai - 1));
            k = k + 1;
            ai = HashMap_get(self.bo_ix, n + "#" + int_to_str(k));
        }
    }
    return out;
}

/// LG3: `name` borrows `path` too, as its borrow number `count`.
fn bc_tie_borrow(self: &mut BorrowChecker, name: str, path: str, is_mut: bool, count: i64, line: i64) -> void {
    if count > 0 {
        self.alias_seen = true;
    }
    create_borrow(self, path, bc_alias(name, count), is_mut, line);
}

/// LG3: `who` takes over the mutable borrow of `path` that `holder` holds:
/// a `&mut` passed on (`val m = &mut a; val r = f(m)`). While `who` lives,
/// `path` stays mutably borrowed, also after `holder`'s last use; when `who`
/// ends first and `holder` still lives, the borrow goes back to `holder`
/// (release_borrow_one).
fn bc_hand_over_mut(self: &mut BorrowChecker, who: str, holder: str, path: str, line: i64) -> void {
    mut_borrow_set(self, path, OptStr::Some(who));
    borrow_of_add(self, who, path, true, line);
    self.mh_to.push(who);
    self.mh_from.push(holder);
}

/// LG3: `name` borrows, from its borrow number `count` on, what variable
/// `holder` borrows: shared borrows are shared again, a mutable one is
/// handed over. Returns the next borrow number.
fn bc_pass_on(self: &mut BorrowChecker, name: str, holder: str, count: i64, line: i64) -> i64 {
    var c: i64 = count;
    if holder == name {
        return c;
    }
    var held: Vec<BorrowOfEntry> = bc_held_borrows(self, holder);
    var i: i64 = 0;
    while i < held.len() {
        var be: BorrowOfEntry = held.get(i);
        if be.is_mut {
            if c > 0 {
                self.alias_seen = true;
            }
            bc_hand_over_mut(self, bc_alias(name, c), be.borrower, be.borrowed, line);
        } else {
            bc_tie_borrow(self, name, be.borrowed, false, c, line);
        }
        c = c + 1;
        i = i + 1;
    }
    return c;
}

/// LG3: `name` (from its borrow number `count` on) borrows what the value
/// `e` tied to it borrows: `&path` / `&mut path` that path, and what `path`
/// itself borrows when it is a variable holding borrows (`f(&view)` with
/// `view` a struct holding a reference); a variable holding borrows passes
/// them on (`val q = &a; val r = f(q)`: r borrows a; a `&mut` one is handed
/// over). Returns the next borrow number.
fn bc_tie_one(self: &mut BorrowChecker, name: str, e: Expr, count: i64, line: i64) -> i64 {
    var c: i64 = count;
    match e {
        Expr::Ref(inner, m) => {
            var ie: Expr = bc_box_expr_unbox(inner);
            match extract_field_path(ie) {
                OptStr::Some(path) => {
                    bc_tie_borrow(self, name, path, m, c, line);
                    c = c + 1;
                }
                OptStr::None => {
                }
            }
            match ie {
                Expr::Ident(iv) => {
                    c = bc_pass_on(self, name, iv, c, line);
                }
                _ => {
                }
            }
        }
        Expr::Ident(n) => {
            c = bc_pass_on(self, name, n, c, line);
        }
        _ => {
        }
    }
    return c;
}

/// LG3: `val name = recv.method(args)`: the receiver is parameter 0, the
/// arguments parameters 1... A receiver written as a path is borrowed the
/// way the method's `self` is (`&mut self`: mutably); a receiver holding
/// borrows passes them on too. A receiver that is itself a reference
/// (`val q = &a; q.m()`) passes on what it points to and is not borrowed
/// itself: the result points where `q` does.
fn bc_record_method_borrow(self: &mut BorrowChecker, name: str, recv: Expr, method: str, args: Vec<Expr>, line: i64) -> void {
    if self.unsafe_depth > 0 || g_bc_lt_index == 0 {
        return;
    }
    var slot: i64 = HashMap_get(g_bc_lt_index, "." + method);
    if slot == 0 {
        return;
    }
    var ties: Vec<i64> = bc_lt_ties_at(self, slot - 1);
    var count: i64 = 0;
    var t: i64 = 0;
    while t < ties.len() {
        var ai: i64 = ties.get(t);
        if ai == 0 {
            match recv {
                Expr::Ref(_, _) => {
                    count = bc_tie_one(self, name, recv, count, line);
                }
                Expr::Ident(rn) => {
                    if HashMap_get(self.ref_vars, rn) == 0 {
                        bc_tie_borrow(self, name, rn, bc_lt_self_mut_at(self, slot - 1), count, line);
                        count = count + 1;
                    }
                    count = bc_pass_on(self, name, rn, count, line);
                }
                _ => {
                    match extract_field_path(recv) {
                        OptStr::Some(path) => {
                            bc_tie_borrow(self, name, path, bc_lt_self_mut_at(self, slot - 1), count, line);
                            count = count + 1;
                        }
                        OptStr::None => {
                        }
                    }
                }
            }
        } else if ai - 1 < args.len() {
            count = bc_tie_one(self, name, args.get(ai - 1), count, line);
        }
        t = t + 1;
    }
}

// `val name = callee(args)` where callee's result borrows from parameters
// (bc_sig_ties: its lifetimes, or every reference parameter when it has
// none): name borrows what each such argument borrows (bc_tie_one), so
// changing any of them while name is live is the error it is for
// `val r = &a`.
fn bc_record_call_borrow(self: &mut BorrowChecker, name: str, callee: str, args: Vec<Expr>, line: i64) -> void {
    if self.unsafe_depth > 0 || g_bc_lt_index == 0 {
        return;
    }
    var slot: i64 = HashMap_get(g_bc_lt_index, callee);
    if slot == 0 {
        return;
    }
    var ties: Vec<i64> = bc_lt_ties_at(self, slot - 1);
    var count: i64 = 0;
    var t: i64 = 0;
    while t < ties.len() {
        var ai: i64 = ties.get(t);
        if ai < args.len() {
            count = bc_tie_one(self, name, args.get(ai), count, line);
        }
        t = t + 1;
    }
}

/// LG3: `val name = S { f: &a, g: q, .. }` for a struct with lifetime
/// parameters: name borrows what each field value borrows (bc_tie_one).
fn bc_record_struct_borrow(self: &mut BorrowChecker, name: str, sname: str, fields: Vec<FieldInit>, line: i64) -> void {
    if self.unsafe_depth > 0 || g_bc_lt_structs == 0 {
        return;
    }
    if HashMap_get(g_bc_lt_structs, sname) == 0 {
        return;
    }
    var count: i64 = 0;
    var i: i64 = 0;
    while i < fields.len() {
        count = bc_tie_one(self, name, fields.get(i).value, count, line);
        i = i + 1;
    }
}

/// LG3: `base.f = e` where `e` is `&path` or a variable holding borrows:
/// base (a struct with lifetime parameters, or the escape check rejects the
/// store) borrows that too, under its next borrow number. The `&path`'s
/// temporary borrow made by check_expr is released first.
fn bc_record_field_borrow(self: &mut BorrowChecker, base: str, e: Expr, line: i64) -> void {
    var holds: bool = false;
    match e {
        Expr::Ref(inner, _) => {
            match extract_field_path(bc_box_expr_unbox(inner)) {
                OptStr::Some(_) => {
                    holds = true;
                    if self.temp_counter > 0 {
                        var last_temp: str = "__tmp_ref_" + int_to_str(self.temp_counter - 1);
                        release_borrow_by(self, last_temp);
                        scope_stack_remove_name(self, last_temp);
                        self.temp_counter = self.temp_counter - 1;
                    }
                }
                OptStr::None => {
                }
            }
        }
        Expr::Ident(_) => {
            holds = true;
        }
        _ => {
        }
    }
    if !holds {
        return;
    }
    var count: i64 = 0;
    if HashMap_get(self.bo_ix, base) > 0 {
        count = 1;
        while HashMap_get(self.bo_ix, base + "#" + int_to_str(count)) > 0 {
            count = count + 1;
        }
    }
    bc_tie_one(self, base, e, count, line);
}

// Check an entire program. Walks every function and impl method body.
pub fn check(self: &mut BorrowChecker, program: Program) -> void {
    // Skip entirely when borrow checking is off -- the full analysis walks
    // every statement with O(n) linear searches and is extremely slow on
    // large programs (e.g. the stdlib). In Off mode, violations are already
    // no-ops, so skipping the walk is safe.
    match self.mode {
        BorrowckMode::Off => {
            return;
        }
        _ => {
        }
    }

    // LG3: functions whose signature names the lifetimes of their result:
    // `val r = f(&a, &b)` makes r a borrower of what the result borrows from
    bc_collect_lifetime_ties(program);

    // Gather the checkable units in sequential order: funcs, then impl
    // methods, then trait-impl methods.
    var units: Vec<Func> = Vec::new();
    // each unit's skip-set key: par_chunk_bounds keeps an impl block, and
    // the trait impls, in one chunk (CS5)
    var ukeys: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        var f: Func = program.funcs.get(i);
        var fkey: str = "fn:" + f.name;
        if !bc_skips(self, fkey) {
            units.push(f);
            ukeys.push(fkey);
        }
        i = i + 1;
    }
    var j: i64 = 0;
    while j < program.impls.len() {
        var impl_: ImplDef = program.impls.get(j);
        var k: i64 = 0;
        while k < impl_.methods.len() {
            var m: Func = impl_.methods.get(k);
            var mkey: str = "impl:" + impl_.struct_name + ":" + m.name;
            if !bc_skips(self, mkey) {
                units.push(m);
                ukeys.push(mkey);
            }
            k = k + 1;
        }
        j = j + 1;
    }
    // Trait impl bodies too (release K5: they were never checked)
    var t: i64 = 0;
    while t < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(t);
        var tm: i64 = 0;
        while tm < ti.methods.len() {
            var m2: Func = ti.methods.get(tm);
            var tkey: str = "trait:" + ti.type_name + ":" + m2.name;
            if !bc_skips(self, tkey) {
                units.push(m2);
                ukeys.push(tkey);
            }
            tm = tm + 1;
        }
        t = t + 1;
    }

    // CS5 parallel path: On mode only (workers collect errors, not
    // warnings), enough units to be worth spawning threads.
    var nw: i64 = bc_par_workers();
    if nw > 1 && units.len() >= 64 {
        match self.mode {
            BorrowckMode::On => {
                var bounds: Vec<i64> = par_chunk_bounds(ukeys, nw);
                var nch: i64 = bounds.len() / 2;
                g_bc_units = units;
                var futs: Vec<Future<Vec<str>> > = Vec::new();
                var wi: i64 = 0;
                while wi < nch {
                    var s: i64 = bounds.get(2 * wi);
                    var e: i64 = bounds.get(2 * wi + 1);
                    futs.push(spawn bc_par_worker(s, e));
                    wi = wi + 1;
                }
                wi = 0;
                while wi < futs.len() {
                    var errs: Vec<str> = await futs.get(wi);
                    var ei: i64 = 0;
                    while ei < errs.len() {
                        self.errors.push(errs.get(ei));
                        ei = ei + 1;
                    }
                    wi = wi + 1;
                }
                var no_units: Vec<Func> = Vec::new();
                g_bc_units = no_units;
                return;
            }
            _ => {
            }
        }
    }

    var i2: i64 = 0;
    while i2 < units.len() {
        check_func(self, units.get(i2));
        i2 = i2 + 1;
    }
}

// Check a single function. Resets all borrow state between functions.
pub fn check_func(self: &mut BorrowChecker, func: Func) -> void {
    // Reset state -- borrows don't cross function boundaries.
    self.shared_borrows.clear();
    self.mut_borrow.clear();
    self.borrow_of.clear();
    var scope: StringVec = StringVec_new();
    var scope_stack: Vec<StringVec> = Vec::new();
    scope_stack.push(scope);
    self.scope_stack = scope_stack;
    self.unsafe_depth = 0;
    self.current_func = OptStr::Some(func.name);
    self.temp_counter = 0;
    self.temp_checkpoints.clear();
    self.reserved_mut_borrows.clear();
    self.in_reservation_phase = false;
    self.last_use.clear();
    HashMap_clear(self.last_use_index);
    HashMap_clear(self.sb_ix);
    HashMap_clear(self.mb_ix);
    HashMap_clear(self.bo_ix);
    HashMap_clear(self.sb_pfx);
    HashMap_clear(self.mb_pfx);
    HashMap_clear(self.ref_vars);
    self.mh_to.clear();
    self.mh_from.clear();
    self.iterating.clear();
    self.stmt_index = 0;

    // Phase 6: NLL pre-pass. Compute the last statement index that references
    // each variable. This lets us release borrows at the borrower's last use
    // rather than at scope end.
    compute_last_use(self, func.body);
    // Bucket borrowers by the statement after their last use so
    // release_dead_borrows releases one bucket, not a scan of every borrow.
    var maxlu: i64 = 0;
    var li: i64 = 0;
    while li < self.last_use.len() {
        var lu: i64 = self.last_use.get(li).val;
        if lu > maxlu {
            maxlu = lu;
        }
        li = li + 1;
    }
    self.dead_at = Vec::new();
    var di: i64 = 0;
    while di <= maxlu + 2 {
        self.dead_at.push(StringVec_new());
        di = di + 1;
    }

    // Parameters are in scope at function entry.
    var p: i64 = 0;
    while p < func.params.len() {
        var param: Param = func.params.get(p);
        scope_stack_push_name(self, param.name);
        p = p + 1;
    }

    var i: i64 = 0;
    while i < func.body.len() {
        self.stmt_index = i;
        // Phase 6: Release borrows for borrowers whose last use was before
        // this statement (NLL).
        release_dead_borrows(self);
        var stmt: Stmt = func.body.get(i);
        check_stmt(self, stmt);
        i = i + 1;
    }

    // Pop the function scope -- releases any remaining borrows.
    pop_scope(self);
    self.current_func = OptStr::None;
}

// --- Phase 6: NLL pre-pass ------------------------------------------------

// Compute the last statement index that references each variable.
fn compute_last_use(self: &mut BorrowChecker, body: Vec<Stmt>) -> void {
    var i: i64 = 0;
    while i < body.len() {
        var stmt: Stmt = body.get(i);
        collect_var_uses_stmt(self, stmt, i);
        i = i + 1;
    }
}

// Recursively collect all variable references in a statement and update
// their last-use index.
fn collect_var_uses_stmt(self: &mut BorrowChecker, stmt: Stmt, idx: i64) -> void {
    match stmt {
        Stmt::Let(name, _, expr, _, _, _, _) => {
            collect_var_uses_expr(self, expr, idx);
            // Do NOT set last_use for the defined name -- a definition is
            // not a "use" in NLL.  The borrow should persist until the
            // borrower is actually READ, not just defined.  If the borrower
            // is never read, the borrow persists until scope end.
        }
        Stmt::LetTuple(names, expr, _) => {
            collect_var_uses_expr(self, expr, idx);
            // Do NOT set last_use for the defined names (same reasoning).
        }
        Stmt::LetUninit(name, _, _, _) => {  // Do NOT set last_use -- the variable is declared but not used.
        }
        Stmt::Assign(target, _, expr, _) => {
            // Do NOT set last_use for the target -- an assignment is a
            // write, not a read.  Only reads extend the borrow lifetime.
            collect_var_uses_expr(self, expr, idx);
        }
        Stmt::IndexAssign(array, index, _, expr, _) => {
            last_use_set(self, array, idx);
            collect_var_uses_expr(self, index, idx);
            collect_var_uses_expr(self, expr, idx);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            collect_var_uses_expr(self, ptr_expr, idx);
            collect_var_uses_expr(self, expr, idx);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            collect_var_uses_expr(self, object, idx);
            collect_var_uses_expr(self, expr, idx);
        }
        Stmt::Expr(e, _) => {
            collect_var_uses_expr(self, e, idx);
        }
        Stmt::Return(opt_e, _) => {
            match opt_e {
                OptBoxExpr::Some(e) => {
                    collect_var_uses_expr(self, bc_box_expr_unbox(e), idx);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            collect_var_uses_expr(self, cond, idx);
            var t: i64 = 0;
            while t < then_block.len() {
                collect_var_uses_stmt(self, then_block.get(t), idx);
                t = t + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var e: i64 = 0;
                    while e < eb.len() {
                        collect_var_uses_stmt(self, eb.get(e), idx);
                        e = e + 1;
                    }
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(cond, body, _) => {
            collect_var_uses_expr(self, cond, idx);
            var b: i64 = 0;
            while b < body.len() {
                collect_var_uses_stmt(self, body.get(b), idx);
                b = b + 1;
            }
        }
        Stmt::For(loop_var, iterator, body, _) => {
            collect_var_uses_expr(self, iterator, idx);
            last_use_set(self, loop_var, idx);
            var b: i64 = 0;
            while b < body.len() {
                collect_var_uses_stmt(self, body.get(b), idx);
                b = b + 1;
            }
        }
        Stmt::Loop(body, _) => {
            var b: i64 = 0;
            while b < body.len() {
                collect_var_uses_stmt(self, body.get(b), idx);
                b = b + 1;
            }
        }
        Stmt::Break(opt_e, _) => {
            match opt_e {
                OptBoxExpr::Some(e) => {
                    collect_var_uses_expr(self, bc_box_expr_unbox(e), idx);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::Continue(_) => {
        }
        Stmt::Defer(body, _) => {
            var b: i64 = 0;
            while b < body.len() {
                collect_var_uses_stmt(self, body.get(b), idx);
                b = b + 1;
            }
        }
        Stmt::Match(expr, arms, _) => {
            collect_var_uses_expr(self, expr, idx);
            var a: i64 = 0;
            while a < arms.len() {
                var arm: MatchArm = arms.get(a);
                var bindings: Vec<str> = pattern_bindings(arm.pattern);
                var bi: i64 = 0;
                while bi < bindings.len() {
                    last_use_set(self, bindings.get(bi), idx);
                    bi = bi + 1;
                }
                match arm.guard {
                    OptBoxExpr::Some(g) => {
                        collect_var_uses_expr(self, bc_box_expr_unbox(g), idx);
                    }
                    OptBoxExpr::None => {
                    }
                }
                var b: i64 = 0;
                while b < arm.body.len() {
                    collect_var_uses_stmt(self, arm.body.get(b), idx);
                    b = b + 1;
                }
                a = a + 1;
            }
        }
        Stmt::Use(_, _, _) => {
        }
        Stmt::Handle(body, handlers, _) => {
            var b: i64 = 0;
            while b < body.len() {
                collect_var_uses_stmt(self, body.get(b), idx);
                b = b + 1;
            }
            var h: i64 = 0;
            while h < handlers.len() {
                var handler: EffectHandler = handlers.get(h);
                var p: i64 = 0;
                while p < handler.params.len() {
                    last_use_set(self, handler.params.get(p), idx);
                    p = p + 1;
                }
                var b2: i64 = 0;
                while b2 < handler.body.len() {
                    collect_var_uses_stmt(self, handler.body.get(b2), idx);
                    b2 = b2 + 1;
                }
                h = h + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var a: i64 = 0;
            while a < args.len() {
                collect_var_uses_expr(self, args.get(a), idx);
                a = a + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            var b: i64 = 0;
            while b < body.len() {
                collect_var_uses_stmt(self, body.get(b), idx);
                b = b + 1;
            }
        }
        Stmt::Sandbox(body, _) => {
            var b: i64 = 0;
            while b < body.len() {
                collect_var_uses_stmt(self, body.get(b), idx);
                b = b + 1;
            }
        }
        Stmt::Unsafe(body, _) => {
            var b: i64 = 0;
            while b < body.len() {
                collect_var_uses_stmt(self, body.get(b), idx);
                b = b + 1;
            }
        }
        Stmt::Txn(body, _) => {
            var b: i64 = 0;
            while b < body.len() {
                collect_var_uses_stmt(self, body.get(b), idx);
                b = b + 1;
            }
        }
        Stmt::ComptimeGen(block, _) => {
            var b: i64 = 0;
            while b < block.len() {
                collect_var_uses_stmt(self, block.get(b), idx);
                b = b + 1;
            }
        }
        Stmt::GradBlock(grad_var, body, _) => {
            last_use_set(self, grad_var, idx);
            var b: i64 = 0;
            while b < body.len() {
                collect_var_uses_stmt(self, body.get(b), idx);
                b = b + 1;
            }
        }
        Stmt::Backward(loss, _) => {
            collect_var_uses_expr(self, loss, idx);
        }
        Stmt::Query(_, body, _) => {
            var b: i64 = 0;
            while b < body.len() {
                collect_var_uses_stmt(self, body.get(b), idx);
                b = b + 1;
            }
        }
        Stmt::Select(cases, default, _) => {
            var c: i64 = 0;
            while c < cases.len() {
                var case: SelectCase = cases.get(c);
                collect_var_uses_expr(self, case.channel, idx);
                var b: i64 = 0;
                while b < case.body.len() {
                    collect_var_uses_stmt(self, case.body.get(b), idx);
                    b = b + 1;
                }
                c = c + 1;
            }
            match default {
                OptStmts::Some(def) => {
                    var b: i64 = 0;
                    while b < def.len() {
                        collect_var_uses_stmt(self, def.get(b), idx);
                        b = b + 1;
                    }
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::Parallel(branches, _) => {
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                var si: i64 = 0;
                while si < branch.len() {
                    collect_var_uses_stmt(self, branch.get(si), idx);
                    si = si + 1;
                }
                bi = bi + 1;
            }
        }
        Stmt::Resume(cont, value, _) => {
            collect_var_uses_expr(self, cont, idx);
            collect_var_uses_expr(self, value, idx);
        }
        Stmt::SpawnScope(body, _) => {
            var si2: i64 = 0;
            while si2 < body.len() {
                collect_var_uses_stmt(self, body.get(si2), idx);
                si2 = si2 + 1;
            }
        }
        Stmt::CancelScope(_) => {
        }
    }
}

// Recursively collect all variable references in an expression.
fn collect_var_uses_expr(self: &mut BorrowChecker, expr: Expr, idx: i64) -> void {
    match expr {
        Expr::Ident(name) => {
            last_use_set(self, name, idx);
        }
        Expr::Binary(_, left, right) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(left), idx);
            collect_var_uses_expr(self, bc_box_expr_unbox(right), idx);
        }
        Expr::Unary(_, e) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(e), idx);
        }
        Expr::Call(_, args) => {
            var a: i64 = 0;
            while a < args.len() {
                collect_var_uses_expr(self, args.get(a), idx);
                a = a + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(receiver), idx);
            var a: i64 = 0;
            while a < args.len() {
                collect_var_uses_expr(self, args.get(a), idx);
                a = a + 1;
            }
        }
        Expr::FieldAccess(e, _) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(e), idx);
        }
        Expr::OptionalFieldAccess(e, _) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(e), idx);
        }
        Expr::StructLit(_, fields, spread) => {
            var f: i64 = 0;
            while f < fields.len() {
                var fi: FieldInit = fields.get(f);
                collect_var_uses_expr(self, fi.value, idx);
                f = f + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => {
                    collect_var_uses_expr(self, bc_box_expr_unbox(s), idx);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::If(cond, then_block, else_block) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(cond), idx);
            var t: i64 = 0;
            while t < then_block.len() {
                collect_var_uses_stmt(self, then_block.get(t), idx);
                t = t + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var e: i64 = 0;
                    while e < eb.len() {
                        collect_var_uses_stmt(self, eb.get(e), idx);
                        e = e + 1;
                    }
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Range(start, end, _) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(start), idx);
            collect_var_uses_expr(self, bc_box_expr_unbox(end), idx);
        }
        Expr::Block(body) => {
            var b: i64 = 0;
            while b < body.len() {
                collect_var_uses_stmt(self, body.get(b), idx);
                b = b + 1;
            }
        }
        Expr::ArrayLit(_, elements) => {
            var e: i64 = 0;
            while e < elements.len() {
                collect_var_uses_expr(self, elements.get(e), idx);
                e = e + 1;
            }
        }
        Expr::Index(array, index) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(array), idx);
            collect_var_uses_expr(self, bc_box_expr_unbox(index), idx);
        }
        Expr::FString(parts) => {
            var p: i64 = 0;
            while p < parts.len() {
                var part: FStringPart = parts.get(p);
                match part {
                    FStringPart::Expr(e) => {
                        collect_var_uses_expr(self, e, idx);
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                p = p + 1;
            }
        }
        Expr::Match(expr, arms) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(expr), idx);
            var a: i64 = 0;
            while a < arms.len() {
                var arm: MatchArm = arms.get(a);
                var bindings: Vec<str> = pattern_bindings(arm.pattern);
                var bi: i64 = 0;
                while bi < bindings.len() {
                    last_use_set(self, bindings.get(bi), idx);
                    bi = bi + 1;
                }
                match arm.guard {
                    OptBoxExpr::Some(g) => {
                        collect_var_uses_expr(self, bc_box_expr_unbox(g), idx);
                    }
                    OptBoxExpr::None => {
                    }
                }
                var b: i64 = 0;
                while b < arm.body.len() {
                    collect_var_uses_stmt(self, arm.body.get(b), idx);
                    b = b + 1;
                }
                a = a + 1;
            }
        }
        Expr::EnumLit(_, _, args) => {
            var a: i64 = 0;
            while a < args.len() {
                collect_var_uses_expr(self, args.get(a), idx);
                a = a + 1;
            }
        }
        Expr::Ref(e, _) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(e), idx);
        }
        Expr::Deref(e) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(e), idx);
        }
        Expr::StrConcat(left, right) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(left), idx);
            collect_var_uses_expr(self, bc_box_expr_unbox(right), idx);
        }
        Expr::Try(e) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(e), idx);
        }
        Expr::Coalesce(e, default) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(e), idx);
            collect_var_uses_expr(self, bc_box_expr_unbox(default), idx);
        }
        Expr::TryBlock(body) => {
            var b: i64 = 0;
            while b < body.len() {
                collect_var_uses_stmt(self, body.get(b), idx);
                b = b + 1;
            }
        }
        Expr::Await(e) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(e), idx);
        }
        Expr::Spawn(e) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(e), idx);
        }
        Expr::Yield(e) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(e), idx);
        }
        Expr::NamedArg(name, e) => {
            collect_var_uses_expr(self, bc_box_expr_unbox(e), idx);
        }
        _ => {
        }
    }
}

// --- last_use helper ------------------------------------------------------

// Set the last-use index for a variable. If it already exists, update it.
fn last_use_set(self: &mut BorrowChecker, name: str, idx: i64) -> void {
    if HashMap_contains(self.last_use_index, name) {
        self.last_use.get(HashMap_get(self.last_use_index, name) - 1).val = idx;
        return;
    }
    self.last_use.push(StringI64Entry_new(name, idx));
    HashMap_insert(self.last_use_index, name, self.last_use.len());
}

// Get the last-use index for a variable, or -1 if not found.
fn last_use_get(self: &BorrowChecker, name: str) -> i64 {
    if !HashMap_contains(self.last_use_index, name) {
        return -1;
    }
    return self.last_use.get(HashMap_get(self.last_use_index, name) - 1).val;
}

/// Whether `key` ("fn:name", "impl:Type:method") is a body not to check.
pub fn bc_skips(self: &BorrowChecker, key: str) -> bool {
    if self.skip_bodies == 0 {
        return false;
    }
    return HashMap_contains(self.skip_bodies, key);
}

// --- Phase 6: NLL -- release dead borrows ----------------------------------

// Release borrows for borrowers whose last use was before the current
// statement index. This is the core of NLL -- borrows end at the borrower's
// last use, not at scope end.
fn release_dead_borrows(self: &mut BorrowChecker) -> void {
    var current_idx: i64 = self.stmt_index;
    if current_idx < self.dead_at.len() {
        // Bucketed fast path (CS3): release_borrow_by is O(1) via bo_ix,
        // so the bucket costs only its own names.
        var names: Vec<str> = self.dead_at.get(current_idx).items;
        var j: i64 = 0;
        while j < names.len() {
            release_borrow_by(self, names.get(j));
            j = j + 1;
        }
        self.dead_at.get(current_idx).items.clear();
        return;
    }
    // Collect dead borrowers.
    var dead: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < self.borrow_of.len() {
        var borrower: str = self.borrow_of.get(i).borrower;
        var last: i64 = last_use_get(self, borrower);
        if last >= 0 {
            if last < current_idx {
                dead.push(borrower);
            }
        }
        i = i + 1;
    }
    // Release them.
    var j: i64 = 0;
    while j < dead.len() {
        release_borrow_by(self, dead.get(j));
        j = j + 1;
    }
}

// --- Scope management -----------------------------------------------------

fn push_scope(self: &mut BorrowChecker) -> void {
    var scope: StringVec = StringVec_new();
    self.scope_stack.push(scope);
}

fn pop_scope(self: &mut BorrowChecker) -> void {
    if self.scope_stack.len() > 0 {
        var dead: StringVec = self.scope_stack.pop();
        var i: i64 = 0;
        while i < dead.items.len() {
            var name: str = dead.items.get(i);
            release_borrow_by(self, name);
            // The variable itself is gone -- any borrows ON it are stale.
            shared_borrows_remove(self, name);
            mut_borrow_remove(self, name);
            i = i + 1;
        }
    }
}

// Add a name to the current (top) scope.
fn scope_stack_push_name(self: &mut BorrowChecker, name: str) -> void {
    var top: i64 = self.scope_stack.len() - 1;
    self.scope_stack.get(top).items.push(name);
}

// Remove a name from the current (top) scope.
fn scope_stack_remove_name(self: &mut BorrowChecker, name: str) -> void {
    var top: i64 = self.scope_stack.len() - 1;
    var scope: Vec<str> = self.scope_stack.get(top).items;
    var i: i64 = 0;
    while i < scope.len() {
        if scope.get(i) == name {
            self.scope_stack.get(top).items.remove(i);
            return;
        }
        i = i + 1;
    }
}

// Release any borrow held by `borrower`. Called when the borrower goes out
// of scope or is reassigned.
fn release_borrow_by(self: &mut BorrowChecker, borrower: str) -> void {
    // LG3: a call tying its result to several arguments made `borrower#k`
    // hold the further borrows: they end with `borrower`
    if g_bc_lt_multi || self.alias_seen {
        var k: i64 = 1;
        var alias: str = borrower + "#1";
        while HashMap_get(self.bo_ix, alias) > 0 {
            release_borrow_one(self, alias);
            k = k + 1;
            alias = borrower + "#" + int_to_str(k);
        }
    }
    release_borrow_one(self, borrower);
}

fn release_borrow_one(self: &mut BorrowChecker, borrower: str) -> void {
    var i: i64 = HashMap_get(self.bo_ix, borrower);
    if i <= 0 {
        return;
    }
    var borrowed: str = self.borrow_of.get(i - 1).borrowed;
    self.borrow_of.get(i - 1).borrower = "";
    HashMap_remove(self.bo_ix, borrower);
    // Remove borrower from shared_borrows set.
    shared_borrows_remove_borrower(self, borrowed, borrower);
    // LG3: a `&mut` passed on (bc_hand_over_mut)
    if self.mh_to.len() > 0 && self.borrow_of.get(i - 1).is_mut {
        bc_mut_release_handed(self, borrowed, borrower);
        return;
    }
    // Clear mut_borrow if it points to this borrower.
    mut_borrow_clear_if_borrower(self, borrowed, borrower);
}

/// Whether `b` holds the mutable borrow of `path`.
fn bc_mut_holder_is(self: &BorrowChecker, path: str, b: str) -> bool {
    var i: i64 = HashMap_get(self.mb_ix, path);
    if i <= 0 {
        return false;
    }
    match self.mut_borrow.get(i - 1).borrower {
        OptStr::Some(x) => {
            return x == b;
        }
        OptStr::None => {
            return false;
        }
    }
    return false;
}

/// LG3: release the mutable borrow `borrower` holds of `path`, minding the
/// hand-overs (bc_hand_over_mut): a borrow `borrower` took over goes back
/// to the variable it came from when that one still holds it (`m` is used
/// again after `r = f(m)` ends); one taken over from `borrower` now comes
/// from where `borrower`'s came from (a chain `m -> r -> s`).
fn bc_mut_release_handed(self: &mut BorrowChecker, path: str, borrower: str) -> void {
    var from: str = "";
    var j: i64 = 0;
    while j < self.mh_to.len() {
        if self.mh_to.get(j) == borrower {
            from = self.mh_from.get(j);
            self.mh_to.remove(j);
            self.mh_from.remove(j);
            break;
        }
        j = j + 1;
    }
    var holds: bool = bc_mut_holder_is(self, path, borrower);
    mut_borrow_clear_if_borrower(self, path, borrower);
    if from == "" {
        return;
    }
    if holds {
        var hi: i64 = HashMap_get(self.bo_ix, from);
        if hi > 0 {
            var he: BorrowOfEntry = self.borrow_of.get(hi - 1);
            if he.is_mut && he.borrowed == path {
                mut_borrow_set(self, path, OptStr::Some(from));
            }
        }
    } else {
        var k: i64 = 0;
        while k < self.mh_from.len() {
            if self.mh_from.get(k) == borrower {
                self.mh_from.set(k, from);
            }
            k = k + 1;
        }
    }
}

// Declare a variable in the current scope. If it was previously a borrower
// (reassignment), release its old borrow first.
fn declare_var(self: &mut BorrowChecker, name: str) -> void {
    // Reassignment: if this name was a borrower, release the old borrow.
    release_borrow_by(self, name);
    HashMap_remove(self.ref_vars, name);
    scope_stack_push_name(self, name);
}

// Create a temporary borrow with a synthetic name. Used for &x / &mut x
// that appear directly inside a call argument list (not assigned to a
// variable). The caller releases it via release_borrow_by when the
// enclosing expression completes.
fn create_temp_borrow(self: &mut BorrowChecker, borrowed_var: str, is_mut: bool, line: i64) -> void {
    var name: str = "__tmp_ref_" + int_to_str(self.temp_counter);
    self.temp_counter = self.temp_counter + 1;
    create_borrow(self, borrowed_var, name, is_mut, line);
    // Track it in a scope so pop_scope can clean it up if forgotten.
    scope_stack_push_name(self, name);
}

// Release all temporary borrows created since the checkpoint value.
fn release_temps_since(self: &mut BorrowChecker, checkpoint: i64) -> void {
    var i: i64 = checkpoint;
    while i < self.temp_counter {
        var name: str = "__tmp_ref_" + int_to_str(i);
        release_borrow_by(self, name);
        scope_stack_remove_name(self, name);
        i = i + 1;
    }
}

// Phase 4: Release only temp SHARED borrows created since the checkpoint.
// Reserved &mut temp borrows are NOT released here.
fn release_shared_temps_since(self: &mut BorrowChecker, checkpoint: i64) -> void {
    var i: i64 = checkpoint;
    while i < self.temp_counter {
        var name: str = "__tmp_ref_" + int_to_str(i);
        // Only release if this is NOT a reserved &mut borrow.
        var is_reserved_mut: bool = false;
        var j: i64 = 0;
        while j < self.reserved_mut_borrows.len() {
            if self.reserved_mut_borrows.get(j).borrower == name {
                is_reserved_mut = true;
                break;
            }
            j = j + 1;
        }
        if !is_reserved_mut {
            release_borrow_by(self, name);
            scope_stack_remove_name(self, name);
        }
        i = i + 1;
    }
}

// --- extract_field_path ---------------------------------------------------

// Extract a field path from an expression. Returns Some("s.x.y") for s.x.y,
// Some("s") for s, and None for anything else.
fn extract_field_path(expr: Expr) -> OptStr {
    match expr {
        Expr::Ident(name) => {
            return OptStr::Some(name);
        }
        Expr::FieldAccess(inner, field) => {
            var inner_path: OptStr = extract_field_path(bc_box_expr_unbox(inner));
            match inner_path {
                OptStr::Some(p) => {
                    return OptStr::Some(p + "." + field);
                }
                OptStr::None => {
                    return OptStr::None;
                }
            }
        }
        // `&v[i]` borrows v itself (release K5): a push could move the
        // elements while the reference is alive
        Expr::Index(arr, _) => {
            return extract_field_path(bc_box_expr_unbox(arr));
        }
        _ => {
            return OptStr::None;
        }
    }
}

// 2g.73: the path of one element, `v.[3]`, for `v[3]` with a constant index
// (`path` is the Vec's path, from extract_field_path). Element paths sit
// under the Vec's path, so a borrow of one still conflicts with any use of
// the whole Vec (push, `v[i]` with an unknown i, `&mut v`); two of them
// conflict only when the indices are equal. Any other index: `path`.
fn bc_elem_path(e: Expr, path: str) -> str {
    match e {
        Expr::Index(_, idx) => {
            match bc_box_expr_unbox(idx) {
                Expr::IntLit(n) => {
                    if n >= 0 {
                        return path + ".[" + int_to_str(n) + "]";
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return path;
}

// --- Borrow state queries -------------------------------------------------

// Add `delta` to the live count of `key` and every dotted prefix of it.
// Called on every transition of the live-borrower count under `key`
// (CS3): keeps the *_pfx maps exact so inclusive queries are O(1).
fn bc_pfx_add(map: i64, key: str, delta: i64) -> void {
    var p: str = key;
    while true {
        HashMap_insert(map, p, HashMap_get(map, p) + delta);
        var dot: i64 = str_rfind(p, ".");
        if dot < 0 {
            return;
        }
        p = str_slice(p, 0, dot);
    }
}

fn has_shared_borrow(self: &BorrowChecker, var: str) -> bool {
    var i: i64 = HashMap_get(self.sb_ix, var);
    if i <= 0 {
        return false;
    }
    return self.shared_borrows.get(i - 1).borrowers.len() > 0;
}

fn has_mut_borrow(self: &BorrowChecker, var: str) -> bool {
    var i: i64 = HashMap_get(self.mb_ix, var);
    if i <= 0 {
        return false;
    }
    match self.mut_borrow.get(i - 1).borrower {
        OptStr::Some(_) => {
            return true;
        }
        OptStr::None => {
            return false;
        }
    }
}

// Check if any shared borrow exists on var OR any field path under it.
fn has_shared_borrow_inclusive(self: &BorrowChecker, var: str) -> bool {
    return HashMap_get(self.sb_pfx, var) > 0;
}

// Check if any mutable borrow exists on var OR any field path under it.
fn has_mut_borrow_inclusive(self: &BorrowChecker, var: str) -> bool {
    return HashMap_get(self.mb_pfx, var) > 0;
}

// SP10: whether a live borrow (mutable when `is_mut`, else shared) sits on a
// strict prefix of `path` ("a" and "a.b" for "a.b.c"). The prefixes are
// walked from the root down through the prefix counts (sb_pfx / mb_pfx: the
// live borrows at a key or under it, kept exact by bc_pfx_add): a prefix
// with a count of 0 has no borrow at it or under it, so no longer prefix
// can hold one and the walk stops. A path whose root is not borrowed costs
// one table lookup; a path without a dot costs none. Same answer as the
// earlier walk from the longest prefix up (each prefix checked exactly).
fn bc_borrow_on_prefix(self: &BorrowChecker, path: str, is_mut: bool) -> bool {
    var pfx: i64 = self.sb_pfx;
    if is_mut {
        pfx = self.mb_pfx;
    }
    var n: i64 = str_len(path);
    var k: i64 = 0;
    while k < n {
        if str_byte_at(path, k) == 46 {
            var q: str = str_slice(path, 0, k);
            if HashMap_get(pfx, q) <= 0 {
                return false;
            }
            if is_mut {
                if has_mut_borrow(self, q) {
                    return true;
                }
            } else {
                if has_shared_borrow(self, q) {
                    return true;
                }
            }
        }
        k = k + 1;
    }
    return false;
}

// Check if any shared borrow exists on a PREFIX of path.
fn has_shared_borrow_on_prefix(self: &BorrowChecker, path: str) -> bool {
    return bc_borrow_on_prefix(self, path, false);
}

// Check if any mutable borrow exists on a PREFIX of path.
fn has_mut_borrow_on_prefix(self: &BorrowChecker, path: str) -> bool {
    return bc_borrow_on_prefix(self, path, true);
}

// --- shared_borrows / mut_borrow map helpers ------------------------------

// Tombstone instead of remove: clearing the payload keeps vec positions
// (and the *_ix maps) stable. has_* treats an empty payload as absent.
fn shared_borrows_remove(self: &mut BorrowChecker, key: str) -> void {
    var i: i64 = HashMap_get(self.sb_ix, key);
    if i <= 0 {
        return;
    }
    var n: i64 = self.shared_borrows.get(i - 1).borrowers.len();
    if n > 0 {
        self.shared_borrows.get(i - 1).borrowers.clear();
        bc_pfx_add(self.sb_pfx, key, 0 - n);
    }
}

fn mut_borrow_remove(self: &mut BorrowChecker, key: str) -> void {
    var i: i64 = HashMap_get(self.mb_ix, key);
    if i <= 0 {
        return;
    }
    match self.mut_borrow.get(i - 1).borrower {
        OptStr::Some(_) => {
            self.mut_borrow.get(i - 1).borrower = OptStr::None;
            bc_pfx_add(self.mb_pfx, key, 0 - 1);
        }
        OptStr::None => {
        }
    }
}

fn shared_borrows_remove_borrower(self: &mut BorrowChecker, borrowed: str, borrower: str) -> void {
    var i: i64 = HashMap_get(self.sb_ix, borrowed);
    if i <= 0 {
        return;
    }
    var borrowers: Vec<str> = self.shared_borrows.get(i - 1).borrowers;
    var j: i64 = 0;
    while j < borrowers.len() {
        if borrowers.get(j) == borrower {
            self.shared_borrows.get(i - 1).borrowers.remove(j);
            bc_pfx_add(self.sb_pfx, borrowed, 0 - 1);
            return;
        }
        j = j + 1;
    }
}

fn mut_borrow_clear_if_borrower(self: &mut BorrowChecker, borrowed: str, borrower: str) -> void {
    var i: i64 = HashMap_get(self.mb_ix, borrowed);
    if i <= 0 {
        return;
    }
    match self.mut_borrow.get(i - 1).borrower {
        OptStr::Some(b) => {
            if b == borrower {
                self.mut_borrow.get(i - 1).borrower = OptStr::None;
                bc_pfx_add(self.mb_pfx, borrowed, 0 - 1);
            }
        }
        OptStr::None => {
        }
    }
}

fn shared_borrows_get_or_create(self: &mut BorrowChecker, key: str) -> void {
    if HashMap_get(self.sb_ix, key) > 0 {
        return;
    }
    self.shared_borrows.push(SharedBorrowEntry_new(key));
    HashMap_insert(self.sb_ix, key, self.shared_borrows.len());
}

fn shared_borrows_add_borrower(self: &mut BorrowChecker, key: str, borrower: str) -> void {
    var i: i64 = HashMap_get(self.sb_ix, key);
    if i <= 0 {
        self.shared_borrows.push(SharedBorrowEntry_new(key));
        i = self.shared_borrows.len();
        HashMap_insert(self.sb_ix, key, i);
    }
    self.shared_borrows.get(i - 1).borrowers.push(borrower);
    bc_pfx_add(self.sb_pfx, key, 1);
}

fn mut_borrow_set(self: &mut BorrowChecker, key: str, borrower: OptStr) -> void {
    var i: i64 = HashMap_get(self.mb_ix, key);
    if i <= 0 {
        self.mut_borrow.push(MutBorrowEntry_new(key, borrower));
        HashMap_insert(self.mb_ix, key, self.mut_borrow.len());
        match borrower {
            OptStr::Some(_) => {
                bc_pfx_add(self.mb_pfx, key, 1);
            }
            OptStr::None => {
            }
        }
        return;
    }
    var e: i64 = i - 1;
    match self.mut_borrow.get(e).borrower {
        OptStr::Some(_) => {
            bc_pfx_add(self.mb_pfx, key, 0 - 1);
        }
        OptStr::None => {
        }
    }
    self.mut_borrow.get(e).borrower = borrower;
    match borrower {
        OptStr::Some(_) => {
            bc_pfx_add(self.mb_pfx, key, 1);
        }
        OptStr::None => {
        }
    }
}

fn borrow_of_add(self: &mut BorrowChecker, borrower: str, borrowed: str, is_mut: bool, line: i64) -> void {
    // Tombstone an existing entry for this borrower (reassignment).
    var old: i64 = HashMap_get(self.bo_ix, borrower);
    if old > 0 {
        self.borrow_of.get(old - 1).borrower = "";
    }
    self.borrow_of.push(BorrowOfEntry_new(borrower, borrowed, is_mut, line));
    HashMap_insert(self.bo_ix, borrower, self.borrow_of.len());
    // Bucket for NLL release: dies at the statement after its last use.
    var last: i64 = last_use_get(self, borrower);
    if last >= 0 && self.dead_at.len() > 0 {
        var slot: i64 = last + 1;
        if slot <= self.stmt_index {
            slot = self.stmt_index + 1;
        }
        if slot < self.dead_at.len() {
            self.dead_at.get(slot).items.push(borrower);
        }
    }
}

// CM2: which borrow holds `path` (or a field of it, or what it is a field
// of), and the change that frees it. want: 1 a mutable borrow, 0 a shared
// one. The latest such borrow is named (as src/borrowck.rs holder_note).
fn holder_note(self: &BorrowChecker, path: str, want: i64) -> str {
    var best: i64 = -1;
    var i: i64 = 0;
    while i < self.borrow_of.len() {
        var e: BorrowOfEntry = self.borrow_of.get(i);
        // "" is a tombstone (released or reassigned borrower); skip it.
        var related: bool = e.borrower != "" && (e.borrowed == path || str_starts_with(e.borrowed, path + ".") || str_starts_with(path, e.borrowed + "."));
        var kind_ok: bool = (want == 1) == e.is_mut;
        if related && kind_ok {
            if best < 0 {
                best = i;
            } else {
                var b: BorrowOfEntry = self.borrow_of.get(best);
                if e.line > b.line || (e.line == b.line && str_compare(e.borrower, b.borrower) > 0) {
                    best = i;
                }
            }
        }
        i = i + 1;
    }
    if best < 0 {
        return "";
    }
    var h: BorrowOfEntry = self.borrow_of.get(best);
    var kind: str = "&";
    if h.is_mut {
        kind = "&mut ";
    }
    // LG3: `r#k` is a further borrow of `r` (a call tied to several arguments)
    var hname: str = h.borrower;
    var hk: i64 = 0;
    while hk < str_len(hname) {
        if str_byte_at(hname, hk) == 35 {
            hname = str_slice(hname, 0, hk);
            break;
        }
        hk = hk + 1;
    }
    var who: str = "'" + hname + "'";
    var fix: str = "use '" + hname + "' for the last time before this line, or declare it in an inner block { ... } that ends first";
    if str_starts_with(h.borrower, "__tmp_ref_") {
        who = "a reference made earlier in this statement";
        fix = "take that reference in a statement of its own, or copy the value into a local first";
    } else if str_starts_with(h.borrower, "__closure_capture_") {
        var cap: str = str_slice(h.borrower, 18, str_len(h.borrower));
        who = "a closure that captures '" + cap + "'";
        fix = "call the closure for the last time before this line, or pass the value to it as an argument";
    }
    return "\n    Held by: " + who + " (" + kind + h.borrowed + ", line " + int_to_str(h.line) + ").\n    Fix: " + fix + ".";
}

// --- The three rules ------------------------------------------------------

// Rule 1 & 2: creating a borrow. is_mut true = &mut x, false = &x.
// borrowed_path is a field path like "s" or "s.x" or "s.inner.z".
fn create_borrow(self: &mut BorrowChecker, borrowed_path: str, borrower: str, is_mut: bool, line: i64) -> void {
    if is_mut && bc_is_iterating(self, borrowed_path) {
        violation(self, line, "cannot create &mut " + borrowed_path + " while a `for` loop iterates over it.\n    Fix: collect the changes and apply them after the loop.");
        return;
    }
    if is_mut {
        // Phase 4: Two-phase borrows. If in reservation phase, don't activate
        // the &mut yet -- just reserve it.
        if self.in_reservation_phase {
            // Check for conflicts with EXISTING active borrows.
            if has_shared_borrow_inclusive(self, borrowed_path) || has_shared_borrow_on_prefix(self, borrowed_path) {
                violation(self, line, "cannot create &mut " + borrowed_path + ": shared borrow(s) already active on it or a related path" + holder_note(self, borrowed_path, 0));
                return;
            }
            if has_mut_borrow_inclusive(self, borrowed_path) || has_mut_borrow_on_prefix(self, borrowed_path) {
                violation(self, line, "cannot create &mut " + borrowed_path + ": a mutable borrow is already active on it or a related path" + holder_note(self, borrowed_path, 1));
                return;
            }
            // Check for conflicts with other reserved &mut on the same path.
            var i: i64 = 0;
            while i < self.reserved_mut_borrows.len() {
                var existing_path: str = self.reserved_mut_borrows.get(i).path;
                if (existing_path == borrowed_path) || str_starts_with(existing_path, borrowed_path + ".") || str_starts_with(borrowed_path, existing_path + ".") {
                    violation(self, line, "cannot create &mut " + borrowed_path + ": a mutable borrow is already reserved on it or a related path" + holder_note(self, borrowed_path, 1));
                    return;
                }
                i = i + 1;
            }
            // Reserve the borrow -- don't activate it yet.
            self.reserved_mut_borrows.push(ReservedMutBorrow_new(borrowed_path, borrower, line));
            borrow_of_add(self, borrower, borrowed_path, is_mut, line);
            return;
        }

        // Rule 1: &mut path requires NO active borrows on path, prefix, or extension.
        if has_shared_borrow_inclusive(self, borrowed_path) || has_shared_borrow_on_prefix(self, borrowed_path) {
            violation(self, line, "cannot create &mut " + borrowed_path + ": shared borrow(s) already active on it or a related path" + holder_note(self, borrowed_path, 0));
            return;
        }
        if has_mut_borrow_inclusive(self, borrowed_path) || has_mut_borrow_on_prefix(self, borrowed_path) {
            violation(self, line, "cannot create &mut " + borrowed_path + ": a mutable borrow is already active on it or a related path" + holder_note(self, borrowed_path, 1));
            return;
        }
        mut_borrow_set(self, borrowed_path, OptStr::Some(borrower));
    } else {
        // Rule 2: &path requires no active &mut on path, prefix or
        // extension: `&g` while `&mut g.nodes` is live reads what the &mut
        // may change (has_mut_borrow_inclusive: the path or under it).
        // Phase 4: reserved &mut borrows don't conflict with shared borrows.
        if has_mut_borrow_inclusive(self, borrowed_path) || has_mut_borrow_on_prefix(self, borrowed_path) {
            violation(self, line, "cannot create &" + borrowed_path + ": a mutable borrow is already active on it or a related path" + holder_note(self, borrowed_path, 1));
            return;
        }
        shared_borrows_add_borrower(self, borrowed_path, borrower);
    }
    borrow_of_add(self, borrower, borrowed_path, is_mut, line);
    // OW5 (reference §8.4: "A borrow ends at the borrower's last use"): a
    // borrower the function never reads ends where it is made, at the top
    // level and in an inner block alike (compute_last_use gives it no
    // index, so the NLL buckets would keep it to its scope's end). The
    // conflicts at its creation were checked above. Not a temporary of a
    // statement (`__tmp_ref_*`, released at the statement's end) nor a
    // further borrow `r#k` of a call tied to several arguments.
    if bc_never_read(self, borrower) {
        release_borrow_by(self, borrower);
    }
}

/// OW5: a named borrower (not a temporary, a closure capture or `r#k`)
/// that no statement of the function reads.
fn bc_never_read(self: &BorrowChecker, borrower: str) -> bool {
    if str_len(borrower) == 0 || str_starts_with(borrower, "__") || str_find(borrower, "#") >= 0 {
        return false;
    }
    return last_use_get(self, borrower) < 0;
}

// Phase 4: Activate all reserved &mut borrows. Called after all call
// arguments have been evaluated.
fn activate_reserved_borrows(self: &mut BorrowChecker) -> void {
    var reserved: Vec<ReservedMutBorrow> = self.reserved_mut_borrows;
    self.reserved_mut_borrows.clear();
    var i: i64 = 0;
    while i < reserved.len() {
        var r: ReservedMutBorrow = reserved.get(i);
        // Check for conflicts with shared borrows still active.
        if has_shared_borrow_inclusive(self, r.path) || has_shared_borrow_on_prefix(self, r.path) {
            violation(self, r.line, "cannot activate &mut " + r.path + ": shared borrow(s) are still active on it or a related path" + holder_note(self, r.path, 0));
            i = i + 1;
            continue;
        }
        mut_borrow_set(self, r.path, OptStr::Some(r.borrower));
        i = i + 1;
    }
}

// Rule 3: mutating a variable. Fails if any borrow is active on it or on
// any field path under it.
/// "a.b.c" for a chain of field reads on a variable, or "".
fn bc_field_path(e: Expr) -> str {
    match e {
        Expr::Ident(n) => {
            return n;
        }
        Expr::FieldAccess(x, f) => {
            var base: str = bc_field_path(bc_box_expr_unbox(x));
            if base == "" {
                return "";
            }
            return base + "." + f;
        }
        _ => {
        }
    }
    return "";
}

fn check_mutation(self: &mut BorrowChecker, var: str, line: i64) -> void {
    if bc_is_iterating(self, var) {
        violation(self, line, "cannot change " + var + " while a `for` loop iterates over it: the loop would read past a resize or skip elements.
    Fix: collect the changes in another Vec and apply them after the loop.");
        return;
    }
    if has_shared_borrow_inclusive(self, var) {
        violation(self, line, "cannot mutate " + var + ": shared borrow(s) are active on it or its fields" + holder_note(self, var, 0));
    }
    if has_mut_borrow_inclusive(self, var) {
        violation(self, line, "cannot mutate " + var + ": a mutable borrow is active on it or its fields" + holder_note(self, var, 1));
    }
}

// --- Violation reporting --------------------------------------------------

/// Whether a `for` loop around this point iterates over `var` (or the
/// variable `var` is a field of).
fn bc_is_iterating(self: &BorrowChecker, var: str) -> bool {
    var i: i64 = 0;
    while i < self.iterating.len() {
        var it: str = self.iterating.get(i);
        if it == var || str_starts_with(var, it + ".") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn violation(self: &mut BorrowChecker, line: i64, msg: str) -> void {
    var full: str = "";
    match self.current_func {
        OptStr::Some(f) => {
            full = "borrow error in " + f + " (line " + int_to_str(line) + "): " + msg;
        }
        OptStr::None => {
            full = "borrow error (line " + int_to_str(line) + "): " + msg;
        }
    }
    match self.mode {
        BorrowckMode::On => {
            self.errors.push(full);
        }
        BorrowckMode::Warn => {
            self.warnings.push(full);
        }
        BorrowckMode::Off => {
        }
    }
}

// --- Statement walker -----------------------------------------------------

/// Methods that only read their receiver: calling one is not a mutation.
fn bc_read_method(m: str) -> bool {
    return m == "len" || m == "get" || m == "is_empty" || m == "contains" || m == "contains_key" || m == "first" || m == "last" || m == "clone" || m == "to_str" || m == "keys" || m == "values" || m == "starts_with" || m == "ends_with" || m == "find" || m == "capacity" || m == "is_some" || m == "is_none" || m == "is_ok" || m == "is_err" || m == "unwrap" || m == "unwrap_or" || m == "get_or" || m == "eq" || m == "cmp" || m == "show" || m == "slice" || m == "byte_at" || m == "char_at";
}

fn check_stmt(self: &mut BorrowChecker, stmt: Stmt) -> void {
    self.stmt_line = stmt_line(stmt);
    match stmt {
        Stmt::Let(name, _, expr, _, _, _, line) => {
            // Check the initializer first (it may borrow from other vars).
            check_expr(self, expr);
            // Then declare the new variable (releases any old borrow it held).
            declare_var(self, name);
            // If the initializer is itself a borrow, record it.
            maybe_record_borrow_from_expr(self, name, expr, line);
        }
        Stmt::LetTuple(names, expr, _) => {
            check_expr(self, expr);
            var n: i64 = 0;
            while n < names.len() {
                declare_var(self, names.get(n));
                n = n + 1;
            }
        }
        Stmt::LetUninit(name, _, _, _) => {
            declare_var(self, name);
        }
        Stmt::Assign(target, _, expr, line) => {
            // Mutating target -- Rule 3.
            check_mutation(self, target, line);
            // If target was itself a borrower, release its old borrow BEFORE
            // checking the RHS.
            release_borrow_by(self, target);
            // The RHS may create new borrows.
            check_expr(self, expr);
            // If the RHS is a Ref assigned to target, record the borrow.
            maybe_record_borrow_from_expr(self, target, expr, line);
        }
        Stmt::IndexAssign(array, index, _, expr, line) => {
            // Mutating array -- Rule 3.
            check_mutation(self, array, line);
            check_expr(self, index);
            check_expr(self, expr);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            check_expr(self, ptr_expr);
            check_expr(self, expr);
        }
        Stmt::FieldAssign(object, field, _, expr, fline) => {
            check_expr(self, object);
            check_expr(self, expr);
            // `s.x = 1` changes s.x: rejected while s, s.x or a field of
            // s.x is borrowed (release K5)
            // The object may be a field path itself: `s.a.z = 1` changes
            // s.a.z, rejected while &s.a lives (known-bugs 2g.9)
            var opath: str = bc_field_path(object);
            if opath != "" {
                var fpath: str = opath + "." + field;
                check_mutation(self, fpath, fline);
                if has_shared_borrow_on_prefix(self, fpath) {
                    violation(self, fline, "cannot assign to " + fpath + ": " + opath + " is borrowed" + holder_note(self, opath, 0));
                } else if has_mut_borrow_on_prefix(self, fpath) {
                    violation(self, fline, "cannot assign to " + fpath + ": " + opath + " is mutably borrowed" + holder_note(self, opath, 1));
                }
            }
            // LG3: `v.r = &b` into a struct with lifetime parameters: v
            // borrows b too, as long as v lives
            if g_bc_lt_structs != 0 && self.unsafe_depth == 0 {
                match object {
                    Expr::Ident(fbase) => {
                        bc_record_field_borrow(self, fbase, expr, fline);
                    }
                    _ => {
                    }
                }
            }
        }
        Stmt::Expr(e, _) => {
            check_expr(self, e);
        }
        Stmt::Return(opt_e, _) => {
            match opt_e {
                OptBoxExpr::Some(e) => {
                    check_expr(self, bc_box_expr_unbox(e));
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            check_expr(self, cond);
            // Each branch gets its own scope; borrows inside don't escape.
            push_scope(self);
            var t: i64 = 0;
            while t < then_block.len() {
                check_stmt(self, then_block.get(t));
                t = t + 1;
            }
            pop_scope(self);
            match else_block {
                OptStmts::Some(else_b) => {
                    push_scope(self);
                    var e: i64 = 0;
                    while e < else_b.len() {
                        check_stmt(self, else_b.get(e));
                        e = e + 1;
                    }
                    pop_scope(self);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(cond, body, _) => {
            check_expr(self, cond);
            push_scope(self);
            var b: i64 = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            pop_scope(self);
        }
        Stmt::For(loop_var, iterator, body, _) => {
            // `for x in &v`: the reference the iterator makes holds while the
            // loop runs and ends with it (it stayed active after the loop, so
            // a later `&mut v` was rejected: test_for_borrowed_vec)
            var for_checkpoint: i64 = self.temp_counter;
            check_expr(self, iterator);
            push_scope(self);
            declare_var(self, loop_var);
            // `for x in v` / `for x in v.iter()`: v is read by the loop
            var iter_var: str = "";
            match iterator {
                Expr::Ident(iv) => {
                    iter_var = iv;
                }
                Expr::MethodCall(irecv, im, _) => {
                    if im == "iter" || im == "keys" || im == "values" {
                        match bc_box_expr_unbox(irecv) {
                            Expr::Ident(iv2) => {
                                iter_var = iv2;
                            }
                            _ => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
            if iter_var != "" {
                self.iterating.push(iter_var);
            }
            var b: i64 = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            if iter_var != "" {
                self.iterating.pop();
            }
            pop_scope(self);
            release_temps_since(self, for_checkpoint);
        }
        Stmt::Loop(body, _) => {
            push_scope(self);
            var b: i64 = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            pop_scope(self);
        }
        Stmt::Break(opt_e, _) => {
            match opt_e {
                OptBoxExpr::Some(e) => {
                    check_expr(self, bc_box_expr_unbox(e));
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::Continue(_) => {
        }
        Stmt::Defer(body, _) => {
            push_scope(self);
            var b: i64 = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            pop_scope(self);
        }
        Stmt::Match(expr, arms, _) => {
            check_expr(self, expr);
            var a: i64 = 0;
            while a < arms.len() {
                var arm: MatchArm = arms.get(a);
                push_scope(self);
                // Bind pattern variables.
                var bindings: Vec<str> = pattern_bindings(arm.pattern);
                var bi: i64 = 0;
                while bi < bindings.len() {
                    declare_var(self, bindings.get(bi));
                    bi = bi + 1;
                }
                match arm.guard {
                    OptBoxExpr::Some(g) => {
                        check_expr(self, bc_box_expr_unbox(g));
                    }
                    OptBoxExpr::None => {
                    }
                }
                var b: i64 = 0;
                while b < arm.body.len() {
                    check_stmt(self, arm.body.get(b));
                    b = b + 1;
                }
                pop_scope(self);
                a = a + 1;
            }
        }
        Stmt::Use(_, _, _) => {
        }
        Stmt::Handle(body, handlers, _) => {
            push_scope(self);
            var b: i64 = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            pop_scope(self);
            var h: i64 = 0;
            while h < handlers.len() {
                var handler: EffectHandler = handlers.get(h);
                push_scope(self);
                var p: i64 = 0;
                while p < handler.params.len() {
                    declare_var(self, handler.params.get(p));
                    p = p + 1;
                }
                var b2: i64 = 0;
                while b2 < handler.body.len() {
                    check_stmt(self, handler.body.get(b2));
                    b2 = b2 + 1;
                }
                pop_scope(self);
                h = h + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var a: i64 = 0;
            while a < args.len() {
                check_expr(self, args.get(a));
                a = a + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            push_scope(self);
            var b: i64 = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            pop_scope(self);
        }
        Stmt::Sandbox(body, _) => {
            push_scope(self);
            var b: i64 = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            pop_scope(self);
        }
        Stmt::Unsafe(body, _) => {
            // Skip all borrow checks inside unsafe blocks.
            self.unsafe_depth = self.unsafe_depth + 1;
            push_scope(self);
            var b: i64 = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            pop_scope(self);
            self.unsafe_depth = self.unsafe_depth - 1;
        }
        Stmt::Txn(body, _) => {
            push_scope(self);
            var b: i64 = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            pop_scope(self);
        }
        Stmt::ComptimeGen(block, _) => {
            push_scope(self);
            var b: i64 = 0;
            while b < block.len() {
                check_stmt(self, block.get(b));
                b = b + 1;
            }
            pop_scope(self);
        }
        Stmt::GradBlock(grad_var, body, _) => {
            push_scope(self);
            declare_var(self, grad_var);
            var b: i64 = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            pop_scope(self);
        }
        Stmt::Backward(loss, _) => {
            check_expr(self, loss);
        }
        Stmt::Query(_, body, _) => {
            push_scope(self);
            var b: i64 = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            pop_scope(self);
        }
        Stmt::Select(cases, default, _) => {
            var c: i64 = 0;
            while c < cases.len() {
                var case: SelectCase = cases.get(c);
                check_expr(self, case.channel);
                push_scope(self);
                var b: i64 = 0;
                while b < case.body.len() {
                    check_stmt(self, case.body.get(b));
                    b = b + 1;
                }
                pop_scope(self);
                c = c + 1;
            }
            match default {
                OptStmts::Some(def) => {
                    push_scope(self);
                    var b: i64 = 0;
                    while b < def.len() {
                        check_stmt(self, def.get(b));
                        b = b + 1;
                    }
                    pop_scope(self);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::Parallel(branches, _) => {
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                push_scope(self);
                var si: i64 = 0;
                while si < branch.len() {
                    check_stmt(self, branch.get(si));
                    si = si + 1;
                }
                pop_scope(self);
                bi = bi + 1;
            }
        }
        Stmt::Resume(cont, value, _) => {
            check_expr(self, cont);
            check_expr(self, value);
        }
        Stmt::SpawnScope(body, _) => {
            push_scope(self);
            var si3: i64 = 0;
            while si3 < body.len() {
                check_stmt(self, body.get(si3));
                si3 = si3 + 1;
            }
            pop_scope(self);
        }
        Stmt::CancelScope(_) => {
        }
    }
}

// --- Expression walker ----------------------------------------------------

fn check_expr(self: &mut BorrowChecker, expr: Expr) -> void {
    match expr {
        Expr::IntLit(_) => {
        }
        Expr::FloatLit(_) => {
        }
        Expr::StringLit(_) => {
        }
        Expr::BoolLit(_) => {
        }
        Expr::Ident(_) => {
        }
        Expr::Binary(_, left, right) => {
            check_expr(self, bc_box_expr_unbox(left));
            check_expr(self, bc_box_expr_unbox(right));
        }
        Expr::Unary(_, e) => {
            check_expr(self, bc_box_expr_unbox(e));
        }
        Expr::Call(_, args) => {
            // Phase 4: Two-phase borrows. Evaluate all arguments in
            // "reservation" mode -- &mut borrows are reserved, not activated.
            var checkpoint: i64 = self.temp_counter;
            var prev_reservation: bool = self.in_reservation_phase;
            self.in_reservation_phase = true;
            // An argument holding statements (a closure, a block) checks
            // them on their own lines; the call's borrows keep the call's
            // line (bugs 42/53: "line 0")
            var call_line: i64 = self.stmt_line;
            var a: i64 = 0;
            while a < args.len() {
                check_expr(self, args.get(a));
                self.stmt_line = call_line;
                a = a + 1;
            }
            self.in_reservation_phase = prev_reservation;
            // 1. Release temp shared borrows only (reserved &mut temps stay).
            release_shared_temps_since(self, checkpoint);
            // 2. Activate reserved &mut borrows.
            activate_reserved_borrows(self);
            // 3. Release ALL temp borrows (including now-activated &mut ones).
            release_temps_since(self, checkpoint);
        }
        Expr::FieldAccess(e, _) => {
            check_expr(self, bc_box_expr_unbox(e));
        }
        Expr::OptionalFieldAccess(e, _) => {
            check_expr(self, bc_box_expr_unbox(e));
        }
        Expr::StructLit(slname, fields, spread) => {
            var lt_checkpoint: i64 = self.temp_counter;
            var f: i64 = 0;
            while f < fields.len() {
                var fi: FieldInit = fields.get(f);
                check_expr(self, fi.value);
                f = f + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => {
                    check_expr(self, bc_box_expr_unbox(s));
                }
                OptBoxExpr::None => {
                }
            }
            // LG3: a struct with lifetime parameters holds its references
            // as long as the variable it is bound to lives
            // (bc_record_struct_borrow), not as temporaries to the end of
            // the scope
            if g_bc_lt_structs != 0 && !self.in_reservation_phase {
                if HashMap_get(g_bc_lt_structs, slname) != 0 {
                    release_temps_since(self, lt_checkpoint);
                }
            }
        }
        Expr::If(cond, then_block, else_block) => {
            check_expr(self, bc_box_expr_unbox(cond));
            push_scope(self);
            var t: i64 = 0;
            while t < then_block.len() {
                check_stmt(self, then_block.get(t));
                t = t + 1;
            }
            pop_scope(self);
            match else_block {
                OptStmts::Some(eb) => {
                    push_scope(self);
                    var e: i64 = 0;
                    while e < eb.len() {
                        check_stmt(self, eb.get(e));
                        e = e + 1;
                    }
                    pop_scope(self);
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Range(start, end, _) => {
            check_expr(self, bc_box_expr_unbox(start));
            check_expr(self, bc_box_expr_unbox(end));
        }
        Expr::Block(body) => {
            push_scope(self);
            var b: i64 = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            pop_scope(self);
        }
        Expr::MethodCall(receiver, method, args) => {
            // A method call on receiver may mutate it (e.g. arr.push()).
            // If receiver is a simple Ident, treat it as a mutation, unless the
            // method only reads (`f(&mut v, v.len())` is fine; src/borrowck.rs).
            // Phase 4: The receiver mutation check is deferred to after
            // argument evaluation (reservation phase).
            var receiver_path: OptStr = OptStr::None;
            match receiver {
                Expr::Ident(name) => {
                    // LG3: a user method taking `&self` or `self` by value
                    // only reads its receiver too (bc_user_read_method)
                    if !bc_read_method(method) && !bc_user_read_method(method) {
                        receiver_path = OptStr::Some(name);
                    }
                }
                _ => {
                }
            }
            // Phase 4: Evaluate receiver + args in reservation mode.
            var checkpoint: i64 = self.temp_counter;
            var prev_reservation: bool = self.in_reservation_phase;
            self.in_reservation_phase = true;
            var mcall_line: i64 = self.stmt_line;
            check_expr(self, bc_box_expr_unbox(receiver));
            self.stmt_line = mcall_line;
            var a: i64 = 0;
            while a < args.len() {
                check_expr(self, args.get(a));
                self.stmt_line = mcall_line;
                a = a + 1;
            }
            self.in_reservation_phase = prev_reservation;
            // 1. Release temp shared borrows only.
            release_shared_temps_since(self, checkpoint);
            // 2. Activate reserved &mut borrows.
            activate_reserved_borrows(self);
            // 3. Release ALL temp borrows.
            release_temps_since(self, checkpoint);
            // Now check the receiver mutation (after args are consumed).
            match receiver_path {
                OptStr::Some(name) => {
                    check_mutation(self, name, self.stmt_line);
                }
                OptStr::None => {
                }
            }
        }
        Expr::ArrayLit(_, elements) => {
            var e: i64 = 0;
            while e < elements.len() {
                check_expr(self, elements.get(e));
                e = e + 1;
            }
        }
        Expr::Index(array, index) => {
            check_expr(self, bc_box_expr_unbox(array));
            check_expr(self, bc_box_expr_unbox(index));
        }
        Expr::FString(parts) => {
            var p: i64 = 0;
            while p < parts.len() {
                var part: FStringPart = parts.get(p);
                match part {
                    FStringPart::Expr(e) => {
                        check_expr(self, e);
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                p = p + 1;
            }
        }
        Expr::Match(expr, arms) => {
            check_expr(self, bc_box_expr_unbox(expr));
            var a: i64 = 0;
            while a < arms.len() {
                var arm: MatchArm = arms.get(a);
                push_scope(self);
                var bindings: Vec<str> = pattern_bindings(arm.pattern);
                var bi: i64 = 0;
                while bi < bindings.len() {
                    declare_var(self, bindings.get(bi));
                    bi = bi + 1;
                }
                match arm.guard {
                    OptBoxExpr::Some(g) => {
                        check_expr(self, bc_box_expr_unbox(g));
                    }
                    OptBoxExpr::None => {
                    }
                }
                var b: i64 = 0;
                while b < arm.body.len() {
                    check_stmt(self, arm.body.get(b));
                    b = b + 1;
                }
                pop_scope(self);
                a = a + 1;
            }
        }
        Expr::EnumLit(_, _, args) => {
            var a: i64 = 0;
            while a < args.len() {
                check_expr(self, args.get(a));
                a = a + 1;
            }
        }
        Expr::Ref(inner, is_mut) => {
            // Creating a reference. The borrowed variable is the inner
            // expression -- either a simple Ident (&x) or a field path
            // (&s.x.y). Field paths allow simultaneous borrows of different
            // fields (e.g. &s.x and &s.y coexist).
            check_expr(self, bc_box_expr_unbox(inner));
            if self.unsafe_depth == 0 {
                var path_opt: OptStr = extract_field_path(bc_box_expr_unbox(inner));
                match path_opt {
                    OptStr::Some(path) => {
                        // If this ref is assigned to a variable (e.g.
                        // pv r = &x), the Let handler calls
                        // maybe_record_borrow_from_expr which records the
                        // borrow with the variable name as borrower. But we
                        // ALSO need to record it here in case the ref is NOT
                        // assigned (e.g. passed directly to a function call).
                        // The temp borrow is released by the enclosing
                        // Call/MethodCall via the checkpoint mechanism.
                        // 2g.73: inside a call's arguments, `&mut v[0]` and
                        // `&mut v[1]` borrow two elements (paths v.[0] and
                        // v.[1], both under v, so v itself stays borrowed).
                        var ref_path: str = path;
                        if self.in_reservation_phase {
                            ref_path = bc_elem_path(bc_box_expr_unbox(inner), path);
                        }
                        create_temp_borrow(self, ref_path, is_mut, self.stmt_line);
                    }
                    OptStr::None => {
                    }
                }
            }
        }
        Expr::Deref(e) => {
            check_expr(self, bc_box_expr_unbox(e));
        }
        Expr::StrConcat(left, right) => {
            check_expr(self, bc_box_expr_unbox(left));
            check_expr(self, bc_box_expr_unbox(right));
        }
        Expr::Try(e) => {
            check_expr(self, bc_box_expr_unbox(e));
        }
        Expr::Coalesce(e, default) => {
            check_expr(self, bc_box_expr_unbox(e));
            check_expr(self, bc_box_expr_unbox(default));
        }
        Expr::TryBlock(body) => {
            push_scope(self);
            var b: i64 = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            pop_scope(self);
        }
        Expr::Await(e) => {
            check_expr(self, bc_box_expr_unbox(e));
        }
        Expr::Spawn(e) => {
            check_expr(self, bc_box_expr_unbox(e));
        }
        Expr::Yield(e) => {
            check_expr(self, bc_box_expr_unbox(e));
        }
        Expr::NamedArg(name, e) => {
            check_expr(self, bc_box_expr_unbox(e));
        }
        // A cast or a pipe hid what it wraps: `g(&mut x, &mut x) as i64`
        // was accepted (known-bugs 2g.9)
        Expr::Cast(e, _) => {
            check_expr(self, bc_box_expr_unbox(e));
        }
        Expr::QuantCast(e, _) => {
            check_expr(self, bc_box_expr_unbox(e));
        }
        Expr::Comptime(e) => {
            check_expr(self, bc_box_expr_unbox(e));
        }
        Expr::PipeForward(l, r) => {
            check_expr(self, bc_box_expr_unbox(l));
            check_expr(self, bc_box_expr_unbox(r));
        }
        Expr::Closure(_, body, _) => {
            // Closures capture variables from the enclosing scope. Check the
            // body in a new scope -- captured variables are treated as
            // borrowed from the outer scope.
            push_scope(self);
            // Collect identifiers used in the body that are NOT params or
            // locals declared inside the closure. These are captures.
            var captured: Vec<str> = Vec::new();
            var b: i64 = 0;
            while b < body.len() {
                collect_captures_stmt_fd(body.get(b), &mut captured);
                b = b + 1;
            }
            // Collect identifiers that are assigned to (for mutable capture).
            var assigned: Vec<str> = Vec::new();
            b = 0;
            while b < body.len() {
                collect_assigned_stmt_fd(body.get(b), &mut assigned);
                b = b + 1;
            }
            // The body first: what the closure itself does with a captured
            // variable (`v.push(x)`, `n = n + 1`) goes through its own
            // capture, so it must not conflict with that capture's borrow
            // (B19: a closure that pushed to a captured Vec was refused with
            // "cannot mutate v"). Borrows held outside still apply.
            // The captures' borrows are made on the closure's line (bug 42:
            // borrow errors said "line 0"), not on its body's last statement.
            var closure_line: i64 = self.stmt_line;
            b = 0;
            while b < body.len() {
                check_stmt(self, body.get(b));
                b = b + 1;
            }
            self.stmt_line = closure_line;
            // Then record a borrow for each captured variable that exists in
            // an outer scope (a conflict with a borrow held outside is
            // reported here); the closure's scope releases them.
            var ci: i64 = 0;
            while ci < captured.len() {
                var cap: str = captured.get(ci);
                // Check if this variable exists in the outer scope.
                var in_outer: bool = false;
                var si: i64 = 0;
                while si < self.scope_stack.len() - 1 {
                    var scope: Vec<str> = self.scope_stack.get(si).items;
                    var sji: i64 = 0;
                    while sji < scope.len() {
                        if scope.get(sji) == cap {
                            in_outer = true;
                        }
                        sji = sji + 1;
                    }
                    si = si + 1;
                }
                if in_outer && self.unsafe_depth == 0 {
                    var is_mut: bool = bc_vec_contains_str(assigned, cap);
                    var borrower: str = "__closure_capture_" + cap;
                    create_borrow(self, cap, borrower, is_mut, self.stmt_line);
                    scope_stack_push_name(self, borrower);
                }
                ci = ci + 1;
            }
            pop_scope(self);
        }
        // Other expression variants -- recurse into children if any.
        // Fallback: nothing to do for leaf expressions we haven't matched.
        _ => {
        }
    }
}

// --- maybe_record_borrow_from_expr ----------------------------------------

// If expr is a Ref expression, record the borrow with name as the borrower.
// Called from Stmt::Let after the variable is declared. This "promotes" the
// temporary borrow created by check_expr into a named borrow tied to the
// variable. The temp is released first to avoid a double-borrow.
fn maybe_record_borrow_from_expr(self: &mut BorrowChecker, name: str, expr: Expr, line: i64) -> void {
    match expr {
        Expr::Ref(inner, is_mut) => {
            if self.unsafe_depth == 0 {
                var path_opt: OptStr = extract_field_path(bc_box_expr_unbox(inner));
                match path_opt {
                    OptStr::Some(path) => {
                        // Release the temp borrow that check_expr created for
                        // this Ref. It's the most recent temp (highest index).
                        if self.temp_counter > 0 {
                            var last_temp: str = "__tmp_ref_" + int_to_str(self.temp_counter - 1);
                            release_borrow_by(self, last_temp);
                            scope_stack_remove_name(self, last_temp);
                            self.temp_counter = self.temp_counter - 1;
                        }
                        // Now create the named borrow.
                        create_borrow(self, path, name, is_mut, line);
                        HashMap_insert(self.ref_vars, name, 1);
                    }
                    OptStr::None => {
                    }
                }
            }
        }
        Expr::Call(callee, args) => {
            // LG3: a call whose signature ties its result to an argument
            // (the call's own temporary borrows are already released)
            bc_record_call_borrow(self, name, callee, args, line);
        }
        Expr::MethodCall(recv, method, args) => {
            // LG3: likewise a method call; the receiver is parameter 0
            bc_record_method_borrow(self, name, bc_box_expr_unbox(recv), method, args, line);
        }
        Expr::StructLit(sname, fields, _) => {
            // LG3: a struct with lifetime parameters holds the references
            // its fields are given (check_expr released their temporaries)
            bc_record_struct_borrow(self, name, sname, fields, line);
        }
        Expr::Ident(src) => {
            // LG3: `val w = v` where v holds borrows (a reference, or a
            // struct holding one): w borrows the same; a `&mut` moves to w
            if self.unsafe_depth == 0 && src != name {
                var passed: i64 = bc_pass_on(self, name, src, 0, line);
                if passed > 0 && HashMap_get(self.ref_vars, src) > 0 {
                    HashMap_insert(self.ref_vars, name, 1);
                }
            }
        }
        _ => {
        }
    }
}

// --- pattern_bindings -----------------------------------------------------

// Extract variable names bound by a match pattern.
pub fn pattern_bindings(p: Pattern) -> Vec<str> {
    match p {
        Pattern::Ident(name) => {
            var result: Vec<str> = Vec::new();
            result.push(name);
            return result;
        }
        Pattern::EnumVariant(_, _, bindings) => {
            var result: Vec<str> = Vec::new();
            var i: i64 = 0;
            while i < bindings.len() {
                result.push(bindings.get(i).name);
                i = i + 1;
            }
            return result;
        }
        _ => {
            var result: Vec<str> = Vec::new();
            return result;
        }
    }
}

// --- str_to_lower helper --------------------------------------------------

// Convert a string to lowercase (ASCII only).
pub fn str_to_lower(s: str) -> str {
    var len: i64 = str_len(s);
    var result: str = "";
    var i: i64 = 0;
    while i < len {
        var b: i64 = String_byte_at(s, i);
        if b >= 65 && b <= 90 {
            // 'A' = 65, 'Z' = 90 -> add 32 for lowercase
            b = b + 32;
        }
        result = result + char_to_str(b);
        i = i + 1;
    }
    return result;
}

// --- Closure capture helpers (Issue 8) -----------------------------------

// Collect identifiers used in a statement that are NOT locals (params or
// locally-declared variables). These are closure captures.
fn collect_captures_stmt_fd(stmt: Stmt, captured: &mut Vec<str>) -> void {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _, _) => {
            collect_captures_expr_fd(expr, captured);
        }
        Stmt::Assign(target, _, expr, _) => {
            // target is a captured variable if it's not a local.
            // We don't know locals here (no param set), so we collect all
            // idents and let the caller filter. But we do need to track
            // the target as a potential capture for read-before-write.
            collect_captures_expr_fd(expr, captured);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            collect_captures_expr_fd(object, captured);
            collect_captures_expr_fd(expr, captured);
        }
        Stmt::Expr(e, _) => {
            collect_captures_expr_fd(e, captured);
        }
        Stmt::Return(opt_e, _) => {
            match opt_e {
                OptBoxExpr::Some(e) => {
                    collect_captures_expr_fd(bc_box_expr_unbox(e), captured);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            collect_captures_expr_fd(cond, captured);
            var i: i64 = 0;
            while i < then_block.len() {
                collect_captures_stmt_fd(then_block.get(i), captured);
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        collect_captures_stmt_fd(eb.get(j), captured);
                        j = j + 1;
                    }
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(cond, body, _) => {
            collect_captures_expr_fd(cond, captured);
            var i: i64 = 0;
            while i < body.len() {
                collect_captures_stmt_fd(body.get(i), captured);
                i = i + 1;
            }
        }
        Stmt::For(_, iterator, body, _) => {
            collect_captures_expr_fd(iterator, captured);
            var i: i64 = 0;
            while i < body.len() {
                collect_captures_stmt_fd(body.get(i), captured);
                i = i + 1;
            }
        }
        _ => {
        }
    }
}

fn collect_captures_expr_fd(expr: Expr, captured: &mut Vec<str>) -> void {
    match expr {
        Expr::Ident(name) => {
            if !bc_vec_contains_str(captured, name) {
                captured.push(name);
            }
        }
        Expr::FieldAccess(e, _) => {
            collect_captures_expr_fd(bc_box_expr_unbox(e), captured);
        }
        Expr::Index(arr, idx) => {
            collect_captures_expr_fd(bc_box_expr_unbox(arr), captured);
            collect_captures_expr_fd(bc_box_expr_unbox(idx), captured);
        }
        Expr::Call(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                collect_captures_expr_fd(args.get(i), captured);
                i = i + 1;
            }
        }
        Expr::MethodCall(recv, _, args) => {
            collect_captures_expr_fd(bc_box_expr_unbox(recv), captured);
            var i: i64 = 0;
            while i < args.len() {
                collect_captures_expr_fd(args.get(i), captured);
                i = i + 1;
            }
        }
        Expr::Binary(_, left, right) => {
            collect_captures_expr_fd(bc_box_expr_unbox(left), captured);
            collect_captures_expr_fd(bc_box_expr_unbox(right), captured);
        }
        Expr::Unary(_, e) => {
            collect_captures_expr_fd(bc_box_expr_unbox(e), captured);
        }
        Expr::Ref(e, _) => {
            collect_captures_expr_fd(bc_box_expr_unbox(e), captured);
        }
        _ => {
        }
    }
}

// Local vec_contains_str (not imported from typechecker.fd).
fn bc_vec_contains_str(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Collect identifiers that are assigned to in a statement (for mutable capture).
fn collect_assigned_stmt_fd(stmt: Stmt, assigned: &mut Vec<str>) -> void {
    match stmt {
        Stmt::Assign(target, _, _, _) => {
            if !bc_vec_contains_str(assigned, target) {
                assigned.push(target);
            }
        }
        Stmt::FieldAssign(object, _, _, _, _) => {
            match object {
                Expr::Ident(name) => {
                    if !bc_vec_contains_str(assigned, name) {
                        assigned.push(name);
                    }
                }
                _ => {
                }
            }
        }
        Stmt::If(_, then_block, else_block, _) => {
            var i: i64 = 0;
            while i < then_block.len() {
                collect_assigned_stmt_fd(then_block.get(i), assigned);
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        collect_assigned_stmt_fd(eb.get(j), assigned);
                        j = j + 1;
                    }
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(_, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_assigned_stmt_fd(body.get(i), assigned);
                i = i + 1;
            }
        }
        Stmt::For(_, _, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_assigned_stmt_fd(body.get(i), assigned);
                i = i + 1;
            }
        }
        _ => {
        }
    }
}
