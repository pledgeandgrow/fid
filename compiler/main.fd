// main.fd -- CLI entry point for the self-hosted Fides compiler.
//
// Supports: ccompile, build, emit, run, tokens, dump-tokens, ast, dump-ast,
//           ir, dump-ir, dump-c, pir, dump-pir, opt, fmt, version, test,
//           bench, lint, lsp
//
// Usage: fid <command> <file.fd> [options]

module compiler::main;

use core;
use vec;
use string;
use compiler::ast;
use compiler::token;
use compiler::lexer;
use compiler::parser;
use compiler::ir;
use compiler::pir;
use compiler::opt;
use compiler::compiler;
use compiler::inc;
use compiler::pe;
use compiler::pe_ir;
use compiler::fmt;
use compiler::lower;
use compiler::scribe;
use compiler::veil;
use compiler::tensor;
use compiler::gpu;
use compiler::wasm;
use compiler::lsp;
use compiler::ark;
use compiler::codegen_x64;
use compiler::codegen_arm64;
use compiler::codegen_riscv;
use compiler::peephole;
use compiler::elf64;
use compiler::coff;
use compiler::macho;
use compiler::cparser;

// --- Global flag state ---------------------------------------------------
// Parsed from --borrowck= and --timeout flags before command dispatch.
// Fides does not support module-level mutable vars, so these are passed
// as extra parameters to command handlers that need them.
// g_borrowck: "on" (default), "warn", or "off"
// g_timeout: 0 = no timeout (default), >0 = seconds before kill

pub fn main() -> i64 {
    var n: i64 = p_argc();

    // Two invocation modes:
    //   Interpreter: fidesc run main.fd -- ccompile <file.fd> -o <output>
    //   Native:      fid ccompile <file.fd> -o <output>
    // Find the "--" separator (interpreter mode) or start at argv[1] (native).
    var start: i64 = 1;
    var i: i64 = 0;
    while i < n {
        if p_argv(i) == "--" {
            start = i + 1;
            break;
        }
        i = i + 1;
    }

    if start >= n {
        print_usage();
        return 1;
    }

    // --- Parse global flags (before command dispatch) -------------------
    // Reference: src/main.rs:57-99
    // --borrowck=off|warn|on  controls borrow checker mode
    // --timeout N / --timeout=N  sets compilation timeout in seconds
    // These can appear anywhere in the args. We scan for them, store the
    // values, and skip them so command-specific parsing isn't confused.
    var g_borrowck: str = "on";
    var g_timeout: i64 = 0;
    var gi: i64 = start;
    while gi < n {
        var garg: str = p_argv(gi);
        // --borrowck=off|warn|on
        if str_starts_with(garg, "--borrowck=") {
            var bval: str = str_substring_from(garg, 11);
            match borrowck_mode_parse(bval) {
                OptBorrowckMode::Some(mode) => {
                    match mode {
                        BorrowckMode::Off => { g_borrowck = "off"; }
                        BorrowckMode::Warn => { g_borrowck = "warn"; }
                        BorrowckMode::On => { g_borrowck = "on"; }
                    }
                }
                OptBorrowckMode::None => {
                    p_eprint_str("Invalid --borrowck value '");
                    p_eprint_str(bval);
                    p_eprint_str("'. Use off, warn, or on.\n");
                    return 1;
                }
            }
        }
        // --timeout=N
        if str_starts_with(garg, "--timeout=") {
            var tval: str = str_substring_from(garg, 10);
            var tsecs: i64 = c_str_parse_i64(tval);
            if tsecs > 0 { g_timeout = tsecs; }
        }
        // --timeout N (value is next arg)
        if garg == "--timeout" {
            if gi + 1 < n {
                var tnext: str = p_argv(gi + 1);
                var tsecs2: i64 = c_str_parse_i64(tnext);
                if tsecs2 > 0 { g_timeout = tsecs2; }
            }
        }
        gi = gi + 1;
    }

    // Find the actual command (first non-flag argument)
    var cmd_idx: i64 = start;
    while cmd_idx < n {
        var cmd_arg: str = p_argv(cmd_idx);
        if !str_starts_with(cmd_arg, "--") {
            break;
        }
        cmd_idx = cmd_idx + 1;
    }
    start = cmd_idx;

    // TODO: --timeout requires spawning a watcher thread to kill the process
    // after N seconds. Fides is single-threaded for now, so we store the
    // value but cannot enforce it. When p_thread_spawn supports timers,
    // wire this up. Reference: src/main.rs:103-109.

    var command: str = p_argv(start);

    if command == "compile" { return cmd_compile(n, start, g_borrowck, g_timeout); }
    if command == "ccompile" { return cmd_ccompile(n, start, g_borrowck, g_timeout); }
    if command == "build" { return cmd_build(n, start, g_borrowck, g_timeout); }
    if command == "emit" { return cmd_build(n, start, g_borrowck, g_timeout); }
    if command == "build-x86" { return cmd_build_x86(n, start); }
    if command == "run" { return cmd_run(n, start, g_borrowck, g_timeout); }
    if command == "tokens" { return cmd_tokens(n, start); }
    if command == "dump-tokens" { return cmd_tokens(n, start); }
    if command == "ast" { return cmd_ast(n, start); }
    if command == "dump-ast" { return cmd_ast(n, start); }
    if command == "dump-ast-raw" { return cmd_ast(n, start); }
    if command == "dump-ast-flat" { return cmd_ast(n, start); }
    if command == "ir" { return cmd_ir(n, start); }
    if command == "dump-ir" { return cmd_ir(n, start); }
    if command == "dump-c" { return cmd_dump_c(n, start); }
    if command == "pir" { return cmd_pir(n, start); }
    if command == "dump-pir" { return cmd_pir(n, start); }
    if command == "opt" { return cmd_opt(n, start); }
    if command == "fmt" { return cmd_fmt(n, start); }
    if command == "version" { return cmd_version(); }
    if command == "test" { return cmd_test(n, start); }
    if command == "bench" { return cmd_bench(n, start); }
    if command == "profile" { return cmd_profile(n, start); }
    if command == "lint" { return cmd_lint(n, start); }
    if command == "wasm" { return cmd_wasm(n, start); }
    if command == "watch" { return cmd_bench(n, start); }
    if command == "lsp" { return lsp_run(); }
    if command == "scribe" { return cmd_scribe(n, start); }
    if command == "veil" { return cmd_veil(n, start); }
    if command == "ark" { return ark_main(); }
    if command == "repl" { return cmd_repl(); }
    if command == "codegen" { return cmd_codegen(n, start); }
    if command == "gpu" { return cmd_gpu(n, start); }
    if command == "verify" || command == "audit" { return cmd_verify(n, start); }
    if command == "sourcemap" { return cmd_sourcemap(n, start); }
    if command == "parse-header" { return cmd_parse_header(n, start); }
    if command == "notebook" { return cmd_notebook(n, start); }

    print("Unknown command: ");
    print(command);
    print("\n");
    print_usage();
    return 1;
}

// --- Helper: substring from index -----------------------------------------
fn str_substring_from(s: str, start: i64) -> str {
    var slen: i64 = str_len(s);
    if start >= slen { return ""; }
    if start < 0 { start = 0; }
    return str_slice(s, start, slen);
}

// --- Helper: check if a string arg is in the args list --------------------
fn has_flag(n: i64, start: i64, flag: str) -> bool {
    var i: i64 = start + 2;
    while i < n {
        if p_argv(i) == flag { return true; }
        i = i + 1;
    }
    return false;
}

// --- Helper: get value after a flag ---------------------------------------
fn get_flag_value(n: i64, start: i64, flag: str, default: str) -> str {
    var i: i64 = start + 2;
    while i < n {
        if p_argv(i) == flag {
            if i + 1 < n {
                return p_argv(i + 1);
            }
        }
        i = i + 1;
    }
    return default;
}

// --- Helper: get numeric value after a flag -------------------------------
fn get_flag_int(n: i64, start: i64, flag: str, default: i64) -> i64 {
    var i: i64 = start + 2;
    while i < n {
        if p_argv(i) == flag {
            if i + 1 < n {
                return c_str_parse_i64(p_argv(i + 1));
            }
        }
        i = i + 1;
    }
    return default;
}

// --- Helper: find -o flag value ------------------------------------------
fn find_output_arg(n: i64, start: i64, default: str) -> str {
    var i: i64 = start + 2;
    while i < n {
        var arg: str = p_argv(i);
        if arg == "-o" {
            if i + 1 < n {
                return p_argv(i + 1);
            }
        }
        i = i + 1;
    }
    return default;
}

// --- Helper: ensure output has appropriate extension ---------------------
// On Linux, executables don't need an extension.
// On Windows, append .exe if not already present.
fn ensure_exe_extension(s: str) -> str {
    if is_linux() {
        return s;
    }
    if str_ends_with(s, ".exe") {
        return s;
    }
    return s + ".exe";
}

// --- Helper: detect Linux platform ----------------------------------------
fn is_linux() -> bool {
    // Check for /proc/self/exe which exists on Linux
    return c_file_exists("/proc/self/exe");
}

// --- Helper: read source file or error -----------------------------------
fn read_source_or_error(path: str) -> str {
    var source: str = c_file_read(path);
    if str_len(source) == 0 {
        return "";
    }
    return source;
}

// --- Helper: print errors from Vec<str> ----------------------------------
fn print_errors(errs: Vec<str>) {
    var ei: i64 = 0;
    while ei < errs.len() {
        p_eprint_str("error: ");
        p_eprint_str(errs.get(ei));
        p_eprint_str("\n");
        ei = ei + 1;
    }
}

// --- version -------------------------------------------------------------
fn cmd_version() -> i64 {
    print("fid 0.1.0 (self-hosted Fides compiler)\n");
    print("Bootstrap: Rust compiler -> C -> compiled by itself to a fixpoint\n");
    return 0;
}

// --- tokens / dump-tokens ------------------------------------------------
fn cmd_tokens(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid tokens <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var lexer_obj: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lexer_obj.tokenize();
    var ti: i64 = 0;
    while ti < tokens.len() {
        var tok: Token = tokens.get(ti);
        // Format: "  LINE:COL  KIND"
        var line_str: str = int_to_str(tok.line);
        var col_str: str = int_to_str(tok.col);
        var kind_str: str = token_kind_to_str(tok.kind);
        // Pad line to 4 chars, col to 3 chars
        line_str = c_str_pad_left(line_str, 4, 32);
        col_str = c_str_pad_left(col_str, 3, 32);
        print(line_str);
        print(":");
        print(col_str);
        print("  ");
        print(kind_str);
        print("\n");
        ti = ti + 1;
    }
    return 0;
}

// --- ast / dump-ast ------------------------------------------------------
fn cmd_ast(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid ast <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    // Parse without merging stdlib -- just show user AST
    var result: ResultProgram = build_program_with_path(source, OptStr::Some(input));
    match result {
        ResultProgram::Ok(program) => {
            // Print a simple summary (no full AST formatter yet)
            print("Program:\n");
            print("  Structs: ");
            print(int_to_str(program.structs.len()));
            print("\n");
            print("  Enums: ");
            print(int_to_str(program.enums.len()));
            print("\n");
            print("  Functions: ");
            print(int_to_str(program.funcs.len()));
            print("\n");
            var si: i64 = 0;
            while si < program.funcs.len() {
                var fn_def: Func = program.funcs.get(si);
                print("    fn ");
                print(fn_def.name);
                print("\n");
                si = si + 1;
            }
            return 0;
        }
        ResultProgram::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- ir / dump-ir --------------------------------------------------------
fn cmd_ir(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid ir <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var result: ResultIrModule = lower_to_ir_module(source);
    match result {
        ResultIrModule::Ok(ir_mod) => {
            print(IrModule_to_str(&ir_mod));
            print("\n");
            return 0;
        }
        ResultIrModule::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- dump-c --------------------------------------------------------------
fn cmd_dump_c(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid dump-c <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var result: ResultStr = ccompile_source_with_path(source, input, "on");
    match result {
        ResultStr::Ok(c_code) => {
            print(c_code);
            return 0;
        }
        ResultStr::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- pir / dump-pir ------------------------------------------------------
fn cmd_pir(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid pir <file.fd> [1|2|3|all] [--opt]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var level_arg: str = "2";
    if start + 3 <= n {
        level_arg = p_argv(start + 2);
    }
    var want_opt: bool = false;
    var ai: i64 = start + 2;
    while ai < n {
        if p_argv(ai) == "--opt" { want_opt = true; }
        ai = ai + 1;
    }

    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var result: ResultIrModule = lower_to_ir_module(source);
    match result {
        ResultIrModule::Ok(ir_mod) => {
            var level: PirLevel = PirLevel::L2;
            var opt_level: OptPirLevel = PirLevel_parse(level_arg);
            match opt_level {
                OptPirLevel::Some(l) => { level = l; }
                OptPirLevel::None => { level = PirLevel::L2; }
            }
            match level {
                PirLevel::L1 => {
                    var l1: L1Module = lower_ir_to_l1(&ir_mod);
                    print(format_l1(&l1));
                }
                PirLevel::L2 => {
                    var l1: L1Module = lower_ir_to_l1(&ir_mod);
                    var l2: L2Module = lower_l1_to_l2(&l1);
                    if want_opt {
                        var stats: OptStats = optimize_l2(&mut l2);
                        p_eprint_str(";; optimization stats: ");
                        p_eprint_str(int_to_str(stats.iterations));
                        p_eprint_str(" iterations\n");
                    }
                    print(format_l2(&l2));
                }
                PirLevel::L3 => {
                    var l1: L1Module = lower_ir_to_l1(&ir_mod);
                    var l2: L2Module = lower_l1_to_l2(&l1);
                    var l3: L3Module = lower_l2_to_l3(&l2, &ir_mod);
                    print(format_l3(&l3));
                }
                PirLevel::All => {
                    var l1: L1Module = lower_ir_to_l1(&ir_mod);
                    var l2: L2Module = lower_l1_to_l2(&l1);
                    if want_opt {
                        var stats: OptStats = optimize_l2(&mut l2);
                    }
                    var l3: L3Module = lower_l2_to_l3(&l2, &ir_mod);
                    print(format_l1(&l1));
                    print("\n");
                    print(format_l2(&l2));
                    print("\n");
                    print(format_l3(&l3));
                }
            }
            return 0;
        }
        ResultIrModule::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- opt -----------------------------------------------------------------
fn cmd_opt(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid opt <file.fd> [pass1,pass2,...]\n");
        p_eprint_str("       passes: const-fold, cse, dce, inline, unroll, tco\n");
        p_eprint_str("       default: all passes to fixed point\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var result: ResultIrModule = lower_to_ir_module(source);
    match result {
        ResultIrModule::Ok(ir_mod) => {
            var l1: L1Module = lower_ir_to_l1(&ir_mod);
            var l2: L2Module = lower_l1_to_l2(&l1);
            var stats: OptStats = optimize_l2(&mut l2);
            print(format_l2(&l2));
            p_eprint_str(";; optimization stats: ");
            p_eprint_str(int_to_str(stats.iterations));
            p_eprint_str(" iterations\n");
            return 0;
        }
        ResultIrModule::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- fmt -----------------------------------------------------------------
fn cmd_fmt(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid fmt <file.fd> [--check]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var check_mode: bool = false;
    var ai: i64 = start + 2;
    while ai < n {
        if p_argv(ai) == "--check" { check_mode = true; }
        ai = ai + 1;
    }
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var formatted: str = format_source(source);
    if check_mode {
        if formatted == source {
            p_eprint_str(input);
            p_eprint_str(": already formatted\n");
            return 0;
        } else {
            p_eprint_str(input);
            p_eprint_str(": would reformat\n");
            return 1;
        }
    } else {
        p_file_write(input, formatted);
        if formatted == source {
            p_eprint_str(input);
            p_eprint_str(": already formatted\n");
        } else {
            p_eprint_str(input);
            p_eprint_str(": formatted\n");
        }
        return 0;
    }
    return 1;
}

// --- run -----------------------------------------------------------------
// Reference: src/main.rs:389
// Interprets the source file using the self-hosted IR interpreter.
// Flags: -v/--verbose, --release, --max-recursion N, --max-steps N,
//        --max-memory N, --timeout N, --trace
fn cmd_run(n: i64, start: i64, g_borrowck: str, g_timeout: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid run <file.fd> [-v] [--release] [--max-recursion N] [--max-steps N] [--max-memory N] [--timeout N] [--trace]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);

    // Parse run-specific flags
    var verbose: bool = has_flag(n, start, "-v") || has_flag(n, start, "--verbose");
    var release: bool = has_flag(n, start, "--release");
    var trace: bool = has_flag(n, start, "--trace");
    // --max-recursion N (default 1000, 0 = unlimited)
    var max_recursion: i64 = get_flag_int(n, start, "--max-recursion", 1000);
    // --max-steps N (default 0 = unlimited)
    var max_steps: i64 = get_flag_int(n, start, "--max-steps", 0);
    // --max-memory N (in MB, default 0 = unlimited)
    var max_memory: i64 = get_flag_int(n, start, "--max-memory", 0);
    // --timeout N (execution timeout in seconds)
    var run_timeout: i64 = get_flag_int(n, start, "--timeout", g_timeout);

    if verbose {
        p_eprint_str("[run] File: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        p_eprint_str("[run] release: ");
        if release { p_eprint_str("yes"); } else { p_eprint_str("no"); }
        p_eprint_str(", trace: ");
        if trace { p_eprint_str("yes"); } else { p_eprint_str("no"); }
        p_eprint_str("\n");
        p_eprint_str("[run] max-recursion: ");
        p_eprint_str(int_to_str(max_recursion));
        p_eprint_str(", max-steps: ");
        p_eprint_str(int_to_str(max_steps));
        p_eprint_str(", max-memory: ");
        p_eprint_str(int_to_str(max_memory));
        p_eprint_str(" MB\n");
        if run_timeout > 0 {
            p_eprint_str("[run] timeout: ");
            p_eprint_str(int_to_str(run_timeout));
            p_eprint_str(" seconds\n");
        }
    }

    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }

    // Use the self-hosted IR interpreter for the `run` command.
    // This replaces the previous C compile-and-execute fallback.
    // --max-recursion, --max-steps, --max-memory, --trace are wired
    // into the interpreter's execution limits.
    if verbose {
        p_eprint_str("[run] Using IR interpreter\n");
    }

    // Convert max_memory from MB to bytes
    var max_memory_bytes: i64 = max_memory * 1048576;

    // G8.2: Pass borrowck mode through the pipeline (globals don't persist in C codegen)
    return interpret_source_with_path(source, input, max_recursion, max_steps, max_memory_bytes, verbose, g_borrowck);
}

// --- test ----------------------------------------------------------------
// Reference: src/main.rs:1384
// Scans tests/bootstrap/ directory for .fd files, compiles and runs each.
// Flags: --fail (expect test to fail)
// Backends: C codegen (tcc), PE emitter. TODO: interpreter backend.
fn cmd_test(n: i64, start: i64) -> i64 {
    // --fail: run only expected-fail tests (failing = correct)
    var fail_only: bool = has_flag(n, start, "--fail");

    p_eprint_str("[test] Scanning tests/bootstrap/ directory...\n");

    // Use ls/dir command to list .fd files, redirect to temp file
    if is_linux() {
        p_system("ls tests/bootstrap/*.fd > _fides_test_list.txt 2>/dev/null");
    } else {
        p_system("dir /b tests\\bootstrap\\*.fd > _fides_test_list.txt 2>nul");
    }
    var listing: str = c_file_read("_fides_test_list.txt");
    if str_len(listing) == 0 {
        if fail_only {
            p_eprint_str("No expected-fail tests found in tests/bootstrap/\n");
        } else {
            p_eprint_str("No .fd test files found in tests/bootstrap/\n");
        }
        return 1;
    }

    // Parse file listing (one filename per line; skip blank lines)
    var listed: Vec<str> = c_str_lines(listing);
    var files: Vec<str> = Vec::new();
    var li: i64 = 0;
    while li < listed.len() {
        if str_len(listed.get(li)) > 0 { files.push(listed.get(li)); }
        li = li + 1;
    }
    if files.len() == 0 {
        if fail_only {
            p_eprint_str("No expected-fail tests found in tests/bootstrap/\n");
        } else {
            p_eprint_str("No .fd test files found in tests/bootstrap/\n");
        }
        return 1;
    }

    // Known-fail tests: these test compiler error detection.
    // They SHOULD fail to compile/run -- failing is the correct behavior.
    // Reference: src/main.rs:1398-1453
    var expected_fail: Vec<str> = Vec::new();
    expected_fail.push("test_trait_verify_fail");
    expected_fail.push("test_budget_fail");
    expected_fail.push("test_sandbox_fail");
    expected_fail.push("test_deterministic_fail");
    expected_fail.push("test_field_privacy_fail");
    expected_fail.push("test_money_linear_fail");
    expected_fail.push("test_money_conserve_fail");
    expected_fail.push("test_banking_double_credit_fail");
    expected_fail.push("test_banking_lost_money_fail");
    expected_fail.push("test_loop_linear_fail");
    expected_fail.push("test_gas_fail");
    expected_fail.push("test_crashfree_fail");
    expected_fail.push("test_txn_rollback_fail");
    expected_fail.push("test_typed_strings_fail");
    expected_fail.push("test_init_guarantee_fail");
    expected_fail.push("test_init_guarantee_cond_fail");
    expected_fail.push("test_param_queries_fail");
    expected_fail.push("test_medical_fail");
    expected_fail.push("test_contracts_fail");
    expected_fail.push("test_safety_annotations_fail");
    expected_fail.push("test_safety_no_audit_fail");
    expected_fail.push("test_borrowck_fail");
    expected_fail.push("test_async_fail");
    expected_fail.push("test_constant_time_fail");
    expected_fail.push("test_constant_time_fail2");
    expected_fail.push("test_send_fail");
    expected_fail.push("test_gpu_region_fail");
    expected_fail.push("test_shape_verify_fail");
    expected_fail.push("test_realtime_fail");
    expected_fail.push("test_realtime_fail2");
    expected_fail.push("test_autodiff_fail");
    expected_fail.push("test_kv_cache_fail");
    expected_fail.push("test_val_assign_fail");
    expected_fail.push("test_const_assign_fail");
    expected_fail.push("test_match_nonexhaustive_fail");
    expected_fail.push("test_vec_elem_fail");
    expected_fail.push("test_str_int_fail");
    expected_fail.push("test_crashfree_method_fail");
    expected_fail.push("test_double_free_fail");
    expected_fail.push("test_bad_free_fail");
    expected_fail.push("test_quantization_fail");
    expected_fail.push("test_checkpoint_fail");
    expected_fail.push("test_dp_fail");
    expected_fail.push("test_shard_fail");
    expected_fail.push("test_vec_shape_fail");
    // @constant_time: data-dependent branch on secret — rejected by the
    // source-level checker (not just the asm verifier)
    expected_fail.push("test_ct_asm_fail");

    // Skip list -- tests that fail on C codegen due to missing builtins
    // or legitimate design differences. These pass on interpreter + PE.
    // Reference: src/main.rs:1543-1545
    var skip_tests: Vec<str> = Vec::new();
    // All previously skipped tests now pass on C codegen!

    // Filter test files based on --fail mode
    var test_files: Vec<str> = Vec::new();
    var ffi: i64 = 0;
    while ffi < files.len() {
        var fname: str = files.get(ffi);
        var stem: str = fname;
        // Strip .fd extension
        if str_ends_with(stem, ".fd") {
            stem = str_slice(stem, 0, str_len(stem) - 3);
        }
        var is_fail: bool = str_vec_contains_str(expected_fail, stem);
        var is_bench: bool = str_starts_with(stem, "bench_");

        if fail_only {
            if is_fail {
                test_files.push(fname);
            }
        } else {
            if !is_fail && !is_bench {
                test_files.push(fname);
            }
        }
        ffi = ffi + 1;
    }

    if test_files.len() == 0 {
        if fail_only {
            p_eprint_str("No expected-fail tests found in tests/bootstrap/\n");
        } else {
            p_eprint_str("No .fd test files found in tests/bootstrap/\n");
        }
        return 1;
    }

    var batch_label: str = "normal";
    if fail_only { batch_label = "expected-fail"; }
    p_eprint_str("[test] Running ");
    p_eprint_str(int_to_str(test_files.len()));
    p_eprint_str(" ");
    p_eprint_str(batch_label);
    p_eprint_str(" tests...\n\n");

    // Multi-backend test runner
    // Reference: src/main.rs:1517-1530
    // TODO: The self-hosted compiler does not yet have an interpreter
    // backend. Currently we test on C codegen and PE emitter only.
    // When the interpreter is ported, add interp_pass/interp_fail counters.
    var c_pass: i64 = 0;
    var c_fail: i64 = 0;
    var pe_pass: i64 = 0;
    var pe_fail: i64 = 0;

    var fi: i64 = 0;
    while fi < test_files.len() {
        var fname: str = test_files.get(fi);
        var test_path: str = "tests\\bootstrap\\" + fname;
        var stem2: str = fname;
        if str_ends_with(stem2, ".fd") {
            stem2 = str_slice(stem2, 0, str_len(stem2) - 3);
        }

        // Skip tests for C codegen limitations
        if str_vec_contains_str(skip_tests, stem2) {
            fi = fi + 1;
            continue;
        }

        // Read and compile
        var source: str = c_file_read(test_path);
        if str_len(source) == 0 {
            p_eprint_str("  [FAIL] ");
            p_eprint_str(fname);
            p_eprint_str(" (could not read)\n");
            c_fail = c_fail + 1;
            fi = fi + 1;
            continue;
        }

        // -- Backend 1: C codegen --
        var c_ok: bool = false;
        var result: ResultStr = ccompile_source_with_path(source, test_path, "on");
        match result {
            ResultStr::Ok(c_code) => {
                var c_file: str = "_fides_test_tmp.c";
                p_file_write(c_file, c_code);
                var exe_name: str = "_fides_test_tmp.exe";
                if is_linux() { exe_name = "_fides_test_tmp"; }
                var cc: str = env_or_empty("CC");
                if str_len(cc) == 0 {
                    if is_linux() { cc = "gcc"; } else { cc = "tcc"; }
                }
                var cc_cmd: str = "";
                if is_linux() {
                    cc_cmd = cc + " -O2 -w -o " + exe_name + " " + c_file + " -lm";
                } else {
                    cc_cmd = cc + " -O2 -w -o " + exe_name + " " + c_file + " -lws2_32";
                }
                var ret: i64 = p_system(cc_cmd);
                if ret != 0 {
                    c_ok = false;
                } else {
                    var run_ret: i64 = p_system(exe_name);
                    c_ok = run_ret == 0;
                }
            }
            ResultStr::Err(errs) => {
                c_ok = false;
            }
        }

        // -- Backend 2: PE emitter --
        // TODO: PE emitter test would require building and running the PE.
        // For now, just check that compilation succeeds (parse + typecheck).
        var pe_ok: bool = false;
        var pe_result: ResultProgram = build_program_with_path(source, OptStr::Some(test_path));
        match pe_result {
            ResultProgram::Ok(program) => {
                pe_ok = true;
            }
            ResultProgram::Err(errs) => {
                pe_ok = false;
            }
        }

        // Report results
        if fail_only {
            // For expected-fail tests, failing is correct
            if !c_ok {
                p_eprint_str("  [PASS] ");
                p_eprint_str(fname);
                p_eprint_str(" (C: correctly failed)\n");
                c_pass = c_pass + 1;
            } else {
                p_eprint_str("  [FAIL] ");
                p_eprint_str(fname);
                p_eprint_str(" (C: should have failed)\n");
                c_fail = c_fail + 1;
            }
        } else {
            if c_ok {
                p_eprint_str("  [PASS] ");
                p_eprint_str(fname);
                p_eprint_str(" (C");
                if pe_ok { p_eprint_str("+PE"); }
                p_eprint_str(")\n");
                c_pass = c_pass + 1;
                if pe_ok { pe_pass = pe_pass + 1; }
            } else {
                p_eprint_str("  [FAIL] ");
                p_eprint_str(fname);
                p_eprint_str(" (C");
                if pe_ok { p_eprint_str(", PE ok"); } else { p_eprint_str("+PE"); }
                p_eprint_str(")\n");
                c_fail = c_fail + 1;
                if !pe_ok { pe_fail = pe_fail + 1; }
            }
        }
        fi = fi + 1;
    }

    // Clean up
    if is_linux() {
        p_system("rm -f _fides_test_list.txt _fides_test_tmp.c _fides_test_tmp");
    } else {
        p_system("del _fides_test_list.txt");
        p_system("del _fides_test_tmp.c");
        p_system("del _fides_test_tmp.exe");
    }

    p_eprint_str("\n=== Results ===\n");
    p_eprint_str("C codegen:  ");
    p_eprint_str(int_to_str(c_pass));
    p_eprint_str(" passed, ");
    p_eprint_str(int_to_str(c_fail));
    p_eprint_str(" failed\n");
    p_eprint_str("PE emitter: ");
    p_eprint_str(int_to_str(pe_pass));
    p_eprint_str(" passed, ");
    p_eprint_str(int_to_str(pe_fail));
    p_eprint_str(" failed\n");
    // TODO: Add interpreter backend results when ported.

    if c_fail > 0 { return 1; }
    return 0;
}

// --- Helper: check if a string is in a Vec<str> ---------------------------
fn str_vec_contains_str(vec: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < vec.len() {
        if vec.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

// --- bench ---------------------------------------------------------------
// Compiles to C, builds with tcc, then runs N times.
fn cmd_bench(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid bench <file.fd> [-n <count>]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var count: i64 = 10;

    var ai: i64 = start + 2;
    while ai < n {
        if p_argv(ai) == "-n" {
            if ai + 1 < n {
                count = c_str_parse_i64(p_argv(ai + 1));
            }
        }
        ai = ai + 1;
    }
    if count <= 0 { count = 10; }

    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }

    // Compile to C
    var result: ResultStr = ccompile_source_with_path(source, input, "on");
    match result {
        ResultStr::Ok(c_code) => {
            var c_file: str = "_fides_bench_tmp.c";
            p_file_write(c_file, c_code);
            var exe_name: str = "_fides_bench_tmp.exe";
            if is_linux() { exe_name = "_fides_bench_tmp"; }
            var bench_cmd: str = "";
            if is_linux() {
                bench_cmd = "gcc -O2 -w -o " + exe_name + " " + c_file + " -lm";
            } else {
                bench_cmd = "tcc -O2 -w -o " + exe_name + " " + c_file + " -lws2_32";
            }
            var ret: i64 = p_system(bench_cmd);
            if ret != 0 {
                p_eprint_str("C compilation failed\n");
                return 1;
            }

            p_eprint_str("Benchmark: ");
            p_eprint_str(input);
            p_eprint_str(" (");
            p_eprint_str(int_to_str(count));
            p_eprint_str(" iterations)\n");

            var bi: i64 = 0;
            while bi < count {
                p_eprint_str("  Run ");
                p_eprint_str(int_to_str(bi + 1));
                p_eprint_str("/");
                p_eprint_str(int_to_str(count));
                p_eprint_str("... ");
                var exit_code: i64 = p_system(exe_name);
                p_eprint_str("exit=");
                p_eprint_str(int_to_str(exit_code));
                p_eprint_str("\n");
                bi = bi + 1;
            }

            // Clean up
            if is_linux() {
                p_system("rm -f _fides_bench_tmp.c _fides_bench_tmp");
            } else {
                p_system("del _fides_bench_tmp.c");
                p_system("del _fides_bench_tmp.exe");
            }

            return 0;
        }
        ResultStr::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- profile -------------------------------------------------------------
fn cmd_profile(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid profile <file.fd> [-n <count>]\n");
        p_eprint_str("  Profile: run file and report per-function timing.\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var count: i64 = 1;

    var ai: i64 = start + 2;
    while ai < n {
        if p_argv(ai) == "-n" {
            if ai + 1 < n {
                count = c_str_parse_i64(p_argv(ai + 1));
            }
        }
        ai = ai + 1;
    }
    if count <= 0 { count = 1; }

    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }

    // Compile to C, run N times, report timing
    var result: ResultStr = ccompile_source_with_path(source, input, "on");
    match result {
        ResultStr::Ok(c_code) => {
            var c_file: str = "_fides_profile_tmp.c";
            p_file_write(c_file, c_code);
            var exe_name: str = "_fides_profile_tmp.exe";
            if is_linux() { exe_name = "_fides_profile_tmp"; }
            var build_cmd: str = "";
            if is_linux() {
                build_cmd = "gcc -O2 -w -o " + exe_name + " " + c_file + " -lm";
            } else {
                build_cmd = "tcc -O2 -w -o " + exe_name + " " + c_file + " -lws2_32";
            }
            var ret: i64 = p_system(build_cmd);
            if ret != 0 {
                p_eprint_str("C compilation failed\n");
                return 1;
            }

            p_eprint_str("Profile: ");
            p_eprint_str(input);
            p_eprint_str(" (");
            p_eprint_str(int_to_str(count));
            p_eprint_str(" iteration");
            if count != 1 { p_eprint_str("s"); }
            p_eprint_str(")\n");

            var bi: i64 = 0;
            var total_ms: i64 = 0;
            while bi < count {
                var t0: i64 = p_clock_now();
                var exit_code: i64 = p_system(exe_name);
                var t1: i64 = p_clock_now();
                var elapsed_ms: i64 = (t1 - t0) / 1000000;
                total_ms = total_ms + elapsed_ms;
                p_eprint_str("  Run ");
                p_eprint_str(int_to_str(bi + 1));
                p_eprint_str("/");
                p_eprint_str(int_to_str(count));
                p_eprint_str(": ");
                p_eprint_str(int_to_str(elapsed_ms));
                p_eprint_str("ms (exit=");
                p_eprint_str(int_to_str(exit_code));
                p_eprint_str(")\n");
                bi = bi + 1;
            }

            p_eprint_str("  Total: ");
            p_eprint_str(int_to_str(total_ms));
            p_eprint_str("ms  Avg: ");
            if count > 0 {
                p_eprint_str(int_to_str(total_ms / count));
            } else {
                p_eprint_str("0");
            }
            p_eprint_str("ms\n");

            // Clean up
            if is_linux() {
                p_system("rm -f _fides_profile_tmp.c _fides_profile_tmp");
            } else {
                p_system("del _fides_profile_tmp.c");
                p_system("del _fides_profile_tmp.exe");
            }

            return 0;
        }
        ResultStr::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- repl ----------------------------------------------------------------
fn cmd_repl() -> i64 {
    p_eprint_str("fid REPL — type expressions to evaluate, :quit to exit\n\n");
    var line_num: i64 = 1;
    var running: bool = true;
    while running {
        p_eprint_str("fides:");
        p_eprint_str(int_to_str(line_num));
        p_eprint_str("> ");
        var line: str = p_read_line();
        var trimmed: str = str_trim(line);
        if str_len(trimmed) == 0 { continue; }
        if trimmed == ":quit" || trimmed == ":q" || trimmed == ":exit" {
            running = false;
            continue;
        }
        if trimmed == ":help" || trimmed == ":h" {
            p_eprint_str("Commands:\n");
            p_eprint_str("  :quit  — exit REPL\n");
            p_eprint_str("  :help  — show this help\n");
            p_eprint_str("  :ir    — show IR for last expression\n\n");
            p_eprint_str("Type a Fides expression (e.g. 1 + 2, \"hello\", [1,2,3])\n");
            continue;
        }
        // Wrap the input in a main function and interpret it
        var source: str = "fn main() -> i64 {\n    println(" + trimmed + ");\n    return 0;\n}";
        var result: ResultStr = ccompile_source_with_path(source, "<repl>", "on");
        match result {
            ResultStr::Ok(c_code) => {
                p_file_write("_fides_repl_tmp.c", c_code);
                var exe_name: str = "_fides_repl_tmp.exe";
                if is_linux() { exe_name = "_fides_repl_tmp"; }
                var build_cmd: str = "";
                if is_linux() {
                    build_cmd = "gcc -O2 -w -o " + exe_name + " _fides_repl_tmp.c -lm";
                } else {
                    build_cmd = "tcc -O2 -w -o " + exe_name + " _fides_repl_tmp.c -lws2_32";
                }
                p_system(build_cmd);
                p_system(exe_name);
                if is_linux() {
                    p_system("rm -f _fides_repl_tmp.c _fides_repl_tmp");
                } else {
                    p_system("del _fides_repl_tmp.c");
                    p_system("del _fides_repl_tmp.exe");
                }
            }
            ResultStr::Err(errs) => {
                print_errors(errs);
            }
        }
        line_num = line_num + 1;
    }
    p_eprint_str("\nBye!\n");
    return 0;
}

// --- notebook ------------------------------------------------------------
fn cmd_notebook(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid notebook <file.fd> [-o output.html]\n");
        p_eprint_str("  Renders a Fides file as an HTML notebook.\n");
        p_eprint_str("  Each /// comment block becomes a markdown cell.\n");
        p_eprint_str("  Each code block is evaluated, output rendered inline.\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var output: str = input + ".html";

    var ai: i64 = start + 2;
    while ai < n {
        if p_argv(ai) == "-o" {
            if ai + 1 < n { output = p_argv(ai + 1); }
        }
        ai = ai + 1;
    }

    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }

    // Parse the source into cells: /// comments = markdown, code = code cells
    var html: str = "<!DOCTYPE html>\n<html>\n<head>\n<title>";
    html = html + input + "</title>\n<style>\n";
    html = html + "body { font-family: monospace; max-width: 800px; margin: 20px auto; padding: 20px; }\n";
    html = html + ".cell { border: 1px solid #ccc; margin: 10px 0; padding: 10px; border-radius: 5px; }\n";
    html = html + ".markdown { background: #f5f5f5; white-space: pre-wrap; }\n";
    html = html + ".code { background: #f0f0ff; white-space: pre-wrap; }\n";
    html = html + ".output { background: #f5fff5; white-space: pre-wrap; margin-top: 5px; }\n";
    html = html + "</style>\n</head>\n<body>\n";
    html = html + "<h1>" + input + "</h1>\n";

    // Simple cell parsing: split on /// to find markdown cells
    var lines: Vec = str_split(source, "\n");
    var i: i64 = 0;
    while i < lines.len() {
        var line: str = str_trim(lines.get(i));
        if str_starts_with(line, "///") {
            // Markdown cell
            var md: str = str_slice(line, 3, str_len(line));
            md = str_trim(md);
            html = html + "<div class=\"cell markdown\">" + md + "</div>\n";
        } else if str_len(line) > 0 {
            // Code line (simplified — full implementation would group code blocks)
            html = html + "<div class=\"cell code\">" + line + "</div>\n";
        }
        i = i + 1;
    }

    html = html + "</body>\n</html>\n";
    p_file_write(output, html);
    p_eprint_str("Notebook written to: ");
    p_eprint_str(output);
    p_eprint_str("\n");
    return 0;
}

// --- lint ----------------------------------------------------------------
fn cmd_lint(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid lint <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    // G8.7: Real lint implementation — calls lint_source which runs
    // unused-function and unused-import lints.
    var result: ResultVecStr = lint_source(source, input);
    match result {
        ResultVecStr::Ok(warnings) => {
            if warnings.len() == 0 {
                print("No lint warnings.\n");
                return 0;
            }
            var i: i64 = 0;
            while i < warnings.len() {
                print("warning: ");
                print(warnings.get(i));
                print("\n");
                i = i + 1;
            }
            print(int_to_str(warnings.len()));
            print(" lint warning(s).\n");
            return 0;
        }
        ResultVecStr::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- wasm ----------------------------------------------------------------
// G8.5: Compile a Fides source file to WASM binary (or WAT text with --wat).
fn cmd_wasm(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid wasm <file.fd> [-o output.wasm] [--wat]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var wat_mode: bool = false;
    var output: str = "";
    var i: i64 = start + 2;
    while i < n {
        var arg: str = p_argv(i);
        if arg == "--wat" {
            wat_mode = true;
        } else if arg == "-o" {
            if i + 1 < n {
                output = p_argv(i + 1);
                i = i + 1;
            } else {
                p_eprint_str("Error: -o requires an argument\n");
                return 1;
            }
        }
        i = i + 1;
    }
    if str_len(output) == 0 {
        // Derive default output from input filename
        var dot: i64 = str_rfind(input, ".");
        var stem: str = input;
        if dot >= 0 {
            stem = str_slice(input, 0, dot);
        }
        if wat_mode {
            output = stem + ".wat";
        } else {
            output = stem + ".wasm";
        }
    }
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var result: ResultBytes = compile_to_wasm(source, input, wat_mode);
    match result {
        ResultBytes::Ok(bytes) => {
            p_file_write_vec(output, bytes);
            if wat_mode {
                print("Emitted WAT text: ");
                print(output);
                print(" (");
                print(int_to_str(bytes.len()));
                print(" chars)\n");
            } else {
                print("Emitted WASM binary: ");
                print(output);
                print(" (");
                print(int_to_str(bytes.len()));
                print(" bytes)\n");
            }
            return 0;
        }
        ResultBytes::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- Per-module build (`ccompile --inc`) ---------------------------------
// Each unit compiles to a content-keyed object, reused while its canonical C
// does not change; then all link.
fn build_c_units(c_code: str, cc: str, gcc_opt: str, is_tcc: bool, output: str, libs: str, no_cache: bool) -> i64 {
    var units: Vec<CUnit> = split_c_units(c_code);
    var stem: str = output;
    if str_ends_with(output, ".exe") { stem = str_slice(output, 0, str_len(output) - 4); }
    var tu_dir: str = stem + ".fides-tu";
    p_mkdir(tu_dir);
    var flags: str = " -Wno-int-conversion";
    if !is_tcc {
        flags = flags + " -Wno-incompatible-pointer-types -fstack-protector-strong -fPIE -fno-strict-overflow -fno-strict-aliasing";
    }
    var objs: str = "";
    var stale: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < units.len() {
        var unit: CUnit = units.get(i);
        var c_path: str = tu_dir + "/" + unit.name + ".c";
        var o_path: str = tu_dir + "/" + unit.name + ".o";
        p_file_write(c_path, unit.code);
        var art: str = "";
        var have: bool = false;
        if !no_cache {
            art = inc_artifact_path(output, inc_canon_hash(unit.code), cc, "o " + gcc_opt + flags);
            have = inc_artifact_get(art, o_path);
        }
        if !have {
            stale.push(unit.name);
            if p_system(cc + " " + gcc_opt + flags + " -c -o " + o_path + " " + c_path) != 0 {
                print("C compilation failed: " + c_path + "\n");
                return 1;
            }
            if str_len(art) > 0 { inc_artifact_put(art, o_path); }
        }
        objs = objs + " " + o_path;
        i = i + 1;
    }
    if stale.len() == 0 {
        print("All " + int_to_str(units.len()) + " units up to date; linking\n");
    } else {
        print("Compiling " + int_to_str(stale.len()) + " of " + int_to_str(units.len()) + " units\n");
    }
    var link: str = cc + " " + gcc_opt + flags + " -o " + output;
    if !is_tcc { link = link + " -pie -Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack"; }
    var system_libs: str = " -lm";
    if !is_linux() { system_libs = system_libs + " -lws2_32"; }
    if p_system(link + objs + system_libs + libs) != 0 {
        print("link failed\n");
        return 1;
    }
    return 0;
}

// --- PE stack patching ---------------------------------------------------
// Patches SizeOfStackReserve to 256MB and SizeOfStackCommit to 16MB in a
// PE executable. tcc defaults to 1MB stack which is too small for the
// self-hosted compiler's deep recursion (parser, lexer, typechecker).
// This makes the output of `ccompile` work without manual patching.
fn patch_pe_stack(exe_path: str) {
    // PE header layout:
    //   DOS header at offset 0, e_lfanew at offset 0x3C (4 bytes, little-endian)
    //   PE signature at e_lfanew (4 bytes "PE\0\0")
    //   COFF header at e_lfanew + 4 (20 bytes)
    //   Optional header at e_lfanew + 24
    //     SizeOfStackReserve at Optional header offset 0x48 (8 bytes, LE)
    //     SizeOfStackCommit   at Optional header offset 0x50 (8 bytes, LE)
    var bytes: Vec<i64> = p_file_read_bytes(exe_path);
    if bytes.len() < 0x40 {
        p_eprint_str("[main] WARNING: PE stack patching failed: cannot read output.\n");
        return;
    }
    var pe_off: i64 = bytes.get(0x3C) + (bytes.get(0x3D) << 8) + (bytes.get(0x3E) << 16) + (bytes.get(0x3F) << 24);
    var stack_off: i64 = pe_off + 0x18 + 0x48;
    if stack_off + 16 > bytes.len() {
        p_eprint_str("[main] WARNING: PE stack patching failed: not a PE file.\n");
        return;
    }
    pe_put_u64(bytes, stack_off, 268435456);     // 256MB reserve
    pe_put_u64(bytes, stack_off + 8, 16777216);  // 16MB commit
    p_file_write_vec(exe_path, bytes);
    p_eprint_str("[main] PE stack patched to 256MB.\n");
}

fn pe_put_u64(bytes: Vec<i64>, off: i64, value: i64) {
    var i: i64 = 0;
    while i < 8 {
        bytes.set(off + i, (value >> (i * 8)) & 0xFF);
        i = i + 1;
    }
}

// --- compile (alias for ccompile) -----------------------------------------
// Reference: src/main.rs:289. In the Rust compiler, `compile` produces
// assembly (.s). In the self-hosted compiler, we treat it as an alias for
// ccompile (C codegen + tcc) since we don't have a native asm backend yet.
fn cmd_compile(n: i64, start: i64, g_borrowck: str, g_timeout: i64) -> i64 {
    return cmd_ccompile(n, start, g_borrowck, g_timeout);
}

// The libraries named by `// PLINK: lib` lines of generated C, as
// " -llib" flags (src/main.rs ccompile), except ws2_32.
fn plink_libs(c_code: str) -> str {
    var out: str = "";
    var marker: str = "\n// PLINK: ";
    var rest: str = c_code;
    var at: i64 = str_find(rest, marker);
    while at >= 0 {
        rest = str_slice(rest, at + str_len(marker), str_len(rest));
        var end: i64 = str_find(rest, "\n");
        if end < 0 { end = str_len(rest); }
        var lib: str = str_trim(str_slice(rest, 0, end));
        if str_len(lib) > 0 && lib != "ws2_32" && !str_contains(out, " -l" + lib + " ") {
            out = out + " -l" + lib + " ";
        }
        rest = str_slice(rest, end, str_len(rest));
        at = str_find(rest, marker);
    }
    return out;
}

// --- ccompile ------------------------------------------------------------
// Reference: src/main.rs:1099
// Compiles via C codegen, then links with an available C compiler.
// Flags: -o <output>, --target <triple>, --trace
fn cmd_ccompile(n: i64, start: i64, g_borrowck: str, g_timeout: i64) -> i64 {
    if start + 2 > n {
        print("Usage: fid ccompile <file.fd> [-o output.exe] [--target <triple>] [--trace]\n");
        return 1;
    }

    var input: str = p_argv(start + 1);
    var output: str = find_output_arg(n, start, "a.out");
    output = ensure_exe_extension(output);

    // --target <triple> for cross-compilation
    var target: str = get_flag_value(n, start, "--target", "");
    // --trace: trace C compilation
    var trace: bool = has_flag(n, start, "--trace");

    // Report global flags
    if g_borrowck != "on" {
        p_eprint_str("[main] borrowck mode: ");
        p_eprint_str(g_borrowck);
        p_eprint_str("\n");
    }
    // G8.2: borrowck mode is passed through the pipeline via parameter

    p_eprint_str("[main] Reading source file: ");
    p_eprint_str(input);
    p_eprint_str("\n");
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("[main] FAILED: could not read file\n");
        print("Error: could not read file: ");
        print(input);
        print("\n");
        return 1;
    }
    p_eprint_str("[main] Source read ok. Compiling...\n");

    if trace {
        p_eprint_str("[main] C compilation tracing enabled\n");
    }

    // Incremental build: skip all work when no input changed.
    var no_cache: bool = has_flag(n, start, "--no-cache") || str_len(env_or_empty("FIDES_NO_CACHE")) > 0;
    var stamp_path: str = output + ".fides-stamp";
    var build_key: i64 = inc_build_key("ccompile", n, start);
    var stamp: IncStamp = inc_stamp_read(stamp_path);
    if no_cache { stamp.ok = false; }
    if inc_up_to_date(stamp, build_key, output) {
        print(output + " is up to date\n");
        return 0;
    }
    inc_deps_reset();

    var unit_build: bool = has_flag(n, start, "--inc");
    if unit_build { set_c_unit_marks(true); }
    var result: ResultStr = ccompile_source_with_path(source, input, g_borrowck);
    match result {
        ResultStr::Ok(c_code) => {
            var c_hash: i64 = hash_source(c_code);
            p_eprint_str("[main] C code generated. Writing to file...\n");
            // Derive the C source path from the executable path
            var c_file: str = "";
            if str_ends_with(output, ".exe") {
                c_file = str_replace(output, ".exe", ".c");
            } else {
                c_file = output + ".c";
            }
            p_file_write(c_file, c_code);
            p_eprint_str("[main] C file written. ");
            // Same C as the build that produced the output: no need to run
            // the C compiler again.
            if inc_c_unchanged(stamp, build_key, output, c_hash) {
                inc_stamp_commit(stamp_path, build_key, c_hash, input, output);
                print("C translation unchanged; " + output + " is up to date\n");
                return 0;
            }

            // Find a C compiler: check CC env var, then gcc, clang, tcc
            var cc: str = env_or_empty("CC");
            if str_len(cc) == 0 {
                if is_linux() {
                    // Linux: check gcc, clang, cc, tcc
                    if p_system("which gcc >/dev/null 2>&1") == 0 {
                        cc = "gcc";
                    } else {
                        if p_system("which clang >/dev/null 2>&1") == 0 {
                            cc = "clang";
                        } else {
                            if p_system("which cc >/dev/null 2>&1") == 0 {
                                cc = "cc";
                            } else {
                                if p_system("which tcc >/dev/null 2>&1") == 0 {
                                    cc = "tcc";
                                } else {
                                    cc = "gcc";
                                }
                            }
                        }
                    }
                } else {
                    // Windows: check gcc, clang, tcc, cl.exe
                    if p_system("gcc --version >nul 2>&1") == 0 {
                        cc = "gcc";
                    } else {
                        if p_system("clang --version >nul 2>&1") == 0 {
                            cc = "clang";
                        } else {
                            if p_system("tcc --version >nul 2>&1") == 0 {
                                cc = "tcc";
                            } else {
                                if p_system("where cl.exe >nul 2>&1") == 0 {
                                    cc = "cl.exe";
                                } else {
                                    cc = "tcc";
                                }
                            }
                        }
                    }
                }
            }

            // If --target is specified, try cross-compiler prefix
            if str_len(target) > 0 {
                var cross_gcc: str = target + "-gcc";
                var cross_clang: str = target + "-clang";
                if is_linux() {
                    if p_system("which " + cross_gcc + " >/dev/null 2>&1") == 0 {
                        cc = cross_gcc;
                    } else {
                        if p_system("which " + cross_clang + " >/dev/null 2>&1") == 0 {
                            cc = cross_clang;
                        } else {
                            p_eprint_str("Warning: cross-compiler for target '");
                            p_eprint_str(target);
                            p_eprint_str("' not found, falling back to ");
                            p_eprint_str(cc);
                            p_eprint_str("\n");
                        }
                    }
                } else {
                    if p_system(cross_gcc + " --version >nul 2>&1") == 0 {
                        cc = cross_gcc;
                    } else {
                        if p_system(cross_clang + " --version >nul 2>&1") == 0 {
                            cc = cross_clang;
                        } else {
                            p_eprint_str("Warning: cross-compiler for target '");
                            p_eprint_str(target);
                            p_eprint_str("' not found, falling back to ");
                            p_eprint_str(cc);
                            p_eprint_str("\n");
                        }
                    }
                }
            }

            p_eprint_str("Running ");
            p_eprint_str(cc);
            p_eprint_str("...\n");

            // Build the compile command
            // tcc needs different flags than gcc/clang
            var is_tcc: bool = cc == "tcc" || str_ends_with(cc, "tcc.exe");
            var is_cl: bool = str_ends_with(cc, "cl.exe") || cc == "cl";

            // Detect SDL2 usage: if source contains "use sdl;", add SDL2 link flags.
            // Also detect "use image;" and "use font;" which need SDL2_image / stb.
            // Also detect "use gl;" which needs OpenGL.
            // Also detect "use net;" which needs socket libs.
            var extra_libs: str = "";
            if str_starts_with(source, "use sdl;") || str_contains(source, "\nuse sdl;") {
                if is_linux() {
                    extra_libs = extra_libs + " -lSDL2 -lSDL2_image -lSDL2_mixer";
                } else {
                    extra_libs = extra_libs + " -lSDL2 -lSDL2_image -lSDL2_mixer -lglu32 -lopengl32";
                }
                p_eprint_str("[main] Detected SDL2 usage, adding link flags\n");
            }
            if str_starts_with(source, "use gl;") || str_contains(source, "\nuse gl;") {
                if is_linux() {
                    extra_libs = extra_libs + " -lGL -lGLU";
                } else {
                    extra_libs = extra_libs + " -lopengl32 -lglu32";
                }
                p_eprint_str("[main] Detected OpenGL usage, adding link flags\n");
            }
            if str_starts_with(source, "use net;") || str_contains(source, "\nuse net;") {
                if is_linux() {
                    // sockets are in libc on Linux, no extra lib needed
                } else {
                    extra_libs = extra_libs + " -lws2_32";
                }
                p_eprint_str("[main] Detected net usage, adding link flags\n");
            }
            // `extern "C" link "lib"` blocks: the C carries `// PLINK: lib`
            // (ws2_32 is in the _WIN32 header block and added above).
            extra_libs = extra_libs + plink_libs(c_code);

            // C optimization level: --cc-opt, else FIDES_CC_OPT, else -O2.
            // gcc and clang need tens of minutes for a very large
            // translation unit at -O1/-O2 (the compiler itself is ~35 MB of
            // C: 26 min at -O2, 40 s at -O0), so one gets -O0.
            var cc_opt: str = get_flag_value(n, start, "--cc-opt", "");
            if str_len(cc_opt) == 0 { cc_opt = env_or_empty("FIDES_CC_OPT"); }
            if str_len(cc_opt) == 0 {
                if str_len(c_code) > 16777216 {
                    print("Large program (" + int_to_str(str_len(c_code) / 1048576) + " MB of C): compiling with -O0 (use --cc-opt 2 for -O2)\n");
                    cc_opt = "0";
                } else {
                    cc_opt = "2";
                }
            }
            if cc_opt != "0" && cc_opt != "1" && cc_opt != "2" && cc_opt != "3" && cc_opt != "s" {
                print("Invalid --cc-opt '" + cc_opt + "': use 0, 1, 2, 3 or s\n");
                return 1;
            }
            var gcc_opt: str = "-O" + cc_opt;
            var cl_opt: str = "/O2";
            if cc_opt == "0" { cl_opt = "/Od"; }
            if cc_opt == "1" || cc_opt == "s" { cl_opt = "/O1"; }

            // --inc: one translation unit per module, each compiled to a
            // cached object, then linked.
            if unit_build {
                if is_cl {
                    print("--inc is not supported with cl.exe yet; use gcc/clang/zig cc\n");
                    return 1;
                }
                var rc: i64 = build_c_units(c_code, cc, gcc_opt, is_tcc, output, extra_libs, no_cache);
                if rc != 0 { return rc; }
                if !is_linux() { patch_pe_stack(output); }
                inc_stamp_commit(stamp_path, build_key, c_hash, input, output);
                print("Built native executable: " + output + "\n");
                return 0;
            }

            // A build of the same canonical program with the same toolchain
            // and flags reuses its binary: no C compile.
            var art_path: str = "";
            if !no_cache {
                art_path = inc_artifact_path(output, inc_canon_hash(c_code), cc, cc_opt + " " + target + extra_libs);
                if inc_artifact_get(art_path, output) {
                    inc_stamp_commit(stamp_path, build_key, c_hash, input, output);
                    print("Reused cached artifact: " + output + "\n");
                    return 0;
                }
            }

            var cc_cmd: str = "";
            if is_cl {
                // cl.exe: /O2 /Fe:output file.c
                cc_cmd = cc + " " + cl_opt + " /nologo /Fe:" + output + " " + c_file;
            } else {
                if is_tcc {
                    // tcc: minimal flags
                    if is_linux() {
                        cc_cmd = cc + " " + gcc_opt + " -w -o " + output + " " + c_file + " -lm" + extra_libs;
                    } else {
                        cc_cmd = cc + " " + gcc_opt + " -w -o " + output + " " + c_file + " -lws2_32" + extra_libs;
                    }
                } else {
                    // gcc/clang: -O2 + hardening flags (as src/main.rs).
                    // -fno-strict-aliasing: the generated code type-puns
                    // through pointer casts; -fno-strict-overflow: wrapping
                    // arithmetic must not be assumed away.
                    var cc_flags: str = " " + gcc_opt + " -w -Wno-int-conversion -Wno-incompatible-pointer-types -fstack-protector-strong -fPIE -fno-strict-overflow -fno-strict-aliasing -o " + output + " " + c_file + " -pie -Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack";
                    if is_linux() {
                        cc_cmd = cc + cc_flags + " -lm -lpthread" + extra_libs;
                    } else {
                        cc_cmd = cc + cc_flags + " -lws2_32" + extra_libs;
                    }
                }
            }
            var ret: i64 = p_system(cc_cmd);

            if ret != 0 {
                print("C compilation failed\n");
                p_eprint_str("C source left at: ");
                p_eprint_str(c_file);
                p_eprint_str("\n");
                return 1;
            }

            // Patch PE stack to 256MB (tcc defaults to 1MB, which is too
            // small for the self-hosted compiler's deep recursion).
            // Only needed on Windows with PE executables.
            if !is_linux() {
                patch_pe_stack(output);
            }
            if str_len(art_path) > 0 { inc_artifact_put(art_path, output); }
            inc_stamp_commit(stamp_path, build_key, c_hash, input, output);

            print("Built native executable: ");
            print(output);
            print("\n");
            return 0;
        }
        ResultStr::Err(errs) => {
            print("Compilation errors:\n");
            var ei: i64 = 0;
            while ei < errs.len() {
                print(errs.get(ei));
                print("\n");
                ei = ei + 1;
            }
            return 1;
        }
    }
    return 1;
}

// --- build (PE emitter) --------------------------------------------------
// Reference: src/main.rs:151
// Flags: -o <output>, --target <triple>, --no-opt, --lto, --caps <list>
// --- cmd_build_x86 -------------------------------------------------------
// Build a Linux ELF via the x86.rs stack-machine backend (no PIR/regalloc).
fn cmd_build_x86(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid build-x86 <file.fd> [-o output]\n");
        p_eprint_str("       Builds a Linux ELF executable using the x86 stack-machine backend (AT&T syntax)\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var output: str = find_output_arg(n, start, "a.out");
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        print("Error: could not read file: ");
        print(input);
        print("\n");
        return 1;
    }
    var result: ResultBytes = build_x86_linux(source, input);
    match result {
        ResultBytes::Ok(exe_bytes) => {
            p_file_write_vec(output, exe_bytes);
            p_eprint_str("Built native executable: ");
            p_eprint_str(output);
            p_eprint_str(" (x86 backend)\n");
            return 0;
        }
        ResultBytes::Err(errors) => {
            print_errors(errors);
            return 1;
        }
    }
    return 1;
}

// --- cmd_codegen ---------------------------------------------------------
// Emit assembly via the custom PIR L3 -> target codegen.
// Mirrors Rust: fidesc codegen <file> [--target] [--peephole] [--elf|--coff|--macho <o>]
fn cmd_codegen(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid codegen <file.fd> [--target x86-64|arm64|riscv] [--peephole] [--elf <o>] [--coff <o>] [--macho <o>]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var target: str = get_flag_value(n, start, "--target", "x86-64");
    var do_peephole: bool = has_flag(n, start, "--peephole");
    var elf_out: str = get_flag_value(n, start, "--elf", "");
    var coff_out: str = get_flag_value(n, start, "--coff", "");
    var macho_out: str = get_flag_value(n, start, "--macho", "");
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var mod_result: ResultIrModule = lower_to_ir_module_with_path(source, input, "on");
    match mod_result {
        ResultIrModule::Err(errors) => { print_errors(errors); return 1; }
        ResultIrModule::Ok(ir_mod) => {
            var l1: L1Module = lower_ir_to_l1(&ir_mod);
            var l2: L2Module = lower_l1_to_l2(&l1);
            var l3: L3Module = lower_l2_to_l3(&l2, &ir_mod);
            if target == "x86-64" || target == "x64" {
                var asm: str = generate_asm(l3);
                if do_peephole { asm = peephole_optimize(asm); }
                if str_len(elf_out) > 0 {
                    match emit_object_file(0, asm) {
                        ResultVec::Ok(bytes) => {
                            p_file_write_vec(elf_out, bytes);
                            p_eprint_str("Wrote " + int_to_str(bytes.len()) + " bytes to " + elf_out + "\n");
                            return 0;
                        }
                        ResultVec::Err(e) => { p_eprint_str("ELF emission error: " + e + "\n"); return 1; }
                    }
                }
                if str_len(coff_out) > 0 {
                    match emit_coff_file(0, asm) {
                        ResultVec::Ok(bytes2) => {
                            p_file_write_vec(coff_out, bytes2);
                            p_eprint_str("Wrote " + int_to_str(bytes2.len()) + " bytes to " + coff_out + "\n");
                            return 0;
                        }
                        ResultVec::Err(e2) => { p_eprint_str("COFF emission error: " + e2 + "\n"); return 1; }
                    }
                }
                if str_len(macho_out) > 0 {
                    match emit_macho_file(0, asm) {
                        ResultVec::Ok(bytes3) => {
                            p_file_write_vec(macho_out, bytes3);
                            p_eprint_str("Wrote " + int_to_str(bytes3.len()) + " bytes to " + macho_out + "\n");
                            return 0;
                        }
                        ResultVec::Err(e3) => { p_eprint_str("Mach-O emission error: " + e3 + "\n"); return 1; }
                    }
                }
                print(asm);
                return 0;
            }
            if target == "arm64" || target == "aarch64" {
                var asm_arm: str = generate_asm_arm64(l3);
                if str_len(elf_out) > 0 {
                    match emit_object_file_for_target(0, asm_arm, "arm64") {
                        ResultVec::Ok(barm) => {
                            p_file_write_vec(elf_out, barm);
                            p_eprint_str("Wrote " + int_to_str(barm.len()) + " bytes to " + elf_out + " (ELF64 AArch64)\n");
                            return 0;
                        }
                        ResultVec::Err(earm) => { p_eprint_str("ELF emission error: " + earm + "\n"); return 1; }
                    }
                }
                print(asm_arm);
                return 0;
            }
            if target == "riscv" || target == "riscv64" {
                var asm_rv: str = generate_asm_riscv(l3);
                if str_len(elf_out) > 0 {
                    match emit_object_file_for_target(0, asm_rv, "riscv") {
                        ResultVec::Ok(brv) => {
                            p_file_write_vec(elf_out, brv);
                            p_eprint_str("Wrote " + int_to_str(brv.len()) + " bytes to " + elf_out + " (ELF64 RISC-V)\n");
                            return 0;
                        }
                        ResultVec::Err(erv) => { p_eprint_str("ELF emission error: " + erv + "\n"); return 1; }
                    }
                }
                print(asm_rv);
                return 0;
            }
            p_eprint_str("Unknown target: " + target + " (supported: x86-64, arm64, riscv)\n");
            return 1;
        }
    }
    return 1;
}

// --- cmd_gpu -------------------------------------------------------------
// Generate GPU code (SPIR-V or PTX) from a Fides program.
fn cmd_gpu(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid gpu <file.fd> --target spirv|ptx [-o output] [--text]\n");
        p_eprint_str("       --target spirv  SPIR-V bytecode (Vulkan compute)\n");
        p_eprint_str("       --target ptx    PTX assembly (NVIDIA)\n");
        p_eprint_str("       --text          For spirv: emit text disassembly\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var target: str = get_flag_value(n, start, "--target", "spirv");
    var output: str = get_flag_value(n, start, "-o", "");
    var text_mode: bool = has_flag(n, start, "--text");
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var mod_result: ResultIrModule = lower_to_ir_module_with_path(source, input, "on");
    match mod_result {
        ResultIrModule::Err(errors) => { print_errors(errors); return 1; }
        ResultIrModule::Ok(ir_mod) => {
            var l1: L1Module = lower_ir_to_l1(&ir_mod);
            var l2: L2Module = lower_l1_to_l2(&l1);
            var l3: L3Module = lower_l2_to_l3(&l2, &ir_mod);
            if target == "spirv" {
                if text_mode {
                    var text: str = generate_spirv_text(l3);
                    if str_len(output) > 0 {
                        p_file_write(output, text);
                        p_eprint_str("Generated SPIR-V text: " + output + "\n");
                    } else {
                        print(text);
                    }
                } else {
                    var words: Vec<i64> = generate_spirv(l3);
                    var bytes: Vec<i64> = Vec::new();
                    var wi: i64 = 0;
                    while wi < words.len() {
                        var w: i64 = words.get(wi);
                        bytes.push(w & 0xFF);
                        bytes.push((w >> 8) & 0xFF);
                        bytes.push((w >> 16) & 0xFF);
                        bytes.push((w >> 24) & 0xFF);
                        wi = wi + 1;
                    }
                    if str_len(output) > 0 {
                        p_file_write_vec(output, bytes);
                        p_eprint_str("Generated SPIR-V bytecode: " + output + " (" + int_to_str(words.len()) + " words)\n");
                    } else {
                        p_eprint_str("Generated " + int_to_str(words.len()) + " SPIR-V words (use -o to write binary)\n");
                    }
                }
                return 0;
            }
            if target == "ptx" {
                var ptx: str = generate_ptx(l3);
                if str_len(output) > 0 {
                    p_file_write(output, ptx);
                    p_eprint_str("Generated PTX assembly: " + output + "\n");
                } else {
                    print(ptx);
                }
                return 0;
            }
            p_eprint_str("Unknown GPU target '" + target + "'. Use --target spirv or --target ptx\n");
            return 1;
        }
    }
    return 1;
}

// --- cmd_verify ----------------------------------------------------------
// Verify IR correctness for a Fides source file.
fn cmd_verify(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid verify <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var mod_result: ResultIrModule = lower_to_ir_module_with_path(source, input, "on");
    match mod_result {
        ResultIrModule::Err(errors) => { print_errors(errors); return 1; }
        ResultIrModule::Ok(ir_mod) => {
            var result: VerificationResult = IrModule_verify(&ir_mod);
            var wi: i64 = 0;
            while wi < result.warnings.len() {
                p_eprint_str("warning: " + result.warnings.get(wi) + "\n");
                wi = wi + 1;
            }
            var ei: i64 = 0;
            while ei < result.errors.len() {
                p_eprint_str("error: " + result.errors.get(ei) + "\n");
                ei = ei + 1;
            }
            if VerificationResult_is_valid(&result) {
                print("IR verification passed (" + int_to_str(result.warnings.len()) + " warnings)\n");
                return 0;
            }
            p_eprint_str("IR verification failed with " + int_to_str(result.errors.len()) + " errors\n");
            return 1;
        }
    }
    return 1;
}

// --- cmd_sourcemap -------------------------------------------------------
// Print the IR-to-source mapping for a Fides file.
fn cmd_sourcemap(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid sourcemap <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var mod_result: ResultIrModule = lower_to_ir_module_with_path(source, input, "on");
    match mod_result {
        ResultIrModule::Err(errors) => { print_errors(errors); return 1; }
        ResultIrModule::Ok(ir_mod) => {
            var sm: SourceMap = IrModule_source_map(&ir_mod);
            if sm.entries.len() == 0 {
                print("Source map is empty (no source line info available).\n");
            } else {
                print(SourceMap_to_str(&sm));
            }
            return 0;
        }
    }
    return 1;
}

// --- cmd_parse_header ----------------------------------------------------
// Parse a C header file and emit Fides FFI bindings.
fn cmd_parse_header(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid parse-header <file.h> [-o output.fd]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var output: str = find_output_arg(n, start, "");
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error reading '" + input + "'\n");
        return 1;
    }
    var base: str = input;
    var slash: i64 = str_rfind_char(input, 47);
    if slash >= 0 { base = str_slice(input, slash + 1, str_len(input)); }
    var include: str = "\"" + base + "\"";
    var decls: Vec<CExternDecl> = parse_header(source, include);
    var bindings: str = generate_pledge_bindings(decls, include);
    if str_len(output) > 0 {
        p_file_write(output, bindings);
        p_eprint_str("Generated " + input + " bindings -> " + output + "\n");
    } else {
        print(bindings);
    }
    return 0;
}

fn cmd_build(n: i64, start: i64, g_borrowck: str, g_timeout: i64) -> i64 {
    if start + 2 > n {
        print("Usage: fid build <file.fd> [-o output] [--target <triple>] [--no-opt] [--lto] [--caps <list>]\n");
        return 1;
    }

    var input: str = p_argv(start + 1);
    var output: str = find_output_arg(n, start, "a.out");
    output = ensure_exe_extension(output);

    // --target <triple> (default: x86-64)
    var target: str = get_flag_value(n, start, "--target", "x86-64");
    // --no-opt: disable PIR optimizer (enabled by default)
    var do_opt: bool = !has_flag(n, start, "--no-opt");
    // --lto: enable link-time optimization
    var do_lto: bool = has_flag(n, start, "--lto");
    // --native: use native backend (ELF64/PE) instead of C codegen
    var use_native: bool = has_flag(n, start, "--native");
    // --bare: bare-metal mode (skip stdlib, flat binary)
    var bare_mode: bool = has_flag(n, start, "--bare");
    // --boot: multiboot2 boot mode (skip stdlib, generate boot binary)
    var boot_mode: bool = has_flag(n, start, "--boot");
    // --caps <list>: capability restrictions
    var caps: str = get_flag_value(n, start, "--caps", "");
    // Split "IO,Net" -> ["IO","Net"] for build_executable's granted_caps
    var granted_caps: Vec<str> = Vec::new();
    if str_len(caps) > 0 {
        var cap_parts: Vec<str> = str_split(caps, ",");
        var ci: i64 = 0;
        while ci < cap_parts.len() {
            var cap_name: str = str_trim(cap_parts.get(ci));
            if str_len(cap_name) > 0 { granted_caps.push(cap_name); }
            ci = ci + 1;
        }
    }

    // Report global flags
    if g_borrowck != "on" {
        p_eprint_str("[build] borrowck mode: ");
        p_eprint_str(g_borrowck);
        p_eprint_str("\n");
    }
    // G8.2: borrowck mode is passed through the pipeline via parameter

    p_eprint_str("[build] Reading source file: ");
    p_eprint_str(input);
    p_eprint_str("\n");
    p_eprint_str("[build] Target: ");
    p_eprint_str(target);
    p_eprint_str(", opt: ");
    if do_opt { p_eprint_str("on"); } else { p_eprint_str("off"); }
    p_eprint_str(", lto: ");
    if do_lto { p_eprint_str("on"); } else { p_eprint_str("off"); }
    p_eprint_str("\n");
    if str_len(caps) > 0 {
        p_eprint_str("[build] Caps: ");
        p_eprint_str(caps);
        p_eprint_str("\n");
    }

    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        print("Error: could not read file: ");
        print(input);
        print("\n");
        return 1;
    }
    p_eprint_str("[build] Source read ok. Compiling...\n");

    // --boot mode: multiboot2 kernel binary (no stdlib, boot entry point)
    if boot_mode {
        p_eprint_str("[build] Boot mode: generating multiboot2 kernel...\n");
        var boot_result: ResultProgram = build_program_no_std(source, OptStr::Some(input));
        match boot_result {
            ResultProgram::Err(errs) => {
                print("Compilation errors:\n");
                var ei: i64 = 0;
                while ei < errs.len() {
                    print(errs.get(ei));
                    print("\n");
                    ei = ei + 1;
                }
                return 1;
            }
            ResultProgram::Ok(program) => {
                p_eprint_str("[build] Lowering to IR...\n");
                var ir_mod: IrModule = lower(program);
                var l1: L1Module = lower_ir_to_l1(&ir_mod);
                var l2: L2Module = lower_l1_to_l2(&l1);
                var l3: L3Module = lower_l2_to_l3(&l2, &ir_mod);
                p_eprint_str("[build] Generating boot binary...\n");
                var bin: Vec = generate_boot_binary(ir_mod, l3);
                p_file_write_vec(output, bin);
                print("Emitted multiboot2 kernel: ");
                print(output);
                print(" (");
                print(int_to_str(bin.len()));
                print(" bytes, boot-ready)\n");
                return 0;
            }
        }
    }

    // --bare mode: flat binary (no stdlib)
    if bare_mode {
        p_eprint_str("[build] Bare mode: generating flat binary...\n");
        var bare_result: ResultProgram = build_program_no_std(source, OptStr::Some(input));
        match bare_result {
            ResultProgram::Err(errs) => {
                print("Compilation errors:\n");
                var ei: i64 = 0;
                while ei < errs.len() {
                    print(errs.get(ei));
                    print("\n");
                    ei = ei + 1;
                }
                return 1;
            }
            ResultProgram::Ok(program) => {
                p_eprint_str("[build] Lowering to IR...\n");
                var ir_mod: IrModule = lower(program);
                var l1: L1Module = lower_ir_to_l1(&ir_mod);
                var l2: L2Module = lower_l1_to_l2(&l1);
                var l3: L3Module = lower_l2_to_l3(&l2, &ir_mod);
                p_eprint_str("[build] Generating flat binary...\n");
                var bin: Vec = generate_flat_binary(ir_mod, l3);
                p_file_write_vec(output, bin);
                print("Emitted bare-metal binary: ");
                print(output);
                print(" (");
                print(int_to_str(bin.len()));
                print(" bytes, no stdlib, no PE headers)\n");
                return 0;
            }
        }
    }

    // Windows default: emit a PE .exe directly via the pe_ir backend
    // (native, no C compiler). The pe_runtime sources must be merged into
    // the program, so the flag is set before build_program below.
    var windows_pe: bool = !is_linux() && !bare_mode && !boot_mode && !use_native
        && target != "arm64" && target != "aarch64" && target != "riscv64";
    if windows_pe { set_pe_runtime_merge(true); }

    // Incremental build: skip all work when no input changed.
    var stamp_path: str = output + ".fides-stamp";
    var build_key: i64 = 0;
    if windows_pe {
        build_key = inc_build_key("emit", n, start);
        var stamp: IncStamp = inc_stamp_read(stamp_path);
        if !has_flag(n, start, "--no-cache") && str_len(env_or_empty("FIDES_NO_CACHE")) == 0
            && inc_up_to_date(stamp, build_key, output) {
            print(output + " is up to date\n");
            return 0;
        }
        inc_deps_reset();
    }

    var result: ResultProgram = build_program_with_path_borrowck(source, OptStr::Some(input), g_borrowck);
    match result {
        ResultProgram::Err(errs) => {
            print("Compilation errors:\n");
            var ei: i64 = 0;
            while ei < errs.len() {
                print(errs.get(ei));
                print("\n");
                ei = ei + 1;
            }
            return 1;
        }
        ResultProgram::Ok(program) => {
            p_eprint_str("[build] Lowering to IR...\n");
            var ir_mod: IrModule = lower(program);

            // Windows default: direct IR -> PE machine code (pe_ir backend)
            if windows_pe {
                p_eprint_str("[build] Emitting PE via pe_ir backend...\n");
                var pe_res: ResultBytes = pe_ir_generate_pe(ir_mod);
                match pe_res {
                    ResultBytes::Err(perrs) => {
                        print("PE generation errors:\n");
                        var pei: i64 = 0;
                        while pei < perrs.len() {
                            print(perrs.get(pei));
                            print("\n");
                            pei = pei + 1;
                        }
                        return 1;
                    }
                    ResultBytes::Ok(pe_bytes) => {
                        p_file_write_vec(output, pe_bytes);
                        inc_stamp_commit(stamp_path, build_key, 0, input, output);
                        print("Built native executable: ");
                        print(output);
                        print("\n");
                        return 0;
                    }
                }
            }

            // Try native backend if --native flag is set
            if use_native {
                p_eprint_str("[build] Using native backend...\n");
                var native_result: ResultBytes = build_executable(source, input, target, do_opt, do_lto, granted_caps);
                match native_result {
                    ResultBytes::Err(nerrs) => {
                        p_eprint_str("[build] Native backend failed, falling back to C codegen:\n");
                        var ne: i64 = 0;
                        while ne < nerrs.len() {
                            p_eprint_str("  ");
                            p_eprint_str(nerrs.get(ne));
                            p_eprint_str("\n");
                            ne = ne + 1;
                        }
                    }
                    ResultBytes::Ok(native_bytes) => {
                        p_eprint_str("[build] Writing native executable...\n");
                        p_file_write_vec(output, native_bytes);
                        p_eprint_str("[build] Native executable built.\n");
                        print("Built native executable: ");
                        print(output);
                        print("\n");
                        return 0;
                    }
                }
            }

            // On Linux, use C codegen + system C compiler (gcc/clang)
            // On Windows, use C codegen + TCC
            if is_linux() {
                p_eprint_str("[build] Using C codegen (Linux)...\n");
                var cgen: CCodeGen = CCodeGen_new();
                var c_source: str = CCodeGen_generate(&mut cgen, ir_mod);
                var c_file: str = output + ".c";
                p_file_write(c_file, c_source);
                // Try gcc first, then clang
                var cc_cmd: str = "gcc -O2 -o " + output + " " + c_file + " -lm 2>/dev/null";
                var cc_ret: i64 = p_system(cc_cmd);
                if cc_ret != 0 {
                    cc_cmd = "clang -O2 -o " + output + " " + c_file + " -lm 2>/dev/null";
                    cc_ret = p_system(cc_cmd);
                }
                if cc_ret != 0 {
                    cc_cmd = "cc -O2 -o " + output + " " + c_file + " -lm";
                    cc_ret = p_system(cc_cmd);
                }
                if cc_ret != 0 {
                    print("Error: C compilation failed (tried gcc, clang, cc)\n");
                    return 1;
                }
                p_eprint_str("[build] Native executable built via C codegen.\n");
                print("Built native executable: ");
                print(output);
                print("\n");
                return 0;
            }

            // Windows reaches here only when --native failed above (the
            // Windows default already emitted a PE via pe_ir and returned).
            // No C-compiler fallback on this platform.
            print("Error: native Windows build failed; no C-compiler fallback is configured\n");
            return 1;
        }
    }
    return 1;
}

// --- print_usage ---------------------------------------------------------
fn print_usage() {
    p_eprint_str("fid -- Fides self-hosted compiler\n");
    p_eprint_str("\n");
    p_eprint_str("Usage:\n");
    p_eprint_str("  fid ccompile <file.fd> -o <output>    Compile via C codegen (tcc)\n");
    p_eprint_str("  fid build    <file.fd> -o <output>    Compile to native executable\n");
    p_eprint_str("  fid emit     <file.fd> -o <output>    Alias for build\n");
    p_eprint_str("  fid build-x86 <file.fd> [-o <out>]    Linux ELF via x86 stack-machine backend\n");
    p_eprint_str("  fid emit     <file.fd> --boot -o <out>  Multiboot2 kernel binary\n");
    p_eprint_str("  fid emit     <file.fd> --bare -o <out>  Bare-metal flat binary\n");
    p_eprint_str("  fid run      <file.fd>                Compile + execute\n");
    p_eprint_str("  fid tokens   <file.fd>                Show tokens\n");
    p_eprint_str("  fid ast      <file.fd>                Show AST summary\n");
    p_eprint_str("  fid ir       <file.fd>                Show IR\n");
    p_eprint_str("  fid dump-c   <file.fd>                Show generated C source\n");
    p_eprint_str("  fid pir      <file.fd> [1|2|3|all]    Show PIR (default: L2)\n");
    p_eprint_str("  fid opt      <file.fd>                Optimize PIR L2 and show result\n");
    p_eprint_str("  fid fmt      <file.fd> [--check]      Format source code\n");
    p_eprint_str("  fid test                             Run all tests in tests/bootstrap/\n");
    p_eprint_str("  fid bench    <file.fd> [-n <count>]   Benchmark: run N times\n");
    p_eprint_str("  fid lint     <file.fd>               Run lint checks\n");
    p_eprint_str("  fid wasm     <file.fd> [-o <out>] [--wat]  Compile to WASM/WAT\n");
    p_eprint_str("  fid version                          Show version\n");
    p_eprint_str("  fid scribe   <file.fd|dir> [--format html|markdown] [--output <dir>]\n");
    p_eprint_str("                                           Generate documentation\n");
    p_eprint_str("  fid veil     <file.fd> [--format text|html] [--output <dir>]\n");
    p_eprint_str("                                           Code coverage report\n");
    p_eprint_str("  fid codegen  <file.fd> [--target x86-64|arm64|riscv] [--peephole]\n");
    p_eprint_str("                       [--elf <o>] [--coff <o>] [--macho <o>]\n");
    p_eprint_str("                                           Emit assembly / object files\n");
    p_eprint_str("  fid gpu      <file.fd> --target spirv|ptx [-o <out>] [--text]\n");
    p_eprint_str("                                           Generate GPU code\n");
    p_eprint_str("  fid verify   <file.fd>              Verify IR correctness\n");
    p_eprint_str("  fid sourcemap <file.fd>             Show IR-to-source mapping\n");
    p_eprint_str("  fid parse-header <file.h> [-o <fd>] Generate FFI bindings from C header\n");
}


// --- cmd_parse_header ----------------------------------------------------
// Parse a C header file and emit Fides FFI bindings to stdout.
// --- cmd_scribe ----------------------------------------------------------
// Generate HTML or Markdown documentation from .fd source.
fn cmd_scribe(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        print("scribe -- Documentation generator for Fides\n\nUSAGE:\n    scribe <file.fd> [--output <dir>] [--format html|markdown]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var format: str = get_flag_value(n, start, "--format", "html");
    var output_dir: str = get_flag_value(n, start, "--output", "docs");
    var message: str = scribe_process_file(input, output_dir, format);
    print(message);
    print("\n");
    return 0;
}

// --- cmd_veil ------------------------------------------------------------
// Run a Fides program with coverage tracking and emit a report.
fn cmd_veil(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        print(veil_print_help());
        return 1;
    }
    var input: str = p_argv(start + 1);
    var format: str = get_flag_value(n, start, "--format", "text");
    var output_dir: str = get_flag_value(n, start, "--output", "coverage");
    var message: str = veil_run(input, format, output_dir);
    print(message);
    print("\n");
    return 0;
}

// --- cmd_debug ------------------------------------------------------------
// Interactive IR debugger. Runs the interpreter with breakpoints.
// --- cmd_native_debug ----------------------------------------------------
// Native binary debugger (Linux ptrace). Compiles to C, runs under ptrace.
