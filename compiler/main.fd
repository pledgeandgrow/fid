// main.fd -- CLI entry point for the self-hosted Fides compiler.
//
// Supports: ccompile, build, emit, run, tokens, dump-tokens, ast, dump-ast,
//           ir, dump-ir, dump-c, opt, codegen, fmt, version, test,
//           bench, lint, lsp, fuzz, fix (and more: see main() below)
//
// Usage: fid <command> <file.fd> [options]
//
// compiler::image_writer and compiler::mir come before the modules that
// build their structs (pe_ir_enc/nat_enc's ImgPeOpt, nat_ir's MInst): the
// stage-0 compiler (fidesc) loads imports in this order and parses a struct
// literal only of a type it has already loaded (release A4).

module compiler::main;
use core;
use vec;
use string;
use process;
use compiler::ast;
use compiler::token;
use compiler::lexer;
use compiler::parser;
use compiler::ir;
use compiler::pgo;
use compiler::image_writer;
use compiler::mir;
use compiler::compiler;
use compiler::inc;
use compiler::pe_ir;
use compiler::pe_ir_stubs;
use compiler::fmt;
use compiler::lower;
use compiler::scribe;
use compiler::veil;
use compiler::tensor;
use compiler::gpu;
use compiler::wasm;
use compiler::lsp;
use compiler::ark;
use compiler::debugger;
use compiler::cparser;
use compiler::iropt;
use compiler::nat_ir;
use compiler::rules;
use compiler::checks;
use compiler::irverify;
use compiler::egraph;
use compiler::typechecker;
use compiler::json;
use compiler::csplit;
use compiler::reach;
use compiler::build_info;
use compiler::ir_ser;
use compiler::disasm;
use compiler::pdb;
// --- Global flag state ---------------------------------------------------
// Parsed from --borrowck= and --timeout flags before command dispatch.
// Fides does not support module-level mutable vars, so these are passed
// as extra parameters to command handlers that need them.
// g_borrowck: "on" (default), "warn", or "off"
// g_timeout: 0 = no timeout (default), >0 = seconds before kill

// Modes of emit's pipeline that other commands set (main() below): MI11
// `fid dump-mir` and TG5 `fid disasm <file.fd>` stop before the image is
// written (the first prints the machine IR, the second the instructions);
// RL10 `fid ir-fuzz` puts a random function into the program it builds.
var g_main_dump_mir: bool = false;
var g_main_disasm: bool = false;
var g_main_irfuzz: bool = false;
var g_main_irfuzz_seed: i64 = 0;
// MI18: `fid codegen` is emit's machine layer too (cmd_codegen): the full
// target its --target names, and with --elf/--coff/--macho <o> the object
// file to write (as `--obj -o <o>`; --coff takes the Windows x64 layer, as
// `--nat`)
var g_main_codegen_target: str = "";
var g_main_codegen_obj: str = "";
var g_main_codegen_nat: bool = false;

pub fn main() -> i64 {
    var n: i64 = p_argc();

    // Two invocation modes:
    //   Interpreter: fidesc run main.fd -- ccompile <file.fd> -o <output>
    //   Native:      fid ccompile <file.fd> -o <output>
    // Find the "--" separator (interpreter mode) or start at argv[1] (native).
    var start: i64 = 1;
    var i: i64 = 0;
    while i < n {
        if p_argv(i) == "--" {
            start = i + 1;
            break;
        }
        i = i + 1;
    }

    if start >= n {
        print_usage();
        return 1;
    }

    // --- Parse global flags (before command dispatch) -------------------
    // Reference: src/main.rs:57-99
    // --borrowck=off|warn|on  controls borrow checker mode
    // --timeout N / --timeout=N  sets compilation timeout in seconds
    // These can appear anywhere in the args. We scan for them, store the
    // values, and skip them so command-specific parsing isn't confused.
    var g_borrowck: str = "on";
    var g_timeout: i64 = 0;
    var gi: i64 = start;
    while gi < n {
        var garg: str = p_argv(gi);
        // --debug: a debug build, where @cfg(debug) holds (the command
        // reads the flag too, for its own options)
        if garg == "--debug" {
            g_cfg_debug = true;
        }
        // --edition=N: the edition of a file that states none (ST3)
        if str_starts_with(garg, "--edition=") {
            set_default_edition(c_str_parse_i64(str_substring_from(garg, 10)));
        }
        // --profile-use <file>: a profile from `fid run --profile` (OP30)
        if garg == "--profile-use" && gi + 1 < n {
            g_pgo_use_path = p_argv(gi + 1);
        }
        // --borrowck=off|warn|on
        if str_starts_with(garg, "--borrowck=") {
            var bval: str = str_substring_from(garg, 11);
            match borrowck_mode_parse(bval) {
                OptBorrowckMode::Some(mode) => {
                    match mode {
                        BorrowckMode::Off => {
                            g_borrowck = "off";
                        }
                        BorrowckMode::Warn => {
                            g_borrowck = "warn";
                        }
                        BorrowckMode::On => {
                            g_borrowck = "on";
                        }
                    }
                }
                OptBorrowckMode::None => {
                    p_eprint_str("Invalid --borrowck value '");
                    p_eprint_str(bval);
                    p_eprint_str("'. Use off, warn, or on.\n");
                    return 1;
                }
            }
        }
        // --timeout=N
        if str_starts_with(garg, "--timeout=") {
            var tval: str = str_substring_from(garg, 10);
            var tsecs: i64 = c_str_parse_i64(tval);
            if tsecs > 0 {
                g_timeout = tsecs;
            }
        }
        // --timeout N (value is next arg)
        if garg == "--timeout" {
            if gi + 1 < n {
                var tnext: str = p_argv(gi + 1);
                var tsecs2: i64 = c_str_parse_i64(tnext);
                if tsecs2 > 0 {
                    g_timeout = tsecs2;
                }
            }
        }
        gi = gi + 1;
    }

    // Find the actual command (first non-flag argument)
    var cmd_idx: i64 = start;
    while cmd_idx < n {
        var cmd_arg: str = p_argv(cmd_idx);
        // N12: `fid --version` is `fid version` (it was skipped as a flag,
        // leaving no command)
        if cmd_arg == "--version" {
            return cmd_version();
        }
        if !str_starts_with(cmd_arg, "--") {
            break;
        }
        cmd_idx = cmd_idx + 1;
    }
    start = cmd_idx;

    // TODO: --timeout requires spawning a watcher thread to kill the process
    // after N seconds. Fides is single-threaded for now, so we store the
    // value but cannot enforce it. When p_thread_spawn supports timers,
    // wire this up. Reference: src/main.rs:103-109.

    var command: str = p_argv(start);

    // RL20: `--crash-report` on any command runs it again as a child that
    // names its stages; a crash is reported with the stage and the function
    // it failed in, and how to reduce the program (crash_report_run)
    if argv_has(n, "--crash-report") && str_len(env_or_empty("FID_CRASH_TRACE")) == 0 {
        return crash_report_run(n, start);
    }

    // MI11: fid dump-mir <file.fd> [--target <t>] [--fn <name>]
    if command == "dump-mir" {
        return cmd_dump_mir(n, start, g_borrowck, g_timeout);
    }
    // TG5: fid disasm <file.fd | image> [--fn <name>] [--target <t>]
    if command == "disasm" {
        return cmd_disasm(n, start, g_borrowck, g_timeout);
    }
    // RL10: fid emit-ir <file.fir> [--target <t>] [-o <out>] [--mid-end]
    if command == "emit-ir" {
        return cmd_emit_ir(n, start);
    }
    // RL10: fid ir-fuzz <seed> [--target <t>] [-o <out>] [--save-ir <f>]
    if command == "ir-fuzz" {
        return cmd_ir_fuzz(n, start, g_borrowck, g_timeout);
    }
    // RL20: fid reduce <file.fd> [-o <out.fd>] [--fails <cmd> | --cmd <c>]
    if command == "reduce" {
        return cmd_reduce(n, start, g_timeout);
    }

    if command == "compile" {
        return cmd_compile(n, start, g_borrowck, g_timeout);
    }
    if command == "ccompile" {
        return cmd_ccompile(n, start, g_borrowck, g_timeout);
    }
    if command == "build" {
        return cmd_build(n, start, g_borrowck, g_timeout);
    }
    if command == "emit" {
        return cmd_build(n, start, g_borrowck, g_timeout);
    }
    if command == "build-x86" {
        return cmd_build_x86(n, start);
    }
    if command == "run" {
        return cmd_run(n, start, g_borrowck, g_timeout);
    }
    if command == "tokens" {
        return cmd_tokens(n, start);
    }
    if command == "dump-tokens" {
        return cmd_tokens(n, start);
    }
    if command == "ast" {
        return cmd_ast(n, start);
    }
    if command == "dump-ast" {
        return cmd_ast(n, start);
    }
    if command == "dump-ast-raw" {
        return cmd_ast(n, start);
    }
    if command == "dump-ast-flat" {
        return cmd_ast(n, start);
    }
    if command == "ir" {
        return cmd_ir(n, start);
    }
    if command == "dump-ir" {
        return cmd_ir(n, start);
    }
    if command == "dump-c" {
        return cmd_dump_c(n, start);
    }
    if command == "split-c" {
        return cmd_split_c(n, start);
    }
    // MI18: the PIR path (pir.fd, opt.fd, regalloc.fd, codegen_*.fd) is
    // gone: `pir`/`dump-pir` say where its views went; `opt` prints the IR
    // after the IR optimizer the machine layer runs (iropt_native)
    if command == "pir" || command == "dump-pir" {
        return cmd_pir_removed(command);
    }
    if command == "opt" {
        return cmd_opt(n, start);
    }
    if command == "fmt" {
        return cmd_fmt(n, start);
    }
    if command == "version" || command == "-V" {
        return cmd_version();
    }
    if command == "test" {
        return cmd_test(n, start);
    }
    if command == "bench" {
        return cmd_bench(n, start);
    }
    // TL1: fid fuzz <file.fd> [--seeds N]: its fn fuzz_*(data: Vec<u8>)
    if command == "fuzz" {
        if start + 2 > n {
            p_eprint_str("Usage: fid fuzz <file.fd> [--seeds <n>]\n");
            return 1;
        }
        return cmd_test_file(n, start, true);
    }
    // TL3: fid fix <file.fd> [--check]: apply the suggested fixes
    if command == "fix" {
        return cmd_fix(n, start);
    }
    if command == "profile" {
        return cmd_profile(n, start);
    }
    if command == "lint" {
        return cmd_lint(n, start);
    }
    if command == "explain" {
        return cmd_explain(n, start);
    }
    if command == "explain-error" {
        return cmd_explain_error(n, start);
    }
    if command == "test-rules" {
        // fid test-rules [--smt <dir>]: the rules on values; with --smt, an
        // SMT-LIB proof obligation per rule and width as well
        if start + 3 <= n && p_argv(start + 1) == "--smt" {
            return rules_selftest() + rules_smt(p_argv(start + 2));
        }
        return rules_selftest();
    }
    if command == "check" {
        return cmd_check(n, start);
    }
    if command == "serve" {
        return cmd_serve(n, start);
    }
    if command == "doc" {
        return cmd_scribe(n, start);
    }
    if command == "wasm" {
        return cmd_wasm(n, start, g_borrowck);
    }
    if command == "watch" {
        return cmd_watch(n, start);
    }
    if command == "lsp" {
        return lsp_run();
    }
    if command == "scribe" {
        return cmd_scribe(n, start);
    }
    if command == "veil" {
        return cmd_veil(n, start);
    }
    if command == "doctest" {
        return cmd_doctest(n, start);
    }
    if command == "inspect" {
        return cmd_inspect(n, start);
    }
    // CT7: run a recording of `fid run --record` again, its inputs from it
    if command == "replay" {
        return cmd_replay(n, start, g_borrowck);
    }
    // TL5: the interactive IR debugger (compiler/debugger.fd), as fidesc's
    if command == "debug" {
        return cmd_debug(n, start);
    }
    if command == "ark" {
        return ark_main();
    }
    if command == "repl" {
        return cmd_repl();
    }
    if command == "codegen" {
        return cmd_codegen(n, start, g_borrowck, g_timeout);
    }
    if command == "gpu" {
        return cmd_gpu(n, start);
    }
    if command == "verify" {
        return cmd_verify(n, start);
    }
    if command == "audit" {
        return cmd_audit(n, start);
    }
    if command == "qualify" {
        return cmd_qualify(n, start);
    }
    if command == "sourcemap" {
        return cmd_sourcemap(n, start);
    }
    if command == "parse-header" {
        return cmd_parse_header(n, start);
    }
    if command == "notebook" {
        return cmd_notebook(n, start);
    }

    print("Unknown command: ");
    print(command);
    print("\n");
    print_usage();
    return 1;
}

// --- Helper: substring from index -----------------------------------------
fn str_substring_from(s: str, start: i64) -> str {
    var slen: i64 = str_len(s);
    if start >= slen {
        return "";
    }
    if start < 0 {
        start = 0;
    }
    return str_slice(s, start, slen);
}

// --- Helper: check if a string arg is in the args list --------------------
fn has_flag(n: i64, start: i64, flag: str) -> bool {
    var i: i64 = start + 2;
    while i < n {
        // SP18: argv_at (inc.fd): a `fid serve` request's words while it runs
        if argv_at(i) == flag {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// `flag` is anywhere on the command line (before the command too).
fn argv_has(n: i64, flag: str) -> bool {
    var i: i64 = 1;
    while i < n {
        if argv_at(i) == flag {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// --- Helper: get value after a flag ---------------------------------------
fn get_flag_value(n: i64, start: i64, flag: str, default: str) -> str {
    var i: i64 = start + 2;
    while i < n {
        if argv_at(i) == flag {
            if i + 1 < n {
                return argv_at(i + 1);
            }
        }
        i = i + 1;
    }
    return default;
}

// --- Helper: get numeric value after a flag -------------------------------
fn get_flag_int(n: i64, start: i64, flag: str, default: i64) -> i64 {
    var i: i64 = start + 2;
    while i < n {
        if argv_at(i) == flag {
            if i + 1 < n {
                return c_str_parse_i64(argv_at(i + 1));
            }
        }
        i = i + 1;
    }
    return default;
}

/// `--max-mem <bytes[K|M|G]>`: the bytes it names (K, M, G: binary
/// multiples, either case), or -1 when it is not such a size.
fn lim_parse_bytes(s: str) -> i64 {
    val len: i64 = str_len(s);
    var i: i64 = 0;
    var v: i64 = 0;
    while i < len && str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 57 {
        if v > 1099511627776 {
            return -1;
        }
        v = v * 10 + (str_byte_at(s, i) - 48);
        i = i + 1;
    }
    if i == 0 {
        return -1;
    }
    var mult: i64 = 1;
    if i < len {
        val c: i64 = str_byte_at(s, i);
        if c == 75 || c == 107 {
            mult = 1024;
        } else if c == 77 || c == 109 {
            mult = 1048576;
        } else if c == 71 || c == 103 {
            mult = 1073741824;
        } else {
            return -1;
        }
        i = i + 1;
        // an optional "B" (64MB, 64mb)
        if i < len && (str_byte_at(s, i) == 66 || str_byte_at(s, i) == 98) {
            i = i + 1;
        }
    }
    if i != len {
        return -1;
    }
    return v * mult;
}

/// `--cpu-limit <seconds>`: the milliseconds it names ("2", "0.5", at most
/// three decimals count), or -1 when it is not a number of seconds.
fn lim_parse_ms(s: str) -> i64 {
    val len: i64 = str_len(s);
    var i: i64 = 0;
    var whole: i64 = 0;
    var digits: i64 = 0;
    while i < len && str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 57 {
        if whole > 1000000000000 {
            return -1;
        }
        whole = whole * 10 + (str_byte_at(s, i) - 48);
        i = i + 1;
        digits = digits + 1;
    }
    var frac_ms: i64 = 0;
    if i < len && str_byte_at(s, i) == 46 {
        i = i + 1;
        var scale: i64 = 100;
        while i < len && str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 57 {
            frac_ms = frac_ms + (str_byte_at(s, i) - 48) * scale;
            scale = scale / 10;
            i = i + 1;
            digits = digits + 1;
        }
    }
    if digits == 0 || i != len {
        return -1;
    }
    return whole * 1000 + frac_ms;
}

// --- Helper: write a build's output ----------------------------------------
/// BG52: write the bytes of a build's output to `path`; false, after an
/// error naming the file, when it cannot be written (a missing directory, a
/// file in use, a read-only place), so the command fails instead of
/// printing that it built the file.
fn write_output_vec(path: str, bytes: Vec) -> bool {
    if p_file_write_vec(path, bytes) != 0 {
        print("Error: could not write the output file: " + path + "\n");
        return false;
    }
    return true;
}

// --- Helper: find -o flag value ------------------------------------------
fn find_output_arg(n: i64, start: i64, default: str) -> str {
    var i: i64 = start + 2;
    while i < n {
        var arg: str = argv_at(i);
        if arg == "-o" {
            if i + 1 < n {
                return argv_at(i + 1);
            }
        }
        i = i + 1;
    }
    return default;
}

// --- Helper: ensure output has appropriate extension ---------------------
// On Linux, executables don't need an extension.
// On Windows, append .exe if not already present.
fn ensure_exe_extension(s: str) -> str {
    if is_posix_host() {
        return s;
    }
    if str_ends_with(s, ".exe") {
        return s;
    }
    return s + ".exe";
}

// --- Cross targets of `ccompile --target` (release F5, F8) ----------------
// A target names an OS and an architecture: `aarch64-linux`, `arm64-linux`,
// `riscv64-linux`, `x86_64-linux`, `x86_64-macos`, `aarch64-macos`,
// `x86_64-windows`, also as full triples (`aarch64-linux-musl`, ...).
// Tier 2 (PL3, scripts/tier2.sh): `aarch64-windows`, `x86_64-macos`,
// `x86_64-freebsd`, `riscv64-linux`.

/// The canonical name of an architecture as `--target` writes it
/// ("aarch64", "x86_64", "riscv64", "wasm32"), or "" when `a` is not one.
fn target_arch_name(a: str) -> str {
    if a == "arm64" || a == "aarch64" {
        return "aarch64";
    }
    if a == "x64" || a == "amd64" || a == "x86_64" {
        return "x86_64";
    }
    if a == "riscv64" || a == "riscv" || a == "rv64" {
        return "riscv64";
    }
    if a == "wasm32" || a == "wasm" {
        return "wasm32";
    }
    return "";
}

/// TL6: a target written OS first (`linux-arm64`, `linux-x64`,
/// `linux-riscv64`, `macos-arm64`, `darwin-x64`, `windows-x64`) or with
/// another name of its architecture (`arm64-linux`, `amd64-linux`,
/// `x64-windows`), as the <arch>-<os> form the backends read
/// (`aarch64-linux`, `x86_64-linux`, `aarch64-macos`, `x86_64-windows`).
/// Everything else passes unchanged: `linux`, `arm64`, `x86-64`, full
/// triples such as `aarch64-linux-musl`.
fn normalize_target(target: str) -> str {
    var dash: i64 = str_find(target, "-");
    if dash <= 0 {
        return target;
    }
    var first: str = str_slice(target, 0, dash);
    var rest: str = str_slice(target, dash + 1, str_len(target));
    if first == "linux" || first == "macos" || first == "darwin" || first == "windows" || first == "wasi" || first == "freebsd" {
        var arch: str = target_arch_name(rest);
        if str_len(arch) == 0 {
            return target;
        }
        var os: str = first;
        if os == "darwin" {
            os = "macos";
        }
        return arch + "-" + os;
    }
    var arch2: str = target_arch_name(first);
    if str_len(arch2) > 0 && arch2 != first {
        return arch2 + "-" + rest;
    }
    return target;
}

/// The target's OS: "linux", "macos", "windows", "freebsd", "wasi"
/// (WebAssembly), or "" when not known.
fn cross_target_os(target: str) -> str {
    if str_contains(target, "wasi") || str_starts_with(target, "wasm") {
        return "wasi";
    }
    if str_contains(target, "linux") {
        return "linux";
    }
    if str_contains(target, "macos") || str_contains(target, "darwin") || str_contains(target, "apple") {
        return "macos";
    }
    if str_contains(target, "windows") || str_contains(target, "mingw") {
        return "windows";
    }
    // PL3: FreeBSD through C (zig cc -target x86_64-freebsd)
    if str_contains(target, "freebsd") {
        return "freebsd";
    }
    return "";
}

/// The target's architecture: "x86_64", "aarch64", "riscv64", "wasm32", or "".
fn cross_target_arch(target: str) -> str {
    if str_starts_with(target, "wasm") || target == "wasi" {
        return "wasm32";
    }
    if str_starts_with(target, "aarch64") || str_starts_with(target, "arm64") {
        return "aarch64";
    }
    if str_starts_with(target, "riscv64") || str_starts_with(target, "riscv") {
        return "riscv64";
    }
    if str_starts_with(target, "x86_64") || str_starts_with(target, "x86-64") || str_starts_with(target, "x64") {
        return "x86_64";
    }
    return "";
}

/// The `zig cc -target` triple for a target. Linux builds are static musl
/// executables, so they run on any Linux and under qemu-user without a
/// sysroot. "" when the target is not one zig knows here.
fn cross_zig_triple(target: str) -> str {
    var os: str = cross_target_os(target);
    var arch: str = cross_target_arch(target);
    if os == "" || arch == "" {
        return "";
    }
    if os == "linux" {
        return arch + "-linux-musl";
    }
    if os == "macos" {
        return arch + "-macos";
    }
    if os == "wasi" {
        return "wasm32-wasi";
    }
    // PL3: a FreeBSD executable is dynamic against FreeBSD's libc (zig
    // ships its stubs); aarch64-windows is `aarch64-windows-gnu` below
    if os == "freebsd" {
        return arch + "-freebsd";
    }
    return arch + "-windows-gnu";
}

// --- Helpers: the host system -----------------------------------------------
/// The host: "windows", "linux" or "macos" (release F5: before, every host
/// without /proc was taken for Windows, so `fid` on a Mac named executables
/// .exe and linked ws2_32).
fn host_os() -> str {
    if p_getenv("OS") == "Windows_NT" {
        return "windows";
    }
    if c_file_exists("/proc/self/exe") {
        return "linux";
    }
    return "macos";
}

/// A POSIX host (Linux or macOS): `which`, /dev/null, executables without
/// an extension, -lm -lpthread.
fn is_posix_host() -> bool {
    return host_os() != "windows";
}

/// CB4: this machine as a machine-layer target (`x86_64-linux`,
/// `aarch64-linux`, `riscv64-linux`, `x86_64-macos`, `aarch64-macos`;
/// `x86_64-windows` on Windows). FID_HOST_ARCH overrides the architecture
/// `uname -m` reports.
fn host_native_target() -> str {
    var os: str = host_os();
    if os == "windows" {
        return "x86_64-windows";
    }
    var arch: str = target_arch_name(env_or_empty("FID_HOST_ARCH"));
    if str_len(arch) == 0 {
        arch = "x86_64";
        if p_system("case \"$(uname -m)\" in aarch64|arm64) exit 0;; esac; exit 1") == 0 {
            arch = "aarch64";
        } else if p_system("case \"$(uname -m)\" in riscv64) exit 0;; esac; exit 1") == 0 {
            arch = "riscv64";
        }
    }
    return arch + "-" + os;
}

/// Panic traces unwind the stack: zig cc links no unwinder for C on Linux
/// (macOS has _Unwind_Backtrace in libSystem).
fn zig_unwind(cc: str) -> str {
    if host_os() == "linux" && str_contains(cc, "zig") {
        return " -lunwind";
    }
    return "";
}

// --- Helper: paths in command lines (BG54) --------------------------------
// shell_word (beside self_command, below) quotes a path for a command line.

/// A command line whose first word is quoted (`"<fid>" ccompile ...`), run
/// so that cmd.exe keeps its quotes: `cmd /C` drops the first and the last
/// quote of a command that starts with one (AGENTS.md known bug 3), so on
/// Windows it gets one more pair (project_run does the same).
fn run_quoted_cmd(cmd: str) -> i64 {
    return project_run(cmd);
}

// --- Helper: `ccompile --inc` for --target (BG71) -------------------------
/// The C flags of one unit of an `--inc` build for target OS `tgt_os`, as
/// the one-unit build's (cmd_ccompile): WebAssembly takes no stack
/// protector or PIE, but WASI's emulation defines. (The flags are part of
/// each object's cache key; for the other targets they are as before.)
fn inc_unit_cflags(is_tcc: bool, tgt_os: str) -> str {
    var flags: str = " -Wno-int-conversion";
    if !is_tcc {
        var hardening: str = " -fstack-protector-strong -fPIE";
        if tgt_os == "wasi" {
            hardening = " -D_WASI_EMULATED_MMAN -D_WASI_EMULATED_SIGNAL -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_GETPID";
        }
        flags = flags + " -Wno-incompatible-pointer-types" + hardening + " -fno-strict-overflow -fno-strict-aliasing";
    }
    return flags;
}

/// The link mode of an `--inc` build for target OS `tgt_os` (the one-unit
/// build's): -static for a zig cross build to Linux, nothing for
/// WebAssembly, the ELF-only -z options for Linux and FreeBSD only. Before,
/// the host decided (a Windows host never gave the -z options, a macOS one
/// did).
fn inc_link_mode(is_tcc: bool, tgt_os: str, zig_cross: bool) -> str {
    if is_tcc {
        return "";
    }
    var mode: str = " -pie";
    if zig_cross && tgt_os == "linux" {
        mode = " -static";
    }
    if tgt_os == "wasi" {
        mode = "";
    }
    if tgt_os == "linux" || tgt_os == "freebsd" {
        mode = mode + " -Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack";
    }
    return mode;
}

/// The system libraries of an `--inc` build for target OS `tgt_os` (the
/// one-unit build's), not the host's: a Linux target from a Windows host
/// got -lws2_32, and no target but the host's got -lunwind.
fn inc_system_libs(cc: str, tgt_os: str, zig_cross: bool) -> str {
    if tgt_os == "windows" {
        return " -lm -lws2_32" + repro_win_flags(cc, false);
    }
    if tgt_os == "linux" {
        var unwind: str = zig_unwind(cc);
        if zig_cross {
            unwind = " -lunwind";
        }
        return " -lm -lpthread" + unwind;
    }
    if tgt_os == "freebsd" {
        if str_contains(cc, "zig") {
            return " -lm -lpthread -lunwind";
        }
        return " -lm -lpthread";
    }
    if tgt_os == "macos" {
        return " -lm -lpthread";
    }
    if tgt_os == "wasi" {
        return " -lm -lwasi-emulated-mman -lwasi-emulated-signal -lwasi-emulated-process-clocks -lwasi-emulated-getpid";
    }
    return " -lm" + zig_unwind(cc);
}

// --- Helper: read source file or error -----------------------------------

// --- Helper: print errors from Vec<str> ----------------------------------
fn print_errors(errs: Vec<str>) {
    var ei: i64 = 0;
    while ei < errs.len() {
        // enrich_errors has already put "error: " (or "error[E0nn]: ") on some
        if !str_starts_with(errs.get(ei), "error") {
            p_eprint_str("error: ");
        }
        p_eprint_str(errs.get(ei));
        p_eprint_str("\n");
        ei = ei + 1;
    }
}

// --- version -------------------------------------------------------------
fn cmd_version() -> i64 {
    // N12: the version comes from compiler/build_info.fd (a release build's
    // exact version, else "<base>+dev")
    print("fid " + fid_version() + " (self-hosted Fides compiler)\n");
    // N12 (release-roadmap): the exact build -- a hash of this
    // executable's bytes, the same for the same build on every machine
    print("build: " + fid_build_id() + "\n");
    // N12: the commit and date compiled in by a release build
    // (compiler/build_info.fd, written by scripts/build-info.sh)
    if str_len(fid_build_commit()) > 0 {
        print("commit: " + fid_build_commit() + "\n");
    }
    if str_len(fid_build_date()) > 0 {
        print("built: " + fid_build_date() + "\n");
    }
    // D9: what the build caches are keyed on: "src:" (a release build: the
    // source's hash and the executable's size, no read of the executable)
    // or "exe:" (the executable's bytes)
    print("cache key: " + inc_compiler_identity() + ":" + fid_hex16(inc_compiler_hash()) + "\n");
    print("Bootstrap: Rust compiler -> C -> compiled by itself to a fixpoint\n");
    return 0;
}

/// `h` as 16 hex digits.
fn fid_hex16(h: i64) -> str {
    var digits: str = "0123456789abcdef";
    var out: str = "";
    var k: i64 = 15;
    while k >= 0 {
        var nib: i64 = (h >> (k * 4)) & 15;
        out = out + str_slice(digits, nib, nib + 1);
        k = k - 1;
    }
    return out;
}

/// N12: what identifies this build of fid: "exe:<hash>", the hash of
/// this executable's bytes (inc.fd inc_exe_hash: argv[0], else the PATH
/// entry that holds it), or why it cannot be had. (The build caches key on
/// inc_compiler_hash, which in a release build is made from the source's
/// hash instead: D9, `fid version` prints it as "cache key".)
fn fid_build_id() -> str {
    var h: i64 = inc_exe_hash();
    if h == 0 {
        return "unknown (cannot find the executable " + p_argv(0) + ")";
    }
    var id: str = "exe:" + fid_hex16(h);
    // A release build has a stamp beside it (scripts/release-fresh.sh
    // --write: `<exe>.stamp`, lines "commit <c>" and "built <date>")
    var exe: str = p_argv(0);
    var stamp: str = "";
    match read_file(exe + ".stamp") {
        Option::Some(s) => {
            stamp = s;
        }
        Option::None => {
            match read_file(exe + ".exe.stamp") {
                Option::Some(s2) => {
                    stamp = s2;
                }
                Option::None => {
                }
            }
        }
    }
    var lines: Vec<str> = str_split(stamp, "\n");
    var i: i64 = 0;
    while i < lines.len() {
        var l: str = str_trim(lines.get(i));
        if str_starts_with(l, "commit ") || str_starts_with(l, "built ") {
            id = id + ", " + l;
        }
        i = i + 1;
    }
    return id;
}

// --- tokens / dump-tokens ------------------------------------------------
fn cmd_tokens(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid tokens <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var lexer_obj: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lexer_obj.tokenize();
    var ti: i64 = 0;
    while ti < tokens.len() {
        var tok: Token = tokens.get(ti);
        // Format: "  LINE:COL  KIND"
        var line_str: str = int_to_str(tok.line);
        var col_str: str = int_to_str(tok.col);
        var kind_str: str = token_kind_to_str(tok.kind);
        // Pad line to 4 chars, col to 3 chars
        line_str = c_str_pad_left(line_str, 4, 32);
        col_str = c_str_pad_left(col_str, 3, 32);
        print(line_str);
        print(":");
        print(col_str);
        print("  ");
        print(kind_str);
        print("\n");
        ti = ti + 1;
    }
    return 0;
}

// --- ast / dump-ast ------------------------------------------------------
fn cmd_ast(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid ast <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    // Parse without merging stdlib -- just show user AST
    var result: ResultProgram = build_program_with_path(source, OptStr::Some(input));
    match result {
        ResultProgram::Ok(program) => {
            // Print a simple summary (no full AST formatter yet)
            print("Program:\n");
            print("  Structs: ");
            print(int_to_str(program.structs.len()));
            print("\n");
            print("  Enums: ");
            print(int_to_str(program.enums.len()));
            print("\n");
            print("  Functions: ");
            print(int_to_str(program.funcs.len()));
            print("\n");
            var si: i64 = 0;
            while si < program.funcs.len() {
                var fn_def: Func = program.funcs.get(si);
                print("    fn ");
                print(fn_def.name);
                print("\n");
                si = si + 1;
            }
            return 0;
        }
        ResultProgram::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- ir / dump-ir --------------------------------------------------------
fn cmd_ir(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid ir <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var result: ResultIrModule = lower_to_ir_module(source);
    match result {
        ResultIrModule::Ok(ir_mod) => {
            print(IrModule_to_str(&ir_mod));
            print("\n");
            return 0;
        }
        ResultIrModule::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- dump-c --------------------------------------------------------------
fn cmd_dump_c(n: i64, start: i64) -> i64 {
    // SP2: `--time` prints the per-stage table (stderr) for the C path too
    var t_start: i64 = p_clock_now_ms();
    if has_flag(n, start, "--time") {
        set_time_on();
    }
    if start + 2 > n {
        p_eprint_str("Usage: fid dump-c <file.fd> [--time]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var result: ResultStr = ccompile_source_with_path(source, input, "on");
    match result {
        ResultStr::Ok(c_code) => {
            print(c_code);
            time_mark("total", t_start);
            time_report();
            return 0;
        }
        ResultStr::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- split-c -------------------------------------------------------------
// `fid split-c <in.c> <out-prefix> <n>`: one generated C file as n units
// and a header (compiler/csplit.fd), to compile a large program at -O2 in
// parts (scripts/bootstrap.sh does it for the compiler).
fn cmd_split_c(n: i64, start: i64) -> i64 {
    if start + 4 > n {
        p_eprint_str("Usage: fid split-c <in.c> <out-prefix> <n>\n");
        return 1;
    }
    var in_c: str = p_argv(start + 1);
    var prefix: str = p_argv(start + 2);
    var parts_s: str = p_argv(start + 3);
    var parts: i64 = str_parse_int(parts_s);
    return cs_split_files(in_c, prefix, parts);
}

// --- pir / dump-pir (removed, MI18) ---------------------------------------
// The PIR path (compiler/pir.fd's L1/L2/L3, opt.fd, regalloc.fd and the
// codegen_*.fd assembly writers) built nothing any more: every native build
// is the machine layer (nat_ir) or pe_ir. Its commands point to what took
// their place.
fn cmd_pir_removed(command: str) -> i64 {
    p_eprint_str("fid " + command + ": the PIR path was removed (MI18). Instead:\n");
    p_eprint_str("  fid dump-ir  <file.fd>                 the IR as lowered\n");
    p_eprint_str("  fid opt      <file.fd> [--fn <name>]   the IR after the IR optimizer\n");
    p_eprint_str("  fid dump-mir <file.fd> [--fn <name>]   the machine IR after allocation\n");
    p_eprint_str("  fid disasm   <file.fd> [--fn <name>]   the machine code\n");
    return 1;
}

// --- opt -----------------------------------------------------------------
/// MI18: fid opt <file.fd> [--fn <name>]: the program's IR after the IR
/// optimizer that `emit` runs before the machine layer (iropt.fd
/// iropt_native; FID_IROPT_OFF=<passes> turns passes off,
/// FID_IROPT_ON=<passes> turns opt-in ones on, FID_IROPT_STATS=1 counts
/// what they did), the whole module or only function <name>. Before Nov 17
/// it printed PIR L2 after opt.fd's passes, which no build used.
fn cmd_opt(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid opt <file.fd> [--fn <name>]\n");
        p_eprint_str("       the IR after the IR optimizer (iropt); FID_IROPT_OFF=<passes>, FID_IROPT_ON=<passes>|all, FID_IROPT_STATS=1\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var only_fn: str = get_flag_value(n, start, "--fn", "");
    var result: ResultIrModule = lower_to_ir_module_with_path(source, input, "on");
    match result {
        ResultIrModule::Ok(ir_mod) => {
            var opt_mod: IrModule = ir_mod;
            iropt_native(&mut opt_mod);
            if str_len(only_fn) > 0 {
                var text: str = IrModule_function_detail_str(&opt_mod, only_fn);
                if str_len(text) == 0 {
                    p_eprint_str("Error: no function '" + only_fn + "' after optimization (inlined and removed, or not in " + input + ")\n");
                    return 1;
                }
                print(text);
                return 0;
            }
            print(IrModule_to_str(&opt_mod));
            print("\n");
            return 0;
        }
        ResultIrModule::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- fmt -----------------------------------------------------------------
fn cmd_fmt(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid fmt <file.fd> [--check] [-w|--write]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var check_mode: bool = false;
    var write_mode: bool = false;
    var ai: i64 = start + 2;
    while ai < n {
        if p_argv(ai) == "--check" {
            check_mode = true;
        }
        if p_argv(ai) == "-w" || p_argv(ai) == "--write" {
            write_mode = true;
        }
        ai = ai + 1;
    }
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var formatted: str = format_source(source);
    // Formatting changes spacing only; anything else is a formatter bug,
    // and the file is left as it is
    if !fmt_same_tokens(source, formatted) {
        p_eprint_str("Error: fid fmt would change the tokens of ");
        p_eprint_str(input);
        p_eprint_str(", not only their spacing (a formatter bug); the file was not changed
");
        return 1;
    }
    // The formatter writes LF; a checkout's CRLF line endings are not a
    // formatting difference (BG124)
    var same: bool = formatted == str_replace(source, "\r", "");
    if check_mode {
        if same {
            p_eprint_str(input);
            p_eprint_str(": already formatted\n");
            return 0;
        } else {
            p_eprint_str(input);
            p_eprint_str(": would reformat\n");
            return 1;
        }
    }
    if write_mode {
        p_file_write(input, formatted);
        if same {
            p_eprint_str(input);
            p_eprint_str(": already formatted\n");
        } else {
            p_eprint_str(input);
            p_eprint_str(": formatted\n");
        }
        return 0;
    }
    // No -w: the formatted source to stdout; the file is not touched
    print(formatted);
    return 0;
}

// --- run -----------------------------------------------------------------
// Reference: src/main.rs:389
// Interprets the source file using the self-hosted IR interpreter.
// Flags: -v/--verbose, --release, --max-recursion N, --max-steps N,
//        --max-memory N, --timeout N, --trace
fn cmd_run(n: i64, start: i64, g_borrowck: str, g_timeout: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid run <file.fd> [-v] [--release] [--max-recursion N] [--max-steps N] [--max-memory N] [--timeout N] [--trace <fn>[,<fn>...]] [--crash-file <file>] [--record <trace>] [--leaks] [--mem] [--checked-alloc] [--max-mem <bytes[K|M|G]>] [--cpu-limit <seconds>]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);

    // roadmap P12: --max-mem <bytes[K|M|G]> / --cpu-limit <seconds>, as
    // ccompile takes them: the program's limits when FID_MEM_LIMIT /
    // FID_CPU_LIMIT is not set (interp.fd interp_lim_setup); a set
    // variable wins
    var lim_args: str = "";
    var run_lim_mem: i64 = 0;
    var run_lim_cpu_ms: i64 = 0;
    var run_mem_arg: str = get_flag_value(n, start, "--max-mem", "");
    if str_len(run_mem_arg) > 0 {
        run_lim_mem = lim_parse_bytes(run_mem_arg);
        if run_lim_mem <= 0 {
            print("Invalid --max-mem '" + run_mem_arg + "': use <bytes>[K|M|G], e.g. 64M\n");
            return 1;
        }
        lim_args = lim_args + " --max-mem " + run_mem_arg;
    }
    var run_cpu_arg: str = get_flag_value(n, start, "--cpu-limit", "");
    if str_len(run_cpu_arg) > 0 {
        run_lim_cpu_ms = lim_parse_ms(run_cpu_arg);
        if run_lim_cpu_ms <= 0 {
            print("Invalid --cpu-limit '" + run_cpu_arg + "': use seconds, e.g. 2 or 0.5\n");
            return 1;
        }
        lim_args = lim_args + " --cpu-limit " + run_cpu_arg;
    }

    // --leaks / --checked-alloc: the interpreter has no allocator to watch, so
    // build through C with the debug allocator and run that
    var mem_flags: str = "";
    if has_flag(n, start, "--leaks") {
        mem_flags = " --leaks";
    }
    if has_flag(n, start, "--checked-alloc") {
        mem_flags = mem_flags + " --checked-alloc";
    }
    if has_flag(n, start, "--mem") {
        mem_flags = mem_flags + " --mem";
    }
    if str_len(mem_flags) > 0 {
        var mexe: str = "_fides_memcheck_tmp.exe";
        var mrun: str = ".\\_fides_memcheck_tmp.exe";
        if is_posix_host() {
            mexe = "_fides_memcheck_tmp";
            mrun = "./_fides_memcheck_tmp";
        }
        if run_quoted_cmd("\"" + p_argv(0) + "\" ccompile " + shell_word(input) + " -o " + mexe + " --debug" + mem_flags + lim_args) != 0 {
            p_eprint_str("run: the build failed\n");
            return 1;
        }
        val mcode: i64 = p_system(mrun);
        p_file_delete(mexe);
        return mcode;
    }
    // CO2: --trace-spans: the program's trace spans (stdlib/trace.fd) on,
    // as FIDES_TRACE=1 does
    if has_flag(n, start, "--trace-spans") {
        run_set_env("FIDES_TRACE", "1");
    }

    // Parse run-specific flags
    var verbose: bool = has_flag(n, start, "-v") || has_flag(n, start, "--verbose");
    var release: bool = has_flag(n, start, "--release");
    var trace: bool = has_flag(n, start, "--trace");
    // CT10: --trace <f,g> (or --trace=f,g): the interpreter prints each call
    // of f and g with its arguments and its result on stderr (interp.fd
    // Interpreter_run_function), no change to the program. A bare --trace
    // (no name after it) traces nothing, as before.
    var trace_list: str = "";
    var tri: i64 = start + 2;
    while tri < n {
        var tra: str = p_argv(tri);
        if str_starts_with(tra, "--trace=") {
            trace_list = str_slice(tra, 8, str_len(tra));
        } else if tra == "--trace" && tri + 1 < n {
            var trn: str = p_argv(tri + 1);
            if !str_starts_with(trn, "-") && !str_ends_with(trn, ".fd") {
                trace_list = trn;
            }
        }
        tri = tri + 1;
    }
    if str_len(trace_list) > 0 {
        trace_set(trace_list);
        trace = true;
    }
    // --max-recursion N (default 1000, 0 = unlimited)
    var max_recursion: i64 = get_flag_int(n, start, "--max-recursion", 1000);
    // --max-steps N (default 0 = unlimited)
    var max_steps: i64 = get_flag_int(n, start, "--max-steps", 0);
    // --max-memory N (in MB, default 0 = unlimited)
    var max_memory: i64 = get_flag_int(n, start, "--max-memory", 0);
    // --timeout N (execution timeout in seconds)
    var run_timeout: i64 = get_flag_int(n, start, "--timeout", g_timeout);

    if verbose {
        p_eprint_str("[run] File: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        p_eprint_str("[run] release: ");
        if release {
            p_eprint_str("yes");
        } else {
            p_eprint_str("no");
        }
        p_eprint_str(", trace: ");
        if trace {
            p_eprint_str("yes");
        } else {
            p_eprint_str("no");
        }
        p_eprint_str("\n");
        p_eprint_str("[run] max-recursion: ");
        p_eprint_str(int_to_str(max_recursion));
        p_eprint_str(", max-steps: ");
        p_eprint_str(int_to_str(max_steps));
        p_eprint_str(", max-memory: ");
        p_eprint_str(int_to_str(max_memory));
        p_eprint_str(" MB\n");
        if run_timeout > 0 {
            p_eprint_str("[run] timeout: ");
            p_eprint_str(int_to_str(run_timeout));
            p_eprint_str(" seconds\n");
        }
    }

    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }

    // Use the self-hosted IR interpreter for the `run` command.
    // This replaces the previous C compile-and-execute fallback.
    // --max-recursion, --max-steps, --max-memory, --trace are wired
    // into the interpreter's execution limits.
    if verbose {
        p_eprint_str("[run] Using IR interpreter\n");
    }

    // Convert max_memory from MB to bytes
    var max_memory_bytes: i64 = max_memory * 1048576;

    // G8.2: Pass borrowck mode through the pipeline (globals don't persist in C codegen)
    // --profile <file>: count the calls of every function and write them
    // (`fid emit ... --profile-use <file>` then uses them, OP30)
    var prof_out: str = get_flag_value(n, start, "--profile", "");
    if prof_out != "" {
        g_pgo_record = true;
    }
    // CO9: --crash-file <file> (or FID_CRASH_REPORT=<file>): a panic
    // writes a report with the message, the trace and this build, which
    // `fid inspect <file>` prints (interp.fd interp_write_crash_report).
    // Not --crash-report: that one (RL20, no value) reports a crash of the
    // compiler itself and runs the command again as a child.
    var crash_path: str = get_flag_value(n, start, "--crash-file", "");
    var crash_asked: bool = str_len(crash_path) > 0;
    match env_var("FID_CRASH_REPORT") {
        Option::Some(_cp) => {
            crash_asked = true;
        }
        Option::None => {
        }
    }
    if crash_asked {
        run_crash_report_setup(crash_path, "fid " + fid_version() + ", build " + fid_build_id(), input);
    }
    // CT7: --record <trace>: every effect call's arguments and result go to
    // <trace>, which `fid replay <trace>` runs again without real I/O
    var record_path: str = get_flag_value(n, start, "--record", "");
    if str_len(record_path) > 0 {
        if !run_record_start(record_path, input, source) {
            p_eprint_str("error: cannot write the trace " + record_path + "\n");
            return 1;
        }
    }
    run_limit_defaults(run_lim_mem, run_lim_cpu_ms);
    var run_rc: i64 = interpret_source_with_path(source, input, max_recursion, max_steps, max_memory_bytes, verbose, g_borrowck);
    if str_len(record_path) > 0 {
        run_record_finish(run_rc);
        p_eprint_str("recorded: " + record_path + " (replay it with `fid replay " + record_path + "`)\n");
    }
    if prof_out != "" {
        if pgo_write(prof_out) {
            p_eprint_str("profile written: " + prof_out + "
");
        } else {
            p_eprint_str("error: cannot write profile " + prof_out + "
");
        }
    }
    return run_rc;
}

// --- test ----------------------------------------------------------------
// Reference: src/main.rs:1384
// Scans tests/bootstrap/ directory for .fd files, compiles and runs each.
// Flags: --fail (expect test to fail)
// Backends: C codegen (tcc), PE emitter. TODO: interpreter backend.
/// The functions of `source` whose name starts with `prefix` and that take no
/// arguments: `fn test_x()` or `pub fn test_x()`.
fn test_fns(source: str, prefix: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var lines: Vec<str> = str_split(source, "\n");
    var i: i64 = 0;
    while i < lines.len() {
        var t: str = str_trim(lines.get(i));
        if str_starts_with(t, "pub ") {
            t = str_slice(t, 4, str_len(t));
        }
        if str_starts_with(t, "fn " + prefix) {
            var open: i64 = str_find(t, "(");
            if open > 3 && str_find(t, "()") == open {
                out.push(str_slice(t, 3, open));
            }
        }
        i = i + 1;
    }
    return out;
}

/// The functions of `source` named `fn fuzz_*` that take one argument
/// (`fn fuzz_x(data: Vec<u8>)`) — CT4's fuzz targets.
fn test_fns_fuzz(source: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var lines: Vec<str> = str_split(source, "\n");
    var i: i64 = 0;
    while i < lines.len() {
        var t: str = str_trim(lines.get(i));
        if str_starts_with(t, "pub ") {
            t = str_slice(t, 4, str_len(t));
        }
        if str_starts_with(t, "fn fuzz_") {
            var open: i64 = str_find(t, "(");
            if open > 3 && str_find(t, "()") != open {
                out.push(str_slice(t, 3, open));
            }
        }
        i = i + 1;
    }
    return out;
}

/// CT2: the names of `names` that hold `part`.
fn test_filter(names: Vec<str>, part: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < names.len() {
        if str_contains(names.get(i), part) {
            out.push(names.get(i));
        }
        i = i + 1;
    }
    return out;
}

/// CT3: the instant (unix seconds) and the seed a test sees under `fid
/// test`: FIDES_TEST_NOW and FIDES_TEST_SEED, read by stdlib dt_now and
/// random_seed_time.
fn test_fixed_now() -> str {
    return "1700000000";
}

fn test_fixed_seed() -> str {
    return "1";
}

/// CT3: does test `name` run with the fixed clock and seed? Not with
/// --real-clock, nor for a test whose name ends in `_real_clock`, nor when
/// FIDES_TEST_NOW is set already (the caller's value is passed on).
fn test_fixed_clock(name: str, real_clock: bool) -> bool {
    if real_clock || str_ends_with(name, "_real_clock") {
        return false;
    }
    return str_len(env_or_empty("FIDES_TEST_NOW")) == 0;
}

/// What goes before the test program's command line: FIDES_UPDATE=1 for
/// --update (CT5), the fixed clock and seed (CT3) when `fixed` (the
/// seed only when FIDES_TEST_SEED is not set already), and FIDES_ROW for
/// `-run <test>/<row>` (SL13: stdlib/test.fd runs only the table rows
/// whose name holds it).
fn test_env_prefix(update: bool, fixed: bool, row: str) -> str {
    var vars: Vec<str> = Vec::new();
    if update {
        vars.push("FIDES_UPDATE=1");
    }
    if fixed {
        vars.push("FIDES_TEST_NOW=" + test_fixed_now());
        if str_len(env_or_empty("FIDES_TEST_SEED")) == 0 {
            vars.push("FIDES_TEST_SEED=" + test_fixed_seed());
        }
    }
    if str_len(row) > 0 {
        if is_posix_host() {
            vars.push("FIDES_ROW='" + str_replace(row, "'", "'\\''") + "'");
        } else {
            vars.push("FIDES_ROW=" + row);
        }
    }
    var out: str = "";
    var i: i64 = 0;
    while i < vars.len() {
        if is_posix_host() {
            out = out + vars.get(i) + " ";
        } else {
            // no space before &&: cmd would keep it in the value
            out = out + "set " + vars.get(i) + "&& ";
        }
        i = i + 1;
    }
    return out;
}

/// CT2 (`fid test --jobs n`): run each test of `names` through the test
/// program `exe` (in the current directory), `jobs` processes at a time.
/// Each batch is a shell script (POSIX: background jobs and `wait`;
/// Windows: PowerShell Start-Process and Wait-Process) that leaves each
/// test's output in _fides_t<k>.out/.err and its exit status in
/// _fides_t<k>.code. The output of each test is printed in the order of
/// `names`; the exit statuses are returned in that order (a test whose
/// status is missing counts as failed).
fn test_run_parallel(exe: str, names: Vec<str>, jobs: i64, update: bool, real_clock: bool, row: str) -> Vec<i64> {
    var codes: Vec<i64> = Vec::new();
    var posix: bool = is_posix_host();
    var batch: str = "_fides_test_batch.ps1";
    if posix {
        batch = "_fides_test_batch.sh";
    }
    var at: i64 = 0;
    while at < names.len() {
        var end: i64 = at + jobs;
        if end > names.len() {
            end = names.len();
        }
        var script: str = "";
        if posix {
            if update {
                script = "FIDES_UPDATE=1\nexport FIDES_UPDATE\n";
            }
        } else {
            script = "$p = @()\n";
            if update {
                script = script + "$env:FIDES_UPDATE = '1'\n";
            }
            // SL13: the table rows to run
            if str_len(row) > 0 {
                script = script + "$env:FIDES_ROW = '" + str_replace(row, "'", "''") + "'\n";
            }
        }
        var k: i64 = at;
        while k < end {
            var base: str = "_fides_t" + int_to_str(k);
            if posix {
                script = script + "( " + test_env_prefix(false, test_fixed_clock(names.get(k), real_clock), row) + "./" + exe + " " + names.get(k) + " 1 > " + base + ".out 2>&1; echo $? > " + base + ".code ) &\n";
            } else {
                // CT3: this test's clock, fixed or real (Start-Process
                // passes the environment on)
                if test_fixed_clock(names.get(k), real_clock) {
                    script = script + "$env:FIDES_TEST_NOW = '" + test_fixed_now() + "'\n";
                    if str_len(env_or_empty("FIDES_TEST_SEED")) == 0 {
                        script = script + "$env:FIDES_TEST_SEED = '" + test_fixed_seed() + "'\n";
                    }
                } else if str_len(env_or_empty("FIDES_TEST_NOW")) == 0 {
                    script = script + "Remove-Item Env:FIDES_TEST_NOW -ErrorAction SilentlyContinue\n";
                    if str_len(env_or_empty("FIDES_TEST_SEED")) == 0 {
                        script = script + "Remove-Item Env:FIDES_TEST_SEED -ErrorAction SilentlyContinue\n";
                    }
                }
                script = script + "$x = Start-Process -FilePath '.\\" + exe + "' -ArgumentList '" + names.get(k) + "','1' -NoNewWindow -PassThru -RedirectStandardOutput '" + base + ".out' -RedirectStandardError '" + base + ".err'\n";
                // the handle kept, or ExitCode reads empty after the exit
                script = script + "$null = $x.Handle\n$p += $x\n";
            }
            k = k + 1;
        }
        if posix {
            script = script + "wait\n";
        } else {
            script = script + "$p | Wait-Process\n";
            var j: i64 = 0;
            while j < end - at {
                script = script + "Set-Content -Path '_fides_t" + int_to_str(at + j) + ".code' -Value $p[" + int_to_str(j) + "].ExitCode\n";
                j = j + 1;
            }
        }
        p_file_write(batch, script);
        if posix {
            p_system("sh " + batch);
        } else {
            p_system("powershell -NoProfile -ExecutionPolicy Bypass -File " + batch);
        }
        k = at;
        while k < end {
            var base2: str = "_fides_t" + int_to_str(k);
            var code: i64 = 1;
            match read_file(base2 + ".code") {
                Option::Some(ct) => {
                    var t: str = str_trim(ct);
                    if str_len(t) > 0 {
                        code = str_parse_int(t);
                    }
                }
                Option::None => {
                }
            }
            codes.push(code);
            match read_file(base2 + ".out") {
                Option::Some(o) => {
                    print(o);
                }
                Option::None => {
                }
            }
            match read_file(base2 + ".err") {
                Option::Some(e) => {
                    p_eprint_str(e);
                }
                Option::None => {
                }
            }
            p_file_delete(base2 + ".code");
            p_file_delete(base2 + ".out");
            p_file_delete(base2 + ".err");
            k = k + 1;
        }
        at = end;
    }
    p_file_delete(batch);
    return codes;
}

// --- SL13: coverage-guided fuzzing and the saved corpus --------------------
// `fid test <file> --fuzz` (and `fid fuzz <file>`) builds the harness with
// `ccompile --fuzz-cov` (compiler.fd fuzz_cov_program: `__fz_hit(k)` at the
// start of each block of the program's own code). The harness's loop
// (fz_harness_lib) runs the seed inputs, then mutates inputs of its corpus
// (bit flips, random and "interesting" bytes, inserts, deletes, copies,
// splices with another input, truncation and growth); an input that
// reaches a block no input reached before joins the corpus. Before each
// run the input is written to a file, so when a run fails (a panic, a
// crash) `fid test` saves it under testdata/fuzz/<target>/<hash> beside the
// test file, as Go does. Every file there is run again by each `fid test`
// (with or without --fuzz) as the test `<target>/<file>`, and seeds the
// next fuzz run.

/// The directory of a fuzz target's saved inputs: testdata/fuzz/<name>
/// beside the test file (`dir` is the test file's directory with its
/// trailing slash, or "").
fn fz_corpus_dir(dir: str, name: str) -> str {
    return dir + "testdata/fuzz/" + name;
}

/// The saved inputs of a corpus directory (file names, sorted as listed),
/// those whose name holds `part` when it is not "".
fn fz_corpus_files(cdir: str, part: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if p_is_dir(cdir) == 0 {
        return out;
    }
    val listing: str = p_dir_list(cdir);
    if (listing as i64) == 0 || str_len(listing) == 0 {
        return out;
    }
    val names: Vec<str> = str_split(listing, "\n");
    var i: i64 = 0;
    while i < names.len() {
        val nm: str = str_trim(names.get(i));
        if str_len(nm) > 0 && !str_starts_with(nm, ".") && p_is_dir(cdir + "/" + nm) == 0 {
            if str_len(part) == 0 || str_contains(nm, part) {
                out.push(nm);
            }
        }
        i = i + 1;
    }
    return out;
}

/// A saved input's file name: its FNV-1a hash, 16 hex digits (the same
/// input is saved once).
@wrapping
fn fz_input_name(bytes: Vec<i64>) -> str {
    var h: i64 = 0 - 3750763034362895579;
    var i: i64 = 0;
    while i < bytes.len() {
        h = h ^ (bytes.get(i) & 255);
        h = h * 1099511628211;
        i = i + 1;
    }
    val digits: str = "0123456789abcdef";
    var out: str = "";
    var k: i64 = 15;
    while k >= 0 {
        val d: i64 = (h >> (k * 4)) & 15;
        out = out + str_slice(digits, d, d + 1);
        k = k - 1;
    }
    return out;
}

/// Make testdata/fuzz/<name> (and its parents) beside the test file.
fn fz_make_corpus_dir(dir: str, name: str) {
    p_mkdir(dir + "testdata");
    p_mkdir(dir + "testdata/fuzz");
    p_mkdir(fz_corpus_dir(dir, name));
}

/// A byte of a name (a letter, a digit or `_`): a digit after one is not
/// the start of a number.
fn fz_ident_byte(c: i64) -> bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

/// The value of a hex digit, or -1.
fn fz_hex_digit(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    return -1;
}

/// Bytes as lower-case hex, two digits each.
fn fz_hex_of(bytes: Vec<i64>) -> str {
    val digits: str = "0123456789abcdef";
    var h: str = "";
    var i: i64 = 0;
    while i < bytes.len() {
        val b: i64 = bytes.get(i) & 255;
        h = h + str_slice(digits, b >> 4, (b >> 4) + 1) + str_slice(digits, b & 15, (b & 15) + 1);
        i = i + 1;
    }
    return h;
}

/// SL13: the fuzzing dictionary of a test file, as AFL's auto-dictionary
/// (and libFuzzer's -dict): the integer literals of its code (0..255 as one
/// byte, 256..65535 as two, little-endian) and its string literals of 1 to
/// 32 bytes, comments skipped; each as hex, in source order, each once, at
/// most 64. A fuzz target compares its input with such values, and the
/// mutator writes them into inputs (fz_harness_lib, op 9), so a check of
/// a magic number is passed in a few thousand inputs, not millions.
fn fz_dict_hex(source: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    val n: i64 = str_len(source);
    var i: i64 = 0;
    while i < n && out.len() < 64 {
        val c: i64 = str_byte_at(source, i);
        if c == 47 && i + 1 < n && str_byte_at(source, i + 1) == 47 {
            // a comment, to the end of its line
            while i < n && str_byte_at(source, i) != 10 {
                i = i + 1;
            }
        } else if c == 34 {
            // a string literal: its bytes (\n \t \r \0 \\ \" \' read)
            var bytes: Vec<i64> = Vec::new();
            var ok: bool = true;
            var j: i64 = i + 1;
            while j < n && str_byte_at(source, j) != 34 && str_byte_at(source, j) != 10 {
                var b: i64 = str_byte_at(source, j);
                if b == 92 && j + 1 < n {
                    j = j + 1;
                    val e: i64 = str_byte_at(source, j);
                    if e == 110 {
                        b = 10;
                    } else if e == 116 {
                        b = 9;
                    } else if e == 114 {
                        b = 13;
                    } else if e == 48 {
                        b = 0;
                    } else if e == 92 || e == 34 || e == 39 {
                        b = e;
                    } else {
                        ok = false;
                    }
                }
                bytes.push(b);
                j = j + 1;
            }
            if ok && bytes.len() >= 1 && bytes.len() <= 32 {
                val hs: str = fz_hex_of(bytes);
                if !str_vec_contains(out, hs) {
                    out.push(hs);
                }
            }
            // at the closing quote, passed below
            i = j;
        } else if c >= 48 && c <= 57 && (i == 0 || !fz_ident_byte(str_byte_at(source, i - 1))) {
            // an integer literal: decimal or 0x hex, `_` between digits
            var v: i64 = 0;
            var big: bool = false;
            var j2: i64 = i;
            if c == 48 && i + 1 < n && (str_byte_at(source, i + 1) == 120 || str_byte_at(source, i + 1) == 88) {
                j2 = i + 2;
                while j2 < n && (fz_hex_digit(str_byte_at(source, j2)) >= 0 || str_byte_at(source, j2) == 95) {
                    val hd: i64 = fz_hex_digit(str_byte_at(source, j2));
                    if hd >= 0 {
                        if v > 65535 {
                            big = true;
                        } else {
                            v = v * 16 + hd;
                        }
                    }
                    j2 = j2 + 1;
                }
            } else {
                while j2 < n && ((str_byte_at(source, j2) >= 48 && str_byte_at(source, j2) <= 57) || str_byte_at(source, j2) == 95) {
                    val dd: i64 = str_byte_at(source, j2);
                    if dd != 95 {
                        if v > 65535 {
                            big = true;
                        } else {
                            v = v * 10 + dd - 48;
                        }
                    }
                    j2 = j2 + 1;
                }
            }
            // a float (1.5) is no byte; a range (0..9) is
            var is_float: bool = false;
            if j2 + 1 < n && str_byte_at(source, j2) == 46 && str_byte_at(source, j2 + 1) >= 48 && str_byte_at(source, j2 + 1) <= 57 {
                is_float = true;
            }
            if !big && !is_float && v <= 65535 {
                var tok: Vec<i64> = Vec::new();
                tok.push(v & 255);
                if v > 255 {
                    tok.push(v >> 8);
                }
                val hv: str = fz_hex_of(tok);
                if !str_vec_contains(out, hv) {
                    out.push(hv);
                }
            }
            i = j2 - 1;
        }
        i = i + 1;
    }
    return out;
}

/// The harness's `_fz_dict()`: the tokens of fz_dict_hex(source).
fn fz_harness_dict(source: str) -> str {
    val toks: Vec<str> = fz_dict_hex(source);
    var out: str = "\n/// SL13: the dictionary of this file's literals (compiler/main.fd fz_dict_hex)\n";
    out = out + "fn _fz_dict() -> Vec<Vec<u8>> {\n    var d: Vec<Vec<u8>> = Vec::new();\n";
    var i: i64 = 0;
    while i < toks.len() {
        out = out + "    d.push(_fz_unhex(\"" + toks.get(i) + "\"));\n";
        i = i + 1;
    }
    out = out + "    return d;\n}\n";
    return out;
}

/// The harness's fuzzing library (Fides source appended to the test file):
/// the coverage map `__fz_hit` fills, the generator, the mutator and the
/// seed inputs. `_fuzz_input(seed)` is the deterministic input of CT4.
fn fz_harness_lib() -> str {
    var l: Vec<str> = Vec::new();
    l.push("");
    l.push("// SL13: the fuzzing library of `fid test --fuzz` (compiler/main.fd fz_harness_lib)");
    l.push("var _fz_seen: Vec<i64> = Vec::new();");
    l.push("var _fz_flag: Vec<i64> = Vec::new();");
    l.push("var _fz_rng: Vec<i64> = Vec::new();");
    l.push("");
    l.push("/// The start of a block of the code under test (ccompile --fuzz-cov):");
    l.push("/// a block no input reached before counts in _fz_flag[0].");
    l.push("pub fn __fz_hit(k: i64) {");
    l.push("    if k < _fz_seen.len() {");
    l.push("        if _fz_seen.get(k) == 0 {");
    l.push("            _fz_seen.set(k, 1);");
    l.push("            _fz_flag.set(0, _fz_flag.get(0) + 1);");
    l.push("        }");
    l.push("    }");
    l.push("}");
    l.push("");
    l.push("fn _fuzz_input(seed: i64) -> Vec<u8> {");
    l.push("    var d: Vec<u8> = Vec::new();");
    l.push("    var s: i64 = (seed * 2654435761 + 1) % 2147483648;");
    l.push("    var n: i64 = 64 + (seed % 960);");
    l.push("    var i: i64 = 0;");
    l.push("    while i < n {");
    l.push("        s = (s * 1103515245 + 12345) % 2147483648;");
    l.push("        d.push((s >> 16) & 255);");
    l.push("        i = i + 1;");
    l.push("    }");
    l.push("    return d;");
    l.push("}");
    l.push("");
    l.push("fn _fz_init(seed: i64) {");
    l.push("    while _fz_seen.len() < 65536 {");
    l.push("        _fz_seen.push(0);");
    l.push("    }");
    l.push("    if _fz_flag.len() == 0 {");
    l.push("        _fz_flag.push(0);");
    l.push("    }");
    l.push("    if _fz_rng.len() == 0 {");
    l.push("        _fz_rng.push(0);");
    l.push("    }");
    l.push("    var s: i64 = seed % 2147483648;");
    l.push("    if s < 0 {");
    l.push("        s = 0 - s;");
    l.push("    }");
    l.push("    _fz_rng.set(0, s);");
    l.push("}");
    l.push("");
    l.push("fn _fz_next(bound: i64) -> i64 {");
    l.push("    var s: i64 = _fz_rng.get(0);");
    l.push("    s = (s * 1103515245 + 12345) % 2147483648;");
    l.push("    _fz_rng.set(0, s);");
    l.push("    if bound <= 1 {");
    l.push("        return 0;");
    l.push("    }");
    l.push("    return (s >> 7) % bound;");
    l.push("}");
    l.push("");
    l.push("/// A byte position below n: half the time among the first 8 (formats");
    l.push("/// keep their magic and lengths at the start)");
    l.push("fn _fz_pos(n: i64) -> i64 {");
    l.push("    if n > 8 && _fz_next(2) == 0 {");
    l.push("        return _fz_next(8);");
    l.push("    }");
    l.push("    return _fz_next(n);");
    l.push("}");
    l.push("");
    l.push("fn _fz_to_words(d: Vec<u8>) -> Vec<i64> {");
    l.push("    var out: Vec<i64> = Vec::new();");
    l.push("    var i: i64 = 0;");
    l.push("    while i < d.len() {");
    l.push("        out.push(d.get(i) as i64);");
    l.push("        i = i + 1;");
    l.push("    }");
    l.push("    return out;");
    l.push("}");
    l.push("");
    l.push("fn _fz_from_words(w: Vec<i64>) -> Vec<u8> {");
    l.push("    var out: Vec<u8> = Vec::new();");
    l.push("    var i: i64 = 0;");
    l.push("    while i < w.len() {");
    l.push("        out.push((w.get(i) & 255) as u8);");
    l.push("        i = i + 1;");
    l.push("    }");
    l.push("    return out;");
    l.push("}");
    l.push("");
    l.push("/// Bytes parsers stop at: 0, 1, 127, 128, 255, '0', '9', ' ', newline,");
    l.push("/// '\"', '-', braces, brackets, '<', '>', 'A', 'a'");
    l.push("fn _fz_special(k: i64) -> i64 {");
    l.push("    if k == 0 { return 0; }");
    l.push("    if k == 1 { return 1; }");
    l.push("    if k == 2 { return 127; }");
    l.push("    if k == 3 { return 128; }");
    l.push("    if k == 4 { return 255; }");
    l.push("    if k == 5 { return 48; }");
    l.push("    if k == 6 { return 57; }");
    l.push("    if k == 7 { return 32; }");
    l.push("    if k == 8 { return 10; }");
    l.push("    if k == 9 { return 34; }");
    l.push("    if k == 10 { return 45; }");
    l.push("    if k == 11 { return 123; }");
    l.push("    if k == 12 { return 125; }");
    l.push("    if k == 13 { return 91; }");
    l.push("    if k == 14 { return 93; }");
    l.push("    if k == 15 { return 60; }");
    l.push("    if k == 16 { return 62; }");
    l.push("    if k == 17 { return 65; }");
    l.push("    return 97;");
    l.push("}");
    l.push("");
    l.push("/// A dictionary token: two hex digits a byte (fz_harness_dict)");
    l.push("fn _fz_unhex(h: str) -> Vec<u8> {");
    l.push("    var out: Vec<u8> = Vec::new();");
    l.push("    var i: i64 = 0;");
    l.push("    while i + 1 < str_len(h) {");
    l.push("        var hi: i64 = str_byte_at(h, i) - 48;");
    l.push("        if hi > 9 {");
    l.push("            hi = hi - 39;");
    l.push("        }");
    l.push("        var lo: i64 = str_byte_at(h, i + 1) - 48;");
    l.push("        if lo > 9 {");
    l.push("            lo = lo - 39;");
    l.push("        }");
    l.push("        out.push((hi * 16 + lo) as u8);");
    l.push("        i = i + 2;");
    l.push("    }");
    l.push("    return out;");
    l.push("}");
    l.push("");
    l.push("/// One child of `src`: 1 to 4 mutations; `other` is a corpus input to");
    l.push("/// splice with, `dict` the literals of the test file (op 9 writes one");
    l.push("/// over the input or inserts it). At most `maxlen` bytes.");
    l.push("fn _fz_mutate(src: Vec<u8>, other: Vec<u8>, maxlen: i64, dict: Vec<Vec<u8>>) -> Vec<u8> {");
    l.push("    var d: Vec<u8> = Vec::new();");
    l.push("    var i: i64 = 0;");
    l.push("    while i < src.len() {");
    l.push("        d.push(src.get(i));");
    l.push("        i = i + 1;");
    l.push("    }");
    l.push("    var rounds: i64 = 1 + _fz_next(4);");
    l.push("    var r: i64 = 0;");
    l.push("    while r < rounds {");
    l.push("        var op: i64 = _fz_next(10);");
    l.push("        val n: i64 = d.len();");
    l.push("        if n == 0 {");
    l.push("            op = 2;");
    l.push("        }");
    l.push("        if op == 0 {");
    l.push("            val p0: i64 = _fz_pos(n);");
    l.push("            d.set(p0, ((d.get(p0) as i64) ^ (1 << _fz_next(8))) as u8);");
    l.push("        } else if op == 1 {");
    l.push("            d.set(_fz_pos(n), _fz_next(256) as u8);");
    l.push("        } else if op == 2 {");
    l.push("            if n < maxlen {");
    l.push("                val p2: i64 = _fz_next(n + 1);");
    l.push("                val cnt2: i64 = 1 + _fz_next(8);");
    l.push("                var e2: Vec<u8> = Vec::new();");
    l.push("                var j2: i64 = 0;");
    l.push("                while j2 < p2 {");
    l.push("                    e2.push(d.get(j2));");
    l.push("                    j2 = j2 + 1;");
    l.push("                }");
    l.push("                j2 = 0;");
    l.push("                while j2 < cnt2 {");
    l.push("                    e2.push(_fz_next(256) as u8);");
    l.push("                    j2 = j2 + 1;");
    l.push("                }");
    l.push("                j2 = p2;");
    l.push("                while j2 < n {");
    l.push("                    e2.push(d.get(j2));");
    l.push("                    j2 = j2 + 1;");
    l.push("                }");
    l.push("                d = e2;");
    l.push("            }");
    l.push("        } else if op == 3 {");
    l.push("            val p3: i64 = _fz_next(n);");
    l.push("            var cnt3: i64 = 1 + _fz_next(8);");
    l.push("            if p3 + cnt3 > n {");
    l.push("                cnt3 = n - p3;");
    l.push("            }");
    l.push("            var e3: Vec<u8> = Vec::new();");
    l.push("            var j3: i64 = 0;");
    l.push("            while j3 < n {");
    l.push("                if j3 < p3 || j3 >= p3 + cnt3 {");
    l.push("                    e3.push(d.get(j3));");
    l.push("                }");
    l.push("                j3 = j3 + 1;");
    l.push("            }");
    l.push("            d = e3;");
    l.push("        } else if op == 4 {");
    l.push("            val from4: i64 = _fz_next(n);");
    l.push("            val to4: i64 = _fz_next(n);");
    l.push("            val cnt4: i64 = 1 + _fz_next(8);");
    l.push("            var j4: i64 = 0;");
    l.push("            while j4 < cnt4 && from4 + j4 < n && to4 + j4 < n {");
    l.push("                d.set(to4 + j4, d.get(from4 + j4));");
    l.push("                j4 = j4 + 1;");
    l.push("            }");
    l.push("        } else if op == 5 {");
    l.push("            if other.len() > 0 {");
    l.push("                val cut5: i64 = _fz_next(n + 1);");
    l.push("                val oc5: i64 = _fz_next(other.len());");
    l.push("                var e5: Vec<u8> = Vec::new();");
    l.push("                var j5: i64 = 0;");
    l.push("                while j5 < cut5 {");
    l.push("                    e5.push(d.get(j5));");
    l.push("                    j5 = j5 + 1;");
    l.push("                }");
    l.push("                j5 = oc5;");
    l.push("                while j5 < other.len() && e5.len() < maxlen {");
    l.push("                    e5.push(other.get(j5));");
    l.push("                    j5 = j5 + 1;");
    l.push("                }");
    l.push("                d = e5;");
    l.push("            }");
    l.push("        } else if op == 6 {");
    l.push("            if _fz_next(2) == 0 {");
    l.push("                val keep6: i64 = _fz_next(n + 1);");
    l.push("                var e6: Vec<u8> = Vec::new();");
    l.push("                var j6: i64 = 0;");
    l.push("                while j6 < keep6 {");
    l.push("                    e6.push(d.get(j6));");
    l.push("                    j6 = j6 + 1;");
    l.push("                }");
    l.push("                d = e6;");
    l.push("            } else {");
    l.push("                val add6: i64 = 1 + _fz_next(32);");
    l.push("                var j7: i64 = 0;");
    l.push("                while j7 < add6 && d.len() < maxlen {");
    l.push("                    d.push(_fz_next(256) as u8);");
    l.push("                    j7 = j7 + 1;");
    l.push("                }");
    l.push("            }");
    l.push("        } else if op == 7 {");
    l.push("            d.set(_fz_pos(n), _fz_special(_fz_next(19)) as u8);");
    l.push("        } else if op == 9 {");
    l.push("            if dict.len() > 0 {");
    l.push("                val tok: Vec<u8> = dict.get(_fz_next(dict.len()));");
    l.push("                var e10: Vec<u8> = Vec::new();");
    l.push("                var j10: i64 = 0;");
    l.push("                if _fz_next(2) == 0 {");
    l.push("                    // the token over the bytes at a position");
    l.push("                    val p10: i64 = _fz_pos(n);");
    l.push("                    while j10 < p10 {");
    l.push("                        e10.push(d.get(j10));");
    l.push("                        j10 = j10 + 1;");
    l.push("                    }");
    l.push("                    j10 = 0;");
    l.push("                    while j10 < tok.len() {");
    l.push("                        e10.push(tok.get(j10));");
    l.push("                        j10 = j10 + 1;");
    l.push("                    }");
    l.push("                    j10 = p10 + tok.len();");
    l.push("                    while j10 < n {");
    l.push("                        e10.push(d.get(j10));");
    l.push("                        j10 = j10 + 1;");
    l.push("                    }");
    l.push("                } else {");
    l.push("                    // the token inserted at a position");
    l.push("                    val q10: i64 = _fz_next(n + 1);");
    l.push("                    while j10 < q10 {");
    l.push("                        e10.push(d.get(j10));");
    l.push("                        j10 = j10 + 1;");
    l.push("                    }");
    l.push("                    j10 = 0;");
    l.push("                    while j10 < tok.len() {");
    l.push("                        e10.push(tok.get(j10));");
    l.push("                        j10 = j10 + 1;");
    l.push("                    }");
    l.push("                    j10 = q10;");
    l.push("                    while j10 < n {");
    l.push("                        e10.push(d.get(j10));");
    l.push("                        j10 = j10 + 1;");
    l.push("                    }");
    l.push("                }");
    l.push("                d = e10;");
    l.push("            }");
    l.push("        } else {");
    l.push("            val p8: i64 = _fz_pos(n);");
    l.push("            val delta8: i64 = 1 + _fz_next(16);");
    l.push("            var v8: i64 = d.get(p8) as i64;");
    l.push("            if _fz_next(2) == 0 {");
    l.push("                v8 = (v8 + delta8) & 255;");
    l.push("            } else {");
    l.push("                v8 = (v8 + 256 - delta8) & 255;");
    l.push("            }");
    l.push("            d.set(p8, v8 as u8);");
    l.push("        }");
    l.push("        r = r + 1;");
    l.push("    }");
    l.push("    if d.len() > maxlen {");
    l.push("        var e9: Vec<u8> = Vec::new();");
    l.push("        var j9: i64 = 0;");
    l.push("        while j9 < maxlen {");
    l.push("            e9.push(d.get(j9));");
    l.push("            j9 = j9 + 1;");
    l.push("        }");
    l.push("        d = e9;");
    l.push("    }");
    l.push("    return d;");
    l.push("}");
    l.push("");
    l.push("/// The first inputs: the saved ones (testdata/fuzz/<target>), the empty");
    l.push("/// input, a zero byte, four short random ones and a long one");
    l.push("fn _fz_seeds(dir: str) -> Vec<Vec<u8>> {");
    l.push("    var out: Vec<Vec<u8>> = Vec::new();");
    l.push("    if str_len(dir) > 0 && dir != \"-\" {");
    l.push("        val listing: str = p_dir_list(dir);");
    l.push("        if str_len(listing) > 0 {");
    l.push("            val names: Vec<str> = str_split(listing, \"\\n\");");
    l.push("            var i: i64 = 0;");
    l.push("            while i < names.len() {");
    l.push("                val nm: str = str_trim(names.get(i));");
    l.push("                if str_len(nm) > 0 {");
    l.push("                    out.push(_fz_from_words(p_file_read_bytes(dir + \"/\" + nm)));");
    l.push("                }");
    l.push("                i = i + 1;");
    l.push("            }");
    l.push("        }");
    l.push("    }");
    l.push("    out.push(Vec::new());");
    l.push("    var z: Vec<u8> = Vec::new();");
    l.push("    z.push(0 as u8);");
    l.push("    out.push(z);");
    l.push("    var k: i64 = 0;");
    l.push("    while k < 4 {");
    l.push("        var s: Vec<u8> = Vec::new();");
    l.push("        val len: i64 = 1 + _fz_next(8);");
    l.push("        var j: i64 = 0;");
    l.push("        while j < len {");
    l.push("            s.push(_fz_next(256) as u8);");
    l.push("            j = j + 1;");
    l.push("        }");
    l.push("        out.push(s);");
    l.push("        k = k + 1;");
    l.push("    }");
    l.push("    out.push(_fuzz_input(1));");
    l.push("    return out;");
    l.push("}");
    l.push("");
    l.push("fn _fz_arg(i: i64) -> str {");
    l.push("    match arg_at(i) {");
    l.push("        Option::Some(a) => {");
    l.push("            return a;");
    l.push("        }");
    l.push("        Option::None => {");
    l.push("        }");
    l.push("    }");
    l.push("    return \"\";");
    l.push("}");
    l.push("");
    var out: str = "";
    var i: i64 = 0;
    while i < l.len() {
        out = out + l.get(i) + "\n";
        i = i + 1;
    }
    return out;
}

/// The harness's fuzz loop for target `t`: `total` inputs (the seeds
/// first), each written to `cur` before it runs; `dir` holds the saved
/// inputs ("-": none); `seed` seeds the generator; inputs of at most
/// `maxlen` bytes. Prints the corpus it ended with.
fn fz_harness_driver(t: str) -> str {
    var l: Vec<str> = Vec::new();
    l.push("fn _fz_drive_" + t + "(total: i64, cur: str, dir: str, seed: i64, maxlen: i64) {");
    l.push("    _fz_init(seed);");
    l.push("    var corpus: Vec<Vec<u8>> = Vec::new();");
    l.push("    val seeds: Vec<Vec<u8>> = _fz_seeds(dir);");
    l.push("    val dict: Vec<Vec<u8>> = _fz_dict();");
    l.push("    var done: i64 = 0;");
    l.push("    var k: i64 = 0;");
    l.push("    while k < seeds.len() {");
    l.push("        val inp: Vec<u8> = seeds.get(k);");
    l.push("        p_file_write_vec(cur, _fz_to_words(inp));");
    l.push("        val before: i64 = _fz_flag.get(0);");
    l.push("        " + t + "(inp);");
    l.push("        if _fz_flag.get(0) > before || corpus.len() == 0 {");
    l.push("            corpus.push(inp);");
    l.push("        }");
    l.push("        done = done + 1;");
    l.push("        k = k + 1;");
    l.push("    }");
    l.push("    while done < total {");
    l.push("        // the newest input (the last to reach a new block) half the time");
    l.push("        var pick: i64 = corpus.len() - 1;");
    l.push("        if _fz_next(2) == 0 {");
    l.push("            pick = _fz_next(corpus.len());");
    l.push("        }");
    l.push("        val parent: Vec<u8> = corpus.get(pick);");
    l.push("        val other: Vec<u8> = corpus.get(_fz_next(corpus.len()));");
    l.push("        val child: Vec<u8> = _fz_mutate(parent, other, maxlen, dict);");
    l.push("        p_file_write_vec(cur, _fz_to_words(child));");
    l.push("        val before2: i64 = _fz_flag.get(0);");
    l.push("        " + t + "(child);");
    l.push("        if _fz_flag.get(0) > before2 {");
    l.push("            corpus.push(child);");
    l.push("        }");
    l.push("        done = done + 1;");
    l.push("    }");
    l.push("    println(\"      \" + int_to_str(done) + \" inputs, corpus \" + int_to_str(corpus.len()) + \", \" + int_to_str(_fz_flag.get(0)) + \" blocks reached\");");
    l.push("}");
    l.push("");
    var out: str = "";
    var i: i64 = 0;
    while i < l.len() {
        out = out + l.get(i) + "\n";
        i = i + 1;
    }
    return out;
}

/// fid test <file.fd>: each `fn test_*()` runs in its own process (a panic
/// fails that test only), then each `fn bench_*()` runs until it has taken
/// 200 ms and reports its time per call, as `go test -bench` does.
fn cmd_test_file(n: i64, start: i64, fuzz_only: bool) -> i64 {
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: " + input + "\n");
        return 1;
    }
    var tests: Vec<str> = Vec::new();
    var benches: Vec<str> = Vec::new();
    // TL1: `fid fuzz <file.fd>` runs only the fuzz targets
    if !fuzz_only {
        tests = test_fns(source, "test_");
        benches = test_fns(source, "bench_");
    }
    // CT4: `fn fuzz_*(data: Vec<u8>)` run under --fuzz with deterministic
    // seeds; CT5: --update rewrites snapshots; CT8: --coverage through veil.
    var fuzz_mode: bool = fuzz_only || has_flag(n, start, "--fuzz");
    var update_snaps: bool = has_flag(n, start, "--update");
    var coverage: bool = has_flag(n, start, "--coverage");
    // --seeds <n>: inputs per fuzz target (100 under `fid test --fuzz`,
    // 1000 under `fid fuzz`)
    var fuzz_seeds: i64 = 100;
    if fuzz_only {
        fuzz_seeds = 1000;
    }
    fuzz_seeds = get_flag_int(n, start, "--seeds", fuzz_seeds);
    if fuzz_seeds < 1 {
        fuzz_seeds = 1;
    }
    var fuzzes: Vec<str> = Vec::new();
    if fuzz_mode {
        fuzzes = test_fns_fuzz(source);
    }
    // SL13: every fuzz target, for its saved inputs (testdata/fuzz/<name>/),
    // run as tests with or without --fuzz; --fuzz-seed <n> seeds the
    // mutator (1: the same inputs each run), --fuzz-maxlen <n> caps an
    // input's length, --fuzz-std covers the stdlib modules too
    var fuzz_targets: Vec<str> = test_fns_fuzz(source);
    var fuzz_seed: i64 = get_flag_int(n, start, "--fuzz-seed", 1);
    var fuzz_maxlen: i64 = get_flag_int(n, start, "--fuzz-maxlen", 4096);
    if fuzz_maxlen < 1 {
        fuzz_maxlen = 1;
    }
    // CT2: --filter <text> (or --run <text>): only the tests, benches and
    // fuzz targets whose name holds the text.
    // SL13: `-run <test>/<row>` (or --run), as Go's -run: the part before
    // `/` picks the tests, the part after the rows of their table tests
    // (FIDES_ROW, read by stdlib/test.fd table_*); `-run /<row>` every test,
    // some rows; `--row <text>` the rows alone.
    var name_filter: str = get_flag_value(n, start, "--filter", "");
    var row_filter: str = get_flag_value(n, start, "--row", "");
    var run_arg: str = get_flag_value(n, start, "-run", get_flag_value(n, start, "--run", ""));
    if str_len(run_arg) > 0 {
        var run_slash: i64 = str_find(run_arg, "/");
        if run_slash >= 0 {
            if str_len(name_filter) == 0 {
                name_filter = str_slice(run_arg, 0, run_slash);
            }
            if str_len(row_filter) == 0 {
                row_filter = str_slice(run_arg, run_slash + 1, str_len(run_arg));
            }
        } else if str_len(name_filter) == 0 {
            name_filter = run_arg;
        }
    }
    if str_len(name_filter) > 0 {
        var before: i64 = tests.len() + benches.len() + fuzzes.len() + fuzz_targets.len();
        tests = test_filter(tests, name_filter);
        benches = test_filter(benches, name_filter);
        fuzzes = test_filter(fuzzes, name_filter);
        fuzz_targets = test_filter(fuzz_targets, name_filter);
        if before > 0 && tests.len() + benches.len() + fuzzes.len() + fuzz_targets.len() == 0 {
            p_eprint_str("fid test: no test, bench or fuzz target of " + input + " has '" + name_filter + "' in its name\n");
            return 1;
        }
    }
    // CT2: --jobs <n> (or -j <n>): the tests run n at a time, each in its
    // own process as before; their output is shown in order, after each
    // batch (test_run_parallel). 1 (the default): one after the other.
    var jobs: i64 = get_flag_int(n, start, "--jobs", get_flag_int(n, start, "-j", 1));
    if jobs < 1 {
        jobs = 1;
    }
    if str_find(source, "fn main(") >= 0 {
        p_eprint_str("fid test: " + input + " has a main; a test file holds only fn test_*(), fn bench_*() and fn fuzz_*(data: Vec<u8>)\n");
        return 1;
    }
    if fuzz_only && fuzzes.len() == 0 {
        p_eprint_str("fid fuzz: no fn fuzz_*(data: Vec<u8>) in " + input + "\n");
        return 1;
    }
    // The test file's directory (with its slash), where its testdata/ is
    var fz_dir: str = "";
    var fz_slash: i64 = str_rfind(str_replace(input, "\\", "/"), "/");
    if fz_slash >= 0 {
        fz_dir = str_slice(input, 0, fz_slash + 1);
    }
    // SL13: the saved inputs to run again: each file of
    // testdata/fuzz/<target>/ (the part of `-run <target>/<part>` after
    // the slash picks files by name)
    var replay_targets: Vec<str> = Vec::new();
    var replay_files: Vec<str> = Vec::new();
    var ti: i64 = 0;
    while ti < fuzz_targets.len() {
        val saved: Vec<str> = fz_corpus_files(fz_corpus_dir(fz_dir, fuzz_targets.get(ti)), row_filter);
        var si: i64 = 0;
        while si < saved.len() {
            replay_targets.push(fuzz_targets.get(ti));
            replay_files.push(saved.get(si));
            si = si + 1;
        }
        ti = ti + 1;
    }
    if tests.len() + benches.len() + fuzzes.len() + replay_files.len() == 0 {
        if fuzz_targets.len() > 0 {
            // Go runs a fuzz target's saved inputs: none is no failure
            print("fid test: " + input + " has fuzz targets and no saved inputs (testdata/fuzz/<target>/); run with --fuzz to fuzz them\n");
            print("0 passed, 0 failed\n");
            return 0;
        }
        p_eprint_str("fid test: no fn test_*() or fn bench_*() in " + input + "\n");
        return 1;
    }
    // The harness: the file and a main that runs the function its argument
    // names, as many times as the second argument says. A fuzz target runs
    // `<target> fuzz <inputs> <cur file> <corpus dir> <seed> <maxlen>`
    // (fz_harness_driver, built with --fuzz-cov) or `<target> replay
    // <file>` (one saved input).
    var harness: str = source + "\n";
    if fuzz_targets.len() > 0 || test_fns_fuzz(source).len() > 0 {
        harness = harness + fz_harness_lib() + fz_harness_dict(source);
        var di: i64 = 0;
        while di < fuzzes.len() {
            harness = harness + fz_harness_driver(fuzzes.get(di));
            di = di + 1;
        }
    } else {
        harness = harness + "\nfn _fuzz_input(seed: i64) -> Vec<u8> {\n" + "    var d: Vec<u8> = Vec::new();\n" + "    var s: i64 = (seed * 2654435761 + 1) % 2147483648;\n" + "    var n: i64 = 64 + (seed % 960);\n" + "    var i: i64 = 0;\n" + "    while i < n {\n" + "        s = (s * 1103515245 + 12345) % 2147483648;\n" + "        d.push((s >> 16) & 255);\n" + "        i = i + 1;\n" + "    }\n" + "    return d;\n" + "}\n";
    }
    if fuzzes.len() > 0 {
        // a fuzz build differs from a test build of the same file
        harness = harness + "// fuzz-cov\n";
    }
    harness = harness + "\nfn main() -> i64 {\n    var which: str = \"all\";\n" + "    match arg_at(1) { Option::Some(a) => { which = a; } Option::None => {} }\n" + "    var mode: str = \"1\";\n" + "    match arg_at(2) { Option::Some(a) => { mode = a; } Option::None => {} }\n" + "    var reps: i64 = 1;\n" + "    if mode != \"fuzz\" && mode != \"replay\" { reps = str_parse_int(mode); }\n";
    var i: i64 = 0;
    while i < tests.len() {
        harness = harness + "    if which == \"all\" || which == \"" + tests.get(i) + "\" { " + tests.get(i) + "(); }\n";
        i = i + 1;
    }
    i = 0;
    while i < fuzz_targets.len() {
        val ft: str = fuzz_targets.get(i);
        harness = harness + "    if which == \"" + ft + "\" && mode == \"replay\" { " + ft + "(_fz_from_words(p_file_read_bytes(_fz_arg(3)))); }\n";
        if fuzz_mode {
            harness = harness + "    if which == \"" + ft + "\" && mode == \"fuzz\" { _fz_drive_" + ft + "(str_parse_int(_fz_arg(3)), _fz_arg(4), _fz_arg(5), str_parse_int(_fz_arg(6)), str_parse_int(_fz_arg(7))); }\n";
        }
        i = i + 1;
    }
    i = 0;
    while i < benches.len() {
        val b: str = benches.get(i);
        harness = harness + "    if which == \"" + b + "\" {\n        val t0: i64 = p_clock_now_us();\n" + "        var r: i64 = 0;\n        while r < reps { " + b + "(); r = r + 1; }\n" + "        println(p_clock_now_us() - t0);\n    }\n";
        i = i + 1;
    }
    harness = harness + "    return 0;\n}\n";
    // Next to the file, so its own imports resolve the same way
    var dir: str = "";
    var slash: i64 = str_rfind(str_replace(input, "\\", "/"), "/");
    if slash >= 0 {
        dir = str_slice(input, 0, slash + 1);
    }
    var main_fd: str = dir + "_fides_test_main.fd";
    p_file_write(main_fd, harness);
    var exe: str = "_fides_test_run.exe";
    var run: str = ".\\_fides_test_run.exe";
    if is_posix_host() {
        exe = "_fides_test_run";
        run = "./_fides_test_run";
    }
    // rm-L5A-dev-deps: a test build sees the dev pacts (ark_modules/.dev).
    // SL13: a fuzz build counts the blocks each input reaches
    var cov_flags: str = "";
    if fuzzes.len() > 0 {
        cov_flags = " --fuzz-cov";
        if has_flag(n, start, "--fuzz-std") {
            cov_flags = " --fuzz-cov-std";
        }
    }
    if run_quoted_cmd("\"" + p_argv(0) + "\" ccompile " + shell_word(main_fd) + " -o " + exe + " --dev-deps" + cov_flags) != 0 {
        p_file_delete(main_fd);
        p_eprint_str("fid test: the build failed\n");
        return 1;
    }
    var failed: i64 = 0;
    i = 0;
    // --update: the snapshots of expect_snapshot are rewritten.
    // CT3: each test runs with the clock and the random seed fixed
    // (FIDES_TEST_NOW, FIDES_TEST_SEED: stdlib dt_now, random_seed_time),
    // unless --real-clock is given, the test's name ends in `_real_clock`,
    // or the variable is set already (that value is kept)
    var real_clock: bool = has_flag(n, start, "--real-clock");
    if jobs > 1 && tests.len() > 1 {
        // CT2: n at a time; each test's output, then its verdict, in order
        var codes: Vec<i64> = test_run_parallel(exe, tests, jobs, update_snaps, real_clock, row_filter);
        while i < tests.len() {
            if codes.get(i) == 0 {
                print("ok    " + tests.get(i) + "\n");
            } else {
                print("FAIL  " + tests.get(i) + "\n");
                failed = failed + 1;
            }
            i = i + 1;
        }
    }
    while i < tests.len() {
        var run_cmd: str = test_env_prefix(update_snaps, test_fixed_clock(tests.get(i), real_clock), row_filter) + run;
        if p_system(run_cmd + " " + tests.get(i) + " 1") == 0 {
            print("ok    " + tests.get(i) + "\n");
        } else {
            print("FAIL  " + tests.get(i) + "\n");
            failed = failed + 1;
        }
        i = i + 1;
    }
    // SL13: the saved inputs of each fuzz target, one process each, as the
    // tests `<target>/<file>` (a target one of them fails is not fuzzed)
    var replay_bad: Vec<str> = Vec::new();
    i = 0;
    while i < replay_files.len() {
        val rt: str = replay_targets.get(i);
        val rpath: str = fz_corpus_dir(fz_dir, rt) + "/" + replay_files.get(i);
        if p_system(run + " " + rt + " replay \"" + rpath + "\"") == 0 {
            print("ok    " + rt + "/" + replay_files.get(i) + "\n");
        } else {
            print("FAIL  " + rt + "/" + replay_files.get(i) + " (saved input " + rpath + ")\n");
            failed = failed + 1;
            replay_bad.push(rt);
        }
        i = i + 1;
    }
    // --fuzz: each fn fuzz_* runs `fuzz_seeds` inputs in one process,
    // coverage-guided (fz_harness_driver); the input of a failing run is
    // saved under testdata/fuzz/<target>/
    var fuzz_skipped: i64 = 0;
    i = 0;
    while i < fuzzes.len() {
        val fz: str = fuzzes.get(i);
        if str_vec_contains(replay_bad, fz) {
            print("FAIL  " + fz + " (not fuzzed: a saved input fails)\n");
            fuzz_skipped = fuzz_skipped + 1;
            i = i + 1;
            continue;
        }
        val cur: str = "_fides_fuzz_cur_" + fz + ".bin";
        p_file_delete(cur);
        var cdir: str = fz_corpus_dir(fz_dir, fz);
        if p_is_dir(cdir) == 0 {
            cdir = "-";
        }
        val fz_cmd: str = run + " " + fz + " fuzz " + int_to_str(fuzz_seeds) + " " + cur + " \"" + cdir + "\" " + int_to_str(fuzz_seed) + " " + int_to_str(fuzz_maxlen);
        if p_system(fz_cmd) == 0 {
            print("ok    " + fz + " (" + int_to_str(fuzz_seeds) + " seeds)\n");
        } else {
            print("FAIL  " + fz + " (within " + int_to_str(fuzz_seeds) + " seeds)\n");
            failed = failed + 1;
            if p_file_exists(cur) != 0 {
                val bad_input: Vec<i64> = p_file_read_bytes(cur);
                val bad_name: str = fz_input_name(bad_input);
                fz_make_corpus_dir(fz_dir, fz);
                val bad_path: str = fz_corpus_dir(fz_dir, fz) + "/" + bad_name;
                if p_file_write_vec(bad_path, bad_input) == 0 {
                    print("      failing input (" + int_to_str(bad_input.len()) + " bytes) written to " + bad_path + "\n");
                    print("      to re-run it: fid test " + input + " -run " + fz + "/" + bad_name + "\n");
                } else {
                    print("      could not write the failing input to " + bad_path + "\n");
                }
            }
        }
        p_file_delete(cur);
        i = i + 1;
    }
    i = 0;
    while i < benches.len() {
        var reps: i64 = 1;
        var us: i64 = 0;
        var ok: bool = true;
        while ok {
            if p_system(run + " " + benches.get(i) + " " + int_to_str(reps) + " > _fides_bench_out.txt") != 0 {
                print("FAIL  " + benches.get(i) + "\n");
                failed = failed + 1;
                ok = false;
            } else {
                us = str_parse_int(str_trim(c_file_read("_fides_bench_out.txt")));
                if us >= 200000 || reps >= 1073741824 {
                    print(benches.get(i) + "  " + int_to_str(reps) + " runs  " + int_to_str(us * 1000 / reps) + " ns/op\n");
                    ok = false;
                } else if us < 1000 {
                    reps = reps * 100;
                } else {
                    reps = reps * 2;
                }
            }
        }
        i = i + 1;
    }
    // --coverage (CT8): one process that runs every test, through veil.
    // It is a child `fid veil`, not veil_run in this process: a test that
    // panics then cannot take the suite's summary down with it (the
    // in-process run double-freed, known-bugs 2g.30, since fixed in
    // veil.fd: run_with_coverage lends the module to vl_cover_module), and
    // the report is printed whole after the child ends.
    if coverage {
        var cov_out: str = "_fides_cov_out.txt";
        var cov_rc: i64 = run_quoted_cmd("\"" + p_argv(0) + "\" veil " + shell_word(main_fd) + " --output coverage > " + cov_out + " 2>&1");
        match read_file(cov_out) {
            Option::Some(cov_text) => {
                print(cov_text);
            }
            Option::None => {
            }
        }
        if cov_rc != 0 {
            print("coverage: the coverage run ended with exit code " + int_to_str(cov_rc) + "\n");
        }
        print("\n");
        p_file_delete(cov_out);
    }
    p_file_delete(main_fd);
    p_file_delete("_fides_bench_out.txt");
    // Tests and fuzz targets count; a failing bench counts as failed too
    // (SL13: each saved input counts; a target not fuzzed does not)
    var ran: i64 = tests.len() + fuzzes.len() + replay_files.len() - fuzz_skipped;
    var passed: i64 = ran - failed;
    if passed < 0 {
        passed = 0;
    }
    print(int_to_str(passed) + " passed, " + int_to_str(failed) + " failed\n");
    if failed > 0 {
        return 1;
    }
    return 0;
}

fn cmd_test(n: i64, start: i64) -> i64 {
    // fid test <file.fd>: that file's test_* and bench_* functions
    if start + 2 <= n && str_ends_with(p_argv(start + 1), ".fd") {
        return cmd_test_file(n, start, false);
    }
    // --coverage covers one file's tests (cmd_test_file's CT8); without a
    // file it would mean the suite, which it cannot merge
    if argv_has(n, "--coverage") {
        p_eprint_str("fid test --coverage covers one file's tests: fid test <file.fd> --coverage\n");
        return 1;
    }
    // --fail: run only expected-fail tests (failing = correct)
    var fail_only: bool = has_flag(n, start, "--fail");

    p_eprint_str("[test] Scanning tests/bootstrap/ directory...\n");

    // Use ls/dir command to list .fd files, redirect to temp file
    if is_posix_host() {
        p_system("ls tests/bootstrap/*.fd > tests/_fides_test_list.txt 2>/dev/null");
    } else {
        p_system("dir /b tests\\bootstrap\\*.fd > tests\\_fides_test_list.txt 2>nul");
    }
    var listing: str = c_file_read("tests/_fides_test_list.txt");
    if str_len(listing) == 0 {
        if fail_only {
            p_eprint_str("No expected-fail tests found in tests/bootstrap/\n");
        } else {
            p_eprint_str("No .fd test files found in tests/bootstrap/\n");
        }
        return 1;
    }

    // Parse file listing (one filename per line; skip blank lines)
    var listed: Vec<str> = c_str_lines(listing);
    var files: Vec<str> = Vec::new();
    var li: i64 = 0;
    while li < listed.len() {
        if str_len(listed.get(li)) > 0 {
            files.push(listed.get(li));
        }
        li = li + 1;
    }
    if files.len() == 0 {
        if fail_only {
            p_eprint_str("No expected-fail tests found in tests/bootstrap/\n");
        } else {
            p_eprint_str("No .fd test files found in tests/bootstrap/\n");
        }
        return 1;
    }

    // Known-fail tests: these test compiler error detection.
    // They SHOULD fail to compile/run -- failing is the correct behavior.
    // Reference: src/main.rs:1398-1453
    var expected_fail: Vec<str> = Vec::new();
    expected_fail.push("test_trait_verify_fail");
    expected_fail.push("test_budget_fail");
    expected_fail.push("test_sandbox_fail");
    expected_fail.push("test_deterministic_fail");
    expected_fail.push("test_field_privacy_fail");
    expected_fail.push("test_money_linear_fail");
    expected_fail.push("test_money_conserve_fail");
    expected_fail.push("test_banking_double_credit_fail");
    expected_fail.push("test_banking_lost_money_fail");
    expected_fail.push("test_loop_linear_fail");
    expected_fail.push("test_gas_fail");
    expected_fail.push("test_crashfree_fail");
    expected_fail.push("test_machine_crashfree_fail");
    expected_fail.push("test_typed_strings_fail");
    expected_fail.push("test_init_guarantee_fail");
    expected_fail.push("test_init_guarantee_cond_fail");
    expected_fail.push("test_param_queries_fail");
    expected_fail.push("test_medical_fail");
    expected_fail.push("test_contracts_fail");
    expected_fail.push("test_safety_annotations_fail");
    expected_fail.push("test_safety_no_audit_fail");
    expected_fail.push("test_borrowck_fail");
    expected_fail.push("test_async_fail");
    expected_fail.push("test_constant_time_fail");
    expected_fail.push("test_constant_time_fail2");
    expected_fail.push("test_send_fail");
    expected_fail.push("test_gpu_region_fail");
    expected_fail.push("test_shape_verify_fail");
    expected_fail.push("test_realtime_fail");
    expected_fail.push("test_realtime_fail2");
    expected_fail.push("test_autodiff_fail");
    expected_fail.push("test_kv_cache_fail");
    expected_fail.push("test_val_assign_fail");
    expected_fail.push("test_const_assign_fail");
    expected_fail.push("test_match_nonexhaustive_fail");
    expected_fail.push("test_vec_elem_fail");
    expected_fail.push("test_str_int_fail");
    expected_fail.push("test_crashfree_method_fail");
    expected_fail.push("test_double_free_fail");
    expected_fail.push("test_bad_free_fail");
    expected_fail.push("test_deref_safe_fail");
    expected_fail.push("test_malloc_safe_fail");
    expected_fail.push("test_malloc_uninit_fail");
    expected_fail.push("test_int_to_ptr_safe_fail");
    expected_fail.push("test_literal_range_fail");
    expected_fail.push("test_narrowing_fail");
    expected_fail.push("test_race_global_fail");
    expected_fail.push("test_quantization_fail");
    expected_fail.push("test_checkpoint_fail");
    expected_fail.push("test_dp_fail");
    expected_fail.push("test_shard_fail");
    expected_fail.push("test_vec_shape_fail");
    // @constant_time: data-dependent branch on secret — rejected by the
    // source-level checker (not just the asm verifier)
    expected_fail.push("test_ct_asm_fail");
    // @sensitive (CO7): consent-gated information flow
    expected_fail.push("test_sensitive_fail");
    // CO6: a required config key no source supplies panics
    expected_fail.push("test_config_missing_fail");
    // Proposal 0002; release L1, K4, K5, H4
    expected_fail.push("test_generic_infer_fail");
    expected_fail.push("test_generic_bound_fail");
    expected_fail.push("test_turbofish_arity_fail");
    expected_fail.push("test_safety_method_alloc_fail");
    expected_fail.push("test_safety_indirect_fail");
    expected_fail.push("test_gas_loop_fail");
    expected_fail.push("test_tainted_param_fail");
    expected_fail.push("test_iter_invalidation_fail");
    expected_fail.push("test_field_borrow_fail");
    expected_fail.push("test_spawn_send_fail");
    expected_fail.push("test_safety_recursion_fail");
    expected_fail.push("test_firmware_os_fail");
    expected_fail.push("test_bounded_stack_fail");
    expected_fail.push("test_borrowed_str_return_fail");
    expected_fail.push("test_borrowed_str_pass_fail");
    expected_fail.push("test_scoped_store_fail");
    expected_fail.push("test_race_ptr_fail");
    // Release E4: a missing DLL, a missing function in a DLL
    expected_fail.push("test_pe_dll_missing_fail");
    expected_fail.push("test_pe_dll_nofn_fail");

    // Skip list -- tests that fail on C codegen due to missing builtins
    // or legitimate design differences. These pass on interpreter + PE.
    // Reference: src/main.rs:1543-1545
    var skip_tests: Vec<str> = Vec::new();
    // Bare-only (`fid emit --bare`): a hosted build panics
    skip_tests.push("test_bare_panic_handler");
    // Links SQLite (native builds use the system's winsqlite3.dll; the C
    // path needs an import library)
    skip_tests.push("test_pe_sqlite");
    skip_tests.push("test_parse_header_sqlite");
    // All previously skipped tests now pass on C codegen!

    // Filter test files based on --fail mode
    var test_files: Vec<str> = Vec::new();
    var ffi: i64 = 0;
    while ffi < files.len() {
        var fname: str = files.get(ffi);
        var stem: str = fname;
        // Strip .fd extension
        if str_ends_with(stem, ".fd") {
            stem = str_slice(stem, 0, str_len(stem) - 3);
        }
        var is_fail: bool = str_vec_contains_str(expected_fail, stem);
        var is_bench: bool = str_starts_with(stem, "bench_");

        if fail_only {
            if is_fail {
                test_files.push(fname);
            }
        } else {
            if !is_fail && !is_bench {
                test_files.push(fname);
            }
        }
        ffi = ffi + 1;
    }

    if test_files.len() == 0 {
        if fail_only {
            p_eprint_str("No expected-fail tests found in tests/bootstrap/\n");
        } else {
            p_eprint_str("No .fd test files found in tests/bootstrap/\n");
        }
        return 1;
    }

    var batch_label: str = "normal";
    if fail_only {
        batch_label = "expected-fail";
    }
    p_eprint_str("[test] Running ");
    p_eprint_str(int_to_str(test_files.len()));
    p_eprint_str(" ");
    p_eprint_str(batch_label);
    p_eprint_str(" tests...\n\n");

    // Multi-backend test runner
    // Reference: src/main.rs:1517-1530
    // TODO: The self-hosted compiler does not yet have an interpreter
    // backend. Currently we test on C codegen and PE emitter only.
    // When the interpreter is ported, add interp_pass/interp_fail counters.
    var c_pass: i64 = 0;
    var c_fail: i64 = 0;
    var pe_pass: i64 = 0;
    var pe_fail: i64 = 0;

    var fi: i64 = 0;
    while fi < test_files.len() {
        var fname: str = test_files.get(fi);
        var test_path: str = "tests\\bootstrap\\" + fname;
        var stem2: str = fname;
        if str_ends_with(stem2, ".fd") {
            stem2 = str_slice(stem2, 0, str_len(stem2) - 3);
        }

        // Skip tests for C codegen limitations
        if str_vec_contains_str(skip_tests, stem2) {
            fi = fi + 1;
            continue;
        }

        // Read and compile
        var source: str = c_file_read(test_path);
        if str_len(source) == 0 {
            p_eprint_str("  [FAIL] ");
            p_eprint_str(fname);
            p_eprint_str(" (could not read)\n");
            c_fail = c_fail + 1;
            fi = fi + 1;
            continue;
        }

        // -- Backend 1: C codegen --
        var c_ok: bool = false;
        var result: ResultStr = ccompile_source_with_path(source, test_path, "on");
        match result {
            ResultStr::Ok(c_code) => {
                var c_file: str = "tests/_fides_test_tmp.c";
                p_file_write(c_file, c_code);
                var exe_name: str = "tests/_fides_test_tmp.exe";
                if is_posix_host() {
                    exe_name = "tests/_fides_test_tmp";
                }
                var cc: str = env_or_empty("CC");
                if str_len(cc) == 0 {
                    if is_posix_host() {
                        cc = "gcc";
                    } else {
                        cc = "tcc";
                    }
                }
                var cc_cmd: str = "";
                if is_posix_host() {
                    cc_cmd = cc + " -O2 -w -o " + exe_name + " " + c_file + " -lm";
                } else {
                    cc_cmd = cc + " -O2 -w -o " + exe_name + " " + c_file + " -lws2_32";
                }
                var ret: i64 = p_system(cc_cmd);
                if ret != 0 {
                    c_ok = false;
                } else {
                    var run_ret: i64 = p_system(exe_name);
                    c_ok = run_ret == 0;
                }
            }
            ResultStr::Err(errs) => {
                c_ok = false;
            }
        }

        // -- Backend 2: PE emitter --
        // TODO: PE emitter test would require building and running the PE.
        // For now, just check that compilation succeeds (parse + typecheck).
        var pe_ok: bool = false;
        var pe_result: ResultProgram = build_program_with_path(source, OptStr::Some(test_path));
        match pe_result {
            ResultProgram::Ok(program) => {
                pe_ok = true;
            }
            ResultProgram::Err(errs) => {
                pe_ok = false;
            }
        }

        // Report results
        if fail_only {
            // For expected-fail tests, failing is correct
            if !c_ok {
                p_eprint_str("  [PASS] ");
                p_eprint_str(fname);
                p_eprint_str(" (C: correctly failed)\n");
                c_pass = c_pass + 1;
            } else {
                p_eprint_str("  [FAIL] ");
                p_eprint_str(fname);
                p_eprint_str(" (C: should have failed)\n");
                c_fail = c_fail + 1;
            }
        } else {
            if c_ok {
                p_eprint_str("  [PASS] ");
                p_eprint_str(fname);
                p_eprint_str(" (C");
                if pe_ok {
                    p_eprint_str("+PE");
                }
                p_eprint_str(")\n");
                c_pass = c_pass + 1;
                if pe_ok {
                    pe_pass = pe_pass + 1;
                }
            } else {
                p_eprint_str("  [FAIL] ");
                p_eprint_str(fname);
                p_eprint_str(" (C");
                if pe_ok {
                    p_eprint_str(", PE ok");
                } else {
                    p_eprint_str("+PE");
                }
                p_eprint_str(")\n");
                c_fail = c_fail + 1;
                if !pe_ok {
                    pe_fail = pe_fail + 1;
                }
            }
        }
        fi = fi + 1;
    }

    // Clean up
    if is_posix_host() {
        p_system("rm -f tests/_fides_test_list.txt tests/_fides_test_tmp.c tests/_fides_test_tmp");
    } else {
        p_system("del tests\\_fides_test_list.txt");
        p_system("del tests\\_fides_test_tmp.c");
        p_system("del tests\\_fides_test_tmp.exe");
    }

    p_eprint_str("\n=== Results ===\n");
    p_eprint_str("C codegen:  ");
    p_eprint_str(int_to_str(c_pass));
    p_eprint_str(" passed, ");
    p_eprint_str(int_to_str(c_fail));
    p_eprint_str(" failed\n");
    p_eprint_str("PE emitter: ");
    p_eprint_str(int_to_str(pe_pass));
    p_eprint_str(" passed, ");
    p_eprint_str(int_to_str(pe_fail));
    p_eprint_str(" failed\n");
    // TODO: Add interpreter backend results when ported.

    if c_fail > 0 {
        return 1;
    }
    return 0;
}

// --- Helper: check if a string is in a Vec<str> ---------------------------
fn str_vec_contains_str(vec: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < vec.len() {
        if vec.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// --- bench ---------------------------------------------------------------
// Builds the program through `fid ccompile` (so the C compiler is chosen
// as for every build: $CC first, then gcc, clang, tcc, cl), then runs it N
// times and reports the wall time of each run and the min/mean/max.
// `--cc-opt <0|1|2|3|s>` is passed on (default -O2). 2g.62: it used to
// call `tcc` (gcc on POSIX) itself, whatever CC said, and timed nothing.
fn cmd_bench(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid bench <file.fd> [-n <count>] [--cc-opt <0|1|2|3|s>]\n");
        p_eprint_str("  Builds through `fid ccompile` (uses $CC when set) and times n runs.\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var count: i64 = 10;

    var ai: i64 = start + 2;
    while ai < n {
        if p_argv(ai) == "-n" {
            if ai + 1 < n {
                count = c_str_parse_i64(p_argv(ai + 1));
            }
        }
        ai = ai + 1;
    }
    if count <= 0 {
        count = 10;
    }

    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }

    // Build through `fid ccompile`: it picks the C compiler ($CC, else
    // gcc/clang/tcc/cl), the libraries and the flags the way every build
    // does, so bench measures what `ccompile` produces.
    var exe_name: str = "_fides_bench_tmp.exe";
    var run_exe: str = ".\\_fides_bench_tmp.exe";
    if is_posix_host() {
        exe_name = "_fides_bench_tmp";
        run_exe = "./_fides_bench_tmp";
    }
    var cc_opt: str = get_flag_value(n, start, "--cc-opt", "2");
    var build: str = "\"" + p_argv(0) + "\" ccompile \"" + input + "\" -o " + exe_name + " --cc-opt " + cc_opt;
    var cc_env: str = env_or_empty("CC");
    p_eprint_str("bench: building " + input + " with ");
    if str_len(cc_env) > 0 {
        p_eprint_str("CC=" + cc_env);
    } else {
        p_eprint_str("the default C compiler (CC is not set)");
    }
    p_eprint_str(", -O" + cc_opt + "\n");
    // project_run: cmd.exe /C strips the outer quotes of a command that
    // starts with one (the quoted fid path), so it gets one more pair.
    if project_run(build) != 0 {
        p_eprint_str("bench: the build failed (`fid ccompile` needs a C compiler: set CC)\n");
        p_file_delete("_fides_bench_tmp.c");
        return 1;
    }

    p_eprint_str("Benchmark: " + input + " (" + int_to_str(count) + " runs)\n");
    var times: Vec<i64> = Vec::new();
    var failed: i64 = 0;
    var bi: i64 = 0;
    while bi < count {
        var t0: i64 = p_clock_now_us();
        var exit_code: i64 = p_system(run_exe);
        var dt: i64 = p_clock_now_us() - t0;
        times.push(dt);
        p_eprint_str("  run " + int_to_str(bi + 1) + "/" + int_to_str(count) + ": " + bench_ms(dt));
        if exit_code != 0 {
            p_eprint_str(" (exit " + int_to_str(exit_code) + ")");
            failed = failed + 1;
        }
        p_eprint_str("\n");
        bi = bi + 1;
    }
    var lo: i64 = times.get(0);
    var hi: i64 = times.get(0);
    var sum: i64 = 0;
    var ti: i64 = 0;
    while ti < times.len() {
        var t: i64 = times.get(ti);
        if t < lo {
            lo = t;
        }
        if t > hi {
            hi = t;
        }
        sum = sum + t;
        ti = ti + 1;
    }
    p_eprint_str("  min " + bench_ms(lo) + "  mean " + bench_ms(sum / count) + "  max " + bench_ms(hi) + "\n");

    // Clean up what ccompile wrote
    p_file_delete("_fides_bench_tmp.c");
    p_file_delete(exe_name);
    if failed > 0 {
        p_eprint_str("bench: " + int_to_str(failed) + " of " + int_to_str(count) + " runs exited with a non-zero status\n");
        return 1;
    }
    return 0;
}

/// `us` microseconds as milliseconds with three decimals ("12.034 ms").
fn bench_ms(us: i64) -> str {
    var frac: str = int_to_str(us % 1000);
    while str_len(frac) < 3 {
        frac = "0" + frac;
    }
    return int_to_str(us / 1000) + "." + frac + " ms";
}

// --- watch ---------------------------------------------------------------
/// `fid watch <file.fd> [<command>] [--interval <ms>] [-- <args>]`:
/// `fid <command> <file.fd> <args>` on start and again each time the file's
/// contents change (content-polling; the runtime has no mtime builtin).
fn cmd_watch(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid watch <file.fd> [<command>] [--interval <ms>] [-- <args>]\n");
        p_eprint_str("  `fid <command> <file.fd> <args>` on start and each time the file changes.\n");
        p_eprint_str("  <command>: run (default), check, build, emit, ccompile, test, lint, fmt, fix, veil\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var wcmd: str = "run";
    var extra: str = "";
    var seen_dd: bool = false;
    var got_cmd: bool = false;
    var wi: i64 = start + 2;
    while wi < n {
        var a: str = p_argv(wi);
        if a == "--" {
            seen_dd = true;
        } else if seen_dd {
            extra = extra + " " + shell_word(a);
        } else if a == "--interval" {
            wi = wi + 1;
        } else if !str_starts_with(a, "-") && !got_cmd {
            wcmd = a;
            got_cmd = true;
        }
        wi = wi + 1;
    }
    var known: bool = wcmd == "run" || wcmd == "check" || wcmd == "build" || wcmd == "emit" || wcmd == "ccompile" || wcmd == "test" || wcmd == "lint" || wcmd == "fmt" || wcmd == "fix" || wcmd == "veil";
    if !known {
        p_eprint_str("fid watch: '" + wcmd + "' is not a command to re-run (run, check, build, emit, ccompile, test, lint, fmt, fix, veil)\n");
        return 1;
    }
    var interval: i64 = get_flag_int(n, start, "--interval", 500);
    if interval < 50 {
        interval = 50;
    }
    var last: str = c_file_read(input);
    if str_len(last) == 0 {
        p_eprint_str("fid watch: " + input + " is empty or missing; waiting for it (Ctrl-C to stop)\n");
    } else {
        p_eprint_str("fid watch: " + input + " -- `fid " + wcmd + "` again on change, every " + int_to_str(interval) + " ms (Ctrl-C to stop)\n");
    }
    var run_cmd: str = self_command() + " " + wcmd + " " + shell_word(input) + extra;
    project_run(run_cmd);
    while true {
        p_co_sleep(interval);
        var now: str = c_file_read(input);
        if str_len(now) == 0 || now == last {
            continue;
        }
        last = now;
        p_eprint_str("\nfid watch: " + input + " changed -- `fid " + wcmd + "`\n");
        project_run(run_cmd);
    }
    return 0;
}

// --- profile -------------------------------------------------------------
fn cmd_profile(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid profile <file.fd> [-o <stacks.folded>]\n");
        p_eprint_str("       fid profile --pid <N> [--seconds S] [-o <stacks.folded>]\n");
        p_eprint_str("  Build through C with a sampling profiler, run, and report where the\n");
        p_eprint_str("  time goes. Writes collapsed stacks (flamegraph.pl, inferno, speedscope).\n");
        p_eprint_str("  --pid: attach to a running program built through C and sample every\n");
        p_eprint_str("  thread for S seconds (default 10; Ctrl-C stops early).\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var out: str = get_flag_value(n, start, "-o", "fides-profile.folded");
    // CO5: --pid <N> [--seconds S]: sample a running program (codegen_c.fd cg_prof_attach)
    var pid_arg: str = "";
    var secs_arg: str = "10";
    var pa: i64 = start + 1;
    while pa + 1 < n {
        if p_argv(pa) == "--pid" {
            pid_arg = p_argv(pa + 1);
        }
        if p_argv(pa) == "--seconds" {
            secs_arg = p_argv(pa + 1);
        }
        pa = pa + 1;
    }
    var spacing: str = "1 ms apart";
    if str_len(pid_arg) > 0 {
        input = "process " + pid_arg;
        spacing = "every thread, about 1 ms apart";
        if cg_prof_attach(pid_arg, secs_arg, out, env_or_empty("CC"), is_posix_host()) != 0 {
            return 1;
        }
    } else {
        var exe: str = "_fides_profile_tmp.exe";
        var run_exe: str = ".\\_fides_profile_tmp.exe";
        if is_posix_host() {
            exe = "_fides_profile_tmp";
            run_exe = "./_fides_profile_tmp";
        }
        var build: str = "\"" + p_argv(0) + "\" ccompile " + input + " -o " + exe + " --profile";
        if p_system(build) != 0 {
            p_eprint_str("profile: the build failed\n");
            return 1;
        }
        p_system(run_exe);
        if out != "fides-profile.folded" {
            p_rename("fides-profile.folded", out);
        }
    }
    var text: str = c_file_read(out);
    if str_len(text) == 0 {
        p_eprint_str("profile: no samples (the program ran under a millisecond?)\n");
        return 1;
    }
    // Self samples: the innermost function of each stack
    var counts: i64 = HashMap_new();
    var names: Vec<str> = Vec::new();
    var total: i64 = 0;
    var lines: Vec<str> = str_split(text, "\n");
    var li: i64 = 0;
    while li < lines.len() {
        var line: str = lines.get(li);
        var sp: i64 = str_rfind(line, " ");
        if sp > 0 {
            var stack: str = str_slice(line, 0, sp);
            var semi: i64 = str_rfind(stack, ";");
            var leaf: str = stack;
            if semi >= 0 {
                leaf = str_slice(stack, semi + 1, str_len(stack));
            }
            if HashMap_get(counts, leaf) == 0 {
                names.push(leaf);
            }
            HashMap_insert(counts, leaf, HashMap_get(counts, leaf) + 1);
            total = total + 1;
        }
        li = li + 1;
    }
    print("\nProfile of " + input + ": " + int_to_str(total) + " samples, " + spacing + "\n");
    print("  self %   samples  function\n");
    var shown: i64 = 0;
    while shown < 20 && shown < names.len() {
        var best: i64 = -1;
        var bi: i64 = 0;
        while bi < names.len() {
            if HashMap_get(counts, names.get(bi)) > 0 {
                if best < 0 || HashMap_get(counts, names.get(bi)) > HashMap_get(counts, names.get(best)) {
                    best = bi;
                }
            }
            bi = bi + 1;
        }
        if best < 0 {
            break;
        }
        var c: i64 = HashMap_get(counts, names.get(best));
        print("  " + int_to_str(c * 100 / total) + "%  " + int_to_str(c) + "  " + names.get(best) + "\n");
        HashMap_insert(counts, names.get(best), 0 - 1);
        shown = shown + 1;
    }
    print("Collapsed stacks: " + out + " (flamegraph.pl, inferno-flamegraph, speedscope)\n");
    return 0;
}

/// L7G: whether REPL line `line` is command `name`, alone or with an
/// argument after a space.
fn repl_cmd_is(line: str, name: str) -> bool {
    return line == name || str_starts_with(line, name + " ");
}

/// L7G: the argument of a REPL command line (what follows its first
/// space), "" for none.
fn repl_cmd_arg(line: str) -> str {
    var sp: i64 = str_find(line, " ");
    if sp < 0 {
        return "";
    }
    return str_trim(str_slice(line, sp + 1, str_len(line)));
}

/// L7G multi-line input: how many `(`, `[` and `{` of `text` are still
/// open (outside string and char literals and `//` comments). The REPL
/// keeps reading lines while this is above 0; below 0 (a stray closer) is
/// left for the parser to report.
fn repl_open_depth(text: str) -> i64 {
    var depth: i64 = 0;
    var n: i64 = str_len(text);
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(text, i);
        if c == 34 || c == 39 {
            // a string or char literal: skip to its closing quote
            var q: i64 = c;
            i = i + 1;
            while i < n && str_byte_at(text, i) != q {
                if str_byte_at(text, i) == 92 {
                    i = i + 1;
                }
                i = i + 1;
            }
        } else if c == 47 && i + 1 < n && str_byte_at(text, i + 1) == 47 {
            // a line comment: skip to the end of its line
            while i < n && str_byte_at(text, i) != 10 {
                i = i + 1;
            }
        } else if c == 40 || c == 91 || c == 123 {
            depth = depth + 1;
        } else if c == 41 || c == 93 || c == 125 {
            depth = depth - 1;
        }
        i = i + 1;
    }
    return depth;
}

fn cmd_repl() -> i64 {
    p_eprint_str("fid REPL — type expressions to evaluate, :quit to exit\n\n");
    var line_num: i64 = 1;
    var running: bool = true;
    // L7G: the session's definitions (source text, compiler.fd
    // repl_add_definition) and the last expression run, which `:ir` and
    // `:ast` show when given none
    var defs: str = "";
    var last_expr: str = "";
    while running {
        p_eprint_str("fides:");
        p_eprint_str(int_to_str(line_num));
        p_eprint_str("> ");
        // the end of input ends the session (a piped script: `:type 1 + 2`
        // then EOF), where the raw p_read_line's 0 was read as a line
        var trimmed: str = "";
        var got_line: bool = false;
        match read_line() {
            Option::Some(l) => {
                trimmed = str_trim(l);
                got_line = true;
            }
            Option::None => {
            }
        }
        if !got_line {
            running = false;
            continue;
        }
        if str_len(trimmed) == 0 {
            continue;
        }
        // L7G multi-line input: a definition or expression with an open
        // `(`, `[` or `{` goes on over the next lines ("...> " prompt)
        // until they are closed; an empty line or the end of input
        // abandons it. Commands stay one line.
        if !str_starts_with(trimmed, ":") && repl_open_depth(trimmed) > 0 {
            var pending: bool = true;
            var abandoned: bool = false;
            while pending {
                p_eprint_str("  ...> ");
                // the line as typed (its indentation kept for :defs; only
                // trailing blanks and a CR go), trimmed only to test for
                // an empty line
                var more: str = "";
                var got_more: bool = false;
                match read_line() {
                    Option::Some(ml) => {
                        more = str_trim_end(ml);
                        got_more = true;
                    }
                    Option::None => {
                    }
                }
                if !got_more || str_len(str_trim(more)) == 0 {
                    pending = false;
                    abandoned = true;
                    if !got_more {
                        running = false;
                    }
                } else {
                    trimmed = trimmed + "\n" + more;
                    if repl_open_depth(trimmed) <= 0 {
                        pending = false;
                    }
                }
            }
            if abandoned {
                p_eprint_str("(input abandoned: unclosed bracket)\n");
                continue;
            }
        }
        if trimmed == ":quit" || trimmed == ":q" || trimmed == ":exit" {
            running = false;
            continue;
        }
        if trimmed == ":help" || trimmed == ":h" {
            p_eprint_str("Commands:\n");
            p_eprint_str("  :quit  — exit REPL\n");
            p_eprint_str("  :help  — show this help\n");
            p_eprint_str("  :type <expr> — show the type of an expression (:t)\n");
            p_eprint_str("  :ast [expr]  — show the parsed expression (default: the last one run)\n");
            p_eprint_str("  :ir [expr | fn] — show the IR of an expression or of a function\n");
            p_eprint_str("  :effects <fn> — show the effects of a function\n");
            p_eprint_str("  :caps <fn>   — show the capabilities a function needs\n");
            p_eprint_str("  :opt <fn>    — show a function's IR after the IR optimizer\n");
            p_eprint_str("  :defs        — show the definitions of this session\n\n");
            p_eprint_str("Type a Fides expression (e.g. 1 + 2, \"hello\", [1,2,3]),\n");
            p_eprint_str("or a definition (fn, struct, enum, impl, use) to keep; an open\n");
            p_eprint_str("( [ or { continues the input on the next lines (empty line: cancel)\n");
            continue;
        }
        if trimmed == ":defs" {
            print(defs);
            continue;
        }
        // L7G: `:type <expr>` — the checker's type of the expression, not
        // run (compiler.fd repl_expr_type)
        if str_starts_with(trimmed, ":type ") || str_starts_with(trimmed, ":t ") || trimmed == ":type" || trimmed == ":t" {
            var sp: i64 = str_find(trimmed, " ");
            var texpr: str = "";
            if sp > 0 {
                texpr = str_trim(str_slice(trimmed, sp + 1, str_len(trimmed)));
            }
            if str_len(texpr) == 0 {
                p_eprint_str("Usage: :type <expr>\n");
                continue;
            }
            match repl_expr_type_in(defs, texpr) {
                ResultStr::Ok(tname) => {
                    print(texpr + " : " + tname + "\n");
                }
                ResultStr::Err(terrs) => {
                    print_errors(terrs);
                }
            }
            line_num = line_num + 1;
            continue;
        }
        // L7G: `:ast [expr]` — the parsed expression (the last one run when
        // none is given); nothing is checked or run (compiler.fd
        // repl_expr_ast)
        if repl_cmd_is(trimmed, ":ast") {
            var aexpr: str = repl_cmd_arg(trimmed);
            if str_len(aexpr) == 0 {
                aexpr = last_expr;
            }
            if str_len(aexpr) == 0 {
                p_eprint_str("Usage: :ast <expr> (or :ast after an expression)\n");
                continue;
            }
            match repl_expr_ast(defs, aexpr) {
                ResultStr::Ok(atext) => {
                    print(atext + "\n");
                }
                ResultStr::Err(aerrs) => {
                    print_errors(aerrs);
                }
            }
            line_num = line_num + 1;
            continue;
        }
        // L7G: `:ir [expr | fn]` — the IR of a function of the session, or
        // of the `main` that prints the expression (the last one run when
        // none is given), as the REPL lowers it to run it
        if repl_cmd_is(trimmed, ":ir") {
            var iarg: str = repl_cmd_arg(trimmed);
            if str_len(iarg) == 0 {
                iarg = last_expr;
            }
            if str_len(iarg) == 0 {
                p_eprint_str("Usage: :ir <expr> | :ir <function> (or :ir after an expression)\n");
                continue;
            }
            var ifn: str = "main";
            var iexpr: str = iarg;
            if cc_c_str_vec_contains(repl_user_fns(defs), iarg) {
                ifn = iarg;
                iexpr = "";
            }
            match repl_lower(defs, iexpr) {
                ResultIrModule::Ok(imod) => {
                    match repl_fn_ir(imod, ifn) {
                        ResultStr::Ok(itext) => {
                            print(itext);
                        }
                        ResultStr::Err(ierrs) => {
                            print_errors(ierrs);
                        }
                    }
                }
                ResultIrModule::Err(lerrs) => {
                    print_errors(lerrs);
                }
            }
            line_num = line_num + 1;
            continue;
        }
        // MI18: `:pir` printed the PIR path's levels, removed with it
        if repl_cmd_is(trimmed, ":pir") {
            p_eprint_str(":pir was removed with the PIR path: :opt <fn> shows a function after the IR optimizer, :ir <fn> as lowered\n");
            continue;
        }
        // L7G: `:effects <fn>`, `:caps <fn>`, MI18 `:opt <fn>` — what a
        // function of the session (or of the stdlib) does, from the
        // session's lowering (compiler.fd repl_fn_caps/opt) or, for
        // :effects, its type check (repl_lang_effects)
        if repl_cmd_is(trimmed, ":effects") || repl_cmd_is(trimmed, ":caps") || repl_cmd_is(trimmed, ":opt") {
            var fcmd: str = trimmed;
            var fsp: i64 = str_find(trimmed, " ");
            if fsp > 0 {
                fcmd = str_slice(trimmed, 0, fsp);
            }
            var fname: str = repl_cmd_arg(trimmed);
            var fsp2: i64 = str_find(fname, " ");
            if fsp2 > 0 {
                fname = str_slice(fname, 0, fsp2);
            }
            if str_len(fname) == 0 {
                p_eprint_str("Usage: " + fcmd + " <function>\n");
                continue;
            }
            match repl_lower(defs, "") {
                ResultIrModule::Ok(fmod) => {
                    var fres: ResultStr = ResultStr::Ok("");
                    if fcmd == ":effects" {
                        // the language's effects, as the type checker
                        // infers them (not the IR's, where a stack local
                        // is Alloc/Write/Read)
                        fres = repl_lang_effects(defs, fname);
                    } else if fcmd == ":caps" {
                        fres = repl_fn_caps(fmod, fname, repl_user_fns(defs));
                    } else {
                        fres = repl_fn_opt(fmod, fname, defs);
                    }
                    match fres {
                        ResultStr::Ok(ftext) => {
                            if fcmd == ":opt" {
                                print(ftext);
                            } else {
                                print(fname + " : " + ftext + "\n");
                            }
                        }
                        ResultStr::Err(ferrs) => {
                            print_errors(ferrs);
                        }
                    }
                }
                ResultIrModule::Err(flerrs) => {
                    print_errors(flerrs);
                }
            }
            line_num = line_num + 1;
            continue;
        }
        if str_starts_with(trimmed, ":") {
            p_eprint_str("Unknown command: " + trimmed + " (:help lists the commands)\n");
            continue;
        }
        // L7G: a one-line definition is kept for the rest of the session
        // once the program with it still checks
        if repl_is_definition(trimmed) {
            if str_starts_with(trimmed, "fn main(") {
                p_eprint_str("main is the REPL's own function: give yours another name\n");
                continue;
            }
            match repl_add_definition(defs, trimmed) {
                ResultStr::Ok(next_defs) => {
                    defs = next_defs;
                    print("defined\n");
                }
                ResultStr::Err(derrs) => {
                    print_errors(derrs);
                }
            }
            line_num = line_num + 1;
            continue;
        }
        // Wrap the input in a main function (after the session's
        // definitions) and run it
        var source: str = repl_program(defs, repl_print_body(trimmed));
        var result: ResultStr = ccompile_source_with_path(source, "<repl>", "on");
        match result {
            ResultStr::Ok(c_code) => {
                last_expr = trimmed;
                p_file_write("_fides_repl_tmp.c", c_code);
                var exe_name: str = "_fides_repl_tmp.exe";
                if is_posix_host() {
                    exe_name = "_fides_repl_tmp";
                }
                var build_cmd: str = "";
                if is_posix_host() {
                    build_cmd = "gcc -O2 -w -o " + exe_name + " _fides_repl_tmp.c -lm";
                } else {
                    build_cmd = "tcc -O2 -w -o " + exe_name + " _fides_repl_tmp.c -lws2_32";
                }
                p_system(build_cmd);
                p_system(exe_name);
                if is_posix_host() {
                    p_system("rm -f _fides_repl_tmp.c _fides_repl_tmp");
                } else {
                    p_system("del _fides_repl_tmp.c");
                    p_system("del _fides_repl_tmp.exe");
                }
            }
            ResultStr::Err(errs) => {
                print_errors(errs);
            }
        }
        line_num = line_num + 1;
    }
    p_eprint_str("\nBye!\n");
    return 0;
}

// --- notebook ------------------------------------------------------------
fn cmd_notebook(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid notebook <file.fd> [-o output.html]\n");
        p_eprint_str("  Renders a Fides file as an HTML notebook.\n");
        p_eprint_str("  Each /// comment block becomes a markdown cell.\n");
        p_eprint_str("  Each code block is evaluated, output rendered inline.\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var output: str = input + ".html";

    var ai: i64 = start + 2;
    while ai < n {
        if p_argv(ai) == "-o" {
            if ai + 1 < n {
                output = p_argv(ai + 1);
            }
        }
        ai = ai + 1;
    }

    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }

    // Parse the source into cells: /// comments = markdown, code = code cells
    var html: str = "<!DOCTYPE html>\n<html>\n<head>\n<title>";
    html = html + input + "</title>\n<style>\n";
    html = html + "body { font-family: monospace; max-width: 800px; margin: 20px auto; padding: 20px; }\n";
    html = html + ".cell { border: 1px solid #ccc; margin: 10px 0; padding: 10px; border-radius: 5px; }\n";
    html = html + ".markdown { background: #f5f5f5; white-space: pre-wrap; }\n";
    html = html + ".code { background: #f0f0ff; white-space: pre-wrap; }\n";
    html = html + ".output { background: #f5fff5; white-space: pre-wrap; margin-top: 5px; }\n";
    html = html + "</style>\n</head>\n<body>\n";
    html = html + "<h1>" + input + "</h1>\n";

    // Simple cell parsing: split on /// to find markdown cells
    var lines: Vec = str_split(source, "\n");
    var i: i64 = 0;
    while i < lines.len() {
        var line: str = str_trim(lines.get(i));
        if str_starts_with(line, "///") {
            // Markdown cell
            var md: str = str_slice(line, 3, str_len(line));
            md = str_trim(md);
            html = html + "<div class=\"cell markdown\">" + md + "</div>\n";
        } else if str_len(line) > 0 {
            // Code line (simplified — full implementation would group code blocks)
            html = html + "<div class=\"cell code\">" + line + "</div>\n";
        }
        i = i + 1;
    }

    html = html + "</body>\n</html>\n";
    p_file_write(output, html);
    p_eprint_str("Notebook written to: ");
    p_eprint_str(output);
    p_eprint_str("\n");
    return 0;
}

// --- lint ----------------------------------------------------------------
/// fid check: type, borrow and effect checks with no code generation.
fn cmd_check(n: i64, start: i64) -> i64 {
    var t_start: i64 = p_clock_now_ms();
    if has_flag(n, start, "--time") {
        set_time_on();
    }
    if start + 2 > n {
        p_eprint_str("Usage: fid check <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: " + input + "\n");
        return 1;
    }
    // SP19: a running `fid serve --port <n>` (FID_SERVE=<n>, or --server
    // <n>) checks it with its warm stdlib and module parses; the errors
    // are printed as below. No server answering, or one that cannot read
    // the file (started in another directory): checked here.
    var sport: i64 = get_flag_int(n, start, "--server", 0);
    if sport == 0 {
        sport = serve_env_port();
    }
    if sport > 0 && !has_flag(n, start, "--time") {
        var sans: ServeAnswer = serve_client_ask(sport, "check " + input, "");
        if sans.ok && sans.status == 0 {
            p_eprint_str(input + ": no errors (fid serve on port " + int_to_str(sport) + ")\n");
            return 0;
        }
        if sans.ok && sans.status == 1 && sans.errors.len() > 0 && !str_starts_with(sans.errors.get(0), "could not read file") {
            print_errors(sans.errors);
            return 1;
        }
    }
    var t0: i64 = p_clock_now_ms();
    match build_program_with_path_borrowck(source, OptStr::Some(input), "on") {
        ResultProgram::Ok(program) => {
            // CA4: lock-order analysis on the lowered IR
            var lc_off: str = env_or_empty("FID_LOCKCHECK");
            if lc_off != "off" {
                var lm: IrModule = lower(program);
                var lcr: LockCheckResult = lockcheck_module(&lm);
                if lcr.cycle {
                    p_eprint_str("error: " + lcr.cycle_desc + "
");
                    return 1;
                }
            }
            time_mark("total", t_start);
            time_report();
            p_eprint_str(input + ": no errors (" + int_to_str(p_clock_now_ms() - t0) + " ms)\n");
            return 0;
        }
        ResultProgram::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- fix (TL3) ---------------------------------------------------------------
// `fid fix <file.fd> [--check]`: applies the mechanical fixes the checker
// and the linter suggest (compiler/lsp.fd fix_suggestions: val -> var, a
// narrowing `as T`, a misspelled name, an unused import), one at a time.
// A fix is kept only when the program then has fewer errors, or as many
// with none left on the fixed line (an error the first one hid), or, for a
// lint fix, still none: a guess that breaks the program is not written. --check (or
// --dry-run): report the fixes and do not write the file; the status is 1
// when any would apply. --edition N (TL3): upgrade the file to edition N,
// which is stated only when the file then checks clean under it.

/// The errors of `source` as `fid check` reports them (none when clean).
fn fix_errors_of(source: str, input: str) -> Vec<str> {
    // the dependency list is per build (incremental stamps), as in serve
    inc_deps_reset();
    match build_program_with_path_borrowck(source, OptStr::Some(input), "on") {
        ResultProgram::Ok(_) => {
            return Vec::new();
        }
        ResultProgram::Err(errs) => {
            return errs;
        }
    }
    return Vec::new();
}

fn cmd_fix(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid fix <file.fd> [--check] [--edition N]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var check_only: bool = has_flag(n, start, "--check") || has_flag(n, start, "--dry-run");
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: " + input + "\n");
        return 1;
    }
    // TL3: --edition N (or --edition=N): upgrade the file to edition N. It
    // is checked stating `#[edition(N)]` (lsp.fd fix_set_edition), so the
    // fixes are those edition N asks for (in 2027 the @deprecated calls
    // with a replacement); the edition stays only when it then checks clean
    var ed_target: i64 = 0;
    var eai: i64 = start + 2;
    while eai < n {
        var ea: str = p_argv(eai);
        if ea == "--edition" && eai + 1 < n {
            ed_target = c_str_parse_i64(p_argv(eai + 1));
        } else if str_starts_with(ea, "--edition=") {
            ed_target = c_str_parse_i64(str_substring_from(ea, 10));
        }
        eai = eai + 1;
    }
    var orig_source: str = str_clone(source);
    if ed_target != 0 {
        if !edition_known(ed_target) {
            p_eprint_str("Error: unknown edition " + int_to_str(ed_target) + " (this compiler knows editions 2026 and 2027)\n");
            return 1;
        }
        source = fix_set_edition(source, ed_target);
    }
    var applied: i64 = 0;
    // CB2: each candidate is checked again; the imported modules, which
    // a fix does not change, are parsed once (compiler.fd modcache_get)
    modcache_enable();
    // fixes tried and rejected, as "title@line", not tried again
    var rejected: Vec<str> = Vec::new();
    var errs: Vec<str> = fix_errors_of(source, input);
    var round: i64 = 0;
    var going: bool = true;
    while going && round < 50 {
        var diags: Vec<str> = Vec::new();
        var from_lint: bool = false;
        if errs.len() > 0 {
            var di: i64 = 0;
            while di < errs.len() {
                diags.push(errs.get(di));
                di = di + 1;
            }
        } else {
            match lint_source(source, input, false) {
                ResultVecStr::Ok(ws) => {
                    diags = ws;
                    from_lint = true;
                }
                ResultVecStr::Err(_) => {
                }
            }
        }
        var fixes: Vec<SrcFix> = fix_suggestions(source, diags);
        var took: bool = false;
        var fi: i64 = 0;
        while fi < fixes.len() && !took {
            var f: SrcFix = fixes.get(fi);
            var key: str = f.title + "@" + int_to_str(f.line);
            if !str_vec_contains(rejected, key) {
                var cand: str = fix_apply(source, f);
                var cand_errs: Vec<str> = fix_errors_of(cand, input);
                // Kept: fewer errors; or as many, when none is left on the
                // fixed line (an error the first one hid now shows, as an
                // undefined name after a `val` is fixed); a lint fix: none
                var helps: bool = cand_errs.len() < errs.len();
                if !helps && cand_errs.len() == errs.len() && !from_lint {
                    helps = true;
                    var ci: i64 = 0;
                    while ci < cand_errs.len() {
                        if str_contains(cand_errs.get(ci), "(line " + int_to_str(f.line) + ")") {
                            helps = false;
                        }
                        ci = ci + 1;
                    }
                }
                if from_lint {
                    helps = cand_errs.len() == 0;
                }
                if helps {
                    print("fixed  " + input + ":" + int_to_str(f.line) + ": " + f.title + "\n");
                    source = cand;
                    errs = cand_errs;
                    applied = applied + 1;
                    took = true;
                } else {
                    print("kept   " + input + ":" + int_to_str(f.line) + ": " + f.title + " (it would not leave fewer errors)\n");
                    rejected.push(key);
                }
            }
            fi = fi + 1;
        }
        if !took {
            going = false;
        }
        round = round + 1;
    }
    // TL3: the edition is stated only when the file checks clean under
    // it; otherwise the file's own edition line comes back (lsp.fd
    // fix_restore_edition), with the fixes when they leave no more errors
    // in that edition than the file had, and the status is 1
    var ed_failed: bool = false;
    if ed_target != 0 {
        var ed: str = int_to_str(ed_target);
        if errs.len() == 0 {
            if source != orig_source {
                print("edition " + ed + ": " + input + " checks clean under it: #[edition(" + ed + ")]\n");
            }
        } else {
            ed_failed = true;
            print("edition " + ed + ": not stated, " + int_to_str(errs.len()) + " error(s) remain under edition " + ed + ":\n");
            print_errors(errs);
            var back: str = fix_restore_edition(orig_source, source);
            var back_errs: Vec<str> = fix_errors_of(back, input);
            var orig_errs: Vec<str> = fix_errors_of(orig_source, input);
            if back_errs.len() <= orig_errs.len() {
                source = back;
                errs = back_errs;
            } else {
                source = str_clone(orig_source);
                errs = orig_errs;
                applied = 0;
            }
        }
    }
    var changed: bool = source != orig_source;
    if !changed {
        print("fid fix: nothing to fix in " + input + "\n");
    } else if check_only {
        print("fid fix: " + int_to_str(applied) + " fix(es) would apply to " + input + " (--check: not written)\n");
    } else {
        p_file_write(input, source);
        print("fid fix: " + int_to_str(applied) + " fix(es) applied to " + input + "\n");
    }
    if errs.len() > 0 {
        print(int_to_str(errs.len()) + " error(s) remain: fid check " + input + "\n");
    }
    if check_only && changed {
        return 1;
    }
    if ed_failed || errs.len() > 0 {
        return 1;
    }
    return 0;
}

// --- serve ------------------------------------------------------------------
// SP18 (own-backend roadmap): `fid serve`, a long-lived checker. One request
// a line on stdin:
//   check <file.fd>   type, borrow and effect checks, as `fid check`
//   quit              end (so does the end of stdin)
// Each answer ends with a line `done <status>` (0: no errors, 1: errors,
// 2: an unknown request) and stdout is flushed, so a client waits for that
// line. Between requests the parsed core stays in memory (compiler.fd
// astcache_load: no artifact read, no parse) and the checked-core stamp
// (D9) skips its bodies; a core changed on disk is parsed again.
// SP18 (Nov 16): also
//   emit <file.fd> [flags]       as `fid emit <file.fd> [flags]`
//   ccompile <file.fd> [flags]   as `fid ccompile <file.fd> [flags]`
// whose arguments stand for argv while they run (inc.fd argv_at); the
// command prints what its one-shot run prints, then `done <status>`. The
// core+runtime Program of an emit stays in memory too (compiler.fd
// astcache_memo_merged), and what a request set (the runtime merged, the
// @cfg target, --time) is reset after it (serve_reset_build_state).
// SP19: `fid serve --port <n>` answers on TCP port n instead of stdin, one
// client at a time, for `fid check` and the LSP (FID_SERVE=<n>, or `fid
// check --server <n>`). The protocol is in compiler.fd ("the client side
// of fid serve"); a client must give the key the server wrote to
// <home>/.fid/serve-<n>.key (the port is open to every interface: the
// key keeps out anyone who cannot read the user's files). Requests over
// the socket: check, check-text <bytes> <path|->, emit, ccompile, quit
// (end the connection), stop (end the server).
// CB2: a check (and check-text) request checks again only the bodies an
// edit since the last clean check can reach, and stops after the borrow
// check; its note says how many ("3 of 7171 bodies checked").
// FID_CB2=off: full checks. FID_SERVE_TIME=1: stage times on stderr.
fn cmd_serve(n: i64, start: i64) -> i64 {
    g_serve_mode = true;
    // SP18: the machine layer's per-function cache (nat_ir.fd CS6/SP7)
    // stays in memory between build requests: no file is read or written,
    // and an emit like the last one replays every unchanged function.
    // A request with --no-cache or --no-fncache builds without it.
    g_nat_fncache_mem = true;
    // SP8: the lowered-IR cache (ir_ser.fd irc_*) in memory too, opt-in
    // until tests/tooling/serve-fncache-check.sh and
    // sp8-edit-rebuild-check.sh pass with it on (FID_IRCACHE=<file> still
    // names a file instead)
    g_irc_mem = env_or_empty("FID_SERVE_IRCACHE") == "1";
    var port: i64 = 0;
    var pi: i64 = start + 1;
    while pi < n {
        if argv_at(pi) == "--port" && pi + 1 < n {
            port = c_str_parse_i64(argv_at(pi + 1));
        } else if str_starts_with(argv_at(pi), "--port=") {
            port = c_str_parse_i64(str_substring_from(argv_at(pi), 7));
        }
        pi = pi + 1;
    }
    if port > 0 {
        modcache_enable();
        return serve_socket(port);
    }
    p_eprint_str("fid serve: one request a line: check <file.fd> | emit <file.fd> [flags] | ccompile <file.fd> [flags] | quit\n");
    // CB2: an imported module unchanged since the last request is not
    // lexed or parsed again (compiler.fd modcache_get)
    modcache_enable();
    var running: bool = true;
    while running {
        var line: str = "";
        var got: bool = false;
        match read_line() {
            Option::Some(l) => {
                line = str_trim(l);
                got = true;
            }
            Option::None => {
            }
        }
        if !got {
            running = false;
        } else if line == "quit" || line == "exit" {
            running = false;
        } else if str_len(line) > 0 {
            var status: i64 = serve_request(line);
            print("done " + int_to_str(status) + "\n");
            p_flush_stdout();
        }
    }
    return 0;
}

// SP19: where a request's answer goes: stdout (stdin mode), or, for a
// socket client, g_serve_buf in protocol lines (compiler.fd: `e <error>`,
// `o <note>`, escaped)
var g_serve_sock: bool = false;
var g_serve_buf: str = "";

/// An error of a request's answer.
fn serve_err(e: str) {
    if g_serve_sock {
        g_serve_buf = g_serve_buf + "e " + serve_escape(e) + "\n";
        return;
    }
    if str_starts_with(e, "error") {
        print(e + "\n");
    } else {
        print("error: " + e + "\n");
    }
}

/// A line of a request's answer that is not an error.
fn serve_note(s: str) {
    if g_serve_sock {
        g_serve_buf = g_serve_buf + "o " + serve_escape(s) + "\n";
        return;
    }
    print(s + "\n");
}

/// The words of a request line (runs of spaces between them).
fn serve_words(line: str) -> Vec<str> {
    var parts: Vec<str> = str_split(line, " ");
    var words: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < parts.len() {
        var w: str = str_trim(parts.get(i));
        if str_len(w) > 0 {
            words.push(w);
        }
        i = i + 1;
    }
    return words;
}

/// One `fid serve` request; the answer on stdout (or g_serve_buf), the
/// status returned.
fn serve_request(line: str) -> i64 {
    if str_starts_with(line, "emit ") || str_starts_with(line, "ccompile ") || str_starts_with(line, "build ") {
        return serve_build(line);
    }
    if !str_starts_with(line, "check ") {
        serve_err("unknown request: " + line + " (check <file.fd> | emit <file.fd> [flags] | ccompile <file.fd> [flags] | quit)");
        return 2;
    }
    var path: str = str_trim(str_slice(line, 6, str_len(line)));
    var source: str = c_file_read(path);
    if str_len(source) == 0 {
        serve_err("could not read file: " + path);
        return 1;
    }
    var t0: i64 = p_clock_now_ms();
    // The dependency list is per build (incremental stamps)
    inc_deps_reset();
    // FID_SERVE_TIME=1: each check's stage times on stderr ([time] lines)
    var timed: bool = env_or_empty("FID_SERVE_TIME") == "1";
    if timed {
        set_time_on();
    }
    // CB2: only the bodies an edit since the last clean check can reach
    // are checked again (compiler.fd cb2_skip_set)
    cb2_request(true);
    var res: ResultProgram = build_program_with_path_borrowck(source, OptStr::Some(path), "on");
    cb2_request(false);
    var ms: i64 = p_clock_now_ms() - t0;
    if timed {
        time_mark("total", t0);
        time_report();
        serve_reset_build_state();
    }
    var extra: str = "";
    if modcache_hits() > 0 {
        // CB2: how many module parses the process has reused so far
        extra = ", " + int_to_str(modcache_hits()) + " module parses reused";
    }
    if str_len(cb2_note()) > 0 {
        extra = extra + ", " + cb2_note();
    }
    match res {
        ResultProgram::Ok(_) => {
            serve_note(path + ": no errors (" + int_to_str(ms) + " ms" + extra + ")");
            return 0;
        }
        ResultProgram::Err(errs) => {
            var ei: i64 = 0;
            while ei < errs.len() {
                serve_err(errs.get(ei));
                ei = ei + 1;
            }
            serve_note(path + ": " + int_to_str(errs.len()) + " error(s) (" + int_to_str(ms) + " ms" + extra + ")");
            return 1;
        }
    }
    return 1;
}

/// SP18: an `emit`/`build`/`ccompile` request: the command handler runs
/// with the request's words as argv ([exe, command, file, flags...]), so it
/// reads the same flags and writes the same files as its one-shot run.
/// What it prints goes to the server's stdout (in socket mode the client
/// gets a note and the status).
fn serve_build(line: str) -> i64 {
    var words: Vec<str> = serve_words(line);
    if words.len() < 2 || str_starts_with(words.get(1), "-") {
        serve_err("usage: " + words.get(0) + " <file.fd> [flags] (the file first)");
        return 2;
    }
    var argv: Vec<str> = Vec::new();
    argv.push(p_argv(0));
    var bmode: str = "on";
    var wi: i64 = 0;
    while wi < words.len() {
        var w: str = words.get(wi);
        // the global flags main() reads before the command
        if w == "--debug" {
            g_cfg_debug = true;
        }
        if w == "--borrowck=off" || w == "--borrowck=warn" || w == "--borrowck=on" {
            bmode = str_substring_from(w, 11);
        }
        // SP18: this request builds without the in-memory function cache
        // (serve_reset_backend_state turns it on again)
        if w == "--no-cache" || w == "--no-fncache" {
            g_nat_fncache_mem = false;
        }
        argv.push(w);
        wi = wi + 1;
    }
    argv_request_set(argv);
    inc_deps_reset();
    // SP8: the request's checks redo only the bodies an edit since the
    // last clean build can reach (compiler.fd cb2_request_build); its
    // time from the request to the written output on stderr
    var t_req: i64 = p_clock_now_ms();
    cb2_request_build(true);
    var status: i64 = 1;
    if words.get(0) == "ccompile" {
        status = cmd_ccompile(argv.len(), 1, bmode, 0);
    } else {
        status = cmd_build(argv.len(), 1, bmode, 0);
    }
    cb2_request_build(false);
    var req_ms: i64 = p_clock_now_ms() - t_req;
    argv_request_clear();
    serve_reset_build_state();
    serve_reset_backend_state();
    p_flush_stdout();
    var req_extra: str = "";
    if str_len(cb2_note()) > 0 {
        req_extra = ", " + cb2_note();
    }
    p_eprint_str("fid serve: " + words.get(0) + " " + words.get(1) + ": " + int_to_str(req_ms) + " ms" + req_extra + "\n");
    if g_serve_sock {
        serve_note(words.get(0) + " " + words.get(1) + ": status " + int_to_str(status) + " (" + int_to_str(req_ms) + " ms" + req_extra + "; its output is on the server's stdout)");
    }
    return status;
}

/// SP19: `fid serve --port <port>`: requests from TCP clients, one
/// connection at a time, each first giving the key written to
/// serve_key_path(port).
fn serve_socket(port: i64) -> i64 {
    var lfd: i64 = p_socket_listen(port);
    if lfd < 0 {
        p_eprint_str("fid serve: cannot listen on port " + int_to_str(port) + "\n");
        return 1;
    }
    var key: str = int_to_str(p_os_random_u64() & 9223372036854775807) + "-" + int_to_str(p_os_random_u64() & 9223372036854775807);
    p_mkdir(serve_key_dir());
    var key_path: str = serve_key_path(port);
    p_file_write(key_path, key + "\n");
    p_eprint_str("fid serve: listening on port " + int_to_str(port) + " (key: " + key_path + "); clients: FID_SERVE=" + int_to_str(port) + "\n");
    var running: bool = true;
    while running {
        var cfd: i64 = p_socket_accept(lfd);
        if cfd < 0 {
            running = false;
        } else {
            running = serve_connection(cfd, key);
            p_socket_close(cfd);
        }
    }
    p_socket_close(lfd);
    p_file_delete(key_path);
    p_eprint_str("fid serve: stopped\n");
    return 0;
}

/// One client's requests until it says `quit` or closes the connection;
/// false when it says `stop` (the server ends).
fn serve_connection(cfd: i64, key: str) -> bool {
    var buf: str = "";
    var authed: bool = false;
    while true {
        var nl: i64 = str_find(buf, "\n");
        while nl < 0 {
            var chunk: str = p_socket_recv_str(cfd);
            if str_len(chunk) == 0 {
                return true;
            }
            buf = buf + chunk;
            nl = str_find(buf, "\n");
        }
        var line: str = str_trim(str_slice(buf, 0, nl));
        buf = str_slice(buf, nl + 1, str_len(buf));
        if !authed {
            if line != "key " + key {
                // no answer: the client checks the file itself
                serve_send_all(cfd, "refused\n");
                return true;
            }
            authed = true;
            continue;
        }
        if line == "quit" || line == "exit" {
            return true;
        }
        if line == "stop" {
            serve_send_all(cfd, "done 0\n");
            return false;
        }
        if str_len(line) == 0 {
            continue;
        }
        g_serve_sock = true;
        g_serve_buf = "";
        var status: i64 = 2;
        if str_starts_with(line, "check-text ") {
            // check-text <bytes> <path|->, then that many bytes of text
            var rest: str = str_trim(str_slice(line, 11, str_len(line)));
            var sp: i64 = str_find(rest, " ");
            var want: i64 = -1;
            var tpath: str = "-";
            if sp > 0 {
                want = c_str_parse_i64(str_slice(rest, 0, sp));
                tpath = str_trim(str_slice(rest, sp + 1, str_len(rest)));
            }
            if want < 0 {
                serve_err("usage: check-text <bytes> <path|->, then the text");
            } else {
                var cut_off: bool = false;
                while str_len(buf) < want && !cut_off {
                    var more: str = p_socket_recv_str(cfd);
                    if str_len(more) == 0 {
                        cut_off = true;
                    } else {
                        buf = buf + more;
                    }
                }
                if cut_off {
                    g_serve_sock = false;
                    return true;
                }
                var text: str = str_slice(buf, 0, want);
                buf = str_slice(buf, want, str_len(buf));
                var opath: OptStr = OptStr::None;
                if tpath != "-" {
                    opath = OptStr::Some(tpath);
                }
                inc_deps_reset();
                // CB2: incremental, as a check request
                cb2_request(true);
                var terrs: Vec<str> = check_text_errors_here(text, opath);
                cb2_request(false);
                var tei: i64 = 0;
                while tei < terrs.len() {
                    serve_err(terrs.get(tei));
                    tei = tei + 1;
                }
                status = 0;
                if terrs.len() > 0 {
                    status = 1;
                }
            }
        } else {
            status = serve_request(line);
        }
        g_serve_sock = false;
        // a log line per request on the server's stderr: its kind and status
        var kind: str = line;
        if str_find(line, " ") > 0 {
            kind = str_slice(line, 0, str_find(line, " "));
        }
        p_eprint_str("fid serve: " + kind + " -> " + int_to_str(status) + "\n");
        if !serve_send_all(cfd, g_serve_buf + "done " + int_to_str(status) + "\n") {
            return true;
        }
        g_serve_buf = "";
    }
    return true;
}

fn cmd_lint(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid lint <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var perf: bool = false;
    var ai: i64 = start + 2;
    while ai < n {
        if p_argv(ai) == "--perf" {
            perf = true;
        }
        ai = ai + 1;
    }
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    // G8.7: Real lint implementation — calls lint_source which runs
    // unused-function and unused-import lints; --perf adds the CP9
    // quadratic-pattern warnings.
    var result: ResultVecStr = lint_source(source, input, perf);
    match result {
        ResultVecStr::Ok(warnings) => {
            if warnings.len() == 0 {
                print("No lint warnings.\n");
                return 0;
            }
            var i: i64 = 0;
            while i < warnings.len() {
                print("warning: ");
                print(warnings.get(i));
                print("\n");
                i = i + 1;
            }
            print(int_to_str(warnings.len()));
            print(" lint warning(s).\n");
            return 0;
        }
        ResultVecStr::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- explain --------------------------------------------------------------
// CP3: `fid explain <file.fd>` — for each function, the runtime checks the
// mid-end proved needless (and which proof removed them) versus the checks
// the backends still emit.
/// TL2: `fid explain-error E044` (also `fid explain E044`): the code's
/// entry of docs/reference/error-codes.md.
fn cmd_explain_error(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid explain-error <code>   (e.g. fid explain-error E044)\n");
        return 1;
    }
    val text: str = explain_error_text(p_argv(start + 1));
    if str_len(text) == 0 {
        p_eprint_str("fid explain-error: '" + p_argv(start + 1) + "' is no error code fid gives (docs/reference/error-codes.md lists them)\n");
        return 1;
    }
    print(text);
    return 0;
}

fn cmd_explain(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid explain <file.fd> [--alloc] [<name-substring>]\n");
        p_eprint_str("       fid explain <file.fd> --stages <function> [--target <triple>]\n");
        p_eprint_str("       fid explain <code>   (an error code, as fid explain-error)\n");
        return 1;
    }
    if (str_starts_with(p_argv(start + 1), "E") || str_starts_with(p_argv(start + 1), "e")) && str_len(errcode_normalize(p_argv(start + 1))) > 0 {
        return cmd_explain_error(n, start);
    }
    // DB7: one function through the native pipeline (cmd_build reads
    // --stages like --explain: the IR after each stage, then the machine
    // code; nothing is written)
    if has_flag(n, start, "--stages") {
        return cmd_build(n, start, "on", 0);
    }
    var input: str = p_argv(start + 1);
    var alloc_mode: bool = false;
    var filt: str = "";
    var ai: i64 = start + 2;
    while ai < n {
        var a: str = p_argv(ai);
        if a == "--alloc" {
            alloc_mode = true;
        } else if str_len(a) > 0 {
            filt = a;
        }
        ai = ai + 1;
    }
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var mod_result: ResultIrModule = lower_to_ir_module_with_path(source, input, "on");
    match mod_result {
        ResultIrModule::Err(errs) => {
            print_errors(errs);
            return 1;
        }
        ResultIrModule::Ok(m) => {
            var lines: Vec<str> = Vec::new();
            if alloc_mode {
                lines = explain_allocs(m, filt);
            } else {
                // ME25/ME23: loops versioned (and, with FID_IROPT_ON=rotate,
                // rotated) as emit leaves them
                var mx: IrModule = m;
                var _nver: i64 = iro_explain_loops(&mut mx);
                lines = explain_checks(mx, filt);
            }
            var i: i64 = 0;
            while i < lines.len() {
                print(lines.get(i));
                print("\n");
                i = i + 1;
            }
            return 0;
        }
    }
    return 1;
}

// --- wasm ----------------------------------------------------------------
// G8.5: Compile a Fides source file to WASM binary (or WAT text with --wat).
fn cmd_wasm(n: i64, start: i64, g_borrowck: str) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid wasm <file.fd> [-o output.wasm] [--wat]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var wat_mode: bool = false;
    var output: str = "";
    var i: i64 = start + 2;
    while i < n {
        var arg: str = p_argv(i);
        if arg == "--wat" {
            wat_mode = true;
        } else if arg == "-o" {
            if i + 1 < n {
                output = p_argv(i + 1);
                i = i + 1;
            } else {
                p_eprint_str("Error: -o requires an argument\n");
                return 1;
            }
        }
        i = i + 1;
    }
    if str_len(output) == 0 {
        // Derive default output from input filename
        var dot: i64 = str_rfind(input, ".");
        var stem: str = input;
        if dot >= 0 {
            stem = str_slice(input, 0, dot);
        }
        if wat_mode {
            output = stem + ".wat";
        } else {
            output = stem + ".wasm";
        }
    }
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    // The Linux runtime and its WASI layer (stdlib/linux_runtime/wasi.fd)
    // merged; only what main reaches lowered (compiler/reach.fd)
    set_native_runtime("linux_runtime");
    g_native_rt_wasi = true;
    g_cfg_os = "wasi";
    g_cfg_arch = "wasm32";
    var result: ResultBytes = ResultBytes::Err(Vec::new());
    var wprog: ResultProgram = build_program_with_path_borrowck(source, OptStr::Some(input), g_borrowck);
    match wprog {
        ResultProgram::Err(werrs) => {
            result = ResultBytes::Err(werrs);
        }
        ResultProgram::Ok(wprogram) => {
            g_lower_keep = lw_keep_set(wprogram);
            var wmod: IrModule = lower(wprogram);
            g_lower_keep = 0;
            if wat_mode {
                var wat_text: str = dump_wat(wmod);
                var wat_bytes: Vec<i64> = Vec::new();
                var wi: i64 = 0;
                while wi < str_len(wat_text) {
                    wat_bytes.push(str_byte_at(wat_text, wi));
                    wi = wi + 1;
                }
                result = ResultBytes::Ok(wat_bytes);
            } else {
                result = wasm_generate(wmod);
            }
        }
    }
    match result {
        ResultBytes::Ok(bytes) => {
            if !write_output_vec(output, bytes) {
                return 1;
            }
            if wat_mode {
                print("Emitted WAT text: ");
                print(output);
                print(" (");
                print(int_to_str(bytes.len()));
                print(" chars)\n");
            } else {
                print("Emitted WASM binary: ");
                print(output);
                print(" (");
                print(int_to_str(bytes.len()));
                print(" bytes)\n");
            }
            return 0;
        }
        ResultBytes::Err(errs) => {
            print_errors(errs);
            return 1;
        }
    }
    return 1;
}

// --- Per-module build (`ccompile --inc`) ---------------------------------
// B1 (inc-roadmap): the IR units of compiler.fd ccompile_inc_prepare. A
// unit whose key (its functions, the signatures it imports, the layouts it
// names, the build's flags) has an object in the store is neither
// generated nor compiled. Otherwise its C is generated from the unit alone
// (incu_unit_c) and compiled, unless that C already has an object (the
// key build_c_units uses: the same C gives the same object); the object
// is then stored under both keys.
// B6: `--seed-store <dir>` (g_seed_store_out) also puts every unit's
// object but main's in <dir>, under its names in the store: the seeded
// store an installed toolchain reads (inc.fd inc_seed_get).
var g_seed_store_out: str = "";
fn build_c_units_ir(cc: str, gcc_opt: str, is_tcc: bool, output: str, libs: str, no_cache: bool, tgt_os: str, zig_cross: bool) -> i64 {
    var stem: str = output;
    if str_ends_with(output, ".exe") {
        stem = str_slice(output, 0, str_len(output) - 4);
    }
    var tu_dir: str = stem + ".fides-tu";
    p_mkdir(tu_dir);
    // BG71: the target's flags, not the host's
    var flags: str = inc_unit_cflags(is_tcc, tgt_os);
    var objs: Vec<str> = Vec::new();
    var stale: Vec<str> = Vec::new();
    var generated: Vec<str> = Vec::new();
    var reused: i64 = 0;
    var seeded: Vec<str> = Vec::new();
    var t_gen: i64 = 0;
    var n_units: i64 = incu_count();
    var i: i64 = 0;
    while i < n_units {
        var name: str = incu_name(i);
        var file_stem: str = int_to_str(i) + "_" + inc_unit_file_name(name);
        var c_path: str = tu_dir + "/" + file_stem + ".c";
        var o_path: str = tu_dir + "/" + file_stem + ".o";
        var art_ir: str = "";
        var have: bool = false;
        if !no_cache {
            art_ir = inc_artifact_path(output, incu_key(i), cc, "u1 " + gcc_opt + flags);
            have = inc_artifact_get(art_ir, o_path);
        }
        if have {
            reused = reused + 1;
        } else {
            var t0: i64 = p_clock_now_ms();
            var code: str = incu_unit_c(i);
            t_gen = t_gen + p_clock_now_ms() - t0;
            if str_len(code) == 0 {
                print("C generation failed for unit " + name + "\n");
                return 1;
            }
            generated.push(name);
            p_file_write(c_path, code);
            var art: str = "";
            var have_c: bool = false;
            if !no_cache {
                art = inc_artifact_path(output, inc_unit_hash(code), cc, "o2 " + gcc_opt + flags);
                have_c = inc_artifact_get(art, o_path);
            }
            if !have_c {
                stale.push(name);
                if p_system(cc + " " + gcc_opt + flags + " -c -o " + shell_word(o_path) + " " + shell_word(c_path)) != 0 {
                    print("C compilation failed: " + c_path + "\n");
                    return 1;
                }
                if str_len(art) > 0 {
                    inc_artifact_put(art, o_path);
                }
            }
            if str_len(art_ir) > 0 {
                inc_artifact_put(art_ir, o_path);
            }
        }
        // B6: the seeded store gets the object under its IR key (main's
        // unit is this program's alone)
        if str_len(g_seed_store_out) > 0 && !incu_is_owner(i) {
            var seed_ir: str = art_ir;
            if str_len(seed_ir) == 0 {
                seed_ir = inc_artifact_path(output, incu_key(i), cc, "u1 " + gcc_opt + flags);
            }
            inc_seed_put(g_seed_store_out, seed_ir, o_path);
            seeded.push(name);
        }
        objs.push(shell_word(o_path));
        i = i + 1;
    }
    if str_len(g_seed_store_out) > 0 {
        // tests/tooling/inc-seed-store-check.sh reads this line
        print("Seeded " + int_to_str(seeded.len()) + " units into " + g_seed_store_out + ": " + str_join(seeded, ", ") + "\n");
    }
    if inc_seed_hits() > 0 {
        print("Took " + int_to_str(inc_seed_hits()) + " of " + int_to_str(n_units) + " units from the seeded store\n");
    }
    // scripts/inc-check.sh and tests/tooling/inc-ir-units-check.sh read
    // this line and the next
    if str_len(env_or_empty("FIDES_INC_DEBUG")) > 0 {
        p_eprint_str("[inc] ir units: " + int_to_str(n_units) + " units, " + int_to_str(generated.len()) + " generated (" + str_join(generated, ", ") + "; " + int_to_str(t_gen) + " ms), " + int_to_str(reused) + " reused by their IR key\n");
    }
    if stale.len() == 0 {
        print("All " + int_to_str(n_units) + " units up to date; linking\n");
    } else {
        print("Compiling " + int_to_str(stale.len()) + " of " + int_to_str(n_units) + " units: " + str_join(stale, ", ") + "\n");
    }
    // BG71: the target's link mode and system libraries (the -z options
    // are ELF-only); BG54: the paths quoted
    var link: str = cc + " " + gcc_opt + flags + " -o " + shell_word(output) + inc_link_mode(is_tcc, tgt_os, zig_cross);
    var system_libs: str = inc_system_libs(cc, tgt_os, zig_cross);
    if p_system(link + " " + str_join(objs, " ") + system_libs + libs) != 0 {
        print("link failed\n");
        return 1;
    }
    return 0;
}

// Each unit compiles to a content-keyed object, reused while its C (modulo
// comments, whitespace and the names of its `static` helpers) does not
// change; then all link.
fn build_c_units(c_code: str, cc: str, gcc_opt: str, is_tcc: bool, output: str, libs: str, no_cache: bool, tgt_os: str, zig_cross: bool) -> i64 {
    // B1: the units ccompile_inc_prepare made (c_code is not the C then)
    if incu_ready() {
        return build_c_units_ir(cc, gcc_opt, is_tcc, output, libs, no_cache, tgt_os, zig_cross);
    }
    var units: Vec<CUnit> = split_c_units(c_code);
    var stem: str = output;
    if str_ends_with(output, ".exe") {
        stem = str_slice(output, 0, str_len(output) - 4);
    }
    var tu_dir: str = stem + ".fides-tu";
    p_mkdir(tu_dir);
    // BG71: the target's flags, not the host's
    var flags: str = inc_unit_cflags(is_tcc, tgt_os);
    var objs: Vec<str> = Vec::new();
    var stale: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < units.len() {
        var unit: CUnit = units.get(i);
        // A module name like `compiler::lexer` is not a file name (`:` is
        // reserved on Windows): the unit's files get a sanitized name,
        // prefixed by the unit's index so two names cannot meet.
        var file_stem: str = int_to_str(i) + "_" + inc_unit_file_name(unit.name);
        var c_path: str = tu_dir + "/" + file_stem + ".c";
        var o_path: str = tu_dir + "/" + file_stem + ".o";
        p_file_write(c_path, unit.code);
        var art: str = "";
        var have: bool = false;
        if !no_cache {
            // inc_unit_hash keeps exported names in the key: an object is
            // reused only by a unit that links under the same names. ("o2":
            // objects stored under the old canonical key are never read.)
            art = inc_artifact_path(output, inc_unit_hash(unit.code), cc, "o2 " + gcc_opt + flags);
            have = inc_artifact_get(art, o_path);
        }
        if !have {
            stale.push(unit.name);
            if p_system(cc + " " + gcc_opt + flags + " -c -o " + shell_word(o_path) + " " + shell_word(c_path)) != 0 {
                print("C compilation failed: " + c_path + "\n");
                return 1;
            }
            if str_len(art) > 0 {
                inc_artifact_put(art, o_path);
            }
        }
        objs.push(shell_word(o_path));
        i = i + 1;
    }
    if stale.len() == 0 {
        print("All " + int_to_str(units.len()) + " units up to date; linking\n");
    } else {
        // Same line as fidesc: which units were rebuilt (B7/C8/C9 checks
        // and scripts/inc-check.sh read it)
        var names: str = "";
        var si: i64 = 0;
        while si < stale.len() {
            if si > 0 {
                names = names + ", ";
            }
            names = names + stale.get(si);
            si = si + 1;
        }
        print("Compiling " + int_to_str(stale.len()) + " of " + int_to_str(units.len()) + " units: " + names + "\n");
    }
    // BG71: the target's link mode and system libraries (the -z options
    // are ELF-only; CB6: no time stamp or PDB in the PE of an --inc build
    // either, inc_system_libs); BG54: the paths quoted
    var link: str = cc + " " + gcc_opt + flags + " -o " + shell_word(output) + inc_link_mode(is_tcc, tgt_os, zig_cross);
    var system_libs: str = inc_system_libs(cc, tgt_os, zig_cross);
    if p_system(link + " " + str_join(objs, " ") + system_libs + libs) != 0 {
        print("link failed\n");
        return 1;
    }
    return 0;
}

// --- PE stack patching ---------------------------------------------------
// Patches SizeOfStackReserve to 256MB and SizeOfStackCommit to 16MB in a
// PE executable. tcc defaults to 1MB stack which is too small for the
// self-hosted compiler's deep recursion (parser, lexer, typechecker).
// This makes the output of `ccompile` work without manual patching.
fn patch_pe_stack(exe_path: str) {
    // PE header layout:
    //   DOS header at offset 0, e_lfanew at offset 0x3C (4 bytes, little-endian)
    //   PE signature at e_lfanew (4 bytes "PE\0\0")
    //   COFF header at e_lfanew + 4 (20 bytes)
    //   Optional header at e_lfanew + 24
    //     SizeOfStackReserve at Optional header offset 0x48 (8 bytes, LE)
    //     SizeOfStackCommit   at Optional header offset 0x50 (8 bytes, LE)
    var bytes: Vec<i64> = p_file_read_bytes(exe_path);
    if bytes.len() < 0x40 {
        p_eprint_str("[main] WARNING: PE stack patching failed: cannot read output.\n");
        return;
    }
    var pe_off: i64 = bytes.get(0x3C) + (bytes.get(0x3D) << 8) + (bytes.get(0x3E) << 16) + (bytes.get(0x3F) << 24);
    var stack_off: i64 = pe_off + 0x18 + 0x48;
    if stack_off + 16 > bytes.len() {
        p_eprint_str("[main] WARNING: PE stack patching failed: not a PE file.\n");
        return;
    }
    pe_put_u64(&mut bytes, stack_off, 268435456);
    // 256MB reserve
    pe_put_u64(&mut bytes, stack_off + 8, 16777216);
    // 16MB commit
    if p_file_write_vec(exe_path, bytes) != 0 {
        p_eprint_str("[main] WARNING: PE stack patching failed: cannot write " + exe_path + ".\n");
        return;
    }
    p_eprint_str("[main] PE stack patched to 256MB.\n");
}

fn pe_put_u64(bytes: &mut Vec<i64>, off: i64, value: i64) {
    var i: i64 = 0;
    while i < 8 {
        bytes.set(off + i, (value >> (i * 8)) & 0xFF);
        i = i + 1;
    }
}

// --- compile (alias for ccompile) -----------------------------------------
// Reference: src/main.rs:289. In the Rust compiler, `compile` produces
// assembly (.s). In the self-hosted compiler, we treat it as an alias for
// ccompile (C codegen + tcc) since we don't have a native asm backend yet.
fn cmd_compile(n: i64, start: i64, g_borrowck: str, g_timeout: i64) -> i64 {
    return cmd_ccompile(n, start, g_borrowck, g_timeout);
}

// The libraries named by `// PLINK: lib` lines of generated C, as
// " -llib" flags (src/main.rs ccompile), except ws2_32.
fn plink_libs(c_code: str) -> str {
    var out: str = "";
    var marker: str = "\n// PLINK: ";
    var rest: str = c_code;
    var at: i64 = str_find(rest, marker);
    while at >= 0 {
        rest = str_slice(rest, at + str_len(marker), str_len(rest));
        var end: i64 = str_find(rest, "\n");
        if end < 0 {
            end = str_len(rest);
        }
        var lib: str = str_trim(str_slice(rest, 0, end));
        if str_len(lib) > 0 && lib != "ws2_32" && !str_starts_with(lib, "cpp:") && !str_contains(out, " -l" + lib + " ") {
            out = out + " -l" + lib + " ";
        }
        rest = str_slice(rest, end, str_len(rest));
        at = str_find(rest, marker);
    }
    return out;
}

// LG16: the C++ files of `link "cpp:<file.cpp>"` (compiler/cparser.fd's
// extern "C" shims of an imported C++ header), compiled with the program
// (-iquote .: a header named relative to the build directory), and the C++
// library: libc++ for zig cc and macOS, libstdc++ otherwise.
fn plink_cpp(c_code: str, cc: str, tgt_os: str) -> str {
    var out: str = "";
    var marker: str = "\n// PLINK: cpp:";
    var rest: str = c_code;
    var at: i64 = str_find(rest, marker);
    while at >= 0 {
        rest = str_slice(rest, at + str_len(marker), str_len(rest));
        var end: i64 = str_find(rest, "\n");
        if end < 0 {
            end = str_len(rest);
        }
        var file: str = str_trim(str_slice(rest, 0, end));
        if str_len(file) > 0 && !str_contains(out, "\"" + file + "\"") {
            out = out + " \"" + file + "\"";
        }
        rest = str_slice(rest, end, str_len(rest));
        at = str_find(rest, marker);
    }
    if str_len(out) == 0 {
        return "";
    }
    var cxx_lib: str = " -lstdc++";
    if str_contains(cc, "zig") || tgt_os == "macos" {
        cxx_lib = " -lc++";
    }
    return " -iquote ." + out + cxx_lib;
}

// --- ccompile ------------------------------------------------------------
// Reference: src/main.rs:1099
// Compiles via C codegen, then links with an available C compiler.
// Flags: -o <output>, --target <triple>, --trace
// --- CB9: link errors as Fides errors -------------------------------------
// complaint-roadmap CB9: a symbol no library provides is reported with the
// line of its `extern "C"` declaration and the library that should have
// provided it, before the linker's own text.

/// The text of `l` after `marker`, up to `close` (to the end of the line
/// when `close` is "" or not there), trimmed; "" when `marker` is not in `l`.
fn link_after(l: str, marker: str, close: str) -> str {
    var at: i64 = str_find(l, marker);
    if at < 0 {
        return "";
    }
    var rest: str = str_slice(l, at + str_len(marker), str_len(l));
    if str_len(close) > 0 {
        var end: i64 = str_find(rest, close);
        if end >= 0 {
            rest = str_slice(rest, 0, end);
        }
    }
    return str_trim(rest);
}

/// CB9: the symbols the linker messages `text` say are missing: GNU ld
/// ("undefined reference to `f'"), lld and zig cc ("undefined symbol: f"),
/// tcc ("undefined symbol 'f'"), MSVC link ("unresolved external symbol
/// f") and the macOS linker (a quoted "_f" under "Undefined symbols").
fn link_missing_symbols(text: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var lines: Vec<str> = str_split(text, "\n");
    var mac_block: bool = false;
    var i: i64 = 0;
    while i < lines.len() {
        var l: str = str_trim(lines.get(i));
        var mac: bool = false;
        var sym: str = link_after(l, "undefined reference to `", "'");
        if str_len(sym) == 0 {
            sym = link_after(l, "undefined symbol: ", "");
        }
        if str_len(sym) == 0 {
            sym = link_after(l, "undefined symbol '", "'");
        }
        if str_len(sym) == 0 {
            sym = link_after(l, "unresolved external symbol ", " ");
        }
        if str_len(sym) == 0 && mac_block && str_starts_with(l, "\"") {
            sym = link_after(l, "\"", "\"");
            mac = true;
        }
        if str_contains(l, "Undefined symbols for architecture") {
            mac_block = true;
        }
        // lld-link names an import as `__declspec(dllimport) f`, MSVC as
        // `__imp_f`; the macOS linker puts `_` before every C name
        sym = str_replace(sym, "__declspec(dllimport) ", "");
        if str_starts_with(sym, "__imp_") {
            sym = str_slice(sym, 6, str_len(sym));
        }
        if mac && str_starts_with(sym, "_") {
            sym = str_slice(sym, 1, str_len(sym));
        }
        if str_len(sym) > 0 && !str_vec_contains(out, sym) {
            out.push(sym);
        }
        i = i + 1;
    }
    return out;
}

/// CB9: where a source declares a C function: the line (1-based, 0 when
/// it does not) and the library its `extern "C" link "lib"` block names.
struct LinkDecl {
    line: i64,
    lib: str,
}

/// CB9: the `extern "C"` declaration of `sym` in the text `source`.
fn link_decl_in(source: str, sym: str) -> LinkDecl {
    var lines: Vec<str> = str_split(source, "\n");
    var cur_lib: str = "";
    var in_extern: bool = false;
    var li: i64 = 0;
    while li < lines.len() {
        var t: str = str_trim(lines.get(li));
        if str_starts_with(t, "extern \"C\"") {
            cur_lib = link_after(t, "link \"", "\"");
            in_extern = true;
        } else if in_extern && str_starts_with(t, "}") {
            in_extern = false;
        }
        if in_extern && (str_contains(t, "fn " + sym + "(") || str_contains(t, "fn " + sym + " (") || str_contains(t, "fn " + sym + " as ")) {
            return LinkDecl {
                line: li + 1, lib: cur_lib
            };
        }
        li = li + 1;
    }
    return LinkDecl {
        line: 0, lib: ""
    };
}

/// CB9: a Fides error for each symbol the linker found missing (none when
/// the messages `text` name none): where `source` (the file `input`) or a
/// module it imports declares it, in which `extern "C" link "lib"` block,
/// and what to do.
fn link_error_report(text: str, source: str, input: str) -> str {
    var syms: Vec<str> = link_missing_symbols(text);
    if syms.len() == 0 {
        return "";
    }
    var out: str = "";
    var si: i64 = 0;
    while si < syms.len() {
        var sym: str = syms.get(si);
        var found: LinkDecl = link_decl_in(source, sym);
        var decl_line: i64 = found.line;
        var lib: str = found.lib;
        var decl_file: str = input;
        // Not in the built file: the imported modules' files (recorded by
        // the import loops of compiler.fd), first declaration wins
        var mi: i64 = 0;
        while decl_line == 0 && mi < module_file_count() {
            var mpath: str = module_file_path_at(mi);
            match read_file(mpath) {
                Option::Some(msrc) => {
                    var mfound: LinkDecl = link_decl_in(msrc, sym);
                    if mfound.line > 0 {
                        decl_line = mfound.line;
                        lib = mfound.lib;
                        decl_file = mpath;
                    }
                }
                Option::None => {
                }
            }
            mi = mi + 1;
        }
        if decl_line > 0 {
            out = out + "error: link: the C function '" + sym + "' is not in any library the program links\n";
            if str_len(lib) > 0 {
                out = out + "  --> " + decl_file + ":" + int_to_str(decl_line) + ": declared in extern \"C\" link \"" + lib + "\"\n";
                out = out + "    Fix: install the C library '" + lib + "' (it is linked as -l" + lib + "), or check that it exports '" + sym + "' under that name.\n";
            } else {
                out = out + "  --> " + decl_file + ":" + int_to_str(decl_line) + ": declared in an extern \"C\" block that names no library\n";
                out = out + "    Fix: name the library that provides it: extern \"C\" link \"<library>\" { ... }.\n";
            }
        } else {
            out = out + "error: link: '" + sym + "' is not defined in the program or in a library it links\n";
            out = out + "    (neither " + input + " nor a module it imports declares it in an extern \"C\" block: the runtime refers to it)\n";
        }
        si = si + 1;
    }
    return out;
}

fn cmd_ccompile(n: i64, start: i64, g_borrowck: str, _g_timeout: i64) -> i64 {
    // SP2: `--time`, the per-stage table, with the C compiler as a row
    var t_start: i64 = p_clock_now_ms();
    if has_flag(n, start, "--time") {
        set_time_on();
    }
    if start + 2 > n {
        print("Usage: fid ccompile <file.fd> [-o output.exe] [--target <triple>] [--trace] [--leaks] [--mem] [--checked-alloc] [--max-mem <bytes[K|M|G]>] [--cpu-limit <seconds>]\n");
        return 1;
    }

    var input: str = argv_at(start + 1);
    var output: str = find_output_arg(n, start, "a.out");

    // --target <triple> for cross-compilation (TL6: `linux-arm64` and the
    // like read as `aarch64-linux`)
    var target: str = normalize_target(get_flag_value(n, start, "--target", ""));
    // The OS the executable is for: the target's, else the host's
    var tgt_os: str = cross_target_os(target);
    // L2B: the fat binary comes from the machine layer, not through C
    if is_universal_target(target) {
        print("Error: --target universal (a macOS fat binary) is built by `fid emit|build <file> --target universal` (machine layer, no C compiler); ccompile takes one slice: --target x86_64-macos or aarch64-macos\n");
        return 1;
    }
    if str_len(target) > 0 && tgt_os == "" {
        print("Unknown --target '" + target + "': use <arch>-<os>, e.g. aarch64-linux, riscv64-linux, x86_64-macos, aarch64-macos, x86_64-windows, aarch64-windows, x86_64-freebsd, wasm32-wasi\n");
        return 1;
    }
    if tgt_os == "" {
        tgt_os = host_os();
    }
    if tgt_os == "windows" {
        output = ensure_exe_extension(output);
    }
    if tgt_os == "wasi" && !str_ends_with(output, ".wasm") {
        output = output + ".wasm";
    }
    // @cfg decides by the target (compiler.fd apply_cfg_filter)
    if str_len(target) > 0 {
        g_cfg_os = tgt_os;
        g_cfg_arch = cross_target_arch(target);
    }
    // OP20: `--cpu <name>` on the C path: the machine layer's names
    // (nat_cpu_check), given to the C compiler as -march (cl: /arch)
    var cc_cpu: str = get_flag_value(n, start, "--cpu", "");
    var cc_march: str = "";
    if str_len(cc_cpu) > 0 {
        var cpu_tgt: str = target;
        if str_len(cpu_tgt) == 0 {
            cpu_tgt = host_native_target();
        }
        var cpu_arch: i64 = nat_target_arch(cross_target_arch(cpu_tgt));
        if cpu_arch == 0 {
            print("Error: --cpu: no CPU names for target '" + cpu_tgt + "'\n");
            return 1;
        }
        var cc_cpu_err: str = nat_cpu_check(cpu_arch, cc_cpu);
        if str_len(cc_cpu_err) > 0 {
            print(cc_cpu_err + "\n");
            return 1;
        }
        if cc_cpu != "baseline" {
            cc_march = cc_cpu;
        }
        // GCC and clang spell the first AArch64 level armv8-a
        if cc_march == "armv8.0-a" {
            cc_march = "armv8-a";
        }
    }
    // --trace: trace C compilation
    var trace: bool = has_flag(n, start, "--trace");

    // Report global flags
    if g_borrowck != "on" {
        p_eprint_str("[main] borrowck mode: ");
        p_eprint_str(g_borrowck);
        p_eprint_str("\n");
    }
    // G8.2: borrowck mode is passed through the pipeline via parameter

    p_eprint_str("[main] Reading source file: ");
    p_eprint_str(input);
    p_eprint_str("\n");
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("[main] FAILED: could not read file\n");
        print("Error: could not read file: ");
        print(input);
        print("\n");
        return 1;
    }
    // F32: `--entry <handler>`: the handler is the entry point
    source = entry_source_for(n, start, source, input);
    if str_len(source) == 0 {
        return 1;
    }
    p_eprint_str("[main] Source read ok. Compiling...\n");

    if trace {
        p_eprint_str("[main] C compilation tracing enabled\n");
    }

    // Incremental build: skip all work when no input changed.
    var no_cache: bool = has_flag(n, start, "--no-cache") || str_len(env_or_empty("FIDES_NO_CACHE")) > 0;
    var stamp_path: str = output + ".fides-stamp";
    var build_key: i64 = inc_build_key("ccompile", n, start);
    var stamp: IncStamp = inc_stamp_read(stamp_path);
    if no_cache {
        stamp.ok = false;
    }
    if inc_up_to_date(stamp, build_key, output) {
        print(output + " is up to date\n");
        return 0;
    }
    inc_deps_reset();

    var unit_build: bool = has_flag(n, start, "--inc");
    if unit_build {
        set_c_unit_marks(true);
    }
    // B6: the seeded store beside the compiler (<fid dir>/cache), and
    // `--seed-store <dir>`: fill one (installer/build-installer.sh)
    inc_set_seed_dir(fid_seed_store_dir());
    g_seed_store_out = get_flag_value(n, start, "--seed-store", "");
    if str_len(g_seed_store_out) > 0 && !unit_build {
        print("--seed-store needs --inc\n");
        return 1;
    }
    // rm-L5A-dev-deps: `fid test` builds with the dev pacts in view
    if has_flag(n, start, "--dev-deps") {
        set_ark_dev_visible(true);
    }
    // SL13: `fid test --fuzz` builds its harness with block coverage
    // (compiler.fd fuzz_cov_program); --fuzz-cov-std covers stdlib modules
    if has_flag(n, start, "--fuzz-cov") || has_flag(n, start, "--fuzz-cov-std") {
        set_fuzz_cov(true, has_flag(n, start, "--fuzz-cov-std"));
    }
    // CO2: a built program reads FIDES_TRACE when it runs
    if has_flag(n, start, "--trace-spans") {
        p_eprint_str("note: --trace-spans: run the program with FIDES_TRACE=1 to print its trace spans\n");
    }
    if has_flag(n, start, "--profile") {
        set_c_profile(true);
    }
    if has_flag(n, start, "--leaks") {
        set_c_leaks(true);
    }
    if has_flag(n, start, "--mem") {
        set_c_mem_profile(true);
    }
    if has_flag(n, start, "--leaks") || has_flag(n, start, "--mem") {
        set_c_mem_source(input, source);
    }
    if has_flag(n, start, "--checked-alloc") {
        set_c_checked_alloc(true);
    }
    // TL5, CE8: -g: #line back to the .fd source, C debug information, and
    // a panic prints the failing frame's values (codegen_c.fd)
    if has_flag(n, start, "-g") {
        set_c_debug_info(input, source, CGen_c_file_for(output));
    }
    // CI7: `--lib`: a shared library and a C header of the program's
    // exported functions instead of an executable (ccompile_lib)
    if has_flag(n, start, "--lib") {
        return ccompile_lib(n, start, source, input, g_borrowck, output);
    }
    crash_stage("front end, lowering and C generation");
    // inc-roadmap B1: `--inc` generates C per IrUnit, each unit only when
    // its key has no object (compiler.fd ccompile_inc_prepare; c_code is
    // then a short text naming the units' keys and libraries).
    // FIDES_INC_IR=off: the whole program's C, cut per module.
    incu_reset();
    var result: ResultStr = ResultStr::Err(Vec::new());
    if unit_build && incu_on() {
        // B6: the units' keys leave out the input's and output's names
        // (a unit of the stdlib keys the same in every program) unless
        // the C holds them
        var keep_paths: bool = has_flag(n, start, "-g") || has_flag(n, start, "--leaks") || has_flag(n, start, "--mem");
        result = ccompile_inc_prepare(source, input, g_borrowck, inc_unit_build_key("ccompile", n, start, keep_paths));
    } else {
        result = ccompile_source_with_path(source, input, g_borrowck);
    }
    match result {
        ResultStr::Ok(c_code) => {
            var c_hash: i64 = hash_source(c_code);
            p_eprint_str("[main] C code generated. Writing to file...\n");
            // Derive the C source path from the executable path
            var c_file: str = "";
            if str_ends_with(output, ".exe") {
                c_file = str_replace(output, ".exe", ".c");
            } else if str_ends_with(output, ".wasm") {
                c_file = c_str_substr(output, 0, str_len(output) - 5) + ".c";
            } else {
                c_file = output + ".c";
            }
            // (B1: the units' C goes to <output>.fides-tu, unit by unit)
            if !incu_ready() {
                p_file_write(c_file, c_code);
            }
            p_eprint_str("[main] C file written. ");
            // Same C as the build that produced the output: no need to run
            // the C compiler again.
            if inc_c_unchanged(stamp, build_key, output, c_hash) {
                inc_stamp_commit(stamp_path, build_key, c_hash, input, output);
                print("C translation unchanged; " + output + " is up to date\n");
                return 0;
            }

            // Find a C compiler: check CC env var, then gcc, clang, tcc
            var cc: str = env_or_empty("CC");
            if str_len(cc) == 0 {
                if is_posix_host() {
                    // Linux: check gcc, clang, cc, tcc
                    if p_system("which gcc >/dev/null 2>&1") == 0 {
                        cc = "gcc";
                    } else {
                        if p_system("which clang >/dev/null 2>&1") == 0 {
                            cc = "clang";
                        } else {
                            if p_system("which cc >/dev/null 2>&1") == 0 {
                                cc = "cc";
                            } else {
                                if p_system("which tcc >/dev/null 2>&1") == 0 {
                                    cc = "tcc";
                                } else {
                                    cc = "gcc";
                                }
                            }
                        }
                    }
                } else {
                    // Windows: check gcc, clang, tcc, cl.exe
                    if p_system("gcc --version >nul 2>&1") == 0 {
                        cc = "gcc";
                    } else {
                        if p_system("clang --version >nul 2>&1") == 0 {
                            cc = "clang";
                        } else {
                            if p_system("tcc --version >nul 2>&1") == 0 {
                                cc = "tcc";
                            } else {
                                if p_system("where cl.exe >nul 2>&1") == 0 {
                                    cc = "cl.exe";
                                } else {
                                    cc = "tcc";
                                }
                            }
                        }
                    }
                }
            }

            // If --target is specified: zig cc cross-compiles to every target
            // from any host; else try a cross-compiler prefix
            var zig_cross: bool = false;
            if str_len(target) > 0 && cross_zig_triple(target) != "" {
                var have_zig: bool = str_contains(cc, "zig");
                if !have_zig && str_len(env_or_empty("CC")) == 0 {
                    if is_posix_host() {
                        have_zig = p_system("which zig >/dev/null 2>&1") == 0;
                    } else {
                        have_zig = p_system("zig version >nul 2>&1") == 0;
                    }
                }
                if have_zig {
                    cc = "zig cc -target " + cross_zig_triple(target);
                    zig_cross = true;
                }
            }
            if str_len(target) > 0 && !zig_cross {
                var cross_gcc: str = target + "-gcc";
                var cross_clang: str = target + "-clang";
                if is_posix_host() {
                    if p_system("which " + cross_gcc + " >/dev/null 2>&1") == 0 {
                        cc = cross_gcc;
                    } else {
                        if p_system("which " + cross_clang + " >/dev/null 2>&1") == 0 {
                            cc = cross_clang;
                        } else {
                            p_eprint_str("Warning: cross-compiler for target '");
                            p_eprint_str(target);
                            p_eprint_str("' not found, falling back to ");
                            p_eprint_str(cc);
                            p_eprint_str("\n");
                            p_eprint_str("note: ccompile --target needs zig (it ships every target's C library); `fid build " + "--target " + target + "` needs no C compiler (docs/reference/cross-compilation.md)\n");
                        }
                    }
                } else {
                    if p_system(cross_gcc + " --version >nul 2>&1") == 0 {
                        cc = cross_gcc;
                    } else {
                        if p_system(cross_clang + " --version >nul 2>&1") == 0 {
                            cc = cross_clang;
                        } else {
                            p_eprint_str("Warning: cross-compiler for target '");
                            p_eprint_str(target);
                            p_eprint_str("' not found, falling back to ");
                            p_eprint_str(cc);
                            p_eprint_str("\n");
                            p_eprint_str("note: ccompile --target needs zig (it ships every target's C library); `fid build " + "--target " + target + "` needs no C compiler (docs/reference/cross-compilation.md)\n");
                        }
                    }
                }
            }

            p_eprint_str("Running ");
            p_eprint_str(cc);
            p_eprint_str("...\n");

            // Build the compile command
            // tcc needs different flags than gcc/clang
            var is_tcc: bool = cc == "tcc" || str_ends_with(cc, "tcc.exe");
            var is_cl: bool = str_ends_with(cc, "cl.exe") || cc == "cl";

            // Detect SDL2 usage: if source contains "use sdl;", add SDL2 link flags.
            // Also detect "use image;" and "use font;" which need SDL2_image / stb.
            // Also detect "use gl;" which needs OpenGL.
            // Also detect "use net;" which needs socket libs.
            var extra_libs: str = "";
            if str_starts_with(source, "use sdl;") || str_contains(source, "\nuse sdl;") {
                if is_posix_host() {
                    extra_libs = extra_libs + " -lSDL2 -lSDL2_image -lSDL2_mixer";
                } else {
                    extra_libs = extra_libs + " -lSDL2 -lSDL2_image -lSDL2_mixer -lglu32 -lopengl32";
                }
                p_eprint_str("[main] Detected SDL2 usage, adding link flags\n");
            }
            if str_starts_with(source, "use gl;") || str_contains(source, "\nuse gl;") {
                if is_posix_host() {
                    extra_libs = extra_libs + " -lGL -lGLU";
                } else {
                    extra_libs = extra_libs + " -lopengl32 -lglu32";
                }
                p_eprint_str("[main] Detected OpenGL usage, adding link flags\n");
            }
            if str_starts_with(source, "use net;") || str_contains(source, "\nuse net;") {
                if tgt_os != "windows" {  // sockets are in libc on Linux, no extra lib needed
                } else {
                    extra_libs = extra_libs + " -lws2_32";
                }
                p_eprint_str("[main] Detected net usage, adding link flags\n");
            }
            // `extern "C" link "lib"` blocks: the C carries `// PLINK: lib`
            // (ws2_32 is in the _WIN32 header block and added above).
            // FID_LIB_PATH (';'-separated on Windows, ':' elsewhere): where
            // a prebuilt pact's `link "<pkg>"` library is, as -L<dir>; an
            // ELF finds it beside itself at run time ($ORIGIN rpath).
            val lib_path_env: str = env_or_empty("FID_LIB_PATH");
            if str_len(lib_path_env) > 0 {
                var lp_sep: str = ":";
                if !is_posix_host() {
                    lp_sep = ";";
                }
                val lp_dirs: Vec<str> = str_split(lib_path_env, lp_sep);
                var lpi: i64 = 0;
                while lpi < lp_dirs.len() {
                    val lp_dir: str = str_trim(lp_dirs.get(lpi));
                    if str_len(lp_dir) > 0 {
                        extra_libs = extra_libs + " -L\"" + lp_dir + "\"";
                    }
                    lpi = lpi + 1;
                }
                if tgt_os == "linux" {
                    if is_posix_host() {
                        extra_libs = extra_libs + " '-Wl,-rpath,$ORIGIN'";
                    } else {
                        extra_libs = extra_libs + " -Wl,-rpath,$ORIGIN";
                    }
                }
                // L5E: a Mach-O finds a prebuilt dylib beside itself
                if tgt_os == "macos" {
                    extra_libs = extra_libs + " -Wl,-rpath,@loader_path";
                }
            }
            extra_libs = extra_libs + plink_libs(c_code);
            // LG16: the C++ shims of an imported C++ header
            var cpp_link: str = plink_cpp(c_code, cc, tgt_os);
            if str_len(cpp_link) > 0 && (is_tcc || is_cl) {
                print("Error: this program calls C++ (an imported C++ header): build it with zig cc, clang or gcc (CC=\"zig cc\"), not " + cc + "\n");
                return 1;
            }
            extra_libs = extra_libs + cpp_link;
            // glibc before 2.34 has dlopen in libdl; the C runtime calls it
            // only for programs that use p_dl_load/p_dl_find/p_dl_unload
            if tgt_os == "linux" && str_contains(c_code, "p_dl_load(") {
                extra_libs = extra_libs + " -ldl";
            }

            // C optimization level: --cc-opt, else FIDES_CC_OPT, else -O2.
            // gcc and clang need tens of minutes for a very large
            // translation unit at -O1/-O2 (the compiler itself is ~35 MB of
            // C: 26 min at -O2, 40 s at -O0), so one gets -O0.
            var cc_opt: str = get_flag_value(n, start, "--cc-opt", "");
            // --debug: no C optimization (fast to build, easy to debug); --release: -O2
            if str_len(cc_opt) == 0 && has_flag(n, start, "--debug") {
                cc_opt = "0";
            }
            if str_len(cc_opt) == 0 && has_flag(n, start, "--release") {
                cc_opt = "2";
            }
            if str_len(cc_opt) == 0 {
                cc_opt = env_or_empty("FIDES_CC_OPT");
            }
            if str_len(cc_opt) == 0 {
                var c_size: i64 = str_len(c_code);
                if incu_ready() {
                    // B1: no C yet; the units' size estimated from the IR
                    c_size = incu_c_estimate();
                }
                if c_size > 16777216 {
                    print("Large program (" + int_to_str(c_size / 1048576) + " MB of C): compiling with -O0 (use --cc-opt 2 for -O2)\n");
                    cc_opt = "0";
                } else {
                    cc_opt = "2";
                }
            }
            if cc_opt != "0" && cc_opt != "1" && cc_opt != "2" && cc_opt != "3" && cc_opt != "s" {
                print("Invalid --cc-opt '" + cc_opt + "': use 0, 1, 2, 3 or s\n");
                return 1;
            }
            // --max-mem <bytes[K|M|G]> / --cpu-limit <seconds>: limits built
            // into the program (codegen_c.fd P_LIM_MEM_DEFAULT,
            // P_LIM_CPU_DEFAULT_MS); FID_MEM_LIMIT / FID_CPU_LIMIT at run
            // time still win. -D works for gcc, clang, zig cc, tcc and cl.
            var lim_defs: str = "";
            var max_mem_arg: str = get_flag_value(n, start, "--max-mem", "");
            if str_len(max_mem_arg) > 0 {
                val mem_bytes: i64 = lim_parse_bytes(max_mem_arg);
                if mem_bytes <= 0 {
                    print("Invalid --max-mem '" + max_mem_arg + "': use <bytes>[K|M|G], e.g. 64M\n");
                    return 1;
                }
                lim_defs = lim_defs + " -DP_LIM_MEM_DEFAULT=" + int_to_str(mem_bytes);
            }
            var cpu_lim_arg: str = get_flag_value(n, start, "--cpu-limit", "");
            if str_len(cpu_lim_arg) > 0 {
                val cpu_ms: i64 = lim_parse_ms(cpu_lim_arg);
                if cpu_ms <= 0 {
                    print("Invalid --cpu-limit '" + cpu_lim_arg + "': use seconds, e.g. 2 or 0.5\n");
                    return 1;
                }
                lim_defs = lim_defs + " -DP_LIM_CPU_DEFAULT_MS=" + int_to_str(cpu_ms);
            }
            var gcc_opt: str = "-O" + cc_opt;
            var cl_opt: str = "/O2";
            if cc_opt == "0" {
                cl_opt = "/Od";
            }
            if cc_opt == "1" || cc_opt == "s" {
                cl_opt = "/O1";
            }
            // OP20: the target CPU of --cpu (checked above)
            if str_len(cc_march) > 0 {
                if is_cl {
                    if cc_march == "x86-64-v3" {
                        cl_opt = cl_opt + " /arch:AVX2";
                    } else if cc_march == "x86-64-v4" {
                        cl_opt = cl_opt + " /arch:AVX512";
                    }
                } else if is_tcc {
                    p_eprint_str("note: --cpu " + cc_march + ": tcc takes no target CPU\n");
                } else if !(cc_march == "native" && zig_cross) {
                    // 2g.111: zig cc spells the CPU its own way
                    if str_contains(cc, "zig") {
                        gcc_opt = gcc_opt + " -march=" + zig_march_name(cc_march);
                    } else {
                        gcc_opt = gcc_opt + " -march=" + cc_march;
                    }
                }
            }
            // the --max-mem / --cpu-limit defaults (above)
            gcc_opt = gcc_opt + lim_defs;
            cl_opt = cl_opt + lim_defs;

            // --inc: one translation unit per module, each compiled to a
            // cached object, then linked.
            if unit_build {
                if is_cl {
                    print("--inc is not supported with cl.exe yet; use gcc/clang/zig cc\n");
                    return 1;
                }
                // BG71: built and linked for --target (tgt_os), not the host
                var rc: i64 = build_c_units(c_code, cc, gcc_opt, is_tcc, output, extra_libs, no_cache, tgt_os, zig_cross);
                if rc != 0 {
                    return rc;
                }
                // a PE only (an ELF's bytes at the PE header's place are code)
                if tgt_os == "windows" && !is_posix_host() {
                    patch_pe_stack(output);
                }
                inc_stamp_commit(stamp_path, build_key, c_hash, input, output);
                print("Built native executable: " + output + "\n");
                return 0;
            }

            // A build of the same canonical program with the same toolchain
            // and flags reuses its binary: no C compile.
            var art_path: str = "";
            if !no_cache {
                // OP20: a --cpu build is another binary (the key without
                // one stays as it was)
                var art_cpu: str = "";
                if str_len(cc_march) > 0 {
                    art_cpu = " march=" + cc_march;
                }
                art_path = inc_artifact_path(output, inc_canon_hash(c_code), cc, cc_opt + " " + target + extra_libs + " " + env_or_empty("FIDES_CFLAGS") + art_cpu + lim_defs);
                if inc_artifact_get(art_path, output) {
                    // BG36: the copy is a new file without the execute bit
                    // (inc_artifact_get writes bytes); the C compiler set it
                    // on the original ("Permission denied" on the second
                    // `fid run --leaks`)
                    if is_posix_host() {
                        p_system("chmod +x " + shell_word(output) + " 2>/dev/null");
                    }
                    inc_stamp_commit(stamp_path, build_key, c_hash, input, output);
                    print("Reused cached artifact: " + output + "\n");
                    return 0;
                }
            }

            var cc_cmd: str = "";
            if is_cl {
                // cl.exe: /O2 /Fe:output file.c
                // TL5: with -g, /Zi for the compile and /DEBUG for the link
                // (c_debug_clflags, as c_debug_cflags for gcc/clang)
                cc_cmd = cc + " " + cl_opt + c_debug_clflags() + " /nologo /Fe:" + shell_word(output) + " " + shell_word(c_file);
                if str_len(c_debug_clflags()) > 0 {
                    cc_cmd = cc_cmd + " /link /DEBUG";
                }
                // VF12 (R1): no time stamps in the objects or the PE
                if repro_on() {
                    cc_cmd = cc + " " + cl_opt + c_debug_clflags() + " /nologo /Brepro /Fe:" + shell_word(output) + " " + shell_word(c_file) + " /link /Brepro";
                    if str_len(c_debug_clflags()) > 0 {
                        cc_cmd = cc_cmd + " /DEBUG";
                    }
                }
            } else {
                if is_tcc {
                    // tcc: minimal flags
                    if tgt_os != "windows" {
                        cc_cmd = cc + " " + gcc_opt + " -w -o " + shell_word(output) + " " + shell_word(c_file) + " -lm" + extra_libs;
                    } else {
                        cc_cmd = cc + " " + gcc_opt + " -w -o " + shell_word(output) + " " + shell_word(c_file) + " -lws2_32" + extra_libs;
                    }
                } else {
                    // gcc/clang: -O2 + hardening flags (as src/main.rs).
                    // -fno-strict-aliasing: the generated code type-puns
                    // through pointer casts; -fno-strict-overflow: wrapping
                    // arithmetic must not be assumed away.
                    // A Linux cross build is a static executable (musl): it
                    // runs anywhere, also under qemu-user
                    var link_mode: str = " -pie";
                    if zig_cross && tgt_os == "linux" {
                        link_mode = " -static";
                    }
                    var hardening: str = " -fstack-protector-strong -fPIE";
                    // WebAssembly: no stack protector or PIE; WASI's libc
                    // emulates mmap, signal(), clocks and getpid on request
                    if tgt_os == "wasi" {
                        link_mode = "";
                        hardening = " -D_WASI_EMULATED_MMAN -D_WASI_EMULATED_SIGNAL -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_GETPID";
                    }
                    var cc_flags: str = " " + gcc_opt + " -w -Wno-int-conversion -Wno-incompatible-pointer-types" + hardening + " -fno-strict-overflow -fno-strict-aliasing -o " + shell_word(output) + " " + shell_word(c_file) + link_mode;
                    // FIDES_CFLAGS: extra C compiler flags, e.g. the
                    // sanitizers of scripts/sanitize.sh (release M8)
                    var user_cflags: str = env_or_empty("FIDES_CFLAGS");
                    if str_len(user_cflags) > 0 {
                        cc_flags = " " + user_cflags + cc_flags;
                    }
                    // TL5: -g
                    cc_flags = cc_flags + c_debug_cflags();
                    // zig cc turns on its UB sanitizer at -O0; the generated
                    // C type-puns by design (string headers read in front of
                    // unaligned literals), so it would trap on correct
                    // programs. FIDES_CFLAGS asks for sanitizers explicitly.
                    if str_contains(cc, "zig") && !str_contains(user_cflags, "sanitize") {
                        cc_flags = " -fno-sanitize=undefined" + cc_flags;
                    }
                    // The -z options are ELF-only
                    if tgt_os == "linux" || tgt_os == "freebsd" {
                        cc_flags = cc_flags + " -Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack";
                    }
                    if tgt_os == "linux" {
                        var unwind: str = zig_unwind(cc);
                        if zig_cross {
                            unwind = " -lunwind";
                        }
                        cc_cmd = cc + cc_flags + " -lm -lpthread" + unwind + extra_libs;
                    } else if tgt_os == "freebsd" {
                        // PL3: panic traces need _Unwind_Backtrace: zig
                        // links its libunwind; FreeBSD's cc links libgcc_s
                        var fb_unwind: str = "";
                        if str_contains(cc, "zig") {
                            fb_unwind = " -lunwind";
                        }
                        cc_cmd = cc + cc_flags + " -lm -lpthread" + fb_unwind + extra_libs;
                    } else if tgt_os == "macos" {
                        cc_cmd = cc + cc_flags + " -lm -lpthread" + extra_libs;
                    } else if tgt_os == "wasi" {
                        cc_cmd = cc + cc_flags + " -lm -lwasi-emulated-mman -lwasi-emulated-signal -lwasi-emulated-process-clocks -lwasi-emulated-getpid" + extra_libs;
                    } else {
                        cc_cmd = cc + cc_flags + repro_win_flags(cc, has_flag(n, start, "--debug") || has_flag(n, start, "-g")) + " -lws2_32" + extra_libs;
                    }
                }
            }
            // VF12 (R1): SOURCE_DATE_EPOCH=0 for the C compiler and linker
            // (zig cc and lld take the PE time stamp from it), unless set
            cc_cmd = repro_env_prefix() + cc_cmd;
            crash_stage("C compiler");
            var t_cc: i64 = p_clock_now_ms();
            // CB9: the C compiler's and linker's messages are kept, so a
            // symbol no library provides is reported as a Fides error
            // with the line of its declaration (link_error_report)
            var cc_err: str = c_file + ".err";
            var ret: i64 = p_system(cc_cmd + " 2> " + shell_word(cc_err));
            time_mark("C compiler", t_cc);
            var cc_err_text: str = "";
            match read_file(cc_err) {
                Option::Some(et) => {
                    cc_err_text = et;
                }
                Option::None => {
                }
            }
            p_file_delete(cc_err);

            if ret != 0 {
                var link_report: str = link_error_report(cc_err_text, source, input);
                if str_len(link_report) > 0 {
                    p_eprint_str(link_report);
                }
                p_eprint_str(cc_err_text);
                print("C compilation failed\n");
                p_eprint_str("C source left at: ");
                p_eprint_str(c_file);
                p_eprint_str("\n");
                return 1;
            }
            if str_len(cc_err_text) > 0 {
                p_eprint_str(cc_err_text);
            }

            // Patch PE stack to 256MB (tcc defaults to 1MB, which is too
            // small for the self-hosted compiler's deep recursion).
            // Only needed on Windows with PE executables.
            if tgt_os == "windows" && !is_posix_host() {
                patch_pe_stack(output);
            }
            if str_len(art_path) > 0 {
                inc_artifact_put(art_path, output);
            }
            inc_stamp_commit(stamp_path, build_key, c_hash, input, output);
            time_mark("total", t_start);
            time_report();

            print("Built native executable: ");
            print(output);
            print("\n");
            return 0;
        }
        ResultStr::Err(errs) => {
            print("Compilation errors:\n");
            var ei: i64 = 0;
            while ei < errs.len() {
                print(errs.get(ei));
                print("\n");
                ei = ei + 1;
            }
            return 1;
        }
    }
    return 1;
}

// --- build (PE emitter) --------------------------------------------------
// Reference: src/main.rs:151
// Flags: -o <output>, --target <triple>, --no-opt, --lto, --caps <list>
// --- cmd_build_x86 -------------------------------------------------------
// Build a Linux ELF via the x86.rs stack-machine backend (no PIR/regalloc).
fn cmd_build_x86(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid build-x86 <file.fd> [-o output]\n");
        p_eprint_str("       Builds a Linux ELF executable using the x86 stack-machine backend (AT&T syntax)\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var output: str = find_output_arg(n, start, "a.out");
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        print("Error: could not read file: ");
        print(input);
        print("\n");
        return 1;
    }
    var result: ResultBytes = build_x86_linux(source, input);
    match result {
        ResultBytes::Ok(exe_bytes) => {
            if !write_output_vec(output, exe_bytes) {
                return 1;
            }
            p_eprint_str("Built native executable: ");
            p_eprint_str(output);
            p_eprint_str(" (x86 backend)\n");
            return 0;
        }
        ResultBytes::Err(errors) => {
            print_errors(errors);
            return 1;
        }
    }
    return 1;
}

// --- cmd_codegen ---------------------------------------------------------
/// MI18: fid codegen <file.fd> [--target x86-64|arm64|riscv|<triple>]
/// [--fn <name>] [--elf <o> | --coff <o> | --macho <o>]: the machine code
/// emit's machine layer makes for the program, as instructions by function
/// (fid disasm), or with --elf/--coff/--macho its object file (as
/// `fid emit --obj`). Before Nov 17 it printed the PIR path's assembly text
/// (codegen_x64/arm64/riscv.fd, --peephole) and assembled it with
/// elf64/coff/macho.fd; no build used that code. --peephole is accepted and
/// does nothing (the machine layer always runs its own passes).
fn cmd_codegen(n: i64, start: i64, g_borrowck: str, g_timeout: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid codegen <file.fd> [--target x86-64|arm64|riscv|<triple>] [--fn <name>] [--elf <o>] [--coff <o>] [--macho <o>]\n");
        p_eprint_str("       the machine layer's code as instructions (fid disasm), or its object file\n");
        return 1;
    }
    var elf_out: str = get_flag_value(n, start, "--elf", "");
    var coff_out: str = get_flag_value(n, start, "--coff", "");
    var macho_out: str = get_flag_value(n, start, "--macho", "");
    var target: str = codegen_target(get_flag_value(n, start, "--target", "x86-64"), str_len(coff_out) > 0, str_len(macho_out) > 0);
    if str_len(target) == 0 {
        p_eprint_str("Unknown target: " + get_flag_value(n, start, "--target", "x86-64") + " (x86-64, arm64, riscv, or a triple such as aarch64-linux; --coff is x86-64 only)\n");
        return 1;
    }
    g_main_codegen_target = target;
    if str_len(coff_out) > 0 {
        g_main_codegen_obj = coff_out;
        g_main_codegen_nat = true;
    } else if str_len(macho_out) > 0 {
        g_main_codegen_obj = macho_out;
    } else if str_len(elf_out) > 0 {
        g_main_codegen_obj = elf_out;
    } else {
        g_main_disasm = true;
    }
    return cmd_build(n, start, g_borrowck, g_timeout);
}

/// MI18: the machine-layer target of `fid codegen --target <t>`: the PIR
/// path's names (x86-64, arm64, riscv) are their Linux targets, a Mach-O
/// object (--macho) the macOS target of the architecture, a COFF object
/// (--coff) x86-64 Windows; a full triple is kept (its object format is the
/// triple's). "" for a target the machine layer has no code for.
fn codegen_target(t: str, coff: bool, macho: bool) -> str {
    var arch: str = "";
    if t == "x86-64" || t == "x64" || t == "x86_64" || t == "amd64" {
        arch = "x86_64";
    } else if t == "arm64" || t == "aarch64" {
        arch = "aarch64";
    } else if t == "riscv" || t == "riscv64" || t == "rv64" {
        arch = "riscv64";
    }
    if str_len(arch) == 0 {
        var full: str = normalize_target(t);
        if nat_target_arch(full) == 0 {
            return "";
        }
        return full;
    }
    if coff {
        if arch != "x86_64" {
            return "";
        }
        return "x86_64-windows";
    }
    if macho {
        if arch == "riscv64" {
            return "";
        }
        return arch + "-macos";
    }
    return arch + "-linux";
}

// --- cmd_gpu -------------------------------------------------------------
// Generate GPU code (SPIR-V or PTX) from a Fides program.
fn cmd_gpu(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid gpu <file.fd> --target spirv|ptx [-o output] [--text]\n");
        p_eprint_str("       --target spirv  SPIR-V bytecode (Vulkan compute)\n");
        p_eprint_str("       --target ptx    PTX assembly (NVIDIA)\n");
        p_eprint_str("       --text          For spirv: emit text disassembly\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var target: str = get_flag_value(n, start, "--target", "spirv");
    var output: str = get_flag_value(n, start, "-o", "");
    var text_mode: bool = has_flag(n, start, "--text");
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var mod_result: ResultIrModule = lower_to_ir_module_with_path(source, input, "on");
    match mod_result {
        ResultIrModule::Err(errors) => {
            print_errors(errors);
            return 1;
        }
        ResultIrModule::Ok(ir_mod) => {
            // MI18: gpu.fd reads the IR (PIR's L3 before Nov 16)
            if target == "spirv" {
                if text_mode {
                    var text: str = generate_spirv_text(&ir_mod);
                    if str_len(output) > 0 {
                        p_file_write(output, text);
                        p_eprint_str("Generated SPIR-V text: " + output + "\n");
                    } else {
                        print(text);
                    }
                } else {
                    var words: Vec<i64> = generate_spirv(&ir_mod);
                    var bytes: Vec<i64> = Vec::new();
                    var wi: i64 = 0;
                    while wi < words.len() {
                        var w: i64 = words.get(wi);
                        bytes.push(w & 0xFF);
                        bytes.push((w >> 8) & 0xFF);
                        bytes.push((w >> 16) & 0xFF);
                        bytes.push((w >> 24) & 0xFF);
                        wi = wi + 1;
                    }
                    if str_len(output) > 0 {
                        if !write_output_vec(output, bytes) {
                            return 1;
                        }
                        p_eprint_str("Generated SPIR-V bytecode: " + output + " (" + int_to_str(words.len()) + " words)\n");
                    } else {
                        p_eprint_str("Generated " + int_to_str(words.len()) + " SPIR-V words (use -o to write binary)\n");
                    }
                }
                return 0;
            }
            if target == "ptx" {
                var ptx: str = generate_ptx(&ir_mod);
                if str_len(output) > 0 {
                    p_file_write(output, ptx);
                    p_eprint_str("Generated PTX assembly: " + output + "\n");
                } else {
                    print(ptx);
                }
                return 0;
            }
            p_eprint_str("Unknown GPU target '" + target + "'. Use --target spirv or --target ptx\n");
            return 1;
        }
    }
    return 1;
}

// --- cmd_verify ----------------------------------------------------------
// Verify IR correctness for a Fides source file.
// --- cmd_qualify -----------------------------------------------------------
//
// Release L3/L4: the evidence for one program, as JSON. Each safety rule
// with the requirement it implements and the tests that prove it (the same
// table as docs/reference/safety-rules.md), whether the program passes every
// check, and which of its functions carry which rules. It is evidence, not a
// certificate: "qualification" stays "NOT_QUALIFIED".

/// id | annotation | requirement | negative tests | positive tests
fn qualify_rules() -> Vec<str> {
    var r: Vec<str> = Vec::new();
    r.push("SR-1|@no-alloc|No dynamic allocation: no allocating call, builtin method (push, insert, clone, ...) or string +|test_safety_method_alloc_fail,test_medical_fail|test_medical,test_safety_annotations");
    r.push("SR-2|@no-recursion|No direct or indirect recursion|test_safety_recursion_fail|test_safety_annotations");
    r.push("SR-3|@no-unbounded|No while or loop without a bound|test_safety_annotations_fail|test_safety_annotations");
    r.push("SR-4|@no-panic (@crashfree)|No unwrap, no unchecked division, index or overflowing arithmetic|test_crashfree_fail,test_crashfree_index_fail,test_crashfree_overflow_fail,test_crashfree_method_fail|test_safety_annotations");
    r.push("SR-5|@no-indirect|No call through a function value, closure or dyn|test_safety_indirect_fail|test_safety_annotations");
    r.push("SR-6|@requires-audit|A @medical function carries @audit|test_safety_no_audit_fail|test_medical");
    r.push("SR-7|transitive|An annotated function calls only functions with the same guarantees|test_medical_fail,test_crashfree_method_fail|test_safety_annotations");
    r.push("SR-8|@firmware|No OS-dependent call (files, sockets, processes, environment)|test_firmware_os_fail|test_os_features");
    r.push("SR-9|@gas(N)|Static cost, loops with literal bounds counted per trip, within N|test_gas_fail,test_gas_loop_fail|test_gas");
    r.push("SR-10|@bounded-stack|Nothing reachable recurses or calls through a function value|test_bounded_stack_fail|test_bounded_stack");
    r.push("SR-11|@deterministic|No IO, time or randomness effect|test_deterministic_fail|test_deterministic");
    r.push("SR-12|@tainted|A @tainted parameter's value reaches no sink (output, files, network, processes, @sink) before a sanitizer, and is not returned unsanitized|test_tainted_param_fail,test_taint_flow_var_fail,test_taint_flow_callee_fail,test_taint_flow_return_fail|test_taint_flow,test_taint_flow_sanitized_call");
    r.push("SR-13|@secret|A secret value reaches no output, global, branch or unmarked return|test_secret_output_fail,test_secret_global_fail,test_secret_branch_fail,test_secret_helper_fail,test_secret_return_fail|test_secret");
    r.push("SR-14|@constant_time|No secret-dependent branch, early return or index|test_constant_time_fail,test_constant_time_branch_fail,test_constant_time_index_fail|test_constant_time");
    r.push("SR-15|sandbox|Code in a sandbox block uses only granted capabilities; under fid run the block also runs with every capability revoked|test_sandbox_fail,test_sandbox_alloc_fail,test_sandbox_exit_direct_fail|test_sandbox,test_runtime_sandbox_block");
    r.push("SR-16|@send|A spawned call's arguments and captures are @send|test_spawn_send_fail,test_send_fail|test_async");
    r.push("SR-17|borrows|No change to a Vec a for loop walks; no field assignment while borrowed|test_iter_invalidation_fail,test_field_borrow_fail|test_borrowck");
    r.push("SR-18|lock order|Locks are taken in one order across the call graph (CA4)|test_lock_order_fail,test_lock_order_param_fail|test_lock_order");
    r.push("SR-19|@redundant|Dual-channel execution with a voter; scalar result, no &mut, no outside effect|test_redundant_io_fail,test_redundant_global_fail,test_redundant_result_fail|test_redundant");
    r.push("SR-20|@partitioned|No global shared by two partitions; no direct call between partitions; no variable handed to two partitions by reference or pointer (ports excepted)|test_partitioned_shared_fail,test_partitioned_call_fail,test_partitioned_ref_fail,test_partitioned_ptr_fail,test_partitioned_global_ref_fail|test_partitioned,test_partitioned_ref");
    r.push("SR-21|@serverless|A handler writes no global, starts no task, reads no global initialized by code|test_serverless_state_fail,test_serverless_coldstart_fail,test_serverless_spawn_fail|test_serverless");
    return r;
}

fn qualify_json_list(csv: str, dir: str) -> str {
    var out: str = "[";
    if str_len(csv) == 0 {
        return "[]";
    }
    val items: Vec<str> = str_split(csv, ",");
    var i: i64 = 0;
    while i < items.len() {
        val t: str = items.get(i);
        if i > 0 {
            out = out + ", ";
        }
        var present: str = "false";
        if c_file_exists(c_path_join(dir, t + ".fd")) {
            present = "true";
        }
        out = out + "{\"test\": \"" + t + "\", \"present\": " + present + "}";
        i = i + 1;
    }
    return out + "]";
}

fn cmd_qualify(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid qualify <file.fd> [-o out.json]\n");
        return 1;
    }
    val input: str = p_argv(start + 1);
    var out_path: str = "";
    var ai: i64 = start + 2;
    while ai + 1 < n {
        if p_argv(ai) == "-o" {
            out_path = p_argv(ai + 1);
        }
        ai = ai + 1;
    }
    val source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: " + input + "\n");
        return 1;
    }
    // tests/bootstrap beside the stdlib (a checkout or an install)
    val test_dir: str = c_path_join(c_path_join(c_path_join(stdlib_dir(), ".."), "tests"), "bootstrap");

    var checks: str = "passed";
    var errors: Vec<str> = Vec::new();
    var annotated: str = "";
    var annotated_count: i64 = 0;
    match build_program_with_path_borrowck(source, OptStr::Some(input), "on") {
        ResultProgram::Ok(program) => {
            var fi: i64 = 0;
            while fi < program.funcs.len() {
                val f: Func = program.funcs.get(fi);
                if program_func_is_user(f.name, source) {
                    val prims: Vec<str> = expand_safety_primitives(f.annotations);
                    var anns: str = "";
                    var k: i64 = 0;
                    while k < f.annotations.len() {
                        if k > 0 {
                            anns = anns + ", ";
                        }
                        anns = anns + "\"@" + f.annotations.get(k).name + "\"";
                        k = k + 1;
                    }
                    if prims.len() > 0 || f.annotations.len() > 0 {
                        var ps: str = "";
                        k = 0;
                        while k < prims.len() {
                            if k > 0 {
                                ps = ps + ", ";
                            }
                            ps = ps + "\"" + prims.get(k) + "\"";
                            k = k + 1;
                        }
                        if annotated_count > 0 {
                            annotated = annotated + ",\n";
                        }
                        annotated = annotated + "    {\"function\": \"" + f.name + "\", \"annotations\": [" + anns + "], \"rules\": [" + ps + "]}";
                        annotated_count = annotated_count + 1;
                    }
                }
                fi = fi + 1;
            }
        }
        ResultProgram::Err(errs) => {
            checks = "failed";
            errors = errs;
        }
    }

    var j: str = "{\n";
    j = j + "  \"tool\": \"fid\",\n";
    j = j + "  \"compilerHash\": \"" + int_to_str(inc_compiler_hash()) + "\",\n";
    j = j + "  \"source\": \"" + json_escape_string(input) + "\",\n";
    j = j + "  \"sourceHash\": \"" + int_to_str(hash_source(source)) + "\",\n";
    j = j + "  \"checks\": \"" + checks + "\",\n";
    j = j + "  \"errors\": [";
    var ei: i64 = 0;
    while ei < errors.len() {
        if ei > 0 {
            j = j + ", ";
        }
        j = j + "\"" + json_escape_string(errors.get(ei)) + "\"";
        ei = ei + 1;
    }
    j = j + "],\n";
    j = j + "  \"annotatedFunctions\": [\n" + annotated + "\n  ],\n";
    j = j + "  \"rules\": [\n";
    val rules: Vec<str> = qualify_rules();
    var missing: i64 = 0;
    var ri: i64 = 0;
    while ri < rules.len() {
        val parts: Vec<str> = str_split(rules.get(ri), "|");
        val neg: str = qualify_json_list(parts.get(3), test_dir);
        val pos: str = qualify_json_list(parts.get(4), test_dir);
        if str_contains(neg, "\"present\": false") || str_len(parts.get(3)) == 0 {
            missing = missing + 1;
        }
        if ri > 0 {
            j = j + ",\n";
        }
        j = j + "    {\"id\": \"" + parts.get(0) + "\", \"rule\": \"" + parts.get(1) + "\", \"requirement\": \"" + json_escape_string(parts.get(2)) + "\", \"negativeTests\": " + neg + ", \"positiveTests\": " + pos + "}";
        ri = ri + 1;
    }
    j = j + "\n  ],\n";
    j = j + "  \"rulesWithoutNegativeTest\": " + int_to_str(missing) + ",\n";
    j = j + "  \"qualification\": \"NOT_QUALIFIED\",\n";
    j = j + "  \"note\": \"Evidence for review, not a certificate: no certification body has assessed this toolchain.\"\n";
    j = j + "}\n";
    if str_len(out_path) > 0 {
        p_file_write(out_path, j);
        p_eprint_str("Wrote " + out_path + "\n");
    } else {
        print(j);
    }
    if checks == "passed" {
        return 0;
    }
    return 1;
}

/// Whether a function name is defined in the program's own source (not in
/// the stdlib merged into it).
fn program_func_is_user(name: str, source: str) -> bool {
    return str_contains(source, "fn " + name + "(") || str_contains(source, "fn " + name + "<");
}

// --- cmd_audit -------------------------------------------------------------
// CM10: every `unsafe` block, @unsafe function and extern "C" declaration in
// the program and the modules it uses (transitively), each with the
// `// SAFETY:` comment that justifies it. The stdlib is summed up per module
// unless --stdlib; --strict exits 1 when a site outside the stdlib has no
// SAFETY: comment.

/// The file a `use` line names, or "" (a module not found is skipped).
fn audit_ident_byte(b: i64) -> bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95;
}

/// Source text with string literals and `//` comments removed, so an
/// `"unsafe {"` inside a literal is not mistaken for a block and a `//`
/// inside a string no longer truncates the line.
fn audit_code_only(code: str) -> str {
    var bytes: Vec<i64> = Vec::new();
    var i: i64 = 0;
    val n: i64 = str_len(code);
    while i < n {
        val b: i64 = str_byte_at(code, i);
        if b == 34 {
            i = i + 1;
            var done: bool = false;
            while i < n && !done {
                val c2: i64 = str_byte_at(code, i);
                if c2 == 92 {
                    i = i + 1;
                } else if c2 == 34 {
                    done = true;
                }
                i = i + 1;
            }
        } else if b == 47 && i + 1 < n && str_byte_at(code, i + 1) == 47 {
            i = n;
        } else {
            bytes.push(b);
            i = i + 1;
        }
    }
    return str_from_bytes(bytes);
}

/// Is `t` an `unsafe {` (or bare `unsafe`) line, matched on a token
/// boundary so `is_unsafe {` does not count?
fn audit_is_unsafe_block(t: str) -> bool {
    if t == "unsafe" {
        return true;
    }
    var rest: str = t;
    var off: i64 = 0;
    while str_len(rest) > 0 {
        val i: i64 = str_find(rest, "unsafe {");
        if i < 0 {
            return false;
        }
        if off + i == 0 || !audit_ident_byte(str_byte_at(t, off + i - 1)) {
            return true;
        }
        off = off + i + 1;
        rest = str_slice(rest, i + 1, str_len(rest));
    }
    return false;
}

fn audit_module_file(spec: str, from_file: str) -> str {
    var m: str = spec;
    val brace: i64 = str_find(m, "::{");
    if brace >= 0 {
        m = str_slice(m, 0, brace);
    }
    val rel: str = str_replace(m, "::", "/") + ".fd";
    val local: str = c_path_join(c_path_dirname(from_file), rel);
    if c_file_exists(local) {
        return local;
    }
    if c_file_exists(rel) {
        return rel;
    }
    val in_std: str = c_path_join(stdlib_dir(), c_platform_module(str_replace(m, "::", "/")) + ".fd");
    if c_file_exists(in_std) {
        return in_std;
    }
    return "";
}

/// CM10: the name of the first function declared on line `from` or within
/// the 8 lines after it (the function an `@unsafe` line marks), "" if none.
fn audit_next_fn_name(lines: Vec<str>, from: i64) -> str {
    var i: i64 = from;
    while i < lines.len() && i < from + 8 {
        var code: str = lines.get(i);
        val cm: i64 = str_find(code, "//");
        if cm >= 0 {
            code = str_slice(code, 0, cm);
        }
        val t: str = str_trim(code);
        val fnat: i64 = str_find(t, "fn ");
        if fnat >= 0 && (fnat == 0 || str_starts_with(t, "pub ") || str_starts_with(t, "@")) {
            val rest: str = str_slice(t, fnat + 3, str_len(t));
            val paren: i64 = str_find(rest, "(");
            if paren > 0 {
                return str_trim(str_slice(rest, 0, paren));
            }
        }
        i = i + 1;
    }
    return "";
}

/// The text after "SAFETY:" on the line or in the comment lines right above.
fn audit_justification(lines: Vec<str>, at: i64) -> str {
    val here: str = lines.get(at);
    val h: i64 = str_find(here, "SAFETY:");
    if h >= 0 {
        return str_trim(str_slice(here, h + 7, str_len(here)));
    }
    var k: i64 = at - 1;
    while k >= 0 && str_starts_with(str_trim(lines.get(k)), "//") {
        val c: str = lines.get(k);
        val s: i64 = str_find(c, "SAFETY:");
        if s >= 0 {
            return str_trim(str_slice(c, s + 7, str_len(c)));
        }
        k = k - 1;
    }
    return "";
}

fn cmd_audit(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid audit <file.fd> [--stdlib] [--strict]\n");
        return 1;
    }
    val input: str = p_argv(start + 1);
    var show_std: bool = false;
    var strict: bool = false;
    var ai: i64 = start + 2;
    while ai < n {
        if p_argv(ai) == "--stdlib" {
            show_std = true;
        }
        if p_argv(ai) == "--strict" {
            strict = true;
        }
        ai = ai + 1;
    }
    if str_len(c_file_read(input)) == 0 {
        p_eprint_str("Error: could not read file: " + input + "\n");
        return 1;
    }
    val std_dir: str = stdlib_dir();
    var files: Vec<str> = Vec::new();
    files.push(input);
    val core_file: str = c_path_join(std_dir, "core.fd");
    if c_file_exists(core_file) {
        files.push(core_file);
    }
    var mine: i64 = 0;
    var mine_bare: i64 = 0;
    var std_summary: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < files.len() {
        val file: str = files.get(fi);
        val is_std: bool = str_starts_with(file, std_dir);
        val lines: Vec<str> = str_split(c_file_read(file), "\n");
        var func: str = "";
        var count: i64 = 0;
        var bare: i64 = 0;
        var li: i64 = 0;
        while li < lines.len() {
            val t: str = str_trim(audit_code_only(lines.get(li)));
            if str_starts_with(t, "use ") {
                val spec: str = str_trim(str_replace(str_slice(t, 4, str_len(t)), ";", ""));
                val dep: str = audit_module_file(spec, file);
                if str_len(dep) > 0 && !str_vec_contains(files, dep) {
                    files.push(dep);
                }
            }
            val fnat: i64 = str_find(t, "fn ");
            if fnat >= 0 && (fnat == 0 || str_starts_with(t, "pub ") || str_starts_with(t, "@")) {
                var rest: str = str_slice(t, fnat + 3, str_len(t));
                val paren: i64 = str_find(rest, "(");
                if paren > 0 {
                    func = str_trim(str_slice(rest, 0, paren));
                }
            }
            var kind: str = "";
            if audit_is_unsafe_block(t) {
                kind = "unsafe block";
            }
            if str_starts_with(t, "@unsafe") {
                kind = "@unsafe function";
            }
            if str_starts_with(t, "extern") {
                kind = "extern \"C\"";
            }
            if str_len(kind) > 0 {
                val why: str = audit_justification(lines, li);
                count = count + 1;
                if str_len(why) == 0 {
                    bare = bare + 1;
                }
                if !is_std || show_std {
                    var where_fn: str = "";
                    if str_len(func) > 0 {
                        where_fn = " in " + func;
                    }
                    // an `@unsafe` line marks the function below it, not
                    // the one `func` still names
                    if kind == "@unsafe function" {
                        val next_fn: str = audit_next_fn_name(lines, li);
                        if str_len(next_fn) > 0 {
                            where_fn = " " + next_fn;
                        }
                    }
                    var say: str = "no SAFETY: comment";
                    if str_len(why) > 0 {
                        say = "SAFETY: " + why;
                    }
                    print(file + ":" + int_to_str(li + 1) + ": " + kind + where_fn + " - " + say + "\n");
                }
            }
            li = li + 1;
        }
        if is_std {
            if count > 0 && !show_std {
                std_summary.push(str_slice(file, str_len(std_dir) + 1, str_len(file)) + " " + int_to_str(count) + " (" + int_to_str(bare) + " without SAFETY:)");
            }
        } else {
            mine = mine + count;
            mine_bare = mine_bare + bare;
        }
        fi = fi + 1;
    }
    if std_summary.len() > 0 {
        print("stdlib (--stdlib lists them): ");
        var si: i64 = 0;
        while si < std_summary.len() {
            if si > 0 {
                print(", ");
            }
            print(std_summary.get(si));
            si = si + 1;
        }
        print("\n");
    }
    print(int_to_str(mine) + " unsafe site(s) outside the stdlib, " + int_to_str(mine_bare) + " without a SAFETY: comment\n");
    if strict && mine_bare > 0 {
        return 1;
    }
    return 0;
}

fn cmd_verify(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid verify <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var mod_result: ResultIrModule = lower_to_ir_module_with_path(source, input, "on");
    match mod_result {
        ResultIrModule::Err(errors) => {
            print_errors(errors);
            return 1;
        }
        ResultIrModule::Ok(ir_mod) => {
            var result: VerificationResult = IrModule_verify(&ir_mod);
            var wi: i64 = 0;
            while wi < result.warnings.len() {
                p_eprint_str("warning: " + result.warnings.get(wi) + "\n");
                wi = wi + 1;
            }
            var ei: i64 = 0;
            while ei < result.errors.len() {
                p_eprint_str("error: " + result.errors.get(ei) + "\n");
                ei = ei + 1;
            }
            if VerificationResult_is_valid(&result) {
                print("IR verification passed (" + int_to_str(result.warnings.len()) + " warnings)\n");
                return 0;
            }
            p_eprint_str("IR verification failed with " + int_to_str(result.errors.len()) + " errors\n");
            return 1;
        }
    }
    return 1;
}

// --- cmd_sourcemap -------------------------------------------------------
// Print the IR-to-source mapping for a Fides file.
fn cmd_sourcemap(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid sourcemap <file.fd>\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error: could not read file: ");
        p_eprint_str(input);
        p_eprint_str("\n");
        return 1;
    }
    var mod_result: ResultIrModule = lower_to_ir_module_with_path(source, input, "on");
    match mod_result {
        ResultIrModule::Err(errors) => {
            print_errors(errors);
            return 1;
        }
        ResultIrModule::Ok(ir_mod) => {
            var sm: SourceMap = IrModule_source_map(&ir_mod);
            if sm.entries.len() == 0 {
                print("Source map is empty (no source line info available).\n");
            } else {
                print(SourceMap_to_str(&sm));
            }
            return 0;
        }
    }
    return 1;
}

// --- cmd_parse_header ----------------------------------------------------
// Parse a C header file and emit Fides FFI bindings.
fn cmd_parse_header(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid parse-header <file.h> [-o output.fd] [--link <lib>]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var output: str = find_output_arg(n, start, "");
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("Error reading '" + input + "'\n");
        return 1;
    }
    var base: str = input;
    var slash: i64 = str_rfind_char(input, 47);
    var bslash: i64 = str_rfind_char(input, 92);
    if bslash > slash {
        slash = bslash;
    }
    if slash >= 0 {
        base = str_slice(input, slash + 1, str_len(input));
    }
    var stem: str = base;
    if str_ends_with(stem, ".h") {
        stem = str_slice(stem, 0, str_len(stem) - 2);
    }
    // --link <lib>: the library of the extern block (default: the header's name)
    var link: str = get_flag_value(n, start, "--link", stem);
    // With -o x.fd the bindings are module x (usable with `use x;`)
    var module_name: str = "";
    if str_len(output) > 0 {
        module_name = output;
        var os: i64 = str_rfind_char(module_name, 47);
        var ob: i64 = str_rfind_char(module_name, 92);
        if ob > os {
            os = ob;
        }
        if os >= 0 {
            module_name = str_slice(module_name, os + 1, str_len(module_name));
        }
        if str_ends_with(module_name, ".fd") {
            module_name = str_slice(module_name, 0, str_len(module_name) - 3);
        }
    }
    var bindings: str = cparse_header_file(input, link, module_name);
    if str_len(output) > 0 {
        p_file_write(output, bindings);
        p_eprint_str("Generated " + input + " bindings -> " + output + "\n");
    } else {
        print(bindings);
    }
    return 0;
}

/// FID_VERIFY: the IR verifier's findings, printed; false when there are any.
/// The functions `lower` needs for a native build (compiler/reach.fd): every
/// core function is a root (lowering and the runtimes call them by name).
/// 0 (lower everything) without a parsed core.
fn lw_keep_set(program: Program) -> i64 {
    // WP20: a program without `main` is a library build (nat_ir.fd
    // ng_lib_roots): its own functions are the roots, so lower everything
    var has_main: bool = false;
    var mi0: i64 = 0;
    while mi0 < program.funcs.len() {
        if program.funcs.get(mi0).name == "main" {
            has_main = true;
        }
        mi0 = mi0 + 1;
    }
    if !has_main {
        return 0;
    }
    var core_names: Vec<str> = Vec::new();
    match g_stdlib_cache {
        OptProgram::Some(cp) => {
            var i: i64 = 0;
            while i < cp.funcs.len() {
                core_names.push(cp.funcs.get(i).name);
                i = i + 1;
            }
            i = 0;
            while i < cp.impls.len() {
                var im: ImplDef = cp.impls.get(i);
                var j: i64 = 0;
                while j < im.methods.len() {
                    core_names.push(im.struct_name + "_" + im.methods.get(j).name);
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        OptProgram::None => {
            return 0;
        }
    }
    return reach_keep_set(program, core_names);
}

// --- PE88: what a pe_ir build can never call, gone before the mid-end ------
//
// pe-roadmap 88 (`fid emit` of a typical test in under 1 s). `lower` turns
// into IR every function compiler/reach.fd keeps: main's, all of core and
// the merged runtime. pe_ir generates only what main reaches, but the
// mid-end's module-wide passes (hofspec, inline, licmcall, gconst,
// closuredevirt) and pe_ir's module-wide work (its string table, the
// runtime functions it needs, a label for each function) go over all of
// them. pe88_prune drops, after lowering and before iropt, the functions no
// code can call: those not reachable from main, from a function machine
// code may call by name (ir.fd ir_dfe_root: p_*, __*, the whole Fides
// runtime pe_/pert_/pet_/ped_, nat_*, the Vec_* and vec_raw_* stand-ins,
// the collection printers), from a function handed to C, an interrupt
// handler or kernel, or a function some string of the module names. That is
// the rule of IrModule_dead_function_elimination (iropt's opt-in `deadf`),
// along the edges of pe_ir_reachable_from (calls as pe_ir resolves them,
// the print builtins, function references, strings naming a function,
// `dyn` calls, the stubs' runtime functions), over a hash set: both of
// those compare names along a list, which costs more than it saves (deadf
// took 1.4 s for tests/bootstrap/hello.fd with a -O0 compiler).
// The runtime stays whole, so pe_ir resolves every builtin as before.
// FID_PE_PRUNE=0 (or FID_LOWER_ALL=1): every function stays.
// tests/tooling/pe88-emit-time-check.sh times `emit` and compares programs
// built with and without it.

/// PE88: the prune runs unless FID_PE_PRUNE=0 or FID_LOWER_ALL is set.
fn pe88_prune_on() -> bool {
    if env_or_empty("FID_PE_PRUNE") == "0" {
        return false;
    }
    return str_len(env_or_empty("FID_LOWER_ALL")) == 0;
}

/// PE88: pe_ir_generate_pe returned errors.
fn pe88_failed(r: ResultBytes) -> bool {
    match r {
        ResultBytes::Err(_) => {
            return true;
        }
        ResultBytes::Ok(_) => {
            return false;
        }
    }
    return false;
}

/// PE88: the names pe88_prune dropped from the last module.
var g_pe88_dropped: Vec<str> = Vec::new();

/// PE88: pe_ir's errors name a function the prune dropped (pe_ir reports a
/// call it cannot make by the callee's name), so the build without the
/// prune may succeed. Any other error is the program's: no second build.
fn pe88_names_dropped(r: ResultBytes) -> bool {
    match r {
        ResultBytes::Err(errs) => {
            var ei: i64 = 0;
            while ei < errs.len() {
                var e: str = errs.get(ei);
                var di: i64 = 0;
                while di < g_pe88_dropped.len() {
                    if str_contains(e, g_pe88_dropped.get(di)) {
                        return true;
                    }
                    di = di + 1;
                }
                ei = ei + 1;
            }
            return false;
        }
        ResultBytes::Ok(_) => {
            return false;
        }
    }
    return false;
}

/// PE88: queue `name` once.
fn pe88_mark(seen: i64, work: &mut Vec<str>, name: str) {
    if str_len(name) > 0 && !HashMap_contains(seen, name) {
        HashMap_insert(seen, name, 1);
        work.push(name);
    }
}

/// PE88: queue `name` when the module has a function of that name (a
/// string that may be looked up by name at run time).
fn pe88_mark_named(module: &IrModule, seen: i64, work: &mut Vec<str>, name: str) {
    if str_len(name) > 0 && IrModule_fn_pos(module, name) >= 0 {
        pe88_mark(seen, work, name);
    }
}

/// PE88: a call of `callee` as pe_ir makes it: the name, what pe_ir
/// resolves it to (pert_c_ override, core stand-in, pert_ function) and,
/// for print and p_to_str, every formatter they may dispatch to.
fn pe88_mark_call(module: &IrModule, seen: i64, work: &mut Vec<str>, callee: str, prints: Vec<str>) {
    pe88_mark(seen, work, callee);
    pe88_mark(seen, work, pe_ir_resolve_callee(module, callee));
    if callee == "print" || callee == "p_to_str" {
        var bi: i64 = 0;
        while bi < prints.len() {
            pe88_mark(seen, work, pe_ir_resolve_callee(module, prints.get(bi)));
            bi = bi + 1;
        }
        pe88_mark(seen, work, pe_ir_resolve_callee(module, "p_tensor_to_str"));
    }
}

/// PE88: a `dyn` call of `method` may land in any function named
/// `<type>_<method>` (pe_ir_reachable_from's rule); each method is looked
/// up once.
fn pe88_mark_dyn(module: &IrModule, seen: i64, dyn_done: i64, work: &mut Vec<str>, method: str) {
    if HashMap_contains(dyn_done, method) {
        return;
    }
    HashMap_insert(dyn_done, method, 1);
    var suffix: str = "_" + method;
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var fname: str = module.functions.get(fi).name;
        if str_ends_with(fname, suffix) {
            pe88_mark(seen, work, fname);
        }
        fi = fi + 1;
    }
}

/// PE88: the names of the functions some code of a pe_ir build of `module`
/// may call (a set: keys are names), see the section comment.
fn pe88_reached(module: &IrModule) -> i64 {
    var seen: i64 = HashMap_new();
    var dyn_done: i64 = HashMap_new();
    var work: Vec<str> = Vec::new();
    var prints: Vec<str> = pe_print_builtins();
    var deps: Vec<PeirStrPair> = pe_stub_deps();
    // Roots
    var i: i64 = 0;
    while i < module.functions.len() {
        var rname: str = module.functions.get(i).name;
        var rf: IrFunction = module.functions.get(i).func;
        if rname == "main" || rname == "main_entry" || ir_dfe_root(rname) || rf.is_interrupt || rf.is_kernel {
            pe88_mark(seen, &mut work, rname);
        }
        i = i + 1;
    }
    i = 0;
    while i < module.c_callbacks.len() {
        pe88_mark(seen, &mut work, module.c_callbacks.get(i));
        i = i + 1;
    }
    i = 0;
    while i < module.extern_functions.len() {
        pe88_mark(seen, &mut work, module.extern_functions.get(i).name);
        i = i + 1;
    }
    i = 0;
    while i < module.string_constants.len() {
        pe88_mark_named(module, seen, &mut work, module.string_constants.get(i).key);
        i = i + 1;
    }
    i = 0;
    while i < module.globals.len() {
        match module.globals.get(i).init {
            Expr::StringLit(gs) => {
                pe88_mark_named(module, seen, &mut work, gs);
            }
            _ => {
            }
        }
        i = i + 1;
    }
    // What the queued functions call, to a fixpoint
    while work.len() > 0 {
        var f: str = work.pop();
        var di: i64 = 0;
        while di < deps.len() {
            if deps.get(di).a == f {
                pe88_mark(seen, &mut work, deps.get(di).b);
            }
            di = di + 1;
        }
        match IrModule_get_function(module, f) {
            OptIrFunction::Some(func) => {
                var ii: i64 = 0;
                while ii < func.insts.len() {
                    var inst: Inst = func.insts.get(ii).inst;
                    match inst {
                        Inst::Call(callee, _, _, _) => {
                            pe88_mark_call(module, seen, &mut work, callee, prints);
                        }
                        Inst::ConstStr(value) => {
                            pe88_mark_named(module, seen, &mut work, value);
                        }
                        Inst::ConstFnRef(fref) => {
                            pe88_mark(seen, &mut work, c_fn_target(fref));
                            pe88_mark(seen, &mut work, fref);
                        }
                        Inst::Print(_, pty) => {
                            pe88_mark(seen, &mut work, pe_ir_print_formatter(pty));
                            var pi: i64 = 0;
                            while pi < prints.len() {
                                pe88_mark(seen, &mut work, pe_ir_resolve_callee(module, prints.get(pi)));
                                pi = pi + 1;
                            }
                        }
                        Inst::DynCall(_, method, _, _, _) => {
                            pe88_mark_dyn(module, seen, dyn_done, &mut work, method);
                        }
                        Inst::GradBegin(_) => {
                            pe88_mark(seen, &mut work, pe_ir_resolve_callee(module, pe_ir_autograd_builtin(inst)));
                        }
                        Inst::GradEnd => {
                            pe88_mark(seen, &mut work, pe_ir_resolve_callee(module, pe_ir_autograd_builtin(inst)));
                        }
                        Inst::Backward(_) => {
                            pe88_mark(seen, &mut work, pe_ir_resolve_callee(module, pe_ir_autograd_builtin(inst)));
                        }
                        _ => {
                        }
                    }
                    ii = ii + 1;
                }
            }
            OptIrFunction::None => {
            }
        }
    }
    HashMap_drop(dyn_done);
    return seen;
}

/// PE88: drop the functions of `module` no code of a pe_ir build can call
/// (pe88_reached); returns how many went. A program without `main` keeps
/// everything (pe_ir rejects it anyway).
fn pe88_prune(module: &mut IrModule) -> i64 {
    if IrModule_fn_pos(module, "main") < 0 {
        return 0;
    }
    var seen: i64 = pe88_reached(module);
    var total: i64 = module.functions.len();
    var kept: Vec<IrFunctionEntry> = Vec::new();
    var dropped: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < total {
        var entry: IrFunctionEntry = module.functions.get(i);
        if HashMap_contains(seen, entry.name) {
            kept.push(entry);
        } else {
            dropped.push(entry.name);
        }
        i = i + 1;
    }
    g_pe88_dropped = dropped;
    HashMap_drop(seen);
    var removed: i64 = total - kept.len();
    if removed > 0 {
        module.functions = kept;
        // AGENTS 14: the name index goes with the list it indexes
        HashMap_clear(module.fn_index);
    }
    p_eprint_str("[build] pe88: " + int_to_str(removed) + " of " + int_to_str(total) + " functions no code can call dropped before the mid-end\n");
    return removed;
}

fn nat_verified(m: &IrModule, stage: str) -> bool {
    var errs: Vec<str> = ir_verify(m, stage);
    var i: i64 = 0;
    while i < errs.len() {
        print(errs.get(i) + "\n");
        i = i + 1;
    }
    return errs.len() == 0;
}

// --- DB7: one function through the native pipeline ------------------------
// `fid emit <file> --explain <fn>` and `fid explain <file> --stages <fn>`:
// the function's IR after lowering and after each mid-end stage
// (ir.fd IrFunction_detail_str), then the bytes the native layer wrote for
// it, found through the executable's own symbol table (DB2, DB10).

/// Print function `name` of `m` under a heading naming the stage.
fn explain_stage(m: &IrModule, name: str, stage: str) {
    print("=== " + name + ": IR " + stage + " ===\n");
    var text: str = IrModule_function_detail_str(m, name);
    if str_len(text) > 0 {
        print(text);
        return;
    }
    print("  (no function " + name + " at this stage: inlined, removed or never reached)\n");
    // Names that contain it, to help with a misspelled or qualified name
    var shown: i64 = 0;
    var i: i64 = 0;
    while i < m.functions.len() && shown < 10 {
        var fname: str = m.functions.get(i).name;
        if str_find(fname, name) >= 0 {
            print("  did you mean: " + fname + "\n");
            shown = shown + 1;
        }
        i = i + 1;
    }
}

/// SP2/RA14: the machine layer's rows of the `--time` table (nat_ir.fd
/// nat_time_mark: nat record, nat alloc+emit, its allocation and encoding
/// parts, nat data+image) appended under the row before them, then
/// emptied (a second build records its own).
fn main_nat_time_rows() {
    var tn: Vec<str> = nat_time_names();
    var tm: Vec<i64> = nat_time_ms();
    var ti: i64 = 0;
    while ti < tn.len() && ti < tm.len() {
        time_row("  " + tn.get(ti), tm.get(ti));
        ti = ti + 1;
    }
    nat_time_clear();
}

/// DB8: the optimization remarks of a module on stderr: per function, each
/// runtime check the mid-end removed and the proof that removed it, and how
/// many stayed (checks.fd explain_checks). `filt` ("" = all) keeps only
/// functions whose name contains it.
fn print_remarks(m: IrModule, filt: str) {
    var lines: Vec<str> = explain_checks(m, filt);
    var i: i64 = 0;
    while i < lines.len() {
        p_eprint_str("[remark] " + lines.get(i) + "\n");
        i = i + 1;
    }
    // DB8: why calls were not inlined (iropt.fd)
    var il: Vec<str> = iropt_inline_remarks(filt);
    i = 0;
    while i < il.len() {
        p_eprint_str("[remark] " + il.get(i) + "\n");
        i = i + 1;
    }
}

/// `v` (0-255) as two lowercase hex digits.
fn hex2(v: i64) -> str {
    var digits: str = "0123456789abcdef";
    var hi: i64 = (v >> 4) & 15;
    var lo: i64 = v & 15;
    return str_slice(digits, hi, hi + 1) + str_slice(digits, lo, lo + 1);
}

/// The little-endian integer of `size` bytes at `off` of an image, 0 when
/// it is out of range.
@wrapping
fn elf_u(b: &Vec<i64>, off: i64, size: i64) -> i64 {
    if off < 0 || off + size > b.len() {
        return 0;
    }
    var v: i64 = 0;
    var i: i64 = size - 1;
    while i >= 0 {
        v = (v << 8) | (b.get(off + i) & 255);
        i = i - 1;
    }
    return v;
}

/// The NUL-ended name at `off` of an image is `name`.
fn elf_name_is(b: &Vec<i64>, off: i64, name: str) -> bool {
    var len: i64 = str_len(name);
    if off < 0 || off + len >= b.len() {
        return false;
    }
    var i: i64 = 0;
    while i < len {
        if (b.get(off + i) & 255) != str_byte_at(name, i) {
            return false;
        }
        i = i + 1;
    }
    return b.get(off + len) == 0;
}

/// The bytes of function `name` in an ELF64 executable, from its `.symtab`
/// (address and size of the symbol, through the header of the section it
/// is in). Empty when there is no such symbol.
fn elf_symbol_bytes(b: &Vec<i64>, name: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if b.len() < 64 || b.get(0) != 0x7F || b.get(1) != 0x45 || b.get(2) != 0x4C || b.get(3) != 0x46 {
        return out;
    }
    var shoff: i64 = elf_u(b, 0x28, 8);
    var shentsize: i64 = elf_u(b, 0x3A, 2);
    var shnum: i64 = elf_u(b, 0x3C, 2);
    if shoff <= 0 || shentsize < 64 || shoff + shnum * shentsize > b.len() {
        return out;
    }
    var si: i64 = 0;
    while si < shnum {
        var sh: i64 = shoff + si * shentsize;
        // SHT_SYMTAB; its sh_link is the string table
        if elf_u(b, sh + 4, 4) == 2 {
            var sym_off: i64 = elf_u(b, sh + 24, 8);
            var sym_size: i64 = elf_u(b, sh + 32, 8);
            var link: i64 = elf_u(b, sh + 40, 4);
            var str_off: i64 = elf_u(b, shoff + link * shentsize + 24, 8);
            // entry 0 is the null symbol
            var k: i64 = 24;
            while k + 24 <= sym_size {
                var ent: i64 = sym_off + k;
                if elf_name_is(b, str_off + elf_u(b, ent, 4), name) {
                    var shndx: i64 = elf_u(b, ent + 6, 2);
                    var value: i64 = elf_u(b, ent + 8, 8);
                    var size: i64 = elf_u(b, ent + 16, 8);
                    var tsh: i64 = shoff + shndx * shentsize;
                    if shndx <= 0 || shndx >= shnum {
                        return out;
                    }
                    var file_off: i64 = value - elf_u(b, tsh + 16, 8) + elf_u(b, tsh + 24, 8);
                    var q: i64 = 0;
                    while q < size && file_off + q < b.len() {
                        out.push(b.get(file_off + q) & 255);
                        q = q + 1;
                    }
                    return out;
                }
                k = k + 24;
            }
        }
        si = si + 1;
    }
    return out;
}

/// The big-endian 32-bit word at `off` of an image (a universal Mach-O's
/// header), 0 when it is out of range.
fn macho_be32(b: &Vec<i64>, off: i64) -> i64 {
    if off < 0 || off + 4 > b.len() {
        return 0;
    }
    return ((b.get(off) & 255) << 24) | ((b.get(off + 1) & 255) << 16) | ((b.get(off + 2) & 255) << 8) | (b.get(off + 3) & 255);
}

/// The NUL-ended name at `off` of an image (at most 512 bytes).
fn macho_cstr(b: &Vec<i64>, off: i64) -> str {
    var out: str = "";
    var i: i64 = off;
    while i >= 0 && i < b.len() && (b.get(i) & 255) != 0 && i - off < 512 {
        out = out + char_to_str(b.get(i) & 255);
        i = i + 1;
    }
    return out;
}

/// `v` (not negative) in lowercase hex, at least 8 digits (the addresses
/// of disasm.fd's listings).
fn macho_hex(v: i64) -> str {
    var digits: str = "0123456789abcdef";
    var out: str = "";
    var x: i64 = v;
    while x > 0 {
        var d: i64 = x & 15;
        out = str_slice(digits, d, d + 1) + out;
        x = x >> 4;
    }
    while str_len(out) < 8 {
        out = "0" + out;
    }
    return out;
}

/// DB7, TG5: the functions of a 64-bit Mach-O executable (its LC_SYMTAB:
/// the nlist_64 records of a section, with C's leading underscore, as
/// nat_enc.fd nat_macho_img writes them), or the one named `name`, as
/// instructions (disasm.fd disasm_bytes); of a universal binary, its first
/// slice. A function ends where the next symbol of its section starts, or
/// at the section's end. "" when `bytes` is not a Mach-O; a text starting
/// "fid disasm:" when it holds no such function.
fn macho_disasm(bytes: Vec<i64>, name: str) -> str {
    var b: Vec<i64> = bytes;
    var at: i64 = 0;
    // a universal binary (FAT_MAGIC, big-endian): fat_arch[0].offset
    if macho_be32(&b, 0) == 0xCAFEBABE && macho_be32(&b, 4) > 0 {
        at = macho_be32(&b, 16);
    }
    if b.len() < at + 32 || elf_u(&b, at, 4) != 0xFEEDFACF {
        return "";
    }
    var cputype: i64 = elf_u(&b, at + 4, 4);
    var arch: i64 = 0;
    if cputype == 0x01000007 {
        arch = disasm_arch_of("x86_64");
    } else if cputype == 0x0100000C {
        arch = disasm_arch_of("aarch64");
    }
    if arch == 0 {
        return "fid disasm: Mach-O CPU type " + int_to_str(cputype) + " is not x86-64 or AArch64\n";
    }
    // the sections of every LC_SEGMENT_64 (n_sect counts them from 1, in
    // order) and LC_SYMTAB
    var ncmds: i64 = elf_u(&b, at + 16, 4);
    var sect_addr: Vec<i64> = Vec::new();
    var sect_size: Vec<i64> = Vec::new();
    var sect_off: Vec<i64> = Vec::new();
    var symoff: i64 = 0;
    var nsyms: i64 = 0;
    var stroff: i64 = 0;
    var lc: i64 = at + 32;
    var ci: i64 = 0;
    while ci < ncmds && lc + 8 <= b.len() {
        var cmd: i64 = elf_u(&b, lc, 4);
        var cmdsize: i64 = elf_u(&b, lc + 4, 4);
        if cmdsize < 8 {
            break;
        }
        if cmd == 0x19 {
            var nsects: i64 = elf_u(&b, lc + 64, 4);
            var si: i64 = 0;
            while si < nsects {
                var sh: i64 = lc + 72 + si * 80;
                sect_addr.push(elf_u(&b, sh + 32, 8));
                sect_size.push(elf_u(&b, sh + 40, 8));
                sect_off.push(elf_u(&b, sh + 48, 4));
                si = si + 1;
            }
        } else if cmd == 0x2 {
            symoff = elf_u(&b, lc + 8, 4);
            nsyms = elf_u(&b, lc + 12, 4);
            stroff = elf_u(&b, lc + 16, 4);
        }
        lc = lc + cmdsize;
        ci = ci + 1;
    }
    if nsyms == 0 {
        return "fid disasm: the Mach-O has no symbol table\n";
    }
    var names: Vec<str> = Vec::new();
    var values: Vec<i64> = Vec::new();
    var sects: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < nsyms {
        var ent: i64 = at + symoff + k * 16;
        var ntype: i64 = elf_u(&b, ent + 4, 1);
        var nsect: i64 = elf_u(&b, ent + 5, 1);
        // N_SECT (type bits 0x0E), not a debugging (stab) record
        if (ntype & 0xE0) == 0 && (ntype & 0x0E) == 0x0E && nsect >= 1 && nsect <= sect_addr.len() {
            var nm: str = macho_cstr(&b, at + stroff + elf_u(&b, ent, 4));
            if str_starts_with(nm, "_") {
                nm = str_slice(nm, 1, str_len(nm));
            }
            names.push(nm);
            values.push(elf_u(&b, ent + 8, 8));
            sects.push(nsect);
        }
        k = k + 1;
    }
    var out: str = "";
    var found: i64 = 0;
    var i: i64 = 0;
    while i < names.len() {
        if str_len(name) == 0 || names.get(i) == name {
            var s: i64 = sects.get(i) - 1;
            var value: i64 = values.get(i);
            var fend: i64 = sect_addr.get(s) + sect_size.get(s);
            var j: i64 = 0;
            while j < names.len() {
                if sects.get(j) == sects.get(i) && values.get(j) > value && values.get(j) < fend {
                    fend = values.get(j);
                }
                j = j + 1;
            }
            var file_off: i64 = at + sect_off.get(s) + (value - sect_addr.get(s));
            if fend > value && file_off >= 0 {
                out = out + "\n" + macho_hex(value) + " <" + names.get(i) + ">:\n" + disasm_bytes(&b, file_off, file_off + (fend - value), arch, value);
                found = found + 1;
            }
        }
        i = i + 1;
    }
    if found == 0 {
        if str_len(name) > 0 {
            return "fid disasm: no function " + name + " in the symbol table\n";
        }
        return "fid disasm: the Mach-O's symbol table names no function\n";
    }
    return out;
}

/// The machine code of function `name` in a native executable, as
/// instructions (DB7: ELF, PE and Mach-O symbols); 16 bytes a line from the
/// ELF .symtab when the disassembler cannot read the image. `not_elf`: a
/// PE or Mach-O (no such fallback).
fn explain_machine_code(bytes: Vec<i64>, name: str, not_elf: bool) {
    print("=== " + name + ": machine code ===\n");
    // DB7: as instructions (compiler/disasm.fd disasm_bytes), the function
    // found through the image's own symbols: an ELF's .symtab, a PE's COFF
    // symbol table (nat_pe_symbols), a Mach-O's LC_SYMTAB (macho_disasm)
    var listing: str = macho_disasm(bytes, name);
    if str_len(listing) == 0 {
        listing = disasm_image(bytes, name);
    }
    if str_starts_with(listing, "fid disasm: no function") {
        print("  (no symbol " + name + ": not reached from main, folded into an identical function, or FID_NAT_OFF=debug)\n");
        return;
    }
    if !str_starts_with(listing, "fid disasm:") {
        if str_starts_with(listing, "\n") {
            listing = str_slice(listing, 1, str_len(listing));
        }
        print(listing);
        print("  ; the machine IR after each machine stage is on stderr ([mir] lines; FID_NAT_DUMP=" + name + " on any build)\n");
        return;
    }
    // an image the disassembler does not read: the bytes, from the ELF
    // .symtab
    if not_elf {
        print("  (" + str_trim(listing) + ")\n");
        return;
    }
    var img: Vec<i64> = bytes;
    var code: Vec<i64> = elf_symbol_bytes(&img, name);
    if code.len() == 0 {
        print("  (no symbol " + name + ": not reached from main, folded into an identical function, or FID_NAT_OFF=debug)\n");
        return;
    }
    var i: i64 = 0;
    while i < code.len() {
        var line: str = "  " + hex2((i >> 8) & 255) + hex2(i & 255) + ":";
        var j: i64 = 0;
        while j < 16 && i + j < code.len() {
            line = line + " " + hex2(code.get(i + j));
            j = j + 1;
        }
        print(line + "\n");
        i = i + 16;
    }
    print("  ; " + int_to_str(code.len()) + " bytes (with the padding before the next function)\n");
    print("  ; the machine IR after allocation: FID_NAT_DUMP=" + name + " (stderr)\n");
}

/// CT7: `fid replay <trace> [--steps] [--max-steps N] [--max-recursion N]`:
/// the program `fid run <file> --record <trace>` ran, run again in the
/// interpreter from the text the trace holds, each effect call (files,
/// environment, argv, clock, randomness, stdin, p_system, processes, file
/// bytes) answered from the trace and not made. --steps prints each
/// answered call on stderr; --until <k> stops before the k-th and prints
/// the calls the program is in. Exit code: the program's; 1 when the run
/// differs from the recorded one (other calls, fewer calls, another exit
/// code), said on stderr.
fn cmd_replay(n: i64, start: i64, g_borrowck: str) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid replay <trace> [--steps] [--until K] [--max-steps N] [--max-recursion N]\n");
        p_eprint_str("       (a trace is written by `fid run <file.fd> --record <trace>`)\n");
        return 1;
    }
    var path: str = argv_at(start + 1);
    var text: str = "";
    match read_file(path) {
        Option::Some(t) => {
            text = t;
        }
        Option::None => {
            p_eprint_str("error: cannot read the trace " + path + "\n");
            return 1;
        }
    }
    // --until <k>: stop before effect call k, showing the calls the
    // program is in (interp.fd reads it as a line of the trace)
    var until: i64 = get_flag_int(n, start, "--until", 0);
    if until > 0 {
        text = text + "\nuntil " + int_to_str(until) + "\n";
    }
    var why: str = run_replay_start(text, has_flag(n, start, "--steps"));
    if str_len(why) > 0 {
        p_eprint_str("error: " + path + ": " + why + "\n");
        return 1;
    }
    var program: str = run_replay_program();
    var max_recursion: i64 = get_flag_int(n, start, "--max-recursion", 1000);
    var max_steps: i64 = get_flag_int(n, start, "--max-steps", 0);
    var rc: i64 = interpret_source_with_path(run_replay_source(), program, max_recursion, max_steps, 0, false, g_borrowck);
    var differs: str = run_replay_finish(rc);
    if str_len(differs) > 0 {
        p_eprint_str("replay of " + program + ": " + differs + "\n");
        if rc == 0 {
            return 1;
        }
    }
    return rc;
}

/// L5B: one word of a shell command (quoted when it holds a space, a quote
/// or a shell operator, or is empty).
fn project_shell_word(s: str) -> str {
    if str_len(s) == 0 || str_contains(s, " ") || str_contains(s, "&") || str_contains(s, "|") || str_contains(s, "<") || str_contains(s, ">") {
        return "\"" + s + "\"";
    }
    return s;
}

/// L5B: run `cmd` in a shell; its exit code. cmd.exe /C strips the first
/// and the last quote of a command that starts with a quote: one more pair.
fn project_run(cmd: str) -> i64 {
    if host_os() == "windows" && str_starts_with(cmd, "\"") {
        return p_system("\"" + cmd + "\"");
    }
    return p_system(cmd);
}

/// L5B: is pact `name` installed under `dir` (ark_modules/ or vendor/
/// beside an ark.toml): a directory pact or a file pact?
fn project_pact_in(dir: str, name: str) -> bool {
    var pre: str = "";
    if str_len(dir) > 0 {
        pre = dir + "/";
    }
    var bases: Vec<str> = Vec::new();
    bases.push(pre + "ark_modules/");
    bases.push(pre + "vendor/");
    var b: i64 = 0;
    while b < bases.len() {
        var base: str = bases.get(b);
        if p_is_dir(base + name) != 0 || p_file_exists(base + name + ".fd") != 0 {
            return true;
        }
        b = b + 1;
    }
    return false;
}

/// L5B: the names under [dependencies] of the ark.toml text `content`.
fn project_dep_names(content: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var lines: Vec<str> = str_split(content, "\n");
    var in_deps: bool = false;
    var i: i64 = 0;
    while i < lines.len() {
        var line: str = str_trim(lines.get(i));
        i = i + 1;
        if str_len(line) == 0 || str_starts_with(line, "#") {
            continue;
        }
        if str_starts_with(line, "[") {
            in_deps = line == "[dependencies]";
            continue;
        }
        if !in_deps {
            continue;
        }
        var eq: i64 = str_find(line, "=");
        if eq <= 0 {
            continue;
        }
        var key: str = str_trim(str_slice(line, 0, eq));
        if str_len(key) >= 2 && str_starts_with(key, "\"") {
            key = str_slice(key, 1, str_len(key) - 1);
        }
        if str_len(key) > 0 {
            out.push(key);
        }
    }
    return out;
}

/// L5B: does the project here declare a dependency that is not installed
/// (in ark_modules/ or vendor/ here, or at a workspace root above: a
/// member shares the root's copy)?
fn project_needs_install() -> bool {
    var names: Vec<str> = Vec::new();
    match read_file("ark.toml") {
        Option::Some(c) => {
            names = project_dep_names(c);
        }
        Option::None => {
            return false;
        }
    }
    var d: i64 = 0;
    while d < names.len() {
        var name: str = names.get(d);
        d = d + 1;
        if project_pact_in("", name) {
            continue;
        }
        var found: bool = false;
        var up: str = "..";
        var level: i64 = 1;
        while level <= 8 && !found {
            if p_file_exists(up + "/ark.toml") != 0 && project_pact_in(up, name) {
                found = true;
            }
            up = up + "/..";
            level = level + 1;
        }
        if !found {
            return true;
        }
    }
    return false;
}

/// L5B: `fid build [flags]` in a directory with an ark.toml is the
/// project's build. The dependencies are installed first (`ark install`)
/// when ark.toml declares one that is not there yet; then `ark build`
/// builds every target ark.toml declares ([[bin]], [[lib]], [target]; at a
/// workspace root, every member). Both run as `<this fid> ark ...` in a
/// child process: ark then builds each target with this compiler (run as
/// `fid build`, ark_main would take its compiler from PATH) and reads its
/// words from argv, also inside a `fid serve` request.
fn project_build(n: i64, start: i64) -> i64 {
    var self_exe: str = project_shell_word(p_argv(0));
    var flags: str = "";
    var dry: bool = false;
    var i: i64 = start + 1;
    while i < n {
        var a: str = argv_at(i);
        if a == "--dry-run" || a == "-n" {
            dry = true;
        }
        flags = flags + " " + project_shell_word(a);
        i = i + 1;
    }
    if !dry && project_needs_install() {
        print("Installing the dependencies of ark.toml (ark install)\n");
        if project_run(self_exe + " ark install") != 0 {
            p_eprint_str("fid build: `ark install` failed: the dependencies of ark.toml are not installed\n");
            return 1;
        }
    }
    if project_run(self_exe + " ark build" + flags) != 0 {
        return 1;
    }
    return 0;
}

/// SP13: a debug build on the machine layer (`emit --debug` with a Linux,
/// macOS or `--nat` target) keeps per-function caches beside its output,
/// so the next debug build of an edited program redoes only what the edit
/// changed (docs/perf/sp13-debug-caches.md):
///   - the machine code of each function (nat_ir.fd CS6/SP7, FID_FNCACHE)
///     in `<output>.fides-fncache`; under `fid serve` it stays in the
///     server's memory instead (g_nat_fncache_mem, cmd_serve);
///   - with `--ir-cache` (or FID_DEBUG_IRCACHE=1), the lowered IR of each
///     function (ir_ser.fd CS4, FID_IRCACHE) in `<output>.fides-ircache`.
///     Not by default: ir_ser's records write every byte as eight words
///     (a 357 MB file for a small program, lowering 4.6x slower cold).
/// The function cache's file reaches nat_ir through g_nat_fncache_path,
/// the IR cache's through inc.fd env_override_set (this process only).
/// A variable the user set wins (FID_FNCACHE=0, off, no,
/// none or false: no function cache); `--no-cache`, `--no-fncache` and
/// FIDES_NO_CACHE keep both off, as for the Windows cache (pe_ir B5).
fn debug_cache_setup(n: i64, start: i64, out: str) {
    if has_flag(n, start, "--no-cache") || has_flag(n, start, "--no-fncache") || str_len(env_or_empty("FIDES_NO_CACHE")) > 0 {
        return;
    }
    if str_len(out) == 0 {
        return;
    }
    // SP6: the default goes through g_nat_fncache_path, not FID_FNCACHE,
    // so nat_ir.fd nc_path_pick still applies its exclusions (--stats,
    // FID_VERIFY, dump-mir, FID_NAT_PAR) and a FID_FNCACHE the user set
    // (a file, mem, or 0/off/no/none/false: none) is read there as given
    var fv: str = env_or_empty("FID_FNCACHE");
    if str_len(fv) == 0 && !g_nat_fncache_mem {
        g_nat_fncache_path = out + ".fides-fncache";
    }
    if has_flag(n, start, "--ir-cache") || env_or_empty("FID_DEBUG_IRCACHE") == "1" {
        if str_len(env_or_empty("FID_IRCACHE")) == 0 {
            env_override_set("FID_IRCACHE", out + ".fides-ircache");
        }
    }
}

/// SP18: what a build request of `fid serve` set in the back ends through
/// its flags, put back to the defaults after the request (compiler.fd
/// serve_reset_build_state does the front end's), so the next request
/// builds as its one-shot run would: `--debug` (the fast allocator),
/// `--size`, `--stats`, `--cpu`, `--leaks`, `--checked-alloc`, `--load`,
/// `--explain`/dump-mir, the line table, and the debug caches' variables.
/// The function cache stays in memory (g_nat_fncache_mem).
fn serve_reset_backend_state() {
    g_nat_fast = false;
    g_nat_size = false;
    g_nat_stats = false;
    g_nat_cpu = "";
    g_nat_pie_req = 0;
    g_nat_leaks = false;
    g_nat_mem_profile = false;
    g_nat_dump = "";
    g_nat_trace = false;
    g_nat_lines_names = "";
    g_nat_lines_file = "";
    g_pe_checked_alloc = false;
    g_pe_leaks = false;
    g_pe_bare_boot_load = 0x100000;
    env_override_clear();
    g_nat_fncache_path = "";
    g_nat_fncache_mem = true;
    iropt_clear_remarks();
    g_nat_win_dwarf = false;
    g_nat_dbg_frames = false;
    nat_dbg_set_full_paths(false);
    g_pe_dbg_shown_pairs = Vec::new();
    g_pdb_out = "";
    ir_value_files_reset();
    // BG50: the C generator's switches a ccompile request sets (--profile,
    // --leaks, --mem, --checked-alloc, --inc, --lib); before, a later
    // request without the flag still built with the debug allocator
    set_c_profile(false);
    set_c_leaks(false);
    set_c_mem_profile(false);
    set_c_checked_alloc(false);
    set_c_mem_source("", "");
    set_c_unit_marks(false);
    CGen_lib_set(false);
    clear_c_debug_info();
    CGen_lib_reset_exports();
}

/// L2B: `--target universal` (also `universal-macos`, `universal-darwin`,
/// `macos-universal`): a macOS universal ("fat") binary.
fn is_universal_target(target: str) -> bool {
    return target == "universal" || target == "universal-macos" || target == "universal-darwin" || target == "macos-universal" || target == "universal-apple-darwin";
}

/// L2B: `fid emit|build <file> --target universal [-o <out>] [flags]`: one
/// sub-build per slice (`--target x86_64-macos`, then `aarch64-macos`,
/// each this compiler run again with the other flags kept, so each slice
/// is byte for byte the thin build), joined by nat_enc.fd nat_macho_fat
/// into <out>, which `lipo -info` reports as "x86_64 arm64". A `--cpu`
/// goes to the slice whose target knows the name (both for `baseline`/
/// `native`); one that neither knows is refused before anything is built.
fn build_universal_macho(n: i64, start: i64) -> i64 {
    var command: str = argv_at(start);
    var input: str = argv_at(start + 1);
    var output: str = find_output_arg(n, start, "a.out");
    var arch_x: i64 = nat_target_arch("x86_64");
    var arch_a: i64 = nat_target_arch("aarch64");
    var cpu: str = get_flag_value(n, start, "--cpu", "");
    var cpu_x: str = cpu;
    var cpu_a: str = cpu;
    if str_len(cpu) > 0 {
        var err_x: str = nat_cpu_check(arch_x, cpu);
        var err_a: str = nat_cpu_check(arch_a, cpu);
        if str_len(err_x) > 0 && str_len(err_a) > 0 {
            print("Error: --target universal: --cpu " + cpu + " is a CPU of neither slice (x86_64-macos, aarch64-macos)\n");
            print(err_x + "\n");
            print(err_a + "\n");
            return 1;
        }
        if str_len(err_x) > 0 {
            cpu_x = "";
        }
        if str_len(err_a) > 0 {
            cpu_a = "";
        }
    }
    // the words passed on: the global flags before the command, then every
    // flag after the file but --target, -o and --cpu (given per slice)
    var pre: str = "";
    var i: i64 = 1;
    while i < start {
        pre = pre + " " + project_shell_word(argv_at(i));
        i = i + 1;
    }
    var rest: str = "";
    i = start + 2;
    while i < n {
        var a: str = argv_at(i);
        if (a == "--target" || a == "-o" || a == "--cpu") && i + 1 < n {
            i = i + 2;
            continue;
        }
        rest = rest + " " + project_shell_word(a);
        i = i + 1;
    }
    p_eprint_str("[build] Target: universal (macOS): x86_64-macos and aarch64-macos slices\n");
    var part_x: str = output + ".x86_64.part";
    var part_a: str = output + ".arm64.part";
    var base: str = project_shell_word(p_argv(0)) + pre + " " + command + " " + project_shell_word(input);
    var cmd_x: str = base + " --target x86_64-macos -o " + project_shell_word(part_x) + rest;
    if str_len(cpu_x) > 0 {
        cmd_x = cmd_x + " --cpu " + project_shell_word(cpu_x);
    }
    var cmd_a: str = base + " --target aarch64-macos -o " + project_shell_word(part_a) + rest;
    if str_len(cpu_a) > 0 {
        cmd_a = cmd_a + " --cpu " + project_shell_word(cpu_a);
    }
    if project_run(cmd_x) != 0 {
        p_file_delete(part_x);
        print("Error: --target universal: the x86_64-macos slice did not build\n");
        return 1;
    }
    if project_run(cmd_a) != 0 {
        p_file_delete(part_x);
        p_file_delete(part_a);
        print("Error: --target universal: the aarch64-macos slice did not build\n");
        return 1;
    }
    var bytes_x: Vec<i64> = p_file_read_bytes(part_x);
    var bytes_a: Vec<i64> = p_file_read_bytes(part_a);
    p_file_delete(part_x);
    p_file_delete(part_a);
    if bytes_x.len() == 0 || bytes_a.len() == 0 {
        print("Error: --target universal: a slice was not written (" + part_x + ", " + part_a + ")\n");
        return 1;
    }
    var fat: Vec<i64> = nat_macho_fat(bytes_x, bytes_a);
    if fat.len() == 0 {
        print("Error: --target universal: the two slices are not an x86-64 and an AArch64 Mach-O\n");
        return 1;
    }
    if !write_output_vec(output, fat) {
        return 1;
    }
    if is_posix_host() {
        p_system("chmod +x '" + output + "' 2>/dev/null");
    }
    print("Built universal executable: " + output + " (x86_64 arm64, " + int_to_str(fat.len()) + " bytes)\n");
    return 0;
}

// --- F32 (serverless): a handler as the entry point -------------------------
// `fid emit|build|ccompile <file> --entry <handler>`: the executable runs
// one request through <handler> and exits. The program's own `main` (if
// any) is renamed out of the way and a generated `main` calls the handler,
// so `emit` lowers only what compiler/reach.fd finds from the handler (its
// roots: main, core, the runtime, annotated functions) and the process
// does nothing at start-up but the runtime's own set-up. The request is
// argv[1], else one line of standard input; the response goes to stdout.
// A handler takes no parameter or one `str`, and returns `str`, an
// integer, `bool` or nothing. Benchmark: bench/coldstart.sh.

/// The name the program's own `main` takes under `--entry`.
const ENTRY_USER_MAIN: str = "fid_entry_program_main";

/// `source` with its top-level `fn main(` (also `pub fn main(`) renamed
/// to ENTRY_USER_MAIN; the same text when there is none.
fn entry_rename_main(source: str) -> str {
    var lines: Vec<str> = str_split(source, "\n");
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < lines.len() {
        var l: str = lines.get(i);
        if str_starts_with(l, "fn main(") || str_starts_with(l, "fn main (") {
            l = "fn " + ENTRY_USER_MAIN + str_slice(l, 7, str_len(l));
        } else if str_starts_with(l, "pub fn main(") || str_starts_with(l, "pub fn main (") {
            l = "pub fn " + ENTRY_USER_MAIN + str_slice(l, 11, str_len(l));
        }
        out.push(l);
        i = i + 1;
    }
    return str_join(out, "\n");
}

/// The source of `fn main()` that runs one request through `handler`
/// (`f`, as parsed), or "" with the reason in `why` when `f` cannot be an
/// entry point.
fn entry_main_text(f: Func, why: &mut Vec<str>) -> str {
    var takes_req: bool = false;
    if f.params.len() == 1 {
        var pt: str = type_to_str(f.params.get(0).ty);
        if pt != "str" && pt != "&str" {
            why.push("--entry " + f.name + ": its parameter is " + pt + ": a handler takes the request as one `str` (or nothing)");
            return "";
        }
        takes_req = true;
    } else if f.params.len() > 1 {
        why.push("--entry " + f.name + ": it has " + int_to_str(f.params.len()) + " parameters: a handler takes the request as one `str` (or nothing)");
        return "";
    }
    if f.type_params.len() > 0 {
        why.push("--entry " + f.name + ": a generic function cannot be an entry point");
        return "";
    }
    var call: str = f.name + "()";
    if takes_req {
        call = f.name + "(fid_entry_req)";
    }
    var rt: str = type_to_str(f.ret_ty);
    var body: str = "";
    if rt == "str" {
        body = "    println(" + call + ");\n";
    } else if rt == "i64" || rt == "i32" || rt == "i16" || rt == "i8" || rt == "u64" || rt == "u32" || rt == "u16" || rt == "u8" {
        body = "    println(int_to_str((" + call + ") as i64));\n";
    } else if rt == "bool" {
        body = "    if " + call + " {\n        println(\"true\");\n    } else {\n        println(\"false\");\n    }\n";
    } else if rt == "void" {
        body = "    " + call + ";\n";
    } else {
        why.push("--entry " + f.name + ": it returns " + rt + ": a handler returns `str`, an integer, `bool` or nothing");
        return "";
    }
    var text: str = "\n// `--entry " + f.name + "`: the process runs one request (argv[1], else one\n// line of standard input) through the handler (compiler/main.fd)\nfn main() {\n";
    if takes_req {
        text = text + "    var fid_entry_req: str = \"\";\n";
        text = text + "    match arg_at(1) {\n        Option::Some(fid_entry_arg) => {\n            fid_entry_req = fid_entry_arg;\n        }\n";
        text = text + "        Option::None => {\n            match read_line() {\n                Option::Some(fid_entry_line) => {\n                    fid_entry_req = fid_entry_line;\n                }\n                Option::None => {\n                }\n            }\n        }\n    }\n";
    }
    return text + body + "}\n";
}

/// F32: `source` (of `input`) with `handler` as its entry point
/// (entry_rename_main, entry_main_text), or the errors.
fn entry_wrap_source(source: str, input: str, handler: str) -> ResultStr {
    if handler == "main" || handler == ENTRY_USER_MAIN {
        return ResultStr::Err(c_vec1("--entry main: name the handler function (main is the default entry point)"));
    }
    var lx: Lexer = Lexer::new(source);
    var ps: Parser = Parser_new(lx.tokenize());
    var found: bool = false;
    var has_main: bool = false;
    var why: Vec<str> = Vec::new();
    var main_text: str = "";
    var annotated: bool = false;
    match ps.parse() {
        ParseResultProgram::Ok(prog) => {
            var i: i64 = 0;
            while i < prog.funcs.len() {
                var f: Func = prog.funcs.get(i);
                if f.name == "main" {
                    has_main = true;
                }
                if f.name == handler && !found {
                    found = true;
                    main_text = entry_main_text(f, &mut why);
                    var ai: i64 = 0;
                    while ai < f.annotations.len() {
                        var an: str = f.annotations.get(ai).name;
                        if an == "serverless" || an == "@serverless" {
                            annotated = true;
                        }
                        ai = ai + 1;
                    }
                }
                i = i + 1;
            }
        }
        ParseResultProgram::Err(_) => {
            // the front end reports the parse errors of the file itself
            return ResultStr::Ok(source);
        }
    }
    if !found {
        return ResultStr::Err(c_vec1("--entry " + handler + ": " + input + " has no top-level function of that name (a method cannot be an entry point)"));
    }
    if why.len() > 0 {
        return ResultStr::Err(why);
    }
    var text: str = source;
    if has_main {
        text = entry_rename_main(source);
        if text == source {
            return ResultStr::Err(c_vec1("--entry " + handler + ": the program's `main` is not written at the start of a line (`fn main(`): it cannot be set aside"));
        }
    }
    if !annotated {
        p_eprint_str("note: --entry " + handler + ": not marked @serverless, so its cold-start rules (no global writes, no costly global initializers, no tasks) are not checked\n");
    }
    p_eprint_str("[build] Entry point: " + handler + " (one request: argv[1], else a line of stdin; the response on stdout)\n");
    if !str_ends_with(text, "\n") {
        text = text + "\n";
    }
    return ResultStr::Ok(text + main_text);
}

/// F32: the source a build compiles: `source` itself, or with `--entry`'s
/// handler as the entry point. Empty (errors printed) when that fails.
fn entry_source_for(n: i64, start: i64, source: str, input: str) -> str {
    var handler: str = get_flag_value(n, start, "--entry", "");
    if str_len(handler) == 0 {
        return source;
    }
    match entry_wrap_source(source, input, handler) {
        ResultStr::Ok(t) => {
            return t;
        }
        ResultStr::Err(errs) => {
            var i: i64 = 0;
            while i < errs.len() {
                print("Error: " + errs.get(i) + "\n");
                i = i + 1;
            }
        }
    }
    return "";
}

fn cmd_build(n: i64, start: i64, g_borrowck: str, g_timeout: i64) -> i64 {
    var t_start: i64 = p_clock_now_ms();
    if has_flag(n, start, "--time") {
        set_time_on();
    }
    // L5B/L5F: `fid build` without a file in a directory with an ark.toml
    // is the project's build: `ark build` (compiler/ark.fd ark_main), which
    // at a workspace root builds every member (each with `fid build` in
    // its directory, so the same compiler) and the root's own package
    // (ark_main reads the command at argv[1]: global flags before `build`
    // would be read as the command, so only a plain `fid build [flags]`)
    if (start + 2 > n || str_starts_with(argv_at(start + 1), "-")) && p_file_exists("ark.toml") != 0 {
        return project_build(n, start);
    }
    if start + 2 > n {
        print("Usage: fid build <file.fd> [-o output] [--target <triple>] [--no-opt] [--lto] [--caps <list>]\n");
        print("       fid build            (in a project or workspace: its ark.toml's targets)\n");
        return 1;
    }

    // CI7: `fid build --lib` is the C path's library build (ccompile --lib):
    // the native backends write no shared library yet
    if has_flag(n, start, "--lib") {
        return cmd_ccompile(n, start, g_borrowck, g_timeout);
    }

    var input: str = argv_at(start + 1);
    var output: str = find_output_arg(n, start, "a.out");
    output = ensure_exe_extension(output);

    // --target <triple> (default: x86-64); TL6: `linux-arm64` and the like
    // read as `aarch64-linux`
    // MI11/TG5/RL10: dump-mir, disasm and ir-fuzz read the machine layer's
    // output: x86-64 Linux unless --target (or --nat) says otherwise (the
    // code is the same on any host)
    var target_default: str = "x86-64";
    if (g_main_dump_mir || g_main_disasm || g_main_irfuzz) && !has_flag(n, start, "--nat") {
        target_default = "x86_64-linux";
    }
    var target: str = normalize_target(get_flag_value(n, start, "--target", target_default));
    // MI18: `fid codegen` chose the machine layer's target (cmd_codegen)
    if str_len(g_main_codegen_target) > 0 {
        target = g_main_codegen_target;
    }
    // L2B: `--target universal`: a macOS fat binary of two sub-builds
    // (build_universal_macho); not for the views that read one image
    if is_universal_target(target) && !g_main_dump_mir && !g_main_disasm && !g_main_irfuzz && !has_flag(n, start, "--obj") && !has_flag(n, start, "--explain") && !has_flag(n, start, "--stages") {
        return build_universal_macho(n, start);
    }
    if is_universal_target(target) {
        print("Error: --target universal writes a fat binary of two builds: dump-mir, disasm, ir-fuzz, --obj and --explain take one slice (--target x86_64-macos or aarch64-macos)\n");
        return 1;
    }
    // CO2: a built program reads FIDES_TRACE when it runs
    if has_flag(n, start, "--trace-spans") {
        p_eprint_str("note: --trace-spans: run the program with FIDES_TRACE=1 to print its trace spans\n");
    }
    // TL6: a Windows executable from any host comes from pe_ir (machine
    // code and the PE writer are Fides: no C compiler, no download)
    var cross_windows: bool = cross_target_os(target) == "windows";
    if cross_windows && cross_target_arch(target) != "" && cross_target_arch(target) != "x86_64" {
        print("Unknown --target '" + target + "': Windows executables are x86-64 (x86_64-windows)\n");
        return 1;
    }
    if cross_windows {
        output = find_output_arg(n, start, "a.exe");
        if !str_ends_with(output, ".exe") {
            output = output + ".exe";
        }
    }
    // DB7: `--explain <fn>` (also `fid explain <file> --stages <fn>`): the
    // function's IR after each stage of the native pipeline, then its
    // machine code; no file is written. Without --target: x86-64 Linux
    // (the code is the same on any host).
    var explain_fn: str = get_flag_value(n, start, "--explain", "");
    if str_len(explain_fn) == 0 {
        explain_fn = get_flag_value(n, start, "--stages", "");
    }
    if str_len(explain_fn) > 0 && target == "x86-64" {
        target = "x86_64-linux";
    }
    // DB7: the machine layer prints the function's MIR after selection,
    // after each MIR pass and after allocation (nat_ir.fd g_nat_dump)
    if str_len(explain_fn) > 0 {
        g_nat_dump = explain_fn;
    }
    // DB8: `--remarks`: why checks were removed (and how many stayed) per
    // function, and spills per function on the native layer (RA17's
    // --stats), on stderr
    var remarks: bool = has_flag(n, start, "--remarks");
    if remarks {
        // DB8: iropt notes why calls were not inlined
        iropt_set_remarks();
    }
    // --no-opt: disable PIR optimizer (enabled by default)
    var do_opt: bool = !has_flag(n, start, "--no-opt");
    // --debug (SP13): fastest correct build — no mid-end at all
    // (iropt, rules and the e-graph all skipped), default codegen.
    var debug_mode: bool = has_flag(n, start, "--debug");
    // CE8: -g: a panic prints the failing frame's values (nat_ir.fd ng_dbg_frames_data)
    if has_flag(n, start, "-g") {
        g_nat_dbg_frames = true;
    }
    if debug_mode {
        do_opt = false;
    }
    // --lto: enable link-time optimization
    var do_lto: bool = has_flag(n, start, "--lto");
    // --native: use native backend (ELF64/PE) instead of C codegen
    var use_native: bool = has_flag(n, start, "--native");
    // MI18: `--native` is the machine layer (nat_ir) on every target. The
    // default target, x86-64, is a Linux executable, as the old PIR path
    // (compiler.fd build_executable) built; arm64/riscv64 are Linux too. A
    // Windows target stays on pe_ir, the Windows default.
    if use_native {
        if target == "x86-64" || target == "x64" || target == "x86_64" || target == "amd64" {
            target = "x86_64-linux";
        } else if target == "arm64" || target == "aarch64" {
            target = "aarch64-linux";
        } else if target == "riscv64" || target == "riscv" || target == "rv64" {
            target = "riscv64-linux";
        }
        if cross_windows {
            use_native = false;
        }
    }
    // TG12: `--obj` writes an object file (ELF ET_REL, COFF or Mach-O) of
    // the machine layer's code for linking with C, from nat_enc.fd's
    // object writer (nat_emit_object)
    var obj_mode: bool = has_flag(n, start, "--obj") || str_len(g_main_codegen_obj) > 0;
    // --bare: bare-metal mode (skip stdlib, flat binary)
    var bare_mode: bool = has_flag(n, start, "--bare");
    // --checked-alloc: native blocks on pages of their own (release M7)
    if has_flag(n, start, "--checked-alloc") {
        g_pe_checked_alloc = true;
    }
    // RL16: --leaks on pe_ir (the machine layer's is g_nat_leaks, below)
    if has_flag(n, start, "--leaks") {
        g_pe_leaks = true;
    }
    // --boot: multiboot2 boot mode (skip stdlib, generate boot binary)
    var boot_mode: bool = has_flag(n, start, "--boot");
    // Release G1/G4: `--boot` is the bootable bare image (Multiboot 1 and 2,
    // long mode, IDT), the same as `--bare`; `--load <address>` moves it
    // (default 0x100000). PEIR_BARE_BOOT off: the old pe.fd kernel.
    if boot_mode && PEIR_BARE_BOOT {
        boot_mode = false;
        bare_mode = true;
    }
    if bare_mode {
        var load_arg: str = get_flag_value(n, start, "--load", "");
        if str_len(load_arg) > 0 {
            var load_val: i64 = 0;
            if str_starts_with(load_arg, "0x") || str_starts_with(load_arg, "0X") {
                load_val = str_parse_hex(load_arg);
            } else {
                load_val = str_parse_int(load_arg);
            }
            g_pe_bare_boot_load = load_val;
        }
    }
    // --caps <list>: capability restrictions
    var caps: str = get_flag_value(n, start, "--caps", "");
    // Split "IO,Net" -> ["IO","Net"] for build_executable's granted_caps
    var granted_caps: Vec<str> = Vec::new();
    if str_len(caps) > 0 {
        var cap_parts: Vec<str> = str_split(caps, ",");
        var ci: i64 = 0;
        while ci < cap_parts.len() {
            var cap_name: str = str_trim(cap_parts.get(ci));
            if str_len(cap_name) > 0 {
                granted_caps.push(cap_name);
            }
            ci = ci + 1;
        }
    }

    // Report global flags
    if g_borrowck != "on" {
        p_eprint_str("[build] borrowck mode: ");
        p_eprint_str(g_borrowck);
        p_eprint_str("\n");
    }
    // G8.2: borrowck mode is passed through the pipeline via parameter

    p_eprint_str("[build] Reading source file: ");
    p_eprint_str(input);
    p_eprint_str("\n");
    p_eprint_str("[build] Target: ");
    p_eprint_str(target);
    p_eprint_str(", opt: ");
    if do_opt {
        p_eprint_str("on");
    } else {
        p_eprint_str("off");
    }
    p_eprint_str(", lto: ");
    if do_lto {
        p_eprint_str("on");
    } else {
        p_eprint_str("off");
    }
    p_eprint_str("\n");
    if str_len(caps) > 0 {
        p_eprint_str("[build] Caps: ");
        p_eprint_str(caps);
        p_eprint_str("\n");
    }

    var source: str = "";
    if g_main_irfuzz {
        // RL10: the template whose fz_target the random IR replaces
        source = irfuzz_template(g_main_irfuzz_seed);
        input = "ir-fuzz-" + int_to_str(g_main_irfuzz_seed) + ".fd";
    } else {
        source = c_file_read(input);
    }
    if str_len(source) == 0 {
        print("Error: could not read file: ");
        print(input);
        print("\n");
        return 1;
    }
    // F32: `--entry <handler>`: the handler is the entry point
    source = entry_source_for(n, start, source, input);
    if str_len(source) == 0 {
        return 1;
    }
    var t_run: i64 = time_mark("read+args", t_start);
    p_eprint_str("[build] Source read ok. Compiling...\n");

    // --boot is the bootable bare image of pe_ir (above). MI18: the old
    // pe.fd kernel (PIR L3 -> codegen_x64 -> pe.fd generate_boot_binary)
    // that PEIR_BARE_BOOT off used to select was removed with the PIR path.
    if boot_mode {
        print("Error: --boot without PEIR_BARE_BOOT: the old pe.fd kernel was removed with the PIR path (MI18); --boot and --bare build the bootable image through pe_ir\n");
        return 1;
    }

    // --elf (or --target linux): a static Linux x86-64 executable. Release
    // F4: it goes to the machine-layer backend below (compiler/nat_ir.fd,
    // with the stdlib and the Linux runtime), as `--target x86_64-linux`.
    // FID_ELF_PEIR=1 keeps the old pe_ir ELF path (no stdlib). MI18: under
    // `fid codegen`, --elf <o> names its object file (cmd_codegen), and the
    // target is codegen's.
    var elf_peir: bool = str_len(env_or_empty("FID_ELF_PEIR")) > 0;
    var elf_flag: bool = has_flag(n, start, "--elf") && str_len(g_main_codegen_target) == 0;
    if (elf_flag || target == "linux") && !elf_peir {
        target = "x86_64-linux";
    }
    if (elf_flag || target == "linux") && elf_peir {
        var elf_out: str = find_output_arg(n, start, "a.out");
        p_eprint_str("[build] ELF mode: static Linux x86-64 executable (no stdlib yet)...\n");
        var elf_result: ResultProgram = build_program_no_std(source, OptStr::Some(input));
        match elf_result {
            ResultProgram::Err(errs) => {
                print("Compilation errors:\n");
                var eei: i64 = 0;
                while eei < errs.len() {
                    print(errs.get(eei));
                    print("\n");
                    eei = eei + 1;
                }
                return 1;
            }
            ResultProgram::Ok(program) => {
                var elf_ir: IrModule = lower(program);
                match pe_ir_generate_elf(elf_ir) {
                    ResultBytes::Ok(eb) => {
                        if !write_output_vec(elf_out, eb) {
                            return 1;
                        }
                        print("Emitted Linux executable: " + elf_out + " (" + int_to_str(eb.len()) + " bytes, static, no stdlib)\n");
                        return 0;
                    }
                    ResultBytes::Err(errs2) => {
                        print("Compilation errors:\n");
                        var eej: i64 = 0;
                        while eej < errs2.len() {
                            print(errs2.get(eej));
                            print("\n");
                            eej = eej + 1;
                        }
                        return 1;
                    }
                }
            }
        }
    }

    // --uefi (roadmap Phase 16): a UEFI application, a PE32+ image of
    // subsystem EFI_APPLICATION (compiler/pe_ir.fd pe_ir_generate_uefi);
    // no stdlib, as --bare. docs/reference/uefi.md, tests/uefi/run.sh.
    if has_flag(n, start, "--uefi") {
        p_eprint_str("[build] UEFI mode: generating a UEFI application...\n");
        match build_program_no_std(source, OptStr::Some(input)) {
            ResultProgram::Err(errs) => {
                print("Compilation errors:\n");
                var uei: i64 = 0;
                while uei < errs.len() {
                    print(errs.get(uei));
                    print("\n");
                    uei = uei + 1;
                }
                return 1;
            }
            ResultProgram::Ok(program) => {
                var uhandler: str = "";
                var uhi: i64 = 0;
                while uhi < program.funcs.len() {
                    var uhf: Func = program.funcs.get(uhi);
                    var uai: i64 = 0;
                    while uai < uhf.annotations.len() {
                        var uan: str = uhf.annotations.get(uai).name;
                        if uan == "panic_handler" || uan == "@panic_handler" {
                            uhandler = uhf.name;
                        }
                        uai = uai + 1;
                    }
                    uhi = uhi + 1;
                }
                var uir: IrModule = lower(program);
                match pe_ir_generate_uefi(uir, uhandler) {
                    ResultBytes::Ok(img) => {
                        var uefi_out: str = find_output_arg(n, start, "a.efi");
                        if !write_output_vec(uefi_out, img) {
                            return 1;
                        }
                        print("Emitted UEFI application: " + uefi_out + " (" + int_to_str(img.len()) + " bytes)\n");
                        return 0;
                    }
                    ResultBytes::Err(errs2) => {
                        print("Compilation errors:\n");
                        var uej: i64 = 0;
                        while uej < errs2.len() {
                            print(errs2.get(uej));
                            print("\n");
                            uej = uej + 1;
                        }
                        return 1;
                    }
                }
            }
        }
    }

    // --bare mode: flat binary (no stdlib)
    if bare_mode {
        p_eprint_str("[build] Bare mode: generating flat binary...\n");
        var bare_result: ResultProgram = build_program_no_std(source, OptStr::Some(input));
        match bare_result {
            ResultProgram::Err(errs) => {
                print("Compilation errors:\n");
                var ei: i64 = 0;
                while ei < errs.len() {
                    print(errs.get(ei));
                    print("\n");
                    ei = ei + 1;
                }
                return 1;
            }
            ResultProgram::Ok(program) => {
                // The @panic_handler a panic (and a failed check) calls
                var handler: str = "";
                var hfi: i64 = 0;
                while hfi < program.funcs.len() {
                    var hf: Func = program.funcs.get(hfi);
                    var hai: i64 = 0;
                    while hai < hf.annotations.len() {
                        var an: str = hf.annotations.get(hai).name;
                        if an == "panic_handler" || an == "@panic_handler" {
                            handler = hf.name;
                        }
                        hai = hai + 1;
                    }
                    hfi = hfi + 1;
                }
                p_eprint_str("[build] Lowering to IR...\n");
                var t_lw: i64 = p_clock_now_ms();
                var ir_mod: IrModule = lower(program);
                p_eprint_str("[prof] lower: " + int_to_str(p_clock_now_ms() - t_lw) + "ms\n");
                p_eprint_str("[build] Generating flat binary (pe_ir)...\n");
                var bin: Vec = Vec::new();
                match pe_ir_generate_flat(ir_mod, handler) {
                    ResultBytes::Ok(b) => {
                        bin = b;
                    }
                    ResultBytes::Err(errs) => {
                        print("Compilation errors:\n");
                        var bei: i64 = 0;
                        while bei < errs.len() {
                            print(errs.get(bei));
                            print("\n");
                            bei = bei + 1;
                        }
                        return 1;
                    }
                }
                // A flat binary is not an .exe: the -o name as given
                var bare_out: str = find_output_arg(n, start, "a.bin");
                if !write_output_vec(bare_out, bin) {
                    return 1;
                }
                print("Emitted bare-metal binary: ");
                print(bare_out);
                print(" (");
                print(int_to_str(bin.len()));
                if pe_bare_boot_on() {
                    print(" bytes, no stdlib, Multiboot kernel, load at 0x" + int_to_hex(g_pe_bare_boot_load) + ")\n");
                } else {
                    print(" bytes, no stdlib, no PE headers, load at 0x10000)\n");
                }
                return 0;
            }
        }
    }

    // CB4 (complaint roadmap): on a Linux or macOS host, `fid build` with
    // no --target builds for this machine through the machine layer (an
    // ELF or a signed Mach-O written by nat_enc.fd: no C compiler, no
    // linker), as Windows builds through pe_ir. `--via-c` (or
    // FIDES_BUILD_VIA_C=1) keeps the old route: C codegen + gcc/clang/cc.
    // A program the machine layer rejects (a builtin its runtime does not
    // have yet) goes on through C by itself (`host_auto`, below); an
    // explicit --target never falls back.
    var host_auto: bool = false;
    var nat_fallback: bool = false;
    if is_posix_host() && target == "x86-64" && str_len(get_flag_value(n, start, "--target", "")) == 0 && !use_native && !has_flag(n, start, "--nat") && !has_flag(n, start, "--via-c") && str_len(env_or_empty("FIDES_BUILD_VIA_C")) == 0 && !bare_mode && !boot_mode && !has_flag(n, start, "--elf") {
        target = host_native_target();
        host_auto = !g_main_dump_mir && !g_main_disasm && !g_main_irfuzz && str_len(explain_fn) == 0 && !obj_mode;
        p_eprint_str("[build] Host target: " + target + " (machine layer; --via-c: C compiler)\n");
    }

    // Native Linux AArch64 / RISC-V 64 (release F8): IR -> machine code in
    // compiler/nat_ir.fd, the Fides runtime of stdlib/linux_runtime, a
    // static ELF. `--target aarch64-linux` / `riscv64-linux`; `--native`
    // with `--target arm64|riscv64` (the old PIR path) comes here too.
    var nat_arch: i64 = 0;
    if str_contains(target, "linux") || str_contains(target, "macos") || str_starts_with(target, "thumb") || use_native {
        nat_arch = nat_target_arch(target);
    }
    // `--nat`: Windows x64 through the same layer (a PE; the Linux runtime
    // over kernel32, stdlib/linux_runtime/win.fd). pe_ir stays the default.
    var nat_win: bool = (has_flag(n, start, "--nat") || g_main_codegen_nat) && (target == "" || str_contains(target, "windows") || (!is_posix_host() && !str_contains(target, "linux")));
    if nat_win {
        nat_arch = nat_target_arch("x86_64");
    }
    // `--target aarch64-macos|x86_64-macos` (F7): a Mach-O; the Linux
    // runtime over libSystem (stdlib/linux_runtime/darwin.fd).
    var nat_mac: bool = str_contains(target, "macos");
    if nat_arch != 0 && !bare_mode && !boot_mode {
        var nat_out: str = find_output_arg(n, start, "a.out");
        if nat_win {
            nat_out = ensure_exe_extension(find_output_arg(n, start, "a.exe"));
        }
        // --cpu <name> (TG10): the microarchitecture of the target, safe
        // default per target (nat_cpu_default); --stats (RA17): per-function
        // spill/reload/move counts on stderr.
        var cpu_arg: str = get_flag_value(n, start, "--cpu", "");
        if str_len(cpu_arg) > 0 {
            var cpu_err: str = nat_cpu_check(nat_arch, cpu_arg);
            if str_len(cpu_err) > 0 {
                print(cpu_err + "\n");
                return 1;
            }
            g_nat_cpu = cpu_arg;
        }
        // TG14: --pie / --no-pie (Linux targets; FID_NAT_ON=pie when neither)
        g_nat_pie_req = 0;
        if has_flag(n, start, "--pie") {
            g_nat_pie_req = 1;
        }
        if has_flag(n, start, "--no-pie") {
            g_nat_pie_req = 0 - 1;
        }
        if has_flag(n, start, "--stats") || remarks {
            g_nat_stats = true;
        }
        // SP13: a debug build (no mid-end, above) also takes the fast
        // allocator of RA14 (nat_ir.fd; FID_NAT_FAST=1 does the same);
        // RA14: `--fast-alloc` (or `--fast`) takes it with the mid-end on
        if debug_mode || has_flag(n, start, "--fast-alloc") || has_flag(n, start, "--fast") {
            g_nat_fast = true;
        }
        // CT6: a `--nat` Windows debug build carries DWARF for gdb / lldb
        // (nat_ir.fd ng_dbg_win_dwarf, nat_enc.fd nat_pe_debug)
        if nat_win && (debug_mode || has_flag(n, start, "-g")) {
            g_nat_win_dwarf = true;
        }
        // SP13/CB3: every machine-layer build (debug or not) keeps its
        // per-function caches beside its output, so the next build after
        // an edit reuses what the edit did not change (debug_cache_setup;
        // FID_FNCACHE=0, --no-cache, --no-fncache, FIDES_NO_CACHE: none)
        if !g_main_dump_mir && !g_main_irfuzz && str_len(explain_fn) == 0 && !obj_mode {
            debug_cache_setup(n, start, nat_out);
        }
        // RL16: `--leaks`: the runtime reports the blocks never freed at
        // exit (--checked-alloc reaches nat_ir through g_pe_checked_alloc)
        if has_flag(n, start, "--leaks") {
            g_nat_leaks = true;
        }
        // L7C: `--mem`: the runtime's memory profile at exit (as
        // FID_MEM_PROFILE=1 at run time)
        if has_flag(n, start, "--mem") {
            g_nat_mem_profile = true;
        }
        // TG19: `--size`: smaller code over faster code (nat_ir g_nat_size:
        // no loop-head alignment, no inline vector bodies; the mid-end's
        // unrolling is off through iro_cli_off in compiler/checks.fd)
        if has_flag(n, start, "--size") {
            g_nat_size = true;
        }
        // MI11: dump-mir prints every function's machine IR (or --fn's)
        if g_main_dump_mir {
            g_nat_dump = get_flag_value(n, start, "--fn", "*");
        }
        // RL20: under --crash-report, each function's name before its code
        if crash_trace_on() {
            g_nat_trace = true;
        }
        set_native_runtime("linux_runtime");
        g_native_rt_win = nat_win;
        g_native_rt_mac = nat_mac;
        // @cfg sees the target, not the host
        g_cfg_os = "linux";
        if nat_win {
            g_cfg_os = "windows";
        }
        if nat_mac {
            g_cfg_os = "macos";
        }
        if str_contains(target, "riscv") {
            g_cfg_arch = "riscv64";
        } else if str_starts_with(target, "thumb") {
            g_cfg_arch = "arm";
        } else if nat_arch == nat_target_arch("x86_64") {
            g_cfg_arch = "x86_64";
        } else {
            g_cfg_arch = "aarch64";
        }
        crash_stage("front end (parse, type check, borrow check)");
        var nat_prog: ResultProgram = build_program_with_path_borrowck(source, OptStr::Some(input), g_borrowck);
        t_run = time_mark("front end", t_run);
        match nat_prog {
            ResultProgram::Err(nerrs) => {
                print("Compilation errors:\n");
                var nei: i64 = 0;
                while nei < nerrs.len() {
                    print(nerrs.get(nei));
                    print("\n");
                    nei = nei + 1;
                }
                return 1;
            }
            ResultProgram::Ok(nprogram) => {
                // The line table (DB1): rows for the functions of the input file
                var nl_lex: Lexer = Lexer::new(source);
                var nl_parser: Parser = Parser_new(nl_lex.tokenize());
                match nl_parser.parse() {
                    ParseResultProgram::Ok(nl_prog) => {
                        var nl_names: Vec<str> = Vec::new();
                        var nli: i64 = 0;
                        while nli < nl_prog.funcs.len() {
                            nl_names.push(nl_prog.funcs.get(nli).name);
                            nli = nli + 1;
                        }
                        g_nat_lines_names = str_join(nl_names, ",");
                        g_nat_lines_file = input;
                        // RL13 R2: the debug info writes the build's own
                        // paths only for --debug / -g (a debugger's build);
                        // otherwise names a second host reproduces
                        nat_dbg_set_full_paths(debug_mode || has_flag(n, start, "-g"));
                        // DB1: drop a previous build's inlined-code records
                        // (fid serve / LSP)
                        ir_value_files_reset();
                        // DB3: `--nat -g` writes <out>.pdb (only nat_enc.fd
                        // nat_pe_debug, Windows, calls pdb_attach)
                        pdb_setup(nat_out);
                        // DB1: the input file's methods too (imports were
                        // recorded by the import loops)
                        ir_note_program_files(&nl_prog, input);
                    }
                    ParseResultProgram::Err(_) => {
                    }
                }
                t_run = time_mark("line-table reparse", t_run);
                p_eprint_str("[build] Lowering to IR...\n");
                crash_stage("lowering");
                g_lower_keep = lw_keep_set(nprogram);
                var nat_mod: IrModule = lower(nprogram);
                g_lower_keep = 0;
                t_run = time_mark("lower", t_run);
                var nat_lc_errs: Vec<str> = c_lockcheck_errors(&nat_mod);
                if nat_lc_errs.len() > 0 {
                    print("Compilation errors:\n");
                    var nlci: i64 = 0;
                    while nlci < nat_lc_errs.len() {
                        print(nat_lc_errs.get(nlci));
                        print("\n");
                        nlci = nlci + 1;
                    }
                    return 1;
                }
                if str_len(explain_fn) > 0 {
                    explain_stage(&nat_mod, explain_fn, "after lowering");
                }
                // RL10: ir-fuzz puts its random function in place of the
                // template's fz_target (and prints the value main prints)
                if g_main_irfuzz {
                    if !irfuzz_install(&mut nat_mod, g_main_irfuzz_seed) {
                        return 1;
                    }
                }
                // D9 (release-roadmap): what no code can call goes before
                // the mid-end on the machine layer too, as PE88 does for
                // pe_ir (pe88_prune: the same roots, the whole runtime
                // kept). Not for an object file or a library (their
                // functions are called from outside) or ir-fuzz; should the
                // machine layer then miss a function the prune dropped, the
                // build is made again from every function (below).
                var nat_pruned: i64 = 0;
                if pe88_prune_on() && !obj_mode && !g_main_irfuzz && !has_flag(n, start, "--lib") {
                    crash_stage("prune (functions no code can call)");
                    nat_pruned = pe88_prune(&mut nat_mod);
                    t_run = time_mark("prune", t_run);
                }
                // ir-fuzz builds the random IR straight to machine code;
                // `--mid-end` runs the mid-end on it first
                var nat_mid: bool = !debug_mode && (!g_main_irfuzz || has_flag(n, start, "--mid-end"));
                // The mid-end (own-backend roadmap step 3-5): iropt's passes,
                // then the rules and pure-call merging; the IR verifier
                // after each stage with FID_VERIFY=1
                var nat_verify: bool = str_len(env_or_empty("FID_VERIFY")) > 0;
                var nat_t0: i64 = p_clock_now_ms();
                if nat_verify && !nat_verified(&nat_mod, "after lowering") {
                    return 1;
                }
                var nat_rr: Vec<i64> = Vec::new();
                nat_rr.push(0);
                nat_rr.push(0);
                var nat_eg: Vec<i64> = Vec::new();
                nat_eg.push(0);
                nat_eg.push(0);
                nat_eg.push(0);
                if nat_mid {
                    crash_stage("iropt (the mid-end's passes)");
                    iropt_native(&mut nat_mod);
                    t_run = time_mark("iropt", t_run);
                    if nat_verify && !nat_verified(&nat_mod, "after iropt") {
                        return 1;
                    }
                    if str_len(explain_fn) > 0 {
                        explain_stage(&nat_mod, explain_fn, "after iropt");
                    }
                    crash_stage("rules");
                    nat_rr = rules_run(&mut nat_mod);
                    t_run = time_mark("rules", t_run);
                    if nat_verify && !nat_verified(&nat_mod, "after rules") {
                        return 1;
                    }
                    if str_len(explain_fn) > 0 {
                        explain_stage(&nat_mod, explain_fn, "after the rules");
                    }
                    crash_stage("e-graph");
                    nat_eg = egraph_run(&mut nat_mod);
                    t_run = time_mark("egraph", t_run);
                    if nat_verify && !nat_verified(&nat_mod, "after the e-graph") {
                        return 1;
                    }
                    if str_len(explain_fn) > 0 {
                        explain_stage(&nat_mod, explain_fn, "after the e-graph");
                    }
                }
                if remarks {
                    print_remarks(nat_mod, explain_fn);
                }
                var nat_eg_placed: str = "";
                if nat_eg.len() > 2 {
                    nat_eg_placed = ", " + int_to_str(nat_eg.get(2)) + " placed by the e-graph";
                }
                p_eprint_str("[prof] native mid-end: " + int_to_str(p_clock_now_ms() - nat_t0) + "ms, " + int_to_str(nat_rr.get(0)) + " rewritten by rules, " + int_to_str(nat_rr.get(1)) + " pure calls merged, " + int_to_str(nat_eg.get(0)) + " loads forwarded, " + int_to_str(nat_eg.get(1)) + " rewritten by the e-graph" + nat_eg_placed + "\n");
                // RL10: --save-ir <file>: the module as it goes into the
                // machine layer, for `fid emit-ir` (a fuzzer's corpus, a
                // backend bug kept without its source)
                var save_ir: str = get_flag_value(n, start, "--save-ir", "");
                if str_len(save_ir) > 0 {
                    var ir_target: str = target;
                    if nat_win {
                        ir_target = "x86_64-windows";
                    }
                    if !ir_module_save(save_ir, &nat_mod, ir_target) {
                        print("Error: could not write " + save_ir + "\n");
                        return 1;
                    }
                    p_eprint_str("[build] IR saved: " + save_ir + "\n");
                }
                // TG12: an object file instead of an executable
                if obj_mode {
                    var obj_out: str = find_output_arg(n, start, "a.o");
                    // MI18: `fid codegen --elf|--coff|--macho <o>`
                    if str_len(g_main_codegen_obj) > 0 {
                        obj_out = g_main_codegen_obj;
                    }
                    return nat_write_object(nat_mod, nat_arch, nat_win, nat_mac, obj_out);
                }
                p_eprint_str("[build] Native Linux code generation...\n");
                crash_stage("native code (machine IR, allocation, encoding)");
                // SP2/RA14: `--time` shows the machine layer's own rows
                // (nat record, nat alloc+emit, ...) under "native code"
                var nat_time: bool = has_flag(n, start, "--time");
                if nat_time {
                    nat_set_time_on();
                }
                var nat_res: ResultBytes = ResultBytes::Err(Vec::new());
                if nat_win {
                    nat_res = nat_generate_pe(nat_mod);
                } else if nat_mac {
                    nat_res = nat_generate_macho(nat_mod, nat_arch);
                } else {
                    nat_res = nat_generate_elf(nat_mod, nat_arch);
                }
                t_run = time_mark("native code", t_run);
                if nat_time {
                    main_nat_time_rows();
                }
                // D9: the machine layer missed a function the prune dropped
                // (it names a call it cannot make): build again from every
                // function, as without the prune
                if nat_pruned > 0 && pe88_failed(nat_res) && pe88_names_dropped(nat_res) {
                    p_eprint_str("[build] note: the machine layer failed on the pruned module (" + int_to_str(nat_pruned) + " functions dropped); building again with every function (FID_PE_PRUNE=0 skips the prune)\n");
                    g_lower_keep = lw_keep_set(nprogram);
                    nat_mod = lower(nprogram);
                    g_lower_keep = 0;
                    if nat_mid {
                        iropt_native(&mut nat_mod);
                        nat_rr = rules_run(&mut nat_mod);
                        nat_eg = egraph_run(&mut nat_mod);
                    }
                    if nat_win {
                        nat_res = nat_generate_pe(nat_mod);
                    } else if nat_mac {
                        nat_res = nat_generate_macho(nat_mod, nat_arch);
                    } else {
                        nat_res = nat_generate_elf(nat_mod, nat_arch);
                    }
                    t_run = time_mark("again, unpruned", t_run);
                    if nat_time {
                        main_nat_time_rows();
                    }
                }
                // CB4: FID_NAT_REJECT=1 makes up a rejection, so the
                // fallback below can be tested with any program
                if host_auto && env_or_empty("FID_NAT_REJECT") == "1" {
                    nat_res = ResultBytes::Err(c_vec1("native backend: FID_NAT_REJECT=1 (a rejection made up to test the fallback)"));
                }
                match nat_res {
                    ResultBytes::Err(gerrs) => {
                        // CB4: a host build (no --target) the machine layer
                        // cannot do yet goes on through C, as --via-c would
                        if host_auto {
                            var gfi: i64 = 0;
                            while gfi < gerrs.len() {
                                p_eprint_str("[build] note: " + gerrs.get(gfi) + "\n");
                                gfi = gfi + 1;
                            }
                            p_eprint_str("[build] The machine layer cannot build this program yet: falling back to the C compiler (as --via-c)\n");
                            nat_fallback = true;
                        } else {
                            // CB9: a C function the image cannot reach,
                            // with its declaration and library, as the C
                            // path's link failure reports it (on the
                            // fallback above, the C path reports it)
                            var nat_lrep: str = link_error_report(str_join(gerrs, "\n"), source, input);
                            if str_len(nat_lrep) > 0 {
                                print(nat_lrep);
                            }
                            var gei: i64 = 0;
                            while gei < gerrs.len() {
                                print(gerrs.get(gei));
                                print("\n");
                                gei = gei + 1;
                            }
                            return 1;
                        }
                    }
                    ResultBytes::Ok(nat_bytes) => {
                        if str_len(explain_fn) > 0 {
                            explain_machine_code(nat_bytes, explain_fn, nat_win || nat_mac);
                            time_mark("total", t_start);
                            time_report();
                            return 0;
                        }
                        // MI11: the machine IR went to stderr; no image
                        if g_main_dump_mir {
                            p_eprint_str("[dump-mir] " + int_to_str(nat_bytes.len()) + " bytes of image not written\n");
                            return 0;
                        }
                        // TG5: the image's instructions, by function
                        if g_main_disasm {
                            // DB7: Mach-O targets through their LC_SYMTAB
                            var dfn: str = get_flag_value(n, start, "--fn", "");
                            var dlist: str = macho_disasm(nat_bytes, dfn);
                            if str_len(dlist) == 0 {
                                dlist = disasm_image(nat_bytes, dfn);
                            }
                            print(dlist);
                            return 0;
                        }
                        if !write_output_vec(nat_out, nat_bytes) {
                            return 1;
                        }
                        if is_posix_host() {
                            p_system("chmod +x '" + nat_out + "' 2>/dev/null");
                        }
                        t_run = time_mark("write", t_run);
                        time_mark("total", t_start);
                        time_report();
                        print("Built native executable: " + nat_out + "\n");
                        return 0;
                    }
                }
            }
        }
    }
    // CB4: back from a rejected machine-layer build: the C route below
    // merges no native runtime, and @cfg sees the host again
    if nat_fallback {
        native_runtime_reset();
        target = "x86-64";
    }

    // Windows default: emit a PE .exe directly via the pe_ir backend
    // (native, no C compiler). The pe_runtime sources must be merged into
    // the program, so the flag is set before build_program below.
    var windows_pe: bool = (!is_posix_host() || cross_windows) && !bare_mode && !boot_mode && !use_native && target != "arm64" && target != "aarch64" && target != "riscv64";
    // TG12: objects come from the machine layer's writer only
    if obj_mode {
        print("Error: --obj: object files come from the machine layer: add --nat (Windows) or a --target such as x86_64-linux, aarch64-linux, aarch64-macos\n");
        return 1;
    }
    // MI11/TG5/RL10: these read the machine layer, not pe_ir
    if g_main_dump_mir || g_main_disasm || g_main_irfuzz {
        print("Error: this command needs a machine-layer target: --target x86_64-linux|aarch64-linux|riscv64-linux|x86_64-macos|aarch64-macos, or --nat\n");
        return 1;
    }
    if windows_pe {
        set_pe_runtime_merge(true);
    }
    // OP20: --cpu for pe_ir too; B5: the cache file beside the output
    if windows_pe {
        var pe_cpu: str = get_flag_value(n, start, "--cpu", "");
        if str_len(pe_cpu) > 0 {
            var pe_cpu_err: str = nat_cpu_check(nat_target_arch("x86_64"), pe_cpu);
            if str_len(pe_cpu_err) > 0 {
                print(pe_cpu_err + "\n");
                return 1;
            }
        }
        pe_set_cpu(pe_cpu);
        pe_set_output_path(output);
    }
    // TL6: on a Linux or macOS host, @cfg and `use tls` see Windows
    if windows_pe && is_posix_host() {
        g_cfg_os = "windows";
        g_cfg_arch = "x86_64";
    }

    // Incremental build: skip all work when no input changed.
    var stamp_path: str = output + ".fides-stamp";
    var build_key: i64 = 0;
    if windows_pe {
        build_key = inc_build_key("emit", n, start);
        var stamp: IncStamp = inc_stamp_read(stamp_path);
        if !has_flag(n, start, "--no-cache") && str_len(env_or_empty("FIDES_NO_CACHE")) == 0 && inc_up_to_date(stamp, build_key, output) {
            time_mark("total", t_start);
            time_report();
            print(output + " is up to date\n");
            return 0;
        }
        inc_deps_reset();
    }

    t_run = time_mark("inc check", t_run);
    crash_stage("front end (parse, type check, borrow check)");
    var result: ResultProgram = build_program_with_path_borrowck(source, OptStr::Some(input), g_borrowck);
    t_run = time_mark("front end", t_run);
    match result {
        ResultProgram::Err(errs) => {
            print("Compilation errors:\n");
            var ei: i64 = 0;
            while ei < errs.len() {
                print(errs.get(ei));
                print("\n");
                ei = ei + 1;
            }
            return 1;
        }
        ResultProgram::Ok(program) => {
            p_eprint_str("[build] Lowering to IR...\n");
            var t_lw: i64 = p_clock_now_ms();
            // pe_ir lowers only what the program can reach (compiler/reach.fd)
            if windows_pe {
                g_lower_keep = lw_keep_set(program);
            }
            crash_stage("lowering");
            var ir_mod: IrModule = lower(program);
            g_lower_keep = 0;
            t_run = time_mark("lower", t_run);
            p_eprint_str("[prof] lower: " + int_to_str(p_clock_now_ms() - t_lw) + "ms\n");
            var lc_errs: Vec<str> = c_lockcheck_errors(&ir_mod);
            if lc_errs.len() > 0 {
                print("Compilation errors:\n");
                var lcei: i64 = 0;
                while lcei < lc_errs.len() {
                    print(lc_errs.get(lcei));
                    print("\n");
                    lcei = lcei + 1;
                }
                return 1;
            }

            // Windows default: direct IR -> PE machine code (pe_ir backend)
            if windows_pe {
                // Inlining and folding before machine code (release D5, D6)
                var t_io: i64 = p_clock_now_ms();
                var pe_verify: bool = str_len(env_or_empty("FID_VERIFY")) > 0;
                if pe_verify && !nat_verified(&ir_mod, "after lowering") {
                    return 1;
                }
                // PE88: what no code can call goes before the mid-end
                var pe88_dropped: i64 = 0;
                if pe88_prune_on() {
                    pe88_dropped = pe88_prune(&mut ir_mod);
                    t_run = time_mark("prune", t_run);
                    t_io = p_clock_now_ms();
                }
                if do_opt {
                    crash_stage("iropt (the mid-end's passes)");
                    iropt_native(&mut ir_mod);
                }
                t_run = time_mark("iropt", t_run);
                p_eprint_str("[prof] iropt: " + int_to_str(p_clock_now_ms() - t_io) + "ms\n");
                if remarks {
                    print_remarks(ir_mod, "");
                }
                if pe_verify && !nat_verified(&ir_mod, "after iropt") {
                    return 1;
                }
                // DB3: a debug build's image carries DWARF line tables
                // for the input file's functions (pe_ir.fd pe_lines_setup)
                if debug_mode || has_flag(n, start, "-g") || str_len(env_or_empty("FID_PE_DEBUG")) > 0 {
                    pe_lines_setup(source, input);
                    // DB3: and a PDB beside the .exe (compiler/pdb.fd)
                    pdb_setup(output);
                    // CT9: functions show under their names as written
                    // (Point::len, max<i64>; pe_ir_enc.fd pe_dbg_shown_for)
                    g_pe_dbg_shown_pairs = ng_dbg_shown_pairs(&ir_mod);
                }
                p_eprint_str("[build] Emitting PE via pe_ir backend...\n");
                crash_stage("native code (pe_ir: machine code and the PE writer)");
                var t_pe: i64 = p_clock_now_ms();
                var pe_res: ResultBytes = pe_ir_generate_pe(ir_mod);
                t_run = time_mark("native code", t_run);
                p_eprint_str("[prof] native code: " + int_to_str(p_clock_now_ms() - t_pe) + "ms\n");
                // PE88: should pe_ir fail on the pruned module (a pass
                // called by name a function nothing called before), the
                // build is made again from every function, as without it
                if pe88_dropped > 0 && pe88_failed(pe_res) && pe88_names_dropped(pe_res) {
                    p_eprint_str("[build] note: pe_ir failed on the pruned module (" + int_to_str(pe88_dropped) + " functions dropped); building again with every function (FID_PE_PRUNE=0 skips the prune)\n");
                    g_lower_keep = lw_keep_set(program);
                    var ir_all: IrModule = lower(program);
                    g_lower_keep = 0;
                    if do_opt {
                        iropt_native(&mut ir_all);
                    }
                    pe_res = pe_ir_generate_pe(ir_all);
                    t_run = time_mark("again, unpruned", t_run);
                }
                match pe_res {
                    ResultBytes::Err(perrs) => {
                        print("PE generation errors:\n");
                        var pei: i64 = 0;
                        while pei < perrs.len() {
                            print(perrs.get(pei));
                            print("\n");
                            pei = pei + 1;
                        }
                        return 1;
                    }
                    ResultBytes::Ok(pe_bytes) => {
                        // BG52: no stamp for an output that was not written
                        if !write_output_vec(output, pe_bytes) {
                            return 1;
                        }
                        inc_stamp_commit_hash(stamp_path, build_key, 0, input, inc_bytes_hash(pe_bytes));
                        t_run = time_mark("write+stamp", t_run);
                        time_mark("total", t_start);
                        time_report();
                        print("Built native executable: ");
                        print(output);
                        print("\n");
                        return 0;
                    }
                }
            }

            // MI18: `--native` reaches here only with a target the machine
            // layer does not have (the old PIR path, compiler.fd
            // build_executable, is no longer on any build path)
            if use_native {
                print("Error: --native: no native backend for target '" + target + "' (use x86_64-linux, aarch64-linux, riscv64-linux, x86_64-macos, aarch64-macos or x86_64-windows)\n");
                return 1;
            }

            // On Linux, use C codegen + system C compiler (gcc/clang)
            // On Windows, use C codegen + TCC
            if is_posix_host() {
                p_eprint_str("[build] Using C codegen (Linux)...\n");
                var cgen: CCodeGen = CCodeGen_new();
                var c_source: str = CCodeGen_generate(&mut cgen, ir_mod);
                var c_file: str = output + ".c";
                p_file_write(c_file, c_source);
                // Try gcc first, then clang
                var cc_cmd: str = "gcc -O2 -o " + shell_word(output) + " " + shell_word(c_file) + " -lm 2>/dev/null";
                var cc_ret: i64 = p_system(cc_cmd);
                if cc_ret != 0 {
                    cc_cmd = "clang -O2 -o " + shell_word(output) + " " + shell_word(c_file) + " -lm 2>/dev/null";
                    cc_ret = p_system(cc_cmd);
                }
                if cc_ret != 0 {
                    cc_cmd = "cc -O2 -o " + shell_word(output) + " " + shell_word(c_file) + " -lm";
                    cc_ret = p_system(cc_cmd);
                }
                if cc_ret != 0 {
                    print("Error: C compilation failed (tried gcc, clang, cc)\n");
                    return 1;
                }
                p_eprint_str("[build] Native executable built via C codegen.\n");
                print("Built native executable: ");
                print(output);
                print("\n");
                return 0;
            }

            // Windows reaches here only when --native failed above (the
            // Windows default already emitted a PE via pe_ir and returned).
            // No C-compiler fallback on this platform.
            print("Error: native Windows build failed; no C-compiler fallback is configured\n");
            return 1;
        }
    }
    return 1;
}

// --- Reproducible C builds (competitive VF12, R1) --------------------------
// The C compiler and linker put the link time into a PE header, and zig cc
// a PDB (a GUID and a path that differ per build). On by default;
// FIDES_NO_REPRO=1 turns it off.

fn repro_on() -> bool {
    return str_len(env_or_empty("FIDES_NO_REPRO")) == 0;
}

/// The link flags of a Windows target: no time stamp in the PE (GNU-style
/// linkers: gcc's ld and zig cc's lld in MinGW mode), and with zig cc no
/// PDB unless --debug (panic traces read fid's own function table, not
/// debug information).
fn repro_win_flags(cc: str, debug: bool) -> str {
    if !repro_on() {
        return "";
    }
    var out: str = "";
    // CB6: zig cc links with lld-link, which takes /Brepro (a content hash
    // in place of the time stamp); zig 0.16 rejects --no-insert-timestamp
    // ("unsupported linker arg": the build failed). GNU ld takes
    // --no-insert-timestamp.
    if str_contains(cc, "zig") {
        out = " -Wl,-Brepro";
    } else if str_contains(cc, "gcc") {
        out = " -Wl,--no-insert-timestamp";
    }
    if str_contains(cc, "zig") && !debug {
        out = out + " -s";
    }
    return out;
}

/// SOURCE_DATE_EPOCH=0 in front of the C compiler's command line, unless
/// the caller set it (then theirs is kept).
fn repro_env_prefix() -> str {
    if !repro_on() || str_len(env_or_empty("SOURCE_DATE_EPOCH")) > 0 {
        return "";
    }
    if is_posix_host() {
        return "SOURCE_DATE_EPOCH=0 ";
    }
    return "set SOURCE_DATE_EPOCH=0&& ";
}

// --- Crash reports and `fid reduce` (llvm-roadmap RL20) --------------------
// `fid <command> ... --crash-report` runs the command again as a child with
// FID_CRASH_TRACE=1: the child names each stage on stderr before it starts
// ("[stage] lowering"), and the machine layer each function before its code
// ("[nat] name", nat_ir g_nat_trace), and the mid-end each pass and the
// function it runs on ("[iropt] <pass> <fn>", read by iropt.fd and
// iropt_me.fd from FID_CRASH_TRACE). When the child panics or dies, the
// report names the stage and the function, the panic and the first frames,
// and the `fid reduce` line that shrinks the program while it still fails
// the same way; `--reduce` runs it.

fn crash_trace_on() -> bool {
    return str_len(env_or_empty("FID_CRASH_TRACE")) > 0;
}

/// Under --crash-report, the stage about to start (stderr).
/// FID_CRASH_TEST=<text>: a deliberate panic at the start of the stage
/// whose name holds the text (the report's own test,
/// scripts/driver-goals-check.sh).
fn crash_stage(name: str) {
    if crash_trace_on() {
        p_eprint_str("[stage] " + name + "\n");
        var t: str = env_or_empty("FID_CRASH_TEST");
        if str_len(t) > 0 && str_contains(name, t) {
            panic("FID_CRASH_TEST: a deliberate crash in " + name);
        }
    }
}

/// `a` as one shell word: quoted when it holds a space or a quote. BG54:
/// also when it holds a character cmd.exe or sh splits on, for the paths in
/// the C compiler's and child commands' lines (a word without them is left
/// as it is, so the command lines of ordinary paths do not change).
fn shell_word(a: str) -> str {
    if str_contains(a, " ") || str_contains(a, "\"") || str_contains(a, "&") || str_len(a) == 0 || str_contains(a, "\t") || str_contains(a, "|") || str_contains(a, "<") || str_contains(a, ">") || str_contains(a, "(") || str_contains(a, ")") || str_contains(a, ";") || str_contains(a, "^") || str_contains(a, "'") {
        return "\"" + str_replace(a, "\"", "\\\"") + "\"";
    }
    return a;
}

/// The way to start this fid again on a command line.
fn self_command() -> str {
    return shell_word(p_argv(0));
}

/// A text with its numbers blurred (line numbers move as lines go) and its
/// paths left out: what makes two failures "the same" (scripts/fuzz/
/// reduce.py failure_key).
fn reduce_blur(l: str) -> str {
    var words: Vec<str> = str_split(str_trim(l), " ");
    var out: str = "";
    var i: i64 = 0;
    while i < words.len() {
        var w: str = words.get(i);
        if str_contains(w, "/") || str_contains(w, "\\") {
            w = "<path>";
        }
        var k: i64 = 0;
        var b: str = "";
        while k < str_len(w) {
            var c: i64 = str_byte_at(w, k);
            if c >= 48 && c <= 57 {
                if !str_ends_with(b, "N") {
                    b = b + "N";
                }
            } else {
                b = b + str_slice(w, k, k + 1);
            }
            k = k + 1;
        }
        if i > 0 {
            out = out + " ";
        }
        out = out + b;
        i = i + 1;
    }
    if str_len(out) > 200 {
        out = str_slice(out, 0, 200);
    }
    return out;
}

/// The first error or panic line of `text`, blurred ("" when none).
fn reduce_failure_key(text: str) -> str {
    var lines: Vec<str> = str_split(str_replace(text, "\r", ""), "\n");
    var i: i64 = 0;
    while i < lines.len() {
        var l: str = lines.get(i);
        if str_contains(l, "anic") || str_contains(l, "rror") || str_contains(l, "Assertion") || str_contains(l, "Invalid") || str_contains(l, "overflow") || str_contains(l, "Stack") {
            return reduce_blur(l);
        }
        i = i + 1;
    }
    return "";
}

/// The text a command's output file holds ("" when it has none).
fn reduce_read(path: str) -> str {
    match read_file(path) {
        Option::Some(t) => {
            return t;
        }
        Option::None => {
        }
    }
    return "";
}

/// 2g.111 (OP20): the --cpu name `march` (nat_cpu_check's, armv8.0-a
/// already armv8-a) as zig cc's -march takes it. zig names its CPU models
/// with `_` (x86_64_v3) and an AArch64 or RISC-V level as a generic model
/// plus features; it rejects the GCC/clang spellings ("unknown CPU: 'x86'"
/// for x86-64-v3). Any other name is passed as it is.
fn zig_march_name(march: str) -> str {
    if march == "x86-64-v3" {
        return "x86_64_v3";
    }
    if march == "x86-64-v4" {
        return "x86_64_v4";
    }
    if march == "armv8-a" {
        return "generic+v8a";
    }
    if march == "armv8.1-a" {
        return "generic+v8_1a";
    }
    if march == "armv8.2-a" {
        return "generic+v8_2a";
    }
    if march == "armv8.4-a" {
        return "generic+v8_4a";
    }
    if march == "armv9-a" {
        return "generic+v9a";
    }
    if march == "rv64g" {
        return "generic_rv64+m+a+f+d";
    }
    if march == "rv64gc" || march == "rv64imafdc" {
        return "generic_rv64+m+a+f+d+c";
    }
    if march == "rv64gc_zba_zbb" {
        return "generic_rv64+m+a+f+d+c+zba+zbb";
    }
    if march == "rv64gcv" {
        return "generic_rv64+m+a+f+d+c+v";
    }
    if march == "rva22u64" {
        return "generic_rv64+m+a+f+d+c+zba+zbb+zbs";
    }
    if march == "rva23u64" {
        return "generic_rv64+m+a+f+d+c+zba+zbb+zbs+v";
    }
    return march;
}

// RL20: a try of `fid reduce` that runs too long (a candidate whose loop
// lost its step runs forever) is killed with its children after
// `--timeout <s>` seconds (default REDUCE_TIMEOUT_DEFAULT, reduce.py's 300;
// --no-timeout: no limit), and counts as the failure "timeout".
const REDUCE_TIMEOUT_DEFAULT: i64 = 300;
var g_reduce_timed_out: bool = false;

/// Run the shell command `line` with both its streams in `log`. Past `secs`
/// seconds (0: no limit) it is killed with every process it started
/// (POSIX: a watchdog that kills the process tree; Windows: PowerShell's
/// WaitForExit, then taskkill /T) and g_reduce_timed_out says so. The exit
/// status; 124 after a timeout.
fn reduce_system(line: str, log: str, secs: i64) -> i64 {
    g_reduce_timed_out = false;
    if secs <= 0 {
        return p_system(line + " > " + log + " 2>&1");
    }
    var mark: str = "_fid_reduce.timeout";
    p_file_delete(mark);
    var rc: i64 = 0;
    if is_posix_host() {
        p_file_write("_fid_reduce_cmd.sh", "( " + line + " ) > " + log + " 2>&1\n");
        var s: str = "kill_tree() {\n  for c in $(pgrep -P \"$1\" 2>/dev/null); do kill_tree \"$c\"; done\n  kill -KILL \"$1\" 2>/dev/null\n}\n";
        s = s + "sh ./_fid_reduce_cmd.sh &\npid=$!\n";
        s = s + "( sleep " + int_to_str(secs) + "; if kill -0 $pid 2>/dev/null; then echo timeout > " + mark + "; kill_tree $pid; fi ) > /dev/null 2>&1 &\n";
        s = s + "w=$!\nwait $pid\nrc=$?\nkill_tree $w\nexit $rc\n";
        p_file_write("_fid_reduce_try.sh", s);
        rc = p_system("sh ./_fid_reduce_try.sh");
        p_file_delete("_fid_reduce_cmd.sh");
        p_file_delete("_fid_reduce_try.sh");
    } else {
        // the command in a batch file (cmd.exe reads it as p_system would
        // the line); `%` doubled so it stays itself there
        p_file_write("_fid_reduce_cmd.bat", "@echo off\r\n" + str_replace(line, "%", "%%") + " > " + log + " 2>&1\r\nexit /b %ERRORLEVEL%\r\n");
        // 2g.105: `.\` names it in the current directory: with
        // NoDefaultCurrentDirectoryInExePath set, cmd does not look there
        // for a bare name, so every try failed ("not recognized")
        var ps: str = "$p = Start-Process -FilePath 'cmd.exe' -ArgumentList '/d','/c','.\\_fid_reduce_cmd.bat' -NoNewWindow -PassThru\n";
        // the handle kept, or ExitCode reads empty after the exit
        ps = ps + "$null = $p.Handle\n";
        ps = ps + "if (-not $p.WaitForExit(" + int_to_str(secs * 1000) + ")) {\n";
        ps = ps + "  Set-Content -Path '" + mark + "' -Value 'timeout'\n";
        ps = ps + "  & taskkill.exe /F /T /PID $p.Id 2>&1 | Out-Null\n";
        ps = ps + "  exit 124\n}\n";
        ps = ps + "exit $p.ExitCode\n";
        p_file_write("_fid_reduce_try.ps1", ps);
        rc = p_system("powershell -NoProfile -ExecutionPolicy Bypass -File _fid_reduce_try.ps1");
        p_file_delete("_fid_reduce_cmd.bat");
        p_file_delete("_fid_reduce_try.ps1");
    }
    if p_file_exists(mark) {
        g_reduce_timed_out = true;
        rc = 124;
        p_file_delete(mark);
    }
    return rc;
}

/// The signature of a try's stage ("build", "run"): the exit status and
/// the first error or panic line, or "timeout" when it was killed.
fn reduce_sig(stage: str, rc: i64, text: str) -> str {
    if g_reduce_timed_out {
        return stage + "|timeout|";
    }
    return stage + "|" + int_to_str(rc) + "|" + reduce_failure_key(text);
}

/// What a candidate does: [signature, output, failing ("1" or "0")].
/// `cmd` (a command with {} for the file) keeps its exit status; `fails`
/// (a backend: run, check, ccompile, emit, nat or emit:<target>) keeps the
/// stage (build or run), the exit status and the first error or panic line.
/// Each command is stopped after `secs` seconds (0: never; reduce_system).
fn reduce_outcome(cand: str, cmd: str, fails: str, secs: i64) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var log: str = "_fid_reduce.out";
    if str_len(cmd) > 0 {
        var rc: i64 = reduce_system(str_replace(cmd, "{}", shell_word(cand)), log, secs);
        var text: str = reduce_read(log);
        if g_reduce_timed_out {
            out.push("cmd|timeout");
            out.push(text + "\ntimeout after " + int_to_str(secs) + " s\n");
            out.push("1");
            return out;
        }
        out.push("cmd|" + int_to_str(rc));
        out.push(text);
        if rc != 0 {
            out.push("1");
        } else {
            out.push("0");
        }
        return out;
    }
    var kind: str = fails;
    var target: str = "";
    var colon: i64 = str_find(fails, ":");
    if colon >= 0 {
        kind = str_slice(fails, 0, colon);
        target = str_slice(fails, colon + 1, str_len(fails));
    }
    if kind == "run" || kind == "check" {
        var rc2: i64 = reduce_system(self_command() + " " + kind + " " + shell_word(cand), log, secs);
        var text2: str = reduce_read(log);
        out.push(reduce_sig("run", rc2, text2));
        out.push(text2);
        if rc2 != 0 {
            out.push("1");
        } else {
            out.push("0");
        }
        return out;
    }
    var exe: str = "_fid_reduce_exe";
    var run: str = "./_fid_reduce_exe";
    if !is_posix_host() {
        exe = "_fid_reduce_exe.exe";
        run = ".\\_fid_reduce_exe.exe";
    }
    p_file_delete(exe);
    var build: str = self_command() + " " + kind + " " + shell_word(cand);
    if kind == "nat" {
        build = self_command() + " emit " + shell_word(cand) + " --nat";
    }
    if str_len(target) > 0 {
        build = build + " --target " + target;
    }
    var brc: i64 = reduce_system(build + " -o " + exe, log, secs);
    var btext: str = reduce_read(log);
    if brc != 0 || p_file_exists(exe) == false {
        out.push(reduce_sig("build", brc, btext));
        out.push(btext);
        out.push("1");
        return out;
    }
    if str_len(target) > 0 {
        // another target: built, not run here
        out.push("run|0|");
        out.push(btext);
        out.push("0");
        return out;
    }
    var rrc: i64 = reduce_system(run, log, secs);
    var rtext: str = reduce_read(log);
    out.push(reduce_sig("run", rrc, rtext));
    out.push(rtext);
    if rrc != 0 {
        out.push("1");
    } else {
        out.push("0");
    }
    return out;
}

/// The number of times byte `ch` is in `s`.
fn reduce_count(s: str, ch: i64) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < str_len(s) {
        if str_byte_at(s, i) == ch {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// The ranges [i, j) of `lines` that can go as one statement (a line, or
/// a whole `if`/`while`/`for`/`match`/`fn` with its block), as i, j pairs,
/// the longest first (reduce.py units).
fn reduce_units(lines: &Vec<str>) -> Vec<i64> {
    var starts: Vec<i64> = Vec::new();
    var ends: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < lines.len() {
        var l: str = lines.get(i);
        var s: str = str_trim(l);
        var skip: bool = str_len(s) == 0 || str_starts_with(s, "}") || str_starts_with(s, "//") || str_starts_with(s, "fn main");
        // a function's own return: removing it changes the exit status
        if str_starts_with(s, "return") && str_starts_with(l, "    ") && !str_starts_with(l, "     ") {
            skip = true;
        }
        if !skip {
            if str_ends_with(s, "{") {
                var depth: i64 = 0;
                var j: i64 = i;
                var done: bool = false;
                while j < lines.len() && !done {
                    var t: str = str_trim(lines.get(j));
                    depth = depth + reduce_count(t, 123) - reduce_count(t, 125);
                    j = j + 1;
                    if depth <= 0 && !str_ends_with(str_trim(lines.get(j - 1)), "{") {
                        done = true;
                    }
                }
                starts.push(i);
                ends.push(j);
            } else {
                starts.push(i);
                ends.push(i + 1);
            }
        }
        i = i + 1;
    }
    // longest first (a stable selection: equal sizes keep their order)
    var out: Vec<i64> = Vec::new();
    var used: Vec<bool> = Vec::new();
    var k: i64 = 0;
    while k < starts.len() {
        used.push(false);
        k = k + 1;
    }
    var picked: i64 = 0;
    while picked < starts.len() {
        var best: i64 = 0 - 1;
        var q: i64 = 0;
        while q < starts.len() {
            if !used.get(q) && (best < 0 || ends.get(q) - starts.get(q) > ends.get(best) - starts.get(best)) {
                best = q;
            }
            q = q + 1;
        }
        used.set(best, true);
        out.push(starts.get(best));
        out.push(ends.get(best));
        picked = picked + 1;
    }
    return out;
}

/// `lines` without [i, j).
fn reduce_without(lines: &Vec<str>, i: i64, j: i64) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var k: i64 = 0;
    while k < lines.len() {
        if k < i || k >= j {
            out.push(lines.get(k));
        }
        k = k + 1;
    }
    return out;
}

/// Shrink `input` while it fails as it fails now (see reduce_outcome);
/// the result goes to `out_path`. 0 when it was reduced, 1 when the input
/// does not show the failure. Each try is stopped after `secs` seconds
/// (0: never; RL20).
fn reduce_run(input: str, out_path: str, cmd: str, fails: str, match_text: str, secs: i64) -> i64 {
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("fid reduce: could not read " + input + "\n");
        return 1;
    }
    // next to the input, so its own imports resolve as they do for it
    var dir: str = "";
    var slash: i64 = str_rfind(str_replace(input, "\\", "/"), "/");
    if slash >= 0 {
        dir = str_slice(input, 0, slash + 1);
    }
    var cand: str = dir + "_fid_reduce_cand.fd";
    var lines: Vec<str> = str_split(str_replace(source, "\r", ""), "\n");
    p_file_write(cand, str_join(lines, "\n"));
    var first: Vec<str> = reduce_outcome(cand, cmd, fails, secs);
    var sig: str = first.get(0);
    print("the failure to keep: " + sig + "\n");
    if secs > 0 {
        print("each try is stopped after " + int_to_str(secs) + " s (--timeout <s>, --no-timeout)\n");
    }
    if first.get(2) != "1" || (str_len(match_text) > 0 && !str_contains(first.get(1), match_text)) {
        print("the input does not show the failure\n");
        p_file_delete(cand);
        return 1;
    }
    var tries: i64 = 0;
    var timeouts: i64 = 0;
    var changed: bool = true;
    while changed {
        changed = false;
        var us: Vec<i64> = reduce_units(&lines);
        var u: i64 = 0;
        while u + 1 < us.len() && !changed {
            var i: i64 = us.get(u);
            var j: i64 = us.get(u + 1);
            if j <= lines.len() {
                var next: Vec<str> = reduce_without(&lines, i, j);
                tries = tries + 1;
                p_file_write(cand, str_join(next, "\n"));
                var res: Vec<str> = reduce_outcome(cand, cmd, fails, secs);
                if g_reduce_timed_out {
                    timeouts = timeouts + 1;
                }
                if res.get(2) == "1" && res.get(0) == sig && (str_len(match_text) == 0 || str_contains(res.get(1), match_text)) {
                    lines = next;
                    changed = true;
                    print("  " + int_to_str(lines.len()) + " lines (try " + int_to_str(tries) + ")\n");
                }
            }
            u = u + 2;
        }
    }
    p_file_write(out_path, str_join(lines, "\n"));
    p_file_delete(cand);
    p_file_delete("_fid_reduce.out");
    var nonblank: i64 = 0;
    var li: i64 = 0;
    while li < lines.len() {
        if str_len(str_trim(lines.get(li))) > 0 {
            nonblank = nonblank + 1;
        }
        li = li + 1;
    }
    print("reduced to " + int_to_str(nonblank) + " lines in " + int_to_str(tries) + " tries -> " + out_path + "\n");
    if timeouts > 0 {
        print(int_to_str(timeouts) + " tries ran past " + int_to_str(secs) + " s and were stopped\n");
    }
    return 0;
}

/// fid reduce <in.fd> [-o <out.fd>] [--cmd "<command, {} = the file>" |
/// --fails <run|check|ccompile|emit|nat|emit:<target>>] [--match <text>]:
/// the port of scripts/fuzz/reduce.py's --cmd and --fails modes (RL21),
/// with no Python. Default: --fails emit. RL20: --timeout <s> (default
/// REDUCE_TIMEOUT_DEFAULT; the global flag parser reads it into
/// `g_timeout`) stops each try, --no-timeout lets it run.
fn cmd_reduce(n: i64, start: i64, g_timeout: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid reduce <file.fd> [-o <out.fd>] [--cmd \"<command with {} for the file>\" | --fails <run|check|ccompile|emit|nat|emit:<target>>] [--match <text>] [--timeout <s> | --no-timeout]\n");
        return 1;
    }
    var secs: i64 = REDUCE_TIMEOUT_DEFAULT;
    if g_timeout > 0 {
        secs = g_timeout;
    }
    if has_flag(n, start, "--no-timeout") {
        secs = 0;
    }
    var input: str = p_argv(start + 1);
    var stem: str = input;
    if str_ends_with(input, ".fd") {
        stem = str_slice(input, 0, str_len(input) - 3);
    }
    var out_path: str = find_output_arg(n, start, stem + ".reduced.fd");
    var cmd: str = get_flag_value(n, start, "--cmd", "");
    var fails: str = get_flag_value(n, start, "--fails", "emit");
    var match_text: str = get_flag_value(n, start, "--match", "");
    return reduce_run(input, out_path, cmd, fails, match_text, secs);
}

/// The index of the first argument after `--` (interpreter mode) or 1.
fn argv_first() -> i64 {
    var n: i64 = p_argc();
    var i: i64 = 0;
    while i < n {
        if p_argv(i) == "--" {
            return i + 1;
        }
        i = i + 1;
    }
    return 1;
}

/// RL20: run the command line again (without --crash-report) as a child
/// that names its stages, and report a crash.
fn crash_report_run(n: i64, start: i64) -> i64 {
    var args: str = "";
    var input: str = "";
    var i: i64 = argv_first();
    while i < n {
        var a: str = p_argv(i);
        if a != "--crash-report" && a != "--reduce" {
            args = args + " " + shell_word(a);
            if i == start + 1 && str_ends_with(a, ".fd") {
                input = a;
            }
        }
        i = i + 1;
    }
    var err_file: str = "_fid_crash.err";
    var trace_env: str = "FID_CRASH_TRACE=1 ";
    if !is_posix_host() {
        trace_env = "set FID_CRASH_TRACE=1&& ";
    }
    var rc: i64 = p_system(trace_env + self_command() + args + " 2> " + err_file);
    var text: str = str_replace(reduce_read(err_file), "\r", "");
    p_file_delete(err_file);
    var lines: Vec<str> = str_split(text, "\n");
    var stage: str = "";
    var fn_name: str = "";
    // the mid-end pass that was running on fn_name ("[iropt] <pass> <fn>",
    // iropt.fd/iropt_me.fd under FID_CRASH_TRACE; "" for the machine layer)
    var pass_name: str = "";
    var panic_at: i64 = 0 - 1;
    var k: i64 = 0;
    while k < lines.len() {
        var l: str = lines.get(k);
        if str_starts_with(l, "[stage] ") {
            stage = str_slice(l, 8, str_len(l));
            fn_name = "";
            pass_name = "";
        } else if str_starts_with(l, "[nat] ") {
            fn_name = str_slice(l, 6, str_len(l));
            pass_name = "";
        } else if str_starts_with(l, "[iropt] ") {
            var rest: str = str_slice(l, 8, str_len(l));
            var sp: i64 = str_find(rest, " ");
            if sp > 0 {
                pass_name = str_slice(rest, 0, sp);
                fn_name = str_slice(rest, sp + 1, str_len(rest));
                // "-": a pass over the whole module
                if fn_name == "-" {
                    fn_name = "";
                }
            } else {
                pass_name = rest;
                fn_name = "";
            }
        } else {
            if panic_at < 0 && (str_contains(l, "Panic") || str_contains(l, "panicked") || str_contains(l, "tack overflow") || str_contains(l, "Segmentation") || str_contains(l, "Access violation")) {
                panic_at = k;
            }
            // the child's own messages pass through
            if str_len(l) > 0 || k + 1 < lines.len() {
                p_eprint_str(l + "\n");
            }
        }
        k = k + 1;
    }
    var crashed: bool = panic_at >= 0 || rc < 0 || rc > 1;
    if !crashed {
        return rc;
    }
    p_eprint_str("\n=== fid crash report ===\n");
    p_eprint_str("  command:  fid" + args + "\n");
    if str_len(stage) > 0 {
        p_eprint_str("  stage:    " + stage + "\n");
    } else {
        p_eprint_str("  stage:    before the first stage (reading the command line or the file)\n");
    }
    if str_len(pass_name) > 0 {
        if str_len(fn_name) > 0 {
            p_eprint_str("  pass:     " + pass_name + " (the mid-end)\n");
            p_eprint_str("  function: " + fn_name + " (the pass was running on it)\n");
        } else {
            p_eprint_str("  pass:     " + pass_name + " (a mid-end pass over the whole module)\n");
        }
    } else if str_len(fn_name) > 0 {
        p_eprint_str("  function: " + fn_name + " (the machine layer was compiling it)\n");
    }
    var message: str = "";
    if panic_at >= 0 {
        message = str_trim(lines.get(panic_at));
        p_eprint_str("  message:  " + message + "\n");
        var shown: i64 = 0;
        var q: i64 = panic_at + 1;
        while q < lines.len() && shown < 6 {
            var fl: str = lines.get(q);
            if str_len(str_trim(fl)) > 0 && !str_starts_with(fl, "[stage] ") && !str_starts_with(fl, "[nat] ") && !str_starts_with(fl, "[iropt] ") {
                p_eprint_str("  in fid:   " + str_trim(fl) + "\n");
                shown = shown + 1;
            }
            q = q + 1;
        }
    } else {
        p_eprint_str("  message:  (none: the process ended with status " + int_to_str(rc) + ")\n");
    }
    if str_len(input) > 0 {
        var cmd_t: str = self_command() + str_replace(args, " " + shell_word(input), " {}");
        var match_t: str = "";
        if str_len(message) > 0 {
            match_t = message;
        }
        p_eprint_str("  reduce:   fid reduce " + shell_word(input) + " --cmd " + shell_word(cmd_t));
        if str_len(match_t) > 0 {
            p_eprint_str(" --match " + shell_word(match_t));
        }
        p_eprint_str("\n");
        if argv_has(n, "--reduce") {
            var stem: str = str_slice(input, 0, str_len(input) - 3);
            var _r: i64 = reduce_run(input, stem + ".reduced.fd", cmd_t, "", match_t, REDUCE_TIMEOUT_DEFAULT);
        }
    }
    p_eprint_str("Please report it with the reduced program: docs/reference/known-bugs.md says where.\n");
    if rc == 0 {
        return 1;
    }
    return rc;
}

// --- MI11, TG5, RL10: the machine layer's commands --------------------------

/// fid dump-mir <file.fd> [--target <t>] [--fn <name>]: emit's pipeline
/// for the target (default x86_64-linux) with every function's machine IR,
/// its allocation and live ranges printed on stderr (or only --fn's); no
/// image is written.
fn cmd_dump_mir(n: i64, start: i64, g_borrowck: str, g_timeout: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid dump-mir <file.fd> [--target <t>] [--fn <name>]\n");
        return 1;
    }
    g_main_dump_mir = true;
    return cmd_build(n, start, g_borrowck, g_timeout);
}

/// fid disasm <file.fd> [--target <t>] [--fn <name>]: the machine code the
/// machine layer makes for the program, as instructions, by function (no
/// file is written); fid disasm <image> [--fn <name>]: the same for an ELF
/// executable it wrote; --raw --arch <a> [--base <addr>] for bare bytes.
fn cmd_disasm(n: i64, start: i64, g_borrowck: str, g_timeout: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid disasm <file.fd> [--target <t>] [--fn <name>]\n");
        p_eprint_str("       fid disasm <executable> [--fn <name>]\n");
        p_eprint_str("       fid disasm <file.bin> --raw --arch x86_64|aarch64|riscv64 [--base <addr>]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    if str_ends_with(input, ".fd") {
        g_main_disasm = true;
        return cmd_build(n, start, g_borrowck, g_timeout);
    }
    if p_file_exists(input) == false {
        p_eprint_str("Error: could not read file: " + input + "\n");
        return 1;
    }
    var bytes: Vec<i64> = p_file_read_bytes(input);
    if has_flag(n, start, "--raw") {
        var arch: i64 = disasm_arch_of(get_flag_value(n, start, "--arch", "x86_64"));
        if arch == 0 {
            p_eprint_str("Unknown --arch: use x86_64, aarch64 or riscv64\n");
            return 1;
        }
        var base_s: str = get_flag_value(n, start, "--base", "0");
        var base: i64 = 0;
        if str_starts_with(base_s, "0x") || str_starts_with(base_s, "0X") {
            base = str_parse_hex(base_s);
        } else {
            base = str_parse_int(base_s);
        }
        print(disasm_bytes(&bytes, 0, bytes.len(), arch, base));
        return 0;
    }
    // DB7: a Mach-O through its LC_SYMTAB (macho_disasm), else an ELF or PE
    var fn_want: str = get_flag_value(n, start, "--fn", "");
    var listing: str = macho_disasm(bytes, fn_want);
    if str_len(listing) == 0 {
        listing = disasm_image(bytes, fn_want);
    }
    print(listing);
    return 0;
}

/// RL10: fid ir-fuzz <seed> [--target <t>] [-o <out>] [--save-ir <f>]
/// [--mid-end]: a program whose function is random IR from the seed, built
/// by the machine layer (default x86_64-linux); prints `expected: <v>`, the
/// value the program must print (scripts/fuzz/fuzz_ir.sh runs it).
fn cmd_ir_fuzz(n: i64, start: i64, g_borrowck: str, g_timeout: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid ir-fuzz <seed> [--target <t>] [-o <out>] [--save-ir <file.fir>] [--mid-end] [--expect]\n");
        return 1;
    }
    g_main_irfuzz_seed = str_parse_int(p_argv(start + 1));
    // --expect: only the value, no build (the fuzzer's reference)
    if has_flag(n, start, "--expect") {
        print("expected: " + int_to_str(irfuzz_eval(g_main_irfuzz_seed)) + "\n");
        return 0;
    }
    g_main_irfuzz = true;
    return cmd_build(n, start, g_borrowck, g_timeout);
}

/// RL10: put seed `seed`'s random function in place of the template's
/// fz_target, and print the value the program must print.
fn irfuzz_install(m: &mut IrModule, seed: i64) -> bool {
    match IrModule_get_function(m, "fz_target") {
        OptIrFunction::Some(old) => {
            if old.params.len() < 2 {
                print("Error: ir-fuzz: fz_target has " + int_to_str(old.params.len()) + " parameters\n");
                return false;
            }
            var f: IrFunction = irfuzz_function(old, seed);
            IrModule_replace_function(m, f);
            // the helpers fz_h0..fz_h1 become random IR too (RL10)
            if !irfuzz_install_helpers(m, seed) {
                print("Error: ir-fuzz: the template has no fz_h0..fz_h1 after lowering\n");
                return false;
            }
            print("expected: " + int_to_str(irfuzz_eval(seed)) + "\n");
            return true;
        }
        OptIrFunction::None => {
            print("Error: ir-fuzz: the template has no fz_target after lowering\n");
            return false;
        }
    }
    return false;
}

/// RL10: fid emit-ir <file.fir> [--target <t>] [-o <out>] [--mid-end]
/// [--fast-alloc] [--size] [--cpu <c>] [--stats]: the machine layer alone
/// on a module `fid emit --save-ir` (or `fid ir-fuzz --save-ir`) wrote.
/// The IR is checked first (a file can hold anything): a module the
/// verifier rejects is an error, never a crash of the backend.
fn cmd_emit_ir(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid emit-ir <file.fir> [--target <t>] [-o <out>] [--mid-end]\n");
        return 1;
    }
    var path: str = p_argv(start + 1);
    var ld: IrModuleLoad = ir_module_load(path);
    if !ld.ok {
        print("Error: " + ld.err + "\n");
        return 1;
    }
    var target: str = normalize_target(get_flag_value(n, start, "--target", ld.target));
    if str_len(ld.target) > 0 && target != ld.target {
        p_eprint_str("warning: " + path + " was lowered for " + ld.target + " (its runtime is that target's); building it for " + target + "\n");
    }
    var tos: str = cross_target_os(target);
    var arch: i64 = nat_target_arch(target);
    if arch == 0 || (tos != "linux" && tos != "windows" && tos != "macos") {
        print("Error: emit-ir: no machine-layer target '" + target + "' (x86_64-linux, aarch64-linux, riscv64-linux, x86_64-macos, aarch64-macos, x86_64-windows)\n");
        return 1;
    }
    var m: IrModule = ld.module;
    var errs: Vec<str> = ir_verify(&m, "as read from " + path);
    if errs.len() > 0 {
        var ei: i64 = 0;
        while ei < errs.len() && ei < 20 {
            print(errs.get(ei) + "\n");
            ei = ei + 1;
        }
        print("Error: " + path + ": the IR is not valid (" + int_to_str(errs.len()) + " problems)\n");
        return 1;
    }
    if has_flag(n, start, "--mid-end") {
        crash_stage("iropt (the mid-end's passes)");
        iropt_native(&mut m);
        crash_stage("rules");
        var _rr: Vec<i64> = rules_run(&mut m);
        crash_stage("e-graph");
        var _eg: Vec<i64> = egraph_run(&mut m);
    }
    if has_flag(n, start, "--fast-alloc") || has_flag(n, start, "--fast") {
        g_nat_fast = true;
    }
    if has_flag(n, start, "--size") {
        g_nat_size = true;
    }
    if has_flag(n, start, "--stats") {
        g_nat_stats = true;
    }
    var cpu_arg: str = get_flag_value(n, start, "--cpu", "");
    if str_len(cpu_arg) > 0 {
        var cpu_err: str = nat_cpu_check(arch, cpu_arg);
        if str_len(cpu_err) > 0 {
            print(cpu_err + "\n");
            return 1;
        }
        g_nat_cpu = cpu_arg;
    }
    if crash_trace_on() {
        g_nat_trace = true;
    }
    crash_stage("native code (machine IR, allocation, encoding)");
    var res: ResultBytes = ResultBytes::Err(Vec::new());
    var out: str = find_output_arg(n, start, "a.out");
    if tos == "windows" {
        out = ensure_exe_extension(find_output_arg(n, start, "a.exe"));
        res = nat_generate_pe(m);
    } else if tos == "macos" {
        res = nat_generate_macho(m, arch);
    } else {
        res = nat_generate_elf(m, arch);
    }
    match res {
        ResultBytes::Err(gerrs) => {
            var gi: i64 = 0;
            while gi < gerrs.len() {
                print(gerrs.get(gi) + "\n");
                gi = gi + 1;
            }
            return 1;
        }
        ResultBytes::Ok(bytes) => {
            if !write_output_vec(out, bytes) {
                return 1;
            }
            if is_posix_host() {
                p_system("chmod +x '" + out + "' 2>/dev/null");
            }
            print("Built native executable: " + out + "\n");
            return 0;
        }
    }
    return 1;
}

// --- TG12 and CI7: object files and C libraries ----------------------------

/// TG12: `fid emit <file> --obj -o <file.o>`: the machine layer's code as
/// an object file to link with C (ELF ET_REL on Linux, Mach-O MH_OBJECT on
/// macOS, COFF with --nat), through nat_enc.fd's object writers
/// (nat_elf_object, nat_macho_object, nat_coff_object).
fn nat_write_object(m: IrModule, arch: i64, win: bool, mac: bool, out: str) -> i64 {
    // nat_ir.fd nat_emit_object (the writer: nat_enc.fd nat_elf_object)
    match nat_emit_object(m, arch, win, mac) {
        ResultBytes::Err(oerrs) => {
            var oi: i64 = 0;
            while oi < oerrs.len() {
                print(oerrs.get(oi) + "\n");
                oi = oi + 1;
            }
            return 1;
        }
        ResultBytes::Ok(obytes) => {
            if !write_output_vec(out, obytes) {
                return 1;
            }
            print("Wrote object file: " + out + "\n");
            return 0;
        }
    }
    return 1;
}

/// CI7: `fid ccompile <file> --lib [-o <name>]`: a shared library of the
/// program's exported (`pub extern "C"`) functions and a C header beside it,
/// from the C generator's library mode.
/// The exports are the `@export` functions and the names `--export a,b`
/// adds; the header is `<input stem>.h` beside the library, which is -o
/// (default: lib<stem>.so, lib<stem>.dylib or <stem>.dll for the target).
/// Built by gcc, clang or zig cc (CC, else the first found); cl.exe is not
/// supported here (/LD and a .def file would be needed).
fn ccompile_lib(n: i64, start: i64, source: str, input: str, g_borrowck: str, _output: str) -> i64 {
    var target: str = normalize_target(get_flag_value(n, start, "--target", ""));
    var os: str = cross_target_os(target);
    if os == "" {
        os = host_os();
    }
    if os == "wasi" {
        print("Error: ccompile --lib: no shared libraries for wasm32-wasi\n");
        return 1;
    }
    // The library's name: the input file's stem
    var stem: str = input;
    var slash: i64 = str_rfind(str_replace(input, "\\", "/"), "/");
    if slash >= 0 {
        stem = str_slice(input, slash + 1, str_len(input));
    }
    if str_ends_with(stem, ".fd") {
        stem = str_slice(stem, 0, str_len(stem) - 3);
    }
    var lib_file: str = find_output_arg(n, start, "");
    if str_len(lib_file) == 0 {
        lib_file = CGen_lib_file_name(stem, os);
    }
    var lib_dir: str = "";
    var lslash: i64 = str_rfind(str_replace(lib_file, "\\", "/"), "/");
    if lslash >= 0 {
        lib_dir = str_slice(lib_file, 0, lslash + 1);
    }
    CGen_lib_set(true);
    var extra: str = get_flag_value(n, start, "--export", "");
    if str_len(extra) > 0 {
        var names: Vec<str> = str_split(extra, ",");
        var ni: i64 = 0;
        while ni < names.len() {
            var nm: str = str_trim(names.get(ni));
            if str_len(nm) > 0 {
                CGen_lib_export(nm);
            }
            ni = ni + 1;
        }
    }
    crash_stage("front end, lowering and C generation (a library)");
    var c_code: str = "";
    match ccompile_source_with_path(source, input, g_borrowck) {
        ResultStr::Ok(code) => {
            c_code = code;
        }
        ResultStr::Err(errs) => {
            print("Compilation errors:\n");
            var ei: i64 = 0;
            while ei < errs.len() {
                print(errs.get(ei) + "\n");
                ei = ei + 1;
            }
            return 1;
        }
    }
    var skipped: str = CGen_lib_skipped();
    if str_len(skipped) > 0 {
        p_eprint_str("warning: ccompile --lib: these are not exported (no C form):\n" + skipped);
        if !str_ends_with(skipped, "\n") {
            p_eprint_str("\n");
        }
    }
    var c_file: str = lib_file + ".c";
    p_file_write(c_file, c_code);
    var header_path: str = lib_dir + stem + ".h";
    p_file_write(header_path, CGen_lib_header(stem));
    // The C compiler: CC, else gcc, clang, zig cc; zig cc for a cross --target
    var cc: str = env_or_empty("CC");
    if str_len(cc) == 0 {
        if is_posix_host() {
            if p_system("which gcc >/dev/null 2>&1") == 0 {
                cc = "gcc";
            } else if p_system("which clang >/dev/null 2>&1") == 0 {
                cc = "clang";
            } else {
                cc = "zig cc";
            }
        } else {
            if p_system("gcc --version >nul 2>&1") == 0 {
                cc = "gcc";
            } else if p_system("clang --version >nul 2>&1") == 0 {
                cc = "clang";
            } else {
                cc = "zig cc";
            }
        }
    }
    if str_len(target) > 0 && cross_zig_triple(target) != "" && (str_contains(cc, "zig") || str_len(env_or_empty("CC")) == 0) {
        cc = "zig cc -target " + cross_zig_triple(target);
    }
    if str_ends_with(cc, "cl.exe") || cc == "cl" || cc == "tcc" || str_ends_with(cc, "tcc.exe") {
        print("Error: ccompile --lib: build the library with gcc, clang or zig cc (CC=" + cc + " is not supported for --lib)\n");
        return 1;
    }
    var opt: str = " -O2";
    if has_flag(n, start, "--debug") {
        opt = " -O0 -g";
    }
    var flags: str = opt + " -w -Wno-int-conversion -Wno-incompatible-pointer-types -fno-strict-overflow -fno-strict-aliasing" + CGen_lib_cc_flags(os);
    if str_contains(cc, "zig") {
        flags = " -fno-sanitize=undefined" + flags;
    }
    var libs: str = " -lm";
    if os == "windows" {
        // CB6: a DLL without a time stamp (repro_win_flags)
        libs = libs + " -lws2_32" + repro_win_flags(cc, has_flag(n, start, "--debug") || has_flag(n, start, "-g"));
    } else {
        libs = libs + " -lpthread";
    }
    libs = libs + zig_unwind(cc) + plink_libs(c_code) + plink_cpp(c_code, cc, os);
    // L5E: a macOS dylib is found through the program's rpath
    // (@loader_path, cmd_ccompile): its install name is @rpath/<file>
    if os == "macos" {
        libs = libs + " -Wl,-install_name,@rpath/" + str_slice(lib_file, lslash + 1, str_len(lib_file));
    }
    var cmd: str = repro_env_prefix() + cc + flags + " -o " + shell_word(lib_file) + " " + shell_word(c_file) + libs;
    crash_stage("C compiler (a library)");
    var cc_err: str = c_file + ".err";
    var rc: i64 = p_system(cmd + " 2> " + shell_word(cc_err));
    var err_text: str = reduce_read(cc_err);
    p_file_delete(cc_err);
    if rc != 0 {
        var report: str = link_error_report(err_text, source, input);
        if str_len(report) > 0 {
            p_eprint_str(report);
        }
        p_eprint_str(err_text);
        print("C compilation of the library failed (C source left at " + c_file + ")\n");
        return 1;
    }
    print("Built shared library: " + lib_file + " (C header " + header_path + ")\n");
    return 0;
}

// --- print_usage ---------------------------------------------------------
fn print_usage() {
    p_eprint_str("fid -- Fides self-hosted compiler\n");
    p_eprint_str("\n");
    p_eprint_str("Usage:\n");
    p_eprint_str("  fid ccompile <file.fd> -o <output>    Compile via C codegen (tcc)\n");
    p_eprint_str("  fid build    <file.fd> -o <output>    Compile to native executable (no C compiler or linker; --via-c: through C)\n");
    p_eprint_str("  fid emit     <file.fd> -o <output>    Alias for build\n");
    p_eprint_str("  fid build-x86 <file.fd> [-o <out>]    Linux ELF via x86 stack-machine backend\n");
    p_eprint_str("  fid emit     <file.fd> --boot -o <out>  Multiboot 1+2 kernel (as --bare) [--load <addr>]\n");
    p_eprint_str("  fid emit     <file.fd> --bare -o <out>  Bare-metal kernel (Multiboot; QEMU -kernel) [--load <addr>]\n");
    p_eprint_str("  fid emit     <file.fd> --uefi -o <out.efi>  UEFI application (PE32+, EFI_APPLICATION; no stdlib)\n");
    p_eprint_str("  fid emit     <file.fd> --elf -o <out>   Static Linux x86-64 executable (machine layer, with stdlib; FID_ELF_PEIR=1: old path)\n");
    p_eprint_str("  fid emit     <file.fd> --target universal -o <out>  macOS universal binary (x86_64 + arm64 slices)\n");
    p_eprint_str("  fid emit     <file.fd> --target <arch>-linux --pie|--no-pie -o <out>  position-independent (ET_DYN) or fixed-address (ET_EXEC) executable; neither: FID_NAT_ON=pie\n");
    p_eprint_str("  fid run      <file.fd>                Compile + execute\n");
    p_eprint_str("  fid tokens   <file.fd>                Show tokens\n");
    p_eprint_str("  fid ast      <file.fd>                Show AST summary\n");
    p_eprint_str("  fid ir       <file.fd>                Show IR\n");
    p_eprint_str("  fid dump-c   <file.fd>                Show generated C source\n");
    p_eprint_str("  fid split-c  <in.c> <prefix> <n>      Split generated C into n units + a header\n");
    p_eprint_str("  fid opt      <file.fd> [--fn <name>]  Show the IR after the IR optimizer (iropt)\n");
    p_eprint_str("  fid fmt      <file.fd> [--check] [-w] Format source code\n");
    p_eprint_str("  fid test                             Run all tests in tests/bootstrap/\n");
    p_eprint_str("  fid test     <file.fd>               Run its fn test_*() (one process each), time fn bench_*()\n");
    p_eprint_str("  fid test     <file.fd> --coverage    The tests' coverage through veil (report: coverage/)\n");
    p_eprint_str("  fid watch    <file.fd> [<command>] [--interval <ms>] [-- <args>]\n");
    p_eprint_str("                                           `fid <command> <file.fd> <args>` again on change\n");
    p_eprint_str("  fid doctest  <file.fd|dir> [--emit]  Run the /// Example: blocks as tests\n");
    p_eprint_str("  fid bench    <file.fd> [-n <count>]   Benchmark: run N times\n");
    p_eprint_str("  fid fuzz     <file.fd> [--seeds <n>]  Run its fn fuzz_*(data: Vec<u8>) on n inputs (1000)\n");
    p_eprint_str("  fid debug    <file.fd>               Interactive IR debugger (break, step, print)\n");
    p_eprint_str("  fid lint     <file.fd>               Run lint checks\n");
    p_eprint_str("  fid check    <file.fd>               Type, borrow and effect checks only\n");
    p_eprint_str("  fid fix      <file.fd> [--check]     Apply the suggested fixes (each kept only if it helps)\n");
    p_eprint_str("  fid doc      <file.fd|dir> ...        Generate documentation (as scribe)\n");
    p_eprint_str("  fid ccompile <file.fd> --debug|--release  C at -O0, or -O2 (the default)\n");
    p_eprint_str("  fid run      <file.fd> --leaks        Report the blocks never freed, by where allocated\n");
    p_eprint_str("  fid run      <file.fd> --checked-alloc  Fault on use after free or past a block's end\n");
    p_eprint_str("  fid run|ccompile <file.fd> --mem      At exit: peak memory, bytes by function and line\n");
    p_eprint_str("  fid run      <file.fd> --trace-spans  Print the program's trace spans (FIDES_TRACE=1)\n");
    p_eprint_str("  fid wasm     <file.fd> [-o <out>] [--wat]  Compile to WASM/WAT\n");
    p_eprint_str("  fid version                          Show version\n");
    p_eprint_str("  fid scribe   <file.fd|dir> [--format html|markdown] [--output <dir>]\n");
    p_eprint_str("                                           Generate documentation\n");
    p_eprint_str("  fid veil     <file.fd> [--format text|html] [--output <dir>]\n");
    p_eprint_str("                                           Code coverage report\n");
    p_eprint_str("  fid inspect  <crash-report>              Print a crash report (fid run --crash-file <file>,\n");
    p_eprint_str("                                           or FID_CRASH_REPORT=<file> for any program)\n");
    p_eprint_str("  fid replay   <trace> [--steps]           Run again what fid run --record <trace> recorded\n");
    p_eprint_str("  fid codegen  <file.fd> [--target x86-64|arm64|riscv|<triple>] [--fn <name>]\n");
    p_eprint_str("                       [--elf <o>] [--coff <o>] [--macho <o>]\n");
    p_eprint_str("                                           Machine code as instructions, or an object file\n");
    p_eprint_str("  fid gpu      <file.fd> --target spirv|ptx [-o <out>] [--text]\n");
    p_eprint_str("                                           Generate GPU code\n");
    p_eprint_str("  fid verify   <file.fd>              Verify IR correctness\n");
    p_eprint_str("  fid explain  <file.fd>              Runtime checks the optimizer removed, and why\n");
    p_eprint_str("  fid explain  <file.fd> --stages <fn> [--target <t>]  One function: IR after each stage, machine code\n");
    p_eprint_str("  fid explain-error <code>           An error code (E044): meaning, example, fix\n");
    p_eprint_str("  fid emit     <file.fd> --remarks     Optimization remarks (checks removed/kept, spills) on stderr\n");
    p_eprint_str("  fid check|emit|ccompile|dump-c <file.fd> --time  Per-stage timing table on stderr\n");
    p_eprint_str("  fid serve                            Long-lived checker: 'check <file.fd>' a line on stdin\n");
    p_eprint_str("  fid audit    <file.fd> [--stdlib] [--strict]  List the unsafe code it can reach\n");
    p_eprint_str("  fid qualify  <file.fd> [-o out.json]  Safety evidence: rules, their tests, the program's annotations\n");
    p_eprint_str("  fid sourcemap <file.fd>             Show IR-to-source mapping\n");
    p_eprint_str("  fid dump-mir <file.fd> [--target <t>] [--fn <name>]  Machine IR after allocation (stderr)\n");
    p_eprint_str("  fid disasm   <file.fd|exe> [--target <t>] [--fn <name>]  The machine code as instructions\n");
    p_eprint_str("  fid emit     <file.fd> --save-ir <f.fir>  Also save the IR the machine layer gets\n");
    p_eprint_str("  fid emit-ir  <f.fir> [--target <t>] [-o <out>] [--mid-end]  The machine layer on saved IR\n");
    p_eprint_str("  fid ir-fuzz  <seed> [--target <t>] [-o <out>]  A program of random IR; prints the expected value\n");
    p_eprint_str("  fid reduce   <file.fd> [--cmd \"<c {}>\" | --fails <backend>] [--match <t>]  Shrink a failing program\n");
    p_eprint_str("  fid <command> ... --crash-report [--reduce]  On a crash: the stage and function, how to reduce\n");
    p_eprint_str("  fid emit     <file.fd> --fast-alloc | --size  The fast allocator (RA14) / smaller code (TG19; RISC-V is compressed by default, FID_NAT_OFF=rvc: not)\n");
    p_eprint_str("  fid test     <file.fd> -run <test>/<row>  Only those tests, and those rows of their table tests\n");
    p_eprint_str("  fid parse-header <file.h> [-o <fd>] [--link <lib>] FFI bindings from a C header\n");
}

// --- cmd_parse_header ----------------------------------------------------
// Parse a C header file and emit Fides FFI bindings to stdout.
// --- cmd_scribe ----------------------------------------------------------
// Generate HTML or Markdown documentation from .fd source.
fn cmd_scribe(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        print("scribe -- Documentation generator for Fides\n\nUSAGE:\n    scribe <file.fd> [--output <dir>] [--format html|markdown]\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var format: str = get_flag_value(n, start, "--format", "html");
    var output_dir: str = get_flag_value(n, start, "--output", "docs");
    // TL11: a directory is a site (a page per module, an index with search)
    var message: str = process_directory(input, output_dir, format);
    print(message);
    print("\n");
    return 0;
}

// --- cmd_veil ------------------------------------------------------------
// Run a Fides program with coverage tracking and emit a report.
fn cmd_veil(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        print(veil_print_help());
        return 1;
    }
    var input: str = p_argv(start + 1);
    var format: str = get_flag_value(n, start, "--format", "text");
    var output_dir: str = get_flag_value(n, start, "--output", "coverage");
    var message: str = veil_run(input, format, output_dir);
    // a program that does not compile, an unreadable input or a report
    // that could not be written: the message on stderr, exit 1 (as
    // tools/veil.fd and the Rust veil)
    if str_starts_with(message, "Cannot read ") || str_contains(message, "\nError: could not write ") || str_starts_with(message, "Compilation failed") {
        p_eprint_str(message + "\n");
        return 1;
    }
    print(message);
    print("\n");
    return 0;
}

// --- cmd_doctest ---------------------------------------------------------
// Run the `/// Example:` blocks of a file (or every .fd under a directory)
// as programs -- scripts/doctest.py's job inside fid. `fid run` by
// default; --emit also runs `Example (native only):` blocks (own backend
// first, the C route when it cannot build the example; --emit-only forbids
// the C route). --native-only runs the native blocks alone.
fn cmd_doctest(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid doctest <file.fd|dir> [--emit] [--emit-only] [--native-only] [-v]\n");
        p_eprint_str("  Runs each `/// Example:` block as a program: `use <module>;`, the\n");
        p_eprint_str("  block's own `use` lines hoisted, the rest inside `fn main`.\n");
        return 1;
    }
    var input: str = p_argv(start + 1);
    var emit_only: bool = has_flag(n, start, "--emit-only");
    var want_emit: bool = emit_only || has_flag(n, start, "--emit");
    var native_only: bool = has_flag(n, start, "--native-only");
    var verbose: bool = has_flag(n, start, "-v") || has_flag(n, start, "--verbose");
    var files: Vec<str> = Vec::new();
    if p_is_dir(input) != 0 {
        scribe_collect(input, &mut files);
    } else {
        files.push(input);
    }
    var n_doc: i64 = 0;
    var n_run: i64 = 0;
    var n_fail: i64 = 0;
    var n_skip: i64 = 0;
    var fails: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < files.len() {
        var path: str = files.get(fi);
        fi = fi + 1;
        // a program a previous doctest run left behind is not a source file
        if str_find(path, "_fides_doctest_") >= 0 {
            continue;
        }
        var source: str = c_file_read(path);
        var base: str = str_replace(path, "\\", "/");
        var bslash: i64 = str_rfind_char(base, 47);
        if bslash >= 0 {
            base = str_slice(base, bslash + 1, str_len(base));
        }
        if str_ends_with(base, ".fd") {
            base = str_slice(base, 0, str_len(base) - 3);
        }
        var examples: Vec<DocExample> = scribe_doctests(source, base);
        var dir: str = scribe_dir_of(path);
        var k: i64 = 0;
        while k < examples.len() {
            var ex: DocExample = examples.get(k);
            n_doc = n_doc + 1;
            if ex.native && !want_emit {
                n_skip = n_skip + 1;
                k = k + 1;
                continue;
            }
            if native_only && !ex.native {
                k = k + 1;
                continue;
            }
            var prog: str = dir + "/_fides_doctest_" + int_to_str(fi) + "_" + int_to_str(k) + ".fd";
            p_file_write(prog, scribe_doctest_program(ex.module_name, ex.code));
            n_run = n_run + 1;
            var why: str = "";
            if ex.native {
                why = doctest_native(prog, emit_only);
            } else {
                var runv: Vec<str> = Vec::new();
                runv.push(p_argv(0));
                runv.push("run");
                runv.push(prog);
                var r: ChildResult = process_run_argv(runv, Vec::new(), "", 60000);
                if r.timed_out {
                    why = "timeout";
                } else if !r.started {
                    why = "did not start";
                } else if r.code != 0 {
                    why = first_error_line(r.errors + "\n" + r.output);
                }
            }
            if str_len(why) > 0 {
                n_fail = n_fail + 1;
                fails.push(path + " #" + int_to_str(k) + "  " + why);
            } else if verbose {
                print("ok  " + path + " #" + int_to_str(k) + "\n");
            }
            p_file_delete(prog);
            k = k + 1;
        }
    }
    print("doctest: " + int_to_str(n_doc) + " examples | " + int_to_str(n_run) + " run | " + int_to_str(n_fail) + " failed | " + int_to_str(n_skip) + " skipped(native)\n");
    var fi2: i64 = 0;
    while fi2 < fails.len() {
        print("  FAIL " + fails.get(fi2) + "\n");
        fi2 = fi2 + 1;
    }
    if n_fail > 0 {
        return 1;
    }
    return 0;
}

/// The first line of command `output` that says what failed (not [stage]
/// progress, and naming an error), else its first line, or "".
fn first_error_line(output: str) -> str {
    var lines: Vec<str> = str_split(output, "\n");
    var first: str = "";
    var i: i64 = 0;
    while i < lines.len() {
        var l: str = str_trim(lines.get(i));
        if str_len(l) == 0 {
            i = i + 1;
            continue;
        }
        if str_len(first) == 0 {
            first = l;
        }
        if !str_starts_with(l, "[") && !str_ends_with(l, ":") {
            var low: str = str_to_lower(l);
            if str_contains(low, "error") || str_contains(low, "panic") || str_contains(low, "assert") || str_contains(low, "fail") || str_contains(low, "undefined") {
                return l;
            }
        }
        i = i + 1;
    }
    return first;
}

/// Build and run `prog` natively for `Example (native only):` (doctest.py's
/// run_native): `fid emit` for the host target, `fid ccompile` when the own
/// backend cannot build it and `emit_only` is false. "" when it ran clean,
/// else why not.
fn doctest_native(prog: str, emit_only: bool) -> str {
    var exe: str = str_slice(prog, 0, str_len(prog) - 3);
    if !is_posix_host() {
        exe = exe + ".exe";
    }
    var bv: Vec<str> = Vec::new();
    bv.push(p_argv(0));
    bv.push("emit");
    bv.push(prog);
    if is_posix_host() {
        bv.push("--target");
        bv.push(host_native_target());
    }
    bv.push("-o");
    bv.push(exe);
    var b: ChildResult = process_run_argv(bv, Vec::new(), "", 300000);
    if (b.timed_out || !b.started || b.code != 0 || p_file_exists(exe) == 0) && !emit_only {
        // the own backend lacks some runtime functions: the C route
        var cv: Vec<str> = Vec::new();
        cv.push(p_argv(0));
        cv.push("ccompile");
        cv.push(prog);
        cv.push("-o");
        cv.push(exe);
        b = process_run_argv(cv, Vec::new(), "", 300000);
    }
    if b.timed_out || !b.started || b.code != 0 || p_file_exists(exe) == 0 {
        if b.timed_out {
            return "build timeout";
        }
        return "build: " + first_error_line(b.errors + "\n" + b.output);
    }
    var rv: Vec<str> = Vec::new();
    rv.push(exe);
    var r: ChildResult = process_run_argv(rv, Vec::new(), "", 60000);
    p_file_delete(exe);
    if r.timed_out {
        return "timeout";
    }
    if !r.started || r.code != 0 {
        return "exit " + int_to_str(r.code) + ": " + first_error_line(r.errors + "\n" + r.output);
    }
    return "";
}

// --- cmd_inspect (CO9) ---------------------------------------------------
/// CO9: the readable form of crash report `text` (interp.fd
/// interp_crash_report_text writes it), or why it is not one.
fn inspect_crash_report(text: str) -> ResultStr {
    var lines: Vec<str> = str_split(text, "\n");
    if lines.len() == 0 || str_trim(lines.get(0)) != "fid-crash-report 1" {
        return ResultStr::Err(c_vec1("not a fid crash report (no 'fid-crash-report 1' first line)"));
    }
    var version: str = "";
    var program: str = "";
    var message: str = "";
    var trace: str = "";
    var in_trace: bool = false;
    var ended: bool = false;
    var i: i64 = 1;
    while i < lines.len() {
        var l: str = lines.get(i);
        if str_ends_with(l, "\r") {
            l = str_slice(l, 0, str_len(l) - 1);
        }
        if l == "end" {
            ended = true;
            i = lines.len();
        } else if in_trace {
            trace = trace + "    " + str_trim(l) + "\n";
        } else if l == "trace:" {
            in_trace = true;
        } else if str_starts_with(l, "version: ") {
            version = str_slice(l, 9, str_len(l));
        } else if str_starts_with(l, "program: ") {
            program = str_slice(l, 9, str_len(l));
        } else if str_starts_with(l, "message: ") {
            if str_len(message) > 0 {
                message = message + "\n           ";
            }
            message = message + str_slice(l, 9, str_len(l));
        }
        i = i + 1;
    }
    if !ended {
        return ResultStr::Err(c_vec1("crash report is cut short (no 'end' line)"));
    }
    var out: str = "Crash of " + program + "\n";
    out = out + "  build:   " + version + "\n";
    out = out + "  panic:   " + message + "\n";
    if str_len(trace) == 0 {
        out = out + "  trace:   (none recorded)\n";
    } else {
        out = out + "  trace (innermost call first):\n" + trace;
    }
    return ResultStr::Ok(out);
}

/// CO9: `fid inspect <report>` prints a crash report that `fid run
/// --crash-file <report>` wrote, or any program run with
/// FID_CRASH_REPORT=<report> (`fid run`, and programs built through C).
fn cmd_inspect(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid inspect <crash-report>\n");
        return 1;
    }
    var path: str = p_argv(start + 1);
    var text: str = "";
    match read_file(path) {
        Option::Some(t) => {
            text = t;
        }
        Option::None => {
            p_eprint_str("fid inspect: cannot read " + path + "\n");
            return 1;
        }
    }
    match inspect_crash_report(text) {
        ResultStr::Ok(out) => {
            print(out);
        }
        ResultStr::Err(errs) => {
            p_eprint_str("fid inspect: " + path + ": " + errs.get(0) + "\n");
            return 1;
        }
    }
    return 0;
}

// --- cmd_debug ------------------------------------------------------------
// Interactive IR debugger. Runs the interpreter with breakpoints.
fn cmd_debug(n: i64, start: i64) -> i64 {
    if start + 2 > n {
        p_eprint_str("Usage: fid debug <file.fd> [--echo]\n");
        p_eprint_str("  Interactive debugger with breakpoints, stepping, variable inspection;\n");
        p_eprint_str("  commands on standard input, one per line (--echo prints each one read).\n");
        p_eprint_str("  Commands: break, run, step, next, finish, continue, print, info, backtrace, list, watch, ir, effects, quit\n");
        return 1;
    }
    var path: str = argv_at(start + 1);
    var source: str = "";
    match read_file(path) {
        Option::Some(t) => {
            source = t;
        }
        Option::None => {
            p_eprint_str("error: cannot read " + path + "\n");
            return 1;
        }
    }
    var dbg = Debugger_new(source, path);
    dbg.echo = has_flag(n, start, "--echo");
    return Debugger_run(&mut dbg, source, path);
}
// --- cmd_native_debug ----------------------------------------------------
// Native binary debugger (Linux ptrace). Compiles to C, runs under ptrace.
