// main.fd — CLI entry point for the self-hosted Fides compiler.
//
// This is a minimal main that supports the `ccompile` command,
// which is all we need for the C codegen bootstrap.
//
// Usage: fides-c ccompile <file.fd> -o <output>

module compiler::main;

use core;
use vec;
use string;
use compiler::compiler;

pub fn main() -> i64 {
    var n: i64 = p_argc();

    // Two invocation modes:
    //   Interpreter: fidesc run main.fd -- ccompile <file.fd> -o <output>
    //   Native:      fides-c ccompile <file.fd> -o <output>
    // Find the "--" separator (interpreter mode) or start at argv[1] (native).
    var start: i64 = 1;
    var i: i64 = 0;
    while i < n {
        if p_argv(i) == "--" {
            start = i + 1;
            break;
        }
        i = i + 1;
    }

    if start >= n {
        print("Usage: fides-c ccompile <file.fd> -o <output>\n");
        return 1;
    }

    var command: str = p_argv(start);

    if str_equal(command, "ccompile") {
        return cmd_ccompile(n, start);
    }

    print("Unknown command: ");
    print(command);
    print("\n");
    print("Available commands: ccompile\n");
    return 1;
}

fn cmd_ccompile(n: i64, start: i64) -> i64 {
    // Parse: ccompile <file.fd> -o <output>
    // Args are at: start+1=<file>, start+2..=-o <output>
    if start + 2 > n {
        print("Usage: fides-c ccompile <file.fd> -o <output>\n");
        return 1;
    }

    var input: str = p_argv(start + 1);
    var output: str = "a.out";

    // Look for -o flag
    var i: i64 = start + 2;
    while i < n {
        var arg: str = p_argv(i);
        if str_equal(arg, "-o") {
            if i + 1 < n {
                output = p_argv(i + 1);
            }
        }
        i = i + 1;
    }
    
    // Read the source file
    p_eprint_str("[main] Reading source file: ");
    p_eprint_str(input);
    p_eprint_str("\n");
    var source: str = c_file_read(input);
    if str_len(source) == 0 {
        p_eprint_str("[main] FAILED: could not read file\n");
        print("Error: could not read file: ");
        print(input);
        print("\n");
        return 1;
    }
    p_eprint_str("[main] Source read ok. Compiling...\n");

    // Compile to C
    var result: ResultStr = ccompile_source_with_path(source, input);
    match result {
        ResultStr::Ok(c_code) => {
            p_eprint_str("[main] C code generated. Writing to file...\n");
            // Write C to temp file
            var c_file: str = output + ".c";
            // Skip p_file_write for debugging
            p_eprint_str("[main] Skipping p_file_write. Testing p_system...\n");
            var test_ret: i64 = p_system("echo hello_from_test");
            p_eprint_str("[main] p_system test done\n");
            p_file_write(c_file, c_code);
            p_eprint_str("[main] C file written. Running tcc...\n");

            // Run tcc to compile the C code.
            var gcc_cmd: str = "tcc -w -o ";
            gcc_cmd = gcc_cmd + output + " " + c_file + " -lws2_32";
            var ret: i64 = p_system(gcc_cmd);
            
            if ret != 0 {
                print("C compilation failed\n");
                return 1;
            }
            
            print("Built native executable: ");
            print(output);
            print("\n");
            return 0;
        }
        ResultStr::Err(errs) => {
            print("Compilation errors:\n");
            var ei: i64 = 0;
            while ei < errs.len() {
                print(errs.get(ei));
                print("\n");
                ei = ei + 1;
            }
            return 1;
        }
    }
    return 1;
}
