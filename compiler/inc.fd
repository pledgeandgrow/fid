// inc.fd -- Incremental compilation cache (ported from src/inc.rs)
//
// Caches the optimized IrModule in memory, keyed by source file path
// and a hash of the source content. On a cache hit, parsing, typechecking,
// IR lowering, and optimization are all skipped -- the cached IrModule is
// reused directly for C code generation.
//
// This is an in-memory cache (no disk persistence) so it only helps within
// a single long-lived process (e.g. the test harness when compiling many
// files in one process). A future extension could serialize the IrModule
// to disk for cross-process caching.
//
// Adaptations from Rust:
// 1. HashMap<K,V> -> Fides HashMap (i64 handle)
// 2. Mutex -> not needed (Fides is single-threaded for now)
// 3. OnceLock -> module-level var
// 4. L2Module -> IrModule (our ccompile pipeline uses IR, not L2)
// 5. u64 -> i64 (Fides uses i64 for all integers)

module compiler::inc;
use core;
use vec;
use string;
use http_client;
use compiler::ir;
use compiler::build_info;
// --- FNV-1a 64-bit hash --------------------------------------------------

/// Compute a hash of the source content (FNV-1a 64-bit).
@wrapping
pub fn hash_source(source: str) -> i64 {
    var hash: i64 = 8834263827529598795;
    // 0xcbf29ce484222325 as signed
    var i: i64 = 0;
    var len: i64 = str_len(source);
    while i < len {
        hash = hash ^ (str_byte_at(source, i) & 0xFF);
        // hash * 0x100000001b3 -- use multiplication with wrapping semantics
        // 0x100000001b3 = 1099511628211
        // In i64 arithmetic, wrapping_mul is just multiplication (wraps on overflow)
        hash = hash * 1099511628211;
        i = i + 1;
    }
    return hash;
}

/// Simple hash function for strings (FNV-1a 64-bit). Alias for hash_source.
pub fn hash_str(s: str) -> i64 {
    return hash_source(s);
}

// --- Build inputs and on-disk stamps (as src/inc.rs) ---------------------
// A build records every file it reads (the program and each imported
// module) and every import candidate it found missing (creating that file
// would change what the import resolves to). `<output>.fides-stamp` keeps
// them with a key (compiler identity, command line, CC, FID_HOME) and a hash
// of the output: a later build whose inputs are all unchanged and whose
// output still holds those bytes is up to date; a build that produces the
// same C as the last one skips the C compiler. The
// in-memory cache above checks the same inputs before reusing a module.

var g_dep_files: Vec<str> = Vec::new();
var g_dep_hashes: Vec<i64> = Vec::new();
var g_dep_absent: Vec<str> = Vec::new();
var g_deps_init: bool = false;
fn inc_deps_ensure() {
    if !g_deps_init {
        var files: Vec<str> = Vec::new();
        var hashes: Vec<i64> = Vec::new();
        var absent: Vec<str> = Vec::new();
        g_dep_files = files;
        g_dep_hashes = hashes;
        g_dep_absent = absent;
        g_deps_init = true;
    }
}

/// Start recording the inputs of a new build.
pub fn inc_deps_reset() {
    g_deps_init = false;
    inc_deps_ensure();
}

fn inc_str_vec_has(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Record that the build read the file at `path`.
pub fn inc_record_file(path: str) {
    inc_deps_ensure();
    if inc_str_vec_has(g_dep_files, path) {
        return;
    }
    g_dep_files.push(path);
    g_dep_hashes.push(p_file_hash(path));
}

/// Record that the build looked for `path` and found nothing there.
pub fn inc_record_absent(path: str) {
    inc_deps_ensure();
    if inc_str_vec_has(g_dep_absent, path) {
        return;
    }
    g_dep_absent.push(path);
}

/// Every file still has its recorded hash and every missing path is
/// still missing.
pub fn inc_deps_unchanged(files: Vec<str>, hashes: Vec<i64>, absent: Vec<str>) -> bool {
    var i: i64 = 0;
    while i < files.len() {
        if p_file_hash(files.get(i)) != hashes.get(i) {
            return false;
        }
        i = i + 1;
    }
    i = 0;
    while i < absent.len() {
        if p_file_exists(absent.get(i)) != 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// A recorded build: what it read, under which key, and its C's hash.
pub struct IncStamp {
    pub ok: bool,
    pub key: i64,
    pub has_c: bool,
    pub c_hash: i64,
    pub has_out: bool,
    pub out_hash: i64,
    pub files: Vec<str>,
    pub hashes: Vec<i64>,
    pub absent: Vec<str>,
}

fn IncStamp_none() -> IncStamp {
    var files: Vec<str> = Vec::new();
    var hashes: Vec<i64> = Vec::new();
    var absent: Vec<str> = Vec::new();
    return IncStamp {
        ok: false, key: 0, has_c: false, c_hash: 0, has_out: false, out_hash: 0, files: files, hashes: hashes, absent: absent
    };
}

/// An environment variable's value, "" when it is not set (p_getenv
/// returns null then, which crashes string concatenation and str_len).
pub fn env_or_empty(name: str) -> str {
    // SP13/SP18: a value the driver gave the variable for this build
    var oi: i64 = 0;
    while oi < g_env_ovr_names.len() {
        if g_env_ovr_names.get(oi) == name {
            return g_env_ovr_vals.get(oi);
        }
        oi = oi + 1;
    }
    var value = p_getenv(name);
    if (value as i64) == 0 {
        return "";
    }
    return value;
}

// SP13/SP18: values the driver gives environment variables inside this
// process only (no child process sees them), read by env_or_empty before
// the real environment: a debug build turns the per-function caches on
// beside its output (main.fd debug_cache_setup) without the user setting
// FID_FNCACHE or FID_IRCACHE, and `fid serve` takes them back after each
// request (env_override_clear). "" stands for "not set".
var g_env_ovr_names: Vec<str> = Vec::new();
var g_env_ovr_vals: Vec<str> = Vec::new();

/// Give `name` the value `value` for env_or_empty (replacing an earlier one).
pub fn env_override_set(name: str, value: str) {
    var i: i64 = 0;
    while i < g_env_ovr_names.len() {
        if g_env_ovr_names.get(i) == name {
            g_env_ovr_vals.set(i, value);
            return;
        }
        i = i + 1;
    }
    g_env_ovr_names.push(name);
    g_env_ovr_vals.push(value);
}

/// Forget every value env_override_set gave.
pub fn env_override_clear() {
    g_env_ovr_names = Vec::new();
    g_env_ovr_vals = Vec::new();
}

// SP18: while `fid serve` runs an `emit` or `ccompile` request, the
// command's arguments are the request's words, not the process's: the
// command handlers (main.fd has_flag, get_flag_value, find_output_arg,
// cmd_build, cmd_ccompile) and the build key read them through argv_at.
var g_argv_req_on: bool = false;
var g_argv_req: Vec<str> = Vec::new();

/// argv[i]: the process's, or, while a `fid serve` request runs, the
/// request's words (index 0 stays the executable, as for a one-shot run).
pub fn argv_at(i: i64) -> str {
    if g_argv_req_on && i > 0 {
        if i < g_argv_req.len() {
            return g_argv_req.get(i);
        }
        return "";
    }
    return p_argv(i);
}

/// SP18: the words of a request ([exe, command, file, flags...]) stand for
/// argv until argv_request_clear.
pub fn argv_request_set(words: Vec<str>) {
    g_argv_req = Vec::new();
    var i: i64 = 0;
    while i < words.len() {
        g_argv_req.push(words.get(i));
        i = i + 1;
    }
    g_argv_req_on = true;
}

/// argc to go with argv_at: the request's word count while one runs.
pub fn argv_count() -> i64 {
    if g_argv_req_on {
        return g_argv_req.len();
    }
    return p_argc();
}

pub fn argv_request_clear() {
    g_argv_req_on = false;
    g_argv_req = Vec::new();
}

/// The hash of a file's bytes (p_file_hash; 0 when it cannot be read),
/// remembered in the temporary directory under the file's path, size and
/// time of last write (p_file_mtime_ms), so this compiler's executable is
/// not read whole on every command (30 ms for 8 MB, ~200 ms for 41 MB).
/// A rebuilt executable has another time, so its hash is taken again.
/// FIDES_SELF_HASH_MEMO=off: always read the file.
fn inc_file_hash_memo(path: str) -> i64 {
    var size: i64 = p_file_size(path);
    if size <= 0 || env_or_empty("FIDES_SELF_HASH_MEMO") == "off" {
        return p_file_hash(path);
    }
    var mtime: i64 = p_file_mtime_ms(path);
    if mtime <= 0 {
        return p_file_hash(path);
    }
    var key: str = "fid-selfhash 1 " + int_to_str(size) + " " + int_to_str(mtime) + " " + path;
    var dir: str = env_or_empty("TEMP");
    if dir == "" {
        dir = env_or_empty("TMPDIR");
    }
    if dir == "" {
        dir = "/tmp";
    }
    var name: str = int_to_str(hash_source(key));
    if str_starts_with(name, "-") {
        name = "n" + str_slice(name, 1, str_len(name));
    }
    var memo: str = dir + "/fid-selfhash-" + name;
    if p_file_exists(memo) != 0 {
        var text: str = "";
        var text__ok: bool = false;
        match read_file(memo) {
            Option::Some(text__t) => {
                text = text__t;
                text__ok = true;
            }
            Option::None => {
            }
        }
        var lines: Vec<str> = str_split(text, "\n");
        // the whole key is in the file: two keys with one file name differ
        if lines.len() >= 2 && lines.get(0) == key {
            var hm: i64 = str_parse_int(lines.get(1));
            if hm != 0 {
                return hm;
            }
        }
    }
    var h: i64 = p_file_hash(path);
    if h != 0 {
        p_file_write(memo, key + "\n" + int_to_str(h) + "\n");
    }
    return h;
}

/// Hash of this compiler's executable: at argv[0], or (started by name) in
/// the PATH entry that holds it. A rebuilt compiler must invalidate stamps.
fn inc_self_hash() -> i64 {
    var exe: str = p_argv(0);
    var h: i64 = inc_file_hash_memo(exe);
    if h == 0 {
        h = inc_file_hash_memo(exe + ".exe");
    }
    if h != 0 {
        return h;
    }
    var path: str = env_or_empty("PATH");
    var sep: str = ":";
    if str_contains(path, ";") {
        sep = ";";
    }
    var dirs: Vec<str> = str_split(path, sep);
    var i: i64 = 0;
    while i < dirs.len() {
        var d: str = dirs.get(i) + "/" + exe;
        h = inc_file_hash_memo(d);
        if h == 0 {
            h = inc_file_hash_memo(d + ".exe");
        }
        if h != 0 {
            return h;
        }
        i = i + 1;
    }
    return 0;
}

/// D9: the size in bytes of this compiler's executable, found where
/// inc_self_hash looks (argv[0], with ".exe", then the PATH entries);
/// -1 when it cannot be found. One seek, no read.
fn inc_self_size() -> i64 {
    var exe: str = p_argv(0);
    var s: i64 = p_file_size(exe);
    if s <= 0 {
        s = p_file_size(exe + ".exe");
    }
    if s > 0 {
        return s;
    }
    var path: str = env_or_empty("PATH");
    var sep: str = ":";
    if str_contains(path, ";") {
        sep = ";";
    }
    var dirs: Vec<str> = str_split(path, sep);
    var i: i64 = 0;
    while i < dirs.len() {
        var d: str = dirs.get(i) + "/" + exe;
        s = p_file_size(d);
        if s <= 0 {
            s = p_file_size(d + ".exe");
        }
        if s > 0 {
            return s;
        }
        i = i + 1;
    }
    return -1;
}

/// D9 (release-roadmap): what inc_compiler_hash, the key of every build
/// cache, is made of:
///   "src"  a release build (scripts/build-info.sh wrote fid_build_source,
///          the hash of the compiler's and the stdlib's source): that hash
///          with the executable's size. Nothing of the executable is read,
///          where "exe" read all of it (50 MB, 0.3 s on a -O0 build) on
///          every command that consults a cache.
///   "exe"  a development build, or FIDES_SELF_HASH=exe: the hash of the
///          executable's bytes (inc_self_hash), as before.
/// The size tells apart the stages of a bootstrap (each built from the same
/// source by another compiler); FIDES_SELF_HASH=exe keeps them strictly
/// apart.
pub fn inc_compiler_identity() -> str {
    if str_len(fid_build_source()) > 0 && env_or_empty("FIDES_SELF_HASH") != "exe" {
        return "src";
    }
    return "exe";
}

var g_self_hash: i64 = 0;
var g_self_hash_done: bool = false;
/// inc_compiler_hash, computed once per run.
pub fn inc_compiler_hash() -> i64 {
    if !g_self_hash_done {
        if inc_compiler_identity() == "src" {
            var exe_size: i64 = inc_self_size();
            if exe_size > 0 {
                g_self_hash = hash_source("fid-src " + fid_build_source() + " " + int_to_str(exe_size));
            } else {
                g_self_hash = 0;
            }
        } else {
            g_self_hash = inc_self_hash();
        }
        g_self_hash_done = true;
    }
    return g_self_hash;
}

var g_exe_hash: i64 = 0;
var g_exe_hash_done: bool = false;
/// inc_exe_hash, computed once per run.
/// N12: the hash of this executable's bytes, whatever inc_compiler_hash is
/// made of (`fid version` names the exact build by it).
pub fn inc_exe_hash() -> i64 {
    if !g_exe_hash_done {
        if inc_compiler_identity() == "exe" {
            g_exe_hash = inc_compiler_hash();
        } else {
            g_exe_hash = inc_self_hash();
        }
        g_exe_hash_done = true;
    }
    return g_exe_hash;
}

// --- Checked core (release D9) ----------------------------------------------
//
// Once this compiler has checked a given core.fd clean (types, borrows,
// reference escapes, secrecy), later builds skip core's bodies. The stamp is
// an empty file in the temporary directory named by the hash of core's text
// and of the compiler executable, so editing either checks core again.

fn inc_core_stamp_path(core_hash: i64) -> str {
    var dir: str = env_or_empty("TEMP");
    if dir == "" {
        dir = env_or_empty("TMPDIR");
    }
    if dir == "" {
        dir = "/tmp";
    }
    var name: str = int_to_str(hash_source("core " + int_to_str(core_hash) + " " + int_to_str(inc_compiler_hash())));
    if str_starts_with(name, "-") {
        name = "n" + str_slice(name, 1, str_len(name));
    }
    return dir + "/fid-core-" + name + ".ok";
}

/// Whether this compiler already checked this core clean.
pub fn inc_core_checked(core_hash: i64) -> bool {
    if core_hash == 0 || inc_compiler_hash() == 0 {
        return false;
    }
    if env_or_empty("FIDES_CHECK_CORE") != "" {
        return false;
    }
    return p_file_exists(inc_core_stamp_path(core_hash)) != 0;
}

/// Record that this compiler checked this core clean. Best-effort.
pub fn inc_core_mark_checked(core_hash: i64) {
    if core_hash == 0 || inc_compiler_hash() == 0 {
        return;
    }
    p_file_write(inc_core_stamp_path(core_hash), "ok\n");
}

/// The key of a build: compiler identity, command, arguments, CC,
/// FIDES_CC_OPT and FID_HOME (which stdlib imports resolve to).
pub fn inc_build_key(command: str, n: i64, start: i64) -> i64 {
    var k: str = int_to_str(inc_compiler_hash()) + " " + command;
    var i: i64 = start + 1;
    while i < n {
        var a: str = argv_at(i);
        if a != "--no-cache" {
            k = k + " " + a;
        }
        i = i + 1;
    }
    k = k + " FID_HOME=" + env_or_empty("FID_HOME");
    return hash_source(k + inc_key_env(true));
}

/// B6: the key of a build as far as one IR unit's object goes: what
/// inc_build_key holds but the input's and the output's names (argument
/// `start + 1` and `-o <output>`), `--inc`, `--seed-store <dir>`, CC and
/// FID_HOME (the other arguments in their order).
/// The unit's key holds its functions, so where they came from does not
/// matter, and a unit of the stdlib gets the same key in every program.
/// `keep_paths`: the build writes the input's name into the C (-g,
/// --leaks, --mem): keep the names.
pub fn inc_unit_build_key(command: str, n: i64, start: i64, keep_paths: bool) -> i64 {
    var k: str = int_to_str(inc_compiler_hash()) + " unit " + command;
    var i: i64 = start + 1;
    while i < n {
        var a: str = argv_at(i);
        if a == "--seed-store" {
            i = i + 1;
        } else if !keep_paths && a == "-o" {
            i = i + 1;
        } else if !keep_paths && i == start + 1 {
        } else if a != "--no-cache" && a != "--inc" {
            k = k + " " + a;
        }
        i = i + 1;
    }
    return hash_source(k + inc_key_env(false));
}

/// The environment a build's key holds (inc_build_key, inc_unit_build_key;
/// a unit's object is stored under the C compiler's name already, so its
/// key leaves CC out: `with_cc` false).
fn inc_key_env(with_cc: bool) -> str {
    var k: str = " FIDES_CC_OPT=" + env_or_empty("FIDES_CC_OPT");
    if with_cc {
        k = " CC=" + env_or_empty("CC") + k;
    }
    // Pass-selection env vars change the emitted code: a stamp written under
    // one FID_IROPT_OFF/FID_IROPT_ON/FID_NAT_OFF set is not the same build.
    k = k + " FID_IROPT_OFF=" + env_or_empty("FID_IROPT_OFF") + " FID_IROPT_ON=" + env_or_empty("FID_IROPT_ON") + " FID_NAT_OFF=" + env_or_empty("FID_NAT_OFF");
    // RL5/VF6: a validated build (compiler/tv.fd) is not an unvalidated one
    k = k + " FID_VALIDATE=" + env_or_empty("FID_VALIDATE");
    // RL5: a build that runs the pairs of tests/verify/tv is not one that does not
    k = k + " FID_TV_PAIRS=" + env_or_empty("FID_TV_PAIRS");
    // VF6: the fault put in on purpose decides what the validation sees
    k = k + " FID_TV_INJECT=" + env_or_empty("FID_TV_INJECT") + " FID_TV_INJECT_IN=" + env_or_empty("FID_TV_INJECT_IN");
    // regions freed in one step (proposal 0005) change the lowering
    k = k + " FID_REGION_ARENA=" + env_or_empty("FID_REGION_ARENA");
    // pe_ir's switches (compiler/pe_ir.fd): passes off, the J7 check, the
    // COFF symbols, a debug build's line tables
    k = k + " FID_PE_OFF=" + env_or_empty("FID_PE_OFF") + " FID_PE_CT_OFF=" + env_or_empty("FID_PE_CT_OFF") + " FID_PE_SYMS=" + env_or_empty("FID_PE_SYMS") + " FID_PE_DEBUG=" + env_or_empty("FID_PE_DEBUG");
    return k;
}

/// Read `<output>.fides-stamp` (ok = false when missing or unreadable).
pub fn inc_stamp_read(path: str) -> IncStamp {
    var st: IncStamp = IncStamp_none();
    if p_file_exists(path) == 0 {
        return st;
    }
    var text: str = "";
    var text__ok: bool = false;
    match read_file(path) {
        Option::Some(text__t) => {
            text = text__t;
            text__ok = true;
        }
        Option::None => {
        }
    }
    var lines: Vec<str> = str_split(text, "\n");
    if lines.len() == 0 {
        return st;
    }
    if lines.get(0) != "fides-stamp-fd 2" {
        return st;
    }
    var has_key: bool = false;
    var i: i64 = 1;
    while i < lines.len() {
        var line: str = lines.get(i);
        if str_starts_with(line, "key ") {
            st.key = str_parse_int(str_slice(line, 4, str_len(line)));
            has_key = true;
        } else if str_starts_with(line, "c ") {
            st.c_hash = str_parse_int(str_slice(line, 2, str_len(line)));
            st.has_c = true;
        } else if str_starts_with(line, "out ") {
            st.out_hash = str_parse_int(str_slice(line, 4, str_len(line)));
            st.has_out = true;
        } else if str_starts_with(line, "file ") {
            var rest: str = str_slice(line, 5, str_len(line));
            var sp: i64 = str_find(rest, " ");
            if sp < 0 {
                return IncStamp_none();
            }
            st.hashes.push(str_parse_int(str_slice(rest, 0, sp)));
            st.files.push(str_slice(rest, sp + 1, str_len(rest)));
        } else if str_starts_with(line, "absent ") {
            st.absent.push(str_slice(line, 7, str_len(line)));
        } else if str_len(line) > 0 {
            return IncStamp_none();
        }
        i = i + 1;
    }
    st.ok = has_key;
    return st;
}

/// `output` still holds the bytes the recorded build wrote: anything else
/// writing that path (another compiler, another command) is not this build.
fn inc_output_intact(st: IncStamp, output: str) -> bool {
    return st.has_out && p_file_exists(output) != 0 && p_file_hash(output) == st.out_hash;
}

/// Nothing changed since the build that wrote `output`.
pub fn inc_up_to_date(st: IncStamp, key: i64, output: str) -> bool {
    if !st.ok || st.key != key || st.files.len() == 0 {
        return false;
    }
    if !inc_output_intact(st, output) {
        return false;
    }
    return inc_deps_unchanged(st.files, st.hashes, st.absent);
}

/// The previous build produced `output` from exactly this C code.
pub fn inc_c_unchanged(st: IncStamp, key: i64, output: str, c_hash: i64) -> bool {
    if !st.ok || st.key != key || !st.has_c {
        return false;
    }
    return st.c_hash == c_hash && inc_output_intact(st, output);
}

/// Record a successful build. Nothing is written unless the build recorded
/// `main_input`: a pipeline that does not record its inputs must never be
/// reported up to date.
pub fn inc_stamp_commit(path: str, key: i64, c_hash: i64, main_input: str, output: str) {
    inc_stamp_commit_hash(path, key, c_hash, main_input, p_file_hash(output));
}

/// FNV-1a 64 of the bytes (each element's low byte): p_file_hash of a file
/// holding them. `emit` hashes its output in memory, not by reopening the
/// file it just wrote (on Windows the first read of a new .exe waits for the
/// virus scanner: 350 ms for a 300 KB program).
@wrapping
pub fn inc_bytes_hash(bytes: Vec<i64>) -> i64 {
    var h: i64 = -3750763034362895579;
    var i: i64 = 0;
    while i < bytes.len() {
        h = (h ^ (bytes.get(i) & 255)) * 1099511628211;
        i = i + 1;
    }
    return h;
}

/// inc_stamp_commit with the output's hash already known.
pub fn inc_stamp_commit_hash(path: str, key: i64, c_hash: i64, main_input: str, out_hash: i64) {
    inc_deps_ensure();
    if !inc_str_vec_has(g_dep_files, main_input) {
        p_file_delete(path);
        return;
    }
    var s: str = "fides-stamp-fd 2\nkey " + int_to_str(key) + "\nc " + int_to_str(c_hash) + "\n";
    s = s + "out " + int_to_str(out_hash) + "\n";
    var i: i64 = 0;
    while i < g_dep_files.len() {
        s = s + "file " + int_to_str(g_dep_hashes.get(i)) + " " + g_dep_files.get(i) + "\n";
        i = i + 1;
    }
    i = 0;
    while i < g_dep_absent.len() {
        s = s + "absent " + g_dep_absent.get(i) + "\n";
        i = i + 1;
    }
    p_file_write(path, s);
}

/// Snapshot of the recorded inputs (for the in-memory cache).
pub fn inc_deps_files() -> Vec<str> {
    inc_deps_ensure();
    return g_dep_files;
}
pub fn inc_deps_hashes() -> Vec<i64> {
    inc_deps_ensure();
    return g_dep_hashes;
}
pub fn inc_deps_absent() -> Vec<str> {
    inc_deps_ensure();
    return g_dep_absent;
}

// --- Cache entry ---------------------------------------------------------

pub struct IncCacheEntry {
    pub path: str,
    pub hash: i64,
    pub module: IrModule,
    // The build's inputs: the entry is valid only while they are unchanged
    // (keying on the main file alone reused a module after an import changed).
    pub dep_files: Vec<str>,
    pub dep_hashes: Vec<i64>,
    pub dep_absent: Vec<str>,
}

// --- Incremental cache --------------------------------------------------

/// Incremental compilation cache. Stores optimized IrModules keyed by
/// (source_path, source_hash). In-memory only.
pub struct IncrementalCache {
    pub entries: Vec<IncCacheEntry>,
}

pub fn IncrementalCache_new() -> IncrementalCache {
    return IncrementalCache {
        entries: Vec::new(),
    };
}

/// Look up a cached IrModule by source path + hash.
/// Returns OptIrModule::Some(module) on hit, OptIrModule::None on miss.
pub fn IncrementalCache_get(self: &IncrementalCache, source_path: str, source_hash: i64) -> OptIrModule {
    var i: i64 = 0;
    while i < self.entries.len() {
        var entry: IncCacheEntry = self.entries.get(i);
        if entry.path == source_path && entry.hash == source_hash && inc_deps_unchanged(entry.dep_files, entry.dep_hashes, entry.dep_absent) {
            return OptIrModule::Some(entry.module);
        }
        i = i + 1;
    }
    return OptIrModule::None;
}

/// Store an IrModule in the cache. If an entry with the same path exists,
/// it is replaced.
pub fn IncrementalCache_store(self: &mut IncrementalCache, source_path: str, source_hash: i64, module: IrModule) {
    var i: i64 = 0;
    while i < self.entries.len() {
        if self.entries.get(i).path == source_path {
            self.entries.set(i, IncCacheEntry {
                path: source_path, hash: source_hash, module: module, dep_files: inc_deps_files(), dep_hashes: inc_deps_hashes(), dep_absent: inc_deps_absent(),
            });
            return;
        }
        i = i + 1;
    }
    self.entries.push(IncCacheEntry {
        path: source_path, hash: source_hash, module: module, dep_files: inc_deps_files(), dep_hashes: inc_deps_hashes(), dep_absent: inc_deps_absent(),
    });
}

/// Clear all cached entries.
pub fn IncrementalCache_clear(self: &mut IncrementalCache) {
    // Pop all entries (Fides Vec::new() is untyped, so we can't reassign)
    while self.entries.len() > 0 {
        self.entries.pop();
    }
}

/// Number of cached entries.
pub fn IncrementalCache_len(self: &IncrementalCache) -> i64 {
    return self.entries.len();
}

/// Whether the cache is empty.
pub fn IncrementalCache_is_empty(self: &IncrementalCache) -> bool {
    return self.entries.len() == 0;
}

// --- Global cache (module-level var) -------------------------------------
// Fides now supports module-level `var`/`pub var`, so the global cache
// uses a module-level mutable variable to persist across calls within
// a single process. This enables incremental compilation -- on a cache
// hit, parsing, typechecking, and IR lowering are all skipped.
//
// NOTE: The C backend emits struct-typed globals as zero-initialized
// pointers (it can't call IncrementalCache_new() in a static initializer).
// So we use lazy initialization: on first access, if the cache is empty,
// we initialize it. This matches the Rust compiler's OnceLock approach.

pub var g_cache: IncrementalCache = IncrementalCache_new();
var g_cache_init: bool = false;
/// Ensure the global cache is initialized (lazy init for C backend).
fn ensure_cache_init() -> void {
    if !g_cache_init {
        g_cache = IncrementalCache_new();
        g_cache_init = true;
    }
}

/// Store an IrModule in the global cache.
pub fn global_cache_store(source_path: str, source_hash: i64, module: IrModule) {
    ensure_cache_init();
    IncrementalCache_store(&mut g_cache, source_path, source_hash, module);
}

/// Look up a cached IrModule by source path + hash.
/// Returns OptIrModule::Some(module) on hit, OptIrModule::None on miss.
pub fn global_cache_get(source_path: str, source_hash: i64) -> OptIrModule {
    ensure_cache_init();
    return IncrementalCache_get(&g_cache, source_path, source_hash);
}

/// Clear the global cache.
pub fn global_cache_clear() {
    ensure_cache_init();
    IncrementalCache_clear(&mut g_cache);
}

// --- Canonical C and the artifact store (as src/inc.rs) ------------------
// The stamp keys a build on its inputs. The artifact store keys a built
// binary on what the program compiles to: a hash of the generated C with
// comments and whitespace gone, the functions it defines alpha-renamed
// positionally (except `main`) and unreferenced ones dropped. Every other
// identifier stays: an external C function names what the program does.
// `// PLINK:` lines stay too: they choose what is linked.

/// Tokens of a C source: spans, and whether each is an identifier.
pub struct CTokens {
    pub is_ident: Vec<i64>,
    pub starts: Vec<i64>,
    pub ends: Vec<i64>,
}

fn c_is_ident_start(c: i64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
}

fn c_is_digit(c: i64) -> bool {
    return c >= 48 && c <= 57;
}

fn c_push_tok(t: &mut CTokens, ident: i64, start: i64, end: i64) {
    t.is_ident.push(ident);
    t.starts.push(start);
    t.ends.push(end);
}

pub fn inc_lex_c(src: str) -> CTokens {
    var t: CTokens = CTokens {
        is_ident: Vec::new(), starts: Vec::new(), ends: Vec::new()
    };
    var n: i64 = str_len(src);
    var i: i64 = 0;
    var at_line_start: bool = true;
    while i < n {
        var c: i64 = str_byte_at(src, i);
        if c == 10 || c == 13 || c == 32 || c == 9 || c == 11 || c == 12 {
            at_line_start = c == 10;
            i = i + 1;
        } else if c == 47 && i + 1 < n && str_byte_at(src, i + 1) == 47 {
            var cs: i64 = i;
            while i < n && str_byte_at(src, i) != 10 {
                i = i + 1;
            }
            if i - cs >= 9 && str_starts_with(str_slice_len(src, n, cs, cs + 9), "// PLINK:") {
                c_push_tok(&mut t, 0, cs, i);
            }
        } else if c == 47 && i + 1 < n && str_byte_at(src, i + 1) == 42 {
            i = i + 2;
            while i + 1 < n && !(str_byte_at(src, i) == 42 && str_byte_at(src, i + 1) == 47) {
                i = i + 1;
            }
            i = i + 2;
            if i > n {
                i = n;
            }
        } else if c == 35 && at_line_start {
            var ps: i64 = i;
            while i < n && str_byte_at(src, i) != 10 {
                i = i + 1;
            }  // A line ending in '\' continues the directive.
            while i < n && str_byte_at(src, i - 1) == 92 {
                i = i + 1;
                while i < n && str_byte_at(src, i) != 10 {
                    i = i + 1;
                }
            }
            c_push_tok(&mut t, 0, ps, i);
        } else if c_is_ident_start(c) {
            at_line_start = false;
            var ids: i64 = i;
            while i < n && (c_is_ident_start(str_byte_at(src, i)) || c_is_digit(str_byte_at(src, i))) {
                i = i + 1;
            }
            c_push_tok(&mut t, 1, ids, i);
        } else if c == 34 || c == 39 {
            at_line_start = false;
            var qs: i64 = i;
            i = i + 1;
            while i < n && str_byte_at(src, i) != c {
                if str_byte_at(src, i) == 92 {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            if i > n {
                i = n;
            }
            c_push_tok(&mut t, 0, qs, i);
        } else if c_is_digit(c) {
            at_line_start = false;
            var ds: i64 = i;
            while i < n {
                var d: i64 = str_byte_at(src, i);
                if !(c_is_ident_start(d) || c_is_digit(d) || d == 46) {
                    break;
                }
                i = i + 1;
            }
            c_push_tok(&mut t, 0, ds, i);
        } else {
            at_line_start = false;
            c_push_tok(&mut t, 0, i, i + 1);
            i = i + 1;
        }
    }
    return t;
}

/// The one-character token `c`?
fn c_tok_is(src: str, t: &CTokens, i: i64, c: i64) -> bool {
    return t.is_ident.get(i) == 0 && t.ends.get(i) - t.starts.get(i) == 1 && str_byte_at(src, t.starts.get(i)) == c;
}

/// Is this token a preprocessor line or a retained comment line? Either
/// way it is not part of a declaration's text — a stmt_start pointing at
/// one would swallow it into the def's span (a `#define` slab moved into
/// the owner's tail, then duplicated in every unit's prelude).
fn inc_c_tok_is_meta(src: str, t: &CTokens, i: i64) -> bool {
    if t.is_ident.get(i) != 0 {
        return false;
    }
    var s: i64 = t.starts.get(i);
    if str_byte_at(src, s) == 35 {
        return true;
    }
    return str_byte_at(src, s) == 47 && s + 1 < t.ends.get(i) && str_byte_at(src, s + 1) == 47;
}

/// Top-level function definitions: `... name ( ... ) { ... }` at depth 0.
pub struct CDefs {
    pub names: Vec<str>,
    pub name_toks: Vec<i64>,
    pub start_toks: Vec<i64>,
    pub end_toks: Vec<i64>,
}

pub fn inc_find_c_defs(src: str, t: &CTokens) -> CDefs {
    var defs: CDefs = CDefs {
        names: Vec::new(), name_toks: Vec::new(), start_toks: Vec::new(), end_toks: Vec::new()
    };
    var n: i64 = t.starts.len();
    var slen: i64 = str_len(src);
    var depth: i64 = 0;
    var stmt_start: i64 = 0;
    var j: i64 = 0;
    while j < n {
        var is_def: bool = false;
        if c_tok_is(src, t, j, 123) {
            depth = depth + 1;
        } else if c_tok_is(src, t, j, 125) {
            depth = depth - 1;
            if depth == 0 {
                stmt_start = j + 1;
            }
        } else if c_tok_is(src, t, j, 59) && depth == 0 {
            stmt_start = j + 1;
        }
        if depth == 0 && t.is_ident.get(j) == 1 && j + 1 < n && c_tok_is(src, t, j + 1, 40) {
            var d: i64 = 0;
            var k: i64 = j + 1;
            while k < n {
                if c_tok_is(src, t, k, 40) {
                    d = d + 1;
                }
                if c_tok_is(src, t, k, 41) {
                    d = d - 1;
                }
                if d == 0 {
                    break;
                }
                k = k + 1;
            }
            if k + 1 < n && c_tok_is(src, t, k + 1, 123) {
                var d2: i64 = 0;
                var m: i64 = k + 1;
                while m < n {
                    if c_tok_is(src, t, m, 123) {
                        d2 = d2 + 1;
                    }
                    if c_tok_is(src, t, m, 125) {
                        d2 = d2 - 1;
                    }
                    if d2 == 0 {
                        break;
                    }
                    m = m + 1;
                }
                var e: i64 = m + 1;
                if e > n {
                    e = n;
                }
                // The def's own text starts at its first non-directive
                // token, not at stmt_start — `#define`/`//` lines between
                // statements belong to the shared prelude, not to this def.
                var s: i64 = stmt_start;
                while s < j && inc_c_tok_is_meta(src, t, s) {
                    s = s + 1;
                }
                defs.names.push(str_slice_len(src, slen, t.starts.get(j), t.ends.get(j)));
                defs.name_toks.push(j);
                defs.start_toks.push(s);
                defs.end_toks.push(e);
                j = m + 1;
                stmt_start = j;
                is_def = true;
            }
        }
        if !is_def {
            j = j + 1;
        }
    }
    return defs;
}

@wrapping
fn inc_mix(h: i64, src: str, start: i64, end: i64) -> i64 {
    var i: i64 = start;
    var r: i64 = h;
    while i < end {
        r = (r ^ (str_byte_at(src, i) & 0xFF)) * 1099511628211;
        i = i + 1;
    }
    return r;
}

/// Hash of the canonical form of generated C.
/// Mark definition `d` live, with every other definition of its name.
fn inc_mark_def(d: i64, live: &mut Vec<i64>, work: &mut Vec<i64>, same_prev: Vec<i64>) {
    var k: i64 = d;
    while k >= 0 {
        if live.get(k) == 0 {
            live.set(k, 1);
            work.push(k);
        }
        k = same_prev.get(k);
    }
}

pub fn inc_canon_hash(src: str) -> i64 {
    return inc_canon_hash_ex(src, false);
}

/// Key hash of one `ccompile --inc` unit's object file (inc-roadmap B7/B8).
/// Like `inc_canon_hash`, except that a function with external linkage (a
/// definition not marked `static`) keeps its own name and is always live:
/// other units link against that name, so it is part of what the object
/// is. With the plain canonical hash, renaming an exported function whose
/// unit holds no string naming it (the `__p_fns` table is in the owner
/// unit only) reused the old object, and two modules whose code differed
/// only in their function names shared one object: either way the link
/// failed (undefined or duplicate symbol). `static` helpers are still
/// renamed positionally: nothing outside the unit can see their names.
pub fn inc_unit_hash(src: str) -> i64 {
    return inc_canon_hash_ex(src, true);
}

/// `name` (a module name such as `compiler::lexer`) as a file name: every
/// byte other than a letter, digit or `_` becomes `_` (as fidesc does).
pub fn inc_unit_file_name(name: str) -> str {
    var bytes: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < str_len(name) {
        var c: i64 = str_byte_at(name, i);
        if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 {
            bytes.push(c);
        } else {
            bytes.push(95);
        }
        i = i + 1;
    }
    return str_from_bytes(bytes);
}

/// Definition `d` is `static` (internal linkage): the word `static` comes
/// before its name.
fn inc_def_is_static(src: str, t: &CTokens, defs: &CDefs, d: i64) -> bool {
    var slen: i64 = str_len(src);
    var k: i64 = defs.start_toks.get(d);
    while k < defs.name_toks.get(d) {
        if t.is_ident.get(k) == 1 && str_slice_len(src, slen, t.starts.get(k), t.ends.get(k)) == "static" {
            return true;
        }
        k = k + 1;
    }
    return false;
}

fn inc_canon_hash_ex(src: str, keep_linked: bool) -> i64 {
    var t: CTokens = inc_lex_c(src);
    var defs: CDefs = inc_find_c_defs(src, &t);
    var n: i64 = t.starts.len();
    var slen: i64 = str_len(src);
    var in_body: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        in_body.push(-1);
        i = i + 1;
    }
    var def_index: i64 = HashMap_new();
    // A name defined more than once (one definition per #if branch): each
    // definition points at the previous one, and all are live together
    var same_prev: Vec<i64> = Vec::new();
    var di: i64 = 0;
    while di < defs.names.len() {
        same_prev.push(HashMap_get(def_index, defs.names.get(di)) - 1);
        HashMap_insert(def_index, defs.names.get(di), di + 1);
        var k: i64 = defs.start_toks.get(di);
        while k < defs.end_toks.get(di) {
            in_body.set(k, di);
            k = k + 1;
        }
        di = di + 1;
    }
    // Liveness: roots are `main` and every identifier outside a definition
    var live: Vec<i64> = Vec::new();
    di = 0;
    while di < defs.names.len() {
        live.push(0);
        di = di + 1;
    }
    var work: Vec<i64> = Vec::new();
    var main_slot: i64 = HashMap_get(def_index, "main");
    if main_slot != 0 {
        inc_mark_def(main_slot - 1, &mut live, &mut work, same_prev);
    }
    // Unit keys: every externally linked definition is a root and keeps
    // its name (a name with any non-static definition counts as linked).
    var linked: i64 = HashMap_new();
    if keep_linked {
        di = 0;
        while di < defs.names.len() {
            if !inc_def_is_static(src, &t, &defs, di) {
                HashMap_insert(linked, defs.names.get(di), 1);
                inc_mark_def(di, &mut live, &mut work, same_prev);
            }
            di = di + 1;
        }
    }
    i = 0;
    while i < n {
        if t.is_ident.get(i) == 1 && in_body.get(i) < 0 {
            var slot: i64 = HashMap_get(def_index, str_slice_len(src, slen, t.starts.get(i), t.ends.get(i)));
            if slot != 0 {
                inc_mark_def(slot - 1, &mut live, &mut work, same_prev);
            }
        }
        i = i + 1;
    }
    while work.len() > 0 {
        var d: i64 = work.pop();
        var k: i64 = defs.name_toks.get(d) + 1;
        while k < defs.end_toks.get(d) {
            if t.is_ident.get(k) == 1 {
                var s2: i64 = HashMap_get(def_index, str_slice_len(src, slen, t.starts.get(k), t.ends.get(k)));
                if s2 != 0 {
                    inc_mark_def(s2 - 1, &mut live, &mut work, same_prev);
                }
            }
            k = k + 1;
        }
    }
    // Alpha-rename defined functions positionally; hash the kept tokens.
    // (String constants `_strN` keep their names: their contents are in
    // `#define` lines hashed verbatim, so renaming a use positionally
    // would let a unit that switched from one literal to another reuse
    // the object of the old one.)
    var numbers: i64 = HashMap_new();
    var next: i64 = 1;
    var h: i64 = 8834263827529598795;
    i = 0;
    while i < n {
        var owner: i64 = in_body.get(i);
        if owner < 0 || live.get(owner) != 0 {
            var s: i64 = t.starts.get(i);
            var e: i64 = t.ends.get(i);
            var renamed: i64 = 0;
            if t.is_ident.get(i) == 1 {
                var name: str = str_slice_len(src, slen, s, e);
                if name != "main" && HashMap_get(def_index, name) != 0 && HashMap_get(linked, name) == 0 {
                    renamed = HashMap_get(numbers, name);
                    if renamed == 0 {
                        renamed = next;
                        next = next + 1;
                        HashMap_insert(numbers, name, renamed);
                    }
                }
            }
            if renamed != 0 {
                var tag: str = "@" + int_to_str(renamed);
                h = inc_mix(h, tag, 0, str_len(tag));
            } else {
                h = inc_mix(h, src, s, e);
            }
            h = inc_mix(h, " ", 0, 1);
        }
        i = i + 1;
    }
    return h;
}

/// Byte spans of top-level function definitions: names, start, the `{`, end.
pub struct CDefSpans {
    pub names: Vec<str>,
    pub starts: Vec<i64>,
    pub braces: Vec<i64>,
    pub ends: Vec<i64>,
}

pub fn inc_c_fn_defs(src: str) -> CDefSpans {
    var t: CTokens = inc_lex_c(src);
    var defs: CDefs = inc_find_c_defs(src, &t);
    var out: CDefSpans = CDefSpans {
        names: Vec::new(), starts: Vec::new(), braces: Vec::new(), ends: Vec::new()
    };
    var i: i64 = 0;
    while i < defs.names.len() {
        var e: i64 = defs.end_toks.get(i);
        var k: i64 = defs.name_toks.get(i);
        while k < e && !c_tok_is(src, &t, k, 123) {
            k = k + 1;
        }
        out.names.push(defs.names.get(i));
        out.starts.push(t.starts.get(defs.start_toks.get(i)));
        out.braces.push(t.starts.get(k));
        out.ends.push(t.ends.get(e - 1));
        i = i + 1;
    }
    return out;
}

/// The directory holding `output`.
fn inc_dir_of(output: str) -> str {
    var i: i64 = str_len(output) - 1;
    while i >= 0 {
        var c: i64 = str_byte_at(output, i);
        if c == 47 || c == 92 {
            return str_slice(output, 0, i);
        }
        i = i - 1;
    }
    return ".";
}

/// Store path `<dir>/.fidcache/<key>.exe` of an artifact: keyed on content,
/// toolchain and flags, so any build (this output or another) reuses it.
pub fn inc_artifact_path(output: str, canon: i64, tool: str, flags: str) -> str {
    var key: i64 = hash_source("a1 " + int_to_str(canon) + " " + tool + " " + flags);
    var name: str = int_to_str(key);
    if str_starts_with(name, "-") {
        name = "n" + str_slice(name, 1, str_len(name));
    }
    return inc_dir_of(output) + "/.fidcache/" + name + ".exe";
}

/// Copy `path` to `dest` if the artifact exists — local `.fidcache` first,
/// then the seeded store shipped with the toolchain (B6, inc_seed_get),
/// then the remote CAS (`FIDES_CAS`, served by tools/cas.fd). A remote hit
/// is also written back into the local store. The copy is written as bytes:
/// a new `dest` has no execute bit, so a caller restoring an executable sets
/// it (BG36: main.fd cmd_ccompile's "Reused cached artifact").
pub fn inc_artifact_get(path: str, dest: str) -> bool {
    if p_file_exists(path) != 0 {
        inc_lru_touch(path);
        return p_file_write_vec(dest, p_file_read_bytes(path)) >= 0;
    }
    if inc_seed_get(inc_base_name(path), dest) {
        return true;
    }
    var body: str = inc_cas_get(inc_base_name(path));
    if str_len(body) == 0 {
        return false;
    }
    if p_file_write_vec(dest, str_bytes(body)) < 0 {
        return false;
    }
    // Populate the local store so the next build stays off the network.
    p_mkdir(inc_dir_of(path));
    var tmp: str = path + ".tmp";
    p_file_write_vec(tmp, str_bytes(body));
    if p_rename(tmp, path) != 0 {
        p_file_delete(tmp);
    }
    inc_lru_touch(path);
    return true;
}

/// Store `source` under `path`. Best-effort: a cache failure never breaks a
/// build. When `FIDES_CAS` is set the artifact is also mirrored remotely.
pub fn inc_artifact_put(path: str, source: str) {
    p_mkdir(inc_dir_of(path));
    var tmp: str = path + ".tmp";
    p_file_write_vec(tmp, p_file_read_bytes(source));
    p_rename(tmp, path);
    inc_lru_touch(path);
    inc_cache_evict(inc_dir_of(path));
    inc_cas_put(inc_base_name(path), source);
}

// --- Seeded store (inc-roadmap B6) -----------------------------------------
//
// A read-only store of unit objects shipped with the toolchain:
// `<fid dir>/cache/` (main.fd sets it from compiler.fd fid_seed_store_dir),
// filled by `fid ccompile --inc --seed-store <dir>` builds of the examples
// (installer/build-installer.sh). An object there is named as in a
// `.fidcache` (inc_artifact_path: the key of the unit's input, the C
// compiler and its flags), so a fresh project's core and stdlib units are
// found there and not compiled. Looked up after the local `.fidcache` and
// before FIDES_CAS; never written to by a build, never evicted.
// FIDES_SEED_STORE=<dir> names another store, FIDES_SEED_STORE=off none.

var g_inc_seed_dir: str = "";
var g_inc_seed_hits: i64 = 0;
/// The seeded store of this toolchain ("" = none).
/// (Once per build: the hit count starts again.)
pub fn inc_set_seed_dir(dir: str) {
    g_inc_seed_dir = dir;
    g_inc_seed_hits = 0;
}

/// How many artifacts this run took from the seeded store.
pub fn inc_seed_hits() -> i64 {
    return g_inc_seed_hits;
}

/// The seeded store's directory, "" when there is none.
fn inc_seed_dir() -> str {
    var e: str = env_or_empty("FIDES_SEED_STORE");
    if e == "off" {
        return "";
    }
    if str_len(e) > 0 {
        return e;
    }
    return g_inc_seed_dir;
}

/// Copy the seeded store's artifact `name` to `dest`; false on a miss.
fn inc_seed_get(name: str, dest: str) -> bool {
    var dir: str = inc_seed_dir();
    if str_len(dir) == 0 {
        return false;
    }
    var p: str = dir + "/" + name;
    if p_file_exists(p) == 0 {
        return false;
    }
    var bytes: Vec<i64> = p_file_read_bytes(p);
    if bytes.len() == 0 {
        return false;
    }
    if p_file_write_vec(dest, bytes) < 0 {
        return false;
    }
    g_inc_seed_hits = g_inc_seed_hits + 1;
    // tests/tooling/inc-seed-store-check.sh reads this line
    if str_len(env_or_empty("FIDES_INC_DEBUG")) > 0 {
        p_eprint_str("[inc] seeded store: " + name + "\n");
    }
    return true;
}

/// Store the object `source` in the seeded store `dir` under the name of
/// artifact `path` (`ccompile --inc --seed-store <dir>`). An object already
/// there has the same key, so the same content: it is kept.
pub fn inc_seed_put(dir: str, path: str, source: str) {
    if str_len(dir) == 0 || str_len(path) == 0 {
        return;
    }
    p_mkdir(dir);
    var dest: str = dir + "/" + inc_base_name(path);
    if p_file_exists(dest) != 0 {
        return;
    }
    var bytes: Vec<i64> = p_file_read_bytes(source);
    if bytes.len() == 0 {
        return;
    }
    var tmp: str = dest + ".tmp";
    p_file_write_vec(tmp, bytes);
    if p_rename(tmp, dest) != 0 {
        p_file_delete(tmp);
    }
}

// --- Remote cache (inc-roadmap A11) ----------------------------------------
//
// FIDES_CAS=http://host:port enables a shared content-addressed store
// (tools/cas.fd serves it). Every remote failure is silent — a down or
// unreachable cache server never fails a build.

/// The FIDES_CAS base URL without trailing slashes; "" when unset.
fn inc_cas_base() -> str {
    var u: str = env_or_empty("FIDES_CAS");
    while str_len(u) > 0 && str_byte_at(u, str_len(u) - 1) == 47 {
        u = str_slice(u, 0, str_len(u) - 1);
    }
    return u;
}

/// GET <FIDES_CAS>/cas/<name>: the body, or "" on a miss/any error.
/// An artifact body is never empty, so "" unambiguously means "no hit".
fn inc_cas_get(name: str) -> str {
    var base: str = inc_cas_base();
    if str_len(base) == 0 {
        return "";
    }
    var r: HttpResponse = http_get_url(base + "/cas/" + name);
    if r.status != 200 {
        return "";
    }
    // A truncated transfer would store a corrupt artifact — poison for every
    // later build — so a declared Content-Length must match the body.
    var cl: str = http_resp_header(r, "content-length");
    if str_len(cl) > 0 && str_parse_int(cl) != str_len(r.body) {
        return "";
    }
    return r.body;
}

/// PUT <FIDES_CAS>/cas/<name> with the artifact bytes. Fire-and-forget.
fn inc_cas_put(name: str, source: str) {
    var base: str = inc_cas_base();
    if str_len(base) == 0 {
        return;
    }
    var body: str = str_from_bytes(p_file_read_bytes(source));
    if str_len(body) == 0 {
        return;
    }
    http_put_url(base + "/cas/" + name, body);
}

// --- Eviction (release C8) -------------------------------------------------
//
// `.fidcache/lru` lists artifact names, one per line, in the order they were
// last stored or used (a name may appear more than once; its last line
// counts). Past INC_CACHE_MAX_FILES artifacts or INC_CACHE_MAX_BYTES bytes,
// the least recently used are deleted and the list is rewritten.

const INC_CACHE_MAX_FILES: i64 = 64;
const INC_CACHE_MAX_BYTES: i64 = 1073741824;
/// The file name part of `path`.
fn inc_base_name(path: str) -> str {
    var i: i64 = str_len(path) - 1;
    while i >= 0 {
        var c: i64 = str_byte_at(path, i);
        if c == 47 || c == 92 {
            return str_slice(path, i + 1, str_len(path));
        }
        i = i - 1;
    }
    return path;
}

/// Record that the artifact at `path` was just stored or used.
fn inc_lru_touch(path: str) {
    p_file_append(inc_dir_of(path) + "/lru", inc_base_name(path) + "\n");
}

/// The lines of `text`, without empty ones.
fn inc_lines(text: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var n: i64 = str_len(text);
    var start: i64 = 0;
    var i: i64 = 0;
    while i <= n {
        if i == n || str_byte_at(text, i) == 10 {
            var end: i64 = i;
            if end > start && str_byte_at(text, end - 1) == 13 {
                end = end - 1;
            }
            if end > start {
                out.push(str_slice(text, start, end));
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

/// Keep the cache in `dir` (a `.fidcache` directory) under its limits.
pub fn inc_cache_evict(dir: str) {
    var log: str = "";
    var log__ok: bool = false;
    match read_file(dir + "/lru") {
        Option::Some(log__t) => {
            log = log__t;
            log__ok = true;
        }
        Option::None => {
        }
    }
    if !log__ok {
        return;
    }
    var lines: Vec<str> = inc_lines(log);
    // Most recent first, each name once, only those still on disk
    var order: Vec<str> = Vec::new();
    var sizes: Vec<i64> = Vec::new();
    var i: i64 = lines.len() - 1;
    while i >= 0 {
        var name: str = lines.get(i);
        var seen: bool = false;
        var k: i64 = 0;
        while k < order.len() && !seen {
            if order.get(k) == name {
                seen = true;
            }
            k = k + 1;
        }
        if !seen && p_file_exists(dir + "/" + name) != 0 {
            order.push(name);
            sizes.push(p_file_size(dir + "/" + name));
        }
        i = i - 1;
    }
    var total: i64 = 0;
    i = 0;
    while i < sizes.len() {
        total = total + sizes.get(i);
        i = i + 1;
    }
    var compact: bool = lines.len() > 4 * INC_CACHE_MAX_FILES;
    if order.len() <= INC_CACHE_MAX_FILES && total <= INC_CACHE_MAX_BYTES && !compact {
        return;
    }
    // Keep the most recent within the limits; delete the rest
    var kept: Vec<str> = Vec::new();
    var used: i64 = 0;
    i = 0;
    while i < order.len() {
        if kept.len() < INC_CACHE_MAX_FILES && used + sizes.get(i) <= INC_CACHE_MAX_BYTES {
            kept.push(order.get(i));
            used = used + sizes.get(i);
        } else {
            p_file_delete(dir + "/" + order.get(i));
        }
        i = i + 1;
    }
    // Rewrite the list oldest first
    var text: str = "";
    i = kept.len() - 1;
    while i >= 0 {
        text = text + kept.get(i) + "\n";
        i = i - 1;
    }
    p_file_write(dir + "/lru", text);
}

// --- SP11: arenas for one function's compiler data -----------------------
// The data the compiler makes for one function (its machine IR, the
// allocator's tables, one pass's analyses) can live in a window that one
// step gives back: fn_arena_begin takes the C runtime's allocator mark
// (p_arena_save), fn_arena_end goes back to it (p_arena_restore), which
// returns every arena chunk taken since to the system and resets the bump
// pointer, so the next function's data reuses the same memory.
//
// Opt-in: FID_FN_ARENA=1 in the compiler's environment, and only where the
// runtime has marks (the C runtime). p_arena_save is 0 in the interpreter,
// pe_ir and the machine layer: fn_arena_begin then returns 0 and the call
// site runs its work as usual. No window opens while a region (proposal
// 0005) is open, nor inside another window.
//
// A window is sound only when nothing made in it is reachable after its
// end. The rule for a call site:
//   - the work is calls whose arguments they only read; they change no
//     global and nothing outside their own locals (no push, insert or set
//     on a container they were given, no table built lazily on first use);
//   - taking an owner of a Vec or map made before the window (a `let` of
//     `t.get(i)`, a struct copy that holds one) is a change too: the first
//     share of a container makes its share box (core Vec_share,
//     HashMap_share), and a box made inside the window is given back at
//     its end while the container outside still points to it (a later
//     change of that container then frees garbage: "Double free" in
//     vec_own). Every container outside the work keeps must be shared
//     once before fn_arena_begin and that owner kept until after
//     fn_arena_end (a pin: `var pin: Vec<i64> = t.get(i);`); a share
//     inside the window then only counts the existing box up and down.
//     Reading elements and lengths through a reference is fine; so is a
//     string (its count is in its own header);
//   - every variable the call site assigns after the window is declared
//     before fn_arena_begin (a `Vec::new()` made inside the window is given
//     back at its end);
//   - each result is handed to fn_arena_keep_* in the statement that makes
//     it (the temporary is dropped at the end of that statement, inside the
//     window), and taken back with fn_arena_take_* after fn_arena_end, in
//     the order kept:
//         var m: i64 = fn_arena_begin();
//         if m == 0 {
//             res = work(x);
//         } else {
//             fn_arena_keep_words(work(x));
//             fn_arena_end(m);
//             res = fn_arena_take_words();
//         }
// What is kept is copied into the hold block: a block of at least 2 MB,
// which the C runtime takes from calloc, outside every arena chunk, so a
// restore never gives it back (it grows the same way inside a window).
// The C runtime's p_arena_restore empties its free lists, blocks freed
// before the window included: those are not reused afterwards.
// tests/tooling/fn_arena_unit.fd and fn-arena-check.sh check the rule's
// results on the C path.

const FNA_HOLD_MIN: i64 = 262144;  // words (2 MB): over the 1 MB of pooled blocks
const FNA_CHUNK: i64 = 4194304;  // the C runtime's arena chunk (__P_ARENA_CHUNK_SIZE)
var g_fna_state: i64 = 0 - 1;  // FID_FN_ARENA: -1 not read yet, 0 off, 1 on
var g_fna_hold: i64 = 0;  // the hold block (0: none yet)
var g_fna_cap: i64 = 0;  // its size in words
var g_fna_len: i64 = 0;  // words kept since the last fn_arena_begin
var g_fna_pos: i64 = 0;  // the next word fn_arena_take_* reads
var g_fna_open: i64 = 0;  // the mark of the open window (0: none)
var g_fna_windows: i64 = 0;  // windows ended
var g_fna_bytes: i64 = 0;  // bytes their ends gave back (about)
var g_fna_missed: i64 = 0;  // ends that did not get back to their mark

/// Per-function arenas are on: FID_FN_ARENA set (not "0") and the runtime
/// has allocator marks.
pub fn fn_arena_on() -> bool {
    if g_fna_state < 0 {
        g_fna_state = 0;
        var v: str = env_or_empty("FID_FN_ARENA");
        if str_len(v) > 0 && v != "0" && p_arena_save() != 0 {
            g_fna_state = 1;
        }
    }
    return g_fna_state == 1;
}

/// Open a window: its mark, or 0 when none opens (arenas off, a window or
/// a region already open). Empties the hold block.
pub fn fn_arena_begin() -> i64 {
    if g_fna_open != 0 || !fn_arena_on() {
        return 0;
    }
    if p_region_word(0, 0) != 0 {
        return 0;
    }
    if g_fna_hold == 0 {
        fna_hold_grow(FNA_HOLD_MIN);
    }
    g_fna_len = 0;
    g_fna_pos = 0;
    var m: i64 = p_arena_save();
    g_fna_open = m;
    return m;
}

/// Close the window `mark` (fn_arena_begin's): everything allocated in it
/// from the arena goes back at once. The kept values stay in the hold
/// block for fn_arena_take_*. Does nothing for 0.
pub fn fn_arena_end(mark: i64) {
    if mark == 0 || mark != g_fna_open {
        return;
    }
    var now: i64 = p_arena_save();
    g_fna_bytes = g_fna_bytes + fna_distance(mark, now);
    p_arena_restore(mark);
    g_fna_open = 0;
    g_fna_windows = g_fna_windows + 1;
    if p_arena_save() != mark {
        g_fna_missed = g_fna_missed + 1;
    }
}

/// Bytes from arena position `a` to `b` (marks: chunk number << 32 | offset).
fn fna_distance(a: i64, b: i64) -> i64 {
    var ca: i64 = a / 4294967296;
    var cb: i64 = b / 4294967296;
    var d: i64 = (cb - ca) * FNA_CHUNK + (b - cb * 4294967296) - (a - ca * 4294967296);
    if d < 0 {
        return 0;
    }
    return d;
}

/// Room for `need` words in the hold block. A new block is over 1 MB, so
/// the C runtime takes it from calloc (never from an arena chunk), inside
/// a window or not.
fn fna_hold_grow(need: i64) {
    var cap: i64 = g_fna_cap * 2;
    if cap < FNA_HOLD_MIN {
        cap = FNA_HOLD_MIN;
    }
    while cap < need {
        cap = cap * 2;
    }
    var nb: i64 = p_malloc(cap * 8);
    if g_fna_hold != 0 {
        p_mem_copy(nb, g_fna_hold, g_fna_len * 8);
        p_free(g_fna_hold);
    }
    g_fna_hold = nb;
    g_fna_cap = cap;
}

fn fna_put(w: i64) {
    if g_fna_len >= g_fna_cap {
        fna_hold_grow(g_fna_len + 1);
    }
    var p: *mut i64 = g_fna_hold + g_fna_len * 8;
    // SAFETY: g_fna_len < g_fna_cap: a word of the hold block, which holds
    // g_fna_cap words.
    unsafe {
        *p = w;
    }
    g_fna_len = g_fna_len + 1;
}

fn fna_get() -> i64 {
    var w: i64 = 0;
    if g_fna_pos < g_fna_len {
        var p: *mut i64 = g_fna_hold + g_fna_pos * 8;
        // SAFETY: g_fna_pos < g_fna_len <= g_fna_cap: a word of the hold
        // block that fna_put wrote.
        unsafe {
            w = *p;
        }
    }
    g_fna_pos = g_fna_pos + 1;
    return w;
}

/// Keep one word past the window's end.
pub fn fn_arena_keep_word(w: i64) {
    fna_put(w);
}

/// Keep a copy of `v`'s elements past the window's end.
pub fn fn_arena_keep_words(v: Vec<i64>) {
    var n: i64 = v.len();
    if g_fna_len + n + 1 > g_fna_cap {
        fna_hold_grow(g_fna_len + n + 1);
    }
    fna_put(n);
    var i: i64 = 0;
    while i < n {
        fna_put(v.get(i));
        i = i + 1;
    }
}

/// Keep a copy of `s`'s bytes past the window's end.
pub fn fn_arena_keep_str(s: str) {
    var n: i64 = str_len(s);
    var nw: i64 = (n + 7) / 8;
    if g_fna_len + nw + 1 > g_fna_cap {
        fna_hold_grow(g_fna_len + nw + 1);
    }
    fna_put(n);
    if n > 0 {
        p_mem_copy(g_fna_hold + g_fna_len * 8, s as i64, n);
    }
    g_fna_len = g_fna_len + nw;
}

/// The next kept word (0 past the last).
pub fn fn_arena_take_word() -> i64 {
    return fna_get();
}

/// The next kept Vec<i64>, made outside the window.
pub fn fn_arena_take_words() -> Vec<i64> {
    var n: i64 = fna_get();
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        v.push(fna_get());
        i = i + 1;
    }
    return v;
}

/// The next kept string, made outside the window ("" past the last).
pub fn fn_arena_take_str() -> str {
    var n: i64 = fna_get();
    var nw: i64 = (n + 7) / 8;
    if n <= 0 || g_fna_pos + nw > g_fna_len {
        return "";
    }
    var r: i64 = p_str_buf(n);
    p_mem_copy(r, g_fna_hold + g_fna_pos * 8, n);
    g_fna_pos = g_fna_pos + nw;
    return r as str;
}

/// Windows ended so far, bytes their ends gave back, and ends that did
/// not find the arena back at their mark (0 when every window was sound).
pub fn fn_arena_windows() -> i64 {
    return g_fna_windows;
}

pub fn fn_arena_released() -> i64 {
    return g_fna_bytes;
}

pub fn fn_arena_missed() -> i64 {
    return g_fna_missed;
}

/// One line for --time: "" when no window was used.
pub fn fn_arena_report() -> str {
    if g_fna_windows == 0 {
        return "";
    }
    return "fn arenas: " + int_to_str(g_fna_windows) + " windows, " + int_to_str(g_fna_bytes / 1048576) + " MB given back at their ends, " + int_to_str(g_fna_missed) + " not back at their mark";
}

/// Give the hold block back (at exit, for --leaks builds of the compiler).
pub fn fn_arena_close() {
    if g_fna_hold != 0 && g_fna_open == 0 {
        p_free(g_fna_hold);
        g_fna_hold = 0;
        g_fna_cap = 0;
        g_fna_len = 0;
        g_fna_pos = 0;
    }
}
