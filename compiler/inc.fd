// inc.fd -- Incremental compilation cache (ported from src/inc.rs)
//
// Caches the optimized IrModule in memory, keyed by source file path
// and a hash of the source content. On a cache hit, parsing, typechecking,
// IR lowering, and optimization are all skipped -- the cached IrModule is
// reused directly for C code generation.
//
// This is an in-memory cache (no disk persistence) so it only helps within
// a single long-lived process (e.g. the test harness when compiling many
// files in one process). A future extension could serialize the IrModule
// to disk for cross-process caching.
//
// Adaptations from Rust:
// 1. HashMap<K,V> -> Fides HashMap (i64 handle)
// 2. Mutex -> not needed (Fides is single-threaded for now)
// 3. OnceLock -> module-level var
// 4. L2Module -> IrModule (our ccompile pipeline uses IR, not L2)
// 5. u64 -> i64 (Fides uses i64 for all integers)

module compiler::inc;

use core;
use vec;
use string;
use compiler::ir;

// --- FNV-1a 64-bit hash --------------------------------------------------

/// Compute a hash of the source content (FNV-1a 64-bit).
@wrapping
pub fn hash_source(source: str) -> i64 {
    var hash: i64 = 8834263827529598795; // 0xcbf29ce484222325 as signed
    var i: i64 = 0;
    var len: i64 = str_len(source);
    while i < len {
        hash = hash ^ (str_byte_at(source, i) & 0xFF);
        // hash * 0x100000001b3 -- use multiplication with wrapping semantics
        // 0x100000001b3 = 1099511628211
        // In i64 arithmetic, wrapping_mul is just multiplication (wraps on overflow)
        hash = hash * 1099511628211;
        i = i + 1;
    }
    return hash;
}

/// Simple hash function for strings (FNV-1a 64-bit). Alias for hash_source.
pub fn hash_str(s: str) -> i64 {
    return hash_source(s);
}

// --- Build inputs and on-disk stamps (as src/inc.rs) ---------------------
// A build records every file it reads (the program and each imported
// module) and every import candidate it found missing (creating that file
// would change what the import resolves to). `<output>.fides-stamp` keeps
// them with a key (compiler identity, command line, CC, FID_HOME) and a hash
// of the output: a later build whose inputs are all unchanged and whose
// output still holds those bytes is up to date; a build that produces the
// same C as the last one skips the C compiler. The
// in-memory cache above checks the same inputs before reusing a module.

var g_dep_files: Vec<str> = Vec::new();
var g_dep_hashes: Vec<i64> = Vec::new();
var g_dep_absent: Vec<str> = Vec::new();
var g_deps_init: bool = false;

fn inc_deps_ensure() {
    if !g_deps_init {
        var files: Vec<str> = Vec::new();
        var hashes: Vec<i64> = Vec::new();
        var absent: Vec<str> = Vec::new();
        g_dep_files = files;
        g_dep_hashes = hashes;
        g_dep_absent = absent;
        g_deps_init = true;
    }
}

/// Start recording the inputs of a new build.
pub fn inc_deps_reset() {
    g_deps_init = false;
    inc_deps_ensure();
}

fn inc_str_vec_has(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

/// Record that the build read the file at `path`.
pub fn inc_record_file(path: str) {
    inc_deps_ensure();
    if inc_str_vec_has(g_dep_files, path) { return; }
    g_dep_files.push(path);
    g_dep_hashes.push(p_file_hash(path));
}

/// Record that the build looked for `path` and found nothing there.
pub fn inc_record_absent(path: str) {
    inc_deps_ensure();
    if inc_str_vec_has(g_dep_absent, path) { return; }
    g_dep_absent.push(path);
}

/// Every file still has its recorded hash and every missing path is
/// still missing.
pub fn inc_deps_unchanged(files: Vec<str>, hashes: Vec<i64>, absent: Vec<str>) -> bool {
    var i: i64 = 0;
    while i < files.len() {
        if p_file_hash(files.get(i)) != hashes.get(i) { return false; }
        i = i + 1;
    }
    i = 0;
    while i < absent.len() {
        if p_file_exists(absent.get(i)) != 0 { return false; }
        i = i + 1;
    }
    return true;
}

/// A recorded build: what it read, under which key, and its C's hash.
pub struct IncStamp {
    pub ok: bool,
    pub key: i64,
    pub has_c: bool,
    pub c_hash: i64,
    pub has_out: bool,
    pub out_hash: i64,
    pub files: Vec<str>,
    pub hashes: Vec<i64>,
    pub absent: Vec<str>,
}

fn IncStamp_none() -> IncStamp {
    var files: Vec<str> = Vec::new();
    var hashes: Vec<i64> = Vec::new();
    var absent: Vec<str> = Vec::new();
    return IncStamp { ok: false, key: 0, has_c: false, c_hash: 0, has_out: false, out_hash: 0, files: files, hashes: hashes, absent: absent };
}

/// An environment variable's value, "" when it is not set (p_getenv
/// returns null then, which crashes string concatenation and str_len).
pub fn env_or_empty(name: str) -> str {
    var value = p_getenv(name);
    if value == 0 {
        return "";
    }
    return value;
}

/// Hash of this compiler's executable: at argv[0], or (started by name) in
/// the PATH entry that holds it. A rebuilt compiler must invalidate stamps.
fn inc_self_hash() -> i64 {
    var exe: str = p_argv(0);
    var h: i64 = p_file_hash(exe);
    if h == 0 { h = p_file_hash(exe + ".exe"); }
    if h != 0 { return h; }
    var path: str = env_or_empty("PATH");
    var sep: str = ":";
    if str_contains(path, ";") { sep = ";"; }
    var dirs: Vec<str> = str_split(path, sep);
    var i: i64 = 0;
    while i < dirs.len() {
        var d: str = dirs.get(i) + "/" + exe;
        h = p_file_hash(d);
        if h == 0 { h = p_file_hash(d + ".exe"); }
        if h != 0 { return h; }
        i = i + 1;
    }
    return 0;
}

/// The key of a build: compiler identity, command, arguments, CC,
/// FIDES_CC_OPT and FID_HOME (which stdlib imports resolve to).
pub fn inc_build_key(command: str, n: i64, start: i64) -> i64 {
    var k: str = int_to_str(inc_self_hash()) + " " + command;
    var i: i64 = start + 1;
    while i < n {
        var a: str = p_argv(i);
        if a != "--no-cache" { k = k + " " + a; }
        i = i + 1;
    }
    k = k + " CC=" + env_or_empty("CC") + " FIDES_CC_OPT=" + env_or_empty("FIDES_CC_OPT");
    k = k + " FID_HOME=" + env_or_empty("FID_HOME");
    return hash_source(k);
}

/// Read `<output>.fides-stamp` (ok = false when missing or unreadable).
pub fn inc_stamp_read(path: str) -> IncStamp {
    var st: IncStamp = IncStamp_none();
    if p_file_exists(path) == 0 { return st; }
    var text: str = p_file_read(path);
    var lines: Vec<str> = str_split(text, "\n");
    if lines.len() == 0 { return st; }
    if lines.get(0) != "fides-stamp-fd 2" { return st; }
    var has_key: bool = false;
    var i: i64 = 1;
    while i < lines.len() {
        var line: str = lines.get(i);
        if str_starts_with(line, "key ") {
            st.key = str_parse_int(str_slice(line, 4, str_len(line)));
            has_key = true;
        } else if str_starts_with(line, "c ") {
            st.c_hash = str_parse_int(str_slice(line, 2, str_len(line)));
            st.has_c = true;
        } else if str_starts_with(line, "out ") {
            st.out_hash = str_parse_int(str_slice(line, 4, str_len(line)));
            st.has_out = true;
        } else if str_starts_with(line, "file ") {
            var rest: str = str_slice(line, 5, str_len(line));
            var sp: i64 = str_find(rest, " ");
            if sp < 0 { return IncStamp_none(); }
            st.hashes.push(str_parse_int(str_slice(rest, 0, sp)));
            st.files.push(str_slice(rest, sp + 1, str_len(rest)));
        } else if str_starts_with(line, "absent ") {
            st.absent.push(str_slice(line, 7, str_len(line)));
        } else if str_len(line) > 0 {
            return IncStamp_none();
        }
        i = i + 1;
    }
    st.ok = has_key;
    return st;
}

/// `output` still holds the bytes the recorded build wrote: anything else
/// writing that path (another compiler, another command) is not this build.
fn inc_output_intact(st: IncStamp, output: str) -> bool {
    return st.has_out && p_file_exists(output) != 0 && p_file_hash(output) == st.out_hash;
}

/// Nothing changed since the build that wrote `output`.
pub fn inc_up_to_date(st: IncStamp, key: i64, output: str) -> bool {
    if !st.ok || st.key != key || st.files.len() == 0 { return false; }
    if !inc_output_intact(st, output) { return false; }
    return inc_deps_unchanged(st.files, st.hashes, st.absent);
}

/// The previous build produced `output` from exactly this C code.
pub fn inc_c_unchanged(st: IncStamp, key: i64, output: str, c_hash: i64) -> bool {
    if !st.ok || st.key != key || !st.has_c { return false; }
    return st.c_hash == c_hash && inc_output_intact(st, output);
}

/// Record a successful build. Nothing is written unless the build recorded
/// `main_input`: a pipeline that does not record its inputs must never be
/// reported up to date.
pub fn inc_stamp_commit(path: str, key: i64, c_hash: i64, main_input: str, output: str) {
    inc_deps_ensure();
    if !inc_str_vec_has(g_dep_files, main_input) {
        p_file_delete(path);
        return;
    }
    var s: str = "fides-stamp-fd 2\nkey " + int_to_str(key) + "\nc " + int_to_str(c_hash) + "\n";
    s = s + "out " + int_to_str(p_file_hash(output)) + "\n";
    var i: i64 = 0;
    while i < g_dep_files.len() {
        s = s + "file " + int_to_str(g_dep_hashes.get(i)) + " " + g_dep_files.get(i) + "\n";
        i = i + 1;
    }
    i = 0;
    while i < g_dep_absent.len() {
        s = s + "absent " + g_dep_absent.get(i) + "\n";
        i = i + 1;
    }
    p_file_write(path, s);
}

/// Snapshot of the recorded inputs (for the in-memory cache).
pub fn inc_deps_files() -> Vec<str> { inc_deps_ensure(); return g_dep_files; }
pub fn inc_deps_hashes() -> Vec<i64> { inc_deps_ensure(); return g_dep_hashes; }
pub fn inc_deps_absent() -> Vec<str> { inc_deps_ensure(); return g_dep_absent; }

// --- Cache entry ---------------------------------------------------------

pub struct IncCacheEntry {
    pub path: str,
    pub hash: i64,
    pub module: IrModule,
    // The build's inputs: the entry is valid only while they are unchanged
    // (keying on the main file alone reused a module after an import changed).
    pub dep_files: Vec<str>,
    pub dep_hashes: Vec<i64>,
    pub dep_absent: Vec<str>,
}

// --- Incremental cache --------------------------------------------------

/// Incremental compilation cache. Stores optimized IrModules keyed by
/// (source_path, source_hash). In-memory only.
pub struct IncrementalCache {
    pub entries: Vec<IncCacheEntry>,
}

pub fn IncrementalCache_new() -> IncrementalCache {
    return IncrementalCache {
        entries: Vec::new(),
    };
}

/// Look up a cached IrModule by source path + hash.
/// Returns OptIrModule::Some(module) on hit, OptIrModule::None on miss.
pub fn IncrementalCache_get(self: &IncrementalCache, source_path: str, source_hash: i64) -> OptIrModule {
    var i: i64 = 0;
    while i < self.entries.len() {
        var entry: IncCacheEntry = self.entries.get(i);
        if entry.path == source_path && entry.hash == source_hash
            && inc_deps_unchanged(entry.dep_files, entry.dep_hashes, entry.dep_absent) {
            return OptIrModule::Some(entry.module);
        }
        i = i + 1;
    }
    return OptIrModule::None;
}

/// Store an IrModule in the cache. If an entry with the same path exists,
/// it is replaced.
pub fn IncrementalCache_store(self: &mut IncrementalCache, source_path: str, source_hash: i64, module: IrModule) {
    var i: i64 = 0;
    while i < self.entries.len() {
        if self.entries.get(i).path == source_path {
            self.entries.set(i, IncCacheEntry {
                path: source_path,
                hash: source_hash,
                module: module,
                dep_files: inc_deps_files(),
                dep_hashes: inc_deps_hashes(),
                dep_absent: inc_deps_absent(),
            });
            return;
        }
        i = i + 1;
    }
    self.entries.push(IncCacheEntry {
        path: source_path,
        hash: source_hash,
        module: module,
        dep_files: inc_deps_files(),
        dep_hashes: inc_deps_hashes(),
        dep_absent: inc_deps_absent(),
    });
}

/// Clear all cached entries.
pub fn IncrementalCache_clear(self: &mut IncrementalCache) {
    // Pop all entries (Fides Vec::new() is untyped, so we can't reassign)
    while self.entries.len() > 0 {
        self.entries.pop();
    }
}

/// Number of cached entries.
pub fn IncrementalCache_len(self: &IncrementalCache) -> i64 {
    return self.entries.len();
}

/// Whether the cache is empty.
pub fn IncrementalCache_is_empty(self: &IncrementalCache) -> bool {
    return self.entries.len() == 0;
}

// --- Global cache (module-level var) -------------------------------------
// Fides now supports module-level `var`/`pub var`, so the global cache
// uses a module-level mutable variable to persist across calls within
// a single process. This enables incremental compilation -- on a cache
// hit, parsing, typechecking, and IR lowering are all skipped.
//
// NOTE: The C backend emits struct-typed globals as zero-initialized
// pointers (it can't call IncrementalCache_new() in a static initializer).
// So we use lazy initialization: on first access, if the cache is empty,
// we initialize it. This matches the Rust compiler's OnceLock approach.

pub var g_cache: IncrementalCache = IncrementalCache_new();
var g_cache_init: bool = false;

/// Ensure the global cache is initialized (lazy init for C backend).
fn ensure_cache_init() -> void {
    if !g_cache_init {
        g_cache = IncrementalCache_new();
        g_cache_init = true;
    }
}

/// Store an IrModule in the global cache.
pub fn global_cache_store(source_path: str, source_hash: i64, module: IrModule) {
    ensure_cache_init();
    IncrementalCache_store(&mut g_cache, source_path, source_hash, module);
}

/// Look up a cached IrModule by source path + hash.
/// Returns OptIrModule::Some(module) on hit, OptIrModule::None on miss.
pub fn global_cache_get(source_path: str, source_hash: i64) -> OptIrModule {
    ensure_cache_init();
    return IncrementalCache_get(&g_cache, source_path, source_hash);
}

/// Clear the global cache.
pub fn global_cache_clear() {
    ensure_cache_init();
    IncrementalCache_clear(&mut g_cache);
}

// --- Canonical C and the artifact store (as src/inc.rs) ------------------
// The stamp keys a build on its inputs. The artifact store keys a built
// binary on what the program compiles to: a hash of the generated C with
// comments and whitespace gone, the functions it defines alpha-renamed
// positionally (except `main`) and unreferenced ones dropped. Every other
// identifier stays: an external C function names what the program does.
// `// PLINK:` lines stay too: they choose what is linked.

/// Tokens of a C source: spans, and whether each is an identifier.
pub struct CTokens {
    pub is_ident: Vec<i64>,
    pub starts: Vec<i64>,
    pub ends: Vec<i64>,
}

fn c_is_ident_start(c: i64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
}

fn c_is_digit(c: i64) -> bool {
    return c >= 48 && c <= 57;
}

fn c_push_tok(t: &mut CTokens, ident: i64, start: i64, end: i64) {
    t.is_ident.push(ident);
    t.starts.push(start);
    t.ends.push(end);
}

pub fn inc_lex_c(src: str) -> CTokens {
    var t: CTokens = CTokens { is_ident: Vec::new(), starts: Vec::new(), ends: Vec::new() };
    var n: i64 = str_len(src);
    var i: i64 = 0;
    var at_line_start: bool = true;
    while i < n {
        var c: i64 = str_byte_at(src, i);
        if c == 10 || c == 13 || c == 32 || c == 9 || c == 11 || c == 12 {
            at_line_start = c == 10;
            i = i + 1;
        } else if c == 47 && i + 1 < n && str_byte_at(src, i + 1) == 47 {
            var cs: i64 = i;
            while i < n && str_byte_at(src, i) != 10 { i = i + 1; }
            if i - cs >= 9 && str_starts_with(str_slice_len(src, n, cs, cs + 9), "// PLINK:") {
                c_push_tok(&mut t, 0, cs, i);
            }
        } else if c == 47 && i + 1 < n && str_byte_at(src, i + 1) == 42 {
            i = i + 2;
            while i + 1 < n && !(str_byte_at(src, i) == 42 && str_byte_at(src, i + 1) == 47) { i = i + 1; }
            i = i + 2;
            if i > n { i = n; }
        } else if c == 35 && at_line_start {
            var ps: i64 = i;
            while i < n && str_byte_at(src, i) != 10 { i = i + 1; }
            // A line ending in '\' continues the directive.
            while i < n && str_byte_at(src, i - 1) == 92 {
                i = i + 1;
                while i < n && str_byte_at(src, i) != 10 { i = i + 1; }
            }
            c_push_tok(&mut t, 0, ps, i);
        } else if c_is_ident_start(c) {
            at_line_start = false;
            var ids: i64 = i;
            while i < n && (c_is_ident_start(str_byte_at(src, i)) || c_is_digit(str_byte_at(src, i))) { i = i + 1; }
            c_push_tok(&mut t, 1, ids, i);
        } else if c == 34 || c == 39 {
            at_line_start = false;
            var qs: i64 = i;
            i = i + 1;
            while i < n && str_byte_at(src, i) != c {
                if str_byte_at(src, i) == 92 { i = i + 1; }
                i = i + 1;
            }
            i = i + 1;
            if i > n { i = n; }
            c_push_tok(&mut t, 0, qs, i);
        } else if c_is_digit(c) {
            at_line_start = false;
            var ds: i64 = i;
            while i < n {
                var d: i64 = str_byte_at(src, i);
                if !(c_is_ident_start(d) || c_is_digit(d) || d == 46) { break; }
                i = i + 1;
            }
            c_push_tok(&mut t, 0, ds, i);
        } else {
            at_line_start = false;
            c_push_tok(&mut t, 0, i, i + 1);
            i = i + 1;
        }
    }
    return t;
}

/// The one-character token `c`?
fn c_tok_is(src: str, t: &CTokens, i: i64, c: i64) -> bool {
    return t.is_ident.get(i) == 0 && t.ends.get(i) - t.starts.get(i) == 1 && str_byte_at(src, t.starts.get(i)) == c;
}

/// Top-level function definitions: `... name ( ... ) { ... }` at depth 0.
pub struct CDefs {
    pub names: Vec<str>,
    pub name_toks: Vec<i64>,
    pub start_toks: Vec<i64>,
    pub end_toks: Vec<i64>,
}

pub fn inc_find_c_defs(src: str, t: &CTokens) -> CDefs {
    var defs: CDefs = CDefs { names: Vec::new(), name_toks: Vec::new(), start_toks: Vec::new(), end_toks: Vec::new() };
    var n: i64 = t.starts.len();
    var slen: i64 = str_len(src);
    var depth: i64 = 0;
    var stmt_start: i64 = 0;
    var j: i64 = 0;
    while j < n {
        var is_def: bool = false;
        if c_tok_is(src, t, j, 123) {
            depth = depth + 1;
        } else if c_tok_is(src, t, j, 125) {
            depth = depth - 1;
            if depth == 0 { stmt_start = j + 1; }
        } else if c_tok_is(src, t, j, 59) && depth == 0 {
            stmt_start = j + 1;
        }
        if depth == 0 && t.is_ident.get(j) == 1 && j + 1 < n && c_tok_is(src, t, j + 1, 40) {
            var d: i64 = 0;
            var k: i64 = j + 1;
            while k < n {
                if c_tok_is(src, t, k, 40) { d = d + 1; }
                if c_tok_is(src, t, k, 41) { d = d - 1; }
                if d == 0 { break; }
                k = k + 1;
            }
            if k + 1 < n && c_tok_is(src, t, k + 1, 123) {
                var d2: i64 = 0;
                var m: i64 = k + 1;
                while m < n {
                    if c_tok_is(src, t, m, 123) { d2 = d2 + 1; }
                    if c_tok_is(src, t, m, 125) { d2 = d2 - 1; }
                    if d2 == 0 { break; }
                    m = m + 1;
                }
                var e: i64 = m + 1;
                if e > n { e = n; }
                defs.names.push(str_slice_len(src, slen, t.starts.get(j), t.ends.get(j)));
                defs.name_toks.push(j);
                defs.start_toks.push(stmt_start);
                defs.end_toks.push(e);
                j = m + 1;
                stmt_start = j;
                is_def = true;
            }
        }
        if !is_def { j = j + 1; }
    }
    return defs;
}

@wrapping
fn inc_mix(h: i64, src: str, start: i64, end: i64) -> i64 {
    var i: i64 = start;
    var r: i64 = h;
    while i < end {
        r = (r ^ (str_byte_at(src, i) & 0xFF)) * 1099511628211;
        i = i + 1;
    }
    return r;
}

/// Hash of the canonical form of generated C.
/// Mark definition `d` live, with every other definition of its name.
fn inc_mark_def(d: i64, live: Vec<i64>, work: Vec<i64>, same_prev: Vec<i64>) {
    var k: i64 = d;
    while k >= 0 {
        if live.get(k) == 0 {
            live.set(k, 1);
            work.push(k);
        }
        k = same_prev.get(k);
    }
}

pub fn inc_canon_hash(src: str) -> i64 {
    var t: CTokens = inc_lex_c(src);
    var defs: CDefs = inc_find_c_defs(src, &t);
    var n: i64 = t.starts.len();
    var slen: i64 = str_len(src);
    var in_body: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        in_body.push(-1);
        i = i + 1;
    }
    var def_index: i64 = HashMap_new();
    // A name defined more than once (one definition per #if branch): each
    // definition points at the previous one, and all are live together
    var same_prev: Vec<i64> = Vec::new();
    var di: i64 = 0;
    while di < defs.names.len() {
        same_prev.push(HashMap_get(def_index, defs.names.get(di)) - 1);
        HashMap_insert(def_index, defs.names.get(di), di + 1);
        var k: i64 = defs.start_toks.get(di);
        while k < defs.end_toks.get(di) {
            in_body.set(k, di);
            k = k + 1;
        }
        di = di + 1;
    }
    // Liveness: roots are `main` and every identifier outside a definition
    var live: Vec<i64> = Vec::new();
    di = 0;
    while di < defs.names.len() {
        live.push(0);
        di = di + 1;
    }
    var work: Vec<i64> = Vec::new();
    var main_slot: i64 = HashMap_get(def_index, "main");
    if main_slot != 0 {
        inc_mark_def(main_slot - 1, live, work, same_prev);
    }
    i = 0;
    while i < n {
        if t.is_ident.get(i) == 1 && in_body.get(i) < 0 {
            var slot: i64 = HashMap_get(def_index, str_slice_len(src, slen, t.starts.get(i), t.ends.get(i)));
            if slot != 0 {
                inc_mark_def(slot - 1, live, work, same_prev);
            }
        }
        i = i + 1;
    }
    while work.len() > 0 {
        var d: i64 = work.pop();
        var k: i64 = defs.name_toks.get(d) + 1;
        while k < defs.end_toks.get(d) {
            if t.is_ident.get(k) == 1 {
                var s2: i64 = HashMap_get(def_index, str_slice_len(src, slen, t.starts.get(k), t.ends.get(k)));
                if s2 != 0 {
                    inc_mark_def(s2 - 1, live, work, same_prev);
                }
            }
            k = k + 1;
        }
    }
    // Alpha-rename defined functions positionally; hash the kept tokens.
    var numbers: i64 = HashMap_new();
    var next: i64 = 1;
    var h: i64 = 8834263827529598795;
    i = 0;
    while i < n {
        var owner: i64 = in_body.get(i);
        if owner < 0 || live.get(owner) != 0 {
            var s: i64 = t.starts.get(i);
            var e: i64 = t.ends.get(i);
            var renamed: i64 = 0;
            if t.is_ident.get(i) == 1 {
                var name: str = str_slice_len(src, slen, s, e);
                if name != "main" && HashMap_get(def_index, name) != 0 {
                    renamed = HashMap_get(numbers, name);
                    if renamed == 0 {
                        renamed = next;
                        next = next + 1;
                        HashMap_insert(numbers, name, renamed);
                    }
                }
            }
            if renamed != 0 {
                var tag: str = "@" + int_to_str(renamed);
                h = inc_mix(h, tag, 0, str_len(tag));
            } else {
                h = inc_mix(h, src, s, e);
            }
            h = inc_mix(h, " ", 0, 1);
        }
        i = i + 1;
    }
    return h;
}

/// Byte spans of top-level function definitions: names, start, the `{`, end.
pub struct CDefSpans {
    pub names: Vec<str>,
    pub starts: Vec<i64>,
    pub braces: Vec<i64>,
    pub ends: Vec<i64>,
}

pub fn inc_c_fn_defs(src: str) -> CDefSpans {
    var t: CTokens = inc_lex_c(src);
    var defs: CDefs = inc_find_c_defs(src, &t);
    var out: CDefSpans = CDefSpans { names: Vec::new(), starts: Vec::new(), braces: Vec::new(), ends: Vec::new() };
    var i: i64 = 0;
    while i < defs.names.len() {
        var e: i64 = defs.end_toks.get(i);
        var k: i64 = defs.name_toks.get(i);
        while k < e && !c_tok_is(src, &t, k, 123) { k = k + 1; }
        out.names.push(defs.names.get(i));
        out.starts.push(t.starts.get(defs.start_toks.get(i)));
        out.braces.push(t.starts.get(k));
        out.ends.push(t.ends.get(e - 1));
        i = i + 1;
    }
    return out;
}

/// The directory holding `output`.
fn inc_dir_of(output: str) -> str {
    var i: i64 = str_len(output) - 1;
    while i >= 0 {
        var c: i64 = str_byte_at(output, i);
        if c == 47 || c == 92 { return str_slice(output, 0, i); }
        i = i - 1;
    }
    return ".";
}

/// Store path `<dir>/.fidcache/<key>.exe` of an artifact: keyed on content,
/// toolchain and flags, so any build (this output or another) reuses it.
pub fn inc_artifact_path(output: str, canon: i64, tool: str, flags: str) -> str {
    var key: i64 = hash_source("a1 " + int_to_str(canon) + " " + tool + " " + flags);
    var name: str = int_to_str(key);
    if str_starts_with(name, "-") { name = "n" + str_slice(name, 1, str_len(name)); }
    return inc_dir_of(output) + "/.fidcache/" + name + ".exe";
}

/// Copy `path` to `dest` if the artifact exists.
pub fn inc_artifact_get(path: str, dest: str) -> bool {
    if p_file_exists(path) == 0 { return false; }
    return p_file_write_vec(dest, p_file_read_bytes(path)) >= 0;
}

/// Store `source` under `path`. Best-effort: a cache failure never breaks a
/// build.
pub fn inc_artifact_put(path: str, source: str) {
    p_mkdir(inc_dir_of(path));
    var tmp: str = path + ".tmp";
    p_file_write_vec(tmp, p_file_read_bytes(source));
    p_rename(tmp, path);
}
