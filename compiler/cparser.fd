// cparser.fd -- C Header Parser for auto-generating Fides FFI bindings
// Ported from src/cparser.rs.
//
// Parses C function declarations from .h files and generates Fides
// `extern "C"` declarations. Supports basic C types, pointers, and
// function prototypes.
//
// Usage: fidesc parse-header <file.h> [-o output.fd]

module compiler::cparser;

use core;
use vec;
use string;

// --- Structs ------------------------------------------------------------

/// A C type mapped to Fides
pub enum CType {
    CI8,
    CI16,
    CI32,
    CI64,
    CU8,
    CU16,
    CU32,
    CU64,
    CF32,
    CF64,
    CBool,
    CVoid,
    CStr,
    CNamed(str),
    CRef(CType),
}

/// A function parameter
pub struct CParam {
    pub name: str,
    pub ty: CType,
}

pub fn CParam_new(name: str, ty: CType) -> CParam {
    return CParam { name: name, ty: ty };
}

/// An extern declaration
pub struct CExternDecl {
    pub abi: str,
    pub c_name: str,
    pub pledge_name: str,
    pub params: Vec<CParam>,
    pub ret_ty: CType,
    pub include: str,
    pub link_lib: str,
}

pub fn CExternDecl_new(abi: str, c_name: str, pledge_name: str, params: Vec<CParam>, ret_ty: CType, include: str, link_lib: str) -> CExternDecl {
    return CExternDecl {
        abi: abi,
        c_name: c_name,
        pledge_name: pledge_name,
        params: params,
        ret_ty: ret_ty,
        include: include,
        link_lib: link_lib,
    };
}

// --- Public API ---

/// Parse a C header file and extract function declarations.
pub fn parse_header(source: str, include: str) -> Vec<CExternDecl> {
    var decls: Vec<CExternDecl> = Vec::new();
    var seen_names: Vec<str> = Vec::new();

    // Strip comments
    var cleaned: str = strip_comments(source);

    // Tokenize into lines and look for function declarations
    var lines: Vec<str> = cp_str_lines(cleaned);
    var i: i64 = 0;
    while i < lines.len() {
        var line: str = str_trim(lines.get(i));

        // Skip preprocessor directives, empty lines, typedefs, structs, etc.
        if str_len(line) == 0 || str_starts_with(line, "#") || str_starts_with(line, "typedef")
            || str_starts_with(line, "struct") || str_starts_with(line, "enum")
            || str_starts_with(line, "union") || str_starts_with(line, "extern")
            || str_starts_with(line, "static") || str_starts_with(line, "inline")
        {
            i = i + 1;
            continue;
        }

        // Collect lines until we find a semicolon
        var full_decl: str = line;
        while !cp_str_contains(full_decl, ";") && i + 1 < lines.len() {
            i = i + 1;
            full_decl = full_decl + " " + str_trim(lines.get(i));
        }

        if cp_str_contains(full_decl, "(") && cp_str_contains(full_decl, ")") && cp_str_contains(full_decl, ";") {
            var decl_result: OptionCExternDecl = parse_c_function(full_decl, include);
            match decl_result {
                OptionCExternDecl::Some(decl) => {
                    if !seen_names_contains(seen_names, decl.c_name) {
                        seen_names.push(decl.c_name);
                        decls.push(decl);
                    }
                }
                OptionCExternDecl::None => {}
            }
        }

        i = i + 1;
    }

    return decls;
}

// --- Comment stripping ---

fn strip_comments(source: str) -> str {
    var result: str = "";
    var i: i64 = 0;
    var len: i64 = str_len(source);
    while i < len {
        var c: i64 = str_byte_at(source, i);
        if c == 47 { // '/'
            if i + 1 < len {
                var next: i64 = str_byte_at(source, i + 1);
                if next == 47 { // '//'
                    // Line comment -- skip to end of line
                    i = i + 2;
                    while i < len && str_byte_at(source, i) != 10 {
                        i = i + 1;
                    }
                    continue;
                } else if next == 42 { // '*'
                    // Block comment -- skip to */
                    i = i + 2;
                    while i + 1 < len {
                        if str_byte_at(source, i) == 42 && str_byte_at(source, i + 1) == 47 {
                            i = i + 2;
                            break;
                        }
                        i = i + 1;
                    }
                    if i + 1 >= len { i = len; }
                    continue;
                }
            }
        }
        result = result + str_from_byte(c);
        i = i + 1;
    }
    return result;
}

// --- Option type for CExternDecl ---

pub enum OptionCExternDecl { Some(CExternDecl), None }

// --- Parse a single C function declaration ---

fn parse_c_function(decl: str, include: str) -> OptionCExternDecl {
    // Trim and remove trailing semicolon
    var d: str = str_trim(decl);
    d = cp_str_trim_end_char(d, ";");
    d = str_trim(d);

    // Find the opening paren
    var paren_pos: i64 = cp_str_find_char(d, "(");
    if paren_pos < 0 { return OptionCExternDecl::None; }

    var before_paren: str = str_slice(d, 0, paren_pos);
    before_paren = str_trim(before_paren);
    var params_str: str = str_slice(d, paren_pos + 1, str_len(d));
    params_str = cp_str_trim_end_char(params_str, ")");
    params_str = str_trim(params_str);

    // The function name is the last identifier before the paren
    var name_start: i64 = str_rfind_space(before_paren);
    if name_start < 0 { return OptionCExternDecl::None; }

    var ret_type_str: str = str_trim(str_slice(before_paren, 0, name_start));
    var name: str = str_trim(str_slice(before_paren, name_start, str_len(before_paren)));

    // Skip if name is empty or starts with non-identifier
    if str_len(name) == 0 { return OptionCExternDecl::None; }
    var first: i64 = str_byte_at(name, 0);
    if !is_alpha(first) && first != 95 { return OptionCExternDecl::None; }

    // Skip common non-function patterns
    if str_equal(name, "if") || str_equal(name, "while") || str_equal(name, "for") || str_equal(name, "switch") {
        return OptionCExternDecl::None;
    }

    var ret_ty_result: OptionCType = parse_c_type(ret_type_str);
    var ret_ty: CType;
    match ret_ty_result {
        OptionCType::Some(t) => { ret_ty = t; }
        OptionCType::None => { return OptionCExternDecl::None; }
    }

    var params: Vec<CParam> = parse_c_params(params_str);

    return OptionCExternDecl::Some(CExternDecl_new(
        "C",
        name,
        name,
        params,
        ret_ty,
        include,
        ""
    ));
}

// --- Option type for CType ---

pub enum OptionCType { Some(CType), None }

// --- Parse a C type string into a Fides type ---

fn parse_c_type(c_type: str) -> OptionCType {
    var t: str = str_trim(c_type);
    // Remove qualifiers
    t = str_replace(t, "const ", "");
    t = str_replace(t, "volatile ", "");
    t = str_replace(t, "register ", "");
    t = str_trim(t);

    // Handle pointer types
    if str_ends_with(t, "*") {
        var base: str = str_trim(str_slice(t, 0, str_len(t) - 1));
        if str_equal(base, "char") || str_equal(base, "void") {
            return OptionCType::Some(CType::CStr);
        }
        var inner_result: OptionCType = parse_c_type(base);
        match inner_result {
            OptionCType::Some(inner) => {
                return OptionCType::Some(CType::CRef(inner));
            }
            OptionCType::None => { return OptionCType::None; }
        }
    }

    // Map C types to Fides types
    if str_equal(t, "int") || str_equal(t, "signed int") || str_equal(t, "signed") {
        return OptionCType::Some(CType::CI32);
    }
    if str_equal(t, "long") || str_equal(t, "signed long") || str_equal(t, "long int") {
        return OptionCType::Some(CType::CI64);
    }
    if str_equal(t, "long long") || str_equal(t, "long long int") || str_equal(t, "signed long long") {
        return OptionCType::Some(CType::CI64);
    }
    if str_equal(t, "short") || str_equal(t, "short int") || str_equal(t, "signed short") {
        return OptionCType::Some(CType::CI16);
    }
    if str_equal(t, "char") || str_equal(t, "signed char") {
        return OptionCType::Some(CType::CI8);
    }
    if str_equal(t, "unsigned") || str_equal(t, "unsigned int") {
        return OptionCType::Some(CType::CU32);
    }
    if str_equal(t, "unsigned long") || str_equal(t, "unsigned long int") {
        return OptionCType::Some(CType::CU64);
    }
    if str_equal(t, "unsigned long long") || str_equal(t, "unsigned long long int") {
        return OptionCType::Some(CType::CU64);
    }
    if str_equal(t, "unsigned short") || str_equal(t, "unsigned short int") {
        return OptionCType::Some(CType::CU16);
    }
    if str_equal(t, "unsigned char") {
        return OptionCType::Some(CType::CU8);
    }
    if str_equal(t, "float") { return OptionCType::Some(CType::CF32); }
    if str_equal(t, "double") { return OptionCType::Some(CType::CF64); }
    if str_equal(t, "long double") { return OptionCType::Some(CType::CF64); }
    if str_equal(t, "void") { return OptionCType::Some(CType::CVoid); }
    if str_equal(t, "size_t") { return OptionCType::Some(CType::CU64); }
    if str_equal(t, "ssize_t") { return OptionCType::Some(CType::CI64); }
    if str_equal(t, "int8_t") { return OptionCType::Some(CType::CI8); }
    if str_equal(t, "int16_t") { return OptionCType::Some(CType::CI16); }
    if str_equal(t, "int32_t") { return OptionCType::Some(CType::CI32); }
    if str_equal(t, "int64_t") { return OptionCType::Some(CType::CI64); }
    if str_equal(t, "uint8_t") { return OptionCType::Some(CType::CU8); }
    if str_equal(t, "uint16_t") { return OptionCType::Some(CType::CU16); }
    if str_equal(t, "uint32_t") { return OptionCType::Some(CType::CU32); }
    if str_equal(t, "uint64_t") { return OptionCType::Some(CType::CU64); }

    // Unknown type -- map to opaque named type
    return OptionCType::Some(CType::CNamed(t));
}

// --- Parse C function parameters ---

fn parse_c_params(params_str: str) -> Vec<CParam> {
    var params: Vec<CParam> = Vec::new();
    var trimmed: str = str_trim(params_str);
    if str_len(trimmed) == 0 || str_equal(trimmed, "void") {
        return params;
    }

    // Split by comma, handling nested parens
    var depth: i64 = 0;
    var current: str = "";
    var i: i64 = 0;
    while i < str_len(params_str) {
        var c: i64 = str_byte_at(params_str, i);
        if c == 40 { // '('
            depth = depth + 1;
            current = current + str_from_byte(c);
        } else if c == 41 { // ')'
            depth = depth - 1;
            current = current + str_from_byte(c);
        } else if c == 44 && depth == 0 { // ','
            var p_result: OptionParam = parse_c_param(current);
            match p_result {
                OptionParam::Some(p) => { params.push(p); }
                OptionParam::None => {}
            }
            current = "";
        } else {
            current = current + str_from_byte(c);
        }
        i = i + 1;
    }

    if str_len(str_trim(current)) > 0 {
        var p_result: OptionParam = parse_c_param(current);
        match p_result {
            OptionParam::Some(p) => { params.push(p); }
            OptionParam::None => {}
        }
    }

    return params;
}

// --- Option type for CParam ---

pub enum OptionParam { Some(CParam), None }

// --- Parse a single C parameter ---

fn parse_c_param(param: str) -> OptionParam {
    var p: str = str_trim(param);
    // Remove qualifiers
    p = str_replace(p, "const ", "");
    p = str_replace(p, "restrict", "");
    p = str_trim(p);

    // Handle pointer types -- name is after the last *
    if cp_str_contains(p, "*") {
        // Find the last *
        var star_pos: i64 = cp_str_rfind_char(p, "*");
        var base_type: str = str_trim(str_slice(p, 0, star_pos));
        var name: str = str_trim(str_slice(p, star_pos + 1, str_len(p)));
        var ty: CType;
        if str_equal(base_type, "char") {
            ty = CType::CStr;
        } else {
            var inner_result: OptionCType = parse_c_type(base_type);
            match inner_result {
                OptionCType::Some(inner) => { ty = CType::CRef(inner); }
                OptionCType::None => { return OptionParam::None; }
            }
        }
        var pname: str = name;
        if str_len(pname) == 0 { pname = "arg0"; }
        return OptionParam::Some(CParam_new(pname, ty));
    }

    // Non-pointer: split type and name
    var last_space: i64 = str_rfind_space(p);
    if last_space < 0 { return OptionParam::None; }
    var type_str: str = str_trim(str_slice(p, 0, last_space));
    var name: str = str_trim(str_slice(p, last_space, str_len(p)));

    var ty_result: OptionCType = parse_c_type(type_str);
    match ty_result {
        OptionCType::Some(ty) => {
            var pname: str = name;
            if str_len(pname) == 0 { pname = "arg"; }
            return OptionParam::Some(CParam_new(pname, ty));
        }
        OptionCType::None => { return OptionParam::None; }
    }
}

// --- Generate Fides source code from extern declarations ---

pub fn generate_pledge_bindings(decls: Vec<CExternDecl>, include: str) -> str {
    var out: str = "// Auto-generated Fides FFI bindings from C header\n";
    out = out + "extern \"C\" include \"" + include + "\" {\n";

    var i: i64 = 0;
    while i < decls.len() {
        var decl: CExternDecl = decls.get(i);
        var ret: str = type_to_pledge(decl.ret_ty);
        var params_str: str = "";
        var j: i64 = 0;
        while j < decl.params.len() {
            var p: CParam = decl.params.get(j);
            if j > 0 { params_str = params_str + ", "; }
            params_str = params_str + p.name + ": " + type_to_pledge(p.ty);
            j = j + 1;
        }
        out = out + "    fn " + decl.c_name + "(" + params_str + ") -> " + ret + ";\n";
        i = i + 1;
    }
    out = out + "}\n";
    return out;
}

fn type_to_pledge(ty: CType) -> str {
    match ty {
        CType::CI8 => { return "i8"; }
        CType::CI16 => { return "i16"; }
        CType::CI32 => { return "i32"; }
        CType::CI64 => { return "i64"; }
        CType::CU8 => { return "u8"; }
        CType::CU16 => { return "u16"; }
        CType::CU32 => { return "u32"; }
        CType::CU64 => { return "u64"; }
        CType::CF32 => { return "f32"; }
        CType::CF64 => { return "f64"; }
        CType::CBool => { return "bool"; }
        CType::CVoid => { return "void"; }
        CType::CStr => { return "str"; }
        CType::CNamed(n) => { return n; }
        CType::CRef(inner) => { return "&" + type_to_pledge(inner); }
    }
    return "*u8";
}

// --- Local helpers ---

fn seen_names_contains(names: Vec<str>, name: str) -> bool {
    var i: i64 = 0;
    while i < names.len() {
        if str_equal(names.get(i), name) { return true; }
        i = i + 1;
    }
    return false;
}

fn is_alpha(c: i64) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
}

pub fn str_from_byte(b: i64) -> str {
    var buf: Vec<i64> = Vec::new();
    buf.push(b);
    return str_from_bytes(buf);
}

fn cp_str_lines(s: str) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var i: i64 = 0;
    var start: i64 = 0;
    while i < str_len(s) {
        var b: i64 = str_byte_at(s, i);
        if b == 10 {
            result.push(str_slice(s, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    if start < str_len(s) {
        result.push(str_slice(s, start, str_len(s)));
    }
    return result;
}

fn cp_str_trim_end_char(s: str, ch: i64) -> str {
    var end: i64 = str_len(s);
    while end > 0 {
        var b: i64 = str_byte_at(s, end - 1);
        if b == ch || b == 32 || b == 9 {
            end = end - 1;
        } else {
            break;
        }
    }
    return str_slice(s, 0, end);
}

fn cp_str_contains(s: str, substr: str) -> bool {
    return str_find(s, substr) >= 0;
}

fn cp_str_find_char(s: str, ch: i64) -> i64 {
    var i: i64 = 0;
    while i < str_len(s) {
        if str_byte_at(s, i) == ch { return i; }
        i = i + 1;
    }
    return -1;
}

fn cp_str_rfind_char(s: str, ch: i64) -> i64 {
    var i: i64 = str_len(s) - 1;
    while i >= 0 {
        if str_byte_at(s, i) == ch { return i; }
        i = i - 1;
    }
    return -1;
}

fn str_rfind_space(s: str) -> i64 {
    var i: i64 = str_len(s) - 1;
    while i >= 0 {
        var b: i64 = str_byte_at(s, i);
        if b == 32 || b == 9 { return i; }
        i = i - 1;
    }
    return -1;
}
