}

fn emit_string_consts(self: &mut CCodeGen, module: IrModule) -> void {
    wln(self, "// --- String constants ---");
    var idx: i64 = 0;
    var f: i64 = 0;
    while f < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(f);
        var func: IrFunction = entry.func;
        var b: i64 = 0;
        while b < func.blocks.len() {
            var block: BasicBlock = func.blocks.get(b);
            var i: i64 = 0;
            while i < block.instructions.len() {
                var inst_id: i64 = block.instructions.get(i);
                var inst: OptInst = find_inst(func.insts, inst_id);
                match inst {
                    OptInst::Some(it) => {
                        match it {
                            Inst::ConstStr(value) => {
                                if !string_consts_contains(self, value) {
                                    var name: str = "_str" + int_to_str(idx);
                                    idx = idx + 1;
                                    var escaped: str = escape_c_string(value);
                                    // [static magic][length] before the bytes (D16)
                                    wln(self, "static const struct { int64_t m; int64_t l; char s[" + int_to_str(str_len(value) + 1) + "]; } " + name + "_h = { P_STR_STATIC_C, " + int_to_str(str_len(value)) + "LL, \"" + escaped + "\" };");
                                    wln(self, "#define " + name + " (" + name + "_h.s)");
                                    string_consts_set(self, value, name);
                                }
                            }
                            Inst::ConstFnRef(name) => {
                                if !string_consts_contains(self, name) {
                                    var cname: str = "_str" + int_to_str(idx);
                                    idx = idx + 1;
                                    var escaped: str = escape_c_string(name);
                                    wln(self, "static const char " + cname + "[] = \"" + escaped + "\";");
                                    string_consts_set(self, name, cname);
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    OptInst::None => {
                    }
                }
                i = i + 1;
            }
            b = b + 1;
        }
        f = f + 1;
    }
    wln(self, "");
}

fn string_consts_contains(self: &CCodeGen, value: str) -> bool {
    return HashMap_get(self.string_const_index, value) > 0;
}

fn find_inst(insts: Vec<ValueIdInst>, id: i64) -> OptInst {
    // A function's instructions are appended in increasing id order
    // (IrFunction_emit), so binary search finds one in O(log n).
    var lo: i64 = 0;
    var hi: i64 = insts.len() - 1;
    while lo <= hi {
        var mid: i64 = (lo + hi) / 2;
        // CS4: the probed id is read in place; only the hit is copied
        var mid_id: i64 = insts.get(mid).id;
        if mid_id == id {
            return OptInst::Some(insts.get(mid).inst);
        }
        if mid_id < id {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    // Not found that way: the order did not hold; scan.
    var i: i64 = 0;
    while i < insts.len() {
        if insts.get(i).id == id {
            return OptInst::Some(insts.get(i).inst);
        }
        i = i + 1;
    }
    return OptInst::None;
}

/// Whether a struct field's type is a fixed-size array `[T; N]` (CI5:
/// c_type gives `T[N]`, which is not a C declarator before a name).
fn cg_field_is_array(ty: IrType) -> bool {
    match ty {
        IrType::Array(_, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

// HashMap: the type names a DynCall can dispatch to (every MakeDyn's type
// and every trait impl's type, as pe_ir and nat_ir find them); 0 before
// CCodeGen_generate fills it
var g_c_dyn_types: i64 = 0;

/// Fills g_c_dyn_types from `module`.
fn cg_collect_dyn_types(module: &IrModule) {
    if g_c_dyn_types == 0 {
        g_c_dyn_types = HashMap_new();
    } else {
        HashMap_clear(g_c_dyn_types);
    }
    var ti: i64 = 0;
    while ti < module.trait_impls.len() {
        var items: Vec<str> = module.trait_impls.get(ti).items;
        var ii: i64 = 0;
        while ii < items.len() {
            HashMap_insert(g_c_dyn_types, items.get(ii), 1);
            ii = ii + 1;
        }
        ti = ti + 1;
    }
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var f: IrFunction = module.functions.get(fi).func;
        var k: i64 = 0;
        while k < f.insts.len() {
            match f.insts.get(k).inst {
                Inst::MakeDyn(_, tname, _) => {
                    HashMap_insert(g_c_dyn_types, tname, 1);
                }
                _ => {
                }
            }
            k = k + 1;
        }
        fi = fi + 1;
    }
}

/// Whether `fname` (`Type_method`) is a candidate of a DynCall of `method`
/// with `nargs` C arguments (the env, the receiver, the rest): Type is a
/// dyn type (a dyn value's type name is all the dispatch compares) and the
/// function takes that many parameters. Any function ending in `_method`
/// was one: core's HashMap_grow(self, cap) was called as
/// HashMap_grow(NULL, _recv, v2) for `grow` of a cap, which C rejects
/// (test_midend_devirt_field).
fn cg_dyn_candidate(self: &CCodeGen, fname: str, method: str, nargs: i64) -> bool {
    var cut: i64 = str_len(fname) - str_len(method) - 1;
    if cut <= 0 {
        return false;
    }
    var type_part: str = str_slice(fname, 0, cut);
    if g_c_dyn_types != 0 && !HashMap_contains(g_c_dyn_types, type_part) {
        return false;
    }
    var ok: bool = true;
    match fn_param_types_get(self, fname) {
        OptVecIrType::Some(pts) => {
            ok = pts.len() == nargs;
        }
        OptVecIrType::None => {
        }
    }
    return ok;
}

fn emit_struct_defs(self: &mut CCodeGen, module: IrModule) -> void {
    wln(self, "// --- Struct definitions ---");
    var emitted: Vec<str> = Vec::new();
    var s: i64 = 0;
    while s < module.struct_layouts.len() {
        var entry: StructLayoutEntry = module.struct_layouts.get(s);
        var name: str = entry.name;
        // Skip duplicate struct definitions (struct_layouts is a Vec, not a HashMap)
        var is_dup: bool = false;
        var di: i64 = 0;
        while di < emitted.len() {
            if emitted.get(di) == name {
                is_dup = true;
            }
            di = di + 1;
        }
        if is_dup {
            s = s + 1;
            continue;
        }
        emitted.push(name);
        var layout: StructLayout = entry.layout;

        if layout.repr_c {
            // @repr(C) struct: emit with natural C types and explicit padding
            wln(self, "struct " + name + "_s {");
            var prev_offset: i64 = 0;
            var i: i64 = 0;
            while i < layout.fields.len() {
                var field: StringIrTypeOffset = layout.fields.get(i);
                // Emit padding bytes if needed to match the layout
                if field.offset > prev_offset {
                    var pad: i64 = field.offset - prev_offset;
                    wln(self, "    char _pad_" + int_to_str(i) + "[" + int_to_str(pad) + "];");
                }
                // Calculate field size
                var field_size: i64 = 0;
                if i + 1 < layout.fields.len() {
                    field_size = layout.fields.get(i + 1).offset - field.offset;
                } else {
                    field_size = layout.size - field.offset;
                }
                if cg_field_is_array(field.ty) {
                    // CI5: `int64_t[3] field_0;` is not C. Fields are reached
                    // by offset, so the field is its room in the layout: one
                    // word (the array's address, as lower.fd lays it out),
                    // or its bytes when it has other room
                    if field_size > 8 && field_size % 8 == 0 {
                        wln(self, "    int64_t field_" + int_to_str(i) + "[" + int_to_str(field_size / 8) + "];");
                    } else if field_size > 0 && field_size != 8 {
                        wln(self, "    unsigned char field_" + int_to_str(i) + "[" + int_to_str(field_size) + "];");
                    } else {
                        wln(self, "    void* field_" + int_to_str(i) + ";");
                    }
                } else {
                    wln(self, "    " + c_type(field.ty) + " field_" + int_to_str(i) + ";");
                }
                prev_offset = field.offset + field_size;
                i = i + 1;
            }
            // Final padding to reach struct size
            if layout.size > prev_offset {
                wln(self, "    char _pad_end[" + int_to_str(layout.size - prev_offset) + "];");
            }
            wln(self, "} __attribute__((aligned(" + int_to_str(layout.align) + ")));");
            wln(self, "");
        } else {
            // Default Fides layout: uniform 8-byte slots
            wln(self, "struct " + name + "_s {");
            var i: i64 = 0;
            while i < layout.fields.len() {
                var field: StringIrTypeOffset = layout.fields.get(i);
                var field_size: i64 = 0;
                if i + 1 < layout.fields.len() {
                    field_size = layout.fields.get(i + 1).offset - field.offset;
                } else {
                    field_size = layout.size - field.offset;
                }
                if field_size > 8 {
                    var slots: i64 = field_size / 8;
                    wln(self, "    int64_t field_" + int_to_str(i) + "[" + int_to_str(slots) + "];");
                } else {
                    match field.ty {
                        IrType::Bool => {
                            wln(self, "    int64_t field_" + int_to_str(i) + ";");
                        }
                        IrType::Array(_, _) => {
                            // CI5: a one-word `[T; N]` field holds the array's
                            // address (as a local of that type does);
                            // `int64_t[3] field_0;` is not C
                            wln(self, "    void* field_" + int_to_str(i) + ";");
                        }
                        _ => {
                            wln(self, "    " + c_type(field.ty) + " field_" + int_to_str(i) + ";");
                        }
                    }
                }
                i = i + 1;
            }
            wln(self, "};");
            wln(self, "");
        }
        s = s + 1;
    }
}

// --- Module-level mutable globals ------------------------------------------

fn global_c_name(name: str) -> str {
    return "_g_" + name;
}

fn gen_global_init_expr(expr: Expr) -> str {
    match expr {
        Expr::IntLit(v) => {
            return int_to_str(v) + "LL";
        }
        Expr::FloatLit(f) => {
            if f != f {
                return "NAN";
            }
            if f > 1.7976931348623157e308 {
                return "INFINITY";
            }
            if f < -1.7976931348623157e308 {
                return "-INFINITY";
            }
            return float_to_str(f);
        }
        Expr::BoolLit(b) => {
            if b {
                return "true";
            }
            return "false";
        }
        Expr::StringLit(s) => {
            return "\"" + escape_c_string(s) + "\"";
        }
        _ => {
            return "0";
        }
    }
    return "0";
}

// Bug 3.16 fix: Check if a global init expression is a simple literal
// (can be used as a C static initializer) or complex (needs runtime init).
fn is_simple_init_expr(expr: Expr) -> bool {
    match expr {
        Expr::IntLit(_) => {
            return true;
        }
        Expr::FloatLit(_) => {
            return true;
        }
        Expr::BoolLit(_) => {
            return true;
        }
        Expr::StringLit(_) => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

// Local helper to unbox Box<Expr> for pattern matching.
fn cg_box_expr_unbox(b: Box<Expr>) -> Expr {
    match b {
        Expr::IntLit(v) => {
            return Expr::IntLit(v);
        }
        Expr::FloatLit(v) => {
            return Expr::FloatLit(v);
        }
        Expr::StringLit(v) => {
            return Expr::StringLit(v);
        }
        Expr::BoolLit(v) => {
            return Expr::BoolLit(v);
        }
        Expr::Ident(n) => {
            return Expr::Ident(n);
        }
        Expr::Call(n, a) => {
            return Expr::Call(n, a);
        }
        Expr::MethodCall(r, m, a) => {
            return Expr::MethodCall(r, m, a);
        }
        Expr::StructLit(n, f, s) => {
            return Expr::StructLit(n, f, s);
        }
        _ => {
            return Expr::IntLit(0);
        }
    }
    return Expr::IntLit(0);
}

// Bug 3.16 fix: Generate a C expression for a runtime global initializer.
// Handles struct literals with Vec::new() fields and simple function calls.
fn gen_global_runtime_expr(self: &mut CCodeGen, expr: Expr) -> str {
    match expr {
        Expr::IntLit(v) => {
            return int_to_str(v) + "LL";
        }
        Expr::FloatLit(f) => {
            if f != f {
                return "NAN";
            }
            if f > 1.7976931348623157e308 {
                return "INFINITY";
            }
            if f < -1.7976931348623157e308 {
                return "-INFINITY";
            }
            return float_to_str(f);
        }
        Expr::BoolLit(b) => {
            if b {
                return "true";
            }
            return "false";
        }
        Expr::StringLit(s) => {
            return "\"" + escape_c_string(s) + "\"";
        }
        Expr::MethodCall(receiver, method, args) => {
            // Handle Vec::new() which is parsed as MethodCall(Ident("Vec"), "new", []).
            var recv_expr: Expr = cg_box_expr_unbox(receiver);
            var recv_name: str = "";
            match recv_expr {
                Expr::Ident(n) => {
                    recv_name = n;
                }
                _ => {
                }
            }
            if str_len(recv_name) > 0 {
                var mangled: str = recv_name + "_" + method;
                var c_fname: str = sanitize_c_name(self, mangled);
                // Vec_new and similar runtime functions need a dummy env arg
                if mangled == "Vec_new" || mangled == "HashMap_new" {
                    if args.len() == 0 {
                        return "(void*)" + c_fname + "(0LL)";
                    }
                    var arg_strs: str = "";
                    var i: i64 = 0;
                    while i < args.len() {
                        if i > 0 {
                            arg_strs = arg_strs + ", ";
                        }
                        arg_strs = arg_strs + gen_global_runtime_expr(self, args.get(i));
                        i = i + 1;
                    }
                    return "(void*)" + c_fname + "(0LL, " + arg_strs + ")";
                }
            }
            return "0";
        }
        Expr::StructLit(sname, fields, _spread) => {
            // Allocate struct on heap, initialize fields, return pointer
            var size: i64 = 8;
            var si: i64 = 0;
            while si < self.struct_layouts.len() {
                if self.struct_layouts.get(si).name == sname {
                    size = self.struct_layouts.get(si).layout.size;
                    break;
                }
                si = si + 1;
            }
            var tmp: str = "__ginit_" + sname;
            wln(self, "    struct " + sname + "_s* " + tmp + " = (struct " + sname + "_s*)p_malloc(" + int_to_str(size) + ");");
            wln(self, "    memset(" + tmp + ", 0, " + int_to_str(size) + ");");
            var fi: i64 = 0;
            while fi < fields.len() {
                var field: FieldInit = fields.get(fi);
                // Find field offset and type from struct layout
                var foffset: i64 = 0;
                var ftype: IrType = IrType::I64;
                var found: bool = false;
                var li: i64 = 0;
                while li < self.struct_layouts.len() {
                    if self.struct_layouts.get(li).name == sname {
                        var layout: StructLayout = self.struct_layouts.get(li).layout;
                        var fj: i64 = 0;
                        while fj < layout.fields.len() {
                            var sf: StringIrTypeOffset = layout.fields.get(fj);
                            if sf.name == field.name {
                                foffset = sf.offset;
                                ftype = sf.ty;
                                found = true;
                                break;
                            }
                            fj = fj + 1;
                        }
                        break;
                    }
                    li = li + 1;
                }
                if found {
                    var val_str: str = gen_global_runtime_expr(self, field.value);
                    var ptr_str: str = "((char*)" + tmp + " + " + int_to_str(foffset) + ")";
                    match ftype {
                        IrType::F64 => {
                            wln(self, "    *(double*)" + ptr_str + " = " + val_str + ";");
                        }
                        IrType::F32 => {
                            wln(self, "    *(float*)" + ptr_str + " = " + val_str + ";");
                        }
                        IrType::Bool => {
                            wln(self, "    *(bool*)" + ptr_str + " = " + val_str + ";");
                        }
                        IrType::I8 => {
                            wln(self, "    *(int8_t*)" + ptr_str + " = (int8_t)" + val_str + ";");
                        }
                        IrType::I16 => {
                            wln(self, "    *(int16_t*)" + ptr_str + " = (int16_t)" + val_str + ";");
                        }
                        IrType::I32 => {
                            wln(self, "    *(int32_t*)" + ptr_str + " = (int32_t)" + val_str + ";");
                        }
                        IrType::U8 => {
                            wln(self, "    *(uint8_t*)" + ptr_str + " = (uint8_t)" + val_str + ";");
                        }
                        IrType::U16 => {
                            wln(self, "    *(uint16_t*)" + ptr_str + " = (uint16_t)" + val_str + ";");
                        }
                        IrType::U32 => {
                            wln(self, "    *(uint32_t*)" + ptr_str + " = (uint32_t)" + val_str + ";");
                        }
                        IrType::Ptr(_) => {
                            wln(self, "    *(void**)" + ptr_str + " = (void*)" + val_str + ";");
                        }
                        IrType::Opaque(_) => {
                            wln(self, "    *(void**)" + ptr_str + " = (void*)" + val_str + ";");
                        }
                        IrType::Generic(_, _) => {
                            wln(self, "    *(void**)" + ptr_str + " = (void*)" + val_str + ";");
                        }
                        _ => {
                            wln(self, "    *(int64_t*)" + ptr_str + " = (int64_t)" + val_str + ";");
                        }
                    }
                }
                fi = fi + 1;
            }
            return "(void*)" + tmp;
        }
        _ => {
            return "0";
        }
    }
    return "0";
}

fn emit_globals(self: &mut CCodeGen, module: IrModule) -> void {
    if module.globals.len() == 0 {
        return;
    }
    wln(self, "// --- Module-level mutable globals ---");
    var gi: i64 = 0;
    while gi < module.globals.len() {
        var entry: GlobalEntry = module.globals.get(gi);
        var c_ty: str = c_type_global(entry.ty);
        var c_name: str = global_c_name(entry.name);
        var is_struct: bool = false;
        match entry.ty {
            IrType::Struct(_) => {
                is_struct = true;
            }
            _ => {
            }
        }
        if is_struct {
            wln(self, "static " + c_ty + " " + c_name + " = {0};");
        } else {
            var init_str: str = gen_global_init_expr(entry.init);
            // S3: a str literal is the headered static, as every other literal
            // (the first assignment's P_STR_DROP reads 16 bytes before it)
            match entry.init {
                Expr::StringLit(gs) => {
                    wln(self, "static const struct { int64_t m; int64_t l; char s[" + int_to_str(str_len(gs) + 1) + "]; } " + c_name + "_h = { P_STR_STATIC_C, " + int_to_str(str_len(gs)) + "LL, \"" + escape_c_string(gs) + "\" };");
                    init_str = "(void*)" + c_name + "_h.s";
                }
                _ => {
                }
            }
            wln(self, "static " + c_ty + " " + c_name + " = " + init_str + ";");
        }
        gi = gi + 1;
    }
    wln(self, "");
}

// Bug 3.16 fix: Emit __init_globals() function that initializes globals
// with complex (non-literal) initializers at runtime.
fn emit_global_init_function(self: &mut CCodeGen, module: IrModule) -> void {
    // Always emit a forward declaration so main() can call it unconditionally
    wln(self, "// --- Runtime global initialization (bug 3.16 fix) ---");
    wln(self, "static void __init_globals(void);");
    if module.globals.len() == 0 {
        // Emit empty function body
        wln(self, "static void __init_globals(void) { }");
        wln(self, "");
        return;
    }
    // Check if any global needs runtime init
    var needs_init: bool = false;
    var gi: i64 = 0;
    while gi < module.globals.len() {
        var entry: GlobalEntry = module.globals.get(gi);
        if !is_simple_init_expr(entry.init) {
            needs_init = true;
            break;
        }
        gi = gi + 1;
    }
    if !needs_init {
        // Emit empty function body
        wln(self, "static void __init_globals(void) { }");
        wln(self, "");
        return;
    }

    wln(self, "static void __init_globals(void) {");
    gi = 0;
    while gi < module.globals.len() {
        var entry: GlobalEntry = module.globals.get(gi);
        if !is_simple_init_expr(entry.init) {
            var c_name: str = global_c_name(entry.name);
            var is_struct_global: bool = false;
            match entry.ty {
                IrType::Struct(sname) => {
                    is_struct_global = true;
                    var size: i64 = 8;
                    var si: i64 = 0;
                    while si < module.struct_layouts.len() {
                        var sl: StructLayoutEntry = module.struct_layouts.get(si);
                        if sl.name == sname {
                            size = sl.layout.size;
                            break;
                        }
                        si = si + 1;
                    }
                    wln(self, "    memset(&" + c_name + ", 0, " + int_to_str(size) + ");");
                }
                _ => {
                }
            }
            if !is_struct_global {
                var val_str: str = gen_global_runtime_expr(self, entry.init);
                wln(self, "    " + c_name + " = " + val_str + ";");
            }
        }
        gi = gi + 1;
    }
    wln(self, "}");
    wln(self, "");
}

/// A C type that holds a 64-bit integer or a pointer.
fn is_word_c(c: str) -> bool {
    return c == "int64_t" || c == "uint64_t" || str_ends_with(c, "*");
}

fn emit_prototypes(self: &mut CCodeGen, module: IrModule) -> void {
    wln(self, "// --- Function prototypes ---");
    wln(self, "void p_thread_register(const char* name, int64_t (*fn)());");
    var f: i64 = 0;
    while f < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(f);
        var proto_name: str = sanitize_c_name(self, entry.name);
        var ret_ty: str;
        if entry.name == "main" {
            ret_ty = "int64_t";
        } else {
            ret_ty = c_ret_type(entry.func.ret_ty);
        }
        var params: str = "";
        var p: i64 = 0;
        while p < entry.func.params.len() {
            var vp: ValueIdType = entry.func.params.get(p);
            if p > 0 {
                params = params + ", ";
            }
            params = params + c_param_decl(vp.ty, "v" + int_to_str(vp.id));
            p = p + 1;
        }
        wln(self, ret_ty + " " + proto_name + "(" + params + ");");
        f = f + 1;
    }
    // C takes a struct by value and Fides has a pointer to it
    var wi: i64 = 0;
    while wi < module.extern_decls.len() {
        var ext: ExternDecl = module.extern_decls.get(wi);
        if vec_contains_str(self.c_wrapped, ext.pledge_name) {
            var w_params: str = "";
            var w_args: str = "";
            var struct_ret: bool = c_is_struct(module, ext.ret_ty);
            if struct_ret {
                w_params = "void* ret";
            }
            var wp: i64 = 0;
            while wp < ext.params.len() {
                var pty: Type = ext.params.get(wp).ty;
                var c_ty: str = c_type_from_ast(pty);
                var a_name: str = "a" + int_to_str(wp);
                if w_params != "" {
                    w_params = w_params + ", ";
                }
                if wp > 0 {
                    w_args = w_args + ", ";
                }
                if c_is_struct(module, pty) {
                    w_params = w_params + "void* " + a_name;
                    w_args = w_args + "*(" + c_ty + "*)" + a_name;
                } else {
                    w_params = w_params + c_ty + " " + a_name;
                    w_args = w_args + a_name;
                }
                wp = wp + 1;
            }
            if w_params == "" {
                w_params = "void";
            }
            var w_call: str = ext.pledge_name + "(" + w_args + ")";
            var w_ret: str = c_type_from_ast(ext.ret_ty);
            if struct_ret {
                w_call = "*(" + w_ret + "*)ret = " + w_call;
                w_ret = "void";
            } else if w_ret != "void" {
                w_call = "return " + w_call;
            }
            wln(self, w_ret + " __c_wrap_" + ext.pledge_name + "(" + w_params + ") { " + w_call + "; }");
        }
        wi = wi + 1;
    }
    // C calls these: they supply the `__env` Fides functions take
    var cb: i64 = 0;
    while cb < module.c_callbacks.len() {
        var target: str = module.c_callbacks.get(cb);
        match IrModule_get_function(&module, target) {
            OptIrFunction::Some(func) => {
                var c_ret: str = c_ret_type(func.ret_ty);
                var c_name: str = sanitize_c_name(self, target);
                var c_params: str = "";
                var c_args: str = "NULL";
                var p2: i64 = 1;
                while p2 < func.params.len() {
                    var arg_name: str = "a" + int_to_str(p2 - 1);
                    if p2 > 1 {
                        c_params = c_params + ", ";
                    }
                    c_params = c_params + c_param_decl(func.params.get(p2).ty, arg_name);
                    c_args = c_args + ", " + arg_name;
                    p2 = p2 + 1;
                }
                var call: str = c_name + "(" + c_args + ");";
                if c_ret != "void" {
                    call = "return " + call;
                }
                wln(self, c_ret + " " + c_fn_name(c_name) + "(" + c_params + ") { " + call + " }");
            }
            OptIrFunction::None => {
            }
        }
        cb = cb + 1;
    }
    wln(self, "");
}

/// ML13 / roadmap P6: tensor parallelism over several ranks, one process per
/// rank (docs/reference/tensor-parallel.md). Emitted inside
/// emit_runtime_impl, after the autograd helpers (ag_tp_rank,
/// ag_tp_world_size, ag_clone_tensor); it ends inside p_recv_tensor, whose
/// one-rank half follows there. The main wrapper calls __p_tp_boot and
/// __p_tp_finish.
fn cg_emit_tp_runtime(self: &mut CCodeGen) -> void {
    wln(self, "// ML13 / roadmap P6: tensor parallelism over several ranks.");
    wln(self, "// One process per rank: p_tp_init(n) (or FID_TP_WORLD=n in the environment)");
    wln(self, "// starts ranks 1..n-1 (fork on POSIX; on Windows the program runs again, its");
    wln(self, "// output held back until it reaches p_tp_init). Every pair of ranks has a pipe");
    wln(self, "// each way; the collectives go through rank 0 in rank order, so a sum is the");
    wln(self, "// same on every run. One rank (the default) keeps the old behavior: copies.");
    wln(self, "#include <errno.h>");
    wln(self, "#define P_TP_MAX 32");
    wln(self, "#define P_TP_MAGIC 0x46494454504d5347LL");
    wln(self, "#define P_TP_HDR 12");
    wln(self, "#ifdef _WIN32");
    wln(self, "typedef HANDLE __p_tp_fd;");
    wln(self, "#else");
    wln(self, "typedef int __p_tp_fd;");
    wln(self, "#endif");
    wln(self, "static __p_tp_fd __p_tp_in[P_TP_MAX];");
    wln(self, "static __p_tp_fd __p_tp_out[P_TP_MAX];");
    wln(self, "static int __p_tp_open = 0;");
    wln(self, "static int __p_tp_booted = 0;");
    wln(self, "static int __p_tp_started = 0;");
    wln(self, "static int __p_tp_nchild = 0;");
    wln(self, "static int __p_tp_waited = 0;");
    wln(self, "#ifdef _WIN32");
    wln(self, "static HANDLE __p_tp_child[P_TP_MAX];");
    wln(self, "static int __p_tp_mute_out = -1;");
    wln(self, "static int __p_tp_mute_err = -1;");
    wln(self, "#elif !defined(__wasi__)");
    wln(self, "static pid_t __p_tp_child[P_TP_MAX];");
    wln(self, "#endif");
    wln(self, "static const char* __p_tp_op_name(int64_t op) {");
    wln(self, "    switch (op) {");
    wln(self, "        case 1: case 2: return \"all_reduce\";");
    wln(self, "        case 3: return \"broadcast\";");
    wln(self, "        case 4: case 5: return \"all_gather\";");
    wln(self, "        case 6: return \"scatter\";");
    wln(self, "        case 7: return \"send_tensor/recv_tensor\";");
    wln(self, "        default: return \"?\";");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "static void __p_tp_fail(const char* op, int peer, const char* what) {");
    wln(self, "    char m[256];");
    wln(self, "    snprintf(m, sizeof m, \"%s on rank %d: rank %d %s\", op, (int)ag_tp_rank, peer, what);");
    wln(self, "    p_panic(m);");
    wln(self, "}");
    wln(self, "static int __p_tp_write_all(__p_tp_fd f, const void* buf, int64_t n) {");
    wln(self, "#ifdef __wasi__");
    wln(self, "    (void)f; (void)buf; return n <= 0;");
    wln(self, "#else");
    wln(self, "    const char* p = (const char*)buf;");
    wln(self, "    while (n > 0) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        DWORD w = 0;");
    wln(self, "        DWORD chunk = n > 0x40000000 ? 0x40000000 : (DWORD)n;");
    wln(self, "        if (!WriteFile(f, p, chunk, &w, NULL) || w == 0) return 0;");
    wln(self, "#else");
    wln(self, "        ssize_t w = write(f, p, (size_t)n);");
    wln(self, "        if (w < 0 && errno == EINTR) continue;");
    wln(self, "        if (w <= 0) return 0;");
    wln(self, "#endif");
    wln(self, "        p += w; n -= (int64_t)w;");
    wln(self, "    }");
    wln(self, "    return 1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static int __p_tp_read_all(__p_tp_fd f, void* buf, int64_t n) {");
    wln(self, "#ifdef __wasi__");
    wln(self, "    (void)f; (void)buf; return n <= 0;");
    wln(self, "#else");
    wln(self, "    char* p = (char*)buf;");
    wln(self, "    while (n > 0) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        DWORD r = 0;");
    wln(self, "        DWORD chunk = n > 0x40000000 ? 0x40000000 : (DWORD)n;");
    wln(self, "        if (!ReadFile(f, p, chunk, &r, NULL) || r == 0) return 0;");
    wln(self, "#else");
    wln(self, "        ssize_t r = read(f, p, (size_t)n);");
    wln(self, "        if (r < 0 && errno == EINTR) continue;");
    wln(self, "        if (r <= 0) return 0;");
    wln(self, "#endif");
    wln(self, "        p += r; n -= (int64_t)r;");
    wln(self, "    }");
    wln(self, "    return 1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static void __p_tp_send(int peer, int64_t op, PTensor* t) {");
    wln(self, "    int64_t h[P_TP_HDR];");
    wln(self, "    h[0] = P_TP_MAGIC; h[1] = op; h[2] = t->ndim; h[3] = t->len;");
    wln(self, "    for (int i = 0; i < 8; i++) h[4 + i] = i < t->ndim ? t->shape[i] : 0;");
    wln(self, "    if (!__p_tp_write_all(__p_tp_out[peer], h, sizeof h)");
    wln(self, "        || (t->len > 0 && !__p_tp_write_all(__p_tp_out[peer], t->data, t->len * (int64_t)sizeof(double))))");
    wln(self, "        __p_tp_fail(__p_tp_op_name(op), peer, \"is gone (it exited or failed)\");");
    wln(self, "}");
    wln(self, "static PTensor* __p_tp_recv(int peer, int64_t op) {");
    wln(self, "    int64_t h[P_TP_HDR];");
    wln(self, "    if (!__p_tp_read_all(__p_tp_in[peer], h, sizeof h))");
    wln(self, "        __p_tp_fail(__p_tp_op_name(op), peer, \"is gone (it exited or failed)\");");
    wln(self, "    if (h[0] != P_TP_MAGIC) __p_tp_fail(__p_tp_op_name(op), peer, \"sent a corrupt message\");");
    wln(self, "    if (h[1] != op) {");
    wln(self, "        char m[256];");
    wln(self, "        snprintf(m, sizeof m, \"%s on rank %d: rank %d called %s instead (every rank must call the same collectives in the same order)\", __p_tp_op_name(op), (int)ag_tp_rank, peer, __p_tp_op_name(h[1]));");
    wln(self, "        p_panic(m);");
    wln(self, "    }");
    wln(self, "    int64_t ndim = h[2], len = h[3], want = 1;");
    wln(self, "    if (ndim < 0 || ndim > 8 || len < 0) __p_tp_fail(__p_tp_op_name(op), peer, \"sent a corrupt tensor header\");");
    wln(self, "    for (int64_t i = 0; i < ndim; i++) { if (h[4 + i] < 0) want = -1; else if (want >= 0) want *= h[4 + i]; }");
    wln(self, "    if (ndim > 0 && want != len) __p_tp_fail(__p_tp_op_name(op), peer, \"sent a tensor whose shape does not match its size\");");
    wln(self, "    PTensor* r = (PTensor*)malloc(sizeof(PTensor));");
    wln(self, "    r->ndim = ndim; r->len = len;");
    wln(self, "    for (int i = 0; i < 8; i++) r->shape[i] = i < ndim ? h[4 + i] : 0;");
    wln(self, "    r->data = (double*)malloc((len > 0 ? len : 1) * sizeof(double));");
    wln(self, "    if (len > 0 && !__p_tp_read_all(__p_tp_in[peer], r->data, len * (int64_t)sizeof(double)))");
    wln(self, "        __p_tp_fail(__p_tp_op_name(op), peer, \"is gone (it exited or failed)\");");
    wln(self, "    return r;");
    wln(self, "}");
    wln(self, "static void __p_tp_free(PTensor* t) { if (t) { free(t->data); free(t); } }");
    wln(self, "static int __p_tp_same_shape(PTensor* a, PTensor* b, int from) {");
    wln(self, "    if (a->ndim != b->ndim || a->len != b->len) return 0;");
    wln(self, "    for (int64_t i = from; i < a->ndim && i < 8; i++) if (a->shape[i] != b->shape[i]) return 0;");
    wln(self, "    return 1;");
    wln(self, "}");
    wln(self, "static void __p_tp_close_links(void) {");
    wln(self, "    if (!__p_tp_open) return;");
    wln(self, "    __p_tp_open = 0;");
    wln(self, "    for (int b = 0; b < ag_tp_world_size; b++) {");
    wln(self, "        if (b == ag_tp_rank) continue;");
    wln(self, "#ifdef _WIN32");
    wln(self, "        CloseHandle(__p_tp_in[b]); CloseHandle(__p_tp_out[b]);");
    wln(self, "#elif !defined(__wasi__)");
    wln(self, "        close(__p_tp_in[b]); close(__p_tp_out[b]);");
    wln(self, "#endif");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "// Rank 0 waits for the other ranks: its links are closed first, so a rank");
    wln(self, "// still waiting on rank 0 sees it gone instead of waiting for ever.");
    wln(self, "// Returns 1 when every rank ended with status 0.");
    wln(self, "static int __p_tp_wait_all(void) {");
    wln(self, "    if (__p_tp_waited) return 1;");
    wln(self, "    __p_tp_waited = 1;");
    wln(self, "    __p_tp_close_links();");
    wln(self, "    int ok = 1;");
    wln(self, "    for (int r = 1; r <= __p_tp_nchild; r++) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        DWORD code = 1;");
    wln(self, "        WaitForSingleObject(__p_tp_child[r], INFINITE);");
    wln(self, "        GetExitCodeProcess(__p_tp_child[r], &code);");
    wln(self, "        CloseHandle(__p_tp_child[r]);");
    wln(self, "        if (code != 0) { fprintf(stderr, \"tp: rank %d exited with status %lu\\n\", r, (unsigned long)code); ok = 0; }");
    wln(self, "#elif !defined(__wasi__)");
    wln(self, "        int st = 0;");
    wln(self, "        while (waitpid(__p_tp_child[r], &st, 0) < 0 && errno == EINTR) {}");
    wln(self, "        if (!WIFEXITED(st) || WEXITSTATUS(st) != 0) { fprintf(stderr, \"tp: rank %d exited with status %d\\n\", r, WIFEXITED(st) ? WEXITSTATUS(st) : 128 + (st & 0x7f)); ok = 0; }");
    wln(self, "#endif");
    wln(self, "    }");
    wln(self, "    return ok;");
    wln(self, "}");
    wln(self, "static void __p_tp_atexit(void) {");
    wln(self, "    fflush(stdout);");
    wln(self, "    if (ag_tp_rank == 0) __p_tp_wait_all(); else __p_tp_close_links();");
    wln(self, "}");
    wln(self, "#ifdef _WIN32");
    wln(self, "static void __p_tp_mute(void) {");
    wln(self, "    fflush(stdout); fflush(stderr);");
    wln(self, "    int nul = _open(\"NUL\", _O_WRONLY | _O_BINARY);");
    wln(self, "    if (nul < 0) return;");
    wln(self, "    __p_tp_mute_out = _dup(1); __p_tp_mute_err = _dup(2);");
    wln(self, "    _dup2(nul, 1); _dup2(nul, 2); _close(nul);");
    wln(self, "}");
    wln(self, "static void __p_tp_unmute(void) {");
    wln(self, "    fflush(stdout); fflush(stderr);");
    wln(self, "    if (__p_tp_mute_out >= 0) { _dup2(__p_tp_mute_out, 1); _close(__p_tp_mute_out); __p_tp_mute_out = -1; }");
    wln(self, "    if (__p_tp_mute_err >= 0) { _dup2(__p_tp_mute_err, 2); _close(__p_tp_mute_err); __p_tp_mute_err = -1; }");
    wln(self, "}");
    wln(self, "static void __p_tp_env_clear(void) {");
    wln(self, "    SetEnvironmentVariableA(\"FID_TP_RANK\", NULL);");
    wln(self, "    SetEnvironmentVariableA(\"FID_TP_LINKS\", NULL);");
    wln(self, "    SetEnvironmentVariableA(\"FID_TP_LATE\", NULL);");
    wln(self, "    SetEnvironmentVariableA(\"FID_TP_WORLD\", NULL);");
    wln(self, "}");
    wln(self, "static int __p_tp_inheritable(HANDLE h, int on) {");
    wln(self, "    if (h == NULL || h == INVALID_HANDLE_VALUE) return 0;");
    wln(self, "    return SetHandleInformation(h, HANDLE_FLAG_INHERIT, on ? HANDLE_FLAG_INHERIT : 0) != 0;");
    wln(self, "}");
    wln(self, "// Start ranks 1..n-1 as copies of this program. The pipes are made");
    wln(self, "// inheritable one rank at a time, so a rank holds only its own pipe ends");
    wln(self, "// (named in FID_TP_LINKS) and sees another rank's exit as the end of a pipe.");
    wln(self, "static void __p_tp_spawn(int n, int late) {");
    wln(self, "    HANDLE* rd = (HANDLE*)calloc((size_t)(n * n), sizeof(HANDLE));");
    wln(self, "    HANDLE* wr = (HANDLE*)calloc((size_t)(n * n), sizeof(HANDLE));");
    wln(self, "    for (int a = 0; a < n; a++) for (int b = 0; b < n; b++) {");
    wln(self, "        if (a == b) continue;");
    wln(self, "        if (!CreatePipe(&rd[a * n + b], &wr[a * n + b], NULL, 1 << 20)) p_panic(\"tp_init: cannot create the pipes between ranks\");");
    wln(self, "    }");
    wln(self, "    HANDLE stdh[3]; int std_ok = 1;");
    wln(self, "    stdh[0] = GetStdHandle(STD_INPUT_HANDLE); stdh[1] = GetStdHandle(STD_OUTPUT_HANDLE); stdh[2] = GetStdHandle(STD_ERROR_HANDLE);");
    wln(self, "    for (int i = 0; i < 3; i++) {");
    wln(self, "        if (stdh[i] == INVALID_HANDLE_VALUE) stdh[i] = NULL;");
    wln(self, "        if (stdh[i] && !__p_tp_inheritable(stdh[i], 1)) std_ok = 0;");
    wln(self, "    }");
    wln(self, "    char exe[4096];");
    wln(self, "    DWORD el = GetModuleFileNameA(NULL, exe, sizeof exe);");
    wln(self, "    if (el == 0 || el >= sizeof exe) p_panic(\"tp_init: cannot find this program's file\");");
    wln(self, "    char* links = (char*)malloc((size_t)n * 64 + 16);");
    wln(self, "    char num[32];");
    wln(self, "    fflush(stdout); fflush(stderr);");
    wln(self, "    for (int r = 1; r < n; r++) {");
    wln(self, "        links[0] = 0;");
    wln(self, "        for (int b = 0; b < n; b++) {");
    wln(self, "            if (b == r) continue;");
    wln(self, "            HANDLE in = rd[b * n + r], out = wr[r * n + b];");
    wln(self, "            snprintf(links + strlen(links), 64, \"%d:%llx:%llx;\", b, (unsigned long long)(uintptr_t)in, (unsigned long long)(uintptr_t)out);");
    wln(self, "            __p_tp_inheritable(in, 1); __p_tp_inheritable(out, 1);");
    wln(self, "        }");
    wln(self, "        snprintf(num, sizeof num, \"%d\", r); SetEnvironmentVariableA(\"FID_TP_RANK\", num);");
    wln(self, "        snprintf(num, sizeof num, \"%d\", n); SetEnvironmentVariableA(\"FID_TP_WORLD\", num);");
    wln(self, "        SetEnvironmentVariableA(\"FID_TP_LINKS\", links);");
    wln(self, "        SetEnvironmentVariableA(\"FID_TP_LATE\", late ? \"1\" : \"0\");");
    wln(self, "        STARTUPINFOA si; ZeroMemory(&si, sizeof si);");
    wln(self, "        si.cb = sizeof si;");
    wln(self, "        if (std_ok) {");
    wln(self, "            si.dwFlags = STARTF_USESTDHANDLES;");
    wln(self, "            si.hStdInput = stdh[0]; si.hStdOutput = stdh[1]; si.hStdError = stdh[2];");
    wln(self, "        }");
    wln(self, "        PROCESS_INFORMATION pi;");
    wln(self, "        char* cmd = _strdup(GetCommandLineA());");
    wln(self, "        BOOL ok = CreateProcessA(exe, cmd, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi);");
    wln(self, "        DWORD err = GetLastError();");
    wln(self, "        free(cmd);");
    wln(self, "        for (int b = 0; b < n; b++) {");
    wln(self, "            if (b == r) continue;");
    wln(self, "            __p_tp_inheritable(rd[b * n + r], 0); __p_tp_inheritable(wr[r * n + b], 0);");
    wln(self, "        }");
    wln(self, "        if (!ok) { char m[128]; snprintf(m, sizeof m, \"tp_init: cannot start rank %d (error %lu)\", r, (unsigned long)err); p_panic(m); }");
    wln(self, "        CloseHandle(pi.hThread);");
    wln(self, "        __p_tp_child[r] = pi.hProcess; __p_tp_nchild = r;");
    wln(self, "    }");
    wln(self, "    __p_tp_env_clear();");
    wln(self, "    for (int a = 0; a < n; a++) for (int b = 0; b < n; b++) {");
    wln(self, "        if (a == b) continue;");
    wln(self, "        if (b == 0) __p_tp_in[a] = rd[a * n + b]; else CloseHandle(rd[a * n + b]);");
    wln(self, "        if (a == 0) __p_tp_out[b] = wr[a * n + b]; else CloseHandle(wr[a * n + b]);");
    wln(self, "    }");
    wln(self, "    free(rd); free(wr); free(links);");
    wln(self, "    ag_tp_rank = 0; ag_tp_world_size = n; __p_tp_open = 1;");
    wln(self, "    atexit(__p_tp_atexit);");
    wln(self, "}");
    wln(self, "// A rank started by __p_tp_spawn: take the pipe ends named in FID_TP_LINKS.");
    wln(self, "static int __p_tp_attach(void) {");
    wln(self, "    char buf[64];");
    wln(self, "    DWORD k = GetEnvironmentVariableA(\"FID_TP_RANK\", buf, sizeof buf);");
    wln(self, "    if (k == 0 || k >= sizeof buf) return 0;");
    wln(self, "    int rank = atoi(buf);");
    wln(self, "    k = GetEnvironmentVariableA(\"FID_TP_WORLD\", buf, sizeof buf);");
    wln(self, "    int n = (k > 0 && k < sizeof buf) ? atoi(buf) : 0;");
    wln(self, "    DWORD ll = GetEnvironmentVariableA(\"FID_TP_LINKS\", NULL, 0);");
    wln(self, "    if (n < 2 || n > P_TP_MAX || rank < 1 || rank >= n || ll == 0) return 0;");
    wln(self, "    char* links = (char*)malloc(ll + 1);");
    wln(self, "    GetEnvironmentVariableA(\"FID_TP_LINKS\", links, ll + 1);");
    wln(self, "    k = GetEnvironmentVariableA(\"FID_TP_LATE\", buf, sizeof buf);");
    wln(self, "    int late = k > 0 && k < sizeof buf && buf[0] == '1';");
    wln(self, "    char* p = links; int got = 0;");
    wln(self, "    while (*p) {");
    wln(self, "        char* e; int b = (int)strtol(p, &e, 10); if (*e != ':') break; p = e + 1;");
    wln(self, "        unsigned long long hi = strtoull(p, &e, 16); if (*e != ':') break; p = e + 1;");
    wln(self, "        unsigned long long ho = strtoull(p, &e, 16); if (*e != ';') break; p = e + 1;");
    wln(self, "        if (b < 0 || b >= n || b == rank) break;");
    wln(self, "        __p_tp_in[b] = (HANDLE)(uintptr_t)hi; __p_tp_out[b] = (HANDLE)(uintptr_t)ho;");
    wln(self, "        SetHandleInformation(__p_tp_in[b], HANDLE_FLAG_INHERIT, 0);");
    wln(self, "        SetHandleInformation(__p_tp_out[b], HANDLE_FLAG_INHERIT, 0);");
    wln(self, "        got++;");
    wln(self, "    }");
    wln(self, "    free(links);");
    wln(self, "    __p_tp_env_clear();");
    wln(self, "    if (got != n - 1) p_panic(\"tp: this rank was started with broken FID_TP_LINKS\");");
    wln(self, "    ag_tp_rank = rank; ag_tp_world_size = n; __p_tp_open = 1; __p_tp_started = 1;");
    wln(self, "    atexit(__p_tp_atexit);");
    wln(self, "    if (late) __p_tp_mute();");
    wln(self, "    return 1;");
    wln(self, "}");
    wln(self, "#elif !defined(__wasi__)");
    wln(self, "static void __p_tp_spawn(int n, int late) {");
    wln(self, "    (void)late;");
    wln(self, "    int* rd = (int*)malloc(sizeof(int) * (size_t)(n * n));");
    wln(self, "    int* wr = (int*)malloc(sizeof(int) * (size_t)(n * n));");
    wln(self, "    for (int a = 0; a < n; a++) for (int b = 0; b < n; b++) {");
    wln(self, "        rd[a * n + b] = -1; wr[a * n + b] = -1;");
    wln(self, "        if (a == b) continue;");
    wln(self, "        int fds[2];");
    wln(self, "        if (pipe(fds) != 0) p_panic(\"tp_init: cannot create the pipes between ranks\");");
    wln(self, "        rd[a * n + b] = fds[0]; wr[a * n + b] = fds[1];");
    wln(self, "    }");
    wln(self, "    fflush(stdout); fflush(stderr);");
    wln(self, "    int me = 0;");
    wln(self, "    for (int r = 1; r < n; r++) {");
    wln(self, "        pid_t pid = fork();");
    wln(self, "        if (pid < 0) p_panic(\"tp_init: cannot start a rank (fork failed)\");");
    wln(self, "        if (pid == 0) { me = r; __p_tp_nchild = 0; break; }");
    wln(self, "        __p_tp_child[r] = pid; __p_tp_nchild = r;");
    wln(self, "    }");
    wln(self, "    for (int a = 0; a < n; a++) for (int b = 0; b < n; b++) {");
    wln(self, "        if (a == b) continue;");
    wln(self, "        if (b == me) { __p_tp_in[a] = rd[a * n + b]; fcntl(rd[a * n + b], F_SETFD, FD_CLOEXEC); }");
    wln(self, "        else close(rd[a * n + b]);");
    wln(self, "        if (a == me) { __p_tp_out[b] = wr[a * n + b]; fcntl(wr[a * n + b], F_SETFD, FD_CLOEXEC); }");
    wln(self, "        else close(wr[a * n + b]);");
    wln(self, "    }");
    wln(self, "    free(rd); free(wr);");
    wln(self, "    unsetenv(\"FID_TP_WORLD\");");
    wln(self, "    ag_tp_rank = me; ag_tp_world_size = n; __p_tp_open = 1;");
    wln(self, "    atexit(__p_tp_atexit);");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "// At the start of main: a rank started by rank 0 takes its links; with");
    wln(self, "// FID_TP_WORLD=n (n > 1) rank 0 starts the others now.");
    wln(self, "void __p_tp_boot(void) {");
    wln(self, "    if (__p_tp_booted) return;");
    wln(self, "    __p_tp_booted = 1;");
    wln(self, "#ifndef __wasi__");
    wln(self, "#ifdef _WIN32");
    wln(self, "    if (__p_tp_attach()) return;");
    wln(self, "#endif");
    wln(self, "    const char* w = getenv(\"FID_TP_WORLD\");");
    wln(self, "    int n = w ? atoi(w) : 0;");
    wln(self, "    if (n > 1) {");
    wln(self, "        if (n > P_TP_MAX) { char m[96]; snprintf(m, sizeof m, \"FID_TP_WORLD=%d: at most %d ranks\", n, P_TP_MAX); p_panic(m); }");
    wln(self, "        __p_tp_started = 1;");
    wln(self, "        __p_tp_spawn(n, 0);");
    wln(self, "    }");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "// After main: rank 0 waits for the others, and fails when one of them did.");
    wln(self, "int64_t __p_tp_finish(int64_t result) {");
    wln(self, "    fflush(stdout);");
    wln(self, "    if (ag_tp_world_size <= 1) return result;");
    wln(self, "    if (ag_tp_rank != 0) { __p_tp_close_links(); return result; }");
    wln(self, "    int ok = __p_tp_wait_all();");
    wln(self, "    return (!ok && result == 0) ? 1 : result;");
    wln(self, "}");
    wln(self, "int64_t p_tp_init(int64_t n) {");
    wln(self, "    __p_tp_boot();");
    wln(self, "    if (__p_tp_started) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        __p_tp_unmute();");
    wln(self, "#endif");
    wln(self, "        return ag_tp_rank;");
    wln(self, "    }");
    wln(self, "    __p_tp_started = 1;");
    wln(self, "    if (n > P_TP_MAX) { char m[96]; snprintf(m, sizeof m, \"tp_init(%lld): at most %d ranks\", (long long)n, P_TP_MAX); p_panic(m); }");
    wln(self, "#ifndef __wasi__");
    wln(self, "    if (n > 1) __p_tp_spawn((int)n, 1);");
    wln(self, "#endif");
    wln(self, "    return ag_tp_rank;");
    wln(self, "}");
    wln(self, "int64_t p_tp_rank(void) { return ag_tp_rank; }");
    wln(self, "int64_t p_tp_world_size(void) { return ag_tp_world_size; }");
    wln(self, "// Sum over the ranks, added in rank order on rank 0, the sum sent back.");
    wln(self, "void* p_all_reduce(void* t) {");
    wln(self, "    PTensor* pt = (PTensor*)t; if (!pt) return NULL;");
    wln(self, "    int n = ag_tp_world_size;");
    wln(self, "    if (n <= 1) return (void*)ag_clone_tensor(pt);");
    wln(self, "    if (ag_tp_rank != 0) { __p_tp_send(0, 1, pt); return (void*)__p_tp_recv(0, 2); }");
    wln(self, "    PTensor* sum = ag_clone_tensor(pt);");
    wln(self, "    for (int r = 1; r < n; r++) {");
    wln(self, "        PTensor* part = __p_tp_recv(r, 1);");
    wln(self, "        if (!__p_tp_same_shape(sum, part, 0)) __p_tp_fail(\"all_reduce\", r, \"sent a tensor of another shape\");");
    wln(self, "        for (int64_t i = 0; i < sum->len; i++) sum->data[i] += part->data[i];");
    wln(self, "        __p_tp_free(part);");
    wln(self, "    }");
    wln(self, "    for (int r = 1; r < n; r++) __p_tp_send(r, 2, sum);");
    wln(self, "    return (void*)sum;");
    wln(self, "}");
    wln(self, "// Rank 0's tensor, on every rank.");
    wln(self, "void* p_broadcast(void* t) {");
    wln(self, "    PTensor* pt = (PTensor*)t; if (!pt) return NULL;");
    wln(self, "    int n = ag_tp_world_size;");
    wln(self, "    if (n <= 1) return (void*)ag_clone_tensor(pt);");
    wln(self, "    if (ag_tp_rank != 0) return (void*)__p_tp_recv(0, 3);");
    wln(self, "    for (int r = 1; r < n; r++) __p_tp_send(r, 3, pt);");
    wln(self, "    return (void*)ag_clone_tensor(pt);");
    wln(self, "}");
    wln(self, "// Every rank's tensor joined along dimension 0, in rank order.");
    wln(self, "void* p_all_gather(void* t) {");
    wln(self, "    PTensor* pt = (PTensor*)t; if (!pt) return NULL;");
    wln(self, "    int n = ag_tp_world_size;");
    wln(self, "    if (n <= 1) return (void*)ag_clone_tensor(pt);");
    wln(self, "    if (ag_tp_rank != 0) { __p_tp_send(0, 4, pt); return (void*)__p_tp_recv(0, 5); }");
    wln(self, "    PTensor** parts = (PTensor**)malloc(sizeof(PTensor*) * (size_t)n);");
    wln(self, "    parts[0] = pt;");
    wln(self, "    int64_t total = pt->len, rows = pt->ndim > 0 ? pt->shape[0] : 1;");
    wln(self, "    for (int r = 1; r < n; r++) {");
    wln(self, "        parts[r] = __p_tp_recv(r, 4);");
    wln(self, "        PTensor* q = parts[r];");
    wln(self, "        int same = q->ndim == pt->ndim;");
    wln(self, "        for (int64_t i = 1; same && i < pt->ndim && i < 8; i++) if (q->shape[i] != pt->shape[i]) same = 0;");
    wln(self, "        if (!same) __p_tp_fail(\"all_gather\", r, \"sent a tensor whose shape differs past dimension 0\");");
    wln(self, "        total += q->len; rows += q->ndim > 0 ? q->shape[0] : 1;");
    wln(self, "    }");
    wln(self, "    PTensor* g = (PTensor*)malloc(sizeof(PTensor));");
    wln(self, "    g->ndim = pt->ndim > 0 ? pt->ndim : 1; g->len = total;");
    wln(self, "    for (int i = 0; i < 8; i++) g->shape[i] = (pt->ndim > 0 && i < pt->ndim) ? pt->shape[i] : 0;");
    wln(self, "    g->shape[0] = rows;");
    wln(self, "    g->data = (double*)malloc((total > 0 ? total : 1) * sizeof(double));");
    wln(self, "    int64_t at = 0;");
    wln(self, "    for (int r = 0; r < n; r++) {");
    wln(self, "        for (int64_t i = 0; i < parts[r]->len; i++) g->data[at + i] = parts[r]->data[i];");
    wln(self, "        at += parts[r]->len;");
    wln(self, "        if (r > 0) __p_tp_free(parts[r]);");
    wln(self, "    }");
    wln(self, "    free(parts);");
    wln(self, "    for (int r = 1; r < n; r++) __p_tp_send(r, 5, g);");
    wln(self, "    return (void*)g;");
    wln(self, "}");
    wln(self, "// Rank 0's tensor cut along dimension 0: rank r gets the r-th share of the");
    wln(self, "// rows (the first rows % n ranks one row more).");
    wln(self, "void* p_scatter(void* t) {");
    wln(self, "    PTensor* pt = (PTensor*)t; if (!pt) return NULL;");
    wln(self, "    int n = ag_tp_world_size;");
    wln(self, "    if (n <= 1) return (void*)ag_clone_tensor(pt);");
    wln(self, "    if (ag_tp_rank != 0) return (void*)__p_tp_recv(0, 6);");
    wln(self, "    if (pt->ndim < 1) p_panic(\"scatter: the tensor needs at least one dimension\");");
    wln(self, "    int64_t rows = pt->shape[0], row_len = rows > 0 ? pt->len / rows : 0;");
    wln(self, "    PTensor* mine = NULL;");
    wln(self, "    int64_t start = 0;");
    wln(self, "    for (int r = 0; r < n; r++) {");
    wln(self, "        int64_t cnt = rows / n + (r < rows % n ? 1 : 0);");
    wln(self, "        PTensor* s = (PTensor*)malloc(sizeof(PTensor));");
    wln(self, "        s->ndim = pt->ndim; s->len = cnt * row_len;");
    wln(self, "        for (int i = 0; i < 8; i++) s->shape[i] = pt->shape[i];");
    wln(self, "        s->shape[0] = cnt;");
    wln(self, "        s->data = (double*)malloc((s->len > 0 ? s->len : 1) * sizeof(double));");
    wln(self, "        for (int64_t i = 0; i < s->len; i++) s->data[i] = pt->data[start * row_len + i];");
    wln(self, "        start += cnt;");
    wln(self, "        if (r == 0) mine = s; else { __p_tp_send(r, 6, s); __p_tp_free(s); }");
    wln(self, "    }");
    wln(self, "    return (void*)mine;");
    wln(self, "}");
    wln(self, "// Point to point along the ring: to rank + 1, from rank - 1.");
    wln(self, "void p_send_tensor(void* t) {");
    wln(self, "    PTensor* pt = (PTensor*)t;");
    wln(self, "    if (!pt || ag_tp_world_size <= 1) return;");
    wln(self, "    __p_tp_send((int)((ag_tp_rank + 1) % ag_tp_world_size), 7, pt);");
    wln(self, "}");
    wln(self, "void* p_recv_tensor(void* shape_vec) {");
    wln(self, "    int64_t* sv = (int64_t*)shape_vec;");
    wln(self, "    int64_t ndim = sv ? sv[1] : 0;");
    wln(self, "    int64_t* data_ptr = sv ? (int64_t*)sv[0] : NULL;");
    wln(self, "    int64_t shape[8]; int64_t len = 1;");
    wln(self, "    for (int64_t i = 0; i < ndim && i < 8; i++) { shape[i] = data_ptr ? data_ptr[i] : 1; len *= shape[i]; }");
    wln(self, "    if (ag_tp_world_size > 1) {");
    wln(self, "        int from = (int)((ag_tp_rank + ag_tp_world_size - 1) % ag_tp_world_size);");
    wln(self, "        PTensor* got = __p_tp_recv(from, 7);");
    wln(self, "        int same = got->ndim == ndim;");
    wln(self, "        for (int64_t i = 0; same && i < ndim && i < 8; i++) if (got->shape[i] != shape[i]) same = 0;");
    wln(self, "        if (!same) __p_tp_fail(\"recv_tensor\", from, \"sent a tensor of another shape than the one asked for\");");
    wln(self, "        return got;");
    wln(self, "    }");
}

fn emit_main_wrapper(self: &mut CCodeGen, module: IrModule) -> void {
    // CI7: a library has no C main; fides_init does main's setup
    if g_c_lib {
        cg_lib_emit(self, module);
        return;
    }
    if has_main(module) {
        wln(self, "// --- C entry point ---");
        // Crash and stack overflow handlers: __p_install_crash_handlers
        wln(self, "#ifdef _WIN32");
        wln(self, "#include <windows.h>");
        wln(self, "#endif");
        wln(self, "void __p_install_crash_handlers(void);");
        wln(self, "void __p_limits_init(void);");
        // roadmap P6: ranks of tensor parallelism (cg_emit_tp_runtime)
        wln(self, "void __p_tp_boot(void);");
        wln(self, "int64_t __p_tp_finish(int64_t result);");
        // DB9: FID_PROF (emit_prof_api_runtime)
        wln(self, "void __p_sp_boot(void);");
        wln(self, "#ifdef P_PROFILE");
        wln(self, "void __p_profile_start(void);");
        wln(self, "#endif");
        cg_emit_wasi_thunks(self, module);
        wln(self, "int main(int argc, char** argv) {");
        wln(self, "    __p_install_crash_handlers();");
        // roadmap P12: FID_MEM_LIMIT / FID_CPU_LIMIT
        wln(self, "    __p_limits_init();");
        wln(self, "#ifdef P_PROFILE");
        wln(self, "    __p_profile_start();");
        wln(self, "#endif");
        wln(self, "    setvbuf(stdout, NULL, _IONBF, 0);");
        wln(self, "    setvbuf(stderr, NULL, _IONBF, 0);");
        // Windows: binary stdout/stderr, so a newline is not written as CR LF
        // (output then matches the interpreter and Rust-built programs).
        wln(self, "#ifdef _WIN32");
        wln(self, "    _setmode(_fileno(stdout), _O_BINARY);");
        wln(self, "    _setmode(_fileno(stderr), _O_BINARY);");
        wln(self, "#endif");
        wln(self, "    __p_argc = argc; __p_argv = argv;");
        // roadmap P6: a rank started by rank 0 takes its pipes; FID_TP_WORLD=n
        // starts the ranks here
        wln(self, "    __p_tp_boot();");
        cg_emit_registrations(self, module);
        wln(self, "    __init_globals();");
        // DB9: FID_PROF set: sampled from here to exit
        wln(self, "    __p_sp_boot();");
        wln(self, "    int64_t result = main_entry(NULL);");
        // rank 0 waits for the other ranks (a failed rank fails the run)
        wln(self, "    result = __p_tp_finish(result);");
        wln(self, "    return (int)result;");
        wln(self, "}");
        wln(self, "");
    }
}

// --- A9': the functions a run can reach -----------------------------------

/// Whether a lookup by name (p_thread_spawn, p_executor_spawn, p_co_go,
/// p_co_pool_call) can ask for `name`: the program holds it as a string
/// constant or a function reference (emit_string_consts collected both),
/// or it is a library export. A name built at run time is not seen:
/// set_c_register_all(true) registers everything, as before.
fn cg_named_by_program(self: &CCodeGen, name: str) -> bool {
    if g_c_register_all {
        return true;
    }
    if string_consts_contains(self, name) {
        return true;
    }
    return g_c_lib && g_c_lib_exports != 0 && HashMap_contains(g_c_lib_exports, name);
}

/// A function the C runtime or the generated C calls by name without an IR
/// call (printing a Vec or map, string counts, global initializers).
fn cg_runtime_root(name: str) -> bool {
    return name == "Vec_to_str" || name == "HashMap_to_str" || name == "Str_dup" || name == "Str_drop" || name == "Vec_new" || name == "HashMap_new" || name == "Vec_push" || name == "Vec_get" || name == "Vec_set" || name == "Vec_len" || name == "Vec_pop" || name == "Vec_is_empty" || name == "Vec_filled_typed";
}

/// Whether `name` is listed in __p_fns.
fn cg_is_live(name: str) -> bool {
    if g_c_register_all || g_cg_live == 0 {
        return true;
    }
    return HashMap_contains(g_cg_live, name);
}

fn cg_live_push(pos: i64, work: &mut Vec<i64>, name: str) {
    if HashMap_contains(g_cg_live, name) {
        return;
    }
    var at: i64 = HashMap_get(pos, name);
    if at == 0 {
        return;
    }
    HashMap_insert(g_cg_live, name, 1);
    work.push(at - 1);
}

/// g_cg_live: what is reachable from main (everything, in a module without
/// one), the functions named by strings or function references, C
/// callbacks, library exports and cg_runtime_root, through calls, function
/// references, strings naming functions, and dynamic calls (every
/// `<Type>_<method>`, as gen_inst's DynCall dispatch takes).
fn cg_compute_live(self: &CCodeGen, module: IrModule) {
    if g_cg_live == 0 {
        g_cg_live = HashMap_new();
    } else {
        HashMap_clear(g_cg_live);
    }
    var pos: i64 = HashMap_new();
    var work: Vec<i64> = Vec::new();
    var main_found: bool = false;
    var f: i64 = 0;
    while f < module.functions.len() {
        var nm: str = module.functions.get(f).name;
        if HashMap_get(pos, nm) == 0 {
            HashMap_insert(pos, nm, f + 1);
        }
        if nm == "main" {
            main_found = true;
        }
        f = f + 1;
    }
    f = 0;
    while f < module.functions.len() {
        var rn: str = module.functions.get(f).name;
        if !main_found || rn == "main" || cg_runtime_root(rn) || cg_named_by_program(self, rn) {
            cg_live_push(pos, &mut work, rn);
        }
        f = f + 1;
    }
    var cb: i64 = 0;
    while cb < module.c_callbacks.len() {
        cg_live_push(pos, &mut work, module.c_callbacks.get(cb));
        cb = cb + 1;
    }
    var dyn_done: i64 = HashMap_new();
    while work.len() > 0 {
        var at: i64 = work.get(work.len() - 1);
        work.pop();
        var func: IrFunction = module.functions.get(at).func;
        var k: i64 = 0;
        while k < func.insts.len() {
            var vi: ValueIdInst = func.insts.get(k);
            match vi.inst {
                Inst::Call(cn, _, _, _) => {
                    cg_live_push(pos, &mut work, cn);
                }
                Inst::ConstFnRef(rn) => {
                    cg_live_push(pos, &mut work, c_fn_target(rn));
                }
                Inst::ConstStr(sv) => {
                    if str_len(sv) > 0 && str_len(sv) < 256 {
                        cg_live_push(pos, &mut work, sv);
                    }
                }
                Inst::DynCall(_, method, _, _, _) => {
                    if HashMap_get(dyn_done, method) == 0 {
                        HashMap_insert(dyn_done, method, 1);
                        var suffix: str = "_" + method;
                        var di: i64 = 0;
                        while di < module.functions.len() {
                            var dn: str = module.functions.get(di).name;
                            if str_ends_with(dn, suffix) {
                                cg_live_push(pos, &mut work, dn);
                            }
                            di = di + 1;
                        }
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
    }
    HashMap_drop(dyn_done);
    HashMap_drop(pos);
}

/// The p_thread_register calls of C main / fides_init: only the functions a
/// name lookup can ask for (A9'), so no other function's address is taken.
fn cg_emit_registrations(self: &mut CCodeGen, module: IrModule) {
    wln(self, "    // Register the functions p_thread_spawn and the task pools look up by name");
    var f: i64 = 0;
    while f < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(f);
        if entry.name != "main" && !is_internal_function(entry.name) && cg_named_by_program(self, entry.name) {
            var c_name: str = sanitize_c_name(self, entry.name);
            if cg_thunk_native(entry.func) {
                // BG133: the thunk on every target (floats, narrow results)
                wln(self, "    p_thread_register(\"" + entry.name + "\", (int64_t(*)())__p_wt_" + c_name + ");");
            } else if cg_wasi_thunk_ok(entry.func) {
                // F9: on wasm32 the thunk of cg_emit_wasi_thunks, whose type
                // is the one the runtime calls it with
                wln(self, "#ifdef __wasi__");
                wln(self, "    p_thread_register(\"" + entry.name + "\", (int64_t(*)())__p_wt_" + c_name + ");");
                wln(self, "#else");
                wln(self, "    p_thread_register(\"" + entry.name + "\", (int64_t(*)())" + c_name + ");");
                wln(self, "#endif");
            } else {
                wln(self, "    p_thread_register(\"" + entry.name + "\", (int64_t(*)())" + c_name + ");");
            }
        }
        f = f + 1;
    }
}

/// BG133: argument `base` (of type `arg_ty`) of a call by name
/// (p_thread_spawn, p_executor_spawn, p_co_async) as the word the runtime
/// reads with va_arg(int64_t), by the type of parameter `pidx` of the
/// function named by value `name_id` (the argument's own type when the name
/// is not a constant: an f64 literal passed to an f32 parameter is still
/// f64): an f64/f32 as its bits, a bool or narrow integer widened; any
/// other type keeps `cast`.
fn cg_spawn_word_arg(self: &CCodeGen, func: IrFunction, name_id: i64, pidx: i64, cast: str, base: str, arg_ty: IrType) -> str {
    var ty: IrType = arg_ty;
    match IrFunction_get_inst(&func, name_id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::ConstStr(callee) => {
                    match fn_param_types_get(self, callee) {
                        OptVecIrType::Some(pts) => {
                            if pidx >= 1 && pidx < pts.len() {
                                ty = pts.get(pidx);
                            }
                        }
                        OptVecIrType::None => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    match ty {
        IrType::F64 => {
            return "((union { double d; int64_t i; }){ .d = (double)(" + base + ") }).i";
        }
        IrType::F32 => {
            return "(int64_t)((union { float f; int32_t i; }){ .f = (float)(" + base + ") }).i";
        }
        IrType::Bool => {
            return "(int64_t)" + base;
        }
        IrType::I8 => {
            return "(int64_t)" + base;
        }
        IrType::I16 => {
            return "(int64_t)" + base;
        }
        IrType::I32 => {
            return "(int64_t)" + base;
        }
        IrType::U8 => {
            return "(int64_t)" + base;
        }
        IrType::U16 => {
            return "(int64_t)" + base;
        }
        IrType::U32 => {
            return "(int64_t)" + base;
        }
        _ => {
            return cast;
        }
    }
}

/// BG133: whether the runtime calls function `func` through its thunk
/// (cg_emit_wasi_thunks) on every target, not only on wasm32. The runtime
/// calls a function it looks up by name as int64_t (*)(void*, int64_t, ...)
/// and takes its result from the integer register: an f64/f32 parameter
/// would be read from a float register (the word holds its bits), an f64/f32
/// result is in a float register, and a bool or narrow integer result leaves
/// the register's upper bits unset. The thunk converts both ways.
fn cg_thunk_native(func: IrFunction) -> bool {
    if !cg_wasi_thunk_ok(func) {
        return false;
    }
    var p: i64 = 1;
    while p < func.params.len() {
        var pc: str = c_type(func.params.get(p).ty);
        if pc == "double" || pc == "float" {
            return true;
        }
        p = p + 1;
    }
    var rc: str = c_ret_type(func.ret_ty);
    return rc == "double" || rc == "float" || rc == "bool" || rc == "int32_t" || rc == "int16_t" || rc == "int8_t" || rc == "uint32_t" || rc == "uint16_t" || rc == "uint8_t";
}

/// F9: whether function `func` gets a thunk on wasm32 (cg_emit_wasi_thunks):
/// a result in a register (not through the out-parameter) and at most 8
/// arguments after the environment, none of them a fixed-size array
fn cg_wasi_thunk_ok(func: IrFunction) -> bool {
    if is_aggregate_ret(func.ret_ty) || func.params.len() > 9 {
        return false;
    }
    var p: i64 = 0;
    while p < func.params.len() {
        match func.params.get(p).ty {
            IrType::Array(_, _) => {
                return false;
            }
            _ => {
            }
        }
        p = p + 1;
    }
    return true;
}

/// F9: the runtime calls a function it looks up by name (a task's, a
/// thread's, a pool call's: p_thread_entries) as int64_t (*)(void*,
/// int64_t, ...), the environment then one word per argument. Where a
/// pointer is 64 bits that is how any Fides function is called, but
/// WebAssembly checks a call's type against the function's: on wasm32 a
/// pointer is an i32, so a function taking a str, a Vec or a struct, or
/// returning one, trapped ("null function or function signature
/// mismatch", test_spawn_vec_copy). Under __wasi__ each such function
/// gets a thunk of exactly that type that converts the words (an f64 is
/// its bits) and the result back to a word; the registrations
/// (cg_emit_registrations) name the thunk there.
/// BG133: pass 0 writes, for every target, the thunks of the functions
/// cg_thunk_native picks; pass 1 the others, under __wasi__ only.
fn cg_emit_wasi_thunks(self: &mut CCodeGen, module: IrModule) {
    var pass: i64 = 0;
    while pass < 2 {
        if pass == 1 {
            wln(self, "#ifdef __wasi__");
        }
        cg_emit_thunks_pass(self, module, pass == 0);
        if pass == 1 {
            wln(self, "#endif");
        }
        pass = pass + 1;
    }
}

fn cg_emit_thunks_pass(self: &mut CCodeGen, module: IrModule, native: bool) {
    var f: i64 = 0;
    while f < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(f);
        if entry.name != "main" && !is_internal_function(entry.name) && cg_named_by_program(self, entry.name) && cg_wasi_thunk_ok(entry.func) && cg_thunk_native(entry.func) == native {
            var c_name: str = sanitize_c_name(self, entry.name);
            var params: str = "void* e";
            var args: str = "";
            var p: i64 = 0;
            while p < entry.func.params.len() {
                var pty: IrType = entry.func.params.get(p).ty;
                var pc: str = c_type(pty);
                var word: str = "a" + int_to_str(p);
                if p == 0 {
                    // the environment, as the runtime passes it (NULL)
                    word = "(int64_t)(intptr_t)e";
                } else {
                    params = params + ", int64_t a" + int_to_str(p);
                }
                if p > 0 {
                    args = args + ", ";
                }
                var conv: str = "(" + pc + ")" + word;
                match pty {
                    IrType::F64 => {
                        conv = "((union { int64_t i; double d; }){ .i = " + word + " }).d";
                    }
                    IrType::F32 => {
                        conv = "((union { int32_t i; float f; }){ .i = (int32_t)" + word + " }).f";
                    }
                    IrType::Bool => {
                        conv = "(bool)(" + word + " != 0)";
                    }
                    _ => {
                        if str_ends_with(pc, "*") {
                            conv = "(" + pc + ")(intptr_t)" + word;
                            if p == 0 {
                                conv = "(" + pc + ")e";
                            }
                        }
                    }
                }
                args = args + conv;
                p = p + 1;
            }
            var call: str = c_name + "(" + args + ")";
            var rc: str = c_ret_type(entry.func.ret_ty);
            var body: str = "return (int64_t)" + call + ";";
            if rc == "void" {
                body = call + "; return 0;";
            } else if rc == "double" {
                body = "return ((union { double d; int64_t i; }){ .d = " + call + " }).i;";
            } else if rc == "float" {
                body = "return (int64_t)((union { float f; int32_t i; }){ .f = " + call + " }).i;";
            } else if str_ends_with(rc, "*") {
                body = "return (int64_t)(intptr_t)" + call + ";";
            }
            wln(self, "static int64_t __p_wt_" + c_name + "(" + params + ") { " + body + " }");
        }
        f = f + 1;
    }
}

// --- CI7: library builds; CI6: the embedding API -----------------------------

/// The exports of `module`: functions marked `@export` (lower.fd collects
/// them in ir.fd's g_ir_exports) or named by CGen_lib_export. A name whose
/// C form would differ (a C keyword, a C library function) is left out.
fn cg_lib_collect(self: &CCodeGen, module: IrModule) {
    if g_c_lib_exports == 0 {
        g_c_lib_exports = HashMap_new();
    } else {
        HashMap_clear(g_c_lib_exports);
    }
    g_c_lib_skipped = "";
    var f: i64 = 0;
    while f < module.functions.len() {
        var nm: str = module.functions.get(f).name;
        var key: str = "," + nm + ",";
        if nm != "main" && (str_contains(g_ir_exports, key) || str_contains(g_c_lib_extra, key)) {
            if sanitize_c_name(self, nm) == nm {
                HashMap_insert(g_c_lib_exports, nm, 1);
            } else {
                g_c_lib_skipped = g_c_lib_skipped + nm + ": its name is taken in C\n";
            }
        }
        f = f + 1;
    }
}

/// The C type of a value of `ty` in the library's header ("" = none: an
/// array by value).
fn cg_lib_h_type(ty: IrType) -> str {
    match ty {
        IrType::Ptr(inner) => {
            match cc_box_ir_type_unbox(inner) {
                IrType::U8 => {
                    return "const char*";
                }
                _ => {
                    return "void*";
                }
            }
        }
        IrType::Array(_, _) => {
            return "";
        }
        IrType::Never => {
            return "void";
        }
        IrType::Struct(_) => {
            return "void*";
        }
        _ => {
        }
    }
    var ct: str = c_type(ty);
    if str_ends_with(ct, "*") {
        return "void*";
    }
    return ct;
}

/// How a value of C type `ct` goes into / comes out of an int64_t word
/// (fides_call's arguments and result): 0 integer or bool, 1 pointer,
/// 2 double, 3 float.
fn cg_lib_word_kind(ct: str) -> i64 {
    if str_ends_with(ct, "*") {
        return 1;
    }
    if ct == "double" {
        return 2;
    }
    if ct == "float" {
        return 3;
    }
    return 0;
}

fn cg_lib_from_word(ct: str, w: str) -> str {
    var k: i64 = cg_lib_word_kind(ct);
    if k == 1 {
        return "(" + ct + ")(intptr_t)" + w;
    }
    if k == 2 {
        return "__p_lib_w2d(" + w + ")";
    }
    if k == 3 {
        return "(float)__p_lib_w2d(" + w + ")";
    }
    return "(" + ct + ")" + w;
}

fn cg_lib_to_word(ct: str, v: str) -> str {
    var k: i64 = cg_lib_word_kind(ct);
    if k == 1 {
        return "(int64_t)(intptr_t)(" + v + ")";
    }
    if k == 2 || k == 3 {
        return "__p_lib_d2w((double)(" + v + "))";
    }
    return "(int64_t)(" + v + ")";
}

fn cg_c_keyword(s: str) -> bool {
    return s == "auto" || s == "break" || s == "case" || s == "char" || s == "const" || s == "continue" || s == "default" || s == "do" || s == "double" || s == "else" || s == "enum" || s == "extern" || s == "float" || s == "for" || s == "goto" || s == "if" || s == "inline" || s == "int" || s == "long" || s == "register" || s == "restrict" || s == "return" || s == "short" || s == "signed" || s == "sizeof" || s == "static" || s == "struct" || s == "switch" || s == "typedef" || s == "union" || s == "unsigned" || s == "void" || s == "volatile" || s == "while" || s == "bool" || s == "true" || s == "false";
}

/// The name of parameter `id` of `func` (its binding), or `a<k>`.
fn cg_lib_param_name(func: IrFunction, id: i64, k: i64) -> str {
    var i: i64 = 0;
    while i < func.locals.len() {
        var lv: StringValueId = func.locals.get(i);
        if lv.id == id && str_len(lv.name) > 0 && !str_starts_with(lv.name, "__") && !cg_c_keyword(lv.name) {
            return lv.name;
        }
        i = i + 1;
    }
    return "a" + int_to_str(k);
}

/// CI7, CI6: in place of C main, fides_init (main's setup), a wrapper with
/// the C name of each export, and fides_call, which runs an export by name
/// with a capability mask and returns an error code on a panic. Fills
/// g_c_lib_header with the declarations.
fn cg_lib_emit(self: &mut CCodeGen, module: IrModule) {
    var h: Vec<str> = Vec::new();
    h.push("/* Generated by fid ccompile --lib: the C API of a Fides library. */");
    h.push("#include <stdint.h>");
    h.push("#include <stdbool.h>");
    h.push("#ifdef __cplusplus");
    h.push("extern \"C\" {");
    h.push("#endif");
    h.push("#ifndef FIDES_API");
    h.push("#if defined(_WIN32) && !defined(FIDES_STATIC)");
    h.push("#define FIDES_API __declspec(dllimport)");
    h.push("#else");
    h.push("#define FIDES_API");
    h.push("#endif");
    h.push("#endif");
    h.push("/* fides_call's capabilities: what the called code may reach. Without");
    h.push("   one, the operation fails as it would on a missing file or host. */");
    h.push("#define FIDES_CAP_FS 1ULL");
    h.push("#define FIDES_CAP_NET 2ULL");
    h.push("#define FIDES_CAP_PROC 4ULL");
    h.push("#define FIDES_CAP_ENV 8ULL");
    h.push("#define FIDES_CAP_NONE 0ULL");
    h.push("#define FIDES_CAP_ALL (~0ULL)");
    h.push("/* fides_call's results */");
    h.push("#define FIDES_OK 0");
    h.push("#define FIDES_E_NO_FUNCTION 1");
    h.push("#define FIDES_E_ARGS 2");
    h.push("#define FIDES_E_PANIC 3");
    h.push("/* Sets up the library (its globals); every entry point calls it. */");
    h.push("FIDES_API int fides_init(void);");
    h.push("/* Runs export `name` with `nargs` arguments, each one word (an integer,");
    h.push("   a pointer or a double's bits), with only the capabilities in `caps`;");
    h.push("   the result goes to *result. A panic returns FIDES_E_PANIC and");
    h.push("   fides_last_error() says why. A string a call returns is freed with");
    h.push("   fides_str_free. */");
    h.push("FIDES_API int fides_call(const char* name, uint64_t caps, int64_t nargs, const int64_t* args, int64_t* result);");
    h.push("FIDES_API const char* fides_last_error(void);");
    h.push("FIDES_API void fides_str_free(const char* s);");
    h.push("/* The exports (called directly: every capability; a panic ends the process) */");

    wln(self, "// --- Library entry points (CI7) and the embedding API (CI6) ---");
    wln(self, "#include <setjmp.h>");
    wln(self, "#if defined(_WIN32)");
    wln(self, "#define P_EXPORT __declspec(dllexport)");
    wln(self, "#else");
    wln(self, "#define P_EXPORT __attribute__((visibility(\"default\")))");
    wln(self, "#endif");
    wln(self, "static P_THREAD_LOCAL jmp_buf* __p_embed_jb = NULL;");
    // CE8 (-g): a call keeps the frame record current when it began and
    // makes it current again when it returns, also through the longjmp of
    // a panic (the callee's record is on a stack that is gone)
    wln(self, "#ifdef P_DEBUG_FRAMES");
    wln(self, "#define P_DBG_EMBED_SAVE __p_dbg_frame* volatile __p_dbg_saved = __p_dbg_cur");
    wln(self, "#define P_DBG_EMBED_RESTORE (__p_dbg_cur = __p_dbg_saved)");
    wln(self, "#else");
    wln(self, "#define P_DBG_EMBED_SAVE int __p_dbg_saved = 0");
    wln(self, "#define P_DBG_EMBED_RESTORE ((void)__p_dbg_saved)");
    wln(self, "#endif");
    wln(self, "static P_THREAD_LOCAL char __p_embed_err[256];");
    wln(self, "static int __p_lib_ready = 0;");
    wln(self, "static double __p_lib_w2d(int64_t w) { double d; memcpy(&d, &w, sizeof d); return d; }");
    wln(self, "static int64_t __p_lib_d2w(double d) { int64_t w; memcpy(&w, &d, sizeof w); return w; }");
    cg_emit_wasi_thunks(self, module);
    wln(self, "P_EXPORT int fides_init(void) {");
    wln(self, "    if (__p_lib_ready) return 0;");
    wln(self, "    __p_lib_ready = 1;");
    cg_emit_registrations(self, module);
    wln(self, "    __init_globals();");
    wln(self, "    return 0;");
    wln(self, "}");

    var table: Vec<str> = Vec::new();
    var f: i64 = 0;
    while f < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(f);
        f = f + 1;
        if !HashMap_contains(g_c_lib_exports, entry.name) {
            continue;
        }
        var func: IrFunction = entry.func;
        var hret: str = cg_lib_h_type(func.ret_ty);
        var ok: bool = str_len(hret) > 0 && !is_aggregate_ret(func.ret_ty);
        var hparams: str = "";
        var wparams: str = "";
        var call_args: str = "NULL";
        var word_args: str = "NULL";
        var p: i64 = 1;
        while p < func.params.len() {
            var pty: IrType = func.params.get(p).ty;
            var ht: str = cg_lib_h_type(pty);
            if str_len(ht) == 0 {
                ok = false;
            }
            var pname: str = cg_lib_param_name(func, func.params.get(p).id, p - 1);
            var an: str = "a" + int_to_str(p - 1);
            if p > 1 {
                hparams = hparams + ", ";
                wparams = wparams + ", ";
            }
            hparams = hparams + ht + " " + pname;
            wparams = wparams + ht + " " + an;
            call_args = call_args + ", (" + c_type(pty) + ")" + an;
            word_args = word_args + ", (" + c_type(pty) + ")" + cg_lib_from_word(ht, "w[" + int_to_str(p - 1) + "]");
            p = p + 1;
        }
        if !ok {
            g_c_lib_skipped = g_c_lib_skipped + entry.name + ": a struct or array by value has no C form here\n";
            continue;
        }
        if str_len(hparams) == 0 {
            hparams = "void";
            wparams = "void";
        }
        var nparams: i64 = func.params.len() - 1;
        var internal: str = sanitize_c_name(self, entry.name);
        h.push("FIDES_API " + hret + " " + entry.name + "(" + hparams + ");");
        if hret == "void" {
            wln(self, "P_EXPORT void " + entry.name + "(" + wparams + ") { fides_init(); " + internal + "(" + call_args + "); }");
            wln(self, "static int64_t __p_lib_call_" + entry.name + "(const int64_t* w) { (void)w; " + internal + "(" + word_args + "); return 0; }");
        } else {
            wln(self, "P_EXPORT " + hret + " " + entry.name + "(" + wparams + ") { fides_init(); return (" + hret + ")" + internal + "(" + call_args + "); }");
            wln(self, "static int64_t __p_lib_call_" + entry.name + "(const int64_t* w) { (void)w; return " + cg_lib_to_word(hret, internal + "(" + word_args + ")") + "; }");
        }
        table.push("    { \"" + entry.name + "\", " + int_to_str(nparams) + ", __p_lib_call_" + entry.name + " },");
    }
    wln(self, "typedef struct { const char* name; int64_t nargs; int64_t (*call)(const int64_t*); } __p_lib_fn_t;");
    wln(self, "static const __p_lib_fn_t __p_lib_fns[] = {");
    var ti: i64 = 0;
    while ti < table.len() {
        wln(self, table.get(ti));
        ti = ti + 1;
    }
    wln(self, "    { NULL, 0, NULL }");
    wln(self, "};");
    wln(self, "P_EXPORT const char* fides_last_error(void) { return __p_embed_err; }");
    // a string a call returned: one owner fewer (core's count)
    wln(self, "P_EXPORT void fides_str_free(const char* s) { P_STR_DROP((int64_t)(intptr_t)s); }");
    wln(self, "P_EXPORT int fides_call(const char* name, uint64_t caps, int64_t nargs, const int64_t* args, int64_t* result) {");
    wln(self, "    fides_init();");
    wln(self, "    __p_embed_err[0] = 0;");
    wln(self, "    if (result) *result = 0;");
    wln(self, "    const __p_lib_fn_t* fn = NULL;");
    wln(self, "    for (int i = 0; name && __p_lib_fns[i].name; i++) if (strcmp(__p_lib_fns[i].name, name) == 0) { fn = &__p_lib_fns[i]; break; }");
    wln(self, "    if (!fn) { snprintf(__p_embed_err, sizeof __p_embed_err, \"no exported function '%s'\", name ? name : \"\"); return 1; }");
    wln(self, "    if (nargs != fn->nargs || (nargs > 0 && !args)) { snprintf(__p_embed_err, sizeof __p_embed_err, \"'%s' takes %lld arguments\", name, (long long)fn->nargs); return 2; }");
    wln(self, "    jmp_buf jb;");
    wln(self, "    jmp_buf* volatile saved = __p_embed_jb;");
    wln(self, "    volatile uint64_t saved_caps = __p_caps;");
    wln(self, "    P_DBG_EMBED_SAVE;");
    // a panic leaves the regions the call opened (proposal 0005)
    wln(self, "    volatile int64_t saved_live = __p_rs.live, saved_mode = __p_rs.mode;");
    // CI6: this call's number for the blocks it allocates (P_EL_*: a panic
    // frees those still allocated, of this call and the calls inside it)
    wln(self, "    P_EL_SAVE;");
    wln(self, "    if (setjmp(jb) != 0) { P_DBG_EMBED_RESTORE; __p_embed_jb = saved; __p_caps = saved_caps; while (__p_rs.live > saved_live) __p_region_pop(); __p_rs.mode = saved_mode; P_EL_PANIC; return 3; }");
    wln(self, "    __p_embed_jb = &jb;");
    // a nested call can only narrow what its caller may do
    wln(self, "    __p_caps = saved_caps & caps;");
    wln(self, "    P_EL_BEGIN;");
    wln(self, "    int64_t r = fn->call(args);");
    wln(self, "    __p_embed_jb = saved;");
    wln(self, "    __p_caps = saved_caps;");
    wln(self, "    P_EL_DONE;");
    wln(self, "    P_DBG_EMBED_RESTORE;");
    wln(self, "    if (result) *result = r;");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "");
    h.push("#ifdef __cplusplus");
    h.push("}");
    h.push("#endif");
    g_c_lib_header = str_join(h, "\n") + "\n";
}

fn has_main(module: IrModule) -> bool {
    var f: i64 = 0;
    while f < module.functions.len() {
        if module.functions.get(f).name == "main" {
            return true;
        }
        f = f + 1;
    }
    return false;
}

fn is_internal_function(name: str) -> bool {
    if str_starts_with(name, "p_") {
        return true;
    }
    if str_starts_with(name, "box_") {
        return true;
    }
    if str_starts_with(name, "type_") {
        return true;
    }
    if str_starts_with(name, "stmt_") {
        return true;
    }
    if str_starts_with(name, "expr_") {
        return true;
    }
    if str_starts_with(name, "opt_") {
        return true;
    }
    if str_starts_with(name, "str_") {
        return true;
    }
    if str_starts_with(name, "int_") {
        return true;
    }
    if str_starts_with(name, "char_") {
        return true;
    }
    if str_starts_with(name, "map_") {
        return true;
    }
    if str_starts_with(name, "vec_") {
        return true;
    }
    if str_starts_with(name, "c_") {
        return true;
    }
    return false;
}

// --- Value / name helpers -------------------------------------------------

fn value_names_get(self: &CCodeGen, id: i64) -> OptStr {
    if id >= 0 && id < self.value_names.len() {
        var name: str = self.value_names.get(id);
        if name != "" {
            return OptStr::Some(name);
        }
    }
    return OptStr::None;
}

fn val_name(self: &CCodeGen, id: i64) -> str {
    match value_names_get(self, id) {
        OptStr::Some(name) => {
            return name;
        }
        OptStr::None => {
            return "v" + int_to_str(id);
        }
    }
}

fn lookup_field_offset(self: &CCodeGen, struct_name: str, field_index: i64, default_offset: i64) -> i64 {
    var at: i64 = HashMap_get(self.layout_index, struct_name) - 1;
    if at >= 0 && at < self.struct_layouts.len() && self.struct_layouts.get(at).name == struct_name {
        var lay: StructLayout = self.struct_layouts.get(at).layout;
        if field_index < lay.fields.len() {
            return lay.fields.get(field_index).offset;
        }
        return default_offset;
    }
    var i: i64 = 0;
    while i < self.struct_layouts.len() {
        if self.struct_layouts.get(i).name == struct_name {
            var layout: StructLayout = self.struct_layouts.get(i).layout;
            if field_index < layout.fields.len() {
                return layout.fields.get(field_index).offset;
            }
            return default_offset;
        }
        i = i + 1;
    }
    return default_offset;
}

/// "(T)(intptr_t)" for the C type T a value is declared with: converts an
/// integer or a pointer to it, so an int/pointer mismatch between the IR and
/// the declaration compiles under -Werror=int-conversion (GCC 14, Clang 16+).
/// Empty for float and array types.
fn int_ptr_cast(ty: IrType) -> str {
    match ty {
        IrType::F32 => {
            return "";
        }
        IrType::F64 => {
            return "";
        }
        IrType::Array(_, _) => {
            return "";
        }
        IrType::Void => {
            return "(int64_t)";
        }
        IrType::Never => {
            return "(int64_t)";
        }
        _ => {
        }
    }
    // F9: an integer (or bool) destination goes through int64_t, not
    // intptr_t: intptr_t is 32 bits on wasm32, so `(int64_t)(intptr_t)v` of
    // a u64 kept only its low half (u64_to_str printed -17179869195 for
    // u64::MAX). A pointer converts to int64_t explicitly on every target;
    // where a pointer is 64 bits nothing changes.
    var ct: str = c_type(ty);
    if !str_ends_with(ct, "*") {
        return "(" + ct + ")(int64_t)";
    }
    return "(" + ct + ")(intptr_t)";
}

fn value_ty_for_id(func: IrFunction, id: i64) -> IrType {
    // Values are numbered as they are made: id == index
    if id >= 0 && id < func.value_metas.len() && func.value_metas.get(id).id == id {
        return func.value_metas.get(id).meta.ty;
    }
    var i: i64 = 0;
    while i < func.value_metas.len() {
        if func.value_metas.get(i).id == id {
            return func.value_metas.get(i).meta.ty;
        }
        i = i + 1;
    }
    i = 0;
    while i < func.params.len() {
        if func.params.get(i).id == id {
            return func.params.get(i).ty;
        }
        i = i + 1;
    }
    return IrType::I64;
}

fn params_contains_id(func: IrFunction, id: i64) -> bool {
    var i: i64 = 0;
    while i < func.params.len() {
        if func.params.get(i).id == id {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn binop_to_str(op: BinOp) -> str {
    match op {
        BinOp::Add => {
            return "+";
        }
        BinOp::Sub => {
            return "-";
        }
        BinOp::Mul => {
            return "*";
        }
        BinOp::Div => {
            return "/";
        }
        BinOp::Mod => {
            return "%";
        }
        BinOp::Eq => {
            return "==";
        }
        BinOp::Neq => {
            return "!=";
        }
        BinOp::Lt => {
            return "<";
        }
        BinOp::Gt => {
            return ">";
        }
        BinOp::LtEq => {
            return "<=";
        }
        BinOp::GtEq => {
            return ">=";
        }
        BinOp::And => {
            return "&&";
        }
        BinOp::Or => {
            return "||";
        }
        BinOp::BitAnd => {
            return "&";
        }
        BinOp::BitOr => {
            return "|";
        }
        BinOp::BitXor => {
            return "^";
        }
        BinOp::Shl => {
            return "<<";
        }
        BinOp::Shr => {
            return ">>";
        }
    }
    return "+";
}

fn unaryop_to_str(op: UnaryOp) -> str {
    match op {
        UnaryOp::Neg => {
            return "-";
        }
        UnaryOp::Not => {
            return "!";
        }
        UnaryOp::BitNot => {
            return "~";
        }
    }
    return "-";
}

// --- Function / instruction emission --------------------------------------

fn alloca_size(self: &CCodeGen, ty: IrType) -> i64 {
    // For struct types, look up the actual size from struct_layouts.
    // ir_type_size() returns 0 for structs because it doesn't have
    // access to the module. Without this lookup, alloca only
    // allocates 8 bytes (the fallback), causing buffer overflows
    // when memcpy copies the full struct data.
    var size: i64 = 0;
    match ty {
        IrType::Struct(sname) => {
            var si: i64 = 0;
            while si < self.struct_layouts.len() {
                if self.struct_layouts.get(si).name == sname {
                    size = self.struct_layouts.get(si).layout.size;
                    break;
                }
                si = si + 1;
            }
        }
        _ => {
            size = ir_type_size(ty);
        }
    }
    if size == 0 {
        size = 8;
    }
    return size;
}

fn fn_has_const_str(func: IrFunction, s: str) -> bool {
    var i: i64 = 0;
    while i < func.insts.len() {
        match func.insts.get(i).inst {
            Inst::ConstStr(v) => {
                if v == s {
                    return true;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return false;
}

/// C bodies for core.fd's Vec_new/len/is_empty/get/set/push/pop, with core's
/// exact semantics: the header is {data, len, cap, code, tid} (five i64;
/// a negative cap is a shared buffer, made one's own by core's vec_own;
/// tid says how elements are dropped, proposal 0004), growth
/// doubles from 8 through p_malloc, a bad index panics with core's message.
/// Used only when the function has core's signature (an env parameter, i64
/// arguments, the same return type, and for get/set core's panic string),
/// so a user's own function of that name keeps its body. Empty: no fast body.
/// Regions freed in one step (proposal 0005), declarations: the region
/// state of the running task and core's accessor `p_region_word` (op 0:
/// regions open on this task, 1: the current one, others __p_rg_word).
/// Emitted early: core's functions and the allocator below use them.
fn emit_region_runtime(self: &mut CCodeGen) {
    wln(self, "/* Regions (proposal 0005): while a region is the current one (__p_rs.mode),");
    wln(self, "   p_malloc takes the next bytes of its arena; p_free leaves arena blocks");
    wln(self, "   alone, and the region's end releases its chunks at once. An arena block's");
    wln(self, "   header is P_ARENA_TAG, its size and its region's depth. */");
    wln(self, "#define P_ARENA_TAG 0xF1DE5CULL");
    wln(self, "#define P_ARENA_HDR(size, depth) ((P_ARENA_TAG << 40) | (((uint64_t)(size) & 0xFFFFFFFFULL) << 8) | ((uint64_t)(depth) & 0xFF))");
    wln(self, "#define P_IS_ARENA_HDR(h) (((uint64_t)(h) >> 40) == P_ARENA_TAG)");
    wln(self, "typedef struct __p_rchunk { struct __p_rchunk* next; char* ptr; char* end; int64_t pad; } __p_rchunk;");
    wln(self, "typedef struct __p_rarena { struct __p_rarena* below; __p_rchunk* chunks; int64_t parent; int64_t dirty; int64_t next_size; } __p_rarena;");
    wln(self, "typedef struct __p_rstate { int64_t live; int64_t mode; __p_rarena* top; } __p_rstate;");
    wln(self, "static P_THREAD_LOCAL __p_rstate __p_rs;");
    wln(self, "int64_t __p_rg_word(int64_t op, int64_t x);");
    wln(self, "void* __p_rg_alloc(int64_t size);");
    wln(self, "void __p_region_push(void);");
    wln(self, "void __p_region_pop(void);");
    wln(self, "#ifdef P_MN");
    wln(self, "static inline int64_t p_region_word(int64_t op, int64_t x) { return __p_rg_word(op, x); }");
    wln(self, "#else");
    wln(self, "static inline int64_t p_region_word(int64_t op, int64_t x) { if (op == 0) return __p_rs.live; if (op == 1) return __p_rs.mode; return __p_rg_word(op, x); }");
    wln(self, "#endif");
}

/// The region arenas themselves (after the memory limit, which counts
/// their chunks, and before p_malloc, which calls __p_rg_alloc).
fn emit_region_impl(self: &mut CCodeGen) {
    wln(self, "static P_THREAD_LOCAL __p_rchunk* __p_rchunk_cache = NULL;");
    wln(self, "static P_THREAD_LOCAL int64_t __p_rchunk_cached = 0;");
    wln(self, "static P_THREAD_LOCAL __p_rarena* __p_rarena_spare = NULL;");
    wln(self, "static __p_rarena* __p_rg_at(int64_t d) {");
    wln(self, "    __p_rarena* a = __p_rs.top;");
    wln(self, "    int64_t k = __p_rs.live;");
    wln(self, "    while (a && k > d) { a = a->below; k--; }");
    wln(self, "    return d > 0 ? a : NULL;");
    wln(self, "}");
    // a chunk of at least `need` bytes: a cached one (the bytes it gave
    // out zeroed again) or a fresh calloc
    wln(self, "static __p_rchunk* __p_rchunk_get(size_t need) {");
    wln(self, "    __p_rchunk** pp = &__p_rchunk_cache;");
    wln(self, "    while (*pp) {");
    wln(self, "        __p_rchunk* c = *pp;");
    wln(self, "        if ((size_t)(c->end - (char*)(c + 1)) >= need) {");
    wln(self, "            *pp = c->next; __p_rchunk_cached--;");
    wln(self, "            memset(c + 1, 0, (size_t)(c->ptr - (char*)(c + 1)));");
    wln(self, "            c->ptr = (char*)(c + 1); c->next = NULL;");
    wln(self, "            return c;");
    wln(self, "        }");
    wln(self, "        pp = &c->next;");
    wln(self, "    }");
    wln(self, "    size_t cs = need + sizeof(__p_rchunk);");
    wln(self, "    if (__p_lim_mem) __p_lim_take((int64_t)cs);");
    wln(self, "    __p_rchunk* c = (__p_rchunk*)calloc(1, cs);");
    wln(self, "    if (!c) { fprintf(stderr, \"p_malloc: out of memory in a region\\n\"); abort(); }");
    wln(self, "    c->ptr = (char*)(c + 1); c->end = (char*)c + cs; c->next = NULL;");
    wln(self, "    return c;");
    wln(self, "}");
    wln(self, "static void __p_rchunk_put(__p_rchunk* c) {");
    wln(self, "    if (__p_rchunk_cached < 8 && (c->end - (char*)(c + 1)) <= ((int64_t)4 << 20)) { c->next = __p_rchunk_cache; __p_rchunk_cache = c; __p_rchunk_cached++; return; }");
    wln(self, "    if (__p_lim_mem) __P_LIM_ADD(-(int64_t)(c->end - (char*)c));");
    wln(self, "    free(c);");
    wln(self, "}");
    // A block of the current region's arena: an 8-byte header, then the
    // payload (zeroed, as p_malloc's are)
    wln(self, "P_MN_NOINLINE void* __p_rg_alloc(int64_t size) {");
    wln(self, "    __p_rarena* a = __p_rg_at(__p_rs.mode);");
    wln(self, "    if (!a) return NULL;");
    wln(self, "    size_t total = ((size_t)size + 15) & ~(size_t)7;");
    wln(self, "    __p_rchunk* c = a->chunks;");
    wln(self, "    if (!c || (size_t)(c->end - c->ptr) < total) {");
    wln(self, "        if (total > ((size_t)1 << 20)) {");
    // a big block gets a chunk of its own, behind the current one
    wln(self, "            __p_rchunk* big = __p_rchunk_get(total);");
    wln(self, "            if (c) { big->next = c->next; c->next = big; } else a->chunks = big;");
    wln(self, "            uint64_t* bb = (uint64_t*)big->ptr; big->ptr += total;");
    wln(self, "            bb[0] = P_ARENA_HDR(size, __p_rs.mode);");
    wln(self, "            return bb + 1;");
    wln(self, "        }");
    wln(self, "        size_t want = a->next_size ? (size_t)a->next_size : ((size_t)64 << 10);");
    wln(self, "        if (want < total) want = total;");
    wln(self, "        a->next_size = (int64_t)(want < ((size_t)4 << 20) ? want * 2 : want);");
    wln(self, "        __p_rchunk* n = __p_rchunk_get(want);");
    wln(self, "        n->next = c; a->chunks = n; c = n;");
    wln(self, "    }");
    wln(self, "    uint64_t* b = (uint64_t*)c->ptr; c->ptr += total;");
    wln(self, "    b[0] = P_ARENA_HDR(size, __p_rs.mode);");
    wln(self, "    return b + 1;");
    wln(self, "}");
    // RegionBegin: a new arena, the current one from now on
    wln(self, "P_MN_NOINLINE void __p_region_push(void) {");
    wln(self, "    if (__p_rs.live >= 255) p_panic(\"regions nested more than 255 deep\");");
    wln(self, "    __p_rarena* a = __p_rarena_spare;");
    wln(self, "    if (a) { __p_rarena_spare = a->below; memset(a, 0, sizeof *a); }");
    wln(self, "    else { a = (__p_rarena*)calloc(1, sizeof(__p_rarena)); if (!a) { fprintf(stderr, \"out of memory\\n\"); abort(); } }");
    wln(self, "    a->below = __p_rs.top; a->parent = __p_rs.mode;");
    wln(self, "    __p_rs.top = a; __p_rs.live++; __p_rs.mode = __p_rs.live;");
    // RT8: p_malloc's inline path looks at regions only while one is live
    // on some thread (P_ASLOW_RG for each)
    wln(self, "    __P_ASLOW_ADD(P_ASLOW_RG);");
    wln(self, "}");
    // RegionEnd: every block of the arena at once; the region that was
    // current when it began is current again
    wln(self, "P_MN_NOINLINE void __p_region_pop(void) {");
    wln(self, "    __p_rarena* a = __p_rs.top;");
    wln(self, "    if (!a) return;");
    wln(self, "    __p_rs.top = a->below; __p_rs.live--;");
    wln(self, "    __P_ASLOW_ADD(-P_ASLOW_RG);");
    wln(self, "    __p_rs.mode = a->parent <= __p_rs.live ? a->parent : __p_rs.live;");
    wln(self, "    __p_rchunk* c = a->chunks;");
    wln(self, "    while (c) { __p_rchunk* n = c->next; __p_rchunk_put(c); c = n; }");
    wln(self, "    a->below = __p_rarena_spare; __p_rarena_spare = a;");
    wln(self, "}");
    // 2: make region x current (0: none), the previous one returned;
    // 3: leave x regions (-1: all), each marked dirty, the previous returned;
    // 4: mark the current region dirty; 5: whether region x is clean (no
    // value from outside it kept in it, so dropping its values can wait
    // for its end)
    wln(self, "P_MN_NOINLINE int64_t __p_rg_word(int64_t op, int64_t x) {");
    wln(self, "    if (op == 0) return __p_rs.live;");
    wln(self, "    if (op == 1) return __p_rs.mode;");
    wln(self, "    if (op == 2) { int64_t prev = __p_rs.mode; if (x < 0) x = 0; if (x > __p_rs.live) x = __p_rs.live; __p_rs.mode = x; return prev; }");
    wln(self, "    if (op == 3) {");
    wln(self, "        int64_t prev = __p_rs.mode, m = prev;");
    wln(self, "        while (m > 0 && (x < 0 || x-- > 0)) { __p_rarena* a = __p_rg_at(m); if (!a) { m = 0; break; } a->dirty = 1; m = a->parent; }");
    wln(self, "        __p_rs.mode = m;");
    wln(self, "        return prev;");
    wln(self, "    }");
    wln(self, "    if (op == 4) { __p_rarena* a = __p_rg_at(__p_rs.mode); if (a) a->dirty = 1; return 0; }");
    wln(self, "    if (op == 5) { __p_rarena* a = __p_rg_at(x); return (a && !a->dirty) ? 1 : 0; }");
    // 6: as 3, without marking; 7: a region begins; 8: it ends;
    // 10: the region state (open << 8 | current), 9: back to such a state
    // (a function's return ends the regions it left open)
    wln(self, "    if (op == 6) {");
    wln(self, "        int64_t prev = __p_rs.mode, m = prev;");
    wln(self, "        while (m > 0 && (x < 0 || x-- > 0)) { __p_rarena* a = __p_rg_at(m); if (!a) { m = 0; break; } m = a->parent; }");
    wln(self, "        __p_rs.mode = m;");
    wln(self, "        return prev;");
    wln(self, "    }");
    // 7: a region begins (x > 0: its budget, the size of its first chunk)
    wln(self, "    if (op == 7) { __p_region_push(); if (x > 0) __p_rs.top->next_size = x + x / 4 + 4096; return 0; }");
    // 11: the x innermost regions end but keep their memory (a `?` whose
    // error cannot be copied out): each block becomes a never-freed one of
    // no region, so nothing takes it for a live region's
    wln(self, "    if (op == 11) {");
    wln(self, "        while (x-- > 0 && __p_rs.top) {");
    wln(self, "            __p_rarena* a = __p_rs.top;");
    wln(self, "            for (__p_rchunk* c = a->chunks; c; c = c->next) {");
    wln(self, "                char* p = (char*)(c + 1);");
    wln(self, "                while (p < c->ptr) { uint64_t h = *(uint64_t*)p; int64_t sz = (int64_t)((h >> 8) & 0xFFFFFFFFULL); *(uint64_t*)p = P_ARENA_HDR(sz, 0); p += ((size_t)sz + 15) & ~(size_t)7; }");
    wln(self, "            }");
    wln(self, "            __p_rs.top = a->below; __p_rs.live--;");
    wln(self, "            __P_ASLOW_ADD(-P_ASLOW_RG);");
    wln(self, "            __p_rs.mode = a->parent <= __p_rs.live ? a->parent : __p_rs.live;");
    wln(self, "            a->below = __p_rarena_spare; __p_rarena_spare = a;");
    wln(self, "        }");
    wln(self, "        return 0;");
    wln(self, "    }");
    wln(self, "    if (op == 8) { __p_region_pop(); return 0; }");
    wln(self, "    if (op == 10) return (__p_rs.live << 8) | __p_rs.mode;");
    wln(self, "    if (op == 9) { int64_t lv = x >> 8, md = x & 0xFF; while (__p_rs.live > lv) __p_region_pop(); __p_rs.mode = md <= __p_rs.live ? md : __p_rs.live; return 0; }");
    wln(self, "    return 0;");
    wln(self, "}");
}

/// RT14 (competitive roadmap): fs.fd's p_fs_copy_file and net.fd's
/// p_net_send_file run the C runtime's zero-copy routines instead of their
/// portable Fides bodies (read the file, write or send it). The parameters
/// are the last two (after __env): (src, dst) and (sock, path).
fn fast_zero_copy_body(name: str, func: IrFunction, c_ret: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var n: i64 = func.params.len();
    if c_ret != "int64_t" || n < 2 || n > 3 {
        return out;
    }
    if name != "p_fs_copy_file" && name != "p_net_send_file" && name != "p_fs_map" && name != "p_fs_unmap" {
        return out;
    }
    var a: str = "v" + int_to_str(func.params.get(n - 2).id);
    var b: str = "v" + int_to_str(func.params.get(n - 1).id);
    if name == "p_fs_copy_file" {
        out.push("    return __p_zc_copy_file((const char*)(intptr_t)" + a + ", (const char*)(intptr_t)" + b + ");");
    } else if name == "p_net_send_file" {
        out.push("    return __p_zc_send_file((int64_t)" + a + ", (const char*)(intptr_t)" + b + ");");
    } else if name == "p_fs_map" {
        // fs.fd FileView: (path, size)
        out.push("    return __p_zc_map((const char*)(intptr_t)" + a + ", (int64_t)" + b + ");");
    } else {
        // (addr, size)
        out.push("    return __p_zc_unmap((int64_t)" + a + ", (int64_t)" + b + ");");
    }
    return out;
}

/// RT14: the C runtime's zero-copy routines. __p_zc_copy_file(src, dst)
/// lets the kernel copy the bytes where the system allows it
/// (copy_file_range, then sendfile on Linux; fcopyfile on macOS; CopyFileA on
/// Windows) and moves the rest through a 64 KB buffer: the bytes copied, or
/// -1. __p_zc_send_file(sock, path) sends a file on a connected socket with
/// sendfile (Linux, macOS) or TransmitFile (Windows), the rest (a system or
/// socket without them) read and sent: the bytes sent, or -1. A file copied
/// onto itself is left as it is. SIGPIPE from a closed peer is held back
/// (Linux: blocked for the call; macOS: SO_NOSIGPIPE), as MSG_NOSIGNAL does
/// for the runtime's sends.
fn emit_zero_copy_runtime(self: &mut CCodeGen) -> void {
    wln(self, "");
    wln(self, "// --- Zero-copy file and socket I/O (RT14) ---");
    wln(self, "#ifndef _WIN32");
    wln(self, "#include <errno.h>");
    wln(self, "#include <sys/stat.h>");
    wln(self, "#include <fcntl.h>");
    wln(self, "#if defined(__linux__)");
    wln(self, "#include <sys/sendfile.h>");
    wln(self, "#include <sys/syscall.h>");
    wln(self, "#include <signal.h>");
    wln(self, "#include <pthread.h>");
    wln(self, "#endif");
    wln(self, "#if defined(__APPLE__)");
    wln(self, "#include <copyfile.h>");
    wln(self, "#include <sys/uio.h>");
    wln(self, "#endif");
    wln(self, "#endif");
    wln(self, "#ifdef MSG_NOSIGNAL");
    wln(self, "#define P_ZC_NOSIGNAL MSG_NOSIGNAL");
    wln(self, "#else");
    wln(self, "#define P_ZC_NOSIGNAL 0");
    wln(self, "#endif");
    wln(self, "#define P_ZC_CHUNK(left) ((size_t)((left) < 0x40000000 ? (left) : 0x40000000))");
    // The portable copy: stdio, 64 KB at a time (only where nothing else
    // copies: an unused static function would warn elsewhere)
    wln(self, "#if defined(_WIN32) || defined(__wasi__)");
    wln(self, "static int64_t __p_zc_copy_stdio(const char* src, const char* dst) {");
    wln(self, "    FILE* in = fopen(src, \"rb\"); if (!in) return -1;");
    wln(self, "    FILE* out = fopen(dst, \"wb\"); if (!out) { fclose(in); return -1; }");
    wln(self, "    char* buf = (char*)malloc(65536);");
    wln(self, "    int64_t total = 0; int bad = buf ? 0 : 1; size_t n;");
    wln(self, "    while (!bad && (n = fread(buf, 1, 65536, in)) > 0) {");
    wln(self, "        if (fwrite(buf, 1, n, out) != n) { bad = 1; break; }");
    wln(self, "        total += (int64_t)n;");
    wln(self, "    }");
    wln(self, "    if (ferror(in)) bad = 1;");
    wln(self, "    free(buf); fclose(in);");
    wln(self, "    if (fclose(out) != 0) bad = 1;");
    wln(self, "    return bad ? -1 : total;");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "#ifdef _WIN32");
    wln(self, "static int64_t __p_zc_wsize(const char* p) {");
    wln(self, "    WIN32_FILE_ATTRIBUTE_DATA a;");
    wln(self, "    if (!GetFileAttributesExA(p, GetFileExInfoStandard, &a)) return -1;");
    wln(self, "    return (int64_t)(((uint64_t)a.nFileSizeHigh << 32) | (uint64_t)a.nFileSizeLow);");
    wln(self, "}");
    wln(self, "#ifndef SIO_GET_EXTENSION_FUNCTION_POINTER");
    wln(self, "#define SIO_GET_EXTENSION_FUNCTION_POINTER 0xC8000006");
    wln(self, "#endif");
    wln(self, "typedef BOOL (PASCAL *__p_transmit_fn)(SOCKET, HANDLE, DWORD, DWORD, LPOVERLAPPED, void*, DWORD);");
    wln(self, "#endif");
    // The copy
    wln(self, "int64_t __p_zc_copy_file(const char* src, const char* dst) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_FS)) return -1;");
    wln(self, "    if (!src || !dst) return -1;");
    wln(self, "#if defined(_WIN32)");
    wln(self, "    {");
    wln(self, "        char fa[1024], fb[1024];");
    wln(self, "        DWORD la = GetFullPathNameA(src, 1024, fa, NULL), lb = GetFullPathNameA(dst, 1024, fb, NULL);");
    wln(self, "        if (la > 0 && la < 1024 && lb > 0 && lb < 1024 && _stricmp(fa, fb) == 0) return __p_zc_wsize(src);");
    wln(self, "    }");
    wln(self, "    if (CopyFileA(src, dst, FALSE)) { int64_t sz = __p_zc_wsize(dst); if (sz >= 0) return sz; }");
    wln(self, "    return __p_zc_copy_stdio(src, dst);");
    wln(self, "#elif defined(__wasi__)");
    wln(self, "    return __p_zc_copy_stdio(src, dst);");
    wln(self, "#else");
    wln(self, "    int in = open(src, O_RDONLY);");
    wln(self, "    if (in < 0) return -1;");
    wln(self, "    struct stat st, ost;");
    wln(self, "    if (fstat(in, &st) < 0) { close(in); return -1; }");
    wln(self, "    if (stat(dst, &ost) == 0 && ost.st_dev == st.st_dev && ost.st_ino == st.st_ino) { close(in); return (int64_t)st.st_size; }");
    wln(self, "    int out = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0644);");
    wln(self, "    if (out < 0) { close(in); return -1; }");
    wln(self, "    int64_t total = 0, left = (int64_t)st.st_size; int bad = 0;");
    wln(self, "#if defined(__APPLE__)");
    wln(self, "    if (left > 0 && fcopyfile(in, out, NULL, COPYFILE_DATA) == 0) { total = left; left = 0; lseek(in, 0, SEEK_END); }");
    wln(self, "#elif defined(__linux__)");
    wln(self, "#ifdef SYS_copy_file_range");
    wln(self, "    while (left > 0) {");
    wln(self, "        long r = syscall(SYS_copy_file_range, in, NULL, out, NULL, P_ZC_CHUNK(left), 0);");
    wln(self, "        if (r <= 0) break;");
    wln(self, "        total += r; left -= r;");
    wln(self, "    }");
    wln(self, "#endif");
    wln(self, "    while (left > 0) {");
    wln(self, "        ssize_t r = sendfile(out, in, NULL, P_ZC_CHUNK(left));");
    wln(self, "        if (r <= 0) break;");
    wln(self, "        total += r; left -= r;");
    wln(self, "    }");
    wln(self, "#endif");
    // What the kernel did not copy (no such call here, another file system,
    // a file that grew): from where it stopped, through a buffer
    wln(self, "    char* buf = (char*)malloc(65536);");
    wln(self, "    if (!buf) bad = 1;");
    wln(self, "    while (!bad) {");
    wln(self, "        ssize_t n = read(in, buf, 65536);");
    wln(self, "        if (n < 0 && errno == EINTR) continue;");
    wln(self, "        if (n < 0) { bad = 1; break; }");
    wln(self, "        if (n == 0) break;");
    wln(self, "        ssize_t w = 0;");
    wln(self, "        while (w < n) {");
    wln(self, "            ssize_t k = write(out, buf + w, (size_t)(n - w));");
    wln(self, "            if (k > 0) { w += k; continue; }");
    wln(self, "            if (k < 0 && errno == EINTR) continue;");
    wln(self, "            break;");
    wln(self, "        }");
    wln(self, "        if (w < n) { bad = 1; break; }");
    wln(self, "        total += n;");
    wln(self, "    }");
    wln(self, "    free(buf);");
    wln(self, "    close(in);");
    wln(self, "    if (close(out) != 0) bad = 1;");
    wln(self, "    return bad ? -1 : total;");
    wln(self, "#endif");
    wln(self, "}");
    // The send
    wln(self, "int64_t __p_zc_send_file(int64_t sock, const char* path) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_NET) || P_CAP_DENIED(P_CAP_FS)) return -1;");
    wln(self, "    if (!path || sock < 0) return -1;");
    wln(self, "#if defined(_WIN32)");
    wln(self, "    HANDLE f = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN, NULL);");
    wln(self, "    if (f == INVALID_HANDLE_VALUE) return -1;");
    wln(self, "    LARGE_INTEGER sz;");
    wln(self, "    if (!GetFileSizeEx(f, &sz)) { CloseHandle(f); return -1; }");
    wln(self, "    if (sz.QuadPart == 0) { CloseHandle(f); return 0; }");
    // TransmitFile is mswsock's: its address from Winsock, so that no
    // other library is linked
    wln(self, "    GUID tid = {0xb5367df0, 0xcbac, 0x11cf, {0x95, 0xca, 0x00, 0x80, 0x5f, 0x48, 0xa1, 0x92}};");
    wln(self, "    __p_transmit_fn tf = NULL; DWORD got = 0;");
    wln(self, "    if (sz.QuadPart < 0x7FFFFFFE && WSAIoctl((SOCKET)sock, SIO_GET_EXTENSION_FUNCTION_POINTER, &tid, sizeof tid, &tf, sizeof tf, &got, NULL, NULL) == 0 && tf) {");
    wln(self, "        if (tf((SOCKET)sock, f, 0, 0, NULL, NULL, 0)) { CloseHandle(f); return (int64_t)sz.QuadPart; }");
    wln(self, "        int e = WSAGetLastError();");
    wln(self, "        if (e != WSAEOPNOTSUPP && e != WSAENOTSOCK) { CloseHandle(f); return -1; }");
    wln(self, "        LARGE_INTEGER z; z.QuadPart = 0; SetFilePointerEx(f, z, NULL, FILE_BEGIN);");
    wln(self, "    }");
    wln(self, "    char* buf = (char*)malloc(65536);");
    wln(self, "    int64_t total = 0; int bad = buf ? 0 : 1; DWORD n = 0;");
    wln(self, "    while (!bad && ReadFile(f, buf, 65536, &n, NULL) && n > 0) {");
    wln(self, "        DWORD w = 0;");
    wln(self, "        while (w < n) {");
    wln(self, "            int k = send((SOCKET)sock, buf + w, (int)(n - w), 0);");
    wln(self, "            if (k > 0) { w += (DWORD)k; continue; }");
    wln(self, "            if (k < 0 && WSAGetLastError() == WSAEWOULDBLOCK && p_socket_poll(sock, 30000, 1) > 0) continue;");
    wln(self, "            break;");
    wln(self, "        }");
    wln(self, "        if (w < n) { bad = 1; break; }");
    wln(self, "        total += (int64_t)n;");
    wln(self, "    }");
    wln(self, "    free(buf); CloseHandle(f);");
    wln(self, "    return bad ? -1 : total;");
    wln(self, "#elif defined(__wasi__)");
    wln(self, "    (void)sock; return -1;");
    wln(self, "#else");
    wln(self, "    int fd = open(path, O_RDONLY);");
    wln(self, "    if (fd < 0) return -1;");
    wln(self, "    struct stat st;");
    wln(self, "    if (fstat(fd, &st) < 0) { close(fd); return -1; }");
    wln(self, "    int64_t total = 0, left = (int64_t)st.st_size; int bad = 0;");
    wln(self, "#if defined(__linux__)");
    wln(self, "    sigset_t ps, old; sigemptyset(&ps); sigaddset(&ps, SIGPIPE);");
    wln(self, "    pthread_sigmask(SIG_BLOCK, &ps, &old);");
    wln(self, "    while (left > 0) {");
    wln(self, "        ssize_t r = sendfile((int)sock, fd, NULL, P_ZC_CHUNK(left));");
    wln(self, "        if (r > 0) { total += r; left -= r; continue; }");
    wln(self, "        if (r < 0 && errno == EINTR) continue;");
    wln(self, "        if (r < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) { if (p_socket_poll(sock, 30000, 1) > 0) continue; bad = 1; break; }");
    // the file ended early, or no sendfile for this socket: the buffer below
    wln(self, "        if (r == 0 || errno == EINVAL || errno == ENOSYS || errno == EOPNOTSUPP) break;");
    wln(self, "        bad = 1; break;");
    wln(self, "    }");
    wln(self, "#elif defined(__APPLE__)");
    wln(self, "    { int one = 1; setsockopt((int)sock, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one); }");
    wln(self, "    while (left > 0) {");
    wln(self, "        off_t len = (off_t)left;");
    wln(self, "        int r = sendfile(fd, (int)sock, (off_t)total, &len, NULL, 0);");
    wln(self, "        if (len > 0) { total += (int64_t)len; left -= (int64_t)len; }");
    wln(self, "        if (r == 0) { if (len == 0) break; continue; }");
    wln(self, "        if (errno == EINTR) continue;");
    wln(self, "        if (errno == EAGAIN) { if (len > 0 || p_socket_poll(sock, 30000, 1) > 0) continue; bad = 1; break; }");
    wln(self, "        if (errno == ENOTSOCK || errno == EOPNOTSUPP || errno == EINVAL) break;");
    wln(self, "        bad = 1; break;");
    wln(self, "    }");
    wln(self, "    lseek(fd, (off_t)total, SEEK_SET);");
    wln(self, "#endif");
    wln(self, "    if (!bad) {");
    wln(self, "        char* buf = (char*)malloc(65536);");
    wln(self, "        if (!buf) bad = 1;");
    wln(self, "        while (!bad) {");
    wln(self, "            ssize_t n = read(fd, buf, 65536);");
    wln(self, "            if (n < 0 && errno == EINTR) continue;");
    wln(self, "            if (n < 0) { bad = 1; break; }");
    wln(self, "            if (n == 0) break;");
    wln(self, "            ssize_t w = 0;");
    wln(self, "            while (w < n) {");
    wln(self, "                ssize_t k = send((int)sock, buf + w, (size_t)(n - w), P_ZC_NOSIGNAL);");
    wln(self, "                if (k > 0) { w += k; continue; }");
    wln(self, "                if (k < 0 && errno == EINTR) continue;");
    wln(self, "                if (k < 0 && (errno == EAGAIN || errno == EWOULDBLOCK) && p_socket_poll(sock, 30000, 1) > 0) continue;");
    wln(self, "                break;");
    wln(self, "            }");
    wln(self, "            if (w < n) { bad = 1; break; }");
    wln(self, "            total += n;");
    wln(self, "        }");
    wln(self, "        free(buf);");
    wln(self, "    }");
    wln(self, "#if defined(__linux__)");
    // a SIGPIPE raised meanwhile is taken off, not delivered
    wln(self, "    { sigset_t pend; sigpending(&pend); if (sigismember(&pend, SIGPIPE) && !sigismember(&old, SIGPIPE)) { struct timespec z = {0, 0}; sigtimedwait(&ps, NULL, &z); } }");
    wln(self, "    pthread_sigmask(SIG_SETMASK, &old, NULL);");
    wln(self, "#endif");
    wln(self, "    close(fd);");
    wln(self, "    return bad ? -1 : total;");
    wln(self, "#endif");
    wln(self, "}");
    // fs.fd FileView: `size` bytes of a file mapped read-only (0 when the
    // file is not that size now or cannot be mapped: FileView reads it)
    wln(self, "#if !defined(_WIN32) && !defined(__wasi__)");
    wln(self, "#include <sys/mman.h>");
    wln(self, "#endif");
    wln(self, "int64_t __p_zc_map(const char* path, int64_t size) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_FS) || !path || size <= 0) return 0;");
    wln(self, "#if defined(_WIN32)");
    wln(self, "    HANDLE f = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);");
    wln(self, "    if (f == INVALID_HANDLE_VALUE) return 0;");
    wln(self, "    LARGE_INTEGER sz;");
    wln(self, "    if (!GetFileSizeEx(f, &sz) || sz.QuadPart != size) { CloseHandle(f); return 0; }");
    wln(self, "    HANDLE m = CreateFileMappingA(f, NULL, PAGE_READONLY, 0, 0, NULL);");
    wln(self, "    CloseHandle(f);");
    wln(self, "    if (!m) return 0;");
    // the view keeps the mapping (and the file) open by itself
    wln(self, "    void* p = MapViewOfFile(m, FILE_MAP_READ, 0, 0, 0);");
    wln(self, "    CloseHandle(m);");
    wln(self, "    return (int64_t)(intptr_t)p;");
    wln(self, "#elif defined(__wasi__)");
    wln(self, "    return 0;");
    wln(self, "#else");
    wln(self, "    int fd = open(path, O_RDONLY);");
    wln(self, "    if (fd < 0) return 0;");
    wln(self, "    struct stat st;");
    wln(self, "    if (fstat(fd, &st) < 0 || (int64_t)st.st_size != size) { close(fd); return 0; }");
    wln(self, "    void* p = mmap(NULL, (size_t)size, PROT_READ, MAP_PRIVATE, fd, 0);");
    wln(self, "    close(fd);");
    wln(self, "    return p == MAP_FAILED ? 0 : (int64_t)(intptr_t)p;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t __p_zc_unmap(int64_t addr, int64_t size) {");
    wln(self, "    if (!addr || size <= 0) return -1;");
    wln(self, "#if defined(_WIN32)");
    wln(self, "    return UnmapViewOfFile((void*)(intptr_t)addr) ? 0 : -1;");
    wln(self, "#elif defined(__wasi__)");
    wln(self, "    return -1;");
    wln(self, "#else");
    wln(self, "    return munmap((void*)(intptr_t)addr, (size_t)size) == 0 ? 0 : -1;");
    wln(self, "#endif");
    wln(self, "}");
}

fn fast_core_vec_body(name: str, func: IrFunction, c_ret: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    // RT14: the zero-copy routines (str parameters: before the check below)
    var zc: Vec<str> = fast_zero_copy_body(name, func, c_ret);
    if zc.len() > 0 {
        return zc;
    }
    var n: i64 = func.params.len();
    var i: i64 = 1;
    while i < n {
        var ok: bool = false;
        match func.params.get(i).ty {
            IrType::I64 => {
                ok = true;
            }
            _ => {
            }
        }
        if !ok {
            return out;
        }
        i = i + 1;
    }
    var p: Vec<str> = Vec::new();
    i = 0;
    while i < n {
        p.push("v" + int_to_str(func.params.get(i).id));
        i = i + 1;
    }
    var bounds: bool = fn_has_const_str(func, "Vec index out of bounds");
    if name == "Vec_new" && n == 1 && c_ret == "int64_t" {
        // (all 40 bytes are written: RT8's p_malloc_uninit)
        out.push("    int64_t* __h = (int64_t*)__p_malloc_uninit(40);");
        out.push("    __h[0] = 0; __h[1] = 0; __h[2] = 0; __h[3] = 0; __h[4] = 0;");
        out.push("    return (int64_t)(intptr_t)__h;");
    } else if name == "p_malloc_uninit" && n == 2 && c_ret == "int64_t" {
        // RT8: core's p_malloc_uninit (env, size; its Fides body is
        // p_malloc's zeroed block, the fallback of every other backend) runs
        // the C runtime's block without the zeroing
        out.push("    return (int64_t)(intptr_t)__p_malloc_uninit(" + p.get(1) + ");");
    } else if name == "p_zero_words" && n == 3 && c_ret == "void" {
        // core's word loop as memset: the lowering zeroes every owning
        // struct slot of a function in its entry block with it (proposal
        // 0004), so a function with many such locals pays it on every call
        // (Interpreter_execute_inst, once per interpreted instruction: 30%
        // of `fid run`'s time per instruction went to the loop)
        out.push("    if (" + p.get(2) + " > 0) memset((void*)(intptr_t)" + p.get(1) + ", 0, (size_t)" + p.get(2) + " * 8);");
    } else if name == "p_str_copy_n" && n == 4 && c_ret == "void" {
        // core's byte loop (kept for the interpreter) as memcpy
        out.push("    if (" + p.get(3) + " > 0) memcpy((void*)(intptr_t)" + p.get(1) + ", (const void*)(intptr_t)" + p.get(2) + ", (size_t)" + p.get(3) + ");");
    } else if name == "p_bytes_eq" && n == 4 && c_ret == "bool" {
        out.push("    if (" + p.get(3) + " <= 0) return 1;");
        out.push("    return memcmp((const void*)(intptr_t)" + p.get(1) + ", (const void*)(intptr_t)" + p.get(2) + ", (size_t)" + p.get(3) + ") == 0;");
    } else if name == "p_mem_copy" && n == 4 && c_ret == "void" {
        // OP23: core's word loop as the C library's vectorized copy
        // (memmove: the same result as the forward loop where the areas
        // do not overlap, and safe where they do)
        out.push("    if (" + p.get(3) + " > 0) memmove((void*)(intptr_t)" + p.get(1) + ", (const void*)(intptr_t)" + p.get(2) + ", (size_t)" + p.get(3) + ");");
    } else if name == "p_mem_find_byte" && n == 4 && c_ret == "int64_t" {
        // OP23: core's byte loop as memchr (a byte value outside 0..255
        // is found nowhere, as in the loop)
        out.push("    if (" + p.get(2) + " <= 0 || (uint64_t)" + p.get(3) + " > 255) return -1;");
        out.push("    const unsigned char* __s = (const unsigned char*)(intptr_t)" + p.get(1) + ";");
        out.push("    const unsigned char* __r = (const unsigned char*)memchr(__s, (int)" + p.get(3) + ", (size_t)" + p.get(2) + ");");
        out.push("    return __r ? (int64_t)(__r - __s) : -1;");
    } else if name == "p_str_compare" && n == 3 && c_ret == "int64_t" {
        // OP23: core's byte loop (up to the first NUL of either; the first
        // difference as a - b), eight bytes per step: strlen finds the
        // NULs, then whole words are skipped while they are equal
        out.push("    const unsigned char* __a = (const unsigned char*)(intptr_t)" + p.get(1) + ";");
        out.push("    const unsigned char* __b = (const unsigned char*)(intptr_t)" + p.get(2) + ";");
        out.push("    if (__a == __b) return 0;");
        out.push("    if (!__a) return -1;");
        out.push("    if (!__b) return 1;");
        out.push("    size_t __la = strlen((const char*)__a), __lb = strlen((const char*)__b);");
        out.push("    size_t __m = (__la < __lb ? __la : __lb) + 1;");
        out.push("    size_t __i = 0;");
        out.push("    while (__i + 8 <= __m) { uint64_t __x, __y; memcpy(&__x, __a + __i, 8); memcpy(&__y, __b + __i, 8); if (__x != __y) break; __i += 8; }");
        out.push("    while (__i < __m && __a[__i] == __b[__i]) __i++;");
        out.push("    if (__i >= __m) return 0;");
        out.push("    return (int64_t)__a[__i] - (int64_t)__b[__i];");
    } else if name == "Vec_filled_typed" && n == 5 && c_ret == "int64_t" {
        // n elements of x: a memset for bytes, a store loop otherwise; owned
        // elements each get one more owner (core's vec_elem_dup)
        var nn: str = p.get(1);
        var xx: str = p.get(2);
        var cc: str = p.get(3);
        var tt: str = p.get(4);
        out.push("    int64_t* __h = (int64_t*)(intptr_t)Vec_new_typed(0, " + cc + ", " + tt + ");");
        out.push("    if (" + nn + " <= 0) return (int64_t)(intptr_t)__h;");
        out.push("    int64_t __esz = " + cc + " == 0 ? 8 : (" + cc + " < 0 ? -" + cc + " : " + cc + ");");
        out.push("    char* __d = (char*)p_malloc(" + nn + " * __esz);");
        out.push("    if (!__d) p_panic(\"out of memory\");");
        out.push("    if (__esz == 1) memset(__d, (int)(" + xx + " & 255), (size_t)" + nn + ");");
        out.push("    else if (__esz == 2) { uint16_t* __q = (uint16_t*)__d; for (int64_t __i = 0; __i < " + nn + "; __i++) __q[__i] = (uint16_t)" + xx + "; }");
        out.push("    else if (__esz == 4) { uint32_t* __q = (uint32_t*)__d; for (int64_t __i = 0; __i < " + nn + "; __i++) __q[__i] = (uint32_t)" + xx + "; }");
        out.push("    else if (" + tt + " == 0) { int64_t* __q = (int64_t*)__d; for (int64_t __i = 0; __i < " + nn + "; __i++) __q[__i] = " + xx + "; }");
        out.push("    else { int64_t* __q = (int64_t*)__d; for (int64_t __i = 0; __i < " + nn + "; __i++) __q[__i] = vec_elem_dup(0, " + tt + ", " + xx + "); }");
        out.push("    __h[0] = (int64_t)(intptr_t)__d; __h[1] = " + nn + "; __h[2] = " + nn + ";");
        out.push("    return (int64_t)(intptr_t)__h;");
    } else if name == "p_str_hash" && n == 2 && c_ret == "int64_t" {
        // The bytes up to the first NUL, as core's byte loop, eight at a
        // time (HashMap mixes the result again, hm_mix)
        out.push("    const unsigned char* __s = (const unsigned char*)(intptr_t)" + p.get(1) + ";");
        out.push("    if (!__s) return 0;");
        out.push("    size_t __n = strlen((const char*)__s);");
        out.push("    uint64_t __h = 0xCBF29CE484222325ULL ^ (uint64_t)__n;");
        out.push("    while (__n >= 8) { uint64_t __w; memcpy(&__w, __s, 8); __h = (__h ^ __w) * 0x9E3779B97F4A7C15ULL; __h ^= __h >> 29; __s += 8; __n -= 8; }");
        out.push("    uint64_t __t = 0; memcpy(&__t, __s, __n);");
        out.push("    __h = (__h ^ __t) * 0x9E3779B97F4A7C15ULL; __h ^= __h >> 32;");
        out.push("    return (int64_t)(__h & 0x7FFFFFFFFFFFFFFFULL);");
    } else if name == "Vec_len" && n == 2 && c_ret == "int64_t" {
        out.push("    int64_t* __h = (int64_t*)(intptr_t)" + p.get(1) + ";");
        out.push("    return __h[1];");
    } else if name == "Vec_is_empty" && n == 2 && c_ret == "bool" {
        out.push("    int64_t* __h = (int64_t*)(intptr_t)" + p.get(1) + ";");
        out.push("    return __h[1] == 0;");
    } else if name == "Vec_get" && n == 3 && c_ret == "int64_t" && bounds {
        out.push("    int64_t* __h = (int64_t*)(intptr_t)" + p.get(1) + ";");
        out.push("    if (" + p.get(2) + " >= __h[1]) p_panic(\"Vec index out of bounds\");");
        out.push("    if (" + p.get(2) + " < 0) p_panic(\"Vec index out of bounds\");");
        out.push("    if (P_UNLIKELY(__h[3])) return __p_vec_ld(__h, " + p.get(2) + ");");
        out.push("    return ((int64_t*)(intptr_t)__h[0])[" + p.get(2) + "];");
    } else if name == "Vec_set" && n == 4 && c_ret == "void" && bounds {
        out.push("    int64_t* __h = (int64_t*)(intptr_t)" + p.get(1) + ";");
        out.push("    if (" + p.get(2) + " >= __h[1]) p_panic(\"Vec index out of bounds\");");
        out.push("    if (" + p.get(2) + " < 0) p_panic(\"Vec index out of bounds\");");
        // A shared buffer is made this Vec's own first, its elements
        // counted again (core's vec_own); the old element is dropped by
        // the Vec's element type (proposal 0004)
        out.push("    if (P_UNLIKELY(__h[2] < 0)) vec_own(0, " + p.get(1) + ");");
        out.push("    int64_t __x = " + p.get(3) + ";");
        out.push("    if (P_UNLIKELY(__p_rs.mode) && __h[4]) __x = rg_vec_fit(0, " + p.get(1) + ", __x);");
        out.push("    if (P_UNLIKELY(__h[3]) && P_VEC_CODE(__h) >= 16) { vec_sz_set(0, " + p.get(1) + ", " + p.get(2) + ", __x); return; }");
        out.push("    if (P_UNLIKELY(__h[3])) { __p_vec_st(__h, " + p.get(2) + ", __x); return; }");
        out.push("    int64_t* __slot = &((int64_t*)(intptr_t)__h[0])[" + p.get(2) + "];");
        out.push("    int64_t __old = *__slot;");
        out.push("    *__slot = __x;");
        out.push("    if (P_UNLIKELY(__h[4] != 0) && __old != __x) vec_elem_drop(0, vec_tid(0, " + p.get(1) + "), __old);");
    } else if name == "Vec_push" && n == 3 && c_ret == "void" {
        out.push("    int64_t* __h = (int64_t*)(intptr_t)" + p.get(1) + ";");
        out.push("    if (P_UNLIKELY(__h[2] < 0)) vec_own(0, " + p.get(1) + ");");
        // what a Vec holds lives as long as it (proposal 0005, core's rg_fit)
        out.push("    int64_t __x = " + p.get(2) + ";");
        out.push("    if (P_UNLIKELY(__p_rs.mode) && __h[4]) __x = rg_vec_fit(0, " + p.get(1) + ", __x);");
        out.push("    int64_t __len = __h[1];");
        out.push("    if (P_UNLIKELY(__len >= __h[2])) __p_vec_grow(__h);");
        out.push("    if (P_UNLIKELY(__h[3])) { __p_vec_st(__h, __len, __x); __h[1] = __len + 1; return; }");
        out.push("    ((int64_t*)(intptr_t)__h[0])[__len] = __x;");
        out.push("    __h[1] = __len + 1;");
    } else if name == "Vec_pop" && n == 2 && c_ret == "int64_t" {
        out.push("    int64_t* __h = (int64_t*)(intptr_t)" + p.get(1) + ";");
        out.push("    if (__h[1] == 0) return 0;");
        out.push("    if (P_UNLIKELY(__h[3]) && P_VEC_CODE(__h) >= 16) return vec_sz_pop(0, " + p.get(1) + ");");
        out.push("    __h[1] = __h[1] - 1;");
        out.push("    if (P_UNLIKELY(__h[3])) return __p_vec_ld(__h, __h[1]);");
        out.push("    int64_t __e = ((int64_t*)(intptr_t)__h[0])[__h[1]];");
        // Taken from a shared buffer: the element stays the other owners'
        // too, so the caller gets an owner of its own (proposal 0004)
        out.push("    if (P_UNLIKELY(__h[2] < 0 && __h[4] != 0)) __e = vec_elem_dup(0, vec_tid(0, " + p.get(1) + "), __e);");
        out.push("    return __e;");
    }
    return out;
}

fn gen_function(self: &mut CCodeGen, name: str, func: IrFunction) -> void {
    self.temp_counter = 0;
    self.label_counter = 0;
    var c_name: str = sanitize_c_name(self, name);

    var i: i64 = 0;
    while i < func.params.len() {
        var p: ValueIdType = func.params.get(i);
        value_names_set(self, p.id, "v" + int_to_str(p.id));
        i = i + 1;
    }

    var ret_ty: str;
    if name == "main" {
        ret_ty = "int64_t";
    } else {
        ret_ty = c_ret_type(func.ret_ty);
    }
    self.cur_fn_c_ret_is_void = ret_ty == "void";
    self.cur_fn_c_ret_type = ret_ty;

    var params_str: str = "";
    i = 0;
    while i < func.params.len() {
        var p: ValueIdType = func.params.get(i);
        if i > 0 {
            params_str = params_str + ", ";
        }
        params_str = params_str + c_param_decl(p.ty, "v" + int_to_str(p.id));
        i = i + 1;
    }
    var simd_attr: str = "";
    if func.is_simd {
        simd_attr = "P_SIMD_FN ";
    }
    wln(self, simd_attr + ret_ty + " " + c_name + "(" + params_str + ") {");
    // Core's hottest Vec functions: a few C statements instead of the
    // lowered Fides body (much faster in the -O0 self-hosted build).
    self.unchecked = peir_unchecked_ops(&func, func.value_metas.len() + func.insts.len() + 16);
    if CG_SOLE_VECS {
        cg_mark_sole_vecs(&func, &mut self.unchecked);
    }
    var fast: Vec<str> = fast_core_vec_body(name, func, ret_ty);
    if fast.len() > 0 {
        var fi: i64 = 0;
        while fi < fast.len() {
            wln(self, fast.get(fi));
            fi = fi + 1;
        }
        wln(self, "}");
        wln(self, "");
        return;
    }

    i = 0;
    while i < func.value_metas.len() {
        var vm: ValueIdMeta = func.value_metas.get(i);
        if !params_contains_id(func, vm.id) {
            match vm.meta.ty {
                IrType::Void => {
                    wln(self, "    int64_t v" + int_to_str(vm.id) + " = 0; /* placeholder for void */");
                }
                IrType::Never => {
                    wln(self, "    int64_t v" + int_to_str(vm.id) + " = 0; /* placeholder for void */");
                }
                IrType::Array(_, _) => {
                    // CI5: a value typed `[T; N]` is the array's address (as
                    // on wasm and the machine layer); `int64_t[N] v = 0` is
                    // not C (a Load from the slot of `var a: [T; N] = ...`)
                    wln(self, "    void* v" + int_to_str(vm.id) + " = 0;");
                }
                _ => {
                    wln(self, "    " + c_type(vm.meta.ty) + " v" + int_to_str(vm.id) + " = 0;");
                }
            }
            value_names_set(self, vm.id, "v" + int_to_str(vm.id));
        }
        i = i + 1;
    }

    // Prologue alloca pre-pass: bind one stack slot per Inst::Alloca at
    // function entry. The zero-init memset is still emitted at the
    // instruction's own site, so loop iterations re-clear the slot while
    // the stack itself grows only once per call instead of per iteration.
    var b: i64 = 0;
    while b < func.blocks.len() {
        var ablock: BasicBlock = func.blocks.get(b);
        var j: i64 = 0;
        while j < ablock.instructions.len() {
            var ainst_id: i64 = ablock.instructions.get(j);
            match find_inst(func.insts, ainst_id) {
                OptInst::Some(ait) => {
                    match ait {
                        Inst::Alloca(aty, _) => {
                            wln(self, "    v" + int_to_str(ainst_id) + " = alloca(" + int_to_str(alloca_size(self, aty)) + ");");
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            j = j + 1;
        }
        b = b + 1;
    }

    // -g: the frame record a panic prints (CE8), and #line to the .fd
    // source for the functions of the input file (TL5)
    if g_c_dbg {
        cg_dbg_prologue(self, name, func);
    }
    // TL5: an imported module's function gets #line to its own file
    var dbg_file_esc: str = cg_lines_file_for(name);
    var dbg_lines: bool = str_len(dbg_file_esc) > 0;
    var last_line: i64 = 0;
    // CM8 (--leaks, --mem): the line of the next allocations, stored at
    // each new line, at each block's first line and after each call (the
    // callee stored its own)
    var mc_lines: bool = cg_mc_lines_for(name);
    var mc_line: i64 = 0;
    // RL12: source-line marks for line coverage (cg_line_marks_on)
    var cov_marks: bool = cg_line_marks_on();
    var cov_line: i64 = 0;
    b = 0;
    while b < func.blocks.len() {
        var block: BasicBlock = func.blocks.get(b);
        if b > 0 {
            wln(self, "  bb" + int_to_str(block.id) + ":");
        }
        mc_line = 0;
        cov_line = 0;
        var j: i64 = 0;
        // println: the index of the Print that ends a line written under
        // the stdout lock (cg_println_pair), -1 outside one
        var line_end: i64 = -1;
        while j < block.instructions.len() {
            var inst_id: i64 = block.instructions.get(j);
            match find_inst(func.insts, inst_id) {
                OptInst::Some(it) => {
                    if cov_marks {
                        var cln: i64 = cg_inst_line(func, inst_id);
                        if cln > 0 && cln != cov_line {
                            wln(self, "    /*@L" + int_to_str(cln) + "*/");
                            cov_line = cln;
                        }
                    }
                    if mc_lines {
                        var mln: i64 = cg_inst_line(func, inst_id);
                        if mln > 0 && mln != mc_line {
                            wln(self, cg_mc_at_stmt(mln));
                            mc_line = mln;
                        }
                    }
                    if dbg_lines {
                        var ln: i64 = cg_inst_line(func, inst_id);
                        if ln > 0 && ln != last_line {
                            wln(self, "#line " + int_to_str(ln) + " \"" + dbg_file_esc + "\"");
                            last_line = ln;
                        }
                    }
                    if line_end < 0 && cg_println_pair(func, block, j, it) {
                        wln(self, "    p_print_line_begin();");
                        line_end = j + 2;
                    }
                    gen_inst(self, it, inst_id, func);
                    if j == line_end {
                        wln(self, "    p_print_line_end();");
                        line_end = -1;
                    }
                    if g_c_dbg && cg_is_call(it) {
                        // back in this frame after the callee's record
                        wln(self, "    __p_dbg_cur = &__p_df;");
                    }
                    if mc_lines && cg_is_call(it) {
                        // the callee may have stored its own line
                        mc_line = 0;
                    }
                    if !g_c_uses_dl {
                        cg_note_dl_call(it);
                    }
                }
                OptInst::None => {
                }
            }
            j = j + 1;
        }
        b = b + 1;
    }
    if last_line > 0 {
        // the rest of the file is the C file's own lines again
        wln(self, "#line " + int_to_str(g_c_line + 2) + " \"" + g_c_dbg_cfile_esc + "\"");
    }

    if self.cur_fn_c_ret_is_void {
        wln(self, "    return;");
    } else {
        wln(self, "    return 0;");
    }
    wln(self, "}");
    wln(self, "");
}

/// println (lower.fd): the value's Print (instruction j of the block, `it`),
/// then a ConstStr "\n" and its Print. gen_function writes the two under
/// one stdout lock (p_print_line_begin / _end): no other thread's output
/// lands between the text and its newline.
fn cg_println_pair(func: IrFunction, block: BasicBlock, j: i64, it: Inst) -> bool {
    match it {
        Inst::Print(_, _) => {
        }
        _ => {
            return false;
        }
    }
    if j + 2 >= block.instructions.len() {
        return false;
    }
    var nl_id: i64 = block.instructions.get(j + 1);
    match find_inst(func.insts, nl_id) {
        OptInst::Some(nl) => {
            match nl {
                Inst::ConstStr(s) => {
                    if s != "\n" {
                        return false;
                    }
                }
                _ => {
                    return false;
                }
            }
        }
        OptInst::None => {
            return false;
        }
    }
    match find_inst(func.insts, block.instructions.get(j + 2)) {
        OptInst::Some(pr) => {
            match pr {
                Inst::Print(pv, _) => {
                    return pv == nl_id;
                }
                _ => {
                    return false;
                }
            }
        }
        OptInst::None => {
            return false;
        }
    }
    return false;
}

/// The C type and core's element code word (vec_code_word) of a Vec's
/// elements, from the IR type of the Vec value: "" when it is not a Vec of
/// integers or bools. Words (i64/u64) have code word 0.
fn cg_vec_elem_c(func: IrFunction, v: i64) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    match value_ty_for_id(func, v) {
        IrType::Generic(n, targs) => {
            if n != "Vec" || targs.len() != 1 {
                return out;
            }
            var ct: str = "";
            var cw: str = "";
            match targs.get(0) {
                IrType::U8 => {
                    ct = "uint8_t";
                    cw = "(P_VEC_TAG_C + 9)";
                }
                IrType::Bool => {
                    ct = "uint8_t";
                    cw = "(P_VEC_TAG_C + 9)";
                }
                IrType::I8 => {
                    ct = "int8_t";
                    cw = "(P_VEC_TAG_C + 7)";
                }
                IrType::U16 => {
                    ct = "uint16_t";
                    cw = "(P_VEC_TAG_C + 10)";
                }
                IrType::I16 => {
                    ct = "int16_t";
                    cw = "(P_VEC_TAG_C + 6)";
                }
                IrType::U32 => {
                    ct = "uint32_t";
                    cw = "(P_VEC_TAG_C + 12)";
                }
                IrType::I32 => {
                    ct = "int32_t";
                    cw = "(P_VEC_TAG_C + 4)";
                }
                IrType::I64 => {
                    ct = "int64_t";
                    cw = "0";
                }
                IrType::U64 => {
                    ct = "int64_t";
                    cw = "0";
                }
                _ => {
                    return out;
                }
            }
            out.push(ct);
            out.push(cw);
        }
        _ => {
        }
    }
    return out;
}

/// Vec_get/Vec_set/Vec_push on a Vec of integers or bools, inline at the
/// element size the IR type says. The fast path checks the Vec really is
/// stored that way (its code word), is not shared (capacity >= 0) and owns
/// no elements (+32 zero) for a write, and the index is in bounds (unless a
/// counted loop proved it); anything else calls core's function, which
/// behaves the same and panics where it must. True when generated.
fn cg_inline_typed_vec(self: &mut CCodeGen, func: IrFunction, fname: str, c_fname: str, id: i64, args: Vec<i64>) -> bool {
    var et: Vec<str> = cg_vec_elem_c(func, args.get(1));
    if et.len() != 2 {
        return false;
    }
    var ct: str = et.get(0);
    var cw: str = et.get(1);
    var env: str = "(void*)" + val_name(self, args.get(0));
    var hv: str = "(int64_t)(intptr_t)" + val_name(self, args.get(1));
    var hp: str = "((int64_t*)(intptr_t)" + val_name(self, args.get(1)) + ")";
    var dataw: str = "((" + ct + "*)(intptr_t)" + hp + "[0])";
    var checked: bool = !cg_unchecked(self, id);
    if fname == "Vec_get" {
        var iv: str = "(int64_t)" + val_name(self, args.get(2));
        var cond: str = hp + "[3] == " + cw;
        if checked {
            cond = cond + " && (uint64_t)" + iv + " < (uint64_t)" + hp + "[1]";
        }
        var dst: str = val_name(self, id);
        wln(self, "    if (P_LIKELY_C(" + cond + ")) " + dst + " = " + dataw + "[" + iv + "];");
        wln(self, "    else " + dst + " = Vec_get(" + env + ", " + hv + ", " + iv + ");");
        return true;
    }
    if fname == "Vec_set" {
        var iv2: str = "(int64_t)" + val_name(self, args.get(2));
        var xv: str = "(int64_t)" + val_name(self, args.get(3));
        // LF16: a Vec with one owner (cg_mark_sole_vecs) never shares its
        // buffer, so its capacity is not tested for a copy-on-write share
        var cond2: str = hp + "[3] == " + cw + " && " + hp + "[2] >= 0 && " + hp + "[4] == 0";
        if cg_sole_vec(self, args.get(1)) {
            cond2 = hp + "[3] == " + cw + " && " + hp + "[4] == 0";
        }
        if checked {
            cond2 = cond2 + " && (uint64_t)" + iv2 + " < (uint64_t)" + hp + "[1]";
        }
        wln(self, "    if (P_LIKELY_C(" + cond2 + ")) " + dataw + "[" + iv2 + "] = (" + ct + ")" + xv + ";");
        wln(self, "    else Vec_set(" + env + ", " + hv + ", " + iv2 + ", " + xv + ");");
        return true;
    }
    // push: room in an unshared buffer (a shared one has a negative capacity)
    var pv: str = "(int64_t)" + val_name(self, args.get(2));
    wln(self, "    { int64_t __pl = " + hp + "[1];");
    wln(self, "      if (P_LIKELY_C(" + hp + "[3] == " + cw + " && " + hp + "[4] == 0 && __pl < " + hp + "[2])) { " + dataw + "[__pl] = (" + ct + ")" + pv + "; " + hp + "[1] = __pl + 1; }");
    wln(self, "      else Vec_push(" + env + ", " + hv + ", " + pv + "); }");
    return true;
}

/// A switch key as a C constant (INT64_MIN has no literal of its own).
fn c_switch_key(k: i64) -> str {
    if k == -9223372036854775807 - 1 {
        return "(-9223372036854775807LL - 1)";
    }
    return int_to_str(k) + "LL";
}

fn cg_unchecked(self: &CCodeGen, id: i64) -> bool {
    return id >= 0 && id < self.unchecked.len() && (self.unchecked.get(id) & 1) != 0;
}

/// F9: `dst = p_vec_get(v, i)` (an index read, a for-in element) written
/// as a read of the element's 64-bit word, the way core's Vec_get reads it
/// (__p_vec_get_u: the word, or the element at its size when the Vec is
/// stored that way), then turned into dst's type. p_vec_get returns a
/// void*, which is 32 bits on wasm32 (WASI through C): an f64's high half
/// and a negative i64's sign were lost (test_vec_f64, test_vec_builtins).
/// The same as before where a pointer is 64 bits: 0 for no Vec, a panic
/// for an index out of range (V1c: it read 0; core's Vec_get panics), no
/// test when a counted loop proved the index in range.
fn cg_vec_get_word(self: &mut CCodeGen, func: IrFunction, id: i64, vec: str, idx: str, unchecked: bool) {
    var dst: str = val_name(self, id);
    var dst_ty: IrType = value_ty_for_id(func, id);
    wln(self, "    {");
    wln(self, "        int64_t* __gh = (int64_t*)(intptr_t)(" + vec + ");");
    wln(self, "        int64_t __gi = (int64_t)(" + idx + ");");
    if unchecked {
        wln(self, "        int64_t __gw = __p_vec_get_u(0, (int64_t)(intptr_t)__gh, __gi);");
    } else {
        // V1c: an index out of range panics, as core's Vec_get (§8.2)
        wln(self, "        if (__gh && (__gi < 0 || __gi >= __gh[1])) p_panic(\"Vec index out of bounds\");");
        wln(self, "        int64_t __gw = __gh ? __p_vec_get_u(0, (int64_t)(intptr_t)__gh, __gi) : 0;");
    }
    var conv: str = "(" + c_type(dst_ty) + ")__gw";
    match dst_ty {
        IrType::F64 => {
            conv = "((union { int64_t i; double d; }){ .i = __gw }).d";
        }
        IrType::F32 => {
            // BG7: a Vec<f32> element word holds the single's F64 bits
            // (the OP21 layout canon: cast_arg stores an f32 through
            // `union { double d; int64_t i; }`), so the whole word is
            // punned to a double and narrowed, as the Call result path
            // does. The old low-32 pun read the double's low mantissa
            // bits (1.5 printed 0).
            conv = "(float)((union { int64_t i; double d; }){ .i = __gw }).d";
        }
        IrType::Bool => {
            conv = "(bool)(__gw != 0)";
        }
        IrType::Array(_, _) => {
            // declared void* (the array's address, CI5)
            conv = "(void*)(intptr_t)__gw";
        }
        IrType::Void => {
            conv = "__gw";
        }
        IrType::Never => {
            conv = "__gw";
        }
        _ => {
            if str_ends_with(c_type(dst_ty), "*") {
                conv = "(void*)(intptr_t)__gw";
            }
        }
    }
    wln(self, "        " + dst + " = " + conv + ";");
    wln(self, "    }");
}

/// LF16: Vec handles with one owner, provably (cg_mark_sole_vecs). false:
/// every Vec_set tests for a shared buffer.
const CG_SOLE_VECS: bool = true;
/// The flag in `unchecked` (above peir_unchecked_ops' bits 1 and 2) of a
/// value loaded from a sole-owner Vec's slot.
const CG_SOLE_BIT: i64 = 1024;

fn cg_sole_vec(self: &CCodeGen, id: i64) -> bool {
    return id >= 0 && id < self.unchecked.len() && (self.unchecked.get(id) & CG_SOLE_BIT) != 0;
}

/// core's Vec functions that take the Vec at argument 1 (after the env)
/// and never make its buffer shared: they read it, change it in place, copy
/// from it or free it. Vec_share / Vec_share_deep are not among them.
fn cg_sole_safe_call(n: str) -> bool {
    return n == "Vec_push" || n == "Vec_push_mem" || n == "Vec_set" || n == "Vec_set_mem" || n == "Vec_insert" || n == "Vec_insert_mem" || n == "Vec_get" || n == "Vec_len" || n == "Vec_is_empty" || n == "Vec_elem_addr" || n == "Vec_pop" || n == "Vec_clear" || n == "Vec_capacity" || n == "Vec_contains" || n == "Vec_first" || n == "Vec_last" || n == "Vec_truncate" || n == "Vec_reverse" || n == "Vec_extend" || n == "Vec_remove" || n == "Vec_clone" || n == "Vec_to_str" || n == "Vec_sort" || n == "Vec_drop" || n == "Vec_drop_inplace" || n == "Vec_drop_strs" || n == "Vec_drop_vecs";
}

/// LF16: a Vec made in this function (Vec_new, Vec_new_typed, or the stack
/// header of LF13's Vec_init_typed) whose handle h is stored into one stack
/// slot S and nowhere else, where S is only loaded and stored (h, or a
/// zero), and every value loaded from S is only argument 1 of a call in
/// cg_sole_safe_call: nothing shares its buffer, so its capacity is never
/// the negative mark of a shared one. Each such load gets CG_SOLE_BIT.
fn cg_mark_sole_vecs(f: &IrFunction, marks: &mut Vec<i64>) {
    var nm: i64 = marks.len();
    // quick exit: no Vec made here
    var any: bool = false;
    var i: i64 = 0;
    while i < f.insts.len() && !any {
        match f.insts.get(i).inst {
            Inst::Call(cn, _, _, _) => {
                any = cn == "Vec_new_typed" || cn == "Vec_new" || cn == "Vec_init_typed" || cn == "Vec_new_sized" || cn == "Vec_filled_typed" || cn == "Vec_init_filled";
            }
            _ => {
            }
        }
        i = i + 1;
    }
    if !any {
        return;
    }
    var created: Vec<i64> = Vec::new();
    var slot_ok: Vec<i64> = Vec::new();
    var h_of: Vec<i64> = Vec::new();
    var slot_of: Vec<i64> = Vec::new();
    var loaded_from: Vec<i64> = Vec::new();
    var z: i64 = 0;
    while z < nm {
        created.push(0);
        slot_ok.push(0);
        h_of.push(-1);
        slot_of.push(-1);
        loaded_from.push(-1);
        z = z + 1;
    }
    i = 0;
    while i < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(i);
        if ve.id >= 0 && ve.id < nm {
            match ve.inst {
                Inst::Call(cn, cargs, _, _) => {
                    // a filled Vec's buffer is its own too (capacity n >= 0)
                    if (cn == "Vec_new_typed" && cargs.len() == 3) || (cn == "Vec_new" && cargs.len() == 1) || (cn == "Vec_init_typed" && cargs.len() == 4) || (cn == "Vec_new_sized" && cargs.len() == 2) || (cn == "Vec_filled_typed" && cargs.len() == 5) || (cn == "Vec_init_filled" && cargs.len() == 6) {
                        created.set(ve.id, 1);
                    }
                }
                Inst::Alloca(_, _) => {
                    slot_ok.set(ve.id, 1);
                }
                Inst::Load(lp, _) => {
                    if lp >= 0 && lp < nm {
                        loaded_from.set(ve.id, lp);
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1;
    }
    // which h goes into which slot (one h per slot, one slot per h)
    i = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Store(sp, sv, _) => {
                if sp >= 0 && sp < nm && sv >= 0 && sv < nm && created.get(sv) == 1 {
                    if slot_of.get(sv) >= 0 && slot_of.get(sv) != sp {
                        created.set(sv, 0);
                    }
                    slot_of.set(sv, sp);
                    if h_of.get(sp) == -1 {
                        h_of.set(sp, sv);
                    } else if h_of.get(sp) != sv {
                        h_of.set(sp, -2);
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    // every use checked
    i = 0;
    while i < f.insts.len() {
        var ue: ValueIdInst = f.insts.get(i);
        var refs: Vec<i64> = inst_value_refs(&ue.inst);
        var r: i64 = 0;
        while r < refs.len() {
            var u: i64 = refs.get(r);
            if u >= 0 && u < nm {
                if created.get(u) == 1 {
                    var fine_h: bool = false;
                    match ue.inst {
                        Inst::Store(hsp, hsv, _) => {
                            fine_h = hsv == u && hsp != u;
                        }
                        _ => {
                        }
                    }
                    if !fine_h {
                        created.set(u, 0);
                    }
                }
                if slot_ok.get(u) == 1 {
                    var fine_s: bool = false;
                    match ue.inst {
                        Inst::Load(lsp, _) => {
                            fine_s = lsp == u;
                        }
                        Inst::Store(ssp, ssv, _) => {
                            fine_s = ssp == u && ssv != u && (ssv == h_of.get(u) || cg_sole_zero(f, ssv));
                        }
                        _ => {
                        }
                    }
                    if !fine_s {
                        slot_ok.set(u, 0);
                    }
                }
                var ls: i64 = loaded_from.get(u);
                if ls >= 0 && slot_ok.get(ls) == 1 {
                    var fine_l: bool = false;
                    match ue.inst {
                        Inst::Call(lcn, lcargs, _, _) => {
                            if cg_sole_safe_call(lcn) && lcargs.len() > 1 && lcargs.get(1) == u {
                                fine_l = true;
                                var a: i64 = 0;
                                while a < lcargs.len() {
                                    if a != 1 && lcargs.get(a) == u {
                                        fine_l = false;
                                    }
                                    a = a + 1;
                                }
                            }
                        }
                        _ => {
                        }
                    }
                    if !fine_l {
                        slot_ok.set(ls, 0);
                    }
                }
            }
            r = r + 1;
        }
        i = i + 1;
    }
    // the loads of the slots that qualify
    i = 0;
    while i < f.insts.len() {
        var le: ValueIdInst = f.insts.get(i);
        match le.inst {
            Inst::Load(sl, _) => {
                if sl >= 0 && sl < nm && le.id >= 0 && le.id < nm && slot_ok.get(sl) == 1 {
                    var h: i64 = h_of.get(sl);
                    if h >= 0 && created.get(h) == 1 && slot_of.get(h) == sl {
                        marks.set(le.id, marks.get(le.id) | CG_SOLE_BIT);
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
}

/// A zero or null, or a cast of one (what a moved-out slot is set to).
fn cg_sole_zero(f: &IrFunction, v: i64) -> bool {
    match IrFunction_get_inst(f, v) {
        OptInst::Some(inst) => {
            match inst {
                Inst::ConstNull(_) => {
                    return true;
                }
                Inst::ConstInt(c, _) => {
                    return c == 0;
                }
                Inst::BitCast(x, _, _) => {
                    return cg_sole_zero(f, x);
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return false;
}

fn gen_inst(self: &mut CCodeGen, inst: Inst, id: i64, func: IrFunction) -> void {
    var dst: str = val_name(self, id);
    match inst {
        Inst::ConstInt(value, _) => {
            wln(self, "    " + dst + " = " + int_to_str(value) + "LL;");
        }
        Inst::ConstFloat(value, ty) => {
            // B5: Use a union compound literal to reinterpret the IEEE 754
            // bits as a float - this preserves NaN payloads, -0.0, and Inf
            // bit patterns that are lost when converting to a decimal string.
            // Matches the Rust codegen (src/codegen_c.rs ConstFloat handler).
            if ir_type_eq(ty, IrType::F32) {
                var bits: i64 = p_f32_to_bits(value);
                wln(self, "    " + dst + " = ((union { uint32_t u; float f; }){ .u = " + int_to_str(bits) + "U }).f;");
            } else {
                var bits: i64 = p_f64_to_bits(value);
                wln(self, "    " + dst + " = ((union { uint64_t u; double f; }){ .u = " + int_to_str(bits) + "ULL }).f;");
            }
        }
        Inst::ConstBool(value) => {
            if value {
                wln(self, "    " + dst + " = true;");
            } else {
                wln(self, "    " + dst + " = false;");
            }
        }
        Inst::ConstStr(value) => {
            match string_consts_get(self, value) {
                OptStr::Some(name) => {
                    wln(self, "    " + dst + " = " + name + ";");
                }
                OptStr::None => {
                    var escaped: str = escape_c_string(value);
                    wln(self, "    " + dst + " = \"" + escaped + "\";");
                }
            }
        }
        Inst::ConstFnRef(name) => {
            if str_starts_with(name, "__c_fn_") {
                wln(self, "    " + dst + " = (int64_t)" + c_fn_name(sanitize_c_name(self, c_fn_target(name))) + ";");
                return;
            }
            match string_consts_get(self, name) {
                OptStr::Some(cname) => {
                    wln(self, "    " + dst + " = (int64_t)" + cname + ";");
                }
                OptStr::None => {
                    var escaped: str = escape_c_string(name);
                    wln(self, "    " + dst + " = (int64_t)\"" + escaped + "\";");
                }
            }
        }
        Inst::ConstNull(_) => {
            wln(self, "    " + dst + " = NULL;");
        }
        Inst::GlobalAddr(name, _) => {
            var cast: str = int_ptr_cast(value_ty_for_id(func, id));
            if cast == "" {
                cast = "(int64_t)(intptr_t)";
            }
            wln(self, "    " + dst + " = " + cast + "&" + global_c_name(name) + ";");
        }
        Inst::BinOp(op, left, right, ty) => {
            var l_raw: str = val_name(self, left);
            var r_raw: str = val_name(self, right);
            var l_ty: IrType = value_ty_for_id(func, left);
            var r_ty: IrType = value_ty_for_id(func, right);
            var l: str = l_raw;
            var r: str = r_raw;
            if is_ptr_type(l_ty) {
                l = "(int64_t)" + l_raw;
            }
            if is_ptr_type(r_ty) {
                r = "(int64_t)" + r_raw;
            }
            var cop: str = binop_to_str(op);
            // Float modulo: C doesn't support % on doubles, use fmod()
            var is_float_mod: bool = false;
            var fmod_fn: str = "fmod";
            match op {
                BinOp::Mod => {
                    match ty {
                        IrType::F64 => {
                            is_float_mod = true;
                        }
                        IrType::F32 => {
                            // 2g.13: `%` on floats is not C; fmodf keeps f32
                            is_float_mod = true;
                            fmod_fn = "fmodf";
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            // Integer arithmetic has one meaning (see gen_arith_helpers).
            var int_n: str = "";
            if !is_ptr_type(l_ty) && !is_ptr_type(r_ty) {
                int_n = c_int_helper(ty);
            }
            var unsigned_cmp: bool = ir_type_eq(l_ty, IrType::U64) || ir_type_eq(r_ty, IrType::U64);
            if str_len(int_n) > 0 && gen_int_arith(self, func.is_wrapping || cg_unchecked(self, id), dst, op, int_n, c_type(ty), l, r) {  // done
            } else if unsigned_cmp && c_is_ordered_cmp(op) {
                wln(self, "    " + dst + " = (uint64_t)" + l + " " + cop + " (uint64_t)" + r + ";");
            } else if is_float_mod {
                wln(self, "    " + dst + " = " + fmod_fn + "(" + l + ", " + r + ");");
            } else if is_ptr_type(ty) {
                wln(self, "    " + dst + " = (void*)(intptr_t)(" + l + " " + cop + " " + r + ");");
            } else {
                wln(self, "    " + dst + " = " + l + " " + cop + " " + r + ";");
            }
        }
        Inst::UnaryOp(op, operand, _) => {
            var o: str = val_name(self, operand);
            var uop: str = unaryop_to_str(op);
            wln(self, "    " + dst + " = " + uop + o + ";");
        }
        Inst::Alloca(ty, _) => {
            // The alloca() call itself is emitted once in the function
            // prologue (see gen_function's alloca pre-pass): an alloca
            // inside a loop block would otherwise burn fresh stack on
            // every iteration — alloca memory is only reclaimed at
            // function return — and overflow the native stack on
            // high-trip-count loops. The slot is reused across
            // iterations; only the zero-init stays here so each
            // iteration still sees cleared storage.
            var size: i64 = alloca_size(self, ty);
            wln(self, "    memset(" + dst + ", 0, " + int_to_str(size) + ");");
        }
        Inst::Load(ptr, ty) => {
            var p: str = val_name(self, ptr);
            var load_arr: bool = false;
            match ty {
                IrType::Array(_, _) => {
                    // CI5: the word the slot holds, the array's address
                    // (declared void* above)
                    load_arr = true;
                }
                _ => {
                }
            }
            if is_ptr_type(ty) || load_arr {
                wln(self, "    " + dst + " = *(void**)" + p + ";");
            } else {
                wln(self, "    " + dst + " = *(" + c_type(ty) + "*)" + p + ";");
            }
        }
        Inst::Store(ptr, value, store_ty) => {
            var p: str = val_name(self, ptr);
            var v: str = val_name(self, value);
            // Determine the effective store type, matching the Rust codegen:
            // 1. If store_ty is explicitly set (e.g. by load_enum_field), use it
            // 2. If the pointer has a Ptr(T) type, use the pointee type T
            // 3. Fall back to the value's type
            var effective_ty: IrType = value_ty_for_id(func, value);
            match store_ty {
                OptIrType::Some(ty) => {
                    effective_ty = ty;
                }
                OptIrType::None => {
                    // Check if the pointer's pointee type is available
                    var ptr_meta_ty: IrType = value_ty_for_id(func, ptr);
                    match ptr_meta_ty {
                        IrType::Ptr(inner) => {
                            // Use the pointee type for the store (matches Rust codegen)
                            effective_ty = cc_box_ir_type_unbox(inner);
                        }
                        _ => {
                        }
                    }
                }
            }
            // Struct store: copy the full struct content via memcpy, not just
            // 8 bytes. The value is a pointer to the source struct data, and
            // the destination is a pointer to the target buffer. This is
            // critical for load_enum_field to correctly extract inline enum
            // payloads (e.g. Expr from ParseResultExpr::Ok(e)).
            match effective_ty {
                IrType::Struct(sname) => {
                    var size: i64 = 8;
                    var si: i64 = 0;
                    while si < self.struct_layouts.len() {
                        if self.struct_layouts.get(si).name == sname {
                            size = self.struct_layouts.get(si).layout.size;
                            break;
                        }
                        si = si + 1;
                    }
                    wln(self, "    memcpy(" + p + ", " + v + ", " + int_to_str(size) + ");");
                }
                _ => {
                    var val_ty: IrType = effective_ty;
                    if is_ptr_type(val_ty) {
                        wln(self, "    *(void**)" + p + " = (void*)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::F64) {
                        wln(self, "    *(double*)" + p + " = " + v + ";");
                    } else if ir_type_eq(val_ty, IrType::F32) {
                        wln(self, "    *(float*)" + p + " = " + v + ";");
                    } else if ir_type_eq(val_ty, IrType::Bool) {
                        wln(self, "    *(bool*)" + p + " = " + v + ";");
                    } else if ir_type_eq(val_ty, IrType::I8) {
                        wln(self, "    *(int8_t*)" + p + " = (int8_t)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::I16) {
                        wln(self, "    *(int16_t*)" + p + " = (int16_t)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::I32) {
                        wln(self, "    *(int32_t*)" + p + " = (int32_t)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::U8) {
                        wln(self, "    *(uint8_t*)" + p + " = (uint8_t)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::U16) {
                        wln(self, "    *(uint16_t*)" + p + " = (uint16_t)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::U32) {
                        wln(self, "    *(uint32_t*)" + p + " = (uint32_t)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::U64) {
                        wln(self, "    *(uint64_t*)" + p + " = (uint64_t)" + v + ";");
                    } else {
                        wln(self, "    *(int64_t*)" + p + " = (int64_t)" + v + ";");
                    }
                }
            }
        }
        Inst::GetFieldPtr(struct_ptr, field_index, _) => {
            var s: str = val_name(self, struct_ptr);
            // Look up the actual field offset from the struct layout.
            // Falls back to field_index * 8 if the struct can't be determined.
            var ptr_ty: IrType = value_ty_for_id(func, struct_ptr);
            var offset: i64 = field_index * 8;
            match ptr_ty {
                IrType::Ptr(inner) => {
                    match cc_box_ir_type_unbox(inner) {
                        IrType::Struct(sn) => {
                            offset = lookup_field_offset(self, sn, field_index, offset);
                        }
                        _ => {
                        }
                    }
                }
                IrType::Struct(sn) => {
                    offset = lookup_field_offset(self, sn, field_index, offset);
                }
                _ => {
                }
            }
            wln(self, "    " + dst + " = (char*)" + s + " + " + int_to_str(offset) + ";");
        }
        Inst::GetElemPtr(array_ptr, index, elem_ty) => {
            var a: str = val_name(self, array_ptr);
            var i: str = val_name(self, index);
            var size: i64 = ir_type_size(elem_ty);
            wln(self, "    " + dst + " = (char*)" + a + " + (" + i + " * " + int_to_str(size) + ");");
        }
        Inst::Jump(target) => {
            wln(self, "    goto bb" + int_to_str(target) + ";");
        }
        Inst::Branch(cond, then, else_) => {
            var c: str = val_name(self, cond);
            wln(self, "    if (" + c + ") goto bb" + int_to_str(then) + ";");
            wln(self, "    else goto bb" + int_to_str(else_) + ";");
        }
        Inst::Switch(sv, keys, targets, dflt) => {
            // ME28: a C switch (the C compiler picks a jump table or a tree)
            wln(self, "    switch ((int64_t)" + val_name(self, sv) + ") {");
            var swi: i64 = 0;
            while swi < keys.len() && swi < targets.len() {
                wln(self, "    case " + c_switch_key(keys.get(swi)) + ": goto bb" + int_to_str(targets.get(swi)) + ";");
                swi = swi + 1;
            }
            wln(self, "    default: goto bb" + int_to_str(dflt) + ";");
            wln(self, "    }");
        }
        Inst::Return(value) => {
            match value {
                OptValueId::Some(v) => {
                    if self.cur_fn_c_ret_is_void {
                        wln(self, "    return;");
                    } else {
                        // Cast a pointer returned from an integer function,
                        // or an integer from a pointer function (as the Rust
                        // backend does; GCC 14 / Clang 16+ reject it bare).
                        var vn: str = val_name(self, v);
                        var val_is_ptr: bool = false;
                        match value_ty_for_id(func, v) {
                            IrType::Ptr(_) => {
                                val_is_ptr = true;
                            }
                            IrType::Opaque(_) => {
                                val_is_ptr = true;
                            }
                            IrType::Generic(_, _) => {
                                val_is_ptr = true;
                            }
                            _ => {
                            }
                        }
                        var ret: str = self.cur_fn_c_ret_type;
                        var ret_is_ptr: bool = ret == "void*" || str_starts_with(ret, "struct ");
                        if val_is_ptr && !ret_is_ptr {
                            vn = "(" + ret + ")(intptr_t)" + vn;
                        } else if !val_is_ptr && ret_is_ptr {
                            vn = "(void*)(intptr_t)" + vn;
                        }
                        wln(self, "    return " + vn + ";");
                    }
                }
                OptValueId::None => {
                    if self.cur_fn_c_ret_is_void {
                        wln(self, "    return;");
                    } else {
                        wln(self, "    return 0;");
                    }
                }
            }
        }
        Inst::Unreachable => {
            wln(self, "    abort();");
        }
        Inst::Call(fname, args, ret_ty, _) => {
            var c_fname: str = sanitize_c_name(self, fname);
            // Counting a string: inline, a call only at the last owner
            // (proposal 0004; Str_dup gives back its argument)
            if (fname == "Str_dup" || fname == "Str_drop") && args.len() == 2 {
                var sv: str = val_name(self, args.get(1));
                // While a region is open, core decides (proposal 0005: a
                // string kept outside its region is copied out; dropping
                // one of a clean region waits for its end)
                if fname == "Str_dup" {
                    wln(self, "    if (P_UNLIKELY(__p_rs.live)) " + val_name(self, id) + " = Str_dup(0, (int64_t)(intptr_t)(" + sv + "));");
                    wln(self, "    else { " + val_name(self, id) + " = (int64_t)(intptr_t)(" + sv + "); P_STR_DUP(" + val_name(self, id) + "); }");
                } else {
                    wln(self, "    if (P_UNLIKELY(__p_rs.live)) Str_drop(0, (int64_t)(intptr_t)(" + sv + "));");
                    wln(self, "    else P_STR_DROP((intptr_t)(" + sv + "));");
                }
                return;
            }
            // In bounds: a counted loop proved it
            if cg_unchecked(self, id) {
                if fname == "Vec_get" {
                    c_fname = "__p_vec_get_u";
                }
                // Vec_set stays core's: it drops the old element (proposal 0004)
                if fname == "p_vec_get" {
                    c_fname = "__p_pvec_get_u";
                }
                if fname == "p_vec_set" {
                    c_fname = "__p_pvec_set_u";
                }
            }
            // F9: an element read (`v[i]`, for-in) as the 64-bit word core
            // stores, not through p_vec_get's void*, which is 32 bits on
            // wasm32 (the high half of an f64 or a negative i64 was lost)
            if fname == "p_vec_get" && args.len() == 2 && !is_void_or_never(ret_ty) {
                var gw_vec: str = val_name(self, args.get(0));
                var gw_idx: str = val_name(self, args.get(1));
                var gw_unchecked: bool = cg_unchecked(self, id);
                cg_vec_get_word(self, func, id, gw_vec, gw_idx, gw_unchecked);
                return;
            }
            // A Vec of integers or bools whose element type the call site
            // knows: get/set/push inline at that size, the call to core only
            // when the Vec is not stored that way, is shared or owns its
            // elements, or the index is out of bounds (core panics)
            if (fname == "Vec_get" && args.len() == 3) || (fname == "Vec_set" && args.len() == 4) || (fname == "Vec_push" && args.len() == 3) {
                if cg_inline_typed_vec(self, func, fname, c_fname, id, args) {
                    return;
                }
            }

            // Special-case: print is polymorphic - dispatch based on arg type
            if fname == "print" && args.len() > 0 {
                var arg_val: i64 = args.get(0);
                var arg_ty: IrType = value_ty_for_id(func, arg_val);
                var arg_str: str = val_name(self, arg_val);
                match arg_ty {
                    IrType::Opaque(oname) => {
                        if oname == "any" {
                            wln(self, "    p_print_int((int64_t)" + arg_str + ");");
                        } else if oname == "Vec" {
                            wln(self, "    { char* _s = (char*)Vec_to_str(0, (int64_t)" + arg_str + "); p_print_str(_s); Str_drop(0, (int64_t)(intptr_t)_s); }");
                        } else if oname == "HashMap" {
                            wln(self, "    { char* _s = p_to_str_map((PMap*)" + arg_str + "); p_print_str(_s); p_str_free_c(_s); }");
                        } else if oname == "Tensor" {
                            wln(self, "    { char* _s = p_tensor_to_str((PTensor*)" + arg_str + "); p_print_str(_s); p_str_free_c(_s); }");
                        } else {
                            wln(self, "    p_print_str(" + arg_str + ");");
                        }
                    }
                    IrType::Generic(gname, _) => {
                        if gname == "Vec" {
                            wln(self, "    { char* _s = (char*)Vec_to_str(0, (int64_t)" + arg_str + "); p_print_str(_s); Str_drop(0, (int64_t)(intptr_t)_s); }");
                        } else if gname == "HashMap" {
                            wln(self, "    { char* _s = p_to_str_map((PMap*)" + arg_str + "); p_print_str(_s); p_str_free_c(_s); }");
                        } else {
                            wln(self, "    p_print_int((int64_t)" + arg_str + ");");
                        }
                    }
                    IrType::Ptr(_) => {
                        wln(self, "    p_print_str(" + arg_str + ");");
                    }
                    IrType::F64 => {
                        wln(self, "    p_print_float(" + arg_str + ");");
                    }
                    IrType::Bool => {
                        wln(self, "    p_print_bool(" + arg_str + ");");
                    }
                    _ => {
                        wln(self, "    p_print_int((int64_t)" + arg_str + ");");
                    }
                }
                if !is_void_or_never(ret_ty) {
                    wln(self, "    " + dst + " = 0;");
                }
                return;
            }

            // Special-case: println is polymorphic - dispatch on value (2nd arg)
            if fname == "println" && args.len() >= 2 {
                var arg_val: i64 = args.get(1);
                var arg_ty: IrType = value_ty_for_id(func, arg_val);
                var arg_str: str = val_name(self, arg_val);
                // one line under the stdout lock (cg_println_pair)
                wln(self, "    p_print_line_begin();");
                match arg_ty {
                    IrType::Opaque(oname) => {
                        if oname == "any" {
                            wln(self, "    p_print_int((int64_t)" + arg_str + ");");
                        } else if oname == "Vec" {
                            wln(self, "    { char* _s = (char*)Vec_to_str(0, (int64_t)" + arg_str + "); p_print_str(_s); Str_drop(0, (int64_t)(intptr_t)_s); }");
                        } else if oname == "HashMap" {
                            wln(self, "    { char* _s = p_to_str_map((PMap*)" + arg_str + "); p_print_str(_s); p_str_free_c(_s); }");
                        } else if oname == "Tensor" {
                            wln(self, "    { char* _s = p_tensor_to_str((PTensor*)" + arg_str + "); p_print_str(_s); p_str_free_c(_s); }");
                        } else {
                            wln(self, "    p_print_str(" + arg_str + ");");
                        }
                    }
                    IrType::Generic(gname, _) => {
                        if gname == "Vec" {
                            wln(self, "    { char* _s = (char*)Vec_to_str(0, (int64_t)" + arg_str + "); p_print_str(_s); Str_drop(0, (int64_t)(intptr_t)_s); }");
                        } else if gname == "HashMap" {
                            wln(self, "    { char* _s = p_to_str_map((PMap*)" + arg_str + "); p_print_str(_s); p_str_free_c(_s); }");
                        } else {
                            wln(self, "    p_print_int((int64_t)" + arg_str + ");");
                        }
                    }
                    IrType::Ptr(_) => {
                        wln(self, "    p_print_str(" + arg_str + ");");
                    }
                    IrType::F64 => {
                        wln(self, "    p_print_float(" + arg_str + ");");
                    }
                    IrType::Bool => {
                        wln(self, "    p_print_bool(" + arg_str + ");");
                    }
                    _ => {
                        wln(self, "    p_print_int((int64_t)" + arg_str + ");");
                    }
                }
                wln(self, "    p_print_newline();");
                wln(self, "    p_print_line_end();");
                if !is_void_or_never(ret_ty) {
                    wln(self, "    " + dst + " = 0;");
                }
                return;
            }

            // Special-case: p_to_str is polymorphic - dispatch based on arg type
            if fname == "p_to_str" && args.len() > 0 {
                var arg_val: i64 = args.get(0);
                var arg_ty: IrType = value_ty_for_id(func, arg_val);
                var arg_str: str = val_name(self, arg_val);
                match arg_ty {
                    IrType::F64 => {
                        wln(self, "    " + dst + " = (void*)p_to_str_float(" + arg_str + ");");
                    }
                    IrType::F32 => {
                        wln(self, "    " + dst + " = (void*)p_to_str_float(" + arg_str + ");");
                    }
                    IrType::Opaque(oname) => {
                        if oname == "Vec" {
                            wln(self, "    " + dst + " = (void*)Vec_to_str(0, (int64_t)" + arg_str + ");");
                        } else if oname == "HashMap" {
                            wln(self, "    " + dst + " = (void*)p_to_str_map((PMap*)" + arg_str + ");");
                        } else if oname == "Tensor" {
                            wln(self, "    " + dst + " = (void*)p_tensor_to_str((PTensor*)" + arg_str + ");");
                        } else {
                            wln(self, "    " + dst + " = (void*)p_to_str_str((char*)" + arg_str + ");");
                        }
                    }
                    IrType::Generic(gname, _) => {
                        if gname == "Vec" {
                            wln(self, "    " + dst + " = (void*)Vec_to_str(0, (int64_t)" + arg_str + ");");
                        } else if gname == "HashMap" {
                            wln(self, "    " + dst + " = (void*)p_to_str_map((PMap*)" + arg_str + ");");
                        } else {
                            wln(self, "    " + dst + " = (void*)p_to_str((int64_t)" + arg_str + ");");
                        }
                    }
                    IrType::Bool => {
                        wln(self, "    " + dst + " = (void*)p_to_str_bool(" + arg_str + ");");
                    }
                    IrType::Ptr(_) => {
                        wln(self, "    " + dst + " = (void*)p_to_str_str((char*)" + arg_str + ");");
                    }
                    _ => {
                        wln(self, "    " + dst + " = (void*)p_to_str((int64_t)" + arg_str + ");");
                    }
                }
                return;
            }

            // Special-case: p_socket_write is called with 2 args (fd, str) by
            // stdlib but the C implementation needs 3 args (fd, buf, len).
            if fname == "p_socket_write" && args.len() == 2 {
                wln(self, "    " + dst + " = p_socket_write_str(" + val_name(self, args.get(0)) + ", " + val_name(self, args.get(1)) + ");");
                return;
            }

            var param_types: OptVecIrType = fn_param_types_get(self, fname);
            var arg_strs: str = "";
            var i: i64 = 0;
            while i < args.len() {
                if i > 0 {
                    arg_strs = arg_strs + ", ";
                }
                var a: i64 = args.get(i);
                var base: str = val_name(self, a);
                var arg_ty: IrType = value_ty_for_id(func, a);
                var cast: str = base;
                match param_types {
                    OptVecIrType::Some(pts) => {
                        if i < pts.len() {
                            cast = cast_arg(base, arg_ty, pts.get(i));
                        } else {
                            var is_varargs: bool = fname == "p_thread_spawn" || fname == "p_executor_spawn" || fname == "p_co_async";
                            if is_varargs && is_ptr_type(arg_ty) {
                                cast = "(int64_t)" + base;
                            }
                            // BG133: the runtime reads each argument as a
                            // word (va_arg int64_t): a float goes as its bits
                            // (the function's thunk, cg_thunk_native, turns
                            // them back), a bool or narrow integer widened
                            if is_varargs {
                                var prefix: i64 = 2;
                                if fname == "p_executor_spawn" {
                                    prefix = 3;
                                }
                                cast = cg_spawn_word_arg(self, func, args.get(prefix - 2), i - prefix + 1, cast, base, arg_ty);
                            }
                        }
                    }
                    OptVecIrType::None => {
                    }
                }
                // a function value passed to a C function's pointer parameter
                if cg_is_ext_fn_param(fname, i) {
                    cast = "(void*)(intptr_t)" + base;
                }
                arg_strs = arg_strs + cast;
                i = i + 1;
            }
            var callee_c_ret: str = c_ret_type(ret_ty);
            match fn_ret_types_get(self, fname) {
                OptIrType::Some(t) => {
                    callee_c_ret = c_ret_type(t);
                }
                OptIrType::None => {
                }
            }
            if callee_c_ret == "void" {
                wln(self, "    " + c_fname + "(" + arg_strs + ");");
                if !is_void_or_never(ret_ty) {
                    wln(self, "    " + dst + " = 0;");
                }
            } else {
                if is_void_or_never(ret_ty) {
                    wln(self, "    " + c_fname + "(" + arg_strs + ");");
                } else {
                    // Match Rust codegen: add return type cast based on dst type
                    var dst_ty: IrType = value_ty_for_id(func, id);
                    var dst_is_ptr: bool = is_ptr_type(dst_ty);
                    var callee_returns_int: bool = callee_c_ret == "int64_t" || callee_c_ret == "int32_t" || callee_c_ret == "int16_t" || callee_c_ret == "int8_t";
                    var callee_returns_ptr: bool = str_ends_with(callee_c_ret, "*");
                    var cast: str = "(int64_t)";
                    match dst_ty {
                        IrType::Ptr(_) => {
                            if dst_is_ptr && callee_returns_int {
                                cast = "(void*)";
                            } else {
                                cast = "";
                            }
                        }
                        IrType::Opaque(_) => {
                            if dst_is_ptr && callee_returns_int {
                                cast = "(void*)";
                            } else {
                                cast = "";
                            }
                        }
                        IrType::Generic(_, _) => {
                            if dst_is_ptr && callee_returns_int {
                                cast = "(void*)";
                            } else {
                                cast = "";
                            }
                        }
                        IrType::F64 => {
                            // Bug 3.19 fix: When the callee returns int64_t but
                            // the dst is f64, the int64 contains a float bit
                            // pattern (e.g. from Vec_get). Type-pun it back to
                            // double via a union instead of casting directly.
                            if callee_returns_int {
                                wln(self, "    " + dst + " = ((union { int64_t i; double d; }){ .i = " + c_fname + "(" + arg_strs + ") }).d;");
                                return;
                            }
                            // Same bit pattern behind a void* (p_vec_get on a
                            // Vec<f64>); a pointer cannot be cast to double.
                            if callee_returns_ptr {
                                wln(self, "    " + dst + " = ((union { int64_t i; double d; }){ .i = (int64_t)(intptr_t)" + c_fname + "(" + arg_strs + ") }).d;");
                                return;
                            }
                            cast = "(double)";
                        }
                        IrType::F32 => {
                            // Bug 3.19 fix: Same type-pun for f32. OP21
                            // (Nov 21 evening): the word holds the single's
                            // F64 bits (the Vec<f32> layout canon), so the
                            // full 64 bits are punned to a double and
                            // narrowed — the low-32 pun read denormal bits.
                            if callee_returns_int || callee_returns_ptr {
                                wln(self, "    " + dst + " = (float)((union { int64_t i; double d; }){ .i = (int64_t)(intptr_t)" + c_fname + "(" + arg_strs + ") }).d;");
                                return;
                            }
                            cast = "(float)";
                        }
                        IrType::Bool => {
                            cast = "(bool)";
                        }
                        _ => {
                            cast = "(int64_t)";
                        }
                    }
                    wln(self, "    " + dst + " = " + cast + c_fname + "(" + arg_strs + ");");
                }
            }
        }
        Inst::CallPtr(fn_ptr, args, ret_ty, _, has_env) => {
            var fp: str = val_name(self, fn_ptr);
            // Closures in Fides use string-based dispatch: the closure
            // struct's field 0 is a char* pointing to the function name.
            // We generate an inline if/else chain that compares the name
            // and calls the appropriate C function.

            // Build arg name strings
            var arg_strs: Vec<str> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() {
                arg_strs.push(val_name(self, args.get(ai)));
                ai = ai + 1;
            }

            // Find candidate functions: user functions whose param count
            // matches args.len() + 1 (the +1 is for the ctx/env param)
            // AND whose return type matches the CallPtr's ret_ty.
            var expected_param_count: i64 = args.len() + 1;
            // A struct or enum result: args[0] is the pointer the callee
            // writes it to, passed first, before the env (as a direct
            // call; lower.fd Lowerer_lower_call_expr_resolved). Only
            // functions returning that type are candidates, and only those
            // otherwise.
            var sret_call: bool = is_aggregate_ret(ret_ty) && args.len() > 0;
            var candidates: Vec<str> = Vec::new();
            var ci: i64 = 0;
            while ci < self.user_functions.len() {
                var name: str = self.user_functions.get(ci);
                if name != "" {
                    var pts_opt: OptVecIrType = fn_param_types_get(self, name);
                    match pts_opt {
                        OptVecIrType::Some(pts) => {
                            if pts.len() == expected_param_count {
                                var rt_opt: OptIrType = fn_ret_types_get(self, name);
                                match rt_opt {
                                    OptIrType::Some(rt) => {
                                        var c_rt: str = c_ret_type(rt);
                                        var c_expected: str = c_ret_type(ret_ty);
                                        if sret_call || is_aggregate_ret(rt) {
                                            if sret_call && ir_type_eq(rt, ret_ty) {
                                                candidates.push(name);
                                            }
                                        } else if c_rt == c_expected || (is_word_c(c_rt) && is_word_c(c_expected)) {
                                            candidates.push(name);
                                        } else if c_rt == "void" && is_word_c(c_expected) {
                                            // a call whose function type lost
                                            // its `-> void` (an unannotated
                                            // local of a struct field, stdlib
                                            // netcode `val adv = s.game.advance`)
                                            // expects a word: the function is
                                            // called and the word stays 0. It
                                            // ended in abort() (exit 127).
                                            candidates.push(name);
                                        } else if c_expected == "void" && is_word_c(c_rt) {
                                            // the other way round: a function
                                            // that returns a word is called
                                            // where `-> void` is expected, for
                                            // its effect (a closure with no
                                            // `return` of a value is typed i64:
                                            // `v.for_each(fn(x: i64) { print(x); })`
                                            // ended in abort() on this backend)
                                            candidates.push(name);
                                        }
                                    }
                                    OptIrType::None => {
                                    }
                                }
                            }
                        }
                        OptVecIrType::None => {
                        }
                    }
                }
                ci = ci + 1;
            }

            // Build the dispatch block
            wln(self, "    {");
            wln(self, "        if (!" + fp + ") abort();");
            wln(self, "        char* _fn_name = *(char**)" + fp + ";");
            wln(self, "        if (!_fn_name) abort();");
            // A C function's address made a function value (`addr as
            // fn(..)`, lower.fd: word 0 the marker, word 1 the address;
            // stdlib-agent-bugs 45, 50): called with the call's own C types
            var c_ptr_branch: bool = !sret_call && string_consts_contains(self, "__fid_c_fnptr");
            if c_ptr_branch {
                var cp_types: str = "";
                var cp_args: str = "";
                var cpi: i64 = 0;
                while cpi < args.len() {
                    var cpt: str = c_type(value_ty_for_id(func, args.get(cpi)));
                    var cpa: str = arg_strs.get(cpi);
                    if cpi > 0 {
                        cp_types = cp_types + ", ";
                        cp_args = cp_args + ", ";
                    }
                    if cpt == "double" || cpt == "float" {
                        cp_types = cp_types + cpt;
                        cp_args = cp_args + cpa;
                    } else if str_ends_with(cpt, "*") || str_starts_with(cpt, "struct ") || str_contains(cpt, "[") {
                        cp_types = cp_types + "void*";
                        cp_args = cp_args + "(void*)(intptr_t)" + cpa;
                    } else {
                        cp_types = cp_types + cpt;
                        cp_args = cp_args + "(" + cpt + ")" + cpa;
                    }
                    cpi = cpi + 1;
                }
                if cp_types == "" {
                    cp_types = "void";
                }
                var cp_void: bool = ir_type_eq(ret_ty, IrType::Void) || ir_type_eq(ret_ty, IrType::Never);
                var cp_rt: str = "void";
                if !cp_void {
                    cp_rt = c_type(ret_ty);
                    if str_ends_with(cp_rt, "*") {
                        cp_rt = "void*";
                    }
                }
                var cp_call: str = "((" + cp_rt + "(*)(" + cp_types + "))(((int64_t*)" + fp + ")[1]))(" + cp_args + ")";
                wln(self, "        if (strcmp(_fn_name, \"__fid_c_fnptr\") == 0) {");
                if cp_void {
                    wln(self, "            " + cp_call + ";");
                } else {
                    wln(self, "            " + dst + " = (" + c_type(ret_ty) + ")" + cp_call + ";");
                }
                wln(self, "        } else {");
            }
            var first: bool = true;
            var cand_i: i64 = 0;
            while cand_i < candidates.len() {
                var fname: str = candidates.get(cand_i);
                var c_fname: str = sanitize_c_name(self, fname);
                var pts_opt: OptVecIrType = fn_param_types_get(self, fname);
                var fn_ret: IrType = ret_ty;
                match fn_ret_types_get(self, fname) {
                    OptIrType::Some(rt) => {
                        fn_ret = rt;
                    }
                    OptIrType::None => {
                    }
                }

                // Build call args
                var call_args: Vec<str> = Vec::new();
                // The result pointer first for a struct result
                var arg_i: i64 = 0;
                if sret_call {
                    call_args.push("(void*)" + arg_strs.get(0));
                    arg_i = 1;
                }
                // Then the env pointer or 0
                if has_env {
                    call_args.push("(void*)" + fp);
                } else {
                    call_args.push("(void*)0");
                }
                // Then the explicit CallPtr args, cast to match (argument
                // i is parameter i + 1: after the env, or after the result
                // pointer and the env)
                while arg_i < arg_strs.len() {
                    var param_idx: i64 = arg_i + 1;
                    var cast: str = "int64_t";
                    match pts_opt {
                        OptVecIrType::Some(pts) => {
                            if param_idx < pts.len() {
                                cast = c_type(pts.get(param_idx));
                            }
                        }
                        OptVecIrType::None => {
                        }
                    }
                    var arg: str = arg_strs.get(arg_i);
                    var arg_ty_c: IrType = value_ty_for_id(func, args.get(arg_i));
                    if ir_type_eq(arg_ty_c, IrType::F64) || ir_type_eq(arg_ty_c, IrType::F32) {
                        // A float stays one; this candidate may not take it
                        if cast == "double" || cast == "float" {
                            call_args.push("(" + cast + ")" + arg);
                        } else if cast == "void*" || str_starts_with(cast, "struct ") || str_contains(cast, "[") {
                            call_args.push("(void*)(intptr_t)" + arg);
                        } else {
                            call_args.push("(" + cast + ")" + arg);
                        }
                    } else if cast == "void*" || str_starts_with(cast, "struct ") {
                        call_args.push("(void*)" + arg);
                    } else if cast == "double" {
                        call_args.push("(double)(intptr_t)" + arg);
                    } else if cast == "float" {
                        call_args.push("(float)(intptr_t)" + arg);
                    } else if cast == "bool" {
                        call_args.push("(bool)" + arg);
                    } else if str_contains(cast, "[") {
                        call_args.push("(void*)" + arg);
                    } else {
                        call_args.push("(" + cast + ")" + arg);
                    }
                    arg_i = arg_i + 1;
                }

                // Join call args
                var call_expr: str = c_fname + "(";
                var j: i64 = 0;
                while j < call_args.len() {
                    if j > 0 {
                        call_expr = call_expr + ", ";
                    }
                    call_expr = call_expr + call_args.get(j);
                    j = j + 1;
                }
                call_expr = call_expr + ")";

                if first {
                    wln(self, "        if (strcmp(_fn_name, \"" + fname + "\") == 0) {");
                    first = false;
                } else {
                    wln(self, "        } else if (strcmp(_fn_name, \"" + fname + "\") == 0) {");
                }

                // The call wants no value: the candidate's result is dropped
                // (it may return a word: the last rule above)
                if ir_type_eq(fn_ret, IrType::Void) || ir_type_eq(fn_ret, IrType::Never) || ir_type_eq(ret_ty, IrType::Void) || ir_type_eq(ret_ty, IrType::Never) {
                    wln(self, "            " + call_expr + ";");
                } else if is_aggregate_ret(fn_ret) {
                    wln(self, "            " + call_expr + ";");
                } else {
                    // A word of another type (a function value may only know i64)
                    wln(self, "            " + dst + " = (" + c_type(ret_ty) + ")" + call_expr + ";");
                }
                cand_i = cand_i + 1;
            }
            if first {
                // No function of the program takes these arguments and gives
                // this result: nothing the value can name is callable here.
                // (This called the env as code, through a one-parameter
                // prototype that does not compile with more arguments:
                // stdlib-agent-bugs 14's C build.)
                wln(self, "        abort();");
            } else {
                wln(self, "        } else { abort(); }");
            }
            if c_ptr_branch {
                wln(self, "        }");
            }
            wln(self, "    }");
        }
        Inst::DynCall(trait_name, method, args, ret_ty, _) => {
            var void_ret: bool = c_ret_type(ret_ty) == "void";
            wln(self, "    /* dyncall " + trait_name + "::" + method + " */");
            if args.len() > 0 {
                var type_arg: str = val_name(self, args.get(0));
                var candidates: Vec<str> = Vec::new();
                var ci: i64 = 0;
                while ci < self.user_functions.len() {
                    var fname: str = self.user_functions.get(ci);
                    if str_ends_with(fname, "_" + method) && cg_dyn_candidate(self, fname, method, args.len() + 1) {
                        candidates.push(fname);
                    }
                    ci = ci + 1;
                }
                wln(self, "    { struct { const char* type_name; void* ptr; }* _dyn = (void*)" + type_arg + ";");
                wln(self, "    const char* _t = _dyn ? _dyn->type_name : \"\";");
                wln(self, "    void* _recv = _dyn ? _dyn->ptr : NULL;");
                wln(self, "    if (false) {}");
                var ci2: i64 = 0;
                while ci2 < candidates.len() {
                    var cname: str = candidates.get(ci2);
                    var method_suffix: str = "_" + method;
                    var type_part: str = str_slice(cname, 0, str_len(cname) - str_len(method_suffix));
                    var call_args: str = "NULL, _recv";
                    var ai: i64 = 1;
                    while ai < args.len() {
                        call_args = call_args + ", " + val_name(self, args.get(ai));
                        ai = ai + 1;
                    }
                    if void_ret {
                        wln(self, "    else if (strcmp(_t, \"" + type_part + "\") == 0) " + cname + "(" + call_args + ");");
                    } else {
                        wln(self, "    else if (strcmp(_t, \"" + type_part + "\") == 0) " + dst + " = " + cname + "(" + call_args + ");");
                    }
                    ci2 = ci2 + 1;
                }
                if !void_ret {
                    wln(self, "    else { abort(); }");
                }
                wln(self, "    }");
            }
        }
        Inst::MakeDyn(value, type_name, trait_name) => {
            var val_str: str = val_name(self, value);
            wln(self, "    { /* make dyn " + type_name + " as " + trait_name + " */");
            wln(self, "        struct { const char* type_name; void* ptr; }* _dyn = p_malloc(sizeof(*_dyn));");
            wln(self, "        _dyn->type_name = \"" + type_name + "\";");
            wln(self, "        _dyn->ptr = (void*)" + val_str + ";");
            wln(self, "        " + dst + " = (void*)_dyn;");
            wln(self, "    }");
        }
        Inst::BitCast(value, _, _) => {
            var v: str = val_name(self, value);
            var to_ty: IrType = value_ty_for_id(func, id);
            var from_ty: IrType = value_ty_for_id(func, value);
            if is_float_type(to_ty) {
                // 2g.13: a cast to a float (lower.fd emits BitCast for
                // f32 <-> f64 and as its default cast) converts the value,
                // as the interpreter's Interpreter_cast_value does; it was
                // `(void*)v`, which C rejects for a float destination.
                // OP21 (Nov 21 evening): from an INTEGER word it is the
                // Vec<f32>/<f64> element boundary — the word holds the
                // f64 bits of the single (the layout canon; nat_ir keeps
                // the bits for int <-> float) — so the bits are
                // reinterpreted, not converted. A numeric `x as f64`
                // lowers to p_int_to_float, never to a BitCast.
                var from_int: bool = str_len(c_int_helper(from_ty)) > 0 && !ir_type_eq(from_ty, IrType::Bool);
                if from_int {
                    wln(self, "    " + dst + " = (" + c_type(to_ty) + ")((union { uint64_t u; double f; }){ .u = (uint64_t)(" + v + ") }).f;");
                } else if is_float_type(from_ty) || ir_type_eq(from_ty, IrType::Bool) {
                    wln(self, "    " + dst + " = (" + c_type(to_ty) + ")" + v + ";");
                } else {
                    // A pointer, struct or handle: its address as a number
                    wln(self, "    " + dst + " = (" + c_type(to_ty) + ")(intptr_t)" + v + ";");
                }
            } else if is_float_type(from_ty) {
                // From a float: to an integer it is the element boundary's
                // other side — the single's f64 bits (OP21); a pointer-sized
                // destination goes through intptr_t.
                var to_int: bool = str_len(c_int_helper(to_ty)) > 0 && !ir_type_eq(to_ty, IrType::Bool);
                if to_int {
                    wln(self, "    " + dst + " = (" + c_type(to_ty) + ")((union { uint64_t u; double f; }){ .f = (double)(" + v + ") }).u;");
                } else {
                    var fcast: str = int_ptr_cast(to_ty);
                    if fcast == "" {
                        fcast = "(void*)(intptr_t)";
                    }
                    wln(self, "    " + dst + " = " + fcast + v + ";");
                }
            } else {
                var cast: str = int_ptr_cast(to_ty);
                if cast == "" {
                    cast = "(void*)";
                }
                wln(self, "    " + dst + " = " + cast + v + ";");
            }
        }
        Inst::IntExtend(value, _, _) => {
            var v: str = val_name(self, value);
            wln(self, "    " + dst + " = (int64_t)" + v + ";");
        }
        Inst::IntTrunc(value, _, _) => {
            var v: str = val_name(self, value);
            wln(self, "    " + dst + " = (int32_t)" + v + ";");
        }
        Inst::IntToFloat(value, _, _) => {
            var v: str = val_name(self, value);
            wln(self, "    " + dst + " = (double)" + v + ";");
        }
        Inst::FloatToInt(value, _, _) => {
            var v: str = val_name(self, value);
            wln(self, "    " + dst + " = (int64_t)" + v + ";");
        }
        Inst::TryUnwrap(value, ok_dst, err_block, ok_block) => {
            var v: str = val_name(self, value);
            var ok_dst_str: str = val_name(self, ok_dst);
            wln(self, "    { int64_t _tag = *(int64_t*)" + v + ";");
            wln(self, "    if (_tag == 0) {");
            wln(self, "        " + ok_dst_str + " = *((int64_t*)" + v + " + 1);");
            wln(self, "        goto bb" + int_to_str(ok_block) + ";");
            wln(self, "    } else {");
            wln(self, "        goto bb" + int_to_str(err_block) + ";");
            wln(self, "    } }");
        }
        Inst::Print(value, ty) => {
            var v: str = val_name(self, value);
            match ty {
                IrType::F64 => {
                    wln(self, "    p_print_float(" + v + ");");
                }
                // OP21 (Nov 21 evening): an f32 prints as the number it is
                // (the value is the single, widened by C's promotion)
                IrType::F32 => {
                    wln(self, "    p_print_float((double)" + v + ");");
                }
                IrType::Bool => {
                    wln(self, "    p_print_bool(" + v + ");");
                }
                IrType::Ptr(_) => {
                    wln(self, "    p_print_str(" + v + ");");
                }
                IrType::Generic(name, _) => {
                    if name == "Vec" {
                        wln(self, "    { char* _s = (char*)Vec_to_str(0, (int64_t)" + v + "); p_print_str(_s); Str_drop(0, (int64_t)(intptr_t)_s); }");
                    } else if name == "HashMap" {
                        wln(self, "    { char* _s = (char*)HashMap_to_str(0, (int64_t)" + v + "); p_print_str(_s); Str_drop(0, (int64_t)(intptr_t)_s); }");
                    } else {
                        wln(self, "    p_print_int((int64_t)" + v + ");");
                    }
                }
                IrType::Opaque(name) => {
                    if name == "Vec" {
                        wln(self, "    { char* _s = (char*)Vec_to_str(0, (int64_t)" + v + "); p_print_str(_s); Str_drop(0, (int64_t)(intptr_t)_s); }");
                    } else if name == "HashMap" {
                        // The self-hosted lowerer types HashMap::new() as
                        // Opaque("HashMap") (src/lower.rs: Generic).
                        wln(self, "    { char* _s = (char*)HashMap_to_str(0, (int64_t)" + v + "); p_print_str(_s); Str_drop(0, (int64_t)(intptr_t)_s); }");
                    } else if name == "String" {
                        wln(self, "    p_print_str((char*)" + v + ");");
                    } else if name == "Tensor" {
                        wln(self, "    { char* _s = p_tensor_to_str((void*)" + v + "); p_print_str(_s); p_str_free_c(_s); }");
                    } else {
                        wln(self, "    p_print_int((int64_t)" + v + ");");
                    }
                }
                _ => {
                    wln(self, "    p_print_int((int64_t)" + v + ");");
                }
            }
        }
        Inst::Panic(message) => {
            wln(self, "    p_panic(\"" + message + "\");");
        }
        Inst::Asm(template, inputs, outputs, ret_ty) => {
            CCodeGen_gen_asm(self, dst, template, inputs, outputs, ret_ty);
        }
        Inst::RegionBegin(name, is_gpu, _, _) => {
            if is_gpu {
                wln(self, "    /* GPU region begin: " + name + " */");
            }
        }
        Inst::RegionEnd(name, is_gpu, _) => {
            if is_gpu {
                wln(self, "    /* GPU region end: " + name + " (all GPU memory freed) */");
            }
        }
        Inst::PersistLoad(_, default, _) => {
            var d: str = val_name(self, default);
            wln(self, "    " + dst + " = " + d + ";");
        }
        Inst::PersistSave(_, _) => {
        }
        Inst::TxnBegin => {
        }
        Inst::TxnEnd => {
        }
        Inst::UnsafeBegin => {
        }
        Inst::UnsafeEnd => {
        }
        Inst::GradBegin(_) => {
            wln(self, "    p_autograd_begin();");
        }
        Inst::GradEnd => {
            wln(self, "    p_autograd_end();");
        }
        Inst::Backward(_) => {
            wln(self, "    p_autograd_backward(NULL);");
        }
        Inst::StructCopy(dst, src, ty) => {
            var d: str = val_name(self, dst);
            var s: str = val_name(self, src);
            var size: i64 = 8;
            match ty {
                IrType::Struct(sName) => {
                    var si: i64 = 0;
                    while si < self.struct_layouts.len() {
                        if self.struct_layouts.get(si).name == sName {
                            size = self.struct_layouts.get(si).layout.size;
                            break;
                        }
                        si = si + 1;
                    }
                }
                // an array sret copy is elem*count bytes (ir_type_size)
                IrType::Array(_, _) => {
                    size = ir_type_size(ty);
                }
                _ => {
                }
            }
            wln(self, "    memcpy(" + d + ", " + s + ", " + int_to_str(size) + ");");
        }
    }
}

// --- Module-level generation ----------------------------------------------

// Per-module units (`ccompile --inc`): mark each function in the output, so
// compiler.fd can split it.
var g_c_unit_marks: bool = false;
pub fn set_c_unit_marks(v: bool) {
    g_c_unit_marks = v;
}
// fid ccompile --profile: the program samples its own call stack
var g_c_profile: bool = false;
pub fn set_c_profile(v: bool) {
    g_c_profile = v;
}

// --- CO5: `fid profile --pid <N>`: sample a running program ---------------
/// CO5: build the attaching profiler (cg_prof_attach_c) with a C compiler
/// (`cc_env`, else zig cc, gcc, clang or cc from the PATH) and run it on
/// process `pid` for `seconds`, writing collapsed stacks to `out`, one
/// line per sample as the in-process profiler does. 0 when it wrote
/// samples. The program must be built through C by a fid with
/// __p_prof_anchor (any `fid ccompile` build; no --profile needed).
pub fn cg_prof_attach(pid: str, seconds: str, out: str, cc_env: str, posix: bool) -> i64 {
    var src: str = "_fid_prof_attach.c";
    var exe: str = "_fid_prof_attach.exe";
    var run: str = ".\\_fid_prof_attach.exe";
    var quiet: str = " >nul 2>&1";
    if posix {
        exe = "_fid_prof_attach";
        run = "./_fid_prof_attach";
        quiet = " >/dev/null 2>&1";
    }
    var cc: str = cc_env;
    if str_len(cc) == 0 {
        if p_system("zig version" + quiet) == 0 {
            cc = "zig cc";
        } else if p_system("gcc --version" + quiet) == 0 {
            cc = "gcc";
        } else if p_system("clang --version" + quiet) == 0 {
            cc = "clang";
        } else if posix && p_system("cc --version" + quiet) == 0 {
            cc = "cc";
        }
    }
    if str_len(cc) == 0 {
        p_eprint_str("profile: --pid builds its sampler with a C compiler: set CC, or put zig, gcc or clang on the PATH\n");
        return 1;
    }
    if !posix && str_contains(cc, "tcc") {
        p_eprint_str("profile: --pid needs dbghelp, which tcc cannot link: set CC to zig cc, gcc, clang or cl\n");
        return 1;
    }
    if p_file_write(src, cg_prof_attach_c()) != 0 {
        p_eprint_str("profile: cannot write " + src + "\n");
        return 1;
    }
    var build: str = cc + " -O2 " + src + " -o " + exe;
    if str_contains(cc, "cl.exe") || cc == "cl" {
        build = cc + " /nologo /O2 " + src + " /Fe:" + exe + " dbghelp.lib";
    } else if !posix {
        build = build + " -ldbghelp";
    }
    if p_system(build) != 0 {
        p_eprint_str("profile: building the sampler failed: " + build + "\n");
        p_file_delete(src);
        return 1;
    }
    var code: i64 = p_system(run + " " + pid + " " + seconds + " \"" + out + "\"");
    p_file_delete(src);
    p_file_delete(exe);
    if !posix {
        p_file_delete("_fid_prof_attach.pdb");
        p_file_delete("_fid_prof_attach.obj");
        p_file_delete("_fid_prof_attach.lib");
    }
    if code != 0 {
        return 1;
    }
    return 0;
}

/// CO5: the C source of the attaching profiler: `<it> <pid> <seconds>
/// <out.folded>`. It finds the program's function table through
/// __p_prof_anchor (the magic words, then the anchor's own address), and
/// samples every thread about every millisecond: on Windows with
/// SuspendThread/GetThreadContext and dbghelp's StackWalk64 over the
/// program's unwind tables; on Linux with ptrace (PTRACE_SEIZE and
/// PTRACE_INTERRUPT), scanning the stack for return addresses whose call
/// instruction calls the frame found below (ranges from the executable's
/// .symtab). tests/tooling/co5-profile-pid-check.sh runs it.
pub fn cg_prof_attach_c() -> str {
    return r##"/* fid profile --pid: sample the call stacks of a running Fides program
   (built through C) from outside, and write collapsed stacks ("main;f;g 1"
   per sample, as `fid profile` does for its own child).
   Usage: <this> <pid> <seconds> <out.folded>
   The program's function table (__p_fns: address and Fides name of each
   function) is found through __p_prof_anchor, which every C build holds.
   Windows: SuspendThread/GetThreadContext, the stack walked over the
   program's unwind tables (dbghelp StackWalk64, which reads its memory).
   Linux: ptrace (PTRACE_SEIZE/INTERRUPT), the stack scanned for return
   addresses whose call instruction calls the frame below. */
#define _GNU_SOURCE 1
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <signal.h>

#define FP_MAGIC0 0x31464F5250444946ULL
#define FP_MAGIC1 0x2121524F48434E41ULL
#define FP_DEPTH 64

typedef struct { uint64_t addr; char* name; } fp_fn;
static fp_fn* fp_fns;
static int fp_nfns;
static uint64_t fp_main;
static volatile sig_atomic_t fp_stop;
static FILE* fp_out;
static long fp_samples;
static int fp_read(uint64_t addr, void* buf, size_t n);

static int fp_fn_cmp(const void* a, const void* b) {
    uint64_t x = ((const fp_fn*)a)->addr, y = ((const fp_fn*)b)->addr;
    return x < y ? -1 : x > y;
}
/* The Fides name of the function starting at `a`, or NULL */
static const char* fp_name(uint64_t a) {
    int lo = 0, hi = fp_nfns - 1;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        if (fp_fns[mid].addr == a) return fp_fns[mid].name;
        if (fp_fns[mid].addr < a) lo = mid + 1; else hi = mid - 1;
    }
    return NULL;
}
#ifndef _WIN32
/* The Fides function whose code holds `a` (the last one starting at or
   before it), or 0 */
static uint64_t fp_fides_at(uint64_t a) {
    int lo = 0, hi = fp_nfns - 1, best = -1;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        if (fp_fns[mid].addr <= a) { best = mid; lo = mid + 1; } else hi = mid - 1;
    }
    if (best < 0) return 0;
    /* past the last function: at most 1 MB of code */
    if (best == fp_nfns - 1 && a - fp_fns[best].addr > (1u << 20)) return 0;
    return fp_fns[best].addr;
}
static void fp_on_signal(int s) { (void)s; fp_stop = 1; }
#endif

/* One sample: function starts, innermost first */
static void fp_emit(const uint64_t* f, int n) {
    const char* names[FP_DEPTH];
    int m = 0;
    for (int i = 0; i < n && m < FP_DEPTH; i++) {
        const char* nm = fp_name(f[i]);
        if (nm) names[m++] = nm;
    }
    if (m == 0) return;
    for (int k = m - 1; k >= 0; k--) fprintf(fp_out, k == m - 1 ? "%s" : ";%s", names[k]);
    fprintf(fp_out, " 1\n");
    fp_samples++;
}

/* A NUL-terminated string of the program */
static char* fp_read_str(uint64_t a) {
    char buf[257];
    int n = 0;
    while (n < 256) {
        if (!fp_read(a + (uint64_t)n, buf + n, 1)) return NULL;
        if (buf[n] == 0) break;
        n++;
    }
    buf[n] = 0;
    return strdup(buf);
}
/* `anchor`: where __p_prof_anchor is in the program. Reads its table. */
static int fp_load_table(uint64_t anchor) {
    uint64_t w[5];
    if (!fp_read(anchor, w, sizeof w)) return 0;
    uint64_t fns = w[3], countp = w[4];
    int32_t count = 0;
    if (!fp_read(countp, &count, sizeof count) || count <= 0 || count > 10000000) return 0;
    uint64_t* raw = (uint64_t*)malloc(sizeof(uint64_t) * 2 * (size_t)count);
    fp_fns = (fp_fn*)malloc(sizeof(fp_fn) * (size_t)count);
    if (!raw || !fp_fns) return 0;
    if (!fp_read(fns, raw, sizeof(uint64_t) * 2 * (size_t)count)) return 0;
    for (int i = 0; i < count; i++) {
        if (!raw[2 * i] || !raw[2 * i + 1]) continue;
        char* nm = fp_read_str(raw[2 * i + 1]);
        if (!nm) continue;
        fp_fns[fp_nfns].addr = raw[2 * i];
        fp_fns[fp_nfns].name = nm;
        if (strcmp(nm, "main") == 0) fp_main = raw[2 * i];
        fp_nfns++;
    }
    free(raw);
    qsort(fp_fns, (size_t)fp_nfns, sizeof(fp_fn), fp_fn_cmp);
    return fp_nfns > 0;
}
/* Search `len` bytes of the program at `base` for the anchor: the two magic
   words, then its own address (a copy of the words elsewhere is not it) */
static uint64_t fp_find_in(uint64_t base, uint64_t len) {
    static unsigned char buf[1 << 20];
    uint64_t off = 0;
    while (off < len) {
        uint64_t n = len - off < sizeof buf ? len - off : sizeof buf;
        if (fp_read(base + off, buf, (size_t)n)) {
            for (uint64_t i = 0; i + 24 <= n; i += 8) {
                uint64_t a, b, s;
                memcpy(&a, buf + i, 8);
                if (a != FP_MAGIC0) continue;
                memcpy(&b, buf + i + 8, 8);
                memcpy(&s, buf + i + 16, 8);
                if (b == FP_MAGIC1 && s == base + off + i) return s;
            }
        }
        /* overlap the next block by 16 bytes: an anchor across the edge */
        off += n > 16 && n == sizeof buf ? n - 16 : n;
    }
    return 0;
}

#ifdef _WIN32
#include <windows.h>
#include <dbghelp.h>
#include <tlhelp32.h>
#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
#endif
static HANDLE fp_proc;
static int fp_read(uint64_t addr, void* buf, size_t n) {
    SIZE_T got = 0;
    return ReadProcessMemory(fp_proc, (LPCVOID)(uintptr_t)addr, buf, n, &got) && got == n;
}
static uint64_t fp_find_anchor(void) {
    MEMORY_BASIC_INFORMATION mb;
    uint64_t a = 0;
    while (VirtualQueryEx(fp_proc, (LPCVOID)(uintptr_t)a, &mb, sizeof mb) == sizeof mb) {
        DWORD p = mb.Protect & 0xff;
        if (mb.State == MEM_COMMIT && mb.Type == MEM_IMAGE && !(mb.Protect & PAGE_GUARD)
            && (p == PAGE_READONLY || p == PAGE_READWRITE || p == PAGE_WRITECOPY)) {
            uint64_t r = fp_find_in((uint64_t)(uintptr_t)mb.BaseAddress, (uint64_t)mb.RegionSize);
            if (r) return r;
        }
        uint64_t next = (uint64_t)(uintptr_t)mb.BaseAddress + (uint64_t)mb.RegionSize;
        if (next <= a) break;
        a = next;
    }
    return 0;
}
static BOOL WINAPI fp_on_ctrl(DWORD t) { (void)t; fp_stop = 1; return TRUE; }
typedef struct { DWORD id; HANDLE h; } fp_thread;
static fp_thread fp_th[1024];
static int fp_nth;
static void fp_threads(DWORD pid) {
    for (int i = 0; i < fp_nth; i++) CloseHandle(fp_th[i].h);
    fp_nth = 0;
    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
    if (snap == INVALID_HANDLE_VALUE) return;
    THREADENTRY32 te;
    te.dwSize = sizeof te;
    if (Thread32First(snap, &te)) {
        do {
            if (te.th32OwnerProcessID != pid || fp_nth >= 1024) continue;
            HANDLE h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, te.th32ThreadID);
            if (h) { fp_th[fp_nth].id = te.th32ThreadID; fp_th[fp_nth].h = h; fp_nth++; }
        } while (Thread32Next(snap, &te));
    }
    CloseHandle(snap);
}
static void fp_sample(HANDLE th) {
    if (SuspendThread(th) == (DWORD)-1) return;
    CONTEXT c;
    memset(&c, 0, sizeof c);
    c.ContextFlags = CONTEXT_FULL;
    uint64_t f[FP_DEPTH];
    int k = 0;
    if (GetThreadContext(th, &c)) {
        STACKFRAME64 sf;
        memset(&sf, 0, sizeof sf);
#if defined(_M_ARM64) || defined(__aarch64__)
        DWORD machine = IMAGE_FILE_MACHINE_ARM64;
        sf.AddrPC.Offset = c.Pc; sf.AddrStack.Offset = c.Sp; sf.AddrFrame.Offset = c.Fp;
#else
        DWORD machine = IMAGE_FILE_MACHINE_AMD64;
        sf.AddrPC.Offset = c.Rip; sf.AddrStack.Offset = c.Rsp; sf.AddrFrame.Offset = c.Rbp;
#endif
        sf.AddrPC.Mode = AddrModeFlat; sf.AddrStack.Mode = AddrModeFlat; sf.AddrFrame.Mode = AddrModeFlat;
        while (k < FP_DEPTH && StackWalk64(machine, fp_proc, th, &sf, &c, NULL, SymFunctionTableAccess64, SymGetModuleBase64, NULL)) {
            DWORD64 pc = sf.AddrPC.Offset;
            if (!pc) break;
            /* a return address is after its call: look up the call */
            DWORD64 q = k == 0 ? pc : pc - 1;
            DWORD* rf = (DWORD*)SymFunctionTableAccess64(fp_proc, q);
            DWORD64 base = SymGetModuleBase64(fp_proc, q);
            uint64_t start = rf && base ? base + rf[0] : 0;
            if (start) f[k++] = start;
            if (start && start == fp_main) break;
        }
    }
    ResumeThread(th);
    fp_emit(f, k);
}
int main(int argc, char** argv) {
    if (argc < 4) { fprintf(stderr, "usage: %s <pid> <seconds> <out.folded>\n", argv[0]); return 2; }
    DWORD pid = (DWORD)strtoul(argv[1], NULL, 10);
    double secs = atof(argv[2]);
    fp_proc = OpenProcess(PROCESS_QUERY_INFORMATION | PROCESS_VM_READ | SYNCHRONIZE, FALSE, pid);
    if (!fp_proc) { fprintf(stderr, "profile: cannot open process %lu (error %lu)\n", (unsigned long)pid, (unsigned long)GetLastError()); return 1; }
    uint64_t anchor = fp_find_anchor();
    if (!anchor || !fp_load_table(anchor)) {
        fprintf(stderr, "profile: process %lu holds no Fides function table (it was not built through C by this fid: `fid ccompile`, or `fid profile <file.fd>`)\n", (unsigned long)pid);
        return 1;
    }
    SymSetOptions(SYMOPT_DEFERRED_LOADS | SYMOPT_FAIL_CRITICAL_ERRORS | SYMOPT_NO_PROMPTS);
    if (!SymInitialize(fp_proc, NULL, TRUE)) { fprintf(stderr, "profile: cannot read the modules of process %lu (error %lu)\n", (unsigned long)pid, (unsigned long)GetLastError()); return 1; }
    fp_out = fopen(argv[3], "wb");
    if (!fp_out) { fprintf(stderr, "profile: cannot write %s\n", argv[3]); return 1; }
    SetConsoleCtrlHandler(fp_on_ctrl, TRUE);
    HANDLE timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
    if (!timer) timer = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
    LARGE_INTEGER fr, t0, t1;
    QueryPerformanceFrequency(&fr);
    QueryPerformanceCounter(&t0);
    int exited = 0;
    long ticks = 0;
    fprintf(stderr, "profile: sampling process %lu for %g s (%d functions)\n", (unsigned long)pid, secs, fp_nfns);
    while (!fp_stop) {
        if (WaitForSingleObject(fp_proc, 0) == WAIT_OBJECT_0) { exited = 1; break; }
        if (ticks % 100 == 0) fp_threads(pid);
        for (int i = 0; i < fp_nth; i++) fp_sample(fp_th[i].h);
        ticks++;
        QueryPerformanceCounter(&t1);
        if ((double)(t1.QuadPart - t0.QuadPart) >= secs * (double)fr.QuadPart) break;
        if (timer) {
            LARGE_INTEGER due;
            due.QuadPart = -10000; /* 1 ms */
            if (SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE)) WaitForSingleObject(timer, 10);
            else Sleep(1);
        } else Sleep(1);
    }
    for (int i = 0; i < fp_nth; i++) CloseHandle(fp_th[i].h);
    SymCleanup(fp_proc);
    fclose(fp_out);
    fprintf(stderr, "profile: %ld samples of process %lu%s\n", fp_samples, (unsigned long)pid, exited ? " (it exited)" : "");
    return fp_samples > 0 ? 0 : 1;
}
#elif defined(__linux__) && (defined(__x86_64__) || defined(__aarch64__))
#include <unistd.h>
#include <errno.h>
#include <dirent.h>
#include <time.h>
#include <elf.h>
#include <sys/ptrace.h>
#include <sys/wait.h>
#include <sys/uio.h>
#include <sys/user.h>
#ifndef PTRACE_SEIZE
#define PTRACE_SEIZE 0x4206
#endif
#ifndef PTRACE_INTERRUPT
#define PTRACE_INTERRUPT 0x4207
#endif
#ifndef PTRACE_EVENT_STOP
#define PTRACE_EVENT_STOP 128
#endif
#ifndef NT_PRSTATUS
#define NT_PRSTATUS 1
#endif
static pid_t fp_pid;
static int fp_read(uint64_t addr, void* buf, size_t n) {
    struct iovec l = { buf, n }, r = { (void*)(uintptr_t)addr, n };
    ssize_t got = process_vm_readv(fp_pid, &l, 1, &r, 1, 0);
    if (got == (ssize_t)n) return 1;
    /* without process_vm_readv: /proc/<pid>/mem */
    char path[64];
    snprintf(path, sizeof path, "/proc/%d/mem", (int)fp_pid);
    FILE* m = fopen(path, "rb");
    if (!m) return 0;
    int ok = fseeko(m, (off_t)addr, SEEK_SET) == 0 && fread(buf, 1, n, m) == n;
    fclose(m);
    return ok;
}
/* The executable file: its functions (address, size: .symtab) and its
   loaded segments, to read code and to tell functions apart */
typedef struct { uint64_t start, end; } fp_range;
static fp_range* fp_rng;
static int fp_nrng;
static unsigned char* fp_elf;
static size_t fp_elf_len;
static uint64_t fp_bias;
static int fp_rng_cmp(const void* a, const void* b) {
    uint64_t x = ((const fp_range*)a)->start, y = ((const fp_range*)b)->start;
    return x < y ? -1 : x > y;
}
static void fp_load_elf(uint64_t anchor) {
    char path[64];
    snprintf(path, sizeof path, "/proc/%d/exe", (int)fp_pid);
    FILE* f = fopen(path, "rb");
    if (!f) return;
    fseek(f, 0, SEEK_END);
    long len = ftell(f);
    fseek(f, 0, SEEK_SET);
    if (len <= (long)sizeof(Elf64_Ehdr)) { fclose(f); return; }
    fp_elf = (unsigned char*)malloc((size_t)len);
    if (!fp_elf || fread(fp_elf, 1, (size_t)len, f) != (size_t)len) { fclose(f); free(fp_elf); fp_elf = NULL; return; }
    fclose(f);
    fp_elf_len = (size_t)len;
    Elf64_Ehdr* eh = (Elf64_Ehdr*)fp_elf;
    if (memcmp(eh->e_ident, ELFMAG, SELFMAG) != 0 || eh->e_ident[EI_CLASS] != ELFCLASS64) { free(fp_elf); fp_elf = NULL; return; }
    if (eh->e_shoff == 0 || eh->e_shoff + (uint64_t)eh->e_shnum * sizeof(Elf64_Shdr) > fp_elf_len) return;
    Elf64_Shdr* sh = (Elf64_Shdr*)(fp_elf + eh->e_shoff);
    for (int i = 0; i < eh->e_shnum; i++) {
        if (sh[i].sh_type != SHT_SYMTAB || sh[i].sh_link >= eh->e_shnum) continue;
        Elf64_Shdr* st = &sh[sh[i].sh_link];
        if (sh[i].sh_offset + sh[i].sh_size > fp_elf_len || st->sh_offset + st->sh_size > fp_elf_len) continue;
        Elf64_Sym* sy = (Elf64_Sym*)(fp_elf + sh[i].sh_offset);
        size_t n = (size_t)(sh[i].sh_size / sizeof(Elf64_Sym));
        const char* names = (const char*)(fp_elf + st->sh_offset);
        uint64_t anchor_val = 0;
        fp_rng = (fp_range*)malloc(sizeof(fp_range) * (n + 1));
        if (!fp_rng) return;
        for (size_t j = 0; j < n; j++) {
            if (sy[j].st_name < st->sh_size && strcmp(names + sy[j].st_name, "__p_prof_anchor") == 0) anchor_val = sy[j].st_value;
            if (ELF64_ST_TYPE(sy[j].st_info) == STT_FUNC && sy[j].st_value && sy[j].st_size) {
                fp_rng[fp_nrng].start = sy[j].st_value;
                fp_rng[fp_nrng].end = sy[j].st_value + sy[j].st_size;
                fp_nrng++;
            }
        }
        if (!anchor_val) { fp_nrng = 0; return; }
        fp_bias = anchor - anchor_val;
        for (int j = 0; j < fp_nrng; j++) { fp_rng[j].start += fp_bias; fp_rng[j].end += fp_bias; }
        qsort(fp_rng, (size_t)fp_nrng, sizeof(fp_range), fp_rng_cmp);
        return;
    }
}
/* The function whose code holds `a`: from the symbol table, else the
   Fides function table alone */
static uint64_t fp_func_at(uint64_t a) {
    if (fp_nrng == 0) return fp_fides_at(a);
    int lo = 0, hi = fp_nrng - 1, best = -1;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        if (fp_rng[mid].start <= a) { best = mid; lo = mid + 1; } else hi = mid - 1;
    }
    /* nested or overlapping symbols: look back a little */
    for (int i = best; i >= 0 && i > best - 4; i--)
        if (a >= fp_rng[i].start && a < fp_rng[i].end) return fp_rng[i].start;
    return 0;
}
/* Code bytes: from the file (a loaded segment), else from the process */
static int fp_code(uint64_t a, void* buf, size_t n) {
    if (fp_elf && fp_nrng) {
        Elf64_Ehdr* eh = (Elf64_Ehdr*)fp_elf;
        Elf64_Phdr* ph = (Elf64_Phdr*)(fp_elf + eh->e_phoff);
        uint64_t va = a - fp_bias;
        for (int i = 0; i < eh->e_phnum; i++) {
            if (ph[i].p_type != PT_LOAD) continue;
            if (va >= ph[i].p_vaddr && va + n <= ph[i].p_vaddr + ph[i].p_filesz) {
                uint64_t off = ph[i].p_offset + (va - ph[i].p_vaddr);
                if (off + n > fp_elf_len) return 0;
                memcpy(buf, fp_elf + off, n);
                return 1;
            }
        }
    }
    return fp_read(a, buf, n);
}
/* Whether a call ends at `w`: 1 a direct call (its target in *t), 2 an
   indirect one, 0 none */
static int fp_call_before(uint64_t w, uint64_t* t) {
#if defined(__x86_64__)
    unsigned char b[8];
    if (w < 8 || !fp_code(w - 8, b, 8)) return 0;
    if (b[3] == 0xE8) {
        int32_t d;
        memcpy(&d, b + 4, 4);
        *t = w + (uint64_t)(int64_t)d;
        return 1;
    }
    /* FF /2: call through a register or memory */
    static const int lens[5] = { 2, 3, 4, 6, 7 };
    for (int i = 0; i < 5; i++) {
        int L = lens[i];
        if (b[8 - L] != 0xFF) continue;
        unsigned m = b[8 - L + 1];
        if (((m >> 3) & 7) != 2) continue;
        unsigned mod = m >> 6, rm = m & 7;
        int len;
        if (mod == 3) len = 2;
        else if (mod == 0) len = rm == 4 ? 3 + (((L >= 3 ? b[8 - L + 2] : 0) & 7) == 5 ? 4 : 0) : rm == 5 ? 6 : 2;
        else if (mod == 1) len = rm == 4 ? 4 : 3;
        else len = rm == 4 ? 7 : 6;
        if (len != L) continue;
        if (mod == 0 && rm == 5) {
            /* call *disp(%rip): the target is in memory */
            int32_t d;
            uint64_t p = 0;
            memcpy(&d, b + 4, 4);
            if (fp_read(w + (uint64_t)(int64_t)d, &p, 8) && p) { *t = p; return 1; }
        }
        return 2;
    }
    return 0;
#else
    uint32_t i;
    if (w < 4 || !fp_code(w - 4, &i, 4)) return 0;
    if ((i & 0xFC000000u) == 0x94000000u) {
        int64_t imm = (int64_t)(i & 0x03FFFFFFu);
        if (imm & 0x02000000) imm -= 0x04000000;
        *t = w - 4 + (uint64_t)(imm * 4);
        return 1;
    }
    if ((i & 0xFFFFFC1Fu) == 0xD63F0000u) return 2;
    return 0;
#endif
}
/* The stack of a stopped thread, read as the scan needs it: 4 KB at a
   time up to 512 KB, word by word where it ends */
static uint64_t fp_stk[1 << 16];
static long fp_stk_n;
static int fp_stk_end;
static uint64_t fp_stk_sp;
static int fp_word(long i, uint64_t* w) {
    while (i >= fp_stk_n && !fp_stk_end) {
        long room = (long)(sizeof fp_stk / 8) - fp_stk_n;
        long chunk = room < 512 ? room : 512;
        if (chunk <= 0) { fp_stk_end = 1; break; }
        if (fp_read(fp_stk_sp + (uint64_t)fp_stk_n * 8, fp_stk + fp_stk_n, (size_t)chunk * 8)) { fp_stk_n += chunk; continue; }
        long got = 0;
        while (got < chunk && fp_read(fp_stk_sp + (uint64_t)(fp_stk_n + got) * 8, fp_stk + fp_stk_n + got, 8)) got++;
        fp_stk_n += got;
        fp_stk_end = 1;
    }
    if (i >= fp_stk_n) return 0;
    *w = fp_stk[i];
    return 1;
}
/* The frames of a stopped thread: the function at pc, then each return
   address on the stack whose call calls the frame found last (on AArch64
   the link register first: a leaf's return address). A return address
   whose call goes elsewhere (a tail call left a frame out, or a stale
   value) is taken when no better one follows within 1024 words. */
static int fp_scan(uint64_t pc, uint64_t sp, uint64_t lr, uint64_t* f) {
    int k = 0;
    uint64_t cur = fp_func_at(pc);
    if (cur) f[k++] = cur;
    if (cur && cur == fp_main) return k;
    fp_stk_n = 0;
    fp_stk_end = 0;
    fp_stk_sp = sp;
    uint64_t pend_f = 0;
    long pend_at = 0;
    int have_pend = 0;
    long i = lr ? -1 : 0;
    while (k < FP_DEPTH) {
        uint64_t w = 0;
        int more = i < 0 ? 1 : fp_word(i, &w);
        if (!more || (have_pend && i > pend_at + 1024)) {
            if (!have_pend) break;
            f[k++] = pend_f;
            cur = pend_f;
            have_pend = 0;
            if (cur == fp_main) break;
            i = pend_at + 1;
            continue;
        }
        long at = i;
        if (i < 0) w = lr;
        i++;
        if (w < 4096) continue;
        uint64_t fn = fp_func_at(w - 1);
        if (!fn) continue;
        uint64_t t = 0;
        int kind = fp_call_before(w, &t);
        if (!kind) continue;
        if (cur && fp_name(cur) && kind == 1 && fp_func_at(t) != cur) {
            if (!have_pend) { have_pend = 1; pend_f = fn; pend_at = at; }
            continue;
        }
        f[k++] = fn;
        cur = fn;
        have_pend = 0;
        if (fn == fp_main) break;
    }
    return k;
}
typedef struct { pid_t tid; int live; } fp_thread;
static fp_thread fp_th[1024];
static int fp_nth;
static void fp_threads(void) {
    char path[64];
    snprintf(path, sizeof path, "/proc/%d/task", (int)fp_pid);
    DIR* d = opendir(path);
    if (!d) return;
    struct dirent* e;
    while ((e = readdir(d)) != NULL) {
        pid_t tid = (pid_t)atoi(e->d_name);
        if (tid <= 0) continue;
        int known = 0;
        for (int i = 0; i < fp_nth; i++) if (fp_th[i].tid == tid && fp_th[i].live) known = 1;
        if (known || fp_nth >= 1024) continue;
        if (ptrace(PTRACE_SEIZE, tid, 0, 0) == 0) { fp_th[fp_nth].tid = tid; fp_th[fp_nth].live = 1; fp_nth++; }
    }
    closedir(d);
}
/* Stop the thread (PTRACE_INTERRUPT); a signal that arrives meanwhile is
   passed on. 1 stopped, 0 it is gone. */
static int fp_stop_thread(pid_t tid) {
    if (ptrace(PTRACE_INTERRUPT, tid, 0, 0) != 0) return 0;
    for (;;) {
        int st = 0;
        if (waitpid(tid, &st, __WALL) < 0) { if (errno == EINTR) continue; return 0; }
        if (WIFEXITED(st) || WIFSIGNALED(st)) return 0;
        if (!WIFSTOPPED(st)) continue;
        if ((st >> 16) == PTRACE_EVENT_STOP) return 1;
        ptrace(PTRACE_CONT, tid, 0, (void*)(uintptr_t)WSTOPSIG(st));
    }
}
static void fp_sample(fp_thread* t) {
    if (!fp_stop_thread(t->tid)) { t->live = 0; return; }
    uint64_t pc = 0, sp = 0, lr = 0;
#if defined(__x86_64__)
    struct user_regs_struct r;
    if (ptrace(PTRACE_GETREGS, t->tid, 0, &r) == 0) { pc = r.rip; sp = r.rsp; }
#else
    struct user_regs_struct r;
    struct iovec io = { &r, sizeof r };
    if (ptrace(PTRACE_GETREGSET, t->tid, (void*)NT_PRSTATUS, &io) == 0) { pc = r.pc; sp = r.sp; lr = r.regs[30]; }
#endif
    uint64_t f[FP_DEPTH];
    int k = pc ? fp_scan(pc, sp, lr, f) : 0;
    ptrace(PTRACE_CONT, t->tid, 0, 0);
    fp_emit(f, k);
}
int main(int argc, char** argv) {
    if (argc < 4) { fprintf(stderr, "usage: %s <pid> <seconds> <out.folded>\n", argv[0]); return 2; }
    fp_pid = (pid_t)atoi(argv[1]);
    double secs = atof(argv[2]);
    if (fp_pid <= 0 || kill(fp_pid, 0) != 0) { fprintf(stderr, "profile: no process %s\n", argv[1]); return 1; }
    /* the anchor: in a read-only mapping of the executable */
    char path[64], exe[4096], line[4608];
    snprintf(path, sizeof path, "/proc/%d/exe", (int)fp_pid);
    ssize_t el = readlink(path, exe, sizeof exe - 1);
    if (el <= 0) { fprintf(stderr, "profile: cannot read /proc/%d/exe: %s\n", (int)fp_pid, strerror(errno)); return 1; }
    exe[el] = 0;
    snprintf(path, sizeof path, "/proc/%d/maps", (int)fp_pid);
    FILE* maps = fopen(path, "r");
    uint64_t anchor = 0;
    int denied = 0;
    while (maps && !anchor && fgets(line, sizeof line, maps)) {
        unsigned long long lo, hi;
        char perms[8] = {0};
        int at = 0;
        if (sscanf(line, "%llx-%llx %7s %*s %*s %*s %n", &lo, &hi, perms, &at) < 3 || at <= 0) continue;
        char* p = line + at;
        size_t pl = strlen(p);
        while (pl && (p[pl - 1] == '\n' || p[pl - 1] == ' ')) p[--pl] = 0;
        if (perms[0] != 'r' || perms[2] == 'x' || strcmp(p, exe) != 0) continue;
        unsigned char probe[8];
        if (!fp_read(lo, probe, 8)) { denied = errno ? errno : EPERM; continue; }
        anchor = fp_find_in(lo, hi - lo);
    }
    if (maps) fclose(maps);
    if (!anchor) {
        if (denied) fprintf(stderr, "profile: cannot read the memory of process %d (%s); on Linux with /proc/sys/kernel/yama/ptrace_scope = 1, start it with FID_PROF_ATTACH=1, or profile as root\n", (int)fp_pid, strerror(denied));
        else fprintf(stderr, "profile: process %d holds no Fides function table (it was not built through C by this fid: `fid ccompile`, or `fid profile <file.fd>`)\n", (int)fp_pid);
        return 1;
    }
    if (!fp_load_table(anchor)) { fprintf(stderr, "profile: cannot read the function table of process %d\n", (int)fp_pid); return 1; }
    fp_load_elf(anchor);
    errno = 0;
    fp_threads();
    if (fp_nth == 0) {
        fprintf(stderr, "profile: cannot attach to process %d (%s); on Linux with /proc/sys/kernel/yama/ptrace_scope = 1, start it with FID_PROF_ATTACH=1, or profile as root\n", (int)fp_pid, strerror(errno));
        return 1;
    }
    fp_out = fopen(argv[3], "wb");
    if (!fp_out) { fprintf(stderr, "profile: cannot write %s\n", argv[3]); return 1; }
    struct sigaction sa;
    memset(&sa, 0, sizeof sa);
    sa.sa_handler = fp_on_signal;
    sigaction(SIGINT, &sa, NULL);
    sigaction(SIGTERM, &sa, NULL);
    fprintf(stderr, "profile: sampling process %d for %g s (%d functions%s)\n", (int)fp_pid, secs, fp_nfns, fp_nrng ? "" : ", no symbol table: stacks are approximate");
    struct timespec t0, t1, d = { 0, 1000000 };
    clock_gettime(CLOCK_MONOTONIC, &t0);
    long ticks = 0;
    int exited = 0;
    while (!fp_stop) {
        if (ticks % 100 == 0) fp_threads();
        int live = 0;
        for (int i = 0; i < fp_nth; i++) if (fp_th[i].live) { fp_sample(&fp_th[i]); live += fp_th[i].live; }
        if (live == 0 && kill(fp_pid, 0) != 0) { exited = 1; break; }
        ticks++;
        clock_gettime(CLOCK_MONOTONIC, &t1);
        if ((double)(t1.tv_sec - t0.tv_sec) + (double)(t1.tv_nsec - t0.tv_nsec) / 1e9 >= secs) break;
        nanosleep(&d, NULL);
    }
    /* detach: each thread must be stopped first */
    for (int i = 0; i < fp_nth; i++) {
        if (!fp_th[i].live) continue;
        if (fp_stop_thread(fp_th[i].tid)) ptrace(PTRACE_DETACH, fp_th[i].tid, 0, 0);
    }
    fclose(fp_out);
    fprintf(stderr, "profile: %ld samples of process %d%s\n", fp_samples, (int)fp_pid, exited ? " (it exited)" : "");
    return fp_samples > 0 ? 0 : 1;
}
#else
int main(int argc, char** argv) {
    (void)argc; (void)argv;
    fprintf(stderr, "profile: --pid works on Windows (x64, ARM64) and Linux (x86-64, AArch64)\n");
    return 1;
}
#endif
"##;
}
// fid ccompile --leaks / --checked-alloc: the debug allocator (CM8, CM9)
var g_c_leaks: bool = false;
pub fn set_c_leaks(v: bool) {
    g_c_leaks = v;
}

var g_c_checked_alloc: bool = false;
pub fn set_c_checked_alloc(v: bool) {
    g_c_checked_alloc = v;
}
// fid run/ccompile --mem (roadmap L7C, complaint CO5): the debug allocator
// counts every allocation and prints, at exit, the peak and the bytes each
// function and each source line allocated
var g_c_memprof: bool = false;
pub fn set_c_mem_profile(v: bool) {
    g_c_memprof = v;
}
// CM8: the input file and its functions (by IR name), whose call sites tell
// the debug allocator their line (`__p_mc_at = "file.fd:LINE"`), for --leaks
// and --mem. Without it, -g's (set_c_debug_info) are used, else no lines.
var g_c_mc_file_esc: str = "";
var g_c_mc_names: i64 = 0;
pub fn set_c_mem_source(fd_file: str, source: str) {
    g_c_mc_file_esc = escape_c_string(fd_file);
    g_c_mc_names = cg_source_fn_names(source);
}

/// CM8: whether function `name` records its line for the debug allocator.
fn cg_mc_lines_for(name: str) -> bool {
    if !g_c_leaks && !g_c_memprof {
        return false;
    }
    if g_c_mc_names != 0 {
        return HashMap_contains(g_c_mc_names, name);
    }
    if g_c_dbg && g_c_dbg_names != 0 {
        return HashMap_contains(g_c_dbg_names, name);
    }
    return false;
}

/// CM8: the C statement that records source line `ln` as the place of the
/// next allocations (a string constant: one store per line).
fn cg_mc_at_stmt(ln: i64) -> str {
    var file: str = g_c_mc_file_esc;
    if g_c_mc_names == 0 {
        file = g_c_dbg_file_esc;
    }
    return "    __p_mc_at = \"" + file + ":" + int_to_str(ln) + "\";";
}

// ===========================================================================
// LF18: @constant_time on the C path (ccompile, dump-c, build through C)
// ===========================================================================
//
// The same IR-level check as peir_ct_check, which pe_ir and (since Nov 22)
// the machine layer both run; it moved from pe_ir.fd to checks.fd, which
// this file imports, so this copy could now be replaced by a call (a later
// cleanup). It was a copy because codegen_c.fd may not import pe_ir
// (known-bugs trap 17: that doubled the C of every program). Keep the two
// in step; the rules are the ones documented above peir_ct_check:
//
// Secret: every parameter, and every value computed from a secret
// (arithmetic, comparisons, conversions, addresses), a load from memory a
// secret was stored into (per alloca or global, flow-insensitive), the
// result of a call given a secret (except a length query: `len`, `*_len`,
// `*_length`); a call given a secret makes the memory behind every pointer
// it is given secret.
// Rejected in a @constant_time function: a conditional branch on a secret,
// integer division or remainder of a secret (except a signed division by a
// constant >= 2: C compilers turn it into a multiplication), float division
// of a secret, and an indirect call (closure, function value, dyn method).
//
// What this does not cover: the C compiler's own choices. The check proves
// the C it is handed has no secret branch or division; an optimizing C
// compiler can still turn a select into a branch (rare at -O2 for the mask
// idioms the stdlib uses). The machine-code check is the native backends'.
// FID_C_CT_OFF=1 turns the check off. A violation is reported on stderr,
// kept for the driver (CGen_ct_error_text), and written into the C as an
// `#error` line, so a C file with it never compiles.

/// The violations found by the last CCodeGen_generate, one per line ("" when
/// none): the driver turns them into compile errors.
var g_c_ct_err: str = "";

pub fn CGen_ct_error_text() -> str {
    return g_c_ct_err;
}

fn cgct_off() -> bool {
    var sw: str = p_getenv("FID_C_CT_OFF");
    return (sw as i64) != 0 && str_len(sw) > 0 && sw != "0";
}

/// The alloca or global that pointer `v` is derived from (through field and
/// element addresses and bit casts): its instruction id, or -1.
fn cgct_root(func: &IrFunction, v: i64) -> i64 {
    var cur: i64 = v;
    var steps: i64 = 0;
    while steps < 64 {
        match peir_inst_of(func, cur) {
            Inst::Alloca(_, _) => {
                return cur;
            }
            Inst::GlobalAddr(_, _) => {
                return cur;
            }
            Inst::GetFieldPtr(p, _, _) => {
                cur = p;
            }
            Inst::GetElemPtr(p, _, _) => {
                cur = p;
            }
            Inst::BitCast(p, _, _) => {
                cur = p;
            }
            _ => {
                return -1;
            }
        }
        steps = steps + 1;
    }
    return -1;
}

/// The key of the memory `p` points into ("a:<alloca id>", "g:<global>"),
/// or "" when it is not a local or a global.
fn cgct_mem_key(func: &IrFunction, p: i64) -> str {
    var root: i64 = cgct_root(func, p);
    if root < 0 {
        return "";
    }
    match peir_inst_of(func, root) {
        Inst::GlobalAddr(gname, _) => {
            return "g:" + gname;
        }
        _ => {
        }
    }
    return "a:" + int_to_str(root);
}

fn cgct_mem_secret(func: &IrFunction, mem: i64, p: i64) -> bool {
    var key: str = cgct_mem_key(func, p);
    if key == "" {
        return false;
    }
    return HashMap_contains(mem, key);
}

/// Mark the memory `p` points into as holding a secret; true when it was
/// not marked before.
fn cgct_mem_mark(func: &IrFunction, mem: i64, p: i64) -> bool {
    var key: str = cgct_mem_key(func, p);
    if key == "" || HashMap_contains(mem, key) {
        return false;
    }
    HashMap_insert(mem, key, 1);
    return true;
}

fn cgct_sec(secret: &Vec<i64>, v: i64) -> bool {
    return v >= 0 && v < secret.len() && secret.get(v) != 0;
}

fn cgct_args_secret(func: &IrFunction, secret: &Vec<i64>, mem: i64, args: Vec<i64>) -> bool {
    var i: i64 = 0;
    while i < args.len() {
        var a: i64 = args.get(i);
        if cgct_sec(secret, a) || cgct_mem_secret(func, mem, a) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn cgct_args_mark(func: &IrFunction, mem: i64, args: Vec<i64>) -> bool {
    var changed: bool = false;
    var i: i64 = 0;
    while i < args.len() {
        if cgct_mem_mark(func, mem, args.get(i)) {
            changed = true;
        }
        i = i + 1;
    }
    return changed;
}

fn cgct_is_len(name: str) -> bool {
    return name == "len" || str_ends_with(name, "_len") || str_ends_with(name, "_length");
}

fn cgct_unsigned(ty: IrType) -> bool {
    return ir_type_eq(ty, IrType::U8) || ir_type_eq(ty, IrType::U16) || ir_type_eq(ty, IrType::U32) || ir_type_eq(ty, IrType::U64);
}

fn cgct_line(func: &IrFunction, id: i64) -> str {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => {
            match m.source_line {
                OptU64::Some(v) => {
                    if v > 0 {
                        return " (line " + int_to_str(v as i64) + ")";
                    }
                }
                OptU64::None => {
                }
            }
        }
        OptValueMeta::None => {
        }
    }
    return "";
}

/// The violations of @constant_time function `func` (named `name`), one
/// message each; empty when it is clean.
pub fn cg_ct_check(func: &IrFunction, name: str) -> Vec<str> {
    var errs: Vec<str> = Vec::new();
    var nvals: i64 = func.value_metas.len() + func.insts.len() + func.params.len() + 16;
    if func.next_value + 1 > nvals {
        nvals = func.next_value + 1;
    }
    var secret: Vec<i64> = peir_zeros(nvals);
    var mem: i64 = HashMap_new();
    var pi: i64 = 0;
    while pi < func.params.len() {
        var pid: i64 = func.params.get(pi).id;
        if pid >= 0 && pid < nvals {
            secret.set(pid, 1);
        }
        pi = pi + 1;
    }
    var ids: Vec<i64> = Vec::new();
    var bi: i64 = 0;
    while bi < func.blocks.len() {
        var blk: BasicBlock = func.blocks.get(bi);
        var k: i64 = 0;
        while k < blk.instructions.len() {
            ids.push(blk.instructions.get(k));
            k = k + 1;
        }
        bi = bi + 1;
    }
    // Propagate to a fixpoint (secrets only grow)
    var changed: bool = true;
    var rounds: i64 = 0;
    while changed && rounds < nvals + 2 {
        changed = false;
        rounds = rounds + 1;
        var ii: i64 = 0;
        while ii < ids.len() {
            var id: i64 = ids.get(ii);
            var t: bool = false;
            match peir_inst_of(func, id) {
                Inst::BinOp(_, l, r, _) => {
                    t = cgct_sec(&secret, l) || cgct_sec(&secret, r);
                }
                Inst::UnaryOp(_, x, _) => {
                    t = cgct_sec(&secret, x);
                }
                Inst::BitCast(x, _, _) => {
                    t = cgct_sec(&secret, x);
                }
                Inst::IntExtend(x, _, _) => {
                    t = cgct_sec(&secret, x);
                }
                Inst::IntTrunc(x, _, _) => {
                    t = cgct_sec(&secret, x);
                }
                Inst::IntToFloat(x, _, _) => {
                    t = cgct_sec(&secret, x);
                }
                Inst::FloatToInt(x, _, _) => {
                    t = cgct_sec(&secret, x);
                }
                Inst::GetFieldPtr(p, _, _) => {
                    t = cgct_sec(&secret, p);
                }
                Inst::GetElemPtr(p, ix, _) => {
                    t = cgct_sec(&secret, p) || cgct_sec(&secret, ix);
                }
                Inst::Load(p, _) => {
                    t = cgct_sec(&secret, p) || cgct_mem_secret(func, mem, p);
                }
                Inst::Store(sptr, sval, _) => {
                    if cgct_sec(&secret, sval) || cgct_mem_secret(func, mem, sval) {
                        if cgct_mem_mark(func, mem, sptr) {
                            changed = true;
                        }
                    }
                }
                Inst::StructCopy(cdst, csrc, _) => {
                    if cgct_sec(&secret, csrc) || cgct_mem_secret(func, mem, csrc) {
                        if cgct_mem_mark(func, mem, cdst) {
                            changed = true;
                        }
                    }
                }
                Inst::Call(callee, cargs, _, _) => {
                    if cgct_args_secret(func, &secret, mem, cargs) {
                        if !cgct_is_len(callee) {
                            t = true;
                        }
                        if cgct_args_mark(func, mem, cargs) {
                            changed = true;
                        }
                    }
                }
                Inst::CallPtr(fptr, pargs, _, _, _) => {
                    if cgct_sec(&secret, fptr) || cgct_args_secret(func, &secret, mem, pargs) {
                        t = true;
                        if cgct_args_mark(func, mem, pargs) {
                            changed = true;
                        }
                    }
                }
                Inst::DynCall(_, _, dargs, _, _) => {
                    if cgct_args_secret(func, &secret, mem, dargs) {
                        t = true;
                        if cgct_args_mark(func, mem, dargs) {
                            changed = true;
                        }
                    }
                }
                _ => {
                }
            }
            if t && id >= 0 && id < nvals && secret.get(id) == 0 {
                secret.set(id, 1);
                changed = true;
            }
            ii = ii + 1;
        }
    }
    // What the code would do with the secrets
    var ci: i64 = 0;
    while ci < ids.len() {
        var cid: i64 = ids.get(ci);
        var what: str = "";
        match peir_inst_of(func, cid) {
            Inst::Branch(cond, _, _) => {
                if cgct_sec(&secret, cond) {
                    what = "conditional branch on secret data";
                }
            }
            Inst::BinOp(op, l, r, ty) => {
                var is_div: bool = false;
                match op {
                    BinOp::Div => {
                        is_div = true;
                    }
                    BinOp::Mod => {
                        is_div = true;
                    }
                    _ => {
                    }
                }
                if is_div && (cgct_sec(&secret, l) || cgct_sec(&secret, r)) {
                    if ir_type_is_float(ty) {
                        what = "float division of secret data (variable latency)";
                    } else {
                        var by_const: bool = false;
                        match peir_inst_of(func, r) {
                            Inst::ConstInt(d, _) => {
                                by_const = d >= 2 && !cgct_unsigned(ty);
                            }
                            _ => {
                            }
                        }
                        if !by_const {
                            what = "integer division of secret data (variable latency)";
                        }
                    }
                }
            }
            Inst::CallPtr(_, _, _, _, _) => {
                what = "indirect call (closure or function value)";
            }
            Inst::DynCall(_, _, _, _, _) => {
                what = "indirect call (dyn method)";
            }
            _ => {
            }
        }
        if what != "" {
            errs.push("@constant_time function '" + name + "': " + what + cgct_line(func, cid));
        }
        ci = ci + 1;
    }
    return errs;
}

/// Check every @constant_time function of `module`; the violations, one
/// error line each ("C backend: @constant_time violated: ...").
fn cg_ct_check_module(module: &IrModule) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if cgct_off() {
        return out;
    }
    var f: i64 = 0;
    while f < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(f);
        if entry.func.is_constant_time {
            var cfunc: IrFunction = entry.func;
            var errs: Vec<str> = cg_ct_check(&cfunc, entry.name);
            var i: i64 = 0;
            while i < errs.len() {
                out.push("C backend: @constant_time violated: " + errs.get(i));
                i = i + 1;
            }
        }
        f = f + 1;
    }
    return out;
}

pub fn CCodeGen_generate(self: &mut CCodeGen, module: IrModule) -> str {
    // LF18: @constant_time code is checked before any C is written; a
    // violation becomes an #error at the top of the file (every split unit
    // has it too: csplit keeps preprocessor lines in the header)
    g_c_ct_err = "";
    var ct_errs: Vec<str> = cg_ct_check_module(&module);
    var cte: i64 = 0;
    while cte < ct_errs.len() {
        var ct_line: str = ct_errs.get(cte);
        g_c_ct_err = g_c_ct_err + ct_line + "\n";
        p_eprint_str("error: " + ct_line + "\n");
        wln(self, "#error \"" + escape_c_string(ct_line) + "\"");
        cte = cte + 1;
    }
    // C lines written so far (counted only with -g, for #line, TL5)
    g_c_line = 0;
    g_c_uses_dl = false;
    CCodeGen_insert_runtime_sigs(self);
    while self.user_functions.len() > 0 {
        self.user_functions.pop();
    }
    while self.user_fn_param_types.len() > 0 {
        self.user_fn_param_types.pop();
    }  // Copy struct layouts for GetFieldPtr offset lookup
    while self.struct_layouts.len() > 0 {
        self.struct_layouts.pop();
    }
    HashMap_clear(self.layout_index);
    var sli: i64 = 0;
    while sli < module.struct_layouts.len() {
        self.struct_layouts.push(module.struct_layouts.get(sli));
        var sln: str = module.struct_layouts.get(sli).name;
        if !HashMap_contains(self.layout_index, sln) {
            HashMap_insert(self.layout_index, sln, self.struct_layouts.len());
        }
        sli = sli + 1;
    }

    var f: i64 = 0;
    while f < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(f);
        self.user_functions.push(entry.name);
        var types: Vec<IrType> = extract_param_types(entry.func.params);
        fn_param_types_set(self, entry.name, types);
        fn_ret_types_set(self, entry.name, entry.func.ret_ty);
        f = f + 1;
    }
    // The types a DynCall dispatches to (cg_dyn_candidate)
    cg_collect_dyn_types(&module);
    // RL25: extern "C" functions keep their names: sanitize_c_name skips
    // extern_func_names, which nothing filled, so `fn ldexp` of an extern
    // block was called as p_ldexp_user (2g.13 / B19 renames), which nothing
    // defines; its declaration and #define use the plain pledge_name
    // 2g.107: but not a name a Fides function also has (stdlib.h's `abs`
    // of an @import beside core's `pub fn abs`): the lowering calls the
    // Fides function (with its __env) by that name, so it keeps its rename
    // (abs -> p_abs) at the definition and at every call, and the extern's
    // declaration (its plain pledge_name, or the header's) stays apart.
    // Before, the extern stopped the rename and core's abs was emitted as
    // `int64_t abs(void*, int64_t)`: "conflicting types for 'abs'".
    var xf: i64 = 0;
    while xf < module.extern_decls.len() {
        val xname: str = module.extern_decls.get(xf).pledge_name;
        if IrModule_fn_pos(&module, xname) < 0 {
            vec_push_unique(&mut self.extern_func_names, xname);
        }
        xf = xf + 1;
    }
    // 2g.121: an extern's declared parameter types rule the casts at its
    // call sites: a `&mut` argument is a void* in the generated C where the
    // prototype takes int64_t (stdlib/net.fd's pledge_net_recvfrom), and
    // without them fn_param_types_get is None, no cast is inserted, and
    // clang rejects the call (-Wint-conversion). An extern with an aggregate
    // parameter or result keeps no entry: it is called through the
    // __c_wrap_ wrapper, whose parameters already are the C types (c_wrapped
    // is only filled in emit_extern_decls, after this point).
    var xp: i64 = 0;
    while xp < module.extern_functions.len() {
        val xfn: StringVecIrType = module.extern_functions.get(xp);
        var aggregate: bool = is_aggregate_ret(xfn.ret);
        var xa: i64 = 0;
        while xa < xfn.params.len() {
            if is_aggregate_ret(xfn.params.get(xa)) {
                aggregate = true;
            }
            xa = xa + 1;
        }
        if IrModule_fn_pos(&module, xfn.name) < 0 && !aggregate {
            fn_param_types_set(self, xfn.name, xfn.params);
        }
        xp = xp + 1;
    }

    if g_c_profile {
        wln(self, "#define P_PROFILE 1");
    }
    if g_c_leaks {
        wln(self, "#define P_LEAKS 1");
    }
    if g_c_checked_alloc {
        wln(self, "#define P_CHECKED_ALLOC 1");
    }
    if g_c_memprof {
        wln(self, "#define P_MEMPROF 1");
    }
    // -g: #line to the .fd source (TL5), the failing frame's values (CE8)
    if g_c_dbg {
        wln(self, "#define P_DEBUG_FRAMES 1");
    }
    // --lib (CI7, CI6): a shared library with a C API
    if g_c_lib {
        wln(self, "#define P_LIB 1");
        cg_lib_collect(self, module);
    }
    cg_emit_ffi_feature_macros(self, module);
    emit_runtime_header(self);
    emit_extern_decls(self, module);
    emit_runtime_types(self);
    emit_string_consts(self, module);
    emit_struct_defs(self, module);
    emit_globals(self, module);
    emit_prototypes(self, module);
    emit_global_init_function(self, module);
    // A9': what the program can reach (after emit_string_consts, which
    // collects the names it holds as strings and function references)
    cg_compute_live(self, module);

    f = 0;
    while f < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(f);
        if g_c_unit_marks {
            wln(self, "//@FN " + entry.name);
        }
        // ME28: dense matches become C switches (ir.fd; FID_SWITCH=off: no)
        var gfunc: IrFunction = entry.func;
        if ir_switch_on() {
            IrFunction_form_switches(&mut gfunc);
        }
        gen_function(self, entry.name, gfunc);
        f = f + 1;
    }
    if g_c_unit_marks {
        wln(self, "//@TAIL");
    }

    emit_main_wrapper(self, module);
    emit_runtime_impl(self);
    emit_file_write_bin_impl(self);
    // Panic traces name each frame through this table. A9': only functions
    // a run can reach are listed (a dead one cannot be in a trace), so the
    // table takes no dead function's address and they can be dropped.
    wln(self, "const __p_fn_entry __p_fns[] = {");
    var tf: i64 = 0;
    var n_listed: i64 = 0;
    while tf < module.functions.len() {
        var tname: str = module.functions.get(tf).name;
        if cg_is_live(tname) {
            wln(self, "    {(const void*)" + sanitize_c_name(self, tname) + ", \"" + tname + "\"},");
            n_listed = n_listed + 1;
        }
        tf = tf + 1;
    }
    if n_listed == 0 {
        wln(self, "    {0, 0},");
    }
    wln(self, "};");
    wln(self, "const int __p_fn_count = " + int_to_str(n_listed) + ";");
    // CO5: where `fid profile --pid` finds the table ("FIDPROF1ANCHOR!!")
    wln(self, "const __p_prof_anchor_t __p_prof_anchor = { { 0x31464F5250444946ULL, 0x2121524F48434E41ULL }, &__p_prof_anchor, __p_fns, &__p_fn_count };");
    // Convert the string builder to the final output string
    self.out = p_sb_to_str(self.sb);
    return self.out;
}

fn extract_param_types(params: Vec<ValueIdType>) -> Vec<IrType> {
    var v: Vec<IrType> = Vec::new();
    var i: i64 = 0;
    while i < params.len() {
        v.push(params.get(i).ty);
        i = i + 1;
    }
    return v;
}

fn emit_file_write_bin_impl(self: &mut CCodeGen) -> void {
    // Every byte of a file as one Vec element (binary-safe: keeps 0x00).
    wln(self, "PVec* p_file_read_bytes(const char* path) {");
    wln(self, "    PVec* v = p_vec_new();");
    wln(self, "    if (P_CAP_DENIED(P_CAP_FS)) return v;");
    wln(self, "    FILE* f = fopen(path, \"rb\");");
    wln(self, "    if (!f) return v;");
    wln(self, "    int c;");
    wln(self, "    while ((c = fgetc(f)) != EOF) p_vec_push(v, (void*)(intptr_t)c);");
    wln(self, "    fclose(f); return v;");
    wln(self, "}");
    // One fwrite of the bytes (one per byte took a lock each: 300 ms for
    // a 300 KB executable on Windows); the same file
    wln(self, "int64_t p_file_write_vec(const char* path, PVec* v) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_FS)) return -1;");
    wln(self, "    FILE* f = fopen(path, \"wb\");");
    wln(self, "    if (!f) return -1;");
    wln(self, "    unsigned char* buf = (unsigned char*)malloc(v->len > 0 ? (size_t)v->len : 1);");
    wln(self, "    if (!buf) { for (int64_t i = 0; i < v->len; i++) { unsigned char b = (unsigned char)(int64_t)P_VEC_AT(v, i); fwrite(&b, 1, 1, f); } fclose(f); return 0; }");
    wln(self, "    for (int64_t i = 0; i < v->len; i++) buf[i] = (unsigned char)(int64_t)P_VEC_AT(v, i);");
    wln(self, "    size_t w = fwrite(buf, 1, (size_t)v->len, f);");
    wln(self, "    free(buf);");
    wln(self, "    fclose(f); return w == (size_t)v->len ? 0 : -1;");
    wln(self, "}");
    // roadmap L4B (streaming file handles): up to n bytes at `offset`, one
    // element each; empty past the end or when the file cannot be read.
    // Declared `extern fn` in stdlib/core.fd (its prototype is the same:
    // a Vec is void* there)
    wln(self, "void* p_file_read_at(const char* path, int64_t offset, int64_t n) {");
    wln(self, "    PVec* v = p_vec_new();");
    wln(self, "    if (P_CAP_DENIED(P_CAP_FS) || !path || offset < 0 || n <= 0) return v;");
    wln(self, "    if (n > ((int64_t)1 << 30)) n = (int64_t)1 << 30;");
    wln(self, "    FILE* f = fopen(path, \"rb\");");
    wln(self, "    if (!f) return v;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    int sk = _fseeki64(f, (long long)offset, SEEK_SET);");
    wln(self, "#else");
    wln(self, "    int sk = fseeko(f, (off_t)offset, SEEK_SET);");
    wln(self, "#endif");
    wln(self, "    if (sk != 0) { fclose(f); return v; }");
    wln(self, "    size_t chunk = n < 65536 ? (size_t)n : 65536;");
    wln(self, "    unsigned char* buf = (unsigned char*)malloc(chunk);");
    wln(self, "    if (!buf) { fclose(f); return v; }");
    wln(self, "    int64_t left = n;");
    wln(self, "    while (left > 0) {");
    wln(self, "        size_t want = left < (int64_t)chunk ? (size_t)left : chunk;");
    wln(self, "        size_t got = fread(buf, 1, want, f);");
    wln(self, "        for (size_t i = 0; i < got; i++) p_vec_push(v, (void*)(intptr_t)buf[i]);");
    wln(self, "        left -= (int64_t)got;");
    wln(self, "        if (got < want) break;");
    wln(self, "    }");
    wln(self, "    free(buf);");
    wln(self, "    fclose(f);");
    wln(self, "    return v;");
    wln(self, "}");
    // Each element's low byte after what the file holds (created if
    // missing): zero bytes included, as p_file_append (a C string) cannot
    wln(self, "int64_t p_file_append_vec(const char* path, void* vp) {");
    wln(self, "    PVec* v = (PVec*)vp;");
    wln(self, "    if (P_CAP_DENIED(P_CAP_FS) || !path) return -1;");
    wln(self, "    FILE* f = fopen(path, \"ab\");");
    wln(self, "    if (!f) return -1;");
    wln(self, "    int64_t len = v ? v->len : 0;");
    wln(self, "    if (len <= 0) { fclose(f); return 0; }");
    wln(self, "    unsigned char* buf = (unsigned char*)malloc((size_t)len);");
    wln(self, "    if (!buf) { fclose(f); return -1; }");
    wln(self, "    for (int64_t i = 0; i < len; i++) buf[i] = (unsigned char)(int64_t)P_VEC_AT(v, i);");
    wln(self, "    size_t w = fwrite(buf, 1, (size_t)len, f);");
    wln(self, "    free(buf);");
    wln(self, "    int c = fclose(f);");
    wln(self, "    return (w == (size_t)len && c == 0) ? 0 : -1;");
    wln(self, "}");
}

// roadmap L6C: whether a function calls p_dl_load or p_dl_find (gen_function
// notes it; the runtime is written after the functions)
var g_c_uses_dl: bool = false;

fn cg_note_dl_call(it: Inst) {
    match it {
        Inst::Call(fname, _, _, _) => {
            if fname == "p_dl_load" || fname == "p_dl_find" || fname == "p_dl_unload" {
                g_c_uses_dl = true;
            }
        }
        _ => {
        }
    }
}

/// RT7: pages taken from and given back to the operating system, for the
/// allocator's chunks and large blocks (VirtualAlloc/VirtualFree on Windows,
/// mmap/munmap/madvise on POSIX). WASI (and -DP_NO_OSMEM) has none: calloc
/// and free stand in, and nothing is decommitted.
///   __p_os_map(n)         n bytes of zeroed pages, NULL when there are none
///   __p_os_unmap(p, n)    back to the system, the address range too
///   __p_os_decommit(p, n) the pages' memory back, the range kept (1: done)
///   __p_os_recommit(p, n) usable again (Windows commits; POSIX: the next
///                         touch brings a page back)
fn emit_os_mem_runtime(self: &mut CCodeGen) {
    wln(self, "#if defined(P_NO_OSMEM) || defined(__wasi__)");
    wln(self, "#define P_OSMEM 0");
    wln(self, "#elif defined(_WIN32)");
    wln(self, "#define P_OSMEM 1");
    wln(self, "#else");
    wln(self, "#define P_OSMEM 1");
    wln(self, "#include <sys/mman.h>");
    wln(self, "#include <unistd.h>");
    wln(self, "#if !defined(MAP_ANONYMOUS) && defined(MAP_ANON)");
    wln(self, "#define MAP_ANONYMOUS MAP_ANON");
    wln(self, "#endif");
    wln(self, "#endif");
    wln(self, "static size_t __p_os_pg = 0;");
    wln(self, "static size_t __p_os_page(void) {");
    wln(self, "    if (!__p_os_pg) {");
    wln(self, "#if P_OSMEM && defined(_WIN32)");
    wln(self, "        SYSTEM_INFO si; GetSystemInfo(&si);");
    wln(self, "        __p_os_pg = si.dwPageSize ? (size_t)si.dwPageSize : 4096;");
    wln(self, "#elif P_OSMEM");
    wln(self, "        long v = sysconf(_SC_PAGESIZE);");
    wln(self, "        __p_os_pg = v > 0 ? (size_t)v : 4096;");
    wln(self, "#else");
    wln(self, "        __p_os_pg = 4096;");
    wln(self, "#endif");
    wln(self, "    }");
    wln(self, "    return __p_os_pg;");
    wln(self, "}");
    wln(self, "static void* __p_os_map(size_t n) {");
    wln(self, "#if P_OSMEM && defined(_WIN32)");
    wln(self, "    return VirtualAlloc(NULL, n, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);");
    wln(self, "#elif P_OSMEM");
    wln(self, "    void* p = mmap(NULL, n, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);");
    wln(self, "    return p == MAP_FAILED ? NULL : p;");
    wln(self, "#else");
    wln(self, "    return calloc(1, n);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static void __p_os_unmap(void* p, size_t n) {");
    wln(self, "#if P_OSMEM && defined(_WIN32)");
    wln(self, "    (void)n; VirtualFree(p, 0, MEM_RELEASE);");
    wln(self, "#elif P_OSMEM");
    wln(self, "    munmap(p, n);");
    wln(self, "#else");
    wln(self, "    (void)n; free(p);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static int __p_os_decommit(void* p, size_t n) {");
    wln(self, "#if P_OSMEM && defined(_WIN32)");
    wln(self, "    return VirtualFree(p, n, MEM_DECOMMIT) ? 1 : 0;");
    wln(self, "#elif P_OSMEM && defined(__linux__) && defined(MADV_DONTNEED)");
    wln(self, "    return madvise(p, n, MADV_DONTNEED) == 0 ? 1 : 0;");
    wln(self, "#elif P_OSMEM");
    // a fresh mapping over the range: its old pages go, new ones read zero
    wln(self, "    return mmap(p, n, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) == p ? 1 : 0;");
    wln(self, "#else");
    wln(self, "    (void)p; (void)n; return 0;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static int __p_os_recommit(void* p, size_t n) {");
    wln(self, "#if P_OSMEM && defined(_WIN32)");
    wln(self, "    return VirtualAlloc(p, n, MEM_COMMIT, PAGE_READWRITE) != NULL;");
    wln(self, "#else");
    wln(self, "    (void)p; (void)n; return 1;");
    wln(self, "#endif");
    wln(self, "}");
}

/// RT8: the heaps. Each thread allocates from a heap of its own (__p_heap:
/// free lists by class, the 4 MB chunks it bumps blocks from, the counts
/// below, a span cache), taken at its first allocation and given back to a
/// pool when it ends (a POSIX key's destructor, a Windows TLS callback,
/// p_thread_wrapper), where the next thread to start takes it whole. A
/// chunk is aligned to its size and records its owner heap, so p_free finds
/// a block's owner from its address: a block freed by a thread whose heap
/// does not own it goes back to the owner (owner return: the owner's xfree,
/// an atomic stack the owner takes whole on its slow path, at a trim and at
/// its thread's end), never onto the freeing thread's lists. Heaps are never
/// freed, so a block freed after its thread ended still finds its heap.
/// RT7: freed memory goes back to the system. A large block (over 1 MB) is
/// pages of its own (P_CLASS_MAPPED), unmapped by p_free. The smaller
/// classes live in 4 MB chunks: p_free counts the bytes on its heap's free
/// lists (fl_bytes) and, past trim_next (8 MB at first, then what is left
/// plus a quarter, at least 8 MB), __p_heap_trim
///   - takes over the chunks and blocks of the heaps of ended threads in the
///     pool (__p_heap_merge_pool) and the blocks others freed into the heap;
///   - finds the chunks of the heap whose every handed-out byte is on its
///     free lists, takes their blocks off the lists and unmaps them (but the
///     current chunk and the P_KEEP_FREE_CHUNKS first empty ones, which the
///     next allocations reuse);
///   - decommits the inside pages of each other free block of 256 KB or
///     more (its header and link word stay): the header gets
///     P_BLOCK_DECOMMITTED, and p_malloc recommits it before reuse.
/// Only the owner's lists hold a chunk's free blocks, so a chunk whose
/// bytes are all on them holds nothing in use: never unmapped while in use.
/// Once p_arena_save has marked a position (chunk indexes), the heap gives
/// no chunk back. FID_MEM_RETURN=0 turns the trimming off (to compare);
/// large blocks are unmapped either way.
/// RT8: a free block of 256 KB or more is decommitted only once it has
/// stayed free through a whole trim interval (p_free stamps it with
/// __p_trim_epoch in its second word; a trim takes the ones stamped before
/// the previous trim): a block a busy program frees and asks for again is
/// not decommitted and recommitted each time (a page fault per page on
/// reuse, slower than zeroing it). A thread that ends decommits them all.
/// RT8: the span cache. A large block's pages (P_CLASS_MAPPED) are kept
/// for the next large block of this thread, zeroed then (__p_zero_big)
/// instead of mapped again (fresh pages cost a page fault each: several
/// times slower than zeroing them in place), only while the thread is
/// asking for large blocks often (P_SPAN_WARM in P_SPAN_WARM_MS): one big
/// block freed now and then is unmapped at once, as before. At most
/// P_SPAN_CACHE_N spans of P_SPAN_CACHE_MAX bytes each and
/// P_SPAN_CACHE_BYTES in all; a span not reused within P_SPAN_PURGE_MS is
/// unmapped at the next large block, trim or thread end.
/// FID_SPAN_CACHE=0 turns it off.
fn emit_mem_return_runtime(self: &mut CCodeGen) {
    // RT8: the allocator's function attributes: P_ALLOC_COLD (out of line,
    // rare), P_ALLOC_OUT (out of line: the inline paths save no registers),
    // P_ZERO_ALWAYS (inlined even at -O1)
    wln(self, "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__TINYC__)");
    wln(self, "#define P_ALLOC_COLD __attribute__((noinline, cold))");
    wln(self, "#define P_ALLOC_OUT __attribute__((noinline))");
    wln(self, "#define P_ZERO_ALWAYS __attribute__((always_inline))");
    wln(self, "#else");
    wln(self, "#define P_ALLOC_COLD");
    wln(self, "#define P_ALLOC_OUT");
    wln(self, "#define P_ZERO_ALWAYS");
    wln(self, "#endif");
    wln(self, "#define P_ZERO_INLINE P_ZERO_ALWAYS inline");
    wln(self, "#define P_CLASS_MAPPED 62");
    wln(self, "#define P_BLOCK_DECOMMITTED 0x80ULL");
    // RT8: a free block cut from a chunk's fresh pages (__p_chunk_carve):
    // zero but its link word; such blocks wait on their own lists (zl)
    wln(self, "#define P_BLOCK_ZERO 0x40ULL");
    wln(self, "#ifndef P_TRIM_MIN");
    wln(self, "#define P_TRIM_MIN ((int64_t)8 << 20)");
    wln(self, "#endif");
    wln(self, "#ifndef P_DECOMMIT_MIN");
    wln(self, "#define P_DECOMMIT_MIN ((int64_t)256 << 10)");
    wln(self, "#endif");
    wln(self, "#ifndef P_KEEP_FREE_CHUNKS");
    wln(self, "#define P_KEEP_FREE_CHUNKS 2");
    wln(self, "#endif");
    // (__p_zero's thresholds, emit_block_alloc_runtime: the free and the
    // lists stamp blocks this big with the traffic)
    wln(self, "#ifndef P_ZERO_NT_MIN");
    wln(self, "#define P_ZERO_NT_MIN ((size_t)16 << 10)");
    wln(self, "#endif");
    wln(self, "#ifndef P_ZERO_HOT");
    wln(self, "#define P_ZERO_HOT ((uint64_t)256 << 10)");
    wln(self, "#endif");
    wln(self, "static int __p_mem_return = -1;");
    // the bytes of size class k (as p_malloc rounds: 2^(k/2), or 3/4 of
    // 2^((k+1)/2) for odd k)
    wln(self, "static inline int64_t __p_cls_bytes(int k) {");
    wln(self, "    if (k & 1) { int64_t b = (int64_t)1 << ((k + 1) / 2); return b - b / 4; }");
    wln(self, "    return (int64_t)1 << (k / 2);");
    wln(self, "}");
    // the same as a table, for the fast paths
    wln(self, "static const int64_t __p_cls_sz[41] = { 1, 2, 2, 3, 4, 6, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192, 256, 384, 512, 768, 1024, 1536, 2048, 3072, 4096, 6144, 8192, 12288, 16384, 24576, 32768, 49152, 65536, 98304, 131072, 196608, 262144, 393216, 524288, 786432, 1048576 };");
    // RT8: the span cache (the doc comment above)
    wln(self, "#ifndef P_SPAN_CACHE_N");
    wln(self, "#define P_SPAN_CACHE_N 16");
    wln(self, "#endif");
    wln(self, "#ifndef P_SPAN_CACHE_BYTES");
    wln(self, "#define P_SPAN_CACHE_BYTES ((int64_t)64 << 20)");
    wln(self, "#endif");
    wln(self, "#ifndef P_SPAN_CACHE_MAX");
    wln(self, "#define P_SPAN_CACHE_MAX ((size_t)8 << 20)");
    wln(self, "#endif");
    wln(self, "#ifndef P_SPAN_PURGE_MS");
    wln(self, "#define P_SPAN_PURGE_MS 250");
    wln(self, "#endif");
    wln(self, "#ifndef P_SPAN_WARM");
    wln(self, "#define P_SPAN_WARM 8");
    wln(self, "#endif");
    wln(self, "#ifndef P_SPAN_WARM_MS");
    wln(self, "#define P_SPAN_WARM_MS 1000");
    wln(self, "#endif");
    wln(self, "static int __p_span_on = -1;");
    // RT8: a heap (the per-thread state of the allocator, a thread's until
    // it ends, then the next thread's that starts: __p_heap_attach). fl: the
    // free lists by class (headers P_BLOCK_FREED | flags | k), the blocks of
    // this heap's chunks only; zl: blocks cut from fresh pages, zero but
    // their link word (not counted in fl_bytes: not resident yet); cur: the
    // chunk blocks are bumped from, the last of the list head; the rest as
    // the doc comment above says (the trim, the span cache: spans of 16 as
    // P_SPAN_CACHE_N's default, written out for csplit). xfree, alone in its
    // cache line: the blocks of this heap's chunks other threads freed (owner
    // return), a stack they push on with a compare-and-swap and the heap
    // takes whole (__p_heap_drain: on its slow path, at a trim, at its
    // thread's end) with one exchange, so no pop races a push.
    wln(self, "struct __p_heap {");
    wln(self, "    uint64_t* fl[41];");
    wln(self, "    uint64_t* zl[41];");
    wln(self, "    __p_arena_chunk* cur;");
    wln(self, "    __p_arena_chunk* head;");
    wln(self, "    int64_t fl_bytes;");
    wln(self, "    int64_t trim_next;");
    wln(self, "    int64_t trim_epoch;");
    wln(self, "    uint64_t traffic;");
    wln(self, "    int64_t arena_marked;");
    wln(self, "    uint64_t* span_m[16];");
    wln(self, "    uint64_t span_at[16];");
    wln(self, "    int64_t span_n;");
    wln(self, "    int64_t span_bytes;");
    wln(self, "    uint64_t big_t0;");
    wln(self, "    int64_t big_cnt;");
    wln(self, "    struct __p_heap* pool_next;");
    wln(self, "    int64_t dead;");
    wln(self, "    int64_t pool_freed;");
    wln(self, "    int64_t pad0[8];");
    wln(self, "    uint64_t* xfree;");
    wln(self, "    int64_t pad1[8];");
    wln(self, "};");
    // atomics on a chunk's owner and a heap's xfree (GNU builtins, MSVC's
    // intrinsics; TCC has no threads of its own here: plain accesses)
    wln(self, "#if defined(__TINYC__)");
    wln(self, "#define __P_OWNER(c) ((c)->owner)");
    wln(self, "#define __P_SET_OWNER(c, h) ((c)->owner = (h))");
    wln(self, "#define __P_XFREE_ANY(h) ((h)->xfree)");
    wln(self, "#elif defined(_MSC_VER)");
    wln(self, "#define __P_OWNER(c) (*(__p_heap* volatile*)&(c)->owner)");
    wln(self, "#define __P_SET_OWNER(c, h) (*(__p_heap* volatile*)&(c)->owner = (h))");
    wln(self, "#define __P_XFREE_ANY(h) (*(uint64_t* volatile*)&(h)->xfree)");
    wln(self, "#else");
    wln(self, "#define __P_OWNER(c) __atomic_load_n(&(c)->owner, __ATOMIC_ACQUIRE)");
    wln(self, "#define __P_SET_OWNER(c, h) __atomic_store_n(&(c)->owner, (h), __ATOMIC_RELEASE)");
    wln(self, "#define __P_XFREE_ANY(h) __atomic_load_n(&(h)->xfree, __ATOMIC_RELAXED)");
    wln(self, "#endif");
    // block b (header P_BLOCK_FREED | k written) onto heap o's xfree
    wln(self, "static inline void __p_xfree_push(__p_heap* o, uint64_t* b) {");
    wln(self, "#if defined(__TINYC__)");
    wln(self, "    b[0] = (uint64_t)(uintptr_t)o->xfree;");
    wln(self, "    o->xfree = b;");
    wln(self, "#elif defined(_MSC_VER)");
    wln(self, "    void* old = *(void* volatile*)&o->xfree;");
    wln(self, "    for (;;) {");
    wln(self, "        b[0] = (uint64_t)(uintptr_t)old;");
    wln(self, "        void* seen = _InterlockedCompareExchangePointer((void* volatile*)&o->xfree, (void*)b, old);");
    wln(self, "        if (seen == old) break;");
    wln(self, "        old = seen;");
    wln(self, "    }");
    wln(self, "#else");
    wln(self, "    uint64_t* old = __atomic_load_n(&o->xfree, __ATOMIC_RELAXED);");
    wln(self, "    do { b[0] = (uint64_t)(uintptr_t)old; } while (!__atomic_compare_exchange_n(&o->xfree, &old, b, 1, __ATOMIC_RELEASE, __ATOMIC_RELAXED));");
    wln(self, "#endif");
    wln(self, "}");
    // every block on heap h's xfree, taken off it (NULL: none)
    wln(self, "static inline uint64_t* __p_xfree_take(__p_heap* h) {");
    wln(self, "    if (!__P_XFREE_ANY(h)) return NULL;");
    wln(self, "#if defined(__TINYC__)");
    wln(self, "    uint64_t* b = h->xfree;");
    wln(self, "    h->xfree = NULL;");
    wln(self, "    return b;");
    wln(self, "#elif defined(_MSC_VER)");
    wln(self, "    return (uint64_t*)_InterlockedExchangePointer((void* volatile*)&h->xfree, NULL);");
    wln(self, "#else");
    wln(self, "    return __atomic_exchange_n(&h->xfree, (uint64_t*)NULL, __ATOMIC_ACQUIRE);");
    wln(self, "#endif");
    wln(self, "}");
    // This thread's heap (NULL before its first allocation and after its end).
    // RT10 x RT8: under M:N a task may go on on another worker thread after
    // any call, and the C compiler takes a thread-local's address to be the
    // same throughout a function, so code inlined into a task's function must
    // not keep it across a call. __P_HEAP() reads it through the thread
    // pointer, in an asm volatile the compiler runs again at each use, at an
    // offset the same on every thread (__p_heap_tp, taken once by
    // __p_heap_init): Windows x64, the TEB's TLS slot __p_heap_slot (gs:0x1480
    // + 8 * slot, kept equal to __p_tl_heap by __p_heap_attach/detach; a
    // slot past the TEB's 64, P_ASLOW_NOTP: the slow paths only); ELF, the
    // thread-local's offset from the thread pointer (fs:0 on x86-64, read with
    // one fs-relative load; tpidr_el0; tp). Where there is no such register
    // (macOS, others) a function the compiler cannot inline reads it. Without
    // M:N, the thread-local itself. The out-of-line paths read __p_tl_heap
    // directly: a call of theirs runs on one thread.
    wln(self, "static P_THREAD_LOCAL __p_heap* __p_tl_heap = NULL;");
    wln(self, "static intptr_t __p_heap_tp = 0;");
    wln(self, "static unsigned long __p_heap_slot = 0;");
    wln(self, "#if defined(P_MN) && defined(__x86_64__) && defined(_WIN32)");
    wln(self, "#define P_HEAP_TP 1");
    wln(self, "static inline __p_heap* __p_heap_tp_load(void) { __p_heap* h; __asm__ volatile(\"movq %%gs:(%1), %0\" : \"=r\"(h) : \"r\"(__p_heap_tp)); return h; }");
    wln(self, "#elif defined(P_MN) && defined(__x86_64__) && (defined(__linux__) || defined(__FreeBSD__))");
    wln(self, "#define P_HEAP_TP 1");
    wln(self, "static inline char* __p_tp(void) { char* t; __asm__ volatile(\"movq %%fs:0, %0\" : \"=r\"(t)); return t; }");
    wln(self, "static inline __p_heap* __p_heap_tp_load(void) { __p_heap* h; __asm__ volatile(\"movq %%fs:(%1), %0\" : \"=r\"(h) : \"r\"(__p_heap_tp)); return h; }");
    wln(self, "#elif defined(P_MN) && defined(__aarch64__) && (defined(__linux__) || defined(__FreeBSD__))");
    wln(self, "#define P_HEAP_TP 1");
    wln(self, "static inline char* __p_tp(void) { char* t; __asm__ volatile(\"mrs %0, tpidr_el0\" : \"=r\"(t)); return t; }");
    wln(self, "static inline __p_heap* __p_heap_tp_load(void) { return *(__p_heap* const*)(__p_tp() + __p_heap_tp); }");
    wln(self, "#elif defined(P_MN) && defined(__riscv) && defined(__linux__)");
    wln(self, "#define P_HEAP_TP 1");
    wln(self, "static inline char* __p_tp(void) { char* t; __asm__ volatile(\"mv %0, tp\" : \"=r\"(t)); return t; }");
    wln(self, "static inline __p_heap* __p_heap_tp_load(void) { return *(__p_heap* const*)(__p_tp() + __p_heap_tp); }");
    wln(self, "#endif");
    wln(self, "#if defined(P_HEAP_TP)");
    wln(self, "#define __P_HEAP() __p_heap_tp_load()");
    wln(self, "#elif defined(P_MN)");
    wln(self, "static P_MN_NOINLINE __p_heap* __p_heap_now(void) { __p_heap* h = __p_tl_heap; __asm__ volatile(\"\" ::: \"memory\"); return h; }");
    wln(self, "#define __P_HEAP() __p_heap_now()");
    wln(self, "#else");
    wln(self, "#define __P_HEAP() (__p_tl_heap)");
    wln(self, "#endif");
    // this thread's heap is h (NULL: none): the thread-local, and on Windows
    // the TEB slot __P_HEAP() reads
    wln(self, "static void __p_heap_set(__p_heap* h) {");
    wln(self, "    __p_tl_heap = h;");
    wln(self, "#if defined(P_HEAP_TP) && defined(_WIN32)");
    wln(self, "    if (__p_heap_tp) TlsSetValue((DWORD)__p_heap_slot, h);");
    wln(self, "#endif");
    wln(self, "}");
    // The heaps of threads that ended (__p_heap_detach), under one lock: a
    // thread's first allocation takes one whole (its chunks, lists and
    // xfree; a chunk keeps its owner), and a trim takes over the chunks and
    // blocks of those that hold any (__p_heap_merge_pool; __p_pool_full of
    // them). Heaps are never freed, so a block pushed on one late is found.
    // (the variables outside any #if: csplit gives unit 0's definitions to
    // the other units through extern declarations)
    wln(self, "static volatile long __p_pool_lk = 0;");
    wln(self, "#if defined(__TINYC__)");
    wln(self, "#define __P_POOL_LOCK() ((void)0)");
    wln(self, "#define __P_POOL_UNLOCK() ((void)0)");
    wln(self, "#elif defined(_MSC_VER)");
    wln(self, "#include <intrin.h>");
    wln(self, "#define __P_POOL_LOCK() while (_InterlockedExchange(&__p_pool_lk, 1)) {}");
    wln(self, "#define __P_POOL_UNLOCK() _InterlockedExchange(&__p_pool_lk, 0)");
    wln(self, "#else");
    wln(self, "#define __P_POOL_LOCK() while (__sync_lock_test_and_set(&__p_pool_lk, 1)) {}");
    wln(self, "#define __P_POOL_UNLOCK() __sync_lock_release(&__p_pool_lk)");
    wln(self, "#endif");
    wln(self, "static __p_heap* __p_pool = NULL;");
    wln(self, "static volatile int64_t __p_pool_full = 0;");
    // a thread's end is seen on POSIX by a key's destructor (any thread, the
    // C library's own included), on Windows by a TLS callback (below)
    wln(self, "#if !defined(_WIN32) && !defined(__wasi__) && !defined(__TINYC__)");
    wln(self, "#include <pthread.h>");
    wln(self, "#define P_HEAP_KEY 1");
    wln(self, "#endif");
    wln(self, "#ifdef P_HEAP_KEY");
    wln(self, "static pthread_key_t __p_heap_key;");
    wln(self, "#endif");
    // a millisecond clock (only its differences are used)
    wln(self, "#if !defined(_WIN32)");
    wln(self, "#include <time.h>");
    wln(self, "#endif");
    wln(self, "static uint64_t __p_ms_now(void) {");
    wln(self, "#if defined(_WIN32)");
    wln(self, "    return (uint64_t)GetTickCount64();");
    wln(self, "#else");
    wln(self, "    struct timespec ts;");
    wln(self, "    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;");
    wln(self, "    return (uint64_t)ts.tv_sec * 1000u + (uint64_t)ts.tv_nsec / 1000000u;");
    wln(self, "#endif");
    wln(self, "}");
    // the cached spans of heap h not reused for P_SPAN_PURGE_MS (all: every
    // one) back to the system
    wln(self, "static void __p_span_purge(__p_heap* h, uint64_t now, int all) {");
    wln(self, "    int64_t i = 0;");
    wln(self, "    while (i < h->span_n) {");
    wln(self, "        if (all || now - h->span_at[i] >= (uint64_t)P_SPAN_PURGE_MS) {");
    wln(self, "            uint64_t* m = h->span_m[i];");
    wln(self, "            h->span_bytes -= (int64_t)m[0];");
    wln(self, "            __p_os_unmap(m, (size_t)m[0]);");
    wln(self, "            h->span_n--;");
    wln(self, "            h->span_m[i] = h->span_m[h->span_n];");
    wln(self, "            h->span_at[i] = h->span_at[h->span_n];");
    wln(self, "        } else i++;");
    wln(self, "    }");
    wln(self, "}");
    // a cached span of at least `span` bytes and at most a quarter more
    // (the smallest), out of the cache; NULL when there is none
    wln(self, "static uint64_t* __p_span_take(__p_heap* h, size_t span) {");
    wln(self, "    int64_t best = -1;");
    wln(self, "    size_t bs = 0;");
    wln(self, "    for (int64_t i = 0; i < h->span_n; i++) {");
    wln(self, "        size_t s = (size_t)h->span_m[i][0];");
    wln(self, "        if (s >= span && s - span <= span / 4 && (best < 0 || s < bs)) { best = i; bs = s; }");
    wln(self, "    }");
    wln(self, "    if (best < 0) return NULL;");
    wln(self, "    uint64_t* m = h->span_m[best];");
    wln(self, "    h->span_n--;");
    wln(self, "    h->span_m[best] = h->span_m[h->span_n];");
    wln(self, "    h->span_at[best] = h->span_at[h->span_n];");
    wln(self, "    h->span_bytes -= (int64_t)bs;");
    wln(self, "    return m;");
    wln(self, "}");
    // a large block's allocation counts toward the warm window
    wln(self, "static void __p_span_note_alloc(__p_heap* h, uint64_t now) {");
    wln(self, "    if (now - h->big_t0 > (uint64_t)P_SPAN_WARM_MS) { h->big_t0 = now; h->big_cnt = 0; }");
    wln(self, "    h->big_cnt++;");
    wln(self, "}");
    // a freed large block's pages m (m[0]: their size): cached in the
    // freeing thread's heap h when it is warm and they fit, else unmapped
    // (a span is pages of its own: nothing of another thread's next to it)
    wln(self, "static void __p_span_free(__p_heap* h, uint64_t* m) {");
    wln(self, "    size_t span = (size_t)m[0];");
    wln(self, "    if (__p_span_on < 0) { const char* e = getenv(\"FID_SPAN_CACHE\"); __p_span_on = (e && e[0] == '0' && e[1] == 0) ? 0 : 1; }");
    wln(self, "    if (!h) { __p_os_unmap(m, span); return; }");
    wln(self, "    uint64_t now = __p_ms_now();");
    wln(self, "    if (h->span_n) __p_span_purge(h, now, 0);");
    wln(self, "    if (__p_span_on && span <= P_SPAN_CACHE_MAX && (int64_t)span <= P_SPAN_CACHE_BYTES && h->big_cnt >= P_SPAN_WARM && now - h->big_t0 <= (uint64_t)P_SPAN_WARM_MS) {");
    // room: the oldest spans go first
    wln(self, "        while (h->span_n > 0 && (h->span_n >= P_SPAN_CACHE_N || h->span_n >= 16 || h->span_bytes + (int64_t)span > P_SPAN_CACHE_BYTES)) {");
    wln(self, "            int64_t o = 0;");
    wln(self, "            for (int64_t i = 1; i < h->span_n; i++) if (h->span_at[i] < h->span_at[o]) o = i;");
    wln(self, "            uint64_t* om = h->span_m[o];");
    wln(self, "            h->span_bytes -= (int64_t)om[0];");
    wln(self, "            __p_os_unmap(om, (size_t)om[0]);");
    wln(self, "            h->span_n--;");
    wln(self, "            h->span_m[o] = h->span_m[h->span_n];");
    wln(self, "            h->span_at[o] = h->span_at[h->span_n];");
    wln(self, "        }");
    wln(self, "        if (h->span_n < P_SPAN_CACHE_N && h->span_n < 16) {");
    wln(self, "            m[1] = h->traffic;");
    wln(self, "            h->span_m[h->span_n] = m;");
    wln(self, "            h->span_at[h->span_n] = now;");
    wln(self, "            h->span_n++;");
    wln(self, "            h->span_bytes += (int64_t)span;");
    wln(self, "            return;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    __p_os_unmap(m, span);");
    wln(self, "}");
    // the whole pages inside free block b of sz bytes, after its link word
    // and before its end
    wln(self, "static int __p_block_pages(uint64_t* b, int64_t sz, char** lo, size_t* n) {");
    wln(self, "    uintptr_t pg = (uintptr_t)__p_os_page();");
    wln(self, "    uintptr_t s = ((uintptr_t)(b + 1) + pg - 1) & ~(pg - 1);");
    wln(self, "    uintptr_t e = ((uintptr_t)(b - 1) + (uintptr_t)sz) & ~(pg - 1);");
    wln(self, "    if (e <= s) return 0;");
    wln(self, "    *lo = (char*)s;");
    wln(self, "    *n = (size_t)(e - s);");
    wln(self, "    return 1;");
    wln(self, "}");
    // A decommitted free block made usable and zero: its pages are
    // committed again (and read zero: Windows recommits zero pages, Linux's
    // MADV_DONTNEED and the POSIX remap leave zero pages), the bytes around
    // them are cleared.
    wln(self, "static void __p_block_recommit(uint64_t* b, int64_t sz) {");
    wln(self, "    char* lo = NULL; size_t n = 0;");
    wln(self, "    if (!__p_block_pages(b, sz, &lo, &n)) { memset(b, 0, (size_t)sz - 8); return; }");
    wln(self, "    if (!__p_os_recommit(lo, n)) __p_oom(n);");
    wln(self, "    memset(b, 0, (size_t)(lo - (char*)b));");
    wln(self, "    char* end = (char*)(b - 1) + sz;");
    wln(self, "    memset(lo + n, 0, (size_t)(end - (lo + n)));");
    wln(self, "}");
    // freed block b of class k onto heap h's list, stamped as p_free stamps
    // (the trim's epoch on a block it may decommit, the traffic on one
    // __p_zero may find cold)
    wln(self, "static inline void __p_heap_put(__p_heap* h, uint64_t* b, int k) {");
    wln(self, "    int64_t sz = __p_cls_sz[k];");
    wln(self, "    if (sz >= P_DECOMMIT_MIN) b[1] = (uint64_t)h->trim_epoch;");
    wln(self, "    if (sz >= (int64_t)P_ZERO_NT_MIN) b[2] = h->traffic;");
    wln(self, "    b[0] = (uint64_t)(uintptr_t)h->fl[k];");
    wln(self, "    h->fl[k] = b;");
    wln(self, "    h->fl_bytes += sz;");
    wln(self, "}");
    // the blocks on heap `from`'s xfree, each where it belongs: on heap
    // me's lists when me owns its chunk now, else on its owner's xfree (a
    // block pushed on a heap whose chunks a trim took over meanwhile)
    wln(self, "static void __p_heap_drain_into(__p_heap* from, __p_heap* me) {");
    wln(self, "    uint64_t* b = __p_xfree_take(from);");
    wln(self, "    while (b) {");
    wln(self, "        uint64_t* nx = (uint64_t*)(uintptr_t)b[0];");
    wln(self, "        __p_heap* o = __P_OWNER(__P_CHUNK_OF(b));");
    wln(self, "        if (o == me) __p_heap_put(me, b, (int)(b[-1] & 0xFF));");
    wln(self, "        else __p_xfree_push(o, b);");
    wln(self, "        b = nx;");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "static void __p_heap_drain(__p_heap* h) { __p_heap_drain_into(h, h); }");
    // RT8: the rest of chunk c, too small for the block asked for, cut into
    // free blocks of the largest classes that fit, marked zero (fresh pages,
    // only their link word written) on heap h's zl lists, so p_malloc hands
    // them out without zeroing them. Not counted in fl_bytes, as
    // decommitted blocks are not: their pages are not resident, nothing to
    // give back (counted, they set off trims that change nothing)
    wln(self, "static void __p_chunk_carve(__p_heap* h, __p_arena_chunk* c) {");
    wln(self, "    for (int k = 40; k >= 8; k--) {");
    wln(self, "        int64_t sz = __p_cls_sz[k];");
    wln(self, "        while (c->end - c->ptr >= sz) {");
    wln(self, "            uint64_t* b = (uint64_t*)c->ptr + 1;");
    wln(self, "            c->ptr += sz;");
    wln(self, "            b[-1] = P_BLOCK_FREED | P_BLOCK_ZERO | (uint64_t)k;");
    wln(self, "            b[0] = (uint64_t)(uintptr_t)h->zl[k];");
    wln(self, "            h->zl[k] = b;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "}");
    // list a appended to list *to (a's last block found by walking it)
    wln(self, "static void __p_list_join(uint64_t** to, uint64_t* a) {");
    wln(self, "    if (!a) return;");
    wln(self, "    uint64_t* last = a;");
    wln(self, "    while (last[0]) last = (uint64_t*)(uintptr_t)last[0];");
    wln(self, "    last[0] = (uint64_t)(uintptr_t)*to;");
    wln(self, "    *to = a;");
    wln(self, "}");
    // What threads leave when they end, taken over by heap me (a trim): the
    // chunks of the pooled heaps that hold any become me's (owner set, put
    // in front of me's list: me's current chunk stays its last, so an arena
    // mark taken later still counts to it), their lists join me's, and what
    // other threads freed into them goes where it belongs. The emptied heaps
    // stay in the pool for new threads; the blocks other heaps there got late
    // are passed on too. Not a heap with an arena mark (its chunk indexes).
    wln(self, "static void __p_heap_merge_pool(__p_heap* me) {");
    wln(self, "    if (!__p_pool_full) return;");
    wln(self, "    __P_POOL_LOCK();");
    wln(self, "    __p_heap* got = NULL;");
    wln(self, "    __p_heap** pp = &__p_pool;");
    wln(self, "    while (*pp) {");
    wln(self, "        __p_heap* d = *pp;");
    wln(self, "        if (d->head && !d->arena_marked) { *pp = d->pool_next; d->pool_next = got; got = d; __p_pool_full--; }");
    wln(self, "        else pp = &d->pool_next;");
    wln(self, "    }");
    wln(self, "    __P_POOL_UNLOCK();");
    wln(self, "    __p_heap* back = got;");
    wln(self, "    while (got) {");
    wln(self, "        __p_heap* d = got;");
    wln(self, "        got = d->pool_next;");
    wln(self, "        if (d->cur) { __p_chunk_carve(d, d->cur); d->cur = NULL; }");
    wln(self, "        __p_arena_chunk* last = NULL;");
    wln(self, "        for (__p_arena_chunk* c = d->head; c; c = c->next) { __P_SET_OWNER(c, me); last = c; }");
    wln(self, "        last->next = me->head;");
    wln(self, "        me->head = d->head;");
    wln(self, "        d->head = NULL;");
    wln(self, "        for (int k = 0; k < 41; k++) {");
    wln(self, "            __p_list_join(&me->fl[k], d->fl[k]);");
    wln(self, "            d->fl[k] = NULL;");
    wln(self, "            __p_list_join(&me->zl[k], d->zl[k]);");
    wln(self, "            d->zl[k] = NULL;");
    wln(self, "        }");
    wln(self, "        me->fl_bytes += d->fl_bytes;");
    wln(self, "        d->fl_bytes = 0;");
    wln(self, "        d->trim_next = P_TRIM_MIN;");
    wln(self, "        d->dead = 0;");
    wln(self, "        __p_heap_drain_into(d, me);");
    wln(self, "    }");
    wln(self, "    __P_POOL_LOCK();");
    wln(self, "    while (back) {");
    wln(self, "        __p_heap* d = back;");
    wln(self, "        back = d->pool_next;");
    wln(self, "        d->pool_next = __p_pool;");
    wln(self, "        __p_pool = d;");
    wln(self, "    }");
    wln(self, "    for (__p_heap* d = __p_pool; d; d = d->pool_next) if (!d->head && __P_XFREE_ANY(d)) __p_heap_drain_into(d, me);");
    wln(self, "    __P_POOL_UNLOCK();");
    wln(self, "}");
    // The trim of heap h (keep: the empty chunks to keep; adopt: take over
    // the pool's heaps first; all: decommit every big free block, not only
    // the idle ones). What other threads freed into h first goes on its lists.
    wln(self, "static P_ALLOC_COLD void __p_heap_trim_keep(__p_heap* h, int64_t keep, int adopt, int all) {");
    // RT8: cached spans past their time (all of them at a thread's end)
    wln(self, "    if (h->span_n) __p_span_purge(h, __p_ms_now(), all);");
    wln(self, "    if (__p_mem_return < 0) { const char* e = getenv(\"FID_MEM_RETURN\"); __p_mem_return = (e && e[0] == '0' && e[1] == 0) ? 0 : 1; }");
    wln(self, "    if (!__p_mem_return || h->arena_marked || P_SAN_ALLOC) { h->trim_next = INT64_MAX; return; }");
    wln(self, "    if (adopt) __p_heap_merge_pool(h);");
    wln(self, "    __p_heap_drain(h);");
    // the free bytes of each chunk of h (every block on h's lists is in one
    // of h's chunks)
    wln(self, "    for (__p_arena_chunk* c = h->head; c; c = c->next) c->fb = 0;");
    wln(self, "    for (int k = 0; k < 41; k++) {");
    wln(self, "        int64_t sz = __p_cls_sz[k];");
    wln(self, "        for (uint64_t* b = h->fl[k]; b; b = (uint64_t*)(uintptr_t)b[0]) __P_CHUNK_OF(b)->fb += sz;");
    wln(self, "        for (uint64_t* b = h->zl[k]; b; b = (uint64_t*)(uintptr_t)b[0]) __P_CHUNK_OF(b)->fb += sz;");
    wln(self, "    }");
    // empty chunks (fb -1 from here: to unmap), but the current one and the
    // last `keep` empty ones
    wln(self, "    int64_t empty = 0;");
    wln(self, "    for (__p_arena_chunk* c = h->head; c; c = c->next) if (c != h->cur && c->fb == (int64_t)(c->ptr - c->base)) empty++;");
    wln(self, "    int64_t drop = empty - keep;");
    wln(self, "    for (__p_arena_chunk* c = h->head; c && drop > 0; c = c->next) {");
    wln(self, "        if (c != h->cur && c->fb == (int64_t)(c->ptr - c->base)) { c->fb = -1; drop--; }");
    wln(self, "    }");
    // off the lists: the blocks of the chunks to unmap; decommitted: the
    // inside of each other free block of P_DECOMMIT_MIN bytes or more
    wln(self, "    for (int k = 0; k < 41; k++) {");
    wln(self, "        int64_t sz = __p_cls_sz[k];");
    wln(self, "        uint64_t* prev = NULL;");
    wln(self, "        uint64_t* b = h->zl[k];");
    wln(self, "        while (b) {");
    wln(self, "            uint64_t* nx = (uint64_t*)(uintptr_t)b[0];");
    wln(self, "            if (__P_CHUNK_OF(b)->fb < 0) { if (prev) prev[0] = (uint64_t)(uintptr_t)nx; else h->zl[k] = nx; }");
    wln(self, "            else prev = b;");
    wln(self, "            b = nx;");
    wln(self, "        }");
    wln(self, "        prev = NULL;");
    wln(self, "        b = h->fl[k];");
    wln(self, "        while (b) {");
    wln(self, "            uint64_t* nx = (uint64_t*)(uintptr_t)b[0];");
    wln(self, "            if (__P_CHUNK_OF(b)->fb < 0) {");
    wln(self, "                if (prev) prev[0] = (uint64_t)(uintptr_t)nx; else h->fl[k] = nx;");
    wln(self, "                if (!(b[-1] & P_BLOCK_DECOMMITTED)) h->fl_bytes -= sz;");
    wln(self, "            } else {");
    // RT8: only a block already free at the previous trim (its stamp, b[1],
    // is read only while its pages are there)
    wln(self, "                if (sz >= P_DECOMMIT_MIN && !(b[-1] & P_BLOCK_DECOMMITTED) && (all || (int64_t)b[1] < h->trim_epoch)) {");
    wln(self, "                    char* lo = NULL; size_t len = 0;");
    wln(self, "                    if (__p_block_pages(b, sz, &lo, &len) && __p_os_decommit(lo, len)) { b[-1] |= P_BLOCK_DECOMMITTED; h->fl_bytes -= sz; }");
    wln(self, "                }");
    wln(self, "                prev = b;");
    wln(self, "            }");
    wln(self, "            b = nx;");
    wln(self, "        }");
    wln(self, "    }");
    // unmapped, out of the chunk list
    wln(self, "    __p_arena_chunk** cp = &h->head;");
    wln(self, "    while (*cp) {");
    wln(self, "        __p_arena_chunk* c = *cp;");
    wln(self, "        if (c->fb < 0) { *cp = c->next; __p_arena_free_chunk(c); } else cp = &c->next;");
    wln(self, "    }");
    wln(self, "    int64_t step = h->fl_bytes / 4;");
    wln(self, "    if (step < P_TRIM_MIN) step = P_TRIM_MIN;");
    wln(self, "    h->trim_next = h->fl_bytes + step;");
    wln(self, "    h->trim_epoch++;");
    wln(self, "}");
    wln(self, "static P_ALLOC_COLD void __p_heap_trim(__p_heap* h) { __p_heap_trim_keep(h, P_KEEP_FREE_CHUNKS, 1, 0); }");
    // Once, before the first allocation's heap: the TLS offset __P_HEAP()
    // reads at, the thread-end key, the memory limit's bit; then the fast
    // paths are open (P_ASLOW_INIT off)
    wln(self, "static void __p_heap_detach(int full);");
    wln(self, "#ifdef P_HEAP_KEY");
    wln(self, "static void __p_heap_key_done(void* v) { (void)v; __p_heap_detach(1); }");
    wln(self, "#endif");
    wln(self, "static P_ALLOC_COLD void __p_heap_init(void) {");
    wln(self, "    __P_POOL_LOCK();");
    wln(self, "    if (__P_ASLOW() & P_ASLOW_INIT) {");
    wln(self, "#if defined(P_HEAP_TP) && defined(_WIN32)");
    wln(self, "        DWORD slot = TlsAlloc();");
    wln(self, "        if (slot < 64) { __p_heap_slot = slot; __p_heap_tp = 0x1480 + 8 * (intptr_t)slot; }");
    wln(self, "        else { if (slot != TLS_OUT_OF_INDEXES) TlsFree(slot); __P_ASLOW_ADD(P_ASLOW_NOTP); }");
    wln(self, "#elif defined(P_HEAP_TP)");
    wln(self, "        __p_heap_tp = (intptr_t)((char*)&__p_tl_heap - __p_tp());");
    wln(self, "#endif");
    wln(self, "#ifdef P_HEAP_KEY");
    wln(self, "        pthread_key_create(&__p_heap_key, __p_heap_key_done);");
    wln(self, "#endif");
    wln(self, "        if (__p_lim_mem && !(__P_ASLOW() & P_ASLOW_LIM)) __P_ASLOW_ADD(P_ASLOW_LIM);");
    wln(self, "        __P_ASLOW_ADD(-P_ASLOW_INIT);");
    wln(self, "    }");
    wln(self, "    __P_POOL_UNLOCK();");
    wln(self, "}");
    // A heap for this thread, which has none: an ended thread's from the
    // pool (its chunks, free blocks and xfree with it), else a new one
    wln(self, "static P_ALLOC_COLD __p_heap* __p_heap_attach(void) {");
    wln(self, "    if (__P_ASLOW() & P_ASLOW_INIT) __p_heap_init();");
    wln(self, "    __P_POOL_LOCK();");
    wln(self, "    __p_heap* h = __p_pool;");
    wln(self, "    if (h) { __p_pool = h->pool_next; if (h->head) __p_pool_full--; }");
    wln(self, "    __P_POOL_UNLOCK();");
    wln(self, "    if (!h) {");
    wln(self, "        h = (__p_heap*)calloc(1, sizeof(__p_heap));");
    wln(self, "        if (!h) __p_oom(sizeof(__p_heap));");
    wln(self, "        h->trim_next = P_TRIM_MIN;");
    wln(self, "        h->trim_epoch = 1;");
    wln(self, "    }");
    wln(self, "    h->pool_next = NULL;");
    wln(self, "    h->dead = 0;");
    wln(self, "    __p_heap_set(h);");
    wln(self, "#ifdef P_HEAP_KEY");
    wln(self, "    pthread_setspecific(__p_heap_key, h);");
    wln(self, "#endif");
    wln(self, "    return h;");
    wln(self, "}");
    // A thread that ends (p_thread_wrapper, the key's destructor, the TLS
    // callback; once): its heap goes to the pool, where the next thread to
    // start takes it (or a trim its chunks); a block still in use elsewhere
    // comes back to it when that thread frees it. full: first what others
    // freed into the heap goes on its lists, the rest of its current chunk
    // too (zero blocks), and its empty chunks and cached spans go back to the
    // system (RT7). Not in the Windows TLS callback, which runs under the
    // loader lock (every thread start and end waits for it): there only the
    // heap is pooled, and the next thread or trim does the rest.
    wln(self, "static void __p_heap_detach(int full) {");
    wln(self, "#if !defined(__TINYC__)");
    wln(self, "    __p_heap* h = __p_tl_heap;");
    wln(self, "    if (!h) return;");
    wln(self, "    __p_heap_set(NULL);");
    wln(self, "#ifdef P_HEAP_KEY");
    wln(self, "    pthread_setspecific(__p_heap_key, NULL);");
    wln(self, "#endif");
    wln(self, "    if (full && !P_SAN_ALLOC) {");
    wln(self, "        __p_heap_drain(h);");
    wln(self, "        if (h->cur && !h->arena_marked) { __p_chunk_carve(h, h->cur); h->cur = NULL; }");
    wln(self, "        __p_heap_trim_keep(h, 0, 0, 1);");
    wln(self, "    }");
    wln(self, "    h->dead = 1;");
    wln(self, "    __P_POOL_LOCK();");
    wln(self, "    h->pool_next = __p_pool;");
    wln(self, "    __p_pool = h;");
    wln(self, "    if (h->head) __p_pool_full++;");
    wln(self, "    __P_POOL_UNLOCK();");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static void __p_mem_thread_exit(void) { __p_heap_detach(1); }");
    wln(self, "#if defined(_WIN32) && !defined(__TINYC__)");
    wln(self, "static void NTAPI __p_heap_tls_cb(PVOID m, DWORD reason, PVOID r) { (void)m; (void)r; if (reason == DLL_THREAD_DETACH) __p_heap_detach(0); }");
    wln(self, "#if defined(_MSC_VER)");
    wln(self, "#pragma comment(linker, \"/INCLUDE:_tls_used\")");
    wln(self, "#pragma comment(linker, \"/INCLUDE:__p_heap_tls_cbp\")");
    wln(self, "#pragma section(\".CRT$XLB\", long, read)");
    wln(self, "__declspec(allocate(\".CRT$XLB\")) PIMAGE_TLS_CALLBACK __p_heap_tls_cbp = __p_heap_tls_cb;");
    wln(self, "#else");
    wln(self, "PIMAGE_TLS_CALLBACK __p_heap_tls_cbp __attribute__((section(\".CRT$XLB\"), used)) = __p_heap_tls_cb;");
    wln(self, "#endif");
    wln(self, "#endif");
    // RT8 x RT10: a worker that has nothing to run (it never ends): what
    // other workers freed into its heap goes on its lists (a trim when they
    // pass its threshold), its cached spans past their time back
    wln(self, "static void __p_heap_idle(void) {");
    wln(self, "    __p_heap* h = __p_tl_heap;");
    wln(self, "    if (!h) return;");
    wln(self, "    if (h->span_n) __p_span_purge(h, __p_ms_now(), 0);");
    wln(self, "    if (__P_XFREE_ANY(h)) {");
    wln(self, "        __p_heap_drain(h);");
    wln(self, "        if (h->fl_bytes > h->trim_next) __p_heap_trim(h);");
    wln(self, "    }");
    wln(self, "}");
}

/// RT8: the C runtime's block allocator: __p_zero / __p_zero_big, the size
/// classes, p_malloc and p_malloc_uninit (an inline path for a small block
/// from the head of this thread's free list, the class by table;
/// __p_malloc_slow for the rest) and p_free (inline for a small block of
/// this thread's heap, the owner's xfree for another's; __p_free_full for
/// the rest). Emitted after emit_mem_return_runtime (the heaps, the trim,
/// the span cache) and the embed log's renaming of p_malloc, whose text it
/// carries in the middle.
fn emit_block_alloc_runtime(self: &mut CCodeGen) {
    // n bytes at p (16-aligned; n a multiple of 16, at least 64) zeroed with
    // non-temporal stores (memset where there are none)
    wln(self, "#if (defined(__x86_64__) || defined(_M_X64)) && !defined(__TINYC__)");
    wln(self, "#include <emmintrin.h>");
    wln(self, "#define P_ZERO_NT 1");
    wln(self, "#else");
    wln(self, "#define P_ZERO_NT 0");
    wln(self, "#endif");
    wln(self, "static void __p_zero_big(void* p, size_t n) {");
    wln(self, "#if P_ZERO_NT");
    wln(self, "    char* a = (char*)p;");
    wln(self, "    char* e = a + n;");
    wln(self, "    __m128i z = _mm_setzero_si128();");
    wln(self, "    for (; a + 64 <= e; a += 64) {");
    wln(self, "        _mm_stream_si128((__m128i*)a, z);");
    wln(self, "        _mm_stream_si128((__m128i*)(a + 16), z);");
    wln(self, "        _mm_stream_si128((__m128i*)(a + 32), z);");
    wln(self, "        _mm_stream_si128((__m128i*)(a + 48), z);");
    wln(self, "    }");
    wln(self, "    _mm_sfence();");
    wln(self, "    for (; a < e; a += 16) _mm_store_si128((__m128i*)a, z);");
    wln(self, "#else");
    wln(self, "    memset(p, 0, n);");
    wln(self, "#endif");
    wln(self, "}");
    // (static inline in so many words: csplit copies an inline function into
    // every unit, any other it gives to one)
    wln(self, "static inline P_ZERO_ALWAYS void __p_zero(void* p, size_t n, int cold) {");
    wln(self, "    char* d = (char*)p;");
    wln(self, "    if (n <= 16) { if (n >= 8) { memset(d, 0, 8); memset(d + n - 8, 0, 8); } else if (n) memset(d, 0, n); return; }");
    wln(self, "    if (n <= 32) { memset(d, 0, 16); memset(d + n - 16, 0, 16); return; }");
    wln(self, "    if (n <= 64) { memset(d, 0, 32); memset(d + n - 32, 0, 32); return; }");
    wln(self, "    if (n <= 128) { memset(d, 0, 64); memset(d + n - 64, 0, 64); return; }");
    wln(self, "    if (n <= 256) { memset(d, 0, 128); memset(d + n - 128, 0, 128); return; }");
    // (a class block's payload is 8 bytes past a 16-byte boundary: the first
    // 8 bytes are stored on their own)
    wln(self, "    if (cold && P_ZERO_NT) {");
    wln(self, "        size_t lead = (size_t)(-(uintptr_t)d & 15);");
    wln(self, "        if (lead) { memset(d, 0, 8); memset(d + lead - 8, 0, 8); }");
    wln(self, "        size_t body = (n - lead) & ~(size_t)15;");
    wln(self, "        __p_zero_big(d + lead, body);");
    wln(self, "        if (lead + body < n) memset(d + n - 8, 0, 8);");
    wln(self, "        return;");
    wln(self, "    }");
    wln(self, "#if defined(__x86_64__) && (defined(__GNUC__) || defined(__clang__)) && !defined(__TINYC__)");
    wln(self, "    __asm__ volatile(\"rep stosb\" : \"+D\"(d), \"+c\"(n) : \"a\"(0) : \"memory\");");
    wln(self, "#else");
    wln(self, "    memset(d, 0, n);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__TINYC__)");
    wln(self, "#define P_OPAQUE(x) __asm__(\"\" : \"+r\"(x))");
    wln(self, "#else");
    wln(self, "#define P_OPAQUE(x) ((void)0)");
    wln(self, "#endif");
    // RT8: the bytes asked for of a small block (n 0 or at least 8 and a
    // multiple of 8, at most 1 KB): stores of a constant size only, no `rep
    // stosb` nor memset call (their registers would make every p_malloc save
    // and restore three)
    wln(self, "static inline P_ZERO_ALWAYS void __p_zero_small(void* p, size_t n) {");
    wln(self, "    char* d = (char*)p;");
    wln(self, "    if (n <= 16) { if (n) { memset(d, 0, 8); memset(d + n - 8, 0, 8); } return; }");
    wln(self, "    if (n <= 32) { memset(d, 0, 16); memset(d + n - 16, 0, 16); return; }");
    wln(self, "    if (n <= 64) { memset(d, 0, 32); memset(d + n - 32, 0, 32); return; }");
    wln(self, "    if (n <= 128) { memset(d, 0, 64); memset(d + n - 64, 0, 64); return; }");
    wln(self, "    if (n <= 256) { memset(d, 0, 128); memset(d + n - 128, 0, 128); return; }");
    // (the step opaque to the compiler, which would make the loop a memset
    // call)
    wln(self, "    for (size_t i = 0; i + 64 < n; i += 64) { memset(d + i, 0, 64); P_OPAQUE(i); }");
    wln(self, "    memset(d + n - 64, 0, 64);");
    wln(self, "}");
    // RT8: n bytes at p zeroed with p_malloc's stores (rep stosb on x86-64,
    // not the C library's memset call): __p_vec_grow's spare capacity past
    // the elements it copied into a p_malloc_uninit buffer
    wln(self, "void __p_zero_tail(void* p, size_t n) {");
    wln(self, "    if (n < 8) { if (n) memset(p, 0, n); return; }");
    wln(self, "    __p_zero(p, n, 0);");
    wln(self, "}");
    // RT8: the size class of a block of `total` bytes (header included,
    // total in 8..1 MB): k (the list index) and sz (its bytes). The power of
    // two at or above total in one instruction; 3/4 of it when that is enough
    // (k odd).
    wln(self, "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__TINYC__)");
    wln(self, "#define __P_CLASS_POW(total) ((total) <= 16 ? 4 : 64 - __builtin_clzll((unsigned long long)((total) - 1)))");
    wln(self, "#else");
    wln(self, "static inline int __p_class_pow(size_t total) { int k = 4; while (((size_t)1 << k) < total) k++; return k; }");
    wln(self, "#define __P_CLASS_POW(total) __p_class_pow(total)");
    wln(self, "#endif");
    wln(self, "#define __P_CLASS(total, k, sz) do { k = __P_CLASS_POW(total); sz = (size_t)1 << k; k *= 2; if (k > 8 && (total) <= sz - sz / 4) { sz -= sz / 4; k--; } } while (0)");
    // RT8: the class of a small block by table (p_malloc's inline path):
    // __p_cls_small[(size + 7) >> 3] is __P_CLASS's k for size + 8, size up
    // to P_SMALL_MAX (a class of 1 KB at most: no stamps, never decommitted,
    // zeroed with stores of a constant size)
    wln(self, "#define P_SMALL_MAX 1016");
    wln(self, "static const uint8_t __p_cls_small[128] = { 8, 8, 9, 10, 11, 11, 12, 12, 13, 13, 13, 13, 14, 14, 14, 14, 15, 15, 15, 15, 15, 15, 15, 15, 16, 16, 16, 16, 16, 16, 16, 16, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20 };");
    // A large block (over 1 MB, or every block under AddressSanitizer) for
    // heap h: [span][traffic][0][header] then the payload, pages of its own
    // (RT7), or a span of h's cache (RT8) zeroed in place (the bytes asked
    // for: nothing reads past them, as for class blocks; zero 0: not zeroed,
    // p_malloc_uninit); calloc's without the OS's pages or under the
    // sanitizer (S1: 16 bytes of room before the header, so the string and
    // Vec buffer headers read at s - 16 / s - 24 stay inside the block)
    wln(self, "static P_ALLOC_COLD void* __p_malloc_big(__p_heap* h, int64_t size, int zero) {");
    wln(self, "    size_t total = (size_t)size + 8;");
    wln(self, "    if (__p_lim_mem) __p_lim_take((int64_t)total);");
    wln(self, "    if (!P_SAN_ALLOC && P_OSMEM) {");
    wln(self, "        size_t pg = __p_os_page();");
    wln(self, "        size_t span = (total + 24 + pg - 1) / pg * pg;");
    wln(self, "        __p_span_note_alloc(h, __p_ms_now());");
    wln(self, "        uint64_t* m = h->span_n ? __p_span_take(h, span) : NULL;");
    wln(self, "        if (m) {");
    wln(self, "            span = (size_t)m[0];");
    wln(self, "            int cold = h->traffic - m[1] > P_ZERO_HOT;");
    wln(self, "            m[1] = 0;");
    wln(self, "            m[2] = 0;");
    wln(self, "            if (zero) __p_zero(m + 4, ((size_t)size + 15) & ~(size_t)15, cold);");
    wln(self, "        } else {");
    wln(self, "            m = (uint64_t*)__p_os_map(span);");
    wln(self, "            if (!m) __p_oom(total);");
    wln(self, "            m[0] = (uint64_t)span;");
    wln(self, "        }");
    wln(self, "        if (__p_lim_mem) __P_LIM_ADD((int64_t)span - (int64_t)total);");
    wln(self, "        h->traffic += span;");
    wln(self, "        m[3] = P_BLOCK_MAGIC | P_CLASS_MAPPED;");
    wln(self, "        return m + 4;");
    wln(self, "    }");
    wln(self, "    uint64_t* big = (uint64_t*)calloc(1, total + 16);");
    wln(self, "    if (!big) __p_oom(total);");
    wln(self, "    if (__p_lim_mem) __P_LIM_ADD(__P_LIM_BIG(big) - (int64_t)total);");
    wln(self, "    big += 2;");
    wln(self, "    big[0] = P_BLOCK_MAGIC | P_CLASS_LARGE;");
    wln(self, "    return big + 1;");
    wln(self, "}");
    // The rest of the allocator: every case p_malloc's inline path leaves to
    // it (a negative size, the first allocation, a region, the memory limit,
    // AddressSanitizer, blocks over P_SMALL_MAX, a thread with no heap yet,
    // an empty free list: what other threads freed into the heap, the zero
    // blocks, the current chunk, a new chunk). zero 0: p_malloc_uninit (a
    // region's or a decommitted block reads zero all the same). Out of line,
    // so the inline path saves no registers; it reads this thread's state
    // directly (one call runs on one thread).
    wln(self, "static P_ALLOC_OUT void* __p_malloc_slow(int64_t size, int zero) {");
    wln(self, "    if (size < 0) { fprintf(stderr, \"p_malloc: negative size %lld\\n\", (long long)size); abort(); }");
    wln(self, "    if (P_UNLIKELY(__P_ASLOW() & P_ASLOW_INIT)) __p_heap_init();");
    wln(self, "    if (__P_ASLOW() >= P_ASLOW_RG && __p_rs.mode) return __p_rg_alloc(size);");
    wln(self, "    __p_heap* h = __p_tl_heap;");
    wln(self, "    if (P_UNLIKELY(!h)) h = __p_heap_attach();");
    wln(self, "    size_t total = (size_t)size + 8;");
    wln(self, "    if (P_SAN_ALLOC || total > ((size_t)1 << 20)) return __p_malloc_big(h, size, zero);");
    wln(self, "    int k;");
    wln(self, "    size_t sz;");
    wln(self, "    __P_CLASS(total, k, sz);");
    wln(self, "    if (__p_lim_mem) __p_lim_take((int64_t)sz);");
    wln(self, "    h->traffic += sz;");
    wln(self, "    uint64_t* b = h->fl[k];");
    // owner return: the blocks other threads freed into this heap, before
    // any other memory
    wln(self, "    if (!b && __P_XFREE_ANY(h)) { __p_heap_drain(h); b = h->fl[k]; }");
    wln(self, "    if (b) {");
    wln(self, "        h->fl[k] = (uint64_t*)(uintptr_t)b[0];");
    // RT7: a block whose pages went back to the system gets them again
    // (zeroed: its decommitted pages read as zero already)
    wln(self, "        if (b[-1] & P_BLOCK_DECOMMITTED) __p_block_recommit(b, (int64_t)sz);");
    wln(self, "        else {");
    wln(self, "            h->fl_bytes -= (int64_t)sz;");
    // RT8: only the bytes asked for (to 16) are zeroed, not the whole
    // class: nothing reads a block past its size (P_ZERO_FULL: the class)
    wln(self, "#ifdef P_ZERO_FULL");
    wln(self, "            if (zero) memset(b, 0, sz - 8);");
    wln(self, "#else");
    wln(self, "            if (zero) { size_t zn = ((size_t)size + 15) & ~(size_t)15; if (zn > sz - 8) zn = sz - 8; __p_zero(b, zn, zn >= P_ZERO_NT_MIN && h->traffic - sz - b[2] > P_ZERO_HOT); }");
    wln(self, "#endif");
    wln(self, "        }");
    wln(self, "        b[-1] = P_BLOCK_MAGIC | (uint64_t)k;");
    wln(self, "        return b;");
    wln(self, "    }");
    // RT8: a block cut from a chunk's fresh pages is zero but its link word
    wln(self, "    b = h->zl[k];");
    wln(self, "    if (b) {");
    wln(self, "        h->zl[k] = (uint64_t*)(uintptr_t)b[0];");
    wln(self, "        b[0] = 0;");
    wln(self, "        b[-1] = P_BLOCK_MAGIC | (uint64_t)k;");
    wln(self, "        return b;");
    wln(self, "    }");
    wln(self, "    __p_arena_chunk* c = h->cur;");
    wln(self, "    if (!c || c->ptr + sz > c->end) {");
    // the rest of the full chunk cut into zero blocks, one of them maybe this
    // one's
    wln(self, "        if (c) {");
    wln(self, "            __p_chunk_carve(h, c);");
    wln(self, "            b = h->zl[k];");
    wln(self, "            if (b) {");
    wln(self, "                h->zl[k] = (uint64_t*)(uintptr_t)b[0];");
    wln(self, "                b[0] = 0;");
    wln(self, "                b[-1] = P_BLOCK_MAGIC | (uint64_t)k;");
    wln(self, "                return b;");
    wln(self, "            }");
    wln(self, "        }");
    wln(self, "        __p_arena_chunk* nc = __p_arena_new_chunk(h);");
    wln(self, "        if (!nc) __p_oom(sz);");
    // (the current chunk is the list's last: after chunks taken over from
    // ended threads, RT7)
    wln(self, "        if (c) c->next = nc;");
    wln(self, "        else if (!h->head) h->head = nc;");
    wln(self, "        else { __p_arena_chunk* t = h->head; while (t->next) t = t->next; t->next = nc; }");
    wln(self, "        h->cur = c = nc;");
    wln(self, "    }");
    wln(self, "    b = (uint64_t*)c->ptr;");
    wln(self, "    c->ptr += sz;");
    wln(self, "    b[0] = P_BLOCK_MAGIC | (uint64_t)k;");
    wln(self, "    return b + 1;");
    wln(self, "}");
    // RT8: p_malloc's whole path for a small block: a class by table, the
    // head of this thread's free list of the class, zeroed in the bytes asked
    // for (zero 1; a constant at each use, so its test folds), its header;
    // anything else is __p_malloc_slow's. Inline into the callers in the same
    // unit (RT10 x RT8: the heap through __P_HEAP(), the slow paths' bits in
    // one word read by every call: nothing cached across a task switch).
    wln(self, "static inline P_ZERO_ALWAYS void* __p_malloc_inl(int64_t size, int zero) {");
    wln(self, "    if (P_UNLIKELY((uint64_t)size > P_SMALL_MAX || __P_ASLOW())) return __p_malloc_slow(size, zero);");
    wln(self, "    __p_heap* h = __P_HEAP();");
    wln(self, "    if (P_UNLIKELY(!h)) return __p_malloc_slow(size, zero);");
    wln(self, "    unsigned k = __p_cls_small[((uint64_t)size + 7) >> 3];");
    wln(self, "    uint64_t* b = h->fl[k];");
    wln(self, "    if (P_UNLIKELY(!b)) return __p_malloc_slow(size, zero);");
    wln(self, "    int64_t sz = __p_cls_sz[k];");
    wln(self, "    h->fl[k] = (uint64_t*)(uintptr_t)b[0];");
    wln(self, "    h->fl_bytes -= sz;");
    wln(self, "    h->traffic += (uint64_t)sz;");
    wln(self, "    if (zero) {");
    wln(self, "#ifdef P_ZERO_FULL");
    wln(self, "        memset(b, 0, (size_t)sz - 8);");
    wln(self, "#else");
    wln(self, "        size_t zn = ((size_t)size + 15) & ~(size_t)15;");
    wln(self, "        if (zn > (size_t)sz - 8) zn = (size_t)sz - 8;");
    wln(self, "        __p_zero_small(b, zn);");
    wln(self, "#endif");
    wln(self, "    }");
    wln(self, "    b[-1] = P_BLOCK_MAGIC | (uint64_t)k;");
    wln(self, "    return b;");
    wln(self, "}");
    // RT8 owner return: a class block freed on a thread whose heap (h) does
    // not own its chunk goes on the owner's xfree (marked freed here, so a
    // second free of it panics), never on this thread's lists; into the heap
    // of an ended thread, it counts toward a trim of this one (pool_freed:
    // past P_TRIM_MIN this thread trims, and so takes the pooled heaps over, as
    // its own frees would set it off; RT7: an ended thread's memory comes back
    // even when no thread starts after it)
    wln(self, "static P_ALLOC_COLD void __p_free_remote(uint64_t* b, uint64_t k, __p_heap* o, __p_heap* h) {");
    wln(self, "    b[-1] = P_BLOCK_FREED | k;");
    wln(self, "    __p_xfree_push(o, b);");
    wln(self, "    if (h && o->dead && (h->pool_freed += __p_cls_sz[k]) > P_TRIM_MIN) { h->pool_freed = 0; __p_heap_trim(h); }");
    wln(self, "}");
    // a live class block b of class k: back to its owner (this thread's
    // lists, stamped, a trim past the threshold; or the owner's xfree)
    wln(self, "static P_ALLOC_OUT void __p_free_class(uint64_t* b, uint64_t k) {");
    wln(self, "    __p_heap* o = __P_OWNER(__P_CHUNK_OF(b));");
    wln(self, "    __p_heap* h = __p_tl_heap;");
    wln(self, "    if (o != h) { __p_free_remote(b, k, o, h); return; }");
    wln(self, "    b[-1] = P_BLOCK_FREED | k;");
    wln(self, "    __p_heap_put(h, b, (int)k);");
    // RT7: past the threshold, empty chunks go back to the system
    wln(self, "    if (h->fl_bytes > h->trim_next) __p_heap_trim(h);");
    wln(self, "}");
    // p_free's every case but a live small class block's: a region's block,
    // a double or invalid free, large blocks, the classes of 16 KB and more
    // (they are stamped), the memory limit
    wln(self, "static P_ALLOC_OUT void __p_free_full(uint64_t* b, uint64_t h) {");
    // a region's block: its region's end releases it (proposal 0005)
    wln(self, "    if (P_IS_ARENA_HDR(h)) return;");
    wln(self, "    if ((h & ~(uint64_t)0xFF) == P_BLOCK_FREED) p_panic(\"Double free\");");
    wln(self, "    if ((h & ~(uint64_t)0xFF) != P_BLOCK_MAGIC) p_panic(\"Invalid free: not an allocated block\");");
    wln(self, "    int k = (int)(h & 0xFF);");
    wln(self, "    if (k == P_CLASS_LARGE) { b[-1] = P_BLOCK_FREED | (uint64_t)k; if (__p_lim_mem) __P_LIM_ADD(-__P_LIM_BIG(b - 3)); free(b - 3); return; }");
    // RT8: into the span cache, or unmapped
    wln(self, "    if (k == P_CLASS_MAPPED) { b[-1] = P_BLOCK_FREED | (uint64_t)k; if (__p_lim_mem) __P_LIM_ADD(-(int64_t)b[-4]); __p_span_free(__p_tl_heap, b - 4); return; }");
    wln(self, "    if (k > 40) p_panic(\"Invalid free: not an allocated block\");");
    wln(self, "    if (__p_lim_mem) __P_LIM_ADD(-__p_lim_class_bytes(k));");
    wln(self, "    __p_free_class(b, (uint64_t)k);");
    wln(self, "}");
    // Under the debug allocator the block allocator below is renamed; the
    // p_malloc/p_free after it record each block.
    wln(self, "#if defined(P_LEAKS) || defined(P_CHECKED_ALLOC) || defined(P_MEMPROF)");
    wln(self, "#define P_MEMCHECK 1");
    wln(self, "#define p_malloc __p_block_malloc");
    wln(self, "#define p_free __p_block_free");
    wln(self, "static void* __p_block_malloc(int64_t size);");
    wln(self, "static void __p_block_free(void* ptr);");
    wln(self, "static");
    wln(self, "#endif");
    emit_embed_log_runtime(self);
    // RT8: p_malloc is __p_malloc_inl (zeroed); RT10's P_MN_NOINLINE is gone
    // from it and p_free: they read the heap fresh at each call (__P_HEAP)
    wln(self, "void* p_malloc(int64_t size) { return __p_malloc_inl(size, 1); }");
    // RT8: __p_malloc_uninit, what core's p_malloc_uninit runs here
    // (fast_core_vec_body), for core and the runtimes only (the type checker
    // allows no other caller): a block exactly like p_malloc's (freed by
    // p_free, the same limit, region and debug treatment) whose bytes are
    // unspecified, for producers that write every byte they hand out. Under
    // the debug allocator and the embed log it is the recording p_malloc
    // (below them).
    wln(self, "#if !defined(P_MEMCHECK) && !defined(P_EMBED_LOG)");
    wln(self, "void* __p_malloc_uninit(int64_t size) { return __p_malloc_inl(size, 0); }");
    wln(self, "#endif");
    wln(self, "void* p_malloc_persistent(int64_t size) { if (size < 0) return NULL; return malloc((size_t)size); }");
    wln(self, "#ifdef P_MEMCHECK");
    wln(self, "static");
    wln(self, "#endif");
    wln(self, "void p_free(void* ptr) {");
    wln(self, "    if (!ptr) return;");
    // CI6: a block a fides_call allocated and frees is no longer its own
    wln(self, "#ifdef P_EMBED_LOG");
    wln(self, "    if (__p_el_used) __p_el_forget(ptr);");
    wln(self, "#endif");
    wln(self, "    uint64_t* b = (uint64_t*)ptr;");
    wln(self, "    uint64_t h = b[-1];");
    // RT8: a live class block's header is P_BLOCK_MAGIC | k; up to class 27
    // (12 KB) here, the bigger ones are stamped (__p_free_full, as freed,
    // a region's, large and invalid ones, and all under the memory limit)
    wln(self, "    uint64_t k = h ^ P_BLOCK_MAGIC;");
    wln(self, "    if (P_UNLIKELY(k > 27 || (__P_ASLOW() & (P_ASLOW_LIM | P_ASLOW_NOTP)))) { __p_free_full(b, h); return; }");
    // owner return (RT8): a block of a chunk another heap owns goes back to it
    wln(self, "    __p_heap* hp = __P_HEAP();");
    wln(self, "    __p_heap* o = __P_OWNER(__P_CHUNK_OF(b));");
    wln(self, "    if (P_UNLIKELY(o != hp)) { __p_free_remote(b, k, o, hp); return; }");
    wln(self, "    b[-1] = P_BLOCK_FREED | k;");
    wln(self, "    b[0] = (uint64_t)(uintptr_t)hp->fl[k];");
    wln(self, "    hp->fl[k] = b;");
    wln(self, "    hp->fl_bytes += __p_cls_sz[k];");
    // RT7: past the threshold, empty chunks go back to the system
    wln(self, "    if (P_UNLIKELY(hp->fl_bytes > hp->trim_next)) __p_heap_trim(hp);");
    wln(self, "}");
}

/// CI6: the blocks a fides_call allocated (P_EMBED_LOG: a --lib build
/// without the debug allocator). Each block p_malloc returns inside a call
/// (__p_el_id, the call's number: calls on a thread are numbered as they
/// start) is recorded in this thread's table until p_free frees it. A
/// panic in call N frees the blocks still recorded for N and the calls
/// after it, which are the calls inside it (fides_call P_EL_PANIC); the
/// outermost call's return keeps them and forgets them: they are the
/// host's (a returned string) or the program's (P_EL_DONE). Emitted before
/// the block allocator, which it renames to __p_el_block_malloc; the
/// recording p_malloc follows the block allocator.
fn emit_embed_log_runtime(self: &mut CCodeGen) {
    wln(self, "#ifdef P_EMBED_LOG");
    wln(self, "typedef struct { void* p; uint64_t call; } __p_el_rec;");
    wln(self, "static P_THREAD_LOCAL __p_el_rec* __p_el_tab = NULL;");
    wln(self, "static P_THREAD_LOCAL uint64_t __p_el_cap = 0;");
    wln(self, "static P_THREAD_LOCAL uint64_t __p_el_used = 0;");
    wln(self, "P_THREAD_LOCAL uint64_t __p_el_id = 0;");
    wln(self, "P_THREAD_LOCAL uint64_t __p_el_next = 0;");
    wln(self, "static inline uint64_t __p_el_hash(void* p) {");
    wln(self, "    uint64_t x = (uint64_t)(uintptr_t)p;");
    wln(self, "    x ^= x >> 33; x *= 0xff51afd7ed558ccdULL; x ^= x >> 33;");
    wln(self, "    return x;");
    wln(self, "}");
    // open addressing; a table that cannot grow records nothing more (a
    // panic then leaves those blocks allocated, as before CI6)
    wln(self, "static void __p_el_put(void* p, uint64_t call) {");
    wln(self, "    if ((__p_el_used + 1) * 2 > __p_el_cap) {");
    wln(self, "        uint64_t nc = __p_el_cap ? __p_el_cap * 2 : 1024;");
    wln(self, "        __p_el_rec* nt = (__p_el_rec*)calloc((size_t)nc, sizeof(__p_el_rec));");
    wln(self, "        if (!nt) return;");
    wln(self, "        for (uint64_t i = 0; i < __p_el_cap; i++) {");
    wln(self, "            if (!__p_el_tab[i].p) continue;");
    wln(self, "            uint64_t j = __p_el_hash(__p_el_tab[i].p) & (nc - 1);");
    wln(self, "            while (nt[j].p) j = (j + 1) & (nc - 1);");
    wln(self, "            nt[j] = __p_el_tab[i];");
    wln(self, "        }");
    wln(self, "        free(__p_el_tab);");
    wln(self, "        __p_el_tab = nt;");
    wln(self, "        __p_el_cap = nc;");
    wln(self, "    }");
    wln(self, "    uint64_t m = __p_el_cap - 1, i = __p_el_hash(p) & m;");
    wln(self, "    while (__p_el_tab[i].p) {");
    wln(self, "        if (__p_el_tab[i].p == p) { __p_el_tab[i].call = call; return; }");
    wln(self, "        i = (i + 1) & m;");
    wln(self, "    }");
    wln(self, "    __p_el_tab[i].p = p;");
    wln(self, "    __p_el_tab[i].call = call;");
    wln(self, "    __p_el_used++;");
    wln(self, "}");
    // linear probing: deleting shifts the entries after it back into place
    wln(self, "static void __p_el_del_at(uint64_t i) {");
    wln(self, "    uint64_t m = __p_el_cap - 1, j = i;");
    wln(self, "    for (;;) {");
    wln(self, "        j = (j + 1) & m;");
    wln(self, "        if (!__p_el_tab[j].p) break;");
    wln(self, "        uint64_t k = __p_el_hash(__p_el_tab[j].p) & m;");
    wln(self, "        if ((j > i && (k <= i || k > j)) || (j < i && k <= i && k > j)) { __p_el_tab[i] = __p_el_tab[j]; i = j; }");
    wln(self, "    }");
    wln(self, "    __p_el_tab[i].p = NULL;");
    wln(self, "    __p_el_tab[i].call = 0;");
    wln(self, "    __p_el_used--;");
    wln(self, "}");
    wln(self, "static void __p_el_forget(void* p) {");
    wln(self, "    uint64_t m = __p_el_cap - 1, i = __p_el_hash(p) & m;");
    wln(self, "    while (__p_el_tab[i].p) {");
    wln(self, "        if (__p_el_tab[i].p == p) { __p_el_del_at(i); return; }");
    wln(self, "        i = (i + 1) & m;");
    wln(self, "    }");
    wln(self, "}");
    // forget the records of call `from` and the calls after it; with
    // `release`, free their blocks too (after the table is consistent:
    // p_free looks the block up in it)
    wln(self, "void __p_el_end(uint64_t from, int release) {");
    wln(self, "    if (!__p_el_used) return;");
    wln(self, "    void** dead = release ? (void**)malloc((size_t)__p_el_used * sizeof(void*)) : NULL;");
    wln(self, "    uint64_t nd = 0;");
    wln(self, "    for (uint64_t i = 0; i < __p_el_cap; i++) {");
    // a deletion moves a later entry into slot i: look at it again
    wln(self, "        while (__p_el_tab[i].p && __p_el_tab[i].call >= from) {");
    wln(self, "            if (dead) dead[nd++] = __p_el_tab[i].p;");
    wln(self, "            __p_el_del_at(i);");
    wln(self, "        }");
    wln(self, "    }");
    // only a block still allocated (another thread may have freed one the
    // call handed it: its table, not this one, saw that free)
    wln(self, "    for (uint64_t k = 0; k < nd; k++) {");
    wln(self, "        uint64_t h = ((uint64_t*)dead[k])[-1];");
    wln(self, "        if ((h & ~(uint64_t)0xFF) == P_BLOCK_MAGIC) p_free(dead[k]);");
    wln(self, "    }");
    wln(self, "    free(dead);");
    wln(self, "}");
    wln(self, "#define p_malloc __p_el_block_malloc");
    wln(self, "static void* __p_el_block_malloc(int64_t size);");
    wln(self, "static");
    wln(self, "#endif");
}

/// RT7: p_mem_resident() is the bytes of the process in physical memory
/// now (Windows: the working set, K32GetProcessMemoryInfo found at run
/// time; Linux: /proc/self/statm; macOS: task_info), -1 where it is not
/// known. tests/bootstrap/test_mem_return.fd watches it drop after a free.
fn emit_mem_resident_runtime(self: &mut CCodeGen) {
    wln(self, "#if defined(__APPLE__) && !defined(P_NO_MACH)");
    // mach/mach.h declares panic(...); a program may define a function of
    // that name, so the header's declaration is renamed out of the way for
    // the include and its name given back
    wln(self, "#define panic __p_apple_mach_panic");
    wln(self, "#include <mach/mach.h>");
    wln(self, "#undef panic");
    wln(self, "#endif");
    wln(self, "int64_t p_mem_resident(void) {");
    wln(self, "#if defined(_WIN32)");
    wln(self, "    typedef struct { DWORD cb; DWORD faults; SIZE_T peak_ws; SIZE_T ws; SIZE_T qpp, qp, qpnp, qnp, pf, ppf; } __p_pmc_t;");
    wln(self, "    typedef BOOL (WINAPI *__p_gpmi_fn)(HANDLE, void*, DWORD);");
    wln(self, "    static __p_gpmi_fn gpmi = NULL;");
    wln(self, "    static int looked = 0;");
    wln(self, "    if (!looked) {");
    wln(self, "        HMODULE k = GetModuleHandleA(\"kernel32.dll\");");
    wln(self, "        if (k) gpmi = (__p_gpmi_fn)(void*)GetProcAddress(k, \"K32GetProcessMemoryInfo\");");
    wln(self, "        if (!gpmi) { HMODULE ps = LoadLibraryA(\"psapi.dll\"); if (ps) gpmi = (__p_gpmi_fn)(void*)GetProcAddress(ps, \"GetProcessMemoryInfo\"); }");
    wln(self, "        looked = 1;");
    wln(self, "    }");
    wln(self, "    if (!gpmi) return -1;");
    wln(self, "    __p_pmc_t c;");
    wln(self, "    memset(&c, 0, sizeof c);");
    wln(self, "    c.cb = (DWORD)sizeof c;");
    wln(self, "    if (!gpmi(GetCurrentProcess(), &c, c.cb)) return -1;");
    wln(self, "    return (int64_t)c.ws;");
    wln(self, "#elif defined(__linux__)");
    wln(self, "    FILE* f = fopen(\"/proc/self/statm\", \"r\");");
    wln(self, "    if (!f) return -1;");
    wln(self, "    long long size = 0, res = 0;");
    wln(self, "    int got = fscanf(f, \"%lld %lld\", &size, &res);");
    wln(self, "    fclose(f);");
    wln(self, "    if (got != 2) return -1;");
    wln(self, "    long pg = sysconf(_SC_PAGESIZE);");
    wln(self, "    return (int64_t)res * (int64_t)(pg > 0 ? pg : 4096);");
    wln(self, "#elif defined(__APPLE__) && !defined(P_NO_MACH)");
    wln(self, "    struct mach_task_basic_info info;");
    wln(self, "    mach_msg_type_number_t cnt = MACH_TASK_BASIC_INFO_COUNT;");
    wln(self, "    if (task_info(mach_task_self(), MACH_TASK_BASIC_INFO, (task_info_t)&info, &cnt) != KERN_SUCCESS) return -1;");
    wln(self, "    return (int64_t)info.resident_size;");
    wln(self, "#else");
    wln(self, "    return -1;");
    wln(self, "#endif");
    wln(self, "}");
}

/// Competitive SL15: the sampling profiler a program drives itself
/// (stdlib/profiler.fd prof_*): p_prof_start() clears the counts and
/// starts sampling (0, or -1 where this build cannot sample: tcc, WASI),
/// p_prof_stop() stops it and returns the samples taken, p_prof_report()
/// prints the table so far to stderr (the format of the native runtimes'
/// FID_PROF report) and returns the samples, p_prof_samples(name) the
/// samples with Fides function `name` on the stack. A sample is one ms of
/// CPU time. Windows (x64, ARM64): a sampler thread suspends the thread that
/// called p_prof_start each ms it ran (QueryThreadCycleTime), walks its
/// stack with the unwind tables (__p_frames) and resumes it; the names are
/// looked up after the resume (nothing that may lock runs while it is
/// suspended). POSIX (GCC, Clang): ITIMER_PROF and SIGPROF over the whole
/// process, the handler walking its own thread's stack (_Unwind_Backtrace,
/// as `fid profile`'s P_PROFILE build). "self" is the innermost Fides
/// function on the stack (time in the C runtime and libraries counts to the
/// Fides function that called them); each function on the stack counts once
/// in "total". Counts live in a fixed table of 4096 functions (no
/// allocation in the handler), keyed by the name __p_fn_name gives.
fn emit_prof_api_runtime(self: &mut CCodeGen) {
    wln(self, "/* SL15: p_prof_start / p_prof_stop / p_prof_report / p_prof_samples */");
    wln(self, "#define P_SP_SLOTS 4096");
    wln(self, "#define P_SP_DEPTH 64");
    wln(self, "static const char* volatile __p_sp_name[P_SP_SLOTS];");
    wln(self, "static volatile long long __p_sp_self[P_SP_SLOTS];");
    wln(self, "static volatile long long __p_sp_total[P_SP_SLOTS];");
    wln(self, "static volatile long long __p_sp_n;");
    wln(self, "static volatile long long __p_sp_other;");
    wln(self, "static volatile int __p_sp_on;");
    wln(self, "#if !defined(_WIN32) && !defined(__wasi__) && (defined(__GNUC__) || defined(__clang__)) && !defined(__TINYC__)");
    wln(self, "#define __P_SP_ADD(p, v) ((void)__sync_fetch_and_add((p), (v)))");
    wln(self, "#define __P_SP_CAS(p, o, n) __sync_bool_compare_and_swap((p), (o), (n))");
    wln(self, "#else");
    // Windows: one sampler thread writes the counts; elsewhere no sampler
    wln(self, "#define __P_SP_ADD(p, v) ((void)(*(p) += (v)))");
    wln(self, "#define __P_SP_CAS(p, o, n) (*(p) == (o) ? (*(p) = (n), 1) : 0)");
    wln(self, "#endif");
    wln(self, "static int __p_sp_slot(const char* nm) {");
    wln(self, "    uintptr_t h = ((uintptr_t)nm >> 3) * (uintptr_t)2654435761u;");
    wln(self, "    for (int i = 0; i < P_SP_SLOTS; i++) {");
    wln(self, "        int s = (int)((h + (uintptr_t)i) & (P_SP_SLOTS - 1));");
    wln(self, "        const char* k = __p_sp_name[s];");
    wln(self, "        if (k == nm) return s;");
    wln(self, "        if (!k) {");
    wln(self, "            if (__P_SP_CAS(&__p_sp_name[s], (const char*)0, nm)) return s;");
    wln(self, "            if (__p_sp_name[s] == nm) return s;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    return -1;");
    wln(self, "}");
    // DB9: FID_PROF=folded keeps whole stacks: a table of distinct stacks
    // (hashed; claimed with a compare-and-swap, filled, then counted), made
    // before sampling starts, written by the signal handler or the sampler
    // thread without allocating; printed root first, `a;b;c count`, the
    // input of flamegraph.pl and speedscope
    wln(self, "#define P_SF_SLOTS 4096");
    wln(self, "static const char** __p_sf_names;");
    wln(self, "static volatile long long* __p_sf_hash;");
    wln(self, "static volatile long long* __p_sf_count;");
    wln(self, "static volatile int* __p_sf_depth;");
    wln(self, "static volatile long long __p_sf_lost;");
    wln(self, "static int __p_sf_alloc(void) {");
    wln(self, "    if (__p_sf_names) return 1;");
    wln(self, "    __p_sf_hash = (volatile long long*)calloc(P_SF_SLOTS, sizeof(long long));");
    wln(self, "    __p_sf_count = (volatile long long*)calloc(P_SF_SLOTS, sizeof(long long));");
    wln(self, "    __p_sf_depth = (volatile int*)calloc(P_SF_SLOTS, sizeof(int));");
    wln(self, "    const char** nm = (const char**)calloc((size_t)P_SF_SLOTS * P_SP_DEPTH, sizeof(const char*));");
    wln(self, "    if (!__p_sf_hash || !__p_sf_count || !__p_sf_depth || !nm) return 0;");
    wln(self, "    __p_sf_names = nm;");
    wln(self, "    return 1;");
    wln(self, "}");
    wln(self, "static void __p_sf_clear(void) {");
    wln(self, "    if (!__p_sf_names) return;");
    wln(self, "    for (int s = 0; s < P_SF_SLOTS; s++) { __p_sf_depth[s] = 0; __p_sf_count[s] = 0; __p_sf_hash[s] = 0; }");
    wln(self, "    __p_sf_lost = 0;");
    wln(self, "}");
    // nm[0..m): the names of one sample, innermost first
    wln(self, "static void __p_sf_add(const char* const* nm, int m) {");
    wln(self, "    if (!__p_sf_names || m <= 0) return;");
    wln(self, "    unsigned long long h = 1469598103934665603ULL;");
    wln(self, "    for (int i = 0; i < m; i++) { h ^= (unsigned long long)(uintptr_t)nm[i]; h *= 1099511628211ULL; }");
    wln(self, "    h ^= (unsigned long long)m;");
    wln(self, "    long long key = (long long)(h >> 1) | 1;");
    wln(self, "    for (int i = 0; i < P_SF_SLOTS; i++) {");
    wln(self, "        int s = (int)((h + (unsigned long long)i) & (P_SF_SLOTS - 1));");
    wln(self, "        long long k = __p_sf_hash[s];");
    wln(self, "        if (k == 0) {");
    wln(self, "            if (__P_SP_CAS(&__p_sf_hash[s], 0LL, key)) {");
    wln(self, "                for (int j = 0; j < m; j++) __p_sf_names[(size_t)s * P_SP_DEPTH + j] = nm[j];");
    wln(self, "                __p_sf_depth[s] = m;");
    wln(self, "                __P_SP_ADD(&__p_sf_count[s], 1);");
    wln(self, "                return;");
    wln(self, "            }");
    wln(self, "            k = __p_sf_hash[s];");
    wln(self, "        }");
    wln(self, "        if (k == key) { __P_SP_ADD(&__p_sf_count[s], 1); return; }");
    wln(self, "    }");
    wln(self, "    __P_SP_ADD(&__p_sf_lost, 1);");
    wln(self, "}");
    wln(self, "static void __p_sf_print(FILE* out) {");
    wln(self, "    for (int s = 0; s < P_SF_SLOTS; s++) {");
    wln(self, "        int m = __p_sf_depth[s];");
    wln(self, "        long long c = __p_sf_count[s];");
    wln(self, "        if (m <= 0 || c <= 0) continue;");
    wln(self, "        for (int k = m - 1; k >= 0; k--) fprintf(out, k == m - 1 ? \"%s\" : \";%s\", __p_sf_names[(size_t)s * P_SP_DEPTH + k]);");
    wln(self, "        fprintf(out, \" %lld\\n\", c);");
    wln(self, "    }");
    wln(self, "    if (__p_sp_other > 0) fprintf(out, \"(outside the functions) %lld\\n\", (long long)__p_sp_other);");
    wln(self, "    if (__p_sf_lost > 0) fprintf(out, \"(more stacks than the table holds) %lld\\n\", (long long)__p_sf_lost);");
    wln(self, "}");
    // One sample: frames f[0..n) (function starts, innermost first)
    wln(self, "static void __p_sp_record(const uintptr_t* f, int n) {");
    wln(self, "    const char* seen[P_SP_DEPTH];");
    wln(self, "    const char* all[P_SP_DEPTH];");
    wln(self, "    int m = 0, a = 0;");
    wln(self, "    __P_SP_ADD(&__p_sp_n, 1);");
    wln(self, "    for (int i = 0; i < n && m < P_SP_DEPTH; i++) {");
    wln(self, "        const char* nm = __p_fn_name(f[i]);");
    wln(self, "        if (!nm) continue;");
    wln(self, "        if (a < P_SP_DEPTH) all[a++] = nm;");
    wln(self, "        int dup = 0;");
    wln(self, "        for (int j = 0; j < m; j++) if (seen[j] == nm) { dup = 1; break; }");
    wln(self, "        if (dup) continue;");
    wln(self, "        seen[m++] = nm;");
    wln(self, "        int s = __p_sp_slot(nm);");
    wln(self, "        if (s < 0) continue;");
    wln(self, "        __P_SP_ADD(&__p_sp_total[s], 1);");
    wln(self, "        if (m == 1) __P_SP_ADD(&__p_sp_self[s], 1);");
    wln(self, "    }");
    wln(self, "    if (m == 0) __P_SP_ADD(&__p_sp_other, 1);");
    wln(self, "    if (__p_sf_names && a > 0) __p_sf_add(all, a);");
    wln(self, "}");
    // DB9: 1 once the profiler was started: threads started later register
    // with the Windows sampler (__p_sp_thread_start)
    wln(self, "static volatile int __p_sp_reg;");
    wln(self, "#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__) || defined(_M_ARM64) || defined(__aarch64__)) && !defined(__TINYC__)");
    wln(self, "#define P_SP_HAVE 1");
    // DB9: every thread of the program (the one that started the profiler,
    // and each thread p_thread_wrapper starts after that), not only one
    wln(self, "#define P_SP_MAXT 64");
    wln(self, "static HANDLE volatile __p_sp_th[P_SP_MAXT];");
    wln(self, "static DWORD __p_sp_tid[P_SP_MAXT];");
    wln(self, "static volatile LONG __p_sp_tn;");
    wln(self, "static volatile int __p_sp_prime;");
    wln(self, "static void __p_sp_add_current(void) {");
    wln(self, "    DWORD id = GetCurrentThreadId();");
    wln(self, "    LONG n = __p_sp_tn;");
    wln(self, "    if (n > P_SP_MAXT) n = P_SP_MAXT;");
    wln(self, "    for (LONG i = 0; i < n; i++) if (__p_sp_tid[i] == id) return;");
    wln(self, "    HANDLE h = NULL;");
    wln(self, "    if (!DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &h, 0, FALSE, DUPLICATE_SAME_ACCESS)) return;");
    wln(self, "    LONG at = InterlockedIncrement(&__p_sp_tn) - 1;");
    wln(self, "    if (at >= P_SP_MAXT) { CloseHandle(h); return; }");
    wln(self, "    __p_sp_tid[at] = id;");
    // published last: the sampler skips a slot still NULL
    wln(self, "    InterlockedExchangePointer((PVOID volatile*)&__p_sp_th[at], h);");
    wln(self, "}");
    wln(self, "static HANDLE __p_sp_thread;");
    wln(self, "typedef LONG (NTAPI *__p_sp_res_fn)(ULONG, BOOLEAN, PULONG);");
    wln(self, "typedef BOOL (WINAPI *__p_sp_cyc_fn)(HANDLE, PULONG64);");
    wln(self, "static DWORD WINAPI __p_sp_loop(LPVOID a) {");
    wln(self, "    (void)a;");
    // Sleep(1) sleeps a whole 15.6 ms tick unless the timer resolution is
    // raised (0.5 ms, as the native runtimes)
    wln(self, "    HMODULE nt = GetModuleHandleA(\"ntdll.dll\");");
    wln(self, "    __p_sp_res_fn res = nt ? (__p_sp_res_fn)(void*)GetProcAddress(nt, \"NtSetTimerResolution\") : NULL;");
    wln(self, "    ULONG actual = 0;");
    wln(self, "    if (res) res(5000, TRUE, &actual);");
    wln(self, "    HMODULE k32 = GetModuleHandleA(\"kernel32.dll\");");
    wln(self, "    __p_sp_cyc_fn cyc = k32 ? (__p_sp_cyc_fn)(void*)GetProcAddress(k32, \"QueryThreadCycleTime\") : NULL;");
    wln(self, "    static ULONG64 last[P_SP_MAXT];");
    wln(self, "    static char seen[P_SP_MAXT];");
    wln(self, "    for (;;) {");
    wln(self, "        if (!__p_sp_on) { Sleep(20); continue; }");
    wln(self, "        Sleep(1);");
    // after a start the first look only notes each thread's cycles
    wln(self, "        int prime = __p_sp_prime;");
    wln(self, "        __p_sp_prime = 0;");
    wln(self, "        LONG tn = __p_sp_tn;");
    wln(self, "        if (tn > P_SP_MAXT) tn = P_SP_MAXT;");
    wln(self, "        for (LONG i = 0; i < tn && __p_sp_on; i++) {");
    wln(self, "            HANDLE t = __p_sp_th[i];");
    wln(self, "            if (!t) continue;");
    // one sample per ms the thread ran: a thread blocked (or gone) is not sampled
    wln(self, "            if (cyc) {");
    wln(self, "                ULONG64 c = 0;");
    wln(self, "                if (!cyc(t, &c)) continue;");
    wln(self, "                if (seen[i] && c == last[i]) continue;");
    wln(self, "                int first = !seen[i];");
    wln(self, "                seen[i] = 1; last[i] = c;");
    wln(self, "                if (first || prime) continue;");
    wln(self, "            }");
    wln(self, "            if (SuspendThread(t) == (DWORD)-1) continue;");
    wln(self, "            CONTEXT c;");
    wln(self, "            memset(&c, 0, sizeof c);");
    wln(self, "            c.ContextFlags = CONTEXT_FULL;");
    wln(self, "            uintptr_t f[P_SP_DEPTH];");
    wln(self, "            int n = 0;");
    wln(self, "            if (GetThreadContext(t, &c)) n = __p_frames(&c, 1, f, P_SP_DEPTH);");
    wln(self, "            ResumeThread(t);");
    wln(self, "            if (__p_sp_on) __p_sp_record(f, n);");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "static int __p_sp_begin(void) {");
    wln(self, "    __p_sp_add_current();");
    wln(self, "    if (__p_sp_tn <= 0) return -1;");
    wln(self, "    __p_sp_prime = 1;");
    wln(self, "    __p_sp_reg = 1;");
    wln(self, "    if (!__p_sp_thread) __p_sp_thread = CreateThread(NULL, 0, __p_sp_loop, NULL, 0, NULL);");
    wln(self, "    return __p_sp_thread ? 0 : -1;");
    wln(self, "}");
    wln(self, "static void __p_sp_end(void) { Sleep(2); }");
    wln(self, "#elif !defined(_WIN32) && !defined(__wasi__) && (defined(__GNUC__) || defined(__clang__)) && !defined(__TINYC__)");
    wln(self, "#define P_SP_HAVE 1");
    wln(self, "#include <sys/time.h>");
    wln(self, "#include <signal.h>");
    wln(self, "#include <errno.h>");
    wln(self, "static int __p_sp_armed;");
    wln(self, "static void __p_sp_tick(int sig) {");
    wln(self, "    (void)sig;");
    wln(self, "    if (!__p_sp_on) return;");
    wln(self, "    int e = errno;");
    wln(self, "    uintptr_t f[P_SP_DEPTH];");
    wln(self, "    int n = __p_frames(NULL, 0, f, P_SP_DEPTH);");
    wln(self, "    __p_sp_record(f, n);");
    wln(self, "    errno = e;");
    wln(self, "}");
    wln(self, "static int __p_sp_begin(void) {");
    wln(self, "    if (!__p_sp_armed) {");
    wln(self, "        struct sigaction sa;");
    wln(self, "        memset(&sa, 0, sizeof sa);");
    wln(self, "        sa.sa_handler = __p_sp_tick;");
    wln(self, "        sa.sa_flags = SA_RESTART;");
    wln(self, "        sigemptyset(&sa.sa_mask);");
    wln(self, "        if (sigaction(SIGPROF, &sa, NULL) != 0) return -1;");
    wln(self, "        __p_sp_armed = 1;");
    wln(self, "    }");
    wln(self, "    struct itimerval t;");
    wln(self, "    memset(&t, 0, sizeof t);");
    wln(self, "    t.it_interval.tv_usec = 1000;");
    wln(self, "    t.it_value = t.it_interval;");
    wln(self, "    return setitimer(ITIMER_PROF, &t, NULL) == 0 ? 0 : -1;");
    wln(self, "}");
    wln(self, "static void __p_sp_end(void) {");
    wln(self, "    struct itimerval t;");
    wln(self, "    memset(&t, 0, sizeof t);");
    wln(self, "    setitimer(ITIMER_PROF, &t, NULL);");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "int64_t p_prof_start(void) {");
    wln(self, "#ifdef P_SP_HAVE");
    wln(self, "    __p_sp_on = 0;");
    // the sorted name table is made now, never in the handler or sampler
    wln(self, "    (void)__p_fn_name(0);");
    wln(self, "    for (int s = 0; s < P_SP_SLOTS; s++) { __p_sp_self[s] = 0; __p_sp_total[s] = 0; }");
    wln(self, "    __p_sp_n = 0;");
    wln(self, "    __p_sp_other = 0;");
    wln(self, "    __p_sf_clear();");
    wln(self, "    __p_sp_on = 1;");
    wln(self, "    if (__p_sp_begin() != 0) { __p_sp_on = 0; return -1; }");
    wln(self, "    return 0;");
    wln(self, "#else");
    wln(self, "    return -1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_prof_stop(void) {");
    wln(self, "#ifdef P_SP_HAVE");
    wln(self, "    if (__p_sp_on) { __p_sp_on = 0; __p_sp_end(); }");
    wln(self, "#endif");
    wln(self, "    return (int64_t)__p_sp_n;");
    wln(self, "}");
    wln(self, "int64_t p_prof_report(void) {");
    wln(self, "    long long n = __p_sp_n;");
    // DB9: FID_PROF=folded: the stacks, one line each, nothing else
    wln(self, "    if (__p_sf_names) { __p_sf_print(stderr); return (int64_t)n; }");
    wln(self, "    fprintf(stderr, \"profile (FID_PROF): %lld samples, one per ms of CPU time\\n\", n);");
    wln(self, "    if (n <= 0) return (int64_t)n;");
    wln(self, "    fprintf(stderr, \"   self%%     self  total%%    total  function\\n\");");
    wln(self, "    static char shown[P_SP_SLOTS];");
    wln(self, "    memset(shown, 0, sizeof shown);");
    wln(self, "    for (int row = 0; row < 40; row++) {");
    wln(self, "        int best = -1;");
    wln(self, "        for (int s = 0; s < P_SP_SLOTS; s++) {");
    wln(self, "            if (shown[s] || !__p_sp_name[s] || __p_sp_total[s] == 0) continue;");
    wln(self, "            if (best < 0 || __p_sp_self[s] > __p_sp_self[best] || (__p_sp_self[s] == __p_sp_self[best] && __p_sp_total[s] > __p_sp_total[best])) best = s;");
    wln(self, "        }");
    wln(self, "        if (best < 0) break;");
    wln(self, "        shown[best] = 1;");
    wln(self, "        long long sv = __p_sp_self[best], tv = __p_sp_total[best];");
    wln(self, "        fprintf(stderr, \"%6lld.%lld%9lld%6lld.%lld%9lld  %s\\n\", sv * 1000 / n / 10, sv * 1000 / n % 10, sv, tv * 1000 / n / 10, tv * 1000 / n % 10, tv, __p_sp_name[best]);");
    wln(self, "    }");
    wln(self, "    long long ov = __p_sp_other;");
    wln(self, "    if (ov > 0) fprintf(stderr, \"%6lld.%lld%9lld%6lld.%lld%9lld  (outside the functions)\\n\", ov * 1000 / n / 10, ov * 1000 / n % 10, ov, ov * 1000 / n / 10, ov * 1000 / n % 10, ov);");
    wln(self, "    return (int64_t)n;");
    wln(self, "}");
    wln(self, "int64_t p_prof_samples(const char* name) {");
    wln(self, "    if (!name) return 0;");
    wln(self, "    long long t = 0;");
    wln(self, "    for (int s = 0; s < P_SP_SLOTS; s++) {");
    wln(self, "        const char* k = __p_sp_name[s];");
    wln(self, "        if (k && strcmp(k, name) == 0) t += __p_sp_total[s];");
    wln(self, "    }");
    wln(self, "    return (int64_t)t;");
    wln(self, "}");
    // DB9: `FID_PROF=1 ./prog` on the C path, as on the native targets: the
    // sampler above from before main to exit, the table on stderr at exit;
    // FID_PROF=folded prints the folded stacks instead. Not in `fid
    // profile` builds (P_PROFILE has its own SIGPROF sampler).
    wln(self, "static void __p_sp_atexit(void) {");
    wln(self, "    if (!__p_sp_on) return;");
    wln(self, "    p_prof_stop();");
    wln(self, "    p_prof_report();");
    wln(self, "}");
    wln(self, "void __p_sp_boot(void) {");
    wln(self, "#if defined(P_SP_HAVE) && !defined(P_PROFILE)");
    wln(self, "    const char* v = getenv(\"FID_PROF\");");
    wln(self, "    if (!v || !v[0] || (v[0] == '0' && !v[1])) return;");
    wln(self, "    if (strcmp(v, \"folded\") == 0 && !__p_sf_alloc()) return;");
    wln(self, "    if (p_prof_start() == 0) atexit(__p_sp_atexit);");
    wln(self, "#endif");
    wln(self, "}");
    // p_thread_wrapper, on each new thread: on Windows the sampler looks at
    // it too once the profiler was started (SIGPROF covers every thread)
    wln(self, "static void __p_sp_thread_start(void) {");
    wln(self, "#if defined(P_SP_HAVE) && defined(_WIN32)");
    wln(self, "    if (__p_sp_reg) __p_sp_add_current();");
    wln(self, "#else");
    wln(self, "    (void)__p_sp_reg;");
    wln(self, "#endif");
    wln(self, "}");
}

/// roadmap P12: run-time resource limits, read from the environment when
/// the program starts (main calls __p_limits_init).
///   FID_MEM_LIMIT=<bytes>[K|M|G]: the live bytes of the heap (every p_malloc
///     block, by its size class; a large block by what the C library gave)
///     may not pass it: the allocation that would is stopped with
///     "fid: memory limit of N bytes exceeded", a stack trace, exit code 125.
///   FID_CPU_LIMIT=<seconds>: the process's CPU time (all threads) may not
///     pass it: "fid: CPU time limit of S seconds exceeded", exit code 124
///     (as `timeout`). POSIX: RLIMIT_CPU and SIGXCPU (whole seconds, rounded
///     up); Windows: a thread reading GetProcessTimes every 10 ms.
/// Unset, empty or 0: no limit, and the allocator does one test of a global.
fn emit_limits_runtime(self: &mut CCodeGen) {
    wln(self, "static int64_t __p_lim_mem = 0;");
    // RT8: what sends p_malloc past its inline path, in one word every call
    // reads: P_ASLOW_INIT until the allocator is set up (__p_heap_init),
    // P_ASLOW_LIM under FID_MEM_LIMIT, P_ASLOW_RG for each live region of any
    // thread (the thread's own __p_rs.mode is looked at only then)
    wln(self, "static int64_t __p_aslow = 1;");
    wln(self, "#define P_ASLOW_INIT 1");
    wln(self, "#define P_ASLOW_LIM 2");
    // (Windows M:N without a TEB TLS slot for the heap: __P_HEAP cannot be
    // read inline, every call takes the slow path)
    wln(self, "#define P_ASLOW_NOTP 4");
    wln(self, "#define P_ASLOW_RG 256");
    wln(self, "#if defined(__TINYC__)");
    wln(self, "#define __P_ASLOW() (__p_aslow)");
    wln(self, "#define __P_ASLOW_ADD(v) ((void)(__p_aslow += (v)))");
    wln(self, "#elif defined(_MSC_VER)");
    wln(self, "#define __P_ASLOW() (*(volatile int64_t*)&__p_aslow)");
    wln(self, "#define __P_ASLOW_ADD(v) ((void)_InterlockedExchangeAdd64((volatile long long*)&__p_aslow, (long long)(v)))");
    wln(self, "#else");
    wln(self, "#define __P_ASLOW() __atomic_load_n(&__p_aslow, __ATOMIC_ACQUIRE)");
    wln(self, "#define __P_ASLOW_ADD(v) ((void)__atomic_fetch_add(&__p_aslow, (int64_t)(v), __ATOMIC_SEQ_CST))");
    wln(self, "#endif");
    wln(self, "#ifdef _WIN32");
    wln(self, "#include <malloc.h>");
    wln(self, "static volatile long long __p_lim_used = 0;");
    wln(self, "#define __P_LIM_ADD(v) InterlockedExchangeAdd64(&__p_lim_used, (long long)(v))");
    wln(self, "#define __P_LIM_BIG(p) ((int64_t)_msize(p))");
    wln(self, "#else");
    wln(self, "#include <stdatomic.h>");
    wln(self, "static atomic_int_least64_t __p_lim_used;");
    wln(self, "#define __P_LIM_ADD(v) atomic_fetch_add(&__p_lim_used, (int_least64_t)(v))");
    wln(self, "#if defined(__APPLE__)");
    wln(self, "#include <malloc/malloc.h>");
    wln(self, "#define __P_LIM_BIG(p) ((int64_t)malloc_size(p))");
    wln(self, "#elif defined(__linux__)");
    wln(self, "#include <malloc.h>");
    wln(self, "#define __P_LIM_BIG(p) ((int64_t)malloc_usable_size(p))");
    wln(self, "#elif defined(__FreeBSD__)");
    wln(self, "#include <malloc_np.h>");
    wln(self, "#define __P_LIM_BIG(p) ((int64_t)malloc_usable_size(p))");
    wln(self, "#else");
    // a large block is then counted at no bytes, both ways
    wln(self, "#define __P_LIM_BIG(p) ((int64_t)0)");
    wln(self, "#endif");
    wln(self, "#endif");
    // the bytes of size class k (p_malloc: 2^(k/2), or 3/4 of 2^((k+1)/2))
    wln(self, "static int64_t __p_lim_class_bytes(int k) {");
    wln(self, "    if (k & 1) { int64_t b = (int64_t)1 << ((k + 1) / 2); return b - b / 4; }");
    wln(self, "    return (int64_t)1 << (k / 2);");
    wln(self, "}");
    wln(self, "static void __p_lim_over(int64_t used, int64_t want) {");
    wln(self, "    fprintf(stderr, \"fid: memory limit of %lld bytes exceeded (FID_MEM_LIMIT): %lld bytes in use, %lld more asked for\\n\", (long long)__p_lim_mem, (long long)used, (long long)want);");
    wln(self, "    __p_print_trace_ctx(NULL, 0);");
    wln(self, "    fflush(stdout);");
    wln(self, "    fflush(stderr);");
    // _exit: the leak report of an unfinished run would only be noise
    wln(self, "    _exit(125);");
    wln(self, "}");
    wln(self, "static void __p_lim_take(int64_t n) {");
    wln(self, "    int64_t before = (int64_t)__P_LIM_ADD(n);");
    wln(self, "    if (before + n > __p_lim_mem) { __P_LIM_ADD(-n); __p_lim_over(before, n); }");
    wln(self, "}");
    // <digits>[.digits][K|M|G] -> a number, -1 when it is not one
    wln(self, "static double __p_lim_parse(const char* s, int units) {");
    wln(self, "    if (!s || !*s) return 0;");
    wln(self, "    char* end = NULL;");
    wln(self, "    double v = strtod(s, &end);");
    wln(self, "    if (end == s || v < 0) return -1;");
    wln(self, "    if (units && (*end == 'K' || *end == 'k')) { v *= 1024.0; end++; }");
    wln(self, "    else if (units && (*end == 'M' || *end == 'm')) { v *= 1048576.0; end++; }");
    wln(self, "    else if (units && (*end == 'G' || *end == 'g')) { v *= 1073741824.0; end++; }");
    wln(self, "    if (units && (*end == 'B' || *end == 'b')) end++;");
    wln(self, "    return *end ? -1 : v;");
    wln(self, "}");
    wln(self, "static char __p_lim_cpu_msg[128];");
    wln(self, "static int __p_lim_cpu_len = 0;");
    wln(self, "#ifdef _WIN32");
    wln(self, "static double __p_lim_cpu = 0;");
    wln(self, "static DWORD WINAPI __p_lim_watch(LPVOID arg) {");
    wln(self, "    (void)arg;");
    wln(self, "    for (;;) {");
    wln(self, "        FILETIME c, e, k, u;");
    wln(self, "        if (GetProcessTimes(GetCurrentProcess(), &c, &e, &k, &u)) {");
    wln(self, "            ULARGE_INTEGER a, b;");
    wln(self, "            a.LowPart = k.dwLowDateTime; a.HighPart = k.dwHighDateTime;");
    wln(self, "            b.LowPart = u.dwLowDateTime; b.HighPart = u.dwHighDateTime;");
    wln(self, "            if ((double)(a.QuadPart + b.QuadPart) / 1e7 >= __p_lim_cpu) {");
    wln(self, "                fwrite(__p_lim_cpu_msg, 1, (size_t)__p_lim_cpu_len, stderr);");
    wln(self, "                fflush(stderr);");
    wln(self, "                TerminateProcess(GetCurrentProcess(), 124);");
    wln(self, "            }");
    wln(self, "        }");
    wln(self, "        Sleep(10);");
    wln(self, "    }");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "#elif !defined(__wasi__)");
    wln(self, "#include <signal.h>");
    wln(self, "#include <unistd.h>");
    wln(self, "#include <sys/resource.h>");
    wln(self, "static void __p_lim_xcpu(int sig) {");
    wln(self, "    (void)sig;");
    wln(self, "    ssize_t w = write(2, __p_lim_cpu_msg, (size_t)__p_lim_cpu_len);");
    wln(self, "    (void)w;");
    wln(self, "    _exit(124);");
    wln(self, "}");
    wln(self, "#endif");
    // A limit baked in when the program was built (`-DP_LIM_MEM_DEFAULT=
    // <bytes>`, `-DP_LIM_CPU_DEFAULT_MS=<ms>`, as the driver's --max-mem /
    // --cpu-limit pass them): used when the variable is not set; the
    // variable, when set, wins. -DP_NO_ENV_LIMITS: neither (a program
    // such as fid itself, whose user's limits are for the programs it runs).
    wln(self, "void __p_limits_init(void) {");
    wln(self, "#ifdef P_NO_ENV_LIMITS");
    wln(self, "    if (1) return;");
    wln(self, "#endif");
    wln(self, "    const char* m = getenv(\"FID_MEM_LIMIT\");");
    wln(self, "#ifdef P_LIM_MEM_DEFAULT");
    wln(self, "    static char mdef[32];");
    wln(self, "    if (!m || !*m) { snprintf(mdef, sizeof mdef, \"%lld\", (long long)(P_LIM_MEM_DEFAULT)); m = mdef; }");
    wln(self, "#endif");
    wln(self, "    double mv = __p_lim_parse(m, 1);");
    wln(self, "    if (mv < 0) { fprintf(stderr, \"fid: FID_MEM_LIMIT is not a size (bytes, or with K, M or G): '%s'\\n\", m); exit(2); }");
    wln(self, "    if (mv > 0) __p_lim_mem = mv < 1 ? 1 : (int64_t)mv;");
    wln(self, "    if (__p_lim_mem && !(__P_ASLOW() & P_ASLOW_LIM)) __P_ASLOW_ADD(P_ASLOW_LIM);");
    wln(self, "    const char* t = getenv(\"FID_CPU_LIMIT\");");
    wln(self, "#ifdef P_LIM_CPU_DEFAULT_MS");
    wln(self, "    static char tdef[32];");
    wln(self, "    if (!t || !*t) { snprintf(tdef, sizeof tdef, \"%g\", (double)(P_LIM_CPU_DEFAULT_MS) / 1000.0); t = tdef; }");
    wln(self, "#endif");
    wln(self, "    double tv = __p_lim_parse(t, 0);");
    wln(self, "    if (tv < 0) { fprintf(stderr, \"fid: FID_CPU_LIMIT is not a number of seconds: '%s'\\n\", t); exit(2); }");
    wln(self, "    if (tv <= 0) return;");
    wln(self, "    __p_lim_cpu_len = snprintf(__p_lim_cpu_msg, sizeof __p_lim_cpu_msg, \"fid: CPU time limit of %s seconds exceeded (FID_CPU_LIMIT)\\n\", t);");
    wln(self, "    if (__p_lim_cpu_len < 0 || __p_lim_cpu_len >= (int)sizeof __p_lim_cpu_msg) __p_lim_cpu_len = (int)strlen(__p_lim_cpu_msg);");
    wln(self, "#ifdef _WIN32");
    wln(self, "    __p_lim_cpu = tv;");
    wln(self, "    HANDLE th = CreateThread(NULL, 64 * 1024, __p_lim_watch, NULL, 0, NULL);");
    wln(self, "    if (th) CloseHandle(th);");
    wln(self, "#elif !defined(__wasi__)");
    wln(self, "    signal(SIGXCPU, __p_lim_xcpu);");
    wln(self, "    struct rlimit rl;");
    wln(self, "    if (getrlimit(RLIMIT_CPU, &rl) == 0) {");
    wln(self, "        rlim_t want = (rlim_t)tv;");
    wln(self, "        if ((double)want < tv) want++;");
    wln(self, "        if (rl.rlim_max == RLIM_INFINITY || want < rl.rlim_max) { rl.rlim_cur = want; setrlimit(RLIMIT_CPU, &rl); }");
    wln(self, "    }");
    wln(self, "#endif");
    wln(self, "}");
}

/// roadmap L6C: the real loader. A handle is the OS's (an HMODULE, a
/// dlopen handle); 0 is failure everywhere.
fn emit_dl_runtime(self: &mut CCodeGen) {
    wln(self, "#if defined(_WIN32)");
    wln(self, "#include <windows.h>");
    wln(self, "int64_t p_dl_load(const char* path) {");
    wln(self, "    if (!path || !*path) return 0;");
    wln(self, "    UINT old = SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOOPENFILEERRORBOX);");
    wln(self, "    HMODULE h = LoadLibraryA(path);");
    wln(self, "    SetErrorMode(old);");
    wln(self, "    return (int64_t)(intptr_t)h;");
    wln(self, "}");
    wln(self, "int64_t p_dl_find(int64_t handle, const char* name) {");
    wln(self, "    if (!handle || !name || !*name) return 0;");
    wln(self, "    return (int64_t)(intptr_t)GetProcAddress((HMODULE)(intptr_t)handle, name);");
    wln(self, "}");
    wln(self, "int64_t p_dl_unload(int64_t handle) {");
    wln(self, "    if (!handle) return -1;");
    wln(self, "    return FreeLibrary((HMODULE)(intptr_t)handle) ? 0 : -1;");
    wln(self, "}");
    wln(self, "#elif defined(__wasi__)");
    wln(self, "int64_t p_dl_load(const char* path) { (void)path; return 0; }");
    wln(self, "int64_t p_dl_find(int64_t handle, const char* name) { (void)handle; (void)name; return 0; }");
    wln(self, "int64_t p_dl_unload(int64_t handle) { (void)handle; return -1; }");
    wln(self, "#else");
    wln(self, "#include <dlfcn.h>");
    wln(self, "int64_t p_dl_load(const char* path) {");
    wln(self, "    if (!path || !*path) return 0;");
    wln(self, "    return (int64_t)(intptr_t)dlopen(path, RTLD_NOW | RTLD_LOCAL);");
    wln(self, "}");
    wln(self, "int64_t p_dl_find(int64_t handle, const char* name) {");
    wln(self, "    if (!handle || !name || !*name) return 0;");
    wln(self, "    return (int64_t)(intptr_t)dlsym((void*)(intptr_t)handle, name);");
    wln(self, "}");
    wln(self, "int64_t p_dl_unload(int64_t handle) {");
    wln(self, "    if (!handle) return -1;");
    wln(self, "    return dlclose((void*)(intptr_t)handle) == 0 ? 0 : -1;");
    wln(self, "}");
    wln(self, "#endif");
}

/// --mem (roadmap L7C, complaint CO5): inside the debug allocator, after
/// __p_mc_hash and before its p_malloc. Each allocation is counted under
/// (innermost Fides function, source line); at exit the totals, the peak
/// of live bytes and the bytes by function and by line go to stderr.
fn emit_mem_profile_impl(self: &mut CCodeGen) {
    wln(self, "#ifdef P_MEMPROF");
    wln(self, "typedef struct { uintptr_t fn; const char* at; int64_t n; int64_t bytes; } __p_mp_site;");
    wln(self, "#define __P_MP_CAP 4096");
    wln(self, "static __p_mp_site __p_mp_tab[__P_MP_CAP];");
    wln(self, "static int64_t __p_mp_used = 0, __p_mp_allocs = 0, __p_mp_bytes = 0, __p_mp_frees = 0, __p_mp_freed = 0;");
    wln(self, "static int64_t __p_mp_live = 0, __p_mp_peak = 0, __p_mp_lost = 0;");
    wln(self, "static int __p_mp_started = 0;");
    wln(self, "/* Called with the allocation table's lock held. */");
    wln(self, "static void __p_mp_note(uintptr_t fn, const char* at, int64_t size) {");
    wln(self, "    __p_mp_allocs++; __p_mp_bytes += size; __p_mp_live += size;");
    wln(self, "    if (__p_mp_live > __p_mp_peak) __p_mp_peak = __p_mp_live;");
    wln(self, "    uint64_t m = __P_MP_CAP - 1, i = __p_mc_hash((void*)(fn ^ (uintptr_t)at)) & m;");
    wln(self, "    for (int64_t k = 0; k < __P_MP_CAP; k++, i = (i + 1) & m) {");
    wln(self, "        __p_mp_site* s = &__p_mp_tab[i];");
    wln(self, "        if (s->n && s->fn == fn && s->at == at) { s->n++; s->bytes += size; return; }");
    wln(self, "        if (!s->n) {");
    wln(self, "            if (__p_mp_used * 4 >= __P_MP_CAP * 3) break;");
    wln(self, "            s->fn = fn; s->at = at; s->n = 1; s->bytes = size; __p_mp_used++;");
    wln(self, "            return;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    __p_mp_lost += size;");
    wln(self, "}");
    // Exit criterion of L7 (memory profile with flame graphs): the bytes
    // by whole stack of Fides functions, written at exit as collapsed
    // stacks ("main;fill;p_str_alloc 500", outermost first) to the file
    // FID_MEM_FOLDED names, for flamegraph.pl, inferno or speedscope.
    wln(self, "#define __P_MS_DEPTH 32");
    wln(self, "#define __P_MS_CAP 4096");
    wln(self, "typedef struct { int64_t n; int64_t bytes; int64_t depth; uintptr_t fr[__P_MS_DEPTH]; } __p_ms_stack;");
    wln(self, "static __p_ms_stack* __p_ms_tab = NULL;");
    wln(self, "static int64_t __p_ms_used = 0, __p_ms_lost = 0;");
    wln(self, "static int __p_ms_on = -1;");
    wln(self, "/* Called with the allocation table's lock held. */");
    wln(self, "static void __p_ms_note(int64_t size) {");
    wln(self, "    if (__p_ms_on < 0) { const char* p = getenv(\"FID_MEM_FOLDED\"); __p_ms_on = (p && *p) ? 1 : 0; }");
    wln(self, "    if (!__p_ms_on) return;");
    wln(self, "    if (!__p_ms_tab) { __p_ms_tab = (__p_ms_stack*)calloc(__P_MS_CAP, sizeof(__p_ms_stack)); if (!__p_ms_tab) { __p_ms_on = 0; return; } }");
    wln(self, "    uintptr_t f[96], s[__P_MS_DEPTH];");
    wln(self, "    int n = __p_frames(NULL, 0, f, 96); int64_t d = 0;");
    wln(self, "    for (int i = 0; i < n && d < __P_MS_DEPTH; i++) if (__p_fn_name(f[i])) s[d++] = f[i];");
    wln(self, "    uint64_t h = 1469598103934665603ULL;");
    wln(self, "    for (int64_t i = 0; i < d; i++) { h ^= (uint64_t)s[i]; h *= 1099511628211ULL; }");
    wln(self, "    uint64_t m = __P_MS_CAP - 1, i = (h ^ (h >> 29)) & m;");
    wln(self, "    for (int64_t k = 0; k < __P_MS_CAP; k++, i = (i + 1) & m) {");
    wln(self, "        __p_ms_stack* e = &__p_ms_tab[i];");
    wln(self, "        if (e->n && e->depth == d && memcmp(e->fr, s, (size_t)d * sizeof(uintptr_t)) == 0) { e->n++; e->bytes += size; return; }");
    wln(self, "        if (!e->n) {");
    wln(self, "            if (__p_ms_used * 4 >= __P_MS_CAP * 3) break;");
    wln(self, "            e->n = 1; e->bytes = size; e->depth = d; memcpy(e->fr, s, (size_t)d * sizeof(uintptr_t)); __p_ms_used++;");
    wln(self, "            return;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    __p_ms_lost += size;");
    wln(self, "}");
    wln(self, "static void __p_ms_write(void) {");
    wln(self, "    const char* path = getenv(\"FID_MEM_FOLDED\");");
    wln(self, "    if (!path || !*path || !__p_ms_tab) return;");
    wln(self, "    FILE* o = fopen(path, \"w\");");
    wln(self, "    if (!o) { fprintf(stderr, \"fid --mem: cannot write %s\\n\", path); return; }");
    wln(self, "    for (int64_t i = 0; i < __P_MS_CAP; i++) {");
    wln(self, "        __p_ms_stack* e = &__p_ms_tab[i];");
    wln(self, "        if (!e->n) continue;");
    wln(self, "        if (e->depth == 0) fputs(\"(no Fides frame)\", o);");
    wln(self, "        for (int64_t k = e->depth - 1; k >= 0; k--) {");
    wln(self, "            const char* nm = __p_fn_name(e->fr[k]);");
    wln(self, "            fprintf(o, \"%s%s\", k == e->depth - 1 ? \"\" : \";\", nm ? nm : \"?\");");
    wln(self, "        }");
    wln(self, "        fprintf(o, \" %lld\\n\", (long long)e->bytes);");
    wln(self, "    }");
    wln(self, "    if (__p_ms_lost) fprintf(o, \"(other stacks) %lld\\n\", (long long)__p_ms_lost);");
    wln(self, "    fclose(o);");
    wln(self, "    fprintf(stderr, \"fid --mem: bytes by stack written to %s (collapsed stacks)\\n\", path);");
    wln(self, "}");
    // L7C, region usage: the blocks regions' arenas give out (proposal
    // 0005, a build with FID_REGION_ARENA=1), which the table above never
    // sees (a region's end releases them together). Only reads the region
    // state (emit_region_runtime / emit_region_impl): the debug p_malloc
    // sends a region's block here before its own region hook.
    wln(self, "/* Region usage: regions are counted by depth (1: outermost) and told apart by");
    wln(self, "   their arena (__p_rarena), whose first block finds no chunk there yet. A");
    wln(self, "   region's bytes only grow until its end, so its largest size is its peak.");
    wln(self, "   Live bytes are those of the allocating thread's open regions (the region");
    wln(self, "   state is per thread); the peak is the largest such sum seen. */");
    wln(self, "#define __P_MR_DEPTHS 16");
    wln(self, "#define __P_MR_CAP 512");
    wln(self, "#define __P_MR_SITES 1024");
    wln(self, "typedef struct { void* arena; int64_t bytes; } __p_mr_inst;");
    wln(self, "static __p_mr_inst __p_mr_tab[__P_MR_CAP];");
    wln(self, "static int64_t __p_mr_regions[__P_MR_DEPTHS + 1], __p_mr_n[__P_MR_DEPTHS + 1], __p_mr_bytes[__P_MR_DEPTHS + 1], __p_mr_largest[__P_MR_DEPTHS + 1];");
    wln(self, "static int64_t __p_mr_all_regions = 0, __p_mr_all_n = 0, __p_mr_all_bytes = 0, __p_mr_peak = 0, __p_mr_lost = 0;");
    wln(self, "static __p_mp_site __p_mr_sites[__P_MR_SITES];");
    wln(self, "static int64_t __p_mr_sites_used = 0;");
    wln(self, "static void __p_mp_report(void);");
    wln(self, "static __p_mr_inst* __p_mr_slot(void* arena, int add) {");
    wln(self, "    uint64_t m = __P_MR_CAP - 1, i = __p_mc_hash(arena) & m;");
    wln(self, "    for (int64_t k = 0; k < __P_MR_CAP; k++, i = (i + 1) & m) {");
    wln(self, "        if (__p_mr_tab[i].arena == arena) return &__p_mr_tab[i];");
    wln(self, "        if (!__p_mr_tab[i].arena) {");
    wln(self, "            if (!add) return NULL;");
    wln(self, "            __p_mr_tab[i].arena = arena; __p_mr_tab[i].bytes = 0;");
    wln(self, "            return &__p_mr_tab[i];");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    return NULL;");
    wln(self, "}");
    wln(self, "/* Called with the allocation table's lock held. */");
    wln(self, "static void __p_mr_note(__p_rarena* a, int fresh, int64_t depth, uintptr_t fn, const char* at, int64_t size) {");
    wln(self, "    int64_t d = depth < 1 ? 1 : depth > __P_MR_DEPTHS ? __P_MR_DEPTHS : depth;");
    wln(self, "    __p_mr_all_n++; __p_mr_all_bytes += size;");
    wln(self, "    __p_mr_n[d]++; __p_mr_bytes[d] += size;");
    wln(self, "    __p_mr_inst* e = __p_mr_slot((void*)a, 1);");
    wln(self, "    if (e) {");
    wln(self, "        if (fresh) { e->bytes = 0; __p_mr_regions[d]++; __p_mr_all_regions++; }");
    wln(self, "        e->bytes += size;");
    wln(self, "        if (e->bytes > __p_mr_largest[d]) __p_mr_largest[d] = e->bytes;");
    wln(self, "    } else if (fresh) { __p_mr_regions[d]++; __p_mr_all_regions++; }");
    wln(self, "    int64_t live = 0;");
    wln(self, "    for (__p_rarena* x = __p_rs.top; x; x = x->below) {");
    wln(self, "        if (!x->chunks) continue;");
    wln(self, "        __p_mr_inst* y = x == a ? e : __p_mr_slot((void*)x, 0);");
    wln(self, "        if (y) live += y->bytes;");
    wln(self, "    }");
    wln(self, "    if (live > __p_mr_peak) __p_mr_peak = live;");
    wln(self, "    uint64_t m = __P_MR_SITES - 1, i = __p_mc_hash((void*)(fn ^ (uintptr_t)at)) & m;");
    wln(self, "    for (int64_t k = 0; k < __P_MR_SITES; k++, i = (i + 1) & m) {");
    wln(self, "        __p_mp_site* s = &__p_mr_sites[i];");
    wln(self, "        if (s->n && s->fn == fn && s->at == at) { s->n++; s->bytes += size; return; }");
    wln(self, "        if (!s->n) {");
    wln(self, "            if (__p_mr_sites_used * 4 >= __P_MR_SITES * 3) break;");
    wln(self, "            s->fn = fn; s->at = at; s->n = 1; s->bytes = size; __p_mr_sites_used++;");
    wln(self, "            return;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    __p_mr_lost += size;");
    wln(self, "}");
    // the debug p_malloc's region path: the block from the region's arena
    // (__p_rg_alloc, as before), then noted
    wln(self, "static void* __p_mr_alloc(int64_t size) {");
    wln(self, "    __p_rarena* a = __p_rg_at(__p_rs.mode);");
    wln(self, "    int fresh = a && !a->chunks;");
    wln(self, "    void* p = __p_rg_alloc(size);");
    wln(self, "    if (!p || !a) return p;");
    wln(self, "    uintptr_t site[__P_MC_SITES];");
    wln(self, "    memset(site, 0, sizeof site);");
    wln(self, "    __p_mc_where(site);");
    wln(self, "    __P_MC_LOCK();");
    wln(self, "    if (!__p_mp_started) { __p_mp_started = 1; atexit(__p_mp_report); }");
    wln(self, "    __p_mr_note(a, fresh, __p_rs.mode, site[0], __p_mc_at, size);");
    wln(self, "    __P_MC_UNLOCK();");
    wln(self, "    return p;");
    wln(self, "}");
    wln(self, "typedef struct { const char* name; int64_t n; int64_t bytes; } __p_mp_row;");
    wln(self, "static int __p_mp_cmp(const void* a, const void* b) {");
    wln(self, "    const __p_mp_row* x = (const __p_mp_row*)a;");
    wln(self, "    const __p_mp_row* y = (const __p_mp_row*)b;");
    wln(self, "    if (x->bytes != y->bytes) return x->bytes < y->bytes ? 1 : -1;");
    wln(self, "    if (x->n != y->n) return x->n < y->n ? 1 : -1;");
    wln(self, "    return strcmp(x->name, y->name);");
    wln(self, "}");
    wln(self, "static int64_t __p_mp_add(__p_mp_row* rows, int64_t m, const char* name, int64_t n, int64_t bytes) {");
    wln(self, "    for (int64_t i = 0; i < m; i++) {");
    wln(self, "        if (strcmp(rows[i].name, name) == 0) { rows[i].n += n; rows[i].bytes += bytes; return m; }");
    wln(self, "    }");
    wln(self, "    rows[m].name = name; rows[m].n = n; rows[m].bytes = bytes;");
    wln(self, "    return m + 1;");
    wln(self, "}");
    wln(self, "static void __p_mp_print(const char* title, __p_mp_row* rows, int64_t m) {");
    wln(self, "    qsort(rows, (size_t)m, sizeof(__p_mp_row), __p_mp_cmp);");
    wln(self, "    fprintf(stderr, \"  by %s:\\n\", title);");
    wln(self, "    for (int64_t i = 0; i < m && i < 20; i++)");
    wln(self, "        fprintf(stderr, \"  %10lld bytes in %6lld allocation(s): %s\\n\", (long long)rows[i].bytes, (long long)rows[i].n, rows[i].name);");
    wln(self, "    if (m > 20) fprintf(stderr, \"  ... and %lld more\\n\", (long long)(m - 20));");
    wln(self, "}");
    wln(self, "static void __p_mp_report(void) {");
    wln(self, "    fflush(stdout);");
    wln(self, "    fprintf(stderr, \"fid --mem: %lld allocation(s), %lld bytes; %lld freed (%lld bytes); peak %lld bytes live\\n\",");
    wln(self, "            (long long)__p_mp_allocs, (long long)__p_mp_bytes, (long long)__p_mp_frees, (long long)__p_mp_freed, (long long)__p_mp_peak);");
    wln(self, "    __p_mp_row* rows = (__p_mp_row*)calloc((size_t)__p_mp_used + 1, sizeof(__p_mp_row));");
    wln(self, "    if (rows) {");
    wln(self, "        int64_t m = 0;");
    wln(self, "        for (int64_t i = 0; i < __P_MP_CAP; i++) {");
    wln(self, "            __p_mp_site* s = &__p_mp_tab[i];");
    wln(self, "            if (!s->n) continue;");
    wln(self, "            const char* nm = s->fn ? __p_fn_name(s->fn) : NULL;");
    wln(self, "            m = __p_mp_add(rows, m, nm ? nm : \"(no Fides frame)\", s->n, s->bytes);");
    wln(self, "        }");
    wln(self, "        __p_mp_print(\"function\", rows, m);");
    wln(self, "        m = 0;");
    wln(self, "        for (int64_t i = 0; i < __P_MP_CAP; i++) {");
    wln(self, "            __p_mp_site* s = &__p_mp_tab[i];");
    wln(self, "            if (s->n && s->at) m = __p_mp_add(rows, m, s->at, s->n, s->bytes);");
    wln(self, "        }");
    wln(self, "        if (m > 0) __p_mp_print(\"line\", rows, m);");
    wln(self, "        free(rows);");
    wln(self, "    }");
    wln(self, "    if (__p_mp_lost) fprintf(stderr, \"  (%lld bytes from places past the table's %d)\\n\", (long long)__p_mp_lost, __P_MP_CAP * 3 / 4);");
    // L7C: region usage, when a region's arena gave out any block
    wln(self, "    if (__p_mr_all_n > 0) {");
    wln(self, "        fprintf(stderr, \"fid --mem: regions: %lld region(s), %lld allocation(s), %lld bytes; peak %lld bytes live in regions\\n\",");
    wln(self, "                (long long)__p_mr_all_regions, (long long)__p_mr_all_n, (long long)__p_mr_all_bytes, (long long)__p_mr_peak);");
    wln(self, "        for (int64_t d = 1; d <= __P_MR_DEPTHS; d++) {");
    wln(self, "            if (!__p_mr_n[d]) continue;");
    wln(self, "            fprintf(stderr, \"  depth %lld%s: %lld region(s), %lld allocation(s), %lld bytes; largest region %lld bytes\\n\",");
    wln(self, "                    (long long)d, d == __P_MR_DEPTHS ? \" and deeper\" : \"\", (long long)__p_mr_regions[d], (long long)__p_mr_n[d], (long long)__p_mr_bytes[d], (long long)__p_mr_largest[d]);");
    wln(self, "        }");
    wln(self, "        __p_mp_row* rr = (__p_mp_row*)calloc((size_t)__p_mr_sites_used + 1, sizeof(__p_mp_row));");
    wln(self, "        if (rr) {");
    wln(self, "            int64_t m = 0;");
    wln(self, "            for (int64_t i = 0; i < __P_MR_SITES; i++) {");
    wln(self, "                __p_mp_site* s = &__p_mr_sites[i];");
    wln(self, "                if (!s->n) continue;");
    wln(self, "                const char* nm = s->fn ? __p_fn_name(s->fn) : NULL;");
    wln(self, "                m = __p_mp_add(rr, m, nm ? nm : \"(no Fides frame)\", s->n, s->bytes);");
    wln(self, "            }");
    wln(self, "            __p_mp_print(\"function, in regions\", rr, m);");
    wln(self, "            m = 0;");
    wln(self, "            for (int64_t i = 0; i < __P_MR_SITES; i++) {");
    wln(self, "                __p_mp_site* s = &__p_mr_sites[i];");
    wln(self, "                if (s->n && s->at) m = __p_mp_add(rr, m, s->at, s->n, s->bytes);");
    wln(self, "            }");
    wln(self, "            if (m > 0) __p_mp_print(\"line, in regions\", rr, m);");
    wln(self, "            free(rr);");
    wln(self, "        }");
    wln(self, "        if (__p_mr_lost) fprintf(stderr, \"  (%lld region bytes from places past the table's %d)\\n\", (long long)__p_mr_lost, __P_MR_SITES * 3 / 4);");
    wln(self, "    }");
    wln(self, "    __p_ms_write();");
    wln(self, "}");
    wln(self, "#endif");
}

fn emit_runtime_impl(self: &mut CCodeGen) -> void {
    // Rest of runtime implementation
    wln(self, "");
    wln(self, "// --- Runtime implementation ---");
    wln(self, "");
    // Vec runtime
    wln(self, "PVec* p_vec_new(void) {");
    wln(self, "    PVec* v = (PVec*)p_malloc(sizeof(PVec));");
    wln(self, "    v->data = NULL; v->len = 0; v->cap = 0; v->code = 0; v->tid = 0;");
    wln(self, "    return v;");
    wln(self, "}");
    wln(self, "");
    // BG40: push, set and insert go through the element code and the share
    // box as core's Vec does: they grew a word buffer and stored 8 bytes
    // whatever the element size (a heap overflow on a Vec<u8>), and took a
    // negative capacity (a shared buffer, -box-1) for a full one, freeing
    // data other Vecs hold. __p_vec_grow owns a shared buffer first (one
    // owner left: kept; more: copied), grows at the element size and keeps
    // the J8 wipe registry (a @zeroize Vec's new buffer).
    wln(self, "void p_vec_push(PVec* v, void* val) {");
    wln(self, "    if (!v) return;");
    wln(self, "    if (v->cap < 0 || v->len >= v->cap) __p_vec_grow((int64_t*)v);");
    wln(self, "    if (v->code) __p_vec_st((int64_t*)v, v->len, (int64_t)(intptr_t)val);");
    wln(self, "    else P_VSLOT(v, v->len) = (int64_t)(intptr_t)val;");
    wln(self, "    v->len++;");
    wln(self, "}");
    wln(self, "");
    wln(self, "void* p_vec_get(PVec* v, int64_t idx) {");
    // V1c: an index out of range panics, as core's Vec_get (§8.2)
    wln(self, "    if (!v) return NULL;");
    wln(self, "    if (idx < 0 || idx >= v->len) p_panic(\"Vec index out of bounds\");");
    wln(self, "    return P_VEC_AT(v, idx);");
    wln(self, "}");
    wln(self, "");
    wln(self, "void p_vec_set(PVec* v, int64_t idx, void* val) {");
    wln(self, "    if (!v || idx < 0 || idx >= v->len) return;");
    wln(self, "    if (v->cap < 0) __p_vec_grow((int64_t*)v);");
    wln(self, "    if (v->code) __p_vec_st((int64_t*)v, idx, (int64_t)(intptr_t)val);");
    wln(self, "    else P_VSLOT(v, idx) = (int64_t)(intptr_t)val;");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_vec_len(PVec* v) { return v ? v->len : 0; }");
    wln(self, "bool p_vec_is_empty(PVec* v) { return v ? v->len == 0 : true; }");
    wln(self, "void p_vec_clear(PVec* v) { if (v) v->len = 0; }");
    // BG120: pop goes through core's Vec_pop — a raw 8-byte slot store/read
    // drops an element taken at its size and, for a shared buffer, the
    // extra owner the caller gets (vec_sz_pop / vec_elem_dup there)
    wln(self, "int64_t p_vec_pop(PVec* v) {");
    wln(self, "    if (!v || v->len == 0) return 0;");
    wln(self, "    return Vec_pop(0, (int64_t)(intptr_t)v);");
    wln(self, "}");
    wln(self, "");
    // Map runtime (simple linear probe)
    wln(self, "PMap* p_map_new(void) {");
    wln(self, "    PMap* m = (PMap*)p_malloc(sizeof(PMap));");
    wln(self, "    m->keys = NULL; m->vals = NULL; m->len = 0; m->cap = 0;");
    wln(self, "    return m;");
    wln(self, "}");
    wln(self, "");
    wln(self, "void p_map_insert(PMap* m, const char* key, int64_t val) {");
    wln(self, "    if (!m || !key) return;");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) {");
    wln(self, "        if (strcmp(m->keys[i], key) == 0) { m->vals[i] = val; return; }");
    wln(self, "    }");
    wln(self, "    if (m->len >= m->cap) {");
    wln(self, "        m->cap = m->cap == 0 ? 8 : m->cap * 2;");
    wln(self, "        char** new_keys = (char**)p_malloc(m->cap * (int64_t)sizeof(char*));");
    wln(self, "        int64_t* new_vals = (int64_t*)p_malloc(m->cap * (int64_t)sizeof(int64_t));");
    wln(self, "        if (m->keys && m->len > 0) { memcpy(new_keys, m->keys, m->len * sizeof(char*)); memcpy(new_vals, m->vals, m->len * sizeof(int64_t)); }");
    wln(self, "        if (m->keys) { p_free(m->keys); }");
    wln(self, "        if (m->vals) { p_free(m->vals); }");
    wln(self, "        m->keys = new_keys;");
    wln(self, "        m->vals = new_vals;");
    wln(self, "    }");
    wln(self, "    { size_t klen = strlen(key); char* kcopy = (char*)p_malloc((int64_t)(klen + 1)); memcpy(kcopy, key, klen + 1); m->keys[m->len] = kcopy; }");
    wln(self, "    m->vals[m->len] = val;");
    wln(self, "    m->len++;");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_map_get(PMap* m, const char* key) {");
    wln(self, "    if (!m || !key) return 0;");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) {");
    wln(self, "        if (strcmp(m->keys[i], key) == 0) return m->vals[i];");
    wln(self, "    }");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "");
    wln(self, "bool p_map_contains(PMap* m, const char* key) {");
    wln(self, "    if (!m || !key) return false;");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) {");
    wln(self, "        if (strcmp(m->keys[i], key) == 0) return true;");
    wln(self, "    }");
    wln(self, "    return false;");
    wln(self, "}");
    wln(self, "");
    wln(self, "void p_map_remove(PMap* m, const char* key) {");
    wln(self, "    if (!m || !key) return;");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) {");
    wln(self, "        if (strcmp(m->keys[i], key) == 0) {");
    wln(self, "            free(m->keys[i]);");
    wln(self, "            m->keys[i] = m->keys[m->len-1];");
    wln(self, "            m->vals[i] = m->vals[m->len-1];");
    wln(self, "            m->len--;");
    wln(self, "            return;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_map_len(PMap* m) { return m ? m->len : 0; }");
    wln(self, "bool p_map_is_empty(PMap* m) { return m ? m->len == 0 : true; }");
    wln(self, "void p_map_clear(PMap* m) { if (m) m->len = 0; }");
    wln(self, "");
    wln(self, "// Phase 10B: p_map_keys returns a Fides Vec (i64 pointer)");
    wln(self, "int64_t p_map_keys(PMap* m) {");
    wln(self, "    PVec* v = p_vec_new();");
    wln(self, "    for (int64_t i = 0; i < m->len; i++)");
    wln(self, "        p_vec_push(v, (void*)m->keys[i]);");
    wln(self, "    return (int64_t)v;");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_map_values(PMap* m) {");
    wln(self, "    PVec* v = p_vec_new();");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) {");
    wln(self, "        p_vec_push(v, (void*)m->vals[i]);");
    wln(self, "    }");
    wln(self, "    return (int64_t)v;");
    wln(self, "}");
    wln(self, "");
    // String runtime
    wln(self, "/* Release D16: strings carry their length (p_slen): these keep zero bytes */");
    wln(self, "int64_t p_string_len(const char* s) { return p_slen(s); }");
    wln(self, "bool p_string_is_empty(const char* s) { return p_slen(s) == 0; }");
    wln(self, "/* the first match of the nl bytes at nd in the hl bytes at h, or NULL */");
    wln(self, "static const char* p_mem_find(const char* h, size_t hl, const char* nd, size_t nl) {");
    wln(self, "    if (nl == 0) return h;");
    wln(self, "    if (nl > hl) return NULL;");
    wln(self, "    for (size_t i = 0; i + nl <= hl; i++) if (h[i] == nd[0] && memcmp(h + i, nd, nl) == 0) return h + i;");
    wln(self, "    return NULL;");
    wln(self, "}");
    wln(self, "/* a counted string of the n bytes at s */");
    wln(self, "static char* p_str_from_bytes_c(const char* s, size_t n) { char* r = p_str_alloc_c((int64_t)n); if (n) memcpy(r, s, n); return r; }");
    wln(self, "");
    wln(self, "static char* p_string_push_str__raw(const char* s, const char* other);");
    wln(self, "char* p_string_push_str(const char* s, const char* other) { return p_str_own_c(p_string_push_str__raw(s, other)); }");
    wln(self, "static char* p_string_push_str__raw(const char* s, const char* other) {");
    wln(self, "    size_t la = (size_t)p_slen(s), lb = (size_t)p_slen(other);");
    wln(self, "    char* result = p_str_alloc_c((int64_t)(la + lb));");
    wln(self, "    if (la) memcpy(result, s, la);");
    wln(self, "    if (lb) memcpy(result + la, other, lb);");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "");
    wln(self, "static char* p_string_from__raw(const char* s);");
    wln(self, "char* p_string_from(const char* s) { return p_str_own_c(p_string_from__raw(s)); }");
    wln(self, "static char* p_string_from__raw(const char* s) {");
    wln(self, "    if (!s) return p_str_alloc_c(0);");
    wln(self, "    return p_str_from_bytes_c(s, (size_t)p_slen(s));");
    wln(self, "}");
    wln(self, "");
    wln(self, "static char* p_string_slice__raw(const char* s, int64_t start, int64_t end);");
    wln(self, "char* p_string_slice(const char* s, int64_t start, int64_t end) { return p_str_own_c(p_string_slice__raw(s, start, end)); }");
    wln(self, "static char* p_string_slice__raw(const char* s, int64_t start, int64_t end) {");
    wln(self, "    if (!s) { char* r = (char*)p_malloc(1); r[0] = 0; return r; }");
    wln(self, "    int64_t len = p_slen(s);");
    wln(self, "    if (start < 0) start = 0;");
    wln(self, "    if (end > len) end = len;");
    wln(self, "    if (start > end) start = end;");
    wln(self, "    return p_str_from_bytes_c(s + start, (size_t)(end - start));");
    wln(self, "}");
    wln(self, "");
    wln(self, "static char* p_to_str__raw(int64_t val);");
    wln(self, "char* p_to_str(int64_t val) { return p_str_own_c(p_to_str__raw(val)); }");
    wln(self, "static char* p_to_str__raw(int64_t val) {");
    wln(self, "    char* buf = (char*)p_malloc(32);");
    wln(self, "    snprintf(buf, 32, \"%lld\", (long long)val);");
    wln(self, "    return buf;");
    wln(self, "}");
    wln(self, "");
    wln(self, "char* p_str_concat(const char* a, const char* b) {");
    wln(self, "    int64_t la = p_slen(a), lb = p_slen(b);");
    wln(self, "    char* result = p_str_alloc_c(la + lb);");
    wln(self, "    memcpy(result, a, (size_t)la);");
    wln(self, "    memcpy(result + la, b, (size_t)lb);");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "");
    // Efficient join: calculates total length first, allocates once, copies.
    // parts is a Vec<str> (PVec of char* pointers).
    wln(self, "static char* p_str_join_n__raw(PVec* parts);");
    wln(self, "char* p_str_join_n(PVec* parts) { return p_str_own_c(p_str_join_n__raw(parts)); }");
    wln(self, "static char* p_str_join_n__raw(PVec* parts) {");
    wln(self, "    size_t total = 0;");
    wln(self, "    for (int64_t i = 0; i < parts->len; i++) total += (size_t)p_slen((char*)(intptr_t)P_VSLOT(parts, i));");
    wln(self, "    char* result = p_str_alloc_c((int64_t)total);");
    wln(self, "    size_t at = 0;");
    wln(self, "    for (int64_t i = 0; i < parts->len; i++) {");
    wln(self, "        const char* q = (char*)(intptr_t)P_VSLOT(parts, i);");
    wln(self, "        size_t l = (size_t)p_slen(q);");
    wln(self, "        if (l) memcpy(result + at, q, l);");
    wln(self, "        at += l;");
    wln(self, "    }");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "");
    // Mutable string builder - avoids O(n^2) memory from repeated str_concat.
    // Uses realloc-based growth (via p_malloc_persistent) so old buffers are freed.
    wln(self, "typedef struct { char* buf; int64_t len; int64_t cap; } PStrBuilder;");
    wln(self, "int64_t p_sb_new(void) {");
    wln(self, "    PStrBuilder* sb = (PStrBuilder*)p_malloc_persistent(sizeof(PStrBuilder));");
    wln(self, "    sb->cap = 4096;");
    wln(self, "    sb->len = 0;");
    wln(self, "    sb->buf = (char*)p_malloc_persistent(sb->cap);");
    wln(self, "    sb->buf[0] = 0;");
    wln(self, "    return (int64_t)sb;");
    wln(self, "}");
    wln(self, "void p_sb_append(int64_t sbv, const char* s) {");
    wln(self, "    PStrBuilder* sb = (PStrBuilder*)sbv;");
    wln(self, "    int64_t slen = p_slen(s);");
    wln(self, "    if (sb->len + slen + 1 > sb->cap) {");
    wln(self, "        while (sb->len + slen + 1 > sb->cap) sb->cap *= 2;");
    wln(self, "        char* nb = (char*)p_malloc_persistent(sb->cap);");
    wln(self, "        memcpy(nb, sb->buf, sb->len);");
    wln(self, "        nb[sb->len] = 0;");
    wln(self, "        sb->buf = nb; /* old buffer leaked in persistent pool - acceptable */");
    wln(self, "    }");
    wln(self, "    memcpy(sb->buf + sb->len, s, slen);");
    wln(self, "    sb->len += slen;");
    wln(self, "    sb->buf[sb->len] = 0;");
    wln(self, "}");
    wln(self, "static char* p_sb_to_str__raw(int64_t sbv);");
    wln(self, "char* p_sb_to_str(int64_t sbv) { return p_str_own_c(p_sb_to_str__raw(sbv)); }");
    wln(self, "static char* p_sb_to_str__raw(int64_t sbv) {");
    wln(self, "    PStrBuilder* sb = (PStrBuilder*)sbv;");
    wln(self, "    return p_str_from_bytes_c(sb->buf, (size_t)sb->len);");
    wln(self, "}");
    wln(self, "");
    // One write per print: stdout is unbuffered, and printf then writes each
    // byte on its own on Windows (a 2 MB string took 8 seconds).
    wln(self, "void p_print(int64_t val) { char b[32]; int n = snprintf(b, sizeof b, \"%lld\", (long long)val); fwrite(b, 1, (size_t)n, stdout); }");
    wln(self, "void p_print_str(const char* s) { fwrite(s, 1, (size_t)p_slen(s), stdout); }");
    wln(self, "void p_eprint_str(const char* s) { fwrite(s, 1, (size_t)p_slen(s), stderr); fflush(stderr); }");
    wln(self, "void p_flush_stdout(void) { fflush(stdout); }");
    wln(self, "void p_print_int(int64_t val) { char b[32]; int n = snprintf(b, sizeof b, \"%lld\", (long long)val); fwrite(b, 1, (size_t)n, stdout); }");
    wln(self, "void p_print_bool(bool val) { if (val) fwrite(\"true\", 1, 4, stdout); else fwrite(\"false\", 1, 5, stdout); }");
    wln(self, "void p_print_float(double val) { char* _s = p_to_str_float(val); fwrite(_s, 1, strlen(_s), stdout); p_str_free_c(_s); }");
    wln(self, "void p_print_newline(void) { fwrite(\"\\n\", 1, 1, stdout); }");
    wln(self, "/* Crashes, stack overflow and panic traces. Nothing is recorded per call:");
    wln(self, "   a trace walks the machine stack and names each frame that starts at a");
    wln(self, "   Fides function; a stack overflow hits the OS guard page, and its handler");
    wln(self, "   runs on reserved stack. */");
    wln(self, "typedef struct { const void* addr; const char* name; } __p_fn_entry;");
    wln(self, "extern const __p_fn_entry __p_fns[];");
    wln(self, "extern const int __p_fn_count;");
    // CO5: `fid profile --pid` finds the table of a running program through
    // this (two magic words, then its own address), defined after __p_fns
    wln(self, "typedef struct { uint64_t magic[2]; const void* self; const __p_fn_entry* fns; const int* count; } __p_prof_anchor_t;");
    wln(self, "extern const __p_prof_anchor_t __p_prof_anchor;");
    wln(self, "static __p_fn_entry* __p_fns_sorted = NULL;");
    // VF14 (ThreadSanitizer, Nov 17: "signal-unsafe call inside of a
    // signal" in test_std_hpet, test_std_netcode, test_std_wav): a crash
    // handler naming frames before anything sorted the table called malloc
    // and qsort inside the signal handler (a deadlock when the fault was in
    // malloc). The handlers set this first; the table is then searched
    // as it is, with no allocation.
    wln(self, "static volatile int __p_fn_linear = 0;");
    wln(self, "static int __p_fn_cmp(const void* a, const void* b) {");
    wln(self, "    uintptr_t x = (uintptr_t)((const __p_fn_entry*)a)->addr, y = (uintptr_t)((const __p_fn_entry*)b)->addr;");
    wln(self, "    return x < y ? -1 : x > y;");
    wln(self, "}");
    wln(self, "static const char* __p_fn_name(uintptr_t start) {");
    // CO5: a read the C compiler keeps, so the linker keeps the anchor
    wln(self, "    if (!*(const volatile uint64_t*)&__p_prof_anchor.magic[0]) return NULL;");
    wln(self, "    if (!__p_fns_sorted && __p_fn_linear) {");
    wln(self, "        for (int i = 0; i < __p_fn_count; i++) if ((uintptr_t)__p_fns[i].addr == start) return __p_fns[i].name;");
    wln(self, "        return NULL;");
    wln(self, "    }");
    wln(self, "    if (!__p_fns_sorted) {");
    wln(self, "        __p_fns_sorted = (__p_fn_entry*)malloc(sizeof(__p_fn_entry) * (size_t)(__p_fn_count + 1));");
    wln(self, "        if (!__p_fns_sorted) return NULL;");
    wln(self, "        memcpy(__p_fns_sorted, __p_fns, sizeof(__p_fn_entry) * (size_t)__p_fn_count);");
    wln(self, "        qsort(__p_fns_sorted, (size_t)__p_fn_count, sizeof(__p_fn_entry), __p_fn_cmp);");
    wln(self, "    }");
    wln(self, "    int lo = 0, hi = __p_fn_count - 1;");
    wln(self, "    while (lo <= hi) {");
    wln(self, "        int mid = (lo + hi) / 2;");
    wln(self, "        uintptr_t a = (uintptr_t)__p_fns_sorted[mid].addr;");
    wln(self, "        if (a == start) return __p_fns_sorted[mid].name;");
    wln(self, "        if (a < start) lo = mid + 1; else hi = mid - 1;");
    wln(self, "    }");
    wln(self, "    return NULL;");
    wln(self, "}");
    // CI6: every capability until fides_call narrows them
    wln(self, "P_THREAD_LOCAL uint64_t __p_caps = ~(uint64_t)0;");
    wln(self, "#ifdef P_MN");
    wln(self, "/* RT10: this thread's capabilities, read anew (the task may have moved) */");
    wln(self, "P_MN_NOINLINE uint64_t __p_caps_now(void) { uint64_t c = __p_caps; __asm__ volatile(\"\" ::: \"memory\"); return c; }");
    wln(self, "#endif");
    emit_debug_frames_impl(self);
    wln(self, "#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__)) && !defined(__TINYC__)");
    wln(self, "#include <windows.h>");
    wln(self, "/* Where the function of each frame starts, from the unwind tables. ctx: a");
    wln(self, "   CONTEXT to start from (exact: its pc is the faulting one), or NULL. */");
    wln(self, "static int __p_frames(void* ctx, int exact, uintptr_t* out, int max) {");
    wln(self, "    CONTEXT c;");
    wln(self, "    if (ctx) c = *(CONTEXT*)ctx; else { RtlCaptureContext(&c); exact = 0; }");
    wln(self, "    int k = 0;");
    wln(self, "    for (int i = 0; i < 256 && k < max && c.Rip; i++) {");
    wln(self, "        DWORD64 pc = (i == 0 && exact) ? c.Rip : c.Rip - 1;");
    wln(self, "        DWORD64 base = 0; PVOID hd = NULL; DWORD64 est = 0;");
    wln(self, "        PRUNTIME_FUNCTION rf = RtlLookupFunctionEntry(pc, &base, NULL);");
    wln(self, "        if (!rf) { c.Rip = *(DWORD64*)c.Rsp; c.Rsp += 8; continue; }");
    wln(self, "        out[k++] = (uintptr_t)(base + rf->BeginAddress);");
    wln(self, "        RtlVirtualUnwind(0, base, pc, rf, &c, &hd, &est, NULL);");
    wln(self, "    }");
    wln(self, "    return k;");
    wln(self, "}");
    // PL3: Windows ARM64, the same walk over its unwind tables: a function
    // without an entry is a leaf, whose caller is in the link register
    wln(self, "#elif defined(_WIN32) && (defined(_M_ARM64) || defined(__aarch64__)) && !defined(__TINYC__)");
    wln(self, "#include <windows.h>");
    wln(self, "static int __p_frames(void* ctx, int exact, uintptr_t* out, int max) {");
    wln(self, "    CONTEXT c;");
    wln(self, "    if (ctx) c = *(CONTEXT*)ctx; else { RtlCaptureContext(&c); exact = 0; }");
    wln(self, "    int k = 0;");
    wln(self, "    for (int i = 0; i < 256 && k < max && c.Pc; i++) {");
    wln(self, "        DWORD64 pc = (i == 0 && exact) ? c.Pc : c.Pc - 4;");
    wln(self, "        DWORD64 base = 0; PVOID hd = NULL; DWORD64 est = 0;");
    wln(self, "        PRUNTIME_FUNCTION rf = RtlLookupFunctionEntry(pc, &base, NULL);");
    wln(self, "        if (!rf) { if (c.Pc == c.Lr) break; c.Pc = c.Lr; continue; }");
    wln(self, "        out[k++] = (uintptr_t)(base + rf->BeginAddress);");
    wln(self, "        RtlVirtualUnwind(0, base, pc, rf, &c, &hd, &est, NULL);");
    wln(self, "    }");
    wln(self, "    return k;");
    wln(self, "}");
    wln(self, "#elif (defined(__GNUC__) || defined(__clang__)) && !defined(__TINYC__) && !defined(_WIN32) && !defined(__wasi__)");
    wln(self, "#include <unwind.h>");
    wln(self, "typedef struct { uintptr_t* out; int n; int max; } __p_unw;");
    wln(self, "static _Unwind_Reason_Code __p_unw_step(struct _Unwind_Context* uc, void* arg) {");
    wln(self, "    __p_unw* u = (__p_unw*)arg;");
    wln(self, "    if (u->n >= u->max) return _URC_END_OF_STACK;");
    wln(self, "    uintptr_t s = (uintptr_t)_Unwind_GetRegionStart(uc);");
    wln(self, "    if (s) u->out[u->n++] = s;");
    wln(self, "    return _URC_NO_REASON;");
    wln(self, "}");
    wln(self, "static int __p_frames(void* ctx, int exact, uintptr_t* out, int max) {");
    wln(self, "    (void)ctx; (void)exact;");
    wln(self, "    __p_unw u = { out, 0, max };");
    wln(self, "    _Unwind_Backtrace(__p_unw_step, &u);");
    wln(self, "    return u.n;");
    wln(self, "}");
    wln(self, "#else");
    wln(self, "static int __p_frames(void* ctx, int exact, uintptr_t* out, int max) { (void)ctx; (void)exact; (void)out; (void)max; return 0; }");
    wln(self, "#endif");
    wln(self, "/* CA9: set by the task runtime; prints the chain of tasks awaiting the");
    wln(self, "   running one after its trace */");
    wln(self, "void (*__p_trace_tasks)(FILE* out) = NULL;");
    // CO9: the trace goes to stderr, and again into a crash report
    wln(self, "static void __p_print_trace_to(FILE* out, void* ctx, int exact, int head) {");
    wln(self, "    uintptr_t f[64];");
    wln(self, "    const char* names[64];");
    wln(self, "    int n = __p_frames(ctx, exact, f, 64), m = 0;");
    wln(self, "    for (int i = 0; i < n; i++) {");
    wln(self, "        const char* name = __p_fn_name(f[i]);");
    wln(self, "        if (name) names[m++] = name;");
    wln(self, "    }");
    wln(self, "    if (m == 0) { if (__p_trace_tasks) __p_trace_tasks(out); return; }");
    wln(self, "    if (head) fprintf(out, \"stack trace:\\n\");");
    wln(self, "    fprintf(out, \"    - %s\\n\", names[0]);");
    wln(self, "    for (int i = 1; i < m; ) {");
    wln(self, "        int j = i + 1;");
    wln(self, "        while (j < m && strcmp(names[j], names[i]) == 0) j++;");
    wln(self, "        if (j - i > 1) fprintf(out, \"    -| called from %s (%d times)\\n\", names[i], j - i);");
    wln(self, "        else fprintf(out, \"    -| called from %s\\n\", names[i]);");
    wln(self, "        i = j;");
    wln(self, "    }");
    wln(self, "    if (__p_trace_tasks) __p_trace_tasks(out);");
    wln(self, "}");
    wln(self, "void __p_print_trace_ctx(void* ctx, int exact) { __p_print_trace_to(stderr, ctx, exact, 1); }");
    // CO9: with FID_CRASH_REPORT=<file>, a panic or a crash also writes a
    // report there (the build, the program, the message, the trace), which
    // `fid inspect <file>` prints (main.fd inspect_crash_report)
    // N12: the version `fid version` prints (build_info.fd fid_version)
    var build_version: str = "fid " + fid_version();
    if str_len(fid_build_commit()) > 0 {
        build_version = build_version + ", commit " + fid_build_commit();
    }
    if str_len(fid_build_date()) > 0 {
        build_version = build_version + ", built " + fid_build_date();
    }
    wln(self, "static const char __p_build_version[] = \"" + build_version + " (C)\";");
    wln(self, "void __p_crash_report(const char* msg, void* ctx, int exact) {");
    wln(self, "    const char* path = getenv(\"FID_CRASH_REPORT\");");
    wln(self, "    if (!path || !*path) return;");
    wln(self, "    FILE* f = fopen(path, \"w\");");
    wln(self, "    if (!f) { fprintf(stderr, \"crash report: cannot write %s\\n\", path); return; }");
    wln(self, "    fprintf(f, \"fid-crash-report 1\\nversion: %s\\nprogram: %s\\n\", __p_build_version, (__p_argv && __p_argc > 0) ? __p_argv[0] : \"(unknown)\");");
    wln(self, "    const char* m = msg ? msg : \"\";");
    wln(self, "    for (;;) {");
    wln(self, "        const char* nl = strchr(m, '\\n');");
    wln(self, "        int len = nl ? (int)(nl - m) : (int)strlen(m);");
    wln(self, "        if (len > 0 && m[len - 1] == '\\r') len--;");
    wln(self, "        fprintf(f, \"message: %.*s\\n\", len, m);");
    wln(self, "        if (!nl) break;");
    wln(self, "        m = nl + 1;");
    wln(self, "    }");
    wln(self, "    fprintf(f, \"trace:\\n\");");
    wln(self, "    __p_print_trace_to(f, ctx, exact, 0);");
    wln(self, "    fprintf(f, \"end\\n\");");
    wln(self, "    fclose(f);");
    wln(self, "    fprintf(stderr, \"crash report: %s (read it with: fid inspect %s)\\n\", path, path);");
    wln(self, "}");
    wln(self, "#ifdef _WIN32");
    wln(self, "void __p_thread_guard_init(void) {");
    wln(self, "#if !defined(__TINYC__)");
    wln(self, "    ULONG g = 64 * 1024;");
    wln(self, "    SetThreadStackGuarantee(&g);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "void __p_thread_guard_done(void) {}");
    wln(self, "LONG WINAPI __p_crash_handler(PEXCEPTION_POINTERS ep) {");
    wln(self, "    DWORD code = ep->ExceptionRecord->ExceptionCode;");
    wln(self, "    char why[128];");
    // frames are named without sorting (an allocation) in the handler:
    // the fault may be inside the heap
    wln(self, "    if (code == EXCEPTION_STACK_OVERFLOW || code == EXCEPTION_ACCESS_VIOLATION || code == EXCEPTION_ILLEGAL_INSTRUCTION) __p_fn_linear = 1;");
    wln(self, "    if (code == EXCEPTION_STACK_OVERFLOW) {");
    wln(self, "        snprintf(why, sizeof why, \"Stack overflow\");");
    wln(self, "        fprintf(stderr, \"Panic: %s\\n\", why);");
    wln(self, "    } else if (code == EXCEPTION_ACCESS_VIOLATION) {");
    wln(self, "        snprintf(why, sizeof why, \"Invalid memory access (null or dangling pointer) at 0x%llX\", (unsigned long long)ep->ExceptionRecord->ExceptionInformation[1]);");
    wln(self, "        fprintf(stderr, \"Panic: %s\\n\", why);");
    wln(self, "#ifdef P_DEBUG_FRAMES");
    wln(self, "        __p_dbg_print_frame();");
    wln(self, "#endif");
    wln(self, "    } else if (code == EXCEPTION_ILLEGAL_INSTRUCTION) {");
    wln(self, "        snprintf(why, sizeof why, \"Illegal instruction\");");
    wln(self, "        fprintf(stderr, \"Panic: %s\\n\", why);");
    wln(self, "    } else {");
    wln(self, "        return EXCEPTION_CONTINUE_SEARCH;");
    wln(self, "    }");
    wln(self, "    __p_print_trace_ctx(ep->ContextRecord, 1);");
    wln(self, "    __p_crash_report(why, ep->ContextRecord, 1);");
    wln(self, "    fflush(stderr);");
    wln(self, "    fflush(stdout);");
    wln(self, "    _exit(1);");
    wln(self, "    return EXCEPTION_CONTINUE_SEARCH;");
    wln(self, "}");
    wln(self, "void __p_install_crash_handlers(void) {");
    wln(self, "    AddVectoredExceptionHandler(1, __p_crash_handler);");
    wln(self, "    __p_thread_guard_init();");
    wln(self, "}");
    wln(self, "#elif defined(__wasi__)");
    wln(self, "void __p_thread_guard_init(void) {}");
    wln(self, "void __p_thread_guard_done(void) {}");
    wln(self, "void __p_install_crash_handlers(void) {}");
    wln(self, "#else");
    wln(self, "#include <signal.h>");
    wln(self, "#ifdef __linux__");
    wln(self, "#include <sys/prctl.h>");
    wln(self, "#endif");
    wln(self, "static P_THREAD_LOCAL char* __p_stack_top;");
    wln(self, "/* The low end of the running task's stack (its guard page): a fault there");
    wln(self, "   is that task's stack overflow */");
    wln(self, "static P_THREAD_LOCAL char* __p_task_guard;");
    wln(self, "static void __p_sig_handler(int sig, siginfo_t* si, void* uc) {");
    wln(self, "    (void)uc;");
    // no malloc/qsort inside the handler (VF14: TSan's signal-unsafe call)
    wln(self, "    __p_fn_linear = 1;");
    wln(self, "    const char* name = sig == SIGSEGV ? \"SIGSEGV\" : sig == SIGBUS ? \"SIGBUS\" : sig == SIGABRT ? \"SIGABRT\" : sig == SIGFPE ? \"SIGFPE\" : \"UNKNOWN\";");
    wln(self, "    char* a = (char*)si->si_addr;");
    wln(self, "    char why[128];");
    wln(self, "    if ((sig == SIGSEGV || sig == SIGBUS) && ((__p_stack_top && a < __p_stack_top && a >= __p_stack_top - (64 << 20))");
    wln(self, "        || (__p_task_guard && a >= __p_task_guard && a < __p_task_guard + 65536)))");
    wln(self, "        snprintf(why, sizeof why, \"Stack overflow\");");
    wln(self, "    else if (sig == SIGSEGV || sig == SIGBUS) {");
    wln(self, "        snprintf(why, sizeof why, \"Invalid memory access (null or dangling pointer) at %p\", (void*)a);");
    wln(self, "    }");
    wln(self, "    else");
    wln(self, "        snprintf(why, sizeof why, \"signal %d (%s)\", sig, name);");
    wln(self, "    fprintf(stderr, \"Panic: %s\\n\", why);");
    wln(self, "#ifdef P_DEBUG_FRAMES");
    wln(self, "    if ((sig == SIGSEGV || sig == SIGBUS) && strncmp(why, \"Stack\", 5) != 0) __p_dbg_print_frame();");
    wln(self, "#endif");
    wln(self, "    __p_print_trace_ctx(NULL, 0);");
    wln(self, "    __p_crash_report(why, NULL, 0);");
    wln(self, "    fflush(stderr);");
    wln(self, "    fflush(stdout);");
    wln(self, "    _exit(1);");
    wln(self, "}");
    wln(self, "/* Each thread: a reserved stack for the handler, so it runs on overflow. */");
    wln(self, "void __p_thread_guard_init(void) {");
    wln(self, "    char here;");
    wln(self, "    __p_stack_top = &here;");
    wln(self, "    stack_t ss;");
    wln(self, "    memset(&ss, 0, sizeof ss);");
    wln(self, "    ss.ss_sp = malloc(64 * 1024);");
    wln(self, "    ss.ss_size = 64 * 1024;");
    wln(self, "    if (ss.ss_sp) sigaltstack(&ss, NULL);");
    wln(self, "}");
    wln(self, "void __p_thread_guard_done(void) {");
    wln(self, "    stack_t ss, old;");
    wln(self, "    memset(&ss, 0, sizeof ss);");
    wln(self, "    ss.ss_flags = SS_DISABLE;");
    wln(self, "    if (sigaltstack(&ss, &old) == 0 && old.ss_sp) free(old.ss_sp);");
    wln(self, "}");
    wln(self, "void __p_install_crash_handlers(void) {");
    wln(self, "    struct sigaction sa;");
    wln(self, "    memset(&sa, 0, sizeof sa);");
    wln(self, "    sa.sa_sigaction = __p_sig_handler;");
    wln(self, "    sa.sa_flags = SA_SIGINFO | SA_ONSTACK;");
    wln(self, "    sigemptyset(&sa.sa_mask);");
    wln(self, "    sigaction(SIGSEGV, &sa, NULL);");
    wln(self, "    sigaction(SIGBUS, &sa, NULL);");
    wln(self, "    sigaction(SIGABRT, &sa, NULL);");
    wln(self, "    sigaction(SIGFPE, &sa, NULL);");
    wln(self, "    __p_thread_guard_init();");
    // CO5: under Yama ptrace_scope 1 only an ancestor may attach;
    // FID_PROF_ATTACH=1 lets `fid profile --pid` (any process of the user)
    wln(self, "#if defined(__linux__) && defined(PR_SET_PTRACER)");
    wln(self, "    { const char* pa = getenv(\"FID_PROF_ATTACH\"); if (pa && pa[0] == '1') prctl(PR_SET_PTRACER, PR_SET_PTRACER_ANY, 0, 0, 0); }");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "#ifdef P_PROFILE");
    wln(self, "/* Sampling profiler (fid profile): the call stack every millisecond, written");
    wln(self, "   at exit as collapsed stacks (\"main;f;g 1\"), which flamegraph tools read. */");
    wln(self, "#define P_PROF_DEPTH 64");
    wln(self, "#define P_PROF_MAX 100000");
    wln(self, "static uintptr_t* __p_prof_buf;");
    wln(self, "static volatile long __p_prof_n;");
    wln(self, "static volatile int __p_prof_on;");
    wln(self, "static void __p_prof_record(uintptr_t* f, int n) {");
    wln(self, "    long i = __p_prof_n;");
    wln(self, "    if (i >= P_PROF_MAX) return;");
    wln(self, "    uintptr_t* row = __p_prof_buf + i * P_PROF_DEPTH;");
    wln(self, "    for (int k = 0; k < P_PROF_DEPTH; k++) row[k] = k < n ? f[k] : 0;");
    wln(self, "    __p_prof_n = i + 1;");
    wln(self, "}");
    wln(self, "static void __p_prof_dump(void) {");
    wln(self, "    __p_prof_on = 0;");
    wln(self, "    const char* path = getenv(\"FIDES_PROFILE_OUT\");");
    wln(self, "    if (!path || !*path) path = \"fides-profile.folded\";");
    wln(self, "    FILE* out = fopen(path, \"w\");");
    wln(self, "    if (!out) return;");
    wln(self, "    for (long i = 0; i < __p_prof_n; i++) {");
    wln(self, "        uintptr_t* row = __p_prof_buf + i * P_PROF_DEPTH;");
    wln(self, "        const char* names[P_PROF_DEPTH];");
    wln(self, "        int m = 0;");
    wln(self, "        for (int k = 0; k < P_PROF_DEPTH && row[k]; k++) {");
    wln(self, "            const char* nm = __p_fn_name(row[k]);");
    wln(self, "            if (nm) names[m++] = nm;");
    wln(self, "        }");
    wln(self, "        if (m == 0) continue;");
    wln(self, "        for (int k = m - 1; k >= 0; k--) fprintf(out, k == m - 1 ? \"%s\" : \";%s\", names[k]);");
    wln(self, "        fprintf(out, \" 1\\n\");");
    wln(self, "    }");
    wln(self, "    fclose(out);");
    wln(self, "}");
    // PL3: also Windows ARM64, whose __p_frames walks an ARM64 CONTEXT
    wln(self, "#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__) || defined(_M_ARM64) || defined(__aarch64__)) && !defined(__TINYC__)");
    wln(self, "static HANDLE __p_prof_target;");
    wln(self, "static DWORD WINAPI __p_prof_loop(LPVOID a) {");
    wln(self, "    (void)a;");
    wln(self, "    /* Sleep(1) sleeps a whole 15.6 ms tick: wait on the performance counter */");
    wln(self, "    LARGE_INTEGER fr, t0, t1;");
    wln(self, "    QueryPerformanceFrequency(&fr);");
    wln(self, "    while (__p_prof_on) {");
    wln(self, "        QueryPerformanceCounter(&t0);");
    wln(self, "        do { Sleep(0); QueryPerformanceCounter(&t1); } while ((t1.QuadPart - t0.QuadPart) * 1000 < fr.QuadPart);");
    wln(self, "        if (SuspendThread(__p_prof_target) == (DWORD)-1) break;");
    wln(self, "        CONTEXT c;");
    wln(self, "        memset(&c, 0, sizeof c);");
    wln(self, "        c.ContextFlags = CONTEXT_FULL;");
    wln(self, "        if (GetThreadContext(__p_prof_target, &c)) {");
    wln(self, "            uintptr_t f[P_PROF_DEPTH];");
    wln(self, "            __p_prof_record(f, __p_frames(&c, 1, f, P_PROF_DEPTH));");
    wln(self, "        }");
    wln(self, "        ResumeThread(__p_prof_target);");
    wln(self, "    }");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "void __p_profile_start(void) {");
    wln(self, "    __p_prof_buf = (uintptr_t*)malloc(sizeof(uintptr_t) * P_PROF_DEPTH * P_PROF_MAX);");
    wln(self, "    if (!__p_prof_buf) return;");
    wln(self, "    DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &__p_prof_target, 0, FALSE, DUPLICATE_SAME_ACCESS);");
    wln(self, "    __p_prof_on = 1;");
    wln(self, "    atexit(__p_prof_dump);");
    wln(self, "    CreateThread(NULL, 0, __p_prof_loop, NULL, 0, NULL);");
    wln(self, "}");
    wln(self, "#elif !defined(_WIN32) && (defined(__GNUC__) || defined(__clang__)) && !defined(__TINYC__)");
    wln(self, "#include <sys/time.h>");
    wln(self, "static void __p_prof_tick(int sig) {");
    wln(self, "    (void)sig;");
    wln(self, "    if (!__p_prof_on) return;");
    wln(self, "    uintptr_t f[P_PROF_DEPTH];");
    wln(self, "    __p_prof_record(f, __p_frames(NULL, 0, f, P_PROF_DEPTH));");
    wln(self, "}");
    wln(self, "void __p_profile_start(void) {");
    wln(self, "    __p_prof_buf = (uintptr_t*)malloc(sizeof(uintptr_t) * P_PROF_DEPTH * P_PROF_MAX);");
    wln(self, "    if (!__p_prof_buf) return;");
    wln(self, "    __p_prof_on = 1;");
    wln(self, "    atexit(__p_prof_dump);");
    wln(self, "    struct sigaction sa;");
    wln(self, "    memset(&sa, 0, sizeof sa);");
    wln(self, "    sa.sa_handler = __p_prof_tick;");
    wln(self, "    sa.sa_flags = SA_RESTART;");
    wln(self, "    sigemptyset(&sa.sa_mask);");
    wln(self, "    sigaction(SIGPROF, &sa, NULL);");
    wln(self, "    struct itimerval t;");
    wln(self, "    t.it_interval.tv_sec = 0;");
    wln(self, "    t.it_interval.tv_usec = 1000;");
    wln(self, "    t.it_value = t.it_interval;");
    wln(self, "    setitimer(ITIMER_PROF, &t, NULL);");
    wln(self, "}");
    wln(self, "#else");
    wln(self, "void __p_profile_start(void) {}");
    wln(self, "#endif");
    wln(self, "#endif");
    emit_prof_api_runtime(self);
    wln(self, "void p_panic(const char* msg) {");
    wln(self, "#ifdef P_LIB");
    // CI6: a panic inside fides_call goes back to its caller, not exit()
    wln(self, "    if (__p_embed_jb) { snprintf(__p_embed_err, sizeof __p_embed_err, \"panic: %s\", msg ? msg : \"\"); fflush(stdout); longjmp(*__p_embed_jb, 1); }");
    wln(self, "#endif");
    wln(self, "    fprintf(stderr, \"Panic: %s\\n\", msg);");
    wln(self, "#ifdef P_DEBUG_FRAMES");
    wln(self, "    __p_dbg_print_frame();");
    wln(self, "#endif");
    wln(self, "    __p_print_trace_ctx(NULL, 0);");
    wln(self, "    __p_crash_report(msg, NULL, 0);");
    wln(self, "    fflush(stdout);");
    wln(self, "    exit(1);");
    wln(self, "}");
    // roadmap P12: FID_MEM_LIMIT / FID_CPU_LIMIT (the allocator below
    // counts its live bytes against the first)
    emit_limits_runtime(self);
    emit_region_impl(self);
    // RT7: pages of the operating system's own (chunks, large blocks)
    emit_os_mem_runtime(self);
    // Chunk-based arena: linked list of fixed-size blocks.
    // New chunks are added to the chain when the current chunk is full.
    // This NEVER invalidates existing pointers (unlike realloc-based growth).
    // A chunk is pages of its own (RT7), so an empty one can be given back.
    wln(self, "#define __P_ARENA_CHUNK_SIZE (4*1024*1024)");
    // RT8: a chunk is __P_ARENA_CHUNK_SIZE bytes at an address that is a
    // multiple of its size, so the chunk of a class block is the block's
    // address with its low bits cleared (__P_CHUNK_OF); this header is the
    // chunk's first 64 bytes and its blocks start at base, after it (string
    // checks read the two words before a string: still the chunk's). owner is
    // the heap whose lists the chunk's blocks go back to when they are freed
    // (owner return, RT8): set when the chunk is made, changed only when a
    // trim takes over the heap of a thread that ended (__p_heap_merge_pool).
    // fb: the trim's count of the chunk's free bytes. raw: what to give back
    // without the OS's pages (calloc's block).
    wln(self, "typedef struct __p_heap __p_heap;");
    wln(self, "typedef struct __p_arena_chunk { char* base; char* ptr; char* end; struct __p_arena_chunk* next; __p_heap* owner; void* raw; int64_t fb; int64_t pad; } __p_arena_chunk;");
    wln(self, "#define __P_CHUNK_OF(p) ((__p_arena_chunk*)((uintptr_t)(p) & ~(uintptr_t)(__P_ARENA_CHUNK_SIZE - 1)))");
    // where the next chunk is asked for first: right after the last one, which
    // is aligned (one system call instead of three)
    wln(self, "static char* volatile __p_chunk_hint = NULL;");
    // __P_ARENA_CHUNK_SIZE bytes of zeroed pages at a multiple of their size,
    // NULL when there are none
    wln(self, "static char* __p_chunk_map(void** raw) {");
    wln(self, "    const size_t n = (size_t)__P_ARENA_CHUNK_SIZE;");
    wln(self, "#if P_OSMEM && defined(_WIN32)");
    wln(self, "    for (int i = 0; i < 16; i++) {");
    wln(self, "        char* want = __p_chunk_hint;");
    wln(self, "        if (want) {");
    wln(self, "            char* p = (char*)VirtualAlloc(want, n, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);");
    wln(self, "            if (p == want) { __p_chunk_hint = p + n; *raw = p; return p; }");
    wln(self, "            if (p) VirtualFree(p, 0, MEM_RELEASE);");
    wln(self, "        }");
    // twice the size reserved shows an aligned range, which is then taken
    // alone (another thread may take it first: then again)
    wln(self, "        char* r = (char*)VirtualAlloc(NULL, 2 * n, MEM_RESERVE, PAGE_NOACCESS);");
    wln(self, "        if (!r) return NULL;");
    wln(self, "        char* a = (char*)(((uintptr_t)r + n - 1) & ~(uintptr_t)(n - 1));");
    wln(self, "        VirtualFree(r, 0, MEM_RELEASE);");
    wln(self, "        char* q = (char*)VirtualAlloc(a, n, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);");
    wln(self, "        if (q == a) { __p_chunk_hint = a + n; *raw = q; return q; }");
    wln(self, "        if (q) VirtualFree(q, 0, MEM_RELEASE);");
    wln(self, "        __p_chunk_hint = NULL;");
    wln(self, "    }");
    wln(self, "    return NULL;");
    wln(self, "#elif P_OSMEM");
    wln(self, "    char* want = __p_chunk_hint;");
    wln(self, "    if (want) {");
    wln(self, "        char* p = (char*)mmap(want, n, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);");
    wln(self, "        if (p == want) { __p_chunk_hint = p + n; *raw = p; return p; }");
    wln(self, "        if (p != (char*)MAP_FAILED) munmap(p, n);");
    wln(self, "    }");
    wln(self, "    char* r = (char*)mmap(NULL, 2 * n, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);");
    wln(self, "    if (r == (char*)MAP_FAILED) return NULL;");
    wln(self, "    char* a = (char*)(((uintptr_t)r + n - 1) & ~(uintptr_t)(n - 1));");
    wln(self, "    if (a > r) munmap(r, (size_t)(a - r));");
    wln(self, "    if (r + 2 * n > a + n) munmap(a + n, (size_t)(r + 2 * n - (a + n)));");
    wln(self, "    __p_chunk_hint = a + n;");
    wln(self, "    *raw = a;");
    wln(self, "    return a;");
    wln(self, "#else");
    wln(self, "    char* r = (char*)calloc(1, 2 * n);");
    wln(self, "    if (!r) return NULL;");
    wln(self, "    *raw = r;");
    wln(self, "    return (char*)(((uintptr_t)r + n - 1) & ~(uintptr_t)(n - 1));");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static __p_arena_chunk* __p_arena_new_chunk(__p_heap* h) {");
    wln(self, "    void* raw = NULL;");
    wln(self, "    char* m = __p_chunk_map(&raw);");
    wln(self, "    if (!m) return NULL;");
    wln(self, "    __p_arena_chunk* c = (__p_arena_chunk*)m;");
    wln(self, "    c->base = m + 64;");
    wln(self, "    c->ptr = c->base;");
    wln(self, "    c->end = m + __P_ARENA_CHUNK_SIZE;");
    wln(self, "    c->next = NULL;");
    wln(self, "    c->owner = h;");
    wln(self, "    c->raw = raw;");
    wln(self, "    c->fb = 0;");
    wln(self, "    return c;");
    wln(self, "}");
    wln(self, "static void __p_arena_free_chunk(__p_arena_chunk* c) {");
    wln(self, "#if P_OSMEM");
    wln(self, "    __p_os_unmap(c, (size_t)__P_ARENA_CHUNK_SIZE);");
    wln(self, "#else");
    wln(self, "    free(c->raw);");
    wln(self, "#endif");
    wln(self, "}");
    // Blocks: an 8-byte header (P_BLOCK_MAGIC | size class) and the payload.
    // Classes are powers of two and 3/4 of them up to 1 MB, bumped from the
    // chunks of this thread's heap and reused through its free lists
    // (RT8: emit_mem_return_runtime); larger blocks are pages of their own
    // (RT7: calloc's under AddressSanitizer or without an OS). A reused
    // block is zeroed, as fresh memory is (p_malloc_uninit's is not).
    wln(self, "#define P_BLOCK_MAGIC 0xF1DE5A0000000000ULL");
    wln(self, "#define P_BLOCK_FREED 0xF1DE5B0000000000ULL");
    wln(self, "#define P_CLASS_LARGE 63");
    // Under AddressSanitizer every block comes from calloc and goes back to
    // free, so a use after free or an overrun is reported (release M8:
    // scripts/sanitize.sh); the pooled classes would hide them.
    wln(self, "#if defined(__SANITIZE_ADDRESS__)");
    wln(self, "#define P_SAN_ALLOC 1");
    wln(self, "#elif defined(__has_feature)");
    wln(self, "#if __has_feature(address_sanitizer)");
    wln(self, "#define P_SAN_ALLOC 1");
    wln(self, "#endif");
    wln(self, "#endif");
    wln(self, "#ifndef P_SAN_ALLOC");
    wln(self, "#define P_SAN_ALLOC 0");
    wln(self, "#endif");
    // C5: running out of memory is a panic (a message, exit code 1), not an
    // abort; defined before __p_block_recommit and p_malloc, which call it
    wln(self, "static void __p_oom(size_t n) { fprintf(stderr, \"Panic: out of memory (allocating %zu bytes)\\n\", n); fflush(stdout); exit(1); }");
    // RT7: empty chunks and free blocks of 256 KB and more go back to the
    // system (__p_mem_trim, run by p_free past a threshold)
    emit_mem_return_runtime(self);
    // RT8: p_malloc / p_free (emit_block_alloc_runtime)
    emit_block_alloc_runtime(self);
    emit_mem_resident_runtime(self);
    wln(self, "#ifdef P_MEMCHECK");
    wln(self, "#undef p_malloc");
    wln(self, "#undef p_free");
    wln(self, "/* fid ccompile --leaks / --checked-alloc. Every live block is in a table with");
    wln(self, "   the first Fides functions on the stack when it was allocated. --leaks: the");
    wln(self, "   blocks still live at exit are reported, grouped by where they were");
    wln(self, "   allocated. --checked-alloc: each block gets its own pages, ending at an");
    wln(self, "   inaccessible page, and a freed block's pages become inaccessible and are");
    wln(self, "   never reused, so a read or write past the end or after free faults where");
    wln(self, "   it happens (the crash trace shows it). */");
    wln(self, "#ifdef _WIN32");
    wln(self, "#include <windows.h>");
    wln(self, "#else");
    wln(self, "#include <sys/mman.h>");
    wln(self, "#include <unistd.h>");
    wln(self, "#endif");
    wln(self, "#if defined(_MSC_VER)");
    wln(self, "#include <intrin.h>");
    wln(self, "static volatile long __p_mc_lk = 0;");
    wln(self, "#define __P_MC_LOCK() while (_InterlockedExchange(&__p_mc_lk, 1)) {}");
    wln(self, "#define __P_MC_UNLOCK() _InterlockedExchange(&__p_mc_lk, 0)");
    wln(self, "#else");
    wln(self, "static volatile int __p_mc_lk = 0;");
    wln(self, "#define __P_MC_LOCK() while (__sync_lock_test_and_set(&__p_mc_lk, 1)) {}");
    wln(self, "#define __P_MC_UNLOCK() __sync_lock_release(&__p_mc_lk)");
    wln(self, "#endif");
    wln(self, "#define __P_MC_SITES 4");
    wln(self, "typedef struct { void* p; void* base; int64_t size; int64_t span; uintptr_t site[__P_MC_SITES]; const char* at; } __p_mc_rec;");
    wln(self, "#if defined(P_LEAKS) || defined(P_MEMPROF)");
    wln(self, "/* CM8: \"file.fd:LINE\" of the input file's last call site on this thread");
    wln(self, "   (its functions store it before each line's first call and after calls) */");
    wln(self, "P_THREAD_LOCAL const char* __p_mc_at = NULL;");
    wln(self, "#endif");
    wln(self, "static inline int __p_mc_same_at(const char* a, const char* b) { return a == b || (a && b && strcmp(a, b) == 0); }");
    wln(self, "static __p_mc_rec* __p_mc_tab = NULL;");
    wln(self, "static uint64_t __p_mc_cap = 0, __p_mc_used = 0;");
    wln(self, "static int __p_mc_started = 0;");
    wln(self, "static uint64_t __p_mc_hash(void* p) {");
    wln(self, "    uint64_t x = (uint64_t)(uintptr_t)p;");
    wln(self, "    x ^= x >> 33; x *= 0xff51afd7ed558ccdULL; x ^= x >> 33;");
    wln(self, "    return x;");
    wln(self, "}");
    wln(self, "static __p_mc_rec* __p_mc_find(void* p) {");
    wln(self, "    if (!__p_mc_cap) return NULL;");
    wln(self, "    uint64_t m = __p_mc_cap - 1, i = __p_mc_hash(p) & m;");
    wln(self, "    while (__p_mc_tab[i].p) {");
    wln(self, "        if (__p_mc_tab[i].p == p) return &__p_mc_tab[i];");
    wln(self, "        i = (i + 1) & m;");
    wln(self, "    }");
    wln(self, "    return NULL;");
    wln(self, "}");
    wln(self, "static void __p_mc_put(const __p_mc_rec* r) {");
    wln(self, "    if ((__p_mc_used + 1) * 2 > __p_mc_cap) {");
    wln(self, "        uint64_t nc = __p_mc_cap ? __p_mc_cap * 2 : 4096;");
    wln(self, "        __p_mc_rec* old = __p_mc_tab;");
    wln(self, "        uint64_t oc = __p_mc_cap;");
    wln(self, "        __p_mc_tab = (__p_mc_rec*)calloc((size_t)nc, sizeof(__p_mc_rec));");
    wln(self, "        if (!__p_mc_tab) { fprintf(stderr, \"fid: out of memory in the allocation table\\n\"); abort(); }");
    wln(self, "        __p_mc_cap = nc;");
    wln(self, "        for (uint64_t i = 0; i < oc; i++) {");
    wln(self, "            if (!old[i].p) continue;");
    wln(self, "            uint64_t j = __p_mc_hash(old[i].p) & (nc - 1);");
    wln(self, "            while (__p_mc_tab[j].p) j = (j + 1) & (nc - 1);");
    wln(self, "            __p_mc_tab[j] = old[i];");
    wln(self, "        }");
    wln(self, "        free(old);");
    wln(self, "    }");
    wln(self, "    uint64_t m = __p_mc_cap - 1, i = __p_mc_hash(r->p) & m;");
    wln(self, "    while (__p_mc_tab[i].p) i = (i + 1) & m;");
    wln(self, "    __p_mc_tab[i] = *r;");
    wln(self, "    __p_mc_used++;");
    wln(self, "}");
    wln(self, "/* Linear probing: deleting shifts the entries after it back into place. */");
    wln(self, "static void __p_mc_del(__p_mc_rec* e) {");
    wln(self, "    uint64_t m = __p_mc_cap - 1, i = (uint64_t)(e - __p_mc_tab), j = i;");
    wln(self, "    for (;;) {");
    wln(self, "        j = (j + 1) & m;");
    wln(self, "        if (!__p_mc_tab[j].p) break;");
    wln(self, "        uint64_t k = __p_mc_hash(__p_mc_tab[j].p) & m;");
    wln(self, "        if ((j > i && (k <= i || k > j)) || (j < i && k <= i && k > j)) { __p_mc_tab[i] = __p_mc_tab[j]; i = j; }");
    wln(self, "    }");
    wln(self, "    __p_mc_tab[i].p = NULL;");
    wln(self, "    __p_mc_used--;");
    wln(self, "}");
    wln(self, "static void __p_mc_where(uintptr_t* site) {");
    wln(self, "    uintptr_t f[24];");
    wln(self, "    int n = __p_frames(NULL, 0, f, 24), k = 0;");
    wln(self, "    for (int i = 0; i < n && k < __P_MC_SITES; i++) {");
    wln(self, "        if (__p_fn_name(f[i])) site[k++] = f[i];");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "#ifdef P_LEAKS");
    wln(self, "static int __p_mc_cmp(const void* a, const void* b) {");
    wln(self, "    int64_t x = ((const __p_mc_rec*)a)->size, y = ((const __p_mc_rec*)b)->size;");
    wln(self, "    return x < y ? 1 : x > y ? -1 : 0;");
    wln(self, "}");
    wln(self, "static void __p_mc_report(void) {");
    wln(self, "    fflush(stdout);");
    wln(self, "    uint64_t blocks = 0; int64_t bytes = 0;");
    wln(self, "    __p_mc_rec* by_site = (__p_mc_rec*)calloc((size_t)__p_mc_used + 1, sizeof(__p_mc_rec));");
    wln(self, "    uint64_t sites = 0;");
    wln(self, "    for (uint64_t i = 0; i < __p_mc_cap && by_site; i++) {");
    wln(self, "        __p_mc_rec* r = &__p_mc_tab[i];");
    wln(self, "        if (!r->p) continue;");
    wln(self, "        blocks++; bytes += r->size;");
    wln(self, "        uint64_t s = 0;");
    wln(self, "        while (s < sites && (memcmp(by_site[s].site, r->site, sizeof r->site) != 0 || !__p_mc_same_at(by_site[s].at, r->at))) s++;");
    wln(self, "        if (s == sites) { memcpy(by_site[s].site, r->site, sizeof r->site); by_site[s].at = r->at; sites++; }");
    wln(self, "        by_site[s].size += r->size;");
    wln(self, "        by_site[s].span += 1;");
    wln(self, "    }");
    wln(self, "    if (blocks == 0) { fprintf(stderr, \"fid --leaks: every block was freed\\n\"); free(by_site); return; }");
    wln(self, "    fprintf(stderr, \"fid --leaks: %llu block(s), %lld bytes, never freed; by where they were allocated:\\n\",");
    wln(self, "            (unsigned long long)blocks, (long long)bytes);");
    wln(self, "    qsort(by_site, (size_t)sites, sizeof(__p_mc_rec), __p_mc_cmp);");
    wln(self, "    for (uint64_t s = 0; s < sites && s < 20; s++) {");
    wln(self, "        fprintf(stderr, \"  %8lld bytes in %6lld block(s): \", (long long)by_site[s].size, (long long)by_site[s].span);");
    wln(self, "        int shown = 0;");
    wln(self, "        for (int k = 0; k < __P_MC_SITES && by_site[s].site[k]; k++) {");
    wln(self, "            fprintf(stderr, \"%s%s\", shown ? \" <- \" : \"\", __p_fn_name(by_site[s].site[k]));");
    wln(self, "            shown = 1;");
    wln(self, "        }");
    wln(self, "        if (!shown) fprintf(stderr, \"(no Fides frame)\");");
    wln(self, "        if (by_site[s].at) fprintf(stderr, \", allocated at %s\", by_site[s].at);");
    wln(self, "        fprintf(stderr, \"\\n\");");
    wln(self, "    }");
    wln(self, "    if (sites > 20) fprintf(stderr, \"  ... and %llu more place(s)\\n\", (unsigned long long)(sites - 20));");
    wln(self, "    free(by_site);");
    wln(self, "}");
    wln(self, "#endif");
    emit_mem_profile_impl(self);
    wln(self, "#ifdef P_CHECKED_ALLOC");
    wln(self, "static size_t __p_mc_page(void) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    SYSTEM_INFO si; GetSystemInfo(&si); return (size_t)si.dwPageSize;");
    wln(self, "#else");
    wln(self, "    return (size_t)sysconf(_SC_PAGESIZE);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "P_MN_NOINLINE void* p_malloc(int64_t size) {");
    wln(self, "    if (size < 0) { fprintf(stderr, \"p_malloc: negative size %lld\\n\", (long long)size); abort(); }");
    // L7C: under --mem a region's block is counted in the region usage
    // (__p_mr_alloc takes it from the arena, as the line after it does)
    wln(self, "#ifdef P_MEMPROF");
    wln(self, "    if (__p_rs.mode) return __p_mr_alloc(size);");
    wln(self, "#endif");
    // a region's blocks are not recorded: its end releases them together
    wln(self, "    if (__p_rs.mode) return __p_rg_alloc(size);");
    wln(self, "    __p_mc_rec r;");
    wln(self, "    memset(&r, 0, sizeof r);");
    wln(self, "    __p_mc_where(r.site);");
    wln(self, "#if defined(P_LEAKS) || defined(P_MEMPROF)");
    wln(self, "    r.at = __p_mc_at;");
    wln(self, "#endif");
    wln(self, "    r.size = size;");
    wln(self, "#ifdef P_CHECKED_ALLOC");
    wln(self, "    size_t pg = __p_mc_page();");
    wln(self, "    size_t used = ((size_t)size + 15) & ~(size_t)15;");
    // M25: 32 readable bytes in front of every block: the Vec buffer tag
    // probe (P_VBUF_TAGGED, __p_vbuf_free, __p_vec_grow, core's
    // vec_buf_tagged) reads the word 24 bytes before any buffer
    wln(self, "    size_t span = (used + 32 + pg - 1) / pg * pg + pg;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    char* base = (char*)VirtualAlloc(NULL, span, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);");
    wln(self, "    DWORD old;");
    wln(self, "    if (base) VirtualProtect(base + span - pg, pg, PAGE_NOACCESS, &old);");
    wln(self, "#else");
    wln(self, "    char* base = (char*)mmap(NULL, span, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);");
    wln(self, "    if (base == (char*)MAP_FAILED) base = NULL;");
    wln(self, "    if (base) mprotect(base + span - pg, pg, PROT_NONE);");
    wln(self, "#endif");
    wln(self, "    if (!base) { fprintf(stderr, \"p_malloc: out of memory (--checked-alloc uses pages per block)\\n\"); abort(); }");
    wln(self, "    r.base = base;");
    wln(self, "    r.span = (int64_t)span;");
    wln(self, "    r.p = base + span - pg - used;");
    wln(self, "#else");
    wln(self, "    r.p = __p_block_malloc(size);");
    wln(self, "#endif");
    wln(self, "    if (!r.p) return r.p;");
    wln(self, "    __P_MC_LOCK();");
    wln(self, "#ifdef P_LEAKS");
    wln(self, "    if (!__p_mc_started) { __p_mc_started = 1; atexit(__p_mc_report); }");
    wln(self, "#endif");
    wln(self, "#ifdef P_MEMPROF");
    wln(self, "    if (!__p_mp_started) { __p_mp_started = 1; atexit(__p_mp_report); }");
    wln(self, "    __p_mp_note(r.site[0], r.at, size);");
    wln(self, "    __p_ms_note(size);");
    wln(self, "#endif");
    wln(self, "    __p_mc_put(&r);");
    wln(self, "    __P_MC_UNLOCK();");
    wln(self, "    return r.p;");
    wln(self, "}");
    wln(self, "P_MN_NOINLINE void p_free(void* ptr) {");
    wln(self, "    if (!ptr) return;");
    wln(self, "    __P_MC_LOCK();");
    wln(self, "    __p_mc_rec* e = __p_mc_find(ptr);");
    wln(self, "    __p_mc_rec r;");
    wln(self, "    if (e) { r = *e; __p_mc_del(e); }");
    wln(self, "#ifdef P_MEMPROF");
    wln(self, "    if (e) { __p_mp_frees++; __p_mp_freed += r.size; __p_mp_live -= r.size; }");
    wln(self, "#endif");
    wln(self, "    __P_MC_UNLOCK();");
    wln(self, "    /* not from p_malloc (p_shared_alloc, say): the block allocator's own */");
    wln(self, "    if (!e) { __p_block_free(ptr); return; }");
    wln(self, "#ifdef P_CHECKED_ALLOC");
    wln(self, "#ifdef _WIN32");
    wln(self, "    DWORD old;");
    wln(self, "    VirtualProtect(r.base, (size_t)r.span, PAGE_NOACCESS, &old);");
    wln(self, "#else");
    wln(self, "    mprotect(r.base, (size_t)r.span, PROT_NONE);");
    wln(self, "#endif");
    wln(self, "#else");
    wln(self, "    __p_block_free(ptr);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "#endif");
    // CI6: inside a fides_call (__p_el_id), each block is recorded
    wln(self, "#ifdef P_EMBED_LOG");
    wln(self, "#undef p_malloc");
    wln(self, "void* p_malloc(int64_t size) {");
    // a region's blocks are not recorded: its end releases them
    wln(self, "    int in_region = __p_rs.mode != 0;");
    wln(self, "    void* p = __p_el_block_malloc(size);");
    wln(self, "    if (__p_el_id && p && !in_region) __p_el_put(p, __p_el_id);");
    wln(self, "    return p;");
    wln(self, "}");
    wln(self, "#endif");
    // RT8: there __p_malloc_uninit is the recording p_malloc (zeroed: the
    // same)
    wln(self, "#if defined(P_MEMCHECK) || defined(P_EMBED_LOG)");
    wln(self, "void* __p_malloc_uninit(int64_t size) { return p_malloc(size); }");
    wln(self, "#endif");
    wln(self, "void* p_alloc(int64_t size) { return p_malloc(size); }");
    // stdlib regions allocate from the arena, so it releases them too.
    wln(self, "void p_region_free(void* region) { (void)region; }");
    // Arena mark: (1-based chunk index << 32) | offset in that chunk.
    // Restoring frees the chunks after the marked one: they only hold
    // memory allocated after the save.
    // (RT8: the chunks of this thread's heap, through __P_HEAP: under M:N a
    // task may go on on another thread)
    wln(self, "int64_t p_arena_save(void) {");
    wln(self, "    __p_heap* h = __P_HEAP();");
    wln(self, "    if (!h) h = __p_heap_attach();");
    // RT7: a mark counts chunks, so this heap no longer gives any back
    wln(self, "    h->arena_marked = 1;");
    wln(self, "    int64_t idx = 0;");
    wln(self, "    for (__p_arena_chunk* c = h->head; c; c = c->next) {");
    wln(self, "        idx++;");
    wln(self, "        if (c == h->cur) return (idx << 32) | (int64_t)(c->ptr - c->base);");
    wln(self, "    }");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "void p_arena_restore(int64_t mark) {");
    wln(self, "    __p_heap* h = __P_HEAP();");
    wln(self, "    if (!h) return;");
    // Blocks past the mark may sit in the free lists (and among those other
    // threads freed into the heap): drop those lists.
    wln(self, "    memset(h->fl, 0, sizeof(h->fl));");
    wln(self, "    memset(h->zl, 0, sizeof(h->zl));");
    wln(self, "    h->fl_bytes = 0;");
    wln(self, "    (void)__p_xfree_take(h);");
    wln(self, "    int64_t idx = mark >> 32, off = mark & 0xffffffffLL, i = 0;");
    wln(self, "    __p_arena_chunk* keep = h->head;");
    wln(self, "    if (!keep) return;");
    wln(self, "    if (idx == 0) { keep->ptr = keep->base; }");
    wln(self, "    else {");
    wln(self, "        for (__p_arena_chunk* c = h->head; c; c = c->next) { if (++i == idx) { keep = c; break; } }");
    wln(self, "        if (i != idx) return;");
    wln(self, "        keep->ptr = keep->base + off;");
    wln(self, "    }");
    wln(self, "    __p_arena_chunk* c = keep->next;");
    wln(self, "    keep->next = NULL;");
    wln(self, "    while (c) { __p_arena_chunk* n = c->next; __p_arena_free_chunk(c); c = n; }");
    wln(self, "    h->cur = keep;");
    wln(self, "}");
    // File I/O builtins
    wln(self, "static char* p_file_read__raw(const char* path);");
    wln(self, "char* p_file_read(const char* path) { return p_str_own_c(p_file_read__raw(path)); }");
    // CI6: the I/O entry points fail, as on a missing file, when the
    // capability mask of fides_call (__p_caps) leaves their capability out
    wln(self, "static char* p_file_read__raw(const char* path) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_FS)) return NULL;");
    wln(self, "    FILE* f = fopen(path, \"rb\");");
    wln(self, "    if (!f) return NULL;");
    wln(self, "    fseek(f, 0, SEEK_END); long sz = ftell(f);");
    // VF14 (whole-suite ASan run, test_files_spec): glibc opens a directory
    // and ftell gives LONG_MAX, so sz + 1 was a negative size and p_malloc
    // aborted; a directory (or any size no file has) reads as a missing file
    wln(self, "    if (sz < 0 || (uint64_t)sz >= ((uint64_t)1 << 48)) { fclose(f); return NULL; }");
    wln(self, "    fseek(f, 0, SEEK_SET);");
    wln(self, "    char* buf = (char*)p_malloc((int64_t)sz + 1);");
    wln(self, "    if (!buf) { fclose(f); return NULL; }");
    wln(self, "    size_t rd = fread(buf, 1, (size_t)sz, f); buf[rd] = 0; fclose(f);");
    wln(self, "    return buf;");
    wln(self, "}");
    wln(self, "int64_t p_file_write(const char* path, const char* content) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_FS)) return -1;");
    // BG81: a counted string's bytes, NULs included (fputs stopped at the
    // first), and a failed write or flush is -1 (it was 0)
    wln(self, "    FILE* f = fopen(path, \"wb\");");
    wln(self, "    if (!f) return -1;");
    wln(self, "    size_t n = (size_t)p_slen(content);");
    wln(self, "    int bad = n > 0 && fwrite(content, 1, n, f) != n; if (fclose(f) != 0) bad = 1; return bad ? -1 : 0;");
    wln(self, "}");
    wln(self, "int64_t p_file_write_bin(const char* path, const char* data, int64_t len) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_FS)) return -1;");
    // RT2: a negative length is an error, not a huge size_t; a short write
    // is -1 as on the native runtimes
    wln(self, "    if (len < 0) return -1;");
    wln(self, "    FILE* f = fopen(path, \"wb\");");
    wln(self, "    if (!f) return -1;");
    wln(self, "    size_t w = len > 0 ? fwrite(data, 1, (size_t)len, f) : 0; fclose(f); return w == (size_t)len ? 0 : -1;");
    wln(self, "}");
    wln(self, "bool p_file_exists(const char* path) { if (P_CAP_DENIED(P_CAP_FS)) return false; FILE* f = fopen(path, \"rb\"); if (f) { fclose(f); return true; } return false; }");
    wln(self, "int64_t p_file_append(const char* path, const char* content) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_FS)) return -1;");
    wln(self, "    FILE* f = fopen(path, \"ab\");");
    wln(self, "    if (!f) return -1;");
    // C4: a full disk is an error, not a silent success (the write or the
    // flush at fclose fails)
    // BG81: every byte of a counted string, as p_file_write
    wln(self, "    size_t n = (size_t)p_slen(content);");
    wln(self, "    int bad = n > 0 && fwrite(content, 1, n, f) != n; if (fclose(f) != 0) bad = 1; return bad ? -1 : 0;");
    wln(self, "}");
    wln(self, "int64_t p_file_delete(const char* path) { if (P_CAP_DENIED(P_CAP_FS)) return -1; return remove(path) == 0 ? 0 : -1; }");
    wln(self, "int64_t p_file_size(const char* path) { if (P_CAP_DENIED(P_CAP_FS)) return -1; FILE* f = fopen(path, \"rb\"); if (!f) return -1; fseek(f, 0, SEEK_END); int64_t sz = ftell(f); fclose(f); return (sz < 0 || (uint64_t)sz >= ((uint64_t)1 << 48)) ? -1 : sz; }");
    wln(self, "int64_t p_file_hash(const char* path) { FILE* f = fopen(path, \"rb\"); if (!f) return 0; uint64_t h = 0xcbf29ce484222325ULL; unsigned char buf[65536]; size_t n; while ((n = fread(buf, 1, sizeof buf, f)) > 0) { for (size_t i = 0; i < n; i++) { h ^= buf[i]; h *= 0x100000001b3ULL; } } fclose(f); return (int64_t)h; }");
    // Read a line from stdin - returns malloc'd string (caller must not free,
    // arena-managed). Returns NULL on EOF. Strips trailing \n and \r\n.
    wln(self, "static char* p_read_line__raw(void);");
    wln(self, "char* p_read_line(void) { return p_str_copy_c(p_read_line__raw()); }");
    wln(self, "static char* p_read_line__raw(void) {");
    wln(self, "    static char* __p_line_buf = NULL;");
    // BG41: a line longer than the buffer was returned in pieces (one per
    // 4095 bytes): the buffer grows until the line's end (or the input's)
    wln(self, "    static size_t __p_line_cap = 0;");
    wln(self, "    if (!__p_line_buf) { __p_line_cap = 4096; __p_line_buf = (char*)p_malloc_persistent((int64_t)__p_line_cap); if (!__p_line_buf) return NULL; }");
    wln(self, "    size_t len = 0;");
    wln(self, "    for (;;) {");
    wln(self, "        if (!fgets(__p_line_buf + len, (int)(__p_line_cap - len), stdin)) { if (len == 0) return NULL; break; }");
    wln(self, "        len += strlen(__p_line_buf + len);");
    wln(self, "        if (len > 0 && __p_line_buf[len - 1] == '\\n') break;");
    // fgets stopped short of a full buffer: the input ended
    wln(self, "        if (len + 1 < __p_line_cap) break;");
    wln(self, "        if (__p_line_cap > 0x3FFFFFFF) break;");
    wln(self, "        char* nb = (char*)realloc(__p_line_buf, __p_line_cap * 2);");
    wln(self, "        if (!nb) break;");
    wln(self, "        __p_line_buf = nb; __p_line_cap *= 2;");
    wln(self, "    }");
    wln(self, "    while (len > 0 && (__p_line_buf[len-1] == '\\n' || __p_line_buf[len-1] == '\\r')) { __p_line_buf[--len] = 0; }");
    wln(self, "    return __p_line_buf;");
    wln(self, "}");
    // Check if stdin is at EOF - used by LSP server to detect client disconnect.
    wln(self, "int64_t p_stdin_eof(void) { return (int64_t)feof(stdin); }");
    // Read exactly n bytes from stdin - used by LSP protocol.
    // Returns malloc'd string (nul-terminated). Returns NULL on EOF/error.
    wln(self, "static char* p_read_stdin__raw(int64_t n);");
    wln(self, "char* p_read_stdin(int64_t n) { return p_str_own_libc_c(p_read_stdin__raw(n)); }");
    wln(self, "static char* p_read_stdin__raw(int64_t n) {");
    wln(self, "    char* buf = (char*)p_malloc_persistent(n + 1);");
    wln(self, "    if (!buf) return NULL;");
    wln(self, "    int64_t total = 0;");
    wln(self, "    while (total < n) {");
    wln(self, "        int64_t rd = (int64_t)fread(buf + total, 1, (size_t)(n - total), stdin);");
    wln(self, "        if (rd <= 0) { if (total == 0) { free(buf); return NULL; } break; }");
    wln(self, "        total += rd;");
    wln(self, "    }");
    wln(self, "    buf[total] = 0;");
    wln(self, "    return buf;");
    wln(self, "}");
    // Environment variable builtins
    wln(self, "static char* p_getenv__raw(const char* name);");
    wln(self, "char* p_getenv(const char* name) { return p_str_copy_c(p_getenv__raw(name)); }");
    wln(self, "static char* p_getenv__raw(const char* name) { if (P_CAP_DENIED(P_CAP_ENV)) return NULL; return getenv(name); }");
    // Command-line argument builtins - globals declared in emit_runtime_types
    wln(self, "int64_t p_argc(void) { return (int64_t)__p_argc; }");
    wln(self, "static char* p_argv__raw(int64_t index);");
    wln(self, "char* p_argv(int64_t index) { return p_str_copy_c(p_argv__raw(index)); }");
    wln(self, "static char* p_argv__raw(int64_t index) { if (index < 0 || index >= __p_argc) return NULL; return __p_argv[index]; }");
    // Process control builtins
    wln(self, "int64_t p_system(const char* cmd) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_PROC)) return -1;");
    // CI5 / F9: WASI has no processes (and wasi-libc no system()): a clear
    // panic, as `fid wasm` gives (compiler/wasm.fd)
    wln(self, "#ifdef __wasi__");
    wln(self, "    (void)cmd;");
    wln(self, "    p_panic(\"not available in WebAssembly: processes (p_system)\");");
    wln(self, "    return -1;");
    wln(self, "#else");
    wln(self, "    int st = system(cmd);");
    wln(self, "#ifdef _WIN32");
    wln(self, "    return (int64_t)st;");
    wln(self, "#else");
    wln(self, "    return WIFEXITED(st) ? (int64_t)WEXITSTATUS(st) : -1;");
    wln(self, "#endif");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_getpid(void) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    return (int64_t)_getpid();");
    wln(self, "#else");
    wln(self, "    return (int64_t)getpid();");
    wln(self, "#endif");
    wln(self, "}");
    // Captured subprocess results: run stores (out, err, code) in a slot
    // table; the readers return the fields; close frees the slot.
    wln(self, "typedef struct { char* out; char* err; int64_t code; int used; } PProc;");
    wln(self, "static PProc __p_proc_table[128];");
    wln(self, "static char* __p_read_all(const char* path) {");
    wln(self, "    FILE* f = fopen(path, \"rb\");");
    wln(self, "    if (!f) { char* e = (char*)malloc(1); e[0] = 0; return e; }");
    wln(self, "    fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);");
    wln(self, "    if (n < 0) n = 0;");
    wln(self, "    char* buf = (char*)malloc((size_t)n + 1);");
    wln(self, "    size_t got = fread(buf, 1, (size_t)n, f);");
    wln(self, "    buf[got] = 0; fclose(f); return buf;");
    wln(self, "}");
    wln(self, "static char* __p_proc_text(const char* s) {");
    wln(self, "    char* r = (char*)p_malloc((int64_t)strlen(s) + 1);");
    wln(self, "    strcpy(r, s);");
    wln(self, "    return r;");
    wln(self, "}");
    // SL17 (known-bugs 2g.44): the capture files go to the temp directory
    // (TMPDIR, else /tmp; Windows TEMP, else TMP), not the current one,
    // which may be read-only or be the directory a test lists.
    wln(self, "static const char* __p_proc_tmpdir(void) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    const char* d = getenv(\"TEMP\");");
    wln(self, "    if (!d || !*d) d = getenv(\"TMP\");");
    wln(self, "    if (!d || !*d) d = \".\";");
    wln(self, "#else");
    wln(self, "    const char* d = getenv(\"TMPDIR\");");
    wln(self, "    if (!d || !*d) d = \"/tmp\";");
    wln(self, "#endif");
    wln(self, "    return d;");
    wln(self, "}");
    // BG69: the slot table's lock and the capture-file number (TinyCC has
    // no atomics here, as __p_xfree_take)
    wln(self, "#if defined(__TINYC__)");
    wln(self, "#define P_PROC_LOCK(l) ((void)(l))");
    wln(self, "#define P_PROC_UNLOCK(l) ((void)(l))");
    wln(self, "#define P_PROC_NEXT(c) ((*(c))++)");
    wln(self, "#elif defined(_MSC_VER)");
    wln(self, "#define P_PROC_LOCK(l) while (_InterlockedExchange((volatile long*)(l), 1)) { }");
    wln(self, "#define P_PROC_UNLOCK(l) _InterlockedExchange((volatile long*)(l), 0)");
    wln(self, "#define P_PROC_NEXT(c) (_InterlockedIncrement64((volatile long long*)(c)) - 1)");
    wln(self, "#else");
    wln(self, "#define P_PROC_LOCK(l) while (__atomic_exchange_n((l), 1, __ATOMIC_ACQUIRE)) { }");
    wln(self, "#define P_PROC_UNLOCK(l) __atomic_store_n((l), 0, __ATOMIC_RELEASE)");
    wln(self, "#define P_PROC_NEXT(c) __atomic_fetch_add((c), 1, __ATOMIC_RELAXED)");
    wln(self, "#endif");
    wln(self, "int64_t p_process_run(const char* cmd) {");
    wln(self, "    if (!cmd || !*cmd || P_CAP_DENIED(P_CAP_PROC)) return 0;");
    wln(self, "#ifdef __wasi__");
    wln(self, "    p_panic(\"not available in WebAssembly: processes (p_process_run)\");");
    wln(self, "    return 0;");
    wln(self, "#else");
    // BG69: two threads running commands at once took one slot and one pair
    // of capture files (an unlocked scan, `ctr++`): the slot is claimed (used)
    // under a lock and the number is atomic. The command line was cut at
    // 8191 bytes (a fixed buffer): it is allocated to its length.
    wln(self, "    static int64_t ctr = 0;");
    wln(self, "    static long lk = 0;");
    wln(self, "    int slot = -1;");
    wln(self, "    P_PROC_LOCK(&lk);");
    wln(self, "    for (int i = 0; i < 128; i++) if (!__p_proc_table[i].used) { slot = i; __p_proc_table[i].used = 2; break; }");
    wln(self, "    P_PROC_UNLOCK(&lk);");
    wln(self, "    if (slot < 0) return 0;");
    wln(self, "    int64_t k = P_PROC_NEXT(&ctr);");
    wln(self, "    char of[1024], ef[1024];");
    wln(self, "    const char* td = __p_proc_tmpdir();");
    wln(self, "    size_t tdl = strlen(td);");
    wln(self, "    const char* sep = (tdl > 0 && (td[tdl - 1] == '/' || td[tdl - 1] == '\\\\')) ? \"\" : \"/\";");
    wln(self, "    snprintf(of, sizeof of, \"%s%s.fides_proc_%ld_%lld.out\", td, sep, (long)p_getpid(), (long long)k);");
    wln(self, "    snprintf(ef, sizeof ef, \"%s%s.fides_proc_%ld_%lld.err\", td, sep, (long)p_getpid(), (long long)k);");
    wln(self, "    size_t fl = strlen(cmd) + strlen(of) + strlen(ef) + 32;");
    wln(self, "    char* full = (char*)malloc(fl);");
    wln(self, "    if (!full) { __p_proc_table[slot].used = 0; return 0; }");
    wln(self, "    snprintf(full, fl, \"( %s ) > \\\"%s\\\" 2> \\\"%s\\\"\", cmd, of, ef);");
    wln(self, "    int st = system(full);");
    wln(self, "    free(full);");
    wln(self, "#ifdef _WIN32");
    wln(self, "    __p_proc_table[slot].code = (int64_t)st;");
    wln(self, "#else");
    wln(self, "    __p_proc_table[slot].code = WIFEXITED(st) ? (int64_t)WEXITSTATUS(st) : -1;");
    wln(self, "#endif");
    wln(self, "    __p_proc_table[slot].out = __p_read_all(of);");
    wln(self, "    __p_proc_table[slot].err = __p_read_all(ef);");
    wln(self, "    remove(of); remove(ef);");
    wln(self, "    __p_proc_table[slot].used = 1;");
    wln(self, "    return (int64_t)slot + 1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static char* p_process_stdout__raw(int64_t h);");
    wln(self, "char* p_process_stdout(int64_t h) { return p_str_own_c(p_process_stdout__raw(h)); }");
    wln(self, "static char* p_process_stdout__raw(int64_t h) {");
    // a counted empty string, not a C literal (p_str_own_c read 16 bytes in
    // front of the literal: VF14, test_files_spec under ASan)
    wln(self, "    if (h < 1 || h > 128 || !__p_proc_table[h-1].used) return p_str_alloc_c(0);");
    wln(self, "    return __p_proc_text(__p_proc_table[h-1].out);");
    wln(self, "}");
    wln(self, "static char* p_process_stderr__raw(int64_t h);");
    wln(self, "char* p_process_stderr(int64_t h) { return p_str_own_c(p_process_stderr__raw(h)); }");
    wln(self, "static char* p_process_stderr__raw(int64_t h) {");
    wln(self, "    if (h < 1 || h > 128 || !__p_proc_table[h-1].used) return p_str_alloc_c(0);");
    wln(self, "    return __p_proc_text(__p_proc_table[h-1].err);");
    wln(self, "}");
    wln(self, "int64_t p_process_code(int64_t h) {");
    wln(self, "    if (h < 1 || h > 128 || !__p_proc_table[h-1].used) return -1;");
    wln(self, "    return __p_proc_table[h-1].code;");
    wln(self, "}");
    wln(self, "void p_process_close(int64_t h) {");
    wln(self, "    if (h < 1 || h > 128 || !__p_proc_table[h-1].used) return;");
    wln(self, "    free(__p_proc_table[h-1].out); free(__p_proc_table[h-1].err);");
    wln(self, "    __p_proc_table[h-1].used = 0;");
    wln(self, "}");
    // AD4: child processes with a time limit (stdlib/process.fd
    // process_spawn / process_wait / process_kill), declared there
    // `extern "C"` with word arguments; pe_runtime and linux_runtime give
    // the same as pert_c_fid_proc_*.
    wln(self, "/* AD4: child processes without the shell (stdlib/process.fd process_spawn,");
    wln(self, "   process_wait, process_kill), declared there `extern \"C\"` with word");
    wln(self, "   arguments. argv and env are lists in one string, the items separated by");
    wln(self, "   byte 31; an env item KEY=VALUE sets KEY for the child on top of this");
    wln(self, "   process's environment, a bare KEY removes it. dir \"\" keeps ours. out is");
    wln(self, "   a list too: the file for the child's stdout, then the one for its stderr");
    wln(self, "   (created or emptied); \"\" (or no second item) for the stdout file, or");
    wln(self, "   ours, as the case may be. A handle is a slot of __p_child + 1. Waiting polls");
    wln(self, "   (POSIX) or waits on the process (Windows) with a time limit, so a program");
    wln(self, "   can keep many children running. Spawn, wait and free from one thread. */");
    wln(self, "#if !defined(_WIN32) && !defined(__wasi__)");
    wln(self, "#include <signal.h>");
    wln(self, "#include <errno.h>");
    wln(self, "#include <time.h>");
    wln(self, "extern char** environ;");
    wln(self, "#endif");
    wln(self, "#define P_CHILD_MAX 1024");
    wln(self, "typedef struct {");
    wln(self, "    int used; int done; int64_t code; int64_t pid;");
    // roadmap L4H (Command::spawn): this end of the child's stdin, stdout
    // and stderr pipes (a descriptor, a HANDLE on Windows; -1: none)
    wln(self, "    int64_t pin, pout, perr;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    HANDLE ph;");
    wln(self, "#endif");
    wln(self, "} PChild;");
    wln(self, "static PChild __p_child[P_CHILD_MAX];");
    wln(self, "static PChild* __p_child_at(int64_t h) {");
    wln(self, "    if (h < 1 || h > P_CHILD_MAX || !__p_child[h - 1].used) return NULL;");
    wln(self, "    return &__p_child[h - 1];");
    wln(self, "}");
    wln(self, "#if !defined(__wasi__)");
    wln(self, "/* the items of list s (byte 31 between them) as a NULL-terminated array,");
    wln(self, "   array and text in one malloc block; *count gets the number of items */");
    wln(self, "static char** __p_child_split(const char* s, int* count) {");
    wln(self, "    size_t n = s ? strlen(s) : 0;");
    wln(self, "    int k = n > 0 ? 1 : 0;");
    wln(self, "    for (size_t i = 0; i < n; i++) if (s[i] == 31) k++;");
    wln(self, "    char** v = (char**)malloc(sizeof(char*) * (size_t)(k + 1) + n + 1);");
    wln(self, "    if (!v) return NULL;");
    wln(self, "    char* buf = (char*)(v + k + 1);");
    wln(self, "    if (n > 0) memcpy(buf, s, n);");
    wln(self, "    buf[n] = 0;");
    wln(self, "    int j = 0;");
    wln(self, "    if (n > 0) {");
    wln(self, "        v[j++] = buf;");
    wln(self, "        for (size_t i = 0; i < n; i++) if (buf[i] == 31) { buf[i] = 0; v[j++] = buf + i + 1; }");
    wln(self, "    }");
    wln(self, "    v[j] = NULL;");
    wln(self, "    if (count) *count = j;");
    wln(self, "    return v;");
    wln(self, "}");
    wln(self, "/* does environment entry e (\"KEY=..\") have the key of item o (\"KEY=..\" or");
    wln(self, "   \"KEY\")? Windows keys ignore case */");
    wln(self, "static int __p_child_same_key(const char* e, const char* o) {");
    wln(self, "    size_t i = 0;");
    wln(self, "    while (o[i] && o[i] != '=') {");
    wln(self, "        char a = e[i], b = o[i];");
    wln(self, "#ifdef _WIN32");
    wln(self, "        if (a >= 'a' && a <= 'z') a = (char)(a - 32);");
    wln(self, "        if (b >= 'a' && b <= 'z') b = (char)(b - 32);");
    wln(self, "#endif");
    wln(self, "        if (a == 0 || a != b) return 0;");
    wln(self, "        i++;");
    wln(self, "    }");
    wln(self, "    return e[i] == '=';");
    wln(self, "}");
    wln(self, "static int __p_child_slot(void) {");
    wln(self, "    for (int i = 0; i < P_CHILD_MAX; i++) if (!__p_child[i].used) return i;");
    wln(self, "    return -1;");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "#if defined(_WIN32)");
    wln(self, "/* one argument quoted for the C runtime's command-line parser");
    wln(self, "   (CommandLineToArgvW's rules), appended at *at */");
    wln(self, "static char* __p_child_quote(char* at, const char* a) {");
    wln(self, "    int plain = *a != 0;");
    wln(self, "    for (const char* q = a; *q; q++) if (*q == ' ' || *q == '\\t' || *q == '\\n' || *q == '\\v' || *q == '\"') plain = 0;");
    wln(self, "    if (plain) { size_t n = strlen(a); memcpy(at, a, n); return at + n; }");
    wln(self, "    *at++ = '\"';");
    wln(self, "    for (const char* q = a; ; q++) {");
    wln(self, "        size_t bs = 0;");
    wln(self, "        while (*q == '\\\\') { bs++; q++; }");
    wln(self, "        if (*q == 0) { for (size_t i = 0; i < bs * 2; i++) *at++ = '\\\\'; break; }");
    wln(self, "        if (*q == '\"') { for (size_t i = 0; i < bs * 2 + 1; i++) *at++ = '\\\\'; *at++ = '\"'; }");
    wln(self, "        else { for (size_t i = 0; i < bs; i++) *at++ = '\\\\'; *at++ = *q; }");
    wln(self, "    }");
    wln(self, "    *at++ = '\"';");
    wln(self, "    return at;");
    wln(self, "}");
    wln(self, "#endif");
    // roadmap L4H: io bits 1 / 2 / 4 give the child a pipe as its stdin /
    // stdout / stderr (fid_proc_write, fid_proc_read, fid_proc_close_in);
    // 8 sends its stderr where its stdout goes. A piped stream takes no file.
    wln(self, "static int64_t __p_child_spawn(int64_t argv_list, int64_t env_list, int64_t dir_w, int64_t out_w, int64_t io) {");
    wln(self, "    const char* argl = (const char*)(intptr_t)argv_list;");
    wln(self, "    const char* envl = (const char*)(intptr_t)env_list;");
    wln(self, "    const char* dir = (const char*)(intptr_t)dir_w;");
    wln(self, "    const char* out = (const char*)(intptr_t)out_w;");
    wln(self, "    if (!argl || !*argl || P_CAP_DENIED(P_CAP_PROC)) return 0;");
    wln(self, "#if defined(__wasi__)");
    wln(self, "    (void)envl; (void)dir; (void)out; (void)io;");
    wln(self, "    p_panic(\"not available in WebAssembly: processes (process_spawn)\");");
    wln(self, "    return 0;");
    wln(self, "#else");
    wln(self, "    int slot = __p_child_slot();");
    wln(self, "    if (slot < 0) return 0;");
    wln(self, "    int na = 0, ne = 0;");
    wln(self, "    char** av = __p_child_split(argl, &na);");
    wln(self, "    char** ov = __p_child_split(envl, &ne);");
    wln(self, "    int no = 0;");
    wln(self, "    char** fv = __p_child_split(out, &no);");
    wln(self, "    const char* of = (fv && no > 0 && *fv[0]) ? fv[0] : NULL;");
    wln(self, "    const char* ef = (fv && no > 1 && *fv[1]) ? fv[1] : NULL;");
    wln(self, "    if (io & 2) of = NULL;");
    wln(self, "    if (io & 12) ef = NULL;");
    wln(self, "    if (!av || !ov || !fv || na == 0) { free(av); free(ov); free(fv); return 0; }");
    wln(self, "    fflush(stdout); fflush(stderr);");
    wln(self, "#if defined(_WIN32)");
    wln(self, "    size_t len = 1;");
    wln(self, "    for (int i = 0; i < na; i++) len += strlen(av[i]) * 2 + 3;");
    wln(self, "    char* line = (char*)malloc(len);");
    wln(self, "    char* envb = NULL;");
    wln(self, "    if (!line) { free(av); free(ov); free(fv); return 0; }");
    wln(self, "    char* at = line;");
    wln(self, "    for (int i = 0; i < na; i++) { if (i > 0) *at++ = ' '; at = __p_child_quote(at, av[i]); }");
    wln(self, "    *at = 0;");
    wln(self, "    if (ne > 0) {");
    wln(self, "        /* our environment block less the keys the list names, then the list */");
    wln(self, "        char* cur = GetEnvironmentStringsA();");
    wln(self, "        size_t need = 2;");
    wln(self, "        if (cur) for (char* e = cur; *e; e += strlen(e) + 1) need += strlen(e) + 1;");
    wln(self, "        for (int i = 0; i < ne; i++) need += strlen(ov[i]) + 1;");
    wln(self, "        envb = (char*)malloc(need);");
    wln(self, "        if (envb) {");
    wln(self, "            char* w = envb;");
    wln(self, "            if (cur) for (char* e = cur; *e; e += strlen(e) + 1) {");
    wln(self, "                int drop = 0;");
    wln(self, "                for (int i = 0; i < ne && !drop; i++) if (*e != '=' && __p_child_same_key(e, ov[i])) drop = 1;");
    wln(self, "                if (!drop) { size_t n = strlen(e) + 1; memcpy(w, e, n); w += n; }");
    wln(self, "            }");
    wln(self, "            for (int i = 0; i < ne; i++) if (strchr(ov[i], '=')) { size_t n = strlen(ov[i]) + 1; memcpy(w, ov[i], n); w += n; }");
    wln(self, "            *w++ = 0;");
    wln(self, "            if (w == envb + 1) *w++ = 0;");
    wln(self, "        }");
    wln(self, "        if (cur) FreeEnvironmentStringsA(cur);");
    wln(self, "    }");
    wln(self, "    STARTUPINFOA si;");
    wln(self, "    PROCESS_INFORMATION pi;");
    wln(self, "    memset(&si, 0, sizeof si);");
    wln(self, "    memset(&pi, 0, sizeof pi);");
    wln(self, "    si.cb = sizeof si;");
    wln(self, "    HANDLE fh = INVALID_HANDLE_VALUE, eh = INVALID_HANDLE_VALUE;");
    wln(self, "    if (of || ef) {");
    wln(self, "        SECURITY_ATTRIBUTES sa;");
    wln(self, "        sa.nLength = sizeof sa; sa.lpSecurityDescriptor = NULL; sa.bInheritHandle = TRUE;");
    wln(self, "        if (of) fh = CreateFileA(of, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, &sa, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);");
    wln(self, "        if (ef) eh = CreateFileA(ef, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, &sa, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);");
    wln(self, "        if ((of && fh == INVALID_HANDLE_VALUE) || (ef && eh == INVALID_HANDLE_VALUE)) {");
    wln(self, "            if (fh != INVALID_HANDLE_VALUE) CloseHandle(fh);");
    wln(self, "            if (eh != INVALID_HANDLE_VALUE) CloseHandle(eh);");
    wln(self, "            free(line); free(envb); free(av); free(ov); free(fv);");
    wln(self, "            return 0;");
    wln(self, "        }");
    wln(self, "    }");
    // roadmap L4H: the pipes (inheritable; this process's ends are made not
    // to be, so a later child does not hold them open)
    wln(self, "    HANDLE pend[3] = { INVALID_HANDLE_VALUE, INVALID_HANDLE_VALUE, INVALID_HANDLE_VALUE };");
    wln(self, "    HANDLE cend[3] = { INVALID_HANDLE_VALUE, INVALID_HANDLE_VALUE, INVALID_HANDLE_VALUE };");
    wln(self, "    int pipes_ok = 1;");
    wln(self, "    for (int k = 0; k < 3 && pipes_ok; k++) {");
    wln(self, "        if (!(io & (1 << k))) continue;");
    wln(self, "        SECURITY_ATTRIBUTES psa;");
    wln(self, "        psa.nLength = sizeof psa; psa.lpSecurityDescriptor = NULL; psa.bInheritHandle = TRUE;");
    wln(self, "        HANDLE pr = INVALID_HANDLE_VALUE, pw = INVALID_HANDLE_VALUE;");
    wln(self, "        if (!CreatePipe(&pr, &pw, &psa, 0)) { pipes_ok = 0; break; }");
    wln(self, "        if (k == 0) { cend[0] = pr; pend[0] = pw; } else { cend[k] = pw; pend[k] = pr; }");
    wln(self, "        SetHandleInformation(pend[k], HANDLE_FLAG_INHERIT, 0);");
    wln(self, "    }");
    wln(self, "    if (!pipes_ok) {");
    wln(self, "        for (int k = 0; k < 3; k++) {");
    wln(self, "            if (pend[k] != INVALID_HANDLE_VALUE) CloseHandle(pend[k]);");
    wln(self, "            if (cend[k] != INVALID_HANDLE_VALUE) CloseHandle(cend[k]);");
    wln(self, "        }");
    wln(self, "        if (fh != INVALID_HANDLE_VALUE) CloseHandle(fh);");
    wln(self, "        if (eh != INVALID_HANDLE_VALUE) CloseHandle(eh);");
    wln(self, "        free(line); free(envb); free(av); free(ov); free(fv);");
    wln(self, "        return 0;");
    wln(self, "    }");
    wln(self, "    int handles = (of || ef || (io & 15)) ? 1 : 0;");
    wln(self, "    if (handles) {");
    wln(self, "        si.dwFlags = STARTF_USESTDHANDLES;");
    wln(self, "        si.hStdInput = (io & 1) ? cend[0] : GetStdHandle(STD_INPUT_HANDLE);");
    wln(self, "        si.hStdOutput = (io & 2) ? cend[1] : (of ? fh : GetStdHandle(STD_OUTPUT_HANDLE));");
    wln(self, "        if (io & 4) si.hStdError = cend[2];");
    wln(self, "        else if (io & 8) si.hStdError = si.hStdOutput;");
    wln(self, "        else si.hStdError = ef ? eh : (of ? fh : GetStdHandle(STD_ERROR_HANDLE));");
    wln(self, "    }");
    wln(self, "    BOOL ok = CreateProcessA(NULL, line, NULL, NULL, handles ? TRUE : FALSE, 0, envb, (dir && *dir) ? dir : NULL, &si, &pi);");
    wln(self, "    if (fh != INVALID_HANDLE_VALUE) CloseHandle(fh);");
    wln(self, "    if (eh != INVALID_HANDLE_VALUE) CloseHandle(eh);");
    wln(self, "    for (int k = 0; k < 3; k++) {");
    wln(self, "        if (cend[k] != INVALID_HANDLE_VALUE) CloseHandle(cend[k]);");
    wln(self, "        if (!ok && pend[k] != INVALID_HANDLE_VALUE) CloseHandle(pend[k]);");
    wln(self, "    }");
    wln(self, "    free(line); free(envb); free(av); free(ov); free(fv);");
    wln(self, "    if (!ok) return 0;");
    wln(self, "    CloseHandle(pi.hThread);");
    wln(self, "    __p_child[slot].ph = pi.hProcess;");
    wln(self, "    __p_child[slot].pid = (int64_t)pi.dwProcessId;");
    wln(self, "    __p_child[slot].pin = (int64_t)(intptr_t)pend[0];");
    wln(self, "    __p_child[slot].pout = (int64_t)(intptr_t)pend[1];");
    wln(self, "    __p_child[slot].perr = (int64_t)(intptr_t)pend[2];");
    wln(self, "#else");
    wln(self, "    char** ev = NULL;");
    wln(self, "    if (ne > 0) {");
    wln(self, "        int m = 0;");
    wln(self, "        while (environ && environ[m]) m++;");
    wln(self, "        ev = (char**)malloc(sizeof(char*) * (size_t)(m + ne + 1));");
    wln(self, "        if (!ev) { free(av); free(ov); free(fv); return 0; }");
    wln(self, "        int k = 0;");
    wln(self, "        for (int i = 0; i < m; i++) {");
    wln(self, "            int drop = 0;");
    wln(self, "            for (int j = 0; j < ne && !drop; j++) if (__p_child_same_key(environ[i], ov[j])) drop = 1;");
    wln(self, "            if (!drop) ev[k++] = environ[i];");
    wln(self, "        }");
    wln(self, "        for (int j = 0; j < ne; j++) if (strchr(ov[j], '=')) ev[k++] = ov[j];");
    wln(self, "        ev[k] = NULL;");
    wln(self, "    }");
    wln(self, "    int fd = -1, efd = -1;");
    wln(self, "    if (of) fd = open(of, O_WRONLY | O_CREAT | O_TRUNC, 0644);");
    wln(self, "    if (ef) efd = open(ef, O_WRONLY | O_CREAT | O_TRUNC, 0644);");
    wln(self, "    if ((of && fd < 0) || (ef && efd < 0)) {");
    wln(self, "        if (fd >= 0) close(fd);");
    wln(self, "        if (efd >= 0) close(efd);");
    wln(self, "        free(ev); free(av); free(ov); free(fv);");
    wln(self, "        return 0;");
    wln(self, "    }");
    // roadmap L4H: the pipes, [k][0] the read end; this process's ends are
    // close-on-exec, so a later child does not hold them open
    wln(self, "    int pp[3][2] = { { -1, -1 }, { -1, -1 }, { -1, -1 } };");
    wln(self, "    int pipes_ok = 1;");
    wln(self, "    for (int k = 0; k < 3 && pipes_ok; k++) {");
    wln(self, "        if (!(io & (1 << k))) continue;");
    wln(self, "        if (pipe(pp[k]) != 0) { pp[k][0] = -1; pp[k][1] = -1; pipes_ok = 0; break; }");
    wln(self, "        fcntl(k == 0 ? pp[k][1] : pp[k][0], F_SETFD, FD_CLOEXEC);");
    wln(self, "    }");
    wln(self, "    if (!pipes_ok) {");
    wln(self, "        for (int k = 0; k < 3; k++) { if (pp[k][0] >= 0) close(pp[k][0]); if (pp[k][1] >= 0) close(pp[k][1]); }");
    wln(self, "        if (fd >= 0) close(fd);");
    wln(self, "        if (efd >= 0) close(efd);");
    wln(self, "        free(ev); free(av); free(ov); free(fv);");
    wln(self, "        return 0;");
    wln(self, "    }");
    wln(self, "    pid_t pid = fork();");
    wln(self, "    if (pid == 0) {");
    wln(self, "        if (dir && *dir && chdir(dir) != 0) _exit(127);");
    wln(self, "        if (pp[0][0] >= 0) dup2(pp[0][0], 0);");
    wln(self, "        if (pp[1][1] >= 0) dup2(pp[1][1], 1); else if (fd >= 0) dup2(fd, 1);");
    wln(self, "        if (pp[2][1] >= 0) dup2(pp[2][1], 2);");
    wln(self, "        else if (io & 8) dup2(1, 2);");
    wln(self, "        else if (efd >= 0) dup2(efd, 2); else if (fd >= 0) dup2(fd, 2);");
    wln(self, "        for (int k = 0; k < 3; k++) { if (pp[k][0] > 2) close(pp[k][0]); if (pp[k][1] > 2) close(pp[k][1]); }");
    wln(self, "        if (fd >= 0) close(fd);");
    wln(self, "        if (efd >= 0) close(efd);");
    wln(self, "        if (ev) environ = ev;");
    wln(self, "        execvp(av[0], av);");
    wln(self, "        _exit(127);");
    wln(self, "    }");
    wln(self, "    if (fd >= 0) close(fd);");
    wln(self, "    if (efd >= 0) close(efd);");
    wln(self, "    free(ev); free(av); free(ov); free(fv);");
    wln(self, "    /* the child's ends (all of them when it did not start) */");
    wln(self, "    if (pp[0][0] >= 0) close(pp[0][0]);");
    wln(self, "    if (pp[1][1] >= 0) close(pp[1][1]);");
    wln(self, "    if (pp[2][1] >= 0) close(pp[2][1]);");
    wln(self, "    if (pid < 0) {");
    wln(self, "        if (pp[0][1] >= 0) close(pp[0][1]);");
    wln(self, "        if (pp[1][0] >= 0) close(pp[1][0]);");
    wln(self, "        if (pp[2][0] >= 0) close(pp[2][0]);");
    wln(self, "        return 0;");
    wln(self, "    }");
    wln(self, "    __p_child[slot].pid = (int64_t)pid;");
    wln(self, "    __p_child[slot].pin = (int64_t)pp[0][1];");
    wln(self, "    __p_child[slot].pout = (int64_t)pp[1][0];");
    wln(self, "    __p_child[slot].perr = (int64_t)pp[2][0];");
    wln(self, "#endif");
    wln(self, "    __p_child[slot].used = 1;");
    wln(self, "    __p_child[slot].done = 0;");
    wln(self, "    __p_child[slot].code = -1;");
    wln(self, "    return (int64_t)slot + 1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t fid_proc_spawn(int64_t argv_list, int64_t env_list, int64_t dir_w, int64_t out_w) {");
    wln(self, "    return __p_child_spawn(argv_list, env_list, dir_w, out_w, 0);");
    wln(self, "}");
    // roadmap L4H: Command::spawn's child with pipes (stdlib/process.fd
    // process_spawn_io); see __p_child_spawn for io
    wln(self, "int64_t fid_proc_spawn_io(int64_t argv_list, int64_t env_list, int64_t dir_w, int64_t out_w, int64_t io) {");
    wln(self, "    return __p_child_spawn(argv_list, env_list, dir_w, out_w, io & 15);");
    wln(self, "}");
    wln(self, "static void __p_child_close_end(int64_t* e) {");
    wln(self, "    if (*e == -1) return;");
    wln(self, "#if defined(_WIN32)");
    wln(self, "    CloseHandle((HANDLE)(intptr_t)*e);");
    wln(self, "#elif !defined(__wasi__)");
    wln(self, "    close((int)*e);");
    wln(self, "#endif");
    wln(self, "    *e = -1;");
    wln(self, "}");
    wln(self, "/* all n bytes at data to the child's stdin pipe: n, or -1 when it has no");
    wln(self, "   such pipe or the child closed it (no SIGPIPE: ignored for the write) */");
    wln(self, "int64_t fid_proc_write(int64_t h, int64_t data, int64_t n) {");
    wln(self, "    PChild* c = __p_child_at(h);");
    wln(self, "    if (!c || c->pin == -1 || n < 0 || (n > 0 && !data)) return -1;");
    wln(self, "    const char* p = (const char*)(intptr_t)data;");
    wln(self, "    int64_t done = 0;");
    wln(self, "#if defined(__wasi__)");
    wln(self, "    (void)p;");
    wln(self, "    return -1;");
    wln(self, "#elif defined(_WIN32)");
    wln(self, "    while (done < n) {");
    wln(self, "        DWORD w = 0;");
    wln(self, "        DWORD k = (DWORD)((n - done) > 0x40000000 ? 0x40000000 : (n - done));");
    wln(self, "        if (!WriteFile((HANDLE)(intptr_t)c->pin, p + done, k, &w, NULL) || w == 0) return -1;");
    wln(self, "        done += (int64_t)w;");
    wln(self, "    }");
    wln(self, "    return done;");
    wln(self, "#else");
    wln(self, "    struct sigaction ign, old;");
    wln(self, "    memset(&ign, 0, sizeof ign);");
    wln(self, "    ign.sa_handler = SIG_IGN;");
    wln(self, "    sigaction(SIGPIPE, &ign, &old);");
    wln(self, "    while (done < n) {");
    wln(self, "        ssize_t w = write((int)c->pin, p + done, (size_t)(n - done));");
    wln(self, "        if (w < 0 && errno == EINTR) continue;");
    wln(self, "        if (w <= 0) { done = -1; break; }");
    wln(self, "        done += (int64_t)w;");
    wln(self, "    }");
    wln(self, "    sigaction(SIGPIPE, &old, NULL);");
    wln(self, "    return done;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "/* up to max bytes the child wrote to its stdout (which 1) or stderr (2)");
    wln(self, "   pipe, into buf; waits for at least one. 0 once it is closed and empty");
    wln(self, "   (the child ended), -1 when there is no such pipe */");
    wln(self, "int64_t fid_proc_read(int64_t h, int64_t which, int64_t buf, int64_t max) {");
    wln(self, "    PChild* c = __p_child_at(h);");
    wln(self, "    if (!c || max <= 0 || !buf) return -1;");
    wln(self, "    int64_t e = which == 2 ? c->perr : c->pout;");
    wln(self, "    if (e == -1) return -1;");
    wln(self, "#if defined(__wasi__)");
    wln(self, "    return -1;");
    wln(self, "#elif defined(_WIN32)");
    wln(self, "    for (;;) {");
    wln(self, "        DWORD got = 0;");
    wln(self, "        if (!ReadFile((HANDLE)(intptr_t)e, (void*)(intptr_t)buf, (DWORD)(max > 0x40000000 ? 0x40000000 : max), &got, NULL)) {");
    wln(self, "            DWORD er = GetLastError();");
    wln(self, "            return (er == ERROR_BROKEN_PIPE || er == ERROR_HANDLE_EOF) ? 0 : -1;");
    wln(self, "        }");
    wln(self, "        if (got > 0) return (int64_t)got;");
    wln(self, "    }");
    wln(self, "#else");
    wln(self, "    for (;;) {");
    wln(self, "        ssize_t r = read((int)e, (void*)(intptr_t)buf, (size_t)max);");
    wln(self, "        if (r < 0 && errno == EINTR) continue;");
    wln(self, "        return r < 0 ? -1 : (int64_t)r;");
    wln(self, "    }");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "/* close this end of the child's stdin pipe: it reads the end of its input */");
    wln(self, "int64_t fid_proc_close_in(int64_t h) {");
    wln(self, "    PChild* c = __p_child_at(h);");
    wln(self, "    if (!c) return -1;");
    wln(self, "    __p_child_close_end(&c->pin);");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "/* 1 once the child has ended (its code kept), 0 when it is still running");
    wln(self, "   after timeout_ms (< 0: no limit), -1 for a bad handle */");
    wln(self, "int64_t fid_proc_wait(int64_t h, int64_t timeout_ms) {");
    wln(self, "    PChild* c = __p_child_at(h);");
    wln(self, "    if (!c) return -1;");
    wln(self, "    if (c->done) return 1;");
    wln(self, "#if defined(__wasi__)");
    wln(self, "    (void)timeout_ms;");
    wln(self, "    return -1;");
    wln(self, "#elif defined(_WIN32)");
    wln(self, "    DWORD r = WaitForSingleObject(c->ph, timeout_ms < 0 ? INFINITE : (timeout_ms > 0x7ffffffe ? 0x7ffffffe : (DWORD)timeout_ms));");
    wln(self, "    if (r == WAIT_TIMEOUT) return 0;");
    wln(self, "    if (r != WAIT_OBJECT_0) return -1;");
    wln(self, "    DWORD code = 0;");
    wln(self, "    if (!GetExitCodeProcess(c->ph, &code)) return -1;");
    wln(self, "    c->code = (int64_t)(int32_t)code;");
    wln(self, "    c->done = 1;");
    wln(self, "    return 1;");
    wln(self, "#else");
    wln(self, "    struct timespec t0, now;");
    wln(self, "    clock_gettime(CLOCK_MONOTONIC, &t0);");
    wln(self, "    long nap = 1;");
    wln(self, "    for (;;) {");
    wln(self, "        int st = 0;");
    wln(self, "        pid_t r = waitpid((pid_t)c->pid, &st, timeout_ms < 0 ? 0 : WNOHANG);");
    wln(self, "        if (r == (pid_t)c->pid) {");
    wln(self, "            if (WIFEXITED(st)) c->code = (int64_t)WEXITSTATUS(st);");
    wln(self, "            else if (WIFSIGNALED(st)) c->code = 128 + (int64_t)WTERMSIG(st);");
    wln(self, "            else c->code = -1;");
    wln(self, "            c->done = 1;");
    wln(self, "            return 1;");
    wln(self, "        }");
    wln(self, "        if (r < 0) { if (errno == EINTR) continue; return -1; }");
    wln(self, "        clock_gettime(CLOCK_MONOTONIC, &now);");
    wln(self, "        int64_t ms = (int64_t)(now.tv_sec - t0.tv_sec) * 1000 + (int64_t)(now.tv_nsec - t0.tv_nsec) / 1000000;");
    wln(self, "        if (ms >= timeout_ms) return 0;");
    wln(self, "        if (nap > timeout_ms - ms) nap = (long)(timeout_ms - ms);");
    wln(self, "        struct timespec ts;");
    wln(self, "        ts.tv_sec = 0; ts.tv_nsec = nap * 1000000L;");
    wln(self, "        nanosleep(&ts, NULL);");
    wln(self, "        if (nap < 10) nap++;");
    wln(self, "    }");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "/* its exit code once fid_proc_wait said it ended (killed: 128 + the");
    wln(self, "   signal on POSIX, 137 on Windows), else -1 */");
    wln(self, "int64_t fid_proc_code(int64_t h) {");
    wln(self, "    PChild* c = __p_child_at(h);");
    wln(self, "    if (!c || !c->done) return -1;");
    wln(self, "    return c->code;");
    wln(self, "}");
    wln(self, "/* stop it (SIGKILL; TerminateProcess with code 137): 1 when asked, 0 when");
    wln(self, "   it had already ended or could not be stopped */");
    wln(self, "int64_t fid_proc_kill(int64_t h) {");
    wln(self, "    PChild* c = __p_child_at(h);");
    wln(self, "    if (!c || c->done) return 0;");
    wln(self, "#if defined(__wasi__)");
    wln(self, "    return 0;");
    wln(self, "#elif defined(_WIN32)");
    wln(self, "    return TerminateProcess(c->ph, 137) ? 1 : 0;");
    wln(self, "#else");
    wln(self, "    return kill((pid_t)c->pid, SIGKILL) == 0 ? 1 : 0;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t fid_proc_pid(int64_t h) {");
    wln(self, "    PChild* c = __p_child_at(h);");
    wln(self, "    return c ? c->pid : -1;");
    wln(self, "}");
    wln(self, "/* forget the handle (a child still running keeps running) */");
    wln(self, "int64_t fid_proc_free(int64_t h) {");
    wln(self, "    PChild* c = __p_child_at(h);");
    wln(self, "    if (!c) return -1;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    CloseHandle(c->ph);");
    wln(self, "#endif");
    wln(self, "    __p_child_close_end(&c->pin);");
    wln(self, "    __p_child_close_end(&c->pout);");
    wln(self, "    __p_child_close_end(&c->perr);");
    wln(self, "    c->used = 0;");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "void p_exit(int64_t code) { exit((int)code); }");
    // Filesystem builtins beyond p_file_*
    wln(self, "int64_t p_mkdir(const char* path) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_FS)) return -1;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    return _mkdir(path) == 0 ? 0 : -1;");
    wln(self, "#else");
    wln(self, "    return mkdir(path, 0755) == 0 ? 0 : -1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_rmdir(const char* path) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_FS)) return -1;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    return _rmdir(path) == 0 ? 0 : -1;");
    wln(self, "#else");
    wln(self, "    return rmdir(path) == 0 ? 0 : -1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_rename(const char* a, const char* b) { if (P_CAP_DENIED(P_CAP_FS)) return -1; return rename(a, b) == 0 ? 0 : -1; }");
    wln(self, "bool p_is_dir(const char* path) {");
    wln(self, "    struct stat st;");
    wln(self, "    if (stat(path, &st) != 0) return false;");
    wln(self, "    return (st.st_mode & S_IFMT) == S_IFDIR;");
    wln(self, "}");
    // D9: a file's last-write time in ms since the epoch (-1 when missing),
    // so a cache can key a file's hash by path, size and mtime
    wln(self, "int64_t p_file_mtime_ms(const char* path) {");
    wln(self, "    struct stat st;");
    wln(self, "    if (stat(path, &st) != 0) return -1;");
    wln(self, "#if defined(__APPLE__)");
    wln(self, "    return (int64_t)st.st_mtimespec.tv_sec * 1000 + (int64_t)st.st_mtimespec.tv_nsec / 1000000;");
    wln(self, "#elif (defined(__linux__) && (defined(__USE_XOPEN2K8) || !defined(__GLIBC__))) || defined(__FreeBSD__)");
    wln(self, "    return (int64_t)st.st_mtim.tv_sec * 1000 + (int64_t)st.st_mtim.tv_nsec / 1000000;");
    wln(self, "#else");
    wln(self, "    return (int64_t)st.st_mtime * 1000;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static char* p_dir_list__raw(const char* path);");
    wln(self, "char* p_dir_list(const char* path) { return p_str_own_c(p_dir_list__raw(path)); }");
    wln(self, "static char* p_dir_list__raw(const char* path) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_FS)) { char* e = (char*)p_malloc(1); e[0] = 0; return e; }");
    wln(self, "    // entry names joined by '\\n', no \".\"/\"..\"; \"\" on failure");
    wln(self, "    size_t need = 1;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    WIN32_FIND_DATAA fd; char pat[2056];");
    wln(self, "    snprintf(pat, sizeof pat, \"%s\\\\*\", path);");
    wln(self, "    HANDLE h = FindFirstFileA(pat, &fd);");
    wln(self, "    if (h == INVALID_HANDLE_VALUE) { char* e = (char*)p_malloc(1); e[0] = 0; return e; }");
    wln(self, "    do {");
    wln(self, "        if (strcmp(fd.cFileName, \".\") && strcmp(fd.cFileName, \"..\"))");
    wln(self, "            need += strlen(fd.cFileName) + 1;");
    wln(self, "    } while (FindNextFileA(h, &fd));");
    wln(self, "    FindClose(h);");
    wln(self, "    char* out = (char*)p_malloc((int64_t)need);");
    wln(self, "    out[0] = 0;");
    wln(self, "    h = FindFirstFileA(pat, &fd);");
    wln(self, "    if (h == INVALID_HANDLE_VALUE) return out;");
    // BG68: the second pass writes no more than the first one counted (an
    // entry made between the passes overflowed the buffer: it is left out)
    wln(self, "    size_t used = 0;");
    wln(self, "    do {");
    wln(self, "        if (strcmp(fd.cFileName, \".\") && strcmp(fd.cFileName, \"..\")) {");
    wln(self, "            size_t nl = strlen(fd.cFileName), sep = used > 0 ? 1 : 0;");
    wln(self, "            if (used + sep + nl + 1 > need) continue;");
    wln(self, "            if (sep) out[used++] = '\\n';");
    wln(self, "            memcpy(out + used, fd.cFileName, nl); used += nl; out[used] = 0;");
    wln(self, "        }");
    wln(self, "    } while (FindNextFileA(h, &fd));");
    wln(self, "    FindClose(h);");
    wln(self, "    return out;");
    wln(self, "#else");
    wln(self, "    DIR* d = opendir(path);");
    wln(self, "    if (!d) { char* e = (char*)p_malloc(1); e[0] = 0; return e; }");
    wln(self, "    struct dirent* ent;");
    wln(self, "    while ((ent = readdir(d)) != NULL) {");
    wln(self, "        if (strcmp(ent->d_name, \".\") && strcmp(ent->d_name, \"..\"))");
    wln(self, "            need += strlen(ent->d_name) + 1;");
    wln(self, "    }");
    wln(self, "    rewinddir(d);");
    wln(self, "    char* out = (char*)p_malloc((int64_t)need);");
    wln(self, "    out[0] = 0;");
    wln(self, "    size_t used = 0;");
    wln(self, "    while ((ent = readdir(d)) != NULL) {");
    wln(self, "        if (strcmp(ent->d_name, \".\") && strcmp(ent->d_name, \"..\")) {");
    wln(self, "            size_t nl = strlen(ent->d_name), sep = used > 0 ? 1 : 0;");
    wln(self, "            if (used + sep + nl + 1 > need) continue;");
    wln(self, "            if (sep) out[used++] = '\\n';");
    wln(self, "            memcpy(out + used, ent->d_name, nl); used += nl; out[used] = 0;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    closedir(d);");
    wln(self, "    return out;");
    wln(self, "#endif");
    wln(self, "}");
    // Wall-clock timing builtins - use clock_gettime(CLOCK_REALTIME)
    wln(self, "#if defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__)");
    wln(self, "#include <time.h>");
    wln(self, "int64_t p_clock_now(void) { struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); return (int64_t)ts.tv_sec * 1000000000LL + (int64_t)ts.tv_nsec; }");
    wln(self, "int64_t p_clock_now_us(void) { struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); return (int64_t)ts.tv_sec * 1000000LL + (int64_t)ts.tv_nsec / 1000; }");
    wln(self, "int64_t p_clock_now_ms(void) { struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); return (int64_t)ts.tv_sec * 1000LL + (int64_t)ts.tv_nsec / 1000000; }");
    // C6: deadlines (timeout blocks, tokens) are on a clock a change of
    // the wall clock does not move
    wln(self, "int64_t p_clock_mono_ms(void) { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return (int64_t)ts.tv_sec * 1000LL + (int64_t)ts.tv_nsec / 1000000; }");
    wln(self, "#elif defined(_WIN32)");
    wln(self, "#include <windows.h>");
    wln(self, "/* 100 ns units since 1970: the precise clock (time() has 1 s resolution) */");
    wln(self, "static int64_t __p_now_100ns(void) {");
    wln(self, "    FILETIME ft;");
    wln(self, "#if defined(__TINYC__)");
    wln(self, "    GetSystemTimeAsFileTime(&ft);");
    wln(self, "#else");
    wln(self, "    GetSystemTimePreciseAsFileTime(&ft);");
    wln(self, "#endif");
    wln(self, "    return (int64_t)((((uint64_t)ft.dwHighDateTime) << 32) | ft.dwLowDateTime) - 116444736000000000LL;");
    wln(self, "}");
    wln(self, "int64_t p_clock_now(void) { return __p_now_100ns() * 100; }");
    wln(self, "int64_t p_clock_now_us(void) { return __p_now_100ns() / 10; }");
    wln(self, "int64_t p_clock_now_ms(void) { return __p_now_100ns() / 10000; }");
    wln(self, "int64_t p_clock_mono_ms(void) { return (int64_t)GetTickCount64(); }");
    wln(self, "#else");
    wln(self, "#include <time.h>");
    wln(self, "int64_t p_clock_now(void) { return (int64_t)time(NULL) * 1000000000LL; }");
    wln(self, "int64_t p_clock_now_us(void) { return (int64_t)time(NULL) * 1000000LL; }");
    wln(self, "int64_t p_clock_now_ms(void) { return (int64_t)time(NULL) * 1000LL; }");
    wln(self, "int64_t p_clock_mono_ms(void) { return (int64_t)time(NULL) * 1000LL; }");
    wln(self, "#endif");
    wln(self, "/* 64 random bits from the operating system's secure generator */");
    wln(self, "#ifdef _WIN32");
    wln(self, "int rand_s(unsigned int* v);");
    wln(self, "int64_t p_os_random_u64(void) {");
    wln(self, "    unsigned int a = 0, b = 0;");
    wln(self, "    if (rand_s(&a) != 0 || rand_s(&b) != 0) p_panic(\"no random source in the operating system\");");
    wln(self, "    return (int64_t)(((uint64_t)a << 32) | b);");
    wln(self, "}");
    wln(self, "#else");
    wln(self, "#include <fcntl.h>");
    wln(self, "#include <unistd.h>");
    wln(self, "int64_t p_os_random_u64(void) {");
    wln(self, "    uint64_t v = 0;");
    wln(self, "    int fd = open(\"/dev/urandom\", O_RDONLY);");
    wln(self, "    if (fd < 0 || read(fd, &v, sizeof v) != (ssize_t)sizeof v) p_panic(\"no random source in the operating system\");");
    wln(self, "    close(fd);");
    wln(self, "    return (int64_t)v;");
    wln(self, "}");
    wln(self, "#endif");
    // Regex builtin - simple wildcard match (? and *)
    wln(self, "bool p_regex_match(const char* s, const char* pattern) {");
    wln(self, "    if (!s || !pattern) return false;");
    wln(self, "    int64_t si = 0, pi = 0, s_len = (int64_t)strlen(s), p_len = (int64_t)strlen(pattern);");
    wln(self, "    int64_t star_s = -1, star_p = -1;");
    wln(self, "    while (si < s_len) {");
    wln(self, "        if (pi < p_len && (pattern[pi] == '?' || pattern[pi] == s[si])) { si++; pi++; }");
    wln(self, "        else if (pi < p_len && pattern[pi] == '*') { star_p = pi; star_s = si; pi++; }");
    wln(self, "        else if (star_p >= 0) { pi = star_p + 1; si = star_s + 1; star_s = si; }");
    wln(self, "        else return false;");
    wln(self, "    }");
    wln(self, "    while (pi < p_len && pattern[pi] == '*') pi++;");
    wln(self, "    return pi == p_len;");
    wln(self, "}");
    // -- Global string interner ----------------------------------------------
    // Interns strings so identical content - same pointer. Enables == (pointer
    // equality) instead of p_str_equal (byte-by-byte) in hot paths.
    // Uses a simple open-addressing hash table with linear probing.
    wln(self, "static char** __p_intern_table = NULL;");
    wln(self, "static int64_t __p_intern_cap = 0;");
    wln(self, "static int64_t __p_intern_count = 0;");
    wln(self, "static int64_t __p_intern_hash(const char* s) {");
    wln(self, "    int64_t h = 1469598103934665603ULL;");
    wln(self, "    while (*s) { h ^= (unsigned char)*s; h *= 1099511628211ULL; s++; }");
    wln(self, "    return h;");
    wln(self, "}");
    wln(self, "static void __p_intern_grow(void) {");
    wln(self, "    int64_t new_cap = __p_intern_cap == 0 ? 4096 : __p_intern_cap * 2;");
    wln(self, "    char** new_table = (char**)calloc(new_cap, sizeof(char*));");
    wln(self, "    if (!new_table) __p_oom((size_t)new_cap * sizeof(char*));");
    wln(self, "    for (int64_t i = 0; i < __p_intern_cap; i++) {");
    wln(self, "        if (__p_intern_table[i]) {");
    wln(self, "            int64_t h = __p_intern_hash(__p_intern_table[i]) & (new_cap - 1);");
    wln(self, "            while (new_table[h]) h = (h + 1) & (new_cap - 1);");
    wln(self, "            new_table[h] = __p_intern_table[i];");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    free(__p_intern_table);");
    wln(self, "    __p_intern_table = new_table;");
    wln(self, "    __p_intern_cap = new_cap;");
    wln(self, "}");
    wln(self, "const char* p_intern_str(const char* s) {");
    wln(self, "    if (!s) return NULL;");
    wln(self, "    if (__p_intern_count * 2 >= __p_intern_cap) __p_intern_grow();");
    wln(self, "    int64_t mask = __p_intern_cap - 1;");
    wln(self, "    int64_t h = __p_intern_hash(s) & mask;");
    wln(self, "    while (__p_intern_table[h]) {");
    wln(self, "        if (strcmp(__p_intern_table[h], s) == 0) {");
    wln(self, "            return __p_intern_table[h];");
    wln(self, "        }");
    wln(self, "        h = (h + 1) & mask;");
    wln(self, "    }");
    wln(self, "    __p_intern_table[h] = (char*)s;");
    wln(self, "    __p_intern_count++;");
    wln(self, "    return s;");
    wln(self, "}");
    // Async/await runtime (Phase 7.6 + 8A)
    // Future model: p_future_ready wraps a value directly (eager).
    // p_thread_spawn returns a negative handle (-1, -2, ...) for thread-based futures.
    // p_future_poll: a thread future (P_FT_IS, BG73) joins the thread; any other word is an eager value.
    wln(self, "#ifdef _WIN32");
    wln(self, "typedef struct { HANDLE h; void* ret; void* (*fn)(void*); void* arg; } __p_win_thread;");
    wln(self, "typedef __p_win_thread* pthread_t;");
    wln(self, "typedef CRITICAL_SECTION pthread_mutex_t;");
    wln(self, "typedef CONDITION_VARIABLE pthread_cond_t;");
    wln(self, "typedef DWORD pthread_key_t;");
    wln(self, "static DWORD WINAPI __p_thread_start(LPVOID p) { __p_win_thread* t = (__p_win_thread*)p; t->ret = t->fn(t->arg); return 0; }");
    wln(self, "static inline int pthread_create(pthread_t* t, void* attr, void* (*fn)(void*), void* arg) { (void)attr; __p_win_thread* w = (__p_win_thread*)malloc(sizeof(__p_win_thread)); if (!w) return -1; w->ret = NULL; w->fn = fn; w->arg = arg; w->h = CreateThread(NULL, 64 * 1024 * 1024, __p_thread_start, w, STACK_SIZE_PARAM_IS_A_RESERVATION, NULL); if (!w->h) { free(w); p_panic(\"could not start a thread\"); } *t = w; return 0; }");
    wln(self, "static inline int pthread_join(pthread_t t, void** ret) { WaitForSingleObject(t->h, INFINITE); CloseHandle(t->h); if (ret) *ret = t->ret; free(t); return 0; }");
    wln(self, "static inline int pthread_mutex_init(pthread_mutex_t* m, void* a) { (void)a; InitializeCriticalSection(m); return 0; }");
    wln(self, "static inline int pthread_mutex_lock(pthread_mutex_t* m) { EnterCriticalSection(m); return 0; }");
    wln(self, "static inline int pthread_mutex_unlock(pthread_mutex_t* m) { LeaveCriticalSection(m); return 0; }");
    wln(self, "static inline int pthread_cond_init(pthread_cond_t* c, void* a) { (void)a; InitializeConditionVariable(c); return 0; }");
    wln(self, "static inline int pthread_cond_wait(pthread_cond_t* c, pthread_mutex_t* m) { SleepConditionVariableCS(c, m, INFINITE); return 0; }");
    wln(self, "static inline int pthread_cond_signal(pthread_cond_t* c) { WakeConditionVariable(c); return 0; }");
    wln(self, "static inline int pthread_cond_broadcast(pthread_cond_t* c) { WakeAllConditionVariable(c); return 0; }");
    wln(self, "static inline int pthread_key_create(pthread_key_t* k, void(*d)(void*)) { (void)d; *k = TlsAlloc(); return *k == TLS_OUT_OF_INDEXES ? -1 : 0; }");
    wln(self, "static inline void* pthread_getspecific(pthread_key_t k) { return TlsGetValue(k); }");
    wln(self, "static inline int pthread_setspecific(pthread_key_t k, const void* v) { return TlsSetValue(k, (LPVOID)v) ? 0 : -1; }");
    wln(self, "#else");
    wln(self, "#include <pthread.h>");
    wln(self, "#endif");
    wln(self, "int64_t p_future_ready(int64_t value) { return value; }");
    // BG73: a thread future was -(slot + 1), so an eager future holding a
    // negative value (an async fn's result -5, a negative f64's bits, a
    // non-call `spawn -3`) was taken for a thread: awaiting it joined an
    // unrelated thread or gave 0. It is tagged now, as a green task is
    // (0x7FA5): 0x7FA4 in the top 16 bits, the slot below; every other
    // word is an eager value
    wln(self, "#define P_FT_TAG 0x7FA4ULL");
    wln(self, "#define P_FT_FUT(idx) ((int64_t)((P_FT_TAG << 48) | (uint64_t)(idx)))");
    wln(self, "#define P_FT_IS(f) (((uint64_t)(f) >> 48) == P_FT_TAG)");
    wln(self, "#define P_FT_IDX(f) ((int64_t)((uint64_t)(f) & 0xFFFFFFFFFFFFULL))");
    // Thread join table: BG9, the future table (__p_ft_*) is defined with
    // the executor below, once the atomics are
    wln(self, "static int64_t __p_co_await(int64_t future);");
    wln(self, "static int64_t __p_ft_poll(int64_t future);");
    wln(self, "int64_t p_future_poll(int64_t future) {");
    wln(self, "    if (((uint64_t)future >> 48) == 0x7FA5) return __p_co_await(future);");
    wln(self, "    // Thread-based future: join and get result (BG9: __p_ft_poll)");
    wln(self, "    if (P_FT_IS(future)) return __p_ft_poll(future);");
    wln(self, "    return future; // eager future (BG73: negative values included)");
    wln(self, "}");
    // --- Phase 8A: Threads + atomics + mutex (using pthread) ---
    wln(self, "#ifndef _WIN32");
    wln(self, "#include <stdatomic.h>");
    wln(self, "#endif");
    wln(self, "#ifdef _WIN32");
    wln(self, "typedef long long atomic_int;");
    wln(self, "typedef long long atomic_int_least64_t;");
    wln(self, "static inline long long _p_atomic_load64(atomic_int_least64_t* a) { return InterlockedCompareExchange64(a, 0, 0); }");
    wln(self, "static inline void _p_atomic_store64(atomic_int_least64_t* a, long long v) { InterlockedExchange64(a, v); }");
    wln(self, "static inline long long _p_atomic_add64(atomic_int_least64_t* a, long long v) { return InterlockedExchangeAdd64(a, v); }");
    wln(self, "static inline long long _p_atomic_sub64(atomic_int_least64_t* a, long long v) { return InterlockedExchangeAdd64(a, -v); }");
    wln(self, "static inline int _p_atomic_cas64(atomic_int_least64_t* a, long long* e, long long v) { long long o = InterlockedCompareExchange64(a, v, *e); if (o == *e) return 1; *e = o; return 0; }");
    wln(self, "#define atomic_load(a) _p_atomic_load64((atomic_int_least64_t*)(a))");
    wln(self, "#define atomic_store(a, v) _p_atomic_store64((atomic_int_least64_t*)(a), (v))");
    wln(self, "#define atomic_fetch_add(a, v) _p_atomic_add64((atomic_int_least64_t*)(a), (v))");
    wln(self, "#define atomic_fetch_sub(a, v) _p_atomic_sub64((atomic_int_least64_t*)(a), (v))");
    wln(self, "#define atomic_compare_exchange_strong(a, e, v) _p_atomic_cas64((atomic_int_least64_t*)(a), (e), (v))");
    wln(self, "#define atomic_init(a, v) (*(a) = (v))");
    wln(self, "#endif");
    wln(self, "#include <stdarg.h>");
    // Thread entry point - calls a Fides function by name with i64 args.
    // The function lookup uses a simple dispatch table generated below.
    wln(self, "typedef struct { const char* name; int64_t (*fn)(); } p_thread_entry_t;");
    wln(self, "static p_thread_entry_t p_thread_entries[8192];");
    wln(self, "static int p_thread_entry_count = 0;");
    wln(self, "void p_thread_register(const char* name, int64_t (*fn)()) {");
    wln(self, "    if (p_thread_entry_count < 8192) {");
    wln(self, "        p_thread_entries[p_thread_entry_count].name = name;");
    wln(self, "        p_thread_entries[p_thread_entry_count].fn = fn;");
    wln(self, "        p_thread_entry_count++;");
    wln(self, "    }");
    wln(self, "}");
    // CI6: caps, the capabilities of the code that started the thread (a
    // thread started inside fides_call can do no more than the call)
    wln(self, "typedef struct { int64_t (*fn)(); int64_t nargs; int64_t args[8]; atomic_int* done; uint64_t caps; } p_thread_arg_t;");
    // LG11: the stack size of the tasks a thread starts from now on. fid
    // run's interpreter (compiler/interp.fd) runs each interpreted task on
    // a task of its own and asks for stacks as deep as its main thread's.
    // A program declares it `extern "C" fn p_co_stack(bytes: i64) -> i64;`.
    wln(self, "/* LG11: p_co_stack(bytes) sets the stack of the tasks this thread starts");
    wln(self, "   from now on (0: the default, 256 KB on POSIX, 1 MB on Windows) and");
    wln(self, "   returns the size asked for before (0: the default). Only address space");
    wln(self, "   is taken: pages are committed as the stack grows. -2: tasks cannot");
    wln(self, "   switch here (P_NO_CTX, WebAssembly), nothing changes. Also reached as");
    wln(self, "   p_thread_spawn(\"__p_co_stack\", 1, bytes). */");
    wln(self, "static P_THREAD_LOCAL int64_t __p_co_stack_req = 0;");
    wln(self, "#ifdef P_MN");
    wln(self, "static int64_t __p_mn_stack(int64_t bytes);");
    wln(self, "#endif");
    wln(self, "int64_t p_co_stack(int64_t bytes) {");
    wln(self, "#ifdef P_NO_CTX");
    wln(self, "    (void)bytes;");
    wln(self, "    return -2;");
    wln(self, "#elif defined(P_MN)");
    wln(self, "    return __p_mn_stack(bytes);");
    wln(self, "#else");
    wln(self, "    int64_t was = __p_co_stack_req;");
    wln(self, "    __p_co_stack_req = bytes > 0 ? ((bytes + 65535) & ~(int64_t)65535) : 0;");
    wln(self, "    return was;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "/* Task context switch on POSIX (release F5/F8): callee-saved registers");
    wln(self, "   and the stack pointer, in assembly for x86-64, AArch64 and RISC-V 64.");
    wln(self, "   musl has no ucontext and macOS deprecates it; ucontext stays the");
    wln(self, "   fallback for other compilers and architectures. */");
    wln(self, "/* Windows x64 (RT9): the same switch, which also saves xmm6-15 and the");
    wln(self, "   stack fields of the TEB (StackBase, StackLimit, DeallocationStack), so");
    wln(self, "   the system grows a task stack and reports its overflow as for a thread. */");
    wln(self, "#if defined(_WIN32) && defined(__x86_64__) && !defined(__TINYC__) && (defined(__GNUC__) || defined(__clang__))");
    wln(self, "#define P_OWN_CTX 1");
    wln(self, "#define P_WIN_CTX 1");
    wln(self, "#endif");
    wln(self, "#if !defined(_WIN32) && !defined(__TINYC__) && (defined(__GNUC__) || defined(__clang__)) && (defined(__x86_64__) || defined(__aarch64__) || (defined(__riscv) && __riscv_xlen == 64))");
    wln(self, "#define P_OWN_CTX 1");
    wln(self, "#endif");
    wln(self, "#if !defined(_WIN32) && !defined(P_OWN_CTX) && !defined(P_NO_CTX)");
    wln(self, "#include <ucontext.h>");
    wln(self, "#endif");
    wln(self, "#ifdef P_OWN_CTX");
    wln(self, "#ifdef __APPLE__");
    wln(self, "#define P_CSYM(n) \"_\" #n");
    wln(self, "#else");
    wln(self, "#define P_CSYM(n) #n");
    wln(self, "#endif");
    wln(self, "void __p_ctx_swap(void** save_sp, void* to_sp);");
    wln(self, "void __p_ctx_tramp(void);");
    wln(self, "#if defined(P_WIN_CTX)");
    wln(self, "__asm__(\".text\\n.p2align 4\\n.globl __p_ctx_swap\\n__p_ctx_swap:\\n\"");
    wln(self, "    \"  pushq %rbp\\n  pushq %rbx\\n  pushq %rdi\\n  pushq %rsi\\n  pushq %r12\\n  pushq %r13\\n  pushq %r14\\n  pushq %r15\\n  subq $184, %rsp\\n\"");
    wln(self, "    \"  movdqu %xmm6, 0(%rsp)\\n  movdqu %xmm7, 16(%rsp)\\n  movdqu %xmm8, 32(%rsp)\\n  movdqu %xmm9, 48(%rsp)\\n  movdqu %xmm10, 64(%rsp)\\n  movdqu %xmm11, 80(%rsp)\\n  movdqu %xmm12, 96(%rsp)\\n  movdqu %xmm13, 112(%rsp)\\n  movdqu %xmm14, 128(%rsp)\\n  movdqu %xmm15, 144(%rsp)\\n\"");
    wln(self, "    \"  movq %gs:8, %rax\\n  movq %rax, 160(%rsp)\\n  movq %gs:16, %rax\\n  movq %rax, 168(%rsp)\\n  movq %gs:0x1478, %rax\\n  movq %rax, 176(%rsp)\\n\"");
    wln(self, "    \"  movq %rsp, (%rcx)\\n  movq %rdx, %rsp\\n\"");
    wln(self, "    \"  movq 160(%rsp), %rax\\n  movq %rax, %gs:8\\n  movq 168(%rsp), %rax\\n  movq %rax, %gs:16\\n  movq 176(%rsp), %rax\\n  movq %rax, %gs:0x1478\\n\"");
    wln(self, "    \"  movdqu 0(%rsp), %xmm6\\n  movdqu 16(%rsp), %xmm7\\n  movdqu 32(%rsp), %xmm8\\n  movdqu 48(%rsp), %xmm9\\n  movdqu 64(%rsp), %xmm10\\n  movdqu 80(%rsp), %xmm11\\n  movdqu 96(%rsp), %xmm12\\n  movdqu 112(%rsp), %xmm13\\n  movdqu 128(%rsp), %xmm14\\n  movdqu 144(%rsp), %xmm15\\n\"");
    wln(self, "    \"  addq $184, %rsp\\n  popq %r15\\n  popq %r14\\n  popq %r13\\n  popq %r12\\n  popq %rsi\\n  popq %rdi\\n  popq %rbx\\n  popq %rbp\\n  ret\\n\"");
    wln(self, "    \".p2align 4\\n.globl __p_ctx_tramp\\n__p_ctx_tramp:\\n\"");
    wln(self, "    \"  movq %r12, %rcx\\n  andq $-16, %rsp\\n  subq $32, %rsp\\n  callq *%r13\\n  ud2\\n\");");
    wln(self, "#elif defined(__x86_64__)");
    wln(self, "__asm__(\".text\\n.p2align 4\\n.globl \" P_CSYM(__p_ctx_swap) \"\\n\" P_CSYM(__p_ctx_swap) \":\\n\"");
    wln(self, "    \"  pushq %rbp\\n  pushq %rbx\\n  pushq %r12\\n  pushq %r13\\n  pushq %r14\\n  pushq %r15\\n\"");
    wln(self, "    \"  movq %rsp, (%rdi)\\n  movq %rsi, %rsp\\n\"");
    wln(self, "    \"  popq %r15\\n  popq %r14\\n  popq %r13\\n  popq %r12\\n  popq %rbx\\n  popq %rbp\\n  ret\\n\"");
    wln(self, "    \".p2align 4\\n.globl \" P_CSYM(__p_ctx_tramp) \"\\n\" P_CSYM(__p_ctx_tramp) \":\\n\"");
    wln(self, "    \"  andq $-16, %rsp\\n  movq %r12, %rdi\\n  callq *%r13\\n  ud2\\n\");");
    wln(self, "#elif defined(__aarch64__)");
    wln(self, "__asm__(\".text\\n.p2align 2\\n.globl \" P_CSYM(__p_ctx_swap) \"\\n\" P_CSYM(__p_ctx_swap) \":\\n\"");
    wln(self, "    \"  sub sp, sp, #176\\n\"");
    wln(self, "    \"  stp x19, x20, [sp, #0]\\n  stp x21, x22, [sp, #16]\\n  stp x23, x24, [sp, #32]\\n\"");
    wln(self, "    \"  stp x25, x26, [sp, #48]\\n  stp x27, x28, [sp, #64]\\n  stp x29, x30, [sp, #80]\\n\"");
    wln(self, "    \"  stp d8, d9, [sp, #96]\\n  stp d10, d11, [sp, #112]\\n  stp d12, d13, [sp, #128]\\n  stp d14, d15, [sp, #144]\\n\"");
    wln(self, "    \"  mov x2, sp\\n  str x2, [x0]\\n  mov sp, x1\\n\"");
    wln(self, "    \"  ldp x19, x20, [sp, #0]\\n  ldp x21, x22, [sp, #16]\\n  ldp x23, x24, [sp, #32]\\n\"");
    wln(self, "    \"  ldp x25, x26, [sp, #48]\\n  ldp x27, x28, [sp, #64]\\n  ldp x29, x30, [sp, #80]\\n\"");
    wln(self, "    \"  ldp d8, d9, [sp, #96]\\n  ldp d10, d11, [sp, #112]\\n  ldp d12, d13, [sp, #128]\\n  ldp d14, d15, [sp, #144]\\n\"");
    wln(self, "    \"  add sp, sp, #176\\n  ret\\n\"");
    wln(self, "    \".p2align 2\\n.globl \" P_CSYM(__p_ctx_tramp) \"\\n\" P_CSYM(__p_ctx_tramp) \":\\n\"");
    wln(self, "    \"  mov x0, x19\\n  blr x20\\n  brk #0\\n\");");
    wln(self, "#else");
    wln(self, "#if defined(__riscv_flen) && __riscv_flen >= 64");
    wln(self, "#define P_RV_FS(op) \"  \" op \" fs0, 104(sp)\\n  \" op \" fs1, 112(sp)\\n  \" op \" fs2, 120(sp)\\n  \" op \" fs3, 128(sp)\\n  \" op \" fs4, 136(sp)\\n  \" op \" fs5, 144(sp)\\n  \" op \" fs6, 152(sp)\\n  \" op \" fs7, 160(sp)\\n  \" op \" fs8, 168(sp)\\n  \" op \" fs9, 176(sp)\\n  \" op \" fs10, 184(sp)\\n  \" op \" fs11, 192(sp)\\n\"");
    wln(self, "#else");
    wln(self, "#define P_RV_FS(op) \"\"");
    wln(self, "#endif");
    wln(self, "#define P_RV_S(op) \"  \" op \" ra, 0(sp)\\n  \" op \" s0, 8(sp)\\n  \" op \" s1, 16(sp)\\n  \" op \" s2, 24(sp)\\n  \" op \" s3, 32(sp)\\n  \" op \" s4, 40(sp)\\n  \" op \" s5, 48(sp)\\n  \" op \" s6, 56(sp)\\n  \" op \" s7, 64(sp)\\n  \" op \" s8, 72(sp)\\n  \" op \" s9, 80(sp)\\n  \" op \" s10, 88(sp)\\n  \" op \" s11, 96(sp)\\n\"");
    wln(self, "__asm__(\".text\\n.p2align 2\\n.globl \" P_CSYM(__p_ctx_swap) \"\\n\" P_CSYM(__p_ctx_swap) \":\\n\"");
    wln(self, "    \"  addi sp, sp, -208\\n\" P_RV_S(\"sd\") P_RV_FS(\"fsd\")");
    wln(self, "    \"  sd sp, 0(a0)\\n  mv sp, a1\\n\"");
    wln(self, "    P_RV_S(\"ld\") P_RV_FS(\"fld\") \"  addi sp, sp, 208\\n  ret\\n\"");
    wln(self, "    \".p2align 2\\n.globl \" P_CSYM(__p_ctx_tramp) \"\\n\" P_CSYM(__p_ctx_tramp) \":\\n\"");
    wln(self, "    \"  mv a0, s1\\n  jalr s2\\n  ebreak\\n\");");
    wln(self, "#endif");
    wln(self, "/* A new task's stack, laid out as __p_ctx_swap leaves it: its first switch");
    wln(self, "   \"returns\" into __p_ctx_tramp, which calls entry(arg). */");
    wln(self, "#ifdef P_WIN_CTX");
    wln(self, "#define P_CO_RESERVE (1024 * 1024)");
    wln(self, "#define P_CO_COMMIT (16 * 1024)");
    wln(self, "static char* __p_win_stack_n(int64_t reserve) {");
    wln(self, "    char* base = (char*)VirtualAlloc(NULL, (SIZE_T)reserve, MEM_RESERVE, PAGE_READWRITE);");
    wln(self, "    if (!base) return NULL;");
    wln(self, "    char* top = base + reserve;");
    wln(self, "    if (!VirtualAlloc(top - P_CO_COMMIT, P_CO_COMMIT, MEM_COMMIT, PAGE_READWRITE)) return NULL;");
    wln(self, "    VirtualAlloc(top - P_CO_COMMIT - 4096, 4096, MEM_COMMIT, PAGE_READWRITE | PAGE_GUARD);");
    wln(self, "    return base;");
    wln(self, "}");
    wln(self, "static char* __p_win_stack(void) { return __p_win_stack_n(P_CO_RESERVE); }");
    wln(self, "#endif");
    wln(self, "static void* __p_ctx_init(char* top, void (*entry)(void*), void* arg) {");
    wln(self, "    uintptr_t t = ((uintptr_t)top) & ~(uintptr_t)15;");
    wln(self, "#if defined(P_WIN_CTX)");
    wln(self, "    /* xmm6-15, the TEB stack fields, r15 r14 r13 r12 rsi rdi rbx rbp, ret */");
    wln(self, "    uint64_t* s = (uint64_t*)(t - 256);");
    wln(self, "    memset(s, 0, 256);");
    wln(self, "    s[20] = (uint64_t)t; s[21] = (uint64_t)(t - P_CO_COMMIT); s[22] = (uint64_t)(t - P_CO_RESERVE);");
    wln(self, "    s[25] = (uint64_t)(uintptr_t)entry; s[26] = (uint64_t)(uintptr_t)arg;");
    wln(self, "    s[31] = (uint64_t)(uintptr_t)&__p_ctx_tramp;");
    wln(self, "#elif defined(__x86_64__)");
    wln(self, "    uint64_t* s = (uint64_t*)(t - 64);");
    wln(self, "    memset(s, 0, 64);");
    wln(self, "    s[2] = (uint64_t)(uintptr_t)entry; s[3] = (uint64_t)(uintptr_t)arg;");
    wln(self, "    s[6] = (uint64_t)(uintptr_t)&__p_ctx_tramp;");
    wln(self, "#elif defined(__aarch64__)");
    wln(self, "    uint64_t* s = (uint64_t*)(t - 176);");
    wln(self, "    memset(s, 0, 176);");
    wln(self, "    s[0] = (uint64_t)(uintptr_t)arg; s[1] = (uint64_t)(uintptr_t)entry;");
    wln(self, "    s[11] = (uint64_t)(uintptr_t)&__p_ctx_tramp;");
    wln(self, "#else");
    wln(self, "    uint64_t* s = (uint64_t*)(t - 208);");
    wln(self, "    memset(s, 0, 208);");
    wln(self, "    s[0] = (uint64_t)(uintptr_t)&__p_ctx_tramp;");
    wln(self, "    s[2] = (uint64_t)(uintptr_t)arg; s[3] = (uint64_t)(uintptr_t)entry;");
    wln(self, "#endif");
    wln(self, "    return s;");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "#ifndef _WIN32");
    wln(self, "#include <poll.h>");
    wln(self, "#include <time.h>");
    wln(self, "#endif");
    // RT9: the cost of one task switch on the C path, measured on
    // __p_ctx_swap itself: a ping-pong of n round trips between the caller
    // and a task that only switches back. Returns ns per switch (-1 when the
    // C path has no own context switch: ucontext, fibers, tcc). A program
    // declares it `extern "C" fn p_ctx_switch_bench(n: i64) -> i64;`.
    wln(self, "#ifdef P_OWN_CTX");
    wln(self, "static void* __p_bench_main_sp;");
    wln(self, "static void* __p_bench_task_sp;");
    wln(self, "static void __p_bench_body(void* arg) {");
    wln(self, "    (void)arg;");
    wln(self, "    for (;;) __p_ctx_swap(&__p_bench_task_sp, __p_bench_main_sp);");
    wln(self, "}");
    wln(self, "static int64_t __p_bench_ns(void) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    LARGE_INTEGER f, c; QueryPerformanceFrequency(&f); QueryPerformanceCounter(&c);");
    wln(self, "    return (int64_t)((double)c.QuadPart * 1e9 / (double)f.QuadPart);");
    wln(self, "#else");
    wln(self, "    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);");
    wln(self, "    return (int64_t)t.tv_sec * 1000000000LL + (int64_t)t.tv_nsec;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "int64_t p_ctx_switch_bench(int64_t n) {");
    wln(self, "#ifdef P_OWN_CTX");
    wln(self, "    if (n <= 0) return 0;");
    wln(self, "#ifdef P_WIN_CTX");
    wln(self, "    char* base = __p_win_stack();");
    wln(self, "    if (!base) return -1;");
    wln(self, "    char* top = base + P_CO_RESERVE;");
    wln(self, "#else");
    wln(self, "    char* base = (char*)malloc(256 * 1024);");
    wln(self, "    if (!base) return -1;");
    wln(self, "    char* top = base + 256 * 1024;");
    wln(self, "#endif");
    wln(self, "    __p_bench_task_sp = __p_ctx_init(top, __p_bench_body, NULL);");
    // one warm-up round trip: the first switch enters through the trampoline
    wln(self, "    __p_ctx_swap(&__p_bench_main_sp, __p_bench_task_sp);");
    wln(self, "    int64_t t0 = __p_bench_ns();");
    wln(self, "    for (int64_t i = 0; i < n; i++) __p_ctx_swap(&__p_bench_main_sp, __p_bench_task_sp);");
    wln(self, "    int64_t t1 = __p_bench_ns();");
    wln(self, "#ifdef P_WIN_CTX");
    wln(self, "    VirtualFree(base, 0, MEM_RELEASE);");
    wln(self, "#else");
    wln(self, "    free(base);");
    wln(self, "#endif");
    wln(self, "    return (t1 - t0) / (2 * n);");
    wln(self, "#else");
    wln(self, "    (void)n;");
    wln(self, "    return -1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "typedef struct __p_co { int64_t (*fn)(); int64_t nargs; int64_t args[8]; int64_t result; int done; int detached;");
    wln(self, "    struct __p_co* awaits; struct __p_co* back;");
    // CA9: its function, the task waiting for it (alive while it waits) and
    // the function of the task that started it
    wln(self, "    const char* name; struct __p_co* waiter; const char* parent_name;");
    // CA7/CA8: its token slot (a timeout block's token, 0 none; a new task
    // starts with an empty one: calloc)
    wln(self, "    int64_t tok;");
    // proposal 0005: the regions open in the task, kept while it is switched out
    wln(self, "    __p_rstate rs;");
    wln(self, "    int64_t fd; int64_t fd_write; int64_t ready; int64_t wake_ms; int ev; void* evop; int64_t seq; int64_t hidx;");
    // RT11: 1 while the task is parked on the poller, out of __p_cos
    wln(self, "    int parked;");
    // LG11: the size of its stack (p_co_stack when it started)
    wln(self, "    int64_t stack_size;");
    // CI6: its capabilities, those of the code that started it (a task
    // started inside fides_call can do no more than the call, also when it
    // runs after the call returned)
    wln(self, "    uint64_t caps;");
    wln(self, "    /* RT10 (M:N): why it last switched out (P_LV_*) and on what (the task");
    wln(self, "       awaited, the channel; lvarg: a send), its link (global queue, waiter");
    wln(self, "       lists, the poller's inbox), the tasks awaiting it, its lock, 1 once");
    wln(self, "       it ended and its waiters were woken, 1 when a thread off the workers");
    wln(self, "       awaits it, 1 when started off main, the stack of the tasks it starts,");
    wln(self, "       its place in the poller's poll set (-1 none) */");
    wln(self, "    int lv; int lvarg; void* lvobj; struct __p_co* qnext; struct __p_co* joiners;");
    wln(self, "    int lk; int settled; int extw; int origin; int64_t stack_req; int64_t fbi;");
    wln(self, "#if defined(_WIN32) && !defined(P_OWN_CTX)");
    wln(self, "    void* fiber;");
    wln(self, "#elif defined(P_OWN_CTX)");
    wln(self, "    void* sp; char* stack;");
    wln(self, "#elif defined(P_NO_CTX)");
    wln(self, "    char* stack;");
    wln(self, "#else");
    wln(self, "    ucontext_t ctx; char* stack;");
    wln(self, "#endif");
    wln(self, "} __p_co;");
    wln(self, "static P_THREAD_LOCAL __p_co** __p_cos = NULL;");
    wln(self, "static P_THREAD_LOCAL int64_t __p_co_count = 0;");
    wln(self, "static P_THREAD_LOCAL int64_t __p_co_cap = 0;");
    wln(self, "static P_THREAD_LOCAL int64_t __p_co_total = 0;");
    wln(self, "static P_THREAD_LOCAL __p_co* __p_co_cur = NULL;");
    wln(self, "/* RT10: M:N (the workers, \"M:N tasks\" below); 0 not decided (no task yet),");
    wln(self, "   1 one scheduler per thread, n workers */");
    wln(self, "#ifdef P_MN");
    wln(self, "static int __p_mn = 0;");
    wln(self, "static int __p_mn_nw = 0;");
    wln(self, "static int64_t __p_mn_live = 0;");
    wln(self, "static int64_t __p_mn_total = 0;");
    wln(self, "#define P_AL(p) __atomic_load_n((p), __ATOMIC_SEQ_CST)");
    wln(self, "#define P_AS(p, v) __atomic_store_n((p), (v), __ATOMIC_SEQ_CST)");
    wln(self, "#define P_AADD(p, v) __atomic_add_fetch((p), (v), __ATOMIC_SEQ_CST)");
    wln(self, "#define P_ACAS(p, e, v) __atomic_compare_exchange_n((p), (e), (v), 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)");
    wln(self, "static inline int __p_mn_on(void) { return __atomic_load_n(&__p_mn, __ATOMIC_ACQUIRE) > 1; }");
    wln(self, "static int __p_mn_init(void);");
    wln(self, "static void __p_mn_settle(__p_co* c);");
    wln(self, "static void __p_mn_ready(__p_co* c, int sched);");
    wln(self, "static void __p_pl_woke(__p_co* c);");
    wln(self, "static void __p_chan_settle(__p_co* c);");
    wln(self, "static __p_co* __p_co_self(void);");
    wln(self, "#else");
    wln(self, "#define __p_mn_on() 0");
    wln(self, "#endif");
    // CA7/CA8: the token slot of the running task (its __p_co's tok), and
    // of the code outside tasks on this thread
    wln(self, "/* CA7/CA8: a timeout block's token (lower.fd Lowerer_to_enter) is three");
    wln(self, "   words: [cancelled][deadline, p_clock_mono_ms's clock, 0 none][the token");
    wln(self, "   the slot held before]. The builtin waits (p_co_sleep, await, channel");
    wln(self, "   send and receive, socket waits) look at the slot's token, and the ones");
    wln(self, "   it replaced, every 10 ms at most, and give up once one is cancelled or");
    wln(self, "   past its deadline. With an empty slot they wait as before. */");
    wln(self, "static P_THREAD_LOCAL int64_t __p_tok_outside = 0;");
    wln(self, "P_MN_NOINLINE int64_t p_task_token(void) { return __p_co_cur ? __p_co_cur->tok : __p_tok_outside; }");
    wln(self, "P_MN_NOINLINE int64_t p_task_set_token(int64_t t) { int64_t* s = __p_co_cur ? &__p_co_cur->tok : &__p_tok_outside; int64_t o = *s; *s = t; return o; }");
    wln(self, "static int __p_tok_cancelled(int64_t tok) {");
    wln(self, "    int64_t now = 0;");
    wln(self, "    for (int depth = 0; tok && depth < 64; depth++) {");
    wln(self, "        int64_t* w = (int64_t*)(intptr_t)tok;");
    wln(self, "        if (atomic_load((atomic_int_least64_t*)w)) return 1;");
    wln(self, "        int64_t dl = atomic_load((atomic_int_least64_t*)(w + 1));");
    wln(self, "        if (dl) {");
    wln(self, "            if (!now) now = p_clock_mono_ms();");
    wln(self, "            if (now >= dl) { atomic_store((atomic_int_least64_t*)w, 1); return 1; }");
    wln(self, "        }");
    wln(self, "        tok = atomic_load((atomic_int_least64_t*)(w + 2));");
    wln(self, "    }");
    wln(self, "    return 0;");
    wln(self, "}");
    // the next slice of a wait of `left` ms (-1: no limit): 10 ms at most,
    // and no later than the first deadline on the token's chain
    wln(self, "static int64_t __p_tok_slice(int64_t tok, int64_t left) {");
    wln(self, "    int64_t s = 10;");
    wln(self, "    if (left >= 0 && left < s) s = left;");
    wln(self, "    int64_t now = p_clock_mono_ms();");
    wln(self, "    for (int depth = 0; tok && depth < 64; depth++) {");
    wln(self, "        int64_t* w = (int64_t*)(intptr_t)tok;");
    wln(self, "        int64_t dl = atomic_load((atomic_int_least64_t*)(w + 1));");
    wln(self, "        if (dl) { int64_t r = dl > now ? dl - now : 0; if (r < s) s = r; }");
    wln(self, "        tok = atomic_load((atomic_int_least64_t*)(w + 2));");
    wln(self, "    }");
    wln(self, "    return s;");
    wln(self, "}");
    wln(self, "/* CA9: a panic's trace shows only the running task's own stack; this");
    wln(self, "   prints the tasks it runs for: the one awaiting it, else the one that");
    wln(self, "   started it and is running it (both alive while they wait), up to the");
    wln(self, "   code outside tasks (main, or the thread's function off the main thread),");
    wln(self, "   or to the task that started it and has not awaited it yet. */");
    wln(self, "static P_THREAD_LOCAL int __p_co_in_thread = 0;");
    wln(self, "static void __p_co_put_name(FILE* out, const char* name) {");
    wln(self, "    size_t n = name ? strlen(name) : 0;");
    wln(self, "    if (n > 6 && strcmp(name + n - 6, \"__task\") == 0) n -= 6;");
    wln(self, "    fprintf(out, \"%.*s\", (int)n, name ? name : \"\");");
    wln(self, "}");
    // out: stderr, or a crash report (CO9)
    wln(self, "static void __p_co_print_chain(FILE* out) {");
    wln(self, "    __p_co* c = __p_co_cur;");
    wln(self, "    if (!c) return;");
    wln(self, "    fprintf(out, \"task chain: \");");
    wln(self, "    for (int depth = 0; c; depth++) {");
    wln(self, "        __p_co_put_name(out, c->name);");
    wln(self, "        __p_co* next = c->waiter ? c->waiter : c->back;");
    wln(self, "        if (next && depth < 64) { fprintf(out, \" <- \"); c = next; continue; }");
    wln(self, "        if (next) fprintf(out, \" <- ...\");");
    wln(self, "        else if (c->parent_name) { fprintf(out, \" (started by \"); __p_co_put_name(out, c->parent_name); fprintf(out, \")\"); }");
    wln(self, "        else fprintf(out, \" <- %s\", (__p_mn_on() ? c->origin : __p_co_in_thread) ? \"(thread)\" : \"main\");");
    wln(self, "        break;");
    wln(self, "    }");
    wln(self, "    fprintf(out, \"\\n\");");
    wln(self, "}");
    wln(self, "/* Competitive RT12: a task that only sleeps leaves __p_cos for a min-heap");
    wln(self, "   of deadlines (ties in creation order), so the scheduler's pass and the");
    wln(self, "   poll look only at tasks that can run or wait on a socket. When its");
    wln(self, "   deadline comes it goes back into __p_cos at its place by creation");
    wln(self, "   order (__p_cos stays sorted by seq), so tasks run in the same order. */");
    wln(self, "static P_THREAD_LOCAL __p_co** __p_th = NULL;");
    wln(self, "static P_THREAD_LOCAL int64_t __p_th_n = 0;");
    wln(self, "static P_THREAD_LOCAL int64_t __p_th_cap = 0;");
    wln(self, "static int __p_th_less(__p_co* a, __p_co* b) { return a->wake_ms < b->wake_ms || (a->wake_ms == b->wake_ms && a->seq < b->seq); }");
    wln(self, "static void __p_th_set(int64_t i, __p_co* c) { __p_th[i] = c; c->hidx = i; }");
    wln(self, "static void __p_th_push(__p_co* c) {");
    wln(self, "    if (__p_th_n == __p_th_cap) {");
    wln(self, "        __p_th_cap = __p_th_cap ? __p_th_cap * 2 : 64;");
    wln(self, "        __p_th = (__p_co**)realloc(__p_th, (size_t)__p_th_cap * sizeof(__p_co*));");
    wln(self, "    }");
    wln(self, "    int64_t i = __p_th_n++;");
    wln(self, "    while (i > 0) {");
    wln(self, "        int64_t up = (i - 1) / 2;");
    wln(self, "        if (!__p_th_less(c, __p_th[up])) break;");
    wln(self, "        __p_th_set(i, __p_th[up]);");
    wln(self, "        i = up;");
    wln(self, "    }");
    wln(self, "    __p_th_set(i, c);");
    wln(self, "}");
    wln(self, "/* Competitive RT11: a task parked on the poller (epoll, kqueue, IOCP/AFD)");
    wln(self, "   with no deadline leaves __p_cos too, so a pass of the scheduler costs");
    wln(self, "   the tasks that can run, not every connection held open (500k idle");
    wln(self, "   connections: an idle ping waited 14 ms for the scan). Woken, it goes");
    wln(self, "   back into __p_cos at its place by seq, as a sleeper does. */");
    wln(self, "static P_THREAD_LOCAL int64_t __p_co_pk_n = 0;");
    wln(self, "static void __p_co_unpark(__p_co* c) {");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (__p_mn_on()) { __p_pl_woke(c); return; }");
    wln(self, "#endif");
    wln(self, "    if (!c->parked) return;");
    wln(self, "    c->parked = 0;");
    wln(self, "    __p_co_pk_n--;");
    wln(self, "    if (__p_co_count == __p_co_cap) {");
    wln(self, "        __p_co_cap = __p_co_cap ? __p_co_cap * 2 : 64;");
    wln(self, "        __p_cos = (__p_co**)realloc(__p_cos, (size_t)__p_co_cap * sizeof(__p_co*));");
    wln(self, "    }");
    wln(self, "    int64_t j = __p_co_count++;");
    wln(self, "    while (j > 0 && __p_cos[j - 1]->seq > c->seq) { __p_cos[j] = __p_cos[j - 1]; j--; }");
    wln(self, "    __p_cos[j] = c;");
    wln(self, "}");
    wln(self, "static __p_co* __p_th_pop(void) {");
    wln(self, "    __p_co* top = __p_th[0];");
    wln(self, "    top->hidx = -1;");
    wln(self, "    __p_co* last = __p_th[--__p_th_n];");
    wln(self, "    if (__p_th_n > 0) {");
    wln(self, "        int64_t i = 0;");
    wln(self, "        for (;;) {");
    wln(self, "            int64_t l = 2 * i + 1, m = i;");
    wln(self, "            __p_co* best = last;");
    wln(self, "            if (l < __p_th_n && __p_th_less(__p_th[l], best)) { m = l; best = __p_th[l]; }");
    wln(self, "            if (l + 1 < __p_th_n && __p_th_less(__p_th[l + 1], best)) { m = l + 1; best = __p_th[l + 1]; }");
    wln(self, "            if (m == i) break;");
    wln(self, "            __p_th_set(i, best);");
    wln(self, "            i = m;");
    wln(self, "        }");
    wln(self, "        __p_th_set(i, last);");
    wln(self, "    }");
    wln(self, "    return top;");
    wln(self, "}");
    wln(self, "#if defined(_WIN32) && !defined(P_OWN_CTX)");
    wln(self, "static P_THREAD_LOCAL void* __p_co_sched = NULL;");
    wln(self, "#elif defined(P_OWN_CTX)");
    wln(self, "static P_THREAD_LOCAL void* __p_co_sched_sp = NULL;");
    wln(self, "#elif defined(P_NO_CTX)");
    wln(self, "#else");
    wln(self, "static P_THREAD_LOCAL ucontext_t __p_co_sched;");
    wln(self, "#endif");
    wln(self, "#define __P_CO_TAG 0x7FA5");
    wln(self, "static int64_t __p_co_now(void) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    return (int64_t)GetTickCount64();");
    wln(self, "#else");
    wln(self, "    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);");
    wln(self, "    return (int64_t)t.tv_sec * 1000 + t.tv_nsec / 1000000;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "#ifndef _WIN32");
    wln(self, "#include <sys/mman.h>");
    wln(self, "#endif");
    wln(self, "/* A task stack on POSIX, with a guard page at its low end. */");
    wln(self, "#define P_CO_STACK (256 * 1024 + 4096)");
    // RT11: an mprotect'ed guard page splits the stack's mapping in two, and
    // vm.max_map_count (65530 stock, 1048576 on some distributions) then
    // caps the tasks at half of it. Linux 6.13+ installs the guard without a
    // mapping of its own (MADV_GUARD_INSTALL = 102): one mapping per stack,
    // adjacent stacks merge. Older kernels refuse it once (EINVAL) and get
    // the mprotect'ed page as before.
    wln(self, "#if !defined(_WIN32) && !defined(P_NO_CTX)");
    wln(self, "static volatile int __p_co_guard_madv = 1;");
    wln(self, "static char* __p_co_stack_new(int64_t size) {");
    wln(self, "    int fl = MAP_PRIVATE | MAP_ANONYMOUS;");
    // a stack bigger than the default (p_co_stack) is address space the
    // task may never touch: no swap is set aside for it
    wln(self, "#ifdef MAP_NORESERVE");
    wln(self, "    if (size > P_CO_STACK) fl |= MAP_NORESERVE;");
    wln(self, "#endif");
    wln(self, "    char* s = (char*)mmap(NULL, (size_t)size, PROT_READ | PROT_WRITE, fl, -1, 0);");
    wln(self, "    if (s == (char*)MAP_FAILED) return NULL;");
    wln(self, "#if defined(__linux__) && defined(MADV_DONTNEED)");
    wln(self, "    if (__p_co_guard_madv) {");
    wln(self, "        if (madvise(s, 4096, 102 /* MADV_GUARD_INSTALL */) == 0) return s;");
    wln(self, "        __p_co_guard_madv = 0;");
    wln(self, "    }");
    wln(self, "#endif");
    wln(self, "    if (mprotect(s, 4096, PROT_NONE) != 0) { munmap(s, (size_t)size); return NULL; }");
    wln(self, "    return s;");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "static void __p_co_body(__p_co* c);");
    wln(self, "static P_MN_NOINLINE void __p_co_leave(void) {");
    wln(self, "#ifdef P_NO_CTX");
    wln(self, "    return;");
    wln(self, "#endif");
    wln(self, "    __p_co* c = __p_co_cur;");
    wln(self, "    __p_co* back = c->back;");
    wln(self, "    c->back = NULL;");
    wln(self, "    __p_co_cur = back;");
    wln(self, "#if !defined(_WIN32) && !defined(P_NO_CTX)");
    wln(self, "    __p_task_guard = back ? back->stack : NULL;");
    wln(self, "#endif");
    wln(self, "#if defined(_WIN32) && !defined(P_OWN_CTX)");
    wln(self, "    SwitchToFiber(back ? back->fiber : __p_co_sched);");
    wln(self, "#elif defined(P_OWN_CTX)");
    wln(self, "    __p_ctx_swap(&c->sp, back ? back->sp : __p_co_sched_sp);");
    wln(self, "#elif defined(P_NO_CTX)");
    wln(self, "    (void)c;");
    wln(self, "#else");
    wln(self, "    swapcontext(&c->ctx, back ? &back->ctx : &__p_co_sched);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static void __p_co_enter(__p_co* c) {");
    wln(self, "    __p_co* from = __p_co_cur;");
    wln(self, "    __p_co_cur = c;");
    // CI6: the task runs with its own capabilities; ours come back after
    wln(self, "    uint64_t __caps_from = __p_caps;");
    wln(self, "    __p_caps = c->caps;");
    // the task runs with its own regions; ours come back when it stops
    wln(self, "    __p_rstate __rs_from = __p_rs;");
    wln(self, "    __p_rs = c->rs;");
    wln(self, "#if !defined(_WIN32) && !defined(P_NO_CTX)");
    wln(self, "    __p_task_guard = c->stack;");
    wln(self, "#endif");
    wln(self, "#if defined(_WIN32) && !defined(P_OWN_CTX)");
    wln(self, "    (void)from;");
    wln(self, "    SwitchToFiber(c->fiber);");
    wln(self, "#elif defined(P_OWN_CTX)");
    wln(self, "    __p_ctx_swap(from ? &from->sp : &__p_co_sched_sp, c->sp);");
    wln(self, "#elif defined(P_NO_CTX)");
    wln(self, "    if (!c->done) __p_co_body(c);");
    wln(self, "    __p_co_cur = from;");
    wln(self, "#else");
    wln(self, "    swapcontext(from ? &from->ctx : &__p_co_sched, &c->ctx);");
    wln(self, "#endif");
    wln(self, "#if !defined(_WIN32) && !defined(P_NO_CTX)");
    wln(self, "    __p_task_guard = from ? from->stack : NULL;");
    wln(self, "#endif");
    wln(self, "    c->rs = __p_rs;");
    wln(self, "    __p_rs = __rs_from;");
    wln(self, "    c->caps = __p_caps;");
    wln(self, "    __p_caps = __caps_from;");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (__p_mn_on()) { __p_mn_settle(c); return; }");
    wln(self, "#endif");
    wln(self, "    if (c->done) {");
    wln(self, "#if defined(_WIN32) && !defined(P_OWN_CTX)");
    wln(self, "        DeleteFiber(c->fiber);");
    wln(self, "#elif defined(P_WIN_CTX)");
    wln(self, "        VirtualFree(c->stack, 0, MEM_RELEASE);");
    wln(self, "#elif defined(P_NO_CTX)");
    wln(self, "#else");
    wln(self, "        munmap(c->stack, (size_t)c->stack_size);");
    wln(self, "#endif");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "static void __p_co_body(__p_co* c) {");
    wln(self, "    int64_t (*f)() = c->fn;");
    wln(self, "    int64_t* a = c->args;");
    wln(self, "    switch (c->nargs) {");
    wln(self, "        case 0: c->result = ((int64_t (*)(void*))f)(NULL); break;");
    wln(self, "        case 1: c->result = ((int64_t (*)(void*, int64_t))f)(NULL, a[0]); break;");
    wln(self, "        case 2: c->result = ((int64_t (*)(void*, int64_t, int64_t))f)(NULL, a[0], a[1]); break;");
    wln(self, "        case 3: c->result = ((int64_t (*)(void*, int64_t, int64_t, int64_t))f)(NULL, a[0], a[1], a[2]); break;");
    wln(self, "        case 4: c->result = ((int64_t (*)(void*, int64_t, int64_t, int64_t, int64_t))f)(NULL, a[0], a[1], a[2], a[3]); break;");
    wln(self, "        case 5: c->result = ((int64_t (*)(void*, int64_t, int64_t, int64_t, int64_t, int64_t))f)(NULL, a[0], a[1], a[2], a[3], a[4]); break;");
    wln(self, "        case 6: c->result = ((int64_t (*)(void*, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t))f)(NULL, a[0], a[1], a[2], a[3], a[4], a[5]); break;");
    wln(self, "        case 7: c->result = ((int64_t (*)(void*, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t))f)(NULL, a[0], a[1], a[2], a[3], a[4], a[5], a[6]); break;");
    wln(self, "        default: c->result = ((int64_t (*)(void*, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t))f)(NULL, a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7]); break;");
    wln(self, "    }");
    wln(self, "#ifdef P_MN");
    wln(self, "    __atomic_store_n(&c->done, 1, __ATOMIC_RELEASE);");
    wln(self, "#else");
    wln(self, "    c->done = 1;");
    wln(self, "#endif");
    wln(self, "    __p_co_leave();");
    wln(self, "}");
    wln(self, "#ifdef _WIN32");
    wln(self, "static void WINAPI __p_co_start(void* p) { __p_co_body((__p_co*)p); }");
    wln(self, "#else");
    wln(self, "static void __p_co_start(unsigned lo, unsigned hi) { __p_co_body((__p_co*)(((uintptr_t)hi << 32) | lo)); }");
    wln(self, "#endif");
    wln(self, "static P_MN_NOINLINE __p_co* __p_co_new(const char* name, int64_t nargs, const int64_t* args) {");
    wln(self, "    int64_t (*fn)() = NULL;");
    wln(self, "    for (int i = 0; i < p_thread_entry_count; i++) {");
    wln(self, "        if (strcmp(p_thread_entries[i].name, name) == 0) { fn = p_thread_entries[i].fn; break; }");
    wln(self, "    }");
    wln(self, "    if (!fn) p_panic(\"task: no such function\");");
    wln(self, "#if defined(_WIN32) && !defined(P_OWN_CTX)");
    wln(self, "    if (!__p_co_sched) __p_co_sched = ConvertThreadToFiber(NULL);");
    wln(self, "#endif");
    wln(self, "#ifdef P_MN");
    wln(self, "    int mn = (__atomic_load_n(&__p_mn, __ATOMIC_ACQUIRE) ? __atomic_load_n(&__p_mn, __ATOMIC_ACQUIRE) : __p_mn_init()) > 1;");
    wln(self, "#else");
    wln(self, "    int mn = 0;");
    wln(self, "#endif");
    wln(self, "    if (!mn && __p_co_count == __p_co_cap) {");
    wln(self, "        __p_co_cap = __p_co_cap ? __p_co_cap * 2 : 64;");
    wln(self, "        __p_cos = (__p_co**)realloc(__p_cos, (size_t)__p_co_cap * sizeof(__p_co*));");
    wln(self, "    }");
    wln(self, "    __p_co* c = (__p_co*)calloc(1, sizeof(__p_co));");
    wln(self, "    if (!c) p_panic(\"task: out of memory\");");
    wln(self, "    c->fn = fn; c->nargs = nargs; c->fd = -1; c->hidx = -1; c->fbi = -1; c->seq = __p_co_total;");
    wln(self, "    c->name = name; c->parent_name = __p_co_cur ? __p_co_cur->name : NULL;");
    wln(self, "    c->caps = __p_caps;");
    wln(self, "    c->origin = __p_co_cur ? __p_co_cur->origin : __p_co_in_thread;");
    wln(self, "    int64_t req = __p_co_stack_req;");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (mn) { c->seq = P_AADD(&__p_mn_total, 1) - 1; if (__p_co_cur) req = __p_co_cur->stack_req; }");
    wln(self, "#endif");
    wln(self, "    c->stack_req = req;");
    wln(self, "    __p_trace_tasks = __p_co_print_chain;");
    wln(self, "    for (int64_t i = 0; i < nargs && i < 8; i++) c->args[i] = args[i];");
    wln(self, "#if defined(_WIN32) && !defined(P_OWN_CTX)");
    wln(self, "    c->stack_size = req ? req : 1024 * 1024;");
    wln(self, "    c->fiber = CreateFiberEx(16384, (SIZE_T)c->stack_size, 0, __p_co_start, c);");
    wln(self, "    if (!c->fiber) p_panic(\"task: out of memory\");");
    wln(self, "#elif defined(P_WIN_CTX)");
    wln(self, "    c->stack_size = req ? req : P_CO_RESERVE;");
    wln(self, "    c->stack = __p_win_stack_n(c->stack_size);");
    wln(self, "    if (!c->stack) p_panic(\"task: out of memory\");");
    wln(self, "    c->sp = __p_ctx_init(c->stack + c->stack_size, (void (*)(void*))__p_co_body, c);");
    // the TEB's DeallocationStack: the reserve's base, whatever its size
    wln(self, "    ((uint64_t*)c->sp)[22] = (uint64_t)(uintptr_t)c->stack;");
    wln(self, "#elif defined(P_NO_CTX)");
    wln(self, "    c->stack = NULL;");
    wln(self, "#else");
    wln(self, "    c->stack_size = req ? req + 4096 : P_CO_STACK;");
    wln(self, "    c->stack = __p_co_stack_new(c->stack_size);");
    wln(self, "    if (!c->stack) p_panic(\"task: out of memory (no mapping for its stack: memory, or vm.max_map_count on Linux)\");");
    wln(self, "#ifdef P_OWN_CTX");
    wln(self, "    c->sp = __p_ctx_init(c->stack + c->stack_size, (void (*)(void*))__p_co_body, c);");
    wln(self, "#else");
    wln(self, "    getcontext(&c->ctx);");
    wln(self, "    c->ctx.uc_stack.ss_sp = c->stack;");
    wln(self, "    c->ctx.uc_stack.ss_size = (size_t)c->stack_size;");
    wln(self, "    c->ctx.uc_link = NULL;");
    wln(self, "    makecontext(&c->ctx, (void (*)(void))__p_co_start, 2, (unsigned)(uintptr_t)c, (unsigned)((uintptr_t)c >> 32));");
    wln(self, "#endif");
    wln(self, "#endif");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (mn) { P_AADD(&__p_mn_live, 1); return c; }");
    wln(self, "#endif");
    wln(self, "    __p_cos[__p_co_count++] = c;");
    wln(self, "    __p_co_total++;");
    wln(self, "    return c;");
    wln(self, "}");
    // RL17: the seeded random scheduler of the native runtimes
    // (pe_runtime/conc.fd, linux_runtime/conc.fd "Random-choice scheduling")
    wln(self, "/* Roadmap RL17: FIDES_SCHED_RANDOM=<seed> (a decimal number, not 0) turns");
    wln(self, "   on random-choice scheduling for interleaving tests, as in the native");
    wln(self, "   runtimes: each pass of the scheduler runs the tasks in a random order");
    wln(self, "   (__p_co_round shuffles __p_cos), and a task gives up its turn one time");
    wln(self, "   in two at atomics, mutexes and channels (__p_rnd_point; never while it");
    wln(self, "   holds a mutex: another task of its thread would block on it). Off a task");
    wln(self, "   (main, threads) those points and a thread's start sleep 0 or 1 ms one");
    wln(self, "   time in four. A thread's choices follow from the seed (xorshift64; a");
    wln(self, "   thread's sequence from the seed and the order threads first draw), so a");
    wln(self, "   failing seed replays a task-only program's schedule exactly. Off, each");
    wln(self, "   point costs one test of a global. */");
    wln(self, "static volatile int __p_rnd_on = 0;  /* 0 not read yet, 1 on, 2 off */");
    wln(self, "static uint64_t __p_rnd_seed = 0;");
    wln(self, "static atomic_int_least64_t __p_rnd_threads;");
    wln(self, "static P_THREAD_LOCAL uint64_t __p_rnd_x = 0;");
    wln(self, "static P_THREAD_LOCAL int64_t __p_rnd_held = 0;");
    wln(self, "static int __p_rnd_enabled(void) {");
    wln(self, "    if (__p_rnd_on == 0) {");
    wln(self, "        const char* s = getenv(\"FIDES_SCHED_RANDOM\");");
    wln(self, "        uint64_t seed = 0;");
    wln(self, "        for (int i = 0; s && i < 18 && s[i] >= '0' && s[i] <= '9'; i++) seed = seed * 10 + (uint64_t)(s[i] - '0');");
    wln(self, "        __p_rnd_seed = seed;");
    wln(self, "        __p_rnd_on = seed ? 1 : 2;");
    wln(self, "    }");
    wln(self, "    return __p_rnd_on == 1;");
    wln(self, "}");
    wln(self, "static uint64_t __p_rnd_next(void) {");
    wln(self, "    uint64_t x = __p_rnd_x;");
    wln(self, "    if (!x) {");
    wln(self, "        uint64_t k = (uint64_t)atomic_fetch_add(&__p_rnd_threads, 1);");
    wln(self, "        x = __p_rnd_seed * 2654435761ULL + 88172645463325252ULL + k * 0x9E3779B97F4A7C15ULL;");
    wln(self, "        if (!x) x = 1;");
    wln(self, "    }");
    wln(self, "    x ^= x << 13;");
    wln(self, "    x ^= x >> 7;");
    wln(self, "    x ^= x << 17;");
    wln(self, "    __p_rnd_x = x;");
    wln(self, "    return x;");
    wln(self, "}");
    wln(self, "static int64_t __p_rnd_below(int64_t n) { return n <= 1 ? 0 : (int64_t)(__p_rnd_next() % (uint64_t)n); }");
    wln(self, "/* the next pass runs the tasks in a random order (Fisher-Yates) */");
    wln(self, "static void __p_rnd_shuffle(void) {");
    wln(self, "    for (int64_t i = __p_co_count - 1; i > 0; i--) {");
    wln(self, "        int64_t j = __p_rnd_below(i + 1);");
    wln(self, "        __p_co* t = __p_cos[i]; __p_cos[i] = __p_cos[j]; __p_cos[j] = t;");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "/* One turn of every task that can run. Returns how many are unfinished;");
    wln(self, "   ran says how many took their turn. */");
    wln(self, "static int64_t __p_co_round(int64_t* ran) {");
    wln(self, "    int64_t kept = 0;");
    wln(self, "    *ran = 0;");
    // RL17: random mode, a random order each pass (the list is no longer
    // kept by seq: tasks woken go in where the insertion stops, any place)
    wln(self, "    if (__p_rnd_on != 2 && __p_rnd_enabled()) __p_rnd_shuffle();");
    wln(self, "    for (int64_t i = 0; i < __p_co_count; i++) {");
    wln(self, "        __p_co* c = __p_cos[i];");
    wln(self, "        if (c->done) { if (c->detached) free(c); continue; }");
    wln(self, "        if (c->awaits && c->awaits->done) c->awaits = NULL;");
    wln(self, "        if (!c->awaits && c->fd < 0 && !c->wake_ms) {");
    wln(self, "            (*ran)++;");
    wln(self, "            __p_co_enter(c);");
    wln(self, "            if (c->done) { if (c->detached) free(c); continue; }");
    wln(self, "            if (c->wake_ms && c->fd < 0 && !c->ev && !c->awaits) { __p_th_push(c); continue; }");
    wln(self, "        }");
    // RT11: parked on the poller with no deadline: out until __p_co_unpark
    wln(self, "        if (c->ev && c->fd >= 0 && !c->wake_ms && !c->awaits) { c->parked = 1; __p_co_pk_n++; continue; }");
    wln(self, "        __p_cos[kept++] = c;");
    wln(self, "    }");
    wln(self, "    __p_co_count = kept;");
    wln(self, "    return kept + __p_th_n + __p_co_pk_n;");
    wln(self, "}");
    wln(self, "#if defined(_WIN32) && !defined(__TINYC__)");
    wln(self, "/* Competitive RT11 on Windows: a task waiting for a socket submits one AFD");
    wln(self, "   poll (IOCTL_AFD_POLL on the socket's base handle, as wepoll and mio do),");
    wln(self, "   completed on this thread's I/O completion port: no wait set is rebuilt.");
    wln(self, "   Without the AFD device the poll set (WSAPoll) takes the wait. */");
    wln(self, "#define P_EV 1");
    wln(self, "typedef LONG (NTAPI* __p_nt_create_t)(PHANDLE, ULONG, void*, void*, void*, ULONG, ULONG, ULONG, ULONG, void*, ULONG);");
    wln(self, "typedef LONG (NTAPI* __p_nt_ioctl_t)(HANDLE, HANDLE, void*, void*, void*, ULONG, void*, ULONG, void*, ULONG);");
    wln(self, "typedef LONG (NTAPI* __p_nt_cancel_t)(HANDLE, void*, void*);");
    wln(self, "typedef struct { uint64_t status; uint64_t info; } __p_iosb;");
    wln(self, "typedef struct { int64_t timeout; ULONG n; ULONG exclusive; uint64_t handle; ULONG events; LONG status; } __p_afd_info;");
    wln(self, "typedef struct { __p_iosb iosb; __p_afd_info info; __p_co* c; int cancelled; __p_iosb cancel_iosb; } __p_afd_op;");
    wln(self, "static __p_nt_ioctl_t __p_nt_ioctl = NULL;");
    wln(self, "static __p_nt_cancel_t __p_nt_cancel = NULL;");
    wln(self, "static P_THREAD_LOCAL HANDLE __p_ev_iocp = NULL;");
    wln(self, "static P_THREAD_LOCAL HANDLE __p_ev_afd = NULL;");
    wln(self, "static P_THREAD_LOCAL int __p_ev_state = 0;");
    wln(self, "static P_THREAD_LOCAL int64_t __p_ev_n = 0;");
    wln(self, "static int __p_ev_init(void) {");
    wln(self, "    if (__p_ev_state) return __p_ev_state > 0;");
    wln(self, "    __p_ev_state = -1;");
    wln(self, "    HMODULE nt = GetModuleHandleA(\"ntdll.dll\");");
    wln(self, "    __p_nt_create_t create = nt ? (__p_nt_create_t)(void*)GetProcAddress(nt, \"NtCreateFile\") : NULL;");
    wln(self, "    __p_nt_ioctl = nt ? (__p_nt_ioctl_t)(void*)GetProcAddress(nt, \"NtDeviceIoControlFile\") : NULL;");
    wln(self, "    __p_nt_cancel = nt ? (__p_nt_cancel_t)(void*)GetProcAddress(nt, \"NtCancelIoFileEx\") : NULL;");
    wln(self, "    if (!create || !__p_nt_ioctl || !__p_nt_cancel) return 0;");
    wln(self, "    __p_ev_iocp = CreateIoCompletionPort(INVALID_HANDLE_VALUE, NULL, 0, 1);");
    wln(self, "    if (!__p_ev_iocp) return 0;");
    wln(self, "    static const WCHAR name[] = L\"\\\\Device\\\\Afd\\\\Fides\";");
    wln(self, "    struct { USHORT len, max; ULONG pad; const WCHAR* buf; } us = { sizeof(name) - 2, sizeof(name), 0, name };");
    wln(self, "    struct { ULONG len; ULONG pad; HANDLE root; void* name; ULONG attrs; ULONG pad2; void* sd; void* sqos; } oa = { 48, 0, NULL, &us, 0, 0, NULL, NULL };");
    wln(self, "    __p_iosb io = { 0, 0 };");
    wln(self, "    HANDLE afd = NULL;");
    wln(self, "    if (create(&afd, SYNCHRONIZE, &oa, &io, NULL, 0, FILE_SHARE_READ | FILE_SHARE_WRITE, 1 /* FILE_OPEN */, 0, NULL, 0) != 0) return 0;");
    wln(self, "    if (CreateIoCompletionPort(afd, __p_ev_iocp, 0, 0) != __p_ev_iocp) { CloseHandle(afd); return 0; }");
    wln(self, "    __p_ev_afd = afd;");
    wln(self, "    __p_ev_state = 1;");
    wln(self, "    return 1;");
    wln(self, "}");
    wln(self, "static int __p_ev_arm(__p_co* c) {");
    wln(self, "    if (!__p_ev_init()) return 0;");
    wln(self, "    __p_afd_op* op = (__p_afd_op*)calloc(1, sizeof(__p_afd_op));");
    wln(self, "    if (!op) return 0;");
    wln(self, "    SOCKET base = (SOCKET)c->fd;");
    wln(self, "    DWORD got = 0;");
    wln(self, "    SOCKET b2 = 0;");
    wln(self, "    if (WSAIoctl((SOCKET)c->fd, 0x48000022 /* SIO_BASE_HANDLE */, NULL, 0, &b2, sizeof(b2), &got, NULL, NULL) == 0) base = b2;");
    wln(self, "    op->info.timeout = INT64_MAX;");
    wln(self, "    op->info.n = 1;");
    wln(self, "    op->info.handle = (uint64_t)base;");
    wln(self, "    /* read: receive, expedited, disconnect, abort, local close, accept,");
    wln(self, "       connect failed; write: send, abort, local close, connect failed */");
    wln(self, "    op->info.events = c->fd_write ? 0x134 : 0x1BB;");
    wln(self, "    op->c = c;");
    wln(self, "    LONG st = __p_nt_ioctl(__p_ev_afd, NULL, NULL, op, &op->iosb, 0x12024, &op->info, sizeof(op->info), &op->info, sizeof(op->info));");
    wln(self, "    if (st != 0 && st != 0x103) { free(op); return 0; }");
    wln(self, "    c->ev = 1;");
    wln(self, "    c->evop = op;");
    wln(self, "    __p_ev_n++;");
    wln(self, "    return 1;");
    wln(self, "}");
    wln(self, "/* Its deadline came first: cancel the poll, freed when its completion comes */");
    wln(self, "static void __p_ev_drop(__p_co* c, int registered) {");
    wln(self, "    (void)registered;");
    wln(self, "    __p_afd_op* op = (__p_afd_op*)c->evop;");
    wln(self, "    op->cancelled = 1;");
    wln(self, "    __p_nt_cancel(__p_ev_afd, &op->iosb, &op->cancel_iosb);");
    wln(self, "    c->ev = 0;");
    wln(self, "    c->evop = NULL;");
    wln(self, "    __p_ev_n--;");
    wln(self, "}");
    wln(self, "static void __p_ev_poll(int64_t timeout) {");
    wln(self, "    OVERLAPPED_ENTRY ents[64];");
    wln(self, "    ULONG k = 0;");
    wln(self, "    if (!GetQueuedCompletionStatusEx(__p_ev_iocp, ents, 64, &k, timeout < 0 ? INFINITE : (DWORD)timeout, FALSE)) return;");
    wln(self, "    for (ULONG j = 0; j < k; j++) {");
    wln(self, "        __p_afd_op* op = (__p_afd_op*)ents[j].lpOverlapped;");
    wln(self, "        if (!op) continue;");
    wln(self, "        if (!op->cancelled) {");
    wln(self, "            __p_co* c = op->c;");
    wln(self, "            c->ev = 0; c->evop = NULL; __p_ev_n--;");
    wln(self, "            c->ready = 1; c->fd = -1; c->wake_ms = 0;");
    wln(self, "            __p_co_unpark(c);");
    wln(self, "        }");
    wln(self, "        free(op);");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "#elif (defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__)) && !defined(P_NO_CTX)");
    wln(self, "/* Competitive RT11: a socket a task waits on is watched by epoll (Linux) or");
    wln(self, "   kqueue (macOS, BSD), registered once per wait, so a wait costs the same");
    wln(self, "   with one socket or 100,000. A second task waiting on the same socket in");
    wln(self, "   the same direction goes through the poll set. */");
    wln(self, "#define P_EV 1");
    wln(self, "#include <errno.h>");
    wln(self, "#ifdef __linux__");
    wln(self, "#include <sys/epoll.h>");
    wln(self, "#else");
    wln(self, "#include <sys/event.h>");
    wln(self, "#endif");
    wln(self, "typedef struct { __p_co* rd; __p_co* wr; } __p_ev_slot;");
    wln(self, "static P_THREAD_LOCAL int __p_ev_q = -1;");
    wln(self, "static P_THREAD_LOCAL __p_ev_slot* __p_ev_tab = NULL;");
    wln(self, "static P_THREAD_LOCAL int64_t __p_ev_cap = 0;");
    wln(self, "static P_THREAD_LOCAL int64_t __p_ev_n = 0;");
    wln(self, "#ifdef __linux__");
    wln(self, "static int __p_ev_set(int fd) {");
    wln(self, "    __p_ev_slot* s = &__p_ev_tab[fd];");
    wln(self, "    struct epoll_event e;");
    wln(self, "    memset(&e, 0, sizeof e);");
    wln(self, "    e.events = (s->rd ? EPOLLIN : 0) | (s->wr ? EPOLLOUT : 0);");
    wln(self, "    e.data.fd = fd;");
    wln(self, "    if (!e.events) return epoll_ctl(__p_ev_q, EPOLL_CTL_DEL, fd, &e) == 0;");
    wln(self, "    if (epoll_ctl(__p_ev_q, EPOLL_CTL_MOD, fd, &e) == 0) return 1;");
    wln(self, "    return errno == ENOENT && epoll_ctl(__p_ev_q, EPOLL_CTL_ADD, fd, &e) == 0;");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "static int __p_ev_arm(__p_co* c) {");
    wln(self, "    int fd = (int)c->fd;");
    wln(self, "    if (fd < 0 || fd >= (1 << 22)) return 0;");
    wln(self, "    if (__p_ev_q < 0) {");
    wln(self, "#ifdef __linux__");
    wln(self, "        __p_ev_q = epoll_create1(EPOLL_CLOEXEC);");
    wln(self, "#else");
    wln(self, "        __p_ev_q = kqueue();");
    wln(self, "#endif");
    wln(self, "        if (__p_ev_q < 0) return 0;");
    wln(self, "    }");
    wln(self, "    if (fd >= __p_ev_cap) {");
    wln(self, "        int64_t cap = __p_ev_cap ? __p_ev_cap : 64;");
    wln(self, "        while (cap <= fd) cap *= 2;");
    wln(self, "        __p_ev_tab = (__p_ev_slot*)realloc(__p_ev_tab, (size_t)cap * sizeof(__p_ev_slot));");
    wln(self, "        memset(__p_ev_tab + __p_ev_cap, 0, (size_t)(cap - __p_ev_cap) * sizeof(__p_ev_slot));");
    wln(self, "        __p_ev_cap = cap;");
    wln(self, "    }");
    wln(self, "    __p_co** slot = c->fd_write ? &__p_ev_tab[fd].wr : &__p_ev_tab[fd].rd;");
    wln(self, "    if (*slot) return 0;");
    wln(self, "    *slot = c;");
    wln(self, "#ifdef __linux__");
    wln(self, "    if (!__p_ev_set(fd)) { *slot = NULL; return 0; }");
    wln(self, "#else");
    wln(self, "    struct kevent k;");
    wln(self, "    EV_SET(&k, fd, c->fd_write ? EVFILT_WRITE : EVFILT_READ, EV_ADD | EV_ONESHOT, 0, 0, NULL);");
    wln(self, "    if (kevent(__p_ev_q, &k, 1, NULL, 0, NULL) != 0) { *slot = NULL; return 0; }");
    wln(self, "#endif");
    wln(self, "    c->ev = 1;");
    wln(self, "    __p_ev_n++;");
    wln(self, "    return 1;");
    wln(self, "}");
    wln(self, "/* Stop watching for c (woken, or its deadline came first) */");
    wln(self, "static void __p_ev_drop(__p_co* c, int registered) {");
    wln(self, "    int fd = (int)c->fd;");
    wln(self, "    __p_co** slot = c->fd_write ? &__p_ev_tab[fd].wr : &__p_ev_tab[fd].rd;");
    wln(self, "    *slot = NULL;");
    wln(self, "    c->ev = 0;");
    wln(self, "    __p_ev_n--;");
    wln(self, "#ifdef __linux__");
    wln(self, "    (void)registered;");
    wln(self, "    __p_ev_set(fd);");
    wln(self, "#else");
    wln(self, "    if (registered) {");
    wln(self, "        struct kevent k;");
    wln(self, "        EV_SET(&k, fd, c->fd_write ? EVFILT_WRITE : EVFILT_READ, EV_DELETE, 0, 0, NULL);");
    wln(self, "        kevent(__p_ev_q, &k, 1, NULL, 0, NULL);");
    wln(self, "    }");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static void __p_ev_wake(__p_co* c, int registered) {");
    wln(self, "    __p_ev_drop(c, registered);");
    wln(self, "    c->ready = 1; c->fd = -1; c->wake_ms = 0;");
    wln(self, "    __p_co_unpark(c);");
    wln(self, "}");
    wln(self, "/* Wake the tasks whose sockets are ready, waiting at most timeout ms */");
    wln(self, "static void __p_ev_poll(int64_t timeout) {");
    wln(self, "#ifdef __linux__");
    wln(self, "    struct epoll_event ev[64];");
    wln(self, "    int k = epoll_wait(__p_ev_q, ev, 64, (int)timeout);");
    wln(self, "    for (int j = 0; j < k; j++) {");
    wln(self, "        int fd = ev[j].data.fd;");
    wln(self, "        uint32_t e = ev[j].events;");
    wln(self, "        __p_co* r = __p_ev_tab[fd].rd;");
    wln(self, "        __p_co* w = __p_ev_tab[fd].wr;");
    wln(self, "        if (r && (e & (EPOLLIN | EPOLLERR | EPOLLHUP | EPOLLRDHUP))) __p_ev_wake(r, 1);");
    wln(self, "        if (w && (e & (EPOLLOUT | EPOLLERR | EPOLLHUP))) __p_ev_wake(w, 1);");
    wln(self, "    }");
    wln(self, "#else");
    wln(self, "    struct kevent ev[64];");
    wln(self, "    struct timespec ts, *tp = NULL;");
    wln(self, "    if (timeout >= 0) { ts.tv_sec = timeout / 1000; ts.tv_nsec = (timeout % 1000) * 1000000; tp = &ts; }");
    wln(self, "    int k = kevent(__p_ev_q, NULL, 0, ev, 64, tp);");
    wln(self, "    for (int j = 0; j < k; j++) {");
    wln(self, "        int fd = (int)ev[j].ident;");
    wln(self, "        if (fd < 0 || fd >= __p_ev_cap) continue;");
    wln(self, "        __p_co* c = ev[j].filter == EVFILT_WRITE ? __p_ev_tab[fd].wr : __p_ev_tab[fd].rd;");
    wln(self, "        if (c) __p_ev_wake(c, 0);");
    wln(self, "    }");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "#else");
    wln(self, "#define __p_ev_n ((int64_t)0)");
    wln(self, "#endif");
    wln(self, "/* Competitive RT10: M:N tasks on the C path. __p_mn worker threads (one");
    wln(self, "   per CPU up to 16; FIDES_WORKERS=<n> 1-16; p_co_workers(n) before the");
    wln(self, "   first task wins over both) run every task, wherever it was started.");
    wln(self, "   Each worker owns a ring of P_LQ_CAP slots, a Chase-Lev deque taken FIFO");
    wln(self, "   as in the native runtimes (stdlib/pe_runtime/conc.fd \"Run queues\"): only");
    wln(self, "   its worker pushes, at bottom; its worker and the thieves take at top by");
    wln(self, "   compare-and-swap. A worker whose ring is dry takes the global queue's");
    wln(self, "   head and its share of the rest, then steals half of a sibling's ring; a");
    wln(self, "   full ring moves its older half to the global queue, which also holds");
    wln(self, "   what is queued off a worker (main, the poller, other threads). Idle");
    wln(self, "   workers sleep on the global queue's condition variable: a worker counts");
    wln(self, "   itself idle and looks once more, a push publishes its slot and then");
    wln(self, "   reads the idle count, so one of the two sees the other (no spinning, no");
    wln(self, "   lost wake-up). A task's switch out is finished by the context it");
    wln(self, "   returns to (__p_mn_settle, after the switch, as Go parks on g0): only");
    wln(self, "   then is it queued, put on a waiter list or handed to the poller, so no");
    wln(self, "   worker can resume it before its registers are saved. One poller thread");
    wln(self, "   owns the deadlines (the timer heap) and the socket waits (AFD/IOCP,");
    wln(self, "   epoll, kqueue, or the poll set). FIDES_WORKERS=1, random scheduling");
    wln(self, "   (RL17) or a machine with one CPU keep one cooperative scheduler per");
    wln(self, "   thread, exactly as before. FIDES_RUNQ=shared puts every task through the");
    wln(self, "   global queue under its lock, the shared-lock queue the rings replace");
    wln(self, "   (bench/rt10 compares the two). Code that runs on a task's stack reads");
    wln(self, "   thread-locals only through functions the C compiler cannot inline");
    wln(self, "   (P_MN_NOINLINE, __p_co_self): a task may go on on another thread after");
    wln(self, "   any switch, and a thread-local's address taken before it would be the");
    wln(self, "   old worker's. */");
    wln(self, "#ifdef P_MN");
    wln(self, "#ifndef _WIN32");
    wln(self, "#include <unistd.h>");
    wln(self, "#include <fcntl.h>");
    wln(self, "#include <time.h>");
    wln(self, "#endif");
    wln(self, "#define P_LQ_CAP 256");
    wln(self, "#define P_LV_YIELD 0");
    wln(self, "#define P_LV_AWAIT 1");
    wln(self, "#define P_LV_POLL 2");
    wln(self, "#define P_LV_CHAN 3");
    wln(self, "#if defined(__x86_64__)");
    wln(self, "#define P_PAUSE() __builtin_ia32_pause()");
    wln(self, "#elif defined(__aarch64__)");
    wln(self, "#define P_PAUSE() __asm__ volatile(\"yield\")");
    wln(self, "#else");
    wln(self, "#define P_PAUSE() ((void)0)");
    wln(self, "#endif");
    wln(self, "/* a worker: its ring's top and bottom on cache lines of their own */");
    wln(self, "typedef struct __p_wk {");
    wln(self, "    int64_t top; char pad0[56];");
    wln(self, "    int64_t bottom; char pad1[56];");
    wln(self, "    __p_co* ring[P_LQ_CAP];");
    wln(self, "    int64_t steal_at; int64_t ticks; char pad2[48];");
    wln(self, "} __p_wk;");
    wln(self, "static __p_wk* __p_wks = NULL;");
    wln(self, "static P_THREAD_LOCAL int __p_wk_me = 0;");
    wln(self, "static int __p_mn_shared = 0;");
    wln(self, "static int64_t __p_mn_req = 0;");
    wln(self, "static volatile int __p_mn_lk0 = 0;");
    wln(self, "static pthread_mutex_t __p_gq_mx;");
    wln(self, "static pthread_cond_t __p_gq_cv;");
    wln(self, "static __p_co* __p_gq_head = NULL;");
    wln(self, "static __p_co* __p_gq_tail = NULL;");
    wln(self, "static int64_t __p_gq_n = 0;");
    wln(self, "static int64_t __p_mn_idle = 0;");
    wln(self, "static int64_t __p_mn_joined = 0;");
    wln(self, "static int64_t __p_mn_runw = 0;");
    wln(self, "static int64_t __p_mn_inrun = 0;");
    wln(self, "static pthread_mutex_t __p_mn_dmx;");
    wln(self, "static pthread_cond_t __p_mn_dcv;");
    wln(self, "static pthread_mutex_t __p_pl_mx;");
    wln(self, "static __p_co* __p_pl_in = NULL;");
    wln(self, "static int __p_pl_waiting = 0;");
    wln(self, "static int __p_pl_on = 0;");
    wln(self, "static __p_co** __p_pl_fb = NULL;");
    wln(self, "static int64_t __p_pl_fb_n = 0;");
    wln(self, "static int64_t __p_pl_fb_cap = 0;");
    wln(self, "#ifdef _WIN32");
    wln(self, "static HANDLE __p_pl_evt = NULL;");
    wln(self, "static HANDLE __p_pl_port = NULL;");
    wln(self, "#else");
    wln(self, "static int __p_pl_fd[2] = { -1, -1 };");
    wln(self, "#endif");
    wln(self, "static void __p_co_nap(int64_t ms);");
    wln(self, "/* the running task and the worker (id + 1, 0 off a worker) of this thread,");
    wln(self, "   read anew at each call */");
    wln(self, "static P_MN_NOINLINE __p_co* __p_co_self(void) { __p_co* c = __p_co_cur; __asm__ volatile(\"\" ::: \"memory\"); return c; }");
    wln(self, "static P_MN_NOINLINE int __p_wk_self(void) { int w = __p_wk_me; __asm__ volatile(\"\" ::: \"memory\"); return w; }");
    wln(self, "/* a task's own lock: its waiters, whether it is settled, detached */");
    wln(self, "static void __p_co_lock(__p_co* c) {");
    wln(self, "    while (__atomic_exchange_n(&c->lk, 1, __ATOMIC_ACQUIRE)) { while (__atomic_load_n(&c->lk, __ATOMIC_RELAXED)) P_PAUSE(); }");
    wln(self, "}");
    wln(self, "static void __p_co_unlock(__p_co* c) { __atomic_store_n(&c->lk, 0, __ATOMIC_RELEASE); }");
    wln(self, "static int __p_cpu_n(void) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    SYSTEM_INFO si;");
    wln(self, "    GetSystemInfo(&si);");
    wln(self, "    return (int)si.dwNumberOfProcessors;");
    wln(self, "#else");
    wln(self, "    long n = sysconf(_SC_NPROCESSORS_ONLN);");
    wln(self, "    return n > 0 ? (int)n : 1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static void* __p_mn_worker(void* arg);");
    wln(self, "/* Decides, at the first task, how many workers run tasks, and starts them */");
    wln(self, "static P_MN_NOINLINE int __p_mn_init(void) {");
    wln(self, "    while (__atomic_exchange_n(&__p_mn_lk0, 1, __ATOMIC_ACQUIRE)) P_PAUSE();");
    wln(self, "    if (!__atomic_load_n(&__p_mn, __ATOMIC_ACQUIRE)) {");
    wln(self, "        int n = __p_cpu_n();");
    wln(self, "        const char* e = getenv(\"FIDES_WORKERS\");");
    wln(self, "        if (e) {");
    wln(self, "            int v = 0, i = 0;");
    wln(self, "            while (i < 3 && e[i] >= '0' && e[i] <= '9') { v = v * 10 + (e[i] - '0'); i++; }");
    wln(self, "            if (v >= 1 && v <= 16) n = v;");
    wln(self, "        }");
    wln(self, "        if (__p_mn_req >= 1) n = (int)__p_mn_req;");
    wln(self, "        if (n > 16) n = 16;");
    wln(self, "        if (n < 1) n = 1;");
    wln(self, "        if (__p_rnd_enabled()) n = 1;");
    wln(self, "        if (n > 1) {");
    wln(self, "            const char* q = getenv(\"FIDES_RUNQ\");");
    wln(self, "            __p_mn_shared = q && strcmp(q, \"shared\") == 0;");
    wln(self, "            char* raw = (char*)calloc(1, (size_t)n * sizeof(__p_wk) + 64);");
    wln(self, "            if (!raw) n = 1;");
    wln(self, "            else {");
    wln(self, "                __p_wks = (__p_wk*)(((uintptr_t)raw + 63) & ~(uintptr_t)63);");
    wln(self, "                pthread_mutex_init(&__p_gq_mx, NULL);");
    wln(self, "                pthread_cond_init(&__p_gq_cv, NULL);");
    wln(self, "                pthread_mutex_init(&__p_mn_dmx, NULL);");
    wln(self, "                pthread_cond_init(&__p_mn_dcv, NULL);");
    wln(self, "                pthread_mutex_init(&__p_pl_mx, NULL);");
    wln(self, "                __p_mn_nw = n;");
    wln(self, "                for (int i = 0; i < n; i++) {");
    wln(self, "                    pthread_t t;");
    wln(self, "                    if (pthread_create(&t, NULL, __p_mn_worker, (void*)(intptr_t)i) != 0) p_panic(\"tasks: could not start a worker thread\");");
    wln(self, "                }");
    wln(self, "            }");
    wln(self, "        }");
    wln(self, "        __atomic_store_n(&__p_mn, n, __ATOMIC_RELEASE);");
    wln(self, "    }");
    wln(self, "    __atomic_store_n(&__p_mn_lk0, 0, __ATOMIC_RELEASE);");
    wln(self, "    return __atomic_load_n(&__p_mn, __ATOMIC_ACQUIRE);");
    wln(self, "}");
    wln(self, "/* The ring of worker w. Push: its own thread only; 0 when the ring is full */");
    wln(self, "static int __p_lq_push(__p_wk* w, __p_co* c) {");
    wln(self, "    int64_t b = __atomic_load_n(&w->bottom, __ATOMIC_RELAXED);");
    wln(self, "    if (b - P_AL(&w->top) >= P_LQ_CAP) return 0;");
    wln(self, "    __atomic_store_n(&w->ring[b & (P_LQ_CAP - 1)], c, __ATOMIC_RELAXED);");
    wln(self, "    /* the slot is visible before the index, and the idle count read after");
    wln(self, "       this cannot pass it */");
    wln(self, "    P_AS(&w->bottom, b + 1);");
    wln(self, "    return 1;");
    wln(self, "}");
    wln(self, "/* Its oldest task: read the slot, then claim it (a slot the owner reused");
    wln(self, "   meanwhile moved top, and the claim fails) */");
    wln(self, "static __p_co* __p_lq_pop(__p_wk* w) {");
    wln(self, "    for (;;) {");
    wln(self, "        int64_t t = P_AL(&w->top);");
    wln(self, "        int64_t b = P_AL(&w->bottom);");
    wln(self, "        if (b - t <= 0) return NULL;");
    wln(self, "        __p_co* c = __atomic_load_n(&w->ring[t & (P_LQ_CAP - 1)], __ATOMIC_RELAXED);");
    wln(self, "        if (P_ACAS(&w->top, &t, t + 1)) return c;");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "static int64_t __p_lq_size(__p_wk* w) {");
    wln(self, "    int64_t t = P_AL(&w->top);");
    wln(self, "    int64_t b = P_AL(&w->bottom);");
    wln(self, "    return b > t ? b - t : 0;");
    wln(self, "}");
    wln(self, "static int __p_lq_any(void) {");
    wln(self, "    for (int i = 0; i < __p_mn_nw; i++) if (__p_lq_size(&__p_wks[i])) return 1;");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "/* Thief me (its ring empty) takes half of v's ring, rounded up: the slots");
    wln(self, "   are copied to its own ring's unpublished end, then claimed on v's in one");
    wln(self, "   CAS. The last is returned to run, the others published on me's ring. */");
    wln(self, "static __p_co* __p_lq_steal_half(__p_wk* me, __p_wk* v) {");
    wln(self, "    int64_t mb = __atomic_load_n(&me->bottom, __ATOMIC_RELAXED);");
    wln(self, "    for (;;) {");
    wln(self, "        int64_t t = P_AL(&v->top);");
    wln(self, "        int64_t b = P_AL(&v->bottom);");
    wln(self, "        int64_t n = b - t;");
    wln(self, "        if (n <= 0) return NULL;");
    wln(self, "        n = n - n / 2;");
    wln(self, "        if (n > P_LQ_CAP / 2) n = P_LQ_CAP / 2;");
    wln(self, "        for (int64_t i = 0; i < n; i++)");
    wln(self, "            __atomic_store_n(&me->ring[(mb + i) & (P_LQ_CAP - 1)], __atomic_load_n(&v->ring[(t + i) & (P_LQ_CAP - 1)], __ATOMIC_RELAXED), __ATOMIC_RELAXED);");
    wln(self, "        if (P_ACAS(&v->top, &t, t + n)) {");
    wln(self, "            __p_co* c = __atomic_load_n(&me->ring[(mb + n - 1) & (P_LQ_CAP - 1)], __ATOMIC_RELAXED);");
    wln(self, "            if (n > 1) P_AS(&me->bottom, mb + n - 1);");
    wln(self, "            return c;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "/* Worker id's ring is dry: half of the first sibling's ring that has work,");
    wln(self, "   starting one further each time so thieves spread over the victims */");
    wln(self, "static __p_co* __p_lq_steal(int id) {");
    wln(self, "    int n = __p_mn_nw;");
    wln(self, "    __p_wk* me = &__p_wks[id];");
    wln(self, "    int64_t s = me->steal_at++;");
    wln(self, "    for (int i = 0; i < n; i++) {");
    wln(self, "        int v = (int)((id + 1 + (s + i) % n) % n);");
    wln(self, "        if (v == id) continue;");
    wln(self, "        __p_co* c = __p_lq_steal_half(me, &__p_wks[v]);");
    wln(self, "        if (c) return c;");
    wln(self, "    }");
    wln(self, "    return NULL;");
    wln(self, "}");
    wln(self, "/* The global queue, under __p_gq_mx */");
    wln(self, "static void __p_gq_append(__p_co* c) {");
    wln(self, "    c->qnext = NULL;");
    wln(self, "    if (__p_gq_tail) __p_gq_tail->qnext = c; else __p_gq_head = c;");
    wln(self, "    __p_gq_tail = c;");
    wln(self, "    P_AS(&__p_gq_n, __p_gq_n + 1);");
    wln(self, "}");
    wln(self, "static __p_co* __p_gq_pop(void) {");
    wln(self, "    __p_co* c = __p_gq_head;");
    wln(self, "    if (!c) return NULL;");
    wln(self, "    __p_gq_head = c->qnext;");
    wln(self, "    if (!__p_gq_head) __p_gq_tail = NULL;");
    wln(self, "    c->qnext = NULL;");
    wln(self, "    P_AS(&__p_gq_n, __p_gq_n - 1);");
    wln(self, "    return c;");
    wln(self, "}");
    wln(self, "/* Worker id (its ring empty): the head to run, and its share of the rest");
    wln(self, "   (one worker's part, at most half a ring) onto its ring, so the lock is");
    wln(self, "   taken once per batch */");
    wln(self, "static __p_co* __p_gq_take(int id) {");
    wln(self, "    __p_co* c = __p_gq_pop();");
    wln(self, "    if (!c || __p_mn_shared) return c;");
    wln(self, "    int64_t k = __p_gq_n / __p_mn_nw;");
    wln(self, "    if (k > P_LQ_CAP / 2) k = P_LQ_CAP / 2;");
    wln(self, "    __p_wk* w = &__p_wks[id];");
    wln(self, "    int64_t moved = 0;");
    wln(self, "    while (k-- > 0) {");
    wln(self, "        __p_co* u = __p_gq_pop();");
    wln(self, "        if (!u) break;");
    wln(self, "        if (!__p_lq_push(w, u)) {");
    wln(self, "            u->qnext = __p_gq_head; __p_gq_head = u;");
    wln(self, "            if (!__p_gq_tail) __p_gq_tail = u;");
    wln(self, "            P_AS(&__p_gq_n, __p_gq_n + 1);");
    wln(self, "            break;");
    wln(self, "        }");
    wln(self, "        moved++;");
    wln(self, "    }");
    wln(self, "    if (moved && P_AL(&__p_mn_idle) > 0) pthread_cond_signal(&__p_gq_cv);");
    wln(self, "    return c;");
    wln(self, "}");
    wln(self, "static void __p_mn_wake(void) {");
    wln(self, "    pthread_mutex_lock(&__p_gq_mx);");
    wln(self, "    pthread_cond_signal(&__p_gq_cv);");
    wln(self, "    pthread_mutex_unlock(&__p_gq_mx);");
    wln(self, "}");
    wln(self, "/* Worker w's ring is full: its older half (claimed first, then read: only");
    wln(self, "   w's thread writes its slots) and c to the global queue in one lock hold */");
    wln(self, "static void __p_lq_spill(__p_wk* w, __p_co* c) {");
    wln(self, "    int64_t b = __atomic_load_n(&w->bottom, __ATOMIC_RELAXED);");
    wln(self, "    int64_t t = 0, half = 0;");
    wln(self, "    for (;;) {");
    wln(self, "        t = P_AL(&w->top);");
    wln(self, "        half = (b - t) / 2;");
    wln(self, "        if (half <= 0) { half = 0; break; }");
    wln(self, "        if (P_ACAS(&w->top, &t, t + half)) break;");
    wln(self, "    }");
    wln(self, "    pthread_mutex_lock(&__p_gq_mx);");
    wln(self, "    for (int64_t i = 0; i < half; i++) __p_gq_append(__atomic_load_n(&w->ring[(t + i) & (P_LQ_CAP - 1)], __ATOMIC_RELAXED));");
    wln(self, "    __p_gq_append(c);");
    wln(self, "    if (P_AL(&__p_mn_idle) > 0) pthread_cond_signal(&__p_gq_cv);");
    wln(self, "    pthread_mutex_unlock(&__p_gq_mx);");
    wln(self, "}");
    wln(self, "/* c can run: on this worker's ring (spawn locality), else the global queue.");
    wln(self, "   sched: the caller is a worker about to look for its next task, so an");
    wln(self, "   idle worker is woken only for a backlog */");
    wln(self, "static P_MN_NOINLINE void __p_mn_ready(__p_co* c, int sched) {");
    wln(self, "    int me = __p_mn_shared ? 0 : __p_wk_self();");
    wln(self, "    if (me) {");
    wln(self, "        __p_wk* w = &__p_wks[me - 1];");
    wln(self, "        if (!__p_lq_push(w, c)) { __p_lq_spill(w, c); return; }");
    wln(self, "        if (P_AL(&__p_mn_idle) > 0 && (!sched || __p_lq_size(w) > 1)) __p_mn_wake();");
    wln(self, "        return;");
    wln(self, "    }");
    wln(self, "    pthread_mutex_lock(&__p_gq_mx);");
    wln(self, "    __p_gq_append(c);");
    wln(self, "    if (P_AL(&__p_mn_idle) > 0) pthread_cond_signal(&__p_gq_cv);");
    wln(self, "    pthread_mutex_unlock(&__p_gq_mx);");
    wln(self, "}");
    wln(self, "/* A worker thread: its ring, the global queue (first one time in 61, so");
    wln(self, "   what is woken off the workers is not starved by tasks that keep");
    wln(self, "   yielding), a sibling's ring; else it sleeps until a push wakes it */");
    wln(self, "static void* __p_mn_worker(void* arg) {");
    wln(self, "    int id = (int)(intptr_t)arg;");
    wln(self, "    __p_wk_me = id + 1;");
    wln(self, "    __p_thread_guard_init();");
    wln(self, "    __p_sp_thread_start();");
    wln(self, "    __p_wk* w = &__p_wks[id];");
    wln(self, "    for (;;) {");
    wln(self, "        __p_co* c = NULL;");
    wln(self, "        if (!__p_mn_shared && (++w->ticks % 61) == 0 && P_AL(&__p_gq_n) > 0) {");
    wln(self, "            pthread_mutex_lock(&__p_gq_mx);");
    wln(self, "            c = __p_gq_pop();");
    wln(self, "            pthread_mutex_unlock(&__p_gq_mx);");
    wln(self, "        }");
    wln(self, "        if (!c && !__p_mn_shared) c = __p_lq_pop(w);");
    wln(self, "        if (!c && P_AL(&__p_gq_n) > 0) {");
    wln(self, "            pthread_mutex_lock(&__p_gq_mx);");
    wln(self, "            c = __p_gq_take(id);");
    wln(self, "            pthread_mutex_unlock(&__p_gq_mx);");
    wln(self, "        }");
    wln(self, "        if (!c && !__p_mn_shared) c = __p_lq_steal(id);");
    wln(self, "        if (!c) {");
    // RT8 x RT10: a worker never ends, so before it sleeps its heap takes
    // what other workers freed into it and its span cache (RT8) is purged of
    // spans unused for P_SPAN_PURGE_MS (__p_heap_idle)
    wln(self, "            __p_heap_idle();");
    wln(self, "            pthread_mutex_lock(&__p_gq_mx);");
    wln(self, "            P_AADD(&__p_mn_idle, 1);");
    wln(self, "            if (__p_gq_n == 0 && (__p_mn_shared || !__p_lq_any())) pthread_cond_wait(&__p_gq_cv, &__p_gq_mx);");
    wln(self, "            P_AADD(&__p_mn_idle, -1);");
    wln(self, "            pthread_mutex_unlock(&__p_gq_mx);");
    wln(self, "            continue;");
    wln(self, "        }");
    wln(self, "        __p_co_enter(c);");
    wln(self, "    }");
    wln(self, "    return NULL;");
    wln(self, "}");
    wln(self, "/* --- the poller thread: deadlines and socket waits --- */");
    wln(self, "static void __p_pl_poke(void) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    HANDLE port = (HANDLE)__atomic_load_n(&__p_pl_port, __ATOMIC_SEQ_CST);");
    wln(self, "    if (port) PostQueuedCompletionStatus(port, 0, 0, NULL);");
    wln(self, "    else SetEvent(__p_pl_evt);");
    wln(self, "#else");
    wln(self, "    char b = 1;");
    wln(self, "    ssize_t r = write(__p_pl_fd[1], &b, 1);");
    wln(self, "    (void)r;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static void* __p_pl_main(void* arg);");
    wln(self, "/* Hand c (a sleep, a socket wait) to the poller, which starts with the first */");
    wln(self, "static void __p_pl_submit(__p_co* c) {");
    wln(self, "    pthread_mutex_lock(&__p_pl_mx);");
    wln(self, "    if (!__p_pl_on) {");
    wln(self, "        __p_pl_on = 1;");
    wln(self, "#ifdef _WIN32");
    wln(self, "        __p_pl_evt = CreateEventA(NULL, FALSE, FALSE, NULL);");
    wln(self, "#else");
    wln(self, "        if (pipe(__p_pl_fd) == 0) {");
    wln(self, "            for (int i = 0; i < 2; i++) {");
    wln(self, "                fcntl(__p_pl_fd[i], F_SETFL, fcntl(__p_pl_fd[i], F_GETFL, 0) | O_NONBLOCK);");
    wln(self, "                fcntl(__p_pl_fd[i], F_SETFD, FD_CLOEXEC);");
    wln(self, "            }");
    wln(self, "        } else { __p_pl_fd[0] = -1; __p_pl_fd[1] = -1; }");
    wln(self, "#endif");
    wln(self, "        pthread_t t;");
    wln(self, "        if (pthread_create(&t, NULL, __p_pl_main, NULL) != 0) p_panic(\"tasks: could not start the poller thread\");");
    wln(self, "    }");
    wln(self, "    c->qnext = __p_pl_in;");
    wln(self, "    __p_pl_in = c;");
    wln(self, "    int w = __p_pl_waiting;");
    wln(self, "    __p_pl_waiting = 0;");
    wln(self, "    pthread_mutex_unlock(&__p_pl_mx);");
    wln(self, "    if (w) __p_pl_poke();");
    wln(self, "}");
    wln(self, "/* Out of the timer heap at its index (the poller's thread) */");
    wln(self, "static void __p_th_del(__p_co* c) {");
    wln(self, "    int64_t i = c->hidx;");
    wln(self, "    if (i < 0) return;");
    wln(self, "    c->hidx = -1;");
    wln(self, "    __p_co* last = __p_th[--__p_th_n];");
    wln(self, "    if (i == __p_th_n) return;");
    wln(self, "    while (i > 0) {");
    wln(self, "        int64_t up = (i - 1) / 2;");
    wln(self, "        if (!__p_th_less(last, __p_th[up])) break;");
    wln(self, "        __p_th_set(i, __p_th[up]);");
    wln(self, "        i = up;");
    wln(self, "    }");
    wln(self, "    for (;;) {");
    wln(self, "        int64_t l = 2 * i + 1, m = i;");
    wln(self, "        __p_co* best = last;");
    wln(self, "        if (l < __p_th_n && __p_th_less(__p_th[l], best)) { m = l; best = __p_th[l]; }");
    wln(self, "        if (l + 1 < __p_th_n && __p_th_less(__p_th[l + 1], best)) { m = l + 1; best = __p_th[l + 1]; }");
    wln(self, "        if (m == i) break;");
    wln(self, "        __p_th_set(i, best);");
    wln(self, "        i = m;");
    wln(self, "    }");
    wln(self, "    __p_th_set(i, last);");
    wln(self, "}");
    wln(self, "/* Out of the poll set (the sockets the event queue does not watch) */");
    wln(self, "static void __p_pl_fb_del(__p_co* c) {");
    wln(self, "    int64_t i = c->fbi;");
    wln(self, "    if (i < 0) return;");
    wln(self, "    __p_co* last = __p_pl_fb[--__p_pl_fb_n];");
    wln(self, "    __p_pl_fb[i] = last;");
    wln(self, "    last->fbi = i;");
    wln(self, "    c->fbi = -1;");
    wln(self, "}");
    wln(self, "static void __p_pl_add(__p_co* c) {");
    wln(self, "    if (c->fd >= 0) {");
    wln(self, "        int armed = 0;");
    wln(self, "#ifdef P_EV");
    wln(self, "        armed = __p_ev_arm(c);");
    wln(self, "#endif");
    wln(self, "        if (!armed) {");
    wln(self, "            if (__p_pl_fb_n == __p_pl_fb_cap) {");
    wln(self, "                __p_pl_fb_cap = __p_pl_fb_cap ? __p_pl_fb_cap * 2 : 64;");
    wln(self, "                __p_pl_fb = (__p_co**)realloc(__p_pl_fb, (size_t)__p_pl_fb_cap * sizeof(__p_co*));");
    wln(self, "            }");
    wln(self, "            c->fbi = __p_pl_fb_n;");
    wln(self, "            __p_pl_fb[__p_pl_fb_n++] = c;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    if (c->wake_ms) __p_th_push(c);");
    wln(self, "}");
    wln(self, "/* c's wait is over (its socket is ready: ready set, fd -1): queue it */");
    wln(self, "static void __p_pl_woke(__p_co* c) {");
    wln(self, "    __p_th_del(c);");
    wln(self, "    __p_pl_fb_del(c);");
    wln(self, "    __p_mn_ready(c, 0);");
    wln(self, "}");
    wln(self, "/* The tasks whose deadline came, in deadline order (ties: creation order) */");
    wln(self, "static void __p_pl_due(int64_t now) {");
    wln(self, "    while (__p_th_n > 0 && __p_th[0]->wake_ms <= now) {");
    wln(self, "        __p_co* c = __p_th_pop();");
    wln(self, "#ifdef P_EV");
    wln(self, "        if (c->ev) __p_ev_drop(c, 1);");
    wln(self, "#endif");
    wln(self, "        __p_pl_fb_del(c);");
    wln(self, "        c->ready = 0; c->fd = -1; c->wake_ms = 0;");
    wln(self, "        __p_mn_ready(c, 0);");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "static void* __p_pl_main(void* arg) {");
    wln(self, "    (void)arg;");
    wln(self, "    __p_thread_guard_init();");
    wln(self, "#ifdef _WIN32");
    wln(self, "    if (__p_ev_init()) __atomic_store_n(&__p_pl_port, __p_ev_iocp, __ATOMIC_SEQ_CST);");
    wln(self, "    WSAPOLLFD* fds = NULL;");
    wln(self, "#else");
    wln(self, "    struct pollfd* fds = NULL;");
    wln(self, "#endif");
    wln(self, "    int64_t cap = 0;");
    wln(self, "    for (;;) {");
    wln(self, "        pthread_mutex_lock(&__p_pl_mx);");
    wln(self, "        __p_co* in = __p_pl_in;");
    wln(self, "        __p_pl_in = NULL;");
    wln(self, "        __p_pl_waiting = 1;");
    wln(self, "        pthread_mutex_unlock(&__p_pl_mx);");
    wln(self, "        __p_co* rev = NULL;");
    wln(self, "        while (in) { __p_co* nx = in->qnext; in->qnext = rev; rev = in; in = nx; }");
    wln(self, "        while (rev) { __p_co* nx = rev->qnext; rev->qnext = NULL; __p_pl_add(rev); rev = nx; }");
    wln(self, "        int64_t now = __p_co_now();");
    wln(self, "        __p_pl_due(now);");
    wln(self, "        int64_t timeout = -1;");
    wln(self, "        if (__p_th_n > 0) { int64_t hw = __p_th[0]->wake_ms; timeout = hw > now ? hw - now : 0; }");
    wln(self, "        int64_t n = __p_pl_fb_n;");
    wln(self, "        if (n + 2 > cap) { cap = n * 2 + 4; fds = realloc(fds, (size_t)cap * sizeof(*fds)); }");
    wln(self, "#ifdef _WIN32");
    wln(self, "        if (n > 0) {");
    wln(self, "            for (int64_t i = 0; i < n; i++) {");
    wln(self, "                __p_co* c = __p_pl_fb[i];");
    wln(self, "                fds[i].fd = (SOCKET)c->fd; fds[i].events = c->fd_write ? POLLOUT : POLLIN; fds[i].revents = 0;");
    wln(self, "            }");
    wln(self, "            int r = WSAPoll(fds, (ULONG)n, (INT)(timeout < 0 || timeout > 10 ? 10 : timeout));");
    wln(self, "            if (__p_pl_port) __p_ev_poll(0);");
    wln(self, "            else WaitForSingleObject(__p_pl_evt, 0);");
    wln(self, "            if (r > 0) {");
    wln(self, "                for (int64_t i = n - 1; i >= 0; i--) {");
    wln(self, "                    if (!fds[i].revents) continue;");
    wln(self, "                    __p_co* c = __p_pl_fb[i];");
    wln(self, "                    c->ready = 1; c->fd = -1; c->wake_ms = 0;");
    wln(self, "                    __p_pl_woke(c);");
    wln(self, "                }");
    wln(self, "            }");
    wln(self, "        } else if (__p_pl_port) {");
    wln(self, "            __p_ev_poll(timeout);");
    wln(self, "        } else {");
    wln(self, "            WaitForSingleObject(__p_pl_evt, timeout < 0 ? INFINITE : (DWORD)timeout);");
    wln(self, "        }");
    wln(self, "#else");
    wln(self, "        int64_t k = 0;");
    wln(self, "        fds[k].fd = __p_pl_fd[0]; fds[k].events = POLLIN; fds[k].revents = 0; k++;");
    wln(self, "        int64_t evq = -1;");
    wln(self, "#ifdef P_EV");
    wln(self, "        if (__p_ev_q >= 0) { evq = k; fds[k].fd = __p_ev_q; fds[k].events = POLLIN; fds[k].revents = 0; k++; }");
    wln(self, "#endif");
    wln(self, "        int64_t base = k;");
    wln(self, "        for (int64_t i = 0; i < n; i++) {");
    wln(self, "            __p_co* c = __p_pl_fb[i];");
    wln(self, "            fds[k].fd = (int)c->fd; fds[k].events = c->fd_write ? POLLOUT : POLLIN; fds[k].revents = 0; k++;");
    wln(self, "        }");
    wln(self, "        /* no pipe to wake it: look again every 10 ms */");
    wln(self, "        if (__p_pl_fd[0] < 0 && (timeout < 0 || timeout > 10)) timeout = 10;");
    wln(self, "        int r = poll(fds, (nfds_t)k, (int)timeout);");
    wln(self, "        if (r > 0) {");
    wln(self, "            if (fds[0].revents) { char buf[64]; while (read(__p_pl_fd[0], buf, sizeof buf) > 0) {} }");
    wln(self, "#ifdef P_EV");
    wln(self, "            if (evq >= 0 && fds[evq].revents) __p_ev_poll(0);");
    wln(self, "#endif");
    wln(self, "            /* from the end: a task that leaves the poll set gives its slot");
    wln(self, "               to the last one, which was looked at already */");
    wln(self, "            for (int64_t i = n - 1; i >= 0; i--) {");
    wln(self, "                if (!fds[base + i].revents) continue;");
    wln(self, "                __p_co* c = __p_pl_fb[i];");
    wln(self, "                c->ready = 1; c->fd = -1; c->wake_ms = 0;");
    wln(self, "                __p_pl_woke(c);");
    wln(self, "            }");
    wln(self, "        }");
    wln(self, "#endif");
    wln(self, "        __p_pl_due(__p_co_now());");
    wln(self, "    }");
    wln(self, "    return NULL;");
    wln(self, "}");
    wln(self, "/* Finish c's switch out, in the context it returned to: free its stack and");
    wln(self, "   wake its waiters when it ended, else queue it, park it on the task it");
    wln(self, "   awaits or on a channel, or hand it to the poller. Nothing touches c");
    wln(self, "   after that: another worker may already run it. */");
    wln(self, "static P_MN_NOINLINE void __p_mn_settle(__p_co* c) {");
    wln(self, "    if (__atomic_load_n(&c->done, __ATOMIC_ACQUIRE)) {");
    wln(self, "#if defined(P_WIN_CTX)");
    wln(self, "        VirtualFree(c->stack, 0, MEM_RELEASE);");
    wln(self, "#else");
    wln(self, "        munmap(c->stack, (size_t)c->stack_size);");
    wln(self, "#endif");
    wln(self, "        c->stack = NULL;");
    wln(self, "        __p_co_lock(c);");
    wln(self, "        __atomic_store_n(&c->settled, 1, __ATOMIC_RELEASE);");
    wln(self, "        __p_co* j = c->joiners;");
    wln(self, "        c->joiners = NULL;");
    wln(self, "        int det = c->detached, ext = c->extw;");
    wln(self, "        __p_co_unlock(c);");
    wln(self, "        while (j) {");
    wln(self, "            __p_co* nx = j->qnext;");
    wln(self, "            j->qnext = NULL;");
    wln(self, "            P_AADD(&__p_mn_joined, -1);");
    wln(self, "            __p_mn_ready(j, 1);");
    wln(self, "            j = nx;");
    wln(self, "        }");
    wln(self, "        if (det) free(c);");
    wln(self, "        int64_t live = P_AADD(&__p_mn_live, -1);");
    wln(self, "        if (ext || (live == 0 && P_AL(&__p_mn_runw) > 0)) {");
    wln(self, "            pthread_mutex_lock(&__p_mn_dmx);");
    wln(self, "            pthread_cond_broadcast(&__p_mn_dcv);");
    wln(self, "            pthread_mutex_unlock(&__p_mn_dmx);");
    wln(self, "        }");
    wln(self, "        return;");
    wln(self, "    }");
    wln(self, "    int lv = c->lv;");
    wln(self, "    c->lv = P_LV_YIELD;");
    wln(self, "    if (lv == P_LV_AWAIT) {");
    wln(self, "        __p_co* t = (__p_co*)c->lvobj;");
    wln(self, "        __p_co_lock(t);");
    wln(self, "        if (t->settled) { __p_co_unlock(t); __p_mn_ready(c, 1); return; }");
    wln(self, "        c->qnext = t->joiners;");
    wln(self, "        t->joiners = c;");
    wln(self, "        int64_t jn = P_AADD(&__p_mn_joined, 1);");
    wln(self, "        __p_co_unlock(t);");
    wln(self, "        /* every unfinished task awaits another: none will ever finish */");
    wln(self, "        if (jn == P_AL(&__p_mn_live)) p_panic(\"Tasks are deadlocked: each one awaits another\");");
    wln(self, "        return;");
    wln(self, "    }");
    wln(self, "    if (lv == P_LV_POLL) { __p_pl_submit(c); return; }");
    wln(self, "    if (lv == P_LV_CHAN) { __p_chan_settle(c); return; }");
    wln(self, "    __p_mn_ready(c, 1);");
    wln(self, "}");
    wln(self, "static P_MN_NOINLINE void __p_mn_yield(void) {");
    wln(self, "    __p_co* me = __p_co_self();");
    wln(self, "    if (!me) return;");
    wln(self, "    me->lv = P_LV_YIELD;");
    wln(self, "    __p_co_leave();");
    wln(self, "}");
    wln(self, "static P_MN_NOINLINE int64_t __p_mn_sleep(int64_t ms) {");
    wln(self, "    __p_co* me = __p_co_self();");
    wln(self, "    if (me) {");
    wln(self, "        me->wake_ms = __p_co_now() + (ms > 0 ? ms : 0) + 1;");
    wln(self, "        me->lv = P_LV_POLL;");
    wln(self, "        __p_co_leave();");
    wln(self, "        return 0;");
    wln(self, "    }");
    wln(self, "    /* off a task the workers run the tasks meanwhile */");
    wln(self, "#ifdef _WIN32");
    wln(self, "    Sleep((DWORD)(ms > 0 ? ms : 0));");
    wln(self, "#else");
    wln(self, "    poll(NULL, 0, (int)(ms > 0 ? ms : 0));");
    wln(self, "#endif");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "/* A task's socket wait: 1 ready, 0 timed out; -1 off a task (the caller");
    wln(self, "   waits on the thread itself) */");
    wln(self, "static P_MN_NOINLINE int64_t __p_mn_wait_fd(int64_t fd, int64_t write, int64_t timeout_ms) {");
    wln(self, "    __p_co* me = __p_co_self();");
    wln(self, "    if (!me) return -1;");
    wln(self, "    me->fd = fd;");
    wln(self, "    me->fd_write = write;");
    wln(self, "    me->ready = 0;");
    wln(self, "    me->wake_ms = timeout_ms >= 0 ? __p_co_now() + timeout_ms + 1 : 0;");
    wln(self, "    me->lv = P_LV_POLL;");
    wln(self, "    __p_co_leave();");
    wln(self, "    return me->ready;");
    wln(self, "}");
    wln(self, "static P_MN_NOINLINE int64_t __p_mn_await(__p_co* c) {");
    wln(self, "    __p_co* me = __p_co_self();");
    wln(self, "    if (me && !__atomic_load_n(&c->done, __ATOMIC_ACQUIRE)) c->waiter = me;");
    wln(self, "    /* CA7: with a token in the slot, in slices, 0 once it is cancelled */");
    wln(self, "    int64_t tok = __atomic_load_n(&c->done, __ATOMIC_ACQUIRE) ? 0 : p_task_token();");
    wln(self, "    while (tok && !__atomic_load_n(&c->done, __ATOMIC_ACQUIRE)) {");
    wln(self, "        if (__p_tok_cancelled(tok)) { if (c->waiter == me) c->waiter = NULL; return 0; }");
    wln(self, "        __p_co_nap(1);");
    wln(self, "    }");
    wln(self, "    if (me) {");
    wln(self, "        while (!__atomic_load_n(&c->done, __ATOMIC_ACQUIRE)) {");
    wln(self, "            me->lv = P_LV_AWAIT;");
    wln(self, "            me->lvobj = c;");
    wln(self, "            __p_co_leave();");
    wln(self, "        }");
    wln(self, "        me->lvobj = NULL;");
    wln(self, "        return c->result;");
    wln(self, "    }");
    wln(self, "    /* off a task: sleep until it is settled */");
    wln(self, "    __p_co_lock(c);");
    wln(self, "    int s = c->settled;");
    wln(self, "    if (!s) c->extw = 1;");
    wln(self, "    __p_co_unlock(c);");
    wln(self, "    if (!s) {");
    wln(self, "        pthread_mutex_lock(&__p_mn_dmx);");
    wln(self, "        while (!__atomic_load_n(&c->settled, __ATOMIC_ACQUIRE)) pthread_cond_wait(&__p_mn_dcv, &__p_mn_dmx);");
    wln(self, "        pthread_mutex_unlock(&__p_mn_dmx);");
    wln(self, "    }");
    wln(self, "    return c->result;");
    wln(self, "}");
    wln(self, "/* task_run: off a task, sleep until no task is unfinished; in a task,");
    wln(self, "   until only the tasks in task_run are */");
    wln(self, "static P_MN_NOINLINE int64_t __p_mn_run(void) {");
    wln(self, "    __p_co* me = __p_co_self();");
    wln(self, "    if (me) {");
    wln(self, "        P_AADD(&__p_mn_inrun, 1);");
    wln(self, "        while (P_AL(&__p_mn_live) > P_AL(&__p_mn_inrun)) __p_co_nap(1);");
    wln(self, "        P_AADD(&__p_mn_inrun, -1);");
    wln(self, "        return P_AL(&__p_mn_total);");
    wln(self, "    }");
    wln(self, "    P_AADD(&__p_mn_runw, 1);");
    wln(self, "    pthread_mutex_lock(&__p_mn_dmx);");
    wln(self, "    while (P_AL(&__p_mn_live) > 0) pthread_cond_wait(&__p_mn_dcv, &__p_mn_dmx);");
    wln(self, "    pthread_mutex_unlock(&__p_mn_dmx);");
    wln(self, "    P_AADD(&__p_mn_runw, -1);");
    wln(self, "    return P_AL(&__p_mn_total);");
    wln(self, "}");
    wln(self, "/* A task blocked on a channel (its mutex mx held): switch out, parked on");
    wln(self, "   the channel by __p_chan_settle, until a send, a receive or the close");
    wln(self, "   wakes it; mx is held again on return. 0 off a task (the caller waits");
    wln(self, "   on the condition variable, as threads do). */");
    wln(self, "static P_MN_NOINLINE int __p_mn_chan_park(void* ch, pthread_mutex_t* mx, int send) {");
    wln(self, "    __p_co* me = __p_co_self();");
    wln(self, "    if (!me) return 0;");
    wln(self, "    pthread_mutex_unlock(mx);");
    wln(self, "    me->lv = P_LV_CHAN;");
    wln(self, "    me->lvobj = ch;");
    wln(self, "    me->lvarg = send;");
    wln(self, "    __p_co_leave();");
    wln(self, "    pthread_mutex_lock(mx);");
    wln(self, "    return 1;");
    wln(self, "}");
    wln(self, "/* LG11 under M:N: in a task, the stack of the tasks it starts from now on");
    wln(self, "   (its children start with its value); off a task, this thread's */");
    wln(self, "static P_MN_NOINLINE int64_t __p_mn_stack(int64_t bytes) {");
    wln(self, "    int64_t v = bytes > 0 ? ((bytes + 65535) & ~(int64_t)65535) : 0;");
    wln(self, "    __p_co* me = __p_mn_on() ? __p_co_self() : NULL;");
    wln(self, "    int64_t was;");
    wln(self, "    if (me) { was = me->stack_req; me->stack_req = v; }");
    wln(self, "    else { was = __p_co_stack_req; __p_co_stack_req = v; }");
    wln(self, "    return was;");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "/* RT10: p_co_workers(n) asks for n workers (1: one cooperative scheduler");
    wln(self, "   per thread, as before) before the program's first task, and wins over");
    wln(self, "   FIDES_WORKERS. Returns the count once tasks run (n asked before them;");
    wln(self, "   0 for n <= 0 then); 1 where tasks cannot move between threads. Also");
    wln(self, "   reached as p_thread_spawn(\"__p_co_workers\", 1, n), which an older runtime");
    wln(self, "   answers -1: fid's interpreter asks for 1 that way (its tasks share its");
    wln(self, "   state). A program declares it `extern \"C\" fn p_co_workers(n: i64) -> i64;`.");
    wln(self, "   p_co_worker(): the worker running the caller (1..n), 0 off a worker. */");
    wln(self, "int64_t p_co_workers(int64_t n) {");
    wln(self, "#ifdef P_MN");
    wln(self, "    int m = __atomic_load_n(&__p_mn, __ATOMIC_ACQUIRE);");
    wln(self, "    if (m) return m;");
    wln(self, "    if (n <= 0) return 0;");
    wln(self, "    __p_mn_req = n > 16 ? 16 : n;");
    wln(self, "    return __p_mn_req;");
    wln(self, "#else");
    wln(self, "    (void)n;");
    wln(self, "    return 1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_co_worker(void) {");
    wln(self, "#ifdef P_MN");
    wln(self, "    return __p_wk_self();");
    wln(self, "#else");
    wln(self, "    return 0;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "/* Sleep until a waiting task can run, at most limit ms (-1: no limit). With");
    wln(self, "   ran set, only look. Panics if no task ever will. Wakes the earliest");
    wln(self, "   deadline only: the next pass takes the next, so timers fire in order. */");
    wln(self, "static void __p_co_wait(int64_t ran, int64_t limit) {");
    wln(self, "    int64_t n = 0;");
    wln(self, "    int64_t timeout = ran ? 0 : limit;");
    wln(self, "    int64_t first = 0;");
    wln(self, "    int64_t now = __p_co_now();");
    wln(self, "#ifdef _WIN32");
    wln(self, "    static P_THREAD_LOCAL WSAPOLLFD* fds = NULL;");
    wln(self, "#else");
    wln(self, "    static P_THREAD_LOCAL struct pollfd* fds = NULL;");
    wln(self, "#endif");
    wln(self, "    static P_THREAD_LOCAL int64_t cap = 0;");
    wln(self, "    if (__p_co_count + 1 > cap) {");
    wln(self, "        cap = __p_co_count * 2 + 2;");
    wln(self, "        fds = realloc(fds, (size_t)cap * sizeof(*fds));");
    wln(self, "    }");
    wln(self, "    for (int64_t i = 0; i < __p_co_count; i++) {");
    wln(self, "        __p_co* c = __p_cos[i];");
    wln(self, "        if (c->fd >= 0 && !c->ev) {");
    wln(self, "            fds[n].fd = (c->fd);");
    wln(self, "            fds[n].events = c->fd_write ? POLLOUT : POLLIN;");
    wln(self, "            fds[n].revents = 0;");
    wln(self, "            n++;");
    wln(self, "        }");
    wln(self, "        if (c->wake_ms) {");
    wln(self, "            if (!first || c->wake_ms < first) first = c->wake_ms;");
    wln(self, "            int64_t left = c->wake_ms > now ? c->wake_ms - now : 0;");
    wln(self, "            if (timeout < 0 || left < timeout) timeout = left;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    if (__p_th_n > 0) {");
    wln(self, "        int64_t hw = __p_th[0]->wake_ms;");
    wln(self, "        if (!first || hw < first) first = hw;");
    wln(self, "        int64_t left = hw > now ? hw - now : 0;");
    wln(self, "        if (timeout < 0 || left < timeout) timeout = left;");
    wln(self, "    }");
    wln(self, "    if (n == 0 && timeout < 0 && __p_ev_n == 0) p_panic(\"Tasks are deadlocked: each one awaits another\");");
    wln(self, "    int waited = 0;");
    wln(self, "#ifdef P_EV");
    wln(self, "    if (__p_ev_n > 0) {");
    wln(self, "        waited = 1;");
    wln(self, "        if (n == 0) __p_ev_poll(timeout);");
    wln(self, "#ifdef __linux__");
    wln(self, "        else {");
    wln(self, "            /* the epoll queue is itself one more descriptor to poll */");
    wln(self, "            fds[n].fd = __p_ev_q; fds[n].events = POLLIN; fds[n].revents = 0;");
    wln(self, "            poll(fds, (nfds_t)(n + 1), (int)timeout);");
    wln(self, "            if (fds[n].revents) __p_ev_poll(0);");
    wln(self, "        }");
    wln(self, "#else");
    wln(self, "        else {");
    wln(self, "#ifdef _WIN32");
    wln(self, "            WSAPoll(fds, (ULONG)n, (INT)(timeout < 0 || timeout > 10 ? 10 : timeout));");
    wln(self, "#else");
    wln(self, "            poll(fds, (nfds_t)n, (int)(timeout < 0 || timeout > 10 ? 10 : timeout));");
    wln(self, "#endif");
    wln(self, "            __p_ev_poll(0);");
    wln(self, "        }");
    wln(self, "#endif");
    wln(self, "    }");
    wln(self, "#endif");
    wln(self, "    if (waited) {");
    wln(self, "    } else if (n > 0) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        WSAPoll(fds, (ULONG)n, (INT)timeout);");
    wln(self, "#else");
    wln(self, "        poll(fds, (nfds_t)n, (int)timeout);");
    wln(self, "#endif");
    wln(self, "    } else if (timeout > 0) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        Sleep((DWORD)timeout);");
    wln(self, "#else");
    wln(self, "        poll(NULL, 0, (int)timeout);");
    wln(self, "#endif");
    wln(self, "    }");
    wln(self, "    now = __p_co_now();");
    wln(self, "    int64_t k = 0;");
    wln(self, "    for (int64_t i = 0; i < __p_co_count; i++) {");
    wln(self, "        __p_co* c = __p_cos[i];");
    wln(self, "        int hit = 0;");
    wln(self, "        if (c->fd >= 0 && !c->ev) { hit = fds[k].revents != 0; k++; }");
    wln(self, "        if (hit) { c->ready = 1; c->fd = -1; c->wake_ms = 0; }");
    wln(self, "        else if (c->wake_ms == first && first && first <= now) {");
    wln(self, "#ifdef P_EV");
    wln(self, "            if (c->ev) __p_ev_drop(c, 1);");
    wln(self, "#endif");
    wln(self, "            c->ready = 0; c->fd = -1; c->wake_ms = 0;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    /* the sleepers due at the first deadline, back into __p_cos by seq */");
    wln(self, "    while (__p_th_n > 0 && __p_th[0]->wake_ms == first && first && first <= now) {");
    wln(self, "        __p_co* c = __p_th_pop();");
    wln(self, "        c->ready = 0; c->fd = -1; c->wake_ms = 0;");
    wln(self, "        if (__p_co_count == __p_co_cap) {");
    wln(self, "            __p_co_cap = __p_co_cap ? __p_co_cap * 2 : 64;");
    wln(self, "            __p_cos = (__p_co**)realloc(__p_cos, (size_t)__p_co_cap * sizeof(__p_co*));");
    wln(self, "        }");
    wln(self, "        int64_t j = __p_co_count++;");
    wln(self, "        while (j > 0 && __p_cos[j - 1]->seq > c->seq) { __p_cos[j] = __p_cos[j - 1]; j--; }");
    wln(self, "        __p_cos[j] = c;");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "int64_t p_co_go(const char* name, int64_t arg) {");
    wln(self, "    __p_co* c = __p_co_new(name, 1, &arg);");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (__p_mn_on()) __p_mn_ready(c, 0);");
    wln(self, "#endif");
    wln(self, "    return (int64_t)c;");
    wln(self, "}");
    wln(self, "int64_t p_co_async(const char* name, int64_t nargs, ...) {");
    // BG133: a 9th argument was dropped (the function read garbage)
    wln(self, "    if (nargs > 8) p_panic(\"task: a function started by name takes at most 8 arguments\");");
    wln(self, "    int64_t args[8] = {0};");
    wln(self, "    va_list ap;");
    wln(self, "    va_start(ap, nargs);");
    wln(self, "    for (int64_t i = 0; i < nargs && i < 8; i++) args[i] = va_arg(ap, int64_t);");
    wln(self, "    va_end(ap);");
    wln(self, "    __p_co* c = __p_co_new(name, nargs, args);");
    wln(self, "    c->back = __p_co_cur;");
    wln(self, "    __p_co_enter(c);");
    wln(self, "    return (int64_t)((uint64_t)__P_CO_TAG << 48 | (uint64_t)(uintptr_t)c);");
    wln(self, "}");
    // p_co_pool_call(name, nargs, argv): the blocking pool exists only in
    // the native Windows runtime; here the call runs inline (as src/codegen_c.rs)
    wln(self, "int64_t p_co_pool_call(const char* name, int64_t nargs, const int64_t* argv) {");
    wln(self, "    int64_t (*fn)() = NULL;");
    wln(self, "    for (int i = 0; i < p_thread_entry_count; i++) {");
    wln(self, "        if (strcmp(p_thread_entries[i].name, name) == 0) { fn = p_thread_entries[i].fn; break; }");
    wln(self, "    }");
    wln(self, "    if (!fn) { p_panic(\"pool call: no such function\"); return 0; }");
    wln(self, "    const int64_t* a = argv;");
    wln(self, "    switch (nargs) {");
    wln(self, "        case 0: return ((int64_t (*)(void*))fn)(NULL);");
    wln(self, "        case 1: return ((int64_t (*)(void*, int64_t))fn)(NULL, a[0]);");
    wln(self, "        case 2: return ((int64_t (*)(void*, int64_t, int64_t))fn)(NULL, a[0], a[1]);");
    wln(self, "        case 3: return ((int64_t (*)(void*, int64_t, int64_t, int64_t))fn)(NULL, a[0], a[1], a[2]);");
    wln(self, "        default: return ((int64_t (*)(void*, int64_t, int64_t, int64_t, int64_t))fn)(NULL, a[0], a[1], a[2], a[3]);");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "void p_co_yield(void) {");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (__p_mn_on()) { __p_mn_yield(); return; }");
    wln(self, "#endif");
    wln(self, "    if (__p_co_cur) __p_co_leave();");
    wln(self, "}");
    // RL17: a random interleaving point (random mode only)
    wln(self, "static void __p_rnd_point(void) {");
    wln(self, "    if (__p_rnd_on == 2 || !__p_rnd_enabled()) return;");
    wln(self, "    if (__p_co_cur) {");
    wln(self, "#ifndef P_NO_CTX");
    wln(self, "        if (__p_rnd_held == 0 && __p_co_count > 1 && __p_rnd_below(2) == 0) __p_co_leave();");
    wln(self, "#endif");
    wln(self, "        return;");
    wln(self, "    }");
    wln(self, "    int64_t r = __p_rnd_below(8);");
    wln(self, "    if (r > 1) return;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    Sleep((DWORD)r);");
    wln(self, "#else");
    wln(self, "    poll(NULL, 0, (int)r);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_co_run(void) {");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (__p_mn_on()) return __p_mn_run();");
    wln(self, "#endif");
    // BG76: called from a task (one worker), a pass here ran inside the pass
    // that is running this task, over the same list (entering this task
    // again, and the outer pass's compaction lost or repeated tasks). The
    // task gives its turn instead until it is the only task of this thread
    // left; with P_NO_CTX the others ran to their end when they started.
    wln(self, "    if (__p_co_cur) {");
    wln(self, "#ifndef P_NO_CTX");
    wln(self, "        while (__p_co_count + __p_th_n + __p_co_pk_n > 1) __p_co_leave();");
    wln(self, "#endif");
    wln(self, "        return __p_co_total;");
    wln(self, "    }");
    wln(self, "    for (;;) {");
    wln(self, "        int64_t ran;");
    wln(self, "        if (__p_co_round(&ran) == 0) return __p_co_total;");
    wln(self, "        __p_co_wait(ran, -1);");
    wln(self, "    }");
    wln(self, "}");
    // CA7: a short wait of a wait that respects the token slot: other tasks
    // run meanwhile (a task gives its turn, main runs theirs)
    wln(self, "static int64_t __p_co_sleep_plain(int64_t ms);");
    wln(self, "static void __p_co_nap(int64_t ms) {");
    wln(self, "#ifdef P_NO_CTX");
    wln(self, "    if (__p_co_cur) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        Sleep((DWORD)(ms > 0 ? ms : 0));");
    wln(self, "#else");
    wln(self, "        poll(NULL, 0, (int)(ms > 0 ? ms : 0));");
    wln(self, "#endif");
    wln(self, "        return;");
    wln(self, "    }");
    wln(self, "#endif");
    wln(self, "    __p_co_sleep_plain(ms);");
    wln(self, "}");
    wln(self, "static int64_t __p_co_await(int64_t future) {");
    wln(self, "    __p_co* c = (__p_co*)(uintptr_t)((uint64_t)future & 0xFFFFFFFFFFFFULL);");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (__p_mn_on()) return __p_mn_await(c);");
    wln(self, "#endif");
    wln(self, "    if (__p_co_cur && !c->done) c->waiter = __p_co_cur;");
    // CA7: with a token in the slot, wait in slices and give up (0) once
    // it is cancelled; the task awaited goes on, nobody waits for it now
    wln(self, "    int64_t tok = c->done ? 0 : p_task_token();");
    wln(self, "#ifdef P_NO_CTX");
    wln(self, "    if (__p_co_cur) tok = 0;");
    wln(self, "#endif");
    wln(self, "    while (tok && !c->done) {");
    wln(self, "        if (__p_tok_cancelled(tok)) { if (c->waiter == __p_co_cur) c->waiter = NULL; return 0; }");
    wln(self, "        __p_co_nap(1);");
    wln(self, "    }");
    wln(self, "    while (!c->done) {");
    wln(self, "#ifdef P_NO_CTX");
    wln(self, "        if (__p_co_cur) { __p_co_enter(c); continue; }");
    wln(self, "#endif");
    wln(self, "        if (__p_co_cur) {");
    wln(self, "            __p_co_cur->awaits = c;");
    wln(self, "            __p_co_leave();");
    wln(self, "        } else {");
    wln(self, "            int64_t ran;");
    wln(self, "            __p_co_round(&ran);");
    wln(self, "            if (!c->done) __p_co_wait(ran, -1);");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    return c->result;");
    wln(self, "}");
    wln(self, "static int64_t __p_co_sleep_plain(int64_t ms) {");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (__p_mn_on()) return __p_mn_sleep(ms);");
    wln(self, "#endif");
    wln(self, "    if (__p_co_cur) {");
    wln(self, "        __p_co_cur->wake_ms = __p_co_now() + (ms > 0 ? ms : 0) + 1;");
    wln(self, "        __p_co_leave();");
    wln(self, "        return 0;");
    wln(self, "    }");
    wln(self, "    int64_t end = __p_co_now() + ms;");
    wln(self, "    for (;;) {");
    wln(self, "        int64_t ran;");
    wln(self, "        int64_t live = __p_co_round(&ran);");
    wln(self, "        int64_t left = end - __p_co_now();");
    wln(self, "        if (left <= 0) return 0;");
    wln(self, "        if (live) __p_co_wait(ran, left);");
    wln(self, "        else {");
    wln(self, "#ifdef _WIN32");
    wln(self, "            Sleep((DWORD)left);");
    wln(self, "#else");
    wln(self, "            poll(NULL, 0, (int)left);");
    wln(self, "#endif");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "}");
    // CA7: 1 when the slot's token stopped the sleep, 0 when it all passed
    wln(self, "int64_t p_co_sleep(int64_t ms) {");
    wln(self, "    int64_t tok = p_task_token();");
    wln(self, "    if (!tok) return __p_co_sleep_plain(ms);");
    wln(self, "    int64_t end = __p_co_now() + (ms > 0 ? ms : 0);");
    wln(self, "    for (;;) {");
    wln(self, "        if (__p_tok_cancelled(tok)) return 1;");
    wln(self, "        int64_t left = end - __p_co_now();");
    wln(self, "        if (left <= 0) return 0;");
    wln(self, "        __p_co_nap(__p_tok_slice(tok, left));");
    wln(self, "    }");
    wln(self, "}");
    // CA7: a socket wait under a token: 0 (not ready) once it is cancelled
    wln(self, "static int64_t __p_co_wait_fd_plain(int64_t fd, int64_t write, int64_t timeout_ms);");
    wln(self, "int64_t p_co_wait_fd(int64_t fd, int64_t write, int64_t timeout_ms) {");
    wln(self, "    int64_t tok = p_task_token();");
    wln(self, "    if (!tok) return __p_co_wait_fd_plain(fd, write, timeout_ms);");
    wln(self, "    int64_t start = __p_co_now();");
    wln(self, "    for (;;) {");
    wln(self, "        if (__p_tok_cancelled(tok)) return 0;");
    wln(self, "        int64_t left = -1;");
    wln(self, "        if (timeout_ms >= 0) {");
    wln(self, "            left = timeout_ms - (__p_co_now() - start);");
    wln(self, "            if (left <= 0) return 0;");
    wln(self, "        }");
    wln(self, "        if (__p_co_wait_fd_plain(fd, write, __p_tok_slice(tok, left))) return 1;");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "static int64_t __p_co_wait_fd_plain(int64_t fd, int64_t write, int64_t timeout_ms) {");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (__p_mn_on()) {");
    wln(self, "        int64_t r = __p_mn_wait_fd(fd, write, timeout_ms);");
    wln(self, "        if (r >= 0) return r;");
    wln(self, "    } else");
    wln(self, "#endif");
    wln(self, "    if (__p_co_cur) {");
    wln(self, "        __p_co_cur->fd = fd;");
    wln(self, "        __p_co_cur->fd_write = write;");
    wln(self, "        __p_co_cur->wake_ms = timeout_ms >= 0 ? __p_co_now() + timeout_ms + 1 : 0;");
    wln(self, "#ifdef P_EV");
    wln(self, "        __p_ev_arm(__p_co_cur);");
    wln(self, "#endif");
    wln(self, "        __p_co_leave();");
    wln(self, "        return __p_co_cur->ready;");
    wln(self, "    }");
    wln(self, "#ifdef _WIN32");
    wln(self, "    WSAPOLLFD one;");
    wln(self, "    one.fd = (SOCKET)fd; one.events = write ? POLLOUT : POLLIN; one.revents = 0;");
    wln(self, "    return WSAPoll(&one, 1, (INT)timeout_ms) > 0;");
    wln(self, "#else");
    wln(self, "    struct pollfd one;");
    wln(self, "    one.fd = (int)fd; one.events = write ? POLLOUT : POLLIN; one.revents = 0;");
    wln(self, "    return poll(&one, 1, (int)timeout_ms) > 0;");
    wln(self, "#endif");
    wln(self, "}");
    // An ended task stays in __p_cos until the scheduler's next pass drops
    // it (a task that ended inside p_co_async, never having waited): freed
    // here at once, that pass read freed memory. Detached, the pass frees
    // it; one no longer in the list is freed now.
    // BG45: a thread future (P_FT_FUT(slot), BG73) is let go in the future
    // table: no scan joins it (`spawn detached` of a thread in a scope)
    wln(self, "static void __p_ft_detach(int64_t future);");
    wln(self, "void p_co_detach(int64_t t) {");
    wln(self, "    if (P_FT_IS(t)) { __p_ft_detach(t); return; }");
    wln(self, "    __p_co* c = (__p_co*)(uintptr_t)t;");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (__p_mn_on()) {");
    wln(self, "        /* settled: free it now; else its end frees it */");
    wln(self, "        __p_co_lock(c);");
    wln(self, "        int s = c->settled;");
    wln(self, "        if (!s) c->detached = 1;");
    wln(self, "        __p_co_unlock(c);");
    wln(self, "        if (s) free(c);");
    wln(self, "        return;");
    wln(self, "    }");
    wln(self, "#endif");
    wln(self, "    if (!c->done) { c->detached = 1; return; }");
    wln(self, "    for (int64_t i = 0; i < __p_co_count; i++) {");
    wln(self, "        if (__p_cos[i] == c) { c->detached = 1; return; }");
    wln(self, "    }");
    wln(self, "    free(c);");
    wln(self, "}");
    wln(self, "int64_t p_co_done(int64_t t) { return (int64_t)__atomic_load_n(&((__p_co*)(uintptr_t)t)->done, __ATOMIC_ACQUIRE); }");
    wln(self, "int64_t p_co_result(int64_t t) { return ((__p_co*)(uintptr_t)t)->result; }");
    wln(self, "#ifdef _WIN32");
    wln(self, "#define __P_CO_BLOCKED() (WSAGetLastError() == WSAEWOULDBLOCK)");
    wln(self, "#else");
    wln(self, "#include <errno.h>");
    wln(self, "#include <fcntl.h>");
    wln(self, "#define __P_CO_BLOCKED() (errno == EAGAIN || errno == EWOULDBLOCK)");
    wln(self, "#endif");
    wln(self, "#ifdef P_MN");
    wln(self, "/* RT10: errno anew after a wait (the task may be on another thread now,");
    wln(self, "   and errno's address is a constant to the C compiler) */");
    wln(self, "static P_MN_NOINLINE int __p_co_blocked_now(void) { __asm__ volatile(\"\" ::: \"memory\"); return __P_CO_BLOCKED(); }");
    wln(self, "#undef __P_CO_BLOCKED");
    wln(self, "#define __P_CO_BLOCKED() __p_co_blocked_now()");
    wln(self, "#endif");
    wln(self, "static void __p_co_nonblock(int64_t fd) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    u_long on = 1;");
    wln(self, "    ioctlsocket((SOCKET)fd, FIONBIO, &on);");
    wln(self, "#else");
    wln(self, "    fcntl((int)fd, F_SETFL, fcntl((int)fd, F_GETFL, 0) | O_NONBLOCK);");
    wln(self, "#endif");
    wln(self, "}");
    // RT11: try the accept first on the non-blocking listening socket, and
    // wait on the poller only when no connection is queued (a wait before
    // every accept cost a poller round trip per connection)
    wln(self, "static void __p_co_nonblock_once(int64_t fd) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    __p_co_nonblock(fd);");
    wln(self, "#else");
    wln(self, "    int fl = fcntl((int)fd, F_GETFL, 0);");
    wln(self, "    if (fl >= 0 && !(fl & O_NONBLOCK)) fcntl((int)fd, F_SETFL, fl | O_NONBLOCK);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_co_accept(int64_t fd) {");
    wln(self, "    __p_co_nonblock_once(fd);");
    wln(self, "    for (;;) {");
    wln(self, "        struct sockaddr_storage client;");
    wln(self, "        int64_t c;");
    wln(self, "#ifdef _WIN32");
    wln(self, "        int clen = sizeof(client);");
    wln(self, "        SOCKET s = accept((SOCKET)fd, (struct sockaddr*)&client, &clen);");
    wln(self, "        c = (s == INVALID_SOCKET) ? -1 : (int64_t)s;");
    wln(self, "#else");
    wln(self, "        socklen_t clen = sizeof(client);");
    wln(self, "        c = (int64_t)accept((int)fd, (struct sockaddr*)&client, &clen);");
    wln(self, "        if (c < 0 && errno == EINTR) continue;");
    wln(self, "#endif");
    wln(self, "        if (c >= 0) { __p_co_nonblock(c); return c; }");
    wln(self, "        if (!__P_CO_BLOCKED()) return -1;");
    wln(self, "        if (!p_co_wait_fd(fd, 0, -1)) return -1;");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "#ifdef _WIN32");
    wln(self, "void init_winsock(void);");
    wln(self, "#endif");
    wln(self, "int64_t p_co_connect(const char* host, int64_t port) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    init_winsock();");
    wln(self, "#endif");
    wln(self, "    char service[16];");
    wln(self, "    struct addrinfo hints, *res = NULL;");
    wln(self, "    memset(&hints, 0, sizeof(hints));");
    wln(self, "    hints.ai_family = AF_UNSPEC;");
    wln(self, "    hints.ai_socktype = SOCK_STREAM;");
    wln(self, "    snprintf(service, sizeof(service), \"%lld\", (long long)port);");
    wln(self, "    if (getaddrinfo(host, service, &hints, &res) != 0 || !res) return -1;");
    wln(self, "    int64_t s = -1;");
    wln(self, "    /* every address of the host, IPv6 and IPv4, in the order the system");
    wln(self, "       ranks them, until one connects */");
    wln(self, "    for (struct addrinfo* ai = res; ai && s < 0; ai = ai->ai_next) {");
    wln(self, "    s = (int64_t)socket(ai->ai_family, ai->ai_socktype, 0);");
    wln(self, "    /* Connect without blocking the thread: its other tasks (the server");
    wln(self, "       that accepts, say) run while the connection is made */");
    wln(self, "    if (s >= 0) {");
    wln(self, "        __p_co_nonblock(s);");
    wln(self, "        if (connect((SOCKET)s, ai->ai_addr, (int)ai->ai_addrlen) != 0) {");
    wln(self, "            int failed = 1;");
    wln(self, "#ifdef _WIN32");
    wln(self, "            int pending = WSAGetLastError() == WSAEWOULDBLOCK;");
    wln(self, "            int len = sizeof(int);");
    wln(self, "#else");
    wln(self, "            int pending = errno == EINPROGRESS;");
    wln(self, "            socklen_t len = sizeof(int);");
    wln(self, "#endif");
    wln(self, "            if (pending && p_co_wait_fd(s, 1, -1)) {");
    wln(self, "                int e = 0;");
    wln(self, "                if (getsockopt((SOCKET)s, SOL_SOCKET, SO_ERROR, (char*)&e, &len) == 0 && e == 0) failed = 0;");
    wln(self, "            }");
    wln(self, "            if (failed) { p_socket_close(s); s = -1; }");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    }");
    wln(self, "    freeaddrinfo(res);");
    wln(self, "    return s;");
    wln(self, "}");
    wln(self, "int64_t p_co_recv(int64_t fd, int64_t buf, int64_t len, int64_t timeout_ms) {");
    wln(self, "    for (;;) {");
    wln(self, "        int64_t n = p_socket_read(fd, (char*)(uintptr_t)buf, len);");
    wln(self, "        if (n >= 0) return n;");
    wln(self, "        if (!__P_CO_BLOCKED()) return -1;");
    wln(self, "        if (!p_co_wait_fd(fd, 0, timeout_ms)) return -2;");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "int64_t p_co_send(int64_t fd, int64_t buf, int64_t len) {");
    wln(self, "    int64_t done = 0;");
    wln(self, "    while (done < len) {");
    wln(self, "        int64_t n = p_socket_write(fd, (const char*)(uintptr_t)buf + done, len - done);");
    wln(self, "        if (n > 0) done += n;");
    wln(self, "        else if (n < 0 && !__P_CO_BLOCKED()) return -1;");
    wln(self, "        else if (!p_co_wait_fd(fd, 1, 30000)) return -1;");
    wln(self, "    }");
    wln(self, "    return done;");
    wln(self, "}");
    // F9: the call itself, apart from the thread's set-up, so that WASI
    // (no threads) runs it on the spawning thread
    wln(self, "static int64_t __p_thread_run(p_thread_arg_t* ta) {");
    wln(self, "    int64_t result = 0;");
    wln(self, "    int64_t* a = ta->args;");
    wln(self, "    // Fides functions have an implicit __env param (void*) as first arg.");
    wln(self, "    // Pass NULL for __env, then the user-provided args.");
    wln(self, "    switch (ta->nargs) {");
    wln(self, "        case 0: { typedef int64_t (*f0)(void*); f0 f = (f0)ta->fn; result = f(NULL); break; }");
    wln(self, "        case 1: { typedef int64_t (*f1)(void*,int64_t); f1 f = (f1)ta->fn; result = f(NULL, a[0]); break; }");
    wln(self, "        case 2: { typedef int64_t (*f2)(void*,int64_t,int64_t); f2 f = (f2)ta->fn; result = f(NULL, a[0], a[1]); break; }");
    wln(self, "        case 3: { typedef int64_t (*f3)(void*,int64_t,int64_t,int64_t); f3 f = (f3)ta->fn; result = f(NULL, a[0], a[1], a[2]); break; }");
    wln(self, "        case 4: { typedef int64_t (*f4)(void*,int64_t,int64_t,int64_t,int64_t); f4 f = (f4)ta->fn; result = f(NULL, a[0], a[1], a[2], a[3]); break; }");
    wln(self, "        case 5: { typedef int64_t (*f5)(void*,int64_t,int64_t,int64_t,int64_t,int64_t); f5 f = (f5)ta->fn; result = f(NULL, a[0], a[1], a[2], a[3], a[4]); break; }");
    wln(self, "        case 6: { typedef int64_t (*f6)(void*,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t); f6 f = (f6)ta->fn; result = f(NULL, a[0], a[1], a[2], a[3], a[4], a[5]); break; }");
    wln(self, "        case 7: { typedef int64_t (*f7)(void*,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t); f7 f = (f7)ta->fn; result = f(NULL, a[0], a[1], a[2], a[3], a[4], a[5], a[6]); break; }");
    wln(self, "        default: { typedef int64_t (*f8)(void*,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t); f8 f = (f8)ta->fn; result = f(NULL, a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7]); break; }");
    wln(self, "    }");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "static void* p_thread_wrapper(void* arg) {");
    wln(self, "    p_thread_arg_t* ta = (p_thread_arg_t*)arg;");
    wln(self, "    __p_thread_guard_init();");
    wln(self, "    __p_co_in_thread = 1;");
    // CI6: the capabilities of the code that started it
    wln(self, "    __p_caps = ta->caps;");
    // RL17: random mode, a thread starts after 0 or 1 ms one time in four;
    // DB9: the sampling profiler (FID_PROF) looks at this thread too
    wln(self, "    __p_rnd_point();");
    wln(self, "    __p_sp_thread_start();");
    wln(self, "    int64_t result = __p_thread_run(ta);");
    wln(self, "    if (ta->done) atomic_store(ta->done, 1);");
    wln(self, "    __p_thread_guard_done();");
    // RT7: this thread's empty chunks back to the system, the rest to the
    // threads that stay
    wln(self, "    __p_mem_thread_exit();");
    wln(self, "    return (void*)(intptr_t)result;");
    wln(self, "}");
    // Phase A1: Executor + non-blocking task poll
    // Executor: just an ID - tasks are tracked via the thread handle table.
    // BG9: the future table (thread handle, result, done flag of each
    // thread future), growable and locked; it replaces the three static
    // arrays of 256 entries (p_thread_handles, p_task_results,
    // p_task_done_flags) and the unlocked `p_thread_handle_count++`
    wln(self, "/* BG9: the future table. A thread future (spawn, an executor's task, an");
    wln(self, "   async I/O) is P_FT_FUT(idx), idx its slot. It was three static arrays of 256");
    wln(self, "   and `int idx = p_thread_handle_count++;`: the 257th spawn wrote past them");
    wln(self, "   and two threads spawning at once could take one index. Now the slots are");
    wln(self, "   in chunks of P_FT_CHUNK, allocated when first needed and never moved (a");
    wln(self, "   running thread keeps a pointer to its slot's done flag), reached through");
    wln(self, "   a fixed directory, and an index is taken under __p_ft_lk (a spin lock on");
    wln(self, "   an atomic word: nothing to initialise, the same code on Windows and");
    wln(self, "   POSIX; held only to hand out an index and allocate a chunk). A slot is");
    wln(self, "   not reused: a future can be awaited after something else joined it (the");
    wln(self, "   end of a spawn scope, run_all and cancel join every thread and keep the");
    wln(self, "   results for a later await), so its result must stay. A slot's state:");
    wln(self, "   STARTING while its thread is created, RUNNING not joined yet, JOINING one");
    wln(self, "   caller (the one whose compare-exchange took it) joins it with no lock");
    wln(self, "   held while the others wait, JOINED its result is kept. Scans (run_all,");
    wln(self, "   cancel, poll_all) start at __p_ft_lo, below which every slot is JOINED. */");
    wln(self, "#define P_FT_CHUNK 4096");
    wln(self, "#define P_FT_DIR 16384");
    wln(self, "#define P_FT_RUNNING 0");
    wln(self, "#define P_FT_JOINING 1");
    wln(self, "#define P_FT_JOINED 2");
    wln(self, "#define P_FT_STARTING 3");
    wln(self, "typedef struct { pthread_t h; int64_t result; atomic_int done; atomic_int_least64_t state; } __p_ft_slot;");
    wln(self, "static __p_ft_slot* __p_ft_dir[P_FT_DIR];");
    wln(self, "static atomic_int_least64_t __p_ft_lk;");
    wln(self, "static atomic_int_least64_t __p_ft_count;");
    wln(self, "static atomic_int_least64_t __p_ft_lo;");
    wln(self, "static void __p_ft_pause(int64_t ms) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    Sleep((DWORD)ms);");
    wln(self, "#else");
    wln(self, "    poll(NULL, 0, (int)ms);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static void __p_ft_lock(void) {");
    wln(self, "    for (;;) {");
    wln(self, "        int64_t e = 0;");
    wln(self, "        if (atomic_compare_exchange_strong(&__p_ft_lk, &e, 1)) return;");
    wln(self, "        __p_ft_pause(0);");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "static void __p_ft_unlock(void) { atomic_store(&__p_ft_lk, 0); }");
    wln(self, "/* the slot of index idx, NULL for an index never handed out */");
    wln(self, "static __p_ft_slot* __p_ft_at(int64_t idx) {");
    wln(self, "    if (idx < 0 || idx >= (int64_t)atomic_load(&__p_ft_count)) return NULL;");
    wln(self, "    return &__p_ft_dir[idx / P_FT_CHUNK][idx % P_FT_CHUNK];");
    wln(self, "}");
    wln(self, "/* a new slot, STARTING; returns its index */");
    wln(self, "static int64_t __p_ft_new(void) {");
    wln(self, "    __p_ft_lock();");
    wln(self, "    int64_t idx = (int64_t)atomic_load(&__p_ft_count);");
    wln(self, "    if (idx >= (int64_t)P_FT_CHUNK * P_FT_DIR) { __p_ft_unlock(); p_panic(\"spawn: too many threads started (the future table is full)\"); }");
    wln(self, "    __p_ft_slot* ch = __p_ft_dir[idx / P_FT_CHUNK];");
    wln(self, "    if (!ch) {");
    wln(self, "        ch = (__p_ft_slot*)calloc(P_FT_CHUNK, sizeof(__p_ft_slot));");
    wln(self, "        if (!ch) { __p_ft_unlock(); p_panic(\"spawn: out of memory\"); }");
    wln(self, "        __p_ft_dir[idx / P_FT_CHUNK] = ch;");
    wln(self, "    }");
    wln(self, "    __p_ft_slot* s = &ch[idx % P_FT_CHUNK];");
    wln(self, "    s->result = 0;");
    wln(self, "    atomic_init(&s->done, 0);");
    wln(self, "    atomic_init(&s->state, P_FT_STARTING);");
    // the count is stored last: a reader that sees idx below it sees the
    // chunk pointer and the slot's fields
    wln(self, "    atomic_store(&__p_ft_count, idx + 1);");
    wln(self, "    __p_ft_unlock();");
    wln(self, "    return idx;");
    wln(self, "}");
    wln(self, "/* its thread was created */");
    wln(self, "static void __p_ft_started(__p_ft_slot* s, pthread_t h) {");
    wln(self, "    s->h = h;");
    wln(self, "    atomic_store(&s->state, P_FT_RUNNING);");
    wln(self, "}");
    wln(self, "/* it ran to its end when spawned (WASI: no threads) */");
    wln(self, "static void __p_ft_ran(__p_ft_slot* s, int64_t result) {");
    wln(self, "    s->result = result;");
    wln(self, "    atomic_store(&s->done, 1);");
    wln(self, "    atomic_store(&s->state, P_FT_JOINED);");
    wln(self, "}");
    wln(self, "/* Joins s's thread once, whoever asks first, and keeps its result; a");
    wln(self, "   caller that comes while another joins it waits for the result. drop: an");
    wln(self, "   unfinished thread's result is 0 (cancel), and *dropped says so. */");
    wln(self, "static int64_t __p_ft_join(__p_ft_slot* s, int drop, int* dropped) {");
    wln(self, "    for (;;) {");
    wln(self, "        int64_t st = (int64_t)atomic_load(&s->state);");
    wln(self, "        if (st == P_FT_JOINED) return s->result;");
    wln(self, "        if (st == P_FT_RUNNING) {");
    wln(self, "            int64_t e = P_FT_RUNNING;");
    wln(self, "            if (atomic_compare_exchange_strong(&s->state, &e, P_FT_JOINING)) {");
    wln(self, "                int was_done = atomic_load(&s->done) != 0;");
    wln(self, "                void* ret = NULL;");
    wln(self, "                pthread_join(s->h, &ret);");
    wln(self, "                s->result = (drop && !was_done) ? 0 : (int64_t)(intptr_t)ret;");
    wln(self, "                if (dropped) *dropped = drop && !was_done;");
    wln(self, "                atomic_store(&s->state, P_FT_JOINED);");
    wln(self, "                return s->result;");
    wln(self, "            }");
    wln(self, "            continue;");
    wln(self, "        }");
    wln(self, "        /* JOINING (another caller joins it) or STARTING (its spawn has not");
    wln(self, "           returned yet, on another thread) */");
    wln(self, "        __p_ft_pause(1);");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "static int64_t __p_ft_poll(int64_t future) {");
    wln(self, "    __p_ft_slot* s = __p_ft_at(P_FT_IDX(future));");
    wln(self, "    if (!s) return 0;");
    wln(self, "    return __p_ft_join(s, 0, NULL);");
    wln(self, "}");
    // BG45: `spawn detached` of a thread (p_co_detach of its future): the
    // thread is let go (pthread_detach; on Windows its handle closed, the
    // small record the thread writes its result to kept) and the slot reads
    // as joined with result 0, so no scan waits for it. One that someone
    // already joins or joined is left to them.
    wln(self, "static void __p_ft_detach(int64_t future) {");
    wln(self, "    __p_ft_slot* s = __p_ft_at(P_FT_IDX(future));");
    wln(self, "    if (!s) return;");
    wln(self, "    int64_t e = P_FT_RUNNING;");
    wln(self, "    if (!atomic_compare_exchange_strong(&s->state, &e, P_FT_JOINING)) return;");
    wln(self, "#if defined(_WIN32)");
    wln(self, "    CloseHandle(s->h->h);");
    wln(self, "#elif !defined(__wasi__)");
    wln(self, "    pthread_detach(s->h);");
    wln(self, "#endif");
    wln(self, "    s->result = 0;");
    wln(self, "    atomic_store(&s->state, P_FT_JOINED);");
    wln(self, "}");
    wln(self, "/* One pass over the slots not known to be joined. mode 0 (run_all): join");
    wln(self, "   each, returns how many were not joined yet; 1 (cancel): the same, an");
    wln(self, "   unfinished thread's result dropped, returns how many were unfinished;");
    wln(self, "   2 (poll_all): join the finished ones, returns how many are not. A slot");
    wln(self, "   still STARTING belongs to a spawn running on another thread: left.");
    wln(self, "   BG45: only the slots from `from` on (an executor's first slot: the");
    wln(self, "   threads started since its scope began); a thread started before, which");
    wln(self, "   nothing in the scope waits for, is left running. */");
    wln(self, "static int64_t __p_ft_scan(int mode, int64_t from) {");
    wln(self, "    int64_t n = (int64_t)atomic_load(&__p_ft_count);");
    wln(self, "    int64_t glo = (int64_t)atomic_load(&__p_ft_lo);");
    wln(self, "    int64_t lo = from > glo ? from : glo;");
    wln(self, "    int64_t count = 0;");
    wln(self, "    int64_t first_open = -1;");
    wln(self, "    for (int64_t i = lo; i < n; i++) {");
    wln(self, "        __p_ft_slot* s = &__p_ft_dir[i / P_FT_CHUNK][i % P_FT_CHUNK];");
    wln(self, "        int64_t st = (int64_t)atomic_load(&s->state);");
    wln(self, "        if (st == P_FT_JOINED) continue;");
    wln(self, "        if (st == P_FT_STARTING) { if (first_open < 0) first_open = i; continue; }");
    wln(self, "        if (mode == 2 && atomic_load(&s->done) == 0) { count++; if (first_open < 0) first_open = i; continue; }");
    wln(self, "        int dropped = 0;");
    wln(self, "        __p_ft_join(s, mode == 1, &dropped);");
    wln(self, "        if (mode == 0 || (mode == 1 && dropped)) count++;");
    wln(self, "    }");
    // every slot below first_open (or n) is JOINED for good (slots are not
    // reused): later scans skip them
    // (BG45: only a scan that started at __p_ft_lo saw every slot below nlo)
    wln(self, "    int64_t nlo = first_open < 0 ? n : first_open;");
    wln(self, "    if (lo == glo) {");
    wln(self, "        __p_ft_lock();");
    wln(self, "        if (nlo > (int64_t)atomic_load(&__p_ft_lo)) atomic_store(&__p_ft_lo, nlo);");
    wln(self, "        __p_ft_unlock();");
    wln(self, "    }");
    wln(self, "    return count;");
    wln(self, "}");
    // BG45: an executor (a spawn scope, async.fd's Executor) is the index of
    // the first future-table slot after it: its run_all/cancel/poll_all
    // reach the threads started from then on, not every thread of the
    // program (a scope waited for a thread started before it, which may
    // never end)
    wln(self, "int64_t p_executor_new(void) { return (int64_t)atomic_load(&__p_ft_count); }");
    wln(self, "int64_t p_executor_spawn(int64_t exec, const char* func_name, int64_t num_args, ...) {");
    wln(self, "    (void)exec;");
    wln(self, "    int64_t (*fn)() = NULL;");
    wln(self, "    for (int i = 0; i < p_thread_entry_count; i++) {");
    wln(self, "        if (strcmp(p_thread_entries[i].name, func_name) == 0) { fn = p_thread_entries[i].fn; break; }");
    wln(self, "    }");
    wln(self, "    if (!fn) return -1;");
    // BG133: a 9th argument was dropped (the function read garbage)
    wln(self, "    if (num_args > 8) p_panic(\"spawn: a function started by name takes at most 8 arguments\");");
    wln(self, "    p_thread_arg_t* ta = (p_thread_arg_t*)malloc(sizeof(p_thread_arg_t));");
    wln(self, "    ta->fn = fn; ta->nargs = num_args; ta->caps = __p_caps;");
    wln(self, "    va_list ap; va_start(ap, num_args);");
    wln(self, "    for (int64_t i = 0; i < num_args && i < 8; i++) ta->args[i] = va_arg(ap, int64_t);");
    wln(self, "    va_end(ap);");
    // BG9: a slot of the future table, taken under its lock
    wln(self, "    int64_t idx = __p_ft_new();");
    wln(self, "    __p_ft_slot* fs = __p_ft_at(idx);");
    wln(self, "    ta->done = &fs->done;");
    wln(self, "#ifdef __wasi__");
    wln(self, "    /* no threads under WASI: runs to its end now, as under fid wasm */");
    wln(self, "    __p_ft_ran(fs, __p_thread_run(ta));");
    wln(self, "#else");
    wln(self, "    pthread_t tid;");
    wln(self, "    if (pthread_create(&tid, NULL, p_thread_wrapper, ta) != 0) p_panic(\"could not start a thread\");");
    wln(self, "    __p_ft_started(fs, tid);");
    wln(self, "#endif");
    wln(self, "    return P_FT_FUT(idx);");
    wln(self, "}");
    wln(self, "int64_t p_task_poll(int64_t future) {");
    wln(self, "    if (((uint64_t)future >> 48) == 0x7FA5) return p_future_poll(future);");
    wln(self, "    if (!P_FT_IS(future)) return future; // eager future (BG73)");
    wln(self, "    // A1: block until done (join); BG9: the future table");
    wln(self, "    return __p_ft_poll(future);");
    wln(self, "}");
    wln(self, "bool p_task_is_ready(int64_t future) {");
    wln(self, "    if (((uint64_t)future >> 48) == 0x7FA5) return p_co_done(future & 0xFFFFFFFFFFFFLL) != 0;");
    wln(self, "    if (!P_FT_IS(future)) return true;");
    wln(self, "    __p_ft_slot* s = __p_ft_at(P_FT_IDX(future));");
    wln(self, "    if (!s) return false;");
    wln(self, "    return atomic_load(&s->done) != 0;");
    wln(self, "}");
    wln(self, "int64_t p_executor_block_on(int64_t exec, int64_t future) {");
    wln(self, "    (void)exec;");
    wln(self, "    return p_future_poll(future);");
    wln(self, "}");
    // Cancel the tasks of a scope: a task cannot be stopped mid-way, so
    // wait for any still running (no task outlives its scope), drop their
    // results (0, as in the interpreter), and return how many were cancelled.
    wln(self, "int64_t p_executor_cancel(int64_t exec) {");
    // BG9: __p_ft_scan joins each slot once (its compare-exchange) and
    // starts past the slots already joined; BG45: and at the executor's first
    wln(self, "    return __p_ft_scan(1, exec);");
    wln(self, "}");
    wln(self, "int64_t p_executor_run_all(int64_t exec) {");
    wln(self, "    return __p_ft_scan(0, exec);");
    wln(self, "}");
    // A2: Non-blocking poll - returns PENDING_SENTINEL if task not done
    wln(self, "int64_t p_task_poll_nonblocking(int64_t future) {");
    wln(self, "    if (((uint64_t)future >> 48) == 0x7FA5) return p_co_done(future & 0xFFFFFFFFFFFFLL) ? p_future_poll(future) : (int64_t)0x8000000000000001LL;");
    wln(self, "    if (!P_FT_IS(future)) return future; // eager future (BG73)");
    wln(self, "    __p_ft_slot* s = __p_ft_at(P_FT_IDX(future));");
    wln(self, "    if (!s) return 0;");
    wln(self, "    if (atomic_load(&s->done) == 0) {");
    wln(self, "        return (int64_t)0x8000000000000001LL; // PENDING_SENTINEL");
    wln(self, "    }");
    wln(self, "    return __p_ft_join(s, 0, NULL); // BG9: joined once, result kept");
    wln(self, "}");
    // A2: Non-blocking poll all - returns count of still-pending tasks
    wln(self, "int64_t p_executor_poll_all(int64_t exec) {");
    wln(self, "    return __p_ft_scan(2, exec);");
    wln(self, "}");
    // --- Phase A3: Non-blocking IO (using threads for async) ---
    // Each async IO operation spawns a thread that performs the IO
    // and stores the result. The returned Future handle can be polled.
    wln(self, "#ifndef _WIN32");
    wln(self, "#include <sys/socket.h>");
    wln(self, "#include <netinet/in.h>");
    wln(self, "#include <arpa/inet.h>");
    wln(self, "#include <unistd.h>");
    wln(self, "#include <fcntl.h>");
    wln(self, "#include <time.h>");
    wln(self, "#endif");
    // Thread arg for async IO
    wln(self, "typedef struct { int64_t sock; char* buf; int64_t len; int64_t result; atomic_int* done; int op; uint64_t caps; } p_io_arg_t;");
    wln(self, "// op: 0=connect, 1=read, 2=write, 3=fs_read");
    wln(self, "static void* p_io_worker(void* arg) {");
    wln(self, "    p_io_arg_t* ia = (p_io_arg_t*)arg;");
    wln(self, "    int64_t result = 0;");
    // CI6: the I/O runs with the capabilities of the code that asked for it
    wln(self, "    __p_caps = ia->caps;");
    wln(self, "    if ((ia->op == 3 && P_CAP_DENIED(P_CAP_FS)) || ((ia->op == 1 || ia->op == 2) && P_CAP_DENIED(P_CAP_NET))) {");
    wln(self, "        ia->result = -1;");
    wln(self, "        if (ia->done) atomic_store(ia->done, 1);");
    wln(self, "        return (void*)(intptr_t)-1;");
    wln(self, "    }");
    wln(self, "    switch (ia->op) {");
    wln(self, "        case 1: { // read");
    wln(self, "            ssize_t n = recv((int)ia->sock, ia->buf, (size_t)ia->len, 0);");
    wln(self, "            result = (n < 0) ? -1 : (int64_t)n;");
    wln(self, "            break;");
    wln(self, "        }");
    wln(self, "        case 2: { // write");
    // BG39: as p_socket_write, a peer that has gone gives -1, not SIGPIPE
    wln(self, "#ifdef MSG_NOSIGNAL");
    wln(self, "            ssize_t n = send((int)ia->sock, ia->buf, (size_t)ia->len, MSG_NOSIGNAL);");
    wln(self, "#else");
    wln(self, "            ssize_t n = send((int)ia->sock, ia->buf, (size_t)ia->len, 0);");
    wln(self, "#endif");
    wln(self, "            result = (n < 0) ? -1 : (int64_t)n;");
    wln(self, "            break;");
    wln(self, "        }");
    wln(self, "        case 3: { // fs_read");
    wln(self, "            FILE* f = fopen((const char*)ia->sock, \"rb\");");
    wln(self, "            if (f) {");
    wln(self, "                size_t n = fread(ia->buf, 1, (size_t)ia->len, f);");
    wln(self, "                result = (int64_t)n;");
    wln(self, "                fclose(f);");
    wln(self, "            } else { result = -1; }");
    wln(self, "            break;");
    wln(self, "        }");
    wln(self, "        default: result = 0;");
    wln(self, "    }");
    wln(self, "    ia->result = result;");
    wln(self, "    if (ia->done) atomic_store(ia->done, 1);");
    wln(self, "    return (void*)(intptr_t)result;");
    wln(self, "}");
    wln(self, "// Helper: spawn an IO thread and return a Future handle");
    wln(self, "static int64_t p_io_spawn(int op, int64_t sock, char* buf, int64_t len) {");
    // BG9: a slot of the future table (its result is set when joined)
    wln(self, "    int64_t idx = __p_ft_new();");
    wln(self, "    __p_ft_slot* fs = __p_ft_at(idx);");
    wln(self, "    p_io_arg_t* ia = (p_io_arg_t*)malloc(sizeof(p_io_arg_t));");
    wln(self, "    ia->sock = sock; ia->buf = buf; ia->len = len; ia->result = 0;");
    wln(self, "    ia->done = &fs->done; ia->op = op; ia->caps = __p_caps;");
    wln(self, "    pthread_t tid;");
    wln(self, "    if (pthread_create(&tid, NULL, p_io_worker, ia) != 0) p_panic(\"could not start a thread\");");
    wln(self, "    __p_ft_started(fs, tid);");
    wln(self, "    return P_FT_FUT(idx);");
    wln(self, "}");
    wln(self, "int64_t p_net_connect(const char* host, int64_t port) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_NET)) return -1;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    { WSADATA d; static int ws = 0; if (!ws) { WSAStartup(MAKEWORD(2,2), &d); ws = 1; } }");
    wln(self, "#endif");
    wln(self, "    /* An IPv4 or IPv6 address, or a name: each of its addresses in turn */");
    wln(self, "    struct addrinfo hints = {0}, *res = NULL;");
    wln(self, "    hints.ai_family = AF_UNSPEC; hints.ai_socktype = SOCK_STREAM;");
    wln(self, "    char portbuf[16]; snprintf(portbuf, sizeof(portbuf), \"%lld\", (long long)port);");
    wln(self, "    if (getaddrinfo(host, portbuf, &hints, &res) != 0 || !res) return -1;");
    wln(self, "    int64_t sock = -1;");
    // C7: the connect does not block the thread: it is made non-blocking
    // and waited for with p_co_wait_fd, which a timeout block's token stops
    // (the slot's token), then the socket is blocking again for its reads
    // and writes. Without a token the wait is the system's connect limit.
    wln(self, "    for (struct addrinfo* ai = res; ai && sock < 0; ai = ai->ai_next) {");
    wln(self, "        sock = (int64_t)socket(ai->ai_family, ai->ai_socktype, 0);");
    wln(self, "        if (sock < 0) { sock = -1; continue; }");
    wln(self, "        __p_co_nonblock(sock);");
    wln(self, "        int ok = connect((SOCKET)sock, ai->ai_addr, (int)ai->ai_addrlen) == 0;");
    wln(self, "        if (!ok) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "            int pending = WSAGetLastError() == WSAEWOULDBLOCK;");
    wln(self, "            int elen = sizeof(int);");
    wln(self, "#else");
    wln(self, "            int pending = errno == EINPROGRESS;");
    wln(self, "            socklen_t elen = sizeof(int);");
    wln(self, "#endif");
    wln(self, "            if (pending && p_co_wait_fd(sock, 1, -1)) {");
    wln(self, "                int e = 0;");
    wln(self, "                if (getsockopt((SOCKET)sock, SOL_SOCKET, SO_ERROR, (char*)&e, &elen) == 0 && e == 0) ok = 1;");
    wln(self, "            }");
    wln(self, "        }");
    wln(self, "        if (!ok) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "            closesocket((SOCKET)sock);");
    wln(self, "#else");
    wln(self, "            close((int)sock);");
    wln(self, "#endif");
    wln(self, "            sock = -1;");
    wln(self, "            continue;");
    wln(self, "        }");
    wln(self, "#ifdef _WIN32");
    wln(self, "        { u_long off = 0; ioctlsocket((SOCKET)sock, FIONBIO, &off); }");
    wln(self, "#else");
    wln(self, "        fcntl((int)sock, F_SETFL, fcntl((int)sock, F_GETFL, 0) & ~O_NONBLOCK);");
    wln(self, "#endif");
    wln(self, "    }");
    wln(self, "    freeaddrinfo(res);");
    wln(self, "    if (sock < 0) return -1;");
    wln(self, "    // Return the socket FD as an eager future (positive = ready)");
    wln(self, "    return (int64_t)sock;");
    wln(self, "}");
    wln(self, "int64_t p_net_read(int64_t sock, char* buf, int64_t len) {");
    wln(self, "    return p_io_spawn(1, sock, buf, len);");
    wln(self, "}");
    wln(self, "int64_t p_net_write(int64_t sock, const char* buf, int64_t len) {");
    wln(self, "    return p_io_spawn(2, sock, (char*)buf, len);");
    wln(self, "}");
    wln(self, "void p_net_close(int64_t sock) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    closesocket((SOCKET)sock);");
    wln(self, "#else");
    wln(self, "    close((int)sock);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_fs_read_async(const char* path, char* buf, int64_t len) {");
    wln(self, "    // Use sock field to pass the path pointer (op=3 reads it as path)");
    wln(self, "    return p_io_spawn(3, (int64_t)(intptr_t)path, buf, len);");
    wln(self, "}");
    wln(self, "int64_t p_thread_spawn(const char* func_name, int64_t num_args, ...) {");
    // LG11: "__p_co_stack" names no function: it is p_co_stack(bytes) by
    // name, so code built by an older compiler (fid's own interpreter,
    // built by the previous fid) can ask for deep task stacks without a
    // link error; an older runtime answers -1 (no such function)
    wln(self, "    if (strcmp(func_name, \"__p_co_workers\") == 0) {");
    wln(self, "        va_list wap; va_start(wap, num_args);");
    wln(self, "        int64_t wn = num_args > 0 ? va_arg(wap, int64_t) : 0;");
    wln(self, "        va_end(wap);");
    wln(self, "        return p_co_workers(wn);");
    wln(self, "    }");
    wln(self, "    if (strcmp(func_name, \"__p_co_stack\") == 0) {");
    wln(self, "        va_list sap; va_start(sap, num_args);");
    wln(self, "        int64_t bytes = num_args > 0 ? va_arg(sap, int64_t) : 0;");
    wln(self, "        va_end(sap);");
    wln(self, "        return p_co_stack(bytes);");
    wln(self, "    }");
    wln(self, "    // Look up function by name");
    wln(self, "    int64_t (*fn)() = NULL;");
    wln(self, "    for (int i = 0; i < p_thread_entry_count; i++) {");
    wln(self, "        if (strcmp(p_thread_entries[i].name, func_name) == 0) {");
    wln(self, "            fn = p_thread_entries[i].fn;");
    wln(self, "            break;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    if (!fn) return -1;");
    // BG133: a 9th argument was dropped (the function read garbage)
    wln(self, "    if (num_args > 8) p_panic(\"spawn: a function started by name takes at most 8 arguments\");");
    wln(self, "    p_thread_arg_t* ta = (p_thread_arg_t*)malloc(sizeof(p_thread_arg_t));");
    wln(self, "    ta->fn = fn;");
    wln(self, "    ta->caps = __p_caps;");
    wln(self, "    ta->nargs = num_args;");
    wln(self, "    va_list ap; va_start(ap, num_args);");
    wln(self, "    for (int64_t i = 0; i < num_args && i < 8; i++) ta->args[i] = va_arg(ap, int64_t);");
    wln(self, "    va_end(ap);");
    // BG9: a slot of the future table, taken under its lock (was
    // `p_thread_handle_count++` into arrays of 256)
    wln(self, "    int64_t idx = __p_ft_new();");
    wln(self, "    __p_ft_slot* fs = __p_ft_at(idx);");
    wln(self, "    ta->done = &fs->done;");
    wln(self, "#ifdef __wasi__");
    wln(self, "    /* no threads under WASI: runs to its end now, as under fid wasm */");
    wln(self, "    __p_ft_ran(fs, __p_thread_run(ta));");
    wln(self, "#else");
    wln(self, "    pthread_t tid;");
    wln(self, "    if (pthread_create(&tid, NULL, p_thread_wrapper, ta) != 0) p_panic(\"could not start a thread\");");
    wln(self, "    // Store thread handle and return negative index as Future");
    wln(self, "    __p_ft_started(fs, tid);");
    wln(self, "#endif");
    wln(self, "    return P_FT_FUT(idx);");
    wln(self, "}");
    // p_thread_join — join a thread spawned by p_thread_spawn
    // handle is the negative value returned by p_thread_spawn: -(idx+1)
    wln(self, "void p_thread_join(int64_t handle) {");
    wln(self, "    if (!P_FT_IS(handle)) return; // not a thread handle (BG73)");
    // F9: a task already joined, or one WASI ran when it was spawned, is
    // JOINED. BG9: the join keeps the result (an await after it reads it;
    // it used to join the thread a second time)
    wln(self, "    __p_ft_slot* s = __p_ft_at(P_FT_IDX(handle));");
    wln(self, "    if (!s) return;");
    wln(self, "    __p_ft_join(s, 0, NULL);");
    wln(self, "}");
    // Shared memory - simple malloc-based, atomics use C11 stdatomic
    wln(self, "int64_t p_shared_alloc(int64_t size) { if (size < 0) return 0; uint64_t* b = (uint64_t*)calloc(1, (size_t)size + 24); if (!b) { p_panic(\"p_shared_alloc: out of memory\"); } b += 2; b[0] = P_BLOCK_MAGIC | P_CLASS_LARGE; return (int64_t)(intptr_t)(b + 1); }");
    // RL17: each atomic is a random interleaving point (__p_rnd_point)
    wln(self, "int64_t p_atomic_load(int64_t addr) { __p_rnd_point(); return atomic_load((atomic_int_least64_t*)(intptr_t)addr); }");
    wln(self, "void p_atomic_store(int64_t addr, int64_t val) { __p_rnd_point(); atomic_store((atomic_int_least64_t*)(intptr_t)addr, val); }");
    wln(self, "bool p_atomic_cas(int64_t addr, int64_t expected, int64_t new_val) {");
    wln(self, "    __p_rnd_point();");
    wln(self, "    return atomic_compare_exchange_strong((atomic_int_least64_t*)(intptr_t)addr, &expected, new_val);");
    wln(self, "}");
    wln(self, "int64_t p_atomic_add(int64_t addr, int64_t val) { __p_rnd_point(); return atomic_fetch_add((atomic_int_least64_t*)(intptr_t)addr, val); }");
    wln(self, "int64_t p_atomic_sub(int64_t addr, int64_t val) { __p_rnd_point(); return atomic_fetch_sub((atomic_int_least64_t*)(intptr_t)addr, val); }");
    wln(self, "int64_t p_rc_incr(int64_t rc_addr, int64_t val) { (*(int64_t*)(intptr_t)rc_addr)++; return val; }");
    wln(self, "void p_rc_decr(int64_t rc_addr, int64_t val) {");
    wln(self, "    (void)val;");
    wln(self, "    int64_t* rc = (int64_t*)(intptr_t)rc_addr;");
    wln(self, "    (*rc)--;");
    wln(self, "    if (*rc <= 0) { free((void*)(intptr_t)rc_addr); }");
    wln(self, "}");
    // BG148: a mutex green tasks share (was a bare pthread mutex: two tasks
    // of one thread both entered a Windows CRITICAL_SECTION, which is
    // recursive, and the second deadlocked a Linux one)
    wln(self, "/* BG148: a pthread mutex belongs to a thread, not to a task: two tasks of");
    wln(self, "   one thread both entered a Windows CRITICAL_SECTION (recursive), the");
    wln(self, "   second deadlocked a Linux mutex, and under M:N a task could unlock it");
    wln(self, "   from another worker. So the lock is a flag kept under a short internal");
    wln(self, "   mutex, with its holder (owner: the task, or the thread off a task). A");
    wln(self, "   task that finds it held gives its turn (yields, then 1 ms naps) until it");
    wln(self, "   is free; code off a task runs this thread's tasks meanwhile");
    wln(self, "   (__p_chan_coop_wait) or sleeps on the condition variable, which an");
    wln(self, "   unlock wakes. Any holder may unlock it (sync.fd's read lock is released");
    wln(self, "   by the last reader). */");
    wln(self, "typedef struct { pthread_mutex_t mx; pthread_cond_t cv; void* owner; int held; int tw; } __p_mutex_t;");
    wln(self, "static int __p_chan_coop_wait(pthread_mutex_t* mx, int64_t* spins);");
    wln(self, "static P_MN_NOINLINE void* __p_mutex_me(void) { void* c = (void*)__p_co_cur; return c ? c : (void*)&__p_co_cur; }");
    wln(self, "int64_t p_mutex_init(void) {");
    wln(self, "    __p_mutex_t* m = (__p_mutex_t*)calloc(1, sizeof(__p_mutex_t));");
    wln(self, "    if (!m) p_panic(\"p_mutex_init: out of memory\");");
    wln(self, "    pthread_mutex_init(&m->mx, NULL);");
    wln(self, "    pthread_cond_init(&m->cv, NULL);");
    wln(self, "    return (int64_t)(intptr_t)m;");
    wln(self, "}");
    // RL17: a random point before the lock; none while one is held
    wln(self, "void p_mutex_lock(int64_t h) {");
    wln(self, "    __p_mutex_t* m = (__p_mutex_t*)(intptr_t)h;");
    wln(self, "    __p_rnd_point();");
    wln(self, "    pthread_mutex_lock(&m->mx);");
    wln(self, "    int64_t spins = 0;");
    wln(self, "    while (m->held) {");
    wln(self, "#ifdef P_MN");
    wln(self, "        if (__p_mn_on() && __p_co_self()) {");
    wln(self, "            pthread_mutex_unlock(&m->mx);");
    wln(self, "            if (spins < 64) { spins++; p_co_yield(); } else __p_co_nap(1);");
    wln(self, "            pthread_mutex_lock(&m->mx);");
    wln(self, "            continue;");
    wln(self, "        }");
    wln(self, "#endif");
    wln(self, "        if (__p_chan_coop_wait(&m->mx, &spins)) continue;");
    wln(self, "        m->tw++;");
    wln(self, "        pthread_cond_wait(&m->cv, &m->mx);");
    wln(self, "        m->tw--;");
    wln(self, "    }");
    wln(self, "    m->held = 1;");
    wln(self, "    m->owner = __p_mutex_me();");
    wln(self, "    pthread_mutex_unlock(&m->mx);");
    wln(self, "    __p_rnd_held++;");
    wln(self, "}");
    wln(self, "void p_mutex_unlock(int64_t h) {");
    wln(self, "    __p_mutex_t* m = (__p_mutex_t*)(intptr_t)h;");
    wln(self, "    if (__p_rnd_held > 0) __p_rnd_held--;");
    wln(self, "    pthread_mutex_lock(&m->mx);");
    wln(self, "    m->held = 0;");
    wln(self, "    m->owner = NULL;");
    wln(self, "    if (m->tw > 0) pthread_cond_broadcast(&m->cv);");
    wln(self, "    pthread_mutex_unlock(&m->mx);");
    wln(self, "}");
    // --- Thread-local storage (pthread keys) ---
    wln(self, "int64_t p_tls_create(void) { pthread_key_t key; pthread_key_create(&key, NULL); return (int64_t)key; }");
    wln(self, "int64_t p_tls_get(int64_t key) { return (int64_t)(intptr_t)pthread_getspecific((pthread_key_t)key); }");
    wln(self, "void p_tls_set(int64_t key, int64_t value) { pthread_setspecific((pthread_key_t)key, (void*)(intptr_t)value); }");
    // --- Channels (bounded MPSC queue with mutex + condvar) ---
    // Channel layout: { mutex, cond_not_empty, cond_not_full, head, tail, count, capacity, closed, buffer[capacity] }
    // head = next read index, tail = next write index, count = current items
    // (pthread types already defined above)
    wln(self, "typedef struct {");
    wln(self, "    pthread_mutex_t mutex;");
    wln(self, "    pthread_cond_t not_empty;");
    wln(self, "    pthread_cond_t not_full;");
    wln(self, "    int64_t head;");
    wln(self, "    int64_t tail;");
    wln(self, "    int64_t count;");
    wln(self, "    int64_t capacity;");
    wln(self, "    int closed;");
    wln(self, "    /* RT10 (M:N): the tasks parked to receive and to send, in order */");
    wln(self, "    struct __p_co* tr_head; struct __p_co* tr_tail; struct __p_co* ts_head; struct __p_co* ts_tail;");
    wln(self, "    int64_t buffer[]; // flexible array member");
    wln(self, "} p_channel_t;");
    wln(self, "// PENDING_SENTINEL - returned by p_chan_try_recv when channel is empty");
    wln(self, "#define P_CHAN_PENDING ((int64_t)0x8000000000000001LL)");
    wln(self, "#ifdef P_MN");
    wln(self, "/* RT10: wake the first task parked to send (send) or receive, or all of");
    wln(self, "   them (the channel's mutex held) */");
    wln(self, "static void __p_chan_wake(p_channel_t* ch, int send, int all) {");
    wln(self, "    for (;;) {");
    wln(self, "        __p_co** h = send ? &ch->ts_head : &ch->tr_head;");
    wln(self, "        __p_co** t = send ? &ch->ts_tail : &ch->tr_tail;");
    wln(self, "        __p_co* c = *h;");
    wln(self, "        if (!c) return;");
    wln(self, "        *h = c->qnext;");
    wln(self, "        if (!*h) *t = NULL;");
    wln(self, "        c->qnext = NULL;");
    wln(self, "        __p_mn_ready(c, 0);");
    wln(self, "        if (!all) return;");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "/* A task that left to wait on a channel: parked on it, unless what it");
    wln(self, "   waits for came meanwhile */");
    wln(self, "static void __p_chan_settle(__p_co* c) {");
    wln(self, "    p_channel_t* ch = (p_channel_t*)c->lvobj;");
    wln(self, "    pthread_mutex_lock(&ch->mutex);");
    wln(self, "    int ok = ch->closed || (c->lvarg ? ch->count < ch->capacity : ch->count > 0);");
    wln(self, "    if (!ok) {");
    wln(self, "        c->qnext = NULL;");
    wln(self, "        if (c->lvarg) { if (ch->ts_tail) ch->ts_tail->qnext = c; else ch->ts_head = c; ch->ts_tail = c; }");
    wln(self, "        else { if (ch->tr_tail) ch->tr_tail->qnext = c; else ch->tr_head = c; ch->tr_tail = c; }");
    wln(self, "        pthread_mutex_unlock(&ch->mutex);");
    wln(self, "        return;");
    wln(self, "    }");
    wln(self, "    pthread_mutex_unlock(&ch->mutex);");
    wln(self, "    __p_mn_ready(c, 1);");
    wln(self, "}");
    wln(self, "#endif");
    // BG8: with one scheduler per thread (M:N off) a blocked send/receive
    // must let this thread's other tasks run, or the task that would wake it
    // never does
    wln(self, "/* BG8: one cooperative scheduler per thread (M:N off: FIDES_WORKERS=1,");
    wln(self, "   FIDES_SCHED_RANDOM, one CPU, no P_MN). A send or receive that must wait");
    wln(self, "   cannot sleep on the channel's condition variable when the task that");
    wln(self, "   would wake it runs on this same thread: nothing would ever run it. So,");
    wln(self, "   with the channel's mutex mx held and the condition false: in a task,");
    wln(self, "   give the turn to the scheduler (mx unlocked meanwhile: no other task");
    wln(self, "   of the thread may block on it), first as a plain yield and, after 64");
    wln(self, "   turns with no progress (the other side is another OS thread), as 1 ms");
    wln(self, "   naps so the thread does not spin; off a task (main, a thread's");
    wln(self, "   function) with tasks of this thread unfinished, run a pass of them and");
    wln(self, "   wait 1 ms at most for one that can run. mx is held again on return and");
    wln(self, "   the caller tests its condition anew. 0: nothing was done, the caller");
    wln(self, "   waits on the condition variable as before (no task on this thread,");
    wln(self, "   M:N on: __p_mn_chan_park took the task's wait, or P_NO_CTX where a");
    wln(self, "   task cannot switch out). */");
    wln(self, "static int __p_chan_coop_wait(pthread_mutex_t* mx, int64_t* spins) {");
    wln(self, "#ifdef P_NO_CTX");
    wln(self, "    (void)mx; (void)spins;");
    wln(self, "    return 0;");
    wln(self, "#else");
    wln(self, "    if (__p_mn_on()) return 0;");
    wln(self, "    if (__p_co_cur) {");
    wln(self, "        pthread_mutex_unlock(mx);");
    wln(self, "        if (*spins < 64) { (*spins)++; __p_co_leave(); }");
    wln(self, "        else __p_co_nap(1);");
    wln(self, "        pthread_mutex_lock(mx);");
    wln(self, "        return 1;");
    wln(self, "    }");
    wln(self, "    if (__p_co_count + __p_th_n + __p_co_pk_n == 0) return 0;");
    wln(self, "    pthread_mutex_unlock(mx);");
    wln(self, "    int64_t ran = 0;");
    wln(self, "    if (__p_co_round(&ran) > 0) __p_co_wait(ran, 1);");
    wln(self, "    pthread_mutex_lock(mx);");
    wln(self, "    return 1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_chan_create(int64_t capacity) {");
    wln(self, "    if (capacity < 1) capacity = 1;");
    wln(self, "    p_channel_t* ch = (p_channel_t*)malloc(sizeof(p_channel_t) + capacity * sizeof(int64_t));");
    wln(self, "    pthread_mutex_init(&ch->mutex, NULL);");
    wln(self, "    pthread_cond_init(&ch->not_empty, NULL);");
    wln(self, "    pthread_cond_init(&ch->not_full, NULL);");
    wln(self, "    ch->head = 0; ch->tail = 0; ch->count = 0;");
    wln(self, "    ch->capacity = capacity;");
    wln(self, "    ch->closed = 0;");
    wln(self, "    ch->tr_head = NULL; ch->tr_tail = NULL; ch->ts_head = NULL; ch->ts_tail = NULL;");
    wln(self, "    return (int64_t)(intptr_t)ch;");
    wln(self, "}");
    wln(self, "bool p_chan_send(int64_t handle, int64_t val) {");
    wln(self, "    p_channel_t* ch = (p_channel_t*)(intptr_t)handle;");
    wln(self, "    if (!ch) return false;");
    wln(self, "    __p_rnd_point();");
    // CA7: with a token in the slot, wait in slices (other tasks run) and
    // give up (false, as on a closed channel) once it is cancelled
    wln(self, "    int64_t tok = p_task_token();");
    wln(self, "    for (;;) {");
    wln(self, "        pthread_mutex_lock(&ch->mutex);");
    wln(self, "        if (!tok || ch->count < ch->capacity || ch->closed) break;");
    wln(self, "        pthread_mutex_unlock(&ch->mutex);");
    wln(self, "        if (__p_tok_cancelled(tok)) return false;");
    wln(self, "        __p_co_nap(1);");
    wln(self, "    }");
    wln(self, "    // Block until there's space or the channel is closed");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (__p_mn_on()) {");
    wln(self, "        while (ch->count == ch->capacity && !ch->closed && __p_mn_chan_park(ch, &ch->mutex, 1)) {}");
    wln(self, "    }");
    wln(self, "#endif");
    // BG8: a task (or main with tasks) on one worker gives its turn instead
    wln(self, "    int64_t __cw_spins = 0;");
    wln(self, "    while (ch->count == ch->capacity && !ch->closed) {");
    wln(self, "        if (__p_chan_coop_wait(&ch->mutex, &__cw_spins)) continue;");
    wln(self, "        pthread_cond_wait(&ch->not_full, &ch->mutex);");
    wln(self, "    }");
    wln(self, "    if (ch->closed) {");
    wln(self, "        pthread_mutex_unlock(&ch->mutex);");
    wln(self, "        return false;");
    wln(self, "    }");
    wln(self, "    ch->buffer[ch->tail] = val;");
    wln(self, "    ch->tail = (ch->tail + 1) % ch->capacity;");
    wln(self, "    ch->count++;");
    wln(self, "    pthread_cond_signal(&ch->not_empty);");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (ch->tr_head) __p_chan_wake(ch, 0, 0);");
    wln(self, "#endif");
    wln(self, "    pthread_mutex_unlock(&ch->mutex);");
    wln(self, "    return true;");
    wln(self, "}");
    wln(self, "int64_t p_chan_recv(int64_t handle) {");
    wln(self, "    p_channel_t* ch = (p_channel_t*)(intptr_t)handle;");
    wln(self, "    if (!ch) return 0;");
    wln(self, "    __p_rnd_point();");
    // CA7: as p_chan_send; a cancelled receive gives what a closed, empty
    // channel gives
    wln(self, "    int64_t tok = p_task_token();");
    wln(self, "    for (;;) {");
    wln(self, "        pthread_mutex_lock(&ch->mutex);");
    wln(self, "        if (!tok || ch->count > 0 || ch->closed) break;");
    wln(self, "        pthread_mutex_unlock(&ch->mutex);");
    wln(self, "        if (__p_tok_cancelled(tok)) return P_CHAN_PENDING;");
    wln(self, "        __p_co_nap(1);");
    wln(self, "    }");
    wln(self, "    // Block until there's an item or the channel is closed and empty");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (__p_mn_on()) {");
    wln(self, "        while (ch->count == 0 && !ch->closed && __p_mn_chan_park(ch, &ch->mutex, 0)) {}");
    wln(self, "    }");
    wln(self, "#endif");
    // BG8: as p_chan_send
    wln(self, "    int64_t __cw_spins = 0;");
    wln(self, "    while (ch->count == 0 && !ch->closed) {");
    wln(self, "        if (__p_chan_coop_wait(&ch->mutex, &__cw_spins)) continue;");
    wln(self, "        pthread_cond_wait(&ch->not_empty, &ch->mutex);");
    wln(self, "    }");
    wln(self, "    if (ch->count == 0) {");
    wln(self, "        // Closed and empty");
    wln(self, "        pthread_mutex_unlock(&ch->mutex);");
    wln(self, "        return P_CHAN_PENDING;");
    wln(self, "    }");
    wln(self, "    int64_t val = ch->buffer[ch->head];");
    wln(self, "    ch->head = (ch->head + 1) % ch->capacity;");
    wln(self, "    ch->count--;");
    wln(self, "    pthread_cond_signal(&ch->not_full);");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (ch->ts_head) __p_chan_wake(ch, 1, 0);");
    wln(self, "#endif");
    wln(self, "    pthread_mutex_unlock(&ch->mutex);");
    wln(self, "    return val;");
    wln(self, "}");
    wln(self, "int64_t p_chan_try_recv(int64_t handle) {");
    wln(self, "    p_channel_t* ch = (p_channel_t*)(intptr_t)handle;");
    wln(self, "    if (!ch) return P_CHAN_PENDING;");
    wln(self, "    __p_rnd_point();");
    wln(self, "    pthread_mutex_lock(&ch->mutex);");
    wln(self, "    if (ch->count == 0) {");
    wln(self, "        int closed = ch->closed;");
    wln(self, "        pthread_mutex_unlock(&ch->mutex);");
    wln(self, "        return closed ? 0 : P_CHAN_PENDING;");
    wln(self, "    }");
    wln(self, "    int64_t val = ch->buffer[ch->head];");
    wln(self, "    ch->head = (ch->head + 1) % ch->capacity;");
    wln(self, "    ch->count--;");
    wln(self, "    pthread_cond_signal(&ch->not_full);");
    wln(self, "#ifdef P_MN");
    wln(self, "    if (ch->ts_head) __p_chan_wake(ch, 1, 0);");
    wln(self, "#endif");
    wln(self, "    pthread_mutex_unlock(&ch->mutex);");
    wln(self, "    return val;");
    wln(self, "}");
    wln(self, "void p_chan_close(int64_t handle) {");
    wln(self, "    p_channel_t* ch = (p_channel_t*)(intptr_t)handle;");
    wln(self, "    if (!ch) return;");
    wln(self, "    pthread_mutex_lock(&ch->mutex);");
    wln(self, "    ch->closed = 1;");
    wln(self, "    // Wake up all blocked senders and receivers");
    wln(self, "    pthread_cond_broadcast(&ch->not_empty);");
    wln(self, "    pthread_cond_broadcast(&ch->not_full);");
    wln(self, "#ifdef P_MN");
    wln(self, "    __p_chan_wake(ch, 0, 1);");
    wln(self, "    __p_chan_wake(ch, 1, 1);");
    wln(self, "#endif");
    wln(self, "    pthread_mutex_unlock(&ch->mutex);");
    wln(self, "}");
    wln(self, "bool p_chan_is_closed(int64_t handle) {");
    wln(self, "    p_channel_t* ch = (p_channel_t*)(intptr_t)handle;");
    wln(self, "    if (!ch) return true;");
    wln(self, "    pthread_mutex_lock(&ch->mutex);");
    wln(self, "    int closed = ch->closed;");
    wln(self, "    pthread_mutex_unlock(&ch->mutex);");
    wln(self, "    return closed;");
    wln(self, "}");
    // Dynamic loading builtins (Phase 7.7) - simulated to match interpreter
    wln(self, "// Simulated dlopen: returns sequential handles (1, 2, ...) to match interpreter");
    wln(self, "static int64_t dl_handle_counter = 0;");
    wln(self, "int64_t p_dl_open(const char* path) {");
    wln(self, "    if (!path || !*path) return 0;");
    wln(self, "    return ++dl_handle_counter;");
    wln(self, "}");
    wln(self, "int64_t p_dl_sym(int64_t handle, const char* symbol) {");
    wln(self, "    if (handle == 0) return 0;");
    wln(self, "    if (!symbol || !*symbol) return 0;");
    wln(self, "    return 0x1000 + handle * 0x100;");
    wln(self, "}");
    wln(self, "void p_dl_close(int64_t handle) {");
    wln(self, "    (void)handle; // no-op in simulation");
    wln(self, "}");
    // A simulated symbol (p_dl_sym: below 64 KiB, where no code is) returns
    // arg unchanged as before; a real one (p_dl_find) is called
    wln(self, "int64_t p_dl_call(int64_t func_ptr, int64_t arg) {");
    wln(self, "    if ((uint64_t)func_ptr < 0x10000) return arg; // simulated: arg unchanged");
    wln(self, "    return ((int64_t (*)(int64_t))(intptr_t)func_ptr)(arg);");
    wln(self, "}");
    // roadmap L6C: run-time loading through the OS (LoadLibrary and
    // GetProcAddress, dlopen and dlsym): p_dl_load gives the library's
    // handle or 0, p_dl_find the symbol's address or 0. Only in a program
    // that loads a library, so no other program needs -ldl (old glibc).
    if g_c_uses_dl {
        emit_dl_runtime(self);
    }
    // Allocator builtins (Phase 2A.8) - simplified stubs
    wln(self, "void* p_allocator_create(void* arg) { (void)arg; return (void*)1; }");
    wln(self, "int64_t p_allocator_alloc(void* alloc, int64_t size) { (void)alloc; if (size < 0) return 0; return (int64_t)(intptr_t)malloc((size_t)size); }");
    wln(self, "void p_allocator_free(void* alloc, int64_t ptr) { (void)alloc; free((void*)(intptr_t)ptr); }");
    wln(self, "int64_t p_allocator_stats(void* alloc) { (void)alloc; return 0; }");
    wln(self, "int64_t print(int64_t val) { char b[32]; int n = snprintf(b, sizeof b, \"%lld\", (long long)val); fwrite(b, 1, (size_t)n, stdout); return 0; }");
    wln(self, "int64_t print_str(const char* s) { fwrite(s, 1, (size_t)p_slen(s), stdout); return 0; }");
    wln(self, "");
    // String functions
    wln(self, "bool p_string_contains(const char* s, const char* sub) { return s && sub && p_mem_find(s, (size_t)p_slen(s), sub, (size_t)p_slen(sub)) != NULL; }");
    wln(self, "bool p_string_starts_with(const char* s, const char* prefix) {");
    wln(self, "    if (!s || !prefix) return false;");
    wln(self, "    size_t sl = (size_t)p_slen(s), pl = (size_t)p_slen(prefix);");
    wln(self, "    return pl <= sl && memcmp(s, prefix, pl) == 0;");
    wln(self, "}");
    wln(self, "bool p_string_ends_with(const char* s, const char* suffix) {");
    wln(self, "    if (!s || !suffix) return false;");
    wln(self, "    size_t sl = (size_t)p_slen(s), fl = (size_t)p_slen(suffix);");
    wln(self, "    return fl <= sl && memcmp(s + sl - fl, suffix, fl) == 0;");
    wln(self, "}");
    wln(self, "int64_t p_string_find(const char* s, const char* sub) {");
    wln(self, "    if (!s || !sub) return -1;");
    wln(self, "    const char* p = p_mem_find(s, (size_t)p_slen(s), sub, (size_t)p_slen(sub));");
    wln(self, "    return p ? (int64_t)(p - s) : -1;");
    wln(self, "}");
    wln(self, "static int p_is_ws_c(char c) { return c == ' ' || c == '\\t' || c == '\\n' || c == '\\r'; }");
    wln(self, "static char* p_string_trim__raw(const char* s);");
    wln(self, "char* p_string_trim(const char* s) { return p_str_own_c(p_string_trim__raw(s)); }");
    wln(self, "static char* p_string_trim__raw(const char* s) {");
    wln(self, "    if (!s) return p_str_alloc_c(0);");
    wln(self, "    size_t a = 0, b = (size_t)p_slen(s);");
    wln(self, "    while (a < b && p_is_ws_c(s[a])) a++;");
    wln(self, "    while (b > a && p_is_ws_c(s[b - 1])) b--;");
    wln(self, "    return p_str_from_bytes_c(s + a, b - a);");
    wln(self, "}");
    wln(self, "static char* p_string_to_uppercase__raw(const char* s);");
    wln(self, "char* p_string_to_uppercase(const char* s) { return p_str_own_c(p_string_to_uppercase__raw(s)); }");
    wln(self, "static char* p_string_to_uppercase__raw(const char* s) {");
    wln(self, "    size_t len = (size_t)p_slen(s);");
    wln(self, "    char* result = p_str_alloc_c((int64_t)len);");
    wln(self, "    for (size_t i = 0; i < len; i++) result[i] = (char)toupper((unsigned char)s[i]);");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "static char* p_string_to_lowercase__raw(const char* s);");
    wln(self, "char* p_string_to_lowercase(const char* s) { return p_str_own_c(p_string_to_lowercase__raw(s)); }");
    wln(self, "static char* p_string_to_lowercase__raw(const char* s) {");
    wln(self, "    size_t len = (size_t)p_slen(s);");
    wln(self, "    char* result = p_str_alloc_c((int64_t)len);");
    wln(self, "    for (size_t i = 0; i < len; i++) result[i] = (char)tolower((unsigned char)s[i]);");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "static char* p_string_repeat__raw(const char* s, int64_t n);");
    wln(self, "char* p_string_repeat(const char* s, int64_t n) { return p_str_own_c(p_string_repeat__raw(s, n)); }");
    wln(self, "static char* p_string_repeat__raw(const char* s, int64_t n) {");
    wln(self, "    size_t sl = (size_t)p_slen(s);");
    wln(self, "    if (n <= 0 || sl == 0) return p_str_alloc_c(0);");
    wln(self, "    if ((size_t)n > ((size_t)1 << 40) / sl) return p_str_alloc_c(0);");
    wln(self, "    char* result = p_str_alloc_c((int64_t)(sl * (size_t)n));");
    wln(self, "    for (int64_t i = 0; i < n; i++) memcpy(result + (size_t)i * sl, s, sl);");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "static char* p_string_replace__raw(const char* s, const char* from, const char* to);");
    wln(self, "char* p_string_replace(const char* s, const char* from, const char* to) { return p_str_own_c(p_string_replace__raw(s, from, to)); }");
    wln(self, "static char* p_string_replace__raw(const char* s, const char* from, const char* to) {");
    wln(self, "    if (!s) return p_str_alloc_c(0);");
    wln(self, "    size_t sl = (size_t)p_slen(s), fl = (size_t)p_slen(from), tl = (size_t)p_slen(to);");
    wln(self, "    if (!from || fl == 0) return p_str_from_bytes_c(s, sl);");
    wln(self, "    size_t count = 0;");
    wln(self, "    for (size_t at = 0; at < sl; ) {");
    wln(self, "        const char* p = p_mem_find(s + at, sl - at, from, fl);");
    wln(self, "        if (!p) break;");
    wln(self, "        count++;");
    wln(self, "        at = (size_t)(p - s) + fl;");
    wln(self, "    }");
    wln(self, "    char* result = p_str_alloc_c((int64_t)(sl - count * fl + count * tl));");
    wln(self, "    size_t ri = 0, si = 0;");
    wln(self, "    while (si < sl) {");
    wln(self, "        const char* p = p_mem_find(s + si, sl - si, from, fl);");
    wln(self, "        size_t upto = p ? (size_t)(p - s) : sl;");
    wln(self, "        memcpy(result + ri, s + si, upto - si);");
    wln(self, "        ri += upto - si;");
    wln(self, "        si = upto;");
    wln(self, "        if (!p) break;");
    wln(self, "        if (tl) memcpy(result + ri, to, tl);");
    wln(self, "        ri += tl;");
    wln(self, "        si += fl;");
    wln(self, "    }");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "int64_t p_string_split(const char* s, const char* delim) {");
    wln(self, "    PVec* v = p_vec_new();");
    wln(self, "    if (!s || !delim) return (int64_t)v;");
    wln(self, "    size_t sl = (size_t)p_slen(s), dl = (size_t)p_slen(delim);");
    wln(self, "    if (dl == 0) { if (sl) p_vec_push(v, (void*)p_str_from_bytes_c(s, sl)); return (int64_t)v; }");
    wln(self, "    size_t at = 0;");
    wln(self, "    while (at < sl) {");
    wln(self, "        const char* p = p_mem_find(s + at, sl - at, delim, dl);");
    wln(self, "        size_t upto = p ? (size_t)(p - s) : sl;");
    wln(self, "        p_vec_push(v, (void*)p_str_from_bytes_c(s + at, upto - at));");
    wln(self, "        if (!p) break;");
    wln(self, "        at = upto + dl;");
    wln(self, "    }");
    wln(self, "    return (int64_t)v;");
    wln(self, "}");
    wln(self, "int64_t p_string_parse_int(const char* s) { return s ? (int64_t)atoll(s) : 0; }");
    wln(self, "static char* p_string_char_at__raw(const char* s, int64_t idx);");
    wln(self, "char* p_string_char_at(const char* s, int64_t idx) { return p_str_own_c(p_string_char_at__raw(s, idx)); }");
    wln(self, "static char* p_string_char_at__raw(const char* s, int64_t idx) {");
    wln(self, "    if (!s) { char* r = (char*)p_malloc(1); r[0] = 0; return r; }");
    wln(self, "    char* result = (char*)p_malloc(2);");
    wln(self, "    result[0] = s[idx]; result[1] = 0;");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "static char* p_string_substring__raw(const char* s, int64_t start, int64_t end);");
    wln(self, "char* p_string_substring(const char* s, int64_t start, int64_t end) { return p_str_own_c(p_string_substring__raw(s, start, end)); }");
    wln(self, "static char* p_string_substring__raw(const char* s, int64_t start, int64_t end) {");
    wln(self, "    return p_string_slice(s, start, end);");
    wln(self, "}");
    wln(self, "");
    // Additional vec functions
    wln(self, "int64_t p_vec_capacity(PVec* v) { return v ? v->cap : 0; }");
    wln(self, "PVec* p_vec_clone(PVec* v) {");
    wln(self, "    PVec* c = p_vec_new();");
    wln(self, "    if (!v) return c;");
    // BG40: the clone keeps the element code and type id, so its pushes
    // store at the element size — a coded Vec (u8 or an inline struct,
    // whose P_VEC_AT is the element's address) does not become word slots
    wln(self, "    c->code = v->code; c->tid = v->tid;");
    wln(self, "    for (int64_t i = 0; i < v->len; i++) p_vec_push(c, P_VEC_AT(v, i));");
    wln(self, "    return c;");
    wln(self, "}");
    wln(self, "bool p_vec_contains(PVec* v, void* val) {");
    wln(self, "    for (int64_t i = 0; i < v->len; i++) if (P_VEC_AT(v, i) == val) return true;");
    wln(self, "    return false;");
    wln(self, "}");
    // CM10: the count is read once, so `v.extend(v)` (other == v, whose len
    // grows with each push) ends after doubling; P_VEC_AT re-reads the
    // buffer each round, since a push that grows v frees the old one.
    wln(self, "void p_vec_extend(PVec* v, PVec* other) {");
    wln(self, "    if (!v || !other) return;");
    wln(self, "    int64_t n = other->len;");
    wln(self, "    for (int64_t i = 0; i < n; i++) p_vec_push(v, P_VEC_AT(other, i));");
    wln(self, "}");
    wln(self, "void* p_vec_first(PVec* v) { return v->len > 0 ? P_VEC_AT(v, 0) : NULL; }");
    wln(self, "void* p_vec_last(PVec* v) { return v->len > 0 ? P_VEC_AT(v, v->len - 1) : NULL; }");
    wln(self, "void p_vec_insert(PVec* v, int64_t idx, void* val) {");
    // BG40: at the element size, on a buffer this Vec owns (p_vec_push)
    wln(self, "    if (!v || idx < 0 || idx > v->len) return;");
    wln(self, "    if (v->cap < 0 || v->len >= v->cap) __p_vec_grow((int64_t*)v);");
    wln(self, "    int64_t hc = P_VEC_CODE((int64_t*)v);");
    wln(self, "    int64_t esz = hc == 0 ? 8 : (hc < 0 ? -hc : (hc >= 16 ? (hc - 15) * 8 : hc));");
    wln(self, "    char* d = (char*)v->data;");
    wln(self, "    memmove(d + (idx + 1) * esz, d + idx * esz, (size_t)((v->len - idx) * esz));");
    wln(self, "    if (v->code) __p_vec_st((int64_t*)v, idx, (int64_t)(intptr_t)val);");
    wln(self, "    else P_VSLOT(v, idx) = (int64_t)(intptr_t)val;");
    wln(self, "    v->len++;");
    wln(self, "}");
    // BG120: remove/reverse/sort/truncate go through core's Vec functions —
    // the raw 8-byte slots below moved and compared elements at whatever
    // size the Vec stores them, and wrote a shared buffer other Vecs read
    // (core's vec_own copies it first)
    wln(self, "void* p_vec_remove(PVec* v, int64_t idx) {");
    wln(self, "    if (!v || idx < 0 || idx >= v->len) return NULL;");
    wln(self, "    return (void*)(intptr_t)Vec_remove(0, (int64_t)(intptr_t)v, idx);");
    wln(self, "}");
    wln(self, "void p_vec_reverse(PVec* v) { if (v) Vec_reverse(0, (int64_t)(intptr_t)v); }");
    wln(self, "void p_vec_sort(PVec* v) { if (v) Vec_sort(0, (int64_t)(intptr_t)v); }");
    wln(self, "void p_vec_truncate(PVec* v, int64_t len) { if (v) Vec_truncate(0, (int64_t)(intptr_t)v, len); }");
    wln(self, "");
    // Additional map functions
    wln(self, "PMap* p_map_clone(PMap* m) {");
    wln(self, "    PMap* c = p_map_new();");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) p_map_insert(c, m->keys[i], m->vals[i]);");
    wln(self, "    return c;");
    wln(self, "}");
    wln(self, "int64_t p_map_get_or(PMap* m, const char* key, int64_t default_val) {");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) if (strcmp(m->keys[i], key) == 0) return m->vals[i];");
    wln(self, "    return default_val;");
    wln(self, "}");
    wln(self, "");
    // p_to_str variants
    wln(self, "char* p_to_str_vec(PVec* v) {");
    wln(self, "    char* result = p_to_str_str(\"[\");");
    wln(self, "    for (int64_t i = 0; i < v->len; i++) {");
    wln(self, "        if (i > 0) { char* tmp = p_str_concat(result, \", \"); p_str_free_c(result); result = tmp; }");
    wln(self, "        char* s = p_to_str((int64_t)P_VEC_AT(v, i));");
    wln(self, "        char* tmp = p_str_concat(result, s); p_str_free_c(result); p_str_free_c(s); result = tmp;");
    wln(self, "    }");
    wln(self, "    char* tmp = p_str_concat(result, \"]\"); p_str_free_c(result); result = tmp;");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "char* p_to_str_map(PMap* m) {");
    wln(self, "    if (!m) return p_to_str_str(\"{}\");");
    wln(self, "    // Sort keys for deterministic output");
    wln(self, "    int64_t* order = (int64_t*)malloc(m->len * sizeof(int64_t));");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) order[i] = i;");
    wln(self, "    for (int64_t i = 0; i < m->len; i++)");
    wln(self, "        for (int64_t j = i+1; j < m->len; j++)");
    wln(self, "            if (strcmp(m->keys[order[i]], m->keys[order[j]]) > 0) { int64_t t = order[i]; order[i] = order[j]; order[j] = t; }");
    wln(self, "    char* result = p_to_str_str(\"{\");");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) {");
    wln(self, "        if (i > 0) { char* tmp = p_str_concat(result, \", \"); p_str_free_c(result); result = tmp; }");
    wln(self, "        char* tmp = p_str_concat(result, m->keys[order[i]]); p_str_free_c(result); result = tmp;");
    wln(self, "        tmp = p_str_concat(result, \": \"); p_str_free_c(result); result = tmp;");
    wln(self, "        char* vs = p_to_str(m->vals[order[i]]);");
    wln(self, "        tmp = p_str_concat(result, vs); p_str_free_c(result); p_str_free_c(vs); result = tmp;");
    wln(self, "    }");
    wln(self, "    char* tmp = p_str_concat(result, \"}\"); p_str_free_c(result); result = tmp;");
    wln(self, "    free(order);");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "static char* p_to_str_str__raw(const char* s);");
    wln(self, "char* p_to_str_str(const char* s) { return p_str_own_c(p_to_str_str__raw(s)); }");
    wln(self, "static char* p_to_str_str__raw(const char* s) { if (!s) s = \"\"; size_t l = strlen(s); char* r = (char*)p_malloc((int64_t)(l+1)); memcpy(r, s, l+1); return r; }");
    // RT3: every one-byte string is one of 256 static strings (the literal
    // layout: [P_STR_STATIC][1] byte NUL), so p_char_to_str (and core's
    // one-byte slices, which call it) never allocate; freeing a static
    // string does nothing, so --leaks stays clean. The byte is the value's
    // low 8 bits, as `(char)val` gave.
    wln(self, "typedef struct { int64_t m; int64_t l; char s[8]; } __p_chr1_t;");
    wln(self, "#define P_C1(c) { P_STR_STATIC_C, 1LL, { (char)(c), 0 } }");
    wln(self, "#define P_C1x8(c) P_C1(c), P_C1((c) + 1), P_C1((c) + 2), P_C1((c) + 3), P_C1((c) + 4), P_C1((c) + 5), P_C1((c) + 6), P_C1((c) + 7)");
    wln(self, "#define P_C1x64(c) P_C1x8(c), P_C1x8((c) + 8), P_C1x8((c) + 16), P_C1x8((c) + 24), P_C1x8((c) + 32), P_C1x8((c) + 40), P_C1x8((c) + 48), P_C1x8((c) + 56)");
    wln(self, "static const __p_chr1_t __p_chr1[256] = { P_C1x64(0), P_C1x64(64), P_C1x64(128), P_C1x64(192) };");
    wln(self, "#undef P_C1x64");
    wln(self, "#undef P_C1x8");
    wln(self, "#undef P_C1");
    wln(self, "char* p_char_to_str(int64_t val) { return (char*)__p_chr1[(uint8_t)val].s; }");
    wln(self, "static char* p_to_str_bool__raw(bool val);");
    wln(self, "char* p_to_str_bool(bool val) { return p_str_own_c(p_to_str_bool__raw(val)); }");
    wln(self, "static char* p_to_str_bool__raw(bool val) { char* r = (char*)p_malloc(6); strcpy(r, val ? \"true\" : \"false\"); return r; }");
    wln(self, "static char* p_to_str_float__raw(double val);");
    wln(self, "char* p_to_str_float(double val) { return p_str_own_c(p_to_str_float__raw(val)); }");
    wln(self, "static char* p_to_str_float__raw(double val) {");
    wln(self, "    char* buf = (char*)p_malloc(512);");
    wln(self, "    // Match Rust's {} format: shortest representation that round-trips.");
    wln(self, "    // Rust's Display for f64 always uses fixed-point (never scientific notation).");
    wln(self, "    if (val == 0.0) { snprintf(buf, 512, \"0\"); return buf; }");
    // stdlib-agent-bugs 6: an infinity looped below (inf / 10 is inf) and a
    // NaN printed as \"-nan(ind)\"; the native runtimes' text instead
    wln(self, "    if (isnan(val)) { strcpy(buf, \"NaN\"); return buf; }");
    wln(self, "    if (isinf(val)) { strcpy(buf, val > 0 ? \"inf\" : \"-inf\"); return buf; }");
    wln(self, "    // Calculate required max precision from exponent.");
    wln(self, "    // For 2.22e-16, we need prec=32 (16 zeros + 16 sig digits).");
    wln(self, "    int exp = 0;");
    wln(self, "    double absval = fabs(val);");
    wln(self, "    if (absval >= 1.0) { while (absval >= 10.0) { absval /= 10.0; exp++; } }");
    wln(self, "    else { while (absval < 1.0) { absval *= 10.0; exp--; } }");
    wln(self, "    int max_prec = 17 + (exp < 0 ? -exp : 0);");
    wln(self, "    if (max_prec > 350) max_prec = 350;");
    wln(self, "    // Try increasing precision with %f format (no scientific notation)");
    wln(self, "    for (int prec = 0; prec <= max_prec; prec++) {");
    wln(self, "        snprintf(buf, 512, \"%.*f\", prec, val);");
    wln(self, "        double parsed = strtod(buf, NULL);");
    wln(self, "        if (parsed == val) {");
    wln(self, "            // Trim trailing zeros after decimal point (e.g., \"10.0\" -> \"10\")");
    wln(self, "            char* dot = strchr(buf, '.');");
    wln(self, "            if (dot) {");
    wln(self, "                char* end = buf + strlen(buf) - 1;");
    wln(self, "                while (end > dot && *end == '0') *end-- = '\\0';");
    wln(self, "                if (end == dot) *end = '\\0'; /* remove trailing dot */");
    wln(self, "            }");
    wln(self, "            return buf;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    // If no precision round-trips, use max precision");
    wln(self, "    snprintf(buf, 512, \"%.*f\", max_prec, val);");
    wln(self, "    return buf;");
    wln(self, "}");
    // Aliases for the new naming convention used by fstring lowering
    wln(self, "char* p_float_to_str(double val) { return p_to_str_float(val); }");
    wln(self, "char* p_bool_to_str(bool val) { return p_to_str_bool(val); }");
    wln(self, "char* p_vec_to_str(PVec* v) { return p_to_str_vec(v); }");
    // SH-4.1: String to float parsing
    wln(self, "double p_str_to_float(const char* s) { if (!s) return 0.0; return atof(s); }");
    // B5: Float bit-pattern conversion (preserve NaN/Inf/-0.0 in ConstFloat)
    wln(self, "int64_t p_f64_to_bits(double val) { union { double d; int64_t i; } u; u.d = val; return u.i; }");
    wln(self, "int64_t p_f32_to_bits(float val) { union { float f; int32_t i; } u; u.f = val; return (int64_t)u.i; }");
    wln(self, "double p_f64_from_bits(int64_t bits) { union { double d; int64_t i; } u; u.i = bits; return u.d; }");
    wln(self, "float p_f32_from_bits(int64_t bits) { union { float f; int32_t i; } u; u.i = (int32_t)bits; return u.f; }");
    wln(self, "double p_int_to_float(int64_t val) { return (double)val; }");
    wln(self, "int64_t p_float_to_int(double val) { return (int64_t)val; }");
    wln(self, "int64_t p_str_to_int(const char* s) { if (!s) return 0; return atoll(s); }");

    // --- Socket builtins (native HTTP server, Phase 5D) ---
    wln(self, "");
    wln(self, "// Socket operations - native POSIX/Winsock implementation");
    wln(self, "#ifdef _WIN32");
    wln(self, "static int ws_initialized = 0;");
    wln(self, "void init_winsock(void) {");
    wln(self, "    if (!ws_initialized) { WSADATA d; WSAStartup(MAKEWORD(2,2), &d); ws_initialized = 1; }");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "");
    wln(self, "int64_t p_socket_listen(int64_t port) {");
    wln(self, "    if (P_CAP_DENIED(P_CAP_NET)) return -1;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    init_winsock();");
    wln(self, "    SOCKET s = INVALID_SOCKET;");
    wln(self, "#else");
    wln(self, "    int s = -1;");
    wln(self, "#endif");
    wln(self, "    int opt = 1;");
    wln(self, "    /* IPv6 and IPv4 clients on one socket (IPV6_V6ONLY off: Windows has it");
    wln(self, "       on by default); IPv4 alone where the system has no IPv6 */");
    wln(self, "#if !defined(__wasi__)");
    wln(self, "    s = socket(AF_INET6, SOCK_STREAM, 0);");
    wln(self, "#ifdef _WIN32");
    wln(self, "    if (s != INVALID_SOCKET) {");
    wln(self, "#else");
    wln(self, "    if (s >= 0) {");
    wln(self, "#endif");
    wln(self, "        int off = 0;");
    wln(self, "        setsockopt(s, SOL_SOCKET, SO_REUSEADDR, (char*)&opt, sizeof(opt));");
    wln(self, "        setsockopt(s, IPPROTO_IPV6, IPV6_V6ONLY, (char*)&off, sizeof(off));");
    wln(self, "        struct sockaddr_in6 a6;");
    wln(self, "        memset(&a6, 0, sizeof(a6));");
    wln(self, "        a6.sin6_family = AF_INET6;");
    wln(self, "        a6.sin6_addr = in6addr_any;");
    wln(self, "        a6.sin6_port = htons((int)port);");
    wln(self, "        if (bind(s, (struct sockaddr*)&a6, sizeof(a6)) == 0 && listen(s, SOMAXCONN) == 0) return (int64_t)s;");
    wln(self, "#ifdef _WIN32");
    wln(self, "        closesocket(s);");
    wln(self, "#else");
    wln(self, "        close(s);");
    wln(self, "#endif");
    wln(self, "    }");
    wln(self, "#endif");
    wln(self, "    s = socket(AF_INET, SOCK_STREAM, 0);");
    wln(self, "#ifdef _WIN32");
    wln(self, "    if (s == INVALID_SOCKET) return -1;");
    wln(self, "#else");
    wln(self, "    if (s < 0) return -1;");
    wln(self, "#endif");
    wln(self, "    setsockopt((int)s, SOL_SOCKET, SO_REUSEADDR, (char*)&opt, sizeof(opt));");
    wln(self, "    struct sockaddr_in addr;");
    wln(self, "    memset(&addr, 0, sizeof(addr));");
    wln(self, "    addr.sin_family = AF_INET;");
    wln(self, "    addr.sin_addr.s_addr = INADDR_ANY;");
    wln(self, "    addr.sin_port = htons((int)port);");
    wln(self, "    if (bind((int)s, (struct sockaddr*)&addr, sizeof(addr)) < 0) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        closesocket(s);");
    wln(self, "#else");
    wln(self, "        close(s);");
    wln(self, "#endif");
    wln(self, "        return -1;");
    wln(self, "    }");
    // The system's longest queue of connections not yet accepted: with 10,
    // a burst of clients was refused before the accepting task ran
    wln(self, "    if (listen((int)s, SOMAXCONN) < 0) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        closesocket(s);");
    wln(self, "#else");
    wln(self, "        close(s);");
    wln(self, "#endif");
    wln(self, "        return -1;");
    wln(self, "    }");
    wln(self, "    return (int64_t)s;");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_socket_accept(int64_t fd) {");
    wln(self, "    /* In a task, as on the native backend: wait for a connection while the");
    wln(self, "       other tasks run, and hand back a non-blocking socket (a blocking");
    wln(self, "       read on it would stop every task of this thread) */");
    wln(self, "    int in_task = __p_co_cur != NULL;");
    wln(self, "    if (in_task) return p_co_accept(fd);");
    wln(self, "    struct sockaddr_storage client;");
    wln(self, "    int64_t r;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    int clen = sizeof(client);");
    wln(self, "    SOCKET c = accept((SOCKET)fd, (struct sockaddr*)&client, &clen);");
    wln(self, "    r = (c == INVALID_SOCKET) ? -1 : (int64_t)c;");
    wln(self, "#else");
    wln(self, "    socklen_t clen = sizeof(client);");
    wln(self, "    int c = accept((int)fd, (struct sockaddr*)&client, &clen);");
    wln(self, "    r = (int64_t)c;");
    wln(self, "#endif");
    wln(self, "    if (r >= 0 && in_task) __p_co_nonblock(r);");
    wln(self, "    return r;");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_socket_read(int64_t fd, char* buf, int64_t max_len) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    int n = recv((SOCKET)fd, buf, (int)max_len, 0);");
    wln(self, "#else");
    wln(self, "    ssize_t n = read((int)fd, buf, (size_t)max_len);");
    wln(self, "#endif");
    wln(self, "    return (n < 0) ? -1 : (int64_t)n;");
    wln(self, "}");
    wln(self, "");
    // BG39: a write to a socket whose peer has gone raised SIGPIPE, which
    // ends the program (a server died when a client disconnected): it is
    // held back, so the write gives -1 (EPIPE). MSG_NOSIGNAL where the
    // system has it (a descriptor that is no socket is written as before),
    // SO_NOSIGPIPE on the socket elsewhere (macOS, the BSDs).
    wln(self, "#if !defined(_WIN32)");
    wln(self, "#include <errno.h>");
    wln(self, "#endif");
    wln(self, "int64_t p_socket_write(int64_t fd, const char* buf, int64_t len) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    int n = send((SOCKET)fd, buf, (int)len, 0);");
    wln(self, "#elif defined(MSG_NOSIGNAL) && !defined(__wasi__)");
    wln(self, "    ssize_t n = send((int)fd, buf, (size_t)len, MSG_NOSIGNAL);");
    wln(self, "    if (n < 0 && errno == ENOTSOCK) n = write((int)fd, buf, (size_t)len);");
    wln(self, "#else");
    wln(self, "#if defined(SO_NOSIGPIPE) && !defined(__wasi__)");
    wln(self, "    { int one = 1; setsockopt((int)fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one); }");
    wln(self, "#endif");
    wln(self, "    ssize_t n = write((int)fd, buf, (size_t)len);");
    wln(self, "#endif");
    wln(self, "    return (n < 0) ? -1 : (int64_t)n;");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_socket_write_str(int64_t fd, const char* buf) {");
    // p_slen, not strlen: a counted str may hold binary data (HTTP request
    // bodies), and strlen would stop at its first NUL byte.
    wln(self, "    return p_socket_write(fd, buf, p_slen(buf));");
    wln(self, "}");
    wln(self, "");
    wln(self, "void p_socket_close(int64_t fd) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    closesocket((SOCKET)fd);");
    wln(self, "#else");
    wln(self, "    close((int)fd);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "");
    // roadmap L4B: Unix-domain stream sockets (stdlib/unix_socket.fd); the
    // p_socket_* builtins above work on them
    wln(self, "/* Unix-domain stream sockets (stdlib/unix_socket.fd): a socket listening");
    wln(self, "   at path, or one connected to the listener there; -1 on failure (the path");
    wln(self, "   empty or too long, already bound, nothing listening). Windows 10 1803+");
    wln(self, "   has AF_UNIX in ws2_32 (SOCKADDR_UN: a 16-bit family, 108 bytes of path). */");
    wln(self, "#if !defined(_WIN32) && !defined(__wasi__)");
    wln(self, "#include <sys/un.h>");
    wln(self, "#endif");
    wln(self, "static int64_t __p_unix_open(const char* path, int listening) {");
    wln(self, "#if defined(__wasi__)");
    wln(self, "    (void)path; (void)listening;");
    wln(self, "    return -1;");
    wln(self, "#else");
    wln(self, "    if (!path || P_CAP_DENIED(P_CAP_NET)) return -1;");
    wln(self, "    size_t n = strlen(path);");
    wln(self, "#ifdef _WIN32");
    wln(self, "    struct { unsigned short sun_family; char sun_path[108]; } a;");
    wln(self, "#else");
    wln(self, "    struct sockaddr_un a;");
    wln(self, "#endif");
    wln(self, "    if (n == 0 || n >= sizeof(a.sun_path)) return -1;");
    wln(self, "    memset(&a, 0, sizeof a);");
    wln(self, "    a.sun_family = AF_UNIX;");
    wln(self, "    memcpy(a.sun_path, path, n);");
    wln(self, "#ifdef _WIN32");
    wln(self, "    init_winsock();");
    wln(self, "    SOCKET s = socket(AF_UNIX, SOCK_STREAM, 0);");
    wln(self, "    if (s == INVALID_SOCKET) return -1;");
    wln(self, "#else");
    wln(self, "    int s = socket(AF_UNIX, SOCK_STREAM, 0);");
    wln(self, "    if (s < 0) return -1;");
    wln(self, "#endif");
    wln(self, "    int ok;");
    wln(self, "    if (listening) ok = bind(s, (struct sockaddr*)&a, (int)sizeof a) == 0 && listen(s, SOMAXCONN) == 0;");
    wln(self, "    else ok = connect(s, (struct sockaddr*)&a, (int)sizeof a) == 0;");
    wln(self, "    if (!ok) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        closesocket(s);");
    wln(self, "#else");
    wln(self, "        close(s);");
    wln(self, "#endif");
    wln(self, "        return -1;");
    wln(self, "    }");
    wln(self, "    return (int64_t)s;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_unix_listen(const char* path) { return __p_unix_open(path, 1); }");
    wln(self, "int64_t p_unix_connect(const char* path) { return __p_unix_open(path, 0); }");
    wln(self, "");
    wln(self, "static char* p_socket_recv_str__raw(int64_t fd);");
    wln(self, "char* p_socket_recv_str(int64_t fd) { return p_str_own_libc_c(p_socket_recv_str__raw(fd)); }");
    wln(self, "static char* p_socket_recv_str__raw(int64_t fd) {");
    wln(self, "    char buf[4096];");
    wln(self, "    int64_t n = p_socket_read(fd, buf, sizeof(buf)-1);");
    wln(self, "    if (n <= 0) return strdup(\"\");");
    wln(self, "    if (n >= (int64_t)sizeof(buf)) n = (int64_t)sizeof(buf)-1;");
    wln(self, "    buf[n] = 0;");
    wln(self, "    return strdup(buf);");
    wln(self, "}");
    wln(self, "");
    wln(self, "// --- Nonblocking sockets + readiness poll (async event loop) ---");
    wln(self, "int64_t p_socket_nonblock(int64_t fd, int64_t on) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    u_long m = on ? 1u : 0u;");
    wln(self, "    return ioctlsocket((SOCKET)fd, FIONBIO, &m);");
    wln(self, "#else");
    wln(self, "    int fl = fcntl((int)fd, F_GETFL, 0);");
    wln(self, "    if (fl < 0) return -1;");
    wln(self, "    return fcntl((int)fd, F_SETFL, on ? (fl | O_NONBLOCK) : (fl & ~O_NONBLOCK));");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_socket_poll(int64_t fd, int64_t timeout_ms, int64_t write_mode) {");
    wln(self, "#ifdef __wasi__");
    wln(self, "    struct pollfd pf; pf.fd = (int)fd; pf.events = write_mode ? POLLOUT : POLLIN; pf.revents = 0;");
    wln(self, "    return (int64_t)poll(&pf, 1, (int)timeout_ms);");
    wln(self, "#else");
    wln(self, "    fd_set rset, wset; struct timeval tv;");
    wln(self, "    FD_ZERO(&rset); FD_ZERO(&wset);");
    wln(self, "    if (write_mode) FD_SET((SOCKET)fd, &wset); else FD_SET((SOCKET)fd, &rset);");
    wln(self, "    tv.tv_sec = (long)(timeout_ms / 1000);");
    wln(self, "    tv.tv_usec = (long)((timeout_ms % 1000) * 1000);");
    wln(self, "    int n = select((int)(fd + 1), &rset, &wset, NULL, timeout_ms < 0 ? NULL : &tv);");
    wln(self, "    return (int64_t)n;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "");
    wln(self, "// --- Signals ---");
    wln(self, "#include <signal.h>");
    wln(self, "static volatile sig_atomic_t p_signal_flags[64] = {0};");
    wln(self, "static void p_signal_trampoline(int s) { if (s >= 0 && s < 64) p_signal_flags[s] = 1; }");
    wln(self, "int64_t p_signal_register(int64_t sig) {");
    wln(self, "    if (sig < 0 || sig >= 64) return -1;");
    wln(self, "    if (signal((int)sig, p_signal_trampoline) == SIG_ERR) return -1;");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "int64_t p_signal_check(int64_t sig) {");
    wln(self, "    if (sig < 0 || sig >= 64) return 0;");
    wln(self, "    int64_t f = p_signal_flags[sig]; p_signal_flags[sig] = 0;");
    wln(self, "    return f;");
    wln(self, "}");
    wln(self, "int64_t p_signal_raise(int64_t sig) { return raise((int)sig); }");
    wln(self, "");
    wln(self, "// --- Memory-mapped files / anonymous mappings ---");
    wln(self, "#ifndef _WIN32");
    wln(self, "#include <sys/mman.h>");
    wln(self, "#include <sys/stat.h>");
    wln(self, "#include <fcntl.h>");
    wln(self, "#endif");
    wln(self, "typedef struct { void* addr; int64_t len; int64_t h1; int64_t h2; int is_file; } p_mmap_entry_t;");
    wln(self, "static p_mmap_entry_t p_mmap_table[256];");
    wln(self, "static int p_mmap_find(void* addr) { for (int i = 0; i < 256; i++) if (p_mmap_table[i].addr == addr) return i; return -1; }");
    wln(self, "static int p_mmap_slot(void) { for (int i = 0; i < 256; i++) if (!p_mmap_table[i].addr) return i; return -1; }");
    wln(self, "int64_t p_mmap_anon(int64_t len) {");
    wln(self, "    if (len <= 0) return 0;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    void* p = VirtualAlloc(NULL, (SIZE_T)len, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);");
    wln(self, "#else");
    wln(self, "    void* p = mmap(NULL, (size_t)len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);");
    wln(self, "    if (p == MAP_FAILED) p = NULL;");
    wln(self, "#endif");
    wln(self, "    if (!p) return 0;");
    wln(self, "    int s = p_mmap_slot(); if (s < 0) return 0;");
    wln(self, "    p_mmap_table[s].addr = p; p_mmap_table[s].len = len; p_mmap_table[s].is_file = 0;");
    wln(self, "    return (int64_t)(intptr_t)p;");
    wln(self, "}");
    wln(self, "int64_t p_mmap_file(const char* path) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    HANDLE f = CreateFileA(path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);");
    wln(self, "    if (f == INVALID_HANDLE_VALUE) f = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);");
    wln(self, "    if (f == INVALID_HANDLE_VALUE) return 0;");
    wln(self, "    LARGE_INTEGER sz; if (!GetFileSizeEx(f, &sz) || sz.QuadPart == 0) { CloseHandle(f); return 0; }");
    wln(self, "    HANDLE m = CreateFileMappingA(f, NULL, PAGE_READWRITE, 0, 0, NULL);");
    wln(self, "    if (!m) m = CreateFileMappingA(f, NULL, PAGE_READONLY, 0, 0, NULL);");
    wln(self, "    if (!m) { CloseHandle(f); return 0; }");
    wln(self, "    void* p = MapViewOfFile(m, FILE_MAP_ALL_ACCESS, 0, 0, 0);");
    wln(self, "    if (!p) p = MapViewOfFile(m, FILE_MAP_READ, 0, 0, 0);");
    wln(self, "    if (!p) { CloseHandle(m); CloseHandle(f); return 0; }");
    wln(self, "    int s = p_mmap_slot(); if (s < 0) return 0;");
    wln(self, "    p_mmap_table[s].addr = p; p_mmap_table[s].len = (int64_t)sz.QuadPart;");
    wln(self, "    p_mmap_table[s].h1 = (int64_t)(intptr_t)m; p_mmap_table[s].h2 = (int64_t)(intptr_t)f;");
    wln(self, "    p_mmap_table[s].is_file = 1;");
    wln(self, "    return (int64_t)(intptr_t)p;");
    wln(self, "#else");
    wln(self, "    int fd = open(path, O_RDWR); if (fd < 0) fd = open(path, O_RDONLY);");
    wln(self, "    if (fd < 0) return 0;");
    wln(self, "    struct stat st; if (fstat(fd, &st) < 0 || st.st_size == 0) { close(fd); return 0; }");
    wln(self, "    void* p = mmap(NULL, (size_t)st.st_size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);");
    wln(self, "    if (p == MAP_FAILED) p = mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_SHARED, fd, 0);");
    wln(self, "    if (p == MAP_FAILED) { close(fd); return 0; }");
    wln(self, "    int s = p_mmap_slot(); if (s < 0) return 0;");
    wln(self, "    p_mmap_table[s].addr = p; p_mmap_table[s].len = (int64_t)st.st_size;");
    wln(self, "    p_mmap_table[s].h1 = fd; p_mmap_table[s].is_file = 1;");
    wln(self, "    return (int64_t)(intptr_t)p;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_mmap_len(int64_t addr) { int s = p_mmap_find((void*)(intptr_t)addr); return s < 0 ? 0 : p_mmap_table[s].len; }");
    wln(self, "int64_t p_munmap(int64_t addr) {");
    wln(self, "    int s = p_mmap_find((void*)(intptr_t)addr); if (s < 0) return -1;");
    wln(self, "    p_mmap_entry_t e = p_mmap_table[s]; p_mmap_table[s].addr = NULL;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    if (e.is_file) { UnmapViewOfFile(e.addr); CloseHandle((HANDLE)(intptr_t)e.h1); CloseHandle((HANDLE)(intptr_t)e.h2); }");
    wln(self, "    else VirtualFree(e.addr, 0, MEM_RELEASE);");
    wln(self, "#else");
    wln(self, "    munmap(e.addr, (size_t)e.len); if (e.is_file) close((int)e.h1);");
    wln(self, "#endif");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "int64_t p_msync(int64_t addr) {");
    wln(self, "    int s = p_mmap_find((void*)(intptr_t)addr); if (s < 0) return -1;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    return FlushViewOfFile(p_mmap_table[s].addr, 0) ? 0 : -1;");
    wln(self, "#else");
    wln(self, "    return msync(p_mmap_table[s].addr, (size_t)p_mmap_table[s].len, MS_SYNC);");
    wln(self, "#endif");
    wln(self, "}");
    // RT14: zero-copy file copy and file-to-socket sends
    emit_zero_copy_runtime(self);

    // --- Bare metal builtins (Phase 5A) - stubs for C codegen ---
    wln(self, "");
    wln(self, "// Bare metal stubs - no-ops in C codegen (use --bare for real hardware)");
    wln(self, "void p_cli(void) {}");
    wln(self, "void p_sti(void) {}");
    wln(self, "void p_hlt(void) {}");
    wln(self, "int64_t p_cr0_read(void) { return 0; }");
    wln(self, "int64_t p_cr3_read(void) { return 0; }");
    wln(self, "int64_t p_cr4_read(void) { return 0; }");
    wln(self, "void p_cr3_write(int64_t val) { (void)val; }");
    wln(self, "void p_invlpg(int64_t addr) { (void)addr; }");
