    fn_ret_types_set(self, "p_gaussian_noise", IrType::Opaque("Tensor"));
    fn_ret_types_set(self, "p_dropout", IrType::Opaque("Tensor"));
}

// --- String helpers for unique collections --------------------------------

fn vec_push_unique(v: Vec<str>, s: str) -> void {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return;
        }
        i = i + 1;
    }
    v.push(s);
}

// --- Header / runtime type emission ---------------------------------------

fn emit_runtime_header(self: &mut CCodeGen) -> void {
    wln(self, "// Auto-generated C code from Fides IR");
    wln(self, "// IEEE arithmetic exactly as written: no fused multiply-add contraction.");
    wln(self, "#if defined(__clang__)");
    wln(self, "#pragma STDC FP_CONTRACT OFF");
    wln(self, "#elif defined(__GNUC__)");
    wln(self, "#pragma GCC optimize (\"fp-contract=off\")");
    wln(self, "#endif");
    wln(self, "#include <stdio.h>");
    wln(self, "#include <stdlib.h>");
    wln(self, "#include <string.h>");
    wln(self, "#ifndef _WIN32");
    wln(self, "#include <alloca.h>");
    wln(self, "#endif");
    wln(self, "#include <stdint.h>");
    wln(self, "#include <stdbool.h>");
    wln(self, "#include <ctype.h>");
    wln(self, "#include <math.h>");
    wln(self, "#ifdef _WIN32");
    wln(self, "#include <winsock2.h>");
    wln(self, "#include <ws2tcpip.h>");
    wln(self, "#include <io.h>");
    wln(self, "#include <fcntl.h>");
    wln(self, "// PLINK: ws2_32");
    wln(self, "#else");
    wln(self, "#include <sys/socket.h>");
    wln(self, "#include <netinet/in.h>");
    wln(self, "#include <arpa/inet.h>");
    wln(self, "#include <netdb.h>");
    wln(self, "typedef int SOCKET;");
    wln(self, "#include <unistd.h>");
    wln(self, "#include <fcntl.h>");
    wln(self, "#endif");
    // Directory listing + process capture (fs/process stdlib builtins)
    wln(self, "#include <sys/stat.h>");
    wln(self, "#ifdef _WIN32");
    wln(self, "#include <windows.h>");
    wln(self, "#include <direct.h>");
    wln(self, "#include <process.h>");
    wln(self, "#else");
    wln(self, "#include <dirent.h>");
    wln(self, "#include <sys/wait.h>");
    wln(self, "#endif");
    wln(self, "");
    wln(self, "#ifdef max");
    wln(self, "#undef max");
    wln(self, "#endif");
    wln(self, "#ifdef min");
    wln(self, "#undef min");
    wln(self, "#endif");
    wln(self, "#ifdef abs");
    wln(self, "#undef abs");
    wln(self, "#endif");
    wln(self, "");
    wln(self, "typedef struct { double* data; int64_t len; int64_t ndim; int64_t shape[8]; } PTensor;");
    wln(self, "");
}

// --- FFI / extern declarations --------------------------------------------

fn c_is_struct(module: IrModule, ty: Type) -> bool {
    match ty {
        Type::Named(n) => {
            match IrModule_get_struct(&module, n) {
                OptStructLayout::Some(_) => { return true; }
                OptStructLayout::None => {}
            }
        }
        _ => {}
    }
    return false;
}

fn c_named_struct(module: IrModule, ty: Type, out: &mut Vec<str>) -> void {
    match ty {
        Type::Ref(inner, _) => { c_named_struct(module, box_type_unbox(inner), out); }
        Type::Named(n) => {
            if c_is_struct(module, ty) && !vec_contains_str(*out, n) { out.push(n); }
        }
        _ => {}
    }
}

fn emit_extern_decls(self: &mut CCodeGen, module: IrModule) -> void {
    if module.extern_decls.len() == 0 {
        return;
    }

    var missing_includes: Vec<str> = Vec::new();
    var emitted_includes: Vec<str> = Vec::new();
    var ed: i64 = 0;
    while ed < module.extern_decls.len() {
        var ext: ExternDecl = module.extern_decls.get(ed);
        match ext.include {
            OptStr::Some(inc) => {
                if !vec_contains_str(emitted_includes, inc) {
                    if str_starts_with(inc, "<") {
                        // System header
                        wln(self, "#include " + inc);
                    } else {
                        // Local header - check if file exists via file_exists helper
                        var clean: str = str_trim_chars(inc, "\"<>");
                        if p_file_exists(clean) {
                            if str_starts_with(inc, "\"") {
                                wln(self, "#include " + inc);
                            } else {
                                wln(self, "#include \"" + clean + "\"");
                            }
                        } else {
                            missing_includes.push(inc);
                        }
                    }
                    vec_push_unique(emitted_includes, inc);
                }
            }
            OptStr::None => {}
        }
        ed = ed + 1;
    }
    if emitted_includes.len() > 0 {
        wln(self, "");
    }

    var emitted_libs: Vec<str> = Vec::new();
    ed = 0;
    while ed < module.extern_decls.len() {
        var ext: ExternDecl = module.extern_decls.get(ed);
        match ext.link_lib {
            OptStr::Some(lib) => {
                if !vec_contains_str(emitted_libs, lib) {
                    wln(self, "// PLINK: " + lib);
                    vec_push_unique(emitted_libs, lib);
                }
            }
            OptStr::None => {}
        }
        ed = ed + 1;
    }

    // A Fides struct a declaration names, with no header to define it
    var named: Vec<str> = Vec::new();
    var ni: i64 = 0;
    while ni < module.extern_decls.len() {
        var nd: ExternDecl = module.extern_decls.get(ni);
        var wrapped: bool = c_is_struct(module, nd.ret_ty);
        var has_include: bool = false;
        match nd.include {
            OptStr::Some(_) => { has_include = true; }
            OptStr::None => {}
        }
        if !has_include { c_named_struct(module, nd.ret_ty, &mut named); }
        var np: i64 = 0;
        while np < nd.params.len() {
            var nty: Type = nd.params.get(np).ty;
            if !has_include { c_named_struct(module, nty, &mut named); }
            if c_is_struct(module, nty) { wrapped = true; }
            np = np + 1;
        }
        if wrapped { self.c_wrapped.push(nd.pledge_name); }
        ni = ni + 1;
    }
    ni = 0;
    while ni < named.len() {
        wln(self, "typedef struct " + named.get(ni) + "_s " + named.get(ni) + ";");
        ni = ni + 1;
    }
    wln(self, "// --- User-defined extern declarations (FFI) ---");
    ed = 0;
    while ed < module.extern_decls.len() {
        var ext: ExternDecl = module.extern_decls.get(ed);
        var ret_c: str = c_type_from_ast(ext.ret_ty);
        var params_str: str = "";
        var p: i64 = 0;
        while p < ext.params.len() {
            var param: Param = ext.params.get(p);
            if p > 0 { params_str = params_str + ", "; }
            params_str = params_str + c_type_from_ast(param.ty) + " " + param.name;
            p = p + 1;
        }
        if ext.params.len() == 0 {
            params_str = "void";
        }

        var inc_missing: bool = false;
        // A system header (<...>) already declares the function: emit only
        // the #define rename, not a conflicting forward declaration (printf
        // is variadic in <stdio.h> but the FFI decl has fixed args).
        var is_system_include: bool = false;
        match ext.include {
            OptStr::Some(inc) => {
                inc_missing = vec_contains_str(missing_includes, inc);
                is_system_include = str_starts_with(inc, "<");
            }
            OptStr::None => {}
        }
        if !inc_missing && is_system_include && ext.pledge_name != ext.c_name {
            wln(self, "#define " + ext.pledge_name + " " + ext.c_name);
        } else if inc_missing {
            var ret_default: str = "0";
            match ext.ret_ty {
                Type::F32 => { ret_default = "0.0"; }
                Type::F64 => { ret_default = "0.0"; }
                Type::Void => { ret_default = ""; }
                _ => {}
            }
            match ext.ret_ty {
                Type::Void => {
                    wln(self, ret_c + " " + ext.pledge_name + "(" + params_str + ") { }");
                }
                _ => {
                    wln(self, ret_c + " " + ext.pledge_name + "(" + params_str + ") { return " + ret_default + "; }");
                }
            }
        } else {
            wln(self, ret_c + " " + ext.c_name + "(" + params_str + ");");
            if ext.pledge_name != ext.c_name {
                wln(self, "#define " + ext.pledge_name + " " + ext.c_name);
            }
        }
        ed = ed + 1;
    }
    wln(self, "");
}

// Trim any of the characters in `chars` from both ends of `s`.
fn str_trim_chars(s: str, chars: str) -> str {
    var start: i64 = 0;
    var len0: i64 = str_len(s);
    var end: i64 = len0;
    while start < end {
        var ch: i64 = String_byte_at(s, start);
        if str_contains_char(chars, ch) {
            start = start + 1;
        } else {
            break;
        }
    }
    while end > start {
        var ch: i64 = String_byte_at(s, end - 1);
        if str_contains_char(chars, ch) {
            end = end - 1;
        } else {
            break;
        }
    }
    return str_slice(s, start, end);
}

fn str_contains_char(chars: str, ch: i64) -> bool {
    var i: i64 = 0;
    var len: i64 = str_len(chars);
    while i < len {
        if String_byte_at(chars, i) == ch {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Convert an AST type to a C type string
pub fn cc_box_type_unbox(b: Box<Type>) -> Type {
    match b {
        Type::I8 => { return Type::I8; }
        Type::I16 => { return Type::I16; }
        Type::I32 => { return Type::I32; }
        Type::I64 => { return Type::I64; }
        Type::I128 => { return Type::I128; }
        Type::U8 => { return Type::U8; }
        Type::U16 => { return Type::U16; }
        Type::U32 => { return Type::U32; }
        Type::U64 => { return Type::U64; }
        Type::U128 => { return Type::U128; }
        Type::F32 => { return Type::F32; }
        Type::F64 => { return Type::F64; }
        Type::Bool => { return Type::Bool; }
        Type::Str => { return Type::Str; }
        Type::Void => { return Type::Void; }
        Type::Never => { return Type::Never; }
        Type::Infer => { return Type::Infer; }
        Type::Named(n) => { return Type::Named(n); }
        Type::Array(e, s) => { return Type::Array(e, s); }
        Type::ArrayConst(e, s) => { return Type::ArrayConst(e, s); }
        Type::Ref(e, m) => { return Type::Ref(e, m); }
        Type::RawPtr(e, m) => { return Type::RawPtr(e, m); }
        Type::Generic(n, a) => { return Type::Generic(n, a); }
        Type::Tuple(a) => { return Type::Tuple(a); }
        Type::Func(a, r) => { return Type::Func(a, r); }
        Type::Assoc(a, b, c, d) => { return Type::Assoc(a, b, c, d); }
        Type::Dyn(n) => { return Type::Dyn(n); }
        Type::ShapedTensor(e, d) => { return Type::ShapedTensor(e, d); }
    }
    return Type::Void;
}

fn c_type_from_ast(ty: Type) -> str {
    match ty {
        Type::I8 => { return "int8_t"; }
        Type::I16 => { return "int16_t"; }
        Type::I32 => { return "int32_t"; }
        Type::I64 => { return "int64_t"; }
        Type::I128 => { return "__int128"; }
        Type::U8 => { return "uint8_t"; }
        Type::U16 => { return "uint16_t"; }
        Type::U32 => { return "uint32_t"; }
        Type::U64 => { return "uint64_t"; }
        Type::U128 => { return "unsigned __int128"; }
        Type::F32 => { return "float"; }
        Type::F64 => { return "double"; }
        Type::Bool => { return "bool"; }
        Type::Void => { return "void"; }
        Type::Str => { return "const char*"; }
        Type::Named(n) => {
            if n == "str" { return "const char*"; }
            return n;
        }
        Type::Ref(inner, _) => { return c_type_from_ast(cc_box_type_unbox(inner)) + "*"; }
        _ => { return "void*"; }
    }
    return "void*";
}

fn emit_runtime_types(self: &mut CCodeGen) -> void {
    wln(self, "// --- Runtime types ---");
    wln(self, "typedef struct { void** data; int64_t len; int64_t cap; } PVec;");
    wln(self, "typedef struct { char** keys; int64_t* vals; int64_t len; int64_t cap; } PMap;");
    wln(self, "");
    wln(self, "// --- Runtime function declarations ---");
    wln(self, "PVec* p_vec_new(void);");
    wln(self, "void p_vec_push(PVec* v, void* val);");
    wln(self, "void* p_vec_get(PVec* v, int64_t idx);");
