    fn_param_types_set(self, "p_clock_now_ms", t0());
    fn_param_types_set(self, "p_intern_str", t1(ptr_u8()));

    // Varargs (fixed prefix only)
    fn_param_types_set(self, "p_thread_spawn", t2(ptr_u8(), IrType::I64));
    fn_param_types_set(self, "p_thread_join", t1(IrType::I64));
    fn_param_types_set(self, "p_executor_spawn", t3(IrType::I64, ptr_u8(), IrType::I64));
