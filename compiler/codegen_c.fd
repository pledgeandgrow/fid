    fn_param_types_set(self, "p_kv_cache_len", t2(IrType::I64, IrType::I64));
    fn_param_types_set(self, "p_kv_cache_clear", t1(IrType::I64));
    fn_param_types_set(self, "p_kv_cache_evict", t2(IrType::I64, IrType::I64));

    // Quantization
    fn_param_types_set(self, "p_quantize_q8", t3(ptr_u8(), IrType::F64, IrType::I64));
    fn_param_types_set(self, "p_dequantize_q8", t3(ptr_u8(), IrType::F64, IrType::I64));
    fn_param_types_set(self, "p_qmatmul", t2(ptr_u8(), ptr_u8()));
    fn_param_types_set(self, "p_find_quant_params", t1(ptr_u8()));

    // Runtime function return types - most return int64_t or void*,
    // but some return void (mutating operations).
    var void_rets: Vec<str> = Vec::new();
    void_rets.push("p_vec_push");
    void_rets.push("p_vec_clear");
    void_rets.push("p_vec_insert");
    void_rets.push("p_vec_set");
    void_rets.push("p_vec_reverse");
