// codegen_c.fd - C99 generator from Fides IR, rewritten from src/codegen_c.rs (4241 LOC)
//
// Strategy: translate IR functions to C functions, with a runtime library
// implementing p_vec_*, p_map_*, p_string_* in C. This produces portable
// native binaries via gcc/clang.
//
// Adaptations from Rust:
// 1. HashMap<K,V> - Vec-based maps with helper structs
// 2. HashSet<T> - Vec<T> with contains() helper
// 3. format! / wln! macro - direct string concatenation with int_to_str
// 4. Box<IrType> - box_ir_type_unbox helper
// 5. matches! macro - explicit match with _ => false
// 6. Option<T> - Opt* enums
// 7. String - str, u32/u64 - i64
// 8. Vec::iter() - explicit while loops with .get(i)
//
// Dependencies: compiler::ast, compiler::ir

module compiler::codegen_c;
use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::checks;
use compiler::build_info;
// --- Vec-based map entry structs ------------------------------------------
// Replace HashMap with Vec<Entry> + linear search.

// value_names: ValueId - C variable name
pub struct ValueNameEntry {
    pub id: i64,
    pub name: str,
}

pub fn ValueNameEntry_new(id: i64, name: str) -> ValueNameEntry {
    return ValueNameEntry {
        id: id, name: name
    };
}

// string_consts: original string - _strN name
pub struct StringConstEntry {
    pub key: str,
    pub val: str,
}

pub fn StringConstEntry_new(key: str, val: str) -> StringConstEntry {
    return StringConstEntry {
        key: key, val: val
    };
}

// fn_param_types: func name - Vec<IrType>
pub struct FnParamTypesEntry {
    pub key: str,
    pub types: Vec<IrType>,
}

pub fn FnParamTypesEntry_new(key: str, types: Vec<IrType>) -> FnParamTypesEntry {
    return FnParamTypesEntry {
        key: key, types: types
    };
}

// user_functions / extern_func_names: Vec<str> set
// user_fn_param_types: func name - Vec<IrType>
// fn_ret_types: func name - IrType
pub struct FnRetTypeEntry {
    pub key: str,
    pub ty: IrType,
}

pub fn FnRetTypeEntry_new(key: str, ty: IrType) -> FnRetTypeEntry {
    return FnRetTypeEntry {
        key: key, ty: ty
    };
}

// --- CCodeGen struct ------------------------------------------------------

pub struct CCodeGen {
    // Per value of the current function: 1 when a counted loop makes its check
    // needless (peir_unchecked_ops)
    pub unchecked: Vec<i64>,
    // Externs that take or return a struct by value: called through a wrapper
    pub c_wrapped: Vec<str>,
    // Accumulated C output - uses p_sb (mutable string builder) to avoid
    // O(n^2) memory blowup from string concatenation.
    pub sb: i64,
    pub out: str,
    // C variable name of each ValueId, indexed by id ("" = not named). A
    // name depends only on the id, so the table is shared by all functions.
    pub value_names: Vec<str>,
    // String constants collected from the module, in emission order
    pub string_consts: Vec<StringConstEntry>,
    // HashMap key -> 1 + index into string_consts / fn_param_types / fn_ret_types
    pub string_const_index: i64,
    pub fn_param_index: i64,
    pub fn_ret_index: i64,
    // Counter for unique labels
    pub label_counter: i64,
    // Counter for temp variables
    pub temp_counter: i64,
    // Whether the current function's C return type is void (true) or non-void (false)
    pub cur_fn_c_ret_is_void: bool,
    // The current function's C return type string
    pub cur_fn_c_ret_type: str,
    // Function parameter types, keyed by IR function name
    pub fn_param_types: Vec<FnParamTypesEntry>,
    // Set of user-defined function names
    pub user_functions: Vec<str>,
    // User function parameter types
    pub user_fn_param_types: Vec<FnParamTypesEntry>,
    // Function return types, keyed by IR function name
    pub fn_ret_types: Vec<FnRetTypeEntry>,
    // Set of user-defined extern function names (FFI)
    pub extern_func_names: Vec<str>,
    // Struct layouts for GetFieldPtr offset lookup
    pub struct_layouts: Vec<StructLayoutEntry>,
    // Name -> position in struct_layouts + 1 (D10)
    pub layout_index: i64,
}

pub fn CCodeGen_new() -> CCodeGen {
    var cg: CCodeGen = CCodeGen {
        unchecked: Vec::new(), c_wrapped: Vec::new(), sb: p_sb_new(), out: "", value_names: Vec::new(), string_consts: Vec::new(), string_const_index: HashMap_new(), fn_param_index: HashMap_new(), fn_ret_index: HashMap_new(), label_counter: 0, temp_counter: 0, cur_fn_c_ret_is_void: true, cur_fn_c_ret_type: "void", fn_param_types: Vec::new(), user_functions: Vec::new(), user_fn_param_types: Vec::new(), fn_ret_types: Vec::new(), extern_func_names: Vec::new(), struct_layouts: Vec::new(), layout_index: HashMap_new(),
    };
    CCodeGen_insert_runtime_sigs(&mut cg);
    return cg;
}

// --- -g, live functions, library builds (TL5, CE8, A9', CI7, CI6) ---------
// The driver (main.fd) sets these before CCodeGen_generate.

// -g: #line back to the .fd source (TL5) and, on a panic, the values of the
// failing frame (CE8). Off by default: the frame record is per-call work.
var g_c_dbg: bool = false;
var g_c_dbg_file_esc: str = "";
var g_c_dbg_cfile_esc: str = "";
// HashMap: the IR names of the input file's functions (they get #line)
var g_c_dbg_names: i64 = 0;
// C lines written so far (counted only with -g)
var g_c_line: i64 = 0;
// RL12: FID_C_LINE_MARKS=1 writes `/*@L<n>*/` on a line of its own before
// the C of each instruction on a new source line n, and again at each
// block's first line (scripts/nat-cov-instrument.py puts a counter after
// each mark: line coverage). 0: not read yet, 1: off, 2: on.
var g_c_line_marks: i64 = 0;

fn cg_line_marks_on() -> bool {
    if g_c_line_marks == 0 {
        var sw: str = p_getenv("FID_C_LINE_MARKS");
        g_c_line_marks = 1;
        if (sw as i64) != 0 && str_len(sw) > 0 && sw != "0" {
            g_c_line_marks = 2;
        }
    }
    return g_c_line_marks == 2;
}
// A9': the old behaviour, every function registered by name and listed in
// __p_fns (for a program that builds a function name at run time)
var g_c_register_all: bool = false;
// HashMap: the functions a run can reach (cg_compute_live)
var g_cg_live: i64 = 0;
// --lib (CI7): a shared library; its exports (HashMap), the names the
// driver added (",a,b,"), the header body written for the last module, the
// exports left out (one per line)
var g_c_lib: bool = false;
var g_c_lib_exports: i64 = 0;
var g_c_lib_extra: str = ",";
var g_c_lib_header: str = "";
var g_c_lib_skipped: str = "";

/// -g (TL5, CE8): `fd_file` is the input file and `source` its text, whose
/// functions get `#line` directives; `c_file` is the C file the driver
/// writes (where the directives hand back after each function). Every
/// function also gets the frame record that a panic prints.
pub fn set_c_debug_info(fd_file: str, source: str, c_file: str) {
    g_c_dbg = true;
    g_c_dbg_file_esc = escape_c_string(fd_file);
    g_c_dbg_cfile_esc = escape_c_string(c_file);
    g_c_dbg_names = cg_source_fn_names(source);
}

/// BG50: -g off again (`fid serve` resets it between requests).
pub fn clear_c_debug_info() {
    g_c_dbg = false;
    g_c_dbg_file_esc = "";
    g_c_dbg_cfile_esc = "";
    g_c_dbg_names = 0;
}

/// The C compiler flag -g needs (" -g", or "" without -g).
pub fn c_debug_cflags() -> str {
    if g_c_dbg {
        return " -g";
    }
    return "";
}

/// TL5: the same for cl.exe (" /Zi": a PDB for the program, which cl's
/// link step writes with /DEBUG implied; "" without -g).
pub fn c_debug_clflags() -> str {
    if g_c_dbg {
        return " /Zi";
    }
    return "";
}

/// The C file the driver writes next to `output` (main.fd's rule).
pub fn CGen_c_file_for(output: str) -> str {
    if str_ends_with(output, ".exe") {
        return str_slice(output, 0, str_len(output) - 4) + ".c";
    }
    if str_ends_with(output, ".wasm") {
        return str_slice(output, 0, str_len(output) - 5) + ".c";
    }
    return output + ".c";
}

/// A9': register every function by name and list each in __p_fns.
pub fn set_c_register_all(v: bool) {
    g_c_register_all = v;
}

/// CI7: generate a library (no C `main`; exported wrappers, fides_init and
/// fides_call). The driver then links with CGen_lib_cc_flags and writes
/// CGen_lib_header next to the library.
pub fn CGen_lib_set(on: bool) {
    g_c_lib = on;
}

/// BG50: forget the `--export` names (`fid serve` between requests).
pub fn CGen_lib_reset_exports() {
    g_c_lib_extra = ",";
}

/// CI7: export `name` as well as the `@export` functions.
pub fn CGen_lib_export(name: str) {
    g_c_lib_extra = g_c_lib_extra + name + ",";
}

/// 2g.85: the names CGen_lib_export added (`--export`), in a library
/// build: roots of the C path's reachability (compiler.fd
/// c_reach_keep_set), as `@export` functions are (they are annotated).
pub fn CGen_lib_export_names() -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if !g_c_lib {
        return out;
    }
    val parts: Vec<str> = str_split(g_c_lib_extra, ",");
    var i: i64 = 0;
    while i < parts.len() {
        if str_len(parts.get(i)) > 0 {
            out.push(parts.get(i));
        }
        i = i + 1;
    }
    return out;
}

/// CI7: the C header of the last library generated (`lib_name` names its
/// include guard).
pub fn CGen_lib_header(lib_name: str) -> str {
    var guard: str = "FIDES_" + cg_c_ident_upper(lib_name) + "_H";
    return "#ifndef " + guard + "\n#define " + guard + "\n" + g_c_lib_header + "#endif /* " + guard + " */\n";
}

/// CI7: the functions marked for export that have no C form, one per line
/// with the reason ("" when none).
pub fn CGen_lib_skipped() -> str {
    return g_c_lib_skipped;
}

/// CI7: the C compiler flags of a shared library for target OS `os`
/// ("windows", "macos", else ELF).
pub fn CGen_lib_cc_flags(os: str) -> str {
    if os == "windows" {
        return " -shared";
    }
    if os == "macos" {
        return " -dynamiclib -fPIC";
    }
    return " -shared -fPIC";
}

/// CI7: the file name of library `name` for target OS `os`.
pub fn CGen_lib_file_name(name: str, os: str) -> str {
    if os == "windows" {
        return name + ".dll";
    }
    if os == "macos" {
        return "lib" + name + ".dylib";
    }
    return "lib" + name + ".so";
}

fn cg_c_ident_upper(s: str) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c >= 97 && c <= 122 {
            out = out + char_to_str(c - 32);
        } else if (c >= 65 && c <= 90) || (c >= 48 && c <= 57) {
            out = out + char_to_str(c);
        } else {
            out = out + "_";
        }
        i = i + 1;
    }
    return out;
}

fn cg_count_newlines(s: str) -> i64 {
    if !str_contains(s, "\n") {
        return 0;
    }
    var n: i64 = 0;
    var i: i64 = 0;
    var len: i64 = str_len(s);
    while i < len {
        if str_byte_at(s, i) == 10 {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

// --- Output helpers -------------------------------------------------------
// Replaces the Rust wln! macro. All appends end with a newline.

fn wln(self: &mut CCodeGen, s: str) -> void {
    // Use mutable string builder to avoid O(n^2) memory blowup.
    p_sb_append(self.sb, s);
    p_sb_append(self.sb, "\n");
    // -g: the C line count, for the #line that hands back to the C file
    if g_c_dbg {
        g_c_line = g_c_line + 1 + cg_count_newlines(s);
    }
}

// --- TL5: #line to the .fd source; CE8: the failing frame's values ---------

fn cg_is_ident_byte(c: i64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
}

/// The functions `src` defines, by their IR names: `fn f` at the top is
/// `f`; a method `fn m` of `impl T` or `impl Tr for T` is `T_m`. Comments,
/// strings and character literals are skipped (a lifetime `'a` is not a
/// character literal).
fn cg_source_fn_names(src: str) -> i64 {
    var names: i64 = HashMap_new();
    var n: i64 = str_len(src);
    var i: i64 = 0;
    var depth: i64 = 0;
    var impl_ty: str = "";
    var impl_depth: i64 = -1;
    var want_impl: bool = false;
    var impl_first: str = "";
    var impl_for_ty: str = "";
    var impl_after_for: bool = false;
    var angle: i64 = 0;
    var want_fn: bool = false;
    while i < n {
        var c: i64 = str_byte_at(src, i);
        var c1: i64 = 0;
        if i + 1 < n {
            c1 = str_byte_at(src, i + 1);
        }
        if c == 47 && c1 == 47 {
            while i < n && str_byte_at(src, i) != 10 {
                i = i + 1;
            }
            continue;
        }
        if c == 47 && c1 == 42 {
            i = i + 2;
            while i + 1 < n && (str_byte_at(src, i) != 42 || str_byte_at(src, i + 1) != 47) {
                i = i + 1;
            }
            i = i + 2;
            continue;
        }
        if c == 34 {
            i = i + 1;
            while i < n && str_byte_at(src, i) != 34 {
                if str_byte_at(src, i) == 92 {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        if c == 39 {
            if i + 2 < n && c1 != 92 && str_byte_at(src, i + 2) == 39 {
                i = i + 3;
                continue;
            }
            if i + 3 < n && c1 == 92 && str_byte_at(src, i + 3) == 39 {
                i = i + 4;
                continue;
            }
            i = i + 1;
            continue;
        }
        if c == 123 {
            if want_impl {
                want_impl = false;
                impl_ty = impl_first;
                if str_len(impl_for_ty) > 0 {
                    impl_ty = impl_for_ty;
                }
                impl_depth = depth;
            }
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == 125 {
            depth = depth - 1;
            if depth == impl_depth {
                impl_ty = "";
                impl_depth = -1;
            }
            i = i + 1;
            continue;
        }
        if want_impl && c == 60 {
            angle = angle + 1;
        }
        if want_impl && c == 62 {
            angle = angle - 1;
        }
        if want_impl && c == 59 {
            want_impl = false;
        }
        if cg_is_ident_byte(c) && (c < 48 || c > 57) {
            var st: i64 = i;
            while i < n && cg_is_ident_byte(str_byte_at(src, i)) {
                i = i + 1;
            }
            var w: str = str_slice(src, st, i);
            if want_fn {
                want_fn = false;
                if str_len(impl_ty) > 0 && depth == impl_depth + 1 {
                    HashMap_insert(names, impl_ty + "_" + w, 1);
                } else if depth == 0 {
                    HashMap_insert(names, w, 1);
                }
            } else if w == "fn" {
                // `fn(i64) -> i64` is a type, not a definition
                var q: i64 = i;
                while q < n && (str_byte_at(src, q) == 32 || str_byte_at(src, q) == 9) {
                    q = q + 1;
                }
                want_fn = q < n && str_byte_at(src, q) != 40;
            } else if w == "impl" && depth == 0 {
                want_impl = true;
                impl_first = "";
                impl_for_ty = "";
                impl_after_for = false;
                angle = 0;
            } else if want_impl && angle == 0 {
                if w == "for" {
                    impl_after_for = true;
                } else if impl_after_for {
                    if str_len(impl_for_ty) == 0 {
                        impl_for_ty = w;
                    }
                } else if str_len(impl_first) == 0 {
                    impl_first = w;
                }
            }
            continue;
        }
        i = i + 1;
    }
    return names;
}

/// TL5: whether function `name` gets #line directives.
fn cg_lines_for(name: str) -> bool {
    if !g_c_dbg || g_c_dbg_names == 0 {
        return false;
    }
    return HashMap_contains(g_c_dbg_names, name);
}

/// TL5: the .fd file (escaped for a C string) that function `name`'s
/// `#line` directives name, or "" (no directives): the input file for its
/// own functions, and for a function of an imported module the file the
/// import loops recorded it from (compiler.fd ir_note_program_files, ir.fd
/// ir_fn_file; the stdlib's modules too), core's and the runtime's
/// functions the file they were parsed from (compiler.fd
/// ir_note_lib_program), and a monomorphized instance or a clone the file
/// of the function it was made from (ir.fd ir_fn_src_file). A
/// compiler-made `__name` has no file: no directives.
fn cg_lines_file_for(name: str) -> str {
    if !g_c_dbg {
        return "";
    }
    if cg_lines_for(name) {
        return g_c_dbg_file_esc;
    }
    var path: str = ir_fn_src_file(name);
    if str_len(path) == 0 {
        return "";
    }
    return escape_c_string(path);
}

/// The source line of instruction `id` (0: none).
fn cg_inst_line(func: IrFunction, id: i64) -> i64 {
    if id >= 0 && id < func.value_metas.len() {
        var vm: ValueIdMeta = func.value_metas.get(id);
        if vm.id == id {
            match vm.meta.source_line {
                OptU64::Some(ln) => {
                    return ln as i64;
                }
                OptU64::None => {
                }
            }
        }
    }
    return 0;
}

fn cg_is_call(it: Inst) -> bool {
    match it {
        Inst::Call(_, _, _, _) => {
            return true;
        }
        Inst::DynCall(_, _, _, _, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// CE8: how the frame printer reads a value of `ty` ("" = not a word it
/// prints): i/u 64-bit, 4/U 32, 2/w 16, 1/c 8, b bool, d f64, f f32, s str.
fn cg_dbg_kind(ty: IrType) -> str {
    match ty {
        IrType::I64 => {
            return "i";
        }
        IrType::U64 => {
            return "u";
        }
        IrType::I32 => {
            return "4";
        }
        IrType::U32 => {
            return "U";
        }
        IrType::I16 => {
            return "2";
        }
        IrType::U16 => {
            return "w";
        }
        IrType::I8 => {
            return "1";
        }
        IrType::U8 => {
            return "c";
        }
        IrType::Bool => {
            return "b";
        }
        IrType::F64 => {
            return "d";
        }
        IrType::F32 => {
            return "f";
        }
        IrType::Ptr(inner) => {
            match cc_box_ir_type_unbox(inner) {
                IrType::U8 => {
                    return "s";
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return "";
}

/// The type of parameter `id` of `func` (a parameter has no instruction:
/// its type is in func.params).
fn cg_param_ty(func: IrFunction, id: i64) -> IrType {
    var i: i64 = 0;
    while i < func.params.len() {
        if func.params.get(i).id == id {
            return func.params.get(i).ty;
        }
        i = i + 1;
    }
    return IrType::Void;
}

/// CE8: the frame record of `name` (-g): the names, kinds and addresses of
/// its word-sized parameters and locals (the last binding of each name),
/// made current at entry and again after each call returns.
fn cg_dbg_prologue(self: &mut CCodeGen, name: str, func: IrFunction) {
    var seen: i64 = HashMap_new();
    var names: Vec<str> = Vec::new();
    var kinds: Vec<str> = Vec::new();
    var addrs: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < func.locals.len() {
        var lv: StringValueId = func.locals.get(i);
        i = i + 1;
        if str_len(lv.name) == 0 || str_starts_with(lv.name, "__") {
            continue;
        }
        var vid: i64 = lv.id;
        var kind: str = "";
        var addr: str = "";
        if params_contains_id(func, vid) {
            kind = cg_dbg_kind(cg_param_ty(func, vid));
            addr = "(void*)&" + val_name(self, vid);
        } else {
            match find_inst(func.insts, vid) {
                OptInst::Some(li) => {
                    match li {
                        Inst::Alloca(aty, _) => {
                            // the slot (bound at entry): the value is in it
                            kind = cg_dbg_kind(aty);
                            addr = "(void*)" + val_name(self, vid);
                        }
                        _ => {
                            kind = cg_dbg_kind(value_ty_for_id(func, vid));
                            addr = "(void*)&" + val_name(self, vid);
                        }
                    }
                }
                OptInst::None => {
                }
            }
        }
        if str_len(kind) == 0 {
            continue;
        }
        var at: i64 = HashMap_get(seen, lv.name);
        if at > 0 {
            kinds.set(at - 1, kind);
            addrs.set(at - 1, addr);
        } else if names.len() < 32 {
            names.push(lv.name);
            kinds.push(kind);
            addrs.push(addr);
            HashMap_insert(seen, lv.name, names.len());
        }
    }
    HashMap_drop(seen);
    var k: i64 = names.len();
    var size: str = int_to_str(k);
    if k == 0 {
        size = "1";
    }
    var nlist: str = "";
    var kstr: str = "";
    var j: i64 = 0;
    while j < k {
        if j > 0 {
            nlist = nlist + ", ";
        }
        nlist = nlist + "\"" + escape_c_string(names.get(j)) + "\"";
        kstr = kstr + kinds.get(j);
        j = j + 1;
    }
    if k == 0 {
        nlist = "0";
    }
    wln(self, "    static const char* const __p_dn[" + size + "] = { " + nlist + " };");
    wln(self, "    static const char __p_dk[] = \"" + kstr + "\";");
    wln(self, "    void* __p_da[" + size + "];");
    j = 0;
    while j < k {
        wln(self, "    __p_da[" + int_to_str(j) + "] = " + addrs.get(j) + ";");
        j = j + 1;
    }
    if k == 0 {
        wln(self, "    __p_da[0] = 0;");
    }
    wln(self, "    __p_dbg_frame __p_df = { P_DBG_MAGIC, \"" + escape_c_string(name) + "\", " + int_to_str(k) + ", __p_dn, __p_dk, (void* const*)__p_da, 0 };");
    wln(self, "    __p_df.self = &__p_df;");
    wln(self, "    __p_dbg_cur = &__p_df;");
}

/// CE8: the current frame record and its printer (-g only).
fn emit_debug_frames_impl(self: &mut CCodeGen) {
    wln(self, "#ifdef P_DEBUG_FRAMES");
    wln(self, "P_THREAD_LOCAL __p_dbg_frame* __p_dbg_cur = NULL;");
    wln(self, "/* The values of the failing frame: the Fides function that ran last (its");
    wln(self, "   record is made current at entry and after each call returns). */");
    wln(self, "static void __p_dbg_print_frame(void) {");
    wln(self, "    __p_dbg_frame* f = __p_dbg_cur;");
    wln(self, "    if (!f || f->magic != P_DBG_MAGIC || f->self != f) return;");
    wln(self, "    fprintf(stderr, \"values in %s:\\n\", f->fn);");
    wln(self, "    if (f->n == 0) fprintf(stderr, \"    (no word-sized parameters or locals)\\n\");");
    wln(self, "    for (int i = 0; i < f->n; i++) {");
    wln(self, "        const void* a = f->addrs[i];");
    wln(self, "        const char* nm = f->names[i];");
    wln(self, "        if (!a || !nm) continue;");
    wln(self, "        switch (f->kinds[i]) {");
    wln(self, "        case 'i': fprintf(stderr, \"    %s = %lld\\n\", nm, (long long)*(const int64_t*)a); break;");
    wln(self, "        case 'u': fprintf(stderr, \"    %s = %llu\\n\", nm, (unsigned long long)*(const uint64_t*)a); break;");
    wln(self, "        case '4': fprintf(stderr, \"    %s = %d\\n\", nm, (int)*(const int32_t*)a); break;");
    wln(self, "        case 'U': fprintf(stderr, \"    %s = %u\\n\", nm, (unsigned)*(const uint32_t*)a); break;");
    wln(self, "        case '2': fprintf(stderr, \"    %s = %d\\n\", nm, (int)*(const int16_t*)a); break;");
    wln(self, "        case 'w': fprintf(stderr, \"    %s = %u\\n\", nm, (unsigned)*(const uint16_t*)a); break;");
    wln(self, "        case '1': fprintf(stderr, \"    %s = %d\\n\", nm, (int)*(const int8_t*)a); break;");
    wln(self, "        case 'c': fprintf(stderr, \"    %s = %u\\n\", nm, (unsigned)*(const uint8_t*)a); break;");
    wln(self, "        case 'b': fprintf(stderr, \"    %s = %s\\n\", nm, *(const bool*)a ? \"true\" : \"false\"); break;");
    wln(self, "        case 'd': fprintf(stderr, \"    %s = %g\\n\", nm, *(const double*)a); break;");
    wln(self, "        case 'f': fprintf(stderr, \"    %s = %g\\n\", nm, (double)*(const float*)a); break;");
    wln(self, "        case 's': {");
    wln(self, "            const char* s = *(const char* const*)a;");
    wln(self, "            int64_t l = s ? p_str_hdr_c(s) : -1;");
    wln(self, "            if (!s) fprintf(stderr, \"    %s = (null)\\n\", nm);");
    wln(self, "            else if (l < 0) fprintf(stderr, \"    %s = <pointer %p>\\n\", nm, (const void*)s);");
    wln(self, "            else fprintf(stderr, \"    %s = \\\"%.*s\\\"%s\\n\", nm, (int)(l > 60 ? 60 : l), s, l > 60 ? \"...\" : \"\");");
    wln(self, "            break;");
    wln(self, "        }");
    wln(self, "        default: break;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "#endif");
}

// --- C type helpers -------------------------------------------------------

pub fn c_type(ty: IrType) -> str {
    match ty {
        IrType::I8 => {
            return "int8_t";
        }
        IrType::I16 => {
            return "int16_t";
        }
        IrType::I32 => {
            return "int32_t";
        }
        IrType::I64 => {
            return "int64_t";
        }
        IrType::U8 => {
            return "uint8_t";
        }
        IrType::U16 => {
            return "uint16_t";
        }
        IrType::U32 => {
            return "uint32_t";
        }
        IrType::U64 => {
            return "uint64_t";
        }
        IrType::F32 => {
            return "float";
        }
        IrType::F64 => {
            return "double";
        }
        IrType::Bool => {
            return "bool";
        }
        IrType::Ptr(_) => {
            return "void*";
        }
        IrType::Struct(name) => {
            return "struct " + name + "_s*";
        }
        IrType::Array(elem, size) => {
            return c_type(cc_box_ir_type_unbox(elem)) + "[" + int_to_str(size) + "]";
        }
        IrType::Void => {
            return "void";
        }
        IrType::Never => {
            return "void";
        }
        IrType::Opaque(name) => {
            if name == "String" {
                return "const char*";
            }
            if name == "Vec" || name == "HashMap" {
                return "void*";
            }
            return "void*";
        }
        IrType::Generic(name, _) => {
            if name == "String" {
                return "const char*";
            }
            if name == "Vec" || name == "HashMap" {
                return "void*";
            }
            return "void*";
        }
    }
    return "void";
}

// Like c_type but returns value type (not pointer) for structs.
// Used for global variable declarations which need inline struct storage.
pub fn c_type_global(ty: IrType) -> str {
    match ty {
        IrType::I8 => {
            return "int8_t";
        }
        IrType::I16 => {
            return "int16_t";
        }
        IrType::I32 => {
            return "int32_t";
        }
        IrType::I64 => {
            return "int64_t";
        }
        IrType::U8 => {
            return "uint8_t";
        }
        IrType::U16 => {
            return "uint16_t";
        }
        IrType::U32 => {
            return "uint32_t";
        }
        IrType::U64 => {
            return "uint64_t";
        }
        IrType::F32 => {
            return "float";
        }
        IrType::F64 => {
            return "double";
        }
        IrType::Bool => {
            return "bool";
        }
        IrType::Ptr(_) => {
            return "void*";
        }
        IrType::Struct(name) => {
            return "struct " + name + "_s";
        }
        IrType::Array(elem, size) => {
            return c_type_global(cc_box_ir_type_unbox(elem)) + "[" + int_to_str(size) + "]";
        }
        IrType::Void => {
            return "void";
        }
        IrType::Never => {
            return "void";
        }
        IrType::Opaque(name) => {
            if name == "String" {
                return "const char*";
            }
            if name == "Vec" || name == "HashMap" {
                return "void*";
            }
            return "void*";
        }
        IrType::Generic(name, _) => {
            if name == "String" {
                return "const char*";
            }
            if name == "Vec" || name == "HashMap" {
                return "void*";
            }
            return "void*";
        }
    }
    return "void";
}

// Box<IrType> unbox helper
pub fn cc_box_ir_type_unbox(b: Box<IrType>) -> IrType {
    match b {
        IrType::I8 => {
            return IrType::I8;
        }
        IrType::I16 => {
            return IrType::I16;
        }
        IrType::I32 => {
            return IrType::I32;
        }
        IrType::I64 => {
            return IrType::I64;
        }
        IrType::U8 => {
            return IrType::U8;
        }
        IrType::U16 => {
            return IrType::U16;
        }
        IrType::U32 => {
            return IrType::U32;
        }
        IrType::U64 => {
            return IrType::U64;
        }
        IrType::F32 => {
            return IrType::F32;
        }
        IrType::F64 => {
            return IrType::F64;
        }
        IrType::Bool => {
            return IrType::Bool;
        }
        IrType::Ptr(inner) => {
            return IrType::Ptr(inner);
        }
        IrType::Struct(name) => {
            return IrType::Struct(name);
        }
        IrType::Array(elem, size) => {
            return IrType::Array(elem, size);
        }
        IrType::Void => {
            return IrType::Void;
        }
        IrType::Never => {
            return IrType::Never;
        }
        IrType::Opaque(name) => {
            return IrType::Opaque(name);
        }
        IrType::Generic(name, args) => {
            return IrType::Generic(name, args);
        }
    }
    return IrType::Void;
}

// Format a C parameter declaration with the variable name in the right position.
fn c_param_decl(ty: IrType, name: str) -> str {
    match ty {
        IrType::Array(elem, size) => {
            return c_type(cc_box_ir_type_unbox(elem)) + " " + name + "[" + int_to_str(size) + "]";
        }
        _ => {
            return c_type(ty) + " " + name;
        }
    }
}

// Returns true if the type uses the out-parameter calling convention.
fn is_aggregate_ret(ty: IrType) -> bool {
    match ty {
        IrType::Struct(_) => {
            return true;
        }
        IrType::Array(_, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

// C return type for a function - aggregate types are `void` because the
// result is returned via a hidden out-parameter (first function argument).
fn c_ret_type(ty: IrType) -> str {
    if is_aggregate_ret(ty) {
        return "void";
    }
    return c_type(ty);
}

fn is_ptr_type(ty: IrType) -> bool {
    match ty {
        IrType::Ptr(_) => {
            return true;
        }
        IrType::Opaque(_) => {
            return true;
        }
        IrType::Generic(_, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

fn is_float_type(ty: IrType) -> bool {
    match ty {
        IrType::F32 => {
            return true;
        }
        IrType::F64 => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

fn is_int_type(ty: IrType) -> bool {
    match ty {
        IrType::I64 => {
            return true;
        }
        IrType::I32 => {
            return true;
        }
        IrType::I16 => {
            return true;
        }
        IrType::I8 => {
            return true;
        }
        IrType::Bool => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

fn is_void_or_never(ty: IrType) -> bool {
    match ty {
        IrType::Void => {
            return true;
        }
        IrType::Never => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

// Cast a call argument from its IR type to the called function's parameter type.
fn cast_arg(val: str, from: IrType, to: IrType) -> str {
    var from_is_ptr: bool = is_ptr_type(from);
    var from_is_float: bool = is_float_type(from);
    var to_is_ptr: bool = is_ptr_type(to);

    var to_is_array: bool = false;
    var to_array_elem: IrType = IrType::Void;
    match to {
        IrType::Array(elem, _) => {
            to_is_array = true;
            to_array_elem = cc_box_ir_type_unbox(elem);
        }
        _ => {
        }
    }
    var to_is_struct: bool = is_aggregate_ret(to);
    var to_is_int: bool = is_int_type(to);

    // Ptr(arg) -> Generic(param): the arg is a reference/slot but the callee
    // expects the handle value (e.g. `Vec<T>` params promoted to by-ref when
    // mutated, then forwarded to a by-value `Vec` param). Emit the pointee so
    // the callee sees the Vec header, not the slot.
    var to_is_handle: bool = false;
    match to {
        IrType::Generic(_, _) => {
            to_is_handle = true;
        }
        IrType::Opaque(_) => {
            to_is_handle = true;
        }
        _ => {
        }
    }
    var from_is_ptr_to_handle: bool = false;
    match from {
        IrType::Ptr(inner) => {
            if ir_type_eq(inner, to) {
                from_is_ptr_to_handle = true;
            }
        }
        _ => {
        }
    }
    if from_is_ptr_to_handle && to_is_handle {
        return "*(void**)" + val;
    }

    // Array params decay to pointers in C - cast to element pointer type
    if to_is_array {
        return "(" + c_type(to_array_elem) + "*)" + val;
    }

    if !from_is_ptr && to_is_ptr && from_is_float {
        // float - pointer: use type punning via union
        return "((union { double d; void* p; }){ .d = " + val + " }).p";
    }
    if !from_is_ptr && !to_is_ptr && from_is_float && to_is_int {
        // float - int: use type punning via union
        return "((union { double d; int64_t i; }){ .d = " + val + " }).i";
    }
    if !from_is_ptr && to_is_ptr {
        // int - pointer: cast to void*
        return "(void*)" + val;
    }
    if from_is_ptr && !to_is_ptr {
        // pointer - int: cast to int64_t
        return "(int64_t)" + val;
    }
    if !from_is_ptr && !to_is_ptr && to_is_struct {
        // pointer - struct pointer (out-param): cast to void*
        return "(void*)" + val;
    }
    return val;
}

// --- sanitize_c_name ------------------------------------------------------
// Renames Fides functions that collide with C keywords or C runtime names.

// ─── Inline assembly (competitive LG13) ─────────────────────────────────────
// asm!("tpl", in("reg") a, out("reg") r, clobber("reg")) becomes GNU inline
// assembly: each operand a local register variable (`register int64_t x
// __asm__("rcx")`), the template in Intel syntax on x86-64 (as pe_ir's and
// nat_ir's encoders read it) and as written on other targets, `;` between
// instructions. The first out register is the value of the expression.
// tcc and cl.exe have no GNU asm: the program panics there.

/// The template as a C string literal body: `\` and `"` escaped, `%` doubled
/// (extended asm reads `%` as an operand), `;` a new line.
fn cg_asm_text(t: str) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < str_len(t) {
        val c: i64 = str_byte_at(t, i);
        if c == 92 {
            out = out + "\\\\";
        } else if c == 34 {
            out = out + "\\\"";
        } else if c == 37 {
            out = out + "%%";
        } else if c == 59 || c == 10 {
            out = out + "\\n\\t";
        } else {
            out = out + byte_to_str(c);
        }
        i = i + 1;
    }
    return out;
}

/// A template with an instruction a normal process may not run (as pe_ir's
/// pe_asm_privileged decides for the native back ends): hlt, cli, sti, port
/// I/O, descriptor tables, MSRs, swapgs, iret/sysret, int, control and debug
/// registers; on AArch64 and RISC-V msr, eret, wfi, hvc, smc, csr writes.
fn cg_asm_privileged(t: str) -> bool {
    var s: str = str_to_lower(t);
    var i: i64 = 0;
    var n: i64 = str_len(s);
    while i < n {
        // one instruction: up to `;` or a new line
        var j: i64 = i;
        while j < n && str_byte_at(s, j) != 59 && str_byte_at(s, j) != 10 {
            j = j + 1;
        }
        val ins: str = str_trim(str_slice(s, i, j));
        var sp: i64 = 0;
        while sp < str_len(ins) && str_byte_at(ins, sp) != 32 && str_byte_at(ins, sp) != 9 {
            sp = sp + 1;
        }
        val m: str = str_slice(ins, 0, sp);
        if m == "hlt" || m == "cli" || m == "sti" || m == "in" || m == "out" || m == "ins" || m == "outs" || m == "insb" || m == "outsb" || m == "lgdt" || m == "lidt" || m == "lldt" || m == "ltr" || m == "rdmsr" || m == "wrmsr" || m == "swapgs" || m == "iret" || m == "iretq" || m == "sysret" || m == "sysretq" || m == "invlpg" || m == "wbinvd" || m == "int" || m == "int3" || m == "msr" || m == "eret" || m == "wfi" || m == "hvc" || m == "smc" || m == "csrw" || m == "csrs" || m == "csrc" || m == "mret" || m == "sret" {
            return true;
        }
        if str_contains(ins, "cr0") || str_contains(ins, "cr2") || str_contains(ins, "cr3") || str_contains(ins, "cr4") || str_contains(ins, "cr8") || str_contains(ins, " dr") || str_contains(ins, ",dr") {
            return true;
        }
        i = j + 1;
    }
    return false;
}

/// The clobber name of a register token of a template (lower case), or ""
/// when it is not a general or vector register the C compiler may be told
/// about. x86-64 sub-registers name their 64-bit register; AArch64 w/x
/// name x, b/h/s/d/q name v; RISC-V ABI names stay. The stack and frame
/// pointers (and RISC-V ra/gp/tp, AArch64 x18) are left out: a C compiler
/// refuses them as clobbers.
fn cg_asm_reg_clobber(w: str, arch: i64) -> str {
    val n: i64 = str_len(w);
    if n < 2 || n > 5 {
        return "";
    }
    if arch == 0 {
        return cg_asm_x64_clobber(w, n);
    }
    return cg_asm_risc_clobber(w, n, arch);
}

fn cg_asm_x64_clobber(w: str, n: i64) -> str {
    if w == "rax" || w == "eax" || w == "ax" || w == "al" || w == "ah" {
        return "rax";
    }
    if w == "rbx" || w == "ebx" || w == "bx" || w == "bl" || w == "bh" {
        return "rbx";
    }
    if w == "rcx" || w == "ecx" || w == "cx" || w == "cl" || w == "ch" {
        return "rcx";
    }
    if w == "rdx" || w == "edx" || w == "dx" || w == "dl" || w == "dh" {
        return "rdx";
    }
    if w == "rsi" || w == "esi" || w == "si" || w == "sil" {
        return "rsi";
    }
    if w == "rdi" || w == "edi" || w == "di" || w == "dil" {
        return "rdi";
    }
    val c0: i64 = str_byte_at(w, 0);
    var digits_end: i64 = 1;
    while digits_end < n && str_byte_at(w, digits_end) >= 48 && str_byte_at(w, digits_end) <= 57 {
        digits_end = digits_end + 1;
    }
    if digits_end == 1 {
        if str_starts_with(w, "xmm") || str_starts_with(w, "ymm") {
            var k: i64 = 3;
            while k < n && str_byte_at(w, k) >= 48 && str_byte_at(w, k) <= 57 {
                k = k + 1;
            }
            if k == n && n > 3 {
                return "xmm" + str_slice(w, 3, n);
            }
        }
        return "";
    }
    val num: i64 = str_parse_int(str_slice(w, 1, digits_end));
    val rest: str = str_slice(w, digits_end, n);
    // r8..r15 and r8d/r8w/r8b
    if c0 == 114 && num >= 8 && num <= 15 && (rest == "" || rest == "d" || rest == "w" || rest == "b") {
        return "r" + int_to_str(num);
    }
    return "";
}

/// AArch64 (arch 1) and RISC-V (arch 2) register tokens.
fn cg_asm_risc_clobber(w: str, n: i64, arch: i64) -> str {
    val c0: i64 = str_byte_at(w, 0);
    var digits_end: i64 = 1;
    while digits_end < n && str_byte_at(w, digits_end) >= 48 && str_byte_at(w, digits_end) <= 57 {
        digits_end = digits_end + 1;
    }
    if digits_end == 1 || digits_end != n {
        return "";
    }
    val num: i64 = str_parse_int(str_slice(w, 1, n));
    if arch == 2 {
        // RISC-V ABI names: a0-a7, t0-t6, s1-s11 (s0 is the frame pointer)
        if c0 == 97 && num <= 7 {
            return w;
        }
        if c0 == 116 && num <= 6 {
            return w;
        }
        if c0 == 115 && num >= 1 && num <= 11 {
            return w;
        }
        return "";
    }
    // AArch64 x0..x28 / w0..w28 (x18 is the platform register; x29 fp, x30 lr)
    if (c0 == 120 || c0 == 119) && num <= 30 {
        if num == 18 || num == 29 {
            return "";
        }
        return "x" + int_to_str(num);
    }
    // AArch64 vector registers
    if (c0 == 118 || c0 == 113 || c0 == 100 || c0 == 98 || c0 == 104) && num <= 31 {
        return "v" + int_to_str(num);
    }
    return "";
}

/// Every register the template names that is not one of its operands, as
/// clobbers, so the C compiler keeps nothing in it across the asm (the
/// native back ends save the callee-saved registers around a template; a
/// template that writes rbx without saying so must not break C either).
fn cg_asm_named_clobbers(t: str, operands: Vec<str>, already: str, arch: i64) -> str {
    var out: str = "";
    var seen: str = already;
    val s: str = str_to_lower(t);
    val n: i64 = str_len(s);
    var i: i64 = 0;
    while i < n {
        var j: i64 = i;
        while j < n && ((str_byte_at(s, j) >= 97 && str_byte_at(s, j) <= 122) || (str_byte_at(s, j) >= 48 && str_byte_at(s, j) <= 57)) {
            j = j + 1;
        }
        if j > i {
            val reg: str = cg_asm_reg_clobber(str_slice(s, i, j), arch);
            if reg != "" {
                var is_op: bool = false;
                var k: i64 = 0;
                while k < operands.len() {
                    if cg_asm_reg_clobber(str_to_lower(operands.get(k)), arch) == reg {
                        is_op = true;
                    }
                    k = k + 1;
                }
                val key: str = "\"" + reg + "\"";
                if !is_op && !str_contains(seen, key) {
                    out = out + ", " + key;
                    seen = seen + key;
                }
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    return out;
}

fn CCodeGen_gen_asm(self: &mut CCodeGen, dst: str, template: str, inputs: Vec<StringValueId>, outputs: Vec<StringValueId>, ret_ty: IrType) {
    // a privileged instruction gives 0 in a process, as natively
    if cg_asm_privileged(template) {
        wln(self, "    /* asm (privileged, not run in a process): " + cg_asm_text(template) + " */");
        match ret_ty {
            IrType::Void => {
            }
            _ => {
                wln(self, "    " + dst + " = 0LL;");
            }
        }
        return;
    }
    var out_reg: str = "";
    if outputs.len() > 0 {
        out_reg = outputs.get(0).name;
    }
    wln(self, "    {");
    wln(self, "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__TINYC__)");
    var in_list: str = "";
    var clob: str = "\"memory\", \"cc\"";
    var out_is_input: bool = false;
    var k: i64 = 0;
    while k < inputs.len() {
        val op: StringValueId = inputs.get(k);
        if str_starts_with(op.name, "CL:") {
            val cr: str = str_slice(op.name, 3, str_len(op.name));
            clob = clob + ", \"" + cr + "\"";
        } else if op.name == out_reg {
            // the out register starts with this input: one "+r" operand
            wln(self, "        register int64_t __fa_o __asm__(\"" + op.name + "\") = (int64_t)(" + val_name(self, op.id) + ");");
            out_is_input = true;
        } else {
            wln(self, "        register int64_t __fa_i" + int_to_str(k) + " __asm__(\"" + op.name + "\") = (int64_t)(" + val_name(self, op.id) + ");");
            if str_len(in_list) > 0 {
                in_list = in_list + ", ";
            }
            in_list = in_list + "\"r\"(__fa_i" + int_to_str(k) + ")";
        }
        k = k + 1;
    }
    var out_list: str = "";
    if out_reg != "" {
        if !out_is_input {
            // an output that is not an input starts at 0, as on the
            // interpreter and the native back ends
            wln(self, "        register int64_t __fa_o __asm__(\"" + out_reg + "\") = 0;");
        }
        out_list = "\"+r\"(__fa_o)";
    }
    var opnames: Vec<str> = Vec::new();
    var q: i64 = 0;
    while q < inputs.len() {
        if !str_starts_with(inputs.get(q).name, "CL:") {
            opnames.push(inputs.get(q).name);
        }
        q = q + 1;
    }
    if out_reg != "" {
        opnames.push(out_reg);
    }
    wln(self, "        __asm__ volatile(");
    wln(self, "#if defined(__x86_64__)");
    wln(self, "            \".intel_syntax noprefix\\n\\t\"");
    wln(self, "#endif");
    wln(self, "            \"" + cg_asm_text(template) + "\"");
    wln(self, "#if defined(__x86_64__)");
    wln(self, "            \"\\n\\t.att_syntax prefix\"");
    wln(self, "#endif");
    wln(self, "            : " + out_list + " : " + in_list + " : " + clob);
    // registers the template names: per target (`bl` is a register on
    // x86-64 and a branch on AArch64)
    wln(self, "#if defined(__x86_64__)");
    wln(self, "            " + cg_asm_named_clobbers(template, opnames, clob, 0));
    wln(self, "#elif defined(__aarch64__)");
    wln(self, "            " + cg_asm_named_clobbers(template, opnames, clob, 1));
    wln(self, "#elif defined(__riscv)");
    wln(self, "            " + cg_asm_named_clobbers(template, opnames, clob, 2));
    wln(self, "#endif");
    wln(self, "            );");
    match ret_ty {
        IrType::Void => {
        }
        _ => {
            if out_reg != "" {
                wln(self, "        " + dst + " = __fa_o;");
            } else {
                wln(self, "        " + dst + " = 0LL;");
            }
        }
    }
    wln(self, "#else");
    wln(self, "        p_panic(\"asm! needs gcc, clang or zig cc (this C compiler has no GNU inline assembly)\");");
    wln(self, "#endif");
    wln(self, "    }");
}

fn sanitize_c_name(self: &CCodeGen, name: str) -> str {
    if vec_contains_str(self.c_wrapped, name) {
        return "__c_wrap_" + name;
    }
    // Don't sanitize user-defined extern function names (FFI)
    if vec_contains_str(self.extern_func_names, name) {
        return name;
    }
    // Exact-name collisions
    if name == "main" {
        return "main_entry";
    }
    if name == "abs" {
        return "p_abs";
    }
    if name == "max" {
        return "p_max";
    }
    if name == "min" {
        return "p_min";
    }
    if name == "div" {
        return "p_div";
    }
    if name == "exit" {
        return "p_exit";
    }
    if name == "remove" {
        return "p_remove_user";
    }
    if name == "printf" {
        return "p_printf";
    }
    if name == "malloc" {
        return "p_malloc_user";
    }
    if name == "free" {
        return "p_free_user";
    }
    if name == "calloc" {
        return "p_calloc_user";
    }
    if name == "realloc" {
        return "p_realloc_user";
    }
    if name == "memcpy" {
        return "p_memcpy_user";
    }
    if name == "memset" {
        return "p_memset_user";
    }
    if name == "strlen" {
        return "p_strlen_user";
    }
    if name == "strcmp" {
        return "p_strcmp_user";
    }
    if name == "strcpy" {
        return "p_strcpy_user";
    }
    if name == "strcat" {
        return "p_strcat_user";
    }
    if name == "rand" {
        return "p_rand_user";
    }
    if name == "srand" {
        return "p_srand_user";
    }
    if name == "time" {
        return "p_time_user";
    }
    if name == "clock" {
        return "p_clock_user";
    }
    if name == "sin" {
        return "p_sin_user";
    }
    if name == "cos" {
        return "p_cos_user";
    }
    if name == "tan" {
        return "p_tan_user";
    }
    if name == "sqrt" {
        return "p_sqrt_user";
    }
    if name == "pow" {
        return "p_pow_user";
    }
    if name == "floor" {
        return "p_floor_user";
    }
    if name == "ceil" {
        return "p_ceil_user";
    }
    if name == "round" {
        return "p_round_user";
    }
    if name == "log" {
        return "p_log_user";
    }
    if name == "exp" {
        return "p_exp_user";
    }
    if name == "asin" {
        return "p_asin_user";
    }
    if name == "acos" {
        return "p_acos_user";
    }
    if name == "atan" {
        return "p_atan_user";
    }
    if name == "atan2" {
        return "p_atan2_user";
    }
    if name == "fmod" {
        return "p_fmod_user";
    }
    if name == "fabs" {
        return "p_fabs_user";
    }
    if name == "isalpha" {
        return "p_isalpha_user";
    }
    if name == "isdigit" {
        return "p_isdigit_user";
    }
    if name == "isspace" {
        return "p_isspace_user";
    }
    if name == "toupper" {
        return "p_toupper_user";
    }
    if name == "tolower" {
        return "p_tolower_user";
    }
    // The rest of <math.h> and <stdlib.h> (B19: a user `fn yn` or `fn j0`
    // clashed with libm's Bessel functions)
    if cg_libc_clash(name) {
        return "p_" + name + "_user";
    }
    // C keywords / reserved identifiers
    if name == "auto" {
        return "p_auto_user";
    }
    if name == "break" {
        return "p_break_user";
    }
    if name == "case" {
        return "p_case_user";
    }
    if name == "char" {
        return "p_char_user";
    }
    if name == "const" {
        return "p_const_user";
    }
    if name == "continue" {
        return "p_continue_user";
    }
    if name == "default" {
        return "p_default_user";
    }
    if name == "do" {
        return "p_do_user";
    }
    if name == "double" {
        return "p_double_user";
    }
    if name == "else" {
        return "p_else_user";
    }
    if name == "enum" {
        return "p_enum_user";
    }
    if name == "extern" {
        return "p_extern_user";
    }
    if name == "float" {
        return "p_float_user";
    }
    if name == "for" {
        return "p_for_user";
    }
    if name == "goto" {
        return "p_goto_user";
    }
    if name == "if" {
        return "p_if_user";
    }
    if name == "inline" {
        return "p_inline_user";
    }
    if name == "int" {
        return "p_int_user";
    }
    if name == "long" {
        return "p_long_user";
    }
    if name == "register" {
        return "p_register_user";
    }
    if name == "restrict" {
        return "p_restrict_user";
    }
    if name == "return" {
        return "p_return_user";
    }
    if name == "short" {
        return "p_short_user";
    }
    if name == "signed" {
        return "p_signed_user";
    }
    if name == "sizeof" {
        return "p_sizeof_user";
    }
    if name == "static" {
        return "p_static_user";
    }
    if name == "struct" {
        return "p_struct_user";
    }
    if name == "switch" {
        return "p_switch_user";
    }
    if name == "typedef" {
        return "p_typedef_user";
    }
    if name == "union" {
        return "p_union_user";
    }
    if name == "unsigned" {
        return "p_unsigned_user";
    }
    if name == "void" {
        return "p_void_user";
    }
    if name == "volatile" {
        return "p_volatile_user";
    }
    if name == "while" {
        return "p_while_user";
    }
    // 2g.13: a user function named like a function the runtime's headers
    // declare (`fn fopen`, `fn read`, `fn puts`) conflicted with it. Every
    // reference to a function goes through here, so the rename is seen by
    // the definition, its prototype, calls, function values and __p_fns.
    // None of these names has an underscore: a name with one is skipped
    // without the comparisons.
    if !str_contains(name, "_") && cg_libc_clash(name) {
        return "p_" + name + "_user";
    }
    // A function named like the generator's own value names (`fn v4`):
    // inside a function with a local v4 the call `v4(..)` called the local
    // (C: "called object type 'void *' is not a function")
    if !str_contains(name, "_") && cg_is_value_name(name) {
        return "p_" + name + "_user";
    }
    // CI7: an exported function's C name is its wrapper's (the C API);
    // the Fides function itself is renamed
    if g_c_lib && g_c_lib_exports != 0 && HashMap_contains(g_c_lib_exports, name) {
        return "p_" + name + "_fx";
    }
    return name;
}

/// A name the C runtime's headers declare (stdio, stdlib, string, ctype,
/// math, unistd, fcntl, sockets, signal, time, dirent, sys/stat, sys/wait,
/// sys/mman, poll, errno), that the denylist above does not already map
/// (2g.13; B19 added the rest of <math.h>: a user `fn yn` or `fn j0` clashed
/// with libm's Bessel functions).
/// `v` then digits only: the name the C generator gives an IR value.
fn cg_is_value_name(name: str) -> bool {
    var n: i64 = str_len(name);
    if n < 2 || str_byte_at(name, 0) != 118 {
        return false;
    }
    var i: i64 = 1;
    while i < n {
        var c: i64 = str_byte_at(name, i);
        if c < 48 || c > 57 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn cg_libc_clash(name: str) -> bool {
    // compiler/MSVC intrinsics that real headers macro-define (SDL's
    // _ReadWriteBarrier), whatever their length: never prototype one
    if name == "_ReadWriteBarrier" || name == "MemoryBarrier" || name == "_WriteBarrier" || name == "__fastfail" || name == "Assert" || name == "RtlSecurityAttribute" {
        return true;
    }
    var n: i64 = str_len(name);
    if n < 2 || n > 12 {
        return false;
    }
    // math.h beyond the common names (B19)
    if name == "j0" || name == "j1" || name == "jn" || name == "y0" || name == "y1" || name == "yn" || name == "log1p" || name == "logb" || name == "expm1" || name == "asinh" || name == "acosh" || name == "atanh" || name == "erf" || name == "erfc" || name == "lgamma" || name == "tgamma" || name == "gamma" || name == "fdim" || name == "fma" || name == "ldexp" || name == "frexp" || name == "modf" || name == "nan" || name == "rint" || name == "lrint" || name == "lround" || name == "nearbyint" || name == "remainder" || name == "remquo" || name == "copysign" || name == "scalbn" || name == "ilogb" || name == "nextafter" || name == "sinf" || name == "cosf" || name == "expf" || name == "logf" || name == "ldiv" {
        return true;
    }
    // stdio.h
    if name == "fopen" || name == "fclose" || name == "fread" || name == "fwrite" || name == "fflush" || name == "fseek" || name == "ftell" || name == "fgets" || name == "fputs" || name == "fputc" || name == "fgetc" || name == "getc" || name == "putc" || name == "getchar" || name == "putchar" || name == "puts" || name == "gets" || name == "sprintf" || name == "snprintf" || name == "fprintf" || name == "scanf" || name == "sscanf" || name == "fscanf" || name == "perror" || name == "rename" || name == "tmpfile" || name == "setvbuf" || name == "fileno" || name == "popen" || name == "pclose" {
        return true;
    }
    // stdlib.h
    if name == "abort" || name == "atexit" || name == "atoi" || name == "atol" || name == "atof" || name == "strtol" || name == "strtoul" || name == "strtod" || name == "getenv" || name == "setenv" || name == "system" || name == "qsort" || name == "bsearch" || name == "labs" || name == "llabs" {
        return true;
    }
    // string.h, strings.h
    if name == "strncmp" || name == "strncpy" || name == "strchr" || name == "strrchr" || name == "strstr" || name == "strdup" || name == "memmove" || name == "memcmp" || name == "memchr" || name == "strtok" || name == "strerror" || name == "index" || name == "rindex" {
        return true;
    }
    // ctype.h, math.h
    if name == "isalnum" || name == "isupper" || name == "islower" || name == "isprint" || name == "ispunct" || name == "isxdigit" || name == "fabsf" || name == "sqrtf" || name == "floorf" || name == "ceilf" || name == "powf" || name == "fmodf" || name == "log2" || name == "log10" || name == "exp2" || name == "trunc" || name == "hypot" || name == "cbrt" || name == "sinh" || name == "cosh" || name == "tanh" || name == "fmin" || name == "fmax" {
        return true;
    }
    // unistd.h, fcntl.h, sys/stat.h, sys/wait.h, sys/mman.h, dirent.h
    if name == "read" || name == "write" || name == "open" || name == "close" || name == "lseek" || name == "unlink" || name == "rmdir" || name == "chdir" || name == "getcwd" || name == "sleep" || name == "usleep" || name == "getpid" || name == "fork" || name == "pipe" || name == "dup" || name == "dup2" || name == "access" || name == "isatty" || name == "stat" || name == "mkdir" || name == "chmod" || name == "wait" || name == "waitpid" || name == "mmap" || name == "munmap" || name == "opendir" || name == "readdir" || name == "closedir" || name == "alloca" || name == "errno" {
        return true;
    }
    // sockets, poll.h, signal.h, time.h
    if name == "socket" || name == "bind" || name == "listen" || name == "accept" || name == "connect" || name == "send" || name == "recv" || name == "sendto" || name == "recvfrom" || name == "shutdown" || name == "select" || name == "poll" || name == "setsockopt" || name == "getsockopt" || name == "htons" || name == "htonl" || name == "ntohs" || name == "ntohl" || name == "getaddrinfo" || name == "signal" || name == "raise" || name == "kill" || name == "localtime" || name == "gmtime" || name == "mktime" || name == "strftime" || name == "difftime" || name == "nanosleep" {
        return true;
    }
    // 2g.69: types and macros the headers declare are renamed the same way
    // (`fn byte` collided with rpcndr.h's `typedef unsigned char byte`)
    return cg_c_header_name(name);
}

/// A name the C runtime's headers (or the C compiler) declare as a type or
/// a macro, not as a function (2g.69): a C function of that name is a
/// redefinition ("redefinition of 'byte' as different kind of symbol") or,
/// for a macro, does not parse. Windows: rpcndr.h (byte, boolean, small,
/// hyper), minwindef.h / winnt.h / wtypes.h (BYTE, WORD, DWORD, BOOL,
/// HANDLE, near, far, IN, OUT, ...), winsock2.h (SOCKET, u_char, ...),
/// wingdi.h (ERROR), combaseapi.h (interface). POSIX and C: FILE, DIR,
/// the <stdint.h>/<sys/types.h> typedefs, stdin/stdout/stderr (macros in
/// the UCRT and musl), glibc's major/minor/makedev; GNU C predefines
/// `linux`, `unix` and `i386` as 1.
fn cg_c_header_name(name: str) -> bool {
    // rpcndr.h, wtypes.h and the GNU C predefined macros
    if name == "byte" || name == "boolean" || name == "small" || name == "hyper" || name == "interface" || name == "near" || name == "far" || name == "pascal" || name == "cdecl" || name == "linux" || name == "unix" || name == "i386" {
        return true;
    }
    // minwindef.h, winnt.h, basetsd.h, wtypes.h
    if name == "BYTE" || name == "WORD" || name == "DWORD" || name == "DWORD64" || name == "BOOL" || name == "BOOLEAN" || name == "HANDLE" || name == "HMODULE" || name == "HINSTANCE" || name == "HWND" || name == "HDC" || name == "HKEY" || name == "CHAR" || name == "UCHAR" || name == "SHORT" || name == "USHORT" || name == "INT" || name == "UINT" || name == "LONG" || name == "ULONG" || name == "LONGLONG" || name == "ULONGLONG" || name == "INT64" || name == "UINT64" || name == "FLOAT" || name == "DOUBLE" || name == "VOID" || name == "PVOID" || name == "LPVOID" || name == "LPSTR" || name == "LPCSTR" || name == "LPWSTR" || name == "LPCWSTR" || name == "WCHAR" || name == "TCHAR" || name == "SIZE_T" || name == "HRESULT" || name == "LPARAM" || name == "WPARAM" || name == "LRESULT" || name == "ATOM" || name == "COLORREF" || name == "FARPROC" || name == "GUID" || name == "IID" || name == "CLSID" || name == "LUID" || name == "BSTR" || name == "VARIANT" || name == "FILETIME" || name == "OVERLAPPED" || name == "POINT" || name == "RECT" || name == "SIZE" || name == "MSG" {
        return true;
    }
    // Windows macros: minwindef.h, winnt.h, wingdi.h, winbase.h
    if name == "TRUE" || name == "FALSE" || name == "CONST" || name == "IN" || name == "OUT" || name == "OPTIONAL" || name == "FAR" || name == "NEAR" || name == "PASCAL" || name == "WINAPI" || name == "CALLBACK" || name == "APIENTRY" || name == "ERROR" || name == "DELETE" || name == "INFINITE" {
        return true;
    }
    // winsock2.h
    if name == "SOCKET" || name == "WSADATA" || name == "u_char" || name == "u_short" || name == "u_int" || name == "u_long" || name == "fd_set" {
        return true;
    }
    // C and POSIX types and macros
    if name == "FILE" || name == "DIR" || name == "stdin" || name == "stdout" || name == "stderr" || name == "EOF" || name == "NULL" || name == "BUFSIZ" || name == "offsetof" || name == "setjmp" || name == "longjmp" || name == "jmp_buf" || name == "va_list" || name == "major" || name == "minor" || name == "makedev" {
        return true;
    }
    if name == "size_t" || name == "ssize_t" || name == "off_t" || name == "pid_t" || name == "time_t" || name == "clock_t" || name == "mode_t" || name == "uid_t" || name == "gid_t" || name == "wchar_t" || name == "wint_t" || name == "socklen_t" || name == "sigset_t" || name == "ptrdiff_t" || name == "intptr_t" || name == "uintptr_t" || name == "intmax_t" || name == "uintmax_t" || name == "int8_t" || name == "int16_t" || name == "int32_t" || name == "int64_t" || name == "uint8_t" || name == "uint16_t" || name == "uint32_t" || name == "uint64_t" {
        return true;
    }
    return false;
}

// --- String escaping ------------------------------------------------------

fn escape_c_string(s: str) -> str {
    var result: str = "";
    var i: i64 = 0;
    var len: i64 = str_len(s);
    while i < len {
        var b: i64 = String_byte_at(s, i);
        if b == 34 {
            // "
            result = result + "\\\"";
        } else if b == 92 {
            // backslash
            result = result + "\\\\";
        } else if b == 10 {
            result = result + "\\n";
        } else if b == 13 {
            result = result + "\\r";
        } else if b == 9 {
            result = result + "\\t";
        } else if b >= 32 && b < 127 {
            result = result + char_to_str(b);
        } else {
            // Octal escape \ooo
            result = result + "\\" + int_to_str(b / 64) + int_to_str((b % 64) / 8) + int_to_str(b % 8);
        }
        i = i + 1;
    }
    return result;
}

// --- Value/name helpers ---------------------------------------------------

fn fresh_label(self: &mut CCodeGen) -> str {
    var n: i64 = self.label_counter;
    self.label_counter = self.label_counter + 1;
    return "L" + int_to_str(n);
}

fn fresh_temp(self: &mut CCodeGen) -> str {
    var n: i64 = self.temp_counter;
    self.temp_counter = self.temp_counter + 1;
    return "t" + int_to_str(n);
}

// --- Vec helper: contains str ---------------------------------------------

// --- Map helpers ----------------------------------------------------------

fn value_names_set(self: &mut CCodeGen, id: i64, name: str) -> void {
    if id < 0 {
        return;
    }
    while self.value_names.len() <= id {
        self.value_names.push("");
    }
    self.value_names.set(id, name);
}

fn string_consts_get(self: &CCodeGen, key: str) -> OptStr {
    var idx: i64 = HashMap_get(self.string_const_index, key);
    if idx > 0 {
        return OptStr::Some(self.string_consts.get(idx - 1).val);
    }
    return OptStr::None;
}

fn string_consts_set(self: &mut CCodeGen, key: str, val: str) -> void {
    var idx: i64 = HashMap_get(self.string_const_index, key);
    if idx > 0 {
        self.string_consts.set(idx - 1, StringConstEntry_new(key, val));
        return;
    }
    self.string_consts.push(StringConstEntry_new(key, val));
    HashMap_insert(self.string_const_index, key, self.string_consts.len());
}

fn fn_param_types_get(self: &CCodeGen, key: str) -> OptVecIrType {
    var idx: i64 = HashMap_get(self.fn_param_index, key);
    if idx > 0 {
        return OptVecIrType::Some(self.fn_param_types.get(idx - 1).types);
    }
    return OptVecIrType::None;
}

fn fn_param_types_set(self: &mut CCodeGen, key: str, types: Vec<IrType>) -> void {
    var idx: i64 = HashMap_get(self.fn_param_index, key);
    if idx > 0 {
        self.fn_param_types.set(idx - 1, FnParamTypesEntry_new(key, types));
        return;
    }
    self.fn_param_types.push(FnParamTypesEntry_new(key, types));
    HashMap_insert(self.fn_param_index, key, self.fn_param_types.len());
}

pub enum OptVecIrType {
    Some(Vec<IrType>),
    None,
}

pub enum OptIrType {
    Some(IrType),
    None,
}

fn fn_ret_types_get(self: &CCodeGen, key: str) -> OptIrType {
    var idx: i64 = HashMap_get(self.fn_ret_index, key);
    if idx > 0 {
        return OptIrType::Some(self.fn_ret_types.get(idx - 1).ty);
    }
    return OptIrType::None;
}

fn fn_ret_types_set(self: &mut CCodeGen, key: str, ty: IrType) -> void {
    var idx: i64 = HashMap_get(self.fn_ret_index, key);
    if idx > 0 {
        self.fn_ret_types.set(idx - 1, FnRetTypeEntry_new(key, ty));
        return;
    }
    self.fn_ret_types.push(FnRetTypeEntry_new(key, ty));
    HashMap_insert(self.fn_ret_index, key, self.fn_ret_types.len());
}

// --- Helpers for building small Vec<IrType> -------------------------------

fn t0() -> Vec<IrType> {
    return Vec::new();
}

fn t1(a: IrType) -> Vec<IrType> {
    var v: Vec<IrType> = Vec::new();
    v.push(a);
    return v;
}

fn t2(a: IrType, b: IrType) -> Vec<IrType> {
    var v: Vec<IrType> = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}

fn t3(a: IrType, b: IrType, c: IrType) -> Vec<IrType> {
    var v: Vec<IrType> = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    return v;
}

fn t4(a: IrType, b: IrType, c: IrType, d: IrType) -> Vec<IrType> {
    var v: Vec<IrType> = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    v.push(d);
    return v;
}

fn t5(a: IrType, b: IrType, c: IrType, d: IrType, e: IrType) -> Vec<IrType> {
    var v: Vec<IrType> = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    v.push(d);
    v.push(e);
    return v;
}

