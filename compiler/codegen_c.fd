    fn_param_types_set(self, "p_grad_zero", t0());
    fn_param_types_set(self, "p_checkpoint_begin", t0());
    fn_param_types_set(self, "p_checkpoint_end", t0());
    fn_param_types_set(self, "p_dp_noise", t2(ptr_u8(), IrType::F64));
    fn_param_types_set(self, "p_gaussian_noise", t2(ptr_u8(), IrType::F64));
    fn_param_types_set(self, "p_dropout", t2(ptr_u8(), IrType::F64));
    fn_param_types_set(self, "p_dp_budget_reset", t1(IrType::F64));
    fn_param_types_set(self, "p_dp_budget_check", t2(IrType::F64, IrType::F64));

    // Tensor parallelism
    fn_param_types_set(self, "p_tp_rank", t0());
    fn_param_types_set(self, "p_tp_world_size", t0());
    fn_param_types_set(self, "p_all_reduce", t1(ptr_u8()));
