    fn_param_types_set(self, "p_dp_budget_check", t2(IrType::F64, IrType::F64));

    // Tensor parallelism
    fn_param_types_set(self, "p_tp_rank", t0());
    fn_param_types_set(self, "p_tp_world_size", t0());
    fn_param_types_set(self, "p_all_reduce", t1(ptr_u8()));
    fn_param_types_set(self, "p_broadcast", t1(ptr_u8()));
