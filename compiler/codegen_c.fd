fn emit_string_consts(self: &mut CCodeGen, module: IrModule) -> void {
    wln(self, "// --- String constants ---");
    var idx: i64 = 0;
    var f: i64 = 0;
    while f < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(f);
        var func: IrFunction = entry.func;
        var b: i64 = 0;
        while b < func.blocks.len() {
            var block: BasicBlock = func.blocks.get(b);
            var i: i64 = 0;
            while i < block.instructions.len() {
                var inst_id: i64 = block.instructions.get(i);
                var inst: OptInst = find_inst(func.insts, inst_id);
                match inst {
                    OptInst::Some(it) => {
                        match it {
                            Inst::ConstStr(value) => {
                                if !string_consts_contains(self, value) {
                                    var name: str = "_str" + int_to_str(idx);
                                    idx = idx + 1;
                                    var escaped: str = escape_c_string(value);
                                    wln(self, "static const char " + name + "[] = \"" + escaped + "\";");
                                    string_consts_set(self, value, name);
                                }
                            }
                            Inst::ConstFnRef(name) => {
                                if !string_consts_contains(self, name) {
                                    var cname: str = "_str" + int_to_str(idx);
                                    idx = idx + 1;
                                    var escaped: str = escape_c_string(name);
                                    wln(self, "static const char " + cname + "[] = \"" + escaped + "\";");
                                    string_consts_set(self, name, cname);
                                }
                            }
                            _ => {}
                        }
                    }
                    OptInst::None => {}
                }
                i = i + 1;
            }
            b = b + 1;
        }
        f = f + 1;
    }
    wln(self, "");
}

fn string_consts_contains(self: &CCodeGen, value: str) -> bool {
    return HashMap_get(self.string_const_index, value) > 0;
}

fn find_inst(insts: Vec<ValueIdInst>, id: i64) -> OptInst {
    // A function's instructions are appended in increasing id order
    // (IrFunction_emit), so binary search finds one in O(log n).
    var lo: i64 = 0;
    var hi: i64 = insts.len() - 1;
    while lo <= hi {
        var mid: i64 = (lo + hi) / 2;
        var mv: ValueIdInst = insts.get(mid);
        if mv.id == id {
            return OptInst::Some(mv.inst);
        }
        if mv.id < id { lo = mid + 1; } else { hi = mid - 1; }
    }
    // Not found that way: the order did not hold; scan.
    var i: i64 = 0;
    while i < insts.len() {
        var vi: ValueIdInst = insts.get(i);
        if vi.id == id {
            return OptInst::Some(vi.inst);
        }
        i = i + 1;
    }
    return OptInst::None;
}

fn emit_struct_defs(self: &mut CCodeGen, module: IrModule) -> void {
    wln(self, "// --- Struct definitions ---");
    var emitted: Vec<str> = Vec::new();
    var s: i64 = 0;
    while s < module.struct_layouts.len() {
        var entry: StructLayoutEntry = module.struct_layouts.get(s);
        var name: str = entry.name;
        // Skip duplicate struct definitions (struct_layouts is a Vec, not a HashMap)
        var is_dup: bool = false;
        var di: i64 = 0;
        while di < emitted.len() {
            if emitted.get(di) == name { is_dup = true; }
            di = di + 1;
        }
        if is_dup { s = s + 1; continue; }
        emitted.push(name);
        var layout: StructLayout = entry.layout;

        if layout.repr_c {
            // @repr(C) struct: emit with natural C types and explicit padding
            wln(self, "struct " + name + "_s {");
            var prev_offset: i64 = 0;
            var i: i64 = 0;
            while i < layout.fields.len() {
                var field: StringIrTypeOffset = layout.fields.get(i);
                // Emit padding bytes if needed to match the layout
                if field.offset > prev_offset {
                    var pad: i64 = field.offset - prev_offset;
                    wln(self, "    char _pad_" + int_to_str(i) + "[" + int_to_str(pad) + "];");
                }
                wln(self, "    " + c_type(field.ty) + " field_" + int_to_str(i) + ";");
                // Calculate field size
                var field_size: i64 = 0;
                if i + 1 < layout.fields.len() {
                    field_size = layout.fields.get(i + 1).offset - field.offset;
                } else {
                    field_size = layout.size - field.offset;
                }
                prev_offset = field.offset + field_size;
                i = i + 1;
            }
            // Final padding to reach struct size
            if layout.size > prev_offset {
                wln(self, "    char _pad_end[" + int_to_str(layout.size - prev_offset) + "];");
            }
            wln(self, "} __attribute__((aligned(" + int_to_str(layout.align) + ")));");
            wln(self, "");
        } else {
            // Default Fides layout: uniform 8-byte slots
            wln(self, "struct " + name + "_s {");
            var i: i64 = 0;
            while i < layout.fields.len() {
                var field: StringIrTypeOffset = layout.fields.get(i);
                var field_size: i64 = 0;
                if i + 1 < layout.fields.len() {
                    field_size = layout.fields.get(i + 1).offset - field.offset;
                } else {
                    field_size = layout.size - field.offset;
                }
                if field_size > 8 {
                    var slots: i64 = field_size / 8;
                    wln(self, "    int64_t field_" + int_to_str(i) + "[" + int_to_str(slots) + "];");
                } else {
                    match field.ty {
                        IrType::Bool => {
                            wln(self, "    int64_t field_" + int_to_str(i) + ";");
                        }
                        _ => {
                            wln(self, "    " + c_type(field.ty) + " field_" + int_to_str(i) + ";");
                        }
                    }
                }
                i = i + 1;
            }
            wln(self, "};");
            wln(self, "");
        }
        s = s + 1;
    }
}

// --- Module-level mutable globals ------------------------------------------

fn global_c_name(name: str) -> str {
    return "_g_" + name;
}

fn gen_global_init_expr(expr: Expr) -> str {
    match expr {
        Expr::IntLit(v) => { return int_to_str(v) + "LL"; }
        Expr::FloatLit(f) => {
            if f != f { return "NAN"; }
            if f > 1.7976931348623157e308 { return "INFINITY"; }
            if f < -1.7976931348623157e308 { return "-INFINITY"; }
            return float_to_str(f);
        }
        Expr::BoolLit(b) => {
            if b { return "true"; }
            return "false";
        }
        Expr::StringLit(s) => { return "\"" + escape_c_string(s) + "\""; }
        _ => { return "0"; }
    }
    return "0";
}

// Bug 3.16 fix: Check if a global init expression is a simple literal
// (can be used as a C static initializer) or complex (needs runtime init).
fn is_simple_init_expr(expr: Expr) -> bool {
    match expr {
        Expr::IntLit(_) => { return true; }
        Expr::FloatLit(_) => { return true; }
        Expr::BoolLit(_) => { return true; }
        Expr::StringLit(_) => { return true; }
        _ => { return false; }
    }
    return false;
}

// Local helper to unbox Box<Expr> for pattern matching.
fn cg_box_expr_unbox(b: Box<Expr>) -> Expr {
    match b {
        Expr::IntLit(v) => { return Expr::IntLit(v); }
        Expr::FloatLit(v) => { return Expr::FloatLit(v); }
        Expr::StringLit(v) => { return Expr::StringLit(v); }
        Expr::BoolLit(v) => { return Expr::BoolLit(v); }
        Expr::Ident(n) => { return Expr::Ident(n); }
        Expr::Call(n, a) => { return Expr::Call(n, a); }
        Expr::MethodCall(r, m, a) => { return Expr::MethodCall(r, m, a); }
        Expr::StructLit(n, f, s) => { return Expr::StructLit(n, f, s); }
        _ => { return Expr::IntLit(0); }
    }
    return Expr::IntLit(0);
}

// Bug 3.16 fix: Generate a C expression for a runtime global initializer.
// Handles struct literals with Vec::new() fields and simple function calls.
fn gen_global_runtime_expr(self: &mut CCodeGen, expr: Expr) -> str {
    match expr {
        Expr::IntLit(v) => { return int_to_str(v) + "LL"; }
        Expr::FloatLit(f) => {
            if f != f { return "NAN"; }
            if f > 1.7976931348623157e308 { return "INFINITY"; }
            if f < -1.7976931348623157e308 { return "-INFINITY"; }
            return float_to_str(f);
        }
        Expr::BoolLit(b) => {
            if b { return "true"; }
            return "false";
        }
        Expr::StringLit(s) => { return "\"" + escape_c_string(s) + "\""; }
        Expr::MethodCall(receiver, method, args) => {
            // Handle Vec::new() which is parsed as MethodCall(Ident("Vec"), "new", []).
            var recv_expr: Expr = cg_box_expr_unbox(receiver);
            var recv_name: str = "";
            match recv_expr {
                Expr::Ident(n) => { recv_name = n; }
                _ => {}
            }
            if str_len(recv_name) > 0 {
                var mangled: str = recv_name + "_" + method;
                var c_fname: str = sanitize_c_name(self, mangled);
                // Vec_new and similar runtime functions need a dummy env arg
                if mangled == "Vec_new" || mangled == "HashMap_new" {
                    if args.len() == 0 {
                        return "(void*)" + c_fname + "(0LL)";
                    }
                    var arg_strs: str = "";
                    var i: i64 = 0;
                    while i < args.len() {
                        if i > 0 { arg_strs = arg_strs + ", "; }
                        arg_strs = arg_strs + gen_global_runtime_expr(self, args.get(i));
                        i = i + 1;
                    }
                    return "(void*)" + c_fname + "(0LL, " + arg_strs + ")";
                }
            }
            return "0";
        }
        Expr::StructLit(sname, fields, _spread) => {
            // Allocate struct on heap, initialize fields, return pointer
            var size: i64 = 8;
            var si: i64 = 0;
            while si < self.struct_layouts.len() {
                if self.struct_layouts.get(si).name == sname {
                    size = self.struct_layouts.get(si).layout.size;
                    break;
                }
                si = si + 1;
            }
            var tmp: str = "__ginit_" + sname;
            wln(self, "    struct " + sname + "_s* " + tmp + " = (struct " + sname + "_s*)p_malloc(" + int_to_str(size) + ");");
            wln(self, "    memset(" + tmp + ", 0, " + int_to_str(size) + ");");
            var fi: i64 = 0;
            while fi < fields.len() {
                var field: FieldInit = fields.get(fi);
                // Find field offset and type from struct layout
                var foffset: i64 = 0;
                var ftype: IrType = IrType::I64;
                var found: bool = false;
                var li: i64 = 0;
                while li < self.struct_layouts.len() {
                    if self.struct_layouts.get(li).name == sname {
                        var layout: StructLayout = self.struct_layouts.get(li).layout;
                        var fj: i64 = 0;
                        while fj < layout.fields.len() {
                            var sf: StringIrTypeOffset = layout.fields.get(fj);
                            if sf.name == field.name {
                                foffset = sf.offset;
                                ftype = sf.ty;
                                found = true;
                                break;
                            }
                            fj = fj + 1;
                        }
                        break;
                    }
                    li = li + 1;
                }
                if found {
                    var val_str: str = gen_global_runtime_expr(self, field.value);
                    var ptr_str: str = "((char*)" + tmp + " + " + int_to_str(foffset) + ")";
                    match ftype {
                        IrType::F64 => { wln(self, "    *(double*)" + ptr_str + " = " + val_str + ";"); }
                        IrType::F32 => { wln(self, "    *(float*)" + ptr_str + " = " + val_str + ";"); }
                        IrType::Bool => { wln(self, "    *(bool*)" + ptr_str + " = " + val_str + ";"); }
                        IrType::I8 => { wln(self, "    *(int8_t*)" + ptr_str + " = (int8_t)" + val_str + ";"); }
                        IrType::I16 => { wln(self, "    *(int16_t*)" + ptr_str + " = (int16_t)" + val_str + ";"); }
                        IrType::I32 => { wln(self, "    *(int32_t*)" + ptr_str + " = (int32_t)" + val_str + ";"); }
                        IrType::U8 => { wln(self, "    *(uint8_t*)" + ptr_str + " = (uint8_t)" + val_str + ";"); }
                        IrType::U16 => { wln(self, "    *(uint16_t*)" + ptr_str + " = (uint16_t)" + val_str + ";"); }
                        IrType::U32 => { wln(self, "    *(uint32_t*)" + ptr_str + " = (uint32_t)" + val_str + ";"); }
                        IrType::Ptr(_) => { wln(self, "    *(void**)" + ptr_str + " = (void*)" + val_str + ";"); }
                        IrType::Opaque(_) => { wln(self, "    *(void**)" + ptr_str + " = (void*)" + val_str + ";"); }
                        IrType::Generic(_, _) => { wln(self, "    *(void**)" + ptr_str + " = (void*)" + val_str + ";"); }
                        _ => { wln(self, "    *(int64_t*)" + ptr_str + " = (int64_t)" + val_str + ";"); }
                    }
                }
                fi = fi + 1;
            }
            return "(void*)" + tmp;
        }
        _ => { return "0"; }
    }
    return "0";
}

fn emit_globals(self: &mut CCodeGen, module: IrModule) -> void {
    if module.globals.len() == 0 { return; }
    wln(self, "// --- Module-level mutable globals ---");
    var gi: i64 = 0;
    while gi < module.globals.len() {
        var entry: GlobalEntry = module.globals.get(gi);
        var c_ty: str = c_type_global(entry.ty);
        var c_name: str = global_c_name(entry.name);
        var is_struct: bool = false;
        match entry.ty {
            IrType::Struct(_) => { is_struct = true; }
            _ => {}
        }
        if is_struct {
            wln(self, "static " + c_ty + " " + c_name + " = {0};");
        } else {
            var init_str: str = gen_global_init_expr(entry.init);
            wln(self, "static " + c_ty + " " + c_name + " = " + init_str + ";");
        }
        gi = gi + 1;
    }
    wln(self, "");
}

// Bug 3.16 fix: Emit __init_globals() function that initializes globals
// with complex (non-literal) initializers at runtime.
fn emit_global_init_function(self: &mut CCodeGen, module: IrModule) -> void {
    // Always emit a forward declaration so main() can call it unconditionally
    wln(self, "// --- Runtime global initialization (bug 3.16 fix) ---");
    wln(self, "static void __init_globals(void);");
    if module.globals.len() == 0 {
        // Emit empty function body
        wln(self, "static void __init_globals(void) { }");
        wln(self, "");
        return;
    }
    // Check if any global needs runtime init
    var needs_init: bool = false;
    var gi: i64 = 0;
    while gi < module.globals.len() {
        var entry: GlobalEntry = module.globals.get(gi);
        if !is_simple_init_expr(entry.init) {
            needs_init = true;
            break;
        }
        gi = gi + 1;
    }
    if !needs_init {
        // Emit empty function body
        wln(self, "static void __init_globals(void) { }");
        wln(self, "");
        return;
    }

    wln(self, "static void __init_globals(void) {");
    gi = 0;
    while gi < module.globals.len() {
        var entry: GlobalEntry = module.globals.get(gi);
        if !is_simple_init_expr(entry.init) {
            var c_name: str = global_c_name(entry.name);
            var is_struct_global: bool = false;
            match entry.ty {
                IrType::Struct(sname) => {
                    is_struct_global = true;
                    var size: i64 = 8;
                    var si: i64 = 0;
                    while si < module.struct_layouts.len() {
                        var sl: StructLayoutEntry = module.struct_layouts.get(si);
                        if sl.name == sname { size = sl.layout.size; break; }
                        si = si + 1;
                    }
                    wln(self, "    memset(&" + c_name + ", 0, " + int_to_str(size) + ");");
                }
                _ => {}
            }
            if !is_struct_global {
                var val_str: str = gen_global_runtime_expr(self, entry.init);
                wln(self, "    " + c_name + " = " + val_str + ";");
            }
        }
        gi = gi + 1;
    }
    wln(self, "}");
    wln(self, "");
}

/// A C type that holds a 64-bit integer or a pointer.
fn is_word_c(c: str) -> bool {
    return c == "int64_t" || c == "uint64_t" || str_ends_with(c, "*");
}

fn emit_prototypes(self: &mut CCodeGen, module: IrModule) -> void {
    wln(self, "// --- Function prototypes ---");
    wln(self, "void p_thread_register(const char* name, int64_t (*fn)());");
    var f: i64 = 0;
    while f < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(f);
        var proto_name: str = sanitize_c_name(self, entry.name);
        var ret_ty: str;
        if entry.name == "main" {
            ret_ty = "int64_t";
        } else {
            ret_ty = c_ret_type(entry.func.ret_ty);
        }
        var params: str = "";
        var p: i64 = 0;
        while p < entry.func.params.len() {
            var vp: ValueIdType = entry.func.params.get(p);
            if p > 0 { params = params + ", "; }
            params = params + c_param_decl(vp.ty, "v" + int_to_str(vp.id));
            p = p + 1;
        }
        wln(self, ret_ty + " " + proto_name + "(" + params + ");");
        f = f + 1;
    }
    // C takes a struct by value and Fides has a pointer to it
    var wi: i64 = 0;
    while wi < module.extern_decls.len() {
        var ext: ExternDecl = module.extern_decls.get(wi);
        if vec_contains_str(self.c_wrapped, ext.pledge_name) {
            var w_params: str = "";
            var w_args: str = "";
            var struct_ret: bool = c_is_struct(module, ext.ret_ty);
            if struct_ret { w_params = "void* ret"; }
            var wp: i64 = 0;
            while wp < ext.params.len() {
                var pty: Type = ext.params.get(wp).ty;
                var c_ty: str = c_type_from_ast(pty);
                var a_name: str = "a" + int_to_str(wp);
                if w_params != "" { w_params = w_params + ", "; }
                if wp > 0 { w_args = w_args + ", "; }
                if c_is_struct(module, pty) {
                    w_params = w_params + "void* " + a_name;
                    w_args = w_args + "*(" + c_ty + "*)" + a_name;
                } else {
                    w_params = w_params + c_ty + " " + a_name;
                    w_args = w_args + a_name;
                }
                wp = wp + 1;
            }
            if w_params == "" { w_params = "void"; }
            var w_call: str = ext.pledge_name + "(" + w_args + ")";
            var w_ret: str = c_type_from_ast(ext.ret_ty);
            if struct_ret {
                w_call = "*(" + w_ret + "*)ret = " + w_call;
                w_ret = "void";
            } else if w_ret != "void" {
                w_call = "return " + w_call;
            }
            wln(self, w_ret + " __c_wrap_" + ext.pledge_name + "(" + w_params + ") { " + w_call + "; }");
        }
        wi = wi + 1;
    }
    // C calls these: they supply the `__env` Fides functions take
    var cb: i64 = 0;
    while cb < module.c_callbacks.len() {
        var target: str = module.c_callbacks.get(cb);
        match IrModule_get_function(&module, target) {
            OptIrFunction::Some(func) => {
                var c_ret: str = c_ret_type(func.ret_ty);
                var c_name: str = sanitize_c_name(self, target);
                var c_params: str = "";
                var c_args: str = "NULL";
                var p2: i64 = 1;
                while p2 < func.params.len() {
                    var arg_name: str = "a" + int_to_str(p2 - 1);
                    if p2 > 1 { c_params = c_params + ", "; }
                    c_params = c_params + c_param_decl(func.params.get(p2).ty, arg_name);
                    c_args = c_args + ", " + arg_name;
                    p2 = p2 + 1;
                }
                var call: str = c_name + "(" + c_args + ");";
                if c_ret != "void" { call = "return " + call; }
                wln(self, c_ret + " " + c_fn_name(c_name) + "(" + c_params + ") { " + call + " }");
            }
            OptIrFunction::None => {}
        }
        cb = cb + 1;
    }
    wln(self, "");
}

fn emit_main_wrapper(self: &mut CCodeGen, module: IrModule) -> void {
    if has_main(module) {
        wln(self, "// --- C entry point ---");
        // Crash and stack overflow handlers: __p_install_crash_handlers
        wln(self, "#ifdef _WIN32");
        wln(self, "#include <windows.h>");
        wln(self, "#endif");
        wln(self, "void __p_install_crash_handlers(void);");
        wln(self, "#ifdef P_PROFILE");
        wln(self, "void __p_profile_start(void);");
        wln(self, "#endif");
        wln(self, "int main(int argc, char** argv) {");
        wln(self, "    __p_install_crash_handlers();");
        wln(self, "#ifdef P_PROFILE");
        wln(self, "    __p_profile_start();");
        wln(self, "#endif");
        wln(self, "    setvbuf(stdout, NULL, _IONBF, 0);");
        wln(self, "    setvbuf(stderr, NULL, _IONBF, 0);");
        // Windows: binary stdout/stderr, so a newline is not written as CR LF
        // (output then matches the interpreter and Rust-built programs).
        wln(self, "#ifdef _WIN32");
        wln(self, "    _setmode(_fileno(stdout), _O_BINARY);");
        wln(self, "    _setmode(_fileno(stderr), _O_BINARY);");
        wln(self, "#endif");
        wln(self, "    __p_argc = argc; __p_argv = argv;");
        wln(self, "    // Register functions for p_thread_spawn lookup");
        var f: i64 = 0;
        while f < module.functions.len() {
            var entry: IrFunctionEntry = module.functions.get(f);
            if entry.name != "main" && !is_internal_function(entry.name) {
                var c_name: str = sanitize_c_name(self, entry.name);
                wln(self, "    p_thread_register(\"" + entry.name + "\", (int64_t(*)())" + c_name + ");");
            }
            f = f + 1;
        }
        wln(self, "    __init_globals();");
        wln(self, "    int64_t result = main_entry(NULL);");
        wln(self, "    return (int)result;");
        wln(self, "}");
        wln(self, "");
    }
}

fn has_main(module: IrModule) -> bool {
    var f: i64 = 0;
    while f < module.functions.len() {
        if module.functions.get(f).name == "main" {
            return true;
        }
        f = f + 1;
    }
    return false;
}

fn is_internal_function(name: str) -> bool {
    if str_starts_with(name, "p_") { return true; }
    if str_starts_with(name, "box_") { return true; }
    if str_starts_with(name, "type_") { return true; }
    if str_starts_with(name, "stmt_") { return true; }
    if str_starts_with(name, "expr_") { return true; }
    if str_starts_with(name, "opt_") { return true; }
    if str_starts_with(name, "str_") { return true; }
    if str_starts_with(name, "int_") { return true; }
    if str_starts_with(name, "char_") { return true; }
    if str_starts_with(name, "map_") { return true; }
    if str_starts_with(name, "vec_") { return true; }
    if str_starts_with(name, "c_") { return true; }
    return false;
}

// --- Value / name helpers -------------------------------------------------

fn value_names_get(self: &CCodeGen, id: i64) -> OptStr {
    if id >= 0 && id < self.value_names.len() {
        var name: str = self.value_names.get(id);
        if name != "" {
            return OptStr::Some(name);
        }
    }
    return OptStr::None;
}

fn val_name(self: &CCodeGen, id: i64) -> str {
    match value_names_get(self, id) {
        OptStr::Some(name) => { return name; }
        OptStr::None => { return "v" + int_to_str(id); }
    }
}

fn lookup_field_offset(self: &CCodeGen, struct_name: str, field_index: i64, default_offset: i64) -> i64 {
    var i: i64 = 0;
    while i < self.struct_layouts.len() {
        if self.struct_layouts.get(i).name == struct_name {
            var layout: StructLayout = self.struct_layouts.get(i).layout;
            if field_index < layout.fields.len() {
                return layout.fields.get(field_index).offset;
            }
            return default_offset;
        }
        i = i + 1;
    }
    return default_offset;
}

/// "(T)(intptr_t)" for the C type T a value is declared with: converts an
/// integer or a pointer to it, so an int/pointer mismatch between the IR and
/// the declaration compiles under -Werror=int-conversion (GCC 14, Clang 16+).
/// Empty for float and array types.
fn int_ptr_cast(ty: IrType) -> str {
    match ty {
        IrType::F32 => { return ""; }
        IrType::F64 => { return ""; }
        IrType::Array(_, _) => { return ""; }
        IrType::Void => { return "(int64_t)(intptr_t)"; }
        IrType::Never => { return "(int64_t)(intptr_t)"; }
        _ => {}
    }
    return "(" + c_type(ty) + ")(intptr_t)";
}

fn value_ty_for_id(func: IrFunction, id: i64) -> IrType {
    // Values are numbered as they are made: id == index
    if id >= 0 && id < func.value_metas.len() && func.value_metas.get(id).id == id {
        return func.value_metas.get(id).meta.ty;
    }
    var i: i64 = 0;
    while i < func.value_metas.len() {
        if func.value_metas.get(i).id == id {
            return func.value_metas.get(i).meta.ty;
        }
        i = i + 1;
    }
    i = 0;
    while i < func.params.len() {
        if func.params.get(i).id == id {
            return func.params.get(i).ty;
        }
        i = i + 1;
    }
    return IrType::I64;
}

fn params_contains_id(func: IrFunction, id: i64) -> bool {
    var i: i64 = 0;
    while i < func.params.len() {
        if func.params.get(i).id == id {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn binop_to_str(op: BinOp) -> str {
    match op {
        BinOp::Add => { return "+"; }
        BinOp::Sub => { return "-"; }
        BinOp::Mul => { return "*"; }
        BinOp::Div => { return "/"; }
        BinOp::Mod => { return "%"; }
        BinOp::Eq => { return "=="; }
        BinOp::Neq => { return "!="; }
        BinOp::Lt => { return "<"; }
        BinOp::Gt => { return ">"; }
        BinOp::LtEq => { return "<="; }
        BinOp::GtEq => { return ">="; }
        BinOp::And => { return "&&"; }
        BinOp::Or => { return "||"; }
        BinOp::BitAnd => { return "&"; }
        BinOp::BitOr => { return "|"; }
        BinOp::BitXor => { return "^"; }
        BinOp::Shl => { return "<<"; }
        BinOp::Shr => { return ">>"; }
    }
    return "+";
}

fn unaryop_to_str(op: UnaryOp) -> str {
    match op {
        UnaryOp::Neg => { return "-"; }
        UnaryOp::Not => { return "!"; }
        UnaryOp::BitNot => { return "~"; }
    }
    return "-";
}

// --- Function / instruction emission --------------------------------------

fn alloca_size(self: &CCodeGen, ty: IrType) -> i64 {
    // For struct types, look up the actual size from struct_layouts.
    // ir_type_size() returns 0 for structs because it doesn't have
    // access to the module. Without this lookup, alloca only
    // allocates 8 bytes (the fallback), causing buffer overflows
    // when memcpy copies the full struct data.
    var size: i64 = 0;
    match ty {
        IrType::Struct(sname) => {
            var si: i64 = 0;
            while si < self.struct_layouts.len() {
                if self.struct_layouts.get(si).name == sname {
                    size = self.struct_layouts.get(si).layout.size;
                    break;
                }
                si = si + 1;
            }
        }
        _ => { size = ir_type_size(ty); }
    }
    if size == 0 { size = 8; }
    return size;
}

fn fn_has_const_str(func: IrFunction, s: str) -> bool {
    var i: i64 = 0;
    while i < func.insts.len() {
        match func.insts.get(i).inst {
            Inst::ConstStr(v) => { if v == s { return true; } }
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

/// C bodies for core.fd's Vec_new/len/is_empty/get/set/push/pop, with core's
/// exact semantics: the header is {data, len, cap} (three i64), growth
/// doubles from 8 through p_malloc, a bad index panics with core's message.
/// Used only when the function has core's signature (an env parameter, i64
/// arguments, the same return type, and for get/set core's panic string),
/// so a user's own function of that name keeps its body. Empty: no fast body.
fn fast_core_vec_body(name: str, func: IrFunction, c_ret: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var n: i64 = func.params.len();
    var i: i64 = 1;
    while i < n {
        var ok: bool = false;
        match func.params.get(i).ty {
            IrType::I64 => { ok = true; }
            _ => {}
        }
        if !ok { return out; }
        i = i + 1;
    }
    var p: Vec<str> = Vec::new();
    i = 0;
    while i < n {
        p.push("v" + int_to_str(func.params.get(i).id));
        i = i + 1;
    }
    var bounds: bool = fn_has_const_str(func, "Vec index out of bounds");
    if name == "Vec_new" && n == 1 && c_ret == "int64_t" {
        out.push("    int64_t* __h = (int64_t*)p_malloc(24);");
        out.push("    __h[0] = 0; __h[1] = 0; __h[2] = 0;");
        out.push("    return (int64_t)(intptr_t)__h;");
    } else if name == "Vec_len" && n == 2 && c_ret == "int64_t" {
        out.push("    int64_t* __h = (int64_t*)(intptr_t)" + p.get(1) + ";");
        out.push("    return __h[1];");
    } else if name == "Vec_is_empty" && n == 2 && c_ret == "bool" {
        out.push("    int64_t* __h = (int64_t*)(intptr_t)" + p.get(1) + ";");
        out.push("    return __h[1] == 0;");
    } else if name == "Vec_get" && n == 3 && c_ret == "int64_t" && bounds {
        out.push("    int64_t* __h = (int64_t*)(intptr_t)" + p.get(1) + ";");
        out.push("    if (" + p.get(2) + " >= __h[1]) p_panic(\"Vec index out of bounds\");");
        out.push("    if (" + p.get(2) + " < 0) p_panic(\"Vec index out of bounds\");");
        out.push("    return ((int64_t*)(intptr_t)__h[0])[" + p.get(2) + "];");
    } else if name == "Vec_set" && n == 4 && c_ret == "void" && bounds {
        out.push("    int64_t* __h = (int64_t*)(intptr_t)" + p.get(1) + ";");
        out.push("    if (" + p.get(2) + " >= __h[1]) p_panic(\"Vec index out of bounds\");");
        out.push("    if (" + p.get(2) + " < 0) p_panic(\"Vec index out of bounds\");");
        out.push("    ((int64_t*)(intptr_t)__h[0])[" + p.get(2) + "] = " + p.get(3) + ";");
    } else if name == "Vec_push" && n == 3 && c_ret == "void" {
        out.push("    int64_t* __h = (int64_t*)(intptr_t)" + p.get(1) + ";");
        out.push("    int64_t __len = __h[1];");
        out.push("    if (P_UNLIKELY(__len >= __h[2])) __p_vec_grow(__h);");
        out.push("    ((int64_t*)(intptr_t)__h[0])[__len] = " + p.get(2) + ";");
        out.push("    __h[1] = __len + 1;");
    } else if name == "Vec_pop" && n == 2 && c_ret == "int64_t" {
        out.push("    int64_t* __h = (int64_t*)(intptr_t)" + p.get(1) + ";");
        out.push("    if (__h[1] == 0) return 0;");
        out.push("    __h[1] = __h[1] - 1;");
        out.push("    return ((int64_t*)(intptr_t)__h[0])[__h[1]];");
    }
    return out;
}

fn gen_function(self: &mut CCodeGen, name: str, func: IrFunction) -> void {
    self.temp_counter = 0;
    self.label_counter = 0;
    var c_name: str = sanitize_c_name(self, name);

    var i: i64 = 0;
    while i < func.params.len() {
        var p: ValueIdType = func.params.get(i);
        value_names_set(self, p.id, "v" + int_to_str(p.id));
        i = i + 1;
    }

    var ret_ty: str;
    if name == "main" {
        ret_ty = "int64_t";
    } else {
        ret_ty = c_ret_type(func.ret_ty);
    }
    self.cur_fn_c_ret_is_void = ret_ty == "void";
    self.cur_fn_c_ret_type = ret_ty;

    var params_str: str = "";
    i = 0;
    while i < func.params.len() {
        var p: ValueIdType = func.params.get(i);
        if i > 0 { params_str = params_str + ", "; }
        params_str = params_str + c_param_decl(p.ty, "v" + int_to_str(p.id));
        i = i + 1;
    }
    wln(self, ret_ty + " " + c_name + "(" + params_str + ") {");
    // Core's hottest Vec functions: a few C statements instead of the
    // lowered Fides body (much faster in the -O0 self-hosted build).
    self.unchecked = peir_unchecked_ops(&func, func.value_metas.len() + func.insts.len() + 16);
    var fast: Vec<str> = fast_core_vec_body(name, func, ret_ty);
    if fast.len() > 0 {
        var fi: i64 = 0;
        while fi < fast.len() {
            wln(self, fast.get(fi));
            fi = fi + 1;
        }
        wln(self, "}");
        wln(self, "");
        return;
    }

    i = 0;
    while i < func.value_metas.len() {
        var vm: ValueIdMeta = func.value_metas.get(i);
        if !params_contains_id(func, vm.id) {
            match vm.meta.ty {
                IrType::Void => {
                    wln(self, "    int64_t v" + int_to_str(vm.id) + " = 0; /* placeholder for void */");
                }
                IrType::Never => {
                    wln(self, "    int64_t v" + int_to_str(vm.id) + " = 0; /* placeholder for void */");
                }
                _ => {
                    wln(self, "    " + c_type(vm.meta.ty) + " v" + int_to_str(vm.id) + " = 0;");
                }
            }
            value_names_set(self, vm.id, "v" + int_to_str(vm.id));
        }
        i = i + 1;
    }

    // Prologue alloca pre-pass: bind one stack slot per Inst::Alloca at
    // function entry. The zero-init memset is still emitted at the
    // instruction's own site, so loop iterations re-clear the slot while
    // the stack itself grows only once per call instead of per iteration.
    var b: i64 = 0;
    while b < func.blocks.len() {
        var ablock: BasicBlock = func.blocks.get(b);
        var j: i64 = 0;
        while j < ablock.instructions.len() {
            var ainst_id: i64 = ablock.instructions.get(j);
            match find_inst(func.insts, ainst_id) {
                OptInst::Some(ait) => {
                    match ait {
                        Inst::Alloca(aty, _) => {
                            wln(self, "    v" + int_to_str(ainst_id) + " = alloca(" + int_to_str(alloca_size(self, aty)) + ");");
                        }
                        _ => {}
                    }
                }
                OptInst::None => {}
            }
            j = j + 1;
        }
        b = b + 1;
    }

    b = 0;
    while b < func.blocks.len() {
        var block: BasicBlock = func.blocks.get(b);
        if b > 0 {
            wln(self, "  bb" + int_to_str(block.id) + ":");
        }
        var j: i64 = 0;
        while j < block.instructions.len() {
            var inst_id: i64 = block.instructions.get(j);
            match find_inst(func.insts, inst_id) {
                OptInst::Some(it) => { gen_inst(self, it, inst_id, func); }
                OptInst::None => {}
            }
            j = j + 1;
        }
        b = b + 1;
    }

    if self.cur_fn_c_ret_is_void {
        wln(self, "    return;");
    } else {
        wln(self, "    return 0;");
    }
    wln(self, "}");
    wln(self, "");
}

fn cg_unchecked(self: &CCodeGen, id: i64) -> bool {
    return id >= 0 && id < self.unchecked.len() && self.unchecked.get(id) != 0;
}

fn gen_inst(self: &mut CCodeGen, inst: Inst, id: i64, func: IrFunction) -> void {
    var dst: str = val_name(self, id);
    match inst {
        Inst::ConstInt(value, _) => {
            wln(self, "    " + dst + " = " + int_to_str(value) + "LL;");
        }
        Inst::ConstFloat(value, ty) => {
            // B5: Use a union compound literal to reinterpret the IEEE 754
            // bits as a float - this preserves NaN payloads, -0.0, and Inf
            // bit patterns that are lost when converting to a decimal string.
            // Matches the Rust codegen (src/codegen_c.rs ConstFloat handler).
            if ir_type_eq(ty, IrType::F32) {
                var bits: i64 = p_f32_to_bits(value);
                wln(self, "    " + dst + " = ((union { uint32_t u; float f; }){ .u = " + int_to_str(bits) + "U }).f;");
            } else {
                var bits: i64 = p_f64_to_bits(value);
                wln(self, "    " + dst + " = ((union { uint64_t u; double f; }){ .u = " + int_to_str(bits) + "ULL }).f;");
            }
        }
        Inst::ConstBool(value) => {
            if value {
                wln(self, "    " + dst + " = true;");
            } else {
                wln(self, "    " + dst + " = false;");
            }
        }
        Inst::ConstStr(value) => {
            match string_consts_get(self, value) {
                OptStr::Some(name) => {
                    wln(self, "    " + dst + " = " + name + ";");
                }
                OptStr::None => {
                    var escaped: str = escape_c_string(value);
                    wln(self, "    " + dst + " = \"" + escaped + "\";");
                }
            }
        }
        Inst::ConstFnRef(name) => {
            if str_starts_with(name, "__c_fn_") {
                wln(self, "    " + dst + " = (int64_t)" + c_fn_name(sanitize_c_name(self, c_fn_target(name))) + ";");
                return;
            }
            match string_consts_get(self, name) {
                OptStr::Some(cname) => {
                    wln(self, "    " + dst + " = (int64_t)" + cname + ";");
                }
                OptStr::None => {
                    var escaped: str = escape_c_string(name);
                    wln(self, "    " + dst + " = (int64_t)\"" + escaped + "\";");
                }
            }
        }
        Inst::ConstNull(_) => {
            wln(self, "    " + dst + " = NULL;");
        }
        Inst::GlobalAddr(name, _) => {
            var cast: str = int_ptr_cast(value_ty_for_id(func, id));
            if cast == "" { cast = "(int64_t)(intptr_t)"; }
            wln(self, "    " + dst + " = " + cast + "&" + global_c_name(name) + ";");
        }
        Inst::BinOp(op, left, right, ty) => {
            var l_raw: str = val_name(self, left);
            var r_raw: str = val_name(self, right);
            var l_ty: IrType = value_ty_for_id(func, left);
            var r_ty: IrType = value_ty_for_id(func, right);
            var l: str = l_raw;
            var r: str = r_raw;
            if is_ptr_type(l_ty) { l = "(int64_t)" + l_raw; }
            if is_ptr_type(r_ty) { r = "(int64_t)" + r_raw; }
            var cop: str = binop_to_str(op);
            // Float modulo: C doesn't support % on doubles, use fmod()
            var is_float_mod: bool = false;
            match op {
                BinOp::Mod => {
                    match ty {
                        IrType::F64 => { is_float_mod = true; }
                        _ => {}
                    }
                }
                _ => {}
            }
            // Integer arithmetic has one meaning (see gen_arith_helpers).
            var int_n: str = "";
            if !is_ptr_type(l_ty) && !is_ptr_type(r_ty) { int_n = c_int_helper(ty); }
            var unsigned_cmp: bool = ir_type_eq(l_ty, IrType::U64) || ir_type_eq(r_ty, IrType::U64);
            if str_len(int_n) > 0 && gen_int_arith(self, func.is_wrapping || cg_unchecked(self, id), dst, op, int_n, c_type(ty), l, r) {
                // done
            } else if unsigned_cmp && c_is_ordered_cmp(op) {
                wln(self, "    " + dst + " = (uint64_t)" + l + " " + cop + " (uint64_t)" + r + ";");
            } else if is_float_mod {
                wln(self, "    " + dst + " = fmod(" + l + ", " + r + ");");
            } else if is_ptr_type(ty) {
                wln(self, "    " + dst + " = (void*)(intptr_t)(" + l + " " + cop + " " + r + ");");
            } else {
                wln(self, "    " + dst + " = " + l + " " + cop + " " + r + ";");
            }
        }
        Inst::UnaryOp(op, operand, _) => {
            var o: str = val_name(self, operand);
            var uop: str = unaryop_to_str(op);
            wln(self, "    " + dst + " = " + uop + o + ";");
        }
        Inst::Alloca(ty, _) => {
            // The alloca() call itself is emitted once in the function
            // prologue (see gen_function's alloca pre-pass): an alloca
            // inside a loop block would otherwise burn fresh stack on
            // every iteration — alloca memory is only reclaimed at
            // function return — and overflow the native stack on
            // high-trip-count loops. The slot is reused across
            // iterations; only the zero-init stays here so each
            // iteration still sees cleared storage.
            var size: i64 = alloca_size(self, ty);
            wln(self, "    memset(" + dst + ", 0, " + int_to_str(size) + ");");
        }
        Inst::Load(ptr, ty) => {
            var p: str = val_name(self, ptr);
            if is_ptr_type(ty) {
                wln(self, "    " + dst + " = *(void**)" + p + ";");
            } else {
                wln(self, "    " + dst + " = *(" + c_type(ty) + "*)" + p + ";");
            }
        }
        Inst::Store(ptr, value, store_ty) => {
            var p: str = val_name(self, ptr);
            var v: str = val_name(self, value);
            // Determine the effective store type, matching the Rust codegen:
            // 1. If store_ty is explicitly set (e.g. by load_enum_field), use it
            // 2. If the pointer has a Ptr(T) type, use the pointee type T
            // 3. Fall back to the value's type
            var effective_ty: IrType = value_ty_for_id(func, value);
            match store_ty {
                OptIrType::Some(ty) => { effective_ty = ty; }
                OptIrType::None => {
                    // Check if the pointer's pointee type is available
                    var ptr_meta_ty: IrType = value_ty_for_id(func, ptr);
                    match ptr_meta_ty {
                        IrType::Ptr(inner) => {
                            // Use the pointee type for the store (matches Rust codegen)
                            effective_ty = cc_box_ir_type_unbox(inner);
                        }
                        _ => {}
                    }
                }
            }
            // Struct store: copy the full struct content via memcpy, not just
            // 8 bytes. The value is a pointer to the source struct data, and
            // the destination is a pointer to the target buffer. This is
            // critical for load_enum_field to correctly extract inline enum
            // payloads (e.g. Expr from ParseResultExpr::Ok(e)).
            match effective_ty {
                IrType::Struct(sname) => {
                    var size: i64 = 8;
                    var si: i64 = 0;
                    while si < self.struct_layouts.len() {
                        if self.struct_layouts.get(si).name == sname {
                            size = self.struct_layouts.get(si).layout.size;
                            break;
                        }
                        si = si + 1;
                    }
                    wln(self, "    memcpy(" + p + ", " + v + ", " + int_to_str(size) + ");");
                }
                _ => {
                    var val_ty: IrType = effective_ty;
                    if is_ptr_type(val_ty) {
                        wln(self, "    *(void**)" + p + " = (void*)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::F64) {
                        wln(self, "    *(double*)" + p + " = " + v + ";");
                    } else if ir_type_eq(val_ty, IrType::F32) {
                        wln(self, "    *(float*)" + p + " = " + v + ";");
                    } else if ir_type_eq(val_ty, IrType::Bool) {
                        wln(self, "    *(bool*)" + p + " = " + v + ";");
                    } else if ir_type_eq(val_ty, IrType::I8) {
                        wln(self, "    *(int8_t*)" + p + " = (int8_t)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::I16) {
                        wln(self, "    *(int16_t*)" + p + " = (int16_t)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::I32) {
                        wln(self, "    *(int32_t*)" + p + " = (int32_t)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::U8) {
                        wln(self, "    *(uint8_t*)" + p + " = (uint8_t)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::U16) {
                        wln(self, "    *(uint16_t*)" + p + " = (uint16_t)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::U32) {
                        wln(self, "    *(uint32_t*)" + p + " = (uint32_t)" + v + ";");
                    } else if ir_type_eq(val_ty, IrType::U64) {
                        wln(self, "    *(uint64_t*)" + p + " = (uint64_t)" + v + ";");
                    } else {
                        wln(self, "    *(int64_t*)" + p + " = (int64_t)" + v + ";");
                    }
                }
            }
        }
        Inst::GetFieldPtr(struct_ptr, field_index, _) => {
            var s: str = val_name(self, struct_ptr);
            // Look up the actual field offset from the struct layout.
            // Falls back to field_index * 8 if the struct can't be determined.
            var ptr_ty: IrType = value_ty_for_id(func, struct_ptr);
            var offset: i64 = field_index * 8;
            match ptr_ty {
                IrType::Ptr(inner) => {
                    match cc_box_ir_type_unbox(inner) {
                        IrType::Struct(sn) => {
                            offset = lookup_field_offset(self, sn, field_index, offset);
                        }
                        _ => {}
                    }
                }
                IrType::Struct(sn) => {
                    offset = lookup_field_offset(self, sn, field_index, offset);
                }
                _ => {}
            }
            wln(self, "    " + dst + " = (char*)" + s + " + " + int_to_str(offset) + ";");
        }
        Inst::GetElemPtr(array_ptr, index, elem_ty) => {
            var a: str = val_name(self, array_ptr);
            var i: str = val_name(self, index);
            var size: i64 = ir_type_size(elem_ty);
            wln(self, "    " + dst + " = (char*)" + a + " + (" + i + " * " + int_to_str(size) + ");");
        }
        Inst::Jump(target) => {
            wln(self, "    goto bb" + int_to_str(target) + ";");
        }
        Inst::Branch(cond, then, else_) => {
            var c: str = val_name(self, cond);
            wln(self, "    if (" + c + ") goto bb" + int_to_str(then) + ";");
            wln(self, "    else goto bb" + int_to_str(else_) + ";");
        }
        Inst::Return(value) => {
            match value {
                OptValueId::Some(v) => {
                    if self.cur_fn_c_ret_is_void {
                        wln(self, "    return;");
                    } else {
                        // Cast a pointer returned from an integer function,
                        // or an integer from a pointer function (as the Rust
                        // backend does; GCC 14 / Clang 16+ reject it bare).
                        var vn: str = val_name(self, v);
                        var val_is_ptr: bool = false;
                        match value_ty_for_id(func, v) {
                            IrType::Ptr(_) => { val_is_ptr = true; }
                            IrType::Opaque(_) => { val_is_ptr = true; }
                            IrType::Generic(_, _) => { val_is_ptr = true; }
                            _ => {}
                        }
                        var ret: str = self.cur_fn_c_ret_type;
                        var ret_is_ptr: bool = ret == "void*" || str_starts_with(ret, "struct ");
                        if val_is_ptr && !ret_is_ptr {
                            vn = "(" + ret + ")(intptr_t)" + vn;
                        } else if !val_is_ptr && ret_is_ptr {
                            vn = "(void*)(intptr_t)" + vn;
                        }
                        wln(self, "    return " + vn + ";");
                    }
                }
                OptValueId::None => {
                    if self.cur_fn_c_ret_is_void {
                        wln(self, "    return;");
                    } else {
                        wln(self, "    return 0;");
                    }
                }
            }
        }
        Inst::Unreachable => {
            wln(self, "    abort();");
        }
        Inst::Call(fname, args, ret_ty, _) => {
            var c_fname: str = sanitize_c_name(self, fname);
            // In bounds: a counted loop proved it
            if cg_unchecked(self, id) {
                if fname == "Vec_get" { c_fname = "__p_vec_get_u"; }
                if fname == "Vec_set" { c_fname = "__p_vec_set_u"; }
                if fname == "p_vec_get" { c_fname = "__p_pvec_get_u"; }
                if fname == "p_vec_set" { c_fname = "__p_pvec_set_u"; }
            }

            // Special-case: print is polymorphic - dispatch based on arg type
            if fname == "print" && args.len() > 0 {
                var arg_val: i64 = args.get(0);
                var arg_ty: IrType = value_ty_for_id(func, arg_val);
                var arg_str: str = val_name(self, arg_val);
                match arg_ty {
                    IrType::Opaque(oname) => {
                        if oname == "any" {
                            wln(self, "    p_print_int((int64_t)" + arg_str + ");");
                        } else if oname == "Vec" {
                            wln(self, "    { char* _s = (char*)Vec_to_str(0, (int64_t)" + arg_str + "); p_print_str(_s); }");
                        } else if oname == "HashMap" {
                            wln(self, "    { char* _s = p_to_str_map((PMap*)" + arg_str + "); p_print_str(_s); free(_s); }");
                        } else if oname == "Tensor" {
                            wln(self, "    { char* _s = p_tensor_to_str((PTensor*)" + arg_str + "); p_print_str(_s); free(_s); }");
                        } else {
                            wln(self, "    p_print_str(" + arg_str + ");");
                        }
                    }
                    IrType::Generic(gname, _) => {
                        if gname == "Vec" {
                            wln(self, "    { char* _s = (char*)Vec_to_str(0, (int64_t)" + arg_str + "); p_print_str(_s); }");
                        } else if gname == "HashMap" {
                            wln(self, "    { char* _s = p_to_str_map((PMap*)" + arg_str + "); p_print_str(_s); free(_s); }");
                        } else {
                            wln(self, "    p_print_int((int64_t)" + arg_str + ");");
                        }
                    }
                    IrType::Ptr(_) => {
                        wln(self, "    p_print_str(" + arg_str + ");");
                    }
                    IrType::F64 => {
                        wln(self, "    p_print_float(" + arg_str + ");");
                    }
                    IrType::Bool => {
                        wln(self, "    p_print_bool(" + arg_str + ");");
                    }
                    _ => {
                        wln(self, "    p_print_int((int64_t)" + arg_str + ");");
                    }
                }
                if !is_void_or_never(ret_ty) {
                    wln(self, "    " + dst + " = 0;");
                }
                return;
            }

            // Special-case: println is polymorphic - dispatch on value (2nd arg)
            if fname == "println" && args.len() >= 2 {
                var arg_val: i64 = args.get(1);
                var arg_ty: IrType = value_ty_for_id(func, arg_val);
                var arg_str: str = val_name(self, arg_val);
                match arg_ty {
                    IrType::Opaque(oname) => {
                        if oname == "any" {
                            wln(self, "    p_print_int((int64_t)" + arg_str + ");");
                        } else if oname == "Vec" {
                            wln(self, "    { char* _s = (char*)Vec_to_str(0, (int64_t)" + arg_str + "); p_print_str(_s); }");
                        } else if oname == "HashMap" {
                            wln(self, "    { char* _s = p_to_str_map((PMap*)" + arg_str + "); p_print_str(_s); free(_s); }");
                        } else if oname == "Tensor" {
                            wln(self, "    { char* _s = p_tensor_to_str((PTensor*)" + arg_str + "); p_print_str(_s); free(_s); }");
                        } else {
                            wln(self, "    p_print_str(" + arg_str + ");");
                        }
                    }
                    IrType::Generic(gname, _) => {
                        if gname == "Vec" {
                            wln(self, "    { char* _s = (char*)Vec_to_str(0, (int64_t)" + arg_str + "); p_print_str(_s); }");
                        } else if gname == "HashMap" {
                            wln(self, "    { char* _s = p_to_str_map((PMap*)" + arg_str + "); p_print_str(_s); free(_s); }");
                        } else {
                            wln(self, "    p_print_int((int64_t)" + arg_str + ");");
                        }
                    }
                    IrType::Ptr(_) => {
                        wln(self, "    p_print_str(" + arg_str + ");");
                    }
                    IrType::F64 => {
                        wln(self, "    p_print_float(" + arg_str + ");");
                    }
                    IrType::Bool => {
                        wln(self, "    p_print_bool(" + arg_str + ");");
                    }
                    _ => {
                        wln(self, "    p_print_int((int64_t)" + arg_str + ");");
                    }
                }
                wln(self, "    p_print_newline();");
                if !is_void_or_never(ret_ty) {
                    wln(self, "    " + dst + " = 0;");
                }
                return;
            }

            // Special-case: p_to_str is polymorphic - dispatch based on arg type
            if fname == "p_to_str" && args.len() > 0 {
                var arg_val: i64 = args.get(0);
                var arg_ty: IrType = value_ty_for_id(func, arg_val);
                var arg_str: str = val_name(self, arg_val);
                match arg_ty {
                    IrType::F64 => {
                        wln(self, "    " + dst + " = (void*)p_to_str_float(" + arg_str + ");");
                    }
                    IrType::F32 => {
                        wln(self, "    " + dst + " = (void*)p_to_str_float(" + arg_str + ");");
                    }
                    IrType::Opaque(oname) => {
                        if oname == "Vec" {
                            wln(self, "    " + dst + " = (void*)Vec_to_str(0, (int64_t)" + arg_str + ");");
                        } else if oname == "HashMap" {
                            wln(self, "    " + dst + " = (void*)p_to_str_map((PMap*)" + arg_str + ");");
                        } else if oname == "Tensor" {
                            wln(self, "    " + dst + " = (void*)p_tensor_to_str((PTensor*)" + arg_str + ");");
                        } else {
                            wln(self, "    " + dst + " = (void*)p_to_str_str((char*)" + arg_str + ");");
                        }
                    }
                    IrType::Generic(gname, _) => {
                        if gname == "Vec" {
                            wln(self, "    " + dst + " = (void*)Vec_to_str(0, (int64_t)" + arg_str + ");");
                        } else if gname == "HashMap" {
                            wln(self, "    " + dst + " = (void*)p_to_str_map((PMap*)" + arg_str + ");");
                        } else {
                            wln(self, "    " + dst + " = (void*)p_to_str((int64_t)" + arg_str + ");");
                        }
                    }
                    IrType::Bool => {
                        wln(self, "    " + dst + " = (void*)p_to_str_bool(" + arg_str + ");");
                    }
                    IrType::Ptr(_) => {
                        wln(self, "    " + dst + " = (void*)p_to_str_str((char*)" + arg_str + ");");
                    }
                    _ => {
                        wln(self, "    " + dst + " = (void*)p_to_str((int64_t)" + arg_str + ");");
                    }
                }
                return;
            }

            // Special-case: p_socket_write is called with 2 args (fd, str) by
            // stdlib but the C implementation needs 3 args (fd, buf, len).
            if fname == "p_socket_write" && args.len() == 2 {
                wln(self, "    " + dst + " = p_socket_write_str(" + val_name(self, args.get(0)) + ", " + val_name(self, args.get(1)) + ");");
                return;
            }

            var param_types: OptVecIrType = fn_param_types_get(self, fname);
            var arg_strs: str = "";
            var i: i64 = 0;
            while i < args.len() {
                if i > 0 { arg_strs = arg_strs + ", "; }
                var a: i64 = args.get(i);
                var base: str = val_name(self, a);
                var arg_ty: IrType = value_ty_for_id(func, a);
                var cast: str = base;
                match param_types {
                    OptVecIrType::Some(pts) => {
                        if i < pts.len() {
                            cast = cast_arg(base, arg_ty, pts.get(i));
                        } else {
                            var is_varargs: bool = fname == "p_thread_spawn" || fname == "p_executor_spawn" || fname == "p_co_async";
                            if is_varargs && is_ptr_type(arg_ty) {
                                cast = "(int64_t)" + base;
                            }
                        }
                    }
                    OptVecIrType::None => {}
                }
                arg_strs = arg_strs + cast;
                i = i + 1;
            }
            var callee_c_ret: str = c_ret_type(ret_ty);
            match fn_ret_types_get(self, fname) {
                OptIrType::Some(t) => { callee_c_ret = c_ret_type(t); }
                OptIrType::None => {}
            }
            if callee_c_ret == "void" {
                wln(self, "    " + c_fname + "(" + arg_strs + ");");
                if !is_void_or_never(ret_ty) {
                    wln(self, "    " + dst + " = 0;");
                }
            } else {
                if is_void_or_never(ret_ty) {
                    wln(self, "    " + c_fname + "(" + arg_strs + ");");
                } else {
                    // Match Rust codegen: add return type cast based on dst type
                    var dst_ty: IrType = value_ty_for_id(func, id);
                    var dst_is_ptr: bool = is_ptr_type(dst_ty);
                    var callee_returns_int: bool = callee_c_ret == "int64_t" || callee_c_ret == "int32_t" || callee_c_ret == "int16_t" || callee_c_ret == "int8_t";
                    var callee_returns_ptr: bool = str_ends_with(callee_c_ret, "*");
                    var cast: str = "(int64_t)";
                    match dst_ty {
                        IrType::Ptr(_) => {
                            if dst_is_ptr && callee_returns_int { cast = "(void*)"; } else { cast = ""; }
                        }
                        IrType::Opaque(_) => {
                            if dst_is_ptr && callee_returns_int { cast = "(void*)"; } else { cast = ""; }
                        }
                        IrType::Generic(_, _) => {
                            if dst_is_ptr && callee_returns_int { cast = "(void*)"; } else { cast = ""; }
                        }
                        IrType::F64 => {
                            // Bug 3.19 fix: When the callee returns int64_t but
                            // the dst is f64, the int64 contains a float bit
                            // pattern (e.g. from Vec_get). Type-pun it back to
                            // double via a union instead of casting directly.
                            if callee_returns_int {
                                wln(self, "    " + dst + " = ((union { int64_t i; double d; }){ .i = " + c_fname + "(" + arg_strs + ") }).d;");
                                return;
                            }
                            // Same bit pattern behind a void* (p_vec_get on a
                            // Vec<f64>); a pointer cannot be cast to double.
                            if callee_returns_ptr {
                                wln(self, "    " + dst + " = ((union { int64_t i; double d; }){ .i = (int64_t)(intptr_t)" + c_fname + "(" + arg_strs + ") }).d;");
                                return;
                            }
                            cast = "(double)";
                        }
                        IrType::F32 => {
                            // Bug 3.19 fix: Same type-pun for f32.
                            if callee_returns_int || callee_returns_ptr {
                                wln(self, "    " + dst + " = ((union { int32_t i; float f; }){ .i = (int32_t)(intptr_t)" + c_fname + "(" + arg_strs + ") }).f;");
                                return;
                            }
                            cast = "(float)";
                        }
                        IrType::Bool => { cast = "(bool)"; }
                        _ => { cast = "(int64_t)"; }
                    }
                    wln(self, "    " + dst + " = " + cast + c_fname + "(" + arg_strs + ");");
                }
            }
        }
        Inst::CallPtr(fn_ptr, args, ret_ty, _, has_env) => {
            var fp: str = val_name(self, fn_ptr);
            // Closures in Fides use string-based dispatch: the closure
            // struct's field 0 is a char* pointing to the function name.
            // We generate an inline if/else chain that compares the name
            // and calls the appropriate C function.

            // Build arg name strings
            var arg_strs: Vec<str> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() {
                arg_strs.push(val_name(self, args.get(ai)));
                ai = ai + 1;
            }

            // Find candidate functions: user functions whose param count
            // matches args.len() + 1 (the +1 is for the ctx/env param)
            // AND whose return type matches the CallPtr's ret_ty.
            var expected_param_count: i64 = args.len() + 1;
            var candidates: Vec<str> = Vec::new();
            var ci: i64 = 0;
            while ci < self.user_functions.len() {
                var name: str = self.user_functions.get(ci);
                if name != "" {
                    var pts_opt: OptVecIrType = fn_param_types_get(self, name);
                    match pts_opt {
                        OptVecIrType::Some(pts) => {
                            if pts.len() == expected_param_count {
                                var rt_opt: OptIrType = fn_ret_types_get(self, name);
                                match rt_opt {
                                    OptIrType::Some(rt) => {
                                        var c_rt: str = c_ret_type(rt);
                                        var c_expected: str = c_ret_type(ret_ty);
                                        if c_rt == c_expected || (is_word_c(c_rt) && is_word_c(c_expected)) {
                                            candidates.push(name);
                                        }
                                    }
                                    OptIrType::None => {}
                                }
                            }
                        }
                        OptVecIrType::None => {}
                    }
                }
                ci = ci + 1;
            }

            // Build the dispatch block
            wln(self, "    {");
            wln(self, "        if (!" + fp + ") abort();");
            wln(self, "        char* _fn_name = *(char**)" + fp + ";");
            wln(self, "        if (!_fn_name) abort();");
            var first: bool = true;
            var cand_i: i64 = 0;
            while cand_i < candidates.len() {
                var fname: str = candidates.get(cand_i);
                var c_fname: str = sanitize_c_name(self, fname);
                var pts_opt: OptVecIrType = fn_param_types_get(self, fname);
                var fn_ret: IrType = ret_ty;
                match fn_ret_types_get(self, fname) {
                    OptIrType::Some(rt) => { fn_ret = rt; }
                    OptIrType::None => {}
                }

                // Build call args
                var call_args: Vec<str> = Vec::new();
                // Arg 0: env pointer or 0
                if has_env {
                    call_args.push("(void*)" + fp);
                } else {
                    call_args.push("(void*)0");
                }
                // Args 1..N: the explicit CallPtr args, cast to match
                var arg_i: i64 = 0;
                while arg_i < arg_strs.len() {
                    var param_idx: i64 = arg_i + 1;
                    var cast: str = "int64_t";
                    match pts_opt {
                        OptVecIrType::Some(pts) => {
                            if param_idx < pts.len() {
                                cast = c_type(pts.get(param_idx));
                            }
                        }
                        OptVecIrType::None => {}
                    }
                    var arg: str = arg_strs.get(arg_i);
                    var arg_ty_c: IrType = value_ty_for_id(func, args.get(arg_i));
                    if ir_type_eq(arg_ty_c, IrType::F64) || ir_type_eq(arg_ty_c, IrType::F32) {
                        // A float stays one; this candidate may not take it
                        if cast == "double" || cast == "float" {
                            call_args.push("(" + cast + ")" + arg);
                        } else if cast == "void*" || str_starts_with(cast, "struct ") || str_contains(cast, "[") {
                            call_args.push("(void*)(intptr_t)" + arg);
                        } else {
                            call_args.push("(" + cast + ")" + arg);
                        }
                    } else if cast == "void*" || str_starts_with(cast, "struct ") {
                        call_args.push("(void*)" + arg);
                    } else if cast == "double" {
                        call_args.push("(double)(intptr_t)" + arg);
                    } else if cast == "float" {
                        call_args.push("(float)(intptr_t)" + arg);
                    } else if cast == "bool" {
                        call_args.push("(bool)" + arg);
                    } else if str_contains(cast, "[") {
                        call_args.push("(void*)" + arg);
                    } else {
                        call_args.push("(" + cast + ")" + arg);
                    }
                    arg_i = arg_i + 1;
                }

                // Join call args
                var call_expr: str = c_fname + "(";
                var j: i64 = 0;
                while j < call_args.len() {
                    if j > 0 { call_expr = call_expr + ", "; }
                    call_expr = call_expr + call_args.get(j);
                    j = j + 1;
                }
                call_expr = call_expr + ")";

                if first {
                    wln(self, "        if (strcmp(_fn_name, \"" + fname + "\") == 0) {");
                    first = false;
                } else {
                    wln(self, "        } else if (strcmp(_fn_name, \"" + fname + "\") == 0) {");
                }

                if ir_type_eq(fn_ret, IrType::Void) || ir_type_eq(fn_ret, IrType::Never) {
                    wln(self, "            " + call_expr + ";");
                } else if is_aggregate_ret(fn_ret) {
                    wln(self, "            " + call_expr + ";");
                } else {
                    // A word of another type (a function value may only know i64)
                    wln(self, "            " + dst + " = (" + c_type(ret_ty) + ")" + call_expr + ";");
                }
                cand_i = cand_i + 1;
            }
            if first {
                // No candidates found - fall back to direct function pointer call
                var args_cast: Vec<str> = Vec::new();
                var ai2: i64 = 0;
                while ai2 < args.len() {
                    args_cast.push("(void*)" + val_name(self, args.get(ai2)));
                    ai2 = ai2 + 1;
                }
                var args_joined: str = "";
                var j2: i64 = 0;
                while j2 < args_cast.len() {
                    if j2 > 0 { args_joined = args_joined + ", "; }
                    args_joined = args_joined + args_cast.get(j2);
                    j2 = j2 + 1;
                }
                var full_args: str;
                if has_env {
                    full_args = "(void*)" + fp + ", " + args_joined;
                } else {
                    full_args = args_joined;
                }
                if ir_type_eq(ret_ty, IrType::Void) || ir_type_eq(ret_ty, IrType::Never) {
                    wln(self, "        ((void(*)(void*))" + fp + ")(" + full_args + ");");
                } else {
                    wln(self, "        " + dst + " = (int64_t)((int64_t(*)(void*))" + fp + ")(" + full_args + ");");
                }
            } else {
                wln(self, "        } else { abort(); }");
            }
            wln(self, "    }");
        }
        Inst::DynCall(trait_name, method, args, ret_ty, _) => {
            var void_ret: bool = c_ret_type(ret_ty) == "void";
            wln(self, "    /* dyncall " + trait_name + "::" + method + " */");
            if args.len() > 0 {
                var type_arg: str = val_name(self, args.get(0));
                var candidates: Vec<str> = Vec::new();
                var ci: i64 = 0;
                while ci < self.user_functions.len() {
                    var fname: str = self.user_functions.get(ci);
                    if str_ends_with(fname, "_" + method) {
                        candidates.push(fname);
                    }
                    ci = ci + 1;
                }
                wln(self, "    { struct { const char* type_name; void* ptr; }* _dyn = (void*)" + type_arg + ";");
                wln(self, "    const char* _t = _dyn ? _dyn->type_name : \"\";");
                wln(self, "    void* _recv = _dyn ? _dyn->ptr : NULL;");
                wln(self, "    if (false) {}");
                var ci2: i64 = 0;
                while ci2 < candidates.len() {
                    var cname: str = candidates.get(ci2);
                    var method_suffix: str = "_" + method;
                    var type_part: str = str_slice(cname, 0, str_len(cname) - str_len(method_suffix));
                    var call_args: str = "NULL, _recv";
                    var ai: i64 = 1;
                    while ai < args.len() {
                        call_args = call_args + ", " + val_name(self, args.get(ai));
                        ai = ai + 1;
                    }
                    if void_ret {
                        wln(self, "    else if (strcmp(_t, \"" + type_part + "\") == 0) " + cname + "(" + call_args + ");");
                    } else {
                        wln(self, "    else if (strcmp(_t, \"" + type_part + "\") == 0) " + dst + " = " + cname + "(" + call_args + ");");
                    }
                    ci2 = ci2 + 1;
                }
                if !void_ret {
                    wln(self, "    else { abort(); }");
                }
                wln(self, "    }");
            }
        }
        Inst::MakeDyn(value, type_name, trait_name) => {
            var val_str: str = val_name(self, value);
            wln(self, "    { /* make dyn " + type_name + " as " + trait_name + " */");
            wln(self, "        struct { const char* type_name; void* ptr; }* _dyn = p_malloc(sizeof(*_dyn));");
            wln(self, "        _dyn->type_name = \"" + type_name + "\";");
            wln(self, "        _dyn->ptr = (void*)" + val_str + ";");
            wln(self, "        " + dst + " = (void*)_dyn;");
            wln(self, "    }");
        }
        Inst::BitCast(value, _, _) => {
            var v: str = val_name(self, value);
            var cast: str = int_ptr_cast(value_ty_for_id(func, id));
            if cast == "" { cast = "(void*)"; }
            wln(self, "    " + dst + " = " + cast + v + ";");
        }
        Inst::IntExtend(value, _, _) => {
            var v: str = val_name(self, value);
            wln(self, "    " + dst + " = (int64_t)" + v + ";");
        }
        Inst::IntTrunc(value, _, _) => {
            var v: str = val_name(self, value);
            wln(self, "    " + dst + " = (int32_t)" + v + ";");
        }
        Inst::IntToFloat(value, _, _) => {
            var v: str = val_name(self, value);
            wln(self, "    " + dst + " = (double)" + v + ";");
        }
        Inst::FloatToInt(value, _, _) => {
            var v: str = val_name(self, value);
            wln(self, "    " + dst + " = (int64_t)" + v + ";");
        }
        Inst::TryUnwrap(value, ok_dst, err_block, ok_block) => {
            var v: str = val_name(self, value);
            var ok_dst_str: str = val_name(self, ok_dst);
            wln(self, "    { int64_t _tag = *(int64_t*)" + v + ";");
            wln(self, "    if (_tag == 0) {");
            wln(self, "        " + ok_dst_str + " = *((int64_t*)" + v + " + 1);");
            wln(self, "        goto bb" + int_to_str(ok_block) + ";");
            wln(self, "    } else {");
            wln(self, "        goto bb" + int_to_str(err_block) + ";");
            wln(self, "    } }");
        }
        Inst::Print(value, ty) => {
            var v: str = val_name(self, value);
            match ty {
                IrType::F64 => { wln(self, "    p_print_float(" + v + ");"); }
                IrType::Bool => { wln(self, "    p_print_bool(" + v + ");"); }
                IrType::Ptr(_) => { wln(self, "    p_print_str(" + v + ");"); }
                IrType::Generic(name, _) => {
                    if name == "Vec" {
                        wln(self, "    { char* _s = (char*)Vec_to_str(0, (int64_t)" + v + "); p_print_str(_s); }");
                    } else if name == "HashMap" {
                        wln(self, "    { char* _s = (char*)HashMap_to_str(0, (int64_t)" + v + "); p_print_str(_s); }");
                    } else {
                        wln(self, "    p_print_int((int64_t)" + v + ");");
                    }
                }
                IrType::Opaque(name) => {
                    if name == "Vec" {
                        wln(self, "    { char* _s = (char*)Vec_to_str(0, (int64_t)" + v + "); p_print_str(_s); }");
                    } else if name == "HashMap" {
                        // The self-hosted lowerer types HashMap::new() as
                        // Opaque("HashMap") (src/lower.rs: Generic).
                        wln(self, "    { char* _s = (char*)HashMap_to_str(0, (int64_t)" + v + "); p_print_str(_s); }");
                    } else if name == "String" {
                        wln(self, "    p_print_str((char*)" + v + ");");
                    } else if name == "Tensor" {
                        wln(self, "    { char* _s = p_tensor_to_str((void*)" + v + "); p_print_str(_s); free(_s); }");
                    } else {
                        wln(self, "    p_print_int((int64_t)" + v + ");");
                    }
                }
                _ => { wln(self, "    p_print_int((int64_t)" + v + ");"); }
            }
        }
        Inst::Panic(message) => {
            wln(self, "    p_panic(\"" + message + "\");");
        }
        Inst::Asm(template, _, _, ret_ty) => {
            wln(self, "    /* asm: " + template + " */");
            match ret_ty {
                IrType::Void => {}
                _ => { wln(self, "    " + dst + " = 0LL;"); }
            }
        }
        Inst::RegionBegin(name, is_gpu, _, _) => {
            if is_gpu {
                wln(self, "    /* GPU region begin: " + name + " */");
            }
        }
        Inst::RegionEnd(name, is_gpu, _) => {
            if is_gpu {
                wln(self, "    /* GPU region end: " + name + " (all GPU memory freed) */");
            }
        }
        Inst::PersistLoad(_, default, _) => {
            var d: str = val_name(self, default);
            wln(self, "    " + dst + " = " + d + ";");
        }
        Inst::PersistSave(_, _) => {}
        Inst::TxnBegin => {}
        Inst::TxnEnd => {}
        Inst::UnsafeBegin => {}
        Inst::UnsafeEnd => {}
        Inst::GradBegin(_) => {
            wln(self, "    p_autograd_begin();");
        }
        Inst::GradEnd => {
            wln(self, "    p_autograd_end();");
        }
        Inst::Backward(_) => {
            wln(self, "    p_autograd_backward(NULL);");
        }
        Inst::StructCopy(dst, src, ty) => {
            var d: str = val_name(self, dst);
            var s: str = val_name(self, src);
            var size: i64 = 8;
            match ty {
                IrType::Struct(sName) => {
                    var si: i64 = 0;
                    while si < self.struct_layouts.len() {
                        if self.struct_layouts.get(si).name == sName {
                            size = self.struct_layouts.get(si).layout.size;
                            break;
                        }
                        si = si + 1;
                    }
                }
                _ => {}
            }
            wln(self, "    memcpy(" + d + ", " + s + ", " + int_to_str(size) + ");");
        }
    }
}

// --- Module-level generation ----------------------------------------------

// Per-module units (`ccompile --inc`): mark each function in the output, so
// compiler.fd can split it.
var g_c_unit_marks: bool = false;
pub fn set_c_unit_marks(v: bool) { g_c_unit_marks = v; }
// fid ccompile --profile: the program samples its own call stack
var g_c_profile: bool = false;
pub fn set_c_profile(v: bool) { g_c_profile = v; }

pub fn CCodeGen_generate(self: &mut CCodeGen, module: IrModule) -> str {
    CCodeGen_insert_runtime_sigs(self);
    while self.user_functions.len() > 0 { self.user_functions.pop(); }
    while self.user_fn_param_types.len() > 0 { self.user_fn_param_types.pop(); }

    // Copy struct layouts for GetFieldPtr offset lookup
    while self.struct_layouts.len() > 0 { self.struct_layouts.pop(); }
    var sli: i64 = 0;
    while sli < module.struct_layouts.len() {
        self.struct_layouts.push(module.struct_layouts.get(sli));
        sli = sli + 1;
    }

    var f: i64 = 0;
    while f < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(f);
        self.user_functions.push(entry.name);
        var types: Vec<IrType> = extract_param_types(entry.func.params);
        fn_param_types_set(self, entry.name, types);
        fn_ret_types_set(self, entry.name, entry.func.ret_ty);
        f = f + 1;
    }

    if g_c_profile { wln(self, "#define P_PROFILE 1"); }
    emit_runtime_header(self);
    emit_extern_decls(self, module);
    emit_runtime_types(self);
    emit_string_consts(self, module);
    emit_struct_defs(self, module);
    emit_globals(self, module);
    emit_prototypes(self, module);
    emit_global_init_function(self, module);

    f = 0;
    while f < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(f);
        if g_c_unit_marks { wln(self, "//@FN " + entry.name); }
        gen_function(self, entry.name, entry.func);
        f = f + 1;
    }
    if g_c_unit_marks { wln(self, "//@TAIL"); }

    emit_main_wrapper(self, module);
    emit_runtime_impl(self);
    emit_file_write_bin_impl(self);
    // Panic traces name each frame through this table
    wln(self, "const __p_fn_entry __p_fns[] = {");
    var tf: i64 = 0;
    while tf < module.functions.len() {
        var tname: str = module.functions.get(tf).name;
        wln(self, "    {(const void*)" + sanitize_c_name(self, tname) + ", \"" + tname + "\"},");
        tf = tf + 1;
    }
    if module.functions.len() == 0 { wln(self, "    {0, 0},"); }
    wln(self, "};");
    wln(self, "const int __p_fn_count = " + int_to_str(module.functions.len()) + ";");
    // Convert the string builder to the final output string
    self.out = p_sb_to_str(self.sb);
    return self.out;
}

fn extract_param_types(params: Vec<ValueIdType>) -> Vec<IrType> {
    var v: Vec<IrType> = Vec::new();
    var i: i64 = 0;
    while i < params.len() {
        v.push(params.get(i).ty);
        i = i + 1;
    }
    return v;
}

fn emit_file_write_bin_impl(self: &mut CCodeGen) -> void {
    // Every byte of a file as one Vec element (binary-safe: keeps 0x00).
    wln(self, "PVec* p_file_read_bytes(const char* path) {");
    wln(self, "    PVec* v = p_vec_new();");
    wln(self, "    FILE* f = fopen(path, \"rb\");");
    wln(self, "    if (!f) return v;");
    wln(self, "    int c;");
    wln(self, "    while ((c = fgetc(f)) != EOF) p_vec_push(v, (void*)(intptr_t)c);");
    wln(self, "    fclose(f); return v;");
    wln(self, "}");
    wln(self, "int64_t p_file_write_vec(const char* path, PVec* v) {");
    wln(self, "    FILE* f = fopen(path, \"wb\");");
    wln(self, "    if (!f) return -1;");
    wln(self, "    for (int64_t i = 0; i < v->len; i++) {");
    wln(self, "        unsigned char b = (unsigned char)(int64_t)v->data[i];");
    wln(self, "        fwrite(&b, 1, 1, f);");
    wln(self, "    }");
    wln(self, "    fclose(f); return 0;");
    wln(self, "}");
}

fn emit_runtime_impl(self: &mut CCodeGen) -> void {
    // Rest of runtime implementation
    wln(self, "");
    wln(self, "// --- Runtime implementation ---");
    wln(self, "");
    // Vec runtime
    wln(self, "PVec* p_vec_new(void) {");
    wln(self, "    PVec* v = (PVec*)p_malloc(sizeof(PVec));");
    wln(self, "    v->data = NULL; v->len = 0; v->cap = 0;");
    wln(self, "    return v;");
    wln(self, "}");
    wln(self, "");
    wln(self, "void p_vec_push(PVec* v, void* val) {");
    wln(self, "    if (!v) return;");
    wln(self, "    if (v->len >= v->cap) {");
    wln(self, "        v->cap = v->cap == 0 ? 8 : v->cap * 2;");
    wln(self, "        void** new_data = (void**)p_malloc(v->cap * (int64_t)sizeof(void*));");
    wln(self, "        if (v->data && v->len > 0) { memcpy(new_data, v->data, v->len * sizeof(void*)); }");
    wln(self, "        v->data = new_data;");
    wln(self, "    }");
    wln(self, "    v->data[v->len++] = val;");
    wln(self, "}");
    wln(self, "");
    wln(self, "void* p_vec_get(PVec* v, int64_t idx) {");
    wln(self, "    if (!v || idx < 0 || idx >= v->len) return NULL;");
    wln(self, "    return v->data[idx];");
    wln(self, "}");
    wln(self, "");
    wln(self, "void p_vec_set(PVec* v, int64_t idx, void* val) {");
    wln(self, "    if (!v || idx < 0 || idx >= v->len) return;");
    wln(self, "    v->data[idx] = val;");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_vec_len(PVec* v) { return v ? v->len : 0; }");
    wln(self, "bool p_vec_is_empty(PVec* v) { return v ? v->len == 0 : true; }");
    wln(self, "void p_vec_clear(PVec* v) { if (v) v->len = 0; }");
    wln(self, "int64_t p_vec_pop(PVec* v) {");
    wln(self, "    if (!v || v->len == 0) return 0;");
    wln(self, "    v->len--;");
    wln(self, "    return (int64_t)v->data[v->len];");
    wln(self, "}");
    wln(self, "");
    // Map runtime (simple linear probe)
    wln(self, "PMap* p_map_new(void) {");
    wln(self, "    PMap* m = (PMap*)p_malloc(sizeof(PMap));");
    wln(self, "    m->keys = NULL; m->vals = NULL; m->len = 0; m->cap = 0;");
    wln(self, "    return m;");
    wln(self, "}");
    wln(self, "");
    wln(self, "void p_map_insert(PMap* m, const char* key, int64_t val) {");
    wln(self, "    if (!m || !key) return;");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) {");
    wln(self, "        if (strcmp(m->keys[i], key) == 0) { m->vals[i] = val; return; }");
    wln(self, "    }");
    wln(self, "    if (m->len >= m->cap) {");
    wln(self, "        m->cap = m->cap == 0 ? 8 : m->cap * 2;");
    wln(self, "        char** new_keys = (char**)p_malloc(m->cap * (int64_t)sizeof(char*));");
    wln(self, "        int64_t* new_vals = (int64_t*)p_malloc(m->cap * (int64_t)sizeof(int64_t));");
    wln(self, "        if (m->keys && m->len > 0) { memcpy(new_keys, m->keys, m->len * sizeof(char*)); memcpy(new_vals, m->vals, m->len * sizeof(int64_t)); }");
    wln(self, "        m->keys = new_keys;");
    wln(self, "        m->vals = new_vals;");
    wln(self, "    }");
    wln(self, "    { size_t klen = strlen(key); char* kcopy = (char*)p_malloc((int64_t)(klen + 1)); memcpy(kcopy, key, klen + 1); m->keys[m->len] = kcopy; }");
    wln(self, "    m->vals[m->len] = val;");
    wln(self, "    m->len++;");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_map_get(PMap* m, const char* key) {");
    wln(self, "    if (!m || !key) return 0;");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) {");
    wln(self, "        if (strcmp(m->keys[i], key) == 0) return m->vals[i];");
    wln(self, "    }");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "");
    wln(self, "bool p_map_contains(PMap* m, const char* key) {");
    wln(self, "    if (!m || !key) return false;");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) {");
    wln(self, "        if (strcmp(m->keys[i], key) == 0) return true;");
    wln(self, "    }");
    wln(self, "    return false;");
    wln(self, "}");
    wln(self, "");
    wln(self, "void p_map_remove(PMap* m, const char* key) {");
    wln(self, "    if (!m || !key) return;");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) {");
    wln(self, "        if (strcmp(m->keys[i], key) == 0) {");
    wln(self, "            free(m->keys[i]);");
    wln(self, "            m->keys[i] = m->keys[m->len-1];");
    wln(self, "            m->vals[i] = m->vals[m->len-1];");
    wln(self, "            m->len--;");
    wln(self, "            return;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_map_len(PMap* m) { return m ? m->len : 0; }");
    wln(self, "bool p_map_is_empty(PMap* m) { return m ? m->len == 0 : true; }");
    wln(self, "void p_map_clear(PMap* m) { if (m) m->len = 0; }");
    wln(self, "");
    wln(self, "// Phase 10B: p_map_keys returns a Fides Vec (i64 pointer)");
    wln(self, "int64_t p_map_keys(PMap* m) {");
    wln(self, "    PVec* v = p_vec_new();");
    wln(self, "    for (int64_t i = 0; i < m->len; i++)");
    wln(self, "        p_vec_push(v, (void*)m->keys[i]);");
    wln(self, "    return (int64_t)v;");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_map_values(PMap* m) {");
    wln(self, "    PVec* v = p_vec_new();");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) {");
    wln(self, "        p_vec_push(v, (void*)m->vals[i]);");
    wln(self, "    }");
    wln(self, "    return (int64_t)v;");
    wln(self, "}");
    wln(self, "");
    // String runtime
    wln(self, "int64_t p_string_len(const char* s) { return s ? (int64_t)strlen(s) : 0; }");
    wln(self, "bool p_string_is_empty(const char* s) { return !s || s[0] == 0; }");
    wln(self, "");
    wln(self, "char* p_string_push_str(const char* s, const char* other) {");
    wln(self, "    if (!s) s = \"\"; if (!other) other = \"\";");
    wln(self, "    size_t len = strlen(s) + strlen(other);");
    wln(self, "    char* result = (char*)p_malloc((int64_t)(len + 1));");
    wln(self, "    strcpy(result, s);");
    wln(self, "    strcat(result, other);");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "");
    wln(self, "char* p_string_from(const char* s) {");
    wln(self, "    if (!s) s = \"\";");
    wln(self, "    size_t len = strlen(s);");
    wln(self, "    char* result = (char*)p_malloc((int64_t)(len + 1));");
    wln(self, "    memcpy(result, s, len + 1);");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "");
    wln(self, "char* p_string_slice(const char* s, int64_t start, int64_t end) {");
    wln(self, "    if (!s) { char* r = (char*)p_malloc(1); r[0] = 0; return r; }");
    wln(self, "    int64_t len = (int64_t)strlen(s);");
    wln(self, "    if (start < 0) start = 0;");
    wln(self, "    if (end > len) end = len;");
    wln(self, "    if (start > end) start = end;");
    wln(self, "    int64_t slen = end - start;");
    wln(self, "    char* result = (char*)p_malloc(slen + 1);");
    wln(self, "    memcpy(result, s + start, slen);");
    wln(self, "    result[slen] = 0;");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "");
    wln(self, "char* p_to_str(int64_t val) {");
    wln(self, "    char* buf = (char*)p_malloc(32);");
    wln(self, "    snprintf(buf, 32, \"%lld\", (long long)val);");
    wln(self, "    return buf;");
    wln(self, "}");
    wln(self, "");
    wln(self, "char* p_str_concat(const char* a, const char* b) {");
    wln(self, "    size_t len = strlen(a) + strlen(b);");
    wln(self, "    char* result = (char*)p_malloc((int64_t)(len + 1));");
    wln(self, "    strcpy(result, a);");
    wln(self, "    strcat(result, b);");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "");
    // Efficient join: calculates total length first, allocates once, copies.
    // parts is a Vec<str> (PVec of char* pointers).
    wln(self, "char* p_str_join_n(PVec* parts) {");
    wln(self, "    size_t total = 1; /* null terminator */");
    wln(self, "    for (int64_t i = 0; i < parts->len; i++) {");
    wln(self, "        total += strlen((char*)parts->data[i]);");
    wln(self, "    }");
    wln(self, "    char* result = (char*)p_malloc((int64_t)total);");
    wln(self, "    result[0] = 0;");
    wln(self, "    for (int64_t i = 0; i < parts->len; i++) {");
    wln(self, "        strcat(result, (char*)parts->data[i]);");
    wln(self, "    }");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "");
    // Mutable string builder - avoids O(n^2) memory from repeated str_concat.
    // Uses realloc-based growth (via p_malloc_persistent) so old buffers are freed.
    wln(self, "typedef struct { char* buf; int64_t len; int64_t cap; } PStrBuilder;");
    wln(self, "int64_t p_sb_new(void) {");
    wln(self, "    PStrBuilder* sb = (PStrBuilder*)p_malloc_persistent(sizeof(PStrBuilder));");
    wln(self, "    sb->cap = 4096;");
    wln(self, "    sb->len = 0;");
    wln(self, "    sb->buf = (char*)p_malloc_persistent(sb->cap);");
    wln(self, "    sb->buf[0] = 0;");
    wln(self, "    return (int64_t)sb;");
    wln(self, "}");
    wln(self, "void p_sb_append(int64_t sbv, const char* s) {");
    wln(self, "    PStrBuilder* sb = (PStrBuilder*)sbv;");
    wln(self, "    int64_t slen = (int64_t)strlen(s);");
    wln(self, "    if (sb->len + slen + 1 > sb->cap) {");
    wln(self, "        while (sb->len + slen + 1 > sb->cap) sb->cap *= 2;");
    wln(self, "        char* nb = (char*)p_malloc_persistent(sb->cap);");
    wln(self, "        memcpy(nb, sb->buf, sb->len);");
    wln(self, "        nb[sb->len] = 0;");
    wln(self, "        sb->buf = nb; /* old buffer leaked in persistent pool - acceptable */");
    wln(self, "    }");
    wln(self, "    memcpy(sb->buf + sb->len, s, slen);");
    wln(self, "    sb->len += slen;");
    wln(self, "    sb->buf[sb->len] = 0;");
    wln(self, "}");
    wln(self, "char* p_sb_to_str(int64_t sbv) {");
    wln(self, "    PStrBuilder* sb = (PStrBuilder*)sbv;");
    wln(self, "    char* result = (char*)p_malloc(sb->len + 1);");
    wln(self, "    memcpy(result, sb->buf, sb->len);");
    wln(self, "    result[sb->len] = 0;");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "");
    // One write per print: stdout is unbuffered, and printf then writes each
    // byte on its own on Windows (a 2 MB string took 8 seconds).
    wln(self, "void p_print(int64_t val) { char b[32]; int n = snprintf(b, sizeof b, \"%lld\", (long long)val); fwrite(b, 1, (size_t)n, stdout); }");
    wln(self, "void p_print_str(const char* s) { fwrite(s, 1, strlen(s), stdout); }");
    wln(self, "void p_eprint_str(const char* s) { fwrite(s, 1, strlen(s), stderr); fflush(stderr); }");
    wln(self, "void p_flush_stdout(void) { fflush(stdout); }");
    wln(self, "void p_print_int(int64_t val) { char b[32]; int n = snprintf(b, sizeof b, \"%lld\", (long long)val); fwrite(b, 1, (size_t)n, stdout); }");
    wln(self, "void p_print_bool(bool val) { if (val) fwrite(\"true\", 1, 4, stdout); else fwrite(\"false\", 1, 5, stdout); }");
    wln(self, "void p_print_float(double val) { char* _s = p_to_str_float(val); fwrite(_s, 1, strlen(_s), stdout); free(_s); }");
    wln(self, "void p_print_newline(void) { fwrite(\"\\n\", 1, 1, stdout); }");
    wln(self, "/* Crashes, stack overflow and panic traces. Nothing is recorded per call:");
    wln(self, "   a trace walks the machine stack and names each frame that starts at a");
    wln(self, "   Fides function; a stack overflow hits the OS guard page, and its handler");
    wln(self, "   runs on reserved stack. */");
    wln(self, "typedef struct { const void* addr; const char* name; } __p_fn_entry;");
    wln(self, "extern const __p_fn_entry __p_fns[];");
    wln(self, "extern const int __p_fn_count;");
    wln(self, "static __p_fn_entry* __p_fns_sorted = NULL;");
    wln(self, "static int __p_fn_cmp(const void* a, const void* b) {");
    wln(self, "    uintptr_t x = (uintptr_t)((const __p_fn_entry*)a)->addr, y = (uintptr_t)((const __p_fn_entry*)b)->addr;");
    wln(self, "    return x < y ? -1 : x > y;");
    wln(self, "}");
    wln(self, "static const char* __p_fn_name(uintptr_t start) {");
    wln(self, "    if (!__p_fns_sorted) {");
    wln(self, "        __p_fns_sorted = (__p_fn_entry*)malloc(sizeof(__p_fn_entry) * (size_t)(__p_fn_count + 1));");
    wln(self, "        if (!__p_fns_sorted) return NULL;");
    wln(self, "        memcpy(__p_fns_sorted, __p_fns, sizeof(__p_fn_entry) * (size_t)__p_fn_count);");
    wln(self, "        qsort(__p_fns_sorted, (size_t)__p_fn_count, sizeof(__p_fn_entry), __p_fn_cmp);");
    wln(self, "    }");
    wln(self, "    int lo = 0, hi = __p_fn_count - 1;");
    wln(self, "    while (lo <= hi) {");
    wln(self, "        int mid = (lo + hi) / 2;");
    wln(self, "        uintptr_t a = (uintptr_t)__p_fns_sorted[mid].addr;");
    wln(self, "        if (a == start) return __p_fns_sorted[mid].name;");
    wln(self, "        if (a < start) lo = mid + 1; else hi = mid - 1;");
    wln(self, "    }");
    wln(self, "    return NULL;");
    wln(self, "}");
    wln(self, "#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__)) && !defined(__TINYC__)");
    wln(self, "#include <windows.h>");
    wln(self, "/* Where the function of each frame starts, from the unwind tables. ctx: a");
    wln(self, "   CONTEXT to start from (exact: its pc is the faulting one), or NULL. */");
    wln(self, "static int __p_frames(void* ctx, int exact, uintptr_t* out, int max) {");
    wln(self, "    CONTEXT c;");
    wln(self, "    if (ctx) c = *(CONTEXT*)ctx; else { RtlCaptureContext(&c); exact = 0; }");
    wln(self, "    int k = 0;");
    wln(self, "    for (int i = 0; i < 256 && k < max && c.Rip; i++) {");
    wln(self, "        DWORD64 pc = (i == 0 && exact) ? c.Rip : c.Rip - 1;");
    wln(self, "        DWORD64 base = 0; PVOID hd = NULL; DWORD64 est = 0;");
    wln(self, "        PRUNTIME_FUNCTION rf = RtlLookupFunctionEntry(pc, &base, NULL);");
    wln(self, "        if (!rf) { c.Rip = *(DWORD64*)c.Rsp; c.Rsp += 8; continue; }");
    wln(self, "        out[k++] = (uintptr_t)(base + rf->BeginAddress);");
    wln(self, "        RtlVirtualUnwind(0, base, pc, rf, &c, &hd, &est, NULL);");
    wln(self, "    }");
    wln(self, "    return k;");
    wln(self, "}");
    wln(self, "#elif (defined(__GNUC__) || defined(__clang__)) && !defined(__TINYC__) && !defined(_WIN32)");
    wln(self, "#include <unwind.h>");
    wln(self, "typedef struct { uintptr_t* out; int n; int max; } __p_unw;");
    wln(self, "static _Unwind_Reason_Code __p_unw_step(struct _Unwind_Context* uc, void* arg) {");
    wln(self, "    __p_unw* u = (__p_unw*)arg;");
    wln(self, "    if (u->n >= u->max) return _URC_END_OF_STACK;");
    wln(self, "    uintptr_t s = (uintptr_t)_Unwind_GetRegionStart(uc);");
    wln(self, "    if (s) u->out[u->n++] = s;");
    wln(self, "    return _URC_NO_REASON;");
    wln(self, "}");
    wln(self, "static int __p_frames(void* ctx, int exact, uintptr_t* out, int max) {");
    wln(self, "    (void)ctx; (void)exact;");
    wln(self, "    __p_unw u = { out, 0, max };");
    wln(self, "    _Unwind_Backtrace(__p_unw_step, &u);");
    wln(self, "    return u.n;");
    wln(self, "}");
    wln(self, "#else");
    wln(self, "static int __p_frames(void* ctx, int exact, uintptr_t* out, int max) { (void)ctx; (void)exact; (void)out; (void)max; return 0; }");
    wln(self, "#endif");
    wln(self, "void __p_print_trace_ctx(void* ctx, int exact) {");
    wln(self, "    uintptr_t f[64];");
    wln(self, "    const char* names[64];");
    wln(self, "    int n = __p_frames(ctx, exact, f, 64), m = 0;");
    wln(self, "    for (int i = 0; i < n; i++) {");
    wln(self, "        const char* name = __p_fn_name(f[i]);");
    wln(self, "        if (name) names[m++] = name;");
    wln(self, "    }");
    wln(self, "    if (m == 0) return;");
    wln(self, "    fprintf(stderr, \"stack trace:\\n    - %s\\n\", names[0]);");
    wln(self, "    for (int i = 1; i < m; ) {");
    wln(self, "        int j = i + 1;");
    wln(self, "        while (j < m && strcmp(names[j], names[i]) == 0) j++;");
    wln(self, "        if (j - i > 1) fprintf(stderr, \"    -| called from %s (%d times)\\n\", names[i], j - i);");
    wln(self, "        else fprintf(stderr, \"    -| called from %s\\n\", names[i]);");
    wln(self, "        i = j;");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "#ifdef _WIN32");
    wln(self, "void __p_thread_guard_init(void) {");
    wln(self, "#if !defined(__TINYC__)");
    wln(self, "    ULONG g = 64 * 1024;");
    wln(self, "    SetThreadStackGuarantee(&g);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "void __p_thread_guard_done(void) {}");
    wln(self, "LONG WINAPI __p_crash_handler(PEXCEPTION_POINTERS ep) {");
    wln(self, "    DWORD code = ep->ExceptionRecord->ExceptionCode;");
    wln(self, "    if (code == EXCEPTION_STACK_OVERFLOW) {");
    wln(self, "        fprintf(stderr, \"\\nStack overflow: the recursion is too deep\\n\");");
    wln(self, "    } else if (code == EXCEPTION_ACCESS_VIOLATION) {");
    wln(self, "        fprintf(stderr, \"\\n=== CRASH: 0x%lX ===\\n\", (unsigned long)code);");
    wln(self, "        fprintf(stderr, \"Access violation at address 0x%llX\\n\", (unsigned long long)ep->ExceptionRecord->ExceptionInformation[1]);");
    wln(self, "    } else {");
    wln(self, "        return EXCEPTION_CONTINUE_SEARCH;");
    wln(self, "    }");
    wln(self, "    __p_print_trace_ctx(ep->ContextRecord, 1);");
    wln(self, "    fflush(stderr);");
    wln(self, "    return EXCEPTION_CONTINUE_SEARCH;");
    wln(self, "}");
    wln(self, "void __p_install_crash_handlers(void) {");
    wln(self, "    SetUnhandledExceptionFilter(__p_crash_handler);");
    wln(self, "    __p_thread_guard_init();");
    wln(self, "}");
    wln(self, "#else");
    wln(self, "#include <signal.h>");
    wln(self, "static P_THREAD_LOCAL char* __p_stack_top;");
    wln(self, "static void __p_sig_handler(int sig, siginfo_t* si, void* uc) {");
    wln(self, "    (void)uc;");
    wln(self, "    const char* name = sig == SIGSEGV ? \"SIGSEGV\" : sig == SIGBUS ? \"SIGBUS\" : sig == SIGABRT ? \"SIGABRT\" : sig == SIGFPE ? \"SIGFPE\" : \"UNKNOWN\";");
    wln(self, "    char* a = (char*)si->si_addr;");
    wln(self, "    if ((sig == SIGSEGV || sig == SIGBUS) && __p_stack_top && a < __p_stack_top && a >= __p_stack_top - (64 << 20))");
    wln(self, "        fprintf(stderr, \"\\nStack overflow: the recursion is too deep\\n\");");
    wln(self, "    else");
    wln(self, "        fprintf(stderr, \"\\n=== CRASH: signal %d (%s) ===\\n\", sig, name);");
    wln(self, "    __p_print_trace_ctx(NULL, 0);");
    wln(self, "    fflush(stderr);");
    wln(self, "    _exit(128 + sig);");
    wln(self, "}");
    wln(self, "/* Each thread: a reserved stack for the handler, so it runs on overflow. */");
    wln(self, "void __p_thread_guard_init(void) {");
    wln(self, "    char here;");
    wln(self, "    __p_stack_top = &here;");
    wln(self, "    stack_t ss;");
    wln(self, "    memset(&ss, 0, sizeof ss);");
    wln(self, "    ss.ss_sp = malloc(64 * 1024);");
    wln(self, "    ss.ss_size = 64 * 1024;");
    wln(self, "    if (ss.ss_sp) sigaltstack(&ss, NULL);");
    wln(self, "}");
    wln(self, "void __p_thread_guard_done(void) {");
    wln(self, "    stack_t ss, old;");
    wln(self, "    memset(&ss, 0, sizeof ss);");
    wln(self, "    ss.ss_flags = SS_DISABLE;");
    wln(self, "    if (sigaltstack(&ss, &old) == 0 && old.ss_sp) free(old.ss_sp);");
    wln(self, "}");
    wln(self, "void __p_install_crash_handlers(void) {");
    wln(self, "    struct sigaction sa;");
    wln(self, "    memset(&sa, 0, sizeof sa);");
    wln(self, "    sa.sa_sigaction = __p_sig_handler;");
    wln(self, "    sa.sa_flags = SA_SIGINFO | SA_ONSTACK;");
    wln(self, "    sigemptyset(&sa.sa_mask);");
    wln(self, "    sigaction(SIGSEGV, &sa, NULL);");
    wln(self, "    sigaction(SIGBUS, &sa, NULL);");
    wln(self, "    sigaction(SIGABRT, &sa, NULL);");
    wln(self, "    sigaction(SIGFPE, &sa, NULL);");
    wln(self, "    __p_thread_guard_init();");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "#ifdef P_PROFILE");
    wln(self, "/* Sampling profiler (fid profile): the call stack every millisecond, written");
    wln(self, "   at exit as collapsed stacks (\"main;f;g 1\"), which flamegraph tools read. */");
    wln(self, "#define P_PROF_DEPTH 64");
    wln(self, "#define P_PROF_MAX 100000");
    wln(self, "static uintptr_t* __p_prof_buf;");
    wln(self, "static volatile long __p_prof_n;");
    wln(self, "static volatile int __p_prof_on;");
    wln(self, "static void __p_prof_record(uintptr_t* f, int n) {");
    wln(self, "    long i = __p_prof_n;");
    wln(self, "    if (i >= P_PROF_MAX) return;");
    wln(self, "    uintptr_t* row = __p_prof_buf + i * P_PROF_DEPTH;");
    wln(self, "    for (int k = 0; k < P_PROF_DEPTH; k++) row[k] = k < n ? f[k] : 0;");
    wln(self, "    __p_prof_n = i + 1;");
    wln(self, "}");
    wln(self, "static void __p_prof_dump(void) {");
    wln(self, "    __p_prof_on = 0;");
    wln(self, "    const char* path = getenv(\"FIDES_PROFILE_OUT\");");
    wln(self, "    if (!path || !*path) path = \"fides-profile.folded\";");
    wln(self, "    FILE* out = fopen(path, \"w\");");
    wln(self, "    if (!out) return;");
    wln(self, "    for (long i = 0; i < __p_prof_n; i++) {");
    wln(self, "        uintptr_t* row = __p_prof_buf + i * P_PROF_DEPTH;");
    wln(self, "        const char* names[P_PROF_DEPTH];");
    wln(self, "        int m = 0;");
    wln(self, "        for (int k = 0; k < P_PROF_DEPTH && row[k]; k++) {");
    wln(self, "            const char* nm = __p_fn_name(row[k]);");
    wln(self, "            if (nm) names[m++] = nm;");
    wln(self, "        }");
    wln(self, "        if (m == 0) continue;");
    wln(self, "        for (int k = m - 1; k >= 0; k--) fprintf(out, k == m - 1 ? \"%s\" : \";%s\", names[k]);");
    wln(self, "        fprintf(out, \" 1\\n\");");
    wln(self, "    }");
    wln(self, "    fclose(out);");
    wln(self, "}");
    wln(self, "#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__)) && !defined(__TINYC__)");
    wln(self, "static HANDLE __p_prof_target;");
    wln(self, "static DWORD WINAPI __p_prof_loop(LPVOID a) {");
    wln(self, "    (void)a;");
    wln(self, "    /* Sleep(1) sleeps a whole 15.6 ms tick: wait on the performance counter */");
    wln(self, "    LARGE_INTEGER fr, t0, t1;");
    wln(self, "    QueryPerformanceFrequency(&fr);");
    wln(self, "    while (__p_prof_on) {");
    wln(self, "        QueryPerformanceCounter(&t0);");
    wln(self, "        do { Sleep(0); QueryPerformanceCounter(&t1); } while ((t1.QuadPart - t0.QuadPart) * 1000 < fr.QuadPart);");
    wln(self, "        if (SuspendThread(__p_prof_target) == (DWORD)-1) break;");
    wln(self, "        CONTEXT c;");
    wln(self, "        memset(&c, 0, sizeof c);");
    wln(self, "        c.ContextFlags = CONTEXT_FULL;");
    wln(self, "        if (GetThreadContext(__p_prof_target, &c)) {");
    wln(self, "            uintptr_t f[P_PROF_DEPTH];");
    wln(self, "            __p_prof_record(f, __p_frames(&c, 1, f, P_PROF_DEPTH));");
    wln(self, "        }");
    wln(self, "        ResumeThread(__p_prof_target);");
    wln(self, "    }");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "void __p_profile_start(void) {");
    wln(self, "    __p_prof_buf = (uintptr_t*)malloc(sizeof(uintptr_t) * P_PROF_DEPTH * P_PROF_MAX);");
    wln(self, "    if (!__p_prof_buf) return;");
    wln(self, "    DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &__p_prof_target, 0, FALSE, DUPLICATE_SAME_ACCESS);");
    wln(self, "    __p_prof_on = 1;");
    wln(self, "    atexit(__p_prof_dump);");
    wln(self, "    CreateThread(NULL, 0, __p_prof_loop, NULL, 0, NULL);");
    wln(self, "}");
    wln(self, "#elif !defined(_WIN32) && (defined(__GNUC__) || defined(__clang__)) && !defined(__TINYC__)");
    wln(self, "#include <sys/time.h>");
    wln(self, "static void __p_prof_tick(int sig) {");
    wln(self, "    (void)sig;");
    wln(self, "    if (!__p_prof_on) return;");
    wln(self, "    uintptr_t f[P_PROF_DEPTH];");
    wln(self, "    __p_prof_record(f, __p_frames(NULL, 0, f, P_PROF_DEPTH));");
    wln(self, "}");
    wln(self, "void __p_profile_start(void) {");
    wln(self, "    __p_prof_buf = (uintptr_t*)malloc(sizeof(uintptr_t) * P_PROF_DEPTH * P_PROF_MAX);");
    wln(self, "    if (!__p_prof_buf) return;");
    wln(self, "    __p_prof_on = 1;");
    wln(self, "    atexit(__p_prof_dump);");
    wln(self, "    struct sigaction sa;");
    wln(self, "    memset(&sa, 0, sizeof sa);");
    wln(self, "    sa.sa_handler = __p_prof_tick;");
    wln(self, "    sa.sa_flags = SA_RESTART;");
    wln(self, "    sigemptyset(&sa.sa_mask);");
    wln(self, "    sigaction(SIGPROF, &sa, NULL);");
    wln(self, "    struct itimerval t;");
    wln(self, "    t.it_interval.tv_sec = 0;");
    wln(self, "    t.it_interval.tv_usec = 1000;");
    wln(self, "    t.it_value = t.it_interval;");
    wln(self, "    setitimer(ITIMER_PROF, &t, NULL);");
    wln(self, "}");
    wln(self, "#else");
    wln(self, "void __p_profile_start(void) {}");
    wln(self, "#endif");
    wln(self, "#endif");
    wln(self, "void p_panic(const char* msg) {");
    wln(self, "    fprintf(stderr, \"Panic: %s\\n\", msg);");
    wln(self, "    __p_print_trace_ctx(NULL, 0);");
    wln(self, "    fflush(stdout);");
    wln(self, "    exit(1);");
    wln(self, "}");
    // Chunk-based arena: linked list of fixed-size blocks.
    // New chunks are added to the chain when the current chunk is full.
    // This NEVER invalidates existing pointers (unlike realloc-based growth).
    wln(self, "#define __P_ARENA_CHUNK_SIZE (4*1024*1024)");
    wln(self, "typedef struct __p_arena_chunk { char* base; char* ptr; char* end; struct __p_arena_chunk* next; } __p_arena_chunk;");
    wln(self, "static P_THREAD_LOCAL __p_arena_chunk* __p_arena_head = NULL;");
    wln(self, "static P_THREAD_LOCAL __p_arena_chunk* __p_arena_cur = NULL;");
    wln(self, "static __p_arena_chunk* __p_arena_new_chunk(void) {");
    wln(self, "    __p_arena_chunk* c = (__p_arena_chunk*)malloc(sizeof(__p_arena_chunk));");
    wln(self, "    if (!c) return NULL;");
    wln(self, "    c->base = (char*)malloc(__P_ARENA_CHUNK_SIZE);");
    wln(self, "    if (!c->base) { free(c); return NULL; }");
    wln(self, "    c->ptr = c->base;");
    wln(self, "    c->end = c->base + __P_ARENA_CHUNK_SIZE;");
    wln(self, "    c->next = NULL;");
    wln(self, "    return c;");
    wln(self, "}");
    // Blocks: an 8-byte header (P_BLOCK_MAGIC | size class) and the payload.
    // Classes are powers of two up to 1 MB, refilled from the arena and
    // reused through per-thread free lists; larger blocks go to malloc.
    // A pointer without the magic (a block freed twice) is
    // ignored by p_free. A reused block is zeroed, as fresh memory is.
    wln(self, "#define P_BLOCK_MAGIC 0xF1DE5A0000000000ULL");
    wln(self, "#define P_BLOCK_FREED 0xF1DE5B0000000000ULL");
    wln(self, "#define P_CLASS_LARGE 63");
    wln(self, "static P_THREAD_LOCAL uint64_t* __p_free_lists[41];");
    wln(self, "void* p_malloc(int64_t size) {");
    wln(self, "    if (size < 0) { fprintf(stderr, \"p_malloc: negative size %lld\\n\", (long long)size); abort(); }");
    wln(self, "    size_t total = (size_t)size + 8;");
    wln(self, "    if (total > ((size_t)1 << 20)) {");
    wln(self, "        uint64_t* big = (uint64_t*)calloc(1, total);");
    wln(self, "        if (!big) { fprintf(stderr, \"p_malloc: OOM allocating %zu bytes\\n\", total); abort(); }");
    wln(self, "        big[0] = P_BLOCK_MAGIC | P_CLASS_LARGE;");
    wln(self, "        return big + 1;");
    wln(self, "    }");
    wln(self, "    int k = 4;");
    wln(self, "    while (((size_t)1 << k) < total) k++;");
    wln(self, "    size_t sz = (size_t)1 << k;");
    wln(self, "    k *= 2;");
    wln(self, "    if (k > 8 && total <= sz - sz / 4) { sz -= sz / 4; k--; }");
    wln(self, "    uint64_t* reused = __p_free_lists[k];");
    wln(self, "    if (reused) {");
    wln(self, "        __p_free_lists[k] = (uint64_t*)reused[0];");
    wln(self, "        memset(reused, 0, sz - 8);");
    wln(self, "        reused[-1] = P_BLOCK_MAGIC | (uint64_t)k;");
    wln(self, "        return reused;");
    wln(self, "    }");
    wln(self, "    if (!__p_arena_cur) { __p_arena_cur = __p_arena_new_chunk(); __p_arena_head = __p_arena_cur; }");
    wln(self, "    if (!__p_arena_cur) { fprintf(stderr, \"p_malloc: OOM — failed to create first arena chunk\\n\"); abort(); }");
    wln(self, "    if (__p_arena_cur->ptr + sz > __p_arena_cur->end) {");
    wln(self, "        __p_arena_chunk* nc = __p_arena_new_chunk();");
    wln(self, "        if (!nc) { fprintf(stderr, \"p_malloc: OOM — failed to allocate new arena chunk\\n\"); abort(); }");
    wln(self, "        __p_arena_cur->next = nc;");
    wln(self, "        __p_arena_cur = nc;");
    wln(self, "    }");
    wln(self, "    uint64_t* block = (uint64_t*)__p_arena_cur->ptr;");
    wln(self, "    __p_arena_cur->ptr += sz;");
    wln(self, "    block[0] = P_BLOCK_MAGIC | (uint64_t)k;");
    wln(self, "    return block + 1;");
    wln(self, "}");
    wln(self, "void* p_malloc_persistent(int64_t size) { if (size < 0) return NULL; return malloc((size_t)size); }");
    wln(self, "void* p_alloc(int64_t size) { return p_malloc(size); }");
    wln(self, "void p_free(void* ptr) {");
    wln(self, "    if (!ptr) return;");
    wln(self, "    uint64_t* b = (uint64_t*)ptr;");
    wln(self, "    uint64_t h = b[-1];");
    wln(self, "    if ((h & ~(uint64_t)0xFF) == P_BLOCK_FREED) p_panic(\"Double free\");");
    wln(self, "    if ((h & ~(uint64_t)0xFF) != P_BLOCK_MAGIC) p_panic(\"Invalid free: not an allocated block\");");
    wln(self, "    int k = (int)(h & 0xFF);");
    wln(self, "    b[-1] = P_BLOCK_FREED | (uint64_t)k;");
    wln(self, "    if (k == P_CLASS_LARGE) { free(b - 1); return; }");
    wln(self, "    b[0] = (uint64_t)__p_free_lists[k];");
    wln(self, "    __p_free_lists[k] = b;");
    wln(self, "}");
    // stdlib regions allocate from the arena, so it releases them too.
    wln(self, "void p_region_free(void* region) { (void)region; }");
    // Arena mark: (1-based chunk index << 32) | offset in that chunk.
    // Restoring frees the chunks after the marked one: they only hold
    // memory allocated after the save.
    wln(self, "int64_t p_arena_save(void) {");
    wln(self, "    int64_t idx = 0;");
    wln(self, "    for (__p_arena_chunk* c = __p_arena_head; c; c = c->next) {");
    wln(self, "        idx++;");
    wln(self, "        if (c == __p_arena_cur) return (idx << 32) | (int64_t)(c->ptr - c->base);");
    wln(self, "    }");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "void p_arena_restore(int64_t mark) {");
    // Blocks past the mark may sit in the free lists: drop those lists.
    wln(self, "    memset(__p_free_lists, 0, sizeof(__p_free_lists));");
    wln(self, "    int64_t idx = mark >> 32, off = mark & 0xffffffffLL, i = 0;");
    wln(self, "    __p_arena_chunk* keep = __p_arena_head;");
    wln(self, "    if (!keep) return;");
    wln(self, "    if (idx == 0) { keep->ptr = keep->base; }");
    wln(self, "    else {");
    wln(self, "        for (__p_arena_chunk* c = __p_arena_head; c; c = c->next) { if (++i == idx) { keep = c; break; } }");
    wln(self, "        if (i != idx) return;");
    wln(self, "        keep->ptr = keep->base + off;");
    wln(self, "    }");
    wln(self, "    __p_arena_chunk* c = keep->next;");
    wln(self, "    keep->next = NULL;");
    wln(self, "    while (c) { __p_arena_chunk* n = c->next; free(c->base); free(c); c = n; }");
    wln(self, "    __p_arena_cur = keep;");
    wln(self, "}");
    // File I/O builtins
    wln(self, "char* p_file_read(const char* path) {");
    wln(self, "    FILE* f = fopen(path, \"rb\");");
    wln(self, "    if (!f) return NULL;");
    wln(self, "    fseek(f, 0, SEEK_END); long sz = ftell(f);");
    wln(self, "    if (sz < 0) { fclose(f); return NULL; }");
    wln(self, "    fseek(f, 0, SEEK_SET);");
    wln(self, "    char* buf = (char*)malloc((size_t)sz + 1);");
    wln(self, "    if (!buf) { fclose(f); return NULL; }");
    wln(self, "    size_t rd = fread(buf, 1, (size_t)sz, f); buf[rd] = 0; fclose(f);");
    wln(self, "    return buf;");
    wln(self, "}");
    wln(self, "int64_t p_file_write(const char* path, const char* content) {");
    wln(self, "    FILE* f = fopen(path, \"wb\");");
    wln(self, "    if (!f) return -1;");
    wln(self, "    fputs(content, f); fclose(f); return 0;");
    wln(self, "}");
    wln(self, "int64_t p_file_write_bin(const char* path, const char* data, int64_t len) {");
    wln(self, "    FILE* f = fopen(path, \"wb\");");
    wln(self, "    if (!f) return -1;");
    wln(self, "    fwrite(data, 1, (size_t)len, f); fclose(f); return 0;");
    wln(self, "}");
    wln(self, "bool p_file_exists(const char* path) { FILE* f = fopen(path, \"rb\"); if (f) { fclose(f); return true; } return false; }");
    wln(self, "int64_t p_file_append(const char* path, const char* content) {");
    wln(self, "    FILE* f = fopen(path, \"ab\");");
    wln(self, "    if (!f) return -1;");
    wln(self, "    fputs(content, f); fclose(f); return 0;");
    wln(self, "}");
    wln(self, "int64_t p_file_delete(const char* path) { return remove(path) == 0 ? 0 : -1; }");
    wln(self, "int64_t p_file_size(const char* path) { FILE* f = fopen(path, \"rb\"); if (!f) return -1; fseek(f, 0, SEEK_END); int64_t sz = ftell(f); fclose(f); return sz < 0 ? -1 : sz; }");
    wln(self, "int64_t p_file_hash(const char* path) { FILE* f = fopen(path, \"rb\"); if (!f) return 0; uint64_t h = 0xcbf29ce484222325ULL; unsigned char buf[65536]; size_t n; while ((n = fread(buf, 1, sizeof buf, f)) > 0) { for (size_t i = 0; i < n; i++) { h ^= buf[i]; h *= 0x100000001b3ULL; } } fclose(f); return (int64_t)h; }");
    // Read a line from stdin - returns malloc'd string (caller must not free,
    // arena-managed). Returns NULL on EOF. Strips trailing \n and \r\n.
    wln(self, "char* p_read_line(void) {");
    wln(self, "    static char* __p_line_buf = NULL;");
    wln(self, "    static int __p_line_cap = 0;");
    wln(self, "    if (!__p_line_buf) { __p_line_cap = 4096; __p_line_buf = (char*)p_malloc_persistent(__p_line_cap); }");
    wln(self, "    if (!fgets(__p_line_buf, __p_line_cap, stdin)) return NULL;");
    wln(self, "    int len = (int)strlen(__p_line_buf);");
    wln(self, "    while (len > 0 && (__p_line_buf[len-1] == '\\n' || __p_line_buf[len-1] == '\\r')) { __p_line_buf[--len] = 0; }");
    wln(self, "    return __p_line_buf;");
    wln(self, "}");
    // Check if stdin is at EOF - used by LSP server to detect client disconnect.
    wln(self, "int64_t p_stdin_eof(void) { return (int64_t)feof(stdin); }");
    // Read exactly n bytes from stdin - used by LSP protocol.
    // Returns malloc'd string (nul-terminated). Returns NULL on EOF/error.
    wln(self, "char* p_read_stdin(int64_t n) {");
    wln(self, "    char* buf = (char*)p_malloc_persistent(n + 1);");
    wln(self, "    if (!buf) return NULL;");
    wln(self, "    int64_t total = 0;");
    wln(self, "    while (total < n) {");
    wln(self, "        int64_t rd = (int64_t)fread(buf + total, 1, (size_t)(n - total), stdin);");
    wln(self, "        if (rd <= 0) { if (total == 0) return NULL; break; }");
    wln(self, "        total += rd;");
    wln(self, "    }");
    wln(self, "    buf[total] = 0;");
    wln(self, "    return buf;");
    wln(self, "}");
    // Environment variable builtins
    wln(self, "char* p_getenv(const char* name) { return getenv(name); }");
    // Command-line argument builtins - globals declared in emit_runtime_types
    wln(self, "int64_t p_argc(void) { return (int64_t)__p_argc; }");
    wln(self, "char* p_argv(int64_t index) { if (index < 0 || index >= __p_argc) return NULL; return __p_argv[index]; }");
    // Process control builtins
    wln(self, "int64_t p_system(const char* cmd) {");
    wln(self, "    int st = system(cmd);");
    wln(self, "#ifdef _WIN32");
    wln(self, "    return (int64_t)st;");
    wln(self, "#else");
    wln(self, "    return WIFEXITED(st) ? (int64_t)WEXITSTATUS(st) : -1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_getpid(void) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    return (int64_t)_getpid();");
    wln(self, "#else");
    wln(self, "    return (int64_t)getpid();");
    wln(self, "#endif");
    wln(self, "}");
    // Captured subprocess results: run stores (out, err, code) in a slot
    // table; the readers return the fields; close frees the slot.
    wln(self, "typedef struct { char* out; char* err; int64_t code; int used; } PProc;");
    wln(self, "static PProc __p_proc_table[128];");
    wln(self, "static char* __p_read_all(const char* path) {");
    wln(self, "    FILE* f = fopen(path, \"rb\");");
    wln(self, "    if (!f) { char* e = (char*)malloc(1); e[0] = 0; return e; }");
    wln(self, "    fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);");
    wln(self, "    if (n < 0) n = 0;");
    wln(self, "    char* buf = (char*)malloc((size_t)n + 1);");
    wln(self, "    size_t got = fread(buf, 1, (size_t)n, f);");
    wln(self, "    buf[got] = 0; fclose(f); return buf;");
    wln(self, "}");
    wln(self, "static char* __p_proc_text(const char* s) {");
    wln(self, "    char* r = (char*)p_malloc((int64_t)strlen(s) + 1);");
    wln(self, "    strcpy(r, s);");
    wln(self, "    return r;");
    wln(self, "}");
    wln(self, "int64_t p_process_run(const char* cmd) {");
    wln(self, "    if (!cmd || !*cmd) return 0;");
    wln(self, "    static int ctr = 0;");
    wln(self, "    int slot = -1;");
    wln(self, "    for (int i = 0; i < 128; i++) if (!__p_proc_table[i].used) { slot = i; break; }");
    wln(self, "    if (slot < 0) return 0;");
    wln(self, "    char of[128], ef[128], full[8192];");
    wln(self, "    snprintf(of, sizeof of, \".fides_proc_%ld_%d.out\", (long)p_getpid(), ctr);");
    wln(self, "    snprintf(ef, sizeof ef, \".fides_proc_%ld_%d.err\", (long)p_getpid(), ctr);");
    wln(self, "    ctr++;");
    wln(self, "    snprintf(full, sizeof full, \"( %s ) > \\\"%s\\\" 2> \\\"%s\\\"\", cmd, of, ef);");
    wln(self, "    int st = system(full);");
    wln(self, "#ifdef _WIN32");
    wln(self, "    __p_proc_table[slot].code = (int64_t)st;");
    wln(self, "#else");
    wln(self, "    __p_proc_table[slot].code = WIFEXITED(st) ? (int64_t)WEXITSTATUS(st) : -1;");
    wln(self, "#endif");
    wln(self, "    __p_proc_table[slot].out = __p_read_all(of);");
    wln(self, "    __p_proc_table[slot].err = __p_read_all(ef);");
    wln(self, "    remove(of); remove(ef);");
    wln(self, "    __p_proc_table[slot].used = 1;");
    wln(self, "    return (int64_t)slot + 1;");
    wln(self, "}");
    wln(self, "char* p_process_stdout(int64_t h) {");
    wln(self, "    if (h < 1 || h > 128 || !__p_proc_table[h-1].used) return \"\";");
    wln(self, "    return __p_proc_text(__p_proc_table[h-1].out);");
    wln(self, "}");
    wln(self, "char* p_process_stderr(int64_t h) {");
    wln(self, "    if (h < 1 || h > 128 || !__p_proc_table[h-1].used) return \"\";");
    wln(self, "    return __p_proc_text(__p_proc_table[h-1].err);");
    wln(self, "}");
    wln(self, "int64_t p_process_code(int64_t h) {");
    wln(self, "    if (h < 1 || h > 128 || !__p_proc_table[h-1].used) return -1;");
    wln(self, "    return __p_proc_table[h-1].code;");
    wln(self, "}");
    wln(self, "void p_process_close(int64_t h) {");
    wln(self, "    if (h < 1 || h > 128 || !__p_proc_table[h-1].used) return;");
    wln(self, "    free(__p_proc_table[h-1].out); free(__p_proc_table[h-1].err);");
    wln(self, "    __p_proc_table[h-1].used = 0;");
    wln(self, "}");
    wln(self, "void p_exit(int64_t code) { exit((int)code); }");
    // Filesystem builtins beyond p_file_*
    wln(self, "int64_t p_mkdir(const char* path) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    return _mkdir(path) == 0 ? 0 : -1;");
    wln(self, "#else");
    wln(self, "    return mkdir(path, 0755) == 0 ? 0 : -1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_rmdir(const char* path) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    return _rmdir(path) == 0 ? 0 : -1;");
    wln(self, "#else");
    wln(self, "    return rmdir(path) == 0 ? 0 : -1;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_rename(const char* a, const char* b) { return rename(a, b) == 0 ? 0 : -1; }");
    wln(self, "bool p_is_dir(const char* path) {");
    wln(self, "    struct stat st;");
    wln(self, "    if (stat(path, &st) != 0) return false;");
    wln(self, "    return (st.st_mode & S_IFMT) == S_IFDIR;");
    wln(self, "}");
    wln(self, "char* p_dir_list(const char* path) {");
    wln(self, "    // entry names joined by '\\n', no \".\"/\"..\"; \"\" on failure");
    wln(self, "    size_t need = 1;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    WIN32_FIND_DATAA fd; char pat[2056];");
    wln(self, "    snprintf(pat, sizeof pat, \"%s\\\\*\", path);");
    wln(self, "    HANDLE h = FindFirstFileA(pat, &fd);");
    wln(self, "    if (h == INVALID_HANDLE_VALUE) { char* e = (char*)malloc(1); e[0] = 0; return e; }");
    wln(self, "    do {");
    wln(self, "        if (strcmp(fd.cFileName, \".\") && strcmp(fd.cFileName, \"..\"))");
    wln(self, "            need += strlen(fd.cFileName) + 1;");
    wln(self, "    } while (FindNextFileA(h, &fd));");
    wln(self, "    FindClose(h);");
    wln(self, "    char* out = (char*)malloc(need);");
    wln(self, "    out[0] = 0;");
    wln(self, "    h = FindFirstFileA(pat, &fd);");
    wln(self, "    if (h == INVALID_HANDLE_VALUE) return out;");
    wln(self, "    int first = 1;");
    wln(self, "    do {");
    wln(self, "        if (strcmp(fd.cFileName, \".\") && strcmp(fd.cFileName, \"..\")) {");
    wln(self, "            if (!first) strcat(out, \"\\n\");");
    wln(self, "            strcat(out, fd.cFileName); first = 0;");
    wln(self, "        }");
    wln(self, "    } while (FindNextFileA(h, &fd));");
    wln(self, "    FindClose(h);");
    wln(self, "    return out;");
    wln(self, "#else");
    wln(self, "    DIR* d = opendir(path);");
    wln(self, "    if (!d) { char* e = (char*)malloc(1); e[0] = 0; return e; }");
    wln(self, "    struct dirent* ent;");
    wln(self, "    while ((ent = readdir(d)) != NULL) {");
    wln(self, "        if (strcmp(ent->d_name, \".\") && strcmp(ent->d_name, \"..\"))");
    wln(self, "            need += strlen(ent->d_name) + 1;");
    wln(self, "    }");
    wln(self, "    rewinddir(d);");
    wln(self, "    char* out = (char*)malloc(need);");
    wln(self, "    out[0] = 0;");
    wln(self, "    int first = 1;");
    wln(self, "    while ((ent = readdir(d)) != NULL) {");
    wln(self, "        if (strcmp(ent->d_name, \".\") && strcmp(ent->d_name, \"..\")) {");
    wln(self, "            if (!first) strcat(out, \"\\n\");");
    wln(self, "            strcat(out, ent->d_name); first = 0;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    closedir(d);");
    wln(self, "    return out;");
    wln(self, "#endif");
    wln(self, "}");
    // Wall-clock timing builtins - use clock_gettime(CLOCK_REALTIME)
    wln(self, "#if defined(__linux__) || defined(__APPLE__)");
    wln(self, "#include <time.h>");
    wln(self, "int64_t p_clock_now(void) { struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); return (int64_t)ts.tv_sec * 1000000000LL + (int64_t)ts.tv_nsec; }");
    wln(self, "int64_t p_clock_now_us(void) { struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); return (int64_t)ts.tv_sec * 1000000LL + (int64_t)ts.tv_nsec / 1000; }");
    wln(self, "int64_t p_clock_now_ms(void) { struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); return (int64_t)ts.tv_sec * 1000LL + (int64_t)ts.tv_nsec / 1000000; }");
    wln(self, "#elif defined(_WIN32)");
    wln(self, "#include <windows.h>");
    wln(self, "/* 100 ns units since 1970: the precise clock (time() has 1 s resolution) */");
    wln(self, "static int64_t __p_now_100ns(void) {");
    wln(self, "    FILETIME ft;");
    wln(self, "#if defined(__TINYC__)");
    wln(self, "    GetSystemTimeAsFileTime(&ft);");
    wln(self, "#else");
    wln(self, "    GetSystemTimePreciseAsFileTime(&ft);");
    wln(self, "#endif");
    wln(self, "    return (int64_t)((((uint64_t)ft.dwHighDateTime) << 32) | ft.dwLowDateTime) - 116444736000000000LL;");
    wln(self, "}");
    wln(self, "int64_t p_clock_now(void) { return __p_now_100ns() * 100; }");
    wln(self, "int64_t p_clock_now_us(void) { return __p_now_100ns() / 10; }");
    wln(self, "int64_t p_clock_now_ms(void) { return __p_now_100ns() / 10000; }");
    wln(self, "#else");
    wln(self, "#include <time.h>");
    wln(self, "int64_t p_clock_now(void) { return (int64_t)time(NULL) * 1000000000LL; }");
    wln(self, "int64_t p_clock_now_us(void) { return (int64_t)time(NULL) * 1000000LL; }");
    wln(self, "int64_t p_clock_now_ms(void) { return (int64_t)time(NULL) * 1000LL; }");
    wln(self, "#endif");
    wln(self, "/* 64 random bits from the operating system's secure generator */");
    wln(self, "#ifdef _WIN32");
    wln(self, "int rand_s(unsigned int* v);");
    wln(self, "int64_t p_os_random_u64(void) {");
    wln(self, "    unsigned int a = 0, b = 0;");
    wln(self, "    if (rand_s(&a) != 0 || rand_s(&b) != 0) p_panic(\"no random source in the operating system\");");
    wln(self, "    return (int64_t)(((uint64_t)a << 32) | b);");
    wln(self, "}");
    wln(self, "#else");
    wln(self, "#include <fcntl.h>");
    wln(self, "#include <unistd.h>");
    wln(self, "int64_t p_os_random_u64(void) {");
    wln(self, "    uint64_t v = 0;");
    wln(self, "    int fd = open(\"/dev/urandom\", O_RDONLY);");
    wln(self, "    if (fd < 0 || read(fd, &v, sizeof v) != (ssize_t)sizeof v) p_panic(\"no random source in the operating system\");");
    wln(self, "    close(fd);");
    wln(self, "    return (int64_t)v;");
    wln(self, "}");
    wln(self, "#endif");
    // Regex builtin - simple wildcard match (? and *)
    wln(self, "bool p_regex_match(const char* s, const char* pattern) {");
    wln(self, "    if (!s || !pattern) return false;");
    wln(self, "    int64_t si = 0, pi = 0, s_len = (int64_t)strlen(s), p_len = (int64_t)strlen(pattern);");
    wln(self, "    int64_t star_s = -1, star_p = -1;");
    wln(self, "    while (si < s_len) {");
    wln(self, "        if (pi < p_len && (pattern[pi] == '?' || pattern[pi] == s[si])) { si++; pi++; }");
    wln(self, "        else if (pi < p_len && pattern[pi] == '*') { star_p = pi; star_s = si; pi++; }");
    wln(self, "        else if (star_p >= 0) { pi = star_p + 1; si = star_s + 1; star_s = si; }");
    wln(self, "        else return false;");
    wln(self, "    }");
    wln(self, "    while (pi < p_len && pattern[pi] == '*') pi++;");
    wln(self, "    return pi == p_len;");
    wln(self, "}");
    // -- Global string interner ----------------------------------------------
    // Interns strings so identical content - same pointer. Enables == (pointer
    // equality) instead of p_str_equal (byte-by-byte) in hot paths.
    // Uses a simple open-addressing hash table with linear probing.
    wln(self, "static char** __p_intern_table = NULL;");
    wln(self, "static int64_t __p_intern_cap = 0;");
    wln(self, "static int64_t __p_intern_count = 0;");
    wln(self, "static int64_t __p_intern_hash(const char* s) {");
    wln(self, "    int64_t h = 1469598103934665603ULL;");
    wln(self, "    while (*s) { h ^= (unsigned char)*s; h *= 1099511628211ULL; s++; }");
    wln(self, "    return h;");
    wln(self, "}");
    wln(self, "static void __p_intern_grow(void) {");
    wln(self, "    int64_t new_cap = __p_intern_cap == 0 ? 4096 : __p_intern_cap * 2;");
    wln(self, "    char** new_table = (char**)calloc(new_cap, sizeof(char*));");
    wln(self, "    if (!new_table) { fprintf(stderr, \"p_intern: OOM\\n\"); abort(); }");
    wln(self, "    for (int64_t i = 0; i < __p_intern_cap; i++) {");
    wln(self, "        if (__p_intern_table[i]) {");
    wln(self, "            int64_t h = __p_intern_hash(__p_intern_table[i]) & (new_cap - 1);");
    wln(self, "            while (new_table[h]) h = (h + 1) & (new_cap - 1);");
    wln(self, "            new_table[h] = __p_intern_table[i];");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    free(__p_intern_table);");
    wln(self, "    __p_intern_table = new_table;");
    wln(self, "    __p_intern_cap = new_cap;");
    wln(self, "}");
    wln(self, "const char* p_intern_str(const char* s) {");
    wln(self, "    if (!s) return NULL;");
    wln(self, "    if (__p_intern_count * 2 >= __p_intern_cap) __p_intern_grow();");
    wln(self, "    int64_t mask = __p_intern_cap - 1;");
    wln(self, "    int64_t h = __p_intern_hash(s) & mask;");
    wln(self, "    while (__p_intern_table[h]) {");
    wln(self, "        if (strcmp(__p_intern_table[h], s) == 0) {");
    wln(self, "            return __p_intern_table[h];");
    wln(self, "        }");
    wln(self, "        h = (h + 1) & mask;");
    wln(self, "    }");
    wln(self, "    __p_intern_table[h] = (char*)s;");
    wln(self, "    __p_intern_count++;");
    wln(self, "    return s;");
    wln(self, "}");
    // Async/await runtime (Phase 7.6 + 8A)
    // Future model: p_future_ready wraps a value directly (eager).
    // p_thread_spawn returns a negative handle (-1, -2, ...) for thread-based futures.
    // p_future_poll: if future >= 0, return it (eager). If negative, join the thread.
    wln(self, "#ifdef _WIN32");
    wln(self, "typedef struct { HANDLE h; void* ret; void* (*fn)(void*); void* arg; } __p_win_thread;");
    wln(self, "typedef __p_win_thread* pthread_t;");
    wln(self, "typedef CRITICAL_SECTION pthread_mutex_t;");
    wln(self, "typedef CONDITION_VARIABLE pthread_cond_t;");
    wln(self, "typedef DWORD pthread_key_t;");
    wln(self, "static DWORD WINAPI __p_thread_start(LPVOID p) { __p_win_thread* t = (__p_win_thread*)p; t->ret = t->fn(t->arg); return 0; }");
    wln(self, "static inline int pthread_create(pthread_t* t, void* attr, void* (*fn)(void*), void* arg) { (void)attr; __p_win_thread* w = (__p_win_thread*)malloc(sizeof(__p_win_thread)); if (!w) return -1; w->ret = NULL; w->fn = fn; w->arg = arg; w->h = CreateThread(NULL, 64 * 1024 * 1024, __p_thread_start, w, STACK_SIZE_PARAM_IS_A_RESERVATION, NULL); if (!w->h) { free(w); p_panic(\"could not start a thread\"); } *t = w; return 0; }");
    wln(self, "static inline int pthread_join(pthread_t t, void** ret) { WaitForSingleObject(t->h, INFINITE); CloseHandle(t->h); if (ret) *ret = t->ret; free(t); return 0; }");
    wln(self, "static inline int pthread_mutex_init(pthread_mutex_t* m, void* a) { (void)a; InitializeCriticalSection(m); return 0; }");
    wln(self, "static inline int pthread_mutex_lock(pthread_mutex_t* m) { EnterCriticalSection(m); return 0; }");
    wln(self, "static inline int pthread_mutex_unlock(pthread_mutex_t* m) { LeaveCriticalSection(m); return 0; }");
    wln(self, "static inline int pthread_cond_init(pthread_cond_t* c, void* a) { (void)a; InitializeConditionVariable(c); return 0; }");
    wln(self, "static inline int pthread_cond_wait(pthread_cond_t* c, pthread_mutex_t* m) { SleepConditionVariableCS(c, m, INFINITE); return 0; }");
    wln(self, "static inline int pthread_cond_signal(pthread_cond_t* c) { WakeConditionVariable(c); return 0; }");
    wln(self, "static inline int pthread_cond_broadcast(pthread_cond_t* c) { WakeAllConditionVariable(c); return 0; }");
    wln(self, "static inline int pthread_key_create(pthread_key_t* k, void(*d)(void*)) { (void)d; *k = TlsAlloc(); return *k == TLS_OUT_OF_INDEXES ? -1 : 0; }");
    wln(self, "static inline void* pthread_getspecific(pthread_key_t k) { return TlsGetValue(k); }");
    wln(self, "static inline int pthread_setspecific(pthread_key_t k, const void* v) { return TlsSetValue(k, (LPVOID)v) ? 0 : -1; }");
    wln(self, "#else");
    wln(self, "#include <pthread.h>");
    wln(self, "#endif");
    wln(self, "int64_t p_future_ready(int64_t value) { return value; }");
    // Thread join table - maps negative handle to pthread_t
    wln(self, "static pthread_t p_thread_handles[256];");
    wln(self, "static int p_thread_handle_count = 0;");
    wln(self, "static int64_t p_task_results[256];");
    wln(self, "static int64_t __p_co_await(int64_t future);");
    wln(self, "int64_t p_future_poll(int64_t future) {");
    wln(self, "    if (((uint64_t)future >> 48) == 0x7FA5) return __p_co_await(future);");
    wln(self, "    if (future >= 0) return future; // eager future");
    wln(self, "    // Thread-based future: join and get result");
    wln(self, "    int idx = -(future + 1);");
    wln(self, "    if (idx < 0 || idx >= p_thread_handle_count) return 0;");
    wln(self, "    if (p_thread_handles[idx] == 0) return p_task_results[idx]; // already joined");
    wln(self, "    void* ret = NULL;");
    wln(self, "    pthread_join(p_thread_handles[idx], &ret);");
    wln(self, "    p_task_results[idx] = (int64_t)(intptr_t)ret;");
    wln(self, "    p_thread_handles[idx] = 0;");
    wln(self, "    return p_task_results[idx];");
    wln(self, "}");
    // --- Phase 8A: Threads + atomics + mutex (using pthread) ---
    wln(self, "#ifndef _WIN32");
    wln(self, "#include <stdatomic.h>");
    wln(self, "#endif");
    wln(self, "#ifdef _WIN32");
    wln(self, "typedef long long atomic_int;");
    wln(self, "typedef long long atomic_int_least64_t;");
    wln(self, "static inline long long _p_atomic_load64(atomic_int_least64_t* a) { return InterlockedCompareExchange64(a, 0, 0); }");
    wln(self, "static inline void _p_atomic_store64(atomic_int_least64_t* a, long long v) { InterlockedExchange64(a, v); }");
    wln(self, "static inline long long _p_atomic_add64(atomic_int_least64_t* a, long long v) { return InterlockedExchangeAdd64(a, v); }");
    wln(self, "static inline long long _p_atomic_sub64(atomic_int_least64_t* a, long long v) { return InterlockedExchangeAdd64(a, -v); }");
    wln(self, "static inline int _p_atomic_cas64(atomic_int_least64_t* a, long long* e, long long v) { long long o = InterlockedCompareExchange64(a, v, *e); if (o == *e) return 1; *e = o; return 0; }");
    wln(self, "#define atomic_load(a) _p_atomic_load64((atomic_int_least64_t*)(a))");
    wln(self, "#define atomic_store(a, v) _p_atomic_store64((atomic_int_least64_t*)(a), (v))");
    wln(self, "#define atomic_fetch_add(a, v) _p_atomic_add64((atomic_int_least64_t*)(a), (v))");
    wln(self, "#define atomic_fetch_sub(a, v) _p_atomic_sub64((atomic_int_least64_t*)(a), (v))");
    wln(self, "#define atomic_compare_exchange_strong(a, e, v) _p_atomic_cas64((atomic_int_least64_t*)(a), (e), (v))");
    wln(self, "#define atomic_init(a, v) (*(a) = (v))");
    wln(self, "#endif");
    wln(self, "#include <stdarg.h>");
    // Thread entry point - calls a Fides function by name with i64 args.
    // The function lookup uses a simple dispatch table generated below.
    wln(self, "typedef struct { const char* name; int64_t (*fn)(); } p_thread_entry_t;");
    wln(self, "static p_thread_entry_t p_thread_entries[2048];");
    wln(self, "static int p_thread_entry_count = 0;");
    wln(self, "void p_thread_register(const char* name, int64_t (*fn)()) {");
    wln(self, "    if (p_thread_entry_count < 2048) {");
    wln(self, "        p_thread_entries[p_thread_entry_count].name = name;");
    wln(self, "        p_thread_entries[p_thread_entry_count].fn = fn;");
    wln(self, "        p_thread_entry_count++;");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "typedef struct { int64_t (*fn)(); int64_t nargs; int64_t args[8]; atomic_int* done; } p_thread_arg_t;");
    wln(self, "#ifndef _WIN32");
    wln(self, "#include <ucontext.h>");
    wln(self, "#include <poll.h>");
    wln(self, "#include <time.h>");
    wln(self, "#endif");
    wln(self, "typedef struct __p_co { int64_t (*fn)(); int64_t nargs; int64_t args[8]; int64_t result; int done; int detached;");
    wln(self, "    struct __p_co* awaits; struct __p_co* back;");
    wln(self, "    int64_t fd; int64_t fd_write; int64_t ready; int64_t wake_ms;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    void* fiber;");
    wln(self, "#else");
    wln(self, "    ucontext_t ctx; char* stack;");
    wln(self, "#endif");
    wln(self, "} __p_co;");
    wln(self, "static P_THREAD_LOCAL __p_co** __p_cos = NULL;");
    wln(self, "static P_THREAD_LOCAL int64_t __p_co_count = 0;");
    wln(self, "static P_THREAD_LOCAL int64_t __p_co_cap = 0;");
    wln(self, "static P_THREAD_LOCAL int64_t __p_co_total = 0;");
    wln(self, "static P_THREAD_LOCAL __p_co* __p_co_cur = NULL;");
    wln(self, "#ifdef _WIN32");
    wln(self, "static P_THREAD_LOCAL void* __p_co_sched = NULL;");
    wln(self, "#else");
    wln(self, "static P_THREAD_LOCAL ucontext_t __p_co_sched;");
    wln(self, "#endif");
    wln(self, "#define __P_CO_TAG 0x7FA5");
    wln(self, "static int64_t __p_co_now(void) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    return (int64_t)GetTickCount64();");
    wln(self, "#else");
    wln(self, "    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);");
    wln(self, "    return (int64_t)t.tv_sec * 1000 + t.tv_nsec / 1000000;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "#ifndef _WIN32");
    wln(self, "#include <sys/mman.h>");
    wln(self, "#endif");
    wln(self, "/* A task stack on POSIX, with a guard page at its low end. */");
    wln(self, "#define P_CO_STACK (256 * 1024 + 4096)");
    wln(self, "static void __p_co_leave(void) {");
    wln(self, "    __p_co* c = __p_co_cur;");
    wln(self, "    __p_co* back = c->back;");
    wln(self, "    c->back = NULL;");
    wln(self, "    __p_co_cur = back;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    SwitchToFiber(back ? back->fiber : __p_co_sched);");
    wln(self, "#else");
    wln(self, "    swapcontext(&c->ctx, back ? &back->ctx : &__p_co_sched);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "static void __p_co_enter(__p_co* c) {");
    wln(self, "    __p_co* from = __p_co_cur;");
    wln(self, "    __p_co_cur = c;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    (void)from;");
    wln(self, "    SwitchToFiber(c->fiber);");
    wln(self, "#else");
    wln(self, "    swapcontext(from ? &from->ctx : &__p_co_sched, &c->ctx);");
    wln(self, "#endif");
    wln(self, "    if (c->done) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        DeleteFiber(c->fiber);");
    wln(self, "#else");
    wln(self, "        munmap(c->stack, P_CO_STACK);");
    wln(self, "#endif");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "static void __p_co_body(__p_co* c) {");
    wln(self, "    int64_t (*f)() = c->fn;");
    wln(self, "    int64_t* a = c->args;");
    wln(self, "    switch (c->nargs) {");
    wln(self, "        case 0: c->result = ((int64_t (*)(void*))f)(NULL); break;");
    wln(self, "        case 1: c->result = ((int64_t (*)(void*, int64_t))f)(NULL, a[0]); break;");
    wln(self, "        case 2: c->result = ((int64_t (*)(void*, int64_t, int64_t))f)(NULL, a[0], a[1]); break;");
    wln(self, "        case 3: c->result = ((int64_t (*)(void*, int64_t, int64_t, int64_t))f)(NULL, a[0], a[1], a[2]); break;");
    wln(self, "        case 4: c->result = ((int64_t (*)(void*, int64_t, int64_t, int64_t, int64_t))f)(NULL, a[0], a[1], a[2], a[3]); break;");
    wln(self, "        case 5: c->result = ((int64_t (*)(void*, int64_t, int64_t, int64_t, int64_t, int64_t))f)(NULL, a[0], a[1], a[2], a[3], a[4]); break;");
    wln(self, "        case 6: c->result = ((int64_t (*)(void*, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t))f)(NULL, a[0], a[1], a[2], a[3], a[4], a[5]); break;");
    wln(self, "        case 7: c->result = ((int64_t (*)(void*, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t))f)(NULL, a[0], a[1], a[2], a[3], a[4], a[5], a[6]); break;");
    wln(self, "        default: c->result = ((int64_t (*)(void*, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t))f)(NULL, a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7]); break;");
    wln(self, "    }");
    wln(self, "    c->done = 1;");
    wln(self, "    __p_co_leave();");
    wln(self, "}");
    wln(self, "#ifdef _WIN32");
    wln(self, "static void WINAPI __p_co_start(void* p) { __p_co_body((__p_co*)p); }");
    wln(self, "#else");
    wln(self, "static void __p_co_start(unsigned lo, unsigned hi) { __p_co_body((__p_co*)(((uintptr_t)hi << 32) | lo)); }");
    wln(self, "#endif");
    wln(self, "static __p_co* __p_co_new(const char* name, int64_t nargs, const int64_t* args) {");
    wln(self, "    int64_t (*fn)() = NULL;");
    wln(self, "    for (int i = 0; i < p_thread_entry_count; i++) {");
    wln(self, "        if (strcmp(p_thread_entries[i].name, name) == 0) { fn = p_thread_entries[i].fn; break; }");
    wln(self, "    }");
    wln(self, "    if (!fn) p_panic(\"task: no such function\");");
    wln(self, "#ifdef _WIN32");
    wln(self, "    if (!__p_co_sched) __p_co_sched = ConvertThreadToFiber(NULL);");
    wln(self, "#endif");
    wln(self, "    if (__p_co_count == __p_co_cap) {");
    wln(self, "        __p_co_cap = __p_co_cap ? __p_co_cap * 2 : 64;");
    wln(self, "        __p_cos = (__p_co**)realloc(__p_cos, (size_t)__p_co_cap * sizeof(__p_co*));");
    wln(self, "    }");
    wln(self, "    __p_co* c = (__p_co*)calloc(1, sizeof(__p_co));");
    wln(self, "    c->fn = fn; c->nargs = nargs; c->fd = -1;");
    wln(self, "    for (int64_t i = 0; i < nargs && i < 8; i++) c->args[i] = args[i];");
    wln(self, "#ifdef _WIN32");
    wln(self, "    c->fiber = CreateFiberEx(16384, 1024 * 1024, 0, __p_co_start, c);");
    wln(self, "    if (!c->fiber) p_panic(\"task: out of memory\");");
    wln(self, "#else");
    wln(self, "    c->stack = (char*)mmap(NULL, P_CO_STACK, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);");
    wln(self, "    if (c->stack == MAP_FAILED) p_panic(\"task: out of memory\");");
    wln(self, "    mprotect(c->stack, 4096, PROT_NONE);");
    wln(self, "    getcontext(&c->ctx);");
    wln(self, "    c->ctx.uc_stack.ss_sp = c->stack;");
    wln(self, "    c->ctx.uc_stack.ss_size = P_CO_STACK;");
    wln(self, "    c->ctx.uc_link = NULL;");
    wln(self, "    makecontext(&c->ctx, (void (*)(void))__p_co_start, 2, (unsigned)(uintptr_t)c, (unsigned)((uintptr_t)c >> 32));");
    wln(self, "#endif");
    wln(self, "    __p_cos[__p_co_count++] = c;");
    wln(self, "    __p_co_total++;");
    wln(self, "    return c;");
    wln(self, "}");
    wln(self, "/* One turn of every task that can run. Returns how many are unfinished;");
    wln(self, "   ran says how many took their turn. */");
    wln(self, "static int64_t __p_co_round(int64_t* ran) {");
    wln(self, "    int64_t kept = 0;");
    wln(self, "    *ran = 0;");
    wln(self, "    for (int64_t i = 0; i < __p_co_count; i++) {");
    wln(self, "        __p_co* c = __p_cos[i];");
    wln(self, "        if (c->done) { if (c->detached) free(c); continue; }");
    wln(self, "        if (c->awaits && c->awaits->done) c->awaits = NULL;");
    wln(self, "        if (!c->awaits && c->fd < 0 && !c->wake_ms) {");
    wln(self, "            (*ran)++;");
    wln(self, "            __p_co_enter(c);");
    wln(self, "            if (c->done) { if (c->detached) free(c); continue; }");
    wln(self, "        }");
    wln(self, "        __p_cos[kept++] = c;");
    wln(self, "    }");
    wln(self, "    __p_co_count = kept;");
    wln(self, "    return kept;");
    wln(self, "}");
    wln(self, "/* Sleep until a waiting task can run, at most limit ms (-1: no limit). With");
    wln(self, "   ran set, only look. Panics if no task ever will. Wakes the earliest");
    wln(self, "   deadline only: the next pass takes the next, so timers fire in order. */");
    wln(self, "static void __p_co_wait(int64_t ran, int64_t limit) {");
    wln(self, "    int64_t n = 0;");
    wln(self, "    int64_t timeout = ran ? 0 : limit;");
    wln(self, "    int64_t first = 0;");
    wln(self, "    int64_t now = __p_co_now();");
    wln(self, "#ifdef _WIN32");
    wln(self, "    static P_THREAD_LOCAL WSAPOLLFD* fds = NULL;");
    wln(self, "#else");
    wln(self, "    static P_THREAD_LOCAL struct pollfd* fds = NULL;");
    wln(self, "#endif");
    wln(self, "    static P_THREAD_LOCAL int64_t cap = 0;");
    wln(self, "    if (__p_co_count > cap) {");
    wln(self, "        cap = __p_co_count * 2;");
    wln(self, "        fds = realloc(fds, (size_t)cap * sizeof(*fds));");
    wln(self, "    }");
    wln(self, "    for (int64_t i = 0; i < __p_co_count; i++) {");
    wln(self, "        __p_co* c = __p_cos[i];");
    wln(self, "        if (c->fd >= 0) {");
    wln(self, "            fds[n].fd = (c->fd);");
    wln(self, "            fds[n].events = c->fd_write ? POLLOUT : POLLIN;");
    wln(self, "            fds[n].revents = 0;");
    wln(self, "            n++;");
    wln(self, "        }");
    wln(self, "        if (c->wake_ms) {");
    wln(self, "            if (!first || c->wake_ms < first) first = c->wake_ms;");
    wln(self, "            int64_t left = c->wake_ms > now ? c->wake_ms - now : 0;");
    wln(self, "            if (timeout < 0 || left < timeout) timeout = left;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    if (n == 0 && timeout < 0) p_panic(\"Tasks are deadlocked: each one awaits another\");");
    wln(self, "    if (n > 0) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        WSAPoll(fds, (ULONG)n, (INT)timeout);");
    wln(self, "#else");
    wln(self, "        poll(fds, (nfds_t)n, (int)timeout);");
    wln(self, "#endif");
    wln(self, "    } else if (timeout > 0) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        Sleep((DWORD)timeout);");
    wln(self, "#else");
    wln(self, "        poll(NULL, 0, (int)timeout);");
    wln(self, "#endif");
    wln(self, "    }");
    wln(self, "    now = __p_co_now();");
    wln(self, "    int64_t k = 0;");
    wln(self, "    for (int64_t i = 0; i < __p_co_count; i++) {");
    wln(self, "        __p_co* c = __p_cos[i];");
    wln(self, "        int hit = 0;");
    wln(self, "        if (c->fd >= 0) { hit = fds[k].revents != 0; k++; }");
    wln(self, "        if (hit) { c->ready = 1; c->fd = -1; c->wake_ms = 0; }");
    wln(self, "        else if (c->wake_ms == first && first && first <= now) { c->ready = 0; c->fd = -1; c->wake_ms = 0; }");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "int64_t p_co_go(const char* name, int64_t arg) { return (int64_t)__p_co_new(name, 1, &arg); }");
    wln(self, "int64_t p_co_async(const char* name, int64_t nargs, ...) {");
    wln(self, "    int64_t args[8] = {0};");
    wln(self, "    va_list ap;");
    wln(self, "    va_start(ap, nargs);");
    wln(self, "    for (int64_t i = 0; i < nargs && i < 8; i++) args[i] = va_arg(ap, int64_t);");
    wln(self, "    va_end(ap);");
    wln(self, "    __p_co* c = __p_co_new(name, nargs, args);");
    wln(self, "    c->back = __p_co_cur;");
    wln(self, "    __p_co_enter(c);");
    wln(self, "    return (int64_t)((uint64_t)__P_CO_TAG << 48 | (uint64_t)(uintptr_t)c);");
    wln(self, "}");
    wln(self, "void p_co_yield(void) { if (__p_co_cur) __p_co_leave(); }");
    wln(self, "int64_t p_co_run(void) {");
    wln(self, "    for (;;) {");
    wln(self, "        int64_t ran;");
    wln(self, "        if (__p_co_round(&ran) == 0) return __p_co_total;");
    wln(self, "        __p_co_wait(ran, -1);");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "static int64_t __p_co_await(int64_t future) {");
    wln(self, "    __p_co* c = (__p_co*)(uintptr_t)((uint64_t)future & 0xFFFFFFFFFFFFULL);");
    wln(self, "    while (!c->done) {");
    wln(self, "        if (__p_co_cur) {");
    wln(self, "            __p_co_cur->awaits = c;");
    wln(self, "            __p_co_leave();");
    wln(self, "        } else {");
    wln(self, "            int64_t ran;");
    wln(self, "            __p_co_round(&ran);");
    wln(self, "            if (!c->done) __p_co_wait(ran, -1);");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    return c->result;");
    wln(self, "}");
    wln(self, "int64_t p_co_sleep(int64_t ms) {");
    wln(self, "    if (__p_co_cur) {");
    wln(self, "        __p_co_cur->wake_ms = __p_co_now() + (ms > 0 ? ms : 0) + 1;");
    wln(self, "        __p_co_leave();");
    wln(self, "        return 0;");
    wln(self, "    }");
    wln(self, "    int64_t end = __p_co_now() + ms;");
    wln(self, "    for (;;) {");
    wln(self, "        int64_t ran;");
    wln(self, "        int64_t live = __p_co_round(&ran);");
    wln(self, "        int64_t left = end - __p_co_now();");
    wln(self, "        if (left <= 0) return 0;");
    wln(self, "        if (live) __p_co_wait(ran, left);");
    wln(self, "        else {");
    wln(self, "#ifdef _WIN32");
    wln(self, "            Sleep((DWORD)left);");
    wln(self, "#else");
    wln(self, "            poll(NULL, 0, (int)left);");
    wln(self, "#endif");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "int64_t p_co_wait_fd(int64_t fd, int64_t write, int64_t timeout_ms) {");
    wln(self, "    if (__p_co_cur) {");
    wln(self, "        __p_co_cur->fd = fd;");
    wln(self, "        __p_co_cur->fd_write = write;");
    wln(self, "        __p_co_cur->wake_ms = timeout_ms >= 0 ? __p_co_now() + timeout_ms + 1 : 0;");
    wln(self, "        __p_co_leave();");
    wln(self, "        return __p_co_cur->ready;");
    wln(self, "    }");
    wln(self, "#ifdef _WIN32");
    wln(self, "    WSAPOLLFD one;");
    wln(self, "    one.fd = (SOCKET)fd; one.events = write ? POLLOUT : POLLIN; one.revents = 0;");
    wln(self, "    return WSAPoll(&one, 1, (INT)timeout_ms) > 0;");
    wln(self, "#else");
    wln(self, "    struct pollfd one;");
    wln(self, "    one.fd = (int)fd; one.events = write ? POLLOUT : POLLIN; one.revents = 0;");
    wln(self, "    return poll(&one, 1, (int)timeout_ms) > 0;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "void p_co_detach(int64_t t) {");
    wln(self, "    __p_co* c = (__p_co*)(uintptr_t)t;");
    wln(self, "    if (c->done) free(c);");
    wln(self, "    else c->detached = 1;");
    wln(self, "}");
    wln(self, "int64_t p_co_done(int64_t t) { return (int64_t)((__p_co*)(uintptr_t)t)->done; }");
    wln(self, "int64_t p_co_result(int64_t t) { return ((__p_co*)(uintptr_t)t)->result; }");
    wln(self, "#ifdef _WIN32");
    wln(self, "#define __P_CO_BLOCKED() (WSAGetLastError() == WSAEWOULDBLOCK)");
    wln(self, "#else");
    wln(self, "#include <errno.h>");
    wln(self, "#include <fcntl.h>");
    wln(self, "#define __P_CO_BLOCKED() (errno == EAGAIN || errno == EWOULDBLOCK)");
    wln(self, "#endif");
    wln(self, "static void __p_co_nonblock(int64_t fd) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    u_long on = 1;");
    wln(self, "    ioctlsocket((SOCKET)fd, FIONBIO, &on);");
    wln(self, "#else");
    wln(self, "    fcntl((int)fd, F_SETFL, fcntl((int)fd, F_GETFL, 0) | O_NONBLOCK);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_co_accept(int64_t fd) {");
    wln(self, "    p_co_wait_fd(fd, 0, -1);");
    wln(self, "    int64_t c = p_socket_accept(fd);");
    wln(self, "    if (c >= 0) __p_co_nonblock(c);");
    wln(self, "    return c;");
    wln(self, "}");
    wln(self, "#ifdef _WIN32");
    wln(self, "static void init_winsock(void);");
    wln(self, "#endif");
    wln(self, "int64_t p_co_connect(const char* host, int64_t port) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    init_winsock();");
    wln(self, "#endif");
    wln(self, "    char service[16];");
    wln(self, "    struct addrinfo hints, *res = NULL;");
    wln(self, "    memset(&hints, 0, sizeof(hints));");
    wln(self, "    hints.ai_family = AF_INET;");
    wln(self, "    hints.ai_socktype = SOCK_STREAM;");
    wln(self, "    snprintf(service, sizeof(service), \"%lld\", (long long)port);");
    wln(self, "    if (getaddrinfo(host, service, &hints, &res) != 0 || !res) return -1;");
    wln(self, "    int64_t s = (int64_t)socket(res->ai_family, res->ai_socktype, 0);");
    wln(self, "    if (s >= 0 && connect((SOCKET)s, res->ai_addr, (int)res->ai_addrlen) != 0) {");
    wln(self, "        p_socket_close(s);");
    wln(self, "        s = -1;");
    wln(self, "    }");
    wln(self, "    freeaddrinfo(res);");
    wln(self, "    if (s >= 0) __p_co_nonblock(s);");
    wln(self, "    return s;");
    wln(self, "}");
    wln(self, "int64_t p_co_recv(int64_t fd, int64_t buf, int64_t len, int64_t timeout_ms) {");
    wln(self, "    for (;;) {");
    wln(self, "        int64_t n = p_socket_read(fd, (char*)(uintptr_t)buf, len);");
    wln(self, "        if (n >= 0) return n;");
    wln(self, "        if (!__P_CO_BLOCKED()) return -1;");
    wln(self, "        if (!p_co_wait_fd(fd, 0, timeout_ms)) return -2;");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "int64_t p_co_send(int64_t fd, int64_t buf, int64_t len) {");
    wln(self, "    int64_t done = 0;");
    wln(self, "    while (done < len) {");
    wln(self, "        int64_t n = p_socket_write(fd, (const char*)(uintptr_t)buf + done, len - done);");
    wln(self, "        if (n > 0) done += n;");
    wln(self, "        else if (n < 0 && !__P_CO_BLOCKED()) return -1;");
    wln(self, "        else if (!p_co_wait_fd(fd, 1, 30000)) return -1;");
    wln(self, "    }");
    wln(self, "    return done;");
    wln(self, "}");
    wln(self, "static void* p_thread_wrapper(void* arg) {");
    wln(self, "    p_thread_arg_t* ta = (p_thread_arg_t*)arg;");
    wln(self, "    __p_thread_guard_init();");
    wln(self, "    int64_t result = 0;");
    wln(self, "    // Fides functions have an implicit __env param (void*) as first arg.");
    wln(self, "    // Pass NULL for __env, then the user-provided args.");
    wln(self, "    switch (ta->nargs) {");
    wln(self, "        case 0: { typedef int64_t (*f0)(void*); f0 f = (f0)ta->fn; result = f(NULL); break; }");
    wln(self, "        case 1: { typedef int64_t (*f1)(void*,int64_t); f1 f = (f1)ta->fn; result = f(NULL, ta->args[0]); break; }");
    wln(self, "        case 2: { typedef int64_t (*f2)(void*,int64_t,int64_t); f2 f = (f2)ta->fn; result = f(NULL, ta->args[0], ta->args[1]); break; }");
    wln(self, "        case 3: { typedef int64_t (*f3)(void*,int64_t,int64_t,int64_t); f3 f = (f3)ta->fn; result = f(NULL, ta->args[0], ta->args[1], ta->args[2]); break; }");
    wln(self, "        default: { typedef int64_t (*f4)(void*,int64_t,int64_t,int64_t,int64_t); f4 f = (f4)ta->fn; result = f(NULL, ta->args[0], ta->args[1], ta->args[2], ta->args[3]); break; }");
    wln(self, "    }");
    wln(self, "    if (ta->done) atomic_store(ta->done, 1);");
    wln(self, "    __p_thread_guard_done();");
    wln(self, "    return (void*)(intptr_t)result;");
    wln(self, "}");
    // Phase A1: Executor + non-blocking task poll
    // Executor: just an ID - tasks are tracked via the thread handle table.
    // Task done flags: maps future handle (negative index) to done flag.
    wln(self, "static atomic_int p_task_done_flags[256];");
    wln(self, "static int p_executor_count = 0;");
    wln(self, "int64_t p_executor_new(void) { return (int64_t)(p_executor_count++); }");
    wln(self, "int64_t p_executor_spawn(int64_t exec, const char* func_name, int64_t num_args, ...) {");
    wln(self, "    (void)exec;");
    wln(self, "    int64_t (*fn)() = NULL;");
    wln(self, "    for (int i = 0; i < p_thread_entry_count; i++) {");
    wln(self, "        if (strcmp(p_thread_entries[i].name, func_name) == 0) { fn = p_thread_entries[i].fn; break; }");
    wln(self, "    }");
    wln(self, "    if (!fn) return -1;");
    wln(self, "    p_thread_arg_t* ta = (p_thread_arg_t*)malloc(sizeof(p_thread_arg_t));");
    wln(self, "    ta->fn = fn; ta->nargs = num_args;");
    wln(self, "    va_list ap; va_start(ap, num_args);");
    wln(self, "    for (int64_t i = 0; i < num_args && i < 8; i++) ta->args[i] = va_arg(ap, int64_t);");
    wln(self, "    va_end(ap);");
    wln(self, "    int idx = p_thread_handle_count++;");
    wln(self, "    atomic_init(&p_task_done_flags[idx], 0);");
    wln(self, "    ta->done = &p_task_done_flags[idx];");
    wln(self, "    pthread_t tid; pthread_create(&tid, NULL, p_thread_wrapper, ta);");
    wln(self, "    p_thread_handles[idx] = tid;");
    wln(self, "    return -(int64_t)(idx + 1);");
    wln(self, "}");
    wln(self, "int64_t p_task_poll(int64_t future) {");
    wln(self, "    if (((uint64_t)future >> 48) == 0x7FA5) return p_future_poll(future);");
    wln(self, "    if (future >= 0) return future; // eager future");
    wln(self, "    int idx = -(future + 1);");
    wln(self, "    if (idx < 0 || idx >= p_thread_handle_count) return 0;");
    wln(self, "    if (p_thread_handles[idx] == 0) return p_task_results[idx]; // already joined");
    wln(self, "    // A1: block until done (join). A2 will add non-blocking poll.");
    wln(self, "    void* ret = NULL; pthread_join(p_thread_handles[idx], &ret);");
    wln(self, "    p_task_results[idx] = (int64_t)(intptr_t)ret;");
    wln(self, "    p_thread_handles[idx] = 0;");
    wln(self, "    return p_task_results[idx];");
    wln(self, "}");
    wln(self, "bool p_task_is_ready(int64_t future) {");
    wln(self, "    if (((uint64_t)future >> 48) == 0x7FA5) return p_co_done(future & 0xFFFFFFFFFFFFLL) != 0;");
    wln(self, "    if (future >= 0) return true;");
    wln(self, "    int idx = -(future + 1);");
    wln(self, "    if (idx < 0 || idx >= p_thread_handle_count) return false;");
    wln(self, "    return atomic_load(&p_task_done_flags[idx]) != 0;");
    wln(self, "}");
    wln(self, "int64_t p_executor_block_on(int64_t exec, int64_t future) {");
    wln(self, "    (void)exec;");
    wln(self, "    return p_future_poll(future);");
    wln(self, "}");
    // Cancel the tasks of a scope: a task cannot be stopped mid-way, so
    // wait for any still running (no task outlives its scope), drop their
    // results (0, as in the interpreter), and return how many were cancelled.
    wln(self, "int64_t p_executor_cancel(int64_t exec) {");
    wln(self, "    (void)exec;");
    wln(self, "    int64_t count = 0;");
    wln(self, "    for (int i = 0; i < p_thread_handle_count; i++) {");
    wln(self, "        if (p_thread_handles[i] == 0) continue; // already joined");
    wln(self, "        int was_done = atomic_load(&p_task_done_flags[i]);");
    wln(self, "        void* ret = NULL; pthread_join(p_thread_handles[i], &ret);");
    wln(self, "        p_task_results[i] = was_done ? (int64_t)(intptr_t)ret : 0;");
    wln(self, "        if (!was_done) count++;");
    wln(self, "        p_thread_handles[i] = 0;");
    wln(self, "    }");
    wln(self, "    return count;");
    wln(self, "}");
    wln(self, "int64_t p_executor_run_all(int64_t exec) {");
    wln(self, "    (void)exec;");
    wln(self, "    int64_t count = 0;");
    wln(self, "    for (int i = 0; i < p_thread_handle_count; i++) {");
    wln(self, "        if (p_thread_handles[i] == 0) continue; // already joined");
    wln(self, "        void* ret = NULL; pthread_join(p_thread_handles[i], &ret);");
    wln(self, "        p_task_results[i] = (int64_t)(intptr_t)ret;");
    wln(self, "        p_thread_handles[i] = 0; count++;");
    wln(self, "    }");
    wln(self, "    return count;");
    wln(self, "}");
    // A2: Non-blocking poll - returns PENDING_SENTINEL if task not done
    wln(self, "int64_t p_task_poll_nonblocking(int64_t future) {");
    wln(self, "    if (((uint64_t)future >> 48) == 0x7FA5) return p_co_done(future & 0xFFFFFFFFFFFFLL) ? p_future_poll(future) : (int64_t)0x8000000000000001LL;");
    wln(self, "    if (future >= 0) return future; // eager future");
    wln(self, "    int idx = -(future + 1);");
    wln(self, "    if (idx < 0 || idx >= p_thread_handle_count) return 0;");
    wln(self, "    if (atomic_load(&p_task_done_flags[idx]) == 0) {");
    wln(self, "        return (int64_t)0x8000000000000001LL; // PENDING_SENTINEL");
    wln(self, "    }");
    wln(self, "    if (p_thread_handles[idx] == 0) return p_task_results[idx]; // already joined");
    wln(self, "    void* ret = NULL; pthread_join(p_thread_handles[idx], &ret);");
    wln(self, "    p_task_results[idx] = (int64_t)(intptr_t)ret;");
    wln(self, "    p_thread_handles[idx] = 0;");
    wln(self, "    return p_task_results[idx];");
    wln(self, "}");
    // A2: Non-blocking poll all - returns count of still-pending tasks
    wln(self, "int64_t p_executor_poll_all(int64_t exec) {");
    wln(self, "    (void)exec;");
    wln(self, "    int64_t pending = 0;");
    wln(self, "    for (int i = 0; i < p_thread_handle_count; i++) {");
    wln(self, "        if (p_thread_handles[i] == 0) continue; // already joined");
    wln(self, "        if (atomic_load(&p_task_done_flags[i]) == 0) { pending++; }");
    wln(self, "        else { void* ret = NULL; pthread_join(p_thread_handles[i], &ret); p_task_results[i] = (int64_t)(intptr_t)ret; p_thread_handles[i] = 0; }");
    wln(self, "    }");
    wln(self, "    return pending;");
    wln(self, "}");
    // --- Phase A3: Non-blocking IO (using threads for async) ---
    // Each async IO operation spawns a thread that performs the IO
    // and stores the result. The returned Future handle can be polled.
    wln(self, "#ifndef _WIN32");
    wln(self, "#include <sys/socket.h>");
    wln(self, "#include <netinet/in.h>");
    wln(self, "#include <arpa/inet.h>");
    wln(self, "#include <unistd.h>");
    wln(self, "#include <fcntl.h>");
    wln(self, "#endif");
    // Thread arg for async IO
    wln(self, "typedef struct { int64_t sock; char* buf; int64_t len; int64_t result; atomic_int* done; int op; } p_io_arg_t;");
    wln(self, "// op: 0=connect, 1=read, 2=write, 3=fs_read");
    wln(self, "static void* p_io_worker(void* arg) {");
    wln(self, "    p_io_arg_t* ia = (p_io_arg_t*)arg;");
    wln(self, "    int64_t result = 0;");
    wln(self, "    switch (ia->op) {");
    wln(self, "        case 1: { // read");
    wln(self, "            ssize_t n = recv((int)ia->sock, ia->buf, (size_t)ia->len, 0);");
    wln(self, "            result = (n < 0) ? -1 : (int64_t)n;");
    wln(self, "            break;");
    wln(self, "        }");
    wln(self, "        case 2: { // write");
    wln(self, "            ssize_t n = send((int)ia->sock, ia->buf, (size_t)ia->len, 0);");
    wln(self, "            result = (n < 0) ? -1 : (int64_t)n;");
    wln(self, "            break;");
    wln(self, "        }");
    wln(self, "        case 3: { // fs_read");
    wln(self, "            FILE* f = fopen((const char*)ia->sock, \"rb\");");
    wln(self, "            if (f) {");
    wln(self, "                size_t n = fread(ia->buf, 1, (size_t)ia->len, f);");
    wln(self, "                result = (int64_t)n;");
    wln(self, "                fclose(f);");
    wln(self, "            } else { result = -1; }");
    wln(self, "            break;");
    wln(self, "        }");
    wln(self, "        default: result = 0;");
    wln(self, "    }");
    wln(self, "    ia->result = result;");
    wln(self, "    if (ia->done) atomic_store(ia->done, 1);");
    wln(self, "    return (void*)(intptr_t)result;");
    wln(self, "}");
    wln(self, "// Helper: spawn an IO thread and return a Future handle");
    wln(self, "static int64_t p_io_spawn(int op, int64_t sock, char* buf, int64_t len) {");
    wln(self, "    int idx = p_thread_handle_count++;");
    wln(self, "    atomic_init(&p_task_done_flags[idx], 0);");
    wln(self, "    p_io_arg_t* ia = (p_io_arg_t*)malloc(sizeof(p_io_arg_t));");
    wln(self, "    ia->sock = sock; ia->buf = buf; ia->len = len; ia->result = 0;");
    wln(self, "    ia->done = &p_task_done_flags[idx]; ia->op = op;");
    wln(self, "    pthread_t tid; pthread_create(&tid, NULL, p_io_worker, ia);");
    wln(self, "    p_thread_handles[idx] = tid;");
    wln(self, "    p_task_results[idx] = 0; // will be set by p_task_poll after join");
    wln(self, "    return -(int64_t)(idx + 1);");
    wln(self, "}");
    wln(self, "int64_t p_net_connect(const char* host, int64_t port) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    { WSADATA d; static int ws = 0; if (!ws) { WSAStartup(MAKEWORD(2,2), &d); ws = 1; } }");
    wln(self, "#endif");
    wln(self, "    struct sockaddr_in addr = {0};");
    wln(self, "    addr.sin_family = AF_INET;");
    wln(self, "    addr.sin_port = htons((uint16_t)port);");
    wln(self, "#ifdef _WIN32");
    wln(self, "    if (InetPtonA(AF_INET, host, &addr.sin_addr) != 1) {");
    wln(self, "#else");
    wln(self, "    if (inet_pton(AF_INET, host, &addr.sin_addr) != 1) {");
    wln(self, "#endif");
    wln(self, "        // Not a dotted IP — resolve via getaddrinfo.");
    wln(self, "        struct addrinfo hints = {0}, *res = NULL;");
    wln(self, "        hints.ai_family = AF_INET; hints.ai_socktype = SOCK_STREAM;");
    wln(self, "        char portbuf[16]; snprintf(portbuf, sizeof(portbuf), \"%lld\", (long long)port);");
    wln(self, "        if (getaddrinfo(host, portbuf, &hints, &res) != 0 || !res) return -1;");
    wln(self, "        addr = *(struct sockaddr_in*)res->ai_addr;");
    wln(self, "        freeaddrinfo(res);");
    wln(self, "    }");
    wln(self, "    int sock = socket(AF_INET, SOCK_STREAM, 0);");
    wln(self, "    if (sock < 0) return -1;");
    wln(self, "    if (connect(sock, (struct sockaddr*)&addr, sizeof(addr)) < 0) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        closesocket(sock);");
    wln(self, "#else");
    wln(self, "        close(sock);");
    wln(self, "#endif");
    wln(self, "        return -1;");
    wln(self, "    }");
    wln(self, "    // Return the socket FD as an eager future (positive = ready)");
    wln(self, "    return (int64_t)sock;");
    wln(self, "}");
    wln(self, "int64_t p_net_read(int64_t sock, char* buf, int64_t len) {");
    wln(self, "    return p_io_spawn(1, sock, buf, len);");
    wln(self, "}");
    wln(self, "int64_t p_net_write(int64_t sock, const char* buf, int64_t len) {");
    wln(self, "    return p_io_spawn(2, sock, (char*)buf, len);");
    wln(self, "}");
    wln(self, "void p_net_close(int64_t sock) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    closesocket((SOCKET)sock);");
    wln(self, "#else");
    wln(self, "    close((int)sock);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_fs_read_async(const char* path, char* buf, int64_t len) {");
    wln(self, "    // Use sock field to pass the path pointer (op=3 reads it as path)");
    wln(self, "    return p_io_spawn(3, (int64_t)(intptr_t)path, buf, len);");
    wln(self, "}");
    wln(self, "int64_t p_thread_spawn(const char* func_name, int64_t num_args, ...) {");
    wln(self, "    // Look up function by name");
    wln(self, "    int64_t (*fn)() = NULL;");
    wln(self, "    for (int i = 0; i < p_thread_entry_count; i++) {");
    wln(self, "        if (strcmp(p_thread_entries[i].name, func_name) == 0) {");
    wln(self, "            fn = p_thread_entries[i].fn;");
    wln(self, "            break;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    if (!fn) return -1;");
    wln(self, "    p_thread_arg_t* ta = (p_thread_arg_t*)malloc(sizeof(p_thread_arg_t));");
    wln(self, "    ta->fn = fn;");
    wln(self, "    ta->nargs = num_args;");
    wln(self, "    va_list ap; va_start(ap, num_args);");
    wln(self, "    for (int64_t i = 0; i < num_args && i < 8; i++) ta->args[i] = va_arg(ap, int64_t);");
    wln(self, "    va_end(ap);");
    wln(self, "    int idx = p_thread_handle_count++;");
    wln(self, "    atomic_init(&p_task_done_flags[idx], 0);");
    wln(self, "    ta->done = &p_task_done_flags[idx];");
    wln(self, "    pthread_t tid;");
    wln(self, "    pthread_create(&tid, NULL, p_thread_wrapper, ta);");
    wln(self, "    // Store thread handle and return negative index as Future");
    wln(self, "    p_thread_handles[idx] = tid;");
    wln(self, "    return -(int64_t)(idx + 1);");
    wln(self, "}");
    // p_thread_join — join a thread spawned by p_thread_spawn
    // handle is the negative value returned by p_thread_spawn: -(idx+1)
    wln(self, "void p_thread_join(int64_t handle) {");
    wln(self, "    if (handle >= 0) return; // not a thread handle");
    wln(self, "    int64_t idx = -handle - 1;");
    wln(self, "    if (idx < 0 || idx >= p_thread_handle_count) return;");
    wln(self, "    pthread_join(p_thread_handles[idx], NULL);");
    wln(self, "}");
    // Shared memory - simple malloc-based, atomics use C11 stdatomic
    wln(self, "int64_t p_shared_alloc(int64_t size) { if (size < 0) return 0; uint64_t* b = (uint64_t*)calloc(1, (size_t)size + 8); if (!b) { p_panic(\"p_shared_alloc: out of memory\"); } b[0] = P_BLOCK_MAGIC | P_CLASS_LARGE; return (int64_t)(intptr_t)(b + 1); }");
    wln(self, "int64_t p_atomic_load(int64_t addr) { return atomic_load((atomic_int_least64_t*)(intptr_t)addr); }");
    wln(self, "void p_atomic_store(int64_t addr, int64_t val) { atomic_store((atomic_int_least64_t*)(intptr_t)addr, val); }");
    wln(self, "bool p_atomic_cas(int64_t addr, int64_t expected, int64_t new_val) {");
    wln(self, "    return atomic_compare_exchange_strong((atomic_int_least64_t*)(intptr_t)addr, &expected, new_val);");
    wln(self, "}");
    wln(self, "int64_t p_atomic_add(int64_t addr, int64_t val) { return atomic_fetch_add((atomic_int_least64_t*)(intptr_t)addr, val); }");
    wln(self, "int64_t p_atomic_sub(int64_t addr, int64_t val) { return atomic_fetch_sub((atomic_int_least64_t*)(intptr_t)addr, val); }");
    wln(self, "int64_t p_rc_incr(int64_t rc_addr, int64_t val) { (*(int64_t*)(intptr_t)rc_addr)++; return val; }");
    wln(self, "void p_rc_decr(int64_t rc_addr, int64_t val) {");
    wln(self, "    (void)val;");
    wln(self, "    int64_t* rc = (int64_t*)(intptr_t)rc_addr;");
    wln(self, "    (*rc)--;");
    wln(self, "    if (*rc <= 0) { free((void*)(intptr_t)rc_addr); }");
    wln(self, "}");
    // Mutex - use pthread_mutex_t allocated on heap
    wln(self, "int64_t p_mutex_init(void) {");
    wln(self, "    pthread_mutex_t* m = (pthread_mutex_t*)malloc(sizeof(pthread_mutex_t));");
    wln(self, "    pthread_mutex_init(m, NULL);");
    wln(self, "    return (int64_t)(intptr_t)m;");
    wln(self, "}");
    wln(self, "void p_mutex_lock(int64_t m) { pthread_mutex_lock((pthread_mutex_t*)(intptr_t)m); }");
    wln(self, "void p_mutex_unlock(int64_t m) { pthread_mutex_unlock((pthread_mutex_t*)(intptr_t)m); }");
    // --- Thread-local storage (pthread keys) ---
    wln(self, "int64_t p_tls_create(void) { pthread_key_t key; pthread_key_create(&key, NULL); return (int64_t)key; }");
    wln(self, "int64_t p_tls_get(int64_t key) { return (int64_t)(intptr_t)pthread_getspecific((pthread_key_t)key); }");
    wln(self, "void p_tls_set(int64_t key, int64_t value) { pthread_setspecific((pthread_key_t)key, (void*)(intptr_t)value); }");
    // --- Channels (bounded MPSC queue with mutex + condvar) ---
    // Channel layout: { mutex, cond_not_empty, cond_not_full, head, tail, count, capacity, closed, buffer[capacity] }
    // head = next read index, tail = next write index, count = current items
    // (pthread types already defined above)
    wln(self, "typedef struct {");
    wln(self, "    pthread_mutex_t mutex;");
    wln(self, "    pthread_cond_t not_empty;");
    wln(self, "    pthread_cond_t not_full;");
    wln(self, "    int64_t head;");
    wln(self, "    int64_t tail;");
    wln(self, "    int64_t count;");
    wln(self, "    int64_t capacity;");
    wln(self, "    int closed;");
    wln(self, "    int64_t buffer[]; // flexible array member");
    wln(self, "} p_channel_t;");
    wln(self, "// PENDING_SENTINEL - returned by p_chan_try_recv when channel is empty");
    wln(self, "#define P_CHAN_PENDING ((int64_t)0x8000000000000001LL)");
    wln(self, "int64_t p_chan_create(int64_t capacity) {");
    wln(self, "    if (capacity < 1) capacity = 1;");
    wln(self, "    p_channel_t* ch = (p_channel_t*)malloc(sizeof(p_channel_t) + capacity * sizeof(int64_t));");
    wln(self, "    pthread_mutex_init(&ch->mutex, NULL);");
    wln(self, "    pthread_cond_init(&ch->not_empty, NULL);");
    wln(self, "    pthread_cond_init(&ch->not_full, NULL);");
    wln(self, "    ch->head = 0; ch->tail = 0; ch->count = 0;");
    wln(self, "    ch->capacity = capacity;");
    wln(self, "    ch->closed = 0;");
    wln(self, "    return (int64_t)(intptr_t)ch;");
    wln(self, "}");
    wln(self, "bool p_chan_send(int64_t handle, int64_t val) {");
    wln(self, "    p_channel_t* ch = (p_channel_t*)(intptr_t)handle;");
    wln(self, "    if (!ch) return false;");
    wln(self, "    pthread_mutex_lock(&ch->mutex);");
    wln(self, "    // Block until there's space or the channel is closed");
    wln(self, "    while (ch->count == ch->capacity && !ch->closed) {");
    wln(self, "        pthread_cond_wait(&ch->not_full, &ch->mutex);");
    wln(self, "    }");
    wln(self, "    if (ch->closed) {");
    wln(self, "        pthread_mutex_unlock(&ch->mutex);");
    wln(self, "        return false;");
    wln(self, "    }");
    wln(self, "    ch->buffer[ch->tail] = val;");
    wln(self, "    ch->tail = (ch->tail + 1) % ch->capacity;");
    wln(self, "    ch->count++;");
    wln(self, "    pthread_cond_signal(&ch->not_empty);");
    wln(self, "    pthread_mutex_unlock(&ch->mutex);");
    wln(self, "    return true;");
    wln(self, "}");
    wln(self, "int64_t p_chan_recv(int64_t handle) {");
    wln(self, "    p_channel_t* ch = (p_channel_t*)(intptr_t)handle;");
    wln(self, "    if (!ch) return 0;");
    wln(self, "    pthread_mutex_lock(&ch->mutex);");
    wln(self, "    // Block until there's an item or the channel is closed and empty");
    wln(self, "    while (ch->count == 0 && !ch->closed) {");
    wln(self, "        pthread_cond_wait(&ch->not_empty, &ch->mutex);");
    wln(self, "    }");
    wln(self, "    if (ch->count == 0) {");
    wln(self, "        // Closed and empty");
    wln(self, "        pthread_mutex_unlock(&ch->mutex);");
    wln(self, "        return P_CHAN_PENDING;");
    wln(self, "    }");
    wln(self, "    int64_t val = ch->buffer[ch->head];");
    wln(self, "    ch->head = (ch->head + 1) % ch->capacity;");
    wln(self, "    ch->count--;");
    wln(self, "    pthread_cond_signal(&ch->not_full);");
    wln(self, "    pthread_mutex_unlock(&ch->mutex);");
    wln(self, "    return val;");
    wln(self, "}");
    wln(self, "int64_t p_chan_try_recv(int64_t handle) {");
    wln(self, "    p_channel_t* ch = (p_channel_t*)(intptr_t)handle;");
    wln(self, "    if (!ch) return P_CHAN_PENDING;");
    wln(self, "    pthread_mutex_lock(&ch->mutex);");
    wln(self, "    if (ch->count == 0) {");
    wln(self, "        int closed = ch->closed;");
    wln(self, "        pthread_mutex_unlock(&ch->mutex);");
    wln(self, "        return closed ? 0 : P_CHAN_PENDING;");
    wln(self, "    }");
    wln(self, "    int64_t val = ch->buffer[ch->head];");
    wln(self, "    ch->head = (ch->head + 1) % ch->capacity;");
    wln(self, "    ch->count--;");
    wln(self, "    pthread_cond_signal(&ch->not_full);");
    wln(self, "    pthread_mutex_unlock(&ch->mutex);");
    wln(self, "    return val;");
    wln(self, "}");
    wln(self, "void p_chan_close(int64_t handle) {");
    wln(self, "    p_channel_t* ch = (p_channel_t*)(intptr_t)handle;");
    wln(self, "    if (!ch) return;");
    wln(self, "    pthread_mutex_lock(&ch->mutex);");
    wln(self, "    ch->closed = 1;");
    wln(self, "    // Wake up all blocked senders and receivers");
    wln(self, "    pthread_cond_broadcast(&ch->not_empty);");
    wln(self, "    pthread_cond_broadcast(&ch->not_full);");
    wln(self, "    pthread_mutex_unlock(&ch->mutex);");
    wln(self, "}");
    wln(self, "bool p_chan_is_closed(int64_t handle) {");
    wln(self, "    p_channel_t* ch = (p_channel_t*)(intptr_t)handle;");
    wln(self, "    if (!ch) return true;");
    wln(self, "    pthread_mutex_lock(&ch->mutex);");
    wln(self, "    int closed = ch->closed;");
    wln(self, "    pthread_mutex_unlock(&ch->mutex);");
    wln(self, "    return closed;");
    wln(self, "}");
    // Dynamic loading builtins (Phase 7.7) - simulated to match interpreter
    wln(self, "// Simulated dlopen: returns sequential handles (1, 2, ...) to match interpreter");
    wln(self, "static int64_t dl_handle_counter = 0;");
    wln(self, "int64_t p_dl_open(const char* path) {");
    wln(self, "    if (!path || !*path) return 0;");
    wln(self, "    return ++dl_handle_counter;");
    wln(self, "}");
    wln(self, "int64_t p_dl_sym(int64_t handle, const char* symbol) {");
    wln(self, "    if (handle == 0) return 0;");
    wln(self, "    if (!symbol || !*symbol) return 0;");
    wln(self, "    return 0x1000 + handle * 0x100;");
    wln(self, "}");
    wln(self, "void p_dl_close(int64_t handle) {");
    wln(self, "    (void)handle; // no-op in simulation");
    wln(self, "}");
    wln(self, "int64_t p_dl_call(int64_t func_ptr, int64_t arg) {");
    wln(self, "    (void)func_ptr; // simulated: return arg unchanged");
    wln(self, "    return arg;");
    wln(self, "}");
    // Allocator builtins (Phase 2A.8) - simplified stubs
    wln(self, "void* p_allocator_create(void* arg) { (void)arg; return (void*)1; }");
    wln(self, "int64_t p_allocator_alloc(void* alloc, int64_t size) { (void)alloc; if (size < 0) return 0; return (int64_t)(intptr_t)malloc((size_t)size); }");
    wln(self, "void p_allocator_free(void* alloc, int64_t ptr) { (void)alloc; free((void*)(intptr_t)ptr); }");
    wln(self, "int64_t p_allocator_stats(void* alloc) { (void)alloc; return 0; }");
    wln(self, "int64_t print(int64_t val) { char b[32]; int n = snprintf(b, sizeof b, \"%lld\", (long long)val); fwrite(b, 1, (size_t)n, stdout); return 0; }");
    wln(self, "int64_t print_str(const char* s) { fwrite(s, 1, strlen(s), stdout); return 0; }");
    wln(self, "");
    // String functions
    wln(self, "bool p_string_contains(const char* s, const char* sub) { return s && sub && strstr(s, sub) != NULL; }");
    wln(self, "bool p_string_starts_with(const char* s, const char* prefix) {");
    wln(self, "    if (!s || !prefix) return false;");
    wln(self, "    size_t plen = strlen(prefix);");
    wln(self, "    return strncmp(s, prefix, plen) == 0;");
    wln(self, "}");
    wln(self, "bool p_string_ends_with(const char* s, const char* suffix) {");
    wln(self, "    if (!s || !suffix) return false;");
    wln(self, "    size_t slen = strlen(s), flen = strlen(suffix);");
    wln(self, "    if (flen > slen) return false;");
    wln(self, "    return strcmp(s + slen - flen, suffix) == 0;");
    wln(self, "}");
    wln(self, "int64_t p_string_find(const char* s, const char* sub) {");
    wln(self, "    if (!s || !sub) return -1;");
    wln(self, "    const char* p = strstr(s, sub);");
    wln(self, "    return p ? (int64_t)(p - s) : -1;");
    wln(self, "}");
    wln(self, "char* p_string_trim(const char* s) {");
    wln(self, "    if (!s) { char* r = (char*)p_malloc(1); r[0] = 0; return r; }");
    wln(self, "    while (*s == ' ' || *s == '\\t' || *s == '\\n' || *s == '\\r') s++;");
    wln(self, "    size_t len = strlen(s);");
    wln(self, "    while (len > 0 && (s[len-1] == ' ' || s[len-1] == '\\t' || s[len-1] == '\\n' || s[len-1] == '\\r')) len--;");
    wln(self, "    char* result = (char*)p_malloc((int64_t)(len + 1));");
    wln(self, "    memcpy(result, s, len);");
    wln(self, "    result[len] = 0;");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "char* p_string_to_uppercase(const char* s) {");
    wln(self, "    if (!s) { char* r = (char*)p_malloc(1); r[0] = 0; return r; }");
    wln(self, "    size_t len = strlen(s);");
    wln(self, "    char* result = (char*)p_malloc((int64_t)(len + 1));");
    wln(self, "    for (size_t i = 0; i < len; i++) result[i] = toupper((unsigned char)s[i]);");
    wln(self, "    result[len] = 0;");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "char* p_string_to_lowercase(const char* s) {");
    wln(self, "    if (!s) { char* r = (char*)p_malloc(1); r[0] = 0; return r; }");
    wln(self, "    size_t len = strlen(s);");
    wln(self, "    char* result = (char*)p_malloc((int64_t)(len + 1));");
    wln(self, "    for (size_t i = 0; i < len; i++) result[i] = tolower((unsigned char)s[i]);");
    wln(self, "    result[len] = 0;");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "char* p_string_repeat(const char* s, int64_t n) {");
    wln(self, "    if (!s) { char* r = (char*)p_malloc(1); r[0] = 0; return r; }");
    wln(self, "    if (n < 0) n = 0;");
    wln(self, "    size_t slen = strlen(s);");
    wln(self, "    if (slen > 0 && (size_t)n > (size_t)(-1) / slen) {");
    wln(self, "        char* r = (char*)p_malloc(1); r[0] = 0; return r;");
    wln(self, "    }");
    wln(self, "    size_t total = slen * (size_t)n;");
    wln(self, "    if (total > (size_t)(-1) - 1) {");
    wln(self, "        char* r = (char*)p_malloc(1); r[0] = 0; return r;");
    wln(self, "    }");
    wln(self, "    char* result = (char*)p_malloc((int64_t)(total + 1));");
    wln(self, "    result[0] = 0;");
    wln(self, "    for (int64_t i = 0; i < n; i++) strcat(result, s);");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "char* p_string_replace(const char* s, const char* from, const char* to) {");
    wln(self, "    if (!s) { char* r = (char*)p_malloc(1); r[0] = 0; return r; }");
    wln(self, "    if (!from || !to || !*from) { size_t sl = strlen(s); char* r = (char*)p_malloc((int64_t)(sl + 1)); memcpy(r, s, sl + 1); return r; }");
    wln(self, "    size_t slen = strlen(s), flen = strlen(from), tlen = strlen(to);");
    wln(self, "    char* result = (char*)p_malloc((int64_t)(slen * (tlen > flen ? tlen : flen) + 1));");  // overestimate
    wln(self, "    size_t ri = 0; size_t si = 0;");
    wln(self, "    while (si < slen) {");
    wln(self, "        if (slen - si >= flen && strncmp(s + si, from, flen) == 0) {");
    wln(self, "            memcpy(result + ri, to, tlen); ri += tlen; si += flen;");
    wln(self, "        } else { result[ri++] = s[si++]; }");
    wln(self, "    }");
    wln(self, "    result[ri] = 0;");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "int64_t p_string_split(const char* s, const char* delim) {");
    wln(self, "    PVec* v = p_vec_new();");
    wln(self, "    if (!s || !delim) return (int64_t)v;");
    wln(self, "    const char* start = s;");
    wln(self, "    size_t dlen = strlen(delim);");
    wln(self, "    while (*start) {");
    wln(self, "        const char* p = strstr(start, delim);");
    wln(self, "        if (!p) { p_vec_push(v, (void*)strdup(start)); break; }");
    wln(self, "        size_t len = p - start;");
    wln(self, "        char* part = (char*)malloc(len + 1);");
    wln(self, "        memcpy(part, start, len); part[len] = 0;");
    wln(self, "        p_vec_push(v, (void*)part);");
    wln(self, "        start = p + dlen;");
    wln(self, "    }");
    wln(self, "    return (int64_t)v;");
    wln(self, "}");
    wln(self, "int64_t p_string_parse_int(const char* s) { return s ? (int64_t)atoll(s) : 0; }");
    wln(self, "char* p_string_char_at(const char* s, int64_t idx) {");
    wln(self, "    if (!s) { char* r = (char*)p_malloc(1); r[0] = 0; return r; }");
    wln(self, "    char* result = (char*)p_malloc(2);");
    wln(self, "    result[0] = s[idx]; result[1] = 0;");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "char* p_string_substring(const char* s, int64_t start, int64_t end) {");
    wln(self, "    return p_string_slice(s, start, end);");
    wln(self, "}");
    wln(self, "");
    // Additional vec functions
    wln(self, "int64_t p_vec_capacity(PVec* v) { return v ? v->cap : 0; }");
    wln(self, "PVec* p_vec_clone(PVec* v) {");
    wln(self, "    PVec* c = p_vec_new();");
    wln(self, "    for (int64_t i = 0; i < v->len; i++) p_vec_push(c, v->data[i]);");
    wln(self, "    return c;");
    wln(self, "}");
    wln(self, "bool p_vec_contains(PVec* v, void* val) {");
    wln(self, "    for (int64_t i = 0; i < v->len; i++) if (v->data[i] == val) return true;");
    wln(self, "    return false;");
    wln(self, "}");
    wln(self, "void p_vec_extend(PVec* v, PVec* other) {");
    wln(self, "    for (int64_t i = 0; i < other->len; i++) p_vec_push(v, other->data[i]);");
    wln(self, "}");
    wln(self, "void* p_vec_first(PVec* v) { return v->len > 0 ? v->data[0] : NULL; }");
    wln(self, "void* p_vec_last(PVec* v) { return v->len > 0 ? v->data[v->len - 1] : NULL; }");
    wln(self, "void p_vec_insert(PVec* v, int64_t idx, void* val) {");
    wln(self, "    if (idx < 0 || idx > v->len) return;");
    wln(self, "    if (v->len >= v->cap) { v->cap = v->cap == 0 ? 8 : v->cap * 2; v->data = (void**)realloc(v->data, v->cap * sizeof(void*)); }");
    wln(self, "    memmove(&v->data[idx+1], &v->data[idx], (v->len - idx) * sizeof(void*));");
    wln(self, "    v->data[idx] = val; v->len++;");
    wln(self, "}");
    wln(self, "void* p_vec_remove(PVec* v, int64_t idx) {");
    wln(self, "    if (idx < 0 || idx >= v->len) return NULL;");
    wln(self, "    void* val = v->data[idx];");
    wln(self, "    memmove(&v->data[idx], &v->data[idx+1], (v->len - idx - 1) * sizeof(void*));");
    wln(self, "    v->len--;");
    wln(self, "    return val;");
    wln(self, "}");
    wln(self, "void p_vec_reverse(PVec* v) {");
    wln(self, "    for (int64_t i = 0, j = v->len - 1; i < j; i++, j--) { void* t = v->data[i]; v->data[i] = v->data[j]; v->data[j] = t; }");
    wln(self, "}");
    wln(self, "void p_vec_sort(PVec* v) {");
    wln(self, "    for (int64_t i = 0; i < v->len; i++)");
    wln(self, "        for (int64_t j = i+1; j < v->len; j++)");
    wln(self, "            if ((int64_t)v->data[i] > (int64_t)v->data[j]) { void* t = v->data[i]; v->data[i] = v->data[j]; v->data[j] = t; }");
    wln(self, "}");
    wln(self, "void p_vec_truncate(PVec* v, int64_t len) { if (len < v->len) v->len = len; }");
    wln(self, "");
    // Additional map functions
    wln(self, "PMap* p_map_clone(PMap* m) {");
    wln(self, "    PMap* c = p_map_new();");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) p_map_insert(c, m->keys[i], m->vals[i]);");
    wln(self, "    return c;");
    wln(self, "}");
    wln(self, "int64_t p_map_get_or(PMap* m, const char* key, int64_t default_val) {");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) if (strcmp(m->keys[i], key) == 0) return m->vals[i];");
    wln(self, "    return default_val;");
    wln(self, "}");
    wln(self, "");
    // p_to_str variants
    wln(self, "char* p_to_str_vec(PVec* v) {");
    wln(self, "    char* result = strdup(\"[\");");
    wln(self, "    for (int64_t i = 0; i < v->len; i++) {");
    wln(self, "        if (i > 0) { char* tmp = p_str_concat(result, \", \"); free(result); result = tmp; }");
    wln(self, "        char* s = p_to_str((int64_t)v->data[i]);");
    wln(self, "        char* tmp = p_str_concat(result, s); free(result); free(s); result = tmp;");
    wln(self, "    }");
    wln(self, "    char* tmp = p_str_concat(result, \"]\"); free(result); result = tmp;");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "char* p_to_str_map(PMap* m) {");
    wln(self, "    if (!m) return strdup(\"{}\");");
    wln(self, "    // Sort keys for deterministic output");
    wln(self, "    int64_t* order = (int64_t*)malloc(m->len * sizeof(int64_t));");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) order[i] = i;");
    wln(self, "    for (int64_t i = 0; i < m->len; i++)");
    wln(self, "        for (int64_t j = i+1; j < m->len; j++)");
    wln(self, "            if (strcmp(m->keys[order[i]], m->keys[order[j]]) > 0) { int64_t t = order[i]; order[i] = order[j]; order[j] = t; }");
    wln(self, "    char* result = strdup(\"{\");");
    wln(self, "    for (int64_t i = 0; i < m->len; i++) {");
    wln(self, "        if (i > 0) { char* tmp = p_str_concat(result, \", \"); free(result); result = tmp; }");
    wln(self, "        char* tmp = p_str_concat(result, m->keys[order[i]]); free(result); result = tmp;");
    wln(self, "        tmp = p_str_concat(result, \": \"); free(result); result = tmp;");
    wln(self, "        char* vs = p_to_str(m->vals[order[i]]);");
    wln(self, "        tmp = p_str_concat(result, vs); free(result); free(vs); result = tmp;");
    wln(self, "    }");
    wln(self, "    char* tmp = p_str_concat(result, \"}\"); free(result); result = tmp;");
    wln(self, "    free(order);");
    wln(self, "    return result;");
    wln(self, "}");
    wln(self, "char* p_to_str_str(const char* s) { if (!s) s = \"\"; size_t l = strlen(s); char* r = (char*)p_malloc((int64_t)(l+1)); memcpy(r, s, l+1); return r; }");
    wln(self, "char* p_char_to_str(int64_t val) { char* s = (char*)p_malloc(2); s[0] = (char)val; s[1] = 0; return s; }");
    wln(self, "char* p_to_str_bool(bool val) { char* r = (char*)p_malloc(6); strcpy(r, val ? \"true\" : \"false\"); return r; }");
    wln(self, "char* p_to_str_float(double val) {");
    wln(self, "    char* buf = (char*)malloc(512);");
    wln(self, "    // Match Rust's {} format: shortest representation that round-trips.");
    wln(self, "    // Rust's Display for f64 always uses fixed-point (never scientific notation).");
    wln(self, "    if (val == 0.0) { snprintf(buf, 512, \"0\"); return buf; }");
    wln(self, "    // Calculate required max precision from exponent.");
    wln(self, "    // For 2.22e-16, we need prec=32 (16 zeros + 16 sig digits).");
    wln(self, "    int exp = 0;");
    wln(self, "    double absval = fabs(val);");
    wln(self, "    if (absval >= 1.0) { while (absval >= 10.0) { absval /= 10.0; exp++; } }");
    wln(self, "    else { while (absval < 1.0) { absval *= 10.0; exp--; } }");
    wln(self, "    int max_prec = 17 + (exp < 0 ? -exp : 0);");
    wln(self, "    if (max_prec > 350) max_prec = 350;");
    wln(self, "    // Try increasing precision with %f format (no scientific notation)");
    wln(self, "    for (int prec = 0; prec <= max_prec; prec++) {");
    wln(self, "        snprintf(buf, 512, \"%.*f\", prec, val);");
    wln(self, "        double parsed = strtod(buf, NULL);");
    wln(self, "        if (parsed == val) {");
    wln(self, "            // Trim trailing zeros after decimal point (e.g., \"10.0\" -> \"10\")");
    wln(self, "            char* dot = strchr(buf, '.');");
    wln(self, "            if (dot) {");
    wln(self, "                char* end = buf + strlen(buf) - 1;");
    wln(self, "                while (end > dot && *end == '0') *end-- = '\\0';");
    wln(self, "                if (end == dot) *end = '\\0'; /* remove trailing dot */");
    wln(self, "            }");
    wln(self, "            return buf;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "    // If no precision round-trips, use max precision");
    wln(self, "    snprintf(buf, 512, \"%.*f\", max_prec, val);");
    wln(self, "    return buf;");
    wln(self, "}");
    // Aliases for the new naming convention used by fstring lowering
    wln(self, "char* p_float_to_str(double val) { return p_to_str_float(val); }");
    wln(self, "char* p_bool_to_str(bool val) { return p_to_str_bool(val); }");
    wln(self, "char* p_vec_to_str(PVec* v) { return p_to_str_vec(v); }");
    // SH-4.1: String to float parsing
    wln(self, "double p_str_to_float(const char* s) { if (!s) return 0.0; return atof(s); }");
    // B5: Float bit-pattern conversion (preserve NaN/Inf/-0.0 in ConstFloat)
    wln(self, "int64_t p_f64_to_bits(double val) { union { double d; int64_t i; } u; u.d = val; return u.i; }");
    wln(self, "int64_t p_f32_to_bits(float val) { union { float f; int32_t i; } u; u.f = val; return (int64_t)u.i; }");
    wln(self, "double p_f64_from_bits(int64_t bits) { union { double d; int64_t i; } u; u.i = bits; return u.d; }");
    wln(self, "float p_f32_from_bits(int64_t bits) { union { float f; int32_t i; } u; u.i = (int32_t)bits; return u.f; }");
    wln(self, "double p_int_to_float(int64_t val) { return (double)val; }");
    wln(self, "int64_t p_float_to_int(double val) { return (int64_t)val; }");
    wln(self, "int64_t p_str_to_int(const char* s) { if (!s) return 0; return atoll(s); }");

    // --- Socket builtins (native HTTP server, Phase 5D) ---
    wln(self, "");
    wln(self, "// Socket operations - native POSIX/Winsock implementation");
    wln(self, "#ifdef _WIN32");
    wln(self, "static int ws_initialized = 0;");
    wln(self, "static void init_winsock(void) {");
    wln(self, "    if (!ws_initialized) { WSADATA d; WSAStartup(MAKEWORD(2,2), &d); ws_initialized = 1; }");
    wln(self, "}");
    wln(self, "#endif");
    wln(self, "");
    wln(self, "int64_t p_socket_listen(int64_t port) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    init_winsock();");
    wln(self, "    SOCKET s = socket(AF_INET, SOCK_STREAM, 0);");
    wln(self, "    if (s == INVALID_SOCKET) return -1;");
    wln(self, "#else");
    wln(self, "    int s = socket(AF_INET, SOCK_STREAM, 0);");
    wln(self, "    if (s < 0) return -1;");
    wln(self, "#endif");
    wln(self, "    int opt = 1;");
    wln(self, "    setsockopt((int)s, SOL_SOCKET, SO_REUSEADDR, (char*)&opt, sizeof(opt));");
    wln(self, "    struct sockaddr_in addr;");
    wln(self, "    memset(&addr, 0, sizeof(addr));");
    wln(self, "    addr.sin_family = AF_INET;");
    wln(self, "    addr.sin_addr.s_addr = INADDR_ANY;");
    wln(self, "    addr.sin_port = htons((int)port);");
    wln(self, "    if (bind((int)s, (struct sockaddr*)&addr, sizeof(addr)) < 0) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        closesocket(s);");
    wln(self, "#else");
    wln(self, "        close(s);");
    wln(self, "#endif");
    wln(self, "        return -1;");
    wln(self, "    }");
    wln(self, "    if (listen((int)s, 10) < 0) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "        closesocket(s);");
    wln(self, "#else");
    wln(self, "        close(s);");
    wln(self, "#endif");
    wln(self, "        return -1;");
    wln(self, "    }");
    wln(self, "    return (int64_t)s;");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_socket_accept(int64_t fd) {");
    wln(self, "    struct sockaddr_in client;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    int clen = sizeof(client);");
    wln(self, "    SOCKET c = accept((SOCKET)fd, (struct sockaddr*)&client, &clen);");
    wln(self, "    return (c == INVALID_SOCKET) ? -1 : (int64_t)c;");
    wln(self, "#else");
    wln(self, "    socklen_t clen = sizeof(client);");
    wln(self, "    int c = accept((int)fd, (struct sockaddr*)&client, &clen);");
    wln(self, "    return (int64_t)c;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_socket_read(int64_t fd, char* buf, int64_t max_len) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    int n = recv((SOCKET)fd, buf, (int)max_len, 0);");
    wln(self, "#else");
    wln(self, "    ssize_t n = read((int)fd, buf, (size_t)max_len);");
    wln(self, "#endif");
    wln(self, "    return (n < 0) ? -1 : (int64_t)n;");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_socket_write(int64_t fd, const char* buf, int64_t len) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    int n = send((SOCKET)fd, buf, (int)len, 0);");
    wln(self, "#else");
    wln(self, "    ssize_t n = write((int)fd, buf, (size_t)len);");
    wln(self, "#endif");
    wln(self, "    return (n < 0) ? -1 : (int64_t)n;");
    wln(self, "}");
    wln(self, "");
    wln(self, "int64_t p_socket_write_str(int64_t fd, const char* buf) {");
    wln(self, "    return p_socket_write(fd, buf, strlen(buf));");
    wln(self, "}");
    wln(self, "");
    wln(self, "void p_socket_close(int64_t fd) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    closesocket((SOCKET)fd);");
    wln(self, "#else");
    wln(self, "    close((int)fd);");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "");
    wln(self, "char* p_socket_recv_str(int64_t fd) {");
    wln(self, "    char buf[4096];");
    wln(self, "    int64_t n = p_socket_read(fd, buf, sizeof(buf)-1);");
    wln(self, "    if (n <= 0) return strdup(\"\");");
    wln(self, "    if (n >= (int64_t)sizeof(buf)) n = (int64_t)sizeof(buf)-1;");
    wln(self, "    buf[n] = 0;");
    wln(self, "    return strdup(buf);");
    wln(self, "}");
    wln(self, "");
    wln(self, "// --- Nonblocking sockets + readiness poll (async event loop) ---");
    wln(self, "int64_t p_socket_nonblock(int64_t fd, int64_t on) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    u_long m = on ? 1u : 0u;");
    wln(self, "    return ioctlsocket((SOCKET)fd, FIONBIO, &m);");
    wln(self, "#else");
    wln(self, "    int fl = fcntl((int)fd, F_GETFL, 0);");
    wln(self, "    if (fl < 0) return -1;");
    wln(self, "    return fcntl((int)fd, F_SETFL, on ? (fl | O_NONBLOCK) : (fl & ~O_NONBLOCK));");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_socket_poll(int64_t fd, int64_t timeout_ms, int64_t write_mode) {");
    wln(self, "    fd_set rset, wset; struct timeval tv;");
    wln(self, "    FD_ZERO(&rset); FD_ZERO(&wset);");
    wln(self, "    if (write_mode) FD_SET((SOCKET)fd, &wset); else FD_SET((SOCKET)fd, &rset);");
    wln(self, "    tv.tv_sec = (long)(timeout_ms / 1000);");
    wln(self, "    tv.tv_usec = (long)((timeout_ms % 1000) * 1000);");
    wln(self, "    int n = select((int)(fd + 1), &rset, &wset, NULL, timeout_ms < 0 ? NULL : &tv);");
    wln(self, "    return (int64_t)n;");
    wln(self, "}");
    wln(self, "");
    wln(self, "// --- Signals ---");
    wln(self, "#include <signal.h>");
    wln(self, "static volatile sig_atomic_t p_signal_flags[64] = {0};");
    wln(self, "static void p_signal_trampoline(int s) { if (s >= 0 && s < 64) p_signal_flags[s] = 1; }");
    wln(self, "int64_t p_signal_register(int64_t sig) {");
    wln(self, "    if (sig < 0 || sig >= 64) return -1;");
    wln(self, "    if (signal((int)sig, p_signal_trampoline) == SIG_ERR) return -1;");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "int64_t p_signal_check(int64_t sig) {");
    wln(self, "    if (sig < 0 || sig >= 64) return 0;");
    wln(self, "    int64_t f = p_signal_flags[sig]; p_signal_flags[sig] = 0;");
    wln(self, "    return f;");
    wln(self, "}");
    wln(self, "int64_t p_signal_raise(int64_t sig) { return raise((int)sig); }");
    wln(self, "");
    wln(self, "// --- Memory-mapped files / anonymous mappings ---");
    wln(self, "#ifndef _WIN32");
    wln(self, "#include <sys/mman.h>");
    wln(self, "#include <sys/stat.h>");
    wln(self, "#include <fcntl.h>");
    wln(self, "#endif");
    wln(self, "typedef struct { void* addr; int64_t len; int64_t h1; int64_t h2; int is_file; } p_mmap_entry_t;");
    wln(self, "static p_mmap_entry_t p_mmap_table[256];");
    wln(self, "static int p_mmap_find(void* addr) { for (int i = 0; i < 256; i++) if (p_mmap_table[i].addr == addr) return i; return -1; }");
    wln(self, "static int p_mmap_slot(void) { for (int i = 0; i < 256; i++) if (!p_mmap_table[i].addr) return i; return -1; }");
    wln(self, "int64_t p_mmap_anon(int64_t len) {");
    wln(self, "    if (len <= 0) return 0;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    void* p = VirtualAlloc(NULL, (SIZE_T)len, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);");
    wln(self, "#else");
    wln(self, "    void* p = mmap(NULL, (size_t)len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);");
    wln(self, "    if (p == MAP_FAILED) p = NULL;");
    wln(self, "#endif");
    wln(self, "    if (!p) return 0;");
    wln(self, "    int s = p_mmap_slot(); if (s < 0) return 0;");
    wln(self, "    p_mmap_table[s].addr = p; p_mmap_table[s].len = len; p_mmap_table[s].is_file = 0;");
    wln(self, "    return (int64_t)(intptr_t)p;");
    wln(self, "}");
    wln(self, "int64_t p_mmap_file(const char* path) {");
    wln(self, "#ifdef _WIN32");
    wln(self, "    HANDLE f = CreateFileA(path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);");
    wln(self, "    if (f == INVALID_HANDLE_VALUE) f = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);");
    wln(self, "    if (f == INVALID_HANDLE_VALUE) return 0;");
    wln(self, "    LARGE_INTEGER sz; if (!GetFileSizeEx(f, &sz) || sz.QuadPart == 0) { CloseHandle(f); return 0; }");
    wln(self, "    HANDLE m = CreateFileMappingA(f, NULL, PAGE_READWRITE, 0, 0, NULL);");
    wln(self, "    if (!m) m = CreateFileMappingA(f, NULL, PAGE_READONLY, 0, 0, NULL);");
    wln(self, "    if (!m) { CloseHandle(f); return 0; }");
    wln(self, "    void* p = MapViewOfFile(m, FILE_MAP_ALL_ACCESS, 0, 0, 0);");
    wln(self, "    if (!p) p = MapViewOfFile(m, FILE_MAP_READ, 0, 0, 0);");
    wln(self, "    if (!p) { CloseHandle(m); CloseHandle(f); return 0; }");
    wln(self, "    int s = p_mmap_slot(); if (s < 0) return 0;");
    wln(self, "    p_mmap_table[s].addr = p; p_mmap_table[s].len = (int64_t)sz.QuadPart;");
    wln(self, "    p_mmap_table[s].h1 = (int64_t)(intptr_t)m; p_mmap_table[s].h2 = (int64_t)(intptr_t)f;");
    wln(self, "    p_mmap_table[s].is_file = 1;");
    wln(self, "    return (int64_t)(intptr_t)p;");
    wln(self, "#else");
    wln(self, "    int fd = open(path, O_RDWR); if (fd < 0) fd = open(path, O_RDONLY);");
    wln(self, "    if (fd < 0) return 0;");
    wln(self, "    struct stat st; if (fstat(fd, &st) < 0 || st.st_size == 0) { close(fd); return 0; }");
    wln(self, "    void* p = mmap(NULL, (size_t)st.st_size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);");
    wln(self, "    if (p == MAP_FAILED) p = mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_SHARED, fd, 0);");
    wln(self, "    if (p == MAP_FAILED) { close(fd); return 0; }");
    wln(self, "    int s = p_mmap_slot(); if (s < 0) return 0;");
    wln(self, "    p_mmap_table[s].addr = p; p_mmap_table[s].len = (int64_t)st.st_size;");
    wln(self, "    p_mmap_table[s].h1 = fd; p_mmap_table[s].is_file = 1;");
    wln(self, "    return (int64_t)(intptr_t)p;");
    wln(self, "#endif");
    wln(self, "}");
    wln(self, "int64_t p_mmap_len(int64_t addr) { int s = p_mmap_find((void*)(intptr_t)addr); return s < 0 ? 0 : p_mmap_table[s].len; }");
    wln(self, "int64_t p_munmap(int64_t addr) {");
    wln(self, "    int s = p_mmap_find((void*)(intptr_t)addr); if (s < 0) return -1;");
    wln(self, "    p_mmap_entry_t e = p_mmap_table[s]; p_mmap_table[s].addr = NULL;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    if (e.is_file) { UnmapViewOfFile(e.addr); CloseHandle((HANDLE)(intptr_t)e.h1); CloseHandle((HANDLE)(intptr_t)e.h2); }");
    wln(self, "    else VirtualFree(e.addr, 0, MEM_RELEASE);");
    wln(self, "#else");
    wln(self, "    munmap(e.addr, (size_t)e.len); if (e.is_file) close((int)e.h1);");
    wln(self, "#endif");
    wln(self, "    return 0;");
    wln(self, "}");
    wln(self, "int64_t p_msync(int64_t addr) {");
    wln(self, "    int s = p_mmap_find((void*)(intptr_t)addr); if (s < 0) return -1;");
    wln(self, "#ifdef _WIN32");
    wln(self, "    return FlushViewOfFile(p_mmap_table[s].addr, 0) ? 0 : -1;");
    wln(self, "#else");
    wln(self, "    return msync(p_mmap_table[s].addr, (size_t)p_mmap_table[s].len, MS_SYNC);");
    wln(self, "#endif");
    wln(self, "}");

    // --- Bare metal builtins (Phase 5A) - stubs for C codegen ---
    wln(self, "");
    wln(self, "// Bare metal stubs - no-ops in C codegen (use --bare for real hardware)");
    wln(self, "void p_cli(void) {}");
    wln(self, "void p_sti(void) {}");
    wln(self, "void p_hlt(void) {}");
    wln(self, "int64_t p_cr0_read(void) { return 0; }");
    wln(self, "int64_t p_cr3_read(void) { return 0; }");
    wln(self, "int64_t p_cr4_read(void) { return 0; }");
    wln(self, "void p_cr3_write(int64_t val) { (void)val; }");
    wln(self, "void p_invlpg(int64_t addr) { (void)addr; }");
    wln(self, "void p_page_map(int64_t cr3, int64_t virt, int64_t phys, int64_t flags) { (void)cr3; (void)virt; (void)phys; (void)flags; }");
    wln(self, "void p_page_unmap(int64_t cr3, int64_t virt) { (void)cr3; (void)virt; }");
    wln(self, "static int64_t _phys_mem[65536];");
    wln(self, "int64_t p_phys_read64(int64_t addr) { return _phys_mem[(addr/8) & 65535]; }");
    wln(self, "void p_phys_write64(int64_t addr, int64_t val) { _phys_mem[(addr/8) & 65535] = val; }");
    wln(self, "int64_t p_volatile_load(int64_t addr) { volatile int64_t* p = (volatile int64_t*)(intptr_t)addr; return *p; }");
    wln(self, "void p_volatile_store(int64_t addr, int64_t val) { volatile int64_t* p = (volatile int64_t*)(intptr_t)addr; *p = val; }");
    wln(self, "int64_t p_volatile_load8(int64_t addr) { volatile uint8_t* p = (volatile uint8_t*)(intptr_t)addr; return (int64_t)*p; }");
    wln(self, "int64_t p_volatile_load16(int64_t addr) { volatile uint16_t* p = (volatile uint16_t*)(intptr_t)addr; return (int64_t)*p; }");
    wln(self, "int64_t p_volatile_load32(int64_t addr) { volatile uint32_t* p = (volatile uint32_t*)(intptr_t)addr; return (int64_t)*p; }");
    wln(self, "void p_volatile_store8(int64_t addr, int64_t val) { volatile uint8_t* p = (volatile uint8_t*)(intptr_t)addr; *p = (uint8_t)val; }");
    wln(self, "void p_volatile_store16(int64_t addr, int64_t val) { volatile uint16_t* p = (volatile uint16_t*)(intptr_t)addr; *p = (uint16_t)val; }");
    wln(self, "void p_volatile_store32(int64_t addr, int64_t val) { volatile uint32_t* p = (volatile uint32_t*)(intptr_t)addr; *p = (uint32_t)val; }");
    wln(self, "int64_t p_phys_read8(int64_t addr) { return _phys_mem[(addr/8) & 65535] & 0xFF; }");
    wln(self, "void p_phys_write8(int64_t addr, int64_t val) { _phys_mem[(addr/8) & 65535] = (_phys_mem[(addr/8) & 65535] & ~0xFF) | (val & 0xFF); }");
    wln(self, "int64_t p_phys_read16(int64_t addr) { return _phys_mem[(addr/8) & 65535] & 0xFFFF; }");
    wln(self, "void p_phys_write16(int64_t addr, int64_t val) { _phys_mem[(addr/8) & 65535] = (_phys_mem[(addr/8) & 65535] & ~0xFFFF) | (val & 0xFFFF); }");
    wln(self, "int64_t p_phys_read32(int64_t addr) { return _phys_mem[(addr/8) & 65535] & 0xFFFFFFFF; }");
    wln(self, "void p_phys_write32(int64_t addr, int64_t val) { _phys_mem[(addr/8) & 65535] = (_phys_mem[(addr/8) & 65535] & ~0xFFFFFFFFLL) | (val & 0xFFFFFFFFLL); }");
    wln(self, "int64_t p_inb(int64_t port) { (void)port; return 0; }");
    wln(self, "void p_outb(int64_t port, int64_t val) { (void)port; (void)val; }");
    wln(self, "int64_t p_inw(int64_t port) { (void)port; return 0; }");
    wln(self, "void p_outw(int64_t port, int64_t val) { (void)port; (void)val; }");
    wln(self, "int64_t p_inl(int64_t port) { (void)port; return 0; }");
    wln(self, "void p_outl(int64_t port, int64_t val) { (void)port; (void)val; }");
    wln(self, "int64_t p_msr_read(int64_t addr) { (void)addr; return 0; }");
    wln(self, "void p_msr_write(int64_t addr, int64_t val) { (void)addr; (void)val; }");
    wln(self, "int64_t p_cpuid(int64_t leaf, int64_t subleaf) { (void)leaf; (void)subleaf; return 0; }");
    wln(self, "int64_t p_cpuid_leaf(int64_t leaf) { (void)leaf; return 0; }");
    wln(self, "void p_gdt_set_entry(int64_t gdt, int64_t index, int64_t base, int64_t limit, int64_t flags) { (void)gdt; (void)index; (void)base; (void)limit; (void)flags; }");
    wln(self, "void p_idt_set_entry(int64_t idt, int64_t vector, int64_t handler, int64_t flags) { (void)idt; (void)vector; (void)handler; (void)flags; }");
    wln(self, "void p_tss_init(int64_t tss, int64_t rsp0) { (void)tss; (void)rsp0; }");
    wln(self, "void p_tss_load(int64_t selector) { (void)selector; }");
    wln(self, "void p_lapic_write(int64_t reg, int64_t val) { (void)reg; (void)val; }");
    wln(self, "int64_t p_lapic_read(int64_t reg) { (void)reg; return 0; }");
    wln(self, "void p_lapic_eoi(void) {}");
    wln(self, "void p_ioapic_write(int64_t reg, int64_t val) { (void)reg; (void)val; }");
    wln(self, "int64_t p_ioapic_read(int64_t reg) { (void)reg; return 0; }");
    wln(self, "void p_pic_remap(void) {}");
    wln(self, "void p_pic_mask(int64_t irq, int64_t masked) { (void)irq; (void)masked; }");
    wln(self, "void p_pic_eoi(int64_t irq) { (void)irq; }");
    wln(self, "int64_t p_cmos_read(int64_t reg) { (void)reg; return 0; }");
    wln(self, "void p_cmos_write(int64_t reg, int64_t val) { (void)reg; (void)val; }");
    wln(self, "void p_serial_init(void) {}");
    wln(self, "void p_serial_write(int64_t c) { (void)c; }");
    wln(self, "int64_t p_serial_read(void) { return 0; }");
    wln(self, "int64_t p_serial_ready(void) { return 0; }");
    wln(self, "void p_serial_putc(int64_t c) { (void)c; }");
    wln(self, "int64_t p_serial_getc(void) { return 0; }");
    wln(self, "int64_t p_serial_available(void) { return 0; }");
    wln(self, "void p_memset(void* ptr, int val, int64_t size) { if (ptr && size > 0) memset(ptr, val, (size_t)size); }");
    // @zeroize: wipe a string's bytes when it lives in the arena (string
    // literals are read-only and part of the binary anyway), and a Vec's
    // whole element buffer. Volatile stores so the wipe is not elided.
    wln(self, "void p_str_zeroize(void* s) {");
    wln(self, "    if (!s) return;");
    wln(self, "    for (__p_arena_chunk* c = __p_arena_head; c; c = c->next) {");
    wln(self, "        if ((char*)s >= c->base && (char*)s < c->end) {");
    wln(self, "            volatile char* p = (volatile char*)s;");
    wln(self, "            while (p < (volatile char*)c->end && *p) { *p = 0; p++; }");
    wln(self, "            return;");
    wln(self, "        }");
    wln(self, "    }");
    wln(self, "}");
    wln(self, "void p_vec_zeroize(void* v) {");
    wln(self, "    PVec* pv = (PVec*)v;");
    wln(self, "    if (!pv || !pv->data) return;");
    wln(self, "    volatile char* p = (volatile char*)pv->data;");
    wln(self, "    for (int64_t i = 0; i < pv->cap * (int64_t)sizeof(void*); i++) p[i] = 0;");
    wln(self, "}");
    wln(self, "void p_lgdt(int64_t gdt_desc) { (void)gdt_desc; }");
