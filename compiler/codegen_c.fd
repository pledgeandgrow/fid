    void_rets.push("p_kv_cache_append");
    void_rets.push("p_kv_cache_clear");
    void_rets.push("p_kv_cache_evict");
    var v: i64 = 0;
    while v < void_rets.len() {
        fn_ret_types_set(self, void_rets.get(v), IrType::Void);
        v = v + 1;
    }

    // Specific non-void returns
    // Vec element accessors return the stored bits as a void*; a call typed
    // f64 (a Vec<f64> element) must pun them, not cast the pointer.
    fn_ret_types_set(self, "p_vec_get", IrType::Ptr(Box::new(IrType::U8)));
    fn_ret_types_set(self, "p_vec_first", IrType::Ptr(Box::new(IrType::U8)));
