    void_rets.push("p_outb");
    void_rets.push("p_outw");
    void_rets.push("p_outl");
    void_rets.push("p_msr_write");
    void_rets.push("p_gdt_set_entry");
    void_rets.push("p_idt_set_entry");
    void_rets.push("p_tss_init");
    void_rets.push("p_tss_load");
    void_rets.push("p_lapic_write");
