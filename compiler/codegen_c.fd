    void_rets.push("p_hpet_write");
    void_rets.push("p_syscall_set_handler");
    void_rets.push("p_context_save");
    void_rets.push("p_context_restore");
    void_rets.push("p_pci_write");
    void_rets.push("p_ata_write");
    void_rets.push("p_acpi_shutdown");
    void_rets.push("p_fb_init");
    void_rets.push("p_fb_plot");
    void_rets.push("p_fb_fill");
    void_rets.push("p_tensor_set");
    void_rets.push("p_json_set");
    void_rets.push("p_json_set_int");
    void_rets.push("p_json_set_float");
    void_rets.push("p_json_set_bool");
    void_rets.push("p_json_append");
    void_rets.push("p_json_append_int");
    void_rets.push("p_json_append_float");
    void_rets.push("p_http_send_response");
    void_rets.push("p_db_exec");
    void_rets.push("p_db_set");
    void_rets.push("p_db_mem_close");
    void_rets.push("p_rc_decr");
    void_rets.push("p_grad_zero");
    void_rets.push("p_checkpoint_begin");
    void_rets.push("p_checkpoint_end");
    void_rets.push("p_dp_budget_reset");
    void_rets.push("p_dp_budget_check");
    void_rets.push("p_send_tensor");
    void_rets.push("p_kv_cache_append");
    void_rets.push("p_kv_cache_clear");
    void_rets.push("p_kv_cache_evict");
    var v: i64 = 0;
    while v < void_rets.len() {
        fn_ret_types_set(self, void_rets.get(v), IrType::Void);
        v = v + 1;
    }

    // Specific non-void returns
    fn_ret_types_set(self, "p_map_keys", IrType::I64);
    fn_ret_types_set(self, "p_map_values", IrType::I64);
    fn_ret_types_set(self, "p_string_split", IrType::I64);
    fn_ret_types_set(self, "p_simd_add", IrType::I64);
