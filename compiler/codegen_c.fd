    wln(self, "void p_ring3_enter(int64_t entry, int64_t stack, int64_t arg) { (void)entry; (void)stack; (void)arg; }");
    wln(self, "void p_context_save(int64_t ctx) { (void)ctx; }");
    wln(self, "void p_context_restore(int64_t ctx) { (void)ctx; }");
