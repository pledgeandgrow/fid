    void_rets.push("p_flush_stdout");
    void_rets.push("p_eprint_str");
    void_rets.push("p_free");
    void_rets.push("p_region_free");
    void_rets.push("p_arena_restore");
    void_rets.push("p_panic");
    void_rets.push("p_socket_close");
    void_rets.push("p_cli");
    void_rets.push("p_sti");
    void_rets.push("p_cr3_write");
    void_rets.push("p_invlpg");
    void_rets.push("p_page_map");
    void_rets.push("p_page_unmap");
    void_rets.push("p_phys_write64");
    void_rets.push("p_phys_write8");
    void_rets.push("p_phys_write16");
