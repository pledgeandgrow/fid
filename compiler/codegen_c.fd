    wln(self, "void p_phys_write64(int64_t addr, int64_t val);");
    wln(self, "int64_t p_phys_read8(int64_t addr);");
    wln(self, "void p_phys_write8(int64_t addr, int64_t val);");
    wln(self, "int64_t p_phys_read16(int64_t addr);");
    wln(self, "void p_phys_write16(int64_t addr, int64_t val);");
    wln(self, "int64_t p_phys_read32(int64_t addr);");
    wln(self, "void p_phys_write32(int64_t addr, int64_t val);");
    wln(self, "int64_t p_inb(int64_t port);");
    wln(self, "void p_outb(int64_t port, int64_t val);");
    wln(self, "int64_t p_inw(int64_t port);");
