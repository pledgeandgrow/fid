    // KV cache
    fn_param_types_set(self, "p_kv_cache_new", t4(IrType::I64, IrType::I64, IrType::I64, IrType::I64));
    fn_param_types_set(self, "p_kv_cache_append", t4(IrType::I64, IrType::I64, ptr_u8(), ptr_u8()));
