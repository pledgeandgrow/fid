    wln(self, "void p_print_newline(void);");
    // println: the value and its newline are written under one stdout lock
    // (the stdio lock, which each fwrite takes too, recursive), so another
    // thread's output never lands inside the line (RT10: a task's println
    // on one worker, another's on the next). gen_function emits them around
    // println's two Prints (cg_println_pair)
    wln(self, "#if defined(__TINYC__) || defined(__wasi__)");
    wln(self, "static inline void p_print_line_begin(void) {}");
    wln(self, "static inline void p_print_line_end(void) {}");
    wln(self, "#elif defined(_WIN32)");
    wln(self, "static inline void p_print_line_begin(void) { _lock_file(stdout); }");
    wln(self, "static inline void p_print_line_end(void) { _unlock_file(stdout); }");
    wln(self, "#else");
    wln(self, "static inline void p_print_line_begin(void) { flockfile(stdout); }");
    wln(self, "static inline void p_print_line_end(void) { funlockfile(stdout); }");
    wln(self, "#endif");
    wln(self, "void p_eprint_str(const char* s);");
    wln(self, "void p_flush_stdout(void);");
    wln(self, "void p_panic(const char* msg);");
    gen_arith_helpers(self);
    wln(self, "// Per-thread runtime state (arena, tasks): no locks needed.");
    wln(self, "#if defined(_MSC_VER)");
    wln(self, "#define P_THREAD_LOCAL __declspec(thread)");
    wln(self, "#elif defined(__TINYC__)");
    wln(self, "#define P_THREAD_LOCAL /* TCC has no thread-local storage */");
    wln(self, "#else");
    wln(self, "#define P_THREAD_LOCAL __thread");
    wln(self, "#endif");
    wln(self, "/* Competitive RT10: tasks M:N over worker threads where they have the own");
    wln(self, "   context switch (P_OWN_CTX) and the compiler GNU atomics; not in a --lib");
    wln(self, "   build (a fides_call's tasks stay on its thread) nor under -g (the frame");
    wln(self, "   records are per thread). Elsewhere one scheduler per thread, as before.");
    wln(self, "   P_MN_NOINLINE: code a task runs that reads thread-locals (a task may");
    wln(self, "   resume on another thread after any switch, and an inlined thread-local");
    wln(self, "   address could be reused across the switch). */");
    wln(self, "#if !defined(__TINYC__) && (defined(__GNUC__) || defined(__clang__)) && !defined(__wasi__) && !defined(P_NO_CTX) && !defined(P_LIB) && !defined(P_DEBUG_FRAMES) && (defined(__x86_64__) || (!defined(_WIN32) && (defined(__aarch64__) || (defined(__riscv) && __riscv_xlen == 64))))");
    wln(self, "#define P_MN 1");
    wln(self, "#define P_MN_NOINLINE __attribute__((noinline))");
    wln(self, "#else");
    wln(self, "#define P_MN_NOINLINE");
    wln(self, "#endif");
    emit_region_runtime(self);
    // CI6: what the running code may do (fides_call narrows it for the
    // call; a program starts with every capability). The I/O entry points
    // test it: files and directories, sockets, processes, the environment.
    wln(self, "#define P_CAP_FS 1ULL");
    wln(self, "#define P_CAP_NET 2ULL");
    wln(self, "#define P_CAP_PROC 4ULL");
    wln(self, "#define P_CAP_ENV 8ULL");
    wln(self, "extern P_THREAD_LOCAL uint64_t __p_caps;");
    wln(self, "#ifdef P_MN");
    wln(self, "uint64_t __p_caps_now(void);");
    wln(self, "#define P_CAP_DENIED(c) (!(__p_caps_now() & (c)))");
    wln(self, "#else");
    wln(self, "#define P_CAP_DENIED(c) (!(__p_caps & (c)))");
    wln(self, "#endif");
    // CI6: the blocks a fides_call allocates are recorded (__p_el_*, after
    // the block allocator); a panic in the call frees them, the outermost
    // call's return hands them to the host. Not under the debug allocator.
    wln(self, "#if defined(P_LIB) && !defined(P_LEAKS) && !defined(P_CHECKED_ALLOC) && !defined(P_MEMPROF)");
    wln(self, "#define P_EMBED_LOG 1");
    wln(self, "extern P_THREAD_LOCAL uint64_t __p_el_id;");
    wln(self, "extern P_THREAD_LOCAL uint64_t __p_el_next;");
    wln(self, "void __p_el_end(uint64_t from, int release);");
    wln(self, "#define P_EL_SAVE volatile uint64_t __el_saved = __p_el_id; volatile uint64_t __el_me = ++__p_el_next");
    wln(self, "#define P_EL_BEGIN (__p_el_id = __el_me)");
    wln(self, "#define P_EL_DONE do { __p_el_id = __el_saved; if (!__el_saved) __p_el_end(__el_me, 0); } while (0)");
    wln(self, "#define P_EL_PANIC do { __p_el_id = __el_saved; __p_el_end(__el_me, 1); } while (0)");
    wln(self, "#else");
    wln(self, "#define P_EL_SAVE int __el_unused = 0");
    wln(self, "#define P_EL_BEGIN ((void)__el_unused)");
    wln(self, "#define P_EL_DONE ((void)0)");
    wln(self, "#define P_EL_PANIC ((void)0)");
    wln(self, "#endif");
    // CE8 (-g): the frame of the running Fides function, for a panic
    wln(self, "#ifdef P_DEBUG_FRAMES");
    wln(self, "typedef struct __p_dbg_frame { int64_t magic; const char* fn; int n; const char* const* names; const char* kinds; void* const* addrs; struct __p_dbg_frame* self; } __p_dbg_frame;");
    wln(self, "#define P_DBG_MAGIC 0x4644424746524D45LL");
    wln(self, "extern P_THREAD_LOCAL __p_dbg_frame* __p_dbg_cur;");
    wln(self, "#endif");
    // CM8 (--leaks, --mem): the source line of the next allocations
    wln(self, "#if defined(P_LEAKS) || defined(P_MEMPROF)");
    wln(self, "extern P_THREAD_LOCAL const char* __p_mc_at;");
    wln(self, "#endif");
    wln(self, "void p_set_max_recursion(int limit) { (void)limit; }");
    wln(self, "void* p_malloc(int64_t size);");
    // RT8: a block like p_malloc's whose bytes are unspecified (core and the
    // runtimes only, for producers that write every byte they hand out).
    // The name p_malloc_uninit is core's function (stdlib/core.fd, with an
    // environment word); fast_core_vec_body makes its body a call of this
    wln(self, "void* __p_malloc_uninit(int64_t size);");
    // (n bytes at p zeroed as p_malloc zeroes: Vec growth's spare capacity)
    wln(self, "void __p_zero_tail(void* p, size_t n);");
    wln(self, "void* p_malloc_persistent(int64_t size);");
    wln(self, "void* p_alloc(int64_t size);");
    wln(self, "int64_t p_arena_save(void);");
    wln(self, "void p_arena_restore(int64_t mark);");
    wln(self, "void p_region_free(void* region);");
    wln(self, "void p_free(void* ptr);");
    // RT7: the bytes of the process in physical memory (-1: not known here)
    wln(self, "int64_t p_mem_resident(void);");
    // Strings carry their length (release D16): [magic][len] before the
    // bytes, as core's p_str_alloc writes them; literals have a static
    // magic and are never freed
    wln(self, "#define P_STR_MAGIC_C 0x4649444553545201LL");
    wln(self, "#define P_STR_STATIC_C 0x4649444553545202LL");
    // A counted string (proposal 0004): the word is P_STR_RC_C + its count
    wln(self, "#define P_STR_RC_C 0x4649444500000000LL");
    // Low 32 bits: count in bits 0..29, bit 30 clear, bit 31 = room to grow
    wln(self, "#define P_STR_COUNTED_C(w) ((uint64_t)((w) - P_STR_RC_C) < 0x100000000ULL && !(((w) - P_STR_RC_C) & 0x40000000LL) && (((w) - P_STR_RC_C) & 0x3FFFFFFFLL) >= 1)");
    wln(self, "static inline int64_t p_str_hdr_c(const char* s) { if (!s || ((uintptr_t)s & 7)) return -1; const int64_t* h = (const int64_t*)(s - 16); if ((h[0] == P_STR_MAGIC_C || h[0] == P_STR_STATIC_C || P_STR_COUNTED_C(h[0])) && h[1] >= 0 && h[1] < 0x10000000000LL) return h[1]; return -1; }");
    wln(self, "static inline int64_t p_slen(const char* s) { if (!s) return 0; int64_t n = p_str_hdr_c(s); return n >= 0 ? n : (int64_t)strlen(s); }");
    wln(self, "static inline char* p_str_alloc_c(int64_t n) { char* b = (char*)__p_malloc_uninit(n + 17); ((int64_t*)b)[0] = P_STR_RC_C + 1; ((int64_t*)b)[1] = n; b[16 + n] = 0; return b + 16; }");
    wln(self, "static inline void p_str_free_c(char* s) { if (!s) return; if ((uintptr_t)s & 7) { p_free(s); return; } const int64_t* h = (const int64_t*)(s - 16); if (h[1] >= 0 && h[1] < 0x10000000000LL) { if (h[0] == P_STR_STATIC_C) return; if (h[0] == P_STR_MAGIC_C || P_STR_COUNTED_C(h[0])) { p_free(s - 16); return; } } p_free(s); }");
    // Counting a string inline (proposal 0004): one more owner, or one fewer
    // with a call to core's Str_drop only to free it (or to stop on a string
    // already freed)
    // (anything but a counted string's fast path or a literal goes to core:
    // a freed string stops there, and so does a str without a string
    // header, string header by construction, core p_str_no_header)
    wln(self, "#define P_STR_DUP(sv) do { int64_t __q = (int64_t)(sv); if (__q) { if (!(__q & 7)) { int64_t* __h = (int64_t*)(intptr_t)(__q - 16); if (P_STR_COUNTED_C(__h[0]) && (uint64_t)__h[1] < 0x10000000000ULL && (__h[0] & 0x3FFFFFFFLL) < 0x3FFFFFFELL) __h[0] += 1; else if (__h[0] != P_STR_STATIC_C && __h[0] != P_STR_MAGIC_C) Str_dup(0, __q); } else Str_dup(0, __q); } } while (0)");
    wln(self, "#define P_STR_DROP(sv) do { int64_t __q = (int64_t)(sv); if (__q) { if (!(__q & 7)) { int64_t* __h = (int64_t*)(intptr_t)(__q - 16); if (P_STR_COUNTED_C(__h[0]) && (uint64_t)__h[1] < 0x10000000000ULL && (__h[0] & 0x3FFFFFFFLL) > 1) __h[0] -= 1; else if (__h[0] != P_STR_STATIC_C && __h[0] != P_STR_MAGIC_C) Str_drop(0, __q); } else Str_drop(0, __q); } } while (0)");
    // A Fides string with one owner made from what a runtime function built:
    // a counted or literal string is itself; anything else is copied into a
    // counted one, and a plain block of the allocator is freed (a C heap or
    // static source is left alone). Every runtime string goes through it.
    wln(self, "static char* p_str_own_c(char* s) {");
    wln(self, "    if (!s) return s;");
    wln(self, "    int64_t n = p_str_hdr_c(s);");
    wln(self, "    if (n >= 0 && ((const int64_t*)(s - 16))[0] != P_STR_MAGIC_C) return s;");
    wln(self, "    size_t l = n >= 0 ? (size_t)n : strlen(s);");
    wln(self, "    char* r = p_str_alloc_c((int64_t)l);");
    wln(self, "    memcpy(r, s, l);");
    wln(self, "    if (n < 0 && !((uintptr_t)s & 7) && (((const uint64_t*)s)[-1] & ~(uint64_t)0xFF) == 0xF1DE5A0000000000ULL) p_free(s);");
    wln(self, "    return r;");
    wln(self, "}");
    // VF14 (S2 class, the whole-suite ASan run of Nov 17): a runtime function
    // that builds its text with the C library's malloc/strdup/realloc (the
    // JSON, HTTP, db, SIMD, socket and tensor-JSON ones) is not given to
    // p_str_own_c, whose header probe reads 16 bytes in front of the C
    // library's block (heap-buffer-overflow under ASan in test_db,
    // test_derive_serialize) and which left the buffer unfreed: it is copied
    // into a counted string and freed here
    wln(self, "static char* p_str_own_libc_c(char* s) {");
    wln(self, "    if (!s) return s;");
    wln(self, "    size_t l = strlen(s);");
    wln(self, "    char* r = p_str_alloc_c((int64_t)l);");
    wln(self, "    memcpy(r, s, l);");
    wln(self, "    free(s);");
    wln(self, "    return r;");
    wln(self, "}");
    // ... and text the runtime does not own (getenv's, argv's, a static or
    // reused line buffer): copied, nothing in front of it read or freed
    wln(self, "static char* p_str_copy_c(const char* s) {");
    wln(self, "    if (!s) return NULL;");
    wln(self, "    size_t l = strlen(s);");
    wln(self, "    char* r = p_str_alloc_c((int64_t)l);");
    wln(self, "    memcpy(r, s, l);");
    wln(self, "    return r;");
    wln(self, "}");
    wln(self, "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__TINYC__)");
    wln(self, "#define P_NOINLINE __attribute__((noinline))");
    wln(self, "#define P_UNLIKELY(x) __builtin_expect(!!(x), 0)");
    wln(self, "#elif defined(_MSC_VER)");
    wln(self, "#define P_NOINLINE __declspec(noinline)");
    wln(self, "#define P_UNLIKELY(x) (x)");
    wln(self, "#else");
    wln(self, "#define P_NOINLINE");
    wln(self, "#define P_UNLIKELY(x) (x)");
    wln(self, "#endif");
    wln(self, "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__TINYC__)");
    wln(self, "#define P_LIKELY_C(x) __builtin_expect(!!(x), 1)");
    wln(self, "#else");
    wln(self, "#define P_LIKELY_C(x) (x)");
    wln(self, "#endif");
    // K10: a @simd function asks the C compiler to vectorize its loops with
    // the cost model relaxed (fidesc's @simd: wider vectors, relaxed cost).
    // GCC takes it per function; clang has no function-level switch (it
    // vectorizes at -O2 with its own cost model), so there it is nothing.
    wln(self, "#if defined(__GNUC__) && !defined(__clang__) && !defined(__TINYC__)");
    wln(self, "#define P_SIMD_FN __attribute__((optimize(\"tree-vectorize\", \"vect-cost-model=unlimited\")))");
    wln(self, "#else");
    wln(self, "#define P_SIMD_FN");
    wln(self, "#endif");
    wln(self, "/* A full Vec grows out of line, so push inlines to a store. */");
    // Copy-on-write (proposal 0001): a negative capacity (-box-1) marks data
    // other Vecs share; the box holds {owners, capacity}. Growing (or owning
    // before a write) releases one owner or copies the data.
    wln(self, "#define P_VEC_TAG_C 0x4649445645430000LL");
    wln(self, "#define P_VEC_CODE(h) (((h)[3] & ~0xFFLL) == P_VEC_TAG_C ? ((h)[3] & 0xFF) - 8 : 0)");
    // A buffer core allocated has its share box in front of the data,
    // behind a tag (core's vec_buf_alloc, release item 8): it is freed with
    // the data, never on its own
    wln(self, "#define P_VBUF_KEY_C 0x5646425546494445LL");
    wln(self, "#define P_VBUF_TAGGED(d) ((d) && ((const int64_t*)(d))[-3] == (int64_t)((uint64_t)P_VBUF_KEY_C + (uint64_t)(uintptr_t)(d)))");
    // J8: sensitive-buffer registry. A @zeroize Vec's header is marked by
    // p_sensitive_mark; every buffer it ever holds is kept in __p_sens_buf
    // with its byte size, so the wipe follows the buffer — through growth
    // (__p_vec_grow re-adds the new buffer while the header is marked) and
    // through shared-buffer ownership (__p_vbuf_free wipes whichever owner
    // frees last). Early: __p_vbuf_free and __p_vec_grow below use it.
    wln(self, "static void* __p_sensitive[256];");
    wln(self, "static int64_t __p_sensitive_esz[256];");
    wln(self, "static int __p_sensitive_n = 0;");
    wln(self, "static int64_t __p_sensitive_wipes = 0;");
    wln(self, "static void* __p_sens_buf[256];");
    wln(self, "static int64_t __p_sens_bufsz[256];");
    wln(self, "static int __p_sens_bn = 0;");
    wln(self, "static int __p_sensitive_at(const void* v) { for (int i = 0; i < __p_sensitive_n; i++) if (__p_sensitive[i] == v) return i; return -1; }");
    wln(self, "static int __p_sens_bat(const void* d) { for (int i = 0; i < __p_sens_bn; i++) if (__p_sens_buf[i] == d) return i; return -1; }");
    wln(self, "static void __p_sens_buf_add(void* d, int64_t sz) { if (!d) return; int i = __p_sens_bat(d); if (i >= 0) { __p_sens_bufsz[i] = sz; return; } if (__p_sens_bn < 256) { __p_sens_buf[__p_sens_bn] = d; __p_sens_bufsz[__p_sens_bn++] = sz; } }");
    wln(self, "static void __p_sens_buf_remove(void* d) { int i = __p_sens_bat(d); if (i < 0) return; __p_sens_buf[i] = __p_sens_buf[--__p_sens_bn]; __p_sens_bufsz[i] = __p_sens_bufsz[__p_sens_bn]; }");
    wln(self, "static void __p_sens_buf_free(void* d) { int i = __p_sens_bat(d); if (i < 0) return; volatile uint8_t* w = (volatile uint8_t*)d; int64_t n = __p_sens_bufsz[i]; for (int64_t k = 0; k < n; k++) w[k] = 0; __p_sens_buf[i] = __p_sens_buf[--__p_sens_bn]; __p_sens_bufsz[i] = __p_sens_bufsz[__p_sens_bn]; __p_sensitive_wipes++; }");
    wln(self, "static inline void __p_vbuf_free(int64_t* d) { if (!d) return; __p_sens_buf_free(d); if (P_VBUF_TAGGED(d)) { d[-3] = 0; p_free(d - 3); } else p_free(d); }");
    wln(self, "P_NOINLINE void __p_vec_grow(int64_t* h) {");
    wln(self, "    int64_t cap = h[2], shared = 0;");
    wln(self, "    if (cap < 0) {");
    wln(self, "        int64_t* bx = (int64_t*)(intptr_t)(-cap - 1);");
    wln(self, "        int64_t owners = bx[0];");
    wln(self, "        int64_t* bd = (int64_t*)(intptr_t)h[0];");
    wln(self, "        cap = bx[1];");
    wln(self, "        if (owners <= 1) { if (!(bx == bd - 2 && P_VBUF_TAGGED(bd))) p_free(bx); h[2] = cap; }");
    wln(self, "        else { bx[0] = owners - 1; shared = 1; }");
    wln(self, "    }");
    wln(self, "    if (!shared && h[1] < cap) return;");
    wln(self, "    int64_t hc = P_VEC_CODE(h);");
    wln(self, "    int64_t esz = hc == 0 ? 8 : (hc < 0 ? -hc : (hc >= 16 ? (hc - 15) * 8 : hc));");
    wln(self, "    int64_t nc = h[1] < cap ? cap : (cap > 0 ? cap * 2 : 8);");
    // A buffer grows where its Vec lives, not in the current region (an
    // outside Vec pushed to inside a region stays outside: proposal 0005)
    wln(self, "    int64_t* nd;");
    wln(self, "    if (P_UNLIKELY(__p_rs.live)) {");
    wln(self, "        uint64_t hw = (uint64_t)h[-1];");
    wln(self, "        int64_t hd = P_IS_ARENA_HDR(hw) ? (int64_t)(hw & 0xFF) : 0;");
    wln(self, "        int64_t pm = __p_rs.mode;");
    wln(self, "        __p_rs.mode = hd <= __p_rs.live ? hd : 0;");
    wln(self, "        nd = (int64_t*)(nc * esz <= 1024 ? p_malloc(nc * esz) : __p_malloc_uninit(nc * esz));");
    wln(self, "        __p_rs.mode = pm;");
    wln(self, "    } else {");
    wln(self, "        nd = (int64_t*)(nc * esz <= 1024 ? p_malloc(nc * esz) : __p_malloc_uninit(nc * esz));");
    wln(self, "    }");
    wln(self, "    int64_t* od = (int64_t*)(intptr_t)h[0];");
    // RT8: past 1 KB the old elements are copied and only the spare
    // capacity past them is zeroed (a Vec's buffer reads zero past its
    // length, as with p_malloc, with its stores: the C library's memset
    // call costs more); up to it p_malloc's inline zeroing is cheaper
    wln(self, "    int64_t ncopy = od ? h[1] : 0;");
    wln(self, "    if (nc * esz > 1024 && nc > ncopy) __p_zero_tail((char*)nd + ncopy * esz, (size_t)((nc - ncopy) * esz));");
    wln(self, "    if (od) { memcpy(nd, od, (size_t)(h[1] * esz)); if (!shared) __p_vbuf_free(od); }");
    wln(self, "    if (__p_sensitive_at(h) >= 0) __p_sens_buf_add(nd, nc * esz);");
    wln(self, "    h[0] = (int64_t)(intptr_t)nd;");
    wln(self, "    h[2] = nc;");
    wln(self, "}");
    // Elements stored at their size (D14): h[3] is core's element code
    // word, 0 or P_VEC_TAG + code + 8 (core's vec_code_word); a word that
    // is neither reads as a word Vec
    // Codes 16 and up: structs held in the buffer (release D15), reached by
    // address; a store copies one in
    wln(self, "static inline int64_t __p_vec_ld(const int64_t* h, int64_t i) {");
    wln(self, "    const char* d = (const char*)(intptr_t)h[0];");
    wln(self, "    int64_t __c = P_VEC_CODE(h);");
    wln(self, "    if (__c >= 16) return (int64_t)(intptr_t)(d + i * (__c - 15) * 8);");
    wln(self, "    switch (__c) {");
    wln(self, "    case 1: return ((const uint8_t*)d)[i]; case -1: return ((const int8_t*)d)[i];");
    wln(self, "    case 2: return ((const uint16_t*)d)[i]; case -2: return ((const int16_t*)d)[i];");
    wln(self, "    case 4: return ((const uint32_t*)d)[i]; case -4: return ((const int32_t*)d)[i];");
    wln(self, "    default: return ((const int64_t*)d)[i]; }");
    wln(self, "}");
    wln(self, "static inline void __p_vec_st(int64_t* h, int64_t i, int64_t x) {");
    wln(self, "    char* d = (char*)(intptr_t)h[0];");
    wln(self, "    int64_t __c = P_VEC_CODE(h);");
    wln(self, "    if (__c >= 16) { if (x) memcpy(d + i * (__c - 15) * 8, (const void*)(intptr_t)x, (size_t)((__c - 15) * 8)); return; }");
    wln(self, "    switch (__c) {");
    wln(self, "    case 1: case -1: ((uint8_t*)d)[i] = (uint8_t)x; break;");
    wln(self, "    case 2: case -2: ((uint16_t*)d)[i] = (uint16_t)x; break;");
    wln(self, "    case 4: case -4: ((uint32_t*)d)[i] = (uint32_t)x; break;");
    wln(self, "    default: ((int64_t*)d)[i] = x; }");
    wln(self, "}");
    wln(self, "#define P_VEC_AT(v, i) ((v)->code ? (void*)(intptr_t)__p_vec_ld((const int64_t*)(v), (i)) : (void*)(intptr_t)P_VSLOT(v, i))");
    wln(self, "/* Element access a counted loop proved in bounds (pe.rs unchecked_ops). */");
    wln(self, "#define P_VEC_UNCHECKED \\");
    wln(self, "static inline int64_t __p_vec_get_u(void* e, int64_t v, int64_t i) { (void)e; int64_t* __hh = (int64_t*)(intptr_t)v; if (P_UNLIKELY(__hh[3])) return __p_vec_ld(__hh, i); return ((int64_t*)(intptr_t)__hh[0])[i]; } \\");
    wln(self, "static inline void __p_vec_set_u(void* e, int64_t v, int64_t i, int64_t x) { (void)e; int64_t* __hh = (int64_t*)(intptr_t)v; if (P_UNLIKELY(__hh[2] < 0)) __p_vec_grow(__hh); if (P_UNLIKELY(__hh[3])) { __p_vec_st(__hh, i, x); return; } ((int64_t*)(intptr_t)__hh[0])[i] = x; } \\");
    wln(self, "static inline void* __p_pvec_get_u(PVec* v, int64_t i) { return P_VEC_AT(v, i); } \\");
    wln(self, "static inline void __p_pvec_set_u(PVec* v, int64_t i, void* x) { if (P_UNLIKELY(v->cap < 0)) __p_vec_grow((int64_t*)v); if (v->code) { __p_vec_st((int64_t*)v, i, (int64_t)(intptr_t)x); return; } P_VSLOT(v, i) = (int64_t)(intptr_t)x; }");
    wln(self, "P_VEC_UNCHECKED");
    wln(self, "char* p_file_read(const char* path);");
    wln(self, "int64_t p_file_write(const char* path, const char* content);");
    wln(self, "int64_t p_file_write_vec(const char* path, PVec* v);");
    wln(self, "int64_t p_file_write_bin(const char* path, const char* data, int64_t len);");
    wln(self, "PVec* p_file_read_bytes(const char* path);");
    wln(self, "bool p_file_exists(const char* path);");
    wln(self, "int64_t p_file_append(const char* path, const char* content);");
    wln(self, "int64_t p_file_delete(const char* path);");
    wln(self, "char* p_read_line(void);");
    wln(self, "char* p_read_stdin(int64_t n);");
    wln(self, "int64_t p_stdin_eof(void);");
    wln(self, "int64_t p_file_size(const char* path);");
    wln(self, "int64_t p_file_hash(const char* path);");
    wln(self, "int64_t p_file_mtime_ms(const char* path);");
    // roadmap L4B: streaming reads, appends with zero bytes (core's
    // `extern fn` declares the same prototypes)
    wln(self, "void* p_file_read_at(const char* path, int64_t offset, int64_t n);");
    wln(self, "int64_t p_file_append_vec(const char* path, void* vp);");
    wln(self, "char* p_getenv(const char* name);");
    wln(self, "static int __p_argc = 0;");
    wln(self, "static char** __p_argv = NULL;");
    wln(self, "int64_t p_argc(void);");
