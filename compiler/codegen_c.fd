// codegen_c.fd - C99 generator from Fides IR, rewritten from src/codegen_c.rs (4241 LOC)
//
// Strategy: translate IR functions to C functions, with a runtime library
// implementing p_vec_*, p_map_*, p_string_* in C. This produces portable
// native binaries via gcc/clang.
//
// Adaptations from Rust:
// 1. HashMap<K,V> - Vec-based maps with helper structs
// 2. HashSet<T> - Vec<T> with contains() helper
// 3. format! / wln! macro - direct string concatenation with int_to_str
// 4. Box<IrType> - box_ir_type_unbox helper
// 5. matches! macro - explicit match with _ => false
// 6. Option<T> - Opt* enums
// 7. String - str, u32/u64 - i64
// 8. Vec::iter() - explicit while loops with .get(i)
//
// Dependencies: compiler::ast, compiler::ir

module compiler::codegen_c;

use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;

// --- Vec-based map entry structs ------------------------------------------
// Replace HashMap with Vec<Entry> + linear search.

// value_names: ValueId - C variable name
pub struct ValueNameEntry {
    pub id: i64,
    pub name: str,
}

pub fn ValueNameEntry_new(id: i64, name: str) -> ValueNameEntry {
    return ValueNameEntry { id: id, name: name };
}

// string_consts: original string - _strN name
pub struct StringConstEntry {
    pub key: str,
    pub val: str,
}

pub fn StringConstEntry_new(key: str, val: str) -> StringConstEntry {
    return StringConstEntry { key: key, val: val };
}

// fn_param_types: func name - Vec<IrType>
pub struct FnParamTypesEntry {
    pub key: str,
    pub types: Vec<IrType>,
}

pub fn FnParamTypesEntry_new(key: str, types: Vec<IrType>) -> FnParamTypesEntry {
    return FnParamTypesEntry { key: key, types: types };
}

// user_functions / extern_func_names: Vec<str> set
// user_fn_param_types: func name - Vec<IrType>
// fn_ret_types: func name - IrType
pub struct FnRetTypeEntry {
    pub key: str,
    pub ty: IrType,
}

pub fn FnRetTypeEntry_new(key: str, ty: IrType) -> FnRetTypeEntry {
    return FnRetTypeEntry { key: key, ty: ty };
}

// --- CCodeGen struct ------------------------------------------------------

pub struct CCodeGen {
    // Accumulated C output - uses p_sb (mutable string builder) to avoid
    // O(n^2) memory blowup from string concatenation.
    pub sb: i64,
    pub out: str,
    // Map from ValueId to C variable name
    pub value_names: Vec<ValueNameEntry>,
    // String constants collected from the module
    pub string_consts: Vec<StringConstEntry>,
    // Counter for unique labels
    pub label_counter: i64,
    // Counter for temp variables
    pub temp_counter: i64,
    // Whether the current function's C return type is void (true) or non-void (false)
    pub cur_fn_c_ret_is_void: bool,
    // The current function's C return type string
    pub cur_fn_c_ret_type: str,
    // Function parameter types, keyed by IR function name
    pub fn_param_types: Vec<FnParamTypesEntry>,
    // Set of user-defined function names
    pub user_functions: Vec<str>,
    // User function parameter types
    pub user_fn_param_types: Vec<FnParamTypesEntry>,
    // Function return types, keyed by IR function name
    pub fn_ret_types: Vec<FnRetTypeEntry>,
    // Set of user-defined extern function names (FFI)
    pub extern_func_names: Vec<str>,
    // Struct layouts for GetFieldPtr offset lookup
    pub struct_layouts: Vec<StructLayoutEntry>,
}

pub fn CCodeGen_new() -> CCodeGen {
    var cg: CCodeGen = CCodeGen {
        sb: p_sb_new(),
        out: "",
        value_names: Vec::new(),
        string_consts: Vec::new(),
        label_counter: 0,
        temp_counter: 0,
        cur_fn_c_ret_is_void: true,
        cur_fn_c_ret_type: "void",
        fn_param_types: Vec::new(),
        user_functions: Vec::new(),
        user_fn_param_types: Vec::new(),
        fn_ret_types: Vec::new(),
        extern_func_names: Vec::new(),
        struct_layouts: Vec::new(),
    };
    CCodeGen_insert_runtime_sigs(&mut cg);
    return cg;
}

// --- Output helpers -------------------------------------------------------
// Replaces the Rust wln! macro. All appends end with a newline.

fn wln(self: &mut CCodeGen, s: str) -> void {
    // Use mutable string builder to avoid O(n^2) memory blowup.
    p_sb_append(self.sb, s);
    p_sb_append(self.sb, "\n");
}

// --- C type helpers -------------------------------------------------------

pub fn c_type(ty: IrType) -> str {
    match ty {
        IrType::I8 => { return "int8_t"; }
        IrType::I16 => { return "int16_t"; }
        IrType::I32 => { return "int32_t"; }
        IrType::I64 => { return "int64_t"; }
        IrType::U8 => { return "uint8_t"; }
        IrType::U16 => { return "uint16_t"; }
        IrType::U32 => { return "uint32_t"; }
        IrType::U64 => { return "uint64_t"; }
        IrType::F32 => { return "float"; }
        IrType::F64 => { return "double"; }
        IrType::Bool => { return "bool"; }
        IrType::Ptr(_) => { return "void*"; }
        IrType::Struct(name) => { return "struct " + name + "_s*"; }
        IrType::Array(elem, size) => { return c_type(cc_box_ir_type_unbox(elem)) + "[" + int_to_str(size) + "]"; }
        IrType::Void => { return "void"; }
        IrType::Never => { return "void"; }
        IrType::Opaque(name) => {
            if str_equal(name, "String") { return "const char*"; }
            if str_equal(name, "Vec") || str_equal(name, "HashMap") { return "void*"; }
            return "void*";
        }
        IrType::Generic(name, _) => {
            if str_equal(name, "String") { return "const char*"; }
            if str_equal(name, "Vec") || str_equal(name, "HashMap") { return "void*"; }
            return "void*";
        }
    }
    return "void";
}

// Like c_type but returns value type (not pointer) for structs.
// Used for global variable declarations which need inline struct storage.
pub fn c_type_global(ty: IrType) -> str {
    match ty {
        IrType::I8 => { return "int8_t"; }
        IrType::I16 => { return "int16_t"; }
        IrType::I32 => { return "int32_t"; }
        IrType::I64 => { return "int64_t"; }
        IrType::U8 => { return "uint8_t"; }
        IrType::U16 => { return "uint16_t"; }
        IrType::U32 => { return "uint32_t"; }
        IrType::U64 => { return "uint64_t"; }
        IrType::F32 => { return "float"; }
        IrType::F64 => { return "double"; }
        IrType::Bool => { return "bool"; }
        IrType::Ptr(_) => { return "void*"; }
        IrType::Struct(name) => { return "struct " + name + "_s"; }
        IrType::Array(elem, size) => { return c_type_global(cc_box_ir_type_unbox(elem)) + "[" + int_to_str(size) + "]"; }
        IrType::Void => { return "void"; }
        IrType::Never => { return "void"; }
        IrType::Opaque(name) => {
            if str_equal(name, "String") { return "const char*"; }
            if str_equal(name, "Vec") || str_equal(name, "HashMap") { return "void*"; }
            return "void*";
        }
        IrType::Generic(name, _) => {
            if str_equal(name, "String") { return "const char*"; }
            if str_equal(name, "Vec") || str_equal(name, "HashMap") { return "void*"; }
            return "void*";
        }
    }
    return "void";
}

// Box<IrType> unbox helper
pub fn cc_box_ir_type_unbox(b: Box<IrType>) -> IrType {
    match b {
        IrType::I8 => { return IrType::I8; }
        IrType::I16 => { return IrType::I16; }
        IrType::I32 => { return IrType::I32; }
        IrType::I64 => { return IrType::I64; }
        IrType::U8 => { return IrType::U8; }
        IrType::U16 => { return IrType::U16; }
        IrType::U32 => { return IrType::U32; }
        IrType::U64 => { return IrType::U64; }
        IrType::F32 => { return IrType::F32; }
        IrType::F64 => { return IrType::F64; }
        IrType::Bool => { return IrType::Bool; }
        IrType::Ptr(inner) => { return IrType::Ptr(inner); }
        IrType::Struct(name) => { return IrType::Struct(name); }
        IrType::Array(elem, size) => { return IrType::Array(elem, size); }
        IrType::Void => { return IrType::Void; }
        IrType::Never => { return IrType::Never; }
        IrType::Opaque(name) => { return IrType::Opaque(name); }
        IrType::Generic(name, args) => { return IrType::Generic(name, args); }
    }
    return IrType::Void;
}

// Format a C parameter declaration with the variable name in the right position.
fn c_param_decl(ty: IrType, name: str) -> str {
    match ty {
        IrType::Array(elem, size) => {
            return c_type(cc_box_ir_type_unbox(elem)) + " " + name + "[" + int_to_str(size) + "]";
        }
        _ => {
            return c_type(ty) + " " + name;
        }
    }
}

// Returns true if the type uses the out-parameter calling convention.
fn is_aggregate_ret(ty: IrType) -> bool {
    match ty {
        IrType::Struct(_) => { return true; }
        IrType::Array(_, _) => { return true; }
        _ => { return false; }
    }
}

// C return type for a function - aggregate types are `void` because the
// result is returned via a hidden out-parameter (first function argument).
fn c_ret_type(ty: IrType) -> str {
    if is_aggregate_ret(ty) {
        return "void";
    }
    return c_type(ty);
}

fn is_ptr_type(ty: IrType) -> bool {
    match ty {
        IrType::Ptr(_) => { return true; }
        IrType::Opaque(_) => { return true; }
        IrType::Generic(_, _) => { return true; }
        _ => { return false; }
    }
}

fn is_float_type(ty: IrType) -> bool {
    match ty {
        IrType::F32 => { return true; }
        IrType::F64 => { return true; }
        _ => { return false; }
    }
}

fn is_int_type(ty: IrType) -> bool {
    match ty {
        IrType::I64 => { return true; }
        IrType::I32 => { return true; }
        IrType::I16 => { return true; }
        IrType::I8 => { return true; }
        IrType::Bool => { return true; }
        _ => { return false; }
    }
}

fn is_void_or_never(ty: IrType) -> bool {
    match ty {
        IrType::Void => { return true; }
        IrType::Never => { return true; }
        _ => { return false; }
    }
}

// Cast a call argument from its IR type to the called function's parameter type.
fn cast_arg(val: str, from: IrType, to: IrType) -> str {
    var from_is_ptr: bool = is_ptr_type(from);
    var from_is_float: bool = is_float_type(from);
    var to_is_ptr: bool = is_ptr_type(to);

    var to_is_array: bool = false;
    var to_array_elem: IrType = IrType::Void;
    match to {
        IrType::Array(elem, _) => {
            to_is_array = true;
            to_array_elem = cc_box_ir_type_unbox(elem);
        }
        _ => {}
    }
    var to_is_struct: bool = is_aggregate_ret(to);
    var to_is_int: bool = is_int_type(to);

    // Array params decay to pointers in C - cast to element pointer type
    if to_is_array {
        return "(" + c_type(to_array_elem) + "*)" + val;
    }

    if !from_is_ptr && to_is_ptr && from_is_float {
        // float - pointer: use type punning via union
        return "((union { double d; void* p; }){ .d = " + val + " }).p";
    }
    if !from_is_ptr && !to_is_ptr && from_is_float && to_is_int {
        // float - int: use type punning via union
        return "((union { double d; int64_t i; }){ .d = " + val + " }).i";
    }
    if !from_is_ptr && to_is_ptr {
        // int - pointer: cast to void*
        return "(void*)" + val;
    }
    if from_is_ptr && !to_is_ptr {
        // pointer - int: cast to int64_t
        return "(int64_t)" + val;
    }
    if !from_is_ptr && !to_is_ptr && to_is_struct {
        // pointer - struct pointer (out-param): cast to void*
        return "(void*)" + val;
    }
    return val;
}

// --- sanitize_c_name ------------------------------------------------------
// Renames Fides functions that collide with C keywords or C runtime names.

fn sanitize_c_name(self: &CCodeGen, name: str) -> str {
    // Don't sanitize user-defined extern function names (FFI)
    if vec_contains_str(self.extern_func_names, name) {
        return name;
    }
    // Exact-name collisions
    if str_equal(name, "main") { return "main_entry"; }
    if str_equal(name, "abs") { return "p_abs"; }
    if str_equal(name, "max") { return "p_max"; }
    if str_equal(name, "min") { return "p_min"; }
    if str_equal(name, "div") { return "p_div"; }
    if str_equal(name, "exit") { return "p_exit"; }
    if str_equal(name, "remove") { return "p_remove_user"; }
    if str_equal(name, "printf") { return "p_printf"; }
    if str_equal(name, "malloc") { return "p_malloc_user"; }
    if str_equal(name, "free") { return "p_free_user"; }
    if str_equal(name, "calloc") { return "p_calloc_user"; }
    if str_equal(name, "realloc") { return "p_realloc_user"; }
    if str_equal(name, "memcpy") { return "p_memcpy_user"; }
    if str_equal(name, "memset") { return "p_memset_user"; }
    if str_equal(name, "strlen") { return "p_strlen_user"; }
    if str_equal(name, "strcmp") { return "p_strcmp_user"; }
    if str_equal(name, "strcpy") { return "p_strcpy_user"; }
    if str_equal(name, "strcat") { return "p_strcat_user"; }
    if str_equal(name, "rand") { return "p_rand_user"; }
    if str_equal(name, "srand") { return "p_srand_user"; }
    if str_equal(name, "time") { return "p_time_user"; }
    if str_equal(name, "clock") { return "p_clock_user"; }
    if str_equal(name, "sin") { return "p_sin_user"; }
    if str_equal(name, "cos") { return "p_cos_user"; }
    if str_equal(name, "tan") { return "p_tan_user"; }
    if str_equal(name, "sqrt") { return "p_sqrt_user"; }
    if str_equal(name, "pow") { return "p_pow_user"; }
    if str_equal(name, "floor") { return "p_floor_user"; }
    if str_equal(name, "ceil") { return "p_ceil_user"; }
    if str_equal(name, "round") { return "p_round_user"; }
    if str_equal(name, "log") { return "p_log_user"; }
    if str_equal(name, "exp") { return "p_exp_user"; }
    if str_equal(name, "asin") { return "p_asin_user"; }
    if str_equal(name, "acos") { return "p_acos_user"; }
    if str_equal(name, "atan") { return "p_atan_user"; }
    if str_equal(name, "atan2") { return "p_atan2_user"; }
    if str_equal(name, "fmod") { return "p_fmod_user"; }
    if str_equal(name, "fabs") { return "p_fabs_user"; }
    if str_equal(name, "isalpha") { return "p_isalpha_user"; }
    if str_equal(name, "isdigit") { return "p_isdigit_user"; }
    if str_equal(name, "isspace") { return "p_isspace_user"; }
    if str_equal(name, "toupper") { return "p_toupper_user"; }
    if str_equal(name, "tolower") { return "p_tolower_user"; }
    // C keywords / reserved identifiers
    if str_equal(name, "auto") { return "p_auto_user"; }
    if str_equal(name, "break") { return "p_break_user"; }
    if str_equal(name, "case") { return "p_case_user"; }
    if str_equal(name, "char") { return "p_char_user"; }
    if str_equal(name, "const") { return "p_const_user"; }
    if str_equal(name, "continue") { return "p_continue_user"; }
    if str_equal(name, "default") { return "p_default_user"; }
    if str_equal(name, "do") { return "p_do_user"; }
    if str_equal(name, "double") { return "p_double_user"; }
    if str_equal(name, "else") { return "p_else_user"; }
    if str_equal(name, "enum") { return "p_enum_user"; }
    if str_equal(name, "extern") { return "p_extern_user"; }
    if str_equal(name, "float") { return "p_float_user"; }
    if str_equal(name, "for") { return "p_for_user"; }
    if str_equal(name, "goto") { return "p_goto_user"; }
    if str_equal(name, "if") { return "p_if_user"; }
    if str_equal(name, "inline") { return "p_inline_user"; }
    if str_equal(name, "int") { return "p_int_user"; }
    if str_equal(name, "long") { return "p_long_user"; }
    if str_equal(name, "register") { return "p_register_user"; }
    if str_equal(name, "restrict") { return "p_restrict_user"; }
    if str_equal(name, "return") { return "p_return_user"; }
    if str_equal(name, "short") { return "p_short_user"; }
    if str_equal(name, "signed") { return "p_signed_user"; }
    if str_equal(name, "sizeof") { return "p_sizeof_user"; }
    if str_equal(name, "static") { return "p_static_user"; }
    if str_equal(name, "struct") { return "p_struct_user"; }
    if str_equal(name, "switch") { return "p_switch_user"; }
    if str_equal(name, "typedef") { return "p_typedef_user"; }
    if str_equal(name, "union") { return "p_union_user"; }
    if str_equal(name, "unsigned") { return "p_unsigned_user"; }
    if str_equal(name, "void") { return "p_void_user"; }
    if str_equal(name, "volatile") { return "p_volatile_user"; }
    if str_equal(name, "while") { return "p_while_user"; }
    return name;
}

// --- String escaping ------------------------------------------------------

fn escape_c_string(s: str) -> str {
    var result: str = "";
    var i: i64 = 0;
    var len: i64 = str_len(s);
    while i < len {
        var b: i64 = String_byte_at(s, i);
        if b == 34 {
            // "
            result = result + "\\\"";
        } else if b == 92 {
            // backslash
            result = result + "\\\\";
        } else if b == 10 {
            result = result + "\\n";
        } else if b == 13 {
            result = result + "\\r";
        } else if b == 9 {
            result = result + "\\t";
        } else if b >= 32 && b < 127 {
            result = result + char_to_str(b);
        } else {
            // Octal escape \ooo
            result = result + "\\" + int_to_str(b / 64) + int_to_str((b % 64) / 8) + int_to_str(b % 8);
        }
        i = i + 1;
    }
    return result;
}

// --- Value/name helpers ---------------------------------------------------

fn val_name(self: &CCodeGen, id: i64) -> str {
    var i: i64 = 0;
    while i < self.value_names.len() {
        if self.value_names.get(i).id == id {
            return self.value_names.get(i).name;
        }
        i = i + 1;
    }
    return "v" + int_to_str(id);
}

fn fresh_label(self: &mut CCodeGen) -> str {
    var n: i64 = self.label_counter;
    self.label_counter = self.label_counter + 1;
    return "L" + int_to_str(n);
}

fn fresh_temp(self: &mut CCodeGen) -> str {
    var n: i64 = self.temp_counter;
    self.temp_counter = self.temp_counter + 1;
    return "t" + int_to_str(n);
}

// --- Vec helper: contains str ---------------------------------------------

fn vec_contains_str(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if str_equal(v.get(i), s) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// --- Map helpers ----------------------------------------------------------

fn value_names_set(self: &mut CCodeGen, id: i64, name: str) -> void {
    var i: i64 = 0;
    while i < self.value_names.len() {
        if self.value_names.get(i).id == id {
            self.value_names.get(i).name = name;
            return;
        }
        i = i + 1;
    }
    self.value_names.push(ValueNameEntry_new(id, name));
}

fn string_consts_get(self: &CCodeGen, key: str) -> OptStr {
    var i: i64 = 0;
    while i < self.string_consts.len() {
        if str_equal(self.string_consts.get(i).key, key) {
            return OptStr::Some(self.string_consts.get(i).val);
        }
        i = i + 1;
    }
    return OptStr::None;
}

fn string_consts_set(self: &mut CCodeGen, key: str, val: str) -> void {
    var i: i64 = 0;
    while i < self.string_consts.len() {
        if str_equal(self.string_consts.get(i).key, key) {
            self.string_consts.get(i).val = val;
            return;
        }
        i = i + 1;
    }
    self.string_consts.push(StringConstEntry_new(key, val));
}

fn fn_param_types_get(self: &CCodeGen, key: str) -> OptVecIrType {
    var i: i64 = 0;
    while i < self.fn_param_types.len() {
        if str_equal(self.fn_param_types.get(i).key, key) {
            return OptVecIrType::Some(self.fn_param_types.get(i).types);
        }
        i = i + 1;
    }
    return OptVecIrType::None;
}

fn fn_param_types_set(self: &mut CCodeGen, key: str, types: Vec<IrType>) -> void {
    var i: i64 = 0;
    while i < self.fn_param_types.len() {
        if str_equal(self.fn_param_types.get(i).key, key) {
            self.fn_param_types.get(i).types = types;
            return;
        }
        i = i + 1;
    }
    self.fn_param_types.push(FnParamTypesEntry_new(key, types));
}

pub enum OptVecIrType {
    Some(Vec<IrType>),
    None,
}

pub enum OptIrType {
    Some(IrType),
    None,
}

fn fn_ret_types_get(self: &CCodeGen, key: str) -> OptIrType {
    var i: i64 = 0;
    while i < self.fn_ret_types.len() {
        if str_equal(self.fn_ret_types.get(i).key, key) {
            return OptIrType::Some(self.fn_ret_types.get(i).ty);
        }
        i = i + 1;
    }
    return OptIrType::None;
}

fn fn_ret_types_set(self: &mut CCodeGen, key: str, ty: IrType) -> void {
    var i: i64 = 0;
    while i < self.fn_ret_types.len() {
        if str_equal(self.fn_ret_types.get(i).key, key) {
            self.fn_ret_types.get(i).ty = ty;
            return;
        }
        i = i + 1;
    }
    self.fn_ret_types.push(FnRetTypeEntry_new(key, ty));
}

// --- Helpers for building small Vec<IrType> -------------------------------

fn t0() -> Vec<IrType> {
    return Vec::new();
}

fn t1(a: IrType) -> Vec<IrType> {
    var v: Vec<IrType> = Vec::new();
    v.push(a);
    return v;
}

fn t2(a: IrType, b: IrType) -> Vec<IrType> {
    var v: Vec<IrType> = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}

fn t3(a: IrType, b: IrType, c: IrType) -> Vec<IrType> {
    var v: Vec<IrType> = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    return v;
}

fn t4(a: IrType, b: IrType, c: IrType, d: IrType) -> Vec<IrType> {
    var v: Vec<IrType> = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    v.push(d);
    return v;
}

fn t5(a: IrType, b: IrType, c: IrType, d: IrType, e: IrType) -> Vec<IrType> {
    var v: Vec<IrType> = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    v.push(d);
    v.push(e);
    return v;
}

pub fn ptr_u8() -> IrType {
    return IrType::Ptr(Box::new(IrType::U8));
}

