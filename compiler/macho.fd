// macho.fd -- Mach-O Object File Emitter for macOS (x86-64)
// Ported from src/macho.rs. Produces Mach-O 64-bit relocatable object files (.o).
//
// Instruction encoding is shared: this file assembles via ElfEmitter
// (compiler::elf64) and translates its (bytes, symbols, relocations) into
// Mach-O records — it is a format writer only, not a second assembler.
//
// Mach-O 64-bit format:
//   - Mach-O header (32 bytes)
//   - Load commands (LC_SEGMENT_64 + section headers, LC_SYMTAB)
//   - Sections (__TEXT,__text and __TEXT,__const)
//   - Per-section relocation entries
//   - Symbol table (nlist_64, 16 bytes each)
//   - String table

module compiler::macho;

use core;
use vec;
use string;
use compiler::elf64;

// --- Constants ----------------------------------------------------------

pub const MH_MAGIC_64: i64 = 0xFEEDFACF;
pub const CPU_TYPE_X86_64: i64 = 0x01000007;
pub const CPU_SUBTYPE_ALL: i64 = 3;
pub const MH_OBJECT: i64 = 1;

pub const LC_SEGMENT_64: i64 = 0x19;
pub const LC_SYMTAB: i64 = 0x2;

// n_type values
pub const N_UNDF_EXT: i64 = 0x01;   // undefined external
pub const N_SECT: i64 = 0x0e;       // defined in section (local)
pub const N_SECT_EXT: i64 = 0x0f;   // defined external

// x86-64 relocation types
pub const XR_UNSIGNED: i64 = 0;
pub const XR_SIGNED: i64 = 1;
pub const XR_BRANCH: i64 = 2;

// --- Structs ------------------------------------------------------------

pub struct MachOSymbol {
    pub name: str,
    pub value: i64,
    pub section_number: i64,
    pub sym_type: i64,
    pub description: i64,
}

pub fn MachOSymbol_new(name: str, value: i64, section_number: i64, sym_type: i64, description: i64) -> MachOSymbol {
    return MachOSymbol {
        name: name,
        value: value,
        section_number: section_number,
        sym_type: sym_type,
        description: description,
    };
}

pub struct MachOReloc {
    pub offset: i64,
    pub symbol_index: i64,
    pub is_pcrel: bool,
    pub length: i64,
    pub is_extern: bool,
    pub rtype: i64,
    pub section: i64,   // 1 = __text, 2 = __const
}

pub fn MachOReloc_new(offset: i64, symbol_index: i64, is_pcrel: bool, length: i64, is_extern: bool, rtype: i64, section: i64) -> MachOReloc {
    return MachOReloc {
        offset: offset,
        symbol_index: symbol_index,
        is_pcrel: is_pcrel,
        length: length,
        is_extern: is_extern,
        rtype: rtype,
        section: section,
    };
}

pub struct MachOEmitter {
    pub text_bytes: Vec<i64>,
    pub const_bytes: Vec<i64>,
    pub symbols: Vec<MachOSymbol>,
    pub relocations: Vec<MachOReloc>,
    pub string_table: Vec<i64>,
    pub sym_names: Vec<str>,
}

pub fn MachOEmitter_new() -> MachOEmitter {
    return MachOEmitter {
        text_bytes: Vec::new(),
        const_bytes: Vec::new(),
        symbols: Vec::new(),
        relocations: Vec::new(),
        string_table: Vec::new(),
        sym_names: Vec::new(),
    };
}

// --- Result types ---

pub enum ResultVec { Ok(Vec<i64>), Err(str) }

// --- Helper: emit little-endian ---

fn mo_emit_u16(t: &mut Vec, v: i64) { t.push(v & 0xFF); t.push((v >> 8) & 0xFF); }
fn mo_emit_u32(t: &mut Vec, v: i64) {
    t.push(v & 0xFF);
    t.push((v >> 8) & 0xFF);
    t.push((v >> 16) & 0xFF);
    t.push((v >> 24) & 0xFF);
}
fn mo_emit_u64(t: &mut Vec, v: i64) {
    var i: i64 = 0;
    while i < 8 { t.push((v >> (i * 8)) & 0xFF); i = i + 1; }
}

fn mo_sym_index(e: &MachOEmitter, name: str) -> i64 {
    var i: i64 = 0;
    while i < e.sym_names.len() {
        if e.sym_names.get(i) == name { return i; }
        i = i + 1;
    }
    return 0;
}

fn mo_add_symbol(e: &mut MachOEmitter, name: str, value: i64, sect: i64, sym_type: i64) -> i64 {
    var i: i64 = 0;
    while i < e.sym_names.len() {
        if e.sym_names.get(i) == name { return i; }
        i = i + 1;
    }
    var idx: i64 = e.symbols.len();
    e.symbols.push(MachOSymbol_new(name, value, sect, sym_type, 0));
    e.sym_names.push(name);
    return idx;
}

fn mo_rodata_find(em: &ElfEmitter, name: str) -> i64 {
    var i: i64 = 0;
    while i < em.rodata_symbols.len() {
        if em.rodata_symbols.get(i).name == name { return em.rodata_symbols.get(i).offset; }
        i = i + 1;
    }
    return -1;
}

// Assemble via the shared encoder, then translate results into Mach-O
// symbols/relocations/section bytes.
pub fn MachOEmitter_import(self: &mut MachOEmitter, em: &ElfEmitter) {
    var i: i64 = 0;
    while i < em.text.len() {
        self.text_bytes.push(em.text.get(i));
        i = i + 1;
    }
    i = 0;
    while i < em.rodata.len() {
        self.const_bytes.push(em.rodata.get(i));
        i = i + 1;
    }

    // Symbols: defined text syms -> sect 1, rodata syms -> sect 2,
    // undefined -> N_UNDF_EXT
    i = 0;
    while i < em.symbols.len() {
        var s: Symbol = em.symbols.get(i);
        if s.is_defined {
            var t: i64 = N_SECT_EXT;
            if s.binding == 0 { t = N_SECT; }
            mo_add_symbol(self, s.name, s.value, 1, t);
        } else {
            // skip .rodata labels — emitted as section-2 symbols below
            if mo_rodata_find(em, s.name) < 0 {
                mo_add_symbol(self, s.name, 0, 0, N_UNDF_EXT);
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < em.rodata_symbols.len() {
        var rs: RodataSym = em.rodata_symbols.get(i);
        mo_add_symbol(self, rs.name, rs.offset, 2, N_SECT);
        i = i + 1;
    }

    // .text relocations — PC32 sites that are call/jmp targets get
    // X86_64_RELOC_BRANCH; other PC32 sites (lea/rip-rel data) get SIGNED.
    i = 0;
    while i < em.relocations.len() {
        var rel: Relocation = em.relocations.get(i);
        var name: str = em.symbols.get(rel.symbol).name;
        var idx: i64 = mo_sym_index(self, name);
        if rel.rtype == 1 {
            // R_X86_64_64: absolute 8-byte reference
            self.relocations.push(MachOReloc_new(rel.offset, idx, false, 3, true, XR_UNSIGNED, 1));
        } else {
            // PC32/PLT32 — peek at the byte before the disp field to
            // distinguish call/jmp (0xE8/0xE9, or jcc 0x0F) from lea
            var opcode: i64 = self.text_bytes.get(rel.offset - 1);
            var rt: i64 = XR_SIGNED;
            if opcode == 0xE8 || opcode == 0xE9 || opcode == 0x0F { rt = XR_BRANCH; }
            self.relocations.push(MachOReloc_new(rel.offset, idx, true, 2, true, rt, 1));
        }
        i = i + 1;
    }
    // .rdata relocations (absolute addrs, e.g. vtables)
    i = 0;
    while i < em.rodata_relocations.len() {
        var rrel: Relocation = em.rodata_relocations.get(i);
        var rname: str = em.symbols.get(rrel.symbol).name;
        var ridx: i64 = mo_sym_index(self, rname);
        self.relocations.push(MachOReloc_new(rrel.offset, ridx, false, 3, true, XR_UNSIGNED, 2));
        i = i + 1;
    }
}

fn MachOEmitter_add_string(self: &mut MachOEmitter, s: str) -> i64 {
    var offset: i64 = self.string_table.len();
    var i: i64 = 0;
    while i < str_len(s) {
        self.string_table.push(str_byte_at(s, i));
        i = i + 1;
    }
    self.string_table.push(0);
    return offset;
}

fn mo_sectname(buf: &mut Vec, name: str) {
    var i: i64 = 0;
    while i < str_len(name) {
        buf.push(str_byte_at(name, i));
        i = i + 1;
    }
    while i < 16 {
        buf.push(0);
        i = i + 1;
    }
}

fn mo_count_relocs_in(e: &MachOEmitter, sect: i64) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < e.relocations.len() {
        if e.relocations.get(i).section == sect { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// --- Build Mach-O object file ---

pub fn MachOEmitter_build_macho(self: &mut MachOEmitter) -> ResultVec {
    var has_const: bool = self.const_bytes.len() > 0;
    var nsects: i64 = 1;
    if has_const { nsects = 2; }

    var header_size: i64 = 32;
    var segment_cmd_size: i64 = 72;
    var section_header_size: i64 = 80;
    var symtab_cmd_size: i64 = 24;

    var load_commands_size: i64 = segment_cmd_size + section_header_size * nsects + symtab_cmd_size;

    var text_data_offset: i64 = header_size + load_commands_size;
    var text_data_size: i64 = self.text_bytes.len();

    var text_reloc_count: i64 = mo_count_relocs_in(self, 1);
    var const_reloc_count: i64 = mo_count_relocs_in(self, 2);

    var text_reloc_offset: i64 = text_data_offset + text_data_size;
    var const_data_offset: i64 = text_reloc_offset + text_reloc_count * 8;
    var const_data_size: i64 = 0;
    if has_const { const_data_size = self.const_bytes.len(); }
    var const_reloc_offset: i64 = const_data_offset + const_data_size;

    var symbol_table_offset: i64 = const_reloc_offset + const_reloc_count * 8;
    var symbol_table_size: i64 = self.symbols.len() * 16;
    var string_table_offset: i64 = symbol_table_offset + symbol_table_size;

    // Initialize string table (index 0 = empty)
    self.string_table.push(0);

    // Build string table entries for symbols
    var sym_string_offsets: Vec<i64> = Vec::new();
    var si: i64 = 0;
    while si < self.symbols.len() {
        var name: str = self.symbols.get(si).name;
        var offset: i64 = MachOEmitter_add_string(self, name);
        sym_string_offsets.push(offset);
        si = si + 1;
    }

    var buf: Vec<i64> = Vec::new();

    // -- Mach-O Header (32 bytes) --
    mo_emit_u32(&mut buf, MH_MAGIC_64);                     // magic
    mo_emit_u32(&mut buf, CPU_TYPE_X86_64);                 // cputype
    mo_emit_u32(&mut buf, CPU_SUBTYPE_ALL);                  // cpusubtype
    mo_emit_u32(&mut buf, MH_OBJECT);                        // filetype
    mo_emit_u32(&mut buf, 2);                               // ncmds (segment + symtab)
    mo_emit_u32(&mut buf, load_commands_size);              // sizeofcmds
    mo_emit_u32(&mut buf, 0);                               // flags
    mo_emit_u32(&mut buf, 0);                               // reserved

    // -- LC_SEGMENT_64 Load Command --
    mo_emit_u32(&mut buf, LC_SEGMENT_64);                   // cmd
    mo_emit_u32(&mut buf, segment_cmd_size + section_header_size * nsects); // cmdsize
    mo_sectname(&mut buf, "__TEXT");                        // segname
    mo_emit_u64(&mut buf, 0);                               // vmaddr
    mo_emit_u64(&mut buf, text_data_size + const_data_size); // vmsize
    mo_emit_u64(&mut buf, text_data_offset);                // fileoff
    mo_emit_u64(&mut buf, text_data_size + const_data_size); // filesize
    mo_emit_u32(&mut buf, 0);                               // maxprot
    mo_emit_u32(&mut buf, 0);                               // initprot
    mo_emit_u32(&mut buf, nsects);                          // nsects
    mo_emit_u32(&mut buf, 0);                               // flags

    // -- Section Header 1: __text (80 bytes) --
    mo_sectname(&mut buf, "__text");
    mo_sectname(&mut buf, "__TEXT");
    mo_emit_u64(&mut buf, 0);                               // addr
    mo_emit_u64(&mut buf, text_data_size);                  // size
    mo_emit_u32(&mut buf, text_data_offset);                // offset
    mo_emit_u32(&mut buf, text_reloc_offset);               // reloff
    mo_emit_u32(&mut buf, text_reloc_count);                // nreloc
    mo_emit_u32(&mut buf, 0);                               // align
    mo_emit_u32(&mut buf, 0);                               // reserved
    mo_emit_u32(&mut buf, 0);                               // reserved
    mo_emit_u32(&mut buf, 0);                               // flags
    mo_emit_u32(&mut buf, 0);                               // reserved1
    mo_emit_u32(&mut buf, 0);                               // reserved2
    mo_emit_u32(&mut buf, 0);                               // reserved3

    // -- Section Header 2: __const --
    if has_const {
        mo_sectname(&mut buf, "__const");
        mo_sectname(&mut buf, "__TEXT");
        mo_emit_u64(&mut buf, text_data_size);              // addr
        mo_emit_u64(&mut buf, const_data_size);             // size
        mo_emit_u32(&mut buf, const_data_offset);           // offset
        mo_emit_u32(&mut buf, const_reloc_offset);          // reloff
        mo_emit_u32(&mut buf, const_reloc_count);           // nreloc
        mo_emit_u32(&mut buf, 0);                           // align
        mo_emit_u32(&mut buf, 0);                           // reserved
        mo_emit_u32(&mut buf, 0);                           // reserved
        mo_emit_u32(&mut buf, 0);                           // flags
        mo_emit_u32(&mut buf, 0);                           // reserved1
        mo_emit_u32(&mut buf, 0);                           // reserved2
        mo_emit_u32(&mut buf, 0);                           // reserved3
    }

    // -- LC_SYMTAB Load Command (24 bytes) --
    mo_emit_u32(&mut buf, LC_SYMTAB);                       // cmd
    mo_emit_u32(&mut buf, symtab_cmd_size);                 // cmdsize
    mo_emit_u32(&mut buf, symbol_table_offset);             // symoff
    mo_emit_u32(&mut buf, self.symbols.len());              // nsyms
    mo_emit_u32(&mut buf, string_table_offset);             // stroff
    mo_emit_u32(&mut buf, self.string_table.len());         // strsize

    // -- __text section data --
    var ti: i64 = 0;
    while ti < self.text_bytes.len() {
        buf.push(self.text_bytes.get(ti));
        ti = ti + 1;
    }

    // -- __text relocations (8 bytes each) --
    var ri: i64 = 0;
    while ri < self.relocations.len() {
        var reloc: MachOReloc = self.relocations.get(ri);
        if reloc.section == 1 {
            mo_emit_u32(&mut buf, reloc.offset);
            var packed: i64 = reloc.symbol_index & 0x00ffffff;
            if reloc.is_pcrel { packed = packed | (1 << 24); }
            packed = packed | ((reloc.length & 3) << 25);
            if reloc.is_extern { packed = packed | (1 << 27); }
            packed = packed | ((reloc.rtype & 0xf) << 28);
            mo_emit_u32(&mut buf, packed);
        }
        ri = ri + 1;
    }

    // -- __const section data + relocations --
    if has_const {
        var di: i64 = 0;
        while di < self.const_bytes.len() {
            buf.push(self.const_bytes.get(di));
            di = di + 1;
        }
        var rri: i64 = 0;
        while rri < self.relocations.len() {
            var rreloc: MachOReloc = self.relocations.get(rri);
            if rreloc.section == 2 {
                mo_emit_u32(&mut buf, rreloc.offset);
                var rpacked: i64 = rreloc.symbol_index & 0x00ffffff;
                if rreloc.is_pcrel { rpacked = rpacked | (1 << 24); }
                rpacked = rpacked | ((rreloc.length & 3) << 25);
                if rreloc.is_extern { rpacked = rpacked | (1 << 27); }
                rpacked = rpacked | ((rreloc.rtype & 0xf) << 28);
                mo_emit_u32(&mut buf, rpacked);
            }
            rri = rri + 1;
        }
    }

    // -- Symbol Table (nlist_64, 16 bytes each) --
    var syi: i64 = 0;
    while syi < self.symbols.len() {
        var sym: MachOSymbol = self.symbols.get(syi);
        var str_offset: i64 = sym_string_offsets.get(syi);
        mo_emit_u32(&mut buf, str_offset);                   // n_strx
        buf.push(sym.sym_type);                           // n_type
        buf.push(sym.section_number);                     // n_sect
        mo_emit_u16(&mut buf, sym.description);              // n_desc
        mo_emit_u64(&mut buf, sym.value);                    // n_value
        syi = syi + 1;
    }

    // -- String Table --
    var sti: i64 = 0;
    while sti < self.string_table.len() {
        buf.push(self.string_table.get(sti));
        sti = sti + 1;
    }

    return ResultVec::Ok(buf);
}

// --- Public API ---

pub fn emit_macho_file(module: i64, asm: str) -> ResultVec {
    var em: ElfEmitter = ElfEmitter_new();
    match ElfEmitter_assemble(&mut em, asm) {
        ResultUnit::Ok => {}
        ResultUnit::Err(e) => { return ResultVec::Err(e); }
    }
    var emitter: MachOEmitter = MachOEmitter_new();
    MachOEmitter_import(&mut emitter, &em);
    return MachOEmitter_build_macho(emitter);
}
