// macho.fd -- Mach-O Object File Emitter for macOS (x86-64)
// Ported from src/macho.rs. Produces Mach-O 64-bit relocatable object files (.o).
//
// Instruction encoding is shared: this file assembles via ElfEmitter
// (compiler::elf64) and translates its (bytes, symbols, relocations) into
// Mach-O records — it is a format writer only, not a second assembler.
//
// Mach-O 64-bit format:
//   - Mach-O header (32 bytes)
//   - Load commands (LC_SEGMENT_64 + section headers, LC_SYMTAB)
//   - Sections (__TEXT,__text and __TEXT,__const)
//   - Per-section relocation entries
//   - Symbol table (nlist_64, 16 bytes each)
//   - String table

module compiler::macho; use core; use vec; use string; use compiler::elf64; use compiler::image_writer;  // --- Constants ----------------------------------------------------------

pub const MH_MAGIC_64: i64 = 0xFEEDFACF; pub const CPU_TYPE_X86_64: i64 = 0x01000007; pub const CPU_SUBTYPE_ALL: i64 = 3; pub const MH_OBJECT: i64 = 1; pub const LC_SEGMENT_64: i64 = 0x19; pub const LC_SYMTAB: i64 = 0x2;  // n_type values
pub const N_UNDF_EXT: i64 = 0x01;  // undefined external
pub const N_SECT: i64 = 0x0e;  // defined in section (local)
pub const N_SECT_EXT: i64 = 0x0f;  // defined external

// x86-64 relocation types
pub const XR_UNSIGNED: i64 = 0; pub const XR_SIGNED: i64 = 1; pub const XR_BRANCH: i64 = 2;  // --- Structs ------------------------------------------------------------

pub struct MachOSymbol {
    pub name: str,
    pub value: i64,
    pub section_number: i64,
    pub sym_type: i64,
    pub description: i64,
}

pub fn MachOSymbol_new(name: str, value: i64, section_number: i64, sym_type: i64, description: i64) -> MachOSymbol {
    return MachOSymbol {
        name: name, value: value, section_number: section_number, sym_type: sym_type, description: description,
    };
}

pub struct MachOReloc {
    pub offset: i64,
    pub symbol_index: i64,
    pub is_pcrel: bool,
    pub length: i64,
    pub is_extern: bool,
    pub rtype: i64,
    pub section: i64,  // 1 = __text, 2 = __const
}

pub fn MachOReloc_new(offset: i64, symbol_index: i64, is_pcrel: bool, length: i64, is_extern: bool, rtype: i64, section: i64) -> MachOReloc {
    return MachOReloc {
        offset: offset, symbol_index: symbol_index, is_pcrel: is_pcrel, length: length, is_extern: is_extern, rtype: rtype, section: section,
    };
}

pub struct MachOEmitter {
    pub text_bytes: Vec<i64>,
    pub const_bytes: Vec<i64>,
    pub symbols: Vec<MachOSymbol>,
    pub relocations: Vec<MachOReloc>,
    pub string_table: Vec<i64>,
    pub sym_names: Vec<str>,
}

pub fn MachOEmitter_new() -> MachOEmitter {
    return MachOEmitter {
        text_bytes: Vec::new(), const_bytes: Vec::new(), symbols: Vec::new(), relocations: Vec::new(), string_table: Vec::new(), sym_names: Vec::new(),
    };
}

// --- Result types ---

pub enum ResultVec {
    Ok(Vec<i64>),
    Err(str)
}

fn mo_sym_index(e: & MachOEmitter, name: str) -> i64 {
    var i: i64 = 0;
    while i < e.sym_names.len() {
        if e.sym_names.get(i) == name {
            return i;
        }
        i = i + 1;
    }
    return 0;
}

fn mo_add_symbol(e: & mut MachOEmitter, name: str, value: i64, sect: i64, sym_type: i64) -> i64 {
    var i: i64 = 0;
    while i < e.sym_names.len() {
        if e.sym_names.get(i) == name {
            return i;
        }
        i = i + 1;
    }
    var idx: i64 = e.symbols.len();
    e.symbols.push(MachOSymbol_new(name, value, sect, sym_type, 0));
    e.sym_names.push(name);
    return idx;
}

fn mo_rodata_find(em: & ElfEmitter, name: str) -> i64 {
    var i: i64 = 0;
    while i < em.rodata_symbols.len() {
        if em.rodata_symbols.get(i).name == name {
            return em.rodata_symbols.get(i).offset;
        }
        i = i + 1;
    }
    return - 1;
}

// Assemble via the shared encoder, then translate results into Mach-O
// symbols/relocations/section bytes.
pub fn MachOEmitter_import(self: & mut MachOEmitter, em: & ElfEmitter) {
    var i: i64 = 0;
    while i < em.text.len() {
        self.text_bytes.push(em.text.get(i));
        i = i + 1;
    }
    i = 0;
    while i < em.rodata.len() {
        self.const_bytes.push(em.rodata.get(i));
        i = i + 1;
    }

    // Symbols: defined text syms -> sect 1, rodata syms -> sect 2,
    // undefined -> N_UNDF_EXT
    i = 0;
    while i < em.symbols.len() {
        var s: Symbol = em.symbols.get(i);
        if s.is_defined {
            var t: i64 = N_SECT_EXT;
            if s.binding == 0 {
                t = N_SECT;
            }
            mo_add_symbol(self, s.name, s.value, 1, t);
        } else {
            // skip .rodata labels — emitted as section-2 symbols below
            if mo_rodata_find(em, s.name) < 0 {
                mo_add_symbol(self, s.name, 0, 0, N_UNDF_EXT);
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < em.rodata_symbols.len() {
        var rs: RodataSym = em.rodata_symbols.get(i);
        mo_add_symbol(self, rs.name, rs.offset, 2, N_SECT);
        i = i + 1;
    }

    // .text relocations — PC32 sites that are call/jmp targets get
    // X86_64_RELOC_BRANCH; other PC32 sites (lea/rip-rel data) get SIGNED.
    i = 0;
    while i < em.relocations.len() {
        var rel: Relocation = em.relocations.get(i);
        var name: str = em.symbols.get(rel.symbol).name;
        var idx: i64 = mo_sym_index(self, name);
        if rel.rtype == 1 {
            // R_X86_64_64: absolute 8-byte reference
            self.relocations.push(MachOReloc_new(rel.offset, idx, false, 3, true, XR_UNSIGNED, 1));
        } else {
            // PC32/PLT32 — peek at the byte before the disp field to
            // distinguish call/jmp (0xE8/0xE9, or jcc 0x0F) from lea
            var opcode: i64 = self.text_bytes.get(rel.offset - 1);
            var rt: i64 = XR_SIGNED;
            if opcode == 0xE8 || opcode == 0xE9 || opcode == 0x0F {
                rt = XR_BRANCH;
            }
            self.relocations.push(MachOReloc_new(rel.offset, idx, true, 2, true, rt, 1));
        }
        i = i + 1;
    }
    // .rdata relocations (absolute addrs, e.g. vtables)
    i = 0;
    while i < em.rodata_relocations.len() {
        var rrel: Relocation = em.rodata_relocations.get(i);
        var rname: str = em.symbols.get(rrel.symbol).name;
        var ridx: i64 = mo_sym_index(self, rname);
        self.relocations.push(MachOReloc_new(rrel.offset, ridx, false, 3, true, XR_UNSIGNED, 2));
        i = i + 1;
    }
}

fn mo_count_relocs_in(e: & MachOEmitter, sect: i64) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < e.relocations.len() {
        if e.relocations.get(i).section == sect {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

// --- Build Mach-O object file ---

pub fn MachOEmitter_build_macho(self: & mut MachOEmitter) -> ResultVec {
    // TG13: the object from compiler/image_writer.fd (the old body wrote a
    // malformed MH_OBJECT and is gone: docs/image-writer.md)
    return MachOEmitter_build_macho_img(self);
}

/// Where symbol `s` goes in an object's symbol table: 0 local (N_SECT),
/// 1 defined external (N_SECT | N_EXT), 2 undefined (N_UNDF | N_EXT).
fn mo_sym_group(s: & MachOSymbol) -> i64 {
    if s.section_number == 0 {
        return 2;
    }
    if (s.sym_type & 1) != 0 {
        return 1;
    }
    return 0;
}

/// The relocations of section `sect` (1 __text, 2 __const) as
/// relocation_info records, symbols renumbered by `newidx`.
fn mo_img_relocs(self: & MachOEmitter, sect: i64, newidx: & Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < self.relocations.len() {
        var r: MachOReloc = self.relocations.get(i);
        if r.section == sect {
            var sym: i64 = 0;
            if r.symbol_index >= 0 && r.symbol_index < newidx.len() {
                sym = newidx.get(r.symbol_index);
            }
            img_macho_reloc(& mut out, r.offset, sym, r.is_pcrel, r.length, r.is_extern, r.rtype);
        }
        i = i + 1;
    }
    return out;
}

/// TG13: the Mach-O relocatable object of the assembler path (`fid
/// codegen --macho`) over image_writer. Unlike the old body above it is
/// well-formed, so the bytes differ (docs/image-writer.md):
///   - 80-byte section_64 headers in the right field order (offset,
///     align, reloff, nreloc, flags; the old ones were 88 bytes with
///     reloff and nreloc where align goes)
///   - the section data together (__const at the next 8-byte address
///     after __text, at the same distance in the file), then the
///     relocations, the symbols and the strings
///   - the one segment unnamed and rwx, as object files have it
///   - LC_DYSYMTAB, and the symbols in its order: locals, defined
///     externals, undefined (relocations renumbered to match)
///   - a __const symbol's n_value its address (__const's address + its
///     offset; the old body wrote the offset)
///   - __text flagged S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
pub fn MachOEmitter_build_macho_img(self: & mut MachOEmitter) -> ResultVec {
    var text_size: i64 = self.text_bytes.len();
    var const_size: i64 = self.const_bytes.len();
    // __const when there are bytes, symbols or relocations in it
    var has_const: bool = const_size > 0 || mo_count_relocs_in(self, 2) > 0;
    var si: i64 = 0;
    while si < self.symbols.len() {
        if self.symbols.get(si).section_number == 2 {
            has_const = true;
        }
        si = si + 1;
    }
    var nsects: i64 = 1;
    if has_const {
        nsects = 2;
    }
    var const_addr: i64 = img_round(text_size, 8);
    var span: i64 = text_size;
    if has_const {
        span = const_addr + const_size;
    }
    // The symbols in LC_DYSYMTAB's order; newidx: emitter index -> index
    var n: i64 = self.symbols.len();
    var newidx: Vec<i64> = Vec::new();
    while newidx.len() < n {
        newidx.push(0);
    }
    var counts: Vec<i64> = Vec::new();
    var strtab: Vec<i64> = Vec::new();
    strtab.push(0);
    var nl: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < 3 {
        var c: i64 = 0;
        var i: i64 = 0;
        while i < n {
            var s: MachOSymbol = self.symbols.get(i);
            if mo_sym_group(& s) == k {
                newidx.set(i, nl.len() / 16);
                var value: i64 = s.value;
                if s.section_number == 2 {
                    value = const_addr + s.value;
                } else if s.section_number == 0 {
                    value = 0;
                }
                var strx: i64 = img_str_add(& mut strtab, s.name);
                img_macho_nlist(& mut nl, strx, s.sym_type, s.section_number, s.description, value);
                c = c + 1;
            }
            i = i + 1;
        }
        counts.push(c);
        k = k + 1;
    }
    img_align(& mut strtab, 8);
    var text_rel: Vec<i64> = mo_img_relocs(self, 1, & newidx);
    var const_rel: Vec<i64> = mo_img_relocs(self, 2, & newidx);
    // Layout: header, load commands, section data, relocations, symbols,
    // strings
    var cmds_size: i64 = 72 + 80 * nsects + 24 + 80;
    var text_off: i64 = 32 + cmds_size;
    var const_off: i64 = text_off + const_addr;
    var text_rel_off: i64 = img_round(text_off + span, 8);
    var const_rel_off: i64 = text_rel_off + text_rel.len();
    var sym_off: i64 = const_rel_off + const_rel.len();
    var str_off: i64 = sym_off + nl.len();
    var out: Vec<i64> = Vec::new();
    img_macho_header(& mut out, CPU_TYPE_X86_64, CPU_SUBTYPE_ALL, MH_OBJECT, 3, cmds_size, 0);
    img_macho_segment(& mut out, "", 0, span, text_off, span, 7, 7, nsects);
    var text_rel_at: i64 = 0;
    if text_rel.len() > 0 {
        text_rel_at = text_rel_off;
    }
    img_macho_section_rel(& mut out, "__text", "__TEXT", 0, text_size, text_off, 4, text_rel_at, text_rel.len() / 8, 0x80000400);
    if has_const {
        var const_rel_at: i64 = 0;
        if const_rel.len() > 0 {
            const_rel_at = const_rel_off;
        }
        img_macho_section_rel(& mut out, "__const", "__TEXT", const_addr, const_size, const_off, 3, const_rel_at, const_rel.len() / 8, 0);
    }
    img_macho_symtab_cmd(& mut out, sym_off, nl.len() / 16, str_off, strtab.len());
    img_macho_dysymtab_cmd(& mut out, 0, counts.get(0), counts.get(0), counts.get(1), counts.get(0) + counts.get(1), counts.get(2));
    img_append(& mut out, & self.text_bytes);
    if has_const {
        img_pad_to(& mut out, const_off);
        img_append(& mut out, & self.const_bytes);
    }
    img_pad_to(& mut out, text_rel_off);
    img_append(& mut out, & text_rel);
    img_append(& mut out, & const_rel);
    img_append(& mut out, & nl);
    img_append(& mut out, & strtab);
    return ResultVec::Ok(out);
}

// --- Public API ---

pub fn emit_macho_file(module: i64, asm: str) -> ResultVec {
    var em: ElfEmitter = ElfEmitter_new();
    match ElfEmitter_assemble(& mut em, asm) {
        ResultUnit::Ok => {
        }
        ResultUnit::Err(e) => {
            return ResultVec::Err(e);
        }
    }
    var emitter: MachOEmitter = MachOEmitter_new();
    MachOEmitter_import(& mut emitter, & em);
    return MachOEmitter_build_macho(emitter);
}
