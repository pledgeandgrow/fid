    while i < d.methods.len() { aw_traitmethod(b, d.methods.get(i)); i = i + 1; }
    aw_i64(b, d.associated_types.len());
    i = 0;
    while i < d.associated_types.len() { aw_assoctypedecl(b, d.associated_types.get(i)); i = i + 1; }
    aw_bool(b, d.is_pub);
    aw_strs(b, d.supertraits);
}

pub fn ar_traitdef(r: &mut ArBuf) -> TraitDef {
    var d: TraitDef = TraitDef_new(ar_str(r), Vec::new());
    var n: i64 = ar_i64(r);
    var ms: Vec<TraitMethod> = Vec::new();
    var i: i64 = 0;
    while i < n { ms.push(ar_traitmethod(r)); i = i + 1; }
    d.methods = ms;
    n = ar_i64(r);
    var ats: Vec<AssocTypeDecl> = Vec::new();
    i = 0;
    while i < n { ats.push(ar_assoctypedecl(r)); i = i + 1; }
    d.associated_types = ats;
    d.is_pub = ar_bool(r);
    d.supertraits = ar_strs(r);
    return d;
}

