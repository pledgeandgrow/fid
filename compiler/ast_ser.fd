    d.params = ar_params(r);
    d.body = ar_stmts(r);
    d.is_pub = ar_bool(r);
    return d;
}

pub fn aw_program(b: &mut AwBuf, p: Program) {
    aw_optstr(b, p.module);
    aw_funcs(b, p.funcs);
    aw_i64(b, p.structs.len());
    var i: i64 = 0;
    while i < p.structs.len() { aw_structdef(b, p.structs.get(i)); i = i + 1; }
    aw_i64(b, p.enums.len());
    i = 0;
    while i < p.enums.len() { aw_enumdef(b, p.enums.get(i)); i = i + 1; }
    aw_i64(b, p.consts.len());
    i = 0;
    while i < p.consts.len() { aw_constdef(b, p.consts.get(i)); i = i + 1; }
    aw_i64(b, p.globals.len());
    i = 0;
    while i < p.globals.len() { aw_globalvar(b, p.globals.get(i)); i = i + 1; }
    aw_i64(b, p.type_aliases.len());
    i = 0;
    while i < p.type_aliases.len() { aw_typealias(b, p.type_aliases.get(i)); i = i + 1; }
    aw_i64(b, p.impls.len());
    i = 0;
    while i < p.impls.len() { aw_impldef(b, p.impls.get(i)); i = i + 1; }
    aw_i64(b, p.imports.len());
    i = 0;
    while i < p.imports.len() { aw_importdef(b, p.imports.get(i)); i = i + 1; }
    aw_i64(b, p.attributes.len());
    i = 0;
    while i < p.attributes.len() { aw_attribute(b, p.attributes.get(i)); i = i + 1; }
    aw_i64(b, p.traits.len());
    i = 0;
    while i < p.traits.len() { aw_traitdef(b, p.traits.get(i)); i = i + 1; }
    aw_i64(b, p.trait_impls.len());
    i = 0;
    while i < p.trait_impls.len() { aw_traitimpl(b, p.trait_impls.get(i)); i = i + 1; }
    aw_i64(b, p.extern_decls.len());
    i = 0;
    while i < p.extern_decls.len() { aw_externdecl(b, p.extern_decls.get(i)); i = i + 1; }
    aw_i64(b, p.layers.len());
    i = 0;
    while i < p.layers.len() { aw_layerdef(b, p.layers.get(i)); i = i + 1; }
    aw_i64(b, p.models.len());
    i = 0;
    while i < p.models.len() { aw_modeldef(b, p.models.get(i)); i = i + 1; }
    aw_i64(b, p.components.len());
    i = 0;
    while i < p.components.len() { aw_componentdef(b, p.components.get(i)); i = i + 1; }
    aw_i64(b, p.systems.len());
    i = 0;
    while i < p.systems.len() { aw_systemdef(b, p.systems.get(i)); i = i + 1; }
    aw_i64(b, p.state_machines.len());
    i = 0;
    while i < p.state_machines.len() { aw_statemachinedef(b, p.state_machines.get(i)); i = i + 1; }
    aw_i64(b, p.event_handlers.len());
    i = 0;
    while i < p.event_handlers.len() { aw_eventhandlerdef(b, p.event_handlers.get(i)); i = i + 1; }
}

pub fn ar_program(r: &mut ArBuf) -> Program {
    var p: Program = program_new();
    p.module = ar_optstr(r);
    p.funcs = ar_funcs(r);
    var n: i64 = ar_i64(r);
    var i: i64 = 0;
    while i < n { p.structs.push(ar_structdef(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.enums.push(ar_enumdef(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.consts.push(ar_constdef(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.globals.push(ar_globalvar(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.type_aliases.push(ar_typealias(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.impls.push(ar_impldef(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.imports.push(ar_importdef(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.attributes.push(ar_attribute(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.traits.push(ar_traitdef(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.trait_impls.push(ar_traitimpl(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.extern_decls.push(ar_externdecl(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.layers.push(ar_layerdef(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.models.push(ar_modeldef(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.components.push(ar_componentdef(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.systems.push(ar_systemdef(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.state_machines.push(ar_statemachinedef(r)); i = i + 1; }
    n = ar_i64(r); i = 0;
    while i < n { p.event_handlers.push(ar_eventhandlerdef(r)); i = i + 1; }
    return p;
}

// --- entry points ------------------------------------------------------------

// Serialize a Program to a byte vector: "FIDA" + version(i64) + payload.
// The caller writes the hash/stamp header around this payload.
pub fn ast_ser_program(p: Program) -> Vec<i64> {
    var b: AwBuf = AwBuf { bytes: Vec::new() };
    aw_i64(&mut b, 4473414);   // "FID" magic (versioned below)
    aw_i64(&mut b, 2);         // format version
    aw_program(&mut b, p);
    return b.bytes;
}

// Deserialize; returns OptProgram::None on any truncation/mismatch.
pub fn ast_deser_program(v: Vec<i64>) -> Program {
    var r: ArBuf = ArBuf { v: v, pos: 0, ok: true };
    var magic: i64 = ar_i64(&mut r);
    var ver: i64 = ar_i64(&mut r);
    if magic != 4473414 || ver != 2 {
        r.ok = false;
        return program_new();
    }
    var p: Program = ar_program(&mut r);
    if !r.ok { return program_new(); }
    return p;
}

pub fn ast_deser_ok(v: Vec<i64>) -> bool {
    var r: ArBuf = ArBuf { v: v, pos: 0, ok: true };
    var magic: i64 = ar_i64(&mut r);
    var ver: i64 = ar_i64(&mut r);
    return magic == 4473414 && ver == 2 && r.ok;
}

pub fn awbuf_new() -> AwBuf { return AwBuf { bytes: Vec::new() }; }
pub fn arbuf_new(v: Vec<i64>) -> ArBuf { return ArBuf { v: v, pos: 0, ok: true }; }
pub fn arbuf_ok(r: &ArBuf) -> bool { return r.ok; }
pub fn awbuf_bytes(b: &AwBuf) -> Vec<i64> { return b.bytes; }

// Fast bytes -> counted str (str_from_bytes concats per byte: O(n^2)).
pub fn ast_bytes_to_str(bytes: Vec<i64>) -> str {
    var s: i64 = p_str_buf(bytes.len());
    var i: i64 = 0;
    while i < bytes.len() {
        var p: *mut u8 = (s + i) as *mut u8;
        unsafe { *p = bytes.get(i) as u8; }
        i = i + 1;
    }
    return s as str;
}
