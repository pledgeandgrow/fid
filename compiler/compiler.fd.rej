+/// Cache entry: file path -> parsed Program (avoids re-parsing).
+/// This is the parse cache for imports — on a cache hit, the already-parsed
+/// AST is reused, skipping both lexing and parsing entirely.
+pub struct PathProgram {
+    pub path: str,
+    pub program: Program,
+}
+
+pub fn PathProgram_new(path: str, program: Program) -> PathProgram {
+    return PathProgram { path: path, program: program };
+}
+
+/// Global parse cache for imported modules. Persists across ccompile calls
+/// within a single process. Keyed by file path. On a cache hit, the parsed
+/// Program is reused — no file read, no lex, no parse.
+/// This is the biggest win for repeated compilations: the 52-module compiler
+/// has ~50 imports that get re-parsed on every ccompile call. With this cache,
+/// only the first compilation parses them; subsequent calls skip all parsing.
+pub var g_parse_cache: Vec<PathProgram> = Vec::new();
+var g_parse_cache_init: bool = false;
+
+/// Look up a cached parsed Program by file path.
+/// Returns OptProgram::Some(program) on hit, OptProgram::None on miss.
+pub fn parse_cache_get(path: str) -> OptProgram {
+    if !g_parse_cache_init { return OptProgram::None; }
+    var i: i64 = 0;
+    while i < g_parse_cache.len() {
+        if str_equal(g_parse_cache.get(i).path, path) {
+            return OptProgram::Some(g_parse_cache.get(i).program);
+        }
+        i = i + 1;
+    }
+    return OptProgram::None;
+}
+
+/// Store a parsed Program in the global parse cache.
+pub fn parse_cache_store(path: str, program: Program) -> void {
+    if !g_parse_cache_init {
+        g_parse_cache = Vec::new();
+        g_parse_cache_init = true;
+    }
+    // Check if path already cached — replace if so
+    var i: i64 = 0;
+    while i < g_parse_cache.len() {
+        if str_equal(g_parse_cache.get(i).path, path) {
+            g_parse_cache.set(i, PathProgram_new(path, program));
+            return;
+        }
+        i = i + 1;
+    }
+    g_parse_cache.push(PathProgram_new(path, program));
+}
+
+/// Clear the global parse cache (e.g., when file content may have changed).
+pub fn parse_cache_clear() -> void {
+    while g_parse_cache.len() > 0 {
+        g_parse_cache.pop();
+    }
+    g_parse_cache_init = false;
+}
+
