// fmt.fd -- Fides code formatter (SH-6.4 rewrite of fmt.rs)
//
// A token-based pretty-printer (like early gofmt). It reads Fides source,
// tokenizes it (preserving comments, which the main lexer drops), and
// re-prints with consistent formatting:
//   - 4 spaces indentation
//   - Normalized spacing around binary operators
//   - Space after commas
//   - No trailing whitespace
//   - Single blank line between top-level definitions
//   - Opening brace on same line; closing brace on its own line
//   - Comments aligned with their code

module compiler::fmt;
use core;
use vec;
use string;

// --- Formatter Token --------------------------------------------------

/// A formatter token. Unlike the compiler's Token, this preserves comments
/// and string/number/identifier *text* so we can reprint faithfully.
pub enum FTok {
    Word(str),
    // keywords and identifiers (literal text)
    Number(str),
    // integer / float literal text
    Str(str),
    // string literal including surrounding quotes
    FStr(str),
    // f-string literal including leading 'f'
    LineComment(str),
    // line comment including leading //
    BlockComment(str),
    // block comment including delimiters
    Punct(str),
    // punctuation / operators
    BlankLines(i64),
    // blank-line separator count
    Eof,  // end of file sentinel
}

// --- Character classification helpers ---------------------------------

fn is_alpha_or_underscore(b: i64) -> bool {
    return char_is_alpha(b) || b == 95;
}

fn is_alnum_or_underscore(b: i64) -> bool {
    return char_is_alpha(b) || char_is_digit(b) || b == 95;
}

// --- Multi-char punctuation table -------------------------------------

/// Check if a multi-char punct starting at position `pos` in `src` matches.
/// Returns the length of the match (0 = no match).
fn try_multi_punct(src: str, pos: i64, len: i64) -> i64 {
    // Try longest first: 3-char operators
    if pos + 3 <= len {
        var s3: str = str_slice(src, pos, pos + 3);
        if s3 == "..=" {
            return 3;
        }
        if s3 == "<<=" {
            return 3;
        }
        if s3 == ">>=" {
            return 3;
        }
    }
    // 2-char operators
    if pos + 2 <= len {
        var s2: str = str_slice(src, pos, pos + 2);
        if s2 == "|>" {
            return 2;
        }
        if s2 == "??" {
            return 2;
        }
        if s2 == "?." {
            return 2;
        }
        if s2 == "~>" {
            return 2;
        }
        if s2 == "::" {
            return 2;
        }
        if s2 == "->" {
            return 2;
        }
        if s2 == "=>" {
            return 2;
        }
        if s2 == "==" {
            return 2;
        }
        if s2 == "!=" {
            return 2;
        }
        if s2 == "<=" {
            return 2;
        }
        if s2 == ">=" {
            return 2;
        }
        if s2 == "&&" {
            return 2;
        }
        if s2 == "||" {
            return 2;
        }
        if s2 == "<<" {
            return 2;
        }
        if s2 == ">>" {
            return 2;
        }
        if s2 == "+=" {
            return 2;
        }
        if s2 == "-=" {
            return 2;
        }
        if s2 == "*=" {
            return 2;
        }
        if s2 == "/=" {
            return 2;
        }
        if s2 == "%=" {
            return 2;
        }
        if s2 == "&=" {
            return 2;
        }
        if s2 == "|=" {
            return 2;
        }
        if s2 == "^=" {
            return 2;
        }
    }
    return 0;
}

/// Check if a byte is a single-char punctuation.
fn is_single_punct(b: i64) -> bool {
    // + - * / % = < > ! & | ^ ~ . , : ; ? @ # ( ) [ ] { }
    if b == 43 {
        return true;
    }
    // +
    if b == 45 {
        return true;
    }
    // -
    if b == 42 {
        return true;
    }
    // *
    if b == 47 {
        return true;
    }
    // /
    if b == 37 {
        return true;
    }
    // %
    if b == 61 {
        return true;
    }
    // =
    if b == 60 {
        return true;
    }
    // <
    if b == 62 {
        return true;
    }
    // >
    if b == 33 {
        return true;
    }
    // !
    if b == 38 {
        return true;
    }
    // &
    if b == 124 {
        return true;
    }
    // |
    if b == 94 {
        return true;
    }
    // ^
    if b == 126 {
        return true;
    }
    // ~
    if b == 46 {
        return true;
    }
    // .
    if b == 44 {
        return true;
    }
    // ,
    if b == 58 {
        return true;
    }
    // :
    if b == 59 {
        return true;
    }
    // ;
    if b == 63 {
        return true;
    }
    // ?
    if b == 64 {
        return true;
    }
    // @
    if b == 35 {
        return true;
    }
    // #
    if b == 40 {
        return true;
    }
    // (
    if b == 41 {
        return true;
    }
    // )
    if b == 91 {
        return true;
    }
    // [
    if b == 93 {
        return true;
    }
    // ]
    if b == 123 {
        return true;
    }
    // {
    if b == 125 {
        return true;
    }
    // }
    return false;
}

// --- Tokenizer --------------------------------------------------------

/// Tokenize Fides source into formatter tokens (preserving comments & strings).
pub fn fmt_tokenize(src: str) -> Vec<FTok> {
    var tokens: Vec<FTok> = Vec::new();
    var len: i64 = str_len(src);
    var i: i64 = 0;
    var blank_count: i64 = 0;
    var saw_newline: bool = false;

    while i < len {
        var c: i64 = str_byte_at(src, i);

        // Whitespace -- track newlines for blank-line preservation
        if char_is_whitespace(c) {
            if c == 10 {
                if saw_newline {
                    blank_count = blank_count + 1;
                }
                saw_newline = true;
            }
            i = i + 1;
            continue;
        }

        // If we accumulated blank lines before this token, emit a marker
        var after_newline: bool = saw_newline;
        if blank_count > 0 {
            tokens.push(FTok::BlankLines(blank_count));
            blank_count = 0;
        } else if after_newline && c == 47 && i + 1 < len && str_byte_at(src, i + 1) == 47 {
            // N4: a line comment on a line of its own gets a marker too
            // (no blank line: BlankLines(0)), so the printer keeps it on
            // its own line; one with no marker is a trailing comment of the
            // code before it on the same line, and stays there
            tokens.push(FTok::BlankLines(0));
        }
        saw_newline = false;

        // Line comment: //
        if c == 47 && i + 1 < len && str_byte_at(src, i + 1) == 47 {
            var start: i64 = i;
            i = i + 2;
            while i < len && str_byte_at(src, i) != 10 {
                i = i + 1;
            }
            var text: str = str_slice(src, start, i);
            text = str_trim_end(text);
            tokens.push(FTok::LineComment(text));
            continue;
        }

        // Block comment: /* ... */
        if c == 47 && i + 1 < len && str_byte_at(src, i + 1) == 42 {
            var start: i64 = i;
            i = i + 2;
            while i + 1 < len {
                if str_byte_at(src, i) == 42 && str_byte_at(src, i + 1) == 47 {
                    break;
                }
                i = i + 1;
            }
            if i + 1 < len {
                i = i + 2;
            } else {
                i = len;
            }
            var text: str = str_slice(src, start, i);
            text = str_trim_end(text);
            tokens.push(FTok::BlockComment(text));
            continue;
        }

        // Character literal: 'A', '\n', '\'' -- one token, printed as it
        // is. Read as quote / name / quote, the spacing rules put spaces
        // inside it (`c >= ' A '`), which changed its meaning and broke the
        // build after a whole-tree `fid fmt` (the token check could not see
        // it: the three tokens were the same). A quote with no closing one
        // within a few bytes stays punctuation.
        if c == 39 {
            var cj: i64 = i + 1;
            if cj < len && str_byte_at(src, cj) == 92 { cj = cj + 2; } else { cj = cj + 1; }
            // a UTF-8 character: its continuation bytes
            while cj < len && cj < i + 6 && str_byte_at(src, cj) >= 128 && str_byte_at(src, cj) < 192 { cj = cj + 1; }
            if cj < len && str_byte_at(src, cj) == 39 {
                tokens.push(FTok::Str(str_slice(src, i, cj + 1)));
                i = cj + 1;
                continue;
            }
        }

        // f-string: f"..."
        if c == 102 && i + 1 < len && str_byte_at(src, i + 1) == 34 {
            var start: i64 = i;
            i = i + 2;
            while i < len && str_byte_at(src, i) != 34 {
                if str_byte_at(src, i) == 92 && i + 1 < len {
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            }
            if i < len {
                i = i + 1;
            }
            var text: str = str_slice(src, start, i);
            tokens.push(FTok::FStr(text));
            continue;
        }

        // Raw string: r"..." or r#"..."# (no escape processing)
        if c == 114 && i + 1 < len && (str_byte_at(src, i + 1) == 34 || str_byte_at(src, i + 1) == 35) {
            var start: i64 = i;
            i = i + 1;
            // Count hash markers for r#"..."# syntax
            var hash_count: i64 = 0;
            while i < len && str_byte_at(src, i) == 35 {
                hash_count = hash_count + 1;
                i = i + 1;
            }
            if i < len && str_byte_at(src, i) == 34 {
                i = i + 1;
                // Scan for closing " followed by exactly hash_count # markers
                while i < len {
                    if str_byte_at(src, i) == 34 {
                        // Check if followed by hash_count # markers
                        var j: i64 = 0;
                        var ok: bool = true;
                        while j < hash_count {
                            if i + 1 + j >= len || str_byte_at(src, i + 1 + j) != 35 {
                                ok = false;
                                j = hash_count;
                            }
                            j = j + 1;
                        }
                        if ok {
                            i = i + 1 + hash_count;
                            break;
                        }
                    }
                    i = i + 1;
                }
                var text: str = str_slice(src, start, i);
                tokens.push(FTok::Str(text));
                continue;
            }
            // Not a valid raw string, fall through to identifier handling
            i = start;
        }

        // String literal: "..."
        if c == 34 {
            var start: i64 = i;
            i = i + 1;
            while i < len && str_byte_at(src, i) != 34 {
                if str_byte_at(src, i) == 92 && i + 1 < len {
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            }
            if i < len {
                i = i + 1;
            }
            var text: str = str_slice(src, start, i);
            tokens.push(FTok::Str(text));
            continue;
        }

        // Number literal (int / float / hex / bin / oct with underscores)
        if char_is_digit(c) {
            var start: i64 = i;
            // Optional hex/bin/oct prefix
            if c == 48 && i + 1 < len {
                var next: i64 = str_byte_at(src, i + 1);
                if next == 120 || next == 88 || next == 98 || next == 66 || next == 111 || next == 79 {
                    i = i + 2;
                    while i < len {
                        var ch: i64 = str_byte_at(src, i);
                        if char_is_alpha(ch) || char_is_digit(ch) || ch == 95 {
                            i = i + 1;
                        } else {
                            break;
                        }
                    }
                } else {
                    while i < len {
                        var ch: i64 = str_byte_at(src, i);
                        if char_is_digit(ch) || ch == 95 {
                            i = i + 1;
                        } else {
                            break;
                        }
                    }
                    // fractional part
                    if i < len && str_byte_at(src, i) == 46 && i + 1 < len && char_is_digit(str_byte_at(src, i + 1)) {
                        i = i + 1;
                        while i < len {
                            var ch: i64 = str_byte_at(src, i);
                            if char_is_digit(ch) || ch == 95 {
                                i = i + 1;
                            } else {
                                break;
                            }
                        }
                    }
                    // Scientific notation: e/E followed by optional +/- and digits
                    if i < len && (str_byte_at(src, i) == 101 || str_byte_at(src, i) == 69) {
                        i = i + 1;
                        if i < len && (str_byte_at(src, i) == 43 || str_byte_at(src, i) == 45) {
                            i = i + 1;
                        } while i < len {
                            var ch: i64 = str_byte_at(src, i);
                            if char_is_digit(ch) || ch == 95 {
                                i = i + 1;
                            } else {
                                break;
                            }
                        }
                    }
                }
            } else {
                while i < len {
                    var ch: i64 = str_byte_at(src, i);
                    if char_is_digit(ch) || ch == 95 {
                        i = i + 1;
                    } else {
                        break;
                    }
                }
                // fractional part
                if i < len && str_byte_at(src, i) == 46 && i + 1 < len && char_is_digit(str_byte_at(src, i + 1)) {
                    i = i + 1;
                    while i < len {
                        var ch: i64 = str_byte_at(src, i);
                        if char_is_digit(ch) || ch == 95 {
                            i = i + 1;
                        } else {
                            break;
                        }
                    }
                }
                // Scientific notation: e/E followed by optional +/- and digits
                if i < len && (str_byte_at(src, i) == 101 || str_byte_at(src, i) == 69) {
                    i = i + 1;
                    if i < len && (str_byte_at(src, i) == 43 || str_byte_at(src, i) == 45) {
                        i = i + 1;
                    } while i < len {
                        var ch: i64 = str_byte_at(src, i);
                        if char_is_digit(ch) || ch == 95 {
                            i = i + 1;
                        } else {
                            break;
                        }
                    }
                }
            }
            var text: str = str_slice(src, start, i);
            tokens.push(FTok::Number(text));
            continue;
        }

        // Identifier / keyword
        if is_alpha_or_underscore(c) {
            var start: i64 = i;
            while i < len {
                var ch: i64 = str_byte_at(src, i);
                if is_alnum_or_underscore(ch) {
                    i = i + 1;
                } else {
                    break;
                }
            }
            var text: str = str_slice(src, start, i);
            tokens.push(FTok::Word(text));
            continue;
        }

        // Multi-char punctuation (greedy, longest first)
        var plen: i64 = try_multi_punct(src, i, len);
        if plen > 0 {
            var text: str = str_slice(src, i, i + plen);
            tokens.push(FTok::Punct(text));
            i = i + plen;
            continue;
        }

        // Single-char punctuation
        if is_single_punct(c) {
            tokens.push(FTok::Punct(char_to_str(c)));
            i = i + 1;
            continue;
        }

        // Unknown character -- keep it as a single-char word
        tokens.push(FTok::Word(char_to_str(c)));
        i = i + 1;
    }

    tokens.push(FTok::Eof);
    return tokens;
}

// --- Token text -------------------------------------------------------

/// Render a formatter token to its source text.
pub fn ftok_text(t: FTok) -> str {
    match t {
        FTok::Word(s) => {
            return str_concat(s, "");
        }
        FTok::Number(s) => {
            return str_concat(s, "");
        }
        FTok::Str(s) => {
            return str_concat(s, "");
        }
        FTok::FStr(s) => {
            return str_concat(s, "");
        }
        FTok::LineComment(s) => {
            return str_concat(s, "");
        }
        FTok::BlockComment(s) => {
            return str_concat(s, "");
        }
        FTok::Punct(s) => {
            return str_concat(s, "");
        }
        FTok::BlankLines(_) => {
            return "";
        }
        FTok::Eof => {
            return "";
        }
    }
}

// --- Operator classification ------------------------------------------

/// Binary operators that get spaces around them.
fn is_binop(p: str) -> bool {
    if p == "+" {
        return true;
    }
    if p == "-" {
        return true;
    }
    if p == "*" {
        return true;
    }
    if p == "/" {
        return true;
    }
    if p == "%" {
        return true;
    }
    if p == "==" {
        return true;
    }
    if p == "!=" {
        return true;
    }
    if p == "<=" {
        return true;
    }
    if p == ">=" {
        return true;
    }
    if p == "<" {
        return true;
    }
    if p == ">" {
        return true;
    }
    if p == "&&" {
        return true;
    }
    if p == "||" {
        return true;
    }
    if p == "<<" {
        return true;
    }
    if p == ">>" {
        return true;
    }
    if p == "&" {
        return true;
    }
    if p == "|" {
        return true;
    }
    if p == "^" {
        return true;
    }
    return false;
}

/// Assignment operators that get spaces around them.
fn is_assignop(p: str) -> bool {
    if p == "=" {
        return true;
    }
    if p == "+=" {
        return true;
    }
    if p == "-=" {
        return true;
    }
    if p == "*=" {
        return true;
    }
    if p == "/=" {
        return true;
    }
    if p == "%=" {
        return true;
    }
    if p == "&=" {
        return true;
    }
    if p == "|=" {
        return true;
    }
    if p == "^=" {
        return true;
    }
    if p == "<<=" {
        return true;
    }
    if p == ">>=" {
        return true;
    }
    return false;
}

/// `->` and `=>` and `~>` get spaces around them.
fn is_arrow(p: str) -> bool {
    if p == "->" {
        return true;
    }
    if p == "=>" {
        return true;
    }
    if p == "~>" {
        return true;
    }
    return false;
}

/// Keywords that begin a top-level definition (for blank-line spacing).
fn is_def_kw(w: str) -> bool {
    if w == "fn" {
        return true;
    }
    if w == "val" {
        return true;
    }
    if w == "var" {
        return true;
    }
    if w == "const" {
        return true;
    }
    if w == "struct" {
        return true;
    }
    if w == "enum" {
        return true;
    }
    if w == "impl" {
        return true;
    }
    if w == "cap" {
        return true;
    }
    if w == "type" {
        return true;
    }
    if w == "use" {
        return true;
    }
    if w == "module" {
        return true;
    }
    if w == "extern" {
        return true;
    }
    if w == "component" {
        return true;
    }
    if w == "system" {
        return true;
    }
    if w == "state_machine" {
        return true;
    }
    if w == "on" {
        return true;
    }
    if w == "layer" {
        return true;
    }
    if w == "model" {
        return true;
    }
    return false;
}

/// Keywords that are followed by a condition/expression then `{`.
fn is_cond_kw(w: str) -> bool {
    if w == "if" {
        return true;
    }
    if w == "while" {
        return true;
    }
    if w == "for" {
        return true;
    }
    if w == "match" {
        return true;
    }
    if w == "query" {
        return true;
    }
    if w == "guard" {
        return true;
    }
    return false;
}

/// Is this word a type keyword?
fn is_type_word(w: str) -> bool {
    if w == "i8" {
        return true;
    }
    if w == "i16" {
        return true;
    }
    if w == "i32" {
        return true;
    }
    if w == "i64" {
        return true;
    }
    if w == "i128" {
        return true;
    }
    if w == "u8" {
        return true;
    }
    if w == "u16" {
        return true;
    }
    if w == "u32" {
        return true;
    }
    if w == "u64" {
        return true;
    }
    if w == "u128" {
        return true;
    }
    if w == "f32" {
        return true;
    }
    if w == "f64" {
        return true;
    }
    if w == "bool" {
        return true;
    }
    if w == "str" {
        return true;
    }
    if w == "void" {
        return true;
    }
    return false;
}

fn is_cond_or_match_kw(s: str) -> bool {
    if s == "if" {
        return true;
    }
    if s == "while" {
        return true;
    }
    if s == "for" {
        return true;
    }
    if s == "match" {
        return true;
    }
    if s == "query" {
        return true;
    }
    if s == "guard" {
        return true;
    }
    if s == "return" {
        return true;
    }
    return false;
}

// --- Token helpers ----------------------------------------------------

/// Check if a token is "significant" (not a comment, not EOF, not BlankLines).
fn is_significant(t: FTok) -> bool {
    match t {
        FTok::LineComment(_) => {
            return false;
        }
        FTok::BlockComment(_) => {
            return false;
        }
        FTok::BlankLines(_) => {
            return false;
        }
        FTok::Eof => {
            return false;
        }
        _ => {
            return true;
        }
    }
}

/// Check if a string looks like a word (starts with alpha or _).
fn is_word_text(s: str) -> bool {
    if str_len(s) == 0 {
        return false;
    }
    var b: i64 = str_byte_at(s, 0);
    return char_is_alpha(b) || b == 95;
}

/// Check if a string looks like a number (starts with digit).
fn is_number_text(s: str) -> bool {
    if str_len(s) == 0 {
        return false;
    }
    return char_is_digit(str_byte_at(s, 0));
}

/// Find the index of the significant token immediately before `idx`.
fn prev_significant_index(tokens: Vec<FTok>, idx: i64) -> i64 {
    if idx == 0 {
        return - 1;
    }
    var i: i64 = idx;
    while i > 0 {
        i = i - 1;
        if is_significant(tokens.get(i)) {
            return i;
        }
    }
    return - 1;
}

/// Get the significant token immediately before index `idx`.
fn prev_significant_at(tokens: Vec<FTok>, idx: i64) -> FTok {
    var pi: i64 = prev_significant_index(tokens, idx);
    if pi < 0 {
        return FTok::Eof;
    }
    return tokens.get(pi);
}

/// Get the significant token immediately after index `idx`.
fn next_significant(tokens: Vec<FTok>, idx: i64) -> FTok {
    var i: i64 = idx;
    var n: i64 = tokens.len();
    while i < n {
        if is_significant(tokens.get(i)) {
            return tokens.get(i);
        }
        i = i + 1;
    }
    return FTok::Eof;
}

/// Check if the next significant token after `idx` is the given punct.
fn next_significant_is(tokens: Vec<FTok>, idx: i64, punct: str) -> bool {
    var nxt: FTok = next_significant(tokens, idx);
    match nxt {
        FTok::Punct(p) => {
            return p == punct;
        }
        _ => {
            return false;
        }
    }
}

/// Get the significant token before the previous one (two steps back).
fn prev_significant_before(tokens: Vec<FTok>, idx: i64) -> FTok {
    var found_first: bool = false;
    var i: i64 = idx;
    while i > 0 {
        i = i - 1;
        if is_significant(tokens.get(i)) {
            if found_first {
                return tokens.get(i);
            }
            found_first = true;
        }
    }
    return FTok::Eof;
}

/// Determine if a `{` at position `idx` opens a definition body (struct/enum/
/// impl/cap/etc.) where `,` should produce newlines between fields.
fn is_def_body_brace_at(tokens: Vec<FTok>, idx: i64) -> bool {
    var prev1: FTok = prev_significant_at(tokens, idx);
    // N4: a generic definition (`struct Matrix<T, const N: usize> {`,
    // `enum Tree<T> {`): what stands before its `<` decides
    val gt: str = fmt_punct(prev1);
    if gt == ">" || gt == ">>" {
        val lt: i64 = fmt_generic_open_before(tokens, prev_significant_index(tokens, idx));
        if lt < 0 {
            return false;
        }
        return is_def_body_brace_at(tokens, lt);
    }
    match prev1 {
        FTok::Word(w) => {
            if w == "struct" {
                return true;
            }
            if w == "enum" {
                return true;
            }
            if w == "extern" {
                return true;
            }
            // Check the token before the word
            var prev1_idx: i64 = prev_significant_index(tokens, idx);
            if prev1_idx >= 0 {
                var prev2: FTok = prev_significant_at(tokens, prev1_idx);
                match prev2 {
                    FTok::Word(w2) => {
                        if w2 == "struct" {
                            return true;
                        }
                        if w2 == "enum" {
                            return true;
                        }
                        if w2 == "impl" {
                            return true;
                        }
                        if w2 == "cap" {
                            return true;
                        }
                        if w2 == "component" {
                            return true;
                        }
                        if w2 == "state_machine" {
                            return true;
                        }
                        if w2 == "state" {
                            return true;
                        }
                        if w2 == "extern" {
                            return true;
                        }
                        return false;
                    }
                    _ => {
                        return false;
                    }
                }
            }
            return false;
        }
        _ => {
            return false;
        }
    }
}

/// The index of the `<` that the `>` (or `>>`) at `gt` closes, walking
/// back over what a type list holds; -1 when a `;`, `{`, `}` or `=` comes
/// first (a comparison, not a generic).
fn fmt_generic_open_before(tokens: Vec<FTok>, gt: i64) -> i64 {
    var depth: i64 = 0;
    var i: i64 = gt;
    var seen: i64 = 0;
    while i >= 0 && seen < 256 {
        val p: str = fmt_punct(tokens.get(i));
        if p == ">" {
            depth = depth + 1;
        } else if p == ">>" {
            depth = depth + 2;
        } else if p == "<" {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
            if depth < 0 {
                return 0 - 1;
            }
        } else if p == ";" || p == "{" || p == "}" || p == "=" {
            return 0 - 1;
        }
        i = i - 1;
        seen = seen + 1;
    }
    return 0 - 1;
}

/// Whether the `<` at `idx` is closed by a matching `>` (or `>>`, which
/// closes two) with only what a type can hold in between: names, numbers,
/// `,` `:` `::` `&` `*` `->`, brackets and parentheses (a `;` only inside
/// `[T; N]`), and is then not followed by a name or a literal. `a < b`,
/// `a < b && c > d` and `f(a < b)` are comparisons; `Vec<Vec<i64>>` is a
/// generic.
fn generic_closes(tokens: Vec<FTok>, idx: i64) -> bool {
    var depth: i64 = 1;
    var brackets: i64 = 0;
    var parens: i64 = 0;
    var i: i64 = idx + 1;
    var n: i64 = tokens.len();
    var seen: i64 = 0;
    while i < n && seen < 128 {
        var t: FTok = tokens.get(i);
        if is_significant(t) {
            seen = seen + 1;
            match t {
                FTok::Word(_) => {
                }
                FTok::Number(_) => {
                }
                FTok::Punct(p) => {
                    var closed: bool = false;
                    if p == "<" {
                        depth = depth + 1;
                    } else if p == ">" {
                        depth = depth - 1;
                        closed = depth == 0;
                    } else if p == ">>" {
                        depth = depth - 2;
                        if depth < 0 {
                            return false;
                        }
                        closed = depth == 0;
                    } else if p == "[" {
                        brackets = brackets + 1;
                    } else if p == "]" {
                        if brackets == 0 {
                            return false;
                        }
                        brackets = brackets - 1;
                    } else if p == "(" {
                        parens = parens + 1;
                    } else if p == ")" {
                        if parens == 0 {
                            return false;
                        }
                        parens = parens - 1;
                    } else if p == ";" {
                        if brackets == 0 {
                            return false;
                        }
                    } else if p == "," || p == ":" || p == "::" || p == "&" || p == "*" || p == "->" {
                    } else {
                        return false;
                    }
                    if closed {
                        match next_significant(tokens, i + 1) {
                            FTok::Word(_) => {
                                return false;
                            }
                            FTok::Number(_) => {
                                return false;
                            }
                            FTok::Str(_) => {
                                return false;
                            }
                            FTok::FStr(_) => {
                                return false;
                            }
                            _ => {
                                return true;
                            }
                        }
                    }
                }
                _ => {
                    return false;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

/// Check if `<` at position `idx` is a generic bracket (type parameters) vs
/// a comparison operator.
fn is_generic_open(tokens: Vec<FTok>, idx: i64) -> bool {
    var prev: FTok = prev_significant_at(tokens, idx);
    var nxt: FTok = next_significant(tokens, idx + 1);
    match prev {
        FTok::Word(p) => {
            if is_cond_or_match_kw(p) {
                return false;
            }
            if is_type_word(p) {
                return false;
            }
            match nxt {
                FTok::Word(_) => {
                    return generic_closes(tokens, idx);
                }
                FTok::Punct(gp) => {
                    if gp == ">" {
                        return true;
                    }
                    if gp == "(" || gp == "[" || gp == "&" || gp == "*" {
                        return generic_closes(tokens, idx);
                    }
                    return false;
                }
                _ => {
                    return false;
                }
            }
        }
        _ => {
            return false;
        }
    }
}

// --- Spacing decision -------------------------------------------------

/// Keywords after which an operator can only be a prefix one
/// (`return -1`, `in &v`, `if !x`, `match *p`).
fn fmt_prefix_kw(w: str) -> bool {
    return w == "return" || w == "in" || w == "if" || w == "while" || w == "match" || w == "else" || w == "yield" || w == "break" || w == "assert";
}

/// Whether `prev`, the significant token right before `idx`, is a prefix
/// (unary) `&`, `*`, `-`, `~` or `!`: it starts an operand, so the token
/// before it is not something that ends one. Before it: nothing, an opening
/// bracket, a separator, an operator, `:`/`->` (a type: `x: &Vec<i64>`),
/// or a keyword like `return`. After a name, a literal, `)`, `]`, `}` or a
/// postfix `?` it is binary (`a & b`, `n - 1`, `f(x) * 2`).
fn fmt_prev_is_prefix_op(prev: str, tokens: Vec<FTok>, idx: i64) -> bool {
    if prev != "&" && prev != "*" && prev != "-" && prev != "~" && prev != "!" {
        return false;
    }
    var before: FTok = prev_significant_before(tokens, idx);
    match before {
        FTok::Eof => {
            return true;
        }
        FTok::Punct(p) => {
            if p == ")" || p == "]" || p == "}" || p == "?" {
                return false;
            }
            return true;
        }
        FTok::Word(w) => {
            return fmt_prefix_kw(w);
        }
        _ => {
        }
    }
    return false;
}

/// The text of a punctuation token; "" for any other token.
fn fmt_punct(t: FTok) -> str {
    match t {
        FTok::Punct(p) => {
            return p;
        }
        _ => {
        }
    }
    return "";
}

/// Whether `t` starts an item an annotation can stand before: `fn`, `pub`,
/// `struct`, ... or the `@` of a further annotation.
fn fmt_item_start(t: FTok) -> bool {
    match t {
        FTok::Word(w) => {
            return w == "fn" || w == "pub" || w == "struct" || w == "enum" || w == "impl" || w == "extern" || w == "trait" || w == "unsafe" || w == "async" || w == "type" || w == "static" || w == "const";
        }
        FTok::Punct(p) => {
            return p == "@";
        }
        _ => {
        }
    }
    return false;
}

/// Whether the significant token before `idx` ends an annotation: the name
/// of `@name`, or the `)` of `@name(...)`.
fn fmt_ends_annotation(tokens: Vec<FTok>, idx: i64) -> bool {
    var j: i64 = prev_significant_index(tokens, idx);
    if j < 0 {
        return false;
    }
    if fmt_punct(tokens.get(j)) == ")" {
        // back to the matching `(`
        var depth: i64 = 0;
        var open: i64 = -1;
        while j >= 0 && open < 0 {
            val p: str = fmt_punct(tokens.get(j));
            if p == ")" {
                depth = depth + 1;
            } else if p == "(" {
                depth = depth - 1;
                if depth == 0 {
                    open = j;
                }
            }
            j = j - 1;
        }
        if open < 0 {
            return false;
        }
        j = prev_significant_index(tokens, open);
        if j < 0 {
            return false;
        }
    }
    var is_name: bool = false;
    match tokens.get(j) {
        FTok::Word(_) => {
            is_name = true;
        }
        _ => {
        }
    }
    if !is_name {
        return false;
    }
    val k: i64 = prev_significant_index(tokens, j);
    if k < 0 {
        return false;
    }
    return fmt_punct(tokens.get(k)) == "@";
}

/// Decide whether a space is needed between `prev` and `cur`.
fn need_space(prev: str, cur: FTok, tokens: Vec<FTok>, idx: i64) -> bool {
    if str_len(prev) == 0 {
        return false;
        // beginning of file/line -- no leading space
    }

    var cur_text: str = ftok_text(cur);

    // No space right after an opening bracket/paren
    if prev == "(" {
        return false;
    }
    if prev == "[" {
        return false;
    }
    if prev == "{" {
        return false;
    }

    // No space right before a closing bracket/paren/brace or comma/semicolon
    if cur_text == ")" {
        return false;
    }
    if cur_text == "]" {
        return false;
    }
    if cur_text == "}" {
        return false;
    }
    if cur_text == "," {
        return false;
    }
    if cur_text == ";" {
        return false;
    }

    // No space before . :: ?. .. ..=
    if cur_text == "." {
        return false;
    }
    if cur_text == "::" {
        return false;
    }
    if cur_text == "?." {
        return false;
    }
    // postfix `?` (error propagation) sticks to its operand: `f(x)?`
    if cur_text == "?" {
        return false;
    }
    if cur_text == ".." {
        return false;
    }
    if cur_text == "..=" {
        return false;
    }

    // No space after . :: ?. @ # .. ..=
    if prev == "." {
        return false;
    }
    if prev == "::" {
        return false;
    }
    if prev == "?." {
        return false;
    }
    if prev == "@" {
        return false;
    }
    if prev == "#" {
        return false;
    }
    if prev == ".." {
        return false;
    }
    if prev == "..=" {
        return false;
    }

    // No space between a word and ( (function call) or [ (index)
    if is_word_text(prev) {
        if cur_text == "(" {
            if is_cond_or_match_kw(prev) {
                return true;
            }
            return false;
        }
        if cur_text == "[" {
            return false;
        }
    }

    // No space between ) and ( (chained call)
    if prev == ")" && cur_text == "(" {
        return false;
    }

    // : -- space after, but not before
    if prev == ":" {
        return true;
    }
    if cur_text == ":" {
        return false;
    }

    // -> => ~> -- spaces around
    if is_arrow(prev) {
        return true;
    }
    if is_arrow(cur_text) {
        return true;
    }

    // A prefix operator (`&v`, `&mut v`, `*p`, `-1`, `-x`) sticks to what
    // follows it. Checked before the binary-operator rule, which used to
    // win and wrote `& v`, `& mut v`, `- 1` (2g.62).
    if fmt_prev_is_prefix_op(prev, tokens, idx) {
        return false;
    }

    // Binary operators -- spaces around
    if is_binop(cur_text) {
        return true;
    }
    if is_binop(prev) {
        return true;
    }

    // Assignment operators -- spaces around
    if is_assignop(cur_text) {
        return true;
    }
    if is_assignop(prev) {
        return true;
    }

    // @ annotation prefix -- space before
    if cur_text == "@" {
        return true;
    }

    // Comma -- space after
    if prev == "," {
        return true;
    }
    if cur_text == "," {
        return false;
    }

    // ; -- space after
    if prev == ";" {
        return true;
    }

    // ! as prefix unary -- no space after
    if prev == "!" && is_word_text(cur_text) {
        return false;
    }

    // ~ as prefix unary -- no space after
    if prev == "~" && is_word_text(cur_text) {
        return false;
    }

    // & as prefix (reference) -- no space after when followed by word
    if prev == "&" {
        if is_word_text(cur_text) {
            // Single &x -- no space (prefix reference, not binary AND)
            return false;
        }
        if cur_text == "&" {
            return false;
            // && is handled by binop above
        }
    }

    // * as prefix (deref) -- no space after when followed by word
    if prev == "*" && is_word_text(cur_text) {
        return false;
    }

    // - as prefix unary (negative number) -- no space after when followed by number
    if prev == "-" && is_number_text(cur_text) {
        var before: FTok = prev_significant_before(tokens, idx);
        var bt: str = ftok_text(before);
        if bt == "(" {
            return false;
        }
        if bt == "," {
            return false;
        }
        if bt == "=" {
            return false;
        }
        if bt == "==" {
            return false;
        }
        if bt == "!=" {
            return false;
        }
        if bt == "<" {
            return false;
        }
        if bt == ">" {
            return false;
        }
        if bt == "<=" {
            return false;
        }
        if bt == ">=" {
            return false;
        }
        if bt == "+" {
            return false;
        }
        if bt == "-" {
            return false;
        }
        if bt == "*" {
            return false;
        }
        if bt == "/" {
            return false;
        }
        if bt == "%" {
            return false;
        }
        if bt == "&&" {
            return false;
        }
        if bt == "||" {
            return false;
        }
        if bt == "!" {
            return false;
        }
        if bt == "=>" {
            return false;
        }
        if bt == "->" {
            return false;
        }
        if bt == "[" {
            return false;
        }
        if bt == "{" {
            return false;
        }
        if bt == ":" {
            return false;
        }
        if bt == ";" {
            return false;
        }
        if bt == "return" {
            return false;
        }
        match before {
            FTok::Eof => {
                return false;
            }
            _ => {
            }
        }
    }

    // Two words -- space between
    if is_word_text(prev) && is_word_text(cur_text) {
        return true;
    }

    // Word followed by { -- space
    if is_word_text(prev) && cur_text == "{" {
        return true;
    }

    // Number/string followed by { -- space
    if is_number_text(prev) && cur_text == "{" {
        return true;
    }
    if str_starts_with(prev, "\"") && cur_text == "{" {
        return true;
    }
    if str_starts_with(prev, "f") && cur_text == "{" {
        return true;
    }

    // ) followed by { -- space
    if prev == ")" && cur_text == "{" {
        return true;
    }

    // ] followed by { -- space
    if prev == "]" && cur_text == "{" {
        return true;
    }

    // Word followed by # -- space
    if is_word_text(prev) && cur_text == "#" {
        return true;
    }

    // } followed by a word -- space
    if prev == "}" && is_word_text(cur_text) {
        return true;
    }

    // Default: if both are punctuation, no space
    if !is_word_text(prev) && !is_word_text(cur_text) {
        return false;
    }

    // Word after punctuation -- space
    if !is_word_text(prev) && is_word_text(cur_text) {
        return true;
    }

    // Punctuation after word -- space (default)
    if is_word_text(prev) && !is_word_text(cur_text) {
        return true;
    }

    return true;
}

// --- Comments: own line or trailing (N4) -------------------------------

/// Whether the line comment at `idx` stood on a line of its own in the
/// source: the tokenizer puts a BlankLines marker (count 0 when there is no
/// blank line) before such a comment.
fn fmt_comment_own_line(tokens: Vec<FTok>, idx: i64) -> bool {
    if idx <= 0 {
        return true;
    }
    match tokens.get(idx - 1) {
        FTok::BlankLines(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// A comment that never ends a line of code: a doc comment (`///`, `//!`)
/// documents what follows it, and a section rule (`// ---`, `// ===`,
/// `// ───`) heads what follows it. A formatter that did not end top-level
/// lines at `;` joined such comments onto the line before; printed on a
/// line of their own again, they go back where they were written.
fn fmt_detached_comment(text: str) -> bool {
    if str_starts_with(text, "///") || str_starts_with(text, "//!") {
        return true;
    }
    var rest: str = str_trim(str_slice(text, 2, str_len(text)));
    if str_starts_with(rest, "---") || str_starts_with(rest, "===") {
        return true;
    }
    // box drawing (U+2500..U+257F: E2 94 xx, E2 95 xx)
    if str_len(rest) >= 3 && str_byte_at(rest, 0) == 226 && (str_byte_at(rest, 1) == 148 || str_byte_at(rest, 1) == 149) {
        return true;
    }
    return false;
}

/// Whether the token right after `idx` is a line comment written on the
/// same line as it (a trailing comment that is not detached): the comment
/// then ends the line, instead of a newline printed before it that would
/// move it under the code it explains (`var n = 0;  // the count`).
fn fmt_trailing_comment_next(tokens: Vec<FTok>, idx: i64) -> bool {
    if idx + 1 >= tokens.len() {
        return false;
    }
    match tokens.get(idx + 1) {
        FTok::LineComment(t) => {
            return !fmt_detached_comment(t);
        }
        _ => {
        }
    }
    return false;
}

// --- Printer ----------------------------------------------------------

/// Format Fides source code. Returns the formatted string.
pub fn format_source(src: str) -> str {
    var tokens: Vec<FTok> = fmt_tokenize(src);
    var sb: StringBuilder = StringBuilder::new();
    var indent: i64 = 0;
    var at_line_start: bool = true;
    var pending_blanks: i64 = 0;
    var prev_sig: str = "";
    var prev_closed_generic: bool = false;
    // the token before closed a generic
    var just_closed_top_level: bool = false;
    var brace_depth: i64 = 0;
    var paren_depth: i64 = 0;
    var brace_is_def_body: Vec<bool> = Vec::new();
    // N4: paren_depth when each open `{` was opened; a line that starts
    // inside more parentheses than that (after a comment of its own line
    // in an argument list) is indented one more level
    var brace_paren: Vec<i64> = Vec::new();
    var cont_line: bool = false;
    var generic_depth: i64 = 0;

    var idx: i64 = 0;
    var n: i64 = tokens.len();

    while idx < n {
        var tok: FTok = tokens.get(idx);

        match tok {
            FTok::Eof => {
                break;
            }
            FTok::BlankLines(count) => {
                if count > pending_blanks {
                    pending_blanks = count;
                }
                if pending_blanks > 1 {
                    pending_blanks = 1;
                }
                idx = idx + 1;
                continue;
            }
            FTok::LineComment(text) => {
                // N4: a comment of its own line (or a detached one: a doc
                // comment or a section rule) starts a line; a trailing one
                // stays after the code it follows. A trailing comment after
                // `}` leaves the blank line before the next item to come.
                var own_line: bool = fmt_comment_own_line(tokens, idx) || fmt_detached_comment(text);
                if own_line {
                    just_closed_top_level = false;
                }
                // Flush blanks; an open line is ended first, so that the
                // blank line itself survives
                if pending_blanks > 0 {
                    if !at_line_start {
                        sb.append_str("\n");
                    }
                    var b: i64 = 0;
                    while b < pending_blanks {
                        // Trim trailing whitespace
                        sb.append_str("\n");
                        b = b + 1;
                    }
                    pending_blanks = 0;
                    at_line_start = true;
                }
                if own_line && !at_line_start {
                    sb.append_str("\n");
                    at_line_start = true;
                }
                if at_line_start {
                    // Indent (one level more inside an argument list)
                    var open_base: i64 = 0;
                    if brace_paren.len() > 0 {
                        open_base = brace_paren.get(brace_paren.len() - 1);
                    }
                    cont_line = paren_depth > open_base;
                    var cols: i64 = indent * 4;
                    if cont_line {
                        cols = cols + 4;
                    }
                    var k: i64 = 0;
                    while k < cols {
                        sb.append_str(" ");
                        k = k + 1;
                    }
                } else {
                    // Trailing comment -- two spaces before it
                    sb.append_str("  ");
                    var open_base2: i64 = 0;
                    if brace_paren.len() > 0 {
                        open_base2 = brace_paren.get(brace_paren.len() - 1);
                    }
                    cont_line = paren_depth > open_base2;
                }
                sb.append_str(text);
                // Newline
                sb.append_str("\n");
                at_line_start = true;
                idx = idx + 1;
                continue;
            }
            FTok::BlockComment(text) => {
                // Flush blanks
                if pending_blanks > 0 {
                    var b: i64 = 0;
                    while b < pending_blanks {
                        sb.append_str("\n");
                        b = b + 1;
                    }
                    pending_blanks = 0;
                    at_line_start = true;
                }
                if at_line_start {
                    var k: i64 = 0;
                    while k < indent * 4 {
                        sb.append_str(" ");
                        k = k + 1;
                    }
                }
                sb.append_str(text);
                at_line_start = false;
                idx = idx + 1;
                continue;
            }
            _ => {
            }
            // Significant tokens -- handled below
        }

        // -- Significant tokens --
        var text: str = ftok_text(tok);

        // For closing braces, de-indent before writing
        var is_close_brace: bool = false;
        match tok {
            FTok::Punct(p) => {
                if p == "}" {
                    is_close_brace = true;
                }
            }
            _ => {
            }
        }

        if is_close_brace {
            if brace_depth > 0 {
                brace_depth = brace_depth - 1;
            }
            if brace_depth < 0 {
                indent = 0;
            } else {
                indent = brace_depth;
            }
            // Pop def-body stack
            if brace_is_def_body.len() > 0 {
                brace_is_def_body.pop();
            }
            if brace_paren.len() > 0 {
                brace_paren.pop();
            }
            // Ensure } is on its own line
            if !at_line_start {
                sb.append_str("\n");
                at_line_start = true;
            }
        }

        // Track generic brackets
        var cur_is_generic_open: bool = false;
        match tok {
            FTok::Punct(p) => {
                if p == "<" {
                    if is_generic_open(tokens, idx) {
                        cur_is_generic_open = true;
                    }
                }
            }
            _ => {
            }
        }

        var cur_is_generic_close: bool = false;
        var close_count: i64 = 1;
        match tok {
            FTok::Punct(p) => {
                if p == ">" {
                    if generic_depth > 0 {
                        cur_is_generic_close = true;
                    }
                }
                // `>>` closes two generics (`Vec<Vec<i64>>`); outside a
                // generic it is a shift
                if p == ">>" {
                    if generic_depth > 0 {
                        cur_is_generic_close = true;
                        close_count = 2;
                    }
                }
                // A generic never spans a statement or a block: whatever
                // opened one by mistake ends here
                if p == ";" || p == "{" || p == "}" || p == "=" {
                    generic_depth = 0;
                }
            }
            _ => {
            }
        }

        if cur_is_generic_open {
            generic_depth = generic_depth + 1;
        }

        // Decide whether we need a space before this token
        var need_space_before: bool = false;
        if !at_line_start {
            need_space_before = need_space(prev_sig, tok, tokens, idx);
        }

        // Inside generic brackets, only space after : and ,
        if generic_depth > 0 {
            need_space_before = false;
            if prev_sig == ":" {
                need_space_before = true;
            }
            if prev_sig == "," {
                need_space_before = true;
            }
            // two words stay two words: `<T, const N: usize>`, `<&mut T>`,
            // `<dyn Shape>` (they were joined into `constN`, a token change)
            if is_word_text(prev_sig) && is_word_text(text) {
                need_space_before = true;
            }
        }
        if cur_is_generic_open {
            need_space_before = false;
        }
        if cur_is_generic_close {
            need_space_before = false;
            generic_depth = generic_depth - close_count;
            if generic_depth < 0 {
                generic_depth = 0;
            }
        }
        // After generic close >, no space before ( (function params)
        if prev_closed_generic {
            match tok {
                FTok::Punct(p) => {
                    if p == "(" {
                        need_space_before = false;
                    }
                }
                _ => {
                }
            }
        }

        // Blank line handling: if this is a top-level def keyword
        var is_def: bool = false;
        match tok {
            FTok::Word(w) => {
                if is_def_kw(w) {
                    is_def = true;
                }
            }
            _ => {
            }
        }

        if brace_depth == 0 && is_def {
            if sb.len() > 0 && pending_blanks == 0 {
                if just_closed_top_level && at_line_start {
                    pending_blanks = 1;
                }
            }
            just_closed_top_level = false;
        }

        // An item after its annotation starts a new line (`@pure` / `fn f`),
        // as written in the tree: the annotation is not joined to the item.
        if !at_line_start && paren_depth == 0 && fmt_item_start(tok) && fmt_ends_annotation(tokens, idx) {
            sb.append_str("\n");
            at_line_start = true;
            need_space_before = false;
        }

        // Flush blanks. When the current line is still open (after `@pure`,
        // a block comment, mid-expression), the space decided above belonged
        // to that line: at the top level the line is ended first so the blank
        // line survives, and the token starts the next line with no space
        // (it used to print `@pure\n fn`, 2g.62); inside a body the blank
        // lines are dropped and the token stays on the line.
        if pending_blanks > 0 && !at_line_start {
            if brace_depth == 0 && paren_depth == 0 {
                sb.append_str("\n");
                need_space_before = false;
            } else {
                pending_blanks = 0;
            }
        }
        if pending_blanks > 0 {
            var b: i64 = 0;
            while b < pending_blanks {
                sb.append_str("\n");
                b = b + 1;
            }
            pending_blanks = 0;
            at_line_start = true;
            need_space_before = false;
        }

        // Write indentation at line start (one level more for an argument
        // that follows a comment in its argument list)
        if at_line_start {
            var cols: i64 = indent * 4;
            if cont_line {
                cols = cols + 4;
            }
            var k: i64 = 0;
            while k < cols {
                sb.append_str(" ");
                k = k + 1;
            }
            at_line_start = false;
        }
        cont_line = false;

        // Write space before if needed
        if need_space_before {
            sb.append_str(" ");
        }

        // Write the token text
        sb.append_str(text);

        // Update prev_sig
        prev_sig = text;
        prev_closed_generic = cur_is_generic_close;

        // Update brace tracking and newline decisions
        match tok {
            FTok::Punct(p) => {
                if p == "{" {
                    brace_depth = brace_depth + 1;
                    var is_def_body: bool = is_def_body_brace_at(tokens, idx);
                    brace_is_def_body.push(is_def_body);
                    brace_paren.push(paren_depth);
                    // Opening brace: newline after (unless next is }; a
                    // trailing comment ends the line itself)
                    if !next_significant_is(tokens, idx + 1, "}") {
                        indent = brace_depth;
                        if !fmt_trailing_comment_next(tokens, idx) {
                            sb.append_str("\n");
                            at_line_start = true;
                        }
                    }
                } else if p == "}" {
                    // Closing brace -- check what follows
                    var nxt: FTok = next_significant(tokens, idx + 1);
                    var stay_on_line: bool = false;
                    match nxt {
                        FTok::Punct(np) => {
                            if np == "," {
                                stay_on_line = true;
                            }
                            if np == ";" {
                                stay_on_line = true;
                            }
                            if np == ")" {
                                stay_on_line = true;
                            }
                            if np == "]" {
                                stay_on_line = true;
                            }
                            if np == "=>" {
                                sb.append_str(" ");
                                stay_on_line = true;
                            }
                        }
                        FTok::Word(w) => {
                            if w == "else" {
                                stay_on_line = true;
                            }
                            // not `while`: Fid has no do-while, so a `while`
                            // after `}` is the next statement (it printed
                            // `} while j < n {`)
                            if w == "catch" {
                                stay_on_line = true;
                            }
                        }
                        _ => {
                        }
                    }
                    if !stay_on_line {
                        if brace_depth <= 0 {
                            just_closed_top_level = true;
                        }
                        if !fmt_trailing_comment_next(tokens, idx) {
                            sb.append_str("\n");
                            at_line_start = true;
                        }
                    } else {
                        at_line_start = false;
                    }
                } else if p == ";" {
                    // Semicolon: newline after (statement boundary, top level too),
                    // unless inside for-loop header parens.
                    if paren_depth == 0 && !fmt_trailing_comment_next(tokens, idx) {
                        sb.append_str("\n");
                        at_line_start = true;
                    }
                } else if p == "," {
                    // Comma: newline if inside def body (struct/enum fields) and
                    // not inside parens/brackets, else just space.
                    var in_def_body: bool = false;
                    if brace_is_def_body.len() > 0 {
                        in_def_body = brace_is_def_body.get(brace_is_def_body.len() - 1);
                    }
                    if in_def_body && brace_depth > 0 && paren_depth == 0 {
                        if !next_significant_is(tokens, idx + 1, "}") && !fmt_trailing_comment_next(tokens, idx) {
                            sb.append_str("\n");
                            at_line_start = true;
                        }
                    }
                } else if p == "(" {
                    paren_depth = paren_depth + 1;
                } else if p == ")" {
                    if paren_depth > 0 {
                        paren_depth = paren_depth - 1;
                    }
                } else if p == "[" {
                    paren_depth = paren_depth + 1;
                } else if p == "]" {
                    if paren_depth > 0 {
                        paren_depth = paren_depth - 1;
                    }
                }
            }
            _ => {
            }
        }

        idx = idx + 1;
    }

    // Ensure file ends with newline
    var result: str = sb.to_str();
    if str_len(result) > 0 {
        var last: i64 = str_byte_at(result, str_len(result) - 1);
        if last != 10 {
            result = str_concat(result, "\n");
        }
    }
    return result;
}

/// Check if source is already formatted. Returns true if formatting would
/// NOT change it.
/// Whether `a` and `b` hold the same tokens and comments in the same order
/// (only spacing and blank lines may differ): what formatting may change.
/// `fid fmt` writes nothing when this fails, so a formatter bug cannot
/// corrupt the file.
pub fn fmt_same_tokens(a: str, b: str) -> bool {
    var ta: Vec<FTok> = fmt_tokenize(a);
    var tb: Vec<FTok> = fmt_tokenize(b);
    var i: i64 = 0;
    var j: i64 = 0;
    while true {
        while i < ta.len() && fmt_ignorable(ta.get(i)) {
            i = i + 1;
        } while j < tb.len() && fmt_ignorable(tb.get(j)) {
            j = j + 1;
        }
        if i >= ta.len() || j >= tb.len() {
            return i >= ta.len() && j >= tb.len();
        }
        if str_trim(ftok_text(ta.get(i))) != str_trim(ftok_text(tb.get(j))) {
            return false;
        }
        i = i + 1;
        j = j + 1;
    }
    return true;
}

fn fmt_ignorable(t: FTok) -> bool {
    match t {
        FTok::BlankLines(_) => {
            return true;
        }
        FTok::Eof => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

pub fn is_formatted(src: str) -> bool {
    return format_source(src) == src;
}
