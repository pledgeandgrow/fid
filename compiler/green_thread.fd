// green_thread.fd -- Cooperative green threads (ported from src/green_thread.rs)
//
// Round-robin cooperative scheduler for green threads. This module is a
// single layer: thread records + scheduler bookkeeping. Execution is the
// caller's job — the interpreter drives it via p_gt_* builtins (spawn queues
// a READY thread by function name; run_all resolves and runs each thread).
//
// Porting notes:
// - No Option<T> — use i64 with -1 for "none"
// - No VecDeque — use Vec as a queue (push to end, remove from front)
// - No closures — run_all uses a simple loop
// - No static mut — global state via module-level vars

module compiler::green_thread;

use core;
use vec;
use string;

// ===========================================================================
// Constants
// ===========================================================================

pub const GREEN_THREAD_STACK_SIZE: i64 = 65536;  // 64 * 1024
pub const MAX_GREEN_THREADS: i64 = 256;

// Green thread states
pub const GT_READY: i64 = 0;
pub const GT_RUNNING: i64 = 1;
pub const GT_SUSPENDED: i64 = 2;
pub const GT_DONE: i64 = 3;

// ===========================================================================
// GreenThread
// ===========================================================================

pub struct GreenThread {
    pub id: i64,
    pub state: i64,         // GT_READY/GT_RUNNING/GT_SUSPENDED/GT_DONE
    pub saved_sp: i64,
    pub saved_ip: i64,
    pub func_name: str,     // resolved by the caller (interp: IrModule lookup)
    pub args: Vec<i64>,
    pub result: i64,
    pub active: bool,       // false = slot is empty (replaces Option<GreenThread>)
}

pub fn GreenThread_new(id: i64, func_name: str, args: Vec<i64>) -> GreenThread {
    return GreenThread {
        id: id,
        state: GT_READY,
        saved_sp: 0,
        saved_ip: 0,
        func_name: func_name,
        args: args,
        result: 0,
        active: true,
    };
}

pub fn GreenThread_empty() -> GreenThread {
    return GreenThread {
        id: -1,
        state: GT_DONE,
        saved_sp: 0,
        saved_ip: 0,
        func_name: "",
        args: Vec::new(),
        result: 0,
        active: false,
    };
}

// ===========================================================================
// GreenThreadScheduler
// ===========================================================================

pub struct GreenThreadScheduler {
    pub threads: Vec<GreenThread>,
    pub ready_queue: Vec<i64>,     // thread IDs waiting to run
    pub current: i64,              // -1 = none
    pub next_id: i64,
}

pub fn GreenThreadScheduler_new() -> GreenThreadScheduler {
    var threads: Vec<GreenThread> = Vec::new();
    var i: i64 = 0;
    while i < MAX_GREEN_THREADS {
        threads.push(GreenThread_empty());
        i = i + 1;
    }
    return GreenThreadScheduler {
        threads: threads,
        ready_queue: Vec::new(),
        current: -1,
        next_id: 0,
    };
}

pub fn GreenThreadScheduler_spawn(self: &mut GreenThreadScheduler, func_name: str, args: Vec<i64>) -> i64 {
    if self.next_id >= MAX_GREEN_THREADS { return -1; }
    var id: i64 = self.next_id;
    self.next_id = self.next_id + 1;
    self.threads.set(id, GreenThread_new(id, func_name, args));
    self.ready_queue.push(id);
    return id;
}

pub fn GreenThreadScheduler_current_thread(self: &GreenThreadScheduler) -> i64 {
    return self.current;
}

pub fn GreenThreadScheduler_yield_current(self: &mut GreenThreadScheduler) -> bool {
    if self.current < 0 { return false; }
    var current_id: i64 = self.current;
    // Mark current thread as suspended
    var t: GreenThread = self.threads.get(current_id);
    t.state = GT_SUSPENDED;
    self.threads.set(current_id, t);
    // Re-queue current thread
    self.ready_queue.push(current_id);
    self.current = -1;
    // Find next ready or suspended thread
    while self.ready_queue.len() > 0 {
        var next_id: i64 = self.ready_queue.get(0);
        // Remove from front of queue
        var qi: i64 = 0;
        while qi < self.ready_queue.len() - 1 {
            self.ready_queue.set(qi, self.ready_queue.get(qi + 1));
            qi = qi + 1;
        }
        self.ready_queue.pop();
        // Check if this thread is ready or suspended
        var nt: GreenThread = self.threads.get(next_id);
        if nt.active && (nt.state == GT_SUSPENDED || nt.state == GT_READY) {
            nt.state = GT_RUNNING;
            self.threads.set(next_id, nt);
            self.current = next_id;
            return true;
        }
    }
    return false;
}

pub fn GreenThreadScheduler_finish_current(self: &mut GreenThreadScheduler, result: i64) {
    if self.current >= 0 {
        var t: GreenThread = self.threads.get(self.current);
        t.state = GT_DONE;
        t.result = result;
        self.threads.set(self.current, t);
        self.current = -1;
    }
}

pub fn GreenThreadScheduler_is_done(self: &GreenThreadScheduler, id: i64) -> bool {
    if id < 0 || id >= MAX_GREEN_THREADS { return true; }
    var t: GreenThread = self.threads.get(id);
    if !t.active { return true; }
    return t.state == GT_DONE;
}

pub fn GreenThreadScheduler_get_result(self: &GreenThreadScheduler, id: i64) -> i64 {
    if id < 0 || id >= MAX_GREEN_THREADS { return 0; }
    var t: GreenThread = self.threads.get(id);
    if !t.active { return 0; }
    return t.result;
}

pub fn GreenThreadScheduler_has_ready_threads(self: &GreenThreadScheduler) -> bool {
    return self.ready_queue.len() > 0;
}

// Run all green threads until completion (simplified — no closures in Fides).
// In the interpreter, threads run eagerly. The C runtime handles real
// context switching via inline asm.
pub fn GreenThreadScheduler_run_all(self: &mut GreenThreadScheduler) -> i64 {
    var last_result: i64 = 0;
    var has_pending: bool = true;
    while has_pending {
        has_pending = false;
        var i: i64 = 0;
        while i < self.next_id {
            var t: GreenThread = self.threads.get(i);
            if t.active && (t.state == GT_READY || t.state == GT_SUSPENDED) {
                has_pending = true;
                // Mark as done (eager execution in interpreter)
                t.state = GT_DONE;
                t.result = 0;
                self.threads.set(i, t);
                last_result = 0;
            }
            i = i + 1;
        }
    }
    return last_result;
}

// ===========================================================================
// Global Scheduler (for interpreter)
// ===========================================================================
//
// NOTE: the p_gt_* builtins are implemented inside compiler::interp — it owns
// an Interpreter.gt_scheduler field and calls GreenThreadScheduler_* methods
// directly (spawn queues READY, run_all resolves func_name and executes).
// There is no separate global-state layer here: module-level mutable state
// would generate unqualified method calls in the C backend.
// ===========================================================================
