// pe_ir.fd -- IR -> PE32+ executable backend: instruction-lowering half.
// Ported from src/pe.rs: PeStackFrame, PeirGen::generate, gen_function,
// gen_inst, gen_int_binop, gen_float_binop and the public pe_ir_generate_pe
// entry point.  The PeirGen state, the machine-code runtime stub
// generators and the reachability analysis live in
// compiler::pe_ir_stubs; the x86-64 encoder, the .rdata builder and the
// PE file writer live in compiler::pe_ir_enc.
//
// Adaptations from Rust:
// 1. HashMap<u32, i64> / HashMap<(String,u32), u32> -> i64 handles
//    (HashMap_get returns 0 when absent; the Rust code's unwrap_or(&0)
//    makes that the correct default for both stack offsets and labels)
// 2. BTreeMap/BTreeSet -> sorted Vec<str> + linear contains
// 3. Option<ValueId> -> OptValueId, Option<IrType> -> OptIrType
// 4. or-patterns -> separate match arms (Fides doesn't support `|`)
// 5. ConstFloat stores the f64 value (not bits) -> p_f64_to_bits /
//    p_f32_to_bits, as in codegen_c
// 6. Rust `emit(&[b0, b1, ...])` -> one PeirEnc_emit_u8 per byte,
//    grouped through peir_emit2/peir_emit8

module compiler::pe_ir;

use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::pe_ir_enc;
use compiler::pe_ir_stubs;
use compiler::checks;

// ===========================================================================
// Stack frame (src/pe.rs PeStackFrame — mirrors x86.rs StackFrame)
// ===========================================================================

/// Key-value pair for the frame maps (Fides HashMap is string-keyed, so
/// integer-keyed maps use a linear-search entry list, as x86.fd does).
pub struct PeOffEnt {
    pub id: i64,
    pub offset: i64,
}

pub fn PeOffEnt_new(id: i64, offset: i64) -> PeOffEnt {
    return PeOffEnt { id: id, offset: offset };
}

/// Per-function stack layout: every IR value gets a slot at a negative
/// rbp offset, alloca data slots follow the value slots.
pub struct PeStackFrame {
    /// ValueId -> stack offset from rbp (entry list; 0 = absent).
    pub offsets: Vec<PeOffEnt>,
    /// Current frame size in bytes
    pub size: i64,
    /// Alloca ValueId -> data slot offset from rbp (entry list)
    pub alloca_slots: Vec<PeOffEnt>,
    /// ValueId -> known integer constant: use sites move the immediate
    /// straight into a register instead of loading the slot (item 81).
    pub const_vals: Vec<PeOffEnt>,
    /// Locals kept in a register: alloca id -> PEIR_REG_SLOT offset
    pub reg_vars: Vec<PeOffEnt>,
    /// Per value: 1 for a constant every use of which takes the immediate
    pub imm_only: Vec<i64>,
    /// Cold paths of inline Vec calls, emitted after the function: kind,
    /// entry label, return label, bytes first (four words each)
    pub cold: Vec<i64>,
}

pub fn PeStackFrame_new() -> PeStackFrame {
    return PeStackFrame {
        offsets: Vec::new(),
        size: 0,
        alloca_slots: Vec::new(),
        const_vals: Vec::new(),
        reg_vars: Vec::new(),
        imm_only: Vec::new(),
        cold: Vec::new(),
    };
}

/// `map[id] = value` (insert or overwrite, matching Rust's HashMap::insert).
fn pe_idmap_put(map: &mut Vec<PeOffEnt>, id: i64, value: i64) -> void {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).id == id {
            var e: PeOffEnt = map.get(i);
            e.offset = value;
            map.set(i, e);
            return;
        }
        i = i + 1;
    }
    map.push(PeOffEnt_new(id, value));
}

/// `map[id]`, or 0 when absent (as Rust's unwrap_or(&0)).
fn pe_idmap_get(map: &Vec<PeOffEnt>, id: i64) -> i64 {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).id == id { return map.get(i).offset; }
        i = i + 1;
    }
    return 0;
}

/// Whether `map` has an entry for `id`.
fn pe_idmap_has(map: &Vec<PeOffEnt>, id: i64) -> bool {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).id == id { return true; }
        i = i + 1;
    }
    return false;
}

/// Allocate space for a value and return its (negative) rbp offset.
pub fn PeStackFrame_alloc(self: &mut PeStackFrame, id: i64, size: i64) -> i64 {
    var align: i64 = 8;
    if size <= 1 { align = 1; }
    else if size <= 2 { align = 2; }
    else if size <= 4 { align = 4; }
    else { align = 8; }
    self.size = (self.size + align - 1) & ~(align - 1);
    self.size = self.size + size;
    var offset: i64 = -self.size;
    pe_idmap_put(&mut self.offsets, id, offset);
    return offset;
}

/// Allocate raw space (not tied to a ValueId) and return its offset.
pub fn PeStackFrame_alloc_raw(self: &mut PeStackFrame, size: i64) -> i64 {
    var align: i64 = 8;
    if size <= 1 { align = 1; }
    else if size <= 2 { align = 2; }
    else if size <= 4 { align = 4; }
    else { align = 8; }
    self.size = (self.size + align - 1) & ~(align - 1);
    self.size = self.size + size;
    return -self.size;
}

/// The stack offset of a value (0 when absent, as unwrap_or(&0)).
pub fn PeStackFrame_offset(self: &PeStackFrame, id: i64) -> i64 {
    return pe_idmap_get(&self.offsets, id);
}

// ===========================================================================
// Small helpers (BTreeSet<BTreeMap> stand-ins, block label keys, byte emit)
// ===========================================================================

/// Linear-scan membership for Vec<str>.
fn pe_ir_strs_contains(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

/// Insert `s` into sorted Vec<str> `v` (BTreeSet<String>::insert).
fn pe_ir_strs_insert_sorted(v: Vec<str>, s: str) -> Vec<str> {
    var v = v;
    var i: i64 = 0;
    while i < v.len() {
        var c: i64 = str_compare(v.get(i), s);
        if c == 0 { return v; }
        if c > 0 {
            v.push(v.get(v.len() - 1));
            var j: i64 = v.len() - 1;
            while j > i {
                v.set(j, v.get(j - 1));
                j = j - 1;
            }
            v.set(i, s);
            return v;
        }
        i = i + 1;
    }
    v.push(s);
    return v;
}

/// Insertion-sort a Vec<str> with str_compare (deterministic BTree order).
fn pe_ir_sort_strs(v: Vec<str>) -> Vec<str> {
    var v = v;
    var i: i64 = 1;
    while i < v.len() {
        var key: str = v.get(i);
        var j: i64 = i - 1;
        while j >= 0 && str_compare(v.get(j), key) > 0 {
            v.set(j + 1, v.get(j));
            j = j - 1;
        }
        v.set(j + 1, key);
        i = i + 1;
    }
    return v;
}

/// Insertion-sort a Vec<ValueIdInst> by instruction id (Rust sorts the
/// HashMap iteration into id order; ids are already dense but this keeps
/// the port faithful).
fn pe_sort_value_id_insts(v: Vec<ValueIdInst>) -> Vec<ValueIdInst> {
    var v = v;
    var i: i64 = 1;
    while i < v.len() {
        var key: ValueIdInst = v.get(i);
        var j: i64 = i - 1;
        while j >= 0 && v.get(j).id > key.id {
            v.set(j + 1, v.get(j));
            j = j - 1;
        }
        v.set(j + 1, key);
        i = i + 1;
    }
    return v;
}

/// Insertion-sort a Vec<ValueIdMeta> by value id.
fn pe_sort_value_id_metas(v: Vec<ValueIdMeta>) -> Vec<ValueIdMeta> {
    var v = v;
    var i: i64 = 1;
    while i < v.len() {
        var key: ValueIdMeta = v.get(i);
        var j: i64 = i - 1;
        while j >= 0 && v.get(j).id > key.id {
            v.set(j + 1, v.get(j));
            j = j - 1;
        }
        v.set(j + 1, key);
        i = i + 1;
    }
    return v;
}

/// The block_labels map key: Rust (String, u32) tuple -> "func:block".
fn pe_block_key(func_name: str, block_id: i64) -> str {
    return func_name + ":" + int_to_str(block_id);
}

/// Index of `pledge_name` in module.extern_functions, or -1
/// (Rust: module.extern_functions.get(&pledge_name) -> Option).
fn pe_extern_sig_index(module: &IrModule, pledge_name: str) -> i64 {
    var i: i64 = 0;
    while i < module.extern_functions.len() {
        if module.extern_functions.get(i).name == pledge_name { return i; }
        i = i + 1;
    }
    return -1;
}

/// IrType::Ptr(_) predicate (Rust `matches!(t, IrType::Ptr(_))`).
fn pe_is_ptr(t: IrType) -> bool {
    match t {
        IrType::Ptr(_) => { return true; }
        _ => { return false; }
    }
    return false;
}

/// Arithmetic operators (the float-binop first arm).
fn pe_binop_is_arith(op: BinOp) -> bool {
    match op {
        BinOp::Add => { return true; }
        BinOp::Sub => { return true; }
        BinOp::Mul => { return true; }
        BinOp::Div => { return true; }
        _ => { return false; }
    }
    return false;
}

/// Comparison operators (the float-binop second arm).
fn pe_binop_is_cmp(op: BinOp) -> bool {
    match op {
        BinOp::Eq => { return true; }
        BinOp::Neq => { return true; }
        BinOp::Lt => { return true; }
        BinOp::Gt => { return true; }
        BinOp::LtEq => { return true; }
        BinOp::GtEq => { return true; }
        _ => { return false; }
    }
    return false;
}

/// Does this interrupt vector push an error code?
/// (#DF=0x08, #TS=0x0A, #NP=0x0B, #SS=0x0C, #GP=0x0D, #PF=0x0E, #AC=0x11,
///  #CP=0x1E; interrupt_vector is -1 when the function has none)
fn pe_interrupt_has_err(v: i64) -> bool {
    return v == 0x08 || v == 0x0A || v == 0x0B || v == 0x0C
        || v == 0x0D || v == 0x0E || v == 0x11 || v == 0x1E;
}

/// Trim `chars` bytes from both ends of `s` (Rust trim_matches).
fn pe_str_contains_char(chars: str, ch: i64) -> bool {
    var i: i64 = 0;
    while i < str_len(chars) {
        if str_byte_at(chars, i) == ch { return true; }
        i = i + 1;
    }
    return false;
}

fn pe_str_trim_chars(s: str, chars: str) -> str {
    var start: i64 = 0;
    var end: i64 = str_len(s);
    while start < end {
        if pe_str_contains_char(chars, str_byte_at(s, start)) {
            start = start + 1;
        } else {
            break;
        }
    }
    while end > start {
        if pe_str_contains_char(chars, str_byte_at(s, end - 1)) {
            end = end - 1;
        } else {
            break;
        }
    }
    return str_slice(s, start, end);
}

/// Raw byte emission (Rust `enc.emit(&[a, b])`).
fn peir_emit2(e: &mut PeirEnc, a: i64, b: i64) -> void {
    PeirEnc_emit_u8(e, a);
    PeirEnc_emit_u8(e, b);
}

fn peir_emit8(e: &mut PeirEnc, a: i64, b: i64, c: i64, d: i64,
              f: i64, g: i64, h: i64, i: i64) -> void {
    PeirEnc_emit_u8(e, a);
    PeirEnc_emit_u8(e, b);
    PeirEnc_emit_u8(e, c);
    PeirEnc_emit_u8(e, d);
    PeirEnc_emit_u8(e, f);
    PeirEnc_emit_u8(e, g);
    PeirEnc_emit_u8(e, h);
    PeirEnc_emit_u8(e, i);
}

/// The module's function names, sorted (Rust: keys of a sorted map).
fn pe_module_fn_names(module: &IrModule) -> Vec<str> {
    var v: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < module.functions.len() {
        v.push(module.functions.get(i).name);
        i = i + 1;
    }
    return pe_ir_sort_strs(v);
}

/// (type id, function label) for one dyn-call candidate
/// (Rust Vec<(i64, u32)>).
pub struct PeDynCandidate {
    pub tid: i64,
    pub label: i64,
}

/// The runtime stub names pre-allocated function labels, in the order of
/// the literal list in PeirGen::generate (src/pe.rs).
fn pe_runtime_stub_names() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("p_print_int"); v.push("p_print_str"); v.push("p_print_bool"); v.push("p_print_float");
    v.push("p_panic"); v.push("p_malloc"); v.push("p_free"); v.push("p_memset");
    v.push("p_str_concat"); v.push("p_to_str");
    v.push("p_to_str_vec"); v.push("p_to_str_float"); v.push("p_to_str_str"); v.push("p_to_str_bool");
    v.push("p_float_to_str"); v.push("p_bool_to_str"); v.push("p_char_to_str");
    v.push("p_eprint_str"); v.push("p_print_newline");
    v.push("p_sb_new"); v.push("p_sb_append"); v.push("p_sb_to_str");
    v.push("p_file_read"); v.push("p_file_write");
    v.push("p_str_join_n");
    v.push("p_vec_new"); v.push("p_vec_push"); v.push("p_vec_len"); v.push("p_vec_get"); v.push("p_vec_pop"); v.push("p_print_vec");
    v.push("p_vec_set"); v.push("p_vec_is_empty"); v.push("p_vec_clear"); v.push("p_vec_capacity");
    v.push("p_vec_contains");
    v.push("p_vec_first"); v.push("p_vec_last"); v.push("p_vec_truncate");
    v.push("p_vec_clone");
    v.push("p_map_new"); v.push("p_map_insert"); v.push("p_map_get"); v.push("p_map_contains");
    v.push("p_map_remove"); v.push("p_map_len"); v.push("p_map_is_empty"); v.push("p_print_map");
    v.push("p_map_clear"); v.push("p_map_get_or");
    v.push("p_string_len"); v.push("p_string_is_empty");
    v.push("p_string_starts_with");
    v.push("p_string_parse_int");
    v.push("p_string_bytes"); v.push("p_string_clone");
    // Phase 5A.3: Interrupt handler stubs
    v.push("p_cli"); v.push("p_sti"); v.push("p_lidt"); v.push("p_idt_set_entry");
    v.push("p_hlt"); v.push("p_inb"); v.push("p_outb"); v.push("p_outw"); v.push("p_inw"); v.push("p_outl"); v.push("p_inl");
    // Phase 5A.4: MMU/page table stubs
    v.push("p_cr3_read"); v.push("p_cr3_write"); v.push("p_cr0_read"); v.push("p_cr0_write");
    v.push("p_cr2_read"); v.push("p_cr4_read"); v.push("p_cr4_write"); v.push("p_invlpg");
    v.push("p_wrmsr_gs_base"); v.push("p_rdmsr_gs_base"); v.push("p_wrmsr_kernel_gs_base"); v.push("p_swapgs");
    v.push("p_page_map"); v.push("p_page_unmap");
    v.push("p_phys_read64"); v.push("p_phys_write64");
    v.push("p_mem_read8"); v.push("p_mem_write8");
    v.push("p_mem_read16"); v.push("p_mem_write16");
    v.push("p_mem_read32"); v.push("p_mem_write32");
    v.push("p_mem_read64"); v.push("p_mem_write64");
    v.push("p_get_rbp"); v.push("p_get_rsp"); v.push("p_atomic_xchg32");
    // Phase 5A.5: GDT stubs
    v.push("p_lgdt"); v.push("p_gdt_set_entry");
    v.push("p_enter_user_mode");
    v.push("syscall_handler");
    v.push("syscall_dispatch");
    // Phase 5A.6: Serial port stubs
    v.push("p_serial_init"); v.push("p_serial_write"); v.push("p_serial_read"); v.push("p_serial_ready");
    // Native runtime stubs: argv, process exec
    v.push("p_argc"); v.push("p_argv"); v.push("p_system");
    // Arena marks / region frees (memory is never reused here)
    v.push("p_arena_save"); v.push("p_arena_restore"); v.push("p_region_free");
    return v;
}

// ===========================================================================
// PeirGen::generate (src/pe.rs)
// ===========================================================================

/// Generate the complete PE file from an IR module.
pub fn PeirGen_generate(self: &mut PeirGen, module: &IrModule) -> Vec {
    // 1. Collect all string constants from IR (sorted for determinism)
    var all_strings: Vec<str> = Vec::new();
    var func_names: Vec<str> = pe_module_fn_names(module);
    var fi: i64 = 0;
    while fi < func_names.len() {
        match IrModule_get_function(module, func_names.get(fi)) {
            OptIrFunction::Some(func) => {
                var insts: Vec<ValueIdInst> = pe_sort_value_id_insts(func.insts);
                var ii: i64 = 0;
                while ii < insts.len() {
                    var inst: Inst = insts.get(ii).inst;
                    match inst {
                        Inst::ConstStr(value) => {
                            if !pe_ir_strs_contains(all_strings, value) {
                                all_strings.push(value);
                            }
                        }
                        Inst::ConstFnRef(name) => {
                            if !pe_ir_strs_contains(all_strings, name) {
                                all_strings.push(name);
                            }
                        }
                        Inst::Panic(message) => {
                            if !pe_ir_strs_contains(all_strings, message) {
                                all_strings.push(message);
                            }
                        }
                        _ => {}
                    }
                    ii = ii + 1;
                }
            }
            OptIrFunction::None => {}
        }
        fi = fi + 1;
    }
    // Add boolean strings
    all_strings.push("true");
    all_strings.push("false");
    // Panic messages of the runtime stubs
    var panic_strs: Vec<str> = peir_panic_strings();
    var psi: i64 = 0;
    while psi < panic_strs.len() {
        if !pe_ir_strs_contains(all_strings, panic_strs.get(psi)) {
            all_strings.push(panic_strs.get(psi));
        }
        psi = psi + 1;
    }

    // The C functions the program reaches, from the DLLs it links
    pe_clear_extra_imports();
    var reached: Vec<str> = pe_ir_needed_functions(module);
    var xi: i64 = 0;
    while xi < module.extern_decls.len() {
        var xd: ExternDecl = module.extern_decls.get(xi);
        match xd.link_lib {
            OptStr::Some(lib) => {
                var dll: str = pe_link_dll(lib);
                if dll != "" && !self.bare_mode && pe_ir_strs_contains(reached, xd.pledge_name)
                    && !pe_ir_strs_contains(self.module_fns, xd.pledge_name)
                    && pe_import_slot(xd.c_name) < 0
                    && !pe_ir_strs_contains(pe_primitive_names(), xd.c_name)
                    && pe_ir_c_override(module, xd.pledge_name) == "" {
                    pe_add_extra_import(dll, xd.c_name);
                }
            }
            OptStr::None => {}
        }
        xi = xi + 1;
    }
    // A DLL not on this machine: the program reports it when it starts
    // (PeirGen_gen_dll_loader); say so now too (release E4)
    var xdlls: Vec<PeDllImport> = pe_dll_imports();
    var xdi: i64 = PE_STATIC_DLLS;
    while xdi < xdlls.len() {
        var xdll: str = xdlls.get(xdi).dll;
        var xcands: Vec<str> = pe_link_dll_candidates(xdll);
        var xfound: bool = false;
        var xci: i64 = 0;
        while xci < xcands.len() {
            if pe_dll_found(xcands.get(xci), "") { xfound = true; }
            xci = xci + 1;
        }
        if !xfound {
            p_eprint_str("warning: " + xdll + " is not on this machine (searched the current folder, the system folder and PATH): a call into it stops the program with a message\n");
        }
        xdi = xdi + 1;
    }

    // 2. Build .rdata section (a bare build has no import table)
    var rdata: PeirRdata = PeirRdata_new();
    if self.bare_mode {
        all_strings.push("panic: ");
        all_strings.push("Panic: ");
        PeirRdata_build_strings(&mut rdata, all_strings);
    } else {
        PeirRdata_build(&mut rdata, all_strings);
    }

    // Record string rdata offsets for later codegen
    var si: i64 = 0;
    while si < all_strings.len() {
        var s: str = all_strings.get(si);
        var soff: i64 = PeirRdata_string_offset(&rdata, s);
        if soff != -1 {
            HashMap_insert(self.string_rdata_offsets, s, soff);
        }
        si = si + 1;
    }
    // Record IAT offsets
    self.iat_rdata_offsets = rdata.iat_offsets;

    // 2b. Append module-level mutable globals to .rdata (section is writable)
    // Each global gets storage for its type — a struct/enum global needs
    // the full size (a Store does a struct copy), not just 8 bytes.
    var global_names: Vec<str> = Vec::new();
    var gi: i64 = 0;
    while gi < module.globals.len() {
        global_names.push(module.globals.get(gi).name);
        gi = gi + 1;
    }
    global_names = pe_ir_sort_strs(global_names);
    // Slots holding a str literal's address get patched once .rdata's RVA
    // is known: pairs of (slot rdata offset, string rdata offset).
    var global_str_patches: Vec<i64> = Vec::new();
    gi = 0;
    while gi < global_names.len() {
        var gname: str = global_names.get(gi);
        match IrModule_get_global(module, gname) {
            OptGlobalLookup::Some(gty, init_expr) => {
                var gsize: i64 = IrModule_type_size(module, gty);
                if gsize < 8 { gsize = 8; }
                // Compute the 8-byte initial value
                var bits: i64 = 0;
                var f32_init: bool = false;
                var str_off: i64 = -1;
                match init_expr {
                    Expr::IntLit(v) => { bits = v; }
                    Expr::BoolLit(b) => { if b { bits = 1; } else { bits = 0; } }
                    Expr::FloatLit(f) => {
                        if ir_type_eq(gty, IrType::F32) {
                            bits = p_f32_to_bits(f);
                            f32_init = true;
                        } else {
                            bits = p_f64_to_bits(f);
                        }
                    }
                    Expr::StringLit(s) => {
                        str_off = PeirRdata_add_string(&mut rdata, s);
                    }
                    _ => { bits = 0; } // zero-initialize
                }
                var goff: i64 = rdata.data.len();
                if str_off != -1 {
                    global_str_patches.push(goff);
                    global_str_patches.push(str_off);
                }
                if f32_init {
                    var b1: i64 = 0;
                    while b1 < 4 {
                        rdata.data.push((bits >> (8 * b1)) & 0xFF);
                        b1 = b1 + 1;
                    }
                    var bz: i64 = 4;
                    while bz < gsize {
                        rdata.data.push(0);
                        bz = bz + 1;
                    }
                } else {
                    var b2: i64 = 0;
                    while b2 < 8 {
                        rdata.data.push((bits >> (8 * b2)) & 0xFF);
                        b2 = b2 + 1;
                    }
                    var b3: i64 = 8;
                    while b3 < gsize {
                        rdata.data.push(0);
                        b3 = b3 + 1;
                    }
                }
                HashMap_insert(self.global_rdata_offsets, gname, goff);
            }
            OptGlobalLookup::None => {}
        }
        gi = gi + 1;
    }

    // Bump-allocator state for p_malloc: 32 zero bytes in writable .rdata —
    // +0 chunk cursor, +8 chunk end, +16 cached process-heap handle, +24 lock.
    // Cache-line aligned: a locked operation on a value that crosses a line
    // stalls the whole memory bus (about 900 ns per allocation).
    while rdata.data.len() % 64 != 0 {
        rdata.data.push(0);
    }
    self.alloc_rdata_off = rdata.data.len();
    var az: i64 = 0;
    while az < PEIR_ALLOC_STATE_SIZE {
        rdata.data.push(0);
        az = az + 1;
    }

    // 3. Pre-allocate labels for all functions (sorted for deterministic layout)
    fi = 0;
    while fi < func_names.len() {
        var flabel: i64 = PeirEnc_alloc_label(&mut self.enc);
        HashMap_insert(self.func_labels, func_names.get(fi), flabel);
        fi = fi + 1;
    }
    // Pre-allocate labels for runtime stubs
    var stub_names: Vec<str> = pe_runtime_stub_names();
    var ri: i64 = 0;
    while ri < stub_names.len() {
        var slabel: i64 = PeirEnc_alloc_label(&mut self.enc);
        HashMap_insert(self.func_labels, stub_names.get(ri), slabel);
        ri = ri + 1;
    }

    // 3b. The Fides runtime (src/pe_runtime/): its machine-code
    //     primitives, the stubs that hand over to it, and every
    //     `extern "C"` function of msvcrt.dll / kernel32.dll (a thunk each)
    self.module_fns = func_names;
    var prims: Vec<str> = pe_primitive_names();
    if self.bare_mode { prims = Vec::new(); }
    var pi: i64 = 0;
    while pi < prims.len() {
        var plabel: i64 = PeirEnc_alloc_label(&mut self.enc);
        HashMap_insert(self.func_labels, prims.get(pi), plabel);
        pi = pi + 1;
    }
    // (only those the program reaches: the runtime function they hand
    // over to is left out otherwise)
    var needed: Vec<str> = pe_ir_needed_functions(module);
    var deps: Vec<PeirStrPair> = pe_stub_deps();
    var di: i64 = 0;
    while di < deps.len() {
        var dep: PeirStrPair = deps.get(di);
        if pe_ir_strs_contains(self.module_fns, dep.b) && pe_ir_strs_contains(needed, dep.a) {
            var dlabel: i64 = PeirEnc_alloc_label(&mut self.enc);
            HashMap_insert(self.func_labels, dep.a, dlabel);
        }
        di = di + 1;
    }
    var edi: i64 = 0;
    while edi < module.extern_decls.len() {
        var ext: ExternDecl = module.extern_decls.get(edi);
        if !HashMap_contains(self.func_labels, ext.pledge_name) {
            var over: str = pe_ir_c_override(module, ext.pledge_name);
            if over != "" {
                self.c_overrides.push(COverride_new(ext.pledge_name, over));
            } else {
                // `fn pe_f64_to_bits as pe_f32_raw(x: f32) -> i64`: another name
                // (and Fides type) for a primitive
                var done_ext: bool = false;
                if !self.bare_mode && pe_ir_strs_contains(pe_primitive_names(), ext.c_name) {
                    var prim_label: i64 = HashMap_get(self.func_labels, ext.c_name);
                    HashMap_insert(self.func_labels, ext.pledge_name, prim_label);
                    done_ext = true;
                }
                if !done_ext {
                    var slot: i64 = pe_import_slot(ext.c_name);
                    var sig_idx: i64 = pe_extern_sig_index(module, ext.pledge_name);
                    if slot >= 0 && sig_idx >= 0 && !self.bare_mode {
                        var sig: StringVecIrType = module.extern_functions.get(sig_idx);
                        var tlabel: i64 = PeirEnc_alloc_label(&mut self.enc);
                        HashMap_insert(self.func_labels, ext.pledge_name, tlabel);
                        self.c_thunks.push(CThunk_new(module, ext.pledge_name, slot, sig.params, sig.ret));
                        done_ext = true;
                    }
                }
                if !done_ext {
                    // As in the C backend: the functions of a local header that does
                    // not exist (`include "pledge_audio.h"`) are stubs returning 0
                    var missing_local_header: bool = false;
                    match ext.include {
                        OptStr::Some(inc) => {
                            if !str_starts_with(inc, "<")
                                && !c_file_exists(pe_str_trim_chars(inc, "\"<>")) {
                                missing_local_header = true;
                            }
                        }
                        OptStr::None => {}
                    }
                    if missing_local_header {
                        var mlabel: i64 = PeirEnc_alloc_label(&mut self.enc);
                        HashMap_insert(self.func_labels, ext.pledge_name, mlabel);
                        self.stub_externs.push(ext.pledge_name);
                    }
                }
            }
        }
        edi = edi + 1;
    }
    var cbi: i64 = 0;
    while cbi < module.c_callbacks.len() {
        var cb_target: str = module.c_callbacks.get(cbi);
        if pe_ir_strs_contains(needed, cb_target) {
            match IrModule_get_function(module, cb_target) {
                OptIrFunction::Some(cb_func) => {
                    var cb_label: i64 = PeirEnc_alloc_label(&mut self.enc);
                    HashMap_insert(self.func_labels, c_fn_name(cb_target), cb_label);
                    var cb_params: Vec<IrType> = Vec::new();
                    var cbp: i64 = 1;
                    while cbp < cb_func.params.len() {
                        cb_params.push(cb_func.params.get(cbp).ty);
                        cbp = cbp + 1;
                    }
                    self.c_adapters.push(CAdapter_new(c_fn_name(cb_target), cb_target, cb_params, cb_func.ret_ty));
                }
                OptIrFunction::None => {}
            }
        }
        cbi = cbi + 1;
    }
    // Functions named by a string constant can be looked up by name: the
    // program's, and the runtime's that are compiled in (the task
    // scheduler starts its worker, poller and pool threads by name)
    var nf: Vec<str> = Vec::new();
    self.named_fns = nf;
    var ni: i64 = 0;
    while ni < all_strings.len() {
        var ns: str = all_strings.get(ni);
        if pe_ir_strs_contains(self.module_fns, ns)
            && (!is_pe_runtime_fn(ns) || pe_ir_strs_contains(needed, ns)) {
            self.named_fns.push(ns);
        }
        ni = ni + 1;
    }

    var api: i64 = 0;
    while api < 9 {
        self.arith_panics.push(PeirEnc_alloc_label(&mut self.enc));
        api = api + 1;
    }
    self.crash_filter = PeirEnc_alloc_label(&mut self.enc);

    // A flat binary starts with a jump to its entry point
    var bare_entry: i64 = -1;
    if self.bare_mode {
        bare_entry = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_jmp_label(&mut self.enc, bare_entry);
    }

    // 4. Generate code for each function (sorted for deterministic layout);
    //    of the Fides runtime only what the program uses
    fi = 0;
    while fi < func_names.len() {
        var fname: str = func_names.get(fi);
        if is_pe_runtime_fn(fname) && !pe_ir_strs_contains(needed, fname) {
            fi = fi + 1;
            continue;
        }
        match IrModule_get_function(module, fname) {
            OptIrFunction::Some(func) => {
                PeirGen_gen_function(self, fname, &func, module);
            }
            OptIrFunction::None => {}
        }
        fi = fi + 1;
    }

    // 5. Generate runtime stubs
    PeirGen_gen_runtime_stubs(self);
    PeirGen_gen_arith_panics(self);
    if self.bare_mode {
        PeirGen_trap_unplaced(self, pe_runtime_stub_names());
    } else {
        PeirGen_gen_pe_primitives(self);
    }
    var thunks: Vec<CThunk> = self.c_thunks;
    var ti: i64 = 0;
    while ti < thunks.len() {
        var t: CThunk = thunks.get(ti);
        PeirGen_gen_c_thunk(self, &t);
        ti = ti + 1;
    }
    var adapters: Vec<CAdapter> = self.c_adapters;
    var cai: i64 = 0;
    while cai < adapters.len() {
        var ca: CAdapter = adapters.get(cai);
        PeirGen_gen_c_adapter(self, &ca);
        cai = cai + 1;
    }
    var stub_externs: Vec<str> = self.stub_externs;
    var si2: i64 = 0;
    while si2 < stub_externs.len() {
        PeirGen_place_fn(self, stub_externs.get(si2));
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_ret(&mut self.enc);
        si2 = si2 + 1;
    }

    // 5b. The start-up loader of the `link` DLLs (before the entry point,
    //     which calls it)
    PeirGen_gen_dll_loader(self, &mut rdata);

    // 6. Generate entry point (_main)
    if self.bare_mode {
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, bare_entry);
    }
    PeirGen_gen_entry_point(self);

    // 7. Resolve local labels (jumps/calls within .text)
    PeirEnc_resolve_labels(&mut self.enc);

    // A flat binary (release G2): [code][int3 to a 4 KB boundary][data],
    // loaded at g_pe_bare_load, entered at its first byte
    if self.bare_mode {
        var flat_data: i64 = g_pe_bare_load + pe_align_up(self.enc.code.len(), PE_SECTION_ALIGN);
        PeirEnc_resolve_rip_refs(&mut self.enc, g_pe_bare_load, flat_data);
        var fpi: i64 = 0;
        while fpi < global_str_patches.len() {
            var fslot: i64 = global_str_patches.get(fpi);
            var fva: i64 = flat_data + global_str_patches.get(fpi + 1);
            var fb: i64 = 0;
            while fb < 8 {
                rdata.data.set(fslot + fb, (fva >> (8 * fb)) & 0xFF);
                fb = fb + 1;
            }
            fpi = fpi + 2;
        }
        var flat: Vec = Vec::new();
        var ci: i64 = 0;
        while ci < self.enc.code.len() {
            flat.push(self.enc.code.get(ci));
            ci = ci + 1;
        }
        while flat.len() < flat_data - g_pe_bare_load {
            flat.push(0xCC);
        }
        var di2: i64 = 0;
        while di2 < rdata.data.len() {
            flat.push(rdata.data.get(di2));
            di2 = di2 + 1;
        }
        return flat;
    }

    // 8. Compute .rdata RVA dynamically from actual .text size
    var rdata_rva: i64 = PE_TEXT_RVA + pe_align_up(self.enc.code.len(), PE_SECTION_ALIGN);

    // 9. Patch RIP-relative references (strings + IAT calls)
    PeirEnc_resolve_rip_refs(&mut self.enc, PE_TEXT_RVA, rdata_rva);

    // 10. Patch import table RVAs in .rdata
    PeirRdata_patch_rvas(&mut rdata, rdata_rva);

    // 10b. Patch str-literal global initializers: each slot holds the
    // absolute VA of its string (image loads at preferred base — no relocs).
    var pi: i64 = 0;
    while pi < global_str_patches.len() {
        var slot_off: i64 = global_str_patches.get(pi);
        var str_off: i64 = global_str_patches.get(pi + 1);
        var va: i64 = PE_IMAGE_BASE + rdata_rva + str_off;
        var pb: i64 = 0;
        while pb < 8 {
            rdata.data.set(slot_off + pb, (va >> (8 * pb)) & 0xFF);
            pb = pb + 1;
        }
        pi = pi + 2;
    }

    // 11. Calculate PE metadata
    var import_dir_rva: i64 = rdata_rva + rdata.import_dir_offset;
    var iat_rva: i64 = rdata_rva + rdata.iat_offset;
    var iat_size: i64 = rdata.iat_size; // every DLL's entries + null terminators
    var entry_rva: i64 = PE_TEXT_RVA + self.entry_offset;

    // 12. Build PE file
    return pe_build_file(self.enc.code, rdata.data, entry_rva, import_dir_rva, iat_rva, iat_size, rdata_rva);
}

// ===========================================================================
// PeirGen::gen_function (src/pe.rs)
// ===========================================================================

/// Generate code for a single function.
pub fn PeirGen_gen_function(self: &mut PeirGen, name: str, func: &IrFunction, module: &IrModule) -> void {
    self.cur_func = name;
    // The Fides runtime is machine-level code the interpreter never runs:
    // its arithmetic wraps, as a @wrapping function's does.
    self.cur_wrapping = func.is_wrapping || is_pe_runtime_fn(name);
    var label: i64 = HashMap_get(self.func_labels, name);
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, label);
    if str_len(p_getenv("PE_DUMP_FN")) > 0 {
        p_eprint_str("FN " + name + " @" + int_to_str(self.enc.code.len()) + "\n");
    }

    if func.is_interrupt {
        // Interrupt handler prologue: save all GP registers
        // The CPU already pushed SS:RSP, RFLAGS, CS:RIP on interrupt
        // For exceptions with error codes (#PF=0x0E, #GP=0x0D, etc.),
        // the CPU also pushed an error code before jumping here.
        // We save it to 0x510 and remove it from the stack so the
        // epilogue's iretq works correctly.

        // Check if this vector pushes an error code
        if pe_interrupt_has_err(func.interrupt_vector) {
            // Pop error code into RAX, save to 0x510, then push RAX back
            PeirEnc_pop(&mut self.enc, PEIR_RAX);
            // mov [0x510], rax
            peir_emit8(&mut self.enc, 0x48, 0x89, 0x04, 0x25, 0x10, 0x05, 0x00, 0x00);
        }

        // We save all general-purpose registers
        PeirEnc_push(&mut self.enc, PEIR_RAX);
        PeirEnc_push(&mut self.enc, PEIR_RBX);
        PeirEnc_push(&mut self.enc, PEIR_RCX);
        PeirEnc_push(&mut self.enc, PEIR_RDX);
        PeirEnc_push(&mut self.enc, PEIR_RSI);
        PeirEnc_push(&mut self.enc, PEIR_RDI);
        PeirEnc_push(&mut self.enc, PEIR_R8);
        PeirEnc_push(&mut self.enc, PEIR_R9);
        PeirEnc_push(&mut self.enc, PEIR_R10);
        PeirEnc_push(&mut self.enc, PEIR_R11);
        PeirEnc_push(&mut self.enc, PEIR_R12);
        PeirEnc_push(&mut self.enc, PEIR_R13);
        PeirEnc_push(&mut self.enc, PEIR_R14);
        PeirEnc_push(&mut self.enc, PEIR_R15);
        // Set up frame
        PeirEnc_push(&mut self.enc, PEIR_RBP);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    } else {
        // Prologue
        PeirEnc_push(&mut self.enc, PEIR_RBP);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    }

    // Allocate stack frame (value_metas is insertion-ordered by id already,
    // as x86.fd iterates it directly)
    var frame: PeStackFrame = PeStackFrame_new();

    // ── Slot reuse (pe-roadmap items 84-85) ──
    // Block-local temporaries (def + all uses in one block) share a slot
    // pool instead of owning one slot each, so frames stay small. Pools are
    // dense Vec<i64> indexed by value id; -1 = absent.
    var nvals: i64 = func.value_metas.len() + func.insts.len() + 16;
    var def_block: Vec<i64> = Vec::new();
    var n_use_blocks: Vec<i64> = Vec::new();
    var a_use_block: Vec<i64> = Vec::new();
    var last_use: Vec<i64> = Vec::new();
    var zi: i64 = 0;
    while zi < nvals {
        def_block.push(-1);
        n_use_blocks.push(0);
        a_use_block.push(-1);
        last_use.push(-1);
        zi = zi + 1;
    }
    var ops: Vec<i64> = Vec::new();
    var pos: i64 = 0;
    var abi: i64 = 0;
    while abi < func.blocks.len() {
        var ablock: BasicBlock = func.blocks.get(abi);
        var aii: i64 = 0;
        while aii < ablock.instructions.len() {
            var aiid: i64 = ablock.instructions.get(aii);
            match IrFunction_get_inst(func, aiid) {
                OptInst::Some(ainst) => {
                    if aiid >= 0 && aiid < nvals { def_block.set(aiid, abi); }
                    // An alloca's storage lives as long as the function: a
                    // reference to it can be kept in another variable after
                    // the alloca's own last use (`val r = &f()`, release K6)
                    match ainst {
                        Inst::Alloca(_, _) => { if aiid >= 0 && aiid < nvals { def_block.set(aiid, -1); } }
                        _ => {}
                    }
                    match ainst {
                        Inst::TryUnwrap(_, okd, _, _) => {
                            if okd >= 0 && okd < nvals { def_block.set(okd, abi); }
                        }
                        _ => {}
                    }
                    peir_inst_operands(ainst, &mut ops);
                    var oi: i64 = 0;
                    while oi < ops.len() {
                        var op: i64 = ops.get(oi);
                        if op >= 0 && op < nvals {
                            if a_use_block.get(op) != abi {
                                n_use_blocks.set(op, n_use_blocks.get(op) + 1);
                                a_use_block.set(op, abi);
                            }
                            last_use.set(op, pos);
                        }
                        oi = oi + 1;
                    }
                    ops.clear();
                }
                OptInst::None => {}
            }
            pos = pos + 1;
            aii = aii + 1;
        }
        abi = abi + 1;
    }

    self.unchecked = peir_unchecked_ops(func, nvals);
    // Registers: the hottest locals keep one for the whole function, the
    // others serve temporaries, freed and reused as pool slots are.
    var use_regs: bool = !self.bare_mode && !func.is_interrupt;
    var no_reg: Vec<i64> = peir_zeros(nvals);
    var used_regs: Vec<i64> = Vec::new();
    var ra_facts: PeirRaFacts = PeirRaFacts_new();
    // Value id -> 1 + register, from the whole-function allocator (D4)
    var in_reg_of: Vec<i64> = peir_zeros(nvals);
    var global_ra: bool = use_regs && PEIR_GLOBAL_RA;
    if global_ra {
        peir_pick_reg_vars(func, module, &mut frame, &mut no_reg, nvals, 0, &mut ra_facts);
        used_regs = peir_global_ra(func, module, &mut frame, &mut no_reg, nvals, &ra_facts, &mut in_reg_of);
    } else if use_regs {
        used_regs = peir_pick_reg_vars(func, module, &mut frame, &mut no_reg, nvals, PEIR_VALUE_REGS - 2, &mut ra_facts);
    }
    // Values the allocator put in a register: their offset is the register
    var assigned: Vec<i64> = Vec::new();
    zi = 0;
    while zi < nvals { assigned.push(-2); zi = zi + 1; }
    if global_ra {
        var gi: i64 = 0;
        while gi < nvals {
            if in_reg_of.get(gi) > 0 {
                var goff: i64 = PEIR_REG_SLOT + in_reg_of.get(gi) - 1;
                frame.offsets.push(PeOffEnt { id: gi, offset: goff });
                assigned.set(gi, goff);
            }
            gi = gi + 1;
        }
    }
    var free_regs: Vec<i64> = Vec::new();
    if use_regs && !global_ra {
        var fr: i64 = PEIR_VALUE_REGS - 1;
        while fr >= used_regs.len() {
            free_regs.push(fr);
            fr = fr - 1;
        }
    }

    var vi: i64 = 0;
    while vi < func.value_metas.len() {
        var vm: ValueIdMeta = func.value_metas.get(vi);
        if !peir_recyclable(vm.id, def_block, n_use_blocks, a_use_block, nvals) && !(vm.id < nvals && in_reg_of.get(vm.id) > 0) {
            var size: i64 = IrModule_type_size(module, vm.meta.ty);
            if size < 8 { size = 8; }
            PeStackFrame_alloc(&mut frame, vm.id, size);
        }
        vi = vi + 1;
    }
    // A parameter read more than once keeps a free register for the whole
    // function, while two stay free for temporaries
    if use_regs && !global_ra {
        var puses: Vec<i64> = peir_zeros(nvals);
        var pui: i64 = 0;
        while pui < func.insts.len() {
            var pops: Vec<i64> = Vec::new();
            peir_inst_operands(func.insts.get(pui).inst, &mut pops);
            var po: i64 = 0;
            while po < pops.len() {
                var pv: i64 = pops.get(po);
                if pv >= 0 && pv < nvals { puses.set(pv, puses.get(pv) + 1); }
                po = po + 1;
            }
            pui = pui + 1;
        }
        while free_regs.len() > 2 {
            // The most used parameter not yet in a register
            var best: i64 = -1;
            var best_uses: i64 = 1;
            var pi: i64 = 0;
            while pi < func.params.len() {
                var prm: ValueIdType = func.params.get(pi);
                if prm.id < nvals && puses.get(prm.id) > best_uses && no_reg.get(prm.id) == 0
                    && peir_reg_word(module, prm.ty) {
                    best = prm.id;
                    best_uses = puses.get(prm.id);
                }
                pi = pi + 1;
            }
            if best < 0 { break; }
            puses.set(best, 0);
            var r: i64 = free_regs.pop();
            used_regs.push(r);
            pe_idmap_put(&mut frame.offsets, best, PEIR_REG_SLOT + r);
        }
    }
    // Assign recyclable values pool slots in scan order — the same order the
    // emit loop runs, so frees/assignments line up. A value's slot frees
    // once the instruction holding its last use passes. `assigned` tracks
    // offsets densely (O(1)) — the Vec<PeOffEnt> map is O(n) per lookup.
    var free_slots: Vec<i64> = Vec::new();
    pos = 0;
    var sbi: i64 = 0;
    while sbi < func.blocks.len() {
        var sblock: BasicBlock = func.blocks.get(sbi);
        var sii: i64 = 0;
        while sii < sblock.instructions.len() {
            var siid: i64 = sblock.instructions.get(sii);
            match IrFunction_get_inst(func, siid) {
                OptInst::Some(sinst) => {
                    // Free operands whose last use is this instruction.
                    peir_inst_operands(sinst, &mut ops);
                    var oi2: i64 = 0;
                    while oi2 < ops.len() {
                        var op2: i64 = ops.get(oi2);
                        if op2 >= 0 && op2 < nvals && last_use.get(op2) == pos
                            && peir_recyclable(op2, def_block, n_use_blocks, a_use_block, nvals)
                            && assigned.get(op2) != -2 {
                            if assigned.get(op2) >= PEIR_REG_SLOT {
                                // the whole-function allocator owns its registers
                                if !global_ra { free_regs.push(assigned.get(op2) - PEIR_REG_SLOT); }
                            } else {
                                free_slots.push(assigned.get(op2));
                            }
                            last_use.set(op2, -1); // freed once
                            assigned.set(op2, -2);
                        }
                        oi2 = oi2 + 1;
                    }
                    ops.clear();
                    // Assign this inst's result (and TryUnwrap's ok_dst) a
                    // slot: pop a freed slot, or grow the frame. Recyclable
                    // values wider than 8 bytes get a permanent slot — pool
                    // slots are all 8-byte.
                    if siid >= 0 && siid < nvals && assigned.get(siid) == -2
                        && peir_recyclable(siid, def_block, n_use_blocks, a_use_block, nvals) {
                        var vsz: i64 = 8;
                        var in_reg: bool = false;
                        match IrFunction_get_meta(func, siid) {
                            OptValueMeta::Some(svm) => {
                                vsz = IrModule_type_size(module, svm.ty);
                                if vsz < 8 { vsz = 8; }
                                in_reg = no_reg.get(siid) == 0 && last_use.get(siid) >= 0
                                    && free_regs.len() > 0 && peir_reg_type(module, svm.ty);
                            }
                            OptValueMeta::None => {}
                        }
                        var off: i64 = 0;
                        if in_reg {
                            var taken: i64 = free_regs.get(free_regs.len() - 1);
                            free_regs.remove(free_regs.len() - 1);
                            if !peir_has_i64(used_regs, taken) { used_regs.push(taken); }
                            off = PEIR_REG_SLOT + taken;
                        } else if vsz <= 8 && free_slots.len() > 0 {
                            off = free_slots.get(free_slots.len() - 1);
                            free_slots.remove(free_slots.len() - 1);
                        } else {
                            off = PeStackFrame_alloc_raw(&mut frame, vsz);
                        }
                        frame.offsets.push(PeOffEnt { id: siid, offset: off });
                        assigned.set(siid, off);
                    }
                    match sinst {
                        Inst::TryUnwrap(_, okd2, _, _) => {
                            if okd2 >= 0 && okd2 < nvals && assigned.get(okd2) == -2
                                && peir_recyclable(okd2, def_block, n_use_blocks, a_use_block, nvals) {
                                var off2: i64 = 0;
                                if free_slots.len() > 0 {
                                    off2 = free_slots.get(free_slots.len() - 1);
                                    free_slots.remove(free_slots.len() - 1);
                                } else {
                                    off2 = PeStackFrame_alloc_raw(&mut frame, 8);
                                }
                                frame.offsets.push(PeOffEnt { id: okd2, offset: off2 });
                                assigned.set(okd2, off2);
                            }
                        }
                        _ => {}
                    }
                }
                OptInst::None => {}
            }
            pos = pos + 1;
            sii = sii + 1;
        }
        sbi = sbi + 1;
    }
    // Pre-allocate alloca data slots (insts is insertion-ordered by id)
    var ii: i64 = 0;
    while ii < func.insts.len() {
        var ve: ValueIdInst = func.insts.get(ii);
        match ve.inst {
            Inst::Alloca(ty, _) => {
                if !pe_idmap_has(&frame.reg_vars, ve.id) {
                    var data_size: i64 = IrModule_type_size(module, ty);
                    if data_size < 8 { data_size = 8; }
                    var aoff: i64 = PeStackFrame_alloc_raw(&mut frame, data_size);
                    pe_idmap_put(&mut frame.alloca_slots, ve.id, aoff);
                }
            }
            _ => {}
        }
        ii = ii + 1;
    }
    self.saved_regs = Vec::new();
    var ri: i64 = 0;
    while ri < PEIR_VALUE_REGS {
        if peir_has_i64(used_regs, ri) {
            self.saved_regs.push(PeOffEnt { id: peir_value_reg(ri), offset: PeStackFrame_alloc_raw(&mut frame, 8) });
        }
        ri = ri + 1;
    }
    // xmm6 and xmm7 are callee-saved, all 128 bits (id 100 + n)
    var xsave: i64 = 6;
    while xsave <= 7 {
        if peir_has_i64(used_regs, 0x100 + xsave) {
            self.saved_regs.push(PeOffEnt { id: 100 + xsave, offset: PeStackFrame_alloc_raw(&mut frame, 16) });
        }
        xsave = xsave + 1;
    }

    // The outgoing argument area of every call, reserved once: shadow space
    // and the widest call's stack arguments
    self.use_count = peir_zeros(nvals);
    var most_args: i64 = 0;
    var ui: i64 = 0;
    while ui < func.insts.len() {
        var uinst: Inst = func.insts.get(ui).inst;
        var uops: Vec<i64> = Vec::new();
        peir_inst_operands(uinst, &mut uops);
        var uo: i64 = 0;
        while uo < uops.len() {
            var u: i64 = uops.get(uo);
            if u >= 0 && u < nvals { self.use_count.set(u, self.use_count.get(u) + 1); }
            uo = uo + 1;
        }
        match uinst {
            Inst::Call(_, cargs, _, _) => { if cargs.len() + 1 > most_args { most_args = cargs.len() + 1; } }
            Inst::CallPtr(_, cargs, _, _, _) => { if cargs.len() + 1 > most_args { most_args = cargs.len() + 1; } }
            Inst::DynCall(_, _, cargs, _, _) => { if cargs.len() + 1 > most_args { most_args = cargs.len() + 1; } }
            _ => {}
        }
        ui = ui + 1;
    }
    var out_args: i64 = 0;
    if most_args > 4 { out_args = (most_args - 4) * 8; }
    self.calls_reserved = !func.is_interrupt;
    // Align stack to 16 bytes + 32 shadow space
    var stack_size: i64 = (frame.size + 32 + out_args + 15) & ~15;
    if stack_size < 64 { stack_size = 64; }
    PeirEnc_sub_rsp_i32(&mut self.enc, stack_size);

    // Stack probes: touch every page of the new frame top-down so Windows
    // commits it. Frames here are huge (one slot per IR value, no reuse),
    // so a single sub lands far below the guard page; without probing, the
    // next deep write or outgoing-arg push faults instead of growing the
    // stack. (Same job as __chkstk.)
    if stack_size > 4096 {
        var probe_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
        var probe_done: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RBP);
        PeirEnc_place_label(&mut self.enc, probe_loop);
        PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RSP);
        PeirEnc_jcc_label(&mut self.enc, 0x6, probe_done); // jbe: rax <= rsp
        PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_R11, PEIR_RAX); // touch page
        PeirEnc_jmp_label(&mut self.enc, probe_loop);
        PeirEnc_place_label(&mut self.enc, probe_done);
    }

    ri = 0;
    while ri < self.saved_regs.len() {
        var sr: PeOffEnt = self.saved_regs.get(ri);
        if sr.id >= 100 {
            PeirEnc_movdqu_mem_rbp_xmm(&mut self.enc, sr.offset, sr.id - 100);
        } else {
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, sr.offset, sr.id);
        }
        ri = ri + 1;
    }

    // Store params from registers
    var arg_regs: Vec<i64> = Vec::new();
    arg_regs.push(PEIR_RCX);
    arg_regs.push(PEIR_RDX);
    arg_regs.push(PEIR_R8);
    arg_regs.push(PEIR_R9);
    var pi: i64 = 0;
    while pi < func.params.len() {
        var param: ValueIdType = func.params.get(pi);
        if param.id >= 0 && param.id < self.use_count.len() && self.use_count.get(param.id) == 0 {
            // nothing reads it (a null environment, most often)
        } else if pi < 4 {
            var poff: i64 = PeStackFrame_offset(&frame, param.id);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, poff, arg_regs.get(pi));
        } else {
            var stack_offset: i64 = 48 + (pi - 4) * 8;
            var poff2: i64 = PeStackFrame_offset(&frame, param.id);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, stack_offset);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, poff2, PEIR_RAX);
        }
        pi = pi + 1;
    }

    // Pre-allocate block labels
    var bi: i64 = 0;
    while bi < func.blocks.len() {
        var block: BasicBlock = func.blocks.get(bi);
        var blabel: i64 = PeirEnc_alloc_label(&mut self.enc);
        HashMap_insert(self.block_labels, pe_block_key(name, block.id), blabel);
        bi = bi + 1;
    }

    // Block id -> index, for loop rotation
    var bindex: Vec<i64> = Vec::new();
    bi = 0;
    while bi < func.blocks.len() {
        var bid: i64 = func.blocks.get(bi).id;
        while bindex.len() <= bid { bindex.push(-1); }
        bindex.set(bid, bi);
        bi = bi + 1;
    }

    // Generate code for each basic block
    bi = 0;
    while bi < func.blocks.len() {
        var block2: BasicBlock = func.blocks.get(bi);
        var blabel2: i64 = HashMap_get(self.block_labels, pe_block_key(name, block2.id));
        PeirEnc_place_label(&mut self.enc, blabel2);

        self.pending_cmp_cc = -1;
        self.next_block = -1;
        if bi + 1 < func.blocks.len() {
            self.next_block = HashMap_get(self.block_labels, pe_block_key(name, func.blocks.get(bi + 1).id));
        }
        // Loop rotation (competitive OP11): a block that jumps back to a
        // loop header made only of the loop's test runs that test itself,
        // so each iteration takes one branch (to the body) instead of a
        // jump to the header and a branch out of it
        var ninsts: i64 = block2.instructions.len();
        var rot: i64 = -1;
        if PEIR_ROTATE && ninsts > 0 && use_regs {
            match IrFunction_get_inst(func, block2.instructions.get(ninsts - 1)) {
                OptInst::Some(lj) => {
                    match lj {
                        Inst::Jump(jt) => {
                            if jt >= 0 && jt < bindex.len() && bindex.get(jt) >= 0 && bindex.get(jt) < bi
                                && peir_rotatable(func, func.blocks.get(bindex.get(jt))) {
                                rot = bindex.get(jt);
                            }
                        }
                        _ => {}
                    }
                }
                OptInst::None => {}
            }
        }
        if rot >= 0 { ninsts = ninsts - 1; }
        PeirGen_gen_insts(self, block2.instructions, ninsts, &mut frame, func, module, name);
        if rot >= 0 {
            var hb: BasicBlock = func.blocks.get(rot);
            self.pending_cmp_cc = -1;
            PeirGen_gen_insts(self, hb.instructions, hb.instructions.len(), &mut frame, func, module, name);
        }
        bi = bi + 1;
    }

    // Epilogue (fallthrough safety)
    PeirGen_restore_regs(self);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
    // The inline Vec calls' cold paths, out of the hot code's way
    PeirGen_emit_cold(self, &mut frame);
}

/// The first `n` instructions of a block (a compare is fused with the
/// Branch after it).
fn PeirGen_gen_insts(self: &mut PeirGen, ids: Vec<i64>, n: i64, frame: &mut PeStackFrame, func: &IrFunction, module: &IrModule, name: str) -> void {
    var ii2: i64 = 0;
    while ii2 < n {
        var inst_id: i64 = ids.get(ii2);
        var next_cond: i64 = -1;
        if ii2 + 1 < ids.len() {
            match IrFunction_get_inst(func, ids.get(ii2 + 1)) {
                OptInst::Some(ninst) => {
                    match ninst {
                        Inst::Branch(c2, _, _) => { next_cond = c2; }
                        _ => {}
                    }
                }
                OptInst::None => {}
            }
        }
        match IrFunction_get_inst(func, inst_id) {
            OptInst::Some(inst) => {
                PeirGen_gen_inst(self, inst_id, inst, next_cond, frame, func, module, name);
            }
            OptInst::None => {}
        }
        ii2 = ii2 + 1;
    }
}

/// A loop header that only tests: a few loads, constants, integer
/// operations and `len` calls, then the Branch. Its code may run again at
/// the end of the loop's body (rotation): it writes nothing but its own
/// values.
fn peir_rotatable(func: &IrFunction, blk: BasicBlock) -> bool {
    var n: i64 = blk.instructions.len();
    if n == 0 || n > 12 { return false; }
    var i: i64 = 0;
    while i < n {
        match IrFunction_get_inst(func, blk.instructions.get(i)) {
            OptInst::Some(inst) => {
                var last: bool = i == n - 1;
                match inst {
                    Inst::Branch(_, _, _) => { if !last { return false; } }
                    Inst::Load(_, _) => { if last { return false; } }
                    Inst::ConstInt(_, _) => { if last { return false; } }
                    Inst::ConstBool(_) => { if last { return false; } }
                    Inst::BinOp(_, _, _, ty) => { if last || ir_type_is_float(ty) { return false; } }
                    Inst::Call(cn, _, _, _) => {
                        if last || !(cn == "Vec_len" || cn == "p_vec_len") { return false; }
                    }
                    _ => { return false; }
                }
            }
            OptInst::None => { return false; }
        }
        i = i + 1;
    }
    return true;
}

fn PeirGen_restore_regs(self: &mut PeirGen) -> void {
    var i: i64 = 0;
    while i < self.saved_regs.len() {
        var sr: PeOffEnt = self.saved_regs.get(i);
        if sr.id >= 100 {
            PeirEnc_movdqu_xmm_mem_rbp(&mut self.enc, sr.id - 100, sr.offset);
        } else {
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, sr.id, sr.offset);
        }
        i = i + 1;
    }
}

fn peir_has_i64(v: Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x { return true; }
        i = i + 1;
    }
    return false;
}

/// Whether a value of this type fits a register: everything is moved 64 bits
/// at a time, so a narrow integer does too.
fn peir_reg_type(module: &IrModule, ty: IrType) -> bool {
    if ir_type_is_float(ty) { return false; }
    match ty {
        IrType::Struct(_) => { return false; }
        IrType::Array(_, _) => { return false; }
        IrType::Void => { return false; }
        IrType::Never => { return false; }
        _ => {}
    }
    return IrModule_type_size(module, ty) <= 8;
}

/// Is `op` a call's null environment, which the generic call path loads as
/// an immediate? (Not a call the emitter inlines or prints through.)
fn peir_env_imm(module: &IrModule, callee: str, cargs: Vec<i64>, op: i64) -> bool {
    if cargs.len() == 0 || cargs.get(0) != op { return false; }
    if str_starts_with(callee, "Vec_") || callee == "print" || callee == "println" { return false; }
    var i: i64 = 1;
    while i < cargs.len() {
        if cargs.get(i) == op { return false; }
        i = i + 1;
    }
    match IrModule_get_function(module, callee) {
        OptIrFunction::Some(_) => { return true; }
        OptIrFunction::None => { return false; }
    }
}

fn peir_reg_word(module: &IrModule, ty: IrType) -> bool {
    return peir_reg_type(module, ty) && IrModule_type_size(module, ty) == 8;
}

fn peir_mark(v: &mut Vec<i64>, id: i64, n: i64) {
    if id >= 0 && id < n { v.set(id, 1); }
}

fn peir_value_float(func: &IrFunction, id: i64) -> bool {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => { return ir_type_is_float(m.ty); }
        OptValueMeta::None => { return false; }
    }
}

/// A call PeirGen_inline_vec_call writes in place: it reads its constant
/// arguments as immediates (load_operand), and its environment not at all.
fn peir_inline_vec_imm(module: &IrModule, callee: str, cargs: Vec<i64>) -> bool {
    var known: bool = false;
    match IrModule_get_function(module, callee) {
        OptIrFunction::Some(_) => { known = true; }
        OptIrFunction::None => {}
    }
    if !known { return false; }
    if callee == "Vec_len" { return cargs.len() >= 1; }
    if callee == "Vec_get" { return cargs.len() >= 2; }
    if callee == "Vec_set" { return cargs.len() >= 3; }
    if callee == "Vec_push" { return cargs.len() == 3; }
    return false;
}

fn peir_value_f64(func: &IrFunction, id: i64) -> bool {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => { return ir_type_eq(m.ty, IrType::F64); }
        OptValueMeta::None => { return false; }
    }
}

fn peir_value_word(func: &IrFunction, module: &IrModule, id: i64) -> bool {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => { return peir_reg_word(module, m.ty); }
        OptValueMeta::None => { return false; }
    }
}

fn peir_loop_back(index: Vec<i64>, depth: &mut Vec<i64>, target: i64, at: i64) {
    if target < 0 || target >= index.len() { return; }
    var head: i64 = index.get(target);
    if head >= 0 && head <= at {
        var d: i64 = head;
        while d <= at {
            depth.set(d, depth.get(d) + 1);
            d = d + 1;
        }
    }
}

// ===========================================================================
// Whole-function register allocation (release D4, D13)
//
// Linear scan over live intervals. The candidates are the word-sized SSA
// values a register can hold (the ones the per-block scheme took, and now
// also those that live across blocks and parameters) and the locals
// (allocas) every access of which is a whole-word load or store. Liveness
// is computed by the usual dataflow over the blocks (no phis: merges go
// through allocas), each candidate gets one interval [lo, hi] in layout
// order that covers every point where it is live, and the seven
// callee-saved value registers go to intervals by start; when none is
// free, the coldest interval (uses weighted by loop depth) is left in
// memory. A register value's frame offset is PEIR_REG_SLOT + r, so the
// emitting code is unchanged.
// ===========================================================================

const PEIR_GLOBAL_RA: bool = true;
/// Copy coalescing: a local's loads and stores share its register (OP16)
const PEIR_COALESCE: bool = true;
/// r10 and r11, and xmm2-xmm5, for values no call crosses (OP16)
const PEIR_VOLATILE_RA: bool = true;
/// f64 values and locals in xmm registers (OP17)
const PEIR_XMM_RA: bool = true;
/// Loop rotation: a loop's test copied to the end of its body (OP11)
const PEIR_ROTATE: bool = true;

/// What pick_reg_vars works out, for the allocator: per alloca its weight
/// + 1 when it is a candidate and whether it must stay in memory; per block
/// its loop depth; block id -> index.
pub struct PeirRaFacts {
    pub weight: Vec<i64>,
    pub bad: Vec<i64>,
    pub depth: Vec<i64>,
    pub index: Vec<i64>,
}

fn PeirRaFacts_new() -> PeirRaFacts {
    return PeirRaFacts { weight: Vec::new(), bad: Vec::new(), depth: Vec::new(), index: Vec::new() };
}

fn peir_bs_test(bs: &Vec<i64>, base: i64, k: i64) -> bool {
    return ((bs.get(base + k / 64) >> (k % 64)) & 1) != 0;
}

fn peir_bs_set(bs: &mut Vec<i64>, base: i64, k: i64) {
    var w: i64 = base + k / 64;
    bs.set(w, bs.get(w) | (1 << (k % 64)));
}

/// Whether an instruction's code leaves r10, r11 and xmm2-xmm5 alone (no
/// call, no use of them as scratch), so a value may stay in one across it.
fn peir_ra_volatile_safe(module: &IrModule, inst: Inst) -> bool {
    match inst {
        Inst::ConstInt(_, _) => { return true; }
        Inst::ConstBool(_) => { return true; }
        Inst::ConstNull(_) => { return true; }
        Inst::ConstFloat(_, _) => { return true; }
        Inst::ConstStr(_) => { return true; }
        Inst::ConstFnRef(_) => { return true; }
        Inst::GlobalAddr(_, _) => { return true; }
        Inst::BinOp(_, _, _, _) => { return true; }
        Inst::UnaryOp(_, _, _) => { return true; }
        Inst::Alloca(_, _) => { return true; }
        Inst::Load(_, ty) => { return peir_reg_type(module, ty) || ir_type_eq(ty, IrType::F64); }
        Inst::Store(_, _, sty) => {
            match sty {
                OptIrType::Some(t) => { return peir_reg_type(module, t) || ir_type_eq(t, IrType::F64); }
                OptIrType::None => { return true; }
            }
        }
        Inst::GetFieldPtr(_, _, _) => { return true; }
        Inst::GetElemPtr(_, _, _) => { return true; }
        Inst::IntExtend(_, _, _) => { return true; }
        Inst::IntTrunc(_, _, _) => { return true; }
        Inst::BitCast(_, _, _) => { return true; }
        Inst::IntToFloat(_, _, _) => { return true; }
        Inst::FloatToInt(_, _, _) => { return true; }
        Inst::Jump(_) => { return true; }
        Inst::Branch(_, _, _) => { return true; }
        Inst::Return(_) => { return true; }
        _ => { return false; }
    }
}

/// An instruction that reads its operands before it calls anything: a
/// value may end its life in a caller-saved register there. (At most four
/// arguments: a fifth goes to the stack through r10.)
fn peir_ra_reads_first(inst: Inst) -> bool {
    match inst {
        Inst::Call(_, args, _, _) => { return args.len() <= 4; }
        _ => { return false; }
    }
}

/// An instruction that writes its result after any call it makes.
fn peir_ra_writes_last(inst: Inst) -> bool {
    match inst {
        Inst::Call(_, _, _, _) => { return true; }
        Inst::CallPtr(_, _, _, _, _) => { return true; }
        _ => { return false; }
    }
}

/// Linear scan of the candidates with part[c] == 1 over `nregs` registers;
/// registers [0, nfixed) any candidate may get, the others (caller-saved)
/// only one with vok[c] == 1. A candidate prefers the register of hint[c]
/// when that is free where it starts. Returns per candidate its register
/// index or -1 (in memory).
fn peir_ra_scan(nc: i64, lo: &Vec<i64>, hi: &Vec<i64>, wt: &Vec<i64>, part: &Vec<i64>, vok: &Vec<i64>, hint: &Vec<i64>, nregs: i64, nfixed: i64, npos: i64) -> Vec<i64> {
    var reg_of: Vec<i64> = Vec::new();
    while reg_of.len() < nc { reg_of.push(-1); }
    var head: Vec<i64> = Vec::new();
    while head.len() < npos { head.push(-1); }
    var nxt: Vec<i64> = Vec::new();
    while nxt.len() < nc { nxt.push(-1); }
    var ci: i64 = nc - 1;
    while ci >= 0 {
        if part.get(ci) == 1 && hi.get(ci) >= lo.get(ci) && lo.get(ci) + 1 < npos {
            var slot: i64 = lo.get(ci) + 1;
            nxt.set(ci, head.get(slot));
            head.set(slot, ci);
        }
        ci = ci - 1;
    }
    var active: Vec<i64> = Vec::new();
    while active.len() < nregs { active.push(-1); }
    var p: i64 = 0;
    while p < npos {
        var cur: i64 = head.get(p);
        while cur >= 0 {
            var clo: i64 = lo.get(cur);
            var r: i64 = 0;
            while r < nregs {
                var a: i64 = active.get(r);
                // an operand whose last use is where `cur` is defined: read
                // before the result is written, so they may share
                if a >= 0 && hi.get(a) <= clo && !(lo.get(a) == -1 && clo == -1) { active.set(r, -1); }
                r = r + 1;
            }
            var can_vol: bool = vok.get(cur) == 1;
            var pick: i64 = -1;
            var h: i64 = hint.get(cur);
            if h >= 0 && reg_of.get(h) >= 0 {
                var hr: i64 = reg_of.get(h);
                if active.get(hr) < 0 && (hr < nfixed || can_vol) { pick = hr; }
            }
            if pick < 0 && can_vol {
                // a caller-saved register costs no save and restore
                r = nfixed;
                while r < nregs && pick < 0 {
                    if active.get(r) < 0 { pick = r; }
                    r = r + 1;
                }
            }
            r = 0;
            while r < nfixed && pick < 0 {
                if active.get(r) < 0 { pick = r; }
                r = r + 1;
            }
            if pick >= 0 {
                active.set(pick, cur);
                reg_of.set(cur, pick);
            } else {
                // The coldest of the active ones (and `cur`) stays in memory
                var worst: i64 = -1;
                r = 0;
                while r < nregs {
                    if r < nfixed || can_vol {
                        var a2: i64 = active.get(r);
                        if worst < 0 || wt.get(a2) < wt.get(active.get(worst))
                            || (wt.get(a2) == wt.get(active.get(worst)) && hi.get(a2) > hi.get(active.get(worst))) {
                            worst = r;
                        }
                    }
                    r = r + 1;
                }
                if worst >= 0 {
                    var victim: i64 = active.get(worst);
                    if wt.get(victim) < wt.get(cur) {
                        reg_of.set(victim, -1);
                        active.set(worst, cur);
                        reg_of.set(cur, worst);
                    }
                }
            }
            cur = nxt.get(cur);
        }
        p = p + 1;
    }
    return reg_of;
}

/// The xmm register of index i of the float register file: xmm6 and xmm7
/// (callee-saved), then xmm2-xmm5 (caller-saved).
fn peir_ra_xmm(i: i64) -> i64 {
    if i == 0 { return 6; }
    if i == 1 { return 7; }
    return i;
}

/// Is BinOp `op` of type `ty` one that int_binop_in_reg computes into its
/// result's register from the left operand?
fn peir_ra_in_reg_op(op: BinOp, ty: IrType) -> bool {
    if !ir_type_eq(ty, IrType::I64) { return false; }
    match op {
        BinOp::Add => { return true; }
        BinOp::Sub => { return true; }
        BinOp::Mul => { return true; }
        BinOp::BitAnd => { return true; }
        BinOp::BitOr => { return true; }
        BinOp::BitXor => { return true; }
        _ => { return false; }
    }
}

/// Allocate registers for the whole function; returns the value registers
/// used (0-8 the general ones, 0x100 + n xmm n). SSA values that got one
/// are in `in_reg` (1 + register); locals in frame.reg_vars.
fn peir_global_ra(func: &IrFunction, module: &IrModule, frame: &mut PeStackFrame, no_reg: &mut Vec<i64>, nvals: i64, facts: &PeirRaFacts, in_reg: &mut Vec<i64>) -> Vec<i64> {
    var nb: i64 = func.blocks.len();
    var used: Vec<i64> = Vec::new();
    if nb == 0 { return used; }
    var ops: Vec<i64> = Vec::new();
    // TryUnwrap's second result has a slot of its own
    var fl_bad: Vec<i64> = peir_zeros(nvals);
    var ii: i64 = 0;
    while ii < func.insts.len() {
        match func.insts.get(ii).inst {
            Inst::TryUnwrap(_, okd, _, _) => { peir_mark(no_reg, okd, nvals); peir_mark(&mut fl_bad, okd, nvals); }
            _ => {}
        }
        ii = ii + 1;
    }
    // Candidates: value id -> candidate index, whether it is a local, and
    // whether it is an f64 (the xmm file)
    var cidx: Vec<i64> = Vec::new();
    while cidx.len() < nvals { cidx.push(-1); }
    var cand: Vec<i64> = Vec::new();
    var is_local: Vec<i64> = Vec::new();
    var is_flt: Vec<i64> = Vec::new();
    var defined: Vec<i64> = peir_zeros(nvals);
    var b: i64 = 0;
    while b < nb {
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < nvals {
                match IrFunction_get_inst(func, id) {
                    OptInst::Some(inst) => {
                        match inst {
                            Inst::Alloca(ty, _) => {
                                if facts.weight.len() > id && facts.weight.get(id) != 0 && facts.bad.get(id) == 0 && cidx.get(id) < 0 {
                                    if peir_reg_word(module, ty) {
                                        cidx.set(id, cand.len());
                                        cand.push(id);
                                        is_local.push(1);
                                        is_flt.push(0);
                                    } else if PEIR_XMM_RA && ir_type_eq(ty, IrType::F64) {
                                        cidx.set(id, cand.len());
                                        cand.push(id);
                                        is_local.push(1);
                                        is_flt.push(1);
                                    }
                                }
                            }
                            _ => {
                                if defined.get(id) == 0 && cidx.get(id) < 0 {
                                    match IrFunction_get_meta(func, id) {
                                        OptValueMeta::Some(vm) => {
                                            if no_reg.get(id) == 0 && peir_reg_type(module, vm.ty) {
                                                cidx.set(id, cand.len());
                                                cand.push(id);
                                                is_local.push(0);
                                                is_flt.push(0);
                                            } else if PEIR_XMM_RA && ir_type_eq(vm.ty, IrType::F64) && fl_bad.get(id) == 0 {
                                                cidx.set(id, cand.len());
                                                cand.push(id);
                                                is_local.push(0);
                                                is_flt.push(1);
                                            }
                                        }
                                        OptValueMeta::None => {}
                                    }
                                }
                            }
                        }
                        defined.set(id, 1);
                    }
                    OptInst::None => {}
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var pi: i64 = 0;
    while pi < func.params.len() {
        var prm: ValueIdType = func.params.get(pi);
        if prm.id >= 0 && prm.id < nvals && cidx.get(prm.id) < 0 {
            if no_reg.get(prm.id) == 0 && peir_reg_word(module, prm.ty) {
                cidx.set(prm.id, cand.len());
                cand.push(prm.id);
                is_local.push(0);
                is_flt.push(0);
            } else if PEIR_XMM_RA && ir_type_eq(prm.ty, IrType::F64) && fl_bad.get(prm.id) == 0 {
                cidx.set(prm.id, cand.len());
                cand.push(prm.id);
                is_local.push(0);
                is_flt.push(1);
            }
        }
        pi = pi + 1;
    }
    var nc: i64 = cand.len();
    if nc == 0 { return used; }
    var nw: i64 = (nc + 63) / 64;
    // Per block: upward-exposed uses and definitions; positions and weights
    var use_bs: Vec<i64> = peir_zeros(nb * nw);
    var def_bs: Vec<i64> = peir_zeros(nb * nw);
    var lo: Vec<i64> = Vec::new();
    var hi: Vec<i64> = Vec::new();
    var wt: Vec<i64> = peir_zeros(nc);
    var ci: i64 = 0;
    while ci < nc { lo.push(1 << 60); hi.push(-2); ci = ci + 1; }
    var bstart: Vec<i64> = peir_zeros(nb);
    var bend: Vec<i64> = peir_zeros(nb);
    // For coalescing: where a candidate is defined, which local it was
    // loaded from, its operands, its uses; every load and store of a local
    var def_pos: Vec<i64> = Vec::new();
    var def_blk: Vec<i64> = Vec::new();
    var ld_from: Vec<i64> = Vec::new();
    var bin_l: Vec<i64> = Vec::new();
    var bin_r: Vec<i64> = Vec::new();
    var hint: Vec<i64> = Vec::new();
    var nuse: Vec<i64> = peir_zeros(nc);
    ci = 0;
    while ci < nc {
        def_pos.push(-1);
        def_blk.push(-1);
        ld_from.push(-1);
        bin_l.push(-1);
        bin_r.push(-1);
        hint.push(-1);
        ci = ci + 1;
    }
    var ld_pos: Vec<i64> = Vec::new();
    var ld_loc: Vec<i64> = Vec::new();
    var ld_val: Vec<i64> = Vec::new();
    var st_pos: Vec<i64> = Vec::new();
    var st_loc: Vec<i64> = Vec::new();
    var st_val: Vec<i64> = Vec::new();
    // Per position: whether a caller-saved register survives the
    // instruction, may end its life there, or start it there
    var p_safe: Vec<i64> = Vec::new();
    var p_hi_ok: Vec<i64> = Vec::new();
    var p_lo_ok: Vec<i64> = Vec::new();
    // Parameters are defined before the first instruction (position -1)
    pi = 0;
    while pi < func.params.len() {
        var pid: i64 = func.params.get(pi).id;
        if pid >= 0 && pid < nvals && cidx.get(pid) >= 0 {
            var pk: i64 = cidx.get(pid);
            peir_bs_set(&mut def_bs, 0, pk);
            lo.set(pk, -1);
            if hi.get(pk) < -1 { hi.set(pk, -1); }
        }
        pi = pi + 1;
    }
    var pos: i64 = 0;
    b = 0;
    while b < nb {
        bstart.set(b, pos);
        var cost: i64 = 1;
        var c: i64 = 0;
        while c < facts.depth.get(b) && c < 4 {
            cost = cost * 10;
            c = c + 1;
        }
        var base: i64 = b * nw;
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            var safe: bool = false;
            var hi_ok: bool = false;
            var lo_ok: bool = false;
            match IrFunction_get_inst(func, id) {
                OptInst::Some(inst) => {
                    safe = peir_ra_volatile_safe(module, inst);
                    hi_ok = safe || peir_ra_reads_first(inst);
                    lo_ok = safe || peir_ra_writes_last(inst);
                    // The local a Store writes is defined, not read
                    var stored: i64 = -1;
                    match inst {
                        Inst::Store(sptr, svalue, _) => {
                            if sptr >= 0 && sptr < nvals && sptr != svalue && cidx.get(sptr) >= 0 && is_local.get(cidx.get(sptr)) == 1 {
                                stored = sptr;
                                st_pos.push(pos);
                                st_loc.push(cidx.get(sptr));
                                st_val.push(svalue);
                            }
                        }
                        Inst::Load(lptr, _) => {
                            if lptr >= 0 && lptr < nvals && cidx.get(lptr) >= 0 && is_local.get(cidx.get(lptr)) == 1 {
                                var lk: i64 = -1;
                                if id >= 0 && id < nvals && cidx.get(id) >= 0 && is_local.get(cidx.get(id)) == 0 {
                                    lk = cidx.get(id);
                                    ld_from.set(lk, cidx.get(lptr));
                                }
                                ld_pos.push(pos);
                                ld_loc.push(cidx.get(lptr));
                                ld_val.push(lk);
                            }
                        }
                        Inst::BinOp(bop, bl, br, bty) => {
                            if id >= 0 && id < nvals && cidx.get(id) >= 0 && is_local.get(cidx.get(id)) == 0 {
                                var bk: i64 = cidx.get(id);
                                if bl >= 0 && bl < nvals && cidx.get(bl) >= 0 && is_flt.get(cidx.get(bl)) == is_flt.get(bk) {
                                    hint.set(bk, cidx.get(bl));
                                }
                                if peir_ra_in_reg_op(bop, bty) && bl >= 0 && bl < nvals && cidx.get(bl) >= 0 {
                                    bin_l.set(bk, cidx.get(bl));
                                    if br >= 0 && br < nvals && cidx.get(br) >= 0 { bin_r.set(bk, cidx.get(br)); }
                                    else { bin_r.set(bk, -2); }
                                }
                            }
                        }
                        _ => {}
                    }
                    ops.clear();
                    peir_inst_operands(inst, &mut ops);
                    var o: i64 = 0;
                    while o < ops.len() {
                        var op: i64 = ops.get(o);
                        if op >= 0 && op < nvals && op != stored && cidx.get(op) >= 0 {
                            var ck: i64 = cidx.get(op);
                            if !peir_bs_test(&def_bs, base, ck) { peir_bs_set(&mut use_bs, base, ck); }
                            if pos < lo.get(ck) { lo.set(ck, pos); }
                            if pos > hi.get(ck) { hi.set(ck, pos); }
                            wt.set(ck, wt.get(ck) + cost);
                            nuse.set(ck, nuse.get(ck) + 1);
                        }
                        o = o + 1;
                    }
                    var dv: i64 = stored;
                    if dv < 0 && id >= 0 && id < nvals && cidx.get(id) >= 0 && is_local.get(cidx.get(id)) == 0 { dv = id; }
                    if dv >= 0 {
                        var dk: i64 = cidx.get(dv);
                        peir_bs_set(&mut def_bs, base, dk);
                        if pos < lo.get(dk) { lo.set(dk, pos); }
                        if pos > hi.get(dk) { hi.set(dk, pos); }
                        wt.set(dk, wt.get(dk) + cost);
                        if dv == id {
                            def_pos.set(dk, pos);
                            def_blk.set(dk, b);
                        }
                    }
                }
                OptInst::None => {}
            }
            if safe { p_safe.push(1); } else { p_safe.push(0); }
            if hi_ok { p_hi_ok.push(1); } else { p_hi_ok.push(0); }
            if lo_ok { p_lo_ok.push(1); } else { p_lo_ok.push(0); }
            pos = pos + 1;
            k = k + 1;
        }
        bend.set(b, pos - 1);
        b = b + 1;
    }
    // Successors
    var succ_a: Vec<i64> = Vec::new();
    var succ_b: Vec<i64> = Vec::new();
    b = 0;
    while b < nb {
        var sa: i64 = -1;
        var sb: i64 = -1;
        var ids2: Vec<i64> = func.blocks.get(b).instructions;
        if ids2.len() > 0 {
            match IrFunction_get_inst(func, ids2.get(ids2.len() - 1)) {
                OptInst::Some(last) => {
                    match last {
                        Inst::Jump(t) => { if t >= 0 && t < facts.index.len() { sa = facts.index.get(t); } }
                        Inst::Branch(_, t, e) => {
                            if t >= 0 && t < facts.index.len() { sa = facts.index.get(t); }
                            if e >= 0 && e < facts.index.len() { sb = facts.index.get(e); }
                        }
                        _ => {}
                    }
                }
                OptInst::None => {}
            }
        }
        succ_a.push(sa);
        succ_b.push(sb);
        b = b + 1;
    }
    // Liveness: in = use | (out & ~def), out = the ins of the successors
    var live_in: Vec<i64> = peir_zeros(nb * nw);
    var live_out: Vec<i64> = peir_zeros(nb * nw);
    var changed: bool = true;
    while changed {
        changed = false;
        b = nb - 1;
        while b >= 0 {
            var base2: i64 = b * nw;
            var sa2: i64 = succ_a.get(b);
            var sb2: i64 = succ_b.get(b);
            var w: i64 = 0;
            while w < nw {
                var out: i64 = 0;
                if sa2 >= 0 { out = out | live_in.get(sa2 * nw + w); }
                if sb2 >= 0 { out = out | live_in.get(sb2 * nw + w); }
                live_out.set(base2 + w, out);
                var inw: i64 = use_bs.get(base2 + w) | (out & ~def_bs.get(base2 + w));
                if inw != live_in.get(base2 + w) {
                    live_in.set(base2 + w, inw);
                    changed = true;
                }
                w = w + 1;
            }
            b = b - 1;
        }
    }
    // Intervals: every point of a block a candidate is live through
    b = 0;
    while b < nb {
        var base3: i64 = b * nw;
        var w2: i64 = 0;
        while w2 < nw {
            var lin: i64 = live_in.get(base3 + w2);
            var lout: i64 = live_out.get(base3 + w2);
            if lin != 0 || lout != 0 {
                var bit: i64 = 0;
                while bit < 64 {
                    var ck2: i64 = w2 * 64 + bit;
                    if ck2 < nc {
                        if ((lin >> bit) & 1) != 0 {
                            if bstart.get(b) < lo.get(ck2) { lo.set(ck2, bstart.get(b)); }
                            if bstart.get(b) > hi.get(ck2) { hi.set(ck2, bstart.get(b)); }
                        }
                        if ((lout >> bit) & 1) != 0 {
                            if bend.get(b) > hi.get(ck2) { hi.set(ck2, bend.get(b)); }
                        }
                    }
                    bit = bit + 1;
                }
            }
            w2 = w2 + 1;
        }
        b = b + 1;
    }
    // ── Copy coalescing (competitive OP16) ──
    // A local A in a register and the SSA values that only copy it share
    // its register, so the moves disappear:
    //  - a Load of A whose value lives in the block, while nothing stores
    //    to A (it holds A's contents);
    //  - a value stored into A, defined in that block, while A's old
    //    contents are dead from its definition to the store (it holds A's
    //    next contents);
    //  - the left operand of such a value's add/sub/mul/and/or/xor when that
    //    is its only use (computed in place: `add rA, x`).
    // Members are left out of the scan; A's interval covers theirs.
    var alias: Vec<i64> = Vec::new();
    var root: Vec<i64> = Vec::new();
    ci = 0;
    while ci < nc { alias.push(-1); root.push(-1); ci = ci + 1; }
    if PEIR_COALESCE {
        // Loads
        ci = 0;
        while ci < nc {
            var la: i64 = ld_from.get(ci);
            if la >= 0 && is_flt.get(la) == is_flt.get(ci) && lo.get(ci) == def_pos.get(ci) && def_blk.get(ci) >= 0
                && hi.get(ci) >= lo.get(ci) && hi.get(ci) <= bend.get(def_blk.get(ci)) {
                var ok: bool = true;
                var si: i64 = 0;
                while si < st_pos.len() && ok {
                    if st_loc.get(si) == la && st_pos.get(si) > lo.get(ci) && st_pos.get(si) <= hi.get(ci)
                        && st_val.get(si) != cand.get(ci) {
                        ok = false;
                    }
                    si = si + 1;
                }
                if ok { alias.set(ci, la); }
            }
            ci = ci + 1;
        }
        // Stores, in order
        var sj: i64 = 0;
        while sj < st_pos.len() {
            var a0: i64 = st_loc.get(sj);
            var sv: i64 = st_val.get(sj);
            var s0: i64 = st_pos.get(sj);
            if sv >= 0 && sv < nvals && cidx.get(sv) >= 0 {
                var wk: i64 = cidx.get(sv);
                var cur: i64 = wk;
                var first: bool = true;
                while cur >= 0 {
                    var ok2: bool = is_local.get(cur) == 0 && alias.get(cur) < 0 && is_flt.get(cur) == is_flt.get(a0)
                        && def_blk.get(cur) >= 0 && lo.get(cur) == def_pos.get(cur) && lo.get(cur) < s0
                        && s0 <= bend.get(def_blk.get(cur)) && s0 >= bstart.get(def_blk.get(cur))
                        && hi.get(cur) <= bend.get(def_blk.get(cur));
                    if ok2 && !first {
                        // the operand of the previous member, used only there
                        ok2 = nuse.get(cur) == 1;
                    }
                    if ok2 && first {
                        // no other store to A while it lives
                        var t: i64 = 0;
                        while t < st_pos.len() && ok2 {
                            if t != sj && st_loc.get(t) == a0 && st_pos.get(t) > lo.get(cur) && st_pos.get(t) <= hi.get(cur) { ok2 = false; }
                            t = t + 1;
                        }
                    }
                    if ok2 {
                        // A's old contents are dead in (lo, s0): no load of A
                        // there, and no member of A alive there
                        var t2: i64 = 0;
                        while t2 < ld_pos.len() && ok2 {
                            if ld_loc.get(t2) == a0 && ld_pos.get(t2) > lo.get(cur) && ld_pos.get(t2) < s0 { ok2 = false; }
                            t2 = t2 + 1;
                        }
                        var m: i64 = 0;
                        while m < nc && ok2 {
                            if alias.get(m) == a0 && root.get(m) != sj
                                && !(hi.get(m) <= lo.get(cur) || lo.get(m) >= s0) { ok2 = false; }
                            m = m + 1;
                        }
                    }
                    if !ok2 { break; }
                    alias.set(cur, a0);
                    root.set(cur, sj);
                    first = false;
                    // The left operand of a value computed in place
                    var nl: i64 = bin_l.get(cur);
                    var nr: i64 = bin_r.get(cur);
                    if nl < 0 || nl == a0 || (nr >= 0 && (nr == a0 || alias.get(nr) == a0)) { break; }
                    if hi.get(nl) != lo.get(cur) || def_blk.get(nl) != def_blk.get(cur) { break; }
                    cur = nl;
                }
            }
            sj = sj + 1;
        }
    }
    // A's interval and weight take in its members'
    var olo: Vec<i64> = Vec::new();
    var ohi: Vec<i64> = Vec::new();
    var owt: Vec<i64> = Vec::new();
    ci = 0;
    while ci < nc { olo.push(lo.get(ci)); ohi.push(hi.get(ci)); owt.push(wt.get(ci)); ci = ci + 1; }
    ci = 0;
    while ci < nc {
        var al: i64 = alias.get(ci);
        if al >= 0 {
            if lo.get(ci) < lo.get(al) { lo.set(al, lo.get(ci)); }
            if hi.get(ci) > hi.get(al) { hi.set(al, hi.get(ci)); }
            wt.set(al, wt.get(al) + wt.get(ci));
        }
        ci = ci + 1;
    }
    var npos: i64 = pos + 2;
    // Unsafe positions, counted from the start: an interval may use a
    // caller-saved register when none lies inside it
    var unsafe_before: Vec<i64> = Vec::new();
    var cnt: i64 = 0;
    var q: i64 = 0;
    while q < p_safe.len() {
        unsafe_before.push(cnt);
        if p_safe.get(q) == 0 { cnt = cnt + 1; }
        q = q + 1;
    }
    unsafe_before.push(cnt);
    var reg_gp: Vec<i64> = Vec::new();
    var reg_x: Vec<i64> = Vec::new();
    var round: i64 = 0;
    while round < 3 {
        var vok: Vec<i64> = peir_zeros(nc);
        var part_gp: Vec<i64> = peir_zeros(nc);
        var part_x: Vec<i64> = peir_zeros(nc);
        ci = 0;
        while ci < nc {
            if alias.get(ci) < 0 && !(lo.get(ci) == -1 && hi.get(ci) == -1 && nuse.get(ci) == 0) {
                if is_flt.get(ci) == 1 { part_x.set(ci, 1); } else { part_gp.set(ci, 1); }
                var l0: i64 = lo.get(ci);
                var h0: i64 = hi.get(ci);
                if PEIR_VOLATILE_RA && h0 >= l0 && h0 < p_safe.len() {
                    var good: bool = true;
                    if l0 >= 0 && p_lo_ok.get(l0) == 0 { good = false; }
                    if h0 > l0 && p_hi_ok.get(h0) == 0 { good = false; }
                    var from: i64 = l0 + 1;
                    if from < 0 { from = 0; }
                    if h0 > from && unsafe_before.get(h0) - unsafe_before.get(from) > 0 { good = false; }
                    if good { vok.set(ci, 1); }
                }
            }
            ci = ci + 1;
        }
        reg_gp = peir_ra_scan(nc, &lo, &hi, &wt, &part_gp, &vok, &hint, PEIR_ALL_REGS, PEIR_VALUE_REGS, npos);
        reg_x = peir_ra_scan(nc, &lo, &hi, &wt, &part_x, &vok, &hint, 6, 2, npos);
        // A local left in memory: its members get registers of their own
        var again: bool = false;
        ci = 0;
        while ci < nc {
            var al2: i64 = alias.get(ci);
            if al2 >= 0 && reg_gp.get(al2) < 0 && reg_x.get(al2) < 0 {
                alias.set(ci, -1);
                lo.set(al2, olo.get(al2));
                hi.set(al2, ohi.get(al2));
                wt.set(al2, owt.get(al2));
                again = true;
            }
            ci = ci + 1;
        }
        if !again { break; }
        // the locals that kept members take them in again
        ci = 0;
        while ci < nc {
            var al3: i64 = alias.get(ci);
            if al3 >= 0 {
                if lo.get(ci) < lo.get(al3) { lo.set(al3, lo.get(ci)); }
                if hi.get(ci) > hi.get(al3) { hi.set(al3, hi.get(ci)); }
            }
            ci = ci + 1;
        }
        round = round + 1;
    }
    // Results
    ci = 0;
    while ci < nc {
        var owner: i64 = ci;
        if alias.get(ci) >= 0 { owner = alias.get(ci); }
        var slotreg: i64 = -1;
        if is_flt.get(ci) == 1 {
            if reg_x.get(owner) >= 0 { slotreg = 0x100 + peir_ra_xmm(reg_x.get(owner)); }
        } else if reg_gp.get(owner) >= 0 {
            slotreg = reg_gp.get(owner);
        }
        if slotreg >= 0 {
            var v: i64 = cand.get(ci);
            if is_local.get(ci) == 1 {
                pe_idmap_put(&mut frame.reg_vars, v, PEIR_REG_SLOT + slotreg);
            } else {
                in_reg.set(v, slotreg + 1);
            }
            peir_mark(no_reg, v, nvals);
            if !peir_has_i64(used, slotreg) { used.push(slotreg); }
        }
        ci = ci + 1;
    }
    return used;
}

/// src/pe.rs pick_reg_vars: the locals worth a register, most used first.
fn peir_pick_reg_vars(func: &IrFunction, module: &IrModule, frame: &mut PeStackFrame, no_reg: &mut Vec<i64>, nvals: i64, limit: i64, out: &mut PeirRaFacts) -> Vec<i64> {
    var nb: i64 = func.blocks.len();
    var max_id: i64 = 0;
    var b: i64 = 0;
    while b < nb {
        if func.blocks.get(b).id > max_id { max_id = func.blocks.get(b).id; }
        b = b + 1;
    }
    var index: Vec<i64> = Vec::new();
    while index.len() <= max_id { index.push(-1); }
    b = 0;
    while b < nb {
        index.set(func.blocks.get(b).id, b);
        b = b + 1;
    }
    var depth: Vec<i64> = peir_zeros(nb);
    b = 0;
    while b < nb {
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        if ids.len() > 0 {
            match IrFunction_get_inst(func, ids.get(ids.len() - 1)) {
                OptInst::Some(last) => {
                    match last {
                        Inst::Jump(t) => { peir_loop_back(index, &mut depth, t, b); }
                        Inst::Branch(_, t, e) => {
                            peir_loop_back(index, &mut depth, t, b);
                            peir_loop_back(index, &mut depth, e, b);
                        }
                        _ => {}
                    }
                }
                OptInst::None => {}
            }
        }
        b = b + 1;
    }
    // Per value: weight + 1 when it is a candidate, and whether it must stay in memory
    var weight: Vec<i64> = peir_zeros(nvals);
    var bad: Vec<i64> = peir_zeros(nvals);
    b = 0;
    while b < nb {
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            match IrFunction_get_inst(func, id) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::Alloca(ty, _) => {
                            if (peir_reg_word(module, ty) || (PEIR_XMM_RA && PEIR_GLOBAL_RA && limit == 0 && ir_type_eq(ty, IrType::F64))) && id < nvals { weight.set(id, 1); }
                        }
                        _ => {}
                    }
                }
                OptInst::None => {}
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var ops: Vec<i64> = Vec::new();
    b = 0;
    while b < nb {
        var cost: i64 = 1;
        var c: i64 = 0;
        while c < depth.get(b) && c < 4 {
            cost = cost * 10;
            c = c + 1;
        }
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            match IrFunction_get_inst(func, id) {
                OptInst::Some(inst) => {
                    // Float instructions read and write their slots directly
                    match inst {
                        Inst::BinOp(_, left, right, ty) => {
                            if ir_type_is_float(ty) || peir_value_float(func, left) {
                                peir_mark(no_reg, left, nvals);
                                peir_mark(no_reg, right, nvals);
                                peir_mark(no_reg, id, nvals);
                            }
                        }
                        Inst::UnaryOp(_, operand, ty) => {
                            if ir_type_is_float(ty) {
                                peir_mark(no_reg, operand, nvals);
                                peir_mark(no_reg, id, nvals);
                            }
                        }
                        Inst::FloatToInt(value, _, _) => { peir_mark(no_reg, value, nvals); }
                        Inst::IntToFloat(_, _, _) => { peir_mark(no_reg, id, nvals); }
                        _ => {}
                    }
                    ops.clear();
                    peir_inst_operands(inst, &mut ops);
                    var o: i64 = 0;
                    while o < ops.len() {
                        var op: i64 = ops.get(o);
                        if op >= 0 && op < nvals && weight.get(op) != 0 {
                            var whole: bool = false;
                            match inst {
                                Inst::Load(ptr, ty) => {
                                    whole = ptr == op && (peir_reg_word(module, ty) || (PEIR_XMM_RA && PEIR_GLOBAL_RA && ir_type_eq(ty, IrType::F64)));
                                }
                                Inst::Store(ptr, value, sty) => {
                                    var fval: bool = PEIR_XMM_RA && PEIR_GLOBAL_RA && peir_value_f64(func, value);
                                    whole = ptr == op && value != op && (peir_value_word(func, module, value) || fval);
                                    match sty {
                                        OptIrType::Some(t) => {
                                            if !peir_reg_word(module, t) && !(fval && ir_type_eq(t, IrType::F64)) { whole = false; }
                                        }
                                        OptIrType::None => {}
                                    }
                                }
                                _ => {}
                            }
                            if whole {
                                weight.set(op, weight.get(op) + cost);
                            } else {
                                bad.set(op, 1);
                            }
                        }
                        o = o + 1;
                    }
                }
                OptInst::None => {}
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var taken: Vec<i64> = Vec::new();
    // The analysis, for the whole-function allocator
    out.weight = weight;
    out.bad = bad;
    out.depth = depth;
    out.index = index;
    while taken.len() < limit {
        var best: i64 = -1;
        var best_w: i64 = 3;
        var ii: i64 = 0;
        while ii < func.insts.len() {
            var id: i64 = func.insts.get(ii).id;
            if id < nvals && bad.get(id) == 0 && weight.get(id) - 1 >= best_w {
                if best < 0 || weight.get(id) - 1 > best_w {
                    best = id;
                    best_w = weight.get(id) - 1;
                }
            }
            ii = ii + 1;
        }
        if best < 0 { break; }
        pe_idmap_put(&mut frame.reg_vars, best, PEIR_REG_SLOT + taken.len());
        peir_mark(no_reg, best, nvals);
        bad.set(best, 1);
        taken.push(taken.len());
    }
    // Constants read only as immediates, in their own block, need no slot.
    // const_block: block + 1 while a value may be one.
    var const_block: Vec<i64> = peir_zeros(nvals);
    var const_used: Vec<i64> = peir_zeros(nvals);
    b = 0;
    while b < nb {
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            match IrFunction_get_inst(func, id) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::ConstInt(_, _) => { if id < nvals { const_block.set(id, b + 1); } }
                        _ => {}
                    }
                }
                OptInst::None => {}
            }
            k = k + 1;
        }
        b = b + 1;
    }
    b = 0;
    while b < nb {
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            match IrFunction_get_inst(func, ids.get(k)) {
                OptInst::Some(inst) => {
                    ops.clear();
                    peir_inst_operands(inst, &mut ops);
                    var o: i64 = 0;
                    while o < ops.len() {
                        var op: i64 = ops.get(o);
                        if op >= 0 && op < nvals {
                            const_used.set(op, 1);
                            var imm: bool = false;
                            match inst {
                                Inst::BinOp(_, left, _, ty) => {
                                    imm = !ir_type_is_float(ty) && !peir_value_float(func, left);
                                }
                                Inst::Store(ptr, value, _) => {
                                    imm = value == op && pe_idmap_has(&frame.reg_vars, ptr);
                                }
                                // A call's null environment: the generic call
                                // path loads constant arguments as immediates
                                Inst::Call(callee, cargs, _, _) => {
                                    imm = peir_env_imm(module, callee, cargs, op) || peir_inline_vec_imm(module, callee, cargs);
                                }
                                _ => {}
                            }
                            if !imm || const_block.get(op) != b + 1 { const_block.set(op, 0); }
                        }
                        o = o + 1;
                    }
                }
                OptInst::None => {}
            }
            k = k + 1;
        }
        b = b + 1;
    }
    frame.imm_only = peir_zeros(nvals);
    var ci: i64 = 0;
    while ci < nvals {
        if const_block.get(ci) != 0 && const_used.get(ci) != 0 {
            frame.imm_only.set(ci, 1);
            no_reg.set(ci, 1);
        }
        ci = ci + 1;
    }
    return taken;
}

/// src/pe.rs div_magic: [multiplier, shift] of a signed division by d >= 2.
@wrapping fn peir_div_magic(d0: i64) -> Vec<i64> {
    var d: u64 = d0 as u64;
    var two63: u64 = 0x8000000000000000;
    var anc: u64 = two63 - 1 - two63 % d;
    var p: i64 = 63;
    var q1: u64 = two63 / anc;
    var r1: u64 = two63 - q1 * anc;
    var q2: u64 = two63 / d;
    var r2: u64 = two63 - q2 * d;
    while true {
        p = p + 1;
        q1 = q1 * 2;
        r1 = r1 * 2;
        if r1 >= anc {
            q1 = q1 + 1;
            r1 = r1 - anc;
        }
        q2 = q2 * 2;
        r2 = r2 * 2;
        if r2 >= d {
            q2 = q2 + 1;
            r2 = r2 - d;
        }
        var delta: u64 = d - r2;
        if !(q1 < delta || (q1 == delta && r1 == 0)) { break; }
    }
    var out: Vec<i64> = Vec::new();
    out.push((q2 + 1) as i64);
    out.push(p - 64);
    return out;
}

// ===========================================================================
// PeirGen::gen_inst (src/pe.rs) — code for a single instruction
// ===========================================================================

/// Emit the autograd call shared by GradBegin / GradEnd / Backward.
fn PeirGen_gen_autograd(self: &mut PeirGen, inst: Inst, nargs: i64) -> void {
    // Autograd, as in the C backend: start/stop recording the
    // tape, run the backward pass (loss argument: NULL)
    var builtin: str = pe_ir_autograd_builtin(inst);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirGen_call_builtin(self, builtin, nargs);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
}

/// Generate code for a single instruction.
pub fn PeirGen_gen_inst(
    self: &mut PeirGen,
    id: i64,
    inst: Inst,
    next_cond: i64,
    frame: &mut PeStackFrame,
    func: &IrFunction,
    module: &IrModule,
    func_name: str,
) -> void {
    var dst: i64 = PeStackFrame_offset(frame, id);
    self.cur_unchecked = id < self.unchecked.len() && (self.unchecked.get(id) & 1) != 0;

    match inst {
        // --- Constants ---
        Inst::ConstInt(value, _) => {
            if id < frame.imm_only.len() && frame.imm_only.get(id) != 0 {
                pe_idmap_put(&mut frame.const_vals, id, value);
                return;
            }
            // straight into its register (competitive OP19)
            if dst >= PEIR_REG_SLOT && !peir_is_xmm_slot(dst) {
                PeirEnc_mov_imm(&mut self.enc, peir_value_reg(dst - PEIR_REG_SLOT), value);
            } else {
                PeirEnc_mov_imm(&mut self.enc, PEIR_RAX, value);
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            }
            pe_idmap_put(&mut frame.const_vals, id, value);
        }

        Inst::ConstBool(value) => {
            var v8: i64 = 0;
            if value { v8 = 1; }
            if dst >= PEIR_REG_SLOT && !peir_is_xmm_slot(dst) {
                PeirEnc_mov_imm(&mut self.enc, peir_value_reg(dst - PEIR_REG_SLOT), v8);
            } else {
                PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, v8);
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            }
        }

        Inst::ConstStr(value) => {
            // Always a string, even one spelling a function's name (the
            // string "main" was emitted as the address of fn main):
            // function values are ConstFnRef.
            var off: i64 = PeirGen_str_off(self, value);
            PeirEnc_lea_rip(&mut self.enc, PEIR_RAX, off);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::ConstFnRef(name) => {
            // Function reference — resolve to function label address
            if HashMap_contains(self.func_labels, name) {
                var flabel: i64 = HashMap_get(self.func_labels, name);
                PeirEnc_lea_label(&mut self.enc, PEIR_RAX, flabel);
            } else {
                PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0);
            }
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::ConstFloat(value, ty) => {
            // ConstFloat stores the f64 value; Rust emits `bits as u32` for
            // F32 (the low 32 bits of the f64 bit pattern) and the full
            // bits for F64.
            if ir_type_eq(ty, IrType::F32) {
                var bits32: i64 = p_f64_to_bits(value) & 0xFFFFFFFF;
                PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, bits32);
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            } else {
                PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, p_f64_to_bits(value));
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            }
        }

        Inst::ConstNull(_) => {
            PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::GlobalAddr(name, _) => {
            // lea rax, [rip + global_offset]
            var goff: i64 = HashMap_get(self.global_rdata_offsets, name);
            PeirEnc_lea_rip(&mut self.enc, PEIR_RAX, goff);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        // --- Arithmetic ---
        Inst::BinOp(op, left, right, ty) => {
            var loff: i64 = PeStackFrame_offset(frame, left);
            var roff: i64 = PeStackFrame_offset(frame, right);
            // A comparison's type is Bool: its operands' type decides
            var operand_ty: IrType = IrType::I64;
            var right_ty: IrType = IrType::I64;
            match IrFunction_get_meta(func, left) {
                OptValueMeta::Some(m) => { operand_ty = m.ty; }
                OptValueMeta::None => {}
            }
            match IrFunction_get_meta(func, right) {
                OptValueMeta::Some(m) => { right_ty = m.ty; }
                OptValueMeta::None => {}
            }
            var unsigned_cmp: bool = ir_type_eq(operand_ty, IrType::U64) || ir_type_eq(right_ty, IrType::U64);
            // For / and %, which compare nothing: the dividend is >= 0
            // (range analysis bit 2), so a constant divisor needs no sign fix
            match op {
                BinOp::Div => { unsigned_cmp = left < self.unchecked.len() && (self.unchecked.get(left) & 2) != 0; }
                BinOp::Mod => { unsigned_cmp = left < self.unchecked.len() && (self.unchecked.get(left) & 2) != 0; }
                _ => {}
            }
            if ir_type_is_float(ty) {
                PeirGen_gen_float_binop(self, op, loff, roff, dst, ty);
            } else if ir_type_is_float(operand_ty) {
                PeirGen_gen_float_binop(self, op, loff, roff, dst, operand_ty);
            } else {
                var lconst: OptU64 = OptU64::None;
                var rconst: OptU64 = OptU64::None;
                if pe_idmap_has(&frame.const_vals, left) {
                    lconst = OptU64::Some(pe_idmap_get(&frame.const_vals, left));
                }
                if pe_idmap_has(&frame.const_vals, right) {
                    rconst = OptU64::Some(pe_idmap_get(&frame.const_vals, right));
                }
                // cmp+branch fusion (item 82): a comparison feeding the next
                // instruction's Branch keeps its flags live through
                // setcc/movzx/mov — the branch jcc's on them directly. When
                // that Branch is its only use, it is not stored at all.
                var cc: i64 = peir_int_cmp_cc(op, unsigned_cmp);
                self.flags_only = cc >= 0 && next_cond == id && id < self.use_count.len()
                    && self.use_count.get(id) == 1;
                PeirGen_gen_int_binop(self, op, loff, roff, dst, lconst, rconst, ty, unsigned_cmp);
                self.flags_only = false;
                if cc >= 0 && next_cond == id {
                    self.pending_cmp_cc = cc;
                    self.pending_cmp_vid = id;
                }
            }
        }

        Inst::UnaryOp(op, operand, ty) => {
            var off: i64 = PeStackFrame_offset(frame, operand);
            match op {
                UnaryOp::Neg => {
                    if ir_type_is_float(ty) {
                        // Float negation: XOR sign bit via register
                        PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, off);
                        var sign_bit: i64 = 1 << 63;
                        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, sign_bit);
                        PeirEnc_movq_xmm_r64(&mut self.enc, 1, PEIR_RAX);
                        PeirEnc_xorpd_xmm_xmm(&mut self.enc, 0, 1);
                        if ir_type_eq(ty, IrType::F32) {
                            PeirEnc_movss_mem_rbp_xmm(&mut self.enc, dst, 0);
                        } else {
                            PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, dst, 0);
                        }
                    } else {
                        PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, off);
                        PeirEnc_neg_r(&mut self.enc, PEIR_RAX);
                        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                    }
                }
                UnaryOp::Not => {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, off);
                    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 1);
                    PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
                    PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                }
                UnaryOp::BitNot => {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, off);
                    PeirEnc_not_r(&mut self.enc, PEIR_RAX);
                    PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                }
            }
        }

        // --- Memory ---
        Inst::Alloca(_, _) => {
            if pe_idmap_has(&frame.reg_vars, id) { return; }
            var data_offset: i64 = pe_idmap_get(&frame.alloca_slots, id);
            PeirEnc_lea_rbp(&mut self.enc, PEIR_RAX, data_offset);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::Load(ptr, ty) => {
            if pe_idmap_has(&frame.reg_vars, ptr) {
                PeirGen_move_slot(self, dst, pe_idmap_get(&frame.reg_vars, ptr));
                return;
            }
            var poff: i64 = PeStackFrame_offset(frame, ptr);
            var size: i64 = IrModule_type_size(module, ty);
            if size < 1 { size = 1; }
            // Unsigned values zero-extend (a u8 255 stays 255), as in C
            var unsigned: bool = false;
            match ty {
                IrType::U8 => { unsigned = true; }
                IrType::U16 => { unsigned = true; }
                IrType::U32 => { unsigned = true; }
                IrType::Bool => { unsigned = true; }
                _ => {}
            }
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, poff);
            if size == 1 {
                // mov al, [rax] (the rest of rax still holds the
                // address), then extend al over all of rax
                PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                if unsigned {
                    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
                } else {
                    PeirEnc_movsx_r64_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
            } else if size == 2 {
                PeirEnc_mov_reg16_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                if unsigned {
                    PeirEnc_movzx_r32_r16(&mut self.enc, PEIR_RAX, PEIR_RAX);
                } else {
                    PeirEnc_movsx_r64_r16(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
            } else if size == 4 {
                // mov eax, [rax] zero-extends into rax
                PeirEnc_mov_reg32_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                if !unsigned {
                    PeirEnc_movsxd_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
            } else {
                PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
            }
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::Store(ptr, value, explicit_ty) => {
            if pe_idmap_has(&frame.reg_vars, ptr) {
                var rvslot: i64 = pe_idmap_get(&frame.reg_vars, ptr);
                if peir_is_xmm_slot(rvslot) {
                    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, rvslot - PEIR_XMM_SLOT, PeStackFrame_offset(frame, value));
                    return;
                }
                var vreg: i64 = peir_value_reg(rvslot - PEIR_REG_SLOT);
                if pe_idmap_has(&frame.const_vals, value) {
                    PeirEnc_mov_imm(&mut self.enc, vreg, pe_idmap_get(&frame.const_vals, value));
                } else {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, vreg, PeStackFrame_offset(frame, value));
                }
                return;
            }
            var poff: i64 = PeStackFrame_offset(frame, ptr);
            var voff: i64 = PeStackFrame_offset(frame, value);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, poff);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, voff);
            // As in the C backend: the explicit store type, else the
            // pointee type, else the value's type.
            var pointee: OptIrType = OptIrType::None;
            match IrFunction_get_meta(func, ptr) {
                OptValueMeta::Some(pm) => {
                    match pm.ty {
                        IrType::Ptr(inner) => {
                            pointee = OptIrType::Some(box_ir_type_unbox(inner));
                        }
                        _ => {}
                    }
                }
                OptValueMeta::None => {}
            }
            var store_ty: IrType = IrType::I64;
            var have_ty: bool = false;
            match explicit_ty {
                OptIrType::Some(t0) => { store_ty = t0; have_ty = true; }
                OptIrType::None => {}
            }
            if !have_ty {
                match pointee {
                    OptIrType::Some(t1) => { store_ty = t1; have_ty = true; }
                    OptIrType::None => {}
                }
            }
            if !have_ty {
                match IrFunction_get_meta(func, value) {
                    OptValueMeta::Some(vm) => { store_ty = vm.ty; }
                    OptValueMeta::None => {}
                }
            }
            match store_ty {
                // Structs are passed by pointer: copy the struct itself.
                IrType::Struct(_) => {
                    var ssize: i64 = IrModule_type_size(module, store_ty);
                    PeirGen_emit_copy_rcx_to_rax(self, ssize);
                }
                IrType::Array(_, _) => {
                    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
                }
                IrType::Ptr(_) => {
                    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
                }
                IrType::Opaque(_) => {
                    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
                }
                IrType::Generic(_, _) => {
                    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
                }
                _ => {
                    var sz: i64 = IrModule_type_size(module, store_ty);
                    if sz == 1 {
                        PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_RAX, PEIR_RCX);
                    } else if sz == 2 {
                        PeirEnc_mov_ptr_reg16(&mut self.enc, PEIR_RAX, PEIR_RCX);
                    } else if sz == 4 {
                        PeirEnc_mov_ptr_reg32(&mut self.enc, PEIR_RAX, PEIR_RCX);
                    } else {
                        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
                    }
                }
            }
        }

        Inst::StructCopy(dst_v, src_v, ty) => {
            // Copy struct data from src to dst (memcpy of struct size bytes)
            var dst_off: i64 = PeStackFrame_offset(frame, dst_v);
            var src_off: i64 = PeStackFrame_offset(frame, src_v);
            var size: i64 = IrModule_type_size(module, ty);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, dst_off); // dst ptr
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, src_off); // src ptr
            PeirGen_emit_copy_rcx_to_rax(self, size);
        }

        Inst::GetFieldPtr(struct_ptr, field_index, _) => {
            var poff: i64 = PeStackFrame_offset(frame, struct_ptr);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, poff);
            var offset: i64 = field_index * 8;
            match IrFunction_get_meta(func, struct_ptr) {
                OptValueMeta::Some(ptr_meta) => {
                    var struct_name: str = "";
                    match ptr_meta.ty {
                        IrType::Ptr(inner) => {
                            match box_ir_type_unbox(inner) {
                                IrType::Struct(n) => { struct_name = n; }
                                _ => {}
                            }
                        }
                        IrType::Struct(n2) => { struct_name = n2; }
                        _ => {}
                    }
                    if struct_name != "" {
                        match IrModule_get_struct(module, struct_name) {
                            OptStructLayout::Some(layout) => {
                                if field_index >= 0 && field_index < layout.fields.len() {
                                    offset = layout.fields.get(field_index).offset;
                                }
                            }
                            OptStructLayout::None => {}
                        }
                    }
                }
                OptValueMeta::None => {}
            }
            if offset > 0 {
                PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, offset);
            }
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::GetElemPtr(array_ptr, index, elem_ty) => {
            var poff: i64 = PeStackFrame_offset(frame, array_ptr);
            var ioff: i64 = PeStackFrame_offset(frame, index);
            var elem_size: i64 = IrModule_type_size(module, elem_ty);
            if elem_size < 1 { elem_size = 1; }
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, poff);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, ioff);
            PeirEnc_imul_r_r_imm32(&mut self.enc, PEIR_RCX, PEIR_RCX, elem_size);
            PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        // --- Control Flow ---
        Inst::Jump(target) => {
            var blabel: i64 = HashMap_get(self.block_labels, pe_block_key(func_name, target));
            if blabel != self.next_block {
                PeirEnc_jmp_label(&mut self.enc, blabel);
            }
        }

        Inst::Branch(cond, then, else_) => {
            var then_label: i64 = HashMap_get(self.block_labels, pe_block_key(func_name, then));
            var else_label: i64 = HashMap_get(self.block_labels, pe_block_key(func_name, else_));
            var bcc: i64 = 0x5; // jne: the bool is not zero
            if self.pending_cmp_vid == cond && self.pending_cmp_cc >= 0 {
                // The compare just emitted left its flags live: jump on the
                // condition directly.
                bcc = self.pending_cmp_cc;
            } else {
                var coff: i64 = PeStackFrame_offset(frame, cond);
                if coff >= PEIR_REG_SLOT && !peir_is_xmm_slot(coff) {
                    var cr: i64 = peir_value_reg(coff - PEIR_REG_SLOT);
                    PeirEnc_test_rr(&mut self.enc, cr, cr);
                } else {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, coff);
                    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
            }
            self.pending_cmp_cc = -1;
            self.pending_cmp_vid = -1;
            // The block laid out next needs no jump; x86 condition codes come
            // in pairs that differ in the low bit
            if then_label == self.next_block {
                PeirEnc_jcc_label(&mut self.enc, bcc ^ 1, else_label);
            } else {
                PeirEnc_jcc_label(&mut self.enc, bcc, then_label);
                if else_label != self.next_block {
                    PeirEnc_jmp_label(&mut self.enc, else_label);
                }
            }
        }

        Inst::Return(ret) => {
            match ret {
                OptValueId::Some(v) => {
                    var voff: i64 = PeStackFrame_offset(frame, v);
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, voff);
                }
                OptValueId::None => {
                    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
                }
            }
            PeirGen_restore_regs(self);
            PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
            PeirEnc_pop(&mut self.enc, PEIR_RBP);
            if func.is_interrupt {
                // Interrupt handler epilogue: restore all GP registers
                PeirEnc_pop(&mut self.enc, PEIR_R15);
                PeirEnc_pop(&mut self.enc, PEIR_R14);
                PeirEnc_pop(&mut self.enc, PEIR_R13);
                PeirEnc_pop(&mut self.enc, PEIR_R12);
                PeirEnc_pop(&mut self.enc, PEIR_R11);
                PeirEnc_pop(&mut self.enc, PEIR_R10);
                PeirEnc_pop(&mut self.enc, PEIR_R9);
                PeirEnc_pop(&mut self.enc, PEIR_R8);
                PeirEnc_pop(&mut self.enc, PEIR_RDI);
                PeirEnc_pop(&mut self.enc, PEIR_RSI);
                PeirEnc_pop(&mut self.enc, PEIR_RDX);
                PeirEnc_pop(&mut self.enc, PEIR_RCX);
                PeirEnc_pop(&mut self.enc, PEIR_RBX);
                PeirEnc_pop(&mut self.enc, PEIR_RAX);
                // For exceptions with error codes, push dummy error code
                // so iretq sees the correct stack layout
                if pe_interrupt_has_err(func.interrupt_vector) {
                    // push 0 (dummy error code)
                    peir_emit2(&mut self.enc, 0x6A, 0x00);
                }
                // iretq restores SS:RSP, RFLAGS, CS:RIP (64-bit)
                peir_emit2(&mut self.enc, 0x48, 0xCF); // iretq
            } else {
                PeirEnc_ret(&mut self.enc);
            }
        }

        Inst::Unreachable => {
            PeirEnc_ud2(&mut self.enc);
        }

        // --- Function Calls ---
        Inst::Call(call_name, args, _, _) => {
            if PeirGen_inline_vec_call(self, call_name, args, dst, frame, func) { return; }
            // An f64 lives in its slot as its bits: these copy the word (the
            // async task adapters of release H9 use them)
            if (call_name == "p_f64_to_bits" || call_name == "p_f64_from_bits") && args.len() == 1 {
                var boff: i64 = PeStackFrame_offset(frame, args.get(0));
                PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, boff);
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                return;
            }
            // print(tensor): the runtime formats it, then the string prints
            if call_name == "print" && args.len() > 0 {
                var arg0: i64 = args.get(0);
                var tensor_arg: bool = false;
                match IrFunction_get_meta(func, arg0) {
                    OptValueMeta::Some(m0) => {
                        tensor_arg = ir_type_is_opaque_named(m0.ty, "Tensor");
                    }
                    OptValueMeta::None => {}
                }
                if tensor_arg {
                    var aoff0: i64 = PeStackFrame_offset(frame, arg0);
                    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, aoff0);
                    PeirGen_call_builtin(self, "p_tensor_to_str", 1);
                    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
                    PeirGen_call_runtime(self, "p_print_str");
                    PeirEnc_add_rsp_i32(&mut self.enc, 32);
                    PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                    return;
                }
            }

            var target_func: str = call_name;
            if call_name == "print" {
                target_func = "p_print_int";
                if args.len() > 0 {
                    match IrFunction_get_meta(func, args.get(0)) {
                        OptValueMeta::Some(am) => {
                            var aty: IrType = am.ty;
                            if pe_is_ptr(aty) { target_func = "p_print_str"; }
                            else if ir_type_is_float(aty) { target_func = "p_print_float"; }
                            else if ir_type_eq(aty, IrType::Bool) { target_func = "p_print_bool"; }
                            else if ir_type_is_opaque_named(aty, "Vec") { target_func = "p_print_vec"; }
                            else if ir_type_is_opaque_named(aty, "HashMap") { target_func = "p_print_map"; }
                            else { target_func = "p_print_int"; }
                        }
                        OptValueMeta::None => {}
                    }
                }
            } else if call_name == "p_to_str" {
                target_func = "p_to_str";
                if args.len() > 0 {
                    match IrFunction_get_meta(func, args.get(0)) {
                        OptValueMeta::Some(am2) => {
                            var aty2: IrType = am2.ty;
                            if ir_type_is_opaque_named(aty2, "Vec") { target_func = "p_to_str_vec"; }
                            else if ir_type_is_float(aty2) { target_func = "p_to_str_float"; }
                            else if pe_is_ptr(aty2) { target_func = "p_to_str_str"; }
                            else if ir_type_eq(aty2, IrType::Bool) { target_func = "p_to_str_bool"; }
                            else { target_func = "p_to_str"; }
                        }
                        OptValueMeta::None => {}
                    }
                }
            }
            target_func = PeirGen_resolve_call(self, target_func);

            // Inline tiny runtime calls (pe-roadmap item 86): when the
            // resolved callee is a machine stub and no Fides override
            // stands in for it, emit its body at the call site.
            if args.len() == 1 && !pe_ir_strs_contains(self.module_fns, target_func) {
                var iaoff: i64 = PeStackFrame_offset(frame, args.get(0));
                if target_func == "p_vec_len" || target_func == "p_map_len" {
                    // rax = [[slot] + 8]
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, iaoff);
                    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RAX, 8);
                    PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                    return;
                }
                if target_func == "p_map_is_empty" || target_func == "p_string_is_empty" {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, iaoff);
                    if target_func == "p_map_is_empty" {
                        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RAX, 8);
                    } else {
                        PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
                    }
                    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                    PeirEnc_setcc_r(&mut self.enc, 0x4, PEIR_RAX); // sete
                    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
                    PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                    return;
                }
            }

            // A Fides function standing in for a runtime builtin (called
            // without one) takes a null `__env` first
            var call_args: Vec<OptValueId> = Vec::new();
            if pe_ir_strs_contains(self.module_fns, target_func)
                && !pe_ir_strs_contains(self.module_fns, call_name) {
                call_args.push(OptValueId::None);
            }
            var ai: i64 = 0;
            while ai < args.len() {
                call_args.push(OptValueId::Some(args.get(ai)));
                ai = ai + 1;
            }

            var arg_regs: Vec<i64> = Vec::new();
            arg_regs.push(PEIR_RCX);
            arg_regs.push(PEIR_RDX);
            arg_regs.push(PEIR_R8);
            arg_regs.push(PEIR_R9);
            var stack_args: i64 = 0;
            if call_args.len() > 4 { stack_args = call_args.len() - 4; }
            var call_space: i64 = (32 + stack_args * 8 + 15) & ~15;

            // Load args into registers (item 83): a known-constant arg moves
            // in as an immediate instead of a slot load.
            var ri: i64 = 0;
            while ri < call_args.len() && ri < 4 {
                match call_args.get(ri) {
                    OptValueId::Some(a) => {
                        if pe_idmap_has(&frame.const_vals, a) {
                            PeirEnc_mov_imm(&mut self.enc, arg_regs.get(ri), pe_idmap_get(&frame.const_vals, a));
                        } else {
                            PeirEnc_mov_reg_mem_rbp(&mut self.enc, arg_regs.get(ri), PeStackFrame_offset(frame, a));
                        }
                    }
                    OptValueId::None => {
                        PeirEnc_xor_rr(&mut self.enc, arg_regs.get(ri), arg_regs.get(ri));
                    }
                }
                ri = ri + 1;
            }

            if !self.calls_reserved { PeirEnc_sub_rsp_i32(&mut self.enc, call_space); }
            // Place stack args
            var sa: i64 = 4;
            while sa < call_args.len() {
                var stack_pos: i64 = 32 + (sa - 4) * 8;
                match call_args.get(sa) {
                    OptValueId::Some(a2) => {
                        if pe_idmap_has(&frame.const_vals, a2) {
                            PeirEnc_mov_imm(&mut self.enc, PEIR_RAX, pe_idmap_get(&frame.const_vals, a2));
                        } else {
                            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, PeStackFrame_offset(frame, a2));
                        }
                    }
                    OptValueId::None => {
                        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                    }
                }
                PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, stack_pos, PEIR_RAX);
                sa = sa + 1;
            }

            // Call the function. A function nobody defines would leave a
            // garbage result: trap, and (outside bare mode, where kernels
            // may rely on the trap) refuse the program in pe_ir_generate_pe.
            PeirGen_call_runtime(self, target_func);

            if !self.calls_reserved { PeirEnc_add_rsp_i32(&mut self.enc, call_space); }
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::CallPtr(fn_ptr, args, _, _, _) => {
            var fpoff: i64 = PeStackFrame_offset(frame, fn_ptr);
            // Load env struct pointer
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, fpoff);
            // Load fn addr from field 0
            PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);

            var total_args: i64 = args.len() + 1;
            var arg_regs: Vec<i64> = Vec::new();
            arg_regs.push(PEIR_RCX);
            arg_regs.push(PEIR_RDX);
            arg_regs.push(PEIR_R8);
            arg_regs.push(PEIR_R9);
            var stack_args: i64 = 0;
            if total_args > 4 { stack_args = total_args - 4; }
            var call_space: i64 = (32 + stack_args * 8 + 15) & ~15;

            PeirEnc_sub_rsp_i32(&mut self.enc, call_space);
            // First arg (rcx) = env_ptr
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, fpoff);

            var i: i64 = 0;
            while i < args.len() {
                var aoff: i64 = PeStackFrame_offset(frame, args.get(i));
                var arg_idx: i64 = i + 1;
                if arg_idx < 4 {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, arg_regs.get(arg_idx), aoff);
                } else {
                    var stack_pos: i64 = 32 + (arg_idx - 4) * 8;
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R10, aoff);
                    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, stack_pos, PEIR_R10);
                }
                i = i + 1;
            }

            // Save fn addr, call indirectly
            PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_RAX);
            PeirEnc_call_reg(&mut self.enc, PEIR_R10);
            PeirEnc_add_rsp_i32(&mut self.enc, call_space);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        // --- Conversions ---
        Inst::IntExtend(value, from, _) => {
            var voff: i64 = PeStackFrame_offset(frame, value);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, voff);
            match from {
                IrType::I8 => { PeirEnc_movsx_r64_r8(&mut self.enc, PEIR_RAX, PEIR_RAX); }
                IrType::I16 => { PeirEnc_movsx_r64_r16(&mut self.enc, PEIR_RAX, PEIR_RAX); }
                IrType::I32 => { PeirEnc_movsxd_rr(&mut self.enc, PEIR_RAX, PEIR_RAX); }
                _ => {}
            }
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::IntTrunc(value, _, to) => {
            var voff: i64 = PeStackFrame_offset(frame, value);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, voff);
            match to {
                IrType::I8 => { PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX); }
                IrType::U8 => { PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX); }
                IrType::I16 => { PeirEnc_movzx_r32_r16(&mut self.enc, PEIR_RAX, PEIR_RAX); }
                IrType::U16 => { PeirEnc_movzx_r32_r16(&mut self.enc, PEIR_RAX, PEIR_RAX); }
                IrType::I32 => {
                    // mov eax, eax (zero-extends upper 32 bits)
                    PeirEnc_rex(&mut self.enc, false, false, false, false);
                    PeirEnc_emit_u8(&mut self.enc, 0x89);
                    PeirEnc_modrm_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
                IrType::U32 => {
                    // mov eax, eax (zero-extends upper 32 bits)
                    PeirEnc_rex(&mut self.enc, false, false, false, false);
                    PeirEnc_emit_u8(&mut self.enc, 0x89);
                    PeirEnc_modrm_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
                _ => {}
            }
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::IntToFloat(value, _, to) => {
            var voff: i64 = PeStackFrame_offset(frame, value);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, voff);
            PeirEnc_cvtsi2sd_r64(&mut self.enc, 0, PEIR_RAX);
            if ir_type_eq(to, IrType::F32) {
                PeirEnc_movss_mem_rbp_xmm(&mut self.enc, dst, 0);
            } else {
                PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, dst, 0);
            }
        }

        Inst::FloatToInt(value, from, _) => {
            var voff: i64 = PeStackFrame_offset(frame, value);
            if ir_type_eq(from, IrType::F32) {
                PeirEnc_movss_xmm_mem_rbp(&mut self.enc, 0, voff);
            } else {
                PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, voff);
            }
            PeirEnc_cvttsd2si_r64(&mut self.enc, PEIR_RAX, 0);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::MakeDyn(value, type_name, _) => {
            // A dyn value: 16 bytes {type id, receiver}.
            var tid: i64 = PeirGen_dyn_type_id(self, type_name);
            var voff: i64 = PeStackFrame_offset(frame, value);
            PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 16);
            PeirEnc_sub_rsp_i32(&mut self.enc, 32);
            PeirGen_call_runtime(self, "p_malloc");
            PeirEnc_add_rsp_i32(&mut self.enc, 32);
            PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, tid);
            PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 0, PEIR_R10);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R10, voff);
            PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 8, PEIR_R10);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::DynCall(_, method, args, _, _) => {
            // Candidates: every type made into a dyn value or named by a
            // trait impl that has `Type_method`.
            var types: Vec<str> = Vec::new();
            var ti: i64 = 0;
            while ti < module.trait_impls.len() {
                var items: Vec<str> = module.trait_impls.get(ti).items;
                var ii: i64 = 0;
                while ii < items.len() {
                    types = pe_ir_strs_insert_sorted(types, items.get(ii));
                    ii = ii + 1;
                }
                ti = ti + 1;
            }
            var fi2: i64 = 0;
            while fi2 < module.functions.len() {
                var f2: IrFunction = module.functions.get(fi2).func;
                var ii2: i64 = 0;
                while ii2 < f2.insts.len() {
                    match f2.insts.get(ii2).inst {
                        Inst::MakeDyn(_, type_name, _) => {
                            types = pe_ir_strs_insert_sorted(types, type_name);
                        }
                        _ => {}
                    }
                    ii2 = ii2 + 1;
                }
                fi2 = fi2 + 1;
            }
            var candidates: Vec<PeDynCandidate> = Vec::new();
            var tj: i64 = 0;
            while tj < types.len() {
                var tname: str = types.get(tj);
                var mname: str = tname + "_" + method;
                if HashMap_contains(self.func_labels, mname) {
                    var flabel: i64 = HashMap_get(self.func_labels, mname);
                    var tid: i64 = PeirGen_dyn_type_id(self, tname);
                    candidates.push(PeDynCandidate { tid: tid, label: flabel });
                }
                tj = tj + 1;
            }
            // Arguments: env (0), receiver, then args[1..].
            var total_args: i64 = args.len() + 1;
            var stack_args: i64 = 0;
            if total_args > 4 { stack_args = total_args - 4; }
            var call_space: i64 = (32 + stack_args * 8 + 15) & ~15;
            var arg_regs: Vec<i64> = Vec::new();
            arg_regs.push(PEIR_RCX);
            arg_regs.push(PEIR_RDX);
            arg_regs.push(PEIR_R8);
            arg_regs.push(PEIR_R9);
            PeirEnc_sub_rsp_i32(&mut self.enc, call_space);
            var i: i64 = 1;
            while i < args.len() {
                var arg_idx: i64 = i + 1;
                if arg_idx >= 4 {
                    var aoff: i64 = PeStackFrame_offset(frame, args.get(i));
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, aoff);
                    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32 + (arg_idx - 4) * 8, PEIR_RAX);
                }
                i = i + 1;
            }
            i = 1;
            while i < args.len() {
                var arg_idx2: i64 = i + 1;
                if arg_idx2 < 4 {
                    var aoff2: i64 = PeStackFrame_offset(frame, args.get(i));
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, arg_regs.get(arg_idx2), aoff2);
                }
                i = i + 1;
            }
            if args.len() > 0 {
                var ooff: i64 = PeStackFrame_offset(frame, args.get(0));
                PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R10, ooff);
                PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R11, PEIR_R10, 0); // type id
                PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_R10, 8); // receiver
            }
            PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
            var done: i64 = PeirEnc_alloc_label(&mut self.enc);
            var ci: i64 = 0;
            while ci < candidates.len() {
                var cand: PeDynCandidate = candidates.get(ci);
                var next: i64 = PeirEnc_alloc_label(&mut self.enc);
                PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, cand.tid);
                PeirEnc_cmp_rr(&mut self.enc, PEIR_R11, PEIR_R10);
                PeirEnc_jcc_label(&mut self.enc, 0x5, next); // jne
                PeirEnc_call_label(&mut self.enc, cand.label);
                PeirEnc_jmp_label(&mut self.enc, done);
                PeirEnc_place_label(&mut self.enc, next);
                ci = ci + 1;
            }
            PeirEnc_ud2(&mut self.enc); // no implementation for this type
            PeirEnc_place_label(&mut self.enc, done);
            PeirEnc_add_rsp_i32(&mut self.enc, call_space);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::BitCast(value, _, _) => {
            var voff: i64 = PeStackFrame_offset(frame, value);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, voff);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        // --- Fides-Specific ---
        Inst::Print(value, ty) => {
            var voff: i64 = PeStackFrame_offset(frame, value);
            PeirEnc_sub_rsp_i32(&mut self.enc, 32);
            var formatter: str = pe_ir_print_formatter(ty);
            if formatter != "" {
                // Collections print through their Fides formatter (as in
                // the C backend): formatter(env = 0, value) -> str.
                PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
                PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, voff);
                PeirGen_call_runtime(self, formatter);
                PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
                PeirGen_call_runtime(self, "p_print_str");
            } else {
                PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, voff);
                // Route to the correct print function based on type
                var print_fn: str = "p_print_int";
                match ty {
                    IrType::Ptr(_) => { print_fn = "p_print_str"; }
                    IrType::Opaque(n) => {
                        if n == "String" { print_fn = "p_print_str"; }
                    }
                    IrType::F64 => { print_fn = "p_print_float"; }
                    IrType::F32 => { print_fn = "p_print_float"; }
                    IrType::Bool => { print_fn = "p_print_bool"; }
                    _ => { print_fn = "p_print_int"; }
                }
                PeirGen_call_builtin(self, print_fn, 1);
            }
            PeirEnc_add_rsp_i32(&mut self.enc, 32);
        }

        Inst::PersistLoad(_, default, _) => {
            // Persistent load — just copy default value to destination
            var doff: i64 = PeStackFrame_offset(frame, default);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, doff);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::PersistSave(_, _) => {
            // No-op in PE emitter
        }

        Inst::TxnBegin => {
            // No-op in PE emitter (rollback/unsafe not supported)
        }
        Inst::TxnEnd => {
            // No-op in PE emitter (rollback/unsafe not supported)
        }
        Inst::UnsafeBegin => {
            // No-op in PE emitter (rollback/unsafe not supported)
        }
        Inst::UnsafeEnd => {
            // No-op in PE emitter (rollback/unsafe not supported)
        }

        Inst::GradBegin(_) => {
            PeirGen_gen_autograd(self, inst, 0);
        }
        Inst::GradEnd => {
            PeirGen_gen_autograd(self, inst, 0);
        }
        Inst::Backward(_) => {
            PeirGen_gen_autograd(self, inst, 1);
        }

        Inst::Panic(message) => {
            var off: i64 = PeirGen_str_off(self, message);
            PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, off);
            PeirEnc_sub_rsp_i32(&mut self.enc, 32);
            if HashMap_contains(self.func_labels, "p_panic") {
                var plabel: i64 = HashMap_get(self.func_labels, "p_panic");
                PeirEnc_call_label(&mut self.enc, plabel);
            }
            PeirEnc_add_rsp_i32(&mut self.enc, 32);
        }

        Inst::TryUnwrap(_, _, _, _) => {
            // Not fully implemented
            PeirEnc_nop(&mut self.enc);
        }

        Inst::Asm(template, inputs, outputs, asm_ty) => {
            if self.bare_mode {
                // Bare builds run the template (release G2): inputs into
                // their registers, the instructions, the first output out
                var enc_res: PeAsmResult = pe_asm_encode(template);
                if enc_res.error != "" {
                    g_pe_asm_errors.push("asm!(\"" + template + "\") in " + func_name + ": " + enc_res.error);
                }
                var ii2: i64 = 0;
                while ii2 < inputs.len() {
                    var inr: i64 = pe_asm_reg64(inputs.get(ii2).name);
                    if inr < 0 {
                        g_pe_asm_errors.push("asm! in " + func_name + ": in(\"" + inputs.get(ii2).name + "\") is not a 64-bit register");
                    } else {
                        PeirGen_load_operand(self, inr, inputs.get(ii2).id, frame);
                    }
                    ii2 = ii2 + 1;
                }
                var bi2: i64 = 0;
                while bi2 < enc_res.bytes.len() {
                    PeirEnc_emit_u8(&mut self.enc, enc_res.bytes.get(bi2));
                    bi2 = bi2 + 1;
                }
                var outr: i64 = PEIR_RAX;
                if outputs.len() > 0 {
                    outr = pe_asm_reg64(outputs.get(0).name);
                    if outr < 0 {
                        g_pe_asm_errors.push("asm! in " + func_name + ": out(\"" + outputs.get(0).name + "\") is not a 64-bit register");
                        outr = PEIR_RAX;
                    }
                } else {
                    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
                }
                match asm_ty {
                    IrType::Void => {}
                    _ => { PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, outr); }
                }
            } else {
                // A Windows process runs no inline assembly (as on the C path)
                PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            }
        }

        Inst::RegionBegin(_, _, _, _) => {
            // Region begin — no-op in PE backend (stack-based allocation)
            PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
        }

        Inst::RegionEnd(_, _, _) => {
            // Region end — no-op in PE backend
        }
    }
}

// ===========================================================================
// PeirGen::gen_int_binop / gen_float_binop (src/pe.rs)
// ===========================================================================

/// Slot-reuse rule: a value is a recyclable temporary iff it is defined by
/// an instruction inside one block and every use sits in that same block.
/// Params and cross-block/loop-carried values keep permanent slots.
pub fn peir_recyclable(v: i64, def_block: Vec<i64>, n_use_blocks: Vec<i64>, a_use_block: Vec<i64>, nvals: i64) -> bool {
    if v < 0 || v >= nvals { return false; }
    var db: i64 = def_block.get(v);
    if db < 0 { return false; }
    var nub: i64 = n_use_blocks.get(v);
    if nub == 0 { return true; }
    if nub == 1 { return a_use_block.get(v) == db; }
    return false;
}

/// The jcc code jumping when an integer comparison `a OP b` holds (the
/// setcc-style numbering gen_int_binop uses: 4=E, 5=NE, C=L, D=GE, E=LE,
/// F=G; unsigned 2=B, 3=AE, 6=BE, 7=A), or -1 for a non-comparison.
pub fn peir_int_cmp_cc(op: BinOp, unsigned: bool) -> i64 {
    match op {
        BinOp::Eq => { return 0x4; }
        BinOp::Neq => { return 0x5; }
        BinOp::Lt => { if unsigned { return 0x2; } return 0xC; }
        BinOp::GtEq => { if unsigned { return 0x3; } return 0xD; }
        BinOp::LtEq => { if unsigned { return 0x6; } return 0xE; }
        BinOp::Gt => { if unsigned { return 0x7; } return 0xF; }
        _ => { return -1; }
    }
}

// The arithmetic panics, one shared stub each (indices into arith_panics)
const PEIR_PANIC_ADD: i64 = 0;
const PEIR_PANIC_SUB: i64 = 1;
const PEIR_PANIC_MUL: i64 = 2;
const PEIR_PANIC_DIV_OVF: i64 = 3;
const PEIR_PANIC_DIV_ZERO: i64 = 4;
const PEIR_PANIC_MOD_ZERO: i64 = 5;
const PEIR_PANIC_VEC_INDEX: i64 = 6;
pub const PEIR_PANIC_DOUBLE_FREE: i64 = 7;
pub const PEIR_PANIC_BAD_FREE: i64 = 8;

fn peir_arith_panic_strings() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("Integer overflow on addition");
    v.push("Integer overflow on subtraction");
    v.push("Integer overflow on multiplication");
    v.push("Integer overflow on division");
    v.push("Division by zero");
    v.push("Modulo by zero");
    v.push("Vec index out of bounds");
    v.push("Double free");
    v.push("Invalid free: not an allocated block");
    return v;
}

/// Every message a runtime stub panics with.
fn peir_panic_strings() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("Stack overflow");
    v.push("Invalid memory access (null or dangling pointer)");
    v.push("Illegal instruction");
    var a: Vec<str> = peir_arith_panic_strings();
    var i: i64 = 0;
    while i < a.len() {
        v.push(a.get(i));
        i = i + 1;
    }
    return v;
}

fn PeirGen_jump_panic(self: &mut PeirGen, cc: i64, which: i64) -> void {
    PeirEnc_jcc_label(&mut self.enc, cc, self.arith_panics.get(which));
}

/// Integer arithmetic in type `ty`: the one meaning the interpreter and the
/// C backend implement. A checked operation costs one jcc to a shared panic
/// stub. Bare-metal code checks too (release G3): its panics go to the
/// program's @panic_handler, else to COM1 and a halt (gen_bare_runtime).
pub fn PeirGen_gen_int_binop(self: &mut PeirGen, op: BinOp, loff: i64, roff: i64, dst: i64, lconst: OptU64, rconst: OptU64, ty: IrType, unsigned_cmp: bool) -> void {
    if PeirGen_int_binop_in_reg(self, op, loff, roff, dst, lconst, rconst, ty) { return; }
    // An i64 `x / c` or `x % c` by a constant c >= 2: x straight into rcx,
    // the result stored from where it ends up (no moves through rax)
    var dmc: i64 = 0;
    match rconst {
        OptU64::Some(dv) => { dmc = dv; }
        OptU64::None => {}
    }
    var dm_mod: i64 = -1;
    match op {
        BinOp::Div => { dm_mod = 0; }
        BinOp::Mod => { dm_mod = 1; }
        _ => {}
    }
    if dm_mod >= 0 && dmc >= 2 && ir_type_eq(ty, IrType::I64) {
        match lconst {
            OptU64::Some(lv) => { PeirEnc_mov_imm(&mut self.enc, PEIR_RCX, lv); }
            OptU64::None => { PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, loff); }
        }
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        // (gen_inst passes `unsigned_cmp` = the dividend is >= 0 for these)
        PeirGen_gen_div_const_n(self, dm_mod == 1, dmc, unsigned_cmp);
        if dm_mod == 1 { PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RCX); }
        else { PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX); }
        return;
    }
    // A comparison of a value in a register: `cmp r, imm` or `cmp r, r2`
    // (competitive OP18), no copy to rax
    var lcmp: bool = false;
    match lconst {
        OptU64::None => { lcmp = loff >= PEIR_REG_SLOT && !peir_is_xmm_slot(loff) && peir_int_cmp_cc(op, unsigned_cmp) >= 0; }
        OptU64::Some(_) => {}
    }
    if lcmp {
        var rl: i64 = peir_value_reg(loff - PEIR_REG_SLOT);
        match rconst {
            OptU64::Some(cv) => {
                if cv > -2147483648 && cv <= 2147483647 {
                    PeirEnc_cmp_r_imm(&mut self.enc, rl, cv);
                } else {
                    PeirEnc_mov_imm(&mut self.enc, PEIR_RCX, cv);
                    PeirEnc_cmp_rr(&mut self.enc, rl, PEIR_RCX);
                }
            }
            OptU64::None => {
                if roff >= PEIR_REG_SLOT && !peir_is_xmm_slot(roff) {
                    PeirEnc_cmp_rr(&mut self.enc, rl, peir_value_reg(roff - PEIR_REG_SLOT));
                } else {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, roff);
                    PeirEnc_cmp_rr(&mut self.enc, rl, PEIR_RCX);
                }
            }
        }
        if self.flags_only { return; }
        PeirEnc_setcc_r(&mut self.enc, peir_int_cmp_cc(op, unsigned_cmp), PEIR_RAX);
        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        return;
    }
    // A constant operand moves in as an immediate, not a slot load (item 81).
    match lconst {
        OptU64::Some(v) => { PeirEnc_mov_imm(&mut self.enc, PEIR_RAX, v); }
        OptU64::None => { PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, loff); }
    }
    var is_i64: bool = ir_type_eq(ty, IrType::I64);
    var is_u64: bool = ir_type_eq(ty, IrType::U64);
    var unsigned_ty: bool = is_u64 || ir_type_eq(ty, IrType::U8) || ir_type_eq(ty, IrType::U16)
        || ir_type_eq(ty, IrType::U32);
    // A small constant is an immediate; `sub` is an `add` of its negation
    var small: bool = false;
    var big_enough: bool = false;
    var rval: i64 = 0;
    match rconst {
        OptU64::Some(v) => {
            rval = v;
            small = v > -2147483648 && v <= 2147483647;
            big_enough = v >= 2;
        }
        OptU64::None => {}
    }
    var use_imm: bool = false;
    var by_const: bool = false;
    match op {
        BinOp::Add => { use_imm = small && !is_u64; }
        BinOp::Sub => { use_imm = small && !is_u64; }
        BinOp::Mul => { use_imm = small && !is_u64; }
        BinOp::Eq => { use_imm = small; }
        BinOp::Neq => { use_imm = small; }
        BinOp::Lt => { use_imm = small; }
        BinOp::Gt => { use_imm = small; }
        BinOp::LtEq => { use_imm = small; }
        BinOp::GtEq => { use_imm = small; }
        BinOp::Div => { by_const = big_enough && !unsigned_ty; }
        BinOp::Mod => { by_const = big_enough && !unsigned_ty; }
        _ => {}
    }
    match rconst {
        OptU64::Some(v) => {
            if !use_imm && !by_const { PeirEnc_mov_imm(&mut self.enc, PEIR_RCX, v); }
        }
        OptU64::None => { PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, roff); }
    }

    var checked: bool = !self.cur_wrapping && !self.cur_unchecked;
    // jo for i64, jc for u64; narrow types are checked after the operation
    var ovf_cc: i64 = -1;
    if checked && is_i64 { ovf_cc = 0x0; }
    if checked && is_u64 { ovf_cc = 0x2; }
    var narrow_panic: i64 = -1;

    match op {
        BinOp::Add => {
            if use_imm { PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, rval); }
            else { PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX); }
            if ovf_cc >= 0 { PeirGen_jump_panic(self, ovf_cc, PEIR_PANIC_ADD); }
            narrow_panic = PEIR_PANIC_ADD;
        }
        BinOp::Sub => {
            if use_imm { PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 0 - rval); }
            else { PeirEnc_sub_rr(&mut self.enc, PEIR_RAX, PEIR_RCX); }
            if ovf_cc >= 0 { PeirGen_jump_panic(self, ovf_cc, PEIR_PANIC_SUB); }
            narrow_panic = PEIR_PANIC_SUB;
        }
        BinOp::Mul => {
            if checked && is_u64 {
                PeirEnc_mul_r(&mut self.enc, PEIR_RCX);
                PeirGen_jump_panic(self, 0x0, PEIR_PANIC_MUL);
            } else {
                if use_imm {
                    PeirEnc_imul_r_i32(&mut self.enc, PEIR_RAX, rval);
                } else {
                    PeirEnc_imul_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
                }
                if checked && is_i64 { PeirGen_jump_panic(self, 0x0, PEIR_PANIC_MUL); }
            }
            narrow_panic = PEIR_PANIC_MUL;
        }
        BinOp::Div => {
            PeirGen_gen_int_div(self, false, rconst, ty, checked);
            narrow_panic = PEIR_PANIC_DIV_OVF;
        }
        BinOp::Mod => { PeirGen_gen_int_div(self, true, rconst, ty, checked); }
        BinOp::BitAnd => { PeirEnc_and_rr(&mut self.enc, PEIR_RAX, PEIR_RCX); }
        BinOp::BitOr => { PeirEnc_or_rr(&mut self.enc, PEIR_RAX, PEIR_RCX); }
        BinOp::BitXor => { PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RCX); }
        BinOp::Shl => {
            PeirEnc_shl_cl(&mut self.enc, PEIR_RAX);
            PeirGen_gen_narrow(self, ty, -1);
        }
        BinOp::Shr => {
            if is_u64 { PeirEnc_shr_cl(&mut self.enc, PEIR_RAX); }
            else { PeirEnc_sar_cl(&mut self.enc, PEIR_RAX); }
        }
        BinOp::And => {
            PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
            PeirEnc_setcc_r(&mut self.enc, 0x5, PEIR_RAX); // setne
            PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
            PeirEnc_setcc_r(&mut self.enc, 0x5, PEIR_RCX); // setne
            PeirEnc_and_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
            PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        }
        BinOp::Or => {
            PeirEnc_or_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
            PeirEnc_setcc_r(&mut self.enc, 0x5, PEIR_RAX); // setne
            PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        }
        _ => {
            // Eq, Neq, Lt, Gt, LtEq, GtEq
            if use_imm {
                peir_emit2(&mut self.enc, 0x48, 0x3D); // cmp rax, imm32
                PeirEnc_emit_i32(&mut self.enc, rval);
            } else {
                PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
            }
            if self.flags_only { return; }
            PeirEnc_setcc_r(&mut self.enc, peir_int_cmp_cc(op, unsigned_cmp), PEIR_RAX);
            PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        }
    }

    // A narrow result is normalized (its slot always holds the value in 64
    // bits); in checked code a value that changes did not fit.
    if narrow_panic >= 0 {
        if checked { PeirGen_gen_narrow(self, ty, narrow_panic); }
        else { PeirGen_gen_narrow(self, ty, -1); }
    }

    PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
}

/// An i64 add, sub, mul, and, or or xor whose result is in a register:
/// computed there (`mov rd, l; op rd, r`), not through rax and rcx (D13).
/// False when it does not apply.
fn PeirGen_int_binop_in_reg(self: &mut PeirGen, op: BinOp, loff: i64, roff: i64, dst: i64, lconst: OptU64, rconst: OptU64, ty: IrType) -> bool {
    if dst < PEIR_REG_SLOT || !ir_type_eq(ty, IrType::I64) { return false; }
    match lconst {
        OptU64::Some(_) => { return false; }
        OptU64::None => {}
    }
    var kind: i64 = -1;
    match op {
        BinOp::Add => { kind = 0; }
        BinOp::Sub => { kind = 1; }
        BinOp::Mul => { kind = 2; }
        BinOp::BitAnd => { kind = 3; }
        BinOp::BitOr => { kind = 4; }
        BinOp::BitXor => { kind = 5; }
        _ => {}
    }
    if kind < 0 { return false; }
    var rd: i64 = peir_value_reg(dst - PEIR_REG_SLOT);
    var has_const: bool = false;
    var rval: i64 = 0;
    match rconst {
        OptU64::Some(v) => { has_const = true; rval = v; }
        OptU64::None => {}
    }
    // `mov rd, l` must not overwrite the right operand
    if !has_const && roff == dst { return false; }
    var small: bool = has_const && rval > -2147483648 && rval <= 2147483647;
    var checked: bool = !self.cur_wrapping && !self.cur_unchecked;
    // Instruction selection (competitive OP18): with the left operand in a
    // register, no copy first. `imul rd, rl, imm`; and where no overflow
    // check is needed, `lea rd, [rl + imm]`, `lea rd, [rl + rr]` and
    // `lea rd, [rl + rl*k]` for * 2, 3, 5 and 9.
    var lreg: i64 = -1;
    if loff >= PEIR_REG_SLOT && !peir_is_xmm_slot(loff) { lreg = peir_value_reg(loff - PEIR_REG_SLOT); }
    if lreg >= 0 && kind == 2 && small {
        if !checked && (rval == 2 || rval == 3 || rval == 5 || rval == 9) {
            var sc: i64 = 0;
            if rval == 3 { sc = 1; }
            if rval == 5 { sc = 2; }
            if rval == 9 { sc = 3; }
            PeirEnc_lea_base_index(&mut self.enc, rd, lreg, lreg, sc);
            return true;
        }
        PeirEnc_imul_r_r_imm(&mut self.enc, rd, lreg, rval);
        if checked { PeirGen_jump_panic(self, 0x0, PEIR_PANIC_MUL); }
        return true;
    }
    if lreg >= 0 && lreg != rd && !checked && (kind == 0 || kind == 1) {
        if small && rval > -2147483647 {
            var disp: i64 = rval;
            if kind == 1 { disp = 0 - rval; }
            PeirEnc_lea_base_disp(&mut self.enc, rd, lreg, disp);
            return true;
        }
        if kind == 0 && !has_const && roff >= PEIR_REG_SLOT && !peir_is_xmm_slot(roff) {
            PeirEnc_lea_base_index(&mut self.enc, rd, lreg, peir_value_reg(roff - PEIR_REG_SLOT), 0);
            return true;
        }
    }
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, rd, loff);
    // The right operand: an immediate, its register, or rcx
    var rs: i64 = PEIR_RCX;
    if has_const {
        if !(small && kind <= 2) { PeirEnc_mov_imm(&mut self.enc, PEIR_RCX, rval); }
    } else if roff >= PEIR_REG_SLOT {
        rs = peir_value_reg(roff - PEIR_REG_SLOT);
    } else {
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, roff);
    }
    var imm: bool = small && kind <= 2;
    if kind == 0 {
        if imm { PeirEnc_add_r_imm(&mut self.enc, rd, rval); } else { PeirEnc_add_rr(&mut self.enc, rd, rs); }
        if checked { PeirGen_jump_panic(self, 0x0, PEIR_PANIC_ADD); }
    } else if kind == 1 {
        if imm { PeirEnc_add_r_imm(&mut self.enc, rd, 0 - rval); } else { PeirEnc_sub_rr(&mut self.enc, rd, rs); }
        if checked { PeirGen_jump_panic(self, 0x0, PEIR_PANIC_SUB); }
    } else if kind == 2 {
        if imm { PeirEnc_imul_r_r_imm(&mut self.enc, rd, rd, rval); } else { PeirEnc_imul_rr(&mut self.enc, rd, rs); }
        if checked { PeirGen_jump_panic(self, 0x0, PEIR_PANIC_MUL); }
    } else if kind == 3 {
        PeirEnc_and_rr(&mut self.enc, rd, rs);
    } else if kind == 4 {
        PeirEnc_or_rr(&mut self.enc, rd, rs);
    } else {
        PeirEnc_xor_rr(&mut self.enc, rd, rs);
    }
    return true;
}

/// Copy the value at frame offset `src` to frame offset `dst`, either of
/// which may be a register (D13: one mov between registers).
fn PeirGen_move_slot(self: &mut PeirGen, dst: i64, src: i64) -> void {
    if dst == src { return; }
    if peir_is_xmm_slot(dst) {
        PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, dst - PEIR_XMM_SLOT, src);
        return;
    }
    if peir_is_xmm_slot(src) {
        PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, dst, src - PEIR_XMM_SLOT);
        return;
    }
    if dst >= PEIR_REG_SLOT {
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, peir_value_reg(dst - PEIR_REG_SLOT), src);
    } else if src >= PEIR_REG_SLOT {
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, peir_value_reg(src - PEIR_REG_SLOT));
    } else {
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, src);
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
    }
}

/// `reg` = a value: its constant, or its stack slot.
fn PeirGen_load_operand(self: &mut PeirGen, reg: i64, value: i64, frame: &PeStackFrame) -> void {
    if pe_idmap_has(&frame.const_vals, value) {
        PeirEnc_mov_imm(&mut self.enc, reg, pe_idmap_get(&frame.const_vals, value));
    } else {
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, reg, PeStackFrame_offset(frame, value));
    }
}

/// The element-code word of a Vec of bytes (u8 or bool): core's
/// vec_code_word(1), P_VEC_TAG + 1 + 8 (release D14).
const PEIR_VEC_BYTES: i64 = 0x4649445645430009;

/// Is `v` typed as a Vec of u8 or bool (its code is most likely bytes)?
fn peir_vec_bytes_typed(func: &IrFunction, v: i64) -> bool {
    match IrFunction_get_meta(func, v) {
        OptValueMeta::Some(m) => {
            match m.ty {
                IrType::Generic(n, args) => {
                    if n == "Vec" && args.len() == 1 {
                        match args.get(0) {
                            IrType::U8 => { return true; }
                            IrType::Bool => { return true; }
                            _ => {}
                        }
                    }
                }
                _ => {}
            }
        }
        OptValueMeta::None => {}
    }
    return false;
}

/// A cold path: its kind (1 get, 2 set, 3 push), entry and return labels,
/// whether the hot path tried bytes first; emitted after the function.
fn peir_cold_add(frame: &mut PeStackFrame, kind: i64, entry: i64, back: i64, bytes: bool) {
    frame.cold.push(kind);
    frame.cold.push(entry);
    frame.cold.push(back);
    if bytes { frame.cold.push(1); } else { frame.cold.push(0); }
}

/// rdx = element rcx of the Vec at rax, of one word or one byte
fn PeirGen_vec_load_word(self: &mut PeirGen) {
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_mov_r_idx8(&mut self.enc, PEIR_RDX, PEIR_RDX, PEIR_RCX);
}

fn PeirGen_vec_load_byte(self: &mut PeirGen) {
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_movzx_r_byte_idx(&mut self.enc, PEIR_RDX, PEIR_RDX, PEIR_RCX);
}

/// Vec_len, Vec_get, Vec_set and Vec_push (core.fd), the hottest calls of
/// most programs: their common case at the call site, the rest a call to
/// core's function out of line (after the function, so the common case
/// falls through). Bounds checks are unsigned, so a negative index fails
/// them too. A Vec of words or of bytes (release D14) takes the inline
/// path; which is tried first follows the Vec's static type. The `__env`
/// argument, when present, is first. True when the call was generated.
fn PeirGen_inline_vec_call(self: &mut PeirGen, name: str, args: Vec<i64>, dst: i64, frame: &mut PeStackFrame, func: &IrFunction) -> bool {
    if self.bare_mode { return false; }
    if name == "Vec_len" && args.len() >= 1 {
        PeirGen_load_operand(self, PEIR_RAX, args.get(args.len() - 1), frame);
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RAX, 8);
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        return true;
    }
    if name == "Vec_get" && args.len() >= 2 {
        var gv: i64 = args.get(args.len() - 2);
        PeirGen_load_operand(self, PEIR_RAX, gv, frame);
        PeirGen_load_operand(self, PEIR_RCX, args.get(args.len() - 1), frame);
        if !self.cur_unchecked {
            PeirEnc_cmp_r_mem(&mut self.enc, PEIR_RCX, PEIR_RAX, 8);
            PeirGen_jump_panic(self, 0x3, PEIR_PANIC_VEC_INDEX); // jae
        }
        if !HashMap_contains(self.func_labels, "Vec_get") {
            PeirGen_vec_load_word(self);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RDX);
            return true;
        }
        var gcold: i64 = PeirEnc_alloc_label(&mut self.enc);
        var gdone: i64 = PeirEnc_alloc_label(&mut self.enc);
        var gbytes: bool = peir_vec_bytes_typed(func, gv);
        if gbytes {
            PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, PEIR_VEC_BYTES);
            PeirEnc_cmp_r_mem(&mut self.enc, PEIR_R9, PEIR_RAX, 24);
            PeirEnc_jcc_label(&mut self.enc, 0x5, gcold); // jne
            PeirGen_vec_load_byte(self);
        } else {
            PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 24, 0);
            PeirEnc_jcc_label(&mut self.enc, 0x5, gcold); // jnz
            PeirGen_vec_load_word(self);
        }
        PeirEnc_place_label(&mut self.enc, gdone);
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RDX);
        peir_cold_add(frame, 1, gcold, gdone, gbytes);
        return true;
    }
    if name == "Vec_set" && args.len() >= 3 {
        var sv: i64 = args.get(args.len() - 3);
        PeirGen_load_operand(self, PEIR_RAX, sv, frame);
        PeirGen_load_operand(self, PEIR_RCX, args.get(args.len() - 2), frame);
        PeirGen_load_operand(self, PEIR_RDX, args.get(args.len() - 1), frame);
        if !self.cur_unchecked {
            PeirEnc_cmp_r_mem(&mut self.enc, PEIR_RCX, PEIR_RAX, 8);
            PeirGen_jump_panic(self, 0x3, PEIR_PANIC_VEC_INDEX); // jae
        }
        if !HashMap_contains(self.func_labels, "Vec_set") {
            PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
            PeirEnc_mov_idx8_r(&mut self.enc, PEIR_R8, PEIR_RCX, PEIR_RDX);
            return true;
        }
        var scold: i64 = PeirEnc_alloc_label(&mut self.enc);
        var sdone: i64 = PeirEnc_alloc_label(&mut self.enc);
        var sbytes: bool = peir_vec_bytes_typed(func, sv);
        // Shared data (negative capacity: core's Vec_set copies it first),
        // elements the Vec owns (type at +32, proposal 0004: core drops the
        // old one) and the other element size go to the cold path
        PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 16, 0);
        PeirEnc_jcc_label(&mut self.enc, 0xC, scold); // jl
        if sbytes {
            PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, PEIR_VEC_BYTES);
            PeirEnc_cmp_r_mem(&mut self.enc, PEIR_R9, PEIR_RAX, 24);
            PeirEnc_jcc_label(&mut self.enc, 0x5, scold); // jne
            PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 32, 0);
            PeirEnc_jcc_label(&mut self.enc, 0x5, scold); // jne
            PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
            PeirEnc_mov_byte_idx_r(&mut self.enc, PEIR_R8, PEIR_RCX, PEIR_RDX);
        } else {
            PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R8, PEIR_RAX, 24);
            PeirEnc_or_r_mem(&mut self.enc, PEIR_R8, PEIR_RAX, 32);
            PeirEnc_jcc_label(&mut self.enc, 0x5, scold); // jnz
            PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
            PeirEnc_mov_idx8_r(&mut self.enc, PEIR_R8, PEIR_RCX, PEIR_RDX);
        }
        PeirEnc_place_label(&mut self.enc, sdone);
        peir_cold_add(frame, 2, scold, sdone, sbytes);
        return true;
    }
    // Vec_push with room in the buffer; growing stays a call
    if name == "Vec_push" && args.len() == 3 && HashMap_contains(self.func_labels, "Vec_push") {
        var pcold: i64 = PeirEnc_alloc_label(&mut self.enc);
        var pdone: i64 = PeirEnc_alloc_label(&mut self.enc);
        var pbytes: bool = peir_vec_bytes_typed(func, args.get(1));
        PeirGen_load_operand(self, PEIR_RAX, args.get(1), frame);
        PeirGen_load_operand(self, PEIR_RCX, args.get(2), frame);
        if pbytes {
            PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, PEIR_VEC_BYTES);
            PeirEnc_cmp_r_mem(&mut self.enc, PEIR_R9, PEIR_RAX, 24);
            PeirEnc_jcc_label(&mut self.enc, 0x5, pcold); // jne
        } else {
            // Elements at their size (D14, element code at +24): the call
            PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 24, 0);
            PeirEnc_jcc_label(&mut self.enc, 0x5, pcold); // jnz
        }
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_RAX, 8);
        // signed: a shared Vec's capacity is negative and takes the call
        PeirEnc_cmp_r_mem(&mut self.enc, PEIR_RDX, PEIR_RAX, 16);
        PeirEnc_jcc_label(&mut self.enc, 0xD, pcold); // jge
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
        if pbytes {
            PeirEnc_mov_byte_idx_r(&mut self.enc, PEIR_R8, PEIR_RDX, PEIR_RCX);
        } else {
            PeirEnc_mov_idx8_r(&mut self.enc, PEIR_R8, PEIR_RDX, PEIR_RCX);
        }
        PeirEnc_inc_r(&mut self.enc, PEIR_RDX);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 8, PEIR_RDX);
        PeirEnc_place_label(&mut self.enc, pdone);
        peir_cold_add(frame, 3, pcold, pdone, false);
        return true;
    }
    return false;
}

/// The cold paths of the function's inline Vec calls (inline_vec_call):
/// the other element size, else the call to core. Registers as the hot
/// path left them: rax the Vec, rcx the index (push: the value), rdx the
/// value (get: the result).
fn PeirGen_emit_cold(self: &mut PeirGen, frame: &mut PeStackFrame) {
    var i: i64 = 0;
    while i + 3 < frame.cold.len() {
        var kind: i64 = frame.cold.get(i);
        var entry: i64 = frame.cold.get(i + 1);
        var back: i64 = frame.cold.get(i + 2);
        var bytes: bool = frame.cold.get(i + 3) == 1;
        PeirEnc_place_label(&mut self.enc, entry);
        var slow: i64 = PeirEnc_alloc_label(&mut self.enc);
        if kind == 1 {
            // the other element size, else core's Vec_get
            if bytes {
                PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 24, 0);
                PeirEnc_jcc_label(&mut self.enc, 0x5, slow);
                PeirGen_vec_load_word(self);
            } else {
                PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, PEIR_VEC_BYTES);
                PeirEnc_cmp_r_mem(&mut self.enc, PEIR_R9, PEIR_RAX, 24);
                PeirEnc_jcc_label(&mut self.enc, 0x5, slow);
                PeirGen_vec_load_byte(self);
            }
            PeirEnc_jmp_label(&mut self.enc, back);
            PeirEnc_place_label(&mut self.enc, slow);
            PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RCX);
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
            PeirEnc_xor_self(&mut self.enc, PEIR_RCX);
            PeirEnc_sub_rsp_i32(&mut self.enc, 32);
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "Vec_get"));
            PeirEnc_add_rsp_i32(&mut self.enc, 32);
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
            PeirEnc_jmp_label(&mut self.enc, back);
        } else if kind == 2 {
            // not shared and not owning: the other element size
            PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 16, 0);
            PeirEnc_jcc_label(&mut self.enc, 0xC, slow);
            PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 32, 0);
            PeirEnc_jcc_label(&mut self.enc, 0x5, slow);
            if bytes {
                PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 24, 0);
                PeirEnc_jcc_label(&mut self.enc, 0x5, slow);
                PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
                PeirEnc_mov_idx8_r(&mut self.enc, PEIR_R8, PEIR_RCX, PEIR_RDX);
            } else {
                PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, PEIR_VEC_BYTES);
                PeirEnc_cmp_r_mem(&mut self.enc, PEIR_R9, PEIR_RAX, 24);
                PeirEnc_jcc_label(&mut self.enc, 0x5, slow);
                PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
                PeirEnc_mov_byte_idx_r(&mut self.enc, PEIR_R8, PEIR_RCX, PEIR_RDX);
            }
            PeirEnc_jmp_label(&mut self.enc, back);
            PeirEnc_place_label(&mut self.enc, slow);
            PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RDX);
            PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RCX);
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
            PeirEnc_xor_self(&mut self.enc, PEIR_RCX);
            PeirEnc_sub_rsp_i32(&mut self.enc, 32);
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "Vec_set"));
            PeirEnc_add_rsp_i32(&mut self.enc, 32);
            PeirEnc_jmp_label(&mut self.enc, back);
        } else {
            // push: grow, share, or another element size
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
            PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RCX);
            PeirEnc_xor_self(&mut self.enc, PEIR_RCX);
            PeirEnc_sub_rsp_i32(&mut self.enc, 32);
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "Vec_push"));
            PeirEnc_add_rsp_i32(&mut self.enc, 32);
            PeirEnc_jmp_label(&mut self.enc, back);
        }
        i = i + 4;
    }
    frame.cold.clear();
}

/// rax = the value of `rax` in narrow type `ty`; panics (stub `panic` >= 0)
/// instead if it changes. Not a narrow type: nothing.
fn PeirGen_gen_narrow(self: &mut PeirGen, ty: IrType, panic: i64) -> void {
    match ty {
        IrType::I8 => { PeirEnc_movsx_r64_r8(&mut self.enc, PEIR_RDX, PEIR_RAX); }
        IrType::I16 => { PeirEnc_movsx_r64_r16(&mut self.enc, PEIR_RDX, PEIR_RAX); }
        IrType::I32 => { PeirEnc_movsxd_rr(&mut self.enc, PEIR_RDX, PEIR_RAX); }
        IrType::U8 => { PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RDX, PEIR_RAX); }
        IrType::U16 => { PeirEnc_movzx_r32_r16(&mut self.enc, PEIR_RDX, PEIR_RAX); }
        IrType::U32 => { PeirEnc_mov_r32_r32(&mut self.enc, PEIR_RDX, PEIR_RAX); }
        _ => { return; }
    }
    if panic >= 0 {
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        PeirGen_jump_panic(self, 0x5, panic);
    }
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
}

/// rax / rcx or rax % rcx. Dividing by zero panics, even in @wrapping code;
/// idiv also traps on MIN / -1, so -1 never reaches it. A constant divisor
/// needs neither check.
fn peir_emit_shift(e: &mut PeirEnc, op: i64, k: i64) {
    e.code.push(0x48);
    e.code.push(0xC1);
    e.code.push(op);
    e.code.push(k);
}

/// rax / d or rax % d, signed, for a constant d >= 2: no idiv. The quotient
/// truncates toward zero, as idiv's does.
fn PeirGen_gen_div_const(self: &mut PeirGen, is_mod: bool, d: i64) -> void {
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX); // rcx = n
    PeirGen_gen_div_const_n(self, is_mod, d, false);
    if is_mod { PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX); }
}

/// n / d in rax, or n % d in rcx, of n in rax and rcx. `nonneg`: n >= 0
/// (range analysis), so the quotient needs no rounding toward zero.
fn PeirGen_gen_div_const_n(self: &mut PeirGen, is_mod: bool, d: i64, nonneg: bool) -> void {
    if nonneg && (d & (d - 1)) == 0 {
        var k0: i64 = 0;
        while (1 << k0) < d { k0 = k0 + 1; }
        peir_emit_shift(&mut self.enc, 0xF8, k0); // sar rax, k
    } else if nonneg {
        var magic0: Vec<i64> = peir_div_magic(d);
        var m0: i64 = magic0.get(0);
        var s0: i64 = magic0.get(1);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, m0);
        peir_emit2(&mut self.enc, 0x48, 0xF7);
        PeirEnc_emit_u8(&mut self.enc, 0xE9); // imul rcx: rdx = high half
        if m0 < 0 { PeirEnc_add_rr(&mut self.enc, PEIR_RDX, PEIR_RCX); }
        if s0 > 0 { peir_emit_shift(&mut self.enc, 0xFA, s0); } // sar rdx, s
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    } else if (d & (d - 1)) == 0 {
        var k: i64 = 0;
        while (1 << k) < d { k = k + 1; }
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        peir_emit_shift(&mut self.enc, 0xFA, 63); // sar rdx, 63
        peir_emit_shift(&mut self.enc, 0xEA, 64 - k); // shr rdx, 64 - k
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
        peir_emit_shift(&mut self.enc, 0xF8, k); // sar rax, k
    } else {
        var magic: Vec<i64> = peir_div_magic(d);
        var m: i64 = magic.get(0);
        var s: i64 = magic.get(1);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, m);
        peir_emit2(&mut self.enc, 0x48, 0xF7);
        PeirEnc_emit_u8(&mut self.enc, 0xE9); // imul rcx: rdx = high half
        if m < 0 { PeirEnc_add_rr(&mut self.enc, PEIR_RDX, PEIR_RCX); }
        if s > 0 { peir_emit_shift(&mut self.enc, 0xFA, s); } // sar rdx, s
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
        peir_emit_shift(&mut self.enc, 0xE8, 63); // shr rax, 63
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    }
    if is_mod {
        if d <= 2147483647 {
            PeirEnc_imul_r_r_imm(&mut self.enc, PEIR_RAX, PEIR_RAX, d);
        } else {
            PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, d);
            PeirEnc_imul_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
        }
        PeirEnc_sub_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    }
}

fn PeirGen_gen_int_div(self: &mut PeirGen, is_mod: bool, rconst: OptU64, ty: IrType, checked: bool) -> void {
    var may_be_zero: bool = true;
    var may_be_m1: bool = true;
    match rconst {
        OptU64::Some(v) => {
            may_be_zero = v == 0;
            may_be_m1 = v == -1;
        }
        OptU64::None => {}
    }
    match rconst {
        OptU64::Some(d) => {
            if d >= 2 && !(ir_type_eq(ty, IrType::U8) || ir_type_eq(ty, IrType::U16)
                || ir_type_eq(ty, IrType::U32) || ir_type_eq(ty, IrType::U64)) {
                PeirGen_gen_div_const(self, is_mod, d);
                return;
            }
        }
        OptU64::None => {}
    }
    if may_be_zero {
        PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        if is_mod { PeirGen_jump_panic(self, 0x4, PEIR_PANIC_MOD_ZERO); }
        else { PeirGen_jump_panic(self, 0x4, PEIR_PANIC_DIV_ZERO); }
    }
    var unsigned: bool = ir_type_eq(ty, IrType::U8) || ir_type_eq(ty, IrType::U16)
        || ir_type_eq(ty, IrType::U32) || ir_type_eq(ty, IrType::U64);
    if unsigned {
        PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
        PeirEnc_div_rr(&mut self.enc, PEIR_RCX);
    } else if may_be_m1 {
        var normal: i64 = PeirEnc_alloc_label(&mut self.enc);
        var done: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, -1);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RCX, PEIR_RDX);
        PeirEnc_jcc_label(&mut self.enc, 0x5, normal);
        if is_mod {
            PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
        } else {
            PeirEnc_neg_r(&mut self.enc, PEIR_RAX);
            if checked && ir_type_eq(ty, IrType::I64) {
                PeirGen_jump_panic(self, 0x0, PEIR_PANIC_DIV_OVF);
            }
        }
        PeirEnc_jmp_label(&mut self.enc, done);
        PeirEnc_place_label(&mut self.enc, normal);
        PeirEnc_cqo(&mut self.enc);
        PeirEnc_idiv_r(&mut self.enc, PEIR_RCX);
        PeirEnc_place_label(&mut self.enc, done);
    } else {
        PeirEnc_cqo(&mut self.enc);
        PeirEnc_idiv_r(&mut self.enc, PEIR_RCX);
    }
    if is_mod {
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    }
}

/// Exception code `code`: panic with `msg`, else fall through.
fn PeirGen_crash_case(self: &mut PeirGen, code: i64, msg: str, report: i64) -> void {
    var next: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, code);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, next);
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, msg));
    PeirEnc_jmp_label(&mut self.enc, report);
    PeirEnc_place_label(&mut self.enc, next);
}

/// The shared stubs behind the arithmetic panics, and the handler turning a
/// CPU fault into a panic with a message.
pub fn PeirGen_gen_arith_panics(self: &mut PeirGen) -> void {
    var panic: i64 = HashMap_get(self.func_labels, "p_panic");
    var msgs: Vec<str> = peir_arith_panic_strings();
    var i: i64 = 0;
    while i < msgs.len() {
        PeirEnc_place_label(&mut self.enc, self.arith_panics.get(i));
        PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, msgs.get(i)));
        PeirEnc_sub_rsp_i32(&mut self.enc, 32);
        PeirEnc_call_label(&mut self.enc, panic);
        PeirEnc_ud2(&mut self.enc);
        i = i + 1;
    }

    // LONG handler(EXCEPTION_POINTERS* rcx): [[rcx]] is the exception code.
    // A vectored handler: these executables have no unwind tables, so the
    // system's frame walk gives up before any unhandled-exception filter
    // would run. It sees first-chance exceptions too, so anything but these
    // fatal codes goes on searching.
    PeirEnc_place_label(&mut self.enc, self.crash_filter);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_mov_r32_r32(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var report: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirGen_crash_case(self, 0xC00000FD, "Stack overflow", report);
    PeirGen_crash_case(self, 0xC0000005, "Invalid memory access (null or dangling pointer)", report);
    PeirGen_crash_case(self, 0xC0000094, "Division by zero", report);
    PeirGen_crash_case(self, 0xC000001D, "Illegal instruction", report);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX); // EXCEPTION_CONTINUE_SEARCH
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, report);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    PeirEnc_call_label(&mut self.enc, panic);
    PeirEnc_ud2(&mut self.enc);
}

/// Generate float binary operation.
pub fn PeirGen_gen_float_binop(self: &mut PeirGen, op: BinOp, loff: i64, roff: i64, dst: i64, ty: IrType) -> void {
    var is_f32: bool = ir_type_eq(ty, IrType::F32);
    if is_f32 {
        PeirEnc_movss_xmm_mem_rbp(&mut self.enc, 0, loff);
        PeirEnc_movss_xmm_mem_rbp(&mut self.enc, 1, roff);
    } else {
        PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, loff);
        PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 1, roff);
    }
    if pe_binop_is_arith(op) {
        match op {
            BinOp::Add => {
                if is_f32 { PeirEnc_addss(&mut self.enc, 0, 1); }
                else { PeirEnc_addsd(&mut self.enc, 0, 1); }
            }
            BinOp::Sub => {
                if is_f32 { PeirEnc_subss(&mut self.enc, 0, 1); }
                else { PeirEnc_subsd(&mut self.enc, 0, 1); }
            }
            BinOp::Mul => {
                if is_f32 { PeirEnc_mulss(&mut self.enc, 0, 1); }
                else { PeirEnc_mulsd(&mut self.enc, 0, 1); }
            }
            _ => {
                if is_f32 { PeirEnc_divss(&mut self.enc, 0, 1); }
                else { PeirEnc_divsd(&mut self.enc, 0, 1); }
            }
        }
        if is_f32 {
            PeirEnc_movss_mem_rbp_xmm(&mut self.enc, dst, 0);
        } else {
            PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, dst, 0);
        }
    } else if pe_binop_is_cmp(op) {
        // IEEE: every comparison with NaN is false, except !=. An
        // unordered ucomis sets ZF, PF and CF, so: a < b is b > a
        // (seta: CF = ZF = 0), a <= b is b >= a (setae: CF = 0), and
        // == / != also look at PF.
        var a: i64 = 0;
        var b: i64 = 1;
        match op {
            BinOp::Lt => { a = 1; b = 0; }
            BinOp::LtEq => { a = 1; b = 0; }
            _ => { a = 0; b = 1; }
        }
        if is_f32 {
            PeirEnc_ucomiss(&mut self.enc, a, b);
        } else {
            PeirEnc_ucomisd(&mut self.enc, a, b);
        }
        match op {
            BinOp::Eq => {
                PeirEnc_setcc_r(&mut self.enc, 0x4, PEIR_RAX); // sete al
                PeirEnc_setcc_r(&mut self.enc, 0xB, PEIR_RCX); // setnp cl
                peir_emit2(&mut self.enc, 0x20, 0xC8);           // and al, cl
            }
            BinOp::Neq => {
                PeirEnc_setcc_r(&mut self.enc, 0x5, PEIR_RAX); // setne al
                PeirEnc_setcc_r(&mut self.enc, 0xA, PEIR_RCX); // setp cl
                peir_emit2(&mut self.enc, 0x08, 0xC8);           // or al, cl
            }
            BinOp::Lt => {
                PeirEnc_setcc_r(&mut self.enc, 0x7, PEIR_RAX); // seta
            }
            BinOp::Gt => {
                PeirEnc_setcc_r(&mut self.enc, 0x7, PEIR_RAX); // seta
            }
            _ => {
                PeirEnc_setcc_r(&mut self.enc, 0x3, PEIR_RAX); // setae
            }
        }
        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
    }
}

// ===========================================================================
// pe_ir_generate_pe (src/pe.rs) — public entry point
// ===========================================================================

/// Public entry point: generate a PE file from an IR module. Fails when the
/// program calls runtime functions this native backend does not provide.
/// `fid emit --bare` (release G2): a flat x86-64 binary, no OS and no C
/// library. `panic_handler` is the program's @panic_handler function, or "".
pub fn pe_ir_generate_flat(module: IrModule, panic_handler: str) -> ResultBytes {
    if !pe_module_has_fn(&module, "main") {
        return ResultBytes::Err(c_vec1("bare-metal build: the program has no `main` function"));
    }
    g_pe_bare_panic_handler = panic_handler;
    g_pe_asm_errors = Vec::new();
    var gen: PeirGen = PeirGen_new();
    gen.bare_mode = true;
    var bytes: Vec = PeirGen_generate(&mut gen, &module);
    if g_pe_asm_errors.len() > 0 {
        return ResultBytes::Err(g_pe_asm_errors);
    }
    var reachable: Vec<str> = pe_ir_reachable_functions(&module);
    var names: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < gen.unresolved.len() {
        var u: UnresolvedCall = gen.unresolved.get(i);
        var j: i64 = 0;
        var hit: bool = false;
        while j < u.callers.len() {
            if pe_ir_strs_contains(reachable, u.callers.get(j)) { hit = true; }
            j = j + 1;
        }
        if hit { names.push(u.name); }
        i = i + 1;
    }
    if names.len() > 0 {
        return ResultBytes::Err(c_vec1("bare-metal build: no OS or C library to provide: "
            + str_join(names, ", ")));
    }
    return ResultBytes::Ok(bytes);
}

/// `fid emit --elf` (release F4, first step): a static Linux x86-64
/// executable from the same machine code as the Windows and bare builds.
/// For now it is the bare build's runtime (print, heap, panic, exit through
/// Linux system calls), so a program built without the stdlib runs; the
/// stdlib needs the runtime of stdlib/pe_runtime on Linux (what is left).
/// Layout: ELF header and one program header, then at 0x401000 the flat
/// binary ([code][data], entered at its first byte), one RWX segment.
pub fn pe_ir_generate_elf(module: IrModule) -> ResultBytes {
    g_pe_elf = true;
    var saved_load: i64 = g_pe_bare_load;
    g_pe_bare_load = 0x401000;
    var flat_res: ResultBytes = pe_ir_generate_flat(module, "");
    g_pe_elf = false;
    g_pe_bare_load = saved_load;
    match flat_res {
        ResultBytes::Err(e) => { return ResultBytes::Err(e); }
        ResultBytes::Ok(flat) => {
            var out: Vec = Vec::new();
            var total: i64 = 0x1000 + flat.len();
            // ELF header
            out.push(0x7F); out.push(0x45); out.push(0x4C); out.push(0x46);
            out.push(2); out.push(1); out.push(1); out.push(0);     // 64-bit, LE, v1, SysV
            out = pe_push_u64(out, 0);                               // padding
            out.push(2); out.push(0);                                // ET_EXEC
            out.push(0x3E); out.push(0);                             // EM_X86_64
            out = pe_push_u32(out, 1);                               // e_version
            out = pe_push_u64(out, 0x401000);                        // e_entry
            out = pe_push_u64(out, 64);                              // e_phoff
            out = pe_push_u64(out, 0);                               // e_shoff
            out = pe_push_u32(out, 0);                               // e_flags
            out.push(64); out.push(0);                               // e_ehsize
            out.push(56); out.push(0);                               // e_phentsize
            out.push(1); out.push(0);                                // e_phnum
            out.push(64); out.push(0);                               // e_shentsize
            out.push(0); out.push(0);                                // e_shnum
            out.push(0); out.push(0);                                // e_shstrndx
            // PT_LOAD: the whole file at 0x400000, read/write/execute
            out = pe_push_u32(out, 1);                               // p_type
            out = pe_push_u32(out, 7);                               // p_flags RWX
            out = pe_push_u64(out, 0);                               // p_offset
            out = pe_push_u64(out, 0x400000);                        // p_vaddr
            out = pe_push_u64(out, 0x400000);                        // p_paddr
            out = pe_push_u64(out, total);                           // p_filesz
            out = pe_push_u64(out, total);                           // p_memsz
            out = pe_push_u64(out, 0x1000);                          // p_align
            while out.len() < 0x1000 { out.push(0); }
            var i: i64 = 0;
            while i < flat.len() {
                out.push(flat.get(i));
                i = i + 1;
            }
            return ResultBytes::Ok(out);
        }
    }
    return ResultBytes::Err(c_vec1("unreachable"));
}

pub fn pe_ir_generate_pe(module: IrModule) -> ResultBytes {
    // The entry point calls main (it used to panic when there was none).
    if !pe_module_has_fn(&module, "main") {
        return ResultBytes::Err(c_vec1("PE backend: the program has no `main` function"));
    }
    var gen: PeirGen = PeirGen_new();
    var bytes: Vec = PeirGen_generate(&mut gen, &module);
    var reachable: Vec<str> = pe_ir_reachable_functions(&module);
    var names: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < gen.unresolved.len() {
        var u: UnresolvedCall = gen.unresolved.get(i);
        var j: i64 = 0;
        var hit: bool = false;
        while j < u.callers.len() {
            if pe_ir_strs_contains(reachable, u.callers.get(j)) { hit = true; }
            j = j + 1;
        }
        if hit { names.push(u.name); }
        i = i + 1;
    }
    if names.len() > 0 {
        var msg: str = "PE backend: not available in native Windows executables: "
            + str_join(names, ", ") + " (build with `fidesc ccompile` instead)";
        return ResultBytes::Err(c_vec1(msg));
    }
    return ResultBytes::Ok(bytes);
}
