// pe_ir.fd -- IR -> PE32+ executable backend: instruction-lowering half.
// Ported from src/pe.rs: PeStackFrame, PeirGen::generate, gen_function,
// gen_inst, gen_int_binop, gen_float_binop and the public pe_ir_generate_pe
// entry point.  The PeirGen state, the machine-code runtime stub
// generators and the reachability analysis live in
// compiler::pe_ir_stubs; the x86-64 encoder, the .rdata builder and the
// PE file writer live in compiler::pe_ir_enc.
//
// Adaptations from Rust:
// 1. HashMap<u32, i64> / HashMap<(String,u32), u32> -> i64 handles
//    (HashMap_get returns 0 when absent; the Rust code's unwrap_or(&0)
//    makes that the correct default for both stack offsets and labels)
// 2. BTreeMap/BTreeSet -> sorted Vec<str> + linear contains
// 3. Option<ValueId> -> OptValueId, Option<IrType> -> OptIrType
// 4. or-patterns -> separate match arms (Fides doesn't support `|`)
// 5. ConstFloat stores the f64 value (not bits) -> p_f64_to_bits /
//    p_f32_to_bits, as in codegen_c
// 6. Rust `emit(&[b0, b1, ...])` -> one PeirEnc_emit_u8 per byte,
//    grouped through peir_emit2/peir_emit8

module compiler::pe_ir;
use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::pe_ir_enc;
use compiler::pe_ir_stubs;
use compiler::checks;
use compiler::inc;
use compiler::ast_ser;
use compiler::ir_ser;
use compiler::token;
use compiler::lexer;
use compiler::parser;
use compiler::pdb;
use compiler::cparser;
use compiler::pgo;
// ===========================================================================
// Stack frame (src/pe.rs PeStackFrame — mirrors x86.rs StackFrame)
// ===========================================================================

/// Key-value pair for the frame maps (Fides HashMap is string-keyed, so
/// integer-keyed maps use a linear-search entry list, as x86.fd does).
pub struct PeOffEnt {
    pub id: i64,
    pub offset: i64,
}

pub fn PeOffEnt_new(id: i64, offset: i64) -> PeOffEnt {
    return PeOffEnt {
        id: id, offset: offset
    };
}

/// Per-function stack layout: every IR value gets a slot at a negative
/// rbp offset, alloca data slots follow the value slots.
pub struct PeStackFrame {
    /// ValueId -> stack offset from rbp (entry list; 0 = absent).
    pub offsets: Vec<PeOffEnt>,
    /// Current frame size in bytes
    pub size: i64,
    /// Alloca ValueId -> data slot offset from rbp (entry list)
    pub alloca_slots: Vec<PeOffEnt>,
    /// ValueId -> known integer constant: use sites move the immediate
    /// straight into a register instead of loading the slot (item 81).
    pub const_vals: Vec<PeOffEnt>,
    /// Locals kept in a register: alloca id -> PEIR_REG_SLOT offset
    pub reg_vars: Vec<PeOffEnt>,
    /// Per value: 1 for a constant every use of which takes the immediate
    pub imm_only: Vec<i64>,
    /// Cold paths of inline Vec calls, emitted after the function: kind,
    /// entry label, return label, bytes first (four words each)
    pub cold: Vec<i64>,
}

pub fn PeStackFrame_new() -> PeStackFrame {
    return PeStackFrame {
        offsets: Vec::new(), size: 0, alloca_slots: Vec::new(), const_vals: Vec::new(), reg_vars: Vec::new(), imm_only: Vec::new(), cold: Vec::new(),
    };
}

/// `map[id] = value` (insert or overwrite, matching Rust's HashMap::insert).
fn pe_idmap_put(map: &mut Vec<PeOffEnt>, id: i64, value: i64) -> void {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).id == id {
            var e: PeOffEnt = map.get(i);
            e.offset = value;
            map.set(i, e);
            return;
        }
        i = i + 1;
    }
    map.push(PeOffEnt_new(id, value));
}

/// `map[id]`, or 0 when absent (as Rust's unwrap_or(&0)).
fn pe_idmap_get(map: &Vec<PeOffEnt>, id: i64) -> i64 {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).id == id {
            return map.get(i).offset;
        }
        i = i + 1;
    }
    return 0;
}

/// Whether `map` has an entry for `id`.
fn pe_idmap_has(map: &Vec<PeOffEnt>, id: i64) -> bool {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).id == id {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Allocate space for a value and return its (negative) rbp offset.
pub fn PeStackFrame_alloc(self: &mut PeStackFrame, id: i64, size: i64) -> i64 {
    var align: i64 = 8;
    if size <= 1 {
        align = 1;
    } else if size <= 2 {
        align = 2;
    } else if size <= 4 {
        align = 4;
    } else {
        align = 8;
    }
    self.size = (self.size + align - 1) & ~(align - 1);
    self.size = self.size + size;
    var offset: i64 = -self.size;
    pe_idmap_put(&mut self.offsets, id, offset);
    return offset;
}

/// Allocate raw space (not tied to a ValueId) and return its offset.
pub fn PeStackFrame_alloc_raw(self: &mut PeStackFrame, size: i64) -> i64 {
    var align: i64 = 8;
    if size <= 1 {
        align = 1;
    } else if size <= 2 {
        align = 2;
    } else if size <= 4 {
        align = 4;
    } else {
        align = 8;
    }
    self.size = (self.size + align - 1) & ~(align - 1);
    self.size = self.size + size;
    return -self.size;
}

/// The stack offset of a value (0 when absent, as unwrap_or(&0)).
pub fn PeStackFrame_offset(self: &PeStackFrame, id: i64) -> i64 {
    return pe_idmap_get(&self.offsets, id);
}

// ===========================================================================
// Small helpers (BTreeSet<BTreeMap> stand-ins, block label keys, byte emit)
// ===========================================================================

/// Linear-scan membership for Vec<str>.
fn pe_ir_strs_contains(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The Fides runtime functions the executable needs (ir.fd
/// pe_ir_needed_functions), and under `--leaks` (RL16) also what the
/// p_malloc / p_free thunks and the exit hook call: pert_leak_malloc,
/// pert_leak_free, pert_leak_exit. Known-bugs 2g.81: without them as
/// roots, nat_frame_ret / nat_frame_next (pe_lk_walk's stack walk) were
/// not wanted, stayed ud2, and every --leaks image stopped with an
/// illegal instruction at its first allocation.
fn pe_ir_needed_fns(module: &IrModule) -> Vec<str> {
    var needed: Vec<str> = pe_ir_needed_functions(module);
    if !g_pe_leaks {
        return needed;
    }
    var roots: Vec<str> = Vec::new();
    if pe_module_has_fn(module, "pert_leak_malloc") {
        roots.push("pert_leak_malloc");
    }
    if pe_module_has_fn(module, "pert_leak_free") {
        roots.push("pert_leak_free");
    }
    if pe_module_has_fn(module, "pert_leak_exit") {
        roots.push("pert_leak_exit");
    }
    if roots.len() == 0 {
        return needed;
    }
    var more: Vec<str> = pe_ir_reachable_from(module, roots);
    var i: i64 = 0;
    while i < more.len() {
        needed = pe_ir_strs_insert_sorted(needed, more.get(i));
        i = i + 1;
    }
    return needed;
}

/// Insert `s` into sorted Vec<str> `v` (BTreeSet<String>::insert).
fn pe_ir_strs_insert_sorted(v: Vec<str>, s: str) -> Vec<str> {
    var v = v;
    var i: i64 = 0;
    while i < v.len() {
        var c: i64 = str_compare(v.get(i), s);
        if c == 0 {
            return v;
        }
        if c > 0 {
            v.push(v.get(v.len() - 1));
            var j: i64 = v.len() - 1;
            while j > i {
                v.set(j, v.get(j - 1));
                j = j - 1;
            }
            v.set(i, s);
            return v;
        }
        i = i + 1;
    }
    v.push(s);
    return v;
}

/// Insertion-sort a Vec<str> with str_compare (deterministic BTree order).
fn pe_ir_sort_strs(v: Vec<str>) -> Vec<str> {
    var v = v;
    var i: i64 = 1;
    while i < v.len() {
        var key: str = v.get(i);
        var j: i64 = i - 1;
        while j >= 0 && str_compare(v.get(j), key) > 0 {
            v.set(j + 1, v.get(j));
            j = j - 1;
        }
        v.set(j + 1, key);
        i = i + 1;
    }
    return v;
}

/// Insertion-sort a Vec<ValueIdInst> by instruction id (Rust sorts the
/// HashMap iteration into id order; ids are already dense but this keeps
/// the port faithful).
fn pe_sort_value_id_insts(v: Vec<ValueIdInst>) -> Vec<ValueIdInst> {
    var v = v;
    var i: i64 = 1;
    while i < v.len() {
        var key: ValueIdInst = v.get(i);
        var j: i64 = i - 1;
        while j >= 0 && v.get(j).id > key.id {
            v.set(j + 1, v.get(j));
            j = j - 1;
        }
        v.set(j + 1, key);
        i = i + 1;
    }
    return v;
}

/// Insertion-sort a Vec<ValueIdMeta> by value id.
fn pe_sort_value_id_metas(v: Vec<ValueIdMeta>) -> Vec<ValueIdMeta> {
    var v = v;
    var i: i64 = 1;
    while i < v.len() {
        var key: ValueIdMeta = v.get(i);
        var j: i64 = i - 1;
        while j >= 0 && v.get(j).id > key.id {
            v.set(j + 1, v.get(j));
            j = j - 1;
        }
        v.set(j + 1, key);
        i = i + 1;
    }
    return v;
}

/// The block_labels map key: Rust (String, u32) tuple -> "func:block".
fn pe_block_key(func_name: str, block_id: i64) -> str {
    return func_name + ":" + int_to_str(block_id);
}

/// Index of `pledge_name` in module.extern_functions, or -1
/// (Rust: module.extern_functions.get(&pledge_name) -> Option).
fn pe_extern_sig_index(module: &IrModule, pledge_name: str) -> i64 {
    var i: i64 = 0;
    while i < module.extern_functions.len() {
        if module.extern_functions.get(i).name == pledge_name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// IrType::Ptr(_) predicate (Rust `matches!(t, IrType::Ptr(_))`).
fn pe_is_ptr(t: IrType) -> bool {
    match t {
        IrType::Ptr(_) => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// Arithmetic operators (the float-binop first arm).
fn pe_binop_is_arith(op: BinOp) -> bool {
    match op {
        BinOp::Add => {
            return true;
        }
        BinOp::Sub => {
            return true;
        }
        BinOp::Mul => {
            return true;
        }
        BinOp::Div => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// Comparison operators (the float-binop second arm).
fn pe_binop_is_cmp(op: BinOp) -> bool {
    match op {
        BinOp::Eq => {
            return true;
        }
        BinOp::Neq => {
            return true;
        }
        BinOp::Lt => {
            return true;
        }
        BinOp::Gt => {
            return true;
        }
        BinOp::LtEq => {
            return true;
        }
        BinOp::GtEq => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// Is `func` an interrupt handler (iretq, every register saved)? `interrupt
/// fn`, and in the bootable bare image also an `@interrupt(N)` function,
/// which the boot code wires to vector N (release G1).
fn peir_is_interrupt(self: &PeirGen, func: &IrFunction) -> bool {
    if func.is_interrupt {
        return true;
    }
    return self.bare_mode && pe_bare_boot_on() && func.interrupt_vector >= 0;
}

/// Does this interrupt vector push an error code?
/// (#DF=0x08, #TS=0x0A, #NP=0x0B, #SS=0x0C, #GP=0x0D, #PF=0x0E, #AC=0x11,
///  #CP=0x1E; interrupt_vector is -1 when the function has none)
fn pe_interrupt_has_err(v: i64) -> bool {
    return v == 0x08 || v == 0x0A || v == 0x0B || v == 0x0C || v == 0x0D || v == 0x0E || v == 0x11 || v == 0x1E;
}

/// Trim `chars` bytes from both ends of `s` (Rust trim_matches).
fn pe_str_contains_char(chars: str, ch: i64) -> bool {
    var i: i64 = 0;
    while i < str_len(chars) {
        if str_byte_at(chars, i) == ch {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn pe_str_trim_chars(s: str, chars: str) -> str {
    var start: i64 = 0;
    var end: i64 = str_len(s);
    while start < end {
        if pe_str_contains_char(chars, str_byte_at(s, start)) {
            start = start + 1;
        } else {
            break;
        }
    }
    while end > start {
        if pe_str_contains_char(chars, str_byte_at(s, end - 1)) {
            end = end - 1;
        } else {
            break;
        }
    }
    return str_slice(s, start, end);
}

/// Raw byte emission (Rust `enc.emit(&[a, b])`).
fn peir_emit2(e: &mut PeirEnc, a: i64, b: i64) -> void {
    PeirEnc_emit_u8(e, a);
    PeirEnc_emit_u8(e, b);
}

fn peir_emit8(e: &mut PeirEnc, a: i64, b: i64, c: i64, d: i64, f: i64, g: i64, h: i64, i: i64) -> void {
    PeirEnc_emit_u8(e, a);
    PeirEnc_emit_u8(e, b);
    PeirEnc_emit_u8(e, c);
    PeirEnc_emit_u8(e, d);
    PeirEnc_emit_u8(e, f);
    PeirEnc_emit_u8(e, g);
    PeirEnc_emit_u8(e, h);
    PeirEnc_emit_u8(e, i);
}

/// OP17 (known-bugs 2g.13): xmm0 converted in place between the float
/// types: cvtss2sd xmm0, xmm0 (`to_f64`) or cvtsd2ss xmm0, xmm0.
/// OP21 (Nov 21 evening): BitCast(i64 word -> f32 value): the word holds
/// the single's f64 bits — movq xmm0, rax; cvtsd2ss; store the 4 bytes.
fn peir_pun_i64_f32(enc: & mut PeirEnc, voff: i64, dst: i64) {
    PeirEnc_mov_reg_mem_rbp(enc, PEIR_RAX, voff);
    peir_emit2(enc, 0x66, 0x48);
    peir_emit2(enc, 0x0F, 0x6E);
    PeirEnc_emit_u8(enc, 0xC0);
    peir_cvt_float(enc, false);
    peir_store_f32_xmm0(enc, dst);
}

/// OP21: BitCast(f32 value -> i64 word): cvtss2sd; movq rax, xmm0; store.
fn peir_pun_f32_i64(enc: & mut PeirEnc, voff: i64, dst: i64) {
    PeirEnc_movss_xmm_mem_rbp(enc, 0, voff);
    peir_cvt_float(enc, true);
    peir_emit2(enc, 0x66, 0x48);
    peir_emit2(enc, 0x0F, 0xD6);
    PeirEnc_emit_u8(enc, 0xC0);
    PeirEnc_mov_mem_rbp_reg(enc, dst, PEIR_RAX);
}

fn peir_cvt_float(e: &mut PeirEnc, to_f64: bool) -> void {
    if to_f64 {
        PeirEnc_emit_u8(e, 0xF3);
    } else {
        PeirEnc_emit_u8(e, 0xF2);
    }
    PeirEnc_emit_u8(e, 0x0F);
    PeirEnc_emit_u8(e, 0x5A);
    PeirEnc_emit_u8(e, 0xC0);
}

/// OP17: the f32 in xmm0 stored to `dst` as a whole word, its bits in the
/// low half and zeros above (movd eax, xmm0; mov [dst], rax), as
/// ConstFloat writes an f32 (an f32 never gets a register in pe_ir).
fn peir_store_f32_xmm0(e: &mut PeirEnc, dst: i64) -> void {
    PeirEnc_emit_u8(e, 0x66);
    PeirEnc_emit_u8(e, 0x0F);
    PeirEnc_emit_u8(e, 0x7E);
    PeirEnc_emit_u8(e, 0xC0);
    PeirEnc_mov_mem_rbp_reg(e, dst, PEIR_RAX);
}

/// The module's function names, sorted (Rust: keys of a sorted map).
fn pe_module_fn_names(module: &IrModule) -> Vec<str> {
    var v: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < module.functions.len() {
        v.push(module.functions.get(i).name);
        i = i + 1;
    }
    return pe_ir_sort_strs(v);
}

/// (type id, function label) for one dyn-call candidate
/// (Rust Vec<(i64, u32)>).
pub struct PeDynCandidate {
    pub tid: i64,
    pub label: i64,
}

/// The runtime stub names pre-allocated function labels, in the order of
/// the literal list in PeirGen::generate (src/pe.rs).
fn pe_runtime_stub_names() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("p_print_int");
    v.push("p_print_str");
    v.push("p_print_bool");
    v.push("p_print_float");
    v.push("p_panic");
    v.push("p_malloc");
    v.push("p_free");
    v.push("p_memset");
    v.push("p_str_concat");
    v.push("p_to_str");
    v.push("p_to_str_vec");
    v.push("p_to_str_float");
    v.push("p_to_str_str");
    v.push("p_to_str_bool");
    v.push("p_float_to_str");
    v.push("p_bool_to_str");
    v.push("p_char_to_str");
    v.push("p_eprint_str");
    v.push("p_print_newline");
    v.push("p_sb_new");
    v.push("p_sb_append");
    v.push("p_sb_to_str");
    v.push("p_file_read");
    v.push("p_file_write");
    v.push("p_str_join_n");
    v.push("p_vec_new");
    v.push("p_vec_push");
    v.push("p_vec_len");
    v.push("p_vec_get");
    v.push("p_vec_pop");
    v.push("p_print_vec");
    v.push("p_vec_set");
    v.push("p_vec_is_empty");
    v.push("p_vec_clear");
    v.push("p_vec_capacity");
    v.push("p_vec_contains");
    v.push("p_vec_first");
    v.push("p_vec_last");
    v.push("p_vec_truncate");
    v.push("p_vec_clone");
    v.push("p_map_new");
    v.push("p_map_insert");
    v.push("p_map_get");
    v.push("p_map_contains");
    v.push("p_map_remove");
    v.push("p_map_len");
    v.push("p_map_is_empty");
    v.push("p_print_map");
    v.push("p_map_clear");
    v.push("p_map_get_or");
    v.push("p_string_len");
    v.push("p_string_is_empty");
    v.push("p_string_starts_with");
    v.push("p_string_parse_int");
    v.push("p_string_bytes");
    v.push("p_string_clone");
    // Phase 5A.3: Interrupt handler stubs
    v.push("p_cli");
    v.push("p_sti");
    v.push("p_lidt");
    v.push("p_idt_set_entry");
    v.push("p_hlt");
    v.push("p_inb");
    v.push("p_outb");
    v.push("p_outw");
    v.push("p_inw");
    v.push("p_outl");
    v.push("p_inl");
    // Phase 5A.4: MMU/page table stubs
    v.push("p_cr3_read");
    v.push("p_cr3_write");
    v.push("p_cr0_read");
    v.push("p_cr0_write");
    v.push("p_cr2_read");
    v.push("p_cr4_read");
    v.push("p_cr4_write");
    v.push("p_invlpg");
    v.push("p_wrmsr_gs_base");
    v.push("p_rdmsr_gs_base");
    v.push("p_wrmsr_kernel_gs_base");
    v.push("p_swapgs");
    v.push("p_page_map");
    v.push("p_page_unmap");
    v.push("p_phys_read64");
    v.push("p_phys_write64");
    v.push("p_mem_read8");
    v.push("p_mem_write8");
    v.push("p_mem_read16");
    v.push("p_mem_write16");
    v.push("p_mem_read32");
    v.push("p_mem_write32");
    v.push("p_mem_read64");
    v.push("p_mem_write64");
    v.push("p_get_rbp");
    v.push("p_get_rsp");
    v.push("p_atomic_xchg32");
    // Phase 5A.5: GDT stubs
    v.push("p_lgdt");
    v.push("p_gdt_set_entry");
    v.push("p_enter_user_mode");
    v.push("syscall_handler");
    v.push("syscall_dispatch");
    // Phase 5A.6: Serial port stubs
    v.push("p_serial_init");
    v.push("p_serial_write");
    v.push("p_serial_read");
    v.push("p_serial_ready");
    // Native runtime stubs: argv, process exec
    v.push("p_argc");
    v.push("p_argv");
    v.push("p_system");
    // Arena marks / region frees (memory is never reused here)
    v.push("p_arena_save");
    v.push("p_arena_restore");
    v.push("p_region_free");
    return v;
}

/// The folder of the executable being written ("" when unknown or the
/// current folder): the "is not on this machine" warning also looks there,
/// where `ark build` copies a program's DLLs. Set by pe_set_output_path.
pub var g_pe_out_dir: str = "";

/// B5: the output file of the next PE build ("" when unknown): the
/// per-function cache's default place is beside it (pe_fc_default_base).
pub var g_pe_out_path: str = "";

/// OP20: `fid emit --cpu <name>` for pe_ir (the driver checks the name
/// with nat_cpu_check first): x86-64-v3 and x86-64-v4 turn on the BMI1 and
/// BMI2 forms (peir_bmi); "" (the safe default), baseline and native
/// leave them off.
pub var g_pe_cpu: str = "";

pub fn pe_set_cpu(cpu: str) {
    g_pe_cpu = cpu;
}

/// OP20: may this build use BMI1/BMI2 (SHLX/SARX/SHRX, BLSR)?
fn peir_bmi() -> bool {
    return g_pe_cpu == "x86-64-v3" || g_pe_cpu == "x86-64-v4";
}

/// Record the output file of the next PE build (its folder: g_pe_out_dir).
pub fn pe_set_output_path(path: str) {
    g_pe_out_path = path;
    var cut: i64 = str_rfind(path, "\\");
    var cut2: i64 = str_rfind(path, "/");
    if cut2 > cut {
        cut = cut2;
    }
    if cut < 0 {
        g_pe_out_dir = "";
    } else if cut == 0 {
        g_pe_out_dir = str_slice(path, 0, 1);
    } else {
        g_pe_out_dir = str_slice(path, 0, cut);
    }
}

// ===========================================================================
// PeirGen::generate (src/pe.rs)
// ===========================================================================

/// Generate the complete PE file from an IR module.
pub fn PeirGen_generate(self: &mut PeirGen, module: &IrModule) -> Vec {
    // 1. Collect all string constants from IR (sorted for determinism)
    var all_strings: Vec<str> = Vec::new();
    // PE88: membership through a table (a list scan per constant made this
    // step quadratic in the module's strings); all_strings keeps the order
    var all_seen: i64 = HashMap_new();
    var func_names: Vec<str> = pe_module_fn_names(module);
    var fi: i64 = 0;
    while fi < func_names.len() {
        match IrModule_get_function(module, func_names.get(fi)) {
            OptIrFunction::Some(func) => {
                var insts: Vec<ValueIdInst> = pe_sort_value_id_insts(func.insts);
                var ii: i64 = 0;
                while ii < insts.len() {
                    var inst: Inst = insts.get(ii).inst;
                    match inst {
                        Inst::ConstStr(value) => {
                            if !HashMap_contains(all_seen, value) {
                                HashMap_insert(all_seen, value, 1);
                                all_strings.push(value);
                            }
                        }
                        Inst::ConstFnRef(name) => {
                            if !HashMap_contains(all_seen, name) {
                                HashMap_insert(all_seen, name, 1);
                                all_strings.push(name);
                            }
                        }
                        Inst::Panic(message) => {
                            if !HashMap_contains(all_seen, message) {
                                HashMap_insert(all_seen, message, 1);
                                all_strings.push(message);
                            }
                        }
                        _ => {
                        }
                    }
                    ii = ii + 1;
                }
            }
            OptIrFunction::None => {
            }
        }
        fi = fi + 1;
    }
    // Add boolean strings
    all_strings.push("true");
    all_strings.push("false");
    HashMap_insert(all_seen, "true", 1);
    HashMap_insert(all_seen, "false", 1);
    // Panic messages of the runtime stubs
    var panic_strs: Vec<str> = peir_panic_strings();
    var psi: i64 = 0;
    while psi < panic_strs.len() {
        if !HashMap_contains(all_seen, panic_strs.get(psi)) {
            HashMap_insert(all_seen, panic_strs.get(psi), 1);
            all_strings.push(panic_strs.get(psi));
        }
        psi = psi + 1;
    }
    HashMap_drop(all_seen);
    // --checked-alloc: the fault report's formats (PeirGen_gen_checked_fault)
    if g_pe_checked_alloc && !self.bare_mode {
        all_strings.push(peir_checked_uaf_fmt());
        all_strings.push(peir_checked_overrun_fmt());
    }

    // The C functions the program reaches, from the DLLs it links
    pe_clear_extra_imports();
    var reached: Vec<str> = pe_ir_needed_fns(module);
    var xi: i64 = 0;
    while xi < module.extern_decls.len() {
        var xd: ExternDecl = module.extern_decls.get(xi);
        var xlib: str = "";
        match xd.link_lib {
            OptStr::Some(lib) => {
                xlib = lib;
            }
            OptStr::None => {
            }
        }
        // LG15: the functions of a local header that does not exist stay stubs
        var xmissing: bool = false;
        match xd.include {
            OptStr::Some(inc) => {
                if !str_starts_with(inc, "<") && !c_file_exists(pe_str_trim_chars(inc, "\"<>")) {
                    xmissing = true;
                }
            }
            OptStr::None => {
            }
        }
        if !xmissing && !self.bare_mode && pe_ir_strs_contains(reached, xd.pledge_name) && !pe_ir_strs_contains(self.module_fns, xd.pledge_name) && pe_import_slot(xd.c_name) < 0 && !pe_ir_strs_contains(pe_primitive_names(), xd.c_name) && pe_ir_c_override(module, xd.pledge_name) == "" {
            var dll: str = pe_link_dll(xlib);
            // LG15: no `link` or the C library's ("", c, m, msvcrt, kernel32):
            // the system DLL that exports it (cparser.fd cparse_system_dll_of)
            if dll == "" {
                dll = cparse_system_dll_of(xd.c_name);
            }
            if dll != "" {
                pe_add_extra_import(dll, xd.c_name);
            }
        }
        xi = xi + 1;
    }
    // A DLL not on this machine: the program reports it when it starts
    // (PeirGen_gen_dll_loader); say so now too (release E4)
    var xdlls: Vec<PeDllImport> = pe_dll_imports();
    var xdi: i64 = PE_STATIC_DLLS;
    while xdi < xdlls.len() {
        var xdll: str = xdlls.get(xdi).dll;
        var xcands: Vec<str> = pe_link_dll_candidates(xdll);
        var xfound: bool = false;
        var xci: i64 = 0;
        while xci < xcands.len() {
            if pe_dll_found(xcands.get(xci), g_pe_out_dir) {
                xfound = true;
            }
            xci = xci + 1;
        }
        if !xfound {
            p_eprint_str("warning: " + xdll + " is not on this machine (searched the output's folder, the current folder, the system folder and PATH): a call into it stops the program with a message\n");
        }
        xdi = xdi + 1;
    }

    // 2. Build .rdata section (a bare build has no import table)
    var rdata: PeirRdata = PeirRdata_new();
    if self.bare_mode {
        all_strings.push("panic: ");
        all_strings.push("Panic: ");
        if pe_bare_boot_on() {
            // the default CPU exception handler's message (release G1)
            all_strings.push("CPU exception");
            all_strings.push("panic: CPU exception ");
            all_strings.push(", error ");
            all_strings.push(", rip ");
            all_strings.push(", address ");
        }
        if g_pe_uefi {
            // the UEFI runtime's messages (pe_ir_stubs.fd, PeirGen_gen_uefi_*)
            all_strings.push("out of memory");
            all_strings.push("UEFI: not enough memory for the heap and the stack\n");
        }
        PeirRdata_build_strings(&mut rdata, all_strings);
    } else {
        PeirRdata_build(&mut rdata, all_strings);
    }

    // Record string rdata offsets for later codegen
    var si: i64 = 0;
    while si < all_strings.len() {
        var s: str = all_strings.get(si);
        var soff: i64 = PeirRdata_string_offset(&rdata, s);
        if soff != -1 {
            HashMap_insert(self.string_rdata_offsets, s, soff);
        }
        si = si + 1;
    }
    // Record IAT offsets
    self.iat_rdata_offsets = rdata.iat_offsets;

    // 2b. Append module-level mutable globals to .rdata (section is writable)
    // Each global gets storage for its type — a struct/enum global needs
    // the full size (a Store does a struct copy), not just 8 bytes.
    var global_names: Vec<str> = Vec::new();
    var gi: i64 = 0;
    while gi < module.globals.len() {
        global_names.push(module.globals.get(gi).name);
        gi = gi + 1;
    }
    global_names = pe_ir_sort_strs(global_names);
    // Slots holding a str literal's address get patched once .rdata's RVA
    // is known: pairs of (slot rdata offset, string rdata offset).
    var global_str_patches: Vec<i64> = Vec::new();
    gi = 0;
    while gi < global_names.len() {
        var gname: str = global_names.get(gi);
        match IrModule_get_global(module, gname) {
            OptGlobalLookup::Some(gty, init_expr) => {
                var gsize: i64 = IrModule_type_size(module, gty);
                if gsize < 8 {
                    gsize = 8;
                }
                // Compute the 8-byte initial value
                var bits: i64 = 0;
                var f32_init: bool = false;
                var str_off: i64 = -1;
                match init_expr {
                    Expr::IntLit(v) => {
                        bits = v;
                    }
                    Expr::BoolLit(b) => {
                        if b {
                            bits = 1;
                        } else {
                            bits = 0;
                        }
                    }
                    Expr::FloatLit(f) => {
                        if ir_type_eq(gty, IrType::F32) {
                            bits = p_f32_to_bits(f);
                            f32_init = true;
                        } else {
                            bits = p_f64_to_bits(f);
                        }
                    }
                    Expr::StringLit(s) => {
                        str_off = PeirRdata_add_string(&mut rdata, s);
                    }
                    _ => {
                        bits = 0;
                    }
                    // zero-initialize
                }
                var goff: i64 = rdata.data.len();
                if str_off != -1 {
                    global_str_patches.push(goff);
                    global_str_patches.push(str_off);
                }
                if f32_init {
                    var b1: i64 = 0;
                    while b1 < 4 {
                        rdata.data.push((bits >> (8 * b1)) & 0xFF);
                        b1 = b1 + 1;
                    }
                    var bz: i64 = 4;
                    while bz < gsize {
                        rdata.data.push(0);
                        bz = bz + 1;
                    }
                } else {
                    var b2: i64 = 0;
                    while b2 < 8 {
                        rdata.data.push((bits >> (8 * b2)) & 0xFF);
                        b2 = b2 + 1;
                    }
                    var b3: i64 = 8;
                    while b3 < gsize {
                        rdata.data.push(0);
                        b3 = b3 + 1;
                    }
                }
                HashMap_insert(self.global_rdata_offsets, gname, goff);
            }
            OptGlobalLookup::None => {
            }
        }
        gi = gi + 1;
    }  // Bump-allocator state for p_malloc: 32 zero bytes in writable .rdata —
    // +0 chunk cursor, +8 chunk end, +16 cached process-heap handle, +24 lock.
    // Cache-line aligned: a locked operation on a value that crosses a line
    // stalls the whole memory bus (about 900 ns per allocation).
    while rdata.data.len() % 64 != 0 {
        rdata.data.push(0);
    }
    self.alloc_rdata_off = rdata.data.len();
    var az: i64 = 0;
    while az < PEIR_ALLOC_STATE_SIZE {
        rdata.data.push(0);
        az = az + 1;
    }

    // 3. Pre-allocate labels for all functions (sorted for deterministic layout)
    fi = 0;
    while fi < func_names.len() {
        var flabel: i64 = PeirEnc_alloc_label(&mut self.enc);
        HashMap_insert(self.func_labels, func_names.get(fi), flabel);
        fi = fi + 1;
    }
    // Pre-allocate labels for runtime stubs
    var stub_names: Vec<str> = pe_runtime_stub_names();
    var ri: i64 = 0;
    while ri < stub_names.len() {
        var slabel: i64 = PeirEnc_alloc_label(&mut self.enc);
        HashMap_insert(self.func_labels, stub_names.get(ri), slabel);
        ri = ri + 1;
    }

    // 3b. The Fides runtime (src/pe_runtime/): its machine-code
    //     primitives, the stubs that hand over to it, and every
    //     `extern "C"` function of msvcrt.dll / kernel32.dll (a thunk each)
    self.module_fns = func_names;
    var prims: Vec<str> = pe_primitive_names();
    if self.bare_mode {
        prims = Vec::new();
    }
    var pi: i64 = 0;
    while pi < prims.len() {
        var pname: str = prims.get(pi);
        // MI20: a program function named like a nat_* primitive keeps its
        // label (and is what its callers get)
        var pnat: bool = str_starts_with(pname, "nat_");
        if !(pnat && HashMap_contains(self.func_labels, pname)) {
            var plabel: i64 = PeirEnc_alloc_label(&mut self.enc);
            HashMap_insert(self.func_labels, pname, plabel);
            if pnat {
                HashMap_insert(self.nat_own, pname, 1);
            }
        }
        pi = pi + 1;
    }
    // (only those the program reaches: the runtime function they hand
    // over to is left out otherwise)
    var needed: Vec<str> = pe_ir_needed_fns(module);
    // MI20: the nat_* primitives an extern declaration the program reaches
    // names (by its C name: `fn nat_x as y(...)` too) are made
    var nwi: i64 = 0;
    while nwi < module.extern_decls.len() {
        var nxd: ExternDecl = module.extern_decls.get(nwi);
        if HashMap_contains(self.nat_own, nxd.c_name) && pe_ir_strs_contains(needed, nxd.pledge_name) {
            HashMap_insert(self.nat_wanted, nxd.c_name, 1);
        }
        nwi = nwi + 1;
    }
    var deps: Vec<PeirStrPair> = pe_stub_deps();
    var di: i64 = 0;
    while di < deps.len() {
        var dep: PeirStrPair = deps.get(di);
        if pe_ir_strs_contains(self.module_fns, dep.b) && pe_ir_strs_contains(needed, dep.a) {
            var dlabel: i64 = PeirEnc_alloc_label(&mut self.enc);
            HashMap_insert(self.func_labels, dep.a, dlabel);
        }
        di = di + 1;
    }
    var edi: i64 = 0;
    while edi < module.extern_decls.len() {
        var ext: ExternDecl = module.extern_decls.get(edi);
        if !HashMap_contains(self.func_labels, ext.pledge_name) {
            var over: str = pe_ir_c_override(module, ext.pledge_name);
            if over != "" {
                self.c_overrides.push(COverride_new(ext.pledge_name, over));
            } else {
                // `fn pe_f64_to_bits as pe_f32_raw(x: f32) -> i64`: another name
                // (and Fides type) for a primitive
                var done_ext: bool = false;
                if !self.bare_mode && pe_ir_strs_contains(pe_primitive_names(), ext.c_name) {
                    var prim_label: i64 = HashMap_get(self.func_labels, ext.c_name);
                    HashMap_insert(self.func_labels, ext.pledge_name, prim_label);
                    done_ext = true;
                }
                if !done_ext {
                    var slot: i64 = pe_import_slot(ext.c_name);
                    var sig_idx: i64 = pe_extern_sig_index(module, ext.pledge_name);
                    if slot >= 0 && sig_idx >= 0 && !self.bare_mode {
                        var sig: StringVecIrType = module.extern_functions.get(sig_idx);
                        var tlabel: i64 = PeirEnc_alloc_label(&mut self.enc);
                        HashMap_insert(self.func_labels, ext.pledge_name, tlabel);
                        self.c_thunks.push(CThunk_new(module, ext.pledge_name, slot, sig.params, sig.ret));
                        done_ext = true;
                    }
                }
                if !done_ext {
                    // As in the C backend: the functions of a local header that does
                    // not exist (`include "pledge_audio.h"`) are stubs returning 0
                    var missing_local_header: bool = false;
                    match ext.include {
                        OptStr::Some(inc) => {
                            if !str_starts_with(inc, "<") && !c_file_exists(pe_str_trim_chars(inc, "\"<>")) {
                                missing_local_header = true;
                            }
                        }
                        OptStr::None => {
                        }
                    }
                    if missing_local_header {
                        var mlabel: i64 = PeirEnc_alloc_label(&mut self.enc);
                        HashMap_insert(self.func_labels, ext.pledge_name, mlabel);
                        self.stub_externs.push(ext.pledge_name);
                    }
                }
            }
        }
        edi = edi + 1;
    }
    var cbi: i64 = 0;
    while cbi < module.c_callbacks.len() {
        var cb_target: str = module.c_callbacks.get(cbi);
        if pe_ir_strs_contains(needed, cb_target) {
            match IrModule_get_function(module, cb_target) {
                OptIrFunction::Some(cb_func) => {
                    var cb_label: i64 = PeirEnc_alloc_label(&mut self.enc);
                    HashMap_insert(self.func_labels, c_fn_name(cb_target), cb_label);
                    var cb_params: Vec<IrType> = Vec::new();
                    var cbp: i64 = 1;
                    while cbp < cb_func.params.len() {
                        cb_params.push(cb_func.params.get(cbp).ty);
                        cbp = cbp + 1;
                    }
                    self.c_adapters.push(CAdapter_new(c_fn_name(cb_target), cb_target, cb_params, cb_func.ret_ty));
                }
                OptIrFunction::None => {
                }
            }
        }
        cbi = cbi + 1;
    }
    // Functions named by a string constant can be looked up by name: the
    // program's, and the runtime's that are compiled in (the task
    // scheduler starts its worker, poller and pool threads by name)
    var nf: Vec<str> = Vec::new();
    self.named_fns = nf;
    var ni: i64 = 0;
    while ni < all_strings.len() {
        var ns: str = all_strings.get(ni);
        if pe_ir_strs_contains(self.module_fns, ns) && (!is_pe_runtime_fn(ns) || pe_ir_strs_contains(needed, ns)) {
            self.named_fns.push(ns);
        }
        ni = ni + 1;
    }
    // A global's string initializer names a function too (`var g: str =
    // "f"; task_go(g, 1)`): ir.fd ir_data_named_fns, as the mid-end keeps it
    var gnamed: Vec<str> = ir_data_named_fns(module);
    var gni: i64 = 0;
    while gni < gnamed.len() {
        var gns: str = gnamed.get(gni);
        if !pe_ir_strs_contains(self.named_fns, gns) && pe_ir_strs_contains(self.module_fns, gns) && (!is_pe_runtime_fn(gns) || pe_ir_strs_contains(needed, gns)) {
            self.named_fns.push(gns);
        }
        gni = gni + 1;
    }

    var api: i64 = 0;
    while api < 9 {
        self.arith_panics.push(PeirEnc_alloc_label(&mut self.enc));
        api = api + 1;
    }
    self.crash_filter = PeirEnc_alloc_label(&mut self.enc);

    // A flat binary starts with a jump to its entry point
    var bare_entry: i64 = -1;
    if self.bare_mode {
        bare_entry = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_jmp_label(&mut self.enc, bare_entry);
    }

    // OP15: the functions that only panic (calls to them are cold paths);
    // DB3: the input file's functions get line rows; B5: the per-function
    // cache, now that every label a function may refer to exists
    PeirGen_find_cold_fns(self, module);
    if !self.bare_mode {
        PeirGen_lines_start(self);
    }
    PeirGen_fc_start(self, module, all_strings, global_names);

    // 4. Generate code for each function main reaches (competitive CS1:
    //    the rest of core and the stdlib is not compiled), sorted for a
    //    deterministic layout; of the Fides runtime only what the program
    //    uses. A function something else refers to (a function value, a
    //    name looked up at run time, a stub's callee) is generated on demand
    //    before the labels are resolved (PeirGen_gen_on_demand).
    var gen_done: Vec<i64> = peir_zeros(func_names.len());
    var reach_set: i64 = HashMap_new();
    var reach: Vec<str> = pe_ir_reachable_functions(module);
    var rsi: i64 = 0;
    while rsi < reach.len() {
        HashMap_insert(reach_set, reach.get(rsi), 1);
        rsi = rsi + 1;
    }
    rsi = 0;
    while rsi < self.named_fns.len() {
        HashMap_insert(reach_set, self.named_fns.get(rsi), 1);
        rsi = rsi + 1;
    }
    fi = 0;
    while fi < func_names.len() {
        var fname: str = func_names.get(fi);
        if is_pe_runtime_fn(fname) && !pe_ir_strs_contains(needed, fname) {
            fi = fi + 1;
            continue;
        }
        if PEIR_REACHABLE_ONLY && !HashMap_contains(reach_set, fname) {
            fi = fi + 1;
            continue;
        }
        match IrModule_get_function(module, fname) {
            OptIrFunction::Some(func) => {
                PeirGen_gen_cached(self, fname, func, module);
            }
            OptIrFunction::None => {
            }
        }
        gen_done.set(fi, 1);
        fi = fi + 1;
    }

    // 5. Generate runtime stubs
    PeirGen_gen_runtime_stubs(self);
    PeirGen_gen_arith_panics(self);
    if self.bare_mode {
        PeirGen_trap_unplaced(self, pe_runtime_stub_names());
    } else {
        PeirGen_gen_pe_primitives(self);
    }
    var thunks: Vec<CThunk> = self.c_thunks;
    var ti: i64 = 0;
    while ti < thunks.len() {
        var t: CThunk = thunks.get(ti);
        PeirGen_gen_c_thunk(self, &t);
        ti = ti + 1;
    }
    var adapters: Vec<CAdapter> = self.c_adapters;
    var cai: i64 = 0;
    while cai < adapters.len() {
        var ca: CAdapter = adapters.get(cai);
        PeirGen_gen_c_adapter(self, &ca);
        cai = cai + 1;
    }
    var stub_externs: Vec<str> = self.stub_externs;
    var si2: i64 = 0;
    while si2 < stub_externs.len() {
        PeirGen_place_fn(self, stub_externs.get(si2));
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_ret(&mut self.enc);
        si2 = si2 + 1;
    }

    // 5b. The start-up loader of the `link` DLLs (before the entry point,
    //     which calls it)
    PeirGen_gen_dll_loader(self, &mut rdata);

    // 6. Generate entry point (_main)
    if self.bare_mode {
        // A bootable image wires each @interrupt(N) function to its IDT
        // vector, and a void main exits with 0
        g_pe_bare_irqs = Vec::new();
        g_pe_bare_main_void = false;
        if pe_bare_boot_on() || g_pe_uefi {
            var ivi: i64 = 0;
            while ivi < func_names.len() {
                match IrModule_get_function(module, func_names.get(ivi)) {
                    OptIrFunction::Some(ivf) => {
                        if ivf.interrupt_vector >= 0 && ivf.interrupt_vector < 256 && HashMap_contains(self.func_labels, ivf.name) {
                            g_pe_bare_irqs.push(ivf.interrupt_vector);
                            g_pe_bare_irqs.push(HashMap_get(self.func_labels, ivf.name));
                        }
                        if ivf.name == "main" {
                            match ivf.ret_ty {
                                IrType::Void => {
                                    g_pe_bare_main_void = true;
                                }
                                _ => {
                                }
                            }
                        }
                    }
                    OptIrFunction::None => {
                    }
                }
                ivi = ivi + 1;
            }
        }
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, bare_entry);
    }
    PeirGen_gen_entry_point(self);

    // The functions referred to that main's call graph missed
    PeirGen_gen_on_demand(self, module, func_names, &mut gen_done);

    // MI20: the tables of nat_fn_names / nat_fn_table, after the last code;
    // under FID_VERIFY=1, every primitive of the interface placed
    if !self.bare_mode {
        PeirGen_gen_nat_tables(self);
        if pe_verify_on() {
            self.nat_missing = PeirGen_nat_check(self);
        }
        // one nothing was made for (no reached declaration names it) traps
        // if a call still lands on it, rather than jumping to offset -1
        PeirGen_trap_unplaced(self, prim_interface_names());
    }

    // 7. Resolve local labels (jumps/calls within .text)
    PeirEnc_resolve_labels(&mut self.enc);

    // A flat binary (release G2): [code][int3 to a 4 KB boundary][data],
    // loaded at g_pe_bare_load, entered at its first byte
    // A bootable image (release G1) puts PEIR_BOOT_PREFIX bytes of boot
    // headers and mode switch in front: the code starts after them.
    if self.bare_mode {
        var code_base: i64 = g_pe_bare_load;
        if pe_bare_boot_on() {
            code_base = g_pe_bare_load + PEIR_BOOT_PREFIX;
        }
        var flat_data: i64 = code_base + pe_align_up(self.enc.code.len(), PE_SECTION_ALIGN);
        // where the data starts in the flat binary (a UEFI image's .data)
        g_pe_uefi_code_size = Vec::new();
        g_pe_uefi_code_size.push(flat_data - code_base);
        var uefi_data_at: i64 = flat_data - g_pe_bare_load;
        PeirEnc_resolve_rip_refs(&mut self.enc, code_base, flat_data);
        var fpi: i64 = 0;
        while fpi < global_str_patches.len() {
            var fslot: i64 = global_str_patches.get(fpi);
            var fva: i64 = flat_data + global_str_patches.get(fpi + 1);
            var fb: i64 = 0;
            while fb < 8 {
                rdata.data.set(fslot + fb, (fva >> (8 * fb)) & 0xFF);
                fb = fb + 1;
            }
            if g_pe_uefi {
                // an absolute address: a DIR64 relocation of the EFI image
                g_pe_uefi_abs.push(uefi_data_at + fslot);
            }
            fpi = fpi + 2;
        }
        var flat: Vec = Vec::new();
        if pe_bare_boot_on() {
            flat = pe_bare_boot_prefix(g_pe_bare_load, code_base + self.enc.labels.get(g_pe_bare_boot_label));
        }
        var ci: i64 = 0;
        while ci < self.enc.code.len() {
            flat.push(self.enc.code.get(ci));
            ci = ci + 1;
        }
        while flat.len() < flat_data - g_pe_bare_load {
            flat.push(0xCC);
        }
        var di2: i64 = 0;
        while di2 < rdata.data.len() {
            flat.push(rdata.data.get(di2));
            di2 = di2 + 1;
        }
        return flat;
    }

    // MI20: the absolute addresses in those tables
    PeirGen_nat_patch_abs(self);

    // 8. Compute .rdata RVA dynamically from actual .text size
    var rdata_rva: i64 = PE_TEXT_RVA + pe_align_up(self.enc.code.len(), PE_SECTION_ALIGN);

    // 9. Patch RIP-relative references (strings + IAT calls)
    PeirEnc_resolve_rip_refs(&mut self.enc, PE_TEXT_RVA, rdata_rva);

    // 10. Patch import table RVAs in .rdata
    PeirRdata_patch_rvas(&mut rdata, rdata_rva);

    // 10b. Patch str-literal global initializers: each slot holds the
    // absolute VA of its string (image loads at preferred base — no relocs).
    var pi: i64 = 0;
    while pi < global_str_patches.len() {
        var slot_off: i64 = global_str_patches.get(pi);
        var str_off: i64 = global_str_patches.get(pi + 1);
        var va: i64 = PE_IMAGE_BASE + rdata_rva + str_off;
        var pb: i64 = 0;
        while pb < 8 {
            rdata.data.set(slot_off + pb, (va >> (8 * pb)) & 0xFF);
            pb = pb + 1;
        }
        pi = pi + 2;
    }

    // 11. Calculate PE metadata
    var import_dir_rva: i64 = rdata_rva + rdata.import_dir_offset;
    var iat_rva: i64 = rdata_rva + rdata.iat_offset;
    var iat_size: i64 = rdata.iat_size;
    // every DLL's entries + null terminators
    var entry_rva: i64 = PE_TEXT_RVA + self.entry_offset;

    // 12. Build PE file
    var image: Vec<i64> = pe_build_file(self.enc.code, rdata.data, entry_rva, import_dir_rva, iat_rva, iat_size, rdata_rva);
    // 12b. DB3: a debug build's DWARF line tables (pe_lines_setup)
    var dwarf: bool = self.dbg_names.len() > 0;
    if dwarf {
        // N9: with the variables, types and frames (pe_add_dwarf);
        // FID_PE_OFF=dbgvars: the line tables and functions only
        if peir_on("dbgvars") && g_pe_dbg_vars.len() == self.dbg_names.len() {
            image = pe_add_dwarf(image, self.enc.code, self.dbg_names, self.dbg_starts, self.dbg_ends, self.lrows, g_pe_lines_file, g_pe_dbg_vars, peir_dbg_type_descs(module));
        } else {
            image = pe_add_debug_sections(image, pe_dwarf_abbrev(), pe_dwarf_info(g_pe_lines_file, self.dbg_names, self.dbg_starts, self.dbg_ends), pe_dwarf_line(g_pe_lines_file, self.lrows));
        }
    }
    // 13. Function names for tools and debuggers (DB3, first step): a COFF
    //     symbol table after the sections. FID_PE_SYMS=0 leaves it out
    //     (not from a debug build: its string table names the DWARF sections).
    if peir_syms_on() || dwarf {
        PeirGen_append_symbols(self, &mut image, dwarf);
    }
    // 13b. DB3: the PDB for Visual Studio and WinDbg (compiler/pdb.fd) and
    //      the debug directory naming it (pdb_setup gave the path). After the
    //      COFF symbols: pdb_attach moves the symbol table behind its .buildid
    //      section and reads the COFF function names as publics.
    if dwarf {
        var pdb_files: Vec<str> = Vec::new();
        image = pdb_attach(image, self.dbg_names, self.dbg_starts, self.dbg_ends, self.lrows, pdb_files, g_pe_lines_file);
    }
    // B5: the cache file for the next build
    PeirGen_fc_finish(self);
    return image;
}

/// Is the COFF symbol table written (FID_PE_SYMS unset, or not "0")?
fn peir_syms_on() -> bool {
    match env_var("FID_PE_SYMS") {
        Option::Some(sw) => {
            return sw != "0";
        }
        Option::None => {
            return true;
        }
    }
    return true;
}

/// Add `name` to the symbol lists when it labels code placed in .text.
fn PeirGen_symbol_add(self: &mut PeirGen, name: str, seen: i64, names: &mut Vec<str>, offs: &mut Vec<i64>) {
    if name == "" || HashMap_contains(seen, name) || !HashMap_contains(self.func_labels, name) {
        return;
    }
    var label: i64 = HashMap_get(self.func_labels, name);
    if label < 0 || label >= self.enc.labels.len() {
        return;
    }
    var off: i64 = self.enc.labels.get(label);
    if off < 0 {
        return;
    }
    HashMap_insert(seen, name, 1);
    names.push(name);
    offs.push(off);
}

/// The COFF symbol table of the image (pe_append_coff_symbols): every
/// function, runtime stub, primitive, C thunk and adapter placed in .text,
/// under its Fides name, and the entry point as `__fid_entry`. In a fixed
/// order (the sorted function names, then the stub lists), so the same
/// input still gives the same bytes.
fn PeirGen_append_symbols(self: &mut PeirGen, image: &mut Vec<i64>, dwarf: bool) {
    var names: Vec<str> = Vec::new();
    var offs: Vec<i64> = Vec::new();
    var seen: i64 = HashMap_new();
    names.push("__fid_entry");
    offs.push(self.entry_offset);
    HashMap_insert(seen, "__fid_entry", 1);
    var mfns: Vec<str> = self.module_fns;
    var i: i64 = 0;
    while i < mfns.len() {
        var mname: str = mfns.get(i);
        PeirGen_symbol_add(self, mname, seen, &mut names, &mut offs);
        i = i + 1;
    }
    var stubs: Vec<str> = pe_runtime_stub_names();
    i = 0;
    while i < stubs.len() {
        PeirGen_symbol_add(self, stubs.get(i), seen, &mut names, &mut offs);
        i = i + 1;
    }
    var prims: Vec<str> = pe_primitive_names();
    i = 0;
    while i < prims.len() {
        PeirGen_symbol_add(self, prims.get(i), seen, &mut names, &mut offs);
        i = i + 1;
    }
    i = 0;
    var thunks: Vec<CThunk> = self.c_thunks;
    while i < thunks.len() {
        var th: CThunk = thunks.get(i);
        PeirGen_symbol_add(self, th.name, seen, &mut names, &mut offs);
        i = i + 1;
    }
    i = 0;
    var adapters: Vec<CAdapter> = self.c_adapters;
    while i < adapters.len() {
        var ad: CAdapter = adapters.get(i);
        PeirGen_symbol_add(self, ad.name, seen, &mut names, &mut offs);
        i = i + 1;
    }
    i = 0;
    var sexts: Vec<str> = self.stub_externs;
    while i < sexts.len() {
        var sname: str = sexts.get(i);
        PeirGen_symbol_add(self, sname, seen, &mut names, &mut offs);
        i = i + 1;
    }
    if dwarf {
        pe_append_coff_symbols_pre(image, pe_dwarf_section_names(), names, offs);
    } else {
        pe_append_coff_symbols(image, names, offs);
    }
}

// ===========================================================================
// MI20: nat_fn_names / nat_fn_table, and the interface check
// ===========================================================================

/// MI20: the tables nat_fn_names and nat_fn_table return (each made when
/// PeirGen_gen_nat_prims gave it a label), after the last code so that
/// every function is placed. As the machine layer's (nat_ir.fd):
/// nat_fn_names holds [address, name] for each named piece of .text
/// (program and runtime functions, stubs, primitives, thunks, adapters) in
/// address order, then [end of code, 0]; nat_fn_table [name, address] for
/// each function named by a string (named_fns), then [0, 0]. A name is a
/// static string in .text ([static magic][length] bytes NUL, as .rdata's
/// strings); an address is absolute, an 8-byte slot PeirGen_nat_patch_abs
/// fills once the labels are resolved (the image loads at PE_IMAGE_BASE
/// and has no relocations).
fn PeirGen_gen_nat_tables(self: &mut PeirGen) {
    if self.nat_names_tab < 0 && self.nat_fntab_tab < 0 {
        return;
    }
    var names: Vec<str> = Vec::new();
    var offs: Vec<i64> = Vec::new();
    var seen: i64 = HashMap_new();
    // RL16: the entry point too, as `__fid_entry` (the COFF symbols' name):
    // a return address in it was named after the function placed before
    // it, and --leaks' stack walk took the entry's blocks for the program's
    if !HashMap_contains(self.func_labels, "__fid_entry") {
        var entry_l: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_set_label(&mut self.enc, entry_l, self.entry_offset);
        HashMap_insert(self.func_labels, "__fid_entry", entry_l);
    }
    PeirGen_symbol_add(self, "__fid_entry", seen, &mut names, &mut offs);
    var mfns: Vec<str> = self.module_fns;
    var i: i64 = 0;
    while i < mfns.len() {
        PeirGen_symbol_add(self, mfns.get(i), seen, &mut names, &mut offs);
        i = i + 1;
    }
    var stubs: Vec<str> = pe_runtime_stub_names();
    i = 0;
    while i < stubs.len() {
        PeirGen_symbol_add(self, stubs.get(i), seen, &mut names, &mut offs);
        i = i + 1;
    }
    var prims: Vec<str> = pe_primitive_names();
    i = 0;
    while i < prims.len() {
        PeirGen_symbol_add(self, prims.get(i), seen, &mut names, &mut offs);
        i = i + 1;
    }
    var thunks: Vec<CThunk> = self.c_thunks;
    i = 0;
    while i < thunks.len() {
        var th: CThunk = thunks.get(i);
        PeirGen_symbol_add(self, th.name, seen, &mut names, &mut offs);
        i = i + 1;
    }
    var adapters: Vec<CAdapter> = self.c_adapters;
    i = 0;
    while i < adapters.len() {
        var ad: CAdapter = adapters.get(i);
        PeirGen_symbol_add(self, ad.name, seen, &mut names, &mut offs);
        i = i + 1;
    }
    var sexts: Vec<str> = self.stub_externs;
    i = 0;
    while i < sexts.len() {
        PeirGen_symbol_add(self, sexts.get(i), seen, &mut names, &mut offs);
        i = i + 1;
    }
    // By address (offset * 2^20 + index: ties keep the order collected)
    var keys: Vec<i64> = Vec::new();
    i = 0;
    while i < offs.len() && offs.len() < 1048576 {
        keys.push(offs.get(i) * 1048576 + i);
        i = i + 1;
    }
    keys = pe_nat_sort_keys(keys);
    var name_labels: i64 = HashMap_new();
    var str_names: Vec<str> = Vec::new();
    PeirEnc_align_to(&mut self.enc, 16);
    if self.nat_names_tab >= 0 {
        PeirEnc_place_label(&mut self.enc, self.nat_names_tab);
        var last: i64 = 0 - 1;
        i = 0;
        while i < keys.len() {
            var ix: i64 = keys.get(i) % 1048576;
            var off: i64 = offs.get(ix);
            // one entry per address (a nat_ alias shares its pe_ twin's)
            if off != last {
                var nm: str = names.get(ix);
                var at_l: i64 = HashMap_get(self.func_labels, nm);
                PeirGen_nat_abs(self, at_l);
                var nm_l: i64 = PeirGen_nat_name_label(self, name_labels, &mut str_names, nm);
                PeirGen_nat_abs(self, nm_l);
                last = off;
            }
            i = i + 1;
        }
        // [end of code, 0]: the code ends where the table starts
        var tab_l: i64 = self.nat_names_tab;
        PeirGen_nat_abs(self, tab_l);
        PeirEnc_emit_u64(&mut self.enc, 0);
    }
    if self.nat_fntab_tab >= 0 {
        PeirEnc_place_label(&mut self.enc, self.nat_fntab_tab);
        var nfs: Vec<str> = self.named_fns;
        i = 0;
        while i < nfs.len() {
            var f: str = nfs.get(i);
            if HashMap_contains(self.func_labels, f) {
                var fl: i64 = HashMap_get(self.func_labels, f);
                if self.enc.labels.get(fl) >= 0 {
                    var f_l: i64 = PeirGen_nat_name_label(self, name_labels, &mut str_names, f);
                    PeirGen_nat_abs(self, f_l);
                    PeirGen_nat_abs(self, fl);
                }
            }
            i = i + 1;
        }
        PeirEnc_emit_u64(&mut self.enc, 0);
        PeirEnc_emit_u64(&mut self.enc, 0);
    }
    // The names
    i = 0;
    while i < str_names.len() {
        var s: str = str_names.get(i);
        var n: i64 = str_len(s);
        PeirEnc_align_to(&mut self.enc, 8);
        PeirEnc_emit_u64(&mut self.enc, 0x4649444553545202);
        PeirEnc_emit_u64(&mut self.enc, n);
        PeirEnc_place_label(&mut self.enc, HashMap_get(name_labels, s));
        var b: i64 = 0;
        while b < n {
            PeirEnc_emit_u8(&mut self.enc, str_byte_at(s, b));
            b = b + 1;
        }
        PeirEnc_emit_u8(&mut self.enc, 0);
        i = i + 1;
    }
}

/// MI20: the label of the name string `name` in the tables (one per name;
/// `order` lists them as they are first asked for).
fn PeirGen_nat_name_label(self: &mut PeirGen, map: i64, order: &mut Vec<str>, name: str) -> i64 {
    if HashMap_contains(map, name) {
        return HashMap_get(map, name);
    }
    var l: i64 = PeirEnc_alloc_label(&mut self.enc);
    HashMap_insert(map, name, l);
    order.push(name);
    return l;
}

/// MI20: an 8-byte slot for the absolute address of `label`.
fn PeirGen_nat_abs(self: &mut PeirGen, label: i64) {
    var at: i64 = PeirEnc_offset(&self.enc);
    self.nat_abs_fix.push(at);
    self.nat_abs_fix.push(label);
    PeirEnc_emit_u64(&mut self.enc, 0);
}

/// MI20: fill the slots PeirGen_nat_abs left (labels resolved; .text at
/// PE_TEXT_RVA of an image at PE_IMAGE_BASE).
fn PeirGen_nat_patch_abs(self: &mut PeirGen) {
    var i: i64 = 0;
    while i + 1 < self.nat_abs_fix.len() {
        var pos: i64 = self.nat_abs_fix.get(i);
        var off: i64 = self.enc.labels.get(self.nat_abs_fix.get(i + 1));
        var va: i64 = 0;
        if off >= 0 {
            va = PE_IMAGE_BASE + PE_TEXT_RVA + off;
        }
        var b: i64 = 0;
        while b < 8 {
            self.enc.code.set(pos + b, (va >> (8 * b)) & 0xFF);
            b = b + 1;
        }
        i = i + 2;
    }
}

/// MI20 (FID_VERIFY=1, when every primitive is made): "" when pe_ir placed
/// each name of prim_interface_names it owns, else the missing ones (as
/// nat_ir.fd's ng_prim_check words it).
fn PeirGen_nat_check(self: &PeirGen) -> str {
    var names: Vec<str> = prim_interface_names();
    var missing: str = "";
    var i: i64 = 0;
    while i < names.len() {
        var n: str = names.get(i);
        if HashMap_contains(self.nat_own, n) {
            var l: i64 = HashMap_get(self.func_labels, n);
            if self.enc.labels.get(l) < 0 {
                if missing != "" {
                    missing = missing + ", ";
                }
                missing = missing + n;
            }
        }
        i = i + 1;
    }
    if missing == "" {
        return "";
    }
    return "the runtime primitives of this target lack " + missing;
}

/// MI20: `v` in ascending order (a bottom-up merge sort).
fn pe_nat_sort_keys(v: Vec<i64>) -> Vec<i64> {
    var a: Vec<i64> = Vec::new();
    var b: Vec<i64> = Vec::new();
    var n: i64 = v.len();
    var i: i64 = 0;
    while i < n {
        a.push(v.get(i));
        b.push(0);
        i = i + 1;
    }
    var w: i64 = 1;
    while w < n {
        var lo: i64 = 0;
        while lo < n {
            var mid: i64 = lo + w;
            if mid > n {
                mid = n;
            }
            var hi: i64 = lo + 2 * w;
            if hi > n {
                hi = n;
            }
            var x: i64 = lo;
            var y: i64 = mid;
            var k: i64 = lo;
            while k < hi {
                var take_x: bool = false;
                if x < mid {
                    if y >= hi {
                        take_x = true;
                    } else if a.get(x) <= a.get(y) {
                        take_x = true;
                    }
                }
                if take_x {
                    b.set(k, a.get(x));
                    x = x + 1;
                } else {
                    b.set(k, a.get(y));
                    y = y + 1;
                }
                k = k + 1;
            }
            lo = hi;
        }
        i = 0;
        while i < n {
            a.set(i, b.get(i));
            i = i + 1;
        }
        w = w * 2;
    }
    return a;
}

// ===========================================================================
// PeirGen::gen_function (src/pe.rs)
// ===========================================================================

/// Generate code for a single function.
pub fn PeirGen_gen_function(self: &mut PeirGen, name: str, func: &IrFunction, module: &IrModule) -> void {
    self.cur_func = name;
    // The Fides runtime is machine-level code the interpreter never runs:
    // its arithmetic wraps, as a @wrapping function's does.
    self.cur_wrapping = func.is_wrapping || is_pe_runtime_fn(name);
    // J7: a @constant_time function may not branch or divide on secrets in
    // the code this backend emits (peir_ct_check)
    if func.is_constant_time && !peir_ct_off() {
        var ct_errs: Vec<str> = peir_ct_check(func, name);
        var cti: i64 = 0;
        while cti < ct_errs.len() {
            g_pe_ct_errors.push(ct_errs.get(cti));
            cti = cti + 1;
        }
    }
    // B5: the cache key PeirGen_gen_cached worked out (0: not cached), and
    // where this function's relocations and labels start
    var fc_key: i64 = self.fc_key;
    self.fc_key = 0;
    var fc_pl0: i64 = self.enc.pending_labels.len();
    var fc_rr0: i64 = self.enc.pending_rip_refs.len();
    var fc_lab0: i64 = self.enc.next_label;
    var fc_unres0: i64 = self.unres_adds;
    var label: i64 = HashMap_get(self.func_labels, name);
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, label);
    var fc_start: i64 = self.enc.code.len();
    // DB3: line rows for the functions of the input file
    self.lines_cur_fn = HashMap_contains(self.line_fns, name) && !peir_is_interrupt(self, func);
    self.cur_line = 0;
    if self.lines_cur_fn {
        // N9: one entry of variables per function named (a new generator
        // starts the list again: PE88 may build the image twice)
        if self.dbg_names.len() == 0 {
            g_pe_dbg_vars = Vec::new();
        }
        self.dbg_names.push(name);
        self.dbg_starts.push(fc_start);
        g_pe_dbg_vars.push("");
        // N9: a row at the function's first byte with its `fn` line, so a
        // debugger's `break <function>` steps over the prologue to the
        // body's first row (the next one: cur_line stays 0)
        var dline: i64 = peir_dbg_decl_line(name);
        if dline > 0 && peir_on("dbgvars") {
            self.lrows.push(fc_start);
            self.lrows.push(dline);
            self.lrows.push(0);
        }
    }
    if str_len(peir_env_or_empty("PE_DUMP_FN")) > 0 {
        p_eprint_str("FN " + name + " @" + int_to_str(self.enc.code.len()) + "\n");
    }

    if peir_is_interrupt(self, func) {
        // Interrupt handler prologue: save all GP registers
        // The CPU already pushed SS:RSP, RFLAGS, CS:RIP on interrupt
        // For exceptions with error codes (#PF=0x0E, #GP=0x0D, etc.),
        // the CPU also pushed an error code before jumping here.
        // We save it to 0x510 and remove it from the stack so the
        // epilogue's iretq works correctly.

        // Check if this vector pushes an error code
        if pe_interrupt_has_err(func.interrupt_vector) && self.bare_mode && PEIR_BARE_BOOT {
            // The error code to 0x510 and off the stack, rax kept (release
            // G1: rax used to come back as the error code)
            PeirEnc_push(&mut self.enc, PEIR_RAX);
            peir_emit8(&mut self.enc, 0x48, 0x8B, 0x44, 0x24, 0x08, 0x90, 0x90, 0x90);
            // mov rax, [rsp+8]
            peir_emit8(&mut self.enc, 0x48, 0x89, 0x04, 0x25, 0x10, 0x05, 0x00, 0x00);
            // mov [0x510], rax
            PeirEnc_pop(&mut self.enc, PEIR_RAX);
            peir_emit2(&mut self.enc, 0x48, 0x83);
            peir_emit2(&mut self.enc, 0xC4, 0x08);
            // add rsp, 8
        } else if pe_interrupt_has_err(func.interrupt_vector) {
            // Pop error code into RAX, save to 0x510, then push RAX back
            PeirEnc_pop(&mut self.enc, PEIR_RAX);
            // mov [0x510], rax
            peir_emit8(&mut self.enc, 0x48, 0x89, 0x04, 0x25, 0x10, 0x05, 0x00, 0x00);
        }

        // We save all general-purpose registers
        PeirEnc_push(&mut self.enc, PEIR_RAX);
        PeirEnc_push(&mut self.enc, PEIR_RBX);
        PeirEnc_push(&mut self.enc, PEIR_RCX);
        PeirEnc_push(&mut self.enc, PEIR_RDX);
        PeirEnc_push(&mut self.enc, PEIR_RSI);
        PeirEnc_push(&mut self.enc, PEIR_RDI);
        PeirEnc_push(&mut self.enc, PEIR_R8);
        PeirEnc_push(&mut self.enc, PEIR_R9);
        PeirEnc_push(&mut self.enc, PEIR_R10);
        PeirEnc_push(&mut self.enc, PEIR_R11);
        PeirEnc_push(&mut self.enc, PEIR_R12);
        PeirEnc_push(&mut self.enc, PEIR_R13);
        PeirEnc_push(&mut self.enc, PEIR_R14);
        PeirEnc_push(&mut self.enc, PEIR_R15);
        // Set up frame
        PeirEnc_push(&mut self.enc, PEIR_RBP);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    } else {
        // Prologue
        PeirEnc_push(&mut self.enc, PEIR_RBP);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    }

    // Allocate stack frame (value_metas is insertion-ordered by id already,
    // as x86.fd iterates it directly)
    var frame: PeStackFrame = PeStackFrame_new();

    // ── Slot reuse (pe-roadmap items 84-85) ──
    // Block-local temporaries (def + all uses in one block) share a slot
    // pool instead of owning one slot each, so frames stay small. Pools are
    // dense Vec<i64> indexed by value id; -1 = absent.
    var nvals: i64 = func.value_metas.len() + func.insts.len() + 16;
    var def_block: Vec<i64> = Vec::new();
    var n_use_blocks: Vec<i64> = Vec::new();
    var a_use_block: Vec<i64> = Vec::new();
    var last_use: Vec<i64> = Vec::new();
    var zi: i64 = 0;
    while zi < nvals {
        def_block.push(-1);
        n_use_blocks.push(0);
        a_use_block.push(-1);
        last_use.push(-1);
        zi = zi + 1;
    }
    var ops: Vec<i64> = Vec::new();
    var pos: i64 = 0;
    var abi: i64 = 0;
    while abi < func.blocks.len() {
        var ablock: BasicBlock = func.blocks.get(abi);
        var aii: i64 = 0;
        while aii < ablock.instructions.len() {
            var aiid: i64 = ablock.instructions.get(aii);
            match IrFunction_get_inst(func, aiid) {
                OptInst::Some(ainst) => {
                    if aiid >= 0 && aiid < nvals {
                        def_block.set(aiid, abi);
                    }
                    // An alloca's storage lives as long as the function: a
                    // reference to it can be kept in another variable after
                    // the alloca's own last use (`val r = &f()`, release K6)
                    match ainst {
                        Inst::Alloca(_, _) => {
                            if aiid >= 0 && aiid < nvals {
                                def_block.set(aiid, -1);
                            }
                        }
                        _ => {
                        }
                    }
                    match ainst {
                        Inst::TryUnwrap(_, okd, _, _) => {
                            if okd >= 0 && okd < nvals {
                                def_block.set(okd, abi);
                            }
                        }
                        _ => {
                        }
                    }
                    peir_inst_operands(ainst, &mut ops);
                    var oi: i64 = 0;
                    while oi < ops.len() {
                        var op: i64 = ops.get(oi);
                        if op >= 0 && op < nvals {
                            if a_use_block.get(op) != abi {
                                n_use_blocks.set(op, n_use_blocks.get(op) + 1);
                                a_use_block.set(op, abi);
                            }
                            last_use.set(op, pos);
                        }
                        oi = oi + 1;
                    }
                    ops.clear();
                }
                OptInst::None => {
                }
            }
            pos = pos + 1;
            aii = aii + 1;
        }
        abi = abi + 1;
    }
    // N9: in a debug build every value a source variable is bound to keeps
    // its slot for the whole function (as an alloca does), so a debugger
    // reads it there (PeirGen_dbg_vars_note) instead of a slot another
    // value took over after its last use
    if self.lines_cur_fn && peir_on("dbgvars") {
        var dli: i64 = 0;
        while dli < func.locals.len() {
            var dlid: i64 = func.locals.get(dli).id;
            if dlid >= 0 && dlid < nvals {
                def_block.set(dlid, -1);
            }
            dli = dli + 1;
        }
    }

    self.unchecked = peir_unchecked_ops(func, nvals);
    // Registers: the hottest locals keep one for the whole function, the
    // others serve temporaries, freed and reused as pool slots are.
    // LG13: asm! templates run in a process; they may write any register,
    // so such a function keeps every value in its slot (as a bare build
    // does) and saves every callee-saved register (below)
    self.has_asm = !self.bare_mode && peir_on("asm") && peir_has_asm(func);
    // RA1: FID_PE_OFF=ra runs without pe_ir's own allocator (D4/OP16/OP17:
    // peir_pick_reg_vars, peir_global_ra, coalescing, volatile ranges):
    // every value in its slot, as a bare build and an asm! function do.
    // It measures what the allocator's deletion costs, and that what keeps
    // pe_ir after the Windows default moves to the machine layer (MI17)
    // runs without it.
    var use_regs: bool = !self.bare_mode && !peir_is_interrupt(self, func) && !self.has_asm && peir_on("ra");
    // D13: repeated register moves left out (FID_PE_OFF=cprop: kept)
    g_peir_cp = peir_on("cprop");
    // LF20: a function holding secrets clears its frame and scratch
    // registers before it returns (PeirGen_wipe_frame)
    self.wipe_frame = peir_on("wipe") && !peir_is_interrupt(self, func) && (func.zeroize_locals.len() > 0 || func.is_constant_time);
    // OP13: `return g(x)` jumps to g when nothing g gets points into this
    // frame (it is gone once g runs)
    self.tail_ok = use_regs && peir_on("tail") && !self.wipe_frame && !peir_frame_escapes(func, nvals);
    self.tail_next = false;
    self.tail_done = false;
    var no_reg: Vec<i64> = peir_zeros(nvals);
    // N9 (known-bugs 2g.104): a debug build that keeps the allocator
    // (FID_PE_DEBUG_RA=1) keeps the parameters in their frame slots, which
    // hold them for the whole function: in a register they showed as
    // optimized out, and a register is theirs only to their last use
    if use_regs && g_pe_lines_names != "" && peir_on("dbgvars") {
        var dpi: i64 = 0;
        while dpi < func.params.len() {
            peir_mark(&mut no_reg, func.params.get(dpi).id, nvals);
            dpi = dpi + 1;
        }
    }
    var used_regs: Vec<i64> = Vec::new();
    var ra_facts: PeirRaFacts = PeirRaFacts_new();
    // Value id -> 1 + register, from the whole-function allocator (D4)
    var in_reg_of: Vec<i64> = peir_zeros(nvals);
    var global_ra: bool = use_regs && PEIR_GLOBAL_RA;
    if global_ra {
        peir_pick_reg_vars(func, module, &mut frame, &mut no_reg, nvals, 0, &mut ra_facts);
        used_regs = peir_global_ra(func, module, &mut frame, &mut no_reg, nvals, &ra_facts, &mut in_reg_of);
    } else if use_regs {
        used_regs = peir_pick_reg_vars(func, module, &mut frame, &mut no_reg, nvals, PEIR_VALUE_REGS - 2, &mut ra_facts);
    }
    // Values the allocator put in a register: their offset is the register
    var assigned: Vec<i64> = Vec::new();
    zi = 0;
    while zi < nvals {
        assigned.push(-2);
        zi = zi + 1;
    }
    if global_ra {
        var gi: i64 = 0;
        while gi < nvals {
            if in_reg_of.get(gi) > 0 {
                var goff: i64 = PEIR_REG_SLOT + in_reg_of.get(gi) - 1;
                frame.offsets.push(PeOffEnt {
                    id: gi, offset: goff
                });
                assigned.set(gi, goff);
            }
            gi = gi + 1;
        }
    }
    var free_regs: Vec<i64> = Vec::new();
    if use_regs && !global_ra {
        var fr: i64 = PEIR_VALUE_REGS - 1;
        while fr >= used_regs.len() {
            free_regs.push(fr);
            fr = fr - 1;
        }
    }

    var vi: i64 = 0;
    while vi < func.value_metas.len() {
        var vm: ValueIdMeta = func.value_metas.get(vi);
        if !peir_recyclable(vm.id, def_block, n_use_blocks, a_use_block, nvals) && !(vm.id < nvals && in_reg_of.get(vm.id) > 0) {
            var size: i64 = IrModule_type_size(module, vm.meta.ty);
            if size < 8 {
                size = 8;
            }
            PeStackFrame_alloc(&mut frame, vm.id, size);
        }
        vi = vi + 1;
    }
    // A parameter read more than once keeps a free register for the whole
    // function, while two stay free for temporaries
    if use_regs && !global_ra {
        var puses: Vec<i64> = peir_zeros(nvals);
        var pui: i64 = 0;
        while pui < func.insts.len() {
            var pops: Vec<i64> = Vec::new();
            peir_inst_operands(func.insts.get(pui).inst, &mut pops);
            var po: i64 = 0;
            while po < pops.len() {
                var pv: i64 = pops.get(po);
                if pv >= 0 && pv < nvals {
                    puses.set(pv, puses.get(pv) + 1);
                }
                po = po + 1;
            }
            pui = pui + 1;
        }
        while free_regs.len() > 2 {
            // The most used parameter not yet in a register
            var best: i64 = -1;
            var best_uses: i64 = 1;
            var pi: i64 = 0;
            while pi < func.params.len() {
                var prm: ValueIdType = func.params.get(pi);
                if prm.id < nvals && puses.get(prm.id) > best_uses && no_reg.get(prm.id) == 0 && peir_reg_word(module, prm.ty) {
                    best = prm.id;
                    best_uses = puses.get(prm.id);
                }
                pi = pi + 1;
            }
            if best < 0 {
                break;
            }
            puses.set(best, 0);
            var r: i64 = free_regs.pop();
            used_regs.push(r);
            pe_idmap_put(&mut frame.offsets, best, PEIR_REG_SLOT + r);
        }
    }
    // Assign recyclable values pool slots in scan order — the same order the
    // emit loop runs, so frees/assignments line up. A value's slot frees
    // once the instruction holding its last use passes. `assigned` tracks
    // offsets densely (O(1)) — the Vec<PeOffEnt> map is O(n) per lookup.
    var free_slots: Vec<i64> = Vec::new();
    pos = 0;
    var sbi: i64 = 0;
    while sbi < func.blocks.len() {
        var sblock: BasicBlock = func.blocks.get(sbi);
        var sii: i64 = 0;
        while sii < sblock.instructions.len() {
            var siid: i64 = sblock.instructions.get(sii);
            match IrFunction_get_inst(func, siid) {
                OptInst::Some(sinst) => {
                    // Free operands whose last use is this instruction.
                    peir_inst_operands(sinst, &mut ops);
                    var oi2: i64 = 0;
                    while oi2 < ops.len() {
                        var op2: i64 = ops.get(oi2);
                        if op2 >= 0 && op2 < nvals && last_use.get(op2) == pos && peir_recyclable(op2, def_block, n_use_blocks, a_use_block, nvals) && assigned.get(op2) != -2 {
                            if assigned.get(op2) >= PEIR_REG_SLOT {
                                // the whole-function allocator owns its registers
                                if !global_ra {
                                    free_regs.push(assigned.get(op2) - PEIR_REG_SLOT);
                                }
                            } else {
                                free_slots.push(assigned.get(op2));
                            }
                            last_use.set(op2, -1);
                            // freed once
                            assigned.set(op2, -2);
                        }
                        oi2 = oi2 + 1;
                    }
                    ops.clear();
                    // Assign this inst's result (and TryUnwrap's ok_dst) a
                    // slot: pop a freed slot, or grow the frame. Recyclable
                    // values wider than 8 bytes get a permanent slot — pool
                    // slots are all 8-byte.
                    if siid >= 0 && siid < nvals && assigned.get(siid) == -2 && peir_recyclable(siid, def_block, n_use_blocks, a_use_block, nvals) {
                        var vsz: i64 = 8;
                        var in_reg: bool = false;
                        match IrFunction_get_meta(func, siid) {
                            OptValueMeta::Some(svm) => {
                                vsz = IrModule_type_size(module, svm.ty);
                                if vsz < 8 {
                                    vsz = 8;
                                }
                                in_reg = no_reg.get(siid) == 0 && last_use.get(siid) >= 0 && free_regs.len() > 0 && peir_reg_type(module, svm.ty);
                            }
                            OptValueMeta::None => {
                            }
                        }
                        var off: i64 = 0;
                        if in_reg {
                            var taken: i64 = free_regs.get(free_regs.len() - 1);
                            free_regs.remove(free_regs.len() - 1);
                            if !peir_has_i64(used_regs, taken) {
                                used_regs.push(taken);
                            }
                            off = PEIR_REG_SLOT + taken;
                        } else if vsz <= 8 && free_slots.len() > 0 {
                            off = free_slots.get(free_slots.len() - 1);
                            free_slots.remove(free_slots.len() - 1);
                        } else {
                            off = PeStackFrame_alloc_raw(&mut frame, vsz);
                        }
                        frame.offsets.push(PeOffEnt {
                            id: siid, offset: off
                        });
                        assigned.set(siid, off);
                    }
                    match sinst {
                        Inst::TryUnwrap(_, okd2, _, _) => {
                            if okd2 >= 0 && okd2 < nvals && assigned.get(okd2) == -2 && peir_recyclable(okd2, def_block, n_use_blocks, a_use_block, nvals) {
                                var off2: i64 = 0;
                                if free_slots.len() > 0 {
                                    off2 = free_slots.get(free_slots.len() - 1);
                                    free_slots.remove(free_slots.len() - 1);
                                } else {
                                    off2 = PeStackFrame_alloc_raw(&mut frame, 8);
                                }
                                frame.offsets.push(PeOffEnt {
                                    id: okd2, offset: off2
                                });
                                assigned.set(okd2, off2);
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            pos = pos + 1;
            sii = sii + 1;
        }
        sbi = sbi + 1;
    }
    // Pre-allocate alloca data slots (insts is insertion-ordered by id)
    var ii: i64 = 0;
    while ii < func.insts.len() {
        var ve: ValueIdInst = func.insts.get(ii);
        match ve.inst {
            Inst::Alloca(ty, _) => {
                if !pe_idmap_has(&frame.reg_vars, ve.id) {
                    var data_size: i64 = IrModule_type_size(module, ty);
                    if data_size < 8 {
                        data_size = 8;
                    }
                    var aoff: i64 = PeStackFrame_alloc_raw(&mut frame, data_size);
                    pe_idmap_put(&mut frame.alloca_slots, ve.id, aoff);
                }
            }
            _ => {
            }
        }
        ii = ii + 1;
    }
    if self.has_asm {
        var ar: i64 = 0;
        while ar < PEIR_VALUE_REGS {
            if !peir_has_i64(used_regs, ar) {
                used_regs.push(ar);
            }
            ar = ar + 1;
        }
        used_regs.push(0x100 + 6);
        used_regs.push(0x100 + 7);
    }
    self.saved_regs = Vec::new();
    var ri: i64 = 0;
    while ri < PEIR_VALUE_REGS {
        if peir_has_i64(used_regs, ri) {
            self.saved_regs.push(PeOffEnt {
                id: peir_value_reg(ri), offset: PeStackFrame_alloc_raw(&mut frame, 8)
            });
        }
        ri = ri + 1;
    }
    // xmm6 and xmm7 are callee-saved, all 128 bits (id 100 + n)
    var xsave: i64 = 6;
    while xsave <= 7 {
        if peir_has_i64(used_regs, 0x100 + xsave) {
            self.saved_regs.push(PeOffEnt {
                id: 100 + xsave, offset: PeStackFrame_alloc_raw(&mut frame, 16)
            });
        }
        xsave = xsave + 1;
    }

    // The outgoing argument area of every call, reserved once: shadow space
    // and the widest call's stack arguments
    self.use_count = peir_zeros(nvals);
    var most_args: i64 = 0;
    var ui: i64 = 0;
    while ui < func.insts.len() {
        var uinst: Inst = func.insts.get(ui).inst;
        var uops: Vec<i64> = Vec::new();
        peir_inst_operands(uinst, &mut uops);
        var uo: i64 = 0;
        while uo < uops.len() {
            var u: i64 = uops.get(uo);
            if u >= 0 && u < nvals {
                self.use_count.set(u, self.use_count.get(u) + 1);
            }
            uo = uo + 1;
        }
        match uinst {
            Inst::Call(_, cargs, _, _) => {
                if cargs.len() + 1 > most_args {
                    most_args = cargs.len() + 1;
                }
            }
            Inst::CallPtr(_, cargs, _, _, _) => {
                if cargs.len() + 1 > most_args {
                    most_args = cargs.len() + 1;
                }
            }
            Inst::DynCall(_, _, cargs, _, _) => {
                if cargs.len() + 1 > most_args {
                    most_args = cargs.len() + 1;
                }
            }
            _ => {
            }
        }
        ui = ui + 1;
    }
    var out_args: i64 = 0;
    if most_args > 4 {
        out_args = (most_args - 4) * 8;
    }
    self.calls_reserved = !peir_is_interrupt(self, func);
    // Align stack to 16 bytes + 32 shadow space
    var stack_size: i64 = (frame.size + 32 + out_args + 15) & ~15;
    if stack_size < 64 {
        stack_size = 64;
    }
    PeirEnc_sub_rsp_i32(&mut self.enc, stack_size);

    // Stack probes: touch every page of the new frame top-down so Windows
    // commits it. Frames here are huge (one slot per IR value, no reuse),
    // so a single sub lands far below the guard page; without probing, the
    // next deep write or outgoing-arg push faults instead of growing the
    // stack. (Same job as __chkstk.)
    if stack_size > 4096 {
        var probe_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
        var probe_done: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RBP);
        PeirEnc_place_label(&mut self.enc, probe_loop);
        PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RSP);
        PeirEnc_jcc_label(&mut self.enc, 0x6, probe_done);
        // jbe: rax <= rsp
        PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_R11, PEIR_RAX);
        // touch page
        PeirEnc_jmp_label(&mut self.enc, probe_loop);
        PeirEnc_place_label(&mut self.enc, probe_done);
    }

    ri = 0;
    while ri < self.saved_regs.len() {
        var sr: PeOffEnt = self.saved_regs.get(ri);
        if sr.id >= 100 {
            PeirEnc_movdqu_mem_rbp_xmm(&mut self.enc, sr.offset, sr.id - 100);
        } else {
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, sr.offset, sr.id);
        }
        ri = ri + 1;
    }

    // Store params from registers
    var arg_regs: Vec<i64> = Vec::new();
    arg_regs.push(PEIR_RCX);
    arg_regs.push(PEIR_RDX);
    arg_regs.push(PEIR_R8);
    arg_regs.push(PEIR_R9);
    var pi: i64 = 0;
    while pi < func.params.len() {
        var param: ValueIdType = func.params.get(pi);
        if param.id >= 0 && param.id < self.use_count.len() && self.use_count.get(param.id) == 0 {  // nothing reads it (a null environment, most often)
        } else if pi < 4 {
            var poff: i64 = PeStackFrame_offset(&frame, param.id);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, poff, arg_regs.get(pi));
        } else {
            var stack_offset: i64 = 48 + (pi - 4) * 8;
            var poff2: i64 = PeStackFrame_offset(&frame, param.id);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, stack_offset);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, poff2, PEIR_RAX);
        }
        pi = pi + 1;
    }

    // Pre-allocate block labels
    var bi: i64 = 0;
    while bi < func.blocks.len() {
        var block: BasicBlock = func.blocks.get(bi);
        var blabel: i64 = PeirEnc_alloc_label(&mut self.enc);
        HashMap_insert(self.block_labels, pe_block_key(name, block.id), blabel);
        bi = bi + 1;
    }

    // Block id -> index, for loop rotation
    var bindex: Vec<i64> = Vec::new();
    bi = 0;
    while bi < func.blocks.len() {
        var bid: i64 = func.blocks.get(bi).id;
        while bindex.len() <= bid {
            bindex.push(-1);
        }
        bindex.set(bid, bi);
        bi = bi + 1;
    }

    // OP15: the order blocks are laid out in: cold blocks (panic paths)
    // after the others; lpos = a block's place in it
    var order: Vec<i64> = PeirGen_block_order(self, func);
    var lpos: Vec<i64> = peir_zeros(func.blocks.len());
    var oi3: i64 = 0;
    while oi3 < order.len() {
        lpos.set(order.get(oi3), oi3);
        oi3 = oi3 + 1;
    }

    // Generate code for each basic block
    var lk: i64 = 0;
    while lk < order.len() {
        bi = order.get(lk);
        var block2: BasicBlock = func.blocks.get(bi);
        var blabel2: i64 = HashMap_get(self.block_labels, pe_block_key(name, block2.id));
        PeirEnc_place_label(&mut self.enc, blabel2);

        self.pending_cmp_cc = -1;
        self.next_block = -1;
        if lk + 1 < order.len() {
            self.next_block = HashMap_get(self.block_labels, pe_block_key(name, func.blocks.get(order.get(lk + 1)).id));
        }
        // Loop rotation (competitive OP11): a block that jumps back to a
        // loop header made only of the loop's test runs that test itself,
        // so each iteration takes one branch (to the body) instead of a
        // jump to the header and a branch out of it
        var ninsts: i64 = block2.instructions.len();
        var rot: i64 = -1;
        if PEIR_ROTATE && ninsts > 0 && use_regs {
            match IrFunction_get_inst(func, block2.instructions.get(ninsts - 1)) {
                OptInst::Some(lj) => {
                    match lj {
                        Inst::Jump(jt) => {
                            if jt >= 0 && jt < bindex.len() && bindex.get(jt) >= 0 && bindex.get(jt) < bi && lpos.get(bindex.get(jt)) < lk && peir_rotatable(func, func.blocks.get(bindex.get(jt))) {
                                rot = bindex.get(jt);
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
        }
        if rot >= 0 {
            ninsts = ninsts - 1;
        }
        PeirGen_gen_insts(self, block2.instructions, ninsts, &mut frame, func, module, name);
        if rot >= 0 {
            var hb: BasicBlock = func.blocks.get(rot);
            self.pending_cmp_cc = -1;
            PeirGen_gen_insts(self, hb.instructions, hb.instructions.len(), &mut frame, func, module, name);
        }
        lk = lk + 1;
    }

    // Epilogue (fallthrough safety)
    PeirGen_restore_regs(self);
    if self.wipe_frame {
        PeirGen_wipe_frame(self);
    }
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
    // DB3: the function's line rows end here (its cold paths have none)
    if self.lines_cur_fn {
        self.lrows.push(self.enc.code.len());
        self.lrows.push(0);
        self.lrows.push(1);
    }
    // The inline Vec calls' cold paths, out of the hot code's way
    PeirGen_emit_cold(self, &mut frame);
    if self.lines_cur_fn {
        self.dbg_ends.push(self.enc.code.len());
        // N9: its parameters and variables, now that the frame is laid out
        PeirGen_dbg_vars_note(self, func, module, &frame);
        self.lines_cur_fn = false;
    }
    // B5: keep the function's code for the next build
    if fc_key != 0 {
        PeirGen_fc_capture(self, name, fc_key, fc_start, fc_pl0, fc_rr0, fc_lab0, fc_unres0);
    }
}

/// Only generate the functions main reaches, and those referred to (CS1)
const PEIR_REACHABLE_ONLY: bool = true;
/// Generate every function whose label some emitted code refers to but
/// that has no code yet, until there is none (each may refer to others).
fn PeirGen_gen_on_demand(self: &mut PeirGen, module: &IrModule, func_names: Vec<str>, done: &mut Vec<i64>) {
    var changed: bool = true;
    while changed {
        changed = false;
        var refd: Vec<i64> = peir_zeros(self.enc.next_label + 1);
        var ri: i64 = 0;
        while ri < self.enc.pending_labels.len() {
            var t: i64 = self.enc.pending_labels.get(ri).target_label;
            if t >= 0 && t < refd.len() {
                refd.set(t, 1);
            }
            ri = ri + 1;
        }
        var fi: i64 = 0;
        while fi < func_names.len() {
            if done.get(fi) == 0 {
                var fname: str = func_names.get(fi);
                if HashMap_contains(self.func_labels, fname) {
                    var lab: i64 = HashMap_get(self.func_labels, fname);
                    if lab >= 0 && lab < refd.len() && refd.get(lab) == 1 && self.enc.labels.get(lab) < 0 {
                        match IrModule_get_function(module, fname) {
                            OptIrFunction::Some(func) => {
                                PeirGen_gen_cached(self, fname, func, module);
                                changed = true;
                            }
                            OptIrFunction::None => {
                            }
                        }
                        done.set(fi, 1);
                    }
                }
            }
            fi = fi + 1;
        }
    }
}

/// The first `n` instructions of a block (a compare is fused with the
/// Branch after it).
fn PeirGen_gen_insts(self: &mut PeirGen, ids: Vec<i64>, n: i64, frame: &mut PeStackFrame, func: &IrFunction, module: &IrModule, name: str) -> void {
    var ii2: i64 = 0;
    while ii2 < n {
        var inst_id: i64 = ids.get(ii2);
        var next_cond: i64 = -1;
        if ii2 + 1 < ids.len() {
            match IrFunction_get_inst(func, ids.get(ii2 + 1)) {
                OptInst::Some(ninst) => {
                    match ninst {
                        Inst::Branch(c2, _, _) => {
                            next_cond = c2;
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
        }
        // DB3: a row where the source line changes
        if self.lines_cur_fn {
            var sl: i64 = peir_inst_line(func, inst_id);
            if sl > 0 && sl != self.cur_line {
                self.lrows.push(self.enc.code.len());
                self.lrows.push(sl);
                self.lrows.push(0);
                self.cur_line = sl;
            }
        }
        // OP13: a call whose result the next instruction returns
        self.tail_next = false;
        var tail_skip: i64 = 1;
        if self.tail_ok && ii2 + 1 < n {
            match IrFunction_get_inst(func, ids.get(ii2 + 1)) {
                OptInst::Some(rinst) => {
                    match rinst {
                        Inst::Return(rv) => {
                            match rv {
                                OptValueId::Some(rvid) => {
                                    self.tail_next = rvid == inst_id;
                                }
                                OptValueId::None => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            // or that it stores in a result slot that the block it jumps
            // to returns (an inlined callee's `return g(x)`)
            if !self.tail_next && ii2 + 2 < n && peir_tail_via_slot(func, ids, ii2, inst_id) {
                self.tail_next = true;
                tail_skip = 2;
            }
        }
        match IrFunction_get_inst(func, inst_id) {
            OptInst::Some(inst) => {
                PeirGen_gen_inst(self, inst_id, inst, next_cond, frame, func, module, name);
            }
            OptInst::None => {
            }
        }
        self.tail_next = false;
        if self.tail_done {
            // the Return (or the store and jump to it) is the jump just
            // emitted
            self.tail_done = false;
            ii2 = ii2 + tail_skip;
        }
        ii2 = ii2 + 1;
    }
}

/// OP13 (known-bugs 2g.98): the call ids[at] (value `call`) is in tail
/// position through a result slot: the next instructions are `store call
/// -> slot` (a stack alloca, of the call's type) and `jump B`, and B,
/// after blocks that only jump on or copy the slot into the next one
/// (`l = load slot; store l -> slot2; jump C`: nested inlining), starts
/// `l = load slot; return l`. The
/// IR optimizer's inliner gives this shape to an inlined `return g(x)`
/// (is_even inlined into is_odd: is_odd's `return is_odd(n - 2)` stored
/// into is_even's result slot), so the call was a call and 100 million
/// levels overflowed the stack. On that path nothing writes the slot
/// between the store and the load, so the value returned is the call's.
fn peir_tail_via_slot(func: &IrFunction, ids: Vec<i64>, at: i64, call: i64) -> bool {
    match IrFunction_get_inst(func, call) {
        OptInst::Some(ci) => {
            match ci {
                Inst::Call(_, _, _, _) => {
                }
                _ => {
                    return false;
                }
            }
        }
        OptInst::None => {
            return false;
        }
    }
    var slot: i64 = 0 - 1;
    var st_ty: OptIrType = OptIrType::None;
    match IrFunction_get_inst(func, ids.get(at + 1)) {
        OptInst::Some(si) => {
            match si {
                Inst::Store(sptr, sval, sty) => {
                    if sval != call {
                        return false;
                    }
                    slot = sptr;
                    st_ty = sty;
                }
                _ => {
                    return false;
                }
            }
        }
        OptInst::None => {
            return false;
        }
    }
    // the slot is a frame alloca (peir_frame_escapes has checked that
    // its address goes nowhere)
    match IrFunction_get_inst(func, slot) {
        OptInst::Some(ai) => {
            match ai {
                Inst::Alloca(_, _) => {
                }
                _ => {
                    return false;
                }
            }
        }
        OptInst::None => {
            return false;
        }
    }
    var target: i64 = 0 - 1;
    match IrFunction_get_inst(func, ids.get(at + 2)) {
        OptInst::Some(ji) => {
            match ji {
                Inst::Jump(jt) => {
                    target = jt;
                }
                _ => {
                    return false;
                }
            }
        }
        OptInst::None => {
            return false;
        }
    }
    var call_ty: IrType = IrType::Void;
    match IrFunction_get_meta(func, call) {
        OptValueMeta::Some(cm) => {
            call_ty = cm.ty;
        }
        OptValueMeta::None => {
            return false;
        }
    }
    match st_ty {
        OptIrType::Some(sty2) => {
            if !ir_type_eq(sty2, call_ty) {
                return false;
            }
        }
        OptIrType::None => {
        }
    }
    var hops: i64 = 0;
    while hops < 8 {
        var bpos: i64 = 0 - 1;
        var bi: i64 = 0;
        while bi < func.blocks.len() && bpos < 0 {
            if func.blocks.get(bi).id == target {
                bpos = bi;
            }
            bi = bi + 1;
        }
        if bpos < 0 {
            return false;
        }
        var bids: Vec<i64> = func.blocks.get(bpos).instructions;
        if bids.len() < 1 {
            return false;
        }
        var on_to: i64 = 0 - 1;
        if bids.len() == 1 {
            // a block that only jumps on
            match IrFunction_get_inst(func, bids.get(0)) {
                OptInst::Some(oj) => {
                    match oj {
                        Inst::Jump(jt2) => {
                            on_to = jt2;
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            if on_to < 0 {
                return false;
            }
            target = on_to;
            hops = hops + 1;
        } else if bids.len() == 3 {
            // an outer inlined callee's result slot: `l = load slot;
            // store l -> slot2; jump C` (nested inlining)
            var fwd: i64 = peir_slot_forward(func, bids, slot, call_ty);
            if fwd < 0 {
                return false;
            }
            slot = fwd;
            match IrFunction_get_inst(func, bids.get(2)) {
                OptInst::Some(fj) => {
                    match fj {
                        Inst::Jump(jt3) => {
                            on_to = jt3;
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            if on_to < 0 {
                return false;
            }
            target = on_to;
            hops = hops + 1;
        } else {
            return peir_slot_load_return(func, bids, slot, call_ty);
        }
    }
    return false;
}

/// peir_tail_via_slot through nested inlining: the block `bids` is `l =
/// load slot` (of type ty), `store l -> slot2` (a stack alloca) and a
/// jump: slot2, or -1 when it is not that.
fn peir_slot_forward(func: &IrFunction, bids: Vec<i64>, slot: i64, call_ty: IrType) -> i64 {
    var lid: i64 = bids.get(0);
    match IrFunction_get_inst(func, lid) {
        OptInst::Some(li) => {
            match li {
                Inst::Load(lptr, lty) => {
                    if lptr != slot || !ir_type_eq(lty, call_ty) {
                        return 0 - 1;
                    }
                }
                _ => {
                    return 0 - 1;
                }
            }
        }
        OptInst::None => {
            return 0 - 1;
        }
    }
    var slot2: i64 = 0 - 1;
    match IrFunction_get_inst(func, bids.get(1)) {
        OptInst::Some(si) => {
            match si {
                Inst::Store(sptr, sval, sty) => {
                    if sval != lid {
                        return 0 - 1;
                    }
                    match sty {
                        OptIrType::Some(sty2) => {
                            if !ir_type_eq(sty2, call_ty) {
                                return 0 - 1;
                            }
                        }
                        OptIrType::None => {
                        }
                    }
                    slot2 = sptr;
                }
                _ => {
                    return 0 - 1;
                }
            }
        }
        OptInst::None => {
            return 0 - 1;
        }
    }
    match IrFunction_get_inst(func, slot2) {
        OptInst::Some(ai) => {
            match ai {
                Inst::Alloca(_, _) => {
                    return slot2;
                }
                _ => {
                    return 0 - 1;
                }
            }
        }
        OptInst::None => {
            return 0 - 1;
        }
    }
    return 0 - 1;
}

/// peir_tail_via_slot's last step: the block (its instructions `bids`)
/// starts `l = load slot` (of type ty) and `return l`.
fn peir_slot_load_return(func: &IrFunction, bids: Vec<i64>, slot: i64, call_ty: IrType) -> bool {
    var lid: i64 = bids.get(0);
    match IrFunction_get_inst(func, lid) {
        OptInst::Some(li) => {
            match li {
                Inst::Load(lptr, lty) => {
                    if lptr != slot || !ir_type_eq(lty, call_ty) {
                        return false;
                    }
                }
                _ => {
                    return false;
                }
            }
        }
        OptInst::None => {
            return false;
        }
    }
    match IrFunction_get_inst(func, bids.get(1)) {
        OptInst::Some(ri) => {
            match ri {
                Inst::Return(rv) => {
                    match rv {
                        OptValueId::Some(rvid) => {
                            return rvid == lid;
                        }
                        OptValueId::None => {
                            return false;
                        }
                    }
                }
                _ => {
                    return false;
                }
            }
        }
        OptInst::None => {
            return false;
        }
    }
    return false;
}

/// A loop header that only tests: a few loads, constants, integer
/// operations and `len` calls, then the Branch. Its code may run again at
/// the end of the loop's body (rotation): it writes nothing but its own
/// values.
fn peir_rotatable(func: &IrFunction, blk: BasicBlock) -> bool {
    var n: i64 = blk.instructions.len();
    if n == 0 || n > 12 {
        return false;
    }
    var i: i64 = 0;
    while i < n {
        match IrFunction_get_inst(func, blk.instructions.get(i)) {
            OptInst::Some(inst) => {
                var last: bool = i == n - 1;
                match inst {
                    Inst::Branch(_, _, _) => {
                        if !last {
                            return false;
                        }
                    }
                    Inst::Load(_, _) => {
                        if last {
                            return false;
                        }
                    }
                    Inst::ConstInt(_, _) => {
                        if last {
                            return false;
                        }
                    }
                    Inst::ConstBool(_) => {
                        if last {
                            return false;
                        }
                    }
                    Inst::BinOp(_, _, _, ty) => {
                        if last || ir_type_is_float(ty) {
                            return false;
                        }
                    }
                    Inst::Call(cn, _, _, _) => {
                        if last || !(cn == "Vec_len" || cn == "p_vec_len") {
                            return false;
                        }
                    }
                    _ => {
                        return false;
                    }
                }
            }
            OptInst::None => {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

fn PeirGen_restore_regs(self: &mut PeirGen) -> void {
    var i: i64 = 0;
    while i < self.saved_regs.len() {
        var sr: PeOffEnt = self.saved_regs.get(i);
        if sr.id >= 100 {
            PeirEnc_movdqu_xmm_mem_rbp(&mut self.enc, sr.id - 100, sr.offset);
        } else {
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, sr.id, sr.offset);
        }
        i = i + 1;
    }
}

fn peir_has_i64(v: Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Whether a value of this type fits a register: everything is moved 64 bits
/// at a time, so a narrow integer does too.
fn peir_reg_type(module: &IrModule, ty: IrType) -> bool {
    if ir_type_is_float(ty) {
        return false;
    }
    match ty {
        IrType::Struct(_) => {
            return false;
        }
        IrType::Array(_, _) => {
            return false;
        }
        IrType::Void => {
            return false;
        }
        IrType::Never => {
            return false;
        }
        _ => {
        }
    }
    return IrModule_type_size(module, ty) <= 8;
}

/// Is `op` a call's null environment, which the generic call path loads as
/// an immediate? (Not a call the emitter inlines or prints through.)
fn peir_env_imm(module: &IrModule, callee: str, cargs: Vec<i64>, op: i64) -> bool {
    if cargs.len() == 0 || cargs.get(0) != op {
        return false;
    }
    if str_starts_with(callee, "Vec_") || callee == "print" || callee == "println" {
        return false;
    }
    var i: i64 = 1;
    while i < cargs.len() {
        if cargs.get(i) == op {
            return false;
        }
        i = i + 1;
    }
    match IrModule_get_function(module, callee) {
        OptIrFunction::Some(_) => {
            return true;
        }
        OptIrFunction::None => {
            return false;
        }
    }
}

fn peir_reg_word(module: &IrModule, ty: IrType) -> bool {
    return peir_reg_type(module, ty) && IrModule_type_size(module, ty) == 8;
}

fn peir_mark(v: &mut Vec<i64>, id: i64, n: i64) {
    if id >= 0 && id < n {
        v.set(id, 1);
    }
}

fn peir_value_float(func: &IrFunction, id: i64) -> bool {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => {
            return ir_type_is_float(m.ty);
        }
        OptValueMeta::None => {
            return false;
        }
    }
}

/// A call PeirGen_inline_vec_call writes in place: it reads its constant
/// arguments as immediates (load_operand), and its environment not at all.
fn peir_inline_vec_imm(module: &IrModule, callee: str, cargs: Vec<i64>) -> bool {
    var known: bool = false;
    match IrModule_get_function(module, callee) {
        OptIrFunction::Some(_) => {
            known = true;
        }
        OptIrFunction::None => {
        }
    }
    if !known {
        return false;
    }
    if callee == "Vec_len" {
        return cargs.len() >= 1;
    }
    if callee == "Vec_get" {
        return cargs.len() >= 2;
    }
    if callee == "Vec_set" {
        return cargs.len() >= 3;
    }
    if callee == "Vec_push" {
        return cargs.len() == 3;
    }
    return false;
}

fn peir_value_f64(func: &IrFunction, id: i64) -> bool {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => {
            return ir_type_eq(m.ty, IrType::F64);
        }
        OptValueMeta::None => {
            return false;
        }
    }
}

fn peir_value_word(func: &IrFunction, module: &IrModule, id: i64) -> bool {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => {
            return peir_reg_word(module, m.ty);
        }
        OptValueMeta::None => {
            return false;
        }
    }
}

fn peir_loop_back(index: Vec<i64>, depth: &mut Vec<i64>, target: i64, at: i64) {
    if target < 0 || target >= index.len() {
        return;
    }
    var head: i64 = index.get(target);
    if head >= 0 && head <= at {
        var d: i64 = head;
        while d <= at {
            depth.set(d, depth.get(d) + 1);
            d = d + 1;
        }
    }
}

// ===========================================================================
// Whole-function register allocation (release D4, D13)
//
// Linear scan over live intervals. The candidates are the word-sized SSA
// values a register can hold (the ones the per-block scheme took, and now
// also those that live across blocks and parameters) and the locals
// (allocas) every access of which is a whole-word load or store. Liveness
// is computed by the usual dataflow over the blocks (no phis: merges go
// through allocas), each candidate gets one interval [lo, hi] in layout
// order that covers every point where it is live, and the seven
// callee-saved value registers go to intervals by start; when none is
// free, the coldest interval (uses weighted by loop depth) is left in
// memory. A register value's frame offset is PEIR_REG_SLOT + r, so the
// emitting code is unchanged.
// ===========================================================================

/// r8 and r9 (value registers 9 and 10) for values whose live range holds
/// no call, starts and ends at no call and is not a parameter's (D4). No
/// instruction peir_ra_volatile_safe accepts uses r8 or r9: they appear
/// only in calls' argument moves, the parameter moves of the prologue, the
/// inline Vec calls and their cold paths (calls), an interrupt handler's
/// saves (no registers there) and the frame wipe after the return value.
const PEIR_ARG_RA: bool = true;

const PEIR_GLOBAL_RA: bool = true;
/// Copy coalescing: a local's loads and stores share its register (OP16)
const PEIR_COALESCE: bool = true;
/// r10 and r11, and xmm2-xmm5, for values no call crosses (OP16)
const PEIR_VOLATILE_RA: bool = true;
/// f64 values and locals in xmm registers (OP17)
const PEIR_XMM_RA: bool = true;
/// Loop rotation: a loop's test copied to the end of its body (OP11)
const PEIR_ROTATE: bool = true;
/// What pick_reg_vars works out, for the allocator: per alloca its weight
/// + 1 when it is a candidate and whether it must stay in memory; per block
/// its loop depth; block id -> index.
pub struct PeirRaFacts {
    pub weight: Vec<i64>,
    pub bad: Vec<i64>,
    pub depth: Vec<i64>,
    pub index: Vec<i64>,
}

fn PeirRaFacts_new() -> PeirRaFacts {
    return PeirRaFacts {
        weight: Vec::new(), bad: Vec::new(), depth: Vec::new(), index: Vec::new()
    };
}

fn peir_bs_test(bs: &Vec<i64>, base: i64, k: i64) -> bool {
    return ((bs.get(base + k / 64) >> (k % 64)) & 1) != 0;
}

fn peir_bs_set(bs: &mut Vec<i64>, base: i64, k: i64) {
    var w: i64 = base + k / 64;
    bs.set(w, bs.get(w) | (1 << (k % 64)));
}

/// Whether an instruction's code leaves r10, r11 and xmm2-xmm5 alone (no
/// call, no use of them as scratch), so a value may stay in one across it.
fn peir_ra_volatile_safe(module: &IrModule, inst: Inst) -> bool {
    match inst {
        Inst::ConstInt(_, _) => {
            return true;
        }
        Inst::ConstBool(_) => {
            return true;
        }
        Inst::ConstNull(_) => {
            return true;
        }
        Inst::ConstFloat(_, _) => {
            return true;
        }
        Inst::ConstStr(_) => {
            return true;
        }
        Inst::ConstFnRef(_) => {
            return true;
        }
        Inst::GlobalAddr(_, _) => {
            return true;
        }
        Inst::BinOp(_, _, _, _) => {
            return true;
        }
        Inst::UnaryOp(_, _, _) => {
            return true;
        }
        Inst::Alloca(_, _) => {
            return true;
        }
        Inst::Load(_, ty) => {
            return peir_reg_type(module, ty) || ir_type_eq(ty, IrType::F64);
        }
        Inst::Store(_, _, sty) => {
            match sty {
                OptIrType::Some(t) => {
                    return peir_reg_type(module, t) || ir_type_eq(t, IrType::F64);
                }
                OptIrType::None => {
                    return true;
                }
            }
        }
        Inst::GetFieldPtr(_, _, _) => {
            return true;
        }
        Inst::GetElemPtr(_, _, _) => {
            return true;
        }
        Inst::IntExtend(_, _, _) => {
            return true;
        }
        Inst::IntTrunc(_, _, _) => {
            return true;
        }
        Inst::BitCast(_, _, _) => {
            return true;
        }
        Inst::IntToFloat(_, _, _) => {
            return true;
        }
        Inst::FloatToInt(_, _, _) => {
            return true;
        }
        Inst::Jump(_) => {
            return true;
        }
        Inst::Branch(_, _, _) => {
            return true;
        }
        Inst::Return(_) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// An instruction that reads its operands before it calls anything: a
/// value may end its life in a caller-saved register there. (At most four
/// arguments: a fifth goes to the stack through r10.)
fn peir_ra_reads_first(inst: Inst) -> bool {
    match inst {
        Inst::Call(_, args, _, _) => {
            return args.len() <= 4;
        }
        _ => {
            return false;
        }
    }
}

/// An instruction that writes its result after any call it makes.
fn peir_ra_writes_last(inst: Inst) -> bool {
    match inst {
        Inst::Call(_, _, _, _) => {
            return true;
        }
        Inst::CallPtr(_, _, _, _, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// Whether register `r` of the scan may hold candidate `c`: registers
/// [0, nfixed) any candidate, [nfixed, nvol) (caller-saved) one with
/// vok[c] >= 1, [nvol, nregs) (caller-saved argument registers, D4) one
/// with vok[c] == 2.
fn peir_ra_reg_ok(vok: &Vec<i64>, c: i64, r: i64, nfixed: i64, nvol: i64) -> bool {
    if r < nfixed {
        return true;
    }
    if r < nvol {
        return vok.get(c) >= 1;
    }
    return vok.get(c) == 2;
}

/// Linear scan of the candidates with part[c] == 1 over `nregs` registers;
/// registers [0, nfixed) any candidate may get, the others (caller-saved)
/// only one with vok[c] >= 1, and those from `nvol` on only one with
/// vok[c] == 2 (peir_ra_reg_ok). A candidate prefers the register of
/// hint[c] when that is free where it starts. Returns per candidate its
/// register index or -1 (in memory).
fn peir_ra_scan(nc: i64, lo: &Vec<i64>, hi: &Vec<i64>, wt: &Vec<i64>, part: &Vec<i64>, vok: &Vec<i64>, hint: &Vec<i64>, nregs: i64, nfixed: i64, nvol: i64, npos: i64) -> Vec<i64> {
    var reg_of: Vec<i64> = Vec::new();
    while reg_of.len() < nc {
        reg_of.push(-1);
    }
    var head: Vec<i64> = Vec::new();
    while head.len() < npos {
        head.push(-1);
    }
    var nxt: Vec<i64> = Vec::new();
    while nxt.len() < nc {
        nxt.push(-1);
    }
    var ci: i64 = nc - 1;
    while ci >= 0 {
        if part.get(ci) == 1 && hi.get(ci) >= lo.get(ci) && lo.get(ci) + 1 < npos {
            var slot: i64 = lo.get(ci) + 1;
            nxt.set(ci, head.get(slot));
            head.set(slot, ci);
        }
        ci = ci - 1;
    }
    var active: Vec<i64> = Vec::new();
    while active.len() < nregs {
        active.push(-1);
    }
    var p: i64 = 0;
    while p < npos {
        var cur: i64 = head.get(p);
        while cur >= 0 {
            var clo: i64 = lo.get(cur);
            var r: i64 = 0;
            while r < nregs {
                var a: i64 = active.get(r);
                // an operand whose last use is where `cur` is defined: read
                // before the result is written, so they may share
                if a >= 0 && hi.get(a) <= clo && !(lo.get(a) == -1 && clo == -1) {
                    active.set(r, -1);
                }
                r = r + 1;
            }
            var can_vol: bool = vok.get(cur) >= 1;
            var pick: i64 = -1;
            var h: i64 = hint.get(cur);
            if h >= 0 && reg_of.get(h) >= 0 {
                var hr: i64 = reg_of.get(h);
                if active.get(hr) < 0 && peir_ra_reg_ok(vok, cur, hr, nfixed, nvol) {
                    pick = hr;
                }
            }
            if pick < 0 && vok.get(cur) == 2 {
                // r8/r9 first (D4): r10/r11 stay for ranges that end or
                // start at a call
                r = nvol;
                while r < nregs && pick < 0 {
                    if active.get(r) < 0 {
                        pick = r;
                    }
                    r = r + 1;
                }
            }
            if pick < 0 && can_vol {
                // a caller-saved register costs no save and restore
                r = nfixed;
                while r < nvol && r < nregs && pick < 0 {
                    if active.get(r) < 0 {
                        pick = r;
                    }
                    r = r + 1;
                }
            }
            r = 0;
            while r < nfixed && pick < 0 {
                if active.get(r) < 0 {
                    pick = r;
                }
                r = r + 1;
            }
            if pick >= 0 {
                active.set(pick, cur);
                reg_of.set(cur, pick);
            } else {
                // The coldest of the active ones (and `cur`) stays in memory
                var worst: i64 = -1;
                r = 0;
                while r < nregs {
                    if peir_ra_reg_ok(vok, cur, r, nfixed, nvol) {
                        var a2: i64 = active.get(r);
                        if worst < 0 || wt.get(a2) < wt.get(active.get(worst)) || (wt.get(a2) == wt.get(active.get(worst)) && hi.get(a2) > hi.get(active.get(worst))) {
                            worst = r;
                        }
                    }
                    r = r + 1;
                }
                if worst >= 0 {
                    var victim: i64 = active.get(worst);
                    if wt.get(victim) < wt.get(cur) {
                        reg_of.set(victim, -1);
                        active.set(worst, cur);
                        reg_of.set(cur, worst);
                    }
                }
            }
            cur = nxt.get(cur);
        }
        p = p + 1;
    }
    return reg_of;
}

/// The xmm register of index i of the float register file: xmm6 and xmm7
/// (callee-saved), then xmm2-xmm5 (caller-saved).
fn peir_ra_xmm(i: i64) -> i64 {
    if i == 0 {
        return 6;
    }
    if i == 1 {
        return 7;
    }
    return i;
}

/// Is BinOp `op` of type `ty` one that int_binop_in_reg computes into its
/// result's register from the left operand?
fn peir_ra_in_reg_op(op: BinOp, ty: IrType) -> bool {
    if !ir_type_eq(ty, IrType::I64) {
        return false;
    }
    match op {
        BinOp::Add => {
            return true;
        }
        BinOp::Sub => {
            return true;
        }
        BinOp::Mul => {
            return true;
        }
        BinOp::BitAnd => {
            return true;
        }
        BinOp::BitOr => {
            return true;
        }
        BinOp::BitXor => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// Allocate registers for the whole function; returns the value registers
/// used (0-8 the general ones, 0x100 + n xmm n). SSA values that got one
/// are in `in_reg` (1 + register); locals in frame.reg_vars.
fn peir_global_ra(func: &IrFunction, module: &IrModule, frame: &mut PeStackFrame, no_reg: &mut Vec<i64>, nvals: i64, facts: &PeirRaFacts, in_reg: &mut Vec<i64>) -> Vec<i64> {
    var nb: i64 = func.blocks.len();
    var used: Vec<i64> = Vec::new();
    if nb == 0 {
        return used;
    }
    var ops: Vec<i64> = Vec::new();
    // TryUnwrap's second result has a slot of its own
    var fl_bad: Vec<i64> = peir_zeros(nvals);
    var ii: i64 = 0;
    while ii < func.insts.len() {
        match func.insts.get(ii).inst {
            Inst::TryUnwrap(_, okd, _, _) => {
                peir_mark(no_reg, okd, nvals);
                peir_mark(&mut fl_bad, okd, nvals);
            }
            _ => {
            }
        }
        ii = ii + 1;
    }
    // Candidates: value id -> candidate index, whether it is a local, and
    // whether it is an f64 (the xmm file)
    var cidx: Vec<i64> = Vec::new();
    while cidx.len() < nvals {
        cidx.push(-1);
    }
    var cand: Vec<i64> = Vec::new();
    var is_local: Vec<i64> = Vec::new();
    var is_flt: Vec<i64> = Vec::new();
    var defined: Vec<i64> = peir_zeros(nvals);
    var b: i64 = 0;
    while b < nb {
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < nvals {
                match IrFunction_get_inst(func, id) {
                    OptInst::Some(inst) => {
                        match inst {
                            Inst::Alloca(ty, _) => {
                                if facts.weight.len() > id && facts.weight.get(id) != 0 && facts.bad.get(id) == 0 && cidx.get(id) < 0 {
                                    if peir_reg_word(module, ty) {
                                        cidx.set(id, cand.len());
                                        cand.push(id);
                                        is_local.push(1);
                                        is_flt.push(0);
                                    } else if PEIR_XMM_RA && ir_type_eq(ty, IrType::F64) {
                                        cidx.set(id, cand.len());
                                        cand.push(id);
                                        is_local.push(1);
                                        is_flt.push(1);
                                    }
                                }
                            }
                            _ => {
                                if defined.get(id) == 0 && cidx.get(id) < 0 {
                                    match IrFunction_get_meta(func, id) {
                                        OptValueMeta::Some(vm) => {
                                            if no_reg.get(id) == 0 && peir_reg_type(module, vm.ty) {
                                                cidx.set(id, cand.len());
                                                cand.push(id);
                                                is_local.push(0);
                                                is_flt.push(0);
                                            } else if PEIR_XMM_RA && ir_type_eq(vm.ty, IrType::F64) && fl_bad.get(id) == 0 {
                                                cidx.set(id, cand.len());
                                                cand.push(id);
                                                is_local.push(0);
                                                is_flt.push(1);
                                            }
                                        }
                                        OptValueMeta::None => {
                                        }
                                    }
                                }
                            }
                        }
                        defined.set(id, 1);
                    }
                    OptInst::None => {
                    }
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var pi: i64 = 0;
    while pi < func.params.len() {
        var prm: ValueIdType = func.params.get(pi);
        if prm.id >= 0 && prm.id < nvals && cidx.get(prm.id) < 0 {
            if no_reg.get(prm.id) == 0 && peir_reg_word(module, prm.ty) {
                cidx.set(prm.id, cand.len());
                cand.push(prm.id);
                is_local.push(0);
                is_flt.push(0);
            } else if PEIR_XMM_RA && ir_type_eq(prm.ty, IrType::F64) && fl_bad.get(prm.id) == 0 {
                cidx.set(prm.id, cand.len());
                cand.push(prm.id);
                is_local.push(0);
                is_flt.push(1);
            }
        }
        pi = pi + 1;
    }
    var nc: i64 = cand.len();
    if nc == 0 {
        return used;
    }
    var nw: i64 = (nc + 63) / 64;
    // Per block: upward-exposed uses and definitions; positions and weights
    var use_bs: Vec<i64> = peir_zeros(nb * nw);
    var def_bs: Vec<i64> = peir_zeros(nb * nw);
    var lo: Vec<i64> = Vec::new();
    var hi: Vec<i64> = Vec::new();
    var wt: Vec<i64> = peir_zeros(nc);
    var ci: i64 = 0;
    while ci < nc {
        lo.push(1 << 60);
        hi.push(-2);
        ci = ci + 1;
    }
    var bstart: Vec<i64> = peir_zeros(nb);
    var bend: Vec<i64> = peir_zeros(nb);
    // For coalescing: where a candidate is defined, which local it was
    // loaded from, its operands, its uses; every load and store of a local
    var def_pos: Vec<i64> = Vec::new();
    var def_blk: Vec<i64> = Vec::new();
    var ld_from: Vec<i64> = Vec::new();
    var bin_l: Vec<i64> = Vec::new();
    var bin_r: Vec<i64> = Vec::new();
    var hint: Vec<i64> = Vec::new();
    var nuse: Vec<i64> = peir_zeros(nc);
    ci = 0;
    while ci < nc {
        def_pos.push(-1);
        def_blk.push(-1);
        ld_from.push(-1);
        bin_l.push(-1);
        bin_r.push(-1);
        hint.push(-1);
        ci = ci + 1;
    }
    var ld_pos: Vec<i64> = Vec::new();
    var ld_loc: Vec<i64> = Vec::new();
    var ld_val: Vec<i64> = Vec::new();
    var st_pos: Vec<i64> = Vec::new();
    var st_loc: Vec<i64> = Vec::new();
    var st_val: Vec<i64> = Vec::new();
    // Per position: whether a caller-saved register survives the
    // instruction, may end its life there, or start it there
    var p_safe: Vec<i64> = Vec::new();
    var p_hi_ok: Vec<i64> = Vec::new();
    var p_lo_ok: Vec<i64> = Vec::new();
    // Parameters are defined before the first instruction (position -1)
    pi = 0;
    while pi < func.params.len() {
        var pid: i64 = func.params.get(pi).id;
        if pid >= 0 && pid < nvals && cidx.get(pid) >= 0 {
            var pk: i64 = cidx.get(pid);
            peir_bs_set(&mut def_bs, 0, pk);
            lo.set(pk, -1);
            if hi.get(pk) < -1 {
                hi.set(pk, -1);
            }
        }
        pi = pi + 1;
    }
    var pos: i64 = 0;
    b = 0;
    while b < nb {
        bstart.set(b, pos);
        var cost: i64 = 1;
        var c: i64 = 0;
        while c < facts.depth.get(b) && c < 4 {
            cost = cost * 10;
            c = c + 1;
        }
        var base: i64 = b * nw;
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            var safe: bool = false;
            var hi_ok: bool = false;
            var lo_ok: bool = false;
            match IrFunction_get_inst(func, id) {
                OptInst::Some(inst) => {
                    safe = peir_ra_volatile_safe(module, inst);
                    hi_ok = safe || peir_ra_reads_first(inst);
                    lo_ok = safe || peir_ra_writes_last(inst);
                    // The local a Store writes is defined, not read
                    var stored: i64 = -1;
                    match inst {
                        Inst::Store(sptr, svalue, _) => {
                            if sptr >= 0 && sptr < nvals && sptr != svalue && cidx.get(sptr) >= 0 && is_local.get(cidx.get(sptr)) == 1 {
                                stored = sptr;
                                st_pos.push(pos);
                                st_loc.push(cidx.get(sptr));
                                st_val.push(svalue);
                            }
                        }
                        Inst::Load(lptr, _) => {
                            if lptr >= 0 && lptr < nvals && cidx.get(lptr) >= 0 && is_local.get(cidx.get(lptr)) == 1 {
                                var lk: i64 = -1;
                                if id >= 0 && id < nvals && cidx.get(id) >= 0 && is_local.get(cidx.get(id)) == 0 {
                                    lk = cidx.get(id);
                                    ld_from.set(lk, cidx.get(lptr));
                                }
                                ld_pos.push(pos);
                                ld_loc.push(cidx.get(lptr));
                                ld_val.push(lk);
                            }
                        }
                        Inst::BinOp(bop, bl, br, bty) => {
                            if id >= 0 && id < nvals && cidx.get(id) >= 0 && is_local.get(cidx.get(id)) == 0 {
                                var bk: i64 = cidx.get(id);
                                if bl >= 0 && bl < nvals && cidx.get(bl) >= 0 && is_flt.get(cidx.get(bl)) == is_flt.get(bk) {
                                    hint.set(bk, cidx.get(bl));
                                }
                                if peir_ra_in_reg_op(bop, bty) && bl >= 0 && bl < nvals && cidx.get(bl) >= 0 {
                                    bin_l.set(bk, cidx.get(bl));
                                    if br >= 0 && br < nvals && cidx.get(br) >= 0 {
                                        bin_r.set(bk, cidx.get(br));
                                    } else {
                                        bin_r.set(bk, -2);
                                    }
                                }
                            }
                        }
                        _ => {
                        }
                    }
                    ops.clear();
                    peir_inst_operands(inst, &mut ops);
                    var o: i64 = 0;
                    while o < ops.len() {
                        var op: i64 = ops.get(o);
                        if op >= 0 && op < nvals && op != stored && cidx.get(op) >= 0 {
                            var ck: i64 = cidx.get(op);
                            if !peir_bs_test(&def_bs, base, ck) {
                                peir_bs_set(&mut use_bs, base, ck);
                            }
                            if pos < lo.get(ck) {
                                lo.set(ck, pos);
                            }
                            if pos > hi.get(ck) {
                                hi.set(ck, pos);
                            }
                            wt.set(ck, wt.get(ck) + cost);
                            nuse.set(ck, nuse.get(ck) + 1);
                        }
                        o = o + 1;
                    }
                    var dv: i64 = stored;
                    if dv < 0 && id >= 0 && id < nvals && cidx.get(id) >= 0 && is_local.get(cidx.get(id)) == 0 {
                        dv = id;
                    }
                    if dv >= 0 {
                        var dk: i64 = cidx.get(dv);
                        peir_bs_set(&mut def_bs, base, dk);
                        if pos < lo.get(dk) {
                            lo.set(dk, pos);
                        }
                        if pos > hi.get(dk) {
                            hi.set(dk, pos);
                        }
                        wt.set(dk, wt.get(dk) + cost);
                        if dv == id {
                            def_pos.set(dk, pos);
                            def_blk.set(dk, b);
                        }
                    }
                }
                OptInst::None => {
                }
            }
            if safe {
                p_safe.push(1);
            } else {
                p_safe.push(0);
            }
            if hi_ok {
                p_hi_ok.push(1);
            } else {
                p_hi_ok.push(0);
            }
            if lo_ok {
                p_lo_ok.push(1);
            } else {
                p_lo_ok.push(0);
            }
            pos = pos + 1;
            k = k + 1;
        }
        bend.set(b, pos - 1);
        b = b + 1;
    }
    // Successors: the shared CFG (compiler/checks.fd iro_cfg, ME2); its block
    // indexes are facts.index's, and it has every Switch edge
    var ra_cfg: IroCfg = iro_cfg(func);
    // Liveness: in = use | (out & ~def), out = the ins of the successors
    var live_in: Vec<i64> = peir_zeros(nb * nw);
    var live_out: Vec<i64> = peir_zeros(nb * nw);
    var changed: bool = true;
    while changed {
        changed = false;
        b = nb - 1;
        while b >= 0 {
            var base2: i64 = b * nw;
            var ss2: Vec<i64> = ra_cfg.succs.get(b);
            var w: i64 = 0;
            while w < nw {
                var out: i64 = 0;
                var lsi: i64 = 0;
                while lsi < ss2.len() {
                    out = out | live_in.get(ss2.get(lsi) * nw + w);
                    lsi = lsi + 1;
                }
                live_out.set(base2 + w, out);
                var inw: i64 = use_bs.get(base2 + w) | (out & ~def_bs.get(base2 + w));
                if inw != live_in.get(base2 + w) {
                    live_in.set(base2 + w, inw);
                    changed = true;
                }
                w = w + 1;
            }
            b = b - 1;
        }
    }
    // Intervals: every point of a block a candidate is live through
    b = 0;
    while b < nb {
        var base3: i64 = b * nw;
        var w2: i64 = 0;
        while w2 < nw {
            var lin: i64 = live_in.get(base3 + w2);
            var lout: i64 = live_out.get(base3 + w2);
            if lin != 0 || lout != 0 {
                var bit: i64 = 0;
                while bit < 64 {
                    var ck2: i64 = w2 * 64 + bit;
                    if ck2 < nc {
                        if ((lin >> bit) & 1) != 0 {
                            // 2g.80: live into the block is live before its
                            // first instruction, one position earlier. At
                            // bstart a value whose last use (or dead
                            // definition) is there may hand its register
                            // to one starting there (peir_ra_scan); a
                            // value defined in a block laid out later
                            // (unrolled copies, chained backwards) would
                            // start exactly there and share it while live.
                            if bstart.get(b) - 1 < lo.get(ck2) {
                                lo.set(ck2, bstart.get(b) - 1);
                            }
                            if bstart.get(b) > hi.get(ck2) {
                                hi.set(ck2, bstart.get(b));
                            }
                        }
                        if ((lout >> bit) & 1) != 0 {
                            if bend.get(b) > hi.get(ck2) {
                                hi.set(ck2, bend.get(b));
                            }
                        }
                    }
                    bit = bit + 1;
                }
            }
            w2 = w2 + 1;
        }
        b = b + 1;
    }
    // ── Copy coalescing (competitive OP16) ──
    // A local A in a register and the SSA values that only copy it share
    // its register, so the moves disappear:
    //  - a Load of A whose value lives in the block, while nothing stores
    //    to A (it holds A's contents);
    //  - a value stored into A, defined in that block, while A's old
    //    contents are dead from its definition to the store (it holds A's
    //    next contents);
    //  - the left operand of such a value's add/sub/mul/and/or/xor when that
    //    is its only use (computed in place: `add rA, x`).
    // Members are left out of the scan; A's interval covers theirs.
    var alias: Vec<i64> = Vec::new();
    var root: Vec<i64> = Vec::new();
    ci = 0;
    while ci < nc {
        alias.push(-1);
        root.push(-1);
        ci = ci + 1;
    }
    if PEIR_COALESCE {
        // Loads
        ci = 0;
        while ci < nc {
            var la: i64 = ld_from.get(ci);
            if la >= 0 && is_flt.get(la) == is_flt.get(ci) && lo.get(ci) == def_pos.get(ci) && def_blk.get(ci) >= 0 && hi.get(ci) >= lo.get(ci) && hi.get(ci) <= bend.get(def_blk.get(ci)) {
                var ok: bool = true;
                var si: i64 = 0;
                while si < st_pos.len() && ok {
                    if st_loc.get(si) == la && st_pos.get(si) > lo.get(ci) && st_pos.get(si) <= hi.get(ci) && st_val.get(si) != cand.get(ci) {
                        ok = false;
                    }
                    si = si + 1;
                }
                if ok {
                    alias.set(ci, la);
                }
            }
            ci = ci + 1;
        }
        // Stores, in order
        var sj: i64 = 0;
        while sj < st_pos.len() {
            var a0: i64 = st_loc.get(sj);
            var sv: i64 = st_val.get(sj);
            var s0: i64 = st_pos.get(sj);
            if sv >= 0 && sv < nvals && cidx.get(sv) >= 0 {
                var wk: i64 = cidx.get(sv);
                var cur: i64 = wk;
                var first: bool = true;
                while cur >= 0 {
                    var ok2: bool = is_local.get(cur) == 0 && alias.get(cur) < 0 && is_flt.get(cur) == is_flt.get(a0) && def_blk.get(cur) >= 0 && lo.get(cur) == def_pos.get(cur) && lo.get(cur) < s0 && s0 <= bend.get(def_blk.get(cur)) && s0 >= bstart.get(def_blk.get(cur)) && hi.get(cur) <= bend.get(def_blk.get(cur));
                    if ok2 && !first {
                        // the operand of the previous member, used only there
                        ok2 = nuse.get(cur) == 1;
                    }
                    if ok2 && first {
                        // no other store to A while it lives
                        var t: i64 = 0;
                        while t < st_pos.len() && ok2 {
                            if t != sj && st_loc.get(t) == a0 && st_pos.get(t) > lo.get(cur) && st_pos.get(t) <= hi.get(cur) {
                                ok2 = false;
                            }
                            t = t + 1;
                        }
                    }
                    if ok2 {
                        // A's old contents are dead in (lo, s0): no load of A
                        // there, and no member of A alive there
                        var t2: i64 = 0;
                        while t2 < ld_pos.len() && ok2 {
                            if ld_loc.get(t2) == a0 && ld_pos.get(t2) > lo.get(cur) && ld_pos.get(t2) < s0 {
                                ok2 = false;
                            }
                            t2 = t2 + 1;
                        }
                        var m: i64 = 0;
                        while m < nc && ok2 {
                            if alias.get(m) == a0 && root.get(m) != sj && !(hi.get(m) <= lo.get(cur) || lo.get(m) >= s0) {
                                ok2 = false;
                            }
                            m = m + 1;
                        }
                    }
                    if !ok2 {
                        break;
                    }
                    alias.set(cur, a0);
                    root.set(cur, sj);
                    first = false;
                    // The left operand of a value computed in place
                    var nl: i64 = bin_l.get(cur);
                    var nr: i64 = bin_r.get(cur);
                    if nl < 0 || nl == a0 || (nr >= 0 && (nr == a0 || alias.get(nr) == a0)) {
                        break;
                    }
                    if hi.get(nl) != lo.get(cur) || def_blk.get(nl) != def_blk.get(cur) {
                        break;
                    }
                    cur = nl;
                }
            }
            sj = sj + 1;
        }
    }
    // A's interval and weight take in its members'
    var olo: Vec<i64> = Vec::new();
    var ohi: Vec<i64> = Vec::new();
    var owt: Vec<i64> = Vec::new();
    ci = 0;
    while ci < nc {
        olo.push(lo.get(ci));
        ohi.push(hi.get(ci));
        owt.push(wt.get(ci));
        ci = ci + 1;
    }
    ci = 0;
    while ci < nc {
        var al: i64 = alias.get(ci);
        if al >= 0 {
            if lo.get(ci) < lo.get(al) {
                lo.set(al, lo.get(ci));
            }
            if hi.get(ci) > hi.get(al) {
                hi.set(al, hi.get(ci));
            }
            wt.set(al, wt.get(al) + wt.get(ci));
        }
        ci = ci + 1;
    }
    var npos: i64 = pos + 2;
    // Unsafe positions, counted from the start: an interval may use a
    // caller-saved register when none lies inside it
    var unsafe_before: Vec<i64> = Vec::new();
    var cnt: i64 = 0;
    var q: i64 = 0;
    while q < p_safe.len() {
        unsafe_before.push(cnt);
        if p_safe.get(q) == 0 {
            cnt = cnt + 1;
        }
        q = q + 1;
    }
    unsafe_before.push(cnt);
    var reg_gp: Vec<i64> = Vec::new();
    var reg_x: Vec<i64> = Vec::new();
    // D4: r8 and r9 as value registers (FID_PE_OFF=r89: not)
    var arg_ra: bool = PEIR_ARG_RA && peir_on("r89");
    var round: i64 = 0;
    while round < 3 {
        var vok: Vec<i64> = peir_zeros(nc);
        var part_gp: Vec<i64> = peir_zeros(nc);
        var part_x: Vec<i64> = peir_zeros(nc);
        ci = 0;
        while ci < nc {
            if alias.get(ci) < 0 && !(lo.get(ci) == -1 && hi.get(ci) == -1 && nuse.get(ci) == 0) {
                if is_flt.get(ci) == 1 {
                    part_x.set(ci, 1);
                } else {
                    part_gp.set(ci, 1);
                }
                var l0: i64 = lo.get(ci);
                var h0: i64 = hi.get(ci);
                if PEIR_VOLATILE_RA && h0 >= l0 && h0 < p_safe.len() {
                    var good: bool = true;
                    if l0 >= 0 && p_lo_ok.get(l0) == 0 {
                        good = false;
                    }
                    if h0 > l0 && p_hi_ok.get(h0) == 0 {
                        good = false;
                    }
                    var from: i64 = l0 + 1;
                    if from < 0 {
                        from = 0;
                    }
                    if h0 > from && unsafe_before.get(h0) - unsafe_before.get(from) > 0 {
                        good = false;
                    }
                    if good {
                        vok.set(ci, 1);
                        // D4: r8/r9 too when the range neither starts nor
                        // ends at a call (a call's arguments are moved into
                        // rcx, rdx, r8, r9 one after another, and its result
                        // is written after code that may use them) and is
                        // not a parameter's (they arrive in rcx-r9 and are
                        // moved to their registers one after another)
                        if arg_ra && l0 >= 0 && p_safe.get(l0) == 1 && p_safe.get(h0) == 1 {
                            vok.set(ci, 2);
                        }
                    }
                }
            }
            ci = ci + 1;
        }
        reg_gp = peir_ra_scan(nc, &lo, &hi, &wt, &part_gp, &vok, &hint, PEIR_ALL_REGS, PEIR_VALUE_REGS, PEIR_ARG_VALUE_REGS, npos);
        reg_x = peir_ra_scan(nc, &lo, &hi, &wt, &part_x, &vok, &hint, 6, 2, 6, npos);
        // A local left in memory: its members get registers of their own
        var again: bool = false;
        ci = 0;
        while ci < nc {
            var al2: i64 = alias.get(ci);
            if al2 >= 0 && reg_gp.get(al2) < 0 && reg_x.get(al2) < 0 {
                alias.set(ci, -1);
                lo.set(al2, olo.get(al2));
                hi.set(al2, ohi.get(al2));
                wt.set(al2, owt.get(al2));
                again = true;
            }
            ci = ci + 1;
        }
        if !again {
            break;
        }
        // the locals that kept members take them in again
        ci = 0;
        while ci < nc {
            var al3: i64 = alias.get(ci);
            if al3 >= 0 {
                if lo.get(ci) < lo.get(al3) {
                    lo.set(al3, lo.get(ci));
                }
                if hi.get(ci) > hi.get(al3) {
                    hi.set(al3, hi.get(ci));
                }
            }
            ci = ci + 1;
        }
        round = round + 1;
    }
    // Results
    ci = 0;
    while ci < nc {
        var owner: i64 = ci;
        if alias.get(ci) >= 0 {
            owner = alias.get(ci);
        }
        var slotreg: i64 = -1;
        if is_flt.get(ci) == 1 {
            if reg_x.get(owner) >= 0 {
                slotreg = 0x100 + peir_ra_xmm(reg_x.get(owner));
            }
        } else if reg_gp.get(owner) >= 0 {
            slotreg = reg_gp.get(owner);
        }
        if slotreg >= 0 {
            var v: i64 = cand.get(ci);
            if is_local.get(ci) == 1 {
                pe_idmap_put(&mut frame.reg_vars, v, PEIR_REG_SLOT + slotreg);
            } else {
                in_reg.set(v, slotreg + 1);
            }
            peir_mark(no_reg, v, nvals);
            if !peir_has_i64(used, slotreg) {
                used.push(slotreg);
            }
        }
        ci = ci + 1;
    }
    return used;
}

/// src/pe.rs pick_reg_vars: the locals worth a register, most used first.
fn peir_pick_reg_vars(func: &IrFunction, module: &IrModule, frame: &mut PeStackFrame, no_reg: &mut Vec<i64>, nvals: i64, limit: i64, out: &mut PeirRaFacts) -> Vec<i64> {
    var nb: i64 = func.blocks.len();
    var max_id: i64 = 0;
    var b: i64 = 0;
    while b < nb {
        if func.blocks.get(b).id > max_id {
            max_id = func.blocks.get(b).id;
        }
        b = b + 1;
    }
    var index: Vec<i64> = Vec::new();
    while index.len() <= max_id {
        index.push(-1);
    }
    b = 0;
    while b < nb {
        index.set(func.blocks.get(b).id, b);
        b = b + 1;
    }
    var depth: Vec<i64> = peir_zeros(nb);
    b = 0;
    while b < nb {
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        if ids.len() > 0 {
            match IrFunction_get_inst(func, ids.get(ids.len() - 1)) {
                OptInst::Some(last) => {
                    match last {
                        Inst::Jump(t) => {
                            peir_loop_back(index, &mut depth, t, b);
                        }
                        Inst::Branch(_, t, e) => {
                            peir_loop_back(index, &mut depth, t, b);
                            peir_loop_back(index, &mut depth, e, b);
                        }
                        Inst::Switch(_, _, sw_t, sw_d) => {
                            var swb: Vec<i64> = switch_succ_blocks(sw_t, sw_d);
                            var swi: i64 = 0;
                            while swi < swb.len() {
                                peir_loop_back(index, &mut depth, swb.get(swi), b);
                                swi = swi + 1;
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
        }
        b = b + 1;
    }
    // Per value: weight + 1 when it is a candidate, and whether it must stay in memory
    var weight: Vec<i64> = peir_zeros(nvals);
    var bad: Vec<i64> = peir_zeros(nvals);
    b = 0;
    while b < nb {
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            match IrFunction_get_inst(func, id) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::Alloca(ty, _) => {
                            if (peir_reg_word(module, ty) || (PEIR_XMM_RA && PEIR_GLOBAL_RA && limit == 0 && ir_type_eq(ty, IrType::F64))) && id < nvals {
                                weight.set(id, 1);
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var ops: Vec<i64> = Vec::new();
    b = 0;
    while b < nb {
        var cost: i64 = 1;
        var c: i64 = 0;
        while c < depth.get(b) && c < 4 {
            cost = cost * 10;
            c = c + 1;
        }
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            match IrFunction_get_inst(func, id) {
                OptInst::Some(inst) => {
                    // Float instructions read and write their slots directly
                    match inst {
                        Inst::BinOp(_, left, right, ty) => {
                            if ir_type_is_float(ty) || peir_value_float(func, left) {
                                peir_mark(no_reg, left, nvals);
                                peir_mark(no_reg, right, nvals);
                                peir_mark(no_reg, id, nvals);
                            }
                        }
                        Inst::UnaryOp(_, operand, ty) => {
                            if ir_type_is_float(ty) {
                                peir_mark(no_reg, operand, nvals);
                                peir_mark(no_reg, id, nvals);
                            }
                        }
                        Inst::FloatToInt(value, _, _) => {
                            peir_mark(no_reg, value, nvals);
                        }
                        Inst::IntToFloat(_, _, _) => {
                            peir_mark(no_reg, id, nvals);
                        }
                        _ => {
                        }
                    }
                    ops.clear();
                    peir_inst_operands(inst, &mut ops);
                    var o: i64 = 0;
                    while o < ops.len() {
                        var op: i64 = ops.get(o);
                        if op >= 0 && op < nvals && weight.get(op) != 0 {
                            var whole: bool = false;
                            match inst {
                                Inst::Load(ptr, ty) => {
                                    whole = ptr == op && (peir_reg_word(module, ty) || (PEIR_XMM_RA && PEIR_GLOBAL_RA && ir_type_eq(ty, IrType::F64)));
                                }
                                Inst::Store(ptr, value, sty) => {
                                    var fval: bool = PEIR_XMM_RA && PEIR_GLOBAL_RA && peir_value_f64(func, value);
                                    whole = ptr == op && value != op && (peir_value_word(func, module, value) || fval);
                                    match sty {
                                        OptIrType::Some(t) => {
                                            if !peir_reg_word(module, t) && !(fval && ir_type_eq(t, IrType::F64)) {
                                                whole = false;
                                            }
                                        }
                                        OptIrType::None => {
                                        }
                                    }
                                }
                                _ => {
                                }
                            }
                            if whole {
                                weight.set(op, weight.get(op) + cost);
                            } else {
                                bad.set(op, 1);
                            }
                        }
                        o = o + 1;
                    }
                }
                OptInst::None => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var taken: Vec<i64> = Vec::new();
    // The analysis, for the whole-function allocator
    out.weight = weight;
    out.bad = bad;
    out.depth = depth;
    out.index = index;
    while taken.len() < limit {
        var best: i64 = -1;
        var best_w: i64 = 3;
        var ii: i64 = 0;
        while ii < func.insts.len() {
            var id: i64 = func.insts.get(ii).id;
            if id < nvals && bad.get(id) == 0 && weight.get(id) - 1 >= best_w {
                if best < 0 || weight.get(id) - 1 > best_w {
                    best = id;
                    best_w = weight.get(id) - 1;
                }
            }
            ii = ii + 1;
        }
        if best < 0 {
            break;
        }
        pe_idmap_put(&mut frame.reg_vars, best, PEIR_REG_SLOT + taken.len());
        peir_mark(no_reg, best, nvals);
        bad.set(best, 1);
        taken.push(taken.len());
    }
    // Constants read only as immediates, in their own block, need no slot.
    // const_block: block + 1 while a value may be one.
    var const_block: Vec<i64> = peir_zeros(nvals);
    var const_used: Vec<i64> = peir_zeros(nvals);
    b = 0;
    while b < nb {
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            match IrFunction_get_inst(func, id) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::ConstInt(_, _) => {
                            if id < nvals {
                                const_block.set(id, b + 1);
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    b = 0;
    while b < nb {
        var ids: Vec<i64> = func.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            match IrFunction_get_inst(func, ids.get(k)) {
                OptInst::Some(inst) => {
                    ops.clear();
                    peir_inst_operands(inst, &mut ops);
                    var o: i64 = 0;
                    while o < ops.len() {
                        var op: i64 = ops.get(o);
                        if op >= 0 && op < nvals {
                            const_used.set(op, 1);
                            var imm: bool = false;
                            match inst {
                                Inst::BinOp(_, left, _, ty) => {
                                    imm = !ir_type_is_float(ty) && !peir_value_float(func, left);
                                }
                                Inst::Store(ptr, value, _) => {
                                    imm = value == op && pe_idmap_has(&frame.reg_vars, ptr);
                                }
                                // A call's null environment: the generic call
                                // path loads constant arguments as immediates
                                Inst::Call(callee, cargs, _, _) => {
                                    imm = peir_env_imm(module, callee, cargs, op) || peir_inline_vec_imm(module, callee, cargs);
                                }
                                _ => {
                                }
                            }
                            if !imm || const_block.get(op) != b + 1 {
                                const_block.set(op, 0);
                            }
                        }
                        o = o + 1;
                    }
                }
                OptInst::None => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    frame.imm_only = peir_zeros(nvals);
    var ci: i64 = 0;
    while ci < nvals {
        if const_block.get(ci) != 0 && const_used.get(ci) != 0 {
            frame.imm_only.set(ci, 1);
            no_reg.set(ci, 1);
        }
        ci = ci + 1;
    }
    return taken;
}

/// src/pe.rs div_magic: [multiplier, shift] of a signed division by d >= 2.
@wrapping
fn peir_div_magic(d0: i64) -> Vec<i64> {
    var d: u64 = d0 as u64;
    var two63: u64 = 0x8000000000000000;
    var anc: u64 = two63 - 1 - two63 % d;
    var p: i64 = 63;
    var q1: u64 = two63 / anc;
    var r1: u64 = two63 - q1 * anc;
    var q2: u64 = two63 / d;
    var r2: u64 = two63 - q2 * d;
    while true {
        p = p + 1;
        q1 = q1 * 2;
        r1 = r1 * 2;
        if r1 >= anc {
            q1 = q1 + 1;
            r1 = r1 - anc;
        }
        q2 = q2 * 2;
        r2 = r2 * 2;
        if r2 >= d {
            q2 = q2 + 1;
            r2 = r2 - d;
        }
        var delta: u64 = d - r2;
        if !(q1 < delta || (q1 == delta && r1 == 0)) {
            break;
        }
    }
    var out: Vec<i64> = Vec::new();
    out.push((q2 + 1) as i64);
    out.push(p - 64);
    return out;
}

// ===========================================================================
// PeirGen::gen_inst (src/pe.rs) — code for a single instruction
// ===========================================================================

/// Emit the autograd call shared by GradBegin / GradEnd / Backward.
fn PeirGen_gen_autograd(self: &mut PeirGen, inst: Inst, nargs: i64) -> void {
    // Autograd, as in the C backend: start/stop recording the
    // tape, run the backward pass (loss argument: NULL)
    var builtin: str = pe_ir_autograd_builtin(inst);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirGen_call_builtin(self, builtin, nargs);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
}

/// Generate code for a single instruction.
pub fn PeirGen_gen_inst(self: &mut PeirGen, id: i64, inst: Inst, next_cond: i64, frame: &mut PeStackFrame, func: &IrFunction, module: &IrModule, func_name: str,) -> void {
    var dst: i64 = PeStackFrame_offset(frame, id);
    self.cur_unchecked = id < self.unchecked.len() && (self.unchecked.get(id) & 1) != 0;

    match inst {
        // --- Constants ---
        Inst::ConstInt(value, _) => {
            if id < frame.imm_only.len() && frame.imm_only.get(id) != 0 {
                pe_idmap_put(&mut frame.const_vals, id, value);
                return;
            }
            // straight into its register (competitive OP19)
            if dst >= PEIR_REG_SLOT && !peir_is_xmm_slot(dst) {
                PeirEnc_mov_imm_cp(&mut self.enc, peir_value_reg(dst - PEIR_REG_SLOT), value);
            } else {
                PeirEnc_mov_imm(&mut self.enc, PEIR_RAX, value);
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            }
            pe_idmap_put(&mut frame.const_vals, id, value);
        }

        Inst::ConstBool(value) => {
            var v8: i64 = 0;
            if value {
                v8 = 1;
            }
            if dst >= PEIR_REG_SLOT && !peir_is_xmm_slot(dst) {
                PeirEnc_mov_imm_cp(&mut self.enc, peir_value_reg(dst - PEIR_REG_SLOT), v8);
            } else {
                PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, v8);
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            }
        }

        Inst::ConstStr(value) => {
            // Always a string, even one spelling a function's name (the
            // string "main" was emitted as the address of fn main):
            // function values are ConstFnRef.
            var off: i64 = PeirGen_str_off(self, value);
            PeirEnc_lea_rip(&mut self.enc, PEIR_RAX, off);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::ConstFnRef(name) => {
            // Function reference — resolve to function label address
            if HashMap_contains(self.func_labels, name) {
                var flabel: i64 = HashMap_get(self.func_labels, name);
                PeirEnc_lea_label(&mut self.enc, PEIR_RAX, flabel);
            } else {
                PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0);
            }
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::ConstFloat(value, ty) => {
            // ConstFloat holds the f64 value: an F32 constant is that value
            // rounded to an f32, its 32 bits (as codegen_c and nat_ir).
            // MI17 (known-bugs 2g.95): this took the low 32 bits of the
            // f64's pattern, 0.0 for 2^63, so the range checks of a
            // saturating f32 `as i64` sent every value to i64::MAX/MIN.
            if ir_type_eq(ty, IrType::F32) {
                var bits32: i64 = p_f32_to_bits(value) & 0xFFFFFFFF;
                PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, bits32);
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            } else {
                PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, p_f64_to_bits(value));
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            }
        }

        Inst::ConstNull(_) => {
            PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::GlobalAddr(name, _) => {
            // lea rax, [rip + global_offset]
            var goff: i64 = HashMap_get(self.global_rdata_offsets, name);
            PeirEnc_lea_rip(&mut self.enc, PEIR_RAX, goff);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        // --- Arithmetic ---
        Inst::BinOp(op, left, right, ty) => {
            var loff: i64 = PeStackFrame_offset(frame, left);
            var roff: i64 = PeStackFrame_offset(frame, right);
            // A comparison's type is Bool: its operands' type decides
            // (a parameter has no instruction: its type is in the
            // parameter list; `x > 1` on a u64 parameter compared signed)
            var operand_ty: IrType = peir_operand_ty(func, left);
            var right_ty: IrType = peir_operand_ty(func, right);
            var unsigned_cmp: bool = ir_type_eq(operand_ty, IrType::U64) || ir_type_eq(right_ty, IrType::U64);
            // For / and %, which compare nothing: the dividend is >= 0
            // (range analysis bit 2), so a constant divisor needs no sign fix
            match op {
                BinOp::Div => {
                    unsigned_cmp = left < self.unchecked.len() && (self.unchecked.get(left) & 2) != 0;
                }
                BinOp::Mod => {
                    unsigned_cmp = left < self.unchecked.len() && (self.unchecked.get(left) & 2) != 0;
                }
                _ => {
                }
            }
            if ir_type_is_float(ty) {
                PeirGen_gen_float_binop(self, op, loff, roff, dst, ty);
            } else if ir_type_is_float(operand_ty) {
                PeirGen_gen_float_binop(self, op, loff, roff, dst, operand_ty);
            } else {
                var lconst: OptU64 = OptU64::None;
                var rconst: OptU64 = OptU64::None;
                if pe_idmap_has(&frame.const_vals, left) {
                    lconst = OptU64::Some(pe_idmap_get(&frame.const_vals, left));
                }
                if pe_idmap_has(&frame.const_vals, right) {
                    rconst = OptU64::Some(pe_idmap_get(&frame.const_vals, right));
                }
                // D13: a constant left operand of a comparison or of a
                // commutative operation goes right (`5 < x` is `x > 5`), so
                // x is compared in its register or slot against an
                // immediate. `cc` below comes from the mirrored operation,
                // so the fused branch tests the swapped condition.
                var bop: BinOp = op;
                if PEIR_CONST_LEFT_SWAP && peir_op_commutes(op) && pe_idmap_has(&frame.const_vals, left) && !pe_idmap_has(&frame.const_vals, right) && peir_on("cswap") {
                    bop = peir_mirror_op(op);
                    var sw_off: i64 = loff;
                    loff = roff;
                    roff = sw_off;
                    rconst = lconst;
                    lconst = OptU64::None;
                }
                // cmp+branch fusion (item 82): a comparison feeding the next
                // instruction's Branch keeps its flags live through
                // setcc/movzx/mov — the branch jcc's on them directly. When
                // that Branch is its only use, it is not stored at all.
                var cc: i64 = peir_int_cmp_cc(bop, unsigned_cmp);
                self.flags_only = cc >= 0 && next_cond == id && id < self.use_count.len() && self.use_count.get(id) == 1;
                // OP20 (BMI1, --cpu x86-64-v3|v4): a 64-bit `x & (x - 1)`
                // is BLSR (peir_blsr_src)
                var blsr_x: i64 = -1;
                if peir_bmi() && (ir_type_eq(ty, IrType::I64) || ir_type_eq(ty, IrType::U64)) {
                    match op {
                        BinOp::BitAnd => {
                            blsr_x = peir_blsr_src(func, frame, left, right);
                            if blsr_x < 0 {
                                blsr_x = peir_blsr_src(func, frame, right, left);
                            }
                        }
                        _ => {
                        }
                    }
                }
                if blsr_x >= 0 {
                    PeirGen_gen_blsr(self, PeStackFrame_offset(frame, blsr_x), dst);
                } else {
                    PeirGen_gen_int_binop(self, bop, loff, roff, dst, lconst, rconst, ty, unsigned_cmp);
                }
                self.flags_only = false;
                if cc >= 0 && next_cond == id {
                    self.pending_cmp_cc = cc;
                    self.pending_cmp_vid = id;
                }
            }
        }

        Inst::UnaryOp(op, operand, ty) => {
            var off: i64 = PeStackFrame_offset(frame, operand);
            match op {
                UnaryOp::Neg => {
                    if ir_type_is_float(ty) {
                        // Float negation: XOR sign bit via register
                        PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, off);
                        var sign_bit: i64 = 1 << 63;
                        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, sign_bit);
                        PeirEnc_movq_xmm_r64(&mut self.enc, 1, PEIR_RAX);
                        PeirEnc_xorpd_xmm_xmm(&mut self.enc, 0, 1);
                        if ir_type_eq(ty, IrType::F32) {
                            PeirEnc_movss_mem_rbp_xmm(&mut self.enc, dst, 0);
                        } else {
                            PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, dst, 0);
                        }
                    } else {
                        PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, off);
                        PeirEnc_neg_r(&mut self.enc, PEIR_RAX);
                        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                    }
                }
                UnaryOp::Not => {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, off);
                    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 1);
                    PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
                    PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                }
                UnaryOp::BitNot => {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, off);
                    PeirEnc_not_r(&mut self.enc, PEIR_RAX);
                    PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                }
            }
        }

        // --- Memory ---
        Inst::Alloca(_, _) => {
            if pe_idmap_has(&frame.reg_vars, id) {
                return;
            }
            var data_offset: i64 = pe_idmap_get(&frame.alloca_slots, id);
            PeirEnc_lea_rbp(&mut self.enc, PEIR_RAX, data_offset);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::Load(ptr, ty) => {
            if pe_idmap_has(&frame.reg_vars, ptr) {
                PeirGen_move_slot(self, dst, pe_idmap_get(&frame.reg_vars, ptr));
                return;
            }
            var poff: i64 = PeStackFrame_offset(frame, ptr);
            var size: i64 = IrModule_type_size(module, ty);
            if size < 1 {
                size = 1;
            }
            // Unsigned values zero-extend (a u8 255 stays 255), as in C
            var unsigned: bool = false;
            match ty {
                IrType::U8 => {
                    unsigned = true;
                }
                IrType::U16 => {
                    unsigned = true;
                }
                IrType::U32 => {
                    unsigned = true;
                }
                IrType::Bool => {
                    unsigned = true;
                }
                _ => {
                }
            }
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, poff);
            if size == 1 {
                // mov al, [rax] (the rest of rax still holds the
                // address), then extend al over all of rax
                PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                if unsigned {
                    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
                } else {
                    PeirEnc_movsx_r64_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
            } else if size == 2 {
                PeirEnc_mov_reg16_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                if unsigned {
                    PeirEnc_movzx_r32_r16(&mut self.enc, PEIR_RAX, PEIR_RAX);
                } else {
                    PeirEnc_movsx_r64_r16(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
            } else if size == 4 {
                // mov eax, [rax] zero-extends into rax
                PeirEnc_mov_reg32_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                if !unsigned {
                    PeirEnc_movsxd_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
            } else {
                PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
            }
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::Store(ptr, value, explicit_ty) => {
            if pe_idmap_has(&frame.reg_vars, ptr) {
                var rvslot: i64 = pe_idmap_get(&frame.reg_vars, ptr);
                if peir_is_xmm_slot(rvslot) {
                    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, rvslot - PEIR_XMM_SLOT, PeStackFrame_offset(frame, value));
                    return;
                }
                var vreg: i64 = peir_value_reg(rvslot - PEIR_REG_SLOT);
                if pe_idmap_has(&frame.const_vals, value) {
                    // (D13: not again when the constant was just put there)
                    PeirEnc_mov_imm_cp(&mut self.enc, vreg, pe_idmap_get(&frame.const_vals, value));
                } else {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, vreg, PeStackFrame_offset(frame, value));
                }
                return;
            }
            var poff: i64 = PeStackFrame_offset(frame, ptr);
            var voff: i64 = PeStackFrame_offset(frame, value);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, poff);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, voff);
            // As in the C backend: the explicit store type, else the
            // pointee type, else the value's type.
            var pointee: OptIrType = OptIrType::None;
            match IrFunction_get_meta(func, ptr) {
                OptValueMeta::Some(pm) => {
                    match pm.ty {
                        IrType::Ptr(inner) => {
                            pointee = OptIrType::Some(box_ir_type_unbox(inner));
                        }
                        _ => {
                        }
                    }
                }
                OptValueMeta::None => {
                }
            }
            var store_ty: IrType = IrType::I64;
            var have_ty: bool = false;
            match explicit_ty {
                OptIrType::Some(t0) => {
                    store_ty = t0;
                    have_ty = true;
                }
                OptIrType::None => {
                }
            }
            if !have_ty {
                match pointee {
                    OptIrType::Some(t1) => {
                        store_ty = t1;
                        have_ty = true;
                    }
                    OptIrType::None => {
                    }
                }
            }
            if !have_ty {
                match IrFunction_get_meta(func, value) {
                    OptValueMeta::Some(vm) => {
                        store_ty = vm.ty;
                    }
                    OptValueMeta::None => {
                    }
                }
            }
            match store_ty {
                // Structs are passed by pointer: copy the struct itself.
                IrType::Struct(_) => {
                    var ssize: i64 = IrModule_type_size(module, store_ty);
                    PeirGen_emit_copy_rcx_to_rax(self, ssize);
                }
                IrType::Array(_, _) => {
                    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
                }
                IrType::Ptr(_) => {
                    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
                }
                IrType::Opaque(_) => {
                    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
                }
                IrType::Generic(_, _) => {
                    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
                }
                _ => {
                    var sz: i64 = IrModule_type_size(module, store_ty);
                    if sz == 1 {
                        PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_RAX, PEIR_RCX);
                    } else if sz == 2 {
                        PeirEnc_mov_ptr_reg16(&mut self.enc, PEIR_RAX, PEIR_RCX);
                    } else if sz == 4 {
                        PeirEnc_mov_ptr_reg32(&mut self.enc, PEIR_RAX, PEIR_RCX);
                    } else {
                        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
                    }
                }
            }
        }

        Inst::StructCopy(dst_v, src_v, ty) => {
            // Copy struct data from src to dst (memcpy of struct size bytes)
            var dst_off: i64 = PeStackFrame_offset(frame, dst_v);
            var src_off: i64 = PeStackFrame_offset(frame, src_v);
            var size: i64 = IrModule_type_size(module, ty);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, dst_off);
            // dst ptr
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, src_off);
            // src ptr
            PeirGen_emit_copy_rcx_to_rax(self, size);
        }

        Inst::GetFieldPtr(struct_ptr, field_index, _) => {
            var poff: i64 = PeStackFrame_offset(frame, struct_ptr);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, poff);
            var offset: i64 = field_index * 8;
            match IrFunction_get_meta(func, struct_ptr) {
                OptValueMeta::Some(ptr_meta) => {
                    var struct_name: str = "";
                    match ptr_meta.ty {
                        IrType::Ptr(inner) => {
                            match box_ir_type_unbox(inner) {
                                IrType::Struct(n) => {
                                    struct_name = n;
                                }
                                _ => {
                                }
                            }
                        }
                        IrType::Struct(n2) => {
                            struct_name = n2;
                        }
                        _ => {
                        }
                    }
                    if struct_name != "" {
                        match IrModule_get_struct(module, struct_name) {
                            OptStructLayout::Some(layout) => {
                                if field_index >= 0 && field_index < layout.fields.len() {
                                    offset = layout.fields.get(field_index).offset;
                                }
                            }
                            OptStructLayout::None => {
                            }
                        }
                    }
                }
                OptValueMeta::None => {
                }
            }
            if offset > 0 {
                PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, offset);
            }
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::GetElemPtr(array_ptr, index, elem_ty) => {
            var poff: i64 = PeStackFrame_offset(frame, array_ptr);
            var ioff: i64 = PeStackFrame_offset(frame, index);
            var elem_size: i64 = IrModule_type_size(module, elem_ty);
            if elem_size < 1 {
                elem_size = 1;
            }
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, poff);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, ioff);
            PeirEnc_imul_r_r_imm32(&mut self.enc, PEIR_RCX, PEIR_RCX, elem_size);
            PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        // --- Control Flow ---
        Inst::Jump(target) => {
            var blabel: i64 = HashMap_get(self.block_labels, pe_block_key(func_name, target));
            if blabel != self.next_block {
                PeirEnc_jmp_label(&mut self.enc, blabel);
            }
        }

        Inst::Switch(sv, sw_keys, sw_targets, sw_dflt) => {
            // ME28: a compare chain. pe_ir is given functions without
            // switches (IrFunction_without_switches: its liveness knows two
            // successors a block at most); this stays correct if one comes.
            var swoff: i64 = PeStackFrame_offset(frame, sv);
            if swoff >= PEIR_REG_SLOT && !peir_is_xmm_slot(swoff) {
                PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, peir_value_reg(swoff - PEIR_REG_SLOT));
            } else {
                PeirGen_load_operand(self, PEIR_RAX, sv, frame);
            }
            var swi: i64 = 0;
            while swi < sw_keys.len() && swi < sw_targets.len() {
                PeirEnc_mov_imm64(&mut self.enc, PEIR_RCX, sw_keys.get(swi));
                PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
                PeirEnc_jcc_label(&mut self.enc, 0x4, HashMap_get(self.block_labels, pe_block_key(func_name, sw_targets.get(swi))));
                swi = swi + 1;
            }
            var sw_dl: i64 = HashMap_get(self.block_labels, pe_block_key(func_name, sw_dflt));
            if sw_dl != self.next_block {
                PeirEnc_jmp_label(&mut self.enc, sw_dl);
            }
            self.pending_cmp_cc = -1;
            self.pending_cmp_vid = -1;
        }

        Inst::Branch(cond, then, else_) => {
            var then_label: i64 = HashMap_get(self.block_labels, pe_block_key(func_name, then));
            var else_label: i64 = HashMap_get(self.block_labels, pe_block_key(func_name, else_));
            var bcc: i64 = 0x5;
            // jne: the bool is not zero
            if self.pending_cmp_vid == cond && self.pending_cmp_cc >= 0 {
                // The compare just emitted left its flags live: jump on the
                // condition directly.
                bcc = self.pending_cmp_cc;
            } else {
                var coff: i64 = PeStackFrame_offset(frame, cond);
                if coff >= PEIR_REG_SLOT && !peir_is_xmm_slot(coff) {
                    var cr: i64 = peir_value_reg(coff - PEIR_REG_SLOT);
                    PeirEnc_test_rr(&mut self.enc, cr, cr);
                } else {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, coff);
                    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
            }
            self.pending_cmp_cc = -1;
            self.pending_cmp_vid = -1;
            // The block laid out next needs no jump; x86 condition codes come
            // in pairs that differ in the low bit
            if then_label == self.next_block {
                PeirEnc_jcc_label(&mut self.enc, bcc ^ 1, else_label);
            } else {
                PeirEnc_jcc_label(&mut self.enc, bcc, then_label);
                if else_label != self.next_block {
                    PeirEnc_jmp_label(&mut self.enc, else_label);
                }
            }
        }

        Inst::Return(ret) => {
            match ret {
                OptValueId::Some(v) => {
                    var voff: i64 = PeStackFrame_offset(frame, v);
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, voff);
                }
                OptValueId::None => {
                    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
                }
            }
            PeirGen_restore_regs(self);
            if self.wipe_frame {
                PeirGen_wipe_frame(self);
            }
            PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
            PeirEnc_pop(&mut self.enc, PEIR_RBP);
            if peir_is_interrupt(self, func) {
                // Interrupt handler epilogue: restore all GP registers
                PeirEnc_pop(&mut self.enc, PEIR_R15);
                PeirEnc_pop(&mut self.enc, PEIR_R14);
                PeirEnc_pop(&mut self.enc, PEIR_R13);
                PeirEnc_pop(&mut self.enc, PEIR_R12);
                PeirEnc_pop(&mut self.enc, PEIR_R11);
                PeirEnc_pop(&mut self.enc, PEIR_R10);
                PeirEnc_pop(&mut self.enc, PEIR_R9);
                PeirEnc_pop(&mut self.enc, PEIR_R8);
                PeirEnc_pop(&mut self.enc, PEIR_RDI);
                PeirEnc_pop(&mut self.enc, PEIR_RSI);
                PeirEnc_pop(&mut self.enc, PEIR_RDX);
                PeirEnc_pop(&mut self.enc, PEIR_RCX);
                PeirEnc_pop(&mut self.enc, PEIR_RBX);
                PeirEnc_pop(&mut self.enc, PEIR_RAX);
                // For exceptions with error codes, push dummy error code
                // so iretq sees the correct stack layout (it does not: the
                // prologue removed the error code, iretq would take the 0
                // for rip; the bootable bare image leaves it out)
                if pe_interrupt_has_err(func.interrupt_vector) && !(self.bare_mode && PEIR_BARE_BOOT) {
                    // push 0 (dummy error code)
                    peir_emit2(&mut self.enc, 0x6A, 0x00);
                }
                // iretq restores SS:RSP, RFLAGS, CS:RIP (64-bit)
                peir_emit2(&mut self.enc, 0x48, 0xCF);
                // iretq
            } else {
                PeirEnc_ret(&mut self.enc);
            }
        }

        Inst::Unreachable => {
            PeirEnc_ud2(&mut self.enc);
        }

        // --- Function Calls ---
        Inst::Call(call_name, args, _, _) => {
            if PeirGen_inline_vec_call(self, call_name, args, dst, frame, func) {
                return;
            }
            // An f64 lives in its slot as its bits: these copy the word (the
            // async task adapters of release H9 use them)
            if (call_name == "p_f64_to_bits" || call_name == "p_f64_from_bits") && args.len() == 1 {
                var boff: i64 = PeStackFrame_offset(frame, args.get(0));
                PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, boff);
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                return;
            }
            // print(tensor): the runtime formats it, then the string prints
            if call_name == "print" && args.len() > 0 {
                var arg0: i64 = args.get(0);
                var tensor_arg: bool = false;
                match IrFunction_get_meta(func, arg0) {
                    OptValueMeta::Some(m0) => {
                        tensor_arg = ir_type_is_opaque_named(m0.ty, "Tensor");
                    }
                    OptValueMeta::None => {
                    }
                }
                if tensor_arg {
                    var aoff0: i64 = PeStackFrame_offset(frame, arg0);
                    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, aoff0);
                    PeirGen_call_builtin(self, "p_tensor_to_str", 1);
                    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
                    PeirGen_call_runtime(self, "p_print_str");
                    PeirEnc_add_rsp_i32(&mut self.enc, 32);
                    PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                    return;
                }
            }

            var target_func: str = call_name;
            if call_name == "print" {
                target_func = "p_print_int";
                if args.len() > 0 {
                    match IrFunction_get_meta(func, args.get(0)) {
                        OptValueMeta::Some(am) => {
                            var aty: IrType = am.ty;
                            if pe_is_ptr(aty) {
                                target_func = "p_print_str";
                            } else if ir_type_is_float(aty) {
                                target_func = "p_print_float";
                            } else if ir_type_eq(aty, IrType::Bool) {
                                target_func = "p_print_bool";
                            } else if ir_type_is_opaque_named(aty, "Vec") {
                                target_func = "p_print_vec";
                            } else if ir_type_is_opaque_named(aty, "HashMap") {
                                target_func = "p_print_map";
                            } else {
                                target_func = "p_print_int";
                            }
                        }
                        OptValueMeta::None => {
                        }
                    }
                }
            } else if call_name == "p_to_str" {
                target_func = "p_to_str";
                if args.len() > 0 {
                    match IrFunction_get_meta(func, args.get(0)) {
                        OptValueMeta::Some(am2) => {
                            var aty2: IrType = am2.ty;
                            if ir_type_is_opaque_named(aty2, "Vec") {
                                target_func = "p_to_str_vec";
                            } else if ir_type_is_float(aty2) {
                                target_func = "p_to_str_float";
                            } else if pe_is_ptr(aty2) {
                                target_func = "p_to_str_str";
                            } else if ir_type_eq(aty2, IrType::Bool) {
                                target_func = "p_to_str_bool";
                            } else {
                                target_func = "p_to_str";
                            }
                        }
                        OptValueMeta::None => {
                        }
                    }
                }
            }
            target_func = PeirGen_resolve_call(self, target_func);

            // Inline tiny runtime calls (pe-roadmap item 86): when the
            // resolved callee is a machine stub and no Fides override
            // stands in for it, emit its body at the call site.
            if args.len() == 1 && !pe_ir_strs_contains(self.module_fns, target_func) {
                var iaoff: i64 = PeStackFrame_offset(frame, args.get(0));
                if target_func == "p_vec_len" || target_func == "p_map_len" {
                    // rax = [[slot] + 8]
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, iaoff);
                    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RAX, 8);
                    PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                    return;
                }
                if target_func == "p_map_is_empty" || target_func == "p_string_is_empty" {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, iaoff);
                    if target_func == "p_map_is_empty" {
                        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RAX, 8);
                    } else {
                        PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
                    }
                    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                    PeirEnc_setcc_r(&mut self.enc, 0x4, PEIR_RAX);
                    // sete
                    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
                    PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
                    return;
                }
            }

            // A Fides function standing in for a runtime builtin (called
            // without one) takes a null `__env` first
            var call_args: Vec<OptValueId> = Vec::new();
            if pe_ir_strs_contains(self.module_fns, target_func) && !pe_ir_strs_contains(self.module_fns, call_name) {
                call_args.push(OptValueId::None);
            }
            var ai: i64 = 0;
            while ai < args.len() {
                call_args.push(OptValueId::Some(args.get(ai)));
                ai = ai + 1;
            }

            var arg_regs: Vec<i64> = Vec::new();
            arg_regs.push(PEIR_RCX);
            arg_regs.push(PEIR_RDX);
            arg_regs.push(PEIR_R8);
            arg_regs.push(PEIR_R9);
            var stack_args: i64 = 0;
            if call_args.len() > 4 {
                stack_args = call_args.len() - 4;
            }
            var call_space: i64 = (32 + stack_args * 8 + 15) & ~15;

            // Load args into registers (item 83): a known-constant arg moves
            // in as an immediate instead of a slot load.
            var ri: i64 = 0;
            while ri < call_args.len() && ri < 4 {
                match call_args.get(ri) {
                    OptValueId::Some(a) => {
                        if pe_idmap_has(&frame.const_vals, a) {
                            PeirEnc_mov_imm(&mut self.enc, arg_regs.get(ri), pe_idmap_get(&frame.const_vals, a));
                        } else {
                            // OP21 (Nov 21 evening): an f32 argument into an
                            // integer-word parameter is the Vec<f32> element
                            // boundary — the single widened, its f64 bits in
                            // the register (REX.B for r8/r9)
                            var aty4: IrType = peir_operand_ty(func, a);
                            var ca_f32b: bool = ir_type_eq(aty4, IrType::F32);
                            if ca_f32b {
                                PeirEnc_movss_xmm_mem_rbp(&mut self.enc, 0, PeStackFrame_offset(frame, a));
                                peir_cvt_float(&mut self.enc, true);
                                peir_emit2(&mut self.enc, 0x66, 0x48 | ((arg_regs.get(ri) >> 3) & 1));
                                peir_emit2(&mut self.enc, 0x0F, 0x7E);
                                PeirEnc_emit_u8(&mut self.enc, 0xC0 | (arg_regs.get(ri) & 7));
                            } else {
                                PeirEnc_mov_reg_mem_rbp(&mut self.enc, arg_regs.get(ri), PeStackFrame_offset(frame, a));
                            }
                        }
                    }
                    OptValueId::None => {
                        PeirEnc_xor_rr(&mut self.enc, arg_regs.get(ri), arg_regs.get(ri));
                    }
                }
                ri = ri + 1;
            }

            // OP13: a sibling tail call. The arguments are in their
            // registers; the frame goes and the callee returns to our
            // caller, with its result in rax as ours would be. Only to a
            // Fides function (our convention, rax result) and with every
            // argument in a register (stack arguments would be in our frame).
            if self.tail_next && self.calls_reserved && call_args.len() <= 4 && pe_ir_strs_contains(self.module_fns, target_func) && HashMap_contains(self.func_labels, target_func) {
                PeirGen_restore_regs(self);
                PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
                PeirEnc_pop(&mut self.enc, PEIR_RBP);
                PeirEnc_jmp_label(&mut self.enc, HashMap_get(self.func_labels, target_func));
                self.tail_done = true;
                return;
            }

            if !self.calls_reserved {
                PeirEnc_sub_rsp_i32(&mut self.enc, call_space);
            }
            // Place stack args
            var sa: i64 = 4;
            while sa < call_args.len() {
                var stack_pos: i64 = 32 + (sa - 4) * 8;
                match call_args.get(sa) {
                    OptValueId::Some(a2) => {
                        if pe_idmap_has(&frame.const_vals, a2) {
                            PeirEnc_mov_imm(&mut self.enc, PEIR_RAX, pe_idmap_get(&frame.const_vals, a2));
                        } else {
                            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, PeStackFrame_offset(frame, a2));
                        }
                    }
                    OptValueId::None => {
                        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                    }
                }
                PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, stack_pos, PEIR_RAX);
                sa = sa + 1;
            }

            // Call the function. A function nobody defines would leave a
            // garbage result: trap, and (outside bare mode, where kernels
            // may rely on the trap) refuse the program in pe_ir_generate_pe.
            PeirGen_call_runtime(self, target_func);

            if !self.calls_reserved {
                PeirEnc_add_rsp_i32(&mut self.enc, call_space);
            }
            // OP21 (Nov 21 evening): a call whose result is an f32 (Vec_get
            // of a Vec<f32>) gets the single's f64 bits in rax — pun them
            // into the 4-byte slot (an f64 result is its bits already)
            var rty: IrType = peir_operand_ty(func, id);
            if ir_type_eq(rty, IrType::F32) {
                peir_emit2(&mut self.enc, 0x66, 0x48);
                peir_emit2(&mut self.enc, 0x0F, 0x6E);
                PeirEnc_emit_u8(&mut self.enc, 0xC0);
                peir_cvt_float(&mut self.enc, false);
                peir_store_f32_xmm0(&mut self.enc, dst);
            } else {
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            }
        }

        Inst::CallPtr(fn_ptr, args, cp_ret_ty, _, _) => {
            var fpoff: i64 = PeStackFrame_offset(frame, fn_ptr);
            // Load env struct pointer
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, fpoff);
            // Load fn addr from field 0
            PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
            // Roadmap L6C (@7737): word 0 == 0 is the C function pointer
            // marker (lower.fd: an address cast to a function type, or a
            // typed p_dl_find, is an env of ConstFnRef("__fid_c_fnptr"),
            // which resolves to 0 as no function has that name, and the
            // address in word 1). Such a call goes to c_fnptr_label below.
            var c_fnptr_label: i64 = PeirEnc_alloc_label(&mut self.enc);
            var c_fnptr_done: i64 = PeirEnc_alloc_label(&mut self.enc);
            PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
            PeirEnc_jcc_label(&mut self.enc, 0x4, c_fnptr_label);
            // je

            var total_args: i64 = args.len() + 1;
            var arg_regs: Vec<i64> = Vec::new();
            arg_regs.push(PEIR_RCX);
            arg_regs.push(PEIR_RDX);
            arg_regs.push(PEIR_R8);
            arg_regs.push(PEIR_R9);
            var stack_args: i64 = 0;
            if total_args > 4 {
                stack_args = total_args - 4;
            }
            var call_space: i64 = (32 + stack_args * 8 + 15) & ~15;

            PeirEnc_sub_rsp_i32(&mut self.enc, call_space);
            // First arg (rcx) = env_ptr
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, fpoff);

            var i: i64 = 0;
            while i < args.len() {
                var aoff: i64 = PeStackFrame_offset(frame, args.get(i));
                var arg_idx: i64 = i + 1;
                if arg_idx < 4 {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, arg_regs.get(arg_idx), aoff);
                } else {
                    var stack_pos: i64 = 32 + (arg_idx - 4) * 8;
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R10, aoff);
                    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, stack_pos, PEIR_R10);
                }
                i = i + 1;
            }

            // Save fn addr, call indirectly
            PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_RAX);
            PeirEnc_call_reg(&mut self.enc, PEIR_R10);
            PeirEnc_add_rsp_i32(&mut self.enc, call_space);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            PeirEnc_jmp_label(&mut self.enc, c_fnptr_done);

            // The C function pointer: call [env + 8] with the Win64 C
            // convention and no env. Argument i goes in position i (RCX,
            // RDX, R8, R9, then the stack at 32 + (i - 4) * 8); an f64/f32
            // one of the first four in XMM<i> instead (positional rule).
            // An f64/f32 result comes back in XMM0.
            PeirEnc_place_label(&mut self.enc, c_fnptr_label);
            var c_stack_args: i64 = 0;
            if args.len() > 4 {
                c_stack_args = args.len() - 4;
            }
            var c_space: i64 = (32 + c_stack_args * 8 + 15) & ~15;
            PeirEnc_sub_rsp_i32(&mut self.enc, c_space);
            var ci: i64 = 0;
            while ci < args.len() {
                var caoff: i64 = PeStackFrame_offset(frame, args.get(ci));
                var caty: IrType = peir_operand_ty(func, args.get(ci));
                var ca_f32: bool = ir_type_eq(caty, IrType::F32);
                var ca_f64: bool = ir_type_eq(caty, IrType::F64);
                if ci < 4 {
                    if ca_f64 {
                        PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, ci, caoff);
                    } else if ca_f32 {
                        PeirEnc_movss_xmm_mem_rbp(&mut self.enc, ci, caoff);
                    } else {
                        PeirEnc_mov_reg_mem_rbp(&mut self.enc, arg_regs.get(ci), caoff);
                    }
                } else {
                    // a float's bits go on the stack as they are
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R10, caoff);
                    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32 + (ci - 4) * 8, PEIR_R10);
                }
                ci = ci + 1;
            }
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R10, fpoff);
            PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R10, PEIR_R10, 8);
            PeirEnc_call_reg(&mut self.enc, PEIR_R10);
            PeirEnc_add_rsp_i32(&mut self.enc, c_space);
            if ir_type_eq(cp_ret_ty, IrType::F64) {
                PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, dst, 0);
            } else if ir_type_eq(cp_ret_ty, IrType::F32) {
                PeirEnc_movss_mem_rbp_xmm(&mut self.enc, dst, 0);
            } else {
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            }
            PeirEnc_place_label(&mut self.enc, c_fnptr_done);
        }

        // --- Conversions ---
        Inst::IntExtend(value, from, _) => {
            var voff: i64 = PeStackFrame_offset(frame, value);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, voff);
            match from {
                IrType::I8 => {
                    PeirEnc_movsx_r64_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
                IrType::I16 => {
                    PeirEnc_movsx_r64_r16(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
                IrType::I32 => {
                    PeirEnc_movsxd_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
                _ => {
                }
            }
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::IntTrunc(value, _, to) => {
            var voff: i64 = PeStackFrame_offset(frame, value);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, voff);
            match to {
                // M7: a signed narrow value is kept sign-extended over the
                // word (as loads and IntExtend do), an unsigned one
                // zero-extended
                IrType::I8 => {
                    PeirEnc_movsx_r64_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
                IrType::U8 => {
                    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
                IrType::I16 => {
                    PeirEnc_movsx_r64_r16(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
                IrType::U16 => {
                    PeirEnc_movzx_r32_r16(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
                IrType::I32 => {
                    PeirEnc_movsxd_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
                IrType::U32 => {
                    // mov eax, eax (zero-extends upper 32 bits)
                    PeirEnc_rex(&mut self.enc, false, false, false, false);
                    PeirEnc_emit_u8(&mut self.enc, 0x89);
                    PeirEnc_modrm_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                }
                _ => {
                }
            }
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::IntToFloat(value, _, to) => {
            var voff: i64 = PeStackFrame_offset(frame, value);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, voff);
            if ir_type_eq(to, IrType::F32) {
                // OP17: cvtsi2ss xmm0, rax (it stored the low half of an
                // f64's bits as the f32)
                peir_emit2(&mut self.enc, 0xF3, 0x48);
                peir_emit2(&mut self.enc, 0x0F, 0x2A);
                PeirEnc_emit_u8(&mut self.enc, 0xC0);
                peir_store_f32_xmm0(&mut self.enc, dst);
            } else {
                PeirEnc_cvtsi2sd_r64(&mut self.enc, 0, PEIR_RAX);
                PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, dst, 0);
            }
        }

        Inst::FloatToInt(value, from, _) => {
            var voff: i64 = PeStackFrame_offset(frame, value);
            if ir_type_eq(from, IrType::F32) {
                // OP17: the f32 widened first (cvttsd2si read its bits as
                // an f64's)
                PeirEnc_movss_xmm_mem_rbp(&mut self.enc, 0, voff);
                peir_cvt_float(&mut self.enc, true);
            } else {
                PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, voff);
            }
            PeirEnc_cvttsd2si_r64(&mut self.enc, PEIR_RAX, 0);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::MakeDyn(value, type_name, _) => {
            // A dyn value: 16 bytes {type id, receiver}.
            var tid: i64 = PeirGen_dyn_type_id(self, type_name);
            var voff: i64 = PeStackFrame_offset(frame, value);
            PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 16);
            PeirEnc_sub_rsp_i32(&mut self.enc, 32);
            PeirGen_call_runtime(self, "p_malloc");
            PeirEnc_add_rsp_i32(&mut self.enc, 32);
            PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, tid);
            PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 0, PEIR_R10);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R10, voff);
            PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 8, PEIR_R10);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::DynCall(_, method, args, _, _) => {
            // Candidates: every type made into a dyn value or named by a
            // trait impl that has `Type_method`.
            var types: Vec<str> = Vec::new();
            var ti: i64 = 0;
            while ti < module.trait_impls.len() {
                var items: Vec<str> = module.trait_impls.get(ti).items;
                var ii: i64 = 0;
                while ii < items.len() {
                    types = pe_ir_strs_insert_sorted(types, items.get(ii));
                    ii = ii + 1;
                }
                ti = ti + 1;
            }
            var fi2: i64 = 0;
            while fi2 < module.functions.len() {
                var f2: IrFunction = module.functions.get(fi2).func;
                var ii2: i64 = 0;
                while ii2 < f2.insts.len() {
                    match f2.insts.get(ii2).inst {
                        Inst::MakeDyn(_, type_name, _) => {
                            types = pe_ir_strs_insert_sorted(types, type_name);
                        }
                        _ => {
                        }
                    }
                    ii2 = ii2 + 1;
                }
                fi2 = fi2 + 1;
            }
            var candidates: Vec<PeDynCandidate> = Vec::new();
            var tj: i64 = 0;
            while tj < types.len() {
                var tname: str = types.get(tj);
                var mname: str = tname + "_" + method;
                if HashMap_contains(self.func_labels, mname) {
                    var flabel: i64 = HashMap_get(self.func_labels, mname);
                    var tid: i64 = PeirGen_dyn_type_id(self, tname);
                    candidates.push(PeDynCandidate {
                        tid: tid, label: flabel
                    });
                }
                tj = tj + 1;
            }
            // Arguments: env (0), receiver, then args[1..].
            var total_args: i64 = args.len() + 1;
            var stack_args: i64 = 0;
            if total_args > 4 {
                stack_args = total_args - 4;
            }
            var call_space: i64 = (32 + stack_args * 8 + 15) & ~15;
            var arg_regs: Vec<i64> = Vec::new();
            arg_regs.push(PEIR_RCX);
            arg_regs.push(PEIR_RDX);
            arg_regs.push(PEIR_R8);
            arg_regs.push(PEIR_R9);
            PeirEnc_sub_rsp_i32(&mut self.enc, call_space);
            var i: i64 = 1;
            while i < args.len() {
                var arg_idx: i64 = i + 1;
                if arg_idx >= 4 {
                    var aoff: i64 = PeStackFrame_offset(frame, args.get(i));
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, aoff);
                    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32 + (arg_idx - 4) * 8, PEIR_RAX);
                }
                i = i + 1;
            }
            i = 1;
            while i < args.len() {
                var arg_idx2: i64 = i + 1;
                if arg_idx2 < 4 {
                    var aoff2: i64 = PeStackFrame_offset(frame, args.get(i));
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, arg_regs.get(arg_idx2), aoff2);
                }
                i = i + 1;
            }
            if args.len() > 0 {
                var ooff: i64 = PeStackFrame_offset(frame, args.get(0));
                PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R10, ooff);
                PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R11, PEIR_R10, 0);
                // type id
                PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_R10, 8);
                // receiver
            }
            PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
            var done: i64 = PeirEnc_alloc_label(&mut self.enc);
            var ci: i64 = 0;
            while ci < candidates.len() {
                var cand: PeDynCandidate = candidates.get(ci);
                var next: i64 = PeirEnc_alloc_label(&mut self.enc);
                PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, cand.tid);
                PeirEnc_cmp_rr(&mut self.enc, PEIR_R11, PEIR_R10);
                PeirEnc_jcc_label(&mut self.enc, 0x5, next);
                // jne
                PeirEnc_call_label(&mut self.enc, cand.label);
                PeirEnc_jmp_label(&mut self.enc, done);
                PeirEnc_place_label(&mut self.enc, next);
                ci = ci + 1;
            }
            PeirEnc_ud2(&mut self.enc);
            // no implementation for this type
            PeirEnc_place_label(&mut self.enc, done);
            PeirEnc_add_rsp_i32(&mut self.enc, call_space);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::BitCast(value, bc_from, bc_to) => {
            var voff: i64 = PeStackFrame_offset(frame, value);
            if ir_type_eq(bc_from, IrType::F32) && ir_type_eq(bc_to, IrType::F64) {
                // OP17 / known-bugs 2g.13: `x as f64` of an f32 converts
                // (as run, the C path and nat_ir do; it kept the bits)
                PeirEnc_movss_xmm_mem_rbp(&mut self.enc, 0, voff);
                peir_cvt_float(&mut self.enc, true);
                PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, dst, 0);
            } else if ir_type_eq(bc_from, IrType::F64) && ir_type_eq(bc_to, IrType::F32) {
                PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, voff);
                peir_cvt_float(&mut self.enc, false);
                peir_store_f32_xmm0(&mut self.enc, dst);
            } else if ir_type_is_int(bc_from) && ir_type_eq(bc_to, IrType::F32) {
                // OP21 (Nov 21 evening): an integer word cast to f32 is the
                // Vec<f32> element boundary — the word holds the single's
                // f64 bits, so they are punned to a double and narrowed
                peir_pun_i64_f32(&mut self.enc, voff, dst);
            } else if ir_type_eq(bc_from, IrType::F32) && ir_type_is_int(bc_to) {
                // OP21: the boundary's other side — the single widened and
                // its f64 bits stored
                peir_pun_f32_i64(&mut self.enc, voff, dst);
            } else {
                PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, voff);
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            }
        }

        // --- Fides-Specific ---
        Inst::Print(value, ty) => {
            var voff: i64 = PeStackFrame_offset(frame, value);
            PeirEnc_sub_rsp_i32(&mut self.enc, 32);
            var formatter: str = pe_ir_print_formatter(ty);
            if formatter != "" {
                // Collections print through their Fides formatter (as in
                // the C backend): formatter(env = 0, value) -> str.
                PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
                PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, voff);
                PeirGen_call_runtime(self, formatter);
                PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
                PeirGen_call_runtime(self, "p_print_str");
            } else {
                // OP21 (Nov 21 evening): an f32's slot holds the 4-byte
                // single; p_print_float takes the f64 bits in rcx — widen
                // first (peir_pun_f32_i64), the same boundary as the Vec
                // element path
                var pr_f32: bool = false;
                match ty {
                    IrType::F32 => {
                        pr_f32 = true;
                    }
                    _ => {
                    }
                }
                if pr_f32 {
                    // movss xmm0, [rbp+off]; cvtss2sd; movq rcx, xmm0
                    PeirEnc_movss_xmm_mem_rbp(&mut self.enc, 0, voff);
                    peir_cvt_float(&mut self.enc, true);
                    peir_emit2(&mut self.enc, 0x66, 0x48);
                    peir_emit2(&mut self.enc, 0x0F, 0xD6);
                    PeirEnc_emit_u8(&mut self.enc, 0xC1);
                } else {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, voff);
                }
                // Route to the correct print function based on type
                var print_fn: str = "p_print_int";
                match ty {
                    IrType::Ptr(_) => {
                        print_fn = "p_print_str";
                    }
                    IrType::Opaque(n) => {
                        if n == "String" {
                            print_fn = "p_print_str";
                        }
                    }
                    IrType::F64 => {
                        print_fn = "p_print_float";
                    }
                    IrType::F32 => {
                        print_fn = "p_print_float";
                    }
                    IrType::Bool => {
                        print_fn = "p_print_bool";
                    }
                    _ => {
                        print_fn = "p_print_int";
                    }
                }
                PeirGen_call_builtin(self, print_fn, 1);
            }
            PeirEnc_add_rsp_i32(&mut self.enc, 32);
        }

        Inst::PersistLoad(_, default, _) => {
            // Persistent load — just copy default value to destination
            var doff: i64 = PeStackFrame_offset(frame, default);
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, doff);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }

        Inst::PersistSave(_, _) => {  // No-op in PE emitter
        }

        Inst::TxnBegin => {  // No-op in PE emitter (rollback/unsafe not supported)
        }
        Inst::TxnEnd => {  // No-op in PE emitter (rollback/unsafe not supported)
        }
        Inst::UnsafeBegin => {  // No-op in PE emitter (rollback/unsafe not supported)
        }
        Inst::UnsafeEnd => {  // No-op in PE emitter (rollback/unsafe not supported)
        }

        Inst::GradBegin(_) => {
            PeirGen_gen_autograd(self, inst, 0);
        }
        Inst::GradEnd => {
            PeirGen_gen_autograd(self, inst, 0);
        }
        Inst::Backward(_) => {
            PeirGen_gen_autograd(self, inst, 1);
        }

        Inst::Panic(message) => {
            var off: i64 = PeirGen_str_off(self, message);
            PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, off);
            PeirEnc_sub_rsp_i32(&mut self.enc, 32);
            if HashMap_contains(self.func_labels, "p_panic") {
                var plabel: i64 = HashMap_get(self.func_labels, "p_panic");
                PeirEnc_call_label(&mut self.enc, plabel);
            }
            PeirEnc_add_rsp_i32(&mut self.enc, 32);
        }

        Inst::TryUnwrap(_, _, _, _) => {
            // Not fully implemented
            PeirEnc_nop(&mut self.enc);
        }

        Inst::Asm(template, inputs, outputs, asm_ty) => {
            if self.bare_mode {
                // Bare builds run the template (release G2): inputs into
                // their registers, the instructions, the first output out
                var enc_res: PeAsmResult = pe_asm_encode(template);
                if enc_res.error != "" {
                    g_pe_asm_errors.push("asm!(\"" + template + "\") in " + func_name + ": " + enc_res.error);
                }
                var ii2: i64 = 0;
                while ii2 < inputs.len() {
                    var inr: i64 = pe_asm_reg64(inputs.get(ii2).name);
                    if inputs.get(ii2).id < 0 {
                    // a clobber("reg"): nothing to load (2g.53)
                    } else if inr < 0 {
                        g_pe_asm_errors.push("asm! in " + func_name + ": in(\"" + inputs.get(ii2).name + "\") is not a 64-bit register\n    Fix: name a 64-bit general register: rax, rbx, rcx, rdx, rsi, rdi, rbp or r8 to r15");
                    } else {
                        PeirGen_load_operand(self, inr, inputs.get(ii2).id, frame);
                    }
                    ii2 = ii2 + 1;
                }
                var bi2: i64 = 0;
                while bi2 < enc_res.bytes.len() {
                    PeirEnc_emit_u8(&mut self.enc, enc_res.bytes.get(bi2));
                    bi2 = bi2 + 1;
                }
                var outr: i64 = PEIR_RAX;
                if outputs.len() > 0 {
                    outr = pe_asm_reg64(outputs.get(0).name);
                    if outr < 0 {
                        g_pe_asm_errors.push("asm! in " + func_name + ": out(\"" + outputs.get(0).name + "\") is not a 64-bit register\n    Fix: name a 64-bit general register: rax, rbx, rcx, rdx, rsi, rdi, rbp or r8 to r15");
                        outr = PEIR_RAX;
                    }
                } else {
                    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
                }
                match asm_ty {
                    IrType::Void => {
                    }
                    _ => {
                        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, outr);
                    }
                }
            } else if self.has_asm && peir_asm_runs(template) {
                // LG13: a Windows process runs the template too
                PeirGen_gen_asm_process(self, template, inputs, outputs, asm_ty, dst, frame);
            } else {
                // A template a process may not run (a privileged
                // instruction, LG13) or one the encoder does not know
                // gives 0, as before (and as the interpreter does)
                PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
                PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            }
        }

        Inst::RegionBegin(_, _, _, _) => {
            // Region begin — no-op in PE backend (stack-based allocation)
            PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
        }

        Inst::RegionEnd(_, _, _) => {  // Region end — no-op in PE backend
        }
    }
}

// ===========================================================================
// PeirGen::gen_int_binop / gen_float_binop (src/pe.rs)
// ===========================================================================

/// Slot-reuse rule: a value is a recyclable temporary iff it is defined by
/// an instruction inside one block and every use sits in that same block.
/// Params and cross-block/loop-carried values keep permanent slots.
pub fn peir_recyclable(v: i64, def_block: Vec<i64>, n_use_blocks: Vec<i64>, a_use_block: Vec<i64>, nvals: i64) -> bool {
    if v < 0 || v >= nvals {
        return false;
    }
    var db: i64 = def_block.get(v);
    if db < 0 {
        return false;
    }
    var nub: i64 = n_use_blocks.get(v);
    if nub == 0 {
        return true;
    }
    if nub == 1 {
        return a_use_block.get(v) == db;
    }
    return false;
}

/// The jcc code jumping when an integer comparison `a OP b` holds (the
/// setcc-style numbering gen_int_binop uses: 4=E, 5=NE, C=L, D=GE, E=LE,
/// The IR type of value `id` of `func`: its instruction's, or a
/// parameter's declared type; i64 when neither is recorded.
pub fn peir_operand_ty(func: &IrFunction, id: i64) -> IrType {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => {
            return m.ty;
        }
        OptValueMeta::None => {
        }
    }
    var i: i64 = 0;
    while i < func.params.len() {
        if func.params.get(i).id == id {
            return func.params.get(i).ty;
        }
        i = i + 1;
    }
    return IrType::I64;
}

/// D13: an integer BinOp whose constant left operand gen_inst moves to the
/// right (a comparison, mirrored; add, mul, and, or, xor). Off: as before.
const PEIR_CONST_LEFT_SWAP: bool = true;

/// D13: whether `l op r` can be computed as `r op' l` (op' =
/// peir_mirror_op(op)): the comparisons and the commutative operations.
fn peir_op_commutes(op: BinOp) -> bool {
    match op {
        BinOp::Eq => {
            return true;
        }
        BinOp::Neq => {
            return true;
        }
        BinOp::Lt => {
            return true;
        }
        BinOp::Gt => {
            return true;
        }
        BinOp::LtEq => {
            return true;
        }
        BinOp::GtEq => {
            return true;
        }
        BinOp::Add => {
            return true;
        }
        BinOp::Mul => {
            return true;
        }
        BinOp::BitAnd => {
            return true;
        }
        BinOp::BitOr => {
            return true;
        }
        BinOp::BitXor => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// D13: the operation that gives the same result with the operands
/// exchanged: `<` and `>`, `<=` and `>=`; any other one itself.
fn peir_mirror_op(op: BinOp) -> BinOp {
    match op {
        BinOp::Lt => {
            return BinOp::Gt;
        }
        BinOp::Gt => {
            return BinOp::Lt;
        }
        BinOp::LtEq => {
            return BinOp::GtEq;
        }
        BinOp::GtEq => {
            return BinOp::LtEq;
        }
        _ => {
            return op;
        }
    }
}

/// F=G; unsigned 2=B, 3=AE, 6=BE, 7=A), or -1 for a non-comparison.
pub fn peir_int_cmp_cc(op: BinOp, unsigned: bool) -> i64 {
    match op {
        BinOp::Eq => {
            return 0x4;
        }
        BinOp::Neq => {
            return 0x5;
        }
        BinOp::Lt => {
            if unsigned {
                return 0x2;
            }
            return 0xC;
        }
        BinOp::GtEq => {
            if unsigned {
                return 0x3;
            }
            return 0xD;
        }
        BinOp::LtEq => {
            if unsigned {
                return 0x6;
            }
            return 0xE;
        }
        BinOp::Gt => {
            if unsigned {
                return 0x7;
            }
            return 0xF;
        }
        _ => {
            return -1;
        }
    }
}

// The arithmetic panics, one shared stub each (indices into arith_panics)
const PEIR_PANIC_ADD: i64 = 0;
const PEIR_PANIC_SUB: i64 = 1;
const PEIR_PANIC_MUL: i64 = 2;
const PEIR_PANIC_DIV_OVF: i64 = 3;
const PEIR_PANIC_DIV_ZERO: i64 = 4;
const PEIR_PANIC_MOD_ZERO: i64 = 5;
const PEIR_PANIC_VEC_INDEX: i64 = 6;  // PEIR_PANIC_DOUBLE_FREE (7) and PEIR_PANIC_BAD_FREE (8) are in pe_ir_stubs.fd, whose p_free stub uses them
fn peir_arith_panic_strings() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("Integer overflow on addition");
    v.push("Integer overflow on subtraction");
    v.push("Integer overflow on multiplication");
    v.push("Integer overflow on division");
    v.push("Division by zero");
    v.push("Modulo by zero");
    v.push("Vec index out of bounds");
    v.push("Double free");
    v.push("Invalid free: not an allocated block");
    return v;
}

/// Every message a runtime stub panics with.
fn peir_panic_strings() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("Stack overflow");
    v.push("Invalid memory access (null or dangling pointer)");
    v.push("Illegal instruction");
    var a: Vec<str> = peir_arith_panic_strings();
    var i: i64 = 0;
    while i < a.len() {
        v.push(a.get(i));
        i = i + 1;
    }
    return v;
}

fn PeirGen_jump_panic(self: &mut PeirGen, cc: i64, which: i64) -> void {
    PeirEnc_jcc_label(&mut self.enc, cc, self.arith_panics.get(which));
}

/// Integer arithmetic in type `ty`: the one meaning the interpreter and the
/// C backend implement. A checked operation costs one jcc to a shared panic
/// stub. Bare-metal code checks too (release G3): its panics go to the
/// program's @panic_handler, else to COM1 and a halt (gen_bare_runtime).
pub fn PeirGen_gen_int_binop(self: &mut PeirGen, op: BinOp, loff: i64, roff: i64, dst: i64, lconst: OptU64, rconst: OptU64, ty: IrType, unsigned_cmp: bool) -> void {
    if PeirGen_int_binop_in_reg(self, op, loff, roff, dst, lconst, rconst, ty) {
        return;
    }
    // OP20: under --cpu x86-64-v3|v4 a 64-bit shift by a variable count is
    // SHLX/SARX/SHRX, its operands read from their registers (no CL)
    if PeirGen_shift_bmi(self, op, loff, roff, dst, lconst, rconst, ty) {
        return;
    }
    // An i64 `x / c` or `x % c` by a constant c >= 2: x straight into rcx,
    // the result stored from where it ends up (no moves through rax)
    var dmc: i64 = 0;
    match rconst {
        OptU64::Some(dv) => {
            dmc = dv;
        }
        OptU64::None => {
        }
    }
    var dm_mod: i64 = -1;
    match op {
        BinOp::Div => {
            dm_mod = 0;
        }
        BinOp::Mod => {
            dm_mod = 1;
        }
        _ => {
        }
    }
    if dm_mod >= 0 && dmc >= 2 && ir_type_eq(ty, IrType::I64) {
        match lconst {
            OptU64::Some(lv) => {
                PeirEnc_mov_imm(&mut self.enc, PEIR_RCX, lv);
            }
            OptU64::None => {
                PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, loff);
            }
        }
        // (D13: none when rcx was just copied from rax)
        PeirEnc_mov_rr_cp(&mut self.enc, PEIR_RAX, PEIR_RCX);
        // (gen_inst passes `unsigned_cmp` = the dividend is >= 0 for these)
        PeirGen_gen_div_const_n(self, dm_mod == 1, dmc, unsigned_cmp);
        if dm_mod == 1 {
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RCX);
        } else {
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        }
        return;
    }
    // A comparison of a value in a register: `cmp r, imm` or `cmp r, r2`
    // (competitive OP18), no copy to rax
    var lcmp: bool = false;
    match lconst {
        OptU64::None => {
            lcmp = loff >= PEIR_REG_SLOT && !peir_is_xmm_slot(loff) && peir_int_cmp_cc(op, unsigned_cmp) >= 0;
        }
        OptU64::Some(_) => {
        }
    }
    if lcmp {
        var rl: i64 = peir_value_reg(loff - PEIR_REG_SLOT);
        match rconst {
            OptU64::Some(cv) => {
                if cv > -2147483648 && cv <= 2147483647 {
                    PeirEnc_cmp_r_imm(&mut self.enc, rl, cv);
                } else {
                    PeirEnc_mov_imm(&mut self.enc, PEIR_RCX, cv);
                    PeirEnc_cmp_rr(&mut self.enc, rl, PEIR_RCX);
                }
            }
            OptU64::None => {
                if roff >= PEIR_REG_SLOT && !peir_is_xmm_slot(roff) {
                    PeirEnc_cmp_rr(&mut self.enc, rl, peir_value_reg(roff - PEIR_REG_SLOT));
                } else {
                    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, roff);
                    PeirEnc_cmp_rr(&mut self.enc, rl, PEIR_RCX);
                }
            }
        }
        if self.flags_only {
            return;
        }
        PeirEnc_setcc_r(&mut self.enc, peir_int_cmp_cc(op, unsigned_cmp), PEIR_RAX);
        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        return;
    }
    // D13: the left operand in a stack slot, the right one in a register or
    // a 32-bit immediate: `cmp [rbp+l], r` / `cmp qword [rbp+l], imm` (the
    // same left - right, so the same condition), no load into rax first. A
    // slot written from a register by the instruction just before: that
    // register (what mov_reg_mem_rbp would forward).
    var mcmp: bool = false;
    match lconst {
        OptU64::None => {
            mcmp = loff < PEIR_REG_SLOT && peir_int_cmp_cc(op, unsigned_cmp) >= 0;
        }
        OptU64::Some(_) => {
        }
    }
    if mcmp {
        var fwd: i64 = -1;
        if self.enc.last_store_end == self.enc.code.len() && loff == self.enc.last_store_disp {
            fwd = self.enc.last_store_reg;
        }
        var mdone: bool = false;
        match rconst {
            OptU64::Some(mv) => {
                if mv > -2147483648 && mv <= 2147483647 {
                    if fwd >= 0 {
                        PeirEnc_cmp_r_imm(&mut self.enc, fwd, mv);
                    } else if mv >= -128 && mv <= 127 {
                        PeirEnc_rex(&mut self.enc, true, false, false, false);
                        PeirEnc_emit_u8(&mut self.enc, 0x83);
                        PeirEnc_emit_mem_rbp(&mut self.enc, 7, loff);
                        PeirEnc_emit_u8(&mut self.enc, mv & 0xFF);
                    } else {
                        PeirEnc_rex(&mut self.enc, true, false, false, false);
                        PeirEnc_emit_u8(&mut self.enc, 0x81);
                        PeirEnc_emit_mem_rbp(&mut self.enc, 7, loff);
                        PeirEnc_emit_i32(&mut self.enc, mv);
                    }
                    mdone = true;
                }
            }
            OptU64::None => {
                if roff >= PEIR_REG_SLOT && !peir_is_xmm_slot(roff) {
                    var mr: i64 = peir_value_reg(roff - PEIR_REG_SLOT);
                    if fwd >= 0 {
                        PeirEnc_cmp_rr(&mut self.enc, fwd, mr);
                    } else {
                        PeirEnc_rex(&mut self.enc, true, reg_ext(mr), false, false);
                        PeirEnc_emit_u8(&mut self.enc, 0x39);
                        PeirEnc_emit_mem_rbp(&mut self.enc, peir_reg_code(mr), loff);
                    }
                    mdone = true;
                }
            }
        }
        if mdone {
            if self.flags_only {
                return;
            }
            PeirEnc_setcc_r(&mut self.enc, peir_int_cmp_cc(op, unsigned_cmp), PEIR_RAX);
            PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
            return;
        }
    }
    // A constant operand moves in as an immediate, not a slot load (item 81).
    match lconst {
        OptU64::Some(v) => {
            PeirEnc_mov_imm(&mut self.enc, PEIR_RAX, v);
        }
        OptU64::None => {
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, loff);
        }
    }
    var is_i64: bool = ir_type_eq(ty, IrType::I64);
    var is_u64: bool = ir_type_eq(ty, IrType::U64);
    var unsigned_ty: bool = is_u64 || ir_type_eq(ty, IrType::U8) || ir_type_eq(ty, IrType::U16) || ir_type_eq(ty, IrType::U32);
    // A small constant is an immediate; `sub` is an `add` of its negation
    var small: bool = false;
    var big_enough: bool = false;
    var rval: i64 = 0;
    match rconst {
        OptU64::Some(v) => {
            rval = v;
            small = v > -2147483648 && v <= 2147483647;
            big_enough = v >= 2;
        }
        OptU64::None => {
        }
    }
    var use_imm: bool = false;
    var by_const: bool = false;
    match op {
        BinOp::Add => {
            use_imm = small && !is_u64;
        }
        BinOp::Sub => {
            use_imm = small && !is_u64;
        }
        BinOp::Mul => {
            use_imm = small && !is_u64;
        }
        BinOp::Eq => {
            use_imm = small;
        }
        BinOp::Neq => {
            use_imm = small;
        }
        BinOp::Lt => {
            use_imm = small;
        }
        BinOp::Gt => {
            use_imm = small;
        }
        BinOp::LtEq => {
            use_imm = small;
        }
        BinOp::GtEq => {
            use_imm = small;
        }
        BinOp::Div => {
            by_const = big_enough && !unsigned_ty;
        }
        BinOp::Mod => {
            by_const = big_enough && !unsigned_ty;
        }
        _ => {
        }
    }
    match rconst {
        OptU64::Some(v) => {
            if !use_imm && !by_const {
                PeirEnc_mov_imm(&mut self.enc, PEIR_RCX, v);
            }
        }
        OptU64::None => {
            PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, roff);
        }
    }

    var checked: bool = !self.cur_wrapping && !self.cur_unchecked;
    // jo for i64, jc for u64; narrow types are checked after the operation
    var ovf_cc: i64 = -1;
    if checked && is_i64 {
        ovf_cc = 0x0;
    }
    if checked && is_u64 {
        ovf_cc = 0x2;
    }
    var narrow_panic: i64 = -1;

    match op {
        BinOp::Add => {
            if use_imm {
                PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, rval);
            } else {
                PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
            }
            if ovf_cc >= 0 {
                PeirGen_jump_panic(self, ovf_cc, PEIR_PANIC_ADD);
            }
            narrow_panic = PEIR_PANIC_ADD;
        }
        BinOp::Sub => {
            if use_imm {
                PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 0 - rval);
            } else {
                PeirEnc_sub_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
            }
            if ovf_cc >= 0 {
                PeirGen_jump_panic(self, ovf_cc, PEIR_PANIC_SUB);
            }
            narrow_panic = PEIR_PANIC_SUB;
        }
        BinOp::Mul => {
            if checked && is_u64 {
                PeirEnc_mul_r(&mut self.enc, PEIR_RCX);
                PeirGen_jump_panic(self, 0x0, PEIR_PANIC_MUL);
            } else {
                if use_imm {
                    PeirEnc_imul_r_i32(&mut self.enc, PEIR_RAX, rval);
                } else {
                    PeirEnc_imul_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
                }
                if checked && is_i64 {
                    PeirGen_jump_panic(self, 0x0, PEIR_PANIC_MUL);
                }
            }
            narrow_panic = PEIR_PANIC_MUL;
        }
        BinOp::Div => {
            PeirGen_gen_int_div(self, false, rconst, ty, checked);
            narrow_panic = PEIR_PANIC_DIV_OVF;
        }
        BinOp::Mod => {
            PeirGen_gen_int_div(self, true, rconst, ty, checked);
        }
        BinOp::BitAnd => {
            PeirEnc_and_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        }
        BinOp::BitOr => {
            PeirEnc_or_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        }
        BinOp::BitXor => {
            PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        }
        BinOp::Shl => {
            PeirEnc_shl_cl(&mut self.enc, PEIR_RAX);
            PeirGen_gen_narrow(self, ty, -1);
        }
        BinOp::Shr => {
            if is_u64 {
                PeirEnc_shr_cl(&mut self.enc, PEIR_RAX);
            } else {
                PeirEnc_sar_cl(&mut self.enc, PEIR_RAX);
            }
        }
        BinOp::And => {
            PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
            PeirEnc_setcc_r(&mut self.enc, 0x5, PEIR_RAX);
            // setne
            PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
            PeirEnc_setcc_r(&mut self.enc, 0x5, PEIR_RCX);
            // setne
            PeirEnc_and_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
            PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        }
        BinOp::Or => {
            PeirEnc_or_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
            PeirEnc_setcc_r(&mut self.enc, 0x5, PEIR_RAX);
            // setne
            PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        }
        _ => {
            // Eq, Neq, Lt, Gt, LtEq, GtEq
            if use_imm {
                peir_emit2(&mut self.enc, 0x48, 0x3D);
                // cmp rax, imm32
                PeirEnc_emit_i32(&mut self.enc, rval);
            } else {
                PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
            }
            if self.flags_only {
                return;
            }
            PeirEnc_setcc_r(&mut self.enc, peir_int_cmp_cc(op, unsigned_cmp), PEIR_RAX);
            PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        }
    }

    // A narrow result is normalized (its slot always holds the value in 64
    // bits); in checked code a value that changes did not fit.
    if narrow_panic >= 0 {
        if checked {
            PeirGen_gen_narrow(self, ty, narrow_panic);
        } else {
            PeirGen_gen_narrow(self, ty, -1);
        }
    }

    PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
}

/// OP20 (BMI2, --cpu x86-64-v3|v4): an i64/u64 `l << r` or `l >> r` by a
/// variable count as `shlx|sarx|shrx d, l, r`: the count masked to 6 bits
/// as `shl r, cl` masks it, so the result is the same. False when it does
/// not apply (no BMI, a constant count, another type or operation).
fn PeirGen_shift_bmi(self: &mut PeirGen, op: BinOp, loff: i64, roff: i64, dst: i64, lconst: OptU64, rconst: OptU64, ty: IrType) -> bool {
    if !peir_bmi() {
        return false;
    }
    var is_u64: bool = ir_type_eq(ty, IrType::U64);
    if !is_u64 && !ir_type_eq(ty, IrType::I64) {
        return false;
    }
    var pp: i64 = 0;
    match op {
        BinOp::Shl => {
            pp = 1;
        }
        BinOp::Shr => {
            if is_u64 {
                pp = 3;
            } else {
                pp = 2;
            }
        }
        _ => {
        }
    }
    if pp == 0 {
        return false;
    }
    match rconst {
        OptU64::Some(_) => {
            return false;
        }
        OptU64::None => {
        }
    }
    if peir_is_xmm_slot(roff) || peir_is_xmm_slot(dst) {
        return false;
    }
    var a: i64 = PEIR_RAX;
    match lconst {
        OptU64::Some(lv) => {
            PeirEnc_mov_imm(&mut self.enc, PEIR_RAX, lv);
        }
        OptU64::None => {
            if loff >= PEIR_REG_SLOT && !peir_is_xmm_slot(loff) {
                a = peir_value_reg(loff - PEIR_REG_SLOT);
            } else {
                PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, loff);
            }
        }
    }
    var b: i64 = PEIR_RCX;
    if roff >= PEIR_REG_SLOT {
        b = peir_value_reg(roff - PEIR_REG_SLOT);
    } else {
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, roff);
    }
    if dst >= PEIR_REG_SLOT {
        PeirEnc_shiftx(&mut self.enc, pp, peir_value_reg(dst - PEIR_REG_SLOT), a, b);
    } else {
        PeirEnc_shiftx(&mut self.enc, pp, PEIR_RAX, a, b);
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
    }
    return true;
}

/// OP20 (BMI1, --cpu x86-64-v3|v4): the value `x & y` computes is
/// `x & (x - 1)` when `y` is `x - 1` (a Sub of the constant 1, or an Add
/// of -1) of a 64-bit type: then x, else -1. x is an operand of the And,
/// so it is live there; the Sub is still generated (its overflow check
/// with it), BLSR computes the And from x alone.
fn peir_blsr_src(func: &IrFunction, frame: &PeStackFrame, x: i64, y: i64) -> i64 {
    // (a constant has no slot to read: it is an immediate where used)
    if pe_idmap_has(&frame.const_vals, x) {
        return -1;
    }
    match IrFunction_get_inst(func, y) {
        OptInst::Some(inst) => {
            match inst {
                Inst::BinOp(op2, a2, b2, _) => {
                    if a2 != x || !pe_idmap_has(&frame.const_vals, b2) {
                        return -1;
                    }
                    var c: i64 = pe_idmap_get(&frame.const_vals, b2);
                    match op2 {
                        BinOp::Sub => {
                            if c == 1 {
                                return x;
                            }
                        }
                        BinOp::Add => {
                            if c == -1 {
                                return x;
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return -1;
}

/// OP20: `blsr d, x` for an And peir_blsr_src matched (x's slot `xoff`).
fn PeirGen_gen_blsr(self: &mut PeirGen, xoff: i64, dst: i64) -> void {
    var a: i64 = PEIR_RAX;
    if xoff >= PEIR_REG_SLOT && !peir_is_xmm_slot(xoff) {
        a = peir_value_reg(xoff - PEIR_REG_SLOT);
    } else {
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, xoff);
    }
    if dst >= PEIR_REG_SLOT && !peir_is_xmm_slot(dst) {
        PeirEnc_blsr(&mut self.enc, peir_value_reg(dst - PEIR_REG_SLOT), a);
    } else {
        PeirEnc_blsr(&mut self.enc, PEIR_RAX, a);
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
    }
}

/// An i64 add, sub, mul, and, or or xor whose result is in a register:
/// computed there (`mov rd, l; op rd, r`), not through rax and rcx (D13).
/// False when it does not apply.
fn PeirGen_int_binop_in_reg(self: &mut PeirGen, op: BinOp, loff: i64, roff: i64, dst: i64, lconst: OptU64, rconst: OptU64, ty: IrType) -> bool {
    if dst < PEIR_REG_SLOT || !ir_type_eq(ty, IrType::I64) {
        return false;
    }
    match lconst {
        OptU64::Some(_) => {
            return false;
        }
        OptU64::None => {
        }
    }
    var kind: i64 = -1;
    match op {
        BinOp::Add => {
            kind = 0;
        }
        BinOp::Sub => {
            kind = 1;
        }
        BinOp::Mul => {
            kind = 2;
        }
        BinOp::BitAnd => {
            kind = 3;
        }
        BinOp::BitOr => {
            kind = 4;
        }
        BinOp::BitXor => {
            kind = 5;
        }
        _ => {
        }
    }
    if kind < 0 {
        return false;
    }
    var rd: i64 = peir_value_reg(dst - PEIR_REG_SLOT);
    var has_const: bool = false;
    var rval: i64 = 0;
    match rconst {
        OptU64::Some(v) => {
            has_const = true;
            rval = v;
        }
        OptU64::None => {
        }
    }
    // `mov rd, l` must not overwrite the right operand
    if !has_const && roff == dst {
        return false;
    }
    var small: bool = has_const && rval > -2147483648 && rval <= 2147483647;
    var checked: bool = !self.cur_wrapping && !self.cur_unchecked;
    // Instruction selection (competitive OP18): with the left operand in a
    // register, no copy first. `imul rd, rl, imm`; and where no overflow
    // check is needed, `lea rd, [rl + imm]`, `lea rd, [rl + rr]` and
    // `lea rd, [rl + rl*k]` for * 2, 3, 5 and 9.
    var lreg: i64 = -1;
    if loff >= PEIR_REG_SLOT && !peir_is_xmm_slot(loff) {
        lreg = peir_value_reg(loff - PEIR_REG_SLOT);
    }
    if lreg >= 0 && kind == 2 && small {
        if !checked && (rval == 2 || rval == 3 || rval == 5 || rval == 9) {
            var sc: i64 = 0;
            if rval == 3 {
                sc = 1;
            }
            if rval == 5 {
                sc = 2;
            }
            if rval == 9 {
                sc = 3;
            }
            PeirEnc_lea_base_index(&mut self.enc, rd, lreg, lreg, sc);
            return true;
        }
        PeirEnc_imul_r_r_imm(&mut self.enc, rd, lreg, rval);
        if checked {
            PeirGen_jump_panic(self, 0x0, PEIR_PANIC_MUL);
        }
        return true;
    }
    if lreg >= 0 && lreg != rd && !checked && (kind == 0 || kind == 1) {
        if small && rval > -2147483647 {
            var disp: i64 = rval;
            if kind == 1 {
                disp = 0 - rval;
            }
            PeirEnc_lea_base_disp(&mut self.enc, rd, lreg, disp);
            return true;
        }
        if kind == 0 && !has_const && roff >= PEIR_REG_SLOT && !peir_is_xmm_slot(roff) {
            PeirEnc_lea_base_index(&mut self.enc, rd, lreg, peir_value_reg(roff - PEIR_REG_SLOT), 0);
            return true;
        }
    }
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, rd, loff);
    // The right operand: an immediate, its register, or rcx
    var rs: i64 = PEIR_RCX;
    if has_const {
        if !(small && kind <= 2) {
            PeirEnc_mov_imm(&mut self.enc, PEIR_RCX, rval);
        }
    } else if roff >= PEIR_REG_SLOT {
        rs = peir_value_reg(roff - PEIR_REG_SLOT);
    } else {
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, roff);
    }
    var imm: bool = small && kind <= 2;
    if kind == 0 {
        if imm {
            PeirEnc_add_r_imm(&mut self.enc, rd, rval);
        } else {
            PeirEnc_add_rr(&mut self.enc, rd, rs);
        }
        if checked {
            PeirGen_jump_panic(self, 0x0, PEIR_PANIC_ADD);
        }
    } else if kind == 1 {
        if imm {
            PeirEnc_add_r_imm(&mut self.enc, rd, 0 - rval);
        } else {
            PeirEnc_sub_rr(&mut self.enc, rd, rs);
        }
        if checked {
            PeirGen_jump_panic(self, 0x0, PEIR_PANIC_SUB);
        }
    } else if kind == 2 {
        if imm {
            PeirEnc_imul_r_r_imm(&mut self.enc, rd, rd, rval);
        } else {
            PeirEnc_imul_rr(&mut self.enc, rd, rs);
        }
        if checked {
            PeirGen_jump_panic(self, 0x0, PEIR_PANIC_MUL);
        }
    } else if kind == 3 {
        PeirEnc_and_rr(&mut self.enc, rd, rs);
    } else if kind == 4 {
        PeirEnc_or_rr(&mut self.enc, rd, rs);
    } else {
        PeirEnc_xor_rr(&mut self.enc, rd, rs);
    }
    return true;
}

/// Copy the value at frame offset `src` to frame offset `dst`, either of
/// which may be a register (D13: one mov between registers).
fn PeirGen_move_slot(self: &mut PeirGen, dst: i64, src: i64) -> void {
    if dst == src {
        return;
    }
    if peir_is_xmm_slot(dst) {
        PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, dst - PEIR_XMM_SLOT, src);
        return;
    }
    if peir_is_xmm_slot(src) {
        PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, dst, src - PEIR_XMM_SLOT);
        return;
    }
    if dst >= PEIR_REG_SLOT {
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, peir_value_reg(dst - PEIR_REG_SLOT), src);
    } else if src >= PEIR_REG_SLOT {
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, peir_value_reg(src - PEIR_REG_SLOT));
    } else {
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, src);
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
    }
}

/// `reg` = a value: its constant, or its stack slot.
fn PeirGen_load_operand(self: &mut PeirGen, reg: i64, value: i64, frame: &PeStackFrame) -> void {
    if pe_idmap_has(&frame.const_vals, value) {
        PeirEnc_mov_imm(&mut self.enc, reg, pe_idmap_get(&frame.const_vals, value));
    } else {
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, reg, PeStackFrame_offset(frame, value));
    }
}

/// The element-code word of a Vec of bytes (u8 or bool): core's
/// vec_code_word(1), P_VEC_TAG + 1 + 8 (release D14).
const PEIR_VEC_BYTES: i64 = 0x4649445645430009;
/// Is `v` typed as a Vec of u8 or bool (its code is most likely bytes)?
fn peir_vec_bytes_typed(func: &IrFunction, v: i64) -> bool {
    match IrFunction_get_meta(func, v) {
        OptValueMeta::Some(m) => {
            match m.ty {
                IrType::Generic(n, args) => {
                    if n == "Vec" && args.len() == 1 {
                        match args.get(0) {
                            IrType::U8 => {
                                return true;
                            }
                            IrType::Bool => {
                                return true;
                            }
                            _ => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
        }
        OptValueMeta::None => {
        }
    }
    return false;
}

/// A cold path: its kind (1 get, 2 set, 3 push), entry and return labels,
/// whether the hot path tried bytes first; emitted after the function.
fn peir_cold_add(frame: &mut PeStackFrame, kind: i64, entry: i64, back: i64, bytes: bool) {
    frame.cold.push(kind);
    frame.cold.push(entry);
    frame.cold.push(back);
    if bytes {
        frame.cold.push(1);
    } else {
        frame.cold.push(0);
    }
}

/// rdx = element rcx of the Vec at rax, of one word or one byte
fn PeirGen_vec_load_word(self: &mut PeirGen) {
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_mov_r_idx8(&mut self.enc, PEIR_RDX, PEIR_RDX, PEIR_RCX);
}

fn PeirGen_vec_load_byte(self: &mut PeirGen) {
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_movzx_r_byte_idx(&mut self.enc, PEIR_RDX, PEIR_RDX, PEIR_RCX);
}

/// Vec_len, Vec_get, Vec_set and Vec_push (core.fd), the hottest calls of
/// most programs: their common case at the call site, the rest a call to
/// core's function out of line (after the function, so the common case
/// falls through). Bounds checks are unsigned, so a negative index fails
/// them too. A Vec of words or of bytes (release D14) takes the inline
/// path; which is tried first follows the Vec's static type. The `__env`
/// argument, when present, is first. True when the call was generated.
fn PeirGen_inline_vec_call(self: &mut PeirGen, name: str, args: Vec<i64>, dst: i64, frame: &mut PeStackFrame, func: &IrFunction) -> bool {
    if self.bare_mode {
        return false;
    }
    if name == "Vec_len" && args.len() >= 1 {
        PeirGen_load_operand(self, PEIR_RAX, args.get(args.len() - 1), frame);
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RAX, 8);
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
        return true;
    }
    if name == "Vec_get" && args.len() >= 2 {
        var gv: i64 = args.get(args.len() - 2);
        PeirGen_load_operand(self, PEIR_RAX, gv, frame);
        PeirGen_load_operand(self, PEIR_RCX, args.get(args.len() - 1), frame);
        if !self.cur_unchecked {
            PeirEnc_cmp_r_mem(&mut self.enc, PEIR_RCX, PEIR_RAX, 8);
            PeirGen_jump_panic(self, 0x3, PEIR_PANIC_VEC_INDEX);
            // jae
        }
        if !HashMap_contains(self.func_labels, "Vec_get") {
            PeirGen_vec_load_word(self);
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RDX);
            return true;
        }
        var gcold: i64 = PeirEnc_alloc_label(&mut self.enc);
        var gdone: i64 = PeirEnc_alloc_label(&mut self.enc);
        var gbytes: bool = peir_vec_bytes_typed(func, gv);
        if gbytes {
            PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, PEIR_VEC_BYTES);
            PeirEnc_cmp_r_mem(&mut self.enc, PEIR_R9, PEIR_RAX, 24);
            PeirEnc_jcc_label(&mut self.enc, 0x5, gcold);
            // jne
            PeirGen_vec_load_byte(self);
        } else {
            PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 24, 0);
            PeirEnc_jcc_label(&mut self.enc, 0x5, gcold);
            // jnz
            PeirGen_vec_load_word(self);
        }
        PeirEnc_place_label(&mut self.enc, gdone);
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RDX);
        peir_cold_add(frame, 1, gcold, gdone, gbytes);
        return true;
    }
    if name == "Vec_set" && args.len() >= 3 {
        var sv: i64 = args.get(args.len() - 3);
        PeirGen_load_operand(self, PEIR_RAX, sv, frame);
        PeirGen_load_operand(self, PEIR_RCX, args.get(args.len() - 2), frame);
        PeirGen_load_operand(self, PEIR_RDX, args.get(args.len() - 1), frame);
        if !self.cur_unchecked {
            PeirEnc_cmp_r_mem(&mut self.enc, PEIR_RCX, PEIR_RAX, 8);
            PeirGen_jump_panic(self, 0x3, PEIR_PANIC_VEC_INDEX);
            // jae
        }
        if !HashMap_contains(self.func_labels, "Vec_set") {
            PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
            PeirEnc_mov_idx8_r(&mut self.enc, PEIR_R8, PEIR_RCX, PEIR_RDX);
            return true;
        }
        var scold: i64 = PeirEnc_alloc_label(&mut self.enc);
        var sdone: i64 = PeirEnc_alloc_label(&mut self.enc);
        var sbytes: bool = peir_vec_bytes_typed(func, sv);
        // Shared data (negative capacity: core's Vec_set copies it first),
        // elements the Vec owns (type at +32, proposal 0004: core drops the
        // old one) and the other element size go to the cold path
        PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 16, 0);
        PeirEnc_jcc_label(&mut self.enc, 0xC, scold);
        // jl
        if sbytes {
            PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, PEIR_VEC_BYTES);
            PeirEnc_cmp_r_mem(&mut self.enc, PEIR_R9, PEIR_RAX, 24);
            PeirEnc_jcc_label(&mut self.enc, 0x5, scold);
            // jne
            PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 32, 0);
            PeirEnc_jcc_label(&mut self.enc, 0x5, scold);
            // jne
            PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
            PeirEnc_mov_byte_idx_r(&mut self.enc, PEIR_R8, PEIR_RCX, PEIR_RDX);
        } else {
            PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R8, PEIR_RAX, 24);
            PeirEnc_or_r_mem(&mut self.enc, PEIR_R8, PEIR_RAX, 32);
            PeirEnc_jcc_label(&mut self.enc, 0x5, scold);
            // jnz
            PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
            PeirEnc_mov_idx8_r(&mut self.enc, PEIR_R8, PEIR_RCX, PEIR_RDX);
        }
        PeirEnc_place_label(&mut self.enc, sdone);
        peir_cold_add(frame, 2, scold, sdone, sbytes);
        return true;
    }
    // Vec_push with room in the buffer; growing stays a call
    if name == "Vec_push" && args.len() == 3 && HashMap_contains(self.func_labels, "Vec_push") {
        var pcold: i64 = PeirEnc_alloc_label(&mut self.enc);
        var pdone: i64 = PeirEnc_alloc_label(&mut self.enc);
        var pbytes: bool = peir_vec_bytes_typed(func, args.get(1));
        PeirGen_load_operand(self, PEIR_RAX, args.get(1), frame);
        PeirGen_load_operand(self, PEIR_RCX, args.get(2), frame);
        if pbytes {
            PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, PEIR_VEC_BYTES);
            PeirEnc_cmp_r_mem(&mut self.enc, PEIR_R9, PEIR_RAX, 24);
            PeirEnc_jcc_label(&mut self.enc, 0x5, pcold);
            // jne
        } else {
            // Elements at their size (D14, element code at +24): the call
            PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 24, 0);
            PeirEnc_jcc_label(&mut self.enc, 0x5, pcold);
            // jnz
        }
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_RAX, 8);
        // signed: a shared Vec's capacity is negative and takes the call
        PeirEnc_cmp_r_mem(&mut self.enc, PEIR_RDX, PEIR_RAX, 16);
        PeirEnc_jcc_label(&mut self.enc, 0xD, pcold);
        // jge
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
        if pbytes {
            PeirEnc_mov_byte_idx_r(&mut self.enc, PEIR_R8, PEIR_RDX, PEIR_RCX);
        } else {
            PeirEnc_mov_idx8_r(&mut self.enc, PEIR_R8, PEIR_RDX, PEIR_RCX);
        }
        PeirEnc_inc_r(&mut self.enc, PEIR_RDX);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 8, PEIR_RDX);
        PeirEnc_place_label(&mut self.enc, pdone);
        peir_cold_add(frame, 3, pcold, pdone, false);
        return true;
    }
    return false;
}

/// The cold paths of the function's inline Vec calls (inline_vec_call):
/// the other element size, else the call to core. Registers as the hot
/// path left them: rax the Vec, rcx the index (push: the value), rdx the
/// value (get: the result).
fn PeirGen_emit_cold(self: &mut PeirGen, frame: &mut PeStackFrame) {
    var i: i64 = 0;
    while i + 3 < frame.cold.len() {
        var kind: i64 = frame.cold.get(i);
        var entry: i64 = frame.cold.get(i + 1);
        var back: i64 = frame.cold.get(i + 2);
        var bytes: bool = frame.cold.get(i + 3) == 1;
        PeirEnc_place_label(&mut self.enc, entry);
        var slow: i64 = PeirEnc_alloc_label(&mut self.enc);
        if kind == 1 {
            // the other element size, else core's Vec_get
            if bytes {
                PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 24, 0);
                PeirEnc_jcc_label(&mut self.enc, 0x5, slow);
                PeirGen_vec_load_word(self);
            } else {
                PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, PEIR_VEC_BYTES);
                PeirEnc_cmp_r_mem(&mut self.enc, PEIR_R9, PEIR_RAX, 24);
                PeirEnc_jcc_label(&mut self.enc, 0x5, slow);
                PeirGen_vec_load_byte(self);
            }
            PeirEnc_jmp_label(&mut self.enc, back);
            PeirEnc_place_label(&mut self.enc, slow);
            PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RCX);
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
            PeirEnc_xor_self(&mut self.enc, PEIR_RCX);
            PeirEnc_sub_rsp_i32(&mut self.enc, 32);
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "Vec_get"));
            PeirEnc_add_rsp_i32(&mut self.enc, 32);
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
            PeirEnc_jmp_label(&mut self.enc, back);
        } else if kind == 2 {
            // not shared and not owning: the other element size
            PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 16, 0);
            PeirEnc_jcc_label(&mut self.enc, 0xC, slow);
            PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 32, 0);
            PeirEnc_jcc_label(&mut self.enc, 0x5, slow);
            if bytes {
                PeirEnc_cmp_mem_imm8(&mut self.enc, PEIR_RAX, 24, 0);
                PeirEnc_jcc_label(&mut self.enc, 0x5, slow);
                PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
                PeirEnc_mov_idx8_r(&mut self.enc, PEIR_R8, PEIR_RCX, PEIR_RDX);
            } else {
                PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, PEIR_VEC_BYTES);
                PeirEnc_cmp_r_mem(&mut self.enc, PEIR_R9, PEIR_RAX, 24);
                PeirEnc_jcc_label(&mut self.enc, 0x5, slow);
                PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
                PeirEnc_mov_byte_idx_r(&mut self.enc, PEIR_R8, PEIR_RCX, PEIR_RDX);
            }
            PeirEnc_jmp_label(&mut self.enc, back);
            PeirEnc_place_label(&mut self.enc, slow);
            PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RDX);
            PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RCX);
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
            PeirEnc_xor_self(&mut self.enc, PEIR_RCX);
            PeirEnc_sub_rsp_i32(&mut self.enc, 32);
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "Vec_set"));
            PeirEnc_add_rsp_i32(&mut self.enc, 32);
            PeirEnc_jmp_label(&mut self.enc, back);
        } else {
            // push: grow, share, or another element size
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
            PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RCX);
            PeirEnc_xor_self(&mut self.enc, PEIR_RCX);
            PeirEnc_sub_rsp_i32(&mut self.enc, 32);
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "Vec_push"));
            PeirEnc_add_rsp_i32(&mut self.enc, 32);
            PeirEnc_jmp_label(&mut self.enc, back);
        }
        i = i + 4;
    }
    frame.cold.clear();
}

/// rax = the value of `rax` in narrow type `ty`; panics (stub `panic` >= 0)
/// instead if it changes. Not a narrow type: nothing.
fn PeirGen_gen_narrow(self: &mut PeirGen, ty: IrType, panic: i64) -> void {
    match ty {
        IrType::I8 => {
            PeirEnc_movsx_r64_r8(&mut self.enc, PEIR_RDX, PEIR_RAX);
        }
        IrType::I16 => {
            PeirEnc_movsx_r64_r16(&mut self.enc, PEIR_RDX, PEIR_RAX);
        }
        IrType::I32 => {
            PeirEnc_movsxd_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        }
        IrType::U8 => {
            PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RDX, PEIR_RAX);
        }
        IrType::U16 => {
            PeirEnc_movzx_r32_r16(&mut self.enc, PEIR_RDX, PEIR_RAX);
        }
        IrType::U32 => {
            PeirEnc_mov_r32_r32(&mut self.enc, PEIR_RDX, PEIR_RAX);
        }
        _ => {
            return;
        }
    }
    if panic >= 0 {
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        PeirGen_jump_panic(self, 0x5, panic);
    }
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
}

/// rax / rcx or rax % rcx. Dividing by zero panics, even in @wrapping code;
/// idiv also traps on MIN / -1, so -1 never reaches it. A constant divisor
/// needs neither check.
fn peir_emit_shift(e: &mut PeirEnc, op: i64, k: i64) {
    e.code.push(0x48);
    e.code.push(0xC1);
    e.code.push(op);
    e.code.push(k);
}

/// rax / d or rax % d, signed, for a constant d >= 2: no idiv. The quotient
/// truncates toward zero, as idiv's does.
fn PeirGen_gen_div_const(self: &mut PeirGen, is_mod: bool, d: i64) -> void {
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    // rcx = n
    PeirGen_gen_div_const_n(self, is_mod, d, false);
    if is_mod {
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    }
}

/// n / d in rax, or n % d in rcx, of n in rax and rcx. `nonneg`: n >= 0
/// (range analysis), so the quotient needs no rounding toward zero.
fn PeirGen_gen_div_const_n(self: &mut PeirGen, is_mod: bool, d: i64, nonneg: bool) -> void {
    if nonneg && (d & (d - 1)) == 0 {
        var k0: i64 = 0;
        while (1 << k0) < d {
            k0 = k0 + 1;
        }
        peir_emit_shift(&mut self.enc, 0xF8, k0);
        // sar rax, k
    } else if nonneg {
        var magic0: Vec<i64> = peir_div_magic(d);
        var m0: i64 = magic0.get(0);
        var s0: i64 = magic0.get(1);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, m0);
        peir_emit2(&mut self.enc, 0x48, 0xF7);
        PeirEnc_emit_u8(&mut self.enc, 0xE9);
        // imul rcx: rdx = high half
        if m0 < 0 {
            PeirEnc_add_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        }
        if s0 > 0 {
            peir_emit_shift(&mut self.enc, 0xFA, s0);
        }
        // sar rdx, s
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    } else if (d & (d - 1)) == 0 {
        var k: i64 = 0;
        while (1 << k) < d {
            k = k + 1;
        }
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        peir_emit_shift(&mut self.enc, 0xFA, 63);
        // sar rdx, 63
        peir_emit_shift(&mut self.enc, 0xEA, 64 - k);
        // shr rdx, 64 - k
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
        peir_emit_shift(&mut self.enc, 0xF8, k);
        // sar rax, k
    } else {
        var magic: Vec<i64> = peir_div_magic(d);
        var m: i64 = magic.get(0);
        var s: i64 = magic.get(1);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, m);
        peir_emit2(&mut self.enc, 0x48, 0xF7);
        PeirEnc_emit_u8(&mut self.enc, 0xE9);
        // imul rcx: rdx = high half
        if m < 0 {
            PeirEnc_add_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        }
        if s > 0 {
            peir_emit_shift(&mut self.enc, 0xFA, s);
        }
        // sar rdx, s
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
        peir_emit_shift(&mut self.enc, 0xE8, 63);
        // shr rax, 63
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    }
    if is_mod {
        if d <= 2147483647 {
            PeirEnc_imul_r_r_imm(&mut self.enc, PEIR_RAX, PEIR_RAX, d);
        } else {
            PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, d);
            PeirEnc_imul_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
        }
        PeirEnc_sub_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    }
}

fn PeirGen_gen_int_div(self: &mut PeirGen, is_mod: bool, rconst: OptU64, ty: IrType, checked: bool) -> void {
    var may_be_zero: bool = true;
    var may_be_m1: bool = true;
    match rconst {
        OptU64::Some(v) => {
            may_be_zero = v == 0;
            may_be_m1 = v == -1;
        }
        OptU64::None => {
        }
    }
    match rconst {
        OptU64::Some(d) => {
            if d >= 2 && !(ir_type_eq(ty, IrType::U8) || ir_type_eq(ty, IrType::U16) || ir_type_eq(ty, IrType::U32) || ir_type_eq(ty, IrType::U64)) {
                PeirGen_gen_div_const(self, is_mod, d);
                return;
            }
        }
        OptU64::None => {
        }
    }
    if may_be_zero {
        PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        if is_mod {
            PeirGen_jump_panic(self, 0x4, PEIR_PANIC_MOD_ZERO);
        } else {
            PeirGen_jump_panic(self, 0x4, PEIR_PANIC_DIV_ZERO);
        }
    }
    var unsigned: bool = ir_type_eq(ty, IrType::U8) || ir_type_eq(ty, IrType::U16) || ir_type_eq(ty, IrType::U32) || ir_type_eq(ty, IrType::U64);
    if unsigned {
        PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
        PeirEnc_div_rr(&mut self.enc, PEIR_RCX);
    } else if may_be_m1 {
        var normal: i64 = PeirEnc_alloc_label(&mut self.enc);
        var done: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, -1);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RCX, PEIR_RDX);
        PeirEnc_jcc_label(&mut self.enc, 0x5, normal);
        if is_mod {
            PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
        } else {
            PeirEnc_neg_r(&mut self.enc, PEIR_RAX);
            if checked && ir_type_eq(ty, IrType::I64) {
                PeirGen_jump_panic(self, 0x0, PEIR_PANIC_DIV_OVF);
            }
        }
        PeirEnc_jmp_label(&mut self.enc, done);
        PeirEnc_place_label(&mut self.enc, normal);
        PeirEnc_cqo(&mut self.enc);
        PeirEnc_idiv_r(&mut self.enc, PEIR_RCX);
        PeirEnc_place_label(&mut self.enc, done);
    } else {
        PeirEnc_cqo(&mut self.enc);
        PeirEnc_idiv_r(&mut self.enc, PEIR_RCX);
    }
    if is_mod {
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    }
}

/// Exception code `code`: panic with `msg`, else fall through.
fn PeirGen_crash_case(self: &mut PeirGen, code: i64, msg: str, report: i64) -> void {
    var next: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, code);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, next);
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, msg));
    PeirEnc_jmp_label(&mut self.enc, report);
    PeirEnc_place_label(&mut self.enc, next);
}

/// The shared stubs behind the arithmetic panics, and the handler turning a
/// CPU fault into a panic with a message.
pub fn PeirGen_gen_arith_panics(self: &mut PeirGen) -> void {
    var panic: i64 = HashMap_get(self.func_labels, "p_panic");
    var msgs: Vec<str> = peir_arith_panic_strings();
    var i: i64 = 0;
    while i < msgs.len() {
        PeirEnc_place_label(&mut self.enc, self.arith_panics.get(i));
        PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, msgs.get(i)));
        PeirEnc_sub_rsp_i32(&mut self.enc, 32);
        PeirEnc_call_label(&mut self.enc, panic);
        PeirEnc_ud2(&mut self.enc);
        i = i + 1;
    }

    // LONG handler(EXCEPTION_POINTERS* rcx): [[rcx]] is the exception code.
    // A vectored handler: these executables have no unwind tables, so the
    // system's frame walk gives up before any unhandled-exception filter
    // would run. It sees first-chance exceptions too, so anything but these
    // fatal codes goes on searching.
    PeirEnc_place_label(&mut self.enc, self.crash_filter);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_mov_r32_r32(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var report: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirGen_crash_case(self, 0xC00000FD, "Stack overflow", report);
    // --checked-alloc: a fault on a checked block's page names the block
    if g_pe_checked_alloc && !self.bare_mode {
        PeirGen_gen_checked_fault(self);
    }
    PeirGen_crash_case(self, 0xC0000005, "Invalid memory access (null or dangling pointer)", report);
    PeirGen_crash_case(self, 0xC0000094, "Division by zero", report);
    PeirGen_crash_case(self, 0xC000001D, "Illegal instruction", report);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    // EXCEPTION_CONTINUE_SEARCH
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, report);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    PeirEnc_call_label(&mut self.enc, panic);
    PeirEnc_ud2(&mut self.enc);
}

/// Generate float binary operation.
pub fn PeirGen_gen_float_binop(self: &mut PeirGen, op: BinOp, loff: i64, roff: i64, dst: i64, ty: IrType) -> void {
    var is_f32: bool = ir_type_eq(ty, IrType::F32);
    // OP17: an f64 operation reads an operand held in an xmm register
    // (xmm2..xmm7, peir_ra_xmm: no REX) where it is, and computes into the
    // result's register when it has one (movsd to or from an xmm slot is a
    // register move or nothing). The result's register is used only when
    // it is not the right operand's (or both operands are the same value).
    if !is_f32 && pe_binop_is_arith(op) {
        var rs: i64 = 1;
        if peir_is_xmm_slot(roff) {
            rs = roff - PEIR_XMM_SLOT;
        } else {
            PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 1, roff);
        }
        var xd: i64 = 0;
        if peir_is_xmm_slot(dst) && (dst != roff || loff == roff) {
            xd = dst - PEIR_XMM_SLOT;
        }
        PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, xd, loff);
        match op {
            BinOp::Add => {
                PeirEnc_addsd(&mut self.enc, xd, rs);
            }
            BinOp::Sub => {
                PeirEnc_subsd(&mut self.enc, xd, rs);
            }
            BinOp::Mul => {
                PeirEnc_mulsd(&mut self.enc, xd, rs);
            }
            _ => {
                PeirEnc_divsd(&mut self.enc, xd, rs);
            }
        }
        PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, dst, xd);
        return;
    }
    // OP17: a comparison's f64 operands held in xmm registers are compared
    // where they are (lx, rx); everything else goes through xmm0 / xmm1
    var lx: i64 = 0;
    var rx: i64 = 1;
    if is_f32 {
        PeirEnc_movss_xmm_mem_rbp(&mut self.enc, 0, loff);
        PeirEnc_movss_xmm_mem_rbp(&mut self.enc, 1, roff);
    } else if pe_binop_is_cmp(op) {
        if peir_is_xmm_slot(loff) {
            lx = loff - PEIR_XMM_SLOT;
        } else {
            PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, loff);
        }
        if peir_is_xmm_slot(roff) {
            rx = roff - PEIR_XMM_SLOT;
        } else {
            PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 1, roff);
        }
    } else {
        PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, loff);
        PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 1, roff);
    }
    if pe_binop_is_arith(op) {
        match op {
            BinOp::Add => {
                if is_f32 {
                    PeirEnc_addss(&mut self.enc, 0, 1);
                } else {
                    PeirEnc_addsd(&mut self.enc, 0, 1);
                }
            }
            BinOp::Sub => {
                if is_f32 {
                    PeirEnc_subss(&mut self.enc, 0, 1);
                } else {
                    PeirEnc_subsd(&mut self.enc, 0, 1);
                }
            }
            BinOp::Mul => {
                if is_f32 {
                    PeirEnc_mulss(&mut self.enc, 0, 1);
                } else {
                    PeirEnc_mulsd(&mut self.enc, 0, 1);
                }
            }
            _ => {
                if is_f32 {
                    PeirEnc_divss(&mut self.enc, 0, 1);
                } else {
                    PeirEnc_divsd(&mut self.enc, 0, 1);
                }
            }
        }
        if is_f32 {
            PeirEnc_movss_mem_rbp_xmm(&mut self.enc, dst, 0);
        } else {
            PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, dst, 0);
        }
    } else if pe_binop_is_cmp(op) {
        // IEEE: every comparison with NaN is false, except !=. An
        // unordered ucomis sets ZF, PF and CF, so: a < b is b > a
        // (seta: CF = ZF = 0), a <= b is b >= a (setae: CF = 0), and
        // == / != also look at PF.
        var a: i64 = lx;
        var b: i64 = rx;
        match op {
            BinOp::Lt => {
                a = rx;
                b = lx;
            }
            BinOp::LtEq => {
                a = rx;
                b = lx;
            }
            _ => {
                a = lx;
                b = rx;
            }
        }
        if is_f32 {
            PeirEnc_ucomiss(&mut self.enc, a, b);
        } else {
            PeirEnc_ucomisd(&mut self.enc, a, b);
        }
        match op {
            BinOp::Eq => {
                PeirEnc_setcc_r(&mut self.enc, 0x4, PEIR_RAX);
                // sete al
                PeirEnc_setcc_r(&mut self.enc, 0xB, PEIR_RCX);
                // setnp cl
                peir_emit2(&mut self.enc, 0x20, 0xC8);
                // and al, cl
            }
            BinOp::Neq => {
                PeirEnc_setcc_r(&mut self.enc, 0x5, PEIR_RAX);
                // setne al
                PeirEnc_setcc_r(&mut self.enc, 0xA, PEIR_RCX);
                // setp cl
                peir_emit2(&mut self.enc, 0x08, 0xC8);
                // or al, cl
            }
            BinOp::Lt => {
                PeirEnc_setcc_r(&mut self.enc, 0x7, PEIR_RAX);
                // seta
            }
            BinOp::Gt => {
                PeirEnc_setcc_r(&mut self.enc, 0x7, PEIR_RAX);
                // seta
            }
            _ => {
                PeirEnc_setcc_r(&mut self.enc, 0x3, PEIR_RAX);
                // setae
            }
        }
        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, PEIR_RAX);
    } else {
        match op {
            BinOp::Mod => {
                PeirGen_gen_float_rem(self, dst, is_f32);
            }
            _ => {
            }
        }
    }
}

/// MI17: `%` on f32/f64 is C's fmod/fmodf, as `fid run`, the C path and
/// the machine layer give (pe_ir stored nothing: the result was whatever
/// the slot held, 7.5 % 3.0 printed 7.5). The operands are in xmm0 (a)
/// and xmm1 (b). x87 FPREM gives the exact truncated remainder (the sign
/// of a; NaN for b == 0 or an infinite a), repeated while C2 says it is
/// partial; no call, so no register the allocator holds a value in is
/// clobbered (only rax, as the comparisons above, and x87 state, left
/// empty). 16 bytes below rsp move the values between SSE and x87.
fn PeirGen_gen_float_rem(self: &mut PeirGen, dst: i64, is_f32: bool) -> void {
    PeirEnc_sub_rsp_i32(&mut self.enc, 16);
    var b: Vec<i64> = Vec::new();
    // fld b, then fld a: st0 = a, st1 = b
    if is_f32 {
        // movss [rsp], xmm1 ; fld dword [rsp] ; movss [rsp], xmm0 ; fld dword [rsp]
        b.push(0xF3);
        b.push(0x0F);
        b.push(0x11);
        b.push(0x0C);
        b.push(0x24);
        b.push(0xD9);
        b.push(0x04);
        b.push(0x24);
        b.push(0xF3);
        b.push(0x0F);
        b.push(0x11);
        b.push(0x04);
        b.push(0x24);
        b.push(0xD9);
        b.push(0x04);
        b.push(0x24);
    } else {
        // movsd [rsp], xmm1 ; fld qword [rsp] ; movsd [rsp], xmm0 ; fld qword [rsp]
        b.push(0xF2);
        b.push(0x0F);
        b.push(0x11);
        b.push(0x0C);
        b.push(0x24);
        b.push(0xDD);
        b.push(0x04);
        b.push(0x24);
        b.push(0xF2);
        b.push(0x0F);
        b.push(0x11);
        b.push(0x04);
        b.push(0x24);
        b.push(0xDD);
        b.push(0x04);
        b.push(0x24);
    }
    // again: fprem ; fnstsw ax ; test ah, 4 (C2: partial) ; jnz again (-9)
    b.push(0xD9);
    b.push(0xF8);
    b.push(0xDF);
    b.push(0xE0);
    b.push(0xF6);
    b.push(0xC4);
    b.push(0x04);
    b.push(0x75);
    b.push(0xF7);
    // fstp st(1): st0 = the remainder, b popped
    b.push(0xDD);
    b.push(0xD9);
    if is_f32 {
        // fstp dword [rsp] ; movss xmm0, [rsp]
        b.push(0xD9);
        b.push(0x1C);
        b.push(0x24);
        b.push(0xF3);
        b.push(0x0F);
        b.push(0x10);
        b.push(0x04);
        b.push(0x24);
    } else {
        // fstp qword [rsp] ; movsd xmm0, [rsp]
        b.push(0xDD);
        b.push(0x1C);
        b.push(0x24);
        b.push(0xF2);
        b.push(0x0F);
        b.push(0x10);
        b.push(0x04);
        b.push(0x24);
    }
    PeirEnc_emit_bytes(&mut self.enc, b);
    PeirEnc_add_rsp_i32(&mut self.enc, 16);
    if is_f32 {
        PeirEnc_movss_mem_rbp_xmm(&mut self.enc, dst, 0);
    } else {
        PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, dst, 0);
    }
}

// ===========================================================================
// J7: @constant_time on the default Windows backend (and --bare / --elf)
// ===========================================================================
//
// The source-level check (TypeChecker_verify_constant_time) works on names
// in the AST. This one runs on the IR this backend turns into machine code,
// after lowering and the mid-end, and follows values through memory and
// calls, so it also sees what the source check cannot: a secret that
// reaches a loop bound through an `&mut` out-parameter, a field of a local
// struct, or a global. nat_ir.fd's ng_ct_check is its machine-layer
// counterpart for `--nat` and the Linux targets.
//
// Secret: every parameter (the IR does not keep @public), and every value
// computed from a secret: arithmetic, comparisons, conversions, addresses,
// a load from memory a secret was stored into (per alloca or global, flow-
// insensitive), and the result of a call one of whose arguments is secret,
// except a length query (`len`, `*_len`, `*_length`: lengths are public,
// as in the source check). A call that is given a secret also makes the memory behind
// every pointer it is given secret (it may store the secret there).
//
// Rejected in a @constant_time function:
//   a conditional branch on a secret value (a jcc in this backend's code)
//   integer division or remainder of a secret (idiv/div: variable latency),
//     except a signed division by a constant >= 2, which this backend turns
//     into a multiplication (PeirGen_gen_div_const)
//   float division of a secret (divsd: variable latency)
//   an indirect call (closure, function value, dyn method)
// Not rejected: overflow, bounds and narrowing checks. Their jump is taken
// only on a run that ends in a panic, so a run that completes executes the
// same instructions whatever the secret is. Memory addresses are not
// checked here either (a pointer to a secret buffer is not secret itself);
// the source check rejects indexing by a secret.
// FID_PE_CT_OFF=1 turns this check off (to compare, or around a false
// positive: please report one).

/// The alloca or global that pointer `v` is derived from (through field and
/// element addresses and bit casts): its instruction id, or -1.
fn peir_ct_root(func: &IrFunction, v: i64) -> i64 {
    var cur: i64 = v;
    var steps: i64 = 0;
    while steps < 64 {
        match peir_inst_of(func, cur) {
            Inst::Alloca(_, _) => {
                return cur;
            }
            Inst::GlobalAddr(_, _) => {
                return cur;
            }
            Inst::GetFieldPtr(p, _, _) => {
                cur = p;
            }
            Inst::GetElemPtr(p, _, _) => {
                cur = p;
            }
            Inst::BitCast(p, _, _) => {
                cur = p;
            }
            _ => {
                return -1;
            }
        }
        steps = steps + 1;
    }
    return -1;
}

/// The key of the memory `p` points into ("a:<alloca id>", "g:<global>"),
/// or "" when it is not a local or a global.
fn peir_ct_mem_key(func: &IrFunction, p: i64) -> str {
    var root: i64 = peir_ct_root(func, p);
    if root < 0 {
        return "";
    }
    match peir_inst_of(func, root) {
        Inst::GlobalAddr(gname, _) => {
            return "g:" + gname;
        }
        _ => {
        }
    }
    return "a:" + int_to_str(root);
}

/// Does `p` point into memory a secret was stored into?
fn peir_ct_mem_secret(func: &IrFunction, mem: i64, p: i64) -> bool {
    var key: str = peir_ct_mem_key(func, p);
    if key == "" {
        return false;
    }
    return HashMap_contains(mem, key);
}

/// Mark the memory `p` points into as holding a secret; true when it was
/// not marked before.
fn peir_ct_mem_mark(func: &IrFunction, mem: i64, p: i64) -> bool {
    var key: str = peir_ct_mem_key(func, p);
    if key == "" || HashMap_contains(mem, key) {
        return false;
    }
    HashMap_insert(mem, key, 1);
    return true;
}

fn peir_ct_sec(secret: &Vec<i64>, v: i64) -> bool {
    return v >= 0 && v < secret.len() && secret.get(v) != 0;
}

/// Is any of `args` secret, or a pointer to memory holding a secret?
fn peir_ct_args_secret(func: &IrFunction, secret: &Vec<i64>, mem: i64, args: Vec<i64>) -> bool {
    var i: i64 = 0;
    while i < args.len() {
        var a: i64 = args.get(i);
        if peir_ct_sec(secret, a) || peir_ct_mem_secret(func, mem, a) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// A call given a secret may store it behind any pointer it is given.
fn peir_ct_args_mark(func: &IrFunction, mem: i64, args: Vec<i64>) -> bool {
    var changed: bool = false;
    var i: i64 = 0;
    while i < args.len() {
        if peir_ct_mem_mark(func, mem, args.get(i)) {
            changed = true;
        }
        i = i + 1;
    }
    return changed;
}

/// A length query: its result is public (TypeChecker's ct_secret rule;
/// a str's `.len()` lowers to p_str_length).
fn peir_ct_is_len(name: str) -> bool {
    return name == "len" || str_ends_with(name, "_len") || str_ends_with(name, "_length");
}

fn peir_ct_unsigned(ty: IrType) -> bool {
    return ir_type_eq(ty, IrType::U8) || ir_type_eq(ty, IrType::U16) || ir_type_eq(ty, IrType::U32) || ir_type_eq(ty, IrType::U64);
}

/// " (line N)" for value `id` when the lowering recorded its source line.
fn peir_ct_line(func: &IrFunction, id: i64) -> str {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => {
            match m.source_line {
                OptU64::Some(v) => {
                    if v > 0 {
                        return " (line " + int_to_str(v as i64) + ")";
                    }
                }
                OptU64::None => {
                }
            }
        }
        OptValueMeta::None => {
        }
    }
    return "";
}

/// Is the check turned off (FID_PE_CT_OFF set and not empty)?
fn peir_ct_off() -> bool {
    var sw: str = peir_env_or_empty("FID_PE_CT_OFF");
    return str_len(sw) > 0 && sw != "0";
}

/// The violations of @constant_time function `func` (named `name`), one
/// message each; empty when it is clean. See the section comment above.
pub fn peir_ct_check(func: &IrFunction, name: str) -> Vec<str> {
    var errs: Vec<str> = Vec::new();
    var nvals: i64 = func.value_metas.len() + func.insts.len() + func.params.len() + 16;
    if func.next_value + 1 > nvals {
        nvals = func.next_value + 1;
    }
    var secret: Vec<i64> = peir_zeros(nvals);
    var mem: i64 = HashMap_new();
    var pi: i64 = 0;
    while pi < func.params.len() {
        var pid: i64 = func.params.get(pi).id;
        if pid >= 0 && pid < nvals {
            secret.set(pid, 1);
        }
        pi = pi + 1;
    }
    // The instructions of the function's blocks, in layout order
    var ids: Vec<i64> = Vec::new();
    var bi: i64 = 0;
    while bi < func.blocks.len() {
        var blk: BasicBlock = func.blocks.get(bi);
        var k: i64 = 0;
        while k < blk.instructions.len() {
            ids.push(blk.instructions.get(k));
            k = k + 1;
        }
        bi = bi + 1;
    }
    // Propagate to a fixpoint: secrets only grow, so each round that
    // changes something marks at least one more value or memory root.
    var changed: bool = true;
    var rounds: i64 = 0;
    while changed && rounds < nvals + 2 {
        changed = false;
        rounds = rounds + 1;
        var ii: i64 = 0;
        while ii < ids.len() {
            var id: i64 = ids.get(ii);
            var t: bool = false;
            match peir_inst_of(func, id) {
                Inst::BinOp(_, l, r, _) => {
                    t = peir_ct_sec(&secret, l) || peir_ct_sec(&secret, r);
                }
                Inst::UnaryOp(_, x, _) => {
                    t = peir_ct_sec(&secret, x);
                }
                Inst::BitCast(x, _, _) => {
                    t = peir_ct_sec(&secret, x);
                }
                Inst::IntExtend(x, _, _) => {
                    t = peir_ct_sec(&secret, x);
                }
                Inst::IntTrunc(x, _, _) => {
                    t = peir_ct_sec(&secret, x);
                }
                Inst::IntToFloat(x, _, _) => {
                    t = peir_ct_sec(&secret, x);
                }
                Inst::FloatToInt(x, _, _) => {
                    t = peir_ct_sec(&secret, x);
                }
                Inst::GetFieldPtr(p, _, _) => {
                    t = peir_ct_sec(&secret, p);
                }
                Inst::GetElemPtr(p, ix, _) => {
                    t = peir_ct_sec(&secret, p) || peir_ct_sec(&secret, ix);
                }
                Inst::Load(p, _) => {
                    t = peir_ct_sec(&secret, p) || peir_ct_mem_secret(func, mem, p);
                }
                Inst::Store(sptr, sval, _) => {
                    if peir_ct_sec(&secret, sval) || peir_ct_mem_secret(func, mem, sval) {
                        if peir_ct_mem_mark(func, mem, sptr) {
                            changed = true;
                        }
                    }
                }
                Inst::StructCopy(cdst, csrc, _) => {
                    if peir_ct_sec(&secret, csrc) || peir_ct_mem_secret(func, mem, csrc) {
                        if peir_ct_mem_mark(func, mem, cdst) {
                            changed = true;
                        }
                    }
                }
                Inst::Call(callee, cargs, _, _) => {
                    var any: bool = peir_ct_args_secret(func, &secret, mem, cargs);
                    if any {
                        if !peir_ct_is_len(callee) {
                            t = true;
                        }
                        if peir_ct_args_mark(func, mem, cargs) {
                            changed = true;
                        }
                    }
                }
                Inst::CallPtr(fptr, pargs, _, _, _) => {
                    var pany: bool = peir_ct_sec(&secret, fptr) || peir_ct_args_secret(func, &secret, mem, pargs);
                    if pany {
                        t = true;
                        if peir_ct_args_mark(func, mem, pargs) {
                            changed = true;
                        }
                    }
                }
                Inst::DynCall(_, _, dargs, _, _) => {
                    if peir_ct_args_secret(func, &secret, mem, dargs) {
                        t = true;
                        if peir_ct_args_mark(func, mem, dargs) {
                            changed = true;
                        }
                    }
                }
                _ => {
                }
            }
            if t && id >= 0 && id < nvals && secret.get(id) == 0 {
                secret.set(id, 1);
                changed = true;
            }
            ii = ii + 1;
        }
    }
    // What the code would do with the secrets
    var ci: i64 = 0;
    while ci < ids.len() {
        var cid: i64 = ids.get(ci);
        var what: str = "";
        match peir_inst_of(func, cid) {
            Inst::Branch(cond, _, _) => {
                if peir_ct_sec(&secret, cond) {
                    what = "conditional branch on secret data";
                }
            }
            Inst::BinOp(op, l, r, ty) => {
                var is_div: bool = false;
                match op {
                    BinOp::Div => {
                        is_div = true;
                    }
                    BinOp::Mod => {
                        is_div = true;
                    }
                    _ => {
                    }
                }
                if is_div && (peir_ct_sec(&secret, l) || peir_ct_sec(&secret, r)) {
                    if ir_type_is_float(ty) {
                        what = "float division of secret data (variable latency)";
                    } else {
                        // A signed division by a constant >= 2 is a multiply
                        var by_const: bool = false;
                        match peir_inst_of(func, r) {
                            Inst::ConstInt(d, _) => {
                                by_const = d >= 2 && !peir_ct_unsigned(ty);
                            }
                            _ => {
                            }
                        }
                        if !by_const {
                            what = "integer division of secret data (variable latency)";
                        }
                    }
                }
            }
            Inst::CallPtr(_, _, _, _, _) => {
                what = "indirect call (closure or function value)";
            }
            Inst::DynCall(_, _, _, _, _) => {
                what = "indirect call (dyn method)";
            }
            _ => {
            }
        }
        if what != "" {
            errs.push("@constant_time function '" + name + "': " + what + peir_ct_line(func, cid));
        }
        ci = ci + 1;
    }
    return errs;
}

/// The error lines of a build that @constant_time code fails: `what` names
/// the build ("PE backend", "bare-metal build").
fn peir_ct_report(errs: Vec<str>, what: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < errs.len() {
        out.push(what + ": @constant_time violated: " + errs.get(i));
        i = i + 1;
    }
    return out;
}

// ===========================================================================
// Nov 16: asm! in processes (LG13), cleared frames (LF20), sibling tail
// calls (OP13), block layout (OP15), line tables (DB3) and the
// per-function cache (B5). FID_PE_OFF=asm,wipe,tail,layout turns the
// first four off.
// ===========================================================================

/// LG13: does the function hold an asm! template?
fn peir_has_asm(func: &IrFunction) -> bool {
    var i: i64 = 0;
    while i < func.insts.len() {
        var ve: ValueIdInst = func.insts.get(i);
        match ve.inst {
            Inst::Asm(_, _, _, _) => {
                return true;
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return false;
}

/// LG13: a template a Windows process runs: no privileged instruction
/// (pe_asm_privileged), and the encoder knows every instruction.
fn peir_asm_runs(template: str) -> bool {
    if pe_asm_privileged(template) {
        return false;
    }
    var r: PeAsmResult = pe_asm_encode(template);
    return r.error == "";
}

/// LG13: asm! in a process. The function keeps every value in its slot and
/// saves every callee-saved register (has_asm), so the template may write
/// any register but rsp and rbp. An output register that is not an input
/// starts at 0: a template that does not write it gives 0, as the
/// interpreter and the old code did. The first output is the value.
fn PeirGen_gen_asm_process(self: &mut PeirGen, template: str, inputs: Vec<StringValueId>, outputs: Vec<StringValueId>, asm_ty: IrType, dst: i64, frame: &PeStackFrame) {
    var enc_res: PeAsmResult = pe_asm_encode(template);
    var inregs: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < inputs.len() {
        inregs.push(pe_asm_reg64(inputs.get(i).name));
        i = i + 1;
    }
    var o: i64 = 0;
    while o < outputs.len() {
        var r: i64 = pe_asm_reg64(outputs.get(o).name);
        if r >= 0 && r != PEIR_RSP && r != PEIR_RBP && !peir_has_i64(inregs, r) {
            PeirEnc_xor_rr(&mut self.enc, r, r);
        }
        o = o + 1;
    }
    i = 0;
    while i < inputs.len() {
        var inr: i64 = inregs.get(i);
        if inr >= 0 && inr != PEIR_RSP && inr != PEIR_RBP && inputs.get(i).id >= 0 {
            PeirGen_load_operand(self, inr, inputs.get(i).id, frame);
        }
        i = i + 1;
    }
    var bi: i64 = 0;
    while bi < enc_res.bytes.len() {
        PeirEnc_emit_u8(&mut self.enc, enc_res.bytes.get(bi));
        bi = bi + 1;
    }
    var outr: i64 = PEIR_RAX;
    var have: bool = false;
    if outputs.len() > 0 {
        var r0: i64 = pe_asm_reg64(outputs.get(0).name);
        if r0 >= 0 {
            outr = r0;
            have = true;
        }
    }
    if !have {
        PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    }
    match asm_ty {
        IrType::Void => {
        }
        _ => {
            PeirEnc_mov_mem_rbp_reg(&mut self.enc, dst, outr);
        }
    }
}

/// LF20: before a function that holds secrets returns (its saved registers
/// already restored, the result in rax): every word of the dead frame
/// [rsp, rbp) becomes 0 — the slots its values, spills and temporaries
/// lived in, the outgoing argument area — and so do the scratch
/// registers (rcx, rdx, r8-r11, xmm0-xmm5). Callee-saved registers hold
/// the caller's values again by then.
fn PeirGen_wipe_frame(self: &mut PeirGen) {
    var top: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_xor_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R11, PEIR_RSP);
    PeirEnc_place_label(&mut self.enc, top);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R11, 0, PEIR_R10);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_R11, 8);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R11, PEIR_RBP);
    PeirEnc_jcc_label(&mut self.enc, 0x2, top);
    // jb: below the frame pointer
    PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_xor_rr(&mut self.enc, PEIR_R8, PEIR_R8);
    PeirEnc_xor_rr(&mut self.enc, PEIR_R9, PEIR_R9);
    PeirEnc_xor_rr(&mut self.enc, PEIR_R11, PEIR_R11);
    var x: i64 = 0;
    while x < 6 {
        // xorps xmmx, xmmx
        PeirEnc_emit_u8(&mut self.enc, 0x0F);
        PeirEnc_emit_u8(&mut self.enc, 0x57);
        PeirEnc_emit_u8(&mut self.enc, 0xC0 | (x << 3) | x);
        x = x + 1;
    }
}

fn peir_bit(v: &Vec<i64>, id: i64) -> bool {
    return id >= 0 && id < v.len() && v.get(id) != 0;
}

/// OP13: may an address of this function's frame be kept beyond it? The
/// values that are frame addresses are the allocas and what is computed
/// from them (field and element addresses, casts, arithmetic). Loading
/// through one, storing through one and struct copies keep it in the
/// frame; anything else that reads one (a call argument, a stored value,
/// a returned value) lets it out, and then no call may replace the frame.
fn peir_frame_escapes(func: &IrFunction, nvals: i64) -> bool {
    var addr: Vec<i64> = peir_zeros(nvals);
    var any: bool = false;
    var changed: bool = true;
    var npass: i64 = 0;
    while changed {
        if npass >= 8 {
            return true;
        }
        changed = false;
        var i: i64 = 0;
        while i < func.insts.len() {
            var ve: ValueIdInst = func.insts.get(i);
            var mark: bool = false;
            match ve.inst {
                Inst::Alloca(_, _) => {
                    mark = true;
                }
                Inst::GetFieldPtr(p, _, _) => {
                    mark = peir_bit(&addr, p);
                }
                Inst::GetElemPtr(p, x, _) => {
                    mark = peir_bit(&addr, p) || peir_bit(&addr, x);
                }
                Inst::BitCast(p, _, _) => {
                    mark = peir_bit(&addr, p);
                }
                Inst::IntExtend(p, _, _) => {
                    mark = peir_bit(&addr, p);
                }
                Inst::IntTrunc(p, _, _) => {
                    mark = peir_bit(&addr, p);
                }
                Inst::BinOp(_, l, r, _) => {
                    mark = peir_bit(&addr, l) || peir_bit(&addr, r);
                }
                _ => {
                }
            }
            if mark {
                if ve.id < 0 || ve.id >= nvals {
                    return true;
                }
                if addr.get(ve.id) == 0 {
                    addr.set(ve.id, 1);
                    changed = true;
                    any = true;
                }
            }
            i = i + 1;
        }
        npass = npass + 1;
    }
    if !any {
        return false;
    }
    var ops: Vec<i64> = Vec::new();
    var j: i64 = 0;
    while j < func.insts.len() {
        var ue: ValueIdInst = func.insts.get(j);
        var ok: bool = false;
        match ue.inst {
            Inst::Load(_, _) => {
                ok = true;
            }
            Inst::Store(_, v, _) => {
                if peir_bit(&addr, v) {
                    return true;
                }
                ok = true;
            }
            Inst::StructCopy(_, _, _) => {
                ok = true;
            }
            Inst::GetFieldPtr(_, _, _) => {
                ok = true;
            }
            Inst::GetElemPtr(_, _, _) => {
                ok = true;
            }
            Inst::BitCast(_, _, _) => {
                ok = true;
            }
            Inst::IntExtend(_, _, _) => {
                ok = true;
            }
            Inst::IntTrunc(_, _, _) => {
                ok = true;
            }
            Inst::BinOp(_, _, _, _) => {
                ok = true;
            }
            _ => {
            }
        }
        if !ok {
            peir_inst_operands(ue.inst, &mut ops);
            var k: i64 = 0;
            while k < ops.len() {
                if peir_bit(&addr, ops.get(k)) {
                    return true;
                }
                k = k + 1;
            }
            ops.clear();
        }
        j = j + 1;
    }
    return false;
}

/// OP15: the block's last instruction leaves it (it never falls into the
/// block after it in the IR).
fn peir_block_ends(func: &IrFunction, blk: BasicBlock) -> bool {
    var n: i64 = blk.instructions.len();
    if n == 0 {
        return false;
    }
    match IrFunction_get_inst(func, blk.instructions.get(n - 1)) {
        OptInst::Some(li) => {
            match li {
                Inst::Jump(_) => {
                    return true;
                }
                Inst::Branch(_, _, _) => {
                    return true;
                }
                Inst::Switch(_, _, _, _) => {
                    return true;
                }
                Inst::Return(_) => {
                    return true;
                }
                Inst::Unreachable => {
                    return true;
                }
                _ => {
                    return false;
                }
            }
        }
        OptInst::None => {
            return false;
        }
    }
}

/// OP15: is `name` a function that only panics?
fn PeirGen_is_cold_fn(self: &PeirGen, name: str) -> bool {
    // OP15: `@cold` functions and core's cold_path() (compiler/ast.fd)
    return name == "p_panic" || name == "panic" || HashMap_contains(self.cold_fns, name) || is_cold_fn_hint(name);
}

/// OP15: a cold block: it panics (a panic instruction, a call to a
/// function that only panics), calls a function the program marks
/// unlikely (`@cold`, core's `cold_path()`: PeirGen_is_cold_fn), or
/// cannot be reached (Unreachable). A panic path is the unlikely side of
/// every check, as in nat_ir's ng_cold_last. OP30: with `--profile-use`,
/// also a block the profiled run never or rarely entered (pgo_block_cold).
fn PeirGen_block_cold(self: &PeirGen, func: &IrFunction, blk: BasicBlock) -> bool {
    if g_pgo_use_path != "" && pgo_block_cold(func.name, blk.id) {
        return true;
    }
    var i: i64 = 0;
    while i < blk.instructions.len() {
        match IrFunction_get_inst(func, blk.instructions.get(i)) {
            OptInst::Some(inst) => {
                match inst {
                    Inst::Panic(_) => {
                        return true;
                    }
                    Inst::Unreachable => {
                        return true;
                    }
                    Inst::Call(cn, _, _, _) => {
                        if PeirGen_is_cold_fn(self, cn) {
                            return true;
                        }
                    }
                    _ => {
                    }
                }
            }
            OptInst::None => {
            }
        }
        i = i + 1;
    }
    return false;
}

/// OP15: the order the blocks are laid out in: the entry first, the other
/// blocks in IR order, cold blocks last. A block moves only when it and
/// the block before it in the IR both end in a jump, a branch, a return
/// or Unreachable (nothing falls into it, and it falls into nothing);
/// jumps to the block laid out next are still left out (next_block).
fn PeirGen_block_order(self: &PeirGen, func: &IrFunction) -> Vec<i64> {
    var hot: Vec<i64> = Vec::new();
    var cold: Vec<i64> = Vec::new();
    var on: bool = peir_on("layout");
    var n: i64 = func.blocks.len();
    var bi: i64 = 0;
    while bi < n {
        var moved: bool = false;
        if on && bi > 0 {
            var blk: BasicBlock = func.blocks.get(bi);
            if peir_block_ends(func, blk) && peir_block_ends(func, func.blocks.get(bi - 1)) && PeirGen_block_cold(self, func, blk) {
                moved = true;
            }
        }
        if moved {
            cold.push(bi);
        } else {
            hot.push(bi);
        }
        bi = bi + 1;
    }
    var ci: i64 = 0;
    while ci < cold.len() {
        hot.push(cold.get(ci));
        ci = ci + 1;
    }
    return hot;
}

/// OP15: the functions that only panic: some block panics and every block
/// that returns panics first (core's `panic`, a program's `fail(msg)`).
/// Two rounds, so a function that only calls one of them counts too.
fn PeirGen_find_cold_fns(self: &mut PeirGen, module: &IrModule) {
    var round: i64 = 0;
    while round < 2 {
        var fi: i64 = 0;
        while fi < module.functions.len() {
            var fname: str = module.functions.get(fi).name;
            if !HashMap_contains(self.cold_fns, fname) {
                var f: IrFunction = module.functions.get(fi).func;
                var panics: bool = false;
                var ok: bool = f.blocks.len() > 0;
                var b: i64 = 0;
                while b < f.blocks.len() && ok {
                    var blk: BasicBlock = f.blocks.get(b);
                    var bp: bool = false;
                    var ret: bool = false;
                    var k: i64 = 0;
                    while k < blk.instructions.len() {
                        match IrFunction_get_inst(&f, blk.instructions.get(k)) {
                            OptInst::Some(inst) => {
                                match inst {
                                    Inst::Panic(_) => {
                                        bp = true;
                                    }
                                    Inst::Call(cn, _, _, _) => {
                                        if PeirGen_is_cold_fn(self, cn) {
                                            bp = true;
                                        }
                                    }
                                    Inst::Return(_) => {
                                        ret = true;
                                    }
                                    _ => {
                                    }
                                }
                            }
                            OptInst::None => {
                            }
                        }
                        k = k + 1;
                    }
                    if bp {
                        panics = true;
                    }
                    if ret && !bp {
                        ok = false;
                    }
                    b = b + 1;
                }
                if panics && ok {
                    HashMap_insert(self.cold_fns, fname, 1);
                }
            }
            fi = fi + 1;
        }
        round = round + 1;
    }
}

/// DB3: the source line of instruction `id` (0: none).
fn peir_inst_line(func: &IrFunction, id: i64) -> i64 {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => {
            match m.source_line {
                OptU64::Some(v) => {
                    return v as i64;
                }
                OptU64::None => {
                }
            }
        }
        OptValueMeta::None => {
        }
    }
    return 0;
}

/// DB3: a debug build (`fid emit --debug` / `-g`, or FID_PE_DEBUG=1)
/// writes line tables for the functions of the input file. main.fd calls
/// this with the input's source before pe_ir_generate_pe.
pub fn pe_lines_setup(source: str, input: str) {
    var lx: Lexer = Lexer::new(source);
    var ps: Parser = Parser_new(lx.tokenize());
    match ps.parse() {
        ParseResultProgram::Ok(prog) => {
            var names: Vec<str> = Vec::new();
            // N9: each function's `fn` line (its first line row)
            g_pe_lines_decl = HashMap_new();
            var i: i64 = 0;
            while i < prog.funcs.len() {
                names.push(prog.funcs.get(i).name);
                HashMap_insert(g_pe_lines_decl, prog.funcs.get(i).name, prog.funcs.get(i).line);
                i = i + 1;
            }
            g_pe_lines_names = str_join(names, ",");
            g_pe_lines_file = input;
            // N9: a debug build keeps every value in its frame slot (pe_ir
            // without its register allocator, as FID_PE_OFF=ra), so the
            // debugger finds each variable in one place for the whole
            // function; FID_PE_DEBUG_RA=1 keeps the allocator (variables
            // held in registers then show as optimized out)
            if peir_on("dbgvars") && str_len(env_or_empty("FID_PE_DEBUG_RA")) == 0 && peir_on("ra") {
                g_peir_off = g_peir_off + "ra,";
            }
        }
        ParseResultProgram::Err(_) => {
        }
    }
}

// --- N9: variables of a debug build (DB4 for pe_ir) ------------------------
// pe_ir_enc.fd pe_add_dwarf writes them with nat_enc.fd's DWARF writer; the
// formats are nat_enc.fd's g_nat_dbg_vars and g_nat_dbg_types. The type
// descriptions follow compiler/nat_ir.fd's (ng_dbg_var_type,
// ng_dbg_type_descs), which pe_ir cannot reach (nat_ir is not imported
// here).

/// N9: per function of a debug build (PeirGen.dbg_names' order), its
/// parameters and variables in g_nat_dbg_vars' format
/// (PeirGen_dbg_vars_note); "" until noted.
pub var g_pe_dbg_vars: Vec<str> = Vec::new();
/// N9: function name -> the line of its `fn` (pe_lines_setup); 0: none.
pub var g_pe_lines_decl: i64 = 0;

/// N9: the `fn` line of function `name` of the input file (0: unknown).
fn peir_dbg_decl_line(name: str) -> i64 {
    if g_pe_lines_decl == 0 || !HashMap_contains(g_pe_lines_decl, name) {
        return 0;
    }
    return HashMap_get(g_pe_lines_decl, name);
}

fn peir_dbg_type_name(t: IrType) -> str {
    var s: str = ir_type_to_str(t);
    s = str_replace(s, "struct.", "");
    s = str_replace(s, "opaque.", "");
    return str_replace(s, "generic.", "");
}

/// The DWARF encoding of a scalar: 2 boolean, 4 float, 5 signed, 7
/// unsigned (and anything held as a word: a handle, a pointer).
fn peir_dbg_encoding(t: IrType) -> i64 {
    if ir_type_eq(t, IrType::Bool) {
        return 2;
    }
    if ir_type_is_float(t) {
        return 4;
    }
    if ir_type_is_signed(t) {
        return 5;
    }
    return 7;
}

/// A `str` (the IR's pointer to u8): described as text.
fn peir_dbg_is_str(t: IrType) -> bool {
    match t {
        IrType::Ptr(inner) => {
            return ir_type_eq(box_ir_type_unbox(inner), IrType::U8);
        }
        _ => {
        }
    }
    return false;
}

/// The struct of the module a word of type `t` holds the address of
/// ("" when none).
fn peir_dbg_held_struct(module: &IrModule, t: IrType) -> str {
    match t {
        IrType::Struct(sn) => {
            if HashMap_contains(module.struct_index, sn) {
                return sn;
            }
        }
        IrType::Ptr(inner) => {
            var it: IrType = box_ir_type_unbox(inner);
            match it {
                IrType::Struct(sn2) => {
                    if HashMap_contains(module.struct_index, sn2) {
                        return sn2;
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return "";
}

/// N9: a variable's type for g_nat_dbg_vars: name, byte size, encoding
/// ("S" a struct held inline, "P" a pointer to a struct, "Z" a str, else
/// the scalar's DWARF encoding), separated by tabs.
fn peir_dbg_var_type(module: &IrModule, t: IrType) -> str {
    match t {
        IrType::Struct(sn) => {
            return sn + "\t" + int_to_str(IrModule_type_size(module, t)) + "\tS";
        }
        IrType::Ptr(inner) => {
            var it: IrType = box_ir_type_unbox(inner);
            match it {
                IrType::Struct(sn2) => {
                    return sn2 + "\t8\tP";
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    if peir_dbg_is_str(t) {
        return "str\t8\tZ";
    }
    var size: i64 = IrModule_type_size(module, t);
    if size <= 0 || size > 8 {
        size = 8;
    }
    return peir_dbg_type_name(t) + "\t" + int_to_str(size) + "\t" + int_to_str(peir_dbg_encoding(t));
}

/// N9: the module's struct types in g_nat_dbg_types' format (name, size,
/// then per field its name, offset, type name, size and encoding): a
/// field's size is the distance to the next field; a field that size of
/// a struct of the module holds it inline ("S").
pub fn peir_dbg_type_descs(module: &IrModule) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < module.struct_layouts.len() {
        var lay: StructLayout = module.struct_layouts.get(i).layout;
        var d: str = module.struct_layouts.get(i).name + "\t" + int_to_str(lay.size);
        var f: i64 = 0;
        while f < lay.fields.len() {
            var fl: StringIrTypeOffset = lay.fields.get(f);
            var end: i64 = lay.size;
            if f + 1 < lay.fields.len() {
                end = lay.fields.get(f + 1).offset;
            }
            var size: i64 = end - fl.offset;
            var tname: str = peir_dbg_type_name(fl.ty);
            var enc: str = int_to_str(peir_dbg_encoding(fl.ty));
            var inline_struct: bool = false;
            match fl.ty {
                IrType::Struct(sn) => {
                    if HashMap_contains(module.struct_index, sn) {
                        var si: i64 = HashMap_get(module.struct_index, sn) - 1;
                        if si >= 0 && si < module.struct_layouts.len() && module.struct_layouts.get(si).layout.size == size && size > 0 {
                            inline_struct = true;
                        }
                    }
                }
                _ => {
                }
            }
            if inline_struct {
                enc = "S";
            } else {
                if size > 8 || size <= 0 {
                    size = 8;
                }
                var sc: i64 = ir_type_size(fl.ty);
                if sc > 0 && sc < size {
                    size = sc;
                }
                var held: str = peir_dbg_held_struct(module, fl.ty);
                if peir_dbg_is_str(fl.ty) {
                    tname = "str";
                    enc = "Z";
                    size = 8;
                } else if str_len(held) > 0 && end - fl.offset == 8 {
                    tname = held;
                    enc = "P";
                    size = 8;
                }
            }
            d = d + "\t" + fl.name + "\t" + int_to_str(fl.offset) + "\t" + tname + "\t" + int_to_str(size) + "\t" + enc;
            f = f + 1;
        }
        out.push(d);
        i = i + 1;
    }
    return out;
}

/// N9: the values of `func` whose memory something may write (by id):
/// the pointer and value of a Store, and any value used other than as a
/// Load's pointer (its address escapes). An alloca nothing writes never
/// holds its variable (the slot is shown only when something does).
/// Known-bugs 2g.104: only the instructions of the blocks count. The IR
/// optimizer takes an instruction out of its block and leaves it in
/// func.insts: `-g` showed main's `total`, `shown` and `sum` at slots
/// whose stores the mid-end had forwarded away (0, a stack address).
fn peir_dbg_written(func: &IrFunction) -> i64 {
    var w: i64 = HashMap_new();
    var ops: Vec<i64> = Vec::new();
    var bi: i64 = 0;
    while bi < func.blocks.len() {
        var bids: Vec<i64> = func.blocks.get(bi).instructions;
        var i: i64 = 0;
        while i < bids.len() {
            match IrFunction_get_inst(func, bids.get(i)) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::Load(_, _) => {
                        }
                        Inst::Store(p, v, _) => {
                            HashMap_insert(w, int_to_str(p), 1);
                            HashMap_insert(w, int_to_str(v), 1);
                        }
                        _ => {
                            ops.clear();
                            peir_inst_operands(inst, &mut ops);
                            var k: i64 = 0;
                            while k < ops.len() {
                                HashMap_insert(w, int_to_str(ops.get(k)), 1);
                                k = k + 1;
                            }
                        }
                    }
                }
                OptInst::None => {
                }
            }
            i = i + 1;
        }
        bi = bi + 1;
    }
    return w;
}

/// N9 (2g.104): the ids of the instructions in `func`'s blocks (what is
/// generated); one only in func.insts was taken out by the IR optimizer.
fn peir_dbg_live(func: &IrFunction) -> i64 {
    var live: i64 = HashMap_new();
    var bi: i64 = 0;
    while bi < func.blocks.len() {
        var bids: Vec<i64> = func.blocks.get(bi).instructions;
        var i: i64 = 0;
        while i < bids.len() {
            HashMap_insert(live, int_to_str(bids.get(i)), 1);
            i = i + 1;
        }
        bi = bi + 1;
    }
    return live;
}

/// N9: where value `id` (a parameter or a value a variable is bound to)
/// is for the whole function: its constant ("c<v>"), its frame slot
/// ("f<off>", CFA-relative: rbp + o is CFA + o - 16), or "" (in a
/// register, or a parameter nothing reads, which the prologue does not
/// store).
fn PeirGen_dbg_value_loc(self: &PeirGen, frame: &PeStackFrame, id: i64, is_param: bool) -> str {
    if pe_idmap_has(&frame.const_vals, id) {
        return "c" + int_to_str(pe_idmap_get(&frame.const_vals, id));
    }
    if is_param && id >= 0 && id < self.use_count.len() && self.use_count.get(id) == 0 {
        return "";
    }
    if !pe_idmap_has(&frame.offsets, id) {
        return "";
    }
    var off: i64 = pe_idmap_get(&frame.offsets, id);
    if off >= 0 {
        return "";
    }
    return "f" + int_to_str(off - 16);
}

/// N9: the parameters and variables of the function just generated (the
/// last of self.dbg_names), from IrFunction.locals (each name with the
/// alloca or value it is bound to), into g_pe_dbg_vars: an alloca at its
/// data slot when something writes it, a value at its slot or constant
/// (PeirGen_dbg_value_loc), a value with no instruction (an alloca the IR
/// optimizer promoted away: `-g` keeps the mid-end) with no location. A
/// parameter the body copies is shown at the copy; hidden names (`__env`)
/// are left out. A name bound twice (shadowing) is listed twice, without
/// scopes. Called while `frame` is the function's laid-out frame.
fn PeirGen_dbg_vars_note(self: &mut PeirGen, func: &IrFunction, module: &IrModule, frame: &PeStackFrame) {
    var at: i64 = self.dbg_names.len() - 1;
    if at < 0 || g_pe_dbg_vars.len() != self.dbg_names.len() || !peir_on("dbgvars") {
        return;
    }
    var written: i64 = peir_dbg_written(func);
    var live: i64 = peir_dbg_live(func);
    var params: i64 = HashMap_new();
    var i: i64 = 0;
    while i < func.params.len() {
        HashMap_insert(params, int_to_str(func.params.get(i).id), i + 1);
        i = i + 1;
    }
    var entries: Vec<str> = Vec::new();
    var seen: i64 = HashMap_new();
    var pnames: i64 = HashMap_new();
    i = 0;
    while i < func.locals.len() {
        var lv: StringValueId = func.locals.get(i);
        var nm: str = lv.name;
        var id: i64 = lv.id;
        var key: str = nm + "\t" + int_to_str(id);
        if str_len(nm) > 0 && !str_starts_with(nm, "__") && !str_contains(nm, "\t") && !str_contains(nm, "\n") && !HashMap_contains(seen, key) {
            HashMap_insert(seen, key, 1);
            var tdesc: str = "";
            var loc: str = "";
            var is_alloca: bool = false;
            var gone: bool = true;
            // (an instruction out of every block is gone: 2g.104)
            match IrFunction_get_inst(func, id) {
                OptInst::Some(inst) => {
                    gone = !HashMap_contains(live, int_to_str(id));
                    match inst {
                        Inst::Alloca(aty, _) => {
                            is_alloca = true;
                            tdesc = peir_dbg_var_type(module, aty);
                            if !pe_idmap_has(&frame.reg_vars, id) && pe_idmap_has(&frame.alloca_slots, id) && HashMap_contains(written, int_to_str(id)) {
                                loc = "f" + int_to_str(pe_idmap_get(&frame.alloca_slots, id) - 16);
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            var pix: i64 = 0;
            if HashMap_contains(params, int_to_str(id)) {
                pix = HashMap_get(params, int_to_str(id));
            }
            if !is_alloca {
                if pix > 0 {
                    tdesc = peir_dbg_var_type(module, func.params.get(pix - 1).ty);
                    loc = PeirGen_dbg_value_loc(self, frame, id, true);
                } else if gone {
                    // promoted away by the IR optimizer: no one place; its
                    // type is what the alloca held
                    var pty: IrType = peir_operand_ty(func, id);
                    tdesc = peir_dbg_var_type(module, pty);
                    match pty {
                        IrType::Ptr(held) => {
                            tdesc = peir_dbg_var_type(module, box_ir_type_unbox(held));
                        }
                        _ => {
                        }
                    }
                } else {
                    tdesc = peir_dbg_var_type(module, peir_operand_ty(func, id));
                    loc = PeirGen_dbg_value_loc(self, frame, id, false);
                }
            }
            if HashMap_contains(pnames, nm) {
                // the body's copy of a parameter replaces it
                entries.set(HashMap_get(pnames, nm) - 1, "P\t" + nm + "\t" + tdesc + "\t" + loc);
            } else if pix > 0 {
                entries.push("P\t" + nm + "\t" + tdesc + "\t" + loc);
                HashMap_insert(pnames, nm, entries.len());
            } else {
                entries.push("V\t" + nm + "\t" + tdesc + "\t" + loc);
            }
        }
        i = i + 1;
    }
    g_pe_dbg_vars.set(at, str_join(entries, "\n"));
}

/// DB3: the functions pe_lines_setup named get line rows.
fn PeirGen_lines_start(self: &mut PeirGen) {
    if g_pe_lines_names == "" {
        return;
    }
    var names: Vec<str> = str_split(g_pe_lines_names, ",");
    var i: i64 = 0;
    while i < names.len() {
        HashMap_insert(self.line_fns, names.get(i), 1);
        i = i + 1;
    }
}

// --- B5: the per-function cache ----------------------------------------
// The late-link step of inc-roadmap B5 for the default Windows backend, as
// nat_ir's CS6 (FID_FNCACHE) is for the machine layer. FID_FNCACHE=<path>
// keeps, in <path>.pe, each generated function's code before its labels
// and .rdata references are resolved, with those references by name: a
// function, an arithmetic panic stub, a string (its text), a global, an
// import slot, the allocator's state. The key is the function's IR
// (iw_irfunc) and a salt of everything else its code depends on: struct
// layouts, globals, externs, every name that has a label, the C
// overrides, the named functions, the cold functions and FID_PE_OFF. A
// hit copies the bytes to wherever the function lands now and registers
// its references again; the image is laid out and linked afresh each
// build. Left out: @interrupt and @constant_time functions, asm!, dyn
// values (their type ids depend on the order functions are generated),
// functions that call something nobody defines, and debug builds.

/// B5: may `func`'s code come from the cache?
fn peir_fc_cacheable(func: &IrFunction) -> bool {
    if func.is_interrupt || func.is_constant_time || g_pe_lines_file != "" || env_or_empty("PE_DUMP_FN") != "" {
        return false;
    }
    var i: i64 = 0;
    while i < func.insts.len() {
        var ve: ValueIdInst = func.insts.get(i);
        match ve.inst {
            Inst::Asm(_, _, _, _) => {
                return false;
            }
            Inst::MakeDyn(_, _, _) => {
                return false;
            }
            Inst::DynCall(_, _, _, _, _) => {
                return false;
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return true;
}

@wrapping
fn peir_fc_hash(v: Vec<i64>, seed: i64) -> i64 {
    var h: i64 = seed * 1099511628211 + 1469598103934665603;
    var i: i64 = 0;
    while i < v.len() {
        h = (h ^ v.get(i)) * 1099511628211;
        i = i + 1;
    }
    return h;
}

/// B5: the key of `func` under `salt` (never 0).
fn peir_fc_key(func: IrFunction, salt: i64) -> i64 {
    var b: AwBuf = awbuf_new();
    iw_irfunc(&mut b, func);
    var bytes: Vec<i64> = b.bytes;
    var h: i64 = peir_fc_hash(bytes, salt);
    if h == 0 {
        h = 1;
    }
    return h;
}

/// B5: what besides its own IR a function's code depends on.
fn PeirGen_fc_salt(self: &PeirGen, module: &IrModule) -> i64 {
    var b: AwBuf = awbuf_new();
    // the compiler itself (its executable's hash): another compiler may
    // generate other code, or another runtime, for the same IR
    aw_str(&mut b, "pefc1;" + int_to_str(inc_compiler_hash()) + ";" + env_or_empty("FID_PE_OFF") + ";" + env_or_empty("FID_PE_CT_OFF") + ";");
    // code generation switches: --cpu (OP20: BMI forms), --checked-alloc
    aw_str(&mut b, "cpu=" + g_pe_cpu + ";");
    if g_pe_checked_alloc {
        aw_i64(&mut b, 11);
    }
    // RL16: --leaks
    if g_pe_leaks {
        aw_i64(&mut b, 12);
    }
    var i: i64 = 0;
    while i < module.struct_layouts.len() {
        var sl: StructLayout = module.struct_layouts.get(i).layout;
        aw_str(&mut b, sl.name);
        aw_i64(&mut b, sl.size);
        aw_i64(&mut b, sl.align);
        if sl.repr_c {
            aw_i64(&mut b, 1);
        }
        if sl.packed_layout {
            aw_i64(&mut b, 2);
        }
        var f: i64 = 0;
        while f < sl.fields.len() {
            var fd: StringIrTypeOffset = sl.fields.get(f);
            aw_str(&mut b, fd.name);
            aw_i64(&mut b, fd.offset);
            iw_irtype(&mut b, fd.ty);
            f = f + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < module.globals.len() {
        aw_str(&mut b, module.globals.get(i).name);
        iw_irtype(&mut b, module.globals.get(i).ty);
        i = i + 1;
    }
    i = 0;
    while i < module.extern_functions.len() {
        var ef: StringVecIrType = module.extern_functions.get(i);
        aw_str(&mut b, ef.name);
        iw_irtype(&mut b, ef.ret);
        var p: i64 = 0;
        while p < ef.params.len() {
            iw_irtype(&mut b, ef.params.get(p));
            p = p + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < module.extern_decls.len() {
        aw_str(&mut b, module.extern_decls.get(i).pledge_name);
        aw_str(&mut b, module.extern_decls.get(i).c_name);
        i = i + 1;
    }
    var rev: Vec<str> = self.fc_rev;
    i = 0;
    while i < rev.len() {
        aw_str(&mut b, rev.get(i));
        i = i + 1;
    }
    var ovs: Vec<COverride> = self.c_overrides;
    i = 0;
    while i < ovs.len() {
        aw_str(&mut b, ovs.get(i).name);
        aw_str(&mut b, ovs.get(i).over);
        i = i + 1;
    }
    var nfs: Vec<str> = self.named_fns;
    i = 0;
    while i < nfs.len() {
        aw_str(&mut b, nfs.get(i));
        i = i + 1;
    }
    var mfs: Vec<str> = self.module_fns;
    i = 0;
    while i < mfs.len() {
        if PeirGen_is_cold_fn(self, mfs.get(i)) {
            aw_str(&mut b, mfs.get(i));
        }
        i = i + 1;
    }
    var bytes: Vec<i64> = b.bytes;
    return peir_fc_hash(bytes, 7);
}

/// B5: what lives at .rdata offset `off`, for the cache's references.
fn PeirGen_fc_rip_add(self: &mut PeirGen, off: i64, kind: i64, k: i64, s: str) {
    var key: str = int_to_str(off);
    if HashMap_contains(self.fc_rip, key) {
        return;
    }
    self.fc_rip_kind.push(kind);
    self.fc_rip_k.push(k);
    self.fc_rip_s.push(s);
    HashMap_insert(self.fc_rip, key, self.fc_rip_kind.len());
}

/// B5: the cache is on by default for a Windows `fid emit`/`fid build`:
/// its file is `<output>.fides-fncache.pe`, beside the output as the
/// build stamp `<output>.fides-stamp` is. FID_FNCACHE=<path> puts it at
/// `<path>.pe` instead; FID_FNCACHE=0 (or off, no, none, false),
/// FIDES_NO_CACHE=1, `--no-cache` or `--no-fncache` turn it off. "" when
/// it is off or the output is unknown.
fn pe_fc_base_path() -> str {
    var v: str = env_or_empty("FID_FNCACHE");
    if v == "0" || v == "off" || v == "no" || v == "none" || v == "false" {
        return "";
    }
    var n: i64 = argv_count();
    var i: i64 = 1;
    while i < n {
        var a: str = argv_at(i);
        if a == "--no-fncache" {
            return "";
        }
        i = i + 1;
    }
    if str_len(v) > 0 {
        return v;
    }
    if str_len(env_or_empty("FIDES_NO_CACHE")) > 0 {
        return "";
    }
    i = 1;
    while i < n {
        if argv_at(i) == "--no-cache" {
            return "";
        }
        i = i + 1;
    }
    var out: str = pe_fc_output();
    if str_len(out) == 0 {
        return "";
    }
    return out + ".fides-fncache";
}

/// B5: the output of this build: what the driver recorded
/// (pe_set_output_path), else the `-o` of an `emit`/`build` command line.
fn pe_fc_output() -> str {
    if str_len(g_pe_out_path) > 0 {
        return g_pe_out_path;
    }
    var n: i64 = argv_count();
    if n < 2 {
        return "";
    }
    var cmd: str = argv_at(1);
    if cmd != "emit" && cmd != "build" {
        return "";
    }
    var i: i64 = 2;
    while i + 1 < n {
        if argv_at(i) == "-o" {
            var o: str = argv_at(i + 1);
            if !str_ends_with(o, ".exe") {
                o = o + ".exe";
            }
            return o;
        }
        i = i + 1;
    }
    return "";
}

/// B5: turn the cache on (by default, or FID_FNCACHE: pe_fc_base_path; a
/// Windows image, not a debug build), once every label the functions may refer to exists: names for
/// labels and .rdata offsets, the salt, the cache file.
fn PeirGen_fc_start(self: &mut PeirGen, module: &IrModule, all_strings: Vec<str>, global_names: Vec<str>) {
    var path: str = pe_fc_base_path();
    if str_len(path) == 0 || self.bare_mode || g_pe_lines_file != "" {
        return;
    }
    var rev: Vec<str> = Vec::new();
    while rev.len() < self.enc.next_label {
        rev.push("");
    }
    var cands: Vec<str> = Vec::new();
    var mfs: Vec<str> = self.module_fns;
    var i: i64 = 0;
    while i < mfs.len() {
        cands.push(mfs.get(i));
        i = i + 1;
    }
    var stubs: Vec<str> = pe_runtime_stub_names();
    i = 0;
    while i < stubs.len() {
        cands.push(stubs.get(i));
        i = i + 1;
    }
    var prims: Vec<str> = pe_primitive_names();
    i = 0;
    while i < prims.len() {
        cands.push(prims.get(i));
        i = i + 1;
    }
    var deps: Vec<PeirStrPair> = pe_stub_deps();
    i = 0;
    while i < deps.len() {
        cands.push(deps.get(i).a);
        i = i + 1;
    }
    i = 0;
    while i < module.extern_decls.len() {
        cands.push(module.extern_decls.get(i).pledge_name);
        i = i + 1;
    }
    var thunks: Vec<CThunk> = self.c_thunks;
    i = 0;
    while i < thunks.len() {
        cands.push(thunks.get(i).name);
        i = i + 1;
    }
    var adapters: Vec<CAdapter> = self.c_adapters;
    i = 0;
    while i < adapters.len() {
        cands.push(adapters.get(i).name);
        i = i + 1;
    }
    var sexts: Vec<str> = self.stub_externs;
    i = 0;
    while i < sexts.len() {
        cands.push(sexts.get(i));
        i = i + 1;
    }
    i = 0;
    while i < cands.len() {
        var nm: str = cands.get(i);
        if HashMap_contains(self.func_labels, nm) {
            var l: i64 = HashMap_get(self.func_labels, nm);
            if l >= 0 && l < rev.len() && rev.get(l) == "" {
                rev.set(l, nm);
            }
        }
        i = i + 1;
    }
    self.fc_rev = rev;
    i = 0;
    while i < all_strings.len() {
        var s: str = all_strings.get(i);
        if HashMap_contains(self.string_rdata_offsets, s) {
            PeirGen_fc_rip_add(self, HashMap_get(self.string_rdata_offsets, s), PEFC_STR, 0, s);
        }
        i = i + 1;
    }
    i = 0;
    while i < global_names.len() {
        var g: str = global_names.get(i);
        if HashMap_contains(self.global_rdata_offsets, g) {
            PeirGen_fc_rip_add(self, HashMap_get(self.global_rdata_offsets, g), PEFC_GLOBAL, 0, g);
        }
        i = i + 1;
    }
    var iats: Vec<i64> = self.iat_rdata_offsets;
    i = 0;
    while i < iats.len() {
        PeirGen_fc_rip_add(self, iats.get(i), PEFC_IAT, i, "");
        i = i + 1;
    }
    i = 0;
    while i < PEIR_ALLOC_STATE_SIZE {
        PeirGen_fc_rip_add(self, self.alloc_rdata_off + i, PEFC_ALLOC, i, "");
        i = i + 1;
    }
    self.fc_salt = PeirGen_fc_salt(self, module);
    self.fc_path = path + ".pe";
    self.fc_on = true;
    g_pe_fc_reemit = Vec::new();
    // (p_file_exists is i64 to the type checker: tested alone in an `if`)
    if p_file_exists(self.fc_path) {
        PeirGen_fc_load(self);
    }
}

fn pefc_fix(pos: i64, kind: i64, tkind: i64, toff: i64, tstr: str) -> PeFcFix {
    return PeFcFix {
        pos: pos, kind: kind, tkind: tkind, toff: toff, tstr: tstr
    };
}

/// B5: keep the code just generated for `name` [start, end of code), when
/// every reference it makes has a name.
fn PeirGen_fc_capture(self: &mut PeirGen, name: str, key: i64, start: i64, pl0: i64, rr0: i64, lab0: i64, unres0: i64) {
    if self.unres_adds != unres0 {
        return;
    }
    var end: i64 = self.enc.code.len();
    var fixes: Vec<PeFcFix> = Vec::new();
    var i: i64 = pl0;
    while i < self.enc.pending_labels.len() {
        var r: PeirReloc = self.enc.pending_labels.get(i);
        if r.code_offset < start || r.code_offset + 4 > end {
            return;
        }
        var t: i64 = r.target_label;
        if t >= lab0 {
            if t >= self.enc.labels.len() {
                return;
            }
            var tp: i64 = self.enc.labels.get(t);
            if tp < start || tp > end {
                return;
            }
            fixes.push(pefc_fix(r.code_offset - start, r.kind, PEFC_LOCAL, tp - start, ""));
        } else if t >= 0 && t < self.fc_rev.len() && self.fc_rev.get(t) != "" {
            fixes.push(pefc_fix(r.code_offset - start, r.kind, PEFC_NAME, 0, self.fc_rev.get(t)));
        } else if t == self.crash_filter {
            fixes.push(pefc_fix(r.code_offset - start, r.kind, PEFC_CRASH, 0, ""));
        } else {
            var ap: i64 = -1;
            var k: i64 = 0;
            while k < self.arith_panics.len() {
                if self.arith_panics.get(k) == t {
                    ap = k;
                }
                k = k + 1;
            }
            if ap < 0 {
                return;
            }
            fixes.push(pefc_fix(r.code_offset - start, r.kind, PEFC_PANIC, ap, ""));
        }
        i = i + 1;
    }
    i = rr0;
    while i < self.enc.pending_rip_refs.len() {
        var rr: PeirRipRef = self.enc.pending_rip_refs.get(i);
        if rr.code_offset < start || rr.code_offset + 4 > end {
            return;
        }
        var key2: str = int_to_str(rr.rdata_offset);
        if !HashMap_contains(self.fc_rip, key2) {
            return;
        }
        var ix: i64 = HashMap_get(self.fc_rip, key2) - 1;
        fixes.push(pefc_fix(rr.code_offset - start, -1, self.fc_rip_kind.get(ix), self.fc_rip_k.get(ix), self.fc_rip_s.get(ix)));
        i = i + 1;
    }
    var bytes: Vec<i64> = Vec::new();
    var c: i64 = start;
    while c < end {
        bytes.push(self.enc.code.get(c));
        c = c + 1;
    }
    self.fc_new.push(PeFcEntry {
        name: name, key: key, bytes: bytes, fixes: fixes
    });
}

/// B5: the label (or .rdata offset) a cached reference names in this
/// build: -1 for a label inside the function (made when replayed), -2
/// when the name is gone (the entry cannot be used).
fn PeirGen_fc_target(self: &PeirGen, fx: PeFcFix) -> i64 {
    if fx.tkind == PEFC_LOCAL {
        return -1;
    }
    if fx.tkind == PEFC_NAME {
        if HashMap_contains(self.func_labels, fx.tstr) {
            return HashMap_get(self.func_labels, fx.tstr);
        }
        return -2;
    }
    if fx.tkind == PEFC_PANIC {
        if fx.toff >= 0 && fx.toff < self.arith_panics.len() {
            return self.arith_panics.get(fx.toff);
        }
        return -2;
    }
    if fx.tkind == PEFC_CRASH {
        return self.crash_filter;
    }
    if fx.tkind == PEFC_STR {
        if HashMap_contains(self.string_rdata_offsets, fx.tstr) {
            return HashMap_get(self.string_rdata_offsets, fx.tstr);
        }
        return -2;
    }
    if fx.tkind == PEFC_GLOBAL {
        if HashMap_contains(self.global_rdata_offsets, fx.tstr) {
            return HashMap_get(self.global_rdata_offsets, fx.tstr);
        }
        return -2;
    }
    if fx.tkind == PEFC_IAT {
        if fx.toff >= 0 && fx.toff < self.iat_rdata_offsets.len() {
            return self.iat_rdata_offsets.get(fx.toff);
        }
        return -2;
    }
    if fx.tkind == PEFC_ALLOC {
        return self.alloc_rdata_off + fx.toff;
    }
    return -2;
}

/// B5: place `name` from the cache when its entry has `key` and all it
/// refers to exists; false: generate it.
fn PeirGen_fc_replay(self: &mut PeirGen, name: str, key: i64) -> bool {
    if !HashMap_contains(self.fc_ix, name) {
        return false;
    }
    var e: PeFcEntry = self.fc_old.get(HashMap_get(self.fc_ix, name) - 1);
    if e.key != key {
        return false;
    }
    var tgt: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < e.fixes.len() {
        var v: i64 = PeirGen_fc_target(self, e.fixes.get(i));
        if v == -2 {
            return false;
        }
        tgt.push(v);
        i = i + 1;
    }
    self.cur_func = name;
    var label: i64 = HashMap_get(self.func_labels, name);
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, label);
    var base: i64 = self.enc.code.len();
    PeirEnc_emit_bytes(&mut self.enc, e.bytes);
    i = 0;
    while i < e.fixes.len() {
        var fx: PeFcFix = e.fixes.get(i);
        if fx.kind < 0 {
            PeirEnc_add_rip_ref(&mut self.enc, base + fx.pos, tgt.get(i));
        } else {
            var lab: i64 = tgt.get(i);
            if fx.tkind == PEFC_LOCAL {
                lab = PeirEnc_alloc_label(&mut self.enc);
                PeirEnc_set_label(&mut self.enc, lab, base + fx.toff);
            }
            PeirEnc_add_reloc(&mut self.enc, base + fx.pos, lab, fx.kind);
        }
        i = i + 1;
    }
    self.fc_new.push(e);
    return true;
}

const PEFC_MAGIC: i64 = 0x4346455044494601;
const PEFC_VERSION: i64 = 1;

fn PeirGen_fc_load(self: &mut PeirGen) {
    var vb: Vec<i64> = p_file_read_bytes(self.fc_path);
    if vb.len() < 32 {
        return;
    }
    var r: ArBuf = arbuf_new(vb);
    if ar_i64(&mut r) != PEFC_MAGIC || ar_i64(&mut r) != PEFC_VERSION || ar_i64(&mut r) != self.fc_salt {
        return;
    }
    var count: i64 = ar_i64(&mut r);
    var i: i64 = 0;
    while i < count && r.ok {
        var name: str = ar_str(&mut r);
        var key: i64 = ar_i64(&mut r);
        var nb: i64 = ar_i64(&mut r);
        if !r.ok || nb < 0 || nb > vb.len() {
            return;
        }
        var bytes: Vec<i64> = Vec::new();
        var b: i64 = 0;
        while b < nb {
            bytes.push(ar_u8(&mut r));
            b = b + 1;
        }
        var nf: i64 = ar_i64(&mut r);
        if !r.ok || nf < 0 || nf > vb.len() {
            return;
        }
        var fixes: Vec<PeFcFix> = Vec::new();
        var f: i64 = 0;
        while f < nf {
            var pos: i64 = ar_i64(&mut r);
            var kind: i64 = ar_i64(&mut r);
            var tkind: i64 = ar_i64(&mut r);
            var toff: i64 = ar_i64(&mut r);
            var tstr: str = ar_str(&mut r);
            if pos < 0 || pos + 4 > nb {
                return;
            }
            fixes.push(pefc_fix(pos, kind, tkind, toff, tstr));
            f = f + 1;
        }
        if !r.ok {
            return;
        }
        self.fc_old.push(PeFcEntry {
            name: name, key: key, bytes: bytes, fixes: fixes
        });
        HashMap_insert(self.fc_ix, name, self.fc_old.len());
        i = i + 1;
    }
}

/// B5: write the entries this build used or made (others drop out).
fn PeirGen_fc_finish(self: &mut PeirGen) {
    if !self.fc_on {
        return;
    }
    var b: AwBuf = awbuf_new();
    aw_i64(&mut b, PEFC_MAGIC);
    aw_i64(&mut b, PEFC_VERSION);
    aw_i64(&mut b, self.fc_salt);
    var ents: Vec<PeFcEntry> = self.fc_new;
    aw_i64(&mut b, ents.len());
    var i: i64 = 0;
    while i < ents.len() {
        var e: PeFcEntry = ents.get(i);
        aw_str(&mut b, e.name);
        aw_i64(&mut b, e.key);
        aw_i64(&mut b, e.bytes.len());
        var k: i64 = 0;
        while k < e.bytes.len() {
            aw_u8(&mut b, e.bytes.get(k));
            k = k + 1;
        }
        aw_i64(&mut b, e.fixes.len());
        var f: i64 = 0;
        while f < e.fixes.len() {
            var fx: PeFcFix = e.fixes.get(f);
            aw_i64(&mut b, fx.pos);
            aw_i64(&mut b, fx.kind);
            aw_i64(&mut b, fx.tkind);
            aw_i64(&mut b, fx.toff);
            aw_str(&mut b, fx.tstr);
            f = f + 1;
        }
        i = i + 1;
    }
    p_file_write_vec(self.fc_path, b.bytes);
    if env_or_empty("FID_PE_FNCACHE_STATS") != "" {
        p_eprint_str("[pe] fncache: " + int_to_str(self.fc_hits) + " hits, " + int_to_str(self.fc_misses) + " misses\n");
        if g_pe_fc_reemit.len() > 0 {
            p_eprint_str("[pe] fncache re-emitted: " + str_join(g_pe_fc_reemit, ", ") + "\n");
        }
    }
}

/// CB3: the functions this build generated again (cache misses), in order,
/// for FID_PE_FNCACHE_STATS's log.
var g_pe_fc_reemit: Vec<str> = Vec::new();

/// B5: generate `func`, or place its code from the cache.
fn PeirGen_gen_cached(self: &mut PeirGen, name: str, func: IrFunction, module: &IrModule) {
    self.fc_key = 0;
    if self.fc_on && peir_fc_cacheable(&func) {
        var key: i64 = peir_fc_key(func, self.fc_salt);
        if PeirGen_fc_replay(self, name, key) {
            self.fc_hits = self.fc_hits + 1;
            return;
        }
        self.fc_misses = self.fc_misses + 1;
        g_pe_fc_reemit.push(name);
        self.fc_key = key;
    }
    PeirGen_gen_function(self, name, &func, module);
}

// ===========================================================================
// pe_ir_generate_pe (src/pe.rs) — public entry point
// ===========================================================================

/// Public entry point: generate a PE file from an IR module. Fails when the
/// program calls runtime functions this native backend does not provide.
/// `fid emit --bare` (release G2): a flat x86-64 binary, no OS and no C
/// library. `panic_handler` is the program's @panic_handler function, or "".
pub fn pe_ir_generate_flat(module: IrModule, panic_handler: str) -> ResultBytes {
    if !pe_module_has_fn(&module, "main") {
        return ResultBytes::Err(c_vec1("bare-metal build: the program has no `main` function"));
    }
    g_pe_bare_panic_handler = panic_handler;
    g_pe_asm_errors = Vec::new();
    g_pe_ct_errors = Vec::new();
    var gen: PeirGen = PeirGen_new();
    gen.bare_mode = true;
    // A bootable image is loaded at g_pe_bare_boot_load (release G1)
    var saved_load: i64 = g_pe_bare_load;
    if pe_bare_boot_on() {
        if g_pe_bare_boot_load < 0x100000 || g_pe_bare_boot_load % PE_SECTION_ALIGN != 0 || g_pe_bare_boot_load + 0x1000000 > 0xFFFFFFFF {
            return ResultBytes::Err(c_vec1("bare-metal build: the load address must be 4 KB aligned, at or above 0x100000 (below it are the boot tables) and below 0xFF000000"));
        }
        g_pe_bare_load = g_pe_bare_boot_load;
    }
    var bytes: Vec = PeirGen_generate(&mut gen, &module);
    g_pe_bare_load = saved_load;
    if pe_bare_boot_on() && g_pe_bare_boot_load < g_pe_bare_heap && g_pe_bare_boot_load + bytes.len() > g_pe_bare_heap {
        return ResultBytes::Err(c_vec1("bare-metal build: the image (" + int_to_str(bytes.len()) + " bytes) loaded at " + "0x" + int_to_hex(g_pe_bare_boot_load) + " runs into the heap at " + "0x" + int_to_hex(g_pe_bare_heap) + ": give a higher --load address"));
    }
    if g_pe_asm_errors.len() > 0 {
        return ResultBytes::Err(g_pe_asm_errors);
    }
    if g_pe_ct_errors.len() > 0 {
        return ResultBytes::Err(peir_ct_report(g_pe_ct_errors, "bare-metal build"));
    }
    var reachable: Vec<str> = pe_ir_reachable_functions(&module);
    var names: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < gen.unresolved.len() {
        var u: UnresolvedCall = gen.unresolved.get(i);
        var j: i64 = 0;
        var hit: bool = false;
        while j < u.callers.len() {
            if pe_ir_strs_contains(reachable, u.callers.get(j)) {
                hit = true;
            }
            j = j + 1;
        }
        if hit {
            names.push(u.name);
        }
        i = i + 1;
    }
    if names.len() > 0 {
        return ResultBytes::Err(c_vec1("bare-metal build: no OS or C library to provide: " + str_join(names, ", ")));
    }
    return ResultBytes::Ok(bytes);
}

/// `fid emit --elf` (release F4, first step): a static Linux x86-64
/// executable from the same machine code as the Windows and bare builds.
/// For now it is the bare build's runtime (print, heap, panic, exit through
/// Linux system calls), so a program built without the stdlib runs; the
/// stdlib needs the runtime of stdlib/pe_runtime on Linux (what is left).
/// Layout: ELF header and one program header, then at 0x401000 the flat
/// binary ([code][data], entered at its first byte), one RWX segment.
pub fn pe_ir_generate_elf(module: IrModule) -> ResultBytes {
    g_pe_elf = true;
    var saved_load: i64 = g_pe_bare_load;
    g_pe_bare_load = 0x401000;
    var flat_res: ResultBytes = pe_ir_generate_flat(module, "");
    g_pe_elf = false;
    g_pe_bare_load = saved_load;
    match flat_res {
        ResultBytes::Err(e) => {
            return ResultBytes::Err(e);
        }
        ResultBytes::Ok(flat) => {
            var out: Vec = Vec::new();
            var total: i64 = 0x1000 + flat.len();
            // ELF header
            out.push(0x7F);
            out.push(0x45);
            out.push(0x4C);
            out.push(0x46);
            out.push(2);
            out.push(1);
            out.push(1);
            out.push(0);
            // 64-bit, LE, v1, SysV
            out = pe_push_u64(out, 0);
            // padding
            out.push(2);
            out.push(0);
            // ET_EXEC
            out.push(0x3E);
            out.push(0);
            // EM_X86_64
            out = pe_push_u32(out, 1);
            // e_version
            out = pe_push_u64(out, 0x401000);
            // e_entry
            out = pe_push_u64(out, 64);
            // e_phoff
            out = pe_push_u64(out, 0);
            // e_shoff
            out = pe_push_u32(out, 0);
            // e_flags
            out.push(64);
            out.push(0);
            // e_ehsize
            out.push(56);
            out.push(0);
            // e_phentsize
            out.push(1);
            out.push(0);
            // e_phnum
            out.push(64);
            out.push(0);
            // e_shentsize
            out.push(0);
            out.push(0);
            // e_shnum
            out.push(0);
            out.push(0);
            // e_shstrndx
            // PT_LOAD: the whole file at 0x400000, read/write/execute
            out = pe_push_u32(out, 1);
            // p_type
            out = pe_push_u32(out, 7);
            // p_flags RWX
            out = pe_push_u64(out, 0);
            // p_offset
            out = pe_push_u64(out, 0x400000);
            // p_vaddr
            out = pe_push_u64(out, 0x400000);
            // p_paddr
            out = pe_push_u64(out, total);
            // p_filesz
            out = pe_push_u64(out, total);
            // p_memsz
            out = pe_push_u64(out, 0x1000);
            // p_align
            while out.len() < 0x1000 {
                out.push(0);
            }
            var i: i64 = 0;
            while i < flat.len() {
                out.push(flat.get(i));
                i = i + 1;
            }
            return ResultBytes::Ok(out);
        }
    }
    return ResultBytes::Err(c_vec1("unreachable"));
}

/// `fid emit --uefi` (roadmap Phase 16): a UEFI application, a PE32+ image
/// of subsystem EFI_APPLICATION from the bare build's code and a runtime
/// over the firmware's boot services (pe_ir_stubs.fd, "UEFI application").
/// Like `--bare`, no stdlib. `panic_handler` is the @panic_handler, or "".
/// Layout (pe_build_efi): headers, .text at RVA 0x1000 (the flat binary's
/// code, entered at its first byte), .data after it, .reloc.
pub fn pe_ir_generate_uefi(module: IrModule, panic_handler: str) -> ResultBytes {
    g_pe_uefi = true;
    g_pe_uefi_abs = Vec::new();
    g_pe_uefi_code_size = Vec::new();
    g_pe_uefi_exit = -1;
    var saved_load: i64 = g_pe_bare_load;
    g_pe_bare_load = PE_EFI_IMAGE_BASE + PE_TEXT_RVA;
    var flat_res: ResultBytes = pe_ir_generate_flat(module, panic_handler);
    g_pe_uefi = false;
    g_pe_bare_load = saved_load;
    match flat_res {
        ResultBytes::Err(e) => {
            return ResultBytes::Err(e);
        }
        ResultBytes::Ok(flat) => {
            if g_pe_uefi_code_size.len() != 1 || flat.len() < g_pe_uefi_code_size.get(0) {
                return ResultBytes::Err(c_vec1("UEFI build: internal error: the code size of the flat binary is unknown"));
            }
            return ResultBytes::Ok(pe_build_efi(flat, g_pe_uefi_code_size.get(0), g_pe_uefi_abs));
        }
    }
    return ResultBytes::Err(c_vec1("unreachable"));
}

pub fn pe_ir_generate_pe(module: IrModule) -> ResultBytes {
    // The entry point calls main (it used to panic when there was none).
    if !pe_module_has_fn(&module, "main") {
        return ResultBytes::Err(c_vec1("PE backend: the program has no `main` function"));
    }
    g_pe_ct_errors = Vec::new();
    var gen: PeirGen = PeirGen_new();
    var bytes: Vec = PeirGen_generate(&mut gen, &module);
    if g_pe_ct_errors.len() > 0 {
        return ResultBytes::Err(peir_ct_report(g_pe_ct_errors, "PE backend"));
    }
    // MI20 (FID_VERIFY=1): pe_ir defines the whole nat_* interface
    if gen.nat_missing != "" {
        return ResultBytes::Err(c_vec1("PE backend: " + gen.nat_missing));
    }
    var reachable: Vec<str> = pe_ir_reachable_functions(&module);
    var names: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < gen.unresolved.len() {
        var u: UnresolvedCall = gen.unresolved.get(i);
        var j: i64 = 0;
        var hit: bool = false;
        while j < u.callers.len() {
            if pe_ir_strs_contains(reachable, u.callers.get(j)) {
                hit = true;
            }
            j = j + 1;
        }
        if hit {
            names.push(u.name);
        }
        i = i + 1;
    }
    if names.len() > 0 {
        var msg: str = "PE backend: not available in native Windows executables: " + str_join(names, ", ") + " (build with `fidesc ccompile` instead)";
        return ResultBytes::Err(c_vec1(msg));
    }
    return ResultBytes::Ok(bytes);
}
