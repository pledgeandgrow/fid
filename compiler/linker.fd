// linker.fd -- Fides Integrated Linker (Phase 4D)
// Ported from src/linker.rs. Links ELF64 object files into executable
// binaries without external tools.
//
// Supports:
//   - Full ELF executable emission (no external ld needed)
//   - Link-time dead code elimination (remove unused functions)
//   - R_X86_64_PC32, R_X86_64_PLT32, R_X86_64_64 relocations
//   - ARM64 and RISC-V internal relocation types
//   - Runtime symbol resolution

module compiler::linker;

use core;
use vec;
use string;

// --- Constants ------------------------------------------------------------

// ARM64 internal relocation codes
pub const R_ARM64_BL: i64 = 10;
pub const R_ARM64_B: i64 = 11;
pub const R_ARM64_BCOND: i64 = 12;
pub const R_ARM64_ADRP: i64 = 14;
pub const R_ARM64_ADD_LO12: i64 = 15;

// RISC-V internal relocation codes
pub const R_RISCV_JAL: i64 = 20;
pub const R_RISCV_BRANCH: i64 = 21;

// --- Structs --------------------------------------------------------------

pub struct LinkerSymbol {
    pub name: str,
    pub offset: i64,
    pub is_defined: bool,
}

pub fn LinkerSymbol_new(name: str, offset: i64, is_defined: bool) -> LinkerSymbol {
    return LinkerSymbol { name: name, offset: offset, is_defined: is_defined };
}

pub struct LinkerReloc {
    pub offset: i64,
    pub symbol: str,
    pub rtype: i64,
}

pub fn LinkerReloc_new(offset: i64, symbol: str, rtype: i64) -> LinkerReloc {
    return LinkerReloc { offset: offset, symbol: symbol, rtype: rtype };
}

pub struct LinkerRodataSym {
    pub name: str,
    pub offset: i64,
}

pub fn LinkerRodataSym_new(name: str, offset: i64) -> LinkerRodataSym {
    return LinkerRodataSym { name: name, offset: offset };
}

pub struct SectionInfo {
    pub name_offset: i64,
    pub sh_type: i64,
    pub offset: i64,
    pub size: i64,
    pub link: i64,
    pub entsize: i64,
    pub name: str,
}

pub struct Linker {
    pub text_bytes: Vec,
    pub symbols: Vec<LinkerSymbol>,
    pub relocations: Vec<LinkerReloc>,
    pub rodata: Vec,
    pub rodata_symbols: Vec<LinkerRodataSym>,
    pub rodata_relocations: Vec<LinkerReloc>,
    pub target: str,
}

pub fn Linker_new() -> Linker {
    return Linker {
        text_bytes: Vec::new(),
        symbols: Vec::new(),
        relocations: Vec::new(),
        rodata: Vec::new(),
        rodata_symbols: Vec::new(),
        rodata_relocations: Vec::new(),
        target: "x86-64",
    };
}

pub fn Linker_new_for_target(target: str) -> Linker {
    var l: Linker = Linker_new();
    l.target = target;
    return l;
}

// --- Result types ---

pub enum LinkerResult { Ok(Vec), Err(str) }
pub enum LinkerResultUnit { Ok, Err(str) }

// --- Unwrap helpers (for cross-module use without enum pattern matching) ---

pub fn LinkerResult_is_ok(r: LinkerResult) -> bool {
    match r {
        LinkerResult::Ok(_) => { return true; }
        LinkerResult::Err(_) => { return false; }
    }
}

pub fn LinkerResult_err_msg(r: LinkerResult) -> str {
    match r {
        LinkerResult::Ok(_) => { return ""; }
        LinkerResult::Err(e) => { return e; }
    }
}

pub fn LinkerResult_bytes(r: LinkerResult) -> Vec {
    match r {
        LinkerResult::Ok(b) => { return b; }
        LinkerResult::Err(_) => { return Vec::new(); }
    }
}

// --- Helper: symbol lookup ---

fn linker_find_symbol(symbols: Vec<LinkerSymbol>, name: str) -> i64 {
    var i: i64 = 0;
    while i < symbols.len() {
        if symbols.get(i).name == name { return i; }
        i = i + 1;
    }
    return -1;
}

fn linker_find_rodata_sym(rodata_syms: Vec<LinkerRodataSym>, name: str) -> i64 {
    var i: i64 = 0;
    while i < rodata_syms.len() {
        if rodata_syms.get(i).name == name { return rodata_syms.get(i).offset; }
        i = i + 1;
    }
    return -1;
}

fn linker_set_symbol(symbols: Vec<LinkerSymbol>, name: str, offset: i64, is_defined: bool) {
    var idx: i64 = linker_find_symbol(symbols, name);
    if idx >= 0 {
        symbols.get(idx).offset = offset;
        symbols.get(idx).is_defined = is_defined;
        return;
    }
    symbols.push(LinkerSymbol { name: name, offset: offset, is_defined: is_defined });
}

fn linker_set_rodata_sym(rodata_syms: Vec<LinkerRodataSym>, name: str, offset: i64) {
    var i: i64 = 0;
    while i < rodata_syms.len() {
        if rodata_syms.get(i).name == name {
            rodata_syms.get(i).offset = offset;
            return;
        }
        i = i + 1;
    }
    rodata_syms.push(LinkerRodataSym { name: name, offset: offset });
}

// --- Helper: read little-endian integers from Vec ---

fn read_u16(buf: Vec, off: i64) -> i64 {
    if off + 2 > buf.len() { return 0; }
    return buf.get(off) | (buf.get(off + 1) << 8);
}

fn read_u32(buf: Vec, off: i64) -> i64 {
    if off + 4 > buf.len() { return 0; }
    return buf.get(off) | (buf.get(off + 1) << 8) | (buf.get(off + 2) << 16) | (buf.get(off + 3) << 24);
}

fn read_u64(buf: Vec, off: i64) -> i64 {
    if off + 8 > buf.len() { return 0; }
    return buf.get(off) | (buf.get(off + 1) << 8) | (buf.get(off + 2) << 16) | (buf.get(off + 3) << 24)
         | (buf.get(off + 4) << 32) | (buf.get(off + 5) << 40) | (buf.get(off + 6) << 48) | (buf.get(off + 7) << 56);
}

fn read_i64(buf: Vec, off: i64) -> i64 {
    return read_u64(buf, off);
}

// --- Helper: write little-endian integers to Vec ---

fn write_u32(buf: Vec, off: i64, val: i64) {
    buf.set(off, val & 0xFF);
    buf.set(off + 1, (val >> 8) & 0xFF);
    buf.set(off + 2, (val >> 16) & 0xFF);
    buf.set(off + 3, (val >> 24) & 0xFF);
}

fn write_u64(buf: Vec, off: i64, val: i64) {
    var i: i64 = 0;
    while i < 8 {
        buf.set(off + i, (val >> (i * 8)) & 0xFF);
        i = i + 1;
    }
}

// --- Helper: get string from strtab ---

fn get_string(data: Vec, strtab_offset: i64, name_offset: i64) -> str {
    var start: i64 = strtab_offset + name_offset;
    if start >= data.len() { return ""; }
    var end: i64 = start;
    while end < data.len() && data.get(end) != 0 {
        end = end + 1;
    }
    // Build string from byte range [start, end)
    var result: str = "";
    var si: i64 = start;
    while si < end {
        result = result + char_to_str(data.get(si));
        si = si + 1;
    }
    return result;
}

// --- Helper: sanitize name ---

fn sanitize(name: str) -> str {
    var result: str = "";
    var i: i64 = 0;
    while i < str_len(name) {
        var c: i64 = str_byte_at(name, i);
        if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) {
            result = result + char_to_str(c);
        } else {
            result = result + "_";
        }
        i = i + 1;
    }
    return result;
}

// --- Public API: link ---

pub fn link_objects(objects: Vec<Vec>, entry: str) -> LinkerResult {
    var linker: Linker = Linker_new();
    var i: i64 = 0;
    while i < objects.len() {
        match Linker_add_object(linker, objects.get(i)) {
            LinkerResultUnit::Ok => {}
            LinkerResultUnit::Err(e) => { return LinkerResult::Err(e); }
        }
        i = i + 1;
    }
    return Linker_link(linker, entry);
}

// --- Public API: link_with_runtime ---

pub fn link_with_runtime(
    objects: Vec<Vec>,
    entry: str,
    runtime_text: Vec,
    runtime_symbols: Vec<LinkerSymbol>,
    runtime_rodata: Vec,
    runtime_rodata_syms: Vec<LinkerRodataSym>,
    runtime_relocs: Vec<LinkerReloc>
) -> LinkerResult {
    return link_with_runtime_for_target(objects, entry, runtime_text, runtime_symbols,
        runtime_rodata, runtime_rodata_syms, runtime_relocs, "x86-64");
}

// --- Public API: link_with_runtime_for_target ---

pub fn link_with_runtime_for_target(
    objects: Vec<Vec>,
    entry: str,
    runtime_text: Vec,
    runtime_symbols: Vec<LinkerSymbol>,
    runtime_rodata: Vec,
    runtime_rodata_syms: Vec<LinkerRodataSym>,
    runtime_relocs: Vec<LinkerReloc>,
    target: str
) -> LinkerResult {
    var linker: Linker = Linker_new_for_target(target);
    var i: i64 = 0;
    while i < objects.len() {
        match Linker_add_object(linker, objects.get(i)) {
            LinkerResultUnit::Ok => {}
            LinkerResultUnit::Err(e) => { return LinkerResult::Err(e); }
        }
        i = i + 1;
    }
    // Add the runtime as raw text + symbols
    var rt_base: i64 = linker.text_bytes.len();
    var ri: i64 = 0;
    while ri < runtime_text.len() {
        linker.text_bytes.push(runtime_text.get(ri));
        ri = ri + 1;
    }
    var si: i64 = 0;
    while si < runtime_symbols.len() {
        linker_set_symbol(linker.symbols, runtime_symbols.get(si).name, rt_base + runtime_symbols.get(si).offset, true);
        si = si + 1;
    }
    // Add rodata
    var rod_base: i64 = linker.rodata.len();
    ri = 0;
    while ri < runtime_rodata.len() {
        linker.rodata.push(runtime_rodata.get(ri));
        ri = ri + 1;
    }
    si = 0;
    while si < runtime_rodata_syms.len() {
        linker_set_rodata_sym(linker.rodata_symbols, runtime_rodata_syms.get(si).name, rod_base + runtime_rodata_syms.get(si).offset);
        si = si + 1;
    }
    // Add relocations (adjusted by rt_base)
    si = 0;
    while si < runtime_relocs.len() {
        linker.relocations.push(LinkerReloc {
            offset: rt_base + runtime_relocs.get(si).offset,
            symbol: runtime_relocs.get(si).symbol,
            rtype: runtime_relocs.get(si).rtype
        });
        si = si + 1;
    }
    return Linker_link(linker, entry);
}

// --- Public API: link_raw_with_runtime_for_target ---

pub fn link_raw_with_runtime_for_target(
    user_text: Vec,
    user_symbols: Vec<LinkerSymbol>,
    user_relocs: Vec<LinkerReloc>,
    user_rodata: Vec,
    user_rodata_syms: Vec<LinkerRodataSym>,
    entry: str,
    runtime_text: Vec,
    runtime_symbols: Vec<LinkerSymbol>,
    runtime_rodata: Vec,
    runtime_rodata_syms: Vec<LinkerRodataSym>,
    runtime_relocs: Vec<LinkerReloc>,
    target: str
) -> LinkerResult {
    var linker: Linker = Linker_new_for_target(target);

    // Add user text
    var i: i64 = 0;
    while i < user_text.len() { linker.text_bytes.push(user_text.get(i)); i = i + 1; }
    // Add user symbols
    i = 0;
    while i < user_symbols.len() {
        linker_set_symbol(linker.symbols, user_symbols.get(i).name, user_symbols.get(i).offset, true);
        i = i + 1;
    }
    // Add user rodata
    i = 0;
    while i < user_rodata.len() { linker.rodata.push(user_rodata.get(i)); i = i + 1; }
    // Add user rodata symbols
    i = 0;
    while i < user_rodata_syms.len() {
        linker_set_rodata_sym(linker.rodata_symbols, user_rodata_syms.get(i).name, user_rodata_syms.get(i).offset);
        i = i + 1;
    }
    // Add user relocations
    i = 0;
    while i < user_relocs.len() {
        linker.relocations.push(user_relocs.get(i));
        i = i + 1;
    }

    // Add the runtime as raw text + symbols
    var rt_base: i64 = linker.text_bytes.len();
    i = 0;
    while i < runtime_text.len() { linker.text_bytes.push(runtime_text.get(i)); i = i + 1; }
    i = 0;
    while i < runtime_symbols.len() {
        linker_set_symbol(linker.symbols, runtime_symbols.get(i).name, rt_base + runtime_symbols.get(i).offset, true);
        i = i + 1;
    }
    // Add runtime rodata
    var rod_base: i64 = linker.rodata.len();
    i = 0;
    while i < runtime_rodata.len() { linker.rodata.push(runtime_rodata.get(i)); i = i + 1; }
    i = 0;
    while i < runtime_rodata_syms.len() {
        linker_set_rodata_sym(linker.rodata_symbols, runtime_rodata_syms.get(i).name, rod_base + runtime_rodata_syms.get(i).offset);
        i = i + 1;
    }
    // Add runtime relocations (adjusted by rt_base)
    i = 0;
    while i < runtime_relocs.len() {
        linker.relocations.push(LinkerReloc {
            offset: rt_base + runtime_relocs.get(i).offset,
            symbol: runtime_relocs.get(i).symbol,
            rtype: runtime_relocs.get(i).rtype
        });
        i = i + 1;
    }
    return Linker_link(linker, entry);
}

// --- Dead code elimination ---

pub fn dead_code_elimination(
    symbols: Vec<LinkerSymbol>,
    relocations: Vec<LinkerReloc>,
    entry: str
) -> Vec<i64> {
    // Build call graph: for each symbol, which symbols does it call?
    // For simplicity, use linear search instead of HashMap
    var reachable: Vec<str> = Vec::new();
    var queue: Vec<str> = Vec::new();
    queue.push(entry);

    while queue.len() > 0 {
        var sym: str = queue.get(queue.len() - 1);
        queue.pop();

        // Check if already reachable
        var already: bool = false;
        var ri2: i64 = 0;
        while ri2 < reachable.len() {
            if reachable.get(ri2) == sym { already = true; break; }
            ri2 = ri2 + 1;
        }
        if already { continue; }
        reachable.push(sym);

        // Find all relocations that originate from this symbol's range
        var sym_idx: i64 = -1;
        var si2: i64 = 0;
        while si2 < symbols.len() {
            if symbols.get(si2).name == sym { sym_idx = si2; break; }
            si2 = si2 + 1;
        }
        if sym_idx < 0 { continue; }

        var sym_start: i64 = symbols.get(sym_idx).offset;
        // For each relocation, check if it falls within this symbol's range
        // Since we don't have size info in LinkerSymbol, use heuristic:
        // relocations with offset >= sym_start and < next symbol's start
        var sym_end: i64 = 0x7FFFFFFFFFFFFFFF;
        si2 = 0;
        while si2 < symbols.len() {
            if si2 != sym_idx && symbols.get(si2).offset > sym_start && symbols.get(si2).offset < sym_end {
                sym_end = symbols.get(si2).offset;
            }
            si2 = si2 + 1;
        }

        var rli: i64 = 0;
        while rli < relocations.len() {
            if relocations.get(rli).offset >= sym_start && relocations.get(rli).offset < sym_end {
                // Check if target is already in queue/reachable
                var target: str = relocations.get(rli).symbol;
                var found: bool = false;
                var ri3: i64 = 0;
                while ri3 < reachable.len() {
                    if reachable.get(ri3) == target { found = true; break; }
                    ri3 = ri3 + 1;
                }
                if !found {
                    var in_queue: bool = false;
                    var qi: i64 = 0;
                    while qi < queue.len() {
                        if queue.get(qi) == target { in_queue = true; break; }
                        qi = qi + 1;
                    }
                    if !in_queue {
                        queue.push(target);
                    }
                }
            }
            rli = rli + 1;
        }
    }

    // Return indices of reachable symbols
    var result: Vec<i64> = Vec::new();
    var si3: i64 = 0;
    while si3 < symbols.len() {
        var ri4: i64 = 0;
        while ri4 < reachable.len() {
            if reachable.get(ri4) == symbols.get(si3).name {
                result.push(si3);
                break;
            }
            ri4 = ri4 + 1;
        }
        si3 = si3 + 1;
    }
    return result;
}

// --- Linker::add_object ---

pub fn Linker_add_object(self: &mut Linker, obj: Vec) -> LinkerResultUnit {
    if obj.len() < 64 {
        return LinkerResultUnit::Err("Object file too small for ELF header");
    }
    if obj.get(0) != 0x7f || obj.get(1) != 0x45 || obj.get(2) != 0x4c || obj.get(3) != 0x46 {
        return LinkerResultUnit::Err("Not an ELF file");
    }
    if obj.get(4) != 2 {
        return LinkerResultUnit::Err("Not ELF64");
    }

    // Parse ELF header
    var e_shoff: i64 = read_u64(obj, 40);
    var e_shnum: i64 = read_u16(obj, 60);
    var e_shstrndx: i64 = read_u16(obj, 62);

    if e_shoff == 0 || e_shnum == 0 {
        return LinkerResultUnit::Err("No section headers in object file");
    }

    // Parse section headers
    var sections: Vec<SectionInfo> = Vec::new();
    var i: i64 = 0;
    while i < e_shnum {
        var offset: i64 = e_shoff + i * 64;
        if offset + 64 > obj.len() { break; }
        var sh_name: i64 = read_u32(obj, offset);
        var sh_type: i64 = read_u32(obj, offset + 4);
        var sh_offset: i64 = read_u64(obj, offset + 24);
        var sh_size: i64 = read_u64(obj, offset + 32);
        var sh_link: i64 = read_u32(obj, offset + 40);
        var sh_entsize: i64 = read_u64(obj, offset + 56);
        sections.push(SectionInfo {
            name_offset: sh_name,
            sh_type: sh_type,
            offset: sh_offset,
            size: sh_size,
            link: sh_link,
            entsize: sh_entsize,
            name: ""
        });
        i = i + 1;
    }

    // Get section name string table
    if e_shstrndx < sections.len() {
        var strtab_offset: i64 = sections.get(e_shstrndx).offset;
        var strtab_size: i64 = sections.get(e_shstrndx).size;
        if strtab_offset + strtab_size <= obj.len() {
            var si: i64 = 0;
            while si < sections.len() {
                sections.get(si).name = get_string(obj, strtab_offset, sections.get(si).name_offset);
                si = si + 1;
            }
        }
    }

    // Find .text, .rodata, .symtab, .strtab, .rela.text sections
    var text_data: Vec = Vec::new();
    var rodata_data: Vec = Vec::new();
    var symtab_idx: i64 = -1;
    var strtab_idx: i64 = -1;
    var rela_text_idx: i64 = -1;
    var rela_rodata_idx: i64 = -1;

    i = 0;
    while i < sections.len() {
        var sec_name: str = sections.get(i).name;
        if sec_name == ".text" {
            if sections.get(i).offset + sections.get(i).size <= obj.len() {
                var ti: i64 = 0;
                while ti < sections.get(i).size {
                    text_data.push(obj.get(sections.get(i).offset + ti));
                    ti = ti + 1;
                }
            }
        } else if sec_name == ".rodata" {
            if sections.get(i).offset + sections.get(i).size <= obj.len() {
                var ri: i64 = 0;
                while ri < sections.get(i).size {
                    rodata_data.push(obj.get(sections.get(i).offset + ri));
                    ri = ri + 1;
                }
            }
        } else if sec_name == ".symtab" {
            symtab_idx = i;
        } else if sec_name == ".strtab" {
            strtab_idx = sections.get(i).link;
        } else if sec_name == ".rela.text" {
            rela_text_idx = i;
        } else if sec_name == ".rela.rodata" {
            rela_rodata_idx = i;
        }
        i = i + 1;
    }

    // Adjust symbol table link (strtab is in the symtab's sh_link field)
    if symtab_idx >= 0 {
        strtab_idx = sections.get(symtab_idx).link;
    }

    // Append text section to our combined text
    var text_base: i64 = self.text_bytes.len();
    var ti2: i64 = 0;
    while ti2 < text_data.len() { self.text_bytes.push(text_data.get(ti2)); ti2 = ti2 + 1; }

    // Append rodata section to our combined rodata
    var rodata_base: i64 = self.rodata.len();
    var ri2: i64 = 0;
    while ri2 < rodata_data.len() { self.rodata.push(rodata_data.get(ri2)); ri2 = ri2 + 1; }

    // Find the section index for .rodata
    var rodata_sec_idx: i64 = -1;
    i = 0;
    while i < sections.len() {
        if sections.get(i).name == ".rodata" { rodata_sec_idx = i; break; }
        i = i + 1;
    }

    // Parse symbols
    if symtab_idx >= 0 && strtab_idx >= 0 {
        var symtab: SectionInfo = sections.get(symtab_idx);
        var strtab: SectionInfo = sections.get(strtab_idx);
        var num_syms: i64 = symtab.size / 24; // Elf64_Sym is 24 bytes

        var j: i64 = 0;
        while j < num_syms {
            var off: i64 = symtab.offset + j * 24;
            if off + 24 > obj.len() { break; }
            var st_name: i64 = read_u32(obj, off);
            var st_value: i64 = read_u64(obj, off + 8);
            var st_size: i64 = read_u64(obj, off + 16);
            var st_shndx: i64 = read_u16(obj, off + 6);

            var name: str = get_string(obj, strtab.offset, st_name);
            if str_len(name) == 0 { j = j + 1; continue; }

            var is_defined: bool = st_shndx != 0;

            // Check if this symbol is in the rodata section
            if is_defined && rodata_sec_idx == st_shndx {
                // Rodata symbol
                linker_set_rodata_sym(self.rodata_symbols, name, rodata_base + st_value);
            } else {
                var offset2: i64 = 0;
                if is_defined {
                    offset2 = text_base + st_value;
                }
                linker_set_symbol(self.symbols, name, offset2, is_defined);
            }
            j = j + 1;
        }
    }

    // Parse relocations (.rela.text)
    if rela_text_idx >= 0 {
        var rela: SectionInfo = sections.get(rela_text_idx);
        var num_relas: i64 = rela.size / 24; // Elf64_Rela is 24 bytes

        var j: i64 = 0;
        while j < num_relas {
            var off: i64 = rela.offset + j * 24;
            if off + 24 > obj.len() { break; }
            var r_offset: i64 = read_u64(obj, off);
            var r_info: i64 = read_u64(obj, off + 8);
            var r_addend: i64 = read_i64(obj, off + 16);

            var r_sym: i64 = (r_info >> 32) & 0xFFFFFFFF;
            var r_type: i64 = r_info & 0xFFFFFFFF;

            // Get symbol name from symtab
            var sym_name: str = "";
            if symtab_idx >= 0 && strtab_idx >= 0 {
                var symtab2: SectionInfo = sections.get(symtab_idx);
                var strtab2: SectionInfo = sections.get(strtab_idx);
                var sym_off: i64 = symtab2.offset + r_sym * 24;
                if sym_off + 4 <= obj.len() {
                    var st_name2: i64 = read_u32(obj, sym_off);
                    sym_name = get_string(obj, strtab2.offset, st_name2);
                }
            }

            // Adjust relocation offset to combined text
            var adjusted_offset: i64 = text_base + r_offset;
            self.relocations.push(LinkerReloc { offset: adjusted_offset, symbol: sym_name, rtype: r_type });
            j = j + 1;
        }
    }

    // Process rodata relocations (e.g., vtable function pointers)
    if rela_rodata_idx >= 0 {
        var rela: SectionInfo = sections.get(rela_rodata_idx);
        var num_relas: i64 = rela.size / 24;

        var j: i64 = 0;
        while j < num_relas {
            var off: i64 = rela.offset + j * 24;
            if off + 24 > obj.len() { break; }
            var r_offset: i64 = read_u64(obj, off);
            var r_info: i64 = read_u64(obj, off + 8);
            var r_addend: i64 = read_i64(obj, off + 16);
            var r_sym: i64 = (r_info >> 32) & 0xFFFFFFFF;
            var r_type: i64 = r_info & 0xFFFFFFFF;

            var sym_name: str = "";
            if symtab_idx >= 0 && strtab_idx >= 0 {
                var symtab2: SectionInfo = sections.get(symtab_idx);
                var strtab2: SectionInfo = sections.get(strtab_idx);
                var sym_off: i64 = symtab2.offset + r_sym * 24;
                if sym_off + 4 <= obj.len() {
                    var st_name2: i64 = read_u32(obj, sym_off);
                    sym_name = get_string(obj, strtab2.offset, st_name2);
                }
            }

            var adjusted_offset: i64 = rodata_base + r_offset;
            self.rodata_relocations.push(LinkerReloc { offset: adjusted_offset, symbol: sym_name, rtype: r_type });
            j = j + 1;
        }
    }

    return LinkerResultUnit::Ok;
}

// --- Linker::link ---

pub fn Linker_link(self: &mut Linker, entry: str) -> LinkerResult {
    // Apply link-time DCE
    // Build symbol list for DCE
    var dce_symbols: Vec<LinkerSymbol> = Vec::new();
    var si: i64 = 0;
    while si < self.symbols.len() {
        if self.symbols.get(si).is_defined && !str_starts_with(self.symbols.get(si).name, ".L") {
            dce_symbols.push(LinkerSymbol {
                name: self.symbols.get(si).name,
                offset: self.symbols.get(si).offset,
                is_defined: true
            });
        }
        si = si + 1;
    }

    var dce_relocs: Vec<LinkerReloc> = Vec::new();
    var ri: i64 = 0;
    while ri < self.relocations.len() {
        dce_relocs.push(LinkerReloc {
            offset: self.relocations.get(ri).offset,
            symbol: self.relocations.get(ri).symbol,
            rtype: 0
        });
        ri = ri + 1;
    }

    var reachable: Vec<i64> = dead_code_elimination(dce_symbols, dce_relocs, entry);
    // Build reachable set
    var reachable_names: Vec<str> = Vec::new();
    var ri2: i64 = 0;
    while ri2 < reachable.len() {
        reachable_names.push(dce_symbols.get(reachable.get(ri2)).name);
        ri2 = ri2 + 1;
    }

    // Resolve relocations and patch the text
    var text_size: i64 = self.text_bytes.len();
    var ri3: i64 = 0;
    while ri3 < self.relocations.len() {
        var offset: i64 = self.relocations.get(ri3).offset;
        var sym_name: str = self.relocations.get(ri3).symbol;
        var r_type: i64 = self.relocations.get(ri3).rtype;

        // Look up symbol in text symbols first, then rodata symbols
        var sym_offset: i64 = -1;
        var sym_idx: i64 = linker_find_symbol(self.symbols, sym_name);
        if sym_idx >= 0 {
            if !self.symbols.get(sym_idx).is_defined {
                // External symbol -- leave as 0
                ri3 = ri3 + 1; continue;
            }
            // Skip if this symbol is not reachable (DCE)
            // But always keep local labels (.L prefix) and entry
            var is_reachable: bool = sym_name == entry || str_starts_with(sym_name, ".L");
            if !is_reachable {
                var rni: i64 = 0;
                while rni < reachable_names.len() {
                    if reachable_names.get(rni) == sym_name { is_reachable = true; break; }
                    rni = rni + 1;
                }
            }
            if !is_reachable {
                ri3 = ri3 + 1; continue;
            }
            sym_offset = self.symbols.get(sym_idx).offset;
        } else {
            var rod_off: i64 = linker_find_rodata_sym(self.rodata_symbols, sym_name);
            if rod_off >= 0 {
                // Rodata symbol: offset is text_size + rodata_offset
                sym_offset = text_size + rod_off;
            } else {
                // Unknown symbol -- skip
                ri3 = ri3 + 1; continue;
            }
        }

        if sym_offset >= 0 {
            var patch_offset: i64 = offset;
            if patch_offset + 4 <= self.text_bytes.len() {
                if r_type == R_X86_64_PC32 {
                    // R_X86_64_PC32: PC-relative 32-bit
                    var next_rip: i64 = patch_offset + 4;
                    var delta: i64 = sym_offset - next_rip;
                    write_u32(self.text_bytes, patch_offset, delta);
                } else if r_type == R_X86_64_PLT32 {
                    // R_X86_64_PLT32: same as PC32 for our purposes
                    var next_rip2: i64 = patch_offset + 4;
                    var delta2: i64 = sym_offset - next_rip2;
                    write_u32(self.text_bytes, patch_offset, delta2);
                } else if r_type == R_X86_64_64 {
                    // R_X86_64_64: absolute 64-bit
                    if patch_offset + 8 <= self.text_bytes.len() {
                        var abs_addr: i64 = sym_offset + 0x400078;
                        write_u64(self.text_bytes, patch_offset, abs_addr);
                    }
                } else if r_type == R_ARM64_BL || r_type == R_ARM64_B {
                    // BL/B: 26-bit PC-relative offset / 4
                    var next_pc: i64 = patch_offset + 4;
                    var delta3: i64 = sym_offset - next_pc;
                    var imm26: i64 = (delta3 / 4) & 0x03FFFFFF;
                    var instr: i64 = read_u32(self.text_bytes, patch_offset);
                    var patched: i64 = (instr & 0xFC000000) | imm26;
                    write_u32(self.text_bytes, patch_offset, patched);
                } else if r_type == R_ARM64_BCOND {
                    // B.cond: 19-bit PC-relative offset / 4
                    var next_pc2: i64 = patch_offset + 4;
                    var delta4: i64 = sym_offset - next_pc2;
                    var imm19: i64 = (delta4 / 4) & 0x0007FFFF;
                    var instr2: i64 = read_u32(self.text_bytes, patch_offset);
                    var patched2: i64 = (instr2 & 0xFF00001F) | (imm19 << 5);
                    write_u32(self.text_bytes, patch_offset, patched2);
                } else if r_type == R_ARM64_ADRP {
                    // ADRP: compute page-aligned PC-relative address
                    var base_addr: i64 = 0x400000;
                    var text_file_offset: i64 = 64 + 56; // ELF header + 1 phdr
                    var text_vaddr: i64 = base_addr + text_file_offset;
                    var source_vaddr: i64 = text_vaddr + patch_offset;
                    var source_page: i64 = source_vaddr & ~0xFFF;
                    var sym_vaddr: i64 = text_vaddr + sym_offset;
                    var target_page: i64 = sym_vaddr & ~0xFFF;
                    var page_delta: i64 = (target_page - source_page) / 4096;
                    var imm: i64 = page_delta & 0x7FFFF; // 21 bits
                    var immlo: i64 = imm & 0x3;
                    var immhi: i64 = (imm >> 2) & 0x7FFFF;
                    var instr3: i64 = read_u32(self.text_bytes, patch_offset);
                    var patched3: i64 = (instr3 & 0x9F00001F) | (immlo << 29) | (immhi << 5);
                    write_u32(self.text_bytes, patch_offset, patched3);
                } else if r_type == R_ARM64_ADD_LO12 {
                    // ADD Xd, Xn, :lo12:label -- add low 12 bits of symbol address
                    var base_addr2: i64 = 0x400000;
                    var text_file_offset2: i64 = 64 + 56;
                    var text_vaddr2: i64 = base_addr2 + text_file_offset2;
                    var sym_vaddr2: i64 = text_vaddr2 + sym_offset;
                    var lo12: i64 = sym_vaddr2 & 0xFFF;
                    var instr4: i64 = read_u32(self.text_bytes, patch_offset);
                    var patched4: i64 = (instr4 & 0xFFC00003) | (lo12 << 10);
                    write_u32(self.text_bytes, patch_offset, patched4);
                } else if r_type == R_RISCV_JAL {
                    // JAL: 20-bit PC-relative immediate (J-type)
                    var next_pc3: i64 = patch_offset;
                    var delta5: i64 = sym_offset - next_pc3;
                    var imm20: i64 = (delta5 >> 20) & 1;
                    var imm10_1: i64 = (delta5 >> 1) & 0x3FF;
                    var imm11: i64 = (delta5 >> 11) & 1;
                    var imm19_12: i64 = (delta5 >> 12) & 0xFF;
                    var instr5: i64 = read_u32(self.text_bytes, patch_offset);
                    var patched5: i64 = (instr5 & 0x00000FFF)
                        | (imm20 << 31)
                        | (imm10_1 << 21)
                        | (imm11 << 20)
                        | (imm19_12 << 12);
                    write_u32(self.text_bytes, patch_offset, patched5);
                } else if r_type == R_RISCV_BRANCH {
                    // Branch: 13-bit PC-relative immediate (B-type)
                    var next_pc4: i64 = patch_offset;
                    var delta6: i64 = sym_offset - next_pc4;
                    var imm12: i64 = (delta6 >> 12) & 1;
                    var imm10_5: i64 = (delta6 >> 5) & 0x3F;
                    var imm4_1: i64 = (delta6 >> 1) & 0xF;
                    var imm11_2: i64 = (delta6 >> 11) & 1;
                    var instr6: i64 = read_u32(self.text_bytes, patch_offset);
                    var patched6: i64 = (instr6 & 0x01FFF07F)
                        | (imm12 << 31)
                        | (imm10_5 << 25)
                        | (imm4_1 << 8)
                        | (imm11_2 << 7);
                    write_u32(self.text_bytes, patch_offset, patched6);
                }
            }
        }
        ri3 = ri3 + 1;
    }

    // Find entry point offset
    var entry_offset: i64 = 0;
    var entry_idx: i64 = linker_find_symbol(self.symbols, entry);
    if entry_idx >= 0 {
        entry_offset = self.symbols.get(entry_idx).offset;
    }

    // Apply rodata relocations (vtable function pointers, etc.)
    var text_size2: i64 = self.text_bytes.len();
    var base_addr3: i64 = 0x400000;
    var text_file_offset3: i64 = 64 + 56; // ELF header + 1 phdr
    var text_vaddr3: i64 = base_addr3 + text_file_offset3;

    var ri4: i64 = 0;
    while ri4 < self.rodata_relocations.len() {
        var offset2: i64 = self.rodata_relocations.get(ri4).offset;
        var sym_name2: str = self.rodata_relocations.get(ri4).symbol;
        var r_type2: i64 = self.rodata_relocations.get(ri4).rtype;

        var sym_offset2: i64 = -1;
        var sym_idx2: i64 = linker_find_symbol(self.symbols, sym_name2);
        if sym_idx2 >= 0 {
            if !self.symbols.get(sym_idx2).is_defined { ri4 = ri4 + 1; continue; }
            sym_offset2 = self.symbols.get(sym_idx2).offset;
        } else {
            var rod_off2: i64 = linker_find_rodata_sym(self.rodata_symbols, sym_name2);
            if rod_off2 >= 0 {
                sym_offset2 = text_size2 + rod_off2;
            } else {
                ri4 = ri4 + 1; continue;
            }
        }

        if sym_offset2 >= 0 {
            var patch_offset2: i64 = offset2;
            if r_type2 == R_X86_64_64 {
                // R_X86_64_64: absolute 64-bit
                if patch_offset2 + 8 <= self.rodata.len() {
                    var abs_addr2: i64 = text_vaddr3 + sym_offset2;
                    write_u64(self.rodata, patch_offset2, abs_addr2);
                }
            }
        }
        ri4 = ri4 + 1;
    }

    // Build ELF64 executable
    return Linker_build_executable(self, entry_offset);
}

// --- Linker::build_executable ---

pub fn Linker_build_executable(self: &Linker, entry_offset: i64) -> LinkerResult {
    // ELF64 executable layout:
    //   - ELF header (64 bytes)
    //   - Program headers (56 bytes each, 1 PT_LOAD)
    //   - .text section
    //   - .rodata section (if any)

    var text_size: i64 = self.text_bytes.len();
    var rodata_size: i64 = self.rodata.len();

    // Program header: load everything at virtual address 0x400000
    var base_addr: i64 = 0x400000;
    var phdr_offset: i64 = 64; // right after ELF header
    var phdr_size: i64 = 56;
    var text_file_offset: i64 = phdr_offset + phdr_size;
    var text_vaddr: i64 = base_addr + text_file_offset;

    var buf: Vec = Vec::new();

    // --- ELF Header ---
    buf.push(0x7f); buf.push(0x45); buf.push(0x4c); buf.push(0x46); // e_ident magic
    buf.push(2);    // ELFCLASS64
    buf.push(1);    // ELFDATA2LSB
    buf.push(1);    // EV_CURRENT
    buf.push(0);    // ELFOSABI_NONE
    // 8 bytes padding
    var pi: i64 = 0; while pi < 8 { buf.push(0); pi = pi + 1; }
    // e_type = ET_EXEC (2)
    buf.push(2); buf.push(0);
    // e_machine
    var e_machine: i64 = 62; // EM_X86_64
    if self.target == "arm64" || self.target == "aarch64" {
        e_machine = 183; // EM_AARCH64
    } else if self.target == "riscv" || self.target == "riscv64" {
        e_machine = 243; // EM_RISCV
    }
    buf.push(e_machine & 0xFF); buf.push((e_machine >> 8) & 0xFF);
    // e_version = 1
    buf.push(1); buf.push(0); buf.push(0); buf.push(0);
    // e_entry = virtual address of entry
    write_u64(buf, buf.len(), text_vaddr + entry_offset);
    // e_phoff
    write_u64(buf, buf.len(), phdr_offset);
    // e_shoff (no section headers)
    write_u64(buf, buf.len(), 0);
    // e_flags
    buf.push(0); buf.push(0); buf.push(0); buf.push(0);
    // e_ehsize = 64
    buf.push(64); buf.push(0);
    // e_phentsize = 56
    buf.push(56); buf.push(0);
    // e_phnum = 1
    buf.push(1); buf.push(0);
    // e_shentsize = 0
    buf.push(0); buf.push(0);
    // e_shnum = 0
    buf.push(0); buf.push(0);
    // e_shstrndx = 0
    buf.push(0); buf.push(0);

    // --- Program Header (PT_LOAD for .text) ---
    // p_type = PT_LOAD (1)
    buf.push(1); buf.push(0); buf.push(0); buf.push(0);
    // p_flags = PF_R | PF_X (5)
    buf.push(5); buf.push(0); buf.push(0); buf.push(0);
    // p_offset
    write_u64(buf, buf.len(), text_file_offset);
    // p_vaddr
    write_u64(buf, buf.len(), text_vaddr);
    // p_paddr
    write_u64(buf, buf.len(), text_vaddr);
    // p_filesz
    write_u64(buf, buf.len(), text_size + rodata_size);
    // p_memsz
    write_u64(buf, buf.len(), text_size + rodata_size);
    // p_align = 0x1000
    write_u64(buf, buf.len(), 0x1000);

    // --- .text section ---
    var ti: i64 = 0;
    while ti < self.text_bytes.len() {
        buf.push(self.text_bytes.get(ti));
        ti = ti + 1;
    }

    // --- .rodata section ---
    var ri: i64 = 0;
    while ri < self.rodata.len() {
        buf.push(self.rodata.get(ri));
        ri = ri + 1;
    }

    return LinkerResult::Ok(buf);
}
