    // movq %rsi, %r12 (vec_b)
    rl_pb3(text, 0x49, 0x89, 0xf4);
    // movq 8(%rbx), %r13 (len_a)
    rl_pb4(text, 0x4c, 0x8b, 0x6b, 0x08);
    // movq (%rbx), %rbx (data_a)
    rl_pb3(text, 0x48, 0x8b, 0x1b);
    // movq (%r12), %r12 (data_b)
    rl_pb4(text, 0x4d, 0x8b, 0x24, 0x24);
    // xorq %r14, %r14 (index = 0)
