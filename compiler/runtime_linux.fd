    // =======================================================================
    // Database functions -- in-memory key-value store for test_db
    // Layout: db pointer -> [count(8), key_ptr_0(8), key_ptr_1(8), ...]
    // Each key_ptr points to a null-terminated string (allocated with p_malloc)
    // =======================================================================
    // p_db_mem_open() -> rax = db pointer
    // Allocates 4096 bytes, sets count=0
    add_sym(symbols, text, "p_db_mem_open");
    rl_pb7(text, 0x48, 0xc7, 0xc7, 0x00, 0x10, 0x00, 0x00);
    rl_pb5(text, 0xe8, 0, 0, 0, 0);
    var dbopen_call_off: i64 = text.len() - 4;
    rl_pb7(text, 0x48, 0xc7, 0x00, 0x00, 0x00, 0x00, 0x00);
    text.push(0xc3 & 0xFF);
    // p_db_mem_close(rdi = db) -> void
    // Just calls p_free
    add_sym(symbols, text, "p_db_mem_close");
    rl_pb5(text, 0xe8, 0, 0, 0, 0);
    var dbclose_call_off: i64 = text.len() - 4;
    text.push(0xc3 & 0xFF);
    // p_db_mem_exec(rdi = db, rsi = query) -> rax = 1 on success, 0 on failure
    // Parses "INSERT key value" or "SET key value", stores key pointer
    // p_db_mem_exec(rdi = db, rsi = query) -> rax = 1 on success, 0 on failure
    // Parses "INSERT key value", stores key pointer + length in the db.
    // No p_malloc needed -- key pointer points into the query string (rodata).
    // DB layout: [count(8), key_ptr_0(8), key_len_0(8), key_ptr_1(8), key_len_1(8), ...]
    add_sym(symbols, text, "p_db_mem_exec");
    // pushq %rbx, %r12, %r13
    text.push(0x53 & 0xFF);
    rl_pb2(text, 0x41, 0x54);
    rl_pb2(text, 0x41, 0x55);
    // (3 pushes = 24 bytes, rsp = 8+24 = 32  0 mod 16 -- aligned, no subq needed)
    // rbx = db, r12 = query cursor
    rl_pb3(text, 0x48, 0x89, 0xfb);
    rl_pb3(text, 0x49, 0x89, 0xf4);
    // Find first space: advance r12 until ' '
    // .find_space:
    var dbexec_fs: i64 = text.len();
    rl_pb5(text, 0x41, 0x0f, 0xb6, 0x04, 0x24);
    rl_pb2(text, 0x84, 0xc0);
    var dbexec_fail1_je: i64 = text.len();
    rl_pb6(text, 0x0f, 0x84, 0, 0, 0, 0);
    rl_pb2(text, 0x3c, 0x20);
    var dbexec_found_je: i64 = text.len();
    rl_pb6(text, 0x0f, 0x84, 0, 0, 0, 0);
    rl_pb3(text, 0x49, 0xff, 0xc4);
    var dbexec_fs_jmp: i64 = text.len();
    var dbexec_fs_back: i64 = dbexec_fs - dbexec_fs_jmp - 2;
    rl_pb2(text, 0xeb, (dbexec_fs_back) & 0xFF);
    // .found_space:
    var dbexec_found: i64 = text.len();
    var dbexec_found_rel: i64 = (dbexec_found - dbexec_found_je - 6);
    text.set(dbexec_found_je + 2, (dbexec_found_rel) & 0xFF);
    text.set(dbexec_found_je + 3, (dbexec_found_rel >> 8) & 0xFF);
    text.set(dbexec_found_je + 4, (dbexec_found_rel >> 16) & 0xFF);
    text.set(dbexec_found_je + 5, (dbexec_found_rel >> 24) & 0xFF);
    // Skip spaces
    // .skip_spaces:
    var dbexec_skip: i64 = text.len();
    rl_pb5(text, 0x41, 0x0f, 0xb6, 0x04, 0x24);
    rl_pb2(text, 0x3c, 0x20);
    var dbexec_keystart_jne: i64 = text.len();
    rl_pb6(text, 0x0f, 0x85, 0, 0, 0, 0);
    rl_pb3(text, 0x49, 0xff, 0xc4);
    var dbexec_skip_jmp: i64 = text.len();
    var dbexec_skip_back: i64 = dbexec_skip - dbexec_skip_jmp - 2;
    rl_pb2(text, 0xeb, (dbexec_skip_back) & 0xFF);
    // .key_start:
    var dbexec_keystart: i64 = text.len();
    var dbexec_keystart_rel: i64 = (dbexec_keystart - dbexec_keystart_jne - 6);
    text.set(dbexec_keystart_jne + 2, (dbexec_keystart_rel) & 0xFF);
    text.set(dbexec_keystart_jne + 3, (dbexec_keystart_rel >> 8) & 0xFF);
    text.set(dbexec_keystart_jne + 4, (dbexec_keystart_rel >> 16) & 0xFF);
    text.set(dbexec_keystart_jne + 5, (dbexec_keystart_rel >> 24) & 0xFF);
    // r13 = r12 (key start pointer)
    rl_pb3(text, 0x4d, 0x89, 0xe5);
    // Find end of key: advance r12 until ' ' or '\0'
    // .find_key_end:
    var dbexec_keyend: i64 = text.len();
    rl_pb5(text, 0x41, 0x0f, 0xb6, 0x04, 0x24);
    rl_pb2(text, 0x84, 0xc0);
    var dbexec_havekey_je: i64 = text.len();
    rl_pb6(text, 0x0f, 0x84, 0, 0, 0, 0);
    rl_pb2(text, 0x3c, 0x20);
    var dbexec_havekey_je2: i64 = text.len();
    rl_pb6(text, 0x0f, 0x84, 0, 0, 0, 0);
    rl_pb3(text, 0x49, 0xff, 0xc4);
    var dbexec_keyend_jmp: i64 = text.len();
    var dbexec_keyend_back: i64 = dbexec_keyend - dbexec_keyend_jmp - 2;
    rl_pb2(text, 0xeb, (dbexec_keyend_back) & 0xFF);
    // .have_key:
    var dbexec_havekey: i64 = text.len();
    var dbexec_havekey_rel: i64 = (dbexec_havekey - dbexec_havekey_je - 6);
    text.set(dbexec_havekey_je + 2, (dbexec_havekey_rel) & 0xFF);
    text.set(dbexec_havekey_je + 3, (dbexec_havekey_rel >> 8) & 0xFF);
    text.set(dbexec_havekey_je + 4, (dbexec_havekey_rel >> 16) & 0xFF);
