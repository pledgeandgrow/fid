    rl_pb6(text, 0x0f, 0x84, 0x00, 0x00, 0x00, 0x00);
    // If not first element, write ", "
    rl_pb3(text, 0x4d, 0x85, 0xed);
    // je .skip_comma
    var pvec_je_off: i64 = text.len();
    rl_pb2(text, 0x74, 0x00);
    // Write ", "
    rl_pb5(text, 0xbf, 0x01, 0x00, 0x00, 0x00);
    rl_pb7(text, 0x48, 0x8d, 0x35, 0x00, 0x00, 0x00, 0x00);
    var pvec_comma_lea: i64 = text.len() - 4;
    rl_pb5(text, 0xba, 0x02, 0x00, 0x00, 0x00);
    rl_pb5(text, 0xb8, 0x01, 0x00, 0x00, 0x00);
    rl_pb2(text, 0x0f, 0x05);
    // .skip_comma:
    var pvec_skip_comma: i64 = text.len();
    var skip_comma_rel: i64 = (pvec_skip_comma - pvec_je_off - 2);
    text.set(pvec_je_off + 1, (skip_comma_rel) & 0xFF);
    // Load element: movq (%rbx), %rdi
    rl_pb3(text, 0x48, 0x8b, 0x3b);
    // call p_print_int
    rl_pb5(text, 0xe8, 0x00, 0x00, 0x00, 0x00);
    var pvec_print_call_off: i64 = text.len() - 4;
    // addq $8, %rbx (advance data_ptr)
    rl_pb4(text, 0x48, 0x83, 0xc3, 0x08);
    // decq %r12 (decrement remaining len)
    rl_pb3(text, 0x49, 0xff, 0xcc);
    // incq %r13 (increment index for comma check)
    rl_pb3(text, 0x49, 0xff, 0xc5);
    // jmp .loop
    var pvec_jmp_back: i64 = text.len();
    var loop_rel: i64 = (pvec_loop - pvec_jmp_back - 2) & 0xFF;
    rl_pb2(text, 0xeb, (loop_rel) & 0xFF);
    // .done:
    var pvec_done: i64 = text.len();
    var done_rel: i64 = (pvec_done - pvec_jge_off - 6);
    text.set(pvec_jge_off + 2, (done_rel & 0xFF));
    text.set(pvec_jge_off + 3, ((done_rel >> 8) & 0xFF));
    text.set(pvec_jge_off + 4, ((done_rel >> 16) & 0xFF));
    text.set(pvec_jge_off + 5, ((done_rel >> 24) & 0xFF));
    // Write ']'
    rl_pb5(text, 0xbf, 0x01, 0x00, 0x00, 0x00);
    rl_pb7(text, 0x48, 0x8d, 0x35, 0x00, 0x00, 0x00, 0x00);
    var pvec_close_lea: i64 = text.len() - 4;
    rl_pb5(text, 0xba, 0x01, 0x00, 0x00, 0x00);
    rl_pb5(text, 0xb8, 0x01, 0x00, 0x00, 0x00);
    rl_pb2(text, 0x0f, 0x05);
    // Restore callee-saved registers
    rl_pb2(text, 0x41, 0x5d);
    rl_pb2(text, 0x41, 0x5c);
    text.push(0x5b & 0xFF);
    text.push(0xc3 & 0xFF);
