// runtime_linux.fd -- Native Linux x86-64 runtime stubs
// Ported from src/runtime_linux.rs. Hand-encoded x86-64 machine code
// using raw Linux syscalls (no libc dependency).
//
// All functions use the System V AMD64 ABI:
//   - Args: RDI, RSI, RDX, RCX, R8, R9
//   - Return: RAX
//   - Syscalls: RAX=syscall#, RDI, RSI, RDX, R10, R8, R9 -> RAX

module compiler::runtime_linux;

use core;
use vec;
use string;
use compiler::elf64;

// --- Structs -------------------------------------------------------------

pub struct RuntimeSymbol {
    pub name: str,
    pub offset: i64,
    pub size: i64,
}

pub fn RuntimeSymbol_new(name: str, offset: i64, size: i64) -> RuntimeSymbol {
    return RuntimeSymbol { name: name, offset: offset, size: size };
}

pub struct RuntimeRodataSym {
    pub name: str,
    pub offset: i64,
}

pub fn RuntimeRodataSym_new(name: str, offset: i64) -> RuntimeRodataSym {
    return RuntimeRodataSym { name: name, offset: offset };
}

pub struct RuntimeReloc {
    pub offset: i64,
    pub symbol: str,
    pub rtype: i64,
}

pub fn RuntimeReloc_new(offset: i64, symbol: str, rtype: i64) -> RuntimeReloc {
    return RuntimeReloc { offset: offset, symbol: symbol, rtype: rtype };
}

pub struct RuntimeParts {
    pub text: Vec,
    pub symbols: Vec<RuntimeSymbol>,
    pub rodata: Vec,
    pub rodata_syms: Vec<RuntimeRodataSym>,
}

pub fn RuntimeParts_new(text: Vec, symbols: Vec<RuntimeSymbol>, rodata: Vec, rodata_syms: Vec<RuntimeRodataSym>) -> RuntimeParts {
    return RuntimeParts { text: text, symbols: symbols, rodata: rodata, rodata_syms: rodata_syms };
}

var g_runtime_relocations: Vec<RuntimeReloc> = Vec::new();

// --- Helpers --------------------------------------------------------------

fn rl_pb2(t: &mut Vec, a: i64, b: i64) { t.push(a & 0xFF); t.push(b & 0xFF); }
fn rl_pb1(t: &mut Vec, a: i64) { t.push(a & 0xFF); }
fn rl_pb3(t: &mut Vec, a: i64, b: i64, c: i64) { t.push(a & 0xFF); t.push(b & 0xFF); t.push(c & 0xFF); }
fn rl_pb4(t: &mut Vec, a: i64, b: i64, c: i64, d: i64) { t.push(a & 0xFF); t.push(b & 0xFF); t.push(c & 0xFF); t.push(d & 0xFF); }
fn rl_pb5(t: &mut Vec, a: i64, b: i64, c: i64, d: i64, e: i64) { t.push(a & 0xFF); t.push(b & 0xFF); t.push(c & 0xFF); t.push(d & 0xFF); t.push(e & 0xFF); }
fn rl_pb6(t: &mut Vec, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) { t.push(a & 0xFF); t.push(b & 0xFF); t.push(c & 0xFF); t.push(d & 0xFF); t.push(e & 0xFF); t.push(f & 0xFF); }
fn rl_pb7(t: &mut Vec, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) { t.push(a & 0xFF); t.push(b & 0xFF); t.push(c & 0xFF); t.push(d & 0xFF); t.push(e & 0xFF); t.push(f & 0xFF); t.push(g & 0xFF); }
fn rl_pb8(t: &mut Vec, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) { t.push(a & 0xFF); t.push(b & 0xFF); t.push(c & 0xFF); t.push(d & 0xFF); t.push(e & 0xFF); t.push(f & 0xFF); t.push(g & 0xFF); t.push(h & 0xFF); }
fn rl_pb9(t: &mut Vec, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) { t.push(a & 0xFF); t.push(b & 0xFF); t.push(c & 0xFF); t.push(d & 0xFF); t.push(e & 0xFF); t.push(f & 0xFF); t.push(g & 0xFF); t.push(h & 0xFF); t.push(i & 0xFF); }

fn add_sym(symbols: &mut Vec<RuntimeSymbol>, text: &Vec, name: str) {
    symbols.push(RuntimeSymbol { name: name, offset: text.len(), size: 0 });
}

fn push_str_bytes(rodata: &mut Vec, s: str) {
    var i: i64 = 0;
    while i < str_len(s) { rodata.push(str_byte_at(s, i)); i = i + 1; }
    rodata.push(0);
}

fn stub_capability(name: str) -> str {
    if str_starts_with(name, "p_socket_") || str_starts_with(name, "p_http_") { return "Net"; }
    if str_starts_with(name, "p_file_") || str_starts_with(name, "p_read_file") || str_starts_with(name, "p_write_file") { return "FS"; }
    if str_starts_with(name, "p_thread_") || str_equal(name, "p_spawn") { return "Spawn"; }
    return "";
}

fn cap_granted(caps_set: i64, cap: str) -> bool {
    // caps_set bitfield: bit0 = FS/IO, bit1 = Net, bit2 = Spawn
    if str_equal(cap, "FS") || str_equal(cap, "IO") { return (caps_set & 1) != 0; }
    if str_equal(cap, "Net") { return (caps_set & 2) != 0; }
    if str_equal(cap, "Spawn") { return (caps_set & 4) != 0; }
    return false;
}

fn trap_stub(text: &mut Vec) {
    text.push(0x0f); text.push(0x0b); text.push(0xc3);
}

pub fn runtime_parts() -> RuntimeParts {
    return runtime_parts_impl(false, 0);
}

pub fn runtime_parts_with_caps(granted_caps: i64) -> RuntimeParts {
    return runtime_parts_impl(true, granted_caps);
}

pub fn runtime_relocations() -> Vec<RuntimeReloc> {
    return g_runtime_relocations;
}


fn runtime_parts_impl(has_caps: bool, caps_set: i64) -> RuntimeParts {
    var text: Vec = Vec::new();
    var symbols: Vec<RuntimeSymbol> = Vec::new();
    var rodata: Vec = Vec::new();
    var rodata_syms: Vec<RuntimeRodataSym> = Vec::new();
    // Helper: push a symbol at the current text offset
    // -- Read-only data --
    var true_str_off: i64 = rodata.len();
    rodata.push(116 & 0xFF);
    rodata.push(114 & 0xFF);
    rodata.push(117 & 0xFF);
    rodata.push(101 & 0xFF);
    rodata.push(0 & 0xFF);
    var false_str_off: i64 = rodata.len();
    rodata.push(102 & 0xFF);
    rodata.push(97 & 0xFF);
    rodata.push(108 & 0xFF);
    rodata.push(115 & 0xFF);
    rodata.push(101 & 0xFF);
    rodata.push(0 & 0xFF);
    var nl_str_off: i64 = rodata.len();
    rodata.push(10 & 0xFF);
    rodata.push(0 & 0xFF);
    var minus_str_off: i64 = rodata.len();
    rodata.push(45 & 0xFF);
    rodata.push(0 & 0xFF);
    var dot_str_off: i64 = rodata.len();
    rodata.push(46 & 0xFF);
    rodata.push(0 & 0xFF);
    rodata_syms.push(RuntimeRodataSym_new(".Lpbool_true_str", true_str_off));
    rodata_syms.push(RuntimeRodataSym_new(".Lpbool_false_str", false_str_off));
    rodata_syms.push(RuntimeRodataSym_new(".Lpnl_str", nl_str_off));
    rodata_syms.push(RuntimeRodataSym_new(".Lpf_minus", minus_str_off));
    rodata_syms.push(RuntimeRodataSym_new(".Lpf_dot", dot_str_off));
    // Strings for p_print_vec
    var bracket_open_off: i64 = rodata.len();
    rodata.push(91 & 0xFF);
    rodata.push(0 & 0xFF);
    var bracket_close_off: i64 = rodata.len();
    rodata.push(93 & 0xFF);
    rodata.push(0 & 0xFF);
    var comma_sp_off: i64 = rodata.len();
    rodata.push(44 & 0xFF);
    rodata.push(32 & 0xFF);
    rodata.push(0 & 0xFF);
    rodata_syms.push(RuntimeRodataSym_new(".Lbracket_open", bracket_open_off));
    rodata_syms.push(RuntimeRodataSym_new(".Lbracket_close", bracket_close_off));
    rodata_syms.push(RuntimeRodataSym_new(".Lcomma_sp", comma_sp_off));
    // Float constants for p_print_float
    var zero_f_off: i64 = rodata.len();
    rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0);
    var ten_f_off: i64 = rodata.len();
    rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0);
    var sign_mask_off: i64 = rodata.len();
    rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0); rodata.push(0x80);
    var zero_char_off: i64 = rodata.len();
    rodata.push(48 & 0xFF);
    rodata.push(0 & 0xFF);
    rodata_syms.push(RuntimeRodataSym_new(".Lpf_zero_f", zero_f_off));
    rodata_syms.push(RuntimeRodataSym_new(".Lpf_ten_f", ten_f_off));
    rodata_syms.push(RuntimeRodataSym_new(".Lpf_sign_mask", sign_mask_off));
    rodata_syms.push(RuntimeRodataSym_new(".Lpf_zero_char", zero_char_off));
    // =======================================================================
    // _start -- program entry point
    // andq $-16, %rsp   ; align stack
    // call main         ; (relocation, filled by linker)
    // movq %rax, %rdi   ; exit code = main's return
    // movq $60, %rax    ; sys_exit
    // syscall
    // ud2
    // =======================================================================
    add_sym(symbols, text, "_start");
    // andq $-16, %rsp  -> 48 83 e4 f0
    rl_pb4(text, 0x48, 0x83, 0xe4, 0xf0);
    // call main (rel32 placeholder -- linker patches with R_X86_64_PLT32)
    rl_pb5(text, 0xe8, 0x00, 0x00, 0x00, 0x00);
    // This call needs a relocation -- we'll handle it specially in the linker
    // For now, store the relocation offset
    var _start_call_offset: i64 = text.len() - 4;
    // movq %rax, %rdi  -> 48 89 c7
    rl_pb3(text, 0x48, 0x89, 0xc7);
    // movq $60, %rax   -> 48 c7 c0 3c 00 00 00
    rl_pb7(text, 0x48, 0xc7, 0xc0, 0x3c, 0x00, 0x00, 0x00);
    // syscall           -> 0f 05
    rl_pb2(text, 0x0f, 0x05);
    // ud2              -> 0f 0b
    rl_pb2(text, 0x0f, 0x0b);
    // =======================================================================
    // p_print_str(rdi = *u8 null-terminated string)
    // Writes the string to stdout (fd=1) using sys_write.
    //
    // pushq %rbx              ; 53
    // movq %rdi, %rbx         ; 48 89 fb
    // ; strlen: rcx=ptr, rax=0
    // movq %rdi, %rcx         ; 48 89 f9
    // xorq %rax, %rax         ; 48 31 c0
    // ; loop:
    // ; cmpb $0, (%rcx)       ; 80 39 00
    // ; je done               ; 74 06
    // ; incq %rcx             ; 48 ff c1
    // ; incq %rax             ; 48 ff c0
    // ; jmp loop              ; eb f6
    // ; done:
    // ; sys_write(1, rbx, rax)
    // movq $1, %rdi           ; 48 c7 c7 01 00 00 00  (but use bf 01 00 00 00 for 32-bit)
    // movq %rbx, %rsi         ; 48 89 de
    // movq %rax, %rdx         ; 48 89 c2
    // movq $1, %rax           ; 48 c7 c0 01 00 00 00
    // syscall                 ; 0f 05
    // popq %rbx               ; 5b
    // ret                     ; c3
    // =======================================================================
    add_sym(symbols, text, "p_print_str");
    text.push(0x53 & 0xFF);
    rl_pb3(text, 0x48, 0x89, 0xfb);
    rl_pb3(text, 0x48, 0x89, 0xf9);
    rl_pb3(text, 0x48, 0x31, 0xc0);
    var pstr_loop: i64 = text.len();
    rl_pb3(text, 0x80, 0x39, 0x00);
    // je done (skip incq %rcx [3] + incq %rax [3] + jmp loop [2] = 8 bytes)
    rl_pb2(text, 0x74, 0x08);
    rl_pb3(text, 0x48, 0xff, 0xc1);
    rl_pb3(text, 0x48, 0xff, 0xc0);
    // jmp loop: backward to pstr_loop
    var jmp_back: i64 = text.len();
    var back_offset: i64 = pstr_loop - jmp_back - 2;
    rl_pb2(text, 0xeb, (back_offset) & 0xFF);
    // done:
    rl_pb5(text, 0xbf, 0x01, 0x00, 0x00, 0x00);
    rl_pb3(text, 0x48, 0x89, 0xde);
    rl_pb3(text, 0x48, 0x89, 0xc2);
    rl_pb7(text, 0x48, 0xc7, 0xc0, 0x01, 0x00, 0x00, 0x00);
    rl_pb2(text, 0x0f, 0x05);
    text.push(0x5b & 0xFF);
    text.push(0xc3 & 0xFF);
    // =======================================================================
    // p_print_int(rdi = i64 value)
    // Converts integer to decimal string and writes to stdout.
    //
    // pushq %rbx ; pushq %r12 ; pushq %r13
    // subq $32, %rsp
    // movq %rdi, %r12       ; r12 = value
    // leaq 31(%rsp), %r13   ; r13 = buffer end (rsp+31)
    // movb $0, (%r13)       ; null terminator
    // testq %r12, %r12
    // jne .notzero
    // decq %r13
    // movb $48, (%r13)      ; '0'
    // jmp .print
    // .notzero:
    // testq %r12, %r12
    // jns .pos
    // negq %r12
    // .pos:
    // .digit_loop:
    // testq %r12, %r12
    // je .digits_done
    // movq %r12, %rax
    // xorq %rdx, %rdx
    // movq $10, %rcx
    // divq %rcx             ; rax=quotient, rdx=remainder
    // movq %rax, %r12
    // addq $48, %rdx        ; '0' + remainder
    // decq %r13
    // movb %dl, (%r13)
    // jmp .digit_loop
    // .digits_done:
    // testq %rdi, %rdi      ; check original value sign
    // jns .print
    // decq %r13
    // movb $45, (%r13)      ; '-'
    // .print:
    // ; write(1, r13, (rsp+31) - r13)
    // movl $1, %edi
    // movq %r13, %rsi
    // leaq 31(%rsp), %rax
    // subq %r13, %rax       ; rax = length
    // movq %rax, %rdx
    // movq $1, %rax         ; sys_write
    // syscall
    // addq $32, %rsp
    // popq %r13 ; popq %r12 ; popq %rbx
    // ret
    // =======================================================================
    add_sym(symbols, text, "p_print_int");
    text.push(0x53 & 0xFF);
    rl_pb2(text, 0x41, 0x54);
    rl_pb2(text, 0x41, 0x55);
    rl_pb4(text, 0x48, 0x83, 0xec, 0x20);
    rl_pb3(text, 0x49, 0x89, 0xfc);
    // leaq 31(%rsp), %r13 -> 4C 8D 6C 24 1F
    rl_pb5(text, 0x4c, 0x8d, 0x6c, 0x24, 0x1f);
    // movb $0, (%r13) -> 41 C6 45 00 00 (REX.B, C6, ModRM=45: mod=01 rm=101(r13), disp8=0, imm8=0)
    rl_pb5(text, 0x41, 0xc6, 0x45, 0x00, 0x00);
    // testq %r12, %r12 -> 4D 85 E4
    rl_pb3(text, 0x4d, 0x85, 0xe4);
    // jne .notzero -> 75 XX (need to calculate offset)
    var pint_jne1: i64 = text.len();
    rl_pb2(text, 0x75, 0x00);
    // zero case:
    // decq %r13 -> 49 ff cd
    rl_pb3(text, 0x49, 0xff, 0xcd);
    // movb $48, (%r13) -> 41 C6 45 00 30 (mod=01, disp8=0, imm8='0')
    rl_pb5(text, 0x41, 0xc6, 0x45, 0x00, 0x30);
    // jmp .print -> eb XX
    var pint_jmp_print1: i64 = text.len();
    rl_pb2(text, 0xeb, 0x00);
    // .notzero:
    var pint_notzero: i64 = text.len();
    // Patch jne to jump here
    text.set(pint_jne1 + 1, (pint_notzero - pint_jne1 - 2) & 0xFF);
    // testq %r12, %r12 -> 4D 85 E4
    rl_pb3(text, 0x4d, 0x85, 0xe4);
    // jns .pos -> 79 XX
    var pint_jns: i64 = text.len();
    rl_pb2(text, 0x79, 0x00);
    // negq %r12 -> 49 F7 DC
    rl_pb3(text, 0x49, 0xf7, 0xdc);
    // .pos:
    var pint_pos: i64 = text.len();
    text.set(pint_jns + 1, (pint_pos - pint_jns - 2) & 0xFF);
    // .digit_loop:
    var pint_loop: i64 = text.len();
    // testq %r12, %r12 -> 4D 85 E4
    rl_pb3(text, 0x4d, 0x85, 0xe4);
    // je .digits_done -> 74 XX
    var pint_je_done: i64 = text.len();
    rl_pb2(text, 0x74, 0x00);
    // movq %r12, %rax -> 4C 89 E0
    rl_pb3(text, 0x4c, 0x89, 0xe0);
    // xorq %rdx, %rdx -> 48 31 D2
    rl_pb3(text, 0x48, 0x31, 0xd2);
    // movq $10, %rcx -> 48 C7 C1 0A 00 00 00
    rl_pb7(text, 0x48, 0xc7, 0xc1, 0x0a, 0x00, 0x00, 0x00);
    // divq %rcx -> 48 F7 F1
    rl_pb3(text, 0x48, 0xf7, 0xf1);
    // movq %rax, %r12 -> 49 89 C4 (REX.W=1, REX.B=1 for r12, 89, ModRM=C4: mod=11 reg=000(rax) rm=100(r12))
    rl_pb3(text, 0x49, 0x89, 0xc4);
    // addq $48, %rdx -> 48 83 C2 30
    rl_pb4(text, 0x48, 0x83, 0xc2, 0x30);
    // decq %r13 -> 49 FF CD
    rl_pb3(text, 0x49, 0xff, 0xcd);
    // movb %dl, (%r13) -> 41 88 55 00 (REX.B, 88, ModRM=55: mod=01 reg=010(dl) rm=101(r13), disp8=0)
    rl_pb4(text, 0x41, 0x88, 0x55, 0x00);
    // jmp .digit_loop -> eb XX (backward)
    var jmp_back2: i64 = text.len();
    var back2: i64 = pint_loop - jmp_back2 - 2;
    rl_pb2(text, 0xeb, (back2) & 0xFF);
    // .digits_done:
    var pint_digits_done: i64 = text.len();
    text.set(pint_je_done + 1, (pint_digits_done - pint_je_done - 2) & 0xFF);
    // testq %rdi, %rdi -> 48 85 FF
    rl_pb3(text, 0x48, 0x85, 0xff);
    // jns .print -> 79 XX
    var pint_jns2: i64 = text.len();
    rl_pb2(text, 0x79, 0x00);
    // decq %r13 -> 49 FF CD
    rl_pb3(text, 0x49, 0xff, 0xcd);
    // movb $45, (%r13) -> 41 C6 45 00 2D (mod=01, disp8=0, imm8='-')
    rl_pb5(text, 0x41, 0xc6, 0x45, 0x00, 0x2d);
    // .print:
    var pint_print: i64 = text.len();
    text.set(pint_jns2 + 1, (pint_print - pint_jns2 - 2) & 0xFF);
    text.set(pint_jmp_print1 + 1, (pint_print - pint_jmp_print1 - 2) & 0xFF);
    // movl $1, %edi -> BF 01 00 00 00
    rl_pb5(text, 0xbf, 0x01, 0x00, 0x00, 0x00);
    // movq %r13, %rsi -> 4C 89 EE
    rl_pb3(text, 0x4c, 0x89, 0xee);
    // leaq 31(%rsp), %rax -> 48 8D 44 24 1F
    rl_pb5(text, 0x48, 0x8d, 0x44, 0x24, 0x1f);
    // subq %r13, %rax -> 4C 29 E8
    rl_pb3(text, 0x4c, 0x29, 0xe8);
    // movq %rax, %rdx -> 48 89 C2
    rl_pb3(text, 0x48, 0x89, 0xc2);
    // movq $1, %rax -> 48 C7 C0 01 00 00 00
    rl_pb7(text, 0x48, 0xc7, 0xc0, 0x01, 0x00, 0x00, 0x00);
    // syscall -> 0F 05
    rl_pb2(text, 0x0f, 0x05);
    // addq $32, %rsp -> 48 83 C4 20
    rl_pb4(text, 0x48, 0x83, 0xc4, 0x20);
    rl_pb2(text, 0x41, 0x5d);
    rl_pb2(text, 0x41, 0x5c);
    text.push(0x5b & 0xFF);
    text.push(0xc3 & 0xFF);
    // =======================================================================
    // p_print_bool(rdi = 0 or 1)
    // testq %rdi, %rdi ; je .false
    // ; true: write(1, "true", 4)
    // movl $1, %edi ; leaq true_str(%rip), %rsi ; movl $4, %edx ; movl $1, %eax ; syscall ; ret
    // .false: write(1, "false", 5)
    // movl $1, %edi ; leaq false_str(%rip), %rsi ; movl $5, %edx ; movl $1, %eax ; syscall ; ret
    // =======================================================================
    add_sym(symbols, text, "p_print_bool");
    rl_pb3(text, 0x48, 0x85, 0xff);
    var pbool_je: i64 = text.len();
    rl_pb2(text, 0x74, 0x00);
    // true:
    rl_pb5(text, 0xbf, 0x01, 0x00, 0x00, 0x00);
    // leaq true_str(%rip), %rsi -> 48 8D 35 XX XX XX XX (RIP-relative)
    rl_pb7(text, 0x48, 0x8d, 0x35, 0x00, 0x00, 0x00, 0x00);
    var pbool_true_lea: i64 = text.len() - 4;
    rl_pb5(text, 0xba, 0x04, 0x00, 0x00, 0x00);
    rl_pb5(text, 0xb8, 0x01, 0x00, 0x00, 0x00);
    rl_pb2(text, 0x0f, 0x05);
    text.push(0xc3 & 0xFF);
    // false:
    var pbool_false: i64 = text.len();
    text.set(pbool_je + 1, (pbool_false - pbool_je - 2) & 0xFF);
    rl_pb5(text, 0xbf, 0x01, 0x00, 0x00, 0x00);
    rl_pb7(text, 0x48, 0x8d, 0x35, 0x00, 0x00, 0x00, 0x00);
    var pbool_false_lea: i64 = text.len() - 4;
    rl_pb5(text, 0xba, 0x05, 0x00, 0x00, 0x00);
    rl_pb5(text, 0xb8, 0x01, 0x00, 0x00, 0x00);
    rl_pb2(text, 0x0f, 0x05);
    text.push(0xc3 & 0xFF);
    // =======================================================================
    // p_print_newline()
    // write(1, "\n", 1)
    // =======================================================================
    add_sym(symbols, text, "p_print_newline");
    rl_pb5(text, 0xbf, 0x01, 0x00, 0x00, 0x00);
    rl_pb7(text, 0x48, 0x8d, 0x35, 0x00, 0x00, 0x00, 0x00);
    var pnl_lea: i64 = text.len() - 4;
    rl_pb5(text, 0xba, 0x01, 0x00, 0x00, 0x00);
    rl_pb5(text, 0xb8, 0x01, 0x00, 0x00, 0x00);
    rl_pb2(text, 0x0f, 0x05);
    text.push(0xc3 & 0xFF);
    // =======================================================================
