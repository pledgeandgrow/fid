    // Store 0.0 at 16(%rsp) (accumulator -- 8 bytes zeroed)
    rl_pb9(text, 0x48, 0xc7, 0x44, 0x24, 0x10, 0x00, 0x00, 0x00, 0x00);
    // .loop:
    var psdot_loop: i64 = text.len();
    // cmpq %r14, %r13
    rl_pb3(text, 0x4d, 0x39, 0xf5);
    // je .done
    var psdot_je: i64 = text.len();
    rl_pb6(text, 0x0f, 0x84, 0x00, 0x00, 0x00, 0x00);
    // movq (%rbx,%r14,8), %rax (a[i] as f64 bits)
    // REX.WX=0x4a to extend SIB index to r14
    rl_pb4(text, 0x4a, 0x8b, 0x04, 0xf3);
    // movq %rax, (%rsp)
    rl_pb4(text, 0x48, 0x89, 0x04, 0x24);
    // movsd (%rsp), %xmm0
    rl_pb5(text, 0xf2, 0x0f, 0x10, 0x04, 0x24);
    // movq (%r12,%r14,8), %rax (b[i] as f64 bits)
    // REX.WXB=0x4b to extend SIB index to r14 and base to r12
    rl_pb4(text, 0x4b, 0x8b, 0x04, 0xf4);
    // movq %rax, (%rsp)
    rl_pb4(text, 0x48, 0x89, 0x04, 0x24);
    // movsd (%rsp), %xmm1
    rl_pb5(text, 0xf2, 0x0f, 0x10, 0x0c, 0x24);
    // mulsd %xmm1, %xmm0 (a[i] * b[i])
    rl_pb4(text, 0xf2, 0x0f, 0x59, 0xc1);
    // movsd 16(%rsp), %xmm1 (accumulator)
    rl_pb6(text, 0xf2, 0x0f, 0x10, 0x4c, 0x24, 0x10);
    // addsd %xmm0, %xmm1 (accumulator += a[i]*b[i])
    rl_pb4(text, 0xf2, 0x0f, 0x58, 0xc8);
    // movsd %xmm1, 16(%rsp)
    rl_pb6(text, 0xf2, 0x0f, 0x11, 0x4c, 0x24, 0x10);
    // incq %r14
    rl_pb3(text, 0x49, 0xff, 0xc6);
    // jmp .loop
    var psdot_jmp: i64 = text.len();
    var psdot_back: i64 = psdot_loop - psdot_jmp - 2;
    rl_pb2(text, 0xeb, (psdot_back) & 0xFF);
    // .done:
    var psdot_done: i64 = text.len();
    var psdot_done_rel: i64 = (psdot_done - psdot_je - 6);
    text.set(psdot_je + 2, (psdot_done_rel) & 0xFF);
    text.set(psdot_je + 3, (psdot_done_rel >> 8) & 0xFF);
    text.set(psdot_je + 4, (psdot_done_rel >> 16) & 0xFF);
    text.set(psdot_je + 5, (psdot_done_rel >> 24) & 0xFF);
    // movq 16(%rsp), %rax (return accumulator as f64 bits)
    rl_pb5(text, 0x48, 0x8b, 0x44, 0x24, 0x10);
    // addq $32, %rsp
    rl_pb4(text, 0x48, 0x83, 0xc4, 0x20);
    // popq %r14 ; popq %r13 ; popq %r12 ; popq %rbx
    rl_pb2(text, 0x41, 0x5e);
    rl_pb2(text, 0x41, 0x5d);
    rl_pb2(text, 0x41, 0x5c);
