    add_sym(symbols, text, "pledge_strcmp");
    // .loop:
    var pstrcmp_loop: i64 = text.len();
    // movb (%rdi), %al
    rl_pb2(text, 0x8a, 0x07);
    // movb (%rsi), %cl
    rl_pb2(text, 0x8a, 0x0e);
    // cmpb %cl, %al
    rl_pb2(text, 0x38, 0xc1);
    // jne .diff
    var pstrcmp_jne: i64 = text.len();
    rl_pb2(text, 0x75, 0x00);
    // testq %rax, %rax (end of string)
    rl_pb2(text, 0x84, 0xc0);
    // je .equal
    var pstrcmp_je: i64 = text.len();
    rl_pb2(text, 0x74, 0x00);
    // incq %rdi ; incq %rsi
    rl_pb3(text, 0x48, 0xff, 0xc7);
    rl_pb3(text, 0x48, 0xff, 0xc6);
    // jmp .loop
    var pstrcmp_jmp: i64 = text.len();
    var pstrcmp_back: i64 = pstrcmp_loop - pstrcmp_jmp - 2;
    rl_pb2(text, 0xeb, (pstrcmp_back) & 0xFF);
    // .diff:
    var pstrcmp_diff: i64 = text.len();
    text.set(pstrcmp_jne + 1, (pstrcmp_diff - pstrcmp_jne - 2) & 0xFF);
    // movzbq %al, %rax
    rl_pb4(text, 0x48, 0x0f, 0xb6, 0xc0);
    // movzbq %cl, %rcx
    rl_pb4(text, 0x48, 0x0f, 0xb6, 0xc9);
    // subq %rcx, %rax
    rl_pb3(text, 0x48, 0x29, 0xc8);
    // jmp .ret
    var pstrcmp_jmp_ret: i64 = text.len();
    rl_pb2(text, 0xeb, 0x00);
    // .equal:
    var pstrcmp_equal: i64 = text.len();
    text.set(pstrcmp_je + 1, (pstrcmp_equal - pstrcmp_je - 2) & 0xFF);
    // xorq %rax, %rax
    rl_pb3(text, 0x48, 0x31, 0xc0);
    // .ret:
    var pstrcmp_ret: i64 = text.len();
    text.set(pstrcmp_jmp_ret, ((pstrcmp_ret - pstrcmp_jmp_ret - 1) & 0xFF) & 0xFF);
    text.push(0xc3 & 0xFF);
    // =======================================================================
    // Environment, args, and process control builtins
    // =======================================================================
    // p_exit(rdi = exit code) -> void
    // sys_exit(60) with code in rdi
    add_sym(symbols, text, "p_exit");
    // movq %rdi, %rax  -> 48 89 f8  (wait, sys_exit takes code in rdi, not rax)
    // Actually: sys_exit(code) -> rax=60, rdi=code, syscall
    // rdi already has the code, just set rax=60 and syscall
    // movq $60, %rax  -> 48 c7 c0 3c 00 00 00
    rl_pb7(text, 0x48, 0xc7, 0xc0, 0x3c, 0x00, 0x00, 0x00);
    // syscall  -> 0f 05
    rl_pb2(text, 0x0f, 0x05);
    // ud2 (should not return)
    rl_pb2(text, 0x0f, 0x0b);
    // p_getenv(rdi = name ptr) -> *u8
    // Stub: returns NULL (0) -- full implementation requires environ access
    // TODO: Save environ from _start and search it
    add_sym(symbols, text, "p_getenv");
    // xorq %rax, %rax  -> 48 31 c0
    rl_pb3(text, 0x48, 0x31, 0xc0);
    text.push(0xc3 & 0xFF);
    // p_argc() -> i64
    // Stub: returns 1 (just program name)
    // TODO: Save argc from _start
    add_sym(symbols, text, "p_argc");
    // movq $1, %rax  -> 48 c7 c0 01 00 00 00
    rl_pb7(text, 0x48, 0xc7, 0xc0, 0x01, 0x00, 0x00, 0x00);
    text.push(0xc3 & 0xFF);
    // p_argv(rdi = index) -> *u8
    // Stub: returns NULL -- full implementation requires argv access
    // TODO: Save argv from _start
    add_sym(symbols, text, "p_argv");
    // xorq %rax, %rax  -> 48 31 c0
    rl_pb3(text, 0x48, 0x31, 0xc0);
    text.push(0xc3 & 0xFF);
    // p_system(rdi = cmd ptr) -> i64
    // Uses sys_execve via /bin/sh -c <cmd>
    // This is a simplified version: forks and execs /bin/sh -c <cmd>
    // For now, stub returns -1 (not supported in native runtime)
    // TODO: Implement fork+execve with syscall 57+59
    add_sym(symbols, text, "p_system");
    // movq $-1, %rax  -> 48 c7 c0 ff ff ff ff
    rl_pb7(text, 0x48, 0xc7, 0xc0, 0xff, 0xff, 0xff, 0xff);
    text.push(0xc3 & 0xFF);
    // p_regex_match(rdi = s ptr, rsi = pattern ptr) -> bool
    // Stub: returns false -- full implementation would need string matching in assembly
    // TODO: Implement wildcard match in assembly
    add_sym(symbols, text, "p_regex_match");
    // xorq %rax, %rax  -> 48 31 c0
    rl_pb3(text, 0x48, 0x31, 0xc0);
    text.push(0xc3 & 0xFF);
    // =======================================================================
    // FFI function aliases -- c_* names used by test_ffi_full
    // These point to the same code as the pledge_* versions above.
    // We record the current text offsets as symbol addresses.
    // =======================================================================
    // For c_* aliases, we need to find the pledge_* function offsets and
    // register them under the c_* names. We'll do this after all functions
    // are emitted, using the symbols vector.
    // println is defined in stdlib/core.p and compiled by the codegen.
    // Do NOT define a runtime println thunk -- it would override the
    // user-defined println and always call p_print_int, which is wrong
    // for string values.
    // =======================================================================
    // FFI aliases: c_* names -> same offsets as pledge_* functions
    // test_ffi_full uses c_sqrt, c_pow, etc. instead of pledge_sqrt
    // =======================================================================
    // sym_map not needed in Fides (using linear search instead)
    // Alias pledge_* to c_* functions (same offset)
    var pledge_aliases: Vec<str> = Vec::new();
    pledge_aliases.push("pledge_sqrt"); pledge_aliases.push("c_sqrt");
    pledge_aliases.push("pledge_pow"); pledge_aliases.push("c_pow");
    pledge_aliases.push("pledge_floor"); pledge_aliases.push("c_floor");
    pledge_aliases.push("pledge_ceil"); pledge_aliases.push("c_ceil");
    pledge_aliases.push("pledge_sin"); pledge_aliases.push("c_sin");
    pledge_aliases.push("pledge_cos"); pledge_aliases.push("c_cos");
    pledge_aliases.push("pledge_fabs"); pledge_aliases.push("c_fabs");
    pledge_aliases.push("pledge_strlen"); pledge_aliases.push("c_strlen");
    pledge_aliases.push("pledge_strcmp"); pledge_aliases.push("c_strcmp");
    var pai: i64 = 0;
    while pai < pledge_aliases.len() {
        var pname: str = pledge_aliases.get(pai);
        var cname: str = pledge_aliases.get(pai + 1);
        var psi: i64 = 0;
        while psi < symbols.len() {
            if str_equal(symbols.get(psi).name, pname) {
                symbols.push(RuntimeSymbol_new(cname, symbols.get(psi).offset, 0));
                break;
            }
            psi = psi + 1;
        }
        pai = pai + 2;
    }
    // Now we need to collect the relocations for internal calls/jumps.
    // These are relocations within the runtime that need to be resolved
    // by the linker (calls between runtime functions).
    var relocations: Vec<RuntimeReloc> = Vec::new();
    // _start calls main -- this is an external call (to user code)
    relocations.push(RuntimeReloc { offset: _start_call_offset, symbol: "main", rtype: 4 });
    // p_print_float calls p_print_int
    relocations.push(RuntimeReloc { offset: pfloat_call1_off, symbol: "p_print_int", rtype: 4 });
    // p_str_concat calls p_malloc
    relocations.push(RuntimeReloc { offset: pstrcat_call_off, symbol: "p_malloc", rtype: 4 });
    // p_to_str calls p_malloc
    relocations.push(RuntimeReloc { offset: pts_call_off, symbol: "p_malloc", rtype: 4 });
    // p_float_to_str calls p_malloc
    relocations.push(RuntimeReloc { offset: pfts_malloc_off, symbol: "p_malloc", rtype: 4 });
    // p_bool_to_str calls p_malloc and LEA relocations
    relocations.push(RuntimeReloc { offset: pbts_malloc_off, symbol: "p_malloc", rtype: 4 });
    relocations.push(RuntimeReloc { offset: pbts_true_lea, symbol: ".Lpbool_true_str", rtype: 2 });
    relocations.push(RuntimeReloc { offset: pbts_false_lea, symbol: ".Lpbool_false_str", rtype: 2 });
    // p_vec_to_str calls p_malloc, p_vec_len, p_to_str
    relocations.push(RuntimeReloc { offset: pvts_malloc_off, symbol: "p_malloc", rtype: 4 });
    relocations.push(RuntimeReloc { offset: pvts_len_call_off, symbol: "p_vec_len", rtype: 4 });
    relocations.push(RuntimeReloc { offset: pvts_tostr_call_off, symbol: "p_to_str", rtype: 4 });
    // p_alloc jumps to p_malloc
    relocations.push(RuntimeReloc { offset: palloc_jmp_off, symbol: "p_malloc", rtype: 2 });
    // p_allocator_alloc jumps to p_malloc
    relocations.push(RuntimeReloc { offset: palloc_alloc_jmp_off, symbol: "p_malloc", rtype: 2 });
    // p_allocator_free jumps to p_free
    relocations.push(RuntimeReloc { offset: palloc_free_jmp_off, symbol: "p_free", rtype: 2 });
    // p_region_free jumps to p_free (I-1C)
    relocations.push(RuntimeReloc { offset: pregion_free_jmp_off, symbol: "p_free", rtype: 2 });
    // RIP-relative LEA relocations for rodata symbols
    // p_print_bool: true string
    relocations.push(RuntimeReloc { offset: pbool_true_lea, symbol: ".Lpbool_true_str", rtype: 1 });
    // Actually, for RIP-relative LEA, the relocation type is R_X86_64_PC32 (type 2)
    // (pop and re-push with correct type)
    relocations.push(RuntimeReloc { offset: pbool_true_lea, symbol: ".Lpbool_true_str", rtype: 2 });
    relocations.push(RuntimeReloc { offset: pbool_false_lea, symbol: ".Lpbool_false_str", rtype: 2 });
    relocations.push(RuntimeReloc { offset: pnl_lea, symbol: ".Lpnl_str", rtype: 2 });
    relocations.push(RuntimeReloc { offset: panic_nl_lea, symbol: ".Lpnl_str", rtype: 2 });
    // p_vec_new calls p_malloc
    relocations.push(RuntimeReloc { offset: pvec_new_call_off, symbol: "p_malloc", rtype: 4 });
    // Database function calls
    relocations.push(RuntimeReloc { offset: dbopen_call_off, symbol: "p_malloc", rtype: 4 });
    relocations.push(RuntimeReloc { offset: dbclose_call_off, symbol: "p_free", rtype: 4 });
    relocations.push(RuntimeReloc { offset: dbquery_malloc_call, symbol: "p_malloc", rtype: 4 });
    relocations.push(RuntimeReloc { offset: jat_malloc_call, symbol: "p_malloc", rtype: 4 });
    relocations.push(RuntimeReloc { offset: jat_empty_malloc, symbol: "p_malloc", rtype: 4 });
    // p_print_vec LEA relocations and call
    relocations.push(RuntimeReloc { offset: pvec_open_lea, symbol: ".Lbracket_open", rtype: 2 });
    relocations.push(RuntimeReloc { offset: pvec_comma_lea, symbol: ".Lcomma_sp", rtype: 2 });
    relocations.push(RuntimeReloc { offset: pvec_close_lea, symbol: ".Lbracket_close", rtype: 2 });
    relocations.push(RuntimeReloc { offset: pvec_print_call_off, symbol: "p_print_int", rtype: 4 });
    relocations.push(RuntimeReloc { offset: pvec_len_call_off, symbol: "p_vec_len", rtype: 4 });
    // Add relocations from assembly-encoded runtime functions
    // Add relocations from assembly-encoded runtime functions
    var ari: i64 = 0;
    while ari < asm_relocs.len() {
        relocations.push(RuntimeReloc { offset: asm_base + asm_relocs.get(ari).offset, symbol: asm_relocs.get(ari).symbol, rtype: asm_relocs.get(ari).rtype });
        ari = ari + 1;
    }





    // Store relocations for the linker to use
    // We'll return them as part of the symbol table via a global
    g_runtime_relocations = relocations;
    return RuntimeParts { text: text, symbols: symbols, rodata: rodata, rodata_syms: rodata_syms };
}
