        Effect::Diverge => {
            match b {
                Effect::Diverge => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Effect::Read => {
            match b {
                Effect::Read => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Effect::Write => {
            match b {
                Effect::Write => {
                    return true;
                }, _ => {
