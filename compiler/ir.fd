// --- EffectSet -----------------------------------------------------------

pub struct EffectSet {
    pub effects: Vec<Effect>,
}

pub fn EffectSet_new() -> EffectSet {
    return EffectSet {
        effects: Vec::new()
    };
}

pub fn EffectSet_none() -> EffectSet {
    return EffectSet {
        effects: Vec::new()
    };
}

pub fn EffectSet_add(self: & mut EffectSet, effect: Effect) {
    if !EffectSet_contains(self, effect) {
        self.effects.push(effect);
    }
}

pub fn EffectSet_add_all(self: & mut EffectSet, other: & EffectSet) {
    var i: i64 = 0;
    while i < other.effects.len() {
        EffectSet_add(self, other.effects.get(i));
        i = i + 1;
    }
}

pub fn EffectSet_contains(self: & EffectSet, effect: Effect) -> bool {
    var i: i64 = 0;
    while i < self.effects.len() {
        if effect_eq(self.effects.get(i), effect) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn EffectSet_is_pure(self: & EffectSet) -> bool {
    return self.effects.len() == 0;
}

pub fn EffectSet_is_read_only(self: & EffectSet) -> bool {
    var i: i64 = 0;
    while i < self.effects.len() {
        match self.effects.get(i) {
            Effect::Read => {
            }
            _ => {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

pub fn EffectSet_has_side_effects(self: & EffectSet) -> bool {
    var i: i64 = 0;
    while i < self.effects.len() {
        match self.effects.get(i) {
            Effect::Read => {
            }
            _ => {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

pub fn EffectSet_parse_effect(s: str) -> OptU64 {
    var lower: str = str_to_lower(s);
    if lower == "alloc" {
        return OptU64::Some(0);
    }
    if lower == "io" {
        return OptU64::Some(1);
    }
    if lower == "net" {
        return OptU64::Some(2);
    }
    if lower == "spawn" {
        return OptU64::Some(3);
    }
    if lower == "diverge" {
        return OptU64::Some(4);
    }
    if lower == "read" {
        return OptU64::Some(5);
    }
    if lower == "write" {
        return OptU64::Some(6);
    }
    return OptU64::None;
}

pub fn EffectSet_to_str(self: & EffectSet) -> str {
    if self.effects.len() == 0 {
        return "pure";
    }
    var result: str = "!";
    var i: i64 = 0;
    while i < self.effects.len() {
        if i > 0 {
            result = result + ",";
        }
        result = result + effect_to_str(self.effects.get(i));
        i = i + 1;
    }
    return result;
}

// --- Regions -------------------------------------------------------------

pub enum Region {
    Stack,
    Heap,
    Static,
    Named(str),
}

pub fn region_to_str(r: Region) -> str {
    match r {
        Region::Stack => {
            return "stack";
        }
        Region::Heap => {
            return "heap";
        }
        Region::Static => {
            return "static";
        }
        Region::Named(name) => {
            return "region." + name;
        }
    }
    return "?";
}

pub fn region_eq(a: Region, b: Region) -> bool {
    match a {
        Region::Stack => {
            match b {
                Region::Stack => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Region::Heap => {
            match b {
                Region::Heap => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Region::Static => {
            match b {
                Region::Static => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Region::Named(n1) => {
            match b {
                Region::Named(n2) => {
                    return n1 == n2;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
    }
    return false;
}

// --- BorrowKind ----------------------------------------------------------

pub enum BorrowKind {
    None,
    Shared,
    Mut,
}

pub fn borrow_kind_eq(a: BorrowKind, b: BorrowKind) -> bool {
    match a {
        BorrowKind::None => {
            match b {
                BorrowKind::None => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        BorrowKind::Shared => {
            match b {
                BorrowKind::Shared => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        BorrowKind::Mut => {
            match b {
                BorrowKind::Mut => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
    }
    return false;
}

// --- SSA Value / Block IDs -----------------------------------------------

pub fn value_id_to_str(id: i64) -> str {
    return "%" + int_to_str(id);
}

pub fn block_id_to_str(id: i64) -> str {
    return "bb" + int_to_str(id);
}

// --- ValueMeta -----------------------------------------------------------

pub struct ValueMeta {
    pub ty: IrType,
    pub region: Region,
    pub effects: EffectSet,
    pub source_line: OptU64,
    pub in_sandbox: bool,
    pub is_linear: bool,
    pub borrow_kind: BorrowKind,
}

pub fn ValueMeta_new(ty: IrType) -> ValueMeta {
    return ValueMeta {
        ty: ty, region: Region::Stack, effects: EffectSet_new(), source_line: OptU64::None, in_sandbox: false, is_linear: false, borrow_kind: BorrowKind::None,
    };
}

pub fn ValueMeta_with_type(old: ValueMeta, new_ty: IrType) -> ValueMeta {
    return ValueMeta {
        ty: new_ty, region: old.region, effects: old.effects, source_line: old.source_line, in_sandbox: old.in_sandbox, is_linear: old.is_linear, borrow_kind: old.borrow_kind,
    };
}

// --- Instructions --------------------------------------------------------
// All struct-style enum variants converted to tuple-style (Fides convention).

pub enum Inst {
    // --- Constants ---
    ConstInt(i64, IrType),
    ConstFloat(f64, IrType),
    ConstBool(bool),
    ConstStr(str),
    ConstFnRef(str),
    ConstNull(IrType),

    // --- Globals ---
    // Get the address of a module-level mutable global variable.
    // Returns a pointer that can be used with Load/Store.
    GlobalAddr(str, IrType),

    // --- Arithmetic ---
    BinOp(BinOp, i64, i64, IrType),
    UnaryOp(UnaryOp, i64, IrType),

    // --- Memory ---
    Alloca(IrType, Region),
    Load(i64, IrType),
    Store(i64, i64, OptIrType),
    GetFieldPtr(i64, i64, IrType),
    GetElemPtr(i64, i64, IrType),

    // --- Control Flow ---
    Jump(i64),
    Branch(i64, i64, i64),
    // ME28/MI27: multi-way branch on an integer: (value, keys, targets,
    // default); keys distinct, targets[i] is the block for keys[i]. Formed
    // from compare chains by IrFunction_form_switches, after the mid-end.
    Switch(i64, Vec<i64>, Vec<i64>, i64),
    Return(OptValueId),
    Unreachable,

    // --- Function Calls ---
    Call(str, Vec<i64>, IrType, EffectSet),
    CallPtr(i64, Vec<i64>, IrType, EffectSet, bool),
    DynCall(str, str, Vec<i64>, IrType, EffectSet),
    MakeDyn(i64, str, str),

    // --- Conversions ---
    BitCast(i64, IrType, IrType),
    IntExtend(i64, IrType, IrType),
    IntTrunc(i64, IrType, IrType),
    IntToFloat(i64, IrType, IrType),
    FloatToInt(i64, IrType, IrType),

    // --- Fides-Specific ---
    TryUnwrap(i64, i64, i64, i64),
    Print(i64, IrType),
    Panic(str),
    Asm(str, Vec<StringValueId>, Vec<StringValueId>, IrType),

    // --- Region Management ---
    RegionBegin(str, bool, bool, OptU64),
    RegionEnd(str, bool, bool),

    // --- Persist Variables ---
    PersistLoad(str, i64, IrType),
    PersistSave(str, i64),

    // --- Transaction Blocks ---
    TxnBegin,
    TxnEnd,

    // --- Unsafe Blocks ---
    UnsafeBegin,
    UnsafeEnd,

    // --- Autograd ---
    GradBegin(str),
    GradEnd,
    Backward(i64),

    // --- Struct Copy ---
    StructCopy(i64, i64, IrType),  // (dst, src, ty) — memcpy struct by value
}

// --- Inst methods --------------------------------------------------------

pub fn inst_result_type(inst: Inst) -> IrType {
    match inst {
        Inst::ConstInt(_, ty) => {
            return ty;
        }
        Inst::ConstFloat(_, ty) => {
            return ty;
        }
        Inst::ConstBool(_) => {
            return IrType::Bool;
        }
        Inst::ConstStr(_) => {
            return IrType::Ptr(Box::new(IrType::U8));
        }
        Inst::ConstFnRef(_) => {
            return IrType::I64;
        }
        Inst::ConstNull(ty) => {
            return ty;
        }
        Inst::GlobalAddr(_, ty) => {
            return IrType::Ptr(Box::new(ty));
        }
        Inst::BinOp(_, _, _, ty) => {
            return ty;
        }
        Inst::UnaryOp(_, _, ty) => {
            return ty;
        }
        Inst::Alloca(ty, _) => {
            return IrType::Ptr(Box::new(ty));
        }
        Inst::Load(_, ty) => {
            return ty;
        }
        Inst::Store(_, _, _) => {
            return IrType::Void;
        }
        Inst::GetFieldPtr(_, _, field_ty) => {
            return IrType::Ptr(Box::new(field_ty));
        }
        Inst::GetElemPtr(_, _, elem_ty) => {
            return IrType::Ptr(Box::new(elem_ty));
        }
        Inst::Jump(_) => {
            return IrType::Void;
        }
        Inst::Branch(_, _, _) => {
            return IrType::Void;
        }
        Inst::Switch(_, _, _, _) => {
            return IrType::Void;
        }
        Inst::Return(_) => {
            return IrType::Void;
        }
        Inst::Unreachable => {
            return IrType::Void;
        }
        Inst::Call(_, _, ret_ty, _) => {
            return ret_ty;
        }
        Inst::CallPtr(_, _, ret_ty, _, _) => {
            return ret_ty;
        }
        Inst::DynCall(_, _, _, ret_ty, _) => {
            return ret_ty;
        }
        Inst::MakeDyn(_, _, _) => {
            return IrType::Opaque("dyn");
        }
        Inst::BitCast(_, _, to) => {
            return to;
        }
        Inst::IntExtend(_, _, to) => {
            return to;
        }
        Inst::IntTrunc(_, _, to) => {
            return to;
        }
        Inst::IntToFloat(_, _, to) => {
            return to;
        }
        Inst::FloatToInt(_, _, to) => {
            return to;
        }
        Inst::TryUnwrap(_, _, _, _) => {
            return IrType::Void;
        }
        Inst::Print(_, _) => {
            return IrType::Void;
        }
        Inst::Panic(_) => {
            return IrType::Never;
        }
        Inst::Asm(_, _, _, ret_ty) => {
            return ret_ty;
        }
        Inst::RegionBegin(_, _, _, _) => {
            return IrType::I64;
        }
        Inst::RegionEnd(_, _, _) => {
            return IrType::Void;
        }
        Inst::PersistLoad(_, _, ty) => {
            return ty;
        }
        Inst::PersistSave(_, _) => {
            return IrType::Void;
        }
        Inst::TxnBegin => {
            return IrType::Void;
        }
        Inst::TxnEnd => {
            return IrType::Void;
        }
        Inst::UnsafeBegin => {
            return IrType::Void;
        }
        Inst::UnsafeEnd => {
            return IrType::Void;
        }
        Inst::GradBegin(_) => {
            return IrType::Void;
        }
        Inst::GradEnd => {
            return IrType::Void;
        }
        Inst::Backward(_) => {
            return IrType::Void;
        }
        Inst::StructCopy(_, _, _) => {
            return IrType::Void;
        }
    }
    return IrType::Void;
}

pub fn inst_effects(inst: & Inst) -> EffectSet {
    var effects: EffectSet = EffectSet_new();
    match inst {
        Inst::Alloca(_, _) => {
            EffectSet_add(& mut effects, Effect::Alloc);
        }
        Inst::Load(_, _) => {
            EffectSet_add(& mut effects, Effect::Read);
        }
        Inst::Store(_, _, _) => {
            EffectSet_add(& mut effects, Effect::Write);
        }
        Inst::Call(_, _, _, e) => {
            EffectSet_add_all(& mut effects, e);
        }
        Inst::CallPtr(_, _, _, e, _) => {
            EffectSet_add_all(& mut effects, e);
        }
        Inst::DynCall(_, _, _, _, e) => {
            EffectSet_add_all(& mut effects, e);
        }
        Inst::MakeDyn(_, _, _) => {
        }
        Inst::Print(_, _) => {
            EffectSet_add(& mut effects, Effect::IO);
            EffectSet_add(& mut effects, Effect::Read);
        }
        Inst::Panic(_) => {
            EffectSet_add(& mut effects, Effect::Diverge);
        }
        Inst::Asm(_, _, _, _) => {
            EffectSet_add(& mut effects, Effect::Read);
            EffectSet_add(& mut effects, Effect::Write);
        }
        Inst::TryUnwrap(_, _, _, _) => {
            EffectSet_add(& mut effects, Effect::Read);
        }
        Inst::Unreachable => {
            EffectSet_add(& mut effects, Effect::Diverge);
        }
        Inst::RegionBegin(_, _, _, _) => {
            EffectSet_add(& mut effects, Effect::Alloc);
        }
        Inst::RegionEnd(_, _, _) => {
            EffectSet_add(& mut effects, Effect::Alloc);
            EffectSet_add(& mut effects, Effect::Write);
        }
        Inst::PersistLoad(_, _, _) => {
            EffectSet_add(& mut effects, Effect::Read);
        }
        Inst::PersistSave(_, _) => {
            EffectSet_add(& mut effects, Effect::Write);
        }
        Inst::TxnBegin => {
            EffectSet_add(& mut effects, Effect::Write);
        }
        Inst::TxnEnd => {
            EffectSet_add(& mut effects, Effect::Write);
        }
        Inst::UnsafeBegin => {
        }
        Inst::UnsafeEnd => {
        }
        Inst::GradBegin(_) => {
            EffectSet_add(& mut effects, Effect::Diff);
        }
        Inst::GradEnd => {
            EffectSet_add(& mut effects, Effect::Diff);
        }
        Inst::Backward(_) => {
            EffectSet_add(& mut effects, Effect::Diff);
        }
        Inst::StructCopy(_, _, _) => {
            EffectSet_add(& mut effects, Effect::Write);
        }
        _ => {
        }
    }
    return effects;
}

