// ir.fd — Fides IR types, rewritten from src/ir.rs (1761 LOC Rust)
//
// This module defines the typed SSA IR used by the Fides compiler:
// - IrType: IR-level types (simpler than AST types)
// - Effect / EffectSet: effect tracking (Fides's key differentiator)
// - Region: memory region annotations
// - Inst: IR instructions (~40 variants)
// - BasicBlock, IrFunction, IrModule: IR structure
// - lower_type: AST → IR type lowering
// - Verification pass
//
// Adaptations from Rust:
// 1. String -> str, usize/u32/u64 -> i64
// 2. HashMap<K,V> -> Vec-based maps with helper structs (Fides HashMap is
//    i64→i64 only; Vec+linear search is simpler for type definitions)
// 3. Option<T> for non-i64 -> Opt* enums or -1 sentinel
// 4. Vec<(A,B)> -> helper structs (ValuePair, StringValuePair, etc.)
// 5. struct-style enum variants -> tuple-style (Fides convention)
// 6. #[derive(Debug,Clone,PartialEq)] -> manual where needed
// 7. impl blocks -> free functions or impl blocks
//
// Dependencies: compiler::ast (for BinOp, UnaryOp, Type, ExternDecl)

module compiler::ir;

use core;
use vec;
use string;
use compiler::ast;

// ─── Helper structs for Vec<(A, B)> fields ──────────────────────────────

pub struct ValueIdType {
    pub id: i64,
    pub ty: IrType,
}

pub fn ValueIdType_new(id: i64, ty: IrType) -> ValueIdType {
    return ValueIdType { id: id, ty: ty };
}

pub struct StringIrType {
    pub name: str,
    pub ty: IrType,
}

pub fn StringIrType_new(name: str, ty: IrType) -> StringIrType {
    return StringIrType { name: name, ty: ty };
}

pub struct StringValueId {
    pub name: str,
    pub id: i64,
}

pub fn StringValueId_new(name: str, id: i64) -> StringValueId {
    return StringValueId { name: name, id: id };
}

pub struct ValueIdString {
    pub id: i64,
    pub name: str,
}

pub fn ValueIdString_new(id: i64, name: str) -> ValueIdString {
    return ValueIdString { id: id, name: name };
}

pub struct StringVecIrType {
    pub name: str,
    pub params: Vec<IrType>,
    pub ret: IrType,
}

pub fn StringVecIrType_new(name: str, params: Vec<IrType>, ret: IrType) -> StringVecIrType {
    return StringVecIrType { name: name, params: params, ret: ret };
}

pub struct StringVecStr {
    pub name: str,
    pub items: Vec<str>,
}

pub fn StringVecStr_new(name: str, items: Vec<str>) -> StringVecStr {
    return StringVecStr { name: name, items: items };
}

pub struct StringIrTypeOffset {
    pub name: str,
    pub ty: IrType,
    pub offset: i64,
}

pub fn StringIrTypeOffset_new(name: str, ty: IrType, offset: i64) -> StringIrTypeOffset {
    return StringIrTypeOffset { name: name, ty: ty, offset: offset };
}

pub struct StringValueIdEntry {
    pub name: str,
    pub id: i64,
}

pub fn StringValueIdEntry_new(name: str, id: i64) -> StringValueIdEntry {
    return StringValueIdEntry { name: name, id: id };
}

// ─── Optional-value enums ────────────────────────────────────────────────

pub enum OptIrType {
    Some(IrType),
    None,
}

pub enum OptValueId {
    Some(i64),
    None,
}

pub enum OptU64 {
    Some(i64),
    None,
}

pub enum OptString {
    Some(str),
    None,
}

// Forward-declared Option types (must appear before functions that return them
// for cross-module match patterns to typecheck correctly).
pub enum OptInst {
    Some(Inst),
    None,
}

pub enum OptValueMeta {
    Some(ValueMeta),
    None,
}

pub enum OptStructLayout {
    Some(StructLayout),
    None,
}

pub enum OptIrFunction {
    Some(IrFunction),
    None,
}

// ─── IR Types ────────────────────────────────────────────────────────────

pub enum IrType {
    I8,
    I16,
    I32,
    I64,
    U8,
    U16,
    U32,
    U64,
    F32,
    F64,
    Bool,
    Ptr(Box<IrType>),
    Struct(str),
    Array(Box<IrType>, i64),
    Void,
    Never,
    Opaque(str),
    Generic(str, Vec<IrType>),
}

// ─── IrType methods ──────────────────────────────────────────────────────

pub fn ir_type_size(t: IrType) -> i64 {
    match t {
        IrType::I8 => { return 1; }
        IrType::U8 => { return 1; }
        IrType::Bool => { return 1; }
        IrType::I16 => { return 2; }
        IrType::U16 => { return 2; }
        IrType::I32 => { return 4; }
        IrType::U32 => { return 4; }
        IrType::F32 => { return 4; }
        IrType::I64 => { return 8; }
        IrType::U64 => { return 8; }
        IrType::F64 => { return 8; }
        IrType::Ptr(_) => { return 8; }
        IrType::Struct(_) => { return 0; }
        IrType::Array(elem, count) => {
            var elem_size: i64 = box_ir_type_size(elem);
            return elem_size * count;
        }
        IrType::Void => { return 0; }
        IrType::Never => { return 0; }
        IrType::Opaque(_) => { return 8; }
        IrType::Generic(_, _) => { return 8; }
    }
    return 0;
}

// Box<IrType> variant — Fides auto-unboxes in match patterns.
pub fn box_ir_type_size(b: Box<IrType>) -> i64 {
    match b {
        IrType::I8 => { return 1; }
        IrType::U8 => { return 1; }
        IrType::Bool => { return 1; }
        IrType::I16 => { return 2; }
        IrType::U16 => { return 2; }
        IrType::I32 => { return 4; }
        IrType::U32 => { return 4; }
        IrType::F32 => { return 4; }
        IrType::I64 => { return 8; }
        IrType::U64 => { return 8; }
        IrType::F64 => { return 8; }
        IrType::Ptr(_) => { return 8; }
        IrType::Struct(_) => { return 0; }
        IrType::Array(elem, count) => {
            var elem_size: i64 = box_ir_type_size(elem);
            return elem_size * count;
        }
        IrType::Void => { return 0; }
        IrType::Never => { return 0; }
        IrType::Opaque(_) => { return 8; }
        IrType::Generic(_, _) => { return 8; }
    }
    return 0;
}

pub fn ir_type_align(t: IrType) -> i64 {
    match t {
        IrType::I8 => { return 1; }
        IrType::U8 => { return 1; }
        IrType::Bool => { return 1; }
        IrType::I16 => { return 2; }
        IrType::U16 => { return 2; }
        IrType::I32 => { return 4; }
        IrType::U32 => { return 4; }
        IrType::F32 => { return 4; }
        IrType::I64 => { return 8; }
        IrType::U64 => { return 8; }
        IrType::F64 => { return 8; }
        IrType::Ptr(_) => { return 8; }
        IrType::Struct(_) => { return 8; }
        IrType::Array(elem, _) => { return box_ir_type_align(elem); }
        IrType::Void => { return 1; }
        IrType::Never => { return 1; }
        IrType::Opaque(_) => { return 8; }
        IrType::Generic(_, _) => { return 8; }
    }
    return 8;
}

pub fn box_ir_type_align(b: Box<IrType>) -> i64 {
    match b {
        IrType::I8 => { return 1; }
        IrType::U8 => { return 1; }
        IrType::Bool => { return 1; }
        IrType::I16 => { return 2; }
        IrType::U16 => { return 2; }
        IrType::I32 => { return 4; }
        IrType::U32 => { return 4; }
        IrType::F32 => { return 4; }
        IrType::I64 => { return 8; }
        IrType::U64 => { return 8; }
        IrType::F64 => { return 8; }
        IrType::Ptr(_) => { return 8; }
        IrType::Struct(_) => { return 8; }
        IrType::Array(elem, _) => { return box_ir_type_align(elem); }
        IrType::Void => { return 1; }
        IrType::Never => { return 1; }
        IrType::Opaque(_) => { return 8; }
        IrType::Generic(_, _) => { return 8; }
    }
    return 8;
}

pub fn ir_type_is_int(t: IrType) -> bool {
    match t {
        IrType::I8 => { return true; }
        IrType::I16 => { return true; }
        IrType::I32 => { return true; }
        IrType::I64 => { return true; }
        IrType::U8 => { return true; }
        IrType::U16 => { return true; }
        IrType::U32 => { return true; }
        IrType::U64 => { return true; }
        IrType::Bool => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn ir_type_is_float(t: IrType) -> bool {
    match t {
        IrType::F32 => { return true; }
        IrType::F64 => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn ir_type_is_ptr(t: IrType) -> bool {
    match t {
        IrType::Ptr(_) => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn ir_type_is_ptr_like(t: IrType) -> bool {
    match t {
        IrType::Ptr(_) => { return true; }
        IrType::Opaque(_) => { return true; }
        IrType::Generic(_, _) => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn ir_type_is_opaque_named(t: IrType, name: str) -> bool {
    match t {
        IrType::Opaque(n) => { return str_equal(n, name); }
        IrType::Generic(n, _) => { return str_equal(n, name); }
        _ => { return false; }
    }
    return false;
}

pub fn ir_type_generic_elem(t: IrType) -> OptIrType {
    match t {
        IrType::Generic(_, args) => {
            if args.len() > 0 {
                return OptIrType::Some(args.get(0));
            }
            return OptIrType::None;
        }
        _ => { return OptIrType::None; }
    }
    return OptIrType::None;
}

pub fn ir_type_generic_args(t: IrType) -> Vec<IrType> {
    match t {
        IrType::Generic(_, args) => { return args; }
        _ => { return Vec::new(); }
    }
    return Vec::new();
}

pub fn ir_type_is_signed(t: IrType) -> bool {
    match t {
        IrType::I8 => { return true; }
        IrType::I16 => { return true; }
        IrType::I32 => { return true; }
        IrType::I64 => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn ir_type_is_unsigned(t: IrType) -> bool {
    match t {
        IrType::U8 => { return true; }
        IrType::U16 => { return true; }
        IrType::U32 => { return true; }
        IrType::U64 => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn ir_type_is_numeric(t: IrType) -> bool {
    return ir_type_is_int(t) || ir_type_is_float(t);
}

pub fn ir_type_is_scalar(t: IrType) -> bool {
    return ir_type_is_numeric(t) || ir_type_eq(t, IrType::Bool);
}

pub fn ir_type_is_aggregate(t: IrType) -> bool {
    match t {
        IrType::Struct(_) => { return true; }
        IrType::Array(_, _) => { return true; }
        IrType::Opaque(_) => { return true; }
        IrType::Generic(_, _) => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn ir_type_is_collection(t: IrType) -> bool {
    return ir_type_is_opaque_named(t, "Vec") || ir_type_is_opaque_named(t, "HashMap");
}

pub fn ir_type_is_never(t: IrType) -> bool {
    return ir_type_eq(t, IrType::Never);
}

pub fn ir_type_is_void(t: IrType) -> bool {
    return ir_type_eq(t, IrType::Void);
}

pub fn ir_type_collection_elem(t: IrType) -> OptIrType {
    match t {
        IrType::Generic(name, args) => {
            if name == "Vec" {
                if args.len() > 0 {
                    return OptIrType::Some(args.get(0));
                }
                return OptIrType::None;
            }
            if name == "HashMap" {
                if args.len() > 1 {
                    return OptIrType::Some(args.get(1));
                }
                return OptIrType::None;
            }
            return OptIrType::None;
        }
        _ => { return OptIrType::None; }
    }
    return OptIrType::None;
}

pub fn ir_type_map_key_type(t: IrType) -> OptIrType {
    match t {
        IrType::Generic(name, args) => {
            if name == "HashMap" {
                if args.len() > 0 {
                    return OptIrType::Some(args.get(0));
                }
            }
            return OptIrType::None;
        }
        _ => { return OptIrType::None; }
    }
    return OptIrType::None;
}

pub fn ir_type_map_value_type(t: IrType) -> OptIrType {
    match t {
        IrType::Generic(name, args) => {
            if name == "HashMap" {
                if args.len() > 1 {
                    return OptIrType::Some(args.get(1));
                }
            }
            return OptIrType::None;
        }
        _ => { return OptIrType::None; }
    }
    return OptIrType::None;
}

pub fn box_ir_type_eq(a: Box<IrType>, b: Box<IrType>) -> bool {
    return ir_type_eq(box_ir_type_unbox(a), box_ir_type_unbox(b));
}

pub fn box_ir_type_unbox(b: Box<IrType>) -> IrType {
    match b {
        IrType::I8 => { return IrType::I8; }
        IrType::I16 => { return IrType::I16; }
        IrType::I32 => { return IrType::I32; }
        IrType::I64 => { return IrType::I64; }
        IrType::U8 => { return IrType::U8; }
        IrType::U16 => { return IrType::U16; }
        IrType::U32 => { return IrType::U32; }
        IrType::U64 => { return IrType::U64; }
        IrType::F32 => { return IrType::F32; }
        IrType::F64 => { return IrType::F64; }
        IrType::Bool => { return IrType::Bool; }
        IrType::Ptr(inner) => { return IrType::Ptr(inner); }
        IrType::Struct(n) => { return IrType::Struct(n); }
        IrType::Array(e, c) => { return IrType::Array(e, c); }
        IrType::Void => { return IrType::Void; }
        IrType::Never => { return IrType::Never; }
        IrType::Opaque(n) => { return IrType::Opaque(n); }
        IrType::Generic(n, args) => { return IrType::Generic(n, args); }
    }
    return IrType::Void;
}

pub fn ir_type_eq(a: IrType, b: IrType) -> bool {
    match a {
        IrType::I8 => { return ir_type_eq_variant(b, 0); }
        IrType::I16 => { return ir_type_eq_variant(b, 1); }
        IrType::I32 => { return ir_type_eq_variant(b, 2); }
        IrType::I64 => { return ir_type_eq_variant(b, 3); }
        IrType::U8 => { return ir_type_eq_variant(b, 4); }
        IrType::U16 => { return ir_type_eq_variant(b, 5); }
        IrType::U32 => { return ir_type_eq_variant(b, 6); }
        IrType::U64 => { return ir_type_eq_variant(b, 7); }
        IrType::F32 => { return ir_type_eq_variant(b, 8); }
        IrType::F64 => { return ir_type_eq_variant(b, 9); }
        IrType::Bool => { return ir_type_eq_variant(b, 10); }
        IrType::Void => { return ir_type_eq_variant(b, 14); }
        IrType::Never => { return ir_type_eq_variant(b, 15); }
        IrType::Struct(n1) => {
            match b {
                IrType::Struct(n2) => { return n1 == n2; }
                _ => { return false; }
            }
            return false;
        }
        IrType::Opaque(n1) => {
            match b {
                IrType::Opaque(n2) => { return n1 == n2; }
                _ => { return false; }
            }
            return false;
        }
        IrType::Ptr(inner1) => {
            match b {
                IrType::Ptr(inner2) => { return box_ir_type_eq(inner1, inner2); }
                _ => { return false; }
            }
            return false;
        }
        IrType::Array(e1, c1) => {
            match b {
                IrType::Array(e2, c2) => {
                    if c1 != c2 { return false; }
                    return box_ir_type_eq(e1, e2);
                }
                _ => { return false; }
            }
            return false;
        }
        IrType::Generic(n1, args1) => {
            match b {
                IrType::Generic(n2, args2) => {
                    if n1 != n2 { return false; }
                    if args1.len() != args2.len() { return false; }
                    var gi: i64 = 0;
                    while gi < args1.len() {
                        if !ir_type_eq(args1.get(gi), args2.get(gi)) { return false; }
                        gi = gi + 1;
                    }
                    return true;
                }
                _ => { return false; }
            }
            return false;
        }
    }
    return false;
}

fn ir_type_eq_variant(t: IrType, variant: i64) -> bool {
    match t {
        IrType::I8 => { return variant == 0; }
        IrType::I16 => { return variant == 1; }
        IrType::I32 => { return variant == 2; }
        IrType::I64 => { return variant == 3; }
        IrType::U8 => { return variant == 4; }
        IrType::U16 => { return variant == 5; }
        IrType::U32 => { return variant == 6; }
        IrType::U64 => { return variant == 7; }
        IrType::F32 => { return variant == 8; }
        IrType::F64 => { return variant == 9; }
        IrType::Bool => { return variant == 10; }
        IrType::Void => { return variant == 14; }
        IrType::Never => { return variant == 15; }
        _ => { return false; }
    }
    return false;
}

pub fn ir_type_is_compatible_with(a: IrType, b: IrType) -> bool {
    if ir_type_eq(a, b) { return true; }
    match a {
        IrType::Opaque(n1) => {
            match b {
                IrType::Generic(n2, _) => { return n1 == n2; }
                IrType::Ptr(_) => { return true; }
                _ => { return false; }
            }
            return false;
        }
        IrType::Generic(n1, _) => {
            match b {
                IrType::Opaque(n2) => { return n1 == n2; }
                _ => { return false; }
            }
            return false;
        }
        IrType::Ptr(inner_a) => {
            match b {
                IrType::Ptr(inner_b) => { return box_ir_type_is_compatible_with(inner_a, inner_b); }
                IrType::Opaque(_) => { return true; }
                _ => { return false; }
            }
            return false;
        }
        _ => { return false; }
    }
    return false;
}

pub fn box_ir_type_is_compatible_with(a: Box<IrType>, b: Box<IrType>) -> bool {
    match a {
        IrType::Opaque(n1) => {
            match b {
                IrType::Generic(n2, _) => { return n1 == n2; }
                IrType::Ptr(_) => { return true; }
                _ => { return false; }
            }
            return false;
        }
        IrType::Generic(n1, _) => {
            match b {
                IrType::Opaque(n2) => { return n1 == n2; }
                _ => { return false; }
            }
            return false;
        }
        IrType::Ptr(inner_a) => {
            match b {
                IrType::Ptr(inner_b) => { return box_ir_type_is_compatible_with(inner_a, inner_b); }
                IrType::Opaque(_) => { return true; }
                _ => { return false; }
            }
            return false;
        }
        _ => { return false; }
    }
    return false;
}

pub fn ir_type_bit_width(t: IrType) -> OptU64 {
    match t {
        IrType::I8 => { return OptU64::Some(8); }
        IrType::U8 => { return OptU64::Some(8); }
        IrType::Bool => { return OptU64::Some(8); }
        IrType::I16 => { return OptU64::Some(16); }
        IrType::U16 => { return OptU64::Some(16); }
        IrType::I32 => { return OptU64::Some(32); }
        IrType::U32 => { return OptU64::Some(32); }
        IrType::F32 => { return OptU64::Some(32); }
        IrType::I64 => { return OptU64::Some(64); }
        IrType::U64 => { return OptU64::Some(64); }
        IrType::F64 => { return OptU64::Some(64); }
        IrType::Ptr(_) => { return OptU64::Some(64); }
        _ => { return OptU64::None; }
    }
    return OptU64::None;
}

// ─── IrType Display ──────────────────────────────────────────────────────

pub fn ir_type_to_str(t: IrType) -> str {
    match t {
        IrType::I8 => { return "i8"; }
        IrType::I16 => { return "i16"; }
        IrType::I32 => { return "i32"; }
        IrType::I64 => { return "i64"; }
        IrType::U8 => { return "u8"; }
        IrType::U16 => { return "u16"; }
        IrType::U32 => { return "u32"; }
        IrType::U64 => { return "u64"; }
        IrType::F32 => { return "f32"; }
        IrType::F64 => { return "f64"; }
        IrType::Bool => { return "bool"; }
        IrType::Ptr(inner) => {
            var inner_str: str = box_ir_type_to_str(inner);
            return "*" + inner_str;
        }
        IrType::Struct(name) => {
            return "struct." + name;
        }
        IrType::Array(elem, count) => {
            var elem_str: str = box_ir_type_to_str(elem);
            return "[" + elem_str + "; " + int_to_str(count) + "]";
        }
        IrType::Void => { return "void"; }
        IrType::Never => { return "never"; }
        IrType::Opaque(name) => {
            return "opaque." + name;
        }
        IrType::Generic(name, args) => {
            var result: str = "generic." + name + "<";
            var i: i64 = 0;
            while i < args.len() {
                if i > 0 { result = result + ", "; }
                result = result + ir_type_to_str(args.get(i));
                i = i + 1;
            }
            result = result + ">";
            return result;
        }
    }
    return "?";
}

pub fn box_ir_type_to_str(b: Box<IrType>) -> str {
    match b {
        IrType::I8 => { return "i8"; }
        IrType::I16 => { return "i16"; }
        IrType::I32 => { return "i32"; }
        IrType::I64 => { return "i64"; }
        IrType::U8 => { return "u8"; }
        IrType::U16 => { return "u16"; }
        IrType::U32 => { return "u32"; }
        IrType::U64 => { return "u64"; }
        IrType::F32 => { return "f32"; }
        IrType::F64 => { return "f64"; }
        IrType::Bool => { return "bool"; }
        IrType::Ptr(inner) => {
            var inner_str: str = box_ir_type_to_str(inner);
            return "*" + inner_str;
        }
        IrType::Struct(name) => {
            return "struct." + name;
        }
        IrType::Array(elem, count) => {
            var elem_str: str = box_ir_type_to_str(elem);
            return "[" + elem_str + "; " + int_to_str(count) + "]";
        }
        IrType::Void => { return "void"; }
        IrType::Never => { return "never"; }
        IrType::Opaque(name) => {
            return "opaque." + name;
        }
        IrType::Generic(name, args) => {
            var result: str = "generic." + name + "<";
            var i: i64 = 0;
            while i < args.len() {
                if i > 0 { result = result + ", "; }
                result = result + ir_type_to_str(args.get(i));
                i = i + 1;
            }
            result = result + ">";
            return result;
        }
    }
    return "?";
}

// ─── Effects ─────────────────────────────────────────────────────────────

pub enum Effect {
    Alloc,
    IO,
    Net,
    Spawn,
    Diverge,
    Read,
    Write,
    Diff,
    Noise,
    Comm,
}

pub fn effect_to_str(e: Effect) -> str {
    match e {
        Effect::Alloc => { return "alloc"; }
        Effect::IO => { return "io"; }
        Effect::Net => { return "net"; }
        Effect::Spawn => { return "spawn"; }
        Effect::Diverge => { return "diverge"; }
        Effect::Read => { return "read"; }
        Effect::Write => { return "write"; }
        Effect::Diff => { return "diff"; }
        Effect::Noise => { return "noise"; }
        Effect::Comm => { return "comm"; }
    }
    return "?";
}

pub fn effect_eq(a: Effect, b: Effect) -> bool {
    match a {
        Effect::Alloc => { match b { Effect::Alloc => { return true; }, _ => { return false; } } }
        Effect::IO => { match b { Effect::IO => { return true; }, _ => { return false; } } }
        Effect::Net => { match b { Effect::Net => { return true; }, _ => { return false; } } }
        Effect::Spawn => { match b { Effect::Spawn => { return true; }, _ => { return false; } } }
        Effect::Diverge => { match b { Effect::Diverge => { return true; }, _ => { return false; } } }
        Effect::Read => { match b { Effect::Read => { return true; }, _ => { return false; } } }
        Effect::Write => { match b { Effect::Write => { return true; }, _ => { return false; } } }
        Effect::Diff => { match b { Effect::Diff => { return true; }, _ => { return false; } } }
        Effect::Noise => { match b { Effect::Noise => { return true; }, _ => { return false; } } }
        Effect::Comm => { match b { Effect::Comm => { return true; }, _ => { return false; } } }
    }
    return false;
}

// ─── EffectSet ───────────────────────────────────────────────────────────

pub struct EffectSet {
    pub effects: Vec<Effect>,
}

pub fn EffectSet_new() -> EffectSet {
    return EffectSet { effects: Vec::new() };
}

pub fn EffectSet_none() -> EffectSet {
    return EffectSet { effects: Vec::new() };
}

pub fn EffectSet_add(self: &mut EffectSet, effect: Effect) {
    if !EffectSet_contains(self, effect) {
        self.effects.push(effect);
    }
}

pub fn EffectSet_add_all(self: &mut EffectSet, other: &EffectSet) {
    var i: i64 = 0;
    while i < other.effects.len() {
        EffectSet_add(self, other.effects.get(i));
        i = i + 1;
    }
}

pub fn EffectSet_contains(self: &EffectSet, effect: Effect) -> bool {
    var i: i64 = 0;
    while i < self.effects.len() {
        if effect_eq(self.effects.get(i), effect) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn EffectSet_is_pure(self: &EffectSet) -> bool {
    return self.effects.len() == 0;
}

pub fn EffectSet_is_read_only(self: &EffectSet) -> bool {
    var i: i64 = 0;
    while i < self.effects.len() {
        match self.effects.get(i) {
            Effect::Read => {}
            _ => { return false; }
        }
        i = i + 1;
    }
    return true;
}

pub fn EffectSet_has_side_effects(self: &EffectSet) -> bool {
    var i: i64 = 0;
    while i < self.effects.len() {
        match self.effects.get(i) {
            Effect::Read => {}
            _ => { return true; }
        }
        i = i + 1;
    }
    return false;
}

pub fn EffectSet_parse_effect(s: str) -> OptU64 {
    var lower: str = str_to_lower(s);
    if lower == "alloc" { return OptU64::Some(0); }
    if lower == "io" { return OptU64::Some(1); }
    if lower == "net" { return OptU64::Some(2); }
    if lower == "spawn" { return OptU64::Some(3); }
    if lower == "diverge" { return OptU64::Some(4); }
    if lower == "read" { return OptU64::Some(5); }
    if lower == "write" { return OptU64::Some(6); }
    return OptU64::None;
}

pub fn EffectSet_to_str(self: &EffectSet) -> str {
    if self.effects.len() == 0 { return "pure"; }
    var result: str = "!";
    var i: i64 = 0;
    while i < self.effects.len() {
        if i > 0 { result = result + ","; }
        result = result + effect_to_str(self.effects.get(i));
        i = i + 1;
    }
    return result;
}

// ─── Regions ─────────────────────────────────────────────────────────────

pub enum Region {
    Stack,
    Heap,
    Static,
    Named(str),
}

pub fn region_to_str(r: Region) -> str {
    match r {
        Region::Stack => { return "stack"; }
        Region::Heap => { return "heap"; }
        Region::Static => { return "static"; }
        Region::Named(name) => { return "region." + name; }
    }
    return "?";
}

pub fn region_eq(a: Region, b: Region) -> bool {
    match a {
        Region::Stack => { match b { Region::Stack => { return true; }, _ => { return false; } } }
        Region::Heap => { match b { Region::Heap => { return true; }, _ => { return false; } } }
        Region::Static => { match b { Region::Static => { return true; }, _ => { return false; } } }
        Region::Named(n1) => {
            match b {
                Region::Named(n2) => { return n1 == n2; }
                _ => { return false; }
            }
            return false;
        }
    }
    return false;
}

// ─── BorrowKind ──────────────────────────────────────────────────────────

pub enum BorrowKind {
    None,
    Shared,
    Mut,
}

pub fn borrow_kind_eq(a: BorrowKind, b: BorrowKind) -> bool {
    match a {
        BorrowKind::None => { match b { BorrowKind::None => { return true; }, _ => { return false; } } }
        BorrowKind::Shared => { match b { BorrowKind::Shared => { return true; }, _ => { return false; } } }
        BorrowKind::Mut => { match b { BorrowKind::Mut => { return true; }, _ => { return false; } } }
    }
    return false;
}

// ─── SSA Value / Block IDs ───────────────────────────────────────────────

pub fn value_id_to_str(id: i64) -> str {
    return "%" + int_to_str(id);
}

pub fn block_id_to_str(id: i64) -> str {
    return "bb" + int_to_str(id);
}

// ─── ValueMeta ───────────────────────────────────────────────────────────

pub struct ValueMeta {
    pub ty: IrType,
    pub region: Region,
    pub effects: EffectSet,
    pub source_line: OptU64,
    pub in_sandbox: bool,
    pub is_linear: bool,
    pub borrow_kind: BorrowKind,
}

pub fn ValueMeta_new(ty: IrType) -> ValueMeta {
    return ValueMeta {
        ty: ty,
        region: Region::Stack,
        effects: EffectSet_new(),
        source_line: OptU64::None,
        in_sandbox: false,
        is_linear: false,
        borrow_kind: BorrowKind::None,
    };
}

pub fn ValueMeta_with_type(old: ValueMeta, new_ty: IrType) -> ValueMeta {
    return ValueMeta {
        ty: new_ty,
        region: old.region,
        effects: old.effects,
        source_line: old.source_line,
        in_sandbox: old.in_sandbox,
        is_linear: old.is_linear,
        borrow_kind: old.borrow_kind,
    };
}

// ─── Instructions ────────────────────────────────────────────────────────
// All struct-style enum variants converted to tuple-style (Fides convention).

pub enum Inst {
    // ─── Constants ───
    ConstInt(i64, IrType),
    ConstFloat(f64, IrType),
    ConstBool(bool),
    ConstStr(str),
    ConstNull(IrType),

    // ─── Arithmetic ───
    BinOp(BinOp, i64, i64, IrType),
    UnaryOp(UnaryOp, i64, IrType),

    // ─── Memory ───
    Alloca(IrType, Region),
    Load(i64, IrType),
    Store(i64, i64, OptIrType),
    GetFieldPtr(i64, i64, IrType),
    GetElemPtr(i64, i64, IrType),

    // ─── Control Flow ───
    Jump(i64),
    Branch(i64, i64, i64),
    Return(OptValueId),
    Unreachable,

    // ─── Function Calls ───
    Call(str, Vec<i64>, IrType, EffectSet),
    CallPtr(i64, Vec<i64>, IrType, EffectSet, bool),
    DynCall(str, str, Vec<i64>, IrType, EffectSet),
    MakeDyn(i64, str, str),

    // ─── Conversions ───
    BitCast(i64, IrType, IrType),
    IntExtend(i64, IrType, IrType),
    IntTrunc(i64, IrType, IrType),
    IntToFloat(i64, IrType, IrType),
    FloatToInt(i64, IrType, IrType),

    // ─── Fides-Specific ───
    TryUnwrap(i64, i64, i64, i64),
    Print(i64, IrType),
    Panic(str),
    Asm(str, Vec<StringValueId>, Vec<StringValueId>, IrType),

    // ─── Region Management ───
    RegionBegin(str, bool, bool, OptU64),
    RegionEnd(str, bool, bool),

    // ─── Persist Variables ───
    PersistLoad(str, i64, IrType),
    PersistSave(str, i64),

    // ─── Transaction Blocks ───
    TxnBegin,
    TxnEnd,

    // ─── Unsafe Blocks ───
    UnsafeBegin,
    UnsafeEnd,

    // ─── Autograd ───
    GradBegin(str),
    GradEnd,
    Backward(i64),
}

// ─── Inst methods ────────────────────────────────────────────────────────

pub fn inst_result_type(inst: Inst) -> IrType {
    match inst {
        Inst::ConstInt(_, ty) => { return ty; }
        Inst::ConstFloat(_, ty) => { return ty; }
        Inst::ConstBool(_) => { return IrType::Bool; }
        Inst::ConstStr(_) => { return IrType::Ptr(Box::new(IrType::U8)); }
        Inst::ConstNull(ty) => { return ty; }
        Inst::BinOp(_, _, _, ty) => { return ty; }
        Inst::UnaryOp(_, _, ty) => { return ty; }
        Inst::Alloca(ty, _) => { return IrType::Ptr(Box::new(ty)); }
        Inst::Load(_, ty) => { return ty; }
        Inst::Store(_, _, _) => { return IrType::Void; }
        Inst::GetFieldPtr(_, _, field_ty) => { return IrType::Ptr(Box::new(field_ty)); }
        Inst::GetElemPtr(_, _, elem_ty) => { return IrType::Ptr(Box::new(elem_ty)); }
        Inst::Jump(_) => { return IrType::Void; }
        Inst::Branch(_, _, _) => { return IrType::Void; }
        Inst::Return(_) => { return IrType::Void; }
        Inst::Unreachable => { return IrType::Void; }
        Inst::Call(_, _, ret_ty, _) => { return ret_ty; }
        Inst::CallPtr(_, _, ret_ty, _, _) => { return ret_ty; }
        Inst::DynCall(_, _, _, ret_ty, _) => { return ret_ty; }
        Inst::MakeDyn(_, _, _) => { return IrType::Opaque("dyn"); }
        Inst::BitCast(_, _, to) => { return to; }
        Inst::IntExtend(_, _, to) => { return to; }
        Inst::IntTrunc(_, _, to) => { return to; }
        Inst::IntToFloat(_, _, to) => { return to; }
        Inst::FloatToInt(_, _, to) => { return to; }
        Inst::TryUnwrap(_, _, _, _) => { return IrType::Void; }
        Inst::Print(_, _) => { return IrType::Void; }
        Inst::Panic(_) => { return IrType::Never; }
        Inst::Asm(_, _, _, ret_ty) => { return ret_ty; }
        Inst::RegionBegin(_, _, _, _) => { return IrType::I64; }
        Inst::RegionEnd(_, _, _) => { return IrType::Void; }
        Inst::PersistLoad(_, _, ty) => { return ty; }
        Inst::PersistSave(_, _) => { return IrType::Void; }
        Inst::TxnBegin => { return IrType::Void; }
        Inst::TxnEnd => { return IrType::Void; }
        Inst::UnsafeBegin => { return IrType::Void; }
        Inst::UnsafeEnd => { return IrType::Void; }
        Inst::GradBegin(_) => { return IrType::Void; }
        Inst::GradEnd => { return IrType::Void; }
        Inst::Backward(_) => { return IrType::Void; }
    }
    return IrType::Void;
}

pub fn inst_effects(inst: &Inst) -> EffectSet {
    var effects: EffectSet = EffectSet_new();
    match inst {
        Inst::Alloca(_, _) => { EffectSet_add(&mut effects, Effect::Alloc); }
        Inst::Load(_, _) => { EffectSet_add(&mut effects, Effect::Read); }
        Inst::Store(_, _, _) => { EffectSet_add(&mut effects, Effect::Write); }
        Inst::Call(_, _, _, e) => { EffectSet_add_all(&mut effects, e); }
        Inst::CallPtr(_, _, _, e, _) => { EffectSet_add_all(&mut effects, e); }
        Inst::DynCall(_, _, _, _, e) => { EffectSet_add_all(&mut effects, e); }
        Inst::MakeDyn(_, _, _) => {}
        Inst::Print(_, _) => {
            EffectSet_add(&mut effects, Effect::IO);
            EffectSet_add(&mut effects, Effect::Read);
        }
        Inst::Panic(_) => { EffectSet_add(&mut effects, Effect::Diverge); }
        Inst::Asm(_, _, _, _) => {
            EffectSet_add(&mut effects, Effect::Read);
            EffectSet_add(&mut effects, Effect::Write);
        }
        Inst::TryUnwrap(_, _, _, _) => { EffectSet_add(&mut effects, Effect::Read); }
        Inst::Unreachable => { EffectSet_add(&mut effects, Effect::Diverge); }
        Inst::RegionBegin(_, _, _, _) => { EffectSet_add(&mut effects, Effect::Alloc); }
        Inst::RegionEnd(_, _, _) => {
            EffectSet_add(&mut effects, Effect::Alloc);
            EffectSet_add(&mut effects, Effect::Write);
        }
        Inst::PersistLoad(_, _, _) => { EffectSet_add(&mut effects, Effect::Read); }
        Inst::PersistSave(_, _) => { EffectSet_add(&mut effects, Effect::Write); }
        Inst::TxnBegin => { EffectSet_add(&mut effects, Effect::Write); }
        Inst::TxnEnd => { EffectSet_add(&mut effects, Effect::Write); }
        Inst::UnsafeBegin => {}
        Inst::UnsafeEnd => {}
        Inst::GradBegin(_) => { EffectSet_add(&mut effects, Effect::Diff); }
        Inst::GradEnd => { EffectSet_add(&mut effects, Effect::Diff); }
        Inst::Backward(_) => { EffectSet_add(&mut effects, Effect::Diff); }
        _ => {}
    }
    return effects;
}

pub fn inst_kind_name(inst: &Inst) -> str {
    match inst {
        Inst::ConstInt(_, _) => { return "ConstInt"; }
        Inst::ConstFloat(_, _) => { return "ConstFloat"; }
        Inst::ConstBool(_) => { return "ConstBool"; }
        Inst::ConstStr(_) => { return "ConstStr"; }
        Inst::ConstNull(_) => { return "ConstNull"; }
        Inst::BinOp(_, _, _, _) => { return "BinOp"; }
        Inst::UnaryOp(_, _, _) => { return "UnaryOp"; }
        Inst::Alloca(_, _) => { return "Alloca"; }
        Inst::Load(_, _) => { return "Load"; }
        Inst::Store(_, _, _) => { return "Store"; }
        Inst::GetFieldPtr(_, _, _) => { return "GetFieldPtr"; }
        Inst::GetElemPtr(_, _, _) => { return "GetElemPtr"; }
        Inst::Jump(_) => { return "Jump"; }
        Inst::Branch(_, _, _) => { return "Branch"; }
        Inst::Return(_) => { return "Return"; }
        Inst::Unreachable => { return "Unreachable"; }
        Inst::Call(_, _, _, _) => { return "Call"; }
        Inst::CallPtr(_, _, _, _, _) => { return "CallPtr"; }
        Inst::DynCall(_, _, _, _, _) => { return "DynCall"; }
        Inst::MakeDyn(_, _, _) => { return "MakeDyn"; }
        Inst::BitCast(_, _, _) => { return "BitCast"; }
        Inst::IntExtend(_, _, _) => { return "IntExtend"; }
        Inst::IntTrunc(_, _, _) => { return "IntTrunc"; }
        Inst::IntToFloat(_, _, _) => { return "IntToFloat"; }
        Inst::FloatToInt(_, _, _) => { return "FloatToInt"; }
        Inst::TryUnwrap(_, _, _, _) => { return "TryUnwrap"; }
        Inst::Print(_, _) => { return "Print"; }
        Inst::Panic(_) => { return "Panic"; }
        Inst::Asm(_, _, _, _) => { return "Asm"; }
        Inst::RegionBegin(_, _, _, _) => { return "RegionBegin"; }
        Inst::RegionEnd(_, _, _) => { return "RegionEnd"; }
        Inst::PersistLoad(_, _, _) => { return "PersistLoad"; }
        Inst::PersistSave(_, _) => { return "PersistSave"; }
        Inst::TxnBegin => { return "TxnBegin"; }
        Inst::TxnEnd => { return "TxnEnd"; }
        Inst::UnsafeBegin => { return "UnsafeBegin"; }
        Inst::UnsafeEnd => { return "UnsafeEnd"; }
        Inst::GradBegin(_) => { return "GradBegin"; }
        Inst::GradEnd => { return "GradEnd"; }
        Inst::Backward(_) => { return "Backward"; }
    }
    return "?";
}

pub fn inst_is_terminator(inst: Inst) -> bool {
    match inst {
        Inst::Jump(_) => { return true; }
        Inst::Branch(_, _, _) => { return true; }
        Inst::Return(_) => { return true; }
        Inst::Unreachable => { return true; }
        Inst::Panic(_) => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn inst_value_refs(inst: &Inst) -> Vec<i64> {
    var refs: Vec<i64> = Vec::new();
    match inst {
        Inst::ConstInt(_, _) => {}
        Inst::ConstFloat(_, _) => {}
        Inst::ConstBool(_) => {}
        Inst::ConstStr(_) => {}
        Inst::ConstNull(_) => {}
        Inst::Alloca(_, _) => {}
        Inst::Unreachable => {}
        Inst::Panic(_) => {}
        Inst::BinOp(_, left, right, _) => {
            refs.push(left);
            refs.push(right);
        }
        Inst::UnaryOp(_, operand, _) => {
            refs.push(operand);
        }
        Inst::Load(ptr, _) => {
            refs.push(ptr);
        }
        Inst::Store(ptr, value, _) => {
            refs.push(ptr);
            refs.push(value);
        }
        Inst::GetFieldPtr(struct_ptr, _, _) => {
            refs.push(struct_ptr);
        }
        Inst::GetElemPtr(array_ptr, index, _) => {
            refs.push(array_ptr);
            refs.push(index);
        }
        Inst::Jump(_) => {}
        Inst::Branch(cond, _, _) => {
            refs.push(cond);
        }
        Inst::Return(opt_val) => {
            match opt_val {
                OptValueId::Some(v) => { refs.push(v); }
                OptValueId::None => {}
            }
        }
        Inst::Call(_, args, _, _) => {
            var i: i64 = 0;
            while i < args.len() {
                refs.push(args.get(i));
                i = i + 1;
            }
        }
        Inst::CallPtr(fn_ptr, args, _, _, _) => {
            refs.push(fn_ptr);
            var i: i64 = 0;
            while i < args.len() {
                refs.push(args.get(i));
                i = i + 1;
            }
        }
        Inst::DynCall(_, _, args, _, _) => {
            var i: i64 = 0;
            while i < args.len() {
                refs.push(args.get(i));
                i = i + 1;
            }
        }
        Inst::MakeDyn(value, _, _) => {
            refs.push(value);
        }
        Inst::BitCast(value, _, _) => { refs.push(value); }
        Inst::IntExtend(value, _, _) => { refs.push(value); }
        Inst::IntTrunc(value, _, _) => { refs.push(value); }
        Inst::IntToFloat(value, _, _) => { refs.push(value); }
        Inst::FloatToInt(value, _, _) => { refs.push(value); }
        Inst::TryUnwrap(value, _, _, _) => { refs.push(value); }
        Inst::Print(value, _) => { refs.push(value); }
        Inst::Asm(_, inputs, outputs, _) => {
            var i: i64 = 0;
            while i < inputs.len() {
                refs.push(inputs.get(i).id);
                i = i + 1;
            }
            i = 0;
            while i < outputs.len() {
                refs.push(outputs.get(i).id);
                i = i + 1;
            }
        }
        Inst::RegionBegin(_, _, _, _) => {}
        Inst::RegionEnd(_, _, _) => {}
        Inst::PersistLoad(_, default, _) => { refs.push(default); }
        Inst::PersistSave(_, value) => { refs.push(value); }
        Inst::TxnBegin => {}
        Inst::TxnEnd => {}
        Inst::UnsafeBegin => {}
        Inst::UnsafeEnd => {}
        Inst::GradBegin(_) => {}
        Inst::GradEnd => {}
        Inst::Backward(loss) => { refs.push(loss); }
    }
    return refs;
}

// ─── BasicBlock ──────────────────────────────────────────────────────────

pub struct BasicBlock {
    pub id: i64,
    pub instructions: Vec<i64>,
    pub predecessors: Vec<i64>,
    pub params: Vec<ValueIdType>,
}

pub fn BasicBlock_new(id: i64) -> BasicBlock {
    return BasicBlock {
        id: id,
        instructions: Vec::new(),
        predecessors: Vec::new(),
        params: Vec::new(),
    };
}

// ─── IrFunction ──────────────────────────────────────────────────────────
// HashMap<K,V> replaced with Vec-based storage + lookup helpers.

pub struct IrFunction {
    pub name: str,
    pub params: Vec<ValueIdType>,
    pub ret_ty: IrType,
    pub blocks: Vec<BasicBlock>,
    pub value_metas: Vec<ValueIdMeta>,
    pub insts: Vec<ValueIdInst>,
    pub effects: EffectSet,
    pub next_value: i64,
    pub next_block: i64,
    pub current_block_idx: i64,
    pub entry: i64,
    pub locals: Vec<StringValueId>,
    pub is_interrupt: bool,
    pub persist_vars: Vec<StringValueId>,
    pub drop_locals: Vec<ValueIdString>,
    pub is_wrapping: bool,
    pub is_deterministic: bool,
    pub is_crashfree: bool,
    pub gas_limit: OptU64,
    pub is_no_alloc: bool,
    pub is_medical: bool,
    pub is_kernel: bool,
    pub workgroup_size: Vec<i64>,
}

pub struct ValueIdMeta {
    pub id: i64,
    pub meta: ValueMeta,
}

pub fn ValueIdMeta_new(id: i64, meta: ValueMeta) -> ValueIdMeta {
    return ValueIdMeta { id: id, meta: meta };
}

pub struct ValueIdInst {
    pub id: i64,
    pub inst: Inst,
}

pub fn ValueIdInst_new(id: i64, inst: Inst) -> ValueIdInst {
    return ValueIdInst { id: id, inst: inst };
}

pub fn IrFunction_new(name: str, ret_ty: IrType) -> IrFunction {
    var func: IrFunction = IrFunction {
        name: name,
        params: Vec::new(),
        ret_ty: ret_ty,
        blocks: Vec::new(),
        value_metas: Vec::new(),
        insts: Vec::new(),
        effects: EffectSet_new(),
        next_value: 0,
        next_block: 0,
        current_block_idx: 0,
        entry: 0,
        locals: Vec::new(),
        is_interrupt: false,
        persist_vars: Vec::new(),
        drop_locals: Vec::new(),
        is_wrapping: false,
        is_deterministic: false,
        is_crashfree: false,
        gas_limit: OptU64::None,
        is_no_alloc: false,
        is_medical: false,
        is_kernel: false,
        workgroup_size: Vec::new(),
    };
    func.workgroup_size.push(1);
    func.workgroup_size.push(1);
    func.workgroup_size.push(1);
    IrFunction_new_block(&mut func);
    return func;
}

pub fn IrFunction_new_value(self: &mut IrFunction, meta: ValueMeta) -> i64 {
    var id: i64 = self.next_value;
    self.next_value = self.next_value + 1;
    self.value_metas.push(ValueIdMeta_new(id, meta));
    return id;
}

pub fn IrFunction_new_block(self: &mut IrFunction) -> i64 {
    var id: i64 = self.next_block;
    self.next_block = self.next_block + 1;
    self.blocks.push(BasicBlock_new(id));
    return id;
}

pub fn IrFunction_current_block(self: &IrFunction) -> i64 {
    return self.current_block_idx;
}

pub fn IrFunction_emit(self: &mut IrFunction, inst: Inst) -> i64 {
    var ty: IrType = inst_result_type(inst);
    var effects: EffectSet = inst_effects(&inst);
    var is_term: bool = inst_is_terminator(inst);
    var meta: ValueMeta = ValueMeta {
        ty: ty,
        region: Region::Stack,
        effects: effects,
        source_line: OptU64::None,
        in_sandbox: false,
        is_linear: false,
        borrow_kind: BorrowKind::None,
    };
    var id: i64 = IrFunction_new_value(self, meta);
    var block_idx: i64 = self.current_block_idx;
    var blk: BasicBlock = self.blocks.get(block_idx);
    blk.instructions.push(id);
    self.blocks.set(block_idx, blk);
    self.insts.push(ValueIdInst_new(id, inst));
    return id;
}

pub fn IrFunction_add_block_param(self: &mut IrFunction, block: i64, ty: IrType) -> i64 {
    var meta: ValueMeta = ValueMeta {
        ty: ty,
        region: Region::Stack,
        effects: EffectSet_none(),
        source_line: OptU64::None,
        in_sandbox: false,
        is_linear: false,
        borrow_kind: BorrowKind::None,
    };
    var id: i64 = IrFunction_new_value(self, meta);
    var blk: BasicBlock = self.blocks.get(block);
    blk.params.push(ValueIdType_new(id, ty));
    self.blocks.set(block, blk);
    return id;
}

pub fn IrFunction_bind_local(self: &mut IrFunction, name: str, value: i64) {
    self.locals.push(StringValueId_new(name, value));
}

pub fn IrFunction_lookup_local(self: &IrFunction, name: str) -> OptValueId {
    var i: i64 = 0;
    while i < self.locals.len() {
        if str_equal(self.locals.get(i).name, name) {
            return OptValueId::Some(self.locals.get(i).id);
        }
        i = i + 1;
    }
    return OptValueId::None;
}

pub fn IrFunction_get_inst(self: &IrFunction, id: i64) -> OptInst {
    var i: i64 = 0;
    while i < self.insts.len() {
        if self.insts.get(i).id == id {
            return OptInst::Some(self.insts.get(i).inst);
        }
        i = i + 1;
    }
    return OptInst::None;
}

pub fn IrFunction_get_meta(self: &IrFunction, id: i64) -> OptValueMeta {
    var i: i64 = 0;
    while i < self.value_metas.len() {
        if self.value_metas.get(i).id == id {
            return OptValueMeta::Some(self.value_metas.get(i).meta);
        }
        i = i + 1;
    }
    return OptValueMeta::None;
}

// ─── Optional Inst / ValueMeta enums ─────────────────────────────────────

// ─── StructLayout ────────────────────────────────────────────────────────

pub struct StructLayout {
    pub name: str,
    pub fields: Vec<StringIrTypeOffset>,
    pub size: i64,
    pub align: i64,
}

pub fn StructLayout_new(name: str) -> StructLayout {
    return StructLayout {
        name: name,
        fields: Vec::new(),
        size: 0,
        align: 8,
    };
}

// ─── SourceMap ───────────────────────────────────────────────────────────

pub struct SourceEntry {
    pub function: str,
    pub value_id: i64,
    pub line: i64,
    pub inst: str,
}

pub fn SourceEntry_new(function: str, value_id: i64, line: i64, inst: str) -> SourceEntry {
    return SourceEntry {
        function: function,
        value_id: value_id,
        line: line,
        inst: inst,
    };
}

pub struct SourceMap {
    pub entries: Vec<SourceEntry>,
}

pub fn SourceMap_new() -> SourceMap {
    return SourceMap { entries: Vec::new() };
}

pub fn SourceMap_lookup(self: &SourceMap, function: str, value_id: i64) -> OptU64 {
    var i: i64 = 0;
    while i < self.entries.len() {
        var e: SourceEntry = self.entries.get(i);
        if e.function == function && e.value_id == value_id {
            return OptU64::Some(e.line);
        }
        i = i + 1;
    }
    return OptU64::None;
}

pub fn SourceMap_to_str(self: &SourceMap) -> str {
    var out: str = "Source Map:\n";
    out = out + "  Function           Value  Line  Instruction\n";
    out = out + "  ─────────────────  ─────  ────  ────────────\n";
    var i: i64 = 0;
    while i < self.entries.len() {
        var e: SourceEntry = self.entries.get(i);
        out = out + "  " + e.function + "  v" + int_to_str(e.value_id) + "  " + int_to_str(e.line) + "  " + e.inst + "\n";
        i = i + 1;
    }
    return out;
}

// ─── IrModule ────────────────────────────────────────────────────────────
// HashMap<K,V> replaced with Vec-based storage + lookup helpers.

pub struct IrModule {
    pub functions: Vec<IrFunctionEntry>,
    pub struct_layouts: Vec<StructLayoutEntry>,
    pub string_constants: Vec<StringStringEntry>,
    pub extern_functions: Vec<StringVecIrType>,
    pub function_effects: Vec<StringEffectSetEntry>,
    pub extern_decls: Vec<ExternDecl>,
    pub trait_methods: Vec<StringVecStr>,
    pub trait_impls: Vec<StringVecStr>,
    pub linear_structs: Vec<str>,
}

pub struct IrFunctionEntry {
    pub name: str,
    pub func: IrFunction,
}

pub fn IrFunctionEntry_new(name: str, func: IrFunction) -> IrFunctionEntry {
    return IrFunctionEntry { name: name, func: func };
}

pub struct StructLayoutEntry {
    pub name: str,
    pub layout: StructLayout,
}

pub fn StructLayoutEntry_new(name: str, layout: StructLayout) -> StructLayoutEntry {
    return StructLayoutEntry { name: name, layout: layout };
}

pub struct StringStringEntry {
    pub key: str,
    pub val: str,
}

pub fn StringStringEntry_new(key: str, val: str) -> StringStringEntry {
    return StringStringEntry { key: key, val: val };
}

pub struct StringEffectSetEntry {
    pub name: str,
    pub effects: EffectSet,
}

pub fn StringEffectSetEntry_new(name: str, effects: EffectSet) -> StringEffectSetEntry {
    return StringEffectSetEntry { name: name, effects: effects };
}

pub fn IrModule_new() -> IrModule {
    return IrModule {
        functions: Vec::new(),
        struct_layouts: Vec::new(),
        string_constants: Vec::new(),
        extern_functions: Vec::new(),
        function_effects: Vec::new(),
        extern_decls: Vec::new(),
        trait_methods: Vec::new(),
        trait_impls: Vec::new(),
        linear_structs: Vec::new(),
    };
}

pub fn IrModule_add_struct(self: &mut IrModule, layout: StructLayout) {
    self.struct_layouts.push(StructLayoutEntry_new(layout.name, layout));
}

pub fn IrModule_get_struct(self: &IrModule, name: str) -> OptStructLayout {
    var i: i64 = 0;
    while i < self.struct_layouts.len() {
        if str_equal(self.struct_layouts.get(i).name, name) {
            return OptStructLayout::Some(self.struct_layouts.get(i).layout);
        }
        i = i + 1;
    }
    return OptStructLayout::None;
}

pub fn IrModule_intern_string(self: &mut IrModule, s: str) -> str {
    var i: i64 = 0;
    while i < self.string_constants.len() {
        if self.string_constants.get(i).key == s {
            return self.string_constants.get(i).val;
        }
        i = i + 1;
    }
    var label: str = ".str_" + int_to_str(self.string_constants.len());
    self.string_constants.push(StringStringEntry_new(s, label));
    return label;
}

pub fn IrModule_add_extern(self: &mut IrModule, name: str, params: Vec<IrType>, ret: IrType) {
    self.extern_functions.push(StringVecIrType_new(name, params, ret));
}

pub fn IrModule_type_size(self: &IrModule, ty: IrType) -> i64 {
    match ty {
        IrType::Struct(name) => {
            match IrModule_get_struct(self, name) {
                OptStructLayout::Some(layout) => { return layout.size; }
                OptStructLayout::None => { return 0; }
            }
            return 0;
        }
        _ => { return ir_type_size(ty); }
    }
    return 0;
}

pub fn IrModule_type_align(self: &IrModule, ty: IrType) -> i64 {
    match ty {
        IrType::Struct(name) => {
            match IrModule_get_struct(self, name) {
                OptStructLayout::Some(layout) => { return layout.align; }
                OptStructLayout::None => { return 8; }
            }
            return 8;
        }
        _ => { return ir_type_align(ty); }
    }
    return 8;
}

pub fn IrModule_add_function(self: &mut IrModule, func: IrFunction) {
    self.functions.push(IrFunctionEntry_new(func.name, func));
}

pub fn IrModule_replace_function(self: &mut IrModule, func: IrFunction) {
    var i: i64 = 0;
    while i < self.functions.len() {
        if str_equal(self.functions.get(i).name, func.name) {
            self.functions.set(i, IrFunctionEntry_new(func.name, func));
            return;
        }
        i = i + 1;
    }
    // Not found — add it
    self.functions.push(IrFunctionEntry_new(func.name, func));
}

// Like replace_function, but takes the name separately to avoid
// string corruption when the IrFunction is moved from a struct field.
pub fn IrModule_replace_function_named(self: &mut IrModule, func: IrFunction, name: str) {
    var i: i64 = 0;
    while i < self.functions.len() {
        if str_equal(self.functions.get(i).name, name) {
            self.functions.set(i, IrFunctionEntry_new(name, func));
            return;
        }
        i = i + 1;
    }
    // Not found — add it
    self.functions.push(IrFunctionEntry_new(name, func));
}

pub fn IrModule_get_function(self: &IrModule, name: str) -> OptIrFunction {
    var i: i64 = 0;
    while i < self.functions.len() {
        if str_equal(self.functions.get(i).name, name) {
            return OptIrFunction::Some(self.functions.get(i).func);
        }
        i = i + 1;
    }
    return OptIrFunction::None;
}

// ─── Type Lowering (AST → IR) ────────────────────────────────────────────

pub fn lower_type(ast_ty: Type) -> IrType {
    match ast_ty {
        Type::I8 => { return IrType::I8; }
        Type::I16 => { return IrType::I16; }
        Type::I32 => { return IrType::I32; }
        Type::I64 => { return IrType::I64; }
        Type::I128 => { return IrType::I64; }
        Type::U8 => { return IrType::U8; }
        Type::U16 => { return IrType::U16; }
        Type::U32 => { return IrType::U32; }
        Type::U64 => { return IrType::U64; }
        Type::U128 => { return IrType::U64; }
        Type::F32 => { return IrType::F32; }
        Type::F64 => { return IrType::F64; }
        Type::Bool => { return IrType::Bool; }
        Type::Str => { return IrType::Ptr(Box::new(IrType::U8)); }
        Type::Void => { return IrType::Void; }
        Type::Never => { return IrType::Void; }
        Type::Infer => { return IrType::I64; }
        Type::Named(name) => {
            if name == "Vec" || name == "HashMap" || name == "Tensor" || name == "Allocator" {
                return IrType::Opaque(name);
            }
            return IrType::Struct(name);
        }
        Type::Array(elem, size) => {
            return IrType::Array(Box::new(box_lower_type(elem)), size);
        }
        Type::ArrayConst(elem, _) => {
            return IrType::Array(Box::new(box_lower_type(elem)), 0);
        }
        Type::Ref(inner, _) => {
            return IrType::Ptr(Box::new(box_lower_type(inner)));
        }
        Type::RawPtr(inner, _) => {
            return IrType::Ptr(Box::new(box_lower_type(inner)));
        }
        Type::Generic(name, args) => {
            if name == "Future" { return IrType::I64; }
            var ir_args: Vec<IrType> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                ir_args.push(lower_type(args.get(i)));
                i = i + 1;
            }
            return IrType::Generic(name, ir_args);
        }
        Type::Tuple(_) => {
            return IrType::Opaque("tuple");
        }
        Type::Func(_, _) => {
            return IrType::Opaque("func");
        }
        Type::Assoc(_, _, _, _) => {
            return IrType::I64;
        }
        Type::Dyn(name) => {
            return IrType::Opaque("dyn:" + name);
        }
        Type::ShapedTensor(_, _) => {
            return IrType::Opaque("Tensor");
        }
    }
    return IrType::Void;
}

pub fn box_lower_type(b: Box<Type>) -> IrType {
    match b {
        Type::I8 => { return IrType::I8; }
        Type::I16 => { return IrType::I16; }
        Type::I32 => { return IrType::I32; }
        Type::I64 => { return IrType::I64; }
        Type::I128 => { return IrType::I64; }
        Type::U8 => { return IrType::U8; }
        Type::U16 => { return IrType::U16; }
        Type::U32 => { return IrType::U32; }
        Type::U64 => { return IrType::U64; }
        Type::U128 => { return IrType::U64; }
        Type::F32 => { return IrType::F32; }
        Type::F64 => { return IrType::F64; }
        Type::Bool => { return IrType::Bool; }
        Type::Str => { return IrType::Ptr(Box::new(IrType::U8)); }
        Type::Void => { return IrType::Void; }
        Type::Never => { return IrType::Void; }
        Type::Infer => { return IrType::I64; }
        Type::Named(name) => {
            if name == "Vec" || name == "HashMap" || name == "Tensor" || name == "Allocator" {
                return IrType::Opaque(name);
            }
            return IrType::Struct(name);
        }
        Type::Array(elem, size) => {
            return IrType::Array(Box::new(box_lower_type(elem)), size);
        }
        Type::ArrayConst(elem, _) => {
            return IrType::Array(Box::new(box_lower_type(elem)), 0);
        }
        Type::Ref(inner, _) => {
            return IrType::Ptr(Box::new(box_lower_type(inner)));
        }
        Type::RawPtr(inner, _) => {
            return IrType::Ptr(Box::new(box_lower_type(inner)));
        }
        Type::Generic(name, args) => {
            if name == "Future" { return IrType::I64; }
            var ir_args: Vec<IrType> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                ir_args.push(lower_type(args.get(i)));
                i = i + 1;
            }
            return IrType::Generic(name, ir_args);
        }
        Type::Tuple(_) => { return IrType::Opaque("tuple"); }
        Type::Func(_, _) => { return IrType::Opaque("func"); }
        Type::Assoc(_, _, _, _) => { return IrType::I64; }
        Type::Dyn(name) => { return IrType::Opaque("dyn:" + name); }
        Type::ShapedTensor(_, _) => { return IrType::Opaque("Tensor"); }
    }
    return IrType::Void;
}

// ─── Constant Folding ───────────────────────────────────────────────────

pub fn IrModule_optimize(self: &mut IrModule) -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < self.functions.len() {
        var entry: IrFunctionEntry = self.functions.get(i);
        total = total + IrFunction_constant_fold(&mut entry.func);
        self.functions.set(i, entry);
        i = i + 1;
    }
    return total;
}

fn IrFunction_constant_fold(self: &mut IrFunction) -> i64 {
    var folded: i64 = 0;
    var block_ids: Vec<i64> = Vec::new();
    var bi: i64 = 0;
    while bi < self.blocks.len() {
        block_ids.push(self.blocks.get(bi).id);
        bi = bi + 1;
    }

    var bi2: i64 = 0;
    while bi2 < block_ids.len() {
        var block_id: i64 = block_ids.get(bi2);
        var block: BasicBlock = self.blocks.get(block_id);
        var inst_ids: Vec<i64> = block.instructions;
        var ii: i64 = 0;
        while ii < inst_ids.len() {
            var inst_id: i64 = inst_ids.get(ii);
            match IrFunction_get_inst(self, inst_id) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::BinOp(op, left, right, ty) => {
                            match IrFunction_get_inst(self, left) {
                                OptInst::Some(left_inst) => {
                                    match IrFunction_get_inst(self, right) {
                                        OptInst::Some(right_inst) => {
                                            match left_inst {
                                                Inst::ConstInt(lv, _) => {
                                                    match right_inst {
                                                        Inst::ConstInt(rv, _) => {
                                                            match eval_binop_int(op, lv, rv, ty) {
                                                                OptU64::Some(result) => {
                                                                    IrFunction_set_inst(self, inst_id, Inst::ConstInt(result, ty));
                                                                    folded = folded + 1;
                                                                }
                                                                OptU64::None => {}
                                                            }
                                                        }
                                                        _ => {}
                                                    }
                                                }
                                                _ => {}
                                            }
                                        }
                                        OptInst::None => {}
                                    }
                                }
                                OptInst::None => {}
                            }
                        }
                        _ => {}
                    }
                }
                OptInst::None => {}
            }
            ii = ii + 1;
        }
        bi2 = bi2 + 1;
    }
    return folded;
}

pub fn IrFunction_set_inst(self: &mut IrFunction, id: i64, inst: Inst) {
    var i: i64 = 0;
    while i < self.insts.len() {
        if self.insts.get(i).id == id {
            var entry: ValueIdInst = self.insts.get(i);
            entry.inst = inst;
            self.insts.set(i, entry);
            return;
        }
        i = i + 1;
    }
}

pub fn IrFunction_set_meta(self: &mut IrFunction, id: i64, meta: ValueMeta) {
    var i: i64 = 0;
    while i < self.value_metas.len() {
        if self.value_metas.get(i).id == id {
            var entry: ValueIdMeta = self.value_metas.get(i);
            entry.meta = meta;
            self.value_metas.set(i, entry);
            return;
        }
        i = i + 1;
    }
}

fn eval_binop_int(op: BinOp, l: i64, r: i64, ty: IrType) -> OptU64 {
    var result: i64 = 0;
    match op {
        BinOp::Add => { result = l + r; }
        BinOp::Sub => { result = l - r; }
        BinOp::Mul => { result = l * r; }
        BinOp::Div => {
            if r == 0 { return OptU64::None; }
            result = l / r;
        }
        BinOp::Mod => {
            if r == 0 { return OptU64::None; }
            result = l % r;
        }
        BinOp::BitAnd => { result = l & r; }
        BinOp::BitOr => { result = l | r; }
        BinOp::BitXor => { result = l ^ r; }
        BinOp::Shl => { result = l << r; }
        BinOp::Shr => { result = l >> r; }
        BinOp::Eq => {
            if l == r { result = 1; } else { result = 0; }
        }
        BinOp::Neq => {
            if l != r { result = 1; } else { result = 0; }
        }
        BinOp::Lt => {
            if l < r { result = 1; } else { result = 0; }
        }
        BinOp::Gt => {
            if l > r { result = 1; } else { result = 0; }
        }
        BinOp::LtEq => {
            if l <= r { result = 1; } else { result = 0; }
        }
        BinOp::GtEq => {
            if l >= r { result = 1; } else { result = 0; }
        }
        BinOp::And => {
            if l != 0 && r != 0 { result = 1; } else { result = 0; }
        }
        BinOp::Or => {
            if l != 0 || r != 0 { result = 1; } else { result = 0; }
        }
    }
    // Truncate to target type width (sign-extend for signed types)
    match ty {
        IrType::I8 => {
            result = result & 0xFF;
            if (result & 0x80) != 0 { result = result | (~0xFF); }
        }
        IrType::U8 => { result = result & 0xFF; }
        IrType::I16 => {
            result = result & 0xFFFF;
            if (result & 0x8000) != 0 { result = result | (~0xFFFF); }
        }
        IrType::U16 => { result = result & 0xFFFF; }
        IrType::I32 => {
            result = result & 0xFFFFFFFF;
            if (result & 0x80000000) != 0 { result = result | (~0xFFFFFFFF); }
        }
        IrType::U32 => { result = result & 0xFFFFFFFF; }
        _ => {}
    }
    return OptU64::Some(result);
}

// ─── IR Verification ─────────────────────────────────────────────────────

pub struct VerificationResult {
    pub errors: Vec<str>,
    pub warnings: Vec<str>,
}

pub fn VerificationResult_new() -> VerificationResult {
    return VerificationResult {
        errors: Vec::new(),
        warnings: Vec::new(),
    };
}

pub fn VerificationResult_is_valid(self: &VerificationResult) -> bool {
    return self.errors.len() == 0;
}

pub fn IrModule_verify(self: &IrModule) -> VerificationResult {
    var result: VerificationResult = VerificationResult_new();

    var fi: i64 = 0;
    while fi < self.functions.len() {
        var entry: IrFunctionEntry = self.functions.get(fi);
        var func: IrFunction = entry.func;
        var name: str = entry.name;

        // Check: function has blocks
        if func.blocks.len() == 0 {
            result.errors.push("function '" + name + "' has no blocks");
            fi = fi + 1;
            continue;
        }

        // Check: entry block exists
        if func.blocks.get(0).id != func.entry {
            result.warnings.push("function '" + name + "': first block id " + int_to_str(func.blocks.get(0).id) + " != entry " + int_to_str(func.entry));
        }

        // Collect valid block IDs
        var valid_blocks: Vec<i64> = Vec::new();
        var bi: i64 = 0;
        while bi < func.blocks.len() {
            valid_blocks.push(func.blocks.get(bi).id);
            bi = bi + 1;
        }

        // Check each block
        var bi2: i64 = 0;
        while bi2 < func.blocks.len() {
            var block: BasicBlock = func.blocks.get(bi2);

            // Check: block has instructions
            if block.instructions.len() == 0 {
                result.warnings.push("function '" + name + "': block " + int_to_str(block.id) + " is empty");
                bi2 = bi2 + 1;
                continue;
            }

            // Check: all instruction references are valid
            var ii: i64 = 0;
            while ii < block.instructions.len() {
                var inst_id: i64 = block.instructions.get(ii);
                match IrFunction_get_inst(&func, inst_id) {
                    OptInst::None => {
                        result.errors.push("function '" + name + "': block " + int_to_str(block.id) + " references undefined instruction v" + int_to_str(inst_id));
                    }
                    OptInst::Some(_) => {}
                }
                ii = ii + 1;
            }

            // Check: block ends with a terminator
            var last_id: i64 = block.instructions.get(block.instructions.len() - 1);
            var last_is_term: bool = false;
            match IrFunction_get_inst(&func, last_id) {
                OptInst::Some(last_inst) => {
                    last_is_term = inst_is_terminator(last_inst);
                }
                OptInst::None => {}
            }
            if !last_is_term {
                result.errors.push("function '" + name + "': block " + int_to_str(block.id) + " does not end with a terminator");
            }

            // Check: no instructions after terminator
            var found_terminator: bool = false;
            var ii2: i64 = 0;
            while ii2 < block.instructions.len() {
                var iid: i64 = block.instructions.get(ii2);
                if found_terminator {
                    result.errors.push("function '" + name + "': block " + int_to_str(block.id) + " has instruction after terminator");
                    break;
                }
                match IrFunction_get_inst(&func, iid) {
                    OptInst::Some(inst) => {
                        if inst_is_terminator(inst) {
                            found_terminator = true;
                        }
                    }
                    OptInst::None => {}
                }
                ii2 = ii2 + 1;
            }

            // Check: control flow targets are valid (re-fetch last inst)
            if last_is_term {
                match IrFunction_get_inst(&func, last_id) {
                    OptInst::Some(last_inst2) => {
                        match last_inst2 {
                            Inst::Jump(target) => {
                                if !vec_contains(valid_blocks, target) {
                                    result.errors.push("function '" + name + "': block " + int_to_str(block.id) + " jumps to invalid block " + int_to_str(target));
                                }
                            }
                            Inst::Branch(then_b, else_b, _) => {
                                if !vec_contains(valid_blocks, then_b) {
                                    result.errors.push("function '" + name + "': block " + int_to_str(block.id) + " branches to invalid then-block " + int_to_str(then_b));
                                }
                                if !vec_contains(valid_blocks, else_b) {
                                    result.errors.push("function '" + name + "': block " + int_to_str(block.id) + " branches to invalid else-block " + int_to_str(else_b));
                                }
                            }
                            _ => {}
                        }
                    }
                    OptInst::None => {}
                }
            }
            bi2 = bi2 + 1;
        }

        // Check: function has a Return somewhere
        var has_return: bool = false;
        var bi3: i64 = 0;
        while bi3 < func.blocks.len() {
            var ii3: i64 = 0;
            while ii3 < func.blocks.get(bi3).instructions.len() {
                var iid: i64 = func.blocks.get(bi3).instructions.get(ii3);
                match IrFunction_get_inst(&func, iid) {
                    OptInst::Some(inst) => {
                        match inst {
                            Inst::Return(_) => { has_return = true; }
                            _ => {}
                        }
                    }
                    OptInst::None => {}
                }
                ii3 = ii3 + 1;
            }
            bi3 = bi3 + 1;
        }
        if !has_return && !ir_type_eq(func.ret_ty, IrType::Void) {
            result.warnings.push("function '" + name + "': no Return instruction");
        }

        fi = fi + 1;
    }

    return result;
}

fn vec_contains(v: Vec<i64>, val: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == val { return true; }
        i = i + 1;
    }
    return false;
}

// ─── IR Printing ─────────────────────────────────────────────────────────

pub fn IrModule_to_str(self: &IrModule) -> str {
    var out: str = "";

    // Struct layouts
    if self.struct_layouts.len() > 0 {
        out = out + "; ─── Struct Layouts ───\n";
        var i: i64 = 0;
        while i < self.struct_layouts.len() {
            var layout: StructLayout = self.struct_layouts.get(i).layout;
            out = out + "struct " + layout.name + " {\n";
            out = out + "  size: " + int_to_str(layout.size) + ", align: " + int_to_str(layout.align) + "\n";
            var j: i64 = 0;
            while j < layout.fields.len() {
                var f: StringIrTypeOffset = layout.fields.get(j);
                out = out + "  +" + int_to_str(f.offset) + " " + f.name + ": " + ir_type_to_str(f.ty) + "\n";
                j = j + 1;
            }
            out = out + "}\n\n";
            i = i + 1;
        }
    }

    // String constants
    if self.string_constants.len() > 0 {
        out = out + "; ─── String Constants ───\n";
        var i: i64 = 0;
        while i < self.string_constants.len() {
            var e: StringStringEntry = self.string_constants.get(i);
            out = out + e.val + " = \"" + e.key + "\"\n";
            i = i + 1;
        }
        out = out + "\n";
    }

    // External functions
    if self.extern_functions.len() > 0 {
        out = out + "; ─── External Functions ───\n";
        var i: i64 = 0;
        while i < self.extern_functions.len() {
            var e: StringVecIrType = self.extern_functions.get(i);
            var param_strs: str = "";
            var j: i64 = 0;
            while j < e.params.len() {
                if j > 0 { param_strs = param_strs + ", "; }
                param_strs = param_strs + ir_type_to_str(e.params.get(j));
                j = j + 1;
            }
            out = out + "extern " + e.name + "(" + param_strs + ") -> " + ir_type_to_str(e.ret) + "\n";
            i = i + 1;
        }
        out = out + "\n";
    }

    // Functions
    var i: i64 = 0;
    while i < self.functions.len() {
        var entry: IrFunctionEntry = self.functions.get(i);
        var func: IrFunction = entry.func;
        var name: str = entry.name;
        out = out + "; ─── Function: " + name + " ───\n";

        var param_strs: str = "";
        var j: i64 = 0;
        while j < func.params.len() {
            if j > 0 { param_strs = param_strs + ", "; }
            param_strs = param_strs + value_id_to_str(func.params.get(j).id) + ": " + ir_type_to_str(func.params.get(j).ty);
            j = j + 1;
        }
        out = out + "fn " + name + "(" + param_strs + ") -> " + ir_type_to_str(func.ret_ty) + " " + EffectSet_to_str(&func.effects) + "\n";
        out = out + "{\n";

        var bi: i64 = 0;
        while bi < func.blocks.len() {
            var block: BasicBlock = func.blocks.get(bi);
            out = out + "  " + block_id_to_str(block.id) + ":";
            if block.params.len() > 0 {
                var pstr: str = "";
                var pi: i64 = 0;
                while pi < block.params.len() {
                    if pi > 0 { pstr = pstr + ", "; }
                    pstr = pstr + value_id_to_str(block.params.get(pi).id) + ": " + ir_type_to_str(block.params.get(pi).ty);
                    pi = pi + 1;
                }
                out = out + " (" + pstr + ")";
            }
            if block.predecessors.len() > 0 {
                var pred_str: str = "";
                var pi: i64 = 0;
                while pi < block.predecessors.len() {
                    if pi > 0 { pred_str = pred_str + ", "; }
                    pred_str = pred_str + block_id_to_str(block.predecessors.get(pi));
                    pi = pi + 1;
                }
                out = out + "  ; preds: " + pred_str;
            }
            out = out + "\n";

            var ii: i64 = 0;
            while ii < block.instructions.len() {
                var inst_id: i64 = block.instructions.get(ii);
                var kind: str = "???";
                var meta_str: str = "";
                match IrFunction_get_inst(&func, inst_id) {
                    OptInst::Some(inst) => {
                        kind = inst_kind_name(&inst);
                    }
                    OptInst::None => {}
                }
                if kind != "???" {
                    match IrFunction_get_meta(&func, inst_id) {
                        OptValueMeta::Some(meta) => {
                            meta_str = "  ; " + ir_type_to_str(meta.ty) + " " + EffectSet_to_str(&meta.effects);
                        }
                        OptValueMeta::None => {}
                    }
                }
                out = out + "    " + value_id_to_str(inst_id) + " = " + kind + meta_str + "\n";
                ii = ii + 1;
            }
            bi = bi + 1;
        }

        out = out + "}\n\n";
        i = i + 1;
    }

    return out;
}

// ─── SourceMap generation ────────────────────────────────────────────────

pub fn IrModule_source_map(self: &IrModule) -> SourceMap {
    var map: SourceMap = SourceMap_new();
    var fi: i64 = 0;
    while fi < self.functions.len() {
        var entry: IrFunctionEntry = self.functions.get(fi);
        var func: IrFunction = entry.func;
        var vi: i64 = 0;
        while vi < func.value_metas.len() {
            var vm: ValueIdMeta = func.value_metas.get(vi);
            match vm.meta.source_line {
                OptU64::Some(line) => {
                    var inst_str: str = "?";
                    match IrFunction_get_inst(&func, vm.id) {
                        OptInst::Some(inst) => { inst_str = inst_kind_name(&inst); }
                        OptInst::None => {}
                    }
                    map.entries.push(SourceEntry_new(entry.name, vm.id, line, inst_str));
                }
                OptU64::None => {}
            }
            vi = vi + 1;
        }
        fi = fi + 1;
    }
    return map;
}
