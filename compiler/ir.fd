            return "CallPtr";
        }
        Inst::DynCall(_, _, _, _, _) => {
            return "DynCall";
        }
        Inst::MakeDyn(_, _, _) => {
            return "MakeDyn";
        }
        Inst::BitCast(_, _, _) => {
            return "BitCast";
