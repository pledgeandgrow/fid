// --- Optional-value enums ------------------------------------------------

pub enum OptIrType {
    Some(IrType),
    None,
}

pub enum OptValueId {
    Some(i64),
    None,
}

pub enum OptU64 {
    Some(i64),
    None,
}

pub enum OptString {
    Some(str),
    None,
}

// Forward-declared Option types (must appear before functions that return them
// for cross-module match patterns to typecheck correctly).
pub enum OptInst {
    Some(Inst),
    None,
}

pub enum OptValueMeta {
    Some(ValueMeta),
    None,
}

pub enum OptStructLayout {
    Some(StructLayout),
    None,
}

pub enum OptIrFunction {
    Some(IrFunction),
    None,
}

pub enum OptIrModule {
    Some(IrModule),
    None,
}

// --- IR Types ------------------------------------------------------------

pub enum IrType {
    I8,
    I16,
    I32,
    I64,
    U8,
    U16,
    U32,
    U64,
    F32,
    F64,
    Bool,
    Ptr(Box<IrType>),
    Struct(str),
    Array(Box<IrType>, i64),
    Void,
    Never,
    Opaque(str),
    Generic(str, Vec<IrType>),
}

// --- IrType methods ------------------------------------------------------

pub fn ir_type_size(t: IrType) -> i64 {
    match t {
        IrType::I8 => {
            return 1;
        }
        IrType::U8 => {
            return 1;
        }
        IrType::Bool => {
            return 1;
        }
        IrType::I16 => {
            return 2;
        }
        IrType::U16 => {
            return 2;
        }
        IrType::I32 => {
            return 4;
        }
        IrType::U32 => {
            return 4;
        }
        IrType::F32 => {
            return 4;
        }
        IrType::I64 => {
            return 8;
        }
        IrType::U64 => {
            return 8;
        }
        IrType::F64 => {
            return 8;
        }
        IrType::Ptr(_) => {
            return 8;
        }
        IrType::Struct(_) => {
            return 0;
        }
        IrType::Array(elem, count) => {
            var elem_size: i64 = box_ir_type_size(elem);
            return elem_size * count;
        }
        IrType::Void => {
            return 0;
        }
        IrType::Never => {
            return 0;
        }
        IrType::Opaque(_) => {
            return 8;
        }
        IrType::Generic(_, _) => {
            return 8;
        }
    }
    return 0;
}

// Box<IrType> variant -- Fides auto-unboxes in match patterns.
pub fn box_ir_type_size(b: Box<IrType>) -> i64 {
    match b {
        IrType::I8 => {
            return 1;
        }
        IrType::U8 => {
            return 1;
        }
        IrType::Bool => {
            return 1;
        }
        IrType::I16 => {
            return 2;
        }
        IrType::U16 => {
            return 2;
        }
        IrType::I32 => {
            return 4;
        }
        IrType::U32 => {
            return 4;
        }
        IrType::F32 => {
            return 4;
        }
        IrType::I64 => {
            return 8;
        }
        IrType::U64 => {
            return 8;
        }
        IrType::F64 => {
            return 8;
        }
        IrType::Ptr(_) => {
            return 8;
        }
        IrType::Struct(_) => {
            return 0;
        }
        IrType::Array(elem, count) => {
            var elem_size: i64 = box_ir_type_size(elem);
            return elem_size * count;
        }
        IrType::Void => {
            return 0;
        }
        IrType::Never => {
            return 0;
        }
        IrType::Opaque(_) => {
            return 8;
        }
        IrType::Generic(_, _) => {
            return 8;
        }
    }
    return 0;
}

pub fn ir_type_align(t: IrType) -> i64 {
    match t {
        IrType::I8 => {
            return 1;
        }
        IrType::U8 => {
            return 1;
        }
        IrType::Bool => {
            return 1;
        }
        IrType::I16 => {
            return 2;
        }
        IrType::U16 => {
            return 2;
        }
        IrType::I32 => {
            return 4;
        }
        IrType::U32 => {
            return 4;
        }
        IrType::F32 => {
            return 4;
        }
        IrType::I64 => {
            return 8;
        }
        IrType::U64 => {
            return 8;
        }
        IrType::F64 => {
            return 8;
        }
        IrType::Ptr(_) => {
            return 8;
        }
        IrType::Struct(_) => {
            return 8;
        }
        IrType::Array(elem, _) => {
            return box_ir_type_align(elem);
        }
        IrType::Void => {
            return 1;
        }
        IrType::Never => {
            return 1;
        }
        IrType::Opaque(_) => {
            return 8;
        }
        IrType::Generic(_, _) => {
            return 8;
        }
    }
    return 8;
}

pub fn box_ir_type_align(b: Box<IrType>) -> i64 {
    match b {
        IrType::I8 => {
            return 1;
        }
        IrType::U8 => {
            return 1;
        }
        IrType::Bool => {
            return 1;
        }
        IrType::I16 => {
            return 2;
        }
        IrType::U16 => {
            return 2;
        }
        IrType::I32 => {
            return 4;
        }
        IrType::U32 => {
            return 4;
        }
        IrType::F32 => {
            return 4;
        }
        IrType::I64 => {
            return 8;
        }
        IrType::U64 => {
            return 8;
        }
        IrType::F64 => {
            return 8;
        }
        IrType::Ptr(_) => {
            return 8;
        }
        IrType::Struct(_) => {
            return 8;
        }
        IrType::Array(elem, _) => {
            return box_ir_type_align(elem);
        }
        IrType::Void => {
            return 1;
        }
        IrType::Never => {
            return 1;
        }
        IrType::Opaque(_) => {
            return 8;
        }
        IrType::Generic(_, _) => {
            return 8;
        }
    }
    return 8;
}

pub fn ir_type_is_int(t: IrType) -> bool {
    match t {
        IrType::I8 => {
            return true;
        }
        IrType::I16 => {
            return true;
        }
        IrType::I32 => {
            return true;
        }
        IrType::I64 => {
            return true;
        }
        IrType::U8 => {
            return true;
        }
        IrType::U16 => {
            return true;
        }
        IrType::U32 => {
            return true;
        }
        IrType::U64 => {
            return true;
        }
        IrType::Bool => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

pub fn ir_type_is_float(t: IrType) -> bool {
    match t {
        IrType::F32 => {
            return true;
        }
        IrType::F64 => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

pub fn ir_type_is_ptr(t: IrType) -> bool {
    match t {
        IrType::Ptr(_) => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

pub fn ir_type_is_ptr_like(t: IrType) -> bool {
    match t {
        IrType::Ptr(_) => {
            return true;
        }
        IrType::Opaque(_) => {
            return true;
        }
        IrType::Generic(_, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

pub fn ir_type_is_opaque_named(t: IrType, name: str) -> bool {
    match t {
        IrType::Opaque(n) => {
            return n == name;
        }
        IrType::Generic(n, _) => {
            return n == name;
        }
        _ => {
            return false;
        }
    }
    return false;
}

pub fn ir_type_generic_elem(t: IrType) -> OptIrType {
    match t {
        IrType::Generic(_, args) => {
            if args.len() > 0 {
                return OptIrType::Some(args.get(0));
            }
            return OptIrType::None;
        }
        _ => {
            return OptIrType::None;
        }
    }
    return OptIrType::None;
}

pub fn ir_type_generic_args(t: IrType) -> Vec<IrType> {
    match t {
        IrType::Generic(_, args) => {
            return args;
        }
        _ => {
            return Vec::new();
        }
    }
    return Vec::new();
}

pub fn ir_type_is_signed(t: IrType) -> bool {
    match t {
        IrType::I8 => {
            return true;
        }
        IrType::I16 => {
            return true;
        }
        IrType::I32 => {
            return true;
        }
        IrType::I64 => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

pub fn ir_type_is_unsigned(t: IrType) -> bool {
    match t {
        IrType::U8 => {
            return true;
        }
        IrType::U16 => {
            return true;
        }
        IrType::U32 => {
            return true;
        }
        IrType::U64 => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

pub fn ir_type_is_numeric(t: IrType) -> bool {
    return ir_type_is_int(t) || ir_type_is_float(t);
}

pub fn ir_type_is_scalar(t: IrType) -> bool {
    return ir_type_is_numeric(t) || ir_type_eq(t, IrType::Bool);
}

pub fn ir_type_is_aggregate(t: IrType) -> bool {
    match t {
        IrType::Struct(_) => {
            return true;
        }
        IrType::Array(_, _) => {
            return true;
        }
        IrType::Opaque(_) => {
            return true;
        }
        IrType::Generic(_, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

pub fn ir_type_is_collection(t: IrType) -> bool {
    return ir_type_is_opaque_named(t, "Vec") || ir_type_is_opaque_named(t, "HashMap");
}

pub fn ir_type_is_never(t: IrType) -> bool {
    return ir_type_eq(t, IrType::Never);
}

pub fn ir_type_is_void(t: IrType) -> bool {
    return ir_type_eq(t, IrType::Void);
}

pub fn ir_type_collection_elem(t: IrType) -> OptIrType {
    match t {
        IrType::Generic(name, args) => {
            if name == "Vec" {
                if args.len() > 0 {
                    return OptIrType::Some(args.get(0));
                }
                return OptIrType::None;
            }
            if name == "HashMap" {
                if args.len() > 1 {
                    return OptIrType::Some(args.get(1));
                }
                return OptIrType::None;
            }
            return OptIrType::None;
        }
        _ => {
            return OptIrType::None;
        }
    }
    return OptIrType::None;
}

pub fn ir_type_map_key_type(t: IrType) -> OptIrType {
    match t {
        IrType::Generic(name, args) => {
            if name == "HashMap" {
                if args.len() > 0 {
                    return OptIrType::Some(args.get(0));
                }
            }
            return OptIrType::None;
        }
        _ => {
            return OptIrType::None;
        }
    }
    return OptIrType::None;
}

pub fn ir_type_map_value_type(t: IrType) -> OptIrType {
    match t {
        IrType::Generic(name, args) => {
            if name == "HashMap" {
                if args.len() > 1 {
                    return OptIrType::Some(args.get(1));
                }
            }
            return OptIrType::None;
        }
        _ => {
            return OptIrType::None;
        }
    }
    return OptIrType::None;
}

pub fn box_ir_type_eq(a: Box<IrType>, b: Box<IrType>) -> bool {
    return ir_type_eq(box_ir_type_unbox(a), box_ir_type_unbox(b));
}

pub fn box_ir_type_unbox(b: Box<IrType>) -> IrType {
    match b {
        IrType::I8 => {
            return IrType::I8;
        }
        IrType::I16 => {
            return IrType::I16;
        }
        IrType::I32 => {
            return IrType::I32;
        }
        IrType::I64 => {
            return IrType::I64;
        }
        IrType::U8 => {
            return IrType::U8;
        }
        IrType::U16 => {
            return IrType::U16;
        }
        IrType::U32 => {
            return IrType::U32;
        }
        IrType::U64 => {
            return IrType::U64;
        }
        IrType::F32 => {
            return IrType::F32;
        }
        IrType::F64 => {
            return IrType::F64;
        }
        IrType::Bool => {
            return IrType::Bool;
        }
        IrType::Ptr(inner) => {
            return IrType::Ptr(inner);
        }
        IrType::Struct(n) => {
            return IrType::Struct(n);
        }
        IrType::Array(e, c) => {
            return IrType::Array(e, c);
        }
        IrType::Void => {
            return IrType::Void;
        }
        IrType::Never => {
            return IrType::Never;
        }
        IrType::Opaque(n) => {
            return IrType::Opaque(n);
        }
        IrType::Generic(n, args) => {
            return IrType::Generic(n, args);
        }
    }
    return IrType::Void;
}

pub fn ir_type_eq(a: IrType, b: IrType) -> bool {
    match a {
        IrType::I8 => {
            return ir_type_eq_variant(b, 0);
        }
        IrType::I16 => {
            return ir_type_eq_variant(b, 1);
        }
        IrType::I32 => {
            return ir_type_eq_variant(b, 2);
        }
        IrType::I64 => {
            return ir_type_eq_variant(b, 3);
        }
        IrType::U8 => {
            return ir_type_eq_variant(b, 4);
        }
        IrType::U16 => {
            return ir_type_eq_variant(b, 5);
        }
        IrType::U32 => {
            return ir_type_eq_variant(b, 6);
        }
        IrType::U64 => {
            return ir_type_eq_variant(b, 7);
        }
        IrType::F32 => {
            return ir_type_eq_variant(b, 8);
        }
        IrType::F64 => {
            return ir_type_eq_variant(b, 9);
        }
        IrType::Bool => {
            return ir_type_eq_variant(b, 10);
        }
        IrType::Void => {
            return ir_type_eq_variant(b, 14);
        }
        IrType::Never => {
            return ir_type_eq_variant(b, 15);
        }
        IrType::Struct(n1) => {
            match b {
                IrType::Struct(n2) => {
                    return n1 == n2;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        IrType::Opaque(n1) => {
            match b {
                IrType::Opaque(n2) => {
                    return n1 == n2;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        IrType::Ptr(inner1) => {
            match b {
                IrType::Ptr(inner2) => {
                    return box_ir_type_eq(inner1, inner2);
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        IrType::Array(e1, c1) => {
            match b {
                IrType::Array(e2, c2) => {
                    if c1 != c2 {
                        return false;
                    }
                    return box_ir_type_eq(e1, e2);
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        IrType::Generic(n1, args1) => {
            match b {
                IrType::Generic(n2, args2) => {
                    if n1 != n2 {
                        return false;
                    }
                    if args1.len() != args2.len() {
                        return false;
                    }
                    var gi: i64 = 0;
                    while gi < args1.len() {
                        if !ir_type_eq(args1.get(gi), args2.get(gi)) {
                            return false;
                        }
                        gi = gi + 1;
                    }
                    return true;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
    }
    return false;
}

fn ir_type_eq_variant(t: IrType, variant: i64) -> bool {
    match t {
        IrType::I8 => {
            return variant == 0;
        }
        IrType::I16 => {
            return variant == 1;
        }
        IrType::I32 => {
            return variant == 2;
        }
        IrType::I64 => {
            return variant == 3;
        }
        IrType::U8 => {
            return variant == 4;
        }
        IrType::U16 => {
            return variant == 5;
        }
        IrType::U32 => {
            return variant == 6;
        }
        IrType::U64 => {
            return variant == 7;
        }
        IrType::F32 => {
            return variant == 8;
        }
        IrType::F64 => {
            return variant == 9;
        }
        IrType::Bool => {
            return variant == 10;
        }
        IrType::Void => {
            return variant == 14;
        }
        IrType::Never => {
            return variant == 15;
        }
        _ => {
            return false;
        }
    }
    return false;
}

pub fn ir_type_is_compatible_with(a: IrType, b: IrType) -> bool {
    if ir_type_eq(a, b) {
        return true;
    }
    match a {
        IrType::Opaque(n1) => {
            match b {
                IrType::Generic(n2, _) => {
                    return n1 == n2;
                }
                IrType::Ptr(_) => {
                    return true;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        IrType::Generic(n1, _) => {
            match b {
                IrType::Opaque(n2) => {
                    return n1 == n2;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        IrType::Ptr(inner_a) => {
            match b {
                IrType::Ptr(inner_b) => {
                    return box_ir_type_is_compatible_with(inner_a, inner_b);
                }
                IrType::Opaque(_) => {
                    return true;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        _ => {
            return false;
        }
    }
    return false;
}

pub fn box_ir_type_is_compatible_with(a: Box<IrType>, b: Box<IrType>) -> bool {
    match a {
        IrType::Opaque(n1) => {
            match b {
                IrType::Generic(n2, _) => {
                    return n1 == n2;
                }
                IrType::Ptr(_) => {
                    return true;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        IrType::Generic(n1, _) => {
            match b {
                IrType::Opaque(n2) => {
                    return n1 == n2;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        IrType::Ptr(inner_a) => {
            match b {
                IrType::Ptr(inner_b) => {
                    return box_ir_type_is_compatible_with(inner_a, inner_b);
                }
                IrType::Opaque(_) => {
                    return true;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        _ => {
            return false;
        }
    }
    return false;
}

pub fn ir_type_bit_width(t: IrType) -> OptU64 {
    match t {
        IrType::I8 => {
            return OptU64::Some(8);
        }
        IrType::U8 => {
            return OptU64::Some(8);
        }
        IrType::Bool => {
            return OptU64::Some(8);
        }
        IrType::I16 => {
            return OptU64::Some(16);
        }
        IrType::U16 => {
            return OptU64::Some(16);
        }
        IrType::I32 => {
            return OptU64::Some(32);
        }
        IrType::U32 => {
            return OptU64::Some(32);
        }
        IrType::F32 => {
            return OptU64::Some(32);
        }
        IrType::I64 => {
            return OptU64::Some(64);
        }
        IrType::U64 => {
            return OptU64::Some(64);
        }
        IrType::F64 => {
            return OptU64::Some(64);
        }
        IrType::Ptr(_) => {
            return OptU64::Some(64);
        }
        _ => {
            return OptU64::None;
        }
    }
    return OptU64::None;
}

// --- IrType Display ------------------------------------------------------

pub fn ir_type_to_str(t: IrType) -> str {
    match t {
        IrType::I8 => {
            return "i8";
        }
        IrType::I16 => {
            return "i16";
        }
        IrType::I32 => {
            return "i32";
        }
        IrType::I64 => {
            return "i64";
        }
        IrType::U8 => {
            return "u8";
        }
        IrType::U16 => {
            return "u16";
        }
        IrType::U32 => {
            return "u32";
        }
        IrType::U64 => {
            return "u64";
        }
        IrType::F32 => {
            return "f32";
        }
        IrType::F64 => {
            return "f64";
        }
        IrType::Bool => {
            return "bool";
        }
        IrType::Ptr(inner) => {
            var inner_str: str = box_ir_type_to_str(inner);
            return "*" + inner_str;
        }
        IrType::Struct(name) => {
            return "struct." + name;
        }
        IrType::Array(elem, count) => {
            var elem_str: str = box_ir_type_to_str(elem);
            return "[" + elem_str + "; " + int_to_str(count) + "]";
        }
        IrType::Void => {
            return "void";
        }
        IrType::Never => {
            return "never";
        }
        IrType::Opaque(name) => {
            return "opaque." + name;
        }
        IrType::Generic(name, args) => {
            var result: str = "generic." + name + "<";
            var i: i64 = 0;
            while i < args.len() {
                if i > 0 {
                    result = result + ", ";
                }
                result = result + ir_type_to_str(args.get(i));
                i = i + 1;
            }
            result = result + ">";
            return result;
        }
    }
    return "?";
}

pub fn box_ir_type_to_str(b: Box<IrType>) -> str {
    match b {
        IrType::I8 => {
            return "i8";
        }
        IrType::I16 => {
            return "i16";
        }
        IrType::I32 => {
            return "i32";
        }
        IrType::I64 => {
            return "i64";
        }
        IrType::U8 => {
            return "u8";
        }
        IrType::U16 => {
            return "u16";
        }
        IrType::U32 => {
            return "u32";
        }
        IrType::U64 => {
            return "u64";
        }
        IrType::F32 => {
            return "f32";
        }
        IrType::F64 => {
            return "f64";
        }
        IrType::Bool => {
            return "bool";
        }
        IrType::Ptr(inner) => {
            var inner_str: str = box_ir_type_to_str(inner);
            return "*" + inner_str;
        }
        IrType::Struct(name) => {
            return "struct." + name;
        }
        IrType::Array(elem, count) => {
            var elem_str: str = box_ir_type_to_str(elem);
            return "[" + elem_str + "; " + int_to_str(count) + "]";
        }
        IrType::Void => {
            return "void";
        }
        IrType::Never => {
            return "never";
        }
        IrType::Opaque(name) => {
            return "opaque." + name;
        }
        IrType::Generic(name, args) => {
            var result: str = "generic." + name + "<";
            var i: i64 = 0;
            while i < args.len() {
                if i > 0 {
                    result = result + ", ";
                }
                result = result + ir_type_to_str(args.get(i));
                i = i + 1;
            }
            result = result + ">";
            return result;
        }
    }
    return "?";
}

