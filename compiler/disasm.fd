// disasm.fd -- a disassembler for the machine layer's own output
// (llvm-roadmap TG5, `fid disasm`).
//
// It reads what compiler/nat_enc.fd (and the few raw words of nat_ir.fd)
// write on x86-64, AArch64 and RISC-V 64: the same encodings, read back.
// Every form is a row of one table ("The encoding forms: one table"
// below: fixed bits, operand template), which the decoders match and the
// encoders' words come from (the EFW_* constants, ef_word, ef_x64_rr), so
// the two cannot drift; tests/nattools/enc_table_unit.fd checks each
// encoder of nat_enc.fd against its row. Bytes no row has are shown as
// `.word` / `.byte`, never guessed at. scripts/enc-oracle.py checks the
// encoders against clang's assembler; scripts/disasm-check.sh checks a
// disassembly of the suite's images against llvm-objdump (where each
// instruction starts) and back through clang's assembler (that each line
// gives its own bytes again).
//
//   disasm_image(bytes, name)   an ELF executable (its .symtab) or a PE
//                               (its COFF symbols): every function, or the
//                               one named `name`
//   disasm_bytes(bytes, from, to, arch, addr)   bare code at address addr
//
// Syntax: Intel for x86-64 (`mov rax, qword [rbp - 8]`), the ARM and
// RISC-V assembler syntax for the others, with the usual aliases (mov,
// cmp, cset, li, mv, j, ret). Branch targets are absolute addresses.

module compiler::disasm;
use core;
use vec;
use string;
use compiler::nat_enc;

pub const DSM_A64: i64 = 1;
pub const DSM_RV64: i64 = 2;
pub const DSM_X64: i64 = 3;

/// An instruction: its length in bytes and its text.
pub struct DsmInsn {
    pub len: i64,
    pub text: str,
}

fn dsm_insn(len: i64, text: str) -> DsmInsn {
    return DsmInsn {
        len: len, text: text
    };
}

/// The architecture of a --arch name, 0 when it is not one.
pub fn disasm_arch_of(name: str) -> i64 {
    if name == "x86_64" || name == "x86-64" || name == "x64" || name == "amd64" {
        return DSM_X64;
    }
    if name == "aarch64" || name == "arm64" {
        return DSM_A64;
    }
    if name == "riscv64" || name == "riscv" || name == "rv64" {
        return DSM_RV64;
    }
    return 0;
}

// --- Numbers -----------------------------------------------------------------

/// `v` as `digits` lowercase hex digits (more when it needs them).
@wrapping
fn dsm_hex(v: i64, digits: i64) -> str {
    var hexd: str = "0123456789abcdef";
    var out: str = "";
    var x: i64 = v;
    var n: i64 = 0;
    while n < 16 && (n < digits || x != 0) {
        var nib: i64 = x & 15;
        out = str_slice(hexd, nib, nib + 1) + out;
        x = (x >> 4) & 0x0FFFFFFFFFFFFFFF;
        n = n + 1;
    }
    return out;
}

/// A signed number in hex: 0x10, -0x10.
@wrapping
fn dsm_shex(v: i64) -> str {
    if v < 0 {
        return "-0x" + dsm_hex(0 - v, 1);
    }
    return "0x" + dsm_hex(v, 1);
}

/// The low `bits` bits of `v` as a signed number.
@wrapping
fn dsm_sext(v: i64, bits: i64) -> i64 {
    var m: i64 = 1 << (bits - 1);
    var x: i64 = v & ((1 << bits) - 1);
    return (x ^ m) - m;
}

fn dsm_u8(b: &Vec<i64>, at: i64) -> i64 {
    if at < 0 || at >= b.len() {
        return 0;
    }
    return b.get(at) & 255;
}

@wrapping
fn dsm_u(b: &Vec<i64>, at: i64, size: i64) -> i64 {
    var v: i64 = 0;
    var i: i64 = size - 1;
    while i >= 0 {
        v = (v << 8) | dsm_u8(b, at + i);
        i = i - 1;
    }
    return v;
}

/// The little-endian 32-bit word at `at`.
fn dsm_word(b: &Vec<i64>, at: i64) -> i64 {
    return dsm_u(b, at, 4) & 0xFFFFFFFF;
}

// --- AArch64 -------------------------------------------------------------------

/// x<n> / w<n>; register 31 is `sp` or `xzr`/`wzr` as `sp31` says.
fn a64r(n: i64, wide: bool, sp31: bool) -> str {
    if n == 31 {
        if sp31 {
            if wide {
                return "sp";
            }
            return "wsp";
        }
        if wide {
            return "xzr";
        }
        return "wzr";
    }
    if wide {
        return "x" + int_to_str(n);
    }
    return "w" + int_to_str(n);
}

fn a64x(n: i64) -> str {
    return a64r(n, true, false);
}

fn a64xs(n: i64) -> str {
    return a64r(n, true, true);
}

fn a64cond(c: i64) -> str {
    var names: Vec<str> = str_split("eq,ne,hs,lo,mi,pl,vs,vc,hi,ls,ge,lt,gt,le,al,nv", ",");
    return names.get(c & 15);
}

fn a64shift(w: i64) -> str {
    var amt: i64 = (w >> 10) & 63;
    if amt == 0 {
        return "";
    }
    var kinds: Vec<str> = str_split("lsl,lsr,asr,ror", ",");
    return ", " + kinds.get((w >> 22) & 3) + " #" + int_to_str(amt);
}

// --- RISC-V 64 -------------------------------------------------------------------

fn rvr(n: i64) -> str {
    var names: Vec<str> = str_split("zero,ra,sp,gp,tp,t0,t1,t2,s0,s1,a0,a1,a2,a3,a4,a5,a6,a7,s2,s3,s4,s5,s6,s7,s8,s9,s10,s11,t3,t4,t5,t6", ",");
    return names.get(n & 31);
}

fn rvf(n: i64) -> str {
    return "f" + int_to_str(n & 31);
}

// --- x86-64 -----------------------------------------------------------------------

/// A general register of `size` bytes (8, 4, 2, 1); `rex`: a REX prefix
/// was there (byte registers 4..7 are spl..dil, else ah..bh).
fn x64r(n: i64, size: i64, rex: bool) -> str {
    if size == 8 {
        var q: Vec<str> = str_split("rax,rcx,rdx,rbx,rsp,rbp,rsi,rdi,r8,r9,r10,r11,r12,r13,r14,r15", ",");
        return q.get(n & 15);
    }
    if size == 4 {
        var d: Vec<str> = str_split("eax,ecx,edx,ebx,esp,ebp,esi,edi,r8d,r9d,r10d,r11d,r12d,r13d,r14d,r15d", ",");
        return d.get(n & 15);
    }
    if size == 2 {
        var w: Vec<str> = str_split("ax,cx,dx,bx,sp,bp,si,di,r8w,r9w,r10w,r11w,r12w,r13w,r14w,r15w", ",");
        return w.get(n & 15);
    }
    if !rex && n >= 4 && n <= 7 {
        var h: Vec<str> = str_split("ah,ch,dh,bh", ",");
        return h.get(n - 4);
    }
    var b: Vec<str> = str_split("al,cl,dl,bl,spl,bpl,sil,dil,r8b,r9b,r10b,r11b,r12b,r13b,r14b,r15b", ",");
    return b.get(n & 15);
}

fn x64cc(c: i64) -> str {
    var names: Vec<str> = str_split("o,no,b,ae,e,ne,be,a,s,ns,p,np,l,ge,le,g", ",");
    return names.get(c & 15);
}

fn x64size_word(size: i64) -> str {
    if size == 8 {
        return "qword ";
    }
    if size == 4 {
        return "dword ";
    }
    if size == 2 {
        return "word ";
    }
    return "byte ";
}

/// A ModRM operand: `len` bytes (ModRM, SIB, displacement), the register
/// field, the r/m register when mod is 3 (else -1) and the memory text
/// ([base + index*scale + disp]); `rip`: rip-relative with `disp`.
pub struct DsmModrm {
    pub len: i64,
    pub reg: i64,
    pub rm_reg: i64,
    pub mem: str,
    pub rip: bool,
    pub disp: i64,
}

@wrapping
fn x64_modrm(b: &Vec<i64>, at: i64, rex: i64) -> DsmModrm {
    var modrm: i64 = dsm_u8(b, at);
    var md: i64 = (modrm >> 6) & 3;
    var reg: i64 = ((modrm >> 3) & 7) | ((rex & 4) << 1);
    var rm: i64 = modrm & 7;
    if md == 3 {
        return DsmModrm {
            len: 1, reg: reg, rm_reg: rm | ((rex & 1) << 3), mem: "", rip: false, disp: 0
        };
    }
    var len: i64 = 1;
    var base: str = "";
    var index: str = "";
    var rip: bool = false;
    var no_base: bool = false;
    if rm == 4 {
        var sib: i64 = dsm_u8(b, at + 1);
        len = 2;
        var scale: i64 = 1 << ((sib >> 6) & 3);
        var ix: i64 = ((sib >> 3) & 7) | ((rex & 2) << 2);
        var bs: i64 = (sib & 7) | ((rex & 1) << 3);
        if ix != 4 {
            index = x64r(ix, 8, true);
            if scale > 1 {
                index = index + "*" + int_to_str(scale);
            }
        }
        if (sib & 7) == 5 && md == 0 {
            no_base = true;
        } else {
            base = x64r(bs, 8, true);
        }
    } else if rm == 5 && md == 0 {
        rip = true;
    } else {
        base = x64r(rm | ((rex & 1) << 3), 8, true);
    }
    var disp: i64 = 0;
    if md == 1 {
        disp = dsm_sext(dsm_u8(b, at + len), 8);
        len = len + 1;
    } else if md == 2 || rip || no_base {
        disp = dsm_sext(dsm_u(b, at + len, 4), 32);
        len = len + 4;
    }
    var text: str = "";
    if rip {
        text = "rip";
    } else {
        text = base;
        if str_len(index) > 0 {
            if str_len(text) > 0 {
                text = text + " + ";
            }
            text = text + index;
        }
    }
    if disp != 0 || str_len(text) == 0 {
        if str_len(text) == 0 {
            text = "0x" + dsm_hex(disp, 1);
        } else if disp < 0 {
            text = text + " - 0x" + dsm_hex(0 - disp, 1);
        } else {
            text = text + " + 0x" + dsm_hex(disp, 1);
        }
    }
    return DsmModrm {
        len: len, reg: reg, rm_reg: -1, mem: "[" + text + "]", rip: rip, disp: disp
    };
}

/// The r/m operand as text: a register of `size` bytes, or memory (with
/// its size word when `sized`).
fn x64rm(m: DsmModrm, size: i64, rex: bool, sized: bool) -> str {
    if m.rm_reg >= 0 {
        return x64r(m.rm_reg, size, rex);
    }
    if sized {
        return x64size_word(size) + m.mem;
    }
    return m.mem;
}

fn x64xmm(n: i64) -> str {
    return "xmm" + int_to_str(n & 15);
}

/// A rip-relative operand's target, once the instruction's end is known.
@wrapping
fn x64_rip_note(m: DsmModrm, end_addr: i64) -> str {
    if !m.rip {
        return "";
    }
    return "  ; 0x" + dsm_hex(end_addr + m.disp, 1);
}

// --- The encoding forms: one table --------------------------------------------
//
// TG5: every instruction form the decoders below name, in one table that
// the encoders read too (compiler/nat_enc.fd), so the two cannot drift.
// A row is the form's fixed bits and a template of its operands:
//
//   AArch64 / RISC-V   base, mask: a word w is the form when
//                      (w & mask) == base; the template's fields are the
//                      operand bits base leaves free.
//   x86-64             mandatory prefix, opcode map, opcode, ModRM.reg
//                      digit (or /r), REX.W rule; the template's fields
//                      are the ModRM operands and immediates.
//
// The template is the assembler text with each operand as {field}
// (ef_field_code lists them): `add {xd}, {xn}, {xm}{shift}`. Decoding
// renders it from the word's bits (ef_render_word, x64_render);
// encoding puts operands into those bits in template order (ef_word,
// ef_x64_rr). Rows are matched in table order within their priority:
// the aliases (priority 0: mov, cmp, neg, li, ...) before the general
// forms they are a case of. The EFW_* constants are the base words the
// encoders use, each row built from its constant; ef_check() verifies the
// table (fields inside the free bits, no row shadowed by an earlier one)
// and tests/nattools/enc_table_unit.fd checks every encoder of nat_enc.fd
// against its row, word for word, and every row decoded back.

// AArch64 base words (64-bit forms; register fields 0)
pub const EFW_A64_ADD: i64 = 0x8B000000;
pub const EFW_A64_ADDS: i64 = 0xAB000000;
pub const EFW_A64_SUB: i64 = 0xCB000000;
pub const EFW_A64_SUBS: i64 = 0xEB000000;
pub const EFW_A64_AND: i64 = 0x8A000000;
pub const EFW_A64_ORR: i64 = 0xAA000000;
pub const EFW_A64_EOR: i64 = 0xCA000000;
pub const EFW_A64_ANDS: i64 = 0xEA000000;
