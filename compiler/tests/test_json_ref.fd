use core;
use vec;
use string;

struct Foo {
    source: str,
    pos: i64,
    len: i64,
}

impl Foo {
    fn new(source: str) -> Foo {
        return Foo { source: source, pos: 0, len: str_len(source) };
    }
    
    fn peek(self: &Foo) -> i64 {
        if self.pos >= self.len { return 0; }
        return str_byte_at(self.source, self.pos);
    }
    
    fn advance(self: &mut Foo) -> i64 {
        if self.pos >= self.len { return 0; }
        var ch = str_byte_at(self.source, self.pos);
        self.pos = self.pos + 1;
        return ch;
    }
}

fn main() -> i64 {
    var f: Foo = Foo::new("null");
    print("pos = ");
    print(int_to_str(f.pos));
    print("\n");
    print("len = ");
    print(int_to_str(f.len));
    print("\n");
    print("peek = ");
    print(int_to_str(f.peek()));
    print(" (expected 110)\n");
    print("advance = ");
    print(int_to_str(f.advance()));
    print(" (expected 110)\n");
    print("pos after advance = ");
    print(int_to_str(f.pos));
    print(" (expected 1)\n");
    return 0;
}
