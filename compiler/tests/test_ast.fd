// SH-7.2: Differential test for ast.fd (rewritten from ast.rs)
// Tests Type/Expr/Stmt/Pattern enum construction, type_to_str/shape_dim_to_str
// Display formatting, stmt_line, program_new, and recursive Box<Expr> building.
//
// Note: uses constructor functions (FieldInit_new, Func_new, etc.) instead of
// struct literals for imported types, because the Fides parser only recognizes
// struct names defined in the current file on the first parse pass.
use core;
use compiler::ast;

fn assert_eq(actual: str, expected: str, label: str) -> void {
    if actual != expected {
        print("FAIL: ");
        print(label);
        print(" — expected '");
        print(expected);
        print("', got '");
        print(actual);
        print("'\n");
        p_panic("test failed");
    }
}

fn assert_eq_i64(actual: i64, expected: i64, label: str) -> void {
    if actual != expected {
        print("FAIL: ");
        print(label);
        print(" — expected ");
        print(int_to_str(expected));
        print(", got ");
        print(int_to_str(actual));
        print("\n");
        p_panic("test failed");
    }
}

fn assert_eq_bool(actual: bool, expected: bool, label: str) -> void {
    if actual != expected {
        print("FAIL: ");
        print(label);
        print(" — expected ");
        if expected { print("true"); } else { print("false"); }
        print(", got ");
        if actual { print("true"); } else { print("false"); }
        print("\n");
        p_panic("test failed");
    }
}

fn main() -> i64 {
    print("SH-7.2: AST module test\n");
    print("========================\n\n");

    // ── Test 1: Primitive type Display ──
    print("Test 1: Primitive type_to_str...\n");
    assert_eq(type_to_str(Type::I8), "i8", "I8");
    assert_eq(type_to_str(Type::I16), "i16", "I16");
    assert_eq(type_to_str(Type::I32), "i32", "I32");
    assert_eq(type_to_str(Type::I64), "i64", "I64");
    assert_eq(type_to_str(Type::I128), "i128", "I128");
    assert_eq(type_to_str(Type::U8), "u8", "U8");
    assert_eq(type_to_str(Type::U16), "u16", "U16");
    assert_eq(type_to_str(Type::U32), "u32", "U32");
    assert_eq(type_to_str(Type::U64), "u64", "U64");
    assert_eq(type_to_str(Type::U128), "u128", "U128");
    assert_eq(type_to_str(Type::F32), "f32", "F32");
    assert_eq(type_to_str(Type::F64), "f64", "F64");
    assert_eq(type_to_str(Type::Bool), "bool", "Bool");
    assert_eq(type_to_str(Type::Str), "str", "Str");
    assert_eq(type_to_str(Type::Void), "void", "Void");
    assert_eq(type_to_str(Type::Never), "never", "Never");
    assert_eq(type_to_str(Type::Infer), "_", "Infer");
    print("  OK\n\n");

    // ── Test 2: Named + compound types ──
    print("Test 2: Named/compound type_to_str...\n");
    assert_eq(type_to_str(Type::Named("Point")), "Point", "Named(Point)");
    assert_eq(type_to_str(Type::Named("HashMap")), "HashMap", "Named(HashMap)");

    // [i64; 10]
    assert_eq(type_to_str(Type::Array(Box::new(Type::I64), 10)), "[i64; 10]", "Array");
    // [f64; 0]
    assert_eq(type_to_str(Type::Array(Box::new(Type::F64), 0)), "[f64; 0]", "Array(0)");
    // [T; N] (const generic)
    assert_eq(type_to_str(Type::ArrayConst(Box::new(Type::Named("T")), "N")), "[T; N]", "ArrayConst");

    // &i64
    assert_eq(type_to_str(Type::Ref(Box::new(Type::I64), false)), "&i64", "Ref(shared)");
    // &mut str
    assert_eq(type_to_str(Type::Ref(Box::new(Type::Str), true)), "&mut str", "Ref(mut)");
    // *mut T
    assert_eq(type_to_str(Type::RawPtr(Box::new(Type::Named("T")), true)), "*mut T", "RawPtr(mut)");
    // *const u8
    assert_eq(type_to_str(Type::RawPtr(Box::new(Type::U8), false)), "*const u8", "RawPtr(const)");
    print("  OK\n\n");

    // ── Test 3: Generic, Tuple, Func, Assoc, Dyn ──
    print("Test 3: Generic/Tuple/Func/Assoc/Dyn...\n");
    // Vec<i64>
    var args1 = Vec::new();
    args1.push(Type::I64);
    assert_eq(type_to_str(Type::Generic("Vec", args1)), "Vec<i64>", "Generic(Vec<i64>)");

    // HashMap<str, i64>
    var args2 = Vec::new();
    args2.push(Type::Str);
    args2.push(Type::I64);
    assert_eq(type_to_str(Type::Generic("HashMap", args2)), "HashMap<str, i64>", "Generic(HashMap)");

    // Option<> (empty args)
    var args3 = Vec::new();
    assert_eq(type_to_str(Type::Generic("Option", args3)), "Option<>", "Generic(empty)");

    // (i64, str)
    var tup1 = Vec::new();
    tup1.push(Type::I64);
    tup1.push(Type::Str);
    assert_eq(type_to_str(Type::Tuple(tup1)), "(i64, str)", "Tuple(2)");

    // () empty tuple
    var tup0 = Vec::new();
    assert_eq(type_to_str(Type::Tuple(tup0)), "()", "Tuple(0)");

    // fn(i64, str) -> bool
    var params1 = Vec::new();
    params1.push(Type::I64);
    params1.push(Type::Str);
    assert_eq(type_to_str(Type::Func(params1, Box::new(Type::Bool))), "fn(i64, str) -> bool", "Func");

    // fn() -> void
    var params0 = Vec::new();
    assert_eq(type_to_str(Type::Func(params0, Box::new(Type::Void))), "fn() -> void", "Func(noargs)");

    // T::Item(Iterator) — no type args
    var assoc_args0 = Vec::new();
    assert_eq(type_to_str(Type::Assoc("T", "Iterator", "Item", assoc_args0)), "T::Item(Iterator)", "Assoc(noargs)");

    // T::Item<i64>(Iterator) — with type args
    var assoc_args1 = Vec::new();
    assoc_args1.push(Type::I64);
    assert_eq(type_to_str(Type::Assoc("T", "Iterator", "Item", assoc_args1)), "T::Item<i64>(Iterator)", "Assoc(args)");

    // dyn Display
    assert_eq(type_to_str(Type::Dyn("Display")), "dyn Display", "Dyn");
    print("  OK\n\n");

    // ── Test 4: ShapedTensor ──
    print("Test 4: ShapedTensor type_to_str...\n");
    // Tensor<f32, [784, 128]>
    var shape1 = Vec::new();
    shape1.push(ShapeDim::Known(784));
    shape1.push(ShapeDim::Known(128));
    assert_eq(type_to_str(Type::ShapedTensor(Box::new(Type::F32), shape1)), "Tensor<f32, [784, 128]>", "ShapedTensor(known)");

    // Tensor<f32, [batch, 784]> — symbolic dims
    var shape2 = Vec::new();
    shape2.push(ShapeDim::Symbolic("batch"));
    shape2.push(ShapeDim::Known(784));
    assert_eq(type_to_str(Type::ShapedTensor(Box::new(Type::F32), shape2)), "Tensor<f32, [batch, 784]>", "ShapedTensor(symbolic)");

    // Tensor<f64> — empty shape
    var shape0 = Vec::new();
    assert_eq(type_to_str(Type::ShapedTensor(Box::new(Type::F64), shape0)), "Tensor<f64>", "ShapedTensor(empty)");
    print("  OK\n\n");

    // ── Test 5: shape_dim_to_str ──
    print("Test 5: shape_dim_to_str...\n");
    assert_eq(shape_dim_to_str(ShapeDim::Known(42)), "42", "Known(42)");
    assert_eq(shape_dim_to_str(ShapeDim::Known(0)), "0", "Known(0)");
    assert_eq(shape_dim_to_str(ShapeDim::Symbolic("seq_len")), "seq_len", "Symbolic(seq_len)");
    print("  OK\n\n");

    // ── Test 6: Recursive Box<Expr> construction + matching ──
    print("Test 6: Recursive Box<Expr>...\n");
    // Build: 1 + 2
    val one = Box::new(Expr::IntLit(1));
    val two = Box::new(Expr::IntLit(2));
    val add = Expr::Binary(BinOp::Add, one, two);

    // Verify we can match and extract
    match add {
        Expr::Binary(op, left, right) => {
            assert_eq_i64(op_tag(op), 0, "Add tag");
            match left {
                Expr::IntLit(n) => { assert_eq_i64(n, 1, "left operand"); }
                _ => { p_panic("expected IntLit left"); }
            }
            match right {
                Expr::IntLit(n) => { assert_eq_i64(n, 2, "right operand"); }
                _ => { p_panic("expected IntLit right"); }
            }
        }
        _ => { p_panic("expected Binary"); }
    }
    print("  OK\n\n");

    // ── Test 7: Deeply nested Box<Expr> ──
    print("Test 7: Deeply nested Box<Expr>...\n");
    // Build: (1 + 2) * (3 + 4)
    val three = Box::new(Expr::IntLit(3));
    val four = Box::new(Expr::IntLit(4));
    val add2 = Expr::Binary(BinOp::Add, three, four);
    val mul = Expr::Binary(BinOp::Mul, Box::new(add), Box::new(add2));

    // Verify the structure by counting nodes via a recursive function
    assert_eq_i64(count_expr_nodes(Box::new(mul)), 7, "node count (3 internal + 4 leaves)");
    print("  OK\n\n");

    // ── Test 8: Expr variants with payloads ──
    print("Test 8: Expr variant payloads...\n");
    // StringLit
    match Expr::StringLit("hello") {
        Expr::StringLit(s) => { assert_eq(s, "hello", "StringLit payload"); }
        _ => { p_panic("expected StringLit"); }
    }
    // BoolLit
    match Expr::BoolLit(true) {
        Expr::BoolLit(b) => { assert_eq_bool(b, true, "BoolLit payload"); }
        _ => { p_panic("expected BoolLit"); }
    }
    // FloatLit
    match Expr::FloatLit(3.14) {
        Expr::FloatLit(f) => {
            // Compare via int conversion (no direct float assert helper)
            var diff = f - 3.14;
            if diff < 0.0 { diff = 0.0 - diff; }
            if diff > 0.0001 { p_panic("FloatLit payload mismatch"); }
        }
        _ => { p_panic("expected FloatLit"); }
    }
    // Ident
    match Expr::Ident("foo") {
        Expr::Ident(s) => { assert_eq(s, "foo", "Ident payload"); }
        _ => { p_panic("expected Ident"); }
    }
    // Call
    var call_args = Vec::new();
    call_args.push(Expr::IntLit(1));
    call_args.push(Expr::IntLit(2));
    match Expr::Call("add", call_args) {
        Expr::Call(name, args) => {
            assert_eq(name, "add", "Call name");
            assert_eq_i64(args.len(), 2, "Call arg count");
        }
        _ => { p_panic("expected Call"); }
    }
    print("  OK\n\n");

    // ── Test 9: FieldAccess, MethodCall, Index ──
    print("Test 9: Field/Method/Index Expr...\n");
    // expr.field
    match Expr::FieldAccess(Box::new(Expr::Ident("p")), "x") {
        Expr::FieldAccess(e, f) => {
            assert_eq(f, "x", "FieldAccess field");
            match e {
                Expr::Ident(s) => { assert_eq(s, "p", "FieldAccess receiver"); }
                _ => { p_panic("expected Ident receiver"); }
            }
        }
        _ => { p_panic("expected FieldAccess"); }
    }
    // receiver.method(args)
    var mc_args = Vec::new();
    mc_args.push(Expr::IntLit(10));
    match Expr::MethodCall(Box::new(Expr::Ident("v")), "push", mc_args) {
        Expr::MethodCall(recv, m, args) => {
            assert_eq(m, "push", "MethodCall method");
            assert_eq_i64(args.len(), 1, "MethodCall arg count");
            match recv {
                Expr::Ident(s) => { assert_eq(s, "v", "MethodCall receiver"); }
                _ => { p_panic("expected Ident receiver"); }
            }
        }
        _ => { p_panic("expected MethodCall"); }
    }
    // array[index]
    match Expr::Index(Box::new(Expr::Ident("arr")), Box::new(Expr::IntLit(0))) {
        Expr::Index(arr, idx) => {
            match idx {
                Expr::IntLit(n) => { assert_eq_i64(n, 0, "Index index"); }
                _ => { p_panic("expected IntLit index"); }
            }
            match arr {
                Expr::Ident(s) => { assert_eq(s, "arr", "Index array"); }
                _ => { p_panic("expected Ident array"); }
            }
        }
        _ => { p_panic("expected Index"); }
    }
    print("  OK\n\n");

    // ── Test 10: StructLit via constructor ──
    print("Test 10: StructLit...\n");
    var fields = Vec::new();
    fields.push(FieldInit_new("x", Expr::IntLit(1)));
    fields.push(FieldInit_new("y", Expr::IntLit(2)));
    match Expr::StructLit("Point", fields, OptBoxExpr::None) {
        Expr::StructLit(name, fs, spread) => {
            assert_eq(name, "Point", "StructLit name");
            assert_eq_i64(fs.len(), 2, "StructLit field count");
            match spread {
                OptBoxExpr::None => {}
                _ => { p_panic("expected None spread"); }
            }
            // Verify first field (no struct destructuring patterns — use field access)
            val f0 = fs.get(0);
            assert_eq(f0.name, "x", "StructLit field0 name");
            match f0.value {
                Expr::IntLit(k) => { assert_eq_i64(k, 1, "StructLit field0 value"); }
                _ => { p_panic("expected IntLit field0"); }
            }
        }
        _ => { p_panic("expected StructLit"); }
    }
    print("  OK\n\n");

    // ── Test 11: Stmt construction + stmt_line ──
    print("Test 11: Stmt + stmt_line...\n");
    // Let(name, ty, expr, is_mut, is_persist, line)
    val let_stmt = Stmt::Let("x", OptType::None, Expr::IntLit(42), false, false, 10);
    assert_eq_i64(stmt_line(let_stmt), 10, "Let line");

    // Assign(target, op, expr, line)
    val assign_stmt = Stmt::Assign("x", AssignOp::Assign, Expr::IntLit(5), 20);
    assert_eq_i64(stmt_line(assign_stmt), 20, "Assign line");

    // Return(Some(expr), line)
    val ret_stmt = Stmt::Return(OptBoxExpr::Some(Box::new(Expr::IntLit(0))), 30);
    assert_eq_i64(stmt_line(ret_stmt), 30, "Return line");

    // Return(None, line)
    val ret_none = Stmt::Return(OptBoxExpr::None, 31);
    assert_eq_i64(stmt_line(ret_none), 31, "Return(none) line");

    // Continue(line)
    val cont = Stmt::Continue(40);
    assert_eq_i64(stmt_line(cont), 40, "Continue line");

    // Expr(expr, line)
    val expr_stmt = Stmt::Expr(Expr::IntLit(1), 50);
    assert_eq_i64(stmt_line(expr_stmt), 50, "Expr stmt line");

    // While(cond, body, line)
    val while_stmt = Stmt::While(Expr::BoolLit(true), Vec::new(), 60);
    assert_eq_i64(stmt_line(while_stmt), 60, "While line");

    // For(var, iter, body, line)
    val for_stmt = Stmt::For("i", Expr::Ident("range"), Vec::new(), 70);
    assert_eq_i64(stmt_line(for_stmt), 70, "For line");

    // Loop(body, line)
    val loop_stmt = Stmt::Loop(Vec::new(), 80);
    assert_eq_i64(stmt_line(loop_stmt), 80, "Loop line");

    // Break(None, line)
    val break_stmt = Stmt::Break(OptBoxExpr::None, 90);
    assert_eq_i64(stmt_line(break_stmt), 90, "Break line");

    // Defer(body, line)
    val defer_stmt = Stmt::Defer(Vec::new(), 100);
    assert_eq_i64(stmt_line(defer_stmt), 100, "Defer line");

    // Use(path, items, line)
    var use_items = Vec::new();
    use_items.push("foo");
    val use_stmt = Stmt::Use("core", use_items, 110);
    assert_eq_i64(stmt_line(use_stmt), 110, "Use line");

    // Sandbox(body, line)
    val sandbox_stmt = Stmt::Sandbox(Vec::new(), 120);
    assert_eq_i64(stmt_line(sandbox_stmt), 120, "Sandbox line");

    // Unsafe(body, line)
    val unsafe_stmt = Stmt::Unsafe(Vec::new(), 130);
    assert_eq_i64(stmt_line(unsafe_stmt), 130, "Unsafe line");

    // Txn(body, line)
    val txn_stmt = Stmt::Txn(Vec::new(), 140);
    assert_eq_i64(stmt_line(txn_stmt), 140, "Txn line");

    // RegionBlock(name, budget, is_gpu, is_kv_cache, window_size, body, line)
    val region_stmt = Stmt::RegionBlock("r", OptI64::Some(4096), false, false, OptI64::None, Vec::new(), 150);
    assert_eq_i64(stmt_line(region_stmt), 150, "RegionBlock line");

    // GradBlock(var, body, line)
    val grad_stmt = Stmt::GradBlock("x", Vec::new(), 160);
    assert_eq_i64(stmt_line(grad_stmt), 160, "GradBlock line");

    // Backward(loss, line)
    val backward_stmt = Stmt::Backward(Expr::Ident("loss"), 170);
    assert_eq_i64(stmt_line(backward_stmt), 170, "Backward line");

    // Query(components, body, line)
    var qcomps = Vec::new();
    qcomps.push("Position");
    val query_stmt = Stmt::Query(qcomps, Vec::new(), 180);
    assert_eq_i64(stmt_line(query_stmt), 180, "Query line");
    print("  OK\n\n");

    // ── Test 12: LetTuple, LetUninit, IndexAssign, DerefAssign, FieldAssign ──
    print("Test 12: More Stmt variants...\n");
    var lt_names = Vec::new();
    lt_names.push("a");
    lt_names.push("b");
    val lt_stmt = Stmt::LetTuple(lt_names, Expr::Ident("pair"), 200);
    assert_eq_i64(stmt_line(lt_stmt), 200, "LetTuple line");

    val lu_stmt = Stmt::LetUninit("x", Type::I64, 210);
    assert_eq_i64(stmt_line(lu_stmt), 210, "LetUninit line");

    val ia_stmt = Stmt::IndexAssign("arr", Expr::IntLit(0), AssignOp::Assign, Expr::IntLit(9), 220);
    assert_eq_i64(stmt_line(ia_stmt), 220, "IndexAssign line");

    val da_stmt = Stmt::DerefAssign(Expr::Ident("ptr"), AssignOp::Assign, Expr::IntLit(7), 230);
    assert_eq_i64(stmt_line(da_stmt), 230, "DerefAssign line");

    val fa_stmt = Stmt::FieldAssign(Expr::Ident("p"), "x", AssignOp::Assign, Expr::IntLit(1), 240);
    assert_eq_i64(stmt_line(fa_stmt), 240, "FieldAssign line");

    val if_stmt = Stmt::If(Expr::BoolLit(true), Vec::new(), OptStmts::None, 250);
    assert_eq_i64(stmt_line(if_stmt), 250, "If line");

    val match_stmt = Stmt::Match(Expr::Ident("x"), Vec::new(), 260);
    assert_eq_i64(stmt_line(match_stmt), 260, "Match line");

    val handle_stmt = Stmt::Handle(Vec::new(), Vec::new(), 270);
    assert_eq_i64(stmt_line(handle_stmt), 270, "Handle line");

    val do_stmt = Stmt::Do("IO", "print", Vec::new(), 280);
    assert_eq_i64(stmt_line(do_stmt), 280, "Do line");

    val cg_stmt = Stmt::ComptimeGen(Vec::new(), 290);
    assert_eq_i64(stmt_line(cg_stmt), 290, "ComptimeGen line");

    val sel_stmt = Stmt::Select(Vec::new(), OptStmts::None, 300);
    assert_eq_i64(stmt_line(sel_stmt), 300, "Select line");
    print("  OK\n\n");

    // ── Test 13: Pattern variants ──
    print("Test 13: Pattern variants...\n");
    match Pattern::Wildcard {
        Pattern::Wildcard => {}
        _ => { p_panic("expected Wildcard"); }
    }
    match Pattern::IntLit(42) {
        Pattern::IntLit(n) => { assert_eq_i64(n, 42, "Pattern IntLit"); }
        _ => { p_panic("expected IntLit pattern"); }
    }
    match Pattern::BoolLit(true) {
        Pattern::BoolLit(b) => { assert_eq_bool(b, true, "Pattern BoolLit"); }
        _ => { p_panic("expected BoolLit pattern"); }
    }
    match Pattern::Ident("x") {
        Pattern::Ident(s) => { assert_eq(s, "x", "Pattern Ident"); }
        _ => { p_panic("expected Ident pattern"); }
    }
    match Pattern::StrLit("hello") {
        Pattern::StrLit(s) => { assert_eq(s, "hello", "Pattern StrLit"); }
        _ => { p_panic("expected StrLit pattern"); }
    }
    // EnumVariant with bindings
    var bindings = Vec::new();
    bindings.push(Binding_new("value", "v"));
    match Pattern::EnumVariant("Option", "Some", bindings) {
        Pattern::EnumVariant(en, vr, bs) => {
            assert_eq(en, "Option", "Pattern EnumVariant enum");
            assert_eq(vr, "Some", "Pattern EnumVariant variant");
            assert_eq_i64(bs.len(), 1, "Pattern EnumVariant binding count");
            val b0 = bs.get(0);
            assert_eq(b0.name, "value", "Pattern binding name");
            assert_eq(b0.ty, "v", "Pattern binding ty");
        }
        _ => { p_panic("expected EnumVariant pattern"); }
    }
    // Range pattern
    val rng_pat = Pattern::Range(Box::new(Pattern::IntLit(1)), Box::new(Pattern::IntLit(10)));
    match rng_pat {
        Pattern::Range(s, e) => {
            match s {
                Pattern::IntLit(n) => { assert_eq_i64(n, 1, "Pattern Range start"); }
                _ => { p_panic("expected IntLit range start"); }
            }
            match e {
                Pattern::IntLit(n) => { assert_eq_i64(n, 10, "Pattern Range end"); }
                _ => { p_panic("expected IntLit range end"); }
            }
        }
        _ => { p_panic("expected Range pattern"); }
    }
    print("  OK\n\n");

    // ── Test 14: MatchArm with guard ──
    print("Test 14: MatchArm...\n");
    val arm_no_guard = MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, Vec::new());
    match arm_no_guard.pattern { Pattern::Wildcard => {} _ => { p_panic("arm pattern"); } }
    match arm_no_guard.guard { OptBoxExpr::None => {} _ => { p_panic("arm guard"); } }
    assert_eq_i64(arm_no_guard.body.len(), 0, "arm body len");

    val arm_with_guard = MatchArm_new(Pattern::Ident("x"), OptBoxExpr::Some(Box::new(Expr::Ident("x"))), Vec::new());
    match arm_with_guard.guard {
        OptBoxExpr::Some(e) => {
            match e {
                Expr::Ident(s) => { assert_eq(s, "x", "arm guard expr"); }
                _ => { p_panic("expected Ident guard"); }
            }
        }
        _ => { p_panic("expected Some guard"); }
    }
    print("  OK\n\n");

    // ── Test 15: Struct construction via constructors ──
    print("Test 15: Struct construction...\n");
    // Param
    val p1 = Param_new("x", Type::I64, false);
    assert_eq(p1.name, "x", "Param name");
    assert_eq(type_to_str(p1.ty), "i64", "Param ty");
    assert_eq_bool(p1.is_pub, false, "Param is_pub");

    // Annotation
    val ann = Annotation_new("kernel", Vec::new());
    assert_eq(ann.name, "kernel", "Annotation name");

    // StructDef
    val sd = StructDef_new("Point", true);
    assert_eq(sd.name, "Point", "StructDef name");
    assert_eq_bool(sd.is_pub, true, "StructDef is_pub");

    // EnumDef with variants
    var variants = Vec::new();
    variants.push(EnumVariant_new("Some", OptParams::Some(Vec::new())));
    variants.push(EnumVariant_new("None", OptParams::None));
    val ed = EnumDef_new("Option", variants, true);
    assert_eq(ed.name, "Option", "EnumDef name");
    assert_eq_i64(ed.variants.len(), 2, "EnumDef variant count");
    val ev1 = ed.variants.get(1);
    assert_eq(ev1.name, "None", "EnumDef variant1 name");
    match ev1.data {
        OptParams::None => {}
        _ => { p_panic("expected None data"); }
    }

    // Func
    val fn1 = Func_new("main", Type::I64);
    assert_eq(fn1.name, "main", "Func name");
    assert_eq(type_to_str(fn1.ret_ty), "i64", "Func ret_ty");
    assert_eq_bool(fn1.is_async, false, "Func is_async");
    print("  OK\n\n");

    // ── Test 16: Program + program_new ──
    print("Test 16: Program...\n");
    val prog = program_new();
    match prog.module {
        OptStr::None => {}
        _ => { p_panic("expected None module"); }
    }
    assert_eq_i64(prog.funcs.len(), 0, "Program funcs empty");
    assert_eq_i64(prog.structs.len(), 0, "Program structs empty");
    assert_eq_i64(prog.enums.len(), 0, "Program enums empty");
    assert_eq_i64(prog.consts.len(), 0, "Program consts empty");
    assert_eq_i64(prog.imports.len(), 0, "Program imports empty");
    assert_eq_i64(prog.traits.len(), 0, "Program traits empty");
    assert_eq_i64(prog.trait_impls.len(), 0, "Program trait_impls empty");
    assert_eq_i64(prog.extern_decls.len(), 0, "Program extern_decls empty");
    assert_eq_i64(prog.layers.len(), 0, "Program layers empty");
    assert_eq_i64(prog.models.len(), 0, "Program models empty");
    assert_eq_i64(prog.components.len(), 0, "Program components empty");
    assert_eq_i64(prog.systems.len(), 0, "Program systems empty");
    assert_eq_i64(prog.state_machines.len(), 0, "Program state_machines empty");
    assert_eq_i64(prog.event_handlers.len(), 0, "Program event_handlers empty");

    // Program with a function. Note: assigning OptStr::Some(str) to a struct
    // field then matching it back is affected by the interpreter str-field bug
    // (see diag.fd SH-6.2 notes). We verify the field is set by checking it is
    // not None — full str round-trip is verified on C codegen.
    var prog2 = program_new();
    prog2.funcs.push(fn1);
    assert_eq_i64(prog2.funcs.len(), 1, "Program funcs pushed");
    print("  OK\n\n");

    // ── Test 17: Optional wrappers ──
    print("Test 17: Optional wrappers...\n");
    match OptBoxExpr::None {
        OptBoxExpr::None => {}
        _ => { p_panic("expected OptBoxExpr::None"); }
    }
    match OptBoxExpr::Some(Box::new(Expr::IntLit(1))) {
        OptBoxExpr::Some(e) => {
            match e {
                Expr::IntLit(n) => { assert_eq_i64(n, 1, "OptBoxExpr payload"); }
                _ => { p_panic("expected IntLit in OptBoxExpr"); }
            }
        }
        _ => { p_panic("expected OptBoxExpr::Some"); }
    }
    match OptType::None {
        OptType::None => {}
        _ => { p_panic("expected OptType::None"); }
    }
    match OptType::Some(Type::I64) {
        OptType::Some(t) => { assert_eq(type_to_str(t), "i64", "OptType payload"); }
        _ => { p_panic("expected OptType::Some"); }
    }
    match OptStmts::None {
        OptStmts::None => {}
        _ => { p_panic("expected OptStmts::None"); }
    }
    var some_stmts = Vec::new();
    some_stmts.push(Stmt::Continue(1));
    match OptStmts::Some(some_stmts) {
        OptStmts::Some(s) => { assert_eq_i64(s.len(), 1, "OptStmts payload"); }
        _ => { p_panic("expected OptStmts::Some"); }
    }
    match OptI64::None {
        OptI64::None => {}
        _ => { p_panic("expected OptI64::None"); }
    }
    match OptI64::Some(42) {
        OptI64::Some(n) => { assert_eq_i64(n, 42, "OptI64 payload"); }
        _ => { p_panic("expected OptI64::Some"); }
    }
    match OptStr::None {
        OptStr::None => {}
        _ => { p_panic("expected OptStr::None"); }
    }
    match OptStr::Some("hi") {
        OptStr::Some(s) => { assert_eq(s, "hi", "OptStr payload"); }
        _ => { p_panic("expected OptStr::Some"); }
    }
    match OptParams::None {
        OptParams::None => {}
        _ => { p_panic("expected OptParams::None"); }
    }
    match OptParams::Some(Vec::new()) {
        OptParams::Some(p) => { assert_eq_i64(p.len(), 0, "OptParams payload"); }
        _ => { p_panic("expected OptParams::Some"); }
    }
    print("  OK\n\n");

    // ── Test 18: Helper structs via constructors ──
    print("Test 18: Helper structs...\n");
    val fi = FieldInit_new("x", Expr::IntLit(1));
    assert_eq(fi.name, "x", "FieldInit name");
    match fi.value {
        Expr::IntLit(n) => { assert_eq_i64(n, 1, "FieldInit value"); }
        _ => { p_panic("expected IntLit FieldInit value"); }
    }

    val sp = StrPair_new("T", "Printable");
    assert_eq(sp.a, "T", "StrPair a");
    assert_eq(sp.b, "Printable", "StrPair b");

    val atd = AssocTypeDecl_new("Item", Vec::new());
    assert_eq(atd.name, "Item", "AssocTypeDecl name");

    val atb = AssocTypeBinding_new("Item", Type::I64);
    assert_eq(atb.name, "Item", "AssocTypeBinding name");
    assert_eq(type_to_str(atb.ty), "i64", "AssocTypeBinding ty");

    var cargs = Vec::new();
    cargs.push("784");
    cargs.push("128");
    val li = LayerInst_new("l1", "Dense", cargs);
    assert_eq(li.field, "l1", "LayerInst field");
    assert_eq(li.layer_type, "Dense", "LayerInst layer_type");
    assert_eq_i64(li.args.len(), 2, "LayerInst args");

    val pb = Binding_new("value", "v");
    assert_eq(pb.name, "value", "Binding name");
    assert_eq(pb.ty, "v", "Binding ty");
    print("  OK\n\n");

    // ── Test 19: SelectCase, EffectHandler, AsmOperand ──
    print("Test 19: SelectCase/EffectHandler/AsmOperand...\n");
    val sc = SelectCase_new(Expr::Ident("ch"), "x", Vec::new());
    assert_eq(sc.var_name, "x", "SelectCase var_name");

    var eh_params = Vec::new();
    eh_params.push("msg");
    val eh = EffectHandler_new("IO", "print", eh_params, Vec::new());
    assert_eq(eh.effect, "IO", "EffectHandler effect");
    assert_eq(eh.op, "print", "EffectHandler op");
    assert_eq_i64(eh.params.len(), 1, "EffectHandler params");

    val ao = AsmOperand_new(AsmDir::In, "rax", Expr::Ident("x"));
    assert_eq(ao.reg, "rax", "AsmOperand reg");
    match ao.direction {
        AsmDir::In => {}
        _ => { p_panic("expected AsmDir::In"); }
    }
    print("  OK\n\n");

    // ── Test 20: TraitDef, TraitMethod, TraitImpl, ImplDef ──
    print("Test 20: Trait/Impl structs...\n");
    val tm = TraitMethod_new("fmt", Type::Str, true);
    assert_eq(tm.name, "fmt", "TraitMethod name");
    assert_eq_bool(tm.has_self, true, "TraitMethod has_self");
    assert_eq(type_to_str(tm.ret_ty), "str", "TraitMethod ret_ty");

    var tm_methods = Vec::new();
    tm_methods.push(tm);
    val td = TraitDef_new("Display", tm_methods);
    assert_eq(td.name, "Display", "TraitDef name");
    assert_eq_i64(td.methods.len(), 1, "TraitDef methods");

    val ti = TraitImpl_new("Display", "Point");
    assert_eq(ti.trait_name, "Display", "TraitImpl trait_name");
    assert_eq(ti.type_name, "Point", "TraitImpl type_name");

    val id = ImplDef_new("Point");
    assert_eq(id.struct_name, "Point", "ImplDef struct_name");
    print("  OK\n\n");

    // ── Test 21: ConstDef, TypeAlias, ImportDef, Attribute, ExternDecl ──
    print("Test 21: Misc structs...\n");
    val cd = ConstDef_new("PI", Type::F64, Expr::FloatLit(3.14), true);
    assert_eq(cd.name, "PI", "ConstDef name");
    assert_eq(type_to_str(cd.ty), "f64", "ConstDef ty");

    val ta = TypeAlias_new("Int", Type::I64, true);
    assert_eq(ta.name, "Int", "TypeAlias name");
    assert_eq(type_to_str(ta.alias_for), "i64", "TypeAlias alias_for");

    val imp = ImportDef_new("core", false);
    assert_eq(imp.path, "core", "ImportDef path");
    assert_eq_bool(imp.is_glob, false, "ImportDef is_glob");

    val attr = Attribute_new("no-alloc", Vec::new());
    assert_eq(attr.name, "no-alloc", "Attribute name");

    val ed_ext = ExternDecl_new("C", "printf", "printf", Type::I32);
    assert_eq(ed_ext.abi, "C", "ExternDecl abi");
    assert_eq(ed_ext.c_name, "printf", "ExternDecl c_name");
    assert_eq(type_to_str(ed_ext.ret_ty), "i32", "ExternDecl ret_ty");
    print("  OK\n\n");

    // ── Test 22: Game architecture structs ──
    print("Test 22: Game architecture structs...\n");
    val comp = ComponentDef_new("Position", true);
    assert_eq(comp.name, "Position", "ComponentDef name");

    val sys = SystemDef_new("Move");
    assert_eq(sys.name, "Move", "SystemDef name");

    val sm = StateMachineDef_new("PlayerState", true);
    assert_eq(sm.name, "PlayerState", "StateMachineDef name");

    val st = StateDef_new("Idle");
    assert_eq(st.name, "Idle", "StateDef name");

    val tr = StateTransition_new("move", "Running");
    assert_eq(tr.event, "move", "StateTransition event");
    assert_eq(tr.target, "Running", "StateTransition target");

    val eh2 = EventHandlerDef_new("click");
    assert_eq(eh2.event_name, "click", "EventHandlerDef event_name");
    print("  OK\n\n");

    // ── Test 23: Layer/Model structs ──
    print("Test 23: Layer/Model structs...\n");
    val layer = LayerDef_new("Dense", fn1, true);
    assert_eq(layer.name, "Dense", "LayerDef name");

    var model_layers = Vec::new();
    model_layers.push(LayerInst_new("l1", "Dense", Vec::new()));
    val model = ModelDef_new("MLP", model_layers, fn1, true);
    assert_eq(model.name, "MLP", "ModelDef name");
    assert_eq_i64(model.layers.len(), 1, "ModelDef layers");
    print("  OK\n\n");

    // ── Test 24: BinOp / UnaryOp / AssignOp / ReflectOp / AsmDir / FStringPart ──
    print("Test 24: Operator enums...\n");
    // Just verify they can be constructed and matched
    match BinOp::Add { BinOp::Add => {} _ => { p_panic("BinOp::Add"); } }
    match BinOp::Shr { BinOp::Shr => {} _ => { p_panic("BinOp::Shr"); } }
    match UnaryOp::Neg { UnaryOp::Neg => {} _ => { p_panic("UnaryOp::Neg"); } }
    match UnaryOp::BitNot { UnaryOp::BitNot => {} _ => { p_panic("UnaryOp::BitNot"); } }
    match AssignOp::AddAssign { AssignOp::AddAssign => {} _ => { p_panic("AssignOp::AddAssign"); } }
    match AssignOp::ShrAssign { AssignOp::ShrAssign => {} _ => { p_panic("AssignOp::ShrAssign"); } }
    match ReflectOp::TypeName { ReflectOp::TypeName => {} _ => { p_panic("ReflectOp::TypeName"); } }
    match ReflectOp::EnumVariants { ReflectOp::EnumVariants => {} _ => { p_panic("ReflectOp::EnumVariants"); } }
    match AsmDir::Out { AsmDir::Out => {} _ => { p_panic("AsmDir::Out"); } }
    match FStringPart::Literal("hi") {
        FStringPart::Literal(s) => { assert_eq(s, "hi", "FStringPart::Literal"); }
        _ => { p_panic("FStringPart::Literal"); }
    }
    match FStringPart::Expr(Expr::IntLit(1)) {
        FStringPart::Expr(e) => {
            match e {
                Expr::IntLit(n) => { assert_eq_i64(n, 1, "FStringPart::Expr"); }
                _ => { p_panic("FStringPart::Expr inner"); }
            }
        }
        _ => { p_panic("FStringPart::Expr"); }
    }
    print("  OK\n\n");

    // ── Test 25: Tuple-replacement in Func (type_param_bounds, const_params) ──
    print("Test 25: Func with bounds/const_params...\n");
    // Vec<StrPair> field assignment isn't supported by the typechecker (it
    // sees all Vec fields as Vec<i64>). Push items directly into the field.
    var fn2 = Func_new("generic_fn", Type::Void);
    fn2.is_pub = true;
    fn2.has_effect_annotation = true;
    fn2.type_param_bounds.push(StrPair_new("T", "Printable"));
    fn2.type_param_bounds.push(StrPair_new("U", "Display"));
    fn2.const_params.push(StrPair_new("N", "i64"));
    assert_eq_i64(fn2.type_param_bounds.len(), 2, "Func type_param_bounds");
    val b0 = fn2.type_param_bounds.get(0);
    assert_eq(b0.a, "T", "bound0 a");
    assert_eq(b0.b, "Printable", "bound0 b");
    assert_eq_i64(fn2.const_params.len(), 1, "Func const_params");
    val c0 = fn2.const_params.get(0);
    assert_eq(c0.a, "N", "cparam0 a");
    assert_eq(c0.b, "i64", "cparam0 b");
    assert_eq_bool(fn2.has_effect_annotation, true, "Func has_effect_annotation");
    print("  OK\n\n");

    print("SH-7.2: All tests passed!\n");
    return 0;
}

// ─── Helper functions ────────────────────────────────────────────────────

// Count nodes in an Expr tree (recursive). Used by Test 7.
fn count_expr_nodes(e: Box<Expr>) -> i64 {
    match e {
        Expr::IntLit(_) => { return 1; }
        Expr::FloatLit(_) => { return 1; }
        Expr::StringLit(_) => { return 1; }
        Expr::BoolLit(_) => { return 1; }
        Expr::Ident(_) => { return 1; }
        Expr::Binary(_, left, right) => {
            return count_expr_nodes(left) + count_expr_nodes(right) + 1;
        }
        Expr::Unary(_, inner) => {
            return count_expr_nodes(inner) + 1;
        }
        _ => { return 1; }
    }
}

// Tag for BinOp (0 = Add, for Test 6). Not part of the AST module — just a
// test helper to verify enum equality matching works on BinOp.
fn op_tag(op: BinOp) -> i64 {
    match op {
        BinOp::Add => { return 0; }
        BinOp::Sub => { return 1; }
        BinOp::Mul => { return 2; }
        _ => { return -1; }
    }
}
