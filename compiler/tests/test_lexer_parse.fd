module compiler::test_lexer_parse;
use core;
use vec;
use compiler::lexer;
use compiler::token;
use compiler::parser;

fn main() -> i64 {
    print("START\n");
    var source: str = "fn foo() -> i64 { return 1; }";
    var lex: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lex.tokenize();
    print("Tokens: ");
    print(int_to_str(tokens.len()));
    print("\n");
    var struct_names: Vec<str> = Vec::new();
    var enum_names: Vec<str> = Vec::new();
    var p: Parser = Parser_with_names(tokens, struct_names, enum_names);
    var result: ParseResultProgram = p.parse();
    match result {
        ParseResultProgram::Ok(prog) => {
            print("OK: ");
            print(int_to_str(prog.funcs.len()));
            print(" functions\n");
        }
        ParseResultProgram::Err(e) => {
            print("ERR: ");
            print(e);
            print("\n");
        }
    }
    print("DONE\n");
    return 0;
}
