module compiler::test_parse_stdlib;
use core;
use vec;
use string;
use compiler::lexer;
use compiler::ast;
use compiler::parser;
use compiler::compiler;

fn main() -> i64 {
    print("START\n");
    print("Reading stdlib/core.fd...\n");
    var content: str = c_file_read("stdlib/core.fd");
    print("Size: ");
    print(int_to_str(str_len(content)));
    print("\n");

    print("Lexing...\n");
    var lex: Lexer = Lexer::new(content);
    var tokens: Vec<Token> = lex.tokenize();
    print("Tokens: ");
    print(int_to_str(tokens.len()));
    print("\n");

    if lex.errors.len() > 0 {
        print("Lexer errors: ");
        print(int_to_str(lex.errors.len()));
        print("\n");
    }

    print("Parsing...\n");
    var struct_names: Vec<str> = Vec::new();
    var enum_names: Vec<str> = Vec::new();
    var p: Parser = Parser_with_names(tokens, struct_names, enum_names);
    var result: ParseResultProgram = p.parse();
    match result {
        ParseResultProgram::Ok(program) => {
            print("OK: ");
            print(int_to_str(program.funcs.len()));
            print(" functions, ");
            print(int_to_str(program.structs.len()));
            print(" structs, ");
            print(int_to_str(program.enums.len()));
            print(" enums\n");
        }
        ParseResultProgram::Err(e) => {
            print("Parse error: ");
            print(e);
            print("\n");
        }
    }
    print("DONE\n");
    return 0;
}
