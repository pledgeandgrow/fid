module compiler::test_lexer_only;
use core;
use vec;
use compiler::lexer;
use compiler::token;

fn main() -> i64 {
    print("START\n");
    var source: str = "fn main() -> i64 { return 42; }";
    print("Creating lexer...\n");
    var lex: Lexer = Lexer::new(source);
    print("Lexer pos: ");
    print(int_to_str(lex.pos));
    print("\n");
    print("Tokenizing...\n");
    var tokens: Vec<Token> = lex.tokenize();
    print("Tokens: ");
    print(int_to_str(tokens.len()));
    print("\n");
    return 0;
}
