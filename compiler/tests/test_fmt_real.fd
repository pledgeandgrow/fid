use core;
use vec;
use string;
use compiler::fmt;
use fs;

fn main() -> i64 {
    // Embed a real snippet from token.fd inline (interpreter can't do file I/O for fs_read_text)
    var src: str = "// token.fd snippet
module compiler::token;

use core;
use vec;
use string;

pub enum TokenKind {
    // Keywords
    KwFn,
    KwStruct,
    KwEnum,
    KwMatch,
    KwIf,
    KwElse,
    KwWhile,
    KwFor,
    KwReturn,
    KwBreak,
    KwContinue,
    KwLet,
    KwVal,
    KwTrue,
    KwFalse,
    KwNull,
}

pub struct Token {
    kind: TokenKind,
    line: i64,
    col: i64,
}

pub fn token_new(k: TokenKind, line: i64, col: i64) -> Token {
    var t: Token;
    t.kind = k;
    t.line = line;
    t.col = col;
    return t;
}

pub fn token_kind_to_str(k: TokenKind) -> str {
    match k {
        TokenKind::KwFn => { return \"fn\"; }
        TokenKind::KwStruct => { return \"struct\"; }
        TokenKind::KwEnum => { return \"enum\"; }
        _ => { return \"?\"; }
    }
}
";
    var out: str = format_source(src);
    print(out);
    return 0;
}
