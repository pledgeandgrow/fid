module compiler::test_lexer;
use core;
use vec;
use compiler::lexer;
use compiler::token;

fn main() -> i64 {
    var source: str = "fn main() -> i64 { return 42; }";
    print("source len: ");
    print(int_to_str(str_len(source)));
    print("\n");

    var lex: Lexer = Lexer::new(source);
    print("lex.source: ");
    print(lex.source);
    print("\n");
    print("lex.source len: ");
    print(int_to_str(str_len(lex.source)));
    print("\n");
    print("lex.pos: ");
    print(int_to_str(lex.pos));
    print("\n");
    print("lex.line: ");
    print(int_to_str(lex.line));
    print("\n");
    print("lex.col: ");
    print(int_to_str(lex.col));
    print("\n");

    var tokens: Vec<Token> = lex.tokenize();
    print("tokens: ");
    print(int_to_str(tokens.len()));
    print("\n");
    return 0;
}
