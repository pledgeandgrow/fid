module compiler::test_minimal_build;
use core;
use vec;
use string;
use compiler::compiler;

fn main() -> i64 {
    print("START\n");
    var source: str = "fn main() -> i64 { return 0; }";
    print("BEFORE build_program\n");
    var result: ResultProgram = build_program(source);
    print("AFTER build_program\n");
    match result {
        ResultProgram::Ok(program) => {
            print("OK: ");
            print(int_to_str(program.funcs.len()));
            print(" functions\n");
        }
        ResultProgram::Err(errs) => {
            print("ERR: ");
            print(int_to_str(errs.len()));
            print(" errors\n");
        }
    }
    return 0;
}
