use core;
use vec;
use string;

struct Foo {
    s: str,
    a: i64,
    b: i64,
}

fn make_foo(s: str) -> Foo {
    return Foo { s: s, a: 0, b: 42 };
}

fn main() -> i64 {
    var f: Foo = make_foo("hello");
    print("a = "); print(int_to_str(f.a)); print(" (expected 0)\n");
    print("b = "); print(int_to_str(f.b)); print(" (expected 42)\n");
    return 0;
}
