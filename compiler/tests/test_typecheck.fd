module compiler::test_typecheck;
use core;
use vec;
use compiler::compiler;

fn main() -> i64 {
    print("START\n");
    var source: str = "fn foo() -> i64 { return 1; }";
    print("Calling build_program...\n");
    var result: ResultProgram = build_program(source);
    match result {
        ResultProgram::Ok(prog) => {
            print("OK: ");
            print(int_to_str(prog.funcs.len()));
            print(" functions\n");
        }
        ResultProgram::Err(errs) => {
            print("ERR: ");
            print(int_to_str(errs.len()));
            print(" errors\n");
            if errs.len() > 0 {
                print("  ");
                print(errs.get(0));
                print("\n");
            }
        }
    }
    print("DONE\n");
    return 0;
}
