module compiler::test_file_read;
use core;
use compiler::compiler;

fn main() -> i64 {
    print("START\n");
    print("Reading stdlib/core.fd...\n");
    var content: str = c_file_read("stdlib/core.fd");
    print("Size: ");
    print(int_to_str(str_len(content)));
    print("\n");
    if str_len(content) > 0 {
        print("First 20 bytes: ");
        var i: i64 = 0;
        while i < 20 {
            print(int_to_str(str_byte_at(content, i)));
            print(" ");
            i = i + 1;
        }
        print("\n");
    }
    print("DONE\n");
    return 0;
}
