use core;
use vec;
use string;
use compiler::json;

fn main() -> i64 {
    print("Testing str_len...\n");
    var s: str = "null";
    var n: i64 = str_len(s);
    print("str_len(\"null\") = ");
    print(int_to_str(n));
    print("\n");
    
    print("Testing str_byte_at...\n");
    var b0: i64 = str_byte_at(s, 0);
    print("byte[0] = ");
    print(int_to_str(b0));
    print(" (expected 110)\n");
    
    print("Testing json_parse...\n");
    val r = json_parse("null");
    match r {
        JsonResult::Ok(v) => {
            match v {
                Json::Null => { print("OK: parsed null\n"); }
                _ => { print("FAIL: wrong type\n"); }
            }
        }
        JsonResult::Err(e) => { print("FAIL: "); print(e); print("\n"); }
    }
    return 0;
}
