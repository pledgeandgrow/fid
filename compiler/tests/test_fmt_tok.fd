use core;
use vec;
use string;
use compiler::fmt;

fn main() -> i64 {
    print("Tokenizer test...\n");
    var src: str = "fn main() { val x = 1; }";
    var tokens: Vec<FTok> = fmt_tokenize(src);
    print("Token count: ");
    print(int_to_str(tokens.len()));
    print("\n");
    var i: i64 = 0;
    while i < tokens.len() {
        var t: FTok = tokens.get(i);
        var text: str = ftok_text(t);
        print("[");
        print(int_to_str(i));
        print("] ");
        print(text);
        print("\n");
        i = i + 1;
    }
    return 0;
}
