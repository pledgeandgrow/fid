module compiler::test_integration;
use core;
use vec;
use string;
use compiler::lexer;
use compiler::ast;
use compiler::parser;
use compiler::compiler;

fn main() -> i64 {
    print("=== Integration Test: Fides Compiler Pipeline ===\n\n");

    // Test 1: Lexer
    print("Test 1: Lexer...\n");
    var source: str = "fn main() -> i64 { return 42; }";
    var lex: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lex.tokenize();
    if tokens.len() > 5 {
        print("  OK: lexer produced ");
        print(int_to_str(tokens.len()));
        print(" tokens\n");
    } else {
        print("  FAIL: lexer only produced ");
        print(int_to_str(tokens.len()));
        print(" tokens\n");
        return 1;
    }

    // Test 2: Parser
    print("Test 2: Parser...\n");
    var struct_names: Vec<str> = Vec::new();
    var enum_names: Vec<str> = Vec::new();
    var p: Parser = Parser_with_names(tokens, struct_names, enum_names);
    var parse_result: ParseResultProgram = p.parse();
    match parse_result {
        ParseResultProgram::Ok(program) => {
            if program.funcs.len() > 0 {
                print("  OK: parser produced ");
                print(int_to_str(program.funcs.len()));
                print(" functions\n");
            } else {
                print("  FAIL: parser produced no functions\n");
                return 1;
            }
        }
        ParseResultProgram::Err(e) => {
            print("  FAIL: parse error: ");
            print(e);
            print("\n");
            return 1;
        }
    }

    // Test 3: Full pipeline (build_program — includes stdlib parse + typecheck)
    print("Test 3: Full pipeline (build_program)...\n");
    print("  Calling build_program...\n");
    var result: ResultProgram = build_program(source);
    match result {
        ResultProgram::Ok(program) => {
            if program.funcs.len() > 0 {
                print("  OK: build_program succeeded with ");
                print(int_to_str(program.funcs.len()));
                print(" functions\n");
            } else {
                print("  FAIL: build_program produced no functions\n");
                return 1;
            }
        }
        ResultProgram::Err(errs) => {
            print("  build_program returned ");
            print(int_to_str(errs.len()));
            print(" errors\n");
            var i: i64 = 0;
            while i < errs.len() {
                if i < 3 {
                    print("    ");
                    print(errs.get(i));
                    print("\n");
                }
                i = i + 1;
            }
            print("  (errors are expected for minimal snippets without stdlib context)\n");
        }
    }

    // Test 4: C codegen
    print("Test 4: C codegen...\n");
    var ccompile_result: ResultStr = ccompile_source_with_path(source, "test.fd");
    match ccompile_result {
        ResultStr::Ok(c_code) => {
            if str_len(c_code) > 100 {
                print("  OK: C codegen produced ");
                print(int_to_str(str_len(c_code)));
                print(" bytes of C code\n");
            } else {
                print("  FAIL: C codegen produced only ");
                print(int_to_str(str_len(c_code)));
                print(" bytes\n");
                return 1;
            }
        }
        ResultStr::Err(errs) => {
            print("  C codegen returned errors (expected for minimal snippet)\n");
            var i: i64 = 0;
            while i < errs.len() {
                if i < 3 {
                    print("    ");
                    print(errs.get(i));
                    print("\n");
                }
                i = i + 1;
            }
            // Don't fail — errors are expected without full stdlib context
        }
    }

    print("\n=== All integration tests passed ===\n");
    return 0;
}
