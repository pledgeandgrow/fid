    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // invlpg [rcx]
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x39);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_page_map(rcx=PML4 base, rdx=virt_addr, r8=phys_addr, r9=flags)
// Walks 4-level page table (PML4 → PDPT → PD → PT) and maps the page.
pub fn PeCodeGen_gen_p_page_map(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_page_map");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // Save callee-saved registers
        X86Encoder_push(&mut self.enc, PE_REG_RBP);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
        X86Encoder_push(&mut self.enc, PE_REG_R12);
        X86Encoder_push(&mut self.enc, PE_REG_R13);
        X86Encoder_push(&mut self.enc, PE_REG_R14);
        X86Encoder_push(&mut self.enc, PE_REG_R15);
        X86Encoder_sub_rsp_i32(&mut self.enc, 16);

        // r12 = PML4 base (rcx), r13 = virt_addr (rdx), r14 = phys_addr (r8), r15 = flags (r9)
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R14, PE_REG_R8);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_R9);

        // === Level 1: PML4 (bits 39-47) ===
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x27); // shr rax, 39
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x25); X86Encoder_emit_u8(&mut self.enc, 0xFF); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); // and rax, 0x1FF
        X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 3);
        X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
        X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
        X86Encoder_test_rr(&mut self.enc, PE_REG_RCX, PE_REG_RCX);
        var pm_have_pdpt: i64 = X86Encoder_alloc_label(&mut self.enc);
        // test rcx, 1 → jnz pm_have_pdpt
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xF7); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00);
        X86Encoder_jcc_label(&mut self.enc, 0x5, pm_have_pdpt);

        // Allocate new PDPT at bump allocator (0x200000)
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RAX, 0x200000);
        X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX); // rcx = bump ptr
        // Advance bump ptr by 4096
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_RCX);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x83); X86Encoder_emit_u8(&mut self.enc, 0xC2); X86Encoder_emit_u8(&mut self.enc, 0x00); // add rdx, 0
        X86Encoder_emit_u8(&mut self.enc, 0x10); // stray byte (parity with Rust)
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RDX, 4096);
        X86Encoder_add_rr(&mut self.enc, PE_REG_RDX, PE_REG_RCX);
        // Store new bump ptr: [0x200000] = rdx
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RAX, 0x200000);
        X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_RDX);
        // Zero the new page table (4096 bytes = 512 qwords)
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RDI, PE_REG_RCX); // rdi = table addr
        X86Encoder_xor_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX); // rax = 0
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 512); // rcx = 512
        X86Encoder_emit_u8(&mut self.enc, 0xF3); X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xAB); // rep stosq
        // Reload new table addr from bump ptr - 4096
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RDI); // dead code (rdi modified by rep stosq)
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RAX, 0x200000);
        X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RDX, PE_REG_RAX); // rdx = current bump
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x83); X86Encoder_emit_u8(&mut self.enc, 0xEA); X86Encoder_emit_u8(&mut self.enc, 0x10); // sub rdx, 16 (parity with Rust)
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RAX, 4096);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x29); X86Encoder_emit_u8(&mut self.enc, 0xC2); // sub rdx, rax
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RDX); // rcx = new table addr
        // or rcx, 3 (present | writable)
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x83); X86Encoder_emit_u8(&mut self.enc, 0xC9); X86Encoder_emit_u8(&mut self.enc, 0x03);
        // Re-read PML4 entry address and store
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13); // rax = virt
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x27); // shr rax, 39
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x25); X86Encoder_emit_u8(&mut self.enc, 0xFF); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); // and rax, 0x1FF
        X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 3);
        X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12); // rax = PML4 entry addr
        X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_RCX); // store entry
        // and rax, 0xFFFFF000 (dead code — parity with Rust)
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x25); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0xF0); X86Encoder_emit_u8(&mut self.enc, 0xFF); X86Encoder_emit_u8(&mut self.enc, 0xFF);
        // and rcx, ~0xFFF
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RAX, 0xFFFFFFFFFFFFF000);
        X86Encoder_and_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);

        X86Encoder_place_label(&mut self.enc, pm_have_pdpt);
        // rcx = PDPT base (strip flags from PML4 entry)
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RAX, 0xFFFFFFFFFFFFF000);
        X86Encoder_and_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);

        // === Level 2: PDPT (bits 30-38) ===
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x1E); // shr rax, 30
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x25); X86Encoder_emit_u8(&mut self.enc, 0xFF); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); // and rax, 0x1FF
        X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 3);
        X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
        X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX); // rcx = PDPT entry
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RAX, 0xFFFFFFFFFFFFF000);
        X86Encoder_and_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX); // strip flags

        // === Level 3: PD (bits 21-29) ===
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x15); // shr rax, 21
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x25); X86Encoder_emit_u8(&mut self.enc, 0xFF); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); // and rax, 0x1FF
        X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 3);
        X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
        X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX); // rcx = PD entry
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RAX, 0xFFFFFFFFFFFFF000);
        X86Encoder_and_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX); // strip flags

        // === Level 4: PT (bits 12-20) ===
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x0C); // shr rax, 12
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x25); X86Encoder_emit_u8(&mut self.enc, 0xFF); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); // and rax, 0x1FF
        X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 3);
        X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX); // rax = PT entry address

        // Set PT entry = phys_addr | flags
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R14);
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RDX, 0xFFFFFFFFFFFFF000);
        X86Encoder_and_rr(&mut self.enc, PE_REG_RCX, PE_REG_RDX); // phys & ~0xFFF
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RDX, 0x0000000000000FFF);
        X86Encoder_and_rr(&mut self.enc, PE_REG_R15, PE_REG_RDX); // flags & 0xFFF
        X86Encoder_or_rr(&mut self.enc, PE_REG_RCX, PE_REG_R15); // phys | flags
        X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_RCX); // store PTE

        // Restore and return
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x83); X86Encoder_emit_u8(&mut self.enc, 0xC4); X86Encoder_emit_u8(&mut self.enc, 0x10); // add rsp, 16
        X86Encoder_pop(&mut self.enc, PE_REG_R15);
        X86Encoder_pop(&mut self.enc, PE_REG_R14);
        X86Encoder_pop(&mut self.enc, PE_REG_R13);
        X86Encoder_pop(&mut self.enc, PE_REG_R12);
        X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_page_unmap(rcx=PML4 base, rdx=virt_addr)
// Walks to the PT entry and clears it (sets to 0), then invlpg.
pub fn PeCodeGen_gen_p_page_unmap(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_page_unmap");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        X86Encoder_push(&mut self.enc, PE_REG_RBP);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
        X86Encoder_push(&mut self.enc, PE_REG_R12);
        X86Encoder_push(&mut self.enc, PE_REG_R13);

        X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);

        // PML4 (bits 39-47)
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x27); // shr rax, 39
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x25); X86Encoder_emit_u8(&mut self.enc, 0xFF); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); // and rax, 0x1FF
        X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 3);
        X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
        X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RAX, 0xFFFFFFFFFFFFF000);
        X86Encoder_and_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);

        // PDPT (bits 30-38)
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x1E); // shr rax, 30
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x25); X86Encoder_emit_u8(&mut self.enc, 0xFF); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); // and rax, 0x1FF
        X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 3);
        X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
        X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RAX, 0xFFFFFFFFFFFFF000);
        X86Encoder_and_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);

        // PD (bits 21-29)
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x15); // shr rax, 21
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x25); X86Encoder_emit_u8(&mut self.enc, 0xFF); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); // and rax, 0x1FF
        X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 3);
        X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
        X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RAX, 0xFFFFFFFFFFFFF000);
        X86Encoder_and_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);

        // PT (bits 12-20)
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x0C); // shr rax, 12
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x25); X86Encoder_emit_u8(&mut self.enc, 0xFF); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); // and rax, 0x1FF
        X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 3);
        X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX); // rax = PT entry address

        // Clear the PTE: mov qword [rax], 0
        X86Encoder_xor_rr(&mut self.enc, PE_REG_RCX, PE_REG_RCX);
        X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_RCX);

        // invlpg [r13] — buggy first attempt (parity with Rust)
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0xBD);
        // invlpg [rcx] where rcx = virt_addr
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R13);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x39);

        X86Encoder_pop(&mut self.enc, PE_REG_R13);
        X86Encoder_pop(&mut self.enc, PE_REG_R12);
        X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_phys_read64(rcx=addr) -> rax — read 8 bytes from physical address
pub fn PeCodeGen_gen_p_phys_read64(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_phys_read64");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // mov rax, [rcx]
        X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_phys_write64(rcx=addr, rdx=val) — write 8 bytes to physical address
pub fn PeCodeGen_gen_p_phys_write64(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_phys_write64");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // mov [rcx], rdx
        X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RCX, PE_REG_RDX);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

