// addss xmm, xmm
pub fn X86Encoder_addss(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0xF3);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x58);
