// p_print_int(rcx = value) -- prints an i64 followed by newline
// Writes digits backwards from buffer end, handles negatives, single WriteFile.
pub fn PeCodeGen_gen_print_int(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_print_int");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_sub_rsp_i32(&mut self.enc, 80);

    // rax = value, r12 = original value (for sign check later)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);

    // r8 = buffer end pointer (end of local space at [rbp-24])
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_R8, -24);
    // Save buffer end in r13 for length calculation later
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_R8);

    // r9 = 10 (divisor)
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_R9, 10);

    // test rax, rax; jns pi_pos; neg rax
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var pi_pos: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 9, pi_pos); // jns
    X86Encoder_neg_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_place_label(&mut self.enc, pi_pos);

    // pi_loop: dec r8; xor rdx,rdx; div r9; add dl,'0'; mov [r8],dl; test rax,rax; jnz pi_loop
    var pi_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, pi_loop);
    X86Encoder_dec_r(&mut self.enc, PE_REG_R8);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RDX);
    X86Encoder_div_r(&mut self.enc, PE_REG_R9); // unsigned div
    X86Encoder_add_r_i8(&mut self.enc, PE_REG_RDX, 48); // '0'
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_R8, PE_REG_RDX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    X86Encoder_jcc_label(&mut self.enc, 5, pi_loop); // jnz

    // Check if original value (r12) was negative; if so prepend '-'
    var pi_no_neg: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R12, PE_REG_R12);
    X86Encoder_jcc_label(&mut self.enc, 9, pi_no_neg); // jns -- skip if non-negative
    X86Encoder_dec_r(&mut self.enc, PE_REG_R8);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RDX, 45); // '-'
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_R8, PE_REG_RDX);
    X86Encoder_place_label(&mut self.enc, pi_no_neg);

    // GetStdHandle(-11)
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, -11);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    X86Encoder_call_rip(&mut self.enc, PeCodeGen_iat_off(self, IAT_GET_STD_HANDLE));
    X86Encoder_add_rsp_i32(&mut self.enc, 32);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RAX); // handle

    // length = r13 - r8 (buffer_end - current_pos)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R9, PE_REG_R13);
    X86Encoder_sub_rr(&mut self.enc, PE_REG_R9, PE_REG_R8);

    // WriteFile(handle, r8, len, &written, NULL)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R12); // handle
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_R8);  // buffer
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R8, PE_REG_R9);   // length
    // &written = [rbp-64]: below the digit buffer, which grows down from
    // rbp-24 (at rbp-32 the zeroed count erased digits 2-5)
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_R9, -64);     // &written
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_mem_disp_reg32(&mut self.enc, PE_REG_R9, 0, PE_REG_RAX);

    X86Encoder_sub_rsp_i32(&mut self.enc, 48);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_RSP, 32, PE_REG_RAX); // lpOverlapped = NULL
    X86Encoder_call_rip(&mut self.enc, PeCodeGen_iat_off(self, IAT_WRITE_FILE));
    X86Encoder_add_rsp_i32(&mut self.enc, 48);

    // return 0
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_add_rsp_i32(&mut self.enc, 80);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// Helper: emit GetStdHandle(-11) call, result in RAX
pub fn PeCodeGen_emit_get_std_handle(self: &mut PeCodeGen) {
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, -11);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    X86Encoder_call_rip(&mut self.enc, PeCodeGen_iat_off(self, IAT_GET_STD_HANDLE));
    X86Encoder_add_rsp_i32(&mut self.enc, 32);
}

// Helper: emit WriteFile(rax=hFile, rdx=buffer, r8=len, r9=&written)
pub fn PeCodeGen_emit_write_file(self: &mut PeCodeGen) {
    X86Encoder_sub_rsp_i32(&mut self.enc, 48);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_RSP, 32, PE_REG_RAX);
    X86Encoder_call_rip(&mut self.enc, PeCodeGen_iat_off(self, IAT_WRITE_FILE));
    X86Encoder_add_rsp_i32(&mut self.enc, 48);
}

// Helper: strlen part of p_print_str
pub fn PeCodeGen_gen_print_str_strlen(self: &mut PeCodeGen) {
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RCX);
    var slen_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, slen_loop);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RDX, PE_REG_RAX);
    X86Encoder_cmp_r8_i8(&mut self.enc, PE_REG_RDX, 0);
    var slen_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, slen_done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RCX);
    X86Encoder_jmp_label(&mut self.enc, slen_loop);
    X86Encoder_place_label(&mut self.enc, slen_done);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -16, PE_REG_RCX);
}

// Helper: WriteFile part of p_print_str
pub fn PeCodeGen_gen_print_str_write(self: &mut PeCodeGen) {
    X86Encoder_mov_reg_mem_rbp(&mut self.enc, PE_REG_RDX, -8);
    X86Encoder_mov_reg_mem_rbp(&mut self.enc, PE_REG_R8, -16);
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_R9, -24);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_mem_disp_reg32(&mut self.enc, PE_REG_R9, 0, PE_REG_RAX);
    PeCodeGen_emit_write_file(self);
}

// p_print_str(rcx = *u8 string pointer)
pub fn PeCodeGen_gen_print_str(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_print_str");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_sub_rsp_i32(&mut self.enc, 64);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -8, PE_REG_RCX);
    PeCodeGen_gen_print_str_strlen(self);
    PeCodeGen_emit_get_std_handle(self);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    PeCodeGen_gen_print_str_write(self);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_print_bool(rcx = 0|1) -- prints "true" or "false" + newline
pub fn PeCodeGen_gen_print_bool(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_print_bool");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_sub_rsp_i32(&mut self.enc, 64);

    // test rcx, rcx; jnz pb_true
    var pb_true: i64 = X86Encoder_alloc_label(&mut self.enc);
    var pb_print: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RCX, PE_REG_RCX);
    X86Encoder_jcc_label(&mut self.enc, 5, pb_true); // jne

    // false
    var false_off: i64 = PeCodeGen_get_string_offset(self, "false");
    X86Encoder_lea_rip(&mut self.enc, PE_REG_R12, false_off);
    X86Encoder_jmp_label(&mut self.enc, pb_print);

    // true
    X86Encoder_place_label(&mut self.enc, pb_true);
    var true_off: i64 = PeCodeGen_get_string_offset(self, "true");
    X86Encoder_lea_rip(&mut self.enc, PE_REG_R12, true_off);

    X86Encoder_place_label(&mut self.enc, pb_print);

    // Calculate length (strlen on r12)
    X86Encoder_xor_self(&mut self.enc, PE_REG_R8);
    var pb_len: i64 = X86Encoder_alloc_label(&mut self.enc);
    var pb_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, pb_len);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_R12, PE_REG_R8);
    X86Encoder_cmp_r8_i8(&mut self.enc, PE_REG_RAX, 0);
    X86Encoder_jcc_label(&mut self.enc, 4, pb_done); // je
    X86Encoder_inc_r(&mut self.enc, PE_REG_R8);
    X86Encoder_jmp_label(&mut self.enc, pb_len);
    X86Encoder_place_label(&mut self.enc, pb_done);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_R8);

    // WriteFile(stdout, r12, r13, ...)
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, -11);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    X86Encoder_call_rip(&mut self.enc, PeCodeGen_iat_off(self, IAT_GET_STD_HANDLE));
    X86Encoder_add_rsp_i32(&mut self.enc, 32);

    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R8, PE_REG_R13);
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_R9, -32);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_mem_disp_reg32(&mut self.enc, PE_REG_R9, 0, PE_REG_RAX);

    X86Encoder_sub_rsp_i32(&mut self.enc, 48);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_RSP, 32, PE_REG_RAX);
    X86Encoder_call_rip(&mut self.enc, PeCodeGen_iat_off(self, IAT_WRITE_FILE));
    X86Encoder_add_rsp_i32(&mut self.enc, 48);

    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_add_rsp_i32(&mut self.enc, 64);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_panic(rcx = *u8 message) -- exits with code 1
pub fn PeCodeGen_gen_panic(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_panic");
    X86Encoder_place_label(&mut self.enc, lbl);
    // ExitProcess(1)
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 1);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    X86Encoder_call_rip(&mut self.enc, PeCodeGen_iat_off(self, IAT_EXIT_PROCESS));
    X86Encoder_add_rsp_i32(&mut self.enc, 32);
    X86Encoder_ud2(&mut self.enc);
}

// p_malloc(rcx = size) -> rax = ptr
pub fn PeCodeGen_gen_malloc(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_malloc");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // Bare-metal bump allocator: heap ptr stored at 0x300000
        // Load current heap ptr from 0x300000
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RAX, 0x300000);
        X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
        // Check if first allocation (rax == 0)
        X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
        var not_first: i64 = X86Encoder_alloc_label(&mut self.enc);
        X86Encoder_jcc_label(&mut self.enc, 0x5, not_first);
        // First allocation: set heap ptr to 0x300008
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RAX, 0x300008);
        X86Encoder_place_label(&mut self.enc, not_first);
        // Save old ptr in r12
        X86Encoder_push(&mut self.enc, PE_REG_R12);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RAX);
        // Align size to 8 bytes: add rcx, 7; and rcx, ~7
        X86Encoder_emit_u8(&mut self.enc, 0x48);
        X86Encoder_emit_u8(&mut self.enc, 0x83);
        X86Encoder_emit_u8(&mut self.enc, 0xC1);
        X86Encoder_emit_u8(&mut self.enc, 0x07);
        X86Encoder_emit_u8(&mut self.enc, 0x48);
        X86Encoder_emit_u8(&mut self.enc, 0x83);
        X86Encoder_emit_u8(&mut self.enc, 0xE1);
        X86Encoder_emit_u8(&mut self.enc, 0xF8);
        // new_ptr = rax + rcx
        X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
        // Store new heap ptr: [0x300000] = rax
        X86Encoder_mov_imm64(&mut self.enc, PE_REG_RCX, 0x300000);
        X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
        // Return old ptr
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
        X86Encoder_pop(&mut self.enc, PE_REG_R12);
        X86Encoder_ret(&mut self.enc);
    } else {
        // Windows HeapAlloc
        X86Encoder_push(&mut self.enc, PE_REG_RBP);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
        X86Encoder_push(&mut self.enc, PE_REG_R12);
        X86Encoder_push(&mut self.enc, PE_REG_R13);
        X86Encoder_sub_rsp_i32(&mut self.enc, 48);

        // Save size in r12 before GetProcessHeap clobbers RCX
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);

        // GetProcessHeap()
        X86Encoder_sub_rsp_i32(&mut self.enc, 32);
        X86Encoder_call_rip(&mut self.enc, PeCodeGen_iat_off(self, IAT_GET_PROCESS_HEAP));
        X86Encoder_add_rsp_i32(&mut self.enc, 32);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RAX); // r13 = heap handle

        // HeapAlloc(heap, 0, size)
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R13); // heap
        X86Encoder_xor_self(&mut self.enc, PE_REG_RDX); // flags = 0
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R8, PE_REG_R12); // size (saved)
        X86Encoder_sub_rsp_i32(&mut self.enc, 32);
        X86Encoder_call_rip(&mut self.enc, PeCodeGen_iat_off(self, IAT_HEAP_ALLOC));
        X86Encoder_add_rsp_i32(&mut self.enc, 32);

        X86Encoder_add_rsp_i32(&mut self.enc, 48);
        X86Encoder_pop(&mut self.enc, PE_REG_R13);
        X86Encoder_pop(&mut self.enc, PE_REG_R12);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
        X86Encoder_pop(&mut self.enc, PE_REG_RBP);
        X86Encoder_ret(&mut self.enc);
    }
}

// p_free(rcx = ptr) -- HeapFree the pointer
pub fn PeCodeGen_gen_free(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_free");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // Bare-metal: no-op (bump allocator doesn't support freeing)
        X86Encoder_ret(&mut self.enc);
    } else {
        // Windows HeapFree
        X86Encoder_push(&mut self.enc, PE_REG_RBP);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
        X86Encoder_push(&mut self.enc, PE_REG_R12);
        X86Encoder_push(&mut self.enc, PE_REG_R13);
        X86Encoder_sub_rsp_i32(&mut self.enc, 48);

        // Save ptr in r12
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);

        // GetProcessHeap()
        X86Encoder_sub_rsp_i32(&mut self.enc, 32);
        X86Encoder_call_rip(&mut self.enc, PeCodeGen_iat_off(self, IAT_GET_PROCESS_HEAP));
        X86Encoder_add_rsp_i32(&mut self.enc, 32);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RAX); // r13 = heap handle

        // HeapFree(heap, 0, ptr)
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R13); // heap
        X86Encoder_xor_self(&mut self.enc, PE_REG_RDX); // flags = 0
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R8, PE_REG_R12); // ptr (saved)
        X86Encoder_sub_rsp_i32(&mut self.enc, 32);
        X86Encoder_call_rip(&mut self.enc, PeCodeGen_iat_off(self, IAT_HEAP_FREE));
        X86Encoder_add_rsp_i32(&mut self.enc, 32);

        X86Encoder_add_rsp_i32(&mut self.enc, 48);
        X86Encoder_pop(&mut self.enc, PE_REG_R13);
        X86Encoder_pop(&mut self.enc, PE_REG_R12);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
        X86Encoder_pop(&mut self.enc, PE_REG_RBP);
        X86Encoder_ret(&mut self.enc);
    }
}

// p_memset(rcx=ptr, rdx=val, r8=size) — fill memory with val byte for size bytes
pub fn PeCodeGen_gen_memset(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_memset");
    X86Encoder_place_label(&mut self.enc, lbl);
    // rcx = ptr, rdx = val (byte), r8 = size
    // Simple byte-by-byte loop: while r8 > 0 { *rcx = dl; rcx++; r8-- }
    var loop_start: i64 = X86Encoder_alloc_label(&mut self.enc);
    var loop_end: i64 = X86Encoder_alloc_label(&mut self.enc);
    // if size <= 0, skip
    X86Encoder_test_rr(&mut self.enc, PE_REG_R8, PE_REG_R8);
    X86Encoder_jcc_label(&mut self.enc, 0x4, loop_end); // jz -> end (cc 4: jcc_label adds 0x80; 0x84 wrapped to the invalid 0F 04)
    X86Encoder_place_label(&mut self.enc, loop_start);
    // Store byte: mov byte [rcx], dl
    X86Encoder_emit_u8(&mut self.enc, 0x88); X86Encoder_emit_u8(&mut self.enc, 0x11);
    // rcx++
    X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xFF); X86Encoder_emit_u8(&mut self.enc, 0xC1);
    // r8-- (REX.B selects r8; 48 FF C8 would be `dec rax`, leaving the count
    // unchanged so the loop zeroed the stack until it crashed)
    X86Encoder_emit_u8(&mut self.enc, 0x49); X86Encoder_emit_u8(&mut self.enc, 0xFF); X86Encoder_emit_u8(&mut self.enc, 0xC8);
    // if r8 != 0, loop
    X86Encoder_test_rr(&mut self.enc, PE_REG_R8, PE_REG_R8);
    X86Encoder_jcc_label(&mut self.enc, 0x5, loop_start); // jnz -> loop_start
    X86Encoder_place_label(&mut self.enc, loop_end);
    X86Encoder_ret(&mut self.enc);
}

// p_str_concat(rcx = left, rdx = right) -> rax = new string
pub fn PeCodeGen_gen_str_concat(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_str_concat");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_sub_rsp_i32(&mut self.enc, 40);

    // r12 = left, r13 = right
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);

    // r14 = strlen(left) + strlen(right)
    X86Encoder_xor_self(&mut self.enc, PE_REG_R14);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    var sc1b: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, sc1b);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RCX);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RCX, PE_REG_RCX);
    var sc1done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, sc1done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_jmp_label(&mut self.enc, sc1b);
    X86Encoder_place_label(&mut self.enc, sc1done);

    // Add strlen(right)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    var sc2: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, sc2);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RCX);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RCX, PE_REG_RCX);
    var sc2done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, sc2done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_jmp_label(&mut self.enc, sc2);
    X86Encoder_place_label(&mut self.enc, sc2done);

    // malloc(r14+1)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R14);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RCX);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R9, PE_REG_RAX);

    // Copy left
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R8, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R10, PE_REG_R9);
    var cc1: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, cc1);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R8);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_R10, PE_REG_RAX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var cc1done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, cc1done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R8);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R10);
    X86Encoder_jmp_label(&mut self.enc, cc1);
    X86Encoder_place_label(&mut self.enc, cc1done);

    // Copy right
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R8, PE_REG_R13);
    var cc2: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, cc2);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R8);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_R10, PE_REG_RAX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var cc2done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, cc2done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R8);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R10);
    X86Encoder_jmp_label(&mut self.enc, cc2);
    X86Encoder_place_label(&mut self.enc, cc2done);

    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R9);
    X86Encoder_add_rsp_i32(&mut self.enc, 40);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_to_str(rcx = i64) -> rax = *u8 string
pub fn PeCodeGen_gen_to_str(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_to_str");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_sub_rsp_i32(&mut self.enc, 56);

    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_R13, -40);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R14);

    // Handle 0
    X86Encoder_test_rr(&mut self.enc, PE_REG_R12, PE_REG_R12);
    var ts_notzero: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 5, ts_notzero);

    // value == 0
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 48);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_R13, PE_REG_RAX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 0);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R13);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_R13, PE_REG_RAX);
    X86Encoder_dec_r(&mut self.enc, PE_REG_R13);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 2);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RCX, PE_REG_R13);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R13);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RCX, PE_REG_R13);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_dec_r(&mut self.enc, PE_REG_RAX);
    var ts_zero_ret: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jmp_label(&mut self.enc, ts_zero_ret);

    X86Encoder_place_label(&mut self.enc, ts_notzero);

    // Handle negative
    X86Encoder_xor_self(&mut self.enc, PE_REG_R8);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R12, PE_REG_R12);
    var ts_pos: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 3, ts_pos); // jns
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_sub_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RAX);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_R8, 1);

    X86Encoder_place_label(&mut self.enc, ts_pos);

    // Extract digits
    X86Encoder_xor_self(&mut self.enc, PE_REG_R14);
    var ts_loop2: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, ts_loop2);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 10);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RDX);
    X86Encoder_div_r(&mut self.enc, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RAX);
    X86Encoder_add_r_i8(&mut self.enc, PE_REG_RDX, 48);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RDX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R12, PE_REG_R12);
    X86Encoder_jcc_label(&mut self.enc, 5, ts_loop2);

    // Add sign
    X86Encoder_test_rr(&mut self.enc, PE_REG_R8, PE_REG_R8);
    var ts_nosign: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, ts_nosign);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 45); // '-'
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R13);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RCX, PE_REG_R14);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_place_label(&mut self.enc, ts_nosign);

    // Reverse buffer
    X86Encoder_xor_self(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R8, PE_REG_R14);
    X86Encoder_dec_r(&mut self.enc, PE_REG_R8);
    var ts_rev: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, ts_rev);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R12, PE_REG_R8);
    var ts_revdone: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 3, ts_revdone); // jae
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R8);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RDX, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RDX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R8);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R12);
    X86Encoder_dec_r(&mut self.enc, PE_REG_R8);
    X86Encoder_jmp_label(&mut self.enc, ts_rev);
    X86Encoder_place_label(&mut self.enc, ts_revdone);

    // Null terminator
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RCX, 0);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);

    // malloc + copy
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R14);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RAX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R8);
    var ts_cp2: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, ts_cp2);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R8, PE_REG_R14);
    var ts_cp2d: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 3, ts_cp2d);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R8);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R8);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R8);
    X86Encoder_jmp_label(&mut self.enc, ts_cp2);
    X86Encoder_place_label(&mut self.enc, ts_cp2d);

    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_place_label(&mut self.enc, ts_zero_ret);

    X86Encoder_add_rsp_i32(&mut self.enc, 56);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

