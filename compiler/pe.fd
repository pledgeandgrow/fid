// p_vec_contains(rcx=*Vec, rdx=i64 value) -> rax = bool
pub fn PeCodeGen_gen_vec_contains(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_vec_contains");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, REG_RBP, REG_RSP);
    X86Encoder_push(&mut self.enc, REG_R12);
    X86Encoder_push(&mut self.enc, REG_R13);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    X86Encoder_mov_reg_ptr(&mut self.enc, REG_R12, REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, REG_R13, REG_RDX);
    X86Encoder_mov_reg_mem_disp(&mut self.enc, REG_R9, REG_RCX, 8);
    X86Encoder_xor_self(&mut self.enc, REG_R10);
    var loop_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    var not_found: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, loop_label);
    X86Encoder_cmp_rr(&mut self.enc, REG_R10, REG_R9);
    X86Encoder_jcc_label(&mut self.enc, 3, not_found);
    X86Encoder_mov_rr(&mut self.enc, REG_RAX, REG_R10);
    X86Encoder_shl_r_i8(&mut self.enc, REG_RAX, 3);
    X86Encoder_add_rr(&mut self.enc, REG_RAX, REG_R12);
    X86Encoder_mov_reg_ptr(&mut self.enc, REG_RAX, REG_RAX);
    X86Encoder_cmp_rr(&mut self.enc, REG_RAX, REG_R13);
    X86Encoder_jcc_label(&mut self.enc, 4, not_found);
    X86Encoder_inc_r(&mut self.enc, REG_R10);
    X86Encoder_jmp_label(&mut self.enc, loop_label);
    X86Encoder_place_label(&mut self.enc, not_found);
    X86Encoder_xor_self(&mut self.enc, REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, REG_RSP, REG_RBP);
    X86Encoder_pop(&mut self.enc, REG_R13);
    X86Encoder_pop(&mut self.enc, REG_R12);
    X86Encoder_pop(&mut self.enc, REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_vec_truncate(rcx=*Vec, rdx=i64 new_len)
pub fn PeCodeGen_gen_vec_truncate(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_vec_truncate");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_mov_reg_mem_disp(&mut self.enc, REG_RAX, REG_RCX, 8);
    X86Encoder_cmp_rr(&mut self.enc, REG_RAX, REG_RDX);
    var skip: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 2, skip);
    X86Encoder_xor_self(&mut self.enc, REG_RAX);
    X86Encoder_ret(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, skip);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, REG_RCX, 8, REG_RDX);
    X86Encoder_xor_self(&mut self.enc, REG_RAX);
    X86Encoder_ret(&mut self.enc);
}

// p_vec_clone(rcx=*Vec) -> rax = *Vec (shallow copy)
pub fn PeCodeGen_gen_vec_clone(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_vec_clone");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, REG_RBP, REG_RSP);
    X86Encoder_push(&mut self.enc, REG_R12);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    X86Encoder_mov_rr(&mut self.enc, REG_R12, REG_RCX);
    X86Encoder_mov_imm32(&mut self.enc, REG_RCX, 24);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, REG_R9, REG_RAX);
    X86Encoder_mov_reg_mem_disp(&mut self.enc, REG_RCX, REG_R12, 0);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, REG_R9, 0, REG_RCX);
    X86Encoder_mov_reg_mem_disp(&mut self.enc, REG_RCX, REG_R12, 8);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, REG_R9, 8, REG_RCX);
    X86Encoder_mov_reg_mem_disp(&mut self.enc, REG_RCX, REG_R12, 16);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, REG_R9, 16, REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, REG_RAX, REG_R9);
    X86Encoder_mov_rr(&mut self.enc, REG_RSP, REG_RBP);
    X86Encoder_pop(&mut self.enc, REG_R12);
    X86Encoder_pop(&mut self.enc, REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

