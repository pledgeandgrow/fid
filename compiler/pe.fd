// movss [rbp + disp], xmm
pub fn X86Encoder_movss_mem_rbp_xmm(self: &mut X86Encoder, disp: i64, xmm: i64) {
    self.code.push(0xF3);
    X86Encoder_rex_w(self);
    self.code.push(0x0F);
    self.code.push(0x11);
    X86Encoder_emit_mem_rbp(self, xmm & 7, disp);
