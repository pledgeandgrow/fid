    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_RCX, 8, PE_REG_RAX);
    X86Encoder_ret(&mut self.enc);
}

// p_map_keys(rcx=*Map) -> rax = *Vec
// Allocates a Vec and copies all keys from the map.
// Map layout: [entries_ptr, len, cap], each entry is 16 bytes (key_ptr, value).
pub fn PeCodeGen_gen_map_keys(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_map_keys");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_push(&mut self.enc, PE_REG_R15);
    // r12 = map, r13 = entries ptr, r14 = count, r15 = vec
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    // Get entries ptr (map[0])
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R13, PE_REG_R12);
    // Get count (map[1] at offset 8)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R14, PE_REG_RAX);
    // Allocate Vec (24 bytes)
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 24);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RAX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RCX);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_R15, PE_REG_RCX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R15, 8, PE_REG_RCX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R15, 16, PE_REG_RCX);
    // Iterate entries, push each key to vec
    X86Encoder_xor_self(&mut self.enc, PE_REG_R10);
    var loop_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, loop_label);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R10, PE_REG_R14);
    X86Encoder_jcc_label(&mut self.enc, 3, done);
    // Get key ptr from entry: entries + idx * 16
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R10);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 4);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    // Push key to vec (simplified: store in vec data at index)
    X86Encoder_mov_mem_idx_reg(&mut self.enc, PE_REG_R15, PE_REG_R10, PE_REG_RAX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R10);
    X86Encoder_jmp_label(&mut self.enc, loop_label);
    X86Encoder_place_label(&mut self.enc, done);
    // Set vec len
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R15, 8, PE_REG_R10);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_map_values(rcx=*Map) -> rax = *Vec
// Allocates a Vec and copies all values from the map.
// Map layout: [entries_ptr, len, cap], each entry is 16 bytes (key_ptr, value).
pub fn PeCodeGen_gen_map_values(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_map_values");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_push(&mut self.enc, PE_REG_R15);
    // r12 = map, r13 = entries ptr, r14 = count, r15 = vec
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    // Get entries ptr (map[0])
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R13, PE_REG_R12);
    // Get count (map[1] at offset 8)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R14, PE_REG_RAX);
    // Allocate Vec (24 bytes)
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 24);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RAX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RCX);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_R15, PE_REG_RCX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R15, 8, PE_REG_RCX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R15, 16, PE_REG_RCX);
    // Iterate entries, push each value to vec
    X86Encoder_xor_self(&mut self.enc, PE_REG_R10);
    var loop_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, loop_label);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R10, PE_REG_R14);
    X86Encoder_jcc_label(&mut self.enc, 3, done);
    // Get value from entry: entries + idx * 16 + 8
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R10);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 4);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    // Push value to vec
    X86Encoder_mov_mem_idx_reg(&mut self.enc, PE_REG_R15, PE_REG_R10, PE_REG_RAX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R10);
    X86Encoder_jmp_label(&mut self.enc, loop_label);
    X86Encoder_place_label(&mut self.enc, done);
    // Set vec len
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R15, 8, PE_REG_R10);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_map_get_or(rcx=*Map, rdx=*u8 key, r8=i64 default) -> rax = i64
// Calls p_map_contains; if key exists, calls p_map_get, else returns default.
pub fn PeCodeGen_gen_map_get_or(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_map_get_or");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    // Save args: r12 = map, r13 = key, r14 = default
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R14, PE_REG_R8);
    // Call p_map_contains(map, key)
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_map_contains"));
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var not_found: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, not_found);
    // Found: call p_map_get(map, key) — restore rcx and rdx first
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_R13);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_map_get"));
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jmp_label(&mut self.enc, done);
    X86Encoder_place_label(&mut self.enc, not_found);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    X86Encoder_place_label(&mut self.enc, done);
    X86Encoder_add_rsp_i32(&mut self.enc, 32);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_map_clone(rcx=*Map) -> rax = *Map (new map with same entries)
// Allocates a new Map and copies all entries from the source.
// Map layout: [entries_ptr, len, cap], each entry is 16 bytes (key_ptr, value).
pub fn PeCodeGen_gen_map_clone(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_map_clone");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_push(&mut self.enc, PE_REG_R15);
    // r12 = src map, r13 = src entries ptr, r14 = count, r15 = new map
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    // Get entries ptr (map[0])
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R13, PE_REG_R12);
    // Get count (map[1] at offset 8)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R14, PE_REG_RAX);
    // Allocate new Map (24 bytes)
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 24);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RAX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RCX);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_R15, PE_REG_RCX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R15, 8, PE_REG_RCX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R15, 16, PE_REG_RCX);
    // Allocate entries array (count * 16 bytes)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R14);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 4);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_R15, PE_REG_RAX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R15, 8, PE_REG_R14);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R15, 16, PE_REG_R14);
    // Copy entries
    X86Encoder_xor_self(&mut self.enc, PE_REG_R10);
    var loop_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, loop_label);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R10, PE_REG_R14);
    X86Encoder_jcc_label(&mut self.enc, 3, done);
    // Copy key ptr: src[idx*16] -> dst[idx*16]
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R10);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 4);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R11, PE_REG_R10);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_R11, 4);
    X86Encoder_mov_mem_idx_reg(&mut self.enc, PE_REG_R15, PE_REG_R11, PE_REG_RAX);
    // Copy value: src[idx*16+8] -> dst[idx*16+8]
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R10);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 4);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R11, PE_REG_R10);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_R11, 4);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_R11, 8);
    X86Encoder_mov_mem_idx_reg(&mut self.enc, PE_REG_R15, PE_REG_R11, PE_REG_RAX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R10);
    X86Encoder_jmp_label(&mut self.enc, loop_label);
    X86Encoder_place_label(&mut self.enc, done);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// ===========================================================================
// String runtime stubs (ported from src/pe.rs)
// ===========================================================================

// p_string_from -- identity for strings
pub fn PeCodeGen_gen_string_from(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_from");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_ret(&mut self.enc);
}

// p_string_len -- strlen
pub fn PeCodeGen_gen_string_len(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_len");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    var loop_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, loop_label);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R9, PE_REG_R12, PE_REG_RAX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R9, PE_REG_R9);
    X86Encoder_jcc_label(&mut self.enc, 4, done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_jmp_label(&mut self.enc, loop_label);
    X86Encoder_place_label(&mut self.enc, done);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_is_empty
pub fn PeCodeGen_gen_string_is_empty(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_is_empty");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    X86Encoder_setcc_r(&mut self.enc, 4, PE_REG_RAX);
    X86Encoder_movzx_r32_r8(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    X86Encoder_ret(&mut self.enc);
}

// p_string_push_str -- same as p_str_concat
pub fn PeCodeGen_gen_string_push_str(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_push_str");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_str_concat"));
    X86Encoder_ret(&mut self.enc);
}

// p_string_slice -- pointer offset
pub fn PeCodeGen_gen_string_slice(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_slice");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RDX);
    X86Encoder_ret(&mut self.enc);
}

// p_string_contains(rcx=*u8 haystack, rdx=*u8 needle) -> rax = bool
// Naive substring search: returns 1 if needle found in haystack, 0 otherwise.
pub fn PeCodeGen_gen_string_contains(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_contains");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    // r12 = haystack, r13 = needle, r14 = current search position
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R14);
    // If needle is empty, return true
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var empty_needle: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, empty_needle);
    var outer_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    var not_found: i64 = X86Encoder_alloc_label(&mut self.enc);
    var found: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, outer_loop);
    // Check if haystack[r14] == 0 (end of haystack)
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_R12, PE_REG_R14);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    X86Encoder_jcc_label(&mut self.enc, 4, not_found);
    // Compare haystack+r14 with needle
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    var inner_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, inner_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R9, PE_REG_R13, PE_REG_RAX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R9, PE_REG_R9);
    X86Encoder_jcc_label(&mut self.enc, 4, found);
    X86Encoder_add_rr(&mut self.enc, PE_REG_R9, PE_REG_R14);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R10, PE_REG_R12, PE_REG_R9);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R10, PE_REG_R9);
    var mismatch: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 5, mismatch);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_jmp_label(&mut self.enc, inner_loop);
    X86Encoder_place_label(&mut self.enc, mismatch);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_jmp_label(&mut self.enc, outer_loop);
    X86Encoder_place_label(&mut self.enc, found);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RAX, 1);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jmp_label(&mut self.enc, done);
    X86Encoder_place_label(&mut self.enc, not_found);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_jmp_label(&mut self.enc, done);
    X86Encoder_place_label(&mut self.enc, empty_needle);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RAX, 1);
    X86Encoder_place_label(&mut self.enc, done);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_starts_with(rcx=*u8 str, rdx=*u8 prefix) -> rax = bool
// Compares bytes until prefix ends. Returns 1 if match, 0 otherwise.
pub fn PeCodeGen_gen_string_starts_with(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_starts_with");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    // r12 = str, r13 = prefix
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);
    var loop_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    var true_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    var false_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, loop_label);
    // Load prefix byte
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    X86Encoder_jcc_label(&mut self.enc, 4, true_label);
    // Load str byte
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_R9, PE_REG_R12);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R9, PE_REG_RAX);
    X86Encoder_jcc_label(&mut self.enc, 5, false_label);
    // Advance both pointers
    X86Encoder_inc_r(&mut self.enc, PE_REG_R12);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R13);
    X86Encoder_jmp_label(&mut self.enc, loop_label);
    X86Encoder_place_label(&mut self.enc, true_label);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RAX, 1);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jmp_label(&mut self.enc, done);
    X86Encoder_place_label(&mut self.enc, false_label);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_place_label(&mut self.enc, done);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_ends_with(rcx=*u8 str, rdx=*u8 suffix) -> rax = bool
// Computes strlen of both, then compares from the end.
pub fn PeCodeGen_gen_string_ends_with(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_ends_with");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_push(&mut self.enc, PE_REG_R15);
    // r12 = str, r13 = suffix
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);
    // Compute strlen(str) in R14
    X86Encoder_xor_self(&mut self.enc, PE_REG_R14);
    var slen_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, slen_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_R12, PE_REG_R14);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var slen_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, slen_done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_jmp_label(&mut self.enc, slen_loop);
    X86Encoder_place_label(&mut self.enc, slen_done);
    // Compute strlen(suffix) in R15
    X86Encoder_xor_self(&mut self.enc, PE_REG_R15);
    var flen_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, flen_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_R13, PE_REG_R15);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var flen_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, flen_done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R15);
    X86Encoder_jmp_label(&mut self.enc, flen_loop);
    X86Encoder_place_label(&mut self.enc, flen_done);
    // If suffix_len > str_len, return false
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R15, PE_REG_R14);
    var false_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 7, false_label);
    // str + (str_len - suffix_len) = start of comparison
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    X86Encoder_sub_rr(&mut self.enc, PE_REG_RAX, PE_REG_R15);
    X86Encoder_add_rr(&mut self.enc, PE_REG_R12, PE_REG_RAX);
    // Compare suffix bytes with str suffix
    X86Encoder_xor_self(&mut self.enc, PE_REG_R14);
    var cmp_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, cmp_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_R13, PE_REG_R14);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var true_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, true_label);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R9, PE_REG_R12, PE_REG_R14);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R9, PE_REG_RAX);
    X86Encoder_jcc_label(&mut self.enc, 5, false_label);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_jmp_label(&mut self.enc, cmp_loop);
    X86Encoder_place_label(&mut self.enc, true_label);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RAX, 1);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jmp_label(&mut self.enc, done);
    X86Encoder_place_label(&mut self.enc, false_label);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_place_label(&mut self.enc, done);
    X86Encoder_pop(&mut self.enc, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_trim(rcx=*u8 str) -> rax = *u8 (trimmed)
// Skips leading whitespace, returns pointer to first non-ws char.
pub fn PeCodeGen_gen_string_trim(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_trim");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    // r12 = str pointer
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    var loop_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, loop_label);
    // Load current byte
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, done);
    // Check if whitespace: space(32), tab(9), newline(10), cr(13)
    X86Encoder_cmp_r8_i8(&mut self.enc, PE_REG_RAX, 32);
    var advance: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, advance);
    X86Encoder_cmp_r8_i8(&mut self.enc, PE_REG_RAX, 9);
    X86Encoder_jcc_label(&mut self.enc, 4, advance);
    X86Encoder_cmp_r8_i8(&mut self.enc, PE_REG_RAX, 10);
    X86Encoder_jcc_label(&mut self.enc, 4, advance);
    X86Encoder_cmp_r8_i8(&mut self.enc, PE_REG_RAX, 13);
    X86Encoder_jcc_label(&mut self.enc, 4, advance);
    X86Encoder_jmp_label(&mut self.enc, done);
    X86Encoder_place_label(&mut self.enc, advance);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R12);
    X86Encoder_jmp_label(&mut self.enc, loop_label);
    X86Encoder_place_label(&mut self.enc, done);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_split(rcx=*u8 str, rdx=*u8 delim) -> rax = *Vec
// Allocates a Vec and splits the string by delimiter.
// Each element is a pointer to a substring (null-terminated copy).
pub fn PeCodeGen_gen_string_split(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_split");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_push(&mut self.enc, PE_REG_R15);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    // r12 = str, r13 = delim, r14 = vec pointer, r15 = start of current token
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RCX);
    // Allocate Vec (24 bytes: data, len, cap)
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 24);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R14, PE_REG_RAX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RCX);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_R14, PE_REG_RCX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R14, 8, PE_REG_RCX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R14, 16, PE_REG_RCX);
    var loop_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, loop_label);
    // Load current byte from str
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    X86Encoder_jcc_label(&mut self.enc, 4, done);
    // Check if current char matches delimiter first byte
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_R9, PE_REG_R13);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_RAX, PE_REG_R9);
    var advance: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 5, advance);
    // Delimiter match: push substring [r15, r12) as a new string
    // Compute token length = r12 - r15
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_sub_rr(&mut self.enc, PE_REG_RAX, PE_REG_R15);
    // Allocate token string (len + 1 for null)
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 1);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    // Copy token bytes
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSI, PE_REG_R15);
    var copy_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R10);
    X86Encoder_place_label(&mut self.enc, copy_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R11, PE_REG_RSI, PE_REG_R10);
    X86Encoder_mov_mem_idx_reg8(&mut self.enc, PE_REG_RDX, PE_REG_R10, PE_REG_R11);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R10);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R10, PE_REG_R12);
    X86Encoder_sub_rr(&mut self.enc, PE_REG_R10, PE_REG_R15);
    X86Encoder_jcc_label(&mut self.enc, 2, copy_loop);
    // Null-terminate
    X86Encoder_xor_self(&mut self.enc, PE_REG_R11);
    X86Encoder_mov_mem_idx_reg8(&mut self.enc, PE_REG_RDX, PE_REG_R10, PE_REG_R11);
    // Push token to vec (simplified: just increment vec len)
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R14, 8, PE_REG_RDX);
    // Advance past delimiter
    X86Encoder_inc_r(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_R12);
    X86Encoder_jmp_label(&mut self.enc, loop_label);
    X86Encoder_place_label(&mut self.enc, advance);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R12);
    X86Encoder_jmp_label(&mut self.enc, loop_label);
    X86Encoder_place_label(&mut self.enc, done);
    // Push last token if any
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_sub_rr(&mut self.enc, PE_REG_RAX, PE_REG_R15);
    var no_last: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    X86Encoder_jcc_label(&mut self.enc, 4, no_last);
    // Allocate and copy last token
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 1);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSI, PE_REG_R15);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R10);
    var last_copy: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, last_copy);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R11, PE_REG_RSI, PE_REG_R10);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R11, PE_REG_R11);
    X86Encoder_jcc_label(&mut self.enc, 4, no_last);
    X86Encoder_mov_mem_idx_reg8(&mut self.enc, PE_REG_RDX, PE_REG_R10, PE_REG_R11);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R10);
    X86Encoder_jmp_label(&mut self.enc, last_copy);
    X86Encoder_place_label(&mut self.enc, no_last);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    X86Encoder_add_rsp_i32(&mut self.enc, 32);
    X86Encoder_pop(&mut self.enc, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_replace(rcx=*u8 str, rdx=*u8 from, r8=*u8 to) -> rax = *u8
// Replaces all occurrences of 'from' with 'to' in 'str'.
// Allocates a new string with replacements applied.
pub fn PeCodeGen_gen_string_replace(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_replace");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_push(&mut self.enc, PE_REG_R15);
    // r12 = str, r13 = from, r14 = to, r15 = result pointer
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R14, PE_REG_R8);
    // Compute strlen(str) for initial allocation
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    var slen_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, slen_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R9, PE_REG_R12, PE_REG_RAX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R9, PE_REG_R9);
    var slen_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, slen_done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_jmp_label(&mut self.enc, slen_loop);
    X86Encoder_place_label(&mut self.enc, slen_done);
    // Allocate result buffer (strlen + 1, simplified — no expansion for 'to' > 'from')
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 1);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RAX);
    // Copy str to result, replacing 'from' with 'to' (single-char replacement)
    X86Encoder_xor_self(&mut self.enc, PE_REG_R10);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R11);
    var copy_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, copy_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_R12, PE_REG_R10);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    X86Encoder_jcc_label(&mut self.enc, 4, done);
    // Check if current char matches 'from' first byte
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_R9, PE_REG_R13);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_RAX, PE_REG_R9);
    var no_match: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 5, no_match);
    // Match: copy 'to' string
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R10);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_R14);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R10);
    var to_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, to_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_R12, PE_REG_R10);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var to_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, to_done);
    X86Encoder_mov_mem_idx_reg8(&mut self.enc, PE_REG_R15, PE_REG_R11, PE_REG_RAX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R11);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R10);
    X86Encoder_jmp_label(&mut self.enc, to_loop);
    X86Encoder_place_label(&mut self.enc, to_done);
    X86Encoder_pop(&mut self.enc, PE_REG_R10);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R10);
    X86Encoder_jmp_label(&mut self.enc, copy_loop);
    X86Encoder_place_label(&mut self.enc, no_match);
    X86Encoder_mov_mem_idx_reg8(&mut self.enc, PE_REG_R15, PE_REG_R11, PE_REG_RAX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R11);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R10);
    X86Encoder_jmp_label(&mut self.enc, copy_loop);
    X86Encoder_place_label(&mut self.enc, done);
    // Null-terminate result
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_mem_idx_reg8(&mut self.enc, PE_REG_R15, PE_REG_R11, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_char_at -- pointer offset
pub fn PeCodeGen_gen_string_char_at(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_char_at");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RDX);
    X86Encoder_ret(&mut self.enc);
}

// p_string_to_uppercase(rcx=*u8 str) -> rax = *u8 (new uppercase string)
// Allocates a new string and converts a-z to A-Z.
pub fn PeCodeGen_gen_string_to_uppercase(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_to_uppercase");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    // Compute strlen
    X86Encoder_xor_self(&mut self.enc, PE_REG_R14);
    var slen_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, slen_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_RCX, PE_REG_R14);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var slen_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, slen_done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_jmp_label(&mut self.enc, slen_loop);
    X86Encoder_place_label(&mut self.enc, slen_done);
    // Allocate len+1
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 1);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RAX);
    // Copy and convert
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    var copy_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, copy_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R9, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R9, PE_REG_R9);
    X86Encoder_jcc_label(&mut self.enc, 4, done);
    // Check if 'a' <= R9 <= 'z'
    X86Encoder_cmp_r8_i8(&mut self.enc, PE_REG_R9, 97);
    X86Encoder_jcc_label(&mut self.enc, 2, done);
    X86Encoder_cmp_r8_i8(&mut self.enc, PE_REG_R9, 122);
    var no_conv: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 7, no_conv);
    // Convert: subtract 32
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_R9, -32);
    X86Encoder_place_label(&mut self.enc, no_conv);
    X86Encoder_mov_mem_idx_reg8(&mut self.enc, PE_REG_R12, PE_REG_RAX, PE_REG_R9);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_jmp_label(&mut self.enc, copy_loop);
    X86Encoder_place_label(&mut self.enc, done);
    // Null-terminate
    X86Encoder_xor_self(&mut self.enc, PE_REG_R9);
    X86Encoder_mov_mem_idx_reg8(&mut self.enc, PE_REG_R12, PE_REG_RAX, PE_REG_R9);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_to_lowercase(rcx=*u8 str) -> rax = *u8 (new lowercase string)
// Allocates a new string and converts A-Z to a-z.
pub fn PeCodeGen_gen_string_to_lowercase(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_to_lowercase");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    // Compute strlen
    X86Encoder_xor_self(&mut self.enc, PE_REG_R14);
    var slen_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, slen_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_RCX, PE_REG_R14);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var slen_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, slen_done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_jmp_label(&mut self.enc, slen_loop);
    X86Encoder_place_label(&mut self.enc, slen_done);
    // Allocate len+1
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 1);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RAX);
    // Copy and convert
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    var copy_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, copy_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R9, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R9, PE_REG_R9);
    X86Encoder_jcc_label(&mut self.enc, 4, done);
    // Check if 'A' <= R9 <= 'Z'
    X86Encoder_cmp_r8_i8(&mut self.enc, PE_REG_R9, 65);
    X86Encoder_jcc_label(&mut self.enc, 2, done);
    X86Encoder_cmp_r8_i8(&mut self.enc, PE_REG_R9, 90);
    var no_conv: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 7, no_conv);
    // Convert: add 32
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_R9, 32);
    X86Encoder_place_label(&mut self.enc, no_conv);
    X86Encoder_mov_mem_idx_reg8(&mut self.enc, PE_REG_R12, PE_REG_RAX, PE_REG_R9);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_jmp_label(&mut self.enc, copy_loop);
    X86Encoder_place_label(&mut self.enc, done);
    // Null-terminate
    X86Encoder_xor_self(&mut self.enc, PE_REG_R9);
    X86Encoder_mov_mem_idx_reg8(&mut self.enc, PE_REG_R12, PE_REG_RAX, PE_REG_R9);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_parse_int -- atoi
pub fn PeCodeGen_gen_string_parse_int(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_parse_int");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    var loop_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, loop_label);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_R9, PE_REG_R12);
    X86Encoder_cmp_r8_i8(&mut self.enc, PE_REG_R9, 48);
    X86Encoder_jcc_label(&mut self.enc, 2, done);
    X86Encoder_cmp_r8_i8(&mut self.enc, PE_REG_R9, 57);
    X86Encoder_jcc_label(&mut self.enc, 7, done);
    X86Encoder_imul_r_r_imm32(&mut self.enc, PE_REG_RAX, PE_REG_RAX, 10);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_R9, -48);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R9);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R12);
    X86Encoder_jmp_label(&mut self.enc, loop_label);
    X86Encoder_place_label(&mut self.enc, done);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_find(rcx=*u8 haystack, rdx=*u8 needle) -> rax = i64 (index or -1)
// Naive substring search returning the byte index of the first occurrence.
pub fn PeCodeGen_gen_string_find(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_find");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    // r12 = haystack, r13 = needle, r14 = current search position
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R14);
    // If needle is empty, return 0
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var empty_needle: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, empty_needle);
    var outer_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    var not_found: i64 = X86Encoder_alloc_label(&mut self.enc);
    var found: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, outer_loop);
    // Check if haystack[r14] == 0 (end of haystack)
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_R12, PE_REG_R14);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    X86Encoder_jcc_label(&mut self.enc, 4, not_found);
    // Compare haystack+r14 with needle
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    var inner_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, inner_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R9, PE_REG_R13, PE_REG_RAX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R9, PE_REG_R9);
    X86Encoder_jcc_label(&mut self.enc, 4, found);
    X86Encoder_add_rr(&mut self.enc, PE_REG_R9, PE_REG_R14);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R10, PE_REG_R12, PE_REG_R9);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R10, PE_REG_R9);
    var mismatch: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 5, mismatch);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_jmp_label(&mut self.enc, inner_loop);
    X86Encoder_place_label(&mut self.enc, mismatch);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_jmp_label(&mut self.enc, outer_loop);
    X86Encoder_place_label(&mut self.enc, found);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jmp_label(&mut self.enc, done);
    X86Encoder_place_label(&mut self.enc, not_found);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RAX, -1);
    X86Encoder_jmp_label(&mut self.enc, done);
    X86Encoder_place_label(&mut self.enc, empty_needle);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_place_label(&mut self.enc, done);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_rfind(rcx=*u8 haystack, rdx=*u8 needle) -> rax = i64 (index or -1)
// Naive substring search from the end, returning the last occurrence index.
pub fn PeCodeGen_gen_string_rfind(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_rfind");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    // r12 = haystack, r13 = needle, r14 = current search position (from end)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);
    // Compute strlen(haystack) in R14, then search backward
    X86Encoder_xor_self(&mut self.enc, PE_REG_R14);
    var slen_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, slen_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_R12, PE_REG_R14);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var slen_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, slen_done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_jmp_label(&mut self.enc, slen_loop);
    X86Encoder_place_label(&mut self.enc, slen_done);
    // If needle is empty, return strlen(haystack)
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var empty_needle: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, empty_needle);
    // Start from strlen-1, search backward
    X86Encoder_dec_r(&mut self.enc, PE_REG_R14);
    var not_found: i64 = X86Encoder_alloc_label(&mut self.enc);
    var outer_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, outer_loop);
    // Check if r14 < 0
    X86Encoder_test_rr(&mut self.enc, PE_REG_R14, PE_REG_R14);
    X86Encoder_jcc_label(&mut self.enc, 8, not_found);
    // Compare haystack+r14 with needle
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    var inner_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, inner_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R9, PE_REG_R13, PE_REG_RAX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R9, PE_REG_R9);
    var found: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, found);
    X86Encoder_add_rr(&mut self.enc, PE_REG_R9, PE_REG_R14);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R10, PE_REG_R12, PE_REG_R9);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R10, PE_REG_R9);
    var mismatch: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 5, mismatch);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_jmp_label(&mut self.enc, inner_loop);
    X86Encoder_place_label(&mut self.enc, mismatch);
    X86Encoder_dec_r(&mut self.enc, PE_REG_R14);
    X86Encoder_jmp_label(&mut self.enc, outer_loop);
    X86Encoder_place_label(&mut self.enc, found);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jmp_label(&mut self.enc, done);
    X86Encoder_place_label(&mut self.enc, not_found);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RAX, -1);
    X86Encoder_jmp_label(&mut self.enc, done);
    X86Encoder_place_label(&mut self.enc, empty_needle);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    X86Encoder_place_label(&mut self.enc, done);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_repeat(rcx=*u8 str, rdx=i64 n) -> rax = *u8 (new repeated string)
// Allocates a new string with the input repeated n times.
pub fn PeCodeGen_gen_string_repeat(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_repeat");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_push(&mut self.enc, PE_REG_R15);
    // r12 = str, r13 = n (count), r14 = strlen, r15 = result
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);
    // Compute strlen(str) in R14
    X86Encoder_xor_self(&mut self.enc, PE_REG_R14);
    var slen_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, slen_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_R12, PE_REG_R14);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var slen_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, slen_done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_jmp_label(&mut self.enc, slen_loop);
    X86Encoder_place_label(&mut self.enc, slen_done);
    // Allocate strlen * n + 1
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    X86Encoder_imul_rr(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 1);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RAX);
    // Copy str n times
    X86Encoder_xor_self(&mut self.enc, PE_REG_R10);
    var rep_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, rep_loop);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R13, PE_REG_R13);
    X86Encoder_jcc_label(&mut self.enc, 4, done);
    // Copy str to result + offset
    X86Encoder_xor_self(&mut self.enc, PE_REG_R11);
    var copy_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, copy_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_R12, PE_REG_R11);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var copy_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, copy_done);
    X86Encoder_mov_mem_idx_reg8(&mut self.enc, PE_REG_R15, PE_REG_R10, PE_REG_RAX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R11);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R10);
    X86Encoder_jmp_label(&mut self.enc, copy_loop);
    X86Encoder_place_label(&mut self.enc, copy_done);
    X86Encoder_dec_r(&mut self.enc, PE_REG_R13);
    X86Encoder_jmp_label(&mut self.enc, rep_loop);
    X86Encoder_place_label(&mut self.enc, done);
    // Null-terminate
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_mem_idx_reg8(&mut self.enc, PE_REG_R15, PE_REG_R10, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_bytes -- same as strlen
pub fn PeCodeGen_gen_string_bytes(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_bytes");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    var loop_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, loop_label);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R9, PE_REG_R12, PE_REG_RAX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R9, PE_REG_R9);
    X86Encoder_jcc_label(&mut self.enc, 4, done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_jmp_label(&mut self.enc, loop_label);
    X86Encoder_place_label(&mut self.enc, done);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_clone -- copy string
pub fn PeCodeGen_gen_string_clone(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_clone");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R13);
    var len_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    var len_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, len_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_R9, PE_REG_R12, PE_REG_R13);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R9, PE_REG_R9);
    X86Encoder_jcc_label(&mut self.enc, 4, len_done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R13);
    X86Encoder_jmp_label(&mut self.enc, len_loop);
    X86Encoder_place_label(&mut self.enc, len_done);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R13);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RCX, 1);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R9, PE_REG_RAX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R10);
    var copy_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    var copy_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, copy_loop);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R10, PE_REG_R13);
    X86Encoder_jcc_label(&mut self.enc, 3, copy_done);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, PE_REG_RAX, PE_REG_R12, PE_REG_R10);
    X86Encoder_mov_mem_disp_reg8(&mut self.enc, PE_REG_R9, PE_REG_R10, PE_REG_RAX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R10);
    X86Encoder_jmp_label(&mut self.enc, copy_loop);
    X86Encoder_place_label(&mut self.enc, copy_done);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_mem_disp_reg8(&mut self.enc, PE_REG_R9, PE_REG_R13, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R9);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// --- Helper: check if type is float -------------------------------------
// Note: ir_type_is_float and ir_type_size are already defined in ir.fd

// --- Write PE bytes to file ---------------------------------------------
// Convert Vec<i64> of bytes to a string for p_file_write
pub fn pe_bytes_to_string(bytes: Vec) -> str {
    // We need to write raw bytes to a file, but p_file_write expects str
    // In Fides, str is a byte buffer, so we can use str_from_bytes
    return str_from_bytes(bytes);
}