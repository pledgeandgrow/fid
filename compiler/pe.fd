// T10: p_wrmsr_gs_base(rcx = value) — write GS base (MSR 0xC0000101)
pub fn PeCodeGen_gen_p_wrmsr_gs_base(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_wrmsr_gs_base");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // mov rax, rcx
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xC8);
        // mov rdx, rax
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xC2);
        // shr rdx, 32
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xEA); X86Encoder_emit_u8(&mut self.enc, 0x20);
        // mov ecx, 0xC0000101
        X86Encoder_emit_u8(&mut self.enc, 0xB9); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0xC0);
        // wrmsr
        X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x30);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// T10: p_rdmsr_gs_base() -> rax — read GS base (MSR 0xC0000101)
pub fn PeCodeGen_gen_p_rdmsr_gs_base(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_rdmsr_gs_base");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // mov ecx, 0xC0000101
        X86Encoder_emit_u8(&mut self.enc, 0xB9); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0xC0);
        // rdmsr
        X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x32);
        // shl rdx, 32
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE2); X86Encoder_emit_u8(&mut self.enc, 0x20);
        // or rax, rdx
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x09); X86Encoder_emit_u8(&mut self.enc, 0xD0);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// T10: p_wrmsr_kernel_gs_base(rcx = value) — write KernelGSBase (MSR 0xC0000102)
pub fn PeCodeGen_gen_p_wrmsr_kernel_gs_base(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_wrmsr_kernel_gs_base");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // mov rax, rcx
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xC8);
        // mov rdx, rax
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xC2);
        // shr rdx, 32
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xEA); X86Encoder_emit_u8(&mut self.enc, 0x20);
        // mov ecx, 0xC0000102
        X86Encoder_emit_u8(&mut self.enc, 0xB9); X86Encoder_emit_u8(&mut self.enc, 0x02); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0xC0);
        // wrmsr
        X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x30);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// T10: p_swapgs() — swap GS base and KernelGSBase
pub fn PeCodeGen_gen_p_swapgs(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_swapgs");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // swapgs
        X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0xF8);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}


// p_enter_user_mode(rcx = entry_addr, rdx = stack_addr) -> void
// Transitions from ring 0 (kernel) to ring 3 (user) via iretq.
// Switches CR3 to user page tables (0x72000) for isolation before iretq.
pub fn PeCodeGen_gen_p_enter_user_mode(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_enter_user_mode");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // rcx = entry_addr (RIP), rdx = stack_addr (RSP)
        // Save entry/stack in r11, r12 before CR3 switch
        // mov r11, rcx
        X86Encoder_emit_u8(&mut self.enc, 0x49); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xCB);
        // mov r12, rdx
        X86Encoder_emit_u8(&mut self.enc, 0x49); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xD4);

        // Switch CR3 to user page tables (0x72000)
        X86Encoder_emit_u8(&mut self.enc, 0xB8); X86Encoder_emit_u32(&mut self.enc, 0x72000);
        X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x22); X86Encoder_emit_u8(&mut self.enc, 0xD8);

        // Build iret frame on kernel stack
        // Push SS (user data = 0x23)
        X86Encoder_emit_u8(&mut self.enc, 0x6A); X86Encoder_emit_u8(&mut self.enc, 0x23);
        // Push RSP (user stack = r12)
        X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0x54); // push r12
        // Push RFLAGS = 0x202
        X86Encoder_emit_u8(&mut self.enc, 0x68); X86Encoder_emit_u32(&mut self.enc, 0x202);
        // Push CS (user code = 0x1B)
        X86Encoder_emit_u8(&mut self.enc, 0x6A); X86Encoder_emit_u8(&mut self.enc, 0x1B);
        // Push RIP (entry = r11)
        X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0x53); // push r11
        // iretq
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xCF);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    // No ret — iretq never returns here
}

// syscall_handler — int 0x80 from user mode
// Switches CR3 back to kernel page tables (0x70000) and returns to ring 0.
pub fn PeCodeGen_gen_syscall_handler(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "syscall_handler");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // Switch CR3 back to kernel page tables (0x70000)
        X86Encoder_emit_u8(&mut self.enc, 0xB8); X86Encoder_emit_u32(&mut self.enc, 0x70000);
        X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x22); X86Encoder_emit_u8(&mut self.enc, 0xD8);
        // Modify RIP → user_return (will be patched by boot trampoline)
        // For now, just halt — the full user_return trampoline is in the boot entry point
        // mov qword [rsp + 0], <user_return_addr> — placeholder
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x04); X86Encoder_emit_u8(&mut self.enc, 0x24);
        X86Encoder_emit_u32(&mut self.enc, 0); // placeholder
        // Modify CS → 0x08 (kernel code)
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x44); X86Encoder_emit_u8(&mut self.enc, 0x24); X86Encoder_emit_u8(&mut self.enc, 0x08); X86Encoder_emit_u16(&mut self.enc, 0x08);
        // Modify RSP → 0x90000 (kernel stack)
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x44); X86Encoder_emit_u8(&mut self.enc, 0x24); X86Encoder_emit_u8(&mut self.enc, 0x18); X86Encoder_emit_u32(&mut self.enc, 0x90000); X86Encoder_emit_u32(&mut self.enc, 0);
        // Modify SS → 0x10 (kernel data)
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x44); X86Encoder_emit_u8(&mut self.enc, 0x24); X86Encoder_emit_u8(&mut self.enc, 0x20); X86Encoder_emit_u16(&mut self.enc, 0x10);
        // iretq
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xCF);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    // No ret — iretq never returns here
}

// ===========================================================================
// Phase 5A.3: IDT stubs (ported from src/pe.rs)
// ===========================================================================

// p_lidt(rcx = ptr to IDT descriptor) — load IDT
pub fn PeCodeGen_gen_p_lidt(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_lidt");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // lidt [rcx]
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x19);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_idt_set_entry(rcx = idt_ptr, rdx = vector, r8 = handler_addr, r9 = flags)
// Writes a 16-byte IDT gate descriptor at idt_ptr + vector * 16.
pub fn PeCodeGen_gen_p_idt_set_entry(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_idt_set_entry");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // r10 = rdx << 4
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R10, PE_REG_RDX);
        X86Encoder_shl_r_i8(&mut self.enc, PE_REG_R10, 4);
        // r10 = r10 + rcx (idt_ptr + vector*16)
        X86Encoder_add_rr(&mut self.enc, PE_REG_R10, PE_REG_RCX);

        // offset_low = handler_addr & 0xFFFF → [r10 + 0]
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R8);
        // mov [r10], ax
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0x02);

        // selector = 0x08 → [r10 + 2]
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x02); X86Encoder_emit_u8(&mut self.enc, 0x08); X86Encoder_emit_u8(&mut self.enc, 0x00);

        // ist = 0 → [r10 + 4]
        X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0xC6); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x04); X86Encoder_emit_u8(&mut self.enc, 0x00);

        // type_attr = flags | 0x8E → [r10 + 5]
        // or r9b, 0x8E
        X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0x80); X86Encoder_emit_u8(&mut self.enc, 0xC9); X86Encoder_emit_u8(&mut self.enc, 0x8E);
        // mov [r10+5], r9b
        X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0x88); X86Encoder_emit_u8(&mut self.enc, 0x4A); X86Encoder_emit_u8(&mut self.enc, 0x05);

        // offset_mid = (handler_addr >> 16) & 0xFFFF → [r10 + 6]
        // shr rax, 16
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x10);
        // mov [r10+6], ax
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x06);

        // offset_high = (handler_addr >> 32) & 0xFFFFFFFF → [r10 + 8]
        // shr rax, 16 (rax now = handler_addr >> 32)
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x10);
        // mov [r10+8], eax
        X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x08);

        // reserved = 0 → [r10 + 12]
        X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x0C); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// ===========================================================================
// 32-bit port I/O stubs (ported from src/pe.rs)
// ===========================================================================

// p_outl(rcx = port, rdx = value) — write 32-bit dword to I/O port
pub fn PeCodeGen_gen_p_outl(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_outl");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // mov eax, edx (value to eax)
        X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xD0);
        // mov dx, cx (port to dx)
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xCA);
        // out dx, eax
        X86Encoder_emit_u8(&mut self.enc, 0xEF);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_inl(rcx = port) -> rax — read 32-bit dword from I/O port
pub fn PeCodeGen_gen_p_inl(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_inl");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // mov dx, cx (port to dx)
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xCA);
        // in eax, dx
        X86Encoder_emit_u8(&mut self.enc, 0xED);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// ===========================================================================
// Phase 5A.4: MMU/page table stubs (ported from src/pe.rs)
// ===========================================================================

