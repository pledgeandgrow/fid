// pe.fd — Direct PE executable emitter for Windows x86_64 .exe files
// Ported from src/pe.rs. Generates native machine code without tcc.
//
// Pipeline: IrModule → machine code bytes → PE file → .exe
//
// Windows x64 calling convention:
// - Integer args: RCX, RDX, R8, R9 (then stack)
// - Return: RAX
// - Shadow space: 32 bytes on stack for callee
// - Stack must be 16-byte aligned before CALL

module compiler::pe;

use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;

// ─── Register definitions ───────────────────────────────────────────────
// x86-64 GP registers encoded as i64 (0-15)
pub const REG_RAX: i64 = 0;
pub const REG_RCX: i64 = 1;
pub const REG_RDX: i64 = 2;
pub const REG_RBX: i64 = 3;
pub const REG_RSP: i64 = 4;
pub const REG_RBP: i64 = 5;
pub const REG_RSI: i64 = 6;
pub const REG_RDI: i64 = 7;
pub const REG_R8: i64 = 8;
pub const REG_R9: i64 = 9;
pub const REG_R10: i64 = 10;
pub const REG_R11: i64 = 11;
pub const REG_R12: i64 = 12;
pub const REG_R13: i64 = 13;
pub const REG_R14: i64 = 14;
pub const REG_R15: i64 = 15;

// Low 3 bits for ModR/M encoding
pub fn reg_code(r: i64) -> i64 {
    return r & 7;
}

// True if extended register (R8-R15, needs REX.B/R)
pub fn reg_is_extended(r: i64) -> bool {
    return r >= 8;
}

// ─── Relocation types ───────────────────────────────────────────────────
pub const RELOC_REL32: i64 = 0;    // relative jump/call
pub const RELOC_RIPREL32: i64 = 1; // RIP-relative data access
pub const RELOC_LEA_LABEL: i64 = 2; // lea to code label

pub struct PendingReloc {
    pub code_offset: i64,
    pub target_label: i64,
    pub kind: i64,
}

pub fn PendingReloc_new(code_offset: i64, target_label: i64, kind: i64) -> PendingReloc {
    return PendingReloc { code_offset: code_offset, target_label: target_label, kind: kind };
}

pub struct PendingRipRef {
    pub code_offset: i64,
    pub rdata_offset: i64,
}

pub fn PendingRipRef_new(code_offset: i64, rdata_offset: i64) -> PendingRipRef {
    return PendingRipRef { code_offset: code_offset, rdata_offset: rdata_offset };
}

// ─── X86Encoder: x86_64 machine code encoder ────────────────────────────
pub struct X86Encoder {
    pub code: Vec,              // Vec<i64> of bytes
    pub labels: Vec,            // Vec<i64> label_id -> code offset
    pub pending_labels: Vec<PendingReloc>,
    pub pending_rip_refs: Vec<PendingRipRef>,
    pub next_label: i64,
}

pub fn X86Encoder_new() -> X86Encoder {
    return X86Encoder {
        code: Vec::new(),
        labels: Vec::new(),
        pending_labels: Vec::new(),
        pending_rip_refs: Vec::new(),
        next_label: 0,
    };
}

// Allocate a new label ID
pub fn X86Encoder_alloc_label(self: &mut X86Encoder) -> i64 {
    var id: i64 = self.next_label;
    self.next_label = self.next_label + 1;
    // Extend labels vec to hold this id (store -1 = unplaced)
    while self.labels.len() <= id {
        self.labels.push(-1);
    }
    return id;
}

// Place a label at the current code offset
pub fn X86Encoder_place_label(self: &mut X86Encoder, label: i64) {
    while self.labels.len() <= label {
        self.labels.push(-1);
    }
    self.labels.set(label, self.code.len());
}

// Current code offset
pub fn X86Encoder_offset(self: &X86Encoder) -> i64 {
    return self.code.len();
}

// Emit a single byte
pub fn X86Encoder_emit_u8(self: &mut X86Encoder, b: i64) {
    self.code.push(b & 0xFF);
}

// Emit 16-bit little-endian
pub fn X86Encoder_emit_u16(self: &mut X86Encoder, w: i64) {
    self.code.push(w & 0xFF);
    self.code.push((w >> 8) & 0xFF);
}

// Emit 32-bit little-endian
pub fn X86Encoder_emit_u32(self: &mut X86Encoder, d: i64) {
    self.code.push(d & 0xFF);
    self.code.push((d >> 8) & 0xFF);
    self.code.push((d >> 16) & 0xFF);
    self.code.push((d >> 24) & 0xFF);
}

// Emit 32-bit signed little-endian
pub fn X86Encoder_emit_i32(self: &mut X86Encoder, d: i64) {
    X86Encoder_emit_u32(self, d);
}

// Emit 64-bit little-endian
pub fn X86Encoder_emit_u64(self: &mut X86Encoder, q: i64) {
    var i: i64 = 0;
    while i < 8 {
        self.code.push((q >> (i * 8)) & 0xFF);
        i = i + 1;
    }
}

// REX prefix: 0x40 | (W<<3) | (R<<2) | (X<<1) | B
pub fn X86Encoder_rex(self: &mut X86Encoder, w: bool, r: bool, x: bool, b: bool) {
    var prefix: i64 = 0x40;
    if w { prefix = prefix | 0x08; }
    if r { prefix = prefix | 0x04; }
    if x { prefix = prefix | 0x02; }
    if b { prefix = prefix | 0x01; }
    self.code.push(prefix);
}

// REX.W prefix (64-bit operand)
pub fn X86Encoder_rex_w(self: &mut X86Encoder) {
    X86Encoder_rex(self, true, false, false, false);
}

// ModR/M byte: (mod<<6) | (reg<<3) | rm
pub fn X86Encoder_modrm(self: &mut X86Encoder, mod_: i64, reg: i64, rm: i64) {
    self.code.push(((mod_ & 3) << 6) | ((reg & 7) << 3) | (rm & 7));
}

// ModR/M for reg-reg: mod=3
pub fn X86Encoder_modrm_rr(self: &mut X86Encoder, reg: i64, rm: i64) {
    X86Encoder_modrm(self, 3, reg_code(reg), reg_code(rm));
}

// push r64
pub fn X86Encoder_push(self: &mut X86Encoder, r: i64) {
    if reg_is_extended(r) {
        X86Encoder_rex(self, false, false, false, true);
    }
    self.code.push(0x50 | reg_code(r));
}

// pop r64
pub fn X86Encoder_pop(self: &mut X86Encoder, r: i64) {
    if reg_is_extended(r) {
        X86Encoder_rex(self, false, false, false, true);
    }
    self.code.push(0x58 | reg_code(r));
}

// ret
pub fn X86Encoder_ret(self: &mut X86Encoder) {
    self.code.push(0xC3);
}

// nop
pub fn X86Encoder_nop(self: &mut X86Encoder) {
    self.code.push(0x90);
}

// ud2
pub fn X86Encoder_ud2(self: &mut X86Encoder) {
    self.code.push(0x0F);
    self.code.push(0x0B);
}

// xor r64, r64 (zero a register)
pub fn X86Encoder_xor_self(self: &mut X86Encoder, r: i64) {
    X86Encoder_xor_rr(self, r, r);
}

// mov r64, imm64
pub fn X86Encoder_mov_imm64(self: &mut X86Encoder, r: i64, val: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xB8 | reg_code(r));
    X86Encoder_emit_u64(self, val);
}

// mov r64, imm32 (sign-extended)
pub fn X86Encoder_mov_imm32(self: &mut X86Encoder, r: i64, val: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xC7);
    X86Encoder_modrm(self, 3, 0, reg_code(r));
    X86Encoder_emit_i32(self, val);
}

// mov r64, r64
pub fn X86Encoder_mov_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(dst));
    self.code.push(0x89);
    X86Encoder_modrm_rr(self, src, dst);
}

// Emit RBP-relative memory operand: [rbp + disp]
// RBP (code=5) with mod=00 is RIP-relative, so always use mod=01 or mod=10
pub fn X86Encoder_emit_mem_rbp(self: &mut X86Encoder, reg_code_val: i64, disp: i64) {
    if disp == 0 {
        X86Encoder_modrm(self, 1, reg_code_val, 5);
        self.code.push(0);
    } else if disp >= -128 && disp <= 127 {
        X86Encoder_modrm(self, 1, reg_code_val, 5);
        self.code.push(disp & 0xFF);
    } else {
        X86Encoder_modrm(self, 2, reg_code_val, 5);
        X86Encoder_emit_i32(self, disp);
    }
}

// Emit [base + disp] memory operand
pub fn X86Encoder_emit_mem_reg(self: &mut X86Encoder, reg_code_val: i64, base: i64, disp: i64) {
    var base_code: i64 = reg_code(base);
    if base_code == 4 {
        // RSP/R12 needs SIB byte
        if disp == 0 {
            X86Encoder_modrm(self, 0, reg_code_val, 4);
            self.code.push(0x24);
        } else if disp >= -128 && disp <= 127 {
            X86Encoder_modrm(self, 1, reg_code_val, 4);
            self.code.push(0x24);
            self.code.push(disp & 0xFF);
        } else {
            X86Encoder_modrm(self, 2, reg_code_val, 4);
            self.code.push(0x24);
            X86Encoder_emit_i32(self, disp);
        }
    } else if base_code == 5 {
        // RBP/R13 needs mod=01 minimum
        if disp == 0 {
            X86Encoder_modrm(self, 1, reg_code_val, 5);
            self.code.push(0);
        } else if disp >= -128 && disp <= 127 {
            X86Encoder_modrm(self, 1, reg_code_val, 5);
            self.code.push(disp & 0xFF);
        } else {
            X86Encoder_modrm(self, 2, reg_code_val, 5);
            X86Encoder_emit_i32(self, disp);
        }
    } else {
        if disp == 0 {
            X86Encoder_modrm(self, 0, reg_code_val, base_code);
        } else if disp >= -128 && disp <= 127 {
            X86Encoder_modrm(self, 1, reg_code_val, base_code);
            self.code.push(disp & 0xFF);
        } else {
            X86Encoder_modrm(self, 2, reg_code_val, base_code);
            X86Encoder_emit_i32(self, disp);
        }
    }
}

// mov reg, [rbp + disp]
pub fn X86Encoder_mov_reg_mem_rbp(self: &mut X86Encoder, dst: i64, disp: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, false);
    self.code.push(0x8B);
    X86Encoder_emit_mem_rbp(self, reg_code(dst), disp);
}

// mov [rbp + disp], reg
pub fn X86Encoder_mov_mem_rbp_reg(self: &mut X86Encoder, disp: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, false);
    self.code.push(0x89);
    X86Encoder_emit_mem_rbp(self, reg_code(src), disp);
}

// lea reg, [rbp + disp]
pub fn X86Encoder_lea_rbp(self: &mut X86Encoder, dst: i64, disp: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, false);
    self.code.push(0x8D);
    X86Encoder_emit_mem_rbp(self, reg_code(dst), disp);
}

// lea reg, [rip + rdata_offset] — patched later
pub fn X86Encoder_lea_rip(self: &mut X86Encoder, dst: i64, rdata_offset: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, false);
    self.code.push(0x8D);
    X86Encoder_modrm(self, 0, reg_code(dst), 5);
    self.pending_rip_refs.push(PendingRipRef_new(self.code.len(), rdata_offset));
    X86Encoder_emit_i32(self, 0);
}

// lea reg, [rip + label] — patched later as code label
pub fn X86Encoder_lea_label(self: &mut X86Encoder, dst: i64, label: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, false);
    self.code.push(0x8D);
    X86Encoder_modrm(self, 0, reg_code(dst), 5);
    self.pending_labels.push(PendingReloc_new(self.code.len(), label, RELOC_LEA_LABEL));
    X86Encoder_emit_i32(self, 0);
}

// call [rip + rdata_offset] — IAT indirect call
pub fn X86Encoder_call_rip(self: &mut X86Encoder, rdata_offset: i64) {
    self.code.push(0xFF);
    X86Encoder_modrm(self, 0, 2, 5);
    self.pending_rip_refs.push(PendingRipRef_new(self.code.len(), rdata_offset));
    X86Encoder_emit_i32(self, 0);
}

// call rel32 (label)
pub fn X86Encoder_call_label(self: &mut X86Encoder, label: i64) {
    self.code.push(0xE8);
    self.pending_labels.push(PendingReloc_new(self.code.len(), label, RELOC_REL32));
    X86Encoder_emit_i32(self, 0);
}

// jmp rel32 (label)
pub fn X86Encoder_jmp_label(self: &mut X86Encoder, label: i64) {
    self.code.push(0xE9);
    self.pending_labels.push(PendingReloc_new(self.code.len(), label, RELOC_REL32));
    X86Encoder_emit_i32(self, 0);
}

// jcc rel32 (label) — cc is condition code (0-15)
pub fn X86Encoder_jcc_label(self: &mut X86Encoder, cc: i64, label: i64) {
    self.code.push(0x0F);
    self.code.push(0x80 | (cc & 0xF));
    self.pending_labels.push(PendingReloc_new(self.code.len(), label, RELOC_REL32));
    X86Encoder_emit_i32(self, 0);
}

// call r64 (indirect)
pub fn X86Encoder_call_reg(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, false, false, false, reg_is_extended(r));
    self.code.push(0xFF);
    X86Encoder_modrm(self, 3, 2, reg_code(r));
}

// add r64, r64
pub fn X86Encoder_add_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(dst));
    self.code.push(0x01);
    X86Encoder_modrm_rr(self, src, dst);
}

// sub r64, r64
pub fn X86Encoder_sub_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(dst));
    self.code.push(0x29);
    X86Encoder_modrm_rr(self, src, dst);
}

// imul r64, r64
pub fn X86Encoder_imul_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x0F);
    self.code.push(0xAF);
    X86Encoder_modrm_rr(self, dst, src);
}

// idiv r64
pub fn X86Encoder_idiv_r(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xF7);
    X86Encoder_modrm(self, 3, 7, reg_code(r));
}

// div r64 (unsigned divide rdx:rax by r, rax=quotient, rdx=remainder)
pub fn X86Encoder_div_r(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xF7);
    X86Encoder_modrm(self, 3, 6, reg_code(r));
}

// and r64, r64
pub fn X86Encoder_and_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(dst));
    self.code.push(0x21);
    X86Encoder_modrm_rr(self, src, dst);
}

// or r64, r64
pub fn X86Encoder_or_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(dst));
    self.code.push(0x09);
    X86Encoder_modrm_rr(self, src, dst);
}

// xor r64, r64
pub fn X86Encoder_xor_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(dst));
    self.code.push(0x31);
    X86Encoder_modrm_rr(self, src, dst);
}

// not r64
pub fn X86Encoder_not_r(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xF7);
    X86Encoder_modrm(self, 3, 2, reg_code(r));
}

// neg r64
pub fn X86Encoder_neg_r(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xF7);
    X86Encoder_modrm(self, 3, 3, reg_code(r));
}

// cmp r64, r64
pub fn X86Encoder_cmp_rr(self: &mut X86Encoder, left: i64, right: i64) {
    X86Encoder_rex(self, true, reg_is_extended(right), false, reg_is_extended(left));
    self.code.push(0x3B);
    X86Encoder_modrm_rr(self, right, left);
}

// test r64, r64
pub fn X86Encoder_test_rr(self: &mut X86Encoder, left: i64, right: i64) {
    X86Encoder_rex(self, true, reg_is_extended(right), false, reg_is_extended(left));
    self.code.push(0x85);
    X86Encoder_modrm_rr(self, right, left);
}

// shl r64, cl
pub fn X86Encoder_shl_cl(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xD3);
    X86Encoder_modrm(self, 3, 4, reg_code(r));
}

// shl r64, imm8
pub fn X86Encoder_shl_r_i8(self: &mut X86Encoder, r: i64, count: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xC1);
    X86Encoder_modrm(self, 3, 4, reg_code(r));
    self.code.push(count & 0xFF);
}

// sar r64, cl
pub fn X86Encoder_sar_cl(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xD3);
    X86Encoder_modrm(self, 3, 7, reg_code(r));
}

// cqo (sign-extend RAX into RDX:RAX)
pub fn X86Encoder_cqo(self: &mut X86Encoder) {
    X86Encoder_rex_w(self);
    self.code.push(0x99);
}

// setcc r8
pub fn X86Encoder_setcc_r(self: &mut X86Encoder, cc: i64, r: i64) {
    X86Encoder_rex(self, false, false, false, reg_is_extended(r));
    self.code.push(0x0F);
    self.code.push(0x90 | (cc & 0xF));
    X86Encoder_modrm(self, 3, 0, reg_code(r));
}

// movzx r32, r8 (zero-extend byte to 32-bit)
pub fn X86Encoder_movzx_r32_r8(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, false, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x0F);
    self.code.push(0xB6);
    X86Encoder_modrm_rr(self, dst, src);
}

// movzx r32, r16 (zero-extend word to 32-bit)
pub fn X86Encoder_movzx_r32_r16(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, false, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x0F);
    self.code.push(0xB7);
    X86Encoder_modrm_rr(self, dst, src);
}

// movsxd r64, r32 (sign-extend 32 to 64)
pub fn X86Encoder_movsxd_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x63);
    X86Encoder_modrm_rr(self, dst, src);
}

// movsx r64, r8 (sign-extend byte to 64)
pub fn X86Encoder_movsx_r64_r8(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x0F);
    self.code.push(0xBE);
    X86Encoder_modrm_rr(self, dst, src);
}

// movsx r64, r16 (sign-extend word to 64)
pub fn X86Encoder_movsx_r64_r16(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x0F);
    self.code.push(0xBF);
    X86Encoder_modrm_rr(self, dst, src);
}

// inc r64
pub fn X86Encoder_inc_r(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xFF);
    X86Encoder_modrm(self, 3, 0, reg_code(r));
}

// dec r64
pub fn X86Encoder_dec_r(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xFF);
    X86Encoder_modrm(self, 3, 1, reg_code(r));
}

// sub rsp, imm8
pub fn X86Encoder_sub_rsp_i8(self: &mut X86Encoder, val: i64) {
    X86Encoder_rex_w(self);
    self.code.push(0x83);
    X86Encoder_modrm(self, 3, 5, 4);
    self.code.push(val & 0xFF);
}

// sub rsp, imm32
pub fn X86Encoder_sub_rsp_i32(self: &mut X86Encoder, val: i64) {
    X86Encoder_rex_w(self);
    self.code.push(0x81);
    X86Encoder_modrm(self, 3, 5, 4);
    X86Encoder_emit_i32(self, val);
}

// add rsp, imm8
pub fn X86Encoder_add_rsp_i8(self: &mut X86Encoder, val: i64) {
    X86Encoder_rex_w(self);
    self.code.push(0x83);
    X86Encoder_modrm(self, 3, 0, 4);
    self.code.push(val & 0xFF);
}

// add rsp, imm32
pub fn X86Encoder_add_rsp_i32(self: &mut X86Encoder, val: i64) {
    X86Encoder_rex_w(self);
    self.code.push(0x81);
    X86Encoder_modrm(self, 3, 0, 4);
    X86Encoder_emit_i32(self, val);
}

// add r64, imm32
pub fn X86Encoder_add_r_i32(self: &mut X86Encoder, r: i64, val: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0x81);
    X86Encoder_modrm(self, 3, 0, reg_code(r));
    X86Encoder_emit_i32(self, val);
}

// add r64, imm8
pub fn X86Encoder_add_r_i8(self: &mut X86Encoder, r: i64, val: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0x83);
    X86Encoder_modrm(self, 3, 0, reg_code(r));
    self.code.push(val & 0xFF);
}

// imul r64, r64, imm32
pub fn X86Encoder_imul_r_r_imm32(self: &mut X86Encoder, dst: i64, src: i64, val: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x69);
    X86Encoder_modrm_rr(self, dst, src);
    X86Encoder_emit_i32(self, val);
}

// mov r8, imm8
pub fn X86Encoder_mov_r8_imm(self: &mut X86Encoder, r: i64, val: i64) {
    if reg_is_extended(r) {
        X86Encoder_rex(self, false, false, false, true);
    }
    self.code.push(0xB0 | reg_code(r));
    self.code.push(val & 0xFF);
}

// mov r64, [base]
pub fn X86Encoder_mov_reg_ptr(self: &mut X86Encoder, dst: i64, base: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(base));
    self.code.push(0x8B);
    X86Encoder_emit_mem_reg(self, reg_code(dst), base, 0);
}

// mov [base], r64
pub fn X86Encoder_mov_ptr_reg(self: &mut X86Encoder, base: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(base));
    self.code.push(0x89);
    X86Encoder_emit_mem_reg(self, reg_code(src), base, 0);
}

// mov [base], r32 (no REX.W)
pub fn X86Encoder_mov_ptr_reg32(self: &mut X86Encoder, base: i64, src: i64) {
    var need_rex: bool = reg_is_extended(base) || reg_is_extended(src);
    if need_rex {
        X86Encoder_rex(self, false, reg_is_extended(src), false, reg_is_extended(base));
    }
    self.code.push(0x89);
    X86Encoder_emit_mem_reg(self, reg_code(src), base, 0);
}

// mov r64, [base + disp]
pub fn X86Encoder_mov_reg_mem_disp(self: &mut X86Encoder, dst: i64, base: i64, disp: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(base));
    self.code.push(0x8B);
    X86Encoder_emit_mem_reg(self, reg_code(dst), base, disp);
}

// mov [base + disp], r64
pub fn X86Encoder_mov_mem_disp_reg(self: &mut X86Encoder, base: i64, disp: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(base));
    self.code.push(0x89);
    X86Encoder_emit_mem_reg(self, reg_code(src), base, disp);
}

// mov [base + disp], r32 (no REX.W)
pub fn X86Encoder_mov_mem_disp_reg32(self: &mut X86Encoder, base: i64, disp: i64, src: i64) {
    var need_rex: bool = reg_is_extended(base) || reg_is_extended(src);
    if need_rex {
        X86Encoder_rex(self, false, reg_is_extended(src), false, reg_is_extended(base));
    }
    self.code.push(0x89);
    X86Encoder_emit_mem_reg(self, reg_code(src), base, disp);
}

// mov r64, [base + index*1]
pub fn X86Encoder_mov_reg_mem_idx(self: &mut X86Encoder, dst: i64, base: i64, index: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), reg_is_extended(index), reg_is_extended(base));
    self.code.push(0x8B);
    // SIB: scale=0, index, base
    X86Encoder_modrm(self, 0, reg_code(dst), 4);
    self.code.push((reg_code(index) << 3) | reg_code(base));
}

// mov [base + index*1], r64
pub fn X86Encoder_mov_mem_idx_reg(self: &mut X86Encoder, base: i64, index: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), reg_is_extended(index), reg_is_extended(base));
    self.code.push(0x89);
    X86Encoder_modrm(self, 0, reg_code(src), 4);
    self.code.push((reg_code(index) << 3) | reg_code(base));
}

// mov r8, [base]
pub fn X86Encoder_mov_reg8_ptr(self: &mut X86Encoder, dst: i64, base: i64) {
    X86Encoder_rex(self, false, reg_is_extended(dst), false, reg_is_extended(base));
    self.code.push(0x8A);
    X86Encoder_emit_mem_reg(self, reg_code(dst), base, 0);
}

// mov [base], r8
pub fn X86Encoder_mov_mem_reg8_ptr(self: &mut X86Encoder, base: i64, src: i64) {
    X86Encoder_rex(self, false, reg_is_extended(src), false, reg_is_extended(base));
    self.code.push(0x88);
    X86Encoder_emit_mem_reg(self, reg_code(src), base, 0);
}

// mov [base + disp], r8
pub fn X86Encoder_mov_mem_disp_reg8(self: &mut X86Encoder, base: i64, disp: i64, src: i64) {
    X86Encoder_rex(self, false, reg_is_extended(src), false, reg_is_extended(base));
    self.code.push(0x88);
    X86Encoder_emit_mem_reg(self, reg_code(src), base, disp);
}

// mov [base + index*1], r8
pub fn X86Encoder_mov_mem_idx_reg8(self: &mut X86Encoder, base: i64, index: i64, src: i64) {
    X86Encoder_rex(self, false, reg_is_extended(src), reg_is_extended(index), reg_is_extended(base));
    self.code.push(0x88);
    X86Encoder_modrm(self, 0, reg_code(src), 4);
    self.code.push((reg_code(index) << 3) | reg_code(base));
}

// mov r8, [base + index*1]
pub fn X86Encoder_mov_reg8_mem_idx(self: &mut X86Encoder, dst: i64, base: i64, index: i64) {
    X86Encoder_rex(self, false, reg_is_extended(dst), reg_is_extended(index), reg_is_extended(base));
    self.code.push(0x8A);
    X86Encoder_modrm(self, 0, reg_code(dst), 4);
    self.code.push((reg_code(index) << 3) | reg_code(base));
}

// cmp r8, imm8
pub fn X86Encoder_cmp_r8_i8(self: &mut X86Encoder, r: i64, val: i64) {
    X86Encoder_rex(self, false, false, false, reg_is_extended(r));
    self.code.push(0x80);
    X86Encoder_modrm(self, 3, 7, reg_code(r));
    self.code.push(val & 0xFF);
}

// mov r32, [base] (no REX.W)
pub fn X86Encoder_mov_reg32_ptr(self: &mut X86Encoder, dst: i64, base: i64) {
    var need_rex: bool = reg_is_extended(base) || reg_is_extended(dst);
    if need_rex {
        X86Encoder_rex(self, false, reg_is_extended(dst), false, reg_is_extended(base));
    }
    self.code.push(0x8B);
    X86Encoder_emit_mem_reg(self, reg_code(dst), base, 0);
}

// ─── SSE2 float instructions ────────────────────────────────────────────
// movsd xmm, [rbp + disp]
pub fn X86Encoder_movsd_xmm_mem_rbp(self: &mut X86Encoder, xmm: i64, disp: i64) {
    self.code.push(0xF2);
    X86Encoder_rex_w(self);
    self.code.push(0x0F);
    self.code.push(0x10);
    X86Encoder_emit_mem_rbp(self, xmm & 7, disp);
}

// movsd [rbp + disp], xmm
pub fn X86Encoder_movsd_mem_rbp_xmm(self: &mut X86Encoder, disp: i64, xmm: i64) {
    self.code.push(0xF2);
    X86Encoder_rex_w(self);
    self.code.push(0x0F);
    self.code.push(0x11);
    X86Encoder_emit_mem_rbp(self, xmm & 7, disp);
}

// addsd xmm, xmm
pub fn X86Encoder_addsd(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0xF2);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x58);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// subsd xmm, xmm
pub fn X86Encoder_subsd(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0xF2);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x5C);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// mulsd xmm, xmm
pub fn X86Encoder_mulsd(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0xF2);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x59);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// divsd xmm, xmm
pub fn X86Encoder_divsd(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0xF2);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x5E);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// xorpd xmm, [rbp + disp]
pub fn X86Encoder_xorpd_xmm_mem_rbp(self: &mut X86Encoder, xmm: i64, disp: i64) {
    self.code.push(0x66);
    X86Encoder_rex_w(self);
    self.code.push(0x0F);
    self.code.push(0x57);
    X86Encoder_emit_mem_rbp(self, xmm & 7, disp);
}

// xorpd xmm, xmm
pub fn X86Encoder_xorpd_xmm_xmm(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0x66);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x57);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// movq xmm, r64 (movd with REX.W)
pub fn X86Encoder_movq_xmm_r64(self: &mut X86Encoder, xmm: i64, r: i64) {
    self.code.push(0x66);
    X86Encoder_rex(self, true, xmm >= 8, false, reg_is_extended(r));
    self.code.push(0x0F);
    self.code.push(0x6E);
    X86Encoder_modrm(self, 3, xmm & 7, reg_code(r));
}

// ucomisd xmm, xmm
pub fn X86Encoder_ucomisd(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0x66);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x2E);
