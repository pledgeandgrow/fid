}

// p_map_insert(rcx=*Map, rdx=*u8 key, r8=i64 value)
pub fn PeCodeGen_gen_map_insert(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_map_insert");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_sub_rsp_i32(&mut self.enc, 40);

    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R14, PE_REG_R8);

    // Search for existing key
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R8, PE_REG_RAX); // len
    X86Encoder_xor_self(&mut self.enc, PE_REG_R9); // index

    var mi_search: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, mi_search);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R9, PE_REG_R8);
    var mi_notfound: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 3, mi_notfound);

    // entry = ptr + r9*16
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R9);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 4);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX); // entry.key

    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_R13);
    var mi_cmp: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, mi_cmp);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R10);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R11);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_R10, PE_REG_RCX);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_R11, PE_REG_RDX);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R10, PE_REG_R11);
    var mi_mismatch: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 5, mi_mismatch);
    X86Encoder_test_rr(&mut self.enc, PE_REG_R10, PE_REG_R10);
    var mi_match: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, mi_match);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RCX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RDX);
    X86Encoder_jmp_label(&mut self.enc, mi_cmp);

    X86Encoder_place_label(&mut self.enc, mi_match);
    // Update value
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R9);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 4);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    var mi_ret: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jmp_label(&mut self.enc, mi_ret);

    X86Encoder_place_label(&mut self.enc, mi_mismatch);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R9);
    X86Encoder_jmp_label(&mut self.enc, mi_search);

    X86Encoder_place_label(&mut self.enc, mi_notfound);
    // Check capacity
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 16);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R10, PE_REG_RAX); // cap

    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R8, PE_REG_R10);
    var mi_grow: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 2, mi_grow); // jb

    // Grow
    X86Encoder_test_rr(&mut self.enc, PE_REG_R10, PE_REG_R10);
    var mi_newcap: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 5, mi_newcap);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_R10, 4);
    var mi_grow2: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jmp_label(&mut self.enc, mi_grow2);
    X86Encoder_place_label(&mut self.enc, mi_newcap);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_R10, 1);

    X86Encoder_place_label(&mut self.enc, mi_grow2);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -16, PE_REG_R10);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -24, PE_REG_R8);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R10);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 4);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R11, PE_REG_RAX);
    X86Encoder_mov_reg_mem_rbp(&mut self.enc, PE_REG_R8, -24);

    // Copy old entries
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RCX);
    var mi_copy: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, mi_copy);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_RCX, PE_REG_R8);
    var mi_copydone: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 3, mi_copydone);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_RCX);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RDX, 4);
    // key
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R9, PE_REG_RAX);
    X86Encoder_add_rr(&mut self.enc, PE_REG_R9, PE_REG_RDX);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R9, PE_REG_R9);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R10, PE_REG_R11);
    X86Encoder_add_rr(&mut self.enc, PE_REG_R10, PE_REG_RDX);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_R10, PE_REG_R9);
    // value
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R9, PE_REG_RAX);
    X86Encoder_add_rr(&mut self.enc, PE_REG_R9, PE_REG_RDX);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_R9, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R9, PE_REG_R9);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R10, PE_REG_R11);
    X86Encoder_add_rr(&mut self.enc, PE_REG_R10, PE_REG_RDX);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_R10, 8);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_R10, PE_REG_R9);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RCX);
    X86Encoder_jmp_label(&mut self.enc, mi_copy);
    X86Encoder_place_label(&mut self.enc, mi_copydone);

    // Update ptr first: r11 does not survive the call to p_free
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_R12, PE_REG_R11);

    // Free old
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var mi_nofree: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, mi_nofree);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_free"));
    X86Encoder_place_label(&mut self.enc, mi_nofree);

    // Update cap
    X86Encoder_mov_reg_mem_rbp(&mut self.enc, PE_REG_R10, -16);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 16);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_R10);

    X86Encoder_place_label(&mut self.enc, mi_grow);
    // Add entry at index len
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R8, PE_REG_RAX);

    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R8);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 4);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R8);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_R8);

    X86Encoder_place_label(&mut self.enc, mi_ret);
    X86Encoder_add_rsp_i32(&mut self.enc, 40);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_map_remove(rcx=*Map, rdx=*u8 key) -- removes key (shift remaining entries left)
pub fn PeCodeGen_gen_map_remove(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_map_remove");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);

    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX); // map
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX); // key

    // r8 = len = [r12 + 8]
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R8, PE_REG_RAX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R9); // index = 0

    var mr_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, mr_loop);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R9, PE_REG_R8);
    var mr_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 3, mr_done); // jae -- done

    // Get entry key: ptr = [r12], entry = ptr + r9*16, key = [entry]
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R9);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 4);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX); // rcx = entry key ptr

    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_R13); // rdx = search key
    var mr_cmp: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, mr_cmp);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R10);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R11);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_R10, PE_REG_RCX);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_R11, PE_REG_RDX);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R10, PE_REG_R11);
    var mr_mismatch: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 5, mr_mismatch); // jne
    X86Encoder_test_rr(&mut self.enc, PE_REG_R10, PE_REG_R10);
    var mr_found: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, mr_found); // jz -- null terminator, match
    X86Encoder_inc_r(&mut self.enc, PE_REG_RCX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RDX);
    X86Encoder_jmp_label(&mut self.enc, mr_cmp);

    X86Encoder_place_label(&mut self.enc, mr_found);
    // Shift remaining entries left by 1
    // r10 = i = found index, r8 = len
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R10, PE_REG_R9); // i = found index
    var mr_shift: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, mr_shift);
    // if i >= len-1, done shifting
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R8);
    X86Encoder_dec_r(&mut self.enc, PE_REG_RAX);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R10, PE_REG_RAX);
    var mr_shift_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 3, mr_shift_done); // jae -- done

    // Copy entry[i+1] to entry[i]
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R10);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 4);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX); // rax = &entry[i]
    // entry[i+1] key
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_RAX);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RDX, 16);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RDX, PE_REG_RDX);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_RDX);
    // entry[i+1] value
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_RAX);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RDX, 24); // entry[i].value + 16 = entry[i+1].value
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RDX, PE_REG_RDX);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_RDX);

    X86Encoder_inc_r(&mut self.enc, PE_REG_R10);
    X86Encoder_jmp_label(&mut self.enc, mr_shift);
    X86Encoder_place_label(&mut self.enc, mr_shift_done);

    // len--
    X86Encoder_dec_r(&mut self.enc, PE_REG_R8);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_R8);
    X86Encoder_jmp_label(&mut self.enc, mr_done);

    X86Encoder_place_label(&mut self.enc, mr_mismatch);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R9);
    X86Encoder_jmp_label(&mut self.enc, mr_loop);

    X86Encoder_place_label(&mut self.enc, mr_done);
    X86Encoder_add_rsp_i32(&mut self.enc, 32);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_print_float(xmm0 = double) -- prints float + newline
// Simplified: converts to int part + fractional part with 6 decimal places
pub fn PeCodeGen_gen_print_float(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_print_float");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_sub_rsp_i32(&mut self.enc, 264);

    // Store double bits at [rbp-8]
    X86Encoder_movq_xmm_r64(&mut self.enc, 0, PE_REG_RCX);
    X86Encoder_movsd_mem_rbp_xmm(&mut self.enc, -8, 0);

    // Convert to string via p_to_str_float
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    // Actually, we need the double in xmm0 for p_to_str_float
    X86Encoder_movsd_xmm_mem_rbp(&mut self.enc, 0, -8);
    // p_to_str_float takes double in xmm0, returns string in rax
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_to_str_float"));
    // rax = string. Print it via p_print_str
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_print_str"));

    X86Encoder_add_rsp_i32(&mut self.enc, 264);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_to_str_float(xmm0 = double) -> rax = *u8 string
// Simplified: prints integer part + "." + 6 fractional digits
pub fn PeCodeGen_gen_to_str_float(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_to_str_float");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_sub_rsp_i32(&mut self.enc, 264);

    // Store double at [rbp-8]
    X86Encoder_movsd_mem_rbp_xmm(&mut self.enc, -8, 0);

    // Check sign: AND with sign mask
    X86Encoder_mov_reg_mem_rbp(&mut self.enc, PE_REG_RAX, -8);
    X86Encoder_mov_imm64(&mut self.enc, PE_REG_RDX, 0x8000000000000000);
    X86Encoder_and_rr(&mut self.enc, PE_REG_RAX, PE_REG_RDX);
    var tf_positive: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, tf_positive);

    // Negative: negate and prepend "-"
    // Flip sign bit
    X86Encoder_mov_reg_mem_rbp(&mut self.enc, PE_REG_RAX, -8);
    X86Encoder_mov_imm64(&mut self.enc, PE_REG_RDX, 0x8000000000000000);
    X86Encoder_xor_rr(&mut self.enc, PE_REG_RAX, PE_REG_RDX);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -8, PE_REG_RAX);
    // Result = "-"
    var minus_off: i64 = PeCodeGen_get_string_offset(self, "-");
    X86Encoder_lea_rip(&mut self.enc, PE_REG_R12, minus_off);
    var tf_after_sign: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jmp_label(&mut self.enc, tf_after_sign);

    X86Encoder_place_label(&mut self.enc, tf_positive);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R12); // r12 = 0 (no sign prefix)

    X86Encoder_place_label(&mut self.enc, tf_after_sign);

    // Extract integer part: cvttsd2si rax, xmm0
    X86Encoder_movsd_xmm_mem_rbp(&mut self.enc, 0, -8);
    X86Encoder_cvttsd2si_r64(&mut self.enc, PE_REG_RAX, 0);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    // Call p_to_str(int_part) -> rax = string
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_to_str"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RAX); // r13 = int string

    // If we had a sign, prepend it
    X86Encoder_test_rr(&mut self.enc, PE_REG_R12, PE_REG_R12);
    var tf_no_sign_prefix: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, tf_no_sign_prefix);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_R13);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_str_concat"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RAX);

    X86Encoder_place_label(&mut self.enc, tf_no_sign_prefix);

    // Append "."
    var dot_off: i64 = PeCodeGen_get_string_offset(self, ".");
    X86Encoder_lea_rip(&mut self.enc, PE_REG_RAX, dot_off);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R13);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_RAX);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_str_concat"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RAX);

    // Compute fractional part: frac = value - (double)int_part
    // xmm0 = value, xmm1 = (double)int_part
    X86Encoder_movsd_xmm_mem_rbp(&mut self.enc, 0, -8);
    X86Encoder_mov_reg_mem_rbp(&mut self.enc, PE_REG_RAX, -8); // reload int part... no, we need the int part
    // Actually we need to re-extract int part. Let's recompute.
    X86Encoder_cvttsd2si_r64(&mut self.enc, PE_REG_RAX, 0); // rax = int part
    X86Encoder_cvtsi2sd_r64(&mut self.enc, 1, PE_REG_RAX); // xmm1 = (double)int
    X86Encoder_subsd(&mut self.enc, 0, 1); // xmm0 = frac

    // Multiply frac by 1000000 and convert to int
    // Load 1000000.0 into xmm1
    X86Encoder_mov_imm64(&mut self.enc, PE_REG_RAX, 0x4197D78400000000); // 1000000.0
    X86Encoder_movq_xmm_r64(&mut self.enc, 1, PE_REG_RAX);
    X86Encoder_mulsd(&mut self.enc, 0, 1);
    X86Encoder_cvttsd2si_r64(&mut self.enc, PE_REG_RAX, 0);
    // rax = fractional digits as int (0-999999)
    // Save frac int in r14
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R14, PE_REG_RAX);

    // Build 6-digit zero-padded string on stack at [rbp-48..rbp-42]
    // Write digits backwards from [rbp-42] (position 5) down to [rbp-48] (position 0)
    // r14 = remaining value, r8 = digit position (5 down to 0)
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_R8, 6); // count = 6
    var tf_frac_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, tf_frac_loop);
    X86Encoder_dec_r(&mut self.enc, PE_REG_R8); // position from 5 down to 0
    // digit = r14 % 10
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R14);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RDX);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 10);
    X86Encoder_div_r(&mut self.enc, PE_REG_RCX); // rax = quotient, rdx = remainder
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R14, PE_REG_RAX); // r14 = quotient
    // Store digit char at [rbp-48 + r8]
    X86Encoder_add_r_i8(&mut self.enc, PE_REG_RDX, 48); // '0'
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_R9, -48);
    X86Encoder_mov_mem_idx_reg8(&mut self.enc, PE_REG_R9, PE_REG_R8, PE_REG_RDX);
    // Continue if r8 > 0
    X86Encoder_test_rr(&mut self.enc, PE_REG_R8, PE_REG_R8);
    X86Encoder_jcc_label(&mut self.enc, 5, tf_frac_loop); // jnz

    // Null-terminate at [rbp-42]
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -42, PE_REG_RAX);

    // Append the 6-digit fractional string to result
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R13);
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_RDX, -48);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_str_concat"));

    X86Encoder_add_rsp_i32(&mut self.enc, 264);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_to_str_vec(rcx=*Vec) -> rax = string like "[1, 2, 3]"
// Iterates elements, converts each to string, joins with ", "
pub fn PeCodeGen_gen_to_str_vec(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_to_str_vec");
    X86Encoder_place_label(&mut self.enc, lbl);
    // Prologue: push rbp + 4 callee-saved = 5 pushes = 40 bytes
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12); // vec ptr
    X86Encoder_push(&mut self.enc, PE_REG_R13); // element index
    X86Encoder_push(&mut self.enc, PE_REG_R14); // len
    X86Encoder_push(&mut self.enc, PE_REG_R15); // result string
    X86Encoder_sub_rsp_i32(&mut self.enc, 40); // 32 shadow + 8 align

    // r12 = vec ptr
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);

    // Start with "[" -- malloc 2 bytes, store '[', '\0'
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 2);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RAX); // r15 = result
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RCX, 91); // '['
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_R15, PE_REG_RCX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RCX, 0);
    X86Encoder_mov_mem_disp_reg8(&mut self.enc, PE_REG_R15, 1, PE_REG_RCX);

    // r13 = 0 (index), r14 = len = [r12 + 8]
    X86Encoder_xor_self(&mut self.enc, PE_REG_R13);
    X86Encoder_mov_reg_mem_disp(&mut self.enc, PE_REG_R14, PE_REG_R12, 8);

    // Loop: for each element
    var tv_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, tv_loop);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R13, PE_REG_R14);
    var tv_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 3, tv_done); // jae -- done

    // If index > 0, append ", "
    X86Encoder_test_rr(&mut self.enc, PE_REG_R13, PE_REG_R13);
    var tv_first: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, tv_first); // jz -- first element, skip comma
    // Build ", \0" on stack at [rbp-16]
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 44); // ','
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -16, PE_REG_RAX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 32); // ' '
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -15, PE_REG_RAX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 0);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -14, PE_REG_RAX);
    // r15 = p_str_concat(r15, &[rbp-16])
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R15);
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_RDX, -16);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_str_concat"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RAX);
    X86Encoder_place_label(&mut self.enc, tv_first);

    // Get element: buf = [r12], element = buf[r13*8]
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12); // rax = buf ptr
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R13);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 3);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX); // rcx = element value (i64)

    // Call p_to_str(element) -> rax = string
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_to_str"));

    // Append to result: r15 = p_str_concat(r15, rax)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R15);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_RAX);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_str_concat"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RAX);

    // inc r13, loop
    X86Encoder_inc_r(&mut self.enc, PE_REG_R13);
    X86Encoder_jmp_label(&mut self.enc, tv_loop);

    X86Encoder_place_label(&mut self.enc, tv_done);
    // Append "]" -- build "]\0" on stack at [rbp-16]
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 93); // ']'
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -16, PE_REG_RAX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 0);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -15, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R15);
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_RDX, -16);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_str_concat"));
    // rax = result

    // Epilogue
    X86Encoder_add_rsp_i32(&mut self.enc, 40);
    X86Encoder_pop(&mut self.enc, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_print_vec(rcx=*Vec) -- prints [1, 2, 3] with newline
pub fn PeCodeGen_gen_print_vec(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_print_vec");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_sub_rsp_i32(&mut self.enc, 56);

    // r12 = vec ptr, r13 = len, r14 = index
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);

    // Print '['
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 91); // '['
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -40, PE_REG_RAX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 0);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -39, PE_REG_RAX);
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_RCX, -40);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_print_str"));
    X86Encoder_add_rsp_i32(&mut self.enc, 32);

    // r13 = len = [r12 + 8]
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R13, PE_REG_RAX);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R14); // index = 0

    var pv_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, pv_loop);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R14, PE_REG_R13);
    var pv_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 3, pv_done); // jae -- done

    // if index > 0, print ", "
    X86Encoder_test_rr(&mut self.enc, PE_REG_R14, PE_REG_R14);
    var pv_nosep: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, pv_nosep); // jz -- first element, no separator
    // Print ", "
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 44); // ','
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -40, PE_REG_RAX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 32); // ' '
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -39, PE_REG_RAX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 0);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -38, PE_REG_RAX);
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_RCX, -40);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_print_str"));
    X86Encoder_add_rsp_i32(&mut self.enc, 32);
    X86Encoder_place_label(&mut self.enc, pv_nosep);

    // Get element: ptr[index]
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12); // rax = data ptr
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R14);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 3);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RAX); // rax = element value

    // Print element as int
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_print_int"));
    X86Encoder_add_rsp_i32(&mut self.enc, 32);

    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_jmp_label(&mut self.enc, pv_loop);
    X86Encoder_place_label(&mut self.enc, pv_done);

    // Print ']'
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 93); // ']'
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -40, PE_REG_RAX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 0);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -39, PE_REG_RAX);
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_RCX, -40);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_print_str"));
    X86Encoder_add_rsp_i32(&mut self.enc, 32);

    X86Encoder_add_rsp_i32(&mut self.enc, 56);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_print_map(rcx=*Map) -- prints {key: value, ...} with newline
pub fn PeCodeGen_gen_print_map(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_print_map");
    X86Encoder_place_label(&mut self.enc, lbl);
    // Prologue: push rbp + 4 callee-saved = 5 pushes = 40 bytes
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12); // map
    X86Encoder_push(&mut self.enc, PE_REG_R13); // len
    X86Encoder_push(&mut self.enc, PE_REG_R14); // index
    X86Encoder_push(&mut self.enc, PE_REG_R15); // result string
    X86Encoder_sub_rsp_i32(&mut self.enc, 40); // 32 shadow + 8 align

    // r12 = map
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);

    // Start with "{" -- malloc 2 bytes, store '{', '\0'
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 2);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RAX); // r15 = result
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RCX, 123); // '{'
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_R15, PE_REG_RCX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RCX, 0);
    X86Encoder_mov_mem_disp_reg8(&mut self.enc, PE_REG_R15, 1, PE_REG_RCX);

    // r13 = len = [r12 + 8], r14 = 0
    X86Encoder_xor_self(&mut self.enc, PE_REG_R14);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R13, PE_REG_RAX);

    var pm_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, pm_loop);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R14, PE_REG_R13);
    var pm_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 3, pm_done); // jae -- done

    // If index > 0, append ", "
    X86Encoder_test_rr(&mut self.enc, PE_REG_R14, PE_REG_R14);
    var pm_first: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, pm_first); // jz -- first element, skip comma
    // Build ", \0" on stack at [rbp-16]
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 44); // ','
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -16, PE_REG_RAX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 32); // ' '
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -15, PE_REG_RAX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 0);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -14, PE_REG_RAX);
    // r15 = p_str_concat(r15, &[rbp-16])
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R15);
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_RDX, -16);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_str_concat"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RAX);
    X86Encoder_place_label(&mut self.enc, pm_first);

    // Get key: entry = ptr + r14*16, key = [entry]
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R14);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 4);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX); // rcx = key ptr

    // r15 = p_str_concat(r15, key)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_RCX); // rdx = key
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R15); // rcx = result so far
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_str_concat"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RAX);

    // Append ": "
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 58); // ':'
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -16, PE_REG_RAX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 32); // ' '
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -15, PE_REG_RAX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 0);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -14, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R15);
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_RDX, -16);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_str_concat"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RAX);

    // Get value: entry+8
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R14);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 4);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX); // rcx = value (i64)

    // Call p_to_str(value) -> rax = string
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_to_str"));

    // r15 = p_str_concat(r15, rax)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R15);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_RAX);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_str_concat"));
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R15, PE_REG_RAX);

    // inc r14, loop
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_jmp_label(&mut self.enc, pm_loop);

    X86Encoder_place_label(&mut self.enc, pm_done);
    // Append "}" -- build "}\0" on stack at [rbp-16]
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 125); // '}'
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -16, PE_REG_RAX);
    X86Encoder_mov_r8_imm(&mut self.enc, PE_REG_RAX, 0);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -15, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R15);
    X86Encoder_lea_rbp(&mut self.enc, PE_REG_RDX, -16);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_str_concat"));
    // rax = final string

    // Print the string (p_print_str adds newline)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_print_str"));

    // Epilogue
    X86Encoder_add_rsp_i32(&mut self.enc, 40);
    X86Encoder_pop(&mut self.enc, PE_REG_R15);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// --- Entry point (_main) ------------------------------------------------
pub fn PeCodeGen_gen_entry_point(self: &mut PeCodeGen) {
    self.entry_offset = X86Encoder_offset(&self.enc);

    // Windows PE entry: call main(), then ExitProcess(rax)
    X86Encoder_sub_rsp_i32(&mut self.enc, 40); // shadow space + alignment

    // main lives in the assembled user code — emit a pending call
    var main_label: i64 = PeCodeGen_get_func_label(self, "main");
    if main_label >= 0 {
        X86Encoder_call_label(&mut self.enc, main_label);
    } else {
        PeCodeGen_emit_call_user(self, "main");
    }

    // ExitProcess(rax)
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_call_rip(&mut self.enc, PeCodeGen_iat_off(self, IAT_EXIT_PROCESS));
    X86Encoder_ud2(&mut self.enc);
}

// ===========================================================================
// Multiboot2 boot entry point (ported from src/pe.rs gen_boot_entry_point)
// ===========================================================================
// When GRUB loads the kernel, it jumps to the entry point with:
//   eax = 0x36d76289 (MB2_BOOTLOADER_MAGIC)
//   ebx = multiboot info structure address
//   32-bit protected mode, paging disabled
// We must switch to 64-bit long mode before calling main(), because the
// Fides compiler generates 64-bit code.

pub fn PeCodeGen_gen_boot_entry_point(self: &mut PeCodeGen, module: &IrModule) {
    self.entry_offset = X86Encoder_offset(&self.enc);

    // ─── 32-bit trampoline to switch to long mode ───────────────────
    // Set up temporary stack: mov esp, 0x90000
    X86Encoder_emit_u8(&mut self.enc, 0xBC);
    X86Encoder_emit_u32(&mut self.enc, 0x90000);

    // Load GDT: lgdt [gdt_desc]
    X86Encoder_emit_u8(&mut self.enc, 0x0F);
    X86Encoder_emit_u8(&mut self.enc, 0x01);
    X86Encoder_emit_u8(&mut self.enc, 0x15);
    var lgdt_patch_offset: i64 = X86Encoder_offset(&self.enc);
    X86Encoder_emit_u32(&mut self.enc, 0); // placeholder for gdt_desc address

    // Enable PAE: mov eax, cr4; or eax, 0x20; mov cr4, eax
    X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x20); X86Encoder_emit_u8(&mut self.enc, 0xE0);
    X86Encoder_emit_u8(&mut self.enc, 0x0D); X86Encoder_emit_u32(&mut self.enc, 0x20);
    X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x22); X86Encoder_emit_u8(&mut self.enc, 0xE0);

    // Zero out page table memory (4 pages at 0x70000)
    // mov edi, 0x70000
    X86Encoder_emit_u8(&mut self.enc, 0xBF);
    X86Encoder_emit_u32(&mut self.enc, 0x70000);
    // mov ecx, 0x800
    X86Encoder_emit_u8(&mut self.enc, 0xB9);
    X86Encoder_emit_u32(&mut self.enc, 0x800);
    // xor eax, eax
    X86Encoder_emit_u8(&mut self.enc, 0x31); X86Encoder_emit_u8(&mut self.enc, 0xC0);
    // rep stosd
    X86Encoder_emit_u8(&mut self.enc, 0xF3); X86Encoder_emit_u8(&mut self.enc, 0xAB);

    // PML4[0] = 0x71000 | 3 (present + writable)
    // mov dword [0x70000], 0x71003
    X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x05);
    X86Encoder_emit_u32(&mut self.enc, 0x70000);
    X86Encoder_emit_u32(&mut self.enc, 0x71003);

    // PDPT[0] = 0x83 (present + writable + huge page, maps first 1GB)
    // mov dword [0x71000], 0x83
    X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x05);
    X86Encoder_emit_u32(&mut self.enc, 0x71000);
    X86Encoder_emit_u32(&mut self.enc, 0x83);

    // ─── User page tables (for ring 3 isolation) ───────────────────
    // User PML4 at 0x72000, PDPT at 0x73000, PD at 0x74000, PT at 0x75000
    // Maps ONLY: 0x10000 (user program, 4KB) and 0xB8000 (VGA, 4KB)

    // Zero user page table memory (4 pages at 0x72000)
    // mov edi, 0x72000
    X86Encoder_emit_u8(&mut self.enc, 0xBF);
    X86Encoder_emit_u32(&mut self.enc, 0x72000);
    // mov ecx, 0x1000 (4096 dwords = 16384 bytes = 4 pages)
    X86Encoder_emit_u8(&mut self.enc, 0xB9);
    X86Encoder_emit_u32(&mut self.enc, 0x1000);
    // xor eax, eax
    X86Encoder_emit_u8(&mut self.enc, 0x31); X86Encoder_emit_u8(&mut self.enc, 0xC0);
    // rep stosd
    X86Encoder_emit_u8(&mut self.enc, 0xF3); X86Encoder_emit_u8(&mut self.enc, 0xAB);

    // User PML4[0] = 0x73000 | 7 (present + writable + user)
    X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x05);
    X86Encoder_emit_u32(&mut self.enc, 0x72000);
    X86Encoder_emit_u32(&mut self.enc, 0x73007);

    // User PDPT[0] = 0x74000 | 7 (present + writable + user)
    X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x05);
    X86Encoder_emit_u32(&mut self.enc, 0x73000);
    X86Encoder_emit_u32(&mut self.enc, 0x74007);

    // User PD[0] = 0x75000 | 7 (present + writable + user, points to PT)
    X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x05);
    X86Encoder_emit_u32(&mut self.enc, 0x74000);
    X86Encoder_emit_u32(&mut self.enc, 0x75007);

    // User PT[0x10] = 0x10000 | 7 (user program at 0x10000, 4KB)
    // PT entry index 0x10, addr = 0x75000 + 0x10*8 = 0x75080
    X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x05);
    X86Encoder_emit_u32(&mut self.enc, 0x75080);
    X86Encoder_emit_u32(&mut self.enc, 0x10007);

    // User PT[0xB8] = 0xB8000 | 7 (VGA at 0xB8000, 4KB)
    // PT entry index 0xB8, addr = 0x75000 + 0xB8*8 = 0x755C0
    X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x05);
    X86Encoder_emit_u32(&mut self.enc, 0x755C0);
    X86Encoder_emit_u32(&mut self.enc, 0xB80007);

    // Load CR3: mov eax, 0x70000; mov cr3, eax
    X86Encoder_emit_u8(&mut self.enc, 0xB8);
    X86Encoder_emit_u32(&mut self.enc, 0x70000);
    X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x22); X86Encoder_emit_u8(&mut self.enc, 0xD8);

    // Enable long mode: mov ecx, 0xC0000080; rdmsr; or eax, 0x100; wrmsr
    X86Encoder_emit_u8(&mut self.enc, 0xB9);
    X86Encoder_emit_u32(&mut self.enc, 0xC0000000 + 0x80);
    X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x32);
    X86Encoder_emit_u8(&mut self.enc, 0x0D); X86Encoder_emit_u32(&mut self.enc, 0x100);
    X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x30);

    // Enable paging: mov eax, cr0; or eax, 0x80000001; mov cr0, eax
    X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x20); X86Encoder_emit_u8(&mut self.enc, 0xC0);
    X86Encoder_emit_u8(&mut self.enc, 0x0D); X86Encoder_emit_u32(&mut self.enc, 0x80000000 + 0x01);
    X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x22); X86Encoder_emit_u8(&mut self.enc, 0xC0);

    // Far jump to 64-bit code segment (selector 0x08)
    // ljmp 0x08:long_mode_start
    X86Encoder_emit_u8(&mut self.enc, 0xEA); // ljmp ptr16:32
    var ljmp_target_patch: i64 = X86Encoder_offset(&self.enc);
    X86Encoder_emit_u32(&mut self.enc, 0); // offset (patch later)
    X86Encoder_emit_u16(&mut self.enc, 0x08); // segment selector 0x08

    // ─── GDT ───────────────────────────────────────────────────────
    // Align to 8 bytes
    while X86Encoder_offset(&self.enc) % 8 != 0 {
        X86Encoder_emit_u8(&mut self.enc, 0x90); // nop padding
    }
    var gdt_offset: i64 = X86Encoder_offset(&self.enc);

    // Null descriptor (8 bytes)
    var gi: i64 = 0;
    while gi < 8 { X86Encoder_emit_u8(&mut self.enc, 0); gi = gi + 1; }

    // Code segment (64-bit): base=0, limit=0, access=0x9A, flags=0x20 (L=1, D=0)
    // GDT entry: [limit_lo(2)][base_lo(2)][base_mid(1)][access(1)][flags+limit_hi(1)][base_hi(1)]
    X86Encoder_emit_u16(&mut self.enc, 0); // limit_lo
    X86Encoder_emit_u16(&mut self.enc, 0); // base_lo
    X86Encoder_emit_u8(&mut self.enc, 0); // base_mid
    X86Encoder_emit_u8(&mut self.enc, 0x9A); // access
    X86Encoder_emit_u8(&mut self.enc, 0x20); // flags (L=1, D=0)
    X86Encoder_emit_u8(&mut self.enc, 0); // base_hi

    // Data segment (64-bit): base=0, limit=0, access=0x92, flags=0x00
    X86Encoder_emit_u16(&mut self.enc, 0); // limit_lo
    X86Encoder_emit_u16(&mut self.enc, 0); // base_lo
    X86Encoder_emit_u8(&mut self.enc, 0); // base_mid
    X86Encoder_emit_u8(&mut self.enc, 0x92); // access
    X86Encoder_emit_u8(&mut self.enc, 0); // flags
    X86Encoder_emit_u8(&mut self.enc, 0); // base_hi

    // User code segment (64-bit): access=0xFA (user, executable, readable)
    X86Encoder_emit_u16(&mut self.enc, 0); // limit_lo
    X86Encoder_emit_u16(&mut self.enc, 0); // base_lo
    X86Encoder_emit_u8(&mut self.enc, 0); // base_mid
    X86Encoder_emit_u8(&mut self.enc, 0xFA); // access (user + code + readable)
    X86Encoder_emit_u8(&mut self.enc, 0x20); // flags (L=1, D=0)
    X86Encoder_emit_u8(&mut self.enc, 0); // base_hi

    // User data segment (64-bit): access=0xF2 (user, writable)
    X86Encoder_emit_u16(&mut self.enc, 0); // limit_lo
    X86Encoder_emit_u16(&mut self.enc, 0); // base_lo
    X86Encoder_emit_u8(&mut self.enc, 0); // base_mid
    X86Encoder_emit_u8(&mut self.enc, 0xF2); // access (user + data + writable)
    X86Encoder_emit_u8(&mut self.enc, 0); // flags
    X86Encoder_emit_u8(&mut self.enc, 0); // base_hi

    // GDT descriptor
    var gdt_desc_offset: i64 = X86Encoder_offset(&self.enc);
    // Size (limit): 39 bytes (5 entries * 8 - 1)
    X86Encoder_emit_u16(&mut self.enc, 0x27);
    // Base address: will be patched
    var gdt_base_patch: i64 = X86Encoder_offset(&self.enc);
    X86Encoder_emit_u32(&mut self.enc, 0); // base (patch later)

    // ─── 64-bit code ────────────────────────────────────────────────
    var long_mode_offset: i64 = X86Encoder_offset(&self.enc);

    // Set up 64-bit stack: mov rsp, 0x90000
    X86Encoder_emit_u8(&mut self.enc, 0x48); // REX.W
    X86Encoder_emit_u8(&mut self.enc, 0xBC);
    X86Encoder_emit_u64(&mut self.enc, 0x90000);
    // mov rbp, rsp
    X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xE5);

    // Push 0 (fake return address)
    X86Encoder_emit_u8(&mut self.enc, 0x6A); X86Encoder_emit_u8(&mut self.enc, 0x00);

    // ─── IDT + PIC setup (if irq1_handler exists) ──────────────────
    // This sets up interrupt-driven keyboard before calling main().
    var has_irq1: bool = PeCodeGen_has_func(self, "irq1_handler");

    if has_irq1 {
        // 1. Zero out IDT memory at 0x1000 (4096 bytes = 512 qwords)
        // mov rdi, 0x1000
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xBF);
        X86Encoder_emit_u64(&mut self.enc, 0x1000);
        // mov ecx, 512
        X86Encoder_emit_u8(&mut self.enc, 0xB9);
        X86Encoder_emit_u32(&mut self.enc, 512);
        // xor rax, rax
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x31); X86Encoder_emit_u8(&mut self.enc, 0xC0);
        // rep stosq
        X86Encoder_emit_u8(&mut self.enc, 0xF3); X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xAB);

        // 2. Build IDT entry for vector 0x21 (IRQ1 = keyboard)
        // Entry at 0x1000 + 0x21 * 16 = 0x1210
        var irq1_label: i64 = PeCodeGen_get_func_label(self, "irq1_handler");
        X86Encoder_lea_label(&mut self.enc, PE_REG_RAX, irq1_label);
        // mov r11, rax (save handler addr)
        X86Encoder_emit_u8(&mut self.enc, 0x49); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xC3);
        // mov rdx, 0x1210
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xBA);
        X86Encoder_emit_u64(&mut self.enc, 0x1210);
        // mov [rdx], ax (offset_low)
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0x02);
        // mov word [rdx+2], 0x08 (selector)
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x02); X86Encoder_emit_u16(&mut self.enc, 0x08);
        // mov byte [rdx+4], 0 (IST=0)
        X86Encoder_emit_u8(&mut self.enc, 0xC6); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x04); X86Encoder_emit_u8(&mut self.enc, 0x00);
        // mov byte [rdx+5], 0x8E (type_attr = interrupt gate)
        X86Encoder_emit_u8(&mut self.enc, 0xC6); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x05); X86Encoder_emit_u8(&mut self.enc, 0x8E);
        // offset_mid: mov rax, r11; shr rax, 16; mov [rdx+6], ax
        X86Encoder_emit_u8(&mut self.enc, 0x4C); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xD8);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x10);
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x06);
        // offset_high: shr rax, 16; mov [rdx+8], eax
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x10);
        X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x08);

        // 3. Remap PIC (ICW1-4)
        // ICW1 master: outb(0x20, 0x11)
        X86Encoder_emit_u8(&mut self.enc, 0xB0); X86Encoder_emit_u8(&mut self.enc, 0x11);
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xBA); X86Encoder_emit_u16(&mut self.enc, 0x20);
        X86Encoder_emit_u8(&mut self.enc, 0xEE);
        // ICW1 slave: outb(0xA0, 0x11)
        X86Encoder_emit_u8(&mut self.enc, 0xB0); X86Encoder_emit_u8(&mut self.enc, 0x11);
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xBA); X86Encoder_emit_u16(&mut self.enc, 0xA0);
        X86Encoder_emit_u8(&mut self.enc, 0xEE);
        // ICW2 master: outb(0x21, 0x20)
        X86Encoder_emit_u8(&mut self.enc, 0xB0); X86Encoder_emit_u8(&mut self.enc, 0x20);
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xBA); X86Encoder_emit_u16(&mut self.enc, 0x21);
        X86Encoder_emit_u8(&mut self.enc, 0xEE);
        // ICW2 slave: outb(0xA1, 0x28)
        X86Encoder_emit_u8(&mut self.enc, 0xB0); X86Encoder_emit_u8(&mut self.enc, 0x28);
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xBA); X86Encoder_emit_u16(&mut self.enc, 0xA1);
        X86Encoder_emit_u8(&mut self.enc, 0xEE);
        // ICW3 master: outb(0x21, 0x04)
        X86Encoder_emit_u8(&mut self.enc, 0xB0); X86Encoder_emit_u8(&mut self.enc, 0x04);
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xBA); X86Encoder_emit_u16(&mut self.enc, 0x21);
        X86Encoder_emit_u8(&mut self.enc, 0xEE);
        // ICW3 slave: outb(0xA1, 0x02)
        X86Encoder_emit_u8(&mut self.enc, 0xB0); X86Encoder_emit_u8(&mut self.enc, 0x02);
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xBA); X86Encoder_emit_u16(&mut self.enc, 0xA1);
        X86Encoder_emit_u8(&mut self.enc, 0xEE);
        // ICW4 master: outb(0x21, 0x01)
        X86Encoder_emit_u8(&mut self.enc, 0xB0); X86Encoder_emit_u8(&mut self.enc, 0x01);
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xBA); X86Encoder_emit_u16(&mut self.enc, 0x21);
        X86Encoder_emit_u8(&mut self.enc, 0xEE);
        // ICW4 slave: outb(0xA1, 0x01)
        X86Encoder_emit_u8(&mut self.enc, 0xB0); X86Encoder_emit_u8(&mut self.enc, 0x01);
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xBA); X86Encoder_emit_u16(&mut self.enc, 0xA1);
        X86Encoder_emit_u8(&mut self.enc, 0xEE);

        // 4. Mask: unmask IRQ0 (timer) and IRQ1 (keyboard) — 0xFC master, 0xFF slave
        X86Encoder_emit_u8(&mut self.enc, 0xB0); X86Encoder_emit_u8(&mut self.enc, 0xFC);
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xBA); X86Encoder_emit_u16(&mut self.enc, 0x21);
        X86Encoder_emit_u8(&mut self.enc, 0xEE);
        X86Encoder_emit_u8(&mut self.enc, 0xB0); X86Encoder_emit_u8(&mut self.enc, 0xFF);
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xBA); X86Encoder_emit_u16(&mut self.enc, 0xA1);
        X86Encoder_emit_u8(&mut self.enc, 0xEE);

        // 5. Set up IDT descriptor at 0x500
        // mov word [0x500], 0x0FFF
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x04); X86Encoder_emit_u8(&mut self.enc, 0x25);
        X86Encoder_emit_u32(&mut self.enc, 0x500); X86Encoder_emit_u16(&mut self.enc, 0x0FFF);
        // mov dword [0x502], 0x1000
        X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x04); X86Encoder_emit_u8(&mut self.enc, 0x25);
        X86Encoder_emit_u32(&mut self.enc, 0x502); X86Encoder_emit_u32(&mut self.enc, 0x1000);
        // mov dword [0x506], 0
        X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x04); X86Encoder_emit_u8(&mut self.enc, 0x25);
        X86Encoder_emit_u32(&mut self.enc, 0x506); X86Encoder_emit_u32(&mut self.enc, 0);

        // 6. Load IDT: lidt [0x500]
        X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x1C); X86Encoder_emit_u8(&mut self.enc, 0x25);
        X86Encoder_emit_u32(&mut self.enc, 0x500);

        // NOTE: sti is deferred until after @interrupt(N) handlers are wired
    }

    // ─── TSS setup (for user-mode support) ──────────────────────────
    // Zero out TSS at 0x4000 (104 bytes = 13 qwords)
    X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xBF);
    X86Encoder_emit_u64(&mut self.enc, 0x4000);
    X86Encoder_emit_u8(&mut self.enc, 0xB9); X86Encoder_emit_u32(&mut self.enc, 13);
    X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x31); X86Encoder_emit_u8(&mut self.enc, 0xC0);
    X86Encoder_emit_u8(&mut self.enc, 0xF3); X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xAB);
    // Set TSS.rsp0 = 0x90000 (kernel stack)
    // mov qword [0x4004], 0x90000
    X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x04); X86Encoder_emit_u8(&mut self.enc, 0x25);
    X86Encoder_emit_u32(&mut self.enc, 0x4004); X86Encoder_emit_u32(&mut self.enc, 0x90000);
    X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x04); X86Encoder_emit_u8(&mut self.enc, 0x25);
    X86Encoder_emit_u32(&mut self.enc, 0x4008); X86Encoder_emit_u32(&mut self.enc, 0);

    // ─── @interrupt(N) IDT setup ─────────────────────────────────────
    // For each function with @interrupt(N), register it in the IDT at vector N.
    PeCodeGen_gen_idt_setup_for_interrupts(self, module);

    // Enable interrupts AFTER all IDT entries are wired
    if has_irq1 {
        X86Encoder_emit_u8(&mut self.enc, 0xFB); // sti
    }

    // ─── Direct VGA test: write 'F' to VGA memory at 0xB8000 ───────────
    // This bypasses all function calls to verify VGA memory is accessible.
    // mov rax, 0xB8000
    X86Encoder_emit_u8(&mut self.enc, 0x48);
    X86Encoder_emit_u8(&mut self.enc, 0xB8);
    X86Encoder_emit_u8(&mut self.enc, 0x00);
    X86Encoder_emit_u8(&mut self.enc, 0x80);
    X86Encoder_emit_u8(&mut self.enc, 0x0B);
    X86Encoder_emit_u8(&mut self.enc, 0x00);
    X86Encoder_emit_u8(&mut self.enc, 0x00);
    X86Encoder_emit_u8(&mut self.enc, 0x00);
    X86Encoder_emit_u8(&mut self.enc, 0x00);
    // mov byte [rax], 0x46  ('F')
    X86Encoder_emit_u8(&mut self.enc, 0xC6);
    X86Encoder_emit_u8(&mut self.enc, 0x00);
    X86Encoder_emit_u8(&mut self.enc, 0x46);
    // mov byte [rax+1], 0x07  (attribute: white on black)
    X86Encoder_emit_u8(&mut self.enc, 0xC6);
    X86Encoder_emit_u8(&mut self.enc, 0x40);
    X86Encoder_emit_u8(&mut self.enc, 0x01);
    X86Encoder_emit_u8(&mut self.enc, 0x07);

    // Call main() — lives in the assembled user code (pending ref)
    var main_label: i64 = PeCodeGen_get_func_label(self, "main");
    if main_label >= 0 {
        X86Encoder_call_label(&mut self.enc, main_label);
    } else {
        PeCodeGen_emit_call_user(self, "main");
    }

    // Halt loop: cli; hlt; jmp -3
    X86Encoder_emit_u8(&mut self.enc, 0xFA); // cli (disable interrupts)
    X86Encoder_emit_u8(&mut self.enc, 0xF4); // hlt
    X86Encoder_emit_u8(&mut self.enc, 0xEB); X86Encoder_emit_u8(&mut self.enc, 0xFD); // jmp -3

    // ─── Patch addresses ────────────────────────────────────────────
    // Binary layout: [MB2 header (24 bytes)][code][rdata]
    // Code is loaded at 0x100000 + 24 = 0x100018
    var MB2_HEADER_SIZE: i64 = 24;
    var LOAD_ADDR: i64 = 0x100000;
    var CODE_BASE: i64 = LOAD_ADDR + MB2_HEADER_SIZE;

    // Patch lgdt address (absolute m32)
    var lgdt_addr: i64 = CODE_BASE + gdt_desc_offset;
    self.enc.code.set(lgdt_patch_offset, lgdt_addr & 0xFF);
    self.enc.code.set(lgdt_patch_offset + 1, (lgdt_addr >> 8) & 0xFF);
    self.enc.code.set(lgdt_patch_offset + 2, (lgdt_addr >> 16) & 0xFF);
    self.enc.code.set(lgdt_patch_offset + 3, (lgdt_addr >> 24) & 0xFF);

    // Patch ljmp target (absolute 32-bit offset)
    var ljmp_addr: i64 = CODE_BASE + long_mode_offset;
    self.enc.code.set(ljmp_target_patch, ljmp_addr & 0xFF);
    self.enc.code.set(ljmp_target_patch + 1, (ljmp_addr >> 8) & 0xFF);
    self.enc.code.set(ljmp_target_patch + 2, (ljmp_addr >> 16) & 0xFF);
    self.enc.code.set(ljmp_target_patch + 3, (ljmp_addr >> 24) & 0xFF);

    // Patch GDT base (absolute linear address)
    var gdt_base: i64 = CODE_BASE + gdt_offset;
    self.enc.code.set(gdt_base_patch, gdt_base & 0xFF);
    self.enc.code.set(gdt_base_patch + 1, (gdt_base >> 8) & 0xFF);
    self.enc.code.set(gdt_base_patch + 2, (gdt_base >> 16) & 0xFF);
    self.enc.code.set(gdt_base_patch + 3, (gdt_base >> 24) & 0xFF);
}

// ===========================================================================
// F29: @interrupt(N) IDT setup — register all annotated ISRs in the IDT
// ===========================================================================
pub fn PeCodeGen_gen_idt_setup_for_interrupts(self: &mut PeCodeGen, module: &IrModule) {
    // Collect all (vector, handler_label) pairs for functions with interrupt_vector >= 0
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(fi);
        var func: IrFunction = entry.func;
        if func.interrupt_vector >= 0 {
            var handler_label: i64 = PeCodeGen_get_func_label(self, func.name);
            var vector: i64 = func.interrupt_vector;
            {
                // IDT entry address = 0x1000 + vector * 16
                var idt_entry_addr: i64 = 0x1000 + vector * 16;

                // Load handler address: enc-local label via lea, user code via imm64
                if handler_label >= 0 {
                    X86Encoder_lea_label(&mut self.enc, PE_REG_RAX, handler_label);
                } else {
                    PeCodeGen_emit_mov_user_imm64(self, PE_REG_RAX, func.name);
                }
                // mov r11, rax (save handler addr)
                X86Encoder_emit_u8(&mut self.enc, 0x49); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xC3);

                // mov rdx, idt_entry_addr
                X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xBA);
                X86Encoder_emit_u64(&mut self.enc, idt_entry_addr);

                // Store offset_low: mov [rdx], ax
                X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0x02);
                // Store selector 0x08: mov word [rdx+2], 0x08
                X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xC7); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x02); X86Encoder_emit_u16(&mut self.enc, 0x08);
                // Store IST=0: mov byte [rdx+4], 0
                X86Encoder_emit_u8(&mut self.enc, 0xC6); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x04); X86Encoder_emit_u8(&mut self.enc, 0x00);
                // Store type_attr=0x8E: mov byte [rdx+5], 0x8E
                X86Encoder_emit_u8(&mut self.enc, 0xC6); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x05); X86Encoder_emit_u8(&mut self.enc, 0x8E);
                // offset_mid: mov rax, r11; shr rax, 16; mov [rdx+6], ax
                X86Encoder_emit_u8(&mut self.enc, 0x4C); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xD8);
                X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x10);
                X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x06);
                // offset_high: shr rax, 16; mov [rdx+8], eax
                X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x10);
                X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x08);
            }
        }
        fi = fi + 1;
    }
}

// ===========================================================================
// Bare-metal port I/O stubs (ported from src/pe.rs)
// ===========================================================================

// p_inb(rcx = port) -> rax = byte — read from I/O port
// Calling convention: first arg in rcx (no env pointer for extern)
pub fn PeCodeGen_gen_p_inb(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_inb");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // mov dx, cx (port to dx)
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xCA);
        // xor rax, rax
        X86Encoder_xor_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
        // in al, dx
        X86Encoder_emit_u8(&mut self.enc, 0xEC);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_outb(rcx = port, rdx = value) — write to I/O port
// Calling convention: first arg in rcx, second in rdx (no env pointer for extern)
pub fn PeCodeGen_gen_p_outb(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_outb");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // mov al, dl (value to al — must do before overwriting dx)
        X86Encoder_emit_u8(&mut self.enc, 0x88); X86Encoder_emit_u8(&mut self.enc, 0xD0);
        // mov dx, cx (port to dx)
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xCA);
        // out dx, al
        X86Encoder_emit_u8(&mut self.enc, 0xEE);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_outw(rcx = port, rdx = value) — write 16-bit word to I/O port
pub fn PeCodeGen_gen_p_outw(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_outw");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // mov ax, dx (value to ax — must do before overwriting dx)
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xD0);
        // mov dx, cx (port to dx)
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xCA);
        // out dx, ax
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xEF);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_inw(rcx = port) -> rax = word — read 16-bit from I/O port
pub fn PeCodeGen_gen_p_inw(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_inw");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // mov dx, cx (port to dx)
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0xCA);
        // xor rax, rax
        X86Encoder_xor_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
        // in ax, dx
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0xED);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_hlt() — halt CPU (hlt only; interrupts must be enabled for wakeup)
pub fn PeCodeGen_gen_p_hlt(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_hlt");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        X86Encoder_emit_u8(&mut self.enc, 0xF4); // hlt (no cli — interrupts wake the CPU)
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_cli() — clear interrupt flag
pub fn PeCodeGen_gen_p_cli(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_cli");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        X86Encoder_emit_u8(&mut self.enc, 0xFA); // cli
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_sti() — set interrupt flag
pub fn PeCodeGen_gen_p_sti(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_sti");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        X86Encoder_emit_u8(&mut self.enc, 0xFB); // sti
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_mem_read8(rcx=addr) -> rax — read 1 byte from memory
pub fn PeCodeGen_gen_p_mem_read8(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_mem_read8");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // movzx eax, byte [rcx]
        X86Encoder_emit_u8(&mut self.enc, 0x0F);
        X86Encoder_emit_u8(&mut self.enc, 0xB6);
        X86Encoder_emit_u8(&mut self.enc, 0x01);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_mem_write8(rcx=addr, rdx=val) — write 1 byte to memory
pub fn PeCodeGen_gen_p_mem_write8(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_mem_write8");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // mov [rcx], dl
        X86Encoder_emit_u8(&mut self.enc, 0x88);
        X86Encoder_emit_u8(&mut self.enc, 0x11);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_serial_init() — initialize COM1 serial port (115200 baud, 8N1)
pub fn PeCodeGen_gen_p_serial_init(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_serial_init");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // Disable interrupts: outb(0x3F9, 0x00)
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RDX, 0x3F9);
        X86Encoder_xor_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
        X86Encoder_emit_u8(&mut self.enc, 0xEE); // out dx, al

        // Enable DLAB: outb(0x3FB, 0x80)
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RDX, 0x3FB);
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RAX, 0x80);
        X86Encoder_emit_u8(&mut self.enc, 0xEE); // out dx, al

        // Set divisor low byte (115200 baud = divisor 1): outb(0x3F8, 0x01)
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RDX, 0x3F8);
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RAX, 0x01);
        X86Encoder_emit_u8(&mut self.enc, 0xEE); // out dx, al

        // Set divisor high byte: outb(0x3F9, 0x00)
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RDX, 0x3F9);
        X86Encoder_xor_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
        X86Encoder_emit_u8(&mut self.enc, 0xEE); // out dx, al

        // 8 bits, no parity, 1 stop bit: outb(0x3FB, 0x03)
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RDX, 0x3FB);
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RAX, 0x03);
        X86Encoder_emit_u8(&mut self.enc, 0xEE); // out dx, al

        // Enable FIFO, clear them, 14-byte threshold: outb(0x3FA, 0xC7)
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RDX, 0x3FA);
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RAX, 0xC7);
        X86Encoder_emit_u8(&mut self.enc, 0xEE); // out dx, al

        // IRQs enabled, RTS/DSR set: outb(0x3FC, 0x0B)
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RDX, 0x3FC);
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RAX, 0x0B);
        X86Encoder_emit_u8(&mut self.enc, 0xEE); // out dx, al
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_serial_write(rcx = char) — write one byte to COM1
pub fn PeCodeGen_gen_p_serial_write(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_serial_write");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // Wait for transmit buffer empty (LSR bit 5)
        var sw_wait: i64 = X86Encoder_alloc_label(&mut self.enc);
        X86Encoder_place_label(&mut self.enc, sw_wait);
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RDX, 0x3FD); // LSR
        X86Encoder_emit_u8(&mut self.enc, 0xEC); // in al, dx
        X86Encoder_emit_u8(&mut self.enc, 0xA8); // test al, 0x20
        X86Encoder_emit_u8(&mut self.enc, 0x20);
        X86Encoder_jcc_label(&mut self.enc, 0x4, sw_wait); // jz (wait)

        // Send byte: outb(0x3F8, char)
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RDX, 0x3F8); // THR
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX); // al = char
        X86Encoder_emit_u8(&mut self.enc, 0xEE); // out dx, al
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_serial_read() -> rax = byte — read one byte from COM1
pub fn PeCodeGen_gen_p_serial_read(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_serial_read");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // Wait for data ready (LSR bit 0)
        var sr_wait: i64 = X86Encoder_alloc_label(&mut self.enc);
        X86Encoder_place_label(&mut self.enc, sr_wait);
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RDX, 0x3FD); // LSR
        X86Encoder_emit_u8(&mut self.enc, 0xEC); // in al, dx
        X86Encoder_emit_u8(&mut self.enc, 0xA8); // test al, 0x01
        X86Encoder_emit_u8(&mut self.enc, 0x01);
        X86Encoder_jcc_label(&mut self.enc, 0x4, sr_wait); // jz (wait)

        // Read byte: in al, 0x3F8
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RDX, 0x3F8); // RBR
        X86Encoder_emit_u8(&mut self.enc, 0xEC); // in al, dx
        // movzx eax, al (zero-extend)
        X86Encoder_emit_u8(&mut self.enc, 0x0F);
        X86Encoder_emit_u8(&mut self.enc, 0xB6);
        X86Encoder_emit_u8(&mut self.enc, 0xC0);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_serial_ready() -> rax = bool — check if data is available
pub fn PeCodeGen_gen_p_serial_ready(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_serial_ready");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // Read LSR and check bit 0 (data ready)
        X86Encoder_mov_imm32(&mut self.enc, PE_REG_RDX, 0x3FD); // LSR
        X86Encoder_emit_u8(&mut self.enc, 0xEC); // in al, dx
        X86Encoder_emit_u8(&mut self.enc, 0x24); // and al, 0x01
        X86Encoder_emit_u8(&mut self.enc, 0x01);
        // movzx eax, al
        X86Encoder_emit_u8(&mut self.enc, 0x0F);
        X86Encoder_emit_u8(&mut self.enc, 0xB6);
        X86Encoder_emit_u8(&mut self.enc, 0xC0);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

