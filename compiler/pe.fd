// p_map_new() -> rax = *Map (24-byte heap struct, all zeros)
pub fn PeCodeGen_gen_map_new(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_map_new");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
