    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RDX, 3);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RDX);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    X86Encoder_ret(&mut self.enc);
}

// p_vec_pop(rcx=*Vec) -> rax = i64
pub fn PeCodeGen_gen_vec_pop(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_vec_pop");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);

    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R8, PE_REG_RAX);

    X86Encoder_test_rr(&mut self.enc, PE_REG_R8, PE_REG_R8);
    var vp_empty: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, vp_empty);

    X86Encoder_dec_r(&mut self.enc, PE_REG_R8);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_R8);

    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_R8);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RDX, 3);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RDX);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var vp_ret: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jmp_label(&mut self.enc, vp_ret);

    X86Encoder_place_label(&mut self.enc, vp_empty);
    X86Encoder_xor_self(&mut self.enc, PE_REG_RAX);

    X86Encoder_place_label(&mut self.enc, vp_ret);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

