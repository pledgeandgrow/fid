    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_xor_self(&mut self.enc, PE_REG_RCX);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_RAX, 8, PE_REG_RCX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_RAX, 16, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
