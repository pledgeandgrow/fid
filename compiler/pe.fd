    X86Encoder_add_r_i32(&mut self.enc, PE_REG_RAX, 8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R8, PE_REG_RAX); // r8 = len
    X86Encoder_dec_r(&mut self.enc, PE_REG_R8);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RCX); // rax = ptr
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RDX, PE_REG_R8);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RDX, 3);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RDX);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    X86Encoder_ret(&mut self.enc);
