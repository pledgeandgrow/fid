// p_to_str_bool(rcx = 0|1) -> rax = "true"|"false"
pub fn PeCodeGen_gen_to_str_bool(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_to_str_bool");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);

    X86Encoder_test_rr(&mut self.enc, PE_REG_RCX, PE_REG_RCX);
    var tb_true: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 5, tb_true);

    // false: lea r12, "false" from rdata, malloc(6), copy 6 bytes
    var false_off: i64 = PeCodeGen_get_string_offset(self, "false");
    X86Encoder_lea_rip(&mut self.enc, PE_REG_R12, false_off);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 6);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    // Copy 6 bytes from r12 to rax
    X86Encoder_push(&mut self.enc, PE_REG_RAX); // save dest
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R8, PE_REG_RAX);
    var cpy_f: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, cpy_f);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RCX, PE_REG_R12);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_R8, PE_REG_RCX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RCX, PE_REG_RCX);
    var cpy_f_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, cpy_f_done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R12);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R8);
    X86Encoder_jmp_label(&mut self.enc, cpy_f);
    X86Encoder_place_label(&mut self.enc, cpy_f_done);
    X86Encoder_pop(&mut self.enc, PE_REG_RAX); // restore dest
    var tb_ret: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jmp_label(&mut self.enc, tb_ret);

    X86Encoder_place_label(&mut self.enc, tb_true);
    // true: lea r12, "true" from rdata, malloc(5), copy 5 bytes
    var true_off: i64 = PeCodeGen_get_string_offset(self, "true");
    X86Encoder_lea_rip(&mut self.enc, PE_REG_R12, true_off);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 5);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_push(&mut self.enc, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R8, PE_REG_RAX);
    var cpy_t: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, cpy_t);
    X86Encoder_mov_reg8_ptr(&mut self.enc, PE_REG_RCX, PE_REG_R12);
    X86Encoder_mov_mem_reg8_ptr(&mut self.enc, PE_REG_R8, PE_REG_RCX);
    X86Encoder_test_rr(&mut self.enc, PE_REG_RCX, PE_REG_RCX);
    var cpy_t_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, cpy_t_done);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R12);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R8);
    X86Encoder_jmp_label(&mut self.enc, cpy_t);
    X86Encoder_place_label(&mut self.enc, cpy_t_done);
    X86Encoder_pop(&mut self.enc, PE_REG_RAX);

    X86Encoder_place_label(&mut self.enc, tb_ret);
    X86Encoder_add_rsp_i32(&mut self.enc, 32);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_vec_new() -> rax = *Vec (24-byte heap struct, all zeros)
pub fn PeCodeGen_gen_vec_new(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_vec_new");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_sub_rsp_i32(&mut self.enc, 48);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RCX, 24);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_xor_self(&mut self.enc, PE_REG_RCX);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_RAX, 8, PE_REG_RCX);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_RAX, 16, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_vec_push(rcx=*Vec, rdx=i64 value)
pub fn PeCodeGen_gen_vec_push(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_vec_push");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, PE_REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);
    X86Encoder_push(&mut self.enc, PE_REG_R12);
    X86Encoder_push(&mut self.enc, PE_REG_R13);
    X86Encoder_push(&mut self.enc, PE_REG_R14);
    X86Encoder_sub_rsp_i32(&mut self.enc, 40);

    X86Encoder_mov_rr(&mut self.enc, PE_REG_R12, PE_REG_RCX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_R13, PE_REG_RDX);

    // r14 = len, rax = cap
    X86Encoder_mov_reg_mem_disp(&mut self.enc, PE_REG_R14, PE_REG_R12, 8);
    X86Encoder_mov_reg_mem_disp(&mut self.enc, PE_REG_RAX, PE_REG_R12, 16);

    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R14, PE_REG_RAX);
    var vp_nogrow: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 2, vp_nogrow); // jb

    // Grow: new_cap = cap==0 ? 4 : cap*2
    X86Encoder_test_rr(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
    var vp_newcap: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 5, vp_newcap);
    X86Encoder_mov_imm32(&mut self.enc, PE_REG_RAX, 4);
    var vp_alloc: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jmp_label(&mut self.enc, vp_alloc);

    X86Encoder_place_label(&mut self.enc, vp_newcap);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 1);

    X86Encoder_place_label(&mut self.enc, vp_alloc);
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -16, PE_REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 3);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_mem_rbp_reg(&mut self.enc, -24, PE_REG_RAX);

    // Copy old data
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_R10, PE_REG_R12);
    X86Encoder_xor_self(&mut self.enc, PE_REG_R11);
    var vp_copy: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, vp_copy);
    X86Encoder_cmp_rr(&mut self.enc, PE_REG_R11, PE_REG_R14);
    var vp_copydone: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 3, vp_copydone); // jae
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R11);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 3);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R10);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RCX, PE_REG_RAX);
    X86Encoder_mov_reg_mem_rbp(&mut self.enc, PE_REG_R9, -24);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R11);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RAX, 3);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_R9);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R11);
    X86Encoder_jmp_label(&mut self.enc, vp_copy);
    X86Encoder_place_label(&mut self.enc, vp_copydone);

    // Free old buffer if non-null
    X86Encoder_test_rr(&mut self.enc, PE_REG_R10, PE_REG_R10);
    var vp_nofree: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, vp_nofree);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R10);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_free"));
    X86Encoder_place_label(&mut self.enc, vp_nofree);

    // Update ptr and cap
    X86Encoder_mov_reg_mem_rbp(&mut self.enc, PE_REG_RAX, -24);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_R12, PE_REG_RAX);
    X86Encoder_mov_reg_mem_rbp(&mut self.enc, PE_REG_RAX, -16);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R12, 16, PE_REG_RAX);

    X86Encoder_place_label(&mut self.enc, vp_nogrow);
    // Store value at ptr[len]
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R14);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 3);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
    X86Encoder_mov_ptr_reg(&mut self.enc, PE_REG_RAX, PE_REG_R13);
    X86Encoder_inc_r(&mut self.enc, PE_REG_R14);
    X86Encoder_mov_mem_disp_reg(&mut self.enc, PE_REG_R12, 8, PE_REG_R14);

    X86Encoder_add_rsp_i32(&mut self.enc, 40);
    X86Encoder_pop(&mut self.enc, PE_REG_R14);
    X86Encoder_pop(&mut self.enc, PE_REG_R13);
    X86Encoder_pop(&mut self.enc, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RSP, PE_REG_RBP);
    X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

