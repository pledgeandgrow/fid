// pe.fd -- Direct PE executable emitter for Windows x86_64 .exe files
// Ported from src/pe.rs. Generates native machine code without tcc.
//
// Pipeline: IrModule -> machine code bytes -> PE file -> .exe
//
// Windows x64 calling convention:
// - Integer args: RCX, RDX, R8, R9 (then stack)
// - Return: RAX
// - Shadow space: 32 bytes on stack for callee
// - Stack must be 16-byte aligned before CALL

module compiler::pe;

use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::pir;
use compiler::elf64;
use compiler::codegen_x64;
use compiler::peephole;

// --- Register definitions -----------------------------------------------
// x86-64 GP registers encoded as i64 (0-15)
pub const PE_REG_RAX: i64 = 0;
pub const PE_REG_RCX: i64 = 1;
pub const PE_REG_RDX: i64 = 2;
pub const PE_REG_RBX: i64 = 3;
pub const PE_REG_RSP: i64 = 4;
pub const PE_REG_RBP: i64 = 5;
pub const PE_REG_RSI: i64 = 6;
pub const PE_REG_RDI: i64 = 7;
pub const PE_REG_R8: i64 = 8;
pub const PE_REG_R9: i64 = 9;
pub const PE_REG_R10: i64 = 10;
pub const PE_REG_R11: i64 = 11;
pub const PE_REG_R12: i64 = 12;
pub const PE_REG_R13: i64 = 13;
pub const PE_REG_R14: i64 = 14;
pub const PE_REG_R15: i64 = 15;

// Low 3 bits for ModR/M encoding
pub fn reg_code(r: i64) -> i64 {
    return r & 7;
}

// True if extended register (R8-R15, needs REX.B/R)
pub fn reg_is_extended(r: i64) -> bool {
    return r >= 8;
}

// --- Relocation types ---------------------------------------------------
pub const RELOC_REL32: i64 = 0;    // relative jump/call
pub const RELOC_RIPREL32: i64 = 1; // RIP-relative data access
pub const RELOC_LEA_LABEL: i64 = 2; // lea to code label

pub struct PendingReloc {
    pub code_offset: i64,
    pub target_label: i64,
    pub kind: i64,
}

pub fn PendingReloc_new(code_offset: i64, target_label: i64, kind: i64) -> PendingReloc {
    return PendingReloc { code_offset: code_offset, target_label: target_label, kind: kind };
}

pub struct PendingRipRef {
    pub code_offset: i64,
    pub rdata_offset: i64,
}

pub fn PendingRipRef_new(code_offset: i64, rdata_offset: i64) -> PendingRipRef {
    return PendingRipRef { code_offset: code_offset, rdata_offset: rdata_offset };
}

// --- X86Encoder: x86_64 machine code encoder ----------------------------
pub struct X86Encoder {
    pub code: Vec,              // Vec<i64> of bytes
    pub labels: Vec,            // Vec<i64> label_id -> code offset
    pub pending_labels: Vec<PendingReloc>,
    pub pending_rip_refs: Vec<PendingRipRef>,
    pub next_label: i64,
}

pub fn X86Encoder_new() -> X86Encoder {
    return X86Encoder {
        code: Vec::new(),
        labels: Vec::new(),
        pending_labels: Vec::new(),
        pending_rip_refs: Vec::new(),
        next_label: 0,
    };
}

// Allocate a new label ID
pub fn X86Encoder_alloc_label(self: &mut X86Encoder) -> i64 {
    var id: i64 = self.next_label;
    self.next_label = self.next_label + 1;
    // Extend labels vec to hold this id (store -1 = unplaced)
    while self.labels.len() <= id {
        self.labels.push(-1);
    }
    return id;
}

// Place a label at the current code offset
pub fn X86Encoder_place_label(self: &mut X86Encoder, label: i64) {
    while self.labels.len() <= label {
        self.labels.push(-1);
    }
    self.labels.set(label, self.code.len());
}

/// Align code output to a boundary using multi-byte NOPs.
pub fn X86Encoder_align_to(self: &mut X86Encoder, boundary: i64) {
    var cur: i64 = self.code.len();
    if boundary <= 0 { return; }
    var rem: i64 = cur % boundary;
    if rem == 0 { return; }
    var pad: i64 = boundary - rem;
    var i: i64 = 0;
    while i < pad {
        var remaining: i64 = pad - i;
        if remaining >= 8 {
            X86Encoder_emit_u8(self, 0x0F); X86Encoder_emit_u8(self, 0x1F);
            X86Encoder_emit_u8(self, 0x84); X86Encoder_emit_u8(self, 0x00);
            X86Encoder_emit_u8(self, 0x00); X86Encoder_emit_u8(self, 0x00);
            X86Encoder_emit_u8(self, 0x00); X86Encoder_emit_u8(self, 0x00);
            i = i + 8;
        } else if remaining == 7 {
            X86Encoder_emit_u8(self, 0x0F); X86Encoder_emit_u8(self, 0x1F);
            X86Encoder_emit_u8(self, 0x80); X86Encoder_emit_u8(self, 0x00);
            X86Encoder_emit_u8(self, 0x00); X86Encoder_emit_u8(self, 0x00);
            X86Encoder_emit_u8(self, 0x00);
            i = i + 7;
        } else if remaining == 6 {
            X86Encoder_emit_u8(self, 0x66); X86Encoder_emit_u8(self, 0x0F);
            X86Encoder_emit_u8(self, 0x1F); X86Encoder_emit_u8(self, 0x44);
            X86Encoder_emit_u8(self, 0x00); X86Encoder_emit_u8(self, 0x00);
            i = i + 6;
        } else if remaining == 5 {
            X86Encoder_emit_u8(self, 0x0F); X86Encoder_emit_u8(self, 0x1F);
            X86Encoder_emit_u8(self, 0x44); X86Encoder_emit_u8(self, 0x00);
            X86Encoder_emit_u8(self, 0x00);
            i = i + 5;
        } else if remaining == 4 {
            X86Encoder_emit_u8(self, 0x0F); X86Encoder_emit_u8(self, 0x1F);
            X86Encoder_emit_u8(self, 0x40); X86Encoder_emit_u8(self, 0x00);
            i = i + 4;
        } else if remaining == 3 {
            X86Encoder_emit_u8(self, 0x0F); X86Encoder_emit_u8(self, 0x1F);
            X86Encoder_emit_u8(self, 0x00);
            i = i + 3;
        } else if remaining == 2 {
            X86Encoder_emit_u8(self, 0x66); X86Encoder_emit_u8(self, 0x90);
            i = i + 2;
        } else {
            X86Encoder_emit_u8(self, 0x90);
            i = i + 1;
        }
    }
}

// Current code offset
pub fn X86Encoder_offset(self: &X86Encoder) -> i64 {
    return self.code.len();
}

// Emit a single byte
pub fn X86Encoder_emit_u8(self: &mut X86Encoder, b: i64) {
    self.code.push(b & 0xFF);
}

// Emit 16-bit little-endian
pub fn X86Encoder_emit_u16(self: &mut X86Encoder, w: i64) {
    self.code.push(w & 0xFF);
    self.code.push((w >> 8) & 0xFF);
}

// Emit 32-bit little-endian
pub fn X86Encoder_emit_u32(self: &mut X86Encoder, d: i64) {
    self.code.push(d & 0xFF);
    self.code.push((d >> 8) & 0xFF);
    self.code.push((d >> 16) & 0xFF);
    self.code.push((d >> 24) & 0xFF);
}

// Emit 32-bit signed little-endian
pub fn X86Encoder_emit_i32(self: &mut X86Encoder, d: i64) {
    X86Encoder_emit_u32(self, d);
}

// Emit 64-bit little-endian
pub fn X86Encoder_emit_u64(self: &mut X86Encoder, q: i64) {
    var i: i64 = 0;
    while i < 8 {
        self.code.push((q >> (i * 8)) & 0xFF);
        i = i + 1;
    }
}

// REX prefix: 0x40 | (W<<3) | (R<<2) | (X<<1) | B
pub fn X86Encoder_rex(self: &mut X86Encoder, w: bool, r: bool, x: bool, b: bool) {
    var prefix: i64 = 0x40;
    if w { prefix = prefix | 0x08; }
    if r { prefix = prefix | 0x04; }
    if x { prefix = prefix | 0x02; }
    if b { prefix = prefix | 0x01; }
    self.code.push(prefix);
}

// REX.W prefix (64-bit operand)
pub fn X86Encoder_rex_w(self: &mut X86Encoder) {
    X86Encoder_rex(self, true, false, false, false);
}

// ModR/M byte: (mod<<6) | (reg<<3) | rm
pub fn X86Encoder_modrm(self: &mut X86Encoder, mod_: i64, reg: i64, rm: i64) {
    self.code.push(((mod_ & 3) << 6) | ((reg & 7) << 3) | (rm & 7));
}

// ModR/M for reg-reg: mod=3
pub fn X86Encoder_modrm_rr(self: &mut X86Encoder, reg: i64, rm: i64) {
    X86Encoder_modrm(self, 3, reg_code(reg), reg_code(rm));
}

// push r64
pub fn X86Encoder_push(self: &mut X86Encoder, r: i64) {
    if reg_is_extended(r) {
        X86Encoder_rex(self, false, false, false, true);
    }
    self.code.push(0x50 | reg_code(r));
}

// pop r64
pub fn X86Encoder_pop(self: &mut X86Encoder, r: i64) {
    if reg_is_extended(r) {
        X86Encoder_rex(self, false, false, false, true);
    }
    self.code.push(0x58 | reg_code(r));
}

// ret
pub fn X86Encoder_ret(self: &mut X86Encoder) {
    self.code.push(0xC3);
}

// nop
pub fn X86Encoder_nop(self: &mut X86Encoder) {
    self.code.push(0x90);
}

// ud2
pub fn X86Encoder_ud2(self: &mut X86Encoder) {
    self.code.push(0x0F);
    self.code.push(0x0B);
}

// xor r64, r64 (zero a register)
pub fn X86Encoder_xor_self(self: &mut X86Encoder, r: i64) {
    X86Encoder_xor_rr(self, r, r);
}

// mov r64, imm64
pub fn X86Encoder_mov_imm64(self: &mut X86Encoder, r: i64, val: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xB8 | reg_code(r));
    X86Encoder_emit_u64(self, val);
}

// mov r64, imm32 (sign-extended)
pub fn X86Encoder_mov_imm32(self: &mut X86Encoder, r: i64, val: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xC7);
    X86Encoder_modrm(self, 3, 0, reg_code(r));
    X86Encoder_emit_i32(self, val);
}

// mov r64, r64
pub fn X86Encoder_mov_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(dst));
    self.code.push(0x89);
    X86Encoder_modrm_rr(self, src, dst);
}

// Emit RBP-relative memory operand: [rbp + disp]
// RBP (code=5) with mod=00 is RIP-relative, so always use mod=01 or mod=10
pub fn X86Encoder_emit_mem_rbp(self: &mut X86Encoder, reg_code_val: i64, disp: i64) {
    if disp == 0 {
        X86Encoder_modrm(self, 1, reg_code_val, 5);
        self.code.push(0);
    } else if disp >= -128 && disp <= 127 {
        X86Encoder_modrm(self, 1, reg_code_val, 5);
        self.code.push(disp & 0xFF);
    } else {
        X86Encoder_modrm(self, 2, reg_code_val, 5);
        X86Encoder_emit_i32(self, disp);
    }
}

// Emit [base + disp] memory operand
pub fn X86Encoder_emit_mem_reg(self: &mut X86Encoder, reg_code_val: i64, base: i64, disp: i64) {
    var base_code: i64 = reg_code(base);
    if base_code == 4 {
        // RSP/R12 needs SIB byte
        if disp == 0 {
            X86Encoder_modrm(self, 0, reg_code_val, 4);
            self.code.push(0x24);
        } else if disp >= -128 && disp <= 127 {
            X86Encoder_modrm(self, 1, reg_code_val, 4);
            self.code.push(0x24);
            self.code.push(disp & 0xFF);
        } else {
            X86Encoder_modrm(self, 2, reg_code_val, 4);
            self.code.push(0x24);
            X86Encoder_emit_i32(self, disp);
        }
    } else if base_code == 5 {
        // RBP/R13 needs mod=01 minimum
        if disp == 0 {
            X86Encoder_modrm(self, 1, reg_code_val, 5);
            self.code.push(0);
        } else if disp >= -128 && disp <= 127 {
            X86Encoder_modrm(self, 1, reg_code_val, 5);
            self.code.push(disp & 0xFF);
        } else {
            X86Encoder_modrm(self, 2, reg_code_val, 5);
            X86Encoder_emit_i32(self, disp);
        }
    } else {
        if disp == 0 {
            X86Encoder_modrm(self, 0, reg_code_val, base_code);
        } else if disp >= -128 && disp <= 127 {
            X86Encoder_modrm(self, 1, reg_code_val, base_code);
            self.code.push(disp & 0xFF);
        } else {
            X86Encoder_modrm(self, 2, reg_code_val, base_code);
            X86Encoder_emit_i32(self, disp);
        }
    }
}

// mov reg, [rbp + disp]
pub fn X86Encoder_mov_reg_mem_rbp(self: &mut X86Encoder, dst: i64, disp: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, false);
    self.code.push(0x8B);
    X86Encoder_emit_mem_rbp(self, reg_code(dst), disp);
}

// mov [rbp + disp], reg
pub fn X86Encoder_mov_mem_rbp_reg(self: &mut X86Encoder, disp: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, false);
    self.code.push(0x89);
    X86Encoder_emit_mem_rbp(self, reg_code(src), disp);
}

// lea reg, [rbp + disp]
pub fn X86Encoder_lea_rbp(self: &mut X86Encoder, dst: i64, disp: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, false);
    self.code.push(0x8D);
    X86Encoder_emit_mem_rbp(self, reg_code(dst), disp);
}

// lea reg, [rip + rdata_offset] -- patched later
pub fn X86Encoder_lea_rip(self: &mut X86Encoder, dst: i64, rdata_offset: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, false);
    self.code.push(0x8D);
    X86Encoder_modrm(self, 0, reg_code(dst), 5);
    self.pending_rip_refs.push(PendingRipRef_new(self.code.len(), rdata_offset));
    X86Encoder_emit_i32(self, 0);
}

// lea reg, [rip + label] -- patched later as code label
pub fn X86Encoder_lea_label(self: &mut X86Encoder, dst: i64, label: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, false);
    self.code.push(0x8D);
    X86Encoder_modrm(self, 0, reg_code(dst), 5);
    self.pending_labels.push(PendingReloc_new(self.code.len(), label, RELOC_LEA_LABEL));
    X86Encoder_emit_i32(self, 0);
}

// call [rip + rdata_offset] -- IAT indirect call
pub fn X86Encoder_call_rip(self: &mut X86Encoder, rdata_offset: i64) {
    self.code.push(0xFF);
    X86Encoder_modrm(self, 0, 2, 5);
    self.pending_rip_refs.push(PendingRipRef_new(self.code.len(), rdata_offset));
    X86Encoder_emit_i32(self, 0);
}

// jmp [rip + rdata_offset] -- IAT tail call (import trampoline)
pub fn X86Encoder_jmp_rip(self: &mut X86Encoder, rdata_offset: i64) {
    self.code.push(0xFF);
    X86Encoder_modrm(self, 0, 4, 5);
    self.pending_rip_refs.push(PendingRipRef_new(self.code.len(), rdata_offset));
    X86Encoder_emit_i32(self, 0);
}

// call rel32 (label)
pub fn X86Encoder_call_label(self: &mut X86Encoder, label: i64) {
    self.code.push(0xE8);
    self.pending_labels.push(PendingReloc_new(self.code.len(), label, RELOC_REL32));
    X86Encoder_emit_i32(self, 0);
}

// jmp rel32 (label)
pub fn X86Encoder_jmp_label(self: &mut X86Encoder, label: i64) {
    self.code.push(0xE9);
    self.pending_labels.push(PendingReloc_new(self.code.len(), label, RELOC_REL32));
    X86Encoder_emit_i32(self, 0);
}

// jcc rel32 (label) -- cc is condition code (0-15)
pub fn X86Encoder_jcc_label(self: &mut X86Encoder, cc: i64, label: i64) {
    self.code.push(0x0F);
    self.code.push(0x80 | (cc & 0xF));
    self.pending_labels.push(PendingReloc_new(self.code.len(), label, RELOC_REL32));
    X86Encoder_emit_i32(self, 0);
}

// call r64 (indirect)
pub fn X86Encoder_call_reg(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, false, false, false, reg_is_extended(r));
    self.code.push(0xFF);
    X86Encoder_modrm(self, 3, 2, reg_code(r));
}

// add r64, r64
pub fn X86Encoder_add_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(dst));
    self.code.push(0x01);
    X86Encoder_modrm_rr(self, src, dst);
}

// sub r64, r64
pub fn X86Encoder_sub_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(dst));
    self.code.push(0x29);
    X86Encoder_modrm_rr(self, src, dst);
}

// imul r64, r64
pub fn X86Encoder_imul_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x0F);
    self.code.push(0xAF);
    X86Encoder_modrm_rr(self, dst, src);
}

// idiv r64
pub fn X86Encoder_idiv_r(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xF7);
    X86Encoder_modrm(self, 3, 7, reg_code(r));
}

// div r64 (unsigned divide rdx:rax by r, rax=quotient, rdx=remainder)
pub fn X86Encoder_div_r(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xF7);
    X86Encoder_modrm(self, 3, 6, reg_code(r));
}

// and r64, r64
pub fn X86Encoder_and_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(dst));
    self.code.push(0x21);
    X86Encoder_modrm_rr(self, src, dst);
}

// or r64, r64
pub fn X86Encoder_or_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(dst));
    self.code.push(0x09);
    X86Encoder_modrm_rr(self, src, dst);
}

// xor r64, r64
pub fn X86Encoder_xor_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(dst));
    self.code.push(0x31);
    X86Encoder_modrm_rr(self, src, dst);
}

// not r64
pub fn X86Encoder_not_r(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xF7);
    X86Encoder_modrm(self, 3, 2, reg_code(r));
}

// neg r64
pub fn X86Encoder_neg_r(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xF7);
    X86Encoder_modrm(self, 3, 3, reg_code(r));
}

// cmp r64, r64
pub fn X86Encoder_cmp_rr(self: &mut X86Encoder, left: i64, right: i64) {
    X86Encoder_rex(self, true, reg_is_extended(right), false, reg_is_extended(left));
    self.code.push(0x3B);
    X86Encoder_modrm_rr(self, right, left);
}

// test r64, r64
pub fn X86Encoder_test_rr(self: &mut X86Encoder, left: i64, right: i64) {
    X86Encoder_rex(self, true, reg_is_extended(right), false, reg_is_extended(left));
    self.code.push(0x85);
    X86Encoder_modrm_rr(self, right, left);
}

// shl r64, cl
pub fn X86Encoder_shl_cl(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xD3);
    X86Encoder_modrm(self, 3, 4, reg_code(r));
}

// shl r64, imm8
pub fn X86Encoder_shl_r_i8(self: &mut X86Encoder, r: i64, count: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xC1);
    X86Encoder_modrm(self, 3, 4, reg_code(r));
    self.code.push(count & 0xFF);
}

// sar r64, cl
pub fn X86Encoder_sar_cl(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xD3);
    X86Encoder_modrm(self, 3, 7, reg_code(r));
}

// cqo (sign-extend RAX into RDX:RAX)
pub fn X86Encoder_cqo(self: &mut X86Encoder) {
    X86Encoder_rex_w(self);
    self.code.push(0x99);
}

// setcc r8
pub fn X86Encoder_setcc_r(self: &mut X86Encoder, cc: i64, r: i64) {
    X86Encoder_rex(self, false, false, false, reg_is_extended(r));
    self.code.push(0x0F);
    self.code.push(0x90 | (cc & 0xF));
    X86Encoder_modrm(self, 3, 0, reg_code(r));
}

// movzx r32, r8 (zero-extend byte to 32-bit)
pub fn X86Encoder_movzx_r32_r8(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, false, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x0F);
    self.code.push(0xB6);
    X86Encoder_modrm_rr(self, dst, src);
}

// movzx r32, r16 (zero-extend word to 32-bit)
pub fn X86Encoder_movzx_r32_r16(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, false, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x0F);
    self.code.push(0xB7);
    X86Encoder_modrm_rr(self, dst, src);
}

// movsxd r64, r32 (sign-extend 32 to 64)
pub fn X86Encoder_movsxd_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x63);
    X86Encoder_modrm_rr(self, dst, src);
}

// movsx r64, r8 (sign-extend byte to 64)
pub fn X86Encoder_movsx_r64_r8(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x0F);
    self.code.push(0xBE);
    X86Encoder_modrm_rr(self, dst, src);
}

// movsx r64, r16 (sign-extend word to 64)
pub fn X86Encoder_movsx_r64_r16(self: &mut X86Encoder, dst: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x0F);
    self.code.push(0xBF);
    X86Encoder_modrm_rr(self, dst, src);
}

// inc r64
pub fn X86Encoder_inc_r(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xFF);
    X86Encoder_modrm(self, 3, 0, reg_code(r));
}

// dec r64
pub fn X86Encoder_dec_r(self: &mut X86Encoder, r: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0xFF);
    X86Encoder_modrm(self, 3, 1, reg_code(r));
}

// sub rsp, imm8
pub fn X86Encoder_sub_rsp_i8(self: &mut X86Encoder, val: i64) {
    X86Encoder_rex_w(self);
    self.code.push(0x83);
    X86Encoder_modrm(self, 3, 5, 4);
    self.code.push(val & 0xFF);
}

// sub rsp, imm32
pub fn X86Encoder_sub_rsp_i32(self: &mut X86Encoder, val: i64) {
    X86Encoder_rex_w(self);
    self.code.push(0x81);
    X86Encoder_modrm(self, 3, 5, 4);
    X86Encoder_emit_i32(self, val);
}

// add rsp, imm8
pub fn X86Encoder_add_rsp_i8(self: &mut X86Encoder, val: i64) {
    X86Encoder_rex_w(self);
    self.code.push(0x83);
    X86Encoder_modrm(self, 3, 0, 4);
    self.code.push(val & 0xFF);
}

// add rsp, imm32
pub fn X86Encoder_add_rsp_i32(self: &mut X86Encoder, val: i64) {
    X86Encoder_rex_w(self);
    self.code.push(0x81);
    X86Encoder_modrm(self, 3, 0, 4);
    X86Encoder_emit_i32(self, val);
}

// add r64, imm32
pub fn X86Encoder_add_r_i32(self: &mut X86Encoder, r: i64, val: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0x81);
    X86Encoder_modrm(self, 3, 0, reg_code(r));
    X86Encoder_emit_i32(self, val);
}

// add r64, imm8
pub fn X86Encoder_add_r_i8(self: &mut X86Encoder, r: i64, val: i64) {
    X86Encoder_rex(self, true, false, false, reg_is_extended(r));
    self.code.push(0x83);
    X86Encoder_modrm(self, 3, 0, reg_code(r));
    self.code.push(val & 0xFF);
}

// imul r64, r64, imm32
pub fn X86Encoder_imul_r_r_imm32(self: &mut X86Encoder, dst: i64, src: i64, val: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(src));
    self.code.push(0x69);
    X86Encoder_modrm_rr(self, dst, src);
    X86Encoder_emit_i32(self, val);
}

// mov r8, imm8
pub fn X86Encoder_mov_r8_imm(self: &mut X86Encoder, r: i64, val: i64) {
    if reg_is_extended(r) {
        X86Encoder_rex(self, false, false, false, true);
    }
    self.code.push(0xB0 | reg_code(r));
    self.code.push(val & 0xFF);
}

// mov r64, [base]
pub fn X86Encoder_mov_reg_ptr(self: &mut X86Encoder, dst: i64, base: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(base));
    self.code.push(0x8B);
    X86Encoder_emit_mem_reg(self, reg_code(dst), base, 0);
}

// mov [base], r64
pub fn X86Encoder_mov_ptr_reg(self: &mut X86Encoder, base: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(base));
    self.code.push(0x89);
    X86Encoder_emit_mem_reg(self, reg_code(src), base, 0);
}

// mov [base], r32 (no REX.W)
pub fn X86Encoder_mov_ptr_reg32(self: &mut X86Encoder, base: i64, src: i64) {
    var need_rex: bool = reg_is_extended(base) || reg_is_extended(src);
    if need_rex {
        X86Encoder_rex(self, false, reg_is_extended(src), false, reg_is_extended(base));
    }
    self.code.push(0x89);
    X86Encoder_emit_mem_reg(self, reg_code(src), base, 0);
}

// mov r64, [base + disp]
pub fn X86Encoder_mov_reg_mem_disp(self: &mut X86Encoder, dst: i64, base: i64, disp: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), false, reg_is_extended(base));
    self.code.push(0x8B);
    X86Encoder_emit_mem_reg(self, reg_code(dst), base, disp);
}

// mov [base + disp], r64
pub fn X86Encoder_mov_mem_disp_reg(self: &mut X86Encoder, base: i64, disp: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), false, reg_is_extended(base));
    self.code.push(0x89);
    X86Encoder_emit_mem_reg(self, reg_code(src), base, disp);
}

// mov [base + disp], r32 (no REX.W)
pub fn X86Encoder_mov_mem_disp_reg32(self: &mut X86Encoder, base: i64, disp: i64, src: i64) {
    var need_rex: bool = reg_is_extended(base) || reg_is_extended(src);
    if need_rex {
        X86Encoder_rex(self, false, reg_is_extended(src), false, reg_is_extended(base));
    }
    self.code.push(0x89);
    X86Encoder_emit_mem_reg(self, reg_code(src), base, disp);
}

// mov r64, [base + index*1]
pub fn X86Encoder_mov_reg_mem_idx(self: &mut X86Encoder, dst: i64, base: i64, index: i64) {
    X86Encoder_rex(self, true, reg_is_extended(dst), reg_is_extended(index), reg_is_extended(base));
    self.code.push(0x8B);
    // SIB: scale=0, index, base
    X86Encoder_modrm(self, 0, reg_code(dst), 4);
    self.code.push((reg_code(index) << 3) | reg_code(base));
}

// mov [base + index*1], r64
pub fn X86Encoder_mov_mem_idx_reg(self: &mut X86Encoder, base: i64, index: i64, src: i64) {
    X86Encoder_rex(self, true, reg_is_extended(src), reg_is_extended(index), reg_is_extended(base));
    self.code.push(0x89);
    X86Encoder_modrm(self, 0, reg_code(src), 4);
    self.code.push((reg_code(index) << 3) | reg_code(base));
}

// mov r8, [base]
pub fn X86Encoder_mov_reg8_ptr(self: &mut X86Encoder, dst: i64, base: i64) {
    X86Encoder_rex(self, false, reg_is_extended(dst), false, reg_is_extended(base));
    self.code.push(0x8A);
    X86Encoder_emit_mem_reg(self, reg_code(dst), base, 0);
}

// mov [base], r8
pub fn X86Encoder_mov_mem_reg8_ptr(self: &mut X86Encoder, base: i64, src: i64) {
    X86Encoder_rex(self, false, reg_is_extended(src), false, reg_is_extended(base));
    self.code.push(0x88);
    X86Encoder_emit_mem_reg(self, reg_code(src), base, 0);
}

// mov [base + disp], r8
pub fn X86Encoder_mov_mem_disp_reg8(self: &mut X86Encoder, base: i64, disp: i64, src: i64) {
    X86Encoder_rex(self, false, reg_is_extended(src), false, reg_is_extended(base));
    self.code.push(0x88);
    X86Encoder_emit_mem_reg(self, reg_code(src), base, disp);
}

// mov [base + index*1], r8
pub fn X86Encoder_mov_mem_idx_reg8(self: &mut X86Encoder, base: i64, index: i64, src: i64) {
    X86Encoder_rex(self, false, reg_is_extended(src), reg_is_extended(index), reg_is_extended(base));
    self.code.push(0x88);
    X86Encoder_modrm(self, 0, reg_code(src), 4);
    self.code.push((reg_code(index) << 3) | reg_code(base));
}

// mov r8, [base + index*1]
pub fn X86Encoder_mov_reg8_mem_idx(self: &mut X86Encoder, dst: i64, base: i64, index: i64) {
    X86Encoder_rex(self, false, reg_is_extended(dst), reg_is_extended(index), reg_is_extended(base));
    self.code.push(0x8A);
    X86Encoder_modrm(self, 0, reg_code(dst), 4);
    self.code.push((reg_code(index) << 3) | reg_code(base));
}

// cmp r8, imm8
pub fn X86Encoder_cmp_r8_i8(self: &mut X86Encoder, r: i64, val: i64) {
    X86Encoder_rex(self, false, false, false, reg_is_extended(r));
    self.code.push(0x80);
    X86Encoder_modrm(self, 3, 7, reg_code(r));
    self.code.push(val & 0xFF);
}

// mov r32, [base] (no REX.W)
pub fn X86Encoder_mov_reg32_ptr(self: &mut X86Encoder, dst: i64, base: i64) {
    var need_rex: bool = reg_is_extended(base) || reg_is_extended(dst);
    if need_rex {
        X86Encoder_rex(self, false, reg_is_extended(dst), false, reg_is_extended(base));
    }
    self.code.push(0x8B);
    X86Encoder_emit_mem_reg(self, reg_code(dst), base, 0);
}

// --- SSE2 float instructions --------------------------------------------
// movsd xmm, [rbp + disp]
pub fn X86Encoder_movsd_xmm_mem_rbp(self: &mut X86Encoder, xmm: i64, disp: i64) {
    self.code.push(0xF2);
    X86Encoder_rex_w(self);
    self.code.push(0x0F);
    self.code.push(0x10);
    X86Encoder_emit_mem_rbp(self, xmm & 7, disp);
}

// movsd [rbp + disp], xmm
pub fn X86Encoder_movsd_mem_rbp_xmm(self: &mut X86Encoder, disp: i64, xmm: i64) {
    self.code.push(0xF2);
    X86Encoder_rex_w(self);
    self.code.push(0x0F);
    self.code.push(0x11);
    X86Encoder_emit_mem_rbp(self, xmm & 7, disp);
}

// addsd xmm, xmm
pub fn X86Encoder_addsd(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0xF2);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x58);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// subsd xmm, xmm
pub fn X86Encoder_subsd(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0xF2);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x5C);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// mulsd xmm, xmm
pub fn X86Encoder_mulsd(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0xF2);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x59);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// divsd xmm, xmm
pub fn X86Encoder_divsd(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0xF2);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x5E);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// --- SSE2 packed double-precision (f64x2) instructions ---
// These operate on XMM registers. Encoding: 66 0F <opcode> ModR/M
// For register-to-register: ModR/M = 11 (mod) | reg (dst) | rm (src)

// addpd xmm_dst, xmm_src — SSE2 packed double add
// Encoding: 66 0F 58 ModR/M
pub fn X86Encoder_addpd_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0x66);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x58);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// subpd xmm_dst, xmm_src — SSE2 packed double subtract
// Encoding: 66 0F 5C ModR/M
pub fn X86Encoder_subpd_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0x66);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x5C);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// mulpd xmm_dst, xmm_src — SSE2 packed double multiply
// Encoding: 66 0F 59 ModR/M
pub fn X86Encoder_mulpd_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0x66);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x59);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// divpd xmm_dst, xmm_src — SSE2 packed double divide
// Encoding: 66 0F 5E ModR/M
pub fn X86Encoder_divpd_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0x66);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x5E);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// movapd xmm_dst, xmm_src — SSE2 move aligned packed double
// Encoding: 66 0F 28 ModR/M
pub fn X86Encoder_movapd_rr(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0x66);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x28);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// movapd xmm_dst, [rbp+disp] — SSE2 load from memory
// Encoding: 66 0F 28 ModR/M(mod=01|10, reg=dst, rm=rbp)
pub fn X86Encoder_movapd_rbp_reg(self: &mut X86Encoder, dst: i64, disp: i64) {
    self.code.push(0x66);
    if dst >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, false);
    }
    self.code.push(0x0F);
    self.code.push(0x28);
    X86Encoder_emit_mem_rbp(self, dst & 7, disp);
}

// movapd [rbp+disp], xmm_src — SSE2 store to memory
// Encoding: 66 0F 29 ModR/M(mod=01|10, reg=src, rm=rbp)
pub fn X86Encoder_movapd_mem_rbp(self: &mut X86Encoder, disp: i64, src: i64) {
    self.code.push(0x66);
    if src >= 8 {
        X86Encoder_rex(self, false, false, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x29);
    X86Encoder_emit_mem_rbp(self, src & 7, disp);
}

// xorpd xmm, [rbp + disp]
pub fn X86Encoder_xorpd_xmm_mem_rbp(self: &mut X86Encoder, xmm: i64, disp: i64) {
    self.code.push(0x66);
    X86Encoder_rex_w(self);
    self.code.push(0x0F);
    self.code.push(0x57);
    X86Encoder_emit_mem_rbp(self, xmm & 7, disp);
}

// xorpd xmm, xmm
pub fn X86Encoder_xorpd_xmm_xmm(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0x66);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x57);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// movq xmm, r64 (movd with REX.W)
pub fn X86Encoder_movq_xmm_r64(self: &mut X86Encoder, xmm: i64, r: i64) {
    self.code.push(0x66);
    X86Encoder_rex(self, true, xmm >= 8, false, reg_is_extended(r));
    self.code.push(0x0F);
    self.code.push(0x6E);
    X86Encoder_modrm(self, 3, xmm & 7, reg_code(r));
}

// ucomisd xmm, xmm
pub fn X86Encoder_ucomisd(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0x66);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x2E);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// cvtsi2sd xmm, r64
pub fn X86Encoder_cvtsi2sd_r64(self: &mut X86Encoder, xmm: i64, r: i64) {
    self.code.push(0xF2);
    X86Encoder_rex(self, true, xmm >= 8, false, reg_is_extended(r));
    self.code.push(0x0F);
    self.code.push(0x2A);
    X86Encoder_modrm(self, 3, xmm & 7, reg_code(r));
}

// cvttsd2si r64, xmm
pub fn X86Encoder_cvttsd2si_r64(self: &mut X86Encoder, r: i64, xmm: i64) {
    self.code.push(0xF2);
    X86Encoder_rex(self, true, reg_is_extended(r), false, xmm >= 8);
    self.code.push(0x0F);
    self.code.push(0x2C);
    X86Encoder_modrm(self, 3, reg_code(r), xmm & 7);
}

// movss xmm, [rbp + disp]
pub fn X86Encoder_movss_xmm_mem_rbp(self: &mut X86Encoder, xmm: i64, disp: i64) {
    self.code.push(0xF3);
    X86Encoder_rex_w(self);
    self.code.push(0x0F);
    self.code.push(0x10);
    X86Encoder_emit_mem_rbp(self, xmm & 7, disp);
}

// movss [rbp + disp], xmm
pub fn X86Encoder_movss_mem_rbp_xmm(self: &mut X86Encoder, disp: i64, xmm: i64) {
    self.code.push(0xF3);
    X86Encoder_rex_w(self);
    self.code.push(0x0F);
    self.code.push(0x11);
    X86Encoder_emit_mem_rbp(self, xmm & 7, disp);
}

// addss xmm, xmm
pub fn X86Encoder_addss(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0xF3);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x58);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// ucomiss xmm, xmm
pub fn X86Encoder_ucomiss(self: &mut X86Encoder, dst: i64, src: i64) {
    self.code.push(0xF3);
    if dst >= 8 || src >= 8 {
        X86Encoder_rex(self, false, dst >= 8, false, src >= 8);
    }
    self.code.push(0x0F);
    self.code.push(0x2E);
    X86Encoder_modrm(self, 3, dst & 7, src & 7);
}

// --- Label resolution ---------------------------------------------------
// Patch all pending label relocations (Rel32 and LeaLabel)
pub fn X86Encoder_resolve_labels(self: &mut X86Encoder) {
    var i: i64 = 0;
    while i < self.pending_labels.len() {
        var reloc: PendingReloc = self.pending_labels.get(i);
        var target_offset: i64 = self.labels.get(reloc.target_label);
        if target_offset < 0 {
            // Unresolved label -- skip (will crash at runtime if hit)
            i = i + 1;
            continue;
        }
        var disp: i64 = target_offset - (reloc.code_offset + 4);
        // Patch 4 bytes at code_offset
        self.code.set(reloc.code_offset, disp & 0xFF);
        self.code.set(reloc.code_offset + 1, (disp >> 8) & 0xFF);
        self.code.set(reloc.code_offset + 2, (disp >> 16) & 0xFF);
        self.code.set(reloc.code_offset + 3, (disp >> 24) & 0xFF);
        i = i + 1;
    }
}

// Patch all pending RIP-relative references to .rdata
pub fn X86Encoder_resolve_rip_refs(self: &mut X86Encoder, text_rva: i64, rdata_rva: i64) {
    var i: i64 = 0;
    while i < self.pending_rip_refs.len() {
        var ref_: PendingRipRef = self.pending_rip_refs.get(i);
        var target_rva: i64 = rdata_rva + ref_.rdata_offset;
        var code_rva: i64 = text_rva + ref_.code_offset;
        var disp: i64 = target_rva - (code_rva + 4);
        self.code.set(ref_.code_offset, disp & 0xFF);
        self.code.set(ref_.code_offset + 1, (disp >> 8) & 0xFF);
        self.code.set(ref_.code_offset + 2, (disp >> 16) & 0xFF);
        self.code.set(ref_.code_offset + 3, (disp >> 24) & 0xFF);
        i = i + 1;
    }
}

// --- RdataBuilder: builds .rdata section (strings + import table) -------
pub struct RdataBuilder {
    pub data: Vec,                    // raw .rdata bytes (Vec<i64>)
    pub iat_offsets: Vec,             // .rdata offset of each IAT entry
    pub import_dir_offset: i64,      // .rdata offset of import descriptor
    pub string_keys: Vec<str>,        // string content for dedup
    pub string_vals: Vec,             // offsets for dedup (parallel)
    pub ilt_offset: i64,             // .rdata offset of ILT
    pub iat_offset: i64,             // .rdata offset of IAT
    pub dll_name_off: i64,           // .rdata offset of "kernel32.dll"
    pub import_by_name_offsets: Vec, // .rdata offset of each IMPORT_BY_NAME
}

pub fn RdataBuilder_new() -> RdataBuilder {
    return RdataBuilder {
        data: Vec::new(),
        iat_offsets: Vec::new(),
        import_dir_offset: 0,
        string_keys: Vec::new(),
        string_vals: Vec::new(),
        ilt_offset: 0,
        iat_offset: 0,
        dll_name_off: 0,
        import_by_name_offsets: Vec::new(),
    };
}

// Add a string to .rdata, return its offset. Dedup by content.
pub fn RdataBuilder_add_string(self: &mut RdataBuilder, s: str) -> i64 {
    var i: i64 = 0;
    while i < self.string_keys.len() {
        if self.string_keys.get(i) == s {
            return self.string_vals.get(i);
        }
        i = i + 1;
    }
    var offset: i64 = self.data.len();
    var bytes: Vec = str_bytes(s);
    var j: i64 = 0;
    while j < bytes.len() {
        self.data.push(bytes.get(j));
        j = j + 1;
    }
    self.data.push(0);
    self.string_keys.push(s);
    self.string_vals.push(offset);
    return offset;
}

// Build import tables (ILT + IAT + by-name entries + descriptor) for a
// dynamic list of kernel32 import names.  The six runtime imports used by
// the stub layer are always emitted first so the IAT_* constants stay valid.
// Returns name -> IAT .rdata offset entries for each caller-supplied name.
pub fn RdataBuilder_build_imports(self: &mut RdataBuilder, extra_names: Vec<str>) -> Vec<NameOff> {
    var out: Vec<NameOff> = Vec::new();

    // 1. DLL name
    self.dll_name_off = self.data.len();
    var dll_bytes: Vec = str_bytes("kernel32.dll");
    var j: i64 = 0;
    while j < dll_bytes.len() {
        self.data.push(dll_bytes.get(j));
        j = j + 1;
    }
    self.data.push(0);

    // 2. IMAGE_IMPORT_BY_NAME entries — fixed six first, then caller's
    var import_names: Vec<str> = Vec::new();
    import_names.push("GetStdHandle");
    import_names.push("WriteFile");
    import_names.push("ExitProcess");
    import_names.push("GetProcessHeap");
    import_names.push("HeapAlloc");
    import_names.push("HeapFree");
    var en: i64 = 0;
    while en < extra_names.len() {
        var dup: bool = false;
        var di: i64 = 0;
        while di < import_names.len() {
            if import_names.get(di) == extra_names.get(en) { dup = true; }
            di = di + 1;
        }
        if !dup { import_names.push(extra_names.get(en)); }
        en = en + 1;
    }
    var extra_start: i64 = 6;

    var k: i64 = 0;
    while k < import_names.len() {
        var off: i64 = self.data.len();
        self.import_by_name_offsets.push(off);
        self.data.push(0); // hint (2 bytes)
        self.data.push(0);
        var name_bytes: Vec = str_bytes(import_names.get(k));
        var m: i64 = 0;
        while m < name_bytes.len() {
            self.data.push(name_bytes.get(m));
            m = m + 1;
        }
        self.data.push(0); // null terminator
        k = k + 1;
    }

    // 4. Pad to 8-byte alignment
    while self.data.len() % 8 != 0 {
        self.data.push(0);
    }

    // 5. Import Lookup Table (ILT)
    self.ilt_offset = self.data.len();
    k = 0;
    while k < import_names.len() {
        // Placeholder RVA -- patched later by patch_rvas
        self.data.push(0); self.data.push(0); self.data.push(0); self.data.push(0);
        self.data.push(0); self.data.push(0); self.data.push(0); self.data.push(0);
        k = k + 1;
    }
    // Null terminator
    self.data.push(0); self.data.push(0); self.data.push(0); self.data.push(0);
    self.data.push(0); self.data.push(0); self.data.push(0); self.data.push(0);

    // 6. Import Address Table (IAT)
    self.iat_offset = self.data.len();
    k = 0;
    while k < import_names.len() {
        var iat_off: i64 = self.data.len();
        self.iat_offsets.push(iat_off);
        // Placeholder RVA -- patched later
        self.data.push(0); self.data.push(0); self.data.push(0); self.data.push(0);
        self.data.push(0); self.data.push(0); self.data.push(0); self.data.push(0);
        k = k + 1;
    }
    // Null terminator
    self.data.push(0); self.data.push(0); self.data.push(0); self.data.push(0);
    self.data.push(0); self.data.push(0); self.data.push(0); self.data.push(0);

    // 7. Pad to 4-byte alignment
    while self.data.len() % 4 != 0 {
        self.data.push(0);
    }

    // 8. Import Directory Table (20 bytes + 20 null)
    self.import_dir_offset = self.data.len();
    // Descriptor (20 bytes of placeholders -- patched later)
    var d: i64 = 0;
    while d < 20 {
        self.data.push(0);
        d = d + 1;
    }
    // Null descriptor (20 bytes)
    d = 0;
    while d < 20 {
        self.data.push(0);
        d = d + 1;
    }

    // Map caller-supplied names to their IAT .rdata offsets
    var e2: i64 = 0;
    while e2 < extra_names.len() {
        var found: i64 = -1;
        var ni: i64 = 0;
        while ni < import_names.len() {
            if import_names.get(ni) == extra_names.get(e2) {
                found = self.iat_offsets.get(ni);
            }
            ni = ni + 1;
        }
        out.push(NameOff_new(extra_names.get(e2), found));
        e2 = e2 + 1;
    }
    return out;
}

// Patch RVAs in the import table after .rdata location is known
pub fn RdataBuilder_patch_rvas(self: &mut RdataBuilder, rdata_rva: i64) {
    var num_imports: i64 = self.import_by_name_offsets.len();

    // Patch ILT entries: each = rdata_rva + import_by_name_offsets[i]
    var i: i64 = 0;
    while i < num_imports {
        var ilt_pos: i64 = self.ilt_offset + i * 8;
        var rva: i64 = rdata_rva + self.import_by_name_offsets.get(i);
        self.data.set(ilt_pos, rva & 0xFF);
        self.data.set(ilt_pos + 1, (rva >> 8) & 0xFF);
        self.data.set(ilt_pos + 2, (rva >> 16) & 0xFF);
        self.data.set(ilt_pos + 3, (rva >> 24) & 0xFF);
        self.data.set(ilt_pos + 4, 0);
        self.data.set(ilt_pos + 5, 0);
        self.data.set(ilt_pos + 6, 0);
        self.data.set(ilt_pos + 7, 0);
        i = i + 1;
    }

    // Patch IAT entries: each = rdata_rva + import_by_name_offsets[i]
    i = 0;
    while i < num_imports {
        var iat_pos: i64 = self.iat_offset + i * 8;
        var rva: i64 = rdata_rva + self.import_by_name_offsets.get(i);
        self.data.set(iat_pos, rva & 0xFF);
        self.data.set(iat_pos + 1, (rva >> 8) & 0xFF);
        self.data.set(iat_pos + 2, (rva >> 16) & 0xFF);
        self.data.set(iat_pos + 3, (rva >> 24) & 0xFF);
        self.data.set(iat_pos + 4, 0);
        self.data.set(iat_pos + 5, 0);
        self.data.set(iat_pos + 6, 0);
        self.data.set(iat_pos + 7, 0);
        i = i + 1;
    }

    // Patch import descriptor
    var dir_pos: i64 = self.import_dir_offset;
    var ilt_rva: i64 = rdata_rva + self.ilt_offset;
    var dll_rva: i64 = rdata_rva + self.dll_name_off;
    var iat_rva: i64 = rdata_rva + self.iat_offset;

    // OriginalFirstThunk (offset +0) = ILT RVA
    self.data.set(dir_pos, ilt_rva & 0xFF);
    self.data.set(dir_pos + 1, (ilt_rva >> 8) & 0xFF);
    self.data.set(dir_pos + 2, (ilt_rva >> 16) & 0xFF);
    self.data.set(dir_pos + 3, (ilt_rva >> 24) & 0xFF);
    // TimeDateStamp (offset +4) = 0
    // ForwarderChain (offset +8) = 0
    // Name (offset +12) = DLL name RVA
    self.data.set(dir_pos + 12, dll_rva & 0xFF);
    self.data.set(dir_pos + 13, (dll_rva >> 8) & 0xFF);
    self.data.set(dir_pos + 14, (dll_rva >> 16) & 0xFF);
    self.data.set(dir_pos + 15, (dll_rva >> 24) & 0xFF);
    // FirstThunk (offset +16) = IAT RVA
    self.data.set(dir_pos + 16, iat_rva & 0xFF);
    self.data.set(dir_pos + 17, (iat_rva >> 8) & 0xFF);
    self.data.set(dir_pos + 18, (iat_rva >> 16) & 0xFF);
    self.data.set(dir_pos + 19, (iat_rva >> 24) & 0xFF);
}

// --- PE file constants --------------------------------------------------
pub const IMAGE_BASE: i64 = 0x140000000;
pub const SECTION_ALIGN: i64 = 0x1000;
pub const FILE_ALIGN: i64 = 0x200;
pub const TEXT_RVA: i64 = 0x1000;

// IAT indices
pub const IAT_GET_STD_HANDLE: i64 = 0;
pub const IAT_WRITE_FILE: i64 = 1;
pub const IAT_EXIT_PROCESS: i64 = 2;
pub const IAT_GET_PROCESS_HEAP: i64 = 3;
pub const IAT_HEAP_ALLOC: i64 = 4;
pub const IAT_HEAP_FREE: i64 = 5;

// Align value up to alignment
pub fn align_up(val: i64, align_: i64) -> i64 {
    return (val + align_ - 1) & ~(align_ - 1);
}

// Build the complete PE file from text + rdata sections
pub fn build_pe_file(text: Vec, rdata: Vec, entry_point_rva: i64, import_dir_rva: i64, iat_rva: i64, iat_size: i64, rdata_rva: i64) -> Vec {
    var pe: Vec = Vec::new();

    var header_size: i64 = align_up(64 + 4 + 20 + 240 + 2 * 40, FILE_ALIGN);
    var text_raw_size: i64 = align_up(text.len(), FILE_ALIGN);
    var rdata_raw_size: i64 = align_up(rdata.len(), FILE_ALIGN);
    var text_virt_size: i64 = align_up(text.len(), SECTION_ALIGN);
    var rdata_virt_size: i64 = align_up(rdata.len(), SECTION_ALIGN);
    var size_of_image: i64 = align_up(header_size, SECTION_ALIGN) + text_virt_size + rdata_virt_size;

    // --- DOS Header (64 bytes) ---
    pe.push(0x4D); pe.push(0x5A); // e_magic "MZ"
    pe.push(0x90); pe.push(0x00); // e_cblp
    pe.push(0x03); pe.push(0x00); // e_cp
    pe.push(0x00); pe.push(0x00); // e_crlc
    pe.push(0x04); pe.push(0x00); // e_cparhdr
    pe.push(0x00); pe.push(0x00); // e_minalloc
    pe.push(0xFF); pe.push(0xFF); // e_maxalloc
    pe.push(0x00); pe.push(0x00); // e_ss
    pe.push(0xB8); pe.push(0x00); // e_sp
    pe.push(0x00); pe.push(0x00); // e_csum
    pe.push(0x00); pe.push(0x00); // e_ip
    pe.push(0x00); pe.push(0x00); // e_cs
    pe.push(0x40); pe.push(0x00); // e_lfarlc
    pe.push(0x00); pe.push(0x00); // e_ovno
    var i: i64 = 0;
    while i < 8 { pe.push(0); i = i + 1; } // e_res (8 bytes)
    pe.push(0x00); pe.push(0x00); // e_oemid
    pe.push(0x00); pe.push(0x00); // e_oeminfo
    i = 0;
    while i < 20 { pe.push(0); i = i + 1; } // e_res2 (20 bytes)
    // e_lfanew = 64
    pe.push(0x40); pe.push(0x00); pe.push(0x00); pe.push(0x00);

    // --- PE Signature (4 bytes) ---
    pe.push(0x50); pe.push(0x45); pe.push(0x00); pe.push(0x00); // "PE\0\0"

    // --- COFF Header (20 bytes) ---
    pe.push(0x64); pe.push(0x86); // Machine = AMD64
    pe.push(0x02); pe.push(0x00); // NumberOfSections = 2
    pe.push(0x00); pe.push(0x00); pe.push(0x00); pe.push(0x00); // TimeDateStamp
    pe.push(0x00); pe.push(0x00); pe.push(0x00); pe.push(0x00); // PointerToSymbolTable
    pe.push(0x00); pe.push(0x00); pe.push(0x00); pe.push(0x00); // NumberOfSymbols
    pe.push(0xF0); pe.push(0x00); // SizeOfOptionalHeader = 240
    pe.push(0x22); pe.push(0x00); // Characteristics

    // --- Optional Header (240 bytes) ---
    // Standard fields
    pe.push(0x0B); pe.push(0x02); // Magic = PE32+
    pe.push(0x0E); // MajorLinkerVersion
    pe.push(0x00); // MinorLinkerVersion
    // SizeOfCode
    pe.push(text_raw_size & 0xFF); pe.push((text_raw_size >> 8) & 0xFF); pe.push((text_raw_size >> 16) & 0xFF); pe.push((text_raw_size >> 24) & 0xFF);
    // SizeOfInitializedData
    pe.push(rdata_raw_size & 0xFF); pe.push((rdata_raw_size >> 8) & 0xFF); pe.push((rdata_raw_size >> 16) & 0xFF); pe.push((rdata_raw_size >> 24) & 0xFF);
    // SizeOfUninitializedData
    pe.push(0); pe.push(0); pe.push(0); pe.push(0);
    // AddressOfEntryPoint
    pe.push(entry_point_rva & 0xFF); pe.push((entry_point_rva >> 8) & 0xFF); pe.push((entry_point_rva >> 16) & 0xFF); pe.push((entry_point_rva >> 24) & 0xFF);
    // BaseOfCode
    pe.push(0x00); pe.push(0x10); pe.push(0x00); pe.push(0x00); // TEXT_RVA

    // Windows-specific fields
    // ImageBase (8 bytes)
    i = 0;
    while i < 8 {
        pe.push((IMAGE_BASE >> (i * 8)) & 0xFF);
        i = i + 1;
    }
    // SectionAlignment
    pe.push(0x00); pe.push(0x10); pe.push(0x00); pe.push(0x00);
    // FileAlignment
    pe.push(0x00); pe.push(0x02); pe.push(0x00); pe.push(0x00);
    // MajorOSVersion
    pe.push(0x06); pe.push(0x00);
    // MinorOSVersion
    pe.push(0x00); pe.push(0x00);
    // MajorImageVersion
    pe.push(0x00); pe.push(0x00);
    // MinorImageVersion
    pe.push(0x00); pe.push(0x00);
    // MajorSubsystemVersion
    pe.push(0x06); pe.push(0x00);
    // MinorSubsystemVersion
    pe.push(0x00); pe.push(0x00);
    // Win32VersionValue
    pe.push(0); pe.push(0); pe.push(0); pe.push(0);
    // SizeOfImage
    pe.push(size_of_image & 0xFF); pe.push((size_of_image >> 8) & 0xFF); pe.push((size_of_image >> 16) & 0xFF); pe.push((size_of_image >> 24) & 0xFF);
    // SizeOfHeaders
    pe.push(0x00); pe.push(0x02); pe.push(0x00); pe.push(0x00); // 512
    // CheckSum
    pe.push(0); pe.push(0); pe.push(0); pe.push(0);
    // Subsystem = CONSOLE
    pe.push(0x03); pe.push(0x00);
    // DllCharacteristics
    pe.push(0x00); pe.push(0x00);
    // SizeOfStackReserve (8 bytes)
    pe.push(0x00); pe.push(0x00); pe.push(0x10); pe.push(0x00); pe.push(0x00); pe.push(0x00); pe.push(0x00); pe.push(0x00);
    // SizeOfStackCommit (8 bytes)
    pe.push(0x00); pe.push(0x10); pe.push(0x00); pe.push(0x00); pe.push(0x00); pe.push(0x00); pe.push(0x00); pe.push(0x00);
    // SizeOfHeapReserve (8 bytes)
    pe.push(0x00); pe.push(0x00); pe.push(0x10); pe.push(0x00); pe.push(0x00); pe.push(0x00); pe.push(0x00); pe.push(0x00);
    // SizeOfHeapCommit (8 bytes)
    pe.push(0x00); pe.push(0x10); pe.push(0x00); pe.push(0x00); pe.push(0x00); pe.push(0x00); pe.push(0x00); pe.push(0x00);
    // LoaderFlags
    pe.push(0); pe.push(0); pe.push(0); pe.push(0);
    // NumberOfRvaAndSizes = 16
    pe.push(0x10); pe.push(0x00); pe.push(0x00); pe.push(0x00);

    // Data directories (16 entries x 8 bytes = 128 bytes)
    // Entry 0: Export -- empty
    i = 0;
    while i < 8 { pe.push(0); i = i + 1; }
    // Entry 1: Import
    pe.push(import_dir_rva & 0xFF); pe.push((import_dir_rva >> 8) & 0xFF); pe.push((import_dir_rva >> 16) & 0xFF); pe.push((import_dir_rva >> 24) & 0xFF);
    pe.push(0x14); pe.push(0x00); pe.push(0x00); pe.push(0x00); // size = 20
    // Entries 2-11: empty (10 entries x 8 bytes)
    i = 0;
    while i < 10 {
        var j: i64 = 0;
        while j < 8 { pe.push(0); j = j + 1; }
        i = i + 1;
    }
    // Entry 12: IAT
    pe.push(iat_rva & 0xFF); pe.push((iat_rva >> 8) & 0xFF); pe.push((iat_rva >> 16) & 0xFF); pe.push((iat_rva >> 24) & 0xFF);
    pe.push(iat_size & 0xFF); pe.push((iat_size >> 8) & 0xFF); pe.push((iat_size >> 16) & 0xFF); pe.push((iat_size >> 24) & 0xFF);
    // Entries 13-15: empty (3 entries x 8 bytes)
    i = 0;
    while i < 3 {
        var j: i64 = 0;
        while j < 8 { pe.push(0); j = j + 1; }
        i = i + 1;
    }

    // --- Section Headers (2 x 40 bytes) ---
    // .text section
    pe.push(0x2E); pe.push(0x74); pe.push(0x65); pe.push(0x78); pe.push(0x74); pe.push(0x00); pe.push(0x00); pe.push(0x00); // ".text\0\0\0"
    pe.push(text_virt_size & 0xFF); pe.push((text_virt_size >> 8) & 0xFF); pe.push((text_virt_size >> 16) & 0xFF); pe.push((text_virt_size >> 24) & 0xFF);
    pe.push(0x00); pe.push(0x10); pe.push(0x00); pe.push(0x00); // VirtualAddress = TEXT_RVA
    pe.push(text_raw_size & 0xFF); pe.push((text_raw_size >> 8) & 0xFF); pe.push((text_raw_size >> 16) & 0xFF); pe.push((text_raw_size >> 24) & 0xFF);
    pe.push(0x00); pe.push(0x02); pe.push(0x00); pe.push(0x00); // PointerToRawData = FILE_ALIGN
    pe.push(0); pe.push(0); pe.push(0); pe.push(0); // PointerToRelocations
    pe.push(0); pe.push(0); pe.push(0); pe.push(0); // PointerToLinenumbers
    pe.push(0); pe.push(0); // NumberOfRelocations
    pe.push(0); pe.push(0); // NumberOfLinenumbers
    pe.push(0x20); pe.push(0x00); pe.push(0x00); pe.push(0x60); // Characteristics = CODE|EXECUTE|READ

    // .rdata section
    pe.push(0x2E); pe.push(0x72); pe.push(0x64); pe.push(0x61); pe.push(0x74); pe.push(0x61); pe.push(0x00); pe.push(0x00); // ".rdata\0\0"
    pe.push(rdata_virt_size & 0xFF); pe.push((rdata_virt_size >> 8) & 0xFF); pe.push((rdata_virt_size >> 16) & 0xFF); pe.push((rdata_virt_size >> 24) & 0xFF);
    pe.push(rdata_rva & 0xFF); pe.push((rdata_rva >> 8) & 0xFF); pe.push((rdata_rva >> 16) & 0xFF); pe.push((rdata_rva >> 24) & 0xFF);
    pe.push(rdata_raw_size & 0xFF); pe.push((rdata_raw_size >> 8) & 0xFF); pe.push((rdata_raw_size >> 16) & 0xFF); pe.push((rdata_raw_size >> 24) & 0xFF);
    var rdata_raw_ptr: i64 = FILE_ALIGN + text_raw_size;
    pe.push(rdata_raw_ptr & 0xFF); pe.push((rdata_raw_ptr >> 8) & 0xFF); pe.push((rdata_raw_ptr >> 16) & 0xFF); pe.push((rdata_raw_ptr >> 24) & 0xFF);
    pe.push(0); pe.push(0); pe.push(0); pe.push(0); // PointerToRelocations
    pe.push(0); pe.push(0); pe.push(0); pe.push(0); // PointerToLinenumbers
    pe.push(0); pe.push(0); // NumberOfRelocations
    pe.push(0); pe.push(0); // NumberOfLinenumbers
    pe.push(0x40); pe.push(0x00); pe.push(0x00); pe.push(0xC0); // Characteristics = INITIALIZED_DATA|READ|WRITE

    // --- Pad headers to FILE_ALIGN ---
    while pe.len() < header_size {
        pe.push(0);
    }

    // --- .text section ---
    i = 0;
    while i < text.len() {
        pe.push(text.get(i));
        i = i + 1;
    }
    // Pad text to FILE_ALIGN
    while pe.len() < header_size + text_raw_size {
        pe.push(0);
    }

    // --- .rdata section ---
    i = 0;
    while i < rdata.len() {
        pe.push(rdata.get(i));
        i = i + 1;
    }
    // Pad rdata to FILE_ALIGN
    while pe.len() < header_size + text_raw_size + rdata_raw_size {
        pe.push(0);
    }

    return pe;
}

// Reference from the enc stream into assembled user code (resolved late,
// once the final .text layout is known).
pub struct PendingUserRef {
    pub code_off: i64,   // offset of the displacement/imm field in enc.code
    pub name: str,       // user-code symbol name
    pub kind: i64,       // PREF_REL32 | PREF_ABS64
}
pub fn PendingUserRef_new(code_off: i64, name: str, kind: i64) -> PendingUserRef {
    return PendingUserRef { code_off: code_off, name: name, kind: kind };
}
pub const PREF_REL32: i64 = 0;
pub const PREF_ABS64: i64 = 1;

// --- PeCodeGen: runtime stub layer generator -----------------------------
// Emits the machine-code runtime stubs (the PE runtime) plus thin wrappers
// that adapt them to the SysV ABI used by codegen_x64-generated user code.
pub struct PeCodeGen {
    pub enc: X86Encoder,
    pub func_names: Vec<str>,
    pub func_label_ids: Vec,
    pub string_keys: Vec<str>,
    pub string_vals: Vec,
    pub iat_rdata_offsets: Vec,
    pub block_labels: Vec,
    pub entry_offset: i64,
    pub bare_mode: bool,
    pub main_offset: i64,
    // Module-level mutable globals: name -> rdata offset
    pub global_names: Vec<str>,
    pub global_rdata_offsets: Vec,
    // @cpu_local globals: name -> GS-relative offset (per-CPU storage)
    pub cpu_local_names: Vec<str>,
    pub cpu_local_offsets: Vec,
    // Current function is an interrupt handler (affects return epilogue)
    pub cur_is_interrupt: bool,
    // Current function is naked (no prologue/epilogue)
    pub cur_is_naked: bool,
    // Calls/addresses into assembled user code, patched by pe_build
    pub pending_ucalls: Vec<PendingUserRef>,
}

pub fn PeCodeGen_new() -> PeCodeGen {
    return PeCodeGen {
        enc: X86Encoder_new(),
        func_names: Vec::new(),
        func_label_ids: Vec::new(),
        string_keys: Vec::new(),
        string_vals: Vec::new(),
        iat_rdata_offsets: Vec::new(),
        block_labels: Vec::new(),
        entry_offset: 0,
        bare_mode: false,
        main_offset: -1,
        global_names: Vec::new(),
        global_rdata_offsets: Vec::new(),
        cpu_local_names: Vec::new(),
        cpu_local_offsets: Vec::new(),
        cur_is_interrupt: false,
        cur_is_naked: false,
        pending_ucalls: Vec::new(),
    };
}

// Emit `call <user function>` — resolved against the assembled user code.
pub fn PeCodeGen_emit_call_user(self: &mut PeCodeGen, name: str) {
    self.enc.code.push(0xE8);
    self.pending_ucalls.push(PendingUserRef_new(self.enc.code.len(), name, PREF_REL32));
    X86Encoder_emit_i32(&mut self.enc, 0);
}

// Emit `mov <reg>, imm64 <user function address>` (absolute).
pub fn PeCodeGen_emit_mov_user_imm64(self: &mut PeCodeGen, reg: i64, name: str) {
    X86Encoder_rex_w(&mut self.enc);
    self.enc.code.push(0xB8 + reg_code(reg));
    self.pending_ucalls.push(PendingUserRef_new(self.enc.code.len(), name, PREF_ABS64));
    X86Encoder_emit_u64(&mut self.enc, 0);
}

// Look up a function label by name
pub fn PeCodeGen_get_func_label(self: &PeCodeGen, name: str) -> i64 {
    var i: i64 = 0;
    while i < self.func_names.len() {
        if self.func_names.get(i) == name {
            return self.func_label_ids.get(i);
        }
        i = i + 1;
    }
    return -1;
}

// Check if a function exists by name
pub fn PeCodeGen_has_func(self: &PeCodeGen, name: str) -> bool {
    return PeCodeGen_get_func_label(self, name) >= 0;
}

// Check if a global name is @cpu_local and return its GS-relative offset.
pub fn PeCodeGen_get_cpu_local_offset(self: &PeCodeGen, name: str) -> i64 {
    var i: i64 = 0;
    while i < self.cpu_local_names.len() {
        if self.cpu_local_names.get(i) == name {
            return self.cpu_local_offsets.get(i);
        }
        i = i + 1;
    }
    return -1;
}

// ─── GS segment helpers (for @cpu_local per-CPU storage) ──────────────────
pub fn X86Encoder_mov_rax_gs(self: &mut X86Encoder, offset: i64) {
    self.code.push(0x65); X86Encoder_rex_w(self);
    self.code.push(0x8B); self.code.push(0x04); self.code.push(0x25);
    X86Encoder_emit_i32(self, offset);
}
pub fn X86Encoder_mov_gs_rax(self: &mut X86Encoder, offset: i64) {
    self.code.push(0x65); X86Encoder_rex_w(self);
    self.code.push(0x89); self.code.push(0x04); self.code.push(0x25);
    X86Encoder_emit_i32(self, offset);
}
pub fn X86Encoder_lea_rax_gs(self: &mut X86Encoder, offset: i64) {
    self.code.push(0x65); X86Encoder_rex_w(self);
    self.code.push(0x8D); self.code.push(0x04); self.code.push(0x25);
    X86Encoder_emit_i32(self, offset);
}
pub fn X86Encoder_wrmsr(self: &mut X86Encoder) { self.code.push(0x0F); self.code.push(0x30); }
pub fn X86Encoder_rdmsr(self: &mut X86Encoder) { self.code.push(0x0F); self.code.push(0x32); }
pub fn X86Encoder_swapgs(self: &mut X86Encoder) { self.code.push(0x0F); self.code.push(0x01); self.code.push(0xF8); }

// Register a function label
pub fn PeCodeGen_register_func(self: &mut PeCodeGen, name: str) -> i64 {
    var existing: i64 = PeCodeGen_get_func_label(self, name);
    if existing >= 0 {
        return existing;
    }
    var label: i64 = X86Encoder_alloc_label(&mut self.enc);
    self.func_names.push(name);
    self.func_label_ids.push(label);
    return label;
}

// Look up a string's rdata offset
pub fn PeCodeGen_get_string_offset(self: &PeCodeGen, s: str) -> i64 {
    var i: i64 = 0;
    while i < self.string_keys.len() {
        if self.string_keys.get(i) == s {
            return self.string_vals.get(i);
        }
        i = i + 1;
    }
    return -1;
}

// Get IAT rdata offset for an import index
pub fn PeCodeGen_iat_off(self: &PeCodeGen, iat_index: i64) -> i64 {
    return self.iat_rdata_offsets.get(iat_index);
}

// ============================================================================
// Asm-driven image generation
//
// Pipeline: L3Module -> codegen_x64 asm -> ElfEmitter (shared encoder)
//           -> link user code + SysV-ABI runtime stubs + entry point
//           -> PE / flat / boot image
//
// The runtime stub bodies below use the Win64 calling convention internally
// (args in rcx/rdx/r8/r9).  codegen_x64 emits SysV calls, so every stub that
// is reachable from user code gets a small prologue wrapper which shuffles
// the SysV argument registers into the Win64 ones and jumps to the body.
// Stub-to-stub calls inside the bodies keep using the raw Win64 labels.
// ============================================================================

pub const PE_MODE_HOSTED: i64 = 0;
pub const PE_MODE_FLAT: i64 = 1;
pub const PE_MODE_BOOT: i64 = 2;

// name -> code-offset map for resolving assembler relocs
pub struct NameOff {
    pub name: str,
    pub off: i64,
}
pub fn NameOff_new(name: str, off: i64) -> NameOff {
    return NameOff { name: name, off: off };
}
fn nameoff_lookup(v: Vec<NameOff>, name: str) -> i64 {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i).name == name { return v.get(i).off; }
        i = i + 1;
    }
    return -1;
}
fn nameoff_has(v: Vec<NameOff>, name: str) -> bool {
    return nameoff_lookup(v, name) >= 0;
}

// Patch a 32-bit little-endian field inside a byte vector
fn pe_patch32(buf: &mut Vec, off: i64, val: i64) {
    buf.set(off, val & 0xFF);
    buf.set(off + 1, (val >> 8) & 0xFF);
    buf.set(off + 2, (val >> 16) & 0xFF);
    buf.set(off + 3, (val >> 24) & 0xFF);
}
// Patch a 64-bit little-endian field inside a byte vector
fn pe_patch64(buf: &mut Vec, off: i64, val: i64) {
    var i: i64 = 0;
    while i < 8 {
        buf.set(off + i, (val >> (i * 8)) & 0xFF);
        i = i + 1;
    }
}

// SysV (rdi,rsi,rdx,rcx) -> Win64 (rcx,rdx,r8,r9) argument shuffle.
// r10/r11 are caller-saved scratch in both ABIs, so they are safe here.
// Args 5/6 arrive in SysV r8/r9 and are dropped — no current p_* stub or
// kernel32 thunk used through this path takes more than 4 register args;
// imports with >4 args go through pe_emit_import_trampoline instead.
fn pe_emit_sysv_prologue(enc: &mut X86Encoder) {
    X86Encoder_mov_rr(enc, PE_REG_R10, PE_REG_RDX);   // save SysV arg3
    X86Encoder_mov_rr(enc, PE_REG_R11, PE_REG_RCX);   // save SysV arg4
    X86Encoder_mov_rr(enc, PE_REG_RCX, PE_REG_RDI);   // arg1
    X86Encoder_mov_rr(enc, PE_REG_RDX, PE_REG_RSI);   // arg2
    X86Encoder_mov_rr(enc, PE_REG_R8,  PE_REG_R10);   // arg3
    X86Encoder_mov_rr(enc, PE_REG_R9,  PE_REG_R11);   // arg4
}

// Import trampoline for an external (kernel32) function of `nargs` args.
// SysV callers land here; we repackage args for the Win64 callee and tail-
// call via the IAT.  <=4 args: pure register shuffle + jmp [iat].
// 5-6 args: build a proper Win64 frame (shadow space + stack args) and
// call [iat] so the stack can be restored afterwards.
fn pe_emit_import_trampoline(enc: &mut X86Encoder, iat_rdata_off: i64, nargs: i64) {
    if nargs <= 4 {
        pe_emit_sysv_prologue(enc);
        X86Encoder_jmp_rip(enc, iat_rdata_off);
        return;
    }
    // 5-6 args: T = entry rsp.  sub rsp,56 keeps 16-alignment and gives the
    // callee a full frame: ret(8) + shadow(32) + arg5(8) + arg6(8) = 56.
    X86Encoder_sub_rsp_i32(enc, 56);
    // Callee frame will be at C = rsp-8; arg5 -> [C+40] = [rsp+32], arg6 -> [rsp+40]
    X86Encoder_mov_mem_disp_reg(enc, PE_REG_RSP, 32, PE_REG_R8);   // SysV arg5
    X86Encoder_mov_mem_disp_reg(enc, PE_REG_RSP, 40, PE_REG_R9);   // SysV arg6
    pe_emit_sysv_prologue(enc);
    X86Encoder_call_rip(enc, iat_rdata_off);
    X86Encoder_add_rsp_i32(enc, 56);
    X86Encoder_ret(enc);
}

// Result of linking user code with the runtime stub layer.
pub struct PeLinked {
    pub text: Vec,            // final .text bytes
    pub rdata: Vec,           // final .rdata bytes
    pub entry_off: i64,       // .text offset of entry point (hosted only)
    pub import_dir_off: i64,  // .rdata offset of import directory
    pub iat_off: i64,         // .rdata offset of IAT
    pub iat_size: i64,        // IAT size in bytes
}
pub fn PeLinked_new() -> PeLinked {
    return PeLinked {
        text: Vec::new(), rdata: Vec::new(), entry_off: 0,
        import_dir_off: 0, iat_off: 0, iat_size: 0,
    };
}

// Look up a .rodata symbol's offset within the rodata byte blob.
fn pe_rodata_off(em: &ElfEmitter, name: str) -> i64 {
    var i: i64 = 0;
    while i < em.rodata_symbols.len() {
        var rs: RodataSym = em.rodata_symbols.get(i);
        if rs.name == name { return rs.offset; }
        i = i + 1;
    }
    return -1;
}

// Collect undefined symbol names referenced by the assembler's relocations.
// Splits them into p_* runtime calls and true external imports.
// (.rodata labels like .str_N arrive as undefined `symbols` entries — the
// assembler only marks `.L*` locals — so they must be filtered out here.)
fn pe_collect_externs(em: &ElfEmitter, stubs: &mut Vec<str>, imports: &mut Vec<str>) {
    var i: i64 = 0;
    while i < em.relocations.len() {
        var rel: Relocation = em.relocations.get(i);
        var sym: Symbol = em.symbols.get(rel.symbol);
        if !sym.is_defined {
            var name: str = sym.name;
            if pe_rodata_off(em, name) >= 0 {
                // rodata label — resolved against .rdata, not an import
            } else if str_len(name) > 2 && str_byte_at(name, 0) == 112 && str_byte_at(name, 1) == 95 {
                if !nameoff_has_str(stubs, name) { stubs.push(name); }
            } else {
                if !nameoff_has_str(imports, name) { imports.push(name); }
            }
        }
        i = i + 1;
    }
}
fn nameoff_has_str(v: Vec<str>, name: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == name { return true; }
        i = i + 1;
    }
    return false;
}

// Emit SysV wrapper thunks for every referenced p_* builtin:
//   <wrapper>: <sysv->win64 shuffle>; jmp <p_x body label>
// For builtins without a machine-code stub, emit `xor eax,eax; ret`.
// Appends name -> wrapper-offset entries (offsets inside enc.code).
fn pe_emit_stub_wrappers(gen: &mut PeCodeGen, stub_names: Vec<str>, out_map: &mut Vec<NameOff>) {
    var i: i64 = 0;
    while i < stub_names.len() {
        var name: str = stub_names.get(i);
        out_map.push(NameOff_new(name, X86Encoder_offset(&gen.enc)));
        var lbl: i64 = PeCodeGen_get_func_label(gen, name);
        if lbl >= 0 {
            pe_emit_sysv_prologue(&mut gen.enc);
            X86Encoder_jmp_label(&mut gen.enc, lbl);
        } else {
            // Unknown runtime builtin: defined-but-empty behaviour (returns 0)
            X86Encoder_xor_self(&mut gen.enc, PE_REG_RAX);
            X86Encoder_ret(&mut gen.enc);
        }
        i = i + 1;
    }
}

// Emit import trampolines; appends name -> trampoline-offset entries.
fn pe_emit_import_tramps(gen: &mut PeCodeGen, import_names: Vec<str>, iat_idx: Vec<NameOff>, out_map: &mut Vec<NameOff>) {
    var i: i64 = 0;
    while i < import_names.len() {
        var name: str = import_names.get(i);
        out_map.push(NameOff_new(name, X86Encoder_offset(&gen.enc)));
        // Arity unknown at this layer; <=4 register args covers the common
        // case.  WriteFile-style >4-arg calls still get a correct frame when
        // declared extern with the real arity — see pe_emit_import_trampoline.
        pe_emit_import_trampoline(&mut gen.enc, iat_idx.get(i).off, 4);
        i = i + 1;
    }
}

// Apply the assembler relocations to the final .text image.
// text_va   = virtual address where .text starts
// rdata_va  = virtual address where .rdata starts (for .str_N references)
// user_base = .text offset where assembled user code begins
// enc_base  = .text offset where the enc stream (stubs) begins
fn pe_apply_text_relocs(text: &mut Vec, em: &ElfEmitter, target_map: Vec<NameOff>,
                        text_va: i64, rdata_va: i64, user_base: i64, enc_base: i64) {
    var i: i64 = 0;
    while i < em.relocations.len() {
        var rel: Relocation = em.relocations.get(i);
        var sym: Symbol = em.symbols.get(rel.symbol);
        var target_va: i64 = -1;
        if sym.is_defined {
            // symbol.value is an offset within the assembler's .text
            target_va = text_va + user_base + sym.value;
        } else {
            var off: i64 = nameoff_lookup(target_map, sym.name);
            if off >= 0 {
                target_va = text_va + off;
            } else {
                // .rodata label (.str_N) — resolve against .rdata
                var roff: i64 = pe_rodata_off(em, sym.name);
                if roff >= 0 { target_va = rdata_va + roff; }
            }
        }
        if target_va < 0 {
            // Unresolved: leave the zero displacement (would have been
            // silently corrupt before; now at least deterministic).
            i = i + 1;
            continue;
        }
        var field_va: i64 = text_va + user_base + rel.offset;
        var val: i64 = target_va + rel.addend - field_va;
        pe_patch32(text, user_base + rel.offset, val);
        i = i + 1;
    }
}

// Apply .rodata absolute relocations (e.g. vtables holding function addrs).
fn pe_apply_rodata_relocs(rdata: &mut Vec, em: &ElfEmitter, target_map: Vec<NameOff>,
                          text_va: i64, rdata_va: i64, user_base: i64, enc_base: i64) {
    var i: i64 = 0;
    while i < em.rodata_relocations.len() {
        var rel: Relocation = em.rodata_relocations.get(i);
        var sym: Symbol = em.symbols.get(rel.symbol);
        var target_va: i64 = -1;
        if sym.is_defined {
            target_va = text_va + user_base + sym.value;
        } else {
            var off: i64 = nameoff_lookup(target_map, sym.name);
            if off >= 0 {
                target_va = text_va + off;
            } else {
                var roff: i64 = pe_rodata_off(em, sym.name);
                if roff >= 0 { target_va = rdata_va + roff; }
            }
        }
        if target_va < 0 { i = i + 1; continue; }
        pe_patch64(rdata, rel.offset, target_va + rel.addend);
        i = i + 1;
    }
}

// Look up a defined symbol's .text offset in the assembler output.
fn pe_sym_text_off(em: &ElfEmitter, name: str) -> i64 {
    var i: i64 = 0;
    while i < em.symbols.len() {
        var s: Symbol = em.symbols.get(i);
        if s.is_defined && s.name == name { return s.value; }
        i = i + 1;
    }
    return -1;
}

// ============================================================================
// Shared link core: assemble -> stubs -> entry -> relocate -> image
// ============================================================================
fn pe_build(asm: str, module: &IrModule, mode: i64) -> Vec {
    // 1. Assemble shared-pipeline asm -> machine code + symbols + relocs
    var em: ElfEmitter = ElfEmitter_new();
    match ElfEmitter_assemble(&mut em, asm) {
        ResultUnit::Ok => {}
        ResultUnit::Err(e) => {
            p_eprint_str("[pe] assembler error: ");
            p_eprint_str(e);
            p_eprint_str("\n");
            return Vec::new();
        }
    }

    var hosted: bool = mode == PE_MODE_HOSTED;

    // 2. Which externals does the user code actually call?
    var stub_names: Vec<str> = Vec::new();
    var import_names: Vec<str> = Vec::new();
    pe_collect_externs(&em, &mut stub_names, &mut import_names);
    if !hosted { import_names = Vec::new(); }

    // 3. Build .rdata: assembler rodata + stub strings + import tables
    var rdata: RdataBuilder = RdataBuilder_new();
    var ri: i64 = 0;
    while ri < em.rodata.len() {
        rdata.data.push(em.rodata.get(ri));
        ri = ri + 1;
    }
    // Strings the runtime stubs reference by content
    RdataBuilder_add_string(&mut rdata, "true");
    RdataBuilder_add_string(&mut rdata, "false");
    RdataBuilder_add_string(&mut rdata, "-");
    RdataBuilder_add_string(&mut rdata, ".");
    var iat_idx: Vec<NameOff> = Vec::new();
    if hosted {
        iat_idx = RdataBuilder_build_imports(&mut rdata, import_names);
    }

    // 4. Emit stubs + wrappers + entry into the trailing enc stream
    var gen: PeCodeGen = PeCodeGen_new();
    gen.bare_mode = !hosted;
    gen.iat_rdata_offsets = rdata.iat_offsets;
    gen.string_keys = rdata.string_keys;
    gen.string_vals = rdata.string_vals;
    PeCodeGen_register_runtime_labels1(&mut gen);
    PeCodeGen_register_runtime_labels2(&mut gen);

    var target_map: Vec<NameOff> = Vec::new();

    // Boot mode: the 32->64 trampoline must be first — GRUB jumps to the
    // start of .text, which is the beginning of the enc stream.
    if mode == PE_MODE_BOOT {
        gen.entry_offset = X86Encoder_offset(&gen.enc);
        PeCodeGen_gen_boot_entry_point(&mut gen, module);
        PeCodeGen_gen_idt_setup_for_interrupts(&mut gen, module);
    }

    // Wrappers first (SysV entry for user calls), then raw Win64 bodies.
    pe_emit_stub_wrappers(&mut gen, stub_names, &mut target_map);
    if hosted {
        pe_emit_import_tramps(&mut gen, import_names, iat_idx, &mut target_map);
    }
    PeCodeGen_gen_runtime_stubs(&mut gen);

    // Hosted entry point (_start) goes last.
    if hosted {
        gen.entry_offset = X86Encoder_offset(&gen.enc);
        PeCodeGen_gen_entry_point(&mut gen);
    }

    X86Encoder_resolve_labels(&mut gen.enc);

    // 5. Final .text = user code ++ enc stream
    var user_len: i64 = em.text.len();
    var enc_len: i64 = gen.enc.code.len();
    var text: Vec = Vec::new();

    if mode == PE_MODE_BOOT {
        // Boot layout: [enc (trampoline+stubs)][user code]
        // user_base = enc_len, enc_base = 0
        var ei: i64 = 0;
        while ei < enc_len { text.push(gen.enc.code.get(ei)); ei = ei + 1; }
        var ui: i64 = 0;
        while ui < user_len { text.push(em.text.get(ui)); ui = ui + 1; }
    } else {
        // Hosted/flat layout: [user code][enc (stubs/entry)]
        var ui2: i64 = 0;
        while ui2 < user_len { text.push(em.text.get(ui2)); ui2 = ui2 + 1; }
        var ei2: i64 = 0;
        while ei2 < enc_len { text.push(gen.enc.code.get(ei2)); ei2 = ei2 + 1; }
    }

    var user_base: i64 = 0;
    var enc_base: i64 = user_len;
    if mode == PE_MODE_BOOT {
        user_base = enc_len;
        enc_base = 0;
    }
    // Retarget enc-stream offsets into final-text coordinates
    var mi: i64 = 0;
    while mi < target_map.len() {
        target_map.get(mi).off = target_map.get(mi).off + enc_base;
        mi = mi + 1;
    }

    // 6. Compute VAs
    var load_rva: i64 = TEXT_RVA;
    if mode == PE_MODE_FLAT { load_rva = 0x10000; }
    if mode == PE_MODE_BOOT { load_rva = 0x100000 + 24; }
    var text_va: i64 = load_rva;                 // .text section VA (rva space)
    var rdata_rva: i64 = load_rva + align_up(text.len(), SECTION_ALIGN);

    // Patch pending references into assembled user code
    var pc: i64 = 0;
    while pc < gen.pending_ucalls.len() {
        var pref: PendingUserRef = gen.pending_ucalls.get(pc);
        var sym_off: i64 = pe_sym_text_off(&em, pref.name);
        if sym_off >= 0 {
            if pref.kind == PREF_REL32 {
                var d32: i64 = (user_base + sym_off) - (enc_base + pref.code_off + 4);
                pe_patch32(&mut gen.enc.code, pref.code_off, d32);
            } else {
                pe_patch64(&mut gen.enc.code, pref.code_off, text_va + user_base + sym_off);
            }
        }
        pc = pc + 1;
    }

    // Patch enc-stream rip refs (iat calls/lea) — code at enc_base
    X86Encoder_resolve_rip_refs(&mut gen.enc, text_va + enc_base, rdata_rva);
    // Copy patched enc bytes back into text
    if mode == PE_MODE_BOOT {
        var pi: i64 = 0;
        while pi < enc_len { text.set(pi, gen.enc.code.get(pi)); pi = pi + 1; }
    } else {
        var pj: i64 = 0;
        while pj < enc_len { text.set(user_len + pj, gen.enc.code.get(pj)); pj = pj + 1; }
    }

    // 7. Apply assembler relocations over the final image
    pe_apply_text_relocs(&mut text, &em, target_map, text_va, rdata_rva, user_base, enc_base);

    // 8. Finish .rdata and apply its relocations
    var base_va: i64 = IMAGE_BASE;
    if !hosted { base_va = 0; }
    pe_apply_rodata_relocs(&mut rdata.data, &em, target_map, text_va + base_va, rdata_rva + base_va, user_base, enc_base);
    if hosted {
        RdataBuilder_patch_rvas(&mut rdata, rdata_rva);
    }

    // 9. Wrap into the target container
    if hosted {
        var entry_rva: i64 = text_va + enc_base + gen.entry_offset;
        var import_dir_rva: i64 = rdata_rva + rdata.import_dir_offset;
        var iat_rva: i64 = rdata_rva + rdata.iat_offset;
        var iat_size: i64 = (import_names.len() + 1) * 8;
        return build_pe_file(text, rdata.data, entry_rva, import_dir_rva, iat_rva, iat_size, rdata_rva);
    }

    // Flat / boot: raw image bytes
    var binary: Vec = Vec::new();
    if mode == PE_MODE_BOOT {
        var mb2: Vec = build_multiboot2_header();
        var bi: i64 = 0;
        while bi < mb2.len() { binary.push(mb2.get(bi)); bi = bi + 1; }
    }
    var pad_len: i64 = align_up(text.len(), SECTION_ALIGN);
    var hdr: i64 = 0;
    if mode == PE_MODE_BOOT { hdr = 24; }
    var ti: i64 = 0;
    while ti < text.len() { binary.push(text.get(ti)); ti = ti + 1; }
    while binary.len() < hdr + pad_len {
        binary.push(0xCC);
    }
    var di: i64 = 0;
    while di < rdata.data.len() { binary.push(rdata.data.get(di)); di = di + 1; }
    return binary;
}

// ============================================================================
// Public entry points — signature kept close to the old IrModule-driven API
// but now takes the L3Module so user code flows through the shared
// codegen_x64 pipeline (opt-included) instead of a second codegen.
// ============================================================================
pub fn generate_pe(module: IrModule, l3: L3Module) -> Vec {
    var asm: str = generate_asm(l3);
    asm = peephole_optimize(asm);
    return pe_build(asm, &module, PE_MODE_HOSTED);
}

// Flat binary (bare-metal): [code][rdata], loaded at 0x10000, entry at offset 0.
pub fn generate_flat_binary(module: IrModule, l3: L3Module) -> Vec {
    var asm: str = generate_asm(l3);
    asm = peephole_optimize(asm);
    return pe_build(asm, &module, PE_MODE_FLAT);
}

// Multiboot2 kernel: [mb2 header][boot code + user code][rdata] at 0x100000.
pub fn generate_boot_binary(module: IrModule, l3: L3Module) -> Vec {
    var asm: str = generate_asm(l3);
    asm = peephole_optimize(asm);
    return pe_build(asm, &module, PE_MODE_BOOT);
}

// ─── Multiboot2 boot binary generation ─────────────────────────────────
// Layout: [multiboot2 header][boot code + main code][padding][rdata]
// The multiboot2 header is at the very start so GRUB can find it.
// Load address: 0x100000 (1MB — typical kernel load address).

// Build a Multiboot2 header (24 bytes):
//   magic: 0xE85250D6, architecture: 0, header_length: 24, checksum
//   end tag: type=0, flags=0, size=8
pub fn build_multiboot2_header() -> Vec {
    // Build a 24-byte Multiboot2 header as a byte Vec.
    // Each byte is pushed individually. Vec in Fides stores i64 elements,
    // so we use p_byte_vec_push if available, or build via encoder.
    // Actually, Vec.push stores i64 per slot — we need a byte buffer.
    // Use X86Encoder to build raw bytes, then extract.
    var enc: X86Encoder = X86Encoder_new();
    // 0xE85250D6 — split into parts to avoid large hex literal issues
    X86Encoder_emit_u32(&mut enc, 0xE8000000 + 0x00520000 + 0x00005000 + 0x000000D6);
    X86Encoder_emit_u32(&mut enc, 0); // architecture
    X86Encoder_emit_u32(&mut enc, 24); // header_length
    // Checksum: -(magic + arch + length) mod 2^32
    var magic: i64 = 0xE8000000 + 0x00520000 + 0x00005000 + 0x000000D6;
    var checksum: i64 = 0 - (magic + 0 + 24);
    checksum = checksum & 0xFFFFFFFF;
    X86Encoder_emit_u32(&mut enc, checksum);
    // End tag: type=0 (u16), flags=0 (u16), size=8 (u32)
    X86Encoder_emit_u16(&mut enc, 0); // type
    X86Encoder_emit_u16(&mut enc, 0); // flags
    X86Encoder_emit_u32(&mut enc, 8); // size
    return enc.code;
}

