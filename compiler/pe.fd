// p_lgdt(rcx = pointer to GDT descriptor) — load GDT
pub fn PeCodeGen_gen_p_lgdt(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_lgdt");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        // lgdt [rcx]
        X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x01); X86Encoder_emit_u8(&mut self.enc, 0x19);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

// p_gdt_set_entry(rcx = gdt_ptr, rdx = index, r8 = base, r9 = limit, stack[16] = flags)
// Writes an 8-byte GDT entry at gdt_ptr + index * 8.
pub fn PeCodeGen_gen_p_gdt_set_entry(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_gdt_set_entry");
    X86Encoder_place_label(&mut self.enc, lbl);
    if self.bare_mode {
        X86Encoder_push(&mut self.enc, PE_REG_RBP);
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RBP, PE_REG_RSP);

        // r10 = rdx * 8 + rcx (entry address)
        X86Encoder_mov_rr(&mut self.enc, PE_REG_R10, PE_REG_RDX);
        X86Encoder_shl_r_i8(&mut self.enc, PE_REG_R10, 3);
        X86Encoder_add_rr(&mut self.enc, PE_REG_R10, PE_REG_RCX);

        // limit_low = r9 & 0xFFFF → [r10 + 0]
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R9);
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0x02); // mov [r10], ax

        // base_low = r8 & 0xFFFF → [r10 + 2]
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R8);
        X86Encoder_emit_u8(&mut self.enc, 0x66); X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0x89); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x02); // mov [r10+2], ax

        // base_mid = (r8 >> 16) & 0xFF → [r10 + 4]
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x10); // shr rax, 16
        X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0x88); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x04); // mov [r10+4], al

        // type_attr = flags (from stack) → [r10 + 5]
        X86Encoder_movzx_r32_r8(&mut self.enc, PE_REG_RAX, PE_REG_RAX);
        // Load flags from stack: [rbp + 40]
        X86Encoder_mov_reg_mem_rbp(&mut self.enc, PE_REG_RAX, 40);
        X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0x88); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x05); // mov [r10+5], al

        // limit_high + flags_high → [r10 + 6]
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R9);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x10); // shr rax, 16
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x25); X86Encoder_emit_u8(&mut self.enc, 0x0F); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); // and rax, 0x0F
        // Load flags again, shift right 8, mask 0xF0
        X86Encoder_mov_reg_mem_rbp(&mut self.enc, PE_REG_RCX, 40);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE9); X86Encoder_emit_u8(&mut self.enc, 0x08); // shr rcx, 8
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0x81); X86Encoder_emit_u8(&mut self.enc, 0xE1); X86Encoder_emit_u8(&mut self.enc, 0xF0); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); X86Encoder_emit_u8(&mut self.enc, 0x00); // and rcx, 0xF0
        X86Encoder_or_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
        X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0x88); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x06); // mov [r10+6], al

        // base_high = (r8 >> 24) & 0xFF → [r10 + 7]
        X86Encoder_mov_rr(&mut self.enc, PE_REG_RAX, PE_REG_R8);
        X86Encoder_emit_u8(&mut self.enc, 0x48); X86Encoder_emit_u8(&mut self.enc, 0xC1); X86Encoder_emit_u8(&mut self.enc, 0xE8); X86Encoder_emit_u8(&mut self.enc, 0x18); // shr rax, 24
        X86Encoder_emit_u8(&mut self.enc, 0x41); X86Encoder_emit_u8(&mut self.enc, 0x88); X86Encoder_emit_u8(&mut self.enc, 0x42); X86Encoder_emit_u8(&mut self.enc, 0x07); // mov [r10+7], al

        X86Encoder_pop(&mut self.enc, PE_REG_RBP);
    } else {
        X86Encoder_ud2(&mut self.enc);
    }
    X86Encoder_ret(&mut self.enc);
}

