    X86Encoder_test_rr(&mut self.enc, PE_REG_R10, PE_REG_R10);
    var mg_found: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_jcc_label(&mut self.enc, 4, mg_found);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RCX);
    X86Encoder_inc_r(&mut self.enc, PE_REG_RDX);
    X86Encoder_jmp_label(&mut self.enc, mg_cmp);

    X86Encoder_place_label(&mut self.enc, mg_found);
    X86Encoder_mov_reg_ptr(&mut self.enc, PE_REG_RAX, PE_REG_R12);
    X86Encoder_mov_rr(&mut self.enc, PE_REG_RCX, PE_REG_R9);
    X86Encoder_shl_r_i8(&mut self.enc, PE_REG_RCX, 4);
    X86Encoder_add_rr(&mut self.enc, PE_REG_RAX, PE_REG_RCX);
