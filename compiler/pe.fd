// p_string_bytes — same as strlen
pub fn PeCodeGen_gen_string_bytes(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_bytes");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, REG_RBP, REG_RSP);
    X86Encoder_push(&mut self.enc, REG_R12);
    X86Encoder_mov_rr(&mut self.enc, REG_R12, REG_RCX);
    X86Encoder_xor_self(&mut self.enc, REG_RAX);
    var loop_label: i64 = X86Encoder_alloc_label(&mut self.enc);
    var done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, loop_label);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, REG_R9, REG_R12, REG_RAX);
    X86Encoder_test_rr(&mut self.enc, REG_R9, REG_R9);
    X86Encoder_jcc_label(&mut self.enc, 4, done);
    X86Encoder_inc_r(&mut self.enc, REG_RAX);
    X86Encoder_jmp_label(&mut self.enc, loop_label);
    X86Encoder_place_label(&mut self.enc, done);
    X86Encoder_pop(&mut self.enc, REG_R12);
    X86Encoder_pop(&mut self.enc, REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// p_string_clone — copy string
pub fn PeCodeGen_gen_string_clone(self: &mut PeCodeGen) {
    var lbl: i64 = PeCodeGen_get_func_label(self, "p_string_clone");
    X86Encoder_place_label(&mut self.enc, lbl);
    X86Encoder_push(&mut self.enc, REG_RBP);
    X86Encoder_mov_rr(&mut self.enc, REG_RBP, REG_RSP);
    X86Encoder_push(&mut self.enc, REG_R12);
    X86Encoder_push(&mut self.enc, REG_R13);
    X86Encoder_sub_rsp_i32(&mut self.enc, 32);
    X86Encoder_mov_rr(&mut self.enc, REG_R12, REG_RCX);
    X86Encoder_xor_self(&mut self.enc, REG_R13);
    var len_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    var len_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, len_loop);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, REG_R9, REG_R12, REG_R13);
    X86Encoder_test_rr(&mut self.enc, REG_R9, REG_R9);
    X86Encoder_jcc_label(&mut self.enc, 4, len_done);
    X86Encoder_inc_r(&mut self.enc, REG_R13);
    X86Encoder_jmp_label(&mut self.enc, len_loop);
    X86Encoder_place_label(&mut self.enc, len_done);
    X86Encoder_mov_rr(&mut self.enc, REG_RCX, REG_R13);
    X86Encoder_add_r_i32(&mut self.enc, REG_RCX, 1);
    X86Encoder_call_label(&mut self.enc, PeCodeGen_get_func_label(self, "p_malloc"));
    X86Encoder_mov_rr(&mut self.enc, REG_R9, REG_RAX);
    X86Encoder_xor_self(&mut self.enc, REG_R10);
    var copy_loop: i64 = X86Encoder_alloc_label(&mut self.enc);
    var copy_done: i64 = X86Encoder_alloc_label(&mut self.enc);
    X86Encoder_place_label(&mut self.enc, copy_loop);
    X86Encoder_cmp_rr(&mut self.enc, REG_R10, REG_R13);
    X86Encoder_jcc_label(&mut self.enc, 3, copy_done);
    X86Encoder_mov_reg8_mem_idx(&mut self.enc, REG_RAX, REG_R12, REG_R10);
    X86Encoder_mov_mem_disp_reg8(&mut self.enc, REG_R9, REG_R10, REG_RAX);
    X86Encoder_inc_r(&mut self.enc, REG_R10);
    X86Encoder_jmp_label(&mut self.enc, copy_loop);
    X86Encoder_place_label(&mut self.enc, copy_done);
    X86Encoder_xor_self(&mut self.enc, REG_RAX);
    X86Encoder_mov_mem_disp_reg8(&mut self.enc, REG_R9, REG_R13, REG_RAX);
    X86Encoder_mov_rr(&mut self.enc, REG_RAX, REG_R9);
    X86Encoder_mov_rr(&mut self.enc, REG_RSP, REG_RBP);
    X86Encoder_pop(&mut self.enc, REG_R13);
    X86Encoder_pop(&mut self.enc, REG_R12);
    X86Encoder_pop(&mut self.enc, REG_RBP);
    X86Encoder_ret(&mut self.enc);
}

// ─── Helper: check if type is float ─────────────────────────────────────
// Note: ir_type_is_float and ir_type_size are already defined in ir.fd

// ─── Write PE bytes to file ─────────────────────────────────────────────
// Convert Vec<i64> of bytes to a string for p_file_write
pub fn pe_bytes_to_string(bytes: Vec) -> str {
    // We need to write raw bytes to a file, but p_file_write expects str
    // In Fides, str is a byte buffer, so we can use str_from_bytes
    return str_from_bytes(bytes);
}