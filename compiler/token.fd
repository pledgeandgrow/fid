// token.fd — Token types for the Fides compiler
// Rewritten from src/token.rs (261 LOC Rust)
//
// This module defines the TokenKind enum (all token types in the Fides
// language) and the Token struct (kind + source position). It provides:
//   - token_kind_to_str: Display formatting (matches Rust's impl Display)
//   - is_word_keyword:   true for keyword tokens that look like identifiers
//   - token_new:         constructor

module compiler::token;

// ─── TokenKind enum ──────────────────────────────────────────────────────
// 133 variants: keywords, types, literals, operators, punctuation, special.
// Payload variants: IntLit(i64), FloatLit(f64), StringLit(str),
// FString(str), Ident(str).

pub enum TokenKind {
    // ── Keywords ──
    Fn, Val, Var, Mut, Const, Given, Ensure, Cap, Type, Return,
    If, Else, Match, Select, Struct, Enum, Impl, Pub, Use, Module,
    With, Async, Await, Comptime, Defer, Spawn, Move, Static, Try, In,
    As, Dyn, Where, Region, Sandbox, Unsafe, Txn, Persist, For, While,
    Loop, Break, Continue, Handle, Do, Interrupt, Extern, Guard, Is,
    True, False,

    // ── ML keywords ──
    Layer, Model, Grad, Backward, Kernel,

    // ── Game architecture keywords ──
    Component, System, Query, State, On,

    // ── Type keywords ──
    I8, I16, I32, I64, I128, U8, U16, U32, U64, U128, F32, F64,
    Bool, Str, Void,

    // ── Literals (with payload) ──
    IntLit(i64),
    FloatLit(f64),
    StringLit(str),
    FString(str),
    Ident(str),

    // ── Operators ──
    Plus, Minus, Star, Slash, Percent, Eq, EqEq, BangEq, Lt, Gt,
    LtEq, GtEq, Bang, And, Ampersand, Or, Pipe, PipeArrow, Caret,
    Tilde, Shl, Shr, DotDot, DotDotEq, TildeArrow,

    // ── Compound assignment ──
    PlusEq, MinusEq, StarEq, SlashEq, PercentEq, AmpEq, PipeEq,
    CaretEq, ShlEq, ShrEq,

    // ── Punctuation ──
    Arrow, FatArrow, Dot, Comma, Colon, Semicolon, DoubleColon,
    Question, QuestionQuestion, QuestionDot, Hash, At,
    LBracket, RBracket, LParen, RParen, LBrace, RBrace,

    // ── Special ──
    Eof,
}

// ─── Token struct ────────────────────────────────────────────────────────

pub struct Token {
    pub kind: TokenKind,
    pub line: i64,
    pub col: i64,
}

// ─── Constructor ─────────────────────────────────────────────────────────

pub fn token_new(kind: TokenKind, line: i64, col: i64) -> Token {
    return Token { kind: kind, line: line, col: col };
}

// ─── Display: token_kind_to_str ──────────────────────────────────────────
// Matches Rust's impl Display for TokenKind.
// - Word keywords => lowercase string (e.g. Fn => "fn")
// - IntLit(n)    => int_to_str(n)
// - StringLit(s) => "\"s\""
// - Ident(s)     => s
// - Eof          => "EOF"
// - FloatLit(f)  => "FloatLit(f)"  (Debug format — not in Display explicit cases)
// - FString(s)   => "FString(\"s\")" (Debug format)
// - All others   => variant name (Debug format, e.g. "Plus", "I64", "Arrow")

pub fn token_kind_to_str(kind: TokenKind) -> str {
    match kind {
        // ── Word keywords ──
        TokenKind::Fn => { return "fn"; }
        TokenKind::Val => { return "val"; }
        TokenKind::Var => { return "var"; }
        TokenKind::Mut => { return "mut"; }
        TokenKind::Const => { return "const"; }
        TokenKind::Given => { return "given"; }
        TokenKind::Ensure => { return "ensure"; }
        TokenKind::Cap => { return "cap"; }
        TokenKind::Type => { return "type"; }
        TokenKind::Return => { return "return"; }
        TokenKind::If => { return "if"; }
        TokenKind::Else => { return "else"; }
        TokenKind::Match => { return "match"; }
        TokenKind::Select => { return "select"; }
        TokenKind::Struct => { return "struct"; }
        TokenKind::Enum => { return "enum"; }
        TokenKind::Impl => { return "impl"; }
        TokenKind::Pub => { return "pub"; }
        TokenKind::Use => { return "use"; }
        TokenKind::Module => { return "module"; }
        TokenKind::With => { return "with"; }
        TokenKind::Async => { return "async"; }
        TokenKind::Await => { return "await"; }
        TokenKind::Comptime => { return "comptime"; }
        TokenKind::Defer => { return "defer"; }
        TokenKind::Spawn => { return "spawn"; }
        TokenKind::Move => { return "move"; }
        TokenKind::Static => { return "static"; }
        TokenKind::Try => { return "try"; }
        TokenKind::In => { return "in"; }
        TokenKind::As => { return "as"; }
        TokenKind::Dyn => { return "dyn"; }
        TokenKind::Where => { return "where"; }
        TokenKind::Region => { return "region"; }
        TokenKind::Sandbox => { return "sandbox"; }
        TokenKind::Unsafe => { return "unsafe"; }
        TokenKind::Txn => { return "txn"; }
        TokenKind::Persist => { return "persist"; }
        TokenKind::For => { return "for"; }
        TokenKind::While => { return "while"; }
        TokenKind::Loop => { return "loop"; }
        TokenKind::Break => { return "break"; }
        TokenKind::Continue => { return "continue"; }
        TokenKind::Handle => { return "handle"; }
        TokenKind::Do => { return "do"; }
        TokenKind::Interrupt => { return "interrupt"; }
        TokenKind::Extern => { return "extern"; }
        TokenKind::Guard => { return "guard"; }
        TokenKind::Is => { return "is"; }
        TokenKind::True => { return "true"; }
        TokenKind::False => { return "false"; }

        // ── ML keywords ──
        TokenKind::Layer => { return "layer"; }
        TokenKind::Model => { return "model"; }
        TokenKind::Grad => { return "grad"; }
        TokenKind::Backward => { return "backward"; }
        TokenKind::Kernel => { return "kernel"; }

        // ── Game architecture keywords ──
        TokenKind::Component => { return "component"; }
        TokenKind::System => { return "system"; }
        TokenKind::Query => { return "query"; }
        TokenKind::State => { return "state"; }
        TokenKind::On => { return "on"; }

        // ── Literals ──
        TokenKind::IntLit(n: i64) => { return int_to_str(n); }
        TokenKind::FloatLit(f: f64) => { return "FloatLit(" + float_to_str(f) + ")"; }
        TokenKind::StringLit(s: str) => { return "\"" + s + "\""; }
        TokenKind::FString(s: str) => { return "FString(\"" + s + "\")"; }
        TokenKind::Ident(s: str) => { return s; }
        TokenKind::Eof => { return "EOF"; }

        // ── Type keywords (Debug format = variant name) ──
        TokenKind::I8 => { return "I8"; }
        TokenKind::I16 => { return "I16"; }
        TokenKind::I32 => { return "I32"; }
        TokenKind::I64 => { return "I64"; }
        TokenKind::I128 => { return "I128"; }
        TokenKind::U8 => { return "U8"; }
        TokenKind::U16 => { return "U16"; }
        TokenKind::U32 => { return "U32"; }
        TokenKind::U64 => { return "U64"; }
        TokenKind::U128 => { return "U128"; }
        TokenKind::F32 => { return "F32"; }
        TokenKind::F64 => { return "F64"; }
        TokenKind::Bool => { return "Bool"; }
        TokenKind::Str => { return "Str"; }
        TokenKind::Void => { return "Void"; }

        // ── Operators (Debug format = variant name) ──
        TokenKind::Plus => { return "Plus"; }
        TokenKind::Minus => { return "Minus"; }
        TokenKind::Star => { return "Star"; }
        TokenKind::Slash => { return "Slash"; }
        TokenKind::Percent => { return "Percent"; }
        TokenKind::Eq => { return "Eq"; }
        TokenKind::EqEq => { return "EqEq"; }
        TokenKind::BangEq => { return "BangEq"; }
        TokenKind::Lt => { return "Lt"; }
        TokenKind::Gt => { return "Gt"; }
        TokenKind::LtEq => { return "LtEq"; }
        TokenKind::GtEq => { return "GtEq"; }
        TokenKind::Bang => { return "Bang"; }
        TokenKind::And => { return "And"; }
        TokenKind::Ampersand => { return "Ampersand"; }
        TokenKind::Or => { return "Or"; }
        TokenKind::Pipe => { return "Pipe"; }
        TokenKind::PipeArrow => { return "PipeArrow"; }
        TokenKind::Caret => { return "Caret"; }
        TokenKind::Tilde => { return "Tilde"; }
        TokenKind::Shl => { return "Shl"; }
        TokenKind::Shr => { return "Shr"; }
        TokenKind::DotDot => { return "DotDot"; }
        TokenKind::DotDotEq => { return "DotDotEq"; }
        TokenKind::TildeArrow => { return "TildeArrow"; }

        // ── Compound assignment ──
        TokenKind::PlusEq => { return "PlusEq"; }
        TokenKind::MinusEq => { return "MinusEq"; }
        TokenKind::StarEq => { return "StarEq"; }
        TokenKind::SlashEq => { return "SlashEq"; }
        TokenKind::PercentEq => { return "PercentEq"; }
        TokenKind::AmpEq => { return "AmpEq"; }
        TokenKind::PipeEq => { return "PipeEq"; }
        TokenKind::CaretEq => { return "CaretEq"; }
        TokenKind::ShlEq => { return "ShlEq"; }
        TokenKind::ShrEq => { return "ShrEq"; }

        // ── Punctuation ──
        TokenKind::Arrow => { return "Arrow"; }
        TokenKind::FatArrow => { return "FatArrow"; }
        TokenKind::Dot => { return "Dot"; }
        TokenKind::Comma => { return "Comma"; }
        TokenKind::Colon => { return "Colon"; }
        TokenKind::Semicolon => { return "Semicolon"; }
        TokenKind::DoubleColon => { return "DoubleColon"; }
        TokenKind::Question => { return "Question"; }
        TokenKind::QuestionQuestion => { return "QuestionQuestion"; }
        TokenKind::QuestionDot => { return "QuestionDot"; }
        TokenKind::Hash => { return "Hash"; }
        TokenKind::At => { return "At"; }
        TokenKind::LBracket => { return "LBracket"; }
        TokenKind::RBracket => { return "RBracket"; }
        TokenKind::LParen => { return "LParen"; }
        TokenKind::RParen => { return "RParen"; }
        TokenKind::LBrace => { return "LBrace"; }
        TokenKind::RBrace => { return "RBrace"; }
    }
}

// ─── is_word_keyword ─────────────────────────────────────────────────────
// Returns true if this token is a word-like keyword that can be used as
// an identifier (e.g. "match", "query", "state"). Returns false for
// punctuation and operator tokens (e.g. "=", ";", "+").
// Also returns false for type keywords (I64, Bool, etc.) and literals.

pub fn is_word_keyword(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Fn => { return true; }
        TokenKind::Val => { return true; }
        TokenKind::Var => { return true; }
        TokenKind::Mut => { return true; }
        TokenKind::Const => { return true; }
        TokenKind::Given => { return true; }
        TokenKind::Ensure => { return true; }
        TokenKind::Cap => { return true; }
        TokenKind::Type => { return true; }
        TokenKind::Return => { return true; }
        TokenKind::If => { return true; }
        TokenKind::Else => { return true; }
        TokenKind::Match => { return true; }
        TokenKind::Select => { return true; }
        TokenKind::Struct => { return true; }
        TokenKind::Enum => { return true; }
        TokenKind::Impl => { return true; }
        TokenKind::Pub => { return true; }
        TokenKind::Use => { return true; }
        TokenKind::Module => { return true; }
        TokenKind::With => { return true; }
        TokenKind::Async => { return true; }
        TokenKind::Await => { return true; }
        TokenKind::Comptime => { return true; }
        TokenKind::Defer => { return true; }
        TokenKind::Spawn => { return true; }
        TokenKind::Move => { return true; }
        TokenKind::Static => { return true; }
        TokenKind::Try => { return true; }
        TokenKind::In => { return true; }
        TokenKind::As => { return true; }
        TokenKind::Dyn => { return true; }
        TokenKind::Where => { return true; }
        TokenKind::Region => { return true; }
        TokenKind::Sandbox => { return true; }
        TokenKind::Unsafe => { return true; }
        TokenKind::Txn => { return true; }
        TokenKind::Persist => { return true; }
        TokenKind::For => { return true; }
        TokenKind::While => { return true; }
        TokenKind::Loop => { return true; }
        TokenKind::Break => { return true; }
        TokenKind::Continue => { return true; }
        TokenKind::Handle => { return true; }
        TokenKind::Do => { return true; }
        TokenKind::Interrupt => { return true; }
        TokenKind::Extern => { return true; }
        TokenKind::Guard => { return true; }
        TokenKind::Is => { return true; }
        TokenKind::True => { return true; }
        TokenKind::False => { return true; }
        TokenKind::Layer => { return true; }
        TokenKind::Model => { return true; }
        TokenKind::Grad => { return true; }
        TokenKind::Backward => { return true; }
        TokenKind::Kernel => { return true; }
        TokenKind::Component => { return true; }
        TokenKind::System => { return true; }
        TokenKind::Query => { return true; }
        TokenKind::State => { return true; }
        TokenKind::On => { return true; }
        // Everything else: types, literals, operators, punctuation, Eof
        TokenKind::I8 => { return false; }
        TokenKind::I16 => { return false; }
        TokenKind::I32 => { return false; }
        TokenKind::I64 => { return false; }
        TokenKind::I128 => { return false; }
        TokenKind::U8 => { return false; }
        TokenKind::U16 => { return false; }
        TokenKind::U32 => { return false; }
        TokenKind::U64 => { return false; }
        TokenKind::U128 => { return false; }
        TokenKind::F32 => { return false; }
        TokenKind::F64 => { return false; }
        TokenKind::Bool => { return false; }
        TokenKind::Str => { return false; }
        TokenKind::Void => { return false; }
        TokenKind::IntLit(n: i64) => { return false; }
        TokenKind::FloatLit(f: f64) => { return false; }
        TokenKind::StringLit(s: str) => { return false; }
        TokenKind::FString(s: str) => { return false; }
        TokenKind::Ident(s: str) => { return false; }
        TokenKind::Plus => { return false; }
        TokenKind::Minus => { return false; }
        TokenKind::Star => { return false; }
        TokenKind::Slash => { return false; }
        TokenKind::Percent => { return false; }
        TokenKind::Eq => { return false; }
        TokenKind::EqEq => { return false; }
        TokenKind::BangEq => { return false; }
        TokenKind::Lt => { return false; }
        TokenKind::Gt => { return false; }
        TokenKind::LtEq => { return false; }
        TokenKind::GtEq => { return false; }
        TokenKind::Bang => { return false; }
        TokenKind::And => { return false; }
        TokenKind::Ampersand => { return false; }
        TokenKind::Or => { return false; }
        TokenKind::Pipe => { return false; }
        TokenKind::PipeArrow => { return false; }
        TokenKind::Caret => { return false; }
        TokenKind::Tilde => { return false; }
        TokenKind::Shl => { return false; }
        TokenKind::Shr => { return false; }
        TokenKind::DotDot => { return false; }
        TokenKind::DotDotEq => { return false; }
        TokenKind::TildeArrow => { return false; }
        TokenKind::PlusEq => { return false; }
        TokenKind::MinusEq => { return false; }
        TokenKind::StarEq => { return false; }
        TokenKind::SlashEq => { return false; }
        TokenKind::PercentEq => { return false; }
        TokenKind::AmpEq => { return false; }
        TokenKind::PipeEq => { return false; }
        TokenKind::CaretEq => { return false; }
        TokenKind::ShlEq => { return false; }
        TokenKind::ShrEq => { return false; }
        TokenKind::Arrow => { return false; }
        TokenKind::FatArrow => { return false; }
        TokenKind::Dot => { return false; }
        TokenKind::Comma => { return false; }
        TokenKind::Colon => { return false; }
        TokenKind::Semicolon => { return false; }
        TokenKind::DoubleColon => { return false; }
        TokenKind::Question => { return false; }
        TokenKind::QuestionQuestion => { return false; }
        TokenKind::QuestionDot => { return false; }
        TokenKind::Hash => { return false; }
        TokenKind::At => { return false; }
        TokenKind::LBracket => { return false; }
        TokenKind::RBracket => { return false; }
        TokenKind::LParen => { return false; }
        TokenKind::RParen => { return false; }
        TokenKind::LBrace => { return false; }
        TokenKind::RBrace => { return false; }
        TokenKind::Eof => { return false; }
    }
}
