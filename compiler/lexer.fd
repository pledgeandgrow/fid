// lexer.fd -- Fides lexer, SH-7.1 rewrite of src/lexer.rs (589 LOC Rust)
//
// Takes a source string and produces a Vec<Token> token stream.
// Handles: identifiers, keywords, numbers (dec/hex/bin/oct/float), strings,
// f-strings, raw strings (r"...", r#"..."#), operators, comments (line/block).
// Tracks line/column for error messages and collects lex errors in a Vec.
//
// Scanning model: byte-based via str_byte_at. Column counting is UTF-8-aware
// (a multi-byte code point counts as one column, matching Rust's Vec<char>
// lexer). As of the current test corpus all non-ASCII appears only in line
// comments, so byte/char col tracking coincide; the UTF-8 handling is a
// safety net for future string-literal content.
//
// Dependencies: compiler::token (TokenKind, Token, token_new)

module compiler::lexer;
use vec;
use core;
use compiler::token;
// --- Lexer ----------------------------------------------------------------

pub struct Lexer {
    pub source: str,
    pub src_len: i64,
    // Cached length -- avoids O(n) str_len on every peek()
    pub pos: i64,
    pub line: i64,
    pub col: i64,
    /// Collected error messages (instead of printing directly).
    pub errors: Vec<str>,
    /// SP9: the words found to be no keyword, in a map of this lexer's own
    /// (a lexer on a worker thread, lex_text_alone); 0: the shared
    /// g_lex_not_kw (one thread).
    pub own_kw: i64,
}

impl Lexer {
    pub fn new(source: str) -> Lexer {
        return Lexer {
            source: source, src_len: str_len(source), pos: 0, line: 1, col: 1, errors: Vec::new(), own_kw: 0,
        };
    }

    /// Tokenize the entire source. Returns Vec<Token> ending with an Eof token.
    pub fn tokenize(self: &mut Lexer) -> Vec<Token> {
        var tokens: Vec<Token> = Vec::new();

        while self.pos < self.src_len {
            var c: i64 = self.peek();

            if lex_is_whitespace(c) {
                self.advance();
            } else if c == 47 && self.peek_at(1) == 47 {
                // "//" line comment
                self.skip_line_comment();
            } else if c == 47 && self.peek_at(1) == 42 {
                // "/*" block comment
                self.skip_block_comment();
            } else if c == 102 && self.peek_at(1) == 34 {
                // f"..." f-string
                tokens.push(self.read_fstring());
            } else if c == 114 && (self.peek_at(1) == 34 || self.peek_at(1) == 35) {
                // r"..." or r#"..."# raw string
                tokens.push(self.read_raw_string());
            } else if lex_is_alpha(c) || c == 95 {
                // 'a'..'z' | 'A'..'Z' | '_'
                tokens.push(self.read_identifier_or_keyword());
            } else if lex_is_digit(c) {
                tokens.push(self.read_number());
            } else if c == 34 {
                // '"'
                tokens.push(self.read_string());
            } else if c == 39 && self.lifetime_ahead() {
                // `'a` (LG3): a lifetime name, not the char literal `'a'`
                tokens.push(self.read_lifetime());
            } else if c == 39 {
                // '\''
                tokens.push(self.read_char_lit());
            } else {
                tokens.push(self.read_operator());
            }
        }

        tokens.push(token_new(TokenKind::Eof, self.line, self.col));
        return tokens;
    }

    /// Peek the current byte, or 0 (NUL) at EOF.
    fn peek(self: &Lexer) -> i64 {
        if self.pos >= self.src_len {
            return 0;
        }
        return str_byte_at(self.source, self.pos);
    }

    /// Peek the byte at `offset` past the current position, or -1 if out of
    /// bounds. (Rust returns Option<char>; we use -1 as the "None" sentinel.
    /// Callers compare against specific byte values, never against 0, since 0
    /// is a valid NUL byte -- using -1 avoids a false match at EOF.)
    fn peek_at(self: &Lexer, offset: i64) -> i64 {
        var idx: i64 = self.pos + offset;
        if idx >= self.src_len {
            return -1;
        }
        return str_byte_at(self.source, idx);
    }

    /// Consume and return the current byte, advancing position and updating
    /// line/col. Multi-byte UTF-8 sequences count as a single column.
    fn advance(self: &mut Lexer) -> i64 {
        var c: i64 = self.peek();
        self.pos = self.pos + 1;
        if c == 10 {
            // '\n'
            self.line = self.line + 1;
            self.col = 1;
        } else if c < 128 {
            // ASCII (excluding newline, handled above)
            self.col = self.col + 1;
        } else {
            // UTF-8 multi-byte sequence: count as one column.
            // Skip continuation bytes (0b10xxxxxx == 0x80..0xBF).
            self.col = self.col + 1;
            while self.pos < self.src_len {
                var nb: i64 = str_byte_at(self.source, self.pos);
                if nb >= 128 && nb < 192 {
                    // continuation byte 0x80..0xBF
                    self.pos = self.pos + 1;
                } else {
                    break;
                }
            }
        }
        return c;
    }

    /// Read the UTF-8 character at the current position as a string,
    /// advancing past all its bytes. Unlike `byte_to_str(advance())`,
    /// this captures multi-byte sequences (e.g. em-dash -- is 3 bytes).
    fn read_utf8(self: &mut Lexer) -> str {
        var c: i64 = self.peek();
        if c < 128 {
            // ASCII -- single byte
            return byte_to_str(self.advance());
        }
        // Multi-byte UTF-8: determine sequence length from the start byte.
        //   0xC0..0xDF -> 2 bytes
        //   0xE0..0xEF -> 3 bytes
        //   0xF0..0xF7 -> 4 bytes
        var seqlen: i64 = 2;
        if c >= 240 {
            seqlen = 4;
        } else if c >= 224 {
            seqlen = 3;
        }
        // Capture all bytes of the sequence
        var s: str = "";
        var i: i64 = 0;
        while i < seqlen && self.pos < self.src_len {
            s = str_concat(s, byte_to_str(str_byte_at(self.source, self.pos)));
            self.pos = self.pos + 1;
            i = i + 1;
        }
        // Update column (one column per character, regardless of byte count)
        if c == 10 {
            self.line = self.line + 1;
            self.col = 1;
        } else {
            self.col = self.col + 1;
        }
        return s;
    }

    /// Decode one UTF-8 scalar at the cursor and advance past it.
    fn read_codepoint(self: &mut Lexer) -> i64 {
        var c: i64 = self.peek();
        if c < 128 {
            return self.advance();
        }
        var extra: i64 = 1;
        var cp: i64 = c & 31;
        if c >= 240 {
            extra = 3;
            cp = c & 7;
        } else if c >= 224 {
            extra = 2;
            cp = c & 15;
        }
        var i: i64 = 1;
        while i <= extra && self.pos + i < self.src_len {
            cp = cp * 64 + (str_byte_at(self.source, self.pos + i) & 63);
            i = i + 1;
        }
        self.advance();
        // consumes the lead byte and its continuation bytes
        return cp;
    }

    /// Read N hex digits (N = 2 for \xHH) or up to '}' (for \u{...}).
    fn read_hex_value(self: &mut Lexer, line: i64, col: i64, max_digits: i64, until_brace: bool) -> i64 {
        var v: i64 = 0;
        var n: i64 = 0;
        while self.pos < self.src_len && n < max_digits {
            var d: i64 = self.peek();
            if until_brace && d == 125 {
                break;
            }
            if !lex_is_hexdigit(d) {
                self.errors.push(lex_error(line, col, "invalid hex digit in escape\n    Fix: use the hex digits 0-9 and a-f (or A-F), as in \"\\x41\" or \"\\u{e9}\""));
                return 0;
            }
            if d <= 57 {
                v = v * 16 + (d - 48);
            } else if d <= 70 {
                v = v * 16 + (d - 55);
            } else {
                v = v * 16 + (d - 87);
            }
            self.advance();
            n = n + 1;
        }
        if until_brace {
            if self.peek() == 125 {
                self.advance();
            } else {
                self.errors.push(lex_error(line, col, "expected '}' to close \\u{...}\n    Fix: close the code point with `}` after at most 6 hex digits, as in \"\\u{1F600}\""));
            }
        } else if n != max_digits {
            self.errors.push(lex_error(line, col, "\\x expects 2 hex digits\n    Fix: write two hex digits after \\x, as in \"\\x0a\" (a leading 0 for a small value)"));
        }
        return v;
    }

    /// At a `'`: whether a lifetime name follows -- a letter or `_`, then
    /// letters, digits and `_` with no closing `'` after them (`'a'` is a
    /// char literal, `'a` and `'static` are lifetimes).
    fn lifetime_ahead(self: &Lexer) -> bool {
        var c1: i64 = self.peek_at(1);
        if !(lex_is_alpha(c1) || c1 == 95) {
            return false;
        }
        var j: i64 = 2;
        while lex_is_alphanumeric(self.peek_at(j)) || self.peek_at(j) == 95 {
            j = j + 1;
        }
        return self.peek_at(j) != 39;
    }

    /// A lifetime name `'a`; the token's text keeps the quote.
    fn read_lifetime(self: &mut Lexer) -> Token {
        var line: i64 = self.line;
        var col: i64 = self.col;
        self.advance();
        var name: str = "'";
        while self.pos < self.src_len && (lex_is_alphanumeric(self.peek()) || self.peek() == 95) {
            name = name + byte_to_str(self.advance());
        }
        return token_new(TokenKind::Lifetime(name), line, col);
    }

    /// R1.7: char literal 'c' -> IntLit holding the Unicode scalar value, so it
    /// compares directly against str_byte_at results. Same escapes as strings
    /// plus \' (and \x / \u{...}).
    fn read_char_lit(self: &mut Lexer) -> Token {
        var line: i64 = self.line;
        var col: i64 = self.col;
        self.advance();
        // consume opening '\''

        var v: i64 = 0;
        var c: i64 = self.peek();
        if self.pos >= self.src_len || c == 39 || c == 10 {
            self.errors.push(lex_error(line, col, "empty char literal\n    Fix: a char literal holds one character, as in 'a' or '\\n'; for no text use the empty string \"\""));
        } else if c == 92 {
            self.advance();
            var esc: i64 = self.advance();
            if esc == 110 {
                v = 10;
            }  // n
            else if esc == 116 {
                v = 9;
            }  // t
            else if esc == 114 {
                v = 13;
            }  // r
            else if esc == 92 {
                v = 92;
            }  // backslash
            else if esc == 39 {
                v = 39;
            }  // '\''
            else if esc == 34 {
                v = 34;
            }  // '"'
            else if esc == 48 {
                v = 0;
            }  // NUL
            else if esc == 120 {
                v = self.read_hex_value(line, col, 2, false);
            }  // \xHH
            else if esc == 117 && self.peek() == 123 {
                // \u{...}
                self.advance();
                v = self.read_hex_value(line, col, 6, true);
            } else {
                self.errors.push(lex_error(line, col, "unknown escape sequence \\" + byte_to_str(esc) + "\n    Fix: the escapes of a char literal are \\n \\t \\r \\0 \\\\ \\' \\\" \\xHH and \\u{...}; write '\\\\' for a backslash"));
                v = esc;
            }
        } else {
            v = self.read_codepoint();
        }

        if self.peek() == 39 {
            self.advance();
            // consume closing '\''
        } else {
            self.errors.push(lex_error(line, col, "unterminated char literal\n    Fix: a char literal holds one character: 'a', or use a string \"ab\""));
        }

        return token_new(TokenKind::IntLit(v), line, col);
    }

    fn skip_line_comment(self: &mut Lexer) {
        while self.pos < self.src_len && self.peek() != 10 {
            self.advance();
        }
    }

    fn skip_block_comment(self: &mut Lexer) {
        self.advance();
        // consume '/'
        self.advance();
        // consume '*'
        while self.pos < self.src_len {
            if self.peek() == 42 && self.peek_at(1) == 47 {
                // "*/"
                self.advance();
                self.advance();
                return;
            }
            self.advance();
        }
    }

    fn read_identifier_or_keyword(self: &mut Lexer) -> Token {
        var line: i64 = self.line;
        var col: i64 = self.col;
        var start_pos: i64 = self.pos;

        while self.pos < self.src_len {
            var c: i64 = self.peek();
            if lex_is_alphanumeric(c) || c == 95 {
                self.advance();
            } else {
                break;
            }
        }

        // Extract the identifier directly from the source string
        // instead of building it char-by-char with str_concat (O(n^2)).
        var s: str = str_slice_len(self.source, self.src_len, start_pos, self.pos);
        var kind: TokenKind = keyword_or_ident_own(self.own_kw, s);
        return token_new(kind, line, col);
    }

    fn read_number(self: &mut Lexer) -> Token {
        var line: i64 = self.line;
        var col: i64 = self.col;
        var start_pos: i64 = self.pos;

        // Hex / binary / octal prefixes
        if self.peek() == 48 {
            // '0'
            var next: i64 = self.peek_at(1);
            if next == 120 || next == 88 {
                // 0x / 0X
                self.advance();
                // 0
                self.advance();
                // x
                while self.pos < self.src_len && lex_is_hexdigit(self.peek()) {
                    self.advance();
                }
                var s: str = str_slice_len(self.source, self.src_len, start_pos, self.pos);
                var val: i64 = str_parse_hex(str_slice(s, 2, str_len(s)));
                self.check_int_fits(str_slice(s, 2, str_len(s)), 16, s, line, col);
                return token_new(TokenKind::IntLit(val), line, col);
            }
            if next == 98 || next == 66 {
                // 0b / 0B
                self.advance();
                // 0
                self.advance();
                // b
                while self.pos < self.src_len && (self.peek() == 48 || self.peek() == 49) {
                    self.advance();
                }
                var s: str = str_slice_len(self.source, self.src_len, start_pos, self.pos);
                var val: i64 = parse_radix(str_slice(s, 2, str_len(s)), 2);
                self.check_int_fits(str_slice(s, 2, str_len(s)), 2, s, line, col);
                return token_new(TokenKind::IntLit(val), line, col);
            }
            if next == 111 || next == 79 {
                // 0o / 0O
                self.advance();
                // 0
                self.advance();
                // o
                while self.pos < self.src_len && self.peek() >= 48 && self.peek() <= 55 {
                    self.advance();
                }
                var s: str = str_slice_len(self.source, self.src_len, start_pos, self.pos);
                var val: i64 = parse_radix(str_slice(s, 2, str_len(s)), 8);
                self.check_int_fits(str_slice(s, 2, str_len(s)), 8, s, line, col);
                return token_new(TokenKind::IntLit(val), line, col);
            }
        }  // Decimal integer part (with optional '_' separators)
        while self.pos < self.src_len && (lex_is_digit(self.peek()) || self.peek() == 95) {
            self.advance();
        }

        // Float: fractional part
        if self.peek() == 46 && lex_is_digit(self.peek_at(1)) {
            // '.' followed by digit
            self.advance();
            // '.'
            while self.pos < self.src_len && (lex_is_digit(self.peek()) || self.peek() == 95) {
                self.advance();
            }
            // Optional exponent e[+-]?digits
            if self.peek() == 101 || self.peek() == 69 {
                // 'e' / 'E'
                self.advance();
                if self.peek() == 43 || self.peek() == 45 {
                    // '+' / '-'
                    self.advance();
                }
                while self.pos < self.src_len && lex_is_digit(self.peek()) {
                    self.advance();
                }
            }
            // Build string without underscores
            var raw: str = str_slice_len(self.source, self.src_len, start_pos, self.pos);
            var s: str = str_filter_underscores(raw);
            var val: f64 = str_parse_float(s);
            return token_new(TokenKind::FloatLit(val), line, col);
        }

        // Float with an exponent and no fraction: `5e3`, `1E-9` (known-bugs
        // 2g.18: lexed as 5 then the name e3). Only when digits follow the
        // e (after an optional sign), so `5.e` and names stay as they were.
        if self.peek() == 101 || self.peek() == 69 {
            var ex: i64 = 1;
            if self.peek_at(1) == 43 || self.peek_at(1) == 45 {
                ex = 2;
            }
            if lex_is_digit(self.peek_at(ex)) {
                var k: i64 = 0;
                while k < ex {
                    self.advance();
                    k = k + 1;
                }
                while self.pos < self.src_len && lex_is_digit(self.peek()) {
                    self.advance();
                }
                var eraw: str = str_slice_len(self.source, self.src_len, start_pos, self.pos);
                var es: str = str_filter_underscores(eraw);
                return token_new(TokenKind::FloatLit(str_parse_float(es)), line, col);
            }
        }

        // Build string without underscores
        var raw: str = str_slice_len(self.source, self.src_len, start_pos, self.pos);
        var s: str = str_filter_underscores(raw);
        var val: i64 = lex_parse_int(s);
        self.check_int_fits(s, 10, raw, line, col);
        return token_new(TokenKind::IntLit(val), line, col);
    }

    /// BG61: an integer literal of 2^64 or more is an error (it wrapped
    /// silently: 18446744073709551616 was 0). `digits` are the literal's
    /// digits in `radix` without its prefix or `_`, `text` as written.
    fn check_int_fits(self: &mut Lexer, digits: str, radix: i64, text: str, line: i64, col: i64) {
        if lex_int_too_big(digits, radix) {
            self.errors.push(lex_error(line, col, "integer literal " + text + " does not fit in 64 bits\n    Fix: no integer type holds 2^64 or more (u64::MAX is 18446744073709551615); for a bigger number use a float such as 1.0e20, or a big-integer type"));
        }
    }

    /// Remove underscore separators from a numeric string (e.g. "1_000" -> "1000")

    fn read_fstring(self: &mut Lexer) -> Token {
        var line: i64 = self.line;
        var col: i64 = self.col;
        self.advance();
        // consume 'f'
        self.advance();
        // consume opening '"'

        var s: str = "";
        while self.pos < self.src_len && self.peek() != 34 {
            var c: i64 = self.peek();
            if c == 92 {
                // '\'
                self.advance();
                var esc: i64 = self.advance();
                if esc == 110 {
                    s = str_concat(s, "\n");
                }  // n
                else if esc == 116 {
                    s = str_concat(s, "\t");
                }  // t
                else if esc == 114 {
                    s = str_concat(s, "\r");
                }  // r
                else if esc == 92 {
                    s = str_concat(s, "\\");
                }  // backslash
                else if esc == 34 {
                    s = str_concat(s, "\"");
                }  // '"'
                else if esc == 48 {
                    s = str_concat(s, char_to_str(0));
                }  // NUL: a byte of the string (RT2; its length is stored)
                else if esc == 120 || (esc == 117 && self.peek() == 123) {
                    // xHH, u{...}
                    var hv: i64 = 0;
                    if esc == 120 {
                        hv = self.read_hex_value(line, col, 2, false);
                    } else {
                        self.advance();
                        hv = self.read_hex_value(line, col, 6, true);
                    }
                    if hv == 0 {
                        s = str_concat(s, char_to_str(0));
                    }  // NUL: a byte of the string (RT2)
                    else {
                        s = str_concat(s, lex_utf8_encode(hv));
                    }
                } else {
                    self.errors.push(lex_error(line, col, "unknown escape sequence \\" + byte_to_str(esc) + "\n    Fix: the escapes are \\n \\t \\r \\0 \\\\ \\' \\\" \\xHH and \\u{...}; write \\\\ for a backslash itself, or a raw string r\"...\""));
                    s = str_concat(s, byte_to_str(esc));
                }
            } else if c == 123 {
                // '{' -- expression interpolation {expr}
                self.advance();
                // consume '{'
                s = str_concat(s, "{");
                var depth: i64 = 1;
                while self.pos < self.src_len && depth > 0 {
                    var c2: i64 = self.peek();
                    if c2 == 123 {
                        depth = depth + 1;
                        s = str_concat(s, byte_to_str(self.advance()));
                    } else if c2 == 125 {
                        // '}'
                        depth = depth - 1;
                        if depth == 0 {
                            self.advance();
                            // consume '}'
                            s = str_concat(s, "}");
                            break;
                        }
                        s = str_concat(s, self.read_utf8());
                    } else {
                        s = str_concat(s, self.read_utf8());
                    }
                }
            } else {
                s = str_concat(s, self.read_utf8());
            }
        }

        if self.pos < self.src_len {
            self.advance();
            // consume closing '"'
        } else {
            self.errors.push(lex_error(line, col, "unterminated f-string\n    Fix: end the f-string with `\"` on the same line (write \\n for a line break), and close each `{` with `}`"));
        }

        return token_new(TokenKind::FString(s), line, col);
    }

    fn read_string(self: &mut Lexer) -> Token {
        var line: i64 = self.line;
        var col: i64 = self.col;
        self.advance();
        // consume opening '"'

        var s: str = "";
        while self.pos < self.src_len && self.peek() != 34 {
            var c: i64 = self.peek();
            if c == 92 {
                // '\'
                self.advance();
                var esc: i64 = self.advance();
                if esc == 110 {
                    s = str_concat(s, "\n");
                }  // n
                else if esc == 116 {
                    s = str_concat(s, "\t");
                }  // t
                else if esc == 114 {
                    s = str_concat(s, "\r");
                }  // r
                else if esc == 92 {
                    s = str_concat(s, "\\");
                }  // backslash
                else if esc == 34 {
                    s = str_concat(s, "\"");
                }  // '"'
                else if esc == 48 {
                    s = str_concat(s, char_to_str(0));
                }  // NUL: a byte of the string (RT2; its length is stored)
                else if esc == 120 || (esc == 117 && self.peek() == 123) {
                    // xHH, u{...}
                    var hv: i64 = 0;
                    if esc == 120 {
                        hv = self.read_hex_value(line, col, 2, false);
                    } else {
                        self.advance();
                        hv = self.read_hex_value(line, col, 6, true);
                    }
                    if hv == 0 {
                        s = str_concat(s, char_to_str(0));
                    }  // NUL: a byte of the string (RT2)
                    else {
                        s = str_concat(s, lex_utf8_encode(hv));
                    }
                } else {
                    self.errors.push(lex_error(line, col, "unknown escape sequence \\" + byte_to_str(esc) + "\n    Fix: the escapes are \\n \\t \\r \\0 \\\\ \\' \\\" \\xHH and \\u{...}; write \\\\ for a backslash itself, or a raw string r\"...\""));
                    s = str_concat(s, byte_to_str(esc));
                }
            } else {
                s = str_concat(s, self.read_utf8());
            }
        }

        if self.pos < self.src_len {
            self.advance();
            // consume closing '"'
        } else {
            self.errors.push(lex_error(line, col, "unterminated string\n    Fix: end the string with `\"`; write \\\" for a quote inside it and \\n for a line break"));
        }

        return token_new(TokenKind::StringLit(s), line, col);
    }

    /// Read a raw string: r"..." or r#"..."# (with N hash signs).
    /// No escape sequences are processed -- content is taken literally.
    /// The closing delimiter is '"' followed by the same number of '#'.
    fn read_raw_string(self: &mut Lexer) -> Token {
        var line: i64 = self.line;
        var col: i64 = self.col;
        self.advance();
        // consume 'r'

        // Count '#' signs (0 or more)
        var hash_count: i64 = 0;
        while self.peek() == 35 {
            self.advance();
            hash_count = hash_count + 1;
        }

        // Expect opening '"'
        if self.peek() != 34 {
            self.errors.push(lex_error(line, col, "expected '\"' after r" + repeat_char(35, hash_count) + "\n    Fix: a raw string is r\"...\" or r#\"...\"# (the same number of # on both sides)"));
            return token_new(TokenKind::StringLit(""), line, col);
        }
        self.advance();
        // consume opening '"'

        var s: str = "";
        // Read until we find '"' followed by exactly hash_count '#' signs
        while self.pos < self.src_len {
            if self.peek() == 34 {
                // Check if this is the closing delimiter
                var matched: bool = true;
                var i: i64 = 0;
                while i < hash_count {
                    if self.peek_at(1 + i) != 35 {
                        matched = false;
                        break;
                    }
                    i = i + 1;
                }
                if matched {
                    self.advance();
                    // consume '"'
                    var j: i64 = 0;
                    while j < hash_count {
                        self.advance();
                        // consume each '#'
                        j = j + 1;
                    }
                    return token_new(TokenKind::StringLit(s), line, col);
                }
            }
            s = str_concat(s, self.read_utf8());
        }

        self.errors.push(lex_error(line, col, "unterminated raw string\n    Fix: end it with `\"` followed by as many # as after the r that opened it, as in r#\"a \"b\" c\"#"));
        return token_new(TokenKind::StringLit(s), line, col);
    }

    fn read_operator(self: &mut Lexer) -> Token {
        var line: i64 = self.line;
        var col: i64 = self.col;
        var op_start: i64 = self.pos;
        var c: i64 = self.advance();

        var kind: TokenKind = TokenKind::Eof;

        if c == 43 {
            // '+'
            if self.peek() == 61 {
                self.advance();
                kind = TokenKind::PlusEq;
            } else {
                kind = TokenKind::Plus;
            }
        } else if c == 45 {
            // '-'
            if self.peek() == 62 {
                self.advance();
                kind = TokenKind::Arrow;
            }  // '->'
            else if self.peek() == 61 {
                self.advance();
                kind = TokenKind::MinusEq;
            }  // '-='
            else {
                kind = TokenKind::Minus;
            }
        } else if c == 42 {
            // '*'
            if self.peek() == 61 {
                self.advance();
                kind = TokenKind::StarEq;
            } else {
                kind = TokenKind::Star;
            }
        } else if c == 47 {
            // '/'
            if self.peek() == 61 {
                self.advance();
                kind = TokenKind::SlashEq;
            } else {
                kind = TokenKind::Slash;
            }
        } else if c == 37 {
            // '%'
            if self.peek() == 61 {
                self.advance();
                kind = TokenKind::PercentEq;
            } else {
                kind = TokenKind::Percent;
            }
        } else if c == 61 {
            // '='
            if self.peek() == 61 {
                self.advance();
                kind = TokenKind::EqEq;
            }  // '=='
            else if self.peek() == 62 {
                self.advance();
                kind = TokenKind::FatArrow;
            }  // '=>'
            else {
                kind = TokenKind::Eq;
            }
        } else if c == 33 {
            // '!'
            if self.peek() == 61 {
                self.advance();
                kind = TokenKind::BangEq;
            } else {
                kind = TokenKind::Bang;
            }
        } else if c == 60 {
            // '<'
            if self.peek() == 61 {
                self.advance();
                kind = TokenKind::LtEq;
            }  // '<='
            else if self.peek() == 60 {
                self.advance();
                // consume second '<'
                if self.peek() == 61 {
                    self.advance();
                    kind = TokenKind::ShlEq;
                }  // '<<='
                else {
                    kind = TokenKind::Shl;
                }
                // '<<'
            } else {
                kind = TokenKind::Lt;
            }
        } else if c == 62 {
            // '>'
            if self.peek() == 61 {
                self.advance();
                kind = TokenKind::GtEq;
            }  // '>='
            else if self.peek() == 62 {
                self.advance();
                // consume second '>'
                if self.peek() == 61 {
                    self.advance();
                    kind = TokenKind::ShrEq;
                }  // '>>='
                else {
                    kind = TokenKind::Shr;
                }
                // '>>'
            } else {
                kind = TokenKind::Gt;
            }
        } else if c == 38 {
            // '&'
            if self.peek() == 38 {
                self.advance();
                kind = TokenKind::And;
            }  // '&&'
            else if self.peek() == 61 {
                self.advance();
                kind = TokenKind::AmpEq;
            }  // '&='
            else {
                kind = TokenKind::Ampersand;
            }
        } else if c == 124 {
            // '|'
            if self.peek() == 124 {
                self.advance();
                kind = TokenKind::Or;
            }  // '||'
            else if self.peek() == 62 {
                self.advance();
                kind = TokenKind::PipeArrow;
            }  // '|>'
            else if self.peek() == 61 {
                self.advance();
                kind = TokenKind::PipeEq;
            }  // '|='
            else {
                kind = TokenKind::Pipe;
            }
        } else if c == 94 {
            // '^'
            if self.peek() == 61 {
                self.advance();
                kind = TokenKind::CaretEq;
            } else {
                kind = TokenKind::Caret;
            }
        } else if c == 126 {
            // '~'
            if self.peek() == 62 {
                self.advance();
                kind = TokenKind::TildeArrow;
            }  // '~>'
            else {
                kind = TokenKind::Tilde;
            }
        } else if c == 46 {
            // '.'
            if self.peek() == 46 {
                self.advance();
                // consume second '.'
                if self.peek() == 61 {
                    self.advance();
                    kind = TokenKind::DotDotEq;
                }  // '..='
                else if self.peek() == 46 {
                    self.advance();
                    kind = TokenKind::DotDotDot;
                }  // '...'
                else {
                    kind = TokenKind::DotDot;
                }
                // '..'
            } else {
                kind = TokenKind::Dot;
            }
        } else if c == 35 {
            // '#'
            kind = TokenKind::Hash;
        } else if c == 64 {
            // '@'
            kind = TokenKind::At;
        } else if c == 44 {
            // ','
            kind = TokenKind::Comma;
        } else if c == 58 {
            // ':'
            if self.peek() == 58 {
                self.advance();
                kind = TokenKind::DoubleColon;
            } else {
                kind = TokenKind::Colon;
            }
        } else if c == 59 {
            // ';'
            kind = TokenKind::Semicolon;
        } else if c == 63 {
            // '?'
            if self.peek() == 63 {
                self.advance();
                kind = TokenKind::QuestionQuestion;
            }  // '??'
            else if self.peek() == 46 {
                self.advance();
                kind = TokenKind::QuestionDot;
            }  // '?.'
            else {
                kind = TokenKind::Question;
            }
        } else if c == 40 {
            // '('
            kind = TokenKind::LParen;
        } else if c == 41 {
            // ')'
            kind = TokenKind::RParen;
        } else if c == 123 {
            // '{'
            kind = TokenKind::LBrace;
        } else if c == 125 {
            // '}'
            kind = TokenKind::RBrace;
        } else if c == 91 {
            // '['
            kind = TokenKind::LBracket;
        } else if c == 93 {
            // ']'
            kind = TokenKind::RBracket;
        } else {
            // 2g.18: an error token, not Eof. An Eof here ended the stream:
            // compiler.fd does not look at an imported module's lex errors,
            // so the rest of the module was dropped without a word. The
            // parser rejects this token where it stands. The text is the
            // whole character (advance took every byte of a UTF-8 one).
            var bad: str = str_slice_len(self.source, self.src_len, op_start, self.pos);
            self.errors.push(lex_error(line, col, "unexpected character '" + bad + "'\n    Fix: remove it, or put it in a string or a comment; outside them only letters, digits, `_` and the operators of the reference (§2) are allowed"));
            kind = TokenKind::BadChar(bad);
        }

        return token_new(kind, line, col);
    }
}

/// Remove underscore separators from a numeric string (e.g. "1_000" -> "1000")
pub fn str_filter_underscores(s: str) -> str {
    var result: str = "";
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c != 95 {
            result = str_concat(result, byte_to_str(c));
        }
        i = i + 1;
    }
    return result;
}

// --- Keyword table --------------------------------------------------------
// Maps an identifier string to its TokenKind, or TokenKind::Ident(s) if it
// is not a reserved word. Mirrors the `match s.as_str()` block in lexer.rs.
// Note: "q8" and "q4" (quantized 8/4-bit, stored in i8) are not reserved:
// they lex as identifiers, and parse_type reads them as i8, so `q4` can
// also name a variable (stdlib-agent-bugs 13). Only an exact keyword
// spelling is a keyword (`i8x`, `f64s` are identifiers).

/// CS4: the words of at most 10 bytes keyword_or_ident found to be no
/// keyword (a HashMap handle, made on first use; the lexer runs on one
/// thread). keyword_or_ident_chain is a function of the word alone, so
/// its answer for a word never changes.
var g_lex_not_kw: i64 = 0;

pub fn keyword_or_ident(s: str) -> TokenKind {
    // Fast path: all keywords are <= 10 chars. Skip keyword checks for
    // longer identifiers -- they are definitely identifiers, not keywords.
    // This avoids ~60 str_equal calls for most identifiers.
    var slen: i64 = str_len(s);
    if slen > 10 {
        return TokenKind::Ident(s);
    }
    // CS4: a word already found to be no keyword is not compared with the
    // ~90 keywords again (an identifier is met many times in a file)
    if g_lex_not_kw == 0 {
        g_lex_not_kw = HashMap_new();
    }
    if HashMap_contains(g_lex_not_kw, s) {
        return TokenKind::Ident(s);
    }
    var kw: TokenKind = keyword_or_ident_chain(s);
    match kw {
        TokenKind::Ident(_) => {
            HashMap_insert(g_lex_not_kw, s, 1);
        }
        _ => {
        }
    }
    return kw;
}

/// SP9: keyword_or_ident with the not-a-keyword words kept in `own` (a map
/// of one lexer, so lexers on several threads share nothing); `own` 0 is
/// keyword_or_ident itself. The same answer for every word.
pub fn keyword_or_ident_own(own: i64, s: str) -> TokenKind {
    if own == 0 {
        return keyword_or_ident(s);
    }
    if str_len(s) > 10 {
        return TokenKind::Ident(s);
    }
    if HashMap_contains(own, s) {
        return TokenKind::Ident(s);
    }
    var kw: TokenKind = keyword_or_ident_chain(s);
    match kw {
        TokenKind::Ident(_) => {
            HashMap_insert(own, s, 1);
        }
        _ => {
        }
    }
    return kw;
}

/// The keyword checks of keyword_or_ident, one group after another.
fn keyword_or_ident_chain(s: str) -> TokenKind {
    // -- Keywords (split into small groups to keep generated C functions
    // small enough for TCC to compile without dropping statements) --
    var kind: TokenKind = keyword_or_ident_a(s);
    match kind {
        TokenKind::Ident(_) => {
            var kind2: TokenKind = keyword_or_ident_b(s);
            match kind2 {
                TokenKind::Ident(_) => {
                    var kind3: TokenKind = keyword_or_ident_c(s);
                    match kind3 {
                        TokenKind::Ident(_) => {
                            var kind4: TokenKind = keyword_or_ident_d(s);
                            match kind4 {
                                TokenKind::Ident(_) => {
                                    var kind5: TokenKind = keyword_or_ident_e(s);
                                    match kind5 {
                                        TokenKind::Ident(_) => {
                                            var kind6: TokenKind = keyword_or_ident_ml(s);
                                            match kind6 {
                                                TokenKind::Ident(_) => {
                                                    var kind7: TokenKind = keyword_or_ident_game(s);
                                                    match kind7 {
                                                        TokenKind::Ident(_) => {
                                                            return keyword_or_ident_type(s);
                                                        }
                                                        other7 => {
                                                            return other7;
                                                        }
                                                    }
                                                }
                                                other6 => {
                                                    return other6;
                                                }
                                            }
                                        }
                                        other5 => {
                                            return other5;
                                        }
                                    }
                                }
                                other4 => {
                                    return other4;
                                }
                            }
                        }
                        other3 => {
                            return other3;
                        }
                    }
                }
                other2 => {
                    return other2;
                }
            }
        }
        other => {
            return other;
        }
    }
}

fn keyword_or_ident_a(s: str) -> TokenKind {
    if s == "fn" {
        return TokenKind::Fn;
    }
    if s == "val" {
        return TokenKind::Val;
    }
    if s == "var" {
        return TokenKind::Var;
    }
    if s == "mut" {
        return TokenKind::Mut;
    }
    if s == "const" {
        return TokenKind::Const;
    }
    if s == "given" {
        return TokenKind::Given;
    }
    if s == "ensure" {
        return TokenKind::Ensure;
    }
    if s == "cap" {
        return TokenKind::Cap;
    }
    if s == "type" {
        return TokenKind::Type;
    }
    if s == "return" {
        return TokenKind::Return;
    }
    return TokenKind::Ident(s);
}

fn keyword_or_ident_b(s: str) -> TokenKind {
    if s == "if" {
        return TokenKind::If;
    }
    if s == "else" {
        return TokenKind::Else;
    }
    if s == "match" {
        return TokenKind::Match;
    }
    if s == "select" {
        return TokenKind::Select;
    }
    if s == "struct" {
        return TokenKind::Struct;
    }
    if s == "enum" {
        return TokenKind::Enum;
    }
    if s == "impl" {
        return TokenKind::Impl;
    }
    if s == "pub" {
        return TokenKind::Pub;
    }
    if s == "use" {
        return TokenKind::Use;
    }
    if s == "module" {
        return TokenKind::Module;
    }
    return TokenKind::Ident(s);
}

fn keyword_or_ident_c(s: str) -> TokenKind {
    if s == "with" {
        return TokenKind::With;
    }
    if s == "async" {
        return TokenKind::Async;
    }
    if s == "await" {
        return TokenKind::Await;
    }
    if s == "comptime" {
        return TokenKind::Comptime;
    }
    if s == "defer" {
        return TokenKind::Defer;
    }
    if s == "spawn" {
        return TokenKind::Spawn;
    }
    if s == "yield" {
        return TokenKind::Yield;
    }
    if s == "move" {
        return TokenKind::Move;
    }
    if s == "static" {
        return TokenKind::Static;
    }
    if s == "try" {
        return TokenKind::Try;
    }
    if s == "in" {
        return TokenKind::In;
    }
    return TokenKind::Ident(s);
}

fn keyword_or_ident_d(s: str) -> TokenKind {
    if s == "as" {
        return TokenKind::As;
    }
    if s == "dyn" {
        return TokenKind::Dyn;
    }
    if s == "where" {
        return TokenKind::Where;
    }
    if s == "region" {
        return TokenKind::Region;
    }
    if s == "sandbox" {
        return TokenKind::Sandbox;
    }
    if s == "unsafe" {
        return TokenKind::Unsafe;
    }
    if s == "txn" {
        return TokenKind::Txn;
    }
    if s == "persist" {
        return TokenKind::Persist;
    }
    if s == "for" {
        return TokenKind::For;
    }
    if s == "while" {
        return TokenKind::While;
    }
    return TokenKind::Ident(s);
}

fn keyword_or_ident_e(s: str) -> TokenKind {
    if s == "loop" {
        return TokenKind::Loop;
    }
    if s == "break" {
        return TokenKind::Break;
    }
    if s == "continue" {
        return TokenKind::Continue;
    }
    if s == "handle" {
        return TokenKind::Handle;
    }
    if s == "do" {
        return TokenKind::Do;
    }
    if s == "interrupt" {
        return TokenKind::Interrupt;
    }
    if s == "extern" {
        return TokenKind::Extern;
    }
    if s == "guard" {
        return TokenKind::Guard;
    }
    if s == "is" {
        return TokenKind::Is;
    }
    if s == "resume" {
        return TokenKind::Resume;
    }
    if s == "true" {
        return TokenKind::True;
    }
    if s == "false" {
        return TokenKind::False;
    }
    return TokenKind::Ident(s);
}

fn keyword_or_ident_ml(s: str) -> TokenKind {
    if s == "layer" {
        return TokenKind::Layer;
    }
    if s == "model" {
        return TokenKind::Model;
    }
    if s == "grad" {
        return TokenKind::Grad;
    }
    if s == "backward" {
        return TokenKind::Backward;
    }
    if s == "kernel" {
        return TokenKind::Kernel;
