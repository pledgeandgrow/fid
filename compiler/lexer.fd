fn keyword_or_ident_game(s: str) -> TokenKind {
    if s == "component" {
        return TokenKind::Component;
    }
    if s == "system" {
        return TokenKind::System;
    }
    if s == "query" {
        return TokenKind::Query;
    }
    if s == "state" {
        return TokenKind::State;
    }
    if s == "on" {
        return TokenKind::On;
    }
    return TokenKind::Ident(s);
}

fn keyword_or_ident_type(s: str) -> TokenKind {
    // q8/q4 (aliases of i8) are identifiers: parse_type maps them to i8
    if s == "i8" {
        return TokenKind::I8;
    }
    if s == "i16" {
        return TokenKind::I16;
    }
    if s == "i32" {
        return TokenKind::I32;
    }
    if s == "i64" {
        return TokenKind::I64;
    }
    if s == "i128" {
        return TokenKind::I128;
    }
    if s == "u8" {
        return TokenKind::U8;
    }
    if s == "u16" {
        return TokenKind::U16;
    }
    if s == "u32" {
        return TokenKind::U32;
    }
    if s == "u64" {
        return TokenKind::U64;
    }
    if s == "u128" {
        return TokenKind::U128;
    }
    if s == "f32" {
        return TokenKind::F32;
    }
    if s == "f64" {
        return TokenKind::F64;
    }
    if s == "bool" {
        return TokenKind::Bool;
    }
    if s == "str" {
        return TokenKind::Str;
    }
    if s == "void" {
        return TokenKind::Void;
    }
    return TokenKind::Ident(s);
}

// --- Character classification helpers -------------------------------------
// These mirror Rust's char::is_* predicates over ASCII byte values.

pub fn lex_is_whitespace(c: i64) -> bool {
    // space, \t, \n, \r, \x0c (form feed), \x0b (vertical tab)
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 12 || c == 11;
}

pub fn lex_is_alpha(c: i64) -> bool {
    // 'a'..'z' | 'A'..'Z'  (Rust's is_alphabetic covers all Unicode; the lexer
    // only ever sees ASCII identifiers, so ASCII suffices.)
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90);
}

pub fn lex_is_digit(c: i64) -> bool {
    return c >= 48 && c <= 57;
}

pub fn lex_is_alphanumeric(c: i64) -> bool {
    return lex_is_alpha(c) || lex_is_digit(c);
}

/// UTF-8 encoding of the scalar `cp` (escape sequences in strings: Rust's
/// String::push(char) in src/lexer.rs stores the char as UTF-8).
pub fn lex_utf8_encode(cp: i64) -> str {
    if cp < 128 {
        return byte_to_str(cp);
    }
    if cp < 2048 {
        return byte_to_str(192 + cp / 64) + byte_to_str(128 + cp % 64);
    }
    if cp < 65536 {
        return byte_to_str(224 + cp / 4096) + byte_to_str(128 + (cp / 64) % 64) + byte_to_str(128 + cp % 64);
    }
    return byte_to_str(240 + cp / 262144) + byte_to_str(128 + (cp / 4096) % 64) + byte_to_str(128 + (cp / 64) % 64) + byte_to_str(128 + cp % 64);
}

pub fn lex_is_hexdigit(c: i64) -> bool {
    return (c >= 48 && c <= 57)  // '0'..'9'
    || (c >= 65 && c <= 70)  // 'A'..'F'
    || (c >= 97 && c <= 102);
    // 'a'..'f'
}

// --- Number parsing helpers -----------------------------------------------

/// Parse `s` as an integer in the given radix (2, 8, 10, 16). Returns 0 on
/// any non-digit. Used for binary/octal literals (str_parse_hex handles 16).
@wrapping
pub fn parse_radix(s: str, radix: i64) -> i64 {
    var result: i64 = 0;
    var i: i64 = 0;
    var n: i64 = str_len(s);
    while i < n {
        var b: i64 = str_byte_at(s, i);
        var digit: i64 = -1;
        if b >= 48 && b <= 57 {
            digit = b - 48;
        } else if b >= 65 && b <= 90 {
            digit = b - 55;
        } else if b >= 97 && b <= 122 {
            digit = b - 87;
        } else {
            break;
        }
        if digit >= radix {
            break;
        }
        result = result * radix + digit;
        i = i + 1;
    }
    return result;
}

// --- String helpers -------------------------------------------------------

/// Build a string by repeating `ch` (given as a byte) `count` times.
/// Used for the "r###" prefix in raw-string error messages.
pub fn repeat_char(ch: i64, count: i64) -> str {
    var result: str = "";
    var i: i64 = 0;
    while i < count {
        result = str_concat(result, byte_to_str(ch));
        i = i + 1;
    }
    return result;
}

// --- Error formatting -----------------------------------------------------
// Matches Rust's `format!("Error:{}:{}: {}", line, col, msg)`.

pub fn lex_error(line: i64, col: i64, msg: str) -> str {
    return "Error:" + int_to_str(line) + ":" + int_to_str(col) + ": " + msg;
}

/// BG61: whether the digits `d` of an integer literal in `radix` (2, 8, 10
/// or 16; no prefix, no `_`) name 2^64 or more, which no integer type holds.
fn lex_int_too_big(d: str, radix: i64) -> bool {
    var n: i64 = str_len(d);
    var i: i64 = 0;
    while i < n && str_byte_at(d, i) == 48 {
        i = i + 1;
    }
    var sig: i64 = n - i;
    if radix == 16 {
        return sig > 16;
    }
    if radix == 2 {
        return sig > 64;
    }
    if radix == 8 {
        // u64::MAX is 0o1777777777777777777777 (22 digits)
        if sig != 22 {
            return sig > 22;
        }
        return str_byte_at(d, i) > 49;
    }
    // u64::MAX is 18446744073709551615 (20 digits)
    if sig != 20 {
        return sig > 20;
    }
    val umax: str = "18446744073709551615";
    var k: i64 = 0;
    while k < 20 {
        val a: i64 = str_byte_at(d, i + k);
        val b: i64 = str_byte_at(umax, k);
        if a != b {
            return a > b;
        }
        k = k + 1;
    }
    return false;
}

/// The value of a decimal literal. One above i64::MAX is a u64: it keeps its
/// bits.
@wrapping
fn lex_parse_int(s: str) -> i64 {
    var v: i64 = 0;
    var i: i64 = 0;
    var n: i64 = str_len(s);
    while i < n {
        v = v * 10 + (str_byte_at(s, i) - 48);
        i = i + 1;
    }
    return v;
}

// --- SP9: import files lexed in parallel ----------------------------------
// The import phase can read and lex every module of the import closure
// before it parses them one at a time (compiler.fd imp_prefetch_lex). Lexing
// a file depends on its text alone, so with FID_PAR=N the files of each
// wave of the closure are lexed in up to N threads; the tokens are those
// Lexer::new(text).tokenize() gives, and the parse order, the names the
// parser is given and so every message stay as they were.
//
// A worker shares nothing it changes with another thread (owner counts are
// not atomic: escape.fd "Parallel reporting pass"). It lexes a copy of each
// of its texts (lex_own_str) with a keyword cache of its own (own_kw, not
// g_lex_not_kw), and only reads the globals below, which are set before
// the spawns and reset after the last await. Spawn arguments must be
// @send: a worker gets its number and reads its list of texts from
// g_lex_par_plan.

/// The tokens of one text and the lexer's messages (none: it lexed clean).
pub struct LexedText {
    pub tokens: Vec<Token>,
    pub errors: Vec<str>,
}

pub var g_lex_par_texts: Vec<str> = Vec::new();
// for each worker, the indexes into g_lex_par_texts it lexes, in order
pub var g_lex_par_plan: Vec<Vec<i64>> = Vec::new();

/// `s` in a buffer of its own: it shares no owner count with `s`.
fn lex_own_str(s: str) -> str {
    return p_str_adopt(p_str_send_copy(s as i64));
}

/// What Lexer::new(text).tokenize() gives, and its messages, lexed with a
/// keyword cache of this lexer's own (nothing shared with another thread).
pub fn lex_text_alone(text: str) -> LexedText {
    var lx: Lexer = Lexer::new(text);
    lx.own_kw = HashMap_new();
    var toks: Vec<Token> = lx.tokenize();
    HashMap_drop(lx.own_kw);
    lx.own_kw = 0;
    var errs: Vec<str> = lx.errors;
    return LexedText {
        tokens: toks, errors: errs
    };
}

/// A worker of lex_texts_par: the texts of its plan, each lexed alone, in
/// the plan's order.
pub fn lex_par_worker(w: i64) -> Vec<LexedText> {
    var out: Vec<LexedText> = Vec::new();
    var k: i64 = 0;
    while k < g_lex_par_plan.get(w).len() {
        var at: i64 = g_lex_par_plan.get(w).get(k);
        out.push(lex_text_alone(lex_own_str(g_lex_par_texts.get(at))));
        k = k + 1;
    }
    return out;
}

/// Which texts each of at most `nw` workers lexes: the texts by size,
/// largest first (the first of equal ones first), each to the worker with
/// the fewest bytes so far (the first of equal ones); a worker's list in
/// text order. One list per worker, min(nw, number of texts) lists.
pub fn lex_par_plan(sizes: Vec<i64>, nw: i64) -> Vec<Vec<i64>> {
    var n: i64 = sizes.len();
    var nb: i64 = nw;
    if nb > n {
        nb = n;
    }
    if nb < 1 {
        nb = 1;
    }
    var taken: Vec<bool> = Vec::new();
    var owner: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        taken.push(false);
        owner.push(0);
        i = i + 1;
    }
    var load: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < nb {
        load.push(0);
        b = b + 1;
    }
    var r: i64 = 0;
    while r < n {
        var best: i64 = -1;
        var j: i64 = 0;
        while j < n {
            if !taken.get(j) && (best < 0 || sizes.get(j) > sizes.get(best)) {
                best = j;
            }
            j = j + 1;
        }
        taken.set(best, true);
        var least: i64 = 0;
        b = 1;
        while b < nb {
            if load.get(b) < load.get(least) {
                least = b;
            }
            b = b + 1;
        }
        owner.set(best, least);
        load.set(least, load.get(least) + sizes.get(best));
        r = r + 1;
    }
    var plan: Vec<Vec<i64>> = Vec::new();
    b = 0;
    while b < nb {
        var lst: Vec<i64> = Vec::new();
        i = 0;
        while i < n {
            if owner.get(i) == b {
                lst.push(i);
            }
            i = i + 1;
        }
        plan.push(lst);
        b = b + 1;
    }
    return plan;
}

/// The tokens and messages of each of `texts`, in order, lexed in up to
/// `nw` threads (FID_PAR); with fewer than two workers or texts, lexed
/// here one after another. The same tokens either way.
pub fn lex_texts_par(texts: Vec<str>, nw: i64) -> Vec<LexedText> {
    var out: Vec<LexedText> = Vec::new();
    var n: i64 = texts.len();
    var i: i64 = 0;
    if nw < 2 || n < 2 {
        while i < n {
            out.push(lex_text_alone(texts.get(i)));
            i = i + 1;
        }
        return out;
    }
    var sizes: Vec<i64> = Vec::new();
    while i < n {
        sizes.push(str_len(texts.get(i)));
        i = i + 1;
    }
    var plan: Vec<Vec<i64>> = lex_par_plan(sizes, nw);
    // where each text's result is: its worker, and its place in that list
    var res_w: Vec<i64> = Vec::new();
    var res_k: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        res_w.push(0);
        res_k.push(0);
        i = i + 1;
    }
    var w: i64 = 0;
    while w < plan.len() {
        var k: i64 = 0;
        while k < plan.get(w).len() {
            var t: i64 = plan.get(w).get(k);
            res_w.set(t, w);
            res_k.set(t, k);
            k = k + 1;
        }
        w = w + 1;
    }
    g_lex_par_texts = texts;
    g_lex_par_plan = plan;
    var futs: Vec<Future<Vec<LexedText>> > = Vec::new();
    w = 0;
    while w < plan.len() {
        futs.push(spawn lex_par_worker(w));
        w = w + 1;
    }
    var got: Vec<Vec<LexedText>> = Vec::new();
    w = 0;
    while w < futs.len() {
        var part: Vec<LexedText> = await futs.get(w);
        got.push(part);
        w = w + 1;
    }
    g_lex_par_texts = Vec::new();
    g_lex_par_plan = Vec::new();
    i = 0;
    while i < n {
        out.push(got.get(res_w.get(i)).get(res_k.get(i)));
        i = i + 1;
    }
    return out;
}

/// SP9: the modules a file imports, read from its tokens without a parse:
/// the path of each `use` outside braces, as parse_use puts it in
/// ImportDef.path (`a::b` for `use a::b;`, `use a::b as c;`,
/// `use a::b::{x, y};` and `use a::b::*;`), in order, each once. A `use` in
/// a body or an impl is not an import of the module.
pub fn token_use_paths(toks: Vec<Token>) -> Vec<str> {
    return token_module_scan(toks).uses;
}

/// SP9: what the import loop reads from a module's parse, read from its
/// tokens: the paths of its imports (token_use_paths: uses, each once;
/// uses_all as written, in order), the names of its structs and enums
/// (`struct N` / `enum N` outside braces), its `module a::b;` name ("" when
/// none), and the names its `use`s put in the parser's import set (alias,
/// else the path's last segment; in bodies too). A guess for the parallel
/// parse (compiler.fd pp_predict): a wrong one costs time, not output.
pub struct ModScan {
    pub uses: Vec<str>,
    pub uses_all: Vec<str>,
    pub structs: Vec<str>,
    pub enums: Vec<str>,
    pub module: str,
    pub import_names: Vec<str>,
}

/// The name a token is as an identifier or word keyword ("" when neither).
fn tok_word(k: TokenKind) -> str {
    match k {
        TokenKind::Ident(s: str) => {
            return s;
        }
        _ => {
        }
    }
    if is_word_keyword(k) {
        return token_kind_to_str(k);
    }
    return "";
}

/// The last `::` segment of a path.
fn tok_path_last(path: str) -> str {
    var at: i64 = str_len(path) - 1;
    while at > 0 {
        if str_byte_at(path, at) == 58 && str_byte_at(path, at - 1) == 58 {
            return str_slice(path, at + 1, str_len(path));
        }
        at = at - 1;
    }
    return path;
}

pub fn token_module_scan(toks: Vec<Token>) -> ModScan {
    var out: Vec<str> = Vec::new();
    var all: Vec<str> = Vec::new();
    var structs: Vec<str> = Vec::new();
    var enums: Vec<str> = Vec::new();
    var inames: Vec<str> = Vec::new();
    var module: str = "";
    var seen: i64 = HashMap_new();
    var depth: i64 = 0;
    var n: i64 = toks.len();
    var i: i64 = 0;
    while i < n {
        var k: TokenKind = toks.get(i).kind;
        if token_kind_eq(k, TokenKind::LBrace) {
            depth = depth + 1;
            i = i + 1;
        } else if token_kind_eq(k, TokenKind::RBrace) {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
        } else if depth == 0 && (token_kind_eq(k, TokenKind::Struct) || token_kind_eq(k, TokenKind::Enum)) {
            if i + 1 < n {
                match toks.get(i + 1).kind {
                    TokenKind::Ident(dn: str) => {
                        if token_kind_eq(k, TokenKind::Struct) {
                            structs.push(dn);
                        } else {
                            enums.push(dn);
                        }
                    }
                    _ => {
                    }
                }
            }
            i = i + 1;
        } else if depth == 0 && token_kind_eq(k, TokenKind::Module) && str_len(module) == 0 {
            var mname: str = "";
            var mj: i64 = i + 1;
            while mj < n {
                var part: str = tok_word(toks.get(mj).kind);
                if str_len(part) == 0 {
                    break;
                }
                mname = mname + part;
                mj = mj + 1;
                if mj < n && token_kind_eq(toks.get(mj).kind, TokenKind::DoubleColon) {
                    mname = mname + "::";
                    mj = mj + 1;
                } else {
                    break;
                }
            }
            module = mname;
            i = mj;
        } else if depth > 0 && token_kind_eq(k, TokenKind::Use) {
            // a `use` in a body: not an import of the module, but its name
            // goes into the import set all the same
            var bpath: str = "";
            var bj: i64 = i + 1;
            while bj < n {
                var bname: str = tok_word(toks.get(bj).kind);
                if str_len(bname) == 0 {
                    break;
                }
                bpath = bpath + bname;
                bj = bj + 1;
                if bj < n && token_kind_eq(toks.get(bj).kind, TokenKind::DoubleColon) {
                    bpath = bpath + "::";
                    bj = bj + 1;
                } else {
                    break;
                }
            }
            if str_ends_with(bpath, "::") {
                bpath = str_slice(bpath, 0, str_len(bpath) - 2);
            }
            if str_len(bpath) > 0 {
                inames.push(tok_use_name(toks, bj, bpath));
            }
            i = bj;
        } else if depth == 0 && token_kind_eq(k, TokenKind::Use) {
            var path: str = "";
            var j: i64 = i + 1;
            while j < n {
                var kj: TokenKind = toks.get(j).kind;
                var name: str = "";
                match kj {
                    TokenKind::Ident(s: str) => {
                        name = s;
                    }
                    _ => {
                        if is_word_keyword(kj) {
                            name = token_kind_to_str(kj);
                        }
                    }
                }
                if str_len(name) == 0 {
                    break;
                }
                path = path + name;
                j = j + 1;
                if j < n && token_kind_eq(toks.get(j).kind, TokenKind::DoubleColon) {
                    path = path + "::";
                    j = j + 1;
                } else {
                    break;
                }
            }
            if str_ends_with(path, "::") {
                path = str_slice(path, 0, str_len(path) - 2);
            }
            if str_len(path) > 0 {
                all.push(path);
                inames.push(tok_use_name(toks, j, path));
            }
            if str_len(path) > 0 && !HashMap_contains(seen, path) {
                HashMap_insert(seen, path, 1);
                out.push(path);
            }
            // the token after the path (`;`, `as`, `{`, `*`) is looked at next
            i = j;
        } else {
            i = i + 1;
        }
    }
    HashMap_drop(seen);
    return ModScan {
        uses: out, uses_all: all, structs: structs, enums: enums, module: module, import_names: inames
    };
}

/// The name `use <path>` puts in the parser's import set: the alias of
/// `as <alias>` at toks[j], else the path's last segment.
fn tok_use_name(toks: Vec<Token>, j: i64, path: str) -> str {
    if j + 1 < toks.len() && token_kind_eq(toks.get(j).kind, TokenKind::As) {
        match toks.get(j + 1).kind {
            TokenKind::Ident(al: str) => {
                return al;
            }
            _ => {
            }
        }
    }
    return tok_path_last(path);
}

/// SP9: the modules of an import closure, in the order they were found
/// (breadth first from the program's own imports): each one's import path,
/// its file ("" when none was found) and the modules it imports (indexes
/// into names; "core" is left out, as the import loop skips it).
/// scans[i]: what module i's tokens say (token_module_scan; empty when
/// its file was not lexed).
pub struct ModGraph {
    pub names: Vec<str>,
    pub files: Vec<str>,
    pub deps: Vec<Vec<i64>>,
    pub scans: Vec<ModScan>,
}

pub fn ModGraph_new() -> ModGraph {
    return ModGraph {
        names: Vec::new(), files: Vec::new(), deps: Vec::new(), scans: Vec::new()
    };
}

pub fn ModScan_empty() -> ModScan {
    return ModScan {
        uses: Vec::new(), uses_all: Vec::new(), structs: Vec::new(), enums: Vec::new(), module: "", import_names: Vec::new()
    };
}

/// Each module's level: 0 when it imports none of the others, else one
/// more than the highest level of those it imports. Modules of one level
/// do not import each other, directly or through others, so they can be
/// worked on at the same time once the levels below them are done. A
/// module on an import cycle, or importing one, gets -1 (those stay in the
/// import loop's order). An index out of range, or a module importing
/// itself, is no dependency.
pub fn modgraph_levels(deps: Vec<Vec<i64>>) -> Vec<i64> {
    var n: i64 = deps.len();
    var level: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        level.push(-1);
        i = i + 1;
    }
    var changed: bool = true;
    while changed {
        changed = false;
        i = 0;
        while i < n {
            if level.get(i) < 0 {
                var ok: bool = true;
                var lv: i64 = 0;
                var j: i64 = 0;
                while j < deps.get(i).len() {
                    var t: i64 = deps.get(i).get(j);
                    if t >= 0 && t < n && t != i {
                        if level.get(t) < 0 {
                            ok = false;
                            break;
                        }
                        if level.get(t) + 1 > lv {
                            lv = level.get(t) + 1;
                        }
                    }
                    j = j + 1;
                }
                if ok {
                    level.set(i, lv);
                    changed = true;
                }
            }
            i = i + 1;
        }
    }
    return level;
}

/// `<n> modules, <l> levels, widest <w>` and, when some are, `, <c> on a
/// cycle`: how many of the modules the levels of modgraph_levels let be
/// worked on together.
pub fn modgraph_summary(levels: Vec<i64>) -> str {
    var top: i64 = -1;
    var cyc: i64 = 0;
    var i: i64 = 0;
    while i < levels.len() {
        if levels.get(i) < 0 {
            cyc = cyc + 1;
        } else if levels.get(i) > top {
            top = levels.get(i);
        }
        i = i + 1;
    }
    var widest: i64 = 0;
    var lv: i64 = 0;
    while lv <= top {
        var w: i64 = 0;
        i = 0;
        while i < levels.len() {
            if levels.get(i) == lv {
                w = w + 1;
            }
            i = i + 1;
        }
        if w > widest {
            widest = w;
        }
        lv = lv + 1;
    }
    var s: str = int_to_str(levels.len()) + " modules, " + int_to_str(top + 1) + " levels, widest " + int_to_str(widest);
    if cyc > 0 {
        s = s + ", " + int_to_str(cyc) + " on a cycle";
    }
    return s;
}
