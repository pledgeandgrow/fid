}

// --- Lifetimes (LG3) ---------------------------------------------------------
// The parser keeps the lifetimes of `&'a T` as `@lifetime("'a", ...)`: on a
// parameter, those its type writes; on a function, those of its result.

/// The lifetimes an annotation list carries (none: empty).
pub fn ann_lifetimes(anns: Vec<Annotation>) -> Vec<str> {
    var i: i64 = 0;
    while i < anns.len() {
        if anns.get(i).name == "lifetime" {
            return anns.get(i).args;
        }
        i = i + 1;
    }
    return Vec::new();
}

/// Whether `f`'s signature names its result's lifetimes (`-> &'a T`).
pub fn func_has_lifetimes(f: Func) -> bool {
    return ann_lifetimes(f.annotations).len() > 0;
}

/// The parameters (by index) `f`'s result borrows from by its signature:
/// those whose type carries one of the result's lifetimes. `'static` ties
/// the result to no parameter.
pub fn func_lifetime_ties(f: Func) -> Vec<i64> {
    return lifetime_ties(ann_lifetimes(f.annotations), f.params);
}

/// The same for a trait's method declaration (LG3).
pub fn trait_method_lifetime_ties(tm: TraitMethod) -> Vec<i64> {
    return lifetime_ties(ann_lifetimes(tm.annotations), tm.params);
}

/// The parameters (by index) carrying one of `ret_lts`.
pub fn lifetime_ties(ret_lts: Vec<str>, params: Vec<Param>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < params.len() {
        var pl: Vec<str> = ann_lifetimes(params.get(i).annotations);
        var tied: bool = false;
        var j: i64 = 0;
        while j < pl.len() && !tied {
            tied = pl.get(j) != "'static" && str_vec_contains(ret_lts, pl.get(j));
            j = j + 1;
        }
        if tied {
            out.push(i);
        }
        i = i + 1;
    }
    return out;
}

// Shared helper used across compiler modules.
pub fn str_vec_contains(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Shared helper used across compiler modules.
pub fn vec_contains_str(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Shared helper used across compiler modules.
/// Escape a string for assembly output.
pub fn escape_str(s: str) -> str {
    var result: str = "";
    var i: i64 = 0;
    var n: i64 = str_len(s);
    while i < n {
        var c: i64 = str_byte_at(s, i);
        if c == 92 {
            // backslash
            result = result + "\\\\";
        } else if c == 34 {
            // double quote
            result = result + "\\\"";
        } else if c == 10 {
            // newline
            result = result + "\\n";
        } else if c == 9 {
            // tab
            result = result + "\\t";
        } else if c == 13 {
            // carriage return
            result = result + "\\r";
        } else {
            result = result + char_to_str(c);
        }
        i = i + 1;
    }
    return result;
}

// Shared helper used across compiler modules.
pub fn vec_contains_i64(vec: Vec<i64>, value: i64) -> bool {
    var i: i64 = 0;
    while i < vec.len() {
        if vec.get(i) == value {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Shared helper used across compiler modules.
pub fn vec_find_i64(vec: Vec<i64>, value: i64) -> i64 {
    var i: i64 = 0;
    while i < vec.len() {
        if vec.get(i) == value {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Shared helper used across compiler modules.
pub fn box_expr_deref(b: Box<Expr>) -> Expr {
    match b {
        Expr::IntLit(v) => {
            return Expr::IntLit(v);
        }
        Expr::FloatLit(v) => {
            return Expr::FloatLit(v);
        }
        Expr::StringLit(v) => {
            return Expr::StringLit(v);
        }
        Expr::BoolLit(v) => {
            return Expr::BoolLit(v);
        }
        Expr::Ident(n) => {
            return Expr::Ident(n);
        }
        Expr::Binary(op, l, r) => {
            return Expr::Binary(op, l, r);
        }
        Expr::Unary(op, e) => {
            return Expr::Unary(op, e);
        }
        Expr::Call(n, a) => {
            return Expr::Call(n, a);
        }
        Expr::FieldAccess(e, f) => {
            return Expr::FieldAccess(e, f);
        }
        Expr::OptionalFieldAccess(e, f) => {
            return Expr::OptionalFieldAccess(e, f);
        }
        Expr::StructLit(n, f, s) => {
            return Expr::StructLit(n, f, s);
        }
        Expr::If(c, t, e) => {
            return Expr::If(c, t, e);
        }
        Expr::Range(s, e2, i) => {
            return Expr::Range(s, e2, i);
        }
        Expr::Block(s) => {
            return Expr::Block(s);
        }
        Expr::MethodCall(r, m, a) => {
            return Expr::MethodCall(r, m, a);
        }
        Expr::ArrayLit(t, e) => {
            return Expr::ArrayLit(t, e);
        }
        Expr::Index(a, i) => {
            return Expr::Index(a, i);
        }
        Expr::FString(p) => {
            return Expr::FString(p);
        }
        Expr::Match(e, a) => {
            return Expr::Match(e, a);
        }
        Expr::EnumLit(en, v, a) => {
            return Expr::EnumLit(en, v, a);
        }
        Expr::Ref(e, m) => {
            return Expr::Ref(e, m);
        }
        Expr::Deref(e) => {
            return Expr::Deref(e);
        }
        Expr::StrConcat(l, r) => {
            return Expr::StrConcat(l, r);
        }
        Expr::Try(e) => {
            return Expr::Try(e);
        }
        Expr::Coalesce(e, d) => {
            return Expr::Coalesce(e, d);
        }
        Expr::IsCheck(e, t) => {
            return Expr::IsCheck(e, t);
        }
        Expr::TryBlock(b) => {
            return Expr::TryBlock(b);
        }
        Expr::TupleLit(e) => {
            return Expr::TupleLit(e);
        }
        Expr::Closure(p, b, r) => {
            return Expr::Closure(p, b, r);
        }
        Expr::Cast(e, t) => {
            return Expr::Cast(e, t);
        }
        Expr::Asm(t, o) => {
            return Expr::Asm(t, o);
        }
        Expr::Comptime(e) => {
            return Expr::Comptime(e);
        }
        Expr::ComptimeBlock(s) => {
            return Expr::ComptimeBlock(s);
        }
        Expr::ComptimeReflect(op, t) => {
            return Expr::ComptimeReflect(op, t);
        }
        Expr::PipeForward(l, r) => {
            return Expr::PipeForward(l, r);
        }
        Expr::QuantCast(e, t) => {
            return Expr::QuantCast(e, t);
        }
        Expr::Await(e) => {
            return Expr::Await(e);
        }
        Expr::Spawn(e) => {
            return Expr::Spawn(e);
        }
        Expr::Yield(e) => {
            return Expr::Yield(e);
        }
        Expr::NamedArg(name, e) => {
            return Expr::NamedArg(name, e);
        }
    }
    return Expr::IntLit(0);
}

// --- Constant time: the parameters @public marks (CF32) ----------------------
// The IR keeps no annotation, and the backends' check of a @constant_time
// function (checks.fd peir_ct_check) takes every parameter for secret. The
// type checker puts the parameters @public marks down here, as
// "<function>#<position>", under the names the IR gives the function; the
// check asks ct_public_param before it marks a parameter.

pub var g_ct_public_params: Vec<str> = Vec::new();

pub fn ct_public_param_add(name: str, pi: i64) -> void {
    var key: str = name + "#" + int_to_str(pi);
    if !str_vec_contains(g_ct_public_params, key) {
        g_ct_public_params.push(key);
    }
}

/// Whether parameter `pi` of the IR function `name` is @public. A generic
/// function's instances are named `<name>__<types>`: they take the
/// parameters of their source.
pub fn ct_public_param(name: str, pi: i64) -> bool {
    var key: str = name + "#" + int_to_str(pi);
    if str_vec_contains(g_ct_public_params, key) {
        return true;
    }
    var i: i64 = g_ct_public_params.len() - 1;
    while i >= 0 {
        var k: str = g_ct_public_params.get(i);
        var h: i64 = str_find(k, "#");
        if h > 0 && str_ends_with(k, "#" + int_to_str(pi)) && str_starts_with(name, str_slice(k, 0, h) + "__") {
            return true;
        }
        i = i - 1;
    }
    return false;
}
