}

// A module-level mutable global variable: `var g_x: i64 = 0;` or `pub var g_x: i64 = 0;`
pub struct GlobalVar {
    pub name: str,
    pub ty: Type,
    pub init: Expr,
    pub is_pub: bool,
}

pub struct TypeAlias {
    pub name: str,
