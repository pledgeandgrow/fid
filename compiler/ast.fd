// --- Declarations ---------------------------------------------------------

// --- Const-generic values on the type wire (L8A) ----------------------------
// A const parameter's argument rides the type wire as a Named type with
// this one prefix. The encoding is a private detail of these two helpers:
// nothing else builds or parses it (the parser's turbofish table, the
// type checker's call unification and mono's substitutions all go through
// them), so a const value can never be confused with a user's type name
// (a program cannot declare a type whose name starts __).

/// The wire form of const-generic value `n` (n >= 0).
pub fn Type_const_of(n: i64) -> Type {
    return Type::Named("__const_" + int_to_str(n));
}

/// The value a const-generic wire type carries, or -1 when it is none.
pub fn Type_const_value(t: Type) -> i64 {
    match t {
        Type::Named(name) => {
            if str_starts_with(name, "__const_") {
                return str_parse_int(str_slice(name, 8, str_len(name)));
            }
        }
        _ => {
        }
    }
    return 0 - 1;
}

pub struct Param {
    pub name: str,
