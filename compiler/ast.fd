// --- Box<T> unbox helpers -------------------------------------------------
// Fides match patterns on Box<T> auto-unbox for matching, but the extracted
// fields are still Box<T>. These helpers convert Box<Type>/Box<Expr>/Box<Pattern>
// back to Type/Expr/Pattern for passing to functions that expect unboxed values.

pub fn box_type_unbox(b: Box<Type>) -> Type {
    match b {
        Type::I8 => {
            return Type::I8;
        }
        Type::I16 => {
            return Type::I16;
        }
        Type::I32 => {
            return Type::I32;
        }
        Type::I64 => {
            return Type::I64;
        }
        Type::I128 => {
            return Type::I128;
        }
        Type::U8 => {
            return Type::U8;
        }
        Type::U16 => {
            return Type::U16;
        }
        Type::U32 => {
            return Type::U32;
        }
        Type::U64 => {
            return Type::U64;
        }
        Type::U128 => {
            return Type::U128;
        }
        Type::F32 => {
            return Type::F32;
        }
        Type::F64 => {
            return Type::F64;
        }
        Type::Bool => {
            return Type::Bool;
        }
        Type::Str => {
            return Type::Str;
        }
        Type::Void => {
            return Type::Void;
        }
        Type::Never => {
            return Type::Never;
        }
        Type::Infer => {
            return Type::Infer;
        }
        Type::Named(n) => {
            return Type::Named(n);
        }
        Type::Array(elem, size) => {
            return Type::Array(elem, size);
        }
        Type::ArrayConst(elem, sp) => {
            return Type::ArrayConst(elem, sp);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(inner, is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(inner, is_mut);
        }
        Type::Generic(n, args) => {
            return Type::Generic(n, args);
        }
        Type::Tuple(types) => {
            return Type::Tuple(types);
        }
        Type::Func(params, ret) => {
            return Type::Func(params, ret);
        }
        Type::Assoc(tn, tn2, an, at) => {
            return Type::Assoc(tn, tn2, an, at);
        }
        Type::Dyn(tn) => {
            return Type::Dyn(tn);
        }
        Type::ShapedTensor(elem, shape) => {
            return Type::ShapedTensor(elem, shape);
        }
    }
    return Type::Never;
}

pub fn box_pattern_unbox(b: Box<Pattern>) -> Pattern {
    match b {
        Pattern::Wildcard => {
            return Pattern::Wildcard;
        }
        Pattern::IntLit(n) => {
            return Pattern::IntLit(n);
        }
        Pattern::BoolLit(v) => {
            return Pattern::BoolLit(v);
        }
        Pattern::Ident(s) => {
            return Pattern::Ident(s);
        }
        Pattern::EnumVariant(en, variant, bindings) => {
            return Pattern::EnumVariant(en, variant, bindings);
        }
        Pattern::StrLit(s) => {
            return Pattern::StrLit(s);
        }
        Pattern::Range(start, end) => {
            return Pattern::Range(start, end);
        }
    }
    return Pattern::Wildcard;
}

pub fn box_expr_new(e: Expr) -> Box<Expr> {
    // Box::new is the standard way to create a Box<T> in Fides
    return Box::new(e);
}

pub fn box_expr_unbox(b: Box<Expr>) -> Expr {
    match b {
        Expr::IntLit(n) => {
            return Expr::IntLit(n);
        }
        Expr::FloatLit(f) => {
            return Expr::FloatLit(f);
        }
        Expr::StringLit(s) => {
            return Expr::StringLit(s);
        }
        Expr::BoolLit(v) => {
            return Expr::BoolLit(v);
        }
        Expr::Ident(s) => {
            return Expr::Ident(s);
        }
        Expr::Binary(op, l, r) => {
            return Expr::Binary(op, l, r);
        }
        Expr::Unary(op, e) => {
            return Expr::Unary(op, e);
        }
        Expr::Call(callee, args) => {
            return Expr::Call(callee, args);
        }
        Expr::FieldAccess(e, field) => {
            return Expr::FieldAccess(e, field);
        }
        Expr::OptionalFieldAccess(e, field) => {
            return Expr::OptionalFieldAccess(e, field);
        }
        Expr::StructLit(name, fields, spread) => {
            return Expr::StructLit(name, fields, spread);
        }
        Expr::If(cond, then_block, else_block) => {
            return Expr::If(cond, then_block, else_block);
        }
        Expr::Range(start, end, inclusive) => {
            return Expr::Range(start, end, inclusive);
        }
        Expr::Block(stmts) => {
            return Expr::Block(stmts);
        }
        Expr::MethodCall(receiver, method, args) => {
            return Expr::MethodCall(receiver, method, args);
        }
        Expr::ArrayLit(elem_type, elements) => {
            return Expr::ArrayLit(elem_type, elements);
        }
        Expr::Index(array, index) => {
            return Expr::Index(array, index);
        }
        Expr::FString(parts) => {
            return Expr::FString(parts);
        }
        Expr::Match(expr, arms) => {
            return Expr::Match(expr, arms);
        }
        Expr::EnumLit(enum_name, variant, args) => {
            return Expr::EnumLit(enum_name, variant, args);
        }
        Expr::Ref(e, is_mut) => {
            return Expr::Ref(e, is_mut);
        }
        Expr::Deref(e) => {
            return Expr::Deref(e);
        }
        Expr::StrConcat(left, right) => {
            return Expr::StrConcat(left, right);
        }
        Expr::Try(e) => {
            return Expr::Try(e);
        }
        Expr::Coalesce(e, default) => {
            return Expr::Coalesce(e, default);
        }
        Expr::IsCheck(e, type_name) => {
            return Expr::IsCheck(e, type_name);
        }
        Expr::TryBlock(body) => {
            return Expr::TryBlock(body);
        }
        Expr::TupleLit(exprs) => {
            return Expr::TupleLit(exprs);
        }
        Expr::Closure(params, body, ret_ty) => {
            return Expr::Closure(params, body, ret_ty);
        }
        Expr::Cast(e, target_ty) => {
            return Expr::Cast(e, target_ty);
        }
        Expr::Asm(template, operands) => {
            return Expr::Asm(template, operands);
        }
        Expr::Comptime(e) => {
            return Expr::Comptime(e);
        }
        Expr::ComptimeBlock(stmts) => {
            return Expr::ComptimeBlock(stmts);
        }
        Expr::ComptimeReflect(op, ty) => {
            return Expr::ComptimeReflect(op, ty);
        }
        Expr::PipeForward(left, right) => {
            return Expr::PipeForward(left, right);
        }
        Expr::QuantCast(e, target_ty) => {
            return Expr::QuantCast(e, target_ty);
        }
        Expr::Await(e) => {
            return Expr::Await(e);
        }
        Expr::Spawn(e) => {
            return Expr::Spawn(e);
        }
        Expr::Yield(e) => {
            return Expr::Yield(e);
        }
        Expr::NamedArg(name, e) => {
            return Expr::NamedArg(name, e);
        }
    }
    return Expr::IntLit(0);
}

