}

pub struct TraitMethod {
    pub name: str,
    pub params: Vec<Param>,
    pub ret_ty: Type,
    pub has_self: bool,
    pub is_pub: bool,
    pub default_body: OptStmts,
    // LG3: `@lifetime("'a", ...)` when the result's type names lifetimes
    // (`fn get<'a>(self: &'a Self) -> &'a T;`), as on a Func
    pub annotations: Vec<Annotation>,
    // LG4: a generic method's own type parameters (`fn m<U: Show>(..)`)
    // and their bounds, as on a Func
    pub type_params: Vec<str>,
    pub type_param_bounds: Vec<StrPair>,
    // LG14: `async fn m(..) -> Future<T> { .. }`: a default body filled into
    // an impl is an async method (compiler.fd fill_default_trait_methods)
    pub is_async: bool,
}

