// --- Display: shape_dim_to_str --------------------------------------------

pub fn shape_dim_to_str(d: ShapeDim) -> str {
    match d {
        ShapeDim::Known(n) => {
            return int_to_str(n);
        }
        ShapeDim::Symbolic(s) => {
            return s;
        }
    }
}

// --- Display: type_to_str -------------------------------------------------
// Matches Rust's impl Display for Type.
// Note: Fides does not auto-deref Box<T> when passing to a function expecting
// T, so recursive calls on Box<Type> payloads go through box_type_to_str,
// which matches on the boxed value (match auto-derefs Box).

pub fn box_type_to_str(b: Box<Type>) -> str {
    match b {
        Type::I8 => {
            return "i8";
        }
        Type::I16 => {
            return "i16";
        }
        Type::I32 => {
            return "i32";
        }
        Type::I64 => {
            return "i64";
        }
        Type::I128 => {
            return "i128";
        }
        Type::U8 => {
            return "u8";
        }
        Type::U16 => {
            return "u16";
        }
        Type::U32 => {
            return "u32";
        }
        Type::U64 => {
            return "u64";
        }
        Type::U128 => {
            return "u128";
        }
        Type::F32 => {
            return "f32";
        }
        Type::F64 => {
            return "f64";
        }
        Type::Bool => {
            return "bool";
        }
        Type::Str => {
            return "str";
        }
        Type::Void => {
            return "void";
        }
        Type::Never => {
            return "never";
        }
        Type::Infer => {
            return "_";
        }
        Type::Named(s) => {
            return s;
        }
        Type::Array(elem, size) => {
            return "[" + box_type_to_str(elem) + "; " + int_to_str(size) + "]";
        }
        Type::ArrayConst(elem, size_param) => {
            return "[" + box_type_to_str(elem) + "; " + size_param + "]";
        }
        Type::Ref(inner, is_mut) => {
            if is_mut {
                return "&mut " + box_type_to_str(inner);
            } else {
                return "&" + box_type_to_str(inner);
            }
        }
        Type::RawPtr(inner, is_mut) => {
            if is_mut {
                return "*mut " + box_type_to_str(inner);
            } else {
                return "*const " + box_type_to_str(inner);
            }
        }
        Type::Generic(name, args) => {
            var result = name + "<";
            var i: i64 = 0;
            while i < args.len() {
                if i > 0 {
                    result = result + ", ";
                }
                result = result + type_to_str(args.get(i));
                i = i + 1;
            }
            result = result + ">";
            return result;
        }
        Type::Tuple(types) => {
            var result = "(";
            var i: i64 = 0;
            while i < types.len() {
                if i > 0 {
                    result = result + ", ";
                }
                result = result + type_to_str(types.get(i));
                i = i + 1;
            }
            result = result + ")";
            return result;
        }
        Type::Func(params, ret) => {
            var result = "fn(";
            var i: i64 = 0;
            while i < params.len() {
                if i > 0 {
                    result = result + ", ";
                }
                result = result + type_to_str(params.get(i));
                i = i + 1;
            }
            result = result + ") -> " + box_type_to_str(ret);
            return result;
        }
        Type::Assoc(tp, trait_name, name, args) => {
            if args.len() == 0 {
                return tp + "::" + name + "(" + trait_name + ")";
            } else {
                var args_str = "";
                var i: i64 = 0;
                while i < args.len() {
                    if i > 0 {
                        args_str = args_str + ", ";
                    }
                    args_str = args_str + type_to_str(args.get(i));
                    i = i + 1;
                }
                return tp + "::" + name + "<" + args_str + ">(" + trait_name + ")";
            }
        }
        Type::Dyn(name) => {
            return "dyn " + name;
        }
        Type::ShapedTensor(elem, shape) => {
            var result = "Tensor<" + box_type_to_str(elem);
            if shape.len() > 0 {
                result = result + ", [";
                var i: i64 = 0;
                while i < shape.len() {
                    if i > 0 {
                        result = result + ", ";
                    }
                    result = result + shape_dim_to_str(shape.get(i));
                    i = i + 1;
                }
                result = result + "]";
            }
            result = result + ">";
            return result;
        }
    }
}

pub fn type_to_str(t: Type) -> str {
    // Delegate to box_type_to_str by boxing -- avoids duplicating the match.
    // (Box::new copies the value; Type is a flat enum so this is cheap.)
    return box_type_to_str(Box::new(t));
}

// --- L8H: specialization ---------------------------------------------------
// Several functions of one name in a file, one of them generic: the parser
// keeps the name on the most general one and renames the others
// `name__spec<k>` (pd_name_specializations). A call is typed against the
// general one; an instantiation takes the body of the most specific
// definition whose parameters take its types (mono `instantiate`), and two
// that tie are an error (TypeChecker_check_generic_call).

/// The name a specialization `name__spec<k>` specializes, or "".
pub fn spec_base_name(name: str) -> str {
    var at: i64 = str_rfind(name, "__spec");
    if at <= 0 {
        return "";
    }
    var n: i64 = str_len(name);
    var i: i64 = at + 6;
    if i >= n {
        return "";
    }
    while i < n {
        var c: i64 = str_byte_at(name, i);
        if c < 48 || c > 57 {
            return "";
        }
        i = i + 1;
    }
    return str_slice(name, 0, at);
}

/// Whether pattern `pat` (its type parameters `tps`) takes type `t`, with
/// the bindings so far in `names`/`types` (a parameter bound twice must be
/// the same type both times).
pub fn spec_match(pat: Type, t: Type, tps: Vec<str>, names: &mut Vec<str>, types: &mut Vec<Type>) -> bool {
    match pat {
        Type::Named(pn) => {
            if str_vec_contains(tps, pn) {
                var i: i64 = 0;
                while i < names.len() {
                    if names.get(i) == pn {
                        return type_to_str(types.get(i)) == type_to_str(t);
                    }
                    i = i + 1;
                }
                names.push(pn);
                types.push(t);
                return true;
            }
        }
        Type::Generic(gn, gargs) => {
            match t {
                Type::Generic(tn, targs) => {
                    if gn != tn || gargs.len() != targs.len() {
                        return false;
                    }
                    var gi: i64 = 0;
                    while gi < gargs.len() {
                        if !spec_match(gargs.get(gi), targs.get(gi), tps, names, types) {
                            return false;
                        }
                        gi = gi + 1;
                    }
                    return true;
                }
                _ => {
                    return false;
                }
            }
        }
        Type::Ref(pinner, pm) => {
            match t {
                Type::Ref(tinner, tm) => {
                    return pm == tm && spec_match(box_type_unbox(pinner), box_type_unbox(tinner), tps, names, types);
                }
                _ => {
                    return false;
                }
            }
        }
        Type::Array(pe, pn2) => {
            match t {
                Type::Array(te, tn2) => {
                    return pn2 == tn2 && spec_match(box_type_unbox(pe), box_type_unbox(te), tps, names, types);
                }
                _ => {
                    return false;
                }
            }
        }
        Type::Tuple(pts) => {
            match t {
                Type::Tuple(tts) => {
                    if pts.len() != tts.len() {
                        return false;
                    }
                    var ti: i64 = 0;
                    while ti < pts.len() {
                        if !spec_match(pts.get(ti), tts.get(ti), tps, names, types) {
                            return false;
                        }
                        ti = ti + 1;
                    }
                    return true;
                }
                _ => {
                    return false;
                }
            }
        }
        _ => {
        }
    }
    return type_to_str(pat) == type_to_str(t);
}

/// Whether the parameters `pats` (type parameters `tps`) take the argument
/// types `args`.
pub fn spec_takes(pats: Vec<Type>, tps: Vec<str>, args: Vec<Type>) -> bool {
    if pats.len() != args.len() {
        return false;
    }
    var names: Vec<str> = Vec::new();
    var types: Vec<Type> = Vec::new();
    var i: i64 = 0;
    while i < pats.len() {
        if !spec_match(pats.get(i), args.get(i), tps, &mut names, &mut types) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// `t` with the type parameters `tps` renamed apart (`'T`), so that a
/// definition's own parameters are read as fixed types when it is compared
/// with another definition.
pub fn spec_freshen(t: Type, tps: Vec<str>) -> Type {
    match t {
        Type::Named(n) => {
            if str_vec_contains(tps, n) {
                return Type::Named("'" + n);
            }
        }
        Type::Generic(gn, gargs) => {
            var na: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < gargs.len() {
                na.push(spec_freshen(gargs.get(i), tps));
                i = i + 1;
            }
            return Type::Generic(gn, na);
        }
        Type::Ref(inner, m) => {
            return Type::Ref(Box::new(spec_freshen(box_type_unbox(inner), tps)), m);
        }
        Type::Array(e, n) => {
            return Type::Array(Box::new(spec_freshen(box_type_unbox(e), tps)), n);
        }
        Type::Tuple(ts) => {
            var nt: Vec<Type> = Vec::new();
            var j: i64 = 0;
            while j < ts.len() {
                nt.push(spec_freshen(ts.get(j), tps));
                j = j + 1;
            }
            return Type::Tuple(nt);
        }
        _ => {
        }
    }
    return t;
}

/// The parameter types of `f`.
pub fn spec_param_types(f: Func) -> Vec<Type> {
    var out: Vec<Type> = Vec::new();
    var i: i64 = 0;
    while i < f.params.len() {
        out.push(f.params.get(i).ty);
        i = i + 1;
    }
    return out;
}

/// Whether definition `a` is at least as specific as `b`: `b`'s parameters
/// take `a`'s (with `a`'s own type parameters held fixed).
pub fn spec_at_least(a: Func, b: Func) -> bool {
    var ap: Vec<Type> = Vec::new();
    var i: i64 = 0;
    while i < a.params.len() {
        ap.push(spec_freshen(a.params.get(i).ty, a.type_params));
        i = i + 1;
    }
    return spec_takes(spec_param_types(b), b.type_params, ap);
}

/// Of the definitions `cands`, the one an instantiation with argument types
/// `args` takes its body from: the most specific that takes them. -1 when
/// none does; `tie` gets the index of a second, as specific, when two tie.
pub fn spec_choose(cands: Vec<Func>, args: Vec<Type>, tie: &mut Vec<i64>) -> i64 {
    var taking: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < cands.len() {
        var ci: Func = cands.get(i);
        if spec_takes(spec_param_types(ci), ci.type_params, args) {
            taking.push(i);
        }
        i = i + 1;
    }
    // the maximal ones: no other one is strictly more specific
    var maximal: Vec<i64> = Vec::new();
    var j: i64 = 0;
    while j < taking.len() {
        var cj: Func = cands.get(taking.get(j));
        var beaten: bool = false;
        var k: i64 = 0;
        while k < taking.len() && !beaten {
            if k != j {
                var ck: Func = cands.get(taking.get(k));
                if spec_at_least(ck, cj) && !spec_at_least(cj, ck) {
                    beaten = true;
                }
            }
            k = k + 1;
        }
        if !beaten {
            maximal.push(taking.get(j));
        }
        j = j + 1;
    }
    if maximal.len() == 0 {
        return -1;
    }
    if maximal.len() > 1 {
        tie.push(maximal.get(1));
    }
    return maximal.get(0);
}

// --- Constructor functions ------------------------------------------------
// The Fides parser only recognizes struct names defined in the current file
// (or pre-populated from stdlib/already-loaded imports). Struct literals from
// imported modules fail to parse on the first pass. These constructors allow
// test files (and the future self-hosted parser) to build AST nodes without
// using struct-literal syntax for imported types.

pub fn FieldInit_new(name: str, value: Expr) -> FieldInit {
    return FieldInit {
        name: name, value: value
    };
}

pub fn StrPair_new(a: str, b: str) -> StrPair {
    return StrPair {
        a: a, b: b
    };
}

pub fn Binding_new(name: str, ty: str) -> Binding {
    return Binding {
        name: name, ty: ty
    };
}

pub fn AssocTypeDecl_new(name: str, type_params: Vec<str>) -> AssocTypeDecl {
    return AssocTypeDecl {
        name: name, type_params: type_params
    };
}

pub fn AssocTypeBinding_new(name: str, ty: Type) -> AssocTypeBinding {
    return AssocTypeBinding {
        name: name, ty: ty
    };
}

pub fn LayerInst_new(field: str, layer_type: str, args: Vec<str>) -> LayerInst {
    return LayerInst {
        field: field, layer_type: layer_type, args: args
    };
}

pub fn Param_new(name: str, ty: Type, is_pub: bool) -> Param {
    return Param {
        name: name, ty: ty, is_pub: is_pub, annotations: Vec::new(), has_default: false, default_expr: Expr::IntLit(0), is_variadic: false
    };
}

// CL5: `Config { port: 80, .. }` -- a struct literal whose fields left out
// take the defaults written in the struct (`port: i64 = 8080`). The parser
// keeps the bare `..` as this spread; the type checker checks that every
// field left out has a default, and monomorphization (mono.fd
// `mn_fill_struct_defaults`) writes the defaults in, so no later pass sees
// it. A string literal, so a pass that scans the spread before then finds
// nothing in it (no variable, no call).
pub fn ast_spread_defaults() -> Expr {
    return Expr::StringLit("..struct defaults..");
}

pub fn ast_is_spread_defaults(e: Expr) -> bool {
    match e {
        Expr::StringLit(s) => {
            return s == "..struct defaults..";
        }
        _ => {
        }
    }
    return false;
}

pub fn Annotation_new(name: str, args: Vec<str>) -> Annotation {
    return Annotation {
        name: name, args: args
    };
}

