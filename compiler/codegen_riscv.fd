// codegen_riscv.fd -- RISC-V (RV64) Codegen (Phase 4C)
// Ported from src/codegen_riscv.rs (~368 LOC)
//
// Instruction selector that consumes PIR L3 + a register allocation and
// produces RISC-V RV64 assembly. This is the third target in the
// multi-architecture codegen backend.
//
// Pipeline: L3Module -> (regalloc) -> [code selector] -> RISC-V asm string
//
// Calling convention: RISC-V calling convention
//   - Args: a0-a7 (x10-x17, first 8 integer/pointer)
//   - Return: a0 (x10)
//   - Callee-saved: s0-s11 (x8, x9, x18-x27)
//   - Stack 16-byte aligned at call sites
//
// Adaptations from Rust:
// 1. HashMap<K,V> -> Vec-based maps with helper structs
// 2. String -> str, usize -> i64
// 3. &L3Module/&L3Function/&L3Inst -> by value (Fides convention)
// 4. struct methods -> free functions with `self: &mut RiscVCodeGen`
// 5. format! -> string concatenation
// 6. Option<VReg> -> OptVReg enum
// 7. `as u64`/`as i32` bit extraction -> i64 arithmetic

module compiler::codegen_riscv;

use core;
use vec;
use string;
use compiler::ast;
use compiler::pir;

// ===========================================================================
// Public API
// ===========================================================================

/// Generate RISC-V assembly for an entire L3 module.
pub fn generate_asm_riscv(module: L3Module) -> str {
    var gen: RiscVCodeGen = RiscVCodeGen_new();
    RiscVCodeGen_gen_module(gen, module);
    return gen.output;
}

// ===========================================================================
// RISC-V Register definitions
// ===========================================================================

pub fn reg_name(idx: i64) -> str {
    // RISC-V register names (ABI names), 32 registers.
    // Map VReg to a usable register (skip x0-x4 which are special).
    var mapped: i64 = 5 + (idx % 23);
    if mapped == 0 { return "zero"; }
    if mapped == 1 { return "ra"; }
    if mapped == 2 { return "sp"; }
    if mapped == 3 { return "gp"; }
    if mapped == 4 { return "tp"; }
    if mapped == 5 { return "t0"; }
    if mapped == 6 { return "t1"; }
    if mapped == 7 { return "t2"; }
    if mapped == 8 { return "s0"; }
    if mapped == 9 { return "s1"; }
    if mapped == 10 { return "a0"; }
    if mapped == 11 { return "a1"; }
    if mapped == 12 { return "a2"; }
    if mapped == 13 { return "a3"; }
    if mapped == 14 { return "a4"; }
    if mapped == 15 { return "a5"; }
    if mapped == 16 { return "a6"; }
    if mapped == 17 { return "a7"; }
    if mapped == 18 { return "s2"; }
    if mapped == 19 { return "s3"; }
    if mapped == 20 { return "s4"; }
    if mapped == 21 { return "s5"; }
    if mapped == 22 { return "s6"; }
    if mapped == 23 { return "s7"; }
    if mapped == 24 { return "s8"; }
    if mapped == 25 { return "s9"; }
    if mapped == 26 { return "s10"; }
    if mapped == 27 { return "s11"; }
    if mapped == 28 { return "t3"; }
    if mapped == 29 { return "t4"; }
    if mapped == 30 { return "t5"; }
    if mapped == 31 { return "t6"; }
    return "t0";
}

pub fn vreg_to_reg(vreg: VReg) -> str {
    return reg_name(vreg.id);
}

// ===========================================================================
// String constant table entry (Vec-based replacement for HashMap)
// ===========================================================================

pub struct RiscVStringConstEntry {
    pub content: str,
    pub label: str,
}

pub fn RiscVStringConstEntry_new(content: str, label: str) -> RiscVStringConstEntry {
    return RiscVStringConstEntry { content: content, label: label };
}

pub struct RiscVFloatConstEntry {
    pub bits: i64,
    pub label: str,
}

pub fn RiscVFloatConstEntry_new(bits: i64, label: str) -> RiscVFloatConstEntry {
    return RiscVFloatConstEntry { bits: bits, label: label };
}

// ===========================================================================
// Code Generator
// ===========================================================================

pub struct RiscVCodeGen {
    pub output: str,
    pub label_counter: i64,
    pub string_consts: Vec<RiscVStringConstEntry>,
    pub float_consts: Vec<RiscVFloatConstEntry>,
}

pub fn RiscVCodeGen_new() -> RiscVCodeGen {
    return RiscVCodeGen {
        output: "",
        label_counter: 0,
        string_consts: Vec::new(),
        float_consts: Vec::new(),
    };
}

// --- Output helpers ------------------------------------------------------

/// Append a string with a trailing newline.
pub fn RiscVCodeGen_wl(self: &mut RiscVCodeGen, s: str) {
    self.output = self.output + s + "\n";
}

// --- Module / function / block generation -------------------------------

pub fn RiscVCodeGen_gen_module(self: &mut RiscVCodeGen, module: L3Module) {
    // Text section
    RiscVCodeGen_wl(self, "    .section .text");
    RiscVCodeGen_wl(self, "    .globl main");

    var i: i64 = 0;
    while i < module.functions.len() {
        RiscVCodeGen_gen_function(self, module.functions.get(i));
        i = i + 1;
    }

    // Data section for strings and floats
    if self.string_consts.len() > 0 || self.float_consts.len() > 0 {
        RiscVCodeGen_wl(self, "    .section .rodata");
        var si: i64 = 0;
        while si < self.string_consts.len() {
            var entry: RiscVStringConstEntry = self.string_consts.get(si);
            RiscVCodeGen_wl(self, entry.label + ":");
            RiscVCodeGen_wl(self, "    .asciz \"" + riscv_escape_string(entry.content) + "\"");
            si = si + 1;
        }
        var fi: i64 = 0;
        while fi < self.float_consts.len() {
            var entry: RiscVFloatConstEntry = self.float_consts.get(fi);
            RiscVCodeGen_wl(self, entry.label + ":");
            RiscVCodeGen_wl(self, "    .quad " + int_to_str(entry.bits));
            fi = fi + 1;
        }
    }
}

pub fn RiscVCodeGen_gen_function(self: &mut RiscVCodeGen, func: L3Function) {
    RiscVCodeGen_wl(self, ".globl " + func.name);
    RiscVCodeGen_wl(self, func.name + ":");

    // Prologue: save ra and s0, allocate stack
    RiscVCodeGen_wl(self, "    addi sp, sp, -16");
    RiscVCodeGen_wl(self, "    sd ra, 8(sp)");
    RiscVCodeGen_wl(self, "    sd s0, 0(sp)");
    RiscVCodeGen_wl(self, "    mv s0, sp");

    // Stack frame
    var frame_size: i64 = 256;
    if frame_size > 0 {
        RiscVCodeGen_wl(self, "    addi sp, sp, -" + int_to_str(frame_size));
    }

    var i: i64 = 0;
    while i < func.blocks.len() {
        var block: L3Block = func.blocks.get(i);
        RiscVCodeGen_wl(self, ".L" + func.name + int_to_str(self.label_counter) + "_b" + int_to_str(block.id) + ":");
        RiscVCodeGen_gen_block(self, func, block);
        i = i + 1;
    }

    self.label_counter = self.label_counter + 1;
}

pub fn RiscVCodeGen_gen_block(self: &mut RiscVCodeGen, func: L3Function, block: L3Block) {
    var i: i64 = 0;
    while i < block.instructions.len() {
        RiscVCodeGen_gen_inst(self, func, block.instructions.get(i));
        i = i + 1;
    }
}

// --- Instruction generation ---------------------------------------------

pub fn RiscVCodeGen_gen_inst(self: &mut RiscVCodeGen, func: L3Function, inst: L3Inst) {
    match inst {
        L3Inst::AddrOfSlot(dst, slot) => {
            var d: str = vreg_to_reg(dst);
            RiscVCodeGen_wl(self, "    addi " + d + ", fp, -" + int_to_str(slot.offset));
        }
        L3Inst::GlobalAddr(dst, name, _) => {
            var d: str = vreg_to_reg(dst);
            RiscVCodeGen_wl(self, "    # global addr " + name);
            RiscVCodeGen_wl(self, "    li " + d + ", 0");
        }
        L3Inst::Mov(dst, src) => {
            RiscVCodeGen_gen_mov(self, dst, src);
        }
        L3Inst::Bin(op, dst, a, b, _) => {
            RiscVCodeGen_gen_bin(self, op, dst, a, b);
        }
        L3Inst::Unary(op, dst, src, _) => {
            RiscVCodeGen_gen_unary(self, op, dst, src);
        }
        L3Inst::StackAlloc(dst, bytes, _) => {
            var reg: str = vreg_to_reg(dst);
            RiscVCodeGen_wl(self, "    sub " + reg + ", sp, " + int_to_str(bytes));
        }
        L3Inst::Load(dst, ptr, _) => {
            var d: str = vreg_to_reg(dst);
            var p: str = riscv_operand_to_reg(ptr);
            RiscVCodeGen_wl(self, "    ld " + d + ", 0(" + p + ")");
        }
        L3Inst::Store(ptr, value, _) => {
            var p: str = riscv_operand_to_reg(ptr);
            var v: str = riscv_operand_to_reg(value);
            RiscVCodeGen_wl(self, "    sd " + v + ", 0(" + p + ")");
        }
        L3Inst::FieldAddr(dst, base, offset, _) => {
            var d: str = vreg_to_reg(dst);
            var b: str = riscv_operand_to_reg(base);
            RiscVCodeGen_wl(self, "    addi " + d + ", " + b + ", " + int_to_str(offset));
        }
        L3Inst::ElemAddr(dst, base, index, _) => {
            var d: str = vreg_to_reg(dst);
            var b: str = riscv_operand_to_reg(base);
            var i: str = riscv_operand_to_reg(index);
            RiscVCodeGen_wl(self, "    slli t0, " + i + ", 3");
            RiscVCodeGen_wl(self, "    add " + d + ", " + b + ", t0");
        }
        L3Inst::Jmp(target) => {
            RiscVCodeGen_wl(self, "    j .L" + func.name + int_to_str(self.label_counter) + "_b" + int_to_str(target));
        }
        L3Inst::Br(cond, then_b, else_b) => {
            var c: str = riscv_operand_to_reg(cond);
            RiscVCodeGen_wl(self, "    bnez " + c + ", .L" + func.name + int_to_str(self.label_counter) + "_b" + int_to_str(then_b));
            RiscVCodeGen_wl(self, "    j .L" + func.name + int_to_str(self.label_counter) + "_b" + int_to_str(else_b));
        }
        L3Inst::Ret(value) => {
            RiscVCodeGen_gen_ret(self, value);
        }
        L3Inst::Unreachable => {
            RiscVCodeGen_wl(self, "    ebreak");
        }
        L3Inst::Call(dst, target, args, _) => {
            RiscVCodeGen_gen_call(self, dst, target, args);
        }
        L3Inst::CallPtr(dst, fn_ptr, args, _, _) => {
            RiscVCodeGen_gen_call_ptr(self, dst, fn_ptr, args);
        }
        L3Inst::DynCall(dst, trait_name, method, args, _) => {
            RiscVCodeGen_gen_dyn_call(self, dst, trait_name, method, args);
        }
        L3Inst::MakeDyn(dst, value, _, _) => {
            var d: str = vreg_to_reg(dst);
            var v: str = riscv_operand_to_reg(value);
            if !str_equal(d, v) {
                RiscVCodeGen_wl(self, "    mv " + d + ", " + v);
            }
        }
        L3Inst::Cast(dst, src, _, _, kind) => {
            RiscVCodeGen_gen_cast(self, dst, src, kind);
        }
        L3Inst::TryUnwrap(value, ok_dst, ok_block, err_block) => {
            var v: str = riscv_operand_to_reg(value);
            var d: str = vreg_to_reg(ok_dst);
            RiscVCodeGen_wl(self, "    beqz " + v + ", .L" + func.name + int_to_str(self.label_counter) + "_b" + int_to_str(err_block));
            RiscVCodeGen_wl(self, "    mv " + d + ", " + v);
            RiscVCodeGen_wl(self, "    j .L" + func.name + int_to_str(self.label_counter) + "_b" + int_to_str(ok_block));
        }
        L3Inst::Print(value, _) => {
            var v: str = riscv_operand_to_reg(value);
            RiscVCodeGen_wl(self, "    mv a0, " + v);
            RiscVCodeGen_wl(self, "    call p_print_int");
        }
        L3Inst::Panic(message) => {
            RiscVCodeGen_wl(self, "    # panic: " + message);
            RiscVCodeGen_wl(self, "    ebreak");
        }
    }
}

// --- Simple instruction generators ---------------------------------------

pub fn RiscVCodeGen_gen_mov(self: &mut RiscVCodeGen, dst: VReg, src: Operand) {
    var d: str = vreg_to_reg(dst);
    match src {
        Operand::ImmI(i) => {
            if i >= -2048 && i <= 2047 {
                RiscVCodeGen_wl(self, "    li " + d + ", " + int_to_str(i));
            } else {
                // Load large immediate via lui + addi.
                // Treat i as unsigned for bit extraction (Fides i64 two's
                // complement bit pattern matches u64).
                var v: i64 = i;
                var hi: i64 = v >> 12;
                var lo: i64 = v & 0xfff;
                RiscVCodeGen_wl(self, "    lui " + d + ", " + int_to_str(hi));
                if lo != 0 {
                    RiscVCodeGen_wl(self, "    addi " + d + ", " + d + ", " + int_to_str(lo));
                }
            }
        }
        Operand::VReg(v) => {
            var s: str = vreg_to_reg(v);
            if !str_equal(d, s) {
                RiscVCodeGen_wl(self, "    mv " + d + ", " + s);
            }
        }
        _ => {}
    }
}

pub fn RiscVCodeGen_gen_bin(self: &mut RiscVCodeGen, op: BinOp, dst: VReg, a: Operand, b: Operand) {
    var d: str = vreg_to_reg(dst);
    var l: str = riscv_operand_to_reg(a);
    var r: str = riscv_operand_to_reg(b);
    if binop_eq(op, BinOp::Add) {
        RiscVCodeGen_wl(self, "    add " + d + ", " + l + ", " + r);
    } else if binop_eq(op, BinOp::Sub) {
        RiscVCodeGen_wl(self, "    sub " + d + ", " + l + ", " + r);
    } else if binop_eq(op, BinOp::Mul) {
        RiscVCodeGen_wl(self, "    mul " + d + ", " + l + ", " + r);
    } else if binop_eq(op, BinOp::Div) {
        RiscVCodeGen_wl(self, "    div " + d + ", " + l + ", " + r);
    } else if binop_eq(op, BinOp::Mod) {
        RiscVCodeGen_wl(self, "    rem " + d + ", " + l + ", " + r);
    } else if binop_eq(op, BinOp::BitAnd) {
        RiscVCodeGen_wl(self, "    and " + d + ", " + l + ", " + r);
    } else if binop_eq(op, BinOp::BitOr) {
        RiscVCodeGen_wl(self, "    or " + d + ", " + l + ", " + r);
    } else if binop_eq(op, BinOp::BitXor) {
        RiscVCodeGen_wl(self, "    xor " + d + ", " + l + ", " + r);
    } else if binop_eq(op, BinOp::Shl) {
        RiscVCodeGen_wl(self, "    sll " + d + ", " + l + ", " + r);
    } else if binop_eq(op, BinOp::Shr) {
        RiscVCodeGen_wl(self, "    sra " + d + ", " + l + ", " + r);
    } else if binop_eq(op, BinOp::Eq) {
        RiscVCodeGen_wl(self, "    sub " + d + ", " + l + ", " + r);
        RiscVCodeGen_wl(self, "    seqz " + d + ", " + d);
    } else if binop_eq(op, BinOp::Neq) {
        RiscVCodeGen_wl(self, "    sub " + d + ", " + l + ", " + r);
        RiscVCodeGen_wl(self, "    snez " + d + ", " + d);
    } else if binop_eq(op, BinOp::Lt) {
        RiscVCodeGen_wl(self, "    slt " + d + ", " + l + ", " + r);
    } else if binop_eq(op, BinOp::Gt) {
        RiscVCodeGen_wl(self, "    slt " + d + ", " + r + ", " + l);
    } else if binop_eq(op, BinOp::LtEq) {
        RiscVCodeGen_wl(self, "    slt " + d + ", " + r + ", " + l);
        RiscVCodeGen_wl(self, "    xori " + d + ", " + d + ", 1");
    } else if binop_eq(op, BinOp::GtEq) {
        RiscVCodeGen_wl(self, "    slt " + d + ", " + l + ", " + r);
        RiscVCodeGen_wl(self, "    xori " + d + ", " + d + ", 1");
    } else if binop_eq(op, BinOp::And) {
        RiscVCodeGen_wl(self, "    and " + d + ", " + l + ", " + r);
        RiscVCodeGen_wl(self, "    snez " + d + ", " + d);
    } else if binop_eq(op, BinOp::Or) {
        RiscVCodeGen_wl(self, "    or " + d + ", " + l + ", " + r);
        RiscVCodeGen_wl(self, "    snez " + d + ", " + d);
    }
}

pub fn RiscVCodeGen_gen_unary(self: &mut RiscVCodeGen, op: UnaryOp, dst: VReg, src: Operand) {
    var d: str = vreg_to_reg(dst);
    var s: str = riscv_operand_to_reg(src);
    if unaryop_eq(op, UnaryOp::Neg) {
        RiscVCodeGen_wl(self, "    neg " + d + ", " + s);
    } else if unaryop_eq(op, UnaryOp::Not) {
        RiscVCodeGen_wl(self, "    seqz " + d + ", " + s);
    } else if unaryop_eq(op, UnaryOp::BitNot) {
        RiscVCodeGen_wl(self, "    not " + d + ", " + s);
    }
}

pub fn RiscVCodeGen_gen_ret(self: &mut RiscVCodeGen, value: OptOperand) {
    match value {
        OptOperand::Some(value) => {
            var v: str = riscv_operand_to_reg(value);
            RiscVCodeGen_wl(self, "    mv a0, " + v);
        }
        OptOperand::None => {}
    }
    RiscVCodeGen_wl(self, "    mv sp, s0");
    RiscVCodeGen_wl(self, "    ld ra, 8(sp)");
    RiscVCodeGen_wl(self, "    ld s0, 0(sp)");
    RiscVCodeGen_wl(self, "    addi sp, sp, 16");
    RiscVCodeGen_wl(self, "    return");
}

pub fn RiscVCodeGen_gen_call(self: &mut RiscVCodeGen, dst: OptVReg, target: str, args: Vec<Operand>) {
    var i: i64 = 0;
    while i < args.len() && i < 8 {
        var a: str = riscv_operand_to_reg(args.get(i));
        var arg_reg: str = riscv_arg_reg(i);
        if !str_equal(a, arg_reg) {
            RiscVCodeGen_wl(self, "    mv " + arg_reg + ", " + a);
        }
        i = i + 1;
    }
    RiscVCodeGen_wl(self, "    call " + target);
    match dst {
        OptVReg::Some(d) => {
            var dreg: str = vreg_to_reg(d);
            if !str_equal(dreg, "a0") {
                RiscVCodeGen_wl(self, "    mv " + dreg + ", a0");
            }
        }
        OptVReg::None => {}
    }
}

pub fn RiscVCodeGen_gen_call_ptr(self: &mut RiscVCodeGen, dst: OptVReg, fn_ptr: Operand, args: Vec<Operand>) {
    var ptr: str = riscv_operand_to_reg(fn_ptr);
    var i: i64 = 0;
    while i < args.len() && i < 7 {
        var a: str = riscv_operand_to_reg(args.get(i));
        var arg_reg: str = riscv_arg_reg(i);
        if !str_equal(a, arg_reg) {
            RiscVCodeGen_wl(self, "    mv " + arg_reg + ", " + a);
        }
        i = i + 1;
    }
    RiscVCodeGen_wl(self, "    jalr " + ptr);
    match dst {
        OptVReg::Some(d) => {
            var dreg: str = vreg_to_reg(d);
            if !str_equal(dreg, "a0") {
                RiscVCodeGen_wl(self, "    mv " + dreg + ", a0");
            }
        }
        OptVReg::None => {}
    }
}

pub fn RiscVCodeGen_gen_dyn_call(self: &mut RiscVCodeGen, dst: OptVReg, trait_name: str, method: str, args: Vec<Operand>) {
    var callee: str = trait_name + "_" + method;
    var i: i64 = 0;
    while i < args.len() && i < 8 {
        var a: str = riscv_operand_to_reg(args.get(i));
        var arg_reg: str = riscv_arg_reg(i);
        if !str_equal(a, arg_reg) {
            RiscVCodeGen_wl(self, "    mv " + arg_reg + ", " + a);
        }
        i = i + 1;
    }
    RiscVCodeGen_wl(self, "    call " + callee);
    match dst {
        OptVReg::Some(d) => {
            var dreg: str = vreg_to_reg(d);
            if !str_equal(dreg, "a0") {
                RiscVCodeGen_wl(self, "    mv " + dreg + ", a0");
            }
        }
        OptVReg::None => {}
    }
}

pub fn RiscVCodeGen_gen_cast(self: &mut RiscVCodeGen, dst: VReg, src: Operand, kind: CastKind) {
    var d: str = vreg_to_reg(dst);
    var s: str = riscv_operand_to_reg(src);
    if riscv_cast_kind_eq(kind, CastKind::BitCast) {
        if !str_equal(d, s) {
            RiscVCodeGen_wl(self, "    mv " + d + ", " + s);
        }
    } else if riscv_cast_kind_eq(kind, CastKind::IntExtend) {
        RiscVCodeGen_wl(self, "    sext.w " + d + ", " + s);
    } else if riscv_cast_kind_eq(kind, CastKind::IntTrunc) {
        RiscVCodeGen_wl(self, "    mv " + d + ", " + s);
    } else if riscv_cast_kind_eq(kind, CastKind::IntToFloat) {
        RiscVCodeGen_wl(self, "    fcvt.s.l " + d + ", " + s);
    } else if riscv_cast_kind_eq(kind, CastKind::FloatToInt) {
        RiscVCodeGen_wl(self, "    fcvt.l.s " + d + ", " + s);
    }
}

// ===========================================================================
// Operand / register helpers
// ===========================================================================

pub fn riscv_operand_to_reg(op: Operand) -> str {
    match op {
        Operand::VReg(v) => { return vreg_to_reg(v); }
        _ => { return "t0"; } // scratch register for immediates/slots
    }
    return "t0";
}

/// RISC-V argument register name by index (a0-a7).
pub fn riscv_arg_reg(i: i64) -> str {
    if i == 0 { return "a0"; }
    if i == 1 { return "a1"; }
    if i == 2 { return "a2"; }
    if i == 3 { return "a3"; }
    if i == 4 { return "a4"; }
    if i == 5 { return "a5"; }
    if i == 6 { return "a6"; }
    if i == 7 { return "a7"; }
    return "a0";
}

/// Escape a string for .asciz emission (backslash and double quote).
pub fn riscv_escape_string(s: str) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c == 92 { // backslash
            out = out + "\\\\";
        } else if c == 34 { // double quote
            out = out + "\\\"";
        } else {
            out = out + char_to_str(c);
        }
        i = i + 1;
    }
    return out;
}

/// CastKind equality helper (mirrors ast::binop_eq pattern).
pub fn riscv_cast_kind_eq(a: CastKind, b: CastKind) -> bool {
    match a {
        CastKind::BitCast => { match b { CastKind::BitCast => { return true; }, _ => { return false; } } }
        CastKind::IntExtend => { match b { CastKind::IntExtend => { return true; }, _ => { return false; } } }
        CastKind::IntTrunc => { match b { CastKind::IntTrunc => { return true; }, _ => { return false; } } }
        CastKind::IntToFloat => { match b { CastKind::IntToFloat => { return true; }, _ => { return false; } } }
        CastKind::FloatToInt => { match b { CastKind::FloatToInt => { return true; }, _ => { return false; } } }
    }
    return false;
}
