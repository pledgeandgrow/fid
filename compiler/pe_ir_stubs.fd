// ===========================================================================
// PeirGen methods
// ===========================================================================
// ===========================================================================
// PeirGen methods
// ===========================================================================

/// The function a call to `name` runs: a `pe_runtime_alias`, the Fides
/// runtime's `pert_X` for builtin `p_X` (it replaces a machine-code stub
/// of the same builtin), else `name` (a stub, a thunk, a program function).
pub fn PeirGen_resolve_call(self: &PeirGen, name: str) -> str {
    var i: i64 = 0;
    while i < self.c_overrides.len() {
        var ov: COverride = self.c_overrides.get(i);
        if ov.name == name {
            return ov.over;
        }
        i = i + 1;
    }
    var alias: str = pe_runtime_alias(name);
    if alias != name {
        return alias;
    }
    var p: str = pert_name(name);
    if p != "" && pe_strs_contains(self.module_fns, p) {
        return p;
    }
    // RT8: core's p_malloc_uninit (its Fides body is p_malloc's zeroed
    // block, the fallback of the backends without a path of their own) runs
    // the allocator's stub without the zeroing, PeirGen_gen_malloc_uninit
    // (rcx = size: the call site leaves core's env word out)
    if name == "p_malloc_uninit" && HashMap_contains(self.func_labels, "__p_malloc_uninit") {
        return "__p_malloc_uninit";
    }
    return name;
}

/// Call runtime builtin `name` with `nargs` (at most 3) arguments already
/// in rcx, rdx, r8.  A Fides stand-in takes `__env` first: the arguments
/// move up one register and rcx gets a null environment.
pub fn PeirGen_call_builtin(self: &mut PeirGen, name: str, nargs: i64) -> void {
    var target: str = PeirGen_resolve_call(self, name);
    if pe_strs_contains(self.module_fns, target) && !pe_strs_contains(self.module_fns, name) {
        // debug_assert!(nargs <= 3)
        if nargs > 2 {
            PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_R8);
        }
        if nargs > 1 {
            PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RDX);
        }
        if nargs > 0 {
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        }
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    }
    PeirGen_call_runtime(self, target);
}

/// The id of dyn values of type `name` (stable within one binary).
pub fn PeirGen_dyn_type_id(self: &mut PeirGen, name: str) -> i64 {
    var i: i64 = 0;
    while i < self.dyn_type_ids.len() {
        var e: DynTypeId = self.dyn_type_ids.get(i);
        if e.name == name {
            return e.id;
        }
        if str_compare(e.name, name) > 0 {
            // Insert sorted at i (BTreeMap order); id = position-independent
            var next: i64 = self.dyn_type_ids.len() + 1;
            var fresh: DynTypeId = DynTypeId {
                name: name, id: next
            };
            self.dyn_type_ids.push(fresh);
            var j: i64 = self.dyn_type_ids.len() - 1;
            while j > i {
                self.dyn_type_ids.set(j, self.dyn_type_ids.get(j - 1));
                j = j - 1;
            }
            self.dyn_type_ids.set(i, fresh);
            return next;
        }
        i = i + 1;
    }
    var next2: i64 = self.dyn_type_ids.len() + 1;
    self.dyn_type_ids.push(DynTypeId {
        name: name, id: next2
    });
    return next2;
}

/// Insert (callee -> caller) into the sorted unresolved table
/// (BTreeMap<String, BTreeSet<String>>).
fn pe_unresolved_add(unresolved: Vec<UnresolvedCall>, name: str, caller: str) -> Vec<UnresolvedCall> {
    var unresolved = unresolved;
    var i: i64 = 0;
    while i < unresolved.len() {
        var e: UnresolvedCall = unresolved.get(i);
        if e.name == name {
            e.callers = pe_strs_insert_sorted(e.callers, caller);
            unresolved.set(i, e);
            return unresolved;
        }
        if str_compare(e.name, name) > 0 {
            var cs: Vec<str> = Vec::new();
            cs = pe_strs_insert_sorted(cs, caller);
            var fresh: UnresolvedCall = UnresolvedCall {
                name: name, callers: cs
            };
            unresolved.push(unresolved.get(unresolved.len() - 1));
            var j: i64 = unresolved.len() - 1;
            while j > i {
                unresolved.set(j, unresolved.get(j - 1));
                j = j - 1;
            }
            unresolved.set(i, fresh);
            return unresolved;
        }
        i = i + 1;
    }
    var cs2: Vec<str> = Vec::new();
    cs2.push(caller);
    unresolved.push(UnresolvedCall {
        name: name, callers: cs2
    });
    return unresolved;
}

/// Call runtime or program function `name`; one nobody defines traps,
/// and makes generate_pe (or generate_flat) refuse the program.
pub fn PeirGen_call_runtime(self: &mut PeirGen, name: str) -> void {
    if HashMap_contains(self.func_labels, name) {
        var label: i64 = HashMap_get(self.func_labels, name);
        PeirEnc_call_label(&mut self.enc, label);
        return;
    }
    self.unresolved = pe_unresolved_add(self.unresolved, name, self.cur_func);
    self.unres_adds = self.unres_adds + 1;
    PeirEnc_ud2(&mut self.enc);
}

/// Place the label of function `name` (16-byte aligned).
pub fn PeirGen_place_fn(self: &mut PeirGen, name: str) -> void {
    var label: i64 = HashMap_get(self.func_labels, name);
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, label);
}

/// rdata offset of string constant `s` (0 when absent, as unwrap_or(&0)).
pub fn PeirGen_str_off(self: &PeirGen, s: str) -> i64 {
    return HashMap_get(self.string_rdata_offsets, s);
}

/// Get IAT rdata offset for an import
pub fn PeirGen_iat_off(self: &PeirGen, idx: i64) -> i64 {
    return self.iat_rdata_offsets.get(idx);
}

// ===========================================================================
// Bare-metal runtime (`fid emit --bare`, release G2, G3)
//
// No OS: the hardware stubs (interrupts, MMU, GDT, user mode, COM1) are the
// real instructions, p_malloc is a bump allocator from g_pe_bare_heap,
// p_free does nothing, and printing writes to COM1 (port 0x3F8), which is
// what QEMU's `-serial stdio` shows. A panic, a failed overflow or division
// check included, calls the program's @panic_handler (with the message)
// when it has one, else prints "panic: <message>" to COM1; then the CPU
// halts with interrupts off. Any other runtime function traps (ud2).
// ===========================================================================

/// Where the bare-metal heap starts (the bump allocator's first block).
pub var g_pe_bare_heap: i64 = 0x300000;
/// Where a flat binary is loaded (its first byte, a jump to the entry).
pub var g_pe_bare_load: i64 = 0x10000;
/// A static Linux ELF executable instead (release F4, first step): the bare
/// build's code with the system calls of Linux for output, heap and exit.
pub var g_pe_elf: bool = false;
/// The program's @panic_handler ("" when it has none). Like every Fides
/// function it takes `__env` (null here) before the message.
pub var g_pe_bare_panic_handler: str = "";
// ---------------------------------------------------------------------------
// The bootable bare image (release G1). With PEIR_BARE_BOOT a `--bare` (and
// `--boot`) build is a kernel QEMU's `-kernel` and GRUB load directly:
//
//   load+0x0000  jmp load+0x1000          (entry of a 64-bit loader such as
//                                          scripts/bare-run.c)
//   load+0x0008  Multiboot 1 header        (QEMU -kernel, GRUB `multiboot`)
//   load+0x0028  Multiboot 2 header        (GRUB `multiboot2`)
//   load+0x0080  32-bit entry: page tables, PAE, long mode, the GDT below
//   load+0x0300  64-bit trampoline: segments, TSS, stack, to boot_entry64
//   load+0x0400  GDT: null, 0x08 kernel code, 0x10 kernel data, 0x18 user
//                code, 0x20 user data (DPL 3), 0x28 TSS (16 bytes)
//   load+0x1000  the flat binary as before: [code][int3 to 4 KB][data]
//
// The machine the program then runs on (the bare ABI, which kernels such as
// fides-os build on):
//   0x0500  IDT descriptor (lidt'd), 0x0510 error code of the last exception
//           an interrupt function took, 0x0520 the boot loader's magic
//           (0x2BADB002 Multiboot 1, 0x36D76289 Multiboot 2), 0x0528 its
//           boot information pointer
//   0x1000  IDT, 256 gates: every vector has a default handler (an exception
//           panics with its vector, error code, rip and, for #PF, the
//           address; IRQs 0x20-0x2F are acknowledged), `@interrupt(N)`
//           functions are wired to their vector
//   0x4000  TSS (rsp0 = 0x90000), loaded
//   0x70000 PML4, 0x71000 PDPT, 0x76000-0x79FFF four PDs: the first 4 GB
//           identity-mapped with 2 MB pages; 0x72000-0x75FFF user tables
//           mapping 0x10000 and 0xB8000 (p_enter_user_mode switches to them)
//   0x90000 top of the stack main runs on
//   PIC     remapped to 0x20/0x28, IRQ0 (timer) and IRQ1 (keyboard) unmasked,
//           interrupts on (so `hlt` returns at the next timer tick, ~55 ms;
//           p_cli() first to set up tables of one's own)
//   SSE     on (CR4.OSFXSR/OSXMMEXCPT), x87 initialised
// The end of main writes its result to port 0xF4 and a panic writes 1: under
// QEMU with `-device isa-debug-exit` that ends QEMU with status 2*code+1.
// Elsewhere the CPU halts, as before.
// ---------------------------------------------------------------------------

/// Off: `--bare` writes the old flat binary at 0x10000 (no headers, no long
/// mode switch, no IDT, no debug exit), `--boot` the old pe.fd kernel.
pub const PEIR_BARE_BOOT: bool = true;
/// Bytes in front of the flat binary of a bootable image
pub const PEIR_BOOT_PREFIX: i64 = 0x1000;
/// Where a bootable image is loaded (`--load <address>` changes it)
pub var g_pe_bare_boot_load: i64 = 0x100000;
/// (vector, function label) of each `@interrupt(N)` function (set by
/// PeirGen_generate before the entry point is generated)
pub var g_pe_bare_irqs: Vec<i64> = Vec::new();
/// main returns nothing: the exit code is 0
pub var g_pe_bare_main_void: bool = false;
/// Label of boot_entry64 (the trampoline's target) and of the 256 default
/// vector stubs and the debug exit (al = code)
pub var g_pe_bare_boot_label: i64 = -1;
pub var g_pe_bare_vec_stubs: i64 = -1;
pub var g_pe_bare_exit: i64 = -1;
/// The boot image is being built (a bare build, not --elf)
pub fn pe_bare_boot_on() -> bool {
    return PEIR_BARE_BOOT && !g_pe_elf && !g_pe_uefi;
}

// ---------------------------------------------------------------------------
// UEFI application (`fid emit --uefi`, roadmap Phase 16 "UEFI PE32+
// emission"): the bare build's code in a PE32+ image of subsystem
// EFI_APPLICATION (pe_build_efi in pe_ir_enc.fd). The firmware may load it
// anywhere: the code is RIP-relative, and the only absolute addresses (the
// slots of str-literal globals) get DIR64 base relocations.
//
//   entry (rcx = ImageHandle, rdx = SystemTable): saves the registers the
//          UEFI calling convention preserves (rbx, rbp, rdi, rsi, r12-r15,
//          xmm6-xmm15), turns the watchdog off, takes the heap (128 MB,
//          halved until it fits, at least 1 MB) and a 1 MB stack of its own
//          from AllocatePages, runs main on that stack
//   print  ConOut->OutputString: UTF-8 to UCS-2 ("\n" becomes "\r\n", a
//          character outside the BMP or a bad sequence U+FFFD); eprint too
//   exit   main's result is the EFI_STATUS the image returns (a void main
//          returns EFI_SUCCESS); the heap and stack pages are freed first
//   panic  "panic: <message>" (or the @panic_handler), then EFI_ABORTED
//   heap   the bump allocator, now with a bound: past it, "out of memory"
//
// The allocator state's words in a bare build: +0 cursor (as before), +8
// heap end, +16 SystemTable, +24 ImageHandle, +32 the entry's stack
// pointer, +40 stack base, +48 exit status, +56 heap base, +64 heap pages.
// ---------------------------------------------------------------------------

/// A UEFI application is being built (pe_ir_generate_uefi)
pub var g_pe_uefi: bool = false;
/// Flat-image offsets of the 8-byte absolute addresses (DIR64 relocations)
pub var g_pe_uefi_abs: Vec<i64> = Vec::new();
/// Size of the flat image's code part (a multiple of 4 KB): where .data starts
/// (one element, set by PeirGen_generate; a Vec: an i64 global set there
/// read back wrong under `fid run`, the interpreter)
pub var g_pe_uefi_code_size: Vec<i64> = Vec::new();
/// Label of the exit routine (rax = EFI_STATUS)
pub var g_pe_uefi_exit: i64 = -1;
pub const PE_EFI_STACK_PAGES: i64 = 256;
pub const PE_EFI_HEAP_PAGES: i64 = 0x8000;
pub const PE_EFI_ABORTED: i64 = 0x8000000000000015;
pub const PE_EFI_OUT_OF_RESOURCES: i64 = 0x8000000000000009;

/// rax = SystemTable->BootServices (UEFI)
fn PeirGen_uefi_bs(self: &mut PeirGen) -> void {
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, self.alloc_rdata_off + 16);
    pe_emit4(&mut self.enc, 0x48, 0x8B, 0x40, 0x60);
    // mov rax, [rax+0x60]
}

/// call [rax + off]: a boot service (UEFI)
fn PeirGen_uefi_call_rax(self: &mut PeirGen, off: i64) -> void {
    pe_emit2(&mut self.enc, 0xFF, 0x90);
    pe_emit4(&mut self.enc, off & 0xFF, (off >> 8) & 0xFF, (off >> 16) & 0xFF, (off >> 24) & 0xFF);
}

/// movups [rsp + 16k], xmm(6+k) for k = 0..9, or the loads back (UEFI:
/// xmm6-xmm15 are preserved across a call)
fn PeirGen_uefi_xmm_save(self: &mut PeirGen, load: bool) -> void {
    var k: i64 = 0;
    while k < 10 {
        var n: i64 = 6 + k;
        if n >= 8 {
            pe_emit1(&mut self.enc, 0x44);
            // REX.R
        }
        if load {
            pe_emit2(&mut self.enc, 0x0F, 0x10);
        } else {
            pe_emit2(&mut self.enc, 0x0F, 0x11);
        }
        pe_emit2(&mut self.enc, 0x84 + ((n & 7) << 3), 0x24);
        // [rsp + disp32]
        pe_emit4(&mut self.enc, 16 * k, 0, 0, 0);
        k = k + 1;
    }
}

/// The UEFI entry's first instructions (rcx = ImageHandle, rdx =
/// SystemTable): save what the caller expects back, remember the stack and
/// both arguments. 8 pushes and 168 bytes keep rsp 16-byte aligned.
pub fn PeirGen_gen_uefi_entry(self: &mut PeirGen) -> void {
    var a: i64 = self.alloc_rdata_off;
    pe_emit4(&mut self.enc, 0x53, 0x55, 0x57, 0x56);
    // push rbx; push rbp; push rdi; push rsi
    pe_emit8(&mut self.enc, 0x41, 0x54, 0x41, 0x55, 0x41, 0x56, 0x41, 0x57);
    // push r12; push r13; push r14; push r15
    PeirEnc_sub_rsp_i32(&mut self.enc, 168);
    PeirGen_uefi_xmm_save(self, false);
    PeirEnc_mov_rip_reg(&mut self.enc, a + 32, PEIR_RSP);
    PeirEnc_mov_rip_reg(&mut self.enc, a + 16, PEIR_RDX);
    PeirEnc_mov_rip_reg(&mut self.enc, a + 24, PEIR_RCX);
}

/// After the bare entry's alignment: watchdog off, the heap and the stack
/// from AllocatePages, then rsp on the new stack (with shadow space).
pub fn PeirGen_gen_uefi_start(self: &mut PeirGen) -> void {
    var a: i64 = self.alloc_rdata_off;
    var heap_try: i64 = PeirEnc_alloc_label(&mut self.enc);
    var heap_ok: i64 = PeirEnc_alloc_label(&mut self.enc);
    var fail: i64 = PeirEnc_alloc_label(&mut self.enc);
    var go: i64 = PeirEnc_alloc_label(&mut self.enc);
    // SetWatchdogTimer(0, 0, 0, NULL): the firmware's 5-minute reset off
    PeirGen_uefi_bs(self);
    pe_emit4(&mut self.enc, 0x31, 0xC9, 0x31, 0xD2);
    // xor ecx, ecx; xor edx, edx
    pe_emit6(&mut self.enc, 0x45, 0x31, 0xC0, 0x45, 0x31, 0xC9);
    // xor r8d, r8d; xor r9d, r9d
    PeirGen_uefi_call_rax(self, 256);
    // The heap: AllocatePages(AllocateAnyPages, EfiLoaderData, rbx, &base),
    // halving rbx until it fits (at least 256 pages)
    pe_emit1(&mut self.enc, 0xBB);
    pe_emit4(&mut self.enc, PE_EFI_HEAP_PAGES & 0xFF, (PE_EFI_HEAP_PAGES >> 8) & 0xFF, (PE_EFI_HEAP_PAGES >> 16) & 0xFF, 0);
    // mov ebx, pages
    PeirEnc_place_label(&mut self.enc, heap_try);
    PeirGen_uefi_bs(self);
    pe_emit2(&mut self.enc, 0x31, 0xC9);
    // xor ecx, ecx (AllocateAnyPages)
    pe_emit5(&mut self.enc, 0xBA, 0x02, 0x00, 0x00, 0x00);
    // mov edx, 2 (EfiLoaderData)
    pe_emit3(&mut self.enc, 0x49, 0x89, 0xD8);
    // mov r8, rbx
    PeirEnc_lea_rip(&mut self.enc, PEIR_R9, a + 56);
    PeirGen_uefi_call_rax(self, 40);
    // AllocatePages
    pe_emit3(&mut self.enc, 0x48, 0x85, 0xC0);
    // test rax, rax
    PeirEnc_jcc_label(&mut self.enc, 0x4, heap_ok);
    // jz
    pe_emit3(&mut self.enc, 0x48, 0xD1, 0xEB);
    // shr rbx, 1
    pe_emit7(&mut self.enc, 0x48, 0x81, 0xFB, 0x00, 0x01, 0x00, 0x00);
    // cmp rbx, 256
    PeirEnc_jcc_label(&mut self.enc, 0x3, heap_try);
    // jae
    PeirEnc_jmp_label(&mut self.enc, fail);
    PeirEnc_place_label(&mut self.enc, heap_ok);
    PeirEnc_mov_rip_reg(&mut self.enc, a + 64, PEIR_RBX);
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, a + 56);
    PeirEnc_mov_rip_reg(&mut self.enc, a, PEIR_RAX);
    // cursor = base
    pe_emit3(&mut self.enc, 0x48, 0x89, 0xDA);
    // mov rdx, rbx
    pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE2, 0x0C);
    // shl rdx, 12
    pe_emit3(&mut self.enc, 0x48, 0x01, 0xC2);
    // add rdx, rax
    PeirEnc_mov_rip_reg(&mut self.enc, a + 8, PEIR_RDX);
    // heap end
    // The stack: PE_EFI_STACK_PAGES pages (native frames are large)
    PeirGen_uefi_bs(self);
    pe_emit2(&mut self.enc, 0x31, 0xC9);
    pe_emit5(&mut self.enc, 0xBA, 0x02, 0x00, 0x00, 0x00);
    pe_emit2(&mut self.enc, 0x41, 0xB8);
    pe_emit4(&mut self.enc, PE_EFI_STACK_PAGES & 0xFF, (PE_EFI_STACK_PAGES >> 8) & 0xFF, 0, 0);
    // mov r8d, pages
    PeirEnc_lea_rip(&mut self.enc, PEIR_R9, a + 40);
    PeirGen_uefi_call_rax(self, 40);
    pe_emit3(&mut self.enc, 0x48, 0x85, 0xC0);
    PeirEnc_jcc_label(&mut self.enc, 0x5, fail);
    // jnz
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, a + 40);
    var top: i64 = PE_EFI_STACK_PAGES * 4096;
    pe_emit2(&mut self.enc, 0x48, 0x05);
    pe_emit4(&mut self.enc, top & 0xFF, (top >> 8) & 0xFF, (top >> 16) & 0xFF, (top >> 24) & 0xFF);
    // add rax, size
    pe_emit3(&mut self.enc, 0x48, 0x89, 0xC4);
    // mov rsp, rax
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_jmp_label(&mut self.enc, go);
    PeirEnc_place_label(&mut self.enc, fail);
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "UEFI: not enough memory for the heap and the stack\n"));
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_str"));
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, PE_EFI_OUT_OF_RESOURCES);
    PeirEnc_jmp_label(&mut self.enc, g_pe_uefi_exit);
    PeirEnc_place_label(&mut self.enc, go);
}

/// The exit routine (rax = EFI_STATUS): back on the firmware's stack, free
/// the heap and the stack pages, restore what the entry saved, return.
fn PeirGen_gen_uefi_exit(self: &mut PeirGen) -> void {
    var a: i64 = self.alloc_rdata_off;
    var skip_heap: i64 = PeirEnc_alloc_label(&mut self.enc);
    var skip_stack: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, g_pe_uefi_exit);
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RSP, a + 32);
    PeirEnc_mov_rip_reg(&mut self.enc, a + 48, PEIR_RAX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    // FreePages(heap base, heap pages)
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RCX, a + 56);
    pe_emit3(&mut self.enc, 0x48, 0x85, 0xC9);
    // test rcx, rcx
    PeirEnc_jcc_label(&mut self.enc, 0x4, skip_heap);
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RDX, a + 64);
    PeirGen_uefi_bs(self);
    PeirGen_uefi_call_rax(self, 48);
    PeirEnc_place_label(&mut self.enc, skip_heap);
    // FreePages(stack base, stack pages)
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RCX, a + 40);
    pe_emit3(&mut self.enc, 0x48, 0x85, 0xC9);
    PeirEnc_jcc_label(&mut self.enc, 0x4, skip_stack);
    pe_emit1(&mut self.enc, 0xBA);
    pe_emit4(&mut self.enc, PE_EFI_STACK_PAGES & 0xFF, (PE_EFI_STACK_PAGES >> 8) & 0xFF, 0, 0);
    // mov edx, pages
    PeirGen_uefi_bs(self);
    PeirGen_uefi_call_rax(self, 48);
    PeirEnc_place_label(&mut self.enc, skip_stack);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, a + 48);
    PeirGen_uefi_xmm_save(self, true);
    PeirEnc_add_rsp_i32(&mut self.enc, 168);
    pe_emit8(&mut self.enc, 0x41, 0x5F, 0x41, 0x5E, 0x41, 0x5D, 0x41, 0x5C);
    // pop r15; pop r14; pop r13; pop r12
    pe_emit4(&mut self.enc, 0x5E, 0x5F, 0x5D, 0x5B);
    // pop rsi; pop rdi; pop rbp; pop rbx
    PeirEnc_ret(&mut self.enc);
}

/// UEFI output: putc(cl), p_print_str / p_eprint_str(rcx = C string)
/// through ConOut->OutputString, and the exit routine. The string is
/// converted 125 UCS-2 characters at a time into a buffer on the stack.
pub fn PeirGen_gen_uefi_io(self: &mut PeirGen, putc: i64, pstr: i64, estr: i64) -> void {
    var a: i64 = self.alloc_rdata_off;
    var outer: i64 = PeirEnc_alloc_label(&mut self.enc);
    var fill: i64 = PeirEnc_alloc_label(&mut self.enc);
    var not_nl: i64 = PeirEnc_alloc_label(&mut self.enc);
    var three: i64 = PeirEnc_alloc_label(&mut self.enc);
    var four: i64 = PeirEnc_alloc_label(&mut self.enc);
    var bad: i64 = PeirEnc_alloc_label(&mut self.enc);
    var store: i64 = PeirEnc_alloc_label(&mut self.enc);
    var flush: i64 = PeirEnc_alloc_label(&mut self.enc);
    var after: i64 = PeirEnc_alloc_label(&mut self.enc);
    var done: i64 = PeirEnc_alloc_label(&mut self.enc);
    // putc(cl): a one-byte string on the stack
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, putc);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 16);
    pe_emit3(&mut self.enc, 0x88, 0x0C, 0x24);
    // mov [rsp], cl
    pe_emit5(&mut self.enc, 0xC6, 0x44, 0x24, 0x01, 0x00);
    // mov byte [rsp+1], 0
    pe_emit3(&mut self.enc, 0x48, 0x89, 0xE1);
    // mov rcx, rsp
    PeirEnc_call_label(&mut self.enc, pstr);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);

    // p_print_str / p_eprint_str (rcx): rsi = source, rdi = buffer, r10d = count
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, pstr);
    PeirEnc_place_label(&mut self.enc, estr);
    pe_emit4(&mut self.enc, 0x55, 0x48, 0x89, 0xE5);
    // push rbp; mov rbp, rsp
    pe_emit2(&mut self.enc, 0x56, 0x57);
    // push rsi; push rdi
    PeirEnc_sub_rsp_i32(&mut self.enc, 288);
    // shadow space, 128 UCS-2 characters at rsp+32
    pe_emit3(&mut self.enc, 0x48, 0x89, 0xCE);
    // mov rsi, rcx
    pe_emit3(&mut self.enc, 0x48, 0x85, 0xF6);
    // test rsi, rsi
    PeirEnc_jcc_label(&mut self.enc, 0x4, done);
    PeirEnc_place_label(&mut self.enc, outer);
    pe_emit5(&mut self.enc, 0x48, 0x8D, 0x7C, 0x24, 0x20);
    // lea rdi, [rsp+32]
    pe_emit3(&mut self.enc, 0x45, 0x31, 0xD2);
    // xor r10d, r10d
    PeirEnc_place_label(&mut self.enc, fill);
    pe_emit4(&mut self.enc, 0x41, 0x83, 0xFA, 0x7D);
    // cmp r10d, 125
    PeirEnc_jcc_label(&mut self.enc, 0x3, flush);
    // jae
    pe_emit3(&mut self.enc, 0x0F, 0xB6, 0x06);
    // movzx eax, byte [rsi]
    pe_emit2(&mut self.enc, 0x85, 0xC0);
    // test eax, eax
    PeirEnc_jcc_label(&mut self.enc, 0x4, flush);
    // jz: the end of the string
    pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC6);
    // inc rsi
    pe_emit3(&mut self.enc, 0x83, 0xF8, 0x0A);
    // cmp eax, 10
    PeirEnc_jcc_label(&mut self.enc, 0x5, not_nl);
    // jne
    pe_emit5(&mut self.enc, 0x66, 0xC7, 0x07, 0x0D, 0x00);
    // mov word [rdi], 13 (a newline is CR LF)
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xC7, 0x02);
    // add rdi, 2
    pe_emit3(&mut self.enc, 0x41, 0xFF, 0xC2);
    // inc r10d
    PeirEnc_jmp_label(&mut self.enc, store);
    PeirEnc_place_label(&mut self.enc, not_nl);
    pe_emit5(&mut self.enc, 0x3D, 0x80, 0x00, 0x00, 0x00);
    // cmp eax, 0x80
    PeirEnc_jcc_label(&mut self.enc, 0x2, store);
    // jb: ASCII
    pe_emit5(&mut self.enc, 0x3D, 0xC0, 0x00, 0x00, 0x00);
    // cmp eax, 0xC0
    PeirEnc_jcc_label(&mut self.enc, 0x2, bad);
    // jb: a stray continuation byte
    pe_emit5(&mut self.enc, 0x3D, 0xE0, 0x00, 0x00, 0x00);
    // cmp eax, 0xE0
    PeirEnc_jcc_label(&mut self.enc, 0x3, three);
    // jae
    pe_emit3(&mut self.enc, 0x83, 0xE0, 0x1F);
    // and eax, 0x1F (two bytes)
    PeirGen_uefi_utf8_cont(self, bad);
    PeirEnc_jmp_label(&mut self.enc, store);
    PeirEnc_place_label(&mut self.enc, three);
    pe_emit5(&mut self.enc, 0x3D, 0xF0, 0x00, 0x00, 0x00);
    // cmp eax, 0xF0
    PeirEnc_jcc_label(&mut self.enc, 0x3, four);
    // jae
    pe_emit3(&mut self.enc, 0x83, 0xE0, 0x0F);
    // and eax, 0x0F (three bytes)
    PeirGen_uefi_utf8_cont(self, bad);
    PeirGen_uefi_utf8_cont(self, bad);
    PeirEnc_jmp_label(&mut self.enc, store);
    // four bytes (outside UCS-2): skip the continuation bytes, U+FFFD
    PeirEnc_place_label(&mut self.enc, four);
    pe_emit3(&mut self.enc, 0x0F, 0xB6, 0x16);
    // movzx edx, byte [rsi]
    pe_emit6(&mut self.enc, 0x81, 0xE2, 0xC0, 0x00, 0x00, 0x00);
    // and edx, 0xC0
    pe_emit6(&mut self.enc, 0x81, 0xFA, 0x80, 0x00, 0x00, 0x00);
    // cmp edx, 0x80
    PeirEnc_jcc_label(&mut self.enc, 0x5, bad);
    // jne
    pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC6);
    // inc rsi
    PeirEnc_jmp_label(&mut self.enc, four);
    PeirEnc_place_label(&mut self.enc, bad);
    pe_emit5(&mut self.enc, 0xB8, 0xFD, 0xFF, 0x00, 0x00);
    // mov eax, 0xFFFD
    PeirEnc_place_label(&mut self.enc, store);
    pe_emit3(&mut self.enc, 0x66, 0x89, 0x07);
    // mov [rdi], ax
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xC7, 0x02);
    // add rdi, 2
    pe_emit3(&mut self.enc, 0x41, 0xFF, 0xC2);
    // inc r10d
    PeirEnc_jmp_label(&mut self.enc, fill);
    // OutputString(ConOut, buffer)
    PeirEnc_place_label(&mut self.enc, flush);
    pe_emit5(&mut self.enc, 0x66, 0xC7, 0x07, 0x00, 0x00);
    // mov word [rdi], 0
    pe_emit3(&mut self.enc, 0x45, 0x85, 0xD2);
    // test r10d, r10d
    PeirEnc_jcc_label(&mut self.enc, 0x4, after);
    // jz
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, a + 16);
    pe_emit4(&mut self.enc, 0x48, 0x8B, 0x48, 0x40);
    // mov rcx, [rax+0x40] (ConOut)
    pe_emit3(&mut self.enc, 0x48, 0x85, 0xC9);
    // test rcx, rcx
    PeirEnc_jcc_label(&mut self.enc, 0x4, after);
    // jz
    pe_emit5(&mut self.enc, 0x48, 0x8D, 0x54, 0x24, 0x20);
    // lea rdx, [rsp+32]
    pe_emit3(&mut self.enc, 0xFF, 0x51, 0x08);
    // call [rcx+8] (OutputString)
    PeirEnc_place_label(&mut self.enc, after);
    pe_emit3(&mut self.enc, 0x80, 0x3E, 0x00);
    // cmp byte [rsi], 0
    PeirEnc_jcc_label(&mut self.enc, 0x5, outer);
    // jne: more of the string
    PeirEnc_place_label(&mut self.enc, done);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 288);
    pe_emit3(&mut self.enc, 0x5F, 0x5E, 0x5D);
    // pop rdi; pop rsi; pop rbp
    PeirEnc_ret(&mut self.enc);

    PeirGen_gen_uefi_exit(self);
}

/// One UTF-8 continuation byte into eax (eax = eax << 6 | byte & 0x3F),
/// or to `bad` (not consumed) when [rsi] is not one.
fn PeirGen_uefi_utf8_cont(self: &mut PeirGen, bad: i64) -> void {
    pe_emit3(&mut self.enc, 0x0F, 0xB6, 0x16);
    // movzx edx, byte [rsi]
    pe_emit2(&mut self.enc, 0x89, 0xD1);
    // mov ecx, edx
    pe_emit6(&mut self.enc, 0x81, 0xE1, 0xC0, 0x00, 0x00, 0x00);
    // and ecx, 0xC0
    pe_emit6(&mut self.enc, 0x81, 0xF9, 0x80, 0x00, 0x00, 0x00);
    // cmp ecx, 0x80
    PeirEnc_jcc_label(&mut self.enc, 0x5, bad);
    // jne
    pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC6);
    // inc rsi
    pe_emit3(&mut self.enc, 0xC1, 0xE0, 0x06);
    // shl eax, 6
    pe_emit3(&mut self.enc, 0x83, 0xE2, 0x3F);
    // and edx, 0x3F
    pe_emit2(&mut self.enc, 0x09, 0xD0);
    // or eax, edx
}

/// Vectors for which the CPU pushes an error code (pe_ir.fd's list)
fn pe_bare_vec_has_err(v: i64) -> bool {
    return v == 0x08 || v == 0x0A || v == 0x0B || v == 0x0C || v == 0x0D || v == 0x0E || v == 0x11 || v == 0x1E;
}

fn pe_b32(e: &mut PeirEnc, v: i64) -> void {
    PeirEnc_emit_u32(e, v);
}

/// mov dword [abs32], imm32 (32-bit code: C7 05 disp32 imm32)
fn pe_b_store32(e: &mut PeirEnc, addr: i64, v: i64) -> void {
    pe_emit2(e, 0xC7, 0x05);
    pe_b32(e, addr);
    pe_b32(e, v);
}

fn pe_b_pad(e: &mut PeirEnc, off: i64) -> void {
    if e.code.len() > off {
        p_eprint_str("internal error: bare boot prefix: a part does not fit before its offset\n");
    }
    while e.code.len() < off {
        e.code.push(0);
    }
}

/// The PEIR_BOOT_PREFIX bytes in front of the flat binary (see above).
/// `boot64` is the absolute address of boot_entry64 in the flat code.
pub fn pe_bare_boot_prefix(load: i64, boot64: i64) -> Vec {
    var e: PeirEnc = PeirEnc_new();
    var entry32: i64 = load + 0x80;
    var entry64: i64 = load + 0x300;
    var gdt: i64 = load + 0x400;
    var gdt_desc: i64 = load + 0x440;
    // 0x00: jmp rel32 to load+0x1000 (the same bytes in 32- and 64-bit mode)
    pe_emit1(&mut e, 0xE9);
    pe_b32(&mut e, PEIR_BOOT_PREFIX - 5);
    pe_b_pad(&mut e, 0x08);
    // 0x08: Multiboot 1 header, a.out kludge (flags: page-align, memory
    // info, the address fields below are valid)
    var mb1_flags: i64 = 0x00010003;
    pe_b32(&mut e, 0x1BADB002);
    pe_b32(&mut e, mb1_flags);
    pe_b32(&mut e, (0 - (0x1BADB002 + mb1_flags)) & 0xFFFFFFFF);
    pe_b32(&mut e, load + 0x08);
    // header_addr
    pe_b32(&mut e, load);
    // load_addr
    pe_b32(&mut e, 0);
    // load_end_addr: the whole file
    pe_b32(&mut e, 0);
    // bss_end_addr: none
    pe_b32(&mut e, entry32);
    // entry_addr
    pe_b_pad(&mut e, 0x28);
    // 0x28: Multiboot 2 header: address tag, entry address tag, end tag
    pe_b32(&mut e, 0xE85250D6);
    pe_b32(&mut e, 0);
    // architecture: i386 protected mode
    pe_b32(&mut e, 64);
    // header_length
    pe_b32(&mut e, (0 - (0xE85250D6 + 0 + 64)) & 0xFFFFFFFF);
    PeirEnc_emit_u16(&mut e, 2);
    PeirEnc_emit_u16(&mut e, 0);
    pe_b32(&mut e, 24);
    pe_b32(&mut e, load + 0x28);
    // header_addr
    pe_b32(&mut e, load);
    // load_addr
    pe_b32(&mut e, 0);
    // load_end_addr: the whole file
    pe_b32(&mut e, 0);
    // bss_end_addr: none
    PeirEnc_emit_u16(&mut e, 3);
    PeirEnc_emit_u16(&mut e, 0);
    pe_b32(&mut e, 12);
    pe_b32(&mut e, entry32);
    pe_b32(&mut e, 0);
    // tags are 8-byte aligned
    PeirEnc_emit_u16(&mut e, 0);
    PeirEnc_emit_u16(&mut e, 0);
    pe_b32(&mut e, 8);
    pe_b_pad(&mut e, 0x80);

    // 0x80: 32-bit protected mode, paging off (eax = magic, ebx = info)
    pe_emit1(&mut e, 0xFA);
    // cli
    pe_emit1(&mut e, 0xFC);
    // cld
    pe_emit1(&mut e, 0xA3);
    pe_b32(&mut e, 0x520);
    // mov [0x520], eax
    pe_emit2(&mut e, 0x89, 0x1D);
    pe_b32(&mut e, 0x528);
    // mov [0x528], ebx
    pe_b_store32(&mut e, 0x524, 0);
    pe_b_store32(&mut e, 0x52C, 0);
    pe_emit1(&mut e, 0xBC);
    pe_b32(&mut e, 0x90000);
    // mov esp, 0x90000
    // zero 0x70000-0x79FFF (the page tables)
    pe_emit1(&mut e, 0xBF);
    pe_b32(&mut e, 0x70000);
    // mov edi, 0x70000
    pe_emit1(&mut e, 0xB9);
    pe_b32(&mut e, 0x2800);
    // mov ecx, 0x2800
    pe_emit2(&mut e, 0x31, 0xC0);
    // xor eax, eax
    pe_emit2(&mut e, 0xF3, 0xAB);
    // rep stosd
    // PML4[0] -> PDPT, PDPT[0..3] -> the four PDs
    pe_b_store32(&mut e, 0x70000, 0x71003);
    pe_b_store32(&mut e, 0x71000, 0x76003);
    pe_b_store32(&mut e, 0x71008, 0x77003);
    pe_b_store32(&mut e, 0x71010, 0x78003);
    pe_b_store32(&mut e, 0x71018, 0x79003);
    // 2048 PD entries: 2 MB pages, present | writable | PS
    pe_emit1(&mut e, 0xBF);
    pe_b32(&mut e, 0x76000);
    // mov edi, 0x76000
    pe_emit1(&mut e, 0xB8);
    pe_b32(&mut e, 0x83);
    // mov eax, 0x83
    pe_emit1(&mut e, 0xB9);
    pe_b32(&mut e, 2048);
    // mov ecx, 2048
    pe_emit2(&mut e, 0x89, 0x07);
    // .l: mov [edi], eax
    pe_emit1(&mut e, 0x05);
    pe_b32(&mut e, 0x200000);
    // add eax, 0x200000
    pe_emit3(&mut e, 0x83, 0xC7, 0x08);
    // add edi, 8
    pe_emit2(&mut e, 0xE2, 0xF4);
    // loop .l
    // user tables: PML4 0x72000 -> PDPT 0x73000 -> PD 0x74000 -> PT 0x75000
    // (user | writable | present): 0x10000 and the VGA text page
    pe_b_store32(&mut e, 0x72000, 0x73007);
    pe_b_store32(&mut e, 0x73000, 0x74007);
    pe_b_store32(&mut e, 0x74000, 0x75007);
    pe_b_store32(&mut e, 0x75080, 0x10007);
    pe_b_store32(&mut e, 0x755C0, 0xB8007);
    // TSS at 0x4000: zero 104 bytes, rsp0 = 0x90000, no I/O bitmap
    pe_emit1(&mut e, 0xBF);
    pe_b32(&mut e, 0x4000);
    // mov edi, 0x4000
    pe_emit1(&mut e, 0xB9);
    pe_b32(&mut e, 26);
    // mov ecx, 26
    pe_emit2(&mut e, 0xF3, 0xAB);
    // rep stosd (eax = 0)
    pe_b_store32(&mut e, 0x4004, 0x90000);
    pe_emit3(&mut e, 0x66, 0xC7, 0x05);
    pe_b32(&mut e, 0x4066);
    PeirEnc_emit_u16(&mut e, 0x68);
    // CR4: PAE | OSFXSR | OSXMMEXCPT
    pe_emit3(&mut e, 0x0F, 0x20, 0xE0);
    // mov eax, cr4
    pe_emit1(&mut e, 0x0D);
    pe_b32(&mut e, 0x620);
    // or eax, 0x620
    pe_emit3(&mut e, 0x0F, 0x22, 0xE0);
    // mov cr4, eax
    pe_emit1(&mut e, 0xB8);
    pe_b32(&mut e, 0x70000);
    // mov eax, 0x70000
    pe_emit3(&mut e, 0x0F, 0x22, 0xD8);
    // mov cr3, eax
    // EFER.LME
    pe_emit1(&mut e, 0xB9);
    pe_b32(&mut e, 0xC0000080);
    // mov ecx, IA32_EFER
    pe_emit2(&mut e, 0x0F, 0x32);
    // rdmsr
    pe_emit1(&mut e, 0x0D);
    pe_b32(&mut e, 0x100);
    // or eax, LME
    pe_emit2(&mut e, 0x0F, 0x30);
    // wrmsr
    // CR0: paging, protection, MP; EM off (SSE)
    pe_emit3(&mut e, 0x0F, 0x20, 0xC0);
    // mov eax, cr0
    pe_emit1(&mut e, 0x25);
    pe_b32(&mut e, 0xFFFFFFFB);
    // and eax, ~EM
    pe_emit1(&mut e, 0x0D);
    pe_b32(&mut e, 0x80000003);
    // or eax, PG|MP|PE
    pe_emit3(&mut e, 0x0F, 0x22, 0xC0);
    // mov cr0, eax
    pe_emit3(&mut e, 0x0F, 0x01, 0x15);
    pe_b32(&mut e, gdt_desc);
    // lgdt [gdt_desc]
    pe_emit1(&mut e, 0xEA);
    pe_b32(&mut e, entry64);
    PeirEnc_emit_u16(&mut e, 0x08);
    // jmp 0x08:entry64
    pe_b_pad(&mut e, 0x300);

    // 0x300: 64-bit mode
    pe_emit4(&mut e, 0x66, 0xB8, 0x10, 0x00);
    // mov ax, 0x10
    pe_emit2(&mut e, 0x8E, 0xD8);
    // mov ds, ax
    pe_emit2(&mut e, 0x8E, 0xC0);
    // mov es, ax
    pe_emit2(&mut e, 0x8E, 0xD0);
    // mov ss, ax
    pe_emit2(&mut e, 0x31, 0xC0);
    // xor eax, eax
    pe_emit2(&mut e, 0x8E, 0xE0);
    // mov fs, ax
    pe_emit2(&mut e, 0x8E, 0xE8);
    // mov gs, ax
    pe_emit4(&mut e, 0x66, 0xB8, 0x28, 0x00);
    // mov ax, 0x28
    pe_emit3(&mut e, 0x0F, 0x00, 0xD8);
    // ltr ax
    pe_emit3(&mut e, 0x48, 0xC7, 0xC4);
    pe_b32(&mut e, 0x90000);
    // mov rsp, 0x90000
    pe_emit2(&mut e, 0xDB, 0xE3);
    // fninit
    pe_emit2(&mut e, 0x48, 0xB8);
    PeirEnc_emit_u64(&mut e, boot64);
    // mov rax, boot64
    pe_emit2(&mut e, 0xFF, 0xE0);
    // jmp rax
    pe_b_pad(&mut e, 0x400);

    // 0x400: GDT
    PeirEnc_emit_u64(&mut e, 0);
    PeirEnc_emit_u64(&mut e, 0x00AF9A000000FFFF);
    // 0x08 kernel code, 64-bit
    PeirEnc_emit_u64(&mut e, 0x00CF92000000FFFF);
    // 0x10 kernel data
    PeirEnc_emit_u64(&mut e, 0x00AFFA000000FFFF);
    // 0x18 user code, 64-bit
    PeirEnc_emit_u64(&mut e, 0x00CFF2000000FFFF);
    // 0x20 user data
    // 0x28: TSS (available 64-bit TSS, base 0x4000, limit 0x67)
    PeirEnc_emit_u16(&mut e, 0x67);
    PeirEnc_emit_u16(&mut e, 0x4000);
    pe_emit4(&mut e, 0x00, 0x89, 0x00, 0x00);
    PeirEnc_emit_u64(&mut e, 0);
    pe_b_pad(&mut e, 0x440);
    PeirEnc_emit_u16(&mut e, 0x37);
    // limit: 7 entries
    PeirEnc_emit_u64(&mut e, gdt);
    pe_b_pad(&mut e, PEIR_BOOT_PREFIX);
    return e.code;
}

/// Write an interrupt gate at [rdi] for the handler address in rax
/// (selector 0x08, IST 0, present 64-bit interrupt gate). Uses rdx.
fn PeirGen_bare_gate(self: &mut PeirGen) -> void {
    pe_emit3(&mut self.enc, 0x48, 0x89, 0xC2);
    // mov rdx, rax
    pe_emit3(&mut self.enc, 0x66, 0x89, 0x17);
    // mov [rdi], dx
    pe_emit6(&mut self.enc, 0x66, 0xC7, 0x47, 0x02, 0x08, 0x00);
    // mov word [rdi+2], 0x08
    pe_emit6(&mut self.enc, 0x66, 0xC7, 0x47, 0x04, 0x00, 0x8E);
    // mov word [rdi+4], 0x8E00
    pe_emit4(&mut self.enc, 0x48, 0xC1, 0xEA, 0x10);
    // shr rdx, 16
    pe_emit4(&mut self.enc, 0x66, 0x89, 0x57, 0x06);
    // mov [rdi+6], dx
    pe_emit4(&mut self.enc, 0x48, 0xC1, 0xEA, 0x10);
    // shr rdx, 16
    pe_emit3(&mut self.enc, 0x89, 0x57, 0x08);
    // mov [rdi+8], edx
    pe_emit7(&mut self.enc, 0xC7, 0x47, 0x0C, 0x00, 0x00, 0x00, 0x00);
    // mov dword [rdi+12], 0
}

/// boot_entry64: where the prefix's trampoline lands. Fills the IDT with
/// the default stubs, wires the @interrupt(N) functions, loads it, remaps
/// the PIC, turns interrupts on, then runs the ordinary bare entry (`start`).
fn PeirGen_gen_bare_boot_entry(self: &mut PeirGen, start: i64) -> void {
    g_pe_bare_boot_label = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, g_pe_bare_boot_label);
    // the 256 default gates
    PeirEnc_lea_label(&mut self.enc, PEIR_RAX, g_pe_bare_vec_stubs);
    pe_emit5(&mut self.enc, 0xBF, 0x00, 0x10, 0x00, 0x00);
    // mov edi, 0x1000
    pe_emit5(&mut self.enc, 0xB9, 0x00, 0x01, 0x00, 0x00);
    // mov ecx, 256
    var fill: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, fill);
    PeirGen_bare_gate(self);
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xC0, 0x10);
    // add rax, 16
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xC7, 0x10);
    // add rdi, 16
    pe_emit2(&mut self.enc, 0xFF, 0xC9);
    // dec ecx
    PeirEnc_jcc_label(&mut self.enc, 0x5, fill);
    // jnz
    // @interrupt(N) functions
    var ii: i64 = 0;
    while ii + 1 < g_pe_bare_irqs.len() {
        var vnum: i64 = g_pe_bare_irqs.get(ii);
        PeirEnc_lea_label(&mut self.enc, PEIR_RAX, g_pe_bare_irqs.get(ii + 1));
        pe_emit1(&mut self.enc, 0xBF);
        PeirEnc_emit_u32(&mut self.enc, 0x1000 + vnum * 16);
        // mov edi, gate
        PeirGen_bare_gate(self);
        ii = ii + 2;
    }
    // IDT descriptor at 0x500, lidt
    pe_emit8(&mut self.enc, 0x66, 0xC7, 0x04, 0x25, 0x00, 0x05, 0x00, 0x00);
    PeirEnc_emit_u16(&mut self.enc, 0x0FFF);
    // mov word [0x500], 0xFFF
    pe_emit7(&mut self.enc, 0xC7, 0x04, 0x25, 0x02, 0x05, 0x00, 0x00);
    PeirEnc_emit_u32(&mut self.enc, 0x1000);
    // mov dword [0x502], 0x1000
    pe_emit7(&mut self.enc, 0xC7, 0x04, 0x25, 0x06, 0x05, 0x00, 0x00);
    PeirEnc_emit_u32(&mut self.enc, 0);
    // mov dword [0x506], 0
    pe_emit8(&mut self.enc, 0x0F, 0x01, 0x1C, 0x25, 0x00, 0x05, 0x00, 0x00);
    // lidt [0x500]
    // PIC: ICW1-ICW4, master at 0x20, slave at 0x28; unmask IRQ0, IRQ1
    var pic: Vec<i64> = Vec::new();
    pic.push(0x20);
    pic.push(0x11);
    pic.push(0xA0);
    pic.push(0x11);
    pic.push(0x21);
    pic.push(0x20);
    pic.push(0xA1);
    pic.push(0x28);
    pic.push(0x21);
    pic.push(0x04);
    pic.push(0xA1);
    pic.push(0x02);
    pic.push(0x21);
    pic.push(0x01);
    pic.push(0xA1);
    pic.push(0x01);
    pic.push(0x21);
    pic.push(0xFC);
    pic.push(0xA1);
    pic.push(0xFF);
    var pi: i64 = 0;
    while pi + 1 < pic.len() {
        pe_emit4(&mut self.enc, 0xB0, pic.get(pi + 1), 0xE6, pic.get(pi));
        // mov al, v; out port, al
        pi = pi + 2;
    }
    pe_emit1(&mut self.enc, 0xFB);
    // sti
    PeirEnc_jmp_label(&mut self.enc, start);
}

/// The boot image's runtime pieces: the debug exit, a hex printer, the 256
/// default vector stubs and the handler they share.
fn PeirGen_gen_bare_boot_runtime(self: &mut PeirGen, putc: i64, pstr: i64) -> void {
    // exit(al): QEMU's isa-debug-exit at 0xF4, else halt
    g_pe_bare_exit = PeirEnc_alloc_label(&mut self.enc);
    var ehalt: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, g_pe_bare_exit);
    pe_emit5(&mut self.enc, 0xBA, 0xF4, 0x00, 0x00, 0x00);
    // mov edx, 0xF4
    pe_emit1(&mut self.enc, 0xEE);
    // out dx, al
    PeirEnc_place_label(&mut self.enc, ehalt);
    pe_emit2(&mut self.enc, 0xFA, 0xF4);
    // cli; hlt
    PeirEnc_jmp_label(&mut self.enc, ehalt);

    // hex(rcx): "0x" and the digits, no leading zeros (uses rax, rdx, r9-r11)
    var hex: i64 = PeirEnc_alloc_label(&mut self.enc);
    var h_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    var h_emit: i64 = PeirEnc_alloc_label(&mut self.enc);
    var h_dec: i64 = PeirEnc_alloc_label(&mut self.enc);
    var h_next: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, hex);
    pe_emit3(&mut self.enc, 0x49, 0x89, 0xC9);
    // mov r9, rcx
    pe_emit5(&mut self.enc, 0xB9, 0x30, 0x00, 0x00, 0x00);
    // mov ecx, '0'
    PeirEnc_call_label(&mut self.enc, putc);
    pe_emit5(&mut self.enc, 0xB9, 0x78, 0x00, 0x00, 0x00);
    // mov ecx, 'x'
    PeirEnc_call_label(&mut self.enc, putc);
    pe_emit6(&mut self.enc, 0x41, 0xBB, 0x3C, 0x00, 0x00, 0x00);
    // mov r11d, 60
    pe_emit3(&mut self.enc, 0x45, 0x31, 0xD2);
    // xor r10d, r10d
    PeirEnc_place_label(&mut self.enc, h_loop);
    pe_emit3(&mut self.enc, 0x4C, 0x89, 0xC8);
    // mov rax, r9
    pe_emit3(&mut self.enc, 0x44, 0x89, 0xD9);
    // mov ecx, r11d
    pe_emit3(&mut self.enc, 0x48, 0xD3, 0xE8);
    // shr rax, cl
    pe_emit3(&mut self.enc, 0x83, 0xE0, 0x0F);
    // and eax, 15
    pe_emit2(&mut self.enc, 0x85, 0xC0);
    // test eax, eax
    PeirEnc_jcc_label(&mut self.enc, 0x5, h_emit);
    // jnz
    pe_emit3(&mut self.enc, 0x45, 0x85, 0xD2);
    // test r10d, r10d
    PeirEnc_jcc_label(&mut self.enc, 0x5, h_emit);
    // jnz
    pe_emit3(&mut self.enc, 0x45, 0x85, 0xDB);
    // test r11d, r11d
    PeirEnc_jcc_label(&mut self.enc, 0x4, h_emit);
    // jz: the last digit
    PeirEnc_jmp_label(&mut self.enc, h_next);
    PeirEnc_place_label(&mut self.enc, h_emit);
    pe_emit6(&mut self.enc, 0x41, 0xBA, 0x01, 0x00, 0x00, 0x00);
    // mov r10d, 1
    pe_emit3(&mut self.enc, 0x83, 0xF8, 0x0A);
    // cmp eax, 10
    PeirEnc_jcc_label(&mut self.enc, 0x2, h_dec);
    // jb
    pe_emit3(&mut self.enc, 0x83, 0xC0, 0x27);
    // add eax, 'a' - '0' - 10
    PeirEnc_place_label(&mut self.enc, h_dec);
    pe_emit3(&mut self.enc, 0x83, 0xC0, 0x30);
    // add eax, '0'
    pe_emit2(&mut self.enc, 0x89, 0xC1);
    // mov ecx, eax
    PeirEnc_call_label(&mut self.enc, putc);
    PeirEnc_place_label(&mut self.enc, h_next);
    pe_emit4(&mut self.enc, 0x41, 0x83, 0xEB, 0x04);
    // sub r11d, 4
    PeirEnc_jcc_label(&mut self.enc, 0x9, h_loop);
    // jns
    PeirEnc_ret(&mut self.enc);

    // 256 stubs of 16 bytes: [push 0 unless the CPU pushed an error code]
    // push vector; jmp common
    var common: i64 = PeirEnc_alloc_label(&mut self.enc);
    g_pe_bare_vec_stubs = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, g_pe_bare_vec_stubs);
    var v: i64 = 0;
    while v < 256 {
        var at: i64 = self.enc.code.len();
        if pe_bare_vec_has_err(v) {
            pe_emit2(&mut self.enc, 0x66, 0x90);
            // (the CPU's error code)
        } else {
            pe_emit2(&mut self.enc, 0x6A, 0x00);
            // push 0
        }
        pe_emit1(&mut self.enc, 0x68);
        PeirEnc_emit_u32(&mut self.enc, v);
        // push v
        PeirEnc_jmp_label(&mut self.enc, common);
        while self.enc.code.len() < at + 16 {
            pe_emit1(&mut self.enc, 0xCC);
        }
        v = v + 1;
    }

    // common: [rsp] vector, [rsp+8] error code, [rsp+16] rip
    var irq: i64 = PeirEnc_alloc_label(&mut self.enc);
    var irq_master: i64 = PeirEnc_alloc_label(&mut self.enc);
    var irq_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    var nl: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, common);
    pe_emit5(&mut self.enc, 0x48, 0x83, 0x3C, 0x24, 0x20);
    // cmp qword [rsp], 32
    PeirEnc_jcc_label(&mut self.enc, 0x3, irq);
    // jae
    // a CPU exception: a panic
    pe_emit4(&mut self.enc, 0x4C, 0x8B, 0x24, 0x24);
    // mov r12, [rsp]
    pe_emit5(&mut self.enc, 0x4C, 0x8B, 0x6C, 0x24, 0x08);
    // mov r13, [rsp+8]
    pe_emit5(&mut self.enc, 0x4C, 0x8B, 0x74, 0x24, 0x10);
    // mov r14, [rsp+16]
    pe_emit4(&mut self.enc, 0x41, 0x0F, 0x20, 0xD7);
    // mov r15, cr2
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xE4, 0xF0);
    // and rsp, -16
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    if g_pe_bare_panic_handler != "" && HashMap_contains(self.func_labels, g_pe_bare_panic_handler) {
        PeirEnc_lea_rip(&mut self.enc, PEIR_RDX, PeirGen_str_off(self, "CPU exception"));
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, g_pe_bare_panic_handler));
    } else {
        PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "panic: CPU exception "));
        PeirEnc_call_label(&mut self.enc, pstr);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
        PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_int"));
        PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, ", error "));
        PeirEnc_call_label(&mut self.enc, pstr);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
        PeirEnc_call_label(&mut self.enc, hex);
        PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, ", rip "));
        PeirEnc_call_label(&mut self.enc, pstr);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
        PeirEnc_call_label(&mut self.enc, hex);
        pe_emit4(&mut self.enc, 0x49, 0x83, 0xFC, 0x0E);
        // cmp r12, 14 (#PF)
        PeirEnc_jcc_label(&mut self.enc, 0x5, nl);
        // jne
        PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, ", address "));
        PeirEnc_call_label(&mut self.enc, pstr);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
        PeirEnc_call_label(&mut self.enc, hex);
        PeirEnc_place_label(&mut self.enc, nl);
        pe_emit5(&mut self.enc, 0xB9, 0x0A, 0x00, 0x00, 0x00);
        // mov ecx, 10
        PeirEnc_call_label(&mut self.enc, putc);
    }
    pe_emit5(&mut self.enc, 0xB8, 0x01, 0x00, 0x00, 0x00);
    // mov eax, 1
    PeirEnc_jmp_label(&mut self.enc, g_pe_bare_exit);
    // an interrupt nobody handles: acknowledge PIC IRQs, return
    PeirEnc_place_label(&mut self.enc, irq);
    pe_emit1(&mut self.enc, 0x50);
    // push rax
    pe_emit2(&mut self.enc, 0xB0, 0x20);
    // mov al, 0x20 (EOI)
    pe_emit5(&mut self.enc, 0x48, 0x83, 0x7C, 0x24, 0x08);
    pe_emit1(&mut self.enc, 0x30);
    // cmp qword [rsp+8], 0x30
    PeirEnc_jcc_label(&mut self.enc, 0x3, irq_done);
    // jae: not a PIC IRQ
    pe_emit5(&mut self.enc, 0x48, 0x83, 0x7C, 0x24, 0x08);
    pe_emit1(&mut self.enc, 0x28);
    // cmp qword [rsp+8], 0x28
    PeirEnc_jcc_label(&mut self.enc, 0x2, irq_master);
    // jb
    pe_emit2(&mut self.enc, 0xE6, 0xA0);
    // out 0xA0, al
    PeirEnc_place_label(&mut self.enc, irq_master);
    pe_emit2(&mut self.enc, 0xE6, 0x20);
    // out 0x20, al
    PeirEnc_place_label(&mut self.enc, irq_done);
    pe_emit1(&mut self.enc, 0x58);
    // pop rax
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xC4, 0x10);
    // add rsp, 16
    pe_emit2(&mut self.enc, 0x48, 0xCF);
    // iretq
}

pub fn PeirGen_gen_bare_runtime(self: &mut PeirGen) -> void {
    PeirGen_gen_interrupt_stubs(self);
    PeirGen_gen_mmu_stubs(self);
    PeirGen_gen_gdt_stubs(self);
    PeirGen_gen_enter_user_mode(self);
    PeirGen_gen_serial_stubs(self);
    PeirGen_gen_malloc(self);
    PeirGen_gen_malloc_uninit(self);
    PeirGen_gen_free(self);
    PeirGen_gen_memset(self);

    var putc: i64 = PeirEnc_alloc_label(&mut self.enc);
    var pstr: i64 = HashMap_get(self.func_labels, "p_print_str");
    var estr: i64 = HashMap_get(self.func_labels, "p_eprint_str");
    if g_pe_uefi {
        // UEFI: ConOut->OutputString, and the exit routine
        g_pe_uefi_exit = PeirEnc_alloc_label(&mut self.enc);
        PeirGen_gen_uefi_io(self, putc, pstr, estr);
    } else if g_pe_elf {
        // Linux (release F4): write(r9 = fd, ...). The syscall takes rdi
        // and rsi, which Fides code keeps across calls: saved here.
        // putc(cl)
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, putc);
        pe_emit3(&mut self.enc, 0x57, 0x56, 0x51);
        // push rdi; push rsi; push rcx
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
        // SYS_write
        pe_emit3(&mut self.enc, 0x4C, 0x89, 0xCF);
        // mov rdi, r9
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xE6);
        // mov rsi, rsp
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 1);
        pe_emit2(&mut self.enc, 0x0F, 0x05);
        // syscall
        pe_emit3(&mut self.enc, 0x59, 0x5E, 0x5F);
        // pop rcx; pop rsi; pop rdi
        PeirEnc_ret(&mut self.enc);
        // write the C string rcx to fd r9, in one call
        var wstr: i64 = PeirEnc_alloc_label(&mut self.enc);
        var ws_len: i64 = PeirEnc_alloc_label(&mut self.enc);
        var ws_go: i64 = PeirEnc_alloc_label(&mut self.enc);
        var ws_done: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, wstr);
        pe_emit2(&mut self.enc, 0x57, 0x56);
        // push rdi; push rsi
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xCE);
        // mov rsi, rcx
        pe_emit3(&mut self.enc, 0x48, 0x85, 0xF6);
        // test rsi, rsi
        PeirEnc_jcc_label(&mut self.enc, 0x4, ws_done);
        // jz
        pe_emit2(&mut self.enc, 0x31, 0xD2);
        // xor edx, edx
        PeirEnc_place_label(&mut self.enc, ws_len);
        pe_emit4(&mut self.enc, 0x80, 0x3C, 0x16, 0x00);
        // cmp byte [rsi+rdx], 0
        PeirEnc_jcc_label(&mut self.enc, 0x4, ws_go);
        // je
        pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC2);
        // inc rdx
        PeirEnc_jmp_label(&mut self.enc, ws_len);
        PeirEnc_place_label(&mut self.enc, ws_go);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
        // SYS_write
        pe_emit3(&mut self.enc, 0x4C, 0x89, 0xCF);
        // mov rdi, r9
        pe_emit2(&mut self.enc, 0x0F, 0x05);
        // syscall
        PeirEnc_place_label(&mut self.enc, ws_done);
        pe_emit2(&mut self.enc, 0x5E, 0x5F);
        // pop rsi; pop rdi
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_ret(&mut self.enc);
        // p_print_str(rcx): stdout; p_eprint_str(rcx): stderr
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, pstr);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 1);
        PeirEnc_jmp_label(&mut self.enc, wstr);
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, estr);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 2);
        PeirEnc_jmp_label(&mut self.enc, wstr);
    } else {
        // putc(cl): wait until COM1 can take a byte, send it (uses rax, rdx)
        var wait: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, putc);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FD);
        // COM1 + 5 (LSR)
        PeirEnc_place_label(&mut self.enc, wait);
        pe_emit1(&mut self.enc, 0xEC);
        // in al, dx
        pe_emit2(&mut self.enc, 0xA8, 0x20);
        // test al, 0x20 (THR empty)
        PeirEnc_jcc_label(&mut self.enc, 0x4, wait);
        // jz
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3F8);
        // COM1 (THR)
        pe_emit2(&mut self.enc, 0x89, 0xC8);
        // mov eax, ecx
        pe_emit1(&mut self.enc, 0xEE);
        // out dx, al
        PeirEnc_ret(&mut self.enc);

        // p_print_str / p_eprint_str(rcx = C string)
        var ps_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
        var ps_done: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, pstr);
        PeirEnc_place_label(&mut self.enc, estr);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RCX);
        PeirEnc_test_rr(&mut self.enc, PEIR_R8, PEIR_R8);
        PeirEnc_jcc_label(&mut self.enc, 0x4, ps_done);
        // jz
        PeirEnc_place_label(&mut self.enc, ps_loop);
        pe_emit4(&mut self.enc, 0x41, 0x0F, 0xB6, 0x08);
        // movzx ecx, byte [r8]
        pe_emit2(&mut self.enc, 0x85, 0xC9);
        // test ecx, ecx
        PeirEnc_jcc_label(&mut self.enc, 0x4, ps_done);
        // jz
        PeirEnc_call_label(&mut self.enc, putc);
        pe_emit3(&mut self.enc, 0x49, 0xFF, 0xC0);
        // inc r8
        PeirEnc_jmp_label(&mut self.enc, ps_loop);
        PeirEnc_place_label(&mut self.enc, ps_done);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_ret(&mut self.enc);
    }

    // p_print_newline()
    PeirGen_place_fn(self, "p_print_newline");
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 1);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 10);
    PeirEnc_jmp_label(&mut self.enc, putc);

    // p_print_bool(rcx)
    var pb_true: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirGen_place_fn(self, "p_print_bool");
    PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pb_true);
    // jnz
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "false"));
    PeirEnc_jmp_label(&mut self.enc, pstr);
    PeirEnc_place_label(&mut self.enc, pb_true);
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "true"));
    PeirEnc_jmp_label(&mut self.enc, pstr);

    // p_print_int(rcx): decimal, built backwards in a buffer on the stack
    var pi_pos: i64 = PeirEnc_alloc_label(&mut self.enc);
    var pi_digit: i64 = PeirEnc_alloc_label(&mut self.enc);
    var pi_out: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirGen_place_fn(self, "p_print_int");
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RCX);
    // the sign
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R8, -1);
    pe_emit4(&mut self.enc, 0x41, 0xC6, 0x00, 0x00);
    // mov byte [r8], 0
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x9, pi_pos);
    // jns
    PeirEnc_neg_r(&mut self.enc, PEIR_RAX);
    // i64 min: 2^63, unsigned
    PeirEnc_place_label(&mut self.enc, pi_pos);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R10, 10);
    PeirEnc_place_label(&mut self.enc, pi_digit);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    pe_emit3(&mut self.enc, 0x49, 0xF7, 0xF2);
    // div r10
    pe_emit3(&mut self.enc, 0x80, 0xC2, 0x30);
    // add dl, 48
    pe_emit3(&mut self.enc, 0x49, 0xFF, 0xC8);
    // dec r8
    pe_emit3(&mut self.enc, 0x41, 0x88, 0x10);
    // mov [r8], dl
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pi_digit);
    // jnz
    PeirEnc_test_rr(&mut self.enc, PEIR_R9, PEIR_R9);
    PeirEnc_jcc_label(&mut self.enc, 0x9, pi_out);
    // jns
    pe_emit3(&mut self.enc, 0x49, 0xFF, 0xC8);
    // dec r8
    pe_emit4(&mut self.enc, 0x41, 0xC6, 0x00, 0x2D);
    // mov byte [r8], 45 (minus)
    PeirEnc_place_label(&mut self.enc, pi_out);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R8);
    PeirEnc_call_label(&mut self.enc, pstr);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);

    // p_panic(rcx = message): the program's handler, else COM1; then halt
    var halt: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirGen_place_fn(self, "p_panic");
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    if g_pe_bare_panic_handler != "" && HashMap_contains(self.func_labels, g_pe_bare_panic_handler) {
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, g_pe_bare_panic_handler));
    } else if g_pe_elf {
        // As a Windows program: "Panic: <message>" on stderr, exit code 1
        PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "Panic: "));
        PeirEnc_call_label(&mut self.enc, estr);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
        PeirEnc_call_label(&mut self.enc, estr);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 2);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 10);
        PeirEnc_call_label(&mut self.enc, putc);
    } else {
        PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "panic: "));
        PeirEnc_call_label(&mut self.enc, pstr);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
        PeirEnc_call_label(&mut self.enc, pstr);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 10);
        PeirEnc_call_label(&mut self.enc, putc);
    }
    if g_pe_uefi {
        // the image returns EFI_ABORTED to whoever started it
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, PE_EFI_ABORTED);
        PeirEnc_jmp_label(&mut self.enc, g_pe_uefi_exit);
    }
    if g_pe_elf {
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 231);
        // SYS_exit_group
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDI, 1);
        pe_emit2(&mut self.enc, 0x0F, 0x05);
        // syscall
    }
    if pe_bare_boot_on() {
        // exit code 1 to QEMU's isa-debug-exit (else the halt below)
        pe_emit5(&mut self.enc, 0xB8, 0x01, 0x00, 0x00, 0x00);
        // mov eax, 1
        pe_emit5(&mut self.enc, 0xBA, 0xF4, 0x00, 0x00, 0x00);
        // mov edx, 0xF4
        pe_emit1(&mut self.enc, 0xEE);
        // out dx, al
    }
    PeirEnc_place_label(&mut self.enc, halt);
    pe_emit2(&mut self.enc, 0xFA, 0xF4);
    // cli; hlt
    PeirEnc_jmp_label(&mut self.enc, halt);

    // p_argc: no command line
    PeirGen_place_fn(self, "p_argc");
    PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);

    if pe_bare_boot_on() {
        PeirGen_gen_bare_boot_runtime(self, putc, pstr);
    }
}

/// Place each of `names` not placed yet at a trap: the runtime functions a
/// bare build has no body for.
pub fn PeirGen_trap_unplaced(self: &mut PeirGen, names: Vec<str>) -> void {
    var ni: i64 = 0;
    while ni < names.len() {
        if HashMap_contains(self.func_labels, names.get(ni)) {
            var l: i64 = HashMap_get(self.func_labels, names.get(ni));
            if self.enc.labels.get(l) < 0 {
                PeirEnc_place_label(&mut self.enc, l);
                PeirEnc_ud2(&mut self.enc);
            }
        }
        ni = ni + 1;
    }
}

// ===========================================================================
// gen_runtime_stubs (src/pe.rs) — the non-bare sequence, verbatim
// ===========================================================================

pub fn PeirGen_gen_runtime_stubs(self: &mut PeirGen) -> void {
    if self.bare_mode {
        PeirGen_gen_bare_runtime(self);
        return;
    }
    // Runtime functions that only pretended to work (string search,
    // replace, case, trim, vec sort/insert, map keys...) are not
    // generated: a program calling one is refused (see generate_pe).
    PeirGen_gen_arena_stubs(self);
    PeirGen_gen_print_int(self);
    PeirGen_gen_print_str(self);
    PeirGen_gen_print_bool(self);
    PeirGen_gen_print_float(self);
    PeirGen_gen_panic(self);
    PeirGen_gen_malloc(self);
    PeirGen_gen_malloc_uninit(self);
    PeirGen_gen_free(self);
    PeirGen_gen_memset(self);
    PeirGen_gen_str_concat(self);
    PeirGen_gen_to_str(self);
    PeirGen_gen_to_str_vec(self);
    PeirGen_gen_to_str_float(self);
    PeirGen_gen_to_str_str(self);
    PeirGen_gen_to_str_bool(self);
    PeirGen_gen_float_to_str_alias(self);
    PeirGen_gen_bool_to_str_alias(self);
    PeirGen_gen_char_to_str(self);
    PeirGen_gen_eprint_str(self);
    PeirGen_gen_print_newline(self);
    PeirGen_gen_sb_new(self);
    PeirGen_gen_sb_append(self);
    PeirGen_gen_sb_to_str(self);
    PeirGen_gen_file_read(self);
    PeirGen_gen_file_write(self);
    PeirGen_gen_str_join_n(self);
    PeirGen_gen_vec_new(self);
    PeirGen_gen_vec_push(self);
    PeirGen_gen_vec_len(self);
    PeirGen_gen_vec_get(self);
    PeirGen_gen_vec_pop(self);
    PeirGen_gen_print_vec(self);
    PeirGen_gen_map_new(self);
    PeirGen_gen_map_insert(self);
    PeirGen_gen_map_get(self);
    PeirGen_gen_map_contains(self);
    PeirGen_gen_map_remove(self);
    PeirGen_gen_map_len(self);
    PeirGen_gen_map_is_empty(self);
    PeirGen_gen_print_map(self);
    // New Vec stubs
    PeirGen_gen_vec_set(self);
    PeirGen_gen_vec_is_empty(self);
    PeirGen_gen_vec_clear(self);
    PeirGen_gen_vec_capacity(self);
    PeirGen_gen_vec_first(self);
    PeirGen_gen_vec_last(self);
    PeirGen_gen_vec_contains(self);
    PeirGen_gen_vec_truncate(self);
    PeirGen_gen_vec_clone(self);
    // New HashMap stubs
    PeirGen_gen_map_clear(self);
    PeirGen_gen_map_get_or(self);
    // String stubs
    PeirGen_gen_string_len(self);
    PeirGen_gen_string_is_empty(self);
    PeirGen_gen_string_starts_with(self);
    PeirGen_gen_string_parse_int(self);
    PeirGen_gen_string_bytes(self);
    PeirGen_gen_string_clone(self);
    // Phase 5A.3: Interrupt handler stubs
    PeirGen_gen_interrupt_stubs(self);
    // Phase 5A.4: MMU/page table stubs
    PeirGen_gen_mmu_stubs(self);
    // Phase 5A.5: GDT stubs
    PeirGen_gen_gdt_stubs(self);
    // User-mode transition stub
    PeirGen_gen_enter_user_mode(self);
    // Serial port: no port I/O in a Windows process.  As in the C backend,
    // init and write do nothing, read and ready return 0.
    var serial_stubs: Vec<str> = Vec::new();
    serial_stubs.push("p_serial_init");
    serial_stubs.push("p_serial_write");
    serial_stubs.push("p_serial_read");
    serial_stubs.push("p_serial_ready");
    var si: i64 = 0;
    while si < serial_stubs.len() {
        PeirGen_place_fn(self, serial_stubs.get(si));
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_ret(&mut self.enc);
        si = si + 1;
    }
    // Native runtime stubs: argv, process exec
    PeirGen_gen_argc(self);
    PeirGen_gen_argv(self);
    PeirGen_gen_system(self);
}

// ===========================================================================
// Interrupt / MMU / GDT / user-mode stubs (Phase 5A.3-5A.6)
//
// In normal (Windows) mode each stub emits ud2 — these instructions are
// meaningless under an OS.  The Rust bare-metal bodies are not ported; the
// bare_mode guard panics (unreachable: gen_runtime_stubs panics on bare).
// ===========================================================================

/// Generate interrupt control stubs (Phase 5A.3)
pub fn PeirGen_gen_interrupt_stubs(self: &mut PeirGen) -> void {
    // p_cli() — clear interrupt flag
    var label: i64 = HashMap_get(self.func_labels, "p_cli");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        pe_emit1(&mut self.enc, 0xFA);
        // cli
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_sti() — set interrupt flag
    label = HashMap_get(self.func_labels, "p_sti");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        pe_emit1(&mut self.enc, 0xFB);
        // sti
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_hlt() — halt CPU (hlt only; interrupts must be enabled for wakeup)
    label = HashMap_get(self.func_labels, "p_hlt");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        pe_emit1(&mut self.enc, 0xF4);
        // hlt (no cli — interrupts wake the CPU)
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_lidt(rcx = ptr to IDT descriptor) — load IDT
    label = HashMap_get(self.func_labels, "p_lidt");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // lidt [rcx]
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x01, 0x19);
        // lidt [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_idt_set_entry(rcx = idt_ptr, rdx = vector, r8 = handler_addr, r9 = flags)
    // Writes a 16-byte IDT gate descriptor at idt_ptr + vector * 16 (bare only).
    label = HashMap_get(self.func_labels, "p_idt_set_entry");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // rcx = idt_ptr (base), rdx = vector, r8 = handler_addr, r9 = flags
        // Compute gate address: rdx * 16 + rcx -> r10
        // r10 = rdx << 4
        PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_RDX);
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_R10, 4);
        // r10 = r10 + rcx (idt_ptr + vector*16)
        PeirEnc_add_rr(&mut self.enc, PEIR_R10, PEIR_RCX);
        // offset_low = handler_addr & 0xFFFF -> [r10 + 0]
        // mov rax, r8 (handler_addr)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
        // mov [r10], ax
        pe_emit4(&mut self.enc, 0x66, 0x41, 0x89, 0x02);
        // mov [r10], ax
        // selector = 0x08 -> [r10 + 2]
        pe_emit7(&mut self.enc, 0x66, 0x41, 0xC7, 0x42, 0x02, 0x08, 0x00);
        // mov word [r10+2], 0x0008
        // ist = 0 -> [r10 + 4]
        pe_emit5(&mut self.enc, 0x41, 0xC6, 0x42, 0x04, 0x00);
        // mov byte [r10+4], 0
        // type_attr = flags | 0x8E -> [r10 + 5]
        // r9 = flags, or with 0x8E
        pe_emit4(&mut self.enc, 0x41, 0x80, 0xC9, 0x8E);
        // or r9b, 0x8E
        pe_emit4(&mut self.enc, 0x45, 0x88, 0x4A, 0x05);
        // mov [r10+5], r9b
        // offset_mid = (handler_addr >> 16) & 0xFFFF -> [r10 + 6]
        // shr rax, 16
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x10);
        // shr rax, 16
        // mov [r10 + 6], ax
        pe_emit5(&mut self.enc, 0x66, 0x41, 0x89, 0x42, 0x06);
        // mov [r10+6], ax
        // offset_high = (handler_addr >> 32) & 0xFFFFFFFF -> [r10 + 8]
        // shr rax, 16  (rax now = handler_addr >> 32)
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x10);
        // shr rax, 16
        // mov [r10 + 8], eax
        pe_emit4(&mut self.enc, 0x41, 0x89, 0x42, 0x08);
        // mov [r10+8], eax
        // reserved = 0 -> [r10 + 12]
        pe_emit8(&mut self.enc, 0x41, 0xC7, 0x42, 0x0C, 0x00, 0x00, 0x00, 0x00);
        // mov dword [r10+12], 0
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_inb(rcx = port) -> rax = byte — read from I/O port
    label = HashMap_get(self.func_labels, "p_inb");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Port is in rcx, move to dx for in al, dx
        // mov dx, cx (16-bit)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xCA);
        // mov dx, cx
        // xor rax, rax
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        // in al, dx
        pe_emit1(&mut self.enc, 0xEC);
        // in al, dx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_inw(rcx = port) -> rax = word — read 16-bit from I/O port
    label = HashMap_get(self.func_labels, "p_inw");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov dx, cx (16-bit)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xCA);
        // mov dx, cx
        // xor rax, rax
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        // in ax, dx
        pe_emit2(&mut self.enc, 0x66, 0xED);
        // in ax, dx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_outb(rcx = port, rdx = value) — write to I/O port
    label = HashMap_get(self.func_labels, "p_outb");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // rcx = port, rdx = value
        // mov al, dl (value to al — must do before overwriting dx)
        pe_emit2(&mut self.enc, 0x88, 0xD0);
        // mov al, dl (value to al)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xCA);
        // mov dx, cx (port to dx)
        // out dx, al
        pe_emit1(&mut self.enc, 0xEE);
        // out dx, al
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_outw(rcx = port, rdx = value) — write 16-bit word to I/O port
    label = HashMap_get(self.func_labels, "p_outw");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // rcx = port, rdx = value
        // mov ax, dx (value to ax — must do before overwriting dx)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xD0);
        // mov ax, dx (value to ax)
        // mov dx, cx (port to dx)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xCA);
        // mov dx, cx (port to dx)
        // out dx, ax
        pe_emit2(&mut self.enc, 0x66, 0xEF);
        // out dx, ax
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_outl(rcx = port, rdx = value) — write 32-bit dword to I/O port
    label = HashMap_get(self.func_labels, "p_outl");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // rcx = port, rdx = value
        // mov eax, edx (value to eax)
        pe_emit2(&mut self.enc, 0x89, 0xD0);
        // mov eax, edx
        // mov dx, cx (port to dx)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xCA);
        // mov dx, cx (port to dx)
        // out dx, eax
        pe_emit1(&mut self.enc, 0xEF);
        // out dx, eax
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_inl(rcx = port) -> rax — read 32-bit dword from I/O port
    label = HashMap_get(self.func_labels, "p_inl");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov dx, cx (port to dx)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xCA);
        // mov dx, cx
        // in eax, dx
        pe_emit1(&mut self.enc, 0xED);
        // in eax, dx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);
}

/// Generate MMU/page table management stubs (Phase 5A.4)
pub fn PeirGen_gen_mmu_stubs(self: &mut PeirGen) -> void {
    // p_cr3_read() -> rax — read CR3 (page table base)
    var label: i64 = HashMap_get(self.func_labels, "p_cr3_read");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, cr3
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x20, 0xD8);
        // mov rax, cr3
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_cr3_write(rcx = addr) — write CR3
    label = HashMap_get(self.func_labels, "p_cr3_write");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov cr3, rcx
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x22, 0xD9);
        // mov cr3, rcx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_cr0_read() -> rax — read CR0
    label = HashMap_get(self.func_labels, "p_cr0_read");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, cr0
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x20, 0xC0);
        // mov rax, cr0
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_cr0_write(rcx = val) — write CR0
    label = HashMap_get(self.func_labels, "p_cr0_write");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov cr0, rcx
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x22, 0xC1);
        // mov cr0, rcx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_cr2_read() -> rax — read CR2 (page fault address)
    label = HashMap_get(self.func_labels, "p_cr2_read");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, cr2
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x20, 0xD0);
        // mov rax, cr2
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_cr4_read() -> rax — read CR4
    label = HashMap_get(self.func_labels, "p_cr4_read");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, cr4
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x20, 0xE0);
        // mov rax, cr4
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_cr4_write(rcx = val) — write CR4
    label = HashMap_get(self.func_labels, "p_cr4_write");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov cr4, rcx
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x22, 0xE1);
        // mov cr4, rcx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_invlpg(rcx = addr) — invalidate TLB entry
    label = HashMap_get(self.func_labels, "p_invlpg");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // invlpg [rcx]
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x01, 0x39);
        // invlpg [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // T10: p_wrmsr_gs_base(rcx = value) — write GS base (MSR 0xC0000101)
    label = HashMap_get(self.func_labels, "p_wrmsr_gs_base");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Save rcx (value) before clobbering ecx with the MSR address.
        // mov rax, rcx            ; rax = value (low 32 will be used)
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xC8);
        // mov rax, rcx
        // mov rdx, rax            ; rdx = value (high 32 in edx after shift)
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xC2);
        // mov rdx, rax
        // shr rdx, 32             ; edx = high 32 bits
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xEA, 0x20);
        // shr rdx, 32
        // mov ecx, 0xC0000101     ; MSR_GS_BASE
        pe_emit5(&mut self.enc, 0xB9, 0x01, 0x01, 0x00, 0xC0);
        // mov ecx, 0xC0000101
        // wrmsr
        pe_emit2(&mut self.enc, 0x0F, 0x30);
        // wrmsr
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // T10: p_rdmsr_gs_base() -> rax — read GS base (MSR 0xC0000101)
    label = HashMap_get(self.func_labels, "p_rdmsr_gs_base");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov ecx, 0xC0000101     ; MSR_GS_BASE
        pe_emit5(&mut self.enc, 0xB9, 0x01, 0x01, 0x00, 0xC0);
        // mov ecx, 0xC0000101
        // rdmsr                   ; edx:eax = MSR value
        pe_emit2(&mut self.enc, 0x0F, 0x32);
        // rdmsr
        // shl rdx, 32             ; shift high 32 bits into position
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE2, 0x20);
        // shl rdx, 32
        // or rax, rdx             ; combine low and high
        pe_emit3(&mut self.enc, 0x48, 0x09, 0xD0);
        // or rax, rdx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // T10: p_wrmsr_kernel_gs_base(rcx = value) — write KernelGSBase (0xC0000102)
    label = HashMap_get(self.func_labels, "p_wrmsr_kernel_gs_base");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xC8);
        // mov rax, rcx
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xC2);
        // mov rdx, rax
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xEA, 0x20);
        // shr rdx, 32
        // mov ecx, 0xC0000102     ; MSR_KERNEL_GS_BASE
        pe_emit5(&mut self.enc, 0xB9, 0x02, 0x01, 0x00, 0xC0);
        // mov ecx, 0xC0000102
        pe_emit2(&mut self.enc, 0x0F, 0x30);
        // wrmsr
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // T10: p_swapgs() — swap GS base and KernelGSBase
    label = HashMap_get(self.func_labels, "p_swapgs");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // swapgs
        pe_emit3(&mut self.enc, 0x0F, 0x01, 0xF8);
        // swapgs
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_page_map(rcx=PML4 base, rdx=virt_addr, r8=phys_addr, r9=flags)
    // Bare-metal 4-level page walk; under an OS, a trap.
    label = HashMap_get(self.func_labels, "p_page_map");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Save callee-saved registers
        PeirEnc_push(&mut self.enc, PEIR_RBP);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
        PeirEnc_push(&mut self.enc, PEIR_R12);
        // PML4 base
        PeirEnc_push(&mut self.enc, PEIR_R13);
        // virt_addr
        PeirEnc_push(&mut self.enc, PEIR_R14);
        // phys_addr
        PeirEnc_push(&mut self.enc, PEIR_R15);
        // flags
        PeirEnc_sub_rsp_i32(&mut self.enc, 16);
        // alignment + temp
        // r12 = PML4 base (rcx)
        PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
        // r13 = virt_addr (rdx)
        PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);
        // r14 = phys_addr (r8)
        PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_R8);
        // r15 = flags (r9)
        PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_R9);
        // === Level 1: PML4 (bits 39-47) ===
        // rax = (r13 >> 39) & 0x1FF
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x27);
        // shr rax, 39
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00);
        // and rax, 0x1FF
        // rax = rax * 8 (entry offset)
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        // rax = r12 + rax (PML4 entry address)
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
        // Read PML4 entry: rcx = [rax]
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // Test present bit (bit 0): if 0, allocate new PDPT
        PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        var pm_have_pdpt: i64 = PeirEnc_alloc_label(&mut self.enc);
        // test rcx, 1 -> jnz pm_have_pdpt
        pe_emit7(&mut self.enc, 0x48, 0xF7, 0xC1, 0x01, 0x00, 0x00, 0x00);
        // test rcx, 1
        PeirEnc_jcc_label(&mut self.enc, 0x5, pm_have_pdpt);
        // jnz
        // Allocate new PDPT at bump allocator (0x200000)
        // Load current bump ptr: rax = [0x200000]
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x200000);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // rcx = bump ptr
        // Advance bump ptr by 4096 (one page table)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        // rdx = rcx + 4096 (the Rust version also emitted `add rdx, 0` and a
        // stray 0x10 byte here, which swallowed the next instruction)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 4096);
        PeirEnc_add_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        // Store new bump ptr: [0x200000] = rdx
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x200000);
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RDX);
        // Zero the new page table (4096 bytes = 512 qwords)
        // rdi = rcx (new table), xor rax,rax, mov rcx_loop=512, rep stosq
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDI, PEIR_RCX);
        // rdi = table addr
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        // rax = 0
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 512);
        // rcx = 512
        pe_emit3(&mut self.enc, 0xF3, 0x48, 0xAB);
        // rep stosq
        // Set PML4 entry = new_table_addr | present | writable
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RDI);
        // rcx = new table addr (rdi was modified, use saved)
        // Actually rdi was modified by rep stosq. Reload from bump ptr - 0x1000
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x200000);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        // rdx = current bump
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xEA, 0x10);
        // sub rdx, 16 — wrong, need sub 0x1000
        // Fix: use mov_imm32 + sub
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 4096);
        pe_emit3(&mut self.enc, 0x48, 0x29, 0xC2);
        // sub rdx, rax
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RDX);
        // rcx = new table addr
        // or rcx, 3 (present | writable)
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xC9, 0x03);
        // or rcx, 3
        // Re-read PML4 entry address and store
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        // rax = virt
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x27);
        // shr rax, 39
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00);
        // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
        // rax = PML4 entry addr
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
        // store entry
        // rcx = table base (strip flags)
        pe_emit6(&mut self.enc, 0x48, 0x25, 0x00, 0xF0, 0xFF, 0xFF);
        // and rax, 0xFFFFF000 — wrong reg
        // Use: and rcx, ~0xFFF
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_place_label(&mut self.enc, pm_have_pdpt);
        // rcx = PDPT base (strip flags from PML4 entry)
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // For now, just map at PT level directly (simplified 4KB page mapping).
        // Full 4-level walk is complex in raw asm; this handles the common case
        // where intermediate tables already exist (pre-allocated by bootloader).
        // Walk PDPT (bits 30-38), PD (bits 21-29), PT (bits 12-20).
        // Each level: index = (virt >> shift) & 0x1FF; entry = table[index]; if not present, alloc; table = entry & ~0xFFF
        // === Level 2: PDPT (bits 30-38) ===
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x1E);
        // shr rax, 30
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00);
        // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // rcx = PDPT entry
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // strip flags
        // === Level 3: PD (bits 21-29) ===
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x15);
        // shr rax, 21
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00);
        // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // rcx = PD entry
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // strip flags
        // === Level 4: PT (bits 12-20) ===
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x0C);
        // shr rax, 12
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00);
        // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        // rax = PT entry address
        // Set PT entry = phys_addr | flags
        // r14 = phys_addr, r15 = flags
        // entry = (r14 & ~0xFFF) | (r15 & 0xFFF)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RDX);
        // phys & ~0xFFF
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, 0x0000000000000FFF);
        PeirEnc_and_rr(&mut self.enc, PEIR_R15, PEIR_RDX);
        // flags & 0xFFF
        PeirEnc_or_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
        // phys | flags
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
        // store PTE
        // Restore and return
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xC4, 0x10);
        // add rsp, 16
        PeirEnc_pop(&mut self.enc, PEIR_R15);
        PeirEnc_pop(&mut self.enc, PEIR_R14);
        PeirEnc_pop(&mut self.enc, PEIR_R13);
        PeirEnc_pop(&mut self.enc, PEIR_R12);
        PeirEnc_pop(&mut self.enc, PEIR_RBP);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_page_unmap(rcx=PML4 base, rdx=virt_addr)
    label = HashMap_get(self.func_labels, "p_page_unmap");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        PeirEnc_push(&mut self.enc, PEIR_RBP);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
        PeirEnc_push(&mut self.enc, PEIR_R12);
        // PML4 base
        PeirEnc_push(&mut self.enc, PEIR_R13);
        // virt_addr
        PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);
        // Walk PML4 -> PDPT -> PD -> PT (same as p_page_map but read-only)
        // PML4 (bits 39-47)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x27);
        // shr rax, 39
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00);
        // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // PDPT (bits 30-38)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x1E);
        // shr rax, 30
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00);
        // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // PD (bits 21-29)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x15);
        // shr rax, 21
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00);
        // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // PT (bits 12-20)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x0C);
        // shr rax, 12
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00);
        // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        // rax = PT entry address
        // Clear the PTE: mov qword [rax], 0
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
        // invlpg [r13]
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x01, 0xBD);
        // invlpg [r13] — using rbp? no
        // invlpg [rcx] where rcx = virt_addr
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x01, 0x39);
        // invlpg [rcx]
        PeirEnc_pop(&mut self.enc, PEIR_R13);
        PeirEnc_pop(&mut self.enc, PEIR_R12);
        PeirEnc_pop(&mut self.enc, PEIR_RBP);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_phys_read64(rcx=addr) -> rax — read 8 bytes from physical address
    label = HashMap_get(self.func_labels, "p_phys_read64");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, [rcx]
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_phys_write64(rcx=addr, rdx=val) — write 8 bytes to physical address
    label = HashMap_get(self.func_labels, "p_phys_write64");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov [rcx], rdx
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RCX, PEIR_RDX);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_read8(rcx=addr) -> rax — read 1 byte from memory
    label = HashMap_get(self.func_labels, "p_mem_read8");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // movzx eax, byte [rcx]
        pe_emit3(&mut self.enc, 0x0F, 0xB6, 0x01);
        // movzx eax, byte [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_write8(rcx=addr, rdx=val) — write 1 byte to memory
    label = HashMap_get(self.func_labels, "p_mem_write8");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov [rcx], dl
        pe_emit2(&mut self.enc, 0x88, 0x11);
        // mov [rcx], dl
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_read16(rcx=addr) -> rax — read 2 bytes from memory
    label = HashMap_get(self.func_labels, "p_mem_read16");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // movzx eax, word [rcx]
        pe_emit3(&mut self.enc, 0x0F, 0xB7, 0x01);
        // movzx eax, word [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_write16(rcx=addr, rdx=val) — write 2 bytes to memory
    label = HashMap_get(self.func_labels, "p_mem_write16");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov [rcx], dx
        pe_emit3(&mut self.enc, 0x66, 0x89, 0x11);
        // mov [rcx], dx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_read32(rcx=addr) -> rax — read 4 bytes from memory
    label = HashMap_get(self.func_labels, "p_mem_read32");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov eax, [rcx]
        pe_emit2(&mut self.enc, 0x8B, 0x01);
        // mov eax, [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_write32(rcx=addr, rdx=val) — write 4 bytes to memory
    label = HashMap_get(self.func_labels, "p_mem_write32");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov [rcx], edx
        pe_emit2(&mut self.enc, 0x89, 0x11);
        // mov [rcx], edx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_read64(rcx=addr) -> rax — read 8 bytes from memory
    label = HashMap_get(self.func_labels, "p_mem_read64");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, [rcx]
        pe_emit3(&mut self.enc, 0x48, 0x8B, 0x01);
        // mov rax, [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_write64(rcx=addr, rdx=val) — write 8 bytes to memory
    label = HashMap_get(self.func_labels, "p_mem_write64");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov [rcx], rdx
        pe_emit3(&mut self.enc, 0x48, 0x89, 0x11);
        // mov [rcx], rdx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_get_rbp() -> rax = RBP
    label = HashMap_get(self.func_labels, "p_get_rbp");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, rbp
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RBP);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_get_rsp() -> rax = RSP
    label = HashMap_get(self.func_labels, "p_get_rsp");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, rsp
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RSP);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_atomic_xchg32(rcx=addr, rdx=value) -> rax = old value
    label = HashMap_get(self.func_labels, "p_atomic_xchg32");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // lock xchg [rcx], edx
        pe_emit1(&mut self.enc, 0xF0);
        // lock prefix
        pe_emit2(&mut self.enc, 0x87, 0x11);
        // xchg [rcx], edx
        // Old value is now in edx, move to rax
        // xchg puts old [rcx] in edx and new value in [rcx]
        // Actually xchg [rcx], edx: edx gets old [rcx], [rcx] gets old edx
        // So rax needs to be set to edx (the old value)
        // But xchg already set edx to the old value, and edx was the input
        // Wait: xchg [rcx], edx exchanges edx and [rcx]
        // Before: [rcx] = old_val, edx = new_val
        // After:  [rcx] = new_val, edx = old_val
        // So mov eax, edx to return old_val
        pe_emit2(&mut self.enc, 0x89, 0xD0);
        // mov eax, edx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);
}

/// Generate GDT stubs (Phase 5A.5)
pub fn PeirGen_gen_gdt_stubs(self: &mut PeirGen) -> void {
    // p_lgdt(rcx = pointer to GDT descriptor)
    var label: i64 = HashMap_get(self.func_labels, "p_lgdt");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // lgdt [rcx] — 0x0F 0x01 0x19
        pe_emit3(&mut self.enc, 0x0F, 0x01, 0x19);
        // lgdt [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_gdt_set_entry(rcx = gdt_ptr, rdx = index, r8 = base, r9 = limit,
    // stack[16] = flags) — writes an 8-byte GDT entry (bare only).
    label = HashMap_get(self.func_labels, "p_gdt_set_entry");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // rcx = gdt_ptr, rdx = index, r8 = base, r9 = limit
        // flags is on stack at [rbp + 16] (after return address + rbp)
        PeirEnc_push(&mut self.enc, PEIR_RBP);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
        // r10 = rdx * 8 + rcx (entry address)
        PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_RDX);
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_R10, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_R10, PEIR_RCX);
        // limit_low = r9 & 0xFFFF -> [r10 + 0]
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R9);
        pe_emit4(&mut self.enc, 0x66, 0x41, 0x89, 0x02);
        // mov [r10], ax
        // base_low = r8 & 0xFFFF -> [r10 + 2]
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
        pe_emit5(&mut self.enc, 0x66, 0x41, 0x89, 0x42, 0x02);
        // mov [r10+2], ax
        // base_mid = (r8 >> 16) & 0xFF -> [r10 + 4]
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x10);
        // shr rax, 16
        pe_emit4(&mut self.enc, 0x41, 0x88, 0x42, 0x04);
        // mov [r10+4], al
        // type_attr = flags (from stack) -> [r10 + 5]
        // flags at [rbp + 16] (first stack arg on x64 Windows: shadow space + return addr)
        // On Windows x64, 5th arg is at [rbp + 8 + 32] = [rbp + 40]
        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        // clear upper bits (al = base_mid, reuse)
        // Load flags from stack: [rbp + 40]
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, 48);
        pe_emit4(&mut self.enc, 0x41, 0x88, 0x42, 0x05);
        // mov [r10+5], al
        // limit_high + flags_high = ((r9 >> 16) & 0x0F) | ((flags >> 8) & 0xF0) -> [r10 + 6]
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R9);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x10);
        // shr rax, 16
        pe_emit6(&mut self.enc, 0x48, 0x25, 0x0F, 0x00, 0x00, 0x00);
        // and rax, 0x0F
        // Load flags again, shift right 8, mask 0xF0
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, 48);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE9, 0x08);
        // shr rcx, 8
        pe_emit7(&mut self.enc, 0x48, 0x81, 0xE1, 0xF0, 0x00, 0x00, 0x00);
        // and rcx, 0xF0
        PeirEnc_or_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        pe_emit4(&mut self.enc, 0x41, 0x88, 0x42, 0x06);
        // mov [r10+6], al
        // base_high = (r8 >> 24) & 0xFF -> [r10 + 7]
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x18);
        // shr rax, 24
        pe_emit4(&mut self.enc, 0x41, 0x88, 0x42, 0x07);
        // mov [r10+7], al
        PeirEnc_pop(&mut self.enc, PEIR_RBP);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);
}

/// p_enter_user_mode(rcx = entry_addr, rdx = stack_addr) -> void
/// Transitions from ring 0 (kernel) to ring 3 (user) via iretq.
pub fn PeirGen_gen_enter_user_mode(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_enter_user_mode");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // rcx = entry_addr (RIP), rdx = stack_addr (RSP)
        // Save entry/stack in callee-saved regs (r11, r12) before CR3 switch
        // mov r11, rcx (entry addr)
        pe_emit3(&mut self.enc, 0x49, 0x89, 0xCB);
        // mov r11, rcx
        // mov r12, rdx (stack addr)
        pe_emit3(&mut self.enc, 0x49, 0x89, 0xD4);
        // mov r12, rdx
        // Switch CR3 to user page tables (0x72000)
        // mov eax, 0x72000
        pe_emit5(&mut self.enc, 0xB8, 0x00, 0x20, 0x07, 0x00);
        // mov eax, 0x72000
        // mov cr3, rax
        pe_emit3(&mut self.enc, 0x0F, 0x22, 0xD8);
        // mov cr3, rax
        // Build iret frame on kernel stack, then iretq
        // Push SS (user data segment = 0x23, index 4 | RPL=3)
        pe_emit2(&mut self.enc, 0x6A, 0x23);
        // push 0x23
        // Push RSP (user stack = r12)
        PeirEnc_push(&mut self.enc, PEIR_R12);
        // Push RFLAGS = 0x202 (IF=1, bit1=1) as a constant
        pe_emit5(&mut self.enc, 0x68, 0x02, 0x02, 0x00, 0x00);
        // push 0x202
        // Push CS (user code segment = 0x1B, index 3 | RPL=3)
        pe_emit2(&mut self.enc, 0x6A, 0x1B);
        // push 0x1B
        // Push RIP (entry address = r11)
        PeirEnc_push(&mut self.enc, PEIR_R11);
        // iretq — pops RIP, CS, RFLAGS, RSP, SS and jumps to ring 3
        pe_emit2(&mut self.enc, 0x48, 0xCF);
        // iretq
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    // No ret — iretq never returns here
}

/// Generate serial port stubs (Phase 5A.6).  Only called in bare mode in
/// Rust; kept for parity (bare bodies not ported — they panic).
pub fn PeirGen_gen_serial_stubs(self: &mut PeirGen) -> void {
    // p_serial_init() — initialize COM1 serial port (115200 baud, 8N1)
    var label: i64 = HashMap_get(self.func_labels, "p_serial_init");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Disable interrupts: outb(0x3F8 + 1, 0x00)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3F9);
        // COM1 + 1
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        pe_emit1(&mut self.enc, 0xEE);
        // out dx, al
        // Enable DLAB: outb(0x3F8 + 3, 0x80)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FB);
        // COM1 + 3 (LCR)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 0x80);
        pe_emit1(&mut self.enc, 0xEE);
        // out dx, al
        // Set divisor low byte (115200 baud = divisor 1): outb(0x3F8 + 0, 0x01)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3F8);
        // COM1 + 0
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 0x01);
        pe_emit1(&mut self.enc, 0xEE);
        // out dx, al
        // Set divisor high byte: outb(0x3F8 + 1, 0x00)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3F9);
        // COM1 + 1
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        pe_emit1(&mut self.enc, 0xEE);
        // out dx, al
        // 8 bits, no parity, 1 stop bit: outb(0x3F8 + 3, 0x03)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FB);
        // COM1 + 3 (LCR)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 0x03);
        pe_emit1(&mut self.enc, 0xEE);
        // out dx, al
        // Enable FIFO, clear them, 14-byte threshold: outb(0x3F8 + 2, 0xC7)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FA);
        // COM1 + 2 (FCR)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 0xC7);
        pe_emit1(&mut self.enc, 0xEE);
        // out dx, al
        // IRQs enabled, RTS/DSR set: outb(0x3F8 + 4, 0x0B)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FC);
        // COM1 + 4 (MCR)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 0x0B);
        pe_emit1(&mut self.enc, 0xEE);
        // out dx, al
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_serial_write(rcx = char) — write one byte to COM1
    label = HashMap_get(self.func_labels, "p_serial_write");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Wait for transmit buffer empty (Line Status Register bit 5)
        var sw_wait: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_place_label(&mut self.enc, sw_wait);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FD);
        // COM1 + 5 (LSR)
        pe_emit1(&mut self.enc, 0xEC);
        // in al, dx
        pe_emit2(&mut self.enc, 0xA8, 0x20);
        // test al, 0x20 (THR empty)
        PeirEnc_jcc_label(&mut self.enc, 0x4, sw_wait);
        // jz (wait until set)
        // Send byte: outb(0x3F8, char)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3F8);
        // COM1 + 0 (THR)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        // al = char
        pe_emit1(&mut self.enc, 0xEE);
        // out dx, al
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_serial_read() -> rax = byte — read one byte from COM1
    label = HashMap_get(self.func_labels, "p_serial_read");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Wait for data ready (Line Status Register bit 0)
        var sr_wait: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_place_label(&mut self.enc, sr_wait);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FD);
        // COM1 + 5 (LSR)
        pe_emit1(&mut self.enc, 0xEC);
        // in al, dx
        pe_emit2(&mut self.enc, 0xA8, 0x01);
        // test al, 0x01 (data ready)
        PeirEnc_jcc_label(&mut self.enc, 0x4, sr_wait);
        // jz (wait until set)
        // Read byte: in al, 0x3F8
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3F8);
        // COM1 + 0 (RBR)
        pe_emit1(&mut self.enc, 0xEC);
        // in al, dx
        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        // zero-extend al to rax
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_serial_ready() -> rax = bool — check if data is available
    label = HashMap_get(self.func_labels, "p_serial_ready");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Read LSR and check bit 0 (data ready)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FD);
        // COM1 + 5 (LSR)
        pe_emit1(&mut self.enc, 0xEC);
        // in al, dx
        pe_emit2(&mut self.enc, 0x24, 0x01);
        // and al, 0x01
        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// Print stubs
// ===========================================================================

/// p_print_int(rcx = i64 value)
pub fn PeirGen_gen_print_int(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_int");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 80);

    // rax = value, r12 = original value (for sign check later)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);

    // r8 = buffer end pointer (end of local space)
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R8, -24);

    // Save buffer end in r13 for length calculation later
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R8);

    // r9 = 10 (divisor)
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 10);

    // test rax, rax; jns pi_pos; neg rax
    var pi_pos: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x9, pi_pos);
    // jns
    PeirEnc_neg_r(&mut self.enc, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, pi_pos);

    // pi_loop: dec r8; xor rdx,rdx; div r9; add dl,'0'; mov [r8],dl; test; jnz
    var pi_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pi_loop);
    PeirEnc_dec_r(&mut self.enc, PEIR_R8);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    // div r9 (unsigned div)
    PeirEnc_rex(&mut self.enc, true, false, false, reg_ext(PEIR_R9));
    PeirEnc_emit_u8(&mut self.enc, 0xF7);
    PeirEnc_modrm(&mut self.enc, 3, 6, peir_reg_code(PEIR_R9));
    // /6 = div
    // add dl, '0'
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RDX, 48);
    // mov [r8], dl
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R8, PEIR_RDX);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pi_loop);
    // jnz

    // Check if original value (r12) was negative; prepend '-' if so
    var pi_no_neg: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_R12, PEIR_R12);
    PeirEnc_jcc_label(&mut self.enc, 0x9, pi_no_neg);
    // jns
    PeirEnc_dec_r(&mut self.enc, PEIR_R8);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RDX, 45);
    // '-'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R8, PEIR_RDX);
    PeirEnc_place_label(&mut self.enc, pi_no_neg);

    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -11);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
    // handle

    // length = r13 - r8 (buffer_end - current_pos)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_R13);
    PeirEnc_sub_rr(&mut self.enc, PEIR_R9, PEIR_R8);
    // r9 = length

    // WriteFile(handle, r8, len, &written, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    // handle
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R8);
    // buffer
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R9);
    // length
    // r9 = &written = [rbp-64]
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -64);
    // zero the written count
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);

    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    // [rsp+32] = NULL (lpOverlapped)
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);

    // return 0
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 80);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_print_str(rcx = *u8 pointer to null-terminated string)
pub fn PeirGen_gen_print_str(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_str");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 64);

    // r12 = string pointer
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);

    // r13 = length: the header's (zero bytes print, D16), else strlen
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirGen_emit_slen(self, PeirGen_iat_off(self, pe_import_slot("strlen")));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);

    // WriteFile(stdout, r12, r13, &written, NULL)
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -11);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    // handle
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
    // buffer
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R13);
    // length
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -32);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);

    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);

    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_print_bool(rcx = 0 or 1)
pub fn PeirGen_gen_print_bool(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_bool");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 64);

    // test rcx, rcx; jnz pb_true; lea r12, str_false; jmp pb_print
    var pb_true: i64 = PeirEnc_alloc_label(&mut self.enc);
    var pb_print: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pb_true);
    // jne

    // false
    var false_off: i64 = PeirGen_str_off(self, "false");
    PeirEnc_lea_rip(&mut self.enc, PEIR_R12, false_off);
    PeirEnc_jmp_label(&mut self.enc, pb_print);

    // true
    PeirEnc_place_label(&mut self.enc, pb_true);
    var true_off: i64 = PeirGen_str_off(self, "true");
    PeirEnc_lea_rip(&mut self.enc, PEIR_R12, true_off);

    PeirEnc_place_label(&mut self.enc, pb_print);

    // Calculate length
    PeirEnc_xor_self(&mut self.enc, PEIR_R8);
    var pb_len: i64 = PeirEnc_alloc_label(&mut self.enc);
    var pb_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pb_len);
    PeirEnc_cmp_mem_idx_imm8(&mut self.enc, PEIR_R12, PEIR_R8, 0);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pb_done);
    // je
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_jmp_label(&mut self.enc, pb_len);
    PeirEnc_place_label(&mut self.enc, pb_done);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R8);

    // WriteFile
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -11);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R13);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -32);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);

    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);

    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_print_float(rcx = double bits as i64)
/// Converts double to string with up to 6 decimal places, strips trailing zeros.
pub fn PeirGen_gen_print_float(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_float");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 264);

    // Stack layout:
    // [rbp-8]   = double value (input bits)
    // [rbp-16]  = 10.0 constant
    // [rbp-24]  = sign mask (0x8000000000000000)
    // [rbp-32]  = magnitude mask (0x7FFFFFFFFFFFFFFF)
    // [rbp-40]  = integer part (saved)
    // [rbp-48]  = is_negative flag
    // [rbp-56]  = fractional part (saved)
    // [rbp-64]  = 0.0 constant
    // [rbp-72]  = int_start pointer (saved R12)
    // [rbp-80]  = &written (for WriteFile)
    // [rbp-88]  = 0.5 constant
    // [rbp-256 .. rbp-89] = character buffer (168 bytes)

    // Store double bits
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -8, PEIR_RCX);

    // Store 10.0 constant (0x4024000000000000)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x4024000000000000);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);

    // Store sign mask (0x8000000000000000 = 1 << 63; the hex literal does
    // not parse in Fides, it saturates to 0)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 1 << 63);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -24, PEIR_RAX);

    // Store magnitude mask
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x7FFFFFFFFFFFFFFF);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -32, PEIR_RAX);

    // Store 0.0 constant
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -64, PEIR_RAX);

    // Store 0.5 constant (0x3FE0000000000000)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x3FE0000000000000);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -88, PEIR_RAX);

    // Load xmm0 = double value
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, -8);

    // Check for zero: AND bits with magnitude mask
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -8);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, -32);
    PeirEnc_and_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var pf_not_zero: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_not_zero);
    // jnz

    // Zero: write "0" directly
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R12, -256);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48);
    // '0'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    var pf_write: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, pf_write);

    PeirEnc_place_label(&mut self.enc, pf_not_zero);

    // Check sign: test bits with sign mask
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -8);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, -24);
    PeirEnc_and_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var pf_positive: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pf_positive);
    // jz

    // Negative: set flag, negate value
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);
    // Flip sign bit: load sign mask into XMM1, then xorpd xmm0, xmm1
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -24);
    PeirEnc_movq_xmm_r64(&mut self.enc, 1, PEIR_RAX);
    PeirEnc_xorpd_xmm_xmm(&mut self.enc, 0, 1);
    PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, -8, 0);
    var pf_after_sign: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, pf_after_sign);

    PeirEnc_place_label(&mut self.enc, pf_positive);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);

    PeirEnc_place_label(&mut self.enc, pf_after_sign);

    // Extract integer part: cvttsd2si rax, xmm0
    PeirEnc_cvttsd2si_r64(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -40, PEIR_RAX);
    // Compute fractional part: xmm1 = (double)rax; xmm0 -= xmm1
    PeirEnc_cvtsi2sd_r64(&mut self.enc, 1, PEIR_RAX);
    PeirEnc_subsd(&mut self.enc, 0, 1);
    PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, -56, 0);

    // r12 = buffer start = [rbp-256], build string FORWARD
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R12, -256);

    // If negative, store '-'
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -48);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var pf_no_minus: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pf_no_minus);
    // jz
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 45);
    // '-'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_place_label(&mut self.enc, pf_no_minus);

    // Save int_start = r12
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -72, PEIR_R12);

    // Build integer digits forward (LSD first, will reverse later)
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -40);
    var pf_int_nonzero: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_int_nonzero);
    // jnz

    // Integer part is 0: store '0'
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48);
    // '0'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    var pf_int_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, pf_int_done);

    PeirEnc_place_label(&mut self.enc, pf_int_nonzero);
    var pf_int_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pf_int_loop);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 10);
    PeirEnc_rex(&mut self.enc, true, false, false, reg_ext(PEIR_R9));
    PeirEnc_emit_u8(&mut self.enc, 0xF7);
    PeirEnc_modrm(&mut self.enc, 3, 6, peir_reg_code(PEIR_R9));
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RDX, 48);
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RDX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_int_loop);
    // jnz

    PeirEnc_place_label(&mut self.enc, pf_int_done);
    // Reverse integer digits in-place: int_start to r12-1
    // r13 = int_start, r14 = r12 - 1
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R13, -72);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R14);
    var pf_rev_check: i64 = PeirEnc_alloc_label(&mut self.enc);
    var pf_rev_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pf_rev_check);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R13, PEIR_R14);
    PeirEnc_jcc_label(&mut self.enc, 0x3, pf_rev_done);
    // jae
    // Swap bytes at r13 and r14
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R10, PEIR_R14);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_R10);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R14, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_dec_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, pf_rev_check);

    PeirEnc_place_label(&mut self.enc, pf_rev_done);

    // Now add '.' if there are fractional digits
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, -56);
    PeirEnc_xorpd_xmm_xmm(&mut self.enc, 1, 1);
    // zero XMM1
    PeirEnc_ucomisd(&mut self.enc, 0, 1);
    var pf_no_frac: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pf_no_frac);
    // je — skip if zero

    // Store '.'
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 46);
    // '.'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);

    // Fractional digit loop (up to 6 digits), forward
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R14, 6);
    var pf_frac_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pf_frac_loop);
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 1, -16);
    PeirEnc_mulsd(&mut self.enc, 0, 1);
    PeirEnc_cvttsd2si_r64(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_cvtsi2sd_r64(&mut self.enc, 1, PEIR_RAX);
    PeirEnc_subsd(&mut self.enc, 0, 1);
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RAX, 48);
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_xorpd_xmm_xmm(&mut self.enc, 1, 1);
    // zero XMM1
    PeirEnc_ucomisd(&mut self.enc, 0, 1);
    var pf_frac_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pf_frac_done);
    // je
    PeirEnc_dec_r(&mut self.enc, PEIR_R14);
    var pf_frac_continue: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_frac_continue);
    // jnz
    PeirEnc_jmp_label(&mut self.enc, pf_frac_done);
    PeirEnc_place_label(&mut self.enc, pf_frac_continue);
    PeirEnc_jmp_label(&mut self.enc, pf_frac_loop);

    PeirEnc_place_label(&mut self.enc, pf_frac_done);

    // Rounding: only if we generated 6 digits (r14 == 0) and frac >= 0.5
    PeirEnc_test_rr(&mut self.enc, PEIR_R14, PEIR_R14);
    var pf_strip: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_strip);
    // jnz — stopped early

    // Check if remaining frac >= 0.5
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 1, -88);
    PeirEnc_ucomisd(&mut self.enc, 0, 1);
    PeirEnc_jcc_label(&mut self.enc, 0x2, pf_strip);
    // jb — no rounding

    // Rounding: increment last fractional digit at [r12-1]
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    var pf_round_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pf_round_loop);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RAX, 1);
    // If al > '9' (0x3A), carry
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 58);
    // '9' + 1
    var pf_round_store: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_round_store);
    // jnz
    // Carry: set byte to '0', move to previous digit
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    // Check if we hit '.' — skip over it
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 46);
    // '.'
    var pf_round_skip_dot: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_round_skip_dot);
    // jnz
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    // skip over '.'
    PeirEnc_place_label(&mut self.enc, pf_round_skip_dot);
    // Check if we hit '-' — stop if so
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 45);
    // '-'
    var pf_round_stop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pf_round_stop);
    // jz
    PeirEnc_jmp_label(&mut self.enc, pf_round_loop);

    PeirEnc_place_label(&mut self.enc, pf_round_store);
    // Store incremented byte at [r13]
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_jmp_label(&mut self.enc, pf_strip);

    PeirEnc_place_label(&mut self.enc, pf_round_stop);
    // Carry hit '-': edge case (9.999999 rounding) — accepted as in Rust.

    PeirEnc_place_label(&mut self.enc, pf_strip);
    // Strip trailing zeros from fractional part
    var pf_strip_check: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pf_strip_check);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 48);
    // '0'
    var pf_strip_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_strip_done);
    // jnz
    PeirEnc_dec_r(&mut self.enc, PEIR_R12);
    PeirEnc_jmp_label(&mut self.enc, pf_strip_check);

    PeirEnc_place_label(&mut self.enc, pf_strip_done);
    // Check if last char is '.' — remove it
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 46);
    // '.'
    var pf_no_strip_dot: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_no_strip_dot);
    // jnz
    PeirEnc_dec_r(&mut self.enc, PEIR_R12);
    // remove the '.'
    PeirEnc_place_label(&mut self.enc, pf_no_strip_dot);

    PeirEnc_place_label(&mut self.enc, pf_no_frac);

    // r13 = r12 - 1 (last digit position, no newline)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    // r12 = buffer start = [rbp-256]
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R12, -256);

    // Length = r13 - r12 + 1
    PeirEnc_place_label(&mut self.enc, pf_write);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R13);
    PeirEnc_sub_rr(&mut self.enc, PEIR_R8, PEIR_R12);
    PeirEnc_add_r_i8(&mut self.enc, PEIR_R8, 1);

    // WriteFile(stdout, r12, r8, &written, NULL)
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -11);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -80);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);

    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);

    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 264);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_panic(rcx = message pointer)
pub fn PeirGen_gen_panic(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_panic");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    // message
    PeirEnc_push(&mut self.enc, PEIR_R13);
    // stderr
    PeirEnc_sub_rsp_i32(&mut self.enc, 80);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);

    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -12);
    // STD_ERROR_HANDLE
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);

    // The prefix ("Panic: ") and the newline live in a stack slot (rbp-48)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x00203A63696E6150);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -48);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 7);
    PeirGen_gen_panic_write(self);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("strlen")));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
    PeirGen_gen_panic_write(self);

    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x0A);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -48);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 1);
    PeirGen_gen_panic_write(self);

    // CO9 (Nov 22): the stack trace — walk the frame-pointer chain
    // and print each return address as hex. Symbolizable with `fid disasm`.
    // Everything the walk keeps lives in registers WriteFile preserves
    // (Win64 callee-saved: r14 the frame, r15 the frame count, rsi the
    // digit count, rdi the address being printed); the Nov 22 first
    // version kept the digit count in rcx and the address in rax, which
    // every WriteFile clobbers, so each panic printed '0's forever
    // (known-bugs 2g.116). A frame is followed only while it is 8-aligned,
    // at or above this stub's frame, below the thread's stack base
    // (TEB gs:[8]) and each next frame is above the last, so a chain that
    // ends in code without frame pointers stops instead of faulting.
    // Four pushes: rsp stays 16-aligned for the calls.
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_push(&mut self.enc, PEIR_R15);
    PeirEnc_push(&mut self.enc, PEIR_RSI);
    PeirEnc_push(&mut self.enc, PEIR_RDI);
    // "trace" + newline at [rbp-56]
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x000A6563617274);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -56, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -56);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 6);
    PeirGen_gen_panic_write(self);
    // r14 = this stub's frame: its [r14 + 8] returns into the panicking
    // function, so that function is the first line
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_RBP);
    PeirEnc_xor_self(&mut self.enc, PEIR_R15);
    var st_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    var st_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, st_loop);
    PeirEnc_test_rr(&mut self.enc, PEIR_R14, PEIR_R14);
    PeirEnc_jcc_label(&mut self.enc, 0x4, st_done);
    PeirEnc_cmp_r_imm(&mut self.enc, PEIR_R15, 32);
    PeirEnc_jcc_label(&mut self.enc, 0xD, st_done);
    // 8-aligned: shl rax, 61 of a copy leaves the low three bits
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R14);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 61);
    PeirEnc_jcc_label(&mut self.enc, 0x5, st_done);
    // not below this stub's frame (jb)
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R14, PEIR_RBP);
    PeirEnc_jcc_label(&mut self.enc, 0x2, st_done);
    // [r14 + 8] below the stack base: mov rax, gs:[8]; sub 16; r14 > it: stop
    PeirEnc_emit_u8(&mut self.enc, 0x65);
    PeirEnc_emit_u8(&mut self.enc, 0x48);
    PeirEnc_emit_u8(&mut self.enc, 0x8B);
    PeirEnc_emit_u8(&mut self.enc, 0x04);
    PeirEnc_emit_u8(&mut self.enc, 0x25);
    PeirEnc_emit_u32(&mut self.enc, 8);
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RAX, 0 - 16);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R14, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x7, st_done);
    // rdi = the return address [r14 + 8]; rsi = 16 digits (MSB first)
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDI, PEIR_R14, 8);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RSI, 16);
    var st_nib: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, st_nib);
    // r9 = the top nibble of rdi (shr r9, cl with cl = 60)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RDI);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 60);
    PeirEnc_shr_cl(&mut self.enc, PEIR_R9);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDI, 4);
    // char: '0' + nibble (or 'a' + nibble - 10)
    PeirEnc_add_r_i8(&mut self.enc, PEIR_R9, 48);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_R9, 57);
    var st_skip: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x6, st_skip);
    PeirEnc_add_r_i8(&mut self.enc, PEIR_R9, 39);
    PeirEnc_place_label(&mut self.enc, st_skip);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -56, PEIR_R9);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -56);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 1);
    PeirGen_gen_panic_write(self);
    PeirEnc_dec_r(&mut self.enc, PEIR_RSI);
    PeirEnc_jcc_label(&mut self.enc, 0x5, st_nib);
    // newline
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 10);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -56, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -56);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 1);
    PeirGen_gen_panic_write(self);
    // next frame [r14], only when it is above this one (jbe: stop)
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R14, 0);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R14);
    PeirEnc_jcc_label(&mut self.enc, 0x6, st_done);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R15);
    PeirEnc_jmp_label(&mut self.enc, st_loop);
    PeirEnc_place_label(&mut self.enc, st_done);
    PeirEnc_pop(&mut self.enc, PEIR_RDI);
    PeirEnc_pop(&mut self.enc, PEIR_RSI);
    PeirEnc_pop(&mut self.enc, PEIR_R15);
    PeirEnc_pop(&mut self.enc, PEIR_R14);

    // CA9: the tasks the panicking one ran for (pe_runtime/conc.fd
    // pert_task_chain; it prints nothing outside a task; ir.fd
    // pe_ir_reachable_from counts it needed once a program creates a
    // task). rcx = env 0, as for pert_thread_main; rsp is 16-aligned here
    // (the same frame the WriteFile calls use).
    if HashMap_contains(self.func_labels, "pert_task_chain") {
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirGen_call_runtime(self, "pert_task_chain");
    }

    // CO9: the crash report, when the runtime has it: pert_crash_report(env
    // 0, message) (FID_CRASH_REPORT names its file). CPU faults reach this
    // stub through crash_filter, so they get reports too. rsp is 16-aligned
    // here (push rbp, r12, r13 + sub 80) and the 80 bytes hold the shadow
    // space.
    if HashMap_contains(self.func_labels, "pert_crash_report") {
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "pert_crash_report"));
    }

    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 1);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_EXIT_PROCESS));
    PeirEnc_ud2(&mut self.enc);
}

/// CO9 (Nov 22): __pe_sym — given a code address in rcx, return the name
/// of the function containing it (a pointer into .rdata), or 0 when no
/// function's start is at or below it. A linear scan over every function
/// label with "latest start wins" (no sorting needed: labels are compared
/// at run time through their RIP-relative addresses). Called from the
/// panic stub's stack walker to print "fn_name" instead of raw hex.
fn PeirGen_gen_sym_lookup(self: &mut PeirGen) -> void {
    var label: i64 = PeirEnc_alloc_label(&mut self.enc);
    HashMap_insert(self.func_labels, "__pe_sym", label);
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_RBX);
    PeirEnc_push(&mut self.enc, PEIR_R10);
    PeirEnc_push(&mut self.enc, PEIR_R11);
    PeirEnc_sub_rsp_i32(&mut self.enc, 16);
    // rbx = best name (0 = none yet); r10 = best start (0)
    PeirEnc_xor_self(&mut self.enc, PEIR_RBX);
    PeirEnc_xor_self(&mut self.enc, PEIR_R10);
    // iterate over func_labels: for each (name, flabel):
    //   lea r11, [rip + flabel]  (the function's code start)
    //   cmp rcx, r11              (addr >= start?)
    //   jb .skip
    //   cmp r11, r10              (start > best_start?)
    //   jbe .skip
    //   mov r10, r11
    //   lea rbx, [rip + str_off(name)]
    // .skip:
    var names: Vec<str> = Vec::new();
    var flabels: Vec<i64> = Vec::new();
    // pe_ir_stubs has no HashMap iterator: the function names are in
    // g_pe_all_fns (populated as functions are generated); their labels
    // from func_labels
    var fi: i64 = 0;
    while fi < self.module_fns.len() {
        var fname: str = self.module_fns.get(fi);
        var flabel: i64 = HashMap_get(self.func_labels, fname);
        if flabel != 0 {
            names.push(fname);
            flabels.push(flabel);
        }
        fi = fi + 1;
    }
    fi = 0;
    while fi < names.len() {
        var skip_l: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_lea_label(&mut self.enc, PEIR_R11, flabels.get(fi));
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RCX, PEIR_R11);
        PeirEnc_jcc_label(&mut self.enc, 0x2, skip_l);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_R11, PEIR_R10);
        PeirEnc_jcc_label(&mut self.enc, 0x6, skip_l);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_R11);
        PeirEnc_lea_rip(&mut self.enc, PEIR_RBX, PeirGen_str_off(self, names.get(fi)));
        PeirEnc_place_label(&mut self.enc, skip_l);
        fi = fi + 1;
    }
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RBX);
    PeirEnc_add_rsp_i32(&mut self.enc, 16);
    PeirEnc_pop(&mut self.enc, PEIR_R11);
    PeirEnc_pop(&mut self.enc, PEIR_R10);
    PeirEnc_pop(&mut self.enc, PEIR_RBX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// WriteFile(r13, rdx, r8, &written, NULL), inside gen_panic's frame
fn PeirGen_gen_panic_write(self: &mut PeirGen) -> void {
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -40);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
}

// Allocator state in writable .rdata: +0 cur, +8 end, +16 cached heap,
// +24 spinlock, +32 the TLS index + 1 of the per-thread free lists (release
// H8; the classes start at 7, so the old global list slot 0 is free for it),
// then (MI20) +360 the TLS index of nat_tls_get/nat_tls_set and +368 the
// start block nat_start_sp returns; (RT7) +376 the SRW lock of the chunks,
// +384 the newest chunk, +392 the free lists of ended threads
// (stdlib/pe_runtime/conc.fd "Freed memory back to the system", which gets
// this block's address).
// RT7: a thread's list array (512 bytes; the free lists of classes 7..40 at
// class * 8): +384 bump cursor, +392 bump end (in the thread's own 4 MB
// chunk), +400 that chunk, +408 the resident bytes on its lists, +416 the
// count past which p_free calls pert_alloc_trim, (RT8) +424 the thread's
// owner slot (conc.fd has the same offsets, and the owner return's design
// in "Freed memory back to the system").
// RT8: allocator state +400 the TEB offset of the list arrays' TLS slot (0:
// TlsGetValue), +408 / +416 the owner slot table and its highest slot
// (conc.fd), then two tables pe_ir.fd fills (peir_alloc_state_byte): +448
// the block bytes of each class (a word each, classes 0..40), +776 the
// class of a request of s <= PEIR_SMALL_MAX bytes at (s + 15) >> 3. A
// chunk's header word 64 is its owner slot.
const PEIR_PT_CUR: i64 = 384;
const PEIR_PT_END: i64 = 392;
const PEIR_PT_FREE: i64 = 408;
const PEIR_PT_NEXT: i64 = 416;
const PEIR_PT_SLOT: i64 = 424;
const PEIR_ST_TEBOFF: i64 = 400;
pub const PEIR_ALLOC_BYTES: i64 = 448;
pub const PEIR_ALLOC_CLS: i64 = 776;
pub const PEIR_SMALL_MAX: i64 = 1016;
const PEIR_CHUNK_OWNER: i64 = 64;
pub const PEIR_ALLOC_STATE_SIZE: i64 = 960;
const PEIR_ALLOC_LISTS: i64 = 32;
const PEIR_NAT_TLS: i64 = 360;
const PEIR_NAT_SSP: i64 = 368;  // A block's header: this magic | its size class. p_free turns it into
// PEIR_BLOCK_FREED | class, and panics on anything else: a block freed twice,
// or a pointer that never was a block.
const PEIR_BLOCK_MAGIC: i64 = 0xF1DE5A0000000000;
const PEIR_BLOCK_FREED: i64 = 0xF1DE5B0000000000;
const PEIR_CLASS_LARGE: i64 = 63;
// The p_free stub's panics: indices into PeirGen.arith_panics, in the order
// of pe_ir.fd's peir_arith_panic_strings (defined here: pe_ir imports this
// module, not the other way round)
pub const PEIR_PANIC_DOUBLE_FREE: i64 = 7;
pub const PEIR_PANIC_BAD_FREE: i64 = 8;
/// `fid emit --checked-alloc` (release M7): every block gets pages of its
/// own, ending at an inaccessible guard page; a freed block's pages become
/// inaccessible and are never reused. A use after free, a double free or an
/// overrun past the block faults, with a trace, instead of reading or
/// damaging other data. Slow and memory-hungry: for finding bugs.
pub var g_pe_checked_alloc: bool = false;
/// `fid emit --leaks` (RL16): p_malloc / p_free are thunks into
/// stdlib/pe_runtime/base.fd pert_leak_malloc / pert_leak_free, which
/// report the blocks never freed at exit; the block allocator itself
/// becomes the primitives pe_lk_raw_malloc / pe_lk_raw_free.
pub var g_pe_leaks: bool = false;
const PEIR_CLASS_CHECKED: i64 = 62;
/// p_malloc under --checked-alloc. Block layout from `start`: [0][site]
/// [size][base][span][header] then the 16-aligned payload, placed so that it
/// ends (rounded to 16 bytes) at the guard page. `site` is the return address of the call to
/// p_malloc and `size` the size asked for: the fault report names the block
/// with them (PeirGen_gen_checked_fault). The pages before `start` stay
/// zero, so the first nonzero word of the allocation is `site`.
fn PeirGen_gen_checked_malloc(self: &mut PeirGen) -> void {
    var out: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_push(&mut self.enc, PEIR_R15);
    // r14 = size, r15 = the call site (four pushes: rsp stays 16-aligned)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_RCX);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R15, PEIR_RBP, 8);
    // r12 = used = ((size + 15) & ~15) + 48: the payload is 16-aligned and
    // ends exactly at the guard page when the size is a multiple of 16
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xC0, 0x0F);
    // add rax, 15
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xE0, 0xF0);
    // and rax, -16
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xC0, 0x30);
    // add rax, 48
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
    // r13 = span = round_up(used, 4096) + 4096
    pe_emit2(&mut self.enc, 0x48, 0x05);
    PeirEnc_emit_i32(&mut self.enc, 4095);
    // add rax, 4095
    pe_emit2(&mut self.enc, 0x48, 0x25);
    PeirEnc_emit_i32(&mut self.enc, -4096);
    // and rax, -4096
    pe_emit2(&mut self.enc, 0x48, 0x05);
    PeirEnc_emit_i32(&mut self.enc, 4096);
    // add rax, 4096
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);
    // rax = VirtualAlloc(NULL, span, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE)
    PeirEnc_xor_self(&mut self.enc, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, 0x3000);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, 4);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("VirtualAlloc")));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, out);
    // jz: out of memory, NULL
    // VirtualProtect(base + span - 4096, 4096, PAGE_NOACCESS, &old)
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 40, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    pe_emit3(&mut self.enc, 0x48, 0x81, 0xE9);
    PeirEnc_emit_i32(&mut self.enc, 4096);
    // sub rcx, 4096
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, 4096);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, 1);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RSP);
    pe_emit4(&mut self.enc, 0x49, 0x83, 0xC1, 0x20);
    // add r9, 32
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("VirtualProtect")));
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, 40);
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    // rcx = start = base + span - 4096 - used:
    // [0][site][size][base][span][header] payload
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    pe_emit3(&mut self.enc, 0x48, 0x81, 0xE9);
    PeirEnc_emit_i32(&mut self.enc, 4096);
    // sub rcx, 4096
    PeirEnc_sub_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 8, PEIR_R15);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 16, PEIR_R14);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 24, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 32, PEIR_R13);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, PEIR_BLOCK_MAGIC | PEIR_CLASS_CHECKED);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 40, PEIR_RDX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xC0, 0x30);
    // add rax, 48
    PeirEnc_place_label(&mut self.enc, out);
    PeirEnc_pop(&mut self.enc, PEIR_R15);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// The --checked-alloc fault reports (format strings for msvcrt _snprintf).
pub fn peir_checked_uaf_fmt() -> str {
    return "Use after free (--checked-alloc): the block of %I64d bytes at 0x%I64X was freed; accessed at offset %I64d; allocated by the call returning to image offset 0x%I64X";
}
pub fn peir_checked_overrun_fmt() -> str {
    return "Access past the end of a block (--checked-alloc): the block of %I64d bytes at 0x%I64X; accessed at offset %I64d; allocated by the call returning to image offset 0x%I64X";
}

/// Part of the crash filter under --checked-alloc (release M7, complaint
/// CM9), entered with rax = the exception code and rcx = the
/// EXCEPTION_POINTERS. An access violation on a page of a checked block —
/// a freed block's pages, or the guard page after a live one — panics with
/// what the block was: its size, address, the offset accessed and the
/// image offset of the call that allocated it (from the block's record,
/// PeirGen_gen_checked_malloc). Anything else falls through with rax
/// unchanged, to the generic message.
pub fn PeirGen_gen_checked_fault(self: &mut PeirGen) -> void {
    var next: i64 = PeirEnc_alloc_label(&mut self.enc);
    var notours: i64 = PeirEnc_alloc_label(&mut self.enc);
    var freed: i64 = PeirEnc_alloc_label(&mut self.enc);
    var scan: i64 = PeirEnc_alloc_label(&mut self.enc);
    var scan_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    var found: i64 = PeirEnc_alloc_label(&mut self.enc);
    var header_ok: i64 = PeirEnc_alloc_label(&mut self.enc);
    var norva: i64 = PeirEnc_alloc_label(&mut self.enc);
    var live_msg: i64 = PeirEnc_alloc_label(&mut self.enc);
    var fmt_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    var vquery: i64 = PeirGen_iat_off(self, pe_import_slot("VirtualQuery"));
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, 0xC0000005);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, next);
    // jne
    // Entry rsp is 8 mod 16: three pushes and 400 align it. Frame: [rsp+32..]
    // the stack arguments, +64 a MEMORY_BASIC_INFORMATION (48 bytes), +112
    // the old protection, +120 "freed", +128 the message (256 bytes).
    PeirEnc_push(&mut self.enc, PEIR_RBX);
    PeirEnc_push(&mut self.enc, PEIR_RSI);
    PeirEnc_push(&mut self.enc, PEIR_RDI);
    PeirEnc_sub_rsp_i32(&mut self.enc, 400);
    // rbx = the address accessed: ExceptionRecord->ExceptionInformation[1]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RBX, PEIR_RAX, 40);
    // VirtualQuery(rbx): committed and inaccessible, or not ours
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RBX);
    PeirEnc_lea_base_disp(&mut self.enc, PEIR_RDX, PEIR_RSP, 64);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 48);
    PeirEnc_call_rip(&mut self.enc, vquery);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, notours);
    // jz
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, 96);
    PeirEnc_mov_r32_r32(&mut self.enc, PEIR_RDX, PEIR_RAX);
    // edx = State
    PeirEnc_cmp_r_imm(&mut self.enc, PEIR_RDX, 0x1000);
    PeirEnc_jcc_label(&mut self.enc, 0x5, notours);
    // jne: not MEM_COMMIT
    pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x20);
    // shr rax, 32: Protect
    PeirEnc_cmp_r_imm(&mut self.enc, PEIR_RAX, 1);
    PeirEnc_jcc_label(&mut self.enc, 0x5, notours);
    // jne: not PAGE_NOACCESS
    // rsi = AllocationBase; VirtualQuery(rsi): its first pages
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RSI, PEIR_RSP, 72);
    PeirEnc_test_rr(&mut self.enc, PEIR_RSI, PEIR_RSI);
    PeirEnc_jcc_label(&mut self.enc, 0x4, notours);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RSI);
    PeirEnc_lea_base_disp(&mut self.enc, PEIR_RDX, PEIR_RSP, 64);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 48);
    PeirEnc_call_rip(&mut self.enc, vquery);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, notours);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, 96);
    pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x20);
    // shr rax, 32: Protect of the first page
    PeirEnc_cmp_r_imm(&mut self.enc, PEIR_RAX, 1);
    PeirEnc_jcc_label(&mut self.enc, 0x4, freed);
    // je: the whole block is inaccessible, so freed
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 120, PEIR_RAX);
    PeirEnc_jmp_label(&mut self.enc, scan);
    // Freed: VirtualProtect(rsi, RegionSize, PAGE_READONLY, &old) to read
    // its record (the program stops here anyway)
    PeirEnc_place_label(&mut self.enc, freed);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RSI);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_RSP, 88);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 2);
    PeirEnc_lea_base_disp(&mut self.enc, PEIR_R9, PEIR_RSP, 112);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("VirtualProtect")));
    pe_emit2(&mut self.enc, 0x85, 0xC0);
    // test eax, eax
    PeirEnc_jcc_label(&mut self.enc, 0x4, notours);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 120, PEIR_RAX);
    // Scan from the allocation base, up to r10 = base + RegionSize, for the
    // first nonzero word: the record's `site` (the pages before it are zero)
    PeirEnc_place_label(&mut self.enc, scan);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_RSI);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, 88);
    PeirEnc_add_rr(&mut self.enc, PEIR_R10, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDI, PEIR_RSI);
    PeirEnc_place_label(&mut self.enc, scan_loop);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RDI, 0);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, found);
    // jnz
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RDI, 8);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RDI, PEIR_R10);
    PeirEnc_jcc_label(&mut self.enc, 0x2, scan_loop);
    // jb
    PeirEnc_jmp_label(&mut self.enc, notours);
    // rdi = start: the record must fit, its header be a checked block's
    PeirEnc_place_label(&mut self.enc, found);
    PeirEnc_lea_base_disp(&mut self.enc, PEIR_RAX, PEIR_RDI, 40);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_jcc_label(&mut self.enc, 0x7, notours);
    // ja
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RDI, 32);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, PEIR_BLOCK_MAGIC | PEIR_CLASS_CHECKED);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, header_ok);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, PEIR_BLOCK_FREED | PEIR_CLASS_CHECKED);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, notours);
    PeirEnc_place_label(&mut self.enc, header_ok);
    // rsi = the call site's offset in its image (VirtualQuery(site)'s
    // AllocationBase is the image base), else the site itself
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_RDI, 0);
    PeirEnc_lea_base_disp(&mut self.enc, PEIR_RDX, PEIR_RSP, 64);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 48);
    PeirEnc_call_rip(&mut self.enc, vquery);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RSI, PEIR_RDI, 0);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, norva);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, 72);
    PeirEnc_sub_rr(&mut self.enc, PEIR_RSI, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, norva);
    // _snprintf(buf, 255, fmt, size, payload, offset, site offset)
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 376, PEIR_RAX);
    PeirEnc_lea_base_disp(&mut self.enc, PEIR_RCX, PEIR_RSP, 128);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 255);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, 120);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, live_msg);
    PeirEnc_lea_rip(&mut self.enc, PEIR_R8, PeirGen_str_off(self, peir_checked_uaf_fmt()));
    PeirEnc_jmp_label(&mut self.enc, fmt_done);
    PeirEnc_place_label(&mut self.enc, live_msg);
    PeirEnc_lea_rip(&mut self.enc, PEIR_R8, PeirGen_str_off(self, peir_checked_overrun_fmt()));
    PeirEnc_place_label(&mut self.enc, fmt_done);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R9, PEIR_RDI, 8);
    PeirEnc_lea_base_disp(&mut self.enc, PEIR_R10, PEIR_RDI, 40);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_R10);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RBX);
    PeirEnc_sub_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 40, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 48, PEIR_RSI);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("_snprintf")));
    PeirEnc_lea_base_disp(&mut self.enc, PEIR_RCX, PEIR_RSP, 128);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_panic"));
    PeirEnc_ud2(&mut self.enc);
    // Not a checked block: the generic message
    PeirEnc_place_label(&mut self.enc, notours);
    PeirEnc_add_rsp_i32(&mut self.enc, 400);
    PeirEnc_pop(&mut self.enc, PEIR_RDI);
    PeirEnc_pop(&mut self.enc, PEIR_RSI);
    PeirEnc_pop(&mut self.enc, PEIR_RBX);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0xC0000005);
    PeirEnc_place_label(&mut self.enc, next);
}

/// Acquire the allocator's spinlock.
fn PeirGen_gen_alloc_lock(self: &mut PeirGen, abase: i64) -> void {
    var retry: i64 = PeirEnc_alloc_label(&mut self.enc);
    var acquired: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, retry);
    // lock bts qword [rip + abase+24], 0 -> jnc = acquired
    PeirEnc_emit_u8(&mut self.enc, 0xF0);
    PeirEnc_emit_u8(&mut self.enc, 0x48);
    PeirEnc_emit_u8(&mut self.enc, 0x0F);
    PeirEnc_emit_u8(&mut self.enc, 0xBA);
    PeirEnc_emit_u8(&mut self.enc, 0x2D);
    // mod=00 reg=101 rm=101 -> [rip]+/5
    self.enc.pending_rip_refs.push(PeirRipRef_new(self.enc.code.len(), abase + 24));
    PeirEnc_emit_i32(&mut self.enc, 0);
    PeirEnc_emit_u8(&mut self.enc, 0x00);
    // imm8 = bit 0
    PeirEnc_jcc_label(&mut self.enc, 0x3, acquired);
    // jnc
    PeirEnc_emit_u8(&mut self.enc, 0xF3);
    // pause
    PeirEnc_emit_u8(&mut self.enc, 0x90);
    PeirEnc_jmp_label(&mut self.enc, retry);
    PeirEnc_place_label(&mut self.enc, acquired);
}

/// Release the allocator's spinlock.
fn PeirGen_gen_alloc_unlock(self: &mut PeirGen, abase: i64) -> void {
    PeirEnc_emit_u8(&mut self.enc, 0xC6);
    PeirEnc_emit_u8(&mut self.enc, 0x05);
    self.enc.pending_rip_refs.push(PeirRipRef_new(self.enc.code.len(), abase + 24));
    PeirEnc_emit_i32(&mut self.enc, 0);
    PeirEnc_emit_u8(&mut self.enc, 0x00);
}

/// r9 = this thread's free-list array (release H8: a free list per thread,
/// so p_malloc and p_free take no lock; only a new chunk or a trim does).
/// The array (64 class heads) is made on a thread's first use and kept in a
/// TLS slot allocated once. RT8: when that slot's index is below 64 its
/// offset in the TEB is at abase+400 and the array is one gs: load (the TEB's
/// TlsSlots, as TlsGetValue reads them, without the call); otherwise, and on
/// a thread's first use, TlsGetValue. Every register but r9 (and the flags)
/// is kept, so the fast paths need no frame; any stack alignment.
fn PeirGen_gen_my_lists(self: &mut PeirGen, abase: i64) -> void {
    var have: i64 = PeirEnc_alloc_label(&mut self.enc);
    var have_locked: i64 = PeirEnc_alloc_label(&mut self.enc);
    var done: i64 = PeirEnc_alloc_label(&mut self.enc);
    var slow: i64 = PeirEnc_alloc_label(&mut self.enc);
    var no_teb: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_R9, abase + PEIR_ST_TEBOFF);
    PeirEnc_test_rr(&mut self.enc, PEIR_R9, PEIR_R9);
    PeirEnc_jcc_label(&mut self.enc, 0x4, slow);
    // jz
    pe_emit4(&mut self.enc, 0x65, 0x4D, 0x8B, 0x09);
    // mov r9, gs:[r9]
    PeirEnc_test_rr(&mut self.enc, PEIR_R9, PEIR_R9);
    PeirEnc_jcc_label(&mut self.enc, 0x5, done);
    // jnz
    PeirEnc_place_label(&mut self.enc, slow);
    // Slow: the volatile registers but r9 kept on an aligned frame
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_RAX);
    PeirEnc_push(&mut self.enc, PEIR_RCX);
    PeirEnc_push(&mut self.enc, PEIR_RDX);
    PeirEnc_push(&mut self.enc, PEIR_R8);
    PeirEnc_push(&mut self.enc, PEIR_R10);
    PeirEnc_push(&mut self.enc, PEIR_R11);
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xE4, 0xF0);
    // and rsp, -16
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, abase + PEIR_ALLOC_LISTS);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, have);
    // jnz
    // First use in the process: TlsAlloc, once, under the spinlock
    PeirGen_gen_alloc_lock(self, abase);
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, abase + PEIR_ALLOC_LISTS);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, have_locked);
    // jnz
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("TlsAlloc")));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    pe_emit2(&mut self.enc, 0x89, 0xC0);
    // mov eax, eax (zero-extend the DWORD)
    pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC0);
    // inc rax
    PeirEnc_mov_rip_reg(&mut self.enc, abase + PEIR_ALLOC_LISTS, PEIR_RAX);
    // RT8: an index below 64 is the TEB's TlsSlots[index], at 0x1480 +
    // 8 * index from gs (published after the index: a thread that reads 0
    // takes this slow path)
    PeirEnc_lea_base_disp(&mut self.enc, PEIR_RDX, PEIR_RAX, -1);
    PeirEnc_cmp_r_imm(&mut self.enc, PEIR_RDX, 64);
    PeirEnc_jcc_label(&mut self.enc, 0x3, no_teb);
    // jae
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDX, 3);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RDX, 0x1480);
    PeirEnc_mov_rip_reg(&mut self.enc, abase + PEIR_ST_TEBOFF, PEIR_RDX);
    PeirEnc_place_label(&mut self.enc, no_teb);
    PeirEnc_place_label(&mut self.enc, have_locked);
    PeirGen_gen_alloc_unlock(self, abase);
    PeirEnc_place_label(&mut self.enc, have);
    // rax = TlsGetValue(index)
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RCX, abase + PEIR_ALLOC_LISTS);
    pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC9);
    // dec rcx
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("TlsGetValue")));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    var got: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, got);
    // jnz
    // This thread's first block: its zeroed list array, kept in the slot
    PeirGen_gen_process_heap(self, abase);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, 8);
    // HEAP_ZERO_MEMORY
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, 512);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_HEAP_ALLOC));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RCX, abase + PEIR_ALLOC_LISTS);
    pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC9);
    // dec rcx
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("TlsSetValue")));
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, 32);
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    PeirEnc_place_label(&mut self.enc, got);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
    PeirEnc_lea_base_disp(&mut self.enc, PEIR_RSP, PEIR_RBP, -48);
    PeirEnc_pop(&mut self.enc, PEIR_R11);
    PeirEnc_pop(&mut self.enc, PEIR_R10);
    PeirEnc_pop(&mut self.enc, PEIR_R8);
    PeirEnc_pop(&mut self.enc, PEIR_RDX);
    PeirEnc_pop(&mut self.enc, PEIR_RCX);
    PeirEnc_pop(&mut self.enc, PEIR_RAX);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_place_label(&mut self.enc, done);
}

/// r9 = address of the free list of class r13 (clobbers rax).
fn PeirGen_gen_free_list_addr(self: &mut PeirGen, abase: i64) -> void {
    PeirEnc_lea_rip(&mut self.enc, PEIR_R9, abase + PEIR_ALLOC_LISTS);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
}

/// rax = the process heap, cached at abase+16.
fn PeirGen_gen_process_heap(self: &mut PeirGen, abase: i64) -> void {
    var have_heap: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, abase + 16);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, have_heap);
    // jnz
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_PROCESS_HEAP));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rip_reg(&mut self.enc, abase + 16, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, have_heap);
}

/// P12 (FID_MEM_LIMIT): `name`(env 0, rdx = block bytes), pert_lim_take or
/// pert_lim_give (pe_runtime/conc.fd), when the runtime has it. With no
/// limit set (the global pe_lim_mem is 0) the call is skipped. Needs rsp
/// 16-aligned; clobbers rax, rcx, rdx, r8–r11.
fn PeirGen_gen_lim_call(self: &mut PeirGen, name: str) -> void {
    if !HashMap_contains(self.func_labels, name) {
        return;
    }
    var skip: i64 = PeirEnc_alloc_label(&mut self.enc);
    if HashMap_contains(self.global_rdata_offsets, "pe_lim_mem") {
        PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, HashMap_get(self.global_rdata_offsets, "pe_lim_mem"));
        PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_jcc_label(&mut self.enc, 0x4, skip);
        // jz
    }
    PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, name));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_place_label(&mut self.enc, skip);
}

/// RL16 (--leaks): the body of the p_malloc / p_free thunk, placed at their
/// label: `target`(env 0, rcx) on a 16-aligned stack with shadow space, its
/// rax returned. push rbp / mov rbp, rsp keeps a frame record.
fn PeirGen_gen_leak_thunk(self: &mut PeirGen, target: str) -> void {
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xE4, 0xF0);
    // and rsp, -16
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    // env first: rdx = the argument, rcx = 0
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirGen_call_runtime(self, target);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// RT8: the block bytes of class c (as p_malloc makes them): 1 << (c / 2)
/// for an even c, three quarters of the next power of two for an odd one;
/// 0 below the first class (stdlib/pe_runtime/conc.fd pe_al_bytes).
pub fn peir_class_bytes(c: i64) -> i64 {
    if c < 7 {
        return 0;
    }
    if c % 2 == 0 {
        return 1 << (c / 2);
    }
    return 3 << (c / 2 - 1);
}

/// RT8: the class of a block of n bytes with its header (n >= 8): the
/// power of two 2^b >= n (b at least 4) is class 2b, three quarters of it
/// class 2b - 1 when that holds n (not for b = 4), as the machine code of
/// PeirGen_gen_malloc_body computes for the sizes past the table.
pub fn peir_class_for(n: i64) -> i64 {
    var b: i64 = 4;
    while (1 << b) < n {
        b = b + 1;
    }
    if b != 4 && n <= (3 << (b - 2)) {
        return 2 * b - 1;
    }
    return 2 * b;
}

/// RT8: the initial bytes of the allocator state in .rdata (pe_ir.fd
/// writes them): zero, but the class tables: at PEIR_ALLOC_BYTES each
/// class's block bytes (a word per class 0..40), at PEIR_ALLOC_CLS the
/// class of a request of s bytes at index (s + 15) >> 3, s up to
/// PEIR_SMALL_MAX (with the header: n = 8 * index).
pub fn peir_alloc_state_byte(i: i64) -> i64 {
    if i >= PEIR_ALLOC_BYTES && i < PEIR_ALLOC_BYTES + 41 * 8 {
        var c: i64 = (i - PEIR_ALLOC_BYTES) / 8;
        var k: i64 = (i - PEIR_ALLOC_BYTES) % 8;
        return (peir_class_bytes(c) >> (8 * k)) & 255;
    }
    if i >= PEIR_ALLOC_CLS && i <= PEIR_ALLOC_CLS + (PEIR_SMALL_MAX + 15) / 8 {
        var j: i64 = i - PEIR_ALLOC_CLS;
        var n: i64 = 8 * j;
        if n < 8 {
            n = 8;
        }
        return peir_class_for(n);
    }
    return 0;
}

/// RT8: zero the rcx bytes asked for at rax (rounded up to 8; a block's
/// payload holds them), then ret. Up to 32 bytes: two overlapping 16-byte
/// stores (or one word); up to 2 KB a loop of 32-byte stores; beyond, rep
/// stosb (rdi kept). Clobbers rcx, rdx, r10, xmm0.
fn PeirGen_gen_zero_ret(self: &mut PeirGen) -> void {
    var small: i64 = PeirEnc_alloc_label(&mut self.enc);
    var big: i64 = PeirEnc_alloc_label(&mut self.enc);
    var rep: i64 = PeirEnc_alloc_label(&mut self.enc);
    var lp: i64 = PeirEnc_alloc_label(&mut self.enc);
    var none: i64 = PeirEnc_alloc_label(&mut self.enc);
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xC1, 0x07);
    // add rcx, 7
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xE1, 0xF8);
    // and rcx, -8
    PeirEnc_cmp_r_imm(&mut self.enc, PEIR_RCX, 16);
    PeirEnc_jcc_label(&mut self.enc, 0x2, small);
    // jb
    PeirEnc_cmp_r_imm(&mut self.enc, PEIR_RCX, 32);
    PeirEnc_jcc_label(&mut self.enc, 0x7, big);
    // ja
    pe_emit3(&mut self.enc, 0x0F, 0x57, 0xC0);
    // xorps xmm0, xmm0
    pe_emit3(&mut self.enc, 0x0F, 0x11, 0x00);
    // movups [rax], xmm0
    pe_emit4(&mut self.enc, 0x0F, 0x11, 0x44, 0x08);
    PeirEnc_emit_u8(&mut self.enc, 0xF0);
    // movups [rax + rcx - 16], xmm0
    PeirEnc_ret(&mut self.enc);
    // 0 or 8 bytes
    PeirEnc_place_label(&mut self.enc, small);
    PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, none);
    // jz
    pe_emit3(&mut self.enc, 0x48, 0xC7, 0x00);
    PeirEnc_emit_i32(&mut self.enc, 0);
    // mov qword [rax], 0
    PeirEnc_place_label(&mut self.enc, none);
    PeirEnc_ret(&mut self.enc);
    // 40 bytes to 2 KB: [rax, rax + rcx - 32) by 32, then the last 32
    PeirEnc_place_label(&mut self.enc, big);
    PeirEnc_cmp_r_imm(&mut self.enc, PEIR_RCX, 2048);
    PeirEnc_jcc_label(&mut self.enc, 0x7, rep);
    // ja
    pe_emit3(&mut self.enc, 0x0F, 0x57, 0xC0);
    // xorps xmm0, xmm0
    pe_emit4(&mut self.enc, 0x48, 0x8D, 0x54, 0x08);
    PeirEnc_emit_u8(&mut self.enc, 0xE0);
    // lea rdx, [rax + rcx - 32]
    PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, lp);
    pe_emit4(&mut self.enc, 0x41, 0x0F, 0x11, 0x02);
    // movups [r10], xmm0
    pe_emit4(&mut self.enc, 0x41, 0x0F, 0x11, 0x42);
    PeirEnc_emit_u8(&mut self.enc, 0x10);
    // movups [r10 + 16], xmm0
    pe_emit4(&mut self.enc, 0x49, 0x83, 0xC2, 0x20);
    // add r10, 32
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R10, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x2, lp);
    // jb
    pe_emit3(&mut self.enc, 0x0F, 0x11, 0x02);
    // movups [rdx], xmm0
    pe_emit4(&mut self.enc, 0x0F, 0x11, 0x42, 0x10);
    // movups [rdx + 16], xmm0
    PeirEnc_ret(&mut self.enc);
    // Past 2 KB: rep stosb
    PeirEnc_place_label(&mut self.enc, rep);
    PeirEnc_push(&mut self.enc, PEIR_RDI);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDI, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    pe_emit2(&mut self.enc, 0x31, 0xC0);
    // xor eax, eax
    pe_emit2(&mut self.enc, 0xF3, 0xAA);
    // rep stosb
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_pop(&mut self.enc, PEIR_RDI);
    PeirEnc_ret(&mut self.enc);
}

/// p_malloc / p_malloc_uninit (RT8) of the normal Windows build, from its
/// label: rcx = size -> rax = the payload. `zero`: a reused block's bytes
/// asked for are zeroed (fresh chunk memory and the system heap's large
/// blocks read zero already); p_malloc_uninit leaves them as they are.
/// The fast path is a leaf with no frame and no call: the class and its
/// bytes from the tables in the allocator state (requests up to
/// PEIR_SMALL_MAX; bsr past them), the list array from the TEB, a pop of
/// the class's list or a bump in the thread's chunk. Registers: rcx the
/// size, r8 the class, r11 its bytes, r9 the list array.
fn PeirGen_gen_malloc_body(self: &mut PeirGen, zero: bool) -> void {
    var abase: i64 = self.alloc_rdata_off;
    var mid: i64 = PeirEnc_alloc_label(&mut self.enc);
    var whole: i64 = PeirEnc_alloc_label(&mut self.enc);
    var have_cls: i64 = PeirEnc_alloc_label(&mut self.enc);
    var lim_slow: i64 = PeirEnc_alloc_label(&mut self.enc);
    var after_lim: i64 = PeirEnc_alloc_label(&mut self.enc);
    var pop: i64 = PeirEnc_alloc_label(&mut self.enc);
    var refill: i64 = PeirEnc_alloc_label(&mut self.enc);
    var dloop: i64 = PeirEnc_alloc_label(&mut self.enc);
    var ddone: i64 = PeirEnc_alloc_label(&mut self.enc);
    var bump: i64 = PeirEnc_alloc_label(&mut self.enc);
    var new_chunk: i64 = PeirEnc_alloc_label(&mut self.enc);
    var recommit: i64 = PeirEnc_alloc_label(&mut self.enc);
    var oom: i64 = PeirEnc_alloc_label(&mut self.enc);
    var large: i64 = PeirEnc_alloc_label(&mut self.enc);
    var lout: i64 = PeirEnc_alloc_label(&mut self.enc);

    // --- r8 = class, r11 = its block bytes: from the tables up to
    // PEIR_SMALL_MAX bytes (a negative size is a huge unsigned one: the
    // system heap refuses it, NULL)
    PeirEnc_cmp_r_imm(&mut self.enc, PEIR_RCX, PEIR_SMALL_MAX);
    PeirEnc_jcc_label(&mut self.enc, 0x7, mid);
    // ja (unsigned)
    PeirEnc_lea_base_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 15);
    pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x03);
    // shr rax, 3
    PeirEnc_lea_rip(&mut self.enc, PEIR_R10, abase + PEIR_ALLOC_BYTES);
    pe_emit4(&mut self.enc, 0x45, 0x0F, 0xB6, 0x84);
    PeirEnc_emit_u8(&mut self.enc, 0x02);
    PeirEnc_emit_i32(&mut self.enc, PEIR_ALLOC_CLS - PEIR_ALLOC_BYTES);
    // movzx r8d, byte [r10 + rax + (CLS - BYTES)]
    PeirEnc_mem_op(&mut self.enc, 0x8B, PEIR_R11, true, PEIR_R10, PEIR_R8, 0);
    // mov r11, [r10 + r8 * 8]
    PeirEnc_place_label(&mut self.enc, have_cls);

    // --- P12: FID_MEM_LIMIT counts the block (r11 bytes), out of line
    var has_lim: bool = HashMap_contains(self.func_labels, "pert_lim_take");
    if has_lim {
        if HashMap_contains(self.global_rdata_offsets, "pe_lim_mem") {
            PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, HashMap_get(self.global_rdata_offsets, "pe_lim_mem"));
            PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
            PeirEnc_jcc_label(&mut self.enc, 0x5, lim_slow);
            // jnz
        } else {
            PeirEnc_jmp_label(&mut self.enc, lim_slow);
        }
    }
    PeirEnc_place_label(&mut self.enc, after_lim);

    // --- pop this class's list of this thread's free blocks: no lock
    PeirGen_gen_my_lists(self, abase);
    PeirEnc_mem_op(&mut self.enc, 0x8B, PEIR_RAX, true, PEIR_R9, PEIR_R8, 0);
    // mov rax, [r9 + r8 * 8]
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, refill);
    // jz
    PeirEnc_place_label(&mut self.enc, pop);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_mem_op(&mut self.enc, 0x89, PEIR_RDX, true, PEIR_R9, PEIR_R8, 0);
    // mov [r9 + r8 * 8], rdx
    // RT7: r11 bytes fewer on this thread's lists
    PeirEnc_mem_op(&mut self.enc, 0x29, PEIR_R11, true, PEIR_R9, -1, PEIR_PT_FREE);
    // sub [r9 + FREE], r11
    // The header again (rdx keeps the freed one)
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_RAX, -8);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, PEIR_BLOCK_MAGIC);
    PeirEnc_or_rr(&mut self.enc, PEIR_R10, PEIR_R8);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, -8, PEIR_R10);
    // RT7: bit 7 of the freed header: a trim gave its inside pages back
    pe_emit3(&mut self.enc, 0xF6, 0xC2, 0x80);
    // test dl, 0x80
    PeirEnc_jcc_label(&mut self.enc, 0x5, recommit);
    // jnz
    if zero {
        PeirGen_gen_zero_ret(self);
    } else {
        PeirEnc_ret(&mut self.enc);
    }

    // --- the class's list is empty: first what other threads freed of
    // this thread's chunks (RT8, its owner slot), then a bump
    PeirEnc_place_label(&mut self.enc, refill);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R10, PEIR_R9, PEIR_PT_SLOT);
    PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    PeirEnc_jcc_label(&mut self.enc, 0x4, bump);
    // jz: no slot
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, bump);
    // jz: nothing on it
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    pe_emit3(&mut self.enc, 0x49, 0x87, 0x02);
    // xchg [r10], rax: the whole list, the slot empty again
    PeirEnc_push(&mut self.enc, PEIR_RCX);
    PeirEnc_place_label(&mut self.enc, dloop);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, ddone);
    // jz
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    // rdx = the next block; r10 = this one's class (its freed header)
    pe_emit4(&mut self.enc, 0x44, 0x0F, 0xB6, 0x50);
    PeirEnc_emit_u8(&mut self.enc, 0xF8);
    // movzx r10d, byte [rax - 8]
    pe_emit4(&mut self.enc, 0x41, 0x83, 0xE2, 0x3F);
    // and r10d, 63
    PeirEnc_mem_op(&mut self.enc, 0x8B, PEIR_RCX, true, PEIR_R9, PEIR_R10, 0);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mem_op(&mut self.enc, 0x89, PEIR_RAX, true, PEIR_R9, PEIR_R10, 0);
    // on its list; its bytes counted on this thread's
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, abase + PEIR_ALLOC_BYTES);
    PeirEnc_mem_op(&mut self.enc, 0x8B, PEIR_RCX, true, PEIR_RCX, PEIR_R10, 0);
    PeirEnc_mem_op(&mut self.enc, 0x01, PEIR_RCX, true, PEIR_R9, -1, PEIR_PT_FREE);
    // add [r9 + FREE], rcx
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_jmp_label(&mut self.enc, dloop);
    PeirEnc_place_label(&mut self.enc, ddone);
    PeirEnc_pop(&mut self.enc, PEIR_RCX);
    PeirEnc_mem_op(&mut self.enc, 0x8B, PEIR_RAX, true, PEIR_R9, PEIR_R8, 0);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pop);
    // jnz

    // --- bump in this thread's own chunk (RT7): no lock, no atomic. No
    // chunk: cursor and end are 0, so cursor + r11 > end
    PeirEnc_place_label(&mut self.enc, bump);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R9, PEIR_PT_CUR);
    PeirEnc_lea_base_index(&mut self.enc, PEIR_RDX, PEIR_RAX, PEIR_R11, 0);
    PeirEnc_mem_op(&mut self.enc, 0x3B, PEIR_RDX, true, PEIR_R9, -1, PEIR_PT_END);
    // cmp rdx, [r9 + END]
    PeirEnc_jcc_label(&mut self.enc, 0x7, new_chunk);
    // ja: the chunk is full
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R9, PEIR_PT_CUR, PEIR_RDX);
    // A new block at rax (fresh pages read zero): its header
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, PEIR_BLOCK_MAGIC);
    PeirEnc_or_rr(&mut self.enc, PEIR_RDX, PEIR_R8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RDX);
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xC0, 0x08);
    // add rax, 8
    PeirEnc_ret(&mut self.enc);

    // --- a new chunk for this thread: pert_alloc_chunk(env 0, the
    // allocator state, the list array) retires the old one, maps 4 MB and
    // sets the cursor; 0: no memory. Entry rsp is 8 mod 16: five pushes
    // and the shadow space align it.
    PeirEnc_place_label(&mut self.enc, new_chunk);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_RCX);
    PeirEnc_push(&mut self.enc, PEIR_R8);
    PeirEnc_push(&mut self.enc, PEIR_R11);
    PeirEnc_push(&mut self.enc, PEIR_R9);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_lea_rip(&mut self.enc, PEIR_RDX, abase);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R9);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirGen_call_runtime(self, "pert_alloc_chunk");
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_R9);
    PeirEnc_pop(&mut self.enc, PEIR_R11);
    PeirEnc_pop(&mut self.enc, PEIR_R8);
    PeirEnc_pop(&mut self.enc, PEIR_RCX);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, bump);
    // jnz: bump again, in the new chunk
    PeirEnc_place_label(&mut self.enc, oom);
    // no memory: NULL (the caller crashes on use, as before)
    PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);

    // --- RT7: pert_alloc_recommit(env 0, list array, payload, block
    // bytes) commits its pages again and zeroes the rest (both kinds);
    // 0: no memory
    PeirEnc_place_label(&mut self.enc, recommit);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_RAX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R9);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_R11);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirGen_call_runtime(self, "pert_alloc_recommit");
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_pop(&mut self.enc, PEIR_RAX);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_jcc_label(&mut self.enc, 0x4, oom);
    // jz (pop keeps the flags)
    PeirEnc_ret(&mut self.enc);

    // --- P12 out of line: pert_lim_take(env 0, r11 bytes), the size,
    // class and bytes kept. Five pushes align rsp.
    if has_lim {
        PeirEnc_place_label(&mut self.enc, lim_slow);
        PeirEnc_push(&mut self.enc, PEIR_RBP);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
        PeirEnc_push(&mut self.enc, PEIR_RCX);
        PeirEnc_push(&mut self.enc, PEIR_R8);
        PeirEnc_push(&mut self.enc, PEIR_R11);
        PeirEnc_push(&mut self.enc, PEIR_RAX);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R11);
        PeirGen_gen_lim_call(self, "pert_lim_take");
        PeirEnc_pop(&mut self.enc, PEIR_RAX);
        PeirEnc_pop(&mut self.enc, PEIR_R11);
        PeirEnc_pop(&mut self.enc, PEIR_R8);
        PeirEnc_pop(&mut self.enc, PEIR_RCX);
        PeirEnc_pop(&mut self.enc, PEIR_RBP);
        PeirEnc_jmp_label(&mut self.enc, after_lim);
    }

    // --- past the table: rdx = size + header; over 1 MB a large block
    PeirEnc_place_label(&mut self.enc, mid);
    PeirEnc_lea_base_disp(&mut self.enc, PEIR_RDX, PEIR_RCX, 8);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 1 << 20);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x7, large);
    // ja
    // b = bits(rdx - 1) (b > 10 here): class 2b, 2^b bytes, or three
    // quarters of them (class 2b - 1) when that holds rdx
    PeirEnc_lea_base_disp(&mut self.enc, PEIR_RAX, PEIR_RDX, -1);
    pe_emit4(&mut self.enc, 0x48, 0x0F, 0xBD, 0xC0);
    // bsr rax, rax
    pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC0);
    // inc rax
    PeirEnc_push(&mut self.enc, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R11, 1);
    PeirEnc_shl_cl(&mut self.enc, PEIR_R11);
    PeirEnc_lea_base_index(&mut self.enc, PEIR_R8, PEIR_RAX, PEIR_RAX, 0);
    // lea r8, [rax + rax]
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R11);
    pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x02);
    // shr rax, 2
    PeirEnc_lea_base_index(&mut self.enc, PEIR_RAX, PEIR_RAX, PEIR_RAX, 1);
    // lea rax, [rax + rax * 2]
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x7, whole);
    // ja
    PeirEnc_mov_rr(&mut self.enc, PEIR_R11, PEIR_RAX);
    pe_emit3(&mut self.enc, 0x49, 0xFF, 0xC8);
    // dec r8
    PeirEnc_place_label(&mut self.enc, whole);
    PeirEnc_pop(&mut self.enc, PEIR_RCX);
    PeirEnc_jmp_label(&mut self.enc, have_cls);

    // --- a large block (rdx bytes with its header): the system heap's,
    // zeroed by it for p_malloc. Entry rsp is 8 mod 16: two pushes and 40
    // align it, with shadow space.
    PeirEnc_place_label(&mut self.enc, large);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_RDX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    // P12: FID_MEM_LIMIT counts its bytes (what HeapSize gives back in
    // p_free)
    PeirGen_gen_lim_call(self, "pert_lim_take");
    PeirGen_gen_process_heap(self, abase);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    if zero {
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, 8);
        // HEAP_ZERO_MEMORY
    } else {
        PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    }
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R8, PEIR_RBP, -8);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_HEAP_ALLOC));
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, lout);
    // jz
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, PEIR_BLOCK_MAGIC | PEIR_CLASS_LARGE);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R8);
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xC0, 0x08);
    // add rax, 8
    PeirEnc_place_label(&mut self.enc, lout);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// RT8: __p_malloc_uninit(rcx = size) -> rax, what core's p_malloc_uninit
/// runs here (PeirGen_resolve_call): a block exactly as p_malloc's
/// (same kind, freed by p_free, the same FID_MEM_LIMIT count) whose bytes
/// are left as they are. Only core and the runtimes call it, for buffers
/// they write in full. Under --leaks, --checked-alloc and in a bare build
/// it is p_malloc (whose blocks read zero: the same, and every block
/// tracked or guarded).
pub fn PeirGen_gen_malloc_uninit(self: &mut PeirGen) -> void {
    if !HashMap_contains(self.func_labels, "__p_malloc_uninit") {
        return;
    }
    PeirGen_place_fn(self, "__p_malloc_uninit");
    if self.bare_mode || g_pe_checked_alloc || (g_pe_leaks && !g_pe_uefi) {
        PeirEnc_jmp_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
        return;
    }
    PeirGen_gen_malloc_body(self, false);
}

/// p_malloc(rcx = size) -> rax = ptr. Power-of-two blocks up to 1 MB (and
/// three quarters of one), as in the C runtime: an 8-byte header, reused
/// through the thread's free lists, refilled by a bump in the thread's own
/// 4 MB chunk (RT7: no lock, no atomic; a chunk's blocks are in its
/// 4 MB-aligned range, so stdlib/pe_runtime/conc.fd pert_alloc_trim can
/// find and release a chunk whose blocks are all free). Larger blocks are
/// HeapAlloc's. A full chunk: pert_alloc_chunk maps the next one. A reused
/// block whose inside pages a trim decommitted: pert_alloc_recommit. RT8:
/// the fast path is a leaf (PeirGen_gen_malloc_body), a reused block is
/// zeroed in the bytes asked for, and a thread takes back the blocks
/// other threads freed of its chunks before it bumps.
pub fn PeirGen_gen_malloc(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_malloc");
    PeirEnc_place_label(&mut self.enc, label);

    // RL16: under --leaks p_malloc is a thunk into pert_leak_malloc(env 0,
    // size), and the allocator below (normal or --checked-alloc) becomes
    // pe_lk_raw_malloc. The thunk keeps a frame record (the runtime's stack
    // walk skips it by name) and clobbers only volatile registers, as the
    // allocator's slow path (HeapAlloc) already does. Calling the label
    // makes PeirGen_gen_on_demand generate pert_leak_malloc.
    if g_pe_leaks && !self.bare_mode && !g_pe_uefi {
        PeirGen_gen_leak_thunk(self, "pert_leak_malloc");
        PeirGen_place_fn(self, "pe_lk_raw_malloc");
    }

    if self.bare_mode {
        // Bump allocator from g_pe_bare_heap; the cursor is the first word
        // of the allocator state in .rdata. Blocks are 16-byte aligned.
        var have: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, self.alloc_rdata_off);
        PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_jcc_label(&mut self.enc, 0x5, have);
        // jnz
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, g_pe_bare_heap);
        PeirEnc_place_label(&mut self.enc, have);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xC2, 0x0F);
        // add rdx, 15
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xE2, 0xF0);
        // and rdx, -16
        PeirEnc_add_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        var oom: i64 = PeirEnc_alloc_label(&mut self.enc);
        if g_pe_uefi {
            // UEFI: the heap has an end (+8): past it, a panic
            pe_emit3(&mut self.enc, 0x48, 0x3B, 0x15);
            // cmp rdx, [rip + end]
            var end_at: i64 = self.enc.code.len();
            PeirEnc_add_rip_ref(&mut self.enc, end_at, self.alloc_rdata_off + 8);
            pe_emit4(&mut self.enc, 0, 0, 0, 0);
            PeirEnc_jcc_label(&mut self.enc, 0x7, oom);
            // ja
        }
        PeirEnc_mov_rip_reg(&mut self.enc, self.alloc_rdata_off, PEIR_RDX);
        PeirEnc_ret(&mut self.enc);
        if g_pe_uefi {
            PeirEnc_place_label(&mut self.enc, oom);
            PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "out of memory"));
            PeirEnc_jmp_label(&mut self.enc, HashMap_get(self.func_labels, "p_panic"));
        }
    } else if g_pe_checked_alloc {
        PeirGen_gen_checked_malloc(self);
    } else {
        PeirGen_gen_malloc_body(self, true);
    }
}

/// p_free(rcx = ptr): back on its class's free list, or to the system heap
/// when large. Panics unless it is a live block. RT7: past the thread's
/// threshold of free bytes, pert_alloc_trim gives memory back to the system.
/// RT8: a block of another thread's chunk goes back to that thread (its
/// owner slot); the path to this thread's lists is a leaf with no frame.
pub fn PeirGen_gen_free(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_free");
    PeirEnc_place_label(&mut self.enc, label);

    // RL16: under --leaks p_free is a thunk into pert_leak_free(env 0, p);
    // the code below becomes pe_lk_raw_free (as in PeirGen_gen_malloc)
    if g_pe_leaks && !self.bare_mode && !g_pe_uefi {
        PeirGen_gen_leak_thunk(self, "pert_leak_free");
        PeirGen_place_fn(self, "pe_lk_raw_free");
    }

    if self.bare_mode {
        // The bump allocator never reuses memory
        PeirEnc_ret(&mut self.enc);
    } else {
        var abase: i64 = self.alloc_rdata_off;
        var out: i64 = PeirEnc_alloc_label(&mut self.enc);
        var large: i64 = PeirEnc_alloc_label(&mut self.enc);
        var live: i64 = PeirEnc_alloc_label(&mut self.enc);
        var twice: i64 = PeirEnc_alloc_label(&mut self.enc);
        var local: i64 = PeirEnc_alloc_label(&mut self.enc);
        var local_rdx: i64 = PeirEnc_alloc_label(&mut self.enc);
        var rcas: i64 = PeirEnc_alloc_label(&mut self.enc);
        var reowner: i64 = PeirEnc_alloc_label(&mut self.enc);
        var trim: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirEnc_jcc_label(&mut self.enc, 0x4, out);
        // jz
        // rax = header, rdx = its magic
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, -8);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        pe_emit2(&mut self.enc, 0x30, 0xD2);
        // xor dl, dl
        PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, PEIR_BLOCK_MAGIC);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RDX, PEIR_R8);
        PeirEnc_jcc_label(&mut self.enc, 0x4, live);
        // je
        PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, PEIR_BLOCK_FREED);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RDX, PEIR_R8);
        PeirEnc_jcc_label(&mut self.enc, 0x4, twice);
        // je
        // The panic stubs expect a function body's aligned stack
        PeirEnc_sub_rsp_i32(&mut self.enc, 8);
        PeirEnc_jmp_label(&mut self.enc, self.arith_panics.get(PEIR_PANIC_BAD_FREE));
        PeirEnc_place_label(&mut self.enc, twice);
        PeirEnc_sub_rsp_i32(&mut self.enc, 8);
        PeirEnc_jmp_label(&mut self.enc, self.arith_panics.get(PEIR_PANIC_DOUBLE_FREE));
        PeirEnc_place_label(&mut self.enc, live);
        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, PEIR_BLOCK_FREED);
        PeirEnc_or_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, -8, PEIR_RDX);
        var checked_free: i64 = PeirEnc_alloc_label(&mut self.enc);
        if g_pe_checked_alloc {
            PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, PEIR_CLASS_CHECKED);
            PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
            PeirEnc_jcc_label(&mut self.enc, 0x4, checked_free);
            // je
        }
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, PEIR_CLASS_LARGE);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
        PeirEnc_jcc_label(&mut self.enc, 0x4, large);
        // je
        // A class block (rax = its class). P12: FID_MEM_LIMIT gets its
        // bytes back, out of the way of the fast path: rbp, rax and rcx on
        // the stack align it (entry rsp is 8 mod 16)
        if HashMap_contains(self.func_labels, "pert_lim_give") {
            var no_lim: i64 = PeirEnc_alloc_label(&mut self.enc);
            if HashMap_contains(self.global_rdata_offsets, "pe_lim_mem") {
                PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RDX, HashMap_get(self.global_rdata_offsets, "pe_lim_mem"));
                PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
                PeirEnc_jcc_label(&mut self.enc, 0x4, no_lim);
                // jz
            }
            PeirEnc_push(&mut self.enc, PEIR_RBP);
            PeirEnc_push(&mut self.enc, PEIR_RAX);
            PeirEnc_push(&mut self.enc, PEIR_RCX);
            PeirEnc_lea_rip(&mut self.enc, PEIR_RDX, abase + PEIR_ALLOC_BYTES);
            PeirEnc_mem_op(&mut self.enc, 0x8B, PEIR_RDX, true, PEIR_RDX, PEIR_RAX, 0);
            PeirGen_gen_lim_call(self, "pert_lim_give");
            PeirEnc_pop(&mut self.enc, PEIR_RCX);
            PeirEnc_pop(&mut self.enc, PEIR_RAX);
            PeirEnc_pop(&mut self.enc, PEIR_RBP);
            PeirEnc_place_label(&mut self.enc, no_lim);
        }
        // r9 = this thread's list array (rax and rcx kept)
        PeirGen_gen_my_lists(self, abase);
        // RT8, owner return: r10 = the owner slot of the block's chunk (its
        // 4 MB-aligned start, header word 64); this thread's own, or none:
        // its lists
        PeirEnc_lea_base_disp(&mut self.enc, PEIR_R10, PEIR_RCX, -8);
        pe_emit3(&mut self.enc, 0x49, 0x81, 0xE2);
        PeirEnc_emit_i32(&mut self.enc, 0 - 4194304);
        // and r10, -4 MB
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R10, PEIR_R10, PEIR_CHUNK_OWNER);
        PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
        PeirEnc_jcc_label(&mut self.enc, 0x4, local);
        // jz
        PeirEnc_mem_op(&mut self.enc, 0x3B, PEIR_R10, true, PEIR_R9, -1, PEIR_PT_SLOT);
        // cmp r10, [r9 + SLOT]
        PeirEnc_jcc_label(&mut self.enc, 0x4, local);
        // je
        // Another thread's: push the block on its slot (rdx keeps the
        // class). A closed slot (1): its thread ended, read the chunk's
        // slot again (now the pool's)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R10);
        PeirEnc_place_label(&mut self.enc, rcas);
        PeirEnc_cmp_r_imm(&mut self.enc, PEIR_RAX, 1);
        PeirEnc_jcc_label(&mut self.enc, 0x4, reowner);
        // je
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // the link
        pe_emit4(&mut self.enc, 0xF0, 0x49, 0x0F, 0xB1);
        PeirEnc_emit_u8(&mut self.enc, 0x0A);
        // lock cmpxchg [r10], rcx (rax: what it holds when that failed)
        PeirEnc_jcc_label(&mut self.enc, 0x5, rcas);
        // jnz
        PeirEnc_ret(&mut self.enc);
        PeirEnc_place_label(&mut self.enc, reowner);
        PeirEnc_lea_base_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, -8);
        pe_emit2(&mut self.enc, 0x48, 0x25);
        PeirEnc_emit_i32(&mut self.enc, 0 - 4194304);
        // and rax, -4 MB
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RAX, PEIR_CHUNK_OWNER);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
        PeirEnc_jcc_label(&mut self.enc, 0x4, local_rdx);
        // je: still that slot, keep the block here
        PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_RAX);
        PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
        PeirEnc_jcc_label(&mut self.enc, 0x4, local_rdx);
        PeirEnc_mem_op(&mut self.enc, 0x3B, PEIR_R10, true, PEIR_R9, -1, PEIR_PT_SLOT);
        PeirEnc_jcc_label(&mut self.enc, 0x4, local_rdx);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R10);
        PeirEnc_jmp_label(&mut self.enc, rcas);
        PeirEnc_place_label(&mut self.enc, local_rdx);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
        // On this thread's list of the class: no lock (release H8)
        PeirEnc_place_label(&mut self.enc, local);
        PeirEnc_mem_op(&mut self.enc, 0x8B, PEIR_RDX, true, PEIR_R9, PEIR_RAX, 0);
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RCX, PEIR_RDX);
        PeirEnc_mem_op(&mut self.enc, 0x89, PEIR_RCX, true, PEIR_R9, PEIR_RAX, 0);
        // RT7: its bytes more on this thread's lists; past the threshold,
        // pert_alloc_trim(env 0, the allocator state, the list array)
        // (stdlib/pe_runtime/conc.fd) gives memory back to the system
        PeirEnc_lea_rip(&mut self.enc, PEIR_RDX, abase + PEIR_ALLOC_BYTES);
        PeirEnc_mem_op(&mut self.enc, 0x8B, PEIR_RDX, true, PEIR_RDX, PEIR_RAX, 0);
        PeirEnc_mem_op(&mut self.enc, 0x03, PEIR_RDX, true, PEIR_R9, -1, PEIR_PT_FREE);
        // add rdx, [r9 + FREE]
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R9, PEIR_PT_FREE, PEIR_RDX);
        PeirEnc_mem_op(&mut self.enc, 0x3B, PEIR_RDX, true, PEIR_R9, -1, PEIR_PT_NEXT);
        // cmp rdx, [r9 + NEXT]
        PeirEnc_jcc_label(&mut self.enc, 0x7, trim);
        // ja (unsigned)
        PeirEnc_place_label(&mut self.enc, out);
        PeirEnc_ret(&mut self.enc);
        // entry rsp is 8 mod 16: 40 bytes align it, with shadow space
        PeirEnc_place_label(&mut self.enc, trim);
        PeirEnc_sub_rsp_i32(&mut self.enc, 40);
        PeirEnc_lea_rip(&mut self.enc, PEIR_RDX, abase);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R9);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirGen_call_runtime(self, "pert_alloc_trim");
        PeirEnc_add_rsp_i32(&mut self.enc, 40);
        PeirEnc_ret(&mut self.enc);

        // --checked-alloc: the block's pages become inaccessible, for good
        if g_pe_checked_alloc {
            PeirEnc_place_label(&mut self.enc, checked_free);
            PeirEnc_sub_rsp_i32(&mut self.enc, 56);
            PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_RCX, -16);
            PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_RCX, -24);
            PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, 1);
            // PAGE_NOACCESS
            PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RSP);
            pe_emit4(&mut self.enc, 0x49, 0x83, 0xC1, 0x28);
            // add r9, 40
            PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("VirtualProtect")));
            PeirEnc_add_rsp_i32(&mut self.enc, 56);
            PeirEnc_ret(&mut self.enc);
        }

        // A large block goes back to the system heap
        PeirEnc_place_label(&mut self.enc, large);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RCX);
        pe_emit4(&mut self.enc, 0x49, 0x83, 0xE8, 0x08);
        // sub r8, 8
        PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RCX, abase + 16);
        PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
        PeirEnc_sub_rsp_i32(&mut self.enc, 40);
        // P12: FID_MEM_LIMIT gets HeapSize(heap, 0, block) bytes back (what
        // p_malloc counted); the block waits at [rsp+32]. rsp is 16-aligned.
        if HashMap_contains(self.func_labels, "pert_lim_give") {
            var no_lim: i64 = PeirEnc_alloc_label(&mut self.enc);
            PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_R8);
            if HashMap_contains(self.global_rdata_offsets, "pe_lim_mem") {
                PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, HashMap_get(self.global_rdata_offsets, "pe_lim_mem"));
                PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                PeirEnc_jcc_label(&mut self.enc, 0x4, no_lim);
                // jz
            }
            PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("HeapSize")));
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
            PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "pert_lim_give"));
            PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R8, PEIR_RSP, 32);
            PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RCX, abase + 16);
            PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
            PeirEnc_place_label(&mut self.enc, no_lim);
        }
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_HEAP_FREE));
        PeirEnc_add_rsp_i32(&mut self.enc, 40);
        PeirEnc_ret(&mut self.enc);
    }
}

/// p_memset(rcx=ptr, rdx=val, r8=size) — fill memory with val for size bytes
pub fn PeirGen_gen_memset(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_memset");
    PeirEnc_place_label(&mut self.enc, label);
    // rcx = ptr, rdx = val (byte), r8 = size
    // Simple byte-by-byte loop: while r8 > 0 { *rcx = dl; rcx++; r8-- }
    var loop_start: i64 = PeirEnc_alloc_label(&mut self.enc);
    var loop_end: i64 = PeirEnc_alloc_label(&mut self.enc);
    // if size <= 0, skip
    PeirEnc_test_rr(&mut self.enc, PEIR_R8, PEIR_R8);
    PeirEnc_jcc_label(&mut self.enc, 0x4, loop_end);
    // jz -> end
    PeirEnc_place_label(&mut self.enc, loop_start);
    // Store byte: mov byte [rcx], dl
    pe_emit2(&mut self.enc, 0x88, 0x11);
    // mov [rcx], dl
    // rcx++
    pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC1);
    // inc rcx
    // r8-- (REX.B selects r8)
    pe_emit3(&mut self.enc, 0x49, 0xFF, 0xC8);
    // dec r8
    // if r8 != 0, loop
    PeirEnc_test_rr(&mut self.enc, PEIR_R8, PEIR_R8);
    PeirEnc_jcc_label(&mut self.enc, 0x5, loop_start);
    // jnz -> loop_start
    PeirEnc_place_label(&mut self.enc, loop_end);
    PeirEnc_ret(&mut self.enc);
}

/// p_str_concat(rcx=left *u8, rdx=right *u8) -> rax=*u8
/// Each length is counted once by msvcrt strlen and both halves copy in bulk
/// via memcpy - not byte-by-byte loops (pe-roadmap item 73).
/// rax = the length of the string at rcx: its header's (a length-headered
/// string or literal, release D16), else strlen through the import table.
/// Uses rax, r10 (and what strlen uses).
fn PeirGen_emit_slen(self: &mut PeirGen, strlen_off: i64) -> void {
    var zero: i64 = PeirEnc_alloc_label(&mut self.enc);
    var check: i64 = PeirEnc_alloc_label(&mut self.enc);
    var plain: i64 = PeirEnc_alloc_label(&mut self.enc);
    var done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, zero);
    // jz
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, -16);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, 0x4649444553545201);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_jcc_label(&mut self.enc, 0x4, check);
    // je
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, 0x4649444553545202);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_jcc_label(&mut self.enc, 0x4, check);
    // je
    // A counted string (proposal 0004): P_STR_RC + count, count < 2^30,
    // and P_STR_ROOM (bit 31) on one p_str_append grew in place (2g.41):
    // the rule of core's p_str_count_of, word - P_STR_RC below 2^32 with
    // bit 30 clear; the length word below is still checked
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, 0x4649444500000000);
    PeirEnc_sub_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, 0x100000000);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_jcc_label(&mut self.enc, 0x3, plain);
    // jae (unsigned)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, 0x40000000);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_jcc_label(&mut self.enc, 0x5, plain);
    // jnz: bit 30 set is not a count (P_STR_DEAD's word lands here)
    PeirEnc_place_label(&mut self.enc, check);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, -8);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x8, plain);
    // js
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, 0x10000000000);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_jcc_label(&mut self.enc, 0x2, done);
    // jb: a length
    PeirEnc_place_label(&mut self.enc, plain);
    PeirEnc_call_rip(&mut self.enc, strlen_off);
    PeirEnc_jmp_label(&mut self.enc, done);
    PeirEnc_place_label(&mut self.enc, zero);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, done);
}

pub fn PeirGen_gen_str_concat(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_str_concat");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_push(&mut self.enc, PEIR_R15);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    // 32 shadow + 16 locals

    // r12 = left, r13 = right
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);

    var strlen_off: i64 = PeirGen_iat_off(self, pe_import_slot("strlen"));
    var memcpy_off: i64 = PeirGen_iat_off(self, pe_import_slot("memcpy"));

    // r14 = len(left); [rbp-48] = len(right): the header's length, so
    // zero bytes survive (D16), else strlen
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirGen_emit_slen(self, strlen_off);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirGen_emit_slen(self, strlen_off);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);

    // block = p_malloc(16 + len_l + len_r + 1): a length header, as core's
    // p_str_alloc writes it (release D16: [magic][len], then the bytes and
    // the terminator), so p_str_length is O(1) on the result and Str_drop
    // frees the whole block
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RCX, 17);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // [block] = a count of one owner (core's P_STR_RC + 1, proposal 0004)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, 0x4649444500000001);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 0, PEIR_R9);
    // [block + 8] = len_l + len_r
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R10, -48);
    PeirEnc_add_rr(&mut self.enc, PEIR_R10, PEIR_R14);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 8, PEIR_R10);
    // r15 = buf = block + 16
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_R15, 16);

    // memcpy(buf, left, len_l)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R14);
    PeirEnc_call_rip(&mut self.enc, memcpy_off);

    // memcpy(buf + len_l, right, len_r + 1) - +1 copies right's NUL,
    // so the result is exactly "left" + "right" + NUL.
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R8, -48);
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_call_rip(&mut self.enc, memcpy_off);

    // Return buf
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R15);

    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    PeirEnc_pop(&mut self.enc, PEIR_R15);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_to_str(rcx = i64 value) -> rax = *u8
/// Converts integer to null-terminated string, malloc'd
pub fn PeirGen_gen_to_str(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_to_str");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 72);
    // 32 shadow + 32 buf + 8 align

    // r12 = value, r13 = buffer ptr (stack at rbp-56), r14 = digit count.
    // OP21 (known-bugs 2g.96): the buffer was 16 bytes at rbp-40, under
    // the saved r14 at rbp-24: a number of 16 or more characters (i64::MIN
    // is 20 and its NUL) overwrote the caller's r14, and test_simd_i64's
    // `wrap:` line crashed. 32 bytes [rbp-56, rbp-24), above the shadow
    // space [rbp-96, rbp-64) p_malloc may write.
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R13, -56);
    PeirEnc_xor_self(&mut self.enc, PEIR_R14);

    // Handle 0 specially
    PeirEnc_test_rr(&mut self.enc, PEIR_R12, PEIR_R12);
    var ts_notzero: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, ts_notzero);
    // jnz

    // value == 0: store '0' + null
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48);
    // '0'
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    // point back to '0'
    // malloc(2), copy, return
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 2);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // rax = dest. Copy 2 bytes from r13
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_inc_r(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_dec_r(&mut self.enc, PEIR_RAX);
    var ts_zero_ret: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, ts_zero_ret);

    PeirEnc_place_label(&mut self.enc, ts_notzero);

    // Handle negative: if value < 0, negate and set sign flag
    PeirEnc_xor_self(&mut self.enc, PEIR_R8);
    // r8 = sign flag
    PeirEnc_test_rr(&mut self.enc, PEIR_R12, PEIR_R12);
    var ts_pos: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x9, ts_pos);
    // jns — positive
    // Negative: negate using xor rax,rax; sub rax,r12; mov r12,rax
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_sub_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 1);
    // sign = 1

    PeirEnc_place_label(&mut self.enc, ts_pos);

    // Extract digits in reverse
    PeirEnc_xor_self(&mut self.enc, PEIR_R14);
    // reset count
    var ts_loop2: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, ts_loop2);
    // rax = r12, divide by 10
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 10);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_div_rr(&mut self.enc, PEIR_RCX);
    // rax = r12/10, rdx = r12%10
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
    // r12 = quotient
    // Store digit
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RDX, 48);
    // '0'
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R14);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    // Loop while r12 != 0
    PeirEnc_test_rr(&mut self.enc, PEIR_R12, PEIR_R12);
    PeirEnc_jcc_label(&mut self.enc, 0x5, ts_loop2);
    // jnz

    // Add sign if needed
    PeirEnc_test_rr(&mut self.enc, PEIR_R8, PEIR_R8);
    var ts_nosign: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, ts_nosign);
    // jz — no sign
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 45);
    // '-'
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_place_label(&mut self.enc, ts_nosign);

    // Reverse the buffer (r14 digits in reverse order)
    // r12 = 0 (left index), r8 = r14-1 (right index)
    PeirEnc_xor_self(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R14);
    PeirEnc_dec_r(&mut self.enc, PEIR_R8);
    var ts_rev: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, ts_rev);
    // if r12 >= r8, done
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R12, PEIR_R8);
    var ts_revdone: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, ts_revdone);
    // jae — done
    // swap bytes at r13+r12 and r13+r8
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RCX, PEIR_RAX);
    // cl = left byte
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RDX, PEIR_RAX);
    // dl = right byte
    // Store swapped
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // inc r12, dec r8
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R8);
    PeirEnc_jmp_label(&mut self.enc, ts_rev);
    PeirEnc_place_label(&mut self.enc, ts_revdone);

    // Add null terminator at r13+r14
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R14);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 0);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    // include null in length

    // malloc(r14), copy, return
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
    // dest
    PeirEnc_xor_self(&mut self.enc, PEIR_R8);
    var ts_cp2: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, ts_cp2);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R8, PEIR_R14);
    var ts_cp2d: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, ts_cp2d);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_jmp_label(&mut self.enc, ts_cp2);
    PeirEnc_place_label(&mut self.enc, ts_cp2d);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    // return dest

    PeirEnc_place_label(&mut self.enc, ts_zero_ret);

    PeirEnc_add_rsp_i32(&mut self.enc, 72);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_to_str_str(rcx = *u8 str) -> rax = *u8
/// For strings, to_str just returns the input pointer (it's already a string)
pub fn PeirGen_gen_to_str_str(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_to_str_str");
    PeirEnc_place_label(&mut self.enc, label);
    // Just return rcx (the string pointer)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_ret(&mut self.enc);
}

/// p_to_str_bool(rcx = i64 bool) -> rax = *u8
pub fn PeirGen_gen_to_str_bool(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_to_str_bool");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);

    // if rcx == 0, return "false", else "true"
    PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    var tb_false: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tb_false);
    // jz

    // "true" — 5 bytes incl null
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 5);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // Store "true\0"
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 116);
    // 't'
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 114);
    // 'r'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 1, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 117);
    // 'u'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 2, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 101);
    // 'e'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 3, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 0);
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 4, PEIR_RCX);
    var tb_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, tb_done);

    PeirEnc_place_label(&mut self.enc, tb_false);
    // "false" — 6 bytes incl null
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 6);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 102);
    // 'f'
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 97);
    // 'a'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 1, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 108);
    // 'l'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 2, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 115);
    // 's'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 3, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 101);
    // 'e'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 4, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 0);
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 5, PEIR_RCX);

    PeirEnc_place_label(&mut self.enc, tb_done);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_to_str_float(rcx = f64 bits in i64 reg) -> rax = *u8
/// Simplified: convert to integer string (truncate decimal for now)
pub fn PeirGen_gen_to_str_float(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_to_str_float");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 280);
    // 32 shadow + 248 for locals

    // Stack layout (same as p_print_float minus WriteFile stuff):
    // [rbp-8]   = double value (input bits)
    // [rbp-16]  = 10.0 constant
    // [rbp-24]  = sign mask (0x8000000000000000)
    // [rbp-32]  = magnitude mask (0x7FFFFFFFFFFFFFFF)
    // [rbp-40]  = integer part (saved)
    // [rbp-48]  = is_negative flag
    // [rbp-56]  = fractional part (saved)
    // [rbp-64]  = 0.0 constant
    // [rbp-72]  = int_start pointer (saved)
    // [rbp-88]  = 0.5 constant
    // [rbp-280 .. rbp-89] = character buffer (192 bytes)

    // Store double bits
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -8, PEIR_RCX);

    // Store 10.0 constant (0x4024000000000000)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x4024000000000000);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);

    // Store sign mask (0x8000000000000000 = 1 << 63)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 1 << 63);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -24, PEIR_RAX);

    // Store magnitude mask
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x7FFFFFFFFFFFFFFF);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -32, PEIR_RAX);

    // Store 0.0 constant
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -64, PEIR_RAX);

    // Store 0.5 constant (0x3FE0000000000000)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x3FE0000000000000);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -88, PEIR_RAX);

    // Load xmm0 = double value
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, -8);

    // Check for zero: AND bits with magnitude mask
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -8);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, -32);
    PeirEnc_and_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var tsf_not_zero: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_not_zero);
    // jnz

    // Zero: write "0" directly
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R12, -280);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48);
    // '0'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    // r12 points past the '0'
    var tsf_alloc: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, tsf_alloc);

    PeirEnc_place_label(&mut self.enc, tsf_not_zero);

    // Check sign: test bits with sign mask
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -8);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, -24);
    PeirEnc_and_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var tsf_positive: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tsf_positive);
    // jz

    // Negative: set flag, negate value
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -24);
    PeirEnc_movq_xmm_r64(&mut self.enc, 1, PEIR_RAX);
    PeirEnc_xorpd_xmm_xmm(&mut self.enc, 0, 1);
    PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, -8, 0);
    var tsf_after_sign: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, tsf_after_sign);

    PeirEnc_place_label(&mut self.enc, tsf_positive);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);

    PeirEnc_place_label(&mut self.enc, tsf_after_sign);

    // Extract integer part: cvttsd2si rax, xmm0
    PeirEnc_cvttsd2si_r64(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -40, PEIR_RAX);
    PeirEnc_cvtsi2sd_r64(&mut self.enc, 1, PEIR_RAX);
    PeirEnc_subsd(&mut self.enc, 0, 1);
    PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, -56, 0);

    // r12 = buffer start = [rbp-280], build string FORWARD
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R12, -280);

    // If negative, store '-'
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -48);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var tsf_no_minus: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tsf_no_minus);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 45);
    // '-'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_place_label(&mut self.enc, tsf_no_minus);

    // Save int_start = r12
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -72, PEIR_R12);

    // Build integer digits forward (LSD first, will reverse later)
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -40);
    var tsf_int_nonzero: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_int_nonzero);

    // Integer part is 0: store '0'
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48);
    // '0'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    var tsf_int_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, tsf_int_done);

    PeirEnc_place_label(&mut self.enc, tsf_int_nonzero);
    var tsf_int_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tsf_int_loop);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 10);
    PeirEnc_rex(&mut self.enc, true, false, false, reg_ext(PEIR_R9));
    PeirEnc_emit_u8(&mut self.enc, 0xF7);
    PeirEnc_modrm(&mut self.enc, 3, 6, peir_reg_code(PEIR_R9));
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RDX, 48);
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RDX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_int_loop);

    PeirEnc_place_label(&mut self.enc, tsf_int_done);
    // Reverse integer digits in-place: int_start to r12-1
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R13, -72);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R14);
    var tsf_rev_check: i64 = PeirEnc_alloc_label(&mut self.enc);
    var tsf_rev_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tsf_rev_check);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R13, PEIR_R14);
    PeirEnc_jcc_label(&mut self.enc, 0x3, tsf_rev_done);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R10, PEIR_R14);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_R10);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R14, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_dec_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, tsf_rev_check);

    PeirEnc_place_label(&mut self.enc, tsf_rev_done);

    // Now add '.' if there are fractional digits
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, -56);
    PeirEnc_xorpd_xmm_xmm(&mut self.enc, 1, 1);
    PeirEnc_ucomisd(&mut self.enc, 0, 1);
    var tsf_no_frac: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tsf_no_frac);

    // Store '.'
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 46);
    // '.'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);

    // Fractional digit loop (up to 6 digits), forward
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R14, 6);
    var tsf_frac_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tsf_frac_loop);
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 1, -16);
    PeirEnc_mulsd(&mut self.enc, 0, 1);
    PeirEnc_cvttsd2si_r64(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_cvtsi2sd_r64(&mut self.enc, 1, PEIR_RAX);
    PeirEnc_subsd(&mut self.enc, 0, 1);
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RAX, 48);
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_xorpd_xmm_xmm(&mut self.enc, 1, 1);
    PeirEnc_ucomisd(&mut self.enc, 0, 1);
    var tsf_frac_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tsf_frac_done);
    PeirEnc_dec_r(&mut self.enc, PEIR_R14);
    var tsf_frac_continue: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_frac_continue);
    PeirEnc_jmp_label(&mut self.enc, tsf_frac_done);
    PeirEnc_place_label(&mut self.enc, tsf_frac_continue);
    PeirEnc_jmp_label(&mut self.enc, tsf_frac_loop);

    PeirEnc_place_label(&mut self.enc, tsf_frac_done);

    // Rounding: only if we generated 6 digits (r14 == 0) and frac >= 0.5
    PeirEnc_test_rr(&mut self.enc, PEIR_R14, PEIR_R14);
    var tsf_strip: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_strip);

    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 1, -88);
    PeirEnc_ucomisd(&mut self.enc, 0, 1);
    PeirEnc_jcc_label(&mut self.enc, 0x2, tsf_strip);

    // Rounding: increment last fractional digit at [r12-1]
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    var tsf_round_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tsf_round_loop);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RAX, 1);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 58);
    // '9' + 1
    var tsf_round_store: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_round_store);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 46);
    // '.'
    var tsf_round_skip_dot: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_round_skip_dot);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    PeirEnc_place_label(&mut self.enc, tsf_round_skip_dot);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 45);
    // '-'
    var tsf_round_stop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tsf_round_stop);
    PeirEnc_jmp_label(&mut self.enc, tsf_round_loop);

    PeirEnc_place_label(&mut self.enc, tsf_round_store);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_jmp_label(&mut self.enc, tsf_strip);

    PeirEnc_place_label(&mut self.enc, tsf_round_stop);

    PeirEnc_place_label(&mut self.enc, tsf_strip);
    // Strip trailing zeros from fractional part
    var tsf_strip_check: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tsf_strip_check);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 48);
    // '0'
    var tsf_strip_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_strip_done);
    PeirEnc_dec_r(&mut self.enc, PEIR_R12);
    PeirEnc_jmp_label(&mut self.enc, tsf_strip_check);

    PeirEnc_place_label(&mut self.enc, tsf_strip_done);
    // Check if last char is '.' — remove it
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 46);
    // '.'
    var tsf_no_strip_dot: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_no_strip_dot);
    PeirEnc_dec_r(&mut self.enc, PEIR_R12);
    PeirEnc_place_label(&mut self.enc, tsf_no_strip_dot);

    PeirEnc_place_label(&mut self.enc, tsf_no_frac);

    // r12 now points past the last char. Buffer start = [rbp-280].
    // Null-terminate at [r12]
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R12, PEIR_RAX);

    PeirEnc_place_label(&mut self.enc, tsf_alloc);
    // Calculate length: r13 = r12 - buffer_start + 1 (for null)
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R13, -280);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_sub_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    // +1 for null terminator
    // p_malloc(length)
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // Save malloc result to [rbp-72] (int_start no longer needed)
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -72, PEIR_RAX);
    // r14 = dest
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_RAX);

    // Copy buffer to dest: r13 = src, r14 = dest
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R13, -280);
    var tsf_copy_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tsf_copy_loop);
    // Check if we've reached r12
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    var tsf_copy_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, tsf_copy_done);
    // jae — done
    // Copy byte
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R14, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, tsf_copy_loop);

    PeirEnc_place_label(&mut self.enc, tsf_copy_done);
    // Null-terminate dest
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R14, PEIR_RAX);
    // Return malloc result from [rbp-72]
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -72);

    // Epilogue
    PeirEnc_add_rsp_i32(&mut self.enc, 280);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_to_str_vec(rcx = *Vec) -> rax = *u8
/// Formats vec as "[1, 2, 3]"
/// At the entry of p_to_str_vec / p_print_vec (rcx = the Vec): a Vec whose
/// elements are stored at their size (D14, element code at +24) is turned
/// into text by core's Vec_to_str (and printed); a word Vec falls through.
fn PeirGen_sized_vec_to_core(self: &mut PeirGen, print: bool) -> void {
    if !HashMap_contains(self.func_labels, "Vec_to_str") {
        return;
    }
    var words: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, words);
    // jz
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 24);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, words);
    // jz: a word Vec
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    // realign, shadow space
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "Vec_to_str"));
    if print {
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_str"));
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    }
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, words);
}

pub fn PeirGen_gen_to_str_vec(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_to_str_vec");
    PeirEnc_place_label(&mut self.enc, label);
    PeirGen_sized_vec_to_core(self, false);

    // Prologue: push rbp + 4 callee-saved = 5 pushes = 40 bytes
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    // vec ptr
    PeirEnc_push(&mut self.enc, PEIR_R13);
    // element index
    PeirEnc_push(&mut self.enc, PEIR_R14);
    // len
    PeirEnc_push(&mut self.enc, PEIR_R15);
    // result string
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    // 32 shadow + 8 align

    // r12 = vec ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);

    // Start with "[" — malloc 2 bytes, store '[', '\0'
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 2);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);
    // r15 = result
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 91);
    // '['
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R15, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 0);
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_R15, 1, PEIR_RCX);

    // r13 = 0 (index), r14 = len = [r12 + 8]
    PeirEnc_xor_self(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R14, PEIR_R12, 8);

    // Loop: for each element
    var tv_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tv_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R13, PEIR_R14);
    var tv_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, tv_done);
    // jae — done

    // If index > 0, append ", "
    PeirEnc_test_rr(&mut self.enc, PEIR_R13, PEIR_R13);
    var tv_first: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tv_first);
    // jz — first element
    // Build ", \0" on stack at [rbp-16]
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 44);
    // ','
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 32);
    // ' '
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -15, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -14, PEIR_RAX);
    // r15 = p_str_concat(r15, &[rbp-16])
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -16);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, tv_first);

    // Get element: buf = [r12], element = buf[r13*8]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    // rax = buf ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    // rcx = element

    // Call p_to_str(element) -> rax = string
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_to_str"));

    // Append to result: r15 = p_str_concat(r15, rax)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);

    // inc r13, loop
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_jmp_label(&mut self.enc, tv_loop);

    PeirEnc_place_label(&mut self.enc, tv_done);
    // Append "]" — build "]\0" on stack at [rbp-16]
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 93);
    // ']'
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -15, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -16);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    // rax = result

    // Epilogue
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R15);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// Vec runtime stubs — Vec layout: { ptr: *u8, len: i64, cap: i64 } = 24 bytes
// ===========================================================================

/// p_vec_new() -> rax = *Vec (32-byte heap struct, all zeros)
pub fn PeirGen_gen_vec_new(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_new");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);

    // malloc(32) — shadow space already in the 48 bytes
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));

    // Zero out 32 bytes: data, len, cap, element code (D14: 0, a word)
    PeirEnc_xor_self(&mut self.enc, PEIR_RCX);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 8, PEIR_RCX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 16, PEIR_RCX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 24, PEIR_RCX);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_push(rcx=*Vec, rdx=i64 value)
pub fn PeirGen_gen_vec_push(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_push");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);

    // Save args: r12 = vec ptr (rcx), r13 = value (rdx)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);

    // Read len = [r12 + 8], cap = [r12 + 16]
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R14, PEIR_R12, 8);
    // r14 = len
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 16);
    // rax = cap

    // if len < cap, skip grow
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R14, PEIR_RAX);
    var vp_nogrow: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x2, vp_nogrow);
    // jb — len < cap

    // Need to grow: new_cap = cap == 0 ? 4 : cap * 2
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var vp_newcap: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, vp_newcap);
    // jnz — cap != 0
    // cap == 0: new_cap = 4
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 4);
    var vp_alloc: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, vp_alloc);

    PeirEnc_place_label(&mut self.enc, vp_newcap);
    // cap != 0: newcap = cap * 2
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 1);

    PeirEnc_place_label(&mut self.enc, vp_alloc);
    // Save new_cap at [rbp-16] (RAX is volatile, clobbered by p_malloc)
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);
    // malloc(new_cap * 8)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 3);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // Save new buffer at [rbp-24] (RAX is volatile)
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -24, PEIR_RAX);

    // Copy old data: old_ptr = [r12], copy len elements
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R10, PEIR_R12);
    // r10 = old ptr
    PeirEnc_xor_self(&mut self.enc, PEIR_R11);
    // r11 = 0 (index)
    var vp_copy: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, vp_copy);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R11, PEIR_R14);
    var vp_copydone: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, vp_copydone);
    // jae — done
    // load old[i]: rax = r11 * 8; rax += r10; rcx = [rax]
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R11);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    // store to new[i]: rax = r11 * 8; rax += new_buf; [rax] = rcx
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R9, -24);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R11);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R9);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R11);
    PeirEnc_jmp_label(&mut self.enc, vp_copy);
    PeirEnc_place_label(&mut self.enc, vp_copydone);

    // Free old buffer if non-null
    PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    var vp_nofree: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, vp_nofree);
    // jz — null, skip free
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R10);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_free"));
    PeirEnc_place_label(&mut self.enc, vp_nofree);

    // Update vec.ptr = new_buf, vec.cap = new_cap
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -24);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_R12, PEIR_RAX);
    // [r12] = new_buf
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -16);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 16, PEIR_RAX);
    // [r12+16]

    PeirEnc_place_label(&mut self.enc, vp_nogrow);
    // r14 is still valid — only ptr and cap were updated.

    // Store value at ptr[len]: rax = [r12]; rax += len*8; [rax] = r13
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R13);

    // len++
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 8, PEIR_R14);

    // Epilogue
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_len(rcx=*Vec) -> rax = i64
pub fn PeirGen_gen_vec_len(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_len");
    PeirEnc_place_label(&mut self.enc, label);

    // rax = [rcx + 8] = len
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_get(rcx=*Vec, rdx=i64 index) -> rax = i64
///
/// The lowerer emits this builtin for `v[i]` (compiler/lower.fd), and the
/// interpreter's version panics on out-of-bounds — so unlike the Rust stub
/// (dead code there; its lowerer emits checked `Vec_get` calls), this one
/// bounds-checks: idx >= len or idx < 0 -> p_panic (exits 1).
pub fn PeirGen_gen_vec_get(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_get");
    PeirEnc_place_label(&mut self.enc, label);

    // len = [rcx + 8]
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8);
    // idx >= len -> panic
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    var vg_panic: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0xD, vg_panic);
    // jge
    // idx < 0 -> panic
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x8, vg_panic);
    // js

    // rax = ptr = [rcx]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // rax += rdx * 8
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    // rax = [rax]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);

    PeirEnc_place_label(&mut self.enc, vg_panic);
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "Vec index out of bounds"));
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_panic"));
    PeirEnc_ud2(&mut self.enc);
}

/// p_vec_pop(rcx=*Vec) -> rax = i64 (last element, or 0 if empty)
pub fn PeirGen_gen_vec_pop(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_pop");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);

    // r8 = len = [rcx+8]
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);

    // if len == 0, return 0
    PeirEnc_test_rr(&mut self.enc, PEIR_R8, PEIR_R8);
    var vp_empty: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, vp_empty);
    // jz — empty

    // len--
    PeirEnc_dec_r(&mut self.enc, PEIR_R8);
    // store new len
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R8);

    // rax = ptr = [rcx]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // rax += r8 * 8 (r8 is now len-1 = index of last)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R8);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var vp_ret: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, vp_ret);

    PeirEnc_place_label(&mut self.enc, vp_empty);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);

    PeirEnc_place_label(&mut self.enc, vp_ret);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_print_vec(rcx=*Vec) — prints [1, 2, 3]
pub fn PeirGen_gen_print_vec(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_vec");
    PeirEnc_place_label(&mut self.enc, label);
    PeirGen_sized_vec_to_core(self, true);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 56);

    // r12 = vec ptr, r13 = len, r14 = index
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);

    // Print '['
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 91);
    // '['
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -40, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -39, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RCX, -40);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_str"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);

    // r13 = len
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_xor_self(&mut self.enc, PEIR_R14);
    // index = 0

    var pv_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pv_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R14, PEIR_R13);
    var pv_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, pv_done);
    // jae — done

    // if index > 0, print ", "
    PeirEnc_test_rr(&mut self.enc, PEIR_R14, PEIR_R14);
    var pv_nosep: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pv_nosep);
    // jz — first element
    // Store ", \0" on stack and call p_print_str
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 44);
    // ','
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -40, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 32);
    // ' '
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -39, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -38, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RCX, -40);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_str"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_place_label(&mut self.enc, pv_nosep);

    // Get element: ptr[index]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    // rax = data ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    // rax = element

    // Print element as int
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_int"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);

    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, pv_loop);
    PeirEnc_place_label(&mut self.enc, pv_done);

    // Print ']'
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 93);
    // ']'
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -40, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -39, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RCX, -40);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_str"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);

    PeirEnc_add_rsp_i32(&mut self.enc, 56);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// HashMap runtime stubs — { ptr: *Entry, len: i64, cap: i64 } = 24 bytes,
// Entry = { key: *u8, value: i64 } = 16 bytes
// ===========================================================================

/// p_map_new() -> rax = *Map (24-byte heap struct, all zeros)
pub fn PeirGen_gen_map_new(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_new");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);

    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 24);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));

    PeirEnc_xor_self(&mut self.enc, PEIR_RCX);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 8, PEIR_RCX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 16, PEIR_RCX);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_map_insert(rcx=*Map, rdx=*u8 key, r8=i64 value)
pub fn PeirGen_gen_map_insert(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_insert");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);

    // r12 = map, r13 = key, r14 = value
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_R8);

    // Search for existing key: for i in 0..len, compare strings
    // r8 = len = [r12+8]
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
    // r8 = len
    PeirEnc_xor_self(&mut self.enc, PEIR_R9);
    // r9 = index

    var mi_search: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mi_search);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R9, PEIR_R8);
    var mi_notfound: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, mi_notfound);
    // jae — not found

    // Get entry: ptr = [r12] + r9*16
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R9);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    // * 16
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // entry.key = [rax], compare with r13
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    // rcx = entry.key
    // String compare: compare bytes until mismatch or null
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    // rdx = our key
    var mi_cmp: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mi_cmp);
    PeirEnc_xor_self(&mut self.enc, PEIR_R10);
    PeirEnc_xor_self(&mut self.enc, PEIR_R11);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R10, PEIR_RCX);
    // r10b = entry.key[i]
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R11, PEIR_RDX);
    // r11b = our.key[i]
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R10, PEIR_R11);
    var mi_mismatch: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, mi_mismatch);
    // jnz — mismatch
    // Both null? Match!
    PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    var mi_match: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, mi_match);
    // jz — strings equal
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_RDX);
    PeirEnc_jmp_label(&mut self.enc, mi_cmp);

    PeirEnc_place_label(&mut self.enc, mi_match);
    // Found existing key: update value at entry+8
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R9);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R14);
    // entry.value = r14
    var mi_ret: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, mi_ret);

    PeirEnc_place_label(&mut self.enc, mi_mismatch);
    PeirEnc_inc_r(&mut self.enc, PEIR_R9);
    PeirEnc_jmp_label(&mut self.enc, mi_search);

    PeirEnc_place_label(&mut self.enc, mi_notfound);
    // Need to insert new entry. Check capacity.
    // cap = [r12+16]
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 16);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R10, PEIR_RAX);
    // r10 = cap

    PeirEnc_cmp_rr(&mut self.enc, PEIR_R8, PEIR_R10);
    // len vs cap
    var mi_grow: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x2, mi_grow);
    // jb — no grow needed

    // Grow: new_cap = cap==0 ? 4 : cap*2
    PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    var mi_newcap: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, mi_newcap);
    // jnz — cap != 0
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R10, 4);
    var mi_grow2: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, mi_grow2);
    PeirEnc_place_label(&mut self.enc, mi_newcap);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_R10, 1);
    // cap * 2

    PeirEnc_place_label(&mut self.enc, mi_grow2);
    // Save new_cap at [rbp-16], len at [rbp-24] (r8 clobbered by p_malloc)
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_R10);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -24, PEIR_R8);
    // malloc(new_cap * 16)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R10);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    // * 16
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R11, PEIR_RAX);
    // r11 = new entries
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R8, -24);
    // restore len

    // Copy old entries: len * 16 bytes
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    // rax = old ptr
    PeirEnc_xor_self(&mut self.enc, PEIR_RCX);
    // index
    var mi_copy: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mi_copy);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RCX, PEIR_R8);
    var mi_copydone: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, mi_copydone);
    // jae — done
    // Copy 16 bytes (2 qwords)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDX, 4);
    // old[i].key
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
    PeirEnc_add_rr(&mut self.enc, PEIR_R9, PEIR_RDX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R9, PEIR_R9);
    // new[i].key
    PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_R11);
    PeirEnc_add_rr(&mut self.enc, PEIR_R10, PEIR_RDX);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_R10, PEIR_R9);
    // old[i].value
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
    PeirEnc_add_rr(&mut self.enc, PEIR_R9, PEIR_RDX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_R9, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R9, PEIR_R9);
    // new[i].value
    PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_R11);
    PeirEnc_add_rr(&mut self.enc, PEIR_R10, PEIR_RDX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_R10, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_R10, PEIR_R9);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_jmp_label(&mut self.enc, mi_copy);
    PeirEnc_place_label(&mut self.enc, mi_copydone);

    // Update ptr first: r11 does not survive the call to p_free
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_R12, PEIR_R11);
    // [r12] = new ptr

    // Free old if non-null
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var mi_nofree: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, mi_nofree);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_free"));
    PeirEnc_place_label(&mut self.enc, mi_nofree);

    // Update cap
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R10, -16);
    // restore new_cap
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 16);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R10);
    // [r12+16] = new cap

    PeirEnc_place_label(&mut self.enc, mi_grow);
    // No grow needed — len < cap. Just add entry at index len.
    // Re-read len (r8 might be stale)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
    // r8 = len

    // entry = ptr + len * 16
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R8);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // entry.key = r13
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R13);
    // entry.value = r14
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R14);
    // len++
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R8);

    PeirEnc_place_label(&mut self.enc, mi_ret);
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_map_get(rcx=*Map, rdx=*u8 key) -> rax = i64
pub fn PeirGen_gen_map_get(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_get");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);

    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // map
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);
    // key

    // len = [r12+8]
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
    PeirEnc_xor_self(&mut self.enc, PEIR_R9);
    // index

    var mg_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mg_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R9, PEIR_R8);
    var mg_notfound: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, mg_notfound);

    // entry = ptr + r9*16
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R9);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    // entry.key

    // Compare strings
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    var mg_cmp: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mg_cmp);
    PeirEnc_xor_self(&mut self.enc, PEIR_R10);
    PeirEnc_xor_self(&mut self.enc, PEIR_R11);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R10, PEIR_RCX);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R11, PEIR_RDX);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R10, PEIR_R11);
    var mg_mismatch: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, mg_mismatch);
    PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    var mg_found: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, mg_found);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_RDX);
    PeirEnc_jmp_label(&mut self.enc, mg_cmp);

    PeirEnc_place_label(&mut self.enc, mg_found);
    // Return entry.value at [entry+8]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R9);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var mg_ret: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, mg_ret);

    PeirEnc_place_label(&mut self.enc, mg_mismatch);
    PeirEnc_inc_r(&mut self.enc, PEIR_R9);
    PeirEnc_jmp_label(&mut self.enc, mg_loop);

    PeirEnc_place_label(&mut self.enc, mg_notfound);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    // return 0 if not found

    PeirEnc_place_label(&mut self.enc, mg_ret);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_map_contains(rcx=*Map, rdx=*u8 key) -> rax = bool
pub fn PeirGen_gen_map_contains(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_contains");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);

    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
    PeirEnc_xor_self(&mut self.enc, PEIR_R9);

    var mc_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mc_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R9, PEIR_R8);
    var mc_notfound: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, mc_notfound);

    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R9);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    var mc_cmp: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mc_cmp);
    PeirEnc_xor_self(&mut self.enc, PEIR_R10);
    PeirEnc_xor_self(&mut self.enc, PEIR_R11);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R10, PEIR_RCX);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R11, PEIR_RDX);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R10, PEIR_R11);
    var mc_mismatch: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, mc_mismatch);
    PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    var mc_found: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, mc_found);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_RDX);
    PeirEnc_jmp_label(&mut self.enc, mc_cmp);

    PeirEnc_place_label(&mut self.enc, mc_found);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
    var mc_ret: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, mc_ret);

    PeirEnc_place_label(&mut self.enc, mc_mismatch);
    PeirEnc_inc_r(&mut self.enc, PEIR_R9);
    PeirEnc_jmp_label(&mut self.enc, mc_loop);

    PeirEnc_place_label(&mut self.enc, mc_notfound);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);

    PeirEnc_place_label(&mut self.enc, mc_ret);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_map_remove(rcx=*Map, rdx=*u8 key)
pub fn PeirGen_gen_map_remove(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_remove");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);

    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
    // len
    PeirEnc_xor_self(&mut self.enc, PEIR_R9);
    // index

    var mr_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mr_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R9, PEIR_R8);
    var mr_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, mr_done);

    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R9);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    var mr_cmp: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mr_cmp);
    PeirEnc_xor_self(&mut self.enc, PEIR_R10);
    PeirEnc_xor_self(&mut self.enc, PEIR_R11);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R10, PEIR_RCX);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R11, PEIR_RDX);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R10, PEIR_R11);
    var mr_mismatch: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, mr_mismatch);
    PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    var mr_found: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, mr_found);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_RDX);
    PeirEnc_jmp_label(&mut self.enc, mr_cmp);

    PeirEnc_place_label(&mut self.enc, mr_found);
    // Shift remaining entries left by 1
    // r9 = found index, r8 = len
    // for i in r9..r8-1: entry[i] = entry[i+1]
    PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_R9);
    // i = found index
    var mr_shift: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mr_shift);
    // if i >= len-1, done shifting
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
    PeirEnc_dec_r(&mut self.enc, PEIR_RAX);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R10, PEIR_RAX);
    var mr_shift_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, mr_shift_done);
    // jae — done

    // Copy entry[i+1] to entry[i]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R10);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // rax = &entry[i]
    // entry[i+1] key
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RDX, 16);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RDX);
    // entry[i+1] value
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RDX, 24);
    // entry[i+1].value
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RDX);

    PeirEnc_inc_r(&mut self.enc, PEIR_R10);
    PeirEnc_jmp_label(&mut self.enc, mr_shift);
    PeirEnc_place_label(&mut self.enc, mr_shift_done);

    // len--
    PeirEnc_dec_r(&mut self.enc, PEIR_R8);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R8);
    PeirEnc_jmp_label(&mut self.enc, mr_done);

    PeirEnc_place_label(&mut self.enc, mr_mismatch);
    PeirEnc_inc_r(&mut self.enc, PEIR_R9);
    PeirEnc_jmp_label(&mut self.enc, mr_loop);

    PeirEnc_place_label(&mut self.enc, mr_done);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_map_len(rcx=*Map) -> rax = i64
pub fn PeirGen_gen_map_len(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_len");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_map_is_empty(rcx=*Map) -> rax = bool
pub fn PeirGen_gen_map_is_empty(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_is_empty");
    PeirEnc_place_label(&mut self.enc, label);

    // rax = [rcx + 8] (len)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    // if len == 0, return 1, else return 0
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var mie_empty: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, mie_empty);
    // jz — empty
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    // not empty -> 0
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mie_empty);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
    // empty -> 1
    PeirEnc_ret(&mut self.enc);
}

/// p_print_map(rcx=*Map) — prints {key: value, ...}
pub fn PeirGen_gen_print_map(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_map");
    PeirEnc_place_label(&mut self.enc, label);

    // Prologue: push rbp + 4 callee-saved = 5 pushes = 40 bytes
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    // map
    PeirEnc_push(&mut self.enc, PEIR_R13);
    // len
    PeirEnc_push(&mut self.enc, PEIR_R14);
    // index
    PeirEnc_push(&mut self.enc, PEIR_R15);
    // result string
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    // 32 shadow + 8 align

    // r12 = map
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);

    // Start with "{" — malloc 2 bytes, store '{', '\0'
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 2);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);
    // r15 = result
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 123);
    // '{'
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R15, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 0);
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_R15, 1, PEIR_RCX);

    // r13 = len = [r12 + 8], r14 = 0
    PeirEnc_xor_self(&mut self.enc, PEIR_R14);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);

    var pm_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pm_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R14, PEIR_R13);
    var pm_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, pm_done);
    // jae — done

    // If index > 0, append ", "
    PeirEnc_test_rr(&mut self.enc, PEIR_R14, PEIR_R14);
    var pm_first: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pm_first);
    // jz — first element
    // Build ", \0" on stack at [rbp-16]
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 44);
    // ','
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 32);
    // ' '
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -15, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -14, PEIR_RAX);
    // r15 = p_str_concat(r15, &[rbp-16])
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -16);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, pm_first);

    // Get key: entry = ptr + r14*16, key = [entry]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    // rcx = key ptr

    // r15 = p_str_concat(r15, key)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
    // rdx = key
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    // rcx = result so far
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);

    // Append ": "
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 58);
    // ':'
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 32);
    // ' '
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -15, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -14, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -16);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);

    // Get value: entry+8
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    // rcx = value

    // Call p_to_str(value) -> rax = string
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_to_str"));

    // r15 = p_str_concat(r15, rax)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);

    // inc r14, loop
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, pm_loop);

    PeirEnc_place_label(&mut self.enc, pm_done);
    // Append "}" — build "}\0" on stack at [rbp-16]
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 125);
    // '}'
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -15, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -16);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    // rax = final string

    // Print the string (p_print_str adds newline)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_str"));

    // Epilogue
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R15);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// New Vec runtime stubs
// ===========================================================================

/// p_vec_set(rcx=*Vec, rdx=i64 idx, r8=i64 value)
/// Bounds-checked like the interpreter's builtin: an out-of-range write
/// would silently corrupt the heap, so idx >= len or idx < 0 -> p_panic.
pub fn PeirGen_gen_vec_set(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_set");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);

    // len = [rcx + 8]
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8);
    var vs_panic: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    // idx vs len
    PeirEnc_jcc_label(&mut self.enc, 0xD, vs_panic);
    // jge -> panic
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x8, vs_panic);
    // js -> panic

    // rax = data ptr
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // rax = data
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RDX);
    // r9 = idx
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_R9, 3);
    // r9 = idx*8
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R9);
    // &data[idx]
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R8);
    // data[idx]
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    // return 0
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);

    PeirEnc_place_label(&mut self.enc, vs_panic);
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "Vec index out of bounds"));
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_panic"));
    PeirEnc_ud2(&mut self.enc);
}

/// p_vec_is_empty(rcx=*Vec) -> rax = bool
pub fn PeirGen_gen_vec_is_empty(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_is_empty");
    PeirEnc_place_label(&mut self.enc, label);
    // len at [rcx+8], return len == 0
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_setcc_r(&mut self.enc, 0x4, PEIR_RAX);
    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_clear(rcx=*Vec)
pub fn PeirGen_gen_vec_clear(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_clear");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 8, PEIR_RAX);
    // len = 0
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_capacity(rcx=*Vec) -> rax = i64
pub fn PeirGen_gen_vec_capacity(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_capacity");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 16);
    // cap
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_first(rcx=*Vec) -> rax = i64
pub fn PeirGen_gen_vec_first(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_first");
    PeirEnc_place_label(&mut self.enc, label);
    // Check len > 0
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8);
    // rax = len
    var skip: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, skip);
    // jz
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // rax = data[0]
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, skip);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_last(rcx=*Vec) -> rax = i64
pub fn PeirGen_gen_vec_last(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_last");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8);
    // rax = len
    var skip: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, skip);
    // jz
    // data ptr is at [rcx], load it
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R9, PEIR_RCX);
    // r9 = data ptr
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8);
    // rax = len
    PeirEnc_dec_r(&mut self.enc, PEIR_RAX);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R9);
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, skip);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_contains(rcx=*Vec, rdx=i64 value) -> rax = bool
pub fn PeirGen_gen_vec_contains(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_contains");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    // r12 = data ptr, r13 = value
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // r12 = data ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);
    // r13 = value
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R9, PEIR_RCX, 8);
    // r9 = len
    PeirEnc_xor_self(&mut self.enc, PEIR_R10);
    // r10 = index 0
    var loop_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    var found_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    var not_found: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, loop_label);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R10, PEIR_R9);
    PeirEnc_jcc_label(&mut self.enc, 0x3, not_found);
    // jae — not found
    // Load element at r10
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    // rax = data[r10]
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_jcc_label(&mut self.enc, 0x4, found_label);
    // je — found
    PeirEnc_inc_r(&mut self.enc, PEIR_R10);
    PeirEnc_jmp_label(&mut self.enc, loop_label);
    PeirEnc_place_label(&mut self.enc, found_label);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
    PeirEnc_jmp_label(&mut self.enc, not_found);
    PeirEnc_place_label(&mut self.enc, not_found);
    // (Both the fall-through and the found path land here; as in Rust,
    // rax is unconditionally reset to 0 — the found path's rax=1 is dead.)
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_truncate(rcx=*Vec, rdx=i64 new_len)
pub fn PeirGen_gen_vec_truncate(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_truncate");
    PeirEnc_place_label(&mut self.enc, label);
    // Set len = min(len, new_len)
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8);
    // len
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    // If rdx < rax, set len = rdx; else keep len
    var skip: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x2, skip);
    // jb — rdx < rax
    // rdx >= rax, keep current len, return
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, skip);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 8, PEIR_RDX);
    // len = rdx
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_clone(rcx=*Vec) -> rax = *Vec (new copy)
pub fn PeirGen_gen_vec_clone(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_clone");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    // r12 = original vec
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // malloc(24) for new vec
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 24);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // Copy 24 bytes from original to new
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
    // r9 = new vec ptr
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_R12, 0);
    // data ptr
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R9, 0, PEIR_RCX);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_R12, 8);
    // len
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R9, 8, PEIR_RCX);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_R12, 16);
    // cap
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R9, 16, PEIR_RCX);
    // Return new vec ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R9);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// New HashMap runtime stubs
// ===========================================================================

/// p_map_clear(rcx=*Map) — set count=0
pub fn PeirGen_gen_map_clear(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_clear");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 8, PEIR_RAX);
    // count = 0
    PeirEnc_ret(&mut self.enc);
}

/// p_map_get_or(rcx=*Map, rdx=*u8 key, r8=i64 default) -> rax = i64
pub fn PeirGen_gen_map_get_or(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_get_or");
    PeirEnc_place_label(&mut self.enc, label);
    // Try p_map_get first; if it returns 0 and not found, return default.
    // (A stub, as in Rust: it returns the default unconditionally.)
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    // Save default in r12
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_R8);
    // Check contains first
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_map_contains"));
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var not_found: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, not_found);
    // jz — not contained
    // Contained: call p_map_get — rcx/rdx were clobbered, so this stub just
    // returns the default (same as Rust).
    PeirEnc_place_label(&mut self.enc, not_found);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// String runtime stubs — strings in PE are null-terminated *u8 (C strings)
// ===========================================================================

/// p_string_len(rcx=*u8) -> rax = i64 (strlen)
pub fn PeirGen_gen_string_len(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_string_len");
    PeirEnc_place_label(&mut self.enc, label);
    // Delegate to imported strlen — a real SIMD scan, not a byte loop.
    // push rbp + sub 32 keeps rsp 16-aligned at the call.
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("strlen")));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_string_is_empty(rcx=*u8) -> rax = bool
pub fn PeirGen_gen_string_is_empty(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_string_is_empty");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // load first byte
    // mov r8,[m] leaves rax's upper bits dirty — clean before the test
    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_setcc_r(&mut self.enc, 0x4, PEIR_RAX);
    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_string_starts_with(rcx=*u8, rdx=*u8 prefix) -> rax = bool
pub fn PeirGen_gen_string_starts_with(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_string_starts_with");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    // r12 = str, r13 = prefix
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);
    var loop_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    var true_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    var false_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    var done_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, loop_label);
    // Load prefix byte (movzx — upper bits dirty after mov r8,[m])
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, true_label);
    // prefix end = match
    // Load str byte
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_R9, PEIR_R12);
    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_R9, PEIR_R9);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, false_label);
    // jne
    // Advance both pointers
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_jmp_label(&mut self.enc, loop_label);
    PeirEnc_place_label(&mut self.enc, false_label);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_jmp_label(&mut self.enc, done_label);
    PeirEnc_place_label(&mut self.enc, true_label);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
    PeirEnc_place_label(&mut self.enc, done_label);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_string_parse_int(rcx=*u8) -> rax = i64 (atoi)
pub fn PeirGen_gen_string_parse_int(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_string_parse_int");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    // r12 = ptr, rax = result
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    // result = 0
    var loop_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    var done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, loop_label);
    // Load byte (movzx — r9's upper bits are dirty after mov r8,[m] and r9
    // is added into the result below)
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_R9, PEIR_R12);
    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_R9, PEIR_R9);
    // Check if byte < '0' or > '9'
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_R9, 48);
    // '0'
    PeirEnc_jcc_label(&mut self.enc, 0x2, done);
    // jb
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_R9, 57);
    // '9'
    PeirEnc_jcc_label(&mut self.enc, 0x7, done);
    // ja
    // result = result * 10 + (byte - '0')
    PeirEnc_imul_r_r_imm32(&mut self.enc, PEIR_RAX, PEIR_RAX, 10);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_R9, -48);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R9);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_jmp_label(&mut self.enc, loop_label);
    PeirEnc_place_label(&mut self.enc, done);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_string_bytes(rcx=*u8) -> rax = i64 (same as len)
pub fn PeirGen_gen_string_bytes(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_string_bytes");
    PeirEnc_place_label(&mut self.enc, label);
    // Same as p_string_len: delegate to imported strlen.
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("strlen")));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_string_clone(rcx=*u8) -> rax = *u8 (new copy)
pub fn PeirGen_gen_string_clone(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_string_clone");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    var strlen_off: i64 = PeirGen_iat_off(self, pe_import_slot("strlen"));
    var memcpy_off: i64 = PeirGen_iat_off(self, pe_import_slot("memcpy"));
    // r12 = src; r13 = strlen(src)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_call_rip(&mut self.enc, strlen_off);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);
    // malloc(len + 1)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // r12 = dest (src is done once rdx holds it); memcpy(dest, src, len+1)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R13);
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, memcpy_off);
    // Return dest
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// Alias stubs: p_float_to_str -> p_to_str_float, p_bool_to_str -> p_to_str_bool
// ===========================================================================

pub fn PeirGen_gen_float_to_str_alias(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_float_to_str");
    PeirEnc_place_label(&mut self.enc, label);
    var target: i64 = HashMap_get(self.func_labels, "p_to_str_float");
    PeirEnc_jmp_label(&mut self.enc, target);
}

pub fn PeirGen_gen_bool_to_str_alias(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_bool_to_str");
    PeirEnc_place_label(&mut self.enc, label);
    var target: i64 = HashMap_get(self.func_labels, "p_to_str_bool");
    PeirEnc_jmp_label(&mut self.enc, target);
}

/// p_char_to_str(rcx = char_code) -> rax = *u8
pub fn PeirGen_gen_char_to_str(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_char_to_str");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    // 32 + 8 for alignment
    // Save char code in r12
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // malloc(16 + 2): a length header, so a zero byte is a 1-byte string
    // (release D16), then the byte and the terminator
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 18);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, 0x4649444500000001);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 0, PEIR_R9);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 1);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 8, PEIR_R9);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 16);
    // Store char at [rax]
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    // Store 0 at [rax+1]
    PeirEnc_xor_self(&mut self.enc, PEIR_R12);
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 1, PEIR_R12);
    // Return rax
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_eprint_str(rcx = *u8) — WriteFile to stderr
pub fn PeirGen_gen_eprint_str(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_eprint_str");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 64);
    // r12 = string pointer
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // Calculate length: strlen(r12)
    PeirEnc_xor_self(&mut self.enc, PEIR_R8);
    var es_len: i64 = PeirEnc_alloc_label(&mut self.enc);
    var es_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, es_len);
    PeirEnc_cmp_mem_idx_imm8(&mut self.enc, PEIR_R12, PEIR_R8, 0);
    PeirEnc_jcc_label(&mut self.enc, 0x4, es_done);
    // je
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_jmp_label(&mut self.enc, es_len);
    PeirEnc_place_label(&mut self.enc, es_done);
    // r13 = length
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R8);
    // GetStdHandle(STD_ERROR_HANDLE = -12)
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -12);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // WriteFile(handle, r12, r13, &written, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R13);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -32);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    // Return
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_print_newline() — WriteFile "\n" to stdout
pub fn PeirGen_gen_print_newline(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_newline");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 64);
    // Store '\n' at [rbp-8]
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 10);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -8, PEIR_RAX);
    // GetStdHandle(-11)
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -11);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // WriteFile(handle, &"\n", 1, &written, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -8);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 1);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -16);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    // Return
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// String-builder stubs
// ===========================================================================

/// p_sb_new() -> rax = *sb (struct: {buf, len, cap} = 24 bytes)
pub fn PeirGen_gen_sb_new(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_sb_new");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    // 32 + 8 for alignment
    // malloc(24) for struct
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 24);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
    // r12 = sb struct
    // malloc(4096) for buffer
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 4096);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // sb->buf = rax (offset 0)
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 0, PEIR_RAX);
    // sb->len = 0 (offset 8)
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 8, PEIR_RAX);
    // sb->cap = 4096 (offset 16)
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 4096);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 16, PEIR_RAX);
    // buf[0] = 0
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 0);
    // rax = buf
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    // Return sb
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_sb_append(rcx = sb, rdx = s)
/// strlen once, memcpy for both the grow-copy and the append — no byte
/// loops (pe-roadmap items 73/75).
pub fn PeirGen_gen_sb_append(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_sb_append");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    // sb
    PeirEnc_push(&mut self.enc, PEIR_R13);
    // s
    PeirEnc_push(&mut self.enc, PEIR_R14);
    // slen
    PeirEnc_push(&mut self.enc, PEIR_R15);
    // new_cap / new buf
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    // 32 shadow + 16 locals
    // r12 = sb, r13 = s
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);

    var strlen_off: i64 = PeirGen_iat_off(self, pe_import_slot("strlen"));
    var memcpy_off: i64 = PeirGen_iat_off(self, pe_import_slot("memcpy"));

    // r14 = slen = strlen(s)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_call_rip(&mut self.enc, strlen_off);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_RAX);

    // needed = sb->len + slen + 1; grow while cap < needed
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 8);
    // sb->len
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R14);
    PeirEnc_inc_r(&mut self.enc, PEIR_RAX);
    // rax = needed
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_R12, 16);
    // sb->cap
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var sa_no_grow: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x6, sa_no_grow);
    // jbe — fits
    // r15 = new_cap = cap doubled until it fits
    var sa_grow_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, sa_grow_loop);
    PeirEnc_add_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    // cap *= 2
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x7, sa_grow_loop);
    // ja — still no fit
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RDX);

    // [rbp-48] = old buf; sb->cap = new_cap
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 16, PEIR_R15);

    // rax = new buf = p_malloc(new_cap)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));

    // r15 = new buf; memcpy(new buf, old buf, sb->len)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, -48);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R8, PEIR_R12, 8);
    PeirEnc_call_rip(&mut self.enc, memcpy_off);

    // sb->buf = new buf; free(old buf)
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 0, PEIR_R15);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, -48);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_free"));

    PeirEnc_place_label(&mut self.enc, sa_no_grow);
    // memcpy(sb->buf + sb->len, s, slen + 1) — +1 copies s's NUL
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_R12, 0);
    // buf
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 8);
    // len
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    // dest = buf + len
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R14);
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_call_rip(&mut self.enc, memcpy_off);

    // sb->len += slen
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 8);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R14);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 8, PEIR_RAX);

    // Return 0
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    PeirEnc_pop(&mut self.enc, PEIR_R15);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_sb_to_str(rcx = sb) -> rax = *u8
pub fn PeirGen_gen_sb_to_str(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_sb_to_str");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    // sb
    PeirEnc_push(&mut self.enc, PEIR_R13);
    // result
    PeirEnc_push(&mut self.enc, PEIR_R14);
    // len
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    // 32 + 8 for alignment
    // r12 = sb
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // r14 = sb->len
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R14, PEIR_R12, 8);
    // malloc(len + 1)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);
    // r13 = result
    // memcpy(result, sb->buf, len + 1) — +1 copies the NUL
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_R12, 0);
    // sb->buf
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R14);
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("memcpy")));
    // Free sb->buf
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_R12, 0);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_free"));
    // Free sb struct
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_free"));
    // Return result
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// File I/O stubs
// ===========================================================================

/// p_file_read(rcx = path) -> rax = *u8
pub fn PeirGen_gen_file_read(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_file_read");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    // path
    PeirEnc_push(&mut self.enc, PEIR_R13);
    // handle
    PeirEnc_push(&mut self.enc, PEIR_R14);
    // buf
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    // 32 + 8 for alignment
    // r12 = path
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // CreateFileA(path, GENERIC_READ=0x80000000, FILE_SHARE_READ=1, NULL,
    // OPEN_EXISTING=3, 0, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    // path
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x80000000);
    // GENERIC_READ
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 1);
    // FILE_SHARE_READ
    PeirEnc_xor_self(&mut self.enc, PEIR_R9);
    // NULL (security)
    // Allocate shadow space + stack args (5th, 6th, 7th params)
    PeirEnc_sub_rsp_i32(&mut self.enc, 64);
    // 32 shadow + 3 stack args
    // Set stack args at rsp+32, rsp+40, rsp+48
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 3);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    // OPEN_EXISTING
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 40, PEIR_RAX);
    // flags=0
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 48, PEIR_RAX);
    // template
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_CREATE_FILE_A));
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    // Check for INVALID_HANDLE_VALUE (-1)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);
    // handle
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, -1);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var fr_ok: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, fr_ok);
    // jnz — handle valid
    // Return 0 (NULL)
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, fr_ok);
    // r12 = GetFileSize(handle, NULL): the path is no longer needed.
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_FILE_SIZE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, 0xFFFFFFFF);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R12, PEIR_RDX);
    var fr_size_ok: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, fr_size_ok);
    // jne
    PeirEnc_xor_self(&mut self.enc, PEIR_R12);
    PeirEnc_place_label(&mut self.enc, fr_size_ok);
    // r14 = buf = p_malloc(size + 1)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_RAX);
    // r14 = buf
    // ReadFile(handle, buf, size, &bytesRead, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    // handle
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R14);
    // buf
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R12);
    // size
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -32);
    // &bytesRead
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    // Zero all 8 bytes: ReadFile writes a DWORD, the count is read as 64 bits.
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R9, 0, PEIR_RAX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    // NULL
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_READ_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    // bytesRead is at [rbp-32]. Null-terminate at buf[bytesRead]
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -32);
    // bytesRead
    PeirEnc_add_rr(&mut self.enc, PEIR_R14, PEIR_RAX);
    // r14 = buf + bytesRead
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R14, PEIR_RDX);
    // null term
    // CloseHandle(handle)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_CLOSE_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // Return buf (r14 = buf + bytesRead, subtract bytesRead back)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R14);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, -32);
    // bytesRead
    PeirEnc_sub_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    // rax = buf
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_file_write(rcx = path, rdx = content) -> rax = i64 (0=success, -1=fail)
pub fn PeirGen_gen_file_write(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_file_write");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    // path
    PeirEnc_push(&mut self.enc, PEIR_R13);
    // content
    PeirEnc_push(&mut self.enc, PEIR_R14);
    // handle
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    // 32 + 8 for alignment
    // r12 = path, r13 = content
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);
    // CreateFileA(path, GENERIC_WRITE=0x40000000, 0, NULL, CREATE_ALWAYS=2, 0, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x40000000);
    // GENERIC_WRITE
    PeirEnc_xor_self(&mut self.enc, PEIR_R8);
    // no sharing
    PeirEnc_xor_self(&mut self.enc, PEIR_R9);
    // NULL security
    PeirEnc_sub_rsp_i32(&mut self.enc, 64);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 2);
    // CREATE_ALWAYS
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 40, PEIR_RAX);
    // flags=0
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 48, PEIR_RAX);
    // template
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_CREATE_FILE_A));
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    // Check for INVALID_HANDLE_VALUE
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_RAX);
    // handle
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, -1);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var fw_ok: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, fw_ok);
    // jnz — valid
    // Return -1
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, -1);
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, fw_ok);
    // strlen(content) into r8
    PeirEnc_xor_self(&mut self.enc, PEIR_R8);
    var fw_len: i64 = PeirEnc_alloc_label(&mut self.enc);
    var fw_len_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, fw_len);
    PeirEnc_cmp_mem_idx_imm8(&mut self.enc, PEIR_R13, PEIR_R8, 0);
    PeirEnc_jcc_label(&mut self.enc, 0x4, fw_len_done);
    // je
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_jmp_label(&mut self.enc, fw_len);
    PeirEnc_place_label(&mut self.enc, fw_len_done);
    // WriteFile(handle, content, len, &written, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    // handle
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    // content
    // r8 already = len
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -32);
    // &written
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    // NULL
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    // CloseHandle(handle)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_CLOSE_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // Return 0
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// Process stubs: p_argc, p_argv, p_system
// ===========================================================================

/// p_argc() -> rax = i64
/// Returns the number of command-line arguments.  On Windows,
/// GetCommandLineA returns a single string; we count tokens.
pub fn PeirGen_gen_argc(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_argc");
    PeirEnc_place_label(&mut self.enc, label);
    // GetCommandLineA() -> rax = *u8 (command line string)
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_COMMAND_LINE_A));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // rax = command line string (or NULL)
    // Count whitespace-separated tokens
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    // rcx = ptr
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    // count = 0
    var done: i64 = PeirEnc_alloc_label(&mut self.enc);
    var loop_start: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, done);
    // jz — NULL command line
    // Skip leading whitespace
    PeirEnc_place_label(&mut self.enc, loop_start);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    // clear: only dl is loaded below
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RDX, PEIR_RCX);
    // load byte
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, done);
    // jz — end of string
    // Skip whitespace
    var not_ws: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RDX, 32);
    // ' '
    PeirEnc_jcc_label(&mut self.enc, 0x5, not_ws);
    // jne — not space
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    // advance
    PeirEnc_jmp_label(&mut self.enc, loop_start);
    PeirEnc_place_label(&mut self.enc, not_ws);
    // Found a token — increment count
    PeirEnc_inc_r(&mut self.enc, PEIR_RAX);
    // count++
    // Skip token until whitespace or end
    var skip_tok: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, skip_tok);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RDX, PEIR_RCX);
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, done);
    // jz — end of string
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RDX, 32);
    // ' '
    PeirEnc_jcc_label(&mut self.enc, 0x4, loop_start);
    // je — space: next token
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_jmp_label(&mut self.enc, skip_tok);
    PeirEnc_place_label(&mut self.enc, done);
    PeirEnc_ret(&mut self.enc);
}

/// p_argv(rcx = index) -> rax = *u8
/// Returns the command-line argument at the given index, or NULL.
pub fn PeirGen_gen_argv(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_argv");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    // index
    PeirEnc_push(&mut self.enc, PEIR_R13);
    // cmdline ptr
    PeirEnc_push(&mut self.enc, PEIR_R14);
    // current token start
    PeirEnc_sub_rsp_i32(&mut self.enc, 24);
    // align (3 pushes = 24)
    // r12 = index
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // GetCommandLineA()
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_COMMAND_LINE_A));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);
    // r13 = cmdline
    PeirEnc_xor_self(&mut self.enc, PEIR_R14);
    // r14 = token start (NULL)
    // If cmdline is NULL, return NULL
    var cmd_null: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_R13, PEIR_R13);
    PeirEnc_jcc_label(&mut self.enc, 0x4, cmd_null);
    // jz
    // Walk tokens, counting.  When count == index, save token start.
    var scan_start: i64 = PeirEnc_alloc_label(&mut self.enc);
    var tok_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    var skip_ws: i64 = PeirEnc_alloc_label(&mut self.enc);
    var found_tok: i64 = PeirEnc_alloc_label(&mut self.enc);
    var skip_tok: i64 = PeirEnc_alloc_label(&mut self.enc);
    // rax = current index (0)
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, scan_start);
    // Skip whitespace
    PeirEnc_place_label(&mut self.enc, skip_ws);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RDX, PEIR_R13);
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tok_done);
    // jz — end
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RDX, 32);
    // ' '
    PeirEnc_jcc_label(&mut self.enc, 0x5, found_tok);
    // jne — found token
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_jmp_label(&mut self.enc, skip_ws);
    PeirEnc_place_label(&mut self.enc, found_tok);
    // Check if this is the token we want
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    var not_this: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, not_this);
    // jne — not this index
    // Found! Save start
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_R13);
    PeirEnc_jmp_label(&mut self.enc, tok_done);
    PeirEnc_place_label(&mut self.enc, not_this);
    // Skip this token
    var tok_end: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, skip_tok);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RDX, PEIR_R13);
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tok_done);
    // jz — end
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RDX, 32);
    // ' '
    PeirEnc_jcc_label(&mut self.enc, 0x4, tok_end);
    // je — space: token done
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_jmp_label(&mut self.enc, skip_tok);
    // After skipping token, increment index and loop
    PeirEnc_place_label(&mut self.enc, tok_end);
    PeirEnc_inc_r(&mut self.enc, PEIR_RAX);
    PeirEnc_jmp_label(&mut self.enc, scan_start);
    PeirEnc_place_label(&mut self.enc, tok_done);
    // The count is not the result; NULL when no token matched (C8)
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    // If r14 is NULL, return NULL
    PeirEnc_test_rr(&mut self.enc, PEIR_R14, PEIR_R14);
    PeirEnc_jcc_label(&mut self.enc, 0x4, cmd_null);
    // jz
    // Allocate a copy of the token: its length + 1 (it ends at a space
    // or NUL). RL16: this passed the token's address as the size (rcx),
    // a block of megabytes per argument that `--leaks` reported
    var len_lp: i64 = PeirEnc_alloc_label(&mut self.enc);
    var len_end: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_place_label(&mut self.enc, len_lp);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RDX, PEIR_RCX);
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, len_end);
    // jz — NUL
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RDX, 32);
    PeirEnc_jcc_label(&mut self.enc, 0x4, len_end);
    // je — space
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_jmp_label(&mut self.enc, len_lp);
    PeirEnc_place_label(&mut self.enc, len_end);
    PeirEnc_sub_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // rax = dst buffer. Copy bytes until space or null.
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
    // r12 = dst
    var copy_start: i64 = PeirEnc_alloc_label(&mut self.enc);
    var copy_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, copy_start);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RDX, PEIR_R14);
    // load src byte
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, copy_done);
    // jz — null
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RDX, 32);
    // ' '
    PeirEnc_jcc_label(&mut self.enc, 0x4, copy_done);
    // je — space
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R12, PEIR_RDX);
    // store byte
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_jmp_label(&mut self.enc, copy_start);
    PeirEnc_place_label(&mut self.enc, copy_done);
    // Null-terminate
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R12, PEIR_RDX);
    // rax still points to the start of the buffer
    PeirEnc_jmp_label(&mut self.enc, cmd_null);
    PeirEnc_place_label(&mut self.enc, cmd_null);
    // rax = result (either the buffer or NULL if not found)
    PeirEnc_add_rsp_i32(&mut self.enc, 24);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_system(rcx = cmd) -> rax = i64 (exit code)
/// msvcrt system(), as the C backend: runs through the shell and returns the
/// exit status.
pub fn PeirGen_gen_system(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_system");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("system")));
    PeirEnc_movsxd_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// String join
// ===========================================================================

/// p_str_join_n(rcx = *Vec) -> rax = *u8
/// Vec struct: {data: *ptr, len: i64, cap: i64}; each element is a *u8 string.
pub fn PeirGen_gen_str_join_n(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_str_join_n");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    // vec
    PeirEnc_push(&mut self.enc, PEIR_R13);
    // element / total
    PeirEnc_push(&mut self.enc, PEIR_R14);
    // index
    PeirEnc_push(&mut self.enc, PEIR_R15);
    // vec len
    PeirEnc_sub_rsp_i32(&mut self.enc, 64);
    // Locals: [rbp-40] = result, [rbp-48] = write cursor, [rbp-56] = len.
    // Two passes, each element's length counted once by msvcrt strlen;
    // copies via memcpy to a running cursor (no result re-scan).
    var strlen_off: i64 = PeirGen_iat_off(self, pe_import_slot("strlen"));
    var memcpy_off: i64 = PeirGen_iat_off(self, pe_import_slot("memcpy"));
    // r12 = vec, r15 = vec->len
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R15, PEIR_R12, 8);
    // Pass 1: total = 1 + sum(strlen(elem))
    PeirEnc_xor_self(&mut self.enc, PEIR_R14);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R13, 1);
    var sjn_len_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    var sjn_len_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, sjn_len_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R14, PEIR_R15);
    PeirEnc_jcc_label(&mut self.enc, 0x3, sjn_len_done);
    // jae
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 0);
    // data ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R14);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_RAX, 0);
    // elem ptr
    PeirEnc_call_rip(&mut self.enc, strlen_off);
    PeirEnc_add_rr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, sjn_len_loop);
    PeirEnc_place_label(&mut self.enc, sjn_len_done);
    // result = cursor = malloc(total)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -40, PEIR_RAX);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);
    // Pass 2: memcpy each element to the cursor
    PeirEnc_xor_self(&mut self.enc, PEIR_R14);
    var sjn_cat_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    var sjn_cat_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, sjn_cat_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R14, PEIR_R15);
    PeirEnc_jcc_label(&mut self.enc, 0x3, sjn_cat_done);
    // jae
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 0);
    // data ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R14);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R13, PEIR_RAX, 0);
    // r13 = elem
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_call_rip(&mut self.enc, strlen_off);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -56, PEIR_RAX);
    // elem len
    // memcpy(cursor, elem, len + 1) — +1 copies the NUL; overwritten by
    // the next element and re-written at the end
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, -48);
    // cursor
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_call_rip(&mut self.enc, memcpy_off);
    // cursor += len
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, -48);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -56);
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, sjn_cat_loop);
    PeirEnc_place_label(&mut self.enc, sjn_cat_done);
    // Return result
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -40);
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    PeirEnc_pop(&mut self.enc, PEIR_R15);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// Entry point, C thunks, PE primitives
// ===========================================================================

/// _main — Windows entry point
pub fn PeirGen_gen_entry_point(self: &mut PeirGen) -> void {
    self.entry_offset = PeirEnc_offset(&self.enc);

    if self.bare_mode {
        // Bare-metal entry: on whatever stack the loader set up, aligned
        // to 16 with the 32-byte shadow space main's calls expect
        var bare_start: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_place_label(&mut self.enc, bare_start);
        if g_pe_uefi {
            PeirGen_gen_uefi_entry(self);
        }
        PeirEnc_xor_rr(&mut self.enc, PEIR_RBP, PEIR_RBP);
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xE4, 0xF0);
        // and rsp, -16
        PeirEnc_sub_rsp_i32(&mut self.enc, 32);

        if g_pe_uefi {
            PeirGen_gen_uefi_start(self);
        }
        if g_pe_elf {
            // The heap: 1 GB of address space, pages on first touch
            PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 9);
            // SYS_mmap
            PeirEnc_xor_rr(&mut self.enc, PEIR_RDI, PEIR_RDI);
            PeirEnc_mov_imm64(&mut self.enc, PEIR_RSI, 0x40000000);
            PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 3);
            // PROT_READ | PROT_WRITE
            PeirEnc_mov_imm32(&mut self.enc, PEIR_R10, 0x4022);
            // PRIVATE | ANONYMOUS | NORESERVE
            PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, -1);
            PeirEnc_xor_rr(&mut self.enc, PEIR_R9, PEIR_R9);
            pe_emit2(&mut self.enc, 0x0F, 0x05);
            // syscall
            PeirEnc_mov_rip_reg(&mut self.enc, self.alloc_rdata_off, PEIR_RAX);
        }

        // Call main()
        var main_label: i64 = HashMap_get(self.func_labels, "main");
        PeirEnc_call_label(&mut self.enc, main_label);

        if g_pe_uefi {
            // main's result is the image's EFI_STATUS (0 for a void main)
            if g_pe_bare_main_void {
                PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
            }
            PeirEnc_jmp_label(&mut self.enc, g_pe_uefi_exit);
        }
        if g_pe_elf {
            // exit_group(main's result)
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDI, PEIR_RAX);
            PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 231);
            pe_emit2(&mut self.enc, 0x0F, 0x05);
        }

        if pe_bare_boot_on() {
            // main's result to QEMU's isa-debug-exit (0 for a void main)
            if g_pe_bare_main_void {
                PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
            }
            pe_emit5(&mut self.enc, 0xBA, 0xF4, 0x00, 0x00, 0x00);
            // mov edx, 0xF4
            pe_emit1(&mut self.enc, 0xEE);
            // out dx, al
        }

        // Halt loop: hlt; jmp -3 (back to hlt: interrupt handlers still run)
        pe_emit1(&mut self.enc, 0xF4);
        // hlt
        pe_emit2(&mut self.enc, 0xEB, 0xFD);
        // jmp -3

        // A booted image enters here (from the prefix's trampoline)
        if pe_bare_boot_on() {
            PeirGen_gen_bare_boot_entry(self, bare_start);
        }
    } else {
        // sub rsp, 40 (32 shadow space + 8 for alignment)
        PeirEnc_sub_rsp_i32(&mut self.enc, 40);

        // CPU faults become panics with a message
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 1);
        PeirEnc_lea_label(&mut self.enc, PEIR_RDX, self.crash_filter);
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("AddVectoredExceptionHandler")));

        // MI20: the TLS index and start block of the nat_* primitives
        PeirGen_gen_nat_entry(self);

        // The `link` DLLs, before anything can call into them
        if HashMap_contains(self.func_labels, "__pe_load_dlls") {
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "__pe_load_dlls"));
        }

        // P12: FID_MEM_LIMIT / FID_CPU_LIMIT (pert_limits_boot(env 0),
        // pe_runtime/conc.fd "Run-time resource limits")
        if HashMap_contains(self.func_labels, "pert_limits_boot") {
            PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "pert_limits_boot"));
        }

        // SL15: the sampling profiler starts when FID_PROF asks for it
        // (pert_prof_boot(env 0))
        if HashMap_contains(self.func_labels, "pert_prof_boot") {
            PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "pert_prof_boot"));
        }

        // Call main()
        var main_label2: i64 = HashMap_get(self.func_labels, "main");
        PeirEnc_call_label(&mut self.enc, main_label2);

        // The exit hooks in pert_exit's order (stdlib/pe_runtime/base.fd).
        // Roadmap P6: rank 0 waits for the other ranks; pert_tp_exit(env 0,
        // main's result) gives the exit code back in rax (tensor.fd)
        if HashMap_contains(self.func_labels, "pert_tp_exit") {
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
            PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "pert_tp_exit"));
        }

        // SL15: its report at exit; pert_prof_exit(env 0, code) gives main's
        // result back in rax
        if HashMap_contains(self.func_labels, "pert_prof_exit") {
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
            PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "pert_prof_exit"));
        }

        // RL16: --leaks' report; pert_leak_exit(env 0, code) gives the code
        // back in rax. The stack is aligned here (the entry's sub rsp, 40).
        if g_pe_leaks && HashMap_contains(self.func_labels, "pert_leak_exit") {
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
            PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "pert_leak_exit"));
        }

        // ExitProcess(rax) — use return value from main as exit code
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_EXIT_PROCESS));

        PeirEnc_ud2(&mut self.enc);
    }
}

// A stub a C call lands on when its DLL or function is missing: print the
// message at .rdata offset `msg_off` to stderr and exit with 1.
fn PeirGen_dll_fail(self: &mut PeirGen, label: i64, msg_off: i64) -> void {
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    // called: realign, shadow space
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, msg_off);
    PeirGen_call_runtime(self, "p_eprint_str");
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 1);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_EXIT_PROCESS));
    PeirEnc_ud2(&mut self.enc);
}

/// Start-up loader of the `link` DLLs (release E2, E4), `__pe_load_dlls`:
/// LoadLibraryA each DLL (its candidates in order: sqlite3.dll, then the
/// system's winsqlite3.dll), GetProcAddress each function the program
/// reaches into its IAT slot. A DLL or function that is not there gets a
/// stub instead: the first call into it stops the program with a message
/// naming what is missing (a static import would make Windows refuse to
/// start the program at all, with no message on a console), and a program
/// that never calls it runs.
pub fn PeirGen_gen_dll_loader(self: &mut PeirGen, rdata: &mut PeirRdata) -> void {
    var dlls: Vec<PeDllImport> = pe_dll_imports();
    if self.bare_mode || dlls.len() <= PE_STATIC_DLLS {
        return;
    }
    var label: i64 = PeirEnc_alloc_label(&mut self.enc);
    HashMap_insert(self.func_labels, "__pe_load_dlls", label);
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, label);
    // rsp = 8 (mod 16) on entry: rbx and the shadow space realign it
    PeirEnc_push(&mut self.enc, PEIR_RBX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    var load_lib: i64 = PeirGen_iat_off(self, pe_import_slot("LoadLibraryA"));
    var get_proc: i64 = PeirGen_iat_off(self, pe_import_slot("GetProcAddress"));
    // The failure stubs, generated after the loader: (label, message)
    var fail_labels: Vec<i64> = Vec::new();
    var fail_msgs: Vec<i64> = Vec::new();
    var slot_base: i64 = 0;
    var d: i64 = 0;
    while d < dlls.len() {
        var names: Vec<str> = dlls.get(d).names;
        if d >= PE_STATIC_DLLS {
            var dll: str = dlls.get(d).dll;
            var loaded: i64 = PeirEnc_alloc_label(&mut self.enc);
            var next_dll: i64 = PeirEnc_alloc_label(&mut self.enc);
            var cands: Vec<str> = pe_link_dll_candidates(dll);
            var also: str = "";
            var ci: i64 = 0;
            while ci < cands.len() {
                PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirRdata_add_string(rdata, cands.get(ci)));
                PeirEnc_call_rip(&mut self.enc, load_lib);
                PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                PeirEnc_jcc_label(&mut self.enc, 0x5, loaded);
                // jne
                if ci > 0 {
                    also = also + " or " + cands.get(ci);
                }
                ci = ci + 1;
            }
            // Not there: every function of it calls the DLL's stub
            var msg: str = "error: this program needs " + dll + also + ", which Windows could not load.\n" + "  Install the library, or put " + dll + " beside the program or in a folder on PATH.\n";
            var dll_stub: i64 = PeirEnc_alloc_label(&mut self.enc);
            fail_labels.push(dll_stub);
            fail_msgs.push(PeirRdata_add_string(rdata, msg));
            PeirEnc_lea_label(&mut self.enc, PEIR_RAX, dll_stub);
            var k: i64 = 0;
            while k < names.len() {
                PeirEnc_mov_rip_reg(&mut self.enc, PeirGen_iat_off(self, slot_base + k), PEIR_RAX);
                k = k + 1;
            }
            PeirEnc_jmp_label(&mut self.enc, next_dll);
            PeirEnc_place_label(&mut self.enc, loaded);
            PeirEnc_mov_rr(&mut self.enc, PEIR_RBX, PEIR_RAX);
            var j: i64 = 0;
            while j < names.len() {
                var found: i64 = PeirEnc_alloc_label(&mut self.enc);
                PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RBX);
                PeirEnc_lea_rip(&mut self.enc, PEIR_RDX, PeirRdata_add_string(rdata, names.get(j)));
                PeirEnc_call_rip(&mut self.enc, get_proc);
                PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                PeirEnc_jcc_label(&mut self.enc, 0x5, found);
                // jne
                var nmsg: str = "error: " + dll + " has no function " + names.get(j) + " (another version of the library?)\n";
                var fn_stub: i64 = PeirEnc_alloc_label(&mut self.enc);
                fail_labels.push(fn_stub);
                fail_msgs.push(PeirRdata_add_string(rdata, nmsg));
                PeirEnc_lea_label(&mut self.enc, PEIR_RAX, fn_stub);
                PeirEnc_place_label(&mut self.enc, found);
                PeirEnc_mov_rip_reg(&mut self.enc, PeirGen_iat_off(self, slot_base + j), PEIR_RAX);
                j = j + 1;
            }
            PeirEnc_place_label(&mut self.enc, next_dll);
        }
        slot_base = slot_base + names.len();
        d = d + 1;
    }
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_RBX);
    PeirEnc_ret(&mut self.enc);
    var fi: i64 = 0;
    while fi < fail_labels.len() {
        PeirGen_dll_fail(self, fail_labels.get(fi), fail_msgs.get(fi));
        fi = fi + 1;
    }
}

/// A thunk from the Fides convention (arguments in rcx, rdx, r8, r9 and
/// then the stack, floats as raw bits in integer registers, the result
/// in rax) to a C function of the import table (float arguments in
/// xmm0-3, a float result in xmm0, an `int` result in eax).
// Replace the pointer in register `n` (rax, rcx, rdx, r8 or r9) by the struct
// of `size` bytes it points at; 0 leaves it.
fn PeirGen_load_by_value(self: &mut PeirGen, n: i64, size: i64) -> void {
    var rex: i64 = 0x40;
    if n >= 8 {
        rex = 0x45;
    }
    var modrm: i64 = ((n & 7) << 3) | (n & 7);
    if size == 8 {
        pe_emit3(&mut self.enc, rex | 8, 0x8B, modrm);
    } else if size == 4 {
        pe_emit3(&mut self.enc, rex, 0x8B, modrm);
    } else if size == 2 {
        pe_emit4(&mut self.enc, rex, 0x0F, 0xB7, modrm);
    } else if size == 1 {
        pe_emit4(&mut self.enc, rex, 0x0F, 0xB6, modrm);
    }
}

// Widen the C argument in register `n`, whose upper bits are undefined.
fn PeirGen_widen_c_arg(self: &mut PeirGen, n: i64, ty: IrType) -> void {
    var rex: i64 = 0x40;
    if n >= 8 {
        rex = 0x45;
    }
    var modrm: i64 = 0xC0 | ((n & 7) << 3) | (n & 7);
    match ty {
        IrType::I32 => {
            pe_emit3(&mut self.enc, rex | 8, 0x63, modrm);
        }
        IrType::U32 => {
            pe_emit3(&mut self.enc, rex, 0x8B, modrm);
        }
        IrType::I16 => {
            pe_emit4(&mut self.enc, rex | 8, 0x0F, 0xBF, modrm);
        }
        IrType::U16 => {
            pe_emit4(&mut self.enc, rex, 0x0F, 0xB7, modrm);
        }
        IrType::I8 => {
            pe_emit4(&mut self.enc, rex | 8, 0x0F, 0xBE, modrm);
        }
        IrType::U8 => {
            pe_emit4(&mut self.enc, rex, 0x0F, 0xB6, modrm);
        }
        IrType::Bool => {
            pe_emit4(&mut self.enc, rex, 0x0F, 0xB6, modrm);
        }
        _ => {
        }
    }
}

pub fn PeirGen_gen_c_adapter(self: &mut PeirGen, a: &CAdapter) -> void {
    PeirGen_place_fn(self, a.name);
    var n: i64 = a.params.len();
    // The fourth C argument moves to the stack: `__env` takes rcx
    var stack_args: i64 = n + 1 - 4;
    if stack_args < 0 {
        stack_args = 0;
    }
    // On entry rsp = 8 (mod 16): the frame realigns it for the call
    var frame: i64 = 32 + 8 * stack_args;
    if frame % 16 == 0 {
        frame = frame + 8;
    }
    PeirEnc_sub_rsp_i32(&mut self.enc, frame);
    var regs: Vec<i64> = Vec::new();
    regs.push(PEIR_RCX);
    regs.push(PEIR_RDX);
    regs.push(PEIR_R8);
    regs.push(PEIR_R9);
    var i: i64 = 0;
    while i < n && i < 4 {
        var r: i64 = regs.get(i);
        var rex: i64 = 0x48;
        if r >= 8 {
            rex = 0x49;
        }
        var modrm: i64 = 0xC0 | (i << 3) | (r & 7);
        var ty: IrType = a.params.get(i);
        match ty {
            // movq r, xmm_i
            IrType::F64 => {
                pe_emit5(&mut self.enc, 0x66, rex, 0x0F, 0x7E, modrm);
            }
            // movd r32, xmm_i
            IrType::F32 => {
                pe_emit5(&mut self.enc, 0x66, rex & 0x41, 0x0F, 0x7E, modrm);
            }
            _ => {
                PeirGen_widen_c_arg(self, r, ty);
            }
        }
        i = i + 1;
    }
    i = 4;
    while i < n {
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, frame + 8 + 32 + 8 * (i - 4));
        PeirGen_widen_c_arg(self, 0, a.params.get(i));
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32 + 8 * (i - 3), PEIR_RAX);
        i = i + 1;
    }
    if n >= 4 {
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_R9);
    }
    pe_emit3(&mut self.enc, 0x4D, 0x89, 0xC1);
    // mov r9, r8
    pe_emit3(&mut self.enc, 0x49, 0x89, 0xD0);
    // mov r8, rdx
    pe_emit3(&mut self.enc, 0x48, 0x89, 0xCA);
    // mov rdx, rcx
    pe_emit2(&mut self.enc, 0x31, 0xC9);
    // xor ecx, ecx
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, a.target));
    match a.ret {
        IrType::F64 => {
            pe_emit5(&mut self.enc, 0x66, 0x48, 0x0F, 0x6E, 0xC0);
        }
        // movq xmm0, rax
        IrType::F32 => {
            pe_emit4(&mut self.enc, 0x66, 0x0F, 0x6E, 0xC0);
        }
        // movd xmm0, eax
        _ => {
        }
    }
    PeirEnc_add_rsp_i32(&mut self.enc, frame);
    PeirEnc_ret(&mut self.enc);
}

pub fn PeirGen_gen_c_thunk(self: &mut PeirGen, t: &CThunk) -> void {
    PeirGen_place_fn(self, t.name);
    var n: i64 = t.params.len();
    var stack_args: i64 = n - 4;
    if stack_args < 0 {
        stack_args = 0;
    }
    // A struct C returns in rax: the result pointer Fides passes first
    // waits in the frame, and the arguments move down one place
    var shift: i64 = 0;
    if t.ret_size > 0 {
        shift = 1;
    }
    var ret_slot: i64 = 32 + 8 * stack_args;
    // On entry rsp = 8 (mod 16): the frame realigns it for the call
    var frame: i64 = ret_slot + 8 * shift;
    if frame % 16 == 0 {
        frame = frame + 8;
    }
    PeirEnc_sub_rsp_i32(&mut self.enc, frame);
    if shift > 0 {
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, ret_slot, PEIR_RCX);
    }
    var i: i64 = 0;
    while i < stack_args {
        // The caller's fifth and later arguments: above our frame and
        // the return address, past the caller's 32-byte shadow space
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, frame + 8 + 32 + 8 * (i + shift));
        PeirGen_load_by_value(self, 0, t.by_value.get(4 + i));
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32 + 8 * i, PEIR_RAX);
        i = i + 1;
    }
    if shift > 0 {
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xD1);
        // mov rcx, rdx
        pe_emit3(&mut self.enc, 0x4C, 0x89, 0xC2);
        // mov rdx, r8
        pe_emit3(&mut self.enc, 0x4D, 0x89, 0xC8);
        // mov r8, r9
        if n >= 4 {
            PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R9, PEIR_RSP, frame + 8 + 32);
        }
    }
    var regs: Vec<i64> = Vec::new();
    regs.push(PEIR_RCX);
    regs.push(PEIR_RDX);
    regs.push(PEIR_R8);
    regs.push(PEIR_R9);
    var np: i64 = t.params.len();
    if np > 4 {
        np = 4;
    }
    i = 0;
    while i < np {
        PeirGen_load_by_value(self, regs.get(i), t.by_value.get(i));
        var ty: IrType = t.params.get(i);
        match ty {
            // The integer register keeps its copy: a variadic function
            // (_snprintf) reads a double from there
            IrType::F64 => {
                PeirEnc_movq_xmm_r64(&mut self.enc, i, regs.get(i));
            }
            IrType::F32 => {
                // movd xmm_i, r32
                PeirEnc_emit_u8(&mut self.enc, 0x66);
                if reg_ext(regs.get(i)) {
                    PeirEnc_emit_u8(&mut self.enc, 0x41);
                }
                pe_emit2(&mut self.enc, 0x0F, 0x6E);
                PeirEnc_modrm(&mut self.enc, 3, i, peir_reg_code(regs.get(i)));
            }
            _ => {
            }
        }
        i = i + 1;
    }
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, t.slot));
    match t.ret {
        IrType::F64 => {
            // movq rax, xmm0
            pe_emit5(&mut self.enc, 0x66, 0x48, 0x0F, 0x7E, 0xC0);
        }
        IrType::F32 => {
            // movd eax, xmm0
            pe_emit4(&mut self.enc, 0x66, 0x0F, 0x7E, 0xC0);
        }
        IrType::I32 => {
            // movsxd rax, eax
            pe_emit3(&mut self.enc, 0x48, 0x63, 0xC0);
        }
        IrType::U32 => {
            // mov eax, eax
            pe_emit2(&mut self.enc, 0x89, 0xC0);
        }
        IrType::I16 => {
            // movsx rax, ax
            pe_emit4(&mut self.enc, 0x48, 0x0F, 0xBF, 0xC0);
        }
        IrType::U16 => {
            // movzx eax, ax
            pe_emit3(&mut self.enc, 0x0F, 0xB7, 0xC0);
        }
        IrType::I8 => {
            // movsx rax, al
            pe_emit4(&mut self.enc, 0x48, 0x0F, 0xBE, 0xC0);
        }
        IrType::U8 => {
            // movzx eax, al
            pe_emit3(&mut self.enc, 0x0F, 0xB6, 0xC0);
        }
        // A C truth value is any non-zero int
        IrType::Bool => {
            // test eax, eax; sete al; movzx eax, al
            pe_emit8(&mut self.enc, 0x85, 0xC0, 0x0F, 0x95, 0xC0, 0x0F, 0xB6, 0xC0);
        }
        _ => {
        }
    }
    if shift > 0 {
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_RSP, ret_slot);
        if t.ret_size == 8 {
            pe_emit3(&mut self.enc, 0x48, 0x89, 0x01);
            // mov [rcx], rax
        } else if t.ret_size == 4 {
            pe_emit2(&mut self.enc, 0x89, 0x01);
            // mov [rcx], eax
        } else if t.ret_size == 2 {
            pe_emit3(&mut self.enc, 0x66, 0x89, 0x01);
            // mov [rcx], ax
        } else {
            pe_emit2(&mut self.enc, 0x88, 0x01);
            // mov [rcx], al
        }
    }
    PeirEnc_add_rsp_i32(&mut self.enc, frame);
    PeirEnc_ret(&mut self.enc);
}

/// The machine-code primitives of the Fides PE runtime (PE_PRIMITIVES),
/// and the stubs that hand over to it (PE_STUB_DEPS).
pub fn PeirGen_gen_pe_primitives(self: &mut PeirGen) -> void {
    // pe_atomic_load(addr) -> i64: an aligned 8-byte load is atomic
    // (MI20: each pe_ atomic is also its nat_ name, same bytes)
    PeirGen_place_fn(self, "pe_atomic_load");
    PeirGen_nat_alias(self, "nat_atomic_load");
    // mov rax, [rcx]; ret
    pe_emit4(&mut self.enc, 0x48, 0x8B, 0x01, 0xC3);
    // pe_atomic_store(addr, v): xchg locks and is a full barrier
    PeirGen_place_fn(self, "pe_atomic_store");
    PeirGen_nat_alias(self, "nat_atomic_store");
    // xchg [rcx], rdx; ret
    pe_emit4(&mut self.enc, 0x48, 0x87, 0x11, 0xC3);
    // pe_atomic_add(addr, v) -> previous value
    PeirGen_place_fn(self, "pe_atomic_add");
    PeirGen_nat_alias(self, "nat_atomic_add");
    // mov rax, rdx
    pe_emit3(&mut self.enc, 0x48, 0x89, 0xD0);
    // lock xadd [rcx], rax; ret
    pe_emit6(&mut self.enc, 0xF0, 0x48, 0x0F, 0xC1, 0x01, 0xC3);
    // pe_atomic_cas(addr, expected, new) -> bool (swapped)
    PeirGen_place_fn(self, "pe_atomic_cas");
    PeirGen_nat_alias(self, "nat_atomic_cas");
    // mov rax, rdx
    pe_emit3(&mut self.enc, 0x48, 0x89, 0xD0);
    // lock cmpxchg [rcx], r8
    pe_emit5(&mut self.enc, 0xF0, 0x4C, 0x0F, 0xB1, 0x01);
    // sete al; movzx eax, al; ret
    pe_emit6(&mut self.enc, 0x0F, 0x94, 0xC0, 0x0F, 0xB6, 0xC0);
    pe_emit1(&mut self.enc, 0xC3);
    // pe_f64_to_bits / pe_bits_to_f64: Fides passes a float as its bits
    var bits: i64 = HashMap_get(self.func_labels, "pe_bits_to_f64");
    PeirGen_place_fn(self, "pe_f64_to_bits");
    PeirEnc_place_label(&mut self.enc, bits);
    // mov rax, rcx; ret
    pe_emit4(&mut self.enc, 0x48, 0x89, 0xC8, 0xC3);
    // pe_f64_to_f32_bits(x) -> the bits of (f32)x
    PeirGen_place_fn(self, "pe_f64_to_f32_bits");
    PeirEnc_movq_xmm_r64(&mut self.enc, 0, PEIR_RCX);
    // cvtsd2ss xmm0, xmm0
    pe_emit4(&mut self.enc, 0xF2, 0x0F, 0x5A, 0xC0);
    // movd eax, xmm0; ret
    pe_emit5(&mut self.enc, 0x66, 0x0F, 0x7E, 0xC0, 0xC3);
    // pe_f32_bits_to_f64(bits) -> (f64) of the f32 with those bits
    PeirGen_place_fn(self, "pe_f32_bits_to_f64");
    // movd xmm0, ecx
    pe_emit4(&mut self.enc, 0x66, 0x0F, 0x6E, 0xC1);
    // cvtss2sd xmm0, xmm0
    pe_emit4(&mut self.enc, 0xF3, 0x0F, 0x5A, 0xC0);
    // movq rax, xmm0; ret
    pe_emit5(&mut self.enc, 0x66, 0x48, 0x0F, 0x7E, 0xC0);
    pe_emit1(&mut self.enc, 0xC3);

    // pe_fn_lookup(name) -> the address of the program function of that
    // name (one named by a string constant), or 0
    PeirGen_place_fn(self, "pe_fn_lookup");
    PeirEnc_push(&mut self.enc, PEIR_RBX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBX, PEIR_RCX);
    var done: i64 = PeirEnc_alloc_label(&mut self.enc);
    var strcmp: i64 = PeirGen_iat_off(self, pe_import_slot("strcmp"));
    var fi: i64 = 0;
    while fi < self.named_fns.len() {
        var f: str = self.named_fns.get(fi);
        var next: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RBX);
        var off: i64 = PeirGen_str_off(self, f);
        PeirEnc_lea_rip(&mut self.enc, PEIR_RDX, off);
        PeirEnc_call_rip(&mut self.enc, strcmp);
        pe_emit2(&mut self.enc, 0x85, 0xC0);
        // test eax, eax
        PeirEnc_jcc_label(&mut self.enc, 0x5, next);
        // jne
        var flabel: i64 = HashMap_get(self.func_labels, f);
        PeirEnc_lea_label(&mut self.enc, PEIR_RAX, flabel);
        PeirEnc_jmp_label(&mut self.enc, done);
        PeirEnc_place_label(&mut self.enc, next);
        fi = fi + 1;
    }
    PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, done);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_RBX);
    PeirEnc_ret(&mut self.enc);

    // pe_call_fn(addr, nargs, argv) -> result: call the Fides function at
    // addr with a null __env and argv[0..8] (argv has 8 slots; the
    // function reads the ones it has parameters for)
    PeirGen_place_fn(self, "pe_call_fn");
    PeirGen_nat_alias(self, "nat_call_fn");
    PeirEnc_push(&mut self.enc, PEIR_RBX);
    PeirEnc_push(&mut self.enc, PEIR_RSI);
    PeirEnc_sub_rsp_i32(&mut self.enc, 72);
    // 8 + 16 + 72: aligned
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBX, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSI, PEIR_R8);
    var ai: i64 = 3;
    while ai < 8 {
        // argv[i] is parameter i + 1 (after __env): a stack argument
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSI, 8 * ai);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32 + 8 * (ai - 3), PEIR_RAX);
        ai = ai + 1;
    }
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_RSI, 0);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R8, PEIR_RSI, 8);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R9, PEIR_RSI, 16);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_call_reg(&mut self.enc, PEIR_RBX);
    PeirEnc_add_rsp_i32(&mut self.enc, 72);
    PeirEnc_pop(&mut self.enc, PEIR_RSI);
    PeirEnc_pop(&mut self.enc, PEIR_RBX);
    PeirEnc_ret(&mut self.enc);

    // pe_call_c1(addr, arg) -> result: call the C function at addr (one
    // GetProcAddress found: p_dl_call, roadmap L6C) with arg in rcx and its
    // own shadow space; rax comes back
    PeirGen_place_fn(self, "pe_call_c1");
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    // 8 + 40: aligned
    PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RDX);
    PeirEnc_call_reg(&mut self.enc, PEIR_R10);
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_ret(&mut self.enc);

    // The thread start routine (C convention: rcx = the argument) runs
    // pert_thread_main(arg); Windows expects the callee-saved registers
    // back. pe_thread_entry_addr() gives its address for CreateThread.
    if HashMap_contains(self.func_labels, "pe_thread_entry_addr") {
        var entry: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, entry);
        var saved: Vec<i64> = Vec::new();
        saved.push(PEIR_RBX);
        saved.push(PEIR_RSI);
        saved.push(PEIR_RDI);
        saved.push(PEIR_R12);
        saved.push(PEIR_R13);
        saved.push(PEIR_R14);
        saved.push(PEIR_R15);
        saved.push(PEIR_RBP);
        var ri: i64 = 0;
        while ri < saved.len() {
            PeirEnc_push(&mut self.enc, saved.get(ri));
            ri = ri + 1;
        }
        PeirEnc_sub_rsp_i32(&mut self.enc, 40);
        // 8 + 64 + 40: aligned
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirGen_call_runtime(self, "pert_thread_main");
        PeirEnc_add_rsp_i32(&mut self.enc, 40);
        ri = saved.len() - 1;
        while ri >= 0 {
            PeirEnc_pop(&mut self.enc, saved.get(ri));
            ri = ri - 1;
        }
        PeirEnc_ret(&mut self.enc);
        PeirGen_place_fn(self, "pe_thread_entry_addr");
        PeirEnc_lea_label(&mut self.enc, PEIR_RAX, entry);
        PeirEnc_ret(&mut self.enc);
    }

    // Task context switch and the trampoline a new task starts in (RT9);
    // MI20: the same code under nat_ctx_swap / nat_ctx_tramp (the runtime
    // that makes a context decides its saved layout, as on every target)
    var pe_swap: bool = HashMap_contains(self.func_labels, "pe_ctx_swap");
    if pe_swap || PeirGen_nat_wanted(self, "nat_ctx_swap") {
        PeirEnc_align_to(&mut self.enc, 16);
        if pe_swap {
            PeirGen_place_fn(self, "pe_ctx_swap");
        }
        PeirGen_nat_alias(self, "nat_ctx_swap");
        PeirEnc_emit(&mut self.enc, pe_ctx_swap_code());
    }
    var pe_tramp: bool = HashMap_contains(self.func_labels, "pe_ctx_tramp_addr");
    if pe_tramp || PeirGen_nat_wanted(self, "nat_ctx_tramp") {
        var tramp: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, tramp);
        PeirEnc_emit(&mut self.enc, pe_ctx_tramp_code());
        PeirEnc_align_to(&mut self.enc, 16);
        if pe_tramp {
            PeirGen_place_fn(self, "pe_ctx_tramp_addr");
        }
        PeirGen_nat_alias(self, "nat_ctx_tramp");
        PeirEnc_lea_label(&mut self.enc, PEIR_RAX, tramp);
        PeirEnc_ret(&mut self.enc);
    }

    // p_thread_spawn(name, nargs, args...): varargs. The first two
    // arguments go to the caller's shadow slots, next to the ones on
    // the stack: one array, handed to pert_thread_spawn_v(name, nargs,
    // argv) (still inside the caller's frame while it runs).
    if HashMap_contains(self.func_labels, "p_thread_spawn") {
        PeirGen_place_fn(self, "p_thread_spawn");
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 24, PEIR_R8);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_R9);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RDX);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        // lea r9, [rsp+24]
        pe_emit5(&mut self.enc, 0x4C, 0x8D, 0x4C, 0x24, 0x18);
        var target: i64 = HashMap_get(self.func_labels, "pert_thread_spawn_v");
        PeirEnc_jmp_label(&mut self.enc, target);
    }
    // p_co_async(name, nargs, args...): likewise
    if HashMap_contains(self.func_labels, "p_co_async") {
        PeirGen_place_fn(self, "p_co_async");
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 24, PEIR_R8);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_R9);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RDX);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        pe_emit5(&mut self.enc, 0x4C, 0x8D, 0x4C, 0x24, 0x18);
        // lea r9, [rsp+24]
        PeirEnc_jmp_label(&mut self.enc, HashMap_get(self.func_labels, "pert_co_async_v"));
    }
    // p_executor_spawn(exec, name, nargs, args...): likewise, from the
    // fourth argument; pert_executor_spawn_v(name, nargs, argv)
    if HashMap_contains(self.func_labels, "p_executor_spawn") {
        PeirGen_place_fn(self, "p_executor_spawn");
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_R9);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        // lea r9, [rsp+32]
        pe_emit5(&mut self.enc, 0x4C, 0x8D, 0x4C, 0x24, 0x20);
        var target2: i64 = HashMap_get(self.func_labels, "pert_executor_spawn_v");
        PeirEnc_jmp_label(&mut self.enc, target2);
    }

    // MI20: the rest of the nat_* interface
    PeirGen_gen_nat_prims(self);
}

// ===========================================================================
// MI20: the nat_* primitive interface on pe_ir
// ===========================================================================
// pe_ir defines every name of prim_interface_names, with the contract the
// machine layer's targets give it (compiler/nat_ir.fd): the same name, the
// same arguments and result. pe_ir's convention for a primitive is C's:
// arguments in rcx, rdx, r8, r9, then the stack; rax back; rax, rcx, rdx,
// r8-r11 clobbered (stdlib/pe_runtime declares them `extern "C"`). What is
// Windows' own: there are no Linux system calls (nat_syscall gives
// -ENOSYS), a thread gets its own stack from CreateThread (nat_clone_thread
// ignores stack_top), the "signal handler" is the vectored exception
// handler (crash_filter), and nat_start_sp's block is built from the
// command line. The atomics, nat_call_fn, nat_ctx_swap and nat_ctx_tramp
// share their pe_ twin's bytes (PeirGen_nat_alias). A primitive is made
// only when the program reaches it, or all of them under FID_VERIFY=1, when
// PeirGen_nat_check (pe_ir.fd) fails the build if one is missing.

/// MI20: place nat primitive `name`'s label here, beside the pe_ primitive
/// of the same code (no bytes of its own); nothing when a program function
/// has the name or the label is placed already.
fn PeirGen_nat_alias(self: &mut PeirGen, name: str) -> void {
    if HashMap_contains(self.nat_own, name) {
        var l: i64 = HashMap_get(self.func_labels, name);
        if self.enc.labels.get(l) < 0 {
            PeirEnc_place_label(&mut self.enc, l);
        }
    }
}

/// MI20: nat primitive `name` is made: an extern declaration the program
/// reaches names it (pe_ir.fd fills nat_wanted), or FID_VERIFY=1.
pub fn PeirGen_nat_wanted(self: &PeirGen, name: str) -> bool {
    if !HashMap_contains(self.nat_own, name) {
        return false;
    }
    return pe_verify_on() || HashMap_contains(self.nat_wanted, name);
}

/// MI20: the nat_* primitives that have no pe_ twin.
fn PeirGen_gen_nat_prims(self: &mut PeirGen) -> void {
    var abase: i64 = self.alloc_rdata_off;
    var tls: bool = PeirGen_nat_wanted(self, "nat_tls_get") || PeirGen_nat_wanted(self, "nat_tls_set");

    // nat_syscall(n, a, b, c, d, e, f): a Windows process makes no Linux
    // system calls (pe_ir's runtime calls kernel32): -ENOSYS, what the
    // kernel answers a number it does not have
    if PeirGen_nat_wanted(self, "nat_syscall") {
        PeirGen_place_fn(self, "nat_syscall");
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 0 - 38);
        PeirEnc_ret(&mut self.enc);
    }

    // nat_clone_thread(entry, arg, stack_top, ctid, tls) -> thread id, or
    // -EAGAIN: CreateThread (8 MB reserved; stack_top is not used, Windows
    // gives the thread its stack) on a start routine that sets the thread
    // word to tls, runs entry(env 0, arg) and clears *ctid (when not 0) as
    // the kernel's CLONE_CHILD_CLEARTID does (no futex wake: nothing in a
    // Windows process waits on it)
    if PeirGen_nat_wanted(self, "nat_clone_thread") {
        var start: i64 = PeirEnc_alloc_label(&mut self.enc);
        var fail_free: i64 = PeirEnc_alloc_label(&mut self.enc);
        var fail: i64 = PeirEnc_alloc_label(&mut self.enc);
        var out: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirGen_place_fn(self, "nat_clone_thread");
        PeirEnc_push(&mut self.enc, PEIR_RBX);
        PeirEnc_sub_rsp_i32(&mut self.enc, 80);
        // 8 + 8 + 80: aligned. [rsp+32], [rsp+40] CreateThread's fifth and
        // sixth arguments, [rsp+48] entry, [rsp+56] arg, [rsp+64] ctid,
        // [rsp+72] the thread id; tls (the caller's fifth) is at [rsp+128]
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 48, PEIR_RCX);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 56, PEIR_RDX);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 64, PEIR_R9);
        // The start block {entry, arg, ctid, tls}: the new thread frees it
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 32);
        PeirGen_call_runtime(self, "p_malloc");
        PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_jcc_label(&mut self.enc, 0x4, fail);
        // jz
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBX, PEIR_RAX);
        var k: i64 = 0;
        while k < 3 {
            PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, 48 + 8 * k);
            PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RBX, 8 * k, PEIR_RAX);
            k = k + 1;
        }
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, 128);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RBX, 24, PEIR_RAX);
        // CreateThread(NULL, 8 MB, start, block,
        //              STACK_SIZE_PARAM_IS_A_RESERVATION, &id)
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 72, PEIR_RAX);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 0x10000);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
        PeirEnc_lea_base_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, 72);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 40, PEIR_RAX);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 8388608);
        PeirEnc_lea_label(&mut self.enc, PEIR_R8, start);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RBX);
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("CreateThread")));
        PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_jcc_label(&mut self.enc, 0x4, fail_free);
        // jz: the thread did not start, the block is still ours
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_CLOSE_HANDLE));
        // the id (a DWORD in a zeroed word)
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, 72);
        PeirEnc_jmp_label(&mut self.enc, out);
        PeirEnc_place_label(&mut self.enc, fail_free);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RBX);
        PeirGen_call_runtime(self, "p_free");
        PeirEnc_place_label(&mut self.enc, fail);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 0 - 11);
        PeirEnc_place_label(&mut self.enc, out);
        PeirEnc_add_rsp_i32(&mut self.enc, 80);
        PeirEnc_pop(&mut self.enc, PEIR_RBX);
        PeirEnc_ret(&mut self.enc);

        // The start routine (rcx = the block). Windows expects rbx and rsi
        // back; returning ends the thread.
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, start);
        PeirEnc_push(&mut self.enc, PEIR_RBX);
        PeirEnc_push(&mut self.enc, PEIR_RSI);
        PeirEnc_sub_rsp_i32(&mut self.enc, 40);
        // 8 + 16 + 40: aligned; [rsp+32] keeps arg
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBX, PEIR_RCX);
        if tls {
            // TlsSetValue(index, tls): the thread word nat_tls_get reads
            PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RCX, abase + PEIR_NAT_TLS);
            PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_RBX, 24);
            PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("TlsSetValue")));
        }
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RSI, PEIR_RBX, 16);
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RBX, 8);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RBX);
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RBX, PEIR_RCX, 0);
        // rbx = entry; the block goes back
        PeirGen_call_runtime(self, "p_free");
        // entry(env 0, arg)
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_RSP, 32);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirEnc_call_reg(&mut self.enc, PEIR_RBX);
        var no_ctid: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_test_rr(&mut self.enc, PEIR_RSI, PEIR_RSI);
        PeirEnc_jcc_label(&mut self.enc, 0x4, no_ctid);
        // jz
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        // xchg [rsi], rax: *ctid = 0, a full barrier
        pe_emit3(&mut self.enc, 0x48, 0x87, 0x06);
        PeirEnc_place_label(&mut self.enc, no_ctid);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_add_rsp_i32(&mut self.enc, 40);
        PeirEnc_pop(&mut self.enc, PEIR_RSI);
        PeirEnc_pop(&mut self.enc, PEIR_RBX);
        PeirEnc_ret(&mut self.enc);
    }

    // The thread word: a TLS slot the entry point allocates (index at
    // abase + PEIR_NAT_TLS), through TlsGetValue / TlsSetValue
    if PeirGen_nat_wanted(self, "nat_tls_get") {
        PeirGen_place_fn(self, "nat_tls_get");
        PeirEnc_sub_rsp_i32(&mut self.enc, 40);
        PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RCX, abase + PEIR_NAT_TLS);
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("TlsGetValue")));
        PeirEnc_add_rsp_i32(&mut self.enc, 40);
        PeirEnc_ret(&mut self.enc);
    }
    if PeirGen_nat_wanted(self, "nat_tls_set") {
        PeirGen_place_fn(self, "nat_tls_set");
        PeirEnc_sub_rsp_i32(&mut self.enc, 40);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RCX, abase + PEIR_NAT_TLS);
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("TlsSetValue")));
        PeirEnc_add_rsp_i32(&mut self.enc, 40);
        PeirEnc_ret(&mut self.enc);
    }

    // Signals: on Windows the vectored exception handler the entry point
    // installs (crash_filter: a CPU fault becomes a panic); no restorer
    // (0), as the machine layer's --nat Windows
    if PeirGen_nat_wanted(self, "nat_sig_handler") {
        PeirGen_place_fn(self, "nat_sig_handler");
        PeirEnc_lea_label(&mut self.enc, PEIR_RAX, self.crash_filter);
        PeirEnc_ret(&mut self.enc);
    }
    if PeirGen_nat_wanted(self, "nat_sig_restorer") {
        PeirGen_place_fn(self, "nat_sig_restorer");
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_ret(&mut self.enc);
    }

    // Traces: every pe_ir function keeps an rbp frame record ([rbp] the
    // caller's rbp, [rbp+8] the return address)
    if PeirGen_nat_wanted(self, "nat_frame_fp") {
        PeirGen_place_fn(self, "nat_frame_fp");
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RBP);
        PeirEnc_ret(&mut self.enc);
    }
    if PeirGen_nat_wanted(self, "nat_frame_ret") {
        PeirGen_place_fn(self, "nat_frame_ret");
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8);
        PeirEnc_ret(&mut self.enc);
    }
    if PeirGen_nat_wanted(self, "nat_frame_next") {
        PeirGen_place_fn(self, "nat_frame_next");
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 0);
        PeirEnc_ret(&mut self.enc);
    }
    // The tables (PeirGen_gen_nat_tables places them after all code)
    if PeirGen_nat_wanted(self, "nat_fn_names") {
        self.nat_names_tab = PeirEnc_alloc_label(&mut self.enc);
        PeirGen_place_fn(self, "nat_fn_names");
        PeirEnc_lea_label(&mut self.enc, PEIR_RAX, self.nat_names_tab);
        PeirEnc_ret(&mut self.enc);
    }
    if PeirGen_nat_wanted(self, "nat_fn_table") {
        self.nat_fntab_tab = PeirEnc_alloc_label(&mut self.enc);
        PeirGen_place_fn(self, "nat_fn_table");
        PeirEnc_lea_label(&mut self.enc, PEIR_RAX, self.nat_fntab_tab);
        PeirEnc_ret(&mut self.enc);
    }

    // nat_start_sp() -> the start block the entry point made (0 if none)
    if PeirGen_nat_wanted(self, "nat_start_sp") {
        PeirGen_place_fn(self, "nat_start_sp");
        PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, abase + PEIR_NAT_SSP);
        PeirEnc_ret(&mut self.enc);
    }

    // The target: NAT_X64 (nat_enc.fd: 3), Windows (1)
    if PeirGen_nat_wanted(self, "nat_arch") {
        PeirGen_place_fn(self, "nat_arch");
        PeirEnc_mov_imm(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_ret(&mut self.enc);
    }
    if PeirGen_nat_wanted(self, "nat_os") {
        PeirGen_place_fn(self, "nat_os");
        PeirEnc_mov_imm(&mut self.enc, PEIR_RAX, 1);
        PeirEnc_ret(&mut self.enc);
    }
    // nat_fma(a, b, c): a * b + c rounded once, on the bits of f64s (FMA3,
    // x86-64-v3, as the machine layer's x86-64)
    if PeirGen_nat_wanted(self, "nat_fma") {
        PeirGen_place_fn(self, "nat_fma");
        PeirEnc_movq_xmm_r64(&mut self.enc, 0, PEIR_RCX);
        PeirEnc_movq_xmm_r64(&mut self.enc, 1, PEIR_RDX);
        PeirEnc_movq_xmm_r64(&mut self.enc, 2, PEIR_R8);
        // vfmadd213sd xmm0, xmm1, xmm2
        pe_emit5(&mut self.enc, 0xC4, 0xE2, 0xF1, 0xA9, 0xC2);
        PeirEnc_movq_r64_xmm(&mut self.enc, PEIR_RAX, 0);
        PeirEnc_ret(&mut self.enc);
    }
}

/// MI20, in the entry point (rsp 16-aligned with its 32 bytes of shadow
/// space; the process ends without returning, so rbx, rsi and rdi are
/// free): the TLS index of nat_tls_get / nat_tls_set, and the start block
/// nat_start_sp returns, [argc][argv 0 .. argc-1][0][0] (no environment),
/// the layout of the kernel's initial stack on Linux, from the p_argc and
/// p_argv stubs.
fn PeirGen_gen_nat_entry(self: &mut PeirGen) -> void {
    var abase: i64 = self.alloc_rdata_off;
    if PeirGen_nat_wanted(self, "nat_tls_get") || PeirGen_nat_wanted(self, "nat_tls_set") {
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("TlsAlloc")));
        pe_emit2(&mut self.enc, 0x89, 0xC0);
        // mov eax, eax (zero-extend the DWORD)
        PeirEnc_mov_rip_reg(&mut self.enc, abase + PEIR_NAT_TLS, PEIR_RAX);
    }
    if PeirGen_nat_wanted(self, "nat_start_sp") {
        var lp: i64 = PeirEnc_alloc_label(&mut self.enc);
        var lend: i64 = PeirEnc_alloc_label(&mut self.enc);
        var none: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirGen_call_runtime(self, "p_argc");
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBX, PEIR_RAX);
        // (argc + 3) words
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 3);
        PeirEnc_add_r_i32(&mut self.enc, PEIR_RCX, 24);
        PeirGen_call_runtime(self, "p_malloc");
        PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_jcc_label(&mut self.enc, 0x4, none);
        // jz
        PeirEnc_mov_rr(&mut self.enc, PEIR_RSI, PEIR_RAX);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSI, 0, PEIR_RBX);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RDI, PEIR_RDI);
        PeirEnc_place_label(&mut self.enc, lp);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RDI, PEIR_RBX);
        PeirEnc_jcc_label(&mut self.enc, 0xD, lend);
        // jge
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RDI);
        PeirGen_call_runtime(self, "p_argv");
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RDI);
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RDX, PEIR_RSI);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RDX, 8, PEIR_RAX);
        PeirEnc_inc_r(&mut self.enc, PEIR_RDI);
        PeirEnc_jmp_label(&mut self.enc, lp);
        PeirEnc_place_label(&mut self.enc, lend);
        // argv's NULL, then an empty environment
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RBX);
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RDX, PEIR_RSI);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RDX, 8, PEIR_RAX);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RDX, 16, PEIR_RAX);
        PeirEnc_mov_rip_reg(&mut self.enc, abase + PEIR_NAT_SSP, PEIR_RSI);
        PeirEnc_place_label(&mut self.enc, none);
    }
}

/// Copy `size` bytes from [rcx] to [rax] (clobbers rax, rcx, rdx):
/// 8 bytes at a time, then single bytes, never past `size`.
pub fn PeirGen_emit_copy_rcx_to_rax(self: &mut PeirGen, size: i64) -> void {
    if size >= 128 {
        // Large copies: rep movsq + rep movsb tail. 16x smaller code than
        // the unrolled loop below; rsi/rdi are callee-saved, so they are
        // preserved (some emitted frames keep live values in them).
        PeirEnc_push(&mut self.enc, PEIR_RSI);
        PeirEnc_push(&mut self.enc, PEIR_RDI);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RSI, PEIR_RCX);
        // src
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDI, PEIR_RAX);
        // dst
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, size / 8);
        var movsq: Vec<i64> = Vec::new();
        movsq.push(0xF3);
        movsq.push(0x48);
        movsq.push(0xA5);
        PeirEnc_emit(&mut self.enc, movsq);
        // rep movsq
        var tail: i64 = size % 8;
        if tail > 0 {
            PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, tail);
            var movsb: Vec<i64> = Vec::new();
            movsb.push(0xF3);
            movsb.push(0xA4);
            PeirEnc_emit(&mut self.enc, movsb);
            // rep movsb
        }
        PeirEnc_pop(&mut self.enc, PEIR_RDI);
        PeirEnc_pop(&mut self.enc, PEIR_RSI);
        return;
    }
    var offset: i64 = 0;
    while offset + 8 <= size {
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_RCX, offset);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, offset, PEIR_RDX);
        offset = offset + 8;
    }
    if offset < size {
        PeirEnc_add_r_i32(&mut self.enc, PEIR_RCX, offset);
        PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, offset);
        while offset < size {
            PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RDX, PEIR_RCX);
            PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_RAX, PEIR_RDX);
            PeirEnc_add_r_i8(&mut self.enc, PEIR_RCX, 1);
            PeirEnc_add_r_i8(&mut self.enc, PEIR_RAX, 1);
            offset = offset + 1;
        }
    }
}

/// p_arena_save -> 0, p_arena_restore / p_region_free: no-ops.  Heap
/// memory here is never reused, so there is nothing to give back (as in
/// the interpreter).
pub fn PeirGen_gen_arena_stubs(self: &mut PeirGen) -> void {
    var names: Vec<str> = Vec::new();
    names.push("p_arena_save");
    // returns_zero = true
    names.push("p_arena_restore");
    // returns_zero = false
    names.push("p_region_free");
    // returns_zero = false
    var i: i64 = 0;
    while i < names.len() {
        var name: str = names.get(i);
        if HashMap_contains(self.func_labels, name) {
            var label: i64 = HashMap_get(self.func_labels, name);
            PeirEnc_place_label(&mut self.enc, label);
            if i == 0 {
                PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
            }
            PeirEnc_ret(&mut self.enc);
        }
        i = i + 1;
    }
}

// ===========================================================================
// asm!() in bare builds (release G2): Intel-syntax templates encoded here.
// One instruction per `;` or line. What is covered: the system and fence
// instructions, port I/O, control registers, register-register ALU, mov
// of an immediate, push/pop, inc/dec/neg/not, int N, and lgdt/lidt/invlpg
// through a register. Anything else is a compile error naming it.
// ===========================================================================

pub struct PeAsmOut {
    pub b: Vec<i64>,
}

pub struct PeAsmResult {
    pub bytes: Vec<i64>,
    pub error: str,
}

/// 64-bit register number of `s` (rax=0 .. r15=15), else -1.
pub fn pe_asm_reg64(s: str) -> i64 {
    var names: Vec<str> = Vec::new();
    names.push("rax");
    names.push("rcx");
    names.push("rdx");
    names.push("rbx");
    names.push("rsp");
    names.push("rbp");
    names.push("rsi");
    names.push("rdi");
    names.push("r8");
    names.push("r9");
    names.push("r10");
    names.push("r11");
    names.push("r12");
    names.push("r13");
    names.push("r14");
    names.push("r15");
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == s {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Control register number of `s` (cr0, cr2, cr3, cr4, cr8), else -1.
fn pe_asm_cr(s: str) -> i64 {
    if s == "cr0" {
        return 0;
    }
    if s == "cr2" {
        return 2;
    }
    if s == "cr3" {
        return 3;
    }
    if s == "cr4" {
        return 4;
    }
    if s == "cr8" {
        return 8;
    }
    return -1;
}

fn pe_asm_digit(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    return -1;
}

/// Is `s` a number (decimal, 0x hex, or a trailing-h hex)?
fn pe_asm_is_num(s: str) -> bool {
    var t: str = s;
    if str_starts_with(t, "-") {
        t = str_slice(t, 1, str_len(t));
    }
    if str_len(t) == 0 {
        return false;
    }
    var base: i64 = 10;
    if str_starts_with(t, "0x") {
        t = str_slice(t, 2, str_len(t));
        base = 16;
    } else if str_ends_with(t, "h") {
        t = str_slice(t, 0, str_len(t) - 1);
        base = 16;
    }
    if str_len(t) == 0 {
        return false;
    }
    var i: i64 = 0;
    while i < str_len(t) {
        var d: i64 = pe_asm_digit(str_byte_at(t, i));
        if d < 0 || d >= base {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn pe_asm_num(s: str) -> i64 {
    var t: str = s;
    var neg: bool = false;
    if str_starts_with(t, "-") {
        t = str_slice(t, 1, str_len(t));
        neg = true;
    }
    var base: i64 = 10;
    if str_starts_with(t, "0x") {
        t = str_slice(t, 2, str_len(t));
        base = 16;
    } else if str_ends_with(t, "h") {
        t = str_slice(t, 0, str_len(t) - 1);
        base = 16;
    }
    var v: i64 = 0;
    var i: i64 = 0;
    while i < str_len(t) {
        v = v * base + pe_asm_digit(str_byte_at(t, i));
        i = i + 1;
    }
    if neg {
        return 0 - v;
    }
    return v;
}

fn pe_asm_push4(o: &mut PeAsmOut, x: i64) {
    o.b.push(x & 0xFF);
    o.b.push((x >> 8) & 0xFF);
    o.b.push((x >> 16) & 0xFF);
    o.b.push((x >> 24) & 0xFF);
}

/// REX for reg field `r` and r/m `b` (W set when `w`); 0 when none is needed.
fn pe_asm_rex(w: bool, r: i64, b: i64) -> i64 {
    var x: i64 = 0x40;
    if w {
        x = x | 8;
    }
    if r >= 8 {
        x = x | 4;
    }
    if b >= 8 {
        x = x | 1;
    }
    if x == 0x40 {
        return 0;
    }
    return x;
}

/// [reg] memory operand: the register, else -1.
fn pe_asm_mem_reg(s: str) -> i64 {
    var t: str = s;
    if str_starts_with(t, "qword ptr ") {
        t = str_trim(str_slice(t, 10, str_len(t)));
    }
    if !str_starts_with(t, "[") || !str_ends_with(t, "]") {
        return -1;
    }
    return pe_asm_reg64(str_trim(str_slice(t, 1, str_len(t) - 1)));
}

/// opcode bytes `op` with ModRM reg field `ext` and memory operand [r].
fn pe_asm_mem_op(o: &mut PeAsmOut, op: Vec<i64>, ext: i64, r: i64) {
    var rex: i64 = pe_asm_rex(false, 0, r);
    if rex != 0 {
        o.b.push(rex);
    }
    var i: i64 = 0;
    while i < op.len() {
        o.b.push(op.get(i));
        i = i + 1;
    }
    var low: i64 = r & 7;
    if low == 5 {
        o.b.push(0x40 | (ext << 3) | 5);
        o.b.push(0);
        // [rbp/r13 + 0]
    } else if low == 4 {
        o.b.push((ext << 3) | 4);
        o.b.push(0x24);
        // SIB: [rsp/r12]
    } else {
        o.b.push((ext << 3) | low);
    }
}

fn pe_asm_fixed(m: str) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    if m == "nop" {
        v.push(0x90);
    } else if m == "cli" {
        v.push(0xFA);
    } else if m == "sti" {
        v.push(0xFB);
    } else if m == "hlt" {
        v.push(0xF4);
    } else if m == "pause" {
        v.push(0xF3);
        v.push(0x90);
    } else if m == "mfence" {
        v.push(0x0F);
        v.push(0xAE);
        v.push(0xF0);
    } else if m == "sfence" {
        v.push(0x0F);
        v.push(0xAE);
        v.push(0xF8);
    } else if m == "lfence" {
        v.push(0x0F);
        v.push(0xAE);
        v.push(0xE8);
    } else if m == "cld" {
        v.push(0xFC);
    } else if m == "std" {
        v.push(0xFD);
    } else if m == "leave" {
        v.push(0xC9);
    } else if m == "ret" {
        v.push(0xC3);
    } else if m == "iretq" {
        v.push(0x48);
        v.push(0xCF);
    } else if m == "int3" {
        v.push(0xCC);
    } else if m == "wbinvd" {
        v.push(0x0F);
        v.push(0x09);
    } else if m == "invd" {
        v.push(0x0F);
        v.push(0x08);
    } else if m == "rdmsr" {
        v.push(0x0F);
        v.push(0x32);
    } else if m == "wrmsr" {
        v.push(0x0F);
        v.push(0x30);
    } else if m == "cpuid" {
        v.push(0x0F);
        v.push(0xA2);
    } else if m == "rdtsc" {
        v.push(0x0F);
        v.push(0x31);
    } else if m == "swapgs" {
        v.push(0x0F);
        v.push(0x01);
        v.push(0xF8);
    } else if m == "syscall" {
        v.push(0x0F);
        v.push(0x05);
    } else if m == "sysretq" {
        v.push(0x48);
        v.push(0x0F);
        v.push(0x07);
    } else if m == "ud2" {
        v.push(0x0F);
        v.push(0x0B);
    } else if m == "pushfq" {
        v.push(0x9C);
    } else if m == "popfq" {
        v.push(0x9D);
    } else if m == "clts" {
        v.push(0x0F);
        v.push(0x06);
    }
    return v;
}

/// Encode one instruction into `out`; "" or the reason it is not supported.
fn pe_asm_one(o: &mut PeAsmOut, line: str) -> str {
    var s: str = str_trim(str_to_lower(line));
    if str_len(s) == 0 {
        return "";
    }
    var sp: i64 = 0;
    while sp < str_len(s) && str_byte_at(s, sp) != 32 && str_byte_at(s, sp) != 9 {
        sp = sp + 1;
    }
    var m: str = str_slice(s, 0, sp);
    var rest: str = str_trim(str_slice(s, sp, str_len(s)));
    var ops: Vec<str> = Vec::new();
    if str_len(rest) > 0 {
        var parts: Vec<str> = str_split(rest, ",");
        var pi: i64 = 0;
        while pi < parts.len() {
            ops.push(str_trim(parts.get(pi)));
            pi = pi + 1;
        }
    }
    if ops.len() == 0 {
        var f: Vec<i64> = pe_asm_fixed(m);
        if f.len() == 0 {
            return "unknown instruction";
        }
        var fi: i64 = 0;
        while fi < f.len() {
            o.b.push(f.get(fi));
            fi = fi + 1;
        }
        return "";
    }
    if m == "int" && ops.len() == 1 && pe_asm_is_num(ops.get(0)) {
        o.b.push(0xCD);
        o.b.push(pe_asm_num(ops.get(0)) & 0xFF);
        return "";
    }
    if m == "in" && ops.len() == 2 {
        var dst: str = ops.get(0);
        var src: str = ops.get(1);
        if src == "dx" {
            if dst == "al" {
                o.b.push(0xEC);
                return "";
            }
            if dst == "ax" {
                o.b.push(0x66);
                o.b.push(0xED);
                return "";
            }
            if dst == "eax" {
                o.b.push(0xED);
                return "";
            }
        } else if pe_asm_is_num(src) {
            if dst == "al" {
                o.b.push(0xE4);
                o.b.push(pe_asm_num(src) & 0xFF);
                return "";
            }
            if dst == "ax" {
                o.b.push(0x66);
                o.b.push(0xE5);
                o.b.push(pe_asm_num(src) & 0xFF);
                return "";
            }
            if dst == "eax" {
                o.b.push(0xE5);
                o.b.push(pe_asm_num(src) & 0xFF);
                return "";
            }
        }
        return "unsupported operands";
    }
    if m == "out" && ops.len() == 2 {
        var port: str = ops.get(0);
        var val: str = ops.get(1);
        if port == "dx" {
            if val == "al" {
                o.b.push(0xEE);
                return "";
            }
            if val == "ax" {
                o.b.push(0x66);
                o.b.push(0xEF);
                return "";
            }
            if val == "eax" {
                o.b.push(0xEF);
                return "";
            }
        } else if pe_asm_is_num(port) {
            if val == "al" {
                o.b.push(0xE6);
                o.b.push(pe_asm_num(port) & 0xFF);
                return "";
            }
            if val == "ax" {
                o.b.push(0x66);
                o.b.push(0xE7);
                o.b.push(pe_asm_num(port) & 0xFF);
                return "";
            }
            if val == "eax" {
                o.b.push(0xE7);
                o.b.push(pe_asm_num(port) & 0xFF);
                return "";
            }
        }
        return "unsupported operands";
    }
    if (m == "lgdt" || m == "lidt" || m == "invlpg") && ops.len() == 1 {
        var mr: i64 = pe_asm_mem_reg(ops.get(0));
        if mr < 0 {
            return "needs a [register] operand";
        }
        var op: Vec<i64> = Vec::new();
        op.push(0x0F);
        op.push(0x01);
        var ext: i64 = 7;
        if m == "lgdt" {
            ext = 2;
        }
        if m == "lidt" {
            ext = 3;
        }
        pe_asm_mem_op(o, op, ext, mr);
        return "";
    }
    if (m == "push" || m == "pop") && ops.len() == 1 {
        var r: i64 = pe_asm_reg64(ops.get(0));
        if r >= 0 {
            if r >= 8 {
                o.b.push(0x41);
            }
            if m == "push" {
                o.b.push(0x50 + (r & 7));
            } else {
                o.b.push(0x58 + (r & 7));
            }
            return "";
        }
        if m == "push" && pe_asm_is_num(ops.get(0)) {
            var pv: i64 = pe_asm_num(ops.get(0));
            if pv >= -128 && pv <= 127 {
                o.b.push(0x6A);
                o.b.push(pv & 0xFF);
            } else {
                o.b.push(0x68);
                pe_asm_push4(o, pv);
            }
            return "";
        }
        return "unsupported operand";
    }
    if (m == "jmp" || m == "call") && ops.len() == 1 && pe_asm_reg64(ops.get(0)) >= 0 {
        var rj: i64 = pe_asm_reg64(ops.get(0));
        if rj >= 8 {
            o.b.push(0x41);
        }
        o.b.push(0xFF);
        if m == "jmp" {
            o.b.push(0xE0 | (rj & 7));
        } else {
            o.b.push(0xD0 | (rj & 7));
        }
        return "";
    }
    if (m == "shl" || m == "sal" || m == "shr" || m == "sar") && ops.len() == 2 && pe_asm_reg64(ops.get(0)) >= 0 {
        var rs: i64 = pe_asm_reg64(ops.get(0));
        var sext: i64 = 4;
        if m == "shr" {
            sext = 5;
        }
        if m == "sar" {
            sext = 7;
        }
        if ops.get(1) == "cl" {
            o.b.push(pe_asm_rex(true, 0, rs));
            o.b.push(0xD3);
            o.b.push(0xC0 | (sext << 3) | (rs & 7));
            return "";
        }
        if pe_asm_is_num(ops.get(1)) {
            o.b.push(pe_asm_rex(true, 0, rs));
            o.b.push(0xC1);
            o.b.push(0xC0 | (sext << 3) | (rs & 7));
            o.b.push(pe_asm_num(ops.get(1)) & 0x3F);
            return "";
        }
        return "unsupported operands";
    }
    if ops.len() == 2 && pe_asm_reg64(ops.get(0)) >= 0 && pe_asm_is_num(ops.get(1)) && m != "mov" {
        // add/or/and/sub/xor/cmp r64, imm32 (81 /n, or 83 /n with an imm8)
        var ext2: i64 = -1;
        if m == "add" {
            ext2 = 0;
        }
        if m == "or" {
            ext2 = 1;
        }
        if m == "and" {
            ext2 = 4;
        }
        if m == "sub" {
            ext2 = 5;
        }
        if m == "xor" {
            ext2 = 6;
        }
        if m == "cmp" {
            ext2 = 7;
        }
        if ext2 >= 0 {
            var ri: i64 = pe_asm_reg64(ops.get(0));
            var imm: i64 = pe_asm_num(ops.get(1));
            o.b.push(pe_asm_rex(true, 0, ri));
            if imm >= -128 && imm <= 127 {
                o.b.push(0x83);
                o.b.push(0xC0 | (ext2 << 3) | (ri & 7));
                o.b.push(imm & 0xFF);
            } else {
                o.b.push(0x81);
                o.b.push(0xC0 | (ext2 << 3) | (ri & 7));
                pe_asm_push4(o, imm);
            }
            return "";
        }
    }
    if (m == "inc" || m == "dec" || m == "neg" || m == "not") && ops.len() == 1 {
        var r1: i64 = pe_asm_reg64(ops.get(0));
        if r1 < 0 {
            return "needs a 64-bit register";
        }
        var ext1: i64 = 0;
        var opc: i64 = 0xFF;
        if m == "dec" {
            ext1 = 1;
        }
        if m == "neg" {
            ext1 = 3;
            opc = 0xF7;
        }
        if m == "not" {
            ext1 = 2;
            opc = 0xF7;
        }
        o.b.push(pe_asm_rex(true, 0, r1));
        o.b.push(opc);
        o.b.push(0xC0 | (ext1 << 3) | (r1 & 7));
        return "";
    }
    if ops.len() == 2 {
        var a: str = ops.get(0);
        var b: str = ops.get(1);
        var ra: i64 = pe_asm_reg64(a);
        var rb: i64 = pe_asm_reg64(b);
        if m == "mov" {
            var ca: i64 = pe_asm_cr(a);
            var cb: i64 = pe_asm_cr(b);
            if ra >= 0 && cb >= 0 {
                var rx: i64 = pe_asm_rex(false, cb, ra);
                if rx != 0 {
                    o.b.push(rx);
                }
                o.b.push(0x0F);
                o.b.push(0x20);
                o.b.push(0xC0 | ((cb & 7) << 3) | (ra & 7));
                return "";
            }
            if ca >= 0 && rb >= 0 {
                var rx2: i64 = pe_asm_rex(false, ca, rb);
                if rx2 != 0 {
                    o.b.push(rx2);
                }
                o.b.push(0x0F);
                o.b.push(0x22);
                o.b.push(0xC0 | ((ca & 7) << 3) | (rb & 7));
                return "";
            }
            var small: str = " al cl dl bl ax cx dx bx si di eax ecx edx ebx esp ebp esi edi ";
            var sk: i64 = str_find(small, " " + a + " ");
            if sk >= 0 && pe_asm_is_num(b) {
                var sv: i64 = pe_asm_num(b);
                if str_len(a) == 2 && str_ends_with(a, "l") {
                    o.b.push(0xB0 + pe_asm_reg64("r" + str_slice(a, 0, 1) + "x"));
                    o.b.push(sv & 0xFF);
                } else if str_len(a) == 2 {
                    var r16: i64 = pe_asm_reg64("r" + a);
                    if str_ends_with(a, "x") {
                        r16 = pe_asm_reg64("r" + a);
                    }
                    o.b.push(0x66);
                    o.b.push(0xB8 + r16);
                    o.b.push(sv & 0xFF);
                    o.b.push((sv >> 8) & 0xFF);
                } else {
                    o.b.push(0xB8 + pe_asm_reg64("r" + str_slice(a, 1, 3)));
                    pe_asm_push4(o, sv);
                }
                return "";
            }
            if ra >= 0 && pe_asm_is_num(b) {
                var iv: i64 = pe_asm_num(b);
                if iv >= -2147483648 && iv <= 2147483647 {
                    o.b.push(pe_asm_rex(true, 0, ra));
                    o.b.push(0xC7);
                    o.b.push(0xC0 | (ra & 7));
                    pe_asm_push4(o, iv);
                } else {
                    o.b.push(pe_asm_rex(true, 0, ra));
                    o.b.push(0xB8 + (ra & 7));
                    pe_asm_push4(o, iv);
                    pe_asm_push4(o, iv >> 32);
                }
                return "";
            }
        }
        var alu: i64 = -1;
        if m == "mov" {
            alu = 0x89;
        }
        if m == "add" {
            alu = 0x01;
        }
        if m == "or" {
            alu = 0x09;
        }
        if m == "and" {
            alu = 0x21;
        }
        if m == "sub" {
            alu = 0x29;
        }
        if m == "xor" {
            alu = 0x31;
        }
        if m == "cmp" {
            alu = 0x39;
        }
        if m == "test" {
            alu = 0x85;
        }
        if alu >= 0 && ra >= 0 && rb >= 0 {
            o.b.push(pe_asm_rex(true, rb, ra));
            o.b.push(alu);
            o.b.push(0xC0 | ((rb & 7) << 3) | (ra & 7));
            return "";
        }
        return "unsupported operands";
    }
    return "unknown instruction";
}

/// Encode an asm! template (instructions separated by `;` or newlines).
pub fn pe_asm_encode(template: str) -> PeAsmResult {
    var o: PeAsmOut = PeAsmOut {
        b: Vec::new()
    };
    var lines: Vec<str> = str_split(str_replace(template, "\n", ";"), ";");
    var i: i64 = 0;
    while i < lines.len() {
        var why: str = pe_asm_one(&mut o, lines.get(i));
        if why != "" {
            return PeAsmResult {
                bytes: Vec::new(), error: str_trim(lines.get(i)) + ": " + why
            };
        }
        i = i + 1;
    }
    return PeAsmResult {
        bytes: o.b, error: ""
    };
}

/// LG13: does `template` hold an instruction a Windows process may not
/// run (ring 0 only: it faults with a privileged-instruction exception)?
/// hlt, cli, sti, port I/O, descriptor tables, MSRs, swapgs, iretq,
/// sysret/sysexit, cache invalidation and control or debug registers; and
/// the software interrupts (int, int3), which stop a process.
pub fn pe_asm_privileged(template: str) -> bool {
    var lines: Vec<str> = str_split(str_replace(template, "\n", ";"), ";");
    var plist: Vec<str> = Vec::new();
    plist.push("hlt");
    plist.push("cli");
    plist.push("sti");
    plist.push("in");
    plist.push("out");
    plist.push("ins");
    plist.push("insb");
    plist.push("insw");
    plist.push("insd");
    plist.push("outs");
    plist.push("outsb");
    plist.push("outsw");
    plist.push("outsd");
    plist.push("lgdt");
    plist.push("lidt");
    plist.push("lldt");
    plist.push("ltr");
    plist.push("lmsw");
    plist.push("clts");
    plist.push("invlpg");
    plist.push("invd");
    plist.push("wbinvd");
    plist.push("iretq");
    plist.push("iret");
    plist.push("sysret");
    plist.push("sysretq");
    plist.push("sysexit");
    plist.push("rdmsr");
    plist.push("wrmsr");
    plist.push("swapgs");
    // traps that stop a process without a debugger or handler (a bare
    // image's IDT catches them: test_bare_interrupts.fd)
    plist.push("int");
    plist.push("int1");
    plist.push("int3");
    plist.push("into");
    var i: i64 = 0;
    while i < lines.len() {
        var s: str = str_trim(str_to_lower(lines.get(i)));
        var sp: i64 = 0;
        while sp < str_len(s) && str_byte_at(s, sp) != 32 && str_byte_at(s, sp) != 9 {
            sp = sp + 1;
        }
        var m: str = str_slice(s, 0, sp);
        var k: i64 = 0;
        while k < plist.len() {
            if m == plist.get(k) {
                return true;
            }
            k = k + 1;
        }
        // mov to or from cr0..cr8 / dr0..dr7
        var rest: str = str_slice(s, sp, str_len(s));
        var j: i64 = 0;
        while j + 2 < str_len(rest) {
            var c0: i64 = str_byte_at(rest, j);
            var c1: i64 = str_byte_at(rest, j + 1);
            var c2: i64 = str_byte_at(rest, j + 2);
            if (c0 == 99 || c0 == 100) && c1 == 114 && c2 >= 48 && c2 <= 57 {
                if j == 0 || str_byte_at(rest, j - 1) == 32 || str_byte_at(rest, j - 1) == 44 || str_byte_at(rest, j - 1) == 9 {
                    return true;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return false;
}

/// Errors of asm! templates the bare build could not encode.
pub var g_pe_asm_errors: Vec<str> = Vec::new();

/// DB3: the input file and its functions (comma-separated), set by
/// pe_lines_setup for a debug build: pe_ir writes DWARF line tables for
/// them into the image (.debug_abbrev, .debug_info, .debug_line).
pub var g_pe_lines_file: str = "";
pub var g_pe_lines_names: str = "";

/// Environment variable `name`, "" when unset. Through core's env_var:
/// p_getenv's raw word (proposal 0004) must not be kept as a str.
pub fn peir_env_or_empty(name: str) -> str {
    match env_var(name) {
        Option::Some(v) => {
            return v;
        }
        Option::None => {
            return "";
        }
    }
    return "";
}

/// pe_ir passes turned off by FID_PE_OFF=<names> (comma-separated):
/// tail (OP13), layout (OP15), wipe (LF20), asm (LG13: asm! in a process),
/// ra (RA1: no register allocator, every value in its frame slot),
/// r89 (D4: r8 and r9 are not value registers), cswap (D13: a constant
/// left operand stays left), cprop (D13: repeated register moves kept)
pub var g_peir_off: str = "?";

pub fn peir_on(pass: str) -> bool {
    if g_peir_off == "?" {
        g_peir_off = "," + peir_env_or_empty("FID_PE_OFF") + ",";
    }
    return !str_contains(g_peir_off, "," + pass + ",");
}

/// J7: @constant_time violations found by pe_ir.fd's peir_ct_check while
/// generating the functions (reset by each pe_ir_generate_* entry point).
pub var g_pe_ct_errors: Vec<str> = Vec::new();
