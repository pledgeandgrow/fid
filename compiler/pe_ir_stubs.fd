// pe_ir_stubs.fd -- PE runtime stubs + reachability for the IR -> .exe backend
// (compiler/pe_ir.fd). Ported from the `PeirGen` machinery in src/pe.rs:
// the code-generator state, its helper structs, the machine-code runtime
// stub generators, and the function-reachability logic.
//
// Adaptations from Rust:
// 1. usize/u32/u8/i32/f64-bits -> i64; emitted bytes masked with & 0xFF
// 2. HashMap<String, u32> / HashMap<String, usize> -> i64 handles
//    (HashMap_get returns 0 when absent; callers use HashMap_contains first
//    where 0 is a valid value, e.g. label 0)
// 3. BTreeMap<String, BTreeSet<String>> unresolved -> sorted Vec<UnresolvedCall>
//    BTreeSet<String> (callers, module_fns, seen) -> Vec<str> kept sorted
//    BTreeMap<String, i64> dyn_type_ids -> sorted Vec<DynTypeId>
//    BTreeMap<String, String> c_overrides -> sorted Vec<COverride>
// 4. Option<...> -> "" / -1 / 0 sentinels, or OptX enums from ir.fd
// 5. Rust `emit(&[b0, b1, ...])` -> one PeirEnc_emit_u8 call per byte,
//    grouped through pe_emit1..pe_emit8
// 6. `for`/`iter().enumerate()`/`pop()` -> while loops / index loops
// 7. format!/to_string() -> int_to_str() + concatenation
// 8. Bare-metal bodies of the stub generators are ported (release G2, Nov 6;
//    two Rust bugs fixed on the way: p_idt_set_entry stored cl for the gate
//    flags, p_gdt_set_entry read its fifth argument from the shadow space).
//    `fid emit --bare` runs them through PeirGen_gen_bare_runtime.
//
// Windows x64 calling convention (for reference):
//   - Integer args: RCX, RDX, R8, R9 (then stack); return: RAX
//   - Shadow space: 32 bytes; stack 16-byte aligned before CALL

module compiler::pe_ir_stubs;

use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::pe_ir_enc;

// ===========================================================================
// Helper structs (src/pe.rs: CThunk, and Vec stand-ins for BTree collections)
// ===========================================================================

/// (stub, Fides runtime function) pair — PE_STUB_DEPS row.
pub struct PeirStrPair {
    pub a: str,
    pub b: str,
}

/// An `extern "C"` function of msvcrt.dll or kernel32.dll: called through a
/// thunk that moves Fides arguments (all in integer registers, floats as
/// raw bits) into the Windows x64 C convention, and the result back.
pub struct CThunk {
    pub name: str,
    pub slot: i64,
    pub params: Vec<IrType>,
    pub ret: IrType,
    // For each parameter: the size of a struct C takes by value, else 0
    pub by_value: Vec<i64>,
    // The size of a struct C returns in rax, else 0
    pub ret_size: i64,
}

/// What C calls for a Fides function: the C convention on one side, a null
/// `__env` and raw bits on the other.
pub struct CAdapter {
    pub name: str,
    pub target: str,
    pub params: Vec<IrType>,
    pub ret: IrType,
}

pub fn CAdapter_new(name: str, target: str, params: Vec<IrType>, ret: IrType) -> CAdapter {
    return CAdapter { name: name, target: target, params: params, ret: ret };
}

/// The size of a struct Windows passes by value (in a register), else 0.
pub fn pe_c_by_value(module: &IrModule, ty: IrType) -> i64 {
    match ty {
        IrType::Struct(_) => {
            var size: i64 = IrModule_type_size(module, ty);
            if size == 1 || size == 2 || size == 4 || size == 8 { return size; }
        }
        _ => {}
    }
    return 0;
}

/// Type id of dyn values (type name -> id, from 1).  Sorted Vec stand-in for
/// Rust `BTreeMap<String, i64>`.
pub struct DynTypeId {
    pub name: str,
    pub id: i64,
}

/// A called function that neither the program nor this runtime defines,
/// with the (sorted) names of the functions that call it.  Sorted Vec
/// stand-in for Rust `BTreeMap<String, BTreeSet<String>>`.
pub struct UnresolvedCall {
    pub name: str,
    pub callers: Vec<str>,
}

/// An `extern "C"` function the Fides runtime replaces (see c_override):
/// pledge name -> `pert_c_<C name>`.  Sorted Vec for BTreeMap<String,String>.
pub struct COverride {
    pub name: str,
    pub over: str,
}

// Cross-module construction needs `Name_new` helpers: Fides has no struct
// literals for types declared in another module (compiler/pe_ir.fd).

pub fn CThunk_new(module: &IrModule, name: str, slot: i64, params: Vec<IrType>, ret: IrType) -> CThunk {
    var ret_size: i64 = pe_c_by_value(module, ret);
    var all: Vec<IrType> = Vec::new();
    // Any bigger struct: C takes the result pointer Fides passes, first
    match ret {
        IrType::Struct(_) => {
            if ret_size == 0 { all.push(IrType::I64); }
        }
        _ => {}
    }
    var i: i64 = 0;
    while i < params.len() {
        all.push(params.get(i));
        i = i + 1;
    }
    var by_value: Vec<i64> = Vec::new();
    i = 0;
    while i < all.len() {
        by_value.push(pe_c_by_value(module, all.get(i)));
        i = i + 1;
    }
    return CThunk { name: name, slot: slot, params: all, ret: ret, by_value: by_value, ret_size: ret_size };
}

pub fn COverride_new(name: str, over: str) -> COverride {
    return COverride { name: name, over: over };
}

// ===========================================================================
// PeirGen state (src/pe.rs struct PeirGen)
// ===========================================================================

pub struct PeirGen {
    pub enc: PeirEnc,
    /// Map function name to label ID (HashMap handle; 0 = absent AND label 0,
    /// so membership must be checked with HashMap_contains first).
    pub func_labels: i64,
    /// Map string content to rdata offset (HashMap handle)
    pub string_rdata_offsets: i64,
    /// Map global var name to rdata offset, writable section (HashMap handle)
    pub global_rdata_offsets: i64,
    /// IAT entry offsets within .rdata (for each import)
    pub iat_rdata_offsets: Vec<i64>,
    /// Block labels: "func:block_id" -> label_id (HashMap handle)
    pub block_labels: i64,
    /// Entry point (_main) offset within .text
    pub entry_offset: i64,
    /// Bare-metal mode: no IAT, no OS calls, flat binary
    pub bare_mode: bool,
    /// Function being generated
    pub cur_func: str,
    /// The function being generated wraps on overflow
    pub cur_wrapping: bool,
    // Per value: an instruction a counted loop proves safe (peir_unchecked_ops)
    pub unchecked: Vec<i64>,
    // The instruction being generated is one of them
    pub cur_unchecked: bool,
    /// Labels of the arithmetic panic stubs (see gen_arith_panics)
    pub arith_panics: Vec<i64>,
    /// Label of the vectored exception handler
    pub crash_filter: i64,
    /// Registers this function uses for values (id = register), and where
    /// it saved them
    pub saved_regs: Vec<PeOffEnt>,
    /// Type ids of dyn values (sorted Vec<DynTypeId>, ids from 1)
    pub dyn_type_ids: Vec<DynTypeId>,
    /// Called functions that neither the program nor this runtime defines,
    /// with the functions that call them (sorted Vec<UnresolvedCall>)
    pub unresolved: Vec<UnresolvedCall>,
    /// The program's Fides functions (they take `__env` first); sorted names
    pub module_fns: Vec<str>,
    /// `extern "C"` functions called through the import table
    pub c_thunks: Vec<CThunk>,
    pub c_adapters: Vec<CAdapter>,
    /// `extern "C"` functions of a missing local header: stubs returning 0
    pub stub_externs: Vec<str>,
    /// .rdata offset of the bump-allocator state block (24 bytes:
    /// +0 chunk cursor, +8 chunk end, +16 cached process-heap handle)
    pub alloc_rdata_off: i64,
    /// `extern "C"` functions the Fides runtime replaces (see c_override)
    pub c_overrides: Vec<COverride>,
    /// Functions a program refers to by name (thread and task entry points):
    /// what `pe_fn_lookup` can find
    pub named_fns: Vec<str>,
    /// cmp+branch fusion: jcc code (-1 = none) and the cond value id, set
    /// when a comparison is followed by a Branch on its result — the Branch
    /// jumps on the compare's still-live flags (pe-roadmap item 82).
    pub pending_cmp_cc: i64,
    pub pending_cmp_vid: i64,
    /// The comparison being emitted only sets flags: its sole use is the
    /// Branch right after it
    pub flags_only: bool,
    /// Per value of the current function: how many times it is used
    pub use_count: Vec<i64>,
    /// The label of the block laid out after the current one, or -1
    pub next_block: i64,
    /// The prologue reserved the outgoing argument area: a call does not
    /// move rsp
    pub calls_reserved: bool,
}

pub fn PeirGen_new() -> PeirGen {
    return PeirGen {
        enc: PeirEnc_new(),
        func_labels: HashMap_new(),
        string_rdata_offsets: HashMap_new(),
        global_rdata_offsets: HashMap_new(),
        iat_rdata_offsets: Vec::new(),
        block_labels: HashMap_new(),
        entry_offset: 0,
        bare_mode: false,
        cur_func: "",
        cur_wrapping: false,
        unchecked: Vec::new(),
        cur_unchecked: false,
        arith_panics: Vec::new(),
        crash_filter: 0,
        saved_regs: Vec::new(),
        dyn_type_ids: Vec::new(),
        unresolved: Vec::new(),
        module_fns: Vec::new(),
        c_thunks: Vec::new(),
        c_adapters: Vec::new(),
        alloc_rdata_off: 0,
        stub_externs: Vec::new(),
        c_overrides: Vec::new(),
        named_fns: Vec::new(),
        pending_cmp_cc: -1,
        pending_cmp_vid: -1,
        flags_only: false,
        use_count: Vec::new(),
        next_block: -1,
        calls_reserved: false,
    };
}

// ===========================================================================
// Raw byte emission helpers (Rust `enc.emit(&[...])` -> one call per byte)
// ===========================================================================

fn pe_emit1(e: &mut PeirEnc, a: i64) -> void {
    PeirEnc_emit_u8(e, a);
}

fn pe_emit2(e: &mut PeirEnc, a: i64, b: i64) -> void {
    PeirEnc_emit_u8(e, a); PeirEnc_emit_u8(e, b);
}

fn pe_emit3(e: &mut PeirEnc, a: i64, b: i64, c: i64) -> void {
    PeirEnc_emit_u8(e, a); PeirEnc_emit_u8(e, b); PeirEnc_emit_u8(e, c);
}

fn pe_emit4(e: &mut PeirEnc, a: i64, b: i64, c: i64, d: i64) -> void {
    PeirEnc_emit_u8(e, a); PeirEnc_emit_u8(e, b);
    PeirEnc_emit_u8(e, c); PeirEnc_emit_u8(e, d);
}

fn pe_emit5(e: &mut PeirEnc, a: i64, b: i64, c: i64, d: i64, f: i64) -> void {
    PeirEnc_emit_u8(e, a); PeirEnc_emit_u8(e, b); PeirEnc_emit_u8(e, c);
    PeirEnc_emit_u8(e, d); PeirEnc_emit_u8(e, f);
}

fn pe_emit6(e: &mut PeirEnc, a: i64, b: i64, c: i64, d: i64, f: i64, g: i64) -> void {
    PeirEnc_emit_u8(e, a); PeirEnc_emit_u8(e, b); PeirEnc_emit_u8(e, c);
    PeirEnc_emit_u8(e, d); PeirEnc_emit_u8(e, f); PeirEnc_emit_u8(e, g);
}

fn pe_emit7(e: &mut PeirEnc, a: i64, b: i64, c: i64, d: i64, f: i64, g: i64, h: i64) -> void {
    PeirEnc_emit_u8(e, a); PeirEnc_emit_u8(e, b); PeirEnc_emit_u8(e, c);
    PeirEnc_emit_u8(e, d); PeirEnc_emit_u8(e, f); PeirEnc_emit_u8(e, g);
    PeirEnc_emit_u8(e, h);
}

fn pe_emit8(e: &mut PeirEnc, a: i64, b: i64, c: i64, d: i64, f: i64, g: i64, h: i64, i: i64) -> void {
    PeirEnc_emit_u8(e, a); PeirEnc_emit_u8(e, b); PeirEnc_emit_u8(e, c);
    PeirEnc_emit_u8(e, d); PeirEnc_emit_u8(e, f); PeirEnc_emit_u8(e, g);
    PeirEnc_emit_u8(e, h); PeirEnc_emit_u8(e, i);
}

// ===========================================================================
// Sorted-Vec helpers (BTreeSet / BTreeMap stand-ins)
// ===========================================================================

/// Linear-scan membership for Vec<str> (BTreeSet<String>::contains).
fn pe_strs_contains(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

/// Insert `s` into sorted Vec<str> `v` (BTreeSet<String>::insert).
/// Returns the (possibly reallocated) Vec.
fn pe_strs_insert_sorted(v: Vec<str>, s: str) -> Vec<str> {
    var v = v;
    var i: i64 = 0;
    while i < v.len() {
        var c: i64 = str_compare(v.get(i), s);
        if c == 0 { return v; }
        if c > 0 {
            // insert at i: append a slot then shift right
            v.push(v.get(v.len() - 1));
            var j: i64 = v.len() - 1;
            while j > i {
                v.set(j, v.get(j - 1));
                j = j - 1;
            }
            v.set(i, s);
            return v;
        }
        i = i + 1;
    }
    v.push(s);
    return v;
}

/// Insertion-sort a Vec<str> with str_compare (deterministic BTree order).
fn pe_sort_strs(v: Vec<str>) -> Vec<str> {
    var v = v;
    var i: i64 = 1;
    while i < v.len() {
        var key: str = v.get(i);
        var j: i64 = i - 1;
        while j >= 0 && str_compare(v.get(j), key) > 0 {
            v.set(j + 1, v.get(j));
            j = j - 1;
        }
        v.set(j + 1, key);
        i = i + 1;
    }
    return v;
}

// ===========================================================================
// Runtime tables (src/pe.rs: PE_PRIMITIVES, PE_STUB_DEPS, PRINT_BUILTINS)
// ===========================================================================

/// Machine-code primitives of the Fides PE runtime (src/pe_runtime/), which
/// declares them `extern "C"`: called without `__env`, arguments from rcx.
pub fn pe_primitive_names() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("pe_atomic_load"); v.push("pe_atomic_store"); v.push("pe_atomic_add");
    v.push("pe_atomic_cas"); v.push("pe_f64_to_bits"); v.push("pe_bits_to_f64");
    v.push("pe_f64_to_f32_bits"); v.push("pe_f32_bits_to_f64");
    v.push("pe_fn_lookup"); v.push("pe_call_fn");
    return v;
}

/// Machine code that only exists with the Fides function it hands over to:
/// (stub, Fides runtime function).
pub fn pe_stub_deps() -> Vec<PeirStrPair> {
    var v: Vec<PeirStrPair> = Vec::new();
    // p_thread_spawn(name, nargs, ...): varargs, captured into an array
    v.push(PeirStrPair { a: "p_thread_spawn", b: "pert_thread_spawn_v" });
    v.push(PeirStrPair { a: "p_executor_spawn", b: "pert_executor_spawn_v" });
    v.push(PeirStrPair { a: "p_co_async", b: "pert_co_async_v" });
    // The C-convention thread start routine runs pert_thread_main(arg)
    v.push(PeirStrPair { a: "pe_thread_entry_addr", b: "pert_thread_main" });
    return v;
}

/// The builtins `print`, `p_to_str` and the Print instruction dispatch to.
pub fn pe_print_builtins() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("p_print_float"); v.push("p_print_int"); v.push("p_print_str");
    v.push("p_print_bool"); v.push("p_to_str_float"); v.push("p_to_str");
    v.push("p_to_str_str"); v.push("p_to_str_bool");
    return v;
}

// ===========================================================================
// Name helpers (src/pe.rs free functions)
// ===========================================================================

/// A function of the Fides PE runtime (src/pe_runtime/): builtins `pert_*`
/// and the helpers of each file (`pe_*`, `pet_*` tensors, `ped_*` data).
pub fn is_pe_runtime_fn(name: str) -> bool {
    return str_starts_with(name, "pert_") || str_starts_with(name, "pe_")
        || str_starts_with(name, "pet_") || str_starts_with(name, "ped_");
}

/// The Fides runtime's stand-in for runtime builtin `p_X` / `__X`: `pert_X`.
/// Returns "" when `name` has no `p_`/`__` prefix (Option::None).
pub fn pert_name(name: str) -> str {
    if str_starts_with(name, "p_") {
        return "pert_" + str_slice(name, 2, str_len(name));
    }
    if str_starts_with(name, "__") {
        return "pert_" + str_slice(name, 2, str_len(name));
    }
    return "";
}

/// Runtime builtins this backend implements with core's Fides code.
pub fn pe_runtime_alias(name: str) -> str {
    if name == "p_vec_insert" { return "vec_raw_insert"; }
    // One Vec implementation: core's. (The machine stubs disagreed with it:
    // clone shared the data, first returned garbage.)
    if name == "p_vec_clone" { return "Vec_clone"; }
    if name == "p_vec_new" { return "Vec_new"; }
    if name == "p_vec_push" { return "Vec_push"; }
    if name == "p_vec_len" { return "Vec_len"; }
    if name == "p_vec_get" { return "Vec_get"; }
    if name == "p_vec_set" { return "Vec_set"; }
    if name == "p_vec_pop" { return "Vec_pop"; }
    if name == "p_vec_is_empty" { return "Vec_is_empty"; }
    if name == "p_vec_clear" { return "Vec_clear"; }
    if name == "p_vec_capacity" { return "Vec_capacity"; }
    if name == "p_vec_first" { return "Vec_first"; }
    if name == "p_vec_last" { return "Vec_last"; }
    if name == "p_vec_contains" { return "Vec_contains"; }
    if name == "p_vec_truncate" { return "Vec_truncate"; }
    if name == "p_vec_remove" { return "vec_raw_remove"; }
    if name == "p_vec_reverse" { return "vec_raw_reverse"; }
    if name == "p_vec_extend" { return "vec_raw_extend"; }
    if name == "p_vec_sort" { return "vec_raw_sort"; }
    return name;
}

/// Does the module define a function `name`?
pub fn pe_module_has_fn(module: &IrModule, name: str) -> bool {
    var i: i64 = 0;
    while i < module.functions.len() {
        if module.functions.get(i).name == name { return true; }
        i = i + 1;
    }
    return false;
}

/// A C library function the Fides runtime implements itself, for `extern
/// "C"` function `name`: `pert_c_<C name>` (putchar, puts: stdout goes
/// through this backend's own output, unbuffered and in order with print,
/// as all of it goes through C stdio in the C backend).  "" = no override.
pub fn pe_ir_c_override(module: &IrModule, name: str) -> str {
    var i: i64 = 0;
    while i < module.extern_decls.len() {
        var ext: ExternDecl = module.extern_decls.get(i);
        if ext.pledge_name == name {
            var over: str = "pert_c_" + ext.c_name;
            if pe_module_has_fn(module, over) { return over; }
            return "";
        }
        i = i + 1;
    }
    return "";
}

/// `PeirGen::resolve_call` for the call graph: an alias, or the Fides
/// runtime's `pert_X` for builtin `p_X` when the program has it.
pub fn pe_ir_resolve_callee(module: &IrModule, name: str) -> str {
    var over: str = pe_ir_c_override(module, name);
    if over != "" { return over; }
    var alias: str = pe_runtime_alias(name);
    if alias != name { return alias; }
    var p: str = pert_name(name);
    if p != "" && pe_module_has_fn(module, p) { return p; }
    return name;
}

/// The Fides function that formats a printed collection, if any. "" = none.
pub fn pe_ir_print_formatter(ty: IrType) -> str {
    match ty {
        IrType::Opaque(n) => {
            if n == "Vec" { return "Vec_to_str"; }
            if n == "HashMap" { return "HashMap_to_str"; }
            // The Fides runtime's p_tensor_to_str (src/pe_runtime/)
            if n == "Tensor" { return "pert_tensor_to_str"; }
            return "";
        }
        IrType::Generic(n, _) => {
            if n == "Vec" { return "Vec_to_str"; }
            if n == "HashMap" { return "HashMap_to_str"; }
            return "";
        }
        _ => { return ""; }
    }
    return "";
}

/// IrType::is_opaque_named — Opaque(n) or Generic(n, _) with n == name.
fn pe_ir_is_opaque_named(ty: IrType, name: str) -> bool {
    match ty {
        IrType::Opaque(n) => { return n == name; }
        IrType::Generic(n, _) => { return n == name; }
        _ => { return false; }
    }
    return false;
}

/// The runtime builtin an autograd instruction calls (as in the C backend).
pub fn pe_ir_autograd_builtin(inst: Inst) -> str {
    match inst {
        Inst::GradBegin(_) => { return "p_autograd_begin"; }
        Inst::GradEnd => { return "p_autograd_end"; }
        _ => { return "p_autograd_backward"; }
    }
    return "p_autograd_backward";
}

// ===========================================================================
// Reachability (src/pe.rs: reachable_from / needed_functions / reachable_functions)
// ===========================================================================

/// Functions reachable from `roots` (see pe_ir_reachable_functions).
/// Returns a sorted Vec<str> (the Rust function returns BTreeSet<String>).
pub fn pe_ir_reachable_from(module: &IrModule, roots: Vec<str>) -> Vec<str> {
    var seen: Vec<str> = Vec::new();
    var work: Vec<str> = roots;
    var deps: Vec<PeirStrPair> = pe_stub_deps();
    var prints: Vec<str> = pe_print_builtins();
    while work.len() > 0 {
        var f: str = work.pop();
        if !pe_strs_contains(seen, f) {
            seen.push(f);
            // A stub that hands over to the Fides runtime needs that function
            var di: i64 = 0;
            while di < deps.len() {
                var dep: PeirStrPair = deps.get(di);
                if f == dep.a { work.push(dep.b); }
                di = di + 1;
            }
            match IrModule_get_function(module, f) {
                OptIrFunction::Some(func) => {
                    var ii: i64 = 0;
                    while ii < func.insts.len() {
                        var inst: Inst = func.insts.get(ii).inst;
                        match inst {
                            Inst::Call(callee, args, _, _) => {
                                work.push(pe_ir_resolve_callee(module, callee));
                                // print / p_to_str dispatch on the argument type
                                // (see gen_inst): the Fides runtime may replace
                                // any of them
                                if callee == "print" || callee == "p_to_str" {
                                    var bi: i64 = 0;
                                    while bi < prints.len() {
                                        work.push(pe_ir_resolve_callee(module, prints.get(bi)));
                                        bi = bi + 1;
                                    }
                                }
                                // print(tensor) formats it with p_tensor_to_str
                                var tensor_arg: bool = false;
                                if args.len() > 0 {
                                    var a0: i64 = args.get(0);
                                    match IrFunction_get_meta(&func, a0) {
                                        OptValueMeta::Some(m) => {
                                            tensor_arg = pe_ir_is_opaque_named(m.ty, "Tensor");
                                        }
                                        OptValueMeta::None => {}
                                    }
                                }
                                if callee == "print" && tensor_arg {
                                    work.push(pe_ir_resolve_callee(module, "p_tensor_to_str"));
                                }
                            }
                            Inst::GradBegin(_) => {
                                work.push(pe_ir_resolve_callee(module, pe_ir_autograd_builtin(inst)));
                            }
                            Inst::GradEnd => {
                                work.push(pe_ir_resolve_callee(module, pe_ir_autograd_builtin(inst)));
                            }
                            Inst::Backward(_) => {
                                work.push(pe_ir_resolve_callee(module, pe_ir_autograd_builtin(inst)));
                            }
                            // A function named in a string: a thread or task
                            // entry point
                            Inst::ConstStr(value) => {
                                if pe_module_has_fn(module, value) { work.push(value); }
                            }
                            Inst::ConstFnRef(n) => { work.push(c_fn_target(n)); }
                            Inst::Print(_, ty) => {
                                var pf: str = pe_ir_print_formatter(ty);
                                if pf != "" { work.push(pf); }
                                var bi2: i64 = 0;
                                while bi2 < prints.len() {
                                    work.push(pe_ir_resolve_callee(module, prints.get(bi2)));
                                    bi2 = bi2 + 1;
                                }
                            }
                            Inst::DynCall(_, method, _, _, _) => {
                                var suffix: str = "_" + method;
                                var fi: i64 = 0;
                                while fi < module.functions.len() {
                                    var fn_name: str = module.functions.get(fi).name;
                                    if str_ends_with(fn_name, suffix) { work.push(fn_name); }
                                    fi = fi + 1;
                                }
                            }
                            _ => {}
                        }
                        ii = ii + 1;
                    }
                }
                OptIrFunction::None => {}
            }
        }
    }
    return pe_sort_strs(seen);
}

/// The Fides runtime functions an executable needs: those reachable from
/// the functions it is made of (every program and stdlib function is
/// compiled, used or not).
pub fn pe_ir_needed_functions(module: &IrModule) -> Vec<str> {
    var roots: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < module.functions.len() {
        var n: str = module.functions.get(i).name;
        if !is_pe_runtime_fn(n) { roots.push(n); }
        i = i + 1;
    }
    return pe_ir_reachable_from(module, roots);
}

/// Functions reachable from `main`: through calls, function references
/// (closures, thread entries) and `dyn` method dispatch.  Everything, when
/// there is no `main`.
pub fn pe_ir_reachable_functions(module: &IrModule) -> Vec<str> {
    if !pe_module_has_fn(module, "main") {
        var all: Vec<str> = Vec::new();
        var i: i64 = 0;
        while i < module.functions.len() {
            all.push(module.functions.get(i).name);
            i = i + 1;
        }
        return pe_sort_strs(all);
    }
    var roots: Vec<str> = Vec::new();
    roots.push("main");
    return pe_ir_reachable_from(module, roots);
}

// ===========================================================================
// PeirGen methods
// ===========================================================================

/// The function a call to `name` runs: a `pe_runtime_alias`, the Fides
/// runtime's `pert_X` for builtin `p_X` (it replaces a machine-code stub
/// of the same builtin), else `name` (a stub, a thunk, a program function).
pub fn PeirGen_resolve_call(self: &PeirGen, name: str) -> str {
    var i: i64 = 0;
    while i < self.c_overrides.len() {
        var ov: COverride = self.c_overrides.get(i);
        if ov.name == name { return ov.over; }
        i = i + 1;
    }
    var alias: str = pe_runtime_alias(name);
    if alias != name { return alias; }
    var p: str = pert_name(name);
    if p != "" && pe_strs_contains(self.module_fns, p) { return p; }
    return name;
}

/// Call runtime builtin `name` with `nargs` (at most 3) arguments already
/// in rcx, rdx, r8.  A Fides stand-in takes `__env` first: the arguments
/// move up one register and rcx gets a null environment.
pub fn PeirGen_call_builtin(self: &mut PeirGen, name: str, nargs: i64) -> void {
    var target: str = PeirGen_resolve_call(self, name);
    if pe_strs_contains(self.module_fns, target) && !pe_strs_contains(self.module_fns, name) {
        // debug_assert!(nargs <= 3)
        if nargs > 2 { PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_R8); }
        if nargs > 1 { PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RDX); }
        if nargs > 0 { PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX); }
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    }
    PeirGen_call_runtime(self, target);
}

/// The id of dyn values of type `name` (stable within one binary).
pub fn PeirGen_dyn_type_id(self: &mut PeirGen, name: str) -> i64 {
    var i: i64 = 0;
    while i < self.dyn_type_ids.len() {
        var e: DynTypeId = self.dyn_type_ids.get(i);
        if e.name == name { return e.id; }
        if str_compare(e.name, name) > 0 {
            // Insert sorted at i (BTreeMap order); id = position-independent
            var next: i64 = self.dyn_type_ids.len() + 1;
            var fresh: DynTypeId = DynTypeId { name: name, id: next };
            self.dyn_type_ids.push(fresh);
            var j: i64 = self.dyn_type_ids.len() - 1;
            while j > i {
                self.dyn_type_ids.set(j, self.dyn_type_ids.get(j - 1));
                j = j - 1;
            }
            self.dyn_type_ids.set(i, fresh);
            return next;
        }
        i = i + 1;
    }
    var next2: i64 = self.dyn_type_ids.len() + 1;
    self.dyn_type_ids.push(DynTypeId { name: name, id: next2 });
    return next2;
}

/// Insert (callee -> caller) into the sorted unresolved table
/// (BTreeMap<String, BTreeSet<String>>).
fn pe_unresolved_add(unresolved: Vec<UnresolvedCall>, name: str, caller: str) -> Vec<UnresolvedCall> {
    var unresolved = unresolved;
    var i: i64 = 0;
    while i < unresolved.len() {
        var e: UnresolvedCall = unresolved.get(i);
        if e.name == name {
            e.callers = pe_strs_insert_sorted(e.callers, caller);
            unresolved.set(i, e);
            return unresolved;
        }
        if str_compare(e.name, name) > 0 {
            var cs: Vec<str> = Vec::new();
            cs = pe_strs_insert_sorted(cs, caller);
            var fresh: UnresolvedCall = UnresolvedCall { name: name, callers: cs };
            unresolved.push(unresolved.get(unresolved.len() - 1));
            var j: i64 = unresolved.len() - 1;
            while j > i {
                unresolved.set(j, unresolved.get(j - 1));
                j = j - 1;
            }
            unresolved.set(i, fresh);
            return unresolved;
        }
        i = i + 1;
    }
    var cs2: Vec<str> = Vec::new();
    cs2.push(caller);
    unresolved.push(UnresolvedCall { name: name, callers: cs2 });
    return unresolved;
}

/// Call runtime or program function `name`; one nobody defines traps,
/// and makes generate_pe (or generate_flat) refuse the program.
pub fn PeirGen_call_runtime(self: &mut PeirGen, name: str) -> void {
    if HashMap_contains(self.func_labels, name) {
        var label: i64 = HashMap_get(self.func_labels, name);
        PeirEnc_call_label(&mut self.enc, label);
        return;
    }
    self.unresolved = pe_unresolved_add(self.unresolved, name, self.cur_func);
    PeirEnc_ud2(&mut self.enc);
}

/// Place the label of function `name` (16-byte aligned).
pub fn PeirGen_place_fn(self: &mut PeirGen, name: str) -> void {
    var label: i64 = HashMap_get(self.func_labels, name);
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, label);
}

/// rdata offset of string constant `s` (0 when absent, as unwrap_or(&0)).
pub fn PeirGen_str_off(self: &PeirGen, s: str) -> i64 {
    return HashMap_get(self.string_rdata_offsets, s);
}

/// Get IAT rdata offset for an import
pub fn PeirGen_iat_off(self: &PeirGen, idx: i64) -> i64 {
    return self.iat_rdata_offsets.get(idx);
}

// ===========================================================================
// Bare-metal runtime (`fid emit --bare`, release G2, G3)
//
// No OS: the hardware stubs (interrupts, MMU, GDT, user mode, COM1) are the
// real instructions, p_malloc is a bump allocator from g_pe_bare_heap,
// p_free does nothing, and printing writes to COM1 (port 0x3F8), which is
// what QEMU's `-serial stdio` shows. A panic, a failed overflow or division
// check included, calls the program's @panic_handler (with the message)
// when it has one, else prints "panic: <message>" to COM1; then the CPU
// halts with interrupts off. Any other runtime function traps (ud2).
// ===========================================================================

/// Where the bare-metal heap starts (the bump allocator's first block).
pub var g_pe_bare_heap: i64 = 0x300000;
/// Where a flat binary is loaded (its first byte, a jump to the entry).
pub var g_pe_bare_load: i64 = 0x10000;
/// A static Linux ELF executable instead (release F4, first step): the bare
/// build's code with the system calls of Linux for output, heap and exit.
pub var g_pe_elf: bool = false;
/// The program's @panic_handler ("" when it has none). Like every Fides
/// function it takes `__env` (null here) before the message.
pub var g_pe_bare_panic_handler: str = "";

pub fn PeirGen_gen_bare_runtime(self: &mut PeirGen) -> void {
    PeirGen_gen_interrupt_stubs(self);
    PeirGen_gen_mmu_stubs(self);
    PeirGen_gen_gdt_stubs(self);
    PeirGen_gen_enter_user_mode(self);
    PeirGen_gen_serial_stubs(self);
    PeirGen_gen_malloc(self);
    PeirGen_gen_free(self);
    PeirGen_gen_memset(self);

    var putc: i64 = PeirEnc_alloc_label(&mut self.enc);
    var pstr: i64 = HashMap_get(self.func_labels, "p_print_str");
    var estr: i64 = HashMap_get(self.func_labels, "p_eprint_str");
    if g_pe_elf {
        // Linux (release F4): write(r9 = fd, ...). The syscall takes rdi
        // and rsi, which Fides code keeps across calls: saved here.
        // putc(cl)
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, putc);
        pe_emit3(&mut self.enc, 0x57, 0x56, 0x51);       // push rdi; push rsi; push rcx
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);   // SYS_write
        pe_emit3(&mut self.enc, 0x4C, 0x89, 0xCF);       // mov rdi, r9
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xE6);       // mov rsi, rsp
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 1);
        pe_emit2(&mut self.enc, 0x0F, 0x05);             // syscall
        pe_emit3(&mut self.enc, 0x59, 0x5E, 0x5F);       // pop rcx; pop rsi; pop rdi
        PeirEnc_ret(&mut self.enc);
        // write the C string rcx to fd r9, in one call
        var wstr: i64 = PeirEnc_alloc_label(&mut self.enc);
        var ws_len: i64 = PeirEnc_alloc_label(&mut self.enc);
        var ws_go: i64 = PeirEnc_alloc_label(&mut self.enc);
        var ws_done: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, wstr);
        pe_emit2(&mut self.enc, 0x57, 0x56);             // push rdi; push rsi
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xCE);       // mov rsi, rcx
        pe_emit3(&mut self.enc, 0x48, 0x85, 0xF6);       // test rsi, rsi
        PeirEnc_jcc_label(&mut self.enc, 0x4, ws_done);  // jz
        pe_emit2(&mut self.enc, 0x31, 0xD2);             // xor edx, edx
        PeirEnc_place_label(&mut self.enc, ws_len);
        pe_emit4(&mut self.enc, 0x80, 0x3C, 0x16, 0x00); // cmp byte [rsi+rdx], 0
        PeirEnc_jcc_label(&mut self.enc, 0x4, ws_go);    // je
        pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC2);       // inc rdx
        PeirEnc_jmp_label(&mut self.enc, ws_len);
        PeirEnc_place_label(&mut self.enc, ws_go);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);   // SYS_write
        pe_emit3(&mut self.enc, 0x4C, 0x89, 0xCF);       // mov rdi, r9
        pe_emit2(&mut self.enc, 0x0F, 0x05);             // syscall
        PeirEnc_place_label(&mut self.enc, ws_done);
        pe_emit2(&mut self.enc, 0x5E, 0x5F);             // pop rsi; pop rdi
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_ret(&mut self.enc);
        // p_print_str(rcx): stdout; p_eprint_str(rcx): stderr
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, pstr);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 1);
        PeirEnc_jmp_label(&mut self.enc, wstr);
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, estr);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 2);
        PeirEnc_jmp_label(&mut self.enc, wstr);
    } else {
        // putc(cl): wait until COM1 can take a byte, send it (uses rax, rdx)
        var wait: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, putc);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FD); // COM1 + 5 (LSR)
        PeirEnc_place_label(&mut self.enc, wait);
        pe_emit1(&mut self.enc, 0xEC);       // in al, dx
        pe_emit2(&mut self.enc, 0xA8, 0x20); // test al, 0x20 (THR empty)
        PeirEnc_jcc_label(&mut self.enc, 0x4, wait); // jz
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3F8); // COM1 (THR)
        pe_emit2(&mut self.enc, 0x89, 0xC8); // mov eax, ecx
        pe_emit1(&mut self.enc, 0xEE);       // out dx, al
        PeirEnc_ret(&mut self.enc);

        // p_print_str / p_eprint_str(rcx = C string)
        var ps_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
        var ps_done: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, pstr);
        PeirEnc_place_label(&mut self.enc, estr);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RCX);
        PeirEnc_test_rr(&mut self.enc, PEIR_R8, PEIR_R8);
        PeirEnc_jcc_label(&mut self.enc, 0x4, ps_done); // jz
        PeirEnc_place_label(&mut self.enc, ps_loop);
        pe_emit4(&mut self.enc, 0x41, 0x0F, 0xB6, 0x08); // movzx ecx, byte [r8]
        pe_emit2(&mut self.enc, 0x85, 0xC9);             // test ecx, ecx
        PeirEnc_jcc_label(&mut self.enc, 0x4, ps_done);  // jz
        PeirEnc_call_label(&mut self.enc, putc);
        pe_emit3(&mut self.enc, 0x49, 0xFF, 0xC0);       // inc r8
        PeirEnc_jmp_label(&mut self.enc, ps_loop);
        PeirEnc_place_label(&mut self.enc, ps_done);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_ret(&mut self.enc);
    }

    // p_print_newline()
    PeirGen_place_fn(self, "p_print_newline");
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 1);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 10);
    PeirEnc_jmp_label(&mut self.enc, putc);

    // p_print_bool(rcx)
    var pb_true: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirGen_place_fn(self, "p_print_bool");
    PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pb_true); // jnz
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "false"));
    PeirEnc_jmp_label(&mut self.enc, pstr);
    PeirEnc_place_label(&mut self.enc, pb_true);
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "true"));
    PeirEnc_jmp_label(&mut self.enc, pstr);

    // p_print_int(rcx): decimal, built backwards in a buffer on the stack
    var pi_pos: i64 = PeirEnc_alloc_label(&mut self.enc);
    var pi_digit: i64 = PeirEnc_alloc_label(&mut self.enc);
    var pi_out: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirGen_place_fn(self, "p_print_int");
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RCX);    // the sign
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R8, -1);
    pe_emit4(&mut self.enc, 0x41, 0xC6, 0x00, 0x00);     // mov byte [r8], 0
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x9, pi_pos);       // jns
    PeirEnc_neg_r(&mut self.enc, PEIR_RAX);              // i64 min: 2^63, unsigned
    PeirEnc_place_label(&mut self.enc, pi_pos);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R10, 10);
    PeirEnc_place_label(&mut self.enc, pi_digit);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    pe_emit3(&mut self.enc, 0x49, 0xF7, 0xF2);           // div r10
    pe_emit3(&mut self.enc, 0x80, 0xC2, 0x30);           // add dl, 48
    pe_emit3(&mut self.enc, 0x49, 0xFF, 0xC8);           // dec r8
    pe_emit3(&mut self.enc, 0x41, 0x88, 0x10);           // mov [r8], dl
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pi_digit);     // jnz
    PeirEnc_test_rr(&mut self.enc, PEIR_R9, PEIR_R9);
    PeirEnc_jcc_label(&mut self.enc, 0x9, pi_out);       // jns
    pe_emit3(&mut self.enc, 0x49, 0xFF, 0xC8);           // dec r8
    pe_emit4(&mut self.enc, 0x41, 0xC6, 0x00, 0x2D);     // mov byte [r8], 45 (minus)
    PeirEnc_place_label(&mut self.enc, pi_out);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R8);
    PeirEnc_call_label(&mut self.enc, pstr);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);

    // p_panic(rcx = message): the program's handler, else COM1; then halt
    var halt: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirGen_place_fn(self, "p_panic");
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    if g_pe_bare_panic_handler != "" && HashMap_contains(self.func_labels, g_pe_bare_panic_handler) {
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, g_pe_bare_panic_handler));
    } else if g_pe_elf {
        // As a Windows program: "Panic: <message>" on stderr, exit code 1
        PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "Panic: "));
        PeirEnc_call_label(&mut self.enc, estr);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
        PeirEnc_call_label(&mut self.enc, estr);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 2);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 10);
        PeirEnc_call_label(&mut self.enc, putc);
    } else {
        PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "panic: "));
        PeirEnc_call_label(&mut self.enc, pstr);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
        PeirEnc_call_label(&mut self.enc, pstr);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 10);
        PeirEnc_call_label(&mut self.enc, putc);
    }
    if g_pe_elf {
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 231);  // SYS_exit_group
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDI, 1);
        pe_emit2(&mut self.enc, 0x0F, 0x05);              // syscall
    }
    PeirEnc_place_label(&mut self.enc, halt);
    pe_emit2(&mut self.enc, 0xFA, 0xF4); // cli; hlt
    PeirEnc_jmp_label(&mut self.enc, halt);

    // p_argc: no command line
    PeirGen_place_fn(self, "p_argc");
    PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// Place each of `names` not placed yet at a trap: the runtime functions a
/// bare build has no body for.
pub fn PeirGen_trap_unplaced(self: &mut PeirGen, names: Vec<str>) -> void {
    var ni: i64 = 0;
    while ni < names.len() {
        if HashMap_contains(self.func_labels, names.get(ni)) {
            var l: i64 = HashMap_get(self.func_labels, names.get(ni));
            if self.enc.labels.get(l) < 0 {
                PeirEnc_place_label(&mut self.enc, l);
                PeirEnc_ud2(&mut self.enc);
            }
        }
        ni = ni + 1;
    }
}

// ===========================================================================
// gen_runtime_stubs (src/pe.rs) — the non-bare sequence, verbatim
// ===========================================================================

pub fn PeirGen_gen_runtime_stubs(self: &mut PeirGen) -> void {
    if self.bare_mode {
        PeirGen_gen_bare_runtime(self);
        return;
    }
    // Runtime functions that only pretended to work (string search,
    // replace, case, trim, vec sort/insert, map keys...) are not
    // generated: a program calling one is refused (see generate_pe).
    PeirGen_gen_arena_stubs(self);
    PeirGen_gen_print_int(self);
    PeirGen_gen_print_str(self);
    PeirGen_gen_print_bool(self);
    PeirGen_gen_print_float(self);
    PeirGen_gen_panic(self);
    PeirGen_gen_malloc(self);
    PeirGen_gen_free(self);
    PeirGen_gen_memset(self);
    PeirGen_gen_str_concat(self);
    PeirGen_gen_to_str(self);
    PeirGen_gen_to_str_vec(self);
    PeirGen_gen_to_str_float(self);
    PeirGen_gen_to_str_str(self);
    PeirGen_gen_to_str_bool(self);
    PeirGen_gen_float_to_str_alias(self);
    PeirGen_gen_bool_to_str_alias(self);
    PeirGen_gen_char_to_str(self);
    PeirGen_gen_eprint_str(self);
    PeirGen_gen_print_newline(self);
    PeirGen_gen_sb_new(self);
    PeirGen_gen_sb_append(self);
    PeirGen_gen_sb_to_str(self);
    PeirGen_gen_file_read(self);
    PeirGen_gen_file_write(self);
    PeirGen_gen_str_join_n(self);
    PeirGen_gen_vec_new(self);
    PeirGen_gen_vec_push(self);
    PeirGen_gen_vec_len(self);
    PeirGen_gen_vec_get(self);
    PeirGen_gen_vec_pop(self);
    PeirGen_gen_print_vec(self);
    PeirGen_gen_map_new(self);
    PeirGen_gen_map_insert(self);
    PeirGen_gen_map_get(self);
    PeirGen_gen_map_contains(self);
    PeirGen_gen_map_remove(self);
    PeirGen_gen_map_len(self);
    PeirGen_gen_map_is_empty(self);
    PeirGen_gen_print_map(self);
    // New Vec stubs
    PeirGen_gen_vec_set(self);
    PeirGen_gen_vec_is_empty(self);
    PeirGen_gen_vec_clear(self);
    PeirGen_gen_vec_capacity(self);
    PeirGen_gen_vec_first(self);
    PeirGen_gen_vec_last(self);
    PeirGen_gen_vec_contains(self);
    PeirGen_gen_vec_truncate(self);
    PeirGen_gen_vec_clone(self);
    // New HashMap stubs
    PeirGen_gen_map_clear(self);
    PeirGen_gen_map_get_or(self);
    // String stubs
    PeirGen_gen_string_len(self);
    PeirGen_gen_string_is_empty(self);
    PeirGen_gen_string_starts_with(self);
    PeirGen_gen_string_parse_int(self);
    PeirGen_gen_string_bytes(self);
    PeirGen_gen_string_clone(self);
    // Phase 5A.3: Interrupt handler stubs
    PeirGen_gen_interrupt_stubs(self);
    // Phase 5A.4: MMU/page table stubs
    PeirGen_gen_mmu_stubs(self);
    // Phase 5A.5: GDT stubs
    PeirGen_gen_gdt_stubs(self);
    // User-mode transition stub
    PeirGen_gen_enter_user_mode(self);
    // Serial port: no port I/O in a Windows process.  As in the C backend,
    // init and write do nothing, read and ready return 0.
    var serial_stubs: Vec<str> = Vec::new();
    serial_stubs.push("p_serial_init"); serial_stubs.push("p_serial_write");
    serial_stubs.push("p_serial_read"); serial_stubs.push("p_serial_ready");
    var si: i64 = 0;
    while si < serial_stubs.len() {
        PeirGen_place_fn(self, serial_stubs.get(si));
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_ret(&mut self.enc);
        si = si + 1;
    }
    // Native runtime stubs: argv, process exec
    PeirGen_gen_argc(self);
    PeirGen_gen_argv(self);
    PeirGen_gen_system(self);
}

// ===========================================================================
// Interrupt / MMU / GDT / user-mode stubs (Phase 5A.3-5A.6)
//
// In normal (Windows) mode each stub emits ud2 — these instructions are
// meaningless under an OS.  The Rust bare-metal bodies are not ported; the
// bare_mode guard panics (unreachable: gen_runtime_stubs panics on bare).
// ===========================================================================

/// Generate interrupt control stubs (Phase 5A.3)
pub fn PeirGen_gen_interrupt_stubs(self: &mut PeirGen) -> void {
    // p_cli() — clear interrupt flag
    var label: i64 = HashMap_get(self.func_labels, "p_cli");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        pe_emit1(&mut self.enc, 0xFA); // cli
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_sti() — set interrupt flag
    label = HashMap_get(self.func_labels, "p_sti");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        pe_emit1(&mut self.enc, 0xFB); // sti
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_hlt() — halt CPU (hlt only; interrupts must be enabled for wakeup)
    label = HashMap_get(self.func_labels, "p_hlt");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        pe_emit1(&mut self.enc, 0xF4); // hlt (no cli — interrupts wake the CPU)
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_lidt(rcx = ptr to IDT descriptor) — load IDT
    label = HashMap_get(self.func_labels, "p_lidt");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // lidt [rcx]
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x01, 0x19); // lidt [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_idt_set_entry(rcx = idt_ptr, rdx = vector, r8 = handler_addr, r9 = flags)
    // Writes a 16-byte IDT gate descriptor at idt_ptr + vector * 16 (bare only).
    label = HashMap_get(self.func_labels, "p_idt_set_entry");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // rcx = idt_ptr (base), rdx = vector, r8 = handler_addr, r9 = flags
        // Compute gate address: rdx * 16 + rcx → r10
        // r10 = rdx << 4
        PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_RDX);
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_R10, 4);
        // r10 = r10 + rcx (idt_ptr + vector*16)
        PeirEnc_add_rr(&mut self.enc, PEIR_R10, PEIR_RCX);
        // offset_low = handler_addr & 0xFFFF → [r10 + 0]
        // mov rax, r8 (handler_addr)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
        // mov [r10], ax
        pe_emit4(&mut self.enc, 0x66, 0x41, 0x89, 0x02); // mov [r10], ax
        // selector = 0x08 → [r10 + 2]
        pe_emit7(&mut self.enc, 0x66, 0x41, 0xC7, 0x42, 0x02, 0x08, 0x00); // mov word [r10+2], 0x0008
        // ist = 0 → [r10 + 4]
        pe_emit5(&mut self.enc, 0x41, 0xC6, 0x42, 0x04, 0x00); // mov byte [r10+4], 0
        // type_attr = flags | 0x8E → [r10 + 5]
        // r9 = flags, or with 0x8E
        pe_emit4(&mut self.enc, 0x41, 0x80, 0xC9, 0x8E); // or r9b, 0x8E
        pe_emit4(&mut self.enc, 0x45, 0x88, 0x4A, 0x05); // mov [r10+5], r9b
        // offset_mid = (handler_addr >> 16) & 0xFFFF → [r10 + 6]
        // shr rax, 16
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x10); // shr rax, 16
        // mov [r10 + 6], ax
        pe_emit5(&mut self.enc, 0x66, 0x41, 0x89, 0x42, 0x06); // mov [r10+6], ax
        // offset_high = (handler_addr >> 32) & 0xFFFFFFFF → [r10 + 8]
        // shr rax, 16  (rax now = handler_addr >> 32)
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x10); // shr rax, 16
        // mov [r10 + 8], eax
        pe_emit4(&mut self.enc, 0x41, 0x89, 0x42, 0x08); // mov [r10+8], eax
        // reserved = 0 → [r10 + 12]
        pe_emit8(&mut self.enc, 0x41, 0xC7, 0x42, 0x0C, 0x00, 0x00, 0x00, 0x00); // mov dword [r10+12], 0
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_inb(rcx = port) -> rax = byte — read from I/O port
    label = HashMap_get(self.func_labels, "p_inb");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Port is in rcx, move to dx for in al, dx
        // mov dx, cx (16-bit)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xCA); // mov dx, cx
        // xor rax, rax
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        // in al, dx
        pe_emit1(&mut self.enc, 0xEC); // in al, dx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_inw(rcx = port) -> rax = word — read 16-bit from I/O port
    label = HashMap_get(self.func_labels, "p_inw");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov dx, cx (16-bit)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xCA); // mov dx, cx
        // xor rax, rax
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        // in ax, dx
        pe_emit2(&mut self.enc, 0x66, 0xED); // in ax, dx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_outb(rcx = port, rdx = value) — write to I/O port
    label = HashMap_get(self.func_labels, "p_outb");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // rcx = port, rdx = value
        // mov al, dl (value to al — must do before overwriting dx)
        pe_emit2(&mut self.enc, 0x88, 0xD0); // mov al, dl (value to al)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xCA); // mov dx, cx (port to dx)
        // out dx, al
        pe_emit1(&mut self.enc, 0xEE); // out dx, al
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_outw(rcx = port, rdx = value) — write 16-bit word to I/O port
    label = HashMap_get(self.func_labels, "p_outw");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // rcx = port, rdx = value
        // mov ax, dx (value to ax — must do before overwriting dx)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xD0); // mov ax, dx (value to ax)
        // mov dx, cx (port to dx)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xCA); // mov dx, cx (port to dx)
        // out dx, ax
        pe_emit2(&mut self.enc, 0x66, 0xEF); // out dx, ax
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_outl(rcx = port, rdx = value) — write 32-bit dword to I/O port
    label = HashMap_get(self.func_labels, "p_outl");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // rcx = port, rdx = value
        // mov eax, edx (value to eax)
        pe_emit2(&mut self.enc, 0x89, 0xD0); // mov eax, edx
        // mov dx, cx (port to dx)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xCA); // mov dx, cx (port to dx)
        // out dx, eax
        pe_emit1(&mut self.enc, 0xEF); // out dx, eax
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_inl(rcx = port) -> rax — read 32-bit dword from I/O port
    label = HashMap_get(self.func_labels, "p_inl");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov dx, cx (port to dx)
        pe_emit3(&mut self.enc, 0x66, 0x89, 0xCA); // mov dx, cx
        // in eax, dx
        pe_emit1(&mut self.enc, 0xED); // in eax, dx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);
}

/// Generate MMU/page table management stubs (Phase 5A.4)
pub fn PeirGen_gen_mmu_stubs(self: &mut PeirGen) -> void {
    // p_cr3_read() -> rax — read CR3 (page table base)
    var label: i64 = HashMap_get(self.func_labels, "p_cr3_read");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, cr3
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x20, 0xD8); // mov rax, cr3
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_cr3_write(rcx = addr) — write CR3
    label = HashMap_get(self.func_labels, "p_cr3_write");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov cr3, rcx
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x22, 0xD9); // mov cr3, rcx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_cr0_read() -> rax — read CR0
    label = HashMap_get(self.func_labels, "p_cr0_read");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, cr0
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x20, 0xC0); // mov rax, cr0
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_cr0_write(rcx = val) — write CR0
    label = HashMap_get(self.func_labels, "p_cr0_write");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov cr0, rcx
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x22, 0xC1); // mov cr0, rcx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_cr2_read() -> rax — read CR2 (page fault address)
    label = HashMap_get(self.func_labels, "p_cr2_read");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, cr2
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x20, 0xD0); // mov rax, cr2
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_cr4_read() -> rax — read CR4
    label = HashMap_get(self.func_labels, "p_cr4_read");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, cr4
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x20, 0xE0); // mov rax, cr4
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_cr4_write(rcx = val) — write CR4
    label = HashMap_get(self.func_labels, "p_cr4_write");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov cr4, rcx
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x22, 0xE1); // mov cr4, rcx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_invlpg(rcx = addr) — invalidate TLB entry
    label = HashMap_get(self.func_labels, "p_invlpg");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // invlpg [rcx]
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x01, 0x39); // invlpg [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // T10: p_wrmsr_gs_base(rcx = value) — write GS base (MSR 0xC0000101)
    label = HashMap_get(self.func_labels, "p_wrmsr_gs_base");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Save rcx (value) before clobbering ecx with the MSR address.
        // mov rax, rcx            ; rax = value (low 32 will be used)
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xC8); // mov rax, rcx
        // mov rdx, rax            ; rdx = value (high 32 in edx after shift)
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xC2); // mov rdx, rax
        // shr rdx, 32             ; edx = high 32 bits
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xEA, 0x20); // shr rdx, 32
        // mov ecx, 0xC0000101     ; MSR_GS_BASE
        pe_emit5(&mut self.enc, 0xB9, 0x01, 0x01, 0x00, 0xC0); // mov ecx, 0xC0000101
        // wrmsr
        pe_emit2(&mut self.enc, 0x0F, 0x30); // wrmsr
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // T10: p_rdmsr_gs_base() -> rax — read GS base (MSR 0xC0000101)
    label = HashMap_get(self.func_labels, "p_rdmsr_gs_base");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov ecx, 0xC0000101     ; MSR_GS_BASE
        pe_emit5(&mut self.enc, 0xB9, 0x01, 0x01, 0x00, 0xC0); // mov ecx, 0xC0000101
        // rdmsr                   ; edx:eax = MSR value
        pe_emit2(&mut self.enc, 0x0F, 0x32); // rdmsr
        // shl rdx, 32             ; shift high 32 bits into position
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE2, 0x20); // shl rdx, 32
        // or rax, rdx             ; combine low and high
        pe_emit3(&mut self.enc, 0x48, 0x09, 0xD0); // or rax, rdx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // T10: p_wrmsr_kernel_gs_base(rcx = value) — write KernelGSBase (0xC0000102)
    label = HashMap_get(self.func_labels, "p_wrmsr_kernel_gs_base");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xC8); // mov rax, rcx
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xC2); // mov rdx, rax
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xEA, 0x20); // shr rdx, 32
        // mov ecx, 0xC0000102     ; MSR_KERNEL_GS_BASE
        pe_emit5(&mut self.enc, 0xB9, 0x02, 0x01, 0x00, 0xC0); // mov ecx, 0xC0000102
        pe_emit2(&mut self.enc, 0x0F, 0x30); // wrmsr
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // T10: p_swapgs() — swap GS base and KernelGSBase
    label = HashMap_get(self.func_labels, "p_swapgs");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // swapgs
        pe_emit3(&mut self.enc, 0x0F, 0x01, 0xF8); // swapgs
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_page_map(rcx=PML4 base, rdx=virt_addr, r8=phys_addr, r9=flags)
    // Bare-metal 4-level page walk; under an OS, a trap.
    label = HashMap_get(self.func_labels, "p_page_map");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Save callee-saved registers
        PeirEnc_push(&mut self.enc, PEIR_RBP);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
        PeirEnc_push(&mut self.enc, PEIR_R12); // PML4 base
        PeirEnc_push(&mut self.enc, PEIR_R13); // virt_addr
        PeirEnc_push(&mut self.enc, PEIR_R14); // phys_addr
        PeirEnc_push(&mut self.enc, PEIR_R15); // flags
        PeirEnc_sub_rsp_i32(&mut self.enc, 16); // alignment + temp
        // r12 = PML4 base (rcx)
        PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
        // r13 = virt_addr (rdx)
        PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);
        // r14 = phys_addr (r8)
        PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_R8);
        // r15 = flags (r9)
        PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_R9);
        // === Level 1: PML4 (bits 39-47) ===
        // rax = (r13 >> 39) & 0x1FF
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x27); // shr rax, 39
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00); // and rax, 0x1FF
        // rax = rax * 8 (entry offset)
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        // rax = r12 + rax (PML4 entry address)
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
        // Read PML4 entry: rcx = [rax]
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // Test present bit (bit 0): if 0, allocate new PDPT
        PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        var pm_have_pdpt: i64 = PeirEnc_alloc_label(&mut self.enc);
        // test rcx, 1 → jnz pm_have_pdpt
        pe_emit7(&mut self.enc, 0x48, 0xF7, 0xC1, 0x01, 0x00, 0x00, 0x00); // test rcx, 1
        PeirEnc_jcc_label(&mut self.enc, 0x5, pm_have_pdpt); // jnz
        // Allocate new PDPT at bump allocator (0x200000)
        // Load current bump ptr: rax = [0x200000]
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x200000);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX); // rcx = bump ptr
        // Advance bump ptr by 4096 (one page table)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        // rdx = rcx + 4096 (the Rust version also emitted `add rdx, 0` and a
        // stray 0x10 byte here, which swallowed the next instruction)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 4096);
        PeirEnc_add_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        // Store new bump ptr: [0x200000] = rdx
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x200000);
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RDX);
        // Zero the new page table (4096 bytes = 512 qwords)
        // rdi = rcx (new table), xor rax,rax, mov rcx_loop=512, rep stosq
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDI, PEIR_RCX); // rdi = table addr
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX); // rax = 0
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 512); // rcx = 512
        pe_emit3(&mut self.enc, 0xF3, 0x48, 0xAB); // rep stosq
        // Set PML4 entry = new_table_addr | present | writable
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RDI); // rcx = new table addr (rdi was modified, use saved)
        // Actually rdi was modified by rep stosq. Reload from bump ptr - 0x1000
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x200000);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_RAX); // rdx = current bump
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xEA, 0x10); // sub rdx, 16 — wrong, need sub 0x1000
        // Fix: use mov_imm32 + sub
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 4096);
        pe_emit3(&mut self.enc, 0x48, 0x29, 0xC2); // sub rdx, rax
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RDX); // rcx = new table addr
        // or rcx, 3 (present | writable)
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xC9, 0x03); // or rcx, 3
        // Re-read PML4 entry address and store
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13); // rax = virt
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x27); // shr rax, 39
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00); // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R12); // rax = PML4 entry addr
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX); // store entry
        // rcx = table base (strip flags)
        pe_emit6(&mut self.enc, 0x48, 0x25, 0x00, 0xF0, 0xFF, 0xFF); // and rax, 0xFFFFF000 — wrong reg
        // Use: and rcx, ~0xFFF
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_place_label(&mut self.enc, pm_have_pdpt);
        // rcx = PDPT base (strip flags from PML4 entry)
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // For now, just map at PT level directly (simplified 4KB page mapping).
        // Full 4-level walk is complex in raw asm; this handles the common case
        // where intermediate tables already exist (pre-allocated by bootloader).
        // Walk PDPT (bits 30-38), PD (bits 21-29), PT (bits 12-20).
        // Each level: index = (virt >> shift) & 0x1FF; entry = table[index]; if not present, alloc; table = entry & ~0xFFF
        // === Level 2: PDPT (bits 30-38) ===
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x1E); // shr rax, 30
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00); // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX); // rcx = PDPT entry
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX); // strip flags
        // === Level 3: PD (bits 21-29) ===
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x15); // shr rax, 21
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00); // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX); // rcx = PD entry
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX); // strip flags
        // === Level 4: PT (bits 12-20) ===
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x0C); // shr rax, 12
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00); // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX); // rax = PT entry address
        // Set PT entry = phys_addr | flags
        // r14 = phys_addr, r15 = flags
        // entry = (r14 & ~0xFFF) | (r15 & 0xFFF)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RDX); // phys & ~0xFFF
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, 0x0000000000000FFF);
        PeirEnc_and_rr(&mut self.enc, PEIR_R15, PEIR_RDX); // flags & 0xFFF
        PeirEnc_or_rr(&mut self.enc, PEIR_RCX, PEIR_R15); // phys | flags
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX); // store PTE
        // Restore and return
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xC4, 0x10); // add rsp, 16
        PeirEnc_pop(&mut self.enc, PEIR_R15);
        PeirEnc_pop(&mut self.enc, PEIR_R14);
        PeirEnc_pop(&mut self.enc, PEIR_R13);
        PeirEnc_pop(&mut self.enc, PEIR_R12);
        PeirEnc_pop(&mut self.enc, PEIR_RBP);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_page_unmap(rcx=PML4 base, rdx=virt_addr)
    label = HashMap_get(self.func_labels, "p_page_unmap");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        PeirEnc_push(&mut self.enc, PEIR_RBP);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
        PeirEnc_push(&mut self.enc, PEIR_R12); // PML4 base
        PeirEnc_push(&mut self.enc, PEIR_R13); // virt_addr
        PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);
        // Walk PML4 → PDPT → PD → PT (same as p_page_map but read-only)
        // PML4 (bits 39-47)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x27); // shr rax, 39
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00); // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // PDPT (bits 30-38)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x1E); // shr rax, 30
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00); // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // PD (bits 21-29)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x15); // shr rax, 21
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00); // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, -4096);
        PeirEnc_and_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        // PT (bits 12-20)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x0C); // shr rax, 12
        pe_emit6(&mut self.enc, 0x48, 0x25, 0xFF, 0x01, 0x00, 0x00); // and rax, 0x1FF
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX); // rax = PT entry address
        // Clear the PTE: mov qword [rax], 0
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
        // invlpg [r13]
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x01, 0xBD); // invlpg [r13] — using rbp? no
        // invlpg [rcx] where rcx = virt_addr
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0x01, 0x39); // invlpg [rcx]
        PeirEnc_pop(&mut self.enc, PEIR_R13);
        PeirEnc_pop(&mut self.enc, PEIR_R12);
        PeirEnc_pop(&mut self.enc, PEIR_RBP);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_phys_read64(rcx=addr) -> rax — read 8 bytes from physical address
    label = HashMap_get(self.func_labels, "p_phys_read64");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, [rcx]
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_phys_write64(rcx=addr, rdx=val) — write 8 bytes to physical address
    label = HashMap_get(self.func_labels, "p_phys_write64");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov [rcx], rdx
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RCX, PEIR_RDX);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_read8(rcx=addr) -> rax — read 1 byte from memory
    label = HashMap_get(self.func_labels, "p_mem_read8");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // movzx eax, byte [rcx]
        pe_emit3(&mut self.enc, 0x0F, 0xB6, 0x01); // movzx eax, byte [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_write8(rcx=addr, rdx=val) — write 1 byte to memory
    label = HashMap_get(self.func_labels, "p_mem_write8");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov [rcx], dl
        pe_emit2(&mut self.enc, 0x88, 0x11); // mov [rcx], dl
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_read16(rcx=addr) -> rax — read 2 bytes from memory
    label = HashMap_get(self.func_labels, "p_mem_read16");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // movzx eax, word [rcx]
        pe_emit3(&mut self.enc, 0x0F, 0xB7, 0x01); // movzx eax, word [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_write16(rcx=addr, rdx=val) — write 2 bytes to memory
    label = HashMap_get(self.func_labels, "p_mem_write16");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov [rcx], dx
        pe_emit3(&mut self.enc, 0x66, 0x89, 0x11); // mov [rcx], dx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_read32(rcx=addr) -> rax — read 4 bytes from memory
    label = HashMap_get(self.func_labels, "p_mem_read32");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov eax, [rcx]
        pe_emit2(&mut self.enc, 0x8B, 0x01); // mov eax, [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_write32(rcx=addr, rdx=val) — write 4 bytes to memory
    label = HashMap_get(self.func_labels, "p_mem_write32");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov [rcx], edx
        pe_emit2(&mut self.enc, 0x89, 0x11); // mov [rcx], edx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_read64(rcx=addr) -> rax — read 8 bytes from memory
    label = HashMap_get(self.func_labels, "p_mem_read64");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, [rcx]
        pe_emit3(&mut self.enc, 0x48, 0x8B, 0x01); // mov rax, [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_mem_write64(rcx=addr, rdx=val) — write 8 bytes to memory
    label = HashMap_get(self.func_labels, "p_mem_write64");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov [rcx], rdx
        pe_emit3(&mut self.enc, 0x48, 0x89, 0x11); // mov [rcx], rdx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_get_rbp() -> rax = RBP
    label = HashMap_get(self.func_labels, "p_get_rbp");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, rbp
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RBP);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_get_rsp() -> rax = RSP
    label = HashMap_get(self.func_labels, "p_get_rsp");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // mov rax, rsp
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RSP);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_atomic_xchg32(rcx=addr, rdx=value) -> rax = old value
    label = HashMap_get(self.func_labels, "p_atomic_xchg32");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // lock xchg [rcx], edx
        pe_emit1(&mut self.enc, 0xF0); // lock prefix
        pe_emit2(&mut self.enc, 0x87, 0x11); // xchg [rcx], edx
        // Old value is now in edx, move to rax
        // xchg puts old [rcx] in edx and new value in [rcx]
        // Actually xchg [rcx], edx: edx gets old [rcx], [rcx] gets old edx
        // So rax needs to be set to edx (the old value)
        // But xchg already set edx to the old value, and edx was the input
        // Wait: xchg [rcx], edx exchanges edx and [rcx]
        // Before: [rcx] = old_val, edx = new_val
        // After:  [rcx] = new_val, edx = old_val
        // So mov eax, edx to return old_val
        pe_emit2(&mut self.enc, 0x89, 0xD0); // mov eax, edx
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);
}

/// Generate GDT stubs (Phase 5A.5)
pub fn PeirGen_gen_gdt_stubs(self: &mut PeirGen) -> void {
    // p_lgdt(rcx = pointer to GDT descriptor)
    var label: i64 = HashMap_get(self.func_labels, "p_lgdt");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // lgdt [rcx] — 0x0F 0x01 0x19
        pe_emit3(&mut self.enc, 0x0F, 0x01, 0x19); // lgdt [rcx]
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_gdt_set_entry(rcx = gdt_ptr, rdx = index, r8 = base, r9 = limit,
    // stack[16] = flags) — writes an 8-byte GDT entry (bare only).
    label = HashMap_get(self.func_labels, "p_gdt_set_entry");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // rcx = gdt_ptr, rdx = index, r8 = base, r9 = limit
        // flags is on stack at [rbp + 16] (after return address + rbp)
        PeirEnc_push(&mut self.enc, PEIR_RBP);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
        // r10 = rdx * 8 + rcx (entry address)
        PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_RDX);
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_R10, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_R10, PEIR_RCX);
        // limit_low = r9 & 0xFFFF → [r10 + 0]
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R9);
        pe_emit4(&mut self.enc, 0x66, 0x41, 0x89, 0x02); // mov [r10], ax
        // base_low = r8 & 0xFFFF → [r10 + 2]
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
        pe_emit5(&mut self.enc, 0x66, 0x41, 0x89, 0x42, 0x02); // mov [r10+2], ax
        // base_mid = (r8 >> 16) & 0xFF → [r10 + 4]
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x10); // shr rax, 16
        pe_emit4(&mut self.enc, 0x41, 0x88, 0x42, 0x04); // mov [r10+4], al
        // type_attr = flags (from stack) → [r10 + 5]
        // flags at [rbp + 16] (first stack arg on x64 Windows: shadow space + return addr)
        // On Windows x64, 5th arg is at [rbp + 8 + 32] = [rbp + 40]
        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX); // clear upper bits (al = base_mid, reuse)
        // Load flags from stack: [rbp + 40]
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, 48);
        pe_emit4(&mut self.enc, 0x41, 0x88, 0x42, 0x05); // mov [r10+5], al
        // limit_high + flags_high = ((r9 >> 16) & 0x0F) | ((flags >> 8) & 0xF0) → [r10 + 6]
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R9);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x10); // shr rax, 16
        pe_emit6(&mut self.enc, 0x48, 0x25, 0x0F, 0x00, 0x00, 0x00); // and rax, 0x0F
        // Load flags again, shift right 8, mask 0xF0
        PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, 48);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE9, 0x08); // shr rcx, 8
        pe_emit7(&mut self.enc, 0x48, 0x81, 0xE1, 0xF0, 0x00, 0x00, 0x00); // and rcx, 0xF0
        PeirEnc_or_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
        pe_emit4(&mut self.enc, 0x41, 0x88, 0x42, 0x06); // mov [r10+6], al
        // base_high = (r8 >> 24) & 0xFF → [r10 + 7]
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x18); // shr rax, 24
        pe_emit4(&mut self.enc, 0x41, 0x88, 0x42, 0x07); // mov [r10+7], al
        PeirEnc_pop(&mut self.enc, PEIR_RBP);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);
}

/// p_enter_user_mode(rcx = entry_addr, rdx = stack_addr) -> void
/// Transitions from ring 0 (kernel) to ring 3 (user) via iretq.
pub fn PeirGen_gen_enter_user_mode(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_enter_user_mode");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // rcx = entry_addr (RIP), rdx = stack_addr (RSP)
        // Save entry/stack in callee-saved regs (r11, r12) before CR3 switch
        // mov r11, rcx (entry addr)
        pe_emit3(&mut self.enc, 0x49, 0x89, 0xCB); // mov r11, rcx
        // mov r12, rdx (stack addr)
        pe_emit3(&mut self.enc, 0x49, 0x89, 0xD4); // mov r12, rdx
        // Switch CR3 to user page tables (0x72000)
        // mov eax, 0x72000
        pe_emit5(&mut self.enc, 0xB8, 0x00, 0x20, 0x07, 0x00); // mov eax, 0x72000
        // mov cr3, rax
        pe_emit3(&mut self.enc, 0x0F, 0x22, 0xD8); // mov cr3, rax
        // Build iret frame on kernel stack, then iretq
        // Push SS (user data segment = 0x23, index 4 | RPL=3)
        pe_emit2(&mut self.enc, 0x6A, 0x23); // push 0x23
        // Push RSP (user stack = r12)
        PeirEnc_push(&mut self.enc, PEIR_R12);
        // Push RFLAGS = 0x202 (IF=1, bit1=1) as a constant
        pe_emit5(&mut self.enc, 0x68, 0x02, 0x02, 0x00, 0x00); // push 0x202
        // Push CS (user code segment = 0x1B, index 3 | RPL=3)
        pe_emit2(&mut self.enc, 0x6A, 0x1B); // push 0x1B
        // Push RIP (entry address = r11)
        PeirEnc_push(&mut self.enc, PEIR_R11);
        // iretq — pops RIP, CS, RFLAGS, RSP, SS and jumps to ring 3
        pe_emit2(&mut self.enc, 0x48, 0xCF); // iretq
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    // No ret — iretq never returns here
}

/// Generate serial port stubs (Phase 5A.6).  Only called in bare mode in
/// Rust; kept for parity (bare bodies not ported — they panic).
pub fn PeirGen_gen_serial_stubs(self: &mut PeirGen) -> void {
    // p_serial_init() — initialize COM1 serial port (115200 baud, 8N1)
    var label: i64 = HashMap_get(self.func_labels, "p_serial_init");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Disable interrupts: outb(0x3F8 + 1, 0x00)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3F9); // COM1 + 1
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        pe_emit1(&mut self.enc, 0xEE); // out dx, al
        // Enable DLAB: outb(0x3F8 + 3, 0x80)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FB); // COM1 + 3 (LCR)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 0x80);
        pe_emit1(&mut self.enc, 0xEE); // out dx, al
        // Set divisor low byte (115200 baud = divisor 1): outb(0x3F8 + 0, 0x01)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3F8); // COM1 + 0
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 0x01);
        pe_emit1(&mut self.enc, 0xEE); // out dx, al
        // Set divisor high byte: outb(0x3F8 + 1, 0x00)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3F9); // COM1 + 1
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        pe_emit1(&mut self.enc, 0xEE); // out dx, al
        // 8 bits, no parity, 1 stop bit: outb(0x3F8 + 3, 0x03)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FB); // COM1 + 3 (LCR)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 0x03);
        pe_emit1(&mut self.enc, 0xEE); // out dx, al
        // Enable FIFO, clear them, 14-byte threshold: outb(0x3F8 + 2, 0xC7)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FA); // COM1 + 2 (FCR)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 0xC7);
        pe_emit1(&mut self.enc, 0xEE); // out dx, al
        // IRQs enabled, RTS/DSR set: outb(0x3F8 + 4, 0x0B)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FC); // COM1 + 4 (MCR)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 0x0B);
        pe_emit1(&mut self.enc, 0xEE); // out dx, al
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_serial_write(rcx = char) — write one byte to COM1
    label = HashMap_get(self.func_labels, "p_serial_write");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Wait for transmit buffer empty (Line Status Register bit 5)
        var sw_wait: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_place_label(&mut self.enc, sw_wait);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FD); // COM1 + 5 (LSR)
        pe_emit1(&mut self.enc, 0xEC); // in al, dx
        pe_emit2(&mut self.enc, 0xA8, 0x20); // test al, 0x20 (THR empty)
        PeirEnc_jcc_label(&mut self.enc, 0x4, sw_wait); // jz (wait until set)
        // Send byte: outb(0x3F8, char)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3F8); // COM1 + 0 (THR)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX); // al = char
        pe_emit1(&mut self.enc, 0xEE); // out dx, al
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_serial_read() -> rax = byte — read one byte from COM1
    label = HashMap_get(self.func_labels, "p_serial_read");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Wait for data ready (Line Status Register bit 0)
        var sr_wait: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_place_label(&mut self.enc, sr_wait);
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FD); // COM1 + 5 (LSR)
        pe_emit1(&mut self.enc, 0xEC); // in al, dx
        pe_emit2(&mut self.enc, 0xA8, 0x01); // test al, 0x01 (data ready)
        PeirEnc_jcc_label(&mut self.enc, 0x4, sr_wait); // jz (wait until set)
        // Read byte: in al, 0x3F8
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3F8); // COM1 + 0 (RBR)
        pe_emit1(&mut self.enc, 0xEC); // in al, dx
        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX); // zero-extend al to rax
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);

    // p_serial_ready() -> rax = bool — check if data is available
    label = HashMap_get(self.func_labels, "p_serial_ready");
    PeirEnc_place_label(&mut self.enc, label);
    if self.bare_mode {
        // Read LSR and check bit 0 (data ready)
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x3FD); // COM1 + 5 (LSR)
        pe_emit1(&mut self.enc, 0xEC); // in al, dx
        pe_emit2(&mut self.enc, 0x24, 0x01); // and al, 0x01
        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
    } else {
        PeirEnc_ud2(&mut self.enc);
    }
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// Print stubs
// ===========================================================================

/// p_print_int(rcx = i64 value)
pub fn PeirGen_gen_print_int(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_int");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 80);

    // rax = value, r12 = original value (for sign check later)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);

    // r8 = buffer end pointer (end of local space)
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R8, -24);

    // Save buffer end in r13 for length calculation later
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R8);

    // r9 = 10 (divisor)
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 10);

    // test rax, rax; jns pi_pos; neg rax
    var pi_pos: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x9, pi_pos); // jns
    PeirEnc_neg_r(&mut self.enc, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, pi_pos);

    // pi_loop: dec r8; xor rdx,rdx; div r9; add dl,'0'; mov [r8],dl; test; jnz
    var pi_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pi_loop);
    PeirEnc_dec_r(&mut self.enc, PEIR_R8);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    // div r9 (unsigned div)
    PeirEnc_rex(&mut self.enc, true, false, false, reg_ext(PEIR_R9));
    PeirEnc_emit_u8(&mut self.enc, 0xF7);
    PeirEnc_modrm(&mut self.enc, 3, 6, peir_reg_code(PEIR_R9)); // /6 = div
    // add dl, '0'
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RDX, 48);
    // mov [r8], dl
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R8, PEIR_RDX);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pi_loop); // jnz

    // Check if original value (r12) was negative; prepend '-' if so
    var pi_no_neg: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_R12, PEIR_R12);
    PeirEnc_jcc_label(&mut self.enc, 0x9, pi_no_neg); // jns
    PeirEnc_dec_r(&mut self.enc, PEIR_R8);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RDX, 45); // '-'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R8, PEIR_RDX);
    PeirEnc_place_label(&mut self.enc, pi_no_neg);

    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -11);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX); // handle

    // length = r13 - r8 (buffer_end - current_pos)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_R13);
    PeirEnc_sub_rr(&mut self.enc, PEIR_R9, PEIR_R8); // r9 = length

    // WriteFile(handle, r8, len, &written, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12); // handle
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R8);  // buffer
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R9);   // length
    // r9 = &written = [rbp-64]
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -64);
    // zero the written count
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);

    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    // [rsp+32] = NULL (lpOverlapped)
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);

    // return 0
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 80);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_print_str(rcx = *u8 pointer to null-terminated string)
pub fn PeirGen_gen_print_str(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_str");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 64);

    // r12 = string pointer
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);

    // r13 = length: the header's (zero bytes print, D16), else strlen
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirGen_emit_slen(self, PeirGen_iat_off(self, pe_import_slot("strlen")));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);

    // WriteFile(stdout, r12, r13, &written, NULL)
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -11);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX); // handle
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12); // buffer
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R13);  // length
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -32);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);

    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);

    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_print_bool(rcx = 0 or 1)
pub fn PeirGen_gen_print_bool(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_bool");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 64);

    // test rcx, rcx; jnz pb_true; lea r12, str_false; jmp pb_print
    var pb_true: i64 = PeirEnc_alloc_label(&mut self.enc);
    var pb_print: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pb_true); // jne

    // false
    var false_off: i64 = PeirGen_str_off(self, "false");
    PeirEnc_lea_rip(&mut self.enc, PEIR_R12, false_off);
    PeirEnc_jmp_label(&mut self.enc, pb_print);

    // true
    PeirEnc_place_label(&mut self.enc, pb_true);
    var true_off: i64 = PeirGen_str_off(self, "true");
    PeirEnc_lea_rip(&mut self.enc, PEIR_R12, true_off);

    PeirEnc_place_label(&mut self.enc, pb_print);

    // Calculate length
    PeirEnc_xor_self(&mut self.enc, PEIR_R8);
    var pb_len: i64 = PeirEnc_alloc_label(&mut self.enc);
    var pb_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pb_len);
    PeirEnc_cmp_mem_idx_imm8(&mut self.enc, PEIR_R12, PEIR_R8, 0);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pb_done); // je
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_jmp_label(&mut self.enc, pb_len);
    PeirEnc_place_label(&mut self.enc, pb_done);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R8);

    // WriteFile
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -11);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R13);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -32);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);

    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);

    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_print_float(rcx = double bits as i64)
/// Converts double to string with up to 6 decimal places, strips trailing zeros.
pub fn PeirGen_gen_print_float(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_float");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 264);

    // Stack layout:
    // [rbp-8]   = double value (input bits)
    // [rbp-16]  = 10.0 constant
    // [rbp-24]  = sign mask (0x8000000000000000)
    // [rbp-32]  = magnitude mask (0x7FFFFFFFFFFFFFFF)
    // [rbp-40]  = integer part (saved)
    // [rbp-48]  = is_negative flag
    // [rbp-56]  = fractional part (saved)
    // [rbp-64]  = 0.0 constant
    // [rbp-72]  = int_start pointer (saved R12)
    // [rbp-80]  = &written (for WriteFile)
    // [rbp-88]  = 0.5 constant
    // [rbp-256 .. rbp-89] = character buffer (168 bytes)

    // Store double bits
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -8, PEIR_RCX);

    // Store 10.0 constant (0x4024000000000000)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x4024000000000000);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);

    // Store sign mask (0x8000000000000000 = 1 << 63; the hex literal does
    // not parse in Fides, it saturates to 0)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 1 << 63);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -24, PEIR_RAX);

    // Store magnitude mask
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x7FFFFFFFFFFFFFFF);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -32, PEIR_RAX);

    // Store 0.0 constant
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -64, PEIR_RAX);

    // Store 0.5 constant (0x3FE0000000000000)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x3FE0000000000000);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -88, PEIR_RAX);

    // Load xmm0 = double value
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, -8);

    // Check for zero: AND bits with magnitude mask
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -8);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, -32);
    PeirEnc_and_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var pf_not_zero: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_not_zero); // jnz

    // Zero: write "0" directly
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R12, -256);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48); // '0'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    var pf_write: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, pf_write);

    PeirEnc_place_label(&mut self.enc, pf_not_zero);

    // Check sign: test bits with sign mask
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -8);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, -24);
    PeirEnc_and_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var pf_positive: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pf_positive); // jz

    // Negative: set flag, negate value
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);
    // Flip sign bit: load sign mask into XMM1, then xorpd xmm0, xmm1
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -24);
    PeirEnc_movq_xmm_r64(&mut self.enc, 1, PEIR_RAX);
    PeirEnc_xorpd_xmm_xmm(&mut self.enc, 0, 1);
    PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, -8, 0);
    var pf_after_sign: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, pf_after_sign);

    PeirEnc_place_label(&mut self.enc, pf_positive);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);

    PeirEnc_place_label(&mut self.enc, pf_after_sign);

    // Extract integer part: cvttsd2si rax, xmm0
    PeirEnc_cvttsd2si_r64(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -40, PEIR_RAX);
    // Compute fractional part: xmm1 = (double)rax; xmm0 -= xmm1
    PeirEnc_cvtsi2sd_r64(&mut self.enc, 1, PEIR_RAX);
    PeirEnc_subsd(&mut self.enc, 0, 1);
    PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, -56, 0);

    // r12 = buffer start = [rbp-256], build string FORWARD
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R12, -256);

    // If negative, store '-'
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -48);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var pf_no_minus: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pf_no_minus); // jz
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 45); // '-'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_place_label(&mut self.enc, pf_no_minus);

    // Save int_start = r12
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -72, PEIR_R12);

    // Build integer digits forward (LSD first, will reverse later)
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -40);
    var pf_int_nonzero: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_int_nonzero); // jnz

    // Integer part is 0: store '0'
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48); // '0'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    var pf_int_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, pf_int_done);

    PeirEnc_place_label(&mut self.enc, pf_int_nonzero);
    var pf_int_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pf_int_loop);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 10);
    PeirEnc_rex(&mut self.enc, true, false, false, reg_ext(PEIR_R9));
    PeirEnc_emit_u8(&mut self.enc, 0xF7);
    PeirEnc_modrm(&mut self.enc, 3, 6, peir_reg_code(PEIR_R9));
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RDX, 48);
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RDX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_int_loop); // jnz

    PeirEnc_place_label(&mut self.enc, pf_int_done);
    // Reverse integer digits in-place: int_start to r12-1
    // r13 = int_start, r14 = r12 - 1
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R13, -72);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R14);
    var pf_rev_check: i64 = PeirEnc_alloc_label(&mut self.enc);
    var pf_rev_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pf_rev_check);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R13, PEIR_R14);
    PeirEnc_jcc_label(&mut self.enc, 0x3, pf_rev_done); // jae
    // Swap bytes at r13 and r14
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R10, PEIR_R14);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_R10);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R14, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_dec_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, pf_rev_check);

    PeirEnc_place_label(&mut self.enc, pf_rev_done);

    // Now add '.' if there are fractional digits
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, -56);
    PeirEnc_xorpd_xmm_xmm(&mut self.enc, 1, 1); // zero XMM1
    PeirEnc_ucomisd(&mut self.enc, 0, 1);
    var pf_no_frac: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pf_no_frac); // je — skip if zero

    // Store '.'
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 46); // '.'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);

    // Fractional digit loop (up to 6 digits), forward
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R14, 6);
    var pf_frac_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pf_frac_loop);
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 1, -16);
    PeirEnc_mulsd(&mut self.enc, 0, 1);
    PeirEnc_cvttsd2si_r64(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_cvtsi2sd_r64(&mut self.enc, 1, PEIR_RAX);
    PeirEnc_subsd(&mut self.enc, 0, 1);
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RAX, 48);
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_xorpd_xmm_xmm(&mut self.enc, 1, 1); // zero XMM1
    PeirEnc_ucomisd(&mut self.enc, 0, 1);
    var pf_frac_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pf_frac_done); // je
    PeirEnc_dec_r(&mut self.enc, PEIR_R14);
    var pf_frac_continue: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_frac_continue); // jnz
    PeirEnc_jmp_label(&mut self.enc, pf_frac_done);
    PeirEnc_place_label(&mut self.enc, pf_frac_continue);
    PeirEnc_jmp_label(&mut self.enc, pf_frac_loop);

    PeirEnc_place_label(&mut self.enc, pf_frac_done);

    // Rounding: only if we generated 6 digits (r14 == 0) and frac >= 0.5
    PeirEnc_test_rr(&mut self.enc, PEIR_R14, PEIR_R14);
    var pf_strip: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_strip); // jnz — stopped early

    // Check if remaining frac >= 0.5
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 1, -88);
    PeirEnc_ucomisd(&mut self.enc, 0, 1);
    PeirEnc_jcc_label(&mut self.enc, 0x2, pf_strip); // jb — no rounding

    // Rounding: increment last fractional digit at [r12-1]
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    var pf_round_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pf_round_loop);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RAX, 1);
    // If al > '9' (0x3A), carry
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 58); // '9' + 1
    var pf_round_store: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_round_store); // jnz
    // Carry: set byte to '0', move to previous digit
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    // Check if we hit '.' — skip over it
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 46); // '.'
    var pf_round_skip_dot: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_round_skip_dot); // jnz
    PeirEnc_dec_r(&mut self.enc, PEIR_R13); // skip over '.'
    PeirEnc_place_label(&mut self.enc, pf_round_skip_dot);
    // Check if we hit '-' — stop if so
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 45); // '-'
    var pf_round_stop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pf_round_stop); // jz
    PeirEnc_jmp_label(&mut self.enc, pf_round_loop);

    PeirEnc_place_label(&mut self.enc, pf_round_store);
    // Store incremented byte at [r13]
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_jmp_label(&mut self.enc, pf_strip);

    PeirEnc_place_label(&mut self.enc, pf_round_stop);
    // Carry hit '-': edge case (9.999999 rounding) — accepted as in Rust.

    PeirEnc_place_label(&mut self.enc, pf_strip);
    // Strip trailing zeros from fractional part
    var pf_strip_check: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pf_strip_check);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 48); // '0'
    var pf_strip_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_strip_done); // jnz
    PeirEnc_dec_r(&mut self.enc, PEIR_R12);
    PeirEnc_jmp_label(&mut self.enc, pf_strip_check);

    PeirEnc_place_label(&mut self.enc, pf_strip_done);
    // Check if last char is '.' — remove it
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 46); // '.'
    var pf_no_strip_dot: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, pf_no_strip_dot); // jnz
    PeirEnc_dec_r(&mut self.enc, PEIR_R12); // remove the '.'
    PeirEnc_place_label(&mut self.enc, pf_no_strip_dot);

    PeirEnc_place_label(&mut self.enc, pf_no_frac);

    // r13 = r12 - 1 (last digit position, no newline)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    // r12 = buffer start = [rbp-256]
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R12, -256);

    // Length = r13 - r12 + 1
    PeirEnc_place_label(&mut self.enc, pf_write);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R13);
    PeirEnc_sub_rr(&mut self.enc, PEIR_R8, PEIR_R12);
    PeirEnc_add_r_i8(&mut self.enc, PEIR_R8, 1);

    // WriteFile(stdout, r12, r8, &written, NULL)
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -11);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -80);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);

    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);

    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 264);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_panic(rcx = message pointer)
pub fn PeirGen_gen_panic(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_panic");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12); // message
    PeirEnc_push(&mut self.enc, PEIR_R13); // stderr
    PeirEnc_sub_rsp_i32(&mut self.enc, 80);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);

    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -12); // STD_ERROR_HANDLE
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);

    // The prefix ("Panic: ") and the newline live in a stack slot (rbp-48)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x00203A63696E6150);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -48);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 7);
    PeirGen_gen_panic_write(self);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("strlen")));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
    PeirGen_gen_panic_write(self);

    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x0A);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -48);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 1);
    PeirGen_gen_panic_write(self);

    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 1);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_EXIT_PROCESS));
    PeirEnc_ud2(&mut self.enc);
}

/// WriteFile(r13, rdx, r8, &written, NULL), inside gen_panic's frame
fn PeirGen_gen_panic_write(self: &mut PeirGen) -> void {
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -40);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
}

// Allocator state in writable .rdata: +0 cur, +8 end, +16 cached heap,
// +24 spinlock, +32 the TLS index + 1 of the per-thread free lists (release
// H8; the classes start at 7, so the old global list slot 0 is free for it).
pub const PEIR_ALLOC_STATE_SIZE: i64 = 360;
const PEIR_ALLOC_LISTS: i64 = 32;
// A block's header: this magic | its size class. p_free turns it into
// PEIR_BLOCK_FREED | class, and panics on anything else: a block freed twice,
// or a pointer that never was a block.
const PEIR_BLOCK_MAGIC: i64 = 0xF1DE5A0000000000;
const PEIR_BLOCK_FREED: i64 = 0xF1DE5B0000000000;
const PEIR_CLASS_LARGE: i64 = 63;

/// `fid emit --checked-alloc` (release M7): every block gets pages of its
/// own, ending at an inaccessible guard page; a freed block's pages become
/// inaccessible and are never reused. A use after free, a double free or an
/// overrun past the block faults, with a trace, instead of reading or
/// damaging other data. Slow and memory-hungry: for finding bugs.
pub var g_pe_checked_alloc: bool = false;

const PEIR_CLASS_CHECKED: i64 = 62;

/// p_malloc under --checked-alloc. Block layout from `start`: [base][span]
/// [header] then the payload, placed so that it ends (rounded to 16 bytes)
/// at the guard page.
fn PeirGen_gen_checked_malloc(self: &mut PeirGen) -> void {
    var out: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    // r12 = used = (size + 24 + 15) & ~15
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xC0, 0x27); // add rax, 39
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xE0, 0xF0); // and rax, -16
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
    // r13 = span = round_up(used, 4096) + 4096
    pe_emit2(&mut self.enc, 0x48, 0x05); PeirEnc_emit_i32(&mut self.enc, 4095); // add rax, 4095
    pe_emit2(&mut self.enc, 0x48, 0x25); PeirEnc_emit_i32(&mut self.enc, -4096); // and rax, -4096
    pe_emit2(&mut self.enc, 0x48, 0x05); PeirEnc_emit_i32(&mut self.enc, 4096); // add rax, 4096
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);
    // rax = VirtualAlloc(NULL, span, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE)
    PeirEnc_xor_self(&mut self.enc, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, 0x3000);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, 4);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("VirtualAlloc")));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, out); // jz: out of memory, NULL
    // VirtualProtect(base + span - 4096, 4096, PAGE_NOACCESS, &old)
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 40, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    pe_emit3(&mut self.enc, 0x48, 0x81, 0xE9); PeirEnc_emit_i32(&mut self.enc, 4096); // sub rcx, 4096
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, 4096);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, 1);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RSP);
    pe_emit4(&mut self.enc, 0x49, 0x83, 0xC1, 0x20); // add r9, 32
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("VirtualProtect")));
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, 40);
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    // rcx = start = base + span - 4096 - used: [base][span][header]
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    pe_emit3(&mut self.enc, 0x48, 0x81, 0xE9); PeirEnc_emit_i32(&mut self.enc, 4096); // sub rcx, 4096
    PeirEnc_sub_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 0, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 8, PEIR_R13);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, PEIR_BLOCK_MAGIC | PEIR_CLASS_CHECKED);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 16, PEIR_RDX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    pe_emit4(&mut self.enc, 0x48, 0x83, 0xC0, 0x18); // add rax, 24
    PeirEnc_place_label(&mut self.enc, out);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// Acquire the allocator's spinlock.
fn PeirGen_gen_alloc_lock(self: &mut PeirGen, abase: i64) -> void {
    var retry: i64 = PeirEnc_alloc_label(&mut self.enc);
    var acquired: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, retry);
    // lock bts qword [rip + abase+24], 0 → jnc = acquired
    PeirEnc_emit_u8(&mut self.enc, 0xF0);
    PeirEnc_emit_u8(&mut self.enc, 0x48);
    PeirEnc_emit_u8(&mut self.enc, 0x0F);
    PeirEnc_emit_u8(&mut self.enc, 0xBA);
    PeirEnc_emit_u8(&mut self.enc, 0x2D); // mod=00 reg=101 rm=101 → [rip]+/5
    self.enc.pending_rip_refs.push(PeirRipRef_new(self.enc.code.len(), abase + 24));
    PeirEnc_emit_i32(&mut self.enc, 0);
    PeirEnc_emit_u8(&mut self.enc, 0x00); // imm8 = bit 0
    PeirEnc_jcc_label(&mut self.enc, 0x3, acquired); // jnc
    PeirEnc_emit_u8(&mut self.enc, 0xF3); // pause
    PeirEnc_emit_u8(&mut self.enc, 0x90);
    PeirEnc_jmp_label(&mut self.enc, retry);
    PeirEnc_place_label(&mut self.enc, acquired);
}

/// Release the allocator's spinlock.
fn PeirGen_gen_alloc_unlock(self: &mut PeirGen, abase: i64) -> void {
    PeirEnc_emit_u8(&mut self.enc, 0xC6);
    PeirEnc_emit_u8(&mut self.enc, 0x05);
    self.enc.pending_rip_refs.push(PeirRipRef_new(self.enc.code.len(), abase + 24));
    PeirEnc_emit_i32(&mut self.enc, 0);
    PeirEnc_emit_u8(&mut self.enc, 0x00);
}

/// r9 = this thread's free-list array (release H8: a free list per thread,
/// so p_malloc and p_free take no lock; only growing the bump chunk does).
/// The array (64 class heads) is made on a thread's first use and kept in a
/// TLS slot allocated once. Needs rsp 16-aligned; clobbers rax, rcx, rdx,
/// r8–r11. A block freed by another thread joins that thread's lists.
fn PeirGen_gen_my_lists(self: &mut PeirGen, abase: i64) -> void {
    var have: i64 = PeirEnc_alloc_label(&mut self.enc);
    var have_locked: i64 = PeirEnc_alloc_label(&mut self.enc);
    var done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, abase + PEIR_ALLOC_LISTS);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, have); // jnz
    // First use in the process: TlsAlloc, once, under the spinlock
    PeirGen_gen_alloc_lock(self, abase);
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, abase + PEIR_ALLOC_LISTS);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, have_locked); // jnz
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("TlsAlloc")));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    pe_emit2(&mut self.enc, 0x89, 0xC0); // mov eax, eax (zero-extend the DWORD)
    pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC0); // inc rax
    PeirEnc_mov_rip_reg(&mut self.enc, abase + PEIR_ALLOC_LISTS, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, have_locked);
    PeirGen_gen_alloc_unlock(self, abase);
    PeirEnc_place_label(&mut self.enc, have);
    // rax = TlsGetValue(index)
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RCX, abase + PEIR_ALLOC_LISTS);
    pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC9); // dec rcx
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("TlsGetValue")));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, done); // jnz
    // This thread's first block: its zeroed list array, kept in the slot
    PeirGen_gen_process_heap(self, abase);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, 8); // HEAP_ZERO_MEMORY
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, 512);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_HEAP_ALLOC));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RCX, abase + PEIR_ALLOC_LISTS);
    pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC9); // dec rcx
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("TlsSetValue")));
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, 32);
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    PeirEnc_place_label(&mut self.enc, done);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
}

/// r9 = address of the free list of class r13 (clobbers rax).
fn PeirGen_gen_free_list_addr(self: &mut PeirGen, abase: i64) -> void {
    PeirEnc_lea_rip(&mut self.enc, PEIR_R9, abase + PEIR_ALLOC_LISTS);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
}

/// rax = the process heap, cached at abase+16.
fn PeirGen_gen_process_heap(self: &mut PeirGen, abase: i64) -> void {
    var have_heap: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, abase + 16);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, have_heap); // jnz
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_PROCESS_HEAP));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rip_reg(&mut self.enc, abase + 16, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, have_heap);
}

/// p_malloc(rcx = size) -> rax = ptr. Power-of-two blocks up to 1 MB, as in
/// the C runtime: an 8-byte header, reused through free lists, refilled by a
/// thread-safe bump allocator over 4 MB chunks. Larger blocks are HeapAlloc's.
/// Bump fast path: `lock xadd [cur]`, bounds-check — no OS call.
///   An overflowing xadd only wastes tail bytes of a dead chunk; the retry
///   lands on the live chunk.
/// Slow path: under the spinlock, HeapAlloc(max(size, 4 MB)) becomes the new
///   chunk; contenders that arrive after the swap see cur < end and retry.
pub fn PeirGen_gen_malloc(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_malloc");
    PeirEnc_place_label(&mut self.enc, label);

    if self.bare_mode {
        // Bump allocator from g_pe_bare_heap; the cursor is the first word
        // of the allocator state in .rdata. Blocks are 16-byte aligned.
        var have: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, self.alloc_rdata_off);
        PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_jcc_label(&mut self.enc, 0x5, have); // jnz
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, g_pe_bare_heap);
        PeirEnc_place_label(&mut self.enc, have);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xC2, 0x0F); // add rdx, 15
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xE2, 0xF0); // and rdx, -16
        PeirEnc_add_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        PeirEnc_mov_rip_reg(&mut self.enc, self.alloc_rdata_off, PEIR_RDX);
        PeirEnc_ret(&mut self.enc);
    } else if g_pe_checked_alloc {
        PeirGen_gen_checked_malloc(self);
    } else {
        var abase: i64 = self.alloc_rdata_off;
        var fast: i64 = PeirEnc_alloc_label(&mut self.enc);
        var grow: i64 = PeirEnc_alloc_label(&mut self.enc);
        var retry_lock: i64 = PeirEnc_alloc_label(&mut self.enc);
        var acquired: i64 = PeirEnc_alloc_label(&mut self.enc);
        var need_chunk: i64 = PeirEnc_alloc_label(&mut self.enc);
        var have_sz: i64 = PeirEnc_alloc_label(&mut self.enc);
        var oom: i64 = PeirEnc_alloc_label(&mut self.enc);
        var large: i64 = PeirEnc_alloc_label(&mut self.enc);
        var class_ok: i64 = PeirEnc_alloc_label(&mut self.enc);
        var empty: i64 = PeirEnc_alloc_label(&mut self.enc);
        var bumped: i64 = PeirEnc_alloc_label(&mut self.enc);
        var no_memory: i64 = PeirEnc_alloc_label(&mut self.enc);

        PeirEnc_push(&mut self.enc, PEIR_RBP);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
        PeirEnc_push(&mut self.enc, PEIR_R12);
        PeirEnc_push(&mut self.enc, PEIR_R13);

        // r12 = size + header; over 1 MB is a large block
        PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
        pe_emit4(&mut self.enc, 0x49, 0x83, 0xC4, 0x08); // add r12, 8
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 1 << 20);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
        PeirEnc_jcc_label(&mut self.enc, 0x7, large); // ja

        // r13 = size class = max(4, bits(r12 - 1)); r12 = block size
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
        pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC8); // dec rax
        pe_emit4(&mut self.enc, 0x48, 0x0F, 0xBD, 0xC0); // bsr rax, rax
        pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC0); // inc rax
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, 4);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
        PeirEnc_jcc_label(&mut self.enc, 0x3, class_ok); // jae
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
        PeirEnc_place_label(&mut self.enc, class_ok);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R12);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_R12, 1);
        PeirEnc_shl_cl(&mut self.enc, PEIR_R12);
        PeirEnc_add_rr(&mut self.enc, PEIR_R13, PEIR_R13);
        // Three quarters of the block, if that holds it
        var whole: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 1);
        PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
        pe_emit4(&mut self.enc, 0x48, 0xC1, 0xE8, 0x02); // shr rax, 2
        PeirEnc_cmp_rr(&mut self.enc, PEIR_R8, PEIR_RAX);
        PeirEnc_jcc_label(&mut self.enc, 0x7, whole); // ja
        pe_emit4(&mut self.enc, 0x49, 0x83, 0xFD, 0x08); // cmp r13, 8
        PeirEnc_jcc_label(&mut self.enc, 0x4, whole); // je
        PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
        pe_emit3(&mut self.enc, 0x49, 0xFF, 0xCD); // dec r13
        PeirEnc_place_label(&mut self.enc, whole);

        // Pop this class's list of this thread's free blocks: no lock
        // (release H8). rsp is 16-aligned here (three pushes after the call).
        PeirGen_gen_my_lists(self, abase);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R9);
        PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_jcc_label(&mut self.enc, 0x4, fast); // jz
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_R9, PEIR_RDX);
        // Restore the header, zero the payload (as fresh memory is)
        PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, PEIR_BLOCK_MAGIC);
        PeirEnc_or_rr(&mut self.enc, PEIR_R8, PEIR_R13);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, -8, PEIR_R8);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R12);
        pe_emit4(&mut self.enc, 0x49, 0x83, 0xE8, 0x08); // sub r8, 8
        PeirEnc_sub_rsp_i32(&mut self.enc, 32);
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("memset")));
        PeirEnc_add_rsp_i32(&mut self.enc, 32);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
        PeirEnc_pop(&mut self.enc, PEIR_R13);
        PeirEnc_pop(&mut self.enc, PEIR_R12);
        PeirEnc_pop(&mut self.enc, PEIR_RBP);
        PeirEnc_ret(&mut self.enc);

        // A large block: zeroed by the system heap
        PeirEnc_place_label(&mut self.enc, large);
        PeirGen_gen_process_heap(self, abase);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, 8); // HEAP_ZERO_MEMORY
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R12);
        PeirEnc_sub_rsp_i32(&mut self.enc, 32);
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_HEAP_ALLOC));
        PeirEnc_add_rsp_i32(&mut self.enc, 32);
        PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_jcc_label(&mut self.enc, 0x4, no_memory); // jz
        PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, PEIR_BLOCK_MAGIC | PEIR_CLASS_LARGE);
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R8);
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xC0, 0x08); // add rax, 8
        PeirEnc_place_label(&mut self.enc, no_memory);
        PeirEnc_pop(&mut self.enc, PEIR_R13);
        PeirEnc_pop(&mut self.enc, PEIR_R12);
        PeirEnc_pop(&mut self.enc, PEIR_RBP);
        PeirEnc_ret(&mut self.enc);

        PeirEnc_place_label(&mut self.enc, empty);

        // --- Fast path: r8 = lock xadd [cur], r12 — atomic bump ---
        PeirEnc_place_label(&mut self.enc, fast);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R12);
        // lock xadd [rip + abase], r8  (F0 REX.W 0F C1 /r)
        PeirEnc_emit_u8(&mut self.enc, 0xF0);
        PeirEnc_rex(&mut self.enc, true, reg_ext(PEIR_R8), false, false);
        PeirEnc_emit_u8(&mut self.enc, 0x0F);
        PeirEnc_emit_u8(&mut self.enc, 0xC1);
        PeirEnc_modrm(&mut self.enc, 0, peir_reg_code(PEIR_R8), 5);
        self.enc.pending_rip_refs.push(PeirRipRef_new(self.enc.code.len(), abase));
        PeirEnc_emit_i32(&mut self.enc, 0);
        // r9 = r8 + r12 (end of our span); overflow if > [end] or r8 == 0
        PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_R8);
        PeirEnc_add_rr(&mut self.enc, PEIR_R9, PEIR_R12);
        PeirEnc_test_rr(&mut self.enc, PEIR_R8, PEIR_R8);
        PeirEnc_jcc_label(&mut self.enc, 0x4, grow); // jz: uninitialised
        PeirEnc_mov_reg_rip(&mut self.enc, PEIR_R10, abase + 8);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_R9, PEIR_R10);
        PeirEnc_jcc_label(&mut self.enc, 0x7, grow); // ja: chunk full
        PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R8);

        // A new block at rax: write its header
        PeirEnc_place_label(&mut self.enc, bumped);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, PEIR_BLOCK_MAGIC);
        PeirEnc_or_rr(&mut self.enc, PEIR_R8, PEIR_R13);
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R8);
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xC0, 0x08); // add rax, 8
        PeirEnc_pop(&mut self.enc, PEIR_R13);
        PeirEnc_pop(&mut self.enc, PEIR_R12);
        PeirEnc_pop(&mut self.enc, PEIR_RBP);
        PeirEnc_ret(&mut self.enc);

        // --- Slow path: grow under spinlock ---
        PeirEnc_place_label(&mut self.enc, grow);
        // acquire: lock bts qword [rip + abase+24], 0 → jnc = acquired
        PeirEnc_place_label(&mut self.enc, retry_lock);
        PeirEnc_emit_u8(&mut self.enc, 0xF0);
        PeirEnc_emit_u8(&mut self.enc, 0x48);
        PeirEnc_emit_u8(&mut self.enc, 0x0F);
        PeirEnc_emit_u8(&mut self.enc, 0xBA);
        PeirEnc_emit_u8(&mut self.enc, 0x2D); // mod=00 reg=101 rm=101 → [rip]+/5
        self.enc.pending_rip_refs.push(PeirRipRef_new(self.enc.code.len(), abase + 24));
        PeirEnc_emit_i32(&mut self.enc, 0);
        PeirEnc_emit_u8(&mut self.enc, 0x00); // imm8 = bit 0
        PeirEnc_jcc_label(&mut self.enc, 0x3, acquired); // jnc
        PeirEnc_emit_u8(&mut self.enc, 0xF3); // pause
        PeirEnc_emit_u8(&mut self.enc, 0x90);
        PeirEnc_jmp_label(&mut self.enc, retry_lock);
        PeirEnc_place_label(&mut self.enc, acquired);

        // Under the lock: cur < end → another thread already grew → release
        // the lock and retry the fast path on the live chunk.
        PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RAX, abase);
        PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_jcc_label(&mut self.enc, 0x4, need_chunk); // jz: first alloc
        PeirEnc_mov_reg_rip(&mut self.enc, PEIR_R9, abase + 8);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R9);
        PeirEnc_jcc_label(&mut self.enc, 0x3, need_chunk); // jae: dead chunk
        // release lock: mov byte [rip + abase+24], 0
        PeirEnc_emit_u8(&mut self.enc, 0xC6);
        PeirEnc_emit_u8(&mut self.enc, 0x05); // mod=00 reg=0 rm=101 → [rip]
        self.enc.pending_rip_refs.push(PeirRipRef_new(self.enc.code.len(), abase + 24));
        PeirEnc_emit_i32(&mut self.enc, 0);
        PeirEnc_emit_u8(&mut self.enc, 0x00);
        PeirEnc_jmp_label(&mut self.enc, fast);

        // need_chunk: r13 = chunk size = max(r12, 4 MB)
        PeirEnc_place_label(&mut self.enc, need_chunk);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 4194304);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_R13, PEIR_RAX);
        PeirEnc_jcc_label(&mut self.enc, 0x3, have_sz); // jae
        PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);
        PeirEnc_place_label(&mut self.enc, have_sz);

        PeirGen_gen_process_heap(self, abase);

        // rax = HeapAlloc(heap, 0, r13)
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R13);
        PeirEnc_sub_rsp_i32(&mut self.enc, 32);
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_HEAP_ALLOC));
        PeirEnc_add_rsp_i32(&mut self.enc, 32);
        PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_jcc_label(&mut self.enc, 0x4, oom); // jz: NULL
        // end = base + r13; cur = base + r12; rax = base is the result
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RAX);
        PeirEnc_add_rr(&mut self.enc, PEIR_R8, PEIR_R13);
        PeirEnc_mov_rip_reg(&mut self.enc, abase + 8, PEIR_R8);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RAX);
        PeirEnc_add_rr(&mut self.enc, PEIR_R8, PEIR_R12);
        PeirEnc_mov_rip_reg(&mut self.enc, abase, PEIR_R8);
        // release lock
        PeirEnc_emit_u8(&mut self.enc, 0xC6);
        PeirEnc_emit_u8(&mut self.enc, 0x05);
        self.enc.pending_rip_refs.push(PeirRipRef_new(self.enc.code.len(), abase + 24));
        PeirEnc_emit_i32(&mut self.enc, 0);
        PeirEnc_emit_u8(&mut self.enc, 0x00);
        // r13 held the chunk size: the class again, from the block size
        var whole2: i64 = PeirEnc_alloc_label(&mut self.enc);
        pe_emit4(&mut self.enc, 0x4D, 0x0F, 0xBD, 0xEC); // bsr r13, r12
        PeirEnc_add_rr(&mut self.enc, PEIR_R13, PEIR_R13);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
        pe_emit3(&mut self.enc, 0x48, 0xFF, 0xCA); // dec rdx
        PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
        PeirEnc_jcc_label(&mut self.enc, 0x4, whole2); // jz: a power of two
        pe_emit3(&mut self.enc, 0x49, 0xFF, 0xC5); // inc r13
        PeirEnc_place_label(&mut self.enc, whole2);
        PeirEnc_jmp_label(&mut self.enc, bumped);

        // oom: release lock, return NULL (caller crashes on use, as before)
        PeirEnc_place_label(&mut self.enc, oom);
        PeirEnc_emit_u8(&mut self.enc, 0xC6);
        PeirEnc_emit_u8(&mut self.enc, 0x05);
        self.enc.pending_rip_refs.push(PeirRipRef_new(self.enc.code.len(), abase + 24));
        PeirEnc_emit_i32(&mut self.enc, 0);
        PeirEnc_emit_u8(&mut self.enc, 0x00);
        PeirEnc_pop(&mut self.enc, PEIR_R13);
        PeirEnc_pop(&mut self.enc, PEIR_R12);
        PeirEnc_pop(&mut self.enc, PEIR_RBP);
        PeirEnc_ret(&mut self.enc);
    }
}

/// p_free(rcx = ptr): back on its class's free list, or to the system heap
/// when large. Panics unless it is a live block.
pub fn PeirGen_gen_free(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_free");
    PeirEnc_place_label(&mut self.enc, label);

    if self.bare_mode {
        // The bump allocator never reuses memory
        PeirEnc_ret(&mut self.enc);
    } else {
        var abase: i64 = self.alloc_rdata_off;
        var out: i64 = PeirEnc_alloc_label(&mut self.enc);
        var large: i64 = PeirEnc_alloc_label(&mut self.enc);
        var live: i64 = PeirEnc_alloc_label(&mut self.enc);
        var twice: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirEnc_jcc_label(&mut self.enc, 0x4, out); // jz
        // rax = header, rdx = its magic
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, -8);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        pe_emit2(&mut self.enc, 0x30, 0xD2); // xor dl, dl
        PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, PEIR_BLOCK_MAGIC);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RDX, PEIR_R8);
        PeirEnc_jcc_label(&mut self.enc, 0x4, live); // je
        PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, PEIR_BLOCK_FREED);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RDX, PEIR_R8);
        PeirEnc_jcc_label(&mut self.enc, 0x4, twice); // je
        // The panic stubs expect a function body's aligned stack
        PeirEnc_sub_rsp_i32(&mut self.enc, 8);
        PeirEnc_jmp_label(&mut self.enc, self.arith_panics.get(PEIR_PANIC_BAD_FREE));
        PeirEnc_place_label(&mut self.enc, twice);
        PeirEnc_sub_rsp_i32(&mut self.enc, 8);
        PeirEnc_jmp_label(&mut self.enc, self.arith_panics.get(PEIR_PANIC_DOUBLE_FREE));
        PeirEnc_place_label(&mut self.enc, live);
        PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, PEIR_BLOCK_FREED);
        PeirEnc_or_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, -8, PEIR_RDX);
        var checked_free: i64 = PeirEnc_alloc_label(&mut self.enc);
        if g_pe_checked_alloc {
            PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, PEIR_CLASS_CHECKED);
            PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
            PeirEnc_jcc_label(&mut self.enc, 0x4, checked_free); // je
        }
        PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, PEIR_CLASS_LARGE);
        PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
        PeirEnc_jcc_label(&mut self.enc, 0x4, large); // je
        // Push on this thread's list of the class: no lock (release H8).
        // rcx (the block) and rax (its class) survive the lookup on the
        // stack; entry rsp is 8 mod 16, so two pushes and 8 align it.
        PeirEnc_push(&mut self.enc, PEIR_RCX);
        PeirEnc_push(&mut self.enc, PEIR_RAX);
        PeirEnc_sub_rsp_i32(&mut self.enc, 8);
        PeirGen_gen_my_lists(self, abase);
        PeirEnc_add_rsp_i32(&mut self.enc, 8);
        PeirEnc_pop(&mut self.enc, PEIR_RAX);
        PeirEnc_pop(&mut self.enc, PEIR_RCX);
        PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
        PeirEnc_add_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
        PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_R9);
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RCX, PEIR_RDX);
        PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_R9, PEIR_RCX);
        PeirEnc_place_label(&mut self.enc, out);
        PeirEnc_ret(&mut self.enc);

        // --checked-alloc: the block's pages become inaccessible, for good
        if g_pe_checked_alloc {
            PeirEnc_place_label(&mut self.enc, checked_free);
            PeirEnc_sub_rsp_i32(&mut self.enc, 56);
            PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_RCX, -16);
            PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_RCX, -24);
            PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, 1); // PAGE_NOACCESS
            PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RSP);
            pe_emit4(&mut self.enc, 0x49, 0x83, 0xC1, 0x28); // add r9, 40
            PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("VirtualProtect")));
            PeirEnc_add_rsp_i32(&mut self.enc, 56);
            PeirEnc_ret(&mut self.enc);
        }

        // A large block goes back to the system heap
        PeirEnc_place_label(&mut self.enc, large);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RCX);
        pe_emit4(&mut self.enc, 0x49, 0x83, 0xE8, 0x08); // sub r8, 8
        PeirEnc_mov_reg_rip(&mut self.enc, PEIR_RCX, abase + 16);
        PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
        PeirEnc_sub_rsp_i32(&mut self.enc, 40);
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_HEAP_FREE));
        PeirEnc_add_rsp_i32(&mut self.enc, 40);
        PeirEnc_ret(&mut self.enc);
    }
}

/// p_memset(rcx=ptr, rdx=val, r8=size) — fill memory with val for size bytes
pub fn PeirGen_gen_memset(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_memset");
    PeirEnc_place_label(&mut self.enc, label);
    // rcx = ptr, rdx = val (byte), r8 = size
    // Simple byte-by-byte loop: while r8 > 0 { *rcx = dl; rcx++; r8-- }
    var loop_start: i64 = PeirEnc_alloc_label(&mut self.enc);
    var loop_end: i64 = PeirEnc_alloc_label(&mut self.enc);
    // if size <= 0, skip
    PeirEnc_test_rr(&mut self.enc, PEIR_R8, PEIR_R8);
    PeirEnc_jcc_label(&mut self.enc, 0x4, loop_end); // jz → end
    PeirEnc_place_label(&mut self.enc, loop_start);
    // Store byte: mov byte [rcx], dl
    pe_emit2(&mut self.enc, 0x88, 0x11); // mov [rcx], dl
    // rcx++
    pe_emit3(&mut self.enc, 0x48, 0xFF, 0xC1); // inc rcx
    // r8-- (REX.B selects r8)
    pe_emit3(&mut self.enc, 0x49, 0xFF, 0xC8); // dec r8
    // if r8 != 0, loop
    PeirEnc_test_rr(&mut self.enc, PEIR_R8, PEIR_R8);
    PeirEnc_jcc_label(&mut self.enc, 0x5, loop_start); // jnz → loop_start
    PeirEnc_place_label(&mut self.enc, loop_end);
    PeirEnc_ret(&mut self.enc);
}

/// p_str_concat(rcx=left *u8, rdx=right *u8) -> rax=*u8
/// Each length is counted once by msvcrt strlen and both halves copy in bulk
/// via memcpy - not byte-by-byte loops (pe-roadmap item 73).
/// rax = the length of the string at rcx: its header's (a length-headered
/// string or literal, release D16), else strlen through the import table.
/// Uses rax, r10 (and what strlen uses).
fn PeirGen_emit_slen(self: &mut PeirGen, strlen_off: i64) -> void {
    var zero: i64 = PeirEnc_alloc_label(&mut self.enc);
    var check: i64 = PeirEnc_alloc_label(&mut self.enc);
    var plain: i64 = PeirEnc_alloc_label(&mut self.enc);
    var done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, zero);                 // jz
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, -16);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, 0x4649444553545201);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_jcc_label(&mut self.enc, 0x4, check);                // je
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, 0x4649444553545202);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_jcc_label(&mut self.enc, 0x4, check);                // je
    // A counted string (proposal 0004): P_STR_RC + count, count < 2^30
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, 0x4649444500000000);
    PeirEnc_sub_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, 0x40000000);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_jcc_label(&mut self.enc, 0x3, plain);                // jae (unsigned)
    PeirEnc_place_label(&mut self.enc, check);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, -8);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x8, plain);                // js
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R10, 0x10000000000);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_jcc_label(&mut self.enc, 0x2, done);                 // jb: a length
    PeirEnc_place_label(&mut self.enc, plain);
    PeirEnc_call_rip(&mut self.enc, strlen_off);
    PeirEnc_jmp_label(&mut self.enc, done);
    PeirEnc_place_label(&mut self.enc, zero);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, done);
}

pub fn PeirGen_gen_str_concat(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_str_concat");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_push(&mut self.enc, PEIR_R15);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48); // 32 shadow + 16 locals

    // r12 = left, r13 = right
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);

    var strlen_off: i64 = PeirGen_iat_off(self, pe_import_slot("strlen"));
    var memcpy_off: i64 = PeirGen_iat_off(self, pe_import_slot("memcpy"));

    // r14 = len(left); [rbp-48] = len(right): the header's length, so
    // zero bytes survive (D16), else strlen
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirGen_emit_slen(self, strlen_off);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirGen_emit_slen(self, strlen_off);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);

    // block = p_malloc(16 + len_l + len_r + 1): a length header, as core's
    // p_str_alloc writes it (release D16: [magic][len], then the bytes and
    // the terminator), so p_str_length is O(1) on the result and Str_drop
    // frees the whole block
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RCX, 17);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // [block] = a count of one owner (core's P_STR_RC + 1, proposal 0004)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, 0x4649444500000001);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 0, PEIR_R9);
    // [block + 8] = len_l + len_r
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R10, -48);
    PeirEnc_add_rr(&mut self.enc, PEIR_R10, PEIR_R14);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 8, PEIR_R10);
    // r15 = buf = block + 16
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_R15, 16);

    // memcpy(buf, left, len_l)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R14);
    PeirEnc_call_rip(&mut self.enc, memcpy_off);

    // memcpy(buf + len_l, right, len_r + 1) - +1 copies right's NUL,
    // so the result is exactly "left" + "right" + NUL.
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R8, -48);
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_call_rip(&mut self.enc, memcpy_off);

    // Return buf
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R15);

    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    PeirEnc_pop(&mut self.enc, PEIR_R15);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_to_str(rcx = i64 value) -> rax = *u8
/// Converts integer to null-terminated string, malloc'd
pub fn PeirGen_gen_to_str(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_to_str");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 56); // 32 shadow + 16 buf + 8 align

    // r12 = value, r13 = buffer ptr (stack at rbp-40), r14 = digit count
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R13, -40); // 20-byte buffer on stack
    PeirEnc_xor_self(&mut self.enc, PEIR_R14);

    // Handle 0 specially
    PeirEnc_test_rr(&mut self.enc, PEIR_R12, PEIR_R12);
    var ts_notzero: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, ts_notzero); // jnz

    // value == 0: store '0' + null
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48); // '0'
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13); // point back to '0'
    // malloc(2), copy, return
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 2);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // rax = dest. Copy 2 bytes from r13
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_inc_r(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_dec_r(&mut self.enc, PEIR_RAX);
    var ts_zero_ret: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, ts_zero_ret);

    PeirEnc_place_label(&mut self.enc, ts_notzero);

    // Handle negative: if value < 0, negate and set sign flag
    PeirEnc_xor_self(&mut self.enc, PEIR_R8); // r8 = sign flag
    PeirEnc_test_rr(&mut self.enc, PEIR_R12, PEIR_R12);
    var ts_pos: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x9, ts_pos); // jns — positive
    // Negative: negate using xor rax,rax; sub rax,r12; mov r12,rax
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_sub_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 1); // sign = 1

    PeirEnc_place_label(&mut self.enc, ts_pos);

    // Extract digits in reverse
    PeirEnc_xor_self(&mut self.enc, PEIR_R14); // reset count
    var ts_loop2: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, ts_loop2);
    // rax = r12, divide by 10
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 10);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_div_rr(&mut self.enc, PEIR_RCX); // rax = r12/10, rdx = r12%10
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX); // r12 = quotient
    // Store digit
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RDX, 48); // '0'
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R14);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    // Loop while r12 != 0
    PeirEnc_test_rr(&mut self.enc, PEIR_R12, PEIR_R12);
    PeirEnc_jcc_label(&mut self.enc, 0x5, ts_loop2); // jnz

    // Add sign if needed
    PeirEnc_test_rr(&mut self.enc, PEIR_R8, PEIR_R8);
    var ts_nosign: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, ts_nosign); // jz — no sign
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 45); // '-'
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_place_label(&mut self.enc, ts_nosign);

    // Reverse the buffer (r14 digits in reverse order)
    // r12 = 0 (left index), r8 = r14-1 (right index)
    PeirEnc_xor_self(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R14);
    PeirEnc_dec_r(&mut self.enc, PEIR_R8);
    var ts_rev: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, ts_rev);
    // if r12 >= r8, done
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R12, PEIR_R8);
    var ts_revdone: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, ts_revdone); // jae — done
    // swap bytes at r13+r12 and r13+r8
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RCX, PEIR_RAX); // cl = left byte
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RDX, PEIR_RAX); // dl = right byte
    // Store swapped
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // inc r12, dec r8
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R8);
    PeirEnc_jmp_label(&mut self.enc, ts_rev);
    PeirEnc_place_label(&mut self.enc, ts_revdone);

    // Add null terminator at r13+r14
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R14);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 0);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R14); // include null in length

    // malloc(r14), copy, return
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX); // dest
    PeirEnc_xor_self(&mut self.enc, PEIR_R8);
    var ts_cp2: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, ts_cp2);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R8, PEIR_R14);
    var ts_cp2d: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, ts_cp2d);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_jmp_label(&mut self.enc, ts_cp2);
    PeirEnc_place_label(&mut self.enc, ts_cp2d);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12); // return dest

    PeirEnc_place_label(&mut self.enc, ts_zero_ret);

    PeirEnc_add_rsp_i32(&mut self.enc, 56);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_to_str_str(rcx = *u8 str) -> rax = *u8
/// For strings, to_str just returns the input pointer (it's already a string)
pub fn PeirGen_gen_to_str_str(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_to_str_str");
    PeirEnc_place_label(&mut self.enc, label);
    // Just return rcx (the string pointer)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_ret(&mut self.enc);
}

/// p_to_str_bool(rcx = i64 bool) -> rax = *u8
pub fn PeirGen_gen_to_str_bool(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_to_str_bool");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);

    // if rcx == 0, return "false", else "true"
    PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    var tb_false: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tb_false); // jz

    // "true" — 5 bytes incl null
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 5);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // Store "true\0"
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 116); // 't'
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 114); // 'r'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 1, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 117); // 'u'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 2, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 101); // 'e'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 3, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 0);
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 4, PEIR_RCX);
    var tb_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, tb_done);

    PeirEnc_place_label(&mut self.enc, tb_false);
    // "false" — 6 bytes incl null
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 6);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 102); // 'f'
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 97); // 'a'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 1, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 108); // 'l'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 2, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 115); // 's'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 3, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 101); // 'e'
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 4, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 0);
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 5, PEIR_RCX);

    PeirEnc_place_label(&mut self.enc, tb_done);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_to_str_float(rcx = f64 bits in i64 reg) -> rax = *u8
/// Simplified: convert to integer string (truncate decimal for now)
pub fn PeirGen_gen_to_str_float(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_to_str_float");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 280); // 32 shadow + 248 for locals

    // Stack layout (same as p_print_float minus WriteFile stuff):
    // [rbp-8]   = double value (input bits)
    // [rbp-16]  = 10.0 constant
    // [rbp-24]  = sign mask (0x8000000000000000)
    // [rbp-32]  = magnitude mask (0x7FFFFFFFFFFFFFFF)
    // [rbp-40]  = integer part (saved)
    // [rbp-48]  = is_negative flag
    // [rbp-56]  = fractional part (saved)
    // [rbp-64]  = 0.0 constant
    // [rbp-72]  = int_start pointer (saved)
    // [rbp-88]  = 0.5 constant
    // [rbp-280 .. rbp-89] = character buffer (192 bytes)

    // Store double bits
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -8, PEIR_RCX);

    // Store 10.0 constant (0x4024000000000000)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x4024000000000000);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);

    // Store sign mask (0x8000000000000000 = 1 << 63)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 1 << 63);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -24, PEIR_RAX);

    // Store magnitude mask
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x7FFFFFFFFFFFFFFF);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -32, PEIR_RAX);

    // Store 0.0 constant
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -64, PEIR_RAX);

    // Store 0.5 constant (0x3FE0000000000000)
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RAX, 0x3FE0000000000000);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -88, PEIR_RAX);

    // Load xmm0 = double value
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, -8);

    // Check for zero: AND bits with magnitude mask
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -8);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, -32);
    PeirEnc_and_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var tsf_not_zero: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_not_zero); // jnz

    // Zero: write "0" directly
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R12, -280);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48); // '0'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12); // r12 points past the '0'
    var tsf_alloc: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, tsf_alloc);

    PeirEnc_place_label(&mut self.enc, tsf_not_zero);

    // Check sign: test bits with sign mask
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -8);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, -24);
    PeirEnc_and_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var tsf_positive: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tsf_positive); // jz

    // Negative: set flag, negate value
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -24);
    PeirEnc_movq_xmm_r64(&mut self.enc, 1, PEIR_RAX);
    PeirEnc_xorpd_xmm_xmm(&mut self.enc, 0, 1);
    PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, -8, 0);
    var tsf_after_sign: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, tsf_after_sign);

    PeirEnc_place_label(&mut self.enc, tsf_positive);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);

    PeirEnc_place_label(&mut self.enc, tsf_after_sign);

    // Extract integer part: cvttsd2si rax, xmm0
    PeirEnc_cvttsd2si_r64(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -40, PEIR_RAX);
    PeirEnc_cvtsi2sd_r64(&mut self.enc, 1, PEIR_RAX);
    PeirEnc_subsd(&mut self.enc, 0, 1);
    PeirEnc_movsd_mem_rbp_xmm(&mut self.enc, -56, 0);

    // r12 = buffer start = [rbp-280], build string FORWARD
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R12, -280);

    // If negative, store '-'
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -48);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var tsf_no_minus: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tsf_no_minus);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 45); // '-'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_place_label(&mut self.enc, tsf_no_minus);

    // Save int_start = r12
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -72, PEIR_R12);

    // Build integer digits forward (LSD first, will reverse later)
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -40);
    var tsf_int_nonzero: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_int_nonzero);

    // Integer part is 0: store '0'
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48); // '0'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    var tsf_int_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, tsf_int_done);

    PeirEnc_place_label(&mut self.enc, tsf_int_nonzero);
    var tsf_int_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tsf_int_loop);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 10);
    PeirEnc_rex(&mut self.enc, true, false, false, reg_ext(PEIR_R9));
    PeirEnc_emit_u8(&mut self.enc, 0xF7);
    PeirEnc_modrm(&mut self.enc, 3, 6, peir_reg_code(PEIR_R9));
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RDX, 48);
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RDX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_int_loop);

    PeirEnc_place_label(&mut self.enc, tsf_int_done);
    // Reverse integer digits in-place: int_start to r12-1
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R13, -72);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R14);
    var tsf_rev_check: i64 = PeirEnc_alloc_label(&mut self.enc);
    var tsf_rev_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tsf_rev_check);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R13, PEIR_R14);
    PeirEnc_jcc_label(&mut self.enc, 0x3, tsf_rev_done);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R10, PEIR_R14);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_R10);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R14, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_dec_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, tsf_rev_check);

    PeirEnc_place_label(&mut self.enc, tsf_rev_done);

    // Now add '.' if there are fractional digits
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 0, -56);
    PeirEnc_xorpd_xmm_xmm(&mut self.enc, 1, 1);
    PeirEnc_ucomisd(&mut self.enc, 0, 1);
    var tsf_no_frac: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tsf_no_frac);

    // Store '.'
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 46); // '.'
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);

    // Fractional digit loop (up to 6 digits), forward
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R14, 6);
    var tsf_frac_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tsf_frac_loop);
    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 1, -16);
    PeirEnc_mulsd(&mut self.enc, 0, 1);
    PeirEnc_cvttsd2si_r64(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_cvtsi2sd_r64(&mut self.enc, 1, PEIR_RAX);
    PeirEnc_subsd(&mut self.enc, 0, 1);
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RAX, 48);
    PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_xorpd_xmm_xmm(&mut self.enc, 1, 1);
    PeirEnc_ucomisd(&mut self.enc, 0, 1);
    var tsf_frac_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tsf_frac_done);
    PeirEnc_dec_r(&mut self.enc, PEIR_R14);
    var tsf_frac_continue: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_frac_continue);
    PeirEnc_jmp_label(&mut self.enc, tsf_frac_done);
    PeirEnc_place_label(&mut self.enc, tsf_frac_continue);
    PeirEnc_jmp_label(&mut self.enc, tsf_frac_loop);

    PeirEnc_place_label(&mut self.enc, tsf_frac_done);

    // Rounding: only if we generated 6 digits (r14 == 0) and frac >= 0.5
    PeirEnc_test_rr(&mut self.enc, PEIR_R14, PEIR_R14);
    var tsf_strip: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_strip);

    PeirEnc_movsd_xmm_mem_rbp(&mut self.enc, 1, -88);
    PeirEnc_ucomisd(&mut self.enc, 0, 1);
    PeirEnc_jcc_label(&mut self.enc, 0x2, tsf_strip);

    // Rounding: increment last fractional digit at [r12-1]
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    var tsf_round_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tsf_round_loop);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_r_i8(&mut self.enc, PEIR_RAX, 1);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 58); // '9' + 1
    var tsf_round_store: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_round_store);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 48);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 46); // '.'
    var tsf_round_skip_dot: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_round_skip_dot);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    PeirEnc_place_label(&mut self.enc, tsf_round_skip_dot);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 45); // '-'
    var tsf_round_stop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tsf_round_stop);
    PeirEnc_jmp_label(&mut self.enc, tsf_round_loop);

    PeirEnc_place_label(&mut self.enc, tsf_round_store);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_jmp_label(&mut self.enc, tsf_strip);

    PeirEnc_place_label(&mut self.enc, tsf_round_stop);

    PeirEnc_place_label(&mut self.enc, tsf_strip);
    // Strip trailing zeros from fractional part
    var tsf_strip_check: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tsf_strip_check);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 48); // '0'
    var tsf_strip_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_strip_done);
    PeirEnc_dec_r(&mut self.enc, PEIR_R12);
    PeirEnc_jmp_label(&mut self.enc, tsf_strip_check);

    PeirEnc_place_label(&mut self.enc, tsf_strip_done);
    // Check if last char is '.' — remove it
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    PeirEnc_dec_r(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RAX, 46); // '.'
    var tsf_no_strip_dot: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, tsf_no_strip_dot);
    PeirEnc_dec_r(&mut self.enc, PEIR_R12);
    PeirEnc_place_label(&mut self.enc, tsf_no_strip_dot);

    PeirEnc_place_label(&mut self.enc, tsf_no_frac);

    // r12 now points past the last char. Buffer start = [rbp-280].
    // Null-terminate at [r12]
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R12, PEIR_RAX);

    PeirEnc_place_label(&mut self.enc, tsf_alloc);
    // Calculate length: r13 = r12 - buffer_start + 1 (for null)
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R13, -280);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_sub_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX); // +1 for null terminator
    // p_malloc(length)
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // Save malloc result to [rbp-72] (int_start no longer needed)
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -72, PEIR_RAX);
    // r14 = dest
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_RAX);

    // Copy buffer to dest: r13 = src, r14 = dest
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R13, -280);
    var tsf_copy_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tsf_copy_loop);
    // Check if we've reached r12
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R13, PEIR_R12);
    var tsf_copy_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, tsf_copy_done); // jae — done
    // Copy byte
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R14, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, tsf_copy_loop);

    PeirEnc_place_label(&mut self.enc, tsf_copy_done);
    // Null-terminate dest
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R14, PEIR_RAX);
    // Return malloc result from [rbp-72]
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -72);

    // Epilogue
    PeirEnc_add_rsp_i32(&mut self.enc, 280);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_to_str_vec(rcx = *Vec) -> rax = *u8
/// Formats vec as "[1, 2, 3]"
/// At the entry of p_to_str_vec / p_print_vec (rcx = the Vec): a Vec whose
/// elements are stored at their size (D14, element code at +24) is turned
/// into text by core's Vec_to_str (and printed); a word Vec falls through.
fn PeirGen_sized_vec_to_core(self: &mut PeirGen, print: bool) -> void {
    if !HashMap_contains(self.func_labels, "Vec_to_str") { return; }
    var words: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, words);                 // jz
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 24);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, words);                 // jz: a word Vec
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);                       // realign, shadow space
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "Vec_to_str"));
    if print {
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_str"));
        PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    }
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, words);
}

pub fn PeirGen_gen_to_str_vec(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_to_str_vec");
    PeirEnc_place_label(&mut self.enc, label);
    PeirGen_sized_vec_to_core(self, false);

    // Prologue: push rbp + 4 callee-saved = 5 pushes = 40 bytes
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12); // vec ptr
    PeirEnc_push(&mut self.enc, PEIR_R13); // element index
    PeirEnc_push(&mut self.enc, PEIR_R14); // len
    PeirEnc_push(&mut self.enc, PEIR_R15); // result string
    PeirEnc_sub_rsp_i32(&mut self.enc, 40); // 32 shadow + 8 align

    // r12 = vec ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);

    // Start with "[" — malloc 2 bytes, store '[', '\0'
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 2);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX); // r15 = result
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 91); // '['
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R15, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 0);
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_R15, 1, PEIR_RCX);

    // r13 = 0 (index), r14 = len = [r12 + 8]
    PeirEnc_xor_self(&mut self.enc, PEIR_R13);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R14, PEIR_R12, 8);

    // Loop: for each element
    var tv_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, tv_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R13, PEIR_R14);
    var tv_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, tv_done); // jae — done

    // If index > 0, append ", "
    PeirEnc_test_rr(&mut self.enc, PEIR_R13, PEIR_R13);
    var tv_first: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tv_first); // jz — first element
    // Build ", \0" on stack at [rbp-16]
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 44); // ','
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 32); // ' '
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -15, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -14, PEIR_RAX);
    // r15 = p_str_concat(r15, &[rbp-16])
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -16);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, tv_first);

    // Get element: buf = [r12], element = buf[r13*8]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12); // rax = buf ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX); // rcx = element

    // Call p_to_str(element) -> rax = string
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_to_str"));

    // Append to result: r15 = p_str_concat(r15, rax)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);

    // inc r13, loop
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_jmp_label(&mut self.enc, tv_loop);

    PeirEnc_place_label(&mut self.enc, tv_done);
    // Append "]" — build "]\0" on stack at [rbp-16]
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 93); // ']'
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -15, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -16);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    // rax = result

    // Epilogue
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R15);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// Vec runtime stubs — Vec layout: { ptr: *u8, len: i64, cap: i64 } = 24 bytes
// ===========================================================================

/// p_vec_new() -> rax = *Vec (32-byte heap struct, all zeros)
pub fn PeirGen_gen_vec_new(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_new");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);

    // malloc(32) — shadow space already in the 48 bytes
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));

    // Zero out 32 bytes: data, len, cap, element code (D14: 0, a word)
    PeirEnc_xor_self(&mut self.enc, PEIR_RCX);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 8, PEIR_RCX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 16, PEIR_RCX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 24, PEIR_RCX);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_push(rcx=*Vec, rdx=i64 value)
pub fn PeirGen_gen_vec_push(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_push");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);

    // Save args: r12 = vec ptr (rcx), r13 = value (rdx)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);

    // Read len = [r12 + 8], cap = [r12 + 16]
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R14, PEIR_R12, 8);  // r14 = len
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 16); // rax = cap

    // if len < cap, skip grow
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R14, PEIR_RAX);
    var vp_nogrow: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x2, vp_nogrow); // jb — len < cap

    // Need to grow: new_cap = cap == 0 ? 4 : cap * 2
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var vp_newcap: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, vp_newcap); // jnz — cap != 0
    // cap == 0: new_cap = 4
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 4);
    var vp_alloc: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, vp_alloc);

    PeirEnc_place_label(&mut self.enc, vp_newcap);
    // cap != 0: newcap = cap * 2
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 1);

    PeirEnc_place_label(&mut self.enc, vp_alloc);
    // Save new_cap at [rbp-16] (RAX is volatile, clobbered by p_malloc)
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);
    // malloc(new_cap * 8)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 3);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // Save new buffer at [rbp-24] (RAX is volatile)
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -24, PEIR_RAX);

    // Copy old data: old_ptr = [r12], copy len elements
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R10, PEIR_R12); // r10 = old ptr
    PeirEnc_xor_self(&mut self.enc, PEIR_R11); // r11 = 0 (index)
    var vp_copy: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, vp_copy);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R11, PEIR_R14);
    var vp_copydone: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, vp_copydone); // jae — done
    // load old[i]: rax = r11 * 8; rax += r10; rcx = [rax]
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R11);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    // store to new[i]: rax = r11 * 8; rax += new_buf; [rax] = rcx
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R9, -24);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R11);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R9);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R11);
    PeirEnc_jmp_label(&mut self.enc, vp_copy);
    PeirEnc_place_label(&mut self.enc, vp_copydone);

    // Free old buffer if non-null
    PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    var vp_nofree: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, vp_nofree); // jz — null, skip free
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R10);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_free"));
    PeirEnc_place_label(&mut self.enc, vp_nofree);

    // Update vec.ptr = new_buf, vec.cap = new_cap
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -24);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_R12, PEIR_RAX);       // [r12] = new_buf
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -16);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 16, PEIR_RAX); // [r12+16]

    PeirEnc_place_label(&mut self.enc, vp_nogrow);
    // r14 is still valid — only ptr and cap were updated.

    // Store value at ptr[len]: rax = [r12]; rax += len*8; [rax] = r13
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R13);

    // len++
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 8, PEIR_R14);

    // Epilogue
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_len(rcx=*Vec) -> rax = i64
pub fn PeirGen_gen_vec_len(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_len");
    PeirEnc_place_label(&mut self.enc, label);

    // rax = [rcx + 8] = len
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_get(rcx=*Vec, rdx=i64 index) -> rax = i64
///
/// The lowerer emits this builtin for `v[i]` (compiler/lower.fd), and the
/// interpreter's version panics on out-of-bounds — so unlike the Rust stub
/// (dead code there; its lowerer emits checked `Vec_get` calls), this one
/// bounds-checks: idx >= len or idx < 0 -> p_panic (exits 1).
pub fn PeirGen_gen_vec_get(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_get");
    PeirEnc_place_label(&mut self.enc, label);

    // len = [rcx + 8]
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8);
    // idx >= len -> panic
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    var vg_panic: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0xD, vg_panic); // jge
    // idx < 0 -> panic
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x8, vg_panic); // js

    // rax = ptr = [rcx]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // rax += rdx * 8
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    // rax = [rax]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);

    PeirEnc_place_label(&mut self.enc, vg_panic);
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "Vec index out of bounds"));
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_panic"));
    PeirEnc_ud2(&mut self.enc);
}

/// p_vec_pop(rcx=*Vec) -> rax = i64 (last element, or 0 if empty)
pub fn PeirGen_gen_vec_pop(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_pop");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);

    // r8 = len = [rcx+8]
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);

    // if len == 0, return 0
    PeirEnc_test_rr(&mut self.enc, PEIR_R8, PEIR_R8);
    var vp_empty: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, vp_empty); // jz — empty

    // len--
    PeirEnc_dec_r(&mut self.enc, PEIR_R8);
    // store new len
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R8);

    // rax = ptr = [rcx]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // rax += r8 * 8 (r8 is now len-1 = index of last)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R8);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var vp_ret: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, vp_ret);

    PeirEnc_place_label(&mut self.enc, vp_empty);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);

    PeirEnc_place_label(&mut self.enc, vp_ret);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_print_vec(rcx=*Vec) — prints [1, 2, 3]
pub fn PeirGen_gen_print_vec(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_vec");
    PeirEnc_place_label(&mut self.enc, label);
    PeirGen_sized_vec_to_core(self, true);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 56);

    // r12 = vec ptr, r13 = len, r14 = index
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);

    // Print '['
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 91); // '['
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -40, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -39, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RCX, -40);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_str"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);

    // r13 = len
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_xor_self(&mut self.enc, PEIR_R14); // index = 0

    var pv_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pv_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R14, PEIR_R13);
    var pv_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, pv_done); // jae — done

    // if index > 0, print ", "
    PeirEnc_test_rr(&mut self.enc, PEIR_R14, PEIR_R14);
    var pv_nosep: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pv_nosep); // jz — first element
    // Store ", \0" on stack and call p_print_str
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 44); // ','
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -40, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 32); // ' '
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -39, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -38, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RCX, -40);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_str"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_place_label(&mut self.enc, pv_nosep);

    // Get element: ptr[index]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12); // rax = data ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX); // rax = element

    // Print element as int
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_int"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);

    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, pv_loop);
    PeirEnc_place_label(&mut self.enc, pv_done);

    // Print ']'
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 93); // ']'
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -40, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -39, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RCX, -40);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_str"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);

    PeirEnc_add_rsp_i32(&mut self.enc, 56);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// HashMap runtime stubs — { ptr: *Entry, len: i64, cap: i64 } = 24 bytes,
// Entry = { key: *u8, value: i64 } = 16 bytes
// ===========================================================================

/// p_map_new() -> rax = *Map (24-byte heap struct, all zeros)
pub fn PeirGen_gen_map_new(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_new");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);

    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 24);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));

    PeirEnc_xor_self(&mut self.enc, PEIR_RCX);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 8, PEIR_RCX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 16, PEIR_RCX);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_map_insert(rcx=*Map, rdx=*u8 key, r8=i64 value)
pub fn PeirGen_gen_map_insert(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_insert");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_push(&mut self.enc, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40);

    // r12 = map, r13 = key, r14 = value
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_R8);

    // Search for existing key: for i in 0..len, compare strings
    // r8 = len = [r12+8]
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX); // r8 = len
    PeirEnc_xor_self(&mut self.enc, PEIR_R9); // r9 = index

    var mi_search: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mi_search);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R9, PEIR_R8);
    var mi_notfound: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, mi_notfound); // jae — not found

    // Get entry: ptr = [r12] + r9*16
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R9);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4); // * 16
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // entry.key = [rax], compare with r13
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX); // rcx = entry.key
    // String compare: compare bytes until mismatch or null
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13); // rdx = our key
    var mi_cmp: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mi_cmp);
    PeirEnc_xor_self(&mut self.enc, PEIR_R10);
    PeirEnc_xor_self(&mut self.enc, PEIR_R11);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R10, PEIR_RCX); // r10b = entry.key[i]
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R11, PEIR_RDX); // r11b = our.key[i]
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R10, PEIR_R11);
    var mi_mismatch: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, mi_mismatch); // jnz — mismatch
    // Both null? Match!
    PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    var mi_match: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, mi_match); // jz — strings equal
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_RDX);
    PeirEnc_jmp_label(&mut self.enc, mi_cmp);

    PeirEnc_place_label(&mut self.enc, mi_match);
    // Found existing key: update value at entry+8
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R9);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R14); // entry.value = r14
    var mi_ret: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, mi_ret);

    PeirEnc_place_label(&mut self.enc, mi_mismatch);
    PeirEnc_inc_r(&mut self.enc, PEIR_R9);
    PeirEnc_jmp_label(&mut self.enc, mi_search);

    PeirEnc_place_label(&mut self.enc, mi_notfound);
    // Need to insert new entry. Check capacity.
    // cap = [r12+16]
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 16);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R10, PEIR_RAX); // r10 = cap

    PeirEnc_cmp_rr(&mut self.enc, PEIR_R8, PEIR_R10); // len vs cap
    var mi_grow: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x2, mi_grow); // jb — no grow needed

    // Grow: new_cap = cap==0 ? 4 : cap*2
    PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    var mi_newcap: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, mi_newcap); // jnz — cap != 0
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R10, 4);
    var mi_grow2: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, mi_grow2);
    PeirEnc_place_label(&mut self.enc, mi_newcap);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_R10, 1); // cap * 2

    PeirEnc_place_label(&mut self.enc, mi_grow2);
    // Save new_cap at [rbp-16], len at [rbp-24] (r8 clobbered by p_malloc)
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_R10);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -24, PEIR_R8);
    // malloc(new_cap * 16)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R10);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4); // * 16
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R11, PEIR_RAX); // r11 = new entries
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R8, -24); // restore len

    // Copy old entries: len * 16 bytes
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12); // rax = old ptr
    PeirEnc_xor_self(&mut self.enc, PEIR_RCX); // index
    var mi_copy: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mi_copy);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RCX, PEIR_R8);
    var mi_copydone: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, mi_copydone); // jae — done
    // Copy 16 bytes (2 qwords)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDX, 4);
    // old[i].key
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
    PeirEnc_add_rr(&mut self.enc, PEIR_R9, PEIR_RDX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R9, PEIR_R9);
    // new[i].key
    PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_R11);
    PeirEnc_add_rr(&mut self.enc, PEIR_R10, PEIR_RDX);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_R10, PEIR_R9);
    // old[i].value
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
    PeirEnc_add_rr(&mut self.enc, PEIR_R9, PEIR_RDX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_R9, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R9, PEIR_R9);
    // new[i].value
    PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_R11);
    PeirEnc_add_rr(&mut self.enc, PEIR_R10, PEIR_RDX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_R10, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_R10, PEIR_R9);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_jmp_label(&mut self.enc, mi_copy);
    PeirEnc_place_label(&mut self.enc, mi_copydone);

    // Update ptr first: r11 does not survive the call to p_free
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_R12, PEIR_R11); // [r12] = new ptr

    // Free old if non-null
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var mi_nofree: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, mi_nofree);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_free"));
    PeirEnc_place_label(&mut self.enc, mi_nofree);

    // Update cap
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_R10, -16); // restore new_cap
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 16);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R10); // [r12+16] = new cap

    PeirEnc_place_label(&mut self.enc, mi_grow);
    // No grow needed — len < cap. Just add entry at index len.
    // Re-read len (r8 might be stale)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX); // r8 = len

    // entry = ptr + len * 16
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R8);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    // entry.key = r13
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R13);
    // entry.value = r14
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R14);
    // len++
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R8);

    PeirEnc_place_label(&mut self.enc, mi_ret);
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_map_get(rcx=*Map, rdx=*u8 key) -> rax = i64
pub fn PeirGen_gen_map_get(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_get");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);

    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX); // map
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX); // key

    // len = [r12+8]
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
    PeirEnc_xor_self(&mut self.enc, PEIR_R9); // index

    var mg_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mg_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R9, PEIR_R8);
    var mg_notfound: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, mg_notfound);

    // entry = ptr + r9*16
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R9);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX); // entry.key

    // Compare strings
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    var mg_cmp: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mg_cmp);
    PeirEnc_xor_self(&mut self.enc, PEIR_R10);
    PeirEnc_xor_self(&mut self.enc, PEIR_R11);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R10, PEIR_RCX);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R11, PEIR_RDX);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R10, PEIR_R11);
    var mg_mismatch: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, mg_mismatch);
    PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    var mg_found: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, mg_found);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_RDX);
    PeirEnc_jmp_label(&mut self.enc, mg_cmp);

    PeirEnc_place_label(&mut self.enc, mg_found);
    // Return entry.value at [entry+8]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R9);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var mg_ret: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, mg_ret);

    PeirEnc_place_label(&mut self.enc, mg_mismatch);
    PeirEnc_inc_r(&mut self.enc, PEIR_R9);
    PeirEnc_jmp_label(&mut self.enc, mg_loop);

    PeirEnc_place_label(&mut self.enc, mg_notfound);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX); // return 0 if not found

    PeirEnc_place_label(&mut self.enc, mg_ret);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_map_contains(rcx=*Map, rdx=*u8 key) -> rax = bool
pub fn PeirGen_gen_map_contains(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_contains");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);

    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX);
    PeirEnc_xor_self(&mut self.enc, PEIR_R9);

    var mc_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mc_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R9, PEIR_R8);
    var mc_notfound: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, mc_notfound);

    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R9);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    var mc_cmp: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mc_cmp);
    PeirEnc_xor_self(&mut self.enc, PEIR_R10);
    PeirEnc_xor_self(&mut self.enc, PEIR_R11);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R10, PEIR_RCX);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R11, PEIR_RDX);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R10, PEIR_R11);
    var mc_mismatch: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, mc_mismatch);
    PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    var mc_found: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, mc_found);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_RDX);
    PeirEnc_jmp_label(&mut self.enc, mc_cmp);

    PeirEnc_place_label(&mut self.enc, mc_found);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
    var mc_ret: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jmp_label(&mut self.enc, mc_ret);

    PeirEnc_place_label(&mut self.enc, mc_mismatch);
    PeirEnc_inc_r(&mut self.enc, PEIR_R9);
    PeirEnc_jmp_label(&mut self.enc, mc_loop);

    PeirEnc_place_label(&mut self.enc, mc_notfound);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);

    PeirEnc_place_label(&mut self.enc, mc_ret);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_map_remove(rcx=*Map, rdx=*u8 key)
pub fn PeirGen_gen_map_remove(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_remove");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);

    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R8, PEIR_RAX); // len
    PeirEnc_xor_self(&mut self.enc, PEIR_R9); // index

    var mr_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mr_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R9, PEIR_R8);
    var mr_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, mr_done);

    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R9);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    var mr_cmp: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mr_cmp);
    PeirEnc_xor_self(&mut self.enc, PEIR_R10);
    PeirEnc_xor_self(&mut self.enc, PEIR_R11);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R10, PEIR_RCX);
    PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_R11, PEIR_RDX);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R10, PEIR_R11);
    var mr_mismatch: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, mr_mismatch);
    PeirEnc_test_rr(&mut self.enc, PEIR_R10, PEIR_R10);
    var mr_found: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, mr_found);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_RDX);
    PeirEnc_jmp_label(&mut self.enc, mr_cmp);

    PeirEnc_place_label(&mut self.enc, mr_found);
    // Shift remaining entries left by 1
    // r9 = found index, r8 = len
    // for i in r9..r8-1: entry[i] = entry[i+1]
    PeirEnc_mov_rr(&mut self.enc, PEIR_R10, PEIR_R9); // i = found index
    var mr_shift: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mr_shift);
    // if i >= len-1, done shifting
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R8);
    PeirEnc_dec_r(&mut self.enc, PEIR_RAX);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R10, PEIR_RAX);
    var mr_shift_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, mr_shift_done); // jae — done

    // Copy entry[i+1] to entry[i]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R10);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX); // rax = &entry[i]
    // entry[i+1] key
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RDX, 16);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RDX);
    // entry[i+1] value
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RDX, 24); // entry[i+1].value
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_RDX);

    PeirEnc_inc_r(&mut self.enc, PEIR_R10);
    PeirEnc_jmp_label(&mut self.enc, mr_shift);
    PeirEnc_place_label(&mut self.enc, mr_shift_done);

    // len--
    PeirEnc_dec_r(&mut self.enc, PEIR_R8);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R8);
    PeirEnc_jmp_label(&mut self.enc, mr_done);

    PeirEnc_place_label(&mut self.enc, mr_mismatch);
    PeirEnc_inc_r(&mut self.enc, PEIR_R9);
    PeirEnc_jmp_label(&mut self.enc, mr_loop);

    PeirEnc_place_label(&mut self.enc, mr_done);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_map_len(rcx=*Map) -> rax = i64
pub fn PeirGen_gen_map_len(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_len");
    PeirEnc_place_label(&mut self.enc, label);

    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_map_is_empty(rcx=*Map) -> rax = bool
pub fn PeirGen_gen_map_is_empty(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_is_empty");
    PeirEnc_place_label(&mut self.enc, label);

    // rax = [rcx + 8] (len)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    // if len == 0, return 1, else return 0
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var mie_empty: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, mie_empty); // jz — empty
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX); // not empty → 0
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, mie_empty);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1); // empty → 1
    PeirEnc_ret(&mut self.enc);
}

/// p_print_map(rcx=*Map) — prints {key: value, ...}
pub fn PeirGen_gen_print_map(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_map");
    PeirEnc_place_label(&mut self.enc, label);

    // Prologue: push rbp + 4 callee-saved = 5 pushes = 40 bytes
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12); // map
    PeirEnc_push(&mut self.enc, PEIR_R13); // len
    PeirEnc_push(&mut self.enc, PEIR_R14); // index
    PeirEnc_push(&mut self.enc, PEIR_R15); // result string
    PeirEnc_sub_rsp_i32(&mut self.enc, 40); // 32 shadow + 8 align

    // r12 = map
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);

    // Start with "{" — malloc 2 bytes, store '{', '\0'
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 2);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX); // r15 = result
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 123); // '{'
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R15, PEIR_RCX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RCX, 0);
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_R15, 1, PEIR_RCX);

    // r13 = len = [r12 + 8], r14 = 0
    PeirEnc_xor_self(&mut self.enc, PEIR_R14);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R13, PEIR_RAX);

    var pm_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, pm_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R14, PEIR_R13);
    var pm_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x3, pm_done); // jae — done

    // If index > 0, append ", "
    PeirEnc_test_rr(&mut self.enc, PEIR_R14, PEIR_R14);
    var pm_first: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, pm_first); // jz — first element
    // Build ", \0" on stack at [rbp-16]
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 44); // ','
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 32); // ' '
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -15, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -14, PEIR_RAX);
    // r15 = p_str_concat(r15, &[rbp-16])
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -16);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, pm_first);

    // Get key: entry = ptr + r14*16, key = [entry]
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX); // rcx = key ptr

    // r15 = p_str_concat(r15, key)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX); // rdx = key
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15); // rcx = result so far
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);

    // Append ": "
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 58); // ':'
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 32); // ' '
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -15, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -14, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -16);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);

    // Get value: entry+8
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RCX, 4);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RCX);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 8);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RCX, PEIR_RAX); // rcx = value

    // Call p_to_str(value) -> rax = string
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_to_str"));

    // r15 = p_str_concat(r15, rax)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RAX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);

    // inc r14, loop
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, pm_loop);

    PeirEnc_place_label(&mut self.enc, pm_done);
    // Append "}" — build "}\0" on stack at [rbp-16]
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 125); // '}'
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -16, PEIR_RAX);
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -15, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -16);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_str_concat"));
    // rax = final string

    // Print the string (p_print_str adds newline)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_print_str"));

    // Epilogue
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R15);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// New Vec runtime stubs
// ===========================================================================

/// p_vec_set(rcx=*Vec, rdx=i64 idx, r8=i64 value)
/// Bounds-checked like the interpreter's builtin: an out-of-range write
/// would silently corrupt the heap, so idx >= len or idx < 0 -> p_panic.
pub fn PeirGen_gen_vec_set(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_set");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);

    // len = [rcx + 8]
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8);
    var vs_panic: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RDX, PEIR_RAX); // idx vs len
    PeirEnc_jcc_label(&mut self.enc, 0xD, vs_panic);   // jge -> panic
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x8, vs_panic);   // js -> panic

    // rax = data ptr
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX);      // rax = data
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RDX);             // r9 = idx
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_R9, 3);                  // r9 = idx*8
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R9);             // &data[idx]
    PeirEnc_mov_ptr_reg(&mut self.enc, PEIR_RAX, PEIR_R8);        // data[idx]
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);                    // return 0
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);

    PeirEnc_place_label(&mut self.enc, vs_panic);
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirGen_str_off(self, "Vec index out of bounds"));
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_panic"));
    PeirEnc_ud2(&mut self.enc);
}

/// p_vec_is_empty(rcx=*Vec) -> rax = bool
pub fn PeirGen_gen_vec_is_empty(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_is_empty");
    PeirEnc_place_label(&mut self.enc, label);
    // len at [rcx+8], return len == 0
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_setcc_r(&mut self.enc, 0x4, PEIR_RAX);
    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_clear(rcx=*Vec)
pub fn PeirGen_gen_vec_clear(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_clear");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 8, PEIR_RAX); // len = 0
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_capacity(rcx=*Vec) -> rax = i64
pub fn PeirGen_gen_vec_capacity(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_capacity");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 16); // cap
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_first(rcx=*Vec) -> rax = i64
pub fn PeirGen_gen_vec_first(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_first");
    PeirEnc_place_label(&mut self.enc, label);
    // Check len > 0
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8); // rax = len
    var skip: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, skip); // jz
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX); // rax = data[0]
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, skip);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_last(rcx=*Vec) -> rax = i64
pub fn PeirGen_gen_vec_last(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_last");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8); // rax = len
    var skip: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, skip); // jz
    // data ptr is at [rcx], load it
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R9, PEIR_RCX);  // r9 = data ptr
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8); // rax = len
    PeirEnc_dec_r(&mut self.enc, PEIR_RAX);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_R9);
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, skip);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_contains(rcx=*Vec, rdx=i64 value) -> rax = bool
pub fn PeirGen_gen_vec_contains(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_contains");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    // r12 = data ptr, r13 = value
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_R12, PEIR_RCX);  // r12 = data ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);        // r13 = value
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R9, PEIR_RCX, 8); // r9 = len
    PeirEnc_xor_self(&mut self.enc, PEIR_R10); // r10 = index 0
    var loop_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    var found_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    var not_found: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, loop_label);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R10, PEIR_R9);
    PeirEnc_jcc_label(&mut self.enc, 0x3, not_found); // jae — not found
    // Load element at r10
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R10);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RAX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_reg_ptr(&mut self.enc, PEIR_RAX, PEIR_RAX); // rax = data[r10]
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_jcc_label(&mut self.enc, 0x4, found_label); // je — found
    PeirEnc_inc_r(&mut self.enc, PEIR_R10);
    PeirEnc_jmp_label(&mut self.enc, loop_label);
    PeirEnc_place_label(&mut self.enc, found_label);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
    PeirEnc_jmp_label(&mut self.enc, not_found);
    PeirEnc_place_label(&mut self.enc, not_found);
    // (Both the fall-through and the found path land here; as in Rust,
    // rax is unconditionally reset to 0 — the found path's rax=1 is dead.)
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_truncate(rcx=*Vec, rdx=i64 new_len)
pub fn PeirGen_gen_vec_truncate(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_truncate");
    PeirEnc_place_label(&mut self.enc, label);
    // Set len = min(len, new_len)
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RCX, 8); // len
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    // If rdx < rax, set len = rdx; else keep len
    var skip: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x2, skip); // jb — rdx < rax
    // rdx >= rax, keep current len, return
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, skip);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 8, PEIR_RDX); // len = rdx
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_vec_clone(rcx=*Vec) -> rax = *Vec (new copy)
pub fn PeirGen_gen_vec_clone(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_vec_clone");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    // r12 = original vec
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // malloc(24) for new vec
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 24);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // Copy 24 bytes from original to new
    PeirEnc_mov_rr(&mut self.enc, PEIR_R9, PEIR_RAX); // r9 = new vec ptr
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_R12, 0);  // data ptr
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R9, 0, PEIR_RCX);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_R12, 8);  // len
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R9, 8, PEIR_RCX);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_R12, 16); // cap
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R9, 16, PEIR_RCX);
    // Return new vec ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R9);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// New HashMap runtime stubs
// ===========================================================================

/// p_map_clear(rcx=*Map) — set count=0
pub fn PeirGen_gen_map_clear(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_clear");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RCX, 8, PEIR_RAX); // count = 0
    PeirEnc_ret(&mut self.enc);
}

/// p_map_get_or(rcx=*Map, rdx=*u8 key, r8=i64 default) -> rax = i64
pub fn PeirGen_gen_map_get_or(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_map_get_or");
    PeirEnc_place_label(&mut self.enc, label);
    // Try p_map_get first; if it returns 0 and not found, return default.
    // (A stub, as in Rust: it returns the default unconditionally.)
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    // Save default in r12
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_R8);
    // Check contains first
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_map_contains"));
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    var not_found: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x4, not_found); // jz — not contained
    // Contained: call p_map_get — rcx/rdx were clobbered, so this stub just
    // returns the default (same as Rust).
    PeirEnc_place_label(&mut self.enc, not_found);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// String runtime stubs — strings in PE are null-terminated *u8 (C strings)
// ===========================================================================

/// p_string_len(rcx=*u8) -> rax = i64 (strlen)
pub fn PeirGen_gen_string_len(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_string_len");
    PeirEnc_place_label(&mut self.enc, label);
    // Delegate to imported strlen — a real SIMD scan, not a byte loop.
    // push rbp + sub 32 keeps rsp 16-aligned at the call.
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("strlen")));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_string_is_empty(rcx=*u8) -> rax = bool
pub fn PeirGen_gen_string_is_empty(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_string_is_empty");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RCX); // load first byte
    // mov r8,[m] leaves rax's upper bits dirty — clean before the test
    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_setcc_r(&mut self.enc, 0x4, PEIR_RAX);
    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_ret(&mut self.enc);
}

/// p_string_starts_with(rcx=*u8, rdx=*u8 prefix) -> rax = bool
pub fn PeirGen_gen_string_starts_with(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_string_starts_with");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    // r12 = str, r13 = prefix
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);
    var loop_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    var true_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    var false_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    var done_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, loop_label);
    // Load prefix byte (movzx — upper bits dirty after mov r8,[m])
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, true_label); // prefix end = match
    // Load str byte
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_R9, PEIR_R12);
    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_R9, PEIR_R9);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R9, PEIR_RAX);
    PeirEnc_jcc_label(&mut self.enc, 0x5, false_label); // jne
    // Advance both pointers
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_jmp_label(&mut self.enc, loop_label);
    PeirEnc_place_label(&mut self.enc, false_label);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_jmp_label(&mut self.enc, done_label);
    PeirEnc_place_label(&mut self.enc, true_label);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 1);
    PeirEnc_place_label(&mut self.enc, done_label);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_string_parse_int(rcx=*u8) -> rax = i64 (atoi)
pub fn PeirGen_gen_string_parse_int(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_string_parse_int");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    // r12 = ptr, rax = result
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX); // result = 0
    var loop_label: i64 = PeirEnc_alloc_label(&mut self.enc);
    var done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, loop_label);
    // Load byte (movzx — r9's upper bits are dirty after mov r8,[m] and r9
    // is added into the result below)
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_R9, PEIR_R12);
    PeirEnc_movzx_r32_r8(&mut self.enc, PEIR_R9, PEIR_R9);
    // Check if byte < '0' or > '9'
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_R9, 48); // '0'
    PeirEnc_jcc_label(&mut self.enc, 0x2, done); // jb
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_R9, 57); // '9'
    PeirEnc_jcc_label(&mut self.enc, 0x7, done); // ja
    // result = result * 10 + (byte - '0')
    PeirEnc_imul_r_r_imm32(&mut self.enc, PEIR_RAX, PEIR_RAX, 10);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_R9, -48);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R9);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_jmp_label(&mut self.enc, loop_label);
    PeirEnc_place_label(&mut self.enc, done);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_string_bytes(rcx=*u8) -> rax = i64 (same as len)
pub fn PeirGen_gen_string_bytes(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_string_bytes");
    PeirEnc_place_label(&mut self.enc, label);
    // Same as p_string_len: delegate to imported strlen.
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("strlen")));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_string_clone(rcx=*u8) -> rax = *u8 (new copy)
pub fn PeirGen_gen_string_clone(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_string_clone");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    var strlen_off: i64 = PeirGen_iat_off(self, pe_import_slot("strlen"));
    var memcpy_off: i64 = PeirGen_iat_off(self, pe_import_slot("memcpy"));
    // r12 = src; r13 = strlen(src)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_call_rip(&mut self.enc, strlen_off);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX);
    // malloc(len + 1)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    // r12 = dest (src is done once rdx holds it); memcpy(dest, src, len+1)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R13);
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, memcpy_off);
    // Return dest
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// Alias stubs: p_float_to_str → p_to_str_float, p_bool_to_str → p_to_str_bool
// ===========================================================================

pub fn PeirGen_gen_float_to_str_alias(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_float_to_str");
    PeirEnc_place_label(&mut self.enc, label);
    var target: i64 = HashMap_get(self.func_labels, "p_to_str_float");
    PeirEnc_jmp_label(&mut self.enc, target);
}

pub fn PeirGen_gen_bool_to_str_alias(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_bool_to_str");
    PeirEnc_place_label(&mut self.enc, label);
    var target: i64 = HashMap_get(self.func_labels, "p_to_str_bool");
    PeirEnc_jmp_label(&mut self.enc, target);
}

/// p_char_to_str(rcx = char_code) -> rax = *u8
pub fn PeirGen_gen_char_to_str(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_char_to_str");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40); // 32 + 8 for alignment
    // Save char code in r12
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // malloc(16 + 2): a length header, so a zero byte is a 1-byte string
    // (release D16), then the byte and the terminator
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 18);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_R9, 0x4649444500000001);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 0, PEIR_R9);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R9, 1);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, 8, PEIR_R9);
    PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, 16);
    // Store char at [rax]
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_R12);
    // Store 0 at [rax+1]
    PeirEnc_xor_self(&mut self.enc, PEIR_R12);
    PeirEnc_mov_mem_disp_reg8(&mut self.enc, PEIR_RAX, 1, PEIR_R12);
    // Return rax
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_eprint_str(rcx = *u8) — WriteFile to stderr
pub fn PeirGen_gen_eprint_str(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_eprint_str");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_push(&mut self.enc, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 64);
    // r12 = string pointer
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // Calculate length: strlen(r12)
    PeirEnc_xor_self(&mut self.enc, PEIR_R8);
    var es_len: i64 = PeirEnc_alloc_label(&mut self.enc);
    var es_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, es_len);
    PeirEnc_cmp_mem_idx_imm8(&mut self.enc, PEIR_R12, PEIR_R8, 0);
    PeirEnc_jcc_label(&mut self.enc, 0x4, es_done); // je
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_jmp_label(&mut self.enc, es_len);
    PeirEnc_place_label(&mut self.enc, es_done);
    // r13 = length
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_R8);
    // GetStdHandle(STD_ERROR_HANDLE = -12)
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -12);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // WriteFile(handle, r12, r13, &written, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R13);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -32);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    // Return
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_print_newline() — WriteFile "\n" to stdout
pub fn PeirGen_gen_print_newline(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_print_newline");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 64);
    // Store '\n' at [rbp-8]
    PeirEnc_mov_r8_imm(&mut self.enc, PEIR_RAX, 10);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -8, PEIR_RAX);
    // GetStdHandle(-11)
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, -11);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_STD_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // WriteFile(handle, &"\n", 1, &written, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_RDX, -8);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 1);
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -16);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    // Return
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// String-builder stubs
// ===========================================================================

/// p_sb_new() -> rax = *sb (struct: {buf, len, cap} = 24 bytes)
pub fn PeirGen_gen_sb_new(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_sb_new");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40); // 32 + 8 for alignment
    // malloc(24) for struct
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 24);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX); // r12 = sb struct
    // malloc(4096) for buffer
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 4096);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // sb->buf = rax (offset 0)
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 0, PEIR_RAX);
    // sb->len = 0 (offset 8)
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 8, PEIR_RAX);
    // sb->cap = 4096 (offset 16)
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 4096);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 16, PEIR_RAX);
    // buf[0] = 0
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 0); // rax = buf
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    // Return sb
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_sb_append(rcx = sb, rdx = s)
/// strlen once, memcpy for both the grow-copy and the append — no byte
/// loops (pe-roadmap items 73/75).
pub fn PeirGen_gen_sb_append(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_sb_append");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12); // sb
    PeirEnc_push(&mut self.enc, PEIR_R13); // s
    PeirEnc_push(&mut self.enc, PEIR_R14); // slen
    PeirEnc_push(&mut self.enc, PEIR_R15); // new_cap / new buf
    PeirEnc_sub_rsp_i32(&mut self.enc, 48); // 32 shadow + 16 locals
    // r12 = sb, r13 = s
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);

    var strlen_off: i64 = PeirGen_iat_off(self, pe_import_slot("strlen"));
    var memcpy_off: i64 = PeirGen_iat_off(self, pe_import_slot("memcpy"));

    // r14 = slen = strlen(s)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_call_rip(&mut self.enc, strlen_off);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_RAX);

    // needed = sb->len + slen + 1; grow while cap < needed
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 8); // sb->len
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R14);
    PeirEnc_inc_r(&mut self.enc, PEIR_RAX); // rax = needed
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_R12, 16); // sb->cap
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var sa_no_grow: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x6, sa_no_grow); // jbe — fits
    // r15 = new_cap = cap doubled until it fits
    var sa_grow_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, sa_grow_loop);
    PeirEnc_add_rr(&mut self.enc, PEIR_RDX, PEIR_RDX); // cap *= 2
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x7, sa_grow_loop); // ja — still no fit
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RDX);

    // [rbp-48] = old buf; sb->cap = new_cap
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 0);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 16, PEIR_R15);

    // rax = new buf = p_malloc(new_cap)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R15);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));

    // r15 = new buf; memcpy(new buf, old buf, sb->len)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R15, PEIR_RAX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, -48);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R8, PEIR_R12, 8);
    PeirEnc_call_rip(&mut self.enc, memcpy_off);

    // sb->buf = new buf; free(old buf)
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 0, PEIR_R15);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, -48);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_free"));

    PeirEnc_place_label(&mut self.enc, sa_no_grow);
    // memcpy(sb->buf + sb->len, s, slen + 1) — +1 copies s's NUL
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_R12, 0); // buf
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 8); // len
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_RAX); // dest = buf + len
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R14);
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_call_rip(&mut self.enc, memcpy_off);

    // sb->len += slen
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 8);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_R14);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R12, 8, PEIR_RAX);

    // Return 0
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    PeirEnc_pop(&mut self.enc, PEIR_R15);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_sb_to_str(rcx = sb) -> rax = *u8
pub fn PeirGen_gen_sb_to_str(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_sb_to_str");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12); // sb
    PeirEnc_push(&mut self.enc, PEIR_R13); // result
    PeirEnc_push(&mut self.enc, PEIR_R14); // len
    PeirEnc_sub_rsp_i32(&mut self.enc, 40); // 32 + 8 for alignment
    // r12 = sb
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // r14 = sb->len
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R14, PEIR_R12, 8);
    // malloc(len + 1)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX); // r13 = result
    // memcpy(result, sb->buf, len + 1) — +1 copies the NUL
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_R12, 0); // sb->buf
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R14);
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("memcpy")));
    // Free sb->buf
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_R12, 0);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_free"));
    // Free sb struct
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_free"));
    // Return result
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R13);
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// File I/O stubs
// ===========================================================================

/// p_file_read(rcx = path) -> rax = *u8
pub fn PeirGen_gen_file_read(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_file_read");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12); // path
    PeirEnc_push(&mut self.enc, PEIR_R13); // handle
    PeirEnc_push(&mut self.enc, PEIR_R14); // buf
    PeirEnc_sub_rsp_i32(&mut self.enc, 40); // 32 + 8 for alignment
    // r12 = path
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // CreateFileA(path, GENERIC_READ=0x80000000, FILE_SHARE_READ=1, NULL,
    // OPEN_EXISTING=3, 0, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12); // path
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x80000000); // GENERIC_READ
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R8, 1); // FILE_SHARE_READ
    PeirEnc_xor_self(&mut self.enc, PEIR_R9); // NULL (security)
    // Allocate shadow space + stack args (5th, 6th, 7th params)
    PeirEnc_sub_rsp_i32(&mut self.enc, 64); // 32 shadow + 3 stack args
    // Set stack args at rsp+32, rsp+40, rsp+48
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 3);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX); // OPEN_EXISTING
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 40, PEIR_RAX); // flags=0
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 48, PEIR_RAX); // template
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_CREATE_FILE_A));
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    // Check for INVALID_HANDLE_VALUE (-1)
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX); // handle
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, -1);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var fr_ok: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, fr_ok); // jnz — handle valid
    // Return 0 (NULL)
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, fr_ok);
    // r12 = GetFileSize(handle, NULL): the path is no longer needed.
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_FILE_SIZE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX);
    PeirEnc_mov_imm64(&mut self.enc, PEIR_RDX, 0xFFFFFFFF);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R12, PEIR_RDX);
    var fr_size_ok: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, fr_size_ok); // jne
    PeirEnc_xor_self(&mut self.enc, PEIR_R12);
    PeirEnc_place_label(&mut self.enc, fr_size_ok);
    // r14 = buf = p_malloc(size + 1)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_RAX); // r14 = buf
    // ReadFile(handle, buf, size, &bytesRead, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13); // handle
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R14); // buf
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_R12); // size
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -32); // &bytesRead
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    // Zero all 8 bytes: ReadFile writes a DWORD, the count is read as 64 bits.
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_R9, 0, PEIR_RAX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX); // NULL
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_READ_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    // bytesRead is at [rbp-32]. Null-terminate at buf[bytesRead]
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -32); // bytesRead
    PeirEnc_add_rr(&mut self.enc, PEIR_R14, PEIR_RAX); // r14 = buf + bytesRead
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R14, PEIR_RDX); // null term
    // CloseHandle(handle)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_CLOSE_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // Return buf (r14 = buf + bytesRead, subtract bytesRead back)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RAX, PEIR_R14);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RDX, -32); // bytesRead
    PeirEnc_sub_rr(&mut self.enc, PEIR_RAX, PEIR_RDX); // rax = buf
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_file_write(rcx = path, rdx = content) -> rax = i64 (0=success, -1=fail)
pub fn PeirGen_gen_file_write(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_file_write");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12); // path
    PeirEnc_push(&mut self.enc, PEIR_R13); // content
    PeirEnc_push(&mut self.enc, PEIR_R14); // handle
    PeirEnc_sub_rsp_i32(&mut self.enc, 40); // 32 + 8 for alignment
    // r12 = path, r13 = content
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RDX);
    // CreateFileA(path, GENERIC_WRITE=0x40000000, 0, NULL, CREATE_ALWAYS=2, 0, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R12);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x40000000); // GENERIC_WRITE
    PeirEnc_xor_self(&mut self.enc, PEIR_R8); // no sharing
    PeirEnc_xor_self(&mut self.enc, PEIR_R9); // NULL security
    PeirEnc_sub_rsp_i32(&mut self.enc, 64);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 2); // CREATE_ALWAYS
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 40, PEIR_RAX); // flags=0
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 48, PEIR_RAX); // template
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_CREATE_FILE_A));
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    // Check for INVALID_HANDLE_VALUE
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_RAX); // handle
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, -1);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    var fw_ok: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, fw_ok); // jnz — valid
    // Return -1
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, -1);
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, fw_ok);
    // strlen(content) into r8
    PeirEnc_xor_self(&mut self.enc, PEIR_R8);
    var fw_len: i64 = PeirEnc_alloc_label(&mut self.enc);
    var fw_len_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, fw_len);
    PeirEnc_cmp_mem_idx_imm8(&mut self.enc, PEIR_R13, PEIR_R8, 0);
    PeirEnc_jcc_label(&mut self.enc, 0x4, fw_len_done); // je
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_jmp_label(&mut self.enc, fw_len);
    PeirEnc_place_label(&mut self.enc, fw_len_done);
    // WriteFile(handle, content, len, &written, NULL)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14); // handle
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13); // content
    // r8 already = len
    PeirEnc_lea_rbp(&mut self.enc, PEIR_R9, -32); // &written
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg32(&mut self.enc, PEIR_R9, 0, PEIR_RAX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 48);
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_RAX); // NULL
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_WRITE_FILE));
    PeirEnc_add_rsp_i32(&mut self.enc, 48);
    // CloseHandle(handle)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_CLOSE_HANDLE));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // Return 0
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 40);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// Process stubs: p_argc, p_argv, p_system
// ===========================================================================

/// p_argc() -> rax = i64
/// Returns the number of command-line arguments.  On Windows,
/// GetCommandLineA returns a single string; we count tokens.
pub fn PeirGen_gen_argc(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_argc");
    PeirEnc_place_label(&mut self.enc, label);
    // GetCommandLineA() -> rax = *u8 (command line string)
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_COMMAND_LINE_A));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // rax = command line string (or NULL)
    // Count whitespace-separated tokens
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX); // rcx = ptr
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX); // count = 0
    var done: i64 = PeirEnc_alloc_label(&mut self.enc);
    var loop_start: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, done); // jz — NULL command line
    // Skip leading whitespace
    PeirEnc_place_label(&mut self.enc, loop_start);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX); // clear: only dl is loaded below
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RDX, PEIR_RCX); // load byte
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, done); // jz — end of string
    // Skip whitespace
    var not_ws: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RDX, 32); // ' '
    PeirEnc_jcc_label(&mut self.enc, 0x5, not_ws); // jne — not space
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX); // advance
    PeirEnc_jmp_label(&mut self.enc, loop_start);
    PeirEnc_place_label(&mut self.enc, not_ws);
    // Found a token — increment count
    PeirEnc_inc_r(&mut self.enc, PEIR_RAX); // count++
    // Skip token until whitespace or end
    var skip_tok: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, skip_tok);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RDX, PEIR_RCX);
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, done); // jz — end of string
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RDX, 32); // ' '
    PeirEnc_jcc_label(&mut self.enc, 0x4, loop_start); // je — space: next token
    PeirEnc_inc_r(&mut self.enc, PEIR_RCX);
    PeirEnc_jmp_label(&mut self.enc, skip_tok);
    PeirEnc_place_label(&mut self.enc, done);
    PeirEnc_ret(&mut self.enc);
}

/// p_argv(rcx = index) -> rax = *u8
/// Returns the command-line argument at the given index, or NULL.
pub fn PeirGen_gen_argv(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_argv");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12); // index
    PeirEnc_push(&mut self.enc, PEIR_R13); // cmdline ptr
    PeirEnc_push(&mut self.enc, PEIR_R14); // current token start
    PeirEnc_sub_rsp_i32(&mut self.enc, 24); // align (3 pushes = 24)
    // r12 = index
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    // GetCommandLineA()
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_GET_COMMAND_LINE_A));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R13, PEIR_RAX); // r13 = cmdline
    PeirEnc_xor_self(&mut self.enc, PEIR_R14); // r14 = token start (NULL)
    // If cmdline is NULL, return NULL
    var cmd_null: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_test_rr(&mut self.enc, PEIR_R13, PEIR_R13);
    PeirEnc_jcc_label(&mut self.enc, 0x4, cmd_null); // jz
    // Walk tokens, counting.  When count == index, save token start.
    var scan_start: i64 = PeirEnc_alloc_label(&mut self.enc);
    var tok_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    var skip_ws: i64 = PeirEnc_alloc_label(&mut self.enc);
    var found_tok: i64 = PeirEnc_alloc_label(&mut self.enc);
    var skip_tok: i64 = PeirEnc_alloc_label(&mut self.enc);
    // rax = current index (0)
    PeirEnc_xor_self(&mut self.enc, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, scan_start);
    // Skip whitespace
    PeirEnc_place_label(&mut self.enc, skip_ws);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RDX, PEIR_R13);
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tok_done); // jz — end
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RDX, 32); // ' '
    PeirEnc_jcc_label(&mut self.enc, 0x5, found_tok); // jne — found token
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_jmp_label(&mut self.enc, skip_ws);
    PeirEnc_place_label(&mut self.enc, found_tok);
    // Check if this is the token we want
    PeirEnc_cmp_rr(&mut self.enc, PEIR_RAX, PEIR_R12);
    var not_this: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_jcc_label(&mut self.enc, 0x5, not_this); // jne — not this index
    // Found! Save start
    PeirEnc_mov_rr(&mut self.enc, PEIR_R14, PEIR_R13);
    PeirEnc_jmp_label(&mut self.enc, tok_done);
    PeirEnc_place_label(&mut self.enc, not_this);
    // Skip this token
    var tok_end: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, skip_tok);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RDX, PEIR_R13);
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, tok_done); // jz — end
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RDX, 32); // ' '
    PeirEnc_jcc_label(&mut self.enc, 0x4, tok_end); // je — space: token done
    PeirEnc_inc_r(&mut self.enc, PEIR_R13);
    PeirEnc_jmp_label(&mut self.enc, skip_tok);
    // After skipping token, increment index and loop
    PeirEnc_place_label(&mut self.enc, tok_end);
    PeirEnc_inc_r(&mut self.enc, PEIR_RAX);
    PeirEnc_jmp_label(&mut self.enc, scan_start);
    PeirEnc_place_label(&mut self.enc, tok_done);
    // If r14 is NULL, return NULL
    PeirEnc_test_rr(&mut self.enc, PEIR_R14, PEIR_R14);
    PeirEnc_jcc_label(&mut self.enc, 0x4, cmd_null); // jz
    // Allocate a copy of the token (up to 4KB)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R14); // src
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 0x1000); // max 4KB
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    // rax = dst buffer. Copy bytes until space or null.
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RAX); // r12 = dst
    var copy_start: i64 = PeirEnc_alloc_label(&mut self.enc);
    var copy_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, copy_start);
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_reg8_ptr(&mut self.enc, PEIR_RDX, PEIR_R14); // load src byte
    PeirEnc_test_rr(&mut self.enc, PEIR_RDX, PEIR_RDX);
    PeirEnc_jcc_label(&mut self.enc, 0x4, copy_done); // jz — null
    PeirEnc_cmp_r8_i8(&mut self.enc, PEIR_RDX, 32); // ' '
    PeirEnc_jcc_label(&mut self.enc, 0x4, copy_done); // je — space
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R12, PEIR_RDX); // store byte
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_inc_r(&mut self.enc, PEIR_R12);
    PeirEnc_jmp_label(&mut self.enc, copy_start);
    PeirEnc_place_label(&mut self.enc, copy_done);
    // Null-terminate
    PeirEnc_xor_self(&mut self.enc, PEIR_RDX);
    PeirEnc_mov_mem_reg8_ptr(&mut self.enc, PEIR_R12, PEIR_RDX);
    // rax still points to the start of the buffer
    PeirEnc_jmp_label(&mut self.enc, cmd_null);
    PeirEnc_place_label(&mut self.enc, cmd_null);
    // rax = result (either the buffer or NULL if not found)
    PeirEnc_add_rsp_i32(&mut self.enc, 24);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSP, PEIR_RBP);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

/// p_system(rcx = cmd) -> rax = i64 (exit code)
/// msvcrt system(), as the C backend: runs through the shell and returns the
/// exit status.
pub fn PeirGen_gen_system(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_system");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("system")));
    PeirEnc_movsxd_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// String join
// ===========================================================================

/// p_str_join_n(rcx = *Vec) -> rax = *u8
/// Vec struct: {data: *ptr, len: i64, cap: i64}; each element is a *u8 string.
pub fn PeirGen_gen_str_join_n(self: &mut PeirGen) -> void {
    var label: i64 = HashMap_get(self.func_labels, "p_str_join_n");
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_push(&mut self.enc, PEIR_RBP);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBP, PEIR_RSP);
    PeirEnc_push(&mut self.enc, PEIR_R12); // vec
    PeirEnc_push(&mut self.enc, PEIR_R13); // element / total
    PeirEnc_push(&mut self.enc, PEIR_R14); // index
    PeirEnc_push(&mut self.enc, PEIR_R15); // vec len
    PeirEnc_sub_rsp_i32(&mut self.enc, 64);
    // Locals: [rbp-40] = result, [rbp-48] = write cursor, [rbp-56] = len.
    // Two passes, each element's length counted once by msvcrt strlen;
    // copies via memcpy to a running cursor (no result re-scan).
    var strlen_off: i64 = PeirGen_iat_off(self, pe_import_slot("strlen"));
    var memcpy_off: i64 = PeirGen_iat_off(self, pe_import_slot("memcpy"));
    // r12 = vec, r15 = vec->len
    PeirEnc_mov_rr(&mut self.enc, PEIR_R12, PEIR_RCX);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R15, PEIR_R12, 8);
    // Pass 1: total = 1 + sum(strlen(elem))
    PeirEnc_xor_self(&mut self.enc, PEIR_R14);
    PeirEnc_mov_imm32(&mut self.enc, PEIR_R13, 1);
    var sjn_len_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    var sjn_len_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, sjn_len_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R14, PEIR_R15);
    PeirEnc_jcc_label(&mut self.enc, 0x3, sjn_len_done); // jae
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 0); // data ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R14);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_RAX, 0); // elem ptr
    PeirEnc_call_rip(&mut self.enc, strlen_off);
    PeirEnc_add_rr(&mut self.enc, PEIR_R13, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, sjn_len_loop);
    PeirEnc_place_label(&mut self.enc, sjn_len_done);
    // result = cursor = malloc(total)
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "p_malloc"));
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -40, PEIR_RAX);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RAX);
    // Pass 2: memcpy each element to the cursor
    PeirEnc_xor_self(&mut self.enc, PEIR_R14);
    var sjn_cat_loop: i64 = PeirEnc_alloc_label(&mut self.enc);
    var sjn_cat_done: i64 = PeirEnc_alloc_label(&mut self.enc);
    PeirEnc_place_label(&mut self.enc, sjn_cat_loop);
    PeirEnc_cmp_rr(&mut self.enc, PEIR_R14, PEIR_R15);
    PeirEnc_jcc_label(&mut self.enc, 0x3, sjn_cat_done); // jae
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_R12, 0); // data ptr
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R14);
    PeirEnc_shl_r_i8(&mut self.enc, PEIR_RDX, 3);
    PeirEnc_add_rr(&mut self.enc, PEIR_RAX, PEIR_RDX);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R13, PEIR_RAX, 0); // r13 = elem
    PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_R13);
    PeirEnc_call_rip(&mut self.enc, strlen_off);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -56, PEIR_RAX); // elem len
    // memcpy(cursor, elem, len + 1) — +1 copies the NUL; overwritten by
    // the next element and re-written at the end
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, -48); // cursor
    PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_R13);
    PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RAX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R8);
    PeirEnc_call_rip(&mut self.enc, memcpy_off);
    // cursor += len
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RCX, -48);
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -56);
    PeirEnc_add_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
    PeirEnc_mov_mem_rbp_reg(&mut self.enc, -48, PEIR_RCX);
    PeirEnc_inc_r(&mut self.enc, PEIR_R14);
    PeirEnc_jmp_label(&mut self.enc, sjn_cat_loop);
    PeirEnc_place_label(&mut self.enc, sjn_cat_done);
    // Return result
    PeirEnc_mov_reg_mem_rbp(&mut self.enc, PEIR_RAX, -40);
    PeirEnc_add_rsp_i32(&mut self.enc, 64);
    PeirEnc_pop(&mut self.enc, PEIR_R15);
    PeirEnc_pop(&mut self.enc, PEIR_R14);
    PeirEnc_pop(&mut self.enc, PEIR_R13);
    PeirEnc_pop(&mut self.enc, PEIR_R12);
    PeirEnc_pop(&mut self.enc, PEIR_RBP);
    PeirEnc_ret(&mut self.enc);
}

// ===========================================================================
// Entry point, C thunks, PE primitives
// ===========================================================================

/// _main — Windows entry point
pub fn PeirGen_gen_entry_point(self: &mut PeirGen) -> void {
    self.entry_offset = PeirEnc_offset(&self.enc);

    if self.bare_mode {
        // Bare-metal entry: on whatever stack the loader set up, aligned
        // to 16 with the 32-byte shadow space main's calls expect
        PeirEnc_xor_rr(&mut self.enc, PEIR_RBP, PEIR_RBP);
        pe_emit4(&mut self.enc, 0x48, 0x83, 0xE4, 0xF0); // and rsp, -16
        PeirEnc_sub_rsp_i32(&mut self.enc, 32);

        if g_pe_elf {
            // The heap: 1 GB of address space, pages on first touch
            PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 9);         // SYS_mmap
            PeirEnc_xor_rr(&mut self.enc, PEIR_RDI, PEIR_RDI);
            PeirEnc_mov_imm64(&mut self.enc, PEIR_RSI, 0x40000000);
            PeirEnc_mov_imm32(&mut self.enc, PEIR_RDX, 3);         // PROT_READ | PROT_WRITE
            PeirEnc_mov_imm32(&mut self.enc, PEIR_R10, 0x4022);    // PRIVATE | ANONYMOUS | NORESERVE
            PeirEnc_mov_imm64(&mut self.enc, PEIR_R8, -1);
            PeirEnc_xor_rr(&mut self.enc, PEIR_R9, PEIR_R9);
            pe_emit2(&mut self.enc, 0x0F, 0x05);                   // syscall
            PeirEnc_mov_rip_reg(&mut self.enc, self.alloc_rdata_off, PEIR_RAX);
        }

        // Call main()
        var main_label: i64 = HashMap_get(self.func_labels, "main");
        PeirEnc_call_label(&mut self.enc, main_label);

        if g_pe_elf {
            // exit_group(main's result)
            PeirEnc_mov_rr(&mut self.enc, PEIR_RDI, PEIR_RAX);
            PeirEnc_mov_imm32(&mut self.enc, PEIR_RAX, 231);
            pe_emit2(&mut self.enc, 0x0F, 0x05);
        }

        // Halt loop: hlt; jmp -3 (back to hlt: interrupt handlers still run)
        pe_emit1(&mut self.enc, 0xF4);       // hlt
        pe_emit2(&mut self.enc, 0xEB, 0xFD); // jmp -3
    } else {
        // sub rsp, 40 (32 shadow space + 8 for alignment)
        PeirEnc_sub_rsp_i32(&mut self.enc, 40);

        // CPU faults become panics with a message
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 1);
        PeirEnc_lea_label(&mut self.enc, PEIR_RDX, self.crash_filter);
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, pe_import_slot("AddVectoredExceptionHandler")));

        // The `link` DLLs, before anything can call into them
        if HashMap_contains(self.func_labels, "__pe_load_dlls") {
            PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, "__pe_load_dlls"));
        }

        // Call main()
        var main_label2: i64 = HashMap_get(self.func_labels, "main");
        PeirEnc_call_label(&mut self.enc, main_label2);

        // ExitProcess(rax) — use return value from main as exit code
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RAX);
        PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_EXIT_PROCESS));

        PeirEnc_ud2(&mut self.enc);
    }
}

// A stub a C call lands on when its DLL or function is missing: print the
// message at .rdata offset `msg_off` to stderr and exit with 1.
fn PeirGen_dll_fail(self: &mut PeirGen, label: i64, msg_off: i64) -> void {
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, label);
    PeirEnc_sub_rsp_i32(&mut self.enc, 40); // called: realign, shadow space
    PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, msg_off);
    PeirGen_call_runtime(self, "p_eprint_str");
    PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, 1);
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, PIAT_EXIT_PROCESS));
    PeirEnc_ud2(&mut self.enc);
}

/// Start-up loader of the `link` DLLs (release E2, E4), `__pe_load_dlls`:
/// LoadLibraryA each DLL (its candidates in order: sqlite3.dll, then the
/// system's winsqlite3.dll), GetProcAddress each function the program
/// reaches into its IAT slot. A DLL or function that is not there gets a
/// stub instead: the first call into it stops the program with a message
/// naming what is missing (a static import would make Windows refuse to
/// start the program at all, with no message on a console), and a program
/// that never calls it runs.
pub fn PeirGen_gen_dll_loader(self: &mut PeirGen, rdata: &mut PeirRdata) -> void {
    var dlls: Vec<PeDllImport> = pe_dll_imports();
    if self.bare_mode || dlls.len() <= PE_STATIC_DLLS { return; }
    var label: i64 = PeirEnc_alloc_label(&mut self.enc);
    HashMap_insert(self.func_labels, "__pe_load_dlls", label);
    PeirEnc_align_to(&mut self.enc, 16);
    PeirEnc_place_label(&mut self.enc, label);
    // rsp = 8 (mod 16) on entry: rbx and the shadow space realign it
    PeirEnc_push(&mut self.enc, PEIR_RBX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    var load_lib: i64 = PeirGen_iat_off(self, pe_import_slot("LoadLibraryA"));
    var get_proc: i64 = PeirGen_iat_off(self, pe_import_slot("GetProcAddress"));
    // The failure stubs, generated after the loader: (label, message)
    var fail_labels: Vec<i64> = Vec::new();
    var fail_msgs: Vec<i64> = Vec::new();
    var slot_base: i64 = 0;
    var d: i64 = 0;
    while d < dlls.len() {
        var names: Vec<str> = dlls.get(d).names;
        if d >= PE_STATIC_DLLS {
            var dll: str = dlls.get(d).dll;
            var loaded: i64 = PeirEnc_alloc_label(&mut self.enc);
            var next_dll: i64 = PeirEnc_alloc_label(&mut self.enc);
            var cands: Vec<str> = pe_link_dll_candidates(dll);
            var also: str = "";
            var ci: i64 = 0;
            while ci < cands.len() {
                PeirEnc_lea_rip(&mut self.enc, PEIR_RCX, PeirRdata_add_string(rdata, cands.get(ci)));
                PeirEnc_call_rip(&mut self.enc, load_lib);
                PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                PeirEnc_jcc_label(&mut self.enc, 0x5, loaded); // jne
                if ci > 0 { also = also + " or " + cands.get(ci); }
                ci = ci + 1;
            }
            // Not there: every function of it calls the DLL's stub
            var msg: str = "error: this program needs " + dll + also + ", which Windows could not load.\n"
                + "  Install the library, or put " + dll + " beside the program or in a folder on PATH.\n";
            var dll_stub: i64 = PeirEnc_alloc_label(&mut self.enc);
            fail_labels.push(dll_stub);
            fail_msgs.push(PeirRdata_add_string(rdata, msg));
            PeirEnc_lea_label(&mut self.enc, PEIR_RAX, dll_stub);
            var k: i64 = 0;
            while k < names.len() {
                PeirEnc_mov_rip_reg(&mut self.enc, PeirGen_iat_off(self, slot_base + k), PEIR_RAX);
                k = k + 1;
            }
            PeirEnc_jmp_label(&mut self.enc, next_dll);
            PeirEnc_place_label(&mut self.enc, loaded);
            PeirEnc_mov_rr(&mut self.enc, PEIR_RBX, PEIR_RAX);
            var j: i64 = 0;
            while j < names.len() {
                var found: i64 = PeirEnc_alloc_label(&mut self.enc);
                PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RBX);
                PeirEnc_lea_rip(&mut self.enc, PEIR_RDX, PeirRdata_add_string(rdata, names.get(j)));
                PeirEnc_call_rip(&mut self.enc, get_proc);
                PeirEnc_test_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
                PeirEnc_jcc_label(&mut self.enc, 0x5, found); // jne
                var nmsg: str = "error: " + dll + " has no function " + names.get(j)
                    + " (another version of the library?)\n";
                var fn_stub: i64 = PeirEnc_alloc_label(&mut self.enc);
                fail_labels.push(fn_stub);
                fail_msgs.push(PeirRdata_add_string(rdata, nmsg));
                PeirEnc_lea_label(&mut self.enc, PEIR_RAX, fn_stub);
                PeirEnc_place_label(&mut self.enc, found);
                PeirEnc_mov_rip_reg(&mut self.enc, PeirGen_iat_off(self, slot_base + j), PEIR_RAX);
                j = j + 1;
            }
            PeirEnc_place_label(&mut self.enc, next_dll);
        }
        slot_base = slot_base + names.len();
        d = d + 1;
    }
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_RBX);
    PeirEnc_ret(&mut self.enc);
    var fi: i64 = 0;
    while fi < fail_labels.len() {
        PeirGen_dll_fail(self, fail_labels.get(fi), fail_msgs.get(fi));
        fi = fi + 1;
    }
}

/// A thunk from the Fides convention (arguments in rcx, rdx, r8, r9 and
/// then the stack, floats as raw bits in integer registers, the result
/// in rax) to a C function of the import table (float arguments in
/// xmm0-3, a float result in xmm0, an `int` result in eax).
// Replace the pointer in register `n` (rax, rcx, rdx, r8 or r9) by the struct
// of `size` bytes it points at; 0 leaves it.
fn PeirGen_load_by_value(self: &mut PeirGen, n: i64, size: i64) -> void {
    var rex: i64 = 0x40;
    if n >= 8 { rex = 0x45; }
    var modrm: i64 = ((n & 7) << 3) | (n & 7);
    if size == 8 {
        pe_emit3(&mut self.enc, rex | 8, 0x8B, modrm);
    } else if size == 4 {
        pe_emit3(&mut self.enc, rex, 0x8B, modrm);
    } else if size == 2 {
        pe_emit4(&mut self.enc, rex, 0x0F, 0xB7, modrm);
    } else if size == 1 {
        pe_emit4(&mut self.enc, rex, 0x0F, 0xB6, modrm);
    }
}

// Widen the C argument in register `n`, whose upper bits are undefined.
fn PeirGen_widen_c_arg(self: &mut PeirGen, n: i64, ty: IrType) -> void {
    var rex: i64 = 0x40;
    if n >= 8 { rex = 0x45; }
    var modrm: i64 = 0xC0 | ((n & 7) << 3) | (n & 7);
    match ty {
        IrType::I32 => { pe_emit3(&mut self.enc, rex | 8, 0x63, modrm); }
        IrType::U32 => { pe_emit3(&mut self.enc, rex, 0x8B, modrm); }
        IrType::I16 => { pe_emit4(&mut self.enc, rex | 8, 0x0F, 0xBF, modrm); }
        IrType::U16 => { pe_emit4(&mut self.enc, rex, 0x0F, 0xB7, modrm); }
        IrType::I8 => { pe_emit4(&mut self.enc, rex | 8, 0x0F, 0xBE, modrm); }
        IrType::U8 => { pe_emit4(&mut self.enc, rex, 0x0F, 0xB6, modrm); }
        IrType::Bool => { pe_emit4(&mut self.enc, rex, 0x0F, 0xB6, modrm); }
        _ => {}
    }
}

pub fn PeirGen_gen_c_adapter(self: &mut PeirGen, a: &CAdapter) -> void {
    PeirGen_place_fn(self, a.name);
    var n: i64 = a.params.len();
    // The fourth C argument moves to the stack: `__env` takes rcx
    var stack_args: i64 = n + 1 - 4;
    if stack_args < 0 { stack_args = 0; }
    // On entry rsp = 8 (mod 16): the frame realigns it for the call
    var frame: i64 = 32 + 8 * stack_args;
    if frame % 16 == 0 {
        frame = frame + 8;
    }
    PeirEnc_sub_rsp_i32(&mut self.enc, frame);
    var regs: Vec<i64> = Vec::new();
    regs.push(PEIR_RCX); regs.push(PEIR_RDX); regs.push(PEIR_R8); regs.push(PEIR_R9);
    var i: i64 = 0;
    while i < n && i < 4 {
        var r: i64 = regs.get(i);
        var rex: i64 = 0x48;
        if r >= 8 { rex = 0x49; }
        var modrm: i64 = 0xC0 | (i << 3) | (r & 7);
        var ty: IrType = a.params.get(i);
        match ty {
            // movq r, xmm_i
            IrType::F64 => { pe_emit5(&mut self.enc, 0x66, rex, 0x0F, 0x7E, modrm); }
            // movd r32, xmm_i
            IrType::F32 => { pe_emit5(&mut self.enc, 0x66, rex & 0x41, 0x0F, 0x7E, modrm); }
            _ => { PeirGen_widen_c_arg(self, r, ty); }
        }
        i = i + 1;
    }
    i = 4;
    while i < n {
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, frame + 8 + 32 + 8 * (i - 4));
        PeirGen_widen_c_arg(self, 0, a.params.get(i));
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32 + 8 * (i - 3), PEIR_RAX);
        i = i + 1;
    }
    if n >= 4 {
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_R9);
    }
    pe_emit3(&mut self.enc, 0x4D, 0x89, 0xC1); // mov r9, r8
    pe_emit3(&mut self.enc, 0x49, 0x89, 0xD0); // mov r8, rdx
    pe_emit3(&mut self.enc, 0x48, 0x89, 0xCA); // mov rdx, rcx
    pe_emit2(&mut self.enc, 0x31, 0xC9);       // xor ecx, ecx
    PeirEnc_call_label(&mut self.enc, HashMap_get(self.func_labels, a.target));
    match a.ret {
        IrType::F64 => { pe_emit5(&mut self.enc, 0x66, 0x48, 0x0F, 0x6E, 0xC0); } // movq xmm0, rax
        IrType::F32 => { pe_emit4(&mut self.enc, 0x66, 0x0F, 0x6E, 0xC0); }       // movd xmm0, eax
        _ => {}
    }
    PeirEnc_add_rsp_i32(&mut self.enc, frame);
    PeirEnc_ret(&mut self.enc);
}

pub fn PeirGen_gen_c_thunk(self: &mut PeirGen, t: &CThunk) -> void {
    PeirGen_place_fn(self, t.name);
    var n: i64 = t.params.len();
    var stack_args: i64 = n - 4;
    if stack_args < 0 { stack_args = 0; }
    // A struct C returns in rax: the result pointer Fides passes first
    // waits in the frame, and the arguments move down one place
    var shift: i64 = 0;
    if t.ret_size > 0 { shift = 1; }
    var ret_slot: i64 = 32 + 8 * stack_args;
    // On entry rsp = 8 (mod 16): the frame realigns it for the call
    var frame: i64 = ret_slot + 8 * shift;
    if frame % 16 == 0 {
        frame = frame + 8;
    }
    PeirEnc_sub_rsp_i32(&mut self.enc, frame);
    if shift > 0 {
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, ret_slot, PEIR_RCX);
    }
    var i: i64 = 0;
    while i < stack_args {
        // The caller's fifth and later arguments: above our frame and
        // the return address, past the caller's 32-byte shadow space
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSP, frame + 8 + 32 + 8 * (i + shift));
        PeirGen_load_by_value(self, 0, t.by_value.get(4 + i));
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32 + 8 * i, PEIR_RAX);
        i = i + 1;
    }
    if shift > 0 {
        pe_emit3(&mut self.enc, 0x48, 0x89, 0xD1); // mov rcx, rdx
        pe_emit3(&mut self.enc, 0x4C, 0x89, 0xC2); // mov rdx, r8
        pe_emit3(&mut self.enc, 0x4D, 0x89, 0xC8); // mov r8, r9
        if n >= 4 {
            PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R9, PEIR_RSP, frame + 8 + 32);
        }
    }
    var regs: Vec<i64> = Vec::new();
    regs.push(PEIR_RCX); regs.push(PEIR_RDX); regs.push(PEIR_R8); regs.push(PEIR_R9);
    var np: i64 = t.params.len();
    if np > 4 { np = 4; }
    i = 0;
    while i < np {
        PeirGen_load_by_value(self, regs.get(i), t.by_value.get(i));
        var ty: IrType = t.params.get(i);
        match ty {
            // The integer register keeps its copy: a variadic function
            // (_snprintf) reads a double from there
            IrType::F64 => { PeirEnc_movq_xmm_r64(&mut self.enc, i, regs.get(i)); }
            IrType::F32 => {
                // movd xmm_i, r32
                PeirEnc_emit_u8(&mut self.enc, 0x66);
                if reg_ext(regs.get(i)) {
                    PeirEnc_emit_u8(&mut self.enc, 0x41);
                }
                pe_emit2(&mut self.enc, 0x0F, 0x6E);
                PeirEnc_modrm(&mut self.enc, 3, i, peir_reg_code(regs.get(i)));
            }
            _ => {}
        }
        i = i + 1;
    }
    PeirEnc_call_rip(&mut self.enc, PeirGen_iat_off(self, t.slot));
    match t.ret {
        IrType::F64 => {
            // movq rax, xmm0
            pe_emit5(&mut self.enc, 0x66, 0x48, 0x0F, 0x7E, 0xC0);
        }
        IrType::F32 => {
            // movd eax, xmm0
            pe_emit4(&mut self.enc, 0x66, 0x0F, 0x7E, 0xC0);
        }
        IrType::I32 => {
            // movsxd rax, eax
            pe_emit3(&mut self.enc, 0x48, 0x63, 0xC0);
        }
        IrType::U32 => {
            // mov eax, eax
            pe_emit2(&mut self.enc, 0x89, 0xC0);
        }
        IrType::I16 => {
            // movsx rax, ax
            pe_emit4(&mut self.enc, 0x48, 0x0F, 0xBF, 0xC0);
        }
        IrType::U16 => {
            // movzx eax, ax
            pe_emit3(&mut self.enc, 0x0F, 0xB7, 0xC0);
        }
        IrType::I8 => {
            // movsx rax, al
            pe_emit4(&mut self.enc, 0x48, 0x0F, 0xBE, 0xC0);
        }
        IrType::U8 => {
            // movzx eax, al
            pe_emit3(&mut self.enc, 0x0F, 0xB6, 0xC0);
        }
        // A C truth value is any non-zero int
        IrType::Bool => {
            // test eax, eax; sete al; movzx eax, al
            pe_emit8(&mut self.enc, 0x85, 0xC0, 0x0F, 0x95, 0xC0, 0x0F, 0xB6, 0xC0);
        }
        _ => {}
    }
    if shift > 0 {
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RCX, PEIR_RSP, ret_slot);
        if t.ret_size == 8 {
            pe_emit3(&mut self.enc, 0x48, 0x89, 0x01); // mov [rcx], rax
        } else if t.ret_size == 4 {
            pe_emit2(&mut self.enc, 0x89, 0x01);       // mov [rcx], eax
        } else if t.ret_size == 2 {
            pe_emit3(&mut self.enc, 0x66, 0x89, 0x01); // mov [rcx], ax
        } else {
            pe_emit2(&mut self.enc, 0x88, 0x01);       // mov [rcx], al
        }
    }
    PeirEnc_add_rsp_i32(&mut self.enc, frame);
    PeirEnc_ret(&mut self.enc);
}

/// The machine-code primitives of the Fides PE runtime (PE_PRIMITIVES),
/// and the stubs that hand over to it (PE_STUB_DEPS).
pub fn PeirGen_gen_pe_primitives(self: &mut PeirGen) -> void {
    // pe_atomic_load(addr) -> i64: an aligned 8-byte load is atomic
    PeirGen_place_fn(self, "pe_atomic_load");
    // mov rax, [rcx]; ret
    pe_emit4(&mut self.enc, 0x48, 0x8B, 0x01, 0xC3);
    // pe_atomic_store(addr, v): xchg locks and is a full barrier
    PeirGen_place_fn(self, "pe_atomic_store");
    // xchg [rcx], rdx; ret
    pe_emit4(&mut self.enc, 0x48, 0x87, 0x11, 0xC3);
    // pe_atomic_add(addr, v) -> previous value
    PeirGen_place_fn(self, "pe_atomic_add");
    // mov rax, rdx
    pe_emit3(&mut self.enc, 0x48, 0x89, 0xD0);
    // lock xadd [rcx], rax; ret
    pe_emit6(&mut self.enc, 0xF0, 0x48, 0x0F, 0xC1, 0x01, 0xC3);
    // pe_atomic_cas(addr, expected, new) -> bool (swapped)
    PeirGen_place_fn(self, "pe_atomic_cas");
    // mov rax, rdx
    pe_emit3(&mut self.enc, 0x48, 0x89, 0xD0);
    // lock cmpxchg [rcx], r8
    pe_emit5(&mut self.enc, 0xF0, 0x4C, 0x0F, 0xB1, 0x01);
    // sete al; movzx eax, al; ret
    pe_emit6(&mut self.enc, 0x0F, 0x94, 0xC0, 0x0F, 0xB6, 0xC0);
    pe_emit1(&mut self.enc, 0xC3);
    // pe_f64_to_bits / pe_bits_to_f64: Fides passes a float as its bits
    var bits: i64 = HashMap_get(self.func_labels, "pe_bits_to_f64");
    PeirGen_place_fn(self, "pe_f64_to_bits");
    PeirEnc_place_label(&mut self.enc, bits);
    // mov rax, rcx; ret
    pe_emit4(&mut self.enc, 0x48, 0x89, 0xC8, 0xC3);
    // pe_f64_to_f32_bits(x) -> the bits of (f32)x
    PeirGen_place_fn(self, "pe_f64_to_f32_bits");
    PeirEnc_movq_xmm_r64(&mut self.enc, 0, PEIR_RCX);
    // cvtsd2ss xmm0, xmm0
    pe_emit4(&mut self.enc, 0xF2, 0x0F, 0x5A, 0xC0);
    // movd eax, xmm0; ret
    pe_emit5(&mut self.enc, 0x66, 0x0F, 0x7E, 0xC0, 0xC3);
    // pe_f32_bits_to_f64(bits) -> (f64) of the f32 with those bits
    PeirGen_place_fn(self, "pe_f32_bits_to_f64");
    // movd xmm0, ecx
    pe_emit4(&mut self.enc, 0x66, 0x0F, 0x6E, 0xC1);
    // cvtss2sd xmm0, xmm0
    pe_emit4(&mut self.enc, 0xF3, 0x0F, 0x5A, 0xC0);
    // movq rax, xmm0; ret
    pe_emit5(&mut self.enc, 0x66, 0x48, 0x0F, 0x7E, 0xC0);
    pe_emit1(&mut self.enc, 0xC3);

    // pe_fn_lookup(name) -> the address of the program function of that
    // name (one named by a string constant), or 0
    PeirGen_place_fn(self, "pe_fn_lookup");
    PeirEnc_push(&mut self.enc, PEIR_RBX);
    PeirEnc_sub_rsp_i32(&mut self.enc, 32);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBX, PEIR_RCX);
    var done: i64 = PeirEnc_alloc_label(&mut self.enc);
    var strcmp: i64 = PeirGen_iat_off(self, pe_import_slot("strcmp"));
    var fi: i64 = 0;
    while fi < self.named_fns.len() {
        var f: str = self.named_fns.get(fi);
        var next: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RCX, PEIR_RBX);
        var off: i64 = PeirGen_str_off(self, f);
        PeirEnc_lea_rip(&mut self.enc, PEIR_RDX, off);
        PeirEnc_call_rip(&mut self.enc, strcmp);
        pe_emit2(&mut self.enc, 0x85, 0xC0); // test eax, eax
        PeirEnc_jcc_label(&mut self.enc, 0x5, next); // jne
        var flabel: i64 = HashMap_get(self.func_labels, f);
        PeirEnc_lea_label(&mut self.enc, PEIR_RAX, flabel);
        PeirEnc_jmp_label(&mut self.enc, done);
        PeirEnc_place_label(&mut self.enc, next);
        fi = fi + 1;
    }
    PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
    PeirEnc_place_label(&mut self.enc, done);
    PeirEnc_add_rsp_i32(&mut self.enc, 32);
    PeirEnc_pop(&mut self.enc, PEIR_RBX);
    PeirEnc_ret(&mut self.enc);

    // pe_call_fn(addr, nargs, argv) -> result: call the Fides function at
    // addr with a null __env and argv[0..8] (argv has 8 slots; the
    // function reads the ones it has parameters for)
    PeirGen_place_fn(self, "pe_call_fn");
    PeirEnc_push(&mut self.enc, PEIR_RBX);
    PeirEnc_push(&mut self.enc, PEIR_RSI);
    PeirEnc_sub_rsp_i32(&mut self.enc, 72); // 8 + 16 + 72: aligned
    PeirEnc_mov_rr(&mut self.enc, PEIR_RBX, PEIR_RCX);
    PeirEnc_mov_rr(&mut self.enc, PEIR_RSI, PEIR_R8);
    var ai: i64 = 3;
    while ai < 8 {
        // argv[i] is parameter i + 1 (after __env): a stack argument
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RAX, PEIR_RSI, 8 * ai);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32 + 8 * (ai - 3), PEIR_RAX);
        ai = ai + 1;
    }
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_RSI, 0);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R8, PEIR_RSI, 8);
    PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_R9, PEIR_RSI, 16);
    PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
    PeirEnc_call_reg(&mut self.enc, PEIR_RBX);
    PeirEnc_add_rsp_i32(&mut self.enc, 72);
    PeirEnc_pop(&mut self.enc, PEIR_RSI);
    PeirEnc_pop(&mut self.enc, PEIR_RBX);
    PeirEnc_ret(&mut self.enc);

    // The thread start routine (C convention: rcx = the argument) runs
    // pert_thread_main(arg); Windows expects the callee-saved registers
    // back. pe_thread_entry_addr() gives its address for CreateThread.
    if HashMap_contains(self.func_labels, "pe_thread_entry_addr") {
        var entry: i64 = PeirEnc_alloc_label(&mut self.enc);
        PeirEnc_align_to(&mut self.enc, 16);
        PeirEnc_place_label(&mut self.enc, entry);
        var saved: Vec<i64> = Vec::new();
        saved.push(PEIR_RBX); saved.push(PEIR_RSI); saved.push(PEIR_RDI);
        saved.push(PEIR_R12); saved.push(PEIR_R13); saved.push(PEIR_R14);
        saved.push(PEIR_R15); saved.push(PEIR_RBP);
        var ri: i64 = 0;
        while ri < saved.len() {
            PeirEnc_push(&mut self.enc, saved.get(ri));
            ri = ri + 1;
        }
        PeirEnc_sub_rsp_i32(&mut self.enc, 40); // 8 + 64 + 40: aligned
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        PeirGen_call_runtime(self, "pert_thread_main");
        PeirEnc_add_rsp_i32(&mut self.enc, 40);
        ri = saved.len() - 1;
        while ri >= 0 {
            PeirEnc_pop(&mut self.enc, saved.get(ri));
            ri = ri - 1;
        }
        PeirEnc_ret(&mut self.enc);
        PeirGen_place_fn(self, "pe_thread_entry_addr");
        PeirEnc_lea_label(&mut self.enc, PEIR_RAX, entry);
        PeirEnc_ret(&mut self.enc);
    }

    // p_thread_spawn(name, nargs, args...): varargs. The first two
    // arguments go to the caller's shadow slots, next to the ones on
    // the stack: one array, handed to pert_thread_spawn_v(name, nargs,
    // argv) (still inside the caller's frame while it runs).
    if HashMap_contains(self.func_labels, "p_thread_spawn") {
        PeirGen_place_fn(self, "p_thread_spawn");
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 24, PEIR_R8);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_R9);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RDX);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        // lea r9, [rsp+24]
        pe_emit5(&mut self.enc, 0x4C, 0x8D, 0x4C, 0x24, 0x18);
        var target: i64 = HashMap_get(self.func_labels, "pert_thread_spawn_v");
        PeirEnc_jmp_label(&mut self.enc, target);
    }
    // p_co_async(name, nargs, args...): likewise
    if HashMap_contains(self.func_labels, "p_co_async") {
        PeirGen_place_fn(self, "p_co_async");
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 24, PEIR_R8);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_R9);
        PeirEnc_mov_rr(&mut self.enc, PEIR_R8, PEIR_RDX);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDX, PEIR_RCX);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        pe_emit5(&mut self.enc, 0x4C, 0x8D, 0x4C, 0x24, 0x18); // lea r9, [rsp+24]
        PeirEnc_jmp_label(&mut self.enc, HashMap_get(self.func_labels, "pert_co_async_v"));
    }
    // p_executor_spawn(exec, name, nargs, args...): likewise, from the
    // fourth argument; pert_executor_spawn_v(name, nargs, argv)
    if HashMap_contains(self.func_labels, "p_executor_spawn") {
        PeirGen_place_fn(self, "p_executor_spawn");
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RSP, 32, PEIR_R9);
        PeirEnc_xor_rr(&mut self.enc, PEIR_RCX, PEIR_RCX);
        // lea r9, [rsp+32]
        pe_emit5(&mut self.enc, 0x4C, 0x8D, 0x4C, 0x24, 0x20);
        var target2: i64 = HashMap_get(self.func_labels, "pert_executor_spawn_v");
        PeirEnc_jmp_label(&mut self.enc, target2);
    }
}

/// Copy `size` bytes from [rcx] to [rax] (clobbers rax, rcx, rdx):
/// 8 bytes at a time, then single bytes, never past `size`.
pub fn PeirGen_emit_copy_rcx_to_rax(self: &mut PeirGen, size: i64) -> void {
    if size >= 128 {
        // Large copies: rep movsq + rep movsb tail. 16x smaller code than
        // the unrolled loop below; rsi/rdi are callee-saved, so they are
        // preserved (some emitted frames keep live values in them).
        PeirEnc_push(&mut self.enc, PEIR_RSI);
        PeirEnc_push(&mut self.enc, PEIR_RDI);
        PeirEnc_mov_rr(&mut self.enc, PEIR_RSI, PEIR_RCX); // src
        PeirEnc_mov_rr(&mut self.enc, PEIR_RDI, PEIR_RAX); // dst
        PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, size / 8);
        var movsq: Vec<i64> = Vec::new();
        movsq.push(0xF3);
        movsq.push(0x48);
        movsq.push(0xA5);
        PeirEnc_emit(&mut self.enc, movsq); // rep movsq
        var tail: i64 = size % 8;
        if tail > 0 {
            PeirEnc_mov_imm32(&mut self.enc, PEIR_RCX, tail);
            var movsb: Vec<i64> = Vec::new();
            movsb.push(0xF3);
            movsb.push(0xA4);
            PeirEnc_emit(&mut self.enc, movsb); // rep movsb
        }
        PeirEnc_pop(&mut self.enc, PEIR_RDI);
        PeirEnc_pop(&mut self.enc, PEIR_RSI);
        return;
    }
    var offset: i64 = 0;
    while offset + 8 <= size {
        PeirEnc_mov_reg_mem_disp(&mut self.enc, PEIR_RDX, PEIR_RCX, offset);
        PeirEnc_mov_mem_disp_reg(&mut self.enc, PEIR_RAX, offset, PEIR_RDX);
        offset = offset + 8;
    }
    if offset < size {
        PeirEnc_add_r_i32(&mut self.enc, PEIR_RCX, offset);
        PeirEnc_add_r_i32(&mut self.enc, PEIR_RAX, offset);
        while offset < size {
            PeirEnc_mov_reg8_mem(&mut self.enc, PEIR_RDX, PEIR_RCX);
            PeirEnc_mov_mem_reg8(&mut self.enc, PEIR_RAX, PEIR_RDX);
            PeirEnc_add_r_i8(&mut self.enc, PEIR_RCX, 1);
            PeirEnc_add_r_i8(&mut self.enc, PEIR_RAX, 1);
            offset = offset + 1;
        }
    }
}

/// p_arena_save -> 0, p_arena_restore / p_region_free: no-ops.  Heap
/// memory here is never reused, so there is nothing to give back (as in
/// the interpreter).
pub fn PeirGen_gen_arena_stubs(self: &mut PeirGen) -> void {
    var names: Vec<str> = Vec::new();
    names.push("p_arena_save");      // returns_zero = true
    names.push("p_arena_restore");   // returns_zero = false
    names.push("p_region_free");     // returns_zero = false
    var i: i64 = 0;
    while i < names.len() {
        var name: str = names.get(i);
        if HashMap_contains(self.func_labels, name) {
            var label: i64 = HashMap_get(self.func_labels, name);
            PeirEnc_place_label(&mut self.enc, label);
            if i == 0 {
                PeirEnc_xor_rr(&mut self.enc, PEIR_RAX, PEIR_RAX);
            }
            PeirEnc_ret(&mut self.enc);
        }
        i = i + 1;
    }
}

// ===========================================================================
// asm!() in bare builds (release G2): Intel-syntax templates encoded here.
// One instruction per `;` or line. What is covered: the system and fence
// instructions, port I/O, control registers, register-register ALU, mov
// of an immediate, push/pop, inc/dec/neg/not, int N, and lgdt/lidt/invlpg
// through a register. Anything else is a compile error naming it.
// ===========================================================================

pub struct PeAsmOut {
    pub b: Vec<i64>,
}

pub struct PeAsmResult {
    pub bytes: Vec<i64>,
    pub error: str,
}

/// 64-bit register number of `s` (rax=0 .. r15=15), else -1.
pub fn pe_asm_reg64(s: str) -> i64 {
    var names: Vec<str> = Vec::new();
    names.push("rax"); names.push("rcx"); names.push("rdx"); names.push("rbx");
    names.push("rsp"); names.push("rbp"); names.push("rsi"); names.push("rdi");
    names.push("r8"); names.push("r9"); names.push("r10"); names.push("r11");
    names.push("r12"); names.push("r13"); names.push("r14"); names.push("r15");
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == s { return i; }
        i = i + 1;
    }
    return -1;
}

/// Control register number of `s` (cr0, cr2, cr3, cr4, cr8), else -1.
fn pe_asm_cr(s: str) -> i64 {
    if s == "cr0" { return 0; }
    if s == "cr2" { return 2; }
    if s == "cr3" { return 3; }
    if s == "cr4" { return 4; }
    if s == "cr8" { return 8; }
    return -1;
}

fn pe_asm_digit(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48; }
    if c >= 97 && c <= 102 { return c - 87; }
    return -1;
}

/// Is `s` a number (decimal, 0x hex, or a trailing-h hex)?
fn pe_asm_is_num(s: str) -> bool {
    var t: str = s;
    if str_starts_with(t, "-") { t = str_slice(t, 1, str_len(t)); }
    if str_len(t) == 0 { return false; }
    var base: i64 = 10;
    if str_starts_with(t, "0x") { t = str_slice(t, 2, str_len(t)); base = 16; }
    else if str_ends_with(t, "h") { t = str_slice(t, 0, str_len(t) - 1); base = 16; }
    if str_len(t) == 0 { return false; }
    var i: i64 = 0;
    while i < str_len(t) {
        var d: i64 = pe_asm_digit(str_byte_at(t, i));
        if d < 0 || d >= base { return false; }
        i = i + 1;
    }
    return true;
}

fn pe_asm_num(s: str) -> i64 {
    var t: str = s;
    var neg: bool = false;
    if str_starts_with(t, "-") { t = str_slice(t, 1, str_len(t)); neg = true; }
    var base: i64 = 10;
    if str_starts_with(t, "0x") { t = str_slice(t, 2, str_len(t)); base = 16; }
    else if str_ends_with(t, "h") { t = str_slice(t, 0, str_len(t) - 1); base = 16; }
    var v: i64 = 0;
    var i: i64 = 0;
    while i < str_len(t) {
        v = v * base + pe_asm_digit(str_byte_at(t, i));
        i = i + 1;
    }
    if neg { return 0 - v; }
    return v;
}

fn pe_asm_push4(o: &mut PeAsmOut, x: i64) {
    o.b.push(x & 0xFF); o.b.push((x >> 8) & 0xFF); o.b.push((x >> 16) & 0xFF); o.b.push((x >> 24) & 0xFF);
}

/// REX for reg field `r` and r/m `b` (W set when `w`); 0 when none is needed.
fn pe_asm_rex(w: bool, r: i64, b: i64) -> i64 {
    var x: i64 = 0x40;
    if w { x = x | 8; }
    if r >= 8 { x = x | 4; }
    if b >= 8 { x = x | 1; }
    if x == 0x40 { return 0; }
    return x;
}

/// [reg] memory operand: the register, else -1.
fn pe_asm_mem_reg(s: str) -> i64 {
    var t: str = s;
    if str_starts_with(t, "qword ptr ") { t = str_trim(str_slice(t, 10, str_len(t))); }
    if !str_starts_with(t, "[") || !str_ends_with(t, "]") { return -1; }
    return pe_asm_reg64(str_trim(str_slice(t, 1, str_len(t) - 1)));
}

/// opcode bytes `op` with ModRM reg field `ext` and memory operand [r].
fn pe_asm_mem_op(o: &mut PeAsmOut, op: Vec<i64>, ext: i64, r: i64) {
    var rex: i64 = pe_asm_rex(false, 0, r);
    if rex != 0 { o.b.push(rex); }
    var i: i64 = 0;
    while i < op.len() { o.b.push(op.get(i)); i = i + 1; }
    var low: i64 = r & 7;
    if low == 5 {
        o.b.push(0x40 | (ext << 3) | 5); o.b.push(0); // [rbp/r13 + 0]
    } else if low == 4 {
        o.b.push((ext << 3) | 4); o.b.push(0x24);     // SIB: [rsp/r12]
    } else {
        o.b.push((ext << 3) | low);
    }
}

fn pe_asm_fixed(m: str) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    if m == "nop" { v.push(0x90); }
    else if m == "cli" { v.push(0xFA); }
    else if m == "sti" { v.push(0xFB); }
    else if m == "hlt" { v.push(0xF4); }
    else if m == "pause" { v.push(0xF3); v.push(0x90); }
    else if m == "mfence" { v.push(0x0F); v.push(0xAE); v.push(0xF0); }
    else if m == "sfence" { v.push(0x0F); v.push(0xAE); v.push(0xF8); }
    else if m == "lfence" { v.push(0x0F); v.push(0xAE); v.push(0xE8); }
    else if m == "cld" { v.push(0xFC); }
    else if m == "std" { v.push(0xFD); }
    else if m == "leave" { v.push(0xC9); }
    else if m == "ret" { v.push(0xC3); }
    else if m == "iretq" { v.push(0x48); v.push(0xCF); }
    else if m == "int3" { v.push(0xCC); }
    else if m == "wbinvd" { v.push(0x0F); v.push(0x09); }
    else if m == "invd" { v.push(0x0F); v.push(0x08); }
    else if m == "rdmsr" { v.push(0x0F); v.push(0x32); }
    else if m == "wrmsr" { v.push(0x0F); v.push(0x30); }
    else if m == "cpuid" { v.push(0x0F); v.push(0xA2); }
    else if m == "rdtsc" { v.push(0x0F); v.push(0x31); }
    else if m == "swapgs" { v.push(0x0F); v.push(0x01); v.push(0xF8); }
    else if m == "syscall" { v.push(0x0F); v.push(0x05); }
    else if m == "sysretq" { v.push(0x48); v.push(0x0F); v.push(0x07); }
    else if m == "ud2" { v.push(0x0F); v.push(0x0B); }
    else if m == "pushfq" { v.push(0x9C); }
    else if m == "popfq" { v.push(0x9D); }
    else if m == "clts" { v.push(0x0F); v.push(0x06); }
    return v;
}

/// Encode one instruction into `out`; "" or the reason it is not supported.
fn pe_asm_one(o: &mut PeAsmOut, line: str) -> str {
    var s: str = str_trim(str_to_lower(line));
    if str_len(s) == 0 { return ""; }
    var sp: i64 = 0;
    while sp < str_len(s) && str_byte_at(s, sp) != 32 && str_byte_at(s, sp) != 9 { sp = sp + 1; }
    var m: str = str_slice(s, 0, sp);
    var rest: str = str_trim(str_slice(s, sp, str_len(s)));
    var ops: Vec<str> = Vec::new();
    if str_len(rest) > 0 {
        var parts: Vec<str> = str_split(rest, ",");
        var pi: i64 = 0;
        while pi < parts.len() { ops.push(str_trim(parts.get(pi))); pi = pi + 1; }
    }
    if ops.len() == 0 {
        var f: Vec<i64> = pe_asm_fixed(m);
        if f.len() == 0 { return "unknown instruction"; }
        var fi: i64 = 0;
        while fi < f.len() { o.b.push(f.get(fi)); fi = fi + 1; }
        return "";
    }
    if m == "int" && ops.len() == 1 && pe_asm_is_num(ops.get(0)) {
        o.b.push(0xCD); o.b.push(pe_asm_num(ops.get(0)) & 0xFF);
        return "";
    }
    if m == "in" && ops.len() == 2 {
        var dst: str = ops.get(0);
        var src: str = ops.get(1);
        if src == "dx" {
            if dst == "al" { o.b.push(0xEC); return ""; }
            if dst == "ax" { o.b.push(0x66); o.b.push(0xED); return ""; }
            if dst == "eax" { o.b.push(0xED); return ""; }
        } else if pe_asm_is_num(src) {
            if dst == "al" { o.b.push(0xE4); o.b.push(pe_asm_num(src) & 0xFF); return ""; }
            if dst == "ax" { o.b.push(0x66); o.b.push(0xE5); o.b.push(pe_asm_num(src) & 0xFF); return ""; }
            if dst == "eax" { o.b.push(0xE5); o.b.push(pe_asm_num(src) & 0xFF); return ""; }
        }
        return "unsupported operands";
    }
    if m == "out" && ops.len() == 2 {
        var port: str = ops.get(0);
        var val: str = ops.get(1);
        if port == "dx" {
            if val == "al" { o.b.push(0xEE); return ""; }
            if val == "ax" { o.b.push(0x66); o.b.push(0xEF); return ""; }
            if val == "eax" { o.b.push(0xEF); return ""; }
        } else if pe_asm_is_num(port) {
            if val == "al" { o.b.push(0xE6); o.b.push(pe_asm_num(port) & 0xFF); return ""; }
            if val == "ax" { o.b.push(0x66); o.b.push(0xE7); o.b.push(pe_asm_num(port) & 0xFF); return ""; }
            if val == "eax" { o.b.push(0xE7); o.b.push(pe_asm_num(port) & 0xFF); return ""; }
        }
        return "unsupported operands";
    }
    if (m == "lgdt" || m == "lidt" || m == "invlpg") && ops.len() == 1 {
        var mr: i64 = pe_asm_mem_reg(ops.get(0));
        if mr < 0 { return "needs a [register] operand"; }
        var op: Vec<i64> = Vec::new();
        op.push(0x0F); op.push(0x01);
        var ext: i64 = 7;
        if m == "lgdt" { ext = 2; }
        if m == "lidt" { ext = 3; }
        pe_asm_mem_op(o, op, ext, mr);
        return "";
    }
    if (m == "push" || m == "pop") && ops.len() == 1 {
        var r: i64 = pe_asm_reg64(ops.get(0));
        if r >= 0 {
            if r >= 8 { o.b.push(0x41); }
            if m == "push" { o.b.push(0x50 + (r & 7)); } else { o.b.push(0x58 + (r & 7)); }
            return "";
        }
        if m == "push" && pe_asm_is_num(ops.get(0)) {
            var pv: i64 = pe_asm_num(ops.get(0));
            if pv >= -128 && pv <= 127 { o.b.push(0x6A); o.b.push(pv & 0xFF); }
            else { o.b.push(0x68); pe_asm_push4(o, pv); }
            return "";
        }
        return "unsupported operand";
    }
    if (m == "jmp" || m == "call") && ops.len() == 1 && pe_asm_reg64(ops.get(0)) >= 0 {
        var rj: i64 = pe_asm_reg64(ops.get(0));
        if rj >= 8 { o.b.push(0x41); }
        o.b.push(0xFF);
        if m == "jmp" { o.b.push(0xE0 | (rj & 7)); } else { o.b.push(0xD0 | (rj & 7)); }
        return "";
    }
    if (m == "shl" || m == "sal" || m == "shr" || m == "sar") && ops.len() == 2 && pe_asm_reg64(ops.get(0)) >= 0 {
        var rs: i64 = pe_asm_reg64(ops.get(0));
        var sext: i64 = 4;
        if m == "shr" { sext = 5; }
        if m == "sar" { sext = 7; }
        if ops.get(1) == "cl" {
            o.b.push(pe_asm_rex(true, 0, rs)); o.b.push(0xD3); o.b.push(0xC0 | (sext << 3) | (rs & 7));
            return "";
        }
        if pe_asm_is_num(ops.get(1)) {
            o.b.push(pe_asm_rex(true, 0, rs)); o.b.push(0xC1); o.b.push(0xC0 | (sext << 3) | (rs & 7));
            o.b.push(pe_asm_num(ops.get(1)) & 0x3F);
            return "";
        }
        return "unsupported operands";
    }
    if ops.len() == 2 && pe_asm_reg64(ops.get(0)) >= 0 && pe_asm_is_num(ops.get(1)) && m != "mov" {
        // add/or/and/sub/xor/cmp r64, imm32 (81 /n, or 83 /n with an imm8)
        var ext2: i64 = -1;
        if m == "add" { ext2 = 0; }
        if m == "or" { ext2 = 1; }
        if m == "and" { ext2 = 4; }
        if m == "sub" { ext2 = 5; }
        if m == "xor" { ext2 = 6; }
        if m == "cmp" { ext2 = 7; }
        if ext2 >= 0 {
            var ri: i64 = pe_asm_reg64(ops.get(0));
            var imm: i64 = pe_asm_num(ops.get(1));
            o.b.push(pe_asm_rex(true, 0, ri));
            if imm >= -128 && imm <= 127 {
                o.b.push(0x83); o.b.push(0xC0 | (ext2 << 3) | (ri & 7)); o.b.push(imm & 0xFF);
            } else {
                o.b.push(0x81); o.b.push(0xC0 | (ext2 << 3) | (ri & 7)); pe_asm_push4(o, imm);
            }
            return "";
        }
    }
    if (m == "inc" || m == "dec" || m == "neg" || m == "not") && ops.len() == 1 {
        var r1: i64 = pe_asm_reg64(ops.get(0));
        if r1 < 0 { return "needs a 64-bit register"; }
        var ext1: i64 = 0;
        var opc: i64 = 0xFF;
        if m == "dec" { ext1 = 1; }
        if m == "neg" { ext1 = 3; opc = 0xF7; }
        if m == "not" { ext1 = 2; opc = 0xF7; }
        o.b.push(pe_asm_rex(true, 0, r1)); o.b.push(opc); o.b.push(0xC0 | (ext1 << 3) | (r1 & 7));
        return "";
    }
    if ops.len() == 2 {
        var a: str = ops.get(0);
        var b: str = ops.get(1);
        var ra: i64 = pe_asm_reg64(a);
        var rb: i64 = pe_asm_reg64(b);
        if m == "mov" {
            var ca: i64 = pe_asm_cr(a);
            var cb: i64 = pe_asm_cr(b);
            if ra >= 0 && cb >= 0 {
                var rx: i64 = pe_asm_rex(false, cb, ra);
                if rx != 0 { o.b.push(rx); }
                o.b.push(0x0F); o.b.push(0x20); o.b.push(0xC0 | ((cb & 7) << 3) | (ra & 7));
                return "";
            }
            if ca >= 0 && rb >= 0 {
                var rx2: i64 = pe_asm_rex(false, ca, rb);
                if rx2 != 0 { o.b.push(rx2); }
                o.b.push(0x0F); o.b.push(0x22); o.b.push(0xC0 | ((ca & 7) << 3) | (rb & 7));
                return "";
            }
            var small: str = " al cl dl bl ax cx dx bx si di eax ecx edx ebx esp ebp esi edi ";
            var sk: i64 = str_find(small, " " + a + " ");
            if sk >= 0 && pe_asm_is_num(b) {
                var sv: i64 = pe_asm_num(b);
                if str_len(a) == 2 && str_ends_with(a, "l") {
                    o.b.push(0xB0 + pe_asm_reg64("r" + str_slice(a, 0, 1) + "x")); o.b.push(sv & 0xFF);
                } else if str_len(a) == 2 {
                    var r16: i64 = pe_asm_reg64("r" + a);
                    if str_ends_with(a, "x") { r16 = pe_asm_reg64("r" + a); }
                    o.b.push(0x66); o.b.push(0xB8 + r16); o.b.push(sv & 0xFF); o.b.push((sv >> 8) & 0xFF);
                } else {
                    o.b.push(0xB8 + pe_asm_reg64("r" + str_slice(a, 1, 3))); pe_asm_push4(o, sv);
                }
                return "";
            }
            if ra >= 0 && pe_asm_is_num(b) {
                var iv: i64 = pe_asm_num(b);
                if iv >= -2147483648 && iv <= 2147483647 {
                    o.b.push(pe_asm_rex(true, 0, ra)); o.b.push(0xC7); o.b.push(0xC0 | (ra & 7));
                    pe_asm_push4(o, iv);
                } else {
                    o.b.push(pe_asm_rex(true, 0, ra)); o.b.push(0xB8 + (ra & 7));
                    pe_asm_push4(o, iv); pe_asm_push4(o, iv >> 32);
                }
                return "";
            }
        }
        var alu: i64 = -1;
        if m == "mov" { alu = 0x89; }
        if m == "add" { alu = 0x01; }
        if m == "or" { alu = 0x09; }
        if m == "and" { alu = 0x21; }
        if m == "sub" { alu = 0x29; }
        if m == "xor" { alu = 0x31; }
        if m == "cmp" { alu = 0x39; }
        if m == "test" { alu = 0x85; }
        if alu >= 0 && ra >= 0 && rb >= 0 {
            o.b.push(pe_asm_rex(true, rb, ra)); o.b.push(alu); o.b.push(0xC0 | ((rb & 7) << 3) | (ra & 7));
            return "";
        }
        return "unsupported operands";
    }
    return "unknown instruction";
}

/// Encode an asm! template (instructions separated by `;` or newlines).
pub fn pe_asm_encode(template: str) -> PeAsmResult {
    var o: PeAsmOut = PeAsmOut { b: Vec::new() };
    var lines: Vec<str> = str_split(str_replace(template, "\n", ";"), ";");
    var i: i64 = 0;
    while i < lines.len() {
        var why: str = pe_asm_one(&mut o, lines.get(i));
        if why != "" {
            return PeAsmResult { bytes: Vec::new(), error: str_trim(lines.get(i)) + ": " + why };
        }
        i = i + 1;
    }
    return PeAsmResult { bytes: o.b, error: "" };
}

/// Errors of asm! templates the bare build could not encode.
pub var g_pe_asm_errors: Vec<str> = Vec::new();
