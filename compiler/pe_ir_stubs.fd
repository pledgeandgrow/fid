// pe_ir_stubs.fd -- PE runtime stubs + reachability for the IR -> .exe backend
// (compiler/pe_ir.fd). Ported from the `PeirGen` machinery in src/pe.rs:
// the code-generator state, its helper structs, the machine-code runtime
// stub generators, and the function-reachability logic.
//
// Adaptations from Rust:
// 1. usize/u32/u8/i32/f64-bits -> i64; emitted bytes masked with & 0xFF
// 2. HashMap<String, u32> / HashMap<String, usize> -> i64 handles
//    (HashMap_get returns 0 when absent; callers use HashMap_contains first
//    where 0 is a valid value, e.g. label 0)
// 3. BTreeMap<String, BTreeSet<String>> unresolved -> sorted Vec<UnresolvedCall>
//    BTreeSet<String> (callers, module_fns, seen) -> Vec<str> kept sorted
//    BTreeMap<String, i64> dyn_type_ids -> sorted Vec<DynTypeId>
//    BTreeMap<String, String> c_overrides -> sorted Vec<COverride>
// 4. Option<...> -> "" / -1 / 0 sentinels, or OptX enums from ir.fd
// 5. Rust `emit(&[b0, b1, ...])` -> one PeirEnc_emit_u8 call per byte,
//    grouped through pe_emit1..pe_emit8
// 6. `for`/`iter().enumerate()`/`pop()` -> while loops / index loops
// 7. format!/to_string() -> int_to_str() + concatenation
// 8. Bare-metal bodies of the stub generators are ported (release G2, Nov 6;
//    two Rust bugs fixed on the way: p_idt_set_entry stored cl for the gate
//    flags, p_gdt_set_entry read its fifth argument from the shadow space).
//    `fid emit --bare` runs them through PeirGen_gen_bare_runtime.
//
// Windows x64 calling convention (for reference):
//   - Integer args: RCX, RDX, R8, R9 (then stack); return: RAX
//   - Shadow space: 32 bytes; stack 16-byte aligned before CALL

module compiler::pe_ir_stubs;
use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::pe_ir_enc;
// ===========================================================================
// Helper structs (src/pe.rs: CThunk, and Vec stand-ins for BTree collections)
// ===========================================================================

/// An `extern "C"` function of msvcrt.dll or kernel32.dll: called through a
/// thunk that moves Fides arguments (all in integer registers, floats as
/// raw bits) into the Windows x64 C convention, and the result back.
pub struct CThunk {
    pub name: str,
    pub slot: i64,
    pub params: Vec<IrType>,
    pub ret: IrType,
    // For each parameter: the size of a struct C takes by value, else 0
    pub by_value: Vec<i64>,
    // The size of a struct C returns in rax, else 0
    pub ret_size: i64,
}

/// What C calls for a Fides function: the C convention on one side, a null
/// `__env` and raw bits on the other.
pub struct CAdapter {
    pub name: str,
    pub target: str,
    pub params: Vec<IrType>,
    pub ret: IrType,
}

pub fn CAdapter_new(name: str, target: str, params: Vec<IrType>, ret: IrType) -> CAdapter {
    return CAdapter {
        name: name, target: target, params: params, ret: ret
    };
}

/// The size of a struct Windows passes by value (in a register), else 0.
pub fn pe_c_by_value(module: &IrModule, ty: IrType) -> i64 {
    match ty {
        IrType::Struct(_) => {
            var size: i64 = IrModule_type_size(module, ty);
            if size == 1 || size == 2 || size == 4 || size == 8 {
                return size;
            }
        }
        _ => {
        }
    }
    return 0;
}

/// Type id of dyn values (type name -> id, from 1).  Sorted Vec stand-in for
/// Rust `BTreeMap<String, i64>`.
pub struct DynTypeId {
    pub name: str,
    pub id: i64,
}

/// A called function that neither the program nor this runtime defines,
/// with the (sorted) names of the functions that call it.  Sorted Vec
/// stand-in for Rust `BTreeMap<String, BTreeSet<String>>`.
pub struct UnresolvedCall {
    pub name: str,
    pub callers: Vec<str>,
}

/// An `extern "C"` function the Fides runtime replaces (see c_override):
/// pledge name -> `pert_c_<C name>`.  Sorted Vec for BTreeMap<String,String>.
pub struct COverride {
    pub name: str,
    pub over: str,
}

// Cross-module construction needs `Name_new` helpers: Fides has no struct
// literals for types declared in another module (compiler/pe_ir.fd).

pub fn CThunk_new(module: &IrModule, name: str, slot: i64, params: Vec<IrType>, ret: IrType) -> CThunk {
    var ret_size: i64 = pe_c_by_value(module, ret);
    var all: Vec<IrType> = Vec::new();
    // Any bigger struct: C takes the result pointer Fides passes, first
    match ret {
        IrType::Struct(_) => {
            if ret_size == 0 {
                all.push(IrType::I64);
            }
        }
        _ => {
        }
    }
    var i: i64 = 0;
    while i < params.len() {
        all.push(params.get(i));
        i = i + 1;
    }
    var by_value: Vec<i64> = Vec::new();
    i = 0;
    while i < all.len() {
        by_value.push(pe_c_by_value(module, all.get(i)));
        i = i + 1;
    }
    return CThunk {
        name: name, slot: slot, params: all, ret: ret, by_value: by_value, ret_size: ret_size
    };
}

pub fn COverride_new(name: str, over: str) -> COverride {
    return COverride {
        name: name, over: over
    };
}

// ===========================================================================
// PeirGen state (src/pe.rs struct PeirGen)
// ===========================================================================

pub struct PeirGen {
    pub enc: PeirEnc,
    /// Map function name to label ID (HashMap handle; 0 = absent AND label 0,
    /// so membership must be checked with HashMap_contains first).
    pub func_labels: i64,
    /// Map string content to rdata offset (HashMap handle)
    pub string_rdata_offsets: i64,
    /// Map global var name to rdata offset, writable section (HashMap handle)
    pub global_rdata_offsets: i64,
    /// IAT entry offsets within .rdata (for each import)
    pub iat_rdata_offsets: Vec<i64>,
    /// Block labels: "func:block_id" -> label_id (HashMap handle)
    pub block_labels: i64,
    /// Entry point (_main) offset within .text
    pub entry_offset: i64,
    /// Bare-metal mode: no IAT, no OS calls, flat binary
    pub bare_mode: bool,
    /// Function being generated
    pub cur_func: str,
    /// The function being generated wraps on overflow
    pub cur_wrapping: bool,
    // Per value: an instruction a counted loop proves safe (peir_unchecked_ops)
    pub unchecked: Vec<i64>,
    // The instruction being generated is one of them
    pub cur_unchecked: bool,
    /// Labels of the arithmetic panic stubs (see gen_arith_panics)
    pub arith_panics: Vec<i64>,
    /// Label of the vectored exception handler
    pub crash_filter: i64,
    /// Registers this function uses for values (id = register), and where
    /// it saved them
    pub saved_regs: Vec<PeOffEnt>,
    /// Type ids of dyn values (sorted Vec<DynTypeId>, ids from 1)
    pub dyn_type_ids: Vec<DynTypeId>,
    /// Called functions that neither the program nor this runtime defines,
    /// with the functions that call them (sorted Vec<UnresolvedCall>)
    pub unresolved: Vec<UnresolvedCall>,
    /// The program's Fides functions (they take `__env` first); sorted names
    pub module_fns: Vec<str>,
    /// `extern "C"` functions called through the import table
    pub c_thunks: Vec<CThunk>,
    pub c_adapters: Vec<CAdapter>,
    /// `extern "C"` functions of a missing local header: stubs returning 0
    pub stub_externs: Vec<str>,
    /// .rdata offset of the bump-allocator state block (24 bytes:
    /// +0 chunk cursor, +8 chunk end, +16 cached process-heap handle)
    pub alloc_rdata_off: i64,
    /// `extern "C"` functions the Fides runtime replaces (see c_override)
    pub c_overrides: Vec<COverride>,
    /// Functions a program refers to by name (thread and task entry points):
    /// what `pe_fn_lookup` can find
    pub named_fns: Vec<str>,
    /// cmp+branch fusion: jcc code (-1 = none) and the cond value id, set
    /// when a comparison is followed by a Branch on its result — the Branch
    /// jumps on the compare's still-live flags (pe-roadmap item 82).
    pub pending_cmp_cc: i64,
    pub pending_cmp_vid: i64,
    /// The comparison being emitted only sets flags: its sole use is the
    /// Branch right after it
    pub flags_only: bool,
    /// Per value of the current function: how many times it is used
    pub use_count: Vec<i64>,
    /// The label of the block laid out after the current one, or -1
    pub next_block: i64,
    /// The prologue reserved the outgoing argument area: a call does not
    /// move rsp
    pub calls_reserved: bool,
    /// OP13: the Call being generated is returned by the instruction after
    /// it (tail_next); it became a jump, the Return is part of it (tail_done)
    pub tail_next: bool,
    pub tail_done: bool,
    /// OP13: no address of this function's frame leaves it (peir_frame_escapes)
    pub tail_ok: bool,
    /// LF20: the function holds secrets (@zeroize locals, @constant_time):
    /// its frame and scratch registers are cleared before it returns
    pub wipe_frame: bool,
    /// LG13: the function runs asm! templates in a process: no value lives
    /// in a register, every callee-saved register is saved
    pub has_asm: bool,
    /// OP15: functions that only panic (a block calling one is cold)
    pub cold_fns: i64,
    /// DB3: line rows [code offset, line, end?] of the input file's
    /// functions (g_pe_lines_names), and those functions' code ranges
    pub line_fns: i64,
    pub lines_cur_fn: bool,
    pub cur_line: i64,
    pub lrows: Vec<i64>,
    pub dbg_names: Vec<str>,
    pub dbg_starts: Vec<i64>,
    pub dbg_ends: Vec<i64>,
    /// B5: the per-function cache (FID_FNCACHE=<path>, file <path>.pe)
    pub fc_on: bool,
    pub fc_path: str,
    pub fc_salt: i64,
    pub fc_key: i64,
    pub fc_old: Vec<PeFcEntry>,
    pub fc_ix: i64,
    pub fc_new: Vec<PeFcEntry>,
    pub fc_rev: Vec<str>,
    pub fc_rip: i64,
    pub fc_rip_kind: Vec<i64>,
    pub fc_rip_k: Vec<i64>,
    pub fc_rip_s: Vec<str>,
    pub fc_hits: i64,
    pub fc_misses: i64,
    /// Calls to functions nobody defines, counted (a cached function made none)
    pub unres_adds: i64,
    /// MI20: the nat_* primitives (prim_interface_names) whose label is
    /// pe_ir's own (no program function has the name), and those the
    /// program reaches (HashMap handles, name -> 1)
    pub nat_own: i64,
    pub nat_wanted: i64,
    /// MI20: labels of the tables nat_fn_names and nat_fn_table return
    /// (-1: not made), placed by PeirGen_gen_nat_tables after all code
    pub nat_names_tab: i64,
    pub nat_fntab_tab: i64,
    /// MI20: (code offset, label) pairs of 8-byte absolute addresses in
    /// those tables, written by PeirGen_nat_patch_abs
    pub nat_abs_fix: Vec<i64>,
    /// MI20 (FID_VERIFY=1): the primitives of the interface pe_ir did not
    /// place ("" when none)
    pub nat_missing: str,
}

/// B5: a relocation of a cached function. pos: offset of the 4 bytes in
/// the function's code; kind: PEIR_RELOC_* (a label) or -1 (an .rdata
/// reference); tkind: what it points at (PEFC_* below); toff: an offset in
/// the function (PEFC_LOCAL), an index (iat, alloc, arith panic); tstr: a
/// name (function, string content, global).
pub struct PeFcFix {
    pub pos: i64,
    pub kind: i64,
    pub tkind: i64,
    pub toff: i64,
    pub tstr: str,
}

/// B5: one function's code before its labels and .rdata references are
/// resolved, keyed by its IR and the build's salt.
pub struct PeFcEntry {
    pub name: str,
    pub key: i64,
    pub bytes: Vec<i64>,
    pub fixes: Vec<PeFcFix>,
}

pub const PEFC_LOCAL: i64 = 0;
pub const PEFC_NAME: i64 = 1;
pub const PEFC_STR: i64 = 2;
pub const PEFC_GLOBAL: i64 = 3;
pub const PEFC_IAT: i64 = 4;
pub const PEFC_ALLOC: i64 = 5;
pub const PEFC_PANIC: i64 = 6;
pub const PEFC_CRASH: i64 = 7;

pub fn PeirGen_new() -> PeirGen {
    return PeirGen {
        enc: PeirEnc_new(), func_labels: HashMap_new(), string_rdata_offsets: HashMap_new(), global_rdata_offsets: HashMap_new(), iat_rdata_offsets: Vec::new(), block_labels: HashMap_new(), entry_offset: 0, bare_mode: false, cur_func: "", cur_wrapping: false, unchecked: Vec::new(), cur_unchecked: false, arith_panics: Vec::new(), crash_filter: 0, saved_regs: Vec::new(), dyn_type_ids: Vec::new(), unresolved: Vec::new(), module_fns: Vec::new(), c_thunks: Vec::new(), c_adapters: Vec::new(), alloc_rdata_off: 0, stub_externs: Vec::new(), c_overrides: Vec::new(), named_fns: Vec::new(), pending_cmp_cc: -1, pending_cmp_vid: -1, flags_only: false, use_count: Vec::new(), next_block: -1, calls_reserved: false, tail_next: false, tail_done: false, tail_ok: false, wipe_frame: false, has_asm: false, cold_fns: HashMap_new(), line_fns: HashMap_new(), lines_cur_fn: false, cur_line: 0, lrows: Vec::new(), dbg_names: Vec::new(), dbg_starts: Vec::new(), dbg_ends: Vec::new(), fc_on: false, fc_path: "", fc_salt: 0, fc_key: 0, fc_old: Vec::new(), fc_ix: HashMap_new(), fc_new: Vec::new(), fc_rev: Vec::new(), fc_rip: HashMap_new(), fc_rip_kind: Vec::new(), fc_rip_k: Vec::new(), fc_rip_s: Vec::new(), fc_hits: 0, fc_misses: 0, unres_adds: 0, nat_own: HashMap_new(), nat_wanted: HashMap_new(), nat_names_tab: 0 - 1, nat_fntab_tab: 0 - 1, nat_abs_fix: Vec::new(), nat_missing: "",
    };
}

// ===========================================================================
// Raw byte emission helpers (Rust `enc.emit(&[...])` -> one call per byte)
// ===========================================================================

fn pe_emit1(e: &mut PeirEnc, a: i64) -> void {
    PeirEnc_emit_u8(e, a);
}

fn pe_emit2(e: &mut PeirEnc, a: i64, b: i64) -> void {
    PeirEnc_emit_u8(e, a);
    PeirEnc_emit_u8(e, b);
}

fn pe_emit3(e: &mut PeirEnc, a: i64, b: i64, c: i64) -> void {
    PeirEnc_emit_u8(e, a);
    PeirEnc_emit_u8(e, b);
    PeirEnc_emit_u8(e, c);
}

fn pe_emit4(e: &mut PeirEnc, a: i64, b: i64, c: i64, d: i64) -> void {
    PeirEnc_emit_u8(e, a);
    PeirEnc_emit_u8(e, b);
    PeirEnc_emit_u8(e, c);
    PeirEnc_emit_u8(e, d);
}

fn pe_emit5(e: &mut PeirEnc, a: i64, b: i64, c: i64, d: i64, f: i64) -> void {
    PeirEnc_emit_u8(e, a);
    PeirEnc_emit_u8(e, b);
    PeirEnc_emit_u8(e, c);
    PeirEnc_emit_u8(e, d);
    PeirEnc_emit_u8(e, f);
}

fn pe_emit6(e: &mut PeirEnc, a: i64, b: i64, c: i64, d: i64, f: i64, g: i64) -> void {
    PeirEnc_emit_u8(e, a);
    PeirEnc_emit_u8(e, b);
    PeirEnc_emit_u8(e, c);
    PeirEnc_emit_u8(e, d);
    PeirEnc_emit_u8(e, f);
    PeirEnc_emit_u8(e, g);
}

fn pe_emit7(e: &mut PeirEnc, a: i64, b: i64, c: i64, d: i64, f: i64, g: i64, h: i64) -> void {
    PeirEnc_emit_u8(e, a);
    PeirEnc_emit_u8(e, b);
    PeirEnc_emit_u8(e, c);
    PeirEnc_emit_u8(e, d);
    PeirEnc_emit_u8(e, f);
    PeirEnc_emit_u8(e, g);
    PeirEnc_emit_u8(e, h);
}

fn pe_emit8(e: &mut PeirEnc, a: i64, b: i64, c: i64, d: i64, f: i64, g: i64, h: i64, i: i64) -> void {
    PeirEnc_emit_u8(e, a);
    PeirEnc_emit_u8(e, b);
    PeirEnc_emit_u8(e, c);
    PeirEnc_emit_u8(e, d);
    PeirEnc_emit_u8(e, f);
    PeirEnc_emit_u8(e, g);
    PeirEnc_emit_u8(e, h);
    PeirEnc_emit_u8(e, i);
}

// ===========================================================================
// Sorted-Vec helpers (BTreeSet / BTreeMap stand-ins)
// ===========================================================================

/// Insert `s` into sorted Vec<str> `v` (BTreeSet<String>::insert).
/// Returns the (possibly reallocated) Vec.
fn pe_strs_insert_sorted(v: Vec<str>, s: str) -> Vec<str> {
    var v = v;
    var i: i64 = 0;
    while i < v.len() {
        var c: i64 = str_compare(v.get(i), s);
        if c == 0 {
            return v;
        }
        if c > 0 {
            // insert at i: append a slot then shift right
            v.push(v.get(v.len() - 1));
            var j: i64 = v.len() - 1;
            while j > i {
                v.set(j, v.get(j - 1));
                j = j - 1;
            }
            v.set(i, s);
            return v;
        }
        i = i + 1;
    }
    v.push(s);
    return v;
}

// ===========================================================================
// Runtime tables (src/pe.rs: PE_PRIMITIVES, PE_STUB_DEPS, PRINT_BUILTINS)
// ===========================================================================

/// Machine-code primitives of the Fides PE runtime (src/pe_runtime/), which
/// declares them `extern "C"`: called without `__env`, arguments from rcx.
pub fn pe_primitive_names() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("pe_atomic_load");
    v.push("pe_atomic_store");
    v.push("pe_atomic_add");
    v.push("pe_atomic_cas");
    v.push("pe_f64_to_bits");
    v.push("pe_bits_to_f64");
    v.push("pe_f64_to_f32_bits");
    v.push("pe_f32_bits_to_f64");
    v.push("pe_fn_lookup");
    v.push("pe_call_fn");
    v.push("pe_call_c1");
    // RL16: the block allocator under --leaks (PeirGen_gen_malloc /
    // PeirGen_gen_free place them; stdlib/pe_runtime/base.fd declares them)
    v.push("pe_lk_raw_malloc");
    v.push("pe_lk_raw_free");
    // MI20: the machine layer's primitive interface, which pe_ir defines
    // too (PeirGen_gen_nat_prims)
    var nat: Vec<str> = prim_interface_names();
    var ni: i64 = 0;
    while ni < nat.len() {
        v.push(nat.get(ni));
        ni = ni + 1;
    }
    return v;
}

/// MI20: the interface of the runtime's machine-code primitives — the
/// `nat_*` names every native backend defines: the machine layer's targets
/// (Linux AArch64 / RISC-V / x86-64, `--nat` Windows, macOS; nat_ir.fd
/// checks them with ng_prim_check under FID_VERIFY=1) and pe_ir, the
/// default Windows backend (PeirGen_gen_nat_prims, checked by
/// PeirGen_nat_check under FID_VERIFY=1). Grouped: system calls and
/// threads; signals; atomics; tasks; traces; the rest. One list for both
/// (nat_ir imports this module). Target-only helpers (nat_win_call,
/// nat_mac_call, nat_c_*, pe_*) are not part of it.
pub fn prim_interface_names() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("nat_syscall");
    v.push("nat_clone_thread");
    v.push("nat_tls_get");
    v.push("nat_tls_set");
    v.push("nat_sig_handler");
    v.push("nat_sig_restorer");
    v.push("nat_atomic_load");
    v.push("nat_atomic_store");
    v.push("nat_atomic_add");
    v.push("nat_atomic_cas");
    v.push("nat_ctx_swap");
    v.push("nat_ctx_tramp");
    v.push("nat_call_fn");
    v.push("nat_fn_table");
    v.push("nat_fn_names");
    v.push("nat_frame_fp");
    v.push("nat_frame_ret");
    v.push("nat_frame_next");
    v.push("nat_start_sp");
    v.push("nat_arch");
    v.push("nat_os");
    v.push("nat_fma");
    return v;
}

/// FID_VERIFY=1 (read once): the checks of the native backends
pub var g_pe_verify: i64 = 0 - 1;

pub fn pe_verify_on() -> bool {
    if g_pe_verify < 0 {
        var v: str = peir_env_or_empty("FID_VERIFY");
        g_pe_verify = 0;
        if str_len(v) > 0 {
            g_pe_verify = 1;
        }
    }
    return g_pe_verify == 1;
}

/// Task context switch (competitive RT9), C convention:
/// pe_ctx_swap(save, sp) pushes the callee-saved registers, xmm6-15 and the
/// TEB's StackBase, StackLimit and DeallocationStack, stores rsp at `save`,
/// switches to `sp`, clears the busy word of the context it left (`save`
/// + 16: its registers are saved, another thread may resume it) and pops what
/// was pushed there. The TEB fields make the
/// system grow a task's stack and report its overflow as for a thread's.
/// A new context starts in the trampoline: rcx = r12, call r13.
/// (src/pe.rs has the same bytes.)
fn pe_ctx_swap_code() -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(0x55);
    v.push(0x53);
    v.push(0x57);
    v.push(0x56);
    v.push(0x41);
    v.push(0x54);
    v.push(0x41);
    v.push(0x55);
    v.push(0x41);
    v.push(0x56);
    v.push(0x41);
    v.push(0x57);
    v.push(0x48);
    v.push(0x81);
    v.push(0xEC);
    v.push(0xB8);
    v.push(0x00);
    v.push(0x00);
    v.push(0x00);
    v.push(0xF3);
    v.push(0x0F);
    v.push(0x7F);
    v.push(0xB4);
    v.push(0x24);
    v.push(0x00);
    v.push(0x00);
    v.push(0x00);
    v.push(0x00);
    v.push(0xF3);
    v.push(0x0F);
    v.push(0x7F);
    v.push(0xBC);
    v.push(0x24);
    v.push(0x10);
    v.push(0x00);
    v.push(0x00);
    v.push(0x00);
    v.push(0xF3);
    v.push(0x44);
    v.push(0x0F);
    v.push(0x7F);
    v.push(0x84);
    v.push(0x24);
    v.push(0x20);
    v.push(0x00);
    v.push(0x00);
    v.push(0x00);
    v.push(0xF3);
    v.push(0x44);
    v.push(0x0F);
    v.push(0x7F);
    v.push(0x8C);
    v.push(0x24);
    v.push(0x30);
    v.push(0x00);
    v.push(0x00);
    v.push(0x00);
    v.push(0xF3);
    v.push(0x44);
    v.push(0x0F);
    v.push(0x7F);
    v.push(0x94);
    v.push(0x24);
    v.push(0x40);
    v.push(0x00);
    v.push(0x00);
    v.push(0x00);
    v.push(0xF3);
    v.push(0x44);
    v.push(0x0F);
    v.push(0x7F);
    v.push(0x9C);
    v.push(0x24);
    v.push(0x50);
    v.push(0x00);
    v.push(0x00);
    v.push(0x00);
    v.push(0xF3);
    v.push(0x44);
    v.push(0x0F);
    v.push(0x7F);
    v.push(0xA4);
