// embedded.fd -- Embedded & IoT Support
// Ported from src/embedded.rs.
//
// Provides features for targeting microcontrollers and embedded systems:
//   1. Deterministic memory mode (FixedBufferAllocator -- no heap fragmentation)
//   2. Binary size optimization (< 4KB for simple programs)
//   3. Real-time guarantees (!RealTime effect -- bounded execution time)
//   4. Hardware abstraction layer (HAL) framework

module compiler::embedded;

use core;
use vec;
use string;

// === 5B.2: FixedBufferAllocator -- Deterministic Memory ===

pub struct FixedBufferAllocator {
    pub buffer: Vec<i64>,
    pub offset: i64,
    pub allocations: Vec<(i64, i64)>,
    pub total_allocated: i64,
    pub peak_usage: i64,
}

pub fn FixedBufferAllocator_new(capacity: i64) -> FixedBufferAllocator {
    var buffer: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < capacity {
        buffer.push(0);
        i = i + 1;
    }
    return FixedBufferAllocator {
        buffer: buffer,
        offset: 0,
        allocations: Vec::new(),
        total_allocated: 0,
        peak_usage: 0,
    };
}

/// Allocate `size` bytes. Returns a pointer (offset into buffer) or -1 if out of memory.
pub fn FixedBufferAllocator_alloc(self: &mut FixedBufferAllocator, size: i64) -> i64 {
    // Align to 8 bytes
    var aligned_size: i64 = (size + 7) & (-8);  // !7 in two's complement
    if self.offset + aligned_size > self.buffer.len() {
        return -1; // Out of memory
    }

    var ptr: i64 = self.offset;
    self.offset = self.offset + aligned_size;
    self.total_allocated = self.total_allocated + aligned_size;
    if self.offset > self.peak_usage {
        self.peak_usage = self.offset;
    }
    self.allocations.push((ptr, aligned_size));
    return ptr;
}

/// Free a previously allocated pointer.
/// Note: This is a bump allocator -- freed memory is not reclaimed.
pub fn FixedBufferAllocator_free(self: &mut FixedBufferAllocator, ptr: i64) -> void {
    var i: i64 = 0;
    while i < self.allocations.len() {
        var entry: (i64, i64) = self.allocations.get(i);
        var (a0, a1) = entry;
        if a0 == ptr {
            self.allocations.remove(i);
            return;
        }
        i = i + 1;
    }
}

/// Reset the allocator to its initial state.
pub fn FixedBufferAllocator_reset(self: &mut FixedBufferAllocator) -> void {
    self.offset = 0;
    self.total_allocated = 0;
    var new_alloc: Vec<(i64, i64)> = Vec::new();
    self.allocations = new_alloc;
}

/// Get the current memory usage (bytes allocated).
pub fn FixedBufferAllocator_usage(self: &FixedBufferAllocator) -> i64 {
    return self.offset;
}

/// Get the peak memory usage.
pub fn FixedBufferAllocator_peak(self: &FixedBufferAllocator) -> i64 {
    return self.peak_usage;
}

/// Get the total capacity.
pub fn FixedBufferAllocator_capacity(self: &FixedBufferAllocator) -> i64 {
    return self.buffer.len();
}

/// Get the remaining free memory.
pub fn FixedBufferAllocator_free_space(self: &FixedBufferAllocator) -> i64 {
    return self.buffer.len() - self.offset;
}

/// Read a byte at the given offset.
pub fn FixedBufferAllocator_read(self: &FixedBufferAllocator, offset: i64) -> i64 {
    if offset < 0 || offset >= self.buffer.len() { return -1; }
    return self.buffer.get(offset);
}

/// Write a byte at the given offset.
pub fn FixedBufferAllocator_write(self: &mut FixedBufferAllocator, offset: i64, value: i64) -> bool {
    if offset < 0 || offset >= self.buffer.len() { return false; }
    self.buffer.set(offset, value);
    return true;
}

// === 5B.3: Binary Size Optimization ===

pub struct SizeReport {
    pub total_size: i64,
    pub text_size: i64,
    pub data_size: i64,
    pub bss_size: i64,
    pub debug_size: i64,
    pub meets_target: bool,
}

pub fn SizeReport_new() -> SizeReport {
    return SizeReport {
        total_size: 0,
        text_size: 0,
        data_size: 0,
        bss_size: 0,
        debug_size: 0,
        meets_target: false,
    };
}

pub struct BinarySizeOptimizer {
    pub target_size: i64,
    pub strip_debug: bool,
    pub remove_unused: bool,
    pub merge_strings: bool,
}

pub fn BinarySizeOptimizer_new(target_size: i64) -> BinarySizeOptimizer {
    return BinarySizeOptimizer {
        target_size: target_size,
        strip_debug: true,
        remove_unused: true,
        merge_strings: true,
    };
}

/// Analyze a binary and report size breakdown.
pub fn BinarySizeOptimizer_analyze(self: &BinarySizeOptimizer, binary: Vec<i64>) -> SizeReport {
    var report: SizeReport = SizeReport_new();
    report.total_size = binary.len();
    report.text_size = binary.len();
    report.data_size = 0;
    report.bss_size = 0;
    report.debug_size = 0;
    report.meets_target = binary.len() <= self.target_size;
    return report;
}

/// Get optimization recommendations for reducing binary size.
pub fn BinarySizeOptimizer_recommendations(self: &BinarySizeOptimizer, binary: Vec<i64>) -> Vec<str> {
    var recs: Vec<str> = Vec::new();
    var report: SizeReport = BinarySizeOptimizer_analyze(self, binary);

    if !report.meets_target {
        recs.push("Binary is " + int_to_str(report.total_size) + " bytes, target is "
            + int_to_str(self.target_size) + " bytes (exceeds by "
            + int_to_str(report.total_size - self.target_size) + " bytes)");
    }

    if self.strip_debug {
        recs.push("Strip debug info: use --release flag to remove debug symbols");
    }
    if self.remove_unused {
        recs.push("Remove unused functions: use link-time dead code elimination");
    }
    if self.merge_strings {
        recs.push("Merge identical strings: enable string pooling in the compiler");
    }

    recs.push("Use --bare flag to remove runtime overhead (no stdlib)");
    recs.push("Consider using smaller integer types (i8/u8 instead of i64/u64)");

    return recs;
}

// === 5B.4: Real-Time Guarantees ===

pub enum RealTimeStatus {
    Safe(i64),            // estimated_cycles
    Violation(str),      // reason
}

pub struct RealTimeAnalyzer {
    pub max_cycles: i64,
    pub verified: Vec<(str, RealTimeStatus)>,
}

pub fn RealTimeAnalyzer_new(max_cycles: i64) -> RealTimeAnalyzer {
    return RealTimeAnalyzer {
        max_cycles: max_cycles,
        verified: Vec::new(),
    };
}

/// Check if a function is real-time safe.
pub fn RealTimeAnalyzer_check_function(
    self: &mut RealTimeAnalyzer,
    name: str,
    has_loops: bool,
    has_recursion: bool,
    has_dyn_dispatch: bool,
    has_alloc: bool,
    has_io: bool,
    estimated_cycles: i64
) -> RealTimeStatus {
    var violations: Vec<str> = Vec::new();

    if has_loops {
        violations.push("unbounded loop detected");
    }
    if has_recursion {
        violations.push("recursion detected (unbounded stack growth)");
    }
    if has_dyn_dispatch {
        violations.push("dynamic dispatch detected (unbounded call time)");
    }
    if has_alloc {
        violations.push("heap allocation detected (non-deterministic timing)");
    }
    if has_io {
        violations.push("I/O operation detected (non-deterministic timing)");
    }
    if estimated_cycles > self.max_cycles {
        violations.push("estimated " + int_to_str(estimated_cycles) + " cycles exceeds max "
            + int_to_str(self.max_cycles) + " cycles");
    }

    var status: RealTimeStatus;
    if violations.len() == 0 {
        status = RealTimeStatus::Safe(estimated_cycles);
    } else {
        var reason: str = "";
        var i: i64 = 0;
        while i < violations.len() {
            if i > 0 { reason = reason + "; "; }
            reason = reason + violations.get(i);
            i = i + 1;
        }
        status = RealTimeStatus::Violation(reason);
    }

    self.verified.push((name, status));
    return status;
}

/// Get the verification status for a function.
pub fn RealTimeAnalyzer_status(self: &RealTimeAnalyzer, name: str) -> RealTimeStatus {
    var i: i64 = 0;
    while i < self.verified.len() {
        var entry: (str, RealTimeStatus) = self.verified.get(i);
        var (v0, v1) = entry;
        if v0 == name {
            return v1;
        }
        i = i + 1;
    }
    return RealTimeStatus::Safe(0);
}

/// Get all verified function names.
pub fn RealTimeAnalyzer_verified_functions(self: &RealTimeAnalyzer) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < self.verified.len() {
        var (vf0, vf1) = self.verified.get(i);
        result.push(vf0);
        i = i + 1;
    }
    return result;
}

// === 5B.5: Hardware Abstraction Layer (HAL) Framework ===

pub enum DeviceType {
    Gpio,
    Uart,
    Spi,
    I2c,
    Timer,
    InterruptController,
    Mmu,
    Custom(str),
}

pub enum RegisterAccess {
    ReadOnly,
    WriteOnly,
    ReadWrite,
    WriteToClear,
}

pub struct HalRegister {
    pub name: str,
    pub offset: i64,
    pub width: i64,
    pub access: RegisterAccess,
    pub reset_value: i64,
    pub description: str,
}

pub fn HalRegister_new(name: str, offset: i64, width: i64, access: RegisterAccess, reset_value: i64, description: str) -> HalRegister {
    return HalRegister {
        name: name,
        offset: offset,
        width: width,
        access: access,
        reset_value: reset_value,
        description: description,
    };
}

pub struct HalDevice {
    pub name: str,
    pub device_type: DeviceType,
    pub base_address: i64,
    pub registers: Vec<HalRegister>,
}

pub fn HalDevice_new(name: str, device_type: DeviceType, base_address: i64, registers: Vec<HalRegister>) -> HalDevice {
    return HalDevice {
        name: name,
        device_type: device_type,
        base_address: base_address,
        registers: registers,
    };
}

pub struct HalFramework {
    pub devices: Vec<HalDevice>,
}

pub fn HalFramework_new() -> HalFramework {
    return HalFramework { devices: Vec::new() };
}

/// Register a hardware device
pub fn HalFramework_register_device(self: &mut HalFramework, device: HalDevice) -> void {
    self.devices.push(device);
}

/// Get a device by name
pub fn HalFramework_get_device(self: &HalFramework, name: str) -> i64 {
    var i: i64 = 0;
    while i < self.devices.len() {
        if self.devices.get(i).name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Generate Fides FFI bindings for all registered devices.
pub fn HalFramework_generate_bindings(self: &HalFramework) -> str {
    var code: str = "// Generated HAL bindings -- Phase 5B.5\n";
    code = code + "// Hardware abstraction layer for embedded targets\n\n";

    var di: i64 = 0;
    while di < self.devices.len() {
        var device: HalDevice = self.devices.get(di);
        code = code + "// --- " + device.name + " (" + device_type_str(device.device_type) + ") ---\n";
        code = code + "// Base address: 0x" + int_to_hex(device.base_address) + "\n";

        var ri: i64 = 0;
        while ri < device.registers.len() {
            var reg: HalRegister = device.registers.get(ri);
            var addr: i64 = device.base_address + reg.offset;
            var access_fn: str = register_access_str(reg.access);

            code = code + "// " + reg.name + ": " + reg.description + " (offset 0x"
                + int_to_hex(reg.offset) + ", " + int_to_str(reg.width) + "-bit, " + access_fn + ")\n";
            code = code + "fn " + device.name + "_" + reg.name + "_read() -> u" + int_to_str(reg.width)
                + " !Read {\n    return p_phys_read" + int_to_str(reg.width) + "(0x" + int_to_hex(addr) + ");\n}\n";

            match reg.access {
                RegisterAccess::ReadOnly => {}
                _ => {
                    code = code + "fn " + device.name + "_" + reg.name + "_write(val: u"
                        + int_to_str(reg.width) + ") -> void !Write {\n    p_phys_write"
                        + int_to_str(reg.width) + "(0x" + int_to_hex(addr) + ", val);\n}\n";
                }
            }
            code = code + "\n";
            ri = ri + 1;
        }
        di = di + 1;
    }

    return code;
}

fn device_type_str(dt: DeviceType) -> str {
    match dt {
        DeviceType::Gpio => { return "GPIO"; }
        DeviceType::Uart => { return "UART"; }
        DeviceType::Spi => { return "SPI"; }
        DeviceType::I2c => { return "I2C"; }
        DeviceType::Timer => { return "Timer"; }
        DeviceType::InterruptController => { return "Interrupt Controller"; }
        DeviceType::Mmu => { return "MMU"; }
        DeviceType::Custom(s) => { return s; }
    }
    return "";
}

fn register_access_str(access: RegisterAccess) -> str {
    match access {
        RegisterAccess::ReadOnly => { return "read"; }
        RegisterAccess::WriteOnly => { return "write"; }
        RegisterAccess::ReadWrite => { return "read_write"; }
        RegisterAccess::WriteToClear => { return "write_to_clear"; }
    }
    return "";
}

/// Create a default HAL for a common microcontroller (RISC-V HiFive1)
pub fn HalFramework_default_riscv_hal() -> HalFramework {
    var hal: HalFramework = HalFramework_new();

    // GPIO device
    var gpio_regs: Vec<HalRegister> = Vec::new();
    gpio_regs.push(HalRegister_new("input_val", 0x00, 32, RegisterAccess::ReadOnly, 0, "GPIO input value"));
    gpio_regs.push(HalRegister_new("input_en", 0x04, 32, RegisterAccess::ReadWrite, 0, "GPIO input enable"));
    gpio_regs.push(HalRegister_new("output_en", 0x08, 32, RegisterAccess::ReadWrite, 0, "GPIO output enable"));
    gpio_regs.push(HalRegister_new("output_val", 0x0C, 32, RegisterAccess::ReadWrite, 0, "GPIO output value"));

    HalFramework_register_device(&mut hal, HalDevice_new(
        "gpio",
        DeviceType::Gpio,
        0x10012000,
        gpio_regs
    ));

    // UART device
    var uart_regs: Vec<HalRegister> = Vec::new();
    uart_regs.push(HalRegister_new("txdata", 0x00, 32, RegisterAccess::WriteOnly, 0, "UART transmit data"));
    uart_regs.push(HalRegister_new("rxdata", 0x04, 32, RegisterAccess::ReadOnly, 0, "UART receive data"));
    uart_regs.push(HalRegister_new("txctrl", 0x08, 32, RegisterAccess::ReadWrite, 0, "UART transmit control"));
    uart_regs.push(HalRegister_new("rxctrl", 0x0C, 32, RegisterAccess::ReadWrite, 0, "UART receive control"));

    HalFramework_register_device(&mut hal, HalDevice_new(
        "uart",
        DeviceType::Uart,
        0x10013000,
        uart_regs
    ));

    return hal;
}

// --- Local helpers ---

fn int_to_str(n: i64) -> str {
    if n == 0 { return "0"; }
    var negative: bool = n < 0;
    var num: i64 = 0;
    if negative { num = -n; } else { num = n; }
    var buf: str = "";
    while num > 0 {
        var digit: i64 = num % 10;
        buf = char_from_digit(digit) + buf;
        num = num / 10;
    }
    if negative { buf = "-" + buf; }
    return buf;
}

fn int_to_hex(n: i64) -> str {
    if n == 0 { return "0"; }
    var num: i64 = n;
    var buf: str = "";
    while num > 0 {
        var digit: i64 = num & 0xF;
        if digit < 10 {
            buf = char_from_digit(digit) + buf;
        } else {
            buf = hex_char(digit) + buf;
        }
        num = num >> 4;
    }
    return buf;
}

pub fn char_from_digit(d: i64) -> str {
    var buf: Vec<i64> = Vec::new();
    buf.push(48 + d);
    return str_from_bytes(buf);
}

pub fn hex_char(d: i64) -> str {
    var buf: Vec<i64> = Vec::new();
    buf.push(65 + d - 10);
    return str_from_bytes(buf);
}
