// ark.fd -- Package manager for the Fides programming language
//
// ark is the package manager for Fides. It manages pacts (dependencies)
// through ark.toml manifests and installs them into ark_modules/.
//
// Commands:
//   ark init [name]           Create a new ark.toml in the current directory
//   ark add <name> [options]  Add a pact (dependency)
//       --path <path>         Path dependency
//       --git <url>           Git dependency
//       --branch <branch>     Git branch
//       --tag <tag>           Git tag
//   ark install               Install all pacts from ark.toml
//   ark remove <name>         Remove a pact
//   ark list                  List all pacts
//   ark lock                  Write ark.lock: git commits, path-pact hashes
//   ark audit [--files]       What a build pulls in, checked against ark.lock
//   ark update [name]         Newest commits, installed and locked
//
// `use <name>` finds an installed pact in ark_modules/ (compiler.fd
// ark_push_candidates): <name>.fd, <name>/mod.fd, <name>/lib.fd,
// <name>/src/lib.fd; `use <name>::x` also <name>/src/x.fd.
//   ark vendor                Copy every pact into vendor/ (CD9): offline builds
//   ark search <query>        Search the package index (N6)
//   ark publish [--git <url>] Add this package's tagged version to the index
// The index (port of src/ark.rs): a Git repository, ARK_INDEX or
// DEFAULT_INDEX, one file per package, one line per version
// (`version git-url tag commit`); `ark add <name> --version <spec>` adds a
// registry pact, installed at the published tag and refused when the tag
// has moved off the recorded commit. `ark add` warns about a name one edit
// away from a known one (CD6).
//   ark api [--against <rev>] The public API; what changed since <rev> (CU5)
//   ark version               Show version
//   ark help                  Show help
// Nov 15: [package] authors/description/license and [dev-dependencies]
// (L5A; dev pacts go to ark_modules/.dev/), the pacts' own dependencies
// resolved to one version each (CD4, ark_resolve), repositories fetched
// once per machine into a shared cache (CD3, ark_cache_repo), and `ark
// publish` refusing a minor version that breaks the public API (CU5).
// Then (L5A) dependency `features = [...]` (ark_modules/.features and
// ark.lock; `dep/feature` entries followed across pacts), build
// targets ([target], [[bin]], [[lib]], [[test]]: `ark build`, `ark test`),
// (L5C) `ark update` to the newest version within each constraint, and
// (L5F) [workspace] members. Nov 16: the members' pacts resolved together
// and installed once in the root, with one ark.lock (L5F shared deps,
// ark_workspace_install), `ark yank` (N6), and [capabilities]: what each
// pact may use, checked on install/build/test/audit, diffed on update
// (CD1, ark_cap_check). L5E: binary packages -- `ark prebuild` ships a
// prebuilt library per target, `binary = true` links it instead of
// compiling the pact (ark_bin_*). docs/reference/ark.md describes all of it.

module compiler::ark;
use core;
use vec;
use string;
// --- Constants ---

const MANIFEST_FILE: str = "ark.toml";
const LOCK_FILE: str = "ark.lock";
const MODULES_DIR: str = "ark_modules";

/// L5F: the root of the workspace this directory is a member of, relative
/// (`..`, `../..`), or "" (ark_main sets it; ark_ws_root_find): a member
/// reads the workspace's one ark.lock and its pacts in the root's
/// ark_modules/.
var g_ark_ws_root: str = "";

// --- Dependency types ---

pub enum DepKind {
    Path,
    Git,
    GitBranch,
    GitTag,
    Registry,
}

pub enum DepSource {
    Path(str),
    Git(str),
    GitBranch(str, str),
    GitTag(str, str),
    Registry(str),
}

pub struct PactEntry {
    name: str,
    source: DepSource,
    // L5A: `features = [...]` of its line in ark.toml: the features ark
    // install enables in it (ark_modules/.features, @cfg(feature = "x"))
    features: Vec<str>,
    // L5E: `binary = true`: link its prebuilt library, not its source
    binary: bool,
}

pub struct Manifest {
    pkg_name: str,
    pkg_version: str,
    pkg_edition: str,
    // L5A: the rest of [package]
    pkg_authors: Vec<str>,
    pkg_description: str,
    pkg_license: str,
    pacts: Vec<PactEntry>,
    // L5A: [dev-dependencies] -- installed into ark_modules/.dev/, which
    // `fid test` reads and a normal build does not
    dev_pacts: Vec<PactEntry>,
    // what ark does not interpret, kept as written when it saves:
    // the other keys of [package] and every other section
    pkg_extra: str,
    other_sections: str,
}

// --- Helpers ---

fn strip_quotes(s: str) -> str {
    var s: str = str_trim(s);
    var slen: i64 = str_len(s);
    if slen < 2 {
        return s;
    }
    var first: i64 = str_byte_at(s, 0);
    var last: i64 = str_byte_at(s, slen - 1);
    if (first == 34 && last == 34) || (first == 39 && last == 39) {
        return str_slice(s, 1, slen - 1);
    }
    return s;
}

fn quote(s: str) -> str {
    // Simple quote -- no escaping needed for typical paths/urls
    return "\"" + s + "\"";
}

/// `s` as a TOML basic string: `\` and `"` escaped (free text: authors,
/// description, license).
fn ark_toml_str(s: str) -> str {
    return "\"" + str_replace(str_replace(s, "\\", "\\\\"), "\"", "\\\"") + "\"";
}

/// A quoted TOML value read back: quotes dropped, `\"` and `\\` undone
/// (other escapes are kept as written).
fn ark_toml_unstr(v: str) -> str {
    var s: str = str_trim(v);
    var n: i64 = str_len(s);
    if n < 2 || str_byte_at(s, 0) != 34 {
        return strip_quotes(s);
    }
    var out: str = "";
    var i: i64 = 1;
    while i < n - 1 {
        var c: i64 = str_byte_at(s, i);
        if c == 92 && i + 1 < n - 1 && (str_byte_at(s, i + 1) == 34 || str_byte_at(s, i + 1) == 92) {
            out = out + str_slice(s, i + 1, i + 2);
            i = i + 2;
        } else {
            out = out + str_slice(s, i, i + 1);
            i = i + 1;
        }
    }
    return out;
}

/// The strings of a TOML array value `["a", "b"]` (a lone string gives one).
fn ark_toml_array(v: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var s: str = str_trim(v);
    var n: i64 = str_len(s);
    if n >= 2 && str_byte_at(s, 0) == 91 && str_byte_at(s, n - 1) == 93 {
        s = str_slice(s, 1, n - 1);
    } else {
        if n > 0 {
            out.push(ark_toml_unstr(s));
        }
        return out;
    }
    // split on commas outside quotes
    n = str_len(s);
    var start: i64 = 0;
    var in_q: bool = false;
    var i: i64 = 0;
    while i <= n {
        if i == n || (str_byte_at(s, i) == 44 && !in_q) {
            var item: str = str_trim(str_slice(s, start, i));
            if str_len(item) > 0 {
                out.push(ark_toml_unstr(item));
            }
            start = i + 1;
        } else if str_byte_at(s, i) == 92 && in_q {
            i = i + 1;
        } else if str_byte_at(s, i) == 34 {
            in_q = !in_q;
        }
        i = i + 1;
    }
    return out;
}

/// `v` as a TOML array of strings.
fn ark_toml_list(v: Vec<str>) -> str {
    var s: str = "[";
    var i: i64 = 0;
    while i < v.len() {
        if i > 0 {
            s = s + ", ";
        }
        s = s + ark_toml_str(v[i]);
        i = i + 1;
    }
    return s + "]";
}

/// Is `section` one ark reads and writes itself?
fn ark_known_section(section: str) -> bool {
    return section == "package" || section == "dependencies" || section == "dev-dependencies";
}

/// Is `key` a key of [package] ark reads and writes itself?
fn ark_known_package_key(key: str) -> bool {
    return key == "name" || key == "version" || key == "edition" || key == "authors" || key == "description" || key == "license";
}

/// The lines of ark.toml ark does not interpret, as written: with
/// `package` true the other keys of [package], else every other section
/// (its header, comments and keys), so saving keeps them.
fn ark_extra_lines(content: str, package: bool) -> str {
    var out: str = "";
    var section: str = "";
    var lines: Vec<str> = str_split(content, "\n");
    var i: i64 = 0;
    while i < lines.len() {
        var raw: str = str_replace(lines[i], "\r", "");
        var line: str = str_trim(raw);
        if str_len(line) > 0 && str_byte_at(line, 0) == 91 && str_ends_with(line, "]") {
            section = str_trim(str_slice(line, 1, str_len(line) - 1));
            // [[bin]] -> "[bin]": an array of tables is never a known section
            if !package && !ark_known_section(section) {
                out = out + raw + "\n";
            }
        } else if package {
            var eq: i64 = str_find(line, "=");
            if section == "package" && eq > 0 && !ark_known_package_key(str_trim(str_slice(line, 0, eq))) {
                out = out + raw + "\n";
            }
        } else if !ark_known_section(section) && str_len(section) > 0 {
            out = out + raw + "\n";
        }
        i = i + 1;
    }
    return out;
}

// --- Minimal TOML parser for ark.toml ---
// Parses [section] headers and key = value lines.
// Returns a Vec of (section, key, value) triples.

struct TomlLine {
    section: str,
    key: str,
    value: str,
}

fn parse_toml(content: str) -> Vec<TomlLine> {
    var result: Vec<TomlLine> = Vec::new();
    var current_section: str = "";
    var lines: Vec<str> = str_split(content, "\n");
    var i: i64 = 0;
    while i < lines.len() {
        var line: str = str_trim(lines[i]);
        if str_len(line) == 0 {
            i = i + 1;
            continue;
        }
        // Comment
        if str_byte_at(line, 0) == 35 {
            i = i + 1;
            continue;
        }
        // Section header: [name]
        if str_byte_at(line, 0) == 91 {
            var slen: i64 = str_len(line);
            if slen >= 2 && str_byte_at(line, slen - 1) == 93 {
                current_section = str_trim(str_slice(line, 1, slen - 1));
            }
            i = i + 1;
            continue;
        }
        // key = value
        var eq_pos: i64 = str_find(line, "=");
        if eq_pos >= 0 {
            var key: str = str_trim(str_slice(line, 0, eq_pos));
            var value: str = str_trim(str_slice(line, eq_pos + 1, str_len(line)));
            // an array over several lines (`authors = [` ... `]`)
            if str_starts_with(value, "[") && str_find(value, "]") < 0 {
                while i + 1 < lines.len() && str_find(value, "]") < 0 {
                    i = i + 1;
                    value = value + " " + str_trim(lines[i]);
                }
            }
            result.push(TomlLine_new(current_section, key, value));
        }
        i = i + 1;
    }
    return result;
}

fn TomlLine_new(section: str, key: str, value: str) -> TomlLine {
    return TomlLine {
        section: section, key: key, value: value
    };
}

// Parse a dependency value: { path = "..." } or { git = "..." } or "1.0.0"
fn parse_dependency(val: str) -> DepSource {
    var v: str = str_trim(val);
    var vlen: i64 = str_len(v);
    // Inline table: { path = "..." } or { git = "..." }
    if vlen >= 2 && str_byte_at(v, 0) == 123 && str_byte_at(v, vlen - 1) == 125 {
        var inner: str = str_slice(v, 1, vlen - 1);
        // Parse key = value pairs separated by commas (not the commas of
        // a `features = [...]` array)
        var parts: Vec<str> = ark_inline_parts(inner);
        var path_val: str = "";
        var git_val: str = "";
        var branch_val: str = "";
        var tag_val: str = "";
        var version_val: str = "";
        var pi: i64 = 0;
        while pi < parts.len() {
            var part: str = str_trim(parts[pi]);
            var eq: i64 = str_find(part, "=");
            if eq >= 0 {
                var pk: str = str_trim(str_slice(part, 0, eq));
                var pv: str = strip_quotes(str_trim(str_slice(part, eq + 1, str_len(part))));
                if pk == "path" {
                    // a TOML string: `"..\\lefty"` is ..\lefty (2g.63); a
                    // path an older ark wrote unescaped reads as before
                    path_val = ark_toml_unstr(str_trim(str_slice(part, eq + 1, str_len(part))));
                }
                if pk == "git" {
                    git_val = pv;
                }
                if pk == "branch" {
                    branch_val = pv;
                }
                if pk == "tag" {
                    tag_val = pv;
                }
                if pk == "version" {
                    version_val = pv;
                }
            }
            pi = pi + 1;
        }
        if str_len(path_val) > 0 {
            return DepSource::Path(path_val);
        }
        if str_len(git_val) > 0 {
            if str_len(branch_val) > 0 {
                return DepSource::GitBranch(git_val, branch_val);
            }
            if str_len(tag_val) > 0 {
                return DepSource::GitTag(git_val, tag_val);
            }
            return DepSource::Git(git_val);
        }
        // `{ version = "1.2", features = [...] }`: a registry pact
        if str_len(version_val) > 0 {
            return DepSource::Registry(version_val);
        }
        return DepSource::Registry("unknown");
    }
    // Simple version string
    return DepSource::Registry(strip_quotes(v));
}

/// The `key = value` parts of an inline table's inside: split on the
/// commas outside quotes and brackets.
fn ark_inline_parts(inner: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var n: i64 = str_len(inner);
    var start: i64 = 0;
    var depth: i64 = 0;
    var in_q: bool = false;
    var i: i64 = 0;
    while i <= n {
        if i == n || (str_byte_at(inner, i) == 44 && !in_q && depth == 0) {
            out.push(str_slice(inner, start, i));
            start = i + 1;
        } else {
            var c: i64 = str_byte_at(inner, i);
            if c == 92 && in_q {
                i = i + 1;
            } else if c == 34 {
                in_q = !in_q;
            } else if c == 91 && !in_q {
                depth = depth + 1;
            } else if c == 93 && !in_q {
                depth = depth - 1;
            }
        }
        i = i + 1;
    }
    return out;
}

/// L5A: the `features = [...]` of a dependency's inline table (none for a
/// plain version string or a table without it).
fn ark_dep_features(val: str) -> Vec<str> {
    var v: str = str_trim(val);
    var vlen: i64 = str_len(v);
    if vlen < 2 || str_byte_at(v, 0) != 123 || str_byte_at(v, vlen - 1) != 125 {
        return Vec::new();
    }
    var parts: Vec<str> = ark_inline_parts(str_slice(v, 1, vlen - 1));
    var i: i64 = 0;
    while i < parts.len() {
        var part: str = str_trim(parts[i]);
        var eq: i64 = str_find(part, "=");
        if eq > 0 && str_trim(str_slice(part, 0, eq)) == "features" {
            return ark_toml_array(str_slice(part, eq + 1, str_len(part)));
        }
        i = i + 1;
    }
    return Vec::new();
}

/// L5E: does a dependency's inline table say `binary = true`?
fn ark_dep_binary(val: str) -> bool {
    var v: str = str_trim(val);
    var vlen: i64 = str_len(v);
    if vlen < 2 || str_byte_at(v, 0) != 123 || str_byte_at(v, vlen - 1) != 125 {
        return false;
    }
    var parts: Vec<str> = ark_inline_parts(str_slice(v, 1, vlen - 1));
    var i: i64 = 0;
    while i < parts.len() {
        var part: str = str_trim(parts[i]);
        var eq: i64 = str_find(part, "=");
        if eq > 0 && str_trim(str_slice(part, 0, eq)) == "binary" {
            return str_trim(str_slice(part, eq + 1, str_len(part))) == "true";
        }
        i = i + 1;
    }
    return false;
}

/// `a` with the strings of `b` it lacks added, in order.
fn ark_union(a: Vec<str>, b: Vec<str>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < a.len() {
        if !ark_has(out, a[i]) {
            out.push(a[i]);
        }
        i = i + 1;
    }
    var j: i64 = 0;
    while j < b.len() {
        if !ark_has(out, b[j]) {
            out.push(b[j]);
        }
        j = j + 1;
    }
    return out;
}

/// L5A: the features a package with the ark.toml `text` has on, asked for
/// `wanted`: `wanted` and its [features] `default` (unless `wanted` holds
/// "-default"), each one's own list from [features] (`full = ["a",
/// "b"]`) followed until nothing is added. A `dep/feature` entry (a
/// feature of a pact of that package) is left out here: ark_resolve_features
/// reads those through ark_feature_closure_full.
fn ark_feature_closure(text: str, wanted: Vec<str>) -> Vec<str> {
    return ark_feature_closure_full(text, wanted, false);
}

/// ark_feature_closure, with the `dep/feature` (and `dep?/feature`)
/// entries the features on name kept in the result when `keep_dep`.
fn ark_feature_closure_full(text: str, wanted: Vec<str>, keep_dep: bool) -> Vec<str> {
    var table: Vec<TomlLine> = Vec::new();
    var toml: Vec<TomlLine> = parse_toml(text);
    var t: i64 = 0;
    while t < toml.len() {
        if toml[t].section == "features" {
            table.push(toml[t]);
        }
        t = t + 1;
    }
    var work: Vec<str> = Vec::new();
    var no_default: bool = ark_has(wanted, "-default");
    var w: i64 = 0;
    while w < wanted.len() {
        if wanted[w] != "-default" {
            work.push(wanted[w]);
        }
        w = w + 1;
    }
    if !no_default {
        work.push("default");
    }
    var out: Vec<str> = Vec::new();
    var k: i64 = 0;
    while k < work.len() {
        var f: str = work[k];
        k = k + 1;
        if ark_has(out, f) || str_len(f) == 0 {
            continue;
        }
        if str_contains(f, "/") {
            if keep_dep {
                out.push(f);
            }
            continue;
        }
        var listed: bool = false;
        var j: i64 = 0;
        while j < table.len() {
            if table[j].key == f || table[j].key == "\"" + f + "\"" {
                listed = true;
                var more: Vec<str> = ark_toml_array(table[j].value);
                var m: i64 = 0;
                while m < more.len() {
                    work.push(more[m]);
                    m = m + 1;
                }
            }
            j = j + 1;
        }
        // `default` is a feature only when [features] names it
        if f != "default" || listed {
            out.push(f);
        }
    }
    return out;
}

fn dep_kind_str(d: DepSource) -> str {
    match d {
        DepSource::Path(_) => {
            return "path";
        }
        DepSource::Git(_) => {
            return "git";
        }
        DepSource::GitBranch(_, _) => {
            return "git";
        }
        DepSource::GitTag(_, _) => {
            return "git";
        }
        DepSource::Registry(_) => {
            return "registry";
        }
    }
    return "unknown";
}

fn dep_source_str(d: DepSource) -> str {
    match d {
        DepSource::Path(p) => {
            return p;
        }
        DepSource::Git(u) => {
            return u;
        }
        DepSource::GitBranch(u, _) => {
            return u;
        }
        DepSource::GitTag(u, _) => {
            return u;
        }
        DepSource::Registry(v) => {
            return v;
        }
    }
    return "";
}

// --- Manifest operations ---

fn Manifest_new(name: str) -> Manifest {
    return Manifest {
        pkg_name: name, pkg_version: "0.1.0", pkg_edition: "2026", pkg_authors: Vec::new(), pkg_description: "", pkg_license: "", pacts: Vec::new(), dev_pacts: Vec::new(), pkg_extra: "", other_sections: "",
    };
}

fn manifest_load() -> Manifest {
    // read_file: p_file_read gives a raw 0 when the file is missing
    var content: str = "";
    match read_file(MANIFEST_FILE) {
        Option::Some(c) => {
            content = c;
        }
        Option::None => {
        }
    }
    if str_len(content) == 0 {
        p_eprint_str("Cannot read ");
        p_eprint_str(MANIFEST_FILE);
        p_eprint_str(". Run 'ark init' first.\n");
        return Manifest_new("");
    }
    var m: Manifest = manifest_parse(content);
    if str_len(m.pkg_name) == 0 {
        p_eprint_str(MANIFEST_FILE);
        p_eprint_str(" has no [package] name.\n");
    }
    return m;
}

/// The manifest in the text `content` of an ark.toml (its own, or a
/// pact's: CD4 reads the [dependencies] of each pact). The name is "" when
/// [package] has none.
fn manifest_parse(content: str) -> Manifest {
    var toml: Vec<TomlLine> = parse_toml(content);
    var m: Manifest = Manifest_new("");
    var i: i64 = 0;
    while i < toml.len() {
        var entry: TomlLine = toml[i];
        // [package] section
        if entry.section == "package" {
            if entry.key == "name" {
                m.pkg_name = strip_quotes(entry.value);
            }
            if entry.key == "version" {
                m.pkg_version = strip_quotes(entry.value);
            }
            if entry.key == "edition" {
                m.pkg_edition = strip_quotes(entry.value);
            }
            // L5A: authors, description, license
            if entry.key == "authors" {
                m.pkg_authors = ark_toml_array(entry.value);
            }
            if entry.key == "description" {
                m.pkg_description = ark_toml_unstr(entry.value);
            }
            if entry.key == "license" {
                m.pkg_license = ark_toml_unstr(entry.value);
            }
        }
        // [dependencies] section -- each key is a pact name
        if entry.section == "dependencies" {
            var dep: DepSource = parse_dependency(entry.value);
            var pe: PactEntry = PactEntry_new(entry.key, dep);
            pe.features = ark_dep_features(entry.value);
            pe.binary = ark_dep_binary(entry.value);
            m.pacts.push(pe);
        }
        // L5A: [dev-dependencies] -- pacts for tests only
        if entry.section == "dev-dependencies" {
            var ddep: DepSource = parse_dependency(entry.value);
            var dpe: PactEntry = PactEntry_new(entry.key, ddep);
            dpe.features = ark_dep_features(entry.value);
            dpe.binary = ark_dep_binary(entry.value);
            m.dev_pacts.push(dpe);
        }
        i = i + 1;
    }
    m.pkg_extra = ark_extra_lines(content, true);
    m.other_sections = ark_extra_lines(content, false);
    return m;
}

/// The line of ark.toml that declares pact `p`.
fn ark_dep_line(p: PactEntry) -> str {
    // L5A: `, features = [...]` when the line asks for features
    var feat: str = "";
    if p.features.len() > 0 {
        feat = ", features = " + ark_toml_list(p.features);
    }
    // L5E: `, binary = true` (its prebuilt library)
    if p.binary {
        feat = feat + ", binary = true";
    }
    match p.source {
        DepSource::Path(p_path) => {
            // `/` separators: a `\` before the closing quote would escape it
            return p.name + " = { path = " + quote(str_replace(p_path, "\\", "/")) + feat + " }\n";
        }
        DepSource::Git(g_url) => {
            return p.name + " = { git = " + quote(g_url) + feat + " }\n";
        }
        DepSource::GitBranch(g_url, g_branch) => {
            return p.name + " = { git = " + quote(g_url) + ", branch = " + quote(g_branch) + feat + " }\n";
        }
        DepSource::GitTag(g_url, g_tag) => {
            return p.name + " = { git = " + quote(g_url) + ", tag = " + quote(g_tag) + feat + " }\n";
        }
        DepSource::Registry(r_ver) => {
            if str_len(feat) > 0 {
                return p.name + " = { version = " + quote(r_ver) + feat + " }\n";
            }
            return p.name + " = " + quote(r_ver) + "\n";
        }
    }
    return "";
}

/// The text of ark.toml for `m`: [package] (every field, authors,
/// description and license too), [dependencies], [dev-dependencies], then
/// the keys and sections ark does not interpret, as they were written.
fn manifest_text(m: Manifest) -> str {
    var out: str = "";
    out = out + "# ark.toml -- Fides package manifest\n";
    out = out + "# Generated by ark (https://ark.dev)\n\n";
    out = out + "[package]\n";
    out = out + "name = " + quote(m.pkg_name) + "\n";
    out = out + "version = " + quote(m.pkg_version) + "\n";
    out = out + "edition = " + quote(m.pkg_edition) + "\n";
    out = out + "authors = " + ark_toml_list(m.pkg_authors) + "\n";
    out = out + "description = " + ark_toml_str(m.pkg_description) + "\n";
    out = out + "license = " + ark_toml_str(m.pkg_license) + "\n";
    out = out + m.pkg_extra;
    if m.pacts.len() > 0 {
        out = out + "\n[dependencies]\n";
        var i: i64 = 0;
        while i < m.pacts.len() {
            out = out + ark_dep_line(m.pacts[i]);
            i = i + 1;
        }
    }
    if m.dev_pacts.len() > 0 {
        out = out + "\n[dev-dependencies]\n";
        var d: i64 = 0;
        while d < m.dev_pacts.len() {
            out = out + ark_dep_line(m.dev_pacts[d]);
            d = d + 1;
        }
    }
    if str_len(m.other_sections) > 0 {
        out = out + "\n" + m.other_sections;
    }
    return out;
}

fn manifest_save(m: Manifest) -> void {
    p_file_write(MANIFEST_FILE, manifest_text(m));
}

fn PactEntry_new(name: str, source: DepSource) -> PactEntry {
    return PactEntry {
        name: name, source: source, features: Vec::new(), binary: false
    };
}

/// `pacts` without the one named `name`.
fn ark_without(pacts: Vec<PactEntry>, name: str) -> Vec<PactEntry> {
    var out: Vec<PactEntry> = Vec::new();
    var i: i64 = 0;
    while i < pacts.len() {
        if pacts[i].name != name {
            out.push(pacts[i]);
        }
        i = i + 1;
    }
    return out;
}

/// The position of pact `name` in the [dev-dependencies] of `m`, or -1.
fn manifest_find_dev_pact(m: Manifest, name: str) -> i64 {
    var i: i64 = 0;
    while i < m.dev_pacts.len() {
        if m.dev_pacts[i].name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn manifest_find_pact(m: Manifest, name: str) -> i64 {
    var i: i64 = 0;
    while i < m.pacts.len() {
        if m.pacts[i].name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// --- Lock file ---

struct LockEntry {
    name: str,
    source: str,
    resolved: str,
    kind: str,
    // CD4: the pact that needs it ("" for one of ark.toml), the version
    // chosen for a registry pact; L5A: a dev-dependency (ark_modules/.dev/)
    via: str,
    version: str,
    dev: bool,
    // L5A: the features ark install turned on in it (ark_resolve_features:
    // what the requirements ask for, its default, what those name, and the
    // `dep/feature` entries of the packages that need it)
    features: Vec<str>,
}

fn lock_save(entries: Vec<LockEntry>) -> void {
    lock_save_to(LOCK_FILE, "# ark.lock -- resolved pacts\n", entries);
}

/// `entries` written to `path` in ark.lock's format (vendor/vendor.lock
/// too), after the first comment line `title`.
fn lock_save_to(path: str, title: str, entries: Vec<LockEntry>) -> void {
    var out: str = "";
    out = out + title;
    out = out + "# DO NOT EDIT -- generated by ark\n\n";
    var i: i64 = 0;
    while i < entries.len() {
        var e: LockEntry = entries[i];
        out = out + "[[pact]]\n";
        out = out + "name = " + quote(e.name) + "\n";
        out = out + "source = " + quote(e.source) + "\n";
        out = out + "resolved = " + quote(e.resolved) + "\n";
        out = out + "kind = " + quote(e.kind) + "\n";
        if str_len(e.version) > 0 {
            out = out + "version = " + quote(e.version) + "\n";
        }
        if str_len(e.via) > 0 {
            out = out + "via = " + quote(e.via) + "\n";
        }
        if e.dev {
            out = out + "dev = true\n";
        }
        if e.features.len() > 0 {
            out = out + "features = " + ark_toml_list(e.features) + "\n";
        }
        out = out + "\n";
        i = i + 1;
    }
    p_file_write(path, out);
}

fn LockEntry_new(name: str, source: str, resolved: str, kind: str) -> LockEntry {
    return LockEntry {
        name: name, source: source, resolved: resolved, kind: kind, via: "", version: "", dev: false, features: Vec::new()
    };
}

/// A lock entry with all its fields (CD4: `via`, `version`; L5A: `dev`).
fn LockEntry_full(name: str, source: str, resolved: str, kind: str, via: str, version: str, dev: bool) -> LockEntry {
    return LockEntry {
        name: name, source: source, resolved: resolved, kind: kind, via: via, version: version, dev: dev, features: Vec::new()
    };
}

/// `e` with the features ark install turned on in it (L5A).
fn LockEntry_with_features(e: LockEntry, features: Vec<str>) -> LockEntry {
    return LockEntry {
        name: e.name, source: e.source, resolved: e.resolved, kind: e.kind, via: e.via, version: e.version, dev: e.dev, features: features
    };
}

/// TL9: the entries of ark.lock (none when there is no lock file). Each
/// `[[pact]]` block gives one entry; `resolved` is the git commit of a git
/// pact and "fnv:<hash>" of the files of a path pact.
fn lock_load() -> Vec<LockEntry> {
    // L5F: a workspace member reads the workspace's one ark.lock
    if str_len(g_ark_ws_root) > 0 {
        return lock_load_from(g_ark_ws_root + "/" + LOCK_FILE);
    }
    return lock_load_from(LOCK_FILE);
}

/// The entries of a lock file in ark.lock's format at `path` (none when it
/// is missing).
fn lock_load_from(path: str) -> Vec<LockEntry> {
    var out: Vec<LockEntry> = Vec::new();
    var content: str = "";
    match read_file(path) {
        Option::Some(c) => {
            content = c;
        }
        Option::None => {
            return out;
        }
    }
    var toml: Vec<TomlLine> = parse_toml(content);
    var name: str = "";
    var source: str = "";
    var resolved: str = "";
    var kind: str = "";
    var via: str = "";
    var version: str = "";
    var dev: bool = false;
    var feats: Vec<str> = Vec::new();
    var have: bool = false;
    var i: i64 = 0;
    while i < toml.len() {
        var t: TomlLine = toml[i];
        if t.key == "name" {
            if have {
                out.push(LockEntry_with_features(LockEntry_full(name, source, resolved, kind, via, version, dev), feats));
            }
            name = strip_quotes(t.value);
            source = "";
            resolved = "";
            kind = "";
            via = "";
            version = "";
            dev = false;
            feats = Vec::new();
            have = true;
        } else if t.key == "source" {
            source = strip_quotes(t.value);
        } else if t.key == "resolved" {
            resolved = strip_quotes(t.value);
        } else if t.key == "kind" {
            kind = strip_quotes(t.value);
        } else if t.key == "via" {
            via = strip_quotes(t.value);
        } else if t.key == "version" {
            version = strip_quotes(t.value);
        } else if t.key == "dev" {
            dev = str_trim(t.value) == "true";
        } else if t.key == "features" {
            feats = ark_toml_array(t.value);
        }
        i = i + 1;
    }
    if have {
        out.push(LockEntry_with_features(LockEntry_full(name, source, resolved, kind, via, version, dev), feats));
    }
    return out;
}

/// The `resolved` of pact `name` in `lock`, or "".
fn lock_resolved(lock: Vec<LockEntry>, name: str) -> str {
    var i: i64 = 0;
    while i < lock.len() {
        if lock[i].name == name {
            return lock[i].resolved;
        }
        i = i + 1;
    }
    return "";
}

// --- TL9: hosts, hashes, git -------------------------------------------------

fn ark_is_windows() -> bool {
    match env_var("OS") {
        Option::Some(v) => {
            return v == "Windows_NT";
        }
        Option::None => {
        }
    }
    return false;
}

/// FNV-1a over `s`, folded into `h`.
@wrapping
fn ark_fnv(h: i64, s: str) -> i64 {
    var hash: i64 = h;
    var i: i64 = 0;
    var n: i64 = str_len(s);
    while i < n {
        hash = hash ^ (str_byte_at(s, i) & 0xFF);
        hash = hash * 1099511628211;
        i = i + 1;
    }
    return hash;
}

/// Is `path` a directory?
fn ark_is_dir(path: str) -> bool {
    // 2g.63: without a trailing `/` or `\` (`../lefty/`): the Windows C
    // runtime's stat() fails on one, so a directory pact read as missing.
    // A root (`/`, `C:/`) keeps it.
    var p: str = path;
    while str_len(p) > 1 && (str_ends_with(p, "/") || str_ends_with(p, "\\")) && !str_ends_with(p, ":/") && !str_ends_with(p, ":\\") {
        p = str_slice(p, 0, str_len(p) - 1);
    }
    return p_is_dir(p) != 0;
}

/// The .fd files under `dir` (recursively; not inside .git), appended to `out`.
fn ark_collect_fd(dir: str, out: &mut Vec<str>) {
    var listing: str = p_dir_list(dir);
    if str_len(listing) == 0 {
        return;
    }
    var names: Vec<str> = str_split(listing, "\n");
    var i: i64 = 0;
    while i < names.len() {
        var nm: str = str_trim(names[i]);
        if str_len(nm) > 0 && nm != ".git" {
            var full: str = dir + "/" + nm;
            if ark_is_dir(full) {
                ark_collect_fd(full, out);
            } else if str_ends_with(nm, ".fd") {
                out.push(full);
            }
        }
        i = i + 1;
    }
}

/// The files a path pact installed at `dest` (a file or a directory) holds.
fn ark_pact_files(dest: str) -> Vec<str> {
    var files: Vec<str> = Vec::new();
    if ark_is_dir(dest) {
        ark_collect_fd(dest, &mut files);
    } else if p_file_exists(dest) {
        files.push(dest);
    }
    return files;
}

/// a + b, wrapping on overflow.
@wrapping
fn ark_wrap_add(a: i64, b: i64) -> i64 {
    return a + b;
}

/// "fnv:<hash>" of the files under `dest`: each file's path relative to
/// `dest` and its contents; the sum is independent of the listing order.
fn ark_tree_hash(dest: str) -> str {
    var files: Vec<str> = ark_pact_files(dest);
    var total: i64 = 0;
    var i: i64 = 0;
    while i < files.len() {
        var f: str = files[i];
        var h: i64 = ark_fnv(8834263827529598795, str_slice(f, str_len(dest), str_len(f)));
        match read_file(f) {
            Option::Some(c) => {
                h = ark_fnv(h, c);
            }
            Option::None => {
            }
        }
        total = ark_wrap_add(total, h);
        i = i + 1;
    }
    return "fnv:" + int_to_str(total);
}

/// The commit checked out in the git work tree `dest`, or "".
fn ark_git_head(dest: str) -> str {
    var tmp: str = MODULES_DIR + "/.ark_rev";
    if p_system("git -C " + ark_q(dest) + " rev-parse HEAD > " + ark_q(tmp)) != 0 {
        return "";
    }
    var rev: str = "";
    match read_file(tmp) {
        Option::Some(s) => {
            rev = str_trim(s);
        }
        Option::None => {
        }
    }
    p_file_delete(tmp);
    return rev;
}

/// Install (or, with `update`, bring up to date) the git pact `name` from
/// `url` at branch or tag `gref` ("" for the default branch). A commit in
/// the lock (`locked`) is checked out unless updating. The commit now
/// checked out, or "" on failure.
fn ark_install_git(name: str, url: str, gref: str, locked: str, update: bool) -> str {
    return ark_install_git_at(MODULES_DIR + "/" + name, name, url, gref, locked, update);
}

/// ark_install_git into `dest`, cloning straight from `url` (no shared
/// cache: there is no home directory to keep one in).
fn ark_install_git_at(dest: str, name: str, url: str, gref: str, locked: str, update: bool) -> str {
    // BG285: the manifest's (or a dependency's) URL, branch/tag and locked
    // commit are checked, then quoted: they were shell syntax
    val bad: str = ark_git_args_error(name, url, gref, locked);
    if str_len(bad) > 0 {
        p_eprint_str(bad + "\n");
        return "";
    }
    if !ark_is_dir(dest) {
        var cmd: str = "git clone --quiet";
        // a locked commit may be older than a shallow clone reaches
        if str_len(locked) == 0 || update {
            cmd = cmd + " --depth 1";
        }
        if str_len(gref) > 0 {
            cmd = cmd + " --branch " + ark_q(gref);
        }
        if p_system(cmd + " " + ark_q(url) + " " + ark_q(dest)) != 0 {
            return "";
        }
    } else if update {
        if p_system("git -C " + ark_q(dest) + " pull --quiet --ff-only") != 0 {
            p_eprint_str("ark: git pull failed for '" + name + "'; keeping the checkout\n");
        }
    }
    if str_len(locked) > 0 && !update {
        if p_system("git -C " + ark_q(dest) + " checkout --quiet " + ark_q(locked)) != 0 {
            p_system("git -C " + ark_q(dest) + " fetch --quiet --unshallow");
            if p_system("git -C " + ark_q(dest) + " checkout --quiet " + ark_q(locked)) != 0 {
                p_eprint_str("ark: the locked commit " + locked + " of '" + name + "' is not in " + url + "\n");
                return "";
            }
        }
    }
    return ark_git_head(dest);
}

/// Install the path pact `name` from `src` (a file becomes
/// ark_modules/<name>.fd, which `use <name>` finds; a directory is copied
/// to ark_modules/<name>/). "fnv:<hash>" of what was installed, or "".
fn ark_install_path(name: str, src: str) -> str {
    return ark_install_path_in(MODULES_DIR, name, src);
}

/// ark_install_path into the directory of pacts `base` (ark_modules/, or
/// ark_modules/.dev/ for a dev-dependency).
fn ark_install_path_in(base: str, name: str, src: str) -> str {
    if ark_is_dir(src) {
        var dest: str = base + "/" + name;
        // no trailing separator: `"..\lefty\"` would end in an escaped quote
        var from: str = src;
        while str_len(from) > 1 && (str_ends_with(from, "/") || str_ends_with(from, "\\")) {
            from = str_slice(from, 0, str_len(from) - 1);
        }
        // 2g.63: both paths quoted (a folder with a space, as under
        // C:\Users\<first last>, made xcopy fail and the pact "unreadable")
        var cmd: str = "cp -R " + ark_q(from + "/.") + " " + ark_q(dest);
        if ark_is_windows() {
            // xcopy reads `/` as a switch: Windows separators
            cmd = "xcopy /E /I /Y /Q " + ark_q(str_replace(from, "/", "\\")) + " " + ark_q(str_replace(dest, "/", "\\")) + " >nul";
        } else {
            p_system("mkdir -p " + ark_q(dest));
        }
        if p_system(cmd) != 0 {
            return "";
        }
        if ark_pact_files(dest).len() == 0 {
            p_eprint_str("ark: warning: the directory " + src + " of pact '" + name + "' holds no .fd file: `use " + name + ";` will not find it\n");
        }
        return ark_tree_hash(dest);
    }
    // 2g.63: `--path ../lefty` for the single file ../lefty.fd
    if !ark_exists(src) && ark_exists(src + ".fd") {
        return ark_install_path_in(base, name, src + ".fd");
    }
    match read_file(src) {
        Option::Some(content) => {
            var dest2: str = base + "/" + name + ".fd";
            p_file_write(dest2, content);
            return ark_tree_hash(dest2);
        }
        Option::None => {
        }
    }
    return "";
}

/// Where pact `name` of kind `kind` is installed.
fn ark_pact_dest(name: str, kind: str) -> str {
    return ark_pact_dest_in(MODULES_DIR, name, kind);
}

/// Where pact `name` of kind `kind` is installed under `base`.
fn ark_pact_dest_in(base: str, name: str, kind: str) -> str {
    var dir: str = base + "/" + name;
    if kind == "path" && !ark_is_dir(dir) {
        return dir + ".fd";
    }
    return dir;
}

/// The directory of pacts that holds the dev-dependencies (L5A): `fid
/// test` looks there after ark_modules/, a normal build does not.
fn ark_dev_dir() -> str {
    return MODULES_DIR + "/.dev";
}

/// ark_modules/, or ark_modules/.dev/ for a dev-dependency.
fn ark_base(dev: bool) -> str {
    // L5F: in a workspace member, the workspace root's (shared) copy
    var pre: str = "";
    if str_len(g_ark_ws_root) > 0 {
        pre = g_ark_ws_root + "/";
    }
    if dev {
        return pre + ark_dev_dir();
    }
    return pre + MODULES_DIR;
}

/// The revision installed now for pact `name` ("" when not installed).
fn ark_installed_rev(name: str, kind: str) -> str {
    return ark_installed_rev_in(MODULES_DIR, name, kind);
}

/// ark_installed_rev under the directory of pacts `base`.
fn ark_installed_rev_in(base: str, name: str, kind: str) -> str {
    var dest: str = ark_pact_dest_in(base, name, kind);
    // a registry pact is a git checkout at the index's commit
    if kind == "git" || kind == "registry" {
        if !ark_is_dir(dest) {
            return "";
        }
        return ark_git_head(dest);
    }
    if !ark_is_dir(dest) && p_file_exists(dest) == false {
        return "";
    }
    return ark_tree_hash(dest);
}

/// How many times `pat` occurs in `s`.
fn ark_count(s: str, pat: str) -> i64 {
    var count: i64 = 0;
    var from: i64 = 0;
    var plen: i64 = str_len(pat);
    loop {
        var at: i64 = str_find(str_slice(s, from, str_len(s)), pat);
        if at < 0 {
            return count;
        }
        count = count + 1;
        from = from + at + plen;
    }
    return count;
}

// --- N6 / N8: the package index (port of src/ark.rs) ------------------------
// The index is a Git repository (ARK_INDEX, else DEFAULT_INDEX) with one
// file per package, one line per version: `version git-url tag commit`.
// Versions never change once published; installing checks the commit. The
// local copy is <home>/.ark/index (home: ARK_HOME, USERPROFILE or HOME).

/// The index `ark` reads when ARK_INDEX is not set.
fn ark_default_index() -> str {
    return "https://github.com/pledgeandgrow/pacts.git";
}

/// `s` as one quoted word of a shell command (p_system: cmd.exe on
/// Windows, sh elsewhere). BG285: it only added double quotes, so a `"`,
/// `$(..)`, a backquote or `%VAR%` in the value was shell syntax. sh: in
/// single quotes, each `'` written '\'' (nothing is special inside them).
/// cmd.exe: in double quotes, where & | < > ^ are plain; a `"` (no Windows
/// path holds one) and CR/LF are dropped, and each `%` is written outside
/// the quotes as ^% so no %VAR% expands. Values that name a git ref,
/// commit or URL are also checked first (ark_ref_ok, ark_commit_ok,
/// ark_url_ok): the quoting is the second line of defence.
fn ark_q(s: str) -> str {
    if !ark_is_windows() {
        return "'" + str_replace(s, "'", "'\\''") + "'";
    }
    var t: str = str_replace(str_replace(str_replace(s, "\"", ""), "\r", ""), "\n", "");
    return "\"" + str_replace(t, "%", "\"^%\"") + "\"";
}

/// BG285: can `s` be a git branch or tag name (or HEAD, or a commit)?
/// Letters, digits and / . _ - + @ only (git check-ref-format allows more,
/// but nothing a pact's ref needs), not starting with `-` (git would read
/// an option), no `..`, `@{` or `//`, at most 255 bytes.
fn ark_ref_ok(s: str) -> bool {
    val n: i64 = str_len(s);
    if n == 0 || n > 255 || str_starts_with(s, "-") || str_starts_with(s, "/") {
        return false;
    }
    if str_contains(s, "..") || str_contains(s, "@{") || str_contains(s, "//") {
        return false;
    }
    var i: i64 = 0;
    while i < n {
        val c: i64 = str_byte_at(s, i);
        val alnum: bool = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
        if !alnum && c != 47 && c != 46 && c != 95 && c != 45 && c != 43 && c != 64 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// BG285: is `s` a commit id (4 to 64 hexadecimal digits)?
fn ark_commit_ok(s: str) -> bool {
    val n: i64 = str_len(s);
    if n < 4 || n > 64 {
        return false;
    }
    var i: i64 = 0;
    while i < n {
        val c: i64 = str_byte_at(s, i);
        if !((c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// BG285: can `s` be a git repository URL or path? Not empty, not starting
/// with `-` (git would read an option, as --upload-pack=<command>), not
/// git's `ext::` transport (it runs a command), and none of the
/// characters a shell gives a meaning: " ' ` $ % ; | & < > ^ ! * ? and
/// control characters (spaces, `\` and `:` are kept for local paths).
fn ark_url_ok(s: str) -> bool {
    val n: i64 = str_len(s);
    if n == 0 || n > 2048 || str_starts_with(s, "-") || str_starts_with(str_to_lower(s), "ext::") {
        return false;
    }
    var i: i64 = 0;
    while i < n {
        val c: i64 = str_byte_at(s, i);
        if c < 32 || c == 127 || c == 34 || c == 39 || c == 96 || c == 36 || c == 37 || c == 59 || c == 124 || c == 38 || c == 60 || c == 62 || c == 94 || c == 33 || c == 42 || c == 63 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// BG285: the git URL `url`, ref `gref` ("" none) and commit `commit` (""
/// none) of pact `name` checked before any of them reaches a command; ""
/// when all can be used, else why not (printed by the caller).
fn ark_git_args_error(name: str, url: str, gref: str, commit: str) -> str {
    if !ark_url_ok(url) {
        return "ark: pact '" + name + "': '" + url + "' is not a git URL ark uses (no option, ext:: or shell character)";
    }
    if str_len(gref) > 0 && !ark_ref_ok(gref) {
        return "ark: pact '" + name + "': '" + gref + "' is not a branch or tag name (letters, digits and / . _ - + @)";
    }
    if str_len(commit) > 0 && !ark_commit_ok(commit) {
        return "ark: pact '" + name + "': '" + commit + "' is not a commit id (hexadecimal digits)";
    }
    return "";
}

/// BG411: is `name` a plain pact name, one that stays a single entry of
/// ark_modules/ (ark_modules/<name>, ark_modules/<name>.fd)? Not empty, no
/// `/`, `\`, `:` (a drive letter), `..` or leading `.`, no control
/// character or quote.
fn ark_pact_name_ok(name: str) -> bool {
    val n: i64 = str_len(name);
    if n == 0 || n > 255 || str_starts_with(name, ".") || str_contains(name, "..") {
        return false;
    }
    var i: i64 = 0;
    while i < n {
        val c: i64 = str_byte_at(name, i);
        if c < 32 || c == 127 || c == 47 || c == 92 || c == 58 || c == 34 || c == 39 || c == 96 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Where stderr of a command is thrown away on this host.
fn ark_null() -> str {
    if ark_is_windows() {
        return "nul";
    }
    return "/dev/null";
}

/// The first of ARK_HOME, USERPROFILE, HOME that is set, or "".
fn ark_home() -> str {
    match env_var("ARK_HOME") {
        Option::Some(h) => {
            if str_len(h) > 0 {
                return h;
            }
        }
        Option::None => {
        }
    }
    match env_var("USERPROFILE") {
        Option::Some(h2) => {
            if str_len(h2) > 0 {
                return h2;
            }
        }
        Option::None => {
        }
    }
    match env_var("HOME") {
        Option::Some(h3) => {
            return h3;
        }
        Option::None => {
        }
    }
    return "";
}

/// The local copy of the index ("" when there is no home directory).
fn ark_index_dir() -> str {
    var home: str = ark_home();
    if str_len(home) == 0 {
        return "";
    }
    return home + "/.ark/index";
}

/// What `git <args>` run in `dir` prints on stdout, trimmed; `ok` is false
/// when git fails.
struct ArkGitOut {
    ok: bool,
    out: str,
}

fn ark_git_out(dir: str, args: str) -> ArkGitOut {
    var home: str = ark_home();
    var tmp: str = ".ark_git_out";
    if str_len(home) > 0 {
        ark_mkdirs(home + "/.ark");
        tmp = home + "/.ark/.ark_git_out";
    }
    var rc: i64 = p_system("git -C " + ark_q(dir) + " " + args + " > " + ark_q(tmp) + " 2> " + ark_null());
    var text: str = "";
    match read_file(tmp) {
        Option::Some(s) => {
            text = str_trim(s);
        }
        Option::None => {
        }
    }
    p_file_delete(tmp);
    return ArkGitOut {
        ok: rc == 0, out: text
    };
}

/// Each directory along `path` made (`a`, `a/b`, ...), as `mkdir -p`.
fn ark_mkdirs(path: str) {
    var p: str = str_replace(path, "\\", "/");
    var i: i64 = 1;
    while i <= str_len(p) {
        if i == str_len(p) || str_byte_at(p, i) == 47 {
            var prefix: str = str_slice(p, 0, i);
            // `C:` alone is a drive, not a directory to make
            if !ark_is_dir(prefix) && !str_ends_with(prefix, ":") {
                p_mkdir(prefix);
            }
        }
        i = i + 1;
    }
}

/// The index brought up to date (cloned the first time), or "" when it
/// cannot be had. Offline, a copy from an earlier update still answers.
fn ark_update_index() -> str {
    var dir: str = ark_index_dir();
    if str_len(dir) == 0 {
        p_eprint_str("ark: set ARK_HOME (no USERPROFILE or HOME to keep the index in)\n");
        return "";
    }
    var url: str = ark_default_index();
    match env_var("ARK_INDEX") {
        Option::Some(u) => {
            if str_len(u) > 0 {
                url = u;
            }
        }
        Option::None => {
        }
    }
    if ark_is_dir(dir + "/.git") {
        var pull: ArkGitOut = ark_git_out(dir, "pull --ff-only -q");
        if !pull.ok {
            p_eprint_str("warning: could not update the index at " + dir + "; using the copy there\n");
        }
        return dir;
    }
    ark_mkdirs(ark_home() + "/.ark");
    if p_system("git clone -q " + ark_q(url) + " " + ark_q(dir)) != 0 {
        p_eprint_str("ark: cannot fetch the index from " + url + "\n");
        return "";
    }
    return dir;
}

/// One version of a package in the index.
struct ArkIndexEntry {
    found: bool,
    version: str,
    git: str,
    tag: str,
    commit: str,
    err: str,
    // N6: yanked (a fifth word `yanked` on its index line): no new lock
    // chooses it; a lock that already records its commit keeps it
    yanked: bool,
}

fn ArkIndexEntry_none(err: str) -> ArkIndexEntry {
    return ArkIndexEntry {
        found: false, version: "", git: "", tag: "", commit: "", err: err, yanked: false
    };
}

/// N6: the entry of one index line (`version git-url tag commit [yanked]`);
/// not `found` when the line has another shape.
fn ark_index_line(line: str) -> ArkIndexEntry {
    var f: Vec<str> = str_split(str_trim(line), " ");
    if f.len() == 4 || (f.len() == 5 && f[4] == "yanked") {
        return ArkIndexEntry {
            found: true, version: f[0], git: f[1], tag: f[2], commit: f[3], err: "", yanked: f.len() == 5
        };
    }
    return ArkIndexEntry_none("");
}

/// The number at the start of `s` (digits only; 0 when there are none).
fn ark_num(s: str) -> i64 {
    var v: i64 = 0;
    var i: i64 = 0;
    while i < str_len(s) && str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 57 && v < 100000000000 {
        v = v * 10 + (str_byte_at(s, i) - 48);
        i = i + 1;
    }
    return v;
}

/// Is version `a` older than `b` (dotted numbers compared part by part)?
fn ark_version_less(a: str, b: str) -> bool {
    var pa: Vec<str> = str_split(a, ".");
    var pb: Vec<str> = str_split(b, ".");
    var i: i64 = 0;
    while i < pa.len() || i < pb.len() {
        var x: i64 = 0;
        var y: i64 = 0;
        if i < pa.len() {
            x = ark_num(pa[i]);
        }
        if i < pb.len() {
            y = ark_num(pb[i]);
        }
        if x != y {
            return x < y;
        }
        i = i + 1;
    }
    return false;
}

/// Does version `v` match `spec`? Clauses separated by commas must all
/// hold; a clause is "" or `*` (any), a version or prefix `1.2` (that
/// version or any `1.2.x`; `=1.2` and `1.2.x`/`1.2.*` too), `^1.2.3`
/// (compatible: >=1.2.3 and below the next breaking version, 2.0.0; for
/// 0.y below 0.(y+1)), `~1.2.3` (>=1.2.3, <1.3.0), or `>=`, `>`, `<=`, `<`
/// a version. A leading `v` is ignored.
fn ark_version_matches(v: str, spec: str) -> bool {
    var clauses: Vec<str> = str_split(spec, ",");
    var i: i64 = 0;
    while i < clauses.len() {
        if !ark_clause_matches(ark_strip_v(v), str_trim(clauses[i])) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// `s` without a leading `v`.
fn ark_strip_v(s: str) -> str {
    var w: str = str_trim(s);
    if str_len(w) > 0 && str_byte_at(w, 0) == 118 {
        return str_slice(w, 1, str_len(w));
    }
    return w;
}

/// `v` compared with `w` part by part: -1, 0 or 1.
fn ark_version_cmp(v: str, w: str) -> i64 {
    if ark_version_less(v, w) {
        return -1;
    }
    if ark_version_less(w, v) {
        return 1;
    }
    return 0;
}

/// The version below which `^w` (`caret`) or `~w` holds.
fn ark_version_ceiling(w: str, caret: bool) -> str {
    var parts: Vec<str> = str_split(w, ".");
    var x: i64 = ark_num(parts[0]);
    if !caret {
        if parts.len() == 1 {
            return int_to_str(x + 1) + ".0.0";
        }
        return int_to_str(x) + "." + int_to_str(ark_num(parts[1]) + 1) + ".0";
    }
    if x > 0 || parts.len() == 1 {
        return int_to_str(x + 1) + ".0.0";
    }
    var y: i64 = ark_num(parts[1]);
    if y > 0 || parts.len() == 2 {
        return "0." + int_to_str(y + 1) + ".0";
    }
    return "0.0." + int_to_str(ark_num(parts[2]) + 1);
}

/// One clause of ark_version_matches.
fn ark_clause_matches(v: str, clause: str) -> bool {
    var c: str = clause;
    if str_len(c) == 0 || c == "*" {
        return true;
    }
    if str_starts_with(c, ">=") {
        return ark_version_cmp(v, ark_strip_v(str_slice(c, 2, str_len(c)))) >= 0;
    }
    if str_starts_with(c, "<=") {
        return ark_version_cmp(v, ark_strip_v(str_slice(c, 2, str_len(c)))) <= 0;
    }
    if str_starts_with(c, ">") {
        return ark_version_cmp(v, ark_strip_v(str_slice(c, 1, str_len(c)))) > 0;
    }
    if str_starts_with(c, "<") {
        return ark_version_cmp(v, ark_strip_v(str_slice(c, 1, str_len(c)))) < 0;
    }
    if str_starts_with(c, "^") || str_starts_with(c, "~") {
        var w: str = ark_strip_v(str_slice(c, 1, str_len(c)));
        if str_len(w) == 0 {
            return true;
        }
        return ark_version_cmp(v, w) >= 0 && ark_version_less(v, ark_version_ceiling(w, str_starts_with(c, "^")));
    }
    if str_starts_with(c, "=") {
        c = str_trim(str_slice(c, 1, str_len(c)));
    }
    var w2: str = ark_strip_v(c);
    // `1.x`, `1.2.*`: the prefix before the wildcard
    if str_ends_with(w2, ".x") || str_ends_with(w2, ".*") || str_ends_with(w2, ".X") {
        w2 = str_slice(w2, 0, str_len(w2) - 2);
    }
    return v == w2 || str_starts_with(v, w2 + ".");
}

/// The newest version of `name` in the index at `index` matching `spec`.
fn ark_index_lookup(index: str, name: str, spec: str) -> ArkIndexEntry {
    var content: str = "";
    match read_file(index + "/" + name) {
        Option::Some(c) => {
            content = c;
        }
        Option::None => {
            return ArkIndexEntry_none("no package '" + name + "' in the index");
        }
    }
    var best: ArkIndexEntry = ArkIndexEntry_none("no version of '" + name + "' matches '" + spec + "'");
    var yanked: i64 = 0;
    var lines: Vec<str> = str_split(content, "\n");
    var i: i64 = 0;
    while i < lines.len() {
        var e: ArkIndexEntry = ark_index_line(lines[i]);
        if e.found && ark_version_matches(e.version, spec) {
            // N6: a yanked version is not chosen for a new lock
            if e.yanked {
                yanked = yanked + 1;
            } else if !best.found || ark_version_less(best.version, e.version) {
                best = e;
            }
        }
        i = i + 1;
    }
    if !best.found && yanked > 0 {
        best.err = "every version of '" + name + "' matching '" + spec + "' is yanked";
    }
    return best;
}

/// Is `name` a pact of the index (a file of its name with at least one
/// version line)? Used by `ark add` with no flag: a bare name of the index
/// is a registry dependency, not a path one.
fn ark_index_has(name: str) -> bool {
    // names the index can never hold (a path inside its .github)
    if str_starts_with(name, ".") || str_len(name) == 0 {
        return false;
    }
    var index: str = ark_update_index();
    if str_len(index) == 0 {
        return false;
    }
    var content: str = "";
    match read_file(index + "/" + name) {
        Option::Some(c) => {
            content = c;
        }
        Option::None => {
            return false;
        }
    }
    var lines: Vec<str> = str_split(content, "\n");
    var i: i64 = 0;
    while i < lines.len() {
        if ark_index_line(lines[i]).found {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Install registry pact `name` (version `spec`) from the index: its git
/// repository at the published tag, refused when the tag no longer points
/// at the commit the index recorded. The commit installed, or "".
fn ark_install_registry(name: str, spec: str) -> str {
    var index: str = ark_update_index();
    if str_len(index) == 0 {
        return "";
    }
    var e: ArkIndexEntry = ark_index_lookup(index, name, spec);
    if !e.found {
        p_eprint_str("ark: " + e.err + "\n");
        return "";
    }
    return ark_install_registry_entry(MODULES_DIR + "/" + name, name, e);
}

/// Install version `e` of registry pact `name` at `dest`: CD3, a checkout
/// of the machine's cached copy of its repository (fetched once per
/// machine), else a clone of its own. Refused when the tag no longer
/// points at the commit the index recorded. The commit installed, or "".
fn ark_install_registry_entry(dest: str, name: str, e: ArkIndexEntry) -> str {
    // BG285: the index's URL, tag and commit are checked before git sees them
    var bad: str = ark_git_args_error(name, e.git, e.tag, e.commit);
    if str_len(bad) == 0 && str_len(e.commit) == 0 {
        bad = "ark: pact '" + name + "': the index gives no commit";
    }
    if str_len(bad) > 0 {
        p_eprint_str(bad + "\n");
        return "";
    }
    var mirror: str = ark_cache_repo(e.git, false);
    if str_len(mirror) > 0 {
        if ark_rev_commit(mirror, e.commit) != e.commit || ark_rev_commit(mirror, e.tag) != e.commit {
            ark_cache_fetch(mirror);
        }
        var tagm: str = ark_rev_commit(mirror, e.tag);
        if tagm != e.commit {
            p_eprint_str("ark: " + name + " " + e.version + ": the tag " + e.tag + " is at " + tagm + ", but the index says " + e.commit + ": refusing to install\n");
            return "";
        }
        return ark_checkout_cached(dest, mirror, e.commit);
    }
    if !ark_is_dir(dest) {
        // the whole history: the commit may not be the branch tip
        if p_system("git clone --quiet " + ark_q(e.git) + " " + ark_q(dest)) != 0 {
            return "";
        }
    } else {
        p_system("git -C " + ark_q(dest) + " fetch --quiet --tags");
    }
    var tagc: ArkGitOut = ark_git_out(dest, "rev-parse " + ark_q(e.tag + "^{commit}"));
    if !tagc.ok || tagc.out != e.commit {
        p_eprint_str("ark: " + name + " " + e.version + ": the tag " + e.tag + " is at " + tagc.out + ", but the index says " + e.commit + ": refusing to install\n");
        return "";
    }
    if p_system("git -C " + ark_q(dest) + " checkout --quiet " + ark_q(e.commit)) != 0 {
        return "";
    }
    print("(registry " + e.version + ") ");
    return ark_git_head(dest);
}

/// The Levenshtein distance between `a` and `b`, byte by byte (CD6's
/// typosquat check).
fn ark_edit_distance(a: str, b: str) -> i64 {
    var la: i64 = str_len(a);
    var lb: i64 = str_len(b);
    var prev: Vec<i64> = Vec::new();
    var j: i64 = 0;
    while j <= lb {
        prev.push(j);
        j = j + 1;
    }
    var i: i64 = 0;
    while i < la {
        var cur: Vec<i64> = Vec::new();
        cur.push(i + 1);
        var k: i64 = 0;
        while k < lb {
            var cost: i64 = 1;
            if str_byte_at(a, i) == str_byte_at(b, k) {
                cost = 0;
            }
            var best: i64 = prev[k + 1] + 1;
            if cur[k] + 1 < best {
                best = cur[k] + 1;
            }
            if prev[k] + cost < best {
                best = prev[k] + cost;
            }
            cur.push(best);
            k = k + 1;
        }
        prev = cur;
        i = i + 1;
    }
    return prev[lb];
}

/// The names of the packages in the local copy of the index (no update).
fn ark_index_names(index: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if str_len(index) == 0 || !ark_is_dir(index) {
        return out;
    }
    var names: Vec<str> = str_split(p_dir_list(index), "\n");
    var i: i64 = 0;
    while i < names.len() {
        var nm: str = str_trim(names[i]);
        if str_len(nm) > 0 && !str_starts_with(nm, ".") {
            out.push(nm);
        }
        i = i + 1;
    }
    return out;
}

/// Is `s` one of `v`?
fn ark_has(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v[i] == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// `names` in ascending order (insertion sort: an index is small).
fn ark_sorted(names: Vec<str>) -> Vec<str> {
    // sort the indices, then take the names in that order
    var order: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < names.len() {
        var at: i64 = order.len();
        var k: i64 = 0;
        while k < order.len() {
            if str_compare(names[i], names[order[k]]) < 0 {
                at = k;
                break;
            }
            k = k + 1;
        }
        order.insert(at, i);
        i = i + 1;
    }
    var out: Vec<str> = Vec::new();
    var j: i64 = 0;
    while j < order.len() {
        out.push(names[order[j]]);
        j = j + 1;
    }
    return out;
}

// --- CD3: one copy of each repository per machine ----------------------------
// A git or registry pact's repository is fetched once per machine, into
// <ARK_CACHE, else home/.ark/cache>/git/<name>-<hash>.git (a mirror, which
// never prunes objects). The checkout is shared too: the cache keeps one
// checkout of each commit (<cache>/checkouts/<name>-<hash>/<commit>, which
// borrows the mirror's objects: git clone --shared), and a project's
// ark_modules/<name> is a link to it (a junction on Windows, a symbolic
// link elsewhere; ark_checkout_linked), which `use` follows like any
// directory. A second project with the same commit fetches and copies
// nothing. ARK_LINK=0 gives each project a checkout of its own (as before);
// a directory of its own already at ark_modules/<name> is kept. Do not edit
// a pact through the link: every project using that commit would see it
// (ark warns when the shared checkout has local changes). Only the
// functions a program reaches are lowered by `fid emit` (compiler/reach.fd),
// so an unused function of a pact adds nothing to a native binary.

/// The per-machine cache of repositories ("" when there is no home
/// directory to keep it in).
fn ark_cache_dir() -> str {
    match env_var("ARK_CACHE") {
        Option::Some(c) => {
            if str_len(c) > 0 {
                return c;
            }
        }
        Option::None => {
        }
    }
    var home: str = ark_home();
    if str_len(home) == 0 {
        return "";
    }
    return home + "/.ark/cache";
}

/// Is `url` a repository on this machine (not a URL)?
fn ark_is_local_url(url: str) -> bool {
    return !str_contains(url, "://") && !str_starts_with(url, "git@") && ark_is_dir(url);
}

/// `url`, with a repository on this machine given as its absolute path
/// (its work tree, or the git directory of a bare one), so the cache's copy
/// fetches from it from anywhere.
fn ark_abs_url(url: str) -> str {
    if ark_is_local_url(url) {
        var bare: ArkGitOut = ark_git_out(url, "rev-parse --is-bare-repository");
        if bare.out != "true" {
            var top: ArkGitOut = ark_git_out(url, "rev-parse --show-toplevel");
            if top.ok && str_len(top.out) > 0 {
                return top.out;
            }
        }
        var g: ArkGitOut = ark_git_out(url, "rev-parse --absolute-git-dir");
        if g.ok && str_len(g.out) > 0 {
            return g.out;
        }
    }
    return url;
}

/// The name of the cache's copy of the repository at `url`: the last part
/// of the url and a hash of all of it.
fn ark_cache_key(url: str) -> str {
    var u: str = str_replace(url, "\\", "/");
    while str_ends_with(u, "/") {
        u = str_slice(u, 0, str_len(u) - 1);
    }
    if str_ends_with(u, "/.git") {
        u = str_slice(u, 0, str_len(u) - 5);
    }
    if str_ends_with(u, ".git") {
        u = str_slice(u, 0, str_len(u) - 4);
    }
    var cut: i64 = str_rfind(u, "/");
    var colon: i64 = str_rfind(u, ":");
    if colon > cut {
        cut = colon;
    }
    var base: str = str_slice(u, cut + 1, str_len(u));
    var safe: str = "";
    var i: i64 = 0;
    while i < str_len(base) && i < 40 {
        var c: i64 = str_byte_at(base, i);
        if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 46 || c == 95 {
            safe = safe + str_slice(base, i, i + 1);
        } else {
            safe = safe + "_";
        }
        i = i + 1;
    }
    var h: str = str_replace(int_to_str(ark_fnv(8834263827529598795, url)), "-", "n");
    return safe + "-" + h + ".git";
}

/// The spelling of `url` the cache is keyed by. A URL is kept; a repository
/// on this machine is its path made absolute from the current directory and
/// normalized (`/` for separators, no `.`/`..` parts or trailing `/`, lower
/// case on Windows, whose paths ignore case), without asking git. The key
/// is then the same whether or not the repository is still there: keyed by
/// git's `--show-toplevel` (ark_abs_url) it was not, and on Windows the
/// path a pact was added by (C:/Users/RUNNER~1/..., the 8.3 form TEMP uses)
/// and the one git reports differed, so with the repository gone the
/// cache's copy was never found (CI: tests/ark/ark-features.sh, CD3 "ark
/// install with the repository gone").
fn ark_cache_url(url: str) -> str {
    if str_contains(url, "://") || str_starts_with(url, "git@") {
        return url;
    }
    var p: str = str_replace(url, "\\", "/");
    if !ark_is_abs(p) {
        var cwd: str = ark_cwd();
        if str_len(cwd) > 0 {
            p = cwd + "/" + p;
        }
    }
    p = ark_norm_path(p);
    while str_len(p) > 1 && str_ends_with(p, "/") {
        p = str_slice(p, 0, str_len(p) - 1);
    }
    if ark_is_windows() {
        p = str_to_lower(p);
    }
    return p;
}

/// Where the cache keeps the repository at `url` ("" without a cache).
fn ark_cache_path(url: str) -> str {
    var cache: str = ark_cache_dir();
    if str_len(cache) == 0 {
        return "";
    }
    return cache + "/git/" + ark_cache_key(ark_cache_url(url));
}

/// The cache's copy of the repository at `url`, cloned the first time this
/// machine needs it; with `fetch`, brought up to date (offline: a warning,
/// and the copy there is used). "" when there is no cache or the first
/// clone fails.
fn ark_cache_repo(url: str, fetch: bool) -> str {
    // BG285: no option, ext:: transport or shell character reaches git
    if !ark_url_ok(url) {
        p_eprint_str("ark: '" + url + "' is not a git URL ark uses (no option, ext:: or shell character)\n");
        return "";
    }
    var dir: str = ark_cache_path(url);
    if str_len(dir) == 0 {
        return "";
    }
    if ark_is_dir(dir) {
        if fetch {
            ark_cache_fetch(dir);
        }
        return dir;
    }
    ark_mkdirs(ark_cache_dir() + "/git");
    if p_system("git clone --quiet --mirror " + ark_q(ark_abs_url(url)) + " " + ark_q(dir)) != 0 {
        p_eprint_str("ark: cannot fetch " + url + "\n");
        return "";
    }
    // checkouts borrow these objects: never prune them
    ark_git_out(dir, "config gc.pruneExpire never");
    ark_git_out(dir, "config gc.auto 0");
    return dir;
}

/// The cache's copy at `dir` brought up to date (a warning when offline).
fn ark_cache_fetch(dir: str) {
    var f: ArkGitOut = ark_git_out(dir, "fetch --quiet --tags origin");
    if !f.ok {
        p_eprint_str("warning: could not update " + dir + "; using the copy there\n");
    }
}

/// The commit `rev` (a commit, branch, tag or HEAD) names in the
/// repository `dir`, or "".
fn ark_rev_commit(dir: str, rev: str) -> str {
    // BG285: a branch, tag, commit or HEAD, nothing a shell or git reads
    // as more
    if !ark_ref_ok(rev) {
        return "";
    }
    var g: ArkGitOut = ark_git_out(dir, "rev-parse --verify --quiet " + ark_q(rev + "^{commit}"));
    if g.ok {
        return g.out;
    }
    return "";
}

/// The text of `file` at `commit` in the repository `dir` ("" when there
/// is none).
fn ark_git_file(dir: str, commit: str, file: str) -> str {
    if !ark_ref_ok(commit) {
        return "";
    }
    var g: ArkGitOut = ark_git_out(dir, "show " + ark_q(commit + ":" + file));
    if g.ok {
        return g.out;
    }
    return "";
}

/// A git pact resolved against the cache: its copy there and the commit to
/// install ("" for both without a cache; `commit` "" when it cannot be had).
struct ArkGitRev {
    mirror: str,
    commit: str,
}

/// The commit of git pact `url` to install: the locked one unless
/// updating (fetched when the cache lacks it), else the newest of `gref`
/// (a branch or tag) or of the default branch.
fn ark_git_resolve(url: str, gref: str, locked: str, update: bool) -> ArkGitRev {
    // BG285: checked before the cache or git sees them
    val bad: str = ark_git_args_error("?", url, gref, locked);
    if str_len(bad) > 0 {
        p_eprint_str(str_replace(bad, "pact '?': ", "") + "\n");
        return ArkGitRev {
            mirror: "", commit: ""
        };
    }
    var fresh: bool = !ark_is_dir(ark_cache_path(url));
    var mirror: str = ark_cache_repo(url, false);
    if str_len(mirror) == 0 {
        return ArkGitRev {
            mirror: "", commit: ""
        };
    }
    if str_len(locked) > 0 && !update {
        if ark_rev_commit(mirror, locked) != locked && !fresh {
            ark_cache_fetch(mirror);
        }
        if ark_rev_commit(mirror, locked) == locked {
            return ArkGitRev {
                mirror: mirror, commit: locked
            };
        }
        p_eprint_str("ark: the locked commit " + locked + " is not in " + url + "\n");
        return ArkGitRev {
            mirror: mirror, commit: ""
        };
    }
    if !fresh {
        ark_cache_fetch(mirror);
    }
    var rev: str = gref;
    if str_len(rev) == 0 {
        rev = "HEAD";
    }
    return ArkGitRev {
        mirror: mirror, commit: ark_rev_commit(mirror, rev)
    };
}

/// `commit` of the cached repository `mirror` at `dest`. CD3: `dest`
/// (ark_modules/<name>) is a link to the cache's one checkout of that
/// commit (ark_checkout_linked), so the projects that use the same commit
/// of a pact share one working tree; with ARK_LINK=0, or where no link can
/// be made, a checkout of its own (ark_checkout_own). The commit checked
/// out, or "".
fn ark_checkout_cached(dest: str, mirror: str, commit: str) -> str {
    if ark_link_ok() && str_len(commit) > 0 && str_len(ark_cache_dir()) > 0 {
        return ark_checkout_linked(dest, mirror, commit);
    }
    return ark_checkout_own(dest, mirror, commit);
}

/// CD3: may ark_modules/<name> be a link to the cache's checkout? Not with
/// ARK_LINK=0 (or no/false/off): each project then gets a checkout of its
/// own, which borrows the cache's objects.
fn ark_link_ok() -> bool {
    match env_var("ARK_LINK") {
        Option::Some(v) => {
            if v == "0" || v == "no" || v == "false" || v == "off" {
                return false;
            }
        }
        Option::None => {
        }
    }
    return true;
}

/// Where the cache keeps its one checkout of `commit` of the cached
/// repository `mirror`: <cache>/checkouts/<the mirror's name>/<commit>.
fn ark_shared_checkout_path(mirror: str, commit: str) -> str {
    var m: str = str_replace(mirror, "\\", "/");
    while str_len(m) > 1 && str_ends_with(m, "/") {
        m = str_slice(m, 0, str_len(m) - 1);
    }
    var base: str = str_slice(m, str_rfind(m, "/") + 1, str_len(m));
    if str_ends_with(base, ".git") {
        base = str_slice(base, 0, str_len(base) - 4);
    }
    return ark_cache_dir() + "/checkouts/" + base + "/" + commit;
}

/// `path` without the separators at its end.
fn ark_strip_seps(path: str) -> str {
    var p: str = path;
    while str_len(p) > 1 && (str_ends_with(p, "/") || str_ends_with(p, "\\")) {
        p = str_slice(p, 0, str_len(p) - 1);
    }
    return p;
}

/// `path` with Windows separators, for cmd.exe's own commands (mklink,
/// rmdir, dir read `/` as a switch).
fn ark_win_path(path: str) -> str {
    return str_replace(path, "/", "\\");
}

/// Is `path` a link (a symbolic link, or a junction on Windows), even one
/// whose target is gone?
fn ark_is_link(path: str) -> bool {
    var p: str = ark_strip_seps(path);
    if !ark_is_windows() {
        return p_system("test -L " + ark_q(p)) == 0;
    }
    // `dir /AL /B <parent>` lists the names of the junctions and symbolic
    // links in <parent>, one per line
    var w: str = ark_win_path(p);
    var cut: i64 = str_rfind(w, "\\");
    var parent: str = ".";
    var name: str = w;
    if cut >= 0 {
        parent = str_slice(w, 0, cut);
        name = str_slice(w, cut + 1, str_len(w));
        if str_len(parent) == 0 || str_ends_with(parent, ":") {
            parent = parent + "\\";
        }
    }
    var tmp: str = ".ark_links";
    var home: str = ark_home();
    if str_len(home) > 0 {
        ark_mkdirs(home + "/.ark");
        tmp = home + "/.ark/.ark_links";
    }
    var rc: i64 = p_system("dir /AL /B " + ark_q(parent) + " > " + ark_q(tmp) + " 2> nul");
    var found: bool = false;
    if rc == 0 {
        match read_file(tmp) {
            Option::Some(listing) => {
                var names: Vec<str> = str_split(listing, "\n");
                var i: i64 = 0;
                while i < names.len() {
                    // file names on Windows ignore case
                    if str_to_lower(str_trim(names[i])) == str_to_lower(name) {
                        found = true;
                    }
                    i = i + 1;
                }
            }
            Option::None => {
            }
        }
    }
    p_file_delete(tmp);
    return found;
}

/// Remove the link `path` -- the link only, never what it points at
/// (`rmdir` without /S on Windows, `rm` without -r elsewhere).
fn ark_unlink(path: str) -> bool {
    var p: str = ark_strip_seps(path);
    if ark_is_windows() {
        return p_system("rmdir " + ark_q(ark_win_path(p)) + " 2> nul") == 0;
    }
    return p_system("rm " + ark_q(p) + " 2> /dev/null") == 0;
}

/// Make `link` a link to the directory `target` (an absolute path): a
/// junction on Windows (no administrator rights needed), a symbolic link
/// elsewhere.
fn ark_make_link(link: str, target: str) -> bool {
    var l: str = ark_strip_seps(link);
    var t: str = ark_strip_seps(target);
    if ark_is_windows() {
        return p_system("mklink /J " + ark_q(ark_win_path(l)) + " " + ark_q(ark_win_path(t)) + " > nul 2> nul") == 0;
    }
    return p_system("ln -s " + ark_q(t) + " " + ark_q(l) + " 2> /dev/null") == 0;
}

/// CD3: `dest` made a link to the cache's one checkout of `commit` (made
/// from `mirror` the first time any project asks for that commit). A link
/// to another commit's checkout (an older install) is moved, never what it
/// pointed at; a directory of its own at `dest` (made before CD3 shared
/// checkouts, or with ARK_LINK=0) is kept and checked out as before. When
/// the shared checkout or the link cannot be made, `dest` becomes a
/// checkout of its own. The commit checked out, or "".
fn ark_checkout_linked(dest: str, mirror: str, commit: str) -> str {
    var link: bool = ark_is_link(dest);
    if !link && ark_is_dir(dest) {
        return ark_checkout_own(dest, mirror, commit);
    }
    var shared: str = ark_shared_checkout_path(mirror, commit);
    if ark_checkout_own(shared, mirror, commit) != commit {
        p_eprint_str("warning: cannot make the shared checkout " + shared + "; " + dest + " gets a checkout of its own\n");
        if link {
            ark_unlink(dest);
        }
        return ark_checkout_own(dest, mirror, commit);
    }
    // a file changed in the shared checkout is seen by every project
    var st: ArkGitOut = ark_git_out(shared, "status --porcelain");
    if st.ok && str_len(st.out) > 0 {
        p_eprint_str("warning: " + shared + " has local changes, which every project using this commit sees (ARK_LINK=0: a checkout of its own)\n");
    }
    if link {
        if ark_is_dir(dest) && ark_git_head(dest) == commit {
            return commit;
        }
        if !ark_unlink(dest) {
            p_eprint_str("ark: cannot move the link " + dest + "\n");
            return "";
        }
    }
    var slash: i64 = str_rfind(dest, "/");
    if slash > 0 {
        ark_mkdirs(str_slice(dest, 0, slash));
    }
    // the link names an absolute path: git gives the checkout's own
    var target: str = shared;
    var top: ArkGitOut = ark_git_out(shared, "rev-parse --show-toplevel");
    if top.ok && str_len(top.out) > 0 {
        target = top.out;
    }
    if !ark_make_link(dest, target) {
        p_eprint_str("warning: cannot link " + dest + " to " + target + "; a checkout of its own\n");
        return ark_checkout_own(dest, mirror, commit);
    }
    return ark_git_head(dest);
}

/// `commit` of the cached repository `mirror` checked out at `dest`: a
/// clone that borrows the mirror's objects (`git clone --shared`), so only
/// the working tree is copied. The commit checked out, or "".
fn ark_checkout_own(dest: str, mirror: str, commit: str) -> str {
    // BG285: a commit id only (it came from ark.lock or the index)
    if !ark_commit_ok(commit) {
        p_eprint_str("ark: '" + commit + "' is not a commit id (hexadecimal digits)\n");
        return "";
    }
    if !ark_is_dir(dest) {
        var slash: i64 = str_rfind(dest, "/");
        if slash > 0 {
            ark_mkdirs(str_slice(dest, 0, slash));
        }
        if p_system("git clone --quiet --shared --no-checkout " + ark_q(mirror) + " " + ark_q(dest)) != 0 {
            return "";
        }
    }
    var co: str = "git -C " + ark_q(dest) + " checkout --quiet --detach " + ark_q(commit);
    if p_system(co + " 2> " + ark_null()) != 0 {
        // a checkout made before the cache has objects of its own
        p_system("git -C " + ark_q(dest) + " fetch --quiet " + ark_q(mirror));
        if p_system(co) != 0 {
            return "";
        }
    }
    return ark_git_head(dest);
}

// --- CD4: one version of each pact in a build ---------------------------------
// `ark install` reads the [dependencies] of every pact it installs (their
// own ark.toml) as well as the project's, and installs each pact once, in
// ark_modules/. Two pacts asking for the same registry pact get the newest
// version that satisfies both; when none does, or when two ask for
// different git repositories, refs or paths, the install stops and names
// every path that asks, each with what it wants (and, for versions, the
// newest version that satisfies it alone). ark.lock records each pact a
// pact needs with `via`.

/// One requirement on a pact: by the project's ark.toml or a pact's.
struct ArkReq {
    name: str,
    kind: str,
    source: str,
    gref: str,
    chain: str,
    via: str,
    dev: bool,
    // L5A: the features this requirement asks for
    features: Vec<str>,
}

/// The one copy of a pact a build uses.
struct ArkPick {
    name: str,
    kind: str,
    source: str,
    gref: str,
    chain: str,
    via: str,
    dev: bool,
    version: str,
    commit: str,
    mirror: str,
    git: str,
    tag: str,
    spec: str,
    // L5A: the features every requirement on it asks for, and its own
    // ark.toml (for its [features] table)
    features: Vec<str>,
    manifest: str,
}

struct ArkResolution {
    ok: bool,
    picks: Vec<ArkPick>,
}

/// `p` with `.` and `dir/..` parts taken out, `/` for separators.
fn ark_norm_path(p: str) -> str {
    var parts: Vec<str> = str_split(str_replace(p, "\\", "/"), "/");
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < parts.len() {
        var part: str = parts[i];
        if part == "." || (str_len(part) == 0 && i > 0) {
            i = i + 1;
            continue;
        }
        if part == ".." && out.len() > 0 && out[out.len() - 1] != ".." && str_len(out[out.len() - 1]) > 0 && !str_ends_with(out[out.len() - 1], ":") {
            var kept: Vec<str> = Vec::new();
            var k: i64 = 0;
            while k < out.len() - 1 {
                kept.push(out[k]);
                k = k + 1;
            }
            out = kept;
        } else {
            out.push(part);
        }
        i = i + 1;
    }
    var s: str = "";
    var j: i64 = 0;
    while j < out.len() {
        if j > 0 {
            s = s + "/";
        }
        s = s + out[j];
        j = j + 1;
    }
    if str_len(s) == 0 {
        return ".";
    }
    return s;
}

/// Is `p` an absolute path (`/x`, `C:/x`, `C:\x`)?
fn ark_is_abs(p: str) -> bool {
    if str_starts_with(p, "/") || str_starts_with(p, "\\") {
        return true;
    }
    return str_len(p) >= 2 && str_byte_at(p, 1) == 58;
}

/// `p` read from the ark.toml in directory `dir` ("" for the project's own).
fn ark_rel_to(dir: str, p: str) -> str {
    if str_len(dir) == 0 || ark_is_abs(p) {
        return ark_norm_path(p);
    }
    return ark_norm_path(dir + "/" + p);
}

/// The requirement that pact `p` of the ark.toml in `dir` makes (`parent`:
/// the chain that reached that ark.toml; `via`: its pact, "" for the project).
fn ark_req_of(p: PactEntry, parent: str, via: str, dev: bool, dir: str) -> ArkReq {
    var kind: str = "registry";
    var source: str = "";
    var gref: str = "";
    match p.source {
        DepSource::Path(pp) => {
            kind = "path";
            source = ark_rel_to(dir, pp);
        }
        DepSource::Git(u) => {
            kind = "git";
            source = u;
        }
        DepSource::GitBranch(u2, b) => {
            kind = "git";
            source = u2;
            gref = b;
        }
        DepSource::GitTag(u3, t) => {
            kind = "git";
            source = u3;
            gref = t;
        }
        DepSource::Registry(v) => {
            source = v;
        }
    }
    // a git repository on this machine, named relative to a pact's directory
    if kind == "git" && str_len(dir) > 0 && !str_contains(source, "://") && !str_starts_with(source, "git@") && !ark_is_abs(source) {
        source = ark_rel_to(dir, source);
    }
    return ArkReq {
        name: p.name, kind: kind, source: source, gref: gref, chain: parent + " -> " + p.name, via: via, dev: dev, features: p.features
    };
}

/// What requirement `r` wants, for messages.
fn ark_req_text(r: ArkReq) -> str {
    if r.kind == "registry" {
        if str_len(r.source) == 0 {
            return "any version";
        }
        return r.source;
    }
    if str_len(r.gref) > 0 {
        return r.kind + " " + r.source + "#" + r.gref;
    }
    return r.kind + " " + r.source;
}

/// The position of pact `name` in `picks`, or -1.
fn ark_pick_index(picks: Vec<ArkPick>, name: str) -> i64 {
    var i: i64 = 0;
    while i < picks.len() {
        if picks[i].name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Every version of `name` in the index at `index`.
fn ark_index_versions(index: str, name: str) -> Vec<ArkIndexEntry> {
    var out: Vec<ArkIndexEntry> = Vec::new();
    if str_len(index) == 0 {
        return out;
    }
    match read_file(index + "/" + name) {
        Option::Some(content) => {
            var lines: Vec<str> = str_split(content, "\n");
            var i: i64 = 0;
            while i < lines.len() {
                var e: ArkIndexEntry = ark_index_line(lines[i]);
                if e.found {
                    out.push(e);
                }
                i = i + 1;
            }
        }
        Option::None => {
        }
    }
    return out;
}

/// The newest of `versions` that satisfies every spec of `specs`; the one
/// at commit `locked` when it satisfies them (a lock is kept while it can be).
fn ark_pick_version(versions: Vec<ArkIndexEntry>, specs: Vec<str>, locked: str) -> ArkIndexEntry {
    var best: ArkIndexEntry = ArkIndexEntry_none("no version");
    var i: i64 = 0;
    while i < versions.len() {
        var e: ArkIndexEntry = versions[i];
        var ok: bool = true;
        var s: i64 = 0;
        while s < specs.len() {
            if !ark_version_matches(e.version, specs[s]) {
                ok = false;
            }
            s = s + 1;
        }
        if ok {
            if str_len(locked) > 0 && e.commit == locked {
                // N6: kept even when yanked since -- the lock chose it
                if e.yanked {
                    print("warning: " + e.version + " (commit " + ark_short_rev(e.commit) + ", locked) has been yanked from the index; `ark update` moves off it\n");
                }
                return e;
            }
            if e.yanked {
                i = i + 1;
                continue;
            }
            if !best.found || ark_version_less(best.version, e.version) {
                best = e;
            }
        }
        i = i + 1;
    }
    return best;
}

/// The specs of the registry requirements on `name` in `reqs`.
fn ark_specs_of(reqs: Vec<ArkReq>, name: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < reqs.len() {
        if reqs[i].name == name && reqs[i].kind == "registry" {
            out.push(reqs[i].source);
        }
        i = i + 1;
    }
    return out;
}

/// The requirements on `name` in `reqs`.
fn ark_reqs_of(reqs: Vec<ArkReq>, name: str) -> Vec<ArkReq> {
    var out: Vec<ArkReq> = Vec::new();
    var i: i64 = 0;
    while i < reqs.len() {
        if reqs[i].name == name {
            out.push(reqs[i]);
        }
        i = i + 1;
    }
    return out;
}

/// CD4's error: the requirements on `name` that no one copy satisfies,
/// each path with what it wants (a version spec also with the newest
/// version that satisfies it alone).
fn ark_report_conflict(name: str, reqs: Vec<ArkReq>, versions: Vec<ArkIndexEntry>) {
    p_eprint_str("ark: conflicting requirements for '" + name + "':\n");
    var regs: i64 = 0;
    var i: i64 = 0;
    while i < reqs.len() {
        var r: ArkReq = reqs[i];
        var line: str = "  " + r.chain + "  wants " + ark_req_text(r);
        if r.kind == "registry" {
            regs = regs + 1;
            var one: Vec<str> = Vec::new();
            one.push(r.source);
            var e: ArkIndexEntry = ark_pick_version(versions, one, "");
            if e.found {
                line = line + "  (newest: " + e.version + ")";
            } else {
                line = line + "  (no version in the index)";
            }
        }
        p_eprint_str(line + "\n");
        i = i + 1;
    }
    if regs == reqs.len() {
        p_eprint_str("  no version of '" + name + "' satisfies all of them; a build uses one version of each pact\n");
    } else {
        p_eprint_str("  a build uses one copy of each pact: make them name the same source\n");
    }
}

/// Does pick `p` satisfy requirement `r` (same kind and source; for a
/// registry pact, the version chosen matches `r`'s spec)?
fn ark_pick_satisfies(p: ArkPick, r: ArkReq) -> bool {
    if p.kind != r.kind {
        return false;
    }
    if p.kind == "registry" {
        return ark_version_matches(p.version, r.source);
    }
    if p.kind == "git" {
        return ark_abs_url(p.source) == ark_abs_url(r.source) && p.gref == r.gref;
    }
    return ark_norm_path(p.source) == ark_norm_path(r.source);
}

/// CD4: every pact the build needs -- the project's (and, with `with_dev`,
/// its dev-dependencies) and, through each pact's own ark.toml, theirs --
/// one copy each. A registry pact gets the newest version every requirement
/// on it accepts (resolution starts again when a later requirement rules
/// out the version chosen first). `ok` is false after a conflict, reported.
fn ark_resolve(m: Manifest, with_dev: bool, old_lock: Vec<LockEntry>, update: bool, only: str) -> ArkResolution {
    var roots: Vec<ArkReq> = Vec::new();
    var pi0: i64 = 0;
    while pi0 < m.pacts.len() {
        roots.push(ark_req_of(m.pacts[pi0], m.pkg_name, "", false, ""));
        pi0 = pi0 + 1;
    }
    var dev_roots: Vec<ArkReq> = Vec::new();
    var di0: i64 = 0;
    while di0 < m.dev_pacts.len() {
        dev_roots.push(ark_req_of(m.dev_pacts[di0], m.pkg_name, "", true, ""));
        di0 = di0 + 1;
    }
    return ark_resolve_reqs(roots, dev_roots, with_dev, old_lock, update, only);
}

/// ark_resolve from the requirements `roots` and (with `with_dev`)
/// `dev_roots`: one project's pacts, or (L5F) those of every member of a
/// workspace, resolved together -- one copy of each pact for all of them.
fn ark_resolve_reqs(roots: Vec<ArkReq>, dev_roots: Vec<ArkReq>, with_dev: bool, old_lock: Vec<LockEntry>, update: bool, only: str) -> ArkResolution {
    var extra: Vec<ArkReq> = Vec::new();
    var index: str = "";
    var have_index: bool = false;
    var round: i64 = 0;
    while round < 64 {
        var picks: Vec<ArkPick> = Vec::new();
        var reqs: Vec<ArkReq> = Vec::new();
        var queue: Vec<ArkReq> = Vec::new();
        var ri0: i64 = 0;
        while ri0 < roots.len() {
            queue.push(roots[ri0]);
            ri0 = ri0 + 1;
        }
        // the dev-dependencies after everything a normal build needs: a
        // pact both need is a normal one
        var dev_added: bool = !with_dev;
        var restart: bool = false;
        var qi: i64 = 0;
        loop {
            if qi >= queue.len() {
                if dev_added {
                    break;
                }
                dev_added = true;
                var di: i64 = 0;
                while di < dev_roots.len() {
                    queue.push(dev_roots[di]);
                    di = di + 1;
                }
                continue;
            }
            var r: ArkReq = queue[qi];
            qi = qi + 1;
            var upd: bool = update && (str_len(only) == 0 || only == r.name);
            var at: i64 = ark_pick_index(picks, r.name);
            if at >= 0 {
                var p: ArkPick = picks[at];
                if !ark_pick_satisfies(p, r) {
                    var all: Vec<ArkReq> = ark_reqs_of(reqs, r.name);
                    all.push(r);
                    var versions: Vec<ArkIndexEntry> = Vec::new();
                    if p.kind == "registry" && r.kind == "registry" {
                        versions = ark_index_versions(index, r.name);
                        var e: ArkIndexEntry = ark_pick_version(versions, ark_specs_of(all, r.name), "");
                        if e.found {
                            // a version both accept: choose it from the start
                            extra.push(r);
                            restart = true;
                            break;
                        }
                    }
                    ark_report_conflict(r.name, all, versions);
                    return ArkResolution {
                        ok: false, picks: picks
                    };
                }
                // L5A: the one copy has the features of every requirement
                if r.features.len() > 0 {
                    p.features = ark_union(p.features, r.features);
                    picks.set(at, p);
                }
                reqs.push(r);
                continue;
            }
            var locked: str = "";
            if !upd {
                locked = lock_resolved(old_lock, r.name);
            }
            var pick: ArkPick = ArkPick {
                name: r.name, kind: r.kind, source: r.source, gref: r.gref, chain: r.chain, via: r.via, dev: r.dev, version: "", commit: "", mirror: "", git: "", tag: "", spec: r.source, features: r.features, manifest: ""
            };
            var text: str = "";
            if r.kind == "registry" {
                if !have_index {
                    index = ark_update_index();
                    have_index = true;
                }
                if str_len(index) == 0 {
                    return ArkResolution {
                        ok: false, picks: picks
                    };
                }
                var versions2: Vec<ArkIndexEntry> = ark_index_versions(index, r.name);
                if versions2.len() == 0 {
                    p_eprint_str("ark: no package '" + r.name + "' in the index (" + r.chain + ")\n");
                    return ArkResolution {
                        ok: false, picks: picks
                    };
                }
                var mine: Vec<ArkReq> = ark_reqs_of(extra, r.name);
                mine.insert(0, r);
                var specs: Vec<str> = ark_specs_of(mine, r.name);
                var chosen: ArkIndexEntry = ark_pick_version(versions2, specs, locked);
                if !chosen.found {
                    ark_report_conflict(r.name, mine, versions2);
                    return ArkResolution {
                        ok: false, picks: picks
                    };
                }
                pick.version = chosen.version;
                pick.commit = chosen.commit;
                pick.git = chosen.git;
                pick.tag = chosen.tag;
                pick.mirror = ark_cache_repo(chosen.git, false);
                if str_len(pick.mirror) > 0 {
                    if ark_rev_commit(pick.mirror, chosen.commit) != chosen.commit {
                        ark_cache_fetch(pick.mirror);
                    }
                    text = ark_git_file(pick.mirror, chosen.commit, "ark.toml");
                }
            } else if r.kind == "git" {
                var gr: ArkGitRev = ark_git_resolve(r.source, r.gref, locked, upd);
                pick.mirror = gr.mirror;
                pick.commit = gr.commit;
                if str_len(gr.mirror) > 0 {
                    if str_len(gr.commit) == 0 {
                        p_eprint_str("ark: cannot resolve " + ark_req_text(r) + " (" + r.chain + ")\n");
                        return ArkResolution {
                            ok: false, picks: picks
                        };
                    }
                    text = ark_git_file(gr.mirror, gr.commit, "ark.toml");
                }
            } else if ark_is_dir(r.source) {
                match read_file(r.source + "/" + MANIFEST_FILE) {
                    Option::Some(t) => {
                        text = t;
                    }
                    Option::None => {
                    }
                }
            }
            // CD9: a vendored pact's own ark.toml is the vendored one
            if !upd && !r.dev && ark_vendor_state(r.name) == "ok" && ark_is_dir(ark_vendor_dest(r.name)) {
                match read_file(ark_vendor_dest(r.name) + "/" + MANIFEST_FILE) {
                    Option::Some(vt) => {
                        text = vt;
                    }
                    Option::None => {
                    }
                }
            }
            pick.manifest = text;
            picks.push(pick);
            reqs.push(r);
            if str_len(text) > 0 {
                var dm: Manifest = manifest_parse(text);
                var dir: str = "";
                if r.kind == "path" && ark_is_dir(r.source) {
                    dir = r.source;
                }
                var k: i64 = 0;
                while k < dm.pacts.len() {
                    var dp: PactEntry = dm.pacts[k];
                    if r.kind != "path" && dep_kind_str(dp.source) == "path" {
                        p_eprint_str("ark: '" + r.name + "' (" + r.kind + ") needs '" + dp.name + "' by path, which only works inside one checkout (" + r.chain + " -> " + dp.name + ")\n");
                        return ArkResolution {
                            ok: false, picks: picks
                        };
                    }
                    queue.push(ark_req_of(dp, r.chain, r.name, r.dev, dir));
                    k = k + 1;
                }
            }
        }
        if !restart {
            // the versions several pacts agreed on
            var ni: i64 = 0;
            while ni < picks.len() {
                var q: ArkPick = picks[ni];
                var on: Vec<ArkReq> = ark_reqs_of(reqs, q.name);
                if on.len() > 1 && q.kind == "registry" {
                    var said: str = "";
                    var oi: i64 = 0;
                    while oi < on.len() {
                        if oi > 0 {
                            said = said + " and ";
                        }
                        said = said + on[oi].chain + " (" + ark_req_text(on[oi]) + ")";
                        oi = oi + 1;
                    }
                    print(q.name + " " + q.version + ": the newest version for " + said + "\n");
                }
                ni = ni + 1;
            }
            return ArkResolution {
                ok: true, picks: picks
            };
        }
        round = round + 1;
    }
    p_eprint_str("ark: the versions do not settle after 64 rounds\n");
    return ArkResolution {
        ok: false, picks: Vec::new()
    };
}

// --- CD9: vendoring -----------------------------------------------------------
// `ark vendor` copies every installed pact into vendor/ (its source files:
// .fd, .c, .h, .toml, .md; not .git) and writes vendor/vendor.lock with the
// hash of each copy. `use` looks in vendor/ before ark_modules/ (compiler.fd
// ark_push_candidates), so a checkout with vendor/ builds offline; `ark
// install` checks each vendored copy against vendor.lock instead of
// fetching it, and `ark audit` reports a changed copy.

/// Where `ark vendor` puts the pacts, and its lock file.
fn ark_vendor_dir() -> str {
    return "vendor";
}

fn ark_vendor_lock() -> str {
    return "vendor/vendor.lock";
}

/// Is `name` a file `ark vendor` copies?
fn ark_vendored_kind(name: str) -> bool {
    return str_ends_with(name, ".fd") || str_ends_with(name, ".c") || str_ends_with(name, ".h") || str_ends_with(name, ".toml") || str_ends_with(name, ".md");
}

/// The files `ark vendor` copies from `dir` (recursively; not .git),
/// appended to `out`.
fn ark_collect_vendored(dir: str, out: &mut Vec<str>) {
    var listing: str = p_dir_list(dir);
    if str_len(listing) == 0 {
        return;
    }
    var names: Vec<str> = str_split(listing, "\n");
    var i: i64 = 0;
    while i < names.len() {
        var nm: str = str_trim(names[i]);
        if str_len(nm) > 0 && nm != ".git" {
            var full: str = dir + "/" + nm;
            if ark_is_dir(full) {
                ark_collect_vendored(full, out);
            } else if ark_vendored_kind(nm) {
                out.push(full);
            }
        }
        i = i + 1;
    }
}

/// Where pact `name` is vendored ("" when it is not): vendor/<name>/ or
/// vendor/<name>.fd.
fn ark_vendor_dest(name: str) -> str {
    var dir: str = ark_vendor_dir() + "/" + name;
    if ark_is_dir(dir) {
        return dir;
    }
    if p_file_exists(dir + ".fd") {
        return dir + ".fd";
    }
    return "";
}

/// "fnv:<hash>" of what `ark vendor` copied to `dest` (a file or a
/// directory): each file's path relative to `dest` and its contents, as
/// ark_tree_hash, over every vendored file (not only the .fd ones).
fn ark_vendor_hash(dest: str) -> str {
    var files: Vec<str> = Vec::new();
    if ark_is_dir(dest) {
        ark_collect_vendored(dest, &mut files);
    } else if p_file_exists(dest) {
        files.push(dest);
    }
    var total: i64 = 0;
    var i: i64 = 0;
    while i < files.len() {
        var f: str = files[i];
        var h: i64 = ark_fnv(8834263827529598795, str_slice(f, str_len(dest), str_len(f)));
        match read_file(f) {
            Option::Some(c) => {
                h = ark_fnv(h, c);
            }
            Option::None => {
            }
        }
        total = ark_wrap_add(total, h);
        i = i + 1;
    }
    return "fnv:" + int_to_str(total);
}

/// The position of pact `name` in `lock`, or -1.
fn lock_index(lock: Vec<LockEntry>, name: str) -> i64 {
    var i: i64 = 0;
    while i < lock.len() {
        if lock[i].name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// CD9: the vendored copy of pact `name`: "" when there is none, "ok" when
/// it is as vendor/vendor.lock records, else what is wrong with it.
fn ark_vendor_state(name: str) -> str {
    var dest: str = ark_vendor_dest(name);
    if str_len(dest) == 0 {
        return "";
    }
    var now: str = ark_vendor_hash(dest);
    var locked: str = lock_resolved(lock_load_from(ark_vendor_lock()), name);
    if str_len(locked) == 0 {
        return "NOT LOCKED: vendor/ has " + now + " but vendor/vendor.lock does not name it (ark vendor)";
    }
    if locked != now {
        return "CHANGED: vendor/vendor.lock has " + locked + ", vendor/ has " + now;
    }
    return "ok";
}

/// Copy the installed pact at `src` (a file or directory under
/// ark_modules/) to `dest`. The number of files copied.
fn ark_copy_tree(src: str, dest: str) -> i64 {
    if !ark_is_dir(src) {
        match read_file(src) {
            Option::Some(c) => {
                p_file_write(dest, c);
                return 1;
            }
            Option::None => {
            }
        }
        return 0;
    }
    var files: Vec<str> = Vec::new();
    ark_collect_vendored(src, &mut files);
    ark_mkdirs(dest);
    var copied: i64 = 0;
    var i: i64 = 0;
    while i < files.len() {
        var f: str = files[i];
        var rel: str = str_slice(f, str_len(src), str_len(f));
        var to: str = dest + rel;
        var slash: i64 = str_rfind(to, "/");
        if slash > 0 {
            ark_mkdirs(str_slice(to, 0, slash));
        }
        match read_file(f) {
            Option::Some(c2) => {
                p_file_write(to, c2);
                copied = copied + 1;
            }
            Option::None => {
            }
        }
        i = i + 1;
    }
    return copied;
}

// --- Commands ---

fn ark_cmd_init(args: Vec<str>) -> i64 {
    var name: str = "my-project";
    // L5A: [package] authors, description, license from the command line
    var authors: Vec<str> = Vec::new();
    var description: str = "";
    var license: str = "";
    var ai: i64 = 0;
    while ai < args.len() {
        var a: str = args[ai];
        if (a == "--author" || a == "--description" || a == "--license") && ai + 1 < args.len() {
            if a == "--author" {
                authors.push(args[ai + 1]);
            } else if a == "--description" {
                description = args[ai + 1];
            } else {
                license = args[ai + 1];
            }
            ai = ai + 1;
        } else if !str_starts_with(a, "--") {
            name = a;
        }
        ai = ai + 1;
    }
    // Check if ark.toml already exists
    if p_file_exists(MANIFEST_FILE) {
        p_eprint_str(MANIFEST_FILE);
        p_eprint_str(" already exists in this directory.\n");
        return 1;
    }
    var m: Manifest = Manifest_new(name);
    m.pkg_authors = authors;
    m.pkg_description = description;
    m.pkg_license = license;
    manifest_save(m);
    print("Created ");
    print(MANIFEST_FILE);
    print(" for package '");
    print(name);
    print("'\n");
    print("Edit ");
    print(MANIFEST_FILE);
    print(" to add pacts.\n");
    return 0;
}

fn ark_cmd_add(args: Vec<str>) -> i64 {
    if args.len() == 0 {
        p_eprint_str("Usage: ark add <name> [--path <path> | --git <url> | --branch <branch> | --tag <tag>]\n");
        return 1;
    }
    var dep_name: str = args[0];
    // BG411: a pact name is a plain name (it names ark_modules/<name>)
    if !ark_pact_name_ok(dep_name) {
        p_eprint_str("ark: invalid pact name '" + dep_name + "': a pact name is a plain name, with no / \\ : or .., not starting with a dot\n");
        return 1;
    }
    var path_val: str = "";
    var git_val: str = "";
    var branch_val: str = "";
    var tag_val: str = "";
    var version_val: str = "";
    // L5A: --dev puts it in [dev-dependencies] (for `fid test` only)
    var dev: bool = false;
    var add_features: Vec<str> = Vec::new();
    // L5E: --binary: `binary = true` (link its prebuilt library)
    var add_binary: bool = false;
    var i: i64 = 1;
    while i < args.len() {
        if args[i] == "--dev" || args[i] == "-D" {
            dev = true;
        }
        if args[i] == "--binary" {
            add_binary = true;
        }
        if args[i] == "--path" || args[i] == "-p" {
            if i + 1 < args.len() {
                path_val = args[i + 1];
                i = i + 1;
            }
        }
        if args[i] == "--git" || args[i] == "-g" {
            if i + 1 < args.len() {
                git_val = args[i + 1];
                i = i + 1;
            }
        }
        if args[i] == "--branch" || args[i] == "-b" {
            if i + 1 < args.len() {
                branch_val = args[i + 1];
                i = i + 1;
            }
        }
        if args[i] == "--tag" || args[i] == "-t" {
            if i + 1 < args.len() {
                tag_val = args[i + 1];
                i = i + 1;
            }
        }
        // N6: a package of the index, at a version ("1.2", "^1", "*")
        if args[i] == "--version" || args[i] == "-V" {
            if i + 1 < args.len() {
                version_val = args[i + 1];
                i = i + 1;
            }
        }
        // L5A: --features a,b (or --feature a, again for more)
        if (args[i] == "--features" || args[i] == "--feature" || args[i] == "-F") && i + 1 < args.len() {
            var fl: Vec<str> = str_split(args[i + 1], ",");
            var fi: i64 = 0;
            while fi < fl.len() {
                var fname: str = str_trim(fl[fi]);
                if str_len(fname) > 0 && !ark_has(add_features, fname) {
                    add_features.push(fname);
                }
                fi = fi + 1;
            }
            i = i + 1;
        }
        i = i + 1;
    }
    var dep: DepSource = DepSource::Registry("");
    if str_len(path_val) > 0 {
        // 2g.63: stored with `/` (Windows takes it too): `..\lefty\` was
        // written as `path = "..\lefty\"`, whose `\"` is an escaped quote in
        // TOML, not the end of the string
        dep = DepSource::Path(str_replace(path_val, "\\", "/"));
    } else {
        if str_len(git_val) > 0 {
            if str_len(branch_val) > 0 {
                dep = DepSource::GitBranch(git_val, branch_val);
            } else {
                if str_len(tag_val) > 0 {
                    dep = DepSource::GitTag(git_val, tag_val);
                } else {
                    dep = DepSource::Git(git_val);
                }
            }
        } else if str_len(version_val) > 0 {
            dep = DepSource::Registry(version_val);
        } else if ark_index_has(dep_name) {
            // N6: a bare `ark add <name>` of a pact of the index is a
            // registry dependency at `*` (it used to become a path
            // dependency of a directory that does not exist, and install
            // failed: `Path pact 'textkit' cannot be read`)
            dep = DepSource::Registry("*");
        } else {
            // Default: path dependency with dep_name as directory
            dep = DepSource::Path(dep_name);
        }
    }
    var m: Manifest = manifest_load();
    if str_len(m.pkg_name) == 0 {
        return 1;
    }
    // CD6: warn when the name is one edit away from a known package -- a
    // pact already in ark.toml, or one in the local copy of the index
    var near: Vec<str> = Vec::new();
    var ni: i64 = 0;
    while ni < m.pacts.len() {
        var known: str = m.pacts[ni].name;
        if known != dep_name && ark_edit_distance(dep_name, known) == 1 {
            near.push(known);
        }
        ni = ni + 1;
    }
    var indexed: Vec<str> = ark_index_names(ark_index_dir());
    var xi: i64 = 0;
    while xi < indexed.len() {
        var iname: str = indexed[xi];
        if iname != dep_name && ark_edit_distance(dep_name, iname) == 1 && !ark_has(near, iname) {
            near.push(iname);
        }
        xi = xi + 1;
    }
    if near.len() > 0 {
        var listed: str = "";
        var li: i64 = 0;
        while li < near.len() {
            if li > 0 {
                listed = listed + ", ";
            }
            listed = listed + "'" + near[li] + "'";
            li = li + 1;
        }
        p_eprint_str("warning: '" + dep_name + "' is one edit away from " + listed + " -- a typosquat? check the name\n");
    }
    // Remove existing entry with same name (in either section), then add:
    // a pact is a dependency or a dev-dependency, not both
    m.pacts = ark_without(m.pacts, dep_name);
    m.dev_pacts = ark_without(m.dev_pacts, dep_name);
    var added: PactEntry = PactEntry_new(dep_name, dep);
    added.features = add_features;
    added.binary = add_binary;
    if dev {
        m.dev_pacts.push(added);
    } else {
        m.pacts.push(added);
    }
    manifest_save(m);
    print("Added pact '");
    print(dep_name);
    print("' to ");
    print(MANIFEST_FILE);
    if dev {
        print(" [dev-dependencies]");
    }
    print("\n");
    print("Run 'ark install' to install pacts.\n");
    return 0;
}

fn ark_cmd_remove(args: Vec<str>) -> i64 {
    if args.len() == 0 {
        p_eprint_str("Usage: ark remove <name>\n");
        return 1;
    }
    var dep_name: str = args[0];
    var m: Manifest = manifest_load();
    if str_len(m.pkg_name) == 0 {
        return 1;
    }
    var idx: i64 = manifest_find_pact(m, dep_name);
    if idx < 0 && manifest_find_dev_pact(m, dep_name) < 0 {
        p_eprint_str("Pact '");
        p_eprint_str(dep_name);
        p_eprint_str("' not found in ");
        p_eprint_str(MANIFEST_FILE);
        p_eprint_str("\n");
        return 1;
    }
    m.pacts = ark_without(m.pacts, dep_name);
    m.dev_pacts = ark_without(m.dev_pacts, dep_name);
    manifest_save(m);
    // L5E: its binary interface would still answer `use <name>`
    ark_bin_drop_iface(ark_base(false) + "/" + dep_name + ".fd");
    ark_bin_drop_iface(ark_base(true) + "/" + dep_name + ".fd");
    // BG482: its installed copy and its ark.lock entry go too, or `use
    // <name>;` still builds here and fails on a clean checkout (in a
    // workspace member the shared copy is left: other members may use it)
    if str_len(g_ark_ws_root) == 0 && ark_pact_name_ok(dep_name) {
        ark_drop_installed(MODULES_DIR, dep_name);
        ark_drop_installed(ark_dev_dir(), dep_name);
        var lock: Vec<LockEntry> = lock_load();
        var kept: Vec<LockEntry> = Vec::new();
        var li: i64 = 0;
        while li < lock.len() {
            if lock[li].name != dep_name {
                kept.push(lock[li]);
            }
            li = li + 1;
        }
        if kept.len() != lock.len() {
            lock_save(kept);
        }
    }
    print("Removed pact '");
    print(dep_name);
    print("' from ");
    print(MANIFEST_FILE);
    print("\n");
    return 0;
}

/// BG482: remove the installed copy of pact `name` under the directory of
/// pacts `base`: the file ark_modules/<name>.fd, and the directory
/// ark_modules/<name>/ (a link to the cache's checkout is unlinked, never
/// what it points at). `name` is a plain name (ark_pact_name_ok).
fn ark_drop_installed(base: str, name: str) {
    if !ark_pact_name_ok(name) {
        return;
    }
    val file: str = base + "/" + name + ".fd";
    if ark_exists(file) {
        p_file_delete(file);
    }
    val dir: str = base + "/" + name;
    if ark_is_link(dir) {
        ark_unlink(dir);
    } else if ark_is_dir(dir) {
        if ark_is_windows() {
            p_system("rmdir /S /Q " + ark_q(ark_win_path(dir)) + " 2> nul");
        } else {
            p_system("rm -rf " + ark_q(dir));
        }
    }
}

fn ark_cmd_list(args: Vec<str>) -> i64 {
    var m: Manifest = manifest_load();
    if str_len(m.pkg_name) == 0 {
        return 1;
    }
    print(m.pkg_name);
    print(" v");
    print(m.pkg_version);
    print(" (");
    print(m.pkg_edition);
    print(")\n");
    // L5A: the rest of [package]
    if str_len(m.pkg_description) > 0 {
        print("description: " + m.pkg_description + "\n");
    }
    if m.pkg_authors.len() > 0 {
        print("authors: " + ark_join(m.pkg_authors) + "\n");
    }
    if str_len(m.pkg_license) > 0 {
        print("license: " + m.pkg_license + "\n");
    }
    print("\n");
    if m.pacts.len() == 0 && m.dev_pacts.len() == 0 {
        print("No pacts in ");
        print(MANIFEST_FILE);
        print(".\n");
        ark_print_targets(m);
        return 0;
    }
    print("NAME                  TYPE     SOURCE\n");
    print("------------------------------------------------------------\n");
    var i: i64 = 0;
    while i < m.pacts.len() + m.dev_pacts.len() {
        var p: PactEntry = PactEntry_new("", DepSource::Registry(""));
        var dev: bool = i >= m.pacts.len();
        if dev {
            p = m.dev_pacts[i - m.pacts.len()];
        } else {
            p = m.pacts[i];
        }
        print(p.name);
        print("  ");
        print(dep_kind_str(p.source));
        if dev {
            print(" (dev)");
        }
        print("  ");
        print(dep_source_str(p.source));
        if p.features.len() > 0 {
            print("  features: " + ark_join(p.features));
        }
        if p.binary {
            print("  binary");
        }
        print("\n");
        i = i + 1;
    }
    ark_print_targets(m);
    return 0;
}

/// L5A: the build targets of `m` under a TARGETS heading (none: nothing).
fn ark_print_targets(m: Manifest) {
    var targets: Vec<ArkTarget> = ark_targets_of(m);
    if targets.len() == 0 {
        return;
    }
    print("\nTARGETS\n");
    var ti: i64 = 0;
    while ti < targets.len() {
        print("  " + targets[ti].kind + " " + targets[ti].name + "  " + targets[ti].path + "\n");
        ti = ti + 1;
    }
}

/// The first 12 characters of a commit (all of a shorter one).
fn ark_short_rev(rev: str) -> str {
    if str_len(rev) <= 12 {
        return rev;
    }
    return str_slice(rev, 0, 12);
}

/// `ark install`: every pact of ark.toml into ark_modules/, where `use
/// <name>` finds it (compiler.fd ark_push_candidates). TL9: a git pact is
/// checked out at the commit ark.lock records, so a build pulls in what was
/// locked; `update` (ark update) takes the newest commit instead. ark.lock
/// is written with the commit of each git pact and the hash of each path
/// pact's files. CD4: the pacts the pacts need too, one copy each
/// (ark_resolve); L5A: the dev-dependencies into ark_modules/.dev/.
/// CD3: git and registry pacts are checkouts of the machine's cache.
fn ark_install_all(update: bool, only: str) -> i64 {
    return ark_install_all_dev(update, only, true);
}

/// ark_install_all; `with_dev` false leaves the dev-dependencies out
/// (`ark install --no-dev`).
fn ark_install_all_dev(update: bool, only: str, with_dev: bool) -> i64 {
    var m: Manifest = manifest_load();
    if str_len(m.pkg_name) == 0 {
        return 1;
    }
    if m.pacts.len() == 0 && (!with_dev || m.dev_pacts.len() == 0) {
        print("No pacts to install.\n");
        var none: Vec<LockEntry> = Vec::new();
        lock_save(none);
        return 0;
    }
    if ark_is_windows() {
        p_system("mkdir " + MODULES_DIR + " 2>nul");
    } else {
        p_system("mkdir -p " + MODULES_DIR);
    }
    var old_lock: Vec<LockEntry> = lock_load();
    var res: ArkResolution = ark_resolve(m, with_dev, old_lock, update, only);
    if !res.ok {
        return 1;
    }
    var rc: i64 = ark_install_picks(m, res.picks, old_lock, update, only, with_dev);
    if rc != 0 || update {
        // CD1: `ark update` checks the capabilities after its diff
        return rc;
    }
    if ark_cap_check(ark_units(m, lock_load())) > 0 {
        return 1;
    }
    return 0;
}

/// The pacts ark_resolve chose, installed under ark_modules/ (here), with
/// ark.lock and ark_modules/.features written -- one project's, or (L5F)
/// a workspace's, at its root.
fn ark_install_picks(m: Manifest, picks: Vec<ArkPick>, old_lock: Vec<LockEntry>, update: bool, only: str, with_dev: bool) -> i64 {
    // BG411: a pact name is a plain name: a dependency's own ark.toml could
    // name one `../../x` and be copied outside ark_modules/; checked for
    // every pact before anything is written
    var ni: i64 = 0;
    while ni < picks.len() {
        if !ark_pact_name_ok(picks[ni].name) {
            var why: str = "";
            if str_len(picks[ni].via) > 0 {
                why = " (for " + picks[ni].via + ")";
            }
            p_eprint_str("ark: invalid pact name '" + picks[ni].name + "'" + why + ": a pact name is a plain name, with no / \\ : or .., not starting with a dot\n");
            return 1;
        }
        ni = ni + 1;
    }
    var lock_entries: Vec<LockEntry> = Vec::new();
    var installed: i64 = 0;
    var i: i64 = 0;
    while i < picks.len() {
        var p: ArkPick = picks[i];
        // `ark update <name>` re-resolves that pact only
        var upd: bool = update && (str_len(only) == 0 || only == p.name);
        var locked: str = lock_resolved(old_lock, p.name);
        var base: str = ark_base(p.dev);
        if p.dev {
            ark_mkdirs(base);
        }
        print("Installing ");
        print(p.name);
        if p.dev {
            print(" (dev)");
        }
        if str_len(p.via) > 0 {
            print(" (for " + p.via + ")");
        }
        print("... ");
        var url: str = "";
        var gref: str = "";
        var is_git: bool = false;
        var source_text: str = "";
        // CD9: a vendored pact is not fetched: its copy in vendor/ (which
        // `use` reads first) is checked against vendor/vendor.lock, and
        // ark.lock keeps what it recorded for it
        var vstate: str = "";
        if !upd && !p.dev {
            vstate = ark_vendor_state(p.name);
        }
        if vstate == "ok" {
            print("OK (vendored)\n");
            var oi: i64 = lock_index(old_lock, p.name);
            if oi >= 0 {
                lock_entries.push(old_lock[oi]);
            } else {
                lock_entries.push(LockEntry_full(p.name, p.spec, ark_vendor_hash(ark_vendor_dest(p.name)), p.kind, p.via, p.version, false));
            }
            installed = installed + 1;
            i = i + 1;
            continue;
        }
        if str_len(vstate) > 0 {
            print("FAILED\n");
            p_eprint_str("ark: the vendored copy of '" + p.name + "': " + vstate + "\n");
            return 1;
        }
        if p.kind == "path" {
            var rev: str = ark_install_path_in(base, p.name, p.source);
            if str_len(rev) == 0 {
                print("FAILED\n");
                p_eprint_str("Path pact '" + p.name + "' cannot be read: " + p.source + " (" + p.chain + ")\n");
                return 1;
            }
            if str_len(locked) > 0 && locked != rev && !upd {
                print("OK (path, changed since ark.lock)\n");
            } else {
                print("OK (path)\n");
            }
            lock_entries.push(LockEntry_full(p.name, p.source, rev, "path", p.via, "", p.dev));
            installed = installed + 1;
        } else if p.kind == "git" {
            url = p.source;
            gref = p.gref;
            source_text = url;
            if str_len(gref) > 0 {
                source_text = url + "#" + gref;
            }
            is_git = true;
        } else {
            // N6: from the index, at the version ark_resolve chose (the
            // locked one while every requirement accepts it); CD3: a
            // checkout of the cache's copy
            var rrev: str = "";
            if str_len(p.commit) > 0 && p.commit == locked && !upd && ark_installed_rev_in(base, p.name, "registry") == locked {
                rrev = locked;
                print("(locked) ");
            } else {
                var e: ArkIndexEntry = ArkIndexEntry {
                    found: true, version: p.version, git: p.git, tag: p.tag, commit: p.commit, err: "", yanked: false
                };
                rrev = ark_install_registry_entry(base + "/" + p.name, p.name, e);
            }
            if str_len(rrev) == 0 {
                print("FAILED\n");
                p_eprint_str("Registry pact '" + p.name + "' " + p.version + " cannot be installed (" + p.chain + ")\n");
                return 1;
            }
            print("OK (registry " + p.version + " " + ark_short_rev(rrev) + ")\n");
            lock_entries.push(LockEntry_full(p.name, p.spec, rrev, "registry", p.via, p.version, p.dev));
            installed = installed + 1;
        }
        if is_git {
            var grev: str = "";
            if str_len(p.commit) > 0 {
                // CD3: a checkout of the cache's copy, at the resolved commit
                grev = ark_checkout_cached(base + "/" + p.name, p.mirror, p.commit);
            } else {
                grev = ark_install_git_at(base + "/" + p.name, p.name, url, gref, locked, upd);
            }
            if str_len(grev) == 0 {
                print("FAILED\n");
                p_eprint_str("git failed for '" + p.name + "' (" + source_text + ")\n");
                return 1;
            }
            print("OK (git " + ark_short_rev(grev) + ")\n");
            lock_entries.push(LockEntry_full(p.name, source_text, grev, "git", p.via, "", p.dev));
            installed = installed + 1;
        }
        i = i + 1;
    }
    // L5E: the prebuilt libraries of the pacts asked for as binary
    if ark_bin_apply(m, picks) > 0 {
        return 1;
    }
    // L5A: the features each pact has on (`dep/feature` entries followed
    // across pacts), recorded in ark.lock and ark_modules/.features
    var own_text: str = "";
    match read_file(MANIFEST_FILE) {
        Option::Some(t) => {
            own_text = t;
        }
        Option::None => {
        }
    }
    var feats: Vec<ArkFeatOn> = ark_resolve_features(m.pkg_name, own_text, picks);
    lock_save(ark_lock_with_features(lock_entries, feats));
    ark_write_features(m, own_text, feats, with_dev);
    print("\nInstalled ");
    print(int_to_str(installed));
    print(" pact(s) to ");
    print(MODULES_DIR);
    print("/; ");
    print(LOCK_FILE);
    print(" records what each one is.\n");
    return 0;
}

/// The file that lists the features `ark install` enabled for the pacts
/// installed under `base` (ark_modules/ or ark_modules/.dev/).
fn ark_features_path(base: str) -> str {
    return base + "/.features";
}

/// L5A: the features one pact has on (ark_resolve_features).
struct ArkFeatOn {
    name: str,
    dev: bool,
    on: Vec<str>,
}

/// The index of pact `name` in `v`, or -1.
fn ark_feat_index(v: Vec<ArkFeatOn>, name: str) -> i64 {
    var i: i64 = 0;
    while i < v.len() {
        if v[i].name == name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/// L5A: the features each of `picks` has on, one ArkFeatOn per pick in
/// order: what the requirements on it ask for, its [features] `default`,
/// the features those name, and every `dep/feature` entry (Cargo's form;
/// `dep?/feature` too) of the features on in the project (`own_text`, its
/// ark.toml; package `own_name`) or in another pact that names it. A
/// `dep/feature` turns `feature` on in pact `dep`, whose own [features]
/// are then followed again, until nothing more is turned on. An entry
/// naming a package that is not a pact is reported once (not for `dep?/`).
fn ark_resolve_features(own_name: str, own_text: str, picks: Vec<ArkPick>) -> Vec<ArkFeatOn> {
    var wanted: Vec<ArkFeatOn> = Vec::new();
    var i: i64 = 0;
    while i < picks.len() {
        var p: ArkPick = picks[i];
        wanted.push(ArkFeatOn {
            name: p.name, dev: p.dev, on: p.features
        });
        i = i + 1;
    }
    var warned: Vec<str> = Vec::new();
    var changed: bool = true;
    while changed {
        changed = false;
        // k = -1: the project itself; then each pact
        var k: i64 = 0 - 1;
        while k < picks.len() {
            var text: str = own_text;
            var who: str = own_name;
            var asked: Vec<str> = Vec::new();
            if k >= 0 {
                text = picks[k].manifest;
                who = picks[k].name;
                asked = wanted[k].on;
            }
            var all: Vec<str> = ark_feature_closure_full(text, asked, true);
            var a: i64 = 0;
            while a < all.len() {
                var f: str = all[a];
                a = a + 1;
                var slash: i64 = str_find(f, "/");
                if slash <= 0 {
                    continue;
                }
                var dep: str = str_trim(str_slice(f, 0, slash));
                var weak: bool = str_ends_with(dep, "?");
                if weak {
                    dep = str_slice(dep, 0, str_len(dep) - 1);
                }
                var feat: str = str_trim(str_slice(f, slash + 1, str_len(f)));
                var at: i64 = ark_feat_index(wanted, dep);
                if at < 0 {
                    var note: str = who + ":" + f;
                    if !weak && !ark_has(warned, note) {
                        warned.push(note);
                        p_eprint_str("ark: warning: the features of '" + who + "' name '" + f + "', but '" + dep + "' is not one of the pacts installed\n");
                    }
                    continue;
                }
                if str_len(feat) == 0 || ark_has(wanted[at].on, feat) {
                    continue;
                }
                var w: ArkFeatOn = wanted[at];
                var one: Vec<str> = Vec::new();
                one.push(feat);
                wanted.set(at, ArkFeatOn {
                    name: w.name, dev: w.dev, on: ark_union(w.on, one)
                });
                changed = true;
            }
            k = k + 1;
        }
    }
    var out: Vec<ArkFeatOn> = Vec::new();
    var j: i64 = 0;
    while j < picks.len() {
        var q: ArkPick = picks[j];
        out.push(ArkFeatOn {
            name: q.name, dev: q.dev, on: ark_feature_closure(q.manifest, wanted[j].on)
        });
        j = j + 1;
    }
    return out;
}

/// `entries` with each pact's features (ark_resolve_features) recorded,
/// for ark.lock.
fn ark_lock_with_features(entries: Vec<LockEntry>, feats: Vec<ArkFeatOn>) -> Vec<LockEntry> {
    var out: Vec<LockEntry> = Vec::new();
    var i: i64 = 0;
    while i < entries.len() {
        var e: LockEntry = entries[i];
        var at: i64 = ark_feat_index(feats, e.name);
        if at >= 0 {
            out.push(LockEntry_with_features(e, feats[at].on));
        } else {
            out.push(LockEntry_with_features(e, Vec::new()));
        }
        i = i + 1;
    }
    return out;
}

/// L5A: ark_modules/.features (and .dev/.features for the dev pacts): one
/// line `name = ["a", "b"]` per package with features on -- the project
/// itself (its [features] `default`, from `own`, its ark.toml) and each
/// pact (`feats`: ark_resolve_features). A build reads it for
/// `@cfg(feature = "x")` (compiler.fd check_cfg).
fn ark_write_features(m: Manifest, own: str, feats: Vec<ArkFeatOn>, with_dev: bool) {
    var head: str = "# ark_modules/.features -- the features ark install enabled (L5A)\n# DO NOT EDIT -- generated by ark; @cfg(feature = \"x\") holds when x is listed\n";
    var normal: str = head;
    var dev: str = head;
    var mine: Vec<str> = ark_feature_closure(own, Vec::new());
    if mine.len() > 0 {
        normal = normal + m.pkg_name + " = " + ark_toml_list(mine) + "\n";
    }
    var any_dev: bool = false;
    var i: i64 = 0;
    while i < feats.len() {
        var p: ArkFeatOn = feats[i];
        var on: Vec<str> = p.on;
        if on.len() > 0 {
            var line: str = p.name + " = " + ark_toml_list(on) + "\n";
            if p.dev {
                dev = dev + line;
                any_dev = true;
            } else {
                normal = normal + line;
            }
        }
        i = i + 1;
    }
    p_file_write(ark_features_path(MODULES_DIR), normal);
    if with_dev && (any_dev || ark_is_dir(ark_dev_dir())) {
        ark_mkdirs(ark_dev_dir());
        p_file_write(ark_features_path(ark_dev_dir()), dev);
    }
}

/// The features ark_modules/.features lists for `name` (none when the
/// file or the line is missing).
fn ark_installed_features(base: str, name: str) -> Vec<str> {
    match read_file(ark_features_path(base)) {
        Option::Some(t) => {
            var toml: Vec<TomlLine> = parse_toml(t);
            var i: i64 = 0;
            while i < toml.len() {
                if toml[i].key == name {
                    return ark_toml_array(toml[i].value);
                }
                i = i + 1;
            }
        }
        Option::None => {
        }
    }
    return Vec::new();
}

fn ark_cmd_install(args: Vec<str>) -> i64 {
    var with_dev: bool = true;
    var i: i64 = 0;
    while i < args.len() {
        if args[i] == "--no-dev" {
            with_dev = false;
        }
        i = i + 1;
    }
    return ark_install_all_dev(false, "", with_dev);
}

/// A pact of the project as installed: one of ark.toml's [dependencies]
/// or [dev-dependencies], or (CD4) one a pact needs, known from ark.lock.
struct ArkUnit {
    name: str,
    kind: str,
    source: str,
    base: str,
    dev: bool,
    via: str,
    version: str,
}

/// The source of pact `p` as ark.lock writes it (`url#ref` for a git ref).
fn ark_source_text(p: PactEntry) -> str {
    match p.source {
        DepSource::GitBranch(g_url, g_branch) => {
            return g_url + "#" + g_branch;
        }
        DepSource::GitTag(g_url, g_tag) => {
            return g_url + "#" + g_tag;
        }
        _ => {
        }
    }
    return dep_source_str(p.source);
}

/// Every pact of the project: ark.toml's, its dev-dependencies, then the
/// pacts that `lock` records as needed by another pact (`via`).
fn ark_units(m: Manifest, lock: Vec<LockEntry>) -> Vec<ArkUnit> {
    var out: Vec<ArkUnit> = Vec::new();
    var i: i64 = 0;
    while i < m.pacts.len() {
        var p: PactEntry = m.pacts[i];
        out.push(ArkUnit {
            name: p.name, kind: dep_kind_str(p.source), source: ark_source_text(p), base: ark_base(false), dev: false, via: "", version: ""
        });
        i = i + 1;
    }
    var d: i64 = 0;
    while d < m.dev_pacts.len() {
        var q: PactEntry = m.dev_pacts[d];
        out.push(ArkUnit {
            name: q.name, kind: dep_kind_str(q.source), source: ark_source_text(q), base: ark_base(true), dev: true, via: "", version: ""
        });
        d = d + 1;
    }
    // L5F: only the pacts a pact of this project needs -- a workspace's
    // ark.lock also holds the other members' (until nothing is added)
    var added: bool = true;
    while added {
        added = false;
        var l: i64 = 0;
        while l < lock.len() {
            var e: LockEntry = lock[l];
            if str_len(e.via) > 0 && !ark_unit_named(out, e.name) && ark_unit_named(out, e.via) {
                out.push(ArkUnit {
                    name: e.name, kind: e.kind, source: e.source, base: ark_base(e.dev), dev: e.dev, via: e.via, version: e.version
                });
                added = true;
            }
            l = l + 1;
        }
    }
    return out;
}

/// Is there a unit named `name` in `units`?
fn ark_unit_named(units: Vec<ArkUnit>, name: str) -> bool {
    var i: i64 = 0;
    while i < units.len() {
        if units[i].name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// `ark lock`: ark.lock from what is installed now (no network).
fn ark_cmd_lock(args: Vec<str>) -> i64 {
    var m: Manifest = manifest_load();
    if str_len(m.pkg_name) == 0 {
        return 1;
    }
    var lock_entries: Vec<LockEntry> = Vec::new();
    var missing: i64 = 0;
    // CD4 / L5A: the dev-dependencies and the pacts the pacts need too
    var old: Vec<LockEntry> = lock_load();
    var units: Vec<ArkUnit> = ark_units(m, old);
    var i: i64 = 0;
    while i < units.len() {
        var p: ArkUnit = units[i];
        var kind: str = p.kind;
        var source_text: str = p.source;
        if !p.dev && str_len(ark_vendor_dest(p.name)) > 0 && str_len(ark_installed_rev(p.name, kind)) == 0 {
            // CD9: vendored, not installed: ark.lock keeps its entry
            var oi: i64 = lock_index(old, p.name);
            if oi >= 0 {
                lock_entries.push(old[oi]);
            } else {
                lock_entries.push(LockEntry_full(p.name, source_text, ark_vendor_hash(ark_vendor_dest(p.name)), kind, p.via, p.version, false));
            }
        } else {
            // a registry pact is a git checkout too (N6): its commit
            var rev: str = ark_installed_rev_in(p.base, p.name, kind);
            if str_len(rev) == 0 {
                p_eprint_str("ark: '" + p.name + "' is not installed (ark install)\n");
                missing = missing + 1;
            } else {
                // the version recorded for that commit stays
                var version: str = p.version;
                var oj: i64 = lock_index(old, p.name);
                if oj >= 0 && old[oj].resolved == rev && str_len(version) == 0 {
                    version = old[oj].version;
                }
                // L5A: the features ark install turned on in it
                // (ark_modules/.features) stay recorded
                lock_entries.push(LockEntry_with_features(LockEntry_full(p.name, source_text, rev, kind, p.via, version, p.dev), ark_installed_features(p.base, p.name)));
            }
        }
        i = i + 1;
    }
    lock_save(lock_entries);
    print("Wrote ");
    print(LOCK_FILE);
    print(" with ");
    print(int_to_str(lock_entries.len()));
    print(" pact(s).\n");
    // 2g.63: an empty lock says why instead of passing for success
    if units.len() == 0 {
        print("(" + MANIFEST_FILE + " has no pacts: nothing to lock)\n");
    }
    if missing > 0 {
        p_eprint_str("ark: " + int_to_str(missing) + " pact(s) of " + MANIFEST_FILE + " are not installed and are not in " + LOCK_FILE + ": run `ark install` (it writes the lock too)\n");
        return 1;
    }
    return 0;
}

/// `ark audit [--files]`: what a build pulls in. Per pact: its source, the
/// revision ark.lock records against the one installed (a mismatch fails
/// the audit), and what its code can do: files and lines, `unsafe` blocks,
/// `extern` declarations, and calls that run programs, touch files or the
/// network. --files: the same per file.
fn ark_cmd_audit(args: Vec<str>) -> i64 {
    var per_file: bool = false;
    var ai: i64 = 0;
    while ai < args.len() {
        if args[ai] == "--files" {
            per_file = true;
        }
        ai = ai + 1;
    }
    var m: Manifest = manifest_load();
    if str_len(m.pkg_name) == 0 {
        return 1;
    }
    var lock: Vec<LockEntry> = lock_load();
    var problems: i64 = 0;
    // CD4 / L5A: the pacts the pacts need, and the dev-dependencies, too
    var units: Vec<ArkUnit> = ark_units(m, lock);
    print("ark audit: " + m.pkg_name + " v" + m.pkg_version + ", " + int_to_str(units.len()) + " pact(s)\n");
    var i: i64 = 0;
    while i < units.len() {
        var p: ArkUnit = units[i];
        var kind: str = p.kind;
        var note: str = "";
        if p.dev {
            note = ", dev";
        }
        if str_len(p.via) > 0 {
            note = note + ", for " + p.via;
        }
        print("\n" + p.name + "  (" + kind + " " + p.source + note + ")\n");
        // CD9: a vendored pact is what a build reads (vendor/ comes first
        // for `use`): its copy is checked against vendor/vendor.lock and
        // audited; N6: a registry pact is a git checkout, checked as one
        var vstate: str = "";
        if !p.dev {
            vstate = ark_vendor_state(p.name);
        }
        var audit_dest: str = "";
        if str_len(vstate) > 0 {
            if vstate == "ok" {
                print("  vendored  " + ark_vendor_hash(ark_vendor_dest(p.name)) + "\n");
            } else {
                print("  " + vstate + "\n");
                problems = problems + 1;
            }
            audit_dest = ark_vendor_dest(p.name);
        } else {
            var locked: str = lock_resolved(lock, p.name);
            var now: str = ark_installed_rev_in(p.base, p.name, kind);
            if str_len(now) == 0 {
                print("  NOT INSTALLED (ark install)\n");
                problems = problems + 1;
            } else if str_len(locked) == 0 {
                print("  NOT LOCKED: installed " + now + " (ark lock)\n");
                problems = problems + 1;
            } else if locked != now {
                print("  CHANGED: ark.lock has " + locked + ", installed is " + now + "\n");
                problems = problems + 1;
            } else {
                print("  locked  " + now + "\n");
            }
            if str_len(now) > 0 {
                audit_dest = ark_pact_dest_in(p.base, p.name, kind);
                // L5E: a prebuilt library against its recorded hash
                problems = problems + ark_bin_audit(p.base, p.name);
            }
        }
        if str_len(audit_dest) > 0 {
            var files: Vec<str> = ark_pact_files(audit_dest);
            if ark_is_dir(audit_dest) && str_len(vstate) > 0 {
                // the vendored C sources and headers as well
                files = Vec::new();
                ark_collect_vendored(audit_dest, &mut files);
            }
            var lines: i64 = 0;
            var unsafes: i64 = 0;
            var externs: i64 = 0;
            var effects: i64 = 0;
            var clibs: Vec<str> = Vec::new();
            var caps: Vec<str> = Vec::new();
            var fi: i64 = 0;
            while fi < files.len() {
                var src: str = "";
                match read_file(files[fi]) {
                    Option::Some(c) => {
                        src = c;
                    }
                    Option::None => {
                    }
                }
                var fl: i64 = ark_count(src, "\n");
                var fu: i64 = ark_count(src, "unsafe {") + ark_count(src, "unsafe{");
                var fx: i64 = ark_count(src, "extern ");
                var fe: i64 = ark_count(src, "p_system(") + ark_count(src, "p_process_") + ark_count(src, "p_file_write") + ark_count(src, "p_file_delete") + ark_count(src, "p_socket") + ark_count(src, "p_tcp_") + ark_count(src, "p_http_");
                lines = lines + fl;
                unsafes = unsafes + fu;
                externs = externs + fx;
                effects = effects + fe;
                // CD7: the C libraries it links and the capabilities its
                // imports ask for
                ark_audit_words(src, "link \"", "\"", &mut clibs);
                ark_audit_words(src, " with {", "}", &mut caps);
                if per_file {
                    print("    " + files[fi] + ": " + int_to_str(fl) + " lines, " + int_to_str(fu) + " unsafe, " + int_to_str(fx) + " extern, " + int_to_str(fe) + " process/file/network calls\n");
                }
                fi = fi + 1;
            }
            print("  " + int_to_str(files.len()) + " file(s), " + int_to_str(lines) + " lines, " + int_to_str(unsafes) + " unsafe, " + int_to_str(externs) + " extern, " + int_to_str(effects) + " process/file/network calls\n");
            if clibs.len() > 0 {
                print("  C libraries: " + ark_join(clibs) + "\n");
            }
            if caps.len() > 0 {
                print("  capabilities: " + ark_join(caps) + "\n");
            }
            // CD1: what the scan finds it uses (ark_cap_check below
            // compares it with ark.toml's [capabilities])
            var used: ArkCaps = ark_pact_caps(audit_dest);
            if used.names.len() > 0 {
                print("  uses: " + ark_join(ark_sorted(used.names)) + "\n");
            }
        }
        i = i + 1;
    }
    var cap_bad: i64 = ark_cap_check(units);
    if cap_bad > 0 {
        print("\n" + int_to_str(cap_bad) + " pact(s) use capabilities ark.toml does not grant them\n");
        problems = problems + cap_bad;
    }
    // A lock entry no pact names any more (L5F: a workspace's ark.lock
    // also holds the other members' pacts)
    var li: i64 = 0;
    if str_len(g_ark_ws_root) > 0 || ark_workspace_members().len() > 0 {
        li = lock.len();
    }
    while li < lock.len() {
        if !ark_unit_named(units, lock[li].name) {
            print("\n" + lock[li].name + "  in ark.lock but not in ark.toml (ark lock)\n");
            problems = problems + 1;
        }
        li = li + 1;
    }
    if problems > 0 {
        print("\n" + int_to_str(problems) + " problem(s)\n");
        return 1;
    }
    print("\nevery pact is installed as locked\n");
    return 0;
}

/// CD7: the text between `open` and `close` after each `open` in `src`,
/// split on commas, added to `out` once each (C library names after
/// `link "`, capability names after ` with {`).
fn ark_audit_words(src: str, open: str, close: str, out: &mut Vec<str>) {
    var from: i64 = 0;
    loop {
        var rest: str = str_slice(src, from, str_len(src));
        var at: i64 = str_find(rest, open);
        if at < 0 {
            return;
        }
        var body_at: i64 = at + str_len(open);
        var tail: str = str_slice(rest, body_at, str_len(rest));
        var end: i64 = str_find(tail, close);
        if end < 0 {
            return;
        }
        var words: Vec<str> = str_split(str_slice(tail, 0, end), ",");
        var wi: i64 = 0;
        while wi < words.len() {
            var w: str = str_trim(words[wi]);
            if str_len(w) > 0 && str_len(w) < 64 && !ark_has_ref(out, w) {
                out.push(w);
            }
            wi = wi + 1;
        }
        from = from + body_at + end + str_len(close);
    }
}

/// Is `s` one of `v` (a borrowed Vec)?
fn ark_has_ref(v: &mut Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// `names` joined with ", ".
fn ark_join(names: Vec<str>) -> str {
    var s: str = "";
    var i: i64 = 0;
    while i < names.len() {
        if i > 0 {
            s = s + ", ";
        }
        s = s + names[i];
        i = i + 1;
    }
    return s;
}

// --- CU5: the public API a minor version keeps ---------------------------------
// The public API of a package is every `pub` item of its .fd files (not
// under tests/, examples/, bench/, ark_modules/ or vendor/): each `pub fn`
// signature (methods of an `impl` named with their type), each `pub
// struct`, `pub enum` and `pub trait` with its whole body (a new field or
// variant breaks a literal or a match), each `pub const`/`static` with its
// type and each `pub type`. Whitespace does not count. `ark publish`
// compares the API of the tagged commit with that of the newest release
// below it in the index: a minor or patch version (0.y.z: a patch version)
// that removes or changes an item is refused; a new major version (0.y:
// a new minor one) may change anything. `ark api` prints the API.

/// Is `c` a byte of an identifier?
fn ark_is_ident(c: i64) -> bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

/// The identifier that starts at `i` in `t` ("" when none does).
fn ark_word_at(t: str, i: i64) -> str {
    var j: i64 = i;
    while j < str_len(t) && ark_is_ident(str_byte_at(t, j)) {
        j = j + 1;
    }
    return str_slice(t, i, j);
}

/// The first position at or after `i` in `t` that is not whitespace.
fn ark_skip_ws(t: str, i: i64) -> i64 {
    var j: i64 = i;
    while j < str_len(t) && (str_byte_at(t, j) == 32 || str_byte_at(t, j) == 9 || str_byte_at(t, j) == 10 || str_byte_at(t, j) == 13) {
        j = j + 1;
    }
    return j;
}

/// The first position at or after `i` in `t` holding byte `a` or `b`
/// (the length of `t` when there is none).
fn ark_find_any(t: str, i: i64, a: i64, b: i64) -> i64 {
    var j: i64 = i;
    while j < str_len(t) {
        var c: i64 = str_byte_at(t, j);
        if c == a || c == b {
            return j;
        }
        j = j + 1;
    }
    return str_len(t);
}

/// The position after the `}` that closes the `{` at `open`.
fn ark_match_brace(t: str, open: i64) -> i64 {
    var depth: i64 = 0;
    var j: i64 = open;
    while j < str_len(t) {
        var c: i64 = str_byte_at(t, j);
        if c == 123 {
            depth = depth + 1;
        } else if c == 125 {
            depth = depth - 1;
            if depth == 0 {
                return j + 1;
            }
        }
        j = j + 1;
    }
    return str_len(t);
}

/// `src` with its comments taken out and its string and character
/// literals emptied (their braces and `pub`s do not count).
fn ark_api_clean(src: str) -> str {
    var sb: StringBuilder = StringBuilder::new();
    var n: i64 = str_len(src);
    var i: i64 = 0;
    var run: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(src, i);
        var next: i64 = 0;
        if i + 1 < n {
            next = str_byte_at(src, i + 1);
        }
        if c == 47 && next == 47 {
            sb.append_str(str_slice(src, run, i));
            while i < n && str_byte_at(src, i) != 10 {
                i = i + 1;
            }
            run = i;
        } else if c == 47 && next == 42 {
            sb.append_str(str_slice(src, run, i));
            sb.append_str(" ");
            i = i + 2;
            while i + 1 < n && !(str_byte_at(src, i) == 42 && str_byte_at(src, i + 1) == 47) {
                i = i + 1;
            }
            i = i + 2;
            if i > n {
                i = n;
            }
            run = i;
        } else if c == 34 {
            sb.append_str(str_slice(src, run, i));
            sb.append_str("\"\"");
            i = i + 1;
            while i < n && str_byte_at(src, i) != 34 {
                if str_byte_at(src, i) == 92 {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            if i > n {
                i = n;
            }
            run = i;
        } else if c == 39 && i + 2 < n && str_byte_at(src, i + 2) == 39 {
            sb.append_str(str_slice(src, run, i));
            sb.append_str("' '");
            i = i + 3;
            run = i;
        } else if c == 39 && i + 3 < n && next == 92 && str_byte_at(src, i + 3) == 39 {
            sb.append_str(str_slice(src, run, i));
            sb.append_str("' '");
            i = i + 4;
            run = i;
        } else {
            i = i + 1;
        }
    }
    sb.append_str(str_slice(src, run, n));
    return sb.to_str();
}

/// `s` with each run of whitespace made one space, trimmed (for messages).
fn ark_norm_ws(s: str) -> str {
    var sb: StringBuilder = StringBuilder::new();
    var space: bool = false;
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c == 32 || c == 9 || c == 10 || c == 13 {
            space = true;
        } else {
            if space && sb.len() > 0 {
                sb.append_str(" ");
            }
            space = false;
            sb.append_str(str_slice(s, i, i + 1));
        }
        i = i + 1;
    }
    return sb.to_str();
}

/// `s` with whitespace taken out except one space between two identifier
/// bytes: two spellings of one signature compare equal.
fn ark_canon(s: str) -> str {
    var sb: StringBuilder = StringBuilder::new();
    var space: bool = false;
    var last: i64 = 0;
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c == 32 || c == 9 || c == 10 || c == 13 {
            space = true;
        } else {
            if space && ark_is_ident(last) && ark_is_ident(c) {
                sb.append_str(" ");
            }
            space = false;
            last = c;
            sb.append_str(str_slice(s, i, i + 1));
        }
        i = i + 1;
    }
    return sb.to_str();
}

/// The public items of the source `src` of `file`, appended to `out` as
/// `key<TAB>canonical text<TAB>text`; the key is the file, the type of an
/// `impl` for a method, the kind and the name.
fn ark_api_items(file: str, src: str, out: &mut Vec<str>) {
    var t: str = ark_api_clean(src);
    var n: i64 = str_len(t);
    var depth: i64 = 0;
    var impl_name: str = "";
    var impl_depth: i64 = -1;
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(t, i);
        if c == 123 {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == 125 {
            depth = depth - 1;
            if depth == impl_depth {
                impl_name = "";
                impl_depth = -1;
            }
            i = i + 1;
            continue;
        }
        if !ark_is_ident(c) {
            i = i + 1;
            continue;
        }
        var w: str = ark_word_at(t, i);
        var top: bool = depth == 0 || (impl_depth >= 0 && depth == impl_depth + 1);
        if top && depth == 0 && w == "impl" {
            var ob: i64 = ark_find_any(t, i, 123, 59);
            if ob < n && str_byte_at(t, ob) == 123 {
                impl_name = ark_canon(str_slice(t, i + 4, ob));
                impl_depth = 0;
                i = ob;
                continue;
            }
        }
        if top && w == "pub" {
            var j: i64 = ark_skip_ws(t, i + 3);
            var kw: str = ark_word_at(t, j);
            var end: i64 = n;
            var name: str = "";
            if kw == "struct" || kw == "enum" || kw == "trait" || kw == "union" {
                var k: i64 = ark_find_any(t, j, 123, 59);
                if k < n && str_byte_at(t, k) == 123 {
                    end = ark_match_brace(t, k);
                } else {
                    end = k;
                }
                name = ark_word_at(t, ark_skip_ws(t, j + str_len(kw)));
            } else if kw == "const" || kw == "static" {
                end = ark_find_any(t, j, 61, 59);
                name = ark_word_at(t, ark_skip_ws(t, j + str_len(kw)));
            } else if kw == "type" {
                end = ark_find_any(t, j, 59, 59);
                name = ark_word_at(t, ark_skip_ws(t, j + str_len(kw)));
            } else {
                // fn (also `pub extern "C" fn`, `pub unsafe fn`): the
                // signature, up to its body or `;`
                end = ark_find_any(t, j, 123, 59);
                var sig: str = str_slice(t, j, end);
                var f: i64 = str_find(sig, "fn ");
                if f >= 0 {
                    name = ark_word_at(sig, ark_skip_ws(sig, f + 3));
                    kw = "fn";
                } else {
                    name = kw;
                    kw = "item";
                }
            }
            var raw: str = str_slice(t, i, end);
            var key: str = file + " " + kw + " ";
            if str_len(impl_name) > 0 {
                key = key + impl_name + "::";
            }
            key = key + name;
            out.push(key + "\t" + ark_canon(raw) + "\t" + ark_norm_ws(raw));
            i = end;
            continue;
        }
        i = i + str_len(w);
    }
}

/// Is `f` (a path relative to the package root) one of the package's
/// source files?
fn ark_api_file(f: str) -> bool {
    if !str_ends_with(f, ".fd") {
        return false;
    }
    var skip: Vec<str> = str_split("tests/,examples/,bench/,ark_modules/,vendor/,.git/", ",");
    var i: i64 = 0;
    while i < skip.len() {
        if str_starts_with(f, skip[i]) || str_contains(f, "/" + skip[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// The public API of the package at commit `commit` of the repository `dir`.
fn ark_api_at(dir: str, commit: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var ls: ArkGitOut = ark_git_out(dir, "ls-tree -r --name-only " + ark_q(commit));
    if !ls.ok {
        return out;
    }
    var files: Vec<str> = str_split(ls.out, "\n");
    var i: i64 = 0;
    while i < files.len() {
        var f: str = str_trim(files[i]);
        if ark_api_file(f) {
            ark_api_items(f, ark_git_file(dir, commit, f), &mut out);
        }
        i = i + 1;
    }
    return out;
}

/// The public API of the package in the current directory, as it is on disk.
fn ark_api_worktree() -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var files: Vec<str> = Vec::new();
    ark_collect_fd(".", &mut files);
    var i: i64 = 0;
    while i < files.len() {
        var f: str = files[i];
        if str_starts_with(f, "./") {
            f = str_slice(f, 2, str_len(f));
        }
        if ark_api_file(f) {
            match read_file(files[i]) {
                Option::Some(src) => {
                    ark_api_items(f, src, &mut out);
                }
                Option::None => {
                }
            }
        }
        i = i + 1;
    }
    return out;
}

/// What changed from the API `old` to `new`: lines `removed: ...`,
/// `changed: ...` (each breaking) and `added: ...`.
struct ArkApiDiff {
    breaking: Vec<str>,
    added: Vec<str>,
}

fn ark_api_diff(old: Vec<str>, new: Vec<str>) -> ArkApiDiff {
    var breaking: Vec<str> = Vec::new();
    var added: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < old.len() {
        var o: Vec<str> = str_split(old[i], "\t");
        var found: bool = false;
        var j: i64 = 0;
        while j < new.len() {
            var w: Vec<str> = str_split(new[j], "\t");
            if w[0] == o[0] {
                found = true;
                if w[1] != o[1] {
                    breaking.push("changed: " + o[2] + "  ->  " + w[2] + "  (" + ark_api_file_of(o[0]) + ")");
                }
                break;
            }
            j = j + 1;
        }
        if !found {
            breaking.push("removed: " + o[2] + "  (" + ark_api_file_of(o[0]) + ")");
        }
        i = i + 1;
    }
    var k: i64 = 0;
    while k < new.len() {
        var w2: Vec<str> = str_split(new[k], "\t");
        var had: bool = false;
        var l: i64 = 0;
        while l < old.len() {
            var ol: Vec<str> = str_split(old[l], "\t");
            if ol[0] == w2[0] {
                had = true;
                break;
            }
            l = l + 1;
        }
        if !had {
            added.push("added: " + w2[2] + "  (" + ark_api_file_of(w2[0]) + ")");
        }
        k = k + 1;
    }
    return ArkApiDiff {
        breaking: breaking, added: added
    };
}

/// The file of an API key.
fn ark_api_file_of(key: str) -> str {
    var sp: i64 = str_find(key, " ");
    if sp < 0 {
        return key;
    }
    return str_slice(key, 0, sp);
}

/// How `new` steps from `old`: "major" (may break the API: x+1, or 0.y+1),
/// "minor" or "patch" (may not).
fn ark_bump_kind(old: str, new: str) -> str {
    var a: Vec<str> = str_split(ark_strip_v(old), ".");
    var b: Vec<str> = str_split(ark_strip_v(new), ".");
    var am: i64 = ark_num(a[0]);
    var bm: i64 = ark_num(b[0]);
    var an: i64 = 0;
    var bn: i64 = 0;
    if a.len() > 1 {
        an = ark_num(a[1]);
    }
    if b.len() > 1 {
        bn = ark_num(b[1]);
    }
    if bm != am {
        return "major";
    }
    if am == 0 {
        if bn != an {
            return "major";
        }
        return "patch";
    }
    if bn != an {
        return "minor";
    }
    return "patch";
}

/// CU5: may `version` of `name` (commit `commit` of the repository in the
/// current directory) be published after the releases `versions` of the
/// index? Prints why not; true when the API keeps every item of the
/// newest release below it, or the version is a new major one.
fn ark_api_check(name: str, version: str, commit: str, versions: Vec<ArkIndexEntry>) -> bool {
    var prev: ArkIndexEntry = ArkIndexEntry_none("");
    var i: i64 = 0;
    while i < versions.len() {
        var e: ArkIndexEntry = versions[i];
        if ark_version_less(e.version, version) && (!prev.found || ark_version_less(prev.version, e.version)) {
            prev = e;
        }
        i = i + 1;
    }
    if !prev.found {
        return true;
    }
    var bump: str = ark_bump_kind(prev.version, version);
    if bump == "major" {
        print("API check: " + version + " is a new major version after " + prev.version + ": changes are allowed\n");
        return true;
    }
    if ark_rev_commit(".", prev.commit) != prev.commit {
        ark_git_out(".", "fetch --quiet --tags origin");
    }
    if ark_rev_commit(".", prev.commit) != prev.commit {
        p_eprint_str("ark: cannot read " + name + " " + prev.version + " (commit " + prev.commit + ") to compare its public API: fetch it into this repository\n");
        return false;
    }
    var d: ArkApiDiff = ark_api_diff(ark_api_at(".", prev.commit), ark_api_at(".", commit));
    if d.breaking.len() > 0 {
        p_eprint_str("ark: " + name + " " + version + " is a " + bump + " version after " + prev.version + ", but its public API does not keep " + prev.version + "'s:\n");
        var b: i64 = 0;
        while b < d.breaking.len() {
            p_eprint_str("  " + d.breaking[b] + "\n");
            b = b + 1;
        }
        p_eprint_str("Keep those items, or publish a new major version.\n");
        return false;
    }
    print("API check against " + prev.version + ": " + int_to_str(d.added.len()) + " item(s) added, none removed or changed\n");
    return true;
}

/// `ark api [--against <rev>]` (CU5): the public API of the package here;
/// with --against, what changed since `rev` (exit 1 when an item was
/// removed or changed).
fn ark_cmd_api(args: Vec<str>) -> i64 {
    var against: str = "";
    var i: i64 = 0;
    while i < args.len() {
        if args[i] == "--against" && i + 1 < args.len() {
            against = args[i + 1];
            i = i + 1;
        }
        i = i + 1;
    }
    var now: Vec<str> = ark_api_worktree();
    if str_len(against) == 0 {
        var k: i64 = 0;
        while k < now.len() {
            var f: Vec<str> = str_split(now[k], "\t");
            print(f[2] + "  (" + ark_api_file_of(f[0]) + ")\n");
            k = k + 1;
        }
        print(int_to_str(now.len()) + " public item(s)\n");
        return 0;
    }
    var commit: str = ark_rev_commit(".", against);
    if str_len(commit) == 0 {
        p_eprint_str("ark: no commit '" + against + "' in this repository\n");
        return 1;
    }
    var d: ArkApiDiff = ark_api_diff(ark_api_at(".", commit), now);
    var b: i64 = 0;
    while b < d.breaking.len() {
        print(d.breaking[b] + "\n");
        b = b + 1;
    }
    var a: i64 = 0;
    while a < d.added.len() {
        print(d.added[a] + "\n");
        a = a + 1;
    }
    if d.breaking.len() > 0 {
        print(int_to_str(d.breaking.len()) + " breaking change(s) since " + against + "\n");
        return 1;
    }
    print("no breaking change since " + against + "\n");
    return 0;
}

/// `ark search <query>` (N6): the packages of the index whose name holds
/// `query` (any case), each with its newest version and repository.
fn ark_cmd_search(args: Vec<str>) -> i64 {
    if args.len() == 0 {
        p_eprint_str("Usage: ark search <query>\n");
        return 1;
    }
    var query: str = str_to_lower(args[0]);
    var index: str = ark_update_index();
    if str_len(index) == 0 {
        return 1;
    }
    var names: Vec<str> = ark_sorted(ark_index_names(index));
    var shown: i64 = 0;
    var i: i64 = 0;
    while i < names.len() {
        if str_contains(str_to_lower(names[i]), query) {
            var e: ArkIndexEntry = ark_index_lookup(index, names[i], "");
            if e.found {
                print(names[i] + " " + e.version + "  " + e.git + "\n");
                shown = shown + 1;
            }
        }
        i = i + 1;
    }
    if shown == 0 {
        print("No package matches '" + args[0] + "'.\n");
    }
    return 0;
}

/// `ark publish [--git <url>]` (N6): add this package's version to the
/// index -- a line `version git-url tag commit` in the index file of its
/// name, committed and pushed. The version's tag (`v<version>`) must exist;
/// a version already published is refused (versions never change). When
/// the push fails, the commit stays in the local index for a pull request.
fn ark_cmd_publish(args: Vec<str>) -> i64 {
    var m: Manifest = manifest_load();
    if str_len(m.pkg_name) == 0 {
        return 1;
    }
    var name: str = m.pkg_name;
    var version: str = m.pkg_version;
    var tag: str = "v" + version;
    var c: ArkGitOut = ark_git_out(".", "rev-parse " + ark_q(tag + "^{commit}"));
    if !c.ok || str_len(c.out) == 0 {
        p_eprint_str("ark: no tag " + tag + ": tag this version before publishing\n");
        return 1;
    }
    var git: str = "";
    var ai: i64 = 0;
    while ai < args.len() {
        if args[ai] == "--git" && ai + 1 < args.len() {
            git = args[ai + 1];
        }
        ai = ai + 1;
    }
    if str_len(git) == 0 {
        var r: ArkGitOut = ark_git_out(".", "remote get-url origin");
        if !r.ok || str_len(r.out) == 0 {
            p_eprint_str("ark: no git remote: pass --git <url>\n");
            return 1;
        }
        git = r.out;
    }
    var index: str = ark_update_index();
    if str_len(index) == 0 {
        return 1;
    }
    var file: str = index + "/" + name;
    var lines: str = "";
    match read_file(file) {
        Option::Some(t) => {
            lines = t;
        }
        Option::None => {
        }
    }
    var existing: Vec<str> = str_split(lines, "\n");
    var ei: i64 = 0;
    while ei < existing.len() {
        var f: Vec<str> = str_split(str_trim(existing[ei]), " ");
        if f.len() > 0 && f[0] == version {
            p_eprint_str("ark: " + name + " " + version + " is already published; versions never change\n");
            return 1;
        }
        ei = ei + 1;
    }
    // CU5: a minor or patch version keeps the public API of the release
    // before it
    if !ark_api_check(name, version, c.out, ark_index_versions(index, name)) {
        return 1;
    }
    if str_len(lines) > 0 && !str_ends_with(lines, "\n") {
        lines = lines + "\n";
    }
    lines = lines + version + " " + git + " " + tag + " " + c.out + "\n";
    p_file_write(file, lines);
    var added: ArkGitOut = ark_git_out(index, "add " + ark_q(name));
    var committed: ArkGitOut = ark_git_out(index, "commit -q -m " + ark_q(name + " " + version));
    if !added.ok || !committed.ok {
        p_eprint_str("ark: cannot commit " + name + " " + version + " to the index at " + index + "\n");
        return 1;
    }
    var pushed: ArkGitOut = ark_git_out(index, "push -q");
    if pushed.ok {
        print("Published " + name + " " + version + ".\n");
    } else {
        print("Committed " + name + " " + version + " to the local index at " + index + ", but the push failed.\n");
        print("Open a pull request against the index with that commit.\n");
    }
    return 0;
}

// --- CD1: per-dependency capabilities -----------------------------------------
// ark.toml grants each pact the capabilities it may use:
//   [capabilities]
//   json = []                  # pure code: nothing
//   http_client = ["net"]
//   tool = ["fs", "process"]   # "*" grants everything
// Once the section is there, every pact (and every pact a pact needs) is
// checked: `ark install`, `ark build`, `ark test` and `ark audit` fail when
// one uses a capability not granted to it, naming the file and the call.
// What a pact uses is found by a scan of its .fd files (ark_cap_rules):
// net, fs, process, env, ffi (extern, link), unsafe, and what its imports
// ask for (`use core with { IO, Crypto }`: io, crypto). `ark update`
// prints what each pact uses that it did not before (ark_cap_diff).

/// The scan's rules: `capability<TAB>text that shows it is used`.
fn ark_cap_rules() -> Vec<str> {
    var r: Vec<str> = Vec::new();
    r.push("net\tp_socket");
    r.push("net\tp_tcp_");
    r.push("net\tp_udp_");
    r.push("net\tp_http_");
    r.push("net\tp_dns_");
    r.push("net\tuse net");
    r.push("net\tuse http");
    r.push("net\tuse ws");
    r.push("net\tuse dns");
    r.push("net\tuse tls_");
    r.push("fs\tp_file_");
    r.push("fs\tp_dir_");
    r.push("fs\tp_mkdir");
    r.push("fs\tp_rmdir");
    r.push("fs\tread_file(");
    r.push("fs\twrite_file(");
    r.push("fs\tuse fs");
    r.push("fs\tuse file");
    r.push("fs\tuse mmap");
    r.push("process\tp_system(");
    r.push("process\tp_process_");
    r.push("process\tuse process");
    r.push("env\tp_getenv");
    r.push("env\tenv_var(");
    r.push("env\tuse env");
    r.push("ffi\textern ");
    r.push("ffi\tlink \"");
    r.push("unsafe\tunsafe {");
    r.push("unsafe\tunsafe{");
    return r;
}

/// What a pact uses: each capability once, with where it was first seen
/// (`why[i]`: "file (text)").
struct ArkCaps {
    names: Vec<str>,
    why: Vec<str>,
}

/// The capabilities the pact installed at `dest` uses (ark_cap_rules).
fn ark_pact_caps(dest: str) -> ArkCaps {
    var names: Vec<str> = Vec::new();
    var why: Vec<str> = Vec::new();
    var rules: Vec<str> = ark_cap_rules();
    var files: Vec<str> = ark_pact_files(dest);
    var fi: i64 = 0;
    while fi < files.len() {
        var f: str = files[fi];
        fi = fi + 1;
        var src: str = "";
        match read_file(f) {
            Option::Some(c) => {
                src = c;
            }
            Option::None => {
            }
        }
        var ri: i64 = 0;
        while ri < rules.len() {
            var rule: Vec<str> = str_split(rules[ri], "\t");
            ri = ri + 1;
            if !ark_has(names, rule[0]) && str_contains(src, rule[1]) {
                names.push(rule[0]);
                why.push(f + " (" + rule[1] + ")");
            }
        }
        var declared: Vec<str> = Vec::new();
        ark_audit_words(src, " with {", "}", &mut declared);
        var di: i64 = 0;
        while di < declared.len() {
            var cap: str = str_to_lower(str_trim(declared[di]));
            di = di + 1;
            if str_len(cap) > 0 && !ark_has(names, cap) {
                names.push(cap);
                why.push(f + " (with { " + str_trim(declared[di - 1]) + " })");
            }
        }
    }
    return ArkCaps {
        names: names, why: why
    };
}

/// The [capabilities] of an ark.toml: `on` when the section is there;
/// `caps[i]` the comma-joined grants of pact `names[i]`.
struct ArkGrants {
    on: bool,
    names: Vec<str>,
    caps: Vec<str>,
}

fn ark_cap_grants_of(content: str) -> ArkGrants {
    var on: bool = false;
    var names: Vec<str> = Vec::new();
    var caps: Vec<str> = Vec::new();
    var lines: Vec<str> = str_split(content, "\n");
    var li: i64 = 0;
    while li < lines.len() {
        if str_trim(str_replace(lines[li], "\r", "")) == "[capabilities]" {
            on = true;
        }
        li = li + 1;
    }
    var toml: Vec<TomlLine> = parse_toml(content);
    var i: i64 = 0;
    while i < toml.len() {
        if toml[i].section == "capabilities" {
            var list: Vec<str> = ark_toml_array(toml[i].value);
            var joined: str = "";
            var k: i64 = 0;
            while k < list.len() {
                if k > 0 {
                    joined = joined + ",";
                }
                joined = joined + str_to_lower(str_trim(list[k]));
                k = k + 1;
            }
            names.push(strip_quotes(toml[i].key));
            caps.push(joined);
        }
        i = i + 1;
    }
    return ArkGrants {
        on: on, names: names, caps: caps
    };
}

/// The capabilities `g` grants pact `name` (none when it is not listed).
fn ark_granted(g: ArkGrants, name: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < g.names.len() {
        if g.names[i] == name {
            var parts: Vec<str> = str_split(g.caps[i], ",");
            var k: i64 = 0;
            while k < parts.len() {
                if str_len(parts[k]) > 0 {
                    out.push(parts[k]);
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

/// Where the build reads pact `u` from: its vendored copy, else its
/// installed one ("" when it is not installed).
fn ark_unit_dest(u: ArkUnit) -> str {
    if !u.dev && ark_vendor_state(u.name) == "ok" {
        return ark_vendor_dest(u.name);
    }
    var dest: str = ark_pact_dest_in(u.base, u.name, u.kind);
    if ark_is_dir(dest) || ark_exists(dest) {
        return dest;
    }
    return "";
}

/// The [capabilities] of the ark.toml that grants: the workspace root's in
/// a member (L5F), else this one's.
fn ark_cap_manifest() -> str {
    var path: str = MANIFEST_FILE;
    if str_len(g_ark_ws_root) > 0 {
        path = g_ark_ws_root + "/" + MANIFEST_FILE;
    }
    match read_file(path) {
        Option::Some(c) => {
            return c;
        }
        Option::None => {
        }
    }
    return "";
}

/// CD1: each of `units` checked against the grants of ark.toml's
/// [capabilities] (nothing to check without that section). Prints every
/// capability used and not granted, with where; the number of pacts that
/// use more than they are granted.
fn ark_cap_check(units: Vec<ArkUnit>) -> i64 {
    var g: ArkGrants = ark_cap_grants_of(ark_cap_manifest());
    if !g.on {
        return 0;
    }
    var bad: i64 = 0;
    var i: i64 = 0;
    while i < units.len() {
        var u: ArkUnit = units[i];
        i = i + 1;
        var dest: str = ark_unit_dest(u);
        if str_len(dest) == 0 {
            continue;
        }
        var granted: Vec<str> = ark_granted(g, u.name);
        if ark_has(granted, "*") {
            continue;
        }
        var used: ArkCaps = ark_pact_caps(dest);
        var missing: str = "";
        var k: i64 = 0;
        while k < used.names.len() {
            if !ark_has(granted, used.names[k]) {
                missing = missing + "  " + used.names[k] + "  " + used.why[k] + "\n";
            }
            k = k + 1;
        }
        if str_len(missing) > 0 {
            bad = bad + 1;
            var by: str = "";
            if str_len(u.via) > 0 {
                by = " (needed by " + u.via + ")";
            }
            p_eprint_str("ark: pact '" + u.name + "'" + by + " uses capabilities ark.toml does not grant it:\n" + missing);
            p_eprint_str("  grant them under [capabilities] (" + u.name + " = " + ark_toml_list(ark_sorted(used.names)) + ") or drop the pact\n");
        }
    }
    if bad > 0 {
        p_eprint_str("ark: " + int_to_str(bad) + " pact(s) use capabilities they are not granted\n");
    }
    return bad;
}

/// What each of `units` uses now: `name<TAB>cap,cap` (sorted), for
/// ark_cap_diff.
fn ark_cap_snapshot(units: Vec<ArkUnit>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < units.len() {
        var dest: str = ark_unit_dest(units[i]);
        if str_len(dest) > 0 {
            var names: Vec<str> = ark_sorted(ark_pact_caps(dest).names);
            var joined: str = "";
            var k: i64 = 0;
            while k < names.len() {
                if k > 0 {
                    joined = joined + ",";
                }
                joined = joined + names[k];
                k = k + 1;
            }
            out.push(units[i].name + "\t" + joined);
        }
        i = i + 1;
    }
    return out;
}

/// The capabilities of snapshot entry `name` in `snap`; `found` false when
/// it has none (the pact was not there).
fn ark_cap_snap_get(snap: Vec<str>, name: str) -> ArkGitOut {
    var i: i64 = 0;
    while i < snap.len() {
        var f: Vec<str> = str_split(snap[i], "\t");
        if f[0] == name {
            var v: str = "";
            if f.len() > 1 {
                v = f[1];
            }
            return ArkGitOut {
                ok: true, out: v
            };
        }
        i = i + 1;
    }
    return ArkGitOut {
        ok: false, out: ""
    };
}

/// CD1: what changed in the capabilities of the pacts between two
/// snapshots (before and after `ark update`), printed: `+net` a pact uses
/// now and did not, `-fs` one it no longer uses.
fn ark_cap_diff(before: Vec<str>, after: Vec<str>) {
    var lines: str = "";
    var i: i64 = 0;
    while i < after.len() {
        var f: Vec<str> = str_split(after[i], "\t");
        i = i + 1;
        var now_s: str = "";
        if f.len() > 1 {
            now_s = f[1];
        }
        var old: ArkGitOut = ark_cap_snap_get(before, f[0]);
        if !old.ok {
            if str_len(now_s) > 0 {
                lines = lines + "  " + f[0] + " (new pact): " + str_replace(now_s, ",", ", ") + "\n";
            }
            continue;
        }
        if old.out == now_s {
            continue;
        }
        var was: Vec<str> = str_split(old.out, ",");
        var now: Vec<str> = str_split(now_s, ",");
        var change: str = "";
        var k: i64 = 0;
        while k < now.len() {
            if str_len(now[k]) > 0 && !ark_has(was, now[k]) {
                change = change + " +" + now[k];
            }
            k = k + 1;
        }
        var w: i64 = 0;
        while w < was.len() {
            if str_len(was[w]) > 0 && !ark_has(now, was[w]) {
                change = change + " -" + was[w];
            }
            w = w + 1;
        }
        lines = lines + "  " + f[0] + ":" + change + "\n";
    }
    if str_len(lines) == 0 {
        print("Capabilities: no change.\n");
    } else {
        print("Capability changes:\n" + lines);
    }
}

/// `ark yank <version> [--undo] [--package <name>]` (N6): mark a published
/// version yanked in the index (a fifth word `yanked` on its line),
/// committed and pushed like `ark publish`. A yanked version is never
/// chosen for a new lock (`ark add`, `ark install` without a lock entry,
/// `ark update`); a project whose ark.lock records it keeps installing it,
/// with a warning. `--undo` takes the mark off. The line itself stays:
/// versions never change and are never removed.
fn ark_cmd_yank(args: Vec<str>) -> i64 {
    var version: str = "";
    var name: str = "";
    var undo: bool = false;
    var i: i64 = 0;
    while i < args.len() {
        if args[i] == "--undo" {
            undo = true;
        } else if (args[i] == "--package" || args[i] == "-p") && i + 1 < args.len() {
            name = args[i + 1];
            i = i + 1;
        } else if str_len(version) == 0 {
            version = ark_strip_v(args[i]);
        }
        i = i + 1;
    }
    if str_len(version) == 0 {
        p_eprint_str("Usage: ark yank <version> [--undo] [--package <name>]\n");
        return 1;
    }
    if str_len(name) == 0 {
        var m: Manifest = manifest_load();
        if str_len(m.pkg_name) == 0 {
            return 1;
        }
        name = m.pkg_name;
    }
    var index: str = ark_update_index();
    if str_len(index) == 0 {
        return 1;
    }
    var file: str = index + "/" + name;
    var content: str = "";
    match read_file(file) {
        Option::Some(t) => {
            content = t;
        }
        Option::None => {
            p_eprint_str("ark: no package '" + name + "' in the index\n");
            return 1;
        }
    }
    var lines: Vec<str> = str_split(content, "\n");
    var out: str = "";
    var found: bool = false;
    var changed: bool = false;
    var li: i64 = 0;
    while li < lines.len() {
        var line: str = lines[li];
        li = li + 1;
        if li == lines.len() && str_len(str_trim(line)) == 0 {
            break;
        }
        var e: ArkIndexEntry = ark_index_line(line);
        if e.found && e.version == version {
            found = true;
            if e.yanked != !undo {
                changed = true;
                line = e.version + " " + e.git + " " + e.tag + " " + e.commit;
                if !undo {
                    line = line + " yanked";
                }
            }
        }
        out = out + line + "\n";
    }
    if !found {
        p_eprint_str("ark: " + name + " " + version + " is not in the index\n");
        return 1;
    }
    if !changed {
        if undo {
            print(name + " " + version + " is not yanked.\n");
        } else {
            print(name + " " + version + " is already yanked.\n");
        }
        return 0;
    }
    p_file_write(file, out);
    var what: str = "Yank";
    if undo {
        what = "Unyank";
    }
    var added: ArkGitOut = ark_git_out(index, "add " + ark_q(name));
    var committed: ArkGitOut = ark_git_out(index, "commit -q -m " + ark_q(what + " " + name + " " + version));
    if !added.ok || !committed.ok {
        p_eprint_str("ark: cannot commit to the index at " + index + "\n");
        return 1;
    }
    var pushed: ArkGitOut = ark_git_out(index, "push -q");
    var done: str = "Yanked ";
    if undo {
        done = "Unyanked ";
    }
    if pushed.ok {
        print(done + name + " " + version + ".\n");
    } else {
        print(done + name + " " + version + " in the local index at " + index + ", but the push failed.\n");
        print("Open a pull request against the index with that commit.\n");
    }
    return 0;
}

/// `ark vendor` (CD9): every pact, as installed in ark_modules/ (`ark
/// install` first when one is missing), copied into vendor/ -- its .fd, .c,
/// .h, .toml and .md files, not .git -- and vendor/vendor.lock written with
/// the hash of each copy. Commit vendor/: `use` looks there first
/// (compiler.fd ark_push_candidates), so the project builds offline, and
/// `ark install` / `ark audit` check each copy against vendor.lock.
fn ark_cmd_vendor(args: Vec<str>) -> i64 {
    var m: Manifest = manifest_load();
    if str_len(m.pkg_name) == 0 {
        return 1;
    }
    // what is not installed (and not vendored already) is installed first
    var missing: bool = false;
    var i: i64 = 0;
    while i < m.pacts.len() {
        var p: PactEntry = m.pacts[i];
        var kind: str = dep_kind_str(p.source);
        if str_len(ark_installed_rev(p.name, kind)) == 0 && str_len(ark_vendor_dest(p.name)) == 0 {
            missing = true;
        }
        i = i + 1;
    }
    if missing {
        if ark_install_all(false, "") != 0 {
            return 1;
        }
    }
    ark_mkdirs(ark_vendor_dir());
    var entries: Vec<LockEntry> = Vec::new();
    var copied: i64 = 0;
    // CD4: the pacts the pacts need are vendored too; L5A: dev-dependencies
    // are not (a build does not read them)
    var units: Vec<ArkUnit> = ark_units(m, lock_load());
    var j: i64 = 0;
    while j < units.len() {
        var q: ArkUnit = units[j];
        if q.dev {
            j = j + 1;
            continue;
        }
        var qkind: str = q.kind;
        var src: str = ark_pact_dest(q.name, qkind);
        var dest: str = ark_vendor_dir() + "/" + q.name;
        if !ark_is_dir(src) {
            dest = dest + ".fd";
        }
        if ark_is_dir(src) || p_file_exists(src) == true {
            var n: i64 = ark_copy_tree(src, dest);
            print("vendored " + q.name + ": " + int_to_str(n) + " file(s) -> " + dest + "\n");
            copied = copied + 1;
        } else if str_len(ark_vendor_dest(q.name)) > 0 {
            // vendored before and not installed now: kept as it is
            dest = ark_vendor_dest(q.name);
            print("kept     " + q.name + " (" + dest + ")\n");
        } else {
            p_eprint_str("ark: '" + q.name + "' is not installed: nothing to vendor\n");
            return 1;
        }
        entries.push(LockEntry_new(q.name, q.source, ark_vendor_hash(dest), qkind));
        j = j + 1;
    }
    lock_save_to(ark_vendor_lock(), "# vendor/vendor.lock -- the pacts copied into vendor/ (ark vendor)\n", entries);
    print("\nVendored " + int_to_str(copied) + " pact(s) into " + ark_vendor_dir() + "/; " + ark_vendor_lock() + " records each copy. Commit vendor/ to build offline.\n");
    return 0;
}

/// `ark update [name]`: the newest commit of every git pact and (L5C) the
/// newest version of every registry pact that each constraint on it
/// accepts (ark_resolve without the lock), or of `name` alone; installed
/// and written to ark.lock (tests/ark/ark-projects.sh).
fn ark_cmd_update(args: Vec<str>) -> i64 {
    var m: Manifest = manifest_load();
    if str_len(m.pkg_name) == 0 {
        return 1;
    }
    // CD1: what the pacts use before, for the diff after
    var before: Vec<str> = ark_cap_snapshot(ark_units(m, lock_load()));
    var rc: i64 = 0;
    if args.len() == 0 {
        print("Updating all pacts...\n");
        rc = ark_install_all(true, "");
    } else {
        print("Updating '");
        print(args[0]);
        print("'...\n");
        rc = ark_install_all(true, args[0]);
    }
    if rc != 0 {
        return rc;
    }
    var units: Vec<ArkUnit> = ark_units(m, lock_load());
    ark_cap_diff(before, ark_cap_snapshot(units));
    if ark_cap_check(units) > 0 {
        return 1;
    }
    return 0;
}

// --- L5A: build targets ([target], [[bin]], [[lib]], [[test]]) ---------------
// `ark build` builds every bin and lib of ark.toml with fid, `ark test`
// runs every test target with `fid test`. ark.toml declares them as
//   [target]                    [[bin]]               [[lib]]
//   bin = ["src/main.fd"]       name = "app"          name = "util"
//   lib = "src/lib.fd"          path = "src/app.fd"   path = "src/util.fd"
//   test = ["tests/a.fd"]                             kind = "shared"
//   dir = "build"
// (a [target] path or array; any number of [[bin]], [[lib]], [[test]]). A
// bin is `fid build <path> -o <dir>/<name>`; a lib is checked (`fid check
// <path>`: other packages `use` its source) or, with kind = "shared", built
// as a shared library (`fid build <path> --lib`). Nothing declared: bin
// src/main.fd (or main.fd) and lib src/lib.fd when they exist, tests
// tests/*.fd. The output directory is [target] dir, default "build".

/// One build target of ark.toml.
struct ArkTarget {
    kind: str,
    name: str,
    path: str,
    lib_kind: str,
}

/// Where ark's command is on its command line (ark_main): the words
/// before it run ark again (`fid ark`, `ark`, `fid run tools/ark.fd --`).
var g_ark_start: i64 = 0;

/// L5F: the command that runs ark again (in a workspace member): the words
/// before the command, the program and files made absolute.
fn ark_self_cmd() -> str {
    var self_cmd: str = "";
    var w: i64 = 0;
    while w < g_ark_start {
        var word: str = p_argv(w);
        if w == 0 || ark_exists(word) {
            word = ark_abs_word(word);
        }
        if w > 0 {
            self_cmd = self_cmd + " ";
        }
        self_cmd = self_cmd + ark_word(word);
        w = w + 1;
    }
    if str_len(self_cmd) == 0 {
        return "ark";
    }
    return self_cmd;
}

/// Does a file (or directory) `path` exist? (p_file_exists as a bool.)
fn ark_exists(path: str) -> bool {
    if p_file_exists(path) {
        return true;
    }
    return false;
}

/// The last part of `path` without `.fd`.
fn ark_stem(path: str) -> str {
    var p: str = str_replace(path, "\\", "/");
    var cut: i64 = 0;
    var i: i64 = 0;
    while i < str_len(p) {
        if str_byte_at(p, i) == 47 {
            cut = i + 1;
        }
        i = i + 1;
    }
    var base: str = str_slice(p, cut, str_len(p));
    if str_ends_with(base, ".fd") {
        return str_slice(base, 0, str_len(base) - 3);
    }
    return base;
}

/// A target with its missing name or path filled in.
fn ark_target_done(t: ArkTarget, pkg: str) -> ArkTarget {
    var d: ArkTarget = t;
    if str_len(d.path) == 0 {
        if d.kind == "lib" {
            d.path = "src/lib.fd";
        } else if d.kind == "test" {
            d.path = "tests/" + d.name + ".fd";
        } else if d.name == pkg {
            d.path = "src/main.fd";
        } else {
            d.path = "src/bin/" + d.name + ".fd";
        }
    }
    if str_len(d.name) == 0 {
        d.name = ark_stem(d.path);
        if (d.name == "main" || d.name == "lib") && d.kind != "test" && str_len(pkg) > 0 {
            d.name = pkg;
        }
    }
    if d.kind == "lib" && str_len(d.lib_kind) == 0 {
        d.lib_kind = "check";
    }
    return d;
}

/// ArkTarget of `kind` with nothing filled in.
fn ArkTarget_new(kind: str) -> ArkTarget {
    return ArkTarget {
        kind: kind, name: "", path: "", lib_kind: ""
    };
}

/// The targets ark.toml declares (in the sections ark keeps as written,
/// `m.other_sections`), else the default ones that exist.
fn ark_targets_of(m: Manifest) -> Vec<ArkTarget> {
    var out: Vec<ArkTarget> = Vec::new();
    var lines: Vec<str> = str_split(m.other_sections, "\n");
    var cur: ArkTarget = ArkTarget_new("");
    var in_table: bool = false;
    var in_target: bool = false;
    var i: i64 = 0;
    while i <= lines.len() {
        var line: str = "";
        if i < lines.len() {
            line = str_trim(str_replace(lines[i], "\r", ""));
        }
        var header: bool = i == lines.len() || (str_len(line) > 0 && str_byte_at(line, 0) == 91 && str_ends_with(line, "]") && !str_starts_with(line, "[\""));
        // a `key = [` array over several lines is no header
        if header && i < lines.len() && str_find(line, "=") > 0 {
            header = false;
        }
        if header {
            if in_table {
                out.push(ark_target_done(cur, m.pkg_name));
            }
            in_table = false;
            in_target = false;
            if i < lines.len() {
                if str_starts_with(line, "[[") && str_ends_with(line, "]]") {
                    var k: str = str_trim(str_slice(line, 2, str_len(line) - 2));
                    if k == "bin" || k == "lib" || k == "test" {
                        cur = ArkTarget_new(k);
                        in_table = true;
                    }
                } else {
                    in_target = str_trim(str_slice(line, 1, str_len(line) - 1)) == "target";
                }
            }
            i = i + 1;
            continue;
        }
        var eq: i64 = str_find(line, "=");
        if str_len(line) == 0 || str_byte_at(line, 0) == 35 || eq <= 0 {
            i = i + 1;
            continue;
        }
        var key: str = str_trim(str_slice(line, 0, eq));
        var value: str = str_trim(str_slice(line, eq + 1, str_len(line)));
        while str_starts_with(value, "[") && str_find(value, "]") < 0 && i + 1 < lines.len() {
            i = i + 1;
            value = value + " " + str_trim(lines[i]);
        }
        if in_table {
            if key == "name" {
                cur.name = ark_toml_unstr(value);
            } else if key == "path" {
                cur.path = ark_toml_unstr(value);
            } else if key == "kind" || key == "crate-type" {
                cur.lib_kind = ark_toml_unstr(value);
            }
        } else if in_target && (key == "bin" || key == "lib" || key == "test") {
            var paths: Vec<str> = ark_toml_array(value);
            var pi: i64 = 0;
            while pi < paths.len() {
                var t: ArkTarget = ArkTarget_new(key);
                t.path = paths[pi];
                out.push(ark_target_done(t, m.pkg_name));
                pi = pi + 1;
            }
        }
        i = i + 1;
    }
    if out.len() > 0 {
        return out;
    }
    // nothing declared: the files a package of the usual layout has
    var main_file: str = "";
    if p_file_exists("src/main.fd") {
        main_file = "src/main.fd";
    } else if p_file_exists("main.fd") {
        main_file = "main.fd";
    }
    if str_len(main_file) > 0 {
        var b: ArkTarget = ArkTarget_new("bin");
        b.path = main_file;
        out.push(ark_target_done(b, m.pkg_name));
    }
    if p_file_exists("src/lib.fd") {
        var l: ArkTarget = ArkTarget_new("lib");
        l.path = "src/lib.fd";
        out.push(ark_target_done(l, m.pkg_name));
    }
    if ark_is_dir("tests") {
        var names: Vec<str> = ark_sorted(str_split(p_dir_list("tests"), "\n"));
        var ni: i64 = 0;
        while ni < names.len() {
            var nm: str = str_trim(names[ni]);
            if str_ends_with(nm, ".fd") {
                var tt: ArkTarget = ArkTarget_new("test");
                tt.path = "tests/" + nm;
                out.push(ark_target_done(tt, m.pkg_name));
            }
            ni = ni + 1;
        }
    }
    return out;
}

/// [target] dir: where `ark build` puts what it builds ("build").
fn ark_target_dir(m: Manifest) -> str {
    var toml: Vec<TomlLine> = parse_toml(m.other_sections);
    var i: i64 = 0;
    while i < toml.len() {
        if toml[i].section == "target" && toml[i].key == "dir" {
            var d: str = ark_toml_unstr(toml[i].value);
            if str_len(d) > 0 {
                return d;
            }
        }
        i = i + 1;
    }
    return "build";
}

/// `s` as one word of a shell command (quoted when it holds a space).
fn ark_word(s: str) -> str {
    if str_contains(s, " ") || str_contains(s, "&") || str_len(s) == 0 {
        return ark_q(s);
    }
    return s;
}

/// Run the shell command `cmd`; its exit code. On Windows (cmd.exe /C) a
/// command that starts with a quote is wrapped in one more pair: cmd
/// strips the first and the last quote of such a command.
fn ark_run(cmd: str) -> i64 {
    if ark_is_windows() && str_starts_with(cmd, "\"") {
        return p_system("\"" + cmd + "\"");
    }
    return p_system(cmd);
}

/// The compiler `ark build` and `ark test` run.
fn ark_fid() -> str {
    match env_var("ARK_FID") {
        Option::Some(f) => {
            if str_len(f) > 0 {
                return ark_word(f);
            }
        }
        Option::None => {
        }
    }
    // run by fid (`fid ark ...`, `fid run tools/ark.fd -- ...`): that fid
    if g_ark_start >= 2 {
        return ark_word(ark_abs_word(p_argv(0)));
    }
    return "fid";
}

/// Is target `t` one of `wanted` (by name; no names: every target)?
fn ark_target_wanted(t: ArkTarget, wanted: Vec<str>) -> bool {
    return wanted.len() == 0 || ark_has(wanted, t.name);
}

/// `ark build [--release|--debug] [--target <triple>] [--dry-run] [name...]`:
/// every bin and lib target (or the ones named) built with fid.
fn ark_cmd_build(args: Vec<str>) -> i64 {
    var m: Manifest = manifest_load();
    if str_len(m.pkg_name) == 0 {
        return 1;
    }
    var pass: str = "";
    var dry: bool = false;
    var wanted: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < args.len() {
        var a: str = args[i];
        if a == "--release" || a == "--debug" || a == "--no-opt" || a == "--lto" {
            pass = pass + " " + a;
        } else if a == "--target" && i + 1 < args.len() {
            pass = pass + " --target " + ark_word(args[i + 1]);
            i = i + 1;
        } else if a == "--dry-run" || a == "-n" {
            dry = true;
        } else if (a == "--bin" || a == "--lib") && i + 1 < args.len() {
            wanted.push(args[i + 1]);
            i = i + 1;
        } else if !str_starts_with(a, "-") {
            wanted.push(a);
        }
        i = i + 1;
    }
    // CD1: no build with a pact that uses more than it is granted
    if ark_cap_check(ark_units(m, lock_load())) > 0 {
        return 1;
    }
    var targets: Vec<ArkTarget> = ark_targets_of(m);
    var dir: str = ark_target_dir(m);
    if (m.pacts.len() > 0) && !ark_is_dir(MODULES_DIR) && !ark_is_dir(ark_vendor_dir()) {
        p_eprint_str("warning: ark_modules/ is missing: run 'ark install' first\n");
    }
    // L5E: the prebuilt libraries of binary pacts beside what is built
    var failed: i64 = ark_bin_copy_to(dir, dry);
    var lib_env: str = ark_bin_env_prefix();
    // off Windows a program that links a prebuilt library is built through
    // C (`fid ccompile`: the `link` libraries, -L from FID_LIB_PATH, the
    // $ORIGIN rpath); on Windows `fid build` (pe_ir) imports the DLL by name
    var bin_verb: str = " build ";
    if str_len(lib_env) > 0 && !ark_is_windows() {
        bin_verb = " ccompile ";
    }
    var built: i64 = 0;
    var t: i64 = 0;
    while t < targets.len() {
        var tg: ArkTarget = targets[t];
        t = t + 1;
        if tg.kind == "test" || !ark_target_wanted(tg, wanted) {
            continue;
        }
        var cmd: str = "";
        var what: str = tg.kind + " " + tg.name + " (" + tg.path + ")";
        if tg.kind == "bin" {
            cmd = lib_env + ark_fid() + bin_verb + ark_word(tg.path) + " -o " + ark_word(dir + "/" + tg.name) + pass;
            what = what + " -> " + dir + "/" + tg.name;
        } else if tg.lib_kind == "shared" || tg.lib_kind == "dylib" || tg.lib_kind == "cdylib" {
            cmd = lib_env + ark_fid() + " build " + ark_word(tg.path) + " --lib -o " + ark_word(dir + "/" + tg.name) + pass;
            what = what + " -> " + dir + "/" + tg.name + " (shared)";
        } else {
            cmd = ark_fid() + " check " + ark_word(tg.path);
            what = what + " checked";
        }
        if dry {
            print(cmd + "\n");
            built = built + 1;
            continue;
        }
        print("Building " + what + "\n");
        if !ark_exists(tg.path) {
            p_eprint_str("ark: " + tg.kind + " '" + tg.name + "': no file " + tg.path + "\n");
            failed = failed + 1;
            continue;
        }
        if tg.kind == "bin" || tg.lib_kind != "check" {
            ark_mkdirs(dir);
        }
        if ark_run(cmd) != 0 {
            p_eprint_str("ark: " + tg.kind + " '" + tg.name + "' failed: " + cmd + "\n");
            failed = failed + 1;
        } else {
            built = built + 1;
        }
    }
    if built + failed == 0 {
        if wanted.len() > 0 {
            p_eprint_str("ark: no bin or lib target named " + ark_join(wanted) + "\n");
            return 1;
        }
        print("No bin or lib targets (declare [[bin]] or [[lib]] in ark.toml, or add src/main.fd).\n");
        return 0;
    }
    if dry {
        return 0;
    }
    print("\nBuilt " + int_to_str(built) + " target(s)");
    if failed > 0 {
        print(", " + int_to_str(failed) + " failed\n");
        return 1;
    }
    print("\n");
    return 0;
}

/// `ark test [--dry-run] [name...]`: `fid test` on every test target (or
/// the ones named).
fn ark_cmd_test(args: Vec<str>) -> i64 {
    var m: Manifest = manifest_load();
    if str_len(m.pkg_name) == 0 {
        return 1;
    }
    // CD1: the dev pacts too
    if ark_cap_check(ark_units(m, lock_load())) > 0 {
        return 1;
    }
    var dry: bool = false;
    var wanted: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < args.len() {
        if args[i] == "--dry-run" || args[i] == "-n" {
            dry = true;
        } else if !str_starts_with(args[i], "-") {
            wanted.push(args[i]);
        }
        i = i + 1;
    }
    var targets: Vec<ArkTarget> = ark_targets_of(m);
    // L5E: the test programs link the prebuilt libraries of binary pacts
    // (dev pacts too) and find them when they run (ark_bin_env)
    var test_env: str = ark_bin_env(true, true);
    var ran: i64 = 0;
    var failed: i64 = 0;
    var t: i64 = 0;
    while t < targets.len() {
        var tg: ArkTarget = targets[t];
        t = t + 1;
        if tg.kind != "test" || !ark_target_wanted(tg, wanted) {
            continue;
        }
        var cmd: str = test_env + ark_fid() + " test " + ark_word(tg.path);
        ran = ran + 1;
        if dry {
            print(cmd + "\n");
            continue;
        }
        print("Testing " + tg.name + " (" + tg.path + ")\n");
        if ark_run(cmd) != 0 {
            failed = failed + 1;
        }
    }
    if ran == 0 {
        print("No test targets (declare [[test]] in ark.toml, or add tests/*.fd).\n");
        return 0;
    }
    if dry {
        return 0;
    }
    print("\n" + int_to_str(ran) + " test target(s), " + int_to_str(failed) + " failed\n");
    if failed > 0 {
        return 1;
    }
    return 0;
}

/// `ark targets`: the build targets, one per line (`kind name path`).
fn ark_cmd_targets(args: Vec<str>) -> i64 {
    var m: Manifest = manifest_load();
    if str_len(m.pkg_name) == 0 {
        return 1;
    }
    var targets: Vec<ArkTarget> = ark_targets_of(m);
    var i: i64 = 0;
    while i < targets.len() {
        var line: str = targets[i].kind + " " + targets[i].name + " " + targets[i].path;
        if targets[i].kind == "lib" {
            line = line + " (" + targets[i].lib_kind + ")";
        }
        print(line + "\n");
        i = i + 1;
    }
    return 0;
}

// --- L5F: workspaces ---------------------------------------------------------
// An ark.toml with
//   [workspace]
//   members = ["app", "libs/*"]
//   exclude = ["libs/old"]
// is a workspace root: `ark install`, `list`, `lock`, `update`, `audit`,
// `vendor`, `build`, `test` and `targets` there run in each member (a
// directory with its own ark.toml; `dir/*` is every such directory in
// dir), and in the root too when it has a [package] of its own. Each
// member keeps its ark_modules/ and ark.lock. `--no-workspace` runs the
// command in the root alone.

/// The output of shell command `cmd` (trimmed; "" when it fails).
fn ark_shell_out(cmd: str) -> str {
    var home: str = ark_home();
    var tmp: str = ".ark_shell_out";
    if str_len(home) > 0 {
        ark_mkdirs(home + "/.ark");
        tmp = home + "/.ark/.ark_shell_out";
    }
    var text: str = "";
    if p_system(cmd + " > " + ark_q(tmp) + " 2> " + ark_null()) == 0 {
        match read_file(tmp) {
            Option::Some(s) => {
                text = str_trim(s);
            }
            Option::None => {
            }
        }
    }
    p_file_delete(tmp);
    return text;
}

/// The current directory, `/` for separators ("" when it cannot be had).
fn ark_cwd() -> str {
    if ark_is_windows() {
        return str_replace(ark_shell_out("cd"), "\\", "/");
    }
    return ark_shell_out("pwd");
}

/// `p` made absolute when it names a file by a relative path with a
/// directory part (`./fid`, `release/fid.exe`); a bare name (found on
/// PATH) and an absolute path are kept.
fn ark_abs_word(p: str) -> str {
    if ark_is_abs(p) || (!str_contains(p, "/") && !str_contains(p, "\\")) {
        return p;
    }
    var cwd: str = ark_cwd();
    if str_len(cwd) == 0 {
        return p;
    }
    return ark_norm_path(cwd + "/" + p);
}

/// The members of the workspace whose root is the ark.toml here (none when
/// it has no [workspace] or no members).
fn ark_workspace_members() -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var content: str = "";
    match read_file(MANIFEST_FILE) {
        Option::Some(c) => {
            content = c;
        }
        Option::None => {
            return out;
        }
    }
    var toml: Vec<TomlLine> = parse_toml(content);
    var listed: Vec<str> = Vec::new();
    var exclude: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < toml.len() {
        if toml[i].section == "workspace" {
            if toml[i].key == "members" {
                listed = ark_toml_array(toml[i].value);
            }
            if toml[i].key == "exclude" {
                exclude = ark_toml_array(toml[i].value);
            }
        }
        i = i + 1;
    }
    var j: i64 = 0;
    while j < listed.len() {
        var pat: str = ark_norm_path(listed[j]);
        j = j + 1;
        if str_ends_with(pat, "/*") || pat == "*" {
            var parent: str = ".";
            if pat != "*" {
                parent = str_slice(pat, 0, str_len(pat) - 2);
            }
            var names: Vec<str> = ark_sorted(str_split(p_dir_list(parent), "\n"));
            var k: i64 = 0;
            while k < names.len() {
                var nm: str = str_trim(names[k]);
                k = k + 1;
                if str_len(nm) == 0 || nm == "." || nm == ".." {
                    continue;
                }
                var d: str = nm;
                if parent != "." {
                    d = parent + "/" + nm;
                }
                if ark_is_dir(d) && ark_exists(d + "/" + MANIFEST_FILE) && !ark_has(exclude, d) && !ark_has(out, d) {
                    out.push(d);
                }
            }
        } else if !ark_has(exclude, pat) && !ark_has(out, pat) {
            out.push(pat);
        }
    }
    return out;
}

/// Is `command` one a workspace root runs in each member?
fn ark_workspace_command(command: str) -> bool {
    return command == "install" || command == "i" || command == "list" || command == "ls" || command == "lock" || command == "update" || command == "audit" || command == "vendor" || command == "build" || command == "test" || command == "targets";
}

/// `command args` in the root (when it is a package too) and in each of
/// `members`; 1 when any of them fails (every one runs).
fn ark_workspace_run(command: str, args: Vec<str>, members: Vec<str>) -> i64 {
    // L5F: install, update and lock resolve the whole workspace at once
    if command == "install" || command == "i" || command == "update" || command == "lock" {
        return ark_workspace_install(command, args, members);
    }
    var rest: str = "";
    var a: i64 = 0;
    while a < args.len() {
        rest = rest + " " + ark_word(args[a]);
        a = a + 1;
    }
    var root_pkg: str = "";
    match read_file(MANIFEST_FILE) {
        Option::Some(c) => {
            root_pkg = manifest_parse(c).pkg_name;
        }
        Option::None => {
        }
    }
    print("Workspace: " + int_to_str(members.len()) + " member(s): " + ark_join(members) + "\n");
    var self_cmd: str = ark_self_cmd();
    var failed: Vec<str> = Vec::new();
    if str_len(root_pkg) > 0 {
        print("\n== . (" + root_pkg + ")\n");
        if ark_run(self_cmd + " " + command + rest + " --no-workspace") != 0 {
            failed.push(".");
        }
    }
    var i: i64 = 0;
    while i < members.len() {
        var d: str = members[i];
        i = i + 1;
        print("\n== " + d + "\n");
        if !ark_is_dir(d) || !ark_exists(d + "/" + MANIFEST_FILE) {
            p_eprint_str("ark: workspace member '" + d + "' has no " + MANIFEST_FILE + "\n");
            failed.push(d);
            continue;
        }
        var cd: str = "cd " + ark_q(d);
        if ark_is_windows() {
            cd = "cd /d " + ark_q(str_replace(d, "/", "\\"));
        }
        if ark_run(cd + " && " + self_cmd + " " + command + rest) != 0 {
            failed.push(d);
        }
    }
    if failed.len() > 0 {
        p_eprint_str("\nark " + command + " failed in " + ark_join(failed) + "\n");
        return 1;
    }
    return 0;
}

/// L5F: does the [workspace] of the ark.toml text `content` list member
/// `rel` (a path relative to its directory, `/` separators)?
fn ark_ws_lists(content: str, rel: str) -> bool {
    var toml: Vec<TomlLine> = parse_toml(content);
    var listed: Vec<str> = Vec::new();
    var exclude: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < toml.len() {
        if toml[i].section == "workspace" {
            if toml[i].key == "members" {
                listed = ark_toml_array(toml[i].value);
            }
            if toml[i].key == "exclude" {
                exclude = ark_toml_array(toml[i].value);
            }
        }
        i = i + 1;
    }
    var e: i64 = 0;
    while e < exclude.len() {
        if ark_norm_path(exclude[e]) == rel {
            return false;
        }
        e = e + 1;
    }
    var slash: i64 = -1;
    var k: i64 = 0;
    while k < str_len(rel) {
        if str_byte_at(rel, k) == 47 {
            slash = k;
        }
        k = k + 1;
    }
    var j: i64 = 0;
    while j < listed.len() {
        var pat: str = ark_norm_path(listed[j]);
        j = j + 1;
        if pat == rel {
            return true;
        }
        if pat == "*" && slash < 0 {
            return true;
        }
        if str_ends_with(pat, "/*") && slash >= 0 && str_slice(rel, 0, slash) == str_slice(pat, 0, str_len(pat) - 2) {
            return true;
        }
    }
    return false;
}

/// L5F: the root of the workspace this directory is a member of, as a
/// relative path (`..`, `../..`), or "": the nearest ark.toml above with a
/// [workspace], when its members list this directory.
fn ark_ws_root_find() -> str {
    match read_file(MANIFEST_FILE) {
        Option::Some(own) => {
            if str_contains(own, "[workspace]") {
                return "";
            }
        }
        Option::None => {
            return "";
        }
    }
    var up: str = "..";
    var level: i64 = 1;
    while level <= 8 {
        match read_file(up + "/" + MANIFEST_FILE) {
            Option::Some(c) => {
                if str_contains(c, "[workspace]") {
                    var parts: Vec<str> = str_split(ark_norm_path(ark_cwd()), "/");
                    if parts.len() <= level {
                        return "";
                    }
                    var rel: str = "";
                    var p: i64 = parts.len() - level;
                    while p < parts.len() {
                        if str_len(rel) > 0 {
                            rel = rel + "/";
                        }
                        rel = rel + parts[p];
                        p = p + 1;
                    }
                    if ark_ws_lists(c, rel) {
                        return up;
                    }
                    return "";
                }
            }
            Option::None => {
            }
        }
        up = up + "/..";
        level = level + 1;
    }
    return "";
}

/// L5F: `ark install`, `ark update [name]` and `ark lock` in a workspace
/// root: the pacts of the root (when it is a package too) and of every
/// member resolved together -- one version of each pact for the whole
/// workspace -- installed once into the root's ark_modules/ and recorded
/// in the root's one ark.lock. A member reads both (g_ark_ws_root).
fn ark_workspace_install(command: str, args: Vec<str>, members: Vec<str>) -> i64 {
    var update: bool = command == "update";
    var only: str = "";
    var with_dev: bool = true;
    var a: i64 = 0;
    while a < args.len() {
        if args[a] == "--no-dev" {
            with_dev = false;
        } else if update && !str_starts_with(args[a], "-") {
            only = args[a];
        }
        a = a + 1;
    }
    var all: Manifest = Manifest_new("");
    match read_file(MANIFEST_FILE) {
        Option::Some(c) => {
            all = manifest_parse(c);
        }
        Option::None => {
        }
    }
    var roots: Vec<ArkReq> = Vec::new();
    var dev_roots: Vec<ArkReq> = Vec::new();
    // who asks for each pact: `users[i]` the members of pact `used[i]`
    var used: Vec<str> = Vec::new();
    var users: Vec<str> = Vec::new();
    var r0: i64 = 0;
    while r0 < all.pacts.len() {
        roots.push(ark_req_of(all.pacts[r0], all.pkg_name, "", false, ""));
        used.push(all.pacts[r0].name);
        users.push(".");
        r0 = r0 + 1;
    }
    var d0: i64 = 0;
    while d0 < all.dev_pacts.len() {
        dev_roots.push(ark_req_of(all.dev_pacts[d0], all.pkg_name, "", true, ""));
        d0 = d0 + 1;
    }
    print("Workspace: " + int_to_str(members.len()) + " member(s): " + ark_join(members) + "; one ark.lock, one copy of each pact\n");
    var i: i64 = 0;
    while i < members.len() {
        var d: str = members[i];
        i = i + 1;
        var text: str = "";
        match read_file(d + "/" + MANIFEST_FILE) {
            Option::Some(c2) => {
                text = c2;
            }
            Option::None => {
                p_eprint_str("ark: workspace member '" + d + "' has no " + MANIFEST_FILE + "\n");
                return 1;
            }
        }
        var mm: Manifest = manifest_parse(text);
        var who: str = mm.pkg_name;
        if str_len(who) == 0 {
            who = d;
        }
        var k: i64 = 0;
        while k < mm.pacts.len() {
            var p: PactEntry = mm.pacts[k];
            k = k + 1;
            roots.push(ark_req_of(p, who, "", false, d));
            if manifest_find_pact(all, p.name) < 0 {
                all.pacts.push(p);
            }
            var at: i64 = -1;
            var u: i64 = 0;
            while u < used.len() {
                if used[u] == p.name {
                    at = u;
                }
                u = u + 1;
            }
            if at < 0 {
                used.push(p.name);
                users.push(who);
            } else {
                users.set(at, users[at] + ", " + who);
            }
        }
        var dk: i64 = 0;
        while dk < mm.dev_pacts.len() {
            var dp: PactEntry = mm.dev_pacts[dk];
            dk = dk + 1;
            dev_roots.push(ark_req_of(dp, who, "", true, d));
            if manifest_find_dev_pact(all, dp.name) < 0 {
                all.dev_pacts.push(dp);
            }
        }
    }
    if roots.len() == 0 && (!with_dev || dev_roots.len() == 0) {
        print("No pacts to install.\n");
        var none: Vec<LockEntry> = Vec::new();
        lock_save(none);
        return 0;
    }
    ark_mkdirs(MODULES_DIR);
    var old_lock: Vec<LockEntry> = lock_load();
    var before: Vec<str> = Vec::new();
    if update {
        before = ark_cap_snapshot(ark_units(all, old_lock));
    }
    var res: ArkResolution = ark_resolve_reqs(roots, dev_roots, with_dev, old_lock, update, only);
    if !res.ok {
        return 1;
    }
    var s: i64 = 0;
    while s < used.len() {
        if str_contains(users[s], ", ") {
            print(used[s] + ": shared by " + users[s] + "\n");
        }
        s = s + 1;
    }
    var rc: i64 = ark_install_picks(all, res.picks, old_lock, update, only, with_dev);
    if rc != 0 {
        return rc;
    }
    var units: Vec<ArkUnit> = ark_units(all, lock_load());
    if update {
        ark_cap_diff(before, ark_cap_snapshot(units));
    }
    if ark_cap_check(units) > 0 {
        return 1;
    }
    return 0;
}

// --- L5E: binary packages (prebuilt libraries) --------------------------------
// A package can ship a prebuilt library of its public functions for each
// target, so that the projects that use it link the library instead of
// compiling its source. In the package, `ark prebuild [--target <t>]`
// builds the lib target (src/lib.fd) with `fid build --lib` into
// prebuilt/<target>/: the library (<name>.dll, lib<name>.so,
// lib<name>.dylib), its C header, and prebuilt.toml, which records the
// target, the library's hash, the hash of the source it was built from and
// the signature of each function (`fn = "add(a: i64, b: i64) -> i64"`).
// The exported functions are the lib's `@export` functions, else its
// top-level `pub fn`s; only integers, floats and bool cross the library
// (each side has its own Fides runtime, so no str, Vec or struct), and a
// function with another type stops the prebuild. The library's C names are
// `ark_bin_<name>_<fn>` (a shim beside the source wraps each function), so
// they cannot collide with the Fides names. The package commits prebuilt/
// and publishes as usual (a tag, `ark publish`).
// In a project, `binary = true` on a pact's line (or `ark install
// --binary` for every pact that ships one; `--source` for none) makes
// `ark install` check the pact's prebuilt/<target>/ (target: ARK_TARGET,
// else this machine): the library's hash, and the source hash against the
// installed source (a stale prebuilt falls back to the source with a
// warning; a library that does not match its hash fails the install). It
// then writes ark_modules/<name>.fd, the binary interface: an `extern "C"
// link` block of the library's functions and a `pub fn` of the same name
// and signature over each, which `use <name>` finds before the pact's
// src/lib.fd (compiler.fd ark_push_candidates), so the source is not
// compiled. ark_modules/.binaries lists each library; `ark build` copies
// them beside what it builds (where Windows looks for a DLL) and, off
// Windows, puts their directories on LIBRARY_PATH for the linker. `ark
// audit` checks each library against its recorded hash.

/// ark install --binary / --source (ark_main).
var g_ark_binary_all: bool = false;
var g_ark_binary_off: bool = false;

/// One function a prebuilt library exports: its Fides name, the names and
/// types of its parameters, its return type ("" for none), or why it
/// cannot cross a library (`err`).
struct ArkBinFn {
    name: str,
    pnames: Vec<str>,
    ptypes: Vec<str>,
    ret: str,
    err: str,
}

/// What ark_bin_exports finds in a lib's source.
struct ArkBinScan {
    fns: Vec<ArkBinFn>,
    bad: Vec<str>,
    explicit: bool,
    has_main: bool,
}

/// Is `t` a type that crosses a prebuilt library as one C value?
fn ark_bin_scalar(t: str) -> bool {
    return t == "i8" || t == "i16" || t == "i32" || t == "i64" || t == "u8" || t == "u16" || t == "u32" || t == "u64" || t == "f32" || t == "f64" || t == "bool";
}

/// Is `s` an identifier (letters, digits, `_`; not starting with a digit)?
fn ark_bin_ident(s: str) -> bool {
    if str_len(s) == 0 {
        return false;
    }
    var c0: i64 = str_byte_at(s, 0);
    if c0 >= 48 && c0 <= 57 {
        return false;
    }
    var i: i64 = 0;
    while i < str_len(s) {
        if !ark_is_ident(str_byte_at(s, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// ArkBinFn named `name` that cannot cross a library, for `why`.
fn ArkBinFn_bad(name: str, why: str) -> ArkBinFn {
    return ArkBinFn {
        name: name, pnames: Vec::new(), ptypes: Vec::new(), ret: "", err: why
    };
}

/// The function of the signature `sig` (`add(a: i64, b: i64) -> i64`,
/// what follows `fn`), with `err` set when it cannot cross a library.
fn ark_bin_parse_sig(sig: str) -> ArkBinFn {
    var s: str = ark_norm_ws(sig);
    var open: i64 = str_find(s, "(");
    if open <= 0 {
        return ArkBinFn_bad(s, "not a function signature");
    }
    var name: str = str_trim(str_slice(s, 0, open));
    if !ark_bin_ident(name) {
        return ArkBinFn_bad(name, "a generic function has no prebuilt form");
    }
    var close: i64 = str_find(s, ")");
    if close < open {
        return ArkBinFn_bad(name, "not a function signature");
    }
    var f: ArkBinFn = ArkBinFn_bad(name, "");
    var inner: str = str_trim(str_slice(s, open + 1, close));
    if str_contains(inner, "(") {
        return ArkBinFn_bad(name, "a function-typed parameter has no prebuilt form");
    }
    if str_len(inner) > 0 {
        var parts: Vec<str> = str_split(inner, ",");
        var i: i64 = 0;
        while i < parts.len() {
            var part: str = str_trim(parts[i]);
            i = i + 1;
            if str_len(part) == 0 {
                continue;
            }
            if str_starts_with(part, "mut ") {
                part = str_trim(str_slice(part, 4, str_len(part)));
            }
            var colon: i64 = str_find(part, ":");
            if colon <= 0 {
                return ArkBinFn_bad(name, "a method (self) has no prebuilt form");
            }
            var pn: str = str_trim(str_slice(part, 0, colon));
            var pt: str = str_trim(str_slice(part, colon + 1, str_len(part)));
            if !ark_bin_ident(pn) || pn == "self" {
                return ArkBinFn_bad(name, "a method (self) has no prebuilt form");
            }
            if !ark_bin_scalar(pt) {
                return ArkBinFn_bad(name, "parameter " + pn + ": " + pt + " cannot cross a prebuilt library (integers, floats and bool only)");
            }
            f.pnames.push(pn);
            f.ptypes.push(pt);
        }
    }
    var rest: str = str_trim(str_slice(s, close + 1, str_len(s)));
    if str_starts_with(rest, "->") {
        var rt: str = str_trim(str_slice(rest, 2, str_len(rest)));
        if rt != "void" {
            if !ark_bin_scalar(rt) {
                return ArkBinFn_bad(name, "result " + rt + " cannot cross a prebuilt library (integers, floats and bool only)");
            }
            f.ret = rt;
        }
    } else if str_len(rest) > 0 {
        return ArkBinFn_bad(name, "`" + rest + "` after the parameters has no prebuilt form");
    }
    return f;
}

/// `f` written back as a signature (`add(a: i64, b: i64) -> i64`).
fn ark_bin_sig(f: ArkBinFn) -> str {
    var s: str = f.name + "(" + ark_bin_params(f) + ")";
    if str_len(f.ret) > 0 {
        s = s + " -> " + f.ret;
    }
    return s;
}

/// The parameter list of `f` (`a: i64, b: i64`).
fn ark_bin_params(f: ArkBinFn) -> str {
    var s: str = "";
    var i: i64 = 0;
    while i < f.pnames.len() {
        if i > 0 {
            s = s + ", ";
        }
        s = s + f.pnames[i] + ": " + f.ptypes[i];
        i = i + 1;
    }
    return s;
}

/// The arguments of a call that passes on the parameters of `f` (`a, b`).
fn ark_bin_args(f: ArkBinFn) -> str {
    var s: str = "";
    var i: i64 = 0;
    while i < f.pnames.len() {
        if i > 0 {
            s = s + ", ";
        }
        s = s + f.pnames[i];
        i = i + 1;
    }
    return s;
}

/// The functions a lib's source `src` exports through a prebuilt library:
/// its top-level `@export` functions, else its top-level `pub fn`s (not
/// `main`); `bad` lists the ones that cannot cross a library.
fn ark_bin_exports(src: str) -> ArkBinScan {
    var t: str = ark_api_clean(src);
    var n: i64 = str_len(t);
    var exported: Vec<str> = Vec::new();
    var pubs: Vec<str> = Vec::new();
    var has_main: bool = false;
    var pending: bool = false;
    var depth: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(t, i);
        if c == 123 {
            depth = depth + 1;
            i = i + 1;
            continue;
        }
        if c == 125 {
            depth = depth - 1;
            i = i + 1;
            continue;
        }
        if c == 64 && depth == 0 {
            if ark_word_at(t, i + 1) == "export" {
                pending = true;
            }
            i = i + 1 + str_len(ark_word_at(t, i + 1));
            continue;
        }
        if !ark_is_ident(c) {
            i = i + 1;
            continue;
        }
        var w: str = ark_word_at(t, i);
        if depth != 0 {
            i = i + str_len(w);
            continue;
        }
        var is_pub: bool = false;
        var j: i64 = i;
        if w == "pub" {
            is_pub = true;
            j = ark_skip_ws(t, i + 3);
            w = ark_word_at(t, j);
        }
        if w != "fn" {
            if w == "struct" || w == "enum" || w == "impl" || w == "trait" || w == "const" || w == "extern" || w == "type" || w == "union" {
                pending = false;
            }
            i = j + str_len(w);
            if str_len(w) == 0 {
                i = j + 1;
            }
            continue;
        }
        var end: i64 = ark_find_any(t, j, 123, 59);
        var sig: str = str_trim(str_slice(t, j + 2, end));
        var fname: str = ark_word_at(sig, 0);
        if fname == "main" {
            has_main = true;
        } else if pending {
            exported.push(sig);
        } else if is_pub {
            pubs.push(sig);
        }
        pending = false;
        if end < n && str_byte_at(t, end) == 123 {
            i = ark_match_brace(t, end);
        } else {
            i = end + 1;
        }
    }
    var scan: ArkBinScan = ArkBinScan {
        fns: Vec::new(), bad: Vec::new(), explicit: exported.len() > 0, has_main: has_main
    };
    var chosen: Vec<str> = pubs;
    if exported.len() > 0 {
        chosen = exported;
    }
    var k: i64 = 0;
    while k < chosen.len() {
        var f: ArkBinFn = ark_bin_parse_sig(chosen[k]);
        if str_len(f.err) > 0 {
            scan.bad.push(f.name + ": " + f.err);
        } else {
            scan.fns.push(f);
        }
        k = k + 1;
    }
    return scan;
}

/// A target name in ark's spelling, `<arch>-<os>` (x86_64-windows,
/// aarch64-linux, aarch64-macos...): `linux-arm64`, `arm64-macos`,
/// `x64-windows`, `amd64-linux` and `darwin` are read too.
fn ark_bin_norm_target(t: str) -> str {
    var s: str = str_to_lower(str_trim(t));
    var dash: i64 = str_find(s, "-");
    if dash <= 0 {
        return s;
    }
    var a: str = str_slice(s, 0, dash);
    var b: str = str_slice(s, dash + 1, str_len(s));
    if a == "linux" || a == "macos" || a == "darwin" || a == "windows" {
        var tmp: str = a;
        a = b;
        b = tmp;
    }
    if a == "arm64" {
        a = "aarch64";
    }
    if a == "x64" || a == "amd64" || a == "x86-64" {
        a = "x86_64";
    }
    if b == "darwin" || b == "apple-darwin" {
        b = "macos";
    }
    if str_starts_with(b, "pc-windows") || str_starts_with(b, "w64-") {
        b = "windows";
    }
    if str_starts_with(b, "unknown-linux") || str_starts_with(b, "linux-") {
        b = "linux";
    }
    return a + "-" + b;
}

/// This machine's target (x86_64-windows, aarch64-linux, ...).
fn ark_bin_host_target() -> str {
    if ark_is_windows() {
        var arch: str = "x86_64";
        match env_var("PROCESSOR_ARCHITECTURE") {
            Option::Some(v) => {
                if str_to_lower(v) == "arm64" {
                    arch = "aarch64";
                }
            }
            Option::None => {
            }
        }
        return arch + "-windows";
    }
    var m: str = str_to_lower(ark_shell_out("uname -m"));
    var s: str = str_to_lower(ark_shell_out("uname -s"));
    var os: str = "linux";
    if str_starts_with(s, "darwin") {
        os = "macos";
    }
    if str_len(m) == 0 {
        m = "x86_64";
    }
    return ark_bin_norm_target(m + "-" + os);
}

/// The target whose prebuilt libraries `ark install` uses: ARK_TARGET,
/// else this machine's.
fn ark_bin_target() -> str {
    match env_var("ARK_TARGET") {
        Option::Some(v) => {
            if str_len(str_trim(v)) > 0 {
                return ark_bin_norm_target(v);
            }
        }
        Option::None => {
        }
    }
    return ark_bin_host_target();
}

/// The OS of target `t`: windows, macos or linux.
fn ark_bin_os(t: str) -> str {
    if str_contains(t, "windows") {
        return "windows";
    }
    if str_contains(t, "macos") {
        return "macos";
    }
    return "linux";
}

/// The library's name for `link "..."`: the package name with `-` and `.`
/// made `_`.
fn ark_bin_link_name(pkg: str) -> str {
    return str_replace(str_replace(pkg, "-", "_"), ".", "_");
}

/// The file of library `link` on `os` (as `fid build --lib` names it).
fn ark_bin_lib_file(lname: str, os: str) -> str {
    if os == "windows" {
        return lname + ".dll";
    }
    if os == "macos" {
        return "lib" + lname + ".dylib";
    }
    return "lib" + lname + ".so";
}

/// The C name of export `f` of library `link` (ark_bin_<link>_<fn>).
fn ark_bin_c_name(lname: str, f: ArkBinFn) -> str {
    return "ark_bin_" + lname + "_" + f.name;
}

/// "fnv:<hash>" of the bytes of file `path` ("" when it is missing or empty).
fn ark_file_hash(path: str) -> str {
    var bytes: Vec<i64> = p_file_read_bytes(path);
    if bytes.len() == 0 {
        return "";
    }
    var h: i64 = 8834263827529598795;
    var i: i64 = 0;
    while i < bytes.len() {
        h = ark_fnv_byte(h, bytes[i]);
        i = i + 1;
    }
    return "fnv:" + int_to_str(h) + ":" + int_to_str(bytes.len());
}

/// One step of FNV-1a.
@wrapping
fn ark_fnv_byte(h: i64, b: i64) -> i64 {
    return (h ^ (b & 0xFF)) * 1099511628211;
}

/// Copy file `src` to `dest` byte for byte; did it work?
fn ark_copy_bytes(src: str, dest: str) -> bool {
    var bytes: Vec<i64> = p_file_read_bytes(src);
    if bytes.len() == 0 {
        return false;
    }
    p_file_write_vec(dest, bytes);
    return ark_file_hash(dest) == ark_file_hash(src);
}

/// The hash of the source a prebuilt library is built from: ark_tree_hash
/// of the .fd files under `dir`, with each file's `\r` taken out (a git
/// checkout may turn LF into CRLF), "fnv:<hash>".
fn ark_bin_src_hash(dir: str) -> str {
    var files: Vec<str> = Vec::new();
    ark_collect_fd(dir, &mut files);
    var total: i64 = 0;
    var i: i64 = 0;
    while i < files.len() {
        var f: str = files[i];
        var h: i64 = ark_fnv(8834263827529598795, str_slice(f, str_len(dir), str_len(f)));
        match read_file(f) {
            Option::Some(c) => {
                h = ark_fnv(h, str_replace(c, "\r", ""));
            }
            Option::None => {
            }
        }
        total = ark_wrap_add(total, h);
        i = i + 1;
    }
    return "fnv:" + int_to_str(total);
}

/// The directory part of `path` ("" for a bare file name).
fn ark_dir_of(path: str) -> str {
    var p: str = str_replace(path, "\\", "/");
    var slash: i64 = str_rfind(p, "/");
    if slash < 0 {
        return "";
    }
    return str_slice(p, 0, slash);
}

/// The binary interface ark install writes as ark_modules/<pact>.fd: an
/// extern block of the library's C names and a `pub fn` over each.
fn ark_bin_interface(pact: str, version: str, target: str, lname: str, lib_rel: str, fns: Vec<ArkBinFn>) -> str {
    var out: str = "// ark_modules/" + pact + ".fd -- the binary interface of pact " + pact + " " + version + " (" + target + ")\n";
    out = out + "// DO NOT EDIT -- generated by ark install (L5E) from " + lib_rel + ":\n";
    out = out + "// `use " + pact + "` calls that prebuilt library; the pact's source is not compiled.\n";
    out = out + "extern \"C\" link \"" + lname + "\" {\n";
    var i: i64 = 0;
    while i < fns.len() {
        var f: ArkBinFn = fns[i];
        var decl: str = "    fn " + ark_bin_c_name(lname, f) + "(" + ark_bin_params(f) + ")";
        if str_len(f.ret) > 0 {
            decl = decl + " -> " + f.ret;
        }
        out = out + decl + ";\n";
        i = i + 1;
    }
    out = out + "}\n";
    i = 0;
    while i < fns.len() {
        var g: ArkBinFn = fns[i];
        out = out + "\npub fn " + ark_bin_sig(g) + " {\n    unsafe {\n";
        var call_text: str = ark_bin_c_name(lname, g) + "(" + ark_bin_args(g) + ");";
        if str_len(g.ret) > 0 {
            out = out + "        return " + call_text + "\n";
        } else {
            out = out + "        " + call_text + "\n";
        }
        out = out + "    }\n}\n";
        i = i + 1;
    }
    return out;
}

/// Is the file at `path` a binary interface ark install wrote?
fn ark_bin_is_iface(path: str) -> bool {
    match read_file(path) {
        Option::Some(c) => {
            return str_starts_with(c, "// ark_modules/") && str_contains(c, "generated by ark install (L5E)");
        }
        Option::None => {
        }
    }
    return false;
}

/// Remove the binary interface of a pact (`path`: ark_modules/<pact>.fd)
/// when ark wrote it (a file pact of that name is left alone).
fn ark_bin_drop_iface(path: str) {
    if ark_bin_is_iface(path) {
        p_file_delete(path);
    }
}

/// Did the project ask for pact `name` as a prebuilt library (`binary =
/// true` on its line, or `ark install --binary`; never with --source)?
fn ark_bin_wanted(m: Manifest, name: str) -> bool {
    if g_ark_binary_off {
        return false;
    }
    if g_ark_binary_all {
        return true;
    }
    var i: i64 = 0;
    while i < m.pacts.len() {
        if m.pacts[i].name == name && m.pacts[i].binary {
            return true;
        }
        i = i + 1;
    }
    i = 0;
    while i < m.dev_pacts.len() {
        if m.dev_pacts[i].name == name && m.dev_pacts[i].binary {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The value of `key` in the TOML lines `toml` ("" when not there).
fn ark_bin_key(toml: Vec<TomlLine>, key: str) -> str {
    var i: i64 = 0;
    while i < toml.len() {
        if toml[i].key == key {
            return ark_toml_unstr(toml[i].value);
        }
        i = i + 1;
    }
    return "";
}

/// Is `p` a relative path inside its directory (no `..`, not absolute)?
fn ark_bin_inside(p: str) -> bool {
    return str_len(p) > 0 && !ark_is_abs(p) && !str_contains(p, "..") && !str_starts_with(p, "/") && !str_contains(p, "\\");
}

/// Use the prebuilt library of the pact installed at `dest` (named `pact`,
/// under `base`) for `target`: checked, and its interface written to
/// `base`/<pact>.fd. "" when used; else why not, starting with "!" when
/// the install must fail (a library that does not match its hash).
fn ark_bin_use(base: str, dest: str, pact: str, target: str) -> str {
    var rel: str = "prebuilt/" + target;
    var meta: str = dest + "/" + rel + "/prebuilt.toml";
    var text: str = "";
    match read_file(meta) {
        Option::Some(c) => {
            text = c;
        }
        Option::None => {
            return "no prebuilt library for " + target + " (`ark prebuild --target " + target + "` in the package)";
        }
    }
    var toml: Vec<TomlLine> = parse_toml(text);
    var lib: str = ark_bin_key(toml, "library");
    var lname: str = ark_bin_key(toml, "link");
    var source: str = ark_bin_key(toml, "source");
    if !ark_bin_inside(lib) || str_contains(lib, "/") || !ark_bin_ident(lname) || !ark_bin_inside(source) {
        return "!" + meta + ": library, link or source is missing or not a plain name";
    }
    var lib_path: str = dest + "/" + rel + "/" + lib;
    var lib_hash: str = ark_file_hash(lib_path);
    if str_len(lib_hash) == 0 {
        return "!" + rel + "/" + lib + " is missing";
    }
    if lib_hash != ark_bin_key(toml, "library-hash") {
        return "!" + rel + "/" + lib + " does not match the hash prebuilt.toml records (" + lib_hash + ")";
    }
    var src_hash: str = ark_bin_src_hash(dest + "/" + source);
    if src_hash != ark_bin_key(toml, "source-hash") {
        return "the prebuilt library was built from other source than this version's " + source + "/ (stale: `ark prebuild` again in the package)";
    }
    var fns: Vec<ArkBinFn> = Vec::new();
    var i: i64 = 0;
    while i < toml.len() {
        if toml[i].key == "fn" {
            var f: ArkBinFn = ark_bin_parse_sig(ark_toml_unstr(toml[i].value));
            if str_len(f.err) > 0 {
                return "!" + meta + ": fn " + f.name + ": " + f.err;
            }
            fns.push(f);
        }
        i = i + 1;
    }
    if fns.len() == 0 {
        return "!" + meta + " lists no functions";
    }
    var version: str = ark_bin_key(toml, "version");
    var iface: str = ark_bin_interface(pact, version, target, lname, pact + "/" + rel + "/" + lib, fns);
    p_file_write(base + "/" + pact + ".fd", iface);
    return "";
}

/// After ark install put the pacts `picks` in place: the prebuilt library
/// of each the project asks for as binary (ark_bin_use), the interfaces of
/// the others removed, and <base>/.binaries written. The number of pacts
/// whose library failed its check.
fn ark_bin_apply(m: Manifest, picks: Vec<ArkPick>) -> i64 {
    var target: str = "";
    var head: str = "# ark_modules/.binaries -- the prebuilt libraries ark install chose (L5E)\n# DO NOT EDIT -- generated by ark; `ark build` copies each beside what it builds\n";
    var normal: str = head;
    var dev: str = head;
    var any_dev: bool = false;
    var any_normal: bool = false;
    var failed: i64 = 0;
    var i: i64 = 0;
    while i < picks.len() {
        var p: ArkPick = picks[i];
        i = i + 1;
        var base: str = ark_base(p.dev);
        var dest: str = base + "/" + p.name;
        var iface: str = base + "/" + p.name + ".fd";
        var used: bool = false;
        var asked: bool = ark_bin_wanted(m, p.name) && !g_ark_binary_all;
        if ark_bin_wanted(m, p.name) && ark_is_dir(dest) && (asked || ark_is_dir(dest + "/prebuilt")) {
            if str_len(target) == 0 {
                target = ark_bin_target();
            }
            var why: str = ark_bin_use(base, dest, p.name, target);
            if str_len(why) == 0 {
                var toml: Vec<TomlLine> = Vec::new();
                match read_file(dest + "/prebuilt/" + target + "/prebuilt.toml") {
                    Option::Some(c) => {
                        toml = parse_toml(c);
                    }
                    Option::None => {
                    }
                }
                var lib_rel: str = p.name + "/prebuilt/" + target + "/" + ark_bin_key(toml, "library");
                var line: str = p.name + " = " + quote(lib_rel) + "\n";
                if p.dev {
                    dev = dev + line;
                    any_dev = true;
                } else {
                    normal = normal + line;
                    any_normal = true;
                }
                print("  " + p.name + ": prebuilt " + target + " library " + ark_bin_key(toml, "library") + " (its source is not compiled)\n");
                used = true;
            } else if str_starts_with(why, "!") {
                p_eprint_str("ark: pact '" + p.name + "': " + str_slice(why, 1, str_len(why)) + "\n");
                failed = failed + 1;
            } else {
                p_eprint_str("warning: pact '" + p.name + "' is built from source: " + why + "\n");
            }
        }
        if !used {
            ark_bin_drop_iface(iface);
        }
    }
    if any_normal || ark_exists(MODULES_DIR + "/.binaries") {
        p_file_write(ark_base(false) + "/.binaries", normal);
    }
    if any_dev || ark_exists(ark_dev_dir() + "/.binaries") {
        ark_mkdirs(ark_base(true));
        p_file_write(ark_base(true) + "/.binaries", dev);
    }
    return failed;
}

/// The prebuilt libraries ark_modules/.binaries (or .dev/.binaries) lists,
/// as paths from here: name, then path, for each.
fn ark_bin_libraries(dev: bool) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var base: str = ark_base(dev);
    match read_file(base + "/.binaries") {
        Option::Some(t) => {
            var toml: Vec<TomlLine> = parse_toml(t);
            var i: i64 = 0;
            while i < toml.len() {
                var rel: str = ark_toml_unstr(toml[i].value);
                if ark_bin_inside(rel) {
                    out.push(toml[i].key);
                    out.push(base + "/" + rel);
                }
                i = i + 1;
            }
        }
        Option::None => {
        }
    }
    return out;
}

/// `ark build`: the prebuilt libraries copied into `dir` (where Windows
/// finds a DLL beside the program); with `dry`, what would be copied.
/// The number that could not be copied.
fn ark_bin_copy_to(dir: str, dry: bool) -> i64 {
    var libs: Vec<str> = ark_bin_libraries(false);
    var bad: i64 = 0;
    var i: i64 = 0;
    while i + 1 < libs.len() {
        var path: str = libs[i + 1];
        var file: str = str_slice(path, str_len(ark_dir_of(path)) + 1, str_len(path));
        if dry {
            print("copy " + path + " " + dir + "/" + file + "\n");
        } else {
            ark_mkdirs(dir);
            if ark_copy_bytes(path, dir + "/" + file) {
                print("Prebuilt " + libs[i] + ": " + file + " -> " + dir + "/\n");
            } else {
                p_eprint_str("ark: cannot copy the prebuilt library " + path + " to " + dir + "/\n");
                bad = bad + 1;
            }
        }
        i = i + 2;
    }
    return bad;
}

/// The start of an `ark build` command for the prebuilt libraries
/// (ark_bin_env without the run-time search path).
fn ark_bin_env_prefix() -> str {
    return ark_bin_env(false, false);
}

/// L5E: the directories of the prebuilt libraries ark_modules/.binaries
/// lists (with `dev`, .dev/.binaries too), absolute, each once.
fn ark_bin_lib_dirs(dev: bool) -> Vec<str> {
    var libs: Vec<str> = ark_bin_libraries(false);
    if dev {
        var more: Vec<str> = ark_bin_libraries(true);
        var m: i64 = 0;
        while m < more.len() {
            libs.push(more[m]);
            m = m + 1;
        }
    }
    var out: Vec<str> = Vec::new();
    if libs.len() == 0 {
        return out;
    }
    var cwd: str = ark_cwd();
    var i: i64 = 0;
    while i + 1 < libs.len() {
        var d: str = ark_dir_of(libs[i + 1]);
        if !ark_is_abs(d) && str_len(cwd) > 0 {
            d = ark_norm_path(cwd + "/" + d);
        }
        if str_len(d) > 0 && !ark_has(out, d) {
            out.push(d);
        }
        i = i + 2;
    }
    return out;
}

/// L5E: the start of a shell command that builds (`fid build`, `fid
/// ccompile`) or tests (`fid test`, with `run`) against the prebuilt
/// libraries; "" when no pact is used as one. FID_LIB_PATH: fid's C path
/// passes each directory as -L (Windows and elsewhere) and gives a Linux
/// program the $ORIGIN rpath (ark build copies the libraries beside it);
/// off Windows also LIBRARY_PATH (a C compiler's own search path). With
/// `run` (the test programs fid test builds and runs where they are not
/// beside the libraries): PATH on Windows, LD_LIBRARY_PATH and
/// DYLD_LIBRARY_PATH elsewhere; `dev`: the dev pacts' libraries too.
fn ark_bin_env(dev: bool, run: bool) -> str {
    var dirs: Vec<str> = ark_bin_lib_dirs(dev);
    if dirs.len() == 0 {
        return "";
    }
    var sep: str = ":";
    if ark_is_windows() {
        sep = ";";
    }
    var joined: str = "";
    var native: str = "";
    var i: i64 = 0;
    while i < dirs.len() {
        if i > 0 {
            joined = joined + sep;
            native = native + sep;
        }
        joined = joined + dirs[i];
        native = native + str_replace(dirs[i], "/", "\\");
        i = i + 1;
    }
    if ark_is_windows() {
        // cmd.exe: `set "NAME=value" && ...` sets it for what follows
        var w: str = "set \"FID_LIB_PATH=" + joined + "\" && ";
        if run {
            w = w + "set \"PATH=" + native + ";%PATH%\" && ";
        }
        return w;
    }
    var q: str = "'" + joined + "'";
    var p: str = "FID_LIB_PATH=" + q + " LIBRARY_PATH=" + q + "${LIBRARY_PATH:+:$LIBRARY_PATH} ";
    if run {
        p = p + "LD_LIBRARY_PATH=" + q + "${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH} DYLD_LIBRARY_PATH=" + q + "${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH} ";
    }
    return p;
}

/// `ark audit`: pact `name` under `base` as a prebuilt library -- its
/// library against the hash its prebuilt.toml records. 1 when it differs.
fn ark_bin_audit(base: str, name: str) -> i64 {
    var libs: Vec<str> = ark_bin_libraries(base != ark_base(false));
    var i: i64 = 0;
    while i + 1 < libs.len() {
        if libs[i] == name {
            var path: str = libs[i + 1];
            var want: str = "";
            match read_file(ark_dir_of(path) + "/prebuilt.toml") {
                Option::Some(c) => {
                    want = ark_bin_key(parse_toml(c), "library-hash");
                }
                Option::None => {
                }
            }
            var now: str = ark_file_hash(path);
            if str_len(now) > 0 && now == want && ark_bin_is_iface(base + "/" + name + ".fd") {
                print("  prebuilt  " + path + "  " + now + " (its source is not compiled)\n");
                return 0;
            }
            print("  PREBUILT CHANGED: " + path + " is " + now + ", prebuilt.toml has " + want + " (ark install)\n");
            return 1;
        }
        i = i + 2;
    }
    return 0;
}

/// `ark prebuild --check`: the recorded library's bytes `kept` written
/// back to `path` (the file removed when there were none).
fn ark_bin_restore(path: str, kept: Vec<i64>) {
    if kept.len() > 0 {
        p_file_write_vec(path, kept);
    } else {
        p_file_delete(path);
    }
}

/// `ark prebuild [--target <t>] [--from <library>] [--check] [--dry-run]`:
/// the lib target built as a prebuilt library into prebuilt/<target>/
/// with prebuilt.toml (see the top of this section). --from packages a
/// library built some other way (it must export the ark_bin_ names);
/// --check builds again and compares with the recorded library (a
/// reproducible build gives the same bytes).
fn ark_cmd_prebuild(args: Vec<str>) -> i64 {
    var m: Manifest = manifest_load();
    if str_len(m.pkg_name) == 0 {
        return 1;
    }
    var target: str = "";
    var from_lib: str = "";
    var dry: bool = false;
    var check: bool = false;
    var i: i64 = 0;
    while i < args.len() {
        var a: str = args[i];
        if a == "--target" && i + 1 < args.len() {
            target = ark_bin_norm_target(args[i + 1]);
            i = i + 1;
        } else if a == "--from" && i + 1 < args.len() {
            from_lib = args[i + 1];
            i = i + 1;
        } else if a == "--dry-run" || a == "-n" {
            dry = true;
        } else if a == "--check" {
            check = true;
        } else {
            p_eprint_str("ark prebuild: unknown argument " + a + "\n");
            return 1;
        }
        i = i + 1;
    }
    var cross: bool = str_len(target) > 0;
    if !cross {
        target = ark_bin_target();
    }
    // the lib target
    var lib_path: str = "";
    var targets: Vec<ArkTarget> = ark_targets_of(m);
    var t: i64 = 0;
    while t < targets.len() {
        if targets[t].kind == "lib" && str_len(lib_path) == 0 {
            lib_path = targets[t].path;
        }
        t = t + 1;
    }
    if str_len(lib_path) == 0 {
        p_eprint_str("ark prebuild: no lib target (src/lib.fd, or [[lib]] in ark.toml)\n");
        return 1;
    }
    var src: str = "";
    match read_file(lib_path) {
        Option::Some(c) => {
            src = c;
        }
        Option::None => {
            p_eprint_str("ark prebuild: no file " + lib_path + "\n");
            return 1;
        }
    }
    var source: str = ark_dir_of(lib_path);
    if !ark_bin_inside(source) {
        p_eprint_str("ark prebuild: the lib target must be in a directory of the package (src/lib.fd), not " + lib_path + "\n");
        return 1;
    }
    var scan: ArkBinScan = ark_bin_exports(src);
    if scan.bad.len() > 0 {
        p_eprint_str("ark prebuild: these functions of " + lib_path + " cannot cross a prebuilt library:\n");
        var b: i64 = 0;
        while b < scan.bad.len() {
            p_eprint_str("  " + scan.bad[b] + "\n");
            b = b + 1;
        }
        if !scan.explicit {
            p_eprint_str("Mark the functions to ship with @export (integers, floats and bool only).\n");
        }
        return 1;
    }
    if scan.fns.len() == 0 {
        p_eprint_str("ark prebuild: " + lib_path + " has no @export or pub functions to ship\n");
        return 1;
    }
    var lname: str = ark_bin_link_name(m.pkg_name);
    var lib_file: str = ark_bin_lib_file(lname, ark_bin_os(target));
    var out_dir: str = "prebuilt/" + target;
    var out_lib: str = out_dir + "/" + lib_file;
    // --check builds to the same path: a library holds its own file name
    // (a DLL's export directory names it), so another name gives other
    // bytes. The recorded library is kept aside (`kept`) and written back
    // once it is compared (ark_bin_restore).
    var recorded: str = "";
    var kept: Vec<i64> = Vec::new();
    if check && !dry {
        match read_file(out_dir + "/prebuilt.toml") {
            Option::Some(c) => {
                recorded = ark_bin_key(parse_toml(c), "library-hash");
            }
            Option::None => {
            }
        }
        if str_len(recorded) == 0 {
            p_eprint_str("ark prebuild --check: no " + out_dir + "/prebuilt.toml to compare with\n");
            return 1;
        }
        kept = p_file_read_bytes(out_lib);
    }
    var src_hash: str = ark_bin_src_hash(source);
    // the shim: the lib's source and an ark_bin_ entry point over each export
    var shim: str = source + "/.ark_prebuild_" + lname + ".fd";
    var shim_text: str = src + "\n\n// ark prebuild (L5E): the C entry points of the prebuilt library\n";
    var names: str = "";
    var k: i64 = 0;
    while k < scan.fns.len() {
        var f: ArkBinFn = scan.fns[k];
        var cname: str = ark_bin_c_name(lname, f);
        if k > 0 {
            names = names + ",";
        }
        names = names + cname;
        shim_text = shim_text + "pub fn " + cname + "(" + ark_bin_params(f) + ")";
        if str_len(f.ret) > 0 {
            shim_text = shim_text + " -> " + f.ret + " {\n    return " + f.name + "(" + ark_bin_args(f) + ");\n}\n";
        } else {
            shim_text = shim_text + " {\n    " + f.name + "(" + ark_bin_args(f) + ");\n}\n";
        }
        k = k + 1;
    }
    if !scan.has_main {
        shim_text = shim_text + "\nfn main() -> i64 {\n    return 0;\n}\n";
    }
    var cmd: str = ark_fid() + " build " + ark_word(shim) + " --lib --export " + names + " -o " + ark_word(out_lib);
    if cross {
        cmd = cmd + " --target " + ark_word(target);
    }
    if dry {
        if str_len(from_lib) > 0 {
            print("copy " + from_lib + " " + out_lib + "\n");
        } else {
            print(cmd + "\n");
        }
        k = 0;
        while k < scan.fns.len() {
            print("fn " + ark_bin_sig(scan.fns[k]) + "  (C name " + ark_bin_c_name(lname, scan.fns[k]) + ")\n");
            k = k + 1;
        }
        return 0;
    }
    ark_mkdirs(out_dir);
    if str_len(from_lib) > 0 {
        print("Packaging " + from_lib + " as " + out_lib + "\n");
        if !ark_copy_bytes(from_lib, out_lib) {
            p_eprint_str("ark prebuild: cannot read " + from_lib + "\n");
            if check {
                ark_bin_restore(out_lib, kept);
            }
            return 1;
        }
    } else {
        print("Building " + lib_path + " for " + target + " -> " + out_lib + "\n");
        p_file_write(shim, shim_text);
        var rc: i64 = ark_run(cmd);
        p_file_delete(shim);
        p_file_delete(out_lib + ".c");
        // fid writes the C header beside the library, named after the shim
        var header: str = out_dir + "/.ark_prebuild_" + lname + ".h";
        match read_file(header) {
            Option::Some(h) => {
                if !check {
                    p_file_write(out_dir + "/" + lname + ".h", h);
                }
                p_file_delete(header);
            }
            Option::None => {
            }
        }
        if rc != 0 || !ark_exists(out_lib) {
            p_eprint_str("ark prebuild: the build failed: " + cmd + "\n");
            if check {
                ark_bin_restore(out_lib, kept);
            }
            return 1;
        }
    }
    var lib_hash: str = ark_file_hash(out_lib);
    if check {
        ark_bin_restore(out_lib, kept);
        if recorded != lib_hash {
            print("DIFFERENT: the library built now is " + lib_hash + ", " + out_dir + "/prebuilt.toml records " + recorded + "\n");
            return 1;
        }
        print("same: the library built now matches " + out_dir + "/prebuilt.toml (" + lib_hash + ")\n");
        return 0;
    }
    var meta: str = "# prebuilt.toml -- a prebuilt library of " + m.pkg_name + " (L5E)\n";
    meta = meta + "# DO NOT EDIT -- generated by ark prebuild; ark install checks both hashes\n";
    meta = meta + "name = " + ark_toml_str(m.pkg_name) + "\n";
    meta = meta + "version = " + ark_toml_str(m.pkg_version) + "\n";
    meta = meta + "target = " + ark_toml_str(target) + "\n";
    meta = meta + "library = " + ark_toml_str(lib_file) + "\n";
    meta = meta + "link = " + ark_toml_str(lname) + "\n";
    meta = meta + "library-hash = " + ark_toml_str(lib_hash) + "\n";
    meta = meta + "source = " + ark_toml_str(source) + "\n";
    meta = meta + "source-hash = " + ark_toml_str(src_hash) + "\n";
    k = 0;
    while k < scan.fns.len() {
        meta = meta + "fn = " + ark_toml_str(ark_bin_sig(scan.fns[k])) + "\n";
        k = k + 1;
    }
    p_file_write(out_dir + "/prebuilt.toml", meta);
    print("Prebuilt " + m.pkg_name + " " + m.pkg_version + " for " + target + ": " + out_lib + " (" + int_to_str(scan.fns.len()) + " function(s), source " + source + "/ " + src_hash + ")\n");
    print("Commit " + out_dir + "/ and publish; a project with `binary = true` on this pact links the library.\n");
    return 0;
}

fn ark_cmd_version() -> i64 {
    print("ark 0.1.0 -- Fides package manager\n");
    print("Load your ark with pacts. Binding agreements of trust.\n");
    return 0;
}

fn ark_print_help() -> void {
    print("ark -- Package manager for Fides\n\n");
    print("USAGE:\n");
    print("    ark <command> [options]\n\n");
    print("COMMANDS:\n");
    print("    init [name]              Create a new ark.toml in the current directory\n");
    print("        --author <a>         An author (again for more); --description <d>, --license <spdx>\n");
    print("    add <name> [options]     Add a pact (dependency)\n");
    print("        --dev                As a dev-dependency (for fid test; ark_modules/.dev/)\n");
    print("        --path <path>        Path dependency\n");
    print("        --git <url>          Git dependency\n");
    print("        --branch <branch>    Git branch\n");
    print("        --tag <tag>          Git tag\n");
    print("        --version <spec>     A package of the index (1.2, ^1, *)\n");
    print("        --features <a,b>     Features to enable in it (ark_modules/.features; @cfg(feature = \"a\"))\n");
    print("    install [--no-dev]       Install all pacts from ark.toml and the pacts they need, one version\n");
    print("                             each (git pacts at the commit ark.lock records; repositories fetched\n");
    print("                             once per machine into ARK_CACHE or ~/.ark/cache; ark_modules/<name>\n");
    print("                             links to the cache's one checkout of that commit, ARK_LINK=0: a copy)\n");
    print("    remove <name>            Remove a pact\n");
    print("    list                     List all pacts\n");
    print("    lock                     Write ark.lock from what is installed (git commits, file hashes)\n");
    print("    audit [--files]          What a build pulls in: each pact's revision against ark.lock,\n");
    print("                             its lines, unsafe blocks, externs, process/file/network calls\n");
    print("    update [name]            Newest commit of every git pact and newest version of every registry\n");
    print("                             pact within its constraint (^1.2, ~1.2, 1.x...), or of one; installed\n");
    print("                             and written to ark.lock\n");
    print("    build [names] [--release] [--target <t>] [--dry-run]\n");
    print("                             Build every bin and lib target ([target], [[bin]], [[lib]]; default\n");
    print("                             src/main.fd, src/lib.fd) with fid into [target] dir (build/)\n");
    print("    test [names] [--dry-run] fid test on every test target ([[test]], [target] test; tests/*.fd)\n");
    print("    targets                  List the build targets\n");
    print("    vendor                   Copy every pact into vendor/ (with vendor/vendor.lock): builds work offline\n");
    print("    search <query>           Search the package index (ARK_INDEX)\n");
    print("    publish [--git <url>]    Add this package's tagged version (v<version>) to the index; a minor\n");
    print("                             or patch version must keep the public API of the release before it\n");
    print("    yank <version> [--undo]  Mark a published version yanked: no new lock chooses it, ark.lock\n");
    print("                             files that record it keep it (--package <name>: another package)\n");
    print("    api [--against <rev>]    This package's public API; what changed since <rev>\n");
    print("    prebuild [--target <t>] [--from <lib>] [--check] [--dry-run]\n");
    print("                             Build the lib target as a prebuilt library into prebuilt/<target>/\n");
    print("                             (with prebuilt.toml: hashes, functions); a pact with binary = true\n");
    print("                             (ark add --binary, ark install --binary) links it, its source not compiled\n");
    print("    version                  Show version\n");
    print("    help                     Show this help\n\n");
    print("WORKSPACES: an ark.toml with [workspace] members = [\"a\", \"libs/*\"] runs list, audit, vendor,\n");
    print("    build, test and targets in each member (--no-workspace: here only); install, update and lock\n");
    print("    resolve all members together: one copy of each pact in the root's ark_modules/, one ark.lock\n\n");
    print("CAPABILITIES: [capabilities] name = [\"net\", \"fs\"] grants a pact what it may use (net, fs,\n");
    print("    process, env, ffi, unsafe, io, crypto; \"*\" all); install, build, test and audit fail when a\n");
    print("    pact uses more; update prints what each pact uses that it did not before\n\n");
    print("MANIFEST: ark.toml\n");
    print("LOCKFILE: ark.lock\n");
    print("MODULES:  ark_modules/\n\n");
    print("EXAMPLES:\n");
    print("    ark init my-app\n");
    print("    ark add math --path ../stdlib/math\n");
    print("    ark add mylib --git https://github.com/user/mylib\n");
    print("    ark add mylib --git https://github.com/user/mylib --branch dev\n");
    print("    ark install\n");
    print("    ark list\n");
}

// --- Entry point ---

pub fn ark_main() -> i64 {
    var n: i64 = p_argc();
    var start: i64 = 1;
    // Support interpreter mode: fidesc run tools/ark.fd -- init my-app
    var i: i64 = 0;
    while i < n {
        if p_argv(i) == "--" {
            start = i + 1;
            break;
        }
        i = i + 1;
    }
    // When called from the main compiler CLI (fides-c ark init),
    // skip the "ark" argument itself.
    if start < n && p_argv(start) == "ark" {
        start = start + 1;
    }
    if start >= n {
        ark_print_help();
        return 1;
    }
    var command: str = p_argv(start);
    // L5F: the command that runs ark again (in a workspace member) -- the
    // words before the command, the program made absolute; L5A: the fid
    // that runs ark (`fid ark ...`, `fid run tools/ark.fd -- ...`) is the
    // compiler `ark build` uses
    g_ark_start = start;
    // Collect remaining args (`--no-workspace`: this directory only)
    var args: Vec<str> = Vec::new();
    var no_workspace: bool = false;
    var j: i64 = start + 1;
    while j < n {
        if p_argv(j) == "--no-workspace" {
            no_workspace = true;
        } else if (p_argv(j) == "--binary" || p_argv(j) == "--source") && (command == "install" || command == "i" || command == "update") {
            // L5E: every pact's prebuilt library, or none
            g_ark_binary_all = p_argv(j) == "--binary";
            g_ark_binary_off = p_argv(j) == "--source";
        } else {
            args.push(p_argv(j));
        }
        j = j + 1;
    }
    if command == "prebuild" {
        return ark_cmd_prebuild(args);
    }
    // L5F: in a workspace root, the command runs in each member
    if !no_workspace && ark_workspace_command(command) {
        var members: Vec<str> = ark_workspace_members();
        if members.len() > 0 {
            return ark_workspace_run(command, args, members);
        }
    }
    // L5F: in a member, the workspace's ark.lock and ark_modules/; install,
    // update and lock run for the whole workspace, at its root
    if !no_workspace && ark_workspace_command(command) {
        g_ark_ws_root = ark_ws_root_find();
        if str_len(g_ark_ws_root) > 0 && (command == "install" || command == "i" || command == "update" || command == "lock") {
            print("This is a member of the workspace at " + g_ark_ws_root + ": `ark " + command + "` runs there (one ark.lock, one copy of each pact).\n");
            var rest: str = "";
            var ra: i64 = 0;
            while ra < args.len() {
                rest = rest + " " + ark_word(args[ra]);
                ra = ra + 1;
            }
            if g_ark_binary_all {
                rest = rest + " --binary";
            }
            if g_ark_binary_off {
                rest = rest + " --source";
            }
            var cd: str = "cd " + ark_q(g_ark_ws_root);
            if ark_is_windows() {
                cd = "cd /d " + ark_q(str_replace(g_ark_ws_root, "/", "\\"));
            }
            return ark_run(cd + " && " + ark_self_cmd() + " " + command + rest);
        }
    }
    if command == "build" || command == "b" {
        return ark_cmd_build(args);
    }
    if command == "test" || command == "t" {
        return ark_cmd_test(args);
    }
    if command == "targets" {
        return ark_cmd_targets(args);
    }
    if command == "init" {
        return ark_cmd_init(args);
    }
    if command == "add" {
        return ark_cmd_add(args);
    }
    if command == "install" || command == "i" {
        return ark_cmd_install(args);
    }
    if command == "remove" || command == "rm" {
        return ark_cmd_remove(args);
    }
    if command == "list" || command == "ls" {
        return ark_cmd_list(args);
    }
    if command == "lock" {
        return ark_cmd_lock(args);
    }
    if command == "audit" {
        return ark_cmd_audit(args);
    }
    if command == "vendor" {
        return ark_cmd_vendor(args);
    }
    if command == "search" {
        return ark_cmd_search(args);
    }
    if command == "publish" {
        return ark_cmd_publish(args);
    }
    if command == "yank" {
        return ark_cmd_yank(args);
    }
    if command == "api" {
        return ark_cmd_api(args);
    }
    if command == "update" {
        return ark_cmd_update(args);
    }
    if command == "version" || command == "--version" || command == "-v" {
        return ark_cmd_version();
    }
    if command == "help" || command == "--help" || command == "-h" {
        ark_print_help();
        return 0;
    }
    p_eprint_str("Unknown command: ");
    p_eprint_str(command);
    p_eprint_str("\nRun 'ark help' for usage.\n");
    return 1;
}
