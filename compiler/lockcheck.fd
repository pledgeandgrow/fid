// CA4 (complaint-roadmap): Lock-order analysis across the call graph.
// A cycle in the lock graph — lock A held while lock B is acquired, and
// somewhere else lock B held while lock A is acquired — is a compile-time
// error, because it can deadlock at run time no matter what the locks
// guard.
//
// The analysis works on the IR's slot form (after lowering), where a
// mutex handle is a plain i64 local, parameter or global. A lock is named
// (BG31) so that the same name means the same lock in every function:
//   "g:<name>"     a global;
//   "<fn>$p<k>"    parameter k of fn: it stands for what each caller
//                  passes, and is replaced by the caller's lock at a call;
//   "<fn>#<slot>"  a local slot of fn (two different `sync_mutex_create()`
//                  results are two different slots: per-variable and
//                  conservative, the same slot reacquired is not a cycle).
// A handle of another form (a field, a call's result) is no named lock.
// (The analysis used the per-function value ids as the nodes of one graph:
// slot 5 of one function and slot 5 of another were one lock, so unrelated
// functions made false cycles, and a global had a different id in each
// function, so real cycles across functions were missed.)
//
// Per function that locks, directly or through a call:
//   1. Walk the CFG to a fixed point, tracking which locks are held
//      (between p_mutex_lock/sync_mutex_lock and the unlock of the same
//      lock).
//   2. At each lock(x) with lock set S held: an edge s -> x for every s in
//      S.
//   3. At each call to a function G with lock set S held: every lock G
//      takes (directly or through its calls, its parameters replaced by
//      the call's arguments) gives the edges s -> it; G's edges between
//      its parameters become edges between the caller's arguments. This is
//      propagated over the call graph to a fixed point (BG64: it inherited
//      edges from no call, and p_mutex_lock, one argument and no env, was
//      never seen). BG235: a call through a closure value bound once in
//      the function (`val c = fn() { .. }; c()`, a CallPtr) counts as a
//      call to the closure's function (lc_callptr_target). A lock the
//      closure reaches through a capture is no named lock here; the type
//      checker's lo_summary names it as the enclosing function's local.
//
// A cycle in the final edge set is the error. Functions with loops that
// lock the same variable in both directions are fine — the slot is the
// same node, so no self-edge is recorded.
//
// Gate: FID_LOCKCHECK=off disables; it runs in `fid check`, after the type
// checker's own lock-order check (typechecker.fd lo_summary, "Deadlock
// error"), which finds most cycles first. Tests:
// test_lockcheck_cycle_fail.fd (the error), test_lockcheck_ok.fd (nested
// locks, same order), test_lockcheck_names_ok.fd (BG31: locals of two
// functions are not one lock; BG64: p_mutex_lock).

module compiler::lockcheck;
use core; use vec; use string; use compiler::ir; use compiler::checks;

/// One edge in the lock graph: lock `from` was held when lock `to` was
/// acquired (both are numbers of lock names, LcNames).
pub struct LockEdge {
    pub from: i64,
    pub to: i64,
    pub fn_name: str,
    pub line: i64,
}

/// The result of the lock-order check on one module.
pub struct LockCheckResult {
    pub edges: Vec<LockEdge>,
    pub cycle: bool,
    pub cycle_desc: str,
}

/// BG31: the lock names of a module (see the top of this file); a name's
/// number is its index here, a node of the lock graph.
pub struct LcNames {
    pub names: Vec<str>,
    // the function a parameter name belongs to ("" for another name), and
    // the parameter's index in its params (the env counts)
    pub param_fn: Vec<str>,
    pub param_k: Vec<i64>,
}

/// A call from a function that locks to another one: the callee's index
/// in the module, the locks held at the call, the lock name of each
/// argument (-1: none).
pub struct LcCall {
    pub callee: i64,
    pub held: Vec<i64>,
    pub args: Vec<i64>,
    pub line: i64,
}

/// What one function does with locks: its edges and the locks it takes
/// (its own and, after the propagation, its callees'), in its names.
pub struct LcFn {
    pub name: str,
    pub nparams: i64,
    pub edges: Vec<LockEdge>,
    pub acq: Vec<i64>,
    pub calls: Vec<LcCall>,
}

/// Is `name` a lock-acquire call?
fn lc_is_lock(name: str) -> bool {
    // BG413: stdlib/sync.fd's SyncMutex locks through `self.handle`, a
    // field: `m.lock()` is the acquire of the lock m holds (its last
    // argument, the struct, names it: lc_name_of)
    return name == "p_mutex_lock" || name == "sync_mutex_lock" || name == "SyncMutex_lock";
}

/// Is `name` a lock-release call?
fn lc_is_unlock(name: str) -> bool {
    return name == "p_mutex_unlock" || name == "sync_mutex_unlock" || name == "SyncMutex_unlock";
}

/// The number of lock name `name`, made when new.
fn lc_intern(t: &mut LcNames, name: str, pfn: str, pk: i64) -> i64 {
    var i: i64 = 0;
    while i < t.names.len() {
        if t.names.get(i) == name {
            return i;
        }
        i = i + 1;
    }
    t.names.push(name);
    t.param_fn.push(pfn);
    t.param_k.push(pk);
    return t.names.len() - 1;
}

/// The index of `x` in `v`, -1 if absent.
fn lc_find(v: &Vec<i64>, x: i64) -> i64 {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/// Add `x` to the set `v`; whether it was new.
fn lc_add_id(v: &mut Vec<i64>, x: i64) -> bool {
    if lc_find(v, x) >= 0 {
        return false;
    }
    v.push(x);
    return true;
}

/// `v` without `x`.
fn lc_without(v: &Vec<i64>, x: i64) -> Vec<i64> {
    var keep: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) != x {
            keep.push(v.get(i));
        }
        i = i + 1;
    }
    return keep;
}

/// Add the edge from -> to to `edges` unless it is there; whether it was new.
fn lc_add_edge(edges: &mut Vec<LockEdge>, from: i64, to: i64, fn_name: str, line: i64) -> bool {
    var i: i64 = 0;
    while i < edges.len() {
        if edges.get(i).from == from && edges.get(i).to == to {
            return false;
        }
        i = i + 1;
    }
    edges.push(LockEdge { from: from, to: to, fn_name: fn_name, line: line });
    return true;
}

/// The index of parameter value `id` in f's params, -1 if it is none.
fn lc_param_of(f: &IrFunction, id: i64) -> i64 {
    var k: i64 = 0;
    while k < f.params.len() {
        if f.params.get(k).id == id {
            return k;
        }
        k = k + 1;
    }
    return 0 - 1;
}

/// The slots of `f` that hold a parameter, as pairs [slot, param index]: a
/// slot every store of which writes that parameter (a parameter copied to
/// a slot at entry and never assigned).
fn lc_param_slots(f: &IrFunction) -> Vec<i64> {
    var pairs: Vec<i64> = Vec::new();
    var bad: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Store(p, v, _) => {
                val k: i64 = lc_param_of(f, v);
                var at: i64 = 0 - 1;
                var j: i64 = 0;
                while j + 1 < pairs.len() && at < 0 {
                    if pairs.get(j) == p {
                        at = j;
                    }
                    j = j + 2;
                }
                if k < 0 || (at >= 0 && pairs.get(at + 1) != k) {
                    lc_add_id(&mut bad, p);
                } else if at < 0 {
                    pairs.push(p);
                    pairs.push(k);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    var out: Vec<i64> = Vec::new();
    var q: i64 = 0;
    while q + 1 < pairs.len() {
        if lc_find(&bad, pairs.get(q)) < 0 {
            out.push(pairs.get(q));
            out.push(pairs.get(q + 1));
        }
        q = q + 2;
    }
    return out;
}

/// The lock name of value `handle` in `f` (-1: no named lock): a
/// parameter, or a load of a parameter's slot, a local slot or a global.
fn lc_name_of(t: &mut LcNames, f: &IrFunction, pslots: &Vec<i64>, handle: i64) -> i64 {
    val k: i64 = lc_param_of(f, handle);
    if k >= 0 {
        return lc_intern(t, f.name + "$p" + int_to_str(k), f.name, k);
    }
    match peir_inst_of(f, handle) {
        Inst::Alloca(_, _) => {
            // BG413: a struct held in a local slot (`val m =
            // SyncMutex::new(); m.lock()` passes the slot): the struct names
            // the lock it holds
            return lc_intern(t, f.name + "#" + int_to_str(handle), "", 0 - 1);
        }
        Inst::Load(p, _) => {
            match peir_inst_of(f, p) {
                Inst::GetFieldPtr(fb, _, _) => {
                    // BG413: a handle read from a field (`self.handle`) is
                    // the lock of the struct holding it (conservative: two
                    // mutex fields of one struct are one lock, which can
                    // only hide a cycle, never make one)
                    return lc_name_of(t, f, pslots, fb);
                }
                Inst::GlobalAddr(gn, _) => {
                    return lc_intern(t, "g:" + gn, "", 0 - 1);
                }
                Inst::Alloca(_, _) => {
                    var j: i64 = 0;
                    while j + 1 < pslots.len() {
                        if pslots.get(j) == p {
                            val pk: i64 = pslots.get(j + 1);
                            return lc_intern(t, f.name + "$p" + int_to_str(pk), f.name, pk);
                        }
                        j = j + 2;
                    }
                    return lc_intern(t, f.name + "#" + int_to_str(p), "", 0 - 1);
                }
                _ => {
                    return 0 - 1;
                }
            }
        }
        _ => {
            return 0 - 1;
        }
    }
    return 0 - 1;
}

/// Lock name `n` of callee `gname` (`gnp` params) at a call with argument
/// names `args`: a parameter of the callee is what the call passes (-1:
/// no named lock), any other name stays.
fn lc_subst(t: &LcNames, n: i64, gname: str, gnp: i64, args: &Vec<i64>) -> i64 {
    if n < 0 {
        return 0 - 1;
    }
    if t.param_fn.get(n) != gname {
        return n;
    }
    // the arguments line up with the parameters from the end
    val ai: i64 = args.len() - gnp + t.param_k.get(n);
    if ai < 0 || ai >= args.len() {
        return 0 - 1;
    }
    return args.get(ai);
}

/// The module-function index of `name` (fidx: name -> index + 1), -1 if
/// it has none.
fn lc_fn_index(fidx: i64, name: str) -> i64 {
    if HashMap_contains(fidx, name) {
        return HashMap_get(fidx, name) - 1;
    }
    return 0 - 1;
}

/// The source line of an instruction (for the error message).
fn lc_line(f: &IrFunction, id: i64) -> i64 {
    match IrFunction_get_meta(f, id) {
        OptValueMeta::Some(m) => {
            match m.source_line {
                OptU64::Some(l) => {
                    return l;
                }
                OptU64::None => {
                }
            }
        }
        OptValueMeta::None => {
        }
    }
    return 0 - 1;
}

/// BG235: the one value stored to slot `p` in `f` (-1: none, or more
/// than one).
fn lc_only_store(f: &IrFunction, p: i64) -> i64 {
    var found: i64 = 0 - 1;
    var i: i64 = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Store(sp, sv, _) => {
                if sp == p {
                    if found >= 0 && found != sv {
                        return 0 - 1;
                    }
                    found = sv;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return found;
}

/// BG235: the function a closure object `obj` of `f` calls: the one
/// ConstFnRef stored to its first word ("" when there is not exactly one).
fn lc_fnref_at(f: &IrFunction, obj: i64) -> str {
    var name: str = "";
    var i: i64 = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Store(sp, sv, _) => {
                var first: bool = sp == obj;
                match peir_inst_of(f, sp) {
                    Inst::GetElemPtr(gb, gi, _) => {
                        if gb == obj {
                            match peir_inst_of(f, gi) {
                                Inst::ConstInt(gk, _) => {
                                    first = gk == 0;
                                }
                                _ => {
                                }
                            }
                        }
                    }
                    Inst::GetFieldPtr(fb, fk, _) => {
                        if fb == obj && fk == 0 {
                            first = true;
                        }
                    }
                    _ => {
                    }
                }
                if first {
                    match peir_inst_of(f, sv) {
                        Inst::ConstFnRef(fname) => {
                            if str_len(name) > 0 && name != fname {
                                return "";
                            }
                            name = fname;
                        }
                        _ => {
                        }
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return name;
}

/// BG235: the function a call through a function value `v` of `f` (a
/// CallPtr) reaches, when the value is a closure or function reference
/// bound once in `f` (`val c = fn() { .. }; c()`): its name, else "".
/// (A call through a closure value added no edges: the locks taken in a
/// closure body were not checked against the locks held at its call.)
fn lc_callptr_target(f: &IrFunction, v0: i64) -> str {
    var v: i64 = v0;
    var hops: i64 = 0;
    while hops < 6 {
        hops = hops + 1;
        match peir_inst_of(f, v) {
            Inst::ConstFnRef(fname) => {
                return fname;
            }
            Inst::BitCast(bv, _, _) => {
                v = bv;
            }
            Inst::Load(p, _) => {
                match peir_inst_of(f, p) {
                    Inst::Alloca(_, _) => {
                        val sv: i64 = lc_only_store(f, p);
                        if sv < 0 {
                            return "";
                        }
                        v = sv;
                    }
                    _ => {
                        return "";
                    }
                }
            }
            Inst::Alloca(_, _) => {
                return lc_fnref_at(f, v);
            }
            Inst::GlobalAddr(_, _) => {
                return lc_fnref_at(f, v);
            }
            _ => {
                return "";
            }
        }
    }
    return "";
}

/// A call from `f` to function `name` with locks `cur` held: noted in
/// `out` when the callee locks (directly or through its calls).
fn lc_note_call(t: &mut LcNames, f: &IrFunction, pslots: &Vec<i64>, name: str, cargs: &Vec<i64>, cur: &Vec<i64>, fidx: i64, relevant: &Vec<bool>, out: &mut LcFn, id: i64) {
    val gi: i64 = lc_fn_index(fidx, name);
    if gi < 0 || !relevant.get(gi) {
        return;
    }
    var anames: Vec<i64> = Vec::new();
    var ai: i64 = 0;
    while ai < cargs.len() {
        anames.push(lc_name_of(t, f, pslots, cargs.get(ai)));
        ai = ai + 1;
    }
    var held_now: Vec<i64> = Vec::new();
    var hi: i64 = 0;
    while hi < cur.len() {
        held_now.push(cur.get(hi));
        hi = hi + 1;
    }
    out.calls.push(LcCall { callee: gi, held: held_now, args: anames, line: lc_line(f, id) });
}

/// One block of `f` from the held set `entry`: the held set at its end.
/// With `record`, its edges, locks and calls to functions that lock go
/// to `out`.
fn lc_walk_block(t: &mut LcNames, f: &IrFunction, pslots: &Vec<i64>, b: i64, entry: Vec<i64>, fidx: i64, relevant: &Vec<bool>, out: &mut LcFn, record: bool) -> Vec<i64> {
    var cur: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < entry.len() {
        cur.push(entry.get(i));
        i = i + 1;
    }
    var ids: Vec<i64> = f.blocks.get(b).instructions;
    var k: i64 = 0;
    while k < ids.len() {
        val id: i64 = ids.get(k);
        match peir_inst_of(f, id) {
            Inst::Call(name, cargs, _, _) => {
                if lc_is_lock(name) || lc_is_unlock(name) {
                    // the handle is the last argument (a Fides function's
                    // env comes first; p_mutex_lock has none)
                    var lk: i64 = 0 - 1;
                    if cargs.len() > 0 {
                        lk = lc_name_of(t, f, pslots, cargs.get(cargs.len() - 1));
                    }
                    if lk >= 0 {
                        if lc_is_lock(name) {
                            if record {
                                var h: i64 = 0;
                                while h < cur.len() {
                                    if cur.get(h) != lk {
                                        lc_add_edge(&mut out.edges, cur.get(h), lk, f.name, lc_line(f, id));
                                    }
                                    h = h + 1;
                                }
                                lc_add_id(&mut out.acq, lk);
                            }
                            lc_add_id(&mut cur, lk);
                        } else {
                            cur = lc_without(&cur, lk);
                        }
                    }
                } else if record && !str_starts_with(name, "p_") && !str_starts_with(name, "__") {
                    lc_note_call(t, f, pslots, name, &cargs, &cur, fidx, relevant, out, id);
                }
            }
            Inst::CallPtr(cp, pargs, _, _, _) => {
                // BG235: a call through a closure value bound in `f`
                if record {
                    val tn: str = lc_callptr_target(f, cp);
                    if str_len(tn) > 0 {
                        lc_note_call(t, f, pslots, tn, &pargs, &cur, fidx, relevant, out, id);
                    }
                }
            }
            _ => {
            }
        }
        k = k + 1;
    }
    return cur;
}

/// Add the held set `cur` at the end of block `b` to the entry sets of
/// its successors; whether one grew.
fn lc_flow_out(f: &IrFunction, b: i64, cur: &Vec<i64>, held: &mut Vec<Vec<i64>>) -> bool {
    var ids: Vec<i64> = f.blocks.get(b).instructions;
    if ids.len() == 0 || cur.len() == 0 {
        return false;
    }
    var targets: Vec<i64> = Vec::new();
    match peir_inst_of(f, ids.get(ids.len() - 1)) {
        Inst::Jump(jt) => {
            targets.push(jt);
        }
        Inst::Branch(_, tb, eb) => {
            targets.push(tb);
            targets.push(eb);
        }
        Inst::Switch(_, _, sts, sdef) => {
            var si: i64 = 0;
            while si < sts.len() {
                targets.push(sts.get(si));
                si = si + 1;
            }
            targets.push(sdef);
        }
        _ => {
        }
    }
    var grew: bool = false;
    var x: i64 = 0;
    while x < targets.len() {
        var ti: i64 = 0;
        while ti < f.blocks.len() {
            if f.blocks.get(ti).id == targets.get(x) {
                var hv: Vec<i64> = held.get(ti);
                var add: bool = false;
                var c: i64 = 0;
                while c < cur.len() {
                    if lc_add_id(&mut hv, cur.get(c)) {
                        add = true;
                    }
                    c = c + 1;
                }
                if add {
                    held.set(ti, hv);
                    grew = true;
                }
            }
            ti = ti + 1;
        }
        x = x + 1;
    }
    return grew;
}

/// What function `f` does with locks: a walk of its blocks to a fixed
/// point of the held sets at their entries (the union of the
/// predecessors' exit sets: conservative), then one more that records.
pub fn lockcheck_function(t: &mut LcNames, f: &IrFunction, fidx: i64, relevant: &Vec<bool>) -> LcFn {
    var out: LcFn = LcFn { name: f.name, nparams: f.params.len(), edges: Vec::new(), acq: Vec::new(), calls: Vec::new() };
    val nb: i64 = f.blocks.len();
    if nb == 0 {
        return out;
    }
    var pslots: Vec<i64> = lc_param_slots(f);
    var held: Vec<Vec<i64>> = Vec::new();
    var b: i64 = 0;
    while b < nb {
        held.push(Vec::new());
        b = b + 1;
    }
    var changed: bool = true;
    var round: i64 = 0;
    while changed && round < nb + 2 {
        changed = false;
        round = round + 1;
        b = 0;
        while b < nb {
            var cur: Vec<i64> = lc_walk_block(t, f, &pslots, b, held.get(b), fidx, relevant, &mut out, false);
            if lc_flow_out(f, b, &cur, &mut held) {
                changed = true;
            }
            b = b + 1;
        }
    }
    b = 0;
    while b < nb {
        lc_walk_block(t, f, &pslots, b, held.get(b), fidx, relevant, &mut out, true);
        b = b + 1;
    }
    return out;
}

/// Does the edge set have a cycle? (DFS from each node; an edge back to
/// a node on the current stack is a cycle.) Returns "" or the cycle
/// description.
pub fn lockcheck_cycle(edges: &Vec<LockEdge>) -> str {
    // build adjacency: from -> list of (to, fn, line)
    var nodes: Vec<i64> = Vec::new();
    var adj: Vec<Vec<i64>> = Vec::new();
    var adj_edge: Vec<Vec<i64>> = Vec::new();
    var i: i64 = 0;
    while i < edges.len() {
        var from: i64 = edges.get(i).from;
        var to: i64 = edges.get(i).to;
        var fi: i64 = 0 - 1;
        var j: i64 = 0;
        while j < nodes.len() && fi < 0 {
            if nodes.get(j) == from {
                fi = j;
            }
            j = j + 1;
        }
        if fi < 0 {
            nodes.push(from);
            var empty: Vec<i64> = Vec::new();
            adj.push(Vec::new());
            adj_edge.push(Vec::new());
            fi = nodes.len() - 1;
        }
        adj.get(fi).push(to);
        adj_edge.get(fi).push(i);
        i = i + 1;
    }
    // DFS with a colour map: 0 = white, 1 = grey (on stack), 2 = black
    var colour: Vec<i64> = Vec::new();
    i = 0;
    while i < nodes.len() {
        colour.push(0);
        i = i + 1;
    }
    var stack: Vec<i64> = Vec::new();
    var start: i64 = 0;
    while start < nodes.len() {
        if colour.get(start) == 0 {
            var desc: str = lc_dfs(start, &nodes, &adj, &adj_edge, edges, &mut colour, &mut stack);
            if str_len(desc) > 0 {
                return desc;
            }
        }
        start = start + 1;
    }
    return "";
}

/// One DFS step; returns "" or the cycle's description.
fn lc_dfs(at: i64, nodes: &Vec<i64>, adj: &Vec<Vec<i64>>, adj_edge: &Vec<Vec<i64>>, edges: &Vec<LockEdge>, colour: &mut Vec<i64>, stack: &mut Vec<i64>) -> str {
    colour.set(at, 1);
    stack.push(at);
    var i: i64 = 0;
    while i < adj.get(at).len() {
        var to: i64 = adj.get(at).get(i);
        // find `to` in nodes
        var ti: i64 = 0 - 1;
        var j: i64 = 0;
        while j < nodes.len() && ti < 0 {
            if nodes.get(j) == to {
                ti = j;
            }
            j = j + 1;
        }
        if ti >= 0 {
            if colour.get(ti) == 1 {
                // cycle: describe the path from ti to at, then back to ti
                var desc: str = "lock-order cycle: ";
                var si: i64 = 0;
                while si < stack.len() {
                    var n: i64 = stack.get(si);
                    if n == ti {
                        si = stack.len();
                    } else {
                        si = si + 1;
                    }
                }
                // walk from ti's position in the stack
                var k: i64 = 0;
                while k < stack.len() {
                    if stack.get(k) == ti {
                        break;
                    }
                    k = k + 1;
                }
                while k < stack.len() {
                    var e: LockEdge = edges.get(adj_edge.get(stack.get(k)).get(0));
                    if str_len(desc) > 20 {
                        desc = desc + " -> ";
                    }
                    desc = desc + e.fn_name + ":" + int_to_str(e.line);
                    k = k + 1;
                }
                desc = desc + " (and back)";
                return desc;
            }
            if colour.get(ti) == 0 {
                var r: str = lc_dfs(ti, nodes, adj, adj_edge, edges, colour, stack);
                if str_len(r) > 0 {
                    return r;
                }
            }
        }
        i = i + 1;
    }
    colour.set(at, 2);
    stack.pop();
    return "";
}

/// The module-level check: find the functions that lock (directly or
/// through a call), collect each one's edges, locks and calls, propagate
/// across the call graph (a call with locks held adds edges from them to
/// every lock the callee takes; the callee's edges between its parameters
/// become edges between the call's arguments), then look for a cycle.
pub fn lockcheck_module(module: &IrModule) -> LockCheckResult {
    val nfn: i64 = module.functions.len();
    // 1. each function's callees; the functions that lock directly
    var fidx: i64 = HashMap_new();
    var callees: Vec<Vec<str>> = Vec::new();
    var relevant: Vec<bool> = Vec::new();
    var i: i64 = 0;
    while i < nfn {
        HashMap_insert(fidx, module.functions.get(i).name, i + 1);
        var ent: IrFunctionEntry = module.functions.get(i);
        var cl: Vec<str> = Vec::new();
        var locks: bool = false;
        var si: i64 = 0;
        while si < ent.func.insts.len() {
            match ent.func.insts.get(si).inst {
                Inst::Call(cn, _, _, _) => {
                    if lc_is_lock(cn) {
                        locks = true;
                    } else if !lc_is_unlock(cn) && !str_starts_with(cn, "p_") && !str_starts_with(cn, "__") {
                        var seen: bool = false;
                        var q: i64 = 0;
                        while q < cl.len() && !seen {
                            if cl.get(q) == cn {
                                seen = true;
                            }
                            q = q + 1;
                        }
                        if !seen {
                            cl.push(cn);
                        }
                    }
                }
                Inst::CallPtr(cpv, _, _, _, _) => {
                    // BG235: the closure a call through a value reaches
                    val ctn: str = lc_callptr_target(&ent.func, cpv);
                    if str_len(ctn) > 0 {
                        cl.push(ctn);
                    }
                }
                _ => {
                }
            }
            si = si + 1;
        }
        callees.push(cl);
        relevant.push(locks);
        i = i + 1;
    }
    // 2. the functions that lock through a call
    var grow: bool = true;
    var rounds: i64 = 0;
    while grow && rounds < 64 {
        grow = false;
        rounds = rounds + 1;
        i = 0;
        while i < nfn {
            if !relevant.get(i) {
                var mine: Vec<str> = callees.get(i);
                var c: i64 = 0;
                while c < mine.len() && !relevant.get(i) {
                    val gi: i64 = lc_fn_index(fidx, mine.get(c));
                    if gi >= 0 && relevant.get(gi) {
                        relevant.set(i, true);
                        grow = true;
                    }
                    c = c + 1;
                }
            }
            i = i + 1;
        }
    }
    // 3. what each of them does with locks, in its own names
    var t: LcNames = LcNames { names: Vec::new(), param_fn: Vec::new(), param_k: Vec::new() };
    var fns: Vec<LcFn> = Vec::new();
    var rmap: Vec<i64> = Vec::new();
    i = 0;
    while i < nfn {
        if relevant.get(i) {
            rmap.push(fns.len());
            var ent2: IrFunctionEntry = module.functions.get(i);
            fns.push(lockcheck_function(&mut t, &ent2.func, fidx, &relevant));
        } else {
            rmap.push(0 - 1);
        }
        i = i + 1;
    }
    // 4. the calls, to a fixed point
    var more: bool = true;
    var pass: i64 = 0;
    while more && pass < 32 {
        more = false;
        pass = pass + 1;
        var fi: i64 = 0;
        while fi < fns.len() {
            var me: LcFn = fns.get(fi);
            var grew: bool = false;
            var c2: i64 = 0;
            while c2 < me.calls.len() {
                val call: LcCall = me.calls.get(c2);
                val gpos: i64 = rmap.get(call.callee);
                if gpos >= 0 {
                    val g: LcFn = fns.get(gpos);
                    val via: str = g.name + " (from " + me.name + ")";
                    // every lock the callee takes, under the locks held here
                    var a: i64 = 0;
                    while a < g.acq.len() {
                        val sa: i64 = lc_subst(&t, g.acq.get(a), g.name, g.nparams, &call.args);
                        if sa >= 0 {
                            if lc_add_id(&mut me.acq, sa) {
                                grew = true;
                            }
                            var h: i64 = 0;
                            while h < call.held.len() {
                                if call.held.get(h) != sa {
                                    if lc_add_edge(&mut me.edges, call.held.get(h), sa, via, call.line) {
                                        grew = true;
                                    }
                                }
                                h = h + 1;
                            }
                        }
                        a = a + 1;
                    }
                    // the callee's edges between its parameters, between
                    // this call's arguments (its other edges are in the
                    // graph as they are)
                    var e: i64 = 0;
                    while e < g.edges.len() {
                        val gf: i64 = g.edges.get(e).from;
                        val gt: i64 = g.edges.get(e).to;
                        if t.param_fn.get(gf) == g.name || t.param_fn.get(gt) == g.name {
                            val sf: i64 = lc_subst(&t, gf, g.name, g.nparams, &call.args);
                            val st: i64 = lc_subst(&t, gt, g.name, g.nparams, &call.args);
                            if sf >= 0 && st >= 0 && sf != st {
                                if lc_add_edge(&mut me.edges, sf, st, via, call.line) {
                                    grew = true;
                                }
                            }
                        }
                        e = e + 1;
                    }
                }
                c2 = c2 + 1;
            }
            if grew {
                fns.set(fi, me);
                more = true;
            }
            fi = fi + 1;
        }
    }
    // 5. one graph of every function's edges
    var all_edges: Vec<LockEdge> = Vec::new();
    var fj: i64 = 0;
    while fj < fns.len() {
        var fe: Vec<LockEdge> = fns.get(fj).edges;
        var j: i64 = 0;
        while j < fe.len() {
            all_edges.push(fe.get(j));
            j = j + 1;
        }
        fj = fj + 1;
    }
    var cycle_desc: str = lockcheck_cycle(&all_edges);
    return LockCheckResult { edges: all_edges, cycle: str_len(cycle_desc) > 0, cycle_desc: cycle_desc };
}
