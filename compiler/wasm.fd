// wasm.fd -- IR -> a WebAssembly module that runs under WASI (release F9):
// `fid wasm <file.fd> -o x.wasm`, run with `node scripts/wasm-run.mjs x.wasm`
// (or any WASI preview-1 host: wasmtime, wasmer).
//
// The lowering of the machine layer (compiler/nat_ir.fd), on WASM's stack
// machine: every IR value is an i64 local (a float travels as its bits, an
// f32 as its 32 bits zero-extended; narrow integers are normalized by
// extension, as in registers). Memory is wasm32: an address is the value's
// low 32 bits (i32.wrap_i64 at every load and store). Integer semantics
// are nat_ir's and the interpreter's (release F6): i64/u64 arithmetic
// panics on overflow unless the function is @wrapping, a narrow result
// that does not fit panics, division and remainder by zero panic, MIN / -1
// panics.
//
// Every function takes and returns i64s: its IR parameters (`__env` first,
// an sret pointer before it) and one result (0 for void). A builtin p_X
// runs the runtime's Fides pert_X (stdlib/linux_runtime, merged by the
// front end) with a null `__env`, as on the native targets; the runtime's
// system calls (nat_syscall) go to pe_wasi_syscall (stdlib/linux_runtime/
// wasi.fd), whose `wasi_<name>` externs are the imports of
// wasi_snapshot_preview1 here. The other nat_* primitives are written here
// in WASM.
//
// Control flow (TG16): WASM's block / loop / if made from the CFG over its
// dominator tree ("Structured control flow"). The functions that may give
// control away (see "Tasks") and an irreducible CFG keep the "switch
// loop": one loop around one block per IR block; a jump sets the block
// index and branches to the loop, whose br_table enters the block; a jump
// to the next block falls through.
//
// Linear memory: [0, 1024) unused, [1024, WG_STACK_TOP) the stack of
// allocas (global 0 is its pointer; it grows down, a frame below 1024 is
// "Stack overflow"), then the data (strings, globals, tables) from
// WG_DATA_BASE, then the heap (mmap grows the memory). A function pointer
// is an index in the table (closures, nat_call_fn), 0 is null.
//
// Functions are compiled from `_start` on, as they are called (a
// worklist): unused code is never emitted.
//
// Tasks (PL4): WASM cannot switch stacks, so a task switch unwinds the
// WASM stack and rewinds the other context's, as Binaryen's asyncify
// does. The functions that may reach nat_ctx_swap (wg_as_analyze: the
// call graph, closures and dyn calls included) save their locals and
// their resume point (a "segment" of the switch loop that starts with the
// call) when a call returns with the state "unwinding", and restore them
// on entry when it is "rewinding". A context is a record: the running
// program's in the data (main_rec), a task's the record pe_co_new_block
// puts at the top of its stack; [0] where its saved frames start, [8]
// where they end, [16] its stack pointer (global 0). nat_ctx_swap(save,
// sp) stores the running context's record at save and unwinds; _start's
// loop (wg_gen_start) then enters the context `sp` names: a new task by
// calling its body [sp + 112](env 0, [sp + 120]) on its own stack, a
// suspended one by calling its bottom function again while rewinding.
// Threads still run to their end when they start (nat_clone_thread),
// within the context that starts them.

module compiler::wasm;
use core;
use vec;
use string;
use compiler::ir;
use compiler::ast;
use compiler::checks;
// WASM value types
const WT_I32: i64 = 0x7F;
const WT_I64: i64 = 0x7E;
const WT_VOID: i64 = 0x40;
// Section ids
const SEC_TYPE: i64 = 1;
const SEC_IMPORT: i64 = 2;
const SEC_FUNCTION: i64 = 3;
const SEC_TABLE: i64 = 4;
const SEC_MEMORY: i64 = 5;
const SEC_GLOBAL: i64 = 6;
const SEC_EXPORT: i64 = 7;
const SEC_ELEM: i64 = 9;
const SEC_CODE: i64 = 10;
const SEC_DATA: i64 = 11;
// Memory layout
const WG_STACK_LO: i64 = 1024;
const WG_STACK_TOP: i64 = 8389632;  // 1024 + 8 MB
const WG_DATA_BASE: i64 = 8389632;  // What nat_ctx_tramp returns: marks a task's first context record
const WG_TRAMP: i64 = 0x7A5E7A5E;
// The globals of stack switching (see "Tasks"): the state (0 running, 1
// unwinding, 2 rewinding), the end of the saved frames, the running
// context's record, the context to switch to
const WG_G_ST: i64 = 4;
const WG_G_PTR: i64 = 5;
const WG_G_CUR: i64 = 6;
const WG_G_NEXT: i64 = 7;
// The arithmetic panics (nat_ir's NP_*)
const WP_ADD: i64 = 0;
const WP_SUB: i64 = 1;
const WP_MUL: i64 = 2;
const WP_DIV_OVF: i64 = 3;
const WP_DIV_ZERO: i64 = 4;
const WP_MOD_ZERO: i64 = 5;
// Integer compare kinds
const WCC_EQ: i64 = 0;
const WCC_NE: i64 = 1;
const WCC_LT: i64 = 2;
const WCC_LE: i64 = 3;
const WCC_GT: i64 = 4;
const WCC_GE: i64 = 5;
const WCC_LTU: i64 = 6;
const WCC_LEU: i64 = 7;
const WCC_GTU: i64 = 8;
const WCC_GEU: i64 = 9;
fn wg_panic_messages() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("Integer overflow on addition");
    v.push("Integer overflow on subtraction");
    v.push("Integer overflow on multiplication");
    v.push("Integer overflow on division");
    v.push("Division by zero");
    v.push("Modulo by zero");
    return v;
}

// ─── The generator ─────────────────────────────────────────────────────

pub struct WasmGen {
    // Every function of the module: name -> its parameter count + 1
    pub all_fns: i64,
    // Function name -> its index in the module (imports first)
    pub fn_index: i64,
    // Functions queued for compilation, in index order (after _start)
    pub queue: Vec<str>,
    // The type of each defined function (index - n_imports), in order
    pub def_types: Vec<i64>,
    pub n_imports: i64,
    // Imports: WASI name, the extern's C name, its signature key
    pub imp_names: Vec<str>,
    pub imp_sigs: Vec<str>,
    // C name of an extern -> import index + 1
    pub imp_index: i64,
    // Types: signature keys ("III>I": params, '>' then results; I = i64,
    // i = i32), key -> index + 1
    pub type_keys: Vec<str>,
    pub type_index: i64,
    // The table: function indices; name -> table index (from 1)
    pub table: Vec<i64>,
    pub table_index: i64,
    // Data from WG_DATA_BASE: bytes; string -> address; global -> address
    pub data: Vec<i64>,
    pub str_addr: i64,
    pub glob_addr: i64,
    pub globs: Vec<str>,
    // Functions named by a string constant (thread and task entries)
    pub named_fns: Vec<str>,
    pub named_seen: i64,
    // dyn: sorted type names; the id of a type is its position + 1
    pub dyn_types: Vec<str>,
    // extern "C" functions: Fides name -> 1 + index in c_list (C names)
    pub c_names: i64,
    pub c_list: Vec<str>,
    // Called but defined nowhere
    pub unresolved: Vec<str>,
    pub unresolved_seen: i64,
    // The body being written
    pub b: Vec<i64>,
    // The function being compiled
    pub cur_name: str,
    pub cur_wrapping: bool,
    pub unchecked: Vec<i64>,
    pub local_of: Vec<i64>,
    pub alloca_off: Vec<i64>,
    pub frame: i64,
    pub va_off: i64,
    pub t0: i64,
    pub t1: i64,
    pub t2: i64,
    pub t3: i64,
    pub fp: i64,
    pub cur: i64,
    pub block_index: i64,
    pub nblocks: i64,
    pub k: i64,
    pub extra: i64,
    pub cur_inst_line: i64,
    // Stack switching (PL4, see "Tasks"): the functions that may give
    // control away (name -> 1), whether a closure call may, whether the
    // function being compiled saves and restores its frame, whether the
    // instruction being compiled is a call that may; the main context's
    // record
    pub as_set: i64,
    pub as_ind: bool,
    pub as_fn: bool,
    pub as_here: bool,
    pub main_rec: i64,
    // Control flow (TG16): every function gets the switch loop
    // (FID_WASM_SWITCH=1); functions written structured, with the switch
    // loop for tasks, for an irreducible CFG, because of FID_WASM_SWITCH
    pub cf_switch_only: bool,
    pub cf_struct: i64,
    pub cf_task: i64,
    pub cf_irred: i64,
    pub cf_forced: i64,
}

fn WasmGen_new() -> WasmGen {
    return WasmGen {
        all_fns: HashMap_new(), fn_index: HashMap_new(), queue: Vec::new(), def_types: Vec::new(), n_imports: 0, imp_names: Vec::new(), imp_sigs: Vec::new(), imp_index: HashMap_new(), type_keys: Vec::new(), type_index: HashMap_new(), table: Vec::new(), table_index: HashMap_new(), data: Vec::new(), str_addr: HashMap_new(), glob_addr: HashMap_new(), globs: Vec::new(), named_fns: Vec::new(), named_seen: HashMap_new(), dyn_types: Vec::new(), c_names: HashMap_new(), c_list: Vec::new(), unresolved: Vec::new(), unresolved_seen: HashMap_new(), b: Vec::new(), cur_name: "", cur_wrapping: false, unchecked: Vec::new(), local_of: Vec::new(), alloca_off: Vec::new(), frame: 0, va_off: 0 - 1, t0: 0, t1: 0, t2: 0, t3: 0, fp: 0, cur: 0, block_index: HashMap_new(), nblocks: 0, k: 0, extra: 0, cur_inst_line: 0, as_set: HashMap_new(), as_ind: false, as_fn: false, as_here: false, main_rec: 0, cf_switch_only: false, cf_struct: 0, cf_task: 0, cf_irred: 0, cf_forced: 0,
    };
}

// ─── Bytes ─────────────────────────────────────────────────────────────

fn wb_uleb(out: &mut Vec<i64>, v: i64) {
    var x: i64 = v;
    while true {
        var byte: i64 = x & 0x7F;
        x = (x >> 7) & 0x1FFFFFFFFFFFFFF;
        if x != 0 {
            out.push(byte | 0x80);
        } else {
            out.push(byte);
            return;
        }
    }
}

fn wb_sleb(out: &mut Vec<i64>, v: i64) {
    var x: i64 = v;
    while true {
        var byte: i64 = x & 0x7F;
        x = x >> 7;
        var done: bool = (x == 0 && (byte & 0x40) == 0) || (x == 0 - 1 && (byte & 0x40) != 0);
        if done {
            out.push(byte);
            return;
        }
        out.push(byte | 0x80);
    }
}

fn wb_name(out: &mut Vec<i64>, s: str) {
    var n: i64 = str_len(s);
    wb_uleb(out, n);
    var i: i64 = 0;
    while i < n {
        out.push(str_byte_at(s, i) & 0xFF);
        i = i + 1;
    }
}

fn wb_append(out: &mut Vec<i64>, bs: &Vec<i64>) {
    var i: i64 = 0;
    var n: i64 = bs.len();
    while i < n {
        out.push(bs.get(i));
        i = i + 1;
    }
}

/// A section: id, size, contents.
fn wb_section(out: &mut Vec<i64>, id: i64, contents: &Vec<i64>) {
    out.push(id);
    wb_uleb(out, contents.len());
    wb_append(out, contents);
}

// ─── Instructions into the current body ────────────────────────────────

fn w(g: &mut WasmGen, byte: i64) {
    g.b.push(byte & 0xFF);
}

fn wu(g: &mut WasmGen, v: i64) {
    wb_uleb(&mut g.b, v);
}

fn wi64(g: &mut WasmGen, v: i64) {
    w(g, 0x42);
    wb_sleb(&mut g.b, v);
}

fn wi32(g: &mut WasmGen, v: i64) {
    w(g, 0x41);
    wb_sleb(&mut g.b, v);
}

fn wlget(g: &mut WasmGen, l: i64) {
    w(g, 0x20);
    wu(g, l);
}

fn wlset(g: &mut WasmGen, l: i64) {
    w(g, 0x21);
    wu(g, l);
}

fn wltee(g: &mut WasmGen, l: i64) {
    w(g, 0x22);
    wu(g, l);
}

fn wgget(g: &mut WasmGen, x: i64) {
    w(g, 0x23);
    wu(g, x);
}

fn wgset(g: &mut WasmGen, x: i64) {
    w(g, 0x24);
    wu(g, x);
}

fn wend(g: &mut WasmGen) {
    w(g, 0x0B);
}

fn wbr(g: &mut WasmGen, depth: i64) {
    w(g, 0x0C);
    wu(g, depth);
}

fn wif(g: &mut WasmGen) {
    w(g, 0x04);
    w(g, WT_VOID);
    g.extra = g.extra + 1;
}

fn wif_t(g: &mut WasmGen, t: i64) {
    w(g, 0x04);
    w(g, t);
    g.extra = g.extra + 1;
}

fn welse(g: &mut WasmGen) {
    w(g, 0x05);
}

fn wendif(g: &mut WasmGen) {
    w(g, 0x0B);
    g.extra = g.extra - 1;
}

fn wcall(g: &mut WasmGen, fidx: i64) {
    w(g, 0x10);
    wu(g, fidx);
}

fn wwrap(g: &mut WasmGen) {
    w(g, 0xA7);
}

fn wextu(g: &mut WasmGen) {
    w(g, 0xAD);
}

fn wexts(g: &mut WasmGen) {
    w(g, 0xAC);
}

/// i64 load of `size` bytes at [top-of-stack address + off] (an i64 address)
fn wload(g: &mut WasmGen, size: i64, signed: bool, off: i64) {
    wwrap(g);
    if size == 1 {
        if signed {
            w(g, 0x30);
        } else {
            w(g, 0x31);
        }
        wu(g, 0);
    } else if size == 2 {
        if signed {
            w(g, 0x32);
        } else {
            w(g, 0x33);
        }
        wu(g, 1);
    } else if size == 4 {
        if signed {
            w(g, 0x34);
        } else {
            w(g, 0x35);
        }
        wu(g, 2);
    } else {
        w(g, 0x29);
        wu(g, 3);
    }
    wu(g, off);
}

/// i64 store of `size` bytes; the stack is [i32 address, i64 value]
fn wstore(g: &mut WasmGen, size: i64, off: i64) {
    if size == 1 {
        w(g, 0x3C);
        wu(g, 0);
    } else if size == 2 {
        w(g, 0x3D);
        wu(g, 1);
    } else if size == 4 {
        w(g, 0x3E);
        wu(g, 2);
    } else {
        w(g, 0x37);
        wu(g, 3);
    }
    wu(g, off);
}

/// The local of value `id` (-1: none)
fn wg_local(g: &WasmGen, id: i64) -> i64 {
    if id < 0 || id >= g.local_of.len() {
        return 0 - 1;
    }
    return g.local_of.get(id);
}

/// Push value `id` (0 for a value without a local)
fn wget(g: &mut WasmGen, id: i64) {
    var l: i64 = wg_local(g, id);
    if l < 0 {
        wi64(g, 0);
    } else {
        wlget(g, l);
    }
}

/// Pop into value `id`
fn wset(g: &mut WasmGen, id: i64) {
    var l: i64 = wg_local(g, id);
    if l < 0 {
        w(g, 0x1A);
    } else {
        wlset(g, l);
    }
}

/// Push value `id` as an i32 address
fn wget_addr(g: &mut WasmGen, id: i64) {
    wget(g, id);
    wwrap(g);
}

/// i64 comparison of the two values on the stack -> i64 0/1
fn wcmp(g: &mut WasmGen, cc: i64) {
    if cc == WCC_EQ {
        w(g, 0x51);
    } else if cc == WCC_NE {
        w(g, 0x52);
    } else if cc == WCC_LT {
        w(g, 0x53);
    } else if cc == WCC_LTU {
        w(g, 0x54);
    } else if cc == WCC_GT {
        w(g, 0x55);
    } else if cc == WCC_GTU {
        w(g, 0x56);
    } else if cc == WCC_LE {
        w(g, 0x57);
    } else if cc == WCC_LEU {
        w(g, 0x58);
    } else if cc == WCC_GE {
        w(g, 0x59);
    } else {
        w(g, 0x5A);
    }
    wextu(g);
}

/// Normalize the i64 on the stack to narrow type `ty` (nat_ir's ng_ext)
fn wnarrow(g: &mut WasmGen, ty: IrType) {
    match ty {
        IrType::I8 => {
            w(g, 0xC2);
        }
        IrType::I16 => {
            w(g, 0xC3);
        }
        IrType::I32 => {
            w(g, 0xC4);
        }
        IrType::U8 => {
            wi64(g, 0xFF);
            w(g, 0x83);
        }
        IrType::U16 => {
            wi64(g, 0xFFFF);
            w(g, 0x83);
        }
        IrType::U32 => {
            wi64(g, 0xFFFFFFFF);
            w(g, 0x83);
        }
        _ => {
        }
    }
}

fn wg_is_narrow(ty: IrType) -> bool {
    match ty {
        IrType::I8 => {
            return true;
        }
        IrType::I16 => {
            return true;
        }
        IrType::I32 => {
            return true;
        }
        IrType::U8 => {
            return true;
        }
        IrType::U16 => {
            return true;
        }
        IrType::U32 => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// Push value `id` as an f64 (its bits reinterpreted), or an f32
fn wget_f(g: &mut WasmGen, id: i64, is32: bool) {
    wget(g, id);
    if is32 {
        wwrap(g);
        w(g, 0xBE);
    } else {
        w(g, 0xBF);
    }
}

/// Local `local` (a float's bits) pushed as an f32 or f64
fn wlget_f(g: &mut WasmGen, local: i64, is32: bool) {
    wlget(g, local);
    if is32 {
        wwrap(g);
        w(g, 0xBE);
    } else {
        w(g, 0xBF);
    }
}

/// The float on the stack back to bits (i64)
fn wf_bits(g: &mut WasmGen, is32: bool) {
    if is32 {
        w(g, 0xBC);
        wextu(g);
    } else {
        w(g, 0xBD);
    }
}

// ─── Names: functions, types, strings, globals ─────────────────────────

/// Parameter count of primitive `name` (written here in WASM), -1 if none.
fn wg_prim_params(name: str) -> i64 {
    if name == "nat_syscall" {
        return 7;
    }
    if name == "nat_start_sp" {
        return 0;
    }
    if name == "nat_atomic_load" {
        return 1;
    }
    if name == "nat_atomic_store" {
        return 2;
    }
    if name == "nat_atomic_add" {
        return 2;
    }
    if name == "nat_atomic_cas" {
        return 3;
    }
    if name == "nat_ctx_swap" {
        return 2;
    }
    if name == "nat_ctx_tramp" {
        return 0;
    }
    if name == "nat_clone_thread" {
        return 5;
    }
    if name == "nat_call_fn" {
        return 3;
    }
    if name == "nat_fn_table" {
        return 0;
    }
    if name == "nat_tls_get" {
        return 0;
    }
    if name == "nat_tls_set" {
        return 1;
    }
    if name == "nat_frame_fp" {
        return 0;
    }
    if name == "nat_frame_ret" {
        return 1;
    }
    if name == "nat_frame_next" {
        return 1;
    }
    if name == "nat_fn_names" {
        return 0;
    }
    if name == "nat_sig_handler" {
        return 0;
    }
    if name == "nat_sig_restorer" {
        return 0;
    }
    if name == "nat_fma" {
        return 3;
    }
    if name == "nat_arch" {
        return 0;
    }
    if name == "nat_os" {
        return 0;
    }
    if name == "nat_wasm_grow" {
        return 1;
    }
    if name == "nat_wasm_size" {
        return 0;
    }
    if name == "nat_wasm_zero" {
        return 2;
    }
    if name == "nat_c_sqrt" || name == "nat_c_fabs" || name == "nat_c_floor" || name == "nat_c_ceil" || name == "nat_c_trunc" || name == "nat_c_round" {
        return 1;
    }
    return 0 - 1;
}

/// The WASI preview-1 functions the runtime's `wasi_<name>` externs name,
/// with their signatures (i: i32, I: i64; after '>' the result).
fn wg_wasi_sig(name: str) -> str {
    if name == "fd_write" || name == "fd_read" || name == "poll_oneoff" {
        return "iiii>i";
    }
    if name == "fd_close" {
        return "i>i";
    }
    if name == "fd_seek" {
        return "iIii>i";
    }
    if name == "fd_readdir" {
        return "iiiIi>i";
    }
    if name == "path_open" {
        return "iiiiiIIii>i";
    }
    if name == "path_filestat_get" {
        return "iiiii>i";
    }
    if name == "path_unlink_file" || name == "path_remove_directory" || name == "path_create_directory" {
        return "iii>i";
    }
    if name == "path_rename" {
        return "iiiiii>i";
    }
    if name == "proc_exit" {
        return "i>";
    }
    if name == "clock_time_get" {
        return "iIi>i";
    }
    if name == "random_get" || name == "args_sizes_get" || name == "args_get" || name == "environ_sizes_get" || name == "environ_get" {
        return "ii>i";
    }
    if name == "sched_yield" {
        return ">i";
    }
    if name == "fd_prestat_get" {
        return "ii>i";
    }
    if name == "fd_prestat_dir_name" {
        return "iii>i";
    }
    return "";
}

fn wg_has_fn(g: &WasmGen, name: str) -> bool {
    return HashMap_contains(g.all_fns, name);
}

/// Parameter count of a function or primitive (-1: neither)
fn wg_nparams(g: &WasmGen, name: str) -> i64 {
    if HashMap_contains(g.all_fns, name) {
        return HashMap_get(g.all_fns, name) - 1;
    }
    return wg_prim_params(name);
}

/// The type index of signature `key`
fn wg_type(g: &mut WasmGen, key: str) -> i64 {
    if HashMap_contains(g.type_index, key) {
        return HashMap_get(g.type_index, key) - 1;
    }
    g.type_keys.push(key);
    HashMap_insert(g.type_index, key, g.type_keys.len());
    return g.type_keys.len() - 1;
}

/// The type of a function of n i64 parameters returning an i64
fn wg_type_n(g: &mut WasmGen, n: i64) -> i64 {
    var key: str = "";
    var i: i64 = 0;
    while i < n {
        key = key + "I";
        i = i + 1;
    }
    return wg_type(g, key + ">I");
}

/// The function a call to `name` runs: an alias (p_vec_* -> core's
/// Vec_*), the runtime's pert_X for builtin p_X, else `name`.
fn wg_resolve(g: &WasmGen, name: str) -> str {
    var alias: str = pe_runtime_alias(name);
    if alias != name {
        return alias;
    }
    var p: str = pert_name(name);
    if p != "" && wg_has_fn(g, p) {
        return p;
    }
    return name;
}

/// The index of function `name`, queueing it for compilation; -1 when the
/// program defines no such function and it is not a primitive.
fn wg_fn_ref(g: &mut WasmGen, name: str) -> i64 {
    if HashMap_contains(g.fn_index, name) {
        return HashMap_get(g.fn_index, name);
    }
    var np: i64 = wg_nparams(g, name);
    if np < 0 {
        return 0 - 1;
    }
    var idx: i64 = g.n_imports + g.def_types.len();
    HashMap_insert(g.fn_index, name, idx);
    g.def_types.push(wg_type_n(g, np));
    g.queue.push(name);
    return idx;
}

/// The table index of function `name` (0: none)
fn wg_table_ref(g: &mut WasmGen, name: str) -> i64 {
    if HashMap_contains(g.table_index, name) {
        return HashMap_get(g.table_index, name);
    }
    var f: i64 = wg_fn_ref(g, name);
    if f < 0 {
        return 0;
    }
    g.table.push(f);
    HashMap_insert(g.table_index, name, g.table.len());
    return g.table.len();
}

fn wg_unresolved(g: &mut WasmGen, name: str) {
    if !HashMap_contains(g.unresolved_seen, name) {
        HashMap_insert(g.unresolved_seen, name, 1);
        g.unresolved.push(name + " (from " + g.cur_name + ")");
    }
}

fn wg_data_align(g: &mut WasmGen) {
    while g.data.len() % 8 != 0 {
        g.data.push(0);
    }
}

/// The address of string constant `s` (its bytes and a NUL, 8-aligned)
fn wg_str(g: &mut WasmGen, s: str) -> i64 {
    if HashMap_contains(g.str_addr, s) {
        return HashMap_get(g.str_addr, s);
    }
    wg_data_align(g);
    var a: i64 = WG_DATA_BASE + g.data.len();
    HashMap_insert(g.str_addr, s, a);
    var n: i64 = str_len(s);
    var i: i64 = 0;
    while i < n {
        g.data.push(str_byte_at(s, i) & 0xFF);
        i = i + 1;
    }
    g.data.push(0);
    return a;
}

/// The address of global `name` (its value is written at the end)
fn wg_glob(g: &mut WasmGen, name: str, module: &IrModule) -> i64 {
    if HashMap_contains(g.glob_addr, name) {
        return HashMap_get(g.glob_addr, name);
    }
    wg_data_align(g);
    var a: i64 = WG_DATA_BASE + g.data.len();
    HashMap_insert(g.glob_addr, name, a);
    g.globs.push(name);
    var size: i64 = 8;
    match IrModule_get_global(module, name) {
        OptGlobalLookup::Some(gty, _) => {
            size = IrModule_type_size(module, gty);
            if size < 8 {
                size = 8;
            }
            size = (size + 7) & (0 - 8);
        }
        OptGlobalLookup::None => {
        }
    }
    var i: i64 = 0;
    while i < size {
        g.data.push(0);
        i = i + 1;
    }
    return a;
}

fn wg_data_word(g: &mut WasmGen, addr: i64, v: i64) {
    var at: i64 = addr - WG_DATA_BASE;
    var i: i64 = 0;
    while i < 8 {
        g.data.set(at + i, (v >> (i * 8)) & 0xFF);
        i = i + 1;
    }
}

fn wg_dyn_id(g: &WasmGen, name: str) -> i64 {
    var i: i64 = 0;
    while i < g.dyn_types.len() {
        if g.dyn_types.get(i) == name {
            return i + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn wg_insert_sorted(v: Vec<str>, s: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var placed: bool = false;
    var i: i64 = 0;
    while i < v.len() {
        var x: str = v.get(i);
        if x == s {
            return v;
        }
        if !placed && str_compare(x, s) > 0 {
            out.push(s);
            placed = true;
        }
        out.push(x);
        i = i + 1;
    }
    if !placed {
        out.push(s);
    }
    return out;
}

fn wg_meta_ty(func: &IrFunction, id: i64) -> IrType {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => {
            return m.ty;
        }
        OptValueMeta::None => {
        }
    }
    return IrType::I64;
}

/// CI5: the element count of the fixed-size array `ptr` points at (its
/// type is `*[T; N]` and the access steps by T's size), or -1. A function
/// parameter has no type here (-1: unchecked, as before). A value typed
/// `[T; N]` itself is the array's address here (the Load from a slot of a
/// `var a: [T; N] = ...`, which holds the pointer: an i64 load), so it is
/// checked against N the same way.
fn wg_array_bound(func: &IrFunction, module: &IrModule, ptr: i64, esize: i64) -> i64 {
    match wg_meta_ty(func, ptr) {
        IrType::Array(velem, vn) => {
            var vsize: i64 = IrModule_type_size(module, box_ir_type_unbox(velem));
            if vsize < 1 {
                vsize = 1;
            }
            if vsize == esize && vn >= 0 {
                return vn;
            }
        }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Array(aelem, n) => {
                    var asize: i64 = IrModule_type_size(module, box_ir_type_unbox(aelem));
                    if asize < 1 {
                        asize = 1;
                    }
                    if asize == esize && n >= 0 {
                        return n;
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return 0 - 1;
}

/// CI5: whether instruction `id` lies inside an `unsafe` block (between an
/// UnsafeBegin and its UnsafeEnd: ids grow in the order lowering emits)
fn wg_in_unsafe(func: &IrFunction, id: i64) -> bool {
    var depth: i64 = 0;
    var i: i64 = 0;
    while i < func.insts.len() {
        if func.insts.get(i).id < id {
            match func.insts.get(i).inst {
                Inst::UnsafeBegin => {
                    depth = depth + 1;
                }
                Inst::UnsafeEnd => {
                    if depth > 0 {
                        depth = depth - 1;
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1;
    }
    return depth > 0;
}

fn wg_meta_line(func: &IrFunction, id: i64) -> i64 {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => {
            match m.source_line {
                OptU64::Some(v) => {
                    return v as i64;
                }
                OptU64::None => {
                }
            }
        }
        OptValueMeta::None => {
        }
    }
    return 0;
}

fn wg_is_unsigned_ty(t: IrType) -> bool {
    return ir_type_eq(t, IrType::U8) || ir_type_eq(t, IrType::U16) || ir_type_eq(t, IrType::U32) || ir_type_eq(t, IrType::U64);
}

fn wg_is_ptr_ty(t: IrType) -> bool {
    match t {
        IrType::Ptr(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

fn wg_unchecked(g: &WasmGen, id: i64) -> bool {
    return id >= 0 && id < g.unchecked.len() && (g.unchecked.get(id) & 1) != 0;
}

// ─── Calls ─────────────────────────────────────────────────────────────

/// Call function `name` (resolved) with `pushed` arguments on the stack:
/// extra ones dropped, missing ones 0 (WASM checks arity, machine code
/// does not). Without a definition: a trap. Leaves its i64 result.
fn wg_call_named(g: &mut WasmGen, name: str, pushed: i64) {
    var f: i64 = wg_fn_ref(g, name);
    if f < 0 {
        wg_unresolved(g, name);
        var i: i64 = 0;
        while i < pushed {
            w(g, 0x1A);
            i = i + 1;
        }
        w(g, 0x00);
        wi64(g, 0);
        return;
    }
    var np: i64 = wg_nparams(g, name);
    var k: i64 = pushed;
    while k > np {
        w(g, 0x1A);
        k = k - 1;
    }
    while k < np {
        wi64(g, 0);
        k = k + 1;
    }
    wcall(g, f);
    if g.as_here && HashMap_contains(g.as_set, name) {
        wg_as_check(g);
    }
}

/// After a call that may give control away: when it returned unwinding,
/// leave the switch loop for the function's save code with this segment
/// (the call's) as the resume point
fn wg_as_check(g: &mut WasmGen) {
    wgget(g, WG_G_ST);
    wwrap(g);
    wif(g);
    wi32(g, g.k);
    wlset(g, g.cur);
    // the if, the segments' blocks still open, the loop, then $unwind
    wbr(g, g.nblocks - g.k + g.extra);
    wendif(g);
}

/// The functions a call instruction may run, as wg_gen_call resolves it
/// ("<ind>": a closure, any function a function reference names)
fn wg_as_callees(g: &WasmGen, inst: Inst) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    match inst {
        Inst::Call(call_name, _, _, _) => {
            out.push(call_name);
            var r: str = wg_resolve(g, call_name);
            if r != call_name {
                out.push(r);
            }
            if call_name == "p_thread_spawn" {
                out.push("pert_thread_spawn_v");
            }
            if call_name == "p_co_async" {
                out.push("pert_co_async_v");
            }
            if call_name == "p_executor_spawn" {
                out.push("pert_executor_spawn_v");
            }
            if HashMap_contains(g.c_names, call_name) {
                var cname: str = g.c_list.get(HashMap_get(g.c_names, call_name) - 1);
                out.push("pert_c_" + cname);
                out.push(cname);
            }
        }
        Inst::CallPtr(_, _, _, _, _) => {
            out.push("<ind>");
        }
        Inst::DynCall(_, method, _, _, _) => {
            var ti: i64 = 0;
            while ti < g.dyn_types.len() {
                out.push(g.dyn_types.get(ti) + "_" + method);
                ti = ti + 1;
            }
        }
        _ => {
        }
    }
    return out;
}

/// Whether instruction `inst` is a call that may give control away
fn wg_as_inst(g: &WasmGen, inst: Inst) -> bool {
    var cs: Vec<str> = wg_as_callees(g, inst);
    var i: i64 = 0;
    while i < cs.len() {
        var c: str = cs.get(i);
        if c == "<ind>" {
            if g.as_ind {
                return true;
            }
        } else if HashMap_contains(g.as_set, c) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The functions that may give control away (g.as_set): those that reach
/// nat_ctx_swap, nat_call_fn (a task's body, any function) or
/// nat_clone_thread (a thread's) through calls, closures (when a function
/// a function reference names may) and dyn calls
fn wg_as_analyze(g: &mut WasmGen, module: &IrModule) {
    var nf: i64 = module.functions.len();
    var idx: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < nf {
        HashMap_insert(idx, module.functions.get(fi).name, fi + 1);
        fi = fi + 1;
    }
    // Node nf: a closure call; node nf + 1: the primitives
    var ind: i64 = nf;
    var seed: i64 = nf + 1;
    var starts: Vec<i64> = Vec::new();
    var edges: Vec<i64> = Vec::new();
    var refs: Vec<i64> = Vec::new();
    fi = 0;
    while fi < nf {
        starts.push(edges.len());
        var f: IrFunction = module.functions.get(fi).func;
        var k: i64 = 0;
        while k < f.insts.len() {
            match f.insts.get(k).inst {
                Inst::ConstFnRef(rname) => {
                    var rt: str = c_fn_target(rname);
                    if HashMap_contains(idx, rt) {
                        refs.push(HashMap_get(idx, rt) - 1);
                    }
                }
                _ => {
                }
            }
            var cs: Vec<str> = wg_as_callees(g, f.insts.get(k).inst);
            var ci: i64 = 0;
            while ci < cs.len() {
                var c: str = cs.get(ci);
                if c == "<ind>" {
                    edges.push(ind);
                } else if c == "nat_ctx_swap" || c == "nat_call_fn" || c == "nat_clone_thread" {
                    edges.push(seed);
                } else if HashMap_contains(idx, c) {
                    edges.push(HashMap_get(idx, c) - 1);
                }
                ci = ci + 1;
            }
            k = k + 1;
        }
        fi = fi + 1;
    }
    starts.push(edges.len());
    var sw: Vec<i64> = Vec::new();
    var n: i64 = 0;
    while n < nf + 2 {
        sw.push(0);
        n = n + 1;
    }
    sw.set(seed, 1);
    var changed: bool = true;
    while changed {
        changed = false;
        fi = 0;
        while fi < nf {
            if sw.get(fi) == 0 {
                var e: i64 = starts.get(fi);
                var e_end: i64 = starts.get(fi + 1);
                while e < e_end {
                    if sw.get(edges.get(e)) != 0 {
                        sw.set(fi, 1);
                        changed = true;
                        break;
                    }
                    e = e + 1;
                }
            }
            fi = fi + 1;
        }
        if sw.get(ind) == 0 {
            var r: i64 = 0;
            while r < refs.len() {
                if sw.get(refs.get(r)) != 0 {
                    sw.set(ind, 1);
                    changed = true;
                    break;
                }
                r = r + 1;
            }
        }
    }
    g.as_ind = sw.get(ind) != 0;
    fi = 0;
    while fi < nf {
        if sw.get(fi) != 0 {
            HashMap_insert(g.as_set, module.functions.get(fi).name, 1);
        }
        fi = fi + 1;
    }
    HashMap_insert(g.as_set, "nat_ctx_swap", 1);
    HashMap_insert(g.as_set, "nat_call_fn", 1);
    HashMap_insert(g.as_set, "nat_clone_thread", 1);
}

/// Push values `srcs` (-1: a null `__env`)
fn wg_push_srcs(g: &mut WasmGen, srcs: &Vec<i64>) {
    var i: i64 = 0;
    while i < srcs.len() {
        var s: i64 = srcs.get(i);
        if s < 0 {
            wi64(g, 0);
        } else {
            wget(g, s);
        }
        i = i + 1;
    }
}

/// Start a call of builtin `name`: its null `__env` pushed when it runs
/// the runtime's Fides function. Returns the function to call.
fn wg_builtin_begin(g: &mut WasmGen, name: str) -> str {
    var target: str = wg_resolve(g, name);
    if wg_has_fn(g, target) && !wg_has_fn(g, name) {
        wi64(g, 0);
    }
    return target;
}

/// Call builtin `name` with the values `args`; leaves the result.
fn wg_call_builtin(g: &mut WasmGen, name: str, args: &Vec<i64>) {
    var target: str = wg_resolve(g, name);
    var env: bool = wg_has_fn(g, target) && !wg_has_fn(g, name);
    var n: i64 = args.len();
    if env {
        wi64(g, 0);
        n = n + 1;
    }
    wg_push_srcs(g, args);
    wg_call_named(g, target, n);
}

/// A panic with `msg` (the runtime prints it, its trace, and exits 1)
fn wg_panic_msg(g: &mut WasmGen, msg: str) {
    var target: str = wg_builtin_begin(g, "p_panic");
    var env: i64 = 0;
    if wg_has_fn(g, target) && !wg_has_fn(g, "p_panic") {
        env = 1;
    }
    wi64(g, wg_str(g, msg));
    wg_call_named(g, target, env + 1);
    w(g, 0x1A);
    w(g, 0x00);
}

/// Arithmetic panic `which`: with " at line N" for the division panics
/// when the instruction has a line (as the interpreter prints them)
fn wg_panic(g: &mut WasmGen, which: i64) {
    var msg: str = wg_panic_messages().get(which);
    if which >= WP_DIV_OVF && g.cur_inst_line > 0 {
        msg = msg + " at line " + int_to_str(g.cur_inst_line);
    }
    wg_panic_msg(g, msg);
}

/// if (i32 on the stack) { panic which }
fn wg_panic_if(g: &mut WasmGen, which: i64) {
    wif(g);
    wg_panic(g, which);
    wendif(g);
}

/// A call to a WASI import (C name `wasi_<name>`) with values `args`
fn wg_call_import(g: &mut WasmGen, ix: i64, args: &Vec<i64>) {
    var sig: str = g.imp_sigs.get(ix);
    var gt: i64 = str_find(sig, ">");
    var i: i64 = 0;
    while i < gt {
        if i < args.len() {
            wget(g, args.get(i));
        } else {
            wi64(g, 0);
        }
        if str_byte_at(sig, i) == 105 {
            wwrap(g);
        }
        i = i + 1;
    }
    wcall(g, ix);
    if gt + 1 < str_len(sig) {
        if str_byte_at(sig, gt + 1) == 105 {
            wexts(g);
        }
    } else {
        wi64(g, 0);
    }
}

/// The value of bare-metal builtin `name` in a WASI program (the
/// interpreter's), -1 when it is not one (or the program or its runtime
/// defines it)
fn wg_bare_value(g: &WasmGen, name: str) -> i64 {
    if wg_has_fn(g, name) || wg_has_fn(g, wg_resolve(g, name)) {
        return 0 - 1;
    }
    if name == "p_cli" || name == "p_sti" || name == "p_lidt" || name == "p_idt_set_entry" || name == "p_hlt" || name == "p_outb" || name == "p_cr3_write" || name == "p_cr0_write" || name == "p_cr4_write" || name == "p_invlpg" || name == "p_page_map" || name == "p_page_unmap" || name == "p_phys_write64" || name == "p_lgdt" || name == "p_gdt_set_entry" || name == "p_serial_init" || name == "p_serial_write" {
        return 0;
    }
    if name == "p_inb" || name == "p_phys_read64" || name == "p_serial_read" || name == "p_serial_ready" {
        return 0;
    }
    if name == "p_cr3_read" {
        return 0x10000;
    }
    if name == "p_cr0_read" {
        return 0x80000011;
    }
    if name == "p_cr4_read" {
        return 0x20;
    }
    return 0 - 1;
}

/// A builtin or C function that starts a process (WASI has no processes)
fn wg_is_process_call(g: &WasmGen, name: str) -> bool {
    if wg_has_fn(g, name) {
        return false;
    }
    if name == "p_system" || name == "p_process_run" || name == "p_spawn_process" || name == "p_exec" {
        return true;
    }
    if HashMap_contains(g.c_names, name) {
        var cname: str = g.c_list.get(HashMap_get(g.c_names, name) - 1);
        return cname == "system" || cname == "popen" || cname == "fork" || cname == "execv" || cname == "execvp" || cname == "execve" || cname == "posix_spawn" || cname == "posix_spawnp";
    }
    return false;
}

fn wg_gen_call(g: &mut WasmGen, id: i64, call_name: str, args: Vec<i64>, func: &IrFunction) {
    // An f64 lives in its local as its bits: these copy the word
    if (call_name == "p_f64_to_bits" || call_name == "p_f64_from_bits") && args.len() == 1 {
        wget(g, args.get(0));
        wset(g, id);
        return;
    }
    if call_name == "p_int_to_float" && args.len() == 1 {
        wget(g, args.get(0));
        w(g, 0xB9);
        wf_bits(g, false);
        wset(g, id);
        return;
    }
    if call_name == "p_float_to_int" && args.len() == 1 {
        wget_f(g, args.get(0), false);
        w(g, 0xFC);
        wu(g, 6);
        wset(g, id);
        return;
    }
    if call_name == "p_f32_to_bits" && args.len() == 1 {
        wget_f(g, args.get(0), false);
        w(g, 0xB6);
        wf_bits(g, true);
        wset(g, id);
        return;
    }
    // Bare-metal builtins (PL4): a WASI program has no ports, control
    // registers or serial line; they do nothing, as in the interpreter
    // (compiler/interp.fd "Bare-metal stubs")
    var bare: i64 = wg_bare_value(g, call_name);
    if bare != 0 - 1 {
        wi64(g, bare);
        wset(g, id);
        return;
    }
    // Processes (PL4): WASI has none, so a command is a clear run-time
    // error where the runtime would fail to fork ("could not start")
    if wg_is_process_call(g, call_name) {
        wg_panic_msg(g, "not available in WebAssembly: processes (" + call_name + ")");
        wi64(g, 0);
        wset(g, id);
        return;
    }
    // Varargs spawns: the arguments after `nargs` go to the frame's varargs
    // area and are handed over as an array
    var va_target: str = "";
    var va_first: i64 = 0;
    if call_name == "p_thread_spawn" {
        va_target = "pert_thread_spawn_v";
    }
    if call_name == "p_co_async" {
        va_target = "pert_co_async_v";
    }
    if call_name == "p_executor_spawn" {
        va_target = "pert_executor_spawn_v";
        va_first = 1;
    }
    if va_target != "" && wg_has_fn(g, va_target) && args.len() >= va_first + 2 && g.va_off >= 0 {
        var k: i64 = va_first + 2;
        var slot: i64 = 0;
        while k < args.len() && slot < 8 {
            wlget(g, g.fp);
            wwrap(g);
            wget(g, args.get(k));
            wstore(g, 8, g.va_off + slot * 8);
            k = k + 1;
            slot = slot + 1;
        }
        wi64(g, 0);
        wget(g, args.get(va_first));
        wget(g, args.get(va_first + 1));
        wlget(g, g.fp);
        wi64(g, g.va_off);
        w(g, 0x7C);
        wg_call_named(g, va_target, 4);
        wset(g, id);
        return;
    }
    // extern "C" functions: the runtime's Fides pert_c_<C name>, an
    // instruction primitive nat_c_<C name>, or a WASI import
    if HashMap_contains(g.c_names, call_name) && !wg_has_fn(g, call_name) {
        var cname: str = g.c_list.get(HashMap_get(g.c_names, call_name) - 1);
        var over: str = "pert_c_" + cname;
        var prim: str = "nat_c_" + cname;
        if wg_has_fn(g, over) {
            wi64(g, 0);
            wg_push_srcs(g, &args);
            wg_call_named(g, over, args.len() + 1);
            wset(g, id);
            return;
        }
        if wg_prim_params(prim) >= 0 {
            wg_push_srcs(g, &args);
            wg_call_named(g, prim, args.len());
            wset(g, id);
            return;
        }
        if HashMap_contains(g.imp_index, cname) {
            wg_call_import(g, HashMap_get(g.imp_index, cname) - 1, &args);
            wset(g, id);
            return;
        }
        if wg_prim_params(cname) >= 0 {
            wg_push_srcs(g, &args);
            wg_call_named(g, cname, args.len());
            wset(g, id);
            return;
        }
        // A C function with no WebAssembly version (a C library's, or the
        // C runtime's own, as pledge_asset_*): a clear error when it is
        // called, not a module that cannot be built (PL4), as the
        // interpreter does with FFI it cannot run
        if !wg_has_fn(g, wg_resolve(g, call_name)) {
            if !HashMap_contains(g.unresolved_seen, "C " + cname) {
                HashMap_insert(g.unresolved_seen, "C " + cname, 1);
                p_eprint_str("[wasm] warning: C function " + cname + " (from " + g.cur_name + ") has no WebAssembly version: calling it panics\n");
            }
            wg_panic_msg(g, "not available in WebAssembly: C function " + cname + " (build with `fid ccompile --target wasm32-wasi`)");
            wi64(g, 0);
            wset(g, id);
            return;
        }
    }
    var target: str = call_name;
    if call_name == "print" {
        target = "p_print_int";
        if args.len() > 0 {
            var aty: IrType = wg_meta_ty(func, args.get(0));
            if wg_is_ptr_ty(aty) {
                target = "p_print_str";
            } else if ir_type_is_float(aty) {
                target = "p_print_float";
            } else if ir_type_eq(aty, IrType::Bool) {
                target = "p_print_bool";
            } else if ir_type_is_opaque_named(aty, "Vec") {
                target = "p_print_vec";
            } else if ir_type_is_opaque_named(aty, "HashMap") {
                target = "p_print_map";
            } else if ir_type_is_opaque_named(aty, "Tensor") {
                target = "p_print_tensor";
            }
        }
    } else if call_name == "p_to_str" {
        if args.len() > 0 {
            var aty2: IrType = wg_meta_ty(func, args.get(0));
            if ir_type_is_opaque_named(aty2, "Vec") {
                target = "p_to_str_vec";
            } else if ir_type_is_float(aty2) {
                target = "p_to_str_float";
            } else if wg_is_ptr_ty(aty2) {
                target = "p_to_str_str";
            } else if ir_type_eq(aty2, IrType::Bool) {
                target = "p_to_str_bool";
            }
        }
    }
    var resolved: str = wg_resolve(g, target);
    var n: i64 = args.len();
    if wg_has_fn(g, resolved) && !wg_has_fn(g, call_name) {
        wi64(g, 0);
        n = n + 1;
    }
    wg_push_srcs(g, &args);
    wg_call_named(g, resolved, n);
    wset(g, id);
}

// ─── Integer arithmetic (nat_ir's meaning) ─────────────────────────────

/// t0 / t1 or t0 % t1 in type `ty`, onto the stack
fn wg_divmod(g: &mut WasmGen, is_mod: bool, ty: IrType, checked: bool) {
    // Division by zero panics, even in @wrapping code
    wlget(g, g.t1);
    w(g, 0x50);
    if is_mod {
        wg_panic_if(g, WP_MOD_ZERO);
    } else {
        wg_panic_if(g, WP_DIV_ZERO);
    }
    if wg_is_unsigned_ty(ty) {
        wlget(g, g.t0);
        wlget(g, g.t1);
        if is_mod {
            w(g, 0x82);
        } else {
            w(g, 0x80);
        }
        return;
    }
    wlget(g, g.t1);
    wi64(g, 0 - 1);
    w(g, 0x51);
    wif_t(g, WT_I64);
    if is_mod {
        wi64(g, 0);
    } else {
        if checked && ir_type_eq(ty, IrType::I64) {
            wlget(g, g.t0);
            wi64(g, 0 - 9223372036854775807 - 1);
            w(g, 0x51);
            wg_panic_if(g, WP_DIV_OVF);
        }
        wi64(g, 0);
        wlget(g, g.t0);
        w(g, 0x7D);
    }
    welse(g);
    wlget(g, g.t0);
    wlget(g, g.t1);
    if is_mod {
        w(g, 0x81);
    } else {
        w(g, 0x7F);
    }
    wendif(g);
}

/// The i64 in t2 normalized to narrow type `ty`; with a panic: one that
/// does not fit. Leaves it in t2.
fn wg_narrow_t2(g: &mut WasmGen, ty: IrType, panic: i64) {
    if !wg_is_narrow(ty) {
        return;
    }
    if panic >= 0 {
        wlget(g, g.t2);
        wnarrow(g, ty);
        wlget(g, g.t2);
        w(g, 0x52);
        wg_panic_if(g, panic);
        return;
    }
    wlget(g, g.t2);
    wnarrow(g, ty);
    wlset(g, g.t2);
}

/// t2 = t0 op t1 for add (0), sub (1), mul (2), with overflow checks
fn wg_checked(g: &mut WasmGen, kind: i64, ty: IrType, checked: bool) {
    var is_i64: bool = ir_type_eq(ty, IrType::I64);
    var is_u64: bool = ir_type_eq(ty, IrType::U64);
    var which: i64 = WP_ADD;
    if kind == 1 {
        which = WP_SUB;
    }
    if kind == 2 {
        which = WP_MUL;
    }
    wlget(g, g.t0);
    wlget(g, g.t1);
    if kind == 0 {
        w(g, 0x7C);
    } else if kind == 1 {
        w(g, 0x7D);
    } else {
        w(g, 0x7E);
    }
    wlset(g, g.t2);
    if checked && is_i64 {
        if kind == 0 {
            // ((a ^ r) & (b ^ r)) < 0
            wlget(g, g.t0);
            wlget(g, g.t2);
            w(g, 0x85);
            wlget(g, g.t1);
            wlget(g, g.t2);
            w(g, 0x85);
            w(g, 0x83);
            wi64(g, 0);
            w(g, 0x53);
            wg_panic_if(g, which);
        } else if kind == 1 {
            // ((a ^ b) & (a ^ r)) < 0
            wlget(g, g.t0);
            wlget(g, g.t1);
            w(g, 0x85);
            wlget(g, g.t0);
            wlget(g, g.t2);
            w(g, 0x85);
            w(g, 0x83);
            wi64(g, 0);
            w(g, 0x53);
            wg_panic_if(g, which);
        } else {
            // a == -1 ? b == MIN : a != 0 && r / a != b
            wlget(g, g.t0);
            wi64(g, 0 - 1);
            w(g, 0x51);
            wif_t(g, WT_I32);
            wlget(g, g.t1);
            wi64(g, 0 - 9223372036854775807 - 1);
            w(g, 0x51);
            welse(g);
            wlget(g, g.t0);
            w(g, 0x50);
            wif_t(g, WT_I32);
            wi32(g, 0);
            welse(g);
            wlget(g, g.t2);
            wlget(g, g.t0);
            w(g, 0x7F);
            wlget(g, g.t1);
            w(g, 0x52);
            wendif(g);
            wendif(g);
            wg_panic_if(g, which);
        }
        return;
    }
    if checked && is_u64 {
        if kind == 0 {
            wlget(g, g.t2);
            wlget(g, g.t0);
            w(g, 0x54);
            wg_panic_if(g, which);
        } else if kind == 1 {
            wlget(g, g.t0);
            wlget(g, g.t1);
            w(g, 0x54);
            wg_panic_if(g, which);
        } else {
            wlget(g, g.t0);
            w(g, 0x50);
            wif_t(g, WT_I32);
            wi32(g, 0);
            welse(g);
            wlget(g, g.t2);
            wlget(g, g.t0);
            w(g, 0x80);
            wlget(g, g.t1);
            w(g, 0x52);
            wendif(g);
            wg_panic_if(g, which);
        }
        return;
    }
    // A narrow result that changes did not fit (checked); else normalized
    if checked {
        wg_narrow_t2(g, ty, which);
    } else {
        wg_narrow_t2(g, ty, 0 - 1);
    }
}

fn wg_fcmp(g: &mut WasmGen, cc: i64, is32: bool) {
    var op: i64 = 0x61;
    if cc == WCC_NE {
        op = 0x62;
    }
    if cc == WCC_LT {
        op = 0x63;
    }
    if cc == WCC_GT {
        op = 0x64;
    }
    if cc == WCC_LE {
        op = 0x65;
    }
    if cc == WCC_GE {
        op = 0x66;
    }
    if is32 {
        op = op - 6;
    }
    w(g, op);
    wextu(g);
}

fn wg_gen_binop(g: &mut WasmGen, id: i64, op: BinOp, left: i64, right: i64, ty: IrType, func: &IrFunction) {
    var lty: IrType = wg_meta_ty(func, left);
    var rty: IrType = wg_meta_ty(func, right);
    var float_ty: IrType = ty;
    var is_float: bool = ir_type_is_float(ty);
    if !is_float && ir_type_is_float(lty) {
        is_float = true;
        float_ty = lty;
    }
    if is_float {
        var is32: bool = ir_type_eq(float_ty, IrType::F32);
        var arith: i64 = 0;
        var cc: i64 = 0 - 1;
        match op {
            BinOp::Add => {
                arith = 0xA0;
            }
            BinOp::Sub => {
                arith = 0xA1;
            }
            BinOp::Mul => {
                arith = 0xA2;
            }
            BinOp::Div => {
                arith = 0xA3;
            }
            BinOp::Eq => {
                cc = WCC_EQ;
            }
            BinOp::Neq => {
                cc = WCC_NE;
            }
            BinOp::Lt => {
                cc = WCC_LT;
            }
            BinOp::LtEq => {
                cc = WCC_LE;
            }
            BinOp::Gt => {
                cc = WCC_GT;
            }
            BinOp::GtEq => {
                cc = WCC_GE;
            }
            _ => {
            }
        }
        match op {
            BinOp::Mod => {
                // WASM has no fmod: a - trunc(a / b) * b, which is C's fmod
                // while a / b's integer part is exact (2g.13; it gave 0).
                // A zero b or an infinite a gives NaN, as fmod does; an
                // infinite b gives NaN where fmod gives a.
                wget(g, left);
                wlset(g, g.t0);
                wget(g, right);
                wlset(g, g.t1);
                wlget_f(g, g.t0, is32);
                wlget_f(g, g.t0, is32);
                wlget_f(g, g.t1, is32);
                if is32 {
                    w(g, 0x95);
                    w(g, 0x8F);
                } else {
                    w(g, 0xA3);
                    w(g, 0x9D);
                }
                // f.div, f.trunc
                wlget_f(g, g.t1, is32);
                if is32 {
                    w(g, 0x94);
                    w(g, 0x93);
                } else {
                    w(g, 0xA2);
                    w(g, 0xA1);
                }
                // f.mul, f.sub
                wf_bits(g, is32);
                wset(g, id);
                return;
            }
            _ => {
            }
        }
        if arith == 0 && cc < 0 {
            wi64(g, 0);
            wset(g, id);
            return;
        }
        wget_f(g, left, is32);
        wget_f(g, right, is32);
        if arith != 0 {
            if is32 {
                w(g, arith - 14);
            } else {
                w(g, arith);
            }
            wf_bits(g, is32);
        } else {
            wg_fcmp(g, cc, is32);
        }
        wset(g, id);
        return;
    }
    var checked: bool = !g.cur_wrapping && !wg_unchecked(g, id);
    var unsigned_cmp: bool = ir_type_eq(lty, IrType::U64) || ir_type_eq(rty, IrType::U64);
    wget(g, left);
    wlset(g, g.t0);
    wget(g, right);
    wlset(g, g.t1);
    match op {
        BinOp::Add => {
            wg_checked(g, 0, ty, checked);
            wlget(g, g.t2);
        }
        BinOp::Sub => {
            wg_checked(g, 1, ty, checked);
            wlget(g, g.t2);
        }
        BinOp::Mul => {
            wg_checked(g, 2, ty, checked);
            wlget(g, g.t2);
        }
        BinOp::Div => {
            g.cur_inst_line = wg_meta_line(func, id);
            wg_divmod(g, false, ty, checked);
            wlset(g, g.t2);
            if checked {
                wg_narrow_t2(g, ty, WP_DIV_OVF);
            } else {
                wg_narrow_t2(g, ty, 0 - 1);
            }
            g.cur_inst_line = 0;
            wlget(g, g.t2);
        }
        BinOp::Mod => {
            g.cur_inst_line = wg_meta_line(func, id);
            wg_divmod(g, true, ty, checked);
            g.cur_inst_line = 0;
        }
        BinOp::BitAnd => {
            wlget(g, g.t0);
            wlget(g, g.t1);
            w(g, 0x83);
        }
        BinOp::BitOr => {
            wlget(g, g.t0);
            wlget(g, g.t1);
            w(g, 0x84);
        }
        BinOp::BitXor => {
            wlget(g, g.t0);
            wlget(g, g.t1);
            w(g, 0x85);
        }
        BinOp::Shl => {
            wlget(g, g.t0);
            wlget(g, g.t1);
            w(g, 0x86);
            wnarrow(g, ty);
        }
        BinOp::Shr => {
            wlget(g, g.t0);
            wlget(g, g.t1);
            if ir_type_eq(ty, IrType::U64) {
                w(g, 0x88);
            } else {
                w(g, 0x87);
            }
        }
        BinOp::And => {
            wlget(g, g.t0);
            wi64(g, 0);
            w(g, 0x52);
            wlget(g, g.t1);
            wi64(g, 0);
            w(g, 0x52);
            w(g, 0x71);
            wextu(g);
        }
        BinOp::Or => {
            wlget(g, g.t0);
            wlget(g, g.t1);
            w(g, 0x84);
            wi64(g, 0);
            w(g, 0x52);
            wextu(g);
        }
        BinOp::Eq => {
            wlget(g, g.t0);
            wlget(g, g.t1);
            wcmp(g, WCC_EQ);
        }
        BinOp::Neq => {
            wlget(g, g.t0);
            wlget(g, g.t1);
            wcmp(g, WCC_NE);
        }
        BinOp::Lt => {
            wlget(g, g.t0);
            wlget(g, g.t1);
            if unsigned_cmp {
                wcmp(g, WCC_LTU);
            } else {
                wcmp(g, WCC_LT);
            }
        }
        BinOp::LtEq => {
            wlget(g, g.t0);
            wlget(g, g.t1);
            if unsigned_cmp {
                wcmp(g, WCC_LEU);
            } else {
                wcmp(g, WCC_LE);
            }
        }
        BinOp::Gt => {
            wlget(g, g.t0);
            wlget(g, g.t1);
            if unsigned_cmp {
                wcmp(g, WCC_GTU);
            } else {
                wcmp(g, WCC_GT);
            }
        }
        BinOp::GtEq => {
            wlget(g, g.t0);
            wlget(g, g.t1);
            if unsigned_cmp {
                wcmp(g, WCC_GEU);
            } else {
                wcmp(g, WCC_GE);
            }
        }
    }
    wset(g, id);
}

// ─── Instructions ──────────────────────────────────────────────────────

fn wg_block(g: &WasmGen, block_id: i64) -> i64 {
    if HashMap_contains(g.block_index, int_to_str(block_id)) {
        return HashMap_get(g.block_index, int_to_str(block_id));
    }
    return 0;
}

/// Branch to the loop: the dispatch enters block `target`
fn wg_jump(g: &mut WasmGen, target: i64) {
    wi32(g, target);
    wlset(g, g.cur);
    wbr(g, g.nblocks - 1 - g.k + g.extra);
}

/// The epilogue of a return: the frame given back
fn wg_epilogue(g: &mut WasmGen) {
    if g.frame > 0 {
        wlget(g, g.fp);
        wi64(g, g.frame);
        w(g, 0x7C);
        wgset(g, 0);
    }
}

fn wg_gen_inst(g: &mut WasmGen, id: i64, inst: Inst, last: bool, func: &IrFunction, module: &IrModule) {
    match inst {
        Inst::ConstInt(value, _) => {
            wi64(g, value);
            wset(g, id);
        }
        Inst::ConstBool(value) => {
            if value {
                wi64(g, 1);
            } else {
                wi64(g, 0);
            }
            wset(g, id);
        }
        Inst::ConstFloat(value, ty) => {
            if ir_type_eq(ty, IrType::F32) {
                wi64(g, p_f32_to_bits(value) & 0xFFFFFFFF);
            } else {
                wi64(g, p_f64_to_bits(value));
            }
            wset(g, id);
        }
        Inst::ConstStr(value) => {
            // A string naming a program function (a thread or task entry):
            // compiled, and found by name at run time (nat_fn_table)
            if wg_has_fn(g, value) && !HashMap_contains(g.named_seen, value) {
                HashMap_insert(g.named_seen, value, 1);
                wg_table_ref(g, value);
                g.named_fns.push(value);
            }
            wi64(g, wg_str(g, value));
            wset(g, id);
        }
        Inst::ConstFnRef(name) => {
            wi64(g, wg_table_ref(g, c_fn_target(name)));
            wset(g, id);
        }
        Inst::ConstNull(_) => {
            wi64(g, 0);
            wset(g, id);
        }
        Inst::GlobalAddr(name, _) => {
            wi64(g, wg_glob(g, name, module));
            wset(g, id);
        }
        Inst::BinOp(op, left, right, ty) => {
            wg_gen_binop(g, id, op, left, right, ty, func);
        }
        Inst::UnaryOp(op, operand, ty) => {
            match op {
                UnaryOp::Neg => {
                    if ir_type_eq(ty, IrType::F32) {
                        wget(g, operand);
                        wi64(g, 2147483648);
                        w(g, 0x85);
                    } else if ir_type_is_float(ty) {
                        wget(g, operand);
                        wi64(g, 0 - 9223372036854775807 - 1);
                        w(g, 0x85);
                    } else {
                        wi64(g, 0);
                        wget(g, operand);
                        w(g, 0x7D);
                    }
                }
                UnaryOp::Not => {
                    wget(g, operand);
                    wi64(g, 1);
                    w(g, 0x85);
                }
                UnaryOp::BitNot => {
                    wget(g, operand);
                    wi64(g, 0 - 1);
                    w(g, 0x85);
                }
            }
            wset(g, id);
        }
        Inst::Alloca(_, _) => {
            var off: i64 = 0 - 1;
            if id >= 0 && id < g.alloca_off.len() {
                off = g.alloca_off.get(id);
            }
            if off >= 0 {
                wlget(g, g.fp);
                if off != 0 {
                    wi64(g, off);
                    w(g, 0x7C);
                }
                wset(g, id);
            }
        }
        Inst::Load(ptr, ty) => {
            var size: i64 = IrModule_type_size(module, ty);
            var unsigned: bool = false;
            match ty {
                IrType::U8 => {
                    unsigned = true;
                }
                IrType::U16 => {
                    unsigned = true;
                }
                IrType::U32 => {
                    unsigned = true;
                }
                IrType::Bool => {
                    unsigned = true;
                }
                _ => {
                }
            }
            var lsize: i64 = 8;
            if size <= 1 {
                lsize = 1;
            } else if size == 2 {
                lsize = 2;
            } else if size == 4 {
                lsize = 4;
            }
            wget(g, ptr);
            wload(g, lsize, !unsigned, 0);
            wset(g, id);
        }
        Inst::Store(ptr, value, explicit_ty) => {
            // The explicit store type, else the pointee type, else the
            // value's type (as the C backend, pe_ir and nat_ir)
            var store_ty: IrType = IrType::I64;
            var have: bool = false;
            match explicit_ty {
                OptIrType::Some(t0) => {
                    store_ty = t0;
                    have = true;
                }
                OptIrType::None => {
                }
            }
            if !have {
                match wg_meta_ty(func, ptr) {
                    IrType::Ptr(inner) => {
                        store_ty = box_ir_type_unbox(inner);
                        have = true;
                    }
                    _ => {
                    }
                }
            }
            if !have {
                store_ty = wg_meta_ty(func, value);
            }
            var sz: i64 = 8;
            var is_struct: bool = false;
            match store_ty {
                IrType::Struct(_) => {
                    is_struct = true;
                }
                IrType::Array(_, _) => {
                }
                IrType::Ptr(_) => {
                }
                IrType::Opaque(_) => {
                }
                IrType::Generic(_, _) => {
                }
                _ => {
                    var s0: i64 = IrModule_type_size(module, store_ty);
                    if s0 == 1 || s0 == 2 || s0 == 4 {
                        sz = s0;
                    }
                }
            }
            if is_struct {
                wget_addr(g, ptr);
                wget_addr(g, value);
                wi32(g, IrModule_type_size(module, store_ty));
                w(g, 0xFC);
                wu(g, 10);
                w(g, 0);
                w(g, 0);
            } else {
                wget_addr(g, ptr);
                wget(g, value);
                wstore(g, sz, 0);
            }
        }
        Inst::StructCopy(dst_v, src_v, ty) => {
            wget_addr(g, dst_v);
            wget_addr(g, src_v);
            wi32(g, IrModule_type_size(module, ty));
            w(g, 0xFC);
            wu(g, 10);
            w(g, 0);
            w(g, 0);
        }
        Inst::GetFieldPtr(struct_ptr, field_index, _) => {
            var offset: i64 = field_index * 8;
            var sname: str = "";
            match wg_meta_ty(func, struct_ptr) {
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(n) => {
                            sname = n;
                        }
                        _ => {
                        }
                    }
                }
                IrType::Struct(n2) => {
                    sname = n2;
                }
                _ => {
                }
            }
            if sname != "" {
                match IrModule_get_struct(module, sname) {
                    OptStructLayout::Some(layout) => {
                        if field_index >= 0 && field_index < layout.fields.len() {
                            offset = layout.fields.get(field_index).offset;
                        }
                    }
                    OptStructLayout::None => {
                    }
                }
            }
            wget(g, struct_ptr);
            if offset != 0 {
                wi64(g, offset);
                w(g, 0x7C);
            }
            wset(g, id);
        }
        Inst::GetElemPtr(array_ptr, index, elem_ty) => {
            var esize: i64 = IrModule_type_size(module, elem_ty);
            if esize < 1 {
                esize = 1;
            }
            // CI5: an index into a fixed-size array is checked, as the
            // interpreter checks it (outside unsafe blocks)
            var abound: i64 = wg_array_bound(func, module, array_ptr, esize);
            if abound >= 0 && !wg_in_unsafe(func, id) {
                wget(g, index);
                wi64(g, abound);
                w(g, 0x5A);
                wif(g);
                wg_panic_msg(g, "Array index out of bounds");
                wendif(g);
            }
            wget(g, array_ptr);
            wget(g, index);
            if esize != 1 {
                wi64(g, esize);
                w(g, 0x7E);
            }
            w(g, 0x7C);
            wset(g, id);
        }
        Inst::Jump(target) => {
            var t: i64 = wg_block(g, target);
            if !(last && t == g.k + 1) {
                wg_jump(g, t);
            }
        }
        Inst::Switch(_, _, _, _) => {
            // ME28: formed only for codegen_c and nat_ir (ir.fd), never on
            // this path; trap rather than guess a target
            w(g, 0x00);
        }
        Inst::Branch(cond, then, else_) => {
            var tb: i64 = wg_block(g, then);
            var eb: i64 = wg_block(g, else_);
            if last && tb == g.k + 1 {
                wget(g, cond);
                w(g, 0x50);
                wif(g);
                wg_jump(g, eb);
                wendif(g);
            } else if last && eb == g.k + 1 {
                wget(g, cond);
                wi64(g, 0);
                w(g, 0x52);
                wif(g);
                wg_jump(g, tb);
                wendif(g);
            } else {
                wi32(g, tb);
                wi32(g, eb);
                wget(g, cond);
                wi64(g, 0);
                w(g, 0x52);
                w(g, 0x1B);
                wlset(g, g.cur);
                wbr(g, g.nblocks - 1 - g.k + g.extra);
            }
        }
        Inst::Return(ret) => {
            match ret {
                OptValueId::Some(v) => {
                    wget(g, v);
                }
                OptValueId::None => {
                    wi64(g, 0);
                }
            }
            wg_epilogue(g);
            w(g, 0x0F);
        }
        Inst::Unreachable => {
            w(g, 0x00);
        }
        Inst::Call(call_name, args, _, _) => {
            wg_gen_call(g, id, call_name, args, func);
        }
        Inst::CallPtr(fn_ptr, args, cp_ret, _, _) => {
            // A closure: its environment, whose word 0 is the function. A
            // struct or enum result (lower.fd: the CallPtr's result type is
            // a Struct): args[0] is the pointer the callee writes it to,
            // passed first, before the env, as for a direct call and as
            // nat_ir's CallPtr does (2g.108: the arguments were shifted by
            // one, "8597928 0" then "Invalid memory access")
            var cp_sret: bool = false;
            match cp_ret {
                IrType::Struct(_) => {
                    cp_sret = args.len() > 0;
                }
                _ => {
                }
            }
            var srcs: Vec<i64> = Vec::new();
            var ai: i64 = 0;
            if cp_sret {
                srcs.push(args.get(0));
                ai = 1;
            }
            srcs.push(fn_ptr);
            while ai < args.len() {
                srcs.push(args.get(ai));
                ai = ai + 1;
            }
            wg_push_srcs(g, &srcs);
            wget(g, fn_ptr);
            wload(g, 8, false, 0);
            wwrap(g);
            w(g, 0x11);
            wu(g, wg_type_n(g, srcs.len()));
            wu(g, 0);
            if g.as_here && g.as_ind {
                wg_as_check(g);
            }
            wset(g, id);
        }
        Inst::DynCall(_, method, args, _, _) => {
            // env 0, the receiver, then args[1..]; the dyn value is
            // {type id, receiver}
            w(g, 0x02);
            w(g, WT_VOID);
            g.extra = g.extra + 1;
            var ti: i64 = 0;
            while ti < g.dyn_types.len() {
                var tname: str = g.dyn_types.get(ti);
                var mname: str = tname + "_" + method;
                if wg_has_fn(g, mname) && args.len() > 0 {
                    wget(g, args.get(0));
                    wload(g, 8, false, 0);
                    wi64(g, ti + 1);
                    w(g, 0x51);
                    wif(g);
                    wi64(g, 0);
                    wget(g, args.get(0));
                    wload(g, 8, false, 8);
                    var ai2: i64 = 1;
                    while ai2 < args.len() {
                        wget(g, args.get(ai2));
                        ai2 = ai2 + 1;
                    }
                    wg_call_named(g, mname, args.len() + 1);
                    wset(g, id);
                    wbr(g, 1);
                    wendif(g);
                }
                ti = ti + 1;
            }
            w(g, 0x00);
            // no implementation for this type
            wend(g);
            g.extra = g.extra - 1;
        }
        Inst::MakeDyn(value, type_name, _) => {
            var target: str = wg_builtin_begin(g, "p_malloc");
            var n: i64 = 1;
            if wg_has_fn(g, target) && !wg_has_fn(g, "p_malloc") {
                n = 2;
            }
            wi64(g, 16);
            wg_call_named(g, target, n);
            wlset(g, g.t0);
            wlget(g, g.t0);
            wwrap(g);
            wi64(g, wg_dyn_id(g, type_name));
            wstore(g, 8, 0);
            wlget(g, g.t0);
            wwrap(g);
            wget(g, value);
            wstore(g, 8, 8);
            wlget(g, g.t0);
            wset(g, id);
        }
        Inst::BitCast(value, from, to) => {
            // f32 <-> f64 (lower.fd's float-to-float cast) converts the
            // value: an f32 is held as its 32 bits, an f64 as its 64
            // (2g.13). Any other bit cast keeps the bits.
            var from32: bool = ir_type_eq(from, IrType::F32);
            var to32: bool = ir_type_eq(to, IrType::F32);
            if from32 && ir_type_eq(to, IrType::F64) {
                wget_f(g, value, true);
                w(g, 0xBB);
                // f64.promote_f32
                wf_bits(g, false);
            } else if to32 && ir_type_eq(from, IrType::F64) {
                wget_f(g, value, false);
                w(g, 0xB6);
                // f32.demote_f64
                wf_bits(g, true);
            } else {
                wget(g, value);
            }
            wset(g, id);
        }
        Inst::IntExtend(value, from, _) => {
            wget(g, value);
            match from {
                IrType::I8 => {
                    w(g, 0xC2);
                }
                IrType::I16 => {
                    w(g, 0xC3);
                }
                IrType::I32 => {
                    w(g, 0xC4);
                }
                _ => {
                }
            }
            wset(g, id);
        }
        Inst::IntTrunc(value, _, to) => {
            wget(g, value);
            match to {
                IrType::I8 => {
                    wi64(g, 0xFF);
                    w(g, 0x83);
                }
                IrType::U8 => {
                    wi64(g, 0xFF);
                    w(g, 0x83);
                }
                IrType::I16 => {
                    wi64(g, 0xFFFF);
                    w(g, 0x83);
                }
                IrType::U16 => {
                    wi64(g, 0xFFFF);
                    w(g, 0x83);
                }
                IrType::I32 => {
                    wi64(g, 0xFFFFFFFF);
                    w(g, 0x83);
                }
                IrType::U32 => {
                    wi64(g, 0xFFFFFFFF);
                    w(g, 0x83);
                }
                _ => {
                }
            }
            wset(g, id);
        }
        Inst::IntToFloat(value, _, to) => {
            wget(g, value);
            if ir_type_eq(to, IrType::F32) {
                w(g, 0xB4);
                wf_bits(g, true);
            } else {
                w(g, 0xB9);
                wf_bits(g, false);
            }
            wset(g, id);
        }
        Inst::FloatToInt(value, from, _) => {
            if ir_type_eq(from, IrType::F32) {
                wget_f(g, value, true);
                w(g, 0xFC);
                wu(g, 4);
            } else {
                wget_f(g, value, false);
                w(g, 0xFC);
                wu(g, 6);
            }
            wset(g, id);
        }
        Inst::Print(value, ty) => {
            var formatter: str = pe_ir_print_formatter(ty);
            if formatter != "" {
                // Collections print through their Fides formatter
                var ptarget: str = wg_builtin_begin(g, "p_print_str");
                var pn: i64 = 1;
                if wg_has_fn(g, ptarget) && !wg_has_fn(g, "p_print_str") {
                    pn = 2;
                }
                wi64(g, 0);
                wget(g, value);
                wg_call_named(g, wg_resolve(g, formatter), 2);
                wg_call_named(g, ptarget, pn);
                w(g, 0x1A);
            } else {
                var print_fn: str = "p_print_int";
                match ty {
                    IrType::Ptr(_) => {
                        print_fn = "p_print_str";
                    }
                    IrType::Opaque(oname) => {
                        if oname == "String" {
                            print_fn = "p_print_str";
                        }
                    }
                    IrType::F64 => {
                        print_fn = "p_print_float";
                    }
                    IrType::F32 => {
                        print_fn = "p_print_float";
                    }
                    IrType::Bool => {
                        print_fn = "p_print_bool";
                    }
                    _ => {
                    }
                }
                var target2: str = wg_builtin_begin(g, print_fn);
                var n2: i64 = 1;
                if wg_has_fn(g, target2) && !wg_has_fn(g, print_fn) {
                    n2 = 2;
                }
                if ir_type_eq(ty, IrType::F32) {
                    // the runtime prints an f64
                    wget_f(g, value, true);
                    w(g, 0xBB);
                    wf_bits(g, false);
                } else {
                    wget(g, value);
                }
                wg_call_named(g, target2, n2);
                w(g, 0x1A);
            }
        }
        Inst::Panic(message) => {
            wg_panic_msg(g, message);
        }
        Inst::PersistLoad(_, default, _) => {
            wget(g, default);
            wset(g, id);
        }
        Inst::PersistSave(_, _) => {
        }
        Inst::TxnBegin => {
        }
        Inst::TxnEnd => {
        }
        Inst::UnsafeBegin => {
        }
        Inst::UnsafeEnd => {
        }
        Inst::GradBegin(_) => {
            var gargs: Vec<i64> = Vec::new();
            wg_call_builtin(g, pe_ir_autograd_builtin(inst), &gargs);
            w(g, 0x1A);
        }
        Inst::GradEnd => {
            var eargs: Vec<i64> = Vec::new();
            wg_call_builtin(g, pe_ir_autograd_builtin(inst), &eargs);
            w(g, 0x1A);
        }
        Inst::Backward(v) => {
            var bargs: Vec<i64> = Vec::new();
            bargs.push(v);
            wg_call_builtin(g, pe_ir_autograd_builtin(inst), &bargs);
            w(g, 0x1A);
        }
        Inst::TryUnwrap(_, _, _, _) => {
        }
        Inst::Asm(_, _, _, _) => {
            // A WASI program runs no inline assembly (as on the C path)
            wi64(g, 0);
            wset(g, id);
        }
        Inst::RegionBegin(_, _, _, _) => {
            wi64(g, 0);
            wset(g, id);
        }
        Inst::RegionEnd(_, _, _) => {
        }
    }
}

// ─── Functions ─────────────────────────────────────────────────────────

fn wg_note_id(maxid: i64, id: i64) -> i64 {
    if id > maxid {
        return id;
    }
    return maxid;
}

// ─── Structured control flow (TG16) ────────────────────────────────────
//
// A function's IR blocks become WASM's block / loop / if (a "stackifier"),
// by Ramsey's translation over the dominator tree ("Beyond Relooper",
// ICFP 2022). Block x is written as
//   [loop]                       when a back edge enters x
//     block .. block             one per merge child of x (a child in the
//                                dominator tree with two or more forward
//                                edges in), the latest in reverse
//                                postorder outermost
//       <x's code> <x's terminator>
//     end <the earliest merge child's tree> .. end <the latest's>
//   [end]
// The edge x -> y is a `br` to y's loop (a back edge), a `br` to the end
// of the block that y follows (y a merge node), or else y's tree written
// in place (the edge is y's only forward edge in, so x is y's immediate
// dominator). A two-way branch is a `br_if` when one side is a `br`, else
// if / else. Every path ends in a return, a `br` or a trap, so nothing
// falls out of the structure.
//
// The switch loop stays for an irreducible CFG (a back edge to a block
// that does not dominate its source) and for the functions that may give
// control away (see "Tasks": a rewind enters the code at a call, which is
// the switch loop's dispatch). FID_WASM_SWITCH=1 gives every function the
// switch loop (to compare).

// A block's terminator: none (falls into the next block), Jump, Branch,
// Return / Unreachable / Switch, none in the last block (returns 0)
const WK_FALL: i64 = 0;
const WK_JUMP: i64 = 1;
const WK_BRANCH: i64 = 2;
const WK_END: i64 = 3;
const WK_RET0: i64 = 4;
// The enclosing constructs while writing: an if, block x's loop, the
// block that merge node x follows
const WS_IF: i64 = 0;
const WS_LOOP: i64 = 1;
const WS_BLOCK: i64 = 2;

/// The CFG of one function, by block index (func.blocks order; 0 is the
/// entry), and the state of writing it
pub struct WgCfg {
    pub nb: i64,
    // successors (-1: none): Jump's or the fall-through's in s0, Branch's
    // then in s0 and else in s1
    pub s0: Vec<i64>,
    pub s1: Vec<i64>,
    // the terminator: its kind (WK_*), its position in the block's
    // instructions (the count when there is none), Branch's condition
    pub tkind: Vec<i64>,
    pub tpos: Vec<i64>,
    pub tcond: Vec<i64>,
    // reverse-postorder number (-1: not reachable), immediate dominator
    pub rnum: Vec<i64>,
    pub idom: Vec<i64>,
    // 1: a back edge enters it; 1: two or more forward edges enter it
    pub loop_head: Vec<i64>,
    pub merge: Vec<i64>,
    // the merge children of a block in the dominator tree, as a list
    // (first, next), the latest in reverse postorder first
    pub kid_first: Vec<i64>,
    pub kid_next: Vec<i64>,
    // written already
    pub done: Vec<i64>,
    // the enclosing constructs, innermost last
    pub ctx_kind: Vec<i64>,
    pub ctx_blk: Vec<i64>,
    // false: irreducible, a jump to no block, or (not expected) an edge
    // with no label to take it: the function keeps the switch loop
    pub ok: bool,
}

fn wg_cfg_index(bidx: i64, block_id: i64) -> i64 {
    if HashMap_contains(bidx, int_to_str(block_id)) {
        return HashMap_get(bidx, int_to_str(block_id));
    }
    return 0 - 1;
}

/// The CFG of `func`: terminators and successors, reverse postorder from
/// the entry, immediate dominators (Cooper, Harvey and Kennedy's iteration),
/// loop headers and merge nodes, and the dominator tree's merge children.
fn wg_cfg_build(func: &IrFunction) -> WgCfg {
    var nb: i64 = func.blocks.len();
    var bidx: i64 = HashMap_new();
    var i: i64 = 0;
    while i < nb {
        HashMap_insert(bidx, int_to_str(func.blocks.get(i).id), i);
        i = i + 1;
    }
    var c: WgCfg = WgCfg {
        nb: nb, s0: Vec::new(), s1: Vec::new(), tkind: Vec::new(), tpos: Vec::new(), tcond: Vec::new(), rnum: Vec::new(), idom: Vec::new(), loop_head: Vec::new(), merge: Vec::new(), kid_first: Vec::new(), kid_next: Vec::new(), done: Vec::new(), ctx_kind: Vec::new(), ctx_blk: Vec::new(), ok: true,
    };
    // Terminators: the first Jump / Branch / Return / Unreachable / Switch
    // of a block (what follows it never runs)
    i = 0;
    while i < nb {
        var block: BasicBlock = func.blocks.get(i);
        var kind: i64 = WK_FALL;
        var pos: i64 = block.instructions.len();
        var sa: i64 = 0 - 1;
        var sb: i64 = 0 - 1;
        var cond: i64 = 0;
        var ii: i64 = 0;
        while ii < block.instructions.len() && kind == WK_FALL {
            match IrFunction_get_inst(func, block.instructions.get(ii)) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::Jump(t) => {
                            kind = WK_JUMP;
                            pos = ii;
                            sa = wg_cfg_index(bidx, t);
                            if sa < 0 {
                                c.ok = false;
                            }
                        }
                        Inst::Branch(cv, t, e) => {
                            kind = WK_BRANCH;
                            pos = ii;
                            cond = cv;
                            sa = wg_cfg_index(bidx, t);
                            sb = wg_cfg_index(bidx, e);
                            if sa < 0 || sb < 0 {
                                c.ok = false;
                            }
                        }
                        Inst::Return(_) => {
                            kind = WK_END;
                            pos = ii;
                        }
                        Inst::Unreachable => {
                            kind = WK_END;
                            pos = ii;
                        }
                        Inst::Switch(_, _, _, _) => {
                            kind = WK_END;
                            pos = ii;
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            ii = ii + 1;
        }
        if kind == WK_FALL {
            if i + 1 < nb {
                sa = i + 1;
            } else {
                kind = WK_RET0;
            }
        }
        c.s0.push(sa);
        c.s1.push(sb);
        c.tkind.push(kind);
        c.tpos.push(pos);
        c.tcond.push(cond);
        c.rnum.push(0 - 1);
        c.idom.push(0 - 1);
        c.loop_head.push(0);
        c.merge.push(0);
        c.kid_first.push(0 - 1);
        c.kid_next.push(0 - 1);
        c.done.push(0);
        i = i + 1;
    }
    if !c.ok || nb == 0 {
        c.ok = false;
        return c;
    }
    // Postorder from the entry, by an explicit stack (block, next successor)
    var state: Vec<i64> = Vec::new();
    i = 0;
    while i < nb {
        state.push(0);
        i = i + 1;
    }
    var order: Vec<i64> = Vec::new();
    var stk: Vec<i64> = Vec::new();
    var nxt: Vec<i64> = Vec::new();
    stk.push(0);
    nxt.push(0);
    state.set(0, 1);
    while stk.len() > 0 {
        var top: i64 = stk.get(stk.len() - 1);
        var e: i64 = nxt.get(nxt.len() - 1);
        if e < 2 {
            nxt.set(nxt.len() - 1, e + 1);
            var y: i64 = c.s0.get(top);
            if e == 1 {
                y = c.s1.get(top);
            }
            if y >= 0 && state.get(y) == 0 {
                state.set(y, 1);
                stk.push(y);
                nxt.push(0);
            }
        } else {
            order.push(top);
            stk.truncate(stk.len() - 1);
            nxt.truncate(nxt.len() - 1);
        }
    }
    var nr: i64 = order.len();
    i = 0;
    while i < nr {
        c.rnum.set(order.get(i), nr - 1 - i);
        i = i + 1;
    }
    // Predecessors of the reachable blocks, as offsets into one list
    var poff: Vec<i64> = Vec::new();
    i = 0;
    while i <= nb {
        poff.push(0);
        i = i + 1;
    }
    i = 0;
    while i < nb {
        if c.rnum.get(i) >= 0 {
            if c.s0.get(i) >= 0 {
                poff.set(c.s0.get(i) + 1, poff.get(c.s0.get(i) + 1) + 1);
            }
            if c.s1.get(i) >= 0 {
                poff.set(c.s1.get(i) + 1, poff.get(c.s1.get(i) + 1) + 1);
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < nb {
        poff.set(i + 1, poff.get(i + 1) + poff.get(i));
        i = i + 1;
    }
    var plist: Vec<i64> = Vec::new();
    var fill: Vec<i64> = Vec::new();
    i = 0;
    while i < nb {
        fill.push(poff.get(i));
        i = i + 1;
    }
    i = 0;
    while i < poff.get(nb) {
        plist.push(0);
        i = i + 1;
    }
    i = 0;
    while i < nb {
        if c.rnum.get(i) >= 0 {
            var wsi: i64 = 0;
            while wsi < 2 {
                var to: i64 = c.s0.get(i);
                if wsi == 1 {
                    to = c.s1.get(i);
                }
                if to >= 0 {
                    plist.set(fill.get(to), i);
                    fill.set(to, fill.get(to) + 1);
                }
                wsi = wsi + 1;
            }
        }
        i = i + 1;
    }
    // Immediate dominators, over reverse postorder after the entry
    c.idom.set(0, 0);
    var changed: bool = true;
    while changed {
        changed = false;
        var oi: i64 = nr - 2;
        while oi >= 0 {
            var bb: i64 = order.get(oi);
            var nd: i64 = 0 - 1;
            var pi: i64 = poff.get(bb);
            while pi < poff.get(bb + 1) {
                var p: i64 = plist.get(pi);
                if c.idom.get(p) >= 0 {
                    if nd < 0 {
                        nd = p;
                    } else {
                        nd = wg_cfg_isect(&c, p, nd);
                    }
                }
                pi = pi + 1;
            }
            if nd != c.idom.get(bb) {
                c.idom.set(bb, nd);
                changed = true;
            }
            oi = oi - 1;
        }
    }
    // Back edges (to a block not later in reverse postorder) make loop
    // headers and must go to a dominator of their source (or the CFG is
    // irreducible); forward edges count towards merge nodes. An edge is
    // counted once per successor slot: a Branch with both sides the same
    // block gives it two.
    var fwd: Vec<i64> = Vec::new();
    i = 0;
    while i < nb {
        fwd.push(0);
        i = i + 1;
    }
    i = 0;
    while i < nb {
        if c.rnum.get(i) >= 0 {
            var wk: i64 = 0;
            while wk < 2 {
                var t: i64 = c.s0.get(i);
                if wk == 1 {
                    t = c.s1.get(i);
                }
                if t >= 0 {
                    if c.rnum.get(t) <= c.rnum.get(i) {
                        c.loop_head.set(t, 1);
                        var x: i64 = i;
                        while x != t && x != 0 {
                            x = c.idom.get(x);
                        }
                        if x != t {
                            c.ok = false;
                        }
                    } else {
                        fwd.set(t, fwd.get(t) + 1);
                    }
                }
                wk = wk + 1;
            }
        }
        i = i + 1;
    }
    // Merge children: pushed to the front in increasing reverse postorder,
    // so each list starts with its latest
    var ri: i64 = nr - 2;
    while ri >= 0 {
        var yb: i64 = order.get(ri);
        if fwd.get(yb) >= 2 {
            c.merge.set(yb, 1);
            var xb: i64 = c.idom.get(yb);
            c.kid_next.set(yb, c.kid_first.get(xb));
            c.kid_first.set(xb, yb);
        }
        ri = ri - 1;
    }
    return c;
}

/// The nearest common dominator of reachable blocks a and b.
fn wg_cfg_isect(c: &WgCfg, a: i64, b: i64) -> i64 {
    var x: i64 = a;
    var y: i64 = b;
    while x != y {
        while c.rnum.get(x) > c.rnum.get(y) {
            x = c.idom.get(x);
        }
        while c.rnum.get(y) > c.rnum.get(x) {
            y = c.idom.get(y);
        }
    }
    return x;
}

fn wg_st_push(c: &mut WgCfg, kind: i64, blk: i64) {
    c.ctx_kind.push(kind);
    c.ctx_blk.push(blk);
}

fn wg_st_pop(c: &mut WgCfg) {
    c.ctx_kind.truncate(c.ctx_kind.len() - 1);
    c.ctx_blk.truncate(c.ctx_blk.len() - 1);
}

/// The depth of the innermost enclosing construct `kind` of block t, -2
/// when none encloses
fn wg_st_find(c: &WgCfg, kind: i64, t: i64) -> i64 {
    var n: i64 = c.ctx_kind.len();
    var i: i64 = n - 1;
    while i >= 0 {
        if c.ctx_kind.get(i) == kind && c.ctx_blk.get(i) == t {
            return n - 1 - i;
        }
        i = i - 1;
    }
    return 0 - 2;
}

/// How the edge s -> t is taken here: the depth of its `br` (to t's loop
/// for a back edge, to the block merge node t follows), -1 when t's tree is
/// written in place, -2 when neither applies (the function then keeps the
/// switch loop)
fn wg_st_depth(c: &WgCfg, s: i64, t: i64) -> i64 {
    if c.rnum.get(t) <= c.rnum.get(s) {
        return wg_st_find(c, WS_LOOP, t);
    }
    if c.merge.get(t) == 1 {
        return wg_st_find(c, WS_BLOCK, t);
    }
    if c.idom.get(t) != s || c.done.get(t) == 1 {
        return 0 - 2;
    }
    return 0 - 1;
}

/// Take the edge s -> t
fn wg_st_goto(g: &mut WasmGen, c: &mut WgCfg, s: i64, t: i64, func: &IrFunction, module: &IrModule) {
    var d: i64 = wg_st_depth(c, s, t);
    if d >= 0 {
        wbr(g, d);
    } else if d == 0 - 1 {
        wg_st_tree(g, c, t, func, module);
    } else {
        c.ok = false;
        w(g, 0x00);
    }
}

/// Block x and what it dominates: [loop] x's merge children's blocks
/// around x's code, each child's tree after its block [end]
fn wg_st_tree(g: &mut WasmGen, c: &mut WgCfg, x: i64, func: &IrFunction, module: &IrModule) {
    if !c.ok || c.done.get(x) == 1 {
        c.ok = false;
        w(g, 0x00);
        return;
    }
    c.done.set(x, 1);
    if c.loop_head.get(x) == 1 {
        w(g, 0x03);
        w(g, WT_VOID);
        wg_st_push(c, WS_LOOP, x);
        wg_st_within(g, c, x, c.kid_first.get(x), func, module);
        wend(g);
        wg_st_pop(c);
    } else {
        wg_st_within(g, c, x, c.kid_first.get(x), func, module);
    }
}

/// Merge child y of x (and the later ones in the list) around x's code
fn wg_st_within(g: &mut WasmGen, c: &mut WgCfg, x: i64, y: i64, func: &IrFunction, module: &IrModule) {
    if !c.ok {
        return;
    }
    if y >= 0 {
        w(g, 0x02);
        w(g, WT_VOID);
        wg_st_push(c, WS_BLOCK, y);
        wg_st_within(g, c, x, c.kid_next.get(y), func, module);
        wend(g);
        wg_st_pop(c);
        wg_st_tree(g, c, y, func, module);
        return;
    }
    wg_st_code(g, c, x, func, module);
}

/// Block x's instructions up to its terminator, then the terminator
fn wg_st_code(g: &mut WasmGen, c: &mut WgCfg, x: i64, func: &IrFunction, module: &IrModule) {
    var block: BasicBlock = func.blocks.get(x);
    var pos: i64 = c.tpos.get(x);
    var ii: i64 = 0;
    while ii < pos {
        var iid: i64 = block.instructions.get(ii);
        match IrFunction_get_inst(func, iid) {
            OptInst::Some(inst) => {
                g.extra = 0;
                wg_gen_inst(g, iid, inst, false, func, module);
            }
            OptInst::None => {
            }
        }
        ii = ii + 1;
    }
    g.extra = 0;
    var kind: i64 = c.tkind.get(x);
    if kind == WK_FALL || kind == WK_JUMP {
        wg_st_goto(g, c, x, c.s0.get(x), func, module);
    } else if kind == WK_BRANCH {
        var tb: i64 = c.s0.get(x);
        var eb: i64 = c.s1.get(x);
        var dt: i64 = wg_st_depth(c, x, tb);
        var de: i64 = wg_st_depth(c, x, eb);
        if dt >= 0 {
            // br_if to then's label, else on
            wget(g, c.tcond.get(x));
            wi64(g, 0);
            w(g, 0x52);
            w(g, 0x0D);
            wu(g, dt);
            wg_st_goto(g, c, x, eb, func, module);
        } else if de >= 0 {
            // br_if (cond == 0) to else's label, then on
            wget(g, c.tcond.get(x));
            w(g, 0x50);
            w(g, 0x0D);
            wu(g, de);
            wg_st_goto(g, c, x, tb, func, module);
        } else {
            wget(g, c.tcond.get(x));
            wi64(g, 0);
            w(g, 0x52);
            w(g, 0x04);
            w(g, WT_VOID);
            wg_st_push(c, WS_IF, 0 - 1);
            wg_st_goto(g, c, x, tb, func, module);
            welse(g);
            wg_st_goto(g, c, x, eb, func, module);
            wend(g);
            wg_st_pop(c);
        }
    } else if kind == WK_RET0 {
        // falling off the last block returns 0
        wi64(g, 0);
        wg_epilogue(g);
        w(g, 0x0F);
    } else {
        // Return, Unreachable, Switch: as the switch loop writes them
        var tid: i64 = block.instructions.get(pos);
        match IrFunction_get_inst(func, tid) {
            OptInst::Some(tinst) => {
                g.extra = 0;
                wg_gen_inst(g, tid, tinst, true, func, module);
            }
            OptInst::None => {
                w(g, 0x00);
            }
        }
    }
}

/// The body of IR function `func`: its locals, the frame, the blocks.
fn wg_gen_function(g: &mut WasmGen, name: str, func: &IrFunction, module: &IrModule) {
    g.cur_name = name;
    // The runtime's arithmetic wraps, as pe_ir's and nat_ir's does
    g.cur_wrapping = func.is_wrapping || is_pe_runtime_fn(name);
    g.unchecked = peir_unchecked_ops(func, func.value_metas.len() + func.insts.len() + 16);
    var maxid: i64 = 0;
    var i: i64 = 0;
    while i < func.value_metas.len() {
        maxid = wg_note_id(maxid, func.value_metas.get(i).id);
        i = i + 1;
    }
    i = 0;
    while i < func.insts.len() {
        maxid = wg_note_id(maxid, func.insts.get(i).id);
        i = i + 1;
    }
    i = 0;
    while i < func.params.len() {
        maxid = wg_note_id(maxid, func.params.get(i).id);
        i = i + 1;
    }
    var np: i64 = func.params.len();
    var local_of: Vec<i64> = Vec::new();
    var aoff: Vec<i64> = Vec::new();
    i = 0;
    while i <= maxid {
        local_of.push(np + i);
        aoff.push(0 - 1);
        i = i + 1;
    }
    i = 0;
    while i < np {
        local_of.set(func.params.get(i).id, i);
        i = i + 1;
    }
    var nloc: i64 = np + maxid + 1;
    g.t0 = nloc;
    g.t1 = nloc + 1;
    g.t2 = nloc + 2;
    g.t3 = nloc + 3;
    g.fp = nloc + 4;
    g.cur = nloc + 5;
    // The frame: every Alloca's data, then the varargs area of spawns
    var cur: i64 = 0;
    g.va_off = 0 - 1;
    i = 0;
    while i < func.insts.len() {
        var ve: ValueIdInst = func.insts.get(i);
        match ve.inst {
            Inst::Alloca(aty, _) => {
                var dsize: i64 = IrModule_type_size(module, aty);
                if dsize < 8 {
                    dsize = 8;
                }
                dsize = (dsize + 7) & (0 - 8);
                aoff.set(ve.id, cur);
                cur = cur + dsize;
            }
            Inst::Call(vname, _, _, _) => {
                if vname == "p_thread_spawn" || vname == "p_co_async" || vname == "p_executor_spawn" {
                    g.va_off = 0 - 2;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    if g.va_off == 0 - 2 {
        g.va_off = cur;
        cur = cur + 64;
    } else {
        g.va_off = 0 - 1;
    }
    g.frame = (cur + 15) & (0 - 16);
    g.local_of = local_of;
    g.alloca_off = aoff;

    g.b = Vec::new();
    // Locals: the i64s after the parameters, then the block index (i32)
    wu(g, 2);
    wu(g, nloc + 5 - np);
    w(g, WT_I64);
    wu(g, 1);
    w(g, WT_I32);
    // A function that may give control away (see "Tasks"): entered while
    // rewinding, its locals and resume point come back from the saved
    // frames (its frame is still there: the prologue does not run)
    g.as_here = false;
    g.as_fn = HashMap_contains(g.as_set, name) && func.blocks.len() > 0;
    var as_nl: i64 = nloc + 5;
    var as_size: i64 = as_nl * 8 + 8;
    if g.as_fn {
        wgget(g, WG_G_ST);
        wi64(g, 2);
        w(g, 0x51);
        wif(g);
        wgget(g, WG_G_PTR);
        wi64(g, as_size);
        w(g, 0x7D);
        wgset(g, WG_G_PTR);
        var rj: i64 = 0;
        while rj < as_nl {
            wgget(g, WG_G_PTR);
            wload(g, 8, false, rj * 8);
            wlset(g, rj);
            rj = rj + 1;
        }
        wgget(g, WG_G_PTR);
        wload(g, 8, false, as_nl * 8);
        wwrap(g);
        wlset(g, g.cur);
        welse(g);
    }
    // The frame: sp -= frame; below the running context's stack area (the
    // program's from WG_STACK_LO, a task's from the start of its stack):
    // "Stack overflow" (with the stack given back first, so the panic can
    // run)
    if g.frame > 0 {
        wgget(g, 0);
        wi64(g, g.frame);
        w(g, 0x7D);
        wltee(g, g.fp);
        wgset(g, 0);
        wlget(g, g.fp);
        wgget(g, WG_G_CUR);
        wload(g, 8, false, 0);
        w(g, 0x53);
        wif(g);
        wi64(g, WG_STACK_TOP);
        wgset(g, 0);
        wg_panic_msg(g, "Stack overflow");
        wendif(g);
    }
    if g.as_fn {
        wendif(g);
    }
    g.extra = 0;
    var nb: i64 = func.blocks.len();
    if nb == 0 {
        wi64(g, 0);
        wg_epilogue(g);
        wend(g);
        return;
    }
    // Structured control flow (TG16, "Structured control flow"); the
    // switch loop below when the CFG is irreducible, for a function that
    // may give control away, or with FID_WASM_SWITCH=1
    if g.as_fn {
        g.cf_task = g.cf_task + 1;
    } else if g.cf_switch_only {
        g.cf_forced = g.cf_forced + 1;
    } else {
        var st_mark: i64 = g.b.len();
        var cfg: WgCfg = wg_cfg_build(func);
        if cfg.ok {
            wg_st_tree(g, &mut cfg, 0, func, module);
        }
        if cfg.ok {
            // every path ended in a return, a br or a trap
            w(g, 0x00);
            wend(g);
            g.extra = 0;
            g.cf_struct = g.cf_struct + 1;
            return;
        }
        g.b.truncate(st_mark);
        g.extra = 0;
        g.cf_irred = g.cf_irred + 1;
    }
    // Segments of the switch loop: one per block, and in a function that
    // may give control away one more before each call that may (so that
    // a rewind can enter the code at that call). splits: per instruction
    // of the blocks in order, 0 for most, 1 for such a call that starts
    // its block, 2 for one that starts a segment of its own.
    var seg_first: Vec<i64> = Vec::new();
    var splits: Vec<i64> = Vec::new();
    var nseg: i64 = 0;
    var bi: i64 = 0;
    while bi < nb {
        seg_first.push(nseg);
        nseg = nseg + 1;
        var sblock: BasicBlock = func.blocks.get(bi);
        var si: i64 = 0;
        while si < sblock.instructions.len() {
            var sw: i64 = 0;
            if g.as_fn {
                match IrFunction_get_inst(func, sblock.instructions.get(si)) {
                    OptInst::Some(sinst) => {
                        if wg_as_inst(g, sinst) {
                            sw = 1;
                            if si > 0 {
                                sw = 2;
                                nseg = nseg + 1;
                            }
                        }
                    }
                    OptInst::None => {
                    }
                }
            }
            splits.push(sw);
            si = si + 1;
        }
        bi = bi + 1;
    }
    g.block_index = HashMap_new();
    bi = 0;
    while bi < nb {
        HashMap_insert(g.block_index, int_to_str(func.blocks.get(bi).id), seg_first.get(bi));
        bi = bi + 1;
    }
    g.nblocks = nseg;
    // [block $unwind] loop { seg_{N-1} { ... seg_0 { br_table } code_0 }
    // ... code_{N-1} }
    if g.as_fn {
        w(g, 0x02);
        w(g, WT_VOID);
    }
    w(g, 0x03);
    w(g, WT_VOID);
    bi = 0;
    while bi < nseg {
        w(g, 0x02);
        w(g, WT_VOID);
        bi = bi + 1;
    }
    wlget(g, g.cur);
    w(g, 0x0E);
    wu(g, nseg);
    bi = 0;
    while bi < nseg {
        wu(g, bi);
        bi = bi + 1;
    }
    wu(g, 0);
    wend(g);
    var at: i64 = 0;
    bi = 0;
    while bi < nb {
        var block: BasicBlock = func.blocks.get(bi);
        g.k = seg_first.get(bi);
        g.extra = 0;
        var ii: i64 = 0;
        var ninst: i64 = block.instructions.len();
        while ii < ninst {
            var split: i64 = splits.get(at);
            at = at + 1;
            if split == 2 {
                // the next segment: code_k falls through into it
                wend(g);
                g.k = g.k + 1;
                g.extra = 0;
            }
            var iid: i64 = block.instructions.get(ii);
            match IrFunction_get_inst(func, iid) {
                OptInst::Some(inst) => {
                    g.as_here = split != 0;
                    wg_gen_inst(g, iid, inst, ii == ninst - 1, func, module);
                    g.as_here = false;
                }
                OptInst::None => {
                }
            }
            ii = ii + 1;
        }
        wend(g);
        bi = bi + 1;
    }
    // Falling off the end returns 0
    wi64(g, 0);
    wg_epilogue(g);
    if g.as_fn {
        w(g, 0x0F);
        wend(g);
        // Unwinding ($unwind): the locals and the resume point (cur) onto
        // the saved frames; a context's frames reaching its stack is a
        // stack overflow
        wgget(g, WG_G_PTR);
        wi64(g, as_size);
        w(g, 0x7C);
        wgget(g, 0);
        w(g, 0x56);
        wif(g);
        wi64(g, 0);
        wgset(g, WG_G_ST);
        wg_panic_msg(g, "Stack overflow");
        wendif(g);
        var sj: i64 = 0;
        while sj < as_nl {
            wgget(g, WG_G_PTR);
            wwrap(g);
            wlget(g, sj);
            wstore(g, 8, sj * 8);
            sj = sj + 1;
        }
        wgget(g, WG_G_PTR);
        wwrap(g);
        wlget(g, g.cur);
        wextu(g);
        wstore(g, 8, as_nl * 8);
        wgget(g, WG_G_PTR);
        wi64(g, as_size);
        w(g, 0x7C);
        wgset(g, WG_G_PTR);
        wi64(g, 0);
        g.as_fn = false;
    }
    wend(g);
}

/// The body of primitive `name` (its parameters are locals 0..n)
fn wg_gen_primitive(g: &mut WasmGen, name: str) {
    g.cur_name = name;
    g.b = Vec::new();
    g.extra = 0;
    // Scratch locals after the parameters (every primitive takes fewer
    // than 8): i64s up to 9, f64s 10 and 11
    var np: i64 = wg_prim_params(name);
    wu(g, 2);
    wu(g, 10 - np);
    w(g, WT_I64);
    wu(g, 2);
    w(g, 0x7C);
    var x: i64 = 10;
    var t: i64 = 11;
    if name == "nat_syscall" {
        if wg_has_fn(g, "pe_wasi_syscall") {
            wi64(g, 0);
            var k: i64 = 0;
            while k < 7 {
                wlget(g, k);
                k = k + 1;
            }
            wg_call_named(g, "pe_wasi_syscall", 8);
        } else {
            wi64(g, 0 - 38);
        }
    } else if name == "nat_start_sp" {
        if wg_has_fn(g, "pe_wasi_start_sp") {
            wi64(g, 0);
            wg_call_named(g, "pe_wasi_start_sp", 1);
        } else {
            wi64(g, 0);
        }
    } else if name == "nat_atomic_load" {
        wlget(g, 0);
        wload(g, 8, false, 0);
    } else if name == "nat_atomic_store" {
        wlget(g, 0);
        wwrap(g);
        wlget(g, 1);
        wstore(g, 8, 0);
        wi64(g, 0);
    } else if name == "nat_atomic_add" {
        wlget(g, 0);
        wwrap(g);
        wlget(g, 0);
        wload(g, 8, false, 0);
        wlget(g, 1);
        w(g, 0x7C);
        wstore(g, 8, 0);
        wlget(g, 0);
        wload(g, 8, false, 0);
        wlget(g, 1);
        w(g, 0x7D);
    } else if name == "nat_atomic_cas" {
        wlget(g, 0);
        wload(g, 8, false, 0);
        wlget(g, 1);
        w(g, 0x51);
        wif_t(g, WT_I64);
        wlget(g, 0);
        wwrap(g);
        wlget(g, 2);
        wstore(g, 8, 0);
        wi64(g, 1);
        welse(g);
        wi64(g, 0);
        wendif(g);
    } else if name == "nat_ctx_swap" {
        // nat_ctx_swap(save, sp) (see "Tasks"): reached while rewinding,
        // the context it left is back: it returns. Else the running
        // context's record goes to [save], its stack pointer to the record,
        // and the WASM stack unwinds to _start, which enters `sp` (a new
        // task's record, nat_ctx_tramp at sp + 104, or a record stored
        // here before).
        wgget(g, WG_G_ST);
        wi64(g, 2);
        w(g, 0x51);
        wif(g);
        wi64(g, 0);
        wgset(g, WG_G_ST);
        wi64(g, 0);
        w(g, 0x0F);
        wendif(g);
        wlget(g, 0);
        wwrap(g);
        wgget(g, WG_G_CUR);
        wstore(g, 8, 0);
        wgget(g, WG_G_CUR);
        wwrap(g);
        wgget(g, 0);
        wstore(g, 8, 16);
        wlget(g, 1);
        wgset(g, WG_G_NEXT);
        // its frames are saved from the start of its area
        wgget(g, WG_G_CUR);
        wload(g, 8, false, 0);
        wgset(g, WG_G_PTR);
        wi64(g, 1);
        wgset(g, WG_G_ST);
        wi64(g, 0);
    } else if name == "nat_ctx_tramp" {
        wi64(g, WG_TRAMP);
    } else if name == "nat_clone_thread" {
        // nat_clone_thread(entry, arg, stack_top, ctid, tls) without
        // threads: entry(env 0, arg) runs now, to its end, with the new
        // thread's block as its thread pointer; then the 32-bit word at
        // ctid is zeroed, as the kernel does when a thread is gone. The
        // scheduler's workers (pe_worker_main, which never return) do not
        // start: tasks run on the thread that waits for them. A task switch
        // within the thread (see "Tasks") unwinds through here with the
        // starter's thread pointer (local 9) saved, and rewinds through
        // here.
        if wg_has_fn(g, "pe_worker_main") {
            wlget(g, 0);
            wi64(g, wg_table_ref(g, "pe_worker_main"));
            w(g, 0x51);
            wif(g);
            wi64(g, 0 - 38);
            w(g, 0x0F);
            wendif(g);
        }
        wgget(g, WG_G_ST);
        wi64(g, 2);
        w(g, 0x51);
        wif(g);
        wgget(g, WG_G_PTR);
        wi64(g, 8);
        w(g, 0x7D);
        wgset(g, WG_G_PTR);
        wgget(g, WG_G_PTR);
        wload(g, 8, false, 0);
        wlset(g, 9);
        welse(g);
        wgget(g, 1);
        wlset(g, 9);
        wendif(g);
        wlget(g, 4);
        wgset(g, 1);
        wi64(g, 0);
        wlget(g, 1);
        wlget(g, 0);
        wwrap(g);
        w(g, 0x11);
        wu(g, wg_type_n(g, 2));
        wu(g, 0);
        w(g, 0x1A);
        wgget(g, WG_G_ST);
        wwrap(g);
        wif(g);
        wgget(g, WG_G_PTR);
        wwrap(g);
        wlget(g, 9);
        wstore(g, 8, 0);
        wgget(g, WG_G_PTR);
        wi64(g, 8);
        w(g, 0x7C);
        wgset(g, WG_G_PTR);
        wi64(g, 0);
        w(g, 0x0F);
        wendif(g);
        wlget(g, 9);
        wgset(g, 1);
        wlget(g, 3);
        wwrap(g);
        wi64(g, 0);
        wstore(g, 4, 0);
        wi64(g, 1000);
    } else if name == "nat_wasm_zero" {
        wlget(g, 0);
        wwrap(g);
        wi32(g, 0);
        wlget(g, 1);
        wwrap(g);
        w(g, 0xFC);
        wu(g, 11);
        w(g, 0);
        wi64(g, 0);
    } else if name == "nat_call_fn" {
        // addr(env 0, argv[0..nargs])
        var k2: i64 = 0;
        while k2 <= 8 {
            wlget(g, 1);
            wi64(g, k2);
            w(g, 0x51);
            wif(g);
            wi64(g, 0);
            var j: i64 = 0;
            while j < k2 {
                wlget(g, 2);
                wload(g, 8, false, j * 8);
                j = j + 1;
            }
            wlget(g, 0);
            wwrap(g);
            w(g, 0x11);
            wu(g, wg_type_n(g, k2 + 1));
            wu(g, 0);
            w(g, 0x0F);
            wendif(g);
            k2 = k2 + 1;
        }
        w(g, 0x00);
        wi64(g, 0);
    } else if name == "nat_fn_table" {
        wgget(g, 2);
    } else if name == "nat_fn_names" {
        wgget(g, 3);
    } else if name == "nat_tls_get" {
        wgget(g, 1);
    } else if name == "nat_tls_set" {
        wlget(g, 0);
        wgset(g, 1);
        wi64(g, 0);
    } else if name == "nat_arch" {
        // The generic Linux layouts (struct stat): as AArch64
        wi64(g, 1);
    } else if name == "nat_fma" {
        wlget(g, 0);
        w(g, 0xBF);
        wlget(g, 1);
        w(g, 0xBF);
        w(g, 0xA2);
        wlget(g, 2);
        w(g, 0xBF);
        w(g, 0xA0);
        w(g, 0xBD);
    } else if name == "nat_wasm_grow" {
        wlget(g, 0);
        wwrap(g);
        w(g, 0x40);
        w(g, 0);
        wexts(g);
    } else if name == "nat_wasm_size" {
        w(g, 0x3F);
        w(g, 0);
        wextu(g);
    } else if name == "nat_c_round" {
        // half away from zero: t = trunc(x); |x - t| >= 0.5 -> t + sign(x)
        wlget(g, 0);
        w(g, 0xBF);
        wlset(g, x);
        wlget(g, x);
        w(g, 0x9D);
        wlset(g, t);
        wlget(g, x);
        wlget(g, t);
        w(g, 0xA1);
        w(g, 0x99);
        w(g, 0x44);
        wb_f64_half(&mut g.b);
        w(g, 0x66);
        wif_t(g, 0x7C);
        wlget(g, t);
        w(g, 0x44);
        wb_f64_one(&mut g.b);
        wlget(g, x);
        w(g, 0xA6);
        w(g, 0xA0);
        welse(g);
        wlget(g, t);
        wendif(g);
        w(g, 0xBD);
    } else if str_starts_with(name, "nat_c_") {
        wlget(g, 0);
        w(g, 0xBF);
        if name == "nat_c_sqrt" {
            w(g, 0x9F);
        }
        if name == "nat_c_fabs" {
            w(g, 0x99);
        }
        if name == "nat_c_floor" {
            w(g, 0x9C);
        }
        if name == "nat_c_ceil" {
            w(g, 0x9B);
        }
        if name == "nat_c_trunc" {
            w(g, 0x9D);
        }
        w(g, 0xBD);
    } else {
        // nat_ctx_tramp, nat_frame_*, nat_sig_handler, nat_sig_restorer,
        // nat_os (0: Linux)
        wi64(g, 0);
    }
    wend(g);
}

fn wb_f64_bits(out: &mut Vec<i64>, bits: i64) {
    var i: i64 = 0;
    while i < 8 {
        out.push((bits >> (i * 8)) & 0xFF);
        i = i + 1;
    }
}

fn wb_f64_half(out: &mut Vec<i64>) {
    wb_f64_bits(out, 4602678819172646912);
}

fn wb_f64_one(out: &mut Vec<i64>) {
    wb_f64_bits(out, 4607182418800017408);
}

/// _start: pe_rt_init, main(env 0), proc_exit(its result)
fn wg_gen_start(g: &mut WasmGen, exit_ix: i64) {
    g.cur_name = "_start";
    g.b = Vec::new();
    g.extra = 0;
    g.as_here = false;
    // Locals: 0 main's result, 1 the context to enter
    wu(g, 1);
    wu(g, 2);
    w(g, WT_I64);
    if wg_has_fn(g, "pe_rt_init") {
        wi64(g, 0);
        wg_call_named(g, "pe_rt_init", 1);
        w(g, 0x1A);
    }
    // The contexts' loop (see "Tasks"): run the running context's bottom
    // function, main(env 0) or a task's body [rec + 112](env 0, [rec +
    // 120]); when it comes back unwinding, enter the context nat_ctx_swap
    // named: a new task on its stack (below its record; its frames are
    // saved from the start of its stack area, [rec + 56]), a suspended
    // one by rewinding its frames
    w(g, 0x03);
    w(g, WT_VOID);
    wgget(g, WG_G_CUR);
    wi64(g, g.main_rec);
    w(g, 0x51);
    wif_t(g, WT_I64);
    wi64(g, 0);
    wg_call_named(g, "main", 1);
    welse(g);
    wi64(g, 0);
    wgget(g, WG_G_CUR);
    wload(g, 8, false, 120);
    wgget(g, WG_G_CUR);
    wload(g, 8, false, 112);
    wwrap(g);
    w(g, 0x11);
    wu(g, wg_type_n(g, 2));
    wu(g, 0);
    wendif(g);
    wlset(g, 0);
    wgget(g, WG_G_ST);
    wi64(g, 1);
    w(g, 0x51);
    wif(g);
    // where the context's saved frames end
    wgget(g, WG_G_CUR);
    wwrap(g);
    wgget(g, WG_G_PTR);
    wstore(g, 8, 8);
    wgget(g, WG_G_NEXT);
    wlset(g, 1);
    wlget(g, 1);
    wload(g, 8, false, 104);
    wi64(g, WG_TRAMP);
    w(g, 0x51);
    wif(g);
    wlget(g, 1);
    wwrap(g);
    wi64(g, 0);
    wstore(g, 8, 104);
    wlget(g, 1);
    wwrap(g);
    wlget(g, 1);
    wload(g, 8, false, 56);
    wstore(g, 8, 0);
    wlget(g, 1);
    wgset(g, 0);
    wi64(g, 0);
    wgset(g, WG_G_ST);
    welse(g);
    wlget(g, 1);
    wload(g, 8, false, 16);
    wgset(g, 0);
    wlget(g, 1);
    wload(g, 8, false, 8);
    wgset(g, WG_G_PTR);
    wi64(g, 2);
    wgset(g, WG_G_ST);
    wendif(g);
    wlget(g, 1);
    wgset(g, WG_G_CUR);
    // to the loop (the if is open)
    wbr(g, 1);
    wendif(g);
    wend(g);
    // A task's body never returns (pe_co_main leaves for good)
    wgget(g, WG_G_CUR);
    wi64(g, g.main_rec);
    w(g, 0x52);
    wif(g);
    w(g, 0x00);
    wendif(g);
    wlget(g, 0);
    if exit_ix >= 0 {
        wwrap(g);
        wcall(g, exit_ix);
    } else {
        w(g, 0x1A);
    }
    wend(g);
}

/// The dyn types: every type made into a dyn value or named by a trait
/// impl, sorted (as pe_ir and nat_ir find DynCall candidates).
fn wg_collect_dyn_types(g: &mut WasmGen, module: &IrModule) {
    var types: Vec<str> = Vec::new();
    var ti: i64 = 0;
    while ti < module.trait_impls.len() {
        var items: Vec<str> = module.trait_impls.get(ti).items;
        var ii: i64 = 0;
        while ii < items.len() {
            types = wg_insert_sorted(types, items.get(ii));
            ii = ii + 1;
        }
        ti = ti + 1;
    }
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var f: IrFunction = module.functions.get(fi).func;
        var k: i64 = 0;
        while k < f.insts.len() {
            match f.insts.get(k).inst {
                Inst::MakeDyn(_, tname, _) => {
                    types = wg_insert_sorted(types, tname);
                }
                _ => {
                }
            }
            k = k + 1;
        }
        fi = fi + 1;
    }
    g.dyn_types = types;
}

/// The values of the globals, the panic-trace table (empty: no frames to
/// walk here) and the table of functions named by strings.
fn wg_finish_data(g: &mut WasmGen, module: &IrModule) -> Vec<i64> {
    var gi: i64 = 0;
    while gi < g.globs.len() {
        var gname: str = g.globs.get(gi);
        var addr: i64 = HashMap_get(g.glob_addr, gname);
        var bits: i64 = 0;
        match IrModule_get_global(module, gname) {
            OptGlobalLookup::Some(gty, init_expr) => {
                match init_expr {
                    Expr::IntLit(v) => {
                        bits = v;
                    }
                    Expr::BoolLit(bv) => {
                        if bv {
                            bits = 1;
                        }
                    }
                    Expr::FloatLit(f) => {
                        if ir_type_eq(gty, IrType::F32) {
                            bits = p_f32_to_bits(f) & 0xFFFFFFFF;
                        } else {
                            bits = p_f64_to_bits(f);
                        }
                    }
                    Expr::StringLit(s) => {
                        bits = wg_str(g, s);
                    }
                    _ => {
                    }
                }
            }
            OptGlobalLookup::None => {
            }
        }
        wg_data_word(g, addr, bits);
        gi = gi + 1;
    }
    var out: Vec<i64> = Vec::new();
    wg_data_align(g);
    var names: i64 = WG_DATA_BASE + g.data.len();
    var z: i64 = 0;
    while z < 32 {
        g.data.push(0);
        z = z + 1;
    }
    out.push(names);
    // [name, table index] pairs, then 0, 0
    var ti: i64 = 0;
    var pairs: Vec<i64> = Vec::new();
    while ti < g.named_fns.len() {
        var fname: str = g.named_fns.get(ti);
        pairs.push(wg_str(g, fname));
        pairs.push(wg_table_ref(g, fname));
        ti = ti + 1;
    }
    wg_data_align(g);
    var table_addr: i64 = WG_DATA_BASE + g.data.len();
    var pi: i64 = 0;
    while pi < pairs.len() + 2 {
        var v: i64 = 0;
        if pi < pairs.len() {
            v = pairs.get(pi);
        }
        var bi: i64 = 0;
        while bi < 8 {
            g.data.push((v >> (bi * 8)) & 0xFF);
            bi = bi + 1;
        }
        pi = pi + 1;
    }
    out.push(table_addr);
    return out;
}

/// The type section's entry for signature key `key`
fn wb_functype(out: &mut Vec<i64>, key: str) {
    var gt: i64 = str_find(key, ">");
    out.push(0x60);
    wb_uleb(out, gt);
    var i: i64 = 0;
    while i < gt {
        if str_byte_at(key, i) == 105 {
            out.push(WT_I32);
        } else {
            out.push(WT_I64);
        }
        i = i + 1;
    }
    var nr: i64 = str_len(key) - gt - 1;
    wb_uleb(out, nr);
    i = gt + 1;
    while i < str_len(key) {
        if str_byte_at(key, i) == 105 {
            out.push(WT_I32);
        } else {
            out.push(WT_I64);
        }
        i = i + 1;
    }
}

fn wb_global_i64(out: &mut Vec<i64>, mutable: bool, v: i64) {
    out.push(WT_I64);
    if mutable {
        out.push(1);
    } else {
        out.push(0);
    }
    out.push(0x42);
    wb_sleb(out, v);
    out.push(0x0B);
}

/// FID_NAT_OFF lists "debug": no symbol names in the module (as nat_ir's
/// `ng_on("debug")`)
fn wg_debug_on() -> bool {
    var off: str = p_getenv("FID_NAT_OFF");
    if (off as i64) == 0 || str_len(off) == 0 {
        return true;
    }
    return !str_contains("," + off + ",", "," + "debug" + ",");
}

/// FID_WASM_SWITCH=1: every function keeps the switch loop (TG16: to
/// compare with the structured control flow)
fn wg_switch_only() -> bool {
    var v: str = p_getenv("FID_WASM_SWITCH");
    if (v as i64) == 0 || str_len(v) == 0 {
        return false;
    }
    return v == "1";
}

/// The "name" custom section (id 0) with its function-names subsection
/// (id 1): function index i is named names[i] (imports first, as indexed)
fn wb_name_section(out: &mut Vec<i64>, names: &Vec<str>) {
    var sub: Vec<i64> = Vec::new();
    wb_uleb(&mut sub, names.len());
    var i: i64 = 0;
    while i < names.len() {
        wb_uleb(&mut sub, i);
        wb_name(&mut sub, names.get(i));
        i = i + 1;
    }
    var contents: Vec<i64> = Vec::new();
    wb_name(&mut contents, "name");
    contents.push(1);
    wb_uleb(&mut contents, sub.len());
    wb_append(&mut contents, &sub);
    wb_section(out, 0, &contents);
}

// ─── Public entry points ───────────────────────────────────────────────

/// A WASI module from an IR module that has the Linux runtime and its
/// WASI layer (stdlib/linux_runtime/wasi.fd) merged in.
pub fn wasm_generate(module: IrModule) -> ResultBytes {
    if !pe_module_has_fn(&module, "main") {
        return ResultBytes::Err(c_vec1("wasm backend: the program has no `main` function"));
    }
    var g: WasmGen = WasmGen_new();
    g.cf_switch_only = wg_switch_only();
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var fe: IrFunctionEntry = module.functions.get(fi);
        HashMap_insert(g.all_fns, fe.name, fe.func.params.len() + 1);
        fi = fi + 1;
    }
    if !wg_has_fn(&g, "pe_wasi_syscall") {
        return ResultBytes::Err(c_vec1("wasm backend: the WASI layer of the runtime (stdlib/linux_runtime/wasi.fd) is not merged"));
    }
    wg_collect_dyn_types(&mut g, &module);
    // extern "C" functions; the WASI ones are imports, proc_exit always
    var ei: i64 = 0;
    while ei < module.extern_decls.len() {
        var ext: ExternDecl = module.extern_decls.get(ei);
        if !HashMap_contains(g.c_names, ext.pledge_name) {
            g.c_list.push(ext.c_name);
            HashMap_insert(g.c_names, ext.pledge_name, g.c_list.len());
        }
        if str_starts_with(ext.c_name, "wasi_") && !HashMap_contains(g.imp_index, ext.c_name) {
            var wname: str = str_slice(ext.c_name, 5, str_len(ext.c_name));
            var sig: str = wg_wasi_sig(wname);
            if sig != "" {
                g.imp_names.push(wname);
                g.imp_sigs.push(sig);
                HashMap_insert(g.imp_index, ext.c_name, g.imp_names.len());
            }
        }
        ei = ei + 1;
    }
    if !HashMap_contains(g.imp_index, "wasi_proc_exit") {
        g.imp_names.push("proc_exit");
        g.imp_sigs.push("i>");
        HashMap_insert(g.imp_index, "wasi_proc_exit", g.imp_names.len());
    }
    g.n_imports = g.imp_names.len();
    // Stack switching (see "Tasks"): the functions that may give control
    // away, and the running program's context record (its frames are
    // saved from the bottom of the stack up)
    wg_as_analyze(&mut g, &module);
    wg_data_align(&mut g);
    g.main_rec = WG_DATA_BASE + g.data.len();
    var mr: i64 = 0;
    while mr < 128 {
        g.data.push(0);
        mr = mr + 1;
    }
    wg_data_word(&mut g, g.main_rec, WG_STACK_LO);
    var imp_types: Vec<i64> = Vec::new();
    var ii: i64 = 0;
    while ii < g.imp_names.len() {
        imp_types.push(wg_type(&mut g, g.imp_sigs.get(ii)));
        ii = ii + 1;
    }
    // _start is the first function defined
    var start_type: i64 = wg_type(&mut g, ">");
    HashMap_insert(g.fn_index, "_start", g.n_imports);
    g.def_types.push(start_type);
    var code: Vec<i64> = Vec::new();
    var nbodies: i64 = 0;
    wg_gen_start(&mut g, HashMap_get(g.imp_index, "wasi_proc_exit") - 1);
    wb_uleb(&mut code, g.b.len());
    wb_append(&mut code, &g.b);
    nbodies = nbodies + 1;
    // Compile what _start reaches, as calls are met
    var qi: i64 = 0;
    while qi < g.queue.len() {
        var name: str = g.queue.get(qi);
        if wg_has_fn(&g, name) {
            match IrModule_get_function(&module, name) {
                OptIrFunction::Some(func) => {
                    wg_gen_function(&mut g, name, &func, &module);
                }
                OptIrFunction::None => {
                    g.b = Vec::new();
                    wu(&mut g, 0);
                    w(&mut g, 0x00);
                    wend(&mut g);
                }
            }
        } else {
            wg_gen_primitive(&mut g, name);
        }
        wb_uleb(&mut code, g.b.len());
        wb_append(&mut code, &g.b);
        nbodies = nbodies + 1;
        qi = qi + 1;
    }
    var tabs: Vec<i64> = wg_finish_data(&mut g, &module);
    // The panic trace table and the named-function table may queue no
    // functions (their entries were queued when named)
    if g.unresolved.len() > 0 {
        return ResultBytes::Err(c_vec1("wasm backend: not available in WebAssembly yet: " + str_join(g.unresolved, ", ") + " (build with `fid ccompile --target wasm32-wasi` instead)"));
    }
    if nbodies != g.def_types.len() {
        return ResultBytes::Err(c_vec1("wasm backend: internal error: " + int_to_str(nbodies) + " bodies for " + int_to_str(g.def_types.len()) + " functions"));
    }

    var m: Vec<i64> = Vec::new();
    m.push(0);
    m.push(0x61);
    m.push(0x73);
    m.push(0x6D);
    m.push(1);
    m.push(0);
    m.push(0);
    m.push(0);
    // Types
    var sec: Vec<i64> = Vec::new();
    wb_uleb(&mut sec, g.type_keys.len());
    var ti: i64 = 0;
    while ti < g.type_keys.len() {
        wb_functype(&mut sec, g.type_keys.get(ti));
        ti = ti + 1;
    }
    wb_section(&mut m, SEC_TYPE, &sec);
    // Imports
    sec = Vec::new();
    wb_uleb(&mut sec, g.n_imports);
    ii = 0;
    while ii < g.n_imports {
        wb_name(&mut sec, "wasi_snapshot_preview1");
        wb_name(&mut sec, g.imp_names.get(ii));
        sec.push(0x00);
        wb_uleb(&mut sec, imp_types.get(ii));
        ii = ii + 1;
    }
    wb_section(&mut m, SEC_IMPORT, &sec);
    // Functions
    sec = Vec::new();
    wb_uleb(&mut sec, g.def_types.len());
    var di: i64 = 0;
    while di < g.def_types.len() {
        wb_uleb(&mut sec, g.def_types.get(di));
        di = di + 1;
    }
    wb_section(&mut m, SEC_FUNCTION, &sec);
    // Table (funcref; index 0 is null)
    sec = Vec::new();
    wb_uleb(&mut sec, 1);
    sec.push(0x70);
    sec.push(0x00);
    wb_uleb(&mut sec, g.table.len() + 1);
    wb_section(&mut m, SEC_TABLE, &sec);
    // Memory: the stack, the data, a page to spare
    var data_end: i64 = WG_DATA_BASE + g.data.len();
    var pages: i64 = (data_end + 65535) / 65536 + 1;
    sec = Vec::new();
    wb_uleb(&mut sec, 1);
    sec.push(0x00);
    wb_uleb(&mut sec, pages);
    wb_section(&mut m, SEC_MEMORY, &sec);
    // Globals: 0 the stack pointer, 1 the thread block, 2 the named
    // functions' table, 3 the panic-trace table; stack switching's 4 the
    // state, 5 the end of the saved frames, 6 the running context, 7 the
    // context to enter
    sec = Vec::new();
    wb_uleb(&mut sec, 8);
    wb_global_i64(&mut sec, true, WG_STACK_TOP);
    wb_global_i64(&mut sec, true, 0);
    wb_global_i64(&mut sec, false, tabs.get(1));
    wb_global_i64(&mut sec, false, tabs.get(0));
    wb_global_i64(&mut sec, true, 0);
    wb_global_i64(&mut sec, true, 0);
    wb_global_i64(&mut sec, true, g.main_rec);
    wb_global_i64(&mut sec, true, 0);
    wb_section(&mut m, SEC_GLOBAL, &sec);
    // Exports
    sec = Vec::new();
    wb_uleb(&mut sec, 2);
    wb_name(&mut sec, "memory");
    sec.push(0x02);
    wb_uleb(&mut sec, 0);
    wb_name(&mut sec, "_start");
    sec.push(0x00);
    wb_uleb(&mut sec, g.n_imports);
    wb_section(&mut m, SEC_EXPORT, &sec);
    // Elements: the table from index 1
    if g.table.len() > 0 {
        sec = Vec::new();
        wb_uleb(&mut sec, 1);
        sec.push(0x00);
        sec.push(0x41);
        sec.push(0x01);
        sec.push(0x0B);
        wb_uleb(&mut sec, g.table.len());
        var tj: i64 = 0;
        while tj < g.table.len() {
            wb_uleb(&mut sec, g.table.get(tj));
            tj = tj + 1;
        }
        wb_section(&mut m, SEC_ELEM, &sec);
    }
    // Code
    sec = Vec::new();
    wb_uleb(&mut sec, nbodies);
    wb_append(&mut sec, &code);
    wb_section(&mut m, SEC_CODE, &sec);
    // Data: one segment at WG_DATA_BASE
    sec = Vec::new();
    wb_uleb(&mut sec, 1);
    sec.push(0x00);
    sec.push(0x41);
    wb_sleb(&mut sec, WG_DATA_BASE);
    sec.push(0x0B);
    wb_uleb(&mut sec, g.data.len());
    wb_append(&mut sec, &g.data);
    wb_section(&mut m, SEC_DATA, &sec);
    // The "name" custom section (DB10): every function's name, for
    // wasm-objdump, wasm-tools, Node's traces; FID_NAT_OFF=debug leaves it out
    if wg_debug_on() {
        var fnames: Vec<str> = Vec::new();
        ii = 0;
        while ii < g.n_imports {
            fnames.push(g.imp_names.get(ii));
            ii = ii + 1;
        }
        fnames.push("_start");
        qi = 0;
        while qi < g.queue.len() {
            fnames.push(g.queue.get(qi));
            qi = qi + 1;
        }
        wb_name_section(&mut m, &fnames);
    }
    p_eprint_str("[wasm] " + int_to_str(nbodies) + " functions, " + int_to_str(g.data.len()) + " bytes of data, " + int_to_str(m.len()) + " bytes\n");
    p_eprint_str("[wasm] control flow: " + int_to_str(g.cf_struct) + " structured, " + int_to_str(g.cf_task + g.cf_irred + g.cf_forced) + " switch loops (" + int_to_str(g.cf_task) + " tasks, " + int_to_str(g.cf_irred) + " irreducible, " + int_to_str(g.cf_forced) + " FID_WASM_SWITCH)\n");
    return ResultBytes::Ok(m);
}

/// Lower an IR module to a WASM binary (empty when it cannot be built).
pub fn generate_wasm(module: IrModule) -> Vec<i64> {
    match wasm_generate(module) {
        ResultBytes::Ok(bytes) => {
            return bytes;
        }
        ResultBytes::Err(_) => {
        }
    }
    return Vec::new();
}

/// A listing of a WASM binary's sections and the module's functions
/// (`fid wasm --wat`; not WAT text).
pub fn dump_wat(module: IrModule) -> str {
    var names: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < module.functions.len() {
        names.push(module.functions.get(fi).name);
        fi = fi + 1;
    }
    var bytes: Vec<i64> = generate_wasm(module);
    var out: str = "; WASM module (" + int_to_str(bytes.len()) + " bytes)\n";
    var sec_names: Vec<str> = Vec::new();
    sec_names.push("custom");
    sec_names.push("type");
    sec_names.push("import");
    sec_names.push("function");
    sec_names.push("table");
    sec_names.push("memory");
    sec_names.push("global");
    sec_names.push("export");
    sec_names.push("start");
    sec_names.push("element");
    sec_names.push("code");
    sec_names.push("data");
    sec_names.push("datacount");
    var i: i64 = 8;
    while i < bytes.len() {
        var id: i64 = bytes.get(i);
        i = i + 1;
        var size: i64 = 0;
        var shift: i64 = 0;
        while i < bytes.len() {
            var b: i64 = bytes.get(i);
            i = i + 1;
            size = size | ((b & 0x7F) << shift);
            shift = shift + 7;
            if (b & 0x80) == 0 {
                break;
            }
        }
        var name: str = "?";
        if id >= 0 && id < sec_names.len() {
            name = sec_names.get(id);
        }
        out = out + "; section " + int_to_str(id) + " (" + name + ") size=" + int_to_str(size) + "\n";
        i = i + size;
    }
    out = out + ";\n; Functions of the module:\n";
    fi = 0;
    while fi < names.len() {
        out = out + ";   " + names.get(fi) + "\n";
        fi = fi + 1;
    }
    return out;
}
