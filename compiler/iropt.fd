// compiler/iropt.fd — IR optimizations run before native code generation
// (release D5, D6).
//
// The native Windows backend (compiler/pe_ir*.fd) turns IR straight into
// machine code, with no optimizer in between; these passes give it one:
//   - inlining of small functions: a call to a function of one block made of
//     plain instructions (no calls, no prints, no regions) is replaced by a
//     copy of that block; the call becomes a move of the copied result
//   - constant folding of integer arithmetic and comparisons whose operands
//     are both constants, when the result cannot overflow
//   - removal of constants and other pure values nothing reads
//   - global value numbering (OP7): a pure computation a dominating block
//     already did is reused
//   - self tail calls into jumps (OP13)
//   - loop-invariant code motion (competitive OP9, OP26): a read of a local
//     the loop never stores, `v.len()` of a Vec the loop cannot resize, and
//     pure operations on such values move to the block before the loop;
//     from the loop's header also arithmetic that may panic and calls to
//     functions with no effect but a panic (OP25), when nothing a program
//     could see comes before them there
//   - the mid-end of docs/roadmap/llvm-roadmap.md Track ME, on use lists
//     (ME1, iro_uses): branches on constants become jumps (ME14), stores to
//     a local nobody reads again are dropped and DCE removes more pure values
//     (ME15), constants are reassociated and multiplication, division and
//     remainder by powers of two become shifts and masks where no overflow
//     or zero check is lost (ME12)
// Every pass leaves the program's meaning as it was; when in doubt it does
// nothing.

module compiler::iropt;
use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::checks;
use compiler::pe_ir_stubs;
use compiler::iropt_me;
use compiler::ssa;
use compiler::tv;
use compiler::ast_ser;
use compiler::ir_ser;
use compiler::pgo;
/// Largest callee (instructions, its return included) that is inlined.
const IRO_INLINE_MAX: i64 = 16;
/// SP2: per-pass times of the last iropt_native for the --time table
/// (compiler.fd time_mark adds them under its "iropt" row).
pub var g_iro_time_on: bool = false;
var g_iro_pass_names: Vec<str> = Vec::new();
var g_iro_pass_ms: Vec<i64> = Vec::new();

/// Keep iropt's per-pass times for the --time table.
pub fn iropt_set_time_on() {
    g_iro_time_on = true;
}

/// The passes timed by the last iropt_native (with --time), in run order.
pub fn iropt_pass_time_names() -> Vec<str> {
    return g_iro_pass_names;
}

/// Their milliseconds, in the same order.
pub fn iropt_pass_time_ms() -> Vec<i64> {
    return g_iro_pass_ms;
}

/// Run every pass on `module` (the pass manager: see iro_pass_on).
pub fn iropt_native(module: &mut IrModule) {
    var stats: bool = iro_stats_on();
    // SP2: the per-pass times are also kept for the --time table
    // (g_iro_time_on, set by compiler.fd set_time_on)
    var timing: bool = stats || g_iro_time_on;
    g_iro_pass_names = Vec::new();
    g_iro_pass_ms = Vec::new();
    if g_iro_remarks_on {
        g_iro_remarks = Vec::new();
    }
    var t_start: i64 = 0;
    if stats {
        t_start = p_clock_now_ms();
    }
    // ME5: per-pass timing, summed over the functions; module passes are
    // timed too (iro_time_note)
    var tp_names: Vec<str> = Vec::new();
    var tp_ms: Vec<i64> = Vec::new();
    var tp_hits: Vec<i64> = Vec::new();
    var tm0: i64 = 0;
    var on_cdev: bool = iro_pass_on("closuredevirt");
    // SP3: the module passes before the per-function loop work on what
    // main reaches (iro_mid_reach; 0: every function, without main or with
    // FID_IROPT_OFF=midreach). The clones hofspec and dynspec add (called
    // from functions of the set) join it before inlining.
    var tm_r: i64 = iro_clock(timing);
    var reach0: i64 = iro_mid_reach(module);
    var nfn0: i64 = module.functions.len();
    iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "midreach", timing, tm_r);
    // LG5/LG6: resolve closure-env CallPtrs to direct Calls before the
    // inliner runs so the tiny closures flatten like any other call.
    if on_cdev {
        tm0 = iro_clock(timing);
        ime_trace("closuredevirt", "-");
        var cfi: i64 = 0;
        while cfi < module.functions.len() {
            var cent: IrFunctionEntry = module.functions.get(cfi);
            if !iro_in_reach(reach0, cent.name) {
                cfi = cfi + 1;
                continue;
            }
            var cfn: IrFunction = cent.func;
            if iro_closure_devirt(module, &mut cfn) {
                cent.func = cfn;
                module.functions.set(cfi, cent);
            }
            cfi = cfi + 1;
        }
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "closuredevirt", timing, tm0);
    }
    // LG5: clone higher-order fns per known closure env so their inner
    // CallPtr dispatch becomes a direct Call — inlinable below.
    var n_hof: i64 = 0;
    if iro_pass_on("hofspec") {
        tm0 = iro_clock(timing);
        ime_trace("hofspec", "-");
        // VF6: with --validate every module pass is checked (compiler/tv.fd
        // tv_mod_after) and undone as a whole when a function is rejected
        var tvm_hof: TvMod = tv_mod_before(module);
        n_hof = iro_hof_specialize_in(module, reach0);
        if !tv_mod_after("hofspec", &tvm_hof, module) {
            n_hof = 0;
        }
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "hofspec", timing, tm0);
    }
    // OP14: clone a function per concrete type of a `dyn` argument whose
    // trait calls it makes on that parameter (they become direct calls,
    // inlinable below); FID_IROPT_OFF=dynspec
    var n_dspec: i64 = 0;
    if iro_pass_on("dynspec") {
        tm0 = iro_clock(timing);
        ime_trace("dynspec", "-");
        n_dspec = iro_dyn_specialize(module);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "dynspec", timing, tm0);
    }
    // OP14: a trait call or closure call on a value read from a struct
    // field every store of which stores one dyn type / one closure target
    // becomes a direct call (inlinable below); FID_IROPT_OFF=fielddevirt
    var n_fdv: Vec<i64> = Vec::new();
    n_fdv.push(0);
    n_fdv.push(0);
    if iro_pass_on("fielddevirt") {
        tm0 = iro_clock(timing);
        ime_trace("fielddevirt", "-");
        iro_field_devirt(module, &mut n_fdv);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "fielddevirt", timing, tm0);
    }
    // LF16, LF14 (opt-in: FID_IROPT_ON=soleown, vecsroa; iro_vec_locals):
    // vec_own on a Vec nothing shares goes, a small local Vec of words
    // becomes stack slots; before inlining, while core's Vec calls are calls
    var on_soleown: bool = iro_pass_on("soleown") && ime_on("soleown");
    var on_vecsroa: bool = iro_pass_on("vecsroa") && ime_on("vecsroa");
    if on_soleown || on_vecsroa {
        tm0 = iro_clock(timing);
        ime_trace("vecsroa", "-");
        iro_vec_locals(module, on_soleown, on_vecsroa);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "vecsroa", timing, tm0);
    }
    // SP3: functions added since reach0 was computed (hofspec's and
    // dynspec's clones) are inlined into like the functions they copy
    if reach0 != 0 {
        var nfi: i64 = nfn0;
        while nfi < module.functions.len() {
            HashMap_insert(reach0, module.functions.get(nfi).name, 1);
            nfi = nfi + 1;
        }
    }
    if iro_pass_on("inline") {
        tm0 = iro_clock(timing);
        ime_trace("inline", "-");
        var tvm_inl: TvMod = tv_mod_before(module);
        // SP3: only into functions main reaches (and hofspec's clones)
        iro_inline_in(module, reach0);
        var _tv_inl: bool = tv_mod_after("inline", &tvm_inl, module);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "inline", timing, tm0);
    }
    // ME20, ME21: inlining across functions, bottom-up, only into functions
    // main reaches (on by default since OP5: iropt_me.fd IME_DEFAULT_ON;
    // FID_IROPT_OFF=inline2)
    if ime_on("inline2") {
        tm0 = iro_clock(timing);
        ime_trace("inline2", "-");
        var tvm_inl2: TvMod = tv_mod_before(module);
        ime_inline_reached(module, iro_inline_reach(module));
        var _tv_inl2: bool = tv_mod_after("inline2", &tvm_inl2, module);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "inline2", timing, tm0);
    } else if ime_on("inlineclo") {
        // WP16: inline2's once-called rule for closures only, when inline2
        // is off (on by default since Nov 17: iropt_me.fd IME_DEFAULT_ON;
        // FID_IROPT_OFF=inlineclo; tests/tooling/inlineclo-check.sh)
        tm0 = iro_clock(timing);
        ime_trace("inlineclo", "-");
        var tvm_clo: TvMod = tv_mod_before(module);
        ime_inline_closures(module);
        var _tv_clo: bool = tv_mod_after("inlineclo", &tvm_clo, module);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "inlineclo", timing, tm0);
    }
    var n_fold: i64 = 0;
    var n_spec: i64 = 0;
    var n_dce: i64 = 0;
    var n_tail: i64 = 0;
    var n_gvn: i64 = 0;
    var n_licm: i64 = 0;
    var n_iv: i64 = 0;
    var on_fold: bool = iro_pass_on("fold");
    var on_dce: bool = iro_pass_on("dce");
    var on_tail: bool = IRO_TAILCALL && iro_pass_on("tailcall");
    var on_gvn: bool = IRO_GVN && iro_pass_on("gvn");
    var on_licm: bool = IRO_LICM && iro_pass_on("licm");
    var on_iv: bool = IRO_IV && iro_pass_on("iv");
    var on_version: bool = iro_pass_on("version") && ime_on("version");
    var n_ver: i64 = 0;
    // ME23: loop rotation on the IR (iropt_me.fd ime_rotate), last on each
    // function; opt-in (FID_IROPT_ON=rotate) until a suite run agrees
    var on_rotate: bool = iro_pass_on("rotate") && ime_on("rotate");
    var n_rot: i64 = 0;
    // ME12/ME14/ME15 of the first mid-end batch are opt-in (FID_IROPT_ON)
    // until the suite agrees with them on and off
    var on_branch: bool = iro_pass_on("branchfold") && ime_on("branchfold");
    var on_facts: bool = iro_pass_on("branchfacts");
    var on_sccp: bool = iro_pass_on("sccp");
    var on_promote: bool = iro_pass_on("promote");
    // ME3 (Nov 17): promote is retired where ssa runs (compiler/ssa.fd
    // subsumes it); see iro_promote_here
    var on_ssa_me: bool = ime_on("ssa");
    var promote_named: bool = ime_on("promote");
    // WP13 stays opt-in (FID_IROPT_ON) until the suite agrees with it on and
    // off: iro_ipcp miscompiled &mut Vec + loop programs (only Inst::Call
    // sites are counted; DynCall/CallPtr can reach callees unseen).
    // WP7 (envtrim) was opt-in: it changes calling conventions, and a
    // caller it missed still passed the env slot (test_brotli's bs_fill got
    // its `s` as 0, Nov 9). The paths found since: HashMap_to_str (Nov 16),
    // core's vec_buf_alloc called by name from nat_ir's vector loops and
    // functions named by the module's data (Nov 17; iro_conv_pinned,
    // ir_dfe_root). Nov 17, with the compiler of Nov 16: test_brotli
    // emitted with envtrim on and off, through pe_ir and --nat, prints the
    // same. On by default since Nov 17; FID_IROPT_OFF=envtrim turns it off
    // (tests/tooling/wp-defaults-check.sh runs the suite both ways).
    var on_envtrim: bool = iro_pass_on("envtrim");
    var n_envtrim: i64 = 0;
    var on_ipcp: bool = iro_pass_on("ipcp") && ime_on("ipcp");
    // WP14 (spec) on by default since Nov 17: only hot values are cloned
    // (iro_call_weights), each clone checked by tv_spec_witness under
    // --validate; FID_IROPT_OFF=spec turns it off.
    var on_spec: bool = iro_pass_on("spec");
    var on_devirt: bool = iro_pass_on("devirt");
    var on_gconst: bool = iro_pass_on("gconst");
    // OP8: on by default since Nov 15 (41 programs of the suite emitted with
    // it on and off: same output and exit status; FID_IROPT_OFF=dse)
    var on_dse: bool = iro_pass_on("dse");
    var on_simplify: bool = iro_pass_on("simplify") && ime_on("simplify");
    var n_cdev: i64 = 0;
    var n_branch: i64 = 0;
    var n_facts: i64 = 0;
    var n_sccp: i64 = 0;
    var n_promote: i64 = 0;
    var n_ipcp: i64 = 0;
    var n_devirt: i64 = 0;
    var n_gconst: i64 = 0;
    var n_dse: i64 = 0;
    var n_simp: i64 = 0;
    var insts_before: i64 = 0;
    var insts_after: i64 = 0;
    // Only what main reaches is worth optimizing (CS1); a function the
    // native backend generates on demand is correct without it
    var reach: i64 = HashMap_new();
    var has_main: bool = false;
    var ri: i64 = 0;
    while ri < module.functions.len() {
        if module.functions.get(ri).name == "main" {
            has_main = true;
        }
        ri = ri + 1;
    }
    if has_main {
        var rl: Vec<str> = pe_ir_reachable_functions(module);
        ri = 0;
        while ri < rl.len() {
            HashMap_insert(reach, rl.get(ri), 1);
            ri = ri + 1;
        }
    }
    // SP3: the module passes below (gconst's folding, the effect masks,
    // the quiet functions) work on `reach` too, with spec's clones; 0
    // (every function) without main or with FID_IROPT_OFF=midreach
    var mid_reach: i64 = 0;
    if has_main && reach0 != 0 {
        mid_reach = reach;
    }
    // WP6: the internal-convention flag is set before cloning so
    // specialized copies inherit it; it is signature-independent.
    if has_main {
        iro_conv_mark(module);
    }
    // WP7: unused __env parameters (and their call-site arguments) are
    // dropped before IPCP/specialization see the call signatures.
    if has_main && on_envtrim {
        tm0 = iro_clock(timing);
        ime_trace("envtrim", "-");
        n_envtrim = iro_env_trim(module);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "envtrim", timing, tm0);
    }
    // WP13: constants from the call sites move into the callees first, so the
    // per-function passes below see them.
    if has_main && on_ipcp {
        tm0 = iro_clock(timing);
        ime_trace("ipcp", "-");
        var tvm_ipcp: TvMod = tv_mod_before(module);
        n_ipcp = iro_ipcp(module);
        if !tv_mod_after("ipcp", &tvm_ipcp, module) {
            n_ipcp = 0;
        }
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "ipcp", timing, tm0);
    }
    // WP14: mixed constant/varying parameters get specialized clones.
    if has_main && on_spec {
        tm0 = iro_clock(timing);
        ime_trace("spec", "-");
        var tvm_spec: TvMod = tv_mod_before(module);
        // Nov 17: only the call sites of functions main reaches count, and
        // the clones join `reach`, so the per-function passes below fold
        // the constant into them (before, they were skipped as unreached:
        // spec cloned but changed no instruction)
        n_spec = iro_specialize(module, reach);
        if !tv_mod_after("spec", &tvm_spec, module) {
            n_spec = 0;
        }
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "spec", timing, tm0);
    }
    // WP18: never-written globals fold to their initializer.
    if has_main && on_gconst {
        tm0 = iro_clock(timing);
        ime_trace("gconst", "-");
        var tvm_gc: TvMod = tv_mod_before(module);
        n_gconst = iro_const_globals_in(module, mid_reach);
        if !tv_mod_after("gconst", &tvm_gc, module) {
            n_gconst = 0;
        }
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "gconst", timing, tm0);
    }
    // LF10 (checks.fd peir_note_param_ranges, opt-in: FID_IROPT_ON=
    // paramrange): an internal function's i64 parameters start at the
    // range every call gives them, and a call to one returning i64 the
    // range of its returns (FID_IROPT_OFF=retrange: not these), in the
    // range analysis of the passes below and of the backend. After the
    // passes that change signatures
    // (envtrim, ipcp, spec); a fact is used only while the parameter list
    // it was found for is unchanged.
    peir_prm_clear();
    if has_main && peir_prm_wanted() {
        tm0 = iro_clock(timing);
        ime_trace("paramrange", "-");
        peir_note_param_ranges(module);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "paramrange", timing, tm0);
    }
    // OP25: what each function does, transitively, so LICM can move a call
    // that does nothing but compute (and maybe panic) out of a loop's
    // header. Computed once: the passes below only remove effects, so the
    // masks stay a safe over-estimate. Without main (no whole program) no
    // call moves; FID_IROPT_OFF=licmcall keeps calls where they are.
    var licm_masks: Vec<i64> = Vec::new();
    if has_main && on_licm && iro_pass_on("licmcall") {
        tm0 = iro_clock(timing);
        ime_trace("licmcall", "-");
        licm_masks = iro_effect_masks_in(module, mid_reach);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "licmcall", timing, tm0);
    }
    // OP25 (Nov 16; on by default since Nov 17, FID_IROPT_OFF=quietcall):
    // the functions every call of which ends without a panic (no loop, no
    // recursion, nothing that can trap: iro_quiet_fns). An unused call to
    // one that writes nothing goes (iro_dead_calls), and LICM moves a call
    // to one that touches no memory out of any block of a loop, not only
    // its header. tests/tooling/op25-check.sh runs the suite with it on and
    // off (FID_IROPT_OFF=quietcall turns it off).
    var on_quiet: bool = has_main && iro_pass_on("quietcall");
    var quiet_masks: Vec<i64> = Vec::new();
    g_iro_quiet = Vec::new();
    if on_quiet {
        tm0 = iro_clock(timing);
        ime_trace("quietcall", "-");
        quiet_masks = licm_masks;
        if quiet_masks.len() == 0 {
            quiet_masks = iro_effect_masks_in(module, mid_reach);
        }
        g_iro_quiet = iro_quiet_fns_in(module, mid_reach);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "quietcall", timing, tm0);
    }
    var n_dcall: i64 = 0;
    // OP25: the same masks, by name, for the mid-end passes of iropt_me,
    // which see one function at a time (ime_set_call_facts): the functions
    // with no effect but a panic, which the guard of `licmguard` may move
    // out of a loop's first body block (FID_IROPT_OFF=guardcall: not), and
    // those that write nothing, across a call to which load hoisting (LF5),
    // store forwarding (LF6), match facts and vecdata keep what they know
    // about memory (FID_IROPT_OFF=nowritecall: not). Whole program only.
    var on_guardcall: bool = has_main && iro_pass_on("guardcall") && ime_on("licmguard");
    var on_nowrite: bool = has_main && iro_pass_on("nowritecall") && (ime_on("loadhoist") || ime_on("forward") || ime_on("matchfacts") || ime_on("vecdata"));
    ime_set_call_facts(0, 0);
    if on_guardcall || on_nowrite {
        tm0 = iro_clock(timing);
        ime_trace("callfacts", "-");
        var fact_masks: Vec<i64> = licm_masks;
        if fact_masks.len() == 0 {
            fact_masks = quiet_masks;
        }
        if fact_masks.len() == 0 {
            fact_masks = iro_effect_masks_in(module, mid_reach);
        }
        var pure_set: i64 = 0;
        var nowrite_set: i64 = 0;
        if on_guardcall {
            pure_set = HashMap_new();
        }
        if on_nowrite {
            nowrite_set = HashMap_new();
        }
        var fpi: i64 = 0;
        while fpi < module.functions.len() && fpi < fact_masks.len() {
            var fent: IrFunctionEntry = module.functions.get(fpi);
            var fname: str = fent.name;
            var fbody: IrFunction = fent.func;
            // a declaration without a body (extern) has no instructions,
            // so its mask says nothing: never in either set
            if !iro_site_effects_count(fname) && fbody.blocks.len() > 0 {
                var fm: i64 = fact_masks.get(fpi);
                if on_guardcall && (fm | IRO_EB_DIVERGE) == IRO_EB_DIVERGE {
                    HashMap_insert(pure_set, fname, 1);
                }
                if on_nowrite && iro_mask_no_write(fm) {
                    HashMap_insert(nowrite_set, fname, 1);
                }
            }
            fpi = fpi + 1;
        }
        ime_set_call_facts(pure_set, nowrite_set);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "callfacts", timing, tm0);
    }
    // LF2: reference parameters no callee lets go of, so the alias query
    // (iropt_me) knows a local passed by `&`/`&mut` is reached only by the
    // call it is passed to. Whole program only; for the passes that ask
    // (dse, loadhoist, forward, matchfacts: on by default since Nov 16).
    // On by default since Nov 17 (iropt_me.fd IME_DEFAULT_ON;
    // FID_IROPT_OFF=lendref; gate: tests/tooling/lendref-check.sh).
    if has_main && (on_dse || ime_on("loadhoist") || ime_on("forward") || ime_on("matchfacts")) && ime_on("lendref") {
        tm0 = iro_clock(timing);
        ime_trace("lendref", "-");
        ime_note_ref_params(module);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "lendref", timing, tm0);
    } else {
        ime_forget_ref_params();
    }
    // CS6: the memo of the per-function passes below (ir_ser.fd imc_*,
    // FID_IROCACHE; CB3: on by default for `fid emit -o <output>`,
    // imc_emit_default_path): a function whose IR, the IR of every function
    // it names (transitively, iro_imc_key) and the switches are an earlier
    // build's gets what the passes made of it then. Off with the counters
    // (FID_IROPT_STATS), --validate, remarks, a profile, paramrange or
    // FID_LIBFACTS_IN, whose inputs the key does not hold.
    var imc_verify: bool = imc_verify_on();
    var imc_on: bool = !stats && !tv_on() && !g_iro_remarks_on && !pgo_active() && !peir_prm_wanted() && !imc_env_set("FID_LIBFACTS_IN") && imc_begin();
    var imc_salt: i64 = 0;
    var imc: IroImc = iro_imc_empty();
    if imc_on {
        tm0 = iro_clock(timing);
        var imc_flags: i64 = iro_imc_bit(on_fold, 0) + iro_imc_bit(on_simplify, 1) + iro_imc_bit(on_branch, 2) + iro_imc_bit(on_facts, 3) + iro_imc_bit(on_sccp, 4) + iro_imc_bit(on_promote, 5) + iro_imc_bit(on_devirt, 6) + iro_imc_bit(on_cdev, 7) + iro_imc_bit(on_dse, 8) + iro_imc_bit(on_quiet, 9) + iro_imc_bit(on_dce, 10) + iro_imc_bit(on_tail, 11) + iro_imc_bit(on_gvn, 12) + iro_imc_bit(on_licm, 13) + iro_imc_bit(on_iv, 14) + iro_imc_bit(on_version, 15) + iro_imc_bit(on_guardcall, 16) + iro_imc_bit(on_nowrite, 17) + iro_imc_bit(has_main, 18) + iro_imc_bit(licm_masks.len() > 0, 19) + iro_imc_bit(quiet_masks.len() > 0, 20) + iro_imc_bit(on_rotate, 21);
        imc_salt = iro_imc_salt(module, imc_flags);
        imc = iro_imc_prepare(module, reach, has_main);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "irocache", timing, tm0);
    }
    // 2g.90 (VF6): with --validate, the runs that check the passes below
    // read the module's constant globals as their literals
    tv_note_globals(module);
    var i: i64 = 0;
    while i < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(i);
        if has_main && !HashMap_contains(reach, entry.name) {
            i = i + 1;
            continue;
        }
        var f: IrFunction = entry.func;
        var changed: bool = false;
        // CS6: a hit replays the recorded result and skips the passes
        // (FID_IROCACHE_VERIFY: they run anyway and the results are compared)
        var imc_key: i64 = 0;
        var imc_at: i64 = 0;
        var imc_done: bool = false;
        if imc_on {
            imc_key = iro_imc_key(&mut imc, module, i, imc_salt);
            if imc_key == 0 {
                imc_nokey_note(entry.name);
            } else {
                imc_at = imc_lookup(imc_key, entry.name);
            }
            if imc_at > 0 && !imc_verify {
                if imc_same(imc_at) {
                    imc_use(imc_at);
                    imc_done = true;
                } else {
                    match imc_take(imc_at, entry.name) {
                        OptIrFunction::Some(hf) => {
                            entry.func = hf;
                            module.functions.set(i, entry);
                            imc_done = true;
                        }
                        OptIrFunction::None => {
                            imc_at = 0;
                        }
                    }
                }
            }
        }
        if imc_done {
            i = i + 1;
            continue;
        }
        // OP3: the use lists the passes below share (iro_uses_entry); every
        // pass that changes `f` forgets them (iro_time, and the ones timed by
        // hand below)
        iro_uses_arm();
        if stats {
            insts_before = insts_before + iro_count_insts(&f);
        }
        // ME22-ME28 (compiler/iropt_me.fd, opt-in): restructuring first,
        // so the cleanup passes below see their result
        tm0 = iro_clock(timing);
        if ime_function_passes(&mut f) {
            changed = true;
            iro_uses_forget();
        }
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "midend", timing, tm0);
        if on_fold && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "fold", timing, &mut f) {
            changed = true;
            n_fold = n_fold + 1;
            // OP3: the pass changed the function: the shared use lists no
            // longer hold (they were stale here before: fold, simplify,
            // branchfold, branchfacts, sccp, promote, dse, quietcall, dce
            // (which repairs its own below), tailcall, gvn and iv never
            // forgot)
            iro_uses_forget();
        }
        if on_simplify && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "simplify", timing, &mut f) {
            changed = true;
            n_simp = n_simp + 1;
            iro_uses_forget();
        }
        if on_branch && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "branchfold", timing, &mut f) {
            changed = true;
            n_branch = n_branch + 1;
            iro_uses_forget();
        }
        if on_facts && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "branchfacts", timing, &mut f) {
            changed = true;
            n_facts = n_facts + 1;
            iro_uses_forget();
        }
        if on_sccp && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "sccp", timing, &mut f) {
            changed = true;
            n_sccp = n_sccp + 1;
            iro_uses_forget();
        }
        if on_promote && iro_promote_here(&f, on_ssa_me, promote_named) && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "promote", timing, &mut f) {
            changed = true;
            n_promote = n_promote + 1;
            iro_uses_forget();
        }
        if on_devirt {
            tm0 = iro_clock(timing);
            ime_trace("devirt", f.name);
            // VF6: with --validate the result is checked (tv.fd tv_devirt)
            var tv_dpre: IrFunction = tv_before(&f);
            var dv: bool = iro_devirt(module, &mut f);
            if dv && !tv_after_devirt(module, &tv_dpre, &mut f) {
                dv = false;
                iro_uses_forget();
            }
            iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "devirt", timing, tm0);
            if dv {
                changed = true;
                n_devirt = n_devirt + 1;
                iro_uses_forget();
            }
        }
        // LG5/LG6: closure-env CallPtr -> direct Call (+ stack envs).
        // Runs before the cleanup passes so the devirtualized calls get
        // folded/inlined by what follows.
        if on_cdev {
            tm0 = iro_clock(timing);
            ime_trace("closuredevirt", f.name);
            var cdv: bool = iro_closure_devirt(module, &mut f);
            iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "closuredevirt", timing, tm0);
            if cdv {
                changed = true;
                n_cdev = n_cdev + 1;
                iro_uses_forget();
            }
        }
        if on_dse && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "dse", timing, &mut f) {
            changed = true;
            n_dse = n_dse + 1;
            iro_uses_forget();
        }
        // OP25: unused calls that end, never panic and write nothing; before
        // dce, which then drops their arguments
        if on_quiet {
            tm0 = iro_clock(timing);
            ime_trace("quietcall", f.name);
            var dcl: bool = iro_dead_calls(module, &quiet_masks, &mut f);
            iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "quietcall", timing, tm0);
            if dcl {
                changed = true;
                n_dcall = n_dcall + 1;
                iro_uses_forget();
            }
        }
        if on_dce && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "dce", timing, &mut f) {
            changed = true;
            n_dce = n_dce + 1;
            // OP3 (Nov 21 evening): dce only removes instructions nothing
            // reads — iro_uses_dead updates the shared lists in place
            // (each removed instruction's operands lose their use, the
            // instruction leaves their user lists; a dead id's own entries
            // are queried by no one), so the cache survives the most
            // frequent cleanup pass and the passes around it share it
            iro_uses_dead(&f);
        }
        if on_tail && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "tailcall", timing, &mut f) {
            changed = true;
            n_tail = n_tail + 1;
            iro_uses_forget();
        }
        if on_gvn && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "gvn", timing, &mut f) {
            changed = true;
            n_gvn = n_gvn + 1;
            iro_uses_forget();
        }
        if on_licm {
            // reads the module's effect masks (OP25), so it is timed here
            tm0 = iro_clock(timing);
            ime_trace("licm", f.name);
            // VF6: with --validate the result is checked (tv.fd tv_licm),
            // trusting the effect masks for the calls it moved
            var tv_lpre: IrFunction = tv_before(&f);
            var lc: bool = iro_licm(module, &licm_masks, &mut f);
            if lc && tv_on() {
                iro_tv_licm_calls(module, &licm_masks, &f);
                if !tv_after("licm", &tv_lpre, &mut f) {
                    lc = false;
                    iro_uses_forget();
                }
            }
            iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "licm", timing, tm0);
            if lc {
                changed = true;
                n_licm = n_licm + 1;
                iro_uses_forget();
            }
        }
        if on_iv && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "iv", timing, &mut f) {
            changed = true;
            n_iv = n_iv + 1;
            iro_uses_forget();
        }
        // LF11/ME25: loop versioning (on by default since Nov 17;
        // FID_IROPT_OFF=version turns it off)
        if on_version {
            tm0 = iro_clock(timing);
            ime_trace("version", f.name);
            f = iro_version(f);
            iro_uses_forget();
            iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "version", timing, tm0);
            if g_iro_nver > 0 {
                changed = true;
                n_ver = n_ver + g_iro_nver;
            }
        }
        // ME23: loop rotation, after every pass that wants a loop's test in
        // its header (licm, iv, version; the counted-loop proof of
        // checks.fd knows both shapes)
        if on_rotate {
            tm0 = iro_clock(timing);
            ime_trace("rotate", f.name);
            var rot: bool = ime_rotate_pass(&mut f);
            iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "rotate", timing, tm0);
            if rot {
                changed = true;
                n_rot = n_rot + 1;
                iro_uses_forget();
            }
        }
        if stats {
            insts_after = insts_after + iro_count_insts(&f);
        }
        // CS6: what the passes made of it, for the next build (a verified
        // hit: compared with what the memo held)
        if imc_on && imc_key != 0 {
            if imc_at > 0 {
                // 2g.93: in the hash the entry was recorded with
                imc_verify_note(imc_at, entry.name, imc_verify_post(imc_at, f, changed, imc.pre_h.get(i)));
            } else {
                var _imc_post: i64 = imc_note(imc_key, entry.name, imc.pre_h.get(i), f, changed);
            }
        }
        if changed {
            entry.func = f;
            module.functions.set(i, entry);
        }
        i = i + 1;
    }
    // OP3: outside the loop every request for use lists builds them
    iro_uses_disarm();
    tv_forget_globals();
    // CS6: the memo's counts, and its file when this build added to it
    if imc_on {
        imc_finish();
    }
    // WP19: functions whose IR is the same (generic instances, specialized
    // clones) are all called through the first of them; bodies are compared
    // after the passes above. On by default since Nov 21 (before that,
    // opt-in FID_IROPT_ON=icf; its own test folded nothing with the default
    // passes, because inline2 had inlined the small identical callees first
    // — icf now still folds what inlining leaves: instances and clones too
    // big for its budget); FID_IROPT_OFF=icf turns it off.
    var n_icf: i64 = 0;
    if has_main && iro_pass_on("icf") {
        tm0 = iro_clock(timing);
        ime_trace("icf", "-");
        var tvm_icf: TvMod = tv_mod_before(module);
        n_icf = iro_fold_identical(module);
        if !tv_mod_after("icf", &tvm_icf, module) {
            n_icf = 0;
        }
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "icf", timing, tm0);
    }
    // WP15: functions optimization made unreachable (callers inlined,
    // calls rewritten) are removed now, not only before optimization.
    var deadf: i64 = 0;
    var deadg: i64 = 0;
    // Since Nov 16 its roots include every function machine code calls by
    // name (ir.fd ir_dfe_root: pe_*, pert_*, nat_*, __*, the Vec_*
    // stand-ins, vec_buf_alloc, interrupt handlers), since Nov 17 the
    // functions the module's data names, and globals only ever stored go
    // too. On by default since Nov 17 (was FID_IROPT_ON=deadf), now that
    // it is linear (ir.fd: pe_ir_reachable_from's table, a merge sort; it
    // cost 1.4 s on hello at -O0 with list scans): the native backends
    // compile only what main reaches anyway, so it saves the backends'
    // module-wide scans, not code. FID_IROPT_OFF=deadf turns it off
    // (tests/tooling/wp-defaults-check.sh runs the suite both ways).
    if has_main && iro_pass_on("deadf") {
        tm0 = iro_clock(timing);
        ime_trace("deadf", "-");
        deadf = IrModule_dead_function_elimination(module);
        deadg = IrModule_dead_global_elimination(module);
        iro_time_note(&mut tp_names, &mut tp_ms, &mut tp_hits, "deadf", timing, tm0);
    }
    // WP20: emit the library-facts artifact when the consumer asked for one.
    iro_libfacts(module);
    if g_iro_time_on {
        g_iro_pass_names = tp_names;
        g_iro_pass_ms = tp_ms;
    }
    // RL5/VF6: --validate totals (compiler/tv.fd)
    tv_report();
    if stats {
        // WP7/WP15: tests/tooling/wp-defaults-check.sh reads these lines
        p_eprint_str("iropt: dead functions " + int_to_str(deadf) + ", dead globals " + int_to_str(deadg) + "\n");
        p_eprint_str("iropt: envtrim " + int_to_str(n_envtrim) + " calls\n");
        if n_icf > 0 {
            p_eprint_str("iropt: identical functions folded " + int_to_str(n_icf) + "\n");
        }
        if on_quiet {
            // OP25: tests/tooling/quietcall-egplace-check.sh and
            // op25-check.sh read this line
            p_eprint_str("iropt: quietcall " + int_to_str(iro_count_ones(&g_iro_quiet)) + " quiet functions, dead calls removed in " + int_to_str(n_dcall) + " functions\n");
        }
        // OP25: calls the guard moved out of loops (licmguard), and how often
        // a call that writes nothing kept a memory fact (loadhoist, forward,
        // match facts, vecdata); tests/tooling/op25-check.sh reads this line
        p_eprint_str("iropt: guardcall " + int_to_str(ime_guardcall_count()) + " calls, nowritecall " + int_to_str(ime_nowrite_count()) + " facts kept\n");
        p_eprint_str("iropt: fold " + int_to_str(n_fold) + ", simplify " + int_to_str(n_simp) + ", branchfold " + int_to_str(n_branch) + ", branchfacts " + int_to_str(n_facts) + ", sccp " + int_to_str(n_sccp) + ", promote " + int_to_str(n_promote) + ", ipcp " + int_to_str(n_ipcp) + ", devirt " + int_to_str(n_devirt) + ", gconst " + int_to_str(n_gconst) + ", dse " + int_to_str(n_dse) + ", dce " + int_to_str(n_dce) + ", tailcall " + int_to_str(n_tail) + ", gvn " + int_to_str(n_gvn) + ", licm " + int_to_str(n_licm) + ", iv " + int_to_str(n_iv) + ", spec " + int_to_str(n_spec) + ", cdevirt " + int_to_str(n_cdev) + ", hofspec " + int_to_str(n_hof) + ", versioned loops " + int_to_str(n_ver) + " functions changed\n");
        // OP9 (compiler/iropt_me.fd): operations moved out of loops under a
        // guard, Vec element reads off a data pointer loaded before the
        // loop; tests/tooling/licmguard-check.sh reads this line
        p_eprint_str("iropt: licmguard " + int_to_str(ime_licmguard_count()) + " operations, vecdata " + int_to_str(ime_vecdata_count()) + " reads\n");
        // ME20/ME21 (compiler/iropt_me.fd): sites inlined by inline2, the
        // growth it charged and refused, the call sites it weighed;
        // tests/tooling/inline2-tune.sh and inline2-limits-check.sh read it
        p_eprint_str(ime_inline_stats_line());
        // OP26 (LF3, compiler/iropt_me.fd): vecdata's element reads that
        // forwarding reused, across writes the Vec buffer facts (vecalias)
        // say cannot change them; tests/tooling/vecalias-check.sh reads it
        p_eprint_str("iropt: vecalias " + int_to_str(ime_vecalias_count()) + " element reads reused\n");
        // OP14: clones per dyn argument type (iro_dyn_specialize), trait and
        // closure calls through struct fields made direct (iro_field_devirt);
        // tests/tooling/devirt-check.sh reads this line
        p_eprint_str("iropt: dynspec " + int_to_str(n_dspec) + " clones, fielddevirt " + int_to_str(n_fdv.get(0)) + " dyn calls, " + int_to_str(n_fdv.get(1)) + " closure calls\n");
        // OP10/OP11 (compiler/iropt_me.fd): products strength-reduced by
        // ivsr, loops unrolled; tests/tooling/ivsr-check.sh and
        // unroll-check.sh read this line
        p_eprint_str(ime_loop_stats_line());
        // ME23 (compiler/ssa.fd): exit values of counted loops, constant or
        // from a bound that is not; tests/tooling/ssaexit-check.sh reads it.
        // ME23 rotation (iropt_me.fd ime_rotate, `rotate`): loops whose test
        // was copied to their latch; tests/tooling/rotate-check.sh reads it
        p_eprint_str(ssa_exit_stats_line());
        p_eprint_str("iropt: rotate " + int_to_str(ime_rotate_count()) + " loops in " + int_to_str(n_rot) + " functions\n");
        // OP3: CFGs built vs handed back unchanged (iro_cfg's cache), and
        // the analyses cached with it: loop trees (iro_loops), use lists
        // (iro_uses_entry); tests/tooling/cfgcache-check.sh reads these
        p_eprint_str("iropt: cfg built " + int_to_str(iro_cfg_builds()) + ", reused " + int_to_str(iro_cfg_reused()) + "\n");
        p_eprint_str("iropt: loops built " + int_to_str(iro_loops_builds()) + ", reused " + int_to_str(iro_loops_reused()) + "\n");
        p_eprint_str("iropt: uses built " + int_to_str(iro_uses_builds()) + ", reused " + int_to_str(iro_uses_reused()) + "\n");
        // ME30: what the mid-end did, for scripts/me-measure.sh
        p_eprint_str("iropt: instructions " + int_to_str(insts_before) + " -> " + int_to_str(insts_after) + " in " + int_to_str(p_clock_now_ms() - t_start) + " ms\n");
        // ME5: per-pass timing, most expensive first
        var ti: i64 = 0;
        while ti < tp_ms.len() {
            var tj: i64 = ti + 1;
            while tj < tp_ms.len() {
                if tp_ms.get(tj) > tp_ms.get(ti) {
                    var m1: i64 = tp_ms.get(ti);
                    tp_ms.set(ti, tp_ms.get(tj));
                    tp_ms.set(tj, m1);
                    var n1: str = tp_names.get(ti);
                    tp_names.set(ti, tp_names.get(tj));
                    tp_names.set(tj, n1);
                    var h1: i64 = tp_hits.get(ti);
                    tp_hits.set(ti, tp_hits.get(tj));
                    tp_hits.set(tj, h1);
                }
                tj = tj + 1;
            }
            p_eprint_str("iropt: pass " + tp_names.get(ti) + ": " + int_to_str(tp_ms.get(ti)) + " ms (" + int_to_str(tp_hits.get(ti)) + " calls)\n");
            ti = ti + 1;
        }
    }
}

// --- CS6: the memo of iropt_native's per-function passes ------------------
// (ir_ser.fd imc_*: the store and when it is on.) The key of a function is
// its own IR before the passes and that of every function it names,
// transitively (the passes read their masks, quiet and lending facts and
// some bodies), in module order, with the run's switches (iro_imc_salt).

/// BFS steps iro_imc_key may take over a whole build; past them the
/// functions left get no key (the passes run on them, nothing recorded).
const IRO_IMC_BUDGET: i64 = 8000000;

/// What the memo knows about the module before the loop, by position: the
/// content hash before the passes (0: not yet; a function the loop does not
/// run is hashed when a key needs it, its IR is the same then), the
/// positions of the functions it names, a hash of the names it uses that
/// the module does not define, and 1 when the loop runs the passes on it.
pub struct IroImc {
    pub pre_h: Vec<i64>,
    pub refs: Vec<Vec<i64>>,
    pub ext: Vec<i64>,
    pub runs: Vec<i64>,
    pub mark: Vec<i64>,
    pub gen: i64,
    pub budget: i64,
}

fn iro_imc_empty() -> IroImc {
    return IroImc {
        pre_h: Vec::new(), refs: Vec::new(), ext: Vec::new(), runs: Vec::new(), mark: Vec::new(), gen: 0, budget: 0
    };
}

/// Bit `k` when `b`.
fn iro_imc_bit(b: bool, k: i64) -> i64 {
    if b {
        return 1 << k;
    }
    return 0;
}

/// `name` used by a function: its position goes to `out` when the module
/// defines it, else it is folded into the hash `ext` (returned).
fn iro_imc_name(module: &IrModule, name: str, out: &mut Vec<i64>, ext: i64) -> i64 {
    var p: i64 = IrModule_fn_pos(module, name);
    if p >= 0 {
        out.push(p);
        return ext;
    }
    return mec_mix(ext, imc_hs(name));
}

/// The functions `f` names (positions into `out`): calls, function
/// references, and for its dyn calls every `<Type>_<method>` of a type that
/// implements the trait or that a MakeDyn of `f` makes (devirt and the
/// effect masks look those up). Returns the hash of the names the module
/// does not define.
fn iro_imc_refs(module: &IrModule, f: &IrFunction, out: &mut Vec<i64>) -> i64 {
    var ext: i64 = 0;
    var methods: Vec<str> = Vec::new();
    var types: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < f.insts.len() {
        var ins: Inst = f.insts.get(i).inst;
        match ins {
            Inst::Call(cn, _a, _r, _e) => {
                ext = iro_imc_name(module, cn, out, ext);
            }
            Inst::ConstFnRef(fname) => {
                ext = iro_imc_name(module, fname, out, ext);
            }
            Inst::DynCall(tr, dm, _da, _dr, _de) => {
                methods.push(dm);
                var ti: i64 = 0;
                while ti < module.trait_impls.len() {
                    var te: StringVecStr = module.trait_impls.get(ti);
                    if te.name == tr {
                        var tj: i64 = 0;
                        while tj < te.items.len() {
                            types.push(te.items.get(tj));
                            tj = tj + 1;
                        }
                    }
                    ti = ti + 1;
                }
            }
            Inst::MakeDyn(_mv, tn, _mt) => {
                types.push(tn);
            }
            _ => {
            }
        }
        i = i + 1;
    }
    var mi: i64 = 0;
    while mi < methods.len() {
        var tk: i64 = 0;
        while tk < types.len() {
            ext = iro_imc_name(module, types.get(tk) + "_" + methods.get(mi), out, ext);
            tk = tk + 1;
        }
        mi = mi + 1;
    }
    return ext;
}

/// The memo's view of `module` before the loop (`reach`: what the loop
/// runs on when `has_main`). Hashes every function the loop runs on now,
/// before it changes any.
fn iro_imc_prepare(module: &IrModule, reach: i64, has_main: bool) -> IroImc {
    var m: IroImc = iro_imc_empty();
    m.budget = IRO_IMC_BUDGET;
    var j: i64 = 0;
    while j < module.functions.len() {
        var ent: IrFunctionEntry = module.functions.get(j);
        var f: IrFunction = ent.func;
        var rs: Vec<i64> = Vec::new();
        m.ext.push(iro_imc_refs(module, &f, &mut rs));
        m.refs.push(rs);
        m.mark.push(0);
        if !has_main || HashMap_contains(reach, ent.name) {
            m.runs.push(1);
            m.pre_h.push(mec_fn_hash(f));
        } else {
            m.runs.push(0);
            m.pre_h.push(0);
        }
        j = j + 1;
    }
    return m;
}

/// The run's switches (`flags`, iropt_native) and the module's tables a
/// per-function pass may consult: the environment the passes read, the
/// trait tables, externs, C callbacks, globals and struct names.
fn iro_imc_salt(module: &IrModule, flags: i64) -> i64 {
    var h: i64 = mec_mix(MEC_IROPT, flags);
    h = mec_mix(h, imc_env_h("FID_IROPT_OFF"));
    h = mec_mix(h, imc_env_h("FID_IROPT_ON"));
    h = mec_mix(h, imc_env_h("FID_SWITCH"));
    var i: i64 = 0;
    while i < module.trait_methods.len() {
        var tm: StringVecStr = module.trait_methods.get(i);
        h = mec_mix(h, imc_hs(tm.name));
        var j: i64 = 0;
        while j < tm.items.len() {
            h = mec_mix(h, imc_hs(tm.items.get(j)));
            j = j + 1;
        }
        i = i + 1;
    }
    h = mec_mix(h, 11);
    i = 0;
    while i < module.trait_impls.len() {
        var ti: StringVecStr = module.trait_impls.get(i);
        h = mec_mix(h, imc_hs(ti.name));
        var j2: i64 = 0;
        while j2 < ti.items.len() {
            h = mec_mix(h, imc_hs(ti.items.get(j2)));
            j2 = j2 + 1;
        }
        i = i + 1;
    }
    h = mec_mix(h, 13);
    i = 0;
    while i < module.extern_functions.len() {
        var ex: StringVecIrType = module.extern_functions.get(i);
        h = mec_mix(mec_mix(h, imc_hs(ex.name)), ex.params.len());
        i = i + 1;
    }
    h = mec_mix(h, 17);
    i = 0;
    while i < module.c_callbacks.len() {
        h = mec_mix(h, imc_hs(module.c_callbacks.get(i)));
        i = i + 1;
    }
    h = mec_mix(h, 19);
    i = 0;
    while i < module.globals.len() {
        h = mec_mix(h, imc_hs(module.globals.get(i).name));
        i = i + 1;
    }
    h = mec_mix(h, 23);
    i = 0;
    while i < module.struct_layouts.len() {
        h = mec_mix(h, imc_hs(module.struct_layouts.get(i).name));
        i = i + 1;
    }
    return h;
}

/// The key of function `i` (iropt_native's loop, before its passes), 0
/// when it has none (not hashed, or the budget is spent). Folds in, in
/// module order, every function of its closure under "names"
/// (iro_imc_refs): its content hash before the passes, its name, the
/// undefined names it uses, whether the loop runs on it, and which member
/// is `i` (a member before `i` is seen by the passes after its own passes,
/// one after it before).
fn iro_imc_key(imc: &mut IroImc, module: &IrModule, i: i64, salt: i64) -> i64 {
    if imc.budget <= 0 || i < 0 || i >= imc.pre_h.len() {
        return 0;
    }
    var own: i64 = imc.pre_h.get(i);
    if own == 0 {
        return 0;
    }
    imc.gen = imc.gen + 1;
    var gen: i64 = imc.gen;
    var members: Vec<i64> = Vec::new();
    members.push(i);
    imc.mark.set(i, gen);
    var q: i64 = 0;
    while q < members.len() {
        var rs: Vec<i64> = imc.refs.get(members.get(q));
        var k: i64 = 0;
        while k < rs.len() {
            var c: i64 = rs.get(k);
            if c >= 0 && c < imc.mark.len() && imc.mark.get(c) != gen {
                imc.mark.set(c, gen);
                members.push(c);
            }
            k = k + 1;
        }
        imc.budget = imc.budget - rs.len() - 1;
        if imc.budget <= 0 {
            return 0;
        }
        q = q + 1;
    }
    members.sort();
    var h: i64 = mec_mix(salt, members.len());
    var mi: i64 = 0;
    while mi < members.len() {
        var m2: i64 = members.get(mi);
        var ph: i64 = imc.pre_h.get(m2);
        if ph == 0 {
            // the loop does not run on it: its IR now is its IR before
            ph = mec_fn_hash(module.functions.get(m2).func);
            imc.pre_h.set(m2, ph);
        }
        h = mec_mix(h, ph);
        h = mec_mix(h, imc_hs(module.functions.get(m2).name));
        h = mec_mix(h, imc.ext.get(m2));
        h = mec_mix(h, imc.runs.get(m2));
        if m2 == i {
            h = mec_mix(h, 7);
        }
        mi = mi + 1;
    }
    return mec_key(MEC_IROPT, own, h);
}

/// Run pass `name` on `f`, adding its time to the table when `stats`.
/// Fides calls are resolved statically, so the name dispatches.
fn iro_time(names: &mut Vec<str>, ms: &mut Vec<i64>, hits: &mut Vec<i64>, name: str, stats: bool, f: &mut IrFunction) -> bool {
    // RL20: "[iropt] <pass> <fn>" under FID_CRASH_TRACE (iropt_me.fd)
    ime_trace(name, f.name);
    var t0: i64 = 0;
    if stats {
        t0 = p_clock_now_ms();
    }
    var changed: bool = false;
    // RL5/VF6: with --validate the function before the pass is kept and the
    // result checked (compiler/tv.fd); a rejected result is undone
    var tv_pre: IrFunction = tv_before(f);
    if name == "fold" {
        changed = iro_fold(f);
    }
    if name == "simplify" {
        changed = iro_simplify(f);
    }
    if name == "branchfold" {
        changed = iro_branch_fold(f);
    }
    if name == "branchfacts" {
        changed = iro_branch_facts(f);
    }
    if name == "sccp" {
        changed = iro_sccp(f);
    }
    if name == "promote" {
        changed = iro_promote(f);
    }
    if name == "dse" {
        changed = iro_dse(f);
    }
    if name == "dce" {
        changed = iro_dce(f);
    }
    if name == "tailcall" {
        changed = iro_tailcalls(f);
    }
    if name == "gvn" {
        changed = iro_gvn(f);
    }
    if name == "iv" {
        changed = iro_iv(f);
    }
    if changed {
        // OP3: the pass changed `f`; use lists cached before no longer hold
        iro_uses_forget();
    }
    if changed && !tv_after(name, &tv_pre, f) {
        changed = false;
    }
    iro_time_note(names, ms, hits, name, stats, t0);
    return changed;
}

/// The clock when `stats` (0 otherwise: no clock read without stats).
fn iro_clock(stats: bool) -> i64 {
    if stats {
        return p_clock_now_ms();
    }
    return 0;
}

/// ME20: the functions main reaches, as a HashMap from name (for
/// ime_inline_reached); 0 when the module has no main (every function).
fn iro_inline_reach(module: &IrModule) -> i64 {
    var has_main: bool = false;
    var i: i64 = 0;
    while i < module.functions.len() && !has_main {
        if module.functions.get(i).name == "main" {
            has_main = true;
        }
        i = i + 1;
    }
    if !has_main {
        return 0;
    }
    var reach: i64 = HashMap_new();
    var rl: Vec<str> = pe_ir_reachable_functions(module);
    i = 0;
    while i < rl.len() {
        HashMap_insert(reach, rl.get(i), 1);
        i = i + 1;
    }
    // RT8 (team RN): the native allocator is reached through builtin
    // targets, not from main: optimized as main's code is
    var alloc_fns: Vec<str> = Vec::new();
    alloc_fns.push("pert_malloc");
    alloc_fns.push("pert_malloc_uninit");
    alloc_fns.push("pert_free");
    alloc_fns.push("pe_alloc_slow");
    alloc_fns.push("pe_free_raw");
    i = 0;
    while i < alloc_fns.len() {
        if pe_module_has_fn(module, alloc_fns.get(i)) {
            HashMap_insert(reach, alloc_fns.get(i), 1);
        }
        i = i + 1;
    }
    return reach;
}

// --- SP3: the mid-end works on what main reaches ----------------------------
//
// The per-function passes of iropt_native only ever ran on the functions
// main reaches (CS1), but the module passes before them (closuredevirt,
// hofspec, inline, gconst's folding, the effect masks and quiet functions)
// and the rules and the e-graph after iropt went over every function of the
// module: the whole merged runtime and every p_* function of core, which
// pe88_prune and deadf keep because machine code may call them by name.
// For hello that was most of the mid-end's time (hofspec alone 498 of
// 1247 ms on a -O0 compiler, Nov 17). These passes are optimizations of one
// function at a time (the facts they read about other functions are
// computed over the callees of what they change, below), so leaving a
// function out leaves it correct, only less optimized; the native backends
// compile what main reaches plus the runtime functions machine code starts
// by name, and the latter were already left out by iropt's per-function
// loop. FID_IROPT_OFF=midreach: every function again (the old behaviour;
// tests/tooling/sp3-hello-check.sh compares the two).

/// SP3: the functions the mid-end works on: a HashMap of the names main
/// reaches (pe_ir_reachable_functions), or 0 (every function) when the
/// module has no main or FID_IROPT_OFF names `midreach`.
pub fn iro_mid_reach(module: &IrModule) -> i64 {
    if !iro_pass_on("midreach") {
        return 0;
    }
    return iro_inline_reach(module);
}

/// SP3: is `name` one of the functions `reach` (iro_mid_reach) holds?
/// Every function when `reach` is 0.
pub fn iro_in_reach(reach: i64, name: str) -> bool {
    return reach == 0 || HashMap_contains(reach, name);
}

/// SP3: by position in module.functions, 1 for every function `reach`
/// holds and every function one of those calls directly, transitively
/// (Inst::Call found by IrModule_fn_pos, as iro_local_ext_mask and
/// iro_quiet_inst find the callees whose facts they join), 0 for the rest.
/// An empty Vec when `reach` is 0: every function. The facts of a function
/// in the set depend only on functions in the set, so they are the same as
/// when every function is analysed.
fn iro_call_closure(module: &IrModule, reach: i64) -> Vec<i64> {
    var in_set: Vec<i64> = Vec::new();
    if reach == 0 {
        return in_set;
    }
    var n: i64 = module.functions.len();
    in_set = peir_zeros(n);
    var work: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        if HashMap_contains(reach, module.functions.get(i).name) {
            in_set.set(i, 1);
            work.push(i);
        }
        i = i + 1;
    }
    while work.len() > 0 {
        var at: i64 = work.get(work.len() - 1);
        work.pop();
        var f: IrFunction = module.functions.get(at).func;
        var k: i64 = 0;
        while k < f.insts.len() {
            match f.insts.get(k).inst {
                Inst::Call(cn, _ca, _cr, _ce) => {
                    var pos: i64 = IrModule_fn_pos(module, cn);
                    if pos >= 0 && pos < n && in_set.get(pos) == 0 {
                        in_set.set(pos, 1);
                        work.push(pos);
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
    }
    return in_set;
}

/// SP3: is position `i` in `keep` (iro_call_closure; empty: every one)?
fn iro_kept_at(keep: &Vec<i64>, i: i64) -> bool {
    return keep.len() == 0 || (i < keep.len() && keep.get(i) == 1);
}

/// ME5: add the time since `t0` to pass `name`'s row of the timing table
/// (one call more), when `stats`. For what iro_time cannot dispatch: the
/// module passes, the passes that read the module (devirt), and the
/// opt-in iropt_me passes together ("midend").
fn iro_time_note(names: &mut Vec<str>, ms: &mut Vec<i64>, hits: &mut Vec<i64>, name: str, stats: bool, t0: i64) {
    if !stats {
        return;
    }
    var dt: i64 = p_clock_now_ms() - t0;
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == name {
            ms.set(i, ms.get(i) + dt);
            hits.set(i, hits.get(i) + 1);
            return;
        }
        i = i + 1;
    }
    names.push(name);
    ms.push(dt);
    hits.push(1);
}

// --- Helpers ----------------------------------------------------------------

/// Instruction `to` of `f` gets the source line of instruction `from` of
/// `src` (only the line: its type, region and effects stay).
fn iro_copy_line(src: &IrFunction, from: i64, f: &mut IrFunction, to: i64) {
    // DB1: inlined code keeps the file it came from (ir.fd)
    ir_copy_value_file(src.name, from, f.name, to);
    match IrFunction_get_meta(src, from) {
        OptValueMeta::Some(cm) => {
            match IrFunction_get_meta(f, to) {
                OptValueMeta::Some(nm) => {
                    var m2: ValueMeta = nm;
                    m2.source_line = cm.source_line;
                    IrFunction_set_meta(f, to, m2);
                }
                OptValueMeta::None => {
                }
            }
        }
        OptValueMeta::None => {
        }
    }
}

/// A new instruction in `f` that is in no block yet.
fn iro_detached(f: &mut IrFunction, inst: Inst) -> i64 {
    var id: i64 = IrFunction_emit(f, inst);
    var last: i64 = f.current_block_idx;
    var blk: BasicBlock = f.blocks.get(last);
    blk.instructions.pop();
    f.blocks.set(last, blk);
    return id;
}

fn iro_is_scalar(t: IrType) -> bool {
    match t {
        IrType::I8 => {
            return true;
        }
        IrType::I16 => {
            return true;
        }
        IrType::I32 => {
            return true;
        }
        IrType::I64 => {
            return true;
        }
        IrType::U8 => {
            return true;
        }
        IrType::U16 => {
            return true;
        }
        IrType::U32 => {
            return true;
        }
        IrType::U64 => {
            return true;
        }
        IrType::F32 => {
            return true;
        }
        IrType::F64 => {
            return true;
        }
        IrType::Bool => {
            return true;
        }
        IrType::Ptr(_) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

// --- Inlining (release D5) --------------------------------------------------

/// Whether `inst` may be copied into a caller as it is.
fn iro_inlinable_inst(inst: Inst) -> bool {
    match inst {
        Inst::ConstInt(_, _) => {
            return true;
        }
        Inst::ConstFloat(_, _) => {
            return true;
        }
        Inst::ConstBool(_) => {
            return true;
        }
        Inst::ConstStr(_) => {
            return true;
        }
        Inst::ConstNull(_) => {
            return true;
        }
        Inst::GlobalAddr(_, _) => {
            return true;
        }
        Inst::BinOp(_, _, _, _) => {
            return true;
        }
        Inst::UnaryOp(_, _, _) => {
            return true;
        }
        Inst::Alloca(_, _) => {
            return true;
        }
        Inst::Load(_, _) => {
            return true;
        }
        Inst::Store(_, _, _) => {
            return true;
        }
        Inst::GetFieldPtr(_, _, _) => {
            return true;
        }
        Inst::BitCast(_, _, _) => {
            return true;
        }
        Inst::IntExtend(_, _, _) => {
            return true;
        }
        Inst::IntTrunc(_, _, _) => {
            return true;
        }
        Inst::IntToFloat(_, _, _) => {
            return true;
        }
        Inst::FloatToInt(_, _, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// The value `id` names in the caller (map: callee id -> caller id + 1).
fn iro_m(map: Vec<i64>, id: i64) -> i64 {
    if id >= 0 && id < map.len() && map.get(id) != 0 {
        return map.get(id) - 1;
    }
    return id;
}

/// `inst` with its operands renamed through `map` (only the instructions
/// iro_inlinable_inst accepts).
fn iro_remap(inst: Inst, map: Vec<i64>) -> Inst {
    match inst {
        Inst::BinOp(op, a, b, t) => {
            return Inst::BinOp(op, iro_m(map, a), iro_m(map, b), t);
        }
        Inst::UnaryOp(op, a, t) => {
            return Inst::UnaryOp(op, iro_m(map, a), t);
        }
        Inst::Load(p, t) => {
            return Inst::Load(iro_m(map, p), t);
        }
        Inst::Store(p, v, t) => {
            return Inst::Store(iro_m(map, p), iro_m(map, v), t);
        }
        Inst::GetFieldPtr(p, idx, t) => {
            return Inst::GetFieldPtr(iro_m(map, p), idx, t);
        }
        Inst::BitCast(v, a, b) => {
            return Inst::BitCast(iro_m(map, v), a, b);
        }
        Inst::IntExtend(v, a, b) => {
            return Inst::IntExtend(iro_m(map, v), a, b);
        }
        Inst::IntTrunc(v, a, b) => {
            return Inst::IntTrunc(iro_m(map, v), a, b);
        }
        Inst::IntToFloat(v, a, b) => {
            return Inst::IntToFloat(iro_m(map, v), a, b);
        }
        Inst::FloatToInt(v, a, b) => {
            return Inst::FloatToInt(iro_m(map, v), a, b);
        }
        _ => {
        }
    }
    return inst;
}

/// OP30: a callee the profiled run called at least this often is hot.
const IRO_HOT_CALLS: i64 = 1000;
/// OP30: with a profile, a callee the run never called is inlined only up
/// to this size (its call cost nothing in the run; its copy costs code).
const IRO_INLINE_COLD_MAX: i64 = 8;

/// OP30: the largest callee `iro_body` inlines. Without a profile (or with
/// FID_IROPT_OFF=inlinepgo), IRO_INLINE_MAX. With one (`--profile-use`,
/// pgo.fd: a real run's call counts, loaded when it counts main), a
/// callee the run never called IRO_INLINE_COLD_MAX, one it called
/// IRO_HOT_CALLS times or more twice IRO_INLINE_MAX. When the profile
/// counts blocks (pgo.fd pgo_site_calls), the calls weighed are those of
/// the call site: the times the run entered block `site` (a block id, -1:
/// unknown) of `caller`, so a call in a block the run never entered stays
/// a call though the callee is hot elsewhere.
fn iro_inline_limit(callee: str, caller: str, site: i64) -> i64 {
    if pgo_count("main") <= 0 || iro_named_off(p_getenv("FID_IROPT_OFF"), "inlinepgo") {
        return IRO_INLINE_MAX;
    }
    var calls: i64 = pgo_site_calls(caller, site, callee);
    if calls == 0 {
        return IRO_INLINE_COLD_MAX;
    }
    if calls >= IRO_HOT_CALLS {
        return 2 * IRO_INLINE_MAX;
    }
    return IRO_INLINE_MAX;
}

/// The instructions of `callee` to copy (its Return excluded) and the value
/// it returns, when it can be inlined: one block, at most iro_inline_limit
/// plain instructions, a scalar result. ret = -1 when it cannot.
pub struct IroBody {
    pub insts: Vec<i64>,
    pub ret: i64,
}

fn iro_body(callee: &IrFunction, caller: &IrFunction, site: i64) -> IroBody {
    var none: IroBody = IroBody {
        insts: Vec::new(), ret: -1
    };
    if callee.blocks.len() != 1 {
        return none;
    }
    if callee.name == caller.name || callee.name == "main" {
        return none;
    }
    if callee.is_interrupt || callee.is_wrapping != caller.is_wrapping {
        return none;
    }
    // LF18: the backends verify @constant_time code function by function
    // (peir_ct_check, ng_ct_check): a copy of it in other code would not be
    // checked. (Code inlined into a @constant_time function is checked with it.)
    if callee.is_constant_time && !caller.is_constant_time {
        return none;
    }
    if callee.zeroize_locals.len() > 0 || callee.drop_locals.len() > 0 {
        return none;
    }
    // LF20: a secret's values stay in a function whose frame is wiped
    if callee.has_secret && !caller.has_secret {
        return none;
    }
    if callee.persist_vars.len() > 0 {
        return none;
    }
    if !iro_is_scalar(callee.ret_ty) {
        return none;
    }
    var ids: Vec<i64> = callee.blocks.get(0).instructions;
    if ids.len() == 0 || ids.len() > iro_inline_limit(callee.name, caller.name, site) {
        return none;
    }
    var body: Vec<i64> = Vec::new();
    var ret: i64 = -1;
    var i: i64 = 0;
    while i < ids.len() {
        var id: i64 = ids.get(i);
        match IrFunction_get_inst(callee, id) {
            OptInst::Some(inst) => {
                match inst {
                    Inst::Return(rv) => {
                        if i + 1 != ids.len() {
                            return none;
                        }
                        match rv {
                            OptValueId::Some(r) => {
                                ret = r;
                            }
                            OptValueId::None => {
                                return none;
                            }
                        }
                    }
                    _ => {
                        if !iro_inlinable_inst(inst) {
                            return none;
                        }
                        body.push(id);
                    }
                }
            }
            OptInst::None => {
                return none;
            }
        }
        i = i + 1;
    }
    if ret < 0 {
        return none;
    }
    return IroBody {
        insts: body, ret: ret
    };
}

/// DB8: inlining remarks (`fid emit --remarks`): why a call iro_inline met
/// was not inlined, one line per caller, callee and reason.
var g_iro_remarks_on: bool = false;
var g_iro_remarks: Vec<str> = Vec::new();
var g_iro_remark_seen: i64 = 0;

/// Record why calls are not inlined (main.fd, for --remarks).
pub fn iropt_set_remarks() {
    g_iro_remarks_on = true;
}

/// SP18: stop recording remarks (main.fd serve_reset_backend_state, so a
/// `--remarks` request of `fid serve` does not leave them on for the next).
pub fn iropt_clear_remarks() {
    g_iro_remarks_on = false;
}

/// The inlining remarks of the last iropt_native whose caller's name
/// contains `filt` ("" = all).
pub fn iropt_inline_remarks(filt: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < g_iro_remarks.len() {
        var line: str = g_iro_remarks.get(i);
        if str_len(filt) == 0 || str_find(line, filt) >= 0 {
            out.push(line);
        }
        i = i + 1;
    }
    return out;
}

/// Why iro_body does not inline `callee` into `caller` (its tests in its
/// order), or "" when it would.
fn iro_not_inlined_why(callee: &IrFunction, caller: &IrFunction, site: i64) -> str {
    if callee.blocks.len() != 1 {
        return "more than one block (" + int_to_str(callee.blocks.len()) + "): only straight-line callees are inlined";
    }
    if callee.name == caller.name {
        return "recursive";
    }
    if callee.name == "main" {
        return "main";
    }
    if callee.is_interrupt {
        return "an interrupt handler";
    }
    if callee.is_wrapping != caller.is_wrapping {
        return "@wrapping differs between caller and callee";
    }
    if callee.is_constant_time && !caller.is_constant_time {
        return "@constant_time code is checked in its own function";
    }
    if callee.zeroize_locals.len() > 0 || callee.drop_locals.len() > 0 {
        return "it zeroizes or drops locals at its end";
    }
    if callee.has_secret && !caller.has_secret {
        return "it holds @secret values and the caller's frame is not wiped";
    }
    if callee.persist_vars.len() > 0 {
        return "it has persist variables";
    }
    if !iro_is_scalar(callee.ret_ty) {
        return "its result is not a scalar";
    }
    var ids: Vec<i64> = callee.blocks.get(0).instructions;
    if ids.len() == 0 {
        return "empty body";
    }
    if ids.len() > iro_inline_limit(callee.name, caller.name, site) {
        return "too large (" + int_to_str(ids.len()) + " instructions, the limit is " + int_to_str(iro_inline_limit(callee.name, caller.name, site)) + ")";
    }
    var i: i64 = 0;
    while i < ids.len() {
        match IrFunction_get_inst(callee, ids.get(i)) {
            OptInst::Some(inst) => {
                match inst {
                    Inst::Return(rv) => {
                        if i + 1 != ids.len() {
                            return "a return before its end";
                        }
                        match rv {
                            OptValueId::Some(_) => {
                            }
                            OptValueId::None => {
                                return "it returns no value";
                            }
                        }
                    }
                    _ => {
                        if !iro_inlinable_inst(inst) {
                            return "it does " + inst_kind_name(&inst) + " (calls, prints, memory and regions are not inlined)";
                        }
                    }
                }
            }
            OptInst::None => {
                return "a missing instruction";
            }
        }
        i = i + 1;
    }
    return "";
}

/// Note why `callee` was not inlined into `caller` (once per pair).
fn iro_remark_inline(caller: &IrFunction, callee: &IrFunction, why: str) {
    if str_len(why) == 0 {
        return;
    }
    if g_iro_remark_seen == 0 {
        g_iro_remark_seen = HashMap_new();
    }
    var key: str = caller.name + "|" + callee.name;
    if HashMap_contains(g_iro_remark_seen, key) {
        return;
    }
    HashMap_insert(g_iro_remark_seen, key, 1);
    g_iro_remarks.push("fn " + caller.name + ": call to " + callee.name + " not inlined: " + why);
}

/// Inline small functions at their call sites, in every function.
pub fn iro_inline(module: &mut IrModule) {
    iro_inline_in(module, 0);
}

/// SP3: iro_inline into the functions `reach` (iro_mid_reach) holds only;
/// `reach` 0: every function.
pub fn iro_inline_in(module: &mut IrModule, reach: i64) {
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(fi);
        if !iro_in_reach(reach, entry.name) {
            fi = fi + 1;
            continue;
        }
        var f: IrFunction = entry.func;
        if iro_inline_function(module, &mut f) {
            entry.func = f;
            module.functions.set(fi, entry);
        }
        fi = fi + 1;
    }
}

fn iro_inline_function(module: &IrModule, f: &mut IrFunction) -> bool {
    var changed: bool = false;
    var b: i64 = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var old: Vec<i64> = blk.instructions;
        var fresh: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < old.len() {
            var id: i64 = old.get(k);
            var done: bool = false;
            match IrFunction_get_inst(f, id) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::Call(name, args, cty, _) => {
                            if iro_is_scalar(cty) {
                                match IrModule_get_function(module, name) {
                                    OptIrFunction::Some(callee) => {
                                        // OP30: the call's block weighs it (a block profile)
                                        var body: IroBody = iro_body(&callee, f, blk.id);
                                        if g_iro_remarks_on && body.ret < 0 {
                                            iro_remark_inline(f, &callee, iro_not_inlined_why(&callee, f, blk.id));
                                        }
                                        if body.ret >= 0 && callee.params.len() == args.len() {
                                            // callee value -> caller value + 1
                                            var map: Vec<i64> = Vec::new();
                                            var z: i64 = 0;
                                            while z < callee.next_value {
                                                map.push(0);
                                                z = z + 1;
                                            }
                                            var p: i64 = 0;
                                            while p < callee.params.len() {
                                                var pid: i64 = callee.params.get(p).id;
                                                if pid >= 0 && pid < map.len() {
                                                    map.set(pid, args.get(p) + 1);
                                                }
                                                p = p + 1;
                                            }
                                            var q: i64 = 0;
                                            while q < body.insts.len() {
                                                var cid: i64 = body.insts.get(q);
                                                match IrFunction_get_inst(&callee, cid) {
                                                    OptInst::Some(cinst) => {
                                                        var nid: i64 = iro_detached(f, iro_remap(cinst, map));
                                                        // the callee's source line (a panic in inlined
                                                        // code says where, as the interpreter does)
                                                        iro_copy_line(&callee, cid, f, nid);
                                                        if cid < map.len() {
                                                            map.set(cid, nid + 1);
                                                        }
                                                        fresh.push(nid);
                                                    }
                                                    OptInst::None => {
                                                    }
                                                }
                                                q = q + 1;
                                            }
                                            // The call is now a move of the inlined result
                                            IrFunction_set_inst(f, id, Inst::BitCast(iro_m(map, body.ret), cty, cty));
                                            fresh.push(id);
                                            done = true;
                                            changed = true;
                                        }
                                    }
                                    OptIrFunction::None => {
                                    }
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            if !done {
                fresh.push(id);
            }
            k = k + 1;
        }
        blk.instructions = fresh;
        f.blocks.set(b, blk);
        b = b + 1;
    }
    return changed;
}

// --- Constant folding (release D6) ------------------------------------------

fn iro_const_int(f: &IrFunction, id: i64) -> OptI64 {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::ConstInt(v, t) => {
                    match t {
                        IrType::I64 => {
                            return OptI64::Some(v);
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return OptI64::None;
}

const IRO_I64_MAX: i64 = 9223372036854775807;
const IRO_SQRT_MAX: i64 = 3037000499;
/// Fold integer BinOps of two i64 constants. Arithmetic is folded only when
/// it cannot overflow (an overflow must still panic at run time), division
/// and remainder never (a zero divisor must panic too).
fn iro_fold(f: &mut IrFunction) -> bool {
    var changed: bool = false;
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            match IrFunction_get_inst(f, id) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::BinOp(op, l, r, t) => {
                            match iro_const_int(f, l) {
                                OptI64::Some(a) => {
                                    match iro_const_int(f, r) {
                                        OptI64::Some(c) => {
                                            var folded: OptInst = iro_fold_binop(op, a, c, t);
                                            match folded {
                                                OptInst::Some(ni) => {
                                                    IrFunction_set_inst(f, id, ni);
                                                    changed = true;
                                                }
                                                OptInst::None => {
                                                }
                                            }
                                        }
                                        OptI64::None => {
                                        }
                                    }
                                }
                                OptI64::None => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return changed;
}

fn iro_fold_binop(op: BinOp, a: i64, c: i64, t: IrType) -> OptInst {
    var is_i64: bool = false;
    match t {
        IrType::I64 => {
            is_i64 = true;
        }
        _ => {
        }
    }
    if binop_eq(op, BinOp::Eq) {
        return OptInst::Some(Inst::ConstBool(a == c));
    }
    if binop_eq(op, BinOp::Neq) {
        return OptInst::Some(Inst::ConstBool(a != c));
    }
    if binop_eq(op, BinOp::Lt) {
        return OptInst::Some(Inst::ConstBool(a < c));
    }
    if binop_eq(op, BinOp::Gt) {
        return OptInst::Some(Inst::ConstBool(a > c));
    }
    if binop_eq(op, BinOp::LtEq) {
        return OptInst::Some(Inst::ConstBool(a <= c));
    }
    if binop_eq(op, BinOp::GtEq) {
        return OptInst::Some(Inst::ConstBool(a >= c));
    }
    if !is_i64 {
        return OptInst::None;
    }
    if binop_eq(op, BinOp::Add) {
        if (c > 0 && a > IRO_I64_MAX - c) || (c < 0 && a < (0 - IRO_I64_MAX - 1) - c) {
            return OptInst::None;
        }
        return OptInst::Some(Inst::ConstInt(a + c, t));
    }
    if binop_eq(op, BinOp::Sub) {
        if (c < 0 && a > IRO_I64_MAX + c) || (c > 0 && a < (0 - IRO_I64_MAX - 1) + c) {
            return OptInst::None;
        }
        return OptInst::Some(Inst::ConstInt(a - c, t));
    }
    if binop_eq(op, BinOp::Mul) {
        if a > IRO_SQRT_MAX || a < 0 - IRO_SQRT_MAX || c > IRO_SQRT_MAX || c < 0 - IRO_SQRT_MAX {
            return OptInst::None;
        }
        return OptInst::Some(Inst::ConstInt(a * c, t));
    }
    if binop_eq(op, BinOp::BitAnd) {
        return OptInst::Some(Inst::ConstInt(a & c, t));
    }
    if binop_eq(op, BinOp::BitOr) {
        return OptInst::Some(Inst::ConstInt(a | c, t));
    }
    if binop_eq(op, BinOp::BitXor) {
        return OptInst::Some(Inst::ConstInt(a ^ c, t));
    }
    return OptInst::None;
}

// --- Dead values (release D6) -----------------------------------------------

fn iro_pure(inst: Inst) -> bool {
    match inst {
        Inst::ConstInt(_, _) => {
            return true;
        }
        Inst::ConstFloat(_, _) => {
            return true;
        }
        Inst::ConstBool(_) => {
            return true;
        }
        Inst::ConstStr(_) => {
            return true;
        }
        Inst::ConstNull(_) => {
            return true;
        }
        Inst::ConstFnRef(_) => {
            return true;
        }
        Inst::GlobalAddr(_, _) => {
            return true;
        }
        Inst::GetFieldPtr(_, _, _) => {
            return true;
        }
        Inst::BitCast(_, _, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// Drop pure values nothing reads (folding leaves their operands unused).
fn iro_dce(f: &mut IrFunction) -> bool {
    var any: bool = false;
    var round: i64 = 0;
    while round < 3 {
        var uses: Vec<i64> = Vec::new();
        var z: i64 = 0;
        while z < f.next_value {
            uses.push(0);
            z = z + 1;
        }
        var b: i64 = 0;
        while b < f.blocks.len() {
            var ids: Vec<i64> = f.blocks.get(b).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                match IrFunction_get_inst(f, ids.get(k)) {
                    OptInst::Some(inst) => {
                        var ops: Vec<i64> = Vec::new();
                        peir_inst_operands(inst, &mut ops);
                        var o: i64 = 0;
                        while o < ops.len() {
                            var v: i64 = ops.get(o);
                            if v >= 0 && v < uses.len() {
                                uses.set(v, uses.get(v) + 1);
                            }
                            o = o + 1;
                        }
                    }
                    OptInst::None => {
                    }
                }
                k = k + 1;
            }
            b = b + 1;
        }
        var removed: bool = false;
        b = 0;
        while b < f.blocks.len() {
            var blk: BasicBlock = f.blocks.get(b);
            var keep: Vec<i64> = Vec::new();
            var k: i64 = 0;
            while k < blk.instructions.len() {
                var id: i64 = blk.instructions.get(k);
                var drop: bool = false;
                if id >= 0 && id < uses.len() && uses.get(id) == 0 {
                    match IrFunction_get_inst(f, id) {
                        OptInst::Some(inst) => {
                            drop = iro_pure(inst);
                        }
                        OptInst::None => {
                        }
                    }
                }
                if drop {
                    removed = true;
                } else {
                    keep.push(id);
                }
                k = k + 1;
            }
            if removed {
                blk.instructions = keep;
                f.blocks.set(b, blk);
            }
            b = b + 1;
        }
        if !removed {
            return any;
        }
        any = true;
        round = round + 1;
    }
    return any;
}

// --- Induction-variable strength reduction (OP10) ----------------------------

const IRO_IV: bool = true;
fn iro_iv_dbg() -> bool {
    var d: str = p_getenv("FID_IV_DBG");
    return (d as i64) != 0 && str_len(d) > 0;
}

/// Insert a detached instruction into block `bi` at position `pos`.
fn iro_iv_insert(f: &mut IrFunction, bi: i64, pos: i64, inst: Inst) -> i64 {
    var id: i64 = iro_detached(f, inst);
    var blk: BasicBlock = f.blocks.get(bi);
    var ids: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < blk.instructions.len() {
        if k == pos {
            ids.push(id);
        }
        ids.push(blk.instructions.get(k));
        k = k + 1;
    }
    if pos >= blk.instructions.len() {
        ids.push(id);
    }
    blk.instructions = ids;
    f.blocks.set(bi, blk);
    return id;
}

/// `id` as a `Load` of local `loc`, or -1.
fn iro_iv_load_of(f: &IrFunction, id: i64, loc: i64) -> bool {
    match peir_inst_of(f, id) {
        Inst::Load(p, _) => {
            return p == loc;
        }
        _ => {
        }
    }
    return false;
}

/// `sv` as `Load(loc) + ConstInt` or `Load(loc) - ConstInt`: the step, or none.
fn iro_iv_step(f: &IrFunction, sv: i64, loc: i64) -> OptI64 {
    match peir_inst_of(f, sv) {
        Inst::BinOp(op, a, b, _) => {
            var sgn: i64 = 0;
            var cid: i64 = -1;
            if binop_eq(op, BinOp::Add) {
                if iro_iv_load_of(f, a, loc) {
                    cid = b;
                    sgn = 1;
                } else if iro_iv_load_of(f, b, loc) {
                    cid = a;
                    sgn = 1;
                }
            } else if binop_eq(op, BinOp::Sub) {
                if iro_iv_load_of(f, a, loc) {
                    cid = b;
                    sgn = -1;
                }
            }
            if cid < 0 {
                return OptI64::None;
            }
            match iro_const_int(f, cid) {
                OptI64::Some(d) => {
                    if sgn < 0 {
                        return OptI64::Some(0 - d);
                    }
                    return OptI64::Some(d);
                }
                OptI64::None => {
                }
            }
        }
        _ => {
        }
    }
    return OptI64::None;
}

/// One loop: find `L = L +/- d` locals stored once, shadow `Load(L)*c`
/// multiplies proved non-overflowing with a local bumped `c*d` at the
/// same store — the shadow and the product stay in the same epoch
/// because the multiply's load and the multiply sit in one block with
/// no `Store(L)` between them.
fn iro_iv_loop(f: &mut IrFunction, cfg: &IroCfg, head: i64, lat: Vec<i64>, lbody: Vec<i64>, plain: Vec<i64>, flags: Vec<i64>) -> bool {
    var n: i64 = f.blocks.len();
    var dbg: bool = iro_iv_dbg();
    if dbg {
        p_eprint_str("iv: " + f.name + " loop head " + int_to_str(head) + " latches " + int_to_str(lat.len()) + "\n");
    }
    // ME2: the body the shared loop tree found (iro_loop_body)
    var body: Vec<i64> = lbody;
    var i: i64 = 0;
    // OP10: shadows outside @wrapping code, for multiplies bounded by the
    // loop's test (iro_iv_bounded)
    var bounded_ok: bool = !iro_named_off(p_getenv("FID_IROPT_OFF"), "ivbound");
    // The one outside predecessor of the header, ending in a jump
    var pre: i64 = -1;
    var hp: Vec<i64> = cfg.preds.get(head);
    i = 0;
    while i < hp.len() {
        if body.get(hp.get(i)) == 0 {
            if pre >= 0 && pre != hp.get(i) {
                return false;
            }
            pre = hp.get(i);
        }
        i = i + 1;
    }
    if pre < 0 {
        if dbg {
            p_eprint_str("iv: " + f.name + " head " + int_to_str(head) + ": no unique preheader\n");
        }
        return false;
    }
    var pids: Vec<i64> = f.blocks.get(pre).instructions;
    if pids.len() == 0 {
        return false;
    }
    match peir_inst_of(f, pids.get(pids.len() - 1)) {
        Inst::Jump(_) => {
        }
        _ => {
            if dbg {
                p_eprint_str("iv: " + f.name + " head " + int_to_str(head) + ": preheader not a jump\n");
            }
            return false;
        }
    }
    // Induction locals: plain, i64, stored exactly once as L = L +/- d
    var iv_loc: Vec<i64> = Vec::new();
    var iv_step: Vec<i64> = Vec::new();
    var iv_sb: Vec<i64> = Vec::new();
    var iv_sk: Vec<i64> = Vec::new();
    var nstores: Vec<i64> = peir_zeros(f.next_value + 1);
    var b: i64 = 0;
    while b < n {
        if body.get(b) == 1 {
            var ids: Vec<i64> = f.blocks.get(b).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                match peir_inst_of(f, ids.get(k)) {
                    Inst::Store(p, _, _) => {
                        if p >= 0 && p < nstores.len() {
                            nstores.set(p, nstores.get(p) + 1);
                        }
                    }
                    _ => {
                    }
                }
                k = k + 1;
            }
        }
        b = b + 1;
    }
    b = 0;
    while b < n {
        if body.get(b) == 1 {
            var ids2: Vec<i64> = f.blocks.get(b).instructions;
            var k2: i64 = 0;
            while k2 < ids2.len() {
                match peir_inst_of(f, ids2.get(k2)) {
                    Inst::Store(p, sv, _) => {
                        if p >= 0 && p < plain.len() && plain.get(p) == 1 && nstores.get(p) == 1 {
                            match iro_iv_step(f, sv, p) {
                                OptI64::Some(d) => {
                                    if d != 0 {
                                        iv_loc.push(p);
                                        iv_step.push(d);
                                        iv_sb.push(b);
                                        iv_sk.push(k2);
                                    }
                                }
                                OptI64::None => {
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                k2 = k2 + 1;
            }
        }
        b = b + 1;
    }
    if iv_loc.len() == 0 {
        if dbg {
            p_eprint_str("iv: " + f.name + " head " + int_to_str(head) + ": no induction locals\n");
        }
        return false;
    }
    // Candidate multiplies: w = Load(L) * ConstInt, proved unchecked
    var changed: bool = false;
    var sh_loc: Vec<i64> = Vec::new();
    // per shadow: which iv, which c, the slot
    var sh_iv: Vec<i64> = Vec::new();
    var sh_c: Vec<i64> = Vec::new();
    var sh_slot: Vec<i64> = Vec::new();
    b = 0;
    while b < n {
        if body.get(b) == 1 {
            var ids3: Vec<i64> = f.blocks.get(b).instructions;
            var k3: i64 = 0;
            while k3 < ids3.len() {
                var w: i64 = ids3.get(k3);
                match peir_inst_of(f, w) {
                    Inst::BinOp(op, a, bb, t) => {
                        // Gate: wrapping functions only. The shadow add
                        // computes next_i*c one iteration ahead; under
                        // checked semantics that early product can trap
                        // where the original multiply never ran — even a
                        // proved-unchecked multiply only bounds values on
                        // iterations that execute it. Under @wrapping
                        // ic == i*c mod 2^64 unconditionally.
                        // OP10 (Nov 16): outside @wrapping code too, when
                        // the loop's test bounds L so that no shadow value
                        // can overflow (checks.fd iro_iv_bounded, below;
                        // FID_IROPT_OFF=ivbound: @wrapping only again)
                        if binop_eq(op, BinOp::Mul) && ir_type_eq(t, IrType::I64) {
                            if f.is_wrapping || bounded_ok {
                                var vi: i64 = -1;
                                var ci: i64 = -1;
                                var li: i64 = -1;
                                // operand forms: Mul(load, const) or Mul(const, load)
                                i = 0;
                                while i < iv_loc.len() {
                                    var loc2: i64 = iv_loc.get(i);
                                    if iro_iv_load_of(f, a, loc2) {
                                        vi = i;
                                        ci = bb;
                                        li = a;
                                    } else if iro_iv_load_of(f, bb, loc2) {
                                        vi = i;
                                        ci = a;
                                        li = bb;
                                    }
                                    i = i + 1;
                                }
                                if vi >= 0 && ci >= 0 {
                                    match iro_const_int(f, ci) {
                                        OptI64::Some(c) => {
                                            // the load must be in this block, before
                                            // w, with no Store(L) between them
                                            var lp: i64 = -1;
                                            var stp: i64 = -1;
                                            var loc3: i64 = iv_loc.get(vi);
                                            var k4: i64 = 0;
                                            while k4 < ids3.len() {
                                                if ids3.get(k4) == li {
                                                    lp = k4;
                                                }
                                                if k4 > lp && lp >= 0 {
                                                    match peir_inst_of(f, ids3.get(k4)) {
                                                        Inst::Store(sp2, _, _) => {
                                                            if sp2 == loc3 && k4 < k3 {
                                                                stp = k4;
                                                            }
                                                        }
                                                        _ => {
                                                        }
                                                    }
                                                }
                                                k4 = k4 + 1;
                                            }
                                            var fits: bool = f.is_wrapping;
                                            if !fits && lp >= 0 && lp < k3 && stp < 0 {
                                                fits = iro_iv_bounded(f, cfg, body, head, pre, loc3, iv_step.get(vi), iv_sb.get(vi), c);
                                                if dbg && !fits {
                                                    p_eprint_str("iv: " + f.name + " mul kept: L not bounded by the loop's test\n");
                                                }
                                            }
                                            if lp >= 0 && lp < k3 && stp < 0 && fits {
                                                // shadow for (iv, c) once
                                                var si: i64 = -1;
                                                i = 0;
                                                while i < sh_loc.len() {
                                                    if sh_iv.get(i) == vi && sh_c.get(i) == c {
                                                        si = i;
                                                    }
                                                    i = i + 1;
                                                }
                                                var slot: i64 = -1;
                                                if si < 0 {
                                                    slot = iro_iv_insert(f, 0, 0, Inst::Alloca(IrType::I64, Region::Stack));
                                                    var lastp: i64 = f.blocks.get(pre).instructions.len() - 1;
                                                    var l0: i64 = iro_iv_insert(f, pre, lastp, Inst::Load(loc3, IrType::I64));
                                                    var c0: i64 = iro_iv_insert(f, pre, lastp + 1, Inst::ConstInt(c, IrType::I64));
                                                    var m0: i64 = iro_iv_insert(f, pre, lastp + 2, Inst::BinOp(BinOp::Mul, l0, c0, IrType::I64));
                                                    iro_iv_insert(f, pre, lastp + 3, Inst::Store(slot, m0, OptIrType::None));
                                                    var sb: i64 = iv_sb.get(vi);
                                                    var sk: i64 = iv_sk.get(vi) + 1;
                                                    var u0: i64 = iro_iv_insert(f, sb, sk, Inst::Load(slot, IrType::I64));
                                                    var d0: i64 = iro_iv_insert(f, sb, sk + 1, Inst::ConstInt(c * iv_step.get(vi), IrType::I64));
                                                    var a0: i64 = iro_iv_insert(f, sb, sk + 2, Inst::BinOp(BinOp::Add, u0, d0, IrType::I64));
                                                    iro_iv_insert(f, sb, sk + 3, Inst::Store(slot, a0, OptIrType::None));
                                                    sh_iv.push(vi);
                                                    sh_c.push(c);
                                                    sh_loc.push(0);
                                                    sh_slot.push(slot);
                                                } else {
                                                    slot = sh_slot.get(si);
                                                }
                                                IrFunction_set_inst(f, w, Inst::Load(slot, IrType::I64));
                                                changed = true;
                                            } else if dbg {
                                                p_eprint_str("iv: " + f.name + " mul rejected: lp=" + int_to_str(lp) + " stp=" + int_to_str(stp) + " k3=" + int_to_str(k3) + "\n");
                                            }
                                        }
                                        OptI64::None => {
                                            if dbg {
                                                p_eprint_str("iv: " + f.name + " mul: rhs not const\n");
                                            }
                                        }
                                    }
                                } else if dbg {
                                    p_eprint_str("iv: " + f.name + " mul: no iv load operand\n");
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                k3 = k3 + 1;
            }
        }
        b = b + 1;
    }
    return changed;
}

fn iro_iv(f: &mut IrFunction) -> bool {
    var cfg: IroCfg = iro_cfg(f);
    if cfg.n == 0 {
        return false;
    }
    // ME2: the shared loop tree (back edges to a dominating header); a
    // function without loops skips the facts below
    var loops: IroLoops = iro_loops(&cfg);
    if loops.headers.len() == 0 {
        return false;
    }
    var latches: Vec<Vec<i64>> = loops.latches;
    var plain: Vec<i64> = iro_plain_locals(f);
    var flags: Vec<i64> = peir_unchecked_ops(f, f.next_value + 1);
    if iro_iv_dbg() {
        p_eprint_str("iv: " + f.name + " has loops, wrapping=" + int_to_str(f.is_wrapping as i64) + "\n");
    }
    var changed: bool = false;
    var head: i64 = cfg.n - 1;
    while head >= 0 {
        if latches.get(head).len() > 0 {
            if iro_iv_loop(f, &cfg, head, latches.get(head), iro_loop_body(&loops, head), plain, flags) {
                changed = true;
            }
        }
        head = head - 1;
    }
    return changed;
}

// --- Loop-invariant code motion ---------------------------------------------

const IRO_LICM: bool = true;
/// A local only loads and stores use (its address goes nowhere).
fn iro_plain_locals(f: &IrFunction) -> Vec<i64> {
    var plain: Vec<i64> = peir_zeros(f.next_value + 1);
    var i: i64 = 0;
    while i < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(i);
        match ve.inst {
            Inst::Alloca(_, _) => {
                if ve.id >= 0 && ve.id < plain.len() {
                    plain.set(ve.id, 1);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        var inst: Inst = f.insts.get(i).inst;
        var ops: Vec<i64> = Vec::new();
        peir_inst_operands(inst, &mut ops);
        var o: i64 = 0;
        while o < ops.len() {
            var v: i64 = ops.get(o);
            if v >= 0 && v < plain.len() && plain.get(v) == 1 {
                var ok: bool = false;
                match inst {
                    Inst::Load(p, _) => {
                        ok = p == v;
                    }
                    Inst::Store(p, sv, _) => {
                        ok = p == v && sv != v;
                    }
                    _ => {
                    }
                }
                if !ok {
                    plain.set(v, 0);
                }
            }
            o = o + 1;
        }
        i = i + 1;
    }
    return plain;
}

/// Calls a loop may make while its Vecs keep their lengths.
fn iro_len_safe_call(name: str) -> bool {
    return name == "Vec_get" || name == "Vec_set" || name == "Vec_len" || name == "p_vec_get" || name == "p_vec_set" || name == "p_vec_len";
}

/// Can `inst`, standing before another instruction of a loop header, be
/// passed over by that instruction when it moves to the preheader? It
/// must neither panic nor do anything a caller could see (iro_removable:
/// constants, address arithmetic, comparisons, bit operations, widening, a
/// load of a plain local), or be a stack slot.
fn iro_licm_quiet(inst: Inst, plain: &Vec<i64>) -> bool {
    match inst {
        Inst::Alloca(_, _) => {
            return true;
        }
        _ => {
        }
    }
    return iro_removable(inst, plain);
}

/// Is value `id` of `f` a constant (no operands: it may move to any block
/// that dominates its use)?
fn iro_licm_const(f: &IrFunction, id: i64) -> bool {
    match peir_inst_of(f, id) {
        Inst::ConstInt(_, _) => {
            return true;
        }
        Inst::ConstBool(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// `xs` without the element `v`.
fn iro_vec_without(xs: Vec<i64>, v: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < xs.len() {
        if xs.get(i) != v {
            out.push(xs.get(i));
        }
        i = i + 1;
    }
    return out;
}

/// How many times each value of `f` is read by an instruction of a block.
fn iro_use_counts(f: &IrFunction) -> Vec<i64> {
    var cnt: Vec<i64> = peir_zeros(f.next_value + 1);
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var ops: Vec<i64> = Vec::new();
            peir_inst_operands(peir_inst_of(f, ids.get(k)), &mut ops);
            var o: i64 = 0;
            while o < ops.len() {
                var v: i64 = ops.get(o);
                if v >= 0 && v < cnt.len() {
                    cnt.set(v, cnt.get(v) + 1);
                }
                o = o + 1;
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return cnt;
}

/// VF6 (--validate): tell the validator which calls of `f` LICM may move
/// by the effect masks (tv.fd tv_licm trusts them, as it trusts the call
/// sites' effect annotations): 2 a quiet call, 1 one with no effect but a
/// panic.
fn iro_tv_licm_calls(module: &IrModule, masks: &Vec<i64>, f: &IrFunction) {
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            match peir_inst_of(f, ids.get(k)) {
                Inst::Call(cn, _cargs, crt, ce) => {
                    if iro_quiet_call(module, masks, cn, &ce, crt, false) && !ir_type_eq(crt, IrType::Void) {
                        tv_trust_call(cn, 2);
                    } else if iro_licm_pure_call(module, masks, cn, &ce, crt) {
                        tv_trust_call(cn, 1);
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
}

/// OP25: a call LICM may move out of a loop's header: a program function
/// (not a runtime or backend one, which the backends may give meanings the
/// IR does not show) that, transitively, reads, writes, allocates and
/// prints nothing (iro_effect_masks); a panic is allowed (iro_licm_loop
/// keeps it where it would have been seen). Its result is an integer or a
/// bool, so no owner or drop goes with it.
fn iro_licm_pure_call(module: &IrModule, masks: &Vec<i64>, name: str, site: &EffectSet, ret: IrType) -> bool {
    if masks.len() == 0 {
        return false;
    }
    if str_starts_with(name, "p_") || str_starts_with(name, "pe_") || str_starts_with(name, "pert_") || str_starts_with(name, "nat_") || str_starts_with(name, "__") {
        return false;
    }
    if !(ir_type_is_int(ret) || ir_type_eq(ret, IrType::Bool)) {
        return false;
    }
    var m: i64 = iro_call_mask(module, masks, name, site);
    return (m | IRO_EB_DIVERGE) == IRO_EB_DIVERGE;
}

/// Loop-invariant code motion (OP9). `masks` is iro_effect_masks(module)
/// (empty: no call but `len` moves, OP25).
fn iro_licm(module: &IrModule, masks: &Vec<i64>, f: &mut IrFunction) -> bool {
    if f.blocks.len() < 2 {
        return false;
    }
    // ME2: the shared CFG and loop tree (a loop: back edges to a header
    // that dominates them)
    var cfg: IroCfg = iro_cfg(f);
    var n: i64 = cfg.n;
    var loops: IroLoops = iro_loops(&cfg);
    if loops.headers.len() == 0 {
        return false;
    }
    var preds: Vec<Vec<i64>> = cfg.preds;
    var latches: Vec<Vec<i64>> = loops.latches;
    var b: i64 = 0;
    var plain: Vec<i64> = iro_plain_locals(f);
    // moving changes no value's readers: counted once
    var uses: Vec<i64> = iro_use_counts(f);
    // Which block defines each value (-1: a parameter, or none)
    var def_b: Vec<i64> = Vec::new();
    while def_b.len() <= f.next_value {
        def_b.push(-1);
    }
    b = 0;
    while b < n {
        var ids2: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids2.len() {
            var id: i64 = ids2.get(k);
            if id >= 0 && id < def_b.len() {
                def_b.set(id, b);
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var changed: bool = false;
    var head: i64 = n - 1;
    while head >= 0 {
        if latches.get(head).len() > 0 {
            if iro_licm_loop(module, masks, f, head, iro_loop_body(&loops, head), preds, n, plain, uses, &mut def_b) {
                changed = true;
            }
        }
        head = head - 1;
    }
    return changed;
}

// What moves out of a loop. From any block of the loop, what can neither
// panic nor be seen (comparisons, bit operations, loads of locals the loop
// never stores, `len` of a Vec it cannot resize). From the header only
// (OP9, OP25), also what may panic: integer arithmetic (`n - 1`, `t / k`)
// and calls to functions with no effect but a panic, when every operand
// comes from outside the loop and every instruction left before it in the
// header is quiet (iro_licm_quiet). The header runs each time the loop is
// entered, before anything else of the loop, so the moved value is
// computed, and its panic raised, at the same point as the first time it
// was, with nothing a program could see in between; and its operands do
// not change, so every later iteration would compute the same value.
fn iro_licm_loop(module: &IrModule, masks: &Vec<i64>, f: &mut IrFunction, head: i64, lbody: Vec<i64>, preds: Vec<Vec<i64>>, n: i64, plain: Vec<i64>, uses: Vec<i64>, def_b: &mut Vec<i64>) -> bool {
    // ME2: the loop's blocks from the shared loop tree (iro_loop_body)
    var body: Vec<i64> = lbody;
    var i: i64 = 0;
    // The one block that enters the loop, by a jump to its header
    var pre: i64 = -1;
    var hp: Vec<i64> = preds.get(head);
    i = 0;
    while i < hp.len() {
        if body.get(hp.get(i)) == 0 {
            if pre >= 0 && pre != hp.get(i) {
                return false;
            }
            pre = hp.get(i);
        }
        i = i + 1;
    }
    if pre < 0 {
        return false;
    }
    var pids: Vec<i64> = f.blocks.get(pre).instructions;
    if pids.len() == 0 {
        return false;
    }
    match peir_inst_of(f, pids.get(pids.len() - 1)) {
        Inst::Jump(_) => {
        }
        _ => {
            return false;
        }
    }
    // What the loop writes: the locals it stores, whether it calls anything
    // that could resize a Vec
    var stored: Vec<i64> = peir_zeros(f.next_value + 1);
    var resizes: bool = false;
    var b: i64 = 0;
    while b < n {
        if body.get(b) == 1 {
            var ids: Vec<i64> = f.blocks.get(b).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                match peir_inst_of(f, ids.get(k)) {
                    Inst::Store(p, _, _) => {
                        if p >= 0 && p < stored.len() {
                            stored.set(p, 1);
                        }
                    }
                    Inst::Call(cn, _, _, _) => {
                        if !iro_len_safe_call(cn) {
                            resizes = true;
                        }
                    }
                    Inst::CallPtr(_, _, _, _, _) => {
                        resizes = true;
                    }
                    Inst::DynCall(_, _, _, _, _) => {
                        resizes = true;
                    }
                    _ => {
                    }
                }
                k = k + 1;
            }
        }
        b = b + 1;
    }
    var hoisted: Vec<i64> = Vec::new();
    var round: i64 = 0;
    while round < 4 {
        var moved: bool = false;
        b = 0;
        while b < n {
            if body.get(b) == 1 {
                var blk: BasicBlock = f.blocks.get(b);
                var keep: Vec<i64> = Vec::new();
                // the header, with only quiet instructions kept before this
                // one: what may panic can move too (see above)
                var quiet: bool = b == head;
                var k2: i64 = 0;
                while k2 < blk.instructions.len() {
                    var id: i64 = blk.instructions.get(k2);
                    var inst: Inst = peir_inst_of(f, id);
                    var can: bool = false;
                    match inst {
                        Inst::Load(p, _) => {
                            can = p >= 0 && p < plain.len() && plain.get(p) == 1 && stored.get(p) == 0;
                        }
                        Inst::Call(cn, _args, crt, ce) => {
                            // `len` of a Vec from outside the loop (its
                            // arguments, the env constant included, are
                            // checked below with every operand)
                            can = (cn == "Vec_len" || cn == "p_vec_len") && !resizes;
                            if !can {
                                // OP25: a call with no effect but a panic
                                // (its arguments are checked below)
                                can = quiet && iro_licm_pure_call(module, masks, cn, &ce, crt);
                            }
                            if !can {
                                // OP25 (quietcall): from any block, a call
                                // that ends, never panics and touches no
                                // memory: running it ahead of time changes
                                // nothing but when its value is computed
                                can = iro_quiet_call(module, masks, cn, &ce, crt, false) && !ir_type_eq(crt, IrType::Void);
                            }
                        }
                        Inst::UnaryOp(_, _, uty) => {
                            // `-x` may overflow: from the header only
                            can = quiet && !ir_type_is_float(uty);
                        }
                        Inst::BinOp(op, _, _, ty) => {
                            // from anywhere, only what cannot trap: comparisons
                            // and bit operations; from the header, any integer
                            // operation (OP9: checked arithmetic, division)
                            if quiet && !ir_type_is_float(ty) {
                                can = true;
                            }
                            if !ir_type_is_float(ty) {
                                match op {
                                    BinOp::Eq => {
                                        can = true;
                                    }
                                    BinOp::Neq => {
                                        can = true;
                                    }
                                    BinOp::Lt => {
                                        can = true;
                                    }
                                    BinOp::Gt => {
                                        can = true;
                                    }
                                    BinOp::LtEq => {
                                        can = true;
                                    }
                                    BinOp::GtEq => {
                                        can = true;
                                    }
                                    BinOp::BitAnd => {
                                        can = true;
                                    }
                                    BinOp::BitOr => {
                                        can = true;
                                    }
                                    BinOp::BitXor => {
                                        can = true;
                                    }
                                    _ => {
                                    }
                                }
                            }
                        }
                        Inst::IntExtend(_, _, _) => {
                            can = true;
                        }
                        Inst::BitCast(_, _, _) => {
                            can = true;
                        }
                        _ => {
                        }
                    }
                    // constants of the loop that only this instruction reads
                    // move with it (lowering makes one per use: `n - 1`'s 1
                    // sits in the header)
                    var cdeps: Vec<i64> = Vec::new();
                    if can {
                        // every operand from outside the loop (or already moved)
                        var ops: Vec<i64> = Vec::new();
                        peir_inst_operands(inst, &mut ops);
                        var o: i64 = 0;
                        while o < ops.len() {
                            var ov: i64 = ops.get(o);
                            if ov >= 0 && ov < def_b.len() && def_b.get(ov) >= 0 && body.get(def_b.get(ov)) == 1 {
                                if iro_licm_const(f, ov) && ov < uses.len() && uses.get(ov) == 1 {
                                    cdeps.push(ov);
                                } else {
                                    can = false;
                                }
                            }
                            o = o + 1;
                        }
                        match inst {
                            // the loaded local itself is an operand: it is an
                            // alloca, made before the loop
                            _ => {
                            }
                        }
                    }
                    if can {
                        var cd: i64 = 0;
                        while cd < cdeps.len() {
                            var cv: i64 = cdeps.get(cd);
                            var cb: i64 = def_b.get(cv);
                            if cb == b {
                                keep = iro_vec_without(keep, cv);
                            } else {
                                var cblk: BasicBlock = f.blocks.get(cb);
                                cblk.instructions = iro_vec_without(cblk.instructions, cv);
                                f.blocks.set(cb, cblk);
                            }
                            hoisted.push(cv);
                            def_b.set(cv, pre);
                            cd = cd + 1;
                        }
                        hoisted.push(id);
                        def_b.set(id, pre);
                        moved = true;
                    } else {
                        keep.push(id);
                        // what may panic or be seen stays here: nothing
                        // after it may move ahead of it
                        if quiet && !iro_licm_quiet(inst, &plain) {
                            quiet = false;
                        }
                    }
                    k2 = k2 + 1;
                }
                if keep.len() != blk.instructions.len() {
                    blk.instructions = keep;
                    f.blocks.set(b, blk);
                }
            }
            b = b + 1;
        }
        if !moved {
            break;
        }
        round = round + 1;
    }
    if hoisted.len() == 0 {
        return false;
    }
    // Into the block before the loop, ahead of its jump
    var pblk: BasicBlock = f.blocks.get(pre);
    var term: i64 = pblk.instructions.pop();
    var h: i64 = 0;
    while h < hoisted.len() {
        pblk.instructions.push(hoisted.get(h));
        h = h + 1;
    }
    pblk.instructions.push(term);
    f.blocks.set(pre, pblk);
    return true;
}

// --- Pass manager (competitive OP4) -----------------------------------------
//
// FID_IROPT_OFF=licm,gvn,... turns passes off by name (inline, fold, dce,
// tailcall, gvn, licm); FID_IROPT_STATS=1 prints how many functions each
// pass changed. Every pass is also off when its constant is false.

/// Is iropt pass `name` on? Off when FID_IROPT_OFF or the `--no-pass`
/// flag (ME5, iro_cli_off in compiler/checks.fd) names it.
fn iro_pass_on(name: str) -> bool {
    return !iro_named_off(p_getenv("FID_IROPT_OFF"), name);
}

fn iro_stats_on() -> bool {
    var st: str = p_getenv("FID_IROPT_STATS");
    return (st as i64) != 0 && str_len(st) > 0;
}

// --- Shared CFG facts ------------------------------------------------------

// IroCfg, iro_cfg, iro_dominates and the loop tree (iro_loops) are in
// compiler/checks.fd since Nov 15 (ME2): every mid-end module (this one,
// iropt_me, egraph, rules, irverify) imports it, so they share one CFG and
// dominator computation.

// --- Renaming every operand -------------------------------------------------

fn iro_mm(map: &Vec<i64>, id: i64) -> i64 {
    if id >= 0 && id < map.len() && map.get(id) != 0 {
        return map.get(id) - 1;
    }
    return id;
}

fn iro_mm_vec(map: &Vec<i64>, v: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        out.push(iro_mm(map, v.get(i)));
        i = i + 1;
    }
    return out;
}

/// `inst` with every operand renamed through `map` (id -> new id + 1).
/// TryUnwrap and Asm are left as they are: iro_unhandled_uses keeps their
/// operands from being renamed.
fn iro_remap_all(inst: Inst, map: &Vec<i64>) -> Inst {
    match inst {
        Inst::BinOp(op, a, b, t) => {
            return Inst::BinOp(op, iro_mm(map, a), iro_mm(map, b), t);
        }
        Inst::UnaryOp(op, a, t) => {
            return Inst::UnaryOp(op, iro_mm(map, a), t);
        }
        Inst::Load(p, t) => {
            return Inst::Load(iro_mm(map, p), t);
        }
        Inst::Store(p, v, t) => {
            return Inst::Store(iro_mm(map, p), iro_mm(map, v), t);
        }
        Inst::StructCopy(d, s0, t) => {
            return Inst::StructCopy(iro_mm(map, d), iro_mm(map, s0), t);
        }
        Inst::GetFieldPtr(p, idx, t) => {
            return Inst::GetFieldPtr(iro_mm(map, p), idx, t);
        }
        Inst::GetElemPtr(p, i, t) => {
            return Inst::GetElemPtr(iro_mm(map, p), iro_mm(map, i), t);
        }
        Inst::Branch(c, t, e) => {
            return Inst::Branch(iro_mm(map, c), t, e);
        }
        Inst::Switch(sv, sk, st, sd) => {
            return Inst::Switch(iro_mm(map, sv), sk, st, sd);
        }
        Inst::Return(rv) => {
            match rv {
                OptValueId::Some(v) => {
                    return Inst::Return(OptValueId::Some(iro_mm(map, v)));
                }
                OptValueId::None => {
                }
            }
        }
        Inst::Call(nm, args, t, e) => {
            return Inst::Call(nm, iro_mm_vec(map, args), t, e);
        }
        Inst::CallPtr(fp, args, t, e, z) => {
            return Inst::CallPtr(iro_mm(map, fp), iro_mm_vec(map, args), t, e, z);
        }
        Inst::DynCall(a1, a2, args, t, e) => {
            return Inst::DynCall(a1, a2, iro_mm_vec(map, args), t, e);
        }
        Inst::MakeDyn(v, a1, a2) => {
            return Inst::MakeDyn(iro_mm(map, v), a1, a2);
        }
        Inst::BitCast(v, a, b) => {
            return Inst::BitCast(iro_mm(map, v), a, b);
        }
        Inst::IntExtend(v, a, b) => {
            return Inst::IntExtend(iro_mm(map, v), a, b);
        }
        Inst::IntTrunc(v, a, b) => {
            return Inst::IntTrunc(iro_mm(map, v), a, b);
        }
        Inst::IntToFloat(v, a, b) => {
            return Inst::IntToFloat(iro_mm(map, v), a, b);
        }
        Inst::FloatToInt(v, a, b) => {
            return Inst::FloatToInt(iro_mm(map, v), a, b);
        }
        Inst::Print(v, t) => {
            return Inst::Print(iro_mm(map, v), t);
        }
        Inst::PersistLoad(nm, d, t) => {
            return Inst::PersistLoad(nm, iro_mm(map, d), t);
        }
        Inst::PersistSave(nm, v) => {
            return Inst::PersistSave(nm, iro_mm(map, v));
        }
        Inst::Backward(l) => {
            return Inst::Backward(iro_mm(map, l));
        }
        _ => {
        }
    }
    return inst;
}

/// Values a TryUnwrap or Asm reads: never renamed.
fn iro_unhandled_uses(f: &IrFunction) -> Vec<i64> {
    var bad: Vec<i64> = peir_zeros(f.next_value + 1);
    var i: i64 = 0;
    while i < f.insts.len() {
        var inst: Inst = f.insts.get(i).inst;
        var mark: bool = false;
        match inst {
            Inst::TryUnwrap(_, _, _, _) => {
                mark = true;
            }
            Inst::Asm(_, _, _, _) => {
                mark = true;
            }
            _ => {
            }
        }
        if mark {
            var ops: Vec<i64> = Vec::new();
            peir_inst_operands(inst, &mut ops);
            var o: i64 = 0;
            while o < ops.len() {
                var v: i64 = ops.get(o);
                if v >= 0 && v < bad.len() {
                    bad.set(v, 1);
                }
                o = o + 1;
            }
            match inst {
                Inst::TryUnwrap(_, okd, _, _) => {
                    if okd >= 0 && okd < bad.len() {
                        bad.set(okd, 1);
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1;
    }
    return bad;
}

/// Rename operands in every instruction of `f`.
fn iro_apply_map(f: &mut IrFunction, map: &Vec<i64>) {
    var i: i64 = 0;
    while i < f.insts.len() {
        var entry: ValueIdInst = f.insts.get(i);
        entry.inst = iro_remap_all(entry.inst, map);
        f.insts.set(i, entry);
        i = i + 1;
    }
}

// --- Global value numbering (competitive OP7) -------------------------------
//
// A pure computation equal to one in a block that dominates it (or earlier
// in its own block) reuses that value. Arithmetic that may panic counts as
// pure here: if the first one panicked, the second is never reached. Loads
// of a local reuse an earlier load in the same block when no store to the
// local comes between. Constants are left alone (the native backend keeps
// a constant used in its own block as an immediate).

const IRO_GVN: bool = true;
fn iro_binop_code(op: BinOp) -> str {
    match op {
        BinOp::Add => {
            return "a";
        }
        BinOp::Sub => {
            return "s";
        }
        BinOp::Mul => {
            return "m";
        }
        BinOp::Div => {
            return "d";
        }
        BinOp::Mod => {
            return "r";
        }
        BinOp::Eq => {
            return "eq";
        }
        BinOp::Neq => {
            return "ne";
        }
        BinOp::Lt => {
            return "lt";
        }
        BinOp::Gt => {
            return "gt";
        }
        BinOp::LtEq => {
            return "le";
        }
        BinOp::GtEq => {
            return "ge";
        }
        BinOp::And => {
            return "&&";
        }
        BinOp::Or => {
            return "||";
        }
        BinOp::BitAnd => {
            return "&";
        }
        BinOp::BitOr => {
            return "|";
        }
        BinOp::BitXor => {
            return "^";
        }
        BinOp::Shl => {
            return "<<";
        }
        BinOp::Shr => {
            return ">>";
        }
    }
    return "?";
}

/// The key of a value-numbered instruction, "" for one that is not.
fn iro_gvn_key(inst: Inst) -> str {
    match inst {
        Inst::BinOp(op, a, b, t) => {
            return "B" + iro_binop_code(op) + "|" + int_to_str(a) + "|" + int_to_str(b) + "|" + ir_type_to_str(t);
        }
        Inst::UnaryOp(_, a, t) => {
            var uk: str = "";
            match inst {
                Inst::UnaryOp(uop, _, _) => {
                    match uop {
                        UnaryOp::Neg => {
                            uk = "n";
                        }
                        UnaryOp::Not => {
                            uk = "!";
                        }
                        UnaryOp::BitNot => {
                            uk = "~";
                        }
                    }
                }
                _ => {
                }
            }
            return "U" + uk + "|" + int_to_str(a) + "|" + ir_type_to_str(t);
        }
        Inst::GetFieldPtr(p, idx, t) => {
            return "F|" + int_to_str(p) + "|" + int_to_str(idx) + "|" + ir_type_to_str(t);
        }
        Inst::GetElemPtr(p, i, t) => {
            return "E|" + int_to_str(p) + "|" + int_to_str(i) + "|" + ir_type_to_str(t);
        }
        Inst::IntExtend(v, a, b) => {
            return "X|" + int_to_str(v) + "|" + ir_type_to_str(a) + "|" + ir_type_to_str(b);
        }
        Inst::IntTrunc(v, a, b) => {
            return "T|" + int_to_str(v) + "|" + ir_type_to_str(a) + "|" + ir_type_to_str(b);
        }
        Inst::BitCast(v, a, b) => {
            return "C|" + int_to_str(v) + "|" + ir_type_to_str(a) + "|" + ir_type_to_str(b);
        }
        _ => {
        }
    }
    return "";
}

fn iro_gvn(f: &mut IrFunction) -> bool {
    if f.blocks.len() == 0 {
        return false;
    }
    var cfg: IroCfg = iro_cfg(f);
    var bad: Vec<i64> = iro_unhandled_uses(f);
    var plain: Vec<i64> = iro_plain_locals(f);
    var map: Vec<i64> = peir_zeros(f.next_value + 1);
    var dead: Vec<i64> = peir_zeros(f.next_value + 1);
    var heads: HashMap<str, i64> = HashMap::new();
    var e_id: Vec<i64> = Vec::new();
    var e_blk: Vec<i64> = Vec::new();
    var e_next: Vec<i64> = Vec::new();
    var any: bool = false;
    var r: i64 = 0;
    while r < cfg.rpo.len() {
        var b: i64 = cfg.rpo.get(r);
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        // loads of locals in this block: local -> load id + 1
        var lastload: Vec<i64> = peir_zeros(f.next_value + 1);
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < map.len() {
                var inst: Inst = iro_remap_all(peir_inst_of(f, id), &map);
                match inst {
                    Inst::Store(sp, _, _) => {
                        if sp >= 0 && sp < lastload.len() {
                            lastload.set(sp, 0);
                        }
                    }
                    Inst::Load(lp, _) => {
                        if lp >= 0 && lp < plain.len() && plain.get(lp) == 1 && bad.get(id) == 0 {
                            if lastload.get(lp) != 0 {
                                map.set(id, lastload.get(lp));
                                dead.set(id, 1);
                                any = true;
                            } else {
                                lastload.set(lp, id + 1);
                            }
                        }
                    }
                    _ => {
                    }
                }
                var key: str = iro_gvn_key(inst);
                if str_len(key) > 0 && bad.get(id) == 0 {
                    var found: i64 = -1;
                    if heads.contains(key) {
                        var e: i64 = heads.get(key);
                        while e >= 0 && found < 0 {
                            if iro_dominates(&cfg, e_blk.get(e), b) {
                                found = e_id.get(e);
                            }
                            e = e_next.get(e);
                        }
                    }
                    if found >= 0 {
                        map.set(id, found + 1);
                        dead.set(id, 1);
                        any = true;
                    } else {
                        var prev: i64 = -1;
                        if heads.contains(key) {
                            prev = heads.get(key);
                        }
                        e_id.push(id);
                        e_blk.push(b);
                        e_next.push(prev);
                        heads.insert(key, e_id.len() - 1);
                    }
                }
            }
            k = k + 1;
        }
        r = r + 1;
    }
    if !any {
        return false;
    }
    // chains: a replacement that was itself replaced
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i) != 0 {
            var t: i64 = map.get(i) - 1;
            var steps: i64 = 0;
            while t >= 0 && t < map.len() && map.get(t) != 0 && steps < 64 {
                t = map.get(t) - 1;
                steps = steps + 1;
            }
            map.set(i, t + 1);
        }
        i = i + 1;
    }
    iro_apply_map(f, &map);
    var b2: i64 = 0;
    while b2 < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b2);
        var keep: Vec<i64> = Vec::new();
        var j: i64 = 0;
        while j < blk.instructions.len() {
            var id2: i64 = blk.instructions.get(j);
            if !(id2 >= 0 && id2 < dead.len() && dead.get(id2) == 1) {
                keep.push(id2);
            }
            j = j + 1;
        }
        if keep.len() != blk.instructions.len() {
            blk.instructions = keep;
            f.blocks.set(b2, blk);
        }
        b2 = b2 + 1;
    }
    return true;
}

// --- Tail calls into loops (competitive OP13) -------------------------------
//
// `return f(args)` in f itself becomes: store the arguments into the
// parameters' slots, jump to the start. The parameters move into locals a
// new entry block sets up (the native backend keeps them in registers).

const IRO_TAILCALL: bool = true;
fn iro_tailcalls(f: &mut IrFunction) -> bool {
    var n: i64 = f.blocks.len();
    if n == 0 || f.is_interrupt {
        return false;
    }
    var np: i64 = f.params.len();
    // uses of each value
    var uses: Vec<i64> = peir_zeros(f.next_value + 1);
    var b: i64 = 0;
    while b < n {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var ops: Vec<i64> = Vec::new();
            peir_inst_operands(peir_inst_of(f, ids.get(k)), &mut ops);
            var o: i64 = 0;
            while o < ops.len() {
                var v: i64 = ops.get(o);
                if v >= 0 && v < uses.len() {
                    uses.set(v, uses.get(v) + 1);
                }
                o = o + 1;
            }
            k = k + 1;
        }
        b = b + 1;
    }
    // the sites: a call of f itself whose only use is the Return after it
    var site_blocks: Vec<i64> = Vec::new();
    b = 0;
    while b < n {
        var ids2: Vec<i64> = f.blocks.get(b).instructions;
        if ids2.len() >= 2 {
            var cid: i64 = ids2.get(ids2.len() - 2);
            match peir_inst_of(f, ids2.get(ids2.len() - 1)) {
                Inst::Return(rv) => {
                    match rv {
                        OptValueId::Some(rvid) => {
                            if rvid == cid && cid >= 0 && cid < uses.len() && uses.get(cid) == 1 {
                                match peir_inst_of(f, cid) {
                                    Inst::Call(cn, cargs, _, _) => {
                                        if cn == f.name && cargs.len() == np {
                                            site_blocks.push(f.blocks.get(b).id);
                                        }
                                    }
                                    _ => {
                                    }
                                }
                            }
                        }
                        OptValueId::None => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        b = b + 1;
    }
    if site_blocks.len() == 0 {
        return false;
    }
    var bad: Vec<i64> = iro_unhandled_uses(f);
    var pi: i64 = 0;
    while pi < np {
        var pid: i64 = f.params.get(pi).id;
        if pid >= 0 && pid < bad.len() && bad.get(pid) == 1 {
            return false;
        }
        if !iro_is_scalar(f.params.get(pi).ty) && !ir_type_eq(f.params.get(pi).ty, IrType::I64) {
            match f.params.get(pi).ty {
                IrType::Ptr(_) => {
                }
                IrType::Opaque(_) => {
                }
                IrType::Generic(_, _) => {
                }
                _ => {
                    return false;
                }
            }
        }
        pi = pi + 1;
    }
    var old_entry: i64 = f.blocks.get(0).id;
    // A new entry block: a slot per parameter, set from it
    var new_id: i64 = IrFunction_new_block(f);
    var nb: BasicBlock = f.blocks.pop();
    f.blocks.insert(0, nb);
    f.entry = new_id;
    f.current_block_idx = 0;
    var slots: Vec<i64> = Vec::new();
    pi = 0;
    while pi < np {
        var prm: ValueIdType = f.params.get(pi);
        var a: i64 = IrFunction_emit(f, Inst::Alloca(prm.ty, Region::Stack));
        IrFunction_emit(f, Inst::Store(a, prm.id, OptIrType::None));
        slots.push(a);
        pi = pi + 1;
    }
    IrFunction_emit(f, Inst::Jump(old_entry));
    // Every other read of a parameter reads its slot
    var pmap: Vec<i64> = peir_zeros(f.next_value + 1);
    var pslot: Vec<i64> = peir_zeros(f.next_value + 1);
    pi = 0;
    while pi < np {
        var pid2: i64 = f.params.get(pi).id;
        if pid2 >= 0 && pid2 < pslot.len() {
            pslot.set(pid2, pi + 1);
        }
        pi = pi + 1;
    }
    var bb: i64 = 1;
    while bb < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(bb);
        var nl: Vec<i64> = Vec::new();
        var k2: i64 = 0;
        while k2 < blk.instructions.len() {
            var id: i64 = blk.instructions.get(k2);
            var inst: Inst = peir_inst_of(f, id);
            var ops2: Vec<i64> = Vec::new();
            peir_inst_operands(inst, &mut ops2);
            var touched: Vec<i64> = Vec::new();
            var o2: i64 = 0;
            while o2 < ops2.len() {
                var pv: i64 = ops2.get(o2);
                if pv >= 0 && pv < pslot.len() && pslot.get(pv) != 0 && pmap.get(pv) == 0 {
                    var si: i64 = pslot.get(pv) - 1;
                    f.current_block_idx = 0;
                    var ld: i64 = iro_detached(f, Inst::Load(slots.get(si), f.params.get(si).ty));
                    nl.push(ld);
                    pmap.set(pv, ld + 1);
                    touched.push(pv);
                }
                o2 = o2 + 1;
            }
            if touched.len() > 0 {
                IrFunction_set_inst(f, id, iro_remap_all(inst, &pmap));
                var t: i64 = 0;
                while t < touched.len() {
                    pmap.set(touched.get(t), 0);
                    t = t + 1;
                }
            }
            nl.push(id);
            k2 = k2 + 1;
        }
        blk.instructions = nl;
        f.blocks.set(bb, blk);
        bb = bb + 1;
    }
    // The sites: arguments into the slots, a jump to the start
    bb = 1;
    while bb < f.blocks.len() {
        var blk2: BasicBlock = f.blocks.get(bb);
        if peir_has_id(site_blocks, blk2.id) {
            var ret: i64 = blk2.instructions.pop();
            var call: i64 = blk2.instructions.pop();
            match peir_inst_of(f, call) {
                Inst::Call(_, cargs2, _, _) => {
                    var ai: i64 = 0;
                    while ai < cargs2.len() {
                        f.current_block_idx = 0;
                        var st: i64 = iro_detached(f, Inst::Store(slots.get(ai), cargs2.get(ai), OptIrType::None));
                        blk2.instructions.push(st);
                        ai = ai + 1;
                    }
                }
                _ => {
                }
            }
            f.current_block_idx = 0;
            var jmp: i64 = iro_detached(f, Inst::Jump(old_entry));
            blk2.instructions.push(jmp);
            IrFunction_set_inst(f, call, Inst::ConstInt(0, IrType::I64));
            IrFunction_set_inst(f, ret, Inst::ConstInt(0, IrType::I64));
            f.blocks.set(bb, blk2);
        }
        bb = bb + 1;
    }
    f.current_block_idx = 0;
    return true;
}

fn peir_has_id(v: Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// --- The mid-end (llvm-roadmap Track ME) -----------------------------------

/// Instructions in the blocks of `f` (ME30's measure).
fn iro_count_insts(f: &IrFunction) -> i64 {
    var n: i64 = 0;
    var b: i64 = 0;
    while b < f.blocks.len() {
        n = n + f.blocks.get(b).instructions.len();
        b = b + 1;
    }
    return n;
}

/// ME1: the use lists of a function. `count` is how many operands read
/// each value, `users` the instructions that read it, `block_of` the block
/// (index) each instruction is in, `pos_of` its place there (-1: in none).
/// Built in one pass over the blocks; a pass that changes instructions
/// rebuilds it (iro_uses) or keeps it current with iro_uses_drop.
pub struct IroUses {
    pub count: Vec<i64>,
    pub users: Vec<Vec<i64>>,
    pub block_of: Vec<i64>,
    pub pos_of: Vec<i64>,
}

pub fn iro_uses(f: &IrFunction) -> IroUses {
    g_iro_uses_builds = g_iro_uses_builds + 1;
    var n: i64 = f.next_value + 1;
    var u: IroUses = IroUses {
        count: peir_zeros(n), users: Vec::new(), block_of: Vec::new(), pos_of: Vec::new()
    };
    var z: i64 = 0;
    while z < n {
        u.users.push(Vec::new());
        u.block_of.push(-1);
        u.pos_of.push(-1);
        z = z + 1;
    }
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < n {
                u.block_of.set(id, b);
                u.pos_of.set(id, k);
            }
            var ops: Vec<i64> = Vec::new();
            peir_inst_operands(peir_inst_of(f, id), &mut ops);
            var o: i64 = 0;
            while o < ops.len() {
                var v: i64 = ops.get(o);
                if v >= 0 && v < n {
                    u.count.set(v, u.count.get(v) + 1);
                    var us: Vec<i64> = u.users.get(v);
                    us.push(id);
                    u.users.set(v, us);
                }
                o = o + 1;
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return u;
}

/// Instruction `id` no longer reads its operands (it is removed or replaced).
fn iro_uses_drop(u: &mut IroUses, f: &IrFunction, id: i64) {
    var ops: Vec<i64> = Vec::new();
    peir_inst_operands(peir_inst_of(f, id), &mut ops);
    var o: i64 = 0;
    while o < ops.len() {
        var v: i64 = ops.get(o);
        if v >= 0 && v < u.count.len() && u.count.get(v) > 0 {
            u.count.set(v, u.count.get(v) - 1);
        }
        o = o + 1;
    }
}

/// Grow `u`'s arrays to hold value ids up to `n - 1` (a pass detached
/// fresh instructions after `u` was built). count/block_of/pos_of stay
/// exact; the `users` lists only grow, so a dropped use still lists its
/// former user — passes that consume `users` must rebuild instead.
fn iro_uses_grow(u: &mut IroUses, n: i64) {
    while u.count.len() < n {
        u.count.push(0);
        var e: Vec<i64> = Vec::new();
        u.users.push(e);
        u.block_of.push(-1);
        u.pos_of.push(-1);
    }
}

/// Instruction `id` now reads its operands (a replacement was stored).
/// Grows `u` first so fresh ids are covered; keeps count and users exact.
fn iro_uses_add_ops(u: &mut IroUses, f: &IrFunction, id: i64) {
    iro_uses_grow(u, f.next_value + 1);
    var ops: Vec<i64> = Vec::new();
    peir_inst_operands(peir_inst_of(f, id), &mut ops);
    var o: i64 = 0;
    while o < ops.len() {
        var v: i64 = ops.get(o);
        if v >= 0 && v < u.count.len() {
            u.count.set(v, u.count.get(v) + 1);
            var us: Vec<i64> = u.users.get(v);
            us.push(id);
            u.users.set(v, us);
        }
        o = o + 1;
    }
}

/// Fresh detached instruction `id` was inserted into block `b` (its
/// operands, if any, still need `iro_uses_add_ops`).
fn iro_uses_reg(u: &mut IroUses, id: i64, b: i64) {
    iro_uses_grow(u, id + 1);
    u.block_of.set(id, b);
    u.pos_of.set(id, -1);
}

// --- OP3: use lists shared between passes ------------------------------------
//
// iropt_native runs one pass after another on a function, and each says
// whether it changed it. While none has since they were built, the
// function's use lists are the same, so the passes that read them first
// thing (simplify, branchfacts, closuredevirt: iro_uses_entry) get them
// from here instead of building them again. The edit tracking is the one
// the CFG cache (checks.fd iro_cfg) and the loop tree cached with it rely
// on: the pass manager's word that a pass changed `f` (iro_uses_forget after
// every pass that did: iro_time, and the passes iropt_native times by
// hand), plus a key of everything the use lists read of the shape of `f`
// (next_value, every block's id and its instruction ids in order), so an
// instruction added, removed or moved without a word is caught too. Only
// inside iropt_native's loop over functions (iro_uses_arm .. iro_uses_disarm:
// a new function forgets the old one's lists), and not with
// FID_IROPT_OFF=cfgcache (iro_cache_on), which turns every one of these
// caches off. A pass gets its own copy (a write to it copies the shared
// data first), so what it changes in its copy never reaches the cache.
var g_iro_uses_armed: bool = false;
var g_iro_uses_held: bool = false;
var g_iro_uses_builds: i64 = 0;
var g_iro_uses_reused: i64 = 0;
var g_iro_uses_key: Vec<i64> = Vec::new();
var g_iro_uses_count: Vec<i64> = Vec::new();
var g_iro_uses_users: Vec<Vec<i64>> = Vec::new();
var g_iro_uses_block_of: Vec<i64> = Vec::new();
var g_iro_uses_pos_of: Vec<i64> = Vec::new();

/// How many use lists `iro_uses` built, and how many `iro_uses_entry`
/// handed back from the cache (FID_IROPT_STATS).
pub fn iro_uses_builds() -> i64 {
    return g_iro_uses_builds;
}

pub fn iro_uses_reused() -> i64 {
    return g_iro_uses_reused;
}

/// The pass manager starts on a function: nothing cached yet, and
/// iro_uses_entry may cache (unless FID_IROPT_OFF=cfgcache).
pub fn iro_uses_arm() {
    iro_uses_forget();
    g_iro_uses_armed = iro_cache_on();
}

/// The pass manager is done with its functions: every request builds again.
pub fn iro_uses_disarm() {
    iro_uses_forget();
    g_iro_uses_armed = false;
}

/// OP3 (Nov 21 evening): dce removed instructions: repair the shared use
/// lists in place instead of forgetting them. An id the cache saw (its
/// block_of >= 0) that no block holds now was removed — it is spliced out
/// of every user list (each appearance was one use, so the counts drop by
/// as many) and its own entry is cleared; nothing asks about a dead id.
/// Survivors keep their relative order, so position-sensitive readers are
/// safe. Returns how many ids went dead (0 when nothing is held).
fn iro_uses_dead(f: &IrFunction) -> i64 {
    if !g_iro_uses_held {
        return 0;
    }
    var n: i64 = g_iro_uses_key.len();
    if n <= 0 {
        return 0;
    }
    var present: Vec<i64> = peir_zeros(n);
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < n {
                present.set(id, 1);
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var dead: i64 = 0;
    var v: i64 = 0;
    while v < n {
        if present.get(v) == 0 && g_iro_uses_block_of.get(v) >= 0 {
            dead = dead + 1;
        }
        v = v + 1;
    }
    if dead == 0 {
        return 0;
    }
    var u: i64 = 0;
    while u < n {
        var lst: Vec<i64> = g_iro_uses_users.get(u);
        var lst_len: i64 = lst.len();
        if lst_len > 0 {
            var lost: i64 = 0;
            var keep: Vec<i64> = Vec::new();
            var q: i64 = 0;
            while q < lst_len {
                var w: i64 = lst.get(q);
                var gone: bool = w >= 0 && w < n && present.get(w) == 0 && g_iro_uses_block_of.get(w) >= 0;
                if gone {
                    lost = lost + 1;
                } else {
                    keep.push(w);
                }
                q = q + 1;
            }
            if lost > 0 {
                g_iro_uses_users.set(u, keep);
                if g_iro_uses_count.get(u) >= lost {
                    g_iro_uses_count.set(u, g_iro_uses_count.get(u) - lost);
                } else {
                    g_iro_uses_count.set(u, 0);
                }
            }
        }
        u = u + 1;
    }
    v = 0;
    while v < n {
        if present.get(v) == 0 && g_iro_uses_block_of.get(v) >= 0 {
            g_iro_uses_block_of.set(v, 0 - 1);
        }
        v = v + 1;
    }
    return dead;
}

/// A pass changed the function: the cached use lists no longer hold.
pub fn iro_uses_forget() {
    if g_iro_uses_held {
        g_iro_uses_held = false;
        g_iro_uses_key = Vec::new();
        g_iro_uses_count = Vec::new();
        g_iro_uses_users = Vec::new();
        g_iro_uses_block_of = Vec::new();
        g_iro_uses_pos_of = Vec::new();
    }
}

/// What `iro_uses` reads of the shape of `f`: next_value (the size of its
/// arrays), the block count, then per block its id, its instruction count
/// and its instruction ids in order.
fn iro_uses_key(f: &IrFunction) -> Vec<i64> {
    var key: Vec<i64> = Vec::new();
    key.push(f.next_value);
    key.push(f.blocks.len());
    var b: i64 = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        key.push(blk.id);
        key.push(blk.instructions.len());
        var k: i64 = 0;
        while k < blk.instructions.len() {
            key.push(blk.instructions.get(k));
            k = k + 1;
        }
        b = b + 1;
    }
    return key;
}

fn iro_uses_same_key(a: Vec<i64>, b: Vec<i64>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    var i: i64 = 0;
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// The use lists of `f` for a pass that reads them before it changes
/// anything: the cached ones when no pass changed `f` since they were built
/// (and its shape still matches), else built (and cached while armed).
fn iro_uses_entry(f: &IrFunction) -> IroUses {
    if !g_iro_uses_armed {
        return iro_uses(f);
    }
    var key: Vec<i64> = iro_uses_key(f);
    if g_iro_uses_held && iro_uses_same_key(key, g_iro_uses_key) {
        g_iro_uses_reused = g_iro_uses_reused + 1;
        return IroUses {
            count: g_iro_uses_count, users: g_iro_uses_users, block_of: g_iro_uses_block_of, pos_of: g_iro_uses_pos_of
        };
    }
    var u: IroUses = iro_uses(f);
    g_iro_uses_held = true;
    g_iro_uses_key = key;
    g_iro_uses_count = u.count;
    g_iro_uses_users = u.users;
    g_iro_uses_block_of = u.block_of;
    g_iro_uses_pos_of = u.pos_of;
    return u;
}

/// The block index whose id is `bid`, or -1.
fn iro_block_index(f: &IrFunction, bid: i64) -> i64 {
    var b: i64 = 0;
    while b < f.blocks.len() {
        if f.blocks.get(b).id == bid {
            return b;
        }
        b = b + 1;
    }
    return -1;
}

/// `id` without the predecessor `from` (an edge from it is gone).
fn iro_drop_pred(f: &mut IrFunction, bid: i64, from: i64) {
    var bi: i64 = iro_block_index(f, bid);
    if bi < 0 {
        return;
    }
    var blk: BasicBlock = f.blocks.get(bi);
    var keep: Vec<i64> = Vec::new();
    var dropped: bool = false;
    var k: i64 = 0;
    while k < blk.predecessors.len() {
        if !dropped && blk.predecessors.get(k) == from {
            dropped = true;
        } else {
            keep.push(blk.predecessors.get(k));
        }
        k = k + 1;
    }
    if dropped {
        blk.predecessors = keep;
        f.blocks.set(bi, blk);
    }
}

// ME14: a branch whose condition is a constant (after folding and
// inlining), or whose two targets are one block, becomes a jump. The
// block left out loses that predecessor; when nothing reaches it any more
// the backends' unreachable-block handling drops or keeps it as before.
fn iro_branch_fold(f: &mut IrFunction) -> bool {
    var changed: bool = false;
    var b: i64 = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var nk: i64 = blk.instructions.len();
        if nk > 0 {
            var tid: i64 = blk.instructions.get(nk - 1);
            match peir_inst_of(f, tid) {
                Inst::Branch(c, t, e) => {
                    var to: i64 = -1;
                    var gone: i64 = -1;
                    if t == e {
                        to = t;
                    } else {
                        match peir_inst_of(f, c) {
                            Inst::ConstBool(v) => {
                                if v {
                                    to = t;
                                    gone = e;
                                } else {
                                    to = e;
                                    gone = t;
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    if to >= 0 {
                        IrFunction_set_inst(f, tid, Inst::Jump(to));
                        if gone >= 0 {
                            iro_drop_pred(f, gone, blk.id);
                        }
                        changed = true;
                    }
                }
                _ => {
                }
            }
        }
        b = b + 1;
    }
    if changed {
        iro_drop_unreachable(f);
    }
    return changed;
}

/// Remove the blocks no jump or branch from the entry reaches any more
/// (a folded branch's other side), so no pass or backend sees code that
/// uses values from blocks that no longer dominate it.
fn iro_drop_unreachable(f: &mut IrFunction) {
    var cfg: IroCfg = iro_cfg(f);
    if cfg.n == 0 {
        return;
    }
    var keep_blocks: Vec<BasicBlock> = Vec::new();
    var gone: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < cfg.n {
        if b == 0 || cfg.rpo_num.get(b) >= 0 {
            keep_blocks.push(f.blocks.get(b));
        } else {
            gone.push(f.blocks.get(b).id);
        }
        b = b + 1;
    }
    if gone.len() == 0 {
        return;
    }
    // their edges into the blocks that stay
    b = 0;
    while b < keep_blocks.len() {
        var blk: BasicBlock = keep_blocks.get(b);
        var ps: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < blk.predecessors.len() {
            if !peir_has_id(gone, blk.predecessors.get(k)) {
                ps.push(blk.predecessors.get(k));
            }
            k = k + 1;
        }
        blk.predecessors = ps;
        keep_blocks.set(b, blk);
        b = b + 1;
    }
    f.blocks = keep_blocks;
    if f.current_block_idx >= f.blocks.len() {
        f.current_block_idx = f.blocks.len() - 1;
    }
}

// ME13: a branch's condition is a fact inside the edge's region: on the
// `then` side it is true, on the `else` side false — when the target's
// only way in is this edge, so every block the target dominates inherits
// it. A comparison `a < b` there also settles the other comparisons of
// the same operands (and swapped), and a condition `!a` settles `a`.

/// The relation a comparison allows, as a 3-bit mask {lt=1, eq=2, gt=4}.
fn iro_cmp_mask(op: BinOp) -> i64 {
    if binop_eq(op, BinOp::Lt) {
        return 1;
    }
    if binop_eq(op, BinOp::Eq) {
        return 2;
    }
    if binop_eq(op, BinOp::Gt) {
        return 4;
    }
    if binop_eq(op, BinOp::LtEq) {
        return 3;
    }
    if binop_eq(op, BinOp::Neq) {
        return 5;
    }
    if binop_eq(op, BinOp::GtEq) {
        return 6;
    }
    return 0;
}

/// lt <-> gt in a mask.
fn iro_cmp_mirror(m: i64) -> i64 {
    return ((m & 1) * 4) + (m & 2) + ((m & 4) / 4);
}

/// With the real relation known inside `possible` (a mask), what an
/// instruction's comparison must be: 1, 0, or -1 when unsettled.
fn iro_cmp_implied(possible: i64, inst_mask: i64) -> i64 {
    if inst_mask == 0 {
        return -1;
    }
    if (possible & inst_mask) == possible {
        return 1;
    }
    if (possible & inst_mask) == 0 {
        return 0;
    }
    return -1;
}

/// A ConstBool `v` at the head of block `bi`; its id.
fn iro_bool_before(f: &mut IrFunction, bi: i64, v: bool) -> i64 {
    var cid: i64 = iro_detached(f, Inst::ConstBool(v));
    var blk: BasicBlock = f.blocks.get(bi);
    var ids: Vec<i64> = Vec::new();
    ids.push(cid);
    var k: i64 = 0;
    while k < blk.instructions.len() {
        ids.push(blk.instructions.get(k));
        k = k + 1;
    }
    blk.instructions = ids;
    f.blocks.set(bi, blk);
    return cid;
}

/// Rewrite every use of `v` in blocks dominated by `dom` to `cid`
/// (`map` has `v` -> `cid` + 1 only). Use lists `u` find the candidates.
fn iro_rewrite_uses(f: &mut IrFunction, u: &IroUses, cfg: &IroCfg, v: i64, dom: i64, map: &Vec<i64>) -> bool {
    var changed: bool = false;
    if v < 0 || v >= u.users.len() {
        return false;
    }
    var us: Vec<i64> = u.users.get(v);
    var i: i64 = 0;
    while i < us.len() {
        var uid: i64 = us.get(i);
        var ub: i64 = u.block_of.get(uid);
        if ub == dom || (ub >= 0 && iro_dominates(cfg, dom, ub)) {
            IrFunction_set_inst(f, uid, iro_remap_all(peir_inst_of(f, uid), map));
            changed = true;
        }
        i = i + 1;
    }
    return changed;
}

fn iro_branch_facts(f: &mut IrFunction) -> bool {
    if f.blocks.len() == 0 {
        return false;
    }
    var cfg: IroCfg = iro_cfg(f);
    // OP3: nothing changed yet, so the lists a pass before left are good
    var u: IroUses = iro_uses_entry(f);
    var changed: bool = false;
    // remap buffers live outside the block loop: allocating one per branch
    // OOMs on large functions
    var mp: Vec<i64> = peir_zeros(f.next_value + 1);
    var mp2: Vec<i64> = peir_zeros(f.next_value + 1);
    var b: i64 = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var nk: i64 = blk.instructions.len();
        if nk > 0 {
            var tid: i64 = blk.instructions.get(nk - 1);
            match peir_inst_of(f, tid) {
                Inst::Branch(c, t1, t2) => {
                    if t1 != t2 {
                        // what the condition says about its operands
                        var cmask: i64 = 0;
                        var cx: i64 = -1;
                        var cy: i64 = -1;
                        var notof: i64 = -1;
                        match peir_inst_of(f, c) {
                            Inst::BinOp(cop, lx, ly, _) => {
                                cmask = iro_cmp_mask(cop);
                                cx = lx;
                                cy = ly;
                            }
                            Inst::UnaryOp(uop, a0, _) => {
                                match uop {
                                    UnaryOp::Not => {
                                        notof = a0;
                                    }
                                    _ => {
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                        // Floats: a false comparison may mean an operand is
                        // NaN (unordered), where every ordered comparison
                        // is false, so `!(a < b)` does not give `a >= b`.
                        // The true edge still settles the others: a true
                        // ordered comparison says neither is NaN.
                        var fcmp: bool = false;
                        if cx >= 0 {
                            match iro_value_ty(f, cx) {
                                IrType::F64 => {
                                    fcmp = true;
                                }
                                IrType::F32 => {
                                    fcmp = true;
                                }
                                _ => {
                                }
                            }
                        }
                        var side: i64 = 0;
                        while side < 2 {
                            var tgt: i64 = t1;
                            var truth: bool = true;
                            if side == 1 {
                                tgt = t2;
                                truth = false;
                            }
                            var ti: i64 = -1;
                            if tgt >= 0 && tgt < cfg.index.len() {
                                ti = cfg.index.get(tgt);
                            }
                            if ti >= 0 {
                                var ps: Vec<i64> = cfg.preds.get(ti);
                                var sole: bool = ps.len() == 1 && ps.get(0) == b;
                                if sole {
                                    var possible: i64 = cmask;
                                    if !truth {
                                        possible = 7 - cmask;
                                    }
                                    var cid: i64 = -1;
                                    var i2: i64 = 0;
                                    while i2 < f.blocks.len() {
                                        if i2 == ti || iro_dominates(&cfg, ti, i2) {
                                            var db: BasicBlock = f.blocks.get(i2);
                                            var k2: i64 = 0;
                                            while k2 < db.instructions.len() {
                                                var uid: i64 = db.instructions.get(k2);
                                                var ui: Inst = peir_inst_of(f, uid);
                                                // a comparison of the same
                                                // operands is settled too
                                                match ui {
                                                    Inst::BinOp(iop, il, ir, _) => {
                                                        if cmask != 0 && iop_is_cmp(iop) && (truth || !fcmp) {
                                                            var m: i64 = -1;
                                                            if il == cx && ir == cy {
                                                                m = iro_cmp_implied(possible, iro_cmp_mask(iop));
                                                            } else if il == cy && ir == cx {
                                                                m = iro_cmp_implied(possible, iro_cmp_mirror(iro_cmp_mask(iop)));
                                                            }
                                                            if m >= 0 {
                                                                IrFunction_set_inst(f, uid, Inst::ConstBool(m == 1));
                                                                changed = true;
                                                            }
                                                        }
                                                    }
                                                    _ => {
                                                    }
                                                }
                                                // and c itself is `val` here
                                                var uses_c: bool = false;
                                                var ops2: Vec<i64> = Vec::new();
                                                peir_inst_operands(ui, &mut ops2);
                                                var o2: i64 = 0;
                                                while o2 < ops2.len() {
                                                    if ops2.get(o2) == c {
                                                        uses_c = true;
                                                    }
                                                    o2 = o2 + 1;
                                                }
                                                if uses_c {
                                                    if cid < 0 {
                                                        cid = iro_bool_before(f, ti, truth);
                                                        mp.set(c, cid + 1);
                                                    }
                                                    IrFunction_set_inst(f, uid, iro_remap_all(ui, &mp));
                                                    changed = true;
                                                }
                                                k2 = k2 + 1;
                                            }
                                        }
                                        i2 = i2 + 1;
                                    }
                                    if c >= 0 && c < mp.len() {
                                        mp.set(c, 0);
                                    }
                                    // c = !a: the operand is `!val` here
                                    if notof >= 0 && notof < u.users.len() {
                                        var us3: Vec<i64> = u.users.get(notof);
                                        var ui3: i64 = 0;
                                        while ui3 < us3.len() {
                                            var uid3: i64 = us3.get(ui3);
                                            var ub3: i64 = u.block_of.get(uid3);
                                            if ub3 == ti || (ub3 >= 0 && iro_dominates(&cfg, ti, ub3)) {
                                                var cid2: i64 = iro_bool_before(f, ti, !truth);
                                                mp2.set(notof, cid2 + 1);
                                                IrFunction_set_inst(f, uid3, iro_remap_all(peir_inst_of(f, uid3), &mp2));
                                                mp2.set(notof, 0);
                                                changed = true;
                                            }
                                            ui3 = ui3 + 1;
                                        }
                                    }
                                }
                            }
                            side = side + 1;
                        }
                    }
                }
                _ => {
                }
            }
        }
        b = b + 1;
    }
    if changed {
        iro_branch_fold(f);
        iro_dce_more(f);
    }
    return changed;
}

/// `op` orders two values (not And/Or on booleans, not arithmetic).
fn iop_is_cmp(op: BinOp) -> bool {
    return binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::GtEq);
}

// ME14: sparse conditional constant propagation. Every value has a single
// definition (verifier-checked), so each lattice cell is evaluated once:
// blocks are visited in reverse postorder restricted to feasible edges —
// a block's operands are always defined in dominators that ran first.
// Lattice: 0 top (not evaluated), 1 constant (lat_v), 2 varying.
// Const-valued instructions become ConstInt/ConstBool; a branch on a
// constant loses the dead edge; unreachable blocks are dropped after.

fn iro_sccp_eval(op: BinOp, a: i64, b: i64, out: &mut Vec<i64>) {
    // out: [tag, value]; tag 1 const, 2 varying (a fold that would panic
    // is varying, not a constant — the runtime raises the panic).
    var r: i64 = 0;
    var tag: i64 = 2;
    var ok: bool = false;
    var i64min: i64 = 0 - 9223372036854775807 - 1;
    var i64max: i64 = 9223372036854775807;
    // Fides arithmetic is checked: computing a + b / a - b / a * b to see
    // whether it overflows panics before the check runs. Bound first, then
    // compute only when the result is provably in range.
    if binop_eq(op, BinOp::Add) {
        if b == 0 {
            r = a;
            ok = true;
        } else if b > 0 {
            if a <= i64max - b {
                r = a + b;
                ok = true;
            }
        } else {
            if a >= i64min - b {
                r = a + b;
                ok = true;
            }
        }
    } else if binop_eq(op, BinOp::Sub) {
        if b == 0 {
            r = a;
            ok = true;
        } else if b > 0 {
            if a >= i64min + b {
                r = a - b;
                ok = true;
            }
        } else {
            if a <= i64max + b {
                r = a - b;
                ok = true;
            }
        }
    } else if binop_eq(op, BinOp::Mul) {
        if a == 0 || b == 0 {
            r = 0;
            ok = true;
        } else if a == 1 {
            r = b;
            ok = true;
        } else if b == 1 {
            r = a;
            ok = true;
        } else if a == 0 - 1 {
            if b != i64min {
                r = 0 - b;
                ok = true;
            }
        } else if b == 0 - 1 {
            if a != i64min {
                r = 0 - a;
                ok = true;
            }
        } else if a != i64min && b != i64min {
            // a>0: a*b<=MAX iff b<=MAX/a, >=MIN iff b>=MIN/a (trunc=exact bound)
            // a<0: inequalities flip — hi=MIN/a, lo=MAX/a. Neither division
            // overflows here (|a|,|b|>1, neither is i64min).
            var hi: i64 = 0;
            var lo: i64 = 0;
            if a > 0 {
                hi = i64max / a;
                lo = i64min / a;
            } else {
                hi = i64min / a;
                lo = i64max / a;
            }
            if b <= hi && b >= lo {
                r = a * b;
                ok = true;
            }
        }
    } else if binop_eq(op, BinOp::Div) {
        if b != 0 && !(a == i64min && b == 0 - 1) {
            r = a / b;
            ok = true;
        }
    } else if binop_eq(op, BinOp::Mod) {
        if b != 0 && !(a == i64min && b == 0 - 1) {
            r = a % b;
            ok = true;
        }
    } else if binop_eq(op, BinOp::Shl) {
        if b >= 0 && b < 64 {
            r = a << b;
            ok = true;
        }
    } else if binop_eq(op, BinOp::Shr) {
        if b >= 0 && b < 64 {
            r = a >> b;
            ok = true;
        }
    } else if binop_eq(op, BinOp::BitAnd) {
        r = a & b;
        ok = true;
    } else if binop_eq(op, BinOp::BitOr) {
        r = a | b;
        ok = true;
    } else if binop_eq(op, BinOp::BitXor) {
        r = a ^ b;
        ok = true;
    } else if binop_eq(op, BinOp::And) {
        if a != 0 && b != 0 {
            r = 1;
        }
        ok = true;
    } else if binop_eq(op, BinOp::Or) {
        if a != 0 || b != 0 {
            r = 1;
        }
        ok = true;
    } else if binop_eq(op, BinOp::Eq) {
        if a == b {
            r = 1;
        }
        ok = true;
    } else if binop_eq(op, BinOp::Neq) {
        if a != b {
            r = 1;
        }
        ok = true;
    } else if binop_eq(op, BinOp::Lt) {
        if a < b {
            r = 1;
        }
        ok = true;
    } else if binop_eq(op, BinOp::Gt) {
        if a > b {
            r = 1;
        }
        ok = true;
    } else if binop_eq(op, BinOp::LtEq) {
        if a <= b {
            r = 1;
        }
        ok = true;
    } else if binop_eq(op, BinOp::GtEq) {
        if a >= b {
            r = 1;
        }
        ok = true;
    }
    if ok {
        tag = 1;
    }
    out.push(tag);
    out.push(r);
}

/// Whether `v` (an i64, a u64 as its bit pattern) is a value of type `t`.
/// A u64 above i64's range counts as not fitting: SCCP then leaves the
/// operation to run (conservative, never wrong).
fn iro_fits(v: i64, t: IrType) -> bool {
    match t {
        IrType::I64 => {
            return true;
        }
        IrType::Bool => {
            return v == 0 || v == 1;
        }
        IrType::U64 => {
            return v >= 0;
        }
        _ => {
        }
    }
    if !iro_int_ty(t) {
        return true;
    }
    var bits: i64 = ir_type_size(t) * 8;
    if bits >= 64 {
        return true;
    }
    if iro_unsigned(t) {
        return v >= 0 && v <= (1 << bits) - 1;
    }
    var lim: i64 = 1 << (bits - 1);
    return v >= 0 - lim && v <= lim - 1;
}

/// The type of value `id` in `f` (I64 when it has none recorded).
fn iro_value_ty(f: &IrFunction, id: i64) -> IrType {
    match IrFunction_get_meta(f, id) {
        OptValueMeta::Some(m) => {
            return m.ty;
        }
        OptValueMeta::None => {
        }
    }
    // a parameter has no instruction: its declared type (a u64 parameter
    // compared signed)
    var pi: i64 = 0;
    while pi < f.params.len() {
        if f.params.get(pi).id == id {
            return f.params.get(pi).ty;
        }
        pi = pi + 1;
    }
    return IrType::I64;
}

/// SCCP's fold of `op` on constants `a`, `b` of type `ot` (the operands'
/// type) is the value the program computes: iro_sccp_eval works in i64,
/// so a result outside `ot` (an overflow the program panics on, or wraps
/// under @wrapping) is left to run, and so is any unsigned division,
/// remainder, right shift or comparison of a u64 above i64's range, and a
/// shift by the width of `ot` or more.
fn iro_sccp_fold_ok(op: BinOp, a: i64, b: i64, r: i64, ot: IrType) -> bool {
    if !iro_fits(a, ot) || !iro_fits(b, ot) {
        return false;
    }
    var bits: i64 = ir_type_size(ot) * 8;
    if binop_eq(op, BinOp::Shl) || binop_eq(op, BinOp::Shr) {
        if bits > 0 && b >= bits {
            return false;
        }
    }
    if iop_is_cmp(op) || binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or) {
        return true;
    }
    return iro_fits(r, ot);
}

/// Bits kept by an IntTrunc/IntExtend into `to`, with `to`'s sign.
fn iro_eval_narrow(v: i64, to: IrType) -> i64 {
    var bits: i64 = ir_type_size(to) * 8;
    if bits >= 64 {
        return v;
    }
    var mask: i64 = (1 << bits) - 1;
    var r: i64 = v & mask;
    var top: i64 = 1 << (bits - 1);
    if !iro_unsigned(to) && (r & top) != 0 {
        r = r - (1 << bits);
    }
    return r;
}

fn iro_sccp(f: &mut IrFunction) -> bool {
    var cfg: IroCfg = iro_cfg(f);
    if cfg.n == 0 {
        return false;
    }
    var n: i64 = f.next_value + 1;
    var lat_t: Vec<i64> = peir_zeros(n);
    // 0 top, 1 const, 2 varying
    var lat_v: Vec<i64> = peir_zeros(n);
    var live: Vec<i64> = peir_zeros(cfg.n);
    var entry_b: i64 = -1;
    var e: i64 = 0;
    while e < f.blocks.len() {
        if f.blocks.get(e).id == f.entry {
            entry_b = e;
            break;
        }
        e = e + 1;
    }
    if entry_b < 0 {
        entry_b = 0;
    }
    live.set(entry_b, 1);
    var changed: bool = false;
    var ri: i64 = 0;
    while ri < cfg.rpo.len() {
        var bi: i64 = cfg.rpo.get(ri);
        if live.get(bi) == 0 {
            ri = ri + 1;
            continue;
        }
        var blk: BasicBlock = f.blocks.get(bi);
        var k: i64 = 0;
        while k < blk.instructions.len() {
            var id: i64 = blk.instructions.get(k);
            if id >= 0 && id < n && lat_t.get(id) == 0 {
                var tag: i64 = 2;
                var cval: i64 = 0;
                match peir_inst_of(f, id) {
                    Inst::ConstInt(v, _) => {
                        tag = 1;
                        cval = v;
                    }
                    Inst::ConstBool(v) => {
                        tag = 1;
                        if v {
                            cval = 1;
                        }
                    }
                    Inst::ConstNull(_) => {
                        tag = 1;
                        cval = 0;
                    }
                    Inst::BinOp(op, a, bb, t) => {
                        if iro_int_ty(t) && a >= 0 && a < n && bb >= 0 && bb < n && lat_t.get(a) == 1 && lat_t.get(bb) == 1 {
                            var ev: Vec<i64> = Vec::new();
                            iro_sccp_eval(op, lat_v.get(a), lat_v.get(bb), &mut ev);
                            tag = ev.get(0);
                            cval = ev.get(1);
                            // a comparison is typed Bool: its operands
                            // carry the type that decides the fold
                            var ot: IrType = t;
                            if iop_is_cmp(op) {
                                ot = iro_value_ty(f, a);
                            }
                            if tag == 1 && !iro_sccp_fold_ok(op, lat_v.get(a), lat_v.get(bb), cval, ot) {
                                tag = 2;
                            }
                        }
                    }
                    Inst::UnaryOp(uop, a, t) => {
                        if iro_int_ty(t) && a >= 0 && a < n && lat_t.get(a) == 1 {
                            var av: i64 = lat_v.get(a);
                            match uop {
                                UnaryOp::Neg => {
                                    if av == 0 - 9223372036854775807 - 1 {
                                        tag = 2;
                                    } else {
                                        tag = 1;
                                        cval = 0 - av;
                                    }
                                    // -x out of a narrow or unsigned type
                                    if tag == 1 && !iro_fits(cval, t) {
                                        tag = 2;
                                    }
                                }
                                UnaryOp::BitNot => {
                                    tag = 1;
                                    // 2g.89: `0 - av - 1` overflowed for
                                    // i64::MIN (~(1 << 63) in the program)
                                    cval = av ^ (0 - 1);
                                    // ~x of an unsigned type keeps its width
                                    if iro_unsigned(t) {
                                        var nb: i64 = ir_type_size(t) * 8;
                                        if nb >= 64 {
                                            tag = 2;
                                        } else {
                                            cval = cval & ((1 << nb) - 1);
                                        }
                                    }
                                    if tag == 1 && !iro_fits(cval, t) {
                                        tag = 2;
                                    }
                                }
                                UnaryOp::Not => {
                                    tag = 1;
                                    if av == 0 {
                                        cval = 1;
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                    }
                    Inst::IntExtend(a, _, tt) => {
                        if iro_int_ty(tt) && a >= 0 && a < n && lat_t.get(a) == 1 {
                            tag = 1;
                            cval = iro_eval_narrow(lat_v.get(a), tt);
                        }
                    }
                    Inst::IntTrunc(a, _, tt) => {
                        if iro_int_ty(tt) && a >= 0 && a < n && lat_t.get(a) == 1 {
                            tag = 1;
                            cval = iro_eval_narrow(lat_v.get(a), tt);
                        }
                    }
                    Inst::BitCast(a, _, tt) => {
                        if iro_int_ty(tt) && a >= 0 && a < n && lat_t.get(a) == 1 {
                            tag = 1;
                            cval = lat_v.get(a);
                        }
                    }
                    _ => {
                    }
                }
                lat_t.set(id, tag);
                lat_v.set(id, cval);
            }
            k = k + 1;
        }
        if blk.instructions.len() > 0 {
            var last: i64 = blk.instructions.get(blk.instructions.len() - 1);
            var mark: Vec<i64> = Vec::new();
            match peir_inst_of(f, last) {
                Inst::Jump(t) => {
                    mark.push(t);
                }
                Inst::Branch(c, t1, t2) => {
                    var is_c: bool = c >= 0 && c < n && lat_t.get(c) == 1;
                    var keep_t: i64 = -1;
                    if is_c {
                        if lat_v.get(c) != 0 {
                            keep_t = t1;
                        } else {
                            keep_t = t2;
                        }
                    }
                    if keep_t >= 0 {
                        IrFunction_set_inst(f, last, Inst::Jump(keep_t));
                        var gone: i64 = t2;
                        if keep_t == t2 {
                            gone = t1;
                        }
                        iro_drop_pred(f, gone, blk.id);
                        mark.push(keep_t);
                        changed = true;
                    } else {
                        mark.push(t1);
                        mark.push(t2);
                    }
                }
                _ => {
                }
            }
            var mi: i64 = 0;
            while mi < mark.len() {
                var mid: i64 = mark.get(mi);
                var midx: i64 = -1;
                if mid >= 0 && mid < cfg.index.len() {
                    midx = cfg.index.get(mid);
                }
                if midx >= 0 {
                    live.set(midx, 1);
                }
                mi = mi + 1;
            }
        }
        ri = ri + 1;
    }
    var ri2: i64 = 0;
    while ri2 < cfg.rpo.len() {
        var bi2: i64 = cfg.rpo.get(ri2);
        if live.get(bi2) != 0 {
            var blk2: BasicBlock = f.blocks.get(bi2);
            var k2: i64 = 0;
            while k2 < blk2.instructions.len() {
                var id2: i64 = blk2.instructions.get(k2);
                if id2 >= 0 && id2 < n && lat_t.get(id2) == 1 {
                    match peir_inst_of(f, id2) {
                        Inst::ConstInt(_, _) => {
                        }
                        Inst::ConstBool(_) => {
                        }
                        Inst::ConstNull(_) => {
                        }
                        Inst::BinOp(op, _, _, t) => {
                            if iop_is_cmp(op) || binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or) {
                                IrFunction_set_inst(f, id2, Inst::ConstBool(lat_v.get(id2) != 0));
                            } else {
                                IrFunction_set_inst(f, id2, Inst::ConstInt(lat_v.get(id2), t));
                            }
                            changed = true;
                        }
                        Inst::UnaryOp(uop, _, t) => {
                            var isbool: bool = false;
                            match uop {
                                UnaryOp::Not => {
                                    isbool = true;
                                }
                                _ => {
                                }
                            }
                            if isbool {
                                IrFunction_set_inst(f, id2, Inst::ConstBool(lat_v.get(id2) != 0));
                            } else {
                                IrFunction_set_inst(f, id2, Inst::ConstInt(lat_v.get(id2), t));
                            }
                            changed = true;
                        }
                        Inst::IntExtend(_, _, t) => {
                            if iro_int_ty(t) {
                                IrFunction_set_inst(f, id2, Inst::ConstInt(lat_v.get(id2), t));
                                changed = true;
                            }
                        }
                        Inst::IntTrunc(_, _, t) => {
                            if iro_int_ty(t) {
                                IrFunction_set_inst(f, id2, Inst::ConstInt(lat_v.get(id2), t));
                                changed = true;
                            }
                        }
                        Inst::BitCast(_, _, t) => {
                            if iro_int_ty(t) {
                                IrFunction_set_inst(f, id2, Inst::ConstInt(lat_v.get(id2), t));
                                changed = true;
                            }
                        }
                        _ => {
                        }
                    }
                }
                k2 = k2 + 1;
            }
        }
        ri2 = ri2 + 1;
    }
    if changed {
        iro_drop_unreachable(f);
    }
    return changed;
}

// ME15: dead stores. A local whose address goes nowhere but loads and
// stores (iro_plain_locals), that the backend does not read by itself
// (drops, @zeroize, @persist), and that is never loaded: every store to it
// is dead.
// stores (iro_plain_locals), that the backend does not read by itself
// (drops, @zeroize, @persist), and that is never loaded: every store to it
// is dead. In a block, a store followed by another store to the same such
// local with no load of it in between is dead too (no other code can read
// the local; what a panic between them would skip is never seen, since
// nothing unwinds). The stored values stay: only the stores go.

fn iro_backend_reads(f: &IrFunction, loc: i64) -> bool {
    var i: i64 = 0;
    while i < f.drop_locals.len() {
        if f.drop_locals.get(i).id == loc {
            return true;
        }
        i = i + 1;
    }
    i = 0;
    while i < f.zeroize_locals.len() {
        if f.zeroize_locals.get(i).id == loc {
            return true;
        }
        i = i + 1;
    }
    i = 0;
    while i < f.persist_vars.len() {
        if f.persist_vars.get(i).id == loc {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Does `inst` leave the middle of its block (a stored value may then be
/// read elsewhere)?
fn iro_dse_barrier(inst: Inst) -> bool {
    match inst {
        Inst::TryUnwrap(_, _, _, _) => {
            return true;
        }
        Inst::Asm(_, _, _, _) => {
            return true;
        }
        Inst::PersistLoad(_, _, _) => {
            return true;
        }
        Inst::PersistSave(_, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

fn iro_dse(f: &mut IrFunction) -> bool {
    var plain: Vec<i64> = iro_plain_locals(f);
    var n: i64 = plain.len();
    // the plain locals that are read at all
    var loaded: Vec<i64> = peir_zeros(n);
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            match peir_inst_of(f, ids.get(k)) {
                Inst::Load(p, _) => {
                    if p >= 0 && p < n {
                        loaded.set(p, 1);
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var changed: bool = false;
    b = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var dead: Vec<i64> = peir_zeros(blk.instructions.len());
        // the last store to each local in this block not read since (index + 1)
        var pending: i64 = HashMap_new();
        var any: bool = false;
        var k: i64 = 0;
        while k < blk.instructions.len() {
            var inst: Inst = peir_inst_of(f, blk.instructions.get(k));
            if iro_dse_barrier(inst) {
                HashMap_clear(pending);
            }
            match inst {
                Inst::Store(p, _, _) => {
                    if p >= 0 && p < n && plain.get(p) == 1 && !iro_backend_reads(f, p) {
                        if loaded.get(p) == 0 {
                            dead.set(k, 1);
                            any = true;
                        } else {
                            var key: str = int_to_str(p);
                            if HashMap_contains(pending, key) {
                                dead.set(HashMap_get(pending, key) - 1, 1);
                                any = true;
                            }
                            HashMap_insert(pending, key, k + 1);
                        }
                    }
                }
                Inst::Load(p2, _) => {
                    if p2 >= 0 && p2 < n {
                        HashMap_remove(pending, int_to_str(p2));
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        if any {
            var keep: Vec<i64> = Vec::new();
            k = 0;
            while k < blk.instructions.len() {
                if dead.get(k) == 0 {
                    keep.push(blk.instructions.get(k));
                }
                k = k + 1;
            }
            blk.instructions = keep;
            f.blocks.set(b, blk);
            changed = true;
        }
        b = b + 1;
    }
    // LF4: with the alias query (iropt_me), a store to any local's or
    // `&mut` parameter's place that a later store in its block overwrites
    // before anything may read it is dead too
    if ime_overwritten_stores(f) {
        changed = true;
    }
    if changed {
        iro_dce_more(f);
    }
    return changed;
}

/// Values DCE may drop beyond iro_pure: ones that cannot panic, read no
/// memory others write and do nothing else (comparisons, bit operations,
/// widening, a load of a plain local). Checked arithmetic is not among
/// them: dropping it would drop its overflow panic.
fn iro_removable(inst: Inst, plain: &Vec<i64>) -> bool {
    if iro_pure(inst) {
        return true;
    }
    match inst {
        Inst::BinOp(op, _, _, _) => {
            return binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::GtEq) || binop_eq(op, BinOp::BitAnd) || binop_eq(op, BinOp::BitOr) || binop_eq(op, BinOp::BitXor) || binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or);
        }
        Inst::IntExtend(_, _, _) => {
            return true;
        }
        Inst::Load(p, _) => {
            return p >= 0 && p < plain.len() && plain.get(p) == 1;
        }
        _ => {
            return false;
        }
    }
}

/// DCE with iro_removable, until nothing more goes (the values the dead
/// stores stored, the loads and comparisons only they used).
fn iro_dce_more(f: &mut IrFunction) -> bool {
    var plain: Vec<i64> = iro_plain_locals(f);
    var any: bool = false;
    var round: i64 = 0;
    while round < 4 {
        var u: IroUses = iro_uses(f);
        var removed: bool = false;
        var b: i64 = 0;
        while b < f.blocks.len() {
            var blk: BasicBlock = f.blocks.get(b);
            var keep: Vec<i64> = Vec::new();
            var gone: bool = false;
            var k: i64 = 0;
            while k < blk.instructions.len() {
                var id: i64 = blk.instructions.get(k);
                if id >= 0 && id < u.count.len() && u.count.get(id) == 0 && iro_removable(peir_inst_of(f, id), &plain) {
                    gone = true;
                } else {
                    keep.push(id);
                }
                k = k + 1;
            }
            if gone {
                blk.instructions = keep;
                f.blocks.set(b, blk);
                removed = true;
            }
            b = b + 1;
        }
        if !removed {
            return any;
        }
        any = true;
        round = round + 1;
    }
    return any;
}

// ME12: algebraic simplification beyond the identities of rules.fd.
//   - (x + c1) + c2 -> x + (c1 + c2), and the same with subtractions, when
//     c1 and c2 move x the same way: the sum overflows exactly when one of
//     the two steps did, so every overflow panic stays (the inner step,
//     read only here, goes)
//   - x * 2^k -> x << k where the multiplication needs no overflow check
//     (checks.fd's flags, or an @wrapping function)
//   - x / 2^k -> x >> k and x % 2^k -> x & (2^k - 1) for x known >= 0 or
//     of an unsigned type (the divisor is not zero: no check is lost)

/// k when c is 2^k (1 <= k <= 62), else -1.
fn iro_log2(c: i64) -> i64 {
    if c < 2 {
        return -1;
    }
    var k: i64 = 0;
    var v: i64 = c;
    while v > 1 {
        if (v & 1) != 0 {
            return -1;
        }
        v = v >> 1;
        k = k + 1;
    }
    if k > 62 {
        return -1;
    }
    return k;
}

fn iro_unsigned(t: IrType) -> bool {
    match t {
        IrType::U8 => {
            return true;
        }
        IrType::U16 => {
            return true;
        }
        IrType::U32 => {
            return true;
        }
        IrType::U64 => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// The signed step `id` adds to its first operand: x + c is c, x - c is -c
/// (OptI64::None when it is not one, or -c would not fit).
fn iro_step(f: &IrFunction, id: i64) -> OptI64 {
    match peir_inst_of(f, id) {
        Inst::BinOp(op, _, r, t) => {
            if !ir_type_eq(t, IrType::I64) {
                return OptI64::None;
            }
            match iro_const_int(f, r) {
                OptI64::Some(c) => {
                    if binop_eq(op, BinOp::Add) {
                        return OptI64::Some(c);
                    }
                    if binop_eq(op, BinOp::Sub) && c != 0 - IRO_I64_MAX - 1 {
                        return OptI64::Some(0 - c);
                    }
                }
                OptI64::None => {
                }
            }
        }
        _ => {
        }
    }
    return OptI64::None;
}

fn iro_first_operand(f: &IrFunction, id: i64) -> i64 {
    match peir_inst_of(f, id) {
        Inst::BinOp(_, l, _, _) => {
            return l;
        }
        _ => {
            return -1;
        }
    }
}

/// A constant placed in front of position `pos` of block `bi`.
fn iro_const_before(f: &mut IrFunction, bi: i64, pos: i64, v: i64, t: IrType) -> i64 {
    var cid: i64 = iro_detached(f, Inst::ConstInt(v, t));
    var blk: BasicBlock = f.blocks.get(bi);
    var ids: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < blk.instructions.len() {
        if k == pos {
            ids.push(cid);
        }
        ids.push(blk.instructions.get(k));
        k = k + 1;
    }
    if pos >= blk.instructions.len() {
        ids.push(cid);
    }
    blk.instructions = ids;
    f.blocks.set(bi, blk);
    return cid;
}

fn iro_remove_from_block(f: &mut IrFunction, id: i64) {
    var b: i64 = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var keep: Vec<i64> = Vec::new();
        var found: bool = false;
        var k: i64 = 0;
        while k < blk.instructions.len() {
            if blk.instructions.get(k) == id {
                found = true;
            } else {
                keep.push(blk.instructions.get(k));
            }
            k = k + 1;
        }
        if found {
            blk.instructions = keep;
            f.blocks.set(b, blk);
            return;
        }
        b = b + 1;
    }
}

/// An integer or boolean type: identities never apply to floats
/// (`x * 0` is not 0 for NaN, `x - x` is not 0 for -0.0).
fn iro_int_ty(t: IrType) -> bool {
    match t {
        IrType::I8 => {
            return true;
        }
        IrType::I16 => {
            return true;
        }
        IrType::I32 => {
            return true;
        }
        IrType::I64 => {
            return true;
        }
        IrType::U8 => {
            return true;
        }
        IrType::U16 => {
            return true;
        }
        IrType::U32 => {
            return true;
        }
        IrType::U64 => {
            return true;
        }
        IrType::Bool => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// `v` renamed through `map` until it maps nowhere (the value an identity
/// leaves behind can itself have been folded).
fn iro_map_final(map: &Vec<i64>, v: i64) -> i64 {
    var x: i64 = v;
    var gi: i64 = 0;
    while x >= 0 && x < map.len() && map.get(x) != 0 && gi < 10000 {
        x = map.get(x) - 1;
        gi = gi + 1;
    }
    return x;
}

/// A ConstBool instruction as 0/1.
fn iro_const_bool_val(f: &IrFunction, id: i64) -> OptI64 {
    match peir_inst_of(f, id) {
        Inst::ConstBool(v) => {
            if v {
                return OptI64::Some(1);
            }
            return OptI64::Some(0);
        }
        _ => {
            return OptI64::None;
        }
    }
}

/// ME12: identities — an op whose result is a constant or one of its
/// operands. Only where removing the op cannot remove a panic: under
/// checked arithmetic `x / x`, `0 / x`, `0 % x` and `0 << x` stay
/// (they can still panic); `x + 0`, `x * 0`, `x / 1`, `x % 1`, `x - x`,
/// `x << 0` and every bit op never can.
fn iro_identities(f: &mut IrFunction) -> bool {
    var bad: Vec<i64> = iro_unhandled_uses(f);
    var map: Vec<i64> = peir_zeros(f.next_value + 1);
    var dead: Vec<i64> = peir_zeros(f.next_value + 1);
    var changed: bool = false;
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < bad.len() && bad.get(id) == 0 {
                var alias: i64 = -1;
                var bkonst: i64 = -1;
                match peir_inst_of(f, id) {
                    Inst::BinOp(op, l, r, t) => {
                        var lkonst: OptI64 = iro_const_int(f, l);
                        var rkonst: OptI64 = iro_const_int(f, r);
                        var lc0: bool = false;
                        var rc0: bool = false;
                        var lc1: bool = false;
                        var rc1: bool = false;
                        var lneg1: bool = false;
                        var rneg1: bool = false;
                        match lkonst {
                            OptI64::Some(c) => {
                                lc0 = c == 0;
                                lc1 = c == 1;
                                lneg1 = c == 0 - 1;
                            }
                            OptI64::None => {
                            }
                        }
                        match rkonst {
                            OptI64::Some(c) => {
                                rc0 = c == 0;
                                rc1 = c == 1;
                                rneg1 = c == 0 - 1;
                            }
                            OptI64::None => {
                            }
                        }
                        if iro_int_ty(t) {
                            if binop_eq(op, BinOp::Add) {
                                if rc0 {
                                    alias = l;
                                } else if lc0 {
                                    alias = r;
                                }
                            } else if binop_eq(op, BinOp::Sub) {
                                if rc0 {
                                    alias = l;
                                } else if l == r {
                                    IrFunction_set_inst(f, id, Inst::ConstInt(0, t));
                                    changed = true;
                                }
                            } else if binop_eq(op, BinOp::Mul) {
                                if lc0 || rc0 {
                                    IrFunction_set_inst(f, id, Inst::ConstInt(0, t));
                                    changed = true;
                                } else if lc1 {
                                    alias = r;
                                } else if rc1 {
                                    alias = l;
                                }
                            } else if binop_eq(op, BinOp::Div) {
                                if rc1 {
                                    alias = l;
                                }
                            } else if binop_eq(op, BinOp::Mod) {
                                if rc1 {
                                    IrFunction_set_inst(f, id, Inst::ConstInt(0, t));
                                    changed = true;
                                }
                            } else if binop_eq(op, BinOp::Shl) || binop_eq(op, BinOp::Shr) {
                                if rc0 {
                                    alias = l;
                                }
                            } else if binop_eq(op, BinOp::BitAnd) {
                                if lc0 || rc0 {
                                    IrFunction_set_inst(f, id, Inst::ConstInt(0, t));
                                    changed = true;
                                } else if l == r {
                                    alias = l;
                                } else if rneg1 && (ir_type_eq(t, IrType::I64) || ir_type_eq(t, IrType::U64)) {
                                    alias = l;
                                } else if lneg1 && (ir_type_eq(t, IrType::I64) || ir_type_eq(t, IrType::U64)) {
                                    alias = r;
                                }
                            } else if binop_eq(op, BinOp::BitOr) {
                                if rc0 {
                                    alias = l;
                                } else if lc0 {
                                    alias = r;
                                } else if l == r {
                                    alias = l;
                                } else if (lneg1 || rneg1) && (ir_type_eq(t, IrType::I64) || ir_type_eq(t, IrType::U64)) {
                                    IrFunction_set_inst(f, id, Inst::ConstInt(0 - 1, t));
                                    changed = true;
                                }
                            } else if binop_eq(op, BinOp::BitXor) {
                                if rc0 {
                                    alias = l;
                                } else if lc0 {
                                    alias = r;
                                } else if l == r {
                                    IrFunction_set_inst(f, id, Inst::ConstInt(0, t));
                                    changed = true;
                                }
                            } else if binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or) {
                                var lb: OptI64 = iro_const_bool_val(f, l);
                                var rb: OptI64 = iro_const_bool_val(f, r);
                                var lbv: i64 = -1;
                                var rbv: i64 = -1;
                                match lb {
                                    OptI64::Some(v) => {
                                        lbv = v;
                                    }
                                    OptI64::None => {
                                    }
                                }
                                match rb {
                                    OptI64::Some(v) => {
                                        rbv = v;
                                    }
                                    OptI64::None => {
                                    }
                                }
                                if binop_eq(op, BinOp::And) {
                                    if rbv == 0 || lbv == 0 {
                                        bkonst = 0;
                                    } else if rbv == 1 {
                                        alias = l;
                                    } else if lbv == 1 {
                                        alias = r;
                                    }
                                } else {
                                    if rbv == 1 || lbv == 1 {
                                        bkonst = 1;
                                    } else if rbv == 0 {
                                        alias = l;
                                    } else if lbv == 0 {
                                        alias = r;
                                    }
                                }
                            } else {
                                // comparisons of a value with itself: Eq,
                                // LtEq, GtEq always true; Neq, Lt, Gt false
                                if l == r && !binop_eq(op, BinOp::And) && !binop_eq(op, BinOp::Or) {
                                    if binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::GtEq) {
                                        bkonst = 1;
                                    }
                                    if binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::Gt) {
                                        bkonst = 0;
                                    }
                                }
                            }
                        } else if !iro_int_ty(t) && l == r {
                            // a pointer compared to itself: still total
                            match t {
                                IrType::Ptr(_) => {
                                    if binop_eq(op, BinOp::Eq) {
                                        bkonst = 1;
                                    }
                                    if binop_eq(op, BinOp::Neq) {
                                        bkonst = 0;
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                    }
                    Inst::UnaryOp(uop, a, _) => {
                        // -(-x), !( !x ), ~(~x): the inner op keeps its own
                        // panic (Neg of MIN), the outer one cannot add one
                        match peir_inst_of(f, a) {
                            Inst::UnaryOp(uop2, a2, _) => {
                                var same: bool = false;
                                match uop {
                                    UnaryOp::Neg => {
                                        match uop2 {
                                            UnaryOp::Neg => {
                                                same = true;
                                            }
                                            _ => {
                                            }
                                        }
                                    }
                                    UnaryOp::Not => {
                                        match uop2 {
                                            UnaryOp::Not => {
                                                same = true;
                                            }
                                            _ => {
                                            }
                                        }
                                    }
                                    UnaryOp::BitNot => {
                                        match uop2 {
                                            UnaryOp::BitNot => {
                                                same = true;
                                            }
                                            _ => {
                                            }
                                        }
                                    }
                                    _ => {
                                    }
                                }
                                if same {
                                    alias = a2;
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                if alias >= 0 && alias < map.len() {
                    var fx: i64 = iro_map_final(&map, alias);
                    if fx != id {
                        map.set(id, fx + 1);
                        dead.set(id, 1);
                        changed = true;
                    }
                }
                if bkonst >= 0 {
                    IrFunction_set_inst(f, id, Inst::ConstBool(bkonst == 1));
                    changed = true;
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    if changed {
        iro_apply_map(f, &map);
        b = 0;
        while b < f.blocks.len() {
            var blk: BasicBlock = f.blocks.get(b);
            var keep: Vec<i64> = Vec::new();
            var k2: i64 = 0;
            while k2 < blk.instructions.len() {
                var i2: i64 = blk.instructions.get(k2);
                if i2 < 0 || i2 >= dead.len() || dead.get(i2) == 0 {
                    keep.push(i2);
                }
                k2 = k2 + 1;
            }
            blk.instructions = keep;
            f.blocks.set(b, blk);
            b = b + 1;
        }
    }
    return changed;
}

fn iro_simplify(f: &mut IrFunction) -> bool {
    var changed: bool = false;
    if iro_identities(f) {
        changed = true;
    }
    var flags: Vec<i64> = peir_unchecked_ops(f, f.next_value + 1);
    // OP3: the cached lists only while iro_identities changed nothing
    if changed {
        iro_uses_forget();
    }
    var u: IroUses = iro_uses_entry(f);
    var b: i64 = 0;
    while b < f.blocks.len() {
        var k: i64 = 0;
        while k < f.blocks.get(b).instructions.len() {
            var id: i64 = f.blocks.get(b).instructions.get(k);
            match peir_inst_of(f, id) {
                Inst::BinOp(op, l, r, t) => {
                    var done: bool = false;
                    // reassociation of constant steps
                    if binop_eq(op, BinOp::Add) || binop_eq(op, BinOp::Sub) {
                        match iro_step(f, id) {
                            OptI64::Some(d2) => {
                                if l >= 0 && l < u.count.len() && u.count.get(l) == 1 && u.block_of.get(l) == b {
                                    match iro_step(f, l) {
                                        OptI64::Some(d1) => {
                                            var same: bool = (d1 > 0 && d2 > 0) || (d1 < 0 && d2 < 0);
                                            var fits: bool = (d1 > 0 && d2 <= IRO_I64_MAX - d1) || (d1 < 0 && d2 >= (0 - IRO_I64_MAX) - d1);
                                            if same && fits {
                                                var x: i64 = iro_first_operand(f, l);
                                                var d: i64 = d1 + d2;
                                                var cid: i64 = 0;
                                                iro_uses_drop(&mut u, f, id);
                                                iro_uses_drop(&mut u, f, l);
                                                if d > 0 {
                                                    cid = iro_const_before(f, b, k, d, t);
                                                    IrFunction_set_inst(f, id, Inst::BinOp(BinOp::Add, x, cid, t));
                                                } else {
                                                    cid = iro_const_before(f, b, k, 0 - d, t);
                                                    IrFunction_set_inst(f, id, Inst::BinOp(BinOp::Sub, x, cid, t));
                                                }
                                                iro_uses_reg(&mut u, cid, b);
                                                iro_uses_add_ops(&mut u, f, id);
                                                iro_remove_from_block(f, l);
                                                changed = true;
                                                done = true;
                                            }
                                        }
                                        OptI64::None => {
                                        }
                                    }
                                }
                            }
                            OptI64::None => {
                            }
                        }
                    }
                    // multiplication by a power of two
                    if !done && binop_eq(op, BinOp::Mul) && (ir_type_eq(t, IrType::I64) || iro_unsigned(t)) {
                        var unchecked: bool = f.is_wrapping || (id < flags.len() && (flags.get(id) & 1) != 0);
                        if unchecked {
                            var x2: i64 = -1;
                            var sh: i64 = -1;
                            match iro_const_int(f, r) {
                                OptI64::Some(c) => {
                                    sh = iro_log2(c);
                                    x2 = l;
                                }
                                OptI64::None => {
                                    match iro_const_int(f, l) {
                                        OptI64::Some(c2) => {
                                            sh = iro_log2(c2);
                                            x2 = r;
                                        }
                                        OptI64::None => {
                                        }
                                    }
                                }
                            }
                            if sh > 0 {
                                iro_uses_drop(&mut u, f, id);
                                var kid: i64 = iro_const_before(f, b, k, sh, t);
                                IrFunction_set_inst(f, id, Inst::BinOp(BinOp::Shl, x2, kid, t));
                                iro_uses_reg(&mut u, kid, b);
                                iro_uses_add_ops(&mut u, f, id);
                                changed = true;
                                done = true;
                            }
                        }
                    }
                    // division and remainder by a power of two
                    if !done && (binop_eq(op, BinOp::Div) || binop_eq(op, BinOp::Mod)) && (ir_type_eq(t, IrType::I64) || iro_unsigned(t)) {
                        var nonneg: bool = iro_unsigned(t) || (l >= 0 && l < flags.len() && (flags.get(l) & 2) != 0);
                        match iro_const_int(f, r) {
                            OptI64::Some(c3) => {
                                var sh2: i64 = iro_log2(c3);
                                if nonneg && sh2 > 0 {
                                    iro_uses_drop(&mut u, f, id);
                                    var kid2: i64 = -1;
                                    if binop_eq(op, BinOp::Div) {
                                        kid2 = iro_const_before(f, b, k, sh2, t);
                                        IrFunction_set_inst(f, id, Inst::BinOp(BinOp::Shr, l, kid2, t));
                                    } else {
                                        kid2 = iro_const_before(f, b, k, c3 - 1, t);
                                        IrFunction_set_inst(f, id, Inst::BinOp(BinOp::BitAnd, l, kid2, t));
                                    }
                                    iro_uses_reg(&mut u, kid2, b);
                                    iro_uses_add_ops(&mut u, f, id);
                                    changed = true;
                                }
                            }
                            OptI64::None => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return changed;
}

// ME3 (partial): promote a plain local to SSA values when every load of
// it has exactly one reaching store. Forward dataflow per alloca over the
// reachable CFG; the state is the stored value id, -1 when no store has
// reached the point yet, -2 when predecessors disagree or a store could
// join an uninitialized path — the cases that would need phis, which the
// IR cannot carry yet (Jump/Branch take no arguments), so those loads
// stay in memory. Replaced loads are dropped from their blocks; the
// stores left dead are removed by dse. Since Nov 17 it runs only where
// compiler/ssa.fd's round trip, which subsumes it, does not
// (iro_promote_here).
/// The value a store instruction stores now: its operand may have been
/// renamed by a promotion since the event table recorded the store's id.
fn iro_store_val(f: &IrFunction, iid: i64) -> i64 {
    match peir_inst_of(f, iid) {
        Inst::Store(_, sv, _) => {
            return sv;
        }
        _ => {
            return -1;
        }
    }
}

/// ME3 (Nov 17): does `promote` run on `f`? compiler/ssa.fd's round trip
/// (`ssa`, on by default) subsumes it: it replaces every load of a local
/// that has one reaching store too, and the merges promote leaves in memory.
/// With ssa on, promote runs only on the functions ssa does not take
/// (ssa_takes: @constant_time, TryUnwrap or Asm, an entry block with
/// predecessors), unless FID_IROPT_ON names `promote` (every function, as
/// before). With ssa off (FID_IROPT_OFF=ssa) it runs everywhere, as before.
/// Measured with the compiler of Nov 16 (ssa named on): promote after ssa
/// changed 0-4 functions per program and removed 5-6 instructions of
/// 6,000-10,000 (same output, same executable size) for 191 ms of
/// test_collections' 3,984 ms in iropt
/// (docs/perf/mid-end/me3-promote-retired.txt).
fn iro_promote_here(f: &IrFunction, on_ssa: bool, named: bool) -> bool {
    if named || !on_ssa {
        return true;
    }
    // ME3 (Nov 21 evening): promote runs after ssa too. ssa's round trip
    // leaves the slots it could not take in the slot form promote works
    // on, and promote's per-alloca reaching-store dataflow still wins
    // there (test_matrix_mul was ~2% larger with promote retired: 6,048
    // against 5,930 instructions after iropt). The order in iropt_native
    // (midend/ssa first, promote among the cleanup passes) keeps the two
    // out of each other's way: promote only touches plain allocas whose
    // loads all have one reaching store — slots ssa left alone.
    return true;
}

fn iro_promote(f: &mut IrFunction) -> bool {
    var cfg: IroCfg = iro_cfg(f);
    if cfg.n == 0 {
        return false;
    }
    var plain: Vec<i64> = iro_plain_locals(f);
    var nv: i64 = plain.len();
    // per-block events on plain locals: alloca id, kind (0 load, 1 store),
    // payload (the load's inst id / the stored value id)
    var ev_a: Vec<Vec<i64>> = Vec::new();
    var ev_k: Vec<Vec<i64>> = Vec::new();
    var ev_v: Vec<Vec<i64>> = Vec::new();
    var has_load: Vec<i64> = peir_zeros(nv);
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ea: Vec<i64> = Vec::new();
        var ek: Vec<i64> = Vec::new();
        var ev: Vec<i64> = Vec::new();
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var iid: i64 = ids.get(k);
            match peir_inst_of(f, iid) {
                Inst::Load(p, _) => {
                    if p >= 0 && p < nv && plain.get(p) == 1 {
                        ea.push(p);
                        ek.push(0);
                        ev.push(iid);
                        has_load.set(p, 1);
                    }
                }
                Inst::Store(p, sv, _) => {
                    if p >= 0 && p < nv && plain.get(p) == 1 {
                        // ev holds the store's inst id; the stored value is
                        // re-read live (earlier promotions rename operands)
                        ea.push(p);
                        ek.push(1);
                        ev.push(iid);
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        ev_a.push(ea);
        ev_k.push(ek);
        ev_v.push(ev);
        b = b + 1;
    }
    var changed: bool = false;
    // values a TryUnwrap or Asm reads can never be renamed: a load feeding
    // one stays in memory
    var bad: Vec<i64> = iro_unhandled_uses(f);
    // buffers live outside the alloca loop: allocating one per local OOMs
    // on large functions
    var in_st: Vec<i64> = Vec::new();
    var out_st: Vec<i64> = Vec::new();
    var map: Vec<i64> = peir_zeros(nv);
    var deadl: Vec<i64> = peir_zeros(nv);
    var i: i64 = 0;
    while i < cfg.n {
        in_st.push(-1);
        out_st.push(-1);
        i = i + 1;
    }
    var a: i64 = 0;
    while a < nv {
        if plain.get(a) == 1 && has_load.get(a) == 1 {
            var iter: i64 = 0;
            var stable: bool = false;
            while !stable && iter <= cfg.n {
                stable = true;
                var ri: i64 = 0;
                while ri < cfg.rpo.len() {
                    var bi: i64 = cfg.rpo.get(ri);
                    var m: i64 = -3;
                    var ps: Vec<i64> = cfg.preds.get(bi);
                    var pi: i64 = 0;
                    while pi < ps.len() {
                        var s: i64 = out_st.get(ps.get(pi));
                        if m == -3 {
                            m = s;
                        } else if m != s {
                            m = -2;
                        }
                        pi = pi + 1;
                    }
                    if m == -3 {
                        m = -1;
                    }
                    if in_st.get(bi) != m {
                        in_st.set(bi, m);
                        stable = false;
                    }
                    var st: i64 = m;
                    var ea2: Vec<i64> = ev_a.get(bi);
                    var ek2: Vec<i64> = ev_k.get(bi);
                    var ev2: Vec<i64> = ev_v.get(bi);
                    var k2: i64 = 0;
                    while k2 < ea2.len() {
                        if ea2.get(k2) == a && ek2.get(k2) == 1 {
                            st = iro_store_val(f, ev2.get(k2));
                        }
                        k2 = k2 + 1;
                    }
                    if out_st.get(bi) != st {
                        out_st.set(bi, st);
                        stable = false;
                    }
                    ri = ri + 1;
                }
                iter = iter + 1;
            }
            // rewrite loads whose single reaching store is known
            var touched: Vec<i64> = Vec::new();
            var found: bool = false;
            var rj: i64 = 0;
            while rj < cfg.rpo.len() {
                var bj: i64 = cfg.rpo.get(rj);
                var st2: i64 = in_st.get(bj);
                var ea3: Vec<i64> = ev_a.get(bj);
                var ek3: Vec<i64> = ev_k.get(bj);
                var ev3: Vec<i64> = ev_v.get(bj);
                var k3: i64 = 0;
                while k3 < ea3.len() {
                    if ea3.get(k3) == a {
                        if ek3.get(k3) == 1 {
                            st2 = iro_store_val(f, ev3.get(k3));
                        } else if st2 >= 0 {
                            var lid: i64 = ev3.get(k3);
                            // only a value of the load's own type replaces
                            // it: a u64 local stored from an i64-typed
                            // constant would be compared and divided as
                            // signed after promotion (test_int_width)
                            if bad.get(lid) == 0 && ir_type_eq(iro_value_ty(f, lid), iro_value_ty(f, st2)) {
                                if deadl.get(lid) == 0 {
                                    touched.push(lid);
                                }
                                map.set(lid, st2 + 1);
                                deadl.set(lid, 1);
                                found = true;
                            }
                        }
                    }
                    k3 = k3 + 1;
                }
                rj = rj + 1;
            }
            // M24: follow each replacement to the value that survives: a
            // store `x = x` stores a load this loop also replaces and
            // drops, and iro_remap_all applies the map only once
            var rc: i64 = 0;
            while rc < touched.len() {
                var lid2: i64 = touched.get(rc);
                var tgt: i64 = map.get(lid2) - 1;
                var hops: i64 = 0;
                while tgt >= 0 && tgt < nv && deadl.get(tgt) == 1 && hops <= touched.len() {
                    tgt = map.get(tgt) - 1;
                    hops = hops + 1;
                }
                map.set(lid2, tgt + 1);
                rc = rc + 1;
            }
            if found {
                var wb: i64 = 0;
                while wb < f.blocks.len() {
                    var blk: BasicBlock = f.blocks.get(wb);
                    var keep: Vec<i64> = Vec::new();
                    var k4: i64 = 0;
                    var dropped: bool = false;
                    while k4 < blk.instructions.len() {
                        var iid2: i64 = blk.instructions.get(k4);
                        if iid2 >= 0 && iid2 < nv && deadl.get(iid2) == 1 {
                            dropped = true;
                        } else {
                            IrFunction_set_inst(f, iid2, iro_remap_all(peir_inst_of(f, iid2), &map));
                            keep.push(iid2);
                        }
                        k4 = k4 + 1;
                    }
                    if dropped {
                        blk.instructions = keep;
                        f.blocks.set(wb, blk);
                    }
                    wb = wb + 1;
                }
                changed = true;
            }
            var rl: i64 = 0;
            while rl < touched.len() {
                var tl: i64 = touched.get(rl);
                map.set(tl, 0);
                deadl.set(tl, 0);
                rl = rl + 1;
            }
            var rs: i64 = 0;
            while rs < cfg.n {
                in_st.set(rs, -1);
                out_st.set(rs, -1);
                rs = rs + 1;
            }
        }
        a = a + 1;
    }
    if changed {
        iro_dce_more(f);
    }
    return changed;
}

fn iro_name_in(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// WP13: a parameter every call site passes the same constant for is replaced
/// by that constant inside the callee. One pass collects per-candidate
/// constant arguments (flattened, at most 8 parameters); a second pass emits
/// the constants into each candidate's entry block and renames the uses.
pub fn iro_ipcp(module: &mut IrModule) -> i64 {
    var count: i64 = 0;
    var nfn: i64 = module.functions.len();
    var fidx: i64 = HashMap_new();
    var taken: Vec<str> = Vec::new();
    var dtys: Vec<str> = Vec::new();
    var dmeths: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < nfn {
        HashMap_insert(fidx, module.functions.get(fi).name, fi + 1);
        fi = fi + 1;
    }
    fi = 0;
    while fi < nfn {
        var sf: IrFunction = module.functions.get(fi).func;
        var si: i64 = 0;
        while si < sf.insts.len() {
            match sf.insts.get(si).inst {
                Inst::ConstFnRef(nm) => {
                    if !iro_name_in(taken, nm) {
                        taken.push(nm);
                    }
                }
                // a function named by a string is called by name at run time
                // (task_go("f", ..), thread spawns, the runtime's lookups) with
                // the env slot first: its signature must stay
                Inst::ConstStr(cs) => {
                    if HashMap_contains(fidx, cs) && !iro_name_in(taken, cs) {
                        taken.push(cs);
                    }
                }
                Inst::MakeDyn(_, dty, _) => {
                    if !iro_name_in(dtys, dty) {
                        dtys.push(dty);
                    }
                }
                Inst::DynCall(_, dm, _, _, _) => {
                    if !iro_name_in(dmeths, dm) {
                        dmeths.push(dm);
                    }
                }
                _ => {
                }
            }
            si = si + 1;
        }
        fi = fi + 1;
    }
    // A DynCall(trait, m) reaches t_m for every MakeDyn'd t: those callees are
    // not safe candidates either (same rule dead elimination uses).
    var dyn_names: Vec<str> = Vec::new();
    var di: i64 = 0;
    while di < dtys.len() {
        var mi: i64 = 0;
        while mi < dmeths.len() {
            dyn_names.push(dtys.get(di) + "_" + dmeths.get(mi));
            mi = mi + 1;
        }
        di = di + 1;
    }
    var ext_names: Vec<str> = Vec::new();
    di = 0;
    while di < module.extern_functions.len() {
        ext_names.push(module.extern_functions.get(di).name);
        di = di + 1;
    }
    var cands: Vec<i64> = Vec::new();
    // function index + 1
    var npar: Vec<i64> = Vec::new();
    var cvals: Vec<i64> = Vec::new();
    // cand * 8 + j: 0 unseen, -1 varies, v+2 constant
    var bad: Vec<i64> = Vec::new();
    var cidx: i64 = HashMap_new();
    // name -> cand index + 1
    fi = 0;
    while fi < nfn {
        var g: IrFunction = module.functions.get(fi).func;
        var ii: i64 = 0;
        while ii < g.insts.len() {
            match g.insts.get(ii).inst {
                Inst::Call(nm, args, _r, _e) => {
                    var ci: i64 = -1;
                    if HashMap_contains(cidx, nm) {
                        ci = HashMap_get(cidx, nm) - 1;
                    } else {
                        var at: i64 = 0;
                        if HashMap_contains(fidx, nm) {
                            at = HashMap_get(fidx, nm);
                        }
                        if at > 0 && nm != "main" && !iro_name_in(taken, nm) && !iro_name_in(dyn_names, nm) && !iro_name_in(ext_names, nm) && !iro_name_in(module.c_callbacks, nm) && !str_starts_with(nm, "p_") && !str_starts_with(nm, "pe_") && !str_starts_with(nm, "pert_") && !str_starts_with(nm, "nat_") {
                            var np0: i64 = module.functions.get(at - 1).func.params.len();
                            if np0 > 0 && np0 <= 8 {
                                ci = cands.len();
                                cands.push(at);
                                npar.push(np0);
                                var q: i64 = 0;
                                while q < 8 {
                                    cvals.push(0);
                                    q = q + 1;
                                }
                                bad.push(0);
                            }
                        }
                        HashMap_insert(cidx, nm, ci + 1);
                    }
                    if ci >= 0 && bad.get(ci) == 0 {
                        var np: i64 = npar.get(ci);
                        if args.len() != np {
                            bad.set(ci, 1);
                        } else {
                            var aj: i64 = 0;
                            while aj < np {
                                if cvals.get(ci * 8 + aj) >= 0 {
                                    var got: i64 = 0;
                                    var cval: i64 = 0;
                                    // Not peir_inst_of: its None fallback is ConstBool(false),
                                    // which would read every non-inst argument as constant 0.
                                    match IrFunction_get_inst(g, args.get(aj)) {
                                        OptInst::Some(ai) => {
                                            match ai {
                                                Inst::ConstInt(v, _t) => {
                                                    got = 1;
                                                    cval = v;
                                                }
                                                Inst::ConstBool(b) => {
                                                    got = 1;
                                                    if b {
                                                        cval = 1;
                                                    }
                                                }
                                                _ => {
                                                }
                                            }
                                        }
                                        OptInst::None => {
                                        }
                                    }
                                    var old: i64 = cvals.get(ci * 8 + aj);
                                    if got == 0 {
                                        cvals.set(ci * 8 + aj, -1);
                                    } else if old == 0 {
                                        cvals.set(ci * 8 + aj, cval + 2);
                                    } else if old != cval + 2 {
                                        cvals.set(ci * 8 + aj, -1);
                                    }
                                }
                                aj = aj + 1;
                            }
                        }
                    }
                }
                _ => {
                }
            }
            ii = ii + 1;
        }
        fi = fi + 1;
    }
    var ci2: i64 = 0;
    while ci2 < cands.len() {
        if bad.get(ci2) == 0 {
            var ent: IrFunctionEntry = module.functions.get(cands.get(ci2) - 1);
            var f: IrFunction = ent.func;
            var np2: i64 = npar.get(ci2);
            var dirty: bool = false;
            var j2: i64 = 0;
            while j2 < np2 {
                var cv: i64 = cvals.get(ci2 * 8 + j2);
                if cv > 0 {
                    var p: ValueIdType = f.params.get(j2);
                    var v: i64 = cv - 2;
                    var nid: i64 = -1;
                    if ir_type_eq(p.ty, IrType::Bool) {
                        f.current_block_idx = 0;
                        nid = IrFunction_emit(&mut f, Inst::ConstBool(v != 0));
                    } else if iro_int_ty(p.ty) {
                        f.current_block_idx = 0;
                        nid = IrFunction_emit(&mut f, Inst::ConstInt(v, p.ty));
                    }
                    if nid >= 0 {
                        var blk0: BasicBlock = f.blocks.get(0);
                        var ins: Vec<i64> = Vec::new();
                        ins.push(nid);
                        var ki: i64 = 0;
                        while ki < blk0.instructions.len() {
                            var oid: i64 = blk0.instructions.get(ki);
                            if oid != nid {
                                ins.push(oid);
                            }
                            ki = ki + 1;
                        }
                        blk0.instructions = ins;
                        f.blocks.set(0, blk0);
                        var map: Vec<i64> = peir_zeros(f.next_value + 1);
                        map.set(p.id, nid + 1);
                        var vi: i64 = 0;
                        while vi < f.insts.len() {
                            var ve: ValueIdInst = f.insts.get(vi);
                            ve.inst = iro_remap_all(ve.inst, &map);
                            f.insts.set(vi, ve);
                            vi = vi + 1;
                        }
                        count = count + 1;
                        dirty = true;
                    }
                }
                j2 = j2 + 1;
            }
            if dirty {
                ent.func = f;
                module.functions.set(cands.get(ci2) - 1, ent);
            }
        }
        ci2 = ci2 + 1;
    }
    return count;
}

/// WP16: a DynCall whose receiver is a MakeDyn of a known type is a direct
/// call to type_method — the type-id dispatch chain can be skipped.
fn iro_devirt(module: &IrModule, f: &mut IrFunction) -> bool {
    var changed: bool = false;
    var bi: i64 = 0;
    while bi < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(bi);
        var k: i64 = 0;
        while k < blk.instructions.len() {
            var iid: i64 = blk.instructions.get(k);
            match peir_inst_of(f, iid) {
                Inst::DynCall(_trait, method, args, ret, _eff) => {
                    if args.len() > 0 {
                        match peir_inst_of(f, args.get(0)) {
                            Inst::MakeDyn(v, tname, _tn) => {
                                var mname: str = tname + "_" + method;
                                match IrModule_get_function(module, mname) {
                                    OptIrFunction::Some(cf) => {
                                        f.current_block_idx = bi;
                                        var env0: i64 = IrFunction_emit(f, Inst::ConstInt(0, IrType::I64));
                                        var nargs: Vec<i64> = Vec::new();
                                        nargs.push(env0);
                                        nargs.push(v);
                                        var ai: i64 = 1;
                                        while ai < args.len() {
                                            nargs.push(args.get(ai));
                                            ai = ai + 1;
                                        }
                                        IrFunction_set_inst(f, iid, Inst::Call(mname, nargs, ret, cf.effects));
                                        var blk2: BasicBlock = f.blocks.get(bi);
                                        var ins: Vec<i64> = Vec::new();
                                        var ki: i64 = 0;
                                        while ki < blk2.instructions.len() {
                                            var oid: i64 = blk2.instructions.get(ki);
                                            if oid == iid {
                                                ins.push(env0);
                                            }
                                            if oid != env0 {
                                                ins.push(oid);
                                            }
                                            ki = ki + 1;
                                        }
                                        blk2.instructions = ins;
                                        f.blocks.set(bi, blk2);
                                        changed = true;
                                    }
                                    OptIrFunction::None => {
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        bi = bi + 1;
    }
    return changed;
}

/// LG5/LG6: a `CallPtr` through a closure env whose field 0 holds a
/// `ConstFnRef` is a direct call to that function (inlinable next pass, so a
/// `map`/`fold` closure can compile to a plain loop). When the env pointer
/// never escapes — its only uses are the GEP/Store field init, GEP/Load
/// field reads and those `CallPtr`s — its `p_malloc` becomes a stack
/// `Alloca` (no heap for a non-escaping closure). An env stored into memory,
/// returned, or passed to another function keeps its malloc; the `CallPtr`s
/// are still devirtualized.
/// Resolve a CallPtr fp (or a call argument holding a closure env) to
/// the env-building instruction: the value itself, or the unique value
/// every Store parks in the slot a Load reads. -1 when not resolvable.
fn iro_cdev_env_of(f: &IrFunction, fp: i64) -> i64 {
    var lptr: i64 = -1;
    match peir_inst_of(f, fp) {
        Inst::Load(lp, _) => {
            lptr = lp;
        }
        _ => {
            return fp;
        }
    }
    var env_id: i64 = -1;
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            match peir_inst_of(f, ids.get(k)) {
                Inst::Store(sp, sv, _) => {
                    if sp == lptr {
                        if env_id < 0 {
                            env_id = sv;
                        } else {
                            if env_id != sv {
                                env_id = -2;
                            }
                        }
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    if env_id == -2 {
        return -1;
    }
    return env_id;
}

/// The byte size of a Lowerer_make_fn_env env: `p_malloc(ConstInt)`.
/// 0 when `env_id` is not such a call.
fn iro_cdev_env_size(f: &IrFunction, env_id: i64) -> i64 {
    match peir_inst_of(f, env_id) {
        Inst::Call(nm, margs, _, _) => {
            if nm == "p_malloc" && margs.len() > 0 {
                match peir_inst_of(f, margs.get(0)) {
                    Inst::ConstInt(sz, _) => {
                        if sz > 0 && sz % 8 == 0 {
                            return sz;
                        }
                    }
                    _ => {
                    }
                }
            }
        }
        Inst::Alloca(aty, _) => {
            // an env lower.fd already put on the stack (LG6, lw_stack_envs)
            match aty {
                IrType::Array(_, an) => {
                    if an > 0 {
                        return an * 8;
                    }
                }
                _ => {
                }
            }
        }
        Inst::GlobalAddr(gn, _) => {
            // the static env of a function value without captures
            // (lower.fd LOWER_STATIC_FN_ENVS): one word, the function
            if str_starts_with(gn, "__fnenv_") {
                return 8;
            }
        }
        _ => {
        }
    }
    return 0;
}

/// L6C: the ConstFnRef lower.fd stores at word 0 of the env of a C
/// function's address made a function value (`addr as fn(..)`, a typed
/// p_dl_find); word 1 holds the address. No function has this name: such
/// an env is never a closure to call directly.
const IRO_C_FNPTR: str = "__fid_c_fnptr";

/// The ConstFnRef stored at env field 0 (the closure's target), or "".
fn iro_cdev_fname_of(f: &IrFunction, u: &IroUses, env_id: i64) -> str {
    var us: Vec<i64> = u.users.get(env_id);
    var i: i64 = 0;
    while i < us.len() {
        var uid: i64 = us.get(i);
        match peir_inst_of(f, uid) {
            Inst::GetElemPtr(_, gidx, _) => {
                var off: i64 = -1;
                match peir_inst_of(f, gidx) {
                    Inst::ConstInt(ov, _) => {
                        off = ov;
                    }
                    _ => {
                    }
                }
                if off == 0 {
                    var gus: Vec<i64> = u.users.get(uid);
                    var gi: i64 = 0;
                    while gi < gus.len() {
                        match peir_inst_of(f, gus.get(gi)) {
                            Inst::Store(_, sv, _) => {
                                match peir_inst_of(f, sv) {
                                    Inst::ConstFnRef(n) => {
                                        if n == IRO_C_FNPTR {
                                            // a C function's address
                                            // (iro_cdev_scan)
                                            return "";
                                        }
                                        return n;
                                    }
                                    _ => {
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                        gi = gi + 1;
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return "";
}

/// Result of tracing one closure env's uses in a function.
struct CdevEnv {
    pub fname: str,
    pub escape: bool,
    pub msafe: bool,
    pub calls: Vec<i64>,
}

/// Does the devirtualized callee treat its __env parameter (arg 0) as
/// field access only? env passed on as a call arg, stored anywhere, or
/// returned would dangle a stack-allocated env.
fn iro_cdev_callee_ok(cf: &IrFunction) -> bool {
    if cf.params.len() == 0 {
        return false;
    }
    var envp: i64 = cf.params.get(0).id;
    var geps: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < cf.blocks.len() {
        var ids: Vec<i64> = cf.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            match peir_inst_of(cf, ids.get(k)) {
                Inst::GetElemPtr(gb, _, _) => {
                    if gb == envp {
                        geps.push(ids.get(k));
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    b = 0;
    while b < cf.blocks.len() {
        var ids2: Vec<i64> = cf.blocks.get(b).instructions;
        var k2: i64 = 0;
        while k2 < ids2.len() {
            var id2: i64 = ids2.get(k2);
            var ops: Vec<i64> = Vec::new();
            peir_inst_operands(peir_inst_of(cf, id2), &mut ops);
            var o: i64 = 0;
            while o < ops.len() {
                var v: i64 = ops.get(o);
                var bad: bool = false;
                if v == envp {
                    match peir_inst_of(cf, id2) {
                        Inst::GetElemPtr(_, _, _) => {
                        }
                        _ => {
                            bad = true;
                        }
                    }
                }
                if iro_i64_in(geps, v) {
                    match peir_inst_of(cf, id2) {
                        Inst::Load(lp, _) => {
                            if lp != v {
                                bad = true;
                            }
                        }
                        Inst::Store(sp, sv, _) => {
                            if sp != v {
                                bad = true;
                            }
                        }
                        _ => {
                            bad = true;
                        }
                    }
                }
                if bad {
                    return false;
                }
                o = o + 1;
            }
            k2 = k2 + 1;
        }
        b = b + 1;
    }
    return true;
}

/// Follow every use of a closure env (`env_id`, the p_malloc result):
/// GetElemPtr field writes at init, CallPtrs that call it, and Stores
/// that park it in a local slot whose Loads feed CallPtrs. Collects the
/// ConstFnRef stored at field 0 and every reachable CallPtr site.
fn iro_cdev_scan(module: &IrModule, f: &IrFunction, u: &IroUses, env_id: i64) -> CdevEnv {
    var r: CdevEnv = CdevEnv {
        fname: "", escape: false, msafe: true, calls: Vec::new()
    };
    var us: Vec<i64> = u.users.get(env_id);
    var ui: i64 = 0;
    while ui < us.len() {
        var uid: i64 = us.get(ui);
        match peir_inst_of(f, uid) {
            Inst::GetElemPtr(_, gidx, _) => {
                var off: i64 = -1;
                match peir_inst_of(f, gidx) {
                    Inst::ConstInt(ov, _) => {
                        off = ov;
                    }
                    _ => {
                    }
                }
                if off < 0 {
                    r.escape = true;
                }
                var gus: Vec<i64> = u.users.get(uid);
                var gi: i64 = 0;
                while gi < gus.len() {
                    var gid: i64 = gus.get(gi);
                    match peir_inst_of(f, gid) {
                        Inst::Store(_, sv, _) => {
                            if sv == env_id {
                                r.escape = true;
                            }
                            if off == 0 {
                                match peir_inst_of(f, sv) {
                                    Inst::ConstFnRef(n) => {
                                        if r.fname != "" && r.fname != n {
                                            r.escape = true;
                                        }
                                        r.fname = n;
                                        if n == IRO_C_FNPTR {
                                            // L6C: `addr as fn(..)` makes an
                                            // env of this marker and a C
                                            // function's address (word 1):
                                            // not a closure, and no
                                            // function has the name (a
                                            // direct Call of it trapped)
                                            r.fname = "";
                                            r.escape = true;
                                        }
                                    }
                                    _ => {
                                        r.escape = true;
                                    }
                                }
                            }
                        }
                        _ => {
                            r.escape = true;
                        }
                    }
                    gi = gi + 1;
                }
            }
            Inst::Store(sp, sv, _) => {
                // Env parked in a local slot (`var f = fn ..`). The slot
                // must be a plain Alloca, every store to it must park
                // this env, and every load's uses must be CallPtr callees.
                if sv != env_id {
                    r.escape = true;
                }
                var slot_ok: bool = false;
                match peir_inst_of(f, sp) {
                    Inst::Alloca(_, _) => {
                        slot_ok = true;
                    }
                    _ => {
                    }
                }
                if !slot_ok {
                    r.escape = true;
                }
                var lus: Vec<i64> = u.users.get(sp);
                var li: i64 = 0;
                while li < lus.len() {
                    var lid: i64 = lus.get(li);
                    match peir_inst_of(f, lid) {
                        Inst::Store(_, sv2, _) => {
                            if sv2 != env_id {
                                r.escape = true;
                            }
                        }
                        Inst::Load(_, _) => {
                            var cus: Vec<i64> = u.users.get(lid);
                            var cj: i64 = 0;
                            while cj < cus.len() {
                                var cid: i64 = cus.get(cj);
                                match peir_inst_of(f, cid) {
                                    Inst::CallPtr(callee, cargs, _, _, _) => {
                                        if callee == lid {
                                            if !iro_i64_in(r.calls, cid) {
                                                r.calls.push(cid);
                                            }
                                        } else {
                                            r.escape = true;
                                        }
                                        var ci2: i64 = 0;
                                        while ci2 < cargs.len() {
                                            if cargs.get(ci2) == lid {
                                                r.escape = true;
                                            }
                                            ci2 = ci2 + 1;
                                        }
                                    }
                                    _ => {
                                        r.escape = true;
                                    }
                                }
                                cj = cj + 1;
                            }
                        }
                        _ => {
                            r.escape = true;
                        }
                    }
                    li = li + 1;
                }
            }
            Inst::CallPtr(callee, cargs, _, _, _) => {
                if callee == env_id {
                    if !iro_i64_in(r.calls, uid) {
                        r.calls.push(uid);
                    }
                } else {
                    r.escape = true;
                }
                var ci3: i64 = 0;
                while ci3 < cargs.len() {
                    if cargs.get(ci3) == env_id {
                        r.escape = true;
                    }
                    ci3 = ci3 + 1;
                }
            }
            _ => {
                r.escape = true;
            }
        }
        ui = ui + 1;
    }
    if r.calls.len() == 0 || r.fname == "" {
        r.msafe = false;
    }
    if r.fname != "" {
        match IrModule_get_function(module, r.fname) {
            OptIrFunction::Some(cf) => {
                if !iro_cdev_callee_ok(&cf) {
                    r.msafe = false;
                }
            }
            OptIrFunction::None => {
                r.msafe = false;
            }
        }
    }
    return r;
}

/// The arguments of the direct Call a CallPtr through `env` becomes. A
/// CallPtr with a struct or enum result (lower.fd: its result type is a
/// Struct) has in cargs[0] the pointer the callee writes the result to,
/// which goes first, before the env, as for any direct call (codegen_c's
/// sret_call; the arguments were shifted by one: zero or garbage fields).
/// Otherwise the env, then cargs.
fn iro_cp_direct_args(env: i64, cargs: Vec<i64>, cret: IrType) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var ai: i64 = 0;
    var sret: bool = false;
    match cret {
        IrType::Struct(_) => {
            sret = cargs.len() > 0;
        }
        _ => {
        }
    }
    if sret {
        out.push(cargs.get(0));
        ai = 1;
    }
    out.push(env);
    while ai < cargs.len() {
        out.push(cargs.get(ai));
        ai = ai + 1;
    }
    return out;
}

/// LG5/LG6: a CallPtr on a statically known closure env — a p_malloc of
/// N*8 bytes with a ConstFnRef stored at field 0, built by
/// Lowerer_make_fn_env — is an indirect call to a known target. Rewrite
/// it to a direct Call (inlinable downstream) and, when the env provably
/// stays inside this frame, move it from p_malloc to a stack Alloca.
fn iro_closure_devirt(module: &IrModule, f: &mut IrFunction) -> bool {
    // Cheap pre-scan: most functions have no CallPtr at all.
    var any: bool = false;
    var b0: i64 = 0;
    while b0 < f.blocks.len() {
        var ids0: Vec<i64> = f.blocks.get(b0).instructions;
        var k0: i64 = 0;
        while k0 < ids0.len() {
            match peir_inst_of(f, ids0.get(k0)) {
                Inst::CallPtr(_, _, _, _, _) => {
                    any = true;
                }
                _ => {
                }
            }
            k0 = k0 + 1;
        }
        b0 = b0 + 1;
    }
    if !any {
        return false;
    }
    // OP3: read before any change here (cached inside iropt_native's loop)
    var u: IroUses = iro_uses_entry(f);
    var changed: bool = false;
    var stack_envs: Vec<i64> = Vec::new();
    var env_sizes: Vec<i64> = Vec::new();
    var done_envs: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var k: i64 = 0;
        while k < blk.instructions.len() {
            var iid: i64 = blk.instructions.get(k);
            match peir_inst_of(f, iid) {
                Inst::CallPtr(fp, _a0, _r0, _e0, _h0) => {
                    var env_id: i64 = iro_cdev_env_of(f, fp);
                    var env_size: i64 = 0;
                    if env_id >= 0 && !iro_i64_in(done_envs, env_id) {
                        env_size = iro_cdev_env_size(f, env_id);
                    }
                    if env_size > 0 {
                        done_envs.push(env_id);
                        var r: CdevEnv = iro_cdev_scan(module, f, &u, env_id);
                        if r.fname != "" && r.calls.len() > 0 {
                            var n_eff: EffectSet = EffectSet_new();
                            match IrModule_get_function(module, r.fname) {
                                OptIrFunction::Some(cf) => {
                                    n_eff = cf.effects;
                                }
                                OptIrFunction::None => {
                                }
                            }
                            var ri: i64 = 0;
                            while ri < r.calls.len() {
                                var call_id: i64 = r.calls.get(ri);
                                var cblk: i64 = u.block_of.get(call_id);
                                match peir_inst_of(f, call_id) {
                                    Inst::CallPtr(_cfp, cargs, cret, _ceff, chas_env) => {
                                        var nargs: Vec<i64> = Vec::new();
                                        var env_arg: i64 = env_id;
                                        if !chas_env {
                                            f.current_block_idx = cblk;
                                            env_arg = IrFunction_emit(f, Inst::ConstInt(0, IrType::I64));
                                            // Emit appends at block end — move
                                            // the constant before its CallPtr.
                                            var blk3: BasicBlock = f.blocks.get(cblk);
                                            var ins3: Vec<i64> = Vec::new();
                                            var ki3: i64 = 0;
                                            while ki3 < blk3.instructions.len() {
                                                var oid3: i64 = blk3.instructions.get(ki3);
                                                if oid3 == call_id {
                                                    ins3.push(env_arg);
                                                }
                                                if oid3 != env_arg {
                                                    ins3.push(oid3);
                                                }
                                                ki3 = ki3 + 1;
                                            }
                                            blk3.instructions = ins3;
                                            f.blocks.set(cblk, blk3);
                                        }
                                        // (a struct result's pointer first)
                                        nargs = iro_cp_direct_args(env_arg, cargs, cret);
                                        IrFunction_set_inst(f, call_id, Inst::Call(r.fname, nargs, cret, n_eff));
                                        changed = true;
                                    }
                                    _ => {
                                    }
                                }
                                ri = ri + 1;
                            }
                            if !r.escape && r.msafe {
                                stack_envs.push(env_id);
                                env_sizes.push(env_size);
                            }
                        }
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var si: i64 = 0;
    while si < stack_envs.len() {
        var fp2: i64 = stack_envs.get(si);
        IrFunction_set_inst(f, fp2, Inst::Alloca(IrType::Array(Box::new(IrType::I64), env_sizes.get(si) / 8), Region::Stack));
        changed = true;
        si = si + 1;
    }
    return changed;
}

/// LG5 (full): `v.map(fn ..)` hands the closure env to a higher-order
/// function that then CallPtr-dispatches on the env's name string per
/// element. When the caller's env is a locally built, statically known
/// closure, clone the HOF once per (hof, closure target) and rewrite the
/// CallPtr on that parameter to a direct Call — after inlining the clone
/// is the plain loop LG5 wants. The generic HOF stays for callers whose
/// env is not statically known.
pub fn iro_hof_specialize(module: &mut IrModule) -> i64 {
    return iro_hof_specialize_in(module, 0);
}

/// SP3: iro_hof_specialize for the calls in the functions `reach`
/// (iro_mid_reach) holds; `reach` 0: every function. The exclusions are
/// still collected over every function. Name sets are tables, and only a
/// function that calls one with a CallPtr is looked at closely (its use
/// lists built): the same clones and rewrites as a scan of everything,
/// without a list search per call or use lists for every function.
pub fn iro_hof_specialize_in(module: &mut IrModule, reach: i64) -> i64 {
    var count: i64 = 0;
    var fidx: i64 = HashMap_new();
    var nfn: i64 = module.functions.len();
    var fi: i64 = 0;
    while fi < nfn {
        HashMap_insert(fidx, module.functions.get(fi).name, fi + 1);
        fi = fi + 1;
    }
    // Exclusions mirror iro_specialize: never clone runtimes, externs,
    // name-called functions or dyn-trait targets.
    var taken: i64 = HashMap_new();
    var dtys: Vec<str> = Vec::new();
    var dmeths: Vec<str> = Vec::new();
    // SP3: functions with a CallPtr (only those can be specialized here)
    var cp_fns: i64 = HashMap_new();
    fi = 0;
    while fi < nfn {
        var sname: str = module.functions.get(fi).name;
        var sf: IrFunction = module.functions.get(fi).func;
        var si: i64 = 0;
        while si < sf.insts.len() {
            match sf.insts.get(si).inst {
                Inst::ConstFnRef(nm) => {
                    if !HashMap_contains(taken, nm) {
                        HashMap_insert(taken, nm, 1);
                    }
                }
                Inst::ConstStr(cs) => {
                    if HashMap_contains(fidx, cs) && !HashMap_contains(taken, cs) {
                        HashMap_insert(taken, cs, 1);
                    }
                }
                Inst::CallPtr(_, _, _, _, _) => {
                    if !HashMap_contains(cp_fns, sname) {
                        HashMap_insert(cp_fns, sname, 1);
                    }
                }
                Inst::MakeDyn(_, dty, _) => {
                    if !iro_name_in(dtys, dty) {
                        dtys.push(dty);
                    }
                }
                Inst::DynCall(_, dm, _, _, _) => {
                    if !iro_name_in(dmeths, dm) {
                        dmeths.push(dm);
                    }
                }
                _ => {
                }
            }
            si = si + 1;
        }
        fi = fi + 1;
    }
    var dyn_names: i64 = HashMap_new();
    var di: i64 = 0;
    while di < dtys.len() {
        var mi: i64 = 0;
        while mi < dmeths.len() {
            var dn: str = dtys.get(di) + "_" + dmeths.get(mi);
            if !HashMap_contains(dyn_names, dn) {
                HashMap_insert(dyn_names, dn, 1);
            }
            mi = mi + 1;
        }
        di = di + 1;
    }
    var ext_names: i64 = HashMap_new();
    di = 0;
    while di < module.extern_functions.len() {
        var en: str = module.extern_functions.get(di).name;
        if !HashMap_contains(ext_names, en) {
            HashMap_insert(ext_names, en, 1);
        }
        di = di + 1;
    }

    fi = 0;
    while fi < nfn {
        // SP3: only callers main reaches, and only those that call a
        // function with a CallPtr (no other call can be specialized)
        if !iro_in_reach(reach, module.functions.get(fi).name) {
            fi = fi + 1;
            continue;
        }
        var g: IrFunction = module.functions.get(fi).func;
        var g_cand: bool = false;
        var gi0: i64 = 0;
        while gi0 < g.insts.len() && !g_cand {
            match g.insts.get(gi0).inst {
                Inst::Call(hn0, _ha0, _hr0, _he0) => {
                    if HashMap_contains(cp_fns, hn0) {
                        g_cand = true;
                    }
                }
                _ => {
                }
            }
            gi0 = gi0 + 1;
        }
        if !g_cand {
            fi = fi + 1;
            continue;
        }
        var u: IroUses = iro_uses(&g);
        var g_changed: bool = false;
        var bi: i64 = 0;
        while bi < g.blocks.len() {
            var ids: Vec<i64> = g.blocks.get(bi).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                var iid: i64 = ids.get(k);
                match peir_inst_of(&g, iid) {
                    Inst::Call(hof, hargs, hret, heff) => {
                        var hok: bool = HashMap_contains(fidx, hof) && hof != "main" && !HashMap_contains(taken, hof) && !HashMap_contains(dyn_names, hof) && !HashMap_contains(ext_names, hof) && !iro_name_in(module.c_callbacks, hof) && !str_starts_with(hof, "p_") && !str_starts_with(hof, "pe_") && !str_starts_with(hof, "pert_") && !str_starts_with(hof, "nat_");
                        if hok {
                            var cf: IrFunction = module.functions.get(HashMap_get(fidx, hof) - 1).func;
                            if cf.params.len() == hargs.len() && cf.insts.len() <= 200 {
                                // arg positions whose callee param dispatches a CallPtr
                                // (fp may be the param itself or a Load of its slot)
                                var aj: i64 = 0;
                                while aj < cf.params.len() {
                                    var pid: i64 = cf.params.get(aj).id;
                                    var has_callptr: bool = false;
                                    var ci: i64 = 0;
                                    while ci < cf.insts.len() {
                                        match cf.insts.get(ci).inst {
                                            Inst::CallPtr(cfp, _, _, _, _) => {
                                                if cfp == pid {
                                                    has_callptr = true;
                                                }
                                                if iro_cdev_env_of(&cf, cfp) == pid {
                                                    has_callptr = true;
                                                }
                                            }
                                            _ => {
                                            }
                                        }
                                        ci = ci + 1;
                                    }
                                    if has_callptr {
                                        var env_id: i64 = iro_cdev_env_of(&g, hargs.get(aj));
                                        var env_size: i64 = 0;
                                        if env_id >= 0 {
                                            env_size = iro_cdev_env_size(&g, env_id);
                                        }
                                        var fname: str = "";
                                        if env_size > 0 {
                                            fname = iro_cdev_fname_of(&g, &u, env_id);
                                        }
                                        var hdbg: str = p_getenv("FID_HOF_DBG");
                                        if (hdbg as i64) != 0 {
                                            p_eprint_str("hofspec? " + hof + " p" + int_to_str(aj) + " env=" + int_to_str(env_id) + " sz=" + int_to_str(env_size) + " fname=" + fname + "\n");
                                        }
                                        if fname != "" {
                                            var cname: str = hof + "__cdev_" + fname;
                                            if !HashMap_contains(fidx, cname) {
                                                var nf: IrFunction = iro_clone_function(cf, cname);
                                                var n_eff: EffectSet = EffectSet_new();
                                                match IrModule_get_function(module, fname) {
                                                    OptIrFunction::Some(ff) => {
                                                        n_eff = ff.effects;
                                                    }
                                                    OptIrFunction::None => {
                                                    }
                                                }
                                                var ri: i64 = 0;
                                                while ri < nf.insts.len() {
                                                    var vei: ValueIdInst = nf.insts.get(ri);
                                                    match vei.inst {
                                                        Inst::CallPtr(cfp2, cargs2, cret2, _ce2, chas2) => {
                                                            if cfp2 == pid || iro_cdev_env_of(&nf, cfp2) == pid {
                                                                var nargs2: Vec<i64> = Vec::new();
                                                                var env_arg2: i64 = pid;
                                                                if !chas2 {
                                                                    env_arg2 = iro_detached(&mut nf, Inst::ConstInt(0, IrType::I64));
                                                                    // detached inst — place it just before the CallPtr it feeds
                                                                    var cb2: i64 = -1;
                                                                    var bb2: i64 = 0;
                                                                    while bb2 < nf.blocks.len() {
                                                                        if iro_i64_in(nf.blocks.get(bb2).instructions, vei.id) {
                                                                            cb2 = bb2;
                                                                        }
                                                                        bb2 = bb2 + 1;
                                                                    }
                                                                    if cb2 >= 0 {
                                                                        var blk4: BasicBlock = nf.blocks.get(cb2);
                                                                        var ins4: Vec<i64> = Vec::new();
                                                                        var ki4: i64 = 0;
                                                                        while ki4 < blk4.instructions.len() {
                                                                            var oid4: i64 = blk4.instructions.get(ki4);
                                                                            if oid4 == vei.id {
                                                                                ins4.push(env_arg2);
                                                                            }
                                                                            ins4.push(oid4);
                                                                            ki4 = ki4 + 1;
                                                                        }
                                                                        blk4.instructions = ins4;
                                                                        nf.blocks.set(cb2, blk4);
                                                                    }
                                                                }
                                                                // (a struct result's pointer first)
                                                                nargs2 = iro_cp_direct_args(env_arg2, cargs2, cret2);
                                                                IrFunction_set_inst(&mut nf, vei.id, Inst::Call(fname, nargs2, cret2, n_eff));
                                                            }
                                                        }
                                                        _ => {
                                                        }
                                                    }
                                                    ri = ri + 1;
                                                }
                                                module.functions.push(IrFunctionEntry_new(cname, nf));
                                                HashMap_insert(fidx, cname, module.functions.len());
                                                count = count + 1;
                                            }
                                            IrFunction_set_inst(&mut g, iid, Inst::Call(cname, hargs, hret, heff));
                                            g_changed = true;
                                        }
                                    }
                                    aj = aj + 1;
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                k = k + 1;
            }
            bi = bi + 1;
        }
        if g_changed {
            var ent2: IrFunctionEntry = module.functions.get(fi);
            ent2.func = g;
            module.functions.set(fi, ent2);
        }
        fi = fi + 1;
    }
    return count;
}

// --- OP14: dyn receivers that reach a call through a parameter ---------------

/// The MakeDyn (its id) that call argument `a` of `g` is, at position `k`
/// of block index `bi`: `a` itself, or a load of a local only loads and
/// stores reach (`plain`) whose one store, earlier in that block, stores
/// it. -1 when neither. (A MakeDyn's operand then dominates the call.)
fn iro_dspec_make_of(g: &IrFunction, plain: &Vec<i64>, a: i64, bi: i64, k: i64) -> i64 {
    match peir_inst_of(g, a) {
        Inst::MakeDyn(_, _, _) => {
            return a;
        }
        Inst::Load(p, _) => {
            if p < 0 || p >= plain.len() || plain.get(p) != 1 {
                return -1;
            }
            var found: i64 = -1;
            var nst: i64 = 0;
            var b: i64 = 0;
            while b < g.blocks.len() {
                var ids: Vec<i64> = g.blocks.get(b).instructions;
                var j: i64 = 0;
                while j < ids.len() {
                    match peir_inst_of(g, ids.get(j)) {
                        Inst::Store(sp, sv, _) => {
                            if sp == p {
                                nst = nst + 1;
                                if b == bi && j < k {
                                    found = sv;
                                }
                            }
                        }
                        _ => {
                        }
                    }
                    j = j + 1;
                }
                b = b + 1;
            }
            if nst != 1 || found < 0 {
                return -1;
            }
            match peir_inst_of(g, found) {
                Inst::MakeDyn(_, _, _) => {
                    return found;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return -1;
}

/// The type of value `v` of `g` (a parameter's from `g.params`).
fn iro_dspec_ty(g: &IrFunction, v: i64) -> IrType {
    var i: i64 = 0;
    while i < g.params.len() {
        if g.params.get(i).id == v {
            return g.params.get(i).ty;
        }
        i = i + 1;
    }
    match IrFunction_get_meta(g, v) {
        OptValueMeta::Some(m) => {
            return m.ty;
        }
        OptValueMeta::None => {
        }
    }
    return IrType::I64;
}

/// Does `cf` make a DynCall on parameter `pid` (the parameter itself, or
/// a load of the one local it is copied into) that `tname`'s method
/// answers directly? Some(the type that method takes its receiver as).
fn iro_dspec_recv(module: &IrModule, cf: &IrFunction, pid: i64, tname: str) -> OptIrType {
    var i: i64 = 0;
    while i < cf.insts.len() {
        match cf.insts.get(i).inst {
            Inst::DynCall(_, m, dargs, _, _) => {
                if dargs.len() > 0 && iro_cdev_env_of(cf, dargs.get(0)) == pid {
                    match IrModule_get_function(module, tname + "_" + m) {
                        OptIrFunction::Some(mf) => {
                            // (env, self, args...): the direct call
                            // iro_devirt makes passes the value as self
                            if mf.params.len() >= 2 && mf.params.len() == dargs.len() + 1 {
                                return OptIrType::Some(mf.params.get(1).ty);
                            }
                        }
                        OptIrFunction::None => {
                        }
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return OptIrType::None;
}

/// OP14 (Nov 16): a call that passes `x as dyn T` (directly, or through a
/// local stored once just before) to a function that makes trait calls on
/// that parameter calls a clone of the function instead,
/// `callee__dyn<pos>_<T>`, which takes `x` as one more parameter (last):
/// in the clone each of those trait calls is a direct call to `T_method`
/// with `x` as the receiver (what the type dispatch would pick: the dyn
/// object holds T's name and `x`). The dyn value is still passed, for the
/// clone's other uses. Same exclusions as iro_hof_specialize: never a
/// runtime, extern, name-called, address-taken or trait-target function;
/// callees of at most 200 instructions. One clone per (callee, position,
/// T); the original stays for every other caller. FID_IROPT_OFF=dynspec.
pub fn iro_dyn_specialize(module: &mut IrModule) -> i64 {
    var count: i64 = 0;
    var fidx: i64 = HashMap_new();
    var nfn: i64 = module.functions.len();
    var fi: i64 = 0;
    var any_dyn: bool = false;
    var taken: Vec<str> = Vec::new();
    var dtys: Vec<str> = Vec::new();
    var dmeths: Vec<str> = Vec::new();
    while fi < nfn {
        HashMap_insert(fidx, module.functions.get(fi).name, fi + 1);
        var sf: IrFunction = module.functions.get(fi).func;
        var si: i64 = 0;
        while si < sf.insts.len() {
            match sf.insts.get(si).inst {
                Inst::ConstFnRef(nm) => {
                    if !iro_name_in(taken, nm) {
                        taken.push(nm);
                    }
                }
                Inst::ConstStr(cs) => {
                    if !iro_name_in(taken, cs) {
                        taken.push(cs);
                    }
                }
                Inst::MakeDyn(_, dty, _) => {
                    any_dyn = true;
                    if !iro_name_in(dtys, dty) {
                        dtys.push(dty);
                    }
                }
                Inst::DynCall(_, dm, _, _, _) => {
                    if !iro_name_in(dmeths, dm) {
                        dmeths.push(dm);
                    }
                }
                _ => {
                }
            }
            si = si + 1;
        }
        fi = fi + 1;
    }
    if !any_dyn || dmeths.len() == 0 {
        return 0;
    }
    var dyn_names: Vec<str> = Vec::new();
    var di: i64 = 0;
    while di < dtys.len() {
        var mi: i64 = 0;
        while mi < dmeths.len() {
            dyn_names.push(dtys.get(di) + "_" + dmeths.get(mi));
            mi = mi + 1;
        }
        di = di + 1;
    }
    var ext_names: Vec<str> = Vec::new();
    di = 0;
    while di < module.extern_functions.len() {
        ext_names.push(module.extern_functions.get(di).name);
        di = di + 1;
    }
    fi = 0;
    while fi < nfn {
        var g: IrFunction = module.functions.get(fi).func;
        var plain: Vec<i64> = iro_plain_locals(&g);
        var g_changed: bool = false;
        var bi: i64 = 0;
        while bi < g.blocks.len() {
            var ids: Vec<i64> = g.blocks.get(bi).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                var iid: i64 = ids.get(k);
                match peir_inst_of(&g, iid) {
                    Inst::Call(callee, cargs, cret, ceff) => {
                        var cok: bool = HashMap_contains(fidx, callee) && callee != "main" && !iro_name_in(taken, callee) && !iro_name_in(dyn_names, callee) && !iro_name_in(ext_names, callee) && !iro_name_in(module.c_callbacks, callee) && !str_starts_with(callee, "p_") && !str_starts_with(callee, "pe_") && !str_starts_with(callee, "pert_") && !str_starts_with(callee, "nat_") && !str_contains(callee, "__dyn");
                        if cok {
                            var cf: IrFunction = module.functions.get(HashMap_get(fidx, callee) - 1).func;
                            if cf.params.len() == cargs.len() && cf.insts.len() <= 200 && !cf.is_interrupt {
                                var done: bool = false;
                                var aj: i64 = 0;
                                while aj < cargs.len() && !done {
                                    var mk: i64 = iro_dspec_make_of(&g, &plain, cargs.get(aj), bi, k);
                                    if mk >= 0 {
                                        var xv: i64 = -1;
                                        var tname: str = "";
                                        match peir_inst_of(&g, mk) {
                                            Inst::MakeDyn(mv, mt, _) => {
                                                xv = mv;
                                                tname = mt;
                                            }
                                            _ => {
                                            }
                                        }
                                        var pid: i64 = cf.params.get(aj).id;
                                        var xty: IrType = iro_dspec_ty(&g, xv);
                                        var recv_ok: bool = false;
                                        match iro_dspec_recv(module, &cf, pid, tname) {
                                            OptIrType::Some(rty) => {
                                                xty = rty;
                                                recv_ok = true;
                                            }
                                            OptIrType::None => {
                                            }
                                        }
                                        if xv >= 0 && recv_ok {
                                            var cname: str = callee + "__dyn" + int_to_str(aj) + "_" + tname;
                                            if !HashMap_contains(fidx, cname) {
                                                var nf: IrFunction = iro_clone_function(cf, cname);
                                                var np: i64 = IrFunction_new_value(&mut nf, ValueMeta_new(xty));
                                                nf.params.push(ValueIdType_new(np, xty));
                                                var ri: i64 = 0;
                                                while ri < nf.insts.len() {
                                                    var vei: ValueIdInst = nf.insts.get(ri);
                                                    match vei.inst {
                                                        Inst::DynCall(_dt, dm2, dargs2, dret2, _de2) => {
                                                            if dargs2.len() > 0 && iro_cdev_env_of(&nf, dargs2.get(0)) == pid {
                                                                var mname: str = tname + "_" + dm2;
                                                                match IrModule_get_function(module, mname) {
                                                                    OptIrFunction::Some(mf) => {
                                                                        if mf.params.len() == dargs2.len() + 1 {
                                                                            var env2: i64 = iro_detached(&mut nf, Inst::ConstInt(0, IrType::I64));
                                                                            var cb2: i64 = 0;
                                                                            while cb2 < nf.blocks.len() {
                                                                                var blk4: BasicBlock = nf.blocks.get(cb2);
                                                                                if iro_i64_in(blk4.instructions, vei.id) {
                                                                                    var ins4: Vec<i64> = Vec::new();
                                                                                    var ki4: i64 = 0;
                                                                                    while ki4 < blk4.instructions.len() {
                                                                                        var oid4: i64 = blk4.instructions.get(ki4);
                                                                                        if oid4 == vei.id {
                                                                                            ins4.push(env2);
                                                                                        }
                                                                                        ins4.push(oid4);
                                                                                        ki4 = ki4 + 1;
                                                                                    }
                                                                                    blk4.instructions = ins4;
                                                                                    nf.blocks.set(cb2, blk4);
                                                                                }
                                                                                cb2 = cb2 + 1;
                                                                            }
                                                                            var nargs2: Vec<i64> = Vec::new();
                                                                            nargs2.push(env2);
                                                                            nargs2.push(np);
                                                                            var ai2: i64 = 1;
                                                                            while ai2 < dargs2.len() {
                                                                                nargs2.push(dargs2.get(ai2));
                                                                                ai2 = ai2 + 1;
                                                                            }
                                                                            IrFunction_set_inst(&mut nf, vei.id, Inst::Call(mname, nargs2, dret2, mf.effects));
                                                                        }
                                                                    }
                                                                    OptIrFunction::None => {
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        _ => {
                                                        }
                                                    }
                                                    ri = ri + 1;
                                                }
                                                module.functions.push(IrFunctionEntry_new(cname, nf));
                                                HashMap_insert(fidx, cname, module.functions.len());
                                                count = count + 1;
                                            }
                                            var nargs: Vec<i64> = Vec::new();
                                            var ai: i64 = 0;
                                            while ai < cargs.len() {
                                                nargs.push(cargs.get(ai));
                                                ai = ai + 1;
                                            }
                                            nargs.push(xv);
                                            IrFunction_set_inst(&mut g, iid, Inst::Call(cname, nargs, cret, ceff));
                                            g_changed = true;
                                            done = true;
                                        }
                                    }
                                    aj = aj + 1;
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                k = k + 1;
            }
            bi = bi + 1;
        }
        if g_changed {
            var ent2: IrFunctionEntry = module.functions.get(fi);
            ent2.func = g;
            module.functions.set(fi, ent2);
        }
        fi = fi + 1;
    }
    return count;
}

// --- OP14: dyn values and closures that reach a call through a field --------

/// What the stores of each struct field store, over the whole module
/// (iro_field_devirt). `at`: field key ("S#i", iro_fdv_key) -> slot + 1.
/// Per slot: the field index, the dyn type every store stores (`dval`,
/// `dstate` 1) or none known (`dstate` -1; 0: no store seen yet), and the
/// one closure target every store stores (`cval`, `cstate`, likewise).
/// `bad_idx`: field indexes a store or address of no known struct may
/// reach; `bad_structs`: structs a global holds (set up without stores).
struct IroFdv {
    pub at: i64,
    pub kidx: Vec<i64>,
    pub dval: Vec<str>,
    pub dstate: Vec<i64>,
    pub cval: Vec<str>,
    pub cstate: Vec<i64>,
    pub bad_idx: Vec<i64>,
    pub bad_structs: Vec<str>,
}

/// The field a load or store address `p` of `g` names, "S#i" (struct S,
/// field i), when `p` is a GetFieldPtr on a value typed as S or as a
/// pointer to S; "" for any other address.
fn iro_fdv_key(g: &IrFunction, p: i64) -> str {
    match peir_inst_of(g, p) {
        Inst::GetFieldPtr(base, idx, _) => {
            var sn: str = "";
            var bt: IrType = iro_dspec_ty(g, base);
            match bt {
                IrType::Struct(n1) => {
                    sn = n1;
                }
                IrType::Ptr(inner) => {
                    match inner {
                        IrType::Struct(n2) => {
                            sn = n2;
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            if str_len(sn) > 0 {
                return sn + "#" + int_to_str(idx);
            }
        }
        _ => {
        }
    }
    return "";
}

/// A field type a dyn value or a closure may be stored as (they are opaque:
/// `dyn:T`, `func`, `closure`).
fn iro_fdv_fnlike(t: IrType) -> bool {
    match t {
        IrType::Opaque(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// A receiver type the word of a dyn value can be loaded as: what the
/// backends' dispatch passes is that word, in an integer register.
fn iro_fdv_word(t: IrType) -> bool {
    match t {
        IrType::Ptr(_) => {
            return true;
        }
        IrType::I64 => {
            return true;
        }
        IrType::U64 => {
            return true;
        }
        IrType::Opaque(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// For each plain local of `g` (`plain`, iro_plain_locals) stored exactly
/// once: the value that store stores, + 1; 0 (none) or -1 (several) for
/// every other value id.
fn iro_fdv_once(g: &IrFunction, plain: &Vec<i64>) -> Vec<i64> {
    var once: Vec<i64> = peir_zeros(g.next_value + 1);
    var b: i64 = 0;
    while b < g.blocks.len() {
        var ids: Vec<i64> = g.blocks.get(b).instructions;
        var j: i64 = 0;
        while j < ids.len() {
            match peir_inst_of(g, ids.get(j)) {
                Inst::Store(sp, sv, _) => {
                    if sp >= 0 && sp < plain.len() && sp < once.len() && plain.get(sp) == 1 {
                        if once.get(sp) == 0 {
                            once.set(sp, sv + 1);
                        } else {
                            once.set(sp, -1);
                        }
                    }
                }
                _ => {
                }
            }
            j = j + 1;
        }
        b = b + 1;
    }
    return once;
}

/// What value `v` of `g` stands for: when `v` loads a plain local stored
/// exactly once (`once`, iro_fdv_once), the value stored; else `v`.
fn iro_fdv_src(g: &IrFunction, once: &Vec<i64>, v: i64) -> i64 {
    match peir_inst_of(g, v) {
        Inst::Load(p, _) => {
            if p >= 0 && p < once.len() && once.get(p) > 0 {
                return once.get(p) - 1;
            }
        }
        _ => {
        }
    }
    return v;
}

/// The slot of field `key` (index `idx`), made on first sight.
fn iro_fdv_slot(fx: &mut IroFdv, key: str, idx: i64) -> i64 {
    if HashMap_contains(fx.at, key) {
        return HashMap_get(fx.at, key) - 1;
    }
    var st: i64 = 0;
    var bi: i64 = 0;
    while bi < fx.bad_structs.len() {
        if str_starts_with(key, fx.bad_structs.get(bi) + "#") {
            st = -1;
        }
        bi = bi + 1;
    }
    fx.kidx.push(idx);
    fx.dval.push("");
    fx.dstate.push(st);
    fx.cval.push("");
    fx.cstate.push(st);
    HashMap_insert(fx.at, key, fx.kidx.len());
    return fx.kidx.len() - 1;
}

/// One more store of slot `s`: of dyn type / closure target `val` ("" when
/// it stores anything else).
fn iro_fdv_merge(fx: &mut IroFdv, s: i64, closure: bool, val: str) {
    if closure {
        if fx.cstate.get(s) < 0 {
            return;
        }
        if str_len(val) == 0 {
            fx.cstate.set(s, -1);
        } else if fx.cstate.get(s) == 0 {
            fx.cstate.set(s, 1);
            fx.cval.set(s, val);
        } else if fx.cval.get(s) != val {
            fx.cstate.set(s, -1);
        }
        return;
    }
    if fx.dstate.get(s) < 0 {
        return;
    }
    if str_len(val) == 0 {
        fx.dstate.set(s, -1);
    } else if fx.dstate.get(s) == 0 {
        fx.dstate.set(s, 1);
        fx.dval.set(s, val);
    } else if fx.dval.get(s) != val {
        fx.dstate.set(s, -1);
    }
}

/// Field address `p` of `g` is used other than to load from or store to
/// (passed to a call, copied into, `&mut s.f`): what it holds is not known.
fn iro_fdv_lose(fx: &mut IroFdv, g: &IrFunction, p: i64) {
    var key: str = iro_fdv_key(g, p);
    if str_len(key) > 0 {
        var s: i64 = iro_fdv_slot(fx, key, -1);
        fx.dstate.set(s, -1);
        fx.cstate.set(s, -1);
        return;
    }
    match peir_inst_of(g, p) {
        Inst::GetFieldPtr(_, idx, fty) => {
            if iro_fdv_fnlike(fty) && !iro_i64_in(fx.bad_idx, idx) {
                fx.bad_idx.push(idx);
            }
        }
        _ => {
        }
    }
}

/// Add what `g`'s stores to struct fields store to `fx`.
fn iro_fdv_collect(g: &IrFunction, fx: &mut IroFdv) {
    var plain: Vec<i64> = iro_plain_locals(g);
    var once: Vec<i64> = iro_fdv_once(g, &plain);
    var u: IroUses = IroUses {
        count: Vec::new(), users: Vec::new(), block_of: Vec::new(), pos_of: Vec::new()
    };
    var have_u: bool = false;
    var b: i64 = 0;
    while b < g.blocks.len() {
        var ids: Vec<i64> = g.blocks.get(b).instructions;
        var j: i64 = 0;
        while j < ids.len() {
            var inst: Inst = peir_inst_of(g, ids.get(j));
            var ops: Vec<i64> = Vec::new();
            peir_inst_operands(inst, &mut ops);
            var o: i64 = 0;
            while o < ops.len() {
                var v: i64 = ops.get(o);
                var is_gfp: bool = false;
                match peir_inst_of(g, v) {
                    Inst::GetFieldPtr(_, _, _) => {
                        is_gfp = true;
                    }
                    _ => {
                    }
                }
                if is_gfp {
                    var addr_ok: bool = false;
                    match inst {
                        Inst::Load(lp, _) => {
                            addr_ok = lp == v;
                        }
                        Inst::Store(sp0, sv0, _) => {
                            addr_ok = sp0 == v && sv0 != v;
                        }
                        _ => {
                        }
                    }
                    if !addr_ok {
                        iro_fdv_lose(fx, g, v);
                    }
                }
                o = o + 1;
            }
            match inst {
                Inst::Store(sp, sv, _) => {
                    match peir_inst_of(g, sp) {
                        Inst::GetFieldPtr(_, sidx, sfty) => {
                            var key: str = iro_fdv_key(g, sp);
                            var src: i64 = iro_fdv_src(g, &once, sv);
                            var dv: str = "";
                            var cv: str = "";
                            var copy: bool = false;
                            match peir_inst_of(g, src) {
                                Inst::MakeDyn(_, mt, _) => {
                                    dv = mt;
                                }
                                Inst::Load(lq, _) => {
                                    // the same field of another value of
                                    // the struct: what it holds stays
                                    copy = str_len(key) > 0 && iro_fdv_key(g, lq) == key;
                                }
                                _ => {
                                    if iro_cdev_env_size(g, src) > 0 {
                                        if !have_u {
                                            u = iro_uses(g);
                                            have_u = true;
                                        }
                                        cv = iro_cdev_fname_of(g, &u, src);
                                    }
                                }
                            }
                            if str_len(key) == 0 {
                                if str_len(dv) > 0 || str_len(cv) > 0 || iro_fdv_fnlike(sfty) {
                                    if !iro_i64_in(fx.bad_idx, sidx) {
                                        fx.bad_idx.push(sidx);
                                    }
                                }
                            } else if !copy {
                                var s: i64 = iro_fdv_slot(fx, key, sidx);
                                iro_fdv_merge(fx, s, false, dv);
                                iro_fdv_merge(fx, s, true, cv);
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            j = j + 1;
        }
        b = b + 1;
    }
}

/// The slot whose facts value `v` of `g` has when it is (through a local
/// stored once with it) a load of a struct field; -1 when none.
fn iro_fdv_fact(g: &IrFunction, fx: &IroFdv, once: &Vec<i64>, v: i64) -> i64 {
    var src: i64 = iro_fdv_src(g, once, v);
    match peir_inst_of(g, src) {
        Inst::Load(q, _) => {
            var key: str = iro_fdv_key(g, q);
            if str_len(key) > 0 && HashMap_contains(fx.at, key) {
                var s: i64 = HashMap_get(fx.at, key) - 1;
                var idx: i64 = -1;
                match peir_inst_of(g, q) {
                    Inst::GetFieldPtr(_, qi, _) => {
                        idx = qi;
                    }
                    _ => {
                    }
                }
                if idx >= 0 && !iro_i64_in(fx.bad_idx, idx) {
                    return s;
                }
            }
        }
        _ => {
        }
    }
    return -1;
}

/// Put the detached instructions `pre` (in order) just before `at` in
/// block `bi` of `g`.
fn iro_fdv_put_before(g: &mut IrFunction, bi: i64, at: i64, pre: &Vec<i64>) {
    var blk: BasicBlock = g.blocks.get(bi);
    var ins: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < blk.instructions.len() {
        var oid: i64 = blk.instructions.get(k);
        if oid == at {
            var pi: i64 = 0;
            while pi < pre.len() {
                ins.push(pre.get(pi));
                pi = pi + 1;
            }
        }
        ins.push(oid);
        k = k + 1;
    }
    blk.instructions = ins;
    g.blocks.set(bi, blk);
}

/// Make `g`'s trait calls and closure calls on values read from a field
/// with a known type / target (fx) direct calls. `counts` [0] dyn, [1]
/// closure calls made direct.
fn iro_fdv_rewrite(module: &IrModule, g: &mut IrFunction, fx: &IroFdv, counts: &mut Vec<i64>) -> bool {
    var plain: Vec<i64> = iro_plain_locals(g);
    var once: Vec<i64> = iro_fdv_once(g, &plain);
    var changed: bool = false;
    var bi: i64 = 0;
    while bi < g.blocks.len() {
        var ids: Vec<i64> = g.blocks.get(bi).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var iid: i64 = ids.get(k);
            match peir_inst_of(g, iid) {
                Inst::DynCall(_dt, dm, dargs, dret, _de) => {
                    if dargs.len() > 0 {
                        var s: i64 = iro_fdv_fact(g, fx, &once, dargs.get(0));
                        if s >= 0 && fx.dstate.get(s) == 1 {
                            var mname: str = fx.dval.get(s) + "_" + dm;
                            match IrModule_get_function(module, mname) {
                                OptIrFunction::Some(mf) => {
                                    // (env, self, args...), as iro_devirt calls it
                                    if mf.params.len() == dargs.len() + 1 && iro_fdv_word(mf.params.get(1).ty) {
                                        var rty: IrType = mf.params.get(1).ty;
                                        g.current_block_idx = bi;
                                        // the receiver: word 1 of the dyn value
                                        // ({type id, receiver}, MakeDyn)
                                        var c1: i64 = iro_detached(g, Inst::ConstInt(1, IrType::I64));
                                        var at: i64 = iro_detached(g, Inst::GetElemPtr(dargs.get(0), c1, IrType::I64));
                                        var recv: i64 = iro_detached(g, Inst::Load(at, rty));
                                        var env0: i64 = iro_detached(g, Inst::ConstInt(0, IrType::I64));
                                        var pre: Vec<i64> = Vec::new();
                                        pre.push(c1);
                                        pre.push(at);
                                        pre.push(recv);
                                        pre.push(env0);
                                        iro_fdv_put_before(g, bi, iid, &pre);
                                        var nargs: Vec<i64> = Vec::new();
                                        nargs.push(env0);
                                        nargs.push(recv);
                                        var ai: i64 = 1;
                                        while ai < dargs.len() {
                                            nargs.push(dargs.get(ai));
                                            ai = ai + 1;
                                        }
                                        IrFunction_set_inst(g, iid, Inst::Call(mname, nargs, dret, mf.effects));
                                        counts.set(0, counts.get(0) + 1);
                                        changed = true;
                                    }
                                }
                                OptIrFunction::None => {
                                }
                            }
                        }
                    }
                }
                Inst::CallPtr(fp, cargs, cret, _ce, _chas) => {
                    var s2: i64 = iro_fdv_fact(g, fx, &once, fp);
                    if s2 >= 0 && fx.cstate.get(s2) == 1 {
                        var fname: str = fx.cval.get(s2);
                        match IrModule_get_function(module, fname) {
                            OptIrFunction::Some(cf) => {
                                if cf.params.len() == cargs.len() + 1 {
                                    // the env is what the call goes through
                                    // (the backends pass it as argument 0,
                                    // after a struct result's pointer)
                                    var nargs2: Vec<i64> = iro_cp_direct_args(fp, cargs, cret);
                                    IrFunction_set_inst(g, iid, Inst::Call(fname, nargs2, cret, cf.effects));
                                    counts.set(1, counts.get(1) + 1);
                                    changed = true;
                                }
                            }
                            OptIrFunction::None => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        bi = bi + 1;
    }
    return changed;
}

/// OP14 (Nov 17): a trait call or a closure call on a value read from a
/// struct field, where every store of that field in the module stores
/// the same kind of thing. A field all of whose stores store `x as dyn T`
/// (one T) holds a dyn value of type T wherever it is read, so `h.sh.m()`
/// (h a parameter, a Vec element, anything typed as the struct; directly
/// or through a local stored once with the read) is a direct call to
/// `T_m` with the receiver read from the dyn value (its word at +8, what
/// the backends' dispatch passes). A field all of whose stores store a
/// closure of one target F (an env Lowerer_make_fn_env built: a named
/// function or a lambda) makes a call through a read of it a direct call
/// to F with that env. A store that copies the field from the same field
/// of another value keeps the fact; any other store loses it, as does a
/// field address used other than to load or store (passed to a call,
/// `&mut h.sh`), a struct a global holds, and, for the field's index, a
/// dyn or closure store or opaque field address on a pointer of no known
/// struct. `counts` gets the dyn calls ([0]) and closure calls ([1]) made
/// direct; returns their sum. FID_IROPT_OFF=fielddevirt.
pub fn iro_field_devirt(module: &mut IrModule, counts: &mut Vec<i64>) -> i64 {
    while counts.len() < 2 {
        counts.push(0);
    }
    var nfn: i64 = module.functions.len();
    var any_call: bool = false;
    var fi: i64 = 0;
    while fi < nfn && !any_call {
        var sf: IrFunction = module.functions.get(fi).func;
        var si: i64 = 0;
        while si < sf.insts.len() && !any_call {
            match sf.insts.get(si).inst {
                Inst::DynCall(_, _, _, _, _) => {
                    any_call = true;
                }
                Inst::CallPtr(_, _, _, _, _) => {
                    any_call = true;
                }
                _ => {
                }
            }
            si = si + 1;
        }
        fi = fi + 1;
    }
    if !any_call {
        return 0;
    }
    var fx: IroFdv = IroFdv {
        at: HashMap_new(), kidx: Vec::new(), dval: Vec::new(), dstate: Vec::new(), cval: Vec::new(), cstate: Vec::new(), bad_idx: Vec::new(), bad_structs: Vec::new()
    };
    var gi: i64 = 0;
    while gi < module.globals.len() {
        var gty: IrType = module.globals.get(gi).ty;
        match gty {
            IrType::Struct(gsn) => {
                fx.bad_structs.push(gsn);
            }
            _ => {
            }
        }
        gi = gi + 1;
    }
    fi = 0;
    while fi < nfn {
        var g: IrFunction = module.functions.get(fi).func;
        var has_gfp: bool = false;
        var si2: i64 = 0;
        while si2 < g.insts.len() && !has_gfp {
            match g.insts.get(si2).inst {
                Inst::GetFieldPtr(_, _, _) => {
                    has_gfp = true;
                }
                _ => {
                }
            }
            si2 = si2 + 1;
        }
        if has_gfp {
            iro_fdv_collect(&g, &mut fx);
        }
        fi = fi + 1;
    }
    var any_fact: bool = false;
    var ki: i64 = 0;
    while ki < fx.kidx.len() {
        if fx.dstate.get(ki) == 1 || fx.cstate.get(ki) == 1 {
            any_fact = true;
        }
        ki = ki + 1;
    }
    if !any_fact {
        return 0;
    }
    fi = 0;
    while fi < nfn {
        var g2: IrFunction = module.functions.get(fi).func;
        var has_call: bool = false;
        var si3: i64 = 0;
        while si3 < g2.insts.len() && !has_call {
            match g2.insts.get(si3).inst {
                Inst::DynCall(_, _, _, _, _) => {
                    has_call = true;
                }
                Inst::CallPtr(_, _, _, _, _) => {
                    has_call = true;
                }
                _ => {
                }
            }
            si3 = si3 + 1;
        }
        if has_call && iro_fdv_rewrite(module, &mut g2, &fx, counts) {
            var ent: IrFunctionEntry = module.functions.get(fi);
            ent.func = g2;
            module.functions.set(fi, ent);
        }
        fi = fi + 1;
    }
    return counts.get(0) + counts.get(1);
}

/// WP18: a global with a constant initializer whose address is only ever
/// loaded — never stored through and never escaping — has its loads folded
/// to the initializer. cval per global: 0 not an int constant, -1 excluded.
pub fn iro_const_globals(module: &mut IrModule) -> i64 {
    return iro_const_globals_in(module, 0);
}

/// SP3: iro_const_globals folding loads in the functions `reach`
/// (iro_mid_reach) holds only (`reach` 0: every function); which globals
/// are never written is still decided over every function. A function
/// that takes the address of no candidate global costs one scan, no tables.
pub fn iro_const_globals_in(module: &mut IrModule, reach: i64) -> i64 {
    var count: i64 = 0;
    if module.globals.len() == 0 {
        return 0;
    }
    var cval: Vec<i64> = Vec::new();
    var gmap: i64 = HashMap_new();
    var gi: i64 = 0;
    while gi < module.globals.len() {
        var g: GlobalEntry = module.globals.get(gi);
        var v: i64 = 0;
        match g.init {
            Expr::IntLit(iv) => {
                v = iv + 2;
            }
            _ => {
            }
        }
        cval.push(v);
        if v > 0 {
            HashMap_insert(gmap, g.name, gi + 1);
        }
        gi = gi + 1;
    }
    if count < 0 {
        return 0;
    }
    // Two phases: 0 excludes (cval -1) every global whose address is used
    // for anything but a load in ANY function; 1 folds the loads of the
    // rest. (One phase folded a global's loads in one function although
    // another function stored to it: the heap pointer, the runtime's state.)
    var phase: i64 = 0;
    while phase < 2 {
        var fi: i64 = 0;
        while fi < module.functions.len() {
            // SP3: phase 1 only folds, in what main reaches
            if phase == 1 && !iro_in_reach(reach, module.functions.get(fi).name) {
                fi = fi + 1;
                continue;
            }
            var f: IrFunction = module.functions.get(fi).func;
            // SP3: no candidate global's address here: nothing to do
            var any0: bool = false;
            var i0: i64 = 0;
            while i0 < f.insts.len() && !any0 {
                match f.insts.get(i0).inst {
                    Inst::GlobalAddr(gn0, _t0) => {
                        if HashMap_contains(gmap, gn0) && cval.get(HashMap_get(gmap, gn0) - 1) > 0 {
                            any0 = true;
                        }
                    }
                    _ => {
                    }
                }
                i0 = i0 + 1;
            }
            if !any0 {
                fi = fi + 1;
                continue;
            }
            var cand: Vec<i64> = peir_zeros(f.next_value + 1);
            var bad: Vec<i64> = peir_zeros(f.next_value + 1);
            var any: bool = false;
            var ii: i64 = 0;
            while ii < f.insts.len() {
                var ve: ValueIdInst = f.insts.get(ii);
                match ve.inst {
                    Inst::GlobalAddr(gn, _t) => {
                        if HashMap_contains(gmap, gn) {
                            var gat: i64 = HashMap_get(gmap, gn) - 1;
                            if cval.get(gat) > 0 {
                                cand.set(ve.id, gat + 1);
                                any = true;
                            }
                        }
                    }
                    _ => {
                    }
                }
                ii = ii + 1;
            }
            if any {
                // every operand that is a global's address must be a Load's ptr
                var jj: i64 = 0;
                while jj < f.insts.len() {
                    var ve2: ValueIdInst = f.insts.get(jj);
                    var ops: Vec<i64> = Vec::new();
                    peir_inst_operands(ve2.inst, &mut ops);
                    var oi: i64 = 0;
                    while oi < ops.len() {
                        var o: i64 = ops.get(oi);
                        if o >= 0 && o < cand.len() && cand.get(o) > 0 {
                            var isload: bool = false;
                            if oi == 0 {
                                match ve2.inst {
                                    Inst::Load(p, _lt) => {
                                        if p == o {
                                            isload = true;
                                        }
                                    }
                                    _ => {
                                    }
                                }
                            }
                            if !isload {
                                bad.set(o, 1);
                                cval.set(cand.get(o) - 1, 0 - 1);
                            }
                        }
                        oi = oi + 1;
                    }
                    jj = jj + 1;
                }
                // fold the surviving loads
                var kk: i64 = 0;
                if phase == 0 {
                    kk = f.insts.len();
                }
                while kk < f.insts.len() {
                    var ve3: ValueIdInst = f.insts.get(kk);
                    match ve3.inst {
                        Inst::Load(p, lty) => {
                            if p >= 0 && p < cand.len() && cand.get(p) > 0 && bad.get(p) == 0 && iro_int_ty(lty) {
                                var cv2: i64 = cval.get(cand.get(p) - 1) - 2;
                                IrFunction_set_inst(&mut f, ve3.id, Inst::ConstInt(cv2, lty));
                                count = count + 1;
                            }
                        }
                        _ => {
                        }
                    }
                    kk = kk + 1;
                }
                if phase == 1 {
                    var ent2: IrFunctionEntry = module.functions.get(fi);
                    ent2.func = f;
                    module.functions.set(fi, ent2);
                }
            }
            fi = fi + 1;
        }
        phase = phase + 1;
    }
    return count;
}

fn iro_i64_in(v: Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Emit a constant for parameter `p` at the front of the entry block and
/// rewrite its uses — shared by specialization's clones.
fn iro_emit_param_const(f: &mut IrFunction, pid: i64, pty: IrType, v: i64) -> bool {
    var nid: i64 = -1;
    if ir_type_eq(pty, IrType::Bool) {
        f.current_block_idx = 0;
        nid = IrFunction_emit(f, Inst::ConstBool(v != 0));
    } else if iro_int_ty(pty) {
        f.current_block_idx = 0;
        nid = IrFunction_emit(f, Inst::ConstInt(v, pty));
    }
    if nid < 0 {
        return false;
    }
    var blk0: BasicBlock = f.blocks.get(0);
    var ins: Vec<i64> = Vec::new();
    ins.push(nid);
    var ki: i64 = 0;
    while ki < blk0.instructions.len() {
        var oid: i64 = blk0.instructions.get(ki);
        if oid != nid {
            ins.push(oid);
        }
        ki = ki + 1;
    }
    blk0.instructions = ins;
    f.blocks.set(0, blk0);
    var map: Vec<i64> = peir_zeros(f.next_value + 1);
    map.set(pid, nid + 1);
    var vi: i64 = 0;
    while vi < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(vi);
        ve.inst = iro_remap_all(ve.inst, &map);
        f.insts.set(vi, ve);
        vi = vi + 1;
    }
    return true;
}

/// WP14: deep-enough clone for specialization — every Vec the clone may
/// mutate is copied; inst payload Vecs stay shared (they are only replaced
/// whole, never edited in place).
fn iro_clone_function(f: IrFunction, newname: str) -> IrFunction {
    var nf: IrFunction = f;
    nf.name = newname;
    // DB1: the copy's rows take the files of the function copied
    ir_note_fn_clone(f.name, newname);
    nf.params = f.params.clone();
    nf.value_metas = f.value_metas.clone();
    nf.insts = f.insts.clone();
    nf.inst_at = f.inst_at.clone();
    var nbl: Vec<BasicBlock> = Vec::new();
    var bi: i64 = 0;
    while bi < f.blocks.len() {
        var bb: BasicBlock = f.blocks.get(bi);
        bb.instructions = bb.instructions.clone();
        nbl.push(bb);
        bi = bi + 1;
    }
    nf.blocks = nbl;
    nf.locals = f.locals.clone();
    nf.persist_vars = f.persist_vars.clone();
    nf.drop_locals = f.drop_locals.clone();
    nf.zeroize_locals = f.zeroize_locals.clone();
    nf.secret_values = f.secret_values.clone();
    nf.workgroup_size = f.workgroup_size.clone();
    var neff: EffectSet = f.effects;
    neff.effects = f.effects.effects.clone();
    nf.effects = neff;
    return nf;
}

/// WP6: mark every function that may use the internal calling convention.
/// The predicate is the same one env-trim uses for safety: not address-taken,
/// not a dyn trait target, not an extern or C callback, not a runtime
/// stand-in — functions only ever reached through direct Inst::Call sites,
/// which all read the same flag when picking a register count. Runs
/// unconditionally (unlike env trimming): the flag only selects a wider
/// arg-register set in the backend; it changes no signatures.
pub fn iro_conv_mark(module: &mut IrModule) -> i64 {
    var nfn: i64 = module.functions.len();
    var pinned: i64 = iro_conv_pinned(module);
    var count: i64 = 0;
    var fi: i64 = 0;
    while fi < nfn {
        var nm2: str = module.functions.get(fi).name;
        // WP7: nor anything machine code calls by name with the platform
        // convention and a null env (ir.fd ir_dfe_root: the print formatters
        // HashMap_to_str/Vec_to_str, __ helpers, pet_/ped_, ...)
        if iro_conv_free(pinned, nm2, module.functions.get(fi).func.is_interrupt, module.functions.get(fi).func.is_kernel) {
            var ent: IrFunctionEntry = module.functions.get(fi);
            if !ent.func.internal_conv {
                ent.func.internal_conv = true;
                module.functions.set(fi, ent);
                count = count + 1;
            }
        }
        fi = fi + 1;
    }
    HashMap_drop(pinned);
    return count;
}

/// WP6/WP7: the functions that keep the uniform calling convention (the
/// env slot first, the platform's registers) because something other than
/// a direct Inst::Call reaches them: address-taken (ConstFnRef, and a C
/// callback's adapter `__c_fn_f`), named by a string in code or in the
/// module's data (a task or thread entry looked up at run time; ir.fd
/// ir_data_named_fns), a `dyn` method target (`Type_method` of a MakeDyn
/// type and a DynCall method), externs and C callbacks. A table of names;
/// the caller drops it.
fn iro_conv_pinned(module: &IrModule) -> i64 {
    var pinned: i64 = HashMap_new();
    var seen_t: i64 = HashMap_new();
    var seen_m: i64 = HashMap_new();
    var dtys: Vec<str> = Vec::new();
    var dmeths: Vec<str> = Vec::new();
    var nfn: i64 = module.functions.len();
    var fi: i64 = 0;
    while fi < nfn {
        var sf: IrFunction = module.functions.get(fi).func;
        var si: i64 = 0;
        while si < sf.insts.len() {
            match sf.insts.get(si).inst {
                Inst::ConstFnRef(nm) => {
                    HashMap_insert(pinned, nm, 1);
                    // a C callback's reference names its adapter (`__c_fn_f`)
                    HashMap_insert(pinned, c_fn_target(nm), 1);
                }
                // a function named by a string is called by name at run time
                // (task_go("f", ..), thread spawns, the runtime's lookups) with
                // the env slot first: its signature must stay
                Inst::ConstStr(cs) => {
                    if IrModule_fn_pos(module, cs) >= 0 {
                        HashMap_insert(pinned, cs, 1);
                    }
                }
                Inst::MakeDyn(_, dty, _) => {
                    if !HashMap_contains(seen_t, dty) {
                        HashMap_insert(seen_t, dty, 1);
                        dtys.push(dty);
                    }
                }
                Inst::DynCall(_, dm, _, _, _) => {
                    if !HashMap_contains(seen_m, dm) {
                        HashMap_insert(seen_m, dm, 1);
                        dmeths.push(dm);
                    }
                }
                _ => {
                }
            }
            si = si + 1;
        }
        fi = fi + 1;
    }
    var di: i64 = 0;
    while di < dtys.len() {
        var mi: i64 = 0;
        while mi < dmeths.len() {
            HashMap_insert(pinned, dtys.get(di) + "_" + dmeths.get(mi), 1);
            mi = mi + 1;
        }
        di = di + 1;
    }
    di = 0;
    while di < module.extern_functions.len() {
        HashMap_insert(pinned, module.extern_functions.get(di).name, 1);
        di = di + 1;
    }
    di = 0;
    while di < module.c_callbacks.len() {
        HashMap_insert(pinned, module.c_callbacks.get(di), 1);
        di = di + 1;
    }
    var named: Vec<str> = ir_data_named_fns(module);
    di = 0;
    while di < named.len() {
        HashMap_insert(pinned, named.get(di), 1);
        di = di + 1;
    }
    HashMap_drop(seen_t);
    HashMap_drop(seen_m);
    return pinned;
}

/// WP6/WP7: may function `name` leave the uniform convention (internal
/// registers, its env slot dropped)? Not main, nothing iro_conv_pinned
/// holds, nothing machine code or the runtime calls by name (the runtime's
/// and the primitives' prefixes, the pe_runtime_alias stand-ins the
/// backends call with a null env first, ir.fd ir_dfe_root), no interrupt
/// handler or GPU kernel.
fn iro_conv_free(pinned: i64, name: str, is_interrupt: bool, is_kernel: bool) -> bool {
    if name == "main" || name == "main_entry" || HashMap_contains(pinned, name) {
        return false;
    }
    if str_starts_with(name, "p_") || str_starts_with(name, "pe_") || str_starts_with(name, "pert_") || str_starts_with(name, "nat_") {
        return false;
    }
    if pe_runtime_alias_target(name) || ir_dfe_root(name) {
        return false;
    }
    return !is_interrupt && !is_kernel;
}

/// WP7: drop the synthetic __env parameter (params[0]) from functions that
/// never read it, and the matching args[0] at every direct call to them.
/// Address-taken functions (ConstFnRef), trait-impl targets of DynCall,
/// externs, C callbacks and runtime helpers keep the uniform convention —
/// CallPtr always passes an environment.
pub fn iro_env_trim(module: &mut IrModule) -> i64 {
    var count: i64 = 0;
    var nfn: i64 = module.functions.len();
    // WP7 (Nov 17): the exclusions are WP6's (iro_conv_pinned, a table:
    // they were list scans per function), and since Nov 17 they also hold
    // the functions the module's data names and core's vec_buf_alloc
    // (nat_ir's vector loops call it by name with a null env first)
    var pinned: i64 = iro_conv_pinned(module);
    var trim: i64 = HashMap_new();
    var ntrim: i64 = 0;
    var fi: i64 = 0;
    while fi < nfn {
        var g: IrFunction = module.functions.get(fi).func;
        var nm2: str = g.name;
        // The backends call pe_runtime_alias stand-ins with a null env
        // inserted first — their env slot must stay even when unused
        // (iro_conv_free).
        if g.params.len() > 0 && iro_conv_free(pinned, nm2, g.is_interrupt, g.is_kernel) {
            // WP6: every function meeting the internal predicate may use
            // the extended calling convention, whether or not its env
            // parameter can also be trimmed (WP7).
            var ent_i: IrFunctionEntry = module.functions.get(fi);
            ent_i.func.internal_conv = true;
            module.functions.set(fi, ent_i);
            var env_id: i64 = g.params.get(0).id;
            var used: bool = false;
            var ii: i64 = 0;
            while ii < g.insts.len() && !used {
                var ops: Vec<i64> = Vec::new();
                peir_inst_operands(g.insts.get(ii).inst, &mut ops);
                var oi: i64 = 0;
                while oi < ops.len() {
                    if ops.get(oi) == env_id {
                        used = true;
                        oi = ops.len();
                    }
                    oi = oi + 1;
                }
                ii = ii + 1;
            }
            if !used {
                HashMap_insert(trim, nm2, 1);
                ntrim = ntrim + 1;
            }
        }
        fi = fi + 1;
    }
    HashMap_drop(pinned);
    if ntrim == 0 {
        HashMap_drop(trim);
        return 0;
    }
    fi = 0;
    while fi < nfn {
        var ent: IrFunctionEntry = module.functions.get(fi);
        var f2: IrFunction = ent.func;
        var changed: bool = false;
        if HashMap_contains(trim, f2.name) && f2.params.len() > 0 {
            var np2: Vec<ValueIdType> = Vec::new();
            var pj: i64 = 1;
            while pj < f2.params.len() {
                np2.push(f2.params.get(pj));
                pj = pj + 1;
            }
            f2.params = np2;
            changed = true;
        }
        var ii2: i64 = 0;
        while ii2 < f2.insts.len() {
            var ve: ValueIdInst = f2.insts.get(ii2);
            match ve.inst {
                Inst::Call(nm3, args, r, e) => {
                    if HashMap_contains(trim, nm3) && args.len() > 0 {
                        var na: Vec<i64> = Vec::new();
                        var aj: i64 = 1;
                        while aj < args.len() {
                            na.push(args.get(aj));
                            aj = aj + 1;
                        }
                        ve.inst = Inst::Call(nm3, na, r, e);
                        f2.insts.set(ii2, ve);
                        changed = true;
                        count = count + 1;
                    }
                }
                _ => {
                }
            }
            ii2 = ii2 + 1;
        }
        if changed {
            module.functions.set(fi, IrFunctionEntry_new(f2.name, f2));
        }
        fi = fi + 1;
    }
    HashMap_drop(trim);
    return count;
}

/// WP14 hotness: the least weight (iro_call_weights, summed over the call
/// sites passing one constant) that earns a clone: one site in a loop, or
/// eight straight-line sites, or (with a profile) callers run 8 times.
const IRO_SPEC_HOT: i64 = 8;

fn iro_spec_sat(x: i64) -> i64 {
    if x > 1000000000 || x < 0 {
        return 1000000000;
    }
    return x;
}

/// WP14 hotness: how often each call instruction of g runs, estimated:
/// 8 for each loop around its block (3 deep at most), times the calls of g
/// in the profiled run when there is a profile (`--profile-use`, pgo.fd;
/// a function the run never called weighs 0). Indexed by value id; 0 for
/// anything but a call.
fn iro_call_weights(g: &IrFunction) -> Vec<i64> {
    var w: Vec<i64> = peir_zeros(g.next_value + 1);
    var base: i64 = 1;
    if pgo_count("main") > 0 {
        base = pgo_count(g.name);
        if base == 0 {
            return w;
        }
        if base > 1000000 {
            base = 1000000;
        }
    }
    var cfg: IroCfg = iro_cfg(g);
    var lt: IroLoops = iro_loops(&cfg);
    var b: i64 = 0;
    while b < g.blocks.len() {
        var d: i64 = 0;
        if b < lt.depth.len() {
            d = lt.depth.get(b);
        }
        if d > 3 {
            d = 3;
        }
        var bw: i64 = base;
        var k: i64 = 0;
        while k < d {
            bw = iro_spec_sat(bw * 8);
            k = k + 1;
        }
        var ids: Vec<i64> = g.blocks.get(b).instructions;
        var t: i64 = 0;
        while t < ids.len() {
            var id: i64 = ids.get(t);
            if id >= 0 && id < w.len() {
                match peir_inst_of(g, id) {
                    Inst::Call(_, _, _, _) => {
                        w.set(id, bw);
                    }
                    _ => {
                    }
                }
            }
            t = t + 1;
        }
        b = b + 1;
    }
    return w;
}

/// WP14 (Nov 17): the weights (iro_call_weights) of recorded call site `s`
/// and of every other site of the same function: iro_specialize records
/// the sites function by function, so they are the run of `site_f` equal
/// to site_f[s] around s. The function's loops are found once for all of
/// them.
fn iro_spec_site_weights(module: &IrModule, site_f: &Vec<i64>, site_i: &Vec<i64>, site_w: &mut Vec<i64>, s: i64) {
    var f: i64 = site_f.get(s);
    var lo: i64 = s;
    while lo > 0 && site_f.get(lo - 1) == f {
        lo = lo - 1;
    }
    var hi: i64 = s + 1;
    while hi < site_f.len() && site_f.get(hi) == f {
        hi = hi + 1;
    }
    var g: IrFunction = module.functions.get(f).func;
    var wts: Vec<i64> = iro_call_weights(&g);
    var k: i64 = lo;
    while k < hi {
        var w: i64 = 1;
        var at: i64 = site_i.get(k);
        if at >= 0 && at < g.insts.len() {
            var sid: i64 = g.insts.get(at).id;
            if sid >= 0 && sid < wts.len() {
                w = wts.get(sid);
            }
        }
        site_w.set(k, w);
        k = k + 1;
    }
}

/// WP14 hotness: up to `most` of the values, the heaviest first (ties: the
/// first seen), each weighing at least IRO_SPEC_HOT.
fn iro_spec_hottest(vals: Vec<i64>, wts: Vec<i64>, most: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var used: Vec<i64> = peir_zeros(vals.len());
    while out.len() < most {
        var best: i64 = -1;
        var i: i64 = 0;
        while i < vals.len() {
            if used.get(i) == 0 && wts.get(i) >= IRO_SPEC_HOT && (best < 0 || wts.get(i) > wts.get(best)) {
                best = i;
            }
            i = i + 1;
        }
        if best < 0 {
            return out;
        }
        used.set(best, 1);
        out.push(vals.get(best));
    }
    return out;
}

/// WP14: specialize functions on the constant arguments some — not all —
/// call sites pass. Params constant at every site are IPCP's job; here we
/// clone per observed constant value and redirect just those sites, for
/// the values whose call sites are hot (iro_spec_hottest). Only call sites
/// in functions `reach` holds (what main reaches, a table of names) count;
/// every clone made is added to `reach`, so the per-function passes
/// optimize it with its constant.
pub fn iro_specialize(module: &mut IrModule, reach: i64) -> i64 {
    var count: i64 = 0;
    var nfn: i64 = module.functions.len();
    var fidx: i64 = HashMap_new();
    var taken: Vec<str> = Vec::new();
    var dtys: Vec<str> = Vec::new();
    var dmeths: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < nfn {
        HashMap_insert(fidx, module.functions.get(fi).name, fi + 1);
        fi = fi + 1;
    }
    fi = 0;
    while fi < nfn {
        var sf: IrFunction = module.functions.get(fi).func;
        var si: i64 = 0;
        while si < sf.insts.len() {
            match sf.insts.get(si).inst {
                Inst::ConstFnRef(nm) => {
                    if !iro_name_in(taken, nm) {
                        taken.push(nm);
                    }
                }
                // a function named by a string is called by name at run time
                // (task_go("f", ..), thread spawns, the runtime's lookups) with
                // the env slot first: its signature must stay
                Inst::ConstStr(cs) => {
                    if HashMap_contains(fidx, cs) && !iro_name_in(taken, cs) {
                        taken.push(cs);
                    }
                }
                Inst::MakeDyn(_, dty, _) => {
                    if !iro_name_in(dtys, dty) {
                        dtys.push(dty);
                    }
                }
                Inst::DynCall(_, dm, _, _, _) => {
                    if !iro_name_in(dmeths, dm) {
                        dmeths.push(dm);
                    }
                }
                _ => {
                }
            }
            si = si + 1;
        }
        fi = fi + 1;
    }
    var dyn_names: Vec<str> = Vec::new();
    var di: i64 = 0;
    while di < dtys.len() {
        var mi: i64 = 0;
        while mi < dmeths.len() {
            dyn_names.push(dtys.get(di) + "_" + dmeths.get(mi));
            mi = mi + 1;
        }
        di = di + 1;
    }
    var ext_names: Vec<str> = Vec::new();
    di = 0;
    while di < module.extern_functions.len() {
        ext_names.push(module.extern_functions.get(di).name);
        di = di + 1;
    }
    var cands: Vec<i64> = Vec::new();
    var npar: Vec<i64> = Vec::new();
    var mixed: Vec<i64> = Vec::new();
    var cidx: i64 = HashMap_new();
    // WP14 (Nov 17): every call site of a candidate is recorded once
    // (function, instruction index), in module order through site_next
    // from cand_head to cand_tail, with what each argument is (site_ac 1:
    // a constant, site_av its value; 8 slots per site), so weighing and
    // redirecting visit only those sites instead of scanning the module
    // again for every parameter and every clone. site_w: the site's weight
    // (iro_call_weights), -1 until needed; site_moved: sent to a clone.
    var cand_head: Vec<i64> = Vec::new();
    var cand_tail: Vec<i64> = Vec::new();
    var site_f: Vec<i64> = Vec::new();
    var site_i: Vec<i64> = Vec::new();
    var site_next: Vec<i64> = Vec::new();
    var site_w: Vec<i64> = Vec::new();
    var site_moved: Vec<i64> = Vec::new();
    var site_ac: Vec<i64> = Vec::new();
    var site_av: Vec<i64> = Vec::new();
    fi = 0;
    while fi < nfn {
        if !HashMap_contains(reach, module.functions.get(fi).name) {
            fi = fi + 1;
            continue;
        }
        var g: IrFunction = module.functions.get(fi).func;
        var ii: i64 = 0;
        while ii < g.insts.len() {
            match g.insts.get(ii).inst {
                Inst::Call(nm, args, _r, _e) => {
                    var ci: i64 = -1;
                    if HashMap_contains(cidx, nm) {
                        ci = HashMap_get(cidx, nm) - 1;
                    } else {
                        var at: i64 = 0;
                        if HashMap_contains(fidx, nm) {
                            at = HashMap_get(fidx, nm);
                        }
                        if at > 0 && nm != "main" && !iro_name_in(taken, nm) && !iro_name_in(dyn_names, nm) && !iro_name_in(ext_names, nm) && !iro_name_in(module.c_callbacks, nm) && !str_starts_with(nm, "p_") && !str_starts_with(nm, "pe_") && !str_starts_with(nm, "pert_") && !str_starts_with(nm, "nat_") {
                            var cfn: IrFunction = module.functions.get(at - 1).func;
                            var np0: i64 = cfn.params.len();
                            if np0 > 0 && np0 <= 8 && cfn.insts.len() <= 200 {
                                ci = cands.len();
                                cands.push(at);
                                npar.push(np0);
                                cand_head.push(-1);
                                cand_tail.push(-1);
                                var q: i64 = 0;
                                while q < 8 {
                                    mixed.push(0);
                                    q = q + 1;
                                }
                            }
                        }
                        HashMap_insert(cidx, nm, ci + 1);
                    }
                    if ci >= 0 {
                        var np: i64 = npar.get(ci);
                        if args.len() == np {
                            // WP14 (Nov 17): the site, linked to its
                            // candidate's list, with what each argument is
                            var s: i64 = site_f.len();
                            site_f.push(fi);
                            site_i.push(ii);
                            site_next.push(-1);
                            site_w.push(-1);
                            site_moved.push(0);
                            if cand_tail.get(ci) < 0 {
                                cand_head.set(ci, s);
                            } else {
                                site_next.set(cand_tail.get(ci), s);
                            }
                            cand_tail.set(ci, s);
                            var sq: i64 = 0;
                            while sq < 8 {
                                site_ac.push(0);
                                site_av.push(0);
                                sq = sq + 1;
                            }
                            var aj: i64 = 0;
                            while aj < np {
                                var is_c: bool = false;
                                match IrFunction_get_inst(g, args.get(aj)) {
                                    OptInst::Some(ai) => {
                                        match ai {
                                            Inst::ConstInt(cv0, _t) => {
                                                is_c = true;
                                                site_av.set(s * 8 + aj, cv0);
                                            }
                                            Inst::ConstBool(cb0) => {
                                                is_c = true;
                                                if cb0 {
                                                    site_av.set(s * 8 + aj, 1);
                                                }
                                            }
                                            _ => {
                                            }
                                        }
                                    }
                                    OptInst::None => {
                                    }
                                }
                                if is_c {
                                    site_ac.set(s * 8 + aj, 1);
                                }
                                var slot: i64 = ci * 8 + aj;
                                var st: i64 = mixed.get(slot);
                                if is_c {
                                    if st == 0 {
                                        mixed.set(slot, 1);
                                    }
                                    if st == 2 {
                                        mixed.set(slot, 3);
                                    }
                                } else {
                                    if st == 0 {
                                        mixed.set(slot, 2);
                                    }
                                    if st == 1 {
                                        mixed.set(slot, 3);
                                    }
                                }
                                aj = aj + 1;
                            }
                        }
                    }
                }
                _ => {
                }
            }
            ii = ii + 1;
        }
        fi = fi + 1;
    }
    var ci2: i64 = 0;
    while ci2 < cands.len() {
        var at2: i64 = cands.get(ci2);
        var cent: IrFunctionEntry = module.functions.get(at2 - 1);
        var np2: i64 = npar.get(ci2);
        var clones: i64 = 0;
        var j2: i64 = 0;
        while j2 < np2 && clones < 4 {
            if mixed.get(ci2 * 8 + j2) == 3 {
                // WP14 hotness: every constant passed here, weighed by how
                // hot its call sites are (iro_call_weights); the two
                // hottest at or above IRO_SPEC_HOT get clones
                var allv: Vec<i64> = Vec::new();
                var allw: Vec<i64> = Vec::new();
                // the sites still calling the candidate (not yet sent to a
                // clone for an earlier parameter), in module order
                var s2: i64 = cand_head.get(ci2);
                while s2 >= 0 {
                    var bv4: i64 = site_av.get(s2 * 8 + j2);
                    if site_moved.get(s2) == 0 && site_ac.get(s2 * 8 + j2) == 1 && bv4 >= 0 && bv4 < 1000000 {
                        if site_w.get(s2) < 0 {
                            iro_spec_site_weights(module, &site_f, &site_i, &mut site_w, s2);
                        }
                        var sw4: i64 = site_w.get(s2);
                        var at4: i64 = -1;
                        var vq4: i64 = 0;
                        while vq4 < allv.len() {
                            if allv.get(vq4) == bv4 {
                                at4 = vq4;
                            }
                            vq4 = vq4 + 1;
                        }
                        if at4 >= 0 {
                            allw.set(at4, iro_spec_sat(allw.get(at4) + sw4));
                        } else if allv.len() < 32 {
                            allv.push(bv4);
                            allw.push(sw4);
                        }
                    }
                    s2 = site_next.get(s2);
                }
                var bvals: Vec<i64> = iro_spec_hottest(allv, allw, 2);
                var bi2: i64 = 0;
                while bi2 < bvals.len() && clones < 4 {
                    var cv: i64 = bvals.get(bi2);
                    var cname: str = cent.name + "_sc" + int_to_str(j2) + "_" + int_to_str(cv);
                    if !HashMap_contains(fidx, cname) {
                        var nf: IrFunction = iro_clone_function(cent.func, cname);
                        var pj: ValueIdType = nf.params.get(j2);
                        if iro_emit_param_const(&mut nf, pj.id, pj.ty, cv) {
                            module.functions.push(IrFunctionEntry_new(cname, nf));
                            HashMap_insert(reach, cname, 1);
                            clones = clones + 1;
                            count = count + 1;
                            // every recorded site passing cv here calls the
                            // clone (each site's function is rewritten in
                            // place: only that instruction changes)
                            var s3: i64 = cand_head.get(ci2);
                            while s3 >= 0 {
                                if site_moved.get(s3) == 0 && site_ac.get(s3 * 8 + j2) == 1 && site_av.get(s3 * 8 + j2) == cv {
                                    var sf3: i64 = site_f.get(s3);
                                    var si3: i64 = site_i.get(s3);
                                    var g3: IrFunction = module.functions.get(sf3).func;
                                    var ve3: ValueIdInst = g3.insts.get(si3);
                                    match ve3.inst {
                                        Inst::Call(nm5, args5, r5, e5) => {
                                            if nm5 == cent.name && args5.len() == np2 {
                                                ve3.inst = Inst::Call(cname, args5, r5, e5);
                                                g3.insts.set(si3, ve3);
                                                var ent3: IrFunctionEntry = module.functions.get(sf3);
                                                ent3.func = g3;
                                                module.functions.set(sf3, ent3);
                                                site_moved.set(s3, 1);
                                            }
                                        }
                                        _ => {
                                        }
                                    }
                                }
                                s3 = site_next.get(s3);
                            }
                        }
                    }
                    bi2 = bi2 + 1;
                }
            }
            j2 = j2 + 1;
        }
        ci2 = ci2 + 1;
    }
    return count;
}

// --- Effects as a caller sees them (WP9, WP10, WP20) -----------------------
//
// `IrFunction.effects` is what lowering found in the function's own
// instructions, and a call to a program function carries no effects at the
// call site (lowering fills them for runtime builtins only): a function
// that only calls a writer looks pure there, and so does one that calls a
// function that calls a writer. The masks below are what a caller must
// assume instead: the function's own instructions that reach memory outside
// its frame, joined with those of every function it calls, transitively,
// over the whole module (recursion included: a fixpoint). The rules' call
// merging (compiler/rules.fd) and the library-facts file use them.

const IRO_EB_ALLOC: i64 = 1;
const IRO_EB_IO: i64 = 2;
const IRO_EB_NET: i64 = 4;
const IRO_EB_SPAWN: i64 = 8;
const IRO_EB_DIVERGE: i64 = 16;
const IRO_EB_READ: i64 = 32;
const IRO_EB_WRITE: i64 = 64;
const IRO_EB_DIFF: i64 = 128;
const IRO_EB_NOISE: i64 = 256;
const IRO_EB_COMM: i64 = 512;
/// The bit of one effect in an effect mask.
pub fn iro_eff_bit(e: Effect) -> i64 {
    match e {
        Effect::Alloc => {
            return IRO_EB_ALLOC;
        }
        Effect::IO => {
            return IRO_EB_IO;
        }
        Effect::Net => {
            return IRO_EB_NET;
        }
        Effect::Spawn => {
            return IRO_EB_SPAWN;
        }
        Effect::Diverge => {
            return IRO_EB_DIVERGE;
        }
        Effect::Read => {
            return IRO_EB_READ;
        }
        Effect::Write => {
            return IRO_EB_WRITE;
        }
        Effect::Diff => {
            return IRO_EB_DIFF;
        }
        Effect::Noise => {
            return IRO_EB_NOISE;
        }
        Effect::Comm => {
            return IRO_EB_COMM;
        }
    }
    return IRO_EB_WRITE;
}

/// The mask of an effect set.
pub fn iro_eff_mask(s: &EffectSet) -> i64 {
    var m: i64 = 0;
    var i: i64 = 0;
    while i < s.effects.len() {
        m = m | iro_eff_bit(s.effects.get(i));
        i = i + 1;
    }
    return m;
}

/// The effect set of a mask, in the order effect_to_str's names are listed.
pub fn iro_mask_effects(m: i64) -> EffectSet {
    var s: EffectSet = EffectSet_new();
    if (m & IRO_EB_ALLOC) != 0 {
        EffectSet_add(&mut s, Effect::Alloc);
    }
    if (m & IRO_EB_IO) != 0 {
        EffectSet_add(&mut s, Effect::IO);
    }
    if (m & IRO_EB_NET) != 0 {
        EffectSet_add(&mut s, Effect::Net);
    }
    if (m & IRO_EB_SPAWN) != 0 {
        EffectSet_add(&mut s, Effect::Spawn);
    }
    if (m & IRO_EB_DIVERGE) != 0 {
        EffectSet_add(&mut s, Effect::Diverge);
    }
    if (m & IRO_EB_READ) != 0 {
        EffectSet_add(&mut s, Effect::Read);
    }
    if (m & IRO_EB_WRITE) != 0 {
        EffectSet_add(&mut s, Effect::Write);
    }
    if (m & IRO_EB_DIFF) != 0 {
        EffectSet_add(&mut s, Effect::Diff);
    }
    if (m & IRO_EB_NOISE) != 0 {
        EffectSet_add(&mut s, Effect::Noise);
    }
    if (m & IRO_EB_COMM) != 0 {
        EffectSet_add(&mut s, Effect::Comm);
    }
    return s;
}

/// No effects at all: two calls with the same arguments give the same value.
pub fn iro_mask_pure(m: i64) -> bool {
    return m == 0;
}

/// Only reads (EffectSet_is_read_only): the result depends on the arguments
/// and on memory, and changes nothing.
pub fn iro_mask_read_only(m: i64) -> bool {
    return (m | IRO_EB_READ) == IRO_EB_READ;
}

/// Changes no memory another call could read: reads, a panic, or nothing.
/// Such a call between two read-only calls does not stop their merging.
pub fn iro_mask_no_write(m: i64) -> bool {
    return (m | IRO_EB_READ | IRO_EB_DIVERGE) == (IRO_EB_READ | IRO_EB_DIVERGE);
}

/// The memory a value addresses: its id chased back through field and
/// element pointers and casts (an Alloca id for a local's address; the
/// value itself for anything else).
pub fn iro_mem_base(f: &IrFunction, id0: i64) -> i64 {
    var id: i64 = id0;
    var steps: i64 = 0;
    while steps < 16 {
        var next: i64 = -1;
        match peir_inst_of(f, id) {
            Inst::GetFieldPtr(p, _, _) => {
                next = p;
            }
            Inst::GetElemPtr(p, _, _) => {
                next = p;
            }
            Inst::BitCast(p, _, _) => {
                next = p;
            }
            _ => {
            }
        }
        if next < 0 {
            return id;
        }
        id = next;
        steps = steps + 1;
    }
    return id;
}

/// Mark every Alloca that value `v` may hold the address of as escaped:
/// through field and element pointers, casts, width changes and address
/// arithmetic (`p as i64 + 8` stored somewhere still lets the local be
/// reached). Past IRO_ESC_STEPS values every Alloca of `f` is marked.
const IRO_ESC_STEPS: i64 = 256;
fn iro_esc_mark(f: &IrFunction, esc: &mut Vec<i64>, v: i64) {
    var work: Vec<i64> = Vec::new();
    work.push(v);
    var steps: i64 = 0;
    while work.len() > 0 {
        steps = steps + 1;
        if steps > IRO_ESC_STEPS {
            iro_esc_mark_all(f, esc);
            return;
        }
        var x: i64 = work.pop();
        match peir_inst_of(f, x) {
            Inst::Alloca(_, _) => {
                if x >= 0 && x < esc.len() {
                    esc.set(x, 1);
                }
            }
            Inst::GetFieldPtr(p, _, _) => {
                work.push(p);
            }
            Inst::GetElemPtr(p, ix, _) => {
                work.push(p);
                work.push(ix);
            }
            Inst::BitCast(p, _, _) => {
                work.push(p);
            }
            Inst::IntExtend(p, _, _) => {
                work.push(p);
            }
            Inst::IntTrunc(p, _, _) => {
                work.push(p);
            }
            Inst::BinOp(_, a, b, _) => {
                work.push(a);
                work.push(b);
            }
            _ => {
            }
        }
    }
}

fn iro_esc_mark_all(f: &IrFunction, esc: &mut Vec<i64>) {
    var i: i64 = 0;
    while i < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(i);
        match ve.inst {
            Inst::Alloca(_, _) => {
                if ve.id >= 0 && ve.id < esc.len() {
                    esc.set(ve.id, 1);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
}

fn iro_esc_mark_vec(f: &IrFunction, esc: &mut Vec<i64>, vs: Vec<i64>) {
    var i: i64 = 0;
    while i < vs.len() {
        iro_esc_mark(f, esc, vs.get(i));
        i = i + 1;
    }
}

/// The escape set of `f`, per value id (1: escaped): the Allocas whose
/// address leaves the function: call arguments, stored values, struct
/// copies, persisted values, returns. Loads and stores through any other
/// Alloca touch only the function's own frame.
pub fn iro_esc_of(f: &IrFunction) -> Vec<i64> {
    var esc: Vec<i64> = peir_zeros(f.next_value + 1);
    var i: i64 = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Call(_n, args, _r, _e) => {
                iro_esc_mark_vec(f, &mut esc, args);
            }
            Inst::CallPtr(fp, args2, _r2, _e2, _z) => {
                iro_esc_mark(f, &mut esc, fp);
                iro_esc_mark_vec(f, &mut esc, args2);
            }
            Inst::DynCall(_t, _m, args3, _r3, _e3) => {
                iro_esc_mark_vec(f, &mut esc, args3);
            }
            Inst::MakeDyn(dv, _dt, _dn) => {
                iro_esc_mark(f, &mut esc, dv);
            }
            Inst::Store(_p, v, _t) => {
                iro_esc_mark(f, &mut esc, v);
            }
            Inst::StructCopy(d, s, _t2) => {
                iro_esc_mark(f, &mut esc, d);
                iro_esc_mark(f, &mut esc, s);
            }
            Inst::PersistSave(_pn, v2) => {
                iro_esc_mark(f, &mut esc, v2);
            }
            Inst::Return(rv) => {
                match rv {
                    OptValueId::Some(v3) => {
                        iro_esc_mark(f, &mut esc, v3);
                    }
                    OptValueId::None => {
                    }
                }
            }
            // inline assembly may do anything with what it is given
            Inst::Asm(_, _, _, _) => {
                iro_esc_mark_all(f, &mut esc);
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return esc;
}

/// Is `p` an address into a local of `f` that nothing outside it can see?
pub fn iro_local_addr(f: &IrFunction, esc: &Vec<i64>, p: i64) -> bool {
    var b: i64 = iro_mem_base(f, p);
    match peir_inst_of(f, b) {
        Inst::Alloca(_, _) => {
            return b >= 0 && b < esc.len() && esc.get(b) == 0;
        }
        _ => {
        }
    }
    return false;
}

/// The effect mask of a call to `name`, a function the module does not
/// define, with the call site's own effects `site`: a runtime builtin is
/// what lowering said it is (plus a write when that is more than reading);
/// a library function is what its facts file says (WP20); anything else may
/// write.
pub fn iro_absent_call_mask(name: str, site: &EffectSet) -> i64 {
    var m: i64 = iro_eff_mask(site);
    if str_starts_with(name, "p_") {
        if !EffectSet_is_read_only(site) {
            m = m | IRO_EB_WRITE;
        }
        return m;
    }
    var lm: i64 = iro_lib_mask(name);
    if lm >= 0 {
        return m | lm;
    }
    return m | IRO_EB_WRITE;
}

/// The effects of `f`'s own instructions that a caller can see (no callee
/// of `f` counted, except those the module does not define); the module
/// functions it calls directly are added to `callees` (positions).
fn iro_local_ext_mask(module: &IrModule, f: &IrFunction, callees: &mut Vec<i64>) -> i64 {
    var esc: Vec<i64> = iro_esc_of(f);
    var m: i64 = 0;
    var i: i64 = 0;
    while i < f.insts.len() {
        var inst: Inst = f.insts.get(i).inst;
        match inst {
            // a stack slot, and the traffic through one nobody else sees
            Inst::Alloca(_, _) => {
            }
            Inst::Load(p, _t) => {
                if !iro_local_addr(f, &esc, p) {
                    m = m | IRO_EB_READ;
                }
            }
            Inst::Store(p2, _v, _t2) => {
                if !iro_local_addr(f, &esc, p2) {
                    m = m | IRO_EB_WRITE;
                }
            }
            Inst::Call(cn, _args, _r, ce) => {
                var pos: i64 = IrModule_fn_pos(module, cn);
                if pos >= 0 {
                    if iro_site_effects_count(cn) {
                        m = m | iro_eff_mask(&ce);
                    }
                    callees.push(pos);
                } else {
                    m = m | iro_absent_call_mask(cn, &ce);
                }
            }
            Inst::CallPtr(_fp, _pa, _pr, pe, _pz) => {
                m = m | iro_eff_mask(&pe) | IRO_EB_READ | IRO_EB_WRITE;
            }
            Inst::DynCall(_dt, _dm, _da, _dr, de) => {
                m = m | iro_eff_mask(&de) | IRO_EB_READ | IRO_EB_WRITE;
            }
            _ => {
                var ie: EffectSet = inst_effects(&inst);
                m = m | iro_eff_mask(&ie);
            }
        }
        i = i + 1;
    }
    return m;
}

/// What the annotations of `f` promise its callers (WP11, WP12, under the
/// trust model of @wrapping): @crashfree takes away the panic paths,
/// @no-alloc the allocation.
///
/// WP12, decided Nov 15 (llvm-roadmap): "no allocator state is live across
/// a @no-alloc call" is this mask and nothing more. No backend keeps
/// allocator state (a free-list head, a bump pointer) in a register or a
/// cached load across any call: pe_ir and nat_ir call p_malloc/p_free (the
/// per-thread free lists live in memory, H8) and every call is a full
/// clobber of caller-saved registers either way, so there is no saved or
/// reloaded allocator state for the annotation to spare. What it does buy
/// is here: the caller's effect mask loses Alloc, so the passes that read
/// iro_effect_masks (LICM's calls, OP25; merging, egraph/rules) may treat
/// the call as one that allocates nothing. The typechecker enforces the
/// annotation (a @no-alloc function that allocates is rejected,
/// safety-rules.md), so the mask is never wrong for checked code.
fn iro_mask_annotated(f: &IrFunction, m0: i64) -> i64 {
    var m: i64 = m0;
    if f.is_crashfree && (m & IRO_EB_DIVERGE) != 0 {
        m = m - IRO_EB_DIVERGE;
    }
    if f.is_no_alloc && (m & IRO_EB_ALLOC) != 0 {
        m = m - IRO_EB_ALLOC;
    }
    return m;
}

/// The effect mask a caller sees for every function of `module`, by
/// position in `module.functions`: own effects joined with every callee's,
/// transitively. Callees are visited first (post-order over the call
/// graph), so an acyclic program settles in one round and the next round
/// confirms it; recursion takes a round per step around a cycle.
pub fn iro_effect_masks(module: &IrModule) -> Vec<i64> {
    return iro_effect_masks_in(module, 0);
}

/// SP3: every effect bit (the mask of a function the masks were not
/// computed for: a caller must assume anything).
const IRO_EB_ALL: i64 = 1023;

/// SP3: iro_effect_masks for the functions `reach` (iro_mid_reach) holds
/// and their callees, transitively (iro_call_closure): the same masks as
/// over the whole module for those; IRO_EB_ALL for the others, which no
/// function of the set calls. `reach` 0: every function.
pub fn iro_effect_masks_in(module: &IrModule, reach: i64) -> Vec<i64> {
    var n: i64 = module.functions.len();
    var keep: Vec<i64> = iro_call_closure(module, reach);
    var masks: Vec<i64> = Vec::new();
    var callees: Vec<Vec<i64>> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var cs: Vec<i64> = Vec::new();
        if iro_kept_at(&keep, i) {
            var f: IrFunction = module.functions.get(i).func;
            var lm: i64 = iro_local_ext_mask(module, &f, &mut cs);
            masks.push(iro_mask_annotated(&f, lm));
        } else {
            masks.push(IRO_EB_ALL);
        }
        callees.push(cs);
        i = i + 1;
    }
    // post-order: callees first
    var order: Vec<i64> = Vec::new();
    var state: Vec<i64> = peir_zeros(n);
    var root: i64 = 0;
    while root < n {
        if state.get(root) == 0 {
            var st: Vec<i64> = Vec::new();
            var nx: Vec<i64> = Vec::new();
            st.push(root);
            nx.push(0);
            state.set(root, 1);
            while st.len() > 0 {
                var top: i64 = st.len() - 1;
                var cur: i64 = st.get(top);
                var cs2: Vec<i64> = callees.get(cur);
                var at: i64 = nx.get(top);
                if at < cs2.len() {
                    nx.set(top, at + 1);
                    var c: i64 = cs2.get(at);
                    if c >= 0 && c < n && state.get(c) == 0 {
                        state.set(c, 1);
                        st.push(c);
                        nx.push(0);
                    }
                } else {
                    order.push(cur);
                    st.pop();
                    nx.pop();
                }
            }
        }
        root = root + 1;
    }
    var changed: bool = true;
    while changed {
        changed = false;
        var oi: i64 = 0;
        while oi < order.len() {
            var fi: i64 = order.get(oi);
            var m: i64 = masks.get(fi);
            var cs3: Vec<i64> = callees.get(fi);
            var ci: i64 = 0;
            while ci < cs3.len() {
                var c2: i64 = cs3.get(ci);
                if c2 >= 0 && c2 < n {
                    m = m | masks.get(c2);
                }
                ci = ci + 1;
            }
            // SP3: a function left out keeps IRO_EB_ALL
            if iro_kept_at(&keep, fi) {
                var f2: IrFunction = module.functions.get(fi).func;
                m = iro_mask_annotated(&f2, m);
                if m != masks.get(fi) {
                    masks.set(fi, m);
                    changed = true;
                }
            }
            oi = oi + 1;
        }
    }
    return masks;
}

/// The effect mask of a call to `name` with call-site effects `site`, given
/// the module's masks (iro_effect_masks): a module function's transitive
/// mask, or iro_absent_call_mask.
pub fn iro_call_mask(module: &IrModule, masks: &Vec<i64>, name: str, site: &EffectSet) -> i64 {
    var pos: i64 = IrModule_fn_pos(module, name);
    if pos >= 0 && pos < masks.len() {
        if iro_site_effects_count(name) {
            return masks.get(pos) | iro_eff_mask(site);
        }
        return masks.get(pos);
    }
    return iro_absent_call_mask(name, site);
}

// --- OP25: calls that end, never panic, and change nothing ----------------

/// OP25: per function of the module (by position), set by iropt_native when
/// `quietcall` is on: 1 when every call of it is proved to end without a
/// panic (iro_quiet_fns), else 0. Empty: nothing proved.
var g_iro_quiet: Vec<i64> = Vec::new();

/// OP25: may instruction `inst` of `f` sit in a function proved quiet? It
/// cannot panic and does not loop: constants, addresses, the locals' stack
/// traffic (iro_effect_masks says what memory it reaches), moves and integer
/// widening and narrowing, the jumps and the return, comparisons and bit
/// operations, integer arithmetic only in @wrapping code (elsewhere it can
/// overflow), float arithmetic, and calls (to module functions, checked in
/// turn: `callees` gets their positions). Division of integers, shifts,
/// float-to-integer conversion, panics and everything else are not.
/// Comparisons only of words (iro_quiet_word): one of strings reads them.
fn iro_quiet_inst(module: &IrModule, f: &IrFunction, inst: Inst, callees: &mut Vec<i64>) -> bool {
    match inst {
        Inst::ConstInt(_, _) => {
            return true;
        }
        Inst::ConstFloat(_, _) => {
            return true;
        }
        Inst::ConstBool(_) => {
            return true;
        }
        Inst::ConstStr(_) => {
            return true;
        }
        Inst::ConstNull(_) => {
            return true;
        }
        Inst::GlobalAddr(_, _) => {
            return true;
        }
        Inst::Alloca(_, _) => {
            return true;
        }
        Inst::Load(_, _) => {
            return true;
        }
        Inst::Store(_, _, _) => {
            return true;
        }
        Inst::GetFieldPtr(_, _, _) => {
            return true;
        }
        Inst::GetElemPtr(_, _, _) => {
            return true;
        }
        Inst::BitCast(_, _, _) => {
            return true;
        }
        Inst::IntExtend(_, _, _) => {
            return true;
        }
        Inst::IntTrunc(_, _, _) => {
            return true;
        }
        Inst::IntToFloat(_, _, _) => {
            return true;
        }
        Inst::Jump(_) => {
            return true;
        }
        Inst::Branch(_, _, _) => {
            return true;
        }
        Inst::Switch(_, _, _, _) => {
            return true;
        }
        Inst::Return(_) => {
            return true;
        }
        Inst::UnaryOp(uop, _, ut) => {
            match uop {
                UnaryOp::Neg => {
                    return ir_type_is_float(ut) || f.is_wrapping;
                }
                _ => {
                    return true;
                }
            }
        }
        Inst::BinOp(op, ql, qr, t) => {
            // a comparison of two strings compares their bytes (it reads
            // through the pointers): only words compare quietly
            var words: bool = iro_quiet_word(f, ql) && iro_quiet_word(f, qr);
            match op {
                BinOp::Eq => {
                    return words;
                }
                BinOp::Neq => {
                    return words;
                }
                BinOp::Lt => {
                    return words;
                }
                BinOp::LtEq => {
                    return words;
                }
                BinOp::Gt => {
                    return words;
                }
                BinOp::GtEq => {
                    return words;
                }
                BinOp::BitAnd => {
                    return true;
                }
                BinOp::BitOr => {
                    return true;
                }
                BinOp::BitXor => {
                    return true;
                }
                BinOp::Add => {
                    return f.is_wrapping || ir_type_is_float(t);
                }
                BinOp::Sub => {
                    return f.is_wrapping || ir_type_is_float(t);
                }
                BinOp::Mul => {
                    return f.is_wrapping || ir_type_is_float(t);
                }
                BinOp::Div => {
                    return ir_type_is_float(t);
                }
                _ => {
                    return false;
                }
            }
        }
        Inst::Call(cn, _, _, _) => {
            if iro_site_effects_count(cn) {
                return false;
            }
            var pos: i64 = IrModule_fn_pos(module, cn);
            if pos < 0 {
                return false;
            }
            callees.push(pos);
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// OP25: is value `v` of `f` a plain word a comparison only looks at (an
/// integer, a bool or a float), not a pointer, whose comparison may read
/// what it points to (a string's bytes)?
fn iro_quiet_word(f: &IrFunction, v: i64) -> bool {
    var t: IrType = iro_value_ty(f, v);
    return ir_type_is_int(t) || ir_type_is_float(t) || ir_type_eq(t, IrType::Bool);
}

/// OP25: does `f`'s own code end and never panic (callees aside, whose
/// positions go to `callees`)? No loop: every edge between reachable blocks
/// goes forward in reverse postorder (a cycle has an edge that does not),
/// and every instruction of a reachable block passes iro_quiet_inst.
fn iro_quiet_local(module: &IrModule, f: &IrFunction, callees: &mut Vec<i64>) -> bool {
    if f.blocks.len() == 0 {
        return false;
    }
    // the instructions first (every block, reachable or not): most
    // functions fail here, before a CFG is built for them
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            if !iro_quiet_inst(module, f, peir_inst_of(f, ids.get(k)), callees) {
                return false;
            }
            k = k + 1;
        }
        b = b + 1;
    }
    if f.blocks.len() == 1 {
        // one block: a loop would be a jump to itself
        var only: Vec<i64> = f.blocks.get(0).instructions;
        if only.len() > 0 {
            match peir_inst_of(f, only.get(only.len() - 1)) {
                Inst::Return(_) => {
                    return true;
                }
                _ => {
                }
            }
        }
    }
    var cfg: IroCfg = iro_cfg(f);
    b = 0;
    while b < cfg.n {
        var rb: i64 = cfg.rpo_num.get(b);
        if rb >= 0 {
            var ss: Vec<i64> = cfg.succs.get(b);
            var s: i64 = 0;
            while s < ss.len() {
                var t: i64 = ss.get(s);
                if t >= 0 && t < cfg.n && cfg.rpo_num.get(t) >= 0 && cfg.rpo_num.get(t) <= rb {
                    return false;
                }
                s = s + 1;
            }
        }
        b = b + 1;
    }
    return true;
}

/// OP25: per function of `module` (by position), 1 when every call of it
/// ends without a panic: its own code does (iro_quiet_local) and so does
/// every function it calls. A least fixpoint: a function counts only once
/// all its callees do, so recursion is never proved (a call cycle could run
/// for ever, or overflow the stack). What it reads or writes is not asked
/// here: iro_effect_masks says that.
pub fn iro_quiet_fns(module: &IrModule) -> Vec<i64> {
    return iro_quiet_fns_in(module, 0);
}

/// SP3: iro_quiet_fns for the functions `reach` (iro_mid_reach) holds and
/// their callees, transitively (iro_call_closure): the same answer as over
/// the whole module for those, 0 (not proved) for the others, which no
/// function of the set calls. `reach` 0: every function.
pub fn iro_quiet_fns_in(module: &IrModule, reach: i64) -> Vec<i64> {
    var n: i64 = module.functions.len();
    var keep: Vec<i64> = iro_call_closure(module, reach);
    var local: Vec<i64> = peir_zeros(n);
    var callees: Vec<Vec<i64>> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var cs: Vec<i64> = Vec::new();
        if iro_kept_at(&keep, i) {
            var f: IrFunction = module.functions.get(i).func;
            if iro_quiet_local(module, &f, &mut cs) {
                local.set(i, 1);
            }
        }
        callees.push(cs);
        i = i + 1;
    }
    var quiet: Vec<i64> = peir_zeros(n);
    var changed: bool = true;
    while changed {
        changed = false;
        i = 0;
        while i < n {
            if quiet.get(i) == 0 && local.get(i) == 1 {
                var cs2: Vec<i64> = callees.get(i);
                var all: bool = true;
                var c: i64 = 0;
                while c < cs2.len() && all {
                    var p: i64 = cs2.get(c);
                    if p < 0 || p >= n || quiet.get(p) == 0 {
                        all = false;
                    }
                    c = c + 1;
                }
                if all {
                    quiet.set(i, 1);
                    changed = true;
                }
            }
            i = i + 1;
        }
    }
    return quiet;
}

/// How many entries of `xs` are 1.
fn iro_count_ones(xs: &Vec<i64>) -> i64 {
    var c: i64 = 0;
    var i: i64 = 0;
    while i < xs.len() {
        if xs.get(i) == 1 {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

/// OP25: is a call to `name` (call-site effects `site`, result type `ret`)
/// one that ends, never panics and writes nothing (iro_quiet_fns,
/// iro_effect_masks): reading allowed when `may_read`? Program functions
/// only, with a result no owner goes with (an integer, bool, float or
/// nothing).
fn iro_quiet_call(module: &IrModule, masks: &Vec<i64>, name: str, site: &EffectSet, ret: IrType, may_read: bool) -> bool {
    // OP15: cold_path() and @cold calls mark their block cold for the
    // native block layout (nat_ir ng_cold_call_labels): never removed
    if is_cold_fn_hint(name) {
        return false;
    }
    if masks.len() == 0 || g_iro_quiet.len() == 0 || iro_site_effects_count(name) {
        return false;
    }
    if !(ir_type_is_int(ret) || ir_type_is_float(ret) || ir_type_eq(ret, IrType::Bool) || ir_type_eq(ret, IrType::Void)) {
        return false;
    }
    var pos: i64 = IrModule_fn_pos(module, name);
    if pos < 0 || pos >= g_iro_quiet.len() || g_iro_quiet.get(pos) == 0 {
        return false;
    }
    var m: i64 = iro_call_mask(module, masks, name, site);
    if may_read {
        return iro_mask_read_only(m);
    }
    return iro_mask_pure(m);
}

/// OP25: remove the calls of `f` whose result nothing reads, when the call
/// ends, never panics and writes nothing (iro_quiet_call: reads are
/// allowed, nothing can see them). Their arguments are left to `dce`.
fn iro_dead_calls(module: &IrModule, masks: &Vec<i64>, f: &mut IrFunction) -> bool {
    var any: bool = false;
    var round: i64 = 0;
    while round < 3 {
        var uses: Vec<i64> = iro_use_counts(f);
        var removed: bool = false;
        var b: i64 = 0;
        while b < f.blocks.len() {
            var blk: BasicBlock = f.blocks.get(b);
            var keep: Vec<i64> = Vec::new();
            var dropped: bool = false;
            var k: i64 = 0;
            while k < blk.instructions.len() {
                var id: i64 = blk.instructions.get(k);
                var drop: bool = false;
                if id >= 0 && id < uses.len() && uses.get(id) == 0 {
                    match peir_inst_of(f, id) {
                        Inst::Call(cn, _, crt, ce) => {
                            drop = iro_quiet_call(module, masks, cn, &ce, crt, true);
                        }
                        _ => {
                        }
                    }
                }
                if drop {
                    dropped = true;
                } else {
                    keep.push(id);
                }
                k = k + 1;
            }
            if dropped {
                blk.instructions = keep;
                f.blocks.set(b, blk);
                removed = true;
            }
            b = b + 1;
        }
        if !removed {
            return any;
        }
        any = true;
        round = round + 1;
    }
    return any;
}

/// Do a call site's own effects add to what the module's definition of
/// `name` does? For runtime functions, yes: a backend may run its own
/// version of them. For program functions the site holds nothing, or the
/// callee's own `effects` (devirtualized calls), which its transitive mask
/// already covers more precisely (a stack slot is no effect there).
fn iro_site_effects_count(name: str) -> bool {
    return str_starts_with(name, "p_") || str_starts_with(name, "pe_") || str_starts_with(name, "pert_") || str_starts_with(name, "nat_") || str_starts_with(name, "__");
}

// --- WP20: the library-facts file, read back ------------------------------

var g_iro_lib_state: i64 = 0;  // 0 unread, -1 absent or not a facts file, 1 loaded
var g_iro_lib_masks: i64 = 0;  // name -> effect mask + 1
/// The bit of an effect name as effect_to_str writes it; an unknown name
/// counts as a write.
fn iro_eff_name_bit(nm: str) -> i64 {
    if nm == "alloc" {
        return IRO_EB_ALLOC;
    }
    if nm == "io" {
        return IRO_EB_IO;
    }
    if nm == "net" {
        return IRO_EB_NET;
    }
    if nm == "spawn" {
        return IRO_EB_SPAWN;
    }
    if nm == "diverge" {
        return IRO_EB_DIVERGE;
    }
    if nm == "read" {
        return IRO_EB_READ;
    }
    if nm == "write" {
        return IRO_EB_WRITE;
    }
    if nm == "diff" {
        return IRO_EB_DIFF;
    }
    if nm == "noise" {
        return IRO_EB_NOISE;
    }
    if nm == "comm" {
        return IRO_EB_COMM;
    }
    return IRO_EB_WRITE;
}

/// The mask of an `effects=` field: `pure`, or `!` and names joined by
/// commas (EffectSet_to_str, as iro_libfacts writes it).
pub fn iro_parse_effects_field(s: str) -> i64 {
    if s == "pure" {
        return 0;
    }
    var body: str = s;
    if str_starts_with(body, "!") {
        body = str_slice(body, 1, str_len(body));
    }
    if str_len(body) == 0 {
        return IRO_EB_WRITE;
    }
    var m: i64 = 0;
    var pieces: Vec<str> = str_split(body, ",");
    var i: i64 = 0;
    while i < pieces.len() {
        m = m | iro_eff_name_bit(pieces.get(i));
        i = i + 1;
    }
    return m;
}

/// First index of byte `ch` in `s` at or after `from`, or -1.
fn iro_find_byte(s: str, ch: i64, from: i64) -> i64 {
    var i: i64 = from;
    while i < str_len(s) {
        if str_byte_at(s, i) == ch {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/// Read FID_LIBFACTS_IN once: the `fn <name> params=N effects=<..> ..`
/// lines (`ext` lines are the machine layer's, nat_ir.fd
/// ng_libfacts_load). The first line must be the `# fid-facts 1` header;
/// any other file is ignored whole, so a stale or foreign file gives no
/// facts.
fn iro_lib_load() {
    if g_iro_lib_state != 0 {
        return;
    }
    g_iro_lib_state = 0 - 1;
    var path: str = p_getenv("FID_LIBFACTS_IN");
    if (path as i64) == 0 || str_len(path) == 0 {
        return;
    }
    var data: str = "";
    match read_file(path) {
        Option::Some(d) => {
            data = d;
        }
        Option::None => {
            return;
        }
    }
    if !str_starts_with(data, "# fid-facts 1\n") {
        return;
    }
    g_iro_lib_masks = HashMap_new();
    var ls: Vec<str> = str_split(data, "\n");
    var li: i64 = 0;
    while li < ls.len() {
        var line: str = ls.get(li);
        li = li + 1;
        if !str_starts_with(line, "fn ") {
            continue;
        }
        var sp: i64 = iro_find_byte(line, 32, 3);
        var ep: i64 = str_find(line, " effects=");
        if sp < 0 || ep < 0 || ep < sp {
            continue;
        }
        var nm: str = str_slice(line, 3, sp);
        var ee: i64 = ep + 9;
        var eend: i64 = iro_find_byte(line, 32, ee);
        if eend < 0 {
            eend = str_len(line);
        }
        var em: i64 = iro_parse_effects_field(str_slice(line, ee, eend));
        if !HashMap_contains(g_iro_lib_masks, nm) {
            HashMap_insert(g_iro_lib_masks, nm, em + 1);
        }
    }
    g_iro_lib_state = 1;
}

/// The effect mask the facts file gives function `name`, or -1 when there
/// is no file or it does not list `name`.
pub fn iro_lib_mask(name: str) -> i64 {
    iro_lib_load();
    if g_iro_lib_state != 1 {
        return 0 - 1;
    }
    if !HashMap_contains(g_iro_lib_masks, name) {
        return 0 - 1;
    }
    return HashMap_get(g_iro_lib_masks, name) - 1;
}

/// WP20: library-facts artifact: with FID_LIBFACTS=<path>, write one line
/// per optimized function: name, parameter count, the effects its callers
/// must assume (iro_effect_masks: transitive, in EffectSet_to_str's form,
/// which iro_lib_load reads back) and annotation flags, for consumers that
/// build against the library without whole-program mode. The machine layer
/// appends its `ext` lines (clobbers, sizes) to the same file.
pub fn iro_libfacts(module: &IrModule) {
    var path: str = p_getenv("FID_LIBFACTS");
    if (path as i64) == 0 || str_len(path) == 0 {
        return;
    }
    var masks: Vec<i64> = iro_effect_masks(module);
    var out: str = "# fid-facts 1\n";
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var f: IrFunction = module.functions.get(fi).func;
        var fx: EffectSet = iro_mask_effects(masks.get(fi));
        var line: str = "fn " + f.name + " params=" + int_to_str(f.params.len()) + " effects=" + EffectSet_to_str(&fx);
        if f.internal_conv {
            line = line + " conv=internal";
        }
        if f.is_crashfree {
            line = line + " @crashfree";
        }
        if f.is_no_alloc {
            line = line + " @no-alloc";
        }
        if f.is_wrapping {
            line = line + " @wrapping";
        }
        if f.is_deterministic {
            line = line + " @deterministic";
        }
        if f.is_interrupt {
            line = line + " @interrupt";
        }
        if f.is_kernel {
            line = line + " @kernel";
        }
        out = out + line + "\n";
        fi = fi + 1;
    }
    p_file_write(path, out);
}

// --- WP19: identical functions folded ---------------------------------------
//
// Generic instances whose types lower to the same IR (Vec<i64> and Vec<u64>
// helpers, Option<A> and Option<B> with word-sized payloads) and the clones
// of specialization often have the same body. Every direct call to such a
// copy goes to one of them instead (the first in the module); the others
// stay defined for whatever reaches them by address or by name, and the
// native backends, which compile only what main reaches, leave them out
// when nothing else does. "The same" is byte-for-byte equality of the
// serialized function (compiler/ir_ser.fd iw_irfunc: blocks, instructions,
// types, value metadata, effects and every annotation flag), its name left
// out: a function that calls itself names itself and is folded with
// nothing. nat_ir.fd also emits identical machine code once; this works
// before either backend, pe_ir included. Opt-in: FID_IROPT_ON=icf.

/// May direct calls to `f` go to an identical copy, or may `f` be the copy
/// they go to? Not runtime and backend functions, which the backends
/// recognise by name (Vec_*, print, len, *_len, p_*, ..), entry points,
/// C callbacks, interrupt handlers and kernels.
fn iro_icf_candidate(module: &IrModule, f: &IrFunction, at: i64) -> bool {
    var nm: str = f.name;
    if nm == "main" || nm == "main_entry" || nm == "print" || nm == "println" || nm == "len" {
        return false;
    }
    if str_starts_with(nm, "p_") || str_starts_with(nm, "pe_") || str_starts_with(nm, "pet_") || str_starts_with(nm, "ped_") || str_starts_with(nm, "pert_") || str_starts_with(nm, "nat_") || str_starts_with(nm, "__") || str_starts_with(nm, "Vec_") || str_starts_with(nm, "HashMap_") {
        return false;
    }
    if str_ends_with(nm, "_len") || str_ends_with(nm, "_length") || pe_runtime_alias_target(nm) {
        return false;
    }
    if iro_name_in(module.c_callbacks, nm) || f.is_interrupt || f.is_kernel || f.blocks.len() == 0 {
        return false;
    }
    // a call by this name reaches this entry (the first of its name)
    return IrModule_fn_pos(module, nm) == at;
}

/// The serialized IR of `f`; its name is the first 8 + len(name) bytes.
fn iro_icf_bytes(f: IrFunction) -> Vec<i64> {
    var b: AwBuf = awbuf_new();
    iw_irfunc(&mut b, f);
    return b.bytes;
}

/// A hash of `v` from position `from` on.
@wrapping
fn iro_icf_hash(v: &Vec<i64>, from: i64) -> i64 {
    var h: i64 = 17;
    var i: i64 = from;
    while i < v.len() {
        h = h * 31 + v.get(i);
        i = i + 1;
    }
    return h;
}

/// Are `a` from `ao` on and `b` from `bo` on the same bytes?
fn iro_icf_same(a: &Vec<i64>, ao: i64, b: &Vec<i64>, bo: i64) -> bool {
    var n: i64 = a.len() - ao;
    if n != b.len() - bo {
        return false;
    }
    var i: i64 = 0;
    while i < n {
        if a.get(ao + i) != b.get(bo + i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// WP19: send every direct call to a function whose IR is the same as an
/// earlier function's to that earlier one. Returns the functions folded.
/// Only functions that share a cheap signature (instruction, block,
/// parameter and value counts) with another are serialized.
pub fn iro_fold_identical(module: &mut IrModule) -> i64 {
    var n: i64 = module.functions.len();
    var sigs: Vec<str> = Vec::new();
    var counts: i64 = HashMap_new();
    var i: i64 = 0;
    while i < n {
        var f: IrFunction = module.functions.get(i).func;
        var sig: str = "";
        if iro_icf_candidate(module, &f, i) {
            sig = int_to_str(f.insts.len()) + "/" + int_to_str(f.blocks.len()) + "/" + int_to_str(f.params.len()) + "/" + int_to_str(f.next_value);
            HashMap_insert(counts, sig, HashMap_get(counts, sig) + 1);
        }
        sigs.push(sig);
        i = i + 1;
    }
    // per body: "signature#hash" -> group + 1; a group lists the distinct
    // bodies seen under that key (function indexes), the first of each the
    // copy calls go to
    var keys: i64 = HashMap_new();
    var groups: Vec<Vec<i64>> = Vec::new();
    var bytes: Vec<Vec<i64>> = Vec::new();
    var skips: Vec<i64> = peir_zeros(n);
    var target: Vec<i64> = Vec::new();
    var folded: i64 = 0;
    i = 0;
    while i < n {
        var by: Vec<i64> = Vec::new();
        var to: i64 = 0 - 1;
        var sg: str = sigs.get(i);
        if str_len(sg) > 0 && HashMap_get(counts, sg) >= 2 {
            var nm: str = module.functions.get(i).name;
            by = iro_icf_bytes(module.functions.get(i).func);
            var skip: i64 = 8 + str_len(nm);
            skips.set(i, skip);
            var key: str = sg + "#" + int_to_str(iro_icf_hash(&by, skip));
            var slot: i64 = HashMap_get(keys, key) - 1;
            if slot < 0 {
                HashMap_insert(keys, key, groups.len() + 1);
                var g0: Vec<i64> = Vec::new();
                g0.push(i);
                groups.push(g0);
            } else {
                var members: Vec<i64> = groups.get(slot);
                var mi: i64 = 0;
                while mi < members.len() && to < 0 {
                    var j: i64 = members.get(mi);
                    var bj: Vec<i64> = bytes.get(j);
                    if iro_icf_same(&by, skip, &bj, skips.get(j)) {
                        to = j;
                    }
                    mi = mi + 1;
                }
                if to < 0 {
                    members.push(i);
                    groups.set(slot, members);
                }
            }
        }
        if to >= 0 {
            // a folded copy is never compared against again
            folded = folded + 1;
            bytes.push(Vec::new());
        } else {
            bytes.push(by);
        }
        target.push(to);
        i = i + 1;
    }
    if folded == 0 {
        return 0;
    }
    // copy name -> the name calls go to
    var redirect: i64 = HashMap_new();
    var canon: Vec<str> = Vec::new();
    i = 0;
    while i < n {
        if target.get(i) >= 0 {
            HashMap_insert(redirect, module.functions.get(i).name, canon.len() + 1);
            canon.push(module.functions.get(target.get(i)).name);
        }
        i = i + 1;
    }
    var fi: i64 = 0;
    while fi < n {
        var ent: IrFunctionEntry = module.functions.get(fi);
        var f2: IrFunction = ent.func;
        var changed: bool = false;
        var ii: i64 = 0;
        while ii < f2.insts.len() {
            var ve: ValueIdInst = f2.insts.get(ii);
            match ve.inst {
                Inst::Call(cn, args, r, e) => {
                    var t: i64 = HashMap_get(redirect, cn);
                    if t > 0 {
                        ve.inst = Inst::Call(canon.get(t - 1), args, r, e);
                        f2.insts.set(ii, ve);
                        changed = true;
                    }
                }
                _ => {
                }
            }
            ii = ii + 1;
        }
        if changed {
            ent.func = f2;
            module.functions.set(fi, ent);
        }
        fi = fi + 1;
    }
    return folded;
}

// --- Loop versioning (LF11, ME25) ---------------------------------------------
// `while i < n { ... v.get(i) ... i = i + 1 }` with n not v.len(): the bounds
// check stays in every iteration. Versioned, the loop gets a copy entered
// only when, before it, `n > 0` and then `n <= v.len() && i >= 0` hold; in
// the copy the counted-loop proof of checks.fd (peir_counted_loop, its entry
// guard peir_entry_guard) removes the checks on every backend, through the
// same unchecked-ops flags pe_ir, nat_ir and the C generator already read.
// The original loop runs otherwise, checks and all. A loop is versioned only
// when the proof then holds for at least one access of the copy (checked by
// running it): no copy is made for nothing. On by default since Nov 17
// (`version` in iropt_me.fd IME_DEFAULT_ON); FID_IROPT_OFF=version: off.

const IRO_VERSION_MAX: i64 = 120;
/// How many loops the last iro_version call versioned.
var g_iro_nver: i64 = 0;

/// ME25: FID_VERSION_WHY=1 prints why a loop was not versioned (one line
/// per refused requirement): a diagnostic of iro_version_one, never a gate.
/// Any other value prints only functions whose name contains it.
var g_iro_vw_fn: str = "";
var g_iro_vw_show: bool = false;
var g_iro_ver_fn: str = "";

fn iro_version_no(why: str) -> bool {
    var v: str = p_getenv("FID_VERSION_WHY");
    if (v as i64) != 0 && str_len(v) > 0 {
        if !g_iro_vw_show {
            g_iro_vw_show = true;
            g_iro_vw_fn = v;
        }
        var print: bool = true;
        if g_iro_vw_fn != "1" {
            print = str_contains(g_iro_ver_fn, g_iro_vw_fn);
        }
        if print {
            p_eprint_str("version [" + g_iro_ver_fn + "]: " + why + "\n");
        }
    }
    return false;
}

/// `f0` with its qualifying loops versioned (at most four), see above;
/// g_iro_nver says how many. Each try works on a copy of the function: a
/// loop whose copy the proof does not cover leaves `f0` as it was.
fn iro_version(f0: IrFunction) -> IrFunction {
    g_iro_nver = 0;
    g_iro_ver_fn = f0.name;
    var f: IrFunction = f0;
    if f.is_constant_time {
        return f;
    }
    var rounds: i64 = 0;
    var again: bool = true;
    while again && rounds < 4 {
        again = false;
        var cfg: IroCfg = iro_cfg(&f);
        var facts: PeirLoopFacts = peir_loop_facts(&f, f.next_value + 1);
        var h: i64 = 0;
        while h < cfg.n {
            var vf: IrFunction = f;
            if iro_version_one(&mut vf, &cfg, &facts, h) {
                f = vf;
                g_iro_nver = g_iro_nver + 1;
                again = true;
                h = cfg.n;
            }
            h = h + 1;
        }
        rounds = rounds + 1;
    }
    return f;
}

/// Is value `v` of `f` a 64-bit signed integer (parameters included)?
fn iro_version_i64(f: &IrFunction, v: i64) -> bool {
    var i: i64 = 0;
    while i < f.params.len() {
        if f.params.get(i).id == v {
            return ir_type_eq(f.params.get(i).ty, IrType::I64);
        }
        i = i + 1;
    }
    match IrFunction_get_meta(f, v) {
        OptValueMeta::Some(m) => {
            return ir_type_eq(m.ty, IrType::I64);
        }
        OptValueMeta::None => {
        }
    }
    return false;
}

/// The value `id` names in the copy (map: old id -> new id + 1).
fn iro_vm(map: &Vec<i64>, id: i64) -> i64 {
    if id >= 0 && id < map.len() && map.get(id) != 0 {
        return map.get(id) - 1;
    }
    return id;
}

/// Can a loop holding `inst` be copied as it is?
fn iro_version_copyable(inst: Inst) -> bool {
    match inst {
        Inst::Alloca(_, _) => {
            return false;
        }
        Inst::TryUnwrap(_, _, _, _) => {
            return false;
        }
        Inst::Asm(_, _, _, _) => {
            return false;
        }
        Inst::Switch(_, _, _, _) => {
            return false;
        }
        Inst::RegionBegin(_, _, _, _) => {
            return false;
        }
        Inst::RegionEnd(_, _, _) => {
            return false;
        }
        Inst::TxnBegin => {
            return false;
        }
        Inst::TxnEnd => {
            return false;
        }
        Inst::GradBegin(_) => {
            return false;
        }
        Inst::GradEnd => {
            return false;
        }
        Inst::Backward(_) => {
            return false;
        }
        Inst::PersistLoad(_, _, _) => {
            return false;
        }
        Inst::PersistSave(_, _) => {
            return false;
        }
        _ => {
            return true;
        }
    }
}

/// Version the loop headed by block index `h`, if it qualifies.
fn iro_version_one(f: &mut IrFunction, cfg: &IroCfg, facts: &PeirLoopFacts, h: i64) -> bool {
    var n: i64 = cfg.n;
    var latches: Vec<i64> = Vec::new();
    var outside: Vec<i64> = Vec::new();
    var ps: Vec<i64> = cfg.preds.get(h);
    var i: i64 = 0;
    while i < ps.len() {
        if iro_dominates(cfg, h, ps.get(i)) {
            latches.push(ps.get(i));
        } else {
            outside.push(ps.get(i));
        }
        i = i + 1;
    }
    if latches.len() == 0 || outside.len() != 1 {
        if latches.len() == 0 {
            return iro_version_no("no latch");
        }
        return iro_version_no("not one entry from outside");
    }
    var pre: i64 = outside.get(0);
    // the body: blocks that reach a latch without passing the header
    var body: Vec<i64> = peir_zeros(n);
    body.set(h, 1);
    var work: Vec<i64> = latches;
    while work.len() > 0 {
        var b: i64 = work.pop();
        if body.get(b) == 0 {
            body.set(b, 1);
            var bp: Vec<i64> = cfg.preds.get(b);
            i = 0;
            while i < bp.len() {
                work.push(bp.get(i));
                i = i + 1;
            }
        }
    }
    if body.get(pre) != 0 {
        return iro_version_no("preheader in the body");
    }
    // the preheader jumps to the header
    var pids: Vec<i64> = f.blocks.get(pre).instructions;
    if pids.len() == 0 {
        return iro_version_no("empty preheader");
    }
    var pterm: i64 = pids.get(pids.len() - 1);
    var hid: i64 = f.blocks.get(h).id;
    match peir_inst_of(f, pterm) {
        Inst::Jump(t) => {
            if t != hid {
                return iro_version_no("preheader does not jump to the header");
            }
        }
        _ => {
            return iro_version_no("preheader does not end in a jump");
        }
    }
    // the header tests `i < right`
    var hids: Vec<i64> = f.blocks.get(h).instructions;
    if hids.len() == 0 {
        return false;
    }
    var cond: i64 = -1;
    match peir_inst_of(f, hids.get(hids.len() - 1)) {
        Inst::Branch(c, t, e) => {
            if t < 0 || t >= cfg.index.len() || e < 0 || e >= cfg.index.len() {
                return iro_version_no("header branch out of range");
            }
            if cfg.index.get(t) < 0 || cfg.index.get(e) < 0 || body.get(cfg.index.get(t)) == 0 || body.get(cfg.index.get(e)) != 0 {
                return iro_version_no("header branch shape (exit not out of the loop)");
            }
            cond = c;
        }
        _ => {
            return iro_version_no("header does not end in a branch");
        }
    }
    var left: i64 = -1;
    var right: i64 = -1;
    match peir_inst_of(f, cond) {
        Inst::BinOp(op, l, r, _) => {
            match op {
                BinOp::Lt => {
                    left = l;
                    right = r;
                }
                _ => {
                    return iro_version_no("header test not 'i < right'");
                }
            }
        }
        _ => {
            return iro_version_no("header test not a binary operation");
        }
    }
    var islot: i64 = -1;
    match peir_inst_of(f, left) {
        Inst::Load(p, ty) => {
            match ty {
                IrType::I64 => {
                    islot = p;
                }
                _ => {
                    return iro_version_no("counter load not i64");
                }
            }
        }
        _ => {
            return iro_version_no("left of the test not a load");
        }
    }
    if islot < 0 || islot >= facts.plain.len() || facts.plain.get(islot) == 0 {
        return iro_version_no("counter slot not a plain local");
    }
    if peir_is_len(f, right) {
        return iro_version_no("right is a length (the counted-loop proof takes it)");
    }
    // where each value is defined (block index), and the loop's size
    var def_b: Vec<i64> = Vec::new();
    while def_b.len() < f.next_value + 1 {
        def_b.push(-1);
    }
    var size: i64 = 0;
    var b2: i64 = 0;
    while b2 < n {
        var ids: Vec<i64> = f.blocks.get(b2).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            if ids.get(k) >= 0 && ids.get(k) < def_b.len() {
                def_b.set(ids.get(k), b2);
            }
            if body.get(b2) != 0 && k == 0 && f.blocks.get(b2).params.len() > 0 {
                return iro_version_no("a body block has parameters");
            }
            if body.get(b2) != 0 {
                size = size + 1;
                if !iro_version_copyable(peir_inst_of(f, ids.get(k))) {
                    return iro_version_no("a body instruction is not copyable");
                }
            }
            k = k + 1;
        }
        b2 = b2 + 1;
    }
    if size > IRO_VERSION_MAX {
        return iro_version_no("loop larger than IRO_VERSION_MAX");
    }
    // nothing outside the loop reads a value the loop defines
    var ops: Vec<i64> = Vec::new();
    b2 = 0;
    while b2 < n {
        if body.get(b2) == 0 {
            var ids2: Vec<i64> = f.blocks.get(b2).instructions;
            var k2: i64 = 0;
            while k2 < ids2.len() {
                ops.clear();
                peir_inst_operands(peir_inst_of(f, ids2.get(k2)), &mut ops);
                var o: i64 = 0;
                while o < ops.len() {
                    var u: i64 = ops.get(o);
                    if u >= 0 && u < def_b.len() && def_b.get(u) >= 0 && body.get(def_b.get(u)) != 0 {
                        return iro_version_no("a value of the loop is read outside it");
                    }
                    o = o + 1;
                }
                k2 = k2 + 1;
            }
        }
        b2 = b2 + 1;
    }
    // the bound: a value from before the loop, or a reload of a plain slot
    // the loop never stores
    var rslot: i64 = -1;
    var rty: IrType = IrType::I64;
    if right >= 0 && right < def_b.len() && def_b.get(right) >= 0 && body.get(def_b.get(right)) != 0 {
        match peir_inst_of(f, right) {
            Inst::Load(rp, rt) => {
                if rp < 0 || rp >= facts.plain.len() || facts.plain.get(rp) == 0 {
                    return iro_version_no("bound slot not a plain local");
                }
                rslot = rp;
                rty = rt;
            }
            _ => {
                return iro_version_no("bound defined in the loop, not a load");
            }
        }
        var si: i64 = 0;
        while si < facts.st_ptr.len() {
            if facts.st_ptr.get(si) == rslot && body.get(facts.st_block.get(si)) != 0 {
                return iro_version_no("the loop stores the bound's slot");
            }
            si = si + 1;
        }
    }
    // the tests compare words, as the loop does
    if rslot >= 0 {
        if !ir_type_eq(rty, IrType::I64) {
            return iro_version_no("bound slot not i64");
        }
    } else if !iro_version_i64(f, right) {
        return iro_version_no("bound not an i64 value");
    }
    // a Vec access `v.get(i)` / `v.set(i, x)` in the loop: v from before the
    // loop, or a reload of a slot the loop never stores
    var vval: i64 = -1;
    var vslot: i64 = -1;
    var vty: IrType = IrType::I64;
    b2 = 0;
    while b2 < n && vval < 0 && vslot < 0 {
        if body.get(b2) != 0 && b2 != h {
            var ids3: Vec<i64> = f.blocks.get(b2).instructions;
            var k3: i64 = 0;
            while k3 < ids3.len() && vval < 0 && vslot < 0 {
                match peir_inst_of(f, ids3.get(k3)) {
                    Inst::Call(name, args, _, _) => {
                        var at: i64 = -1;
                        if (name == "Vec_get" || name == "p_vec_get") && args.len() >= 2 {
                            at = args.len() - 2;
                        }
                        if (name == "Vec_set" || name == "p_vec_set") && args.len() >= 3 {
                            at = args.len() - 3;
                        }
                        if at >= 0 && peir_load_of(f, args.get(at + 1), islot) {
                            var va: i64 = args.get(at);
                            if va >= 0 && va < def_b.len() && def_b.get(va) >= 0 && body.get(def_b.get(va)) != 0 {
                                match peir_inst_of(f, va) {
                                    Inst::Load(vp, vt) => {
                                        var vok: bool = vp >= 0 && vp < facts.plain.len() && facts.plain.get(vp) != 0;
                                        var si2: i64 = 0;
                                        while si2 < facts.st_ptr.len() {
                                            if facts.st_ptr.get(si2) == vp && body.get(facts.st_block.get(si2)) != 0 {
                                                vok = false;
                                            }
                                            si2 = si2 + 1;
                                        }
                                        if vok {
                                            vslot = vp;
                                            vty = vt;
                                        }
                                    }
                                    _ => {
                                    }
                                }
                            } else {
                                vval = va;
                            }
                        }
                    }
                    _ => {
                    }
                }
                k3 = k3 + 1;
            }
        }
        b2 = b2 + 1;
    }
    if vval < 0 && vslot < 0 {
        return iro_version_no("no Vec access in the loop");
    }
    // --- the copy: new blocks, new values, targets inside the loop renamed
    var max_bid: i64 = 0;
    b2 = 0;
    while b2 < n {
        if f.blocks.get(b2).id > max_bid {
            max_bid = f.blocks.get(b2).id;
        }
        b2 = b2 + 1;
    }
    var bmap: Vec<i64> = peir_zeros(max_bid + 1);
    var copy_of: Vec<i64> = Vec::new();
    // per new block (in order): the old block index
    b2 = 0;
    while b2 < n {
        if body.get(b2) != 0 {
            var nbid: i64 = IrFunction_new_block(f);
            bmap.set(f.blocks.get(b2).id, nbid + 1);
            copy_of.push(b2);
        }
        b2 = b2 + 1;
    }
    f.current_block_idx = pre;
    var vmap: Vec<i64> = peir_zeros(f.next_value + 1);
    // pass 1: a new id for every instruction of the loop
    var ci: i64 = 0;
    while ci < copy_of.len() {
        var oids: Vec<i64> = f.blocks.get(copy_of.get(ci)).instructions;
        var k4: i64 = 0;
        while k4 < oids.len() {
            var oid: i64 = oids.get(k4);
            var nid: i64 = iro_detached(f, peir_inst_of(f, oid));
            while vmap.len() <= oid {
                vmap.push(0);
            }
            vmap.set(oid, nid + 1);
            k4 = k4 + 1;
        }
        ci = ci + 1;
    }
    // pass 2: operands and targets renamed; the source lines copied
    ci = 0;
    while ci < copy_of.len() {
        var ob: BasicBlock = f.blocks.get(copy_of.get(ci));
        var nb_index: i64 = f.blocks.len() - copy_of.len() + ci;
        var nids: Vec<i64> = Vec::new();
        var k5: i64 = 0;
        while k5 < ob.instructions.len() {
            var oid2: i64 = ob.instructions.get(k5);
            var nid2: i64 = iro_vm(&vmap, oid2);
            var ninst: Inst = iro_remap_all(peir_inst_of(f, oid2), &vmap);
            var fin: Inst = ninst;
            match ninst {
                Inst::Jump(jt) => {
                    fin = Inst::Jump(iro_vm(&bmap, jt));
                }
                Inst::Branch(bc, bt, be) => {
                    fin = Inst::Branch(bc, iro_vm(&bmap, bt), iro_vm(&bmap, be));
                }
                _ => {
                }
            }
            IrFunction_set_inst(f, nid2, fin);
            iro_version_line(f, oid2, nid2);
            nids.push(nid2);
            k5 = k5 + 1;
        }
        var nblk: BasicBlock = f.blocks.get(nb_index);
        nblk.instructions = nids;
        f.blocks.set(nb_index, nblk);
        ci = ci + 1;
    }
    var hcopy: i64 = iro_vm(&bmap, hid);
    // --- the tests: in the preheader `n > 0`, then in a block of their own
    // `n <= v.len() && i >= 0` (a null Vec is never measured)
    var gid: i64 = IrFunction_new_block(f);
    var gix: i64 = f.blocks.len() - 1;
    var pre_new: Vec<i64> = Vec::new();
    var pk: i64 = 0;
    while pk + 1 < pids.len() {
        pre_new.push(pids.get(pk));
        pk = pk + 1;
    }
    var n0: i64 = right;
    if rslot >= 0 {
        n0 = iro_detached(f, Inst::Load(rslot, rty));
        pre_new.push(n0);
    }
    var zero0: i64 = iro_detached(f, Inst::ConstInt(0, IrType::I64));
    pre_new.push(zero0);
    var pos: i64 = iro_detached(f, Inst::BinOp(BinOp::Gt, n0, zero0, IrType::Bool));
    pre_new.push(pos);
    IrFunction_set_inst(f, pterm, Inst::Branch(pos, gid, hid));
    pre_new.push(pterm);
    var pblk: BasicBlock = f.blocks.get(pre);
    pblk.instructions = pre_new;
    f.blocks.set(pre, pblk);
    var g_new: Vec<i64> = Vec::new();
    var vl: i64 = vval;
    if vslot >= 0 {
        vl = iro_detached(f, Inst::Load(vslot, vty));
        g_new.push(vl);
    }
    var env0: i64 = iro_detached(f, Inst::ConstInt(0, IrType::I64));
    g_new.push(env0);
    var largs: Vec<i64> = Vec::new();
    largs.push(env0);
    largs.push(vl);
    var leff: EffectSet = EffectSet_new();
    EffectSet_add(&mut leff, Effect::Read);
    var lcall: i64 = iro_detached(f, Inst::Call("Vec_len", largs, IrType::I64, leff));
    g_new.push(lcall);
    var n1: i64 = right;
    if rslot >= 0 {
        n1 = iro_detached(f, Inst::Load(rslot, rty));
        g_new.push(n1);
    }
    var c1: i64 = iro_detached(f, Inst::BinOp(BinOp::LtEq, n1, lcall, IrType::Bool));
    g_new.push(c1);
    var il: i64 = iro_detached(f, Inst::Load(islot, IrType::I64));
    g_new.push(il);
    var zero1: i64 = iro_detached(f, Inst::ConstInt(0, IrType::I64));
    g_new.push(zero1);
    var c2: i64 = iro_detached(f, Inst::BinOp(BinOp::GtEq, il, zero1, IrType::Bool));
    g_new.push(c2);
    var both: i64 = iro_detached(f, Inst::BinOp(BinOp::And, c1, c2, IrType::Bool));
    g_new.push(both);
    var gbr: i64 = iro_detached(f, Inst::Branch(both, hcopy, hid));
    g_new.push(gbr);
    var gblk: BasicBlock = f.blocks.get(gix);
    gblk.instructions = g_new;
    f.blocks.set(gix, gblk);
    // the proof must hold in the copy, or nothing was won
    var nv2: i64 = f.value_metas.len() + f.insts.len() + 16;
    var flags: Vec<i64> = peir_unchecked_ops(f, nv2);
    var proved: bool = false;
    ci = 0;
    while ci < copy_of.len() && !proved {
        var cb: BasicBlock = f.blocks.get(f.blocks.len() - 1 - copy_of.len() + ci);
        var k6: i64 = 0;
        while k6 < cb.instructions.len() {
            var cid: i64 = cb.instructions.get(k6);
            match peir_inst_of(f, cid) {
                Inst::Call(cn, _, _, _) => {
                    if (cn == "Vec_get" || cn == "Vec_set" || cn == "p_vec_get" || cn == "p_vec_set") && cid >= 0 && cid < flags.len() && (flags.get(cid) & 1) != 0 {
                        proved = true;
                    }
                }
                _ => {
                }
            }
            k6 = k6 + 1;
        }
        ci = ci + 1;
    }
    if !proved {
        return iro_version_no("the proof covers no access of the copy");
    }
    return true;
}

/// ME25/ME23: for `fid explain` (CP3), which reads the IR as lowered: each
/// function's loops versioned (when `version` is on: the default since
/// Nov 17) and rotated (when `rotate` is), as iropt_native leaves them, so
/// the report lists a versioned copy's checks as removed (counted loop)
/// and the original loop's as kept. Returns how many loops were versioned.
pub fn iro_explain_loops(module: &mut IrModule) -> i64 {
    var on_version: bool = iro_pass_on("version") && ime_on("version");
    var on_rotate: bool = iro_pass_on("rotate") && ime_on("rotate");
    if !on_version && !on_rotate {
        return 0;
    }
    var nver: i64 = 0;
    var i: i64 = 0;
    while i < module.functions.len() {
        var ent: IrFunctionEntry = module.functions.get(i);
        var f: IrFunction = ent.func;
        var changed: bool = false;
        if on_version {
            f = iro_version(f);
            if g_iro_nver > 0 {
                changed = true;
                nver = nver + g_iro_nver;
            }
        }
        if on_rotate && ime_rotate(&mut f) {
            changed = true;
        }
        if changed {
            ent.func = f;
            module.functions.set(i, ent);
        }
        i = i + 1;
    }
    return nver;
}

/// The copy `nid` keeps the source line of `oid` (a panic in it says where).
fn iro_version_line(f: &mut IrFunction, oid: i64, nid: i64) {
    match IrFunction_get_meta(f, oid) {
        OptValueMeta::Some(om) => {
            match IrFunction_get_meta(f, nid) {
                OptValueMeta::Some(nm) => {
                    var m2: ValueMeta = nm;
                    m2.source_line = om.source_line;
                    IrFunction_set_meta(f, nid, m2);
                }
                OptValueMeta::None => {
                }
            }
        }
        OptValueMeta::None => {
        }
    }
}

// --- Small local Vecs (LF14, LF16) ------------------------------------------
// Both run before inlining, while core's Vec functions are still calls, on
// every function but core's own Vec ones and functions with regions or
// persist variables. Opt-in until a suite run agrees with them on and off.
//
// LF16 (FID_IROPT_ON=soleown, iro_sole_owner): a Vec made in the function
// whose handle only core's Vec functions see (the list of the C generator's
// LF16, codegen_c.fd cg_sole_safe_call) is never shared, so its capacity is
// never the negative mark of a shared buffer and the vec_own calls the
// lowering puts before a write into one of its elements (Lowerer_own_path,
// `ps[i].x = ...`) return at once: they are removed.
//
// LF14 (FID_IROPT_ON=vecsroa, iro_vec_sroa): a Vec of plain words (element
// code 0, type id 0: no element is ever dropped) made in the function,
// pushed only in the block that makes it and there before any read, read
// and set only in that block at constant indexes below the number of
// pushes, and otherwise only dropped, at most IRO_VSROA_MAX elements: its
// elements become stack slots, the pushes and sets stores, the reads loads,
// `len` a constant; the Vec, its store into its variable and its drops go.
// promote and dce then make the slots values.

/// The most elements LF14 keeps in stack slots.
const IRO_VSROA_MAX: i64 = 8;
/// What the last iro_vec_locals did (FID_IROPT_STATS).
var g_iro_vsroa_n: i64 = 0;
var g_iro_soleown_n: i64 = 0;

/// LF14 (`sroa`) and LF16 (`sole`) over the module.
fn iro_vec_locals(module: &mut IrModule, sole: bool, sroa: bool) {
    g_iro_vsroa_n = 0;
    g_iro_soleown_n = 0;
    var vfi: i64 = 0;
    while vfi < module.functions.len() {
        var vent: IrFunctionEntry = module.functions.get(vfi);
        if !str_starts_with(vent.name, "Vec_") && !str_starts_with(vent.name, "vec_") {
            var vfn: IrFunction = vent.func;
            var vch: bool = false;
            if vfn.blocks.len() > 0 && vfn.persist_vars.len() == 0 && !iro_vl_has_region(&vfn) {
                if sole && iro_sole_owner(&mut vfn) {
                    vch = true;
                }
                if sroa && iro_vec_sroa(&mut vfn) {
                    vch = true;
                }
            }
            if vch {
                vent.func = vfn;
                module.functions.set(vfi, vent);
            }
        }
        vfi = vfi + 1;
    }
    if iro_stats_on() {
        p_eprint_str("iropt: vecsroa " + int_to_str(g_iro_vsroa_n) + " Vecs to stack slots, soleown " + int_to_str(g_iro_soleown_n) + " vec_own calls removed\n");
    }
}

/// Does `f` open a region (LF14 and LF16 leave it alone)?
fn iro_vl_has_region(f: &IrFunction) -> bool {
    var ri: i64 = 0;
    while ri < f.insts.len() {
        match f.insts.get(ri).inst {
            Inst::RegionBegin(_, _, _, _) => {
                return true;
            }
            _ => {
            }
        }
        ri = ri + 1;
    }
    return false;
}

/// A zero or null, or a cast of one (what an owned slot is cleared to).
fn iro_vl_zero(f: &IrFunction, v: i64) -> bool {
    match IrFunction_get_inst(f, v) {
        OptInst::Some(zinst) => {
            match zinst {
                Inst::ConstNull(_) => {
                    return true;
                }
                Inst::ConstInt(zc, _) => {
                    return zc == 0;
                }
                Inst::BitCast(zx, _, _) => {
                    return iro_vl_zero(f, zx);
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return false;
}

/// `n` words of -1.
fn iro_vl_minus_ones(n: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var mi: i64 = 0;
    while mi < n {
        out.push(-1);
        mi = mi + 1;
    }
    return out;
}

/// Take the instructions `dead` marks out of every block of `f`.
fn iro_vl_drop_dead(f: &mut IrFunction, dead: &Vec<i64>) {
    var db: i64 = 0;
    while db < f.blocks.len() {
        var dblk: BasicBlock = f.blocks.get(db);
        var keep: Vec<i64> = Vec::new();
        var gone: bool = false;
        var dk: i64 = 0;
        while dk < dblk.instructions.len() {
            var did: i64 = dblk.instructions.get(dk);
            if did >= 0 && did < dead.len() && dead.get(did) == 1 {
                gone = true;
            } else {
                keep.push(did);
            }
            dk = dk + 1;
        }
        if gone {
            dblk.instructions = keep;
            f.blocks.set(db, dblk);
        }
        db = db + 1;
    }
}

// --- LF16: vec_own on a Vec with one owner -----------------------------------

/// core's Vec functions that take the Vec at argument 1 (after the env) and
/// never make its buffer shared: they read it, change it in place, copy
/// from it or free it (codegen_c.fd cg_sole_safe_call), and vec_own itself.
/// Vec_share / Vec_share_deep are not among them.
fn iro_sole_safe_call(n: str) -> bool {
    return n == "vec_own" || n == "Vec_push" || n == "Vec_push_mem" || n == "Vec_set" || n == "Vec_set_mem" || n == "Vec_insert" || n == "Vec_insert_mem" || n == "Vec_get" || n == "Vec_len" || n == "Vec_is_empty" || n == "Vec_elem_addr" || n == "Vec_pop" || n == "Vec_clear" || n == "Vec_capacity" || n == "Vec_contains" || n == "Vec_first" || n == "Vec_last" || n == "Vec_truncate" || n == "Vec_reverse" || n == "Vec_extend" || n == "Vec_remove" || n == "Vec_clone" || n == "Vec_to_str" || n == "Vec_sort" || n == "Vec_drop" || n == "Vec_drop_inplace" || n == "Vec_drop_strs" || n == "Vec_drop_vecs";
}

/// Is `inst` a call of iro_sole_safe_call with `u` as argument 1 and nowhere
/// else?
fn iro_sole_arg1(inst: Inst, u: i64) -> bool {
    match inst {
        Inst::Call(scn, scargs, _, _) => {
            if !iro_sole_safe_call(scn) || scargs.len() < 2 || scargs.get(1) != u {
                return false;
            }
            var sa: i64 = 0;
            while sa < scargs.len() {
                if sa != 1 && scargs.get(sa) == u {
                    return false;
                }
                sa = sa + 1;
            }
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// A call `cn` of `n` arguments that makes a new Vec with a buffer of its
/// own (capacity >= 0): an empty one, LF13's stack header, a filled one.
fn iro_sole_new(cn: str, n: i64) -> bool {
    return (cn == "Vec_new_typed" && n == 3) || (cn == "Vec_new" && n == 1) || (cn == "Vec_init_typed" && n == 4) || (cn == "Vec_new_sized" && n == 2) || (cn == "Vec_filled_typed" && n == 5) || (cn == "Vec_init_filled" && n == 6);
}

/// LF16 in one function: true when a vec_own call went. A Vec made here
/// (iro_sole_new) whose handle h is stored into at most one stack slot S,
/// where S holds nothing else (only h or a zero) and is only loaded and
/// stored; every other use of h, and every use of a value loaded from S, is
/// argument 1 of iro_sole_safe_call. Nothing can share its buffer, so a
/// vec_own on h or on such a load does nothing and is removed.
fn iro_sole_owner(f: &mut IrFunction) -> bool {
    var nv: i64 = f.next_value + 1;
    var created: Vec<i64> = peir_zeros(nv);
    var slot_ok: Vec<i64> = peir_zeros(nv);
    var loaded_from: Vec<i64> = iro_vl_minus_ones(nv);
    var h_of: Vec<i64> = iro_vl_minus_ones(nv);
    var slot_of: Vec<i64> = iro_vl_minus_ones(nv);
    var owns: i64 = 0;
    // 1: the creations, slots and loads; quick exit without a vec_own
    var b1: i64 = 0;
    while b1 < f.blocks.len() {
        var ids1: Vec<i64> = f.blocks.get(b1).instructions;
        var k1: i64 = 0;
        while k1 < ids1.len() {
            var iid1: i64 = ids1.get(k1);
            if iid1 >= 0 && iid1 < nv {
                match peir_inst_of(f, iid1) {
                    Inst::Call(cn1, cargs1, _, _) => {
                        if iro_sole_new(cn1, cargs1.len()) {
                            created.set(iid1, 1);
                        }
                        if cn1 == "vec_own" && cargs1.len() == 2 {
                            owns = owns + 1;
                        }
                    }
                    Inst::Alloca(_, _) => {
                        slot_ok.set(iid1, 1);
                    }
                    Inst::Load(lp1, _) => {
                        if lp1 >= 0 && lp1 < nv {
                            loaded_from.set(iid1, lp1);
                        }
                    }
                    _ => {
                    }
                }
            }
            k1 = k1 + 1;
        }
        b1 = b1 + 1;
    }
    if owns == 0 {
        return false;
    }
    // 2: which h goes into which slot (one slot per h, one h per slot)
    var b2: i64 = 0;
    while b2 < f.blocks.len() {
        var ids2: Vec<i64> = f.blocks.get(b2).instructions;
        var k2: i64 = 0;
        while k2 < ids2.len() {
            match peir_inst_of(f, ids2.get(k2)) {
                Inst::Store(sp2, sv2, _) => {
                    if sp2 >= 0 && sp2 < nv && sv2 >= 0 && sv2 < nv && created.get(sv2) == 1 {
                        if slot_of.get(sv2) >= 0 && slot_of.get(sv2) != sp2 {
                            created.set(sv2, 0);
                        }
                        slot_of.set(sv2, sp2);
                        if h_of.get(sp2) == -1 {
                            h_of.set(sp2, sv2);
                        } else if h_of.get(sp2) != sv2 {
                            h_of.set(sp2, -2);
                        }
                    }
                }
                _ => {
                }
            }
            k2 = k2 + 1;
        }
        b2 = b2 + 1;
    }
    // 3: every use checked
    var b3: i64 = 0;
    while b3 < f.blocks.len() {
        var ids3: Vec<i64> = f.blocks.get(b3).instructions;
        var k3: i64 = 0;
        while k3 < ids3.len() {
            var inst3: Inst = peir_inst_of(f, ids3.get(k3));
            var refs3: Vec<i64> = inst_value_refs(&inst3);
            var r3: i64 = 0;
            while r3 < refs3.len() {
                var u: i64 = refs3.get(r3);
                if u >= 0 && u < nv {
                    // h: stored (into its one slot), or a safe argument
                    if created.get(u) == 1 {
                        var fine_h: bool = iro_sole_arg1(inst3, u);
                        match inst3 {
                            Inst::Store(hsp, hsv, _) => {
                                if hsv == u && hsp != u {
                                    fine_h = true;
                                }
                            }
                            _ => {
                            }
                        }
                        if !fine_h {
                            created.set(u, 0);
                        }
                    }
                    // S: loads, and stores of its h or of a zero
                    if slot_ok.get(u) == 1 {
                        var fine_s: bool = false;
                        match inst3 {
                            Inst::Load(lsp, _) => {
                                fine_s = lsp == u;
                            }
                            Inst::Store(ssp, ssv, _) => {
                                fine_s = ssp == u && ssv != u && (ssv == h_of.get(u) || iro_vl_zero(f, ssv));
                            }
                            _ => {
                            }
                        }
                        if !fine_s {
                            slot_ok.set(u, 0);
                        }
                    }
                    // a value loaded from S: a safe argument
                    var ls: i64 = loaded_from.get(u);
                    if ls >= 0 && slot_ok.get(ls) == 1 && !iro_sole_arg1(inst3, u) {
                        slot_ok.set(ls, 0);
                    }
                }
                r3 = r3 + 1;
            }
            k3 = k3 + 1;
        }
        b3 = b3 + 1;
    }
    // 4: the vec_own calls on a handle that qualifies
    var dead: Vec<i64> = peir_zeros(nv);
    var nd: i64 = 0;
    var b4: i64 = 0;
    while b4 < f.blocks.len() {
        var ids4: Vec<i64> = f.blocks.get(b4).instructions;
        var k4: i64 = 0;
        while k4 < ids4.len() {
            var iid4: i64 = ids4.get(k4);
            match peir_inst_of(f, iid4) {
                Inst::Call(ocn, ocargs, _, _) => {
                    if ocn == "vec_own" && ocargs.len() == 2 && iid4 >= 0 && iid4 < nv {
                        var ou: i64 = ocargs.get(1);
                        var good: bool = false;
                        if ou >= 0 && ou < nv {
                            if created.get(ou) == 1 {
                                var os: i64 = slot_of.get(ou);
                                good = os < 0 || (slot_ok.get(os) == 1 && h_of.get(os) == ou);
                            }
                            var ol: i64 = loaded_from.get(ou);
                            if ol >= 0 && slot_ok.get(ol) == 1 {
                                var oh: i64 = h_of.get(ol);
                                if oh >= 0 && created.get(oh) == 1 && slot_of.get(oh) == ol {
                                    good = true;
                                }
                            }
                        }
                        if good {
                            dead.set(iid4, 1);
                            nd = nd + 1;
                        }
                    }
                }
                _ => {
                }
            }
            k4 = k4 + 1;
        }
        b4 = b4 + 1;
    }
    if nd == 0 {
        return false;
    }
    iro_vl_drop_dead(f, &dead);
    g_iro_soleown_n = g_iro_soleown_n + nd;
    return true;
}

// --- LF14: a small local Vec in stack slots ----------------------------------

/// Is `id` the constant `want` (an i64)?
fn iro_vs_const_is(f: &IrFunction, id: i64, want: i64) -> bool {
    match iro_const_int(f, id) {
        OptI64::Some(cv) => {
            return cv == want;
        }
        OptI64::None => {
        }
    }
    return false;
}

/// Does `inst` make an empty Vec of plain words: Vec_new_typed,
/// Vec_init_typed (LF13's stack header) or Vec_new_sized of element code 0
/// and type id 0?
fn iro_vs_plain_new(f: &IrFunction, inst: Inst) -> bool {
    match inst {
        Inst::Call(pcn, pcargs, _, _) => {
            if pcn == "Vec_new_typed" && pcargs.len() == 3 {
                return iro_vs_const_is(f, pcargs.get(1), 0) && iro_vs_const_is(f, pcargs.get(2), 0);
            }
            if pcn == "Vec_init_typed" && pcargs.len() == 4 {
                return iro_vs_const_is(f, pcargs.get(2), 0) && iro_vs_const_is(f, pcargs.get(3), 0);
            }
            if pcn == "Vec_new_sized" && pcargs.len() == 2 {
                return iro_vs_const_is(f, pcargs.get(1), 0);
            }
        }
        _ => {
        }
    }
    return false;
}

/// Is value `id` of `f` a stack slot?
fn iro_vs_is_alloca(f: &IrFunction, id: i64) -> bool {
    match peir_inst_of(f, id) {
        Inst::Alloca(_, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// Argument `i` of call `inst` (-1: not a call, or no such argument).
fn iro_vs_arg(inst: Inst, i: i64) -> i64 {
    match inst {
        Inst::Call(_, acargs, _, _) => {
            if i >= 0 && i < acargs.len() {
                return acargs.get(i);
            }
        }
        _ => {
        }
    }
    return -1;
}

/// The i64 constant at `id` when it is one and not negative, else -1.
fn iro_vs_index(f: &IrFunction, id: i64) -> i64 {
    match iro_const_int(f, id) {
        OptI64::Some(xc) => {
            if xc >= 0 {
                return xc;
            }
        }
        OptI64::None => {
        }
    }
    return -1;
}

/// A use of the Vec's slot `slot` that LF14 allows: a load, or a store of h
/// or of a zero.
fn iro_vs_slot_use_ok(f: &IrFunction, inst: Inst, slot: i64, h: i64) -> bool {
    match inst {
        Inst::Load(qlp, _) => {
            return qlp == slot;
        }
        Inst::Store(qsp, qsv, _) => {
            return qsp == slot && qsv != slot && (qsv == h || iro_vl_zero(f, qsv));
        }
        _ => {
        }
    }
    return false;
}

/// What `inst`, which reads one of the Vec's handles (`kind` != 0: h, or a
/// load of its slot), does with it: 1 push, 2 get, 3 set, 4 len, 5 drop,
/// 6 the store of h into its slot; 0 anything else. In a call the handle is
/// argument 1 and no other argument is a handle; pushed and set values and
/// the results of get and len are i64 words.
fn iro_vs_classify(f: &IrFunction, inst: Inst, kind: &Vec<i64>, slot: i64) -> i64 {
    match inst {
        Inst::Store(wsp, wsv, _) => {
            if slot >= 0 && wsp == slot && wsv >= 0 && wsv < kind.len() && kind.get(wsv) == 1 {
                return 6;
            }
            return 0;
        }
        Inst::Call(wcn, wcargs, wcty, _) => {
            if wcargs.len() < 2 {
                return 0;
            }
            var wa: i64 = 0;
            while wa < wcargs.len() {
                var wx: i64 = wcargs.get(wa);
                if wa != 1 && wx >= 0 && wx < kind.len() && kind.get(wx) != 0 {
                    return 0;
                }
                wa = wa + 1;
            }
            if wcn == "Vec_push" && wcargs.len() == 3 && ir_type_eq(iro_value_ty(f, wcargs.get(2)), IrType::I64) {
                return 1;
            }
            if wcn == "Vec_get" && wcargs.len() == 3 && ir_type_eq(wcty, IrType::I64) {
                return 2;
            }
            if wcn == "Vec_set" && wcargs.len() == 4 && ir_type_eq(iro_value_ty(f, wcargs.get(3)), IrType::I64) {
                return 3;
            }
            if wcn == "Vec_len" && wcargs.len() == 2 && ir_type_eq(wcty, IrType::I64) {
                return 4;
            }
            if (wcn == "Vec_drop" || wcn == "Vec_drop_inplace") && wcargs.len() == 2 {
                return 5;
            }
        }
        _ => {
        }
    }
    return 0;
}

/// LF14 in one function (see above): true when a Vec went.
fn iro_vec_sroa(f: &mut IrFunction) -> bool {
    var cands: Vec<i64> = Vec::new();
    var cb: i64 = 0;
    while cb < f.blocks.len() {
        var cids: Vec<i64> = f.blocks.get(cb).instructions;
        var ck: i64 = 0;
        while ck < cids.len() {
            if iro_vs_plain_new(f, peir_inst_of(f, cids.get(ck))) {
                cands.push(cids.get(ck));
            }
            ck = ck + 1;
        }
        cb = cb + 1;
    }
    var changed: bool = false;
    var ci: i64 = 0;
    while ci < cands.len() {
        if iro_vec_sroa_one(f, cands.get(ci)) {
            changed = true;
            g_iro_vsroa_n = g_iro_vsroa_n + 1;
        }
        ci = ci + 1;
    }
    return changed;
}

/// LF14 for the Vec made by instruction `h`: true when it became slots.
fn iro_vec_sroa_one(f: &mut IrFunction, h: i64) -> bool {
    var nv: i64 = f.next_value + 1;
    if h < 0 || h >= nv {
        return false;
    }
    // 1: the slot h is stored in (-1: none) and h's block
    var slot: i64 = -1;
    var hb: i64 = -1;
    var b1: i64 = 0;
    while b1 < f.blocks.len() {
        var ids1: Vec<i64> = f.blocks.get(b1).instructions;
        var k1: i64 = 0;
        while k1 < ids1.len() {
            var iid1: i64 = ids1.get(k1);
            if iid1 == h {
                hb = b1;
            }
            match peir_inst_of(f, iid1) {
                Inst::Store(sp1, sv1, _) => {
                    if sv1 == h {
                        if sp1 == h || (slot >= 0 && slot != sp1) || !iro_vs_is_alloca(f, sp1) {
                            return false;
                        }
                        slot = sp1;
                    }
                }
                _ => {
                }
            }
            k1 = k1 + 1;
        }
        b1 = b1 + 1;
    }
    if hb < 0 {
        return false;
    }
    // 2: the handles, h (1) and the loads of its slot (2); the slot is only
    // loaded, and stored h or a zero
    var kind: Vec<i64> = peir_zeros(nv);
    kind.set(h, 1);
    if slot >= 0 {
        var b2: i64 = 0;
        while b2 < f.blocks.len() {
            var ids2: Vec<i64> = f.blocks.get(b2).instructions;
            var k2: i64 = 0;
            while k2 < ids2.len() {
                var iid2: i64 = ids2.get(k2);
                var inst2: Inst = peir_inst_of(f, iid2);
                match inst2 {
                    Inst::Load(lp2, _) => {
                        if lp2 == slot && iid2 >= 0 && iid2 < nv {
                            kind.set(iid2, 2);
                        }
                    }
                    _ => {
                    }
                }
                if peir_has_id(inst_value_refs(&inst2), slot) && !iro_vs_slot_use_ok(f, inst2, slot, h) {
                    return false;
                }
                k2 = k2 + 1;
            }
            b2 = b2 + 1;
        }
    }
    // 3: every use of a handle, in block order. In h's block a load of the
    // slot after the store of h (and no zero since) holds this run's h (3).
    var act: Vec<i64> = peir_zeros(nv);
    var at: Vec<i64> = peir_zeros(nv);
    var n: i64 = 0;
    var read: bool = false;
    var b3: i64 = 0;
    while b3 < f.blocks.len() {
        var ids3: Vec<i64> = f.blocks.get(b3).instructions;
        var live: bool = false;
        var k3: i64 = 0;
        while k3 < ids3.len() {
            var iid3: i64 = ids3.get(k3);
            var inst3: Inst = peir_inst_of(f, iid3);
            if b3 == hb && slot >= 0 {
                match inst3 {
                    Inst::Store(sp3, sv3, _) => {
                        if sp3 == slot {
                            live = sv3 == h;
                        }
                    }
                    Inst::Load(lp3, _) => {
                        if lp3 == slot && live && iid3 >= 0 && iid3 < nv {
                            kind.set(iid3, 3);
                        }
                    }
                    _ => {
                    }
                }
            }
            var refs3: Vec<i64> = inst_value_refs(&inst3);
            var touches: bool = false;
            var r3: i64 = 0;
            while r3 < refs3.len() {
                var u3: i64 = refs3.get(r3);
                if u3 >= 0 && u3 < nv && kind.get(u3) != 0 {
                    touches = true;
                }
                r3 = r3 + 1;
            }
            if touches {
                var w: i64 = iro_vs_classify(f, inst3, &kind, slot);
                if w == 0 || iid3 < 0 || iid3 >= nv {
                    return false;
                }
                if w <= 4 {
                    // a push, get, set or len: in h's block, on h itself or
                    // on a load that holds it
                    var hv: i64 = iro_vs_arg(inst3, 1);
                    if b3 != hb || hv < 0 || hv >= nv || (kind.get(hv) != 1 && kind.get(hv) != 3) {
                        return false;
                    }
                }
                if w == 1 {
                    // every push before any read: the length is known
                    if read || n >= IRO_VSROA_MAX {
                        return false;
                    }
                    at.set(iid3, n);
                    n = n + 1;
                }
                if w == 2 || w == 3 {
                    // an index the pushes made: no bounds panic to keep
                    var ix: i64 = iro_vs_index(f, iro_vs_arg(inst3, 2));
                    if ix < 0 || ix >= n {
                        return false;
                    }
                    at.set(iid3, ix);
                    read = true;
                }
                if w == 4 {
                    read = true;
                }
                act.set(iid3, w);
            }
            k3 = k3 + 1;
        }
        b3 = b3 + 1;
    }
    // 4: one slot per element; pushes and sets store, gets load, len is n;
    // h, its store and the drops go
    var slots: Vec<i64> = Vec::new();
    var s4: i64 = 0;
    while s4 < n {
        slots.push(iro_detached(f, Inst::Alloca(IrType::I64, Region::Stack)));
        s4 = s4 + 1;
    }
    var dead: Vec<i64> = peir_zeros(nv);
    dead.set(h, 1);
    var b4: i64 = 0;
    while b4 < f.blocks.len() {
        var ids4: Vec<i64> = f.blocks.get(b4).instructions;
        var k4: i64 = 0;
        while k4 < ids4.len() {
            var iid4: i64 = ids4.get(k4);
            if iid4 >= 0 && iid4 < nv {
                var w4: i64 = act.get(iid4);
                var inst4: Inst = peir_inst_of(f, iid4);
                if w4 == 1 {
                    IrFunction_set_inst(f, iid4, Inst::Store(slots.get(at.get(iid4)), iro_vs_arg(inst4, 2), OptIrType::None));
                } else if w4 == 2 {
                    IrFunction_set_inst(f, iid4, Inst::Load(slots.get(at.get(iid4)), IrType::I64));
                } else if w4 == 3 {
                    IrFunction_set_inst(f, iid4, Inst::Store(slots.get(at.get(iid4)), iro_vs_arg(inst4, 3), OptIrType::None));
                } else if w4 == 4 {
                    IrFunction_set_inst(f, iid4, Inst::ConstInt(n, IrType::I64));
                } else if w4 >= 5 {
                    dead.set(iid4, 1);
                }
            }
            k4 = k4 + 1;
        }
        b4 = b4 + 1;
    }
    iro_vl_drop_dead(f, &dead);
    // the slots at the start of the entry block
    var eblk: BasicBlock = f.blocks.get(0);
    var fresh: Vec<i64> = Vec::new();
    var s5: i64 = 0;
    while s5 < slots.len() {
        fresh.push(slots.get(s5));
        s5 = s5 + 1;
    }
    var k5: i64 = 0;
    while k5 < eblk.instructions.len() {
        fresh.push(eblk.instructions.get(k5));
        k5 = k5 + 1;
    }
    eblk.instructions = fresh;
    f.blocks.set(0, eblk);
    return true;
}
