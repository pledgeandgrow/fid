// compiler/iropt.fd — IR optimizations run before native code generation
// (release D5, D6).
//
// The native Windows backend (compiler/pe_ir*.fd) turns IR straight into
// machine code, with no optimizer in between; these passes give it one:
//   - inlining of small functions: a call to a function of one block made of
//     plain instructions (no calls, no prints, no regions) is replaced by a
//     copy of that block; the call becomes a move of the copied result
//   - constant folding of integer arithmetic and comparisons whose operands
//     are both constants, when the result cannot overflow
//   - removal of constants and other pure values nothing reads
//   - global value numbering (OP7): a pure computation a dominating block
//     already did is reused
//   - self tail calls into jumps (OP13)
//   - loop-invariant code motion (competitive OP9, OP26): a read of a local
//     the loop never stores, `v.len()` of a Vec the loop cannot resize, and
//     pure operations on such values move to the block before the loop
//   - the mid-end of docs/roadmap/llvm-roadmap.md Track ME, on use lists
//     (ME1, iro_uses): branches on constants become jumps (ME14), stores to
//     a local nobody reads again are dropped and DCE removes more pure values
//     (ME15), constants are reassociated and multiplication, division and
//     remainder by powers of two become shifts and masks where no overflow
//     or zero check is lost (ME12)
// Every pass leaves the program's meaning as it was; when in doubt it does
// nothing.

module compiler::iropt;

use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::checks;
use compiler::pe_ir_stubs;
use compiler::iropt_me;

/// Largest callee (instructions, its return included) that is inlined.
const IRO_INLINE_MAX: i64 = 16;

/// Run every pass on `module` (the pass manager: see iro_pass_on).
pub fn iropt_native(module: &mut IrModule) {
    if iro_pass_on("inline") { iro_inline(module); }
    // ME20, ME21: inlining across functions, bottom-up (opt-in)
    if ime_on("inline2") { ime_inline(module); }
    var n_fold: i64 = 0;
    var n_dce: i64 = 0;
    var n_tail: i64 = 0;
    var n_gvn: i64 = 0;
    var n_licm: i64 = 0;
    var on_fold: bool = iro_pass_on("fold");
    var on_dce: bool = iro_pass_on("dce");
    var on_tail: bool = IRO_TAILCALL && iro_pass_on("tailcall");
    var on_gvn: bool = IRO_GVN && iro_pass_on("gvn");
    var on_licm: bool = IRO_LICM && iro_pass_on("licm");
    // ME12/ME14/ME15 of the first mid-end batch are opt-in (FID_IROPT_ON)
    // until the suite agrees with them on and off
    var on_branch: bool = iro_pass_on("branchfold") && ime_on("branchfold");
    var on_facts: bool = iro_pass_on("branchfacts");
    var on_sccp: bool = iro_pass_on("sccp");
    var on_promote: bool = iro_pass_on("promote");
    var on_dse: bool = iro_pass_on("dse") && ime_on("dse");
    var on_simplify: bool = iro_pass_on("simplify") && ime_on("simplify");
    var n_branch: i64 = 0;
    var n_facts: i64 = 0;
    var n_sccp: i64 = 0;
    var n_promote: i64 = 0;
    var n_dse: i64 = 0;
    var n_simp: i64 = 0;
    var stats: bool = iro_stats_on();
    var insts_before: i64 = 0;
    var insts_after: i64 = 0;
    var t_start: i64 = 0;
    if stats { t_start = p_clock_now_ms(); }
    // ME5: per-pass timing, summed over the functions
    var tp_names: Vec<str> = Vec::new();
    var tp_ms: Vec<i64> = Vec::new();
    var tp_hits: Vec<i64> = Vec::new();
    // Only what main reaches is worth optimizing (CS1); a function the
    // native backend generates on demand is correct without it
    var reach: i64 = HashMap_new();
    var has_main: bool = false;
    var ri: i64 = 0;
    while ri < module.functions.len() {
        if module.functions.get(ri).name == "main" { has_main = true; }
        ri = ri + 1;
    }
    if has_main {
        var rl: Vec<str> = pe_ir_reachable_functions(module);
        ri = 0;
        while ri < rl.len() {
            HashMap_insert(reach, rl.get(ri), 1);
            ri = ri + 1;
        }
    }
    var i: i64 = 0;
    while i < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(i);
        if has_main && !HashMap_contains(reach, entry.name) {
            i = i + 1;
            continue;
        }
        var f: IrFunction = entry.func;
        var changed: bool = false;
        if stats { insts_before = insts_before + iro_count_insts(&f); }
        // ME22-ME28 (compiler/iropt_me.fd, opt-in): restructuring first,
        // so the cleanup passes below see their result
        if ime_function_passes(&mut f) { changed = true; }
        if on_fold && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "fold", stats, &mut f) { changed = true; n_fold = n_fold + 1; }
        if on_simplify && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "simplify", stats, &mut f) { changed = true; n_simp = n_simp + 1; }
        if on_branch && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "branchfold", stats, &mut f) { changed = true; n_branch = n_branch + 1; }
        if on_facts && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "branchfacts", stats, &mut f) { changed = true; n_facts = n_facts + 1; }
        if on_sccp && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "sccp", stats, &mut f) { changed = true; n_sccp = n_sccp + 1; }
        if on_promote && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "promote", stats, &mut f) { changed = true; n_promote = n_promote + 1; }
        if on_dse && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "dse", stats, &mut f) { changed = true; n_dse = n_dse + 1; }
        if on_dce && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "dce", stats, &mut f) { changed = true; n_dce = n_dce + 1; }
        if on_tail && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "tailcall", stats, &mut f) { changed = true; n_tail = n_tail + 1; }
        if on_gvn && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "gvn", stats, &mut f) { changed = true; n_gvn = n_gvn + 1; }
        if on_licm && iro_time(&mut tp_names, &mut tp_ms, &mut tp_hits, "licm", stats, &mut f) { changed = true; n_licm = n_licm + 1; }
        if stats { insts_after = insts_after + iro_count_insts(&f); }
        if changed {
            entry.func = f;
            module.functions.set(i, entry);
        }
        i = i + 1;
    }
    if stats {
        p_eprint_str("iropt: fold " + int_to_str(n_fold) + ", simplify " + int_to_str(n_simp) + ", branchfold " + int_to_str(n_branch)
            + ", branchfacts " + int_to_str(n_facts) + ", sccp " + int_to_str(n_sccp) + ", promote " + int_to_str(n_promote) + ", dse " + int_to_str(n_dse) + ", dce " + int_to_str(n_dce) + ", tailcall " + int_to_str(n_tail)
            + ", gvn " + int_to_str(n_gvn) + ", licm " + int_to_str(n_licm) + " functions changed\n");
        // ME30: what the mid-end did, for scripts/me-measure.sh
        p_eprint_str("iropt: instructions " + int_to_str(insts_before) + " -> " + int_to_str(insts_after)
            + " in " + int_to_str(p_clock_now_ms() - t_start) + " ms\n");
        // ME5: per-pass timing, most expensive first
        var ti: i64 = 0;
        while ti < tp_ms.len() {
            var tj: i64 = ti + 1;
            while tj < tp_ms.len() {
                if tp_ms.get(tj) > tp_ms.get(ti) {
                    var m1: i64 = tp_ms.get(ti);
                    tp_ms.set(ti, tp_ms.get(tj));
                    tp_ms.set(tj, m1);
                    var n1: str = tp_names.get(ti);
                    tp_names.set(ti, tp_names.get(tj));
                    tp_names.set(tj, n1);
                    var h1: i64 = tp_hits.get(ti);
                    tp_hits.set(ti, tp_hits.get(tj));
                    tp_hits.set(tj, h1);
                }
                tj = tj + 1;
            }
            p_eprint_str("iropt: pass " + tp_names.get(ti) + ": " + int_to_str(tp_ms.get(ti)) + " ms ("
                + int_to_str(tp_hits.get(ti)) + " calls)\n");
            ti = ti + 1;
        }
    }
}

/// Run pass `name` on `f`, adding its time to the table when `stats`.
/// Fides calls are resolved statically, so the name dispatches.
fn iro_time(names: &mut Vec<str>, ms: &mut Vec<i64>, hits: &mut Vec<i64>, name: str, stats: bool, f: &mut IrFunction) -> bool {
    var t0: i64 = 0;
    if stats { t0 = p_clock_now_ms(); }
    var changed: bool = false;
    if name == "fold" { changed = iro_fold(f); }
    if name == "simplify" { changed = iro_simplify(f); }
    if name == "branchfold" { changed = iro_branch_fold(f); }
    if name == "branchfacts" { changed = iro_branch_facts(f); }
    if name == "sccp" { changed = iro_sccp(f); }
    if name == "promote" { changed = iro_promote(f); }
    if name == "dse" { changed = iro_dse(f); }
    if name == "dce" { changed = iro_dce(f); }
    if name == "tailcall" { changed = iro_tailcalls(f); }
    if name == "gvn" { changed = iro_gvn(f); }
    if name == "licm" { changed = iro_licm(f); }
    if stats {
        var dt: i64 = p_clock_now_ms() - t0;
        var i: i64 = 0;
        while i < names.len() {
            if names.get(i) == name {
                ms.set(i, ms.get(i) + dt);
                hits.set(i, hits.get(i) + 1);
                return changed;
            }
            i = i + 1;
        }
        names.push(name);
        ms.push(dt);
        hits.push(1);
    }
    return changed;
}

// --- Helpers ----------------------------------------------------------------

/// A new instruction in `f` that is in no block yet.
fn iro_detached(f: &mut IrFunction, inst: Inst) -> i64 {
    var id: i64 = IrFunction_emit(f, inst);
    var last: i64 = f.current_block_idx;
    var blk: BasicBlock = f.blocks.get(last);
    blk.instructions.pop();
    f.blocks.set(last, blk);
    return id;
}

fn iro_is_scalar(t: IrType) -> bool {
    match t {
        IrType::I8 => { return true; }
        IrType::I16 => { return true; }
        IrType::I32 => { return true; }
        IrType::I64 => { return true; }
        IrType::U8 => { return true; }
        IrType::U16 => { return true; }
        IrType::U32 => { return true; }
        IrType::U64 => { return true; }
        IrType::F32 => { return true; }
        IrType::F64 => { return true; }
        IrType::Bool => { return true; }
        IrType::Ptr(_) => { return true; }
        _ => { return false; }
    }
}

// --- Inlining (release D5) --------------------------------------------------

/// Whether `inst` may be copied into a caller as it is.
fn iro_inlinable_inst(inst: Inst) -> bool {
    match inst {
        Inst::ConstInt(_, _) => { return true; }
        Inst::ConstFloat(_, _) => { return true; }
        Inst::ConstBool(_) => { return true; }
        Inst::ConstStr(_) => { return true; }
        Inst::ConstNull(_) => { return true; }
        Inst::GlobalAddr(_, _) => { return true; }
        Inst::BinOp(_, _, _, _) => { return true; }
        Inst::UnaryOp(_, _, _) => { return true; }
        Inst::Alloca(_, _) => { return true; }
        Inst::Load(_, _) => { return true; }
        Inst::Store(_, _, _) => { return true; }
        Inst::GetFieldPtr(_, _, _) => { return true; }
        Inst::BitCast(_, _, _) => { return true; }
        Inst::IntExtend(_, _, _) => { return true; }
        Inst::IntTrunc(_, _, _) => { return true; }
        Inst::IntToFloat(_, _, _) => { return true; }
        Inst::FloatToInt(_, _, _) => { return true; }
        _ => { return false; }
    }
}

/// The value `id` names in the caller (map: callee id -> caller id + 1).
fn iro_m(map: Vec<i64>, id: i64) -> i64 {
    if id >= 0 && id < map.len() && map.get(id) != 0 { return map.get(id) - 1; }
    return id;
}

/// `inst` with its operands renamed through `map` (only the instructions
/// iro_inlinable_inst accepts).
fn iro_remap(inst: Inst, map: Vec<i64>) -> Inst {
    match inst {
        Inst::BinOp(op, a, b, t) => { return Inst::BinOp(op, iro_m(map, a), iro_m(map, b), t); }
        Inst::UnaryOp(op, a, t) => { return Inst::UnaryOp(op, iro_m(map, a), t); }
        Inst::Load(p, t) => { return Inst::Load(iro_m(map, p), t); }
        Inst::Store(p, v, t) => { return Inst::Store(iro_m(map, p), iro_m(map, v), t); }
        Inst::GetFieldPtr(p, idx, t) => { return Inst::GetFieldPtr(iro_m(map, p), idx, t); }
        Inst::BitCast(v, a, b) => { return Inst::BitCast(iro_m(map, v), a, b); }
        Inst::IntExtend(v, a, b) => { return Inst::IntExtend(iro_m(map, v), a, b); }
        Inst::IntTrunc(v, a, b) => { return Inst::IntTrunc(iro_m(map, v), a, b); }
        Inst::IntToFloat(v, a, b) => { return Inst::IntToFloat(iro_m(map, v), a, b); }
        Inst::FloatToInt(v, a, b) => { return Inst::FloatToInt(iro_m(map, v), a, b); }
        _ => {}
    }
    return inst;
}

/// The instructions of `callee` to copy (its Return excluded) and the value
/// it returns, when it can be inlined: one block, at most IRO_INLINE_MAX
/// plain instructions, a scalar result. ret = -1 when it cannot.
pub struct IroBody {
    pub insts: Vec<i64>,
    pub ret: i64,
}

fn iro_body(callee: &IrFunction, caller: &IrFunction) -> IroBody {
    var none: IroBody = IroBody { insts: Vec::new(), ret: -1 };
    if callee.blocks.len() != 1 { return none; }
    if callee.name == caller.name || callee.name == "main" { return none; }
    if callee.is_interrupt || callee.is_wrapping != caller.is_wrapping { return none; }
    if callee.zeroize_locals.len() > 0 || callee.drop_locals.len() > 0 { return none; }
    if callee.persist_vars.len() > 0 { return none; }
    if !iro_is_scalar(callee.ret_ty) { return none; }
    var ids: Vec<i64> = callee.blocks.get(0).instructions;
    if ids.len() == 0 || ids.len() > IRO_INLINE_MAX { return none; }
    var body: Vec<i64> = Vec::new();
    var ret: i64 = -1;
    var i: i64 = 0;
    while i < ids.len() {
        var id: i64 = ids.get(i);
        match IrFunction_get_inst(callee, id) {
            OptInst::Some(inst) => {
                match inst {
                    Inst::Return(rv) => {
                        if i + 1 != ids.len() { return none; }
                        match rv {
                            OptValueId::Some(r) => { ret = r; }
                            OptValueId::None => { return none; }
                        }
                    }
                    _ => {
                        if !iro_inlinable_inst(inst) { return none; }
                        body.push(id);
                    }
                }
            }
            OptInst::None => { return none; }
        }
        i = i + 1;
    }
    if ret < 0 { return none; }
    return IroBody { insts: body, ret: ret };
}

/// Inline small functions at their call sites, in every function.
pub fn iro_inline(module: &mut IrModule) {
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(fi);
        var f: IrFunction = entry.func;
        if iro_inline_function(module, &mut f) {
            entry.func = f;
            module.functions.set(fi, entry);
        }
        fi = fi + 1;
    }
}

fn iro_inline_function(module: &IrModule, f: &mut IrFunction) -> bool {
    var changed: bool = false;
    var b: i64 = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var old: Vec<i64> = blk.instructions;
        var fresh: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < old.len() {
            var id: i64 = old.get(k);
            var done: bool = false;
            match IrFunction_get_inst(f, id) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::Call(name, args, cty, _) => {
                            if iro_is_scalar(cty) {
                                match IrModule_get_function(module, name) {
                                    OptIrFunction::Some(callee) => {
                                        var body: IroBody = iro_body(&callee, f);
                                        if body.ret >= 0 && callee.params.len() == args.len() {
                                            // callee value -> caller value + 1
                                            var map: Vec<i64> = Vec::new();
                                            var z: i64 = 0;
                                            while z < callee.next_value {
                                                map.push(0);
                                                z = z + 1;
                                            }
                                            var p: i64 = 0;
                                            while p < callee.params.len() {
                                                var pid: i64 = callee.params.get(p).id;
                                                if pid >= 0 && pid < map.len() { map.set(pid, args.get(p) + 1); }
                                                p = p + 1;
                                            }
                                            var q: i64 = 0;
                                            while q < body.insts.len() {
                                                var cid: i64 = body.insts.get(q);
                                                match IrFunction_get_inst(&callee, cid) {
                                                    OptInst::Some(cinst) => {
                                                        var nid: i64 = iro_detached(f, iro_remap(cinst, map));
                                                        if cid < map.len() { map.set(cid, nid + 1); }
                                                        fresh.push(nid);
                                                    }
                                                    OptInst::None => {}
                                                }
                                                q = q + 1;
                                            }
                                            // The call is now a move of the inlined result
                                            IrFunction_set_inst(f, id, Inst::BitCast(iro_m(map, body.ret), cty, cty));
                                            fresh.push(id);
                                            done = true;
                                            changed = true;
                                        }
                                    }
                                    OptIrFunction::None => {}
                                }
                            }
                        }
                        _ => {}
                    }
                }
                OptInst::None => {}
            }
            if !done { fresh.push(id); }
            k = k + 1;
        }
        blk.instructions = fresh;
        f.blocks.set(b, blk);
        b = b + 1;
    }
    return changed;
}

// --- Constant folding (release D6) ------------------------------------------

fn iro_const_int(f: &IrFunction, id: i64) -> OptI64 {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::ConstInt(v, t) => {
                    match t {
                        IrType::I64 => { return OptI64::Some(v); }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        OptInst::None => {}
    }
    return OptI64::None;
}

const IRO_I64_MAX: i64 = 9223372036854775807;
const IRO_SQRT_MAX: i64 = 3037000499;

/// Fold integer BinOps of two i64 constants. Arithmetic is folded only when
/// it cannot overflow (an overflow must still panic at run time), division
/// and remainder never (a zero divisor must panic too).
fn iro_fold(f: &mut IrFunction) -> bool {
    var changed: bool = false;
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            match IrFunction_get_inst(f, id) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::BinOp(op, l, r, t) => {
                            match iro_const_int(f, l) {
                                OptI64::Some(a) => {
                                    match iro_const_int(f, r) {
                                        OptI64::Some(c) => {
                                            var folded: OptInst = iro_fold_binop(op, a, c, t);
                                            match folded {
                                                OptInst::Some(ni) => { IrFunction_set_inst(f, id, ni); changed = true; }
                                                OptInst::None => {}
                                            }
                                        }
                                        OptI64::None => {}
                                    }
                                }
                                OptI64::None => {}
                            }
                        }
                        _ => {}
                    }
                }
                OptInst::None => {}
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return changed;
}

fn iro_fold_binop(op: BinOp, a: i64, c: i64, t: IrType) -> OptInst {
    var is_i64: bool = false;
    match t {
        IrType::I64 => { is_i64 = true; }
        _ => {}
    }
    if binop_eq(op, BinOp::Eq) { return OptInst::Some(Inst::ConstBool(a == c)); }
    if binop_eq(op, BinOp::Neq) { return OptInst::Some(Inst::ConstBool(a != c)); }
    if binop_eq(op, BinOp::Lt) { return OptInst::Some(Inst::ConstBool(a < c)); }
    if binop_eq(op, BinOp::Gt) { return OptInst::Some(Inst::ConstBool(a > c)); }
    if binop_eq(op, BinOp::LtEq) { return OptInst::Some(Inst::ConstBool(a <= c)); }
    if binop_eq(op, BinOp::GtEq) { return OptInst::Some(Inst::ConstBool(a >= c)); }
    if !is_i64 { return OptInst::None; }
    if binop_eq(op, BinOp::Add) {
        if (c > 0 && a > IRO_I64_MAX - c) || (c < 0 && a < (0 - IRO_I64_MAX - 1) - c) { return OptInst::None; }
        return OptInst::Some(Inst::ConstInt(a + c, t));
    }
    if binop_eq(op, BinOp::Sub) {
        if (c < 0 && a > IRO_I64_MAX + c) || (c > 0 && a < (0 - IRO_I64_MAX - 1) + c) { return OptInst::None; }
        return OptInst::Some(Inst::ConstInt(a - c, t));
    }
    if binop_eq(op, BinOp::Mul) {
        if a > IRO_SQRT_MAX || a < 0 - IRO_SQRT_MAX || c > IRO_SQRT_MAX || c < 0 - IRO_SQRT_MAX { return OptInst::None; }
        return OptInst::Some(Inst::ConstInt(a * c, t));
    }
    if binop_eq(op, BinOp::BitAnd) { return OptInst::Some(Inst::ConstInt(a & c, t)); }
    if binop_eq(op, BinOp::BitOr) { return OptInst::Some(Inst::ConstInt(a | c, t)); }
    if binop_eq(op, BinOp::BitXor) { return OptInst::Some(Inst::ConstInt(a ^ c, t)); }
    return OptInst::None;
}

// --- Dead values (release D6) -----------------------------------------------

fn iro_pure(inst: Inst) -> bool {
    match inst {
        Inst::ConstInt(_, _) => { return true; }
        Inst::ConstFloat(_, _) => { return true; }
        Inst::ConstBool(_) => { return true; }
        Inst::ConstStr(_) => { return true; }
        Inst::ConstNull(_) => { return true; }
        Inst::ConstFnRef(_) => { return true; }
        Inst::GlobalAddr(_, _) => { return true; }
        Inst::GetFieldPtr(_, _, _) => { return true; }
        Inst::BitCast(_, _, _) => { return true; }
        _ => { return false; }
    }
}

/// Drop pure values nothing reads (folding leaves their operands unused).
fn iro_dce(f: &mut IrFunction) -> bool {
    var any: bool = false;
    var round: i64 = 0;
    while round < 3 {
        var uses: Vec<i64> = Vec::new();
        var z: i64 = 0;
        while z < f.next_value {
            uses.push(0);
            z = z + 1;
        }
        var b: i64 = 0;
        while b < f.blocks.len() {
            var ids: Vec<i64> = f.blocks.get(b).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                match IrFunction_get_inst(f, ids.get(k)) {
                    OptInst::Some(inst) => {
                        var ops: Vec<i64> = Vec::new();
                        peir_inst_operands(inst, &mut ops);
                        var o: i64 = 0;
                        while o < ops.len() {
                            var v: i64 = ops.get(o);
                            if v >= 0 && v < uses.len() { uses.set(v, uses.get(v) + 1); }
                            o = o + 1;
                        }
                    }
                    OptInst::None => {}
                }
                k = k + 1;
            }
            b = b + 1;
        }
        var removed: bool = false;
        b = 0;
        while b < f.blocks.len() {
            var blk: BasicBlock = f.blocks.get(b);
            var keep: Vec<i64> = Vec::new();
            var k: i64 = 0;
            while k < blk.instructions.len() {
                var id: i64 = blk.instructions.get(k);
                var drop: bool = false;
                if id >= 0 && id < uses.len() && uses.get(id) == 0 {
                    match IrFunction_get_inst(f, id) {
                        OptInst::Some(inst) => { drop = iro_pure(inst); }
                        OptInst::None => {}
                    }
                }
                if drop { removed = true; } else { keep.push(id); }
                k = k + 1;
            }
            if removed {
                blk.instructions = keep;
                f.blocks.set(b, blk);
            }
            b = b + 1;
        }
        if !removed { return any; }
        any = true;
        round = round + 1;
    }
    return any;
}

// --- Loop-invariant code motion ---------------------------------------------

const IRO_LICM: bool = true;

/// A local only loads and stores use (its address goes nowhere).
fn iro_plain_locals(f: &IrFunction) -> Vec<i64> {
    var plain: Vec<i64> = peir_zeros(f.next_value + 1);
    var i: i64 = 0;
    while i < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(i);
        match ve.inst {
            Inst::Alloca(_, _) => { if ve.id >= 0 && ve.id < plain.len() { plain.set(ve.id, 1); } }
            _ => {}
        }
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        var inst: Inst = f.insts.get(i).inst;
        var ops: Vec<i64> = Vec::new();
        peir_inst_operands(inst, &mut ops);
        var o: i64 = 0;
        while o < ops.len() {
            var v: i64 = ops.get(o);
            if v >= 0 && v < plain.len() && plain.get(v) == 1 {
                var ok: bool = false;
                match inst {
                    Inst::Load(p, _) => { ok = p == v; }
                    Inst::Store(p, sv, _) => { ok = p == v && sv != v; }
                    _ => {}
                }
                if !ok { plain.set(v, 0); }
            }
            o = o + 1;
        }
        i = i + 1;
    }
    return plain;
}

/// Calls a loop may make while its Vecs keep their lengths.
fn iro_len_safe_call(name: str) -> bool {
    return name == "Vec_get" || name == "Vec_set" || name == "Vec_len"
        || name == "p_vec_get" || name == "p_vec_set" || name == "p_vec_len";
}

fn iro_licm(f: &mut IrFunction) -> bool {
    var n: i64 = f.blocks.len();
    if n < 2 { return false; }
    var max_id: i64 = 0;
    var b: i64 = 0;
    while b < n {
        if f.blocks.get(b).id > max_id { max_id = f.blocks.get(b).id; }
        b = b + 1;
    }
    var index: Vec<i64> = Vec::new();
    while index.len() <= max_id { index.push(-1); }
    b = 0;
    while b < n {
        index.set(f.blocks.get(b).id, b);
        b = b + 1;
    }
    var succs: Vec<Vec<i64>> = Vec::new();
    var preds: Vec<Vec<i64>> = Vec::new();
    b = 0;
    while b < n {
        var s0: Vec<i64> = Vec::new();
        var p0: Vec<i64> = Vec::new();
        succs.push(s0);
        preds.push(p0);
        b = b + 1;
    }
    b = 0;
    while b < n {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        if ids.len() > 0 {
            match peir_inst_of(f, ids.get(ids.len() - 1)) {
                Inst::Jump(t) => { peir_add_edge(&mut succs, &mut preds, index, b, t); }
                Inst::Branch(_, t, e) => {
                    peir_add_edge(&mut succs, &mut preds, index, b, t);
                    peir_add_edge(&mut succs, &mut preds, index, b, e);
                }
                _ => {}
            }
        }
        b = b + 1;
    }
    // Back edges, by depth-first search from the entry
    var latches: Vec<Vec<i64>> = Vec::new();
    b = 0;
    while b < n {
        var l0: Vec<i64> = Vec::new();
        latches.push(l0);
        b = b + 1;
    }
    var any_loop: bool = false;
    var state: Vec<i64> = peir_zeros(n);
    var st_b: Vec<i64> = Vec::new();
    var st_next: Vec<i64> = Vec::new();
    st_b.push(0);
    st_next.push(0);
    state.set(0, 1);
    while st_b.len() > 0 {
        var top: i64 = st_b.len() - 1;
        var cur: i64 = st_b.get(top);
        var next: i64 = st_next.get(top);
        var cur_succs: Vec<i64> = succs.get(cur);
        if next < cur_succs.len() {
            st_next.set(top, next + 1);
            var sx: i64 = cur_succs.get(next);
            if state.get(sx) == 0 {
                state.set(sx, 1);
                st_b.push(sx);
                st_next.push(0);
            } else if state.get(sx) == 1 {
                latches.get(sx).push(cur);
                any_loop = true;
            }
        } else {
            state.set(cur, 2);
            st_b.pop();
            st_next.pop();
        }
    }
    if !any_loop { return false; }
    var plain: Vec<i64> = iro_plain_locals(f);
    // Which block defines each value (-1: a parameter, or none)
    var def_b: Vec<i64> = Vec::new();
    while def_b.len() <= f.next_value { def_b.push(-1); }
    b = 0;
    while b < n {
        var ids2: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids2.len() {
            var id: i64 = ids2.get(k);
            if id >= 0 && id < def_b.len() { def_b.set(id, b); }
            k = k + 1;
        }
        b = b + 1;
    }
    var changed: bool = false;
    var head: i64 = n - 1;
    while head >= 0 {
        if latches.get(head).len() > 0 {
            if iro_licm_loop(f, head, latches.get(head), preds, n, plain, &mut def_b) { changed = true; }
        }
        head = head - 1;
    }
    return changed;
}

fn iro_licm_loop(f: &mut IrFunction, head: i64, lat: Vec<i64>, preds: Vec<Vec<i64>>, n: i64, plain: Vec<i64>, def_b: &mut Vec<i64>) -> bool {
    var body: Vec<i64> = peir_zeros(n);
    body.set(head, 1);
    var work: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < lat.len() {
        work.push(lat.get(i));
        i = i + 1;
    }
    while work.len() > 0 {
        var wb: i64 = work.pop();
        if body.get(wb) == 0 {
            body.set(wb, 1);
            var ps: Vec<i64> = preds.get(wb);
            i = 0;
            while i < ps.len() {
                work.push(ps.get(i));
                i = i + 1;
            }
        }
    }
    // The one block that enters the loop, by a jump to its header
    var pre: i64 = -1;
    var hp: Vec<i64> = preds.get(head);
    i = 0;
    while i < hp.len() {
        if body.get(hp.get(i)) == 0 {
            if pre >= 0 && pre != hp.get(i) { return false; }
            pre = hp.get(i);
        }
        i = i + 1;
    }
    if pre < 0 { return false; }
    var pids: Vec<i64> = f.blocks.get(pre).instructions;
    if pids.len() == 0 { return false; }
    match peir_inst_of(f, pids.get(pids.len() - 1)) {
        Inst::Jump(_) => {}
        _ => { return false; }
    }
    // What the loop writes: the locals it stores, whether it calls anything
    // that could resize a Vec
    var stored: Vec<i64> = peir_zeros(f.next_value + 1);
    var resizes: bool = false;
    var b: i64 = 0;
    while b < n {
        if body.get(b) == 1 {
            var ids: Vec<i64> = f.blocks.get(b).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                match peir_inst_of(f, ids.get(k)) {
                    Inst::Store(p, _, _) => { if p >= 0 && p < stored.len() { stored.set(p, 1); } }
                    Inst::Call(cn, _, _, _) => { if !iro_len_safe_call(cn) { resizes = true; } }
                    Inst::CallPtr(_, _, _, _, _) => { resizes = true; }
                    Inst::DynCall(_, _, _, _, _) => { resizes = true; }
                    _ => {}
                }
                k = k + 1;
            }
        }
        b = b + 1;
    }
    var hoisted: Vec<i64> = Vec::new();
    var round: i64 = 0;
    while round < 4 {
        var moved: bool = false;
        b = 0;
        while b < n {
            if body.get(b) == 1 {
                var blk: BasicBlock = f.blocks.get(b);
                var keep: Vec<i64> = Vec::new();
                var k2: i64 = 0;
                while k2 < blk.instructions.len() {
                    var id: i64 = blk.instructions.get(k2);
                    var inst: Inst = peir_inst_of(f, id);
                    var can: bool = false;
                    match inst {
                        Inst::Load(p, _) => {
                            can = p >= 0 && p < plain.len() && plain.get(p) == 1 && stored.get(p) == 0;
                        }
                        Inst::Call(cn, args, _, _) => {
                            can = (cn == "Vec_len" || cn == "p_vec_len") && !resizes;
                            if can {
                                // its Vec comes from outside the loop
                                var a: i64 = 0;
                                while a < args.len() {
                                    var av: i64 = args.get(a);
                                    if av >= 0 && av < def_b.len() && def_b.get(av) >= 0 && body.get(def_b.get(av)) == 1 { can = false; }
                                    a = a + 1;
                                }
                            }
                        }
                        Inst::BinOp(op, _, _, ty) => {
                            // only what cannot trap: comparisons and bit operations
                            if !ir_type_is_float(ty) {
                                match op {
                                    BinOp::Eq => { can = true; }
                                    BinOp::Neq => { can = true; }
                                    BinOp::Lt => { can = true; }
                                    BinOp::Gt => { can = true; }
                                    BinOp::LtEq => { can = true; }
                                    BinOp::GtEq => { can = true; }
                                    BinOp::BitAnd => { can = true; }
                                    BinOp::BitOr => { can = true; }
                                    BinOp::BitXor => { can = true; }
                                    _ => {}
                                }
                            }
                        }
                        Inst::IntExtend(_, _, _) => { can = true; }
                        Inst::BitCast(_, _, _) => { can = true; }
                        _ => {}
                    }
                    if can {
                        // every operand from outside the loop (or already moved)
                        var ops: Vec<i64> = Vec::new();
                        peir_inst_operands(inst, &mut ops);
                        var o: i64 = 0;
                        while o < ops.len() {
                            var ov: i64 = ops.get(o);
                            if ov >= 0 && ov < def_b.len() && def_b.get(ov) >= 0 && body.get(def_b.get(ov)) == 1 { can = false; }
                            o = o + 1;
                        }
                        match inst {
                            // the loaded local itself is an operand: it is an
                            // alloca, made before the loop
                            _ => {}
                        }
                    }
                    if can {
                        hoisted.push(id);
                        def_b.set(id, pre);
                        moved = true;
                    } else {
                        keep.push(id);
                    }
                    k2 = k2 + 1;
                }
                if keep.len() != blk.instructions.len() {
                    blk.instructions = keep;
                    f.blocks.set(b, blk);
                }
            }
            b = b + 1;
        }
        if !moved { break; }
        round = round + 1;
    }
    if hoisted.len() == 0 { return false; }
    // Into the block before the loop, ahead of its jump
    var pblk: BasicBlock = f.blocks.get(pre);
    var term: i64 = pblk.instructions.pop();
    var h: i64 = 0;
    while h < hoisted.len() {
        pblk.instructions.push(hoisted.get(h));
        h = h + 1;
    }
    pblk.instructions.push(term);
    f.blocks.set(pre, pblk);
    return true;
}

// --- Pass manager (competitive OP4) -----------------------------------------
//
// FID_IROPT_OFF=licm,gvn,... turns passes off by name (inline, fold, dce,
// tailcall, gvn, licm); FID_IROPT_STATS=1 prints how many functions each
// pass changed. Every pass is also off when its constant is false.

fn iro_pass_on(name: str) -> bool {
    var off: str = p_getenv("FID_IROPT_OFF");
    if (off as i64) == 0 || str_len(off) == 0 { return true; }
    return !str_contains("," + off + ",", "," + name + ",");
}

fn iro_stats_on() -> bool {
    var st: str = p_getenv("FID_IROPT_STATS");
    return (st as i64) != 0 && str_len(st) > 0;
}

// --- Shared CFG facts (competitive OP3) -------------------------------------

/// A function's control flow: block id -> index, successors and
/// predecessors by index, reverse postorder of the reachable blocks, and
/// immediate dominators (the entry's is itself; -1 unreachable).
pub struct IroCfg {
    pub n: i64,
    pub index: Vec<i64>,
    pub succs: Vec<Vec<i64>>,
    pub preds: Vec<Vec<i64>>,
    pub rpo: Vec<i64>,
    pub rpo_num: Vec<i64>,
    pub idom: Vec<i64>,
}

pub fn iro_cfg(f: &IrFunction) -> IroCfg {
    var n: i64 = f.blocks.len();
    var max_id: i64 = 0;
    var b: i64 = 0;
    while b < n {
        if f.blocks.get(b).id > max_id { max_id = f.blocks.get(b).id; }
        b = b + 1;
    }
    var index: Vec<i64> = Vec::new();
    while index.len() <= max_id { index.push(-1); }
    b = 0;
    while b < n {
        index.set(f.blocks.get(b).id, b);
        b = b + 1;
    }
    var succs: Vec<Vec<i64>> = Vec::new();
    var preds: Vec<Vec<i64>> = Vec::new();
    b = 0;
    while b < n {
        var s0: Vec<i64> = Vec::new();
        var p0: Vec<i64> = Vec::new();
        succs.push(s0);
        preds.push(p0);
        b = b + 1;
    }
    b = 0;
    while b < n {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        if ids.len() > 0 {
            match peir_inst_of(f, ids.get(ids.len() - 1)) {
                Inst::Jump(t) => { peir_add_edge(&mut succs, &mut preds, index, b, t); }
                Inst::Branch(_, t, e) => {
                    peir_add_edge(&mut succs, &mut preds, index, b, t);
                    if e != t { peir_add_edge(&mut succs, &mut preds, index, b, e); }
                }
                _ => {}
            }
        }
        b = b + 1;
    }
    // Postorder by depth-first search from the entry
    var post: Vec<i64> = Vec::new();
    var rpo_num: Vec<i64> = Vec::new();
    var idom: Vec<i64> = Vec::new();
    b = 0;
    while b < n { rpo_num.push(-1); idom.push(-1); b = b + 1; }
    var rpo: Vec<i64> = Vec::new();
    if n == 0 {
        return IroCfg { n: n, index: index, succs: succs, preds: preds, rpo: rpo, rpo_num: rpo_num, idom: idom };
    }
    var state: Vec<i64> = peir_zeros(n);
    var st_b: Vec<i64> = Vec::new();
    var st_next: Vec<i64> = Vec::new();
    st_b.push(0);
    st_next.push(0);
    state.set(0, 1);
    while st_b.len() > 0 {
        var top: i64 = st_b.len() - 1;
        var cur: i64 = st_b.get(top);
        var next: i64 = st_next.get(top);
        var cs: Vec<i64> = succs.get(cur);
        if next < cs.len() {
            st_next.set(top, next + 1);
            var sx: i64 = cs.get(next);
            if state.get(sx) == 0 {
                state.set(sx, 1);
                st_b.push(sx);
                st_next.push(0);
            }
        } else {
            post.push(cur);
            st_b.pop();
            st_next.pop();
        }
    }
    var k: i64 = post.len() - 1;
    while k >= 0 {
        rpo_num.set(post.get(k), rpo.len());
        rpo.push(post.get(k));
        k = k - 1;
    }
    // Dominators (Cooper, Harvey and Kennedy): iterate in reverse postorder
    idom.set(0, 0);
    var changed: bool = true;
    while changed {
        changed = false;
        var r: i64 = 1;
        while r < rpo.len() {
            var bb: i64 = rpo.get(r);
            var ps: Vec<i64> = preds.get(bb);
            var nd: i64 = -1;
            var pi: i64 = 0;
            while pi < ps.len() {
                var p: i64 = ps.get(pi);
                if idom.get(p) >= 0 {
                    if nd < 0 { nd = p; }
                    else {
                        // intersect
                        var x: i64 = p;
                        var y: i64 = nd;
                        while x != y {
                            while rpo_num.get(x) > rpo_num.get(y) { x = idom.get(x); }
                            while rpo_num.get(y) > rpo_num.get(x) { y = idom.get(y); }
                        }
                        nd = x;
                    }
                }
                pi = pi + 1;
            }
            if nd >= 0 && idom.get(bb) != nd {
                idom.set(bb, nd);
                changed = true;
            }
            r = r + 1;
        }
    }
    return IroCfg { n: n, index: index, succs: succs, preds: preds, rpo: rpo, rpo_num: rpo_num, idom: idom };
}

/// Does block `a` dominate block `b` (indexes)?
pub fn iro_dominates(cfg: &IroCfg, a: i64, b: i64) -> bool {
    if a < 0 || b < 0 || cfg.rpo_num.get(a) < 0 || cfg.rpo_num.get(b) < 0 { return false; }
    var x: i64 = b;
    while true {
        if x == a { return true; }
        var up: i64 = cfg.idom.get(x);
        if up == x || up < 0 { return false; }
        x = up;
    }
    return false;
}

// --- Renaming every operand -------------------------------------------------

fn iro_mm(map: &Vec<i64>, id: i64) -> i64 {
    if id >= 0 && id < map.len() && map.get(id) != 0 { return map.get(id) - 1; }
    return id;
}

fn iro_mm_vec(map: &Vec<i64>, v: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        out.push(iro_mm(map, v.get(i)));
        i = i + 1;
    }
    return out;
}

/// `inst` with every operand renamed through `map` (id -> new id + 1).
/// TryUnwrap and Asm are left as they are: iro_unhandled_uses keeps their
/// operands from being renamed.
fn iro_remap_all(inst: Inst, map: &Vec<i64>) -> Inst {
    match inst {
        Inst::BinOp(op, a, b, t) => { return Inst::BinOp(op, iro_mm(map, a), iro_mm(map, b), t); }
        Inst::UnaryOp(op, a, t) => { return Inst::UnaryOp(op, iro_mm(map, a), t); }
        Inst::Load(p, t) => { return Inst::Load(iro_mm(map, p), t); }
        Inst::Store(p, v, t) => { return Inst::Store(iro_mm(map, p), iro_mm(map, v), t); }
        Inst::StructCopy(d, s0, t) => { return Inst::StructCopy(iro_mm(map, d), iro_mm(map, s0), t); }
        Inst::GetFieldPtr(p, idx, t) => { return Inst::GetFieldPtr(iro_mm(map, p), idx, t); }
        Inst::GetElemPtr(p, i, t) => { return Inst::GetElemPtr(iro_mm(map, p), iro_mm(map, i), t); }
        Inst::Branch(c, t, e) => { return Inst::Branch(iro_mm(map, c), t, e); }
        Inst::Return(rv) => {
            match rv {
                OptValueId::Some(v) => { return Inst::Return(OptValueId::Some(iro_mm(map, v))); }
                OptValueId::None => {}
            }
        }
        Inst::Call(nm, args, t, e) => { return Inst::Call(nm, iro_mm_vec(map, args), t, e); }
        Inst::CallPtr(fp, args, t, e, z) => { return Inst::CallPtr(iro_mm(map, fp), iro_mm_vec(map, args), t, e, z); }
        Inst::DynCall(a1, a2, args, t, e) => { return Inst::DynCall(a1, a2, iro_mm_vec(map, args), t, e); }
        Inst::MakeDyn(v, a1, a2) => { return Inst::MakeDyn(iro_mm(map, v), a1, a2); }
        Inst::BitCast(v, a, b) => { return Inst::BitCast(iro_mm(map, v), a, b); }
        Inst::IntExtend(v, a, b) => { return Inst::IntExtend(iro_mm(map, v), a, b); }
        Inst::IntTrunc(v, a, b) => { return Inst::IntTrunc(iro_mm(map, v), a, b); }
        Inst::IntToFloat(v, a, b) => { return Inst::IntToFloat(iro_mm(map, v), a, b); }
        Inst::FloatToInt(v, a, b) => { return Inst::FloatToInt(iro_mm(map, v), a, b); }
        Inst::Print(v, t) => { return Inst::Print(iro_mm(map, v), t); }
        Inst::PersistLoad(nm, d, t) => { return Inst::PersistLoad(nm, iro_mm(map, d), t); }
        Inst::PersistSave(nm, v) => { return Inst::PersistSave(nm, iro_mm(map, v)); }
        Inst::Backward(l) => { return Inst::Backward(iro_mm(map, l)); }
        _ => {}
    }
    return inst;
}

/// Values a TryUnwrap or Asm reads: never renamed.
fn iro_unhandled_uses(f: &IrFunction) -> Vec<i64> {
    var bad: Vec<i64> = peir_zeros(f.next_value + 1);
    var i: i64 = 0;
    while i < f.insts.len() {
        var inst: Inst = f.insts.get(i).inst;
        var mark: bool = false;
        match inst {
            Inst::TryUnwrap(_, _, _, _) => { mark = true; }
            Inst::Asm(_, _, _, _) => { mark = true; }
            _ => {}
        }
        if mark {
            var ops: Vec<i64> = Vec::new();
            peir_inst_operands(inst, &mut ops);
            var o: i64 = 0;
            while o < ops.len() {
                var v: i64 = ops.get(o);
                if v >= 0 && v < bad.len() { bad.set(v, 1); }
                o = o + 1;
            }
            match inst {
                Inst::TryUnwrap(_, okd, _, _) => { if okd >= 0 && okd < bad.len() { bad.set(okd, 1); } }
                _ => {}
            }
        }
        i = i + 1;
    }
    return bad;
}

/// Rename operands in every instruction of `f`.
fn iro_apply_map(f: &mut IrFunction, map: &Vec<i64>) {
    var i: i64 = 0;
    while i < f.insts.len() {
        var entry: ValueIdInst = f.insts.get(i);
        entry.inst = iro_remap_all(entry.inst, map);
        f.insts.set(i, entry);
        i = i + 1;
    }
}

// --- Global value numbering (competitive OP7) -------------------------------
//
// A pure computation equal to one in a block that dominates it (or earlier
// in its own block) reuses that value. Arithmetic that may panic counts as
// pure here: if the first one panicked, the second is never reached. Loads
// of a local reuse an earlier load in the same block when no store to the
// local comes between. Constants are left alone (the native backend keeps
// a constant used in its own block as an immediate).

const IRO_GVN: bool = true;

fn iro_binop_code(op: BinOp) -> str {
    match op {
        BinOp::Add => { return "a"; }
        BinOp::Sub => { return "s"; }
        BinOp::Mul => { return "m"; }
        BinOp::Div => { return "d"; }
        BinOp::Mod => { return "r"; }
        BinOp::Eq => { return "eq"; }
        BinOp::Neq => { return "ne"; }
        BinOp::Lt => { return "lt"; }
        BinOp::Gt => { return "gt"; }
        BinOp::LtEq => { return "le"; }
        BinOp::GtEq => { return "ge"; }
        BinOp::And => { return "&&"; }
        BinOp::Or => { return "||"; }
        BinOp::BitAnd => { return "&"; }
        BinOp::BitOr => { return "|"; }
        BinOp::BitXor => { return "^"; }
        BinOp::Shl => { return "<<"; }
        BinOp::Shr => { return ">>"; }
    }
    return "?";
}

/// The key of a value-numbered instruction, "" for one that is not.
fn iro_gvn_key(inst: Inst) -> str {
    match inst {
        Inst::BinOp(op, a, b, t) => { return "B" + iro_binop_code(op) + "|" + int_to_str(a) + "|" + int_to_str(b) + "|" + ir_type_to_str(t); }
        Inst::UnaryOp(_, a, t) => {
            var uk: str = "";
            match inst {
                Inst::UnaryOp(uop, _, _) => {
                    match uop {
                        UnaryOp::Neg => { uk = "n"; }
                        UnaryOp::Not => { uk = "!"; }
                        UnaryOp::BitNot => { uk = "~"; }
                    }
                }
                _ => {}
            }
            return "U" + uk + "|" + int_to_str(a) + "|" + ir_type_to_str(t);
        }
        Inst::GetFieldPtr(p, idx, t) => { return "F|" + int_to_str(p) + "|" + int_to_str(idx) + "|" + ir_type_to_str(t); }
        Inst::GetElemPtr(p, i, t) => { return "E|" + int_to_str(p) + "|" + int_to_str(i) + "|" + ir_type_to_str(t); }
        Inst::IntExtend(v, a, b) => { return "X|" + int_to_str(v) + "|" + ir_type_to_str(a) + "|" + ir_type_to_str(b); }
        Inst::IntTrunc(v, a, b) => { return "T|" + int_to_str(v) + "|" + ir_type_to_str(a) + "|" + ir_type_to_str(b); }
        Inst::BitCast(v, a, b) => { return "C|" + int_to_str(v) + "|" + ir_type_to_str(a) + "|" + ir_type_to_str(b); }
        _ => {}
    }
    return "";
}

fn iro_gvn(f: &mut IrFunction) -> bool {
    if f.blocks.len() == 0 { return false; }
    var cfg: IroCfg = iro_cfg(f);
    var bad: Vec<i64> = iro_unhandled_uses(f);
    var plain: Vec<i64> = iro_plain_locals(f);
    var map: Vec<i64> = peir_zeros(f.next_value + 1);
    var dead: Vec<i64> = peir_zeros(f.next_value + 1);
    var heads: HashMap<str, i64> = HashMap::new();
    var e_id: Vec<i64> = Vec::new();
    var e_blk: Vec<i64> = Vec::new();
    var e_next: Vec<i64> = Vec::new();
    var any: bool = false;
    var r: i64 = 0;
    while r < cfg.rpo.len() {
        var b: i64 = cfg.rpo.get(r);
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        // loads of locals in this block: local -> load id + 1
        var lastload: Vec<i64> = peir_zeros(f.next_value + 1);
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < map.len() {
                var inst: Inst = iro_remap_all(peir_inst_of(f, id), &map);
                match inst {
                    Inst::Store(sp, _, _) => { if sp >= 0 && sp < lastload.len() { lastload.set(sp, 0); } }
                    Inst::Load(lp, _) => {
                        if lp >= 0 && lp < plain.len() && plain.get(lp) == 1 && bad.get(id) == 0 {
                            if lastload.get(lp) != 0 {
                                map.set(id, lastload.get(lp));
                                dead.set(id, 1);
                                any = true;
                            } else {
                                lastload.set(lp, id + 1);
                            }
                        }
                    }
                    _ => {}
                }
                var key: str = iro_gvn_key(inst);
                if str_len(key) > 0 && bad.get(id) == 0 {
                    var found: i64 = -1;
                    if heads.contains(key) {
                        var e: i64 = heads.get(key);
                        while e >= 0 && found < 0 {
                            if iro_dominates(&cfg, e_blk.get(e), b) { found = e_id.get(e); }
                            e = e_next.get(e);
                        }
                    }
                    if found >= 0 {
                        map.set(id, found + 1);
                        dead.set(id, 1);
                        any = true;
                    } else {
                        var prev: i64 = -1;
                        if heads.contains(key) { prev = heads.get(key); }
                        e_id.push(id);
                        e_blk.push(b);
                        e_next.push(prev);
                        heads.insert(key, e_id.len() - 1);
                    }
                }
            }
            k = k + 1;
        }
        r = r + 1;
    }
    if !any { return false; }
    // chains: a replacement that was itself replaced
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i) != 0 {
            var t: i64 = map.get(i) - 1;
            var steps: i64 = 0;
            while t >= 0 && t < map.len() && map.get(t) != 0 && steps < 64 { t = map.get(t) - 1; steps = steps + 1; }
            map.set(i, t + 1);
        }
        i = i + 1;
    }
    iro_apply_map(f, &map);
    var b2: i64 = 0;
    while b2 < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b2);
        var keep: Vec<i64> = Vec::new();
        var j: i64 = 0;
        while j < blk.instructions.len() {
            var id2: i64 = blk.instructions.get(j);
            if !(id2 >= 0 && id2 < dead.len() && dead.get(id2) == 1) { keep.push(id2); }
            j = j + 1;
        }
        if keep.len() != blk.instructions.len() {
            blk.instructions = keep;
            f.blocks.set(b2, blk);
        }
        b2 = b2 + 1;
    }
    return true;
}

// --- Tail calls into loops (competitive OP13) -------------------------------
//
// `return f(args)` in f itself becomes: store the arguments into the
// parameters' slots, jump to the start. The parameters move into locals a
// new entry block sets up (the native backend keeps them in registers).

const IRO_TAILCALL: bool = true;

fn iro_tailcalls(f: &mut IrFunction) -> bool {
    var n: i64 = f.blocks.len();
    if n == 0 || f.is_interrupt { return false; }
    var np: i64 = f.params.len();
    // uses of each value
    var uses: Vec<i64> = peir_zeros(f.next_value + 1);
    var b: i64 = 0;
    while b < n {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var ops: Vec<i64> = Vec::new();
            peir_inst_operands(peir_inst_of(f, ids.get(k)), &mut ops);
            var o: i64 = 0;
            while o < ops.len() {
                var v: i64 = ops.get(o);
                if v >= 0 && v < uses.len() { uses.set(v, uses.get(v) + 1); }
                o = o + 1;
            }
            k = k + 1;
        }
        b = b + 1;
    }
    // the sites: a call of f itself whose only use is the Return after it
    var site_blocks: Vec<i64> = Vec::new();
    b = 0;
    while b < n {
        var ids2: Vec<i64> = f.blocks.get(b).instructions;
        if ids2.len() >= 2 {
            var cid: i64 = ids2.get(ids2.len() - 2);
            match peir_inst_of(f, ids2.get(ids2.len() - 1)) {
                Inst::Return(rv) => {
                    match rv {
                        OptValueId::Some(rvid) => {
                            if rvid == cid && cid >= 0 && cid < uses.len() && uses.get(cid) == 1 {
                                match peir_inst_of(f, cid) {
                                    Inst::Call(cn, cargs, _, _) => {
                                        if cn == f.name && cargs.len() == np { site_blocks.push(f.blocks.get(b).id); }
                                    }
                                    _ => {}
                                }
                            }
                        }
                        OptValueId::None => {}
                    }
                }
                _ => {}
            }
        }
        b = b + 1;
    }
    if site_blocks.len() == 0 { return false; }
    var bad: Vec<i64> = iro_unhandled_uses(f);
    var pi: i64 = 0;
    while pi < np {
        var pid: i64 = f.params.get(pi).id;
        if pid >= 0 && pid < bad.len() && bad.get(pid) == 1 { return false; }
        if !iro_is_scalar(f.params.get(pi).ty) && !ir_type_eq(f.params.get(pi).ty, IrType::I64) {
            match f.params.get(pi).ty {
                IrType::Ptr(_) => {}
                IrType::Opaque(_) => {}
                IrType::Generic(_, _) => {}
                _ => { return false; }
            }
        }
        pi = pi + 1;
    }
    var old_entry: i64 = f.blocks.get(0).id;
    // A new entry block: a slot per parameter, set from it
    var new_id: i64 = IrFunction_new_block(f);
    var nb: BasicBlock = f.blocks.pop();
    f.blocks.insert(0, nb);
    f.entry = new_id;
    f.current_block_idx = 0;
    var slots: Vec<i64> = Vec::new();
    pi = 0;
    while pi < np {
        var prm: ValueIdType = f.params.get(pi);
        var a: i64 = IrFunction_emit(f, Inst::Alloca(prm.ty, Region::Stack));
        IrFunction_emit(f, Inst::Store(a, prm.id, OptIrType::None));
        slots.push(a);
        pi = pi + 1;
    }
    IrFunction_emit(f, Inst::Jump(old_entry));
    // Every other read of a parameter reads its slot
    var pmap: Vec<i64> = peir_zeros(f.next_value + 1);
    var pslot: Vec<i64> = peir_zeros(f.next_value + 1);
    pi = 0;
    while pi < np {
        var pid2: i64 = f.params.get(pi).id;
        if pid2 >= 0 && pid2 < pslot.len() { pslot.set(pid2, pi + 1); }
        pi = pi + 1;
    }
    var bb: i64 = 1;
    while bb < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(bb);
        var nl: Vec<i64> = Vec::new();
        var k2: i64 = 0;
        while k2 < blk.instructions.len() {
            var id: i64 = blk.instructions.get(k2);
            var inst: Inst = peir_inst_of(f, id);
            var ops2: Vec<i64> = Vec::new();
            peir_inst_operands(inst, &mut ops2);
            var touched: Vec<i64> = Vec::new();
            var o2: i64 = 0;
            while o2 < ops2.len() {
                var pv: i64 = ops2.get(o2);
                if pv >= 0 && pv < pslot.len() && pslot.get(pv) != 0 && pmap.get(pv) == 0 {
                    var si: i64 = pslot.get(pv) - 1;
                    f.current_block_idx = 0;
                    var ld: i64 = iro_detached(f, Inst::Load(slots.get(si), f.params.get(si).ty));
                    nl.push(ld);
                    pmap.set(pv, ld + 1);
                    touched.push(pv);
                }
                o2 = o2 + 1;
            }
            if touched.len() > 0 {
                IrFunction_set_inst(f, id, iro_remap_all(inst, &pmap));
                var t: i64 = 0;
                while t < touched.len() {
                    pmap.set(touched.get(t), 0);
                    t = t + 1;
                }
            }
            nl.push(id);
            k2 = k2 + 1;
        }
        blk.instructions = nl;
        f.blocks.set(bb, blk);
        bb = bb + 1;
    }
    // The sites: arguments into the slots, a jump to the start
    bb = 1;
    while bb < f.blocks.len() {
        var blk2: BasicBlock = f.blocks.get(bb);
        if peir_has_id(site_blocks, blk2.id) {
            var ret: i64 = blk2.instructions.pop();
            var call: i64 = blk2.instructions.pop();
            match peir_inst_of(f, call) {
                Inst::Call(_, cargs2, _, _) => {
                    var ai: i64 = 0;
                    while ai < cargs2.len() {
                        f.current_block_idx = 0;
                        var st: i64 = iro_detached(f, Inst::Store(slots.get(ai), cargs2.get(ai), OptIrType::None));
                        blk2.instructions.push(st);
                        ai = ai + 1;
                    }
                }
                _ => {}
            }
            f.current_block_idx = 0;
            var jmp: i64 = iro_detached(f, Inst::Jump(old_entry));
            blk2.instructions.push(jmp);
            IrFunction_set_inst(f, call, Inst::ConstInt(0, IrType::I64));
            IrFunction_set_inst(f, ret, Inst::ConstInt(0, IrType::I64));
            f.blocks.set(bb, blk2);
        }
        bb = bb + 1;
    }
    f.current_block_idx = 0;
    return true;
}

fn peir_has_id(v: Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x { return true; }
        i = i + 1;
    }
    return false;
}

// --- The mid-end (llvm-roadmap Track ME) -----------------------------------

/// Instructions in the blocks of `f` (ME30's measure).
fn iro_count_insts(f: &IrFunction) -> i64 {
    var n: i64 = 0;
    var b: i64 = 0;
    while b < f.blocks.len() {
        n = n + f.blocks.get(b).instructions.len();
        b = b + 1;
    }
    return n;
}

/// ME1: the use lists of a function. `count` is how many operands read
/// each value, `users` the instructions that read it, `block_of` the block
/// (index) each instruction is in, `pos_of` its place there (-1: in none).
/// Built in one pass over the blocks; a pass that changes instructions
/// rebuilds it (iro_uses) or keeps it current with iro_uses_drop.
pub struct IroUses {
    pub count: Vec<i64>,
    pub users: Vec<Vec<i64>>,
    pub block_of: Vec<i64>,
    pub pos_of: Vec<i64>,
}

pub fn iro_uses(f: &IrFunction) -> IroUses {
    var n: i64 = f.next_value + 1;
    var u: IroUses = IroUses { count: peir_zeros(n), users: Vec::new(), block_of: Vec::new(), pos_of: Vec::new() };
    var z: i64 = 0;
    while z < n {
        u.users.push(Vec::new());
        u.block_of.push(-1);
        u.pos_of.push(-1);
        z = z + 1;
    }
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < n {
                u.block_of.set(id, b);
                u.pos_of.set(id, k);
            }
            var ops: Vec<i64> = Vec::new();
            peir_inst_operands(peir_inst_of(f, id), &mut ops);
            var o: i64 = 0;
            while o < ops.len() {
                var v: i64 = ops.get(o);
                if v >= 0 && v < n {
                    u.count.set(v, u.count.get(v) + 1);
                    var us: Vec<i64> = u.users.get(v);
                    us.push(id);
                    u.users.set(v, us);
                }
                o = o + 1;
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return u;
}

/// Instruction `id` no longer reads its operands (it is removed or replaced).
fn iro_uses_drop(u: &mut IroUses, f: &IrFunction, id: i64) {
    var ops: Vec<i64> = Vec::new();
    peir_inst_operands(peir_inst_of(f, id), &mut ops);
    var o: i64 = 0;
    while o < ops.len() {
        var v: i64 = ops.get(o);
        if v >= 0 && v < u.count.len() && u.count.get(v) > 0 { u.count.set(v, u.count.get(v) - 1); }
        o = o + 1;
    }
}

/// The block index whose id is `bid`, or -1.
fn iro_block_index(f: &IrFunction, bid: i64) -> i64 {
    var b: i64 = 0;
    while b < f.blocks.len() {
        if f.blocks.get(b).id == bid { return b; }
        b = b + 1;
    }
    return -1;
}

/// `id` without the predecessor `from` (an edge from it is gone).
fn iro_drop_pred(f: &mut IrFunction, bid: i64, from: i64) {
    var bi: i64 = iro_block_index(f, bid);
    if bi < 0 { return; }
    var blk: BasicBlock = f.blocks.get(bi);
    var keep: Vec<i64> = Vec::new();
    var dropped: bool = false;
    var k: i64 = 0;
    while k < blk.predecessors.len() {
        if !dropped && blk.predecessors.get(k) == from { dropped = true; } else { keep.push(blk.predecessors.get(k)); }
        k = k + 1;
    }
    if dropped {
        blk.predecessors = keep;
        f.blocks.set(bi, blk);
    }
}

// ME14: a branch whose condition is a constant (after folding and
// inlining), or whose two targets are one block, becomes a jump. The
// block left out loses that predecessor; when nothing reaches it any more
// the backends' unreachable-block handling drops or keeps it as before.
fn iro_branch_fold(f: &mut IrFunction) -> bool {
    var changed: bool = false;
    var b: i64 = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var nk: i64 = blk.instructions.len();
        if nk > 0 {
            var tid: i64 = blk.instructions.get(nk - 1);
            match peir_inst_of(f, tid) {
                Inst::Branch(c, t, e) => {
                    var to: i64 = -1;
                    var gone: i64 = -1;
                    if t == e {
                        to = t;
                    } else {
                        match peir_inst_of(f, c) {
                            Inst::ConstBool(v) => {
                                if v { to = t; gone = e; } else { to = e; gone = t; }
                            }
                            _ => {}
                        }
                    }
                    if to >= 0 {
                        IrFunction_set_inst(f, tid, Inst::Jump(to));
                        if gone >= 0 { iro_drop_pred(f, gone, blk.id); }
                        changed = true;
                    }
                }
                _ => {}
            }
        }
        b = b + 1;
    }
    if changed { iro_drop_unreachable(f); }
    return changed;
}

/// Remove the blocks no jump or branch from the entry reaches any more
/// (a folded branch's other side), so no pass or backend sees code that
/// uses values from blocks that no longer dominate it.
fn iro_drop_unreachable(f: &mut IrFunction) {
    var cfg: IroCfg = iro_cfg(f);
    if cfg.n == 0 { return; }
    var keep_blocks: Vec<BasicBlock> = Vec::new();
    var gone: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < cfg.n {
        if b == 0 || cfg.rpo_num.get(b) >= 0 {
            keep_blocks.push(f.blocks.get(b));
        } else {
            gone.push(f.blocks.get(b).id);
        }
        b = b + 1;
    }
    if gone.len() == 0 { return; }
    // their edges into the blocks that stay
    b = 0;
    while b < keep_blocks.len() {
        var blk: BasicBlock = keep_blocks.get(b);
        var ps: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < blk.predecessors.len() {
            if !peir_has_id(gone, blk.predecessors.get(k)) { ps.push(blk.predecessors.get(k)); }
            k = k + 1;
        }
        blk.predecessors = ps;
        keep_blocks.set(b, blk);
        b = b + 1;
    }
    f.blocks = keep_blocks;
    if f.current_block_idx >= f.blocks.len() { f.current_block_idx = f.blocks.len() - 1; }
}

// ME13: a branch's condition is a fact inside the edge's region: on the
// `then` side it is true, on the `else` side false — when the target's
// only way in is this edge, so every block the target dominates inherits
// it. A comparison `a < b` there also settles the other comparisons of
// the same operands (and swapped), and a condition `!a` settles `a`.

/// The relation a comparison allows, as a 3-bit mask {lt=1, eq=2, gt=4}.
fn iro_cmp_mask(op: BinOp) -> i64 {
    if binop_eq(op, BinOp::Lt) { return 1; }
    if binop_eq(op, BinOp::Eq) { return 2; }
    if binop_eq(op, BinOp::Gt) { return 4; }
    if binop_eq(op, BinOp::LtEq) { return 3; }
    if binop_eq(op, BinOp::Neq) { return 5; }
    if binop_eq(op, BinOp::GtEq) { return 6; }
    return 0;
}

/// lt <-> gt in a mask.
fn iro_cmp_mirror(m: i64) -> i64 {
    return ((m & 1) * 4) + (m & 2) + ((m & 4) / 4);
}

/// With the real relation known inside `possible` (a mask), what an
/// instruction's comparison must be: 1, 0, or -1 when unsettled.
fn iro_cmp_implied(possible: i64, inst_mask: i64) -> i64 {
    if inst_mask == 0 { return -1; }
    if (possible & inst_mask) == possible { return 1; }
    if (possible & inst_mask) == 0 { return 0; }
    return -1;
}

/// A ConstBool `v` at the head of block `bi`; its id.
fn iro_bool_before(f: &mut IrFunction, bi: i64, v: bool) -> i64 {
    var cid: i64 = iro_detached(f, Inst::ConstBool(v));
    var blk: BasicBlock = f.blocks.get(bi);
    var ids: Vec<i64> = Vec::new();
    ids.push(cid);
    var k: i64 = 0;
    while k < blk.instructions.len() {
        ids.push(blk.instructions.get(k));
        k = k + 1;
    }
    blk.instructions = ids;
    f.blocks.set(bi, blk);
    return cid;
}

/// Rewrite every use of `v` in blocks dominated by `dom` to `cid`
/// (`map` has `v` -> `cid` + 1 only). Use lists `u` find the candidates.
fn iro_rewrite_uses(f: &mut IrFunction, u: &IroUses, cfg: &IroCfg, v: i64, dom: i64, map: &Vec<i64>) -> bool {
    var changed: bool = false;
    if v < 0 || v >= u.users.len() { return false; }
    var us: Vec<i64> = u.users.get(v);
    var i: i64 = 0;
    while i < us.len() {
        var uid: i64 = us.get(i);
        var ub: i64 = u.block_of.get(uid);
        if ub == dom || (ub >= 0 && iro_dominates(cfg, dom, ub)) {
            IrFunction_set_inst(f, uid, iro_remap_all(peir_inst_of(f, uid), map));
            changed = true;
        }
        i = i + 1;
    }
    return changed;
}

fn iro_branch_facts(f: &mut IrFunction) -> bool {
    if f.blocks.len() == 0 { return false; }
    var cfg: IroCfg = iro_cfg(f);
    var u: IroUses = iro_uses(f);
    var changed: bool = false;
    // remap buffers live outside the block loop: allocating one per branch
    // OOMs on large functions
    var mp: Vec<i64> = peir_zeros(f.next_value + 1);
    var mp2: Vec<i64> = peir_zeros(f.next_value + 1);
    var b: i64 = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var nk: i64 = blk.instructions.len();
        if nk > 0 {
            var tid: i64 = blk.instructions.get(nk - 1);
            match peir_inst_of(f, tid) {
                Inst::Branch(c, t1, t2) => {
                    if t1 != t2 {
                        // what the condition says about its operands
                        var cmask: i64 = 0;
                        var cx: i64 = -1;
                        var cy: i64 = -1;
                        var notof: i64 = -1;
                        match peir_inst_of(f, c) {
                            Inst::BinOp(cop, lx, ly, _) => {
                                cmask = iro_cmp_mask(cop);
                                cx = lx;
                                cy = ly;
                            }
                            Inst::UnaryOp(uop, a0, _) => {
                                match uop {
                                    UnaryOp::Not => { notof = a0; }
                                    _ => {}
                                }
                            }
                            _ => {}
                        }
                        var side: i64 = 0;
                        while side < 2 {
                            var tgt: i64 = t1;
                            var truth: bool = true;
                            if side == 1 { tgt = t2; truth = false; }
                            var ti: i64 = -1;
                            if tgt >= 0 && tgt < cfg.index.len() { ti = cfg.index.get(tgt); }
                            if ti >= 0 {
                                var ps: Vec<i64> = cfg.preds.get(ti);
                                var sole: bool = ps.len() == 1 && ps.get(0) == b;
                                if sole {
                                    var possible: i64 = cmask;
                                    if !truth { possible = 7 - cmask; }
                                    var cid: i64 = -1;
                                    var i2: i64 = 0;
                                    while i2 < f.blocks.len() {
                                        if i2 == ti || iro_dominates(&cfg, ti, i2) {
                                            var db: BasicBlock = f.blocks.get(i2);
                                            var k2: i64 = 0;
                                            while k2 < db.instructions.len() {
                                                var uid: i64 = db.instructions.get(k2);
                                                var ui: Inst = peir_inst_of(f, uid);
                                                // a comparison of the same
                                                // operands is settled too
                                                match ui {
                                                    Inst::BinOp(iop, il, ir, _) => {
                                                        if cmask != 0 && iop_is_cmp(iop) {
                                                            var m: i64 = -1;
                                                            if il == cx && ir == cy { m = iro_cmp_implied(possible, iro_cmp_mask(iop)); }
                                                            else if il == cy && ir == cx { m = iro_cmp_implied(possible, iro_cmp_mirror(iro_cmp_mask(iop))); }
                                                            if m >= 0 {
                                                                IrFunction_set_inst(f, uid, Inst::ConstBool(m == 1));
                                                                changed = true;
                                                            }
                                                        }
                                                    }
                                                    _ => {}
                                                }
                                                // and c itself is `val` here
                                                var uses_c: bool = false;
                                                var ops2: Vec<i64> = Vec::new();
                                                peir_inst_operands(ui, &mut ops2);
                                                var o2: i64 = 0;
                                                while o2 < ops2.len() {
                                                    if ops2.get(o2) == c { uses_c = true; }
                                                    o2 = o2 + 1;
                                                }
                                                if uses_c {
                                                    if cid < 0 { cid = iro_bool_before(f, ti, truth); mp.set(c, cid + 1); }
                                                    IrFunction_set_inst(f, uid, iro_remap_all(ui, &mp));
                                                    changed = true;
                                                }
                                                k2 = k2 + 1;
                                            }
                                        }
                                        i2 = i2 + 1;
                                    }
                                    if c >= 0 && c < mp.len() { mp.set(c, 0); }
                                    // c = !a: the operand is `!val` here
                                    if notof >= 0 && notof < u.users.len() {
                                        var us3: Vec<i64> = u.users.get(notof);
                                        var ui3: i64 = 0;
                                        while ui3 < us3.len() {
                                            var uid3: i64 = us3.get(ui3);
                                            var ub3: i64 = u.block_of.get(uid3);
                                            if ub3 == ti || (ub3 >= 0 && iro_dominates(&cfg, ti, ub3)) {
                                                var cid2: i64 = iro_bool_before(f, ti, !truth);
                                                mp2.set(notof, cid2 + 1);
                                                IrFunction_set_inst(f, uid3, iro_remap_all(peir_inst_of(f, uid3), &mp2));
                                                mp2.set(notof, 0);
                                                changed = true;
                                            }
                                            ui3 = ui3 + 1;
                                        }
                                    }
                                }
                            }
                            side = side + 1;
                        }
                    }
                }
                _ => {}
            }
        }
        b = b + 1;
    }
    if changed { iro_branch_fold(f); iro_dce_more(f); }
    return changed;
}

/// `op` orders two values (not And/Or on booleans, not arithmetic).
fn iop_is_cmp(op: BinOp) -> bool {
    return binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt)
        || binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::GtEq);
}

// ME14: sparse conditional constant propagation. Every value has a single
// definition (verifier-checked), so each lattice cell is evaluated once:
// blocks are visited in reverse postorder restricted to feasible edges —
// a block's operands are always defined in dominators that ran first.
// Lattice: 0 top (not evaluated), 1 constant (lat_v), 2 varying.
// Const-valued instructions become ConstInt/ConstBool; a branch on a
// constant loses the dead edge; unreachable blocks are dropped after.

fn iro_sccp_eval(op: BinOp, a: i64, b: i64, out: &mut Vec<i64>) {
    // out: [tag, value]; tag 1 const, 2 varying (a fold that would panic
    // is varying, not a constant — the runtime raises the panic).
    var r: i64 = 0;
    var tag: i64 = 2;
    var ok: bool = false;
    var i64min: i64 = 0 - 9223372036854775807 - 1;
    if binop_eq(op, BinOp::Add) {
        r = a + b;
        if !((a > 0 && b > 0 && r <= 0) || (a < 0 && b < 0 && r >= 0)) { ok = true; }
    } else if binop_eq(op, BinOp::Sub) {
        r = a - b;
        if !((b < 0 && a >= 0 && r < 0) || (b > 0 && a <= 0 && r > 0)) { ok = true; }
    } else if binop_eq(op, BinOp::Mul) {
        r = a * b;
        var ov: bool = false;
        if a == i64min && b == 0 - 1 { ov = true; }
        else if a != 0 && r / a != b { ov = true; }
        if !ov { ok = true; }
    } else if binop_eq(op, BinOp::Div) {
        if b != 0 && !(a == i64min && b == 0 - 1) { r = a / b; ok = true; }
    } else if binop_eq(op, BinOp::Mod) {
        if b != 0 && !(a == i64min && b == 0 - 1) { r = a % b; ok = true; }
    } else if binop_eq(op, BinOp::Shl) {
        if b >= 0 && b < 64 { r = a << b; ok = true; }
    } else if binop_eq(op, BinOp::Shr) {
        if b >= 0 && b < 64 { r = a >> b; ok = true; }
    } else if binop_eq(op, BinOp::BitAnd) { r = a & b; ok = true; }
    else if binop_eq(op, BinOp::BitOr) { r = a | b; ok = true; }
    else if binop_eq(op, BinOp::BitXor) { r = a ^ b; ok = true; }
    else if binop_eq(op, BinOp::And) { if a != 0 && b != 0 { r = 1; } ok = true; }
    else if binop_eq(op, BinOp::Or) { if a != 0 || b != 0 { r = 1; } ok = true; }
    else if binop_eq(op, BinOp::Eq) { if a == b { r = 1; } ok = true; }
    else if binop_eq(op, BinOp::Neq) { if a != b { r = 1; } ok = true; }
    else if binop_eq(op, BinOp::Lt) { if a < b { r = 1; } ok = true; }
    else if binop_eq(op, BinOp::Gt) { if a > b { r = 1; } ok = true; }
    else if binop_eq(op, BinOp::LtEq) { if a <= b { r = 1; } ok = true; }
    else if binop_eq(op, BinOp::GtEq) { if a >= b { r = 1; } ok = true; }
    if ok { tag = 1; }
    out.push(tag); out.push(r);
}

/// Bits kept by an IntTrunc/IntExtend into `to`, with `to`'s sign.
fn iro_eval_narrow(v: i64, to: IrType) -> i64 {
    var bits: i64 = ir_type_size(to) * 8;
    if bits >= 64 { return v; }
    var mask: i64 = (1 << bits) - 1;
    var r: i64 = v & mask;
    var top: i64 = 1 << (bits - 1);
    if !iro_unsigned(to) && (r & top) != 0 { r = r - (1 << bits); }
    return r;
}

fn iro_sccp(f: &mut IrFunction) -> bool {
    var cfg: IroCfg = iro_cfg(f);
    if cfg.n == 0 { return false; }
    var n: i64 = f.next_value + 1;
    var lat_t: Vec<i64> = peir_zeros(n);   // 0 top, 1 const, 2 varying
    var lat_v: Vec<i64> = peir_zeros(n);
    var live: Vec<i64> = peir_zeros(cfg.n);
    var entry_b: i64 = -1;
    var e: i64 = 0;
    while e < f.blocks.len() {
        if f.blocks.get(e).id == f.entry { entry_b = e; break; }
        e = e + 1;
    }
    if entry_b < 0 { entry_b = 0; }
    live.set(entry_b, 1);
    var changed: bool = false;
    var ri: i64 = 0;
    while ri < cfg.rpo.len() {
        var bi: i64 = cfg.rpo.get(ri);
        if live.get(bi) == 0 { ri = ri + 1; continue; }
        var blk: BasicBlock = f.blocks.get(bi);
        var k: i64 = 0;
        while k < blk.instructions.len() {
            var id: i64 = blk.instructions.get(k);
            if id >= 0 && id < n && lat_t.get(id) == 0 {
                var tag: i64 = 2;
                var cval: i64 = 0;
                match peir_inst_of(f, id) {
                    Inst::ConstInt(v, _) => { tag = 1; cval = v; }
                    Inst::ConstBool(v) => { tag = 1; if v { cval = 1; } }
                    Inst::ConstNull(_) => { tag = 1; cval = 0; }
                    Inst::BinOp(op, a, bb, t) => {
                        if iro_int_ty(t) && a >= 0 && a < n && bb >= 0 && bb < n
                            && lat_t.get(a) == 1 && lat_t.get(bb) == 1 {
                            var ev: Vec<i64> = Vec::new();
                            iro_sccp_eval(op, lat_v.get(a), lat_v.get(bb), &mut ev);
                            tag = ev.get(0); cval = ev.get(1);
                        }
                    }
                    Inst::UnaryOp(uop, a, t) => {
                        if iro_int_ty(t) && a >= 0 && a < n && lat_t.get(a) == 1 {
                            var av: i64 = lat_v.get(a);
                            match uop {
                                UnaryOp::Neg => {
                                    if av == 0 - 9223372036854775807 - 1 { tag = 2; }
                                    else { tag = 1; cval = 0 - av; }
                                }
                                UnaryOp::BitNot => { tag = 1; cval = 0 - av - 1; }
                                UnaryOp::Not => { tag = 1; if av == 0 { cval = 1; } }
                                _ => {}
                            }
                        }
                    }
                    Inst::IntExtend(a, _, tt) => {
                        if iro_int_ty(tt) && a >= 0 && a < n && lat_t.get(a) == 1 {
                            tag = 1; cval = iro_eval_narrow(lat_v.get(a), tt);
                        }
                    }
                    Inst::IntTrunc(a, _, tt) => {
                        if iro_int_ty(tt) && a >= 0 && a < n && lat_t.get(a) == 1 {
                            tag = 1; cval = iro_eval_narrow(lat_v.get(a), tt);
                        }
                    }
                    Inst::BitCast(a, _, tt) => {
                        if iro_int_ty(tt) && a >= 0 && a < n && lat_t.get(a) == 1 {
                            tag = 1; cval = lat_v.get(a);
                        }
                    }
                    _ => {}
                }
                lat_t.set(id, tag);
                lat_v.set(id, cval);
            }
            k = k + 1;
        }
        if blk.instructions.len() > 0 {
            var last: i64 = blk.instructions.get(blk.instructions.len() - 1);
            var mark: Vec<i64> = Vec::new();
            match peir_inst_of(f, last) {
                Inst::Jump(t) => { mark.push(t); }
                Inst::Branch(c, t1, t2) => {
                    var is_c: bool = c >= 0 && c < n && lat_t.get(c) == 1;
                    var keep_t: i64 = -1;
                    if is_c {
                        if lat_v.get(c) != 0 { keep_t = t1; } else { keep_t = t2; }
                    }
                    if keep_t >= 0 {
                        IrFunction_set_inst(f, last, Inst::Jump(keep_t));
                        var gone: i64 = t2;
                        if keep_t == t2 { gone = t1; }
                        iro_drop_pred(f, gone, blk.id);
                        mark.push(keep_t);
                        changed = true;
                    } else { mark.push(t1); mark.push(t2); }
                }
                _ => {}
            }
            var mi: i64 = 0;
            while mi < mark.len() {
                var mid: i64 = mark.get(mi);
                var midx: i64 = -1;
                if mid >= 0 && mid < cfg.index.len() { midx = cfg.index.get(mid); }
                if midx >= 0 { live.set(midx, 1); }
                mi = mi + 1;
            }
        }
        ri = ri + 1;
    }
    var ri2: i64 = 0;
    while ri2 < cfg.rpo.len() {
        var bi2: i64 = cfg.rpo.get(ri2);
        if live.get(bi2) != 0 {
            var blk2: BasicBlock = f.blocks.get(bi2);
            var k2: i64 = 0;
            while k2 < blk2.instructions.len() {
                var id2: i64 = blk2.instructions.get(k2);
                if id2 >= 0 && id2 < n && lat_t.get(id2) == 1 {
                    match peir_inst_of(f, id2) {
                        Inst::ConstInt(_, _) => {}
                        Inst::ConstBool(_) => {}
                        Inst::ConstNull(_) => {}
                        Inst::BinOp(op, _, _, t) => {
                            if iop_is_cmp(op) || binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or) {
                                IrFunction_set_inst(f, id2, Inst::ConstBool(lat_v.get(id2) != 0));
                            } else {
                                IrFunction_set_inst(f, id2, Inst::ConstInt(lat_v.get(id2), t));
                            }
                            changed = true;
                        }
                        Inst::UnaryOp(uop, _, t) => {
                            var isbool: bool = false;
                            match uop { UnaryOp::Not => { isbool = true; } _ => {} }
                            if isbool {
                                IrFunction_set_inst(f, id2, Inst::ConstBool(lat_v.get(id2) != 0));
                            } else {
                                IrFunction_set_inst(f, id2, Inst::ConstInt(lat_v.get(id2), t));
                            }
                            changed = true;
                        }
                        Inst::IntExtend(_, _, t) => {
                            if iro_int_ty(t) { IrFunction_set_inst(f, id2, Inst::ConstInt(lat_v.get(id2), t)); changed = true; }
                        }
                        Inst::IntTrunc(_, _, t) => {
                            if iro_int_ty(t) { IrFunction_set_inst(f, id2, Inst::ConstInt(lat_v.get(id2), t)); changed = true; }
                        }
                        Inst::BitCast(_, _, t) => {
                            if iro_int_ty(t) { IrFunction_set_inst(f, id2, Inst::ConstInt(lat_v.get(id2), t)); changed = true; }
                        }
                        _ => {}
                    }
                }
                k2 = k2 + 1;
            }
        }
        ri2 = ri2 + 1;
    }
    if changed { iro_drop_unreachable(f); }
    return changed;
}

// ME15: dead stores. A local whose address goes nowhere but loads and
// stores (iro_plain_locals), that the backend does not read by itself
// (drops, @zeroize, @persist), and that is never loaded: every store to it
// is dead.
// stores (iro_plain_locals), that the backend does not read by itself
// (drops, @zeroize, @persist), and that is never loaded: every store to it
// is dead. In a block, a store followed by another store to the same such
// local with no load of it in between is dead too (no other code can read
// the local; what a panic between them would skip is never seen, since
// nothing unwinds). The stored values stay: only the stores go.

fn iro_backend_reads(f: &IrFunction, loc: i64) -> bool {
    var i: i64 = 0;
    while i < f.drop_locals.len() {
        if f.drop_locals.get(i).id == loc { return true; }
        i = i + 1;
    }
    i = 0;
    while i < f.zeroize_locals.len() {
        if f.zeroize_locals.get(i).id == loc { return true; }
        i = i + 1;
    }
    i = 0;
    while i < f.persist_vars.len() {
        if f.persist_vars.get(i).id == loc { return true; }
        i = i + 1;
    }
    return false;
}

/// Does `inst` leave the middle of its block (a stored value may then be
/// read elsewhere)?
fn iro_dse_barrier(inst: Inst) -> bool {
    match inst {
        Inst::TryUnwrap(_, _, _, _) => { return true; }
        Inst::Asm(_, _, _, _) => { return true; }
        Inst::PersistLoad(_, _, _) => { return true; }
        Inst::PersistSave(_, _) => { return true; }
        _ => { return false; }
    }
}

fn iro_dse(f: &mut IrFunction) -> bool {
    var plain: Vec<i64> = iro_plain_locals(f);
    var n: i64 = plain.len();
    // the plain locals that are read at all
    var loaded: Vec<i64> = peir_zeros(n);
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            match peir_inst_of(f, ids.get(k)) {
                Inst::Load(p, _) => { if p >= 0 && p < n { loaded.set(p, 1); } }
                _ => {}
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var changed: bool = false;
    b = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var dead: Vec<i64> = peir_zeros(blk.instructions.len());
        // the last store to each local in this block not read since (index + 1)
        var pending: i64 = HashMap_new();
        var any: bool = false;
        var k: i64 = 0;
        while k < blk.instructions.len() {
            var inst: Inst = peir_inst_of(f, blk.instructions.get(k));
            if iro_dse_barrier(inst) {
                HashMap_clear(pending);
            }
            match inst {
                Inst::Store(p, _, _) => {
                    if p >= 0 && p < n && plain.get(p) == 1 && !iro_backend_reads(f, p) {
                        if loaded.get(p) == 0 {
                            dead.set(k, 1);
                            any = true;
                        } else {
                            var key: str = int_to_str(p);
                            if HashMap_contains(pending, key) {
                                dead.set(HashMap_get(pending, key) - 1, 1);
                                any = true;
                            }
                            HashMap_insert(pending, key, k + 1);
                        }
                    }
                }
                Inst::Load(p2, _) => {
                    if p2 >= 0 && p2 < n { HashMap_remove(pending, int_to_str(p2)); }
                }
                _ => {}
            }
            k = k + 1;
        }
        if any {
            var keep: Vec<i64> = Vec::new();
            k = 0;
            while k < blk.instructions.len() {
                if dead.get(k) == 0 { keep.push(blk.instructions.get(k)); }
                k = k + 1;
            }
            blk.instructions = keep;
            f.blocks.set(b, blk);
            changed = true;
        }
        b = b + 1;
    }
    if changed { iro_dce_more(f); }
    return changed;
}

/// Values DCE may drop beyond iro_pure: ones that cannot panic, read no
/// memory others write and do nothing else (comparisons, bit operations,
/// widening, a load of a plain local). Checked arithmetic is not among
/// them: dropping it would drop its overflow panic.
fn iro_removable(inst: Inst, plain: &Vec<i64>) -> bool {
    if iro_pure(inst) { return true; }
    match inst {
        Inst::BinOp(op, _, _, _) => {
            return binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt)
                || binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::GtEq)
                || binop_eq(op, BinOp::BitAnd) || binop_eq(op, BinOp::BitOr) || binop_eq(op, BinOp::BitXor)
                || binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or);
        }
        Inst::IntExtend(_, _, _) => { return true; }
        Inst::Load(p, _) => { return p >= 0 && p < plain.len() && plain.get(p) == 1; }
        _ => { return false; }
    }
}

/// DCE with iro_removable, until nothing more goes (the values the dead
/// stores stored, the loads and comparisons only they used).
fn iro_dce_more(f: &mut IrFunction) -> bool {
    var plain: Vec<i64> = iro_plain_locals(f);
    var any: bool = false;
    var round: i64 = 0;
    while round < 4 {
        var u: IroUses = iro_uses(f);
        var removed: bool = false;
        var b: i64 = 0;
        while b < f.blocks.len() {
            var blk: BasicBlock = f.blocks.get(b);
            var keep: Vec<i64> = Vec::new();
            var gone: bool = false;
            var k: i64 = 0;
            while k < blk.instructions.len() {
                var id: i64 = blk.instructions.get(k);
                if id >= 0 && id < u.count.len() && u.count.get(id) == 0 && iro_removable(peir_inst_of(f, id), &plain) {
                    gone = true;
                } else {
                    keep.push(id);
                }
                k = k + 1;
            }
            if gone {
                blk.instructions = keep;
                f.blocks.set(b, blk);
                removed = true;
            }
            b = b + 1;
        }
        if !removed { return any; }
        any = true;
        round = round + 1;
    }
    return any;
}

// ME12: algebraic simplification beyond the identities of rules.fd.
//   - (x + c1) + c2 -> x + (c1 + c2), and the same with subtractions, when
//     c1 and c2 move x the same way: the sum overflows exactly when one of
//     the two steps did, so every overflow panic stays (the inner step,
//     read only here, goes)
//   - x * 2^k -> x << k where the multiplication needs no overflow check
//     (checks.fd's flags, or an @wrapping function)
//   - x / 2^k -> x >> k and x % 2^k -> x & (2^k - 1) for x known >= 0 or
//     of an unsigned type (the divisor is not zero: no check is lost)

/// k when c is 2^k (1 <= k <= 62), else -1.
fn iro_log2(c: i64) -> i64 {
    if c < 2 { return -1; }
    var k: i64 = 0;
    var v: i64 = c;
    while v > 1 {
        if (v & 1) != 0 { return -1; }
        v = v >> 1;
        k = k + 1;
    }
    if k > 62 { return -1; }
    return k;
}

fn iro_unsigned(t: IrType) -> bool {
    match t {
        IrType::U8 => { return true; }
        IrType::U16 => { return true; }
        IrType::U32 => { return true; }
        IrType::U64 => { return true; }
        _ => { return false; }
    }
}

/// The signed step `id` adds to its first operand: x + c is c, x - c is -c
/// (OptI64::None when it is not one, or -c would not fit).
fn iro_step(f: &IrFunction, id: i64) -> OptI64 {
    match peir_inst_of(f, id) {
        Inst::BinOp(op, _, r, t) => {
            if !ir_type_eq(t, IrType::I64) { return OptI64::None; }
            match iro_const_int(f, r) {
                OptI64::Some(c) => {
                    if binop_eq(op, BinOp::Add) { return OptI64::Some(c); }
                    if binop_eq(op, BinOp::Sub) && c != 0 - IRO_I64_MAX - 1 { return OptI64::Some(0 - c); }
                }
                OptI64::None => {}
            }
        }
        _ => {}
    }
    return OptI64::None;
}

fn iro_first_operand(f: &IrFunction, id: i64) -> i64 {
    match peir_inst_of(f, id) {
        Inst::BinOp(_, l, _, _) => { return l; }
        _ => { return -1; }
    }
}

/// A constant placed in front of position `pos` of block `bi`.
fn iro_const_before(f: &mut IrFunction, bi: i64, pos: i64, v: i64, t: IrType) -> i64 {
    var cid: i64 = iro_detached(f, Inst::ConstInt(v, t));
    var blk: BasicBlock = f.blocks.get(bi);
    var ids: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < blk.instructions.len() {
        if k == pos { ids.push(cid); }
        ids.push(blk.instructions.get(k));
        k = k + 1;
    }
    if pos >= blk.instructions.len() { ids.push(cid); }
    blk.instructions = ids;
    f.blocks.set(bi, blk);
    return cid;
}

fn iro_remove_from_block(f: &mut IrFunction, id: i64) {
    var b: i64 = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var keep: Vec<i64> = Vec::new();
        var found: bool = false;
        var k: i64 = 0;
        while k < blk.instructions.len() {
            if blk.instructions.get(k) == id { found = true; } else { keep.push(blk.instructions.get(k)); }
            k = k + 1;
        }
        if found {
            blk.instructions = keep;
            f.blocks.set(b, blk);
            return;
        }
        b = b + 1;
    }
}

/// An integer or boolean type: identities never apply to floats
/// (`x * 0` is not 0 for NaN, `x - x` is not 0 for -0.0).
fn iro_int_ty(t: IrType) -> bool {
    match t {
        IrType::I8 => { return true; }
        IrType::I16 => { return true; }
        IrType::I32 => { return true; }
        IrType::I64 => { return true; }
        IrType::U8 => { return true; }
        IrType::U16 => { return true; }
        IrType::U32 => { return true; }
        IrType::U64 => { return true; }
        IrType::Bool => { return true; }
        _ => { return false; }
    }
}

/// `v` renamed through `map` until it maps nowhere (the value an identity
/// leaves behind can itself have been folded).
fn iro_map_final(map: &Vec<i64>, v: i64) -> i64 {
    var x: i64 = v;
    var gi: i64 = 0;
    while x >= 0 && x < map.len() && map.get(x) != 0 && gi < 10000 {
        x = map.get(x) - 1;
        gi = gi + 1;
    }
    return x;
}

/// A ConstBool instruction as 0/1.
fn iro_const_bool_val(f: &IrFunction, id: i64) -> OptI64 {
    match peir_inst_of(f, id) {
        Inst::ConstBool(v) => { if v { return OptI64::Some(1); } return OptI64::Some(0); }
        _ => { return OptI64::None; }
    }
}

/// ME12: identities — an op whose result is a constant or one of its
/// operands. Only where removing the op cannot remove a panic: under
/// checked arithmetic `x / x`, `0 / x`, `0 % x` and `0 << x` stay
/// (they can still panic); `x + 0`, `x * 0`, `x / 1`, `x % 1`, `x - x`,
/// `x << 0` and every bit op never can.
fn iro_identities(f: &mut IrFunction) -> bool {
    var bad: Vec<i64> = iro_unhandled_uses(f);
    var map: Vec<i64> = peir_zeros(f.next_value + 1);
    var dead: Vec<i64> = peir_zeros(f.next_value + 1);
    var changed: bool = false;
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < bad.len() && bad.get(id) == 0 {
                var alias: i64 = -1;
                var bkonst: i64 = -1;
                match peir_inst_of(f, id) {
                    Inst::BinOp(op, l, r, t) => {
                        var lkonst: OptI64 = iro_const_int(f, l);
                        var rkonst: OptI64 = iro_const_int(f, r);
                        var lc0: bool = false;
                        var rc0: bool = false;
                        var lc1: bool = false;
                        var rc1: bool = false;
                        var lneg1: bool = false;
                        var rneg1: bool = false;
                        match lkonst { OptI64::Some(c) => { lc0 = c == 0; lc1 = c == 1; lneg1 = c == 0 - 1; } OptI64::None => {} }
                        match rkonst { OptI64::Some(c) => { rc0 = c == 0; rc1 = c == 1; rneg1 = c == 0 - 1; } OptI64::None => {} }
                        if iro_int_ty(t) {
                            if binop_eq(op, BinOp::Add) {
                                if rc0 { alias = l; } else if lc0 { alias = r; }
                            } else if binop_eq(op, BinOp::Sub) {
                                if rc0 { alias = l; } else if l == r { IrFunction_set_inst(f, id, Inst::ConstInt(0, t)); changed = true; }
                            } else if binop_eq(op, BinOp::Mul) {
                                if lc0 || rc0 { IrFunction_set_inst(f, id, Inst::ConstInt(0, t)); changed = true; }
                                else if lc1 { alias = r; } else if rc1 { alias = l; }
                            } else if binop_eq(op, BinOp::Div) {
                                if rc1 { alias = l; }
                            } else if binop_eq(op, BinOp::Mod) {
                                if rc1 { IrFunction_set_inst(f, id, Inst::ConstInt(0, t)); changed = true; }
                            } else if binop_eq(op, BinOp::Shl) || binop_eq(op, BinOp::Shr) {
                                if rc0 { alias = l; }
                            } else if binop_eq(op, BinOp::BitAnd) {
                                if lc0 || rc0 { IrFunction_set_inst(f, id, Inst::ConstInt(0, t)); changed = true; }
                                else if l == r { alias = l; }
                                else if rneg1 && (ir_type_eq(t, IrType::I64) || ir_type_eq(t, IrType::U64)) { alias = l; }
                                else if lneg1 && (ir_type_eq(t, IrType::I64) || ir_type_eq(t, IrType::U64)) { alias = r; }
                            } else if binop_eq(op, BinOp::BitOr) {
                                if rc0 { alias = l; } else if lc0 { alias = r; }
                                else if l == r { alias = l; }
                                else if (lneg1 || rneg1) && (ir_type_eq(t, IrType::I64) || ir_type_eq(t, IrType::U64)) {
                                    IrFunction_set_inst(f, id, Inst::ConstInt(0 - 1, t)); changed = true;
                                }
                            } else if binop_eq(op, BinOp::BitXor) {
                                if rc0 { alias = l; } else if lc0 { alias = r; }
                                else if l == r { IrFunction_set_inst(f, id, Inst::ConstInt(0, t)); changed = true; }
                            } else if binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or) {
                                var lb: OptI64 = iro_const_bool_val(f, l);
                                var rb: OptI64 = iro_const_bool_val(f, r);
                                var lbv: i64 = -1;
                                var rbv: i64 = -1;
                                match lb { OptI64::Some(v) => { lbv = v; } OptI64::None => {} }
                                match rb { OptI64::Some(v) => { rbv = v; } OptI64::None => {} }
                                if binop_eq(op, BinOp::And) {
                                    if rbv == 0 || lbv == 0 { bkonst = 0; }
                                    else if rbv == 1 { alias = l; } else if lbv == 1 { alias = r; }
                                } else {
                                    if rbv == 1 || lbv == 1 { bkonst = 1; }
                                    else if rbv == 0 { alias = l; } else if lbv == 0 { alias = r; }
                                }
                            } else {
                                // comparisons of a value with itself: Eq,
                                // LtEq, GtEq always true; Neq, Lt, Gt false
                                if l == r && !binop_eq(op, BinOp::And) && !binop_eq(op, BinOp::Or) {
                                    if binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::GtEq) { bkonst = 1; }
                                    if binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::Gt) { bkonst = 0; }
                                }
                            }
                        } else if !iro_int_ty(t) && l == r {
                            // a pointer compared to itself: still total
                            match t {
                                IrType::Ptr(_) => {
                                    if binop_eq(op, BinOp::Eq) { bkonst = 1; }
                                    if binop_eq(op, BinOp::Neq) { bkonst = 0; }
                                }
                                _ => {}
                            }
                        }
                    }
                    Inst::UnaryOp(uop, a, _) => {
                        // -(-x), !( !x ), ~(~x): the inner op keeps its own
                        // panic (Neg of MIN), the outer one cannot add one
                        match peir_inst_of(f, a) {
                            Inst::UnaryOp(uop2, a2, _) => {
                                var same: bool = false;
                                match uop {
                                    UnaryOp::Neg => { match uop2 { UnaryOp::Neg => { same = true; } _ => {} } }
                                    UnaryOp::Not => { match uop2 { UnaryOp::Not => { same = true; } _ => {} } }
                                    UnaryOp::BitNot => { match uop2 { UnaryOp::BitNot => { same = true; } _ => {} } }
                                    _ => {}
                                }
                                if same { alias = a2; }
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                if alias >= 0 && alias < map.len() {
                    var fx: i64 = iro_map_final(&map, alias);
                    if fx != id {
                        map.set(id, fx + 1);
                        dead.set(id, 1);
                        changed = true;
                    }
                }
                if bkonst >= 0 {
                    IrFunction_set_inst(f, id, Inst::ConstBool(bkonst == 1));
                    changed = true;
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    if changed {
        iro_apply_map(f, &map);
        b = 0;
        while b < f.blocks.len() {
            var blk: BasicBlock = f.blocks.get(b);
            var keep: Vec<i64> = Vec::new();
            var k2: i64 = 0;
            while k2 < blk.instructions.len() {
                var i2: i64 = blk.instructions.get(k2);
                if i2 < 0 || i2 >= dead.len() || dead.get(i2) == 0 { keep.push(i2); }
                k2 = k2 + 1;
            }
            blk.instructions = keep;
            f.blocks.set(b, blk);
            b = b + 1;
        }
    }
    return changed;
}

fn iro_simplify(f: &mut IrFunction) -> bool {
    var changed: bool = false;
    if iro_identities(f) { changed = true; }
    var flags: Vec<i64> = peir_unchecked_ops(f, f.next_value + 1);
    var u: IroUses = iro_uses(f);
    var b: i64 = 0;
    while b < f.blocks.len() {
        var k: i64 = 0;
        while k < f.blocks.get(b).instructions.len() {
            var id: i64 = f.blocks.get(b).instructions.get(k);
            match peir_inst_of(f, id) {
                Inst::BinOp(op, l, r, t) => {
                    var done: bool = false;
                    // reassociation of constant steps
                    if binop_eq(op, BinOp::Add) || binop_eq(op, BinOp::Sub) {
                        match iro_step(f, id) {
                            OptI64::Some(d2) => {
                                if l >= 0 && l < u.count.len() && u.count.get(l) == 1 && u.block_of.get(l) == b {
                                    match iro_step(f, l) {
                                        OptI64::Some(d1) => {
                                            var same: bool = (d1 > 0 && d2 > 0) || (d1 < 0 && d2 < 0);
                                            var fits: bool = (d1 > 0 && d2 <= IRO_I64_MAX - d1) || (d1 < 0 && d2 >= (0 - IRO_I64_MAX) - d1);
                                            if same && fits {
                                                var x: i64 = iro_first_operand(f, l);
                                                var d: i64 = d1 + d2;
                                                var cid: i64 = 0;
                                                if d > 0 {
                                                    cid = iro_const_before(f, b, k, d, t);
                                                    IrFunction_set_inst(f, id, Inst::BinOp(BinOp::Add, x, cid, t));
                                                } else {
                                                    cid = iro_const_before(f, b, k, 0 - d, t);
                                                    IrFunction_set_inst(f, id, Inst::BinOp(BinOp::Sub, x, cid, t));
                                                }
                                                iro_remove_from_block(f, l);
                                                u = iro_uses(f);
                                                changed = true;
                                                done = true;
                                            }
                                        }
                                        OptI64::None => {}
                                    }
                                }
                            }
                            OptI64::None => {}
                        }
                    }
                    // multiplication by a power of two
                    if !done && binop_eq(op, BinOp::Mul) && (ir_type_eq(t, IrType::I64) || iro_unsigned(t)) {
                        var unchecked: bool = f.is_wrapping || (id < flags.len() && (flags.get(id) & 1) != 0);
                        if unchecked {
                            var x2: i64 = -1;
                            var sh: i64 = -1;
                            match iro_const_int(f, r) {
                                OptI64::Some(c) => { sh = iro_log2(c); x2 = l; }
                                OptI64::None => {
                                    match iro_const_int(f, l) {
                                        OptI64::Some(c2) => { sh = iro_log2(c2); x2 = r; }
                                        OptI64::None => {}
                                    }
                                }
                            }
                            if sh > 0 {
                                var kid: i64 = iro_const_before(f, b, k, sh, t);
                                IrFunction_set_inst(f, id, Inst::BinOp(BinOp::Shl, x2, kid, t));
                                u = iro_uses(f);
                                changed = true;
                                done = true;
                            }
                        }
                    }
                    // division and remainder by a power of two
                    if !done && (binop_eq(op, BinOp::Div) || binop_eq(op, BinOp::Mod)) && (ir_type_eq(t, IrType::I64) || iro_unsigned(t)) {
                        var nonneg: bool = iro_unsigned(t) || (l >= 0 && l < flags.len() && (flags.get(l) & 2) != 0);
                        match iro_const_int(f, r) {
                            OptI64::Some(c3) => {
                                var sh2: i64 = iro_log2(c3);
                                if nonneg && sh2 > 0 {
                                    if binop_eq(op, BinOp::Div) {
                                        var kid2: i64 = iro_const_before(f, b, k, sh2, t);
                                        IrFunction_set_inst(f, id, Inst::BinOp(BinOp::Shr, l, kid2, t));
                                    } else {
                                        var mid: i64 = iro_const_before(f, b, k, c3 - 1, t);
                                        IrFunction_set_inst(f, id, Inst::BinOp(BinOp::BitAnd, l, mid, t));
                                    }
                                    u = iro_uses(f);
                                    changed = true;
                                }
                            }
                            OptI64::None => {}
                        }
                    }
                }
                _ => {}
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return changed;
}

// ME3 (partial): promote a plain local to SSA values when every load of
// it has exactly one reaching store. Forward dataflow per alloca over the
// reachable CFG; the state is the stored value id, -1 when no store has
// reached the point yet, -2 when predecessors disagree or a store could
// join an uninitialized path — the cases that would need phis, which the
// IR cannot carry yet (Jump/Branch take no arguments), so those loads
// stay in memory. Replaced loads are dropped from their blocks; the
// stores left dead are removed by dse.
/// The value a store instruction stores now: its operand may have been
/// renamed by a promotion since the event table recorded the store's id.
fn iro_store_val(f: &IrFunction, iid: i64) -> i64 {
    match peir_inst_of(f, iid) {
        Inst::Store(_, sv, _) => { return sv; }
        _ => { return -1; }
    }
}

fn iro_promote(f: &mut IrFunction) -> bool {
    var cfg: IroCfg = iro_cfg(f);
    if cfg.n == 0 { return false; }
    var plain: Vec<i64> = iro_plain_locals(f);
    var nv: i64 = plain.len();
    // per-block events on plain locals: alloca id, kind (0 load, 1 store),
    // payload (the load's inst id / the stored value id)
    var ev_a: Vec<Vec<i64>> = Vec::new();
    var ev_k: Vec<Vec<i64>> = Vec::new();
    var ev_v: Vec<Vec<i64>> = Vec::new();
    var has_load: Vec<i64> = peir_zeros(nv);
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ea: Vec<i64> = Vec::new();
        var ek: Vec<i64> = Vec::new();
        var ev: Vec<i64> = Vec::new();
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var iid: i64 = ids.get(k);
            match peir_inst_of(f, iid) {
                Inst::Load(p, _) => {
                    if p >= 0 && p < nv && plain.get(p) == 1 {
                        ea.push(p); ek.push(0); ev.push(iid); has_load.set(p, 1);
                    }
                }
                Inst::Store(p, sv, _) => {
                    if p >= 0 && p < nv && plain.get(p) == 1 {
                        // ev holds the store's inst id; the stored value is
                        // re-read live (earlier promotions rename operands)
                        ea.push(p); ek.push(1); ev.push(iid);
                    }
                }
                _ => {}
            }
            k = k + 1;
        }
        ev_a.push(ea); ev_k.push(ek); ev_v.push(ev);
        b = b + 1;
    }
    var changed: bool = false;
    // values a TryUnwrap or Asm reads can never be renamed: a load feeding
    // one stays in memory
    var bad: Vec<i64> = iro_unhandled_uses(f);
    // buffers live outside the alloca loop: allocating one per local OOMs
    // on large functions
    var in_st: Vec<i64> = Vec::new();
    var out_st: Vec<i64> = Vec::new();
    var map: Vec<i64> = peir_zeros(nv);
    var deadl: Vec<i64> = peir_zeros(nv);
    var i: i64 = 0;
    while i < cfg.n { in_st.push(-1); out_st.push(-1); i = i + 1; }
    var a: i64 = 0;
    while a < nv {
        if plain.get(a) == 1 && has_load.get(a) == 1 {
            var iter: i64 = 0;
            var stable: bool = false;
            while !stable && iter <= cfg.n {
                stable = true;
                var ri: i64 = 0;
                while ri < cfg.rpo.len() {
                    var bi: i64 = cfg.rpo.get(ri);
                    var m: i64 = -3;
                    var ps: Vec<i64> = cfg.preds.get(bi);
                    var pi: i64 = 0;
                    while pi < ps.len() {
                        var s: i64 = out_st.get(ps.get(pi));
                        if m == -3 { m = s; }
                        else if m != s { m = -2; }
                        pi = pi + 1;
                    }
                    if m == -3 { m = -1; }
                    if in_st.get(bi) != m { in_st.set(bi, m); stable = false; }
                    var st: i64 = m;
                    var ea2: Vec<i64> = ev_a.get(bi);
                    var ek2: Vec<i64> = ev_k.get(bi);
                    var ev2: Vec<i64> = ev_v.get(bi);
                    var k2: i64 = 0;
                    while k2 < ea2.len() {
                        if ea2.get(k2) == a && ek2.get(k2) == 1 { st = iro_store_val(f, ev2.get(k2)); }
                        k2 = k2 + 1;
                    }
                    if out_st.get(bi) != st { out_st.set(bi, st); stable = false; }
                    ri = ri + 1;
                }
                iter = iter + 1;
            }
            // rewrite loads whose single reaching store is known
            var touched: Vec<i64> = Vec::new();
            var found: bool = false;
            var rj: i64 = 0;
            while rj < cfg.rpo.len() {
                var bj: i64 = cfg.rpo.get(rj);
                var st2: i64 = in_st.get(bj);
                var ea3: Vec<i64> = ev_a.get(bj);
                var ek3: Vec<i64> = ev_k.get(bj);
                var ev3: Vec<i64> = ev_v.get(bj);
                var k3: i64 = 0;
                while k3 < ea3.len() {
                    if ea3.get(k3) == a {
                        if ek3.get(k3) == 1 { st2 = iro_store_val(f, ev3.get(k3)); }
                        else if st2 >= 0 {
                            var lid: i64 = ev3.get(k3);
                            if bad.get(lid) == 0 {
                                if deadl.get(lid) == 0 { touched.push(lid); }
                                map.set(lid, st2 + 1); deadl.set(lid, 1); found = true;
                            }
                        }
                    }
                    k3 = k3 + 1;
                }
                rj = rj + 1;
            }
            if found {
                var wb: i64 = 0;
                while wb < f.blocks.len() {
                    var blk: BasicBlock = f.blocks.get(wb);
                    var keep: Vec<i64> = Vec::new();
                    var k4: i64 = 0;
                    var dropped: bool = false;
                    while k4 < blk.instructions.len() {
                        var iid2: i64 = blk.instructions.get(k4);
                        if iid2 >= 0 && iid2 < nv && deadl.get(iid2) == 1 {
                            dropped = true;
                        } else {
                            IrFunction_set_inst(f, iid2, iro_remap_all(peir_inst_of(f, iid2), &map));
                            keep.push(iid2);
                        }
                        k4 = k4 + 1;
                    }
                    if dropped {
                        blk.instructions = keep;
                        f.blocks.set(wb, blk);
                    }
                    wb = wb + 1;
                }
                changed = true;
            }
            var rl: i64 = 0;
            while rl < touched.len() {
                var tl: i64 = touched.get(rl);
                map.set(tl, 0); deadl.set(tl, 0);
                rl = rl + 1;
            }
            var rs: i64 = 0;
            while rs < cfg.n { in_st.set(rs, -1); out_st.set(rs, -1); rs = rs + 1; }
        }
        a = a + 1;
    }
    if changed { iro_dce_more(f); }
    return changed;
}
