// opt.fd — PIR Optimizer core (rewritten from src/opt.rs, 8129 LOC)
//
// This is the core module: Pass enum, OptStats, the optimize_l2 driver,
// and shared helper functions. Individual passes are in:
//   opt_const.fd  — const-fold, CSE, GVN
//   opt_dce.fd    — DCE, DSE, SROA
//   opt_inline.fd — inline, unroll, TCO
//   opt_loop.fd   — loop-rotate, loop-vec, SLP vectorize
//   opt_other.fd  — devirt, jump-thread, alias-analysis, effect-reorder,
//                   partial-eval, strength-reduce, reassociate, memoize,
//                   effect-opt, region-pool
//
// Adaptations from Rust:
// 1. HashMap<K,V> → Vec-based maps with helper structs
// 2. HashSet<T> → Vec<T> with contains() helper
// 3. usize → i64, &str → str
// 4. thread_local! → module-level var (Fides is single-threaded for now)
// 5. closures/Fn traits → explicit function pointers (not needed — passes are pub fns)
// 6. parallel_functions → sequential (MIN_PARALLEL_FUNCTIONS=999 means always sequential)
// 7. Option<T> → Opt* enums or i64 sentinel values

module compiler::opt;

use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::pir;

// ─── Pass enum ───────────────────────────────────────────────────────────

pub enum Pass {
    ConstFold,
    Cse,
    Dce,
    Inline,
    Unroll,
    Tco,
    AliasAnalysis,
    EffectReorder,
    PartialEval,
    Vectorize,
    StrengthReduce,
    Gvn,
    Sroa,
    Dse,
    Devirt,
    JumpThread,
    LoopRotate,
    LoopVectorize,
    EffectOpt,
    RegionPool,
    Reassociate,
    Memoize,
}

pub fn Pass_name(p: Pass) -> str {
    match p {
        Pass::ConstFold => { return "const-fold"; }
        Pass::Cse => { return "cse"; }
        Pass::Dce => { return "dce"; }
        Pass::Inline => { return "inline"; }
        Pass::Unroll => { return "unroll"; }
        Pass::Tco => { return "tco"; }
        Pass::AliasAnalysis => { return "alias-analysis"; }
        Pass::EffectReorder => { return "effect-reorder"; }
        Pass::PartialEval => { return "partial-eval"; }
        Pass::Vectorize => { return "vectorize"; }
        Pass::StrengthReduce => { return "strength-reduce"; }
        Pass::Gvn => { return "gvn"; }
        Pass::Sroa => { return "sroa"; }
        Pass::Dse => { return "dse"; }
        Pass::Devirt => { return "devirt"; }
        Pass::JumpThread => { return "jump-thread"; }
        Pass::LoopRotate => { return "loop-rotate"; }
        Pass::LoopVectorize => { return "loop-vec"; }
        Pass::EffectOpt => { return "effect-opt"; }
        Pass::RegionPool => { return "region-pool"; }
        Pass::Reassociate => { return "reassociate"; }
        Pass::Memoize => { return "memoize"; }
    }
    return "unknown";
}

pub enum OptPass {
    Some(Pass),
    None,
}

pub fn Pass_parse(s: str) -> OptPass {
    if str_equal(s, "const-fold") || str_equal(s, "constfold") || str_equal(s, "cf") { return OptPass::Some(Pass::ConstFold); }
    if str_equal(s, "cse") { return OptPass::Some(Pass::Cse); }
    if str_equal(s, "dce") { return OptPass::Some(Pass::Dce); }
    if str_equal(s, "inline") || str_equal(s, "inl") { return OptPass::Some(Pass::Inline); }
    if str_equal(s, "unroll") { return OptPass::Some(Pass::Unroll); }
    if str_equal(s, "tco") { return OptPass::Some(Pass::Tco); }
    if str_equal(s, "alias-analysis") || str_equal(s, "alias") || str_equal(s, "aa") { return OptPass::Some(Pass::AliasAnalysis); }
    if str_equal(s, "effect-reorder") || str_equal(s, "reorder") || str_equal(s, "er") { return OptPass::Some(Pass::EffectReorder); }
    if str_equal(s, "partial-eval") || str_equal(s, "pe") { return OptPass::Some(Pass::PartialEval); }
    if str_equal(s, "vectorize") || str_equal(s, "vec") || str_equal(s, "auto-vec") { return OptPass::Some(Pass::Vectorize); }
    if str_equal(s, "strength-reduce") || str_equal(s, "sr") { return OptPass::Some(Pass::StrengthReduce); }
    if str_equal(s, "gvn") { return OptPass::Some(Pass::Gvn); }
    if str_equal(s, "sroa") { return OptPass::Some(Pass::Sroa); }
    if str_equal(s, "dse") { return OptPass::Some(Pass::Dse); }
    if str_equal(s, "devirt") { return OptPass::Some(Pass::Devirt); }
    if str_equal(s, "jump-thread") || str_equal(s, "jt") { return OptPass::Some(Pass::JumpThread); }
    if str_equal(s, "loop-rotate") || str_equal(s, "lr") { return OptPass::Some(Pass::LoopRotate); }
    if str_equal(s, "loop-vec") || str_equal(s, "lv") { return OptPass::Some(Pass::LoopVectorize); }
    if str_equal(s, "effect-opt") || str_equal(s, "eo") { return OptPass::Some(Pass::EffectOpt); }
    if str_equal(s, "region-pool") || str_equal(s, "rp") { return OptPass::Some(Pass::RegionPool); }
    if str_equal(s, "reassociate") || str_equal(s, "reassoc") { return OptPass::Some(Pass::Reassociate); }
    if str_equal(s, "memoize") || str_equal(s, "memo") { return OptPass::Some(Pass::Memoize); }
    return OptPass::None;
}

/// The default pass list (LoopRotate is disabled — see comment in Rust source).
pub fn Pass_all() -> Vec<Pass> {
    var passes: Vec<Pass> = Vec::new();
    passes.push(Pass::ConstFold);
    passes.push(Pass::Cse);
    passes.push(Pass::Gvn);
    passes.push(Pass::Dce);
    passes.push(Pass::Inline);
    passes.push(Pass::Unroll);
    passes.push(Pass::Tco);
    passes.push(Pass::AliasAnalysis);
    passes.push(Pass::EffectReorder);
    passes.push(Pass::PartialEval);
    passes.push(Pass::StrengthReduce);
    passes.push(Pass::Sroa);
    passes.push(Pass::Dse);
    passes.push(Pass::Devirt);
    passes.push(Pass::JumpThread);
    // LoopRotate disabled — produces incorrect code with EffectReorder.
    // passes.push(Pass::LoopRotate);
    passes.push(Pass::LoopVectorize);
    passes.push(Pass::EffectOpt);
    passes.push(Pass::Reassociate);
    passes.push(Pass::Memoize);
    return passes;
}

// ─── OptStats ────────────────────────────────────────────────────────────

pub struct OptStats {
    pub const_fold: i64,
    pub cse: i64,
    pub dce: i64,
    pub inlined: i64,
    pub unrolled: i64,
    pub tco: i64,
    pub alias_analysis: i64,
    pub effect_reorder: i64,
    pub partial_eval: i64,
    pub vectorize: i64,
    pub strength_reduce: i64,
    pub gvn: i64,
    pub sroa: i64,
    pub dse: i64,
    pub devirt: i64,
    pub jump_thread: i64,
    pub loop_rotate: i64,
    pub loop_vectorize: i64,
    pub effect_opt: i64,
    pub region_pool: i64,
    pub reassociate: i64,
    pub memoize: i64,
    pub iterations: i64,
}

pub fn OptStats_new() -> OptStats {
    return OptStats {
        const_fold: 0,
        cse: 0,
        dce: 0,
        inlined: 0,
        unrolled: 0,
        tco: 0,
        alias_analysis: 0,
        effect_reorder: 0,
        partial_eval: 0,
        vectorize: 0,
        strength_reduce: 0,
        gvn: 0,
        sroa: 0,
        dse: 0,
        devirt: 0,
        jump_thread: 0,
        loop_rotate: 0,
        loop_vectorize: 0,
        effect_opt: 0,
        region_pool: 0,
        reassociate: 0,
        memoize: 0,
        iterations: 0,
    };
}

pub fn OptStats_total(s: OptStats) -> i64 {
    return s.const_fold + s.cse + s.dce + s.inlined + s.unrolled + s.tco
        + s.alias_analysis + s.effect_reorder + s.partial_eval + s.vectorize
        + s.strength_reduce + s.gvn + s.sroa + s.dse + s.devirt
        + s.jump_thread + s.loop_rotate + s.loop_vectorize + s.effect_opt
        + s.region_pool + s.reassociate + s.memoize;
}

// ─── LTO mode ────────────────────────────────────────────────────────────
// Rust uses thread_local!; Fides doesn't support module-level vars.
// We use a wrapper struct approach: L2Module could carry an lto flag,
// but for simplicity we just pass it as a parameter where needed.
// For now, LTO mode is handled by calling optimize_l2_lto() which uses
// larger max_iters. The inline threshold difference is handled in
// opt_inline.fd by checking a global flag set via set_lto_mode.

// Since Fides doesn't support module-level mutable state, we use a
// pseudo-global via a Vec<bool> singleton pattern.
// Actually, the simplest approach: LTO only affects inline limits,
// and we can check max_iters > 8 as a proxy for LTO mode.

pub fn is_lto_mode() -> bool {
    // LTO mode is inferred from the caller using larger iteration counts.
    // This is a simplification — the real check is in opt_inline.fd.
    return false;
}

// ─── Main driver: optimize_l2 ────────────────────────────────────────────

pub fn optimize_l2(module: &mut L2Module) -> OptStats {
    return optimize_l2_with(module, Pass_all(), 8);
}

pub fn optimize_l2_lto(module: &mut L2Module) -> OptStats {
    // LTO mode: use more iterations. Inline threshold differences are
    // handled in opt_inline.fd by checking iteration count.
    return optimize_l2_with(module, Pass_all(), 16);
}

pub fn optimize_l2_with(module: &mut L2Module, passes: Vec<Pass>, max_iters: i64) -> OptStats {
    var stats: OptStats = OptStats_new();

    var i: i64 = 0;
    while i < max_iters {
        stats.iterations = i + 1;
        var before: i64 = OptStats_total(stats);

        var j: i64 = 0;
        while j < passes.len() {
            var p: Pass = passes.get(j);
            // S-1A: Skip passes that can't do anything based on module-level analysis
            if !pass_relevant_for_module(module, p) {
                j = j + 1;
                continue;
            }
            match p {
                Pass::ConstFold => { stats.const_fold = stats.const_fold + pass_const_fold(module); }
                Pass::Cse => { stats.cse = stats.cse + pass_cse(module); }
                Pass::Gvn => { stats.gvn = stats.gvn + pass_gvn(module); }
                Pass::Sroa => { stats.sroa = stats.sroa + pass_sroa(module); }
                Pass::Dse => { stats.dse = stats.dse + pass_dse(module); }
                Pass::Devirt => { stats.devirt = stats.devirt + pass_devirt(module); }
                Pass::JumpThread => { stats.jump_thread = stats.jump_thread + pass_jump_thread(module); }
                Pass::LoopRotate => { stats.loop_rotate = stats.loop_rotate + pass_loop_rotate(module); }
                Pass::LoopVectorize => { stats.loop_vectorize = stats.loop_vectorize + pass_loop_vectorize(module); }
                Pass::Dce => { stats.dce = stats.dce + pass_dce(module); }
                Pass::Inline => { stats.inlined = stats.inlined + pass_inline(module); }
                Pass::Unroll => { stats.unrolled = stats.unrolled + pass_unroll(module); }
                Pass::Tco => { stats.tco = stats.tco + pass_tco(module); }
                Pass::AliasAnalysis => { stats.alias_analysis = stats.alias_analysis + pass_alias_analysis(module); }
                Pass::EffectReorder => { stats.effect_reorder = stats.effect_reorder + pass_effect_reorder(module); }
                Pass::PartialEval => { stats.partial_eval = stats.partial_eval + pass_partial_eval(module); }
                Pass::Vectorize => { stats.vectorize = stats.vectorize + pass_slp_vectorize(module); }
                Pass::StrengthReduce => { stats.strength_reduce = stats.strength_reduce + pass_strength_reduce(module); }
                Pass::EffectOpt => { stats.effect_opt = stats.effect_opt + pass_effect_optimize(module); }
                Pass::RegionPool => { stats.region_pool = stats.region_pool + pass_region_pool(module); }
                Pass::Reassociate => { stats.reassociate = stats.reassociate + pass_reassociate(module); }
                Pass::Memoize => { stats.memoize = stats.memoize + pass_memoize(module); }
            }
            j = j + 1;
        }

        if OptStats_total(stats) == before {
            break;
        }
        i = i + 1;
    }

    // Final cleanup: topologically sort all block instruction lists
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var f: L2Function = module.functions.get(fi);
        var bi: i64 = 0;
        while bi < f.blocks.len() {
            topo_sort_block(&mut f.blocks.get(bi), f.values);
            bi = bi + 1;
        }
        module.functions.set(fi, f);
        fi = fi + 1;
    }

    return stats;
}

