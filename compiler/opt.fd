fn module_has_call_print_panic(module: &L2Module) -> bool {
    var i: i64 = 0;
    while i < module.functions.len() {
        var f: L2Function = module.functions.get(i);
        var j: i64 = 0;
        while j < f.values.len() {
            match f.values.get(j).inst {
                L2Inst::Call(_, _, _) => { return true; }
                L2Inst::Print(_, _) => { return true; }
                L2Inst::Panic(_) => { return true; }
                _ => {}
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return false;
}

fn module_has_const_call(module: &L2Module) -> bool {
    var i: i64 = 0;
    while i < module.functions.len() {
        var f: L2Function = module.functions.get(i);
        var j: i64 = 0;
        while j < f.values.len() {
            match f.values.get(j).inst {
                L2Inst::Call(func, args, ty) => {
                    var all_const: bool = true;
                    var k: i64 = 0;
                    while k < args.len() {
                        match L2Function_get_value(f, args.get(k)) {
                            OptL2Inst::Some(inst) => {
                                match inst {
                                    L2Inst::ConstInt(_, _) => {}
                                    L2Inst::ConstFloat(_, _) => {}
                                    L2Inst::ConstBool(_) => {}
                                    _ => { all_const = false; }
                                }
                            }
                            OptL2Inst::None => { all_const = false; }
                        }
                        k = k + 1;
                    }
                    if all_const { return true; }
                }
                _ => {}
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return false;
}

fn module_has_wrapping_nested_binop(module: &L2Module) -> bool {
    var i: i64 = 0;
    while i < module.functions.len() {
        var f: L2Function = module.functions.get(i);
        if !f.is_wrapping { i = i + 1; continue; }
        var j: i64 = 0;
        while j < f.values.len() {
            match f.values.get(j).inst {
                L2Inst::BinOp(op, left, right, ty) => {
                    match L2Function_get_value(f, left) {
                        OptL2Inst::Some(L2Inst::BinOp(_, _, _, _)) => { return true; }
                        _ => {}
                    }
                    match L2Function_get_value(f, right) {
                        OptL2Inst::Some(L2Inst::BinOp(_, _, _, _)) => { return true; }
                        _ => {}
                    }
                }
                _ => {}
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return false;
}

fn module_has_deterministic(module: &L2Module) -> bool {
    var i: i64 = 0;
    while i < module.functions.len() {
        if module.functions.get(i).is_deterministic { return true; }
        i = i + 1;
    }
    return false;
}

fn module_has_named_region_alloca(module: &L2Module) -> bool {
    var i: i64 = 0;
    while i < module.functions.len() {
        var f: L2Function = module.functions.get(i);
        var j: i64 = 0;
        while j < f.values.len() {
            match f.values.get(j).inst {
                L2Inst::Alloca(ty, region) => {
                    match region {
                        MemRegion::Stack => {}
                        MemRegion::Heap => {}
                        _ => { return true; }
                    }
                }
                _ => {}
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return false;
}

fn module_has_tail_call(module: &L2Module) -> bool {
    var i: i64 = 0;
    while i < module.functions.len() {
        var f: L2Function = module.functions.get(i);
        var bi: i64 = 0;
        while bi < f.blocks.len() {
            var b: L2Block = f.blocks.get(bi);
            if b.instructions.len() > 0 {
                var term_vid: i64 = b.instructions.get(b.instructions.len() - 1);
                match L2Function_get_value(f, term_vid) {
                    OptL2Inst::Some(L2Inst::Return(ret_val)) => {
                        if ret_val >= 0 {
                            match L2Function_get_value(f, ret_val) {
                                OptL2Inst::Some(L2Inst::Call(_, _, _)) => { return true; }
                                _ => {}
                            }
                        }
                    }
                    _ => {}
                }
            }
            bi = bi + 1;
        }
        i = i + 1;
    }
    return false;
}

// ─── has_loops: check if a function has back-edges ───────────────────────

pub fn has_loops(f: L2Function) -> bool {
    var bi: i64 = 0;
    while bi < f.blocks.len() {
        var b: L2Block = f.blocks.get(bi);
        if b.instructions.len() > 0 {
            var term_vid: i64 = b.instructions.get(b.instructions.len() - 1);
            match L2Function_get_value(f, term_vid) {
                OptL2Inst::Some(L2Inst::Jump(target)) => {
                    if target <= bi { return true; }
                }
                OptL2Inst::Some(L2Inst::Branch(cond, then_b, else_b)) => {
                    if then_b <= bi { return true; }
                    if else_b <= bi { return true; }
                }
                _ => {}
            }
        }
        bi = bi + 1;
    }
    return false;
}

// ═══════════════════════════════════════════════════════════════════════════
// Shared helpers: side effects, purity, value references
// ═══════════════════════════════════════════════════════════════════════════

/// Does this instruction have observable side effects?
pub fn has_side_effects(inst: L2Inst) -> bool {
    match inst {
        L2Inst::Store(_, _, _) => { return true; }
        L2Inst::Print(_, _) => { return true; }
        L2Inst::Panic(_) => { return true; }
        L2Inst::Return(_) => { return true; }
        L2Inst::Jump(_) => { return true; }
        L2Inst::Branch(_, _, _) => { return true; }
        L2Inst::Unreachable => { return true; }
        L2Inst::TryUnwrap(_, _, _, _) => { return true; }
        L2Inst::Call(func, _, _) => { return !is_known_pure_func(func); }
        L2Inst::CallPtr(_, _, _, _) => { return true; }
        L2Inst::DynCall(_, _, _, _) => { return true; }
        _ => { return false; }
    }
    return false;
}

/// Check if a function name is known to be pure (no side effects).
pub fn is_known_pure_func(name: str) -> bool {
    // Pure arithmetic helpers
    if str_equal(name, "p_add") { return true; }
    if str_equal(name, "p_sub") { return true; }
    if str_equal(name, "p_mul") { return true; }
    if str_equal(name, "p_div") { return true; }
    if str_equal(name, "p_mod") { return true; }
    // Pure comparison helpers
    if str_equal(name, "p_eq") { return true; }
    if str_equal(name, "p_neq") { return true; }
    if str_equal(name, "p_lt") { return true; }
    if str_equal(name, "p_gt") { return true; }
    if str_equal(name, "p_le") { return true; }
    if str_equal(name, "p_ge") { return true; }
    // Pure conversion helpers
    if str_equal(name, "p_int_to_float") { return true; }
    if str_equal(name, "p_float_to_int") { return true; }
    if str_equal(name, "p_int_extend") { return true; }
    if str_equal(name, "p_int_trunc") { return true; }
    // Pure string accessors
    if str_equal(name, "p_string_len") { return true; }
    if str_equal(name, "p_string_contains") { return true; }
    if str_equal(name, "p_string_starts_with") { return true; }
    if str_equal(name, "p_string_ends_with") { return true; }
    if str_equal(name, "p_string_trim") { return true; }
    if str_equal(name, "p_string_to_uppercase") { return true; }
    if str_equal(name, "p_string_to_lowercase") { return true; }
    if str_equal(name, "p_string_replace") { return true; }
    if str_equal(name, "p_string_split") { return true; }
    if str_equal(name, "p_string_char_at") { return true; }
    // Pure vec accessors
    if str_equal(name, "p_vec_len") { return true; }
    if str_equal(name, "p_vec_get") { return true; }
    if str_equal(name, "p_vec_contains") { return true; }
    // Pure option/result
    if str_equal(name, "p_option_some") { return true; }
    if str_equal(name, "p_option_none") { return true; }
    if str_equal(name, "p_option_is_some") { return true; }
    if str_equal(name, "p_option_is_none") { return true; }
    if str_equal(name, "p_result_ok") { return true; }
    if str_equal(name, "p_result_err") { return true; }
    if str_equal(name, "p_result_is_ok") { return true; }
    if str_equal(name, "p_result_is_err") { return true; }
    return false;
}

/// Is this instruction pure (no side effects, deterministic)?
pub fn is_pure(inst: L2Inst) -> bool {
    if has_side_effects(inst) { return false; }
    match inst {
        L2Inst::ConstInt(_, _) => { return true; }
        L2Inst::ConstFloat(_, _) => { return true; }
        L2Inst::ConstBool(_) => { return true; }
        L2Inst::ConstStr(_) => { return true; }
        L2Inst::ConstNull(_) => { return true; }
        L2Inst::BinOp(_, _, _, _) => { return true; }
        L2Inst::UnaryOp(_, _, _) => { return true; }
        L2Inst::GetFieldPtr(_, _, _) => { return true; }
        L2Inst::GetElemPtr(_, _, _) => { return true; }
        L2Inst::BitCast(_, _, _) => { return true; }
        L2Inst::IntExtend(_, _, _) => { return true; }
        L2Inst::IntTrunc(_, _, _) => { return true; }
        L2Inst::IntToFloat(_, _, _) => { return true; }
        L2Inst::FloatToInt(_, _, _) => { return true; }
        // NOTE: Alloca is NOT pure — each alloca returns a unique memory location.
        _ => { return false; }
    }
    return false;
}

/// Check if an instruction is a call to a @deterministic user function.
pub fn is_cseable_call(inst: L2Inst, det_funcs: Vec<str>) -> bool {
    match inst {
        L2Inst::Call(func, _, _) => { return str_vec_contains(det_funcs, func); }
        _ => { return false; }
    }
    return false;
}

/// All PValue operands read by this instruction.
pub fn value_refs(inst: L2Inst) -> Vec<i64> {
    var result: Vec<i64> = Vec::new();
    match inst {
        L2Inst::ConstInt(_, _) => { return result; }
        L2Inst::ConstFloat(_, _) => { return result; }
        L2Inst::ConstBool(_) => { return result; }
        L2Inst::ConstStr(_) => { return result; }
        L2Inst::ConstNull(_) => { return result; }
        L2Inst::Jump(_) => { return result; }
        L2Inst::Unreachable => { return result; }
        L2Inst::Panic(_) => { return result; }
        L2Inst::BinOp(_, left, right, _) => {
            result.push(left);
            result.push(right);
            return result;
        }
        L2Inst::UnaryOp(_, operand, _) => {
            result.push(operand);
            return result;
        }
        L2Inst::Alloca(_, _) => { return result; }
        L2Inst::Load(ptr, _) => {
            result.push(ptr);
            return result;
        }
        L2Inst::Store(ptr, value, _) => {
            result.push(ptr);
            result.push(value);
            return result;
        }
        L2Inst::GetFieldPtr(struct_ptr, _, _) => {
            result.push(struct_ptr);
            return result;
        }
        L2Inst::GetElemPtr(array_ptr, index, _) => {
            result.push(array_ptr);
            result.push(index);
            return result;
        }
        L2Inst::Branch(cond, _, _) => {
            result.push(cond);
            return result;
        }
        L2Inst::Return(ret_val) => {
            if ret_val >= 0 {
                result.push(ret_val);
            }
            return result;
        }
        L2Inst::Call(_, args, _) => { return args; }
        L2Inst::DynCall(_, _, args, _) => { return args; }
        L2Inst::CallPtr(fn_ptr, args, _, _) => {
            result.push(fn_ptr);
            var i: i64 = 0;
            while i < args.len() {
                result.push(args.get(i));
                i = i + 1;
            }
            return result;
        }
        L2Inst::MakeDyn(value, _, _) => {
            result.push(value);
            return result;
        }
        L2Inst::BitCast(value, _, _) => {
            result.push(value);
            return result;
        }
        L2Inst::Copy(value, _) => {
            result.push(value);
            return result;
        }
        L2Inst::IntExtend(value, _, _) => {
            result.push(value);
            return result;
        }
        L2Inst::IntTrunc(value, _, _) => {
            result.push(value);
            return result;
        }
        L2Inst::IntToFloat(value, _, _) => {
            result.push(value);
            return result;
        }
        L2Inst::FloatToInt(value, _, _) => {
            result.push(value);
            return result;
        }
        L2Inst::TryUnwrap(value, ok_dst, _, _) => {
            result.push(value);
            result.push(ok_dst);
            return result;
        }
        L2Inst::Print(value, _) => {
            result.push(value);
            return result;
        }
    }
    return result;
}

/// Collect every PValue that is *used* anywhere in the function.
pub fn collect_used_values(f: L2Function) -> Vec<i64> {
    var used: Vec<i64> = Vec::new();
    // Block params are live
    var bi: i64 = 0;
    while bi < f.blocks.len() {
        var pi: i64 = 0;
        while pi < f.blocks.get(bi).params.len() {
            used_push(&mut used, f.blocks.get(bi).params.get(pi).id);
            pi = pi + 1;
        }
        bi = bi + 1;
    }
    // Function params are live
    var pi: i64 = 0;
    while pi < f.params.len() {
        used_push(&mut used, f.params.get(pi).id);
        pi = pi + 1;
    }
    // Every operand reference
    var vi: i64 = 0;
    while vi < f.values.len() {
        var refs: Vec<i64> = value_refs(f.values.get(vi).inst);
        var ri: i64 = 0;
        while ri < refs.len() {
            used_push(&mut used, refs.get(ri));
            ri = ri + 1;
        }
        vi = vi + 1;
    }
    return used;
}

/// Push to used vec if not already present (dedup).
fn used_push(used: &mut Vec<i64>, val: i64) {
    var i: i64 = 0;
    while i < used.len() {
        if used.get(i) == val { return; }
        i = i + 1;
    }
    used.push(val);
}

/// Check if a value is in a Vec<i64>.
pub fn i64_vec_contains(vec: Vec<i64>, val: i64) -> bool {
    var i: i64 = 0;
    while i < vec.len() {
        if vec.get(i) == val { return true; }
        i = i + 1;
    }
    return false;
}

/// Check if a string is in a Vec<str>.
pub fn str_vec_contains(vec: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < vec.len() {
        if str_equal(vec.get(i), s) { return true; }
        i = i + 1;
    }
    return false;
}

// ─── Topological sort of block instructions ──────────────────────────────

pub fn topo_sort_block(b: &mut L2Block, values: Vec<ValueIdL2Entry>) {
    var insts: Vec<i64> = b.instructions;
    if insts.len() == 0 { return; }

    // Build inst_set for quick lookup
    var inst_set: Vec<i64> = insts;

    // Build dependency lists: for each instruction, which other instructions
    // in this block must come before it?
    // deps: Vec<i64> per instruction — stored as flat Vec<DepEntry>
    var deps: Vec<DepEntry> = Vec::new();
    var i: i64 = 0;
    while i < insts.len() {
        var id: i64 = insts.get(i);
        var inst: L2Inst;
        match lookup_value(values, id) {
            OptL2Inst::Some(found) => { inst = found; }
            OptL2Inst::None => {
                deps.push(DepEntry_new(id, Vec::new()));
                i = i + 1;
                continue;
            }
        }
        var refs: Vec<i64> = value_refs(inst);
        // Filter to only refs that are in this block
        var block_refs: Vec<i64> = Vec::new();
        var j: i64 = 0;
        while j < refs.len() {
            if i64_vec_contains(inst_set, refs.get(j)) {
                block_refs.push(refs.get(j));
            }
            j = j + 1;
        }
        // Terminators must come last — depend on ALL other instructions
        var is_term: bool = false;
        match inst {
            L2Inst::Return(_) => { is_term = true; }
            L2Inst::Jump(_) => { is_term = true; }
            L2Inst::Branch(_, _, _) => { is_term = true; }
            L2Inst::Unreachable => { is_term = true; }
            _ => {}
        }
        if is_term {
            var all_others: Vec<i64> = Vec::new();
            var k: i64 = 0;
            while k < insts.len() {
                if insts.get(k) != id {
                    all_others.push(insts.get(k));
                }
                k = k + 1;
            }
            deps.push(DepEntry_new(id, all_others));
        } else {
            deps.push(DepEntry_new(id, block_refs));
        }
        i = i + 1;
    }

    // Kahn's algorithm: repeatedly pick the instruction with all deps
    // satisfied and the lowest original position.
    var visited: Vec<i64> = Vec::new();
    var result: Vec<i64> = Vec::new();

    while result.len() < insts.len() {
        // Find all instructions whose deps are all visited
        var ready: Vec<i64> = Vec::new();
        var j: i64 = 0;
        while j < insts.len() {
            var id: i64 = insts.get(j);
            if i64_vec_contains(visited, id) {
                j = j + 1;
                continue;
            }
            // Check if all deps are visited
            var all_deps_visited: bool = true;
            var di: i64 = 0;
            while di < deps.len() {
                if deps.get(di).id == id {
                    var dk: i64 = 0;
                    while dk < deps.get(di).deps.len() {
                        if !i64_vec_contains(visited, deps.get(di).deps.get(dk)) {
                            all_deps_visited = false;
                        }
                        dk = dk + 1;
                    }
                }
                di = di + 1;
            }
            if all_deps_visited {
                ready.push(id);
            }
            j = j + 1;
        }

        if ready.len() == 0 {
            // Cycle detected — append remaining in original order
            var k: i64 = 0;
            while k < insts.len() {
                if !i64_vec_contains(visited, insts.get(k)) {
                    result.push(insts.get(k));
                    visited.push(insts.get(k));
                }
                k = k + 1;
            }
            break;
        }

        // Pick the first ready instruction (lowest original position — they're
        // already in original order since we iterated insts in order)
        var id: i64 = ready.get(0);
        visited.push(id);
        result.push(id);
    }

    if result.len() == insts.len() {
        b.instructions = result;
    }
}

// Dep entry for topo sort
struct DepEntry {
    id: i64,
    deps: Vec<i64>,
}

fn DepEntry_new(id: i64, deps: Vec<i64>) -> DepEntry {
    return DepEntry { id: id, deps: deps };
}

// Lookup a value by id in a Vec<ValueIdL2Entry>
fn lookup_value(values: Vec<ValueIdL2Entry>, id: i64) -> OptL2Inst {
    var i: i64 = 0;
    while i < values.len() {
        if values.get(i).id == id {
            return OptL2Inst::Some(values.get(i).inst);
        }
        i = i + 1;
    }
    return OptL2Inst::None;
}

// ─── Forward declarations for pass functions ─────────────────────────────
// These are implemented in the opt_*.fd files. We declare them here so the
// driver can call them. In Fides, cross-module function calls resolve at link
// time, so these just need to be pub fn in the respective modules.
// Since Fides doesn't have a module system for splitting files yet, we'll
// implement all passes in this file for now.

