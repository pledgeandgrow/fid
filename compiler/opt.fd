fn module_has_load_or_store(module: &L2Module) -> bool {
    var i: i64 = 0;
    while i < module.functions.len() {
        var f: L2Function = module.functions.get(i);
        var j: i64 = 0;
        while j < f.values.len() {
            match f.values.get(j).inst {
                L2Inst::Load(_, _) => { return true; }
                L2Inst::Store(_, _, _) => { return true; }
                _ => {}
