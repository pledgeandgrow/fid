return ParseResultStmt::Ok(Stmt::GradBlock(grad_var, body, line));
}

fn parse_pattern(self: &mut Parser) -> ParseResultPattern {
var tok: Token = self.peek_token();
var k: TokenKind = tok.kind;

if token_kind_eq(k, TokenKind::IntLit(0)) {
    var n: i64 = 0;
    match tok.kind {
        TokenKind::IntLit(v: i64) => { n = v; }
    }
    self.advance();
    // Range pattern: 1..=3 or 1..5
    if self.check(TokenKind::DotDotEq) {
        self.advance();
        var end_tok: Token = self.peek_token();
        match end_tok.kind {
            TokenKind::IntLit(m: i64) => {
                self.advance();
                return ParseResultPattern::Ok(Pattern::Range(
                    Box::new(Pattern::IntLit(n)),
                    Box::new(Pattern::IntLit(m + 1))
                ));
            }
        }
        return ParseResultPattern::Err("Parse error at " + int_to_str(end_tok.line) + ":" + int_to_str(end_tok.col) + ": expected int after ..=");
    }
    if self.check(TokenKind::DotDot) {
        self.advance();
        var end_tok: Token = self.peek_token();
        match end_tok.kind {
            TokenKind::IntLit(m: i64) => {
                self.advance();
                return ParseResultPattern::Ok(Pattern::Range(
                    Box::new(Pattern::IntLit(n)),
                    Box::new(Pattern::IntLit(m))
                ));
            }
        }
        return ParseResultPattern::Err("Parse error at " + int_to_str(end_tok.line) + ":" + int_to_str(end_tok.col) + ": expected int after ..");
    }
    return ParseResultPattern::Ok(Pattern::IntLit(n));
}

if token_kind_eq(k, TokenKind::StringLit("")) {
    var s: str = "";
    match tok.kind {
        TokenKind::StringLit(v: str) => { s = v; }
    }
    self.advance();
    return ParseResultPattern::Ok(Pattern::StrLit(s));
}

if token_kind_eq(k, TokenKind::True) {
    self.advance();
    return ParseResultPattern::Ok(Pattern::BoolLit(true));
}
if token_kind_eq(k, TokenKind::False) {
    self.advance();
    return ParseResultPattern::Ok(Pattern::BoolLit(false));
}

if token_kind_eq(k, TokenKind::Ident("")) {
    var name: str = "";
    match tok.kind {
        TokenKind::Ident(v: str) => { name = v; }
    }
    self.advance();
    if name == "_" {
        return ParseResultPattern::Ok(Pattern::Wildcard);
    }
    if self.check(TokenKind::DoubleColon) {
        self.advance();
        var variant: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => { variant = s; }
            ParseResultStr::Err(e) => { return ParseResultPattern::Err(e); }
        }
        var bindings: Vec<Binding> = Vec::new();
        if self.match_tok(TokenKind::LParen) {
            loop {
                var bname: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(s) => { bname = s; }
                    ParseResultStr::Err(e) => { return ParseResultPattern::Err(e); }
                }
                var bty: str = "";
                if self.match_tok(TokenKind::Colon) {
                    match self.read_type_name() {
                        ParseResultStr::Ok(s) => { bty = s; }
                        ParseResultStr::Err(e) => { return ParseResultPattern::Err(e); }
                    }
                }
                bindings.push(Binding_new(bname, bty));
                if !self.match_tok(TokenKind::Comma) { break; }
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => { return ParseResultPattern::Err(e); }
                ParseResultUnit::Ok => {}
            }
        }
        return ParseResultPattern::Ok(Pattern::EnumVariant(name, variant, bindings));
    }
    if self.check(TokenKind::LParen) {
        self.advance();
        var bindings: Vec<Binding> = Vec::new();
        loop {
            var bname: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => { bname = s; }
                ParseResultStr::Err(e) => { return ParseResultPattern::Err(e); }
            }
            var bty: str = "";
            if self.match_tok(TokenKind::Colon) {
                match self.read_type_name() {
                    ParseResultStr::Ok(s) => { bty = s; }
                    ParseResultStr::Err(e) => { return ParseResultPattern::Err(e); }
                }
            }
            bindings.push(Binding_new(bname, bty));
            if !self.match_tok(TokenKind::Comma) { break; }
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => { return ParseResultPattern::Err(e); }
            ParseResultUnit::Ok => {}
        }
        return ParseResultPattern::Ok(Pattern::EnumVariant("", name, bindings));
    }
    return ParseResultPattern::Ok(Pattern::Ident(name));
}

return ParseResultPattern::Err(
    "Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) +
    ": invalid pattern '" + token_kind_to_str(tok.kind) + "'"
);
}

fn parse_expr(self: &mut Parser) -> ParseResultExpr {
return self.parse_pipe_forward();
}

fn parse_pipe_forward(self: &mut Parser) -> ParseResultExpr {
var left: Expr = Expr::IntLit(0);
match self.parse_coalesce() {
    ParseResultExpr::Ok(e) => { left = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
while self.match_tok(TokenKind::PipeArrow) {
    var right: Expr = Expr::IntLit(0);
    match self.parse_coalesce() {
        ParseResultExpr::Ok(e) => { right = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    left = Expr::PipeForward(Box::new(left), Box::new(right));
}
return ParseResultExpr::Ok(left);
}

fn parse_coalesce(self: &mut Parser) -> ParseResultExpr {
var left: Expr = Expr::IntLit(0);
match self.parse_range() {
    ParseResultExpr::Ok(e) => { left = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
while self.match_tok(TokenKind::QuestionQuestion) {
    var right: Expr = Expr::IntLit(0);
    match self.parse_range() {
        ParseResultExpr::Ok(e) => { right = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    left = Expr::Coalesce(Box::new(left), Box::new(right));
}
return ParseResultExpr::Ok(left);
}

fn parse_range(self: &mut Parser) -> ParseResultExpr {
var left: Expr = Expr::IntLit(0);
match self.parse_or() {
    ParseResultExpr::Ok(e) => { left = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
if self.check(TokenKind::DotDot) || self.check(TokenKind::DotDotEq) {
    var inclusive: bool = self.check(TokenKind::DotDotEq);
    self.advance();
    var right: Expr = Expr::IntLit(0);
    match self.parse_or() {
        ParseResultExpr::Ok(e) => { right = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    return ParseResultExpr::Ok(Expr::Range(Box::new(left), Box::new(right), inclusive));
}
return ParseResultExpr::Ok(left);
}

fn parse_or(self: &mut Parser) -> ParseResultExpr {
var left: Expr = Expr::IntLit(0);
match self.parse_bit_or() {
    ParseResultExpr::Ok(e) => { left = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
while self.match_tok(TokenKind::Or) {
    var right: Expr = Expr::IntLit(0);
    match self.parse_bit_or() {
        ParseResultExpr::Ok(e) => { right = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    left = Expr::Binary(BinOp::Or, Box::new(left), Box::new(right));
}
return ParseResultExpr::Ok(left);
}

fn parse_bit_or(self: &mut Parser) -> ParseResultExpr {
var left: Expr = Expr::IntLit(0);
match self.parse_bit_xor() {
    ParseResultExpr::Ok(e) => { left = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
while self.match_tok(TokenKind::Pipe) {
    var right: Expr = Expr::IntLit(0);
    match self.parse_bit_xor() {
        ParseResultExpr::Ok(e) => { right = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    left = Expr::Binary(BinOp::BitOr, Box::new(left), Box::new(right));
}
return ParseResultExpr::Ok(left);
}

fn parse_bit_xor(self: &mut Parser) -> ParseResultExpr {
var left: Expr = Expr::IntLit(0);
match self.parse_bit_and() {
    ParseResultExpr::Ok(e) => { left = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
while self.match_tok(TokenKind::Caret) {
    var right: Expr = Expr::IntLit(0);
    match self.parse_bit_and() {
        ParseResultExpr::Ok(e) => { right = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    left = Expr::Binary(BinOp::BitXor, Box::new(left), Box::new(right));
}
return ParseResultExpr::Ok(left);
}

fn parse_bit_and(self: &mut Parser) -> ParseResultExpr {
var left: Expr = Expr::IntLit(0);
match self.parse_shift() {
    ParseResultExpr::Ok(e) => { left = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
while self.match_tok(TokenKind::Ampersand) {
    var right: Expr = Expr::IntLit(0);
    match self.parse_shift() {
        ParseResultExpr::Ok(e) => { right = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    left = Expr::Binary(BinOp::BitAnd, Box::new(left), Box::new(right));
}
return ParseResultExpr::Ok(left);
}

fn parse_shift(self: &mut Parser) -> ParseResultExpr {
var left: Expr = Expr::IntLit(0);
match self.parse_and() {
    ParseResultExpr::Ok(e) => { left = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
loop {
    var op: BinOp = BinOp::Shl;
    var k: TokenKind = self.peek();
    if token_kind_eq(k, TokenKind::Shl) {
        op = BinOp::Shl;
    } else if token_kind_eq(k, TokenKind::Shr) {
        op = BinOp::Shr;
    } else {
        break;
    }
    self.advance();
    var right: Expr = Expr::IntLit(0);
    match self.parse_and() {
        ParseResultExpr::Ok(e) => { right = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    left = Expr::Binary(op, Box::new(left), Box::new(right));
}
return ParseResultExpr::Ok(left);
}

fn parse_and(self: &mut Parser) -> ParseResultExpr {
var left: Expr = Expr::IntLit(0);
match self.parse_equality() {
    ParseResultExpr::Ok(e) => { left = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
while self.match_tok(TokenKind::And) {
    var right: Expr = Expr::IntLit(0);
    match self.parse_equality() {
        ParseResultExpr::Ok(e) => { right = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    left = Expr::Binary(BinOp::And, Box::new(left), Box::new(right));
}
return ParseResultExpr::Ok(left);
}

fn parse_equality(self: &mut Parser) -> ParseResultExpr {
var left: Expr = Expr::IntLit(0);
match self.parse_comparison() {
    ParseResultExpr::Ok(e) => { left = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
loop {
    var op: BinOp = BinOp::Eq;
    var k: TokenKind = self.peek();
    if token_kind_eq(k, TokenKind::EqEq) {
        op = BinOp::Eq;
    } else if token_kind_eq(k, TokenKind::BangEq) {
        op = BinOp::Neq;
    } else {
        break;
    }
    self.advance();
    var right: Expr = Expr::IntLit(0);
    match self.parse_comparison() {
        ParseResultExpr::Ok(e) => { right = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    left = Expr::Binary(op, Box::new(left), Box::new(right));
}
return ParseResultExpr::Ok(left);
}

fn parse_comparison(self: &mut Parser) -> ParseResultExpr {
var left: Expr = Expr::IntLit(0);
match self.parse_addition() {
    ParseResultExpr::Ok(e) => { left = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
// `is` type/variant check
if self.match_tok(TokenKind::Is) {
    var peek_k: TokenKind = self.peek();
    var type_name: str = "";
    var got_name: bool = true;
    match peek_k {
        TokenKind::Ident(name: str) => { self.advance(); type_name = name; }
        TokenKind::I8 => { self.advance(); type_name = "i8"; }
        TokenKind::I16 => { self.advance(); type_name = "i16"; }
        TokenKind::I32 => { self.advance(); type_name = "i32"; }
        TokenKind::I64 => { self.advance(); type_name = "i64"; }
        TokenKind::I128 => { self.advance(); type_name = "i128"; }
        TokenKind::U8 => { self.advance(); type_name = "u8"; }
        TokenKind::U16 => { self.advance(); type_name = "u16"; }
        TokenKind::U32 => { self.advance(); type_name = "u32"; }
        TokenKind::U64 => { self.advance(); type_name = "u64"; }
        TokenKind::U128 => { self.advance(); type_name = "u128"; }
        TokenKind::F32 => { self.advance(); type_name = "f32"; }
        TokenKind::F64 => { self.advance(); type_name = "f64"; }
        TokenKind::Bool => { self.advance(); type_name = "bool"; }
        TokenKind::Str => { self.advance(); type_name = "str"; }
        TokenKind::Void => { self.advance(); type_name = "void"; }
    }
    if str_len(type_name) == 0 {
        return ParseResultExpr::Err("expected type name after 'is'");
    }
    return ParseResultExpr::Ok(Expr::IsCheck(Box::new(left), type_name));
}
loop {
    var op: BinOp = BinOp::Lt;
    var k: TokenKind = self.peek();
    if token_kind_eq(k, TokenKind::Lt) { op = BinOp::Lt; }
    else if token_kind_eq(k, TokenKind::Gt) { op = BinOp::Gt; }
    else if token_kind_eq(k, TokenKind::LtEq) { op = BinOp::LtEq; }
    else if token_kind_eq(k, TokenKind::GtEq) { op = BinOp::GtEq; }
    else { break; }
    self.advance();
    var right: Expr = Expr::IntLit(0);
    match self.parse_addition() {
        ParseResultExpr::Ok(e) => { right = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    left = Expr::Binary(op, Box::new(left), Box::new(right));
}
return ParseResultExpr::Ok(left);
}

fn parse_addition(self: &mut Parser) -> ParseResultExpr {
var left: Expr = Expr::IntLit(0);
match self.parse_multiplication() {
    ParseResultExpr::Ok(e) => { left = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
loop {
    var op: BinOp = BinOp::Add;
    var k: TokenKind = self.peek();
    if token_kind_eq(k, TokenKind::Plus) { op = BinOp::Add; }
    else if token_kind_eq(k, TokenKind::Minus) { op = BinOp::Sub; }
    else { break; }
    self.advance();
    var right: Expr = Expr::IntLit(0);
    match self.parse_multiplication() {
        ParseResultExpr::Ok(e) => { right = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    left = Expr::Binary(op, Box::new(left), Box::new(right));
}
return ParseResultExpr::Ok(left);
}

fn parse_multiplication(self: &mut Parser) -> ParseResultExpr {
var left: Expr = Expr::IntLit(0);
match self.parse_unary() {
    ParseResultExpr::Ok(e) => { left = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
loop {
    var op: BinOp = BinOp::Mul;
    var k: TokenKind = self.peek();
    if token_kind_eq(k, TokenKind::Star) {
        op = BinOp::Mul;
    }
    else if token_kind_eq(k, TokenKind::Slash) { op = BinOp::Div; }
    else if token_kind_eq(k, TokenKind::Percent) { op = BinOp::Mod; }
    else { break; }
    self.advance();
    var right: Expr = Expr::IntLit(0);
    match self.parse_unary() {
        ParseResultExpr::Ok(e) => { right = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    left = Expr::Binary(op, Box::new(left), Box::new(right));
}
return ParseResultExpr::Ok(left);
}

fn parse_unary(self: &mut Parser) -> ParseResultExpr {
var k: TokenKind = self.peek();
if token_kind_eq(k, TokenKind::Minus) {
    self.advance();
    var expr: Expr = Expr::IntLit(0);
    match self.parse_unary() {
        ParseResultExpr::Ok(e) => { expr = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    return ParseResultExpr::Ok(Expr::Unary(UnaryOp::Neg, Box::new(expr)));
}
if token_kind_eq(k, TokenKind::Bang) {
    self.advance();
    var expr: Expr = Expr::IntLit(0);
    match self.parse_unary() {
        ParseResultExpr::Ok(e) => { expr = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    return ParseResultExpr::Ok(Expr::Unary(UnaryOp::Not, Box::new(expr)));
}
if token_kind_eq(k, TokenKind::Tilde) {
    self.advance();
    var expr: Expr = Expr::IntLit(0);
    match self.parse_unary() {
        ParseResultExpr::Ok(e) => { expr = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    return ParseResultExpr::Ok(Expr::Unary(UnaryOp::BitNot, Box::new(expr)));
}
if token_kind_eq(k, TokenKind::Ampersand) {
    self.advance();
    var is_mut: bool = self.match_tok(TokenKind::Mut);
    var expr: Expr = Expr::IntLit(0);
    match self.parse_unary() {
        ParseResultExpr::Ok(e) => { expr = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    return ParseResultExpr::Ok(Expr::Ref(Box::new(expr), is_mut));
}
if token_kind_eq(k, TokenKind::Star) {
    self.advance();
    var expr: Expr = Expr::IntLit(0);
    match self.parse_unary() {
        ParseResultExpr::Ok(e) => { expr = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    return ParseResultExpr::Ok(Expr::Deref(Box::new(expr)));
}
if token_kind_eq(k, TokenKind::Comptime) {
    self.advance();
    return self.parse_comptime_expr(0);
}
return self.parse_postfix();
}

fn parse_comptime_expr(self: &mut Parser, _line: i64) -> ParseResultExpr {
// comptime { block }
if self.check(TokenKind::LBrace) {
    self.advance();
    var stmts: Vec<Stmt> = Vec::new();
    while !self.check(TokenKind::RBrace) && !self.is_at_end() {
        match self.parse_stmt() {
            ParseResultStmt::Ok(s) => { stmts.push(s); }
            ParseResultStmt::Err(e) => { return ParseResultExpr::Err(e); }
        }
    }
    match self.expect(TokenKind::RBrace, "}") {
        ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
        ParseResultUnit::Ok => {}
    }
    self.match_tok(TokenKind::Semicolon);
    return ParseResultExpr::Ok(Expr::ComptimeBlock(stmts));
}
// comptime type_name(T) / is_struct(T) / ... -- compile-time reflection
match self.peek() {
    TokenKind::Ident(name) => {
        var has_op: bool = true;
        var op: ReflectOp = ReflectOp::TypeName;
        if name == "type_name" { op = ReflectOp::TypeName; }
        else if name == "is_struct" { op = ReflectOp::IsStruct; }
        else if name == "is_enum" { op = ReflectOp::IsEnum; }
        else if name == "field_count" { op = ReflectOp::FieldCount; }
        else if name == "field_names" { op = ReflectOp::FieldNames; }
        else if name == "field_types" { op = ReflectOp::FieldTypes; }
        else if name == "enum_variants" { op = ReflectOp::EnumVariants; }
        else if name == "struct_size" { op = ReflectOp::StructSize; }
        else if name == "field_offset" { op = ReflectOp::FieldOffset; }
        else if name == "enum_discriminant" { op = ReflectOp::EnumDiscriminant; }
        else if name == "function_effects" { op = ReflectOp::FunctionEffects; }
        else if name == "function_capabilities" { op = ReflectOp::FunctionCapabilities; }
        else { has_op = false; }
        if has_op {
            self.advance();
            match self.expect(TokenKind::LParen, "(") {
                ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
                ParseResultUnit::Ok => {}
            }
            var ty: Type = Type::Infer;
            var member_op: bool = false;
            var func_op: bool = false;
            match op {
                ReflectOp::FieldOffset => { member_op = true; }
                ReflectOp::EnumDiscriminant => { member_op = true; }
                ReflectOp::FunctionEffects => { func_op = true; }
                ReflectOp::FunctionCapabilities => { func_op = true; }
                _ => {}
            }
            if member_op {
                // Owner.member (or Owner::member), kept as "Owner.member"
                var owner: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(o) => { owner = o; }
                    ParseResultStr::Err(e) => { return ParseResultExpr::Err(e); }
                }
                if !self.match_tok(TokenKind::Dot) {
                    match self.expect(TokenKind::DoubleColon, ".") {
                        ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
                        ParseResultUnit::Ok => {}
                    }
                }
                match self.expect_ident_or_keyword() {
                    ParseResultStr::Ok(m) => { ty = Type::Named(owner + "." + m); }
                    ParseResultStr::Err(e) => { return ParseResultExpr::Err(e); }
                }
            } else if func_op {
                match self.expect_ident_or_keyword() {
                    ParseResultStr::Ok(fname) => { ty = Type::Named(fname); }
                    ParseResultStr::Err(e) => { return ParseResultExpr::Err(e); }
                }
            } else {
                match self.parse_type() {
                    ParseResultType::Ok(t) => { ty = t; }
                    ParseResultType::Err(e) => { return ParseResultExpr::Err(e); }
                }
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
                ParseResultUnit::Ok => {}
            }
            self.match_tok(TokenKind::Semicolon);
            return ParseResultExpr::Ok(Expr::ComptimeReflect(op, ty));
        }
    }
    _ => {}
}
// comptime <expr>
var inner: Expr = Expr::IntLit(0);
match self.parse_unary() {
    ParseResultExpr::Ok(e) => { inner = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
self.match_tok(TokenKind::Semicolon);
return ParseResultExpr::Ok(Expr::Comptime(Box::new(inner)));
}

fn parse_postfix(self: &mut Parser) -> ParseResultExpr {
var expr: Expr = Expr::IntLit(0);
match self.parse_primary() {
    ParseResultExpr::Ok(e) => { expr = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
loop {
    if self.match_tok(TokenKind::Dot) {
        var field: str = "";
        match self.expect_ident_or_keyword() {
            ParseResultStr::Ok(s) => { field = s; }
            ParseResultStr::Err(e) => { return ParseResultExpr::Err(e); }
        }
        if self.match_tok(TokenKind::LParen) {
            // Method call
            var args: Vec<Expr> = Vec::new();
            if !self.check(TokenKind::RParen) {
                loop {
                    match self.parse_expr() {
                        ParseResultExpr::Ok(e) => { args.push(e); }
                        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
                    }
                    if !self.match_tok(TokenKind::Comma) { break; }
                }
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
                ParseResultUnit::Ok => {}
            }
            expr = Expr::MethodCall(Box::new(expr), field, args);
        } else {
            expr = Expr::FieldAccess(Box::new(expr), field);
        }
    } else if self.match_tok(TokenKind::QuestionDot) {
        var field: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => { field = s; }
            ParseResultStr::Err(e) => { return ParseResultExpr::Err(e); }
        }
        expr = Expr::OptionalFieldAccess(Box::new(expr), field);
    } else if self.match_tok(TokenKind::LBracket) {
        var index: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => { index = e; }
            ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
        }
        match self.expect(TokenKind::RBracket, "]") {
            ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
            ParseResultUnit::Ok => {}
        }
        expr = Expr::Index(Box::new(expr), Box::new(index));
    } else if self.match_tok(TokenKind::Question) {
        expr = Expr::Try(Box::new(expr));
    } else if self.match_tok(TokenKind::As) {
        var target_ty: Type = Type::Void;
        match self.parse_type() {
            ParseResultType::Ok(t) => { target_ty = t; }
            ParseResultType::Err(e) => { return ParseResultExpr::Err(e); }
        }
        expr = Expr::Cast(Box::new(expr), target_ty);
    } else if self.match_tok(TokenKind::TildeArrow) {
        var target_ty: Type = Type::Void;
        match self.parse_type() {
            ParseResultType::Ok(t) => { target_ty = t; }
            ParseResultType::Err(e) => { return ParseResultExpr::Err(e); }
        }
        expr = Expr::QuantCast(Box::new(expr), target_ty);
    } else {
        break;
    }
}
return ParseResultExpr::Ok(expr);
}

fn parse_match_expr(self: &mut Parser) -> ParseResultExpr {
match self.expect(TokenKind::Match, "match") {
    ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
    ParseResultUnit::Ok => {}
}
var expr: Expr = Expr::IntLit(0);
match self.parse_expr() {
    ParseResultExpr::Ok(e) => { expr = e; }
    ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
    ParseResultUnit::Ok => {}
}
var arms: Vec<MatchArm> = Vec::new();
while !self.check(TokenKind::RBrace) && !self.is_at_end() {
    var pattern: Pattern = Pattern::Wildcard;
    match self.parse_pattern() {
        ParseResultPattern::Ok(p) => { pattern = p; }
        ParseResultPattern::Err(e) => { return ParseResultExpr::Err(e); }
    }
    var match_guard: OptBoxExpr = OptBoxExpr::None;
    if self.check(TokenKind::If) {
        self.advance();
        match self.parse_expr() {
            ParseResultExpr::Ok(g) => { match_guard = OptBoxExpr::Some(Box::new(g)); }
            ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
        }
    }
    match self.expect(TokenKind::FatArrow, "=>") {
        ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var body: Vec<Stmt> = Vec::new();
    if self.check(TokenKind::LBrace) {
        self.advance();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => { body = b; }
            ParseResultStmts::Err(e) => { return ParseResultExpr::Err(e); }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
            ParseResultUnit::Ok => {}
        }
    } else {
        var line: i64 = self.peek_token().line;
        var e: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(pe) => { e = pe; }
            ParseResultExpr::Err(pe_err) => { return ParseResultExpr::Err(pe_err); }
        }
        body.push(Stmt::Expr(e, line));
    }
    self.match_tok(TokenKind::Comma);
    arms.push(MatchArm_new(pattern, match_guard, body));
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultExpr::Ok(Expr::Match(Box::new(expr), arms));
}

// Helper: parse call arguments and build a Call expr.
// Assumes LParen was already consumed. Consumes RParen.
fn parse_call_expr(self: &mut Parser, callee: str) -> ParseResultExpr {
var args: Vec<Expr> = Vec::new();
if !self.check(TokenKind::RParen) {
    loop {
        // Check for named argument: ident : expr
        var tok = self.peek_token();
        var is_named = false;
        match tok.kind {
            TokenKind::Ident(name) => {
                if self.pos + 1 < self.tokens.len() {
                    var next_tok = self.tokens.get(self.pos + 1);
                    match next_tok.kind {
                        TokenKind::Colon => { is_named = true; }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        if is_named {
            var arg_name: str = "";
            match self.expect_ident_or_keyword() {
                ParseResultStr::Ok(s) => { arg_name = s; }
                ParseResultStr::Err(e) => { return ParseResultExpr::Err(e); }
            }
            match self.expect(TokenKind::Colon, ":") {
                ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
                ParseResultUnit::Ok => {}
            }
            match self.parse_expr() {
                ParseResultExpr::Ok(e) => { args.push(Expr::NamedArg(arg_name, Box::new(e))); }
                ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
            }
        } else {
            match self.parse_expr() {
                ParseResultExpr::Ok(e) => { args.push(e); }
                ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
            }
        }
        if !self.match_tok(TokenKind::Comma) { break; }
    }
}
match self.expect(TokenKind::RParen, ")") {
    ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultExpr::Ok(Expr::Call(callee, args));
}

// Helper: parse struct literal body. Assumes LBrace was already consumed.
// Consumes RBrace.
fn parse_struct_lit_expr(self: &mut Parser, name: str) -> ParseResultExpr {
var fields: Vec<FieldInit> = Vec::new();
var spread: OptBoxExpr = OptBoxExpr::None;
if !self.check(TokenKind::RBrace) {
    loop {
        if self.check(TokenKind::DotDot) {
            self.advance();
            match self.parse_expr() {
                ParseResultExpr::Ok(se) => { spread = OptBoxExpr::Some(Box::new(se)); }
                ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
            }
            if !self.match_tok(TokenKind::Comma) { break; }
            if self.check(TokenKind::RBrace) { break; }
            continue;
        }
        var fname: str = "";
        match self.expect_ident_or_keyword() {
            ParseResultStr::Ok(s) => { fname = s; }
            ParseResultStr::Err(e) => { return ParseResultExpr::Err(e); }
        }
        match self.expect(TokenKind::Colon, ":") {
            ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
            ParseResultUnit::Ok => {}
        }
        var fval: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => { fval = e; }
            ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
        }
        fields.push(FieldInit_new(fname, fval));
        if !self.match_tok(TokenKind::Comma) { break; }
        if self.check(TokenKind::RBrace) { break; }
    }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultExpr::Ok(Expr::StructLit(name, fields, spread));
}

// Helper: parse comma-separated expr list inside ( ... ).
// Assumes LParen was already consumed. Consumes RParen.
fn parse_expr_list(self: &mut Parser) -> ParseResultExprs {
var args: Vec<Expr> = Vec::new();
if !self.check(TokenKind::RParen) {
    loop {
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => { args.push(e); }
            ParseResultExpr::Err(e) => { return ParseResultExprs::Err(e); }
        }
        if !self.match_tok(TokenKind::Comma) { break; }
    }
}
match self.expect(TokenKind::RParen, ")") {
    ParseResultUnit::Err(e) => { return ParseResultExprs::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultExprs::Ok(args);
}

// Helper: parse tuple rest after first element and comma.
// Assumes LParen and first expr were already consumed, and comma was matched.
// Consumes RParen.
fn parse_tuple_rest(self: &mut Parser, first: Expr) -> ParseResultExpr {
var elems: Vec<Expr> = Vec::new();
elems.push(first);
loop {
    self.expr_depth = self.expr_depth + 1;
    match self.parse_expr() {
        ParseResultExpr::Ok(e) => { elems.push(e); }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    self.expr_depth = self.expr_depth - 1;
    if !self.match_tok(TokenKind::Comma) { break; }
}
match self.expect(TokenKind::RParen, ")") {
    ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultExpr::Ok(Expr::TupleLit(elems));
}

fn parse_primary(self: &mut Parser) -> ParseResultExpr {
var tok: Token = self.peek_token();
var k: TokenKind = tok.kind;

// IntLit
match k {
    TokenKind::IntLit(n: i64) => {
        self.advance();
        return ParseResultExpr::Ok(Expr::IntLit(n));
    }
}
// FloatLit
match k {
    TokenKind::FloatLit(f: f64) => {
        self.advance();
        return ParseResultExpr::Ok(Expr::FloatLit(f));
    }
}
// StringLit
match k {
    TokenKind::StringLit(s: str) => {
        self.advance();
        return ParseResultExpr::Ok(Expr::StringLit(s));
    }
}
// FString
match k {
    TokenKind::FString(s: str) => {
        self.advance();
        return self.parse_fstring_parts(s);
    }
}
// Array literal: [val, val, ...]
if token_kind_eq(k, TokenKind::LBracket) {
    self.advance();
    var elements: Vec<Expr> = Vec::new();
    if !self.check(TokenKind::RBracket) {
        loop {
            match self.parse_expr() {
                ParseResultExpr::Ok(e) => { elements.push(e); }
                ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
            }
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::RBracket, "]") {
        ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
        ParseResultUnit::Ok => {}
    }
    return ParseResultExpr::Ok(Expr::ArrayLit(Box::new(Type::I64), elements));
}
if token_kind_eq(k, TokenKind::True) {
    self.advance();
    return ParseResultExpr::Ok(Expr::BoolLit(true));
}
if token_kind_eq(k, TokenKind::False) {
    self.advance();
    return ParseResultExpr::Ok(Expr::BoolLit(false));
}
// Closure: fn(params) -> ret { body } or fn(params) => expr
if token_kind_eq(k, TokenKind::Fn) {
    self.advance();
    match self.expect(TokenKind::LParen, "(") {
        ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var params: Vec<Param> = Vec::new();
    match self.parse_params() {
        ParseResultParams::Ok(p) => { params = p; }
        ParseResultParams::Err(e) => { return ParseResultExpr::Err(e); }
    }
    match self.expect(TokenKind::RParen, ")") {
        ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var ret_ty: OptType = OptType::None;
    if self.match_tok(TokenKind::Arrow) {
        var peek_k: TokenKind = self.peek();
        var is_type: bool = false;
        if starts_type(peek_k) {
            is_type = true;
        } else {
            match peek_k {
                TokenKind::Ident(_: str) => { is_type = true; }
            }
        }
        if is_type {
            match self.parse_type() {
                ParseResultType::Ok(t) => { ret_ty = OptType::Some(t); }
                ParseResultType::Err(e) => { return ParseResultExpr::Err(e); }
            }
        }
    }
    if self.match_tok(TokenKind::FatArrow) {
        // Expression closure: fn(x) => expr
        var line: i64 = self.peek_token().line;
        var e: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(pe) => { e = pe; }
            ParseResultExpr::Err(pe_err) => { return ParseResultExpr::Err(pe_err); }
        }
        var body: Vec<Stmt> = Vec::new();
        body.push(Stmt::Expr(e, line));
        return ParseResultExpr::Ok(Expr::Closure(params, body, ret_ty));
    } else {
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
            ParseResultUnit::Ok => {}
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => { body = b; }
            ParseResultStmts::Err(e) => { return ParseResultExpr::Err(e); }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
            ParseResultUnit::Ok => {}
        }
        return ParseResultExpr::Ok(Expr::Closure(params, body, ret_ty));
    }
}
// Block-as-expression: { stmt; stmt; expr }
if token_kind_eq(k, TokenKind::LBrace) {
    self.advance();
    var block: Vec<Stmt> = Vec::new();
    match self.parse_block() {
        ParseResultStmts::Ok(b) => { block = b; }
        ParseResultStmts::Err(e) => { return ParseResultExpr::Err(e); }
    }
    match self.expect(TokenKind::RBrace, "}") {
        ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
        ParseResultUnit::Ok => {}
    }
    return ParseResultExpr::Ok(Expr::Block(block));
}
// Identifier or function call
if token_kind_eq(k, TokenKind::Ident("")) {
    var name: str = "";
    match tok.kind {
        TokenKind::Ident(s: str) => { name = s; }
    }
    self.advance();
    // Check for asm! macro
    if name == "asm" && self.match_tok(TokenKind::Bang) {
        return self.parse_asm();
    }
    if self.match_tok(TokenKind::LParen) {
        return self.parse_call_expr(name);
    }
    if self.check(TokenKind::LBrace) && self.is_struct_name(name) {
        self.advance();
        return self.parse_struct_lit_expr(name);
    }
    if self.check(TokenKind::DoubleColon) {
        self.advance();
        var variant_or_method: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => { variant_or_method = s; }
            ParseResultStr::Err(e) => { return ParseResultExpr::Err(e); }
        }
        var args: Vec<Expr> = Vec::new();
        if self.match_tok(TokenKind::LParen) {
            match self.parse_expr_list() {
                ParseResultExprs::Ok(a) => { args = a; }
                ParseResultExprs::Err(e) => { return ParseResultExpr::Err(e); }
            }
        }
        if self.is_enum_name(name) {
            return ParseResultExpr::Ok(Expr::EnumLit(name, variant_or_method, args));
        } else {
            return ParseResultExpr::Ok(Expr::MethodCall(Box::new(Expr::Ident(name)), variant_or_method, args));
        }
    }
    return ParseResultExpr::Ok(Expr::Ident(name));
}
// Parenthesized expression or tuple
if token_kind_eq(k, TokenKind::LParen) {
    self.advance();
    self.expr_depth = self.expr_depth + 1;
    var first: Expr = Expr::IntLit(0);
    match self.parse_expr() {
        ParseResultExpr::Ok(e) => { first = e; }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
    self.expr_depth = self.expr_depth - 1;
    if self.match_tok(TokenKind::Comma) {
        return self.parse_tuple_rest(first);
    }
    match self.expect(TokenKind::RParen, ")") {
        ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
        ParseResultUnit::Ok => {}
    }
    return ParseResultExpr::Ok(first);
}
// If expression
if token_kind_eq(k, TokenKind::If) {
    match self.parse_if_expr() {
        ParseResultIfExpr::Ok(ie) => {
            return ParseResultExpr::Ok(Expr::If(Box::new(ie.cond), ie.then_block, ie.else_block));
        }
        ParseResultIfExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
}
// Match expression
if token_kind_eq(k, TokenKind::Match) {
    return self.parse_match_expr();
}
// Try block
if token_kind_eq(k, TokenKind::Try) {
    self.advance();
    match self.expect(TokenKind::LBrace, "{") {
        ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var body: Vec<Stmt> = Vec::new();
    match self.parse_block() {
        ParseResultStmts::Ok(b) => { body = b; }
        ParseResultStmts::Err(e) => { return ParseResultExpr::Err(e); }
    }
    match self.expect(TokenKind::RBrace, "}") {
        ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
        ParseResultUnit::Ok => {}
    }
    return ParseResultExpr::Ok(Expr::TryBlock(body));
}
// Await
if token_kind_eq(k, TokenKind::Await) {
    self.advance();
    var e: Expr = Expr::IntLit(0);
    match self.parse_unary() {
        ParseResultExpr::Ok(ae) => { e = ae; }
        ParseResultExpr::Err(e2) => { return ParseResultExpr::Err(e2); }
    }
    return ParseResultExpr::Ok(Expr::Await(Box::new(e)));
}
// Spawn
if token_kind_eq(k, TokenKind::Spawn) {
    self.advance();
    var e: Expr = Expr::IntLit(0);
    match self.parse_unary() {
        ParseResultExpr::Ok(ae) => { e = ae; }
        ParseResultExpr::Err(e2) => { return ParseResultExpr::Err(e2); }
    }
    return ParseResultExpr::Ok(Expr::Spawn(Box::new(e)));
}
// Yield
if token_kind_eq(k, TokenKind::Yield) {
    self.advance();
    var e: Expr = Expr::IntLit(0);
    match self.parse_unary() {
        ParseResultExpr::Ok(ae) => { e = ae; }
        ParseResultExpr::Err(e2) => { return ParseResultExpr::Err(e2); }
    }
    return ParseResultExpr::Ok(Expr::Yield(Box::new(e)));
}
// Word keywords as identifiers (e.g. query, move as variable names)
if is_word_keyword(k) {
    var kw_str: str = token_kind_to_str(k);
    self.advance();
    return ParseResultExpr::Ok(Expr::Ident(kw_str));
}
// Not a valid primary expression
return ParseResultExpr::Err(
    "Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) +
    ": unexpected token '" + token_kind_to_str(k) + "'"
);
}

fn parse_asm(self: &mut Parser) -> ParseResultExpr {
match self.expect(TokenKind::LParen, "(") {
    ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
    ParseResultUnit::Ok => {}
}
// Template string
var template: str = "";
var ttok: Token = self.peek_token();
match ttok.kind {
    TokenKind::StringLit(s: str) => {
        self.advance();
        template = s;
    }
}
if str_len(template) == 0 {
    return ParseResultExpr::Err("Parse error: asm! first argument must be a string template");
}
// Operands
var operands: Vec<AsmOperand> = Vec::new();
while self.match_tok(TokenKind::Comma) {
    var direction: AsmDir = AsmDir::In;
    var is_clobber: bool = false;
    var dtok: Token = self.peek_token();
    var got_dir: bool = true;
    if token_kind_eq(dtok.kind, TokenKind::In) {
        self.advance();
        direction = AsmDir::In;
    } else {
        match dtok.kind {
            TokenKind::Ident(s: str) => {
                if s == "out" {
                    self.advance();
                    direction = AsmDir::Out;
                } else if s == "clobber" {
                    self.advance();
                    direction = AsmDir::Clobber;
                    is_clobber = true;
                } else {
                    got_dir = false;
                }
            }
        }
        if !got_dir {
            return ParseResultExpr::Err("Parse error: asm! operand must start with 'in', 'out', or 'clobber'");
        }
    }
    match self.expect(TokenKind::LParen, "(") {
        ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var reg: str = "";
    var rtok: Token = self.peek_token();
    match rtok.kind {
        TokenKind::StringLit(s: str) => {
            self.advance();
            reg = s;
        }
    }
    if str_len(reg) == 0 {
        return ParseResultExpr::Err("Parse error: asm! register must be a string");
    }
    match self.expect(TokenKind::RParen, ")") {
        ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
        ParseResultUnit::Ok => {}
    }
    // Clobber operands don't have an expression — use IntLit(0) as placeholder
    var expr: Expr = Expr::IntLit(0);
    if !is_clobber {
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => { expr = e; }
            ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
        }
    }
    operands.push(AsmOperand_new(direction, reg, expr));
}
match self.expect(TokenKind::RParen, ")") {
    ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultExpr::Ok(Expr::Asm(template, operands));
}

fn peek_bin_op(self: &Parser) -> BinOpInfo {
var k: TokenKind = self.peek();
if token_kind_eq(k, TokenKind::PipeArrow) { return BinOpInfo_new(BinOp::Or, 1, true); }
if token_kind_eq(k, TokenKind::QuestionQuestion) { return BinOpInfo_new(BinOp::Or, 2, true); }
if token_kind_eq(k, TokenKind::Or) { return BinOpInfo_new(BinOp::Or, 4, true); }
if token_kind_eq(k, TokenKind::Pipe) { return BinOpInfo_new(BinOp::BitOr, 5, true); }
if token_kind_eq(k, TokenKind::Caret) { return BinOpInfo_new(BinOp::BitXor, 6, true); }
if token_kind_eq(k, TokenKind::Ampersand) { return BinOpInfo_new(BinOp::BitAnd, 7, true); }
if token_kind_eq(k, TokenKind::Shl) { return BinOpInfo_new(BinOp::Shl, 8, true); }
if token_kind_eq(k, TokenKind::Shr) { return BinOpInfo_new(BinOp::Shr, 8, true); }
if token_kind_eq(k, TokenKind::And) { return BinOpInfo_new(BinOp::And, 9, true); }
if token_kind_eq(k, TokenKind::EqEq) { return BinOpInfo_new(BinOp::Eq, 10, true); }
if token_kind_eq(k, TokenKind::BangEq) { return BinOpInfo_new(BinOp::Neq, 10, true); }
if token_kind_eq(k, TokenKind::Lt) { return BinOpInfo_new(BinOp::Lt, 11, true); }
if token_kind_eq(k, TokenKind::Gt) { return BinOpInfo_new(BinOp::Gt, 11, true); }
if token_kind_eq(k, TokenKind::LtEq) { return BinOpInfo_new(BinOp::LtEq, 11, true); }
if token_kind_eq(k, TokenKind::GtEq) { return BinOpInfo_new(BinOp::GtEq, 11, true); }
if token_kind_eq(k, TokenKind::Plus) { return BinOpInfo_new(BinOp::Add, 12, true); }
if token_kind_eq(k, TokenKind::Minus) { return BinOpInfo_new(BinOp::Sub, 12, true); }
if token_kind_eq(k, TokenKind::Star) { return BinOpInfo_new(BinOp::Mul, 13, true); }
if token_kind_eq(k, TokenKind::Slash) { return BinOpInfo_new(BinOp::Div, 13, true); }
if token_kind_eq(k, TokenKind::Percent) { return BinOpInfo_new(BinOp::Mod, 13, true); }
return BinOpInfo_new(BinOp::Add, 0, false);
}

fn parse_expr_iterative(self: &mut Parser) -> ParseResultExpr {
var vals: Vec<Expr> = Vec::new();
var ops: Vec<OpEntry> = Vec::new();
var need_primary: bool = true;

loop {
    if need_primary {
        if self.check(TokenKind::LParen) {
            self.advance();
            ops.push(OpEntry::Paren);
            if self.check(TokenKind::RParen) {
                self.advance();
                // Empty tuple ()
                if ops.len() > 0 {
                    ops.pop();
                }
                vals.push(Expr::TupleLit(Vec::new()));
                need_primary = false;
            }
        } else {
            match self.parse_primary() {
                ParseResultExpr::Ok(e) => { vals.push(e); }
                ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
            }
            need_primary = false;
        }
    } else {
        var bop: BinOp = BinOp::Add;
        var prec: i64 = 0;
        var found: bool = false;
        var info: BinOpInfo = self.peek_bin_op();
        bop = info.op;
        prec = info.prec;
        found = info.found;
        if found {
            self.advance();
            // Pop higher-or-equal precedence (left-associative)
            while ops.len() > 0 {
                var top: OpEntry = ops.get(ops.len() - 1);
                var top_prec: i64 = 0;
                var is_op: bool = false;
                match top {
                    OpEntry::Op(_: BinOp, tp: i64) => { top_prec = tp; is_op = true; }
                    OpEntry::Paren => { break; }
                }
                if is_op && top_prec >= prec {
                    if !reduce_one_op(vals, ops) { break; }
                } else {
                    break;
                }
            }
            ops.push(OpEntry::Op(bop, prec));
            need_primary = true;
        } else if self.check(TokenKind::RParen) {
            // Close paren -- pop until Paren marker
            var found_paren: bool = false;
            while ops.len() > 0 {
                var top: OpEntry = ops.get(ops.len() - 1);
                var is_paren: bool = false;
                match top {
                    OpEntry::Paren => { is_paren = true; }
                    OpEntry::Op => {}
                }
                if is_paren {
                    ops.pop();
                    found_paren = true;
                    break;
                }
                if !reduce_one_op(vals, ops) { break; }
            }
            if found_paren {
                self.advance();
                // Check for tuple
                if self.check(TokenKind::Comma) {
                    var elems: Vec<Expr> = Vec::new();
                    if vals.len() > 0 {
                        elems.push(vals.pop());
                    }
                    while self.match_tok(TokenKind::Comma) {
                        self.expr_depth = self.expr_depth + 1;
                        var elem: Expr = Expr::IntLit(0);
                        if self.expr_depth > self.max_expr_depth {
                            match self.parse_expr_iterative() {
                                ParseResultExpr::Ok(e) => { elem = e; }
                                ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
                            }
                        } else {
                            match self.parse_expr() {
                                ParseResultExpr::Ok(e) => { elem = e; }
                                ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
                            }
                        }
                        self.expr_depth = self.expr_depth - 1;
                        elems.push(elem);
                    }
                    match self.expect(TokenKind::RParen, ")") {
                        ParseResultUnit::Err(e) => { return ParseResultExpr::Err(e); }
                        ParseResultUnit::Ok => {}
                    }
                    vals.push(Expr::TupleLit(elems));
                }
            } else {
                break;
            }
        } else {
            break;
        }
    }
}

// Drain remaining operators
while ops.len() > 0 {
    var top: OpEntry = ops.get(ops.len() - 1);
    var is_paren: bool = false;
    match top {
        OpEntry::Paren => { is_paren = true; }
        OpEntry::Op => {}
    }
    if is_paren {
        return ParseResultExpr::Err("unmatched '(' in expression");
    }
    if !reduce_one_op(vals, ops) { break; }
}

if vals.len() == 0 {
    return ParseResultExpr::Err("expected expression");
}
return ParseResultExpr::Ok(vals.pop());
}

fn parse_use(self: &mut Parser) -> ParseResultImportDef {
match self.expect(TokenKind::Use, "use") {
    ParseResultUnit::Err(e) => { return ParseResultImportDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var is_glob: bool = false;
var path: str = "";
loop {
    if self.check(TokenKind::LBrace) { break; }
    if self.check(TokenKind::Star) {
        if str_ends_with(path, "::") {
            path = str_slice(path, 0, str_len(path) - 2);
        }
        self.advance();
        is_glob = true;
        break;
    }
    var name: str = "";
    match self.expect_ident() {
        ParseResultStr::Ok(s) => { name = s; }
        ParseResultStr::Err(e) => { return ParseResultImportDef::Err(e); }
    }
    path = path + name;
    if self.match_tok(TokenKind::DoubleColon) {
        path = path + "::";
    } else {
        break;
    }
}
// alias: use path as alias
var alias: OptStr = OptStr::None;
if self.match_tok(TokenKind::As) {
    match self.expect_ident() {
        ParseResultStr::Ok(s) => { alias = OptStr::Some(s); }
        ParseResultStr::Err(e) => { return ParseResultImportDef::Err(e); }
    }
}
// selective imports: { item1, item2 } or { * }
var items: Vec<str> = Vec::new();
if self.match_tok(TokenKind::LBrace) {
    if self.check(TokenKind::Star) {
        self.advance();
        is_glob = true;
    } else if !self.check(TokenKind::RBrace) {
        loop {
            var item: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => { item = s; }
                ParseResultStr::Err(e) => { return ParseResultImportDef::Err(e); }
            }
            items.push(item);
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::RBrace, "}") {
        ParseResultUnit::Err(e) => { return ParseResultImportDef::Err(e); }
        ParseResultUnit::Ok => {}
    }
}
// Strip trailing :: from path if items were specified
if (items.len() > 0 || is_glob) && str_ends_with(path, "::") {
    path = str_slice(path, 0, str_len(path) - 2);
}
// Check for capability grant: with { IO, FS }
var capabilities: Vec<str> = Vec::new();
if self.match_tok(TokenKind::With) {
    match self.expect(TokenKind::LBrace, "{") {
        ParseResultUnit::Err(e) => { return ParseResultImportDef::Err(e); }
        ParseResultUnit::Ok => {}
    }
    if !self.check(TokenKind::RBrace) {
        loop {
            var cap: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => { cap = s; }
                ParseResultStr::Err(e) => { return ParseResultImportDef::Err(e); }
            }
            capabilities.push(cap);
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::RBrace, "}") {
        ParseResultUnit::Err(e) => { return ParseResultImportDef::Err(e); }
        ParseResultUnit::Ok => {}
    }
}
// Check for version pin: = "0.1.0"
var version: OptStr = OptStr::None;
if self.match_tok(TokenKind::Eq) {
    var vtok: Token = self.peek_token();
    match vtok.kind {
        TokenKind::StringLit(s: str) => {
            self.advance();
            version = OptStr::Some(s);
        }
    }
    return ParseResultImportDef::Err(
        "Parse error at " + int_to_str(vtok.line) + ":" + int_to_str(vtok.col) +
        ": expected version string but got '" + token_kind_to_str(vtok.kind) + "'"
    );
}
self.match_tok(TokenKind::Semicolon);
var import_result: ImportDef = ImportDef_new_full(path, items, capabilities, version, alias, false, is_glob);
return ParseResultImportDef::Ok(import_result);
}

fn parse_at_annotation(self: &mut Parser) -> ParseResultAnnotation {
match self.expect(TokenKind::At, "@") {
    ParseResultUnit::Err(e) => { return ParseResultAnnotation::Err(e); }
    ParseResultUnit::Ok => {}
}
var name: str = "";
var tok: Token = self.peek_token();
match tok.kind {
    TokenKind::Ident(s: str) => {
        self.advance();
        var full_name: str = s;
        // Hyphenated name: ident - ident - ident ...
        while self.check(TokenKind::Minus) {
            self.advance();
            var ptok: Token = self.peek_token();
            match ptok.kind {
                TokenKind::Ident(part: str) => {
                    self.advance();
                    full_name = full_name + "-" + part;
                }
            }
        }
        name = full_name;
    }
    TokenKind::Kernel => { self.advance(); name = "kernel"; }
    TokenKind::Layer => { self.advance(); name = "layer"; }
    TokenKind::Model => { self.advance(); name = "model"; }
    TokenKind::Interrupt => { self.advance(); name = "interrupt"; }
}
if str_len(name) == 0 {
    var ptok: Token = self.peek_token();
    return ParseResultAnnotation::Err(
        "Parse error at " + int_to_str(ptok.line) + ":" + int_to_str(ptok.col) +
        ": expected annotation name after '@'"
    );
}
var args: Vec<str> = Vec::new();
if self.match_tok(TokenKind::LParen) {
    if !self.check(TokenKind::RParen) {
        loop {
            match self.parse_annotation_arg() {
                ParseResultStr::Ok(arg) => { args.push(arg); }
                ParseResultStr::Err(e) => { return ParseResultAnnotation::Err(e); }
            }
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::RParen, ")") {
        ParseResultUnit::Err(e) => { return ParseResultAnnotation::Err(e); }
        ParseResultUnit::Ok => {}
    }
}
var __ret_Annotation: Annotation = Annotation_new(name, args);
return ParseResultAnnotation::Ok(__ret_Annotation);
}

fn parse_annotation_arg(self: &mut Parser) -> ParseResultStr {
var arg: str = "";
var tok: Token = self.peek_token();
match tok.kind {
    TokenKind::Ident(s: str) => {
        self.advance();
        arg = s;
        if self.match_tok(TokenKind::Eq) {
            arg = arg + "=";
            match self.parse_annotation_arg() {
                ParseResultStr::Ok(rest) => { arg = arg + rest; }
                ParseResultStr::Err(e) => { return ParseResultStr::Err(e); }
            }
        }
        return ParseResultStr::Ok(arg);
    }
    TokenKind::IntLit(n: i64) => {
        self.advance();
        return ParseResultStr::Ok(int_to_str(n));
    }
    TokenKind::FloatLit(f: f64) => {
        self.advance();
        return ParseResultStr::Ok(float_to_str(f));
    }
    TokenKind::StringLit(s: str) => {
        self.advance();
        return ParseResultStr::Ok("\"" + s + "\"");
    }
    TokenKind::LBracket => {
    self.advance();
    arg = "[";
    loop {
        match self.parse_annotation_arg() {
            ParseResultStr::Ok(part) => { arg = arg + part; }
            ParseResultStr::Err(e) => { return ParseResultStr::Err(e); }
        }
        if !self.match_tok(TokenKind::Comma) { break; }
        arg = arg + ",";
    }
    match self.expect(TokenKind::RBracket, "]") {
        ParseResultUnit::Err(e) => { return ParseResultStr::Err(e); }
        ParseResultUnit::Ok => {}
    }
    arg = arg + "]";
    return ParseResultStr::Ok(arg);
}
}
return ParseResultStr::Err("Expected annotation argument, got '" + token_kind_to_str(tok.kind) + "'");
}

fn parse_attribute(self: &mut Parser) -> ParseResultAttribute {
match self.expect(TokenKind::Hash, "#") {
ParseResultUnit::Err(e) => { return ParseResultAttribute::Err(e); }
ParseResultUnit::Ok => {}
}
match self.expect(TokenKind::LBracket, "[") {
ParseResultUnit::Err(e) => { return ParseResultAttribute::Err(e); }
ParseResultUnit::Ok => {}
}
var name: str = "";
match self.expect_ident() {
ParseResultStr::Ok(s) => { name = s; }
ParseResultStr::Err(e) => { return ParseResultAttribute::Err(e); }
}
var args: Vec<str> = Vec::new();
if self.match_tok(TokenKind::LParen) {
if !self.check(TokenKind::RParen) {
    loop {
        var arg: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => { arg = s; }
            ParseResultStr::Err(e) => { return ParseResultAttribute::Err(e); }
        }
        args.push(arg);
        if !self.match_tok(TokenKind::Comma) { break; }
    }
}
match self.expect(TokenKind::RParen, ")") {
    ParseResultUnit::Err(e) => { return ParseResultAttribute::Err(e); }
    ParseResultUnit::Ok => {}
}
}
match self.expect(TokenKind::RBracket, "]") {
ParseResultUnit::Err(e) => { return ParseResultAttribute::Err(e); }
ParseResultUnit::Ok => {}
}
var __ret_Attribute: Attribute = Attribute_new(name, args);
return ParseResultAttribute::Ok(__ret_Attribute);
}

fn parse_fstring_parts(self: &mut Parser, raw: str) -> ParseResultExpr {
var parts: Vec<FStringPart> = Vec::new();
var current: str = "";
var i: i64 = 0;
var len: i64 = str_len(raw);

while i < len {
var c: i64 = str_byte_at(raw, i);
if c == 123 {
    // '{' -- start of interpolation
    if str_len(current) > 0 {
        parts.push(FStringPart::Literal(current));
        current = "";
    }
    // Read expression until matching '}'
    i = i + 1;
    var expr_src: str = "";
    var depth: i64 = 1;
    while i < len {
        var c2: i64 = str_byte_at(raw, i);
        if c2 == 123 {
            depth = depth + 1;
            expr_src = expr_src + byte_to_str(c2);
            i = i + 1;
        } else if c2 == 125 {
            depth = depth - 1;
            if depth == 0 {
                i = i + 1;
                break;
            }
            expr_src = expr_src + byte_to_str(c2);
            i = i + 1;
        } else {
            expr_src = expr_src + byte_to_str(c2);
            i = i + 1;
        }
    }
    // Re-lex and parse the expression
    var sub_lexer: Lexer = Lexer::new(expr_src);
    var sub_tokens: Vec<Token> = sub_lexer.tokenize();
    var sub_parser: Parser = Parser::new(sub_tokens);
    match sub_parser.parse_expr() {
        ParseResultExpr::Ok(e) => { parts.push(FStringPart::Expr(e)); }
        ParseResultExpr::Err(e) => { return ParseResultExpr::Err(e); }
    }
} else {
    current = current + byte_to_str(c);
    i = i + 1;
}
}
if str_len(current) > 0 {
parts.push(FStringPart::Literal(current));
}
return ParseResultExpr::Ok(Expr::FString(parts));
}
}  // close impl Parser block

pub fn Parser_with_names(tokens: Vec<Token>, struct_names: Vec<str>, enum_names: Vec<str>) -> Parser {
    // Build HashMaps for O(1) name lookup (string interning)
    var sn_set: i64 = HashMap_new();
    var si: i64 = 0;
    while si < struct_names.len() {
        HashMap_insert(sn_set, struct_names.get(si), 1);
        si = si + 1;
    }
    var en_set: i64 = HashMap_new();
    var ei: i64 = 0;
    while ei < enum_names.len() {
        HashMap_insert(en_set, enum_names.get(ei), 1);
        ei = ei + 1;
    }
    return Parser {
        tokens: tokens,
        pos: 0,
        struct_names: struct_names,
        enum_names: enum_names,
        struct_name_set: sn_set,
        enum_name_set: en_set,
        alias_to_struct: Vec::new(),
        errors: Vec::new(),
        expr_depth: 0,
        max_expr_depth: 256,
    };
}

// Helper: extract Expr from Box<Expr> (Fides has no * deref for Box)
pub fn vec_str_join(v: Vec<str>, sep: str) -> str {
var result: str = "";
var i: i64 = 0;
while i < v.len() {
if i > 0 {
    result = result + sep;
}
result = result + v.get(i);
i = i + 1;
}
return result;
}

pub fn is_int_type_keyword(kind: TokenKind) -> bool {
if token_kind_eq(kind, TokenKind::I8) { return true; }
if token_kind_eq(kind, TokenKind::I16) { return true; }
if token_kind_eq(kind, TokenKind::I32) { return true; }
if token_kind_eq(kind, TokenKind::I64) { return true; }
if token_kind_eq(kind, TokenKind::I128) { return true; }
if token_kind_eq(kind, TokenKind::U8) { return true; }
if token_kind_eq(kind, TokenKind::U16) { return true; }
if token_kind_eq(kind, TokenKind::U32) { return true; }
if token_kind_eq(kind, TokenKind::U64) { return true; }
if token_kind_eq(kind, TokenKind::U128) { return true; }
return false;
}

pub fn type_keyword_name(kind: TokenKind) -> str {
if token_kind_eq(kind, TokenKind::I8) { return "i8"; }
if token_kind_eq(kind, TokenKind::I16) { return "i16"; }
if token_kind_eq(kind, TokenKind::I32) { return "i32"; }
if token_kind_eq(kind, TokenKind::I64) { return "i64"; }
if token_kind_eq(kind, TokenKind::I128) { return "i128"; }
if token_kind_eq(kind, TokenKind::U8) { return "u8"; }
if token_kind_eq(kind, TokenKind::U16) { return "u16"; }
if token_kind_eq(kind, TokenKind::U32) { return "u32"; }
if token_kind_eq(kind, TokenKind::U64) { return "u64"; }
if token_kind_eq(kind, TokenKind::U128) { return "u128"; }
return "";
}

pub fn starts_type(kind: TokenKind) -> bool {
if token_kind_eq(kind, TokenKind::I8) { return true; }
if token_kind_eq(kind, TokenKind::I16) { return true; }
if token_kind_eq(kind, TokenKind::I32) { return true; }
if token_kind_eq(kind, TokenKind::I64) { return true; }
if token_kind_eq(kind, TokenKind::I128) { return true; }
if token_kind_eq(kind, TokenKind::U8) { return true; }
if token_kind_eq(kind, TokenKind::U16) { return true; }
if token_kind_eq(kind, TokenKind::U32) { return true; }
if token_kind_eq(kind, TokenKind::U64) { return true; }
if token_kind_eq(kind, TokenKind::U128) { return true; }
if token_kind_eq(kind, TokenKind::F32) { return true; }
if token_kind_eq(kind, TokenKind::F64) { return true; }
if token_kind_eq(kind, TokenKind::Bool) { return true; }
if token_kind_eq(kind, TokenKind::Str) { return true; }
if token_kind_eq(kind, TokenKind::Void) { return true; }
if token_kind_eq(kind, TokenKind::Fn) { return true; }
if token_kind_eq(kind, TokenKind::Ampersand) { return true; }
if token_kind_eq(kind, TokenKind::Star) { return true; }
if token_kind_eq(kind, TokenKind::LBracket) { return true; }
if token_kind_eq(kind, TokenKind::LParen) { return true; }
if token_kind_eq(kind, TokenKind::Dyn) { return true; }
// Ident -- but we can't check payload here without the token. Caller handles.
return false;
}

pub enum ParseResultIfExpr {
Ok(IfExpr),
Err(str),
}

pub struct BinOpInfo {
pub op: BinOp,
pub prec: i64,
pub found: bool,
}

pub fn BinOpInfo_new(op: BinOp, prec: i64, found: bool) -> BinOpInfo {
return BinOpInfo { op: op, prec: prec, found: found };
}

pub fn reduce_one_op(vals: Vec<Expr>, ops: Vec<OpEntry>) -> bool {
if ops.len() == 0 { return false; }
if vals.len() < 2 { return false; }
var op_entry: OpEntry = ops.pop();
match op_entry {
OpEntry::Op(bop: BinOp, _: i64) => {
    var right: Expr = vals.pop();
    var left: Expr = vals.pop();
    vals.push(Expr::Binary(bop, Box::new(left), Box::new(right)));
    return true;
}
OpEntry::Paren => {
    // Put it back -- shouldn't reduce Paren
    ops.push(OpEntry::Paren);
    return false;
}
}
return false;
}
