    fn parse_pattern(self: &mut Parser, nests: &mut Vec<PatNest>, ctr: &mut i64) -> ParseResultPattern {
        var tok: Token = self.peek_token();
        var k: TokenKind = tok.kind;

        if token_kind_eq(k, TokenKind::IntLit(0)) {
            var n: i64 = 0;
            match tok.kind {
                TokenKind::IntLit(v: i64) => {
                    n = v;
                }
                _ => {
                }
            }
            self.advance();
            // Range pattern: 1..=3 or 1..5
            if self.check(TokenKind::DotDotEq) {
                self.advance();
                var end_tok: Token = self.peek_token();
                match end_tok.kind {
                    TokenKind::IntLit(m: i64) => {
                        self.advance();
                        return ParseResultPattern::Ok(Pattern::Range(Box::new(Pattern::IntLit(n)), Box::new(Pattern::IntLit(m + 1))));
                    }
                    _ => {
                    }
                }
                return ParseResultPattern::Err("Parse error at " + int_to_str(end_tok.line) + ":" + int_to_str(end_tok.col) + ": expected int after ..=\n    Fix: end a range pattern with an integer literal, as in `0..=9`");
            }
            if self.check(TokenKind::DotDot) {
                self.advance();
                var end_tok: Token = self.peek_token();
                match end_tok.kind {
                    TokenKind::IntLit(m: i64) => {
                        self.advance();
                        return ParseResultPattern::Ok(Pattern::Range(Box::new(Pattern::IntLit(n)), Box::new(Pattern::IntLit(m))));
                    }
                    _ => {
                    }
                }
                return ParseResultPattern::Err("Parse error at " + int_to_str(end_tok.line) + ":" + int_to_str(end_tok.col) + ": expected int after ..\n    Fix: end a range pattern with an integer literal, as in `0..10`");
            }
            return ParseResultPattern::Ok(Pattern::IntLit(n));
        }

        if token_kind_eq(k, TokenKind::StringLit("")) {
            var s: str = "";
            match tok.kind {
                TokenKind::StringLit(v: str) => {
                    s = v;
                }
                _ => {
                }
            }
            self.advance();
            return ParseResultPattern::Ok(Pattern::StrLit(s));
        }

        if token_kind_eq(k, TokenKind::True) {
            self.advance();
            return ParseResultPattern::Ok(Pattern::BoolLit(true));
        }
        if token_kind_eq(k, TokenKind::False) {
            self.advance();
            return ParseResultPattern::Ok(Pattern::BoolLit(false));
        }

        if token_kind_eq(k, TokenKind::Ident("")) {
            var name: str = "";
            match tok.kind {
                TokenKind::Ident(v: str) => {
                    name = v;
                }
                _ => {
                }
            }
            self.advance();
            if name == "_" {
                return ParseResultPattern::Ok(Pattern::Wildcard);
            }
            if self.check(TokenKind::DoubleColon) {
                self.advance();
                var variant: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(s) => {
                        variant = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultPattern::Err(e);
                    }
                }
                var bindings: Vec<Binding> = Vec::new();
                if self.match_tok(TokenKind::LParen) {
                    loop {
                        match self.parse_pat_arg(&mut bindings, nests, ctr) {
                            ParseResultUnit::Err(e) => {
                                return ParseResultPattern::Err(e);
                            }
                            ParseResultUnit::Ok => {
                            }
                        }
                        if !self.match_tok(TokenKind::Comma) {
                            break;
                        }
                    }
                    match self.expect(TokenKind::RParen, ")") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultPattern::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                }
                return ParseResultPattern::Ok(Pattern::EnumVariant(name, variant, bindings));
            }
            if self.check(TokenKind::LParen) {
                self.advance();
                var bindings: Vec<Binding> = Vec::new();
                loop {
                    match self.parse_pat_arg(&mut bindings, nests, ctr) {
                        ParseResultUnit::Err(e) => {
                            return ParseResultPattern::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
                match self.expect(TokenKind::RParen, ")") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultPattern::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                return ParseResultPattern::Ok(Pattern::EnumVariant("", name, bindings));
            }
            return ParseResultPattern::Ok(Pattern::Ident(name));
        }

        return ParseResultPattern::Err("Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) + ": invalid pattern '" + token_kind_to_str(tok.kind) + "'\n    Fix: a pattern is a literal, a name, `_`, a range `0..=9`, a tuple `(a, b)`, a struct or an enum variant `Some(x)`");
    }

    /// One argument inside `Ctor(...)`: either a plain `name [: ty]` binding
    /// or a nested pattern (`Ok(x)`, `E::V(y)`, `1`, `_`). A nested pattern
    /// is bound to a fresh `__np` name and recorded in `nests`; the match
    /// arm's desugar gives it an inner match of its own.
    fn parse_pat_arg(self: &mut Parser, bindings: &mut Vec<Binding>, nests: &mut Vec<PatNest>, ctr: &mut i64) -> ParseResultUnit {
        var nested: bool = false;
        var tk: TokenKind = self.peek_token().kind;
        if !token_kind_eq(tk, TokenKind::Ident("")) {
            // literals / wildcard-as-_ are not identifiers; anything that is
            // not `name [: ty]` shape is a nested pattern position
            match self.parse_pattern(nests, ctr) {
                ParseResultPattern::Ok(p) => {
                    var sn2: str = "__np" + int_to_str(*ctr);
                    *ctr = *ctr + 1;
                    nests.push(PatNest {
                        name: sn2, pat: p
                    });
                    bindings.push(Binding_new(sn2, ""));
                    return ParseResultUnit::Ok;
                }
                ParseResultPattern::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }
        if self.pos + 1 < self.tokens.len() {
            var k1: TokenKind = self.tokens.get(self.pos + 1).kind;
            if token_kind_eq(k1, TokenKind::LParen) || token_kind_eq(k1, TokenKind::DoubleColon) {
                nested = true;
            }
        }
        if nested {
            match self.parse_pattern(nests, ctr) {
                ParseResultPattern::Ok(p) => {
                    var sn: str = "__np" + int_to_str(*ctr);
                    *ctr = *ctr + 1;
                    nests.push(PatNest {
                        name: sn, pat: p
                    });
                    bindings.push(Binding_new(sn, ""));
                }
                ParseResultPattern::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
            return ParseResultUnit::Ok;
        }
        var bname: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                bname = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultUnit::Err(e);
            }
        }
        var bty: str = "";
        if self.match_tok(TokenKind::Colon) {
            match self.read_type_name() {
                ParseResultStr::Ok(s) => {
                    bty = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }
        bindings.push(Binding_new(bname, bty));
        return ParseResultUnit::Ok;
    }

    /// Desugar a match's arms after parse: an arm whose pattern recorded
    /// nested positions gets a body of inner `match __np { pat => body,
    /// _ => <the remaining arms> }`, applied once per nested position.
    /// `marks` — nests[marks[i] .. marks[i+1]] are arm i's positions;
    /// marks.len() == arms.len() + 1. Recursive over the arm list.
    fn pd_desugar_arms(self: &mut Parser, scrut: str, arms: Vec<MatchArm>, nests: Vec<PatNest>, marks: Vec<i64>, i: i64, line: i64, as_expr: bool) -> Vec<MatchArm> {
        var out: Vec<MatchArm> = Vec::new();
        if i >= arms.len() {
            return out;
        }
        var arm: MatchArm = arms.get(i);
        var s: i64 = marks.get(i);
        var e: i64 = marks.get(i + 1);
        var rest: Vec<MatchArm> = self.pd_desugar_arms(scrut, arms, nests, marks, i + 1, line, as_expr);
        if s == e {
            out.push(arm);
        } else {
            var rest_stmts: Vec<Stmt> = Vec::new();
            if rest.len() > 0 {
                // The fallthrough re-matches the scrutinee against the remaining
                // arms; when none of them covers it, the inner match must panic,
                // not silently fall off the end.
                var rest2: Vec<MatchArm> = rest;
                var lastw: bool = false;
                match rest2.get(rest2.len() - 1).pattern {
                    Pattern::Wildcard => {
                        lastw = true;
                    }
                    _ => {
                    }
                }
                if !lastw {
                    var pstmts: Vec<Stmt> = Vec::new();
                    var pargs: Vec<Expr> = Vec::new();
                    pargs.push(Expr::StringLit("nested match: no arm matched"));
                    pstmts.push(Stmt::Expr(Expr::Call("panic", pargs), line));
                    rest2.push(MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, pstmts));
                }
                if as_expr {
                    rest_stmts.push(Stmt::Expr(Expr::Match(Box::new(Expr::Ident(scrut)), rest2), line));
                } else {
                    rest_stmts.push(Stmt::Match(Expr::Ident(scrut), rest2, line));
                }
            } else {
                var pargs: Vec<Expr> = Vec::new();
                pargs.push(Expr::StringLit("nested match: no arm matched"));
                rest_stmts.push(Stmt::Expr(Expr::Call("panic", pargs), line));
            }
            var body: Vec<Stmt> = arm.body;
            // nests are pushed post-order — children before parents — so the
            // deepest pattern comes first: it becomes the innermost match
            // (which carries the arm's guard).
            var j: i64 = s;
            while j < e {
                var ent: PatNest = nests.get(j);
                var g: OptBoxExpr = OptBoxExpr::None;
                if j == s {
                    g = arm.guard;
                }
                var iarms: Vec<MatchArm> = Vec::new();
                iarms.push(MatchArm_new(ent.pat, g, body));
                iarms.push(MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, rest_stmts));
                body = Vec::new();
                if as_expr {
                    body.push(Stmt::Expr(Expr::Match(Box::new(Expr::Ident(ent.name)), iarms), line));
                } else {
                    body.push(Stmt::Match(Expr::Ident(ent.name), iarms, line));
                }
                j = j + 1;
            }
            out.push(MatchArm_new(arm.pattern, OptBoxExpr::None, body));
        }
        var ri: i64 = 0;
        while ri < rest.len() {
            out.push(rest.get(ri));
            ri = ri + 1;
        }
        return out;
    }

    fn parse_expr(self: &mut Parser) -> ParseResultExpr {
        return self.parse_pipe_forward();
    }

    fn parse_pipe_forward(self: &mut Parser) -> ParseResultExpr {
        var left: Expr = Expr::IntLit(0);
        match self.parse_coalesce() {
            ParseResultExpr::Ok(e) => {
                left = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        while self.match_tok(TokenKind::PipeArrow) {
            var right: Expr = Expr::IntLit(0);
            match self.parse_coalesce() {
                ParseResultExpr::Ok(e) => {
                    right = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            left = Expr::PipeForward(Box::new(left), Box::new(right));
        }
        return ParseResultExpr::Ok(left);
    }

    fn parse_coalesce(self: &mut Parser) -> ParseResultExpr {
        var left: Expr = Expr::IntLit(0);
        match self.parse_range() {
            ParseResultExpr::Ok(e) => {
                left = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        while self.match_tok(TokenKind::QuestionQuestion) {
            var right: Expr = Expr::IntLit(0);
            match self.parse_range() {
                ParseResultExpr::Ok(e) => {
                    right = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            left = Expr::Coalesce(Box::new(left), Box::new(right));
        }
        return ParseResultExpr::Ok(left);
    }

    fn parse_range(self: &mut Parser) -> ParseResultExpr {
        var left: Expr = Expr::IntLit(0);
        match self.parse_or() {
            ParseResultExpr::Ok(e) => {
                left = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        if self.check(TokenKind::DotDot) || self.check(TokenKind::DotDotEq) {
            var inclusive: bool = self.check(TokenKind::DotDotEq);
            self.advance();
            var right: Expr = Expr::IntLit(0);
            match self.parse_or() {
                ParseResultExpr::Ok(e) => {
                    right = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            return ParseResultExpr::Ok(Expr::Range(Box::new(left), Box::new(right), inclusive));
        }
        return ParseResultExpr::Ok(left);
    }

    fn parse_or(self: &mut Parser) -> ParseResultExpr {
        var left: Expr = Expr::IntLit(0);
        match self.parse_bit_or() {
            ParseResultExpr::Ok(e) => {
                left = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        while self.match_tok(TokenKind::Or) {
            var right: Expr = Expr::IntLit(0);
            match self.parse_bit_or() {
                ParseResultExpr::Ok(e) => {
                    right = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            left = Expr::Binary(BinOp::Or, Box::new(left), Box::new(right));
        }
        return ParseResultExpr::Ok(left);
    }

    fn parse_bit_or(self: &mut Parser) -> ParseResultExpr {
        var left: Expr = Expr::IntLit(0);
        match self.parse_bit_xor() {
            ParseResultExpr::Ok(e) => {
                left = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        while self.match_tok(TokenKind::Pipe) {
            var right: Expr = Expr::IntLit(0);
            match self.parse_bit_xor() {
                ParseResultExpr::Ok(e) => {
                    right = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            left = Expr::Binary(BinOp::BitOr, Box::new(left), Box::new(right));
        }
        return ParseResultExpr::Ok(left);
    }

    fn parse_bit_xor(self: &mut Parser) -> ParseResultExpr {
        var left: Expr = Expr::IntLit(0);
        match self.parse_bit_and() {
            ParseResultExpr::Ok(e) => {
                left = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        while self.match_tok(TokenKind::Caret) {
            var right: Expr = Expr::IntLit(0);
            match self.parse_bit_and() {
                ParseResultExpr::Ok(e) => {
                    right = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            left = Expr::Binary(BinOp::BitXor, Box::new(left), Box::new(right));
        }
        return ParseResultExpr::Ok(left);
    }

    fn parse_bit_and(self: &mut Parser) -> ParseResultExpr {
        var left: Expr = Expr::IntLit(0);
        match self.parse_shift() {
            ParseResultExpr::Ok(e) => {
                left = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        while self.match_tok(TokenKind::Ampersand) {
            var right: Expr = Expr::IntLit(0);
            match self.parse_shift() {
                ParseResultExpr::Ok(e) => {
                    right = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            left = Expr::Binary(BinOp::BitAnd, Box::new(left), Box::new(right));
        }
        return ParseResultExpr::Ok(left);
    }

    fn parse_shift(self: &mut Parser) -> ParseResultExpr {
        var left: Expr = Expr::IntLit(0);
        match self.parse_and() {
            ParseResultExpr::Ok(e) => {
                left = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        loop {
            var op: BinOp = BinOp::Shl;
            var k: TokenKind = self.peek();
            if token_kind_eq(k, TokenKind::Shl) {
                op = BinOp::Shl;
            } else if token_kind_eq(k, TokenKind::Shr) {
                op = BinOp::Shr;
            } else {
                break;
            }
            self.advance();
            var right: Expr = Expr::IntLit(0);
            match self.parse_and() {
                ParseResultExpr::Ok(e) => {
                    right = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            left = Expr::Binary(op, Box::new(left), Box::new(right));
        }
        return ParseResultExpr::Ok(left);
    }

    fn parse_and(self: &mut Parser) -> ParseResultExpr {
        var left: Expr = Expr::IntLit(0);
        match self.parse_equality() {
            ParseResultExpr::Ok(e) => {
                left = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        while self.match_tok(TokenKind::And) {
            var right: Expr = Expr::IntLit(0);
            match self.parse_equality() {
                ParseResultExpr::Ok(e) => {
                    right = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            left = Expr::Binary(BinOp::And, Box::new(left), Box::new(right));
        }
        return ParseResultExpr::Ok(left);
    }

    fn parse_equality(self: &mut Parser) -> ParseResultExpr {
        var left: Expr = Expr::IntLit(0);
        match self.parse_comparison() {
            ParseResultExpr::Ok(e) => {
                left = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        loop {
            var op: BinOp = BinOp::Eq;
            var k: TokenKind = self.peek();
            if token_kind_eq(k, TokenKind::EqEq) {
                op = BinOp::Eq;
            } else if token_kind_eq(k, TokenKind::BangEq) {
                op = BinOp::Neq;
            } else {
                break;
            }
            self.advance();
            var right: Expr = Expr::IntLit(0);
            match self.parse_comparison() {
                ParseResultExpr::Ok(e) => {
                    right = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            left = Expr::Binary(op, Box::new(left), Box::new(right));
        }
        return ParseResultExpr::Ok(left);
    }

    fn parse_comparison(self: &mut Parser) -> ParseResultExpr {
        var left: Expr = Expr::IntLit(0);
        match self.parse_addition() {
            ParseResultExpr::Ok(e) => {
                left = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        // `is` type/variant check
        if self.match_tok(TokenKind::Is) {
            var peek_k: TokenKind = self.peek();
            var type_name: str = "";
            var got_name: bool = true;
            match peek_k {
                TokenKind::Ident(name: str) => {
                    self.advance();
                    type_name = name;
                }
                TokenKind::I8 => {
                    self.advance();
                    type_name = "i8";
                }
                TokenKind::I16 => {
                    self.advance();
                    type_name = "i16";
                }
                TokenKind::I32 => {
                    self.advance();
                    type_name = "i32";
                }
                TokenKind::I64 => {
                    self.advance();
                    type_name = "i64";
                }
                TokenKind::I128 => {
                    self.advance();
                    type_name = "i128";
                }
                TokenKind::U8 => {
                    self.advance();
                    type_name = "u8";
                }
                TokenKind::U16 => {
                    self.advance();
                    type_name = "u16";
                }
                TokenKind::U32 => {
                    self.advance();
                    type_name = "u32";
                }
                TokenKind::U64 => {
                    self.advance();
                    type_name = "u64";
                }
                TokenKind::U128 => {
                    self.advance();
                    type_name = "u128";
                }
                TokenKind::F32 => {
                    self.advance();
                    type_name = "f32";
                }
                TokenKind::F64 => {
                    self.advance();
                    type_name = "f64";
                }
                TokenKind::Bool => {
                    self.advance();
                    type_name = "bool";
                }
                TokenKind::Str => {
                    self.advance();
                    type_name = "str";
                }
                TokenKind::Void => {
                    self.advance();
                    type_name = "void";
                }
                _ => {
                }
            }
            if str_len(type_name) == 0 {
                return ParseResultExpr::Err("expected type name after 'is'");
            }
            return ParseResultExpr::Ok(Expr::IsCheck(Box::new(left), type_name));
        }
        loop {
            var op: BinOp = BinOp::Lt;
            var k: TokenKind = self.peek();
            if token_kind_eq(k, TokenKind::Lt) {
                op = BinOp::Lt;
            } else if token_kind_eq(k, TokenKind::Gt) {
                op = BinOp::Gt;
            } else if token_kind_eq(k, TokenKind::LtEq) {
                op = BinOp::LtEq;
            } else if token_kind_eq(k, TokenKind::GtEq) {
                op = BinOp::GtEq;
            } else {
                break;
            }
            self.advance();
            var right: Expr = Expr::IntLit(0);
            match self.parse_addition() {
                ParseResultExpr::Ok(e) => {
                    right = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            left = Expr::Binary(op, Box::new(left), Box::new(right));
        }
        return ParseResultExpr::Ok(left);
    }

    fn parse_addition(self: &mut Parser) -> ParseResultExpr {
        var left: Expr = Expr::IntLit(0);
        match self.parse_multiplication() {
            ParseResultExpr::Ok(e) => {
                left = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        loop {
            var op: BinOp = BinOp::Add;
            var k: TokenKind = self.peek();
            if token_kind_eq(k, TokenKind::Plus) {
                op = BinOp::Add;
            } else if token_kind_eq(k, TokenKind::Minus) {
                op = BinOp::Sub;
            } else {
                break;
            }
            self.advance();
            var right: Expr = Expr::IntLit(0);
            match self.parse_multiplication() {
                ParseResultExpr::Ok(e) => {
                    right = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            left = Expr::Binary(op, Box::new(left), Box::new(right));
        }
        return ParseResultExpr::Ok(left);
    }

    fn parse_multiplication(self: &mut Parser) -> ParseResultExpr {
        var left: Expr = Expr::IntLit(0);
        match self.parse_unary() {
            ParseResultExpr::Ok(e) => {
                left = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        loop {
            var op: BinOp = BinOp::Mul;
            var k: TokenKind = self.peek();
            if token_kind_eq(k, TokenKind::Star) {
                op = BinOp::Mul;
            } else if token_kind_eq(k, TokenKind::Slash) {
                op = BinOp::Div;
            } else if token_kind_eq(k, TokenKind::Percent) {
                op = BinOp::Mod;
            } else {
                break;
            }
            self.advance();
            var right: Expr = Expr::IntLit(0);
            match self.parse_unary() {
                ParseResultExpr::Ok(e) => {
                    right = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            left = Expr::Binary(op, Box::new(left), Box::new(right));
        }
        return ParseResultExpr::Ok(left);
    }

    fn parse_unary(self: &mut Parser) -> ParseResultExpr {
        // F1: one level of nesting (see nest_too_deep)
        if self.nest_depth >= 256 {
            return ParseResultExpr::Err(self.nest_too_deep());
        }
        self.nest_depth = self.nest_depth + 1;
        var r: ParseResultExpr = self.parse_unary_inner();
        self.nest_depth = self.nest_depth - 1;
        return r;
    }

    // F1: the operand of a prefix operator. Before a parenthesis the operator
    // adds no level of its own: the parenthesis's expression is one
    // (parse_unary counts it), so `-(-(-(x)))` nests one level per `-(`
    // (test_verify_parser_nesting_ok.fd's 200 of them were counted as 400
    // and rejected). Any other operand is a level, as before: `- - - x`.
    fn parse_prefix_operand(self: &mut Parser) -> ParseResultExpr {
        if self.check(TokenKind::LParen) {
            return self.parse_unary_inner();
        }
        return self.parse_unary();
    }

    fn parse_unary_inner(self: &mut Parser) -> ParseResultExpr {
        var k: TokenKind = self.peek();
        if token_kind_eq(k, TokenKind::Minus) {
            self.advance();
            var expr: Expr = Expr::IntLit(0);
            match self.parse_prefix_operand() {
                ParseResultExpr::Ok(e) => {
                    expr = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            return ParseResultExpr::Ok(Expr::Unary(UnaryOp::Neg, Box::new(expr)));
        }
        if token_kind_eq(k, TokenKind::Bang) {
            self.advance();
            var expr: Expr = Expr::IntLit(0);
            match self.parse_prefix_operand() {
                ParseResultExpr::Ok(e) => {
                    expr = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            return ParseResultExpr::Ok(Expr::Unary(UnaryOp::Not, Box::new(expr)));
        }
        if token_kind_eq(k, TokenKind::Tilde) {
            self.advance();
            var expr: Expr = Expr::IntLit(0);
            match self.parse_prefix_operand() {
                ParseResultExpr::Ok(e) => {
                    expr = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            return ParseResultExpr::Ok(Expr::Unary(UnaryOp::BitNot, Box::new(expr)));
        }
        if token_kind_eq(k, TokenKind::Ampersand) {
            self.advance();
            var is_mut: bool = self.match_tok(TokenKind::Mut);
            var expr: Expr = Expr::IntLit(0);
            match self.parse_prefix_operand() {
                ParseResultExpr::Ok(e) => {
                    expr = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            return ParseResultExpr::Ok(Expr::Ref(Box::new(expr), is_mut));
        }
        if token_kind_eq(k, TokenKind::Star) {
            self.advance();
            var expr: Expr = Expr::IntLit(0);
            match self.parse_prefix_operand() {
                ParseResultExpr::Ok(e) => {
                    expr = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            return ParseResultExpr::Ok(Expr::Deref(Box::new(expr)));
        }
        if token_kind_eq(k, TokenKind::Comptime) {
            self.advance();
            return self.parse_comptime_expr(0);
        }
        return self.parse_postfix();
    }

    fn parse_comptime_expr(self: &mut Parser, _line: i64) -> ParseResultExpr {
        // comptime { block }
        if self.check(TokenKind::LBrace) {
            self.advance();
            var stmts: Vec<Stmt> = Vec::new();
            while !self.check(TokenKind::RBrace) && !self.is_at_end() {
                match self.parse_stmt() {
                    ParseResultStmt::Ok(s) => {
                        stmts.push(s);
                    }
                    ParseResultStmt::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            self.match_tok(TokenKind::Semicolon);
            return ParseResultExpr::Ok(Expr::ComptimeBlock(stmts));
        }
        // LG9: comptime splice { block } -- the block runs at compile time
        // and returns source text, which process_gen (comptime_eval.fd)
        // parses as one expression and puts here, before type checking.
        // The splice's line rides along as the second argument.
        match self.peek() {
            TokenKind::Ident(sp_name) => {
                if sp_name == "splice" && token_kind_eq(self.tokens.get(self.pos + 1).kind, TokenKind::LBrace) {
                    var sp_line: i64 = self.peek_token().line;
                    self.advance();
                    self.advance();
                    var sp_block: Vec<Stmt> = Vec::new();
                    match self.parse_block() {
                        ParseResultStmts::Ok(b) => {
                            sp_block = b;
                        }
                        ParseResultStmts::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                    }
                    match self.expect(TokenKind::RBrace, "}") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    self.pd_saw_splice();
                    var sp_args: Vec<Expr> = Vec::new();
                    sp_args.push(Expr::ComptimeBlock(sp_block));
                    sp_args.push(Expr::IntLit(sp_line));
                    return ParseResultExpr::Ok(Expr::Call("__comptime_splice", sp_args));
                }
                // CL6: `comptime splice make(args)` -- a macro call in an
                // expression: the call (a `comptime fn` returning source
                // text) is the splice's block, `{ return make(args); }`.
                // `comptime splice(x)` stays a comptime call of a function
                // named splice (the word is followed by `(`, not a name).
                if sp_name == "splice" && token_kind_eq(self.tokens.get(self.pos + 1).kind, TokenKind::Ident("")) {
                    var spc_line: i64 = self.peek_token().line;
                    self.advance();
                    var spc_call: Expr = Expr::IntLit(0);
                    match self.parse_postfix() {
                        ParseResultExpr::Ok(ce) => {
                            spc_call = ce;
                        }
                        ParseResultExpr::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                    }
                    self.pd_saw_splice();
                    var spc_block: Vec<Stmt> = Vec::new();
                    spc_block.push(Stmt::Return(OptBoxExpr::Some(Box::new(spc_call)), spc_line));
                    var spc_args: Vec<Expr> = Vec::new();
                    spc_args.push(Expr::ComptimeBlock(spc_block));
                    spc_args.push(Expr::IntLit(spc_line));
                    return ParseResultExpr::Ok(Expr::Call("__comptime_splice", spc_args));
                }
            }
            _ => {
            }
        }
        // comptime type_name(T) / is_struct(T) / ... -- compile-time reflection
        match self.peek() {
            TokenKind::Ident(name) => {
                var has_op: bool = true;
                var op: ReflectOp = ReflectOp::TypeName;
                if name == "type_name" {
                    op = ReflectOp::TypeName;
                } else if name == "is_struct" {
                    op = ReflectOp::IsStruct;
                } else if name == "is_enum" {
                    op = ReflectOp::IsEnum;
                } else if name == "field_count" {
                    op = ReflectOp::FieldCount;
                } else if name == "field_names" {
                    op = ReflectOp::FieldNames;
                } else if name == "field_types" {
                    op = ReflectOp::FieldTypes;
                } else if name == "enum_variants" {
                    op = ReflectOp::EnumVariants;
                } else if name == "struct_size" {
                    op = ReflectOp::StructSize;
                } else if name == "field_offset" {
                    op = ReflectOp::FieldOffset;
                } else if name == "enum_discriminant" {
                    op = ReflectOp::EnumDiscriminant;
                } else if name == "function_effects" {
                    op = ReflectOp::FunctionEffects;
                } else if name == "function_capabilities" {
                    op = ReflectOp::FunctionCapabilities;
                } else {
                    has_op = false;
                }
                if has_op {
                    self.advance();
                    match self.expect(TokenKind::LParen, "(") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    var ty: Type = Type::Infer;
                    var member_op: bool = false;
                    var func_op: bool = false;
                    match op {
                        ReflectOp::FieldOffset => {
                            member_op = true;
                        }
                        ReflectOp::EnumDiscriminant => {
                            member_op = true;
                        }
                        ReflectOp::FunctionEffects => {
                            func_op = true;
                        }
                        ReflectOp::FunctionCapabilities => {
                            func_op = true;
                        }
                        _ => {
                        }
                    }
                    if member_op {
                        // Owner.member (or Owner::member), kept as "Owner.member"
                        var owner: str = "";
                        match self.expect_ident() {
                            ParseResultStr::Ok(o) => {
                                owner = o;
                            }
                            ParseResultStr::Err(e) => {
                                return ParseResultExpr::Err(e);
                            }
                        }
                        if !self.match_tok(TokenKind::Dot) {
                            match self.expect(TokenKind::DoubleColon, ".") {
                                ParseResultUnit::Err(e) => {
                                    return ParseResultExpr::Err(e);
                                }
                                ParseResultUnit::Ok => {
                                }
                            }
                        }
                        match self.expect_ident_or_keyword() {
                            ParseResultStr::Ok(m) => {
                                ty = Type::Named(owner + "." + m);
                            }
                            ParseResultStr::Err(e) => {
                                return ParseResultExpr::Err(e);
                            }
                        }
                    } else if func_op {
                        match self.expect_ident_or_keyword() {
                            ParseResultStr::Ok(fname) => {
                                ty = Type::Named(fname);
                            }
                            ParseResultStr::Err(e) => {
                                return ParseResultExpr::Err(e);
                            }
                        }
                    } else {
                        match self.parse_type() {
                            ParseResultType::Ok(t) => {
                                ty = t;
                            }
                            ParseResultType::Err(e) => {
                                return ParseResultExpr::Err(e);
                            }
                        }
                    }
                    match self.expect(TokenKind::RParen, ")") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    self.match_tok(TokenKind::Semicolon);
                    return ParseResultExpr::Ok(Expr::ComptimeReflect(op, ty));
                }
            }
            _ => {
            }
        }
        // comptime <expr>
        var inner: Expr = Expr::IntLit(0);
        match self.parse_unary() {
            ParseResultExpr::Ok(e) => {
                inner = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        self.match_tok(TokenKind::Semicolon);
        return ParseResultExpr::Ok(Expr::Comptime(Box::new(inner)));
    }

    fn parse_postfix(self: &mut Parser) -> ParseResultExpr {
        var expr: Expr = Expr::IntLit(0);
        match self.parse_primary() {
            ParseResultExpr::Ok(e) => {
                expr = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        loop {
            if self.match_tok(TokenKind::Dot) {
                // `p.0`: reference §3.2/§5.1 reads a tuple by destructuring,
                // there is no `.N` (bugs 16); say so
                var dot_tok: Token = self.peek_token();
                if token_kind_eq(dot_tok.kind, TokenKind::IntLit(0)) || token_kind_eq(dot_tok.kind, TokenKind::FloatLit(0.0)) {
                    return ParseResultExpr::Err("Parse error at " + int_to_str(dot_tok.line) + ":" + int_to_str(dot_tok.col) + ": a tuple element is not read with `.N` (reference §5.1).\n    Fix: destructure it, `val (a, b) = p;`, or use a struct with named fields.");
                }
                var field: str = "";
                match self.expect_ident_or_keyword() {
                    ParseResultStr::Ok(s) => {
                        field = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
                if self.match_tok(TokenKind::LParen) {
                    // Method call
                    var args: Vec<Expr> = Vec::new();
                    if !self.check(TokenKind::RParen) {
                        loop {
                            match self.parse_expr() {
                                ParseResultExpr::Ok(e) => {
                                    args.push(e);
                                }
                                ParseResultExpr::Err(e) => {
                                    return ParseResultExpr::Err(e);
                                }
                            }
                            if !self.match_tok(TokenKind::Comma) {
                                break;
                            }
                        }
                    }
                    match self.expect(TokenKind::RParen, ")") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    expr = Expr::MethodCall(Box::new(expr), field, args);
                } else {
                    expr = Expr::FieldAccess(Box::new(expr), field);
                }
            } else if self.match_tok(TokenKind::QuestionDot) {
                var field: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(s) => {
                        field = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
                expr = Expr::OptionalFieldAccess(Box::new(expr), field);
            } else if self.match_tok(TokenKind::LBracket) {
                var index: Expr = Expr::IntLit(0);
                match self.parse_expr() {
                    ParseResultExpr::Ok(e) => {
                        index = e;
                    }
                    ParseResultExpr::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
                match self.expect(TokenKind::RBracket, "]") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                expr = Expr::Index(Box::new(expr), Box::new(index));
            } else if self.match_tok(TokenKind::Question) {
                expr = Expr::Try(Box::new(expr));
            } else if self.match_tok(TokenKind::As) {
                var target_ty: Type = Type::Void;
                match self.parse_type() {
                    ParseResultType::Ok(t) => {
                        target_ty = t;
                    }
                    ParseResultType::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
                expr = Expr::Cast(Box::new(expr), target_ty);
            } else if self.match_tok(TokenKind::TildeArrow) {
                var target_ty: Type = Type::Void;
                match self.parse_type() {
                    ParseResultType::Ok(t) => {
                        target_ty = t;
                    }
                    ParseResultType::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
                expr = Expr::QuantCast(Box::new(expr), target_ty);
            } else if self.check(TokenKind::LParen) && self.pos > 0 && self.tokens.get(self.pos - 1).line == self.peek_token().line {
                // Calling a call's (or any expression's) result, on the same
                // line: `f(1)(5)`, `fs.get(1)(5)` (bugs 38). A call names
                // its callee, so the value goes into a local first:
                // `{ val __pcall_k = f(1); __pcall_k(5) }`. A `(` on the
                // next line starts a statement (semicolons are optional).
                var pc_line: i64 = self.peek_token().line;
                self.advance();
                var pc_name: str = "__pcall_" + int_to_str(self.pd_next_pcall());
                var pc_call: Expr = Expr::IntLit(0);
                match self.parse_call_expr(pc_name) {
                    ParseResultExpr::Ok(ce) => {
                        pc_call = ce;
                    }
                    ParseResultExpr::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
                var pc_stmts: Vec<Stmt> = Vec::new();
                pc_stmts.push(Stmt::Let(pc_name, OptType::None, expr, false, false, Vec::new(), pc_line));
                pc_stmts.push(Stmt::Expr(pc_call, pc_line));
                expr = Expr::Block(pc_stmts);
            } else {
                break;
            }
        }
        return ParseResultExpr::Ok(expr);
    }

    fn parse_match_expr(self: &mut Parser) -> ParseResultExpr {
        match self.expect(TokenKind::Match, "match") {
            ParseResultUnit::Err(e) => {
                return ParseResultExpr::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var expr: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => {
                expr = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultExpr::Err(e);
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultExpr::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var arms: Vec<MatchArm> = Vec::new();
        var nests: Vec<PatNest> = Vec::new();
        var npctr: i64 = 0;
        var marks: Vec<i64> = Vec::new();
        marks.push(0);
        var pat_line: i64 = self.peek_token().line;
        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            var pattern: Pattern = Pattern::Wildcard;
            match self.parse_pattern(&mut nests, &mut npctr) {
                ParseResultPattern::Ok(p) => {
                    pattern = p;
                }
                ParseResultPattern::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            marks.push(nests.len());
            var match_guard: OptBoxExpr = OptBoxExpr::None;
            if self.check(TokenKind::If) {
                self.advance();
                match self.parse_expr() {
                    ParseResultExpr::Ok(g) => {
                        match_guard = OptBoxExpr::Some(Box::new(g));
                    }
                    ParseResultExpr::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
            }
            match self.expect(TokenKind::FatArrow, "=>") {
                ParseResultUnit::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var body: Vec<Stmt> = Vec::new();
            if self.check(TokenKind::LBrace) {
                self.advance();
                match self.parse_block() {
                    ParseResultStmts::Ok(b) => {
                        body = b;
                    }
                    ParseResultStmts::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
                match self.expect(TokenKind::RBrace, "}") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
            } else {
                var line: i64 = self.peek_token().line;
                var e: Expr = Expr::IntLit(0);
                match self.parse_expr() {
                    ParseResultExpr::Ok(pe) => {
                        e = pe;
                    }
                    ParseResultExpr::Err(pe_err) => {
                        return ParseResultExpr::Err(pe_err);
                    }
                }
                body.push(Stmt::Expr(e, line));
            }
            self.match_tok(TokenKind::Comma);
            arms.push(MatchArm_new(pattern, match_guard, body));
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultExpr::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        if nests.len() > 0 {
            // Nested patterns in expression position: the scrutinee must be a
            // plain variable — there is no statement context to hoist a
            // one-time evaluation into.
            var scrut2: str = "";
            match expr {
                Expr::Ident(nm2) => {
                    scrut2 = nm2;
                }
                _ => {
                }
            }
            if scrut2 == "" {
                return ParseResultExpr::Err("Parse error at " + int_to_str(pat_line) + ": nested patterns in match expressions need a variable scrutinee\n    Fix: bind the value first, `val v = expr;`, then `match v { ... }`");
            }
            // BG264: the original arms' exhaustiveness (pd_np_probe_stmt),
            // checked at the start of the first arm unless its pattern
            // binds the scrutinee's name
            var probe2: Vec<Stmt> = pd_np_probe_stmt(scrut2, arms, nests, pat_line);
            arms = self.pd_desugar_arms(scrut2, arms, nests, marks, 0, pat_line, true);
            if probe2.len() > 0 && arms.len() > 0 && !pd_np_binds(arms.get(0).pattern, scrut2) {
                var a0: MatchArm = arms.get(0);
                var nb: Vec<Stmt> = Vec::new();
                nb.push(probe2.get(0));
                var bi: i64 = 0;
                while bi < a0.body.len() {
                    nb.push(a0.body.get(bi));
                    bi = bi + 1;
                }
                arms.set(0, MatchArm_new(a0.pattern, a0.guard, nb));
            }
            return ParseResultExpr::Ok(Expr::Match(Box::new(Expr::Ident(scrut2)), arms));
        }
        return ParseResultExpr::Ok(Expr::Match(Box::new(expr), arms));
    }

    // Helper: parse call arguments and build a Call expr.
    // Assumes LParen was already consumed. Consumes RParen.
    fn parse_call_expr(self: &mut Parser, callee: str) -> ParseResultExpr {
        var args: Vec<Expr> = Vec::new();
        if !self.check(TokenKind::RParen) {
            loop {
                // Check for named argument: ident : expr
                var tok = self.peek_token();
                var is_named = false;
                match tok.kind {
                    TokenKind::Ident(name) => {
                        if self.pos + 1 < self.tokens.len() {
                            var next_tok = self.tokens.get(self.pos + 1);
                            match next_tok.kind {
                                TokenKind::Colon => {
                                    is_named = true;
                                }
                                _ => {
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                if is_named {
                    var arg_name: str = "";
                    match self.expect_ident_or_keyword() {
                        ParseResultStr::Ok(s) => {
                            arg_name = s;
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                    }
                    match self.expect(TokenKind::Colon, ":") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    match self.parse_expr() {
                        ParseResultExpr::Ok(e) => {
                            args.push(Expr::NamedArg(arg_name, Box::new(e)));
                        }
                        ParseResultExpr::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                    }
                } else {
                    match self.parse_expr() {
                        ParseResultExpr::Ok(e) => {
                            args.push(e);
                        }
                        ParseResultExpr::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                    }
                }
                if !self.match_tok(TokenKind::Comma) {
                    break;
                }
            }
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => {
                return ParseResultExpr::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultExpr::Ok(Expr::Call(callee, args));
    }

    // Helper: parse struct literal body. Assumes LBrace was already consumed.
    // Consumes RBrace.
    fn parse_struct_lit_expr(self: &mut Parser, name: str) -> ParseResultExpr {
        var fields: Vec<FieldInit> = Vec::new();
        var spread: OptBoxExpr = OptBoxExpr::None;
        if !self.check(TokenKind::RBrace) {
            loop {
                if self.check(TokenKind::DotDot) {
                    self.advance();
                    // CL5: a bare `..` (then `}` or `,`): the fields left out
                    // take the struct's defaults
                    if self.check(TokenKind::RBrace) || self.check(TokenKind::Comma) {
                        spread = OptBoxExpr::Some(Box::new(ast_spread_defaults()));
                        if !self.match_tok(TokenKind::Comma) {
                            break;
                        }
                        if self.check(TokenKind::RBrace) {
                            break;
                        }
                        continue;
                    }
                    match self.parse_expr() {
                        ParseResultExpr::Ok(se) => {
                            spread = OptBoxExpr::Some(Box::new(se));
                        }
                        ParseResultExpr::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                    }
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                    if self.check(TokenKind::RBrace) {
                        break;
                    }
                    continue;
                }
                var fname: str = "";
                match self.expect_ident_or_keyword() {
                    ParseResultStr::Ok(s) => {
                        fname = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
                match self.expect(TokenKind::Colon, ":") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                var fval: Expr = Expr::IntLit(0);
                match self.parse_expr() {
                    ParseResultExpr::Ok(e) => {
                        fval = e;
                    }
                    ParseResultExpr::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
                fields.push(FieldInit_new(fname, fval));
                if !self.match_tok(TokenKind::Comma) {
                    break;
                }
                if self.check(TokenKind::RBrace) {
                    break;
                }
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultExpr::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultExpr::Ok(Expr::StructLit(name, fields, spread));
    }

    // Helper: parse comma-separated expr list inside ( ... ).
    // Assumes LParen was already consumed. Consumes RParen.
    fn parse_expr_list(self: &mut Parser) -> ParseResultExprs {
        var args: Vec<Expr> = Vec::new();
        if !self.check(TokenKind::RParen) {
            loop {
                match self.parse_expr() {
                    ParseResultExpr::Ok(e) => {
                        args.push(e);
                    }
                    ParseResultExpr::Err(e) => {
                        return ParseResultExprs::Err(e);
                    }
                }
                if !self.match_tok(TokenKind::Comma) {
                    break;
                }
            }
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => {
                return ParseResultExprs::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultExprs::Ok(args);
    }

    // Helper: parse tuple rest after first element and comma.
    // Assumes LParen and first expr were already consumed, and comma was matched.
    // Consumes RParen.
    fn parse_tuple_rest(self: &mut Parser, first: Expr) -> ParseResultExpr {
        var elems: Vec<Expr> = Vec::new();
        elems.push(first);
        loop {
            self.expr_depth = self.expr_depth + 1;
            match self.parse_expr() {
                ParseResultExpr::Ok(e) => {
                    elems.push(e);
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            self.expr_depth = self.expr_depth - 1;
            if !self.match_tok(TokenKind::Comma) {
                break;
            }
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => {
                return ParseResultExpr::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultExpr::Ok(Expr::TupleLit(elems));
    }

    fn parse_primary(self: &mut Parser) -> ParseResultExpr {
        var tok: Token = self.peek_token();
        var k: TokenKind = tok.kind;

        // IntLit
        match k {
            TokenKind::IntLit(n: i64) => {
                self.advance();
                return ParseResultExpr::Ok(Expr::IntLit(n));
            }
            _ => {
            }
        }
        // FloatLit
        match k {
            TokenKind::FloatLit(f: f64) => {
                self.advance();
                return ParseResultExpr::Ok(Expr::FloatLit(f));
            }
            _ => {
            }
        }
        // StringLit
        match k {
            TokenKind::StringLit(s: str) => {
                self.advance();
                return ParseResultExpr::Ok(Expr::StringLit(s));
            }
            _ => {
            }
        }
        // FString
        match k {
            TokenKind::FString(s: str) => {
                self.advance();
                return self.parse_fstring_parts(s, tok.line, tok.col);
            }
            _ => {
            }
        }
        // Array literal: [val, val, ...]
        if token_kind_eq(k, TokenKind::LBracket) {
            self.advance();
            var elements: Vec<Expr> = Vec::new();
            if !self.check(TokenKind::RBracket) {
                loop {
                    match self.parse_expr() {
                        ParseResultExpr::Ok(e) => {
                            elements.push(e);
                        }
                        ParseResultExpr::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                    }
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::RBracket, "]") {
                ParseResultUnit::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            return ParseResultExpr::Ok(Expr::ArrayLit(Box::new(Type::I64), elements));
        }
        if token_kind_eq(k, TokenKind::True) {
            self.advance();
            return ParseResultExpr::Ok(Expr::BoolLit(true));
        }
        if token_kind_eq(k, TokenKind::False) {
            self.advance();
            return ParseResultExpr::Ok(Expr::BoolLit(false));
        }
        // Closure: fn(params) -> ret { body } or fn(params) => expr
        if token_kind_eq(k, TokenKind::Fn) {
            self.advance();
            match self.expect(TokenKind::LParen, "(") {
                ParseResultUnit::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var params: Vec<Param> = Vec::new();
            match self.parse_params() {
                ParseResultParams::Ok(p) => {
                    params = p;
                }
                ParseResultParams::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            if self.p_ct_type_params.len() > 0 {
                return ParseResultExpr::Err("a comptime parameter (`comptime T: type`) is allowed on functions and methods only");
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var ret_ty: OptType = OptType::None;
            if self.match_tok(TokenKind::Arrow) {
                var peek_k: TokenKind = self.peek();
                var is_type: bool = false;
                if starts_type(peek_k) {
                    is_type = true;
                } else {
                    match peek_k {
                        TokenKind::Ident(_: str) => {
                            is_type = true;
                        }
                        _ => {
                        }
                    }
                }
                if is_type {
                    match self.parse_type() {
                        ParseResultType::Ok(t) => {
                            ret_ty = OptType::Some(t);
                        }
                        ParseResultType::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                    }
                }
            }
            if self.match_tok(TokenKind::FatArrow) {
                // Expression closure: fn(x) => expr
                var line: i64 = self.peek_token().line;
                var e: Expr = Expr::IntLit(0);
                match self.parse_expr() {
                    ParseResultExpr::Ok(pe) => {
                        e = pe;
                    }
                    ParseResultExpr::Err(pe_err) => {
                        return ParseResultExpr::Err(pe_err);
                    }
                }
                var body: Vec<Stmt> = Vec::new();
                body.push(Stmt::Expr(e, line));
                return ParseResultExpr::Ok(Expr::Closure(params, body, ret_ty));
            } else {
                match self.expect(TokenKind::LBrace, "{") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                var body: Vec<Stmt> = Vec::new();
                match self.parse_block() {
                    ParseResultStmts::Ok(b) => {
                        body = b;
                    }
                    ParseResultStmts::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
                match self.expect(TokenKind::RBrace, "}") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                return ParseResultExpr::Ok(Expr::Closure(params, body, ret_ty));
            }
        }
        // Block-as-expression: { stmt; stmt; expr }
        if token_kind_eq(k, TokenKind::LBrace) {
            self.advance();
            var block: Vec<Stmt> = Vec::new();
            match self.parse_block() {
                ParseResultStmts::Ok(b) => {
                    block = b;
                }
                ParseResultStmts::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            return ParseResultExpr::Ok(Expr::Block(block));
        }
        // Identifier or function call
        if token_kind_eq(k, TokenKind::Ident("")) {
            var name: str = "";
            match tok.kind {
                TokenKind::Ident(s: str) => {
                    name = s;
                }
                _ => {
                }
            }
            self.advance();
            // Check for asm! macro
            if name == "asm" && self.match_tok(TokenKind::Bang) {
                return self.parse_asm();
            }
            if self.match_tok(TokenKind::LParen) {
                return self.parse_call_expr(name);
            }
            // A struct of an imported module is not among the file's own names when
            // the file is first parsed (known-bugs 2g.38): `Name { field: ..` is a
            // literal all the same (no block starts with `ident:`)
            if self.check(TokenKind::LBrace) && (self.is_struct_name(name) || self.pd_field_init_follows(name)) {
                self.advance();
                return self.parse_struct_lit_expr(name);
            }
            if self.check(TokenKind::DoubleColon) {
                self.advance();
                if self.check(TokenKind::Lt) {
                    // Turbofish: name::<T, U>(args)
                    self.advance();
                    var targs: Vec<Type> = Vec::new();
                    loop {
                        match self.parse_type() {
                            ParseResultType::Ok(t) => {
                                targs.push(t);
                            }
                            ParseResultType::Err(e) => {
                                return ParseResultExpr::Err(e);
                            }
                        }
                        if !self.match_tok(TokenKind::Comma) {
                            break;
                        }
                    }
                    match self.expect(TokenKind::Gt, ">") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    match self.expect(TokenKind::LParen, "(") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    var targ_call_args: Vec<Expr> = Vec::new();
                    match self.parse_expr_list() {
                        ParseResultExprs::Ok(a) => {
                            targ_call_args = a;
                        }
                        ParseResultExprs::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                    }
                    var tf_k: i64 = self.pd_turbofish(Type::Generic("", targs));
                    return ParseResultExpr::Ok(Expr::Call(name + "::<#" + int_to_str(tf_k) + ">", targ_call_args));
                }
                var variant_or_method: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(s) => {
                        variant_or_method = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
                var args: Vec<Expr> = Vec::new();
                var called: bool = self.match_tok(TokenKind::LParen);
                if called {
                    match self.parse_expr_list() {
                        ParseResultExprs::Ok(a) => {
                            args = a;
                        }
                        ParseResultExprs::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                    }
                }
                if called && !self.is_enum_name(name) && HashMap_get(self.struct_name_set, name) == 0 && self.pd_import_known(name) {
                    var qcall: str = name + "::" + variant_or_method;
                    self.pd_qcall(qcall);
                    return ParseResultExpr::Ok(Expr::Call(qcall, args));
                }
                if self.is_enum_name(name) {
                    return ParseResultExpr::Ok(Expr::EnumLit(name, variant_or_method, args));
                } else {
                    return ParseResultExpr::Ok(Expr::MethodCall(Box::new(Expr::Ident(name)), variant_or_method, args));
                }
            }
            return ParseResultExpr::Ok(Expr::Ident(name));
        }
        // Parenthesized expression or tuple
        if token_kind_eq(k, TokenKind::LParen) {
            self.advance();
            self.expr_depth = self.expr_depth + 1;
            var first: Expr = Expr::IntLit(0);
            match self.parse_expr() {
                ParseResultExpr::Ok(e) => {
                    first = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            self.expr_depth = self.expr_depth - 1;
            if self.match_tok(TokenKind::Comma) {
                return self.parse_tuple_rest(first);
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            return ParseResultExpr::Ok(first);
        }
        // If expression
        if token_kind_eq(k, TokenKind::If) {
            match self.parse_if_expr() {
                ParseResultIfExpr::Ok(ie) => {
                    return ParseResultExpr::Ok(Expr::If(Box::new(ie.cond), ie.then_block, ie.else_block));
                }
                ParseResultIfExpr::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
        }
        // Match expression
        if token_kind_eq(k, TokenKind::Match) {
            return self.parse_match_expr();
        }
        // Try block
        if token_kind_eq(k, TokenKind::Try) {
            self.advance();
            match self.expect(TokenKind::LBrace, "{") {
                ParseResultUnit::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var body: Vec<Stmt> = Vec::new();
            match self.parse_block() {
                ParseResultStmts::Ok(b) => {
                    body = b;
                }
                ParseResultStmts::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            return ParseResultExpr::Ok(Expr::TryBlock(body));
        }
        // Await
        if token_kind_eq(k, TokenKind::Await) {
            self.advance();
            var e: Expr = Expr::IntLit(0);
            match self.parse_unary() {
                ParseResultExpr::Ok(ae) => {
                    e = ae;
                }
                ParseResultExpr::Err(e2) => {
                    return ParseResultExpr::Err(e2);
                }
            }
            return ParseResultExpr::Ok(Expr::Await(Box::new(e)));
        }
        // Spawn
        if token_kind_eq(k, TokenKind::Spawn) {
            self.advance();
            // CA6: `spawn detached f(x)` lets the task go by name (contextual:
            // `detached` followed by a name; `spawn detached(x)` is still a
            // call of a function named detached). It is the call
            // `__spawn_detached(spawn f(x))`: the type checker accepts it
            // without a kept handle, lowering lets the task go.
            var detached: bool = false;
            if self.pos + 1 < self.tokens.len() {
                var dt0: Token = self.tokens.get(self.pos);
                var dt1: Token = self.tokens.get(self.pos + 1);
                match dt0.kind {
                    TokenKind::Ident(dname) => {
                        if dname == "detached" && token_kind_eq(dt1.kind, TokenKind::Ident("")) {
                            detached = true;
                        }
                    }
                    _ => {
                    }
                }
            }
            if detached {
                self.advance();
            }
            var e: Expr = Expr::IntLit(0);
            match self.parse_unary() {
                ParseResultExpr::Ok(ae) => {
                    e = ae;
                }
                ParseResultExpr::Err(e2) => {
                    return ParseResultExpr::Err(e2);
                }
            }
            if detached {
                var dargs: Vec<Expr> = Vec::new();
                dargs.push(Expr::Spawn(Box::new(e)));
                return ParseResultExpr::Ok(Expr::Call("__spawn_detached", dargs));
            }
            return ParseResultExpr::Ok(Expr::Spawn(Box::new(e)));
        }
        // Yield
        if token_kind_eq(k, TokenKind::Yield) {
            self.advance();
            var e: Expr = Expr::IntLit(0);
            match self.parse_unary() {
                ParseResultExpr::Ok(ae) => {
                    e = ae;
                }
                ParseResultExpr::Err(e2) => {
                    return ParseResultExpr::Err(e2);
                }
            }
            return ParseResultExpr::Ok(Expr::Yield(Box::new(e)));
        }
        // Word keywords as identifiers (e.g. query, move as variable names)
        if is_word_keyword(k) {
            var kw_str: str = token_kind_to_str(k);
            self.advance();
            // reference §1.4: a word keyword may name a function, and
            // `handle(x)` calls it (as for an identifier)
            if self.match_tok(TokenKind::LParen) {
                return self.parse_call_expr(kw_str);
            }
            return ParseResultExpr::Ok(Expr::Ident(kw_str));
        }
        // Not a valid primary expression
        return ParseResultExpr::Err("Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) + ": unexpected token '" + token_kind_to_str(k) + "'\n    Fix: an expression goes here; look for a missing operand, a stray symbol, or a `;` or `}` missing before it");
    }

    fn parse_asm(self: &mut Parser) -> ParseResultExpr {
        match self.expect(TokenKind::LParen, "(") {
            ParseResultUnit::Err(e) => {
                return ParseResultExpr::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        // Template string
        var template: str = "";
        var ttok: Token = self.peek_token();
        match ttok.kind {
            TokenKind::StringLit(s: str) => {
                self.advance();
                template = s;
            }
            _ => {
            }
        }
        if str_len(template) == 0 {
            return ParseResultExpr::Err("Parse error: asm! first argument must be a string template\n    Fix: give the instructions first, as a string: asm!(\"nop\"), then the operands");
        }
        // Operands
        var operands: Vec<AsmOperand> = Vec::new();
        while self.match_tok(TokenKind::Comma) {
            var direction: AsmDir = AsmDir::In;
            var is_clobber: bool = false;
            var dtok: Token = self.peek_token();
            var got_dir: bool = true;
            if token_kind_eq(dtok.kind, TokenKind::In) {
                self.advance();
                direction = AsmDir::In;
            } else {
                match dtok.kind {
                    TokenKind::Ident(s: str) => {
                        if s == "out" {
                            self.advance();
                            direction = AsmDir::Out;
                        } else if s == "clobber" {
                            self.advance();
                            direction = AsmDir::Clobber;
                            is_clobber = true;
                        } else {
                            got_dir = false;
                        }
                    }
                    _ => {
                    }
                }
                if !got_dir {
                    return ParseResultExpr::Err("Parse error: asm! operand must start with 'in', 'out', or 'clobber'\n    Fix: write each operand as in(\"reg\") value, out(\"reg\") variable or clobber(\"reg\")");
                }
            }
            match self.expect(TokenKind::LParen, "(") {
                ParseResultUnit::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var reg: str = "";
            var rtok: Token = self.peek_token();
            match rtok.kind {
                TokenKind::StringLit(s: str) => {
                    self.advance();
                    reg = s;
                }
                _ => {
                }
            }
            if str_len(reg) == 0 {
                return ParseResultExpr::Err("Parse error: asm! register must be a string\n    Fix: name the register in quotes, as in in(\"rax\") x");
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => {
                    return ParseResultExpr::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            // Clobber operands don't have an expression — use IntLit(0) as placeholder
            var expr: Expr = Expr::IntLit(0);
            if !is_clobber {
                match self.parse_expr() {
                    ParseResultExpr::Ok(e) => {
                        expr = e;
                    }
                    ParseResultExpr::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
            }
            operands.push(AsmOperand_new(direction, reg, expr));
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => {
                return ParseResultExpr::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultExpr::Ok(Expr::Asm(template, operands));
    }

    fn peek_bin_op(self: &Parser) -> BinOpInfo {
        var k: TokenKind = self.peek();
        if token_kind_eq(k, TokenKind::PipeArrow) {
            return BinOpInfo_new(BinOp::Or, 1, true);
        }
        if token_kind_eq(k, TokenKind::QuestionQuestion) {
            return BinOpInfo_new(BinOp::Or, 2, true);
        }
        if token_kind_eq(k, TokenKind::Or) {
            return BinOpInfo_new(BinOp::Or, 4, true);
        }
        if token_kind_eq(k, TokenKind::Pipe) {
            return BinOpInfo_new(BinOp::BitOr, 5, true);
        }
        if token_kind_eq(k, TokenKind::Caret) {
            return BinOpInfo_new(BinOp::BitXor, 6, true);
        }
        if token_kind_eq(k, TokenKind::Ampersand) {
            return BinOpInfo_new(BinOp::BitAnd, 7, true);
        }
        if token_kind_eq(k, TokenKind::Shl) {
            return BinOpInfo_new(BinOp::Shl, 8, true);
        }
        if token_kind_eq(k, TokenKind::Shr) {
            return BinOpInfo_new(BinOp::Shr, 8, true);
        }
        if token_kind_eq(k, TokenKind::And) {
            return BinOpInfo_new(BinOp::And, 9, true);
        }
        if token_kind_eq(k, TokenKind::EqEq) {
            return BinOpInfo_new(BinOp::Eq, 10, true);
        }
        if token_kind_eq(k, TokenKind::BangEq) {
            return BinOpInfo_new(BinOp::Neq, 10, true);
        }
        if token_kind_eq(k, TokenKind::Lt) {
            return BinOpInfo_new(BinOp::Lt, 11, true);
        }
        if token_kind_eq(k, TokenKind::Gt) {
            return BinOpInfo_new(BinOp::Gt, 11, true);
        }
        if token_kind_eq(k, TokenKind::LtEq) {
            return BinOpInfo_new(BinOp::LtEq, 11, true);
        }
        if token_kind_eq(k, TokenKind::GtEq) {
            return BinOpInfo_new(BinOp::GtEq, 11, true);
        }
        if token_kind_eq(k, TokenKind::Plus) {
            return BinOpInfo_new(BinOp::Add, 12, true);
        }
        if token_kind_eq(k, TokenKind::Minus) {
            return BinOpInfo_new(BinOp::Sub, 12, true);
        }
        if token_kind_eq(k, TokenKind::Star) {
            return BinOpInfo_new(BinOp::Mul, 13, true);
        }
        if token_kind_eq(k, TokenKind::Slash) {
            return BinOpInfo_new(BinOp::Div, 13, true);
        }
        if token_kind_eq(k, TokenKind::Percent) {
            return BinOpInfo_new(BinOp::Mod, 13, true);
        }
        return BinOpInfo_new(BinOp::Add, 0, false);
    }

    fn parse_expr_iterative(self: &mut Parser) -> ParseResultExpr {
        var vals: Vec<Expr> = Vec::new();
        var ops: Vec<OpEntry> = Vec::new();
        var need_primary: bool = true;

        loop {
            if need_primary {
                if self.check(TokenKind::LParen) {
                    self.advance();
                    ops.push(OpEntry::Paren);
                    if self.check(TokenKind::RParen) {
                        self.advance();
                        // Empty tuple ()
                        if ops.len() > 0 {
                            ops.pop();
                        }
                        vals.push(Expr::TupleLit(Vec::new()));
                        need_primary = false;
                    }
                } else {
                    match self.parse_primary() {
                        ParseResultExpr::Ok(e) => {
                            vals.push(e);
                        }
                        ParseResultExpr::Err(e) => {
                            return ParseResultExpr::Err(e);
                        }
                    }
                    need_primary = false;
                }
            } else {
                var bop: BinOp = BinOp::Add;
                var prec: i64 = 0;
                var found: bool = false;
                var info: BinOpInfo = self.peek_bin_op();
                bop = info.op;
                prec = info.prec;
                found = info.found;
                if found {
                    self.advance();
                    // Pop higher-or-equal precedence (left-associative)
                    while ops.len() > 0 {
                        var top: OpEntry = ops.get(ops.len() - 1);
                        var top_prec: i64 = 0;
                        var is_op: bool = false;
                        match top {
                            OpEntry::Op(_: BinOp, tp: i64) => {
                                top_prec = tp;
                                is_op = true;
                            }
                            OpEntry::Paren => {
                                break;
                            }
                        }
                        if is_op && top_prec >= prec {
                            if !reduce_one_op(&mut vals, &mut ops) {
                                break;
                            }
                        } else {
                            break;
                        }
                    }
                    ops.push(OpEntry::Op(bop, prec));
                    need_primary = true;
                } else if self.check(TokenKind::RParen) {
                    // Close paren -- pop until Paren marker
                    var found_paren: bool = false;
                    while ops.len() > 0 {
                        var top: OpEntry = ops.get(ops.len() - 1);
                        var is_paren: bool = false;
                        match top {
                            OpEntry::Paren => {
                                is_paren = true;
                            }
                            OpEntry::Op => {
                            }
                        }
                        if is_paren {
                            ops.pop();
                            found_paren = true;
                            break;
                        }
                        if !reduce_one_op(&mut vals, &mut ops) {
                            break;
                        }
                    }
                    if found_paren {
                        self.advance();
                        // Check for tuple
                        if self.check(TokenKind::Comma) {
                            var elems: Vec<Expr> = Vec::new();
                            if vals.len() > 0 {
                                elems.push(vals.pop());
                            }
                            while self.match_tok(TokenKind::Comma) {
                                self.expr_depth = self.expr_depth + 1;
                                var elem: Expr = Expr::IntLit(0);
                                if self.expr_depth > self.max_expr_depth {
                                    match self.parse_expr_iterative() {
                                        ParseResultExpr::Ok(e) => {
                                            elem = e;
                                        }
                                        ParseResultExpr::Err(e) => {
                                            return ParseResultExpr::Err(e);
                                        }
                                    }
                                } else {
                                    match self.parse_expr() {
                                        ParseResultExpr::Ok(e) => {
                                            elem = e;
                                        }
                                        ParseResultExpr::Err(e) => {
                                            return ParseResultExpr::Err(e);
                                        }
                                    }
                                }
                                self.expr_depth = self.expr_depth - 1;
                                elems.push(elem);
                            }
                            match self.expect(TokenKind::RParen, ")") {
                                ParseResultUnit::Err(e) => {
                                    return ParseResultExpr::Err(e);
                                }
                                ParseResultUnit::Ok => {
                                }
                            }
                            vals.push(Expr::TupleLit(elems));
                        }
                    } else {
                        break;
                    }
                } else {
                    break;
                }
            }
        }
        // Drain remaining operators
        while ops.len() > 0 {
            var top: OpEntry = ops.get(ops.len() - 1);
            var is_paren: bool = false;
            match top {
                OpEntry::Paren => {
                    is_paren = true;
                }
                OpEntry::Op => {
                }
            }
            if is_paren {
                return ParseResultExpr::Err("unmatched '(' in expression");
            }
            if !reduce_one_op(&mut vals, &mut ops) {
                break;
            }
        }

        if vals.len() == 0 {
            return ParseResultExpr::Err("expected expression");
        }
        return ParseResultExpr::Ok(vals.pop());
    }

    /// `{ ident :` at the parser's position, after a name. BG257: of any
    /// case: the structs of other modules are lowercase as often as not
    /// (math's `vec2`, `mat4`), and no block starts with `ident :` either
    /// way; the capital a name needed before kept their literals from
    /// parsing.
    fn pd_field_init_follows(self: &Parser, name: str) -> bool {
        if str_len(name) == 0 {
            return false;
        }
        if self.pos + 2 >= self.tokens.len() {
            return false;
        }
        // `Name { ..` (CL5 defaults, or `..base`): no block starts with `..`
        if token_kind_eq(self.tokens.get(self.pos + 1).kind, TokenKind::DotDot) {
            return true;
        }
        var is_id: bool = false;
        match self.tokens.get(self.pos + 1).kind {
            TokenKind::Ident(_fi: str) => {
                is_id = true;
            }
            _ => {
            }
        }
        // a word keyword names a field too (`BlockDev { handle: h, .. }`,
        // bugs 11/24): no statement starts with `keyword :` either
        if is_word_keyword(self.tokens.get(self.pos + 1).kind) {
            is_id = true;
        }
        return is_id && token_kind_eq(self.tokens.get(self.pos + 2).kind, TokenKind::Colon);
    }

    /// `@import(` at the parser's position.
    fn pd_at_import(self: &Parser) -> bool {
        if self.pos + 2 >= self.tokens.len() {
            return false;
        }
        var is_import: bool = false;
        match self.tokens.get(self.pos + 1).kind {
            TokenKind::Ident(nm: str) => {
                is_import = nm == "import";
            }
            _ => {
            }
        }
        return is_import && token_kind_eq(self.tokens.get(self.pos + 2).kind, TokenKind::LParen);
    }

    /// `@import("path/foo.h")`: the import of `path/foo`, found as a header
    /// (compiler.fd's import resolution: `.fd` first, then `.h`).
    fn parse_at_import(self: &mut Parser) -> ParseResultImportDef {
        self.advance();
        self.advance();
        self.advance();
        var tok: Token = self.peek_token();
        var hpath: str = "";
        var ok: bool = false;
        match tok.kind {
            TokenKind::StringLit(sv: str) => {
                hpath = sv;
                ok = true;
            }
            _ => {
            }
        }
        // LG16: a C++ header too (`@import("lib.hpp")`: its extern "C" part)
        var hext: i64 = 2;
        if ok && str_ends_with(hpath, ".hpp") {
            hext = 4;
        } else if ok && str_ends_with(hpath, ".h") == false {
            ok = false;
        }
        if !ok {
            return ParseResultImportDef::Err("Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) + ": @import takes a C header name, as in @import(\"foo.h\")\n    Fix: put the header's name in quotes inside the parentheses");
        }
        self.advance();
        // LG15: `@import("foo.h", trusted)`: its functions are called
        // without `unsafe` (the author vouches for the header)
        var trusted: bool = false;
        if self.match_tok(TokenKind::Comma) {
            var ttok: Token = self.peek_token();
            match ttok.kind {
                TokenKind::Ident(tw: str) => {
                    if tw == "trusted" {
                        trusted = true;
                    }
                }
                _ => {
                }
            }
            if trusted == false {
                return ParseResultImportDef::Err("Parse error at " + int_to_str(ttok.line) + ":" + int_to_str(ttok.col) + ": @import takes a header name and, optionally, `trusted`: @import(\"foo.h\", trusted)\n    Fix: after the header's name write only `, trusted`, or nothing");
            }
            self.advance();
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => {
                return ParseResultImportDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        self.match_tok(TokenKind::Semicolon);
        var base: str = str_slice(hpath, 0, str_len(hpath) - hext);
        var ipath: str = str_replace(base, "/", "::");
        // LG15: the import loop also looks in the system include directories
        // for a header written as @import (flag 1), and marks a trusted one (2)
        var iflags: i64 = 1;
        if trusted {
            iflags = 3;
        }
        self.pd_note_at_import(ipath, iflags);
        return ParseResultImportDef::Ok(ImportDef_new_full(ipath, Vec::new(), Vec::new(), OptStr::None, OptStr::None, false, false));
    }

    fn parse_use(self: &mut Parser) -> ParseResultImportDef {
        match self.expect(TokenKind::Use, "use") {
            ParseResultUnit::Err(e) => {
                return ParseResultImportDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var is_glob: bool = false;
        var path: str = "";
        loop {
            if self.check(TokenKind::LBrace) {
                break;
            }
            if self.check(TokenKind::Star) {
                if str_ends_with(path, "::") {
                    path = str_slice(path, 0, str_len(path) - 2);
                }
                self.advance();
                is_glob = true;
                break;
            }
            var name: str = "";
            match self.expect_ident_or_keyword() {
                ParseResultStr::Ok(s) => {
                    name = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultImportDef::Err(e);
                }
            }
            path = path + name;
            if self.match_tok(TokenKind::DoubleColon) {
                path = path + "::";
            } else {
                break;
            }
        }
        // alias: use path as alias
        var alias: OptStr = OptStr::None;
        if self.match_tok(TokenKind::As) {
            match self.expect_ident() {
                ParseResultStr::Ok(s) => {
                    alias = OptStr::Some(s);
                }
                ParseResultStr::Err(e) => {
                    return ParseResultImportDef::Err(e);
                }
            }
        }
        // selective imports: { item1, item2 } or { * }
        var items: Vec<str> = Vec::new();
        if self.match_tok(TokenKind::LBrace) {
            if self.check(TokenKind::Star) {
                self.advance();
                is_glob = true;
            } else if !self.check(TokenKind::RBrace) {
                loop {
                    var item: str = "";
                    match self.expect_ident() {
                        ParseResultStr::Ok(s) => {
                            item = s;
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultImportDef::Err(e);
                        }
                    }
                    items.push(item);
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => {
                    return ParseResultImportDef::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        }
        // Strip trailing :: from path if items were specified
        if (items.len() > 0 || is_glob) && str_ends_with(path, "::") {
            path = str_slice(path, 0, str_len(path) - 2);
        }
        // Check for capability grant: with { IO, FS }
        var capabilities: Vec<str> = Vec::new();
        if self.match_tok(TokenKind::With) {
            match self.expect(TokenKind::LBrace, "{") {
                ParseResultUnit::Err(e) => {
                    return ParseResultImportDef::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            if !self.check(TokenKind::RBrace) {
                loop {
                    var cap: str = "";
                    match self.expect_ident() {
                        ParseResultStr::Ok(s) => {
                            cap = s;
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultImportDef::Err(e);
                        }
                    }
                    capabilities.push(cap);
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => {
                    return ParseResultImportDef::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        }
        // A version pin (`use m = "1.0"`) is a parse error (reference §2.9):
        // the import is the one the path names.
        var version: OptStr = OptStr::None;
        if self.check(TokenKind::Eq) {
            var vtok: Token = self.peek_token();
            return ParseResultImportDef::Err("Parse error at " + int_to_str(vtok.line) + ":" + int_to_str(vtok.col) + ": a `use` does not take a version pin: `use m = \"1.0\"` is not an import\n    Fix: remove the `= \"...\"`; the path alone says which module.");
        }
        self.match_tok(TokenKind::Semicolon);
        var import_result: ImportDef = ImportDef_new_full(path, items, capabilities, version, alias, false, is_glob);
        match alias {
            OptStr::Some(al) => {
                self.pd_import_add(al);
            }
            OptStr::None => {
                self.pd_import_add(path_last(path));
            }
        }
        return ParseResultImportDef::Ok(import_result);
    }

    fn parse_at_annotation(self: &mut Parser) -> ParseResultAnnotation {
        match self.expect(TokenKind::At, "@") {
            ParseResultUnit::Err(e) => {
                return ParseResultAnnotation::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var name: str = "";
        var tok: Token = self.peek_token();
        match tok.kind {
            TokenKind::Ident(s: str) => {
                self.advance();
                var full_name: str = s;
                // Hyphenated name: ident - ident - ident ...
                while self.check(TokenKind::Minus) {
                    self.advance();
                    var ptok: Token = self.peek_token();
                    match ptok.kind {
                        TokenKind::Ident(part: str) => {
                            self.advance();
                            full_name = full_name + "-" + part;
                        }
                        _ => {
                        }
                    }
                }
                name = full_name;
            }
            TokenKind::Kernel => {
                self.advance();
                name = "kernel";
            }
            TokenKind::Layer => {
                self.advance();
                name = "layer";
            }
            TokenKind::Model => {
                self.advance();
                name = "model";
            }
            TokenKind::Interrupt => {
                self.advance();
                name = "interrupt";
            }
            TokenKind::Unsafe => {
                self.advance();
                name = "unsafe";
            }
            _ => {
            }
        }
        if str_len(name) == 0 {
            var ptok: Token = self.peek_token();
            return ParseResultAnnotation::Err("Parse error at " + int_to_str(ptok.line) + ":" + int_to_str(ptok.col) + ": expected annotation name after '@'\n    Fix: write the annotation's name right after @, as in @inline");
        }
        var args: Vec<str> = Vec::new();
        if self.match_tok(TokenKind::LParen) {
            if !self.check(TokenKind::RParen) {
                loop {
                    match self.parse_annotation_arg() {
                        ParseResultStr::Ok(arg) => {
                            args.push(arg);
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultAnnotation::Err(e);
                        }
                    }
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => {
                    return ParseResultAnnotation::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        }
        if name == "secret" || name == "sensitive" {
            self.pd_saw_secret();
        }
        var __ret_Annotation: Annotation = Annotation_new(name, args);
        return ParseResultAnnotation::Ok(__ret_Annotation);
    }

    fn parse_annotation_arg(self: &mut Parser) -> ParseResultStr {
        var arg: str = "";
        var tok: Token = self.peek_token();
        match tok.kind {
            TokenKind::Ident(s: str) => {
                self.advance();
                arg = s;
                if self.match_tok(TokenKind::Eq) {
                    arg = arg + "=";
                    match self.parse_annotation_arg() {
                        ParseResultStr::Ok(rest) => {
                            arg = arg + rest;
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultStr::Err(e);
                        }
                    }
                }
                return ParseResultStr::Ok(arg);
            }
            TokenKind::Use => {
                // CU3: `@deprecated(use = "new_fn")` (`use` is a keyword)
                self.advance();
                arg = "use";
                if self.match_tok(TokenKind::Eq) {
                    arg = arg + "=";
                    match self.parse_annotation_arg() {
                        ParseResultStr::Ok(rest) => {
                            arg = arg + rest;
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultStr::Err(e);
                        }
                    }
                }
                return ParseResultStr::Ok(arg);
            }
            TokenKind::IntLit(n: i64) => {
                self.advance();
                return ParseResultStr::Ok(int_to_str(n));
            }
            TokenKind::FloatLit(f: f64) => {
                self.advance();
                return ParseResultStr::Ok(float_to_str(f));
            }
            TokenKind::Minus => {
                // CL10: a negative number (`@dimension(s = -2)`)
                self.advance();
                var ntok: Token = self.peek_token();
                match ntok.kind {
                    TokenKind::IntLit(nn: i64) => {
                        self.advance();
                        return ParseResultStr::Ok("-" + int_to_str(nn));
                    }
                    TokenKind::FloatLit(nf: f64) => {
                        self.advance();
                        return ParseResultStr::Ok("-" + float_to_str(nf));
                    }
                    _ => {
                    }
                }
                return ParseResultStr::Err("Expected a number after '-' in an annotation argument, got '" + token_kind_to_str(ntok.kind) + "'");
            }
            TokenKind::StringLit(s: str) => {
                self.advance();
                return ParseResultStr::Ok("\"" + s + "\"");
            }
            TokenKind::LBracket => {
                self.advance();
                arg = "[";
                loop {
                    match self.parse_annotation_arg() {
                        ParseResultStr::Ok(part) => {
                            arg = arg + part;
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultStr::Err(e);
                        }
                    }
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                    arg = arg + ",";
                }
                match self.expect(TokenKind::RBracket, "]") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultStr::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                arg = arg + "]";
                return ParseResultStr::Ok(arg);
            }
            _ => {
            }
        }
        return ParseResultStr::Err("Expected annotation argument, got '" + token_kind_to_str(tok.kind) + "'");
    }

    fn parse_attribute(self: &mut Parser) -> ParseResultAttribute {
        match self.expect(TokenKind::Hash, "#") {
            ParseResultUnit::Err(e) => {
                return ParseResultAttribute::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        match self.expect(TokenKind::LBracket, "[") {
            ParseResultUnit::Err(e) => {
                return ParseResultAttribute::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultAttribute::Err(e);
            }
        }
        var args: Vec<str> = Vec::new();
        if self.match_tok(TokenKind::LParen) {
            if !self.check(TokenKind::RParen) {
                loop {
                    var arg: str = "";
                    // ST3: a number or a string too (`#[edition(2026)]`)
                    var lit_arg: bool = false;
                    match self.peek() {
                        TokenKind::IntLit(an: i64) => {
                            arg = int_to_str(an);
                            lit_arg = true;
                        }
                        TokenKind::StringLit(asv: str) => {
                            arg = asv;
                            lit_arg = true;
                        }
                        _ => {
                        }
                    }
                    if lit_arg {
                        self.advance();
                    } else {
                        match self.expect_ident() {
                            ParseResultStr::Ok(s) => {
                                arg = s;
                            }
                            ParseResultStr::Err(e) => {
                                return ParseResultAttribute::Err(e);
                            }
                        }
                    }
                    args.push(arg);
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => {
                    return ParseResultAttribute::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        }
        match self.expect(TokenKind::RBracket, "]") {
            ParseResultUnit::Err(e) => {
                return ParseResultAttribute::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var __ret_Attribute: Attribute = Attribute_new(name, args);
        return ParseResultAttribute::Ok(__ret_Attribute);
    }

    /// The parts of an f-string: text, and each `{ ... }` as one expression
    /// (reference §1.8). `line` and `col` are the literal's own: an error in a
    /// part names the f-string.
    fn parse_fstring_parts(self: &mut Parser, raw: str, line: i64, col: i64) -> ParseResultExpr {
        var parts: Vec<FStringPart> = Vec::new();
        var current: str = "";
        var i: i64 = 0;
        var len: i64 = str_len(raw);

        while i < len {
            var c: i64 = str_byte_at(raw, i);
            if c == 92 && i + 1 < len {
                // BG209: a `\` marks a text byte the lexer decoded from an
                // escape (`\x7B`, `\u{7d}`, `\\`): text, not a brace
                current = current + byte_to_str(str_byte_at(raw, i + 1));
                i = i + 2;
            } else if c == 123 {
                // '{' -- start of interpolation
                if str_len(current) > 0 {
                    parts.push(FStringPart::Literal(current));
                    current = "";
                }
                // The expression runs to the matching '}'; a string or
                // char literal in it is skipped whole (BG210, BG211)
                i = i + 1;
                var e_end: i64 = lex_fstr_expr_end(raw, len, i);
                var expr_src: str = str_slice(raw, i, e_end);
                i = e_end + 1;
                // A ':' at brace depth 0 (not a `::` path, not inside
                // brackets or a nested string or char literal) splits the
                // expression from a format specifier (`{x:.2}`, `{n:5}`,
                // `{x:#x}`, §1.8)
                var spec_at: i64 = -1;
                var sd: i64 = 0;
                var sj: i64 = 0;
                var es_len: i64 = str_len(expr_src);
                while sj < es_len {
                    var sc: i64 = str_byte_at(expr_src, sj);
                    var lit_end: i64 = sj + 1;
                    if sc == 34 || sc == 39 || sc == 102 || sc == 114 {
                        lit_end = lex_fstr_lit_end(expr_src, es_len, sj);
                    }
                    if lit_end > sj + 1 {
                        // a literal: a `:` or bracket in it is its own
                        sj = lit_end - 1;
                    } else if sc == 123 || sc == 91 || sc == 40 {
                        sd = sd + 1;
                    } else if sc == 125 || sc == 93 || sc == 41 {
                        sd = sd - 1;
                    } else if sc == 58 && sd == 0 {
                        var sprev: i64 = 0;
                        var snext: i64 = 0;
                        if sj > 0 {
                            sprev = str_byte_at(expr_src, sj - 1);
                        }
                        if sj + 1 < es_len {
                            snext = str_byte_at(expr_src, sj + 1);
                        }
                        if sprev != 58 && snext != 58 {
                            spec_at = sj;
                            break;
                        }
                    }
                    sj = sj + 1;
                }
                var spec: str = "";
                var parse_src: str = expr_src;
                if spec_at >= 0 {
                    spec = str_slice(expr_src, spec_at + 1, es_len);
                    parse_src = str_slice(expr_src, 0, spec_at);
                    spec = str_trim(spec);
                }
                // Re-lex and parse the expression
                var sub_lexer: Lexer = Lexer::new(parse_src);
                // SP9: on a worker thread, a keyword cache of its own
                // (0, the shared one, otherwise)
                sub_lexer.own_kw = self.own_kw;
                var sub_tokens: Vec<Token> = sub_lexer.tokenize();
                // BG210: an error of the expression's own lexing (`'` with
                // no character, `"\q"`) is the program's, not dropped
                if sub_lexer.errors.len() > 0 {
                    return ParseResultExpr::Err("Parse error at " + int_to_str(line) + ":" + int_to_str(col) + ": in the f-string expression `{" + expr_src + "}`: " + parse_fstr_lex_fix(sub_lexer.errors.get(0)));
                }
                var sub_parser: Parser = Parser::new(sub_tokens);
                // SP9: a parse on a worker thread: the expression's parse
                // reads and adds to this parse's import set, calls and
                // numbers (side_*), and hands them back after
                if self.own_side {
                    sub_parser.own_side = true;
                    sub_parser.own_kw = self.own_kw;
                    sub_parser.side_imports = self.side_imports;
                    sub_parser.side_import_adds = self.side_import_adds;
                    sub_parser.side_qcalls = self.side_qcalls;
                    sub_parser.side_at_paths = self.side_at_paths;
                    sub_parser.side_at_flags = self.side_at_flags;
                    sub_parser.side_turbofish = self.side_turbofish;
                    sub_parser.side_pcalls = self.side_pcalls;
                    sub_parser.side_secret = self.side_secret;
                    sub_parser.side_splice = self.side_splice;
                }
                var sub_res: ParseResultExpr = sub_parser.parse_expr();
                if self.own_side {
                    self.side_import_adds = sub_parser.side_import_adds;
                    self.side_qcalls = sub_parser.side_qcalls;
                    self.side_at_paths = sub_parser.side_at_paths;
                    self.side_at_flags = sub_parser.side_at_flags;
                    self.side_turbofish = sub_parser.side_turbofish;
                    self.side_pcalls = sub_parser.side_pcalls;
                    self.side_secret = sub_parser.side_secret;
                    self.side_splice = sub_parser.side_splice;
                }
                match sub_res {
                    ParseResultExpr::Ok(e) => {
                        if !sub_parser.is_at_end() {
                            return ParseResultExpr::Err("Parse error at " + int_to_str(line) + ":" + int_to_str(col) + ": text follows the expression in an f-string: `{" + expr_src + "}`.\n    Fix: the braces of an f-string hold one expression, then an optional `:` and a format spec (`:.2`, `:5`, `#x`).");
                        }
                        if str_len(spec) > 0 {
                            var fmt_args: Vec<Expr> = Vec::new();
                            fmt_args.push(e);
                            fmt_args.push(Expr::StringLit(spec));
                            parts.push(FStringPart::Expr(Expr::Call("__fstr_fmt", fmt_args)));
                        } else {
                            parts.push(FStringPart::Expr(e));
                        }
                    }
                    ParseResultExpr::Err(e) => {
                        return ParseResultExpr::Err(e);
                    }
                }
            } else {
                current = current + byte_to_str(c);
                i = i + 1;
            }
        }
        if str_len(current) > 0 {
            parts.push(FStringPart::Literal(current));
        }
        return ParseResultExpr::Ok(Expr::FString(parts));
    }
}
// close impl Parser block

/// BG210: a lexer error of an f-string's expression (`Error:L:C: text`,
/// placed in the expression alone) as the f-string's error: its text and
/// its Fix line, without the expression's own position.
fn parse_fstr_lex_fix(e: str) -> str {
    var n: i64 = str_len(e);
    var k: i64 = 0;
    var colons: i64 = 0;
    if str_starts_with(e, "Error:") {
        while k < n && colons < 3 {
            if str_byte_at(e, k) == 58 {
                colons = colons + 1;
            }
            k = k + 1;
        }
        while k < n && str_byte_at(e, k) == 32 {
            k = k + 1;
        }
    }
    var msg: str = str_slice(e, k, n);
    if str_find(msg, "Fix:") < 0 {
        msg = msg + "\n    Fix: write the expression in the braces as it would be written outside the f-string";
    }
    return msg;
}

pub fn Parser_with_names(tokens: Vec<Token>, struct_names: Vec<str>, enum_names: Vec<str>) -> Parser {
    // Build HashMaps for O(1) name lookup (string interning)
    var sn_set: i64 = HashMap_new();
    var si: i64 = 0;
    while si < struct_names.len() {
        HashMap_insert(sn_set, struct_names.get(si), 1);
        si = si + 1;
    }
    var en_set: i64 = HashMap_new();
    var ei: i64 = 0;
    while ei < enum_names.len() {
        HashMap_insert(en_set, enum_names.get(ei), 1);
        ei = ei + 1;
    }
    return pd_parser_make(tokens, struct_names, enum_names, sn_set, en_set);
}

// Helper: extract Expr from Box<Expr> (Fides has no * deref for Box)
pub fn vec_str_join(v: Vec<str>, sep: str) -> str {
    var result: str = "";
    var i: i64 = 0;
    while i < v.len() {
        if i > 0 {
            result = result + sep;
        }
        result = result + v.get(i);
        i = i + 1;
    }
    return result;
}

// BG264: the exhaustiveness probe of a match with nested patterns. The
// desugaring (pd_desugar_arms) ends every inner match with a `_` arm that
// re-matches the rest, so the type checker's one-level check sees only
// complete matches: `Some(Ok(x))` + `None` passed and panicked on
// `Some(Err(..))`. Before desugaring, the original arms are compiled into a
// tree of one-level matches with empty bodies (rows specialized by each
// constructor of a column, as a match compiler does), put under `if false`:
// the type checker's check_exhaustive then reports the missing variant of
// the nested position. A column's `_` arm (rows that cover every value) is
// added without checking those rows further, so the probe can miss a case
// but never rejects an exhaustive match. Guarded arms cover nothing, as in
// check_exhaustive.
fn pd_np_lookup(nests: Vec<PatNest>, name: str) -> Pattern {
    if str_starts_with(name, "__np") {
        var i: i64 = 0;
        while i < nests.len() {
            if nests.get(i).name == name {
                return nests.get(i).pat;
            }
            i = i + 1;
        }
    }
    return Pattern::Wildcard;
}

// A pattern's constructor: "" when it covers every value (`_`, a binding),
// "#" when it is a literal (covers no constructor), else the variant name
// or `true`/`false`. A bare name is a constructor only for the variants of
// Option and Result (anything else may be a binding).
fn pd_np_ctor(p: Pattern) -> str {
    match p {
        Pattern::Wildcard => {
            return "";
        }
        Pattern::Ident(n) => {
            if n == "None" || n == "Some" || n == "Ok" || n == "Err" {
                return n;
            }
            return "";
        }
        Pattern::EnumVariant(_, v, _) => {
            return v;
        }
        Pattern::BoolLit(b) => {
            if b {
                return "true";
            }
            return "false";
        }
        _ => {
            return "#";
        }
    }
    return "#";
}

fn pd_np_arity(p: Pattern) -> i64 {
    match p {
        Pattern::EnumVariant(_, _, bs) => {
            return bs.len();
        }
        _ => {
        }
    }
    return 0;
}

fn pd_np_subs(p: Pattern, n: i64, nests: Vec<PatNest>) -> Vec<Pattern> {
    var out: Vec<Pattern> = Vec::new();
    match p {
        Pattern::EnumVariant(_, _, bs) => {
            var i: i64 = 0;
            while i < bs.len() {
                out.push(pd_np_lookup(nests, bs.get(i).name));
                i = i + 1;
            }
        }
        _ => {
        }
    }
    while out.len() < n {
        out.push(Pattern::Wildcard);
    }
    return out;
}

fn pd_np_probe(rows: Vec<Vec<Pattern>>, cols: Vec<str>, nests: Vec<PatNest>, ctr: &mut i64, line: i64) -> Vec<Stmt> {
    var out: Vec<Stmt> = Vec::new();
    if cols.len() == 0 || rows.len() == 0 {
        return out;
    }
    var rest_cols: Vec<str> = Vec::new();
    var c: i64 = 1;
    while c < cols.len() {
        rest_cols.push(cols.get(c));
        c = c + 1;
    }
    var ctors: Vec<str> = Vec::new();
    var firsts: Vec<Pattern> = Vec::new();
    var arity: Vec<i64> = Vec::new();
    var has_wild: bool = false;
    var r: i64 = 0;
    while r < rows.len() {
        var p: Pattern = rows.get(r).get(0);
        var k: str = pd_np_ctor(p);
        if k == "" {
            has_wild = true;
        } else if k != "#" {
            var idx: i64 = 0 - 1;
            var q: i64 = 0;
            while q < ctors.len() {
                if ctors.get(q) == k {
                    idx = q;
                }
                q = q + 1;
            }
            var n: i64 = pd_np_arity(p);
            if idx < 0 {
                ctors.push(k);
                firsts.push(p);
                arity.push(n);
            } else if n > arity.get(idx) {
                arity.set(idx, n);
            }
        }
        r = r + 1;
    }
    if ctors.len() == 0 {
        // nothing to check in this column: the rows that cover every value
        // go on to the next one
        var drows: Vec<Vec<Pattern>> = Vec::new();
        r = 0;
        while r < rows.len() {
            var row: Vec<Pattern> = rows.get(r);
            if pd_np_ctor(row.get(0)) == "" {
                var nr: Vec<Pattern> = Vec::new();
                var j: i64 = 1;
                while j < row.len() {
                    nr.push(row.get(j));
                    j = j + 1;
                }
                drows.push(nr);
            }
            r = r + 1;
        }
        return pd_np_probe(drows, rest_cols, nests, ctr, line);
    }
    var arms: Vec<MatchArm> = Vec::new();
    var ci: i64 = 0;
    while ci < ctors.len() {
        var k2: str = ctors.get(ci);
        var n2: i64 = arity.get(ci);
        var names: Vec<str> = Vec::new();
        var bindings: Vec<Binding> = Vec::new();
        var j2: i64 = 0;
        while j2 < n2 {
            var nm: str = "__pq" + int_to_str(*ctr);
            *ctr = *ctr + 1;
            names.push(nm);
            bindings.push(Binding_new(nm, ""));
            j2 = j2 + 1;
        }
        var spec: Vec<Vec<Pattern>> = Vec::new();
        r = 0;
        while r < rows.len() {
            var row2: Vec<Pattern> = rows.get(r);
            var kk: str = pd_np_ctor(row2.get(0));
            if kk == k2 || kk == "" {
                var nr2: Vec<Pattern> = Vec::new();
                if kk == k2 {
                    nr2 = pd_np_subs(row2.get(0), n2, nests);
                } else {
                    var w: i64 = 0;
                    while w < n2 {
                        nr2.push(Pattern::Wildcard);
                        w = w + 1;
                    }
                }
                var j3: i64 = 1;
                while j3 < row2.len() {
                    nr2.push(row2.get(j3));
                    j3 = j3 + 1;
                }
                spec.push(nr2);
            }
            r = r + 1;
        }
        var sub_cols: Vec<str> = names;
        var j4: i64 = 0;
        while j4 < rest_cols.len() {
            sub_cols.push(rest_cols.get(j4));
            j4 = j4 + 1;
        }
        var body: Vec<Stmt> = pd_np_probe(spec, sub_cols, nests, ctr, line);
        var pat: Pattern = firsts.get(ci);
        if n2 > 0 {
            match firsts.get(ci) {
                Pattern::EnumVariant(en, v, _) => {
                    pat = Pattern::EnumVariant(en, v, bindings);
                }
                _ => {
                    pat = Pattern::EnumVariant("", k2, bindings);
                }
            }
        }
        arms.push(MatchArm_new(pat, OptBoxExpr::None, body));
        ci = ci + 1;
    }
    if has_wild {
        arms.push(MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, Vec::new()));
    }
    out.push(Stmt::Match(Expr::Ident(cols.get(0)), arms, line));
    return out;
}

// The probe of a match on `scrut` with arms `arms` (before desugaring), as
// one `if false { ... }` statement; none when no arm has a nested pattern
// position worth checking.
fn pd_np_probe_stmt(scrut: str, arms: Vec<MatchArm>, nests: Vec<PatNest>, line: i64) -> Vec<Stmt> {
    var rows: Vec<Vec<Pattern>> = Vec::new();
    var i: i64 = 0;
    while i < arms.len() {
        var a: MatchArm = arms.get(i);
        var guarded: bool = false;
        match a.guard {
            OptBoxExpr::Some(_) => {
                guarded = true;
            }
            OptBoxExpr::None => {
            }
        }
        if !guarded {
            var row: Vec<Pattern> = Vec::new();
            row.push(a.pattern);
            rows.push(row);
        }
        i = i + 1;
    }
    var cols: Vec<str> = Vec::new();
    cols.push(scrut);
    var ctr: i64 = 0;
    var probe: Vec<Stmt> = pd_np_probe(rows, cols, nests, &mut ctr, line);
    var out: Vec<Stmt> = Vec::new();
    if probe.len() > 0 {
        // the outer variants are the real match's to check (one error,
        // not two): the probe's top level gets a `_` arm
        match probe.get(0) {
            Stmt::Match(pe, parms, pl) => {
                var top: Vec<MatchArm> = parms;
                var lastw: bool = false;
                if top.len() > 0 {
                    match top.get(top.len() - 1).pattern {
                        Pattern::Wildcard => {
                            lastw = true;
                        }
                        _ => {
                        }
                    }
                }
                if !lastw {
                    top.push(MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, Vec::new()));
                }
                probe = Vec::new();
                probe.push(Stmt::Match(pe, top, pl));
            }
            _ => {
            }
        }
        out.push(Stmt::If(Expr::BoolLit(false), probe, OptStmts::None, line));
    }
    return out;
}

// Whether the outer pattern of an arm binds `name` (the probe of a match
// expression goes into its first arm, where such a binding would hide the
// scrutinee).
fn pd_np_binds(p: Pattern, name: str) -> bool {
    match p {
        Pattern::Ident(n) => {
            return n == name;
        }
        Pattern::EnumVariant(_, _, bs) => {
            var i: i64 = 0;
            while i < bs.len() {
                if bs.get(i).name == name {
                    return true;
                }
                i = i + 1;
            }
        }
        _ => {
        }
    }
    return false;
}

fn pd_has_cfg(f: Func) -> bool {
    var i: i64 = 0;
    while i < f.annotations.len() {
        if f.annotations.get(i).name == "cfg" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// L8H: functions of one name in a file, at least one of them generic, are
/// a definition and its specializations (`fn show<T>(x: T)` with
/// `fn show(x: i64)`). The most general (the most type parameters, the
/// first of those) keeps the name; each other one is renamed
/// `name__spec<k>` (ast.fd spec_base_name), so it is no duplicate, and
/// monomorphization takes an instantiation's body from the most specific
/// one that takes its types. @cfg variants are not grouped.
fn pd_name_specializations(program: &mut Program) {
    val n: i64 = program.funcs.len();
    if n < 2 {
        return;
    }
    var count: i64 = HashMap_new();
    var generic: i64 = HashMap_new();
    var i: i64 = 0;
    var any: bool = false;
    while i < n {
        if !pd_has_cfg(program.funcs.get(i)) {
            val fname: str = program.funcs.get(i).name;
            val c: i64 = HashMap_get(count, fname) + 1;
            HashMap_insert(count, fname, c);
            if program.funcs.get(i).type_params.len() > 0 {
                HashMap_insert(generic, fname, 1);
            }
            if c > 1 && HashMap_get(generic, fname) != 0 {
                any = true;
            }
        }
        i = i + 1;
    }
    if !any {
        // a generic seen after a second definition of its name
        i = 0;
        while i < n && !any {
            val gname: str = program.funcs.get(i).name;
            if HashMap_get(count, gname) > 1 && HashMap_get(generic, gname) != 0 {
                any = true;
            }
            i = i + 1;
        }
    }
    if !any {
        HashMap_drop(count);
        HashMap_drop(generic);
        return;
    }
    // the definition that keeps the name (1 + its index): the first generic
    // one whose parameters take every other one's (ast.fd spec_at_least),
    // else the one with the most type parameters
    var base_at: i64 = HashMap_new();
    var base_tp: i64 = HashMap_new();
    i = 0;
    while i < n {
        if !pd_has_cfg(program.funcs.get(i)) {
            val bname: str = program.funcs.get(i).name;
            if HashMap_get(count, bname) > 1 && HashMap_get(generic, bname) != 0 {
                val cur: i64 = HashMap_get(base_tp, bname);
                if cur == 0 || program.funcs.get(i).type_params.len() > program.funcs.get(cur - 1).type_params.len() {
                    HashMap_insert(base_tp, bname, i + 1);
                }
                if HashMap_get(base_at, bname) == 0 && program.funcs.get(i).type_params.len() > 0 {
                    var general: bool = true;
                    var j: i64 = 0;
                    while j < n && general {
                        if j != i && program.funcs.get(j).name == bname && !pd_has_cfg(program.funcs.get(j)) {
                            if !spec_at_least(program.funcs.get(j), program.funcs.get(i)) {
                                general = false;
                            }
                        }
                        j = j + 1;
                    }
                    if general {
                        HashMap_insert(base_at, bname, i + 1);
                    }
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < n {
        val tname: str = program.funcs.get(i).name;
        if HashMap_get(base_at, tname) == 0 && HashMap_get(base_tp, tname) != 0 {
            HashMap_insert(base_at, tname, HashMap_get(base_tp, tname));
        }
        i = i + 1;
    }
    HashMap_drop(base_tp);
    var spec_n: i64 = HashMap_new();
    var funcs: Vec<Func> = Vec::new();
    i = 0;
    while i < n {
        var f: Func = program.funcs.get(i);
        val at: i64 = HashMap_get(base_at, f.name);
        if at != 0 && at != i + 1 && !pd_has_cfg(f) {
            val k: i64 = HashMap_get(spec_n, f.name) + 1;
            HashMap_insert(spec_n, f.name, k);
            f.name = f.name + "__spec" + int_to_str(k);
        }
        funcs.push(f);
        i = i + 1;
    }
    program.funcs = funcs;
    HashMap_drop(count);
    HashMap_drop(generic);
    HashMap_drop(base_at);
    HashMap_drop(spec_n);
}

/// L8A: `usize` / `isize` after a const parameter (`const N: usize`):
/// words, not type keywords, read as i64.
pub fn pd_size_type_tok(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Ident(w: str) => {
            return w == "usize" || w == "isize";
        }
        _ => {
        }
    }
    return false;
}

pub fn is_int_type_keyword(kind: TokenKind) -> bool {
    if token_kind_eq(kind, TokenKind::I8) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::I16) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::I32) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::I64) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::I128) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::U8) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::U16) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::U32) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::U64) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::U128) {
        return true;
    }
    return false;
}

/// The error for a name expected where a reserved type name stands
/// (`val f32: i64 = 1;`): says the word is reserved (bugs 13/26), rather
/// than "expected identifier but got 'F32'".
pub fn pd_expected_name_err(tok: Token) -> str {
    var w: str = type_keyword_name(tok.kind);
    if token_kind_eq(tok.kind, TokenKind::F32) {
        w = "f32";
    } else if token_kind_eq(tok.kind, TokenKind::F64) {
        w = "f64";
    } else if token_kind_eq(tok.kind, TokenKind::Bool) {
        w = "bool";
    } else if token_kind_eq(tok.kind, TokenKind::Str) {
        w = "str";
    } else if token_kind_eq(tok.kind, TokenKind::Void) {
        w = "void";
    }
    var at: str = "Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) + ": ";
    if str_len(w) > 0 {
        return at + "expected a name but got the type name `" + w + "`: type names are reserved and cannot name a variable, parameter, field or function (reference §1.4); pick another name (`" + w + "_v`)";
    }
    return at + "expected identifier but got '" + token_kind_to_str(tok.kind) + "'";
}

pub fn type_keyword_name(kind: TokenKind) -> str {
    if token_kind_eq(kind, TokenKind::I8) {
        return "i8";
    }
    if token_kind_eq(kind, TokenKind::I16) {
        return "i16";
    }
    if token_kind_eq(kind, TokenKind::I32) {
        return "i32";
    }
    if token_kind_eq(kind, TokenKind::I64) {
        return "i64";
    }
    if token_kind_eq(kind, TokenKind::I128) {
        return "i128";
    }
    if token_kind_eq(kind, TokenKind::U8) {
        return "u8";
    }
    if token_kind_eq(kind, TokenKind::U16) {
        return "u16";
    }
    if token_kind_eq(kind, TokenKind::U32) {
        return "u32";
    }
    if token_kind_eq(kind, TokenKind::U64) {
        return "u64";
    }
    if token_kind_eq(kind, TokenKind::U128) {
        return "u128";
    }
    return "";
}

pub fn starts_type(kind: TokenKind) -> bool {
    if token_kind_eq(kind, TokenKind::I8) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::I16) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::I32) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::I64) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::I128) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::U8) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::U16) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::U32) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::U64) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::U128) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::F32) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::F64) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::Bool) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::Str) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::Void) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::Fn) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::Ampersand) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::Star) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::LBracket) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::LParen) {
        return true;
    }
    if token_kind_eq(kind, TokenKind::Dyn) {
        return true;
    }
    // Ident -- but we can't check payload here without the token. Caller handles.
    return false;
}

pub enum ParseResultIfExpr {
    Ok(IfExpr),
    Err(str),
}

pub struct BinOpInfo {
    pub op: BinOp,
    pub prec: i64,
    pub found: bool,
}

pub fn BinOpInfo_new(op: BinOp, prec: i64, found: bool) -> BinOpInfo {
    return BinOpInfo {
        op: op, prec: prec, found: found
    };
}

pub fn reduce_one_op(vals: &mut Vec<Expr>, ops: &mut Vec<OpEntry>) -> bool {
    if ops.len() == 0 {
        return false;
    }
    if vals.len() < 2 {
        return false;
    }
    var op_entry: OpEntry = ops.pop();
    match op_entry {
        OpEntry::Op(bop: BinOp, _: i64) => {
            var right: Expr = vals.pop();
            var left: Expr = vals.pop();
            vals.push(Expr::Binary(bop, Box::new(left), Box::new(right)));
            return true;
        }
        OpEntry::Paren => {
            // Put it back -- shouldn't reduce Paren
            ops.push(OpEntry::Paren);
            return false;
        }
    }
    return false;
}

// An @secret annotation was parsed: the secrecy analysis has work to do.
var g_saw_secret: bool = false;
pub fn parser_saw_secret() -> bool {
    return g_saw_secret;
}

// LG9: a `comptime splice { }` was parsed: process_gen (comptime_eval.fd)
// has splices to expand (it walks the program only then).
var g_saw_splice: bool = false;
pub fn parser_saw_splice() -> bool {
    return g_saw_splice;
}

/// LG9: the text a `comptime splice { }` block returned, parsed as exactly
/// one expression. The tokens count lines from `line` (the splice's), so an
/// error inside the generated expression points at the splice;
/// `struct_names` / `enum_names` are the program's, so `Name { .. }` and
/// `Name::V` in the text parse as they would in the source. Err: why the
/// text is not one expression.
pub fn parse_expression_source(source: str, line: i64, struct_names: Vec<str>, enum_names: Vec<str>) -> ParseResultExpr {
    var lex: Lexer = Lexer::new(source);
    lex.line = line;
    var tokens: Vec<Token> = lex.tokenize();
    if lex.errors.len() > 0 {
        return ParseResultExpr::Err(lex.errors.get(0));
    }
    var p: Parser = Parser_with_names(tokens, struct_names, enum_names);
    if p.is_at_end() {
        return ParseResultExpr::Err("the text is empty");
    }
    match p.parse_expr() {
        ParseResultExpr::Ok(e) => {
            if !p.is_at_end() {
                return ParseResultExpr::Err("text follows the expression, from '" + token_kind_to_str(p.peek()) + "' on");
            }
            return ParseResultExpr::Ok(e);
        }
        ParseResultExpr::Err(m) => {
            return ParseResultExpr::Err(m);
        }
    }
    return ParseResultExpr::Err("the text is not an expression");
}

/// RT6: `var v = Vec::new()` written without a type takes its element type
/// from a later `v.push(x)` in the same block (nested blocks included) whose
/// argument is a float, string or bool literal; without it the element was
/// an i64, and `print(v.get(0))` printed a float's bits.
fn pd_infer_vec_lets(stmts: Vec<Stmt>) -> Vec<Stmt> {
    var i: i64 = 0;
    var changed: bool = false;
    var out: Vec<Stmt> = Vec::new();
    while i < stmts.len() {
        var st: Stmt = stmts.get(i);
        match st {
            Stmt::Let(name, lty, init, is_mut, is_persist, anns, line) => {
                var untyped: bool = false;
                match lty {
                    OptType::None => {
                        untyped = true;
                    }
                    OptType::Some(_) => {
                    }
                }
                // `val d = v as dyn Tr` is a `dyn Tr`: its method calls are
                // dispatched (untyped, they looked for a `dyn_<method>`)
                if untyped {
                    match init {
                        Expr::Cast(_, cty) => {
                            match cty {
                                Type::Dyn(_) => {
                                    st = Stmt::Let(name, OptType::Some(cty), init, is_mut, is_persist, anns, line);
                                    changed = true;
                                }
                                _ => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                if untyped && pd_is_vec_new(init) {
                    var et: Type = Type::Infer;
                    var j: i64 = i + 1;
                    // B19: a pushed variable declared earlier in this block
                    // gives its type too (pd_arg_type)
                    var decl_names: Vec<str> = Vec::new();
                    var decl_types: Vec<Type> = Vec::new();
                    var dk: i64 = 0;
                    while dk < i {
                        pd_note_decl(stmts.get(dk), &mut decl_names, &mut decl_types);
                        dk = dk + 1;
                    }
                    while j < stmts.len() && type_eq_infer(et) {
                        et = pd_push_lit_type(stmts.get(j), name, decl_names, decl_types);
                        pd_note_decl(stmts.get(j), &mut decl_names, &mut decl_types);
                        j = j + 1;
                    }
                    if !type_eq_infer(et) {
                        var targs: Vec<Type> = Vec::new();
                        targs.push(et);
                        st = Stmt::Let(name, OptType::Some(Type::Generic("Vec", targs)), init, is_mut, is_persist, anns, line);
                        changed = true;
                    }
                }
            }
            _ => {
            }
        }
        out.push(st);
        i = i + 1;
    }
    if changed {
        return out;
    }
    return stmts;
}

fn type_eq_infer(t: Type) -> bool {
    match t {
        Type::Infer => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

fn pd_is_vec_new(e: Expr) -> bool {
    match e {
        Expr::MethodCall(recv, m, args) => {
            if m != "new" || args.len() != 0 {
                return false;
            }
            match box_expr_deref(recv) {
                Expr::Ident(rn) => {
                    return rn == "Vec";
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// The type of a literal: f64, str or bool (Infer for anything else).
fn pd_lit_type(e: Expr) -> Type {
    match e {
        Expr::FloatLit(_) => {
            return Type::F64;
        }
        Expr::StringLit(_) => {
            return Type::Str;
        }
        Expr::BoolLit(_) => {
            return Type::Bool;
        }
        Expr::Unary(_, inner) => {
            match box_expr_deref(inner) {
                Expr::FloatLit(_) => {
                    return Type::F64;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return Type::Infer;
}

// B19: the variables declared before the pushes pd_infer_vec_lets looks at
// (in the same block) whose type is a float, string or bool: name, type
// (decl_names / decl_types, locals of pd_infer_vec_lets: module globals
// before SP9, which a parse on another thread would have shared)

/// Whether `t` is a type pd_infer_vec_lets gives an untyped Vec from a
/// pushed variable (an i64 one needs nothing; others are left to the
/// type checker).
fn pd_vec_elem_kind(t: Type) -> bool {
    match t {
        Type::F64 => {
            return true;
        }
        Type::F32 => {
            return true;
        }
        Type::Str => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// Note the variable `st` declares, if any: `val x: bool = ..` (its type)
/// or `val x = 1.5` (a literal's type). Any other declaration of a name
/// hides an earlier one (Infer).
fn pd_note_decl(st: Stmt, decl_names: &mut Vec<str>, decl_types: &mut Vec<Type>) {
    match st {
        Stmt::Let(dn, dty, dinit, _, _, _, _) => {
            var t: Type = Type::Infer;
            match dty {
                OptType::Some(ty) => {
                    t = ty;
                }
                OptType::None => {
                    t = pd_lit_type(dinit);
                }
            }
            if !pd_vec_elem_kind(t) {
                t = Type::Infer;
            }
            decl_names.push(dn);
            decl_types.push(t);
        }
        _ => {
        }
    }
}

/// The type of a pushed value: a literal's, or that of a variable declared
/// earlier in the block (decl_names); Infer otherwise.
fn pd_arg_type(e: Expr, decl_names: Vec<str>, decl_types: Vec<Type>) -> Type {
    match e {
        Expr::Ident(n) => {
            var k: i64 = decl_names.len() - 1;
            while k >= 0 {
                if decl_names.get(k) == n {
                    return decl_types.get(k);
                }
                k = k - 1;
            }
            return Type::Infer;
        }
        _ => {
        }
    }
    return pd_lit_type(e);
}

/// The literal type pushed onto `name` by statement `st` (searching nested
/// blocks), or Infer.
fn pd_push_lit_type(st: Stmt, name: str, decl_names: Vec<str>, decl_types: Vec<Type>) -> Type {
    match st {
        Stmt::Expr(e, _) => {
            match e {
                Expr::MethodCall(recv, m, args) => {
                    if m == "push" && args.len() == 1 {
                        match box_expr_deref(recv) {
                            Expr::Ident(rn) => {
                                if rn == name {
                                    return pd_arg_type(args.get(0), decl_names, decl_types);
                                }
                            }
                            _ => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
        }
        Stmt::If(_, then_b, else_b, _) => {
            var t1: Type = pd_push_lit_type_block(then_b, name, decl_names, decl_types);
            if !type_eq_infer(t1) {
                return t1;
            }
            match else_b {
                OptStmts::Some(eb) => {
                    return pd_push_lit_type_block(eb, name, decl_names, decl_types);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(_, body, _) => {
            return pd_push_lit_type_block(body, name, decl_names, decl_types);
        }
        Stmt::For(_, _, body, _) => {
            return pd_push_lit_type_block(body, name, decl_names, decl_types);
        }
        Stmt::Loop(body, _) => {
            return pd_push_lit_type_block(body, name, decl_names, decl_types);
        }
        _ => {
        }
    }
    return Type::Infer;
}

fn pd_push_lit_type_block(stmts: Vec<Stmt>, name: str, decl_names: Vec<str>, decl_types: Vec<Type>) -> Type {
    var i: i64 = 0;
    while i < stmts.len() {
        var t: Type = pd_push_lit_type(stmts.get(i), name, decl_names, decl_types);
        if !type_eq_infer(t) {
            return t;
        }
        i = i + 1;
    }
    return Type::Infer;
}

// --- L8A / L8H: impls --------------------------------------------------------

// The impl scratch of a parse (g_pd_last_impl_self, g_pd_impl_selfs,
// g_pd_last_timpl_self, g_pd_timpl_selfs, g_pd_impl_lts) is in Parser
// (pd_*), SP9.

/// L8A: `impl<T, const N: usize> Matrix<T, N>`: each method takes the
/// impl's const parameters as its own (`const_params`), so its body reads N
/// as a constant; mono replaces N by the receiver's number.
fn pd_impl_consts(methods: Vec<Func>, consts: Vec<StrPair>) -> Vec<Func> {
    if consts.len() == 0 {
        return methods;
    }
    var out: Vec<Func> = Vec::new();
    var i: i64 = 0;
    while i < methods.len() {
        var f: Func = methods.get(i);
        var cps: Vec<StrPair> = f.const_params;
        var k: i64 = 0;
        while k < consts.len() {
            var have: bool = false;
            var j: i64 = 0;
            while j < cps.len() {
                if cps.get(j).a == consts.get(k).a {
                    have = true;
                }
                j = j + 1;
            }
            if !have {
                cps.push(consts.get(k));
            }
            k = k + 1;
        }
        f.const_params = cps;
        out.push(f);
        i = i + 1;
    }
    return out;
}

/// Whether the impl `imp` with self type `st` (Void: the bare name) is a
/// generic impl over the whole type: `impl<T> Wrap<T>`.
fn pd_impl_is_general(imp: ImplDef, st: Type) -> bool {
    if imp.type_params.len() == 0 {
        return false;
    }
    match st {
        Type::Void => {
            return true;
        }
        Type::Generic(gn, gargs) => {
            if gn != imp.struct_name || gargs.len() != imp.type_params.len() {
                return false;
            }
            var k: i64 = 0;
            while k < gargs.len() {
                match gargs.get(k) {
                    Type::Named(an) => {
                        if an != imp.type_params.get(k) {
                            return false;
                        }
                    }
                    _ => {
                        return false;
                    }
                }
                k = k + 1;
            }
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// Whether the impl names narrower arguments of its struct than its own
/// parameters: `impl Wrap<i64>`, `impl<U> Wrap<Vec<U>>`.
fn pd_impl_is_narrow(imp: ImplDef, st: Type) -> bool {
    match st {
        Type::Generic(gn, _) => {
            return gn == imp.struct_name && !pd_impl_is_general(imp, st);
        }
        _ => {
        }
    }
    return false;
}

/// `self` (or `self: &Self`, `self: &mut Self`) typed as `st`, also when
/// pd_generic_self typed it as the struct over the impl's own parameters
/// (`impl<U> Wrap<Vec<U>>` made it a `Wrap<U>`).
fn pd_self_as(p: Param, st: Type, imp: ImplDef) -> Param {
    var q: Param = p;
    match p.ty {
        Type::Named(n) => {
            if n == "Self" {
                q.ty = st;
            }
        }
        Type::Generic(_, _) => {
            if pd_impl_is_general(imp, p.ty) {
                q.ty = st;
            }
        }
        Type::Ref(inner, m) => {
            match box_type_unbox(inner) {
                Type::Named(rn) => {
                    if rn == "Self" {
                        q.ty = Type::Ref(Box::new(st), m);
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return q;
}

/// L8H: a method of a narrower impl (`impl Wrap<i64> { fn show(self) }`)
/// that a generic impl of the same struct in the file also has (`impl<T>
/// Wrap<T> { fn show(self) }`) specializes it: it is renamed
/// `show__spec<k>` (ast.fd spec_base_name), so it is no second `show`, its
/// `self` is typed as the narrower impl's type (`Wrap<i64>`), and mono
/// gives each instantiation of `show` the body of the most specific impl's
/// method whose type takes the receiver's (mono.fd mono_method_inst). The
/// narrower impls move after the others, so the generic impl
/// is the one whose parameters name the struct's (TypeChecker
/// impl_tp_lists). Every method of a narrower impl has its `self` typed as
/// the narrower type.
fn pd_impl_specializations(program: &mut Program, selfs: Vec<Type>) {
    val n: i64 = program.impls.len();
    if n == 0 {
        return;
    }
    var any_narrow: bool = false;
    var i: i64 = 0;
    while i < n {
        if i < selfs.len() && pd_impl_is_narrow(program.impls.get(i), selfs.get(i)) {
            any_narrow = true;
        }
        i = i + 1;
    }
    if !any_narrow {
        return;
    }
    var spec_n: i64 = HashMap_new();
    var moved: Vec<bool> = Vec::new();
    var impls: Vec<ImplDef> = Vec::new();
    i = 0;
    while i < n {
        var imp: ImplDef = program.impls.get(i);
        // every narrower impl moves after the others (also one without a
        // specialization: `impl<U> Wrap<Vec<U>>` first in the file must not
        // be taken for the generic impl)
        var is_narrow: bool = false;
        if i < selfs.len() && pd_impl_is_narrow(imp, selfs.get(i)) {
            is_narrow = true;
            val st: Type = selfs.get(i);
            // the generic impl of the struct
            var g: i64 = -1;
            var j: i64 = 0;
            while j < n && g < 0 {
                if j != i && program.impls.get(j).struct_name == imp.struct_name {
                    var gst: Type = Type::Void;
                    if j < selfs.len() {
                        gst = selfs.get(j);
                    }
                    if pd_impl_is_general(program.impls.get(j), gst) {
                        g = j;
                    }
                }
                j = j + 1;
            }
            // every method's `self` is the narrower type (as a generic
            // impl's is `Wrap<T>`, pd_generic_self); one the generic impl
            // also has is a specialization
            var ms: Vec<Func> = Vec::new();
            var mi: i64 = 0;
            while mi < imp.methods.len() {
                var m: Func = imp.methods.get(mi);
                if m.params.len() > 0 && m.params.get(0).name == "self" {
                    var in_general: bool = false;
                    if g >= 0 {
                        val gms: Vec<Func> = program.impls.get(g).methods;
                        var gk: i64 = 0;
                        while gk < gms.len() {
                            if gms.get(gk).name == m.name {
                                in_general = true;
                            }
                            gk = gk + 1;
                        }
                    }
                    if in_general {
                        val key: str = imp.struct_name + "." + m.name;
                        val k: i64 = HashMap_get(spec_n, key) + 1;
                        HashMap_insert(spec_n, key, k);
                        m.name = m.name + "__spec" + int_to_str(k);
                    }
                    var ps: Vec<Param> = m.params;
                    ps.set(0, pd_self_as(ps.get(0), st, imp));
                    m.params = ps;
                }
                ms.push(m);
                mi = mi + 1;
            }
            imp.methods = ms;
        }
        moved.push(is_narrow);
        impls.push(imp);
        i = i + 1;
    }
    HashMap_drop(spec_n);
    var out: Vec<ImplDef> = Vec::new();
    i = 0;
    while i < n {
        if !moved.get(i) {
            out.push(impls.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < n {
        if moved.get(i) {
            out.push(impls.get(i));
        }
        i = i + 1;
    }
    program.impls = out;
}

// --- L8H: trait impls for narrower types; specializations across modules ---

/// Whether `t` is Void (no type written).
fn pd_type_is_void(t: Type) -> bool {
    match t {
        Type::Void => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// The number k of a specialization's name `name__spec<k>` (0: none).
fn pd_spec_number(name: str) -> i64 {
    if spec_base_name(name) == "" {
        return 0;
    }
    val at: i64 = str_rfind(name, "__spec");
    var k: i64 = 0;
    var i: i64 = at + 6;
    while i < str_len(name) {
        k = k * 10 + (str_byte_at(name, i) - 48);
        i = i + 1;
    }
    return k;
}

/// Into map `nums`: for each method `Type.name` of `impls` that is a
/// specialization (`name__spec<k>`), the highest k (the next takes k + 1).
fn pd_note_method_spec_numbers(nums: i64, impls: Vec<ImplDef>) {
    var i: i64 = 0;
    while i < impls.len() {
        val ms: Vec<Func> = impls.get(i).methods;
        var j: i64 = 0;
        while j < ms.len() {
            val k: i64 = pd_spec_number(ms.get(j).name);
            if k > 0 {
                val key: str = impls.get(i).struct_name + "." + spec_base_name(ms.get(j).name);
                if k > HashMap_get(nums, key) {
                    HashMap_insert(nums, key, k);
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

/// `methods` with `self` of each typed as `st` (pd_self_as).
fn pd_selfs_as(methods: Vec<Func>, st: Type, shell: ImplDef) -> Vec<Func> {
    var out: Vec<Func> = Vec::new();
    var i: i64 = 0;
    while i < methods.len() {
        var m: Func = methods.get(i);
        if m.params.len() > 0 && m.params.get(0).name == "self" {
            var ps: Vec<Param> = m.params;
            ps.set(0, pd_self_as(ps.get(0), st, shell));
            m.params = ps;
        }
        out.push(m);
        i = i + 1;
    }
    return out;
}

/// The method names of trait `trait_name` among `traits`, pushed to `out`;
/// false when the trait is not there or inherits methods (`cap Sub:
/// Super`: its impls may also define Super's).
fn pd_trait_methods_of(traits: Vec<TraitDef>, trait_name: str, out: &mut Vec<str>) -> bool {
    var i: i64 = 0;
    while i < traits.len() {
        if traits.get(i).name == trait_name {
            if traits.get(i).supertraits.len() > 0 {
                return false;
            }
            val ms: Vec<TraitMethod> = traits.get(i).methods;
            var j: i64 = 0;
            while j < ms.len() {
                out.push(ms.get(j).name);
                j = j + 1;
            }
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// L8H: the narrower type the methods of an impl of `struct_name` (type
/// parameters `tps`) take `self` as: `Wrap<i64>` for `impl Wrap<i64>` or
/// `impl Show for Wrap<i64>` once their `self` is typed so
/// (pd_impl_specializations, pd_trait_impl_specializations). Void when the
/// impl is over the whole struct or has no method with `self`.
pub fn pd_impl_narrow_self(struct_name: str, tps: Vec<str>, methods: Vec<Func>) -> Type {
    val shell: ImplDef = ImplDef_new_full(struct_name, tps, Vec::new());
    var i: i64 = 0;
    while i < methods.len() {
        val m: Func = methods.get(i);
        if m.params.len() > 0 && m.params.get(0).name == "self" {
            var st: Type = m.params.get(0).ty;
            match st {
                Type::Ref(inner, _) => {
                    st = box_type_unbox(inner);
                }
                _ => {
                }
            }
            match st {
                Type::Generic(gn, _) => {
                    if gn == struct_name && !pd_impl_is_general(shell, st) {
                        return st;
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1;
    }
    return Type::Void;
}

/// L8H: whether `imp` is an impl for a narrower type than its struct's
/// (`impl Wrap<i64>`, `impl<U> Wrap<Vec<U>>`), seen from its methods'
/// `self`. merge_programs keeps a module's generic impl of the struct
/// beside it (it is no replacement of that impl).
pub fn pd_impl_is_narrowed(imp: ImplDef) -> bool {
    return !pd_type_is_void(pd_impl_narrow_self(imp.struct_name, imp.type_params, imp.methods));
}

/// L8H: the narrower trait impl `ti` (`impl Show for Wrap<i64>`, `for` type
/// `st`) of a trait that a generic impl implements for the whole type
/// (`impl<T> Show for Wrap<T>`), as a narrower impl of the struct (`impl
/// Wrap<i64>`) whose methods specialize the generic trait impl's: each
/// renamed `name__spec<k>` (k one more than the last of `Type.name` in map
/// `spec_n`), its `self` typed as `st`. The generic impl stays the trait's
/// impl for every type (bounds, default methods); a call `w.show()` runs
/// the most specific impl's method (mono.fd mono_method_inst, the checker's
/// TypeChecker_check_mspec_call). Errors, to `errs`: associated types (the
/// generic impl binds them for every type), a method without `self` (no
/// receiver to choose by), a method the trait does not have (`trait_ms`,
/// when `check_ms`).
fn pd_timpl_as_spec_impl(ti: TraitImpl, st: Type, spec_n: i64, check_ms: bool, trait_ms: Vec<str>, errs: &mut Vec<str>) -> ImplDef {
    val shell: ImplDef = ImplDef_new_full(ti.type_name, ti.type_params, Vec::new());
    var what: str = "impl ";
    if ti.type_params.len() > 0 {
        what = what + "<" + vec_str_join(ti.type_params, ", ") + "> ";
    }
    what = what + ti.trait_name + " for " + type_to_str(st);
    if ti.associated_types.len() > 0 {
        errs.push("Type error: `" + what + "` binds associated types, so it cannot specialize the generic impl of " + ti.trait_name + " for " + ti.type_name + ".\n    Fix: bind them in the generic impl only.");
    }
    var ms: Vec<Func> = Vec::new();
    var i: i64 = 0;
    while i < ti.methods.len() {
        var m: Func = ti.methods.get(i);
        if m.params.len() == 0 || m.params.get(0).name != "self" {
            errs.push("Type error: method '" + m.name + "' of `" + what + "` has no `self`: a specialization is chosen by the receiver's type.\n    Fix: keep '" + m.name + "' in the generic impl of " + ti.trait_name + " only.");
        } else {
            if check_ms && !str_vec_contains(trait_ms, m.name) {
                errs.push("Type error: method '" + m.name + "' of `" + what + "` is not a method of trait '" + ti.trait_name + "'.\n    Fix: implement only the trait's methods here; put '" + m.name + "' in a plain `impl` block of the type");
            }
            var ps: Vec<Param> = m.params;
            ps.set(0, pd_self_as(ps.get(0), st, shell));
            m.params = ps;
        }
        if spec_base_name(m.name) == "" {
            val key: str = ti.type_name + "." + m.name;
            val k: i64 = HashMap_get(spec_n, key) + 1;
            HashMap_insert(spec_n, key, k);
            m.name = m.name + "__spec" + int_to_str(k);
        }
        ms.push(m);
        i = i + 1;
    }
    return ImplDef_new_full(ti.type_name, ti.type_params, ms);
}

/// L8H: trait impls of one file for a narrower type (`impl Show for
/// Wrap<i64>`, `impl<U> Show for Wrap<Vec<U>>`; `for` types in `selfs`,
/// at each index) beside the generic impl of the trait for the whole type
/// (`impl<T> Show for Wrap<T>`): each becomes a narrower impl of the struct
/// whose methods specialize the generic one's (pd_timpl_as_spec_impl).
/// Before, it was a second impl of the trait for the struct, whose methods
/// replaced the generic impl's for every type. A narrower trait impl with
/// no generic one in the file stays a trait impl, its `self` typed as its
/// type (as in a narrower impl): a module importing a generic impl of the
/// trait for the type turns it into a specialization
/// (pd_cross_module_specializations). The errors found.
fn pd_trait_impl_specializations(program: &mut Program, selfs: Vec<Type>) -> Vec<str> {
    var errs: Vec<str> = Vec::new();
    val n: i64 = program.trait_impls.len();
    var any_narrow: bool = false;
    var i: i64 = 0;
    while i < n && i < selfs.len() {
        val ti0: TraitImpl = program.trait_impls.get(i);
        if pd_impl_is_narrow(ImplDef_new_full(ti0.type_name, ti0.type_params, Vec::new()), selfs.get(i)) {
            any_narrow = true;
        }
        i = i + 1;
    }
    if !any_narrow {
        return errs;
    }
    var spec_n: i64 = HashMap_new();
    pd_note_method_spec_numbers(spec_n, program.impls);
    var keep: Vec<TraitImpl> = Vec::new();
    var added: Vec<ImplDef> = Vec::new();
    i = 0;
    while i < n {
        var ti: TraitImpl = program.trait_impls.get(i);
        var st: Type = Type::Void;
        if i < selfs.len() {
            st = selfs.get(i);
        }
        val shell: ImplDef = ImplDef_new_full(ti.type_name, ti.type_params, Vec::new());
        if pd_impl_is_narrow(shell, st) {
            // the generic impl of the trait for the type, in this file
            var has_general: bool = false;
            var j: i64 = 0;
            while j < n {
                val tj: TraitImpl = program.trait_impls.get(j);
                if j != i && tj.trait_name == ti.trait_name && tj.type_name == ti.type_name {
                    var gst: Type = Type::Void;
                    if j < selfs.len() {
                        gst = selfs.get(j);
                    }
                    if pd_impl_is_general(ImplDef_new_full(tj.type_name, tj.type_params, Vec::new()), gst) {
                        has_general = true;
                    }
                }
                j = j + 1;
            }
            if has_general {
                var trait_ms: Vec<str> = Vec::new();
                val check_ms: bool = pd_trait_methods_of(program.traits, ti.trait_name, &mut trait_ms);
                added.push(pd_timpl_as_spec_impl(ti, st, spec_n, check_ms, trait_ms, &mut errs));
            } else {
                ti.methods = pd_selfs_as(ti.methods, st, shell);
                keep.push(ti);
            }
        } else {
            keep.push(ti);
        }
        i = i + 1;
    }
    HashMap_drop(spec_n);
    program.trait_impls = keep;
    if added.len() > 0 {
        var impls: Vec<ImplDef> = program.impls;
        var a: i64 = 0;
        while a < added.len() {
            impls.push(added.get(a));
            a = a + 1;
        }
        program.impls = impls;
    }
    return errs;
}

/// Whether program `p` imports module `name` (`use a::b` for the module
/// `a::b` or `b`, or an item of it, `use a::b::f`).
fn pd_imports_module(p: Program, name: str) -> bool {
    var i: i64 = 0;
    while i < p.imports.len() {
        val ip: str = p.imports.get(i).path;
        if ip == name || path_last(name) == ip || path_last(ip) == name || str_starts_with(ip, name + "::") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Whether one of the programs `progs` at the indexes `from` has a public
/// generic function of `f`'s name whose parameters take `f`'s, `f` being
/// strictly more specific (ast.fd spec_at_least).
fn pd_cm_spec_of_fn(progs: Vec<Program>, from: Vec<i64>, f: Func) -> bool {
    var i: i64 = 0;
    while i < from.len() {
        val fs: Vec<Func> = progs.get(from.get(i)).funcs;
        var j: i64 = 0;
        while j < fs.len() {
            val g: Func = fs.get(j);
            if g.name == f.name && g.is_pub && g.type_params.len() > 0 && !pd_has_cfg(g) {
                if spec_at_least(f, g) && !spec_at_least(g, f) {
                    return true;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return false;
}

/// Whether one of the programs at `from` has an impl of `struct_name` over
/// the whole struct (`impl<T> Wrap<T>`) with a method `method`.
fn pd_cm_spec_of_method(progs: Vec<Program>, from: Vec<i64>, struct_name: str, method: str) -> bool {
    var i: i64 = 0;
    while i < from.len() {
        val imps: Vec<ImplDef> = progs.get(from.get(i)).impls;
        var j: i64 = 0;
        while j < imps.len() {
            val imp: ImplDef = imps.get(j);
            if imp.struct_name == struct_name && imp.type_params.len() > 0 && !pd_impl_is_narrowed(imp) {
                var k: i64 = 0;
                while k < imp.methods.len() {
                    if imp.methods.get(k).name == method {
                        return true;
                    }
                    k = k + 1;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return false;
}

/// Whether one of the programs at `from` has a generic impl of trait
/// `trait_name` for the whole type `type_name` (`impl<T> Show for Wrap<T>`).
fn pd_cm_spec_of_timpl(progs: Vec<Program>, from: Vec<i64>, trait_name: str, type_name: str) -> bool {
    var i: i64 = 0;
    while i < from.len() {
        val tis: Vec<TraitImpl> = progs.get(from.get(i)).trait_impls;
        var j: i64 = 0;
        while j < tis.len() {
            val ti: TraitImpl = tis.get(j);
            if ti.trait_name == trait_name && ti.type_name == type_name && ti.type_params.len() > 0 {
                if pd_type_is_void(pd_impl_narrow_self(ti.type_name, ti.type_params, ti.methods)) {
                    return true;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return false;
}

/// L8H across modules: a definition in one module specializes a generic
/// definition of a module it imports (`use shapes;` with `fn area(s:
/// Square)` beside shapes' `pub fn area<T>(s: T)`; `impl Wrap<i64> { fn
/// show(self) }` beside `impl<T> Wrap<T> { fn show(self) }`; `impl Show
/// for Wrap<i64>` beside `impl<T> Show for Wrap<T>`) when the generic one
/// takes its types and it is strictly more specific: it is renamed
/// `name__spec<k>` (k after every number of that name in any module), as
/// pd_name_specializations / pd_impl_specializations /
/// pd_trait_impl_specializations do within one file, so it is no duplicate
/// definition (compiler.fd's checks) and no shadowing
/// (cc_qualify_shadowed_imports): mono gives every instantiation the body
/// of the most specific definition, wherever it is called from. A
/// function's generic definition must be `pub`. `mods` are the imported
/// modules (their names in `names`), `user` the program; called by
/// compiler.fd before its duplicate checks. The errors found.
pub fn pd_cross_module_specializations(mods: &mut Vec<Program>, names: Vec<str>, user: &mut Program) -> Vec<str> {
    var errs: Vec<str> = Vec::new();
    val nm: i64 = mods.len();
    if nm == 0 || names.len() < nm {
        return errs;
    }
    // every program: the modules, then the user's (index nm)
    var progs: Vec<Program> = Vec::new();
    var i: i64 = 0;
    while i < nm {
        progs.push(mods.get(i));
        i = i + 1;
    }
    var up: Program = program_new();
    up.funcs = user.funcs;
    up.impls = user.impls;
    up.trait_impls = user.trait_impls;
    up.imports = user.imports;
    up.traits = user.traits;
    progs.push(up);
    val total: i64 = nm + 1;
    // the numbers already taken: `name` -> last k, `Type.name` -> last k
    var fn_n: i64 = HashMap_new();
    var m_n: i64 = HashMap_new();
    var p: i64 = 0;
    while p < total {
        val pfs: Vec<Func> = progs.get(p).funcs;
        var fi: i64 = 0;
        while fi < pfs.len() {
            val sk: i64 = pd_spec_number(pfs.get(fi).name);
            if sk > 0 {
                val base: str = spec_base_name(pfs.get(fi).name);
                if sk > HashMap_get(fn_n, base) {
                    HashMap_insert(fn_n, base, sk);
                }
            }
            fi = fi + 1;
        }
        pd_note_method_spec_numbers(m_n, progs.get(p).impls);
        p = p + 1;
    }
    var changed: Vec<bool> = Vec::new();
    var s: i64 = 0;
    while s < total {
        var sp: Program = progs.get(s);
        var ch: bool = false;
        // the modules this one imports
        var from: Vec<i64> = Vec::new();
        var b: i64 = 0;
        while b < nm {
            if b != s && pd_imports_module(sp, names.get(b)) {
                from.push(b);
            }
            b = b + 1;
        }
        if from.len() > 0 {
            // functions
            var fs: Vec<Func> = Vec::new();
            var fi2: i64 = 0;
            while fi2 < sp.funcs.len() {
                var f: Func = sp.funcs.get(fi2);
                if !pd_has_cfg(f) && spec_base_name(f.name) == "" && pd_cm_spec_of_fn(progs, from, f) {
                    val fk: i64 = HashMap_get(fn_n, f.name) + 1;
                    HashMap_insert(fn_n, f.name, fk);
                    f.name = f.name + "__spec" + int_to_str(fk);
                    ch = true;
                }
                fs.push(f);
                fi2 = fi2 + 1;
            }
            // methods of narrower impls
            var imps: Vec<ImplDef> = Vec::new();
            var ii: i64 = 0;
            while ii < sp.impls.len() {
                var imp: ImplDef = sp.impls.get(ii);
                if pd_impl_is_narrowed(imp) {
                    var ms: Vec<Func> = Vec::new();
                    var mi: i64 = 0;
                    while mi < imp.methods.len() {
                        var m: Func = imp.methods.get(mi);
                        if m.params.len() > 0 && m.params.get(0).name == "self" && spec_base_name(m.name) == "" && pd_cm_spec_of_method(progs, from, imp.struct_name, m.name) {
                            val key: str = imp.struct_name + "." + m.name;
                            val mk: i64 = HashMap_get(m_n, key) + 1;
                            HashMap_insert(m_n, key, mk);
                            m.name = m.name + "__spec" + int_to_str(mk);
                            ch = true;
                        }
                        ms.push(m);
                        mi = mi + 1;
                    }
                    imp.methods = ms;
                }
                imps.push(imp);
                ii = ii + 1;
            }
            // trait impls for a narrower type
            var keep: Vec<TraitImpl> = Vec::new();
            var ti_i: i64 = 0;
            while ti_i < sp.trait_impls.len() {
                val ti: TraitImpl = sp.trait_impls.get(ti_i);
                val st: Type = pd_impl_narrow_self(ti.type_name, ti.type_params, ti.methods);
                if !pd_type_is_void(st) && pd_cm_spec_of_timpl(progs, from, ti.trait_name, ti.type_name) {
                    var trait_ms: Vec<str> = Vec::new();
                    var check_ms: bool = pd_trait_methods_of(sp.traits, ti.trait_name, &mut trait_ms);
                    var tf: i64 = 0;
                    while tf < from.len() && !check_ms {
                        check_ms = pd_trait_methods_of(progs.get(from.get(tf)).traits, ti.trait_name, &mut trait_ms);
                        tf = tf + 1;
                    }
                    imps.push(pd_timpl_as_spec_impl(ti, st, m_n, check_ms, trait_ms, &mut errs));
                    ch = true;
                } else {
                    keep.push(ti);
                }
                ti_i = ti_i + 1;
            }
            if ch {
                sp.funcs = fs;
                sp.impls = imps;
                sp.trait_impls = keep;
                progs.set(s, sp);
            }
        }
        changed.push(ch);
        s = s + 1;
    }
    HashMap_drop(fn_n);
    HashMap_drop(m_n);
    i = 0;
    while i < nm {
        if changed.get(i) {
            mods.set(i, progs.get(i));
        }
        i = i + 1;
    }
    // The user's lists are refilled in place, not replaced: `user` is
    // compiler.fd's match binding of the parse result, and a compiler built
    // by a lowering from before the match-binding fix (lower.fd
    // Lowerer_mb_owns_copy) dropped a replaced list that the parse result
    // still held, then dropped it again with the result (Invalid memory
    // access in vec_drop_range: test_cross_module_specialization).
    if changed.get(nm) {
        pd_refill_funcs(&mut user.funcs, progs.get(nm).funcs);
        pd_refill_impls(&mut user.impls, progs.get(nm).impls);
        pd_refill_timpls(&mut user.trait_impls, progs.get(nm).trait_impls);
    }
    return errs;
}

fn pd_refill_funcs(dst: &mut Vec<Func>, src: Vec<Func>) {
    dst.clear();
    var i: i64 = 0;
    while i < src.len() {
        dst.push(src.get(i));
        i = i + 1;
    }
}

fn pd_refill_impls(dst: &mut Vec<ImplDef>, src: Vec<ImplDef>) {
    dst.clear();
    var i: i64 = 0;
    while i < src.len() {
        dst.push(src.get(i));
        i = i + 1;
    }
}

fn pd_refill_timpls(dst: &mut Vec<TraitImpl>, src: Vec<TraitImpl>) {
    dst.clear();
    var i: i64 = 0;
    while i < src.len() {
        dst.push(src.get(i));
        i = i + 1;
    }
}

/// A bare `self` in `impl<T> Slot<T>` (or `impl<T> Tr for Slot<T>`) is a
/// `Slot<T>`: typed as `Self`, it resolved to the bare struct, whose layout
/// does not know T, and a field after a `T` field read the wrong word.
fn pd_generic_self(methods: Vec<Func>, type_name: str, type_params: Vec<str>) -> Vec<Func> {
    if type_params.len() == 0 {
        return methods;
    }
    var targs: Vec<Type> = Vec::new();
    var k: i64 = 0;
    while k < type_params.len() {
        targs.push(Type::Named(type_params.get(k)));
        k = k + 1;
    }
    var out: Vec<Func> = Vec::new();
    var i: i64 = 0;
    while i < methods.len() {
        var f: Func = methods.get(i);
        if f.params.len() > 0 {
            var p0: Param = f.params.get(0);
            var is_self_ty: bool = false;
            match p0.ty {
                Type::Named(n) => {
                    is_self_ty = n == "Self";
                }
                _ => {
                }
            }
            if p0.name == "self" && is_self_ty {
                p0.ty = Type::Generic(type_name, targs);
                var ps: Vec<Param> = f.params;
                ps.set(0, p0);
                f.params = ps;
            }
        }
        out.push(f);
        i = i + 1;
    }
    return out;
}

// --- Lifetimes (LG3) --------------------------------------------------------
// `fn f<'a>(x: &'a T, y: &T) -> &'a T`: the type of each reference stays
// `Ref`; the names go into `@lifetime(...)` annotations -- on a parameter the
// lifetimes its type writes, on the function those of its result -- and the
// reference escape check (compiler/escape.fd) ties the result to exactly the
// parameters that carry one of the result's lifetimes. `'static` needs no
// declaration and ties the result to no parameter.

/// The lifetimes `seen` gained since index `start`.
fn pd_lt_since(seen: Vec<str>, start: i64) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = start;
    while i < seen.len() {
        out.push(seen.get(i));
        i = i + 1;
    }
    return out;
}

/// The lifetimes a parameter's `@lifetime` annotation lists (none: empty).
fn pd_param_lifetimes(p: Param) -> Vec<str> {
    return ann_lifetimes(p.annotations);
}

/// A signature's lifetimes are declared in its `<...>` and each lifetime of
/// the result is carried by some parameter; the first violation, or None.
fn pd_check_lifetimes(fname: str, declared: Vec<str>, params: Vec<Param>, ret_lts: Vec<str>) -> OptStr {
    var i: i64 = 0;
    while i < params.len() {
        var pl: Vec<str> = pd_param_lifetimes(params.get(i));
        var j: i64 = 0;
        while j < pl.len() {
            var lt: str = pl.get(j);
            if lt != "'static" && !str_vec_contains(declared, lt) {
                return OptStr::Some("lifetime " + lt + " of parameter '" + params.get(i).name + "' is not declared; write `fn " + fname + "<" + lt + ">(...)`");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    var r: i64 = 0;
    while r < ret_lts.len() {
        var rl: str = ret_lts.get(r);
        if rl != "'static" {
            if !str_vec_contains(declared, rl) {
                return OptStr::Some("lifetime " + rl + " of the result of '" + fname + "' is not declared; write `fn " + fname + "<" + rl + ">(...)`");
            }
            var carried: bool = false;
            var k: i64 = 0;
            while k < params.len() && !carried {
                carried = str_vec_contains(pd_param_lifetimes(params.get(k)), rl);
                k = k + 1;
            }
            if !carried {
                return OptStr::Some("the result of '" + fname + "' has lifetime " + rl + ", which no parameter carries: a reference can only be returned from a reference parameter");
            }
        }
        r = r + 1;
    }
    return OptStr::None;
}

/// 0008: the vars declared Vec<E..> (sequential) — the lowerer reads this
/// to route their Vec method calls to VecV_* (lower.fd copies it).
pub fn parser_sequential_vars() -> Vec<str> {
    return g_pd_sequential_vars;
}

// --- SP9: modules parsed ahead, in parallel -----------------------------------
// The import loop (compiler.fd) parses the modules one at a time, each with
// the struct, enum and import names of what it parsed before. With FID_PAR=N
// the modules it lexed ahead are parsed here first, in up to N threads, each
// knowing the names the loop is predicted to know when it gets to that
// module (compiler.fd pp_predict). The loop takes such a parse only when its
// own would be the same (compiler.fd pp_take): a parse asks about no name
// but the words of its text, so every word must be a struct / enum / import
// name for both or for neither, and the turbofish and `__pcall_k` numbers
// must fit (parser_side_fits); the parse's other changes are then applied
// (parser_side_apply). Otherwise the loop parses the module itself.
//
// A worker shares nothing it changes with another thread (owner counts are
// not atomic: escape.fd "Parallel reporting pass"). It copies the names and
// the text it reads (pp_own_str), makes its own maps, and parses a module's
// tokens, which no other thread touches until the last await (the main
// thread does nothing between the first spawn and the last await). It only
// reads the globals below, set before the spawns and reset after. Spawn
// arguments must be @send: a worker gets its number.

/// A module parsed on a worker thread: its Program (ok: the parse
/// succeeded), what it changed besides (ParseSide), and the distinct words
/// of its text with, for each, what it was known as when the parse began
/// (1 a struct, 2 an enum, 4 an import name).
pub struct PreParse {
    pub ok: bool,
    pub prog: Program,
    pub side: ParseSide,
    pub words: Vec<str>,
    pub bits: Vec<i64>,
}

// module k: its tokens and text, and the names it knows: the first
// g_pp_sn_n[k] of g_pp_snames, g_pp_en_n[k] of g_pp_enames, g_pp_in_n[k] of
// g_pp_inames
pub var g_pp_tokens: Vec<Vec<Token>> = Vec::new();
pub var g_pp_texts: Vec<str> = Vec::new();
pub var g_pp_snames: Vec<str> = Vec::new();
pub var g_pp_enames: Vec<str> = Vec::new();
pub var g_pp_inames: Vec<str> = Vec::new();
pub var g_pp_sn_n: Vec<i64> = Vec::new();
pub var g_pp_en_n: Vec<i64> = Vec::new();
pub var g_pp_in_n: Vec<i64> = Vec::new();
// for each worker, the modules it parses, in order
pub var g_pp_plan: Vec<Vec<i64>> = Vec::new();

/// `s` in a buffer of its own: it shares no owner count with `s`.
fn pp_own_str(s: str) -> str {
    return p_str_adopt(p_str_send_copy(s as i64));
}

fn pp_word_byte(c: i64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c >= 128;
}

/// Whether `s` is one word as pp_text_words reads them.
pub fn pp_is_word(s: str) -> bool {
    var n: i64 = str_len(s);
    if n == 0 {
        return false;
    }
    var i: i64 = 0;
    while i < n {
        if !pp_word_byte(str_byte_at(s, i) & 255) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// The distinct words of `src` (runs of letters, digits, `_` and bytes from
/// 128 on: in code, comments and strings alike), first occurrence first.
/// Every name a parse of the text asks about is one of them.
pub fn pp_text_words(src: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var seen: i64 = HashMap_new();
    var n: i64 = str_len(src);
    var start: i64 = -1;
    var i: i64 = 0;
    while i <= n {
        var inw: bool = false;
        if i < n {
            inw = pp_word_byte(str_byte_at(src, i) & 255);
        }
        if inw {
            if start < 0 {
                start = i;
            }
        } else if start >= 0 {
            var w: str = str_slice(src, start, i);
            if !HashMap_contains(seen, w) {
                HashMap_insert(seen, w, 1);
                out.push(w);
            }
            start = -1;
        }
        i = i + 1;
    }
    HashMap_drop(seen);
    return out;
}

/// What `w` is to the parser `p` (before its parse): 1 a struct name, 2 an
/// enum name, 4 an import name (or'ed).
pub fn pp_bits_of(p: Parser, w: str) -> i64 {
    var b: i64 = 0;
    if HashMap_get(p.struct_name_set, w) != 0 {
        b = b | 1;
    }
    if HashMap_get(p.enum_name_set, w) != 0 {
        b = b | 2;
    }
    if p.pd_import_known(w) {
        b = b | 4;
    }
    return b;
}

/// The first `n` of `names` (strings of this thread already).
fn pp_prefix(names: Vec<str>, n: i64) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < n && i < names.len() {
        out.push(names.get(i));
        i = i + 1;
    }
    return out;
}

/// Parse module `k` of the g_pp_* tables, knowing these names.
pub fn pp_parse_one(k: i64, sn: Vec<str>, en: Vec<str>, inames: Vec<str>) -> PreParse {
    var p: Parser = Parser_side(g_pp_tokens.get(k), sn, en, inames);
    var words: Vec<str> = pp_text_words(pp_own_str(g_pp_texts.get(k)));
    var bits: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < words.len() {
        bits.push(pp_bits_of(p, words.get(i)));
        i = i + 1;
    }
    var ok: bool = false;
    var prog: Program = program_new();
    match p.parse() {
        ParseResultProgram::Ok(pr) => {
            ok = true;
            prog = pr;
        }
        ParseResultProgram::Err(_) => {
        }
    }
    var side: ParseSide = parser_side_of(p);
    parser_side_free(&mut p);
    return PreParse {
        ok: ok, prog: prog, side: side, words: words, bits: bits
    };
}

/// A worker of pp_parse_par: the modules of its plan, in the plan's order.
pub fn pp_parse_worker(w: i64) -> Vec<PreParse> {
    var out: Vec<PreParse> = Vec::new();
    var mine: Vec<i64> = Vec::new();
    var ms: i64 = 0;
    var me: i64 = 0;
    var mi: i64 = 0;
    var j: i64 = 0;
    while j < g_pp_plan.get(w).len() {
        var k: i64 = g_pp_plan.get(w).get(j);
        mine.push(k);
        if g_pp_sn_n.get(k) > ms {
            ms = g_pp_sn_n.get(k);
        }
        if g_pp_en_n.get(k) > me {
            me = g_pp_en_n.get(k);
        }
        if g_pp_in_n.get(k) > mi {
            mi = g_pp_in_n.get(k);
        }
        j = j + 1;
    }
    // the names any of its modules knows, copied once (strings of its own:
    // the shared lists are only read, an element at a time)
    var sn: Vec<str> = Vec::new();
    var en: Vec<str> = Vec::new();
    var inames: Vec<str> = Vec::new();
    var c: i64 = 0;
    while c < ms && c < g_pp_snames.len() {
        sn.push(pp_own_str(g_pp_snames.get(c)));
        c = c + 1;
    }
    c = 0;
    while c < me && c < g_pp_enames.len() {
        en.push(pp_own_str(g_pp_enames.get(c)));
        c = c + 1;
    }
    c = 0;
    while c < mi && c < g_pp_inames.len() {
        inames.push(pp_own_str(g_pp_inames.get(c)));
        c = c + 1;
    }
    j = 0;
    while j < mine.len() {
        var k2: i64 = mine.get(j);
        out.push(pp_parse_one(k2, pp_prefix(sn, g_pp_sn_n.get(k2)), pp_prefix(en, g_pp_en_n.get(k2)), pp_prefix(inames, g_pp_in_n.get(k2))));
        j = j + 1;
    }
    return out;
}

/// Each module of the tables parsed (in module order), in up to `nw`
/// threads: `toks[k]` the tokens of module k, `texts[k]` its text, and it
/// knows the first `sn_n[k]` of `snames` as struct names, `en_n[k]` of
/// `enames` as enum names and `in_n[k]` of `inames` as import names. With
/// one worker, parsed here one after another (as on a worker: nothing but
/// the results changes either way).
pub fn pp_parse_par(toks: Vec<Vec<Token>>, texts: Vec<str>, snames: Vec<str>, enames: Vec<str>, inames: Vec<str>, sn_n: Vec<i64>, en_n: Vec<i64>, in_n: Vec<i64>, nw: i64) -> Vec<PreParse> {
    var out: Vec<PreParse> = Vec::new();
    var n: i64 = toks.len();
    if n == 0 {
        return out;
    }
    g_pp_tokens = toks;
    g_pp_texts = texts;
    g_pp_snames = snames;
    g_pp_enames = enames;
    g_pp_inames = inames;
    g_pp_sn_n = sn_n;
    g_pp_en_n = en_n;
    g_pp_in_n = in_n;
    var sizes: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        sizes.push(toks.get(i).len());
        i = i + 1;
    }
    var nb: i64 = nw;
    if nb < 1 {
        nb = 1;
    }
    var plan: Vec<Vec<i64>> = lex_par_plan(sizes, nb);
    // where each module's result is: its worker, and its place in that list
    var res_w: Vec<i64> = Vec::new();
    var res_k: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        res_w.push(0);
        res_k.push(0);
        i = i + 1;
    }
    var w: i64 = 0;
    while w < plan.len() {
        var k: i64 = 0;
        while k < plan.get(w).len() {
            var t: i64 = plan.get(w).get(k);
            res_w.set(t, w);
            res_k.set(t, k);
            k = k + 1;
        }
        w = w + 1;
    }
    g_pp_plan = plan;
    var got: Vec<Vec<PreParse>> = Vec::new();
    if plan.len() < 2 {
        got.push(pp_parse_worker(0));
    } else {
        var futs: Vec<Future<Vec<PreParse>> > = Vec::new();
        w = 0;
        while w < plan.len() {
            futs.push(spawn pp_parse_worker(w));
            w = w + 1;
        }
        w = 0;
        while w < futs.len() {
            var part: Vec<PreParse> = await futs.get(w);
            got.push(part);
            w = w + 1;
        }
    }
    g_pp_plan = Vec::new();
    g_pp_tokens = Vec::new();
    g_pp_texts = Vec::new();
    g_pp_snames = Vec::new();
    g_pp_enames = Vec::new();
    g_pp_inames = Vec::new();
    g_pp_sn_n = Vec::new();
    g_pp_en_n = Vec::new();
    g_pp_in_n = Vec::new();
    i = 0;
    while i < n {
        out.push(got.get(res_w.get(i)).get(res_k.get(i)));
        i = i + 1;
    }
    return out;
}

// --- SP9: which parse ahead the import loop takes ------------------------------
// pp_predict guesses, from what the tokens say (lexer.fd ModScan), the names
// the import loop (compiler.fd) knows when it first parses each module; the
// modules are parsed ahead with those (pp_parse_par). pp_begin hands the
// results to the loop; for each module it parses, pp_valid says whether the
// parse ahead is the one its own parse would give, with the names it has
// then, and pp_use takes it (its other changes made as that parse would
// have made them). A wrong guess costs time, never output.

/// The names pp_predict expects the import loop to know: module i (an
/// index of the ModGraph) the first sn_n[i] of snames, en_n[i] of enames
/// and in_n[i] of inames (-1: a module whose file an earlier index has).
pub struct PpPlan {
    pub snames: Vec<str>,
    pub enames: Vec<str>,
    pub inames: Vec<str>,
    pub sn_n: Vec<i64>,
    pub en_n: Vec<i64>,
    pub in_n: Vec<i64>,
}

/// Each of `names` not in `set` yet, added to it and to `list`.
fn pp_add_new(list: &mut Vec<str>, set: i64, names: Vec<str>) {
    var i: i64 = 0;
    while i < names.len() {
        var nm: str = names.get(i);
        if HashMap_get(set, nm) == 0 {
            HashMap_insert(set, nm, 1);
            list.push(nm);
        }
        i = i + 1;
    }
}

/// compiler.fd's import loop run on what the tokens say instead of on
/// parses, from the program's imports `user_imports` (paths, in order) and
/// the names known before it (`struct_names`, `enum_names`, the import
/// set): the names it knows when it first parses each module of `g`
/// (cached_parse keeps that first parse, deferred or not). Keep in step
/// with the loop.
pub fn pp_predict(user_imports: Vec<str>, g: ModGraph, struct_names: Vec<str>, enum_names: Vec<str>) -> PpPlan {
    var n: i64 = g.names.len();
    var pl: PpPlan = PpPlan {
        snames: Vec::new(), enames: Vec::new(), inames: Vec::new(), sn_n: Vec::new(), en_n: Vec::new(), in_n: Vec::new()
    };
    var sset: i64 = HashMap_new();
    var eset: i64 = HashMap_new();
    var iset: i64 = HashMap_new();
    pp_add_new(&mut pl.snames, sset, struct_names);
    pp_add_new(&mut pl.enames, eset, enum_names);
    pp_add_new(&mut pl.inames, iset, parser_import_names());
    var name_ix: i64 = HashMap_new();
    var file_ix: i64 = HashMap_new();
    var i: i64 = 0;
    while i < n {
        pl.sn_n.push(-1);
        pl.en_n.push(-1);
        pl.in_n.push(-1);
        if HashMap_get(name_ix, g.names.get(i)) == 0 {
            HashMap_insert(name_ix, g.names.get(i), i + 1);
        }
        var f0: str = g.files.get(i);
        if str_len(f0) > 0 && HashMap_get(file_ix, f0) == 0 {
            HashMap_insert(file_ix, f0, i + 1);
        }
        i = i + 1;
    }
    var stack: Vec<str> = Vec::new();
    var ui: i64 = user_imports.len() - 1;
    while ui >= 0 {
        stack.push(user_imports.get(ui));
        ui = ui - 1;
    }
    var deferred: Vec<str> = Vec::new();
    var loaded: i64 = HashMap_new();
    var parsed: i64 = HashMap_new();
    var steps: i64 = 0;
    while stack.len() > 0 && steps < 1000000 {
        steps = steps + 1;
        var ip: str = stack.get(stack.len() - 1);
        stack.pop();
        if ip == "core" || HashMap_get(loaded, ip) != 0 {
            continue;
        }
        var gi: i64 = HashMap_get(name_ix, ip) - 1;
        if gi < 0 {
            // a module lexing ahead did not find: no guess past it
            break;
        }
        var f: str = g.files.get(gi);
        if str_len(f) == 0 {
            // a C header (or no file): what its parse adds is not guessed
            HashMap_insert(loaded, ip, 1);
            continue;
        }
        var oi: i64 = HashMap_get(file_ix, f) - 1;
        var sc: ModScan = g.scans.get(oi);
        if HashMap_get(parsed, f) == 0 {
            HashMap_insert(parsed, f, 1);
            pl.sn_n.set(oi, pl.snames.len());
            pl.en_n.set(oi, pl.enames.len());
            pl.in_n.set(oi, pl.inames.len());
            // its `use`s go into the import set as it is parsed
            pp_add_new(&mut pl.inames, iset, sc.import_names);
        }
        pp_add_new(&mut pl.snames, sset, sc.structs);
        pp_add_new(&mut pl.enames, eset, sc.enums);
        var unloaded: Vec<str> = Vec::new();
        var di: i64 = 0;
        while di < sc.uses_all.len() {
            var dep: str = sc.uses_all.get(di);
            if dep != "core" && HashMap_get(loaded, dep) == 0 {
                unloaded.push(dep);
            }
            di = di + 1;
        }
        if unloaded.len() > 0 {
            if str_vec_has(deferred, ip) {
                continue;
            }
            deferred.push(ip);
            stack.push(ip);
            di = 0;
            while di < unloaded.len() {
                if HashMap_get(loaded, unloaded.get(di)) == 0 {
                    stack.push(unloaded.get(di));
                }
                di = di + 1;
            }
            continue;
        }
        var mn: str = ip;
        if str_len(sc.module) > 0 {
            mn = sc.module;
        }
        HashMap_insert(loaded, ip, 1);
        HashMap_insert(loaded, mn, 1);
        var dx: i64 = 0;
        while dx < deferred.len() {
            if deferred.get(dx) == ip {
                deferred.remove(dx);
                break;
            }
            dx = dx + 1;
        }
        var ti: i64 = 0;
        while ti < sc.uses_all.len() {
            if HashMap_get(loaded, sc.uses_all.get(ti)) == 0 {
                stack.push(sc.uses_all.get(ti));
            }
            ti = ti + 1;
        }
    }
    // a module the guess did not reach: all it knows by then
    i = 0;
    while i < n {
        var f1: str = g.files.get(i);
        if str_len(f1) > 0 && HashMap_get(file_ix, f1) == i + 1 && pl.sn_n.get(i) < 0 {
            pl.sn_n.set(i, pl.snames.len());
            pl.en_n.set(i, pl.enames.len());
            pl.in_n.set(i, pl.inames.len());
        }
        i = i + 1;
    }
    HashMap_drop(sset);
    HashMap_drop(eset);
    HashMap_drop(iset);
    HashMap_drop(name_ix);
    HashMap_drop(file_ix);
    HashMap_drop(loaded);
    HashMap_drop(parsed);
    return pl;
}

// the parses ahead the loop may take: g_ppt_results[k] of file
// g_ppt_files[k] (g_ppt_index: file -> 1 + k), each asked about once
var g_ppt_results: Vec<PreParse> = Vec::new();
var g_ppt_index: i64 = 0;
var g_ppt_used: Vec<bool> = Vec::new();
// the loop's struct and enum names as maps: the first g_ppt_sn_n of its
// struct names, g_ppt_en_n of its enum names (they only grow); the first
// g_ppt_in_n of the import set's names looked at
var g_ppt_sn: i64 = 0;
var g_ppt_en: i64 = 0;
var g_ppt_sn_n: i64 = 0;
var g_ppt_en_n: i64 = 0;
var g_ppt_in_n: i64 = 0;
// how many names each list had when the parse ahead began (every parse
// ahead knew those)
var g_ppt_base_sn: i64 = 0;
var g_ppt_base_en: i64 = 0;
var g_ppt_base_in: i64 = 0;
// a name of more than one word came in after that (a parse may ask about
// one that is not a word of its text): no parse ahead is taken any more
var g_ppt_odd: bool = false;
var g_ppt_hits: i64 = 0;
var g_ppt_misses: i64 = 0;

/// Hand the loop the parses ahead: `results[k]` that of `files[k]`, begun
/// with `base_sn` struct names and `base_en` enum names known (the loop's
/// first ones) and the import set as it is now.
pub fn pp_begin(results: Vec<PreParse>, files: Vec<str>, base_sn: i64, base_en: i64) {
    pp_end();
    g_ppt_results = results;
    g_ppt_index = HashMap_new();
    g_ppt_used = Vec::new();
    var i: i64 = 0;
    while i < files.len() {
        if HashMap_get(g_ppt_index, files.get(i)) == 0 {
            HashMap_insert(g_ppt_index, files.get(i), i + 1);
        }
        g_ppt_used.push(false);
        i = i + 1;
    }
    g_ppt_sn = HashMap_new();
    g_ppt_en = HashMap_new();
    g_ppt_sn_n = 0;
    g_ppt_en_n = 0;
    g_ppt_in_n = 0;
    g_ppt_base_sn = base_sn;
    g_ppt_base_en = base_en;
    g_ppt_base_in = g_import_list.len();
    g_ppt_odd = false;
    g_ppt_hits = 0;
    g_ppt_misses = 0;
}

/// No parse ahead to take any more; the tables freed.
pub fn pp_end() {
    g_ppt_results = Vec::new();
    g_ppt_used = Vec::new();
    if g_ppt_index != 0 {
        HashMap_drop(g_ppt_index);
        g_ppt_index = 0;
    }
    if g_ppt_sn != 0 {
        HashMap_drop(g_ppt_sn);
        g_ppt_sn = 0;
    }
    if g_ppt_en != 0 {
        HashMap_drop(g_ppt_en);
        g_ppt_en = 0;
    }
}

/// How many parses ahead there are (0: none to take).
pub fn pp_count() -> i64 {
    return g_ppt_results.len();
}

/// How many the loop took, and how many it parsed itself.
pub fn pp_hits() -> i64 {
    return g_ppt_hits;
}

pub fn pp_misses() -> i64 {
    return g_ppt_misses;
}

/// Parse ahead `k` (for FID_PP_VERIFY).
pub fn pp_result(k: i64) -> PreParse {
    return g_ppt_results.get(k);
}

/// Bring the maps of the loop's names up to `struct_names` / `enum_names`
/// and the import set; a name of more than one word that came in after the
/// parse ahead began sets g_ppt_odd.
fn pp_act_update(struct_names: Vec<str>, enum_names: Vec<str>) {
    while g_ppt_sn_n < struct_names.len() {
        var sn: str = struct_names.get(g_ppt_sn_n);
        HashMap_insert(g_ppt_sn, sn, 1);
        if g_ppt_sn_n >= g_ppt_base_sn && !pp_is_word(sn) {
            g_ppt_odd = true;
        }
        g_ppt_sn_n = g_ppt_sn_n + 1;
    }
    while g_ppt_en_n < enum_names.len() {
        var en: str = enum_names.get(g_ppt_en_n);
        HashMap_insert(g_ppt_en, en, 1);
        if g_ppt_en_n >= g_ppt_base_en && !pp_is_word(en) {
            g_ppt_odd = true;
        }
        g_ppt_en_n = g_ppt_en_n + 1;
    }
    while g_ppt_in_n < g_import_list.len() {
        if g_ppt_in_n >= g_ppt_base_in && !pp_is_word(g_import_list.get(g_ppt_in_n)) {
            g_ppt_odd = true;
        }
        g_ppt_in_n = g_ppt_in_n + 1;
    }
}

/// The index of the parse ahead of `path` the loop may take in place of
/// parsing it with these names (Parser_with_names(tokens, struct_names,
/// enum_names) and the import set as it is now): -1 when there is none or
/// the loop's parse could differ. Asked once per module (the loop keeps
/// its first parse).
pub fn pp_valid(path: str, struct_names: Vec<str>, enum_names: Vec<str>) -> i64 {
    if g_ppt_results.len() == 0 {
        return -1;
    }
    var k: i64 = HashMap_get(g_ppt_index, path) - 1;
    if k < 0 || g_ppt_used.get(k) {
        return -1;
    }
    g_ppt_used.set(k, true);
    if !g_ppt_results.get(k).ok {
        g_ppt_misses = g_ppt_misses + 1;
        return -1;
    }
    pp_act_update(struct_names, enum_names);
    if g_ppt_odd {
        g_ppt_misses = g_ppt_misses + 1;
        return -1;
    }
    var words: Vec<str> = g_ppt_results.get(k).words;
    var bits: Vec<i64> = g_ppt_results.get(k).bits;
    var i: i64 = 0;
    while i < words.len() {
        var w: str = words.get(i);
        var b: i64 = 0;
        if HashMap_get(g_ppt_sn, w) != 0 {
            b = b | 1;
        }
        if HashMap_get(g_ppt_en, w) != 0 {
            b = b | 2;
        }
        if HashMap_get(g_import_set, w) != 0 {
            b = b | 4;
        }
        if b != bits.get(i) {
            g_ppt_misses = g_ppt_misses + 1;
            return -1;
        }
        i = i + 1;
    }
    if !parser_side_fits(g_ppt_results.get(k).side) {
        g_ppt_misses = g_ppt_misses + 1;
        return -1;
    }
    return k;
}

/// Take parse ahead `k` (pp_valid said so): its other changes made as the
/// loop's parse would have made them, and its Program.
pub fn pp_use(k: i64) -> Program {
    parser_side_apply(g_ppt_results.get(k).side);
    g_ppt_hits = g_ppt_hits + 1;
    return g_ppt_results.get(k).prog;
}
