// parser.fd -- Fides parser, SH-7.3 rewrite of src/parser.rs (3433 LOC Rust)
//
// Recursive-descent parser that transforms a Vec<Token> token stream into an
// AST (Program). Handles: all expressions, statements, types, declarations,
// attributes, annotations, f-strings, inline asm, ML/game-architecture decls.
//
// Error handling: Fides has no `?` operator, so we use a custom ParseResult
// enum (like json.fd's JsonResult) and explicit pattern matching to propagate
// errors. Each parse_* function returns ParseResult.
//
// Adaptations from Rust:
// 1. `Result<T, String>` -> `ParseResult<T>` (custom enum, no `?` operator).
// 2. `std::mem::discriminant` -> `token_kind_eq` (from compiler::token).
// 3. `format!` -> string concatenation with `+` and int_to_str/float_to_str.
// 4. `Option<T>` -> Opt* enums from compiler::ast, or `-1`/`""` sentinels.
// 5. Macros (reduce_one!, peek_bin_op!) -> helper functions.
// 6. `peek()` returns `&TokenKind` in Rust; here we return a copy (TokenKind
//    is an enum, copied by value in Fides).
//
// Dependencies: compiler::token, compiler::ast, compiler::lexer (for f-strings)

module compiler::parser;

use vec;
use core;
use compiler::token;
use compiler::ast;
use compiler::lexer;

// --- ParseResult ---------------------------------------------------------
// Custom Result enum for parse functions. Fides has no `?` operator, so
// callers must pattern-match to extract the value or propagate the error.
// Usage:
//   match self.parse_expr() {
//       ParseResultExpr::Ok(e) => { ... use e ... }
//       ParseResultExpr::Err(msg) => { return ParseResultExpr::Err(msg); }
//   }

pub enum ParseResultExpr {
Ok(Expr),
Err(str),
}

pub enum ParseResultExprs {
Ok(Vec<Expr>),
Err(str),
}

pub enum ParseResultStmt {
Ok(Stmt),
Err(str),
}

pub enum ParseResultStmts {
Ok(Vec<Stmt>),
Err(str),
}

pub enum ParseResultType {
Ok(Type),
Err(str),
}

pub enum ParseResultPattern {
Ok(Pattern),
Err(str),
}

pub enum ParseResultStr {
Ok(str),
Err(str),
}

pub enum ParseResultFunc {
Ok(Func),
Err(str),
}

pub enum ParseResultStructDef {
Ok(StructDef),
Err(str),
}

pub enum ParseResultEnumDef {
Ok(EnumDef),
Err(str),
}

pub enum ParseResultConstDef {
Ok(ConstDef),
Err(str),
}

pub enum ParseResultGlobalVar {
Ok(GlobalVar),
Err(str),
}

pub enum ParseResultTypeAlias {
Ok(TypeAlias),
Err(str),
}

pub enum ParseResultTraitDef {
Ok(TraitDef),
Err(str),
}

pub enum ParseResultImportDef {
Ok(ImportDef),
Err(str),
}

pub enum ParseResultAttribute {
Ok(Attribute),
Err(str),
}

pub enum ParseResultAnnotation {
Ok(Annotation),
Err(str),
}

pub enum ParseResultParams {
Ok(Vec<Param>),
Err(str),
}

pub enum ParseResultLayerDef {
Ok(LayerDef),
Err(str),
}

pub enum ParseResultModelDef {
Ok(ModelDef),
Err(str),
}

pub enum ParseResultComponentDef {
Ok(ComponentDef),
Err(str),
}

pub enum ParseResultSystemDef {
Ok(SystemDef),
Err(str),
}

pub enum ParseResultStateMachineDef {
Ok(StateMachineDef),
Err(str),
}

pub enum ParseResultEventHandlerDef {
Ok(EventHandlerDef),
Err(str),
}

pub enum ParseResultExternDecl {
Ok(ExternDecl),
Err(str),
}

pub enum ParseResultMatchArms {
Ok(Vec<MatchArm>),
Err(str),
}

pub enum ParseResultProgram {
Ok(Program),
Err(str),
}

pub enum ParseResultUnit {
Ok,
Err(str),
}

// --- ImplOrTrait helper --------------------------------------------------
// Rust uses an internal enum to distinguish impl blocks. We use a tag.
pub struct ImplOrTrait {
pub tag: i64,           // 0 = StructImpl, 1 = TraitImpl
pub struct_impl: ImplDef,
pub trait_impl: TraitImpl,
}

pub enum ParseResultImplOrTrait {
Ok(ImplOrTrait),
Err(str),
}

// --- IfExpr helper -------------------------------------------------------
pub struct IfExpr {
pub cond: Expr,
pub then_block: Vec<Stmt>,
pub else_block: OptStmts,
}

// --- OpEntry for iterative parser ----------------------------------------
pub enum OpEntry {
Op(BinOp, i64),
Paren,
}

// --- Parser --------------------------------------------------------------

pub struct Parser {
pub tokens: Vec<Token>,
pub pos: i64,
pub struct_names: Vec<str>,
pub enum_names: Vec<str>,
pub struct_name_set: i64,  // HashMap for O(1) lookup
pub enum_name_set: i64,    // HashMap for O(1) lookup
pub alias_to_struct: Vec<str>,
pub errors: Vec<str>,
pub expr_depth: i64,
pub max_expr_depth: i64,
}

pub fn Parser_new(tokens: Vec<Token>) -> Parser {
    var sn: Vec<str> = Vec::new();
    // AST structs
    sn.push("Annotation"); sn.push("AsmOperand"); sn.push("AssocTypeBinding");
    sn.push("AssocTypeDecl"); sn.push("Attribute"); sn.push("Binding");
    sn.push("ComponentDef"); sn.push("ConstDef"); sn.push("EffectHandler");
    sn.push("EnumDef"); sn.push("EnumVariant"); sn.push("EventHandlerDef");
    sn.push("ExternDecl"); sn.push("FieldInit"); sn.push("Func");
    sn.push("ImplDef"); sn.push("ImportDef"); sn.push("LayerDef");
    sn.push("LayerInst"); sn.push("MatchArm"); sn.push("ModelDef");
    sn.push("Param"); sn.push("Program"); sn.push("SelectCase");
    sn.push("StateDef"); sn.push("StateMachineDef"); sn.push("StateTransition");
    sn.push("StrPair"); sn.push("StructDef"); sn.push("SystemDef");
    sn.push("TraitDef"); sn.push("TraitImpl"); sn.push("TraitMethod");
    sn.push("TypeAlias");
    // Token struct
    sn.push("Token");
    // Lexer struct
    sn.push("Lexer");
    // Parser struct (self-reference for struct literals)
    sn.push("Parser");

    var en: Vec<str> = Vec::new();
    en.push("AsmDir"); en.push("AssignOp"); en.push("BinOp");
    en.push("Expr"); en.push("FStringPart"); en.push("OptBoxExpr");
    en.push("OptFunc"); en.push("OptI"); en.push("OptParams");
    en.push("OptStmts"); en.push("OptStr"); en.push("OptType");
    en.push("Pattern"); en.push("ReflectOp"); en.push("ShapeDim");
    en.push("Stmt"); en.push("Type"); en.push("UnaryOp");
    // TokenKind enum
    en.push("TokenKind");

    // Build HashMaps for O(1) name lookup (string interning)
    var sn_set: i64 = HashMap_new();
    var si: i64 = 0;
    while si < sn.len() {
        HashMap_insert(sn_set, sn.get(si), 1);
        si = si + 1;
    }
    var en_set: i64 = HashMap_new();
    var ei: i64 = 0;
    while ei < en.len() {
        HashMap_insert(en_set, en.get(ei), 1);
        ei = ei + 1;
    }

    return Parser {
        tokens: tokens,
        pos: 0,
        struct_names: sn,
        enum_names: en,
        struct_name_set: sn_set,
        enum_name_set: en_set,
        alias_to_struct: Vec::new(),
        errors: Vec::new(),
        expr_depth: 0,
        max_expr_depth: 256,
    };
}

impl Parser {
    pub fn new(tokens: Vec<Token>) -> Parser {
        var sn: Vec<str> = Vec::new();
        sn.push("Annotation"); sn.push("AsmOperand"); sn.push("AssocTypeBinding");
        sn.push("AssocTypeDecl"); sn.push("Attribute"); sn.push("Binding");
        sn.push("ComponentDef"); sn.push("ConstDef"); sn.push("EffectHandler");
        sn.push("EnumDef"); sn.push("EnumVariant"); sn.push("EventHandlerDef");
        sn.push("ExternDecl"); sn.push("FieldInit"); sn.push("Func");
        sn.push("ImplDef"); sn.push("ImportDef"); sn.push("LayerDef");
        sn.push("LayerInst"); sn.push("MatchArm"); sn.push("ModelDef");
        sn.push("Param"); sn.push("Program"); sn.push("SelectCase");
        sn.push("StateDef"); sn.push("StateMachineDef"); sn.push("StateTransition");
        sn.push("StrPair"); sn.push("StructDef"); sn.push("SystemDef");
        sn.push("TraitDef"); sn.push("TraitImpl"); sn.push("TraitMethod");
        sn.push("TypeAlias");
        sn.push("Token");
        sn.push("Lexer");
        sn.push("Parser");
        var en: Vec<str> = Vec::new();
        en.push("AsmDir"); en.push("AssignOp"); en.push("BinOp");
        en.push("Expr"); en.push("FStringPart"); en.push("OptBoxExpr");
        en.push("OptFunc"); en.push("OptI"); en.push("OptParams");
        en.push("OptStmts"); en.push("OptStr"); en.push("OptType");
        en.push("Pattern"); en.push("ReflectOp"); en.push("ShapeDim");
        en.push("Stmt"); en.push("Type"); en.push("UnaryOp");
        en.push("TokenKind");
        var sn_set: i64 = HashMap_new();
        var si: i64 = 0;
        while si < sn.len() {
            HashMap_insert(sn_set, sn.get(si), 1);
            si = si + 1;
        }
        var en_set: i64 = HashMap_new();
        var ei: i64 = 0;
        while ei < en.len() {
            HashMap_insert(en_set, en.get(ei), 1);
            ei = ei + 1;
        }
        return Parser {
            tokens: tokens,
            pos: 0,
            struct_names: sn,
            enum_names: en,
            struct_name_set: sn_set,
            enum_name_set: en_set,
            alias_to_struct: Vec::new(),
            errors: Vec::new(),
            expr_depth: 0,
            max_expr_depth: 256,
        };
    }
fn peek(self: &Parser) -> TokenKind {
    return self.tokens.get(self.pos).kind;
}

fn peek_token(self: &Parser) -> Token {
    return self.tokens.get(self.pos);
}

fn advance(self: &mut Parser) -> Token {
    var tok: Token = self.tokens.get(self.pos);
    if !token_kind_eq(tok.kind, TokenKind::Eof) {
        self.pos = self.pos + 1;
    }
    return tok;
}

fn is_at_end(self: &Parser) -> bool {
    return token_kind_eq(self.peek(), TokenKind::Eof);
}

fn check(self: &Parser, kind: TokenKind) -> bool {
    return token_kind_eq(self.peek(), kind);
}

fn match_tok(self: &mut Parser, kind: TokenKind) -> bool {
    if self.check(kind) {
        self.advance();
        return true;
    }
    return false;
}

fn recover_to_sync_token(self: &mut Parser) {
    while !self.is_at_end() {
        var k: TokenKind = self.peek();
        if token_kind_eq(k, TokenKind::Semicolon) {
            self.advance();
            return;
        }
        if token_kind_eq(k, TokenKind::RBrace) { return; }
        if token_kind_eq(k, TokenKind::Fn) { return; }
        if token_kind_eq(k, TokenKind::Pub) { return; }
        if token_kind_eq(k, TokenKind::Struct) { return; }
        if token_kind_eq(k, TokenKind::Enum) { return; }
        if token_kind_eq(k, TokenKind::Impl) { return; }
        if token_kind_eq(k, TokenKind::Use) { return; }
        self.advance();
    }

}
// R1.5: split a compound token starting with `>` so a generic list can close
// on its first char: `>>` -> `>`, `>>=` -> `>=`, `>=` -> `=`. Returns false if
// the current token does not start with `>`.
fn split_gt(self: &mut Parser) -> bool {
    var tok: Token = self.peek_token();
    var rest: TokenKind = TokenKind::Eof;
    if token_kind_eq(tok.kind, TokenKind::Shr) { rest = TokenKind::Gt; }
    else if token_kind_eq(tok.kind, TokenKind::ShrEq) { rest = TokenKind::GtEq; }
    else if token_kind_eq(tok.kind, TokenKind::GtEq) { rest = TokenKind::Eq; }
    else { return false; }
    self.tokens.set(self.pos, token_new(rest, tok.line, tok.col + 1));
    return true;
}

fn expect(self: &mut Parser, kind: TokenKind, msg: str) -> ParseResultUnit {
    if self.check(kind) {
        self.advance();
        return ParseResultUnit::Ok;
    }
    if token_kind_eq(kind, TokenKind::Gt) {
        if self.split_gt() {
            return ParseResultUnit::Ok;
        }
    }
    var tok: Token = self.peek_token();
    return ParseResultUnit::Err(
        "Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) +
        ": expected " + msg + " but got '" + token_kind_to_str(tok.kind) + "'"
    );
}

fn expect_ident(self: &mut Parser) -> ParseResultStr {
    var tok: Token = self.peek_token();
    match tok.kind {
        TokenKind::Ident(s: str) => {
            self.advance();
            return ParseResultStr::Ok(s);
        }
    }
    return ParseResultStr::Err(
        "Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) +
        ": expected identifier but got '" + token_kind_to_str(tok.kind) + "'"
    );
}

fn expect_ident_or_keyword(self: &mut Parser) -> ParseResultStr {
    var tok: Token = self.peek_token();
    match tok.kind {
        TokenKind::Ident(s: str) => {
            self.advance();
            return ParseResultStr::Ok(s);
        }
    }
    if is_word_keyword(tok.kind) {
        var s: str = token_kind_to_str(tok.kind);
        self.advance();
        return ParseResultStr::Ok(s);
    }
    return ParseResultStr::Err(
        "Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) +
        ": expected identifier but got '" + token_kind_to_str(tok.kind) + "'"
    );
}

fn is_struct_name(self: &Parser, name: str) -> bool {
    // O(1) HashMap lookup (string interning optimization)
    if HashMap_get(self.struct_name_set, name) != 0 { return true; }
    // Check aliases (small list, linear scan is fine)
    var j: i64 = 0;
    while j < self.alias_to_struct.len() {
        if self.alias_to_struct.get(j) == name { return true; }
        j = j + 1;
    }
    return false;
}

fn is_enum_name(self: &Parser, name: str) -> bool {
    // O(1) HashMap lookup (string interning optimization)
    if HashMap_get(self.enum_name_set, name) != 0 { return true; }
    return false;
}

fn read_type_name(self: &mut Parser) -> ParseResultStr {
    var tok: Token = self.peek_token();
    match tok.kind {
        TokenKind::Ident(s: str) => { self.advance(); return ParseResultStr::Ok(s); }
        TokenKind::I8 => { self.advance(); return ParseResultStr::Ok("i8"); }
        TokenKind::I16 => { self.advance(); return ParseResultStr::Ok("i16"); }
        TokenKind::I32 => { self.advance(); return ParseResultStr::Ok("i32"); }
        TokenKind::I64 => { self.advance(); return ParseResultStr::Ok("i64"); }
        TokenKind::I128 => { self.advance(); return ParseResultStr::Ok("i128"); }
        TokenKind::U8 => { self.advance(); return ParseResultStr::Ok("u8"); }
        TokenKind::U16 => { self.advance(); return ParseResultStr::Ok("u16"); }
        TokenKind::U32 => { self.advance(); return ParseResultStr::Ok("u32"); }
        TokenKind::U64 => { self.advance(); return ParseResultStr::Ok("u64"); }
        TokenKind::U128 => { self.advance(); return ParseResultStr::Ok("u128"); }
        TokenKind::F32 => { self.advance(); return ParseResultStr::Ok("f32"); }
        TokenKind::F64 => { self.advance(); return ParseResultStr::Ok("f64"); }
        TokenKind::Bool => { self.advance(); return ParseResultStr::Ok("bool"); }
        TokenKind::Str => { self.advance(); return ParseResultStr::Ok("str"); }
        TokenKind::Void => { self.advance(); return ParseResultStr::Ok("void"); }
    }
    return ParseResultStr::Err(
        "Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) +
        ": expected type name but got '" + token_kind_to_str(tok.kind) + "'"
    );
}

pub fn parse(self: &mut Parser) -> ParseResultProgram {
    var program: Program = program_new();

    while !self.is_at_end() {
        var is_pub: bool = false;
        if self.check(TokenKind::Pub) {
            self.advance();
            is_pub = true;
        }

        match self.parse_top_level_item(program, is_pub) {
            ParseResultUnit::Ok => {}
            ParseResultUnit::Err(e) => {
                self.errors.push(e);
                self.recover_to_sync_token();
                if self.check(TokenKind::RBrace) {
                    self.advance();
                }
            }
        }
    }

    if self.errors.len() > 0 {
        return ParseResultProgram::Err(vec_str_join(self.errors, "\n"));
    }
    return ParseResultProgram::Ok(program);
}

fn parse_top_level_item(self: &mut Parser, program: Program, is_pub: bool) -> ParseResultUnit {
    var k: TokenKind = self.peek();

    if token_kind_eq(k, TokenKind::Module) {
        self.advance();
        var name: str = "";
        loop {
            match self.expect_ident() {
                ParseResultStr::Ok(part) => { name = name + part; }
                ParseResultStr::Err(e) => { return ParseResultUnit::Err(e); }
            }
            if self.match_tok(TokenKind::DoubleColon) {
                name = name + "::";
            } else {
                break;
            }
        }
        self.match_tok(TokenKind::Semicolon);
        program.module = OptStr::Some(name);
        return ParseResultUnit::Ok;
    }

    if token_kind_eq(k, TokenKind::Struct) {
        match self.parse_struct() {
            ParseResultStructDef::Ok(s) => {
                var ms = s;
                ms.is_pub = is_pub;
                program.structs.push(ms);
                return ParseResultUnit::Ok;
            }
            ParseResultStructDef::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Enum) {
        match self.parse_enum() {
            ParseResultEnumDef::Ok(e) => {
                var me = e;
                me.is_pub = is_pub;
                program.enums.push(me);
                return ParseResultUnit::Ok;
            }
            ParseResultEnumDef::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Const) {
        match self.parse_const() {
            ParseResultConstDef::Ok(c) => {
                var mc = c;
                mc.is_pub = is_pub;
                program.consts.push(mc);
                return ParseResultUnit::Ok;
            }
            ParseResultConstDef::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Var) || token_kind_eq(k, TokenKind::Static) {
        match self.parse_global_var() {
            ParseResultGlobalVar::Ok(g) => {
                var mg = g;
                mg.is_pub = is_pub;
                program.globals.push(mg);
                return ParseResultUnit::Ok;
            }
            ParseResultGlobalVar::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Type) {
        match self.parse_type_alias() {
            ParseResultTypeAlias::Ok(ta) => {
                var mta = ta;
                mta.is_pub = is_pub;
                program.type_aliases.push(mta);
                return ParseResultUnit::Ok;
            }
            ParseResultTypeAlias::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Cap) {
        match self.parse_trait() {
            ParseResultTraitDef::Ok(t) => {
                var mt = t;
                mt.is_pub = is_pub;
                program.traits.push(mt);
                return ParseResultUnit::Ok;
            }
            ParseResultTraitDef::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Impl) {
        match self.parse_impl_or_trait_impl() {
            ParseResultImplOrTrait::Ok(imp) => {
                if imp.tag == 0 {
                    program.impls.push(imp.struct_impl);
                } else {
                    program.trait_impls.push(imp.trait_impl);
                }
                return ParseResultUnit::Ok;
            }
            ParseResultImplOrTrait::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Use) {
        match self.parse_use() {
            ParseResultImportDef::Ok(imp) => {
                var mimp = imp;
                mimp.is_pub = is_pub;
                program.imports.push(mimp);
                return ParseResultUnit::Ok;
            }
            ParseResultImportDef::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Hash) {
        match self.parse_attribute() {
            ParseResultAttribute::Ok(attr) => {
                program.attributes.push(attr);
                return ParseResultUnit::Ok;
            }
            ParseResultAttribute::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::At) {
        var annotations: Vec<Annotation> = Vec::new();
        while self.check(TokenKind::At) {
            match self.parse_at_annotation() {
                ParseResultAnnotation::Ok(a) => { annotations.push(a); }
                ParseResultAnnotation::Err(e) => { return ParseResultUnit::Err(e); }
            }
        }
        var item_is_pub: bool = false;
        if self.check(TokenKind::Pub) {
            self.advance();
            item_is_pub = true;
        } else {
            item_is_pub = is_pub;
        }
        if self.check(TokenKind::Struct) {
            match self.parse_struct() {
                ParseResultStructDef::Ok(sd) => {
                var msd = sd;
                    msd.is_pub = item_is_pub;
                    msd.annotations = annotations;
                    program.structs.push(msd);
                    return ParseResultUnit::Ok;
                }
                ParseResultStructDef::Err(e) => { return ParseResultUnit::Err(e); }
            }
        } else {
            match self.parse_func() {
                ParseResultFunc::Ok(func) => {
                var mfunc = func;
                    mfunc.is_pub = item_is_pub;
                    mfunc.annotations = annotations;
                    program.funcs.push(mfunc);
                    return ParseResultUnit::Ok;
                }
                ParseResultFunc::Err(e) => { return ParseResultUnit::Err(e); }
            }
        }
    }

    if token_kind_eq(k, TokenKind::Layer) {
        match self.parse_layer() {
            ParseResultLayerDef::Ok(l) => {
                var ml = l;
                ml.is_pub = is_pub;
                program.layers.push(ml);
                return ParseResultUnit::Ok;
            }
            ParseResultLayerDef::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Model) {
        match self.parse_model() {
            ParseResultModelDef::Ok(m) => {
                var mm = m;
                mm.is_pub = is_pub;
                program.models.push(mm);
                return ParseResultUnit::Ok;
            }
            ParseResultModelDef::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Component) {
        match self.parse_component() {
            ParseResultComponentDef::Ok(c) => {
                var mc = c;
                mc.is_pub = is_pub;
                program.components.push(mc);
                return ParseResultUnit::Ok;
            }
            ParseResultComponentDef::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::System) {
        match self.parse_system() {
            ParseResultSystemDef::Ok(s) => {
                var ms = s;
                ms.is_pub = is_pub;
                program.systems.push(ms);
                return ParseResultUnit::Ok;
            }
            ParseResultSystemDef::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::State) {
        match self.parse_state_machine() {
            ParseResultStateMachineDef::Ok(sm) => {
                var msm = sm;
                msm.is_pub = is_pub;
                program.state_machines.push(msm);
                return ParseResultUnit::Ok;
            }
            ParseResultStateMachineDef::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::On) {
        match self.parse_event_handler() {
            ParseResultEventHandlerDef::Ok(eh) => {
                var meh = eh;
                meh.is_pub = is_pub;
                program.event_handlers.push(meh);
                return ParseResultUnit::Ok;
            }
            ParseResultEventHandlerDef::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Comptime) {
        self.advance();
        match self.parse_func() {
            ParseResultFunc::Ok(func) => {
                var mfunc = func;
                mfunc.is_pub = is_pub;
                mfunc.is_comptime = true;
                program.funcs.push(mfunc);
                return ParseResultUnit::Ok;
            }
            ParseResultFunc::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Interrupt) {
        self.advance();
        match self.parse_func() {
            ParseResultFunc::Ok(func) => {
                var mfunc = func;
                mfunc.is_pub = is_pub;
                mfunc.is_interrupt = true;
                program.funcs.push(mfunc);
                return ParseResultUnit::Ok;
            }
            ParseResultFunc::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Async) {
        self.advance();
        match self.parse_func() {
            ParseResultFunc::Ok(func) => {
                var mfunc = func;
                mfunc.is_pub = is_pub;
                mfunc.is_async = true;
                program.funcs.push(mfunc);
                return ParseResultUnit::Ok;
            }
            ParseResultFunc::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    if token_kind_eq(k, TokenKind::Extern) {
        return self.parse_extern_block(program, is_pub);
    }

    // Default: parse as function
    match self.parse_func() {
        ParseResultFunc::Ok(func) => {
                var mfunc = func;
            mfunc.is_pub = is_pub;
            program.funcs.push(mfunc);
            return ParseResultUnit::Ok;
        }
        ParseResultFunc::Err(e) => { return ParseResultUnit::Err(e); }
    }

}
fn parse_extern_block(self: &mut Parser, program: Program, _is_pub: bool) -> ParseResultUnit {
    self.advance(); // consume extern
    var abi: str = "C";
    var tok: Token = self.peek_token();
    match tok.kind {
        TokenKind::StringLit(s: str) => {
            self.advance();
            abi = s;
        }
    }

    var include: OptStr = OptStr::None;
    var link_lib: OptStr = OptStr::None;
    loop {
        var is_kw: bool = false;
        var ktok: Token = self.peek_token();
        match ktok.kind {
            TokenKind::Ident(kw: str) => {
                if kw == "include" {
                    self.advance();
                    var stok: Token = self.peek_token();
                    match stok.kind {
                        TokenKind::StringLit(s: str) => {
                            self.advance();
                            include = OptStr::Some(s);
                            is_kw = true;
                        }
                    }
                } else if kw == "link" {
                    self.advance();
                    var stok: Token = self.peek_token();
                    match stok.kind {
                        TokenKind::StringLit(s: str) => {
                            self.advance();
                            link_lib = OptStr::Some(s);
                            is_kw = true;
                        }
                    }
                }
            }
        }
        if !is_kw { break; }
    }

    if self.check(TokenKind::LBrace) {
        self.advance();
        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            match self.expect(TokenKind::Fn, "fn") {
                ParseResultUnit::Err(e) => { return ParseResultUnit::Err(e); }
                ParseResultUnit::Ok => {}
            }
            match self.parse_extern_func_decl(abi, include, link_lib) {
                ParseResultExternDecl::Ok(decl) => { program.extern_decls.push(decl); }
                ParseResultExternDecl::Err(e) => { return ParseResultUnit::Err(e); }
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => { return ParseResultUnit::Err(e); }
            ParseResultUnit::Ok => {}
        }
    } else {
        match self.expect(TokenKind::Fn, "fn") {
            ParseResultUnit::Err(e) => { return ParseResultUnit::Err(e); }
            ParseResultUnit::Ok => {}
        }
        match self.parse_extern_func_decl(abi, include, link_lib) {
            ParseResultExternDecl::Ok(decl) => { program.extern_decls.push(decl); }
            ParseResultExternDecl::Err(e) => { return ParseResultUnit::Err(e); }
        }
    }

    return ParseResultUnit::Ok;
}

fn parse_struct(self: &mut Parser) -> ParseResultStructDef {
match self.expect(TokenKind::Struct, "struct") {
    ParseResultUnit::Err(e) => { return ParseResultStructDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var name: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { name = s; }
    ParseResultStr::Err(e) => { return ParseResultStructDef::Err(e); }
}

var type_params: Vec<str> = Vec::new();
if self.check(TokenKind::Lt) {
    self.advance();
    if !self.check(TokenKind::Gt) {
        loop {
            match self.expect_ident() {
                ParseResultStr::Ok(tp) => { type_params.push(tp); }
                ParseResultStr::Err(e) => { return ParseResultStructDef::Err(e); }
            }
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::Gt, ">") {
        ParseResultUnit::Err(e) => { return ParseResultStructDef::Err(e); }
        ParseResultUnit::Ok => {}
    }
}

match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultStructDef::Err(e); }
    ParseResultUnit::Ok => {}
}

var fields: Vec<Param> = Vec::new();
while !self.check(TokenKind::RBrace) && !self.is_at_end() {
    var is_pub: bool = false;
    if self.check(TokenKind::Pub) {
        self.advance();
        is_pub = true;
    }
    var fname: str = "";
    match self.expect_ident_or_keyword() {
        ParseResultStr::Ok(s) => { fname = s; }
        ParseResultStr::Err(e) => { return ParseResultStructDef::Err(e); }
    }
    match self.expect(TokenKind::Colon, ":") {
        ParseResultUnit::Err(e) => { return ParseResultStructDef::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var fty: Type = Type::Void;
    match self.parse_type() {
        ParseResultType::Ok(t) => { fty = t; }
        ParseResultType::Err(e) => { return ParseResultStructDef::Err(e); }
    }
    fields.push(Param_new(fname, fty, is_pub));
    self.match_tok(TokenKind::Comma);
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultStructDef::Err(e); }
    ParseResultUnit::Ok => {}
}

self.struct_names.push(name);
HashMap_insert(self.struct_name_set, name, 1);
var __ret_StructDef: StructDef = StructDef_new(name, false);
__ret_StructDef.fields = fields;
__ret_StructDef.type_params = type_params;
return ParseResultStructDef::Ok(__ret_StructDef);
}

fn parse_enum(self: &mut Parser) -> ParseResultEnumDef {
match self.expect(TokenKind::Enum, "enum") {
    ParseResultUnit::Err(e) => { return ParseResultEnumDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var name: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { name = s; }
    ParseResultStr::Err(e) => { return ParseResultEnumDef::Err(e); }
}

var type_params: Vec<str> = Vec::new();
if self.check(TokenKind::Lt) {
    self.advance();
    if !self.check(TokenKind::Gt) {
        loop {
            match self.expect_ident() {
                ParseResultStr::Ok(tp) => { type_params.push(tp); }
                ParseResultStr::Err(e) => { return ParseResultEnumDef::Err(e); }
            }
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::Gt, ">") {
        ParseResultUnit::Err(e) => { return ParseResultEnumDef::Err(e); }
        ParseResultUnit::Ok => {}
    }
}

match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultEnumDef::Err(e); }
    ParseResultUnit::Ok => {}
}

var variants: Vec<EnumVariant> = Vec::new();
while !self.check(TokenKind::RBrace) && !self.is_at_end() {
    var vname: str = "";
    match self.expect_ident() {
        ParseResultStr::Ok(s) => { vname = s; }
        ParseResultStr::Err(e) => { return ParseResultEnumDef::Err(e); }
    }
    var data: OptParams = OptParams::None;
    if self.match_tok(TokenKind::LParen) {
        var params: Vec<Param> = Vec::new();
        if !self.check(TokenKind::RParen) {
            loop {
                // Check if named param: ident followed by colon
                var pname_tok: Token = self.peek_token();
                var is_named: bool = false;
                match pname_tok.kind {
                    TokenKind::Ident(_: str) => {
                        // Peek next token for colon
                        if self.pos + 1 < self.tokens.len() {
                            var next_tok: Token = self.tokens.get(self.pos + 1);
                            if token_kind_eq(next_tok.kind, TokenKind::Colon) {
                                is_named = true;
                            }
                        }
                    }
                }
                if is_named {
                    var pname: str = "";
                    match self.expect_ident() {
                        ParseResultStr::Ok(s) => { pname = s; }
                        ParseResultStr::Err(e) => { return ParseResultEnumDef::Err(e); }
                    }
                    match self.expect(TokenKind::Colon, ":") {
                        ParseResultUnit::Err(e) => { return ParseResultEnumDef::Err(e); }
                        ParseResultUnit::Ok => {}
                    }
                    var pty: Type = Type::Void;
                    match self.parse_type() {
                        ParseResultType::Ok(t) => { pty = t; }
                        ParseResultType::Err(e) => { return ParseResultEnumDef::Err(e); }
                    }
                    params.push(Param_new(pname, pty, false));
                } else {
                    var pty: Type = Type::Void;
                    match self.parse_type() {
                        ParseResultType::Ok(t) => { pty = t; }
                        ParseResultType::Err(e) => { return ParseResultEnumDef::Err(e); }
                    }
                    var pname: str = "_" + int_to_str(params.len());
                    params.push(Param_new(pname, pty, false));
                }
                if !self.match_tok(TokenKind::Comma) { break; }
            }
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => { return ParseResultEnumDef::Err(e); }
            ParseResultUnit::Ok => {}
        }
        data = OptParams::Some(params);
    }
    variants.push(EnumVariant_new(vname, data));
    self.match_tok(TokenKind::Comma);
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultEnumDef::Err(e); }
    ParseResultUnit::Ok => {}
}

self.enum_names.push(name);
HashMap_insert(self.enum_name_set, name, 1);
var __ret_EnumDef: EnumDef = EnumDef_new(name, variants, false);
__ret_EnumDef.type_params = type_params;
return ParseResultEnumDef::Ok(__ret_EnumDef);
}

fn parse_const(self: &mut Parser) -> ParseResultConstDef {
match self.expect(TokenKind::Const, "const") {
    ParseResultUnit::Err(e) => { return ParseResultConstDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var name: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { name = s; }
    ParseResultStr::Err(e) => { return ParseResultConstDef::Err(e); }
}
match self.expect(TokenKind::Colon, ":") {
    ParseResultUnit::Err(e) => { return ParseResultConstDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var ty: Type = Type::Void;
match self.parse_type() {
    ParseResultType::Ok(t) => { ty = t; }
    ParseResultType::Err(e) => { return ParseResultConstDef::Err(e); }
}
match self.expect(TokenKind::Eq, "=") {
    ParseResultUnit::Err(e) => { return ParseResultConstDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var expr: Expr = Expr::IntLit(0);
match self.parse_expr() {
    ParseResultExpr::Ok(e) => { expr = e; }
    ParseResultExpr::Err(e) => { return ParseResultConstDef::Err(e); }
}
self.match_tok(TokenKind::Semicolon);
var __ret_ConstDef: ConstDef = ConstDef_new(name, ty, expr, false);
return ParseResultConstDef::Ok(__ret_ConstDef);
}

// Parse a module-level mutable global variable:
// `var name: Type = expr;` or `var name: Type;` (zero-initialized)
fn parse_global_var(self: &mut Parser) -> ParseResultGlobalVar {
// Accept either `var` or `static` (static is an alias for var).
if !self.match_tok(TokenKind::Var) {
    match self.expect(TokenKind::Static, "var or static") {
        ParseResultUnit::Err(e) => { return ParseResultGlobalVar::Err(e); }
        ParseResultUnit::Ok => {}
    }
}
var name: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { name = s; }
    ParseResultStr::Err(e) => { return ParseResultGlobalVar::Err(e); }
}
match self.expect(TokenKind::Colon, ":") {
    ParseResultUnit::Err(e) => { return ParseResultGlobalVar::Err(e); }
    ParseResultUnit::Ok => {}
}
var ty: Type = Type::Void;
match self.parse_type() {
    ParseResultType::Ok(t) => { ty = t; }
    ParseResultType::Err(e) => { return ParseResultGlobalVar::Err(e); }
}
// Initializer is optional -- defaults to zero-value of the type
var init: Expr = Expr::IntLit(0);
if self.check(TokenKind::Eq) {
    self.advance();
    match self.parse_expr() {
        ParseResultExpr::Ok(e) => { init = e; }
        ParseResultExpr::Err(e) => { return ParseResultGlobalVar::Err(e); }
    }
} else {
    // Zero-initializer: pick a sensible default per type
    match ty {
        Type::I64 => { init = Expr::IntLit(0); }
        Type::I32 => { init = Expr::IntLit(0); }
        Type::I16 => { init = Expr::IntLit(0); }
        Type::I8 => { init = Expr::IntLit(0); }
        Type::U64 => { init = Expr::IntLit(0); }
        Type::U32 => { init = Expr::IntLit(0); }
        Type::U16 => { init = Expr::IntLit(0); }
        Type::U8 => { init = Expr::IntLit(0); }
        Type::Bool => { init = Expr::IntLit(0); }
        Type::F64 => { init = Expr::FloatLit(0.0); }
        Type::F32 => { init = Expr::FloatLit(0.0); }
        Type::Str => { init = Expr::StringLit(""); }
        _ => { init = Expr::IntLit(0); }
    }
}
self.match_tok(TokenKind::Semicolon);
var __ret_GlobalVar: GlobalVar = GlobalVar_new(name, ty, init, false);
return ParseResultGlobalVar::Ok(__ret_GlobalVar);
}

fn parse_type_alias(self: &mut Parser) -> ParseResultTypeAlias {
match self.expect(TokenKind::Type, "type") {
    ParseResultUnit::Err(e) => { return ParseResultTypeAlias::Err(e); }
    ParseResultUnit::Ok => {}
}
var name: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { name = s; }
    ParseResultStr::Err(e) => { return ParseResultTypeAlias::Err(e); }
}
match self.expect(TokenKind::Eq, "=") {
    ParseResultUnit::Err(e) => { return ParseResultTypeAlias::Err(e); }
    ParseResultUnit::Ok => {}
}
var alias_for: Type = Type::Void;
match self.parse_type() {
    ParseResultType::Ok(t) => { alias_for = t; }
    ParseResultType::Err(e) => { return ParseResultTypeAlias::Err(e); }
}
self.match_tok(TokenKind::Semicolon);
// If alias points to a named struct, track it
match alias_for {
    Type::Named(target) => {
        var i: i64 = 0;
        while i < self.struct_names.len() {
            if self.struct_names.get(i) == target {
                self.alias_to_struct.push(name);
            }
            i = i + 1;
        }
    }
}
var __ret_TypeAlias: TypeAlias = TypeAlias_new(name, alias_for, false);
return ParseResultTypeAlias::Ok(__ret_TypeAlias);
}

fn parse_impl_or_trait_impl(self: &mut Parser) -> ParseResultImplOrTrait {
match self.expect(TokenKind::Impl, "impl") {
    ParseResultUnit::Err(e) => { return ParseResultImplOrTrait::Err(e); }
    ParseResultUnit::Ok => {}
}

var type_params: Vec<str> = Vec::new();
if self.check(TokenKind::Lt) {
    self.advance();
    if !self.check(TokenKind::Gt) {
        loop {
            match self.expect_ident() {
                ParseResultStr::Ok(tp) => { type_params.push(tp); }
                ParseResultStr::Err(e) => { return ParseResultImplOrTrait::Err(e); }
            }
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::Gt, ">") {
        ParseResultUnit::Err(e) => { return ParseResultImplOrTrait::Err(e); }
        ParseResultUnit::Ok => {}
    }
}

var first_name: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { first_name = s; }
    ParseResultStr::Err(e) => { return ParseResultImplOrTrait::Err(e); }
}

// Check for `impl Trait for Type`
if self.match_tok(TokenKind::For) {
    var trait_name: str = first_name;
    var type_name: str = "";
    match self.expect_ident() {
        ParseResultStr::Ok(s) => { type_name = s; }
        ParseResultStr::Err(e) => { return ParseResultImplOrTrait::Err(e); }
    }
    match self.expect(TokenKind::LBrace, "{") {
        ParseResultUnit::Err(e) => { return ParseResultImplOrTrait::Err(e); }
        ParseResultUnit::Ok => {}
    }

    var methods: Vec<Func> = Vec::new();
    var associated_types: Vec<AssocTypeBinding> = Vec::new();
    while !self.check(TokenKind::RBrace) && !self.is_at_end() {
        if self.check(TokenKind::Type) {
            self.advance();
            var assoc_name: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => { assoc_name = s; }
                ParseResultStr::Err(e) => { return ParseResultImplOrTrait::Err(e); }
            }
            // Optional GAT type params
            if self.check(TokenKind::Lt) {
                self.advance();
                if !self.check(TokenKind::Gt) {
                    loop {
                        match self.expect_ident() {
                            ParseResultStr::Ok(_) => {}
                            ParseResultStr::Err(e) => { return ParseResultImplOrTrait::Err(e); }
                        }
                        if !self.match_tok(TokenKind::Comma) { break; }
                        if self.check(TokenKind::Gt) { break; }
                    }
                }
                match self.expect(TokenKind::Gt, ">") {
                    ParseResultUnit::Err(e) => { return ParseResultImplOrTrait::Err(e); }
                    ParseResultUnit::Ok => {}
                }
            }
            match self.expect(TokenKind::Eq, "=") {
                ParseResultUnit::Err(e) => { return ParseResultImplOrTrait::Err(e); }
                ParseResultUnit::Ok => {}
            }
            var assoc_ty: Type = Type::Void;
            match self.parse_type() {
                ParseResultType::Ok(t) => { assoc_ty = t; }
                ParseResultType::Err(e) => { return ParseResultImplOrTrait::Err(e); }
            }
            self.match_tok(TokenKind::Semicolon);
            associated_types.push(AssocTypeBinding_new(assoc_name, assoc_ty));
        } else {
            var is_pub: bool = false;
            if self.check(TokenKind::Pub) {
                self.advance();
                is_pub = true;
            }
            match self.parse_func() {
                ParseResultFunc::Ok(func) => {
                var mfunc = func;
                    mfunc.is_pub = is_pub;
                    methods.push(mfunc);
                }
                ParseResultFunc::Err(e) => { return ParseResultImplOrTrait::Err(e); }
            }
        }
    }
    match self.expect(TokenKind::RBrace, "}") {
        ParseResultUnit::Err(e) => { return ParseResultImplOrTrait::Err(e); }
        ParseResultUnit::Ok => {}
    }

    var __ti: TraitImpl = TraitImpl_new(trait_name, type_name);
    __ti.type_params = type_params;
    __ti.methods = methods;
    __ti.associated_types = associated_types;
    var __iot1: ImplOrTrait = ImplOrTrait {
        tag: 1,
        struct_impl: ImplDef_new(""),
        trait_impl: __ti,
    };
    return ParseResultImplOrTrait::Ok(__iot1);
}

// Regular `impl Type { ... }`
var struct_name: str = first_name;
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultImplOrTrait::Err(e); }
    ParseResultUnit::Ok => {}
}

var methods: Vec<Func> = Vec::new();
while !self.check(TokenKind::RBrace) && !self.is_at_end() {
    var is_pub: bool = false;
    if self.check(TokenKind::Pub) {
        self.advance();
        is_pub = true;
    }
    match self.parse_func() {
        ParseResultFunc::Ok(func) => {
                var mfunc = func;
            mfunc.is_pub = is_pub;
            methods.push(mfunc);
        }
        ParseResultFunc::Err(e) => { return ParseResultImplOrTrait::Err(e); }
    }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultImplOrTrait::Err(e); }
    ParseResultUnit::Ok => {}
}

var __si: ImplDef = ImplDef_new(struct_name);
__si.type_params = type_params;
__si.methods = methods;
var __iot0: ImplOrTrait = ImplOrTrait {
    tag: 0,
    struct_impl: __si,
    trait_impl: TraitImpl_new("", ""),
};
return ParseResultImplOrTrait::Ok(__iot0);
}

fn parse_trait(self: &mut Parser) -> ParseResultTraitDef {
match self.expect(TokenKind::Cap, "cap") {
    ParseResultUnit::Err(e) => { return ParseResultTraitDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var name: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { name = s; }
    ParseResultStr::Err(e) => { return ParseResultTraitDef::Err(e); }
}
// Supertraits: `cap NamedGreet: Greet + Show {`
var supertraits: Vec<str> = Vec::new();
if self.match_tok(TokenKind::Colon) {
    var more_supers: bool = true;
    while more_supers {
        match self.expect_ident() {
            ParseResultStr::Ok(sup) => { supertraits.push(sup); }
            ParseResultStr::Err(e) => { return ParseResultTraitDef::Err(e); }
        }
        more_supers = self.match_tok(TokenKind::Plus);
    }
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultTraitDef::Err(e); }
    ParseResultUnit::Ok => {}
}

var methods: Vec<TraitMethod> = Vec::new();
var associated_types: Vec<AssocTypeDecl> = Vec::new();
while !self.check(TokenKind::RBrace) && !self.is_at_end() {
    if self.check(TokenKind::Type) {
        self.advance();
        var assoc_name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => { assoc_name = s; }
            ParseResultStr::Err(e) => { return ParseResultTraitDef::Err(e); }
        }
        var type_params: Vec<str> = Vec::new();
        if self.check(TokenKind::Lt) {
            self.advance();
            if !self.check(TokenKind::Gt) {
                loop {
                    match self.expect_ident() {
                        ParseResultStr::Ok(tp) => { type_params.push(tp); }
                        ParseResultStr::Err(e) => { return ParseResultTraitDef::Err(e); }
                    }
                    if !self.match_tok(TokenKind::Comma) { break; }
                    if self.check(TokenKind::Gt) { break; }
                }
            }
            match self.expect(TokenKind::Gt, ">") {
                ParseResultUnit::Err(e) => { return ParseResultTraitDef::Err(e); }
                ParseResultUnit::Ok => {}
            }
        }
        self.match_tok(TokenKind::Semicolon);
        associated_types.push(AssocTypeDecl_new(assoc_name, type_params));
    } else {
        var is_pub: bool = false;
        if self.check(TokenKind::Pub) {
            self.advance();
            is_pub = true;
        }
        match self.expect(TokenKind::Fn, "fn") {
            ParseResultUnit::Err(e) => { return ParseResultTraitDef::Err(e); }
            ParseResultUnit::Ok => {}
        }
        var method_name: str = "";
        match self.expect_ident_or_keyword() {
            ParseResultStr::Ok(s) => { method_name = s; }
            ParseResultStr::Err(e) => { return ParseResultTraitDef::Err(e); }
        }
        // Generic type params (ignored -- just consumed)
        if self.check(TokenKind::Lt) {
            self.advance();
            if !self.check(TokenKind::Gt) {
                loop {
                    match self.expect_ident() {
                        ParseResultStr::Ok(_) => {}
                        ParseResultStr::Err(e) => { return ParseResultTraitDef::Err(e); }
                    }
                    if !self.match_tok(TokenKind::Comma) { break; }
                }
            }
            match self.expect(TokenKind::Gt, ">") {
                ParseResultUnit::Err(e) => { return ParseResultTraitDef::Err(e); }
                ParseResultUnit::Ok => {}
            }
        }
        match self.expect(TokenKind::LParen, "(") {
            ParseResultUnit::Err(e) => { return ParseResultTraitDef::Err(e); }
            ParseResultUnit::Ok => {}
        }
        var params: Vec<Param> = Vec::new();
        if !self.check(TokenKind::RParen) {
            loop {
                var pname: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(s) => { pname = s; }
                    ParseResultStr::Err(e) => { return ParseResultTraitDef::Err(e); }
                }
                if pname == "self" && !self.check(TokenKind::Colon) {
                    params.push(Param_new("self", Type::Named("Self"), false));
                } else {
                    match self.expect(TokenKind::Colon, ":") {
                        ParseResultUnit::Err(e) => { return ParseResultTraitDef::Err(e); }
                        ParseResultUnit::Ok => {}
                    }
                    var ty: Type = Type::Void;
                    match self.parse_type() {
                        ParseResultType::Ok(t) => { ty = t; }
                        ParseResultType::Err(e) => { return ParseResultTraitDef::Err(e); }
                    }
                    params.push(Param_new(pname, ty, false));
                }
                if !self.match_tok(TokenKind::Comma) { break; }
            }
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => { return ParseResultTraitDef::Err(e); }
            ParseResultUnit::Ok => {}
        }

        var ret_ty: Type = Type::Void;
        if self.match_tok(TokenKind::Arrow) {
            match self.parse_type() {
                ParseResultType::Ok(t) => { ret_ty = t; }
                ParseResultType::Err(e) => { return ParseResultTraitDef::Err(e); }
            }
        }

        var has_self: bool = false;
        if params.len() > 0 {
            if params.get(0).name == "self" { has_self = true; }
        }

        var default_body: OptStmts = OptStmts::None;
        if self.check(TokenKind::LBrace) {
            self.advance();
            var body: Vec<Stmt> = Vec::new();
            match self.parse_block() {
                ParseResultStmts::Ok(b) => { body = b; }
                ParseResultStmts::Err(e) => { return ParseResultTraitDef::Err(e); }
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => { return ParseResultTraitDef::Err(e); }
                ParseResultUnit::Ok => {}
            }
            default_body = OptStmts::Some(body);
        } else {
            self.match_tok(TokenKind::Semicolon);
        }

        var mtm: TraitMethod = TraitMethod_new(method_name, ret_ty, has_self);
        mtm.params = params;
        mtm.is_pub = is_pub;
        mtm.default_body = default_body;
        methods.push(mtm);
    }
    }
    match self.expect(TokenKind::RBrace, "}") {
        ParseResultUnit::Err(e) => { return ParseResultTraitDef::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var __td0: TraitDef = TraitDef_new(name, methods);
    __td0.associated_types = associated_types;
    __td0.supertraits = supertraits;
    return ParseResultTraitDef::Ok(__td0);
}

fn parse_extern_func_decl(self: &mut Parser, abi: str, include: OptStr, link_lib: OptStr) -> ParseResultExternDecl {
var c_name: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { c_name = s; }
    ParseResultStr::Err(e) => { return ParseResultExternDecl::Err(e); }
}
var pledge_name: str = c_name;
if self.check(TokenKind::As) {
    self.advance();
    match self.expect_ident() {
        ParseResultStr::Ok(s) => { pledge_name = s; }
        ParseResultStr::Err(e) => { return ParseResultExternDecl::Err(e); }
    }
}
match self.expect(TokenKind::LParen, "(") {
    ParseResultUnit::Err(e) => { return ParseResultExternDecl::Err(e); }
    ParseResultUnit::Ok => {}
}
var params: Vec<Param> = Vec::new();
match self.parse_params() {
    ParseResultParams::Ok(p) => { params = p; }
    ParseResultParams::Err(e) => { return ParseResultExternDecl::Err(e); }
}
match self.expect(TokenKind::RParen, ")") {
    ParseResultUnit::Err(e) => { return ParseResultExternDecl::Err(e); }
    ParseResultUnit::Ok => {}
}
var ret_ty: Type = Type::Void;
if self.match_tok(TokenKind::Arrow) {
    match self.parse_type() {
        ParseResultType::Ok(t) => { ret_ty = t; }
        ParseResultType::Err(e) => { return ParseResultExternDecl::Err(e); }
    }
}
self.match_tok(TokenKind::Semicolon);
var __ret_ExternDecl: ExternDecl = ExternDecl_new(abi, c_name, pledge_name, ret_ty);
__ret_ExternDecl.params = params;
__ret_ExternDecl.include = include;
__ret_ExternDecl.link_lib = link_lib;
return ParseResultExternDecl::Ok(__ret_ExternDecl);
}

fn parse_func(self: &mut Parser) -> ParseResultFunc {
match self.expect(TokenKind::Fn, "fn") {
    ParseResultUnit::Err(e) => { return ParseResultFunc::Err(e); }
    ParseResultUnit::Ok => {}
}
var name: str = "";
match self.expect_ident_or_keyword() {
    ParseResultStr::Ok(s) => { name = s; }
    ParseResultStr::Err(e) => { return ParseResultFunc::Err(e); }
}

var type_params: Vec<str> = Vec::new();
var type_param_bounds: Vec<StrPair> = Vec::new();
var const_params: Vec<StrPair> = Vec::new();
if self.check(TokenKind::Lt) {
    self.advance();
    if !self.check(TokenKind::Gt) {
        loop {
            var tp: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => { tp = s; }
                ParseResultStr::Err(e) => { return ParseResultFunc::Err(e); }
            }
            if self.match_tok(TokenKind::Colon) {
                var bound_tok: Token = self.peek_token();
                if is_int_type_keyword(bound_tok.kind) {
                    var ty_name: str = type_keyword_name(bound_tok.kind);
                    self.advance();
                    const_params.push(StrPair_new(tp, ty_name));
                } else {
                    var bound: str = "";
                    match self.expect_ident() {
                        ParseResultStr::Ok(s) => { bound = s; }
                        ParseResultStr::Err(e) => { return ParseResultFunc::Err(e); }
                    }
                    type_param_bounds.push(StrPair_new(tp, bound));
                    while self.match_tok(TokenKind::Plus) {
                        match self.expect_ident() {
                            ParseResultStr::Ok(_) => {}
                            ParseResultStr::Err(e) => { return ParseResultFunc::Err(e); }
                        }
                    }
                }
            }
            type_params.push(tp);
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::Gt, ">") {
        ParseResultUnit::Err(e) => { return ParseResultFunc::Err(e); }
        ParseResultUnit::Ok => {}
    }
}

match self.expect(TokenKind::LParen, "(") {
    ParseResultUnit::Err(e) => { return ParseResultFunc::Err(e); }
    ParseResultUnit::Ok => {}
}
var params: Vec<Param> = Vec::new();
match self.parse_params() {
    ParseResultParams::Ok(p) => { params = p; }
    ParseResultParams::Err(e) => { return ParseResultFunc::Err(e); }
}
match self.expect(TokenKind::RParen, ")") {
    ParseResultUnit::Err(e) => { return ParseResultFunc::Err(e); }
    ParseResultUnit::Ok => {}
}

var ret_ty: Type = Type::Void;
if self.match_tok(TokenKind::Arrow) {
    match self.parse_type() {
        ParseResultType::Ok(t) => { ret_ty = t; }
        ParseResultType::Err(e) => { return ParseResultFunc::Err(e); }
    }
}

// Effect annotation: !IO, !{IO, Net}, !{} (pure)
var has_effect_annotation: bool = false;
var declared_effects: Vec<str> = Vec::new();
if self.match_tok(TokenKind::Bang) {
    has_effect_annotation = true;
    if self.match_tok(TokenKind::LBrace) {
        if !self.check(TokenKind::RBrace) {
            loop {
                var eff: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(s) => { eff = s; }
                    ParseResultStr::Err(e) => { return ParseResultFunc::Err(e); }
                }
                declared_effects.push(eff);
                if !self.match_tok(TokenKind::Comma) { break; }
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => { return ParseResultFunc::Err(e); }
            ParseResultUnit::Ok => {}
        }
    } else {
        var eff: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => { eff = s; }
            ParseResultStr::Err(e) => { return ParseResultFunc::Err(e); }
        }
        declared_effects.push(eff);
    }
} else {
    // No effect annotation
}

// F10: Parse given/ensure contracts (Design by Contract)
var preconditions: Vec<Expr> = Vec::new();
var postconditions: Vec<Expr> = Vec::new();
loop {
    if self.check(TokenKind::Given) {
        self.advance();
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => { preconditions.push(e); }
            ParseResultExpr::Err(e) => { return ParseResultFunc::Err(e); }
        }
        // Skip optional 'and'/'or'/comma between conditions
        self.match_tok(TokenKind::And);
        self.match_tok(TokenKind::Comma);
        continue;
    }
    if self.check(TokenKind::Ensure) {
        self.advance();
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => { postconditions.push(e); }
            ParseResultExpr::Err(e) => { return ParseResultFunc::Err(e); }
        }
        self.match_tok(TokenKind::And);
        self.match_tok(TokenKind::Comma);
        continue;
    }
    break;
}

// Parse function body: { ... }
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultFunc::Err(e); }
    ParseResultUnit::Ok => {}
}
var body: Vec<Stmt> = Vec::new();
match self.parse_block() {
    ParseResultStmts::Ok(b) => { body = b; }
    ParseResultStmts::Err(e) => { return ParseResultFunc::Err(e); }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultFunc::Err(e); }
    ParseResultUnit::Ok => {}
}

var mfunc: Func = Func_new(name, ret_ty);
mfunc.type_params = type_params;
mfunc.type_param_bounds = type_param_bounds;
mfunc.const_params = const_params;
mfunc.params = params;
mfunc.body = body;
mfunc.declared_effects = declared_effects;
mfunc.has_effect_annotation = has_effect_annotation;
mfunc.preconditions = preconditions;
mfunc.postconditions = postconditions;
return ParseResultFunc::Ok(mfunc);
}

fn parse_params(self: &mut Parser) -> ParseResultParams {
var params: Vec<Param> = Vec::new();
if self.check(TokenKind::RParen) {
    return ParseResultParams::Ok(params);
}
loop {
    // Optional @annotations on the parameter (e.g. @secret, @tainted)
    var param_annotations: Vec<Annotation> = Vec::new();
    while self.check(TokenKind::At) {
        match self.parse_at_annotation() {
            ParseResultAnnotation::Ok(ann) => { param_annotations.push(ann); }
            ParseResultAnnotation::Err(e) => { return ParseResultParams::Err(e); }
        }
    }
    // Check for variadic: ... before the parameter name
    var is_variadic: bool = false;
    if self.match_tok(TokenKind::DotDotDot) {
        is_variadic = true;
    }
    var name: str = "";
    match self.expect_ident_or_keyword() {
        ParseResultStr::Ok(s) => { name = s; }
        ParseResultStr::Err(e) => { return ParseResultParams::Err(e); }
    }
    if name == "self" && !self.check(TokenKind::Colon) {
        var param: Param = Param_new("self", Type::Named("Self"), false);
        param.is_variadic = is_variadic;
        param.annotations = param_annotations;
        params.push(param);
    } else {
        match self.expect(TokenKind::Colon, ":") {
            ParseResultUnit::Err(e) => { return ParseResultParams::Err(e); }
            ParseResultUnit::Ok => {}
        }
        var ty: Type = Type::Void;
        match self.parse_type() {
            ParseResultType::Ok(t) => { ty = t; }
            ParseResultType::Err(e) => { return ParseResultParams::Err(e); }
        }
        var param: Param = Param_new(name, ty, false);
        param.is_variadic = is_variadic;
        param.annotations = param_annotations;
        // Check for default value: = expr
        if self.match_tok(TokenKind::Eq) {
            match self.parse_expr() {
                ParseResultExpr::Ok(e) => { param.has_default = true; param.default_expr = e; }
                ParseResultExpr::Err(e) => { return ParseResultParams::Err(e); }
            }
        }
        params.push(param);
    }
    if !self.match_tok(TokenKind::Comma) { break; }
    if self.check(TokenKind::RParen) { break; }
}
return ParseResultParams::Ok(params);
}

fn parse_layer(self: &mut Parser) -> ParseResultLayerDef {
match self.expect(TokenKind::Layer, "layer") {
    ParseResultUnit::Err(e) => { return ParseResultLayerDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var name: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { name = s; }
    ParseResultStr::Err(e) => { return ParseResultLayerDef::Err(e); }
}

var constructor_args: Vec<str> = Vec::new();
if self.match_tok(TokenKind::LParen) {
    if !self.check(TokenKind::RParen) {
        loop {
            match self.parse_annotation_arg() {
                ParseResultStr::Ok(arg) => { constructor_args.push(arg); }
                ParseResultStr::Err(e) => { return ParseResultLayerDef::Err(e); }
            }
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::RParen, ")") {
        ParseResultUnit::Err(e) => { return ParseResultLayerDef::Err(e); }
        ParseResultUnit::Ok => {}
    }
}

match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultLayerDef::Err(e); }
    ParseResultUnit::Ok => {}
}

var fields: Vec<Param> = Vec::new();
var forward: Func = Func_new("", Type::Void);
var has_forward: bool = false;
var has_forward: bool = false;

while !self.check(TokenKind::RBrace) && !self.is_at_end() {
    if self.check(TokenKind::Fn) {
        match self.parse_func() {
            ParseResultFunc::Ok(func) => {
                if func.name == "forward" {
                    forward = func;
                    has_forward = true;
                }
            }
            ParseResultFunc::Err(e) => { return ParseResultLayerDef::Err(e); }
        }
    } else {
        var fname: str = "";
        match self.expect_ident_or_keyword() {
            ParseResultStr::Ok(s) => { fname = s; }
            ParseResultStr::Err(e) => { return ParseResultLayerDef::Err(e); }
        }
        match self.expect(TokenKind::Colon, ":") {
            ParseResultUnit::Err(e) => { return ParseResultLayerDef::Err(e); }
            ParseResultUnit::Ok => {}
        }
        var fty: Type = Type::Void;
        match self.parse_type() {
            ParseResultType::Ok(t) => { fty = t; }
            ParseResultType::Err(e) => { return ParseResultLayerDef::Err(e); }
        }
        fields.push(Param_new(fname, fty, false));
        self.match_tok(TokenKind::Comma);
    }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultLayerDef::Err(e); }
    ParseResultUnit::Ok => {}
}

if !has_forward {
    return ParseResultLayerDef::Err("Layer '" + name + "' must have a 'forward' method");
}

self.struct_names.push(name);
HashMap_insert(self.struct_name_set, name, 1);
var __ret_LayerDef: LayerDef = LayerDef_new(name, forward, false);
__ret_LayerDef.fields = fields;
__ret_LayerDef.constructor_args = constructor_args;
return ParseResultLayerDef::Ok(__ret_LayerDef);
}

fn parse_model(self: &mut Parser) -> ParseResultModelDef {
match self.expect(TokenKind::Model, "model") {
    ParseResultUnit::Err(e) => { return ParseResultModelDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var name: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { name = s; }
    ParseResultStr::Err(e) => { return ParseResultModelDef::Err(e); }
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultModelDef::Err(e); }
    ParseResultUnit::Ok => {}
}

var layers: Vec<LayerInst> = Vec::new();
var forward: Func = Func_new("", Type::Void);
var has_forward: bool = false;
var has_forward: bool = false;

while !self.check(TokenKind::RBrace) && !self.is_at_end() {
    if self.check(TokenKind::Fn) {
        match self.parse_func() {
            ParseResultFunc::Ok(func) => {
                if func.name == "forward" {
                    forward = func;
                    has_forward = true;
                }
            }
            ParseResultFunc::Err(e) => { return ParseResultModelDef::Err(e); }
        }
    } else {
        var field_name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => { field_name = s; }
            ParseResultStr::Err(e) => { return ParseResultModelDef::Err(e); }
        }
        match self.expect(TokenKind::Colon, ":") {
            ParseResultUnit::Err(e) => { return ParseResultModelDef::Err(e); }
            ParseResultUnit::Ok => {}
        }
        var layer_type: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => { layer_type = s; }
            ParseResultStr::Err(e) => { return ParseResultModelDef::Err(e); }
        }
        var ctor_args: Vec<str> = Vec::new();
        if self.match_tok(TokenKind::LParen) {
            if !self.check(TokenKind::RParen) {
                loop {
                    match self.parse_annotation_arg() {
                        ParseResultStr::Ok(arg) => { ctor_args.push(arg); }
                        ParseResultStr::Err(e) => { return ParseResultModelDef::Err(e); }
                    }
                    if !self.match_tok(TokenKind::Comma) { break; }
                }
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => { return ParseResultModelDef::Err(e); }
                ParseResultUnit::Ok => {}
            }
        }
        self.match_tok(TokenKind::Comma);
        layers.push(LayerInst_new(field_name, layer_type, ctor_args));
    }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultModelDef::Err(e); }
    ParseResultUnit::Ok => {}
}

if !has_forward {
    return ParseResultModelDef::Err("Model '" + name + "' must have a 'forward' method");
}

self.struct_names.push(name);
HashMap_insert(self.struct_name_set, name, 1);
var __ret_ModelDef: ModelDef = ModelDef_new(name, layers, forward, false);
return ParseResultModelDef::Ok(__ret_ModelDef);
}

