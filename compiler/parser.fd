// parser.fd -- Fides parser, SH-7.3 rewrite of src/parser.rs (3433 LOC Rust)
//
// Recursive-descent parser that transforms a Vec<Token> token stream into an
// AST (Program). Handles: all expressions, statements, types, declarations,
// attributes, annotations, f-strings, inline asm, ML/game-architecture decls.
//
// Error handling: Fides has no `?` operator, so we use a custom ParseResult
// enum (like json.fd's JsonResult) and explicit pattern matching to propagate
// errors. Each parse_* function returns ParseResult.
//
// Adaptations from Rust:
// 1. `Result<T, String>` -> `ParseResult<T>` (custom enum, no `?` operator).
// 2. `std::mem::discriminant` -> `token_kind_eq` (from compiler::token).
// 3. `format!` -> string concatenation with `+` and int_to_str/float_to_str.
// 4. `Option<T>` -> Opt* enums from compiler::ast, or `-1`/`""` sentinels.
// 5. Macros (reduce_one!, peek_bin_op!) -> helper functions.
// 6. `peek()` returns `&TokenKind` in Rust; here we return a copy (TokenKind
//    is an enum, copied by value in Fides).
//
// Dependencies: compiler::token, compiler::ast, compiler::lexer (for f-strings)

module compiler::parser;
use vec;
use core;
use compiler::token;
use compiler::ast;
use compiler::lexer;
// --- ParseResult ---------------------------------------------------------
// Custom Result enum for parse functions. Fides has no `?` operator, so
// callers must pattern-match to extract the value or propagate the error.
// Usage:
//   match self.parse_expr() {
//       ParseResultExpr::Ok(e) => { ... use e ... }
//       ParseResultExpr::Err(msg) => { return ParseResultExpr::Err(msg); }
//   }

pub enum ParseResultExpr {
    Ok(Expr),
    Err(str),
}

pub enum ParseResultExprs {
    Ok(Vec<Expr>),
    Err(str),
}

pub enum ParseResultStmt {
    Ok(Stmt),
    Err(str),
}

pub enum ParseResultStmts {
    Ok(Vec<Stmt>),
    Err(str),
}

pub enum ParseResultType {
    Ok(Type),
    Err(str),
}

/// LG8: a synthetic binding for a nested pattern position. `Ok(x)` in
/// `Some(Ok(x))` records ("__np0", Ok(x)-pattern); the match arm's
/// desugar turns it into an inner match on __np0.
pub struct PatNest {
    pub name: str,
    pub pat: Pattern,
}

pub enum ParseResultPattern {
    Ok(Pattern),
    Err(str),
}

pub enum ParseResultStr {
    Ok(str),
    Err(str),
}

pub enum ParseResultFunc {
    Ok(Func),
    Err(str),
}

pub enum ParseResultStructDef {
    Ok(StructDef),
    Err(str),
}

pub enum ParseResultEnumDef {
    Ok(EnumDef),
    Err(str),
}

pub enum ParseResultConstDef {
    Ok(ConstDef),
    Err(str),
}

pub enum ParseResultGlobalVar {
    Ok(GlobalVar),
    Err(str),
}

pub enum ParseResultTypeAlias {
    Ok(TypeAlias),
    Err(str),
}

pub enum ParseResultTraitDef {
    Ok(TraitDef),
    Err(str),
}

pub enum ParseResultImportDef {
    Ok(ImportDef),
    Err(str),
}

pub enum ParseResultAttribute {
    Ok(Attribute),
    Err(str),
}

pub enum ParseResultAnnotation {
    Ok(Annotation),
    Err(str),
}

pub enum ParseResultParams {
    Ok(Vec<Param>),
    Err(str),
}

pub enum ParseResultLayerDef {
    Ok(LayerDef),
    Err(str),
}

pub enum ParseResultModelDef {
    Ok(ModelDef),
    Err(str),
}

pub enum ParseResultComponentDef {
    Ok(ComponentDef),
    Err(str),
}

pub enum ParseResultSystemDef {
    Ok(SystemDef),
    Err(str),
}

pub enum ParseResultStateMachineDef {
    Ok(StateMachineDef),
    Err(str),
}

pub enum ParseResultEventHandlerDef {
    Ok(EventHandlerDef),
    Err(str),
}

pub enum ParseResultExternDecl {
    Ok(ExternDecl),
    Err(str),
}

pub enum ParseResultMatchArms {
    Ok(Vec<MatchArm>),
    Err(str),
}

pub enum ParseResultProgram {
    Ok(Program),
    Err(str),
}

pub enum ParseResultUnit {
    Ok,
    Err(str),
}

// --- ImplOrTrait helper --------------------------------------------------
// Rust uses an internal enum to distinguish impl blocks. We use a tag.
pub struct ImplOrTrait {
    pub tag: i64,
    // 0 = StructImpl, 1 = TraitImpl
    pub struct_impl: ImplDef,
    pub trait_impl: TraitImpl,
}

pub enum ParseResultImplOrTrait {
    Ok(ImplOrTrait),
    Err(str),
}

// --- IfExpr helper -------------------------------------------------------
pub struct IfExpr {
    pub cond: Expr,
    pub then_block: Vec<Stmt>,
    pub else_block: OptStmts,
}

// --- OpEntry for iterative parser ----------------------------------------
pub enum OpEntry {
    Op(BinOp, i64),
    Paren,
}

// --- Parser --------------------------------------------------------------

// The names modules are imported under, for `module::name()`, and each
// `module::name` called so far
var g_import_set: i64 = HashMap_new();
// SP9: the names of g_import_set, in the order they went in (parse_use
// adds a name only through pd_import_add, which keeps the two in step)
var g_import_list: Vec<str> = Vec::new();
var g_qualified_calls: Vec<str> = Vec::new();
// LG15: the headers imported with @import: import path -> 1, or 3 when
// marked `trusted` (compiler.fd's import loop reads it)
var g_at_imports: i64 = HashMap_new();

pub fn at_import_flags(path: str) -> i64 {
    return HashMap_get(g_at_imports, path);
}

// The type arguments of each turbofish call `name::<T, U>(args)` (proposal
// 0002), as Type::Generic("", [T, U]). The call is parsed as a call of
// `name::<#k>`, k its index here; the turbofish pass (mono.fd) instantiates
// `name` with them before type checking.
var g_turbofish_types: Vec<Type> = Vec::new();
/// Numbers the locals of called call results: `f(1)(5)` and
/// `fs.get(1)(5)` parse as `{ val __pcall_k = f(1); __pcall_k(5) }`
/// (stdlib-agent-bugs 38; parse_postfix).
var g_pd_pcall_n: i64 = 0;
/// Every turbofish call's type arguments, by number.
pub fn turbofish_all() -> Vec<Type> {
    return g_turbofish_types;
}

/// The type arguments of the turbofish call numbered `k`.
pub fn turbofish_types(k: i64) -> Vec<Type> {
    var out: Vec<Type> = Vec::new();
    if k < 0 || k >= g_turbofish_types.len() {
        return out;
    }
    match g_turbofish_types.get(k) {
        Type::Generic(_, targs) => {
            return targs;
        }
        _ => {
        }
    }
    return out;
}

pub fn str_vec_has(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The last `::` segment of a path.
pub fn path_last(path: str) -> str {
    var at: i64 = str_len(path) - 1;
    while at > 0 {
        if str_byte_at(path, at) == 58 && str_byte_at(path, at - 1) == 58 {
            return str_slice(path, at + 1, str_len(path));
        }
        at = at - 1;
    }
    return path;
}

/// The `module::name` calls parsed since the last time this was called.
pub fn take_qualified_calls() -> Vec<str> {
    var calls: Vec<str> = g_qualified_calls;
    g_qualified_calls = Vec::new();
    return calls;
}

// --- SP9: parses on worker threads -------------------------------------------
// A Parser made by Parser_side changes none of the globals above: what its
// parse adds to them is kept in the Parser (own_side, side_*), read out
// with parser_side_of, and applied here by parser_side_apply when the
// import driver uses that parse (compiler.fd pp_take), so the globals end
// as a parse on this thread would have left them. Turbofish calls and
// `__pcall_k` locals are numbered from 0 there: parser_side_fits says
// whether those numbers are the ones a parse here would give.

/// Put `name` in the import set (parse_use does, for `use a::name;`).
pub fn parser_import_add(name: str) {
    if HashMap_get(g_import_set, name) == 0 {
        HashMap_insert(g_import_set, name, 1);
        g_import_list.push(name);
    }
}

/// How many `__pcall_k` locals have been numbered.
pub fn parser_pcall_count() -> i64 {
    return g_pd_pcall_n;
}

/// The `module::name` calls parsed since take_qualified_calls last took
/// them (still there).
pub fn parser_qualified_calls() -> Vec<str> {
    return g_qualified_calls;
}

/// Whether `name` is in the import set.
pub fn parser_import_known(name: str) -> bool {
    return HashMap_get(g_import_set, name) != 0;
}

/// The names in the import set, in the order they went in.
pub fn parser_import_names() -> Vec<str> {
    return g_import_list;
}

/// What a parse on a worker thread changed besides its Program.
pub struct ParseSide {
    // names it added to the import set (none it already had), in order
    pub import_adds: Vec<str>,
    // its `module::name` calls, in order
    pub qcalls: Vec<str>,
    // the @import headers: path and flags, in order
    pub at_paths: Vec<str>,
    pub at_flags: Vec<i64>,
    // the type arguments of the turbofish calls it numbered from 0
    pub turbofish: Vec<Type>,
    // how many `__pcall_k` locals it numbered from 0
    pub pcalls: i64,
    pub secret: bool,
    pub splice: bool,
}

pub fn ParseSide_empty() -> ParseSide {
    return ParseSide {
        import_adds: Vec::new(), qcalls: Vec::new(), at_paths: Vec::new(), at_flags: Vec::new(), turbofish: Vec::new(), pcalls: 0, secret: false, splice: false
    };
}

/// A Parser for a worker thread: as Parser_with_names, with `imports` the
/// import set it starts from (a map of its own), a keyword cache of its own
/// for the f-strings it lexes, and every change besides its Program kept
/// in it. parser_side_free frees its maps.
pub fn Parser_side(tokens: Vec<Token>, struct_names: Vec<str>, enum_names: Vec<str>, imports: Vec<str>) -> Parser {
    var p: Parser = Parser_with_names(tokens, struct_names, enum_names);
    p.own_side = true;
    p.own_kw = HashMap_new();
    p.side_imports = HashMap_new();
    var i: i64 = 0;
    while i < imports.len() {
        HashMap_insert(p.side_imports, imports.get(i), 1);
        i = i + 1;
    }
    return p;
}

/// What the parse of `p` (a Parser_side) changed besides its Program.
pub fn parser_side_of(p: Parser) -> ParseSide {
    return ParseSide {
        import_adds: p.side_import_adds, qcalls: p.side_qcalls, at_paths: p.side_at_paths, at_flags: p.side_at_flags, turbofish: p.side_turbofish, pcalls: p.side_pcalls, secret: p.side_secret, splice: p.side_splice
    };
}

/// Free the maps of a Parser_side (after parser_side_of).
pub fn parser_side_free(p: &mut Parser) {
    if p.own_kw != 0 {
        HashMap_drop(p.own_kw);
        p.own_kw = 0;
    }
    if p.side_imports != 0 {
        HashMap_drop(p.side_imports);
        p.side_imports = 0;
    }
}

/// Whether a parse that numbered from 0 gave the numbers a parse here
/// would: it numbered no turbofish call (no `__pcall_k` local), or none has
/// been numbered here yet.
pub fn parser_side_fits(sd: ParseSide) -> bool {
    if sd.turbofish.len() > 0 && g_turbofish_types.len() > 0 {
        return false;
    }
    if sd.pcalls > 0 && g_pd_pcall_n > 0 {
        return false;
    }
    return true;
}

/// Leave the globals as the parse `sd` came from would have, run here.
pub fn parser_side_apply(sd: ParseSide) {
    var i: i64 = 0;
    while i < sd.import_adds.len() {
        parser_import_add(sd.import_adds.get(i));
        i = i + 1;
    }
    i = 0;
    while i < sd.qcalls.len() {
        g_qualified_calls.push(sd.qcalls.get(i));
        i = i + 1;
    }
    i = 0;
    while i < sd.at_paths.len() {
        HashMap_insert(g_at_imports, sd.at_paths.get(i), sd.at_flags.get(i));
        i = i + 1;
    }
    i = 0;
    while i < sd.turbofish.len() {
        g_turbofish_types.push(sd.turbofish.get(i));
        i = i + 1;
    }
    g_pd_pcall_n = g_pd_pcall_n + sd.pcalls;
    if sd.secret {
        g_saw_secret = true;
    }
    if sd.splice {
        g_saw_splice = true;
    }
}

/// 0008: every var declared Vec<E..> (sequential), across all parse calls —
/// the lowerer reads this to route their Vec method calls to VecV_*
pub var g_pd_sequential_vars: Vec<str> = Vec::new();

pub struct Parser {
    pub tokens: Vec<Token>,
    pub pos: i64,
    pub struct_names: Vec<str>,
    pub enum_names: Vec<str>,
    pub struct_name_set: i64,
    // HashMap for O(1) lookup
    pub enum_name_set: i64,
    // HashMap for O(1) lookup
    pub alias_set: i64,
    // HashMap: type alias -> struct target (CS8)
    pub errors: Vec<str>,
    pub expr_depth: i64,
    pub max_expr_depth: i64,
    // F1 (VF3): nesting of brackets, blocks and prefix operators (parse_unary,
    // parse_block); past 256 levels "nested too deeply" (nest_hit: reported)
    pub nest_depth: i64,
    pub nest_hit: bool,
    // LG3: every lifetime name parse_type consumed (`&'a T`), in order; a
    // signature reads the ones each parameter's and the result's type added
    pub lt_seen: Vec<str>,
    // `comptime T: type` parameters (reference.md §4.11): parse_params
    // collects their names here; the fn parser moves them into the
    // function's type parameters (inference or `f::<T>(..)` fills them, as
    // any type parameter), and every other params context rejects them.
    pub p_ct_type_params: Vec<str>,
    // 0008: the last parse_type saw a Vec<E..> (the .. variant marker)
    pub g_sequential_type: bool,
    // SP9: the scratch of one parse (module globals before, g_pd_*: a parse
    // on another thread would have shared them). L8H: the self type
    // parse_impl_or_trait_impl read last (none: the bare name), and the
    // self type of each impl of the file, at its index (Void: none); the
    // same for trait impls (their `for` type).
    pub pd_last_impl_self: Vec<Type>,
    pub pd_impl_selfs: Vec<Type>,
    pub pd_last_timpl_self: Vec<Type>,
    pub pd_timpl_selfs: Vec<Type>,
    // LG3: the lifetimes `impl<'a> View<'a>` declares, which its methods may
    // use without declaring them again (parse_func); empty outside an impl
    pub pd_impl_lts: Vec<str>,
    // SP9: own_side: a parse on a worker thread (compiler.fd "parsed
    // ahead"). What a parse changes besides its Program then goes here, not
    // into the parser's globals (another thread's): the import set it reads
    // and adds to (side_imports, a HashMap of its own; side_import_adds the
    // names it added, in order), the `module::name` calls (side_qcalls),
    // the @import headers, the turbofish calls it numbered from 0
    // (side_turbofish), the `__pcall_k` locals it numbered from 0
    // (side_pcalls), whether it saw @secret / a splice. own_kw: the keyword
    // cache of the f-string lexers (lexer.fd keyword_or_ident_own; 0: the
    // shared one).
    pub own_side: bool,
    pub own_kw: i64,
    pub side_imports: i64,
    pub side_import_adds: Vec<str>,
    pub side_qcalls: Vec<str>,
    pub side_at_paths: Vec<str>,
    pub side_at_flags: Vec<i64>,
    pub side_turbofish: Vec<Type>,
    pub side_pcalls: i64,
    pub side_secret: bool,
    pub side_splice: bool,
}

/// SP9: a Parser over `tokens` knowing these struct and enum names (sn_set
/// and en_set: the same names as HashMaps), every other field as a new
/// parse starts. Parser_new, Parser::new and Parser_with_names all make
/// theirs here.
pub fn pd_parser_make(tokens: Vec<Token>, sn: Vec<str>, en: Vec<str>, sn_set: i64, en_set: i64) -> Parser {
    return Parser {
        tokens: tokens, pos: 0, struct_names: sn, enum_names: en, struct_name_set: sn_set, enum_name_set: en_set, alias_set: HashMap_new(), errors: Vec::new(), expr_depth: 0, max_expr_depth: 256, nest_depth: 0, nest_hit: false, lt_seen: Vec::new(), p_ct_type_params: Vec::new(), g_sequential_type: false,
        pd_last_impl_self: Vec::new(), pd_impl_selfs: Vec::new(), pd_last_timpl_self: Vec::new(), pd_timpl_selfs: Vec::new(), pd_impl_lts: Vec::new(),
        own_side: false, own_kw: 0, side_imports: 0, side_import_adds: Vec::new(), side_qcalls: Vec::new(), side_at_paths: Vec::new(), side_at_flags: Vec::new(), side_turbofish: Vec::new(), side_pcalls: 0, side_secret: false, side_splice: false,
    };
}

pub fn Parser_new(tokens: Vec<Token>) -> Parser {
    var sn: Vec<str> = Vec::new();
    // AST structs
    sn.push("Annotation");
    sn.push("AsmOperand");
    sn.push("AssocTypeBinding");
    sn.push("AssocTypeDecl");
    sn.push("Attribute");
    sn.push("Binding");
    sn.push("ComponentDef");
    sn.push("ConstDef");
    sn.push("EffectHandler");
    sn.push("EnumDef");
    sn.push("EnumVariant");
    sn.push("EventHandlerDef");
    sn.push("ExternDecl");
    sn.push("FieldInit");
    sn.push("Func");
    sn.push("ImplDef");
    sn.push("ImportDef");
    sn.push("LayerDef");
    sn.push("LayerInst");
    sn.push("MatchArm");
    sn.push("ModelDef");
    sn.push("Param");
    sn.push("Program");
    sn.push("SelectCase");
    sn.push("StateDef");
    sn.push("StateMachineDef");
    sn.push("StateTransition");
    sn.push("StrPair");
    sn.push("StructDef");
    sn.push("SystemDef");
    sn.push("TraitDef");
    sn.push("TraitImpl");
    sn.push("TraitMethod");
    sn.push("TypeAlias");
    // Token struct
    sn.push("Token");
    // Lexer struct
    sn.push("Lexer");
    // Parser struct (self-reference for struct literals)
    sn.push("Parser");

    var en: Vec<str> = Vec::new();
    en.push("AsmDir");
    en.push("AssignOp");
    en.push("BinOp");
    en.push("Expr");
    en.push("FStringPart");
    en.push("OptBoxExpr");
    en.push("OptFunc");
    en.push("OptI");
    en.push("OptParams");
    en.push("OptStmts");
    en.push("OptStr");
    en.push("OptType");
    en.push("Pattern");
    en.push("ReflectOp");
    en.push("ShapeDim");
    en.push("Stmt");
    en.push("Type");
    en.push("UnaryOp");
    // TokenKind enum
    en.push("TokenKind");

    // Build HashMaps for O(1) name lookup (string interning)
    var sn_set: i64 = HashMap_new();
    var si: i64 = 0;
    while si < sn.len() {
        HashMap_insert(sn_set, sn.get(si), 1);
        si = si + 1;
    }
    var en_set: i64 = HashMap_new();
    var ei: i64 = 0;
    while ei < en.len() {
        HashMap_insert(en_set, en.get(ei), 1);
        ei = ei + 1;
    }

    return pd_parser_make(tokens, sn, en, sn_set, en_set);
}

impl Parser {
    pub fn new(tokens: Vec<Token>) -> Parser {
        var sn: Vec<str> = Vec::new();
        sn.push("Annotation");
        sn.push("AsmOperand");
        sn.push("AssocTypeBinding");
        sn.push("AssocTypeDecl");
        sn.push("Attribute");
        sn.push("Binding");
        sn.push("ComponentDef");
        sn.push("ConstDef");
        sn.push("EffectHandler");
        sn.push("EnumDef");
        sn.push("EnumVariant");
        sn.push("EventHandlerDef");
        sn.push("ExternDecl");
        sn.push("FieldInit");
        sn.push("Func");
        sn.push("ImplDef");
        sn.push("ImportDef");
        sn.push("LayerDef");
        sn.push("LayerInst");
        sn.push("MatchArm");
        sn.push("ModelDef");
        sn.push("Param");
        sn.push("Program");
        sn.push("SelectCase");
        sn.push("StateDef");
        sn.push("StateMachineDef");
        sn.push("StateTransition");
        sn.push("StrPair");
        sn.push("StructDef");
        sn.push("SystemDef");
        sn.push("TraitDef");
        sn.push("TraitImpl");
        sn.push("TraitMethod");
        sn.push("TypeAlias");
        sn.push("Token");
        sn.push("Lexer");
        sn.push("Parser");
        var en: Vec<str> = Vec::new();
        en.push("AsmDir");
        en.push("AssignOp");
        en.push("BinOp");
        en.push("Expr");
        en.push("FStringPart");
        en.push("OptBoxExpr");
        en.push("OptFunc");
        en.push("OptI");
        en.push("OptParams");
        en.push("OptStmts");
        en.push("OptStr");
        en.push("OptType");
        en.push("Pattern");
        en.push("ReflectOp");
        en.push("ShapeDim");
        en.push("Stmt");
        en.push("Type");
        en.push("UnaryOp");
        en.push("TokenKind");
        var sn_set: i64 = HashMap_new();
        var si: i64 = 0;
        while si < sn.len() {
            HashMap_insert(sn_set, sn.get(si), 1);
            si = si + 1;
        }
        var en_set: i64 = HashMap_new();
        var ei: i64 = 0;
        while ei < en.len() {
            HashMap_insert(en_set, en.get(ei), 1);
            ei = ei + 1;
        }
        return pd_parser_make(tokens, sn, en, sn_set, en_set);
    }
    fn peek(self: &Parser) -> TokenKind {
        return self.tokens.get(self.pos).kind;
    }

    fn peek_token(self: &Parser) -> Token {
        return self.tokens.get(self.pos);
    }

    fn advance(self: &mut Parser) -> Token {
        var tok: Token = self.tokens.get(self.pos);
        if !token_kind_eq(tok.kind, TokenKind::Eof) {
            self.pos = self.pos + 1;
        }
        return tok;
    }

    fn is_at_end(self: &Parser) -> bool {
        return token_kind_eq(self.peek(), TokenKind::Eof);
    }

    fn check(self: &Parser, kind: TokenKind) -> bool {
        return token_kind_eq(self.peek(), kind);
    }

    fn match_tok(self: &mut Parser, kind: TokenKind) -> bool {
        if self.check(kind) {
            self.advance();
            return true;
        }
        return false;
    }

    fn recover_to_sync_token(self: &mut Parser) {
        while !self.is_at_end() {
            var k: TokenKind = self.peek();
            if token_kind_eq(k, TokenKind::Semicolon) {
                self.advance();
                return;
            }
            if token_kind_eq(k, TokenKind::RBrace) {
                return;
            }
            if token_kind_eq(k, TokenKind::Fn) {
                return;
            }
            if token_kind_eq(k, TokenKind::Pub) {
                return;
            }
            if token_kind_eq(k, TokenKind::Struct) {
                return;
            }
            if token_kind_eq(k, TokenKind::Enum) {
                return;
            }
            if token_kind_eq(k, TokenKind::Impl) {
                return;
            }
            if token_kind_eq(k, TokenKind::Use) {
                return;
            }
            self.advance();
        }

    }
    // R1.5: split a compound token starting with `>` so a generic list can close
    // on its first char: `>>` -> `>`, `>>=` -> `>=`, `>=` -> `=`. Returns false if
    // the current token does not start with `>`.
    fn split_gt(self: &mut Parser) -> bool {
        var tok: Token = self.peek_token();
        var rest: TokenKind = TokenKind::Eof;
        if token_kind_eq(tok.kind, TokenKind::Shr) {
            rest = TokenKind::Gt;
        } else if token_kind_eq(tok.kind, TokenKind::ShrEq) {
            rest = TokenKind::GtEq;
        } else if token_kind_eq(tok.kind, TokenKind::GtEq) {
            rest = TokenKind::Eq;
        } else {
            return false;
        }
        self.tokens.set(self.pos, token_new(rest, tok.line, tok.col + 1));
        return true;
    }

    fn expect(self: &mut Parser, kind: TokenKind, msg: str) -> ParseResultUnit {
        if self.check(kind) {
            self.advance();
            return ParseResultUnit::Ok;
        }
        if token_kind_eq(kind, TokenKind::Gt) {
            if self.split_gt() {
                return ParseResultUnit::Ok;
            }
        }
        var tok: Token = self.peek_token();
        return ParseResultUnit::Err("Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) + ": expected " + msg + " but got '" + token_kind_to_str(tok.kind) + "'\n    Fix: write " + msg + " here; often a `;`, `)` or `}` is missing just before this point");
    }

    fn expect_ident(self: &mut Parser) -> ParseResultStr {
        var tok: Token = self.peek_token();
        match tok.kind {
            TokenKind::Ident(s: str) => {
                self.advance();
                return ParseResultStr::Ok(s);
            }
            _ => {
            }
        }
        return ParseResultStr::Err(pd_expected_name_err(tok));
    }

    fn expect_ident_or_keyword(self: &mut Parser) -> ParseResultStr {
        var tok: Token = self.peek_token();
        match tok.kind {
            TokenKind::Ident(s: str) => {
                self.advance();
                return ParseResultStr::Ok(s);
            }
            _ => {
            }
        }
        if is_word_keyword(tok.kind) {
            var s: str = token_kind_to_str(tok.kind);
            self.advance();
            return ParseResultStr::Ok(s);
        }
        return ParseResultStr::Err(pd_expected_name_err(tok));
    }

    fn is_struct_name(self: &Parser, name: str) -> bool {
        // O(1) HashMap lookup (string interning optimization)
        if HashMap_get(self.struct_name_set, name) != 0 {
            return true;
        }
        // Check aliases
        if HashMap_get(self.alias_set, name) != 0 {
            return true;
        }
        return false;
    }

    fn is_enum_name(self: &Parser, name: str) -> bool {
        // O(1) HashMap lookup (string interning optimization)
        if HashMap_get(self.enum_name_set, name) != 0 {
            return true;
        }
        return false;
    }

    // --- SP9: what a parse changes besides its Program ---------------------
    // Each goes to the parser's globals, or, for a parse on a worker thread
    // (own_side), to this Parser's side_* fields: the import driver
    // (compiler.fd pp_take) applies those to the globals when it uses the
    // parse, as if the parse had run there.

    /// Whether `name` is a module imported so far (`use` names it).
    fn pd_import_known(self: &Parser, name: str) -> bool {
        if self.own_side {
            return HashMap_get(self.side_imports, name) != 0;
        }
        return HashMap_get(g_import_set, name) != 0;
    }

    fn pd_import_add(self: &mut Parser, name: str) {
        if self.own_side {
            if HashMap_get(self.side_imports, name) == 0 {
                HashMap_insert(self.side_imports, name, 1);
                self.side_import_adds.push(name);
            }
            return;
        }
        parser_import_add(name);
    }

    fn pd_qcall(self: &mut Parser, qcall: str) {
        if self.own_side {
            self.side_qcalls.push(qcall);
            return;
        }
        g_qualified_calls.push(qcall);
    }

    fn pd_note_at_import(self: &mut Parser, path: str, flags: i64) {
        if self.own_side {
            self.side_at_paths.push(path);
            self.side_at_flags.push(flags);
            return;
        }
        HashMap_insert(g_at_imports, path, flags);
    }

    /// The number of the turbofish call whose type arguments are `t`.
    fn pd_turbofish(self: &mut Parser, t: Type) -> i64 {
        if self.own_side {
            self.side_turbofish.push(t);
            return self.side_turbofish.len() - 1;
        }
        g_turbofish_types.push(t);
        return g_turbofish_types.len() - 1;
    }

    /// The number of the next `__pcall_k` local.
    fn pd_next_pcall(self: &mut Parser) -> i64 {
        if self.own_side {
            var sk: i64 = self.side_pcalls;
            self.side_pcalls = sk + 1;
            return sk;
        }
        var k: i64 = g_pd_pcall_n;
        g_pd_pcall_n = k + 1;
        return k;
    }

    fn pd_saw_secret(self: &mut Parser) {
        if self.own_side {
            self.side_secret = true;
            return;
        }
        g_saw_secret = true;
    }

    fn pd_saw_splice(self: &mut Parser) {
        if self.own_side {
            self.side_splice = true;
            return;
        }
        g_saw_splice = true;
    }

    fn read_type_name(self: &mut Parser) -> ParseResultStr {
        var tok: Token = self.peek_token();
        match tok.kind {
            TokenKind::Ident(s: str) => {
                self.advance();
                return ParseResultStr::Ok(s);
            }
            TokenKind::I8 => {
                self.advance();
                return ParseResultStr::Ok("i8");
            }
            TokenKind::I16 => {
                self.advance();
                return ParseResultStr::Ok("i16");
            }
            TokenKind::I32 => {
                self.advance();
                return ParseResultStr::Ok("i32");
            }
            TokenKind::I64 => {
                self.advance();
                return ParseResultStr::Ok("i64");
            }
            TokenKind::I128 => {
                self.advance();
                return ParseResultStr::Ok("i128");
            }
            TokenKind::U8 => {
                self.advance();
                return ParseResultStr::Ok("u8");
            }
            TokenKind::U16 => {
                self.advance();
                return ParseResultStr::Ok("u16");
            }
            TokenKind::U32 => {
                self.advance();
                return ParseResultStr::Ok("u32");
            }
            TokenKind::U64 => {
                self.advance();
                return ParseResultStr::Ok("u64");
            }
            TokenKind::U128 => {
                self.advance();
                return ParseResultStr::Ok("u128");
            }
            TokenKind::F32 => {
                self.advance();
                return ParseResultStr::Ok("f32");
            }
            TokenKind::F64 => {
                self.advance();
                return ParseResultStr::Ok("f64");
            }
            TokenKind::Bool => {
                self.advance();
                return ParseResultStr::Ok("bool");
            }
            TokenKind::Str => {
                self.advance();
                return ParseResultStr::Ok("str");
            }
            TokenKind::Void => {
                self.advance();
                return ParseResultStr::Ok("void");
            }
            _ => {
            }
        }
        return ParseResultStr::Err("Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) + ": expected type name but got '" + token_kind_to_str(tok.kind) + "'\n    Fix: name a type here, as in `i64`, `str` or `Point`");
    }

    pub fn parse(self: &mut Parser) -> ParseResultProgram {
        var program: Program = program_new();
        self.pd_impl_selfs = Vec::new();
        self.pd_timpl_selfs = Vec::new();

        while !self.is_at_end() {
            // CF1 (reference §1.10): a `;` after an item (`struct P { .. };`,
            // `fn f() { .. };`) is consumed
            if self.check(TokenKind::Semicolon) {
                self.advance();
                continue;
            }
            var is_pub: bool = false;
            if self.check(TokenKind::Pub) {
                self.advance();
                is_pub = true;
            }

            match self.parse_top_level_item(program, is_pub) {
                ParseResultUnit::Ok => {
                }
                ParseResultUnit::Err(e) => {
                    self.push_parse_error(e);
                    self.recover_to_sync_token();
                    if self.check(TokenKind::RBrace) {
                        self.advance();
                    }
                }
            }
        }

        if self.errors.len() > 0 {
            return ParseResultProgram::Err(vec_str_join(self.errors, "\n"));
        }
        // L8H: several definitions of a name, one generic: specializations
        pd_name_specializations(&mut program);
        // ... and methods of a narrower impl that a generic impl also has
        pd_impl_specializations(&mut program, self.pd_impl_selfs);
        // ... and a trait impl for a narrower type beside a generic one
        // (`impl Show for Wrap<i64>` with `impl<T> Show for Wrap<T>`): it
        // becomes a narrower impl of the struct whose methods specialize
        // the generic trait impl's (after pd_impl_specializations, so its
        // numbers `__spec<k>` follow those)
        val tspec_errs: Vec<str> = pd_trait_impl_specializations(&mut program, self.pd_timpl_selfs);
        if tspec_errs.len() > 0 {
            return ParseResultProgram::Err(vec_str_join(tspec_errs, "\n"));
        }
        return ParseResultProgram::Ok(program);
    }

    fn parse_top_level_item(self: &mut Parser, program: &mut Program, is_pub: bool) -> ParseResultUnit {
        var k: TokenKind = self.peek();

        if token_kind_eq(k, TokenKind::Module) {
            self.advance();
            var name: str = "";
            loop {
                match self.expect_ident_or_keyword() {
                    ParseResultStr::Ok(part) => {
                        name = name + part;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultUnit::Err(e);
                    }
                }
                if self.match_tok(TokenKind::DoubleColon) {
                    name = name + "::";
                } else {
                    break;
                }
            }
            self.match_tok(TokenKind::Semicolon);
            program.module = OptStr::Some(name);
            return ParseResultUnit::Ok;
        }

        if token_kind_eq(k, TokenKind::Struct) {
            match self.parse_struct() {
                ParseResultStructDef::Ok(s) => {
                    var ms = s;
                    ms.is_pub = is_pub;
                    program.structs.push(ms);
                    return ParseResultUnit::Ok;
                }
                ParseResultStructDef::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::Enum) {
            match self.parse_enum() {
                ParseResultEnumDef::Ok(e) => {
                    var me = e;
                    me.is_pub = is_pub;
                    program.enums.push(me);
                    return ParseResultUnit::Ok;
                }
                ParseResultEnumDef::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::Const) {
            match self.parse_const() {
                ParseResultConstDef::Ok(c) => {
                    var mc = c;
                    mc.is_pub = is_pub;
                    program.consts.push(mc);
                    return ParseResultUnit::Ok;
                }
                ParseResultConstDef::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        // reference §2.6/§2.7: a module-level item is `const` or `var`;
        // `val` exists only inside a function (bugs 9)
        if token_kind_eq(k, TokenKind::Val) {
            var vtok: Token = self.peek_token();
            var vname: str = "NAME";
            if self.pos + 1 < self.tokens.len() {
                match self.tokens.get(self.pos + 1).kind {
                    TokenKind::Ident(vn: str) => {
                        vname = vn;
                    }
                    _ => {
                    }
                }
            }
            return ParseResultUnit::Err("Parse error at " + int_to_str(vtok.line) + ":" + int_to_str(vtok.col) + ": `val` cannot declare a top-level item (reference §2.6, §2.7).\n    Fix: write `const " + vname + ": T = ...;` for a value fixed at compile time, or `var " + vname + ": T = ...;` for a global that is computed or changed.");
        }

        if token_kind_eq(k, TokenKind::Var) || token_kind_eq(k, TokenKind::Static) {
            match self.parse_global_var() {
                ParseResultGlobalVar::Ok(g) => {
                    var mg = g;
                    mg.is_pub = is_pub;
                    program.globals.push(mg);
                    return ParseResultUnit::Ok;
                }
                ParseResultGlobalVar::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::Type) {
            match self.parse_type_alias() {
                ParseResultTypeAlias::Ok(ta) => {
                    var mta = ta;
                    mta.is_pub = is_pub;
                    program.type_aliases.push(mta);
                    return ParseResultUnit::Ok;
                }
                ParseResultTypeAlias::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::Cap) {
            match self.parse_trait() {
                ParseResultTraitDef::Ok(t) => {
                    var mt = t;
                    mt.is_pub = is_pub;
                    program.traits.push(mt);
                    return ParseResultUnit::Ok;
                }
                ParseResultTraitDef::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::Impl) {
            match self.parse_impl_or_trait_impl() {
                ParseResultImplOrTrait::Ok(imp) => {
                    if imp.tag == 0 {
                        program.impls.push(imp.struct_impl);
                        // L8H: its self type, at the same index (Void: the
                        // bare name)
                        while self.pd_impl_selfs.len() < program.impls.len() - 1 {
                            self.pd_impl_selfs.push(Type::Void);
                        }
                        if self.pd_last_impl_self.len() > 0 {
                            self.pd_impl_selfs.push(self.pd_last_impl_self.get(0));
                        } else {
                            self.pd_impl_selfs.push(Type::Void);
                        }
                    } else {
                        program.trait_impls.push(imp.trait_impl);
                        // L8H: its `for` type, at the same index (Void: the
                        // bare name)
                        while self.pd_timpl_selfs.len() < program.trait_impls.len() - 1 {
                            self.pd_timpl_selfs.push(Type::Void);
                        }
                        if self.pd_last_timpl_self.len() > 0 {
                            self.pd_timpl_selfs.push(self.pd_last_timpl_self.get(0));
                        } else {
                            self.pd_timpl_selfs.push(Type::Void);
                        }
                    }
                    return ParseResultUnit::Ok;
                }
                ParseResultImplOrTrait::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::Use) {
            match self.parse_use() {
                ParseResultImportDef::Ok(imp) => {
                    var mimp = imp;
                    mimp.is_pub = is_pub;
                    program.imports.push(mimp);
                    return ParseResultUnit::Ok;
                }
                ParseResultImportDef::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::Hash) {
            match self.parse_attribute() {
                ParseResultAttribute::Ok(attr) => {
                    program.attributes.push(attr);
                    return ParseResultUnit::Ok;
                }
                ParseResultAttribute::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        // LG15: `@import("foo.h")` imports the C header as `use foo` does when
        // there is no foo.fd: bindings generated from the header
        if token_kind_eq(k, TokenKind::At) && self.pd_at_import() {
            match self.parse_at_import() {
                ParseResultImportDef::Ok(imp) => {
                    program.imports.push(imp);
                    return ParseResultUnit::Ok;
                }
                ParseResultImportDef::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::At) {
            var annotations: Vec<Annotation> = Vec::new();
            while self.check(TokenKind::At) {
                match self.parse_at_annotation() {
                    ParseResultAnnotation::Ok(a) => {
                        annotations.push(a);
                    }
                    ParseResultAnnotation::Err(e) => {
                        return ParseResultUnit::Err(e);
                    }
                }
            }
            var item_is_pub: bool = false;
            if self.check(TokenKind::Pub) {
                self.advance();
                item_is_pub = true;
            } else {
                item_is_pub = is_pub;
            }
            if self.check(TokenKind::Struct) {
                match self.parse_struct() {
                    ParseResultStructDef::Ok(sd) => {
                        var msd = sd;
                        msd.is_pub = item_is_pub;
                        // keep the ones parse_struct made (LG3 `@lifetime`)
                        var sa: i64 = 0;
                        while sa < sd.annotations.len() {
                            annotations.push(sd.annotations.get(sa));
                            sa = sa + 1;
                        }
                        msd.annotations = annotations;
                        program.structs.push(msd);
                        return ParseResultUnit::Ok;
                    }
                    ParseResultStructDef::Err(e) => {
                        return ParseResultUnit::Err(e);
                    }
                }
            } else {
                // `@ann async fn` (as `async fn` without annotations); the
                // checks of @redundant and @event reject it with a reason
                var ann_async: bool = false;
                if self.check(TokenKind::Async) {
                    self.advance();
                    ann_async = true;
                }
                match self.parse_func() {
                    ParseResultFunc::Ok(func) => {
                        var mfunc = func;
                        mfunc.is_pub = item_is_pub;
                        if ann_async {
                            mfunc.is_async = true;
                        }
                        // keep the ones parse_func made (LG3 `@lifetime`)
                        var fa: i64 = 0;
                        while fa < func.annotations.len() {
                            annotations.push(func.annotations.get(fa));
                            fa = fa + 1;
                        }
                        mfunc.annotations = annotations;
                        program.funcs.push(mfunc);
                        return ParseResultUnit::Ok;
                    }
                    ParseResultFunc::Err(e) => {
                        return ParseResultUnit::Err(e);
                    }
                }
            }
        }

        if token_kind_eq(k, TokenKind::Layer) {
            match self.parse_layer() {
                ParseResultLayerDef::Ok(l) => {
                    var ml = l;
                    ml.is_pub = is_pub;
                    program.layers.push(ml);
                    return ParseResultUnit::Ok;
                }
                ParseResultLayerDef::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::Model) {
            match self.parse_model() {
                ParseResultModelDef::Ok(m) => {
                    var mm = m;
                    mm.is_pub = is_pub;
                    program.models.push(mm);
                    return ParseResultUnit::Ok;
                }
                ParseResultModelDef::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::Component) {
            match self.parse_component() {
                ParseResultComponentDef::Ok(c) => {
                    var mc = c;
                    mc.is_pub = is_pub;
                    program.components.push(mc);
                    return ParseResultUnit::Ok;
                }
                ParseResultComponentDef::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::System) {
            match self.parse_system() {
                ParseResultSystemDef::Ok(s) => {
                    var ms = s;
                    ms.is_pub = is_pub;
                    program.systems.push(ms);
                    return ParseResultUnit::Ok;
                }
                ParseResultSystemDef::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::State) {
            match self.parse_state_machine() {
                ParseResultStateMachineDef::Ok(sm) => {
                    var msm = sm;
                    msm.is_pub = is_pub;
                    program.state_machines.push(msm);
                    return ParseResultUnit::Ok;
                }
                ParseResultStateMachineDef::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::On) {
            match self.parse_event_handler() {
                ParseResultEventHandlerDef::Ok(eh) => {
                    var meh = eh;
                    meh.is_pub = is_pub;
                    program.event_handlers.push(meh);
                    return ParseResultUnit::Ok;
                }
                ParseResultEventHandlerDef::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::Comptime) {
            self.advance();
            match self.parse_func() {
                ParseResultFunc::Ok(func) => {
                    var mfunc = func;
                    mfunc.is_pub = is_pub;
                    mfunc.is_comptime = true;
                    program.funcs.push(mfunc);
                    return ParseResultUnit::Ok;
                }
                ParseResultFunc::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::Interrupt) {
            self.advance();
            match self.parse_func() {
                ParseResultFunc::Ok(func) => {
                    var mfunc = func;
                    mfunc.is_pub = is_pub;
                    mfunc.is_interrupt = true;
                    program.funcs.push(mfunc);
                    return ParseResultUnit::Ok;
                }
                ParseResultFunc::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::Async) {
            self.advance();
            match self.parse_func() {
                ParseResultFunc::Ok(func) => {
                    var mfunc = func;
                    mfunc.is_pub = is_pub;
                    mfunc.is_async = true;
                    program.funcs.push(mfunc);
                    return ParseResultUnit::Ok;
                }
                ParseResultFunc::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        if token_kind_eq(k, TokenKind::Extern) {
            return self.parse_extern_block(program, is_pub);
        }

        // Default: parse as function
        match self.parse_func() {
            ParseResultFunc::Ok(func) => {
                var mfunc = func;
                mfunc.is_pub = is_pub;
                program.funcs.push(mfunc);
                return ParseResultUnit::Ok;
            }
            ParseResultFunc::Err(e) => {
                return ParseResultUnit::Err(e);
            }
        }

    }
    fn parse_extern_block(self: &mut Parser, program: &mut Program, _is_pub: bool) -> ParseResultUnit {
        self.advance();
        // consume extern
        var abi: str = "C";
        var tok: Token = self.peek_token();
        match tok.kind {
            TokenKind::StringLit(s: str) => {
                self.advance();
                abi = s;
            }
            _ => {
            }
        }

        var include: OptStr = OptStr::None;
        var link_lib: OptStr = OptStr::None;
        loop {
            var is_kw: bool = false;
            var ktok: Token = self.peek_token();
            match ktok.kind {
                TokenKind::Ident(kw: str) => {
                    if kw == "include" {
                        self.advance();
                        var stok: Token = self.peek_token();
                        match stok.kind {
                            TokenKind::StringLit(s: str) => {
                                self.advance();
                                include = OptStr::Some(s);
                                is_kw = true;
                            }
                            _ => {
                            }
                        }
                    } else if kw == "link" {
                        self.advance();
                        var stok: Token = self.peek_token();
                        match stok.kind {
                            TokenKind::StringLit(s: str) => {
                                self.advance();
                                link_lib = OptStr::Some(s);
                                is_kw = true;
                            }
                            _ => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
            if !is_kw {
                break;
            }
        }

        if self.check(TokenKind::LBrace) {
            self.advance();
            while !self.check(TokenKind::RBrace) && !self.is_at_end() {
                match self.expect(TokenKind::Fn, "fn") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultUnit::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                match self.parse_extern_func_decl(abi, include, link_lib) {
                    ParseResultExternDecl::Ok(decl) => {
                        program.extern_decls.push(decl);
                    }
                    ParseResultExternDecl::Err(e) => {
                        return ParseResultUnit::Err(e);
                    }
                }
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        } else {
            match self.expect(TokenKind::Fn, "fn") {
                ParseResultUnit::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            match self.parse_extern_func_decl(abi, include, link_lib) {
                ParseResultExternDecl::Ok(decl) => {
                    program.extern_decls.push(decl);
                }
                ParseResultExternDecl::Err(e) => {
                    return ParseResultUnit::Err(e);
                }
            }
        }

        return ParseResultUnit::Ok;
    }

    fn parse_struct(self: &mut Parser) -> ParseResultStructDef {
        match self.expect(TokenKind::Struct, "struct") {
            ParseResultUnit::Err(e) => {
                return ParseResultStructDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultStructDef::Err(e);
            }
        }

        var type_params: Vec<str> = Vec::new();
        // LG3: lifetime parameters, `struct View<'a> { r: &'a i64 }`: the
        // struct may hold references (compiler/escape.fd)
        var struct_lts: Vec<str> = Vec::new();
        if self.check(TokenKind::Lt) {
            self.advance();
            if !self.check(TokenKind::Gt) {
                loop {
                    var s_lt: str = "";
                    match self.peek() {
                        TokenKind::Lifetime(sln: str) => {
                            s_lt = sln;
                        }
                        _ => {
                        }
                    }
                    if s_lt != "" {
                        self.advance();
                        if s_lt == "'static" {
                            var st_tok: Token = self.peek_token();
                            return ParseResultStructDef::Err("Parse error at " + int_to_str(st_tok.line) + ":" + int_to_str(st_tok.col) + ": 'static is not a lifetime parameter; declare a name, `struct " + name + "<'a>`\n    Fix: declare a named lifetime, as in `struct " + name + "<'a>`, and use it in the fields ('static needs no declaration)");
                        }
                        struct_lts.push(s_lt);
                        if !self.match_tok(TokenKind::Comma) {
                            break;
                        }
                        continue;
                    }
                    // L8A: a const parameter, `const N: usize` or `N: i64`:
                    // a type parameter whose argument is a number
                    // (`Matrix<i64, 3>`, the type `__const_3`)
                    if self.match_tok(TokenKind::Const) {
                    }
                    match self.expect_ident() {
                        ParseResultStr::Ok(tp) => {
                            type_params.push(tp);
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultStructDef::Err(e);
                        }
                    }
                    if self.match_tok(TokenKind::Colon) {
                        var sb_tok: Token = self.peek_token();
                        if is_int_type_keyword(sb_tok.kind) || pd_size_type_tok(sb_tok.kind) {
                            self.advance();
                        } else {
                            return ParseResultStructDef::Err("Parse error at " + int_to_str(sb_tok.line) + ":" + int_to_str(sb_tok.col) + ": expected an integer type (i64, usize, ...) after a struct's const parameter but got '" + token_kind_to_str(sb_tok.kind) + "'\n    Fix: give the const parameter an integer type, as in `struct Buf<const N: usize>`");
                        }
                    }
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::Gt, ">") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStructDef::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        }

        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStructDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        var fields: Vec<Param> = Vec::new();
        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            var is_pub: bool = false;
            if self.check(TokenKind::Pub) {
                self.advance();
                is_pub = true;
            }
            // Field annotations (§4.11): @secret, @zeroize, ... on a struct
            // field — what annotation reflection (field_annotations) reads
            // and the safety checks act on. As on a parameter.
            var field_annotations: Vec<Annotation> = Vec::new();
            while self.check(TokenKind::At) {
                match self.parse_at_annotation() {
                    ParseResultAnnotation::Ok(ann) => {
                        field_annotations.push(ann);
                    }
                    ParseResultAnnotation::Err(e) => {
                        return ParseResultStructDef::Err(e);
                    }
                }
            }
            var fname: str = "";
            match self.expect_ident_or_keyword() {
                ParseResultStr::Ok(s) => {
                    fname = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultStructDef::Err(e);
                }
            }
            match self.expect(TokenKind::Colon, ":") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStructDef::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var fty: Type = Type::Void;
            var f_lt_start: i64 = self.lt_seen.len();
            match self.parse_type() {
                ParseResultType::Ok(t) => {
                    fty = t;
                }
                ParseResultType::Err(e) => {
                    return ParseResultStructDef::Err(e);
                }
            }
            var field: Param = Param_new(fname, fty, is_pub);
            field.annotations = field_annotations;
            // LG3: a field's lifetimes are the struct's own
            var f_lts: Vec<str> = pd_lt_since(self.lt_seen, f_lt_start);
            var fli: i64 = 0;
            while fli < f_lts.len() {
                var flt: str = f_lts.get(fli);
                if flt != "'static" && !str_vec_contains(struct_lts, flt) {
                    var fl_tok: Token = self.peek_token();
                    return ParseResultStructDef::Err("Parse error at " + int_to_str(fl_tok.line) + ":" + int_to_str(fl_tok.col) + ": lifetime " + flt + " of field '" + fname + "' is not declared; write `struct " + name + "<" + flt + ">`\n    Fix: declare the lifetime on the struct as shown, or remove it from the field's type");
                }
                fli = fli + 1;
            }
            if f_lts.len() > 0 {
                field.annotations.push(Annotation_new("lifetime", f_lts));
            }
            // CL5: a default value, `port: i64 = 8080`, which a literal
            // ending in `..` gives every field it leaves out
            if self.match_tok(TokenKind::Eq) {
                match self.parse_expr() {
                    ParseResultExpr::Ok(dv) => {
                        field.has_default = true;
                        field.default_expr = dv;
                    }
                    ParseResultExpr::Err(e) => {
                        return ParseResultStructDef::Err(e);
                    }
                }
            }
            fields.push(field);
            self.match_tok(TokenKind::Comma);
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStructDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        self.struct_names.push(name);
        HashMap_insert(self.struct_name_set, name, 1);
        var __ret_StructDef: StructDef = StructDef_new(name, false);
        __ret_StructDef.fields = fields;
        __ret_StructDef.type_params = type_params;
        if struct_lts.len() > 0 {
            __ret_StructDef.annotations.push(Annotation_new("lifetime", struct_lts));
        }
        return ParseResultStructDef::Ok(__ret_StructDef);
    }

    fn parse_enum(self: &mut Parser) -> ParseResultEnumDef {
        match self.expect(TokenKind::Enum, "enum") {
            ParseResultUnit::Err(e) => {
                return ParseResultEnumDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultEnumDef::Err(e);
            }
        }

        var type_params: Vec<str> = Vec::new();
        if self.check(TokenKind::Lt) {
            self.advance();
            if !self.check(TokenKind::Gt) {
                loop {
                    match self.expect_ident() {
                        ParseResultStr::Ok(tp) => {
                            type_params.push(tp);
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultEnumDef::Err(e);
                        }
                    }
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::Gt, ">") {
                ParseResultUnit::Err(e) => {
                    return ParseResultEnumDef::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        }

        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultEnumDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        var variants: Vec<EnumVariant> = Vec::new();
        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            var vname: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => {
                    vname = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultEnumDef::Err(e);
                }
            }
            var data: OptParams = OptParams::None;
            if self.match_tok(TokenKind::LParen) {
                var params: Vec<Param> = Vec::new();
                if !self.check(TokenKind::RParen) {
                    loop {
                        // Check if named param: ident followed by colon
                        var pname_tok: Token = self.peek_token();
                        var is_named: bool = false;
                        match pname_tok.kind {
                            TokenKind::Ident(_: str) => {
                                // Peek next token for colon
                                if self.pos + 1 < self.tokens.len() {
                                    var next_tok: Token = self.tokens.get(self.pos + 1);
                                    if token_kind_eq(next_tok.kind, TokenKind::Colon) {
                                        is_named = true;
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                        if is_named {
                            var pname: str = "";
                            match self.expect_ident() {
                                ParseResultStr::Ok(s) => {
                                    pname = s;
                                }
                                ParseResultStr::Err(e) => {
                                    return ParseResultEnumDef::Err(e);
                                }
                            }
                            match self.expect(TokenKind::Colon, ":") {
                                ParseResultUnit::Err(e) => {
                                    return ParseResultEnumDef::Err(e);
                                }
                                ParseResultUnit::Ok => {
                                }
                            }
                            var pty: Type = Type::Void;
                            match self.parse_type() {
                                ParseResultType::Ok(t) => {
                                    pty = t;
                                }
                                ParseResultType::Err(e) => {
                                    return ParseResultEnumDef::Err(e);
                                }
                            }
                            params.push(Param_new(pname, pty, false));
                        } else {
                            var pty: Type = Type::Void;
                            match self.parse_type() {
                                ParseResultType::Ok(t) => {
                                    pty = t;
                                }
                                ParseResultType::Err(e) => {
                                    return ParseResultEnumDef::Err(e);
                                }
                            }
                            var pname: str = "_" + int_to_str(params.len());
                            params.push(Param_new(pname, pty, false));
                        }
                        if !self.match_tok(TokenKind::Comma) {
                            break;
                        }
                    }
                }
                match self.expect(TokenKind::RParen, ")") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultEnumDef::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                data = OptParams::Some(params);
            }
            variants.push(EnumVariant_new(vname, data));
            self.match_tok(TokenKind::Comma);
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultEnumDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        self.enum_names.push(name);
        HashMap_insert(self.enum_name_set, name, 1);
        var __ret_EnumDef: EnumDef = EnumDef_new(name, variants, false);
        __ret_EnumDef.type_params = type_params;
        return ParseResultEnumDef::Ok(__ret_EnumDef);
    }

    fn parse_const(self: &mut Parser) -> ParseResultConstDef {
        match self.expect(TokenKind::Const, "const") {
            ParseResultUnit::Err(e) => {
                return ParseResultConstDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultConstDef::Err(e);
            }
        }
        match self.expect(TokenKind::Colon, ":") {
            ParseResultUnit::Err(e) => {
                return ParseResultConstDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var ty: Type = Type::Void;
        match self.parse_type() {
            ParseResultType::Ok(t) => {
                ty = t;
            }
            ParseResultType::Err(e) => {
                return ParseResultConstDef::Err(e);
            }
        }
        match self.expect(TokenKind::Eq, "=") {
            ParseResultUnit::Err(e) => {
                return ParseResultConstDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var expr: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => {
                expr = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultConstDef::Err(e);
            }
        }
        self.match_tok(TokenKind::Semicolon);
        var __ret_ConstDef: ConstDef = ConstDef_new(name, ty, expr, false);
        return ParseResultConstDef::Ok(__ret_ConstDef);
    }

    // Parse a module-level mutable global variable:
    // `var name: Type = expr;` or `var name: Type;` (zero-initialized)
    fn parse_global_var(self: &mut Parser) -> ParseResultGlobalVar {
        // Accept either `var` or `static` (static is an alias for var).
        if !self.match_tok(TokenKind::Var) {
            match self.expect(TokenKind::Static, "var or static") {
                ParseResultUnit::Err(e) => {
                    return ParseResultGlobalVar::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        }
        var name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultGlobalVar::Err(e);
            }
        }
        match self.expect(TokenKind::Colon, ":") {
            ParseResultUnit::Err(e) => {
                return ParseResultGlobalVar::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var ty: Type = Type::Void;
        match self.parse_type() {
            ParseResultType::Ok(t) => {
                ty = t;
            }
            ParseResultType::Err(e) => {
                return ParseResultGlobalVar::Err(e);
            }
        }
        // Initializer is optional -- defaults to zero-value of the type
        var init: Expr = Expr::IntLit(0);
        if self.check(TokenKind::Eq) {
            self.advance();
            match self.parse_expr() {
                ParseResultExpr::Ok(e) => {
                    init = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultGlobalVar::Err(e);
                }
            }
        } else {
            // Zero-initializer: pick a sensible default per type
            match ty {
                Type::I64 => {
                    init = Expr::IntLit(0);
                }
                Type::I32 => {
                    init = Expr::IntLit(0);
                }
                Type::I16 => {
                    init = Expr::IntLit(0);
                }
                Type::I8 => {
                    init = Expr::IntLit(0);
                }
                Type::U64 => {
                    init = Expr::IntLit(0);
                }
                Type::U32 => {
                    init = Expr::IntLit(0);
                }
                Type::U16 => {
                    init = Expr::IntLit(0);
                }
                Type::U8 => {
                    init = Expr::IntLit(0);
                }
                Type::Bool => {
                    // a bool literal, so the BG262 initializer check sees
                    // a bool (an IntLit(0) here read as "i8 to bool")
                    init = Expr::BoolLit(false);
                }
                Type::F64 => {
                    init = Expr::FloatLit(0.0);
                }
                Type::F32 => {
                    init = Expr::FloatLit(0.0);
                }
                Type::Str => {
                    init = Expr::StringLit("");
                }
                _ => {
                    init = Expr::IntLit(0);
                }
            }
        }
        self.match_tok(TokenKind::Semicolon);
        var __ret_GlobalVar: GlobalVar = GlobalVar_new(name, ty, init, false);
        return ParseResultGlobalVar::Ok(__ret_GlobalVar);
    }

    fn parse_type_alias(self: &mut Parser) -> ParseResultTypeAlias {
        match self.expect(TokenKind::Type, "type") {
            ParseResultUnit::Err(e) => {
                return ParseResultTypeAlias::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultTypeAlias::Err(e);
            }
        }
        match self.expect(TokenKind::Eq, "=") {
            ParseResultUnit::Err(e) => {
                return ParseResultTypeAlias::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var alias_for: Type = Type::Void;
        match self.parse_type() {
            ParseResultType::Ok(t) => {
                alias_for = t;
            }
            ParseResultType::Err(e) => {
                return ParseResultTypeAlias::Err(e);
            }
        }
        self.match_tok(TokenKind::Semicolon);
        // If alias points to a named struct, track it
        match alias_for {
            Type::Named(target) => {
                if HashMap_get(self.struct_name_set, target) != 0 {
                    HashMap_insert(self.alias_set, name, 1);
                }
            }
            _ => {
            }
        }
        var __ret_TypeAlias: TypeAlias = TypeAlias_new(name, alias_for, false);
        return ParseResultTypeAlias::Ok(__ret_TypeAlias);
    }

    fn parse_impl_or_trait_impl(self: &mut Parser) -> ParseResultImplOrTrait {
        match self.expect(TokenKind::Impl, "impl") {
            ParseResultUnit::Err(e) => {
                return ParseResultImplOrTrait::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        var type_params: Vec<str> = Vec::new();
        // L8A: the impl's const parameters (`impl<T, const N: usize>
        // Matrix<T, N>`, or `N: i64`): each method sees N as a constant
        // (its const_params), which mono replaces by the receiver's number
        var impl_consts: Vec<StrPair> = Vec::new();
        self.pd_impl_lts = Vec::new();
        if self.check(TokenKind::Lt) {
            self.advance();
            if !self.check(TokenKind::Gt) {
                loop {
                    // LG3: `impl<'a> View<'a>`: a lifetime parameter names
                    // the struct's; the methods write their own
                    var impl_lt: bool = false;
                    match self.peek() {
                        TokenKind::Lifetime(_) => {
                            impl_lt = true;
                        }
                        _ => {
                        }
                    }
                    if impl_lt {
                        match self.peek() {
                            TokenKind::Lifetime(iltn: str) => {
                                self.pd_impl_lts.push(iltn);
                            }
                            _ => {
                            }
                        }
                        self.advance();
                        if !self.match_tok(TokenKind::Comma) {
                            break;
                        }
                        continue;
                    }
                    if self.match_tok(TokenKind::Const) {
                    }
                    var itp: str = "";
                    match self.expect_ident() {
                        ParseResultStr::Ok(tp) => {
                            itp = tp;
                            type_params.push(tp);
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultImplOrTrait::Err(e);
                        }
                    }
                    if self.match_tok(TokenKind::Colon) {
                        var ib_tok: Token = self.peek_token();
                        if is_int_type_keyword(ib_tok.kind) {
                            impl_consts.push(StrPair_new(itp, type_keyword_name(ib_tok.kind)));
                            self.advance();
                        } else if pd_size_type_tok(ib_tok.kind) {
                            impl_consts.push(StrPair_new(itp, "i64"));
                            self.advance();
                        } else {
                            return ParseResultImplOrTrait::Err("Parse error at " + int_to_str(ib_tok.line) + ":" + int_to_str(ib_tok.col) + ": expected an integer type (i64, usize, ...) after an impl's const parameter but got '" + token_kind_to_str(ib_tok.kind) + "'\n    Fix: give the const parameter an integer type, as in `impl<const N: usize> Buf<N>`");
                        }
                    }
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::Gt, ">") {
                ParseResultUnit::Err(e) => {
                    return ParseResultImplOrTrait::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        }

        var first_name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                first_name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultImplOrTrait::Err(e);
            }
        }
        // `impl<T> Slot<T>`: the type's arguments repeat the impl's parameters;
        // L8H: `impl Slot<i64>` (or `impl<U> Slot<Vec<U>>`) names narrower
        // ones, and its methods may specialize the generic impl's (the type
        // is kept for pd_impl_specializations)
        self.pd_last_impl_self = Vec::new();
        var tparsed: bool = false;
        if self.check(TokenKind::Lt) {
            val after_name: i64 = self.pos;
            self.pos = after_name - 1;
            match self.parse_type() {
                ParseResultType::Ok(st) => {
                    self.pd_last_impl_self.push(st);
                    tparsed = true;
                }
                ParseResultType::Err(_) => {
                    self.pos = after_name;
                }
            }
        }
        if self.check(TokenKind::Lt) && !tparsed {
            var tdepth: i64 = 0;
            var tscan: bool = true;
            while tscan {
                if self.check(TokenKind::Lt) {
                    tdepth = tdepth + 1;
                } else if self.check(TokenKind::Gt) {
                    tdepth = tdepth - 1;
                } else if self.check(TokenKind::Shr) {
                    tdepth = tdepth - 2;
                }
                self.advance();
                if tdepth <= 0 || self.is_at_end() {
                    tscan = false;
                }
            }
        }

        // Check for `impl Trait for Type`
        if self.match_tok(TokenKind::For) {
            var trait_name: str = first_name;
            var type_name: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => {
                    type_name = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultImplOrTrait::Err(e);
                }
            }
            // `impl<T> Show for Slot<T>`: the type's arguments repeat the impl's
            // parameters, as in `impl<T> Slot<T>` above; L8H: `impl Show for
            // Slot<i64>` names narrower ones (kept for
            // pd_trait_impl_specializations)
            self.pd_last_timpl_self = Vec::new();
            var fparsed: bool = false;
            if self.check(TokenKind::Lt) {
                val after_tname: i64 = self.pos;
                self.pos = after_tname - 1;
                match self.parse_type() {
                    ParseResultType::Ok(fst) => {
                        self.pd_last_timpl_self.push(fst);
                        fparsed = true;
                    }
                    ParseResultType::Err(_) => {
                        self.pos = after_tname;
                    }
                }
            }
            if self.check(TokenKind::Lt) && !fparsed {
                var fdepth: i64 = 0;
                var fscan: bool = true;
                while fscan {
                    if self.check(TokenKind::Lt) {
                        fdepth = fdepth + 1;
                    } else if self.check(TokenKind::Gt) {
                        fdepth = fdepth - 1;
                    } else if self.check(TokenKind::Shr) {
                        fdepth = fdepth - 2;
                    }
                    self.advance();
                    if fdepth <= 0 || self.is_at_end() {
                        fscan = false;
                    }
                }
            }
            match self.expect(TokenKind::LBrace, "{") {
                ParseResultUnit::Err(e) => {
                    return ParseResultImplOrTrait::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }

            var methods: Vec<Func> = Vec::new();
            var associated_types: Vec<AssocTypeBinding> = Vec::new();
            while !self.check(TokenKind::RBrace) && !self.is_at_end() {
                if self.check(TokenKind::Type) {
                    self.advance();
                    var assoc_name: str = "";
                    match self.expect_ident() {
                        ParseResultStr::Ok(s) => {
                            assoc_name = s;
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultImplOrTrait::Err(e);
                        }
                    }
                    // Optional GAT type params
                    if self.check(TokenKind::Lt) {
                        self.advance();
                        if !self.check(TokenKind::Gt) {
                            loop {
                                match self.expect_ident() {
                                    ParseResultStr::Ok(_) => {
                                    }
                                    ParseResultStr::Err(e) => {
                                        return ParseResultImplOrTrait::Err(e);
                                    }
                                }
                                if !self.match_tok(TokenKind::Comma) {
                                    break;
                                }
                                if self.check(TokenKind::Gt) {
                                    break;
                                }
                            }
                        }
                        match self.expect(TokenKind::Gt, ">") {
                            ParseResultUnit::Err(e) => {
                                return ParseResultImplOrTrait::Err(e);
                            }
                            ParseResultUnit::Ok => {
                            }
                        }
                    }
                    match self.expect(TokenKind::Eq, "=") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultImplOrTrait::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    var assoc_ty: Type = Type::Void;
                    match self.parse_type() {
                        ParseResultType::Ok(t) => {
                            assoc_ty = t;
                        }
                        ParseResultType::Err(e) => {
                            return ParseResultImplOrTrait::Err(e);
                        }
                    }
                    self.match_tok(TokenKind::Semicolon);
                    associated_types.push(AssocTypeBinding_new(assoc_name, assoc_ty));
                } else {
                    var is_pub: bool = false;
                    if self.check(TokenKind::Pub) {
                        self.advance();
                        is_pub = true;
                    }
                    // `async fn` in a trait impl (LG14)
                    var ti_async: bool = false;
                    if self.check(TokenKind::Async) {
                        self.advance();
                        ti_async = true;
                    }
                    match self.parse_func() {
                        ParseResultFunc::Ok(func) => {
                            var mfunc = func;
                            mfunc.is_pub = is_pub;
                            mfunc.is_async = ti_async;
                            methods.push(mfunc);
                        }
                        ParseResultFunc::Err(e) => {
                            return ParseResultImplOrTrait::Err(e);
                        }
                    }
                }
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => {
                    return ParseResultImplOrTrait::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }

            var __ti: TraitImpl = TraitImpl_new(trait_name, type_name);
            __ti.type_params = type_params;
            __ti.methods = pd_impl_consts(pd_generic_self(methods, type_name, type_params), impl_consts);
            __ti.associated_types = associated_types;
            var __iot1: ImplOrTrait = ImplOrTrait {
                tag: 1, struct_impl: ImplDef_new(""), trait_impl: __ti,
            };
            self.pd_impl_lts = Vec::new();
            return ParseResultImplOrTrait::Ok(__iot1);
        }

        // Regular `impl Type { ... }`
        var struct_name: str = first_name;
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultImplOrTrait::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        var methods: Vec<Func> = Vec::new();
        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            // CU3: annotations on a method (`@deprecated(use = "m2") fn m`)
            var m_annots: Vec<Annotation> = Vec::new();
            while self.check(TokenKind::At) {
                match self.parse_at_annotation() {
                    ParseResultAnnotation::Ok(ma) => {
                        m_annots.push(ma);
                    }
                    ParseResultAnnotation::Err(e) => {
                        return ParseResultImplOrTrait::Err(e);
                    }
                }
            }
            var is_pub: bool = false;
            if self.check(TokenKind::Pub) {
                self.advance();
                is_pub = true;
            }
            // `async fn` in an impl block (LG14)
            var m_async: bool = false;
            if self.check(TokenKind::Async) {
                self.advance();
                m_async = true;
            }
            match self.parse_func() {
                ParseResultFunc::Ok(func) => {
                    var mfunc = func;
                    mfunc.is_pub = is_pub;
                    mfunc.is_async = m_async;
                    if m_annots.len() > 0 {
                        var mfa: i64 = 0;
                        while mfa < func.annotations.len() {
                            m_annots.push(func.annotations.get(mfa));
                            mfa = mfa + 1;
                        }
                        mfunc.annotations = m_annots;
                    }
                    methods.push(mfunc);
                }
                ParseResultFunc::Err(e) => {
                    return ParseResultImplOrTrait::Err(e);
                }
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultImplOrTrait::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        var __si: ImplDef = ImplDef_new(struct_name);
        __si.type_params = type_params;
        __si.methods = pd_impl_consts(pd_generic_self(methods, struct_name, type_params), impl_consts);
        var __iot0: ImplOrTrait = ImplOrTrait {
            tag: 0, struct_impl: __si, trait_impl: TraitImpl_new("", ""),
        };
        self.pd_impl_lts = Vec::new();
        return ParseResultImplOrTrait::Ok(__iot0);
    }

    fn parse_trait(self: &mut Parser) -> ParseResultTraitDef {
        match self.expect(TokenKind::Cap, "cap") {
            ParseResultUnit::Err(e) => {
                return ParseResultTraitDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultTraitDef::Err(e);
            }
        }
        // Supertraits: `cap NamedGreet: Greet + Show {`
        var supertraits: Vec<str> = Vec::new();
        if self.match_tok(TokenKind::Colon) {
            var more_supers: bool = true;
            while more_supers {
                match self.expect_ident() {
                    ParseResultStr::Ok(sup) => {
                        supertraits.push(sup);
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultTraitDef::Err(e);
                    }
                }
                more_supers = self.match_tok(TokenKind::Plus);
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultTraitDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        var methods: Vec<TraitMethod> = Vec::new();
        var associated_types: Vec<AssocTypeDecl> = Vec::new();
        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            if self.check(TokenKind::Type) {
                self.advance();
                var assoc_name: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(s) => {
                        assoc_name = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultTraitDef::Err(e);
                    }
                }
                var type_params: Vec<str> = Vec::new();
                if self.check(TokenKind::Lt) {
                    self.advance();
                    if !self.check(TokenKind::Gt) {
                        loop {
                            match self.expect_ident() {
                                ParseResultStr::Ok(tp) => {
                                    type_params.push(tp);
                                }
                                ParseResultStr::Err(e) => {
                                    return ParseResultTraitDef::Err(e);
                                }
                            }
                            if !self.match_tok(TokenKind::Comma) {
                                break;
                            }
                            if self.check(TokenKind::Gt) {
                                break;
                            }
                        }
                    }
                    match self.expect(TokenKind::Gt, ">") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultTraitDef::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                }
                self.match_tok(TokenKind::Semicolon);
                associated_types.push(AssocTypeDecl_new(assoc_name, type_params));
            } else {
                var is_pub: bool = false;
                if self.check(TokenKind::Pub) {
                    self.advance();
                    is_pub = true;
                }
                // `async fn m(..) -> Future<T>;` (LG14): the impls say async;
                // the trait's signature is the Future<T> it returns; a default
                // body is an async method's (TraitMethod.is_async)
                var tm_async: bool = false;
                if self.check(TokenKind::Async) {
                    self.advance();
                    tm_async = true;
                }
                match self.expect(TokenKind::Fn, "fn") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultTraitDef::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                var method_name: str = "";
                match self.expect_ident_or_keyword() {
                    ParseResultStr::Ok(s) => {
                        method_name = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultTraitDef::Err(e);
                    }
                }
                // Generic type params (LG4: kept, with their bounds `U: A +
                // B`, as a function's), lifetimes (`'a`, LG3) among them:
                // those are kept to check the signature's lifetimes
                // (pd_check_lifetimes)
                var tm_lifetimes: Vec<str> = Vec::new();
                var tm_tps: Vec<str> = Vec::new();
                var tm_bounds: Vec<StrPair> = Vec::new();
                if self.check(TokenKind::Lt) {
                    self.advance();
                    if !self.check(TokenKind::Gt) {
                        loop {
                            var tm_lt: str = "";
                            match self.peek() {
                                TokenKind::Lifetime(tln: str) => {
                                    tm_lt = tln;
                                }
                                _ => {
                                }
                            }
                            if tm_lt != "" {
                                self.advance();
                                tm_lifetimes.push(tm_lt);
                                // `'b: 'a` bounds are accepted and not used
                                if self.match_tok(TokenKind::Colon) {
                                    loop {
                                        var tm_is_lt: bool = false;
                                        match self.peek() {
                                            TokenKind::Lifetime(_) => {
                                                tm_is_lt = true;
                                            }
                                            _ => {
                                            }
                                        }
                                        if !tm_is_lt {
                                            break;
                                        }
                                        self.advance();
                                        if !self.match_tok(TokenKind::Plus) {
                                            break;
                                        }
                                    }
                                }
                            } else {
                                var tm_tp: str = "";
                                match self.expect_ident() {
                                    ParseResultStr::Ok(tpn) => {
                                        tm_tp = tpn;
                                    }
                                    ParseResultStr::Err(e) => {
                                        return ParseResultTraitDef::Err(e);
                                    }
                                }
                                if self.match_tok(TokenKind::Colon) {
                                    loop {
                                        match self.expect_ident() {
                                            ParseResultStr::Ok(tbn) => {
                                                tm_bounds.push(StrPair_new(tm_tp, tbn));
                                            }
                                            ParseResultStr::Err(e) => {
                                                return ParseResultTraitDef::Err(e);
                                            }
                                        }
                                        if !self.match_tok(TokenKind::Plus) {
                                            break;
                                        }
                                    }
                                }
                                tm_tps.push(tm_tp);
                            }
                            if !self.match_tok(TokenKind::Comma) {
                                break;
                            }
                        }
                    }
                    match self.expect(TokenKind::Gt, ">") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultTraitDef::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                }
                match self.expect(TokenKind::LParen, "(") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultTraitDef::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                var params: Vec<Param> = Vec::new();
                if !self.check(TokenKind::RParen) {
                    loop {
                        var pname: str = "";
                        match self.expect_ident() {
                            ParseResultStr::Ok(s) => {
                                pname = s;
                            }
                            ParseResultStr::Err(e) => {
                                return ParseResultTraitDef::Err(e);
                            }
                        }
                        if pname == "self" && !self.check(TokenKind::Colon) {
                            params.push(Param_new("self", Type::Named("Self"), false));
                        } else {
                            match self.expect(TokenKind::Colon, ":") {
                                ParseResultUnit::Err(e) => {
                                    return ParseResultTraitDef::Err(e);
                                }
                                ParseResultUnit::Ok => {
                                }
                            }
                            var ty: Type = Type::Void;
                            var tp_lt_start: i64 = self.lt_seen.len();
                            match self.parse_type() {
                                ParseResultType::Ok(t) => {
                                    ty = t;
                                }
                                ParseResultType::Err(e) => {
                                    return ParseResultTraitDef::Err(e);
                                }
                            }
                            var tparam: Param = Param_new(pname, ty, false);
                            // LG3: this parameter's lifetimes, as parse_params
                            var tp_lts: Vec<str> = pd_lt_since(self.lt_seen, tp_lt_start);
                            if tp_lts.len() > 0 {
                                tparam.annotations.push(Annotation_new("lifetime", tp_lts));
                            }
                            params.push(tparam);
                        }
                        if !self.match_tok(TokenKind::Comma) {
                            break;
                        }
                    }
                }
                match self.expect(TokenKind::RParen, ")") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultTraitDef::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }

                var ret_ty: Type = Type::Void;
                var tr_lt_start: i64 = self.lt_seen.len();
                if self.match_tok(TokenKind::Arrow) {
                    match self.parse_type() {
                        ParseResultType::Ok(t) => {
                            ret_ty = t;
                        }
                        ParseResultType::Err(e) => {
                            return ParseResultTraitDef::Err(e);
                        }
                    }
                }
                // LG3: the result's lifetimes, checked as a function's are
                var tm_ret_lts: Vec<str> = pd_lt_since(self.lt_seen, tr_lt_start);
                match pd_check_lifetimes(name + "::" + method_name, tm_lifetimes, params, tm_ret_lts) {
                    OptStr::Some(tlt_err) => {
                        var tlt_tok: Token = self.peek_token();
                        return ParseResultTraitDef::Err("Parse error at " + int_to_str(tlt_tok.line) + ":" + int_to_str(tlt_tok.col) + ": " + tlt_err);
                    }
                    OptStr::None => {
                    }
                }

                var has_self: bool = false;
                if params.len() > 0 {
                    if params.get(0).name == "self" {
                        has_self = true;
                    }
                }

                var default_body: OptStmts = OptStmts::None;
                if self.check(TokenKind::LBrace) {
                    self.advance();
                    var body: Vec<Stmt> = Vec::new();
                    match self.parse_block() {
                        ParseResultStmts::Ok(b) => {
                            body = b;
                        }
                        ParseResultStmts::Err(e) => {
                            return ParseResultTraitDef::Err(e);
                        }
                    }
                    match self.expect(TokenKind::RBrace, "}") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultTraitDef::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    default_body = OptStmts::Some(body);
                } else {
                    self.match_tok(TokenKind::Semicolon);
                }

                var mtm: TraitMethod = TraitMethod_new(method_name, ret_ty, has_self);
                mtm.params = params;
                mtm.is_pub = is_pub;
                mtm.default_body = default_body;
                mtm.type_params = tm_tps;
                mtm.type_param_bounds = tm_bounds;
                mtm.is_async = tm_async;
                if tm_ret_lts.len() > 0 {
                    mtm.annotations.push(Annotation_new("lifetime", tm_ret_lts));
                }
                methods.push(mtm);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultTraitDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var __td0: TraitDef = TraitDef_new(name, methods);
        __td0.associated_types = associated_types;
        __td0.supertraits = supertraits;
        return ParseResultTraitDef::Ok(__td0);
    }

    fn parse_extern_func_decl(self: &mut Parser, abi: str, include: OptStr, link_lib: OptStr) -> ParseResultExternDecl {
        var c_name: str = "";
        // The C symbol may itself be a Fides keyword ("system", "time", ...)
        match self.expect_ident_or_keyword() {
            ParseResultStr::Ok(s) => {
                c_name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultExternDecl::Err(e);
            }
        }
        var pledge_name: str = c_name;
        if self.check(TokenKind::As) {
            self.advance();
            match self.expect_ident() {
                ParseResultStr::Ok(s) => {
                    pledge_name = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultExternDecl::Err(e);
                }
            }
        }
        match self.expect(TokenKind::LParen, "(") {
            ParseResultUnit::Err(e) => {
                return ParseResultExternDecl::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var params: Vec<Param> = Vec::new();
        match self.parse_params() {
            ParseResultParams::Ok(p) => {
                params = p;
            }
            ParseResultParams::Err(e) => {
                return ParseResultExternDecl::Err(e);
            }
        }
        if self.p_ct_type_params.len() > 0 {
            return ParseResultExternDecl::Err("a comptime parameter (`comptime T: type`) is allowed on functions and methods only");
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => {
                return ParseResultExternDecl::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var ret_ty: Type = Type::Void;
        if self.match_tok(TokenKind::Arrow) {
            match self.parse_type() {
                ParseResultType::Ok(t) => {
                    ret_ty = t;
                }
                ParseResultType::Err(e) => {
                    return ParseResultExternDecl::Err(e);
                }
            }
        }
        self.match_tok(TokenKind::Semicolon);
        var __ret_ExternDecl: ExternDecl = ExternDecl_new(abi, c_name, pledge_name, ret_ty);
        __ret_ExternDecl.params = params;
        __ret_ExternDecl.include = include;
        __ret_ExternDecl.link_lib = link_lib;
        return ParseResultExternDecl::Ok(__ret_ExternDecl);
    }

    fn parse_func(self: &mut Parser) -> ParseResultFunc {
        // TL2: the line of `fn`, for diagnostics about the whole function
        val fn_line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Fn, "fn") {
            ParseResultUnit::Err(e) => {
                return ParseResultFunc::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var name: str = "";
        match self.expect_ident_or_keyword() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultFunc::Err(e);
            }
        }

        var type_params: Vec<str> = Vec::new();
        var type_param_bounds: Vec<StrPair> = Vec::new();
        var const_params: Vec<StrPair> = Vec::new();
        // LG3: lifetime parameters, `fn f<'a, 'b: 'a, T>(...)`
        var lifetime_params: Vec<str> = Vec::new();
        if self.check(TokenKind::Lt) {
            self.advance();
            if !self.check(TokenKind::Gt) {
                loop {
                    var lt_name: str = "";
                    match self.peek() {
                        TokenKind::Lifetime(ln: str) => {
                            lt_name = ln;
                        }
                        _ => {
                        }
                    }
                    if lt_name != "" {
                        self.advance();
                        lifetime_params.push(lt_name);
                        // `'b: 'a` (outlives bounds) are accepted and not
                        // used: a result borrows from the parameters that
                        // carry its lifetimes, whatever outlives what
                        if self.match_tok(TokenKind::Colon) {
                            loop {
                                var is_lt: bool = false;
                                match self.peek() {
                                    TokenKind::Lifetime(_) => {
                                        is_lt = true;
                                    }
                                    _ => {
                                    }
                                }
                                if !is_lt {
                                    break;
                                }
                                self.advance();
                                if !self.match_tok(TokenKind::Plus) {
                                    break;
                                }
                            }
                        }
                        if !self.match_tok(TokenKind::Comma) {
                            break;
                        }
                        continue;
                    }
                    var tp: str = "";
                    // L8A: `const N: usize` is the same as `N: i64`
                    if self.match_tok(TokenKind::Const) {
                    }
                    match self.expect_ident() {
                        ParseResultStr::Ok(s) => {
                            tp = s;
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultFunc::Err(e);
                        }
                    }
                    if self.match_tok(TokenKind::Colon) {
                        var bound_tok: Token = self.peek_token();
                        if is_int_type_keyword(bound_tok.kind) {
                            var ty_name: str = type_keyword_name(bound_tok.kind);
                            self.advance();
                            const_params.push(StrPair_new(tp, ty_name));
                        } else if pd_size_type_tok(bound_tok.kind) {
                            self.advance();
                            const_params.push(StrPair_new(tp, "i64"));
                        } else {
                            var bound: str = "";
                            match self.expect_ident() {
                                ParseResultStr::Ok(s) => {
                                    bound = s;
                                }
                                ParseResultStr::Err(e) => {
                                    return ParseResultFunc::Err(e);
                                }
                            }
                            type_param_bounds.push(StrPair_new(tp, bound));
                            // T: A + B — every bound is kept and checked (0002)
                            while self.match_tok(TokenKind::Plus) {
                                match self.expect_ident() {
                                    ParseResultStr::Ok(more) => {
                                        type_param_bounds.push(StrPair_new(tp, more));
                                    }
                                    ParseResultStr::Err(e) => {
                                        return ParseResultFunc::Err(e);
                                    }
                                }
                            }
                        }
                    }
                    type_params.push(tp);
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::Gt, ">") {
                ParseResultUnit::Err(e) => {
                    return ParseResultFunc::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        }

        match self.expect(TokenKind::LParen, "(") {
            ParseResultUnit::Err(e) => {
                return ParseResultFunc::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var params: Vec<Param> = Vec::new();
        match self.parse_params() {
            ParseResultParams::Ok(p) => {
                params = p;
            }
            ParseResultParams::Err(e) => {
                return ParseResultFunc::Err(e);
            }
        }
        // `comptime T: type` parameters join the type parameters (§4.11)
        var ctp_i: i64 = 0;
        while ctp_i < self.p_ct_type_params.len() {
            type_params.push(self.p_ct_type_params.get(ctp_i));
            ctp_i = ctp_i + 1;
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => {
                return ParseResultFunc::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        var ret_ty: Type = Type::Void;
        var ret_lt_start: i64 = self.lt_seen.len();
        if self.match_tok(TokenKind::Arrow) {
            match self.parse_type() {
                ParseResultType::Ok(t) => {
                    ret_ty = t;
                }
                ParseResultType::Err(e) => {
                    return ParseResultFunc::Err(e);
                }
            }
        }
        var ret_lts: Vec<str> = pd_lt_since(self.lt_seen, ret_lt_start);
        // LG3: a method may use the lifetimes its `impl<'a>` declares
        var gil: i64 = 0;
        while gil < self.pd_impl_lts.len() {
            if !str_vec_contains(lifetime_params, self.pd_impl_lts.get(gil)) {
                lifetime_params.push(self.pd_impl_lts.get(gil));
            }
            gil = gil + 1;
        }
        match pd_check_lifetimes(name, lifetime_params, params, ret_lts) {
            OptStr::Some(lt_err) => {
                var lt_tok: Token = self.peek_token();
                return ParseResultFunc::Err("Parse error at " + int_to_str(lt_tok.line) + ":" + int_to_str(lt_tok.col) + ": " + lt_err);
            }
            OptStr::None => {
            }
        }

        // Effect annotation: !IO, !{IO, Net}, !{} (pure)
        var has_effect_annotation: bool = false;
        var declared_effects: Vec<str> = Vec::new();
        if self.match_tok(TokenKind::Bang) {
            has_effect_annotation = true;
            if self.match_tok(TokenKind::LBrace) {
                if !self.check(TokenKind::RBrace) {
                    loop {
                        var eff: str = "";
                        match self.expect_ident() {
                            ParseResultStr::Ok(s) => {
                                eff = s;
                            }
                            ParseResultStr::Err(e) => {
                                return ParseResultFunc::Err(e);
                            }
                        }
                        declared_effects.push(eff);
                        if !self.match_tok(TokenKind::Comma) {
                            break;
                        }
                    }
                }
                match self.expect(TokenKind::RBrace, "}") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultFunc::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
            } else {
                var eff: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(s) => {
                        eff = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultFunc::Err(e);
                    }
                }
                declared_effects.push(eff);
            }
        } else {  // No effect annotation
        }

        // F10: Parse given/ensure contracts (Design by Contract)
        var preconditions: Vec<Expr> = Vec::new();
        var postconditions: Vec<Expr> = Vec::new();
        loop {
            if self.check(TokenKind::Given) {
                self.advance();
                match self.parse_expr() {
                    ParseResultExpr::Ok(e) => {
                        preconditions.push(e);
                    }
                    ParseResultExpr::Err(e) => {
                        return ParseResultFunc::Err(e);
                    }
                }
                // Skip optional 'and'/'or'/comma between conditions
                self.match_tok(TokenKind::And);
                self.match_tok(TokenKind::Comma);
                continue;
            }
            if self.check(TokenKind::Ensure) {
                self.advance();
                match self.parse_expr() {
                    ParseResultExpr::Ok(e) => {
                        postconditions.push(e);
                    }
                    ParseResultExpr::Err(e) => {
                        return ParseResultFunc::Err(e);
                    }
                }
                self.match_tok(TokenKind::And);
                self.match_tok(TokenKind::Comma);
                continue;
            }
            break;
        }

        // Parse function body: { ... }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultFunc::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => {
                body = b;
            }
            ParseResultStmts::Err(e) => {
                return ParseResultFunc::Err(e);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultFunc::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        var mfunc: Func = Func_new(name, ret_ty);
        mfunc.type_params = type_params;
        mfunc.type_param_bounds = type_param_bounds;
        mfunc.const_params = const_params;
        mfunc.params = params;
        mfunc.body = body;
        mfunc.declared_effects = declared_effects;
        mfunc.has_effect_annotation = has_effect_annotation;
        mfunc.preconditions = preconditions;
        mfunc.postconditions = postconditions;
        mfunc.line = fn_line;
        // LG3: the result's lifetimes, `@lifetime("'a")` on the function;
        // the reference escape check ties the result to exactly the
        // parameters carrying one of them (compiler/escape.fd)
        if ret_lts.len() > 0 {
            mfunc.annotations.push(Annotation_new("lifetime", ret_lts));
        }
        return ParseResultFunc::Ok(mfunc);
    }

    fn parse_params(self: &mut Parser) -> ParseResultParams {
        var params: Vec<Param> = Vec::new();
        self.p_ct_type_params = Vec::new();
        self.g_sequential_type = false;
        if self.check(TokenKind::RParen) {
            return ParseResultParams::Ok(params);
        }
        loop {
            // `comptime T: type` — a comptime type parameter (§4.11): the
            // name becomes one of the function's type parameters (inference
            // or `f::<T>(..)` fills it, as any type parameter), and the
            // parameter itself is gone. The fn parser picks the names up;
            // every other params context rejects them.
            if self.check(TokenKind::Comptime) {
                self.advance();
                var ct_name: str = "";
                match self.expect_ident_or_keyword() {
                    ParseResultStr::Ok(cn) => {
                        ct_name = cn;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultParams::Err(e);
                    }
                }
                match self.expect(TokenKind::Colon, ":") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultParams::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                if self.check(TokenKind::Type) {
                    self.advance();
                    self.p_ct_type_params.push(ct_name);
                } else {
                    return ParseResultParams::Err("'comptime " + ct_name + ": ...': a comptime parameter takes the type `type` here (a value known at compile time is a `const " + ct_name + ": i64` parameter)");
                }
                if !self.match_tok(TokenKind::Comma) {
                    break;
                }
                if self.check(TokenKind::RParen) {
                    break;
                }
                continue;
            }
            // Optional @annotations on the parameter (e.g. @secret, @tainted)
            var param_annotations: Vec<Annotation> = Vec::new();
            while self.check(TokenKind::At) {
                match self.parse_at_annotation() {
                    ParseResultAnnotation::Ok(ann) => {
                        param_annotations.push(ann);
                    }
                    ParseResultAnnotation::Err(e) => {
                        return ParseResultParams::Err(e);
                    }
                }
            }
            // Check for variadic: ... before the parameter name
            var is_variadic: bool = false;
            if self.match_tok(TokenKind::DotDotDot) {
                is_variadic = true;
            }
            var name: str = "";
            match self.expect_ident_or_keyword() {
                ParseResultStr::Ok(s) => {
                    name = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultParams::Err(e);
                }
            }
            if name == "self" && !self.check(TokenKind::Colon) {
                var param: Param = Param_new("self", Type::Named("Self"), false);
                param.is_variadic = is_variadic;
                param.annotations = param_annotations;
                params.push(param);
            } else {
                match self.expect(TokenKind::Colon, ":") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultParams::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                var ty: Type = Type::Void;
                var lt_start: i64 = self.lt_seen.len();
                match self.parse_type() {
                    ParseResultType::Ok(t) => {
                        ty = t;
                    }
                    ParseResultType::Err(e) => {
                        return ParseResultParams::Err(e);
                    }
                }
                // LG3: the lifetimes written in this parameter's type, kept
                // as `@lifetime("'a", ...)` for the reference escape check
                var p_lts: Vec<str> = pd_lt_since(self.lt_seen, lt_start);
                if p_lts.len() > 0 {
                    param_annotations.push(Annotation_new("lifetime", p_lts));
                }
                var param: Param = Param_new(name, ty, false);
                param.is_variadic = is_variadic;
                param.annotations = param_annotations;
                // Check for default value: = expr
                if self.match_tok(TokenKind::Eq) {
                    match self.parse_expr() {
                        ParseResultExpr::Ok(e) => {
                            param.has_default = true;
                            param.default_expr = e;
                        }
                        ParseResultExpr::Err(e) => {
                            return ParseResultParams::Err(e);
                        }
                    }
                }
                params.push(param);
            }
            if !self.match_tok(TokenKind::Comma) {
                break;
            }
            if self.check(TokenKind::RParen) {
                break;
            }
        }
        return ParseResultParams::Ok(params);
    }

    fn parse_layer(self: &mut Parser) -> ParseResultLayerDef {
        match self.expect(TokenKind::Layer, "layer") {
            ParseResultUnit::Err(e) => {
                return ParseResultLayerDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultLayerDef::Err(e);
            }
        }

        var constructor_args: Vec<str> = Vec::new();
        if self.match_tok(TokenKind::LParen) {
            if !self.check(TokenKind::RParen) {
                loop {
                    match self.parse_annotation_arg() {
                        ParseResultStr::Ok(arg) => {
                            constructor_args.push(arg);
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultLayerDef::Err(e);
                        }
                    }
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => {
                    return ParseResultLayerDef::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        }

        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultLayerDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        var fields: Vec<Param> = Vec::new();
        var forward: Func = Func_new("", Type::Void);
        var has_forward: bool = false;
        var has_forward: bool = false;

        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            if self.check(TokenKind::Fn) {
                match self.parse_func() {
                    ParseResultFunc::Ok(func) => {
                        if func.name == "forward" {
                            forward = func;
                            has_forward = true;
                        }
                    }
                    ParseResultFunc::Err(e) => {
                        return ParseResultLayerDef::Err(e);
                    }
                }
            } else {
                var fname: str = "";
                match self.expect_ident_or_keyword() {
                    ParseResultStr::Ok(s) => {
                        fname = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultLayerDef::Err(e);
                    }
                }
                match self.expect(TokenKind::Colon, ":") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultLayerDef::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                var fty: Type = Type::Void;
                match self.parse_type() {
                    ParseResultType::Ok(t) => {
                        fty = t;
                    }
                    ParseResultType::Err(e) => {
                        return ParseResultLayerDef::Err(e);
                    }
                }
                fields.push(Param_new(fname, fty, false));
                self.match_tok(TokenKind::Comma);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultLayerDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        if !has_forward {
            return ParseResultLayerDef::Err("Layer '" + name + "' must have a 'forward' method");
        }

        self.struct_names.push(name);
        HashMap_insert(self.struct_name_set, name, 1);
        var __ret_LayerDef: LayerDef = LayerDef_new(name, forward, false);
        __ret_LayerDef.fields = fields;
        __ret_LayerDef.constructor_args = constructor_args;
        return ParseResultLayerDef::Ok(__ret_LayerDef);
    }

    fn parse_model(self: &mut Parser) -> ParseResultModelDef {
        match self.expect(TokenKind::Model, "model") {
            ParseResultUnit::Err(e) => {
                return ParseResultModelDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultModelDef::Err(e);
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultModelDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        var layers: Vec<LayerInst> = Vec::new();
        var forward: Func = Func_new("", Type::Void);
        var has_forward: bool = false;
        var has_forward: bool = false;

        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            if self.check(TokenKind::Fn) {
                match self.parse_func() {
                    ParseResultFunc::Ok(func) => {
                        if func.name == "forward" {
                            forward = func;
                            has_forward = true;
                        }
                    }
                    ParseResultFunc::Err(e) => {
                        return ParseResultModelDef::Err(e);
                    }
                }
            } else {
                var field_name: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(s) => {
                        field_name = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultModelDef::Err(e);
                    }
                }
                match self.expect(TokenKind::Colon, ":") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultModelDef::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                var layer_type: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(s) => {
                        layer_type = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultModelDef::Err(e);
                    }
                }
                var ctor_args: Vec<str> = Vec::new();
                if self.match_tok(TokenKind::LParen) {
                    if !self.check(TokenKind::RParen) {
                        loop {
                            match self.parse_annotation_arg() {
                                ParseResultStr::Ok(arg) => {
                                    ctor_args.push(arg);
                                }
                                ParseResultStr::Err(e) => {
                                    return ParseResultModelDef::Err(e);
                                }
                            }
                            if !self.match_tok(TokenKind::Comma) {
                                break;
                            }
                        }
                    }
                    match self.expect(TokenKind::RParen, ")") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultModelDef::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                }
                self.match_tok(TokenKind::Comma);
                layers.push(LayerInst_new(field_name, layer_type, ctor_args));
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultModelDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        if !has_forward {
            return ParseResultModelDef::Err("Model '" + name + "' must have a 'forward' method");
        }

        self.struct_names.push(name);
        HashMap_insert(self.struct_name_set, name, 1);
        var __ret_ModelDef: ModelDef = ModelDef_new(name, layers, forward, false);
        return ParseResultModelDef::Ok(__ret_ModelDef);
    }

    fn parse_component(self: &mut Parser) -> ParseResultComponentDef {
        match self.expect(TokenKind::Component, "component") {
            ParseResultUnit::Err(e) => {
                return ParseResultComponentDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultComponentDef::Err(e);
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultComponentDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var fields: Vec<Param> = Vec::new();
        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            var field_name: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => {
                    field_name = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultComponentDef::Err(e);
                }
            }
            match self.expect(TokenKind::Colon, ":") {
                ParseResultUnit::Err(e) => {
                    return ParseResultComponentDef::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var field_ty: Type = Type::Void;
            match self.parse_type() {
                ParseResultType::Ok(t) => {
                    field_ty = t;
                }
                ParseResultType::Err(e) => {
                    return ParseResultComponentDef::Err(e);
                }
            }
            fields.push(Param_new(field_name, field_ty, false));
            self.match_tok(TokenKind::Comma);
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultComponentDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        self.struct_names.push(name);
        HashMap_insert(self.struct_name_set, name, 1);
        var __ret_ComponentDef: ComponentDef = ComponentDef_new(name, false);
        __ret_ComponentDef.fields = fields;
        return ParseResultComponentDef::Ok(__ret_ComponentDef);
    }

    fn parse_system(self: &mut Parser) -> ParseResultSystemDef {
        match self.expect(TokenKind::System, "system") {
            ParseResultUnit::Err(e) => {
                return ParseResultSystemDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultSystemDef::Err(e);
            }
        }
        match self.expect(TokenKind::LParen, "(") {
            ParseResultUnit::Err(e) => {
                return ParseResultSystemDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var params: Vec<Param> = Vec::new();
        match self.parse_params() {
            ParseResultParams::Ok(p) => {
                params = p;
            }
            ParseResultParams::Err(e) => {
                return ParseResultSystemDef::Err(e);
            }
        }
        if self.p_ct_type_params.len() > 0 {
            return ParseResultSystemDef::Err("a comptime parameter (`comptime T: type`) is allowed on functions and methods only");
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => {
                return ParseResultSystemDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultSystemDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => {
                body = b;
            }
            ParseResultStmts::Err(e) => {
                return ParseResultSystemDef::Err(e);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultSystemDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var __ret_SystemDef: SystemDef = SystemDef_new(name);
        __ret_SystemDef.params = params;
        __ret_SystemDef.body = body;
        return ParseResultSystemDef::Ok(__ret_SystemDef);
    }

    fn parse_state_machine(self: &mut Parser) -> ParseResultStateMachineDef {
        match self.expect(TokenKind::State, "state") {
            ParseResultUnit::Err(e) => {
                return ParseResultStateMachineDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultStateMachineDef::Err(e);
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStateMachineDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var states: Vec<StateDef> = Vec::new();
        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            var state_name: str = "";
            match self.expect_ident_or_keyword() {
                ParseResultStr::Ok(s) => {
                    state_name = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultStateMachineDef::Err(e);
                }
            }
            match self.expect(TokenKind::LBrace, "{") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStateMachineDef::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var transitions: Vec<StateTransition> = Vec::new();
            while !self.check(TokenKind::RBrace) && !self.is_at_end() {
                match self.expect(TokenKind::On, "on") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultStateMachineDef::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                var event: str = "";
                match self.expect_ident_or_keyword() {
                    ParseResultStr::Ok(s) => {
                        event = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultStateMachineDef::Err(e);
                    }
                }
                match self.expect(TokenKind::FatArrow, "=>") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultStateMachineDef::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                var target: str = "";
                match self.expect_ident_or_keyword() {
                    ParseResultStr::Ok(s) => {
                        target = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultStateMachineDef::Err(e);
                    }
                }
                transitions.push(StateTransition_new(event, target));
                self.match_tok(TokenKind::Comma);
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStateMachineDef::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var msd: StateDef = StateDef_new(state_name);
            msd.transitions = transitions;
            states.push(msd);
            self.match_tok(TokenKind::Comma);
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStateMachineDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        self.enum_names.push(name);
        HashMap_insert(self.enum_name_set, name, 1);
        var __ret_StateMachineDef: StateMachineDef = StateMachineDef_new(name, false);
        __ret_StateMachineDef.states = states;
        return ParseResultStateMachineDef::Ok(__ret_StateMachineDef);
    }

    fn parse_event_handler(self: &mut Parser) -> ParseResultEventHandlerDef {
        match self.expect(TokenKind::On, "on") {
            ParseResultUnit::Err(e) => {
                return ParseResultEventHandlerDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var event_name: str = "";
        match self.expect_ident_or_keyword() {
            ParseResultStr::Ok(s) => {
                event_name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultEventHandlerDef::Err(e);
            }
        }
        match self.expect(TokenKind::LParen, "(") {
            ParseResultUnit::Err(e) => {
                return ParseResultEventHandlerDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var params: Vec<Param> = Vec::new();
        match self.parse_params() {
            ParseResultParams::Ok(p) => {
                params = p;
            }
            ParseResultParams::Err(e) => {
                return ParseResultEventHandlerDef::Err(e);
            }
        }
        if self.p_ct_type_params.len() > 0 {
            return ParseResultEventHandlerDef::Err("a comptime parameter (`comptime T: type`) is allowed on functions and methods only");
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => {
                return ParseResultEventHandlerDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultEventHandlerDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => {
                body = b;
            }
            ParseResultStmts::Err(e) => {
                return ParseResultEventHandlerDef::Err(e);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultEventHandlerDef::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var __ret_EventHandlerDef: EventHandlerDef = EventHandlerDef_new(event_name);
        __ret_EventHandlerDef.params = params;
        __ret_EventHandlerDef.body = body;
        return ParseResultEventHandlerDef::Ok(__ret_EventHandlerDef);
    }

    fn parse_type(self: &mut Parser) -> ParseResultType {
        var tok: Token = self.peek_token();
        var k: TokenKind = tok.kind;

        // Function type: fn(params) -> ret
        if token_kind_eq(k, TokenKind::Fn) {
            self.advance();
            match self.expect(TokenKind::LParen, "(") {
                ParseResultUnit::Err(e) => {
                    return ParseResultType::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var params: Vec<Type> = Vec::new();
            if !self.check(TokenKind::RParen) {
                loop {
                    match self.parse_type() {
                        ParseResultType::Ok(t) => {
                            params.push(t);
                        }
                        ParseResultType::Err(e) => {
                            return ParseResultType::Err(e);
                        }
                    }
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => {
                    return ParseResultType::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            match self.expect(TokenKind::Arrow, "->") {
                ParseResultUnit::Err(e) => {
                    return ParseResultType::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var ret: Type = Type::Void;
            match self.parse_type() {
                ParseResultType::Ok(t) => {
                    ret = t;
                }
                ParseResultType::Err(e) => {
                    return ParseResultType::Err(e);
                }
            }
            return ParseResultType::Ok(Type::Func(params, Box::new(ret)));
        }

        // Primitive type keywords
        if token_kind_eq(k, TokenKind::I8) {
            self.advance();
            return ParseResultType::Ok(Type::I8);
        }
        if token_kind_eq(k, TokenKind::I16) {
            self.advance();
            return ParseResultType::Ok(Type::I16);
        }
        if token_kind_eq(k, TokenKind::I32) {
            self.advance();
            return ParseResultType::Ok(Type::I32);
        }
        if token_kind_eq(k, TokenKind::I64) {
            self.advance();
            return ParseResultType::Ok(Type::I64);
        }
        if token_kind_eq(k, TokenKind::I128) {
            self.advance();
            return ParseResultType::Ok(Type::I128);
        }
        if token_kind_eq(k, TokenKind::U8) {
            self.advance();
            return ParseResultType::Ok(Type::U8);
        }
        if token_kind_eq(k, TokenKind::U16) {
            self.advance();
            return ParseResultType::Ok(Type::U16);
        }
        if token_kind_eq(k, TokenKind::U32) {
            self.advance();
            return ParseResultType::Ok(Type::U32);
        }
        if token_kind_eq(k, TokenKind::U64) {
            self.advance();
            return ParseResultType::Ok(Type::U64);
        }
        if token_kind_eq(k, TokenKind::U128) {
            self.advance();
            return ParseResultType::Ok(Type::U128);
        }
        if token_kind_eq(k, TokenKind::F32) {
            self.advance();
            return ParseResultType::Ok(Type::F32);
        }
        if token_kind_eq(k, TokenKind::F64) {
            self.advance();
            return ParseResultType::Ok(Type::F64);
        }
        if token_kind_eq(k, TokenKind::Bool) {
            self.advance();
            return ParseResultType::Ok(Type::Bool);
        }
        // `-> !`: the function never returns.
        if token_kind_eq(k, TokenKind::Bang) {
            self.advance();
            return ParseResultType::Ok(Type::Never);
        }
        if token_kind_eq(k, TokenKind::Str) {
            self.advance();
            return ParseResultType::Ok(Type::Str);
        }
        if token_kind_eq(k, TokenKind::Void) {
            self.advance();
            return ParseResultType::Ok(Type::Void);
        }

        // dyn Trait
        if token_kind_eq(k, TokenKind::Dyn) {
            self.advance();
            var trait_name: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => {
                    trait_name = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultType::Err(e);
                }
            }
            return ParseResultType::Ok(Type::Dyn(trait_name));
        }

        // Identifier-based types
        if token_kind_eq(k, TokenKind::Ident("")) {
            // Extract the ident payload
            var s: str = "";
            match tok.kind {
                TokenKind::Ident(name: str) => {
                    s = name;
                }
                _ => {
                }
            }
            self.advance();
            if s == "_" {
                return ParseResultType::Ok(Type::Infer);
            }
            // `q8` / `q4` (quantized, stored in i8) are type names, not
            // keywords, so they may also name a variable (bugs 13)
            if (s == "q8" || s == "q4") && !self.check(TokenKind::DoubleColon) {
                return ParseResultType::Ok(Type::I8);
            }
            // Associated type: T::Item or GAT T::Item<X>
            if self.check(TokenKind::DoubleColon) {
                self.advance();
                var assoc_name: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(an) => {
                        assoc_name = an;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultType::Err(e);
                    }
                }
                var type_args: Vec<Type> = Vec::new();
                if self.check(TokenKind::Lt) {
                    self.advance();
                    if !self.check(TokenKind::Gt) {
                        loop {
                            match self.parse_type() {
                                ParseResultType::Ok(ta) => {
                                    type_args.push(ta);
                                }
                                ParseResultType::Err(e) => {
                                    return ParseResultType::Err(e);
                                }
                            }
                            if !self.match_tok(TokenKind::Comma) {
                                break;
                            }
                            if self.check(TokenKind::Gt) {
                                break;
                            }
                        }
                    }
                    match self.expect(TokenKind::Gt, ">") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultType::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                }
                return ParseResultType::Ok(Type::Assoc(s, "", assoc_name, type_args));
            }
            // Generic type args: Name<T, U>
            if self.check(TokenKind::Lt) {
                self.advance();
                // Special case: Tensor<elem, [dims]> -> ShapedTensor
                if s == "Tensor" {
                    var elem: Type = Type::Void;
                    match self.parse_type() {
                        ParseResultType::Ok(t) => {
                            elem = t;
                        }
                        ParseResultType::Err(e) => {
                            return ParseResultType::Err(e);
                        }
                    }
                    if self.match_tok(TokenKind::Comma) {
                        if self.match_tok(TokenKind::LBracket) {
                            var shape: Vec<ShapeDim> = Vec::new();
                            if !self.check(TokenKind::RBracket) {
                                loop {
                                    var dtok: Token = self.peek_token();
                                    match dtok.kind {
                                        TokenKind::IntLit(n: i64) => {
                                            self.advance();
                                            shape.push(ShapeDim::Known(n));
                                        }
                                        TokenKind::Ident(name: str) => {
                                            self.advance();
                                            shape.push(ShapeDim::Symbolic(name));
                                        }
                                        _ => {
                                        }
                                    }
                                    if !self.match_tok(TokenKind::Comma) {
                                        break;
                                    }
                                }
                            }
                            match self.expect(TokenKind::RBracket, "]") {
                                ParseResultUnit::Err(e) => {
                                    return ParseResultType::Err(e);
                                }
                                ParseResultUnit::Ok => {
                                }
                            }
                            match self.expect(TokenKind::Gt, ">") {
                                ParseResultUnit::Err(e) => {
                                    return ParseResultType::Err(e);
                                }
                                ParseResultUnit::Ok => {
                                }
                            }
                            return ParseResultType::Ok(Type::ShapedTensor(Box::new(elem), shape));
                        }
                    }
                    // Fallback: Tensor<elem> -> Generic
                    match self.expect(TokenKind::Gt, ">") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultType::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    var args: Vec<Type> = Vec::new();
                    args.push(elem);
                    return ParseResultType::Ok(Type::Generic(s, args));
                }

                var args: Vec<Type> = Vec::new();
                var lt_args: i64 = 0;
                if !self.check(TokenKind::Gt) {
                    loop {
                        // L8A: a value argument of a const parameter
                        // (`Matrix<i64, 3>`), the type `__const_3` (what
                        // mono substitutes for N in `[T; N]`)
                        var ctok: Token = self.peek_token();
                        var const_arg: bool = false;
                        match ctok.kind {
                            TokenKind::IntLit(cn: i64) => {
                                self.advance();
                                args.push(Type_const_of(cn));
                                const_arg = true;
                            }
                            TokenKind::Lifetime(lta: str) => {
                                // LG3: `View<'a>`: a lifetime argument is
                                // not a type argument; the signature being
                                // parsed records it (parse_params,
                                // parse_func) as for `&'a T`
                                self.advance();
                                self.lt_seen.push(lta);
                                lt_args = lt_args + 1;
                                const_arg = true;
                            }
                            _ => {
                            }
                        }
                        if !const_arg {
                            match self.parse_type() {
                                ParseResultType::Ok(t) => {
                                    args.push(t);
                                }
                                ParseResultType::Err(e) => {
                                    return ParseResultType::Err(e);
                                }
                            }
                        }
                        if !self.match_tok(TokenKind::Comma) {
                            break;
                        }
                    }
                }
                // 0008 (FID_CONTIGUOUS): `Vec<E..>` — a variant stream of
                // the enum E, each element at its own variant's size
                if s == "Vec" && args.len() == 1 && self.check(TokenKind::DotDot) {
                    self.advance();
                    match self.expect(TokenKind::Gt, ">") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultType::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    self.g_sequential_type = true;
                    return ParseResultType::Ok(Type::Generic("Vec", args));
                }
                match self.expect(TokenKind::Gt, ">") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultType::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                if lt_args > 0 && args.len() == 0 {
                    return ParseResultType::Ok(Type::Named(s));
                }
                return ParseResultType::Ok(Type::Generic(s, args));
            }
            return ParseResultType::Ok(Type::Named(s));
        }

        // Tuple type: (T, U, ...) or unit ()
        if token_kind_eq(k, TokenKind::LParen) {
            self.advance();
            var types: Vec<Type> = Vec::new();
            if !self.check(TokenKind::RParen) {
                loop {
                    match self.parse_type() {
                        ParseResultType::Ok(t) => {
                            types.push(t);
                        }
                        ParseResultType::Err(e) => {
                            return ParseResultType::Err(e);
                        }
                    }
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => {
                    return ParseResultType::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            if types.len() == 1 {
                return ParseResultType::Ok(types.get(0));
            }
            return ParseResultType::Ok(Type::Tuple(types));
        }

        // Reference type: &T or &mut T, with a lifetime: &'a T, &'a mut T
        if token_kind_eq(k, TokenKind::Ampersand) {
            self.advance();
            match self.peek() {
                TokenKind::Lifetime(lt: str) => {
                    // LG3: the type stays Ref; the name is recorded for the
                    // signature being parsed (parse_params, parse_func)
                    self.lt_seen.push(lt);
                    self.advance();
                }
                _ => {
                }
            }
            var is_mut: bool = self.match_tok(TokenKind::Mut);
            var inner: Type = Type::Void;
            match self.parse_type() {
                ParseResultType::Ok(t) => {
                    inner = t;
                }
                ParseResultType::Err(e) => {
                    return ParseResultType::Err(e);
                }
            }
            return ParseResultType::Ok(Type::Ref(Box::new(inner), is_mut));
        }

        // Raw pointer: *mut T or *const T
        if token_kind_eq(k, TokenKind::Star) {
            self.advance();
            var is_mut: bool = false;
            if self.check(TokenKind::Mut) {
                self.advance();
                is_mut = true;
            } else if self.check(TokenKind::Const) {
                self.advance();
                is_mut = false;
            }
            var inner: Type = Type::Void;
            match self.parse_type() {
                ParseResultType::Ok(t) => {
                    inner = t;
                }
                ParseResultType::Err(e) => {
                    return ParseResultType::Err(e);
                }
            }
            return ParseResultType::Ok(Type::RawPtr(Box::new(inner), is_mut));
        }

        // Array type: [T; N] or [T; NAME]
        if token_kind_eq(k, TokenKind::LBracket) {
            self.advance();
            var elem: Type = Type::Void;
            match self.parse_type() {
                ParseResultType::Ok(t) => {
                    elem = t;
                }
                ParseResultType::Err(e) => {
                    return ParseResultType::Err(e);
                }
            }
            match self.expect(TokenKind::Semicolon, ";") {
                ParseResultUnit::Err(e) => {
                    return ParseResultType::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var size_tok: Token = self.peek_token();
            match size_tok.kind {
                TokenKind::IntLit(n: i64) => {
                    self.advance();
                    match self.expect(TokenKind::RBracket, "]") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultType::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    return ParseResultType::Ok(Type::Array(Box::new(elem), n));
                }
                TokenKind::Ident(name: str) => {
                    self.advance();
                    match self.expect(TokenKind::RBracket, "]") {
                        ParseResultUnit::Err(e) => {
                            return ParseResultType::Err(e);
                        }
                        ParseResultUnit::Ok => {
                        }
                    }
                    return ParseResultType::Ok(Type::ArrayConst(Box::new(elem), name));
                }
                _ => {
                }
            }
            return ParseResultType::Err("Parse error at " + int_to_str(size_tok.line) + ":" + int_to_str(size_tok.col) + ": expected array size but got '" + token_kind_to_str(size_tok.kind) + "'\n    Fix: write the size as an integer constant, as in `[i64; 4]`");
        }

        return ParseResultType::Err("Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) + ": expected type but got '" + token_kind_to_str(tok.kind) + "'\n    Fix: write a type here, as in `i64`, `&str`, `Vec<i64>` or `fn(i64) -> i64`");
    }

    // F1 (VF3): the parser recurses once per level of brackets, blocks and
    // prefix operators; past 256 levels it stops with this error instead of
    // overflowing the compiler's stack. It skips to the end of the file, so
    // the enclosing levels' recovery does not report it once per level.
    fn nest_too_deep(self: &mut Parser) -> str {
        var t: Token = self.peek_token();
        var msg: str = "Parse error at " + int_to_str(t.line) + ":" + int_to_str(t.col) + ": nested too deeply (more than 256 levels of brackets, blocks or prefix operators)\n    Fix: split the expression into named parts (`val` bindings) or into functions";
        self.nest_hit = true;
        while !self.is_at_end() {
            self.advance();
        }
        return msg;
    }

    // An error to report; after "nested too deeply" (which skipped to the
    // end of the file), one found at the end is a consequence of it (a
    // missing `}` per level) and is left out.
    fn push_parse_error(self: &mut Parser, e: str) {
        if self.nest_hit && self.is_at_end() && !str_contains(e, "nested too deeply") {
            return;
        }
        self.errors.push(e);
    }

    fn parse_block(self: &mut Parser) -> ParseResultStmts {
        if self.nest_depth >= 256 {
            return ParseResultStmts::Err(self.nest_too_deep());
        }
        self.nest_depth = self.nest_depth + 1;
        var r: ParseResultStmts = self.parse_block_inner();
        self.nest_depth = self.nest_depth - 1;
        return r;
    }

    fn parse_block_inner(self: &mut Parser) -> ParseResultStmts {
        var stmts: Vec<Stmt> = Vec::new();
        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            match self.parse_stmt() {
                ParseResultStmt::Ok(stmt) => {
                    stmts.push(stmt);
                }
                ParseResultStmt::Err(e) => {
                    self.push_parse_error(e);
                    self.recover_to_sync_token();
                }
            }
        }
        return ParseResultStmts::Ok(pd_infer_vec_lets(stmts));
    }

    fn parse_stmt(self: &mut Parser) -> ParseResultStmt {
        var k: TokenKind = self.peek();

        // A word keyword heading an lvalue is an expression statement, not the
        // keyword's own statement form: `guard = x`, `val = y`, `cap += 1`.
        // Assignment operators can never continue a keyword statement.
        if is_word_keyword(k) && self.pos + 1 < self.tokens.len() {
            var k2: TokenKind = self.tokens.get(self.pos + 1).kind;
            if token_kind_eq(k2, TokenKind::Eq) || token_kind_eq(k2, TokenKind::PlusEq) || token_kind_eq(k2, TokenKind::MinusEq) || token_kind_eq(k2, TokenKind::StarEq) || token_kind_eq(k2, TokenKind::SlashEq) || token_kind_eq(k2, TokenKind::PercentEq) || token_kind_eq(k2, TokenKind::AmpEq) || token_kind_eq(k2, TokenKind::PipeEq) || token_kind_eq(k2, TokenKind::CaretEq) || token_kind_eq(k2, TokenKind::ShlEq) || token_kind_eq(k2, TokenKind::ShrEq) {
                return self.parse_assign_or_expr();
            }
            // nor a field access: `handle.fd = 3;`, `state.n += 1;` (bugs 36)
            if token_kind_eq(k2, TokenKind::Dot) {
                return self.parse_assign_or_expr();
            }
        }

        // @annotation(s) on local variable declarations (e.g. @zeroize, @secret)
        if token_kind_eq(k, TokenKind::At) {
            var annotations: Vec<Annotation> = Vec::new();
            while self.check(TokenKind::At) {
                match self.parse_at_annotation() {
                    ParseResultAnnotation::Ok(a) => {
                        annotations.push(a);
                    }
                    ParseResultAnnotation::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                }
            }
            // The annotated statement must be a val/var declaration
            var k2: TokenKind = self.peek();
            if token_kind_eq(k2, TokenKind::Val) || token_kind_eq(k2, TokenKind::Var) {
                match self.parse_let() {
                    ParseResultStmt::Ok(stmt) => {
                        // Inject annotations into the Let/LetUninit statement
                        match stmt {
                            Stmt::Let(n, ty, e, im, p, _anns, ln) => {
                                return ParseResultStmt::Ok(Stmt::Let(n, ty, e, im, p, annotations, ln));
                            }
                            Stmt::LetUninit(n, t, _anns, ln) => {
                                return ParseResultStmt::Ok(Stmt::LetUninit(n, t, annotations, ln));
                            }
                            _ => {
                                return ParseResultStmt::Err("@annotations can only be applied to val/var declarations at line " + int_to_str(self.peek_token().line));
                            }
                        }
                    }
                    ParseResultStmt::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                }
            }
            return ParseResultStmt::Err("@annotations on statements require a val/var declaration at line " + int_to_str(self.peek_token().line));
        }

        if token_kind_eq(k, TokenKind::Persist) {
            return self.parse_persist_let();
        }
        if token_kind_eq(k, TokenKind::Val) {
            return self.parse_let();
        }
        if token_kind_eq(k, TokenKind::Var) {
            return self.parse_let();
        }
        if token_kind_eq(k, TokenKind::Return) {
            return self.parse_return();
        }
        if token_kind_eq(k, TokenKind::Query) {
            return self.parse_query_stmt();
        }
        if token_kind_eq(k, TokenKind::If) {
            var line: i64 = self.peek_token().line;
            var if_expr: IfExpr = IfExpr {
                cond: Expr::IntLit(0), then_block: Vec::new(), else_block: OptStmts::None,
            };
            match self.parse_if_expr() {
                ParseResultIfExpr::Ok(ie) => {
                    if_expr = ie;
                }
                ParseResultIfExpr::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            return ParseResultStmt::Ok(Stmt::If(if_expr.cond, if_expr.then_block, if_expr.else_block, line));
        }
        if token_kind_eq(k, TokenKind::While) {
            return self.parse_while();
        }
        // `inline for` (§4.11): the loop is unrolled before type checking,
        // its trip count comptime-known. Encoded as the iterator wrapped in
        // `comptime`, which the expand pass (comptime_eval.fd) rewrites into
        // the unrolled statements with the loop variable a literal per copy.
        var inline_for: bool = false;
        match k {
            TokenKind::Ident(w: str) => {
                if w == "inline" {
                    inline_for = true;
                }
            }
            _ => {
            }
        }
        if inline_for && self.pos + 1 < self.tokens.len() && token_kind_eq(self.tokens.get(self.pos + 1).kind, TokenKind::For) {
            self.advance();
            match self.parse_for() {
                ParseResultStmt::Ok(s) => {
                    match s {
                        Stmt::For(v, it, body, ln) => {
                            return ParseResultStmt::Ok(Stmt::For(v, Expr::Comptime(Box::new(it)), body, ln));
                        }
                        other => {
                            return ParseResultStmt::Ok(other);
                        }
                    }
                }
                ParseResultStmt::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
        }
        if token_kind_eq(k, TokenKind::For) {
            return self.parse_for();
        }
        if token_kind_eq(k, TokenKind::Loop) {
            return self.parse_loop();
        }
        if token_kind_eq(k, TokenKind::Break) {
            var line: i64 = self.peek_token().line;
            self.advance();
            if self.check(TokenKind::Semicolon) || self.check(TokenKind::RBrace) {
                self.match_tok(TokenKind::Semicolon);
                return ParseResultStmt::Ok(Stmt::Break(OptBoxExpr::None, line));
            }
            var expr: Expr = Expr::IntLit(0);
            match self.parse_expr() {
                ParseResultExpr::Ok(e) => {
                    expr = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            self.match_tok(TokenKind::Semicolon);
            return ParseResultStmt::Ok(Stmt::Break(OptBoxExpr::Some(Box::new(expr)), line));
        }
        if token_kind_eq(k, TokenKind::Continue) {
            var line: i64 = self.peek_token().line;
            self.advance();
            self.match_tok(TokenKind::Semicolon);
            return ParseResultStmt::Ok(Stmt::Continue(line));
        }
        if token_kind_eq(k, TokenKind::Defer) {
            var line: i64 = self.peek_token().line;
            self.advance();
            match self.expect(TokenKind::LBrace, "{") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var body: Vec<Stmt> = Vec::new();
            match self.parse_block() {
                ParseResultStmts::Ok(b) => {
                    body = b;
                }
                ParseResultStmts::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            return ParseResultStmt::Ok(Stmt::Defer(body, line));
        }
        if token_kind_eq(k, TokenKind::Match) {
            return self.parse_match_stmt();
        }
        if token_kind_eq(k, TokenKind::Select) {
            return self.parse_select_stmt();
        }
        if token_kind_eq(k, TokenKind::Use) {
            return self.parse_use_stmt();
        }
        if token_kind_eq(k, TokenKind::Handle) {
            // `handle(x);` calls a function named handle (reference §1.4);
            // the handler statement is `handle {`
            // and anything else not `handle {` uses a variable named handle
            // (`handle[0] = 1`, `handle.fd`; bugs 36)
            if self.pos + 1 < self.tokens.len() && !token_kind_eq(self.tokens.get(self.pos + 1).kind, TokenKind::LBrace) {
                return self.parse_assign_or_expr();
            }
            return self.parse_handle_stmt();
        }
        if token_kind_eq(k, TokenKind::Do) {
            return self.parse_do_stmt();
        }
        if token_kind_eq(k, TokenKind::Resume) {
            return self.parse_resume_stmt();
        }
        // L3B: `spawn scope { body }` — structured concurrency scope (contextual:
        // only when spawn is followed by ident "scope" and '{')
        if token_kind_eq(k, TokenKind::Spawn) && self.pos + 2 < self.tokens.len() {
            var ss_next: Token = self.tokens.get(self.pos + 1);
            var ss_next2: Token = self.tokens.get(self.pos + 2);
            match ss_next.kind {
                TokenKind::Ident(scope_name) => {
                    if scope_name == "scope" && token_kind_eq(ss_next2.kind, TokenKind::LBrace) {
                        return self.parse_spawn_scope_stmt();
                    }
                }
                _ => {
                }
            }
        }
        // L3E: `cancel scope;` — cancel all tasks in the current spawn scope
        match k {
            TokenKind::Ident(cancel_name) => {
                if cancel_name == "cancel" && self.pos + 1 < self.tokens.len() {
                    var c_next: Token = self.tokens.get(self.pos + 1);
                    match c_next.kind {
                        TokenKind::Ident(scope_name2) => {
                            if scope_name2 == "scope" {
                                return self.parse_cancel_scope_stmt();
                            }
                        }
                        _ => {
                        }
                    }
                }
            }
            _ => {
            }
        }
        if token_kind_eq(k, TokenKind::Region) {
            return self.parse_region_block();
        }
        if token_kind_eq(k, TokenKind::Sandbox) {
            return self.parse_sandbox_block();
        }
        if token_kind_eq(k, TokenKind::Unsafe) {
            return self.parse_unsafe_block();
        }
        if token_kind_eq(k, TokenKind::Txn) {
            return self.parse_txn_block();
        }
        if token_kind_eq(k, TokenKind::Grad) {
            return self.parse_grad_block();
        }
        if token_kind_eq(k, TokenKind::Backward) {
            var line: i64 = self.peek_token().line;
            self.advance();
            match self.expect(TokenKind::LParen, "(") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var loss: Expr = Expr::IntLit(0);
            match self.parse_expr() {
                ParseResultExpr::Ok(e) => {
                    loss = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            self.match_tok(TokenKind::Semicolon);
            return ParseResultStmt::Ok(Stmt::Backward(loss, line));
        }
        if token_kind_eq(k, TokenKind::Comptime) {
            var line: i64 = self.peek_token().line;
            self.advance();
            // comptime gen { block }
            var peek_k: TokenKind = self.peek();
            match peek_k {
                TokenKind::Ident(name: str) => {
                    if name == "gen" {
                        self.advance();
                        match self.expect(TokenKind::LBrace, "{") {
                            ParseResultUnit::Err(e) => {
                                return ParseResultStmt::Err(e);
                            }
                            ParseResultUnit::Ok => {
                            }
                        }
                        var block: Vec<Stmt> = Vec::new();
                        match self.parse_block() {
                            ParseResultStmts::Ok(b) => {
                                block = b;
                            }
                            ParseResultStmts::Err(e) => {
                                return ParseResultStmt::Err(e);
                            }
                        }
                        match self.expect(TokenKind::RBrace, "}") {
                            ParseResultUnit::Err(e) => {
                                return ParseResultStmt::Err(e);
                            }
                            ParseResultUnit::Ok => {
                            }
                        }
                        return ParseResultStmt::Ok(Stmt::ComptimeGen(block, line));
                    }
                }
                _ => {
                }
            }
            var expr: Expr = Expr::IntLit(0);
            match self.parse_comptime_expr(line) {
                ParseResultExpr::Ok(e) => {
                    expr = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            // LG9: `comptime splice { .. };` as a statement (a splice
            // leaves its `;` to the expression around it)
            self.match_tok(TokenKind::Semicolon);
            return ParseResultStmt::Ok(Stmt::Expr(expr, line));
        }
        if token_kind_eq(k, TokenKind::Guard) {
            return self.parse_guard_stmt();
        }

        // F13: parallel { | branch1 | branch2 | ... } — contextual keyword
        if token_kind_eq(k, TokenKind::Ident("")) {
            match k {
                TokenKind::Ident(s: str) => {
                    if s == "parallel" {
                        return self.parse_parallel_stmt();
                    }
                    // CA8: `timeout(ms) { .. }` (contextual: `timeout`, a
                    // parenthesized expression, then `{`; a call `timeout(x);`
                    // stays a call)
                    if s == "timeout" && self.timeout_block_ahead() {
                        return self.parse_timeout_stmt();
                    }
                    // `abort;` inside txn { }: roll the block back and leave it.
                    // A contextual keyword: parsed as a call of the builtin
                    // __txn_abort, which the type checker allows only inside txn.
                    if s == "abort" && self.pos + 1 < self.tokens.len() && token_kind_eq(self.tokens.get(self.pos + 1).kind, TokenKind::Semicolon) {
                        var aline: i64 = self.peek_token().line;
                        self.advance();
                        self.advance();
                        var no_args: Vec<Expr> = Vec::new();
                        return ParseResultStmt::Ok(Stmt::Expr(Expr::Call("__txn_abort", no_args), aline));
                    }
                }
                _ => {
                }
            }
        }

        return self.parse_assign_or_expr();
    }

    fn parse_assign_or_expr(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        var expr: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => {
                expr = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }

        // Check for assignment operator
        var assign_op: AssignOp = AssignOp::Assign;
        var has_assign: bool = true;
        var k: TokenKind = self.peek();
        if token_kind_eq(k, TokenKind::Eq) {
            assign_op = AssignOp::Assign;
        } else if token_kind_eq(k, TokenKind::PlusEq) {
            assign_op = AssignOp::AddAssign;
        } else if token_kind_eq(k, TokenKind::MinusEq) {
            assign_op = AssignOp::SubAssign;
        } else if token_kind_eq(k, TokenKind::StarEq) {
            assign_op = AssignOp::MulAssign;
        } else if token_kind_eq(k, TokenKind::SlashEq) {
            assign_op = AssignOp::DivAssign;
        } else if token_kind_eq(k, TokenKind::PercentEq) {
            assign_op = AssignOp::ModAssign;
        } else if token_kind_eq(k, TokenKind::AmpEq) {
            assign_op = AssignOp::BitAndAssign;
        } else if token_kind_eq(k, TokenKind::PipeEq) {
            assign_op = AssignOp::BitOrAssign;
        } else if token_kind_eq(k, TokenKind::CaretEq) {
            assign_op = AssignOp::BitXorAssign;
        } else if token_kind_eq(k, TokenKind::ShlEq) {
            assign_op = AssignOp::ShlAssign;
        } else if token_kind_eq(k, TokenKind::ShrEq) {
            assign_op = AssignOp::ShrAssign;
        } else {
            has_assign = false;
        }

        if has_assign {
            self.advance();
            // Match the assignment target shape
            match expr {
                Expr::Ident(name) => {
                    var rhs: Expr = Expr::IntLit(0);
                    match self.parse_expr() {
                        ParseResultExpr::Ok(e) => {
                            rhs = e;
                        }
                        ParseResultExpr::Err(e) => {
                            return ParseResultStmt::Err(e);
                        }
                    }
                    self.match_tok(TokenKind::Semicolon);
                    return ParseResultStmt::Ok(Stmt::Assign(name, assign_op, rhs, line));
                }
                Expr::Index(array, index) => {
                    match array {
                        Expr::Ident(name) => {
                            var rhs: Expr = Expr::IntLit(0);
                            match self.parse_expr() {
                                ParseResultExpr::Ok(e) => {
                                    rhs = e;
                                }
                                ParseResultExpr::Err(e) => {
                                    return ParseResultStmt::Err(e);
                                }
                            }
                            self.match_tok(TokenKind::Semicolon);
                            return ParseResultStmt::Ok(Stmt::IndexAssign(name, box_expr_deref(index), assign_op, rhs, line));
                        }
                        _ => {
                        }
                    }
                    return ParseResultStmt::Err("Parse error: index assignment target must be an array variable\n    Fix: index a variable, `v[i] = x`; for a Vec in a field call set on it, `s.v.set(i, x)`");
                }
                Expr::Deref(ptr_expr) => {
                    var rhs: Expr = Expr::IntLit(0);
                    match self.parse_expr() {
                        ParseResultExpr::Ok(e) => {
                            rhs = e;
                        }
                        ParseResultExpr::Err(e) => {
                            return ParseResultStmt::Err(e);
                        }
                    }
                    self.match_tok(TokenKind::Semicolon);
                    return ParseResultStmt::Ok(Stmt::DerefAssign(box_expr_deref(ptr_expr), assign_op, rhs, line));
                }
                Expr::FieldAccess(obj_expr, field) => {
                    var rhs: Expr = Expr::IntLit(0);
                    match self.parse_expr() {
                        ParseResultExpr::Ok(e) => {
                            rhs = e;
                        }
                        ParseResultExpr::Err(e) => {
                            return ParseResultStmt::Err(e);
                        }
                    }
                    self.match_tok(TokenKind::Semicolon);
                    return ParseResultStmt::Ok(Stmt::FieldAssign(box_expr_deref(obj_expr), field, assign_op, rhs, line));
                }
                _ => {
                }
            }
            var err_tok: Token = self.peek_token();
            var err_msg: str = "Parse error: assignment target must be an identifier or array index at line " + int_to_str(err_tok.line) + " col " + int_to_str(err_tok.col) + "\n    Fix: assign to a variable, a field or an element: `x = v`, `p.x = v`, `a[i] = v`; a call's result cannot be assigned to";
            return ParseResultStmt::Err(err_msg);
        }

        self.match_tok(TokenKind::Semicolon);
        return ParseResultStmt::Ok(Stmt::Expr(expr, line));
    }

    fn parse_while(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::While, "while") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var cond: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => {
                cond = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => {
                body = b;
            }
            ParseResultStmts::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultStmt::Ok(Stmt::While(cond, body, line));
    }

    fn parse_guard_stmt(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Guard, "guard") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var cond: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => {
                cond = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::FatArrow, "=>") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var then_block: Vec<Stmt> = Vec::new();
        if self.check(TokenKind::LBrace) {
            self.advance();
            match self.parse_block() {
                ParseResultStmts::Ok(b) => {
                    then_block = b;
                }
                ParseResultStmts::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        } else {
            match self.parse_stmt() {
                ParseResultStmt::Ok(s) => {
                    then_block.push(s);
                }
                ParseResultStmt::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
        }
        // Desugar: guard cond => action  ->  if !cond { action }
        return ParseResultStmt::Ok(Stmt::If(Expr::Unary(UnaryOp::Not, Box::new(cond)), then_block, OptStmts::None, line));
    }

    fn parse_for(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::For, "for") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var loop_var: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                loop_var = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::In, "in") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var iterator: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => {
                iterator = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => {
                body = b;
            }
            ParseResultStmts::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultStmt::Ok(Stmt::For(loop_var, iterator, body, line));
    }

    fn parse_loop(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Loop, "loop") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => {
                body = b;
            }
            ParseResultStmts::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultStmt::Ok(Stmt::Loop(body, line));
    }

    fn parse_query_stmt(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Query, "query") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        match self.expect(TokenKind::LParen, "(") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var components: Vec<str> = Vec::new();
        if !self.check(TokenKind::RParen) {
            loop {
                var comp_name: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(s) => {
                        comp_name = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                }
                components.push(comp_name);
                if !self.match_tok(TokenKind::Comma) {
                    break;
                }
            }
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => {
                body = b;
            }
            ParseResultStmts::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultStmt::Ok(Stmt::Query(components, body, line));
    }

    fn parse_match_stmt(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Match, "match") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var expr: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => {
                expr = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var arms: Vec<MatchArm> = Vec::new();
        var nests: Vec<PatNest> = Vec::new();
        var npctr: i64 = 0;
        var marks: Vec<i64> = Vec::new();
        marks.push(0);
        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            var pattern: Pattern = Pattern::Wildcard;
            match self.parse_pattern(&mut nests, &mut npctr) {
                ParseResultPattern::Ok(p) => {
                    pattern = p;
                }
                ParseResultPattern::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            marks.push(nests.len());
            var match_guard: OptBoxExpr = OptBoxExpr::None;
            if self.check(TokenKind::If) {
                self.advance();
                match self.parse_expr() {
                    ParseResultExpr::Ok(g) => {
                        match_guard = OptBoxExpr::Some(Box::new(g));
                    }
                    ParseResultExpr::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                }
            }
            match self.expect(TokenKind::FatArrow, "=>") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            match self.expect(TokenKind::LBrace, "{") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var body: Vec<Stmt> = Vec::new();
            match self.parse_block() {
                ParseResultStmts::Ok(b) => {
                    body = b;
                }
                ParseResultStmts::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            self.match_tok(TokenKind::Comma);
            arms.push(MatchArm_new(pattern, match_guard, body));
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        if nests.len() > 0 {
            // LG8: nested patterns desugar to inner matches. Bind the scrutinee
            // once so the inner fallthrough matches never re-evaluate it.
            var vstmts: Vec<Stmt> = Vec::new();
            vstmts.push(Stmt::Let("__ms", OptType::None, expr, false, false, Vec::new(), line));
            // BG264: the original arms' exhaustiveness (pd_np_probe_stmt)
            var probe: Vec<Stmt> = pd_np_probe_stmt("__ms", arms, nests, line);
            if probe.len() > 0 {
                vstmts.push(probe.get(0));
            }
            arms = self.pd_desugar_arms("__ms", arms, nests, marks, 0, line, false);
            vstmts.push(Stmt::Match(Expr::Ident("__ms"), arms, line));
            return ParseResultStmt::Ok(Stmt::If(Expr::BoolLit(true), vstmts, OptStmts::None, line));
        }
        return ParseResultStmt::Ok(Stmt::Match(expr, arms, line));
    }

    fn parse_select_stmt(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Select, "select") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var cases: Vec<SelectCase> = Vec::new();
        var default: OptStmts = OptStmts::None;
        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            var ident: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => {
                    ident = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            if ident == "default" {
                match self.expect(TokenKind::FatArrow, "=>") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                match self.expect(TokenKind::LBrace, "{") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                var body: Vec<Stmt> = Vec::new();
                match self.parse_block() {
                    ParseResultStmts::Ok(b) => {
                        body = b;
                    }
                    ParseResultStmts::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                }
                match self.expect(TokenKind::RBrace, "}") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                default = OptStmts::Some(body);
                self.match_tok(TokenKind::Comma);
            } else if ident == "case" {
                var channel: Expr = Expr::IntLit(0);
                match self.parse_expr() {
                    ParseResultExpr::Ok(e) => {
                        channel = e;
                    }
                    ParseResultExpr::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                }
                match self.expect(TokenKind::FatArrow, "=>") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                var var_name: str = "";
                match self.expect_ident() {
                    ParseResultStr::Ok(s) => {
                        var_name = s;
                    }
                    ParseResultStr::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                }
                match self.expect(TokenKind::FatArrow, "=>") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                match self.expect(TokenKind::LBrace, "{") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                var body: Vec<Stmt> = Vec::new();
                match self.parse_block() {
                    ParseResultStmts::Ok(b) => {
                        body = b;
                    }
                    ParseResultStmts::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                }
                match self.expect(TokenKind::RBrace, "}") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                self.match_tok(TokenKind::Comma);
                cases.push(SelectCase_new(channel, var_name, body));
            } else {
                return ParseResultStmt::Err("Expected 'case' or 'default' in select, got '" + ident + "'");
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultStmt::Ok(Stmt::Select(cases, default, line));
    }

    fn parse_parallel_stmt(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        // Consume 'parallel' keyword (contextual keyword — an Ident)
        self.advance();
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var branches: Vec<Vec<Stmt>> = Vec::new();
        // Parse branches separated by '|'
        // Optional leading '|' before the first branch
        self.match_tok(TokenKind::Pipe);
        while !self.check(TokenKind::RBrace) && !self.is_at_end() {
            var branch: Vec<Stmt> = Vec::new();
            while !self.check(TokenKind::Pipe) && !self.check(TokenKind::RBrace) && !self.is_at_end() {
                match self.parse_stmt() {
                    ParseResultStmt::Ok(stmt) => {
                        branch.push(stmt);
                    }
                    ParseResultStmt::Err(e) => {
                        self.push_parse_error(e);
                        self.recover_to_sync_token();
                    }
                }
            }
            branches.push(branch);
            // Consume the '|' separator
            if self.check(TokenKind::Pipe) {
                self.advance();
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultStmt::Ok(Stmt::Parallel(branches, line));
    }

    fn parse_let(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        var k: TokenKind = self.peek();
        var is_mut: bool = false;
        if token_kind_eq(k, TokenKind::Val) {
            self.advance();
            is_mut = false;
        } else if token_kind_eq(k, TokenKind::Var) {
            self.advance();
            is_mut = true;
        } else {
            return ParseResultStmt::Err("expected 'val' or 'var' at line " + int_to_str(line));
        }

        // Tuple destructuring: val (a, b) = expr
        if self.check(TokenKind::LParen) {
            self.advance();
            var names: Vec<str> = Vec::new();
            if !self.check(TokenKind::RParen) {
                loop {
                    var name: str = "";
                    match self.expect_ident_or_keyword() {
                        ParseResultStr::Ok(s) => {
                            name = s;
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultStmt::Err(e);
                        }
                    }
                    names.push(name);
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            match self.expect(TokenKind::Eq, "=") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var expr: Expr = Expr::IntLit(0);
            match self.parse_expr() {
                ParseResultExpr::Ok(e) => {
                    expr = e;
                }
                ParseResultExpr::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            self.match_tok(TokenKind::Semicolon);
            return ParseResultStmt::Ok(Stmt::LetTuple(names, expr, line, is_mut));
        }

        var name: str = "";
        match self.expect_ident_or_keyword() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }

        var ty: OptType = OptType::None;
        var lanns: Vec<Annotation> = Vec::new();
        if self.match_tok(TokenKind::Colon) {
            self.g_sequential_type = false;
            match self.parse_type() {
                ParseResultType::Ok(t) => {
                    ty = OptType::Some(t);
                    // 0008: Vec<E..> — the sequential flag the type parse set
                    if self.g_sequential_type {
                        var sa: Vec<str> = Vec::new();
                        lanns.push(Annotation_new("sequential", sa));
                        self.g_sequential_type = false;
                    }
                }
                ParseResultType::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
        }

        // var x: i32; without = -> uninitialized
        if is_mut && self.check(TokenKind::Semicolon) {
            self.advance();
            match ty {
                OptType::Some(t) => {
                    return ParseResultStmt::Ok(Stmt::LetUninit(name, t, lanns, line));
                }
                OptType::None => {
                    return ParseResultStmt::Err("var " + name + " needs type annotation for uninitialized declaration at line " + int_to_str(line));
                }
            }
        }
        if is_mut && !self.check(TokenKind::Eq) {
            match ty {
                OptType::Some(t) => {
                    self.match_tok(TokenKind::Semicolon);
                    return ParseResultStmt::Ok(Stmt::LetUninit(name, t, lanns, line));
                }
                OptType::None => {
                    return ParseResultStmt::Err("var " + name + " needs type annotation for uninitialized declaration at line " + int_to_str(line));
                }
            }
        }

        match self.expect(TokenKind::Eq, "=") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var expr: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => {
                expr = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        self.match_tok(TokenKind::Semicolon);
        return ParseResultStmt::Ok(Stmt::Let(name, ty, expr, is_mut, false, Vec::new(), line));
    }

    fn parse_persist_let(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Persist, "persist") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var is_mut: bool = false;
        if self.check(TokenKind::Var) {
            self.advance();
            is_mut = true;
        } else {
            match self.expect(TokenKind::Val, "val") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        }
        var name: str = "";
        match self.expect_ident_or_keyword() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        var ty: OptType = OptType::None;
        if self.match_tok(TokenKind::Colon) {
            match self.parse_type() {
                ParseResultType::Ok(t) => {
                    ty = OptType::Some(t);
                }
                ParseResultType::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
        }
        match self.expect(TokenKind::Eq, "=") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var expr: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => {
                expr = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        self.match_tok(TokenKind::Semicolon);
        return ParseResultStmt::Ok(Stmt::Let(name, ty, expr, is_mut, true, Vec::new(), line));
    }

    fn parse_return(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Return, "return") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        if self.check(TokenKind::RBrace) || self.check(TokenKind::Semicolon) {
            self.match_tok(TokenKind::Semicolon);
            return ParseResultStmt::Ok(Stmt::Return(OptBoxExpr::None, line));
        }
        var expr: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => {
                expr = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        self.match_tok(TokenKind::Semicolon);
        return ParseResultStmt::Ok(Stmt::Return(OptBoxExpr::Some(Box::new(expr)), line));
    }

    fn parse_if_expr(self: &mut Parser) -> ParseResultIfExpr {
        match self.expect(TokenKind::If, "if") {
            ParseResultUnit::Err(e) => {
                return ParseResultIfExpr::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var cond: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => {
                cond = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultIfExpr::Err(e);
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultIfExpr::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var then_block: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => {
                then_block = b;
            }
            ParseResultStmts::Err(e) => {
                return ParseResultIfExpr::Err(e);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultIfExpr::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        var else_block: OptStmts = OptStmts::None;
        if self.match_tok(TokenKind::Else) {
            if self.check(TokenKind::If) {
                var line: i64 = self.peek_token().line;
                var nested: IfExpr = IfExpr {
                    cond: Expr::IntLit(0), then_block: Vec::new(), else_block: OptStmts::None,
                };
                match self.parse_if_expr() {
                    ParseResultIfExpr::Ok(ie) => {
                        nested = ie;
                    }
                    ParseResultIfExpr::Err(e) => {
                        return ParseResultIfExpr::Err(e);
                    }
                }
                var stmts: Vec<Stmt> = Vec::new();
                stmts.push(Stmt::If(nested.cond, nested.then_block, nested.else_block, line));
                else_block = OptStmts::Some(stmts);
            } else {
                match self.expect(TokenKind::LBrace, "{") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultIfExpr::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                var block: Vec<Stmt> = Vec::new();
                match self.parse_block() {
                    ParseResultStmts::Ok(b) => {
                        block = b;
                    }
                    ParseResultStmts::Err(e) => {
                        return ParseResultIfExpr::Err(e);
                    }
                }
                match self.expect(TokenKind::RBrace, "}") {
                    ParseResultUnit::Err(e) => {
                        return ParseResultIfExpr::Err(e);
                    }
                    ParseResultUnit::Ok => {
                    }
                }
                else_block = OptStmts::Some(block);
            }
        }

        return ParseResultIfExpr::Ok(IfExpr {
            cond: cond, then_block: then_block, else_block: else_block,
        });
    }

    fn parse_use_stmt(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Use, "use") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var path: str = "";
        loop {
            if self.check(TokenKind::LBrace) {
                break;
            }
            var name: str = "";
            match self.expect_ident_or_keyword() {
                ParseResultStr::Ok(s) => {
                    name = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            path = path + name;
            if self.match_tok(TokenKind::DoubleColon) {
                path = path + "::";
            } else {
                break;
            }
        }
        var items: Vec<str> = Vec::new();
        if self.match_tok(TokenKind::LBrace) {
            if !self.check(TokenKind::RBrace) {
                loop {
                    var item: str = "";
                    match self.expect_ident() {
                        ParseResultStr::Ok(s) => {
                            item = s;
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultStmt::Err(e);
                        }
                    }
                    items.push(item);
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        }
        // An optional `as alias` (a `use` in a body does nothing, as the
        // top-level one does once its module is already imported)
        if self.match_tok(TokenKind::As) {
            match self.expect_ident() {
                ParseResultStr::Ok(_) => {
                }
                ParseResultStr::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
        }
        // A version pin is as wrong here as at top level (reference §2.9)
        if self.check(TokenKind::Eq) {
            var vtok: Token = self.peek_token();
            return ParseResultStmt::Err("Parse error at " + int_to_str(vtok.line) + ":" + int_to_str(vtok.col) + ": a `use` does not take a version pin: `use m = \"1.0\"` is not an import\n    Fix: remove the `= \"...\"`; the path alone says which module.");
        }
        self.match_tok(TokenKind::Semicolon);
        return ParseResultStmt::Ok(Stmt::Use(path, items, line));
    }

    fn parse_handle_stmt(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Handle, "handle") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => {
                body = b;
            }
            ParseResultStmts::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        match self.expect(TokenKind::With, "with") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var handlers: Vec<EffectHandler> = Vec::new();
        while !self.check(TokenKind::RBrace) {
            var effect: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => {
                    effect = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            match self.expect(TokenKind::Dot, ".") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var op: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => {
                    op = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            match self.expect(TokenKind::LParen, "(") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var params: Vec<str> = Vec::new();
            if !self.check(TokenKind::RParen) {
                loop {
                    var p: str = "";
                    match self.expect_ident() {
                        ParseResultStr::Ok(s) => {
                            p = s;
                        }
                        ParseResultStr::Err(e) => {
                            return ParseResultStmt::Err(e);
                        }
                    }
                    params.push(p);
                    if !self.match_tok(TokenKind::Comma) {
                        break;
                    }
                }
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            match self.expect(TokenKind::FatArrow, "=>") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            match self.expect(TokenKind::LBrace, "{") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var handler_body: Vec<Stmt> = Vec::new();
            match self.parse_block() {
                ParseResultStmts::Ok(b) => {
                    handler_body = b;
                }
                ParseResultStmts::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            match self.expect(TokenKind::RBrace, "}") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            handlers.push(EffectHandler_new(effect, op, params, handler_body));
            if !self.match_tok(TokenKind::Comma) {
                break;
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultStmt::Ok(Stmt::Handle(body, handlers, line));
    }

    fn parse_do_stmt(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Do, "do") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var effect: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                effect = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::Dot, ".") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var op: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                op = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::LParen, "(") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var args: Vec<Expr> = Vec::new();
        if !self.check(TokenKind::RParen) {
            loop {
                match self.parse_expr() {
                    ParseResultExpr::Ok(e) => {
                        args.push(e);
                    }
                    ParseResultExpr::Err(e) => {
                        return ParseResultStmt::Err(e);
                    }
                }
                if !self.match_tok(TokenKind::Comma) {
                    break;
                }
            }
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        self.match_tok(TokenKind::Semicolon);
        return ParseResultStmt::Ok(Stmt::Do(effect, op, args, line));
    }

    // L3A: `resume(cont, value)` — call the continuation captured by the
    // enclosing effect handler with the given value.
    fn parse_resume_stmt(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Resume, "resume") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        match self.expect(TokenKind::LParen, "(") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var cont: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => {
                cont = e;
            }
            ParseResultExpr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::Comma, ",") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var value: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e2) => {
                value = e2;
            }
            ParseResultExpr::Err(e2) => {
                return ParseResultStmt::Err(e2);
            }
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        self.match_tok(TokenKind::Semicolon);
        return ParseResultStmt::Ok(Stmt::Resume(cont, value, line));
    }

    // L3B: `spawn scope { body }` — structured concurrency scope
    fn parse_spawn_scope_stmt(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Spawn, "spawn") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        // "scope" is a contextual identifier, not a keyword
        match self.expect_ident() {
            ParseResultStr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultStr::Ok(_) => {
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => {
                body = b;
            }
            ParseResultStmts::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultStmt::Ok(Stmt::SpawnScope(body, line));
    }

    // L3E: `cancel scope;` — cancel all pending tasks in the current spawn scope
    fn parse_cancel_scope_stmt(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect_ident() {
            ParseResultStr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultStr::Ok(_) => {
            }
        }
        match self.expect_ident() {
            ParseResultStr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultStr::Ok(_) => {
            }
        }
        self.match_tok(TokenKind::Semicolon);
        return ParseResultStmt::Ok(Stmt::CancelScope(line));
    }

    // CA8: at the identifier `timeout`: is it `timeout( .. ) {`? The `(`
    // must follow at once and its `)` be followed by `{`; a `;` before the
    // `)` closes means a call.
    fn timeout_block_ahead(self: &Parser) -> bool {
        if self.pos + 3 >= self.tokens.len() {
            return false;
        }
        if !token_kind_eq(self.tokens.get(self.pos + 1).kind, TokenKind::LParen) {
            return false;
        }
        var depth: i64 = 0;
        var i: i64 = self.pos + 1;
        while i < self.tokens.len() {
            var tk: TokenKind = self.tokens.get(i).kind;
            if token_kind_eq(tk, TokenKind::LParen) {
                depth = depth + 1;
            } else if token_kind_eq(tk, TokenKind::RParen) {
                depth = depth - 1;
                if depth == 0 {
                    return i + 1 < self.tokens.len() && token_kind_eq(self.tokens.get(i + 1).kind, TokenKind::LBrace);
                }
            } else if token_kind_eq(tk, TokenKind::Semicolon) || token_kind_eq(tk, TokenKind::Eof) {
                return false;
            }
            i = i + 1;
        }
        return false;
    }

    // CA8: `timeout(ms) { body }`, optionally followed by `else { late }`.
    // The body runs with a token that cancels itself `ms` milliseconds after
    // the block starts installed in the running task's token slot, so every
    // wait inside it that respects cancellation (stdlib/task.fd) gives up at
    // the deadline without being handed the token; the slot gets its old
    // token back when the body ends, however it ends. `late` runs after the
    // body when the deadline passed (or the token was cancelled) while the
    // body ran. Parsed to ordinary statements, so every pass sees ordinary
    // code:
    //     if __timeout_block(ms) { body }
    // and with `else`:
    //     if true { if __timeout_block(ms) { body } if __timeout_expired() { late } }
    // The type checker types both markers as bool; lower.fd
    // Lowerer_lower_timeout runs the body unconditionally with the token
    // installed (docs/reference/timeout-blocks.md).
    fn parse_timeout_stmt(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        self.advance();
        match self.expect(TokenKind::LParen, "(") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var ms: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e2) => {
                ms = e2;
            }
            ParseResultExpr::Err(e2) => {
                return ParseResultStmt::Err(e2);
            }
        }
        match self.expect(TokenKind::RParen, ")") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => {
                body = b;
            }
            ParseResultStmts::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var targs: Vec<Expr> = Vec::new();
        targs.push(ms);
        var guarded: Stmt = Stmt::If(Expr::Call("__timeout_block", targs), body, OptStmts::None, line);
        if !self.check(TokenKind::Else) {
            return ParseResultStmt::Ok(guarded);
        }
        self.advance();
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var late: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b2) => {
                late = b2;
            }
            ParseResultStmts::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var outer: Vec<Stmt> = Vec::new();
        outer.push(guarded);
        var no_args: Vec<Expr> = Vec::new();
        outer.push(Stmt::If(Expr::Call("__timeout_expired", no_args), late, OptStmts::None, line));
        return ParseResultStmt::Ok(Stmt::If(Expr::BoolLit(true), outer, OptStmts::None, line));
    }

    fn parse_region_block(self: &mut Parser) -> ParseResultStmt {
        var line: i64 = self.peek_token().line;
        match self.expect(TokenKind::Region, "region") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }

        // Optional modifier: gpu or kv_cache
        var is_gpu: bool = false;
        var is_kv_cache: bool = false;
        var pk: TokenKind = self.peek();
        match pk {
            TokenKind::Ident(s: str) => {
                if s == "gpu" {
                    self.advance();
                    is_gpu = true;
                } else if s == "kv_cache" {
                    self.advance();
                    is_kv_cache = true;
                }
            }
            _ => {
            }
        }

        var name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => {
                name = s;
            }
            ParseResultStr::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }

        // Optional: with budget(N)
        var budget: OptI64 = OptI64::None;
        if self.match_tok(TokenKind::With) {
            var budget_name: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => {
                    budget_name = s;
                }
                ParseResultStr::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
            }
            if budget_name != "budget" {
                return ParseResultStmt::Err("Expected 'budget' after 'with' in region block, got '" + budget_name + "'");
            }
            match self.expect(TokenKind::LParen, "(") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
            var ntok: Token = self.peek_token();
            match ntok.kind {
                TokenKind::IntLit(n: i64) => {
                    self.advance();
                    budget = OptI64::Some(n);
                }
                _ => {
                }
            }
            match self.expect(TokenKind::RParen, ")") {
                ParseResultUnit::Err(e) => {
                    return ParseResultStmt::Err(e);
                }
                ParseResultUnit::Ok => {
                }
            }
        }

        // Optional: window(W) for KV cache
        var window_size: OptI64 = OptI64::None;
        if is_kv_cache {
            var wtok: Token = self.peek_token();
            match wtok.kind {
                TokenKind::Ident(s: str) => {
                    if s == "window" {
                        self.advance();
                        match self.expect(TokenKind::LParen, "(") {
                            ParseResultUnit::Err(e) => {
                                return ParseResultStmt::Err(e);
                            }
                            ParseResultUnit::Ok => {
                            }
                        }
                        var wval: Token = self.peek_token();
                        match wval.kind {
                            TokenKind::IntLit(w: i64) => {
                                self.advance();
                                window_size = OptI64::Some(w);
                            }
                            _ => {
                            }
                        }
                        match self.expect(TokenKind::RParen, ")") {
                            ParseResultUnit::Err(e) => {
                                return ParseResultStmt::Err(e);
                            }
                            ParseResultUnit::Ok => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
        }

        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => {
                body = b;
            }
            ParseResultStmts::Err(e) => {
                return ParseResultStmt::Err(e);
            }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => {
                return ParseResultStmt::Err(e);
            }
            ParseResultUnit::Ok => {
            }
        }
        return ParseResultStmt::Ok(Stmt::RegionBlock(name, budget, is_gpu, is_kv_cache, window_size, body, line));
    }

