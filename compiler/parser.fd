fn parse_state_machine(self: &mut Parser) -> ParseResultStateMachineDef {
match self.expect(TokenKind::State, "state") {
    ParseResultUnit::Err(e) => { return ParseResultStateMachineDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var name: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { name = s; }
    ParseResultStr::Err(e) => { return ParseResultStateMachineDef::Err(e); }
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultStateMachineDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var states: Vec<StateDef> = Vec::new();
while !self.check(TokenKind::RBrace) && !self.is_at_end() {
    var state_name: str = "";
    match self.expect_ident_or_keyword() {
        ParseResultStr::Ok(s) => { state_name = s; }
        ParseResultStr::Err(e) => { return ParseResultStateMachineDef::Err(e); }
    }
    match self.expect(TokenKind::LBrace, "{") {
        ParseResultUnit::Err(e) => { return ParseResultStateMachineDef::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var transitions: Vec<StateTransition> = Vec::new();
    while !self.check(TokenKind::RBrace) && !self.is_at_end() {
        match self.expect(TokenKind::On, "on") {
            ParseResultUnit::Err(e) => { return ParseResultStateMachineDef::Err(e); }
            ParseResultUnit::Ok => {}
        }
        var event: str = "";
        match self.expect_ident_or_keyword() {
            ParseResultStr::Ok(s) => { event = s; }
            ParseResultStr::Err(e) => { return ParseResultStateMachineDef::Err(e); }
        }
        match self.expect(TokenKind::FatArrow, "=>") {
            ParseResultUnit::Err(e) => { return ParseResultStateMachineDef::Err(e); }
            ParseResultUnit::Ok => {}
        }
        var target: str = "";
        match self.expect_ident_or_keyword() {
            ParseResultStr::Ok(s) => { target = s; }
            ParseResultStr::Err(e) => { return ParseResultStateMachineDef::Err(e); }
        }
        transitions.push(StateTransition_new(event, target));
        self.match_tok(TokenKind::Comma);
    }
    match self.expect(TokenKind::RBrace, "}") {
        ParseResultUnit::Err(e) => { return ParseResultStateMachineDef::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var msd: StateDef = StateDef_new(state_name);
    msd.transitions = transitions;
    states.push(msd);
    self.match_tok(TokenKind::Comma);
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultStateMachineDef::Err(e); }
    ParseResultUnit::Ok => {}
}
self.enum_names.push(name);
HashMap_insert(self.enum_name_set, name, 1);
var __ret_StateMachineDef: StateMachineDef = StateMachineDef_new(name, false);
__ret_StateMachineDef.states = states;
return ParseResultStateMachineDef::Ok(__ret_StateMachineDef);
}

fn parse_event_handler(self: &mut Parser) -> ParseResultEventHandlerDef {
match self.expect(TokenKind::On, "on") {
    ParseResultUnit::Err(e) => { return ParseResultEventHandlerDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var event_name: str = "";
match self.expect_ident_or_keyword() {
    ParseResultStr::Ok(s) => { event_name = s; }
    ParseResultStr::Err(e) => { return ParseResultEventHandlerDef::Err(e); }
}
match self.expect(TokenKind::LParen, "(") {
    ParseResultUnit::Err(e) => { return ParseResultEventHandlerDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var params: Vec<Param> = Vec::new();
match self.parse_params() {
    ParseResultParams::Ok(p) => { params = p; }
    ParseResultParams::Err(e) => { return ParseResultEventHandlerDef::Err(e); }
}
match self.expect(TokenKind::RParen, ")") {
    ParseResultUnit::Err(e) => { return ParseResultEventHandlerDef::Err(e); }
    ParseResultUnit::Ok => {}
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultEventHandlerDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var body: Vec<Stmt> = Vec::new();
match self.parse_block() {
    ParseResultStmts::Ok(b) => { body = b; }
    ParseResultStmts::Err(e) => { return ParseResultEventHandlerDef::Err(e); }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultEventHandlerDef::Err(e); }
    ParseResultUnit::Ok => {}
}
var __ret_EventHandlerDef: EventHandlerDef = EventHandlerDef_new(event_name);
__ret_EventHandlerDef.params = params;
__ret_EventHandlerDef.body = body;
return ParseResultEventHandlerDef::Ok(__ret_EventHandlerDef);
}

fn parse_type(self: &mut Parser) -> ParseResultType {
var tok: Token = self.peek_token();
var k: TokenKind = tok.kind;

// Function type: fn(params) -> ret
if token_kind_eq(k, TokenKind::Fn) {
    self.advance();
    match self.expect(TokenKind::LParen, "(") {
        ParseResultUnit::Err(e) => { return ParseResultType::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var params: Vec<Type> = Vec::new();
    if !self.check(TokenKind::RParen) {
        loop {
            match self.parse_type() {
                ParseResultType::Ok(t) => { params.push(t); }
                ParseResultType::Err(e) => { return ParseResultType::Err(e); }
            }
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::RParen, ")") {
        ParseResultUnit::Err(e) => { return ParseResultType::Err(e); }
        ParseResultUnit::Ok => {}
    }
    match self.expect(TokenKind::Arrow, "->") {
        ParseResultUnit::Err(e) => { return ParseResultType::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var ret: Type = Type::Void;
    match self.parse_type() {
        ParseResultType::Ok(t) => { ret = t; }
        ParseResultType::Err(e) => { return ParseResultType::Err(e); }
    }
    return ParseResultType::Ok(Type::Func(params, Box::new(ret)));
}

// Primitive type keywords
if token_kind_eq(k, TokenKind::I8) { self.advance(); return ParseResultType::Ok(Type::I8); }
if token_kind_eq(k, TokenKind::I16) { self.advance(); return ParseResultType::Ok(Type::I16); }
if token_kind_eq(k, TokenKind::I32) { self.advance(); return ParseResultType::Ok(Type::I32); }
if token_kind_eq(k, TokenKind::I64) { self.advance(); return ParseResultType::Ok(Type::I64); }
if token_kind_eq(k, TokenKind::I128) { self.advance(); return ParseResultType::Ok(Type::I128); }
if token_kind_eq(k, TokenKind::U8) { self.advance(); return ParseResultType::Ok(Type::U8); }
if token_kind_eq(k, TokenKind::U16) { self.advance(); return ParseResultType::Ok(Type::U16); }
if token_kind_eq(k, TokenKind::U32) { self.advance(); return ParseResultType::Ok(Type::U32); }
if token_kind_eq(k, TokenKind::U64) { self.advance(); return ParseResultType::Ok(Type::U64); }
if token_kind_eq(k, TokenKind::U128) { self.advance(); return ParseResultType::Ok(Type::U128); }
if token_kind_eq(k, TokenKind::F32) { self.advance(); return ParseResultType::Ok(Type::F32); }
if token_kind_eq(k, TokenKind::F64) { self.advance(); return ParseResultType::Ok(Type::F64); }
if token_kind_eq(k, TokenKind::Bool) { self.advance(); return ParseResultType::Ok(Type::Bool); }
// `-> !`: the function never returns.
if token_kind_eq(k, TokenKind::Bang) { self.advance(); return ParseResultType::Ok(Type::Never); }
if token_kind_eq(k, TokenKind::Str) { self.advance(); return ParseResultType::Ok(Type::Str); }
if token_kind_eq(k, TokenKind::Void) { self.advance(); return ParseResultType::Ok(Type::Void); }

// dyn Trait
if token_kind_eq(k, TokenKind::Dyn) {
    self.advance();
    var trait_name: str = "";
    match self.expect_ident() {
        ParseResultStr::Ok(s) => { trait_name = s; }
        ParseResultStr::Err(e) => { return ParseResultType::Err(e); }
    }
    return ParseResultType::Ok(Type::Dyn(trait_name));
}

// Identifier-based types
if token_kind_eq(k, TokenKind::Ident("")) {
    // Extract the ident payload
    var s: str = "";
    match tok.kind {
        TokenKind::Ident(name: str) => { s = name; }
    }
    self.advance();
    if s == "_" {
        return ParseResultType::Ok(Type::Infer);
    }
    // Associated type: T::Item or GAT T::Item<X>
    if self.check(TokenKind::DoubleColon) {
        self.advance();
        var assoc_name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(an) => { assoc_name = an; }
            ParseResultStr::Err(e) => { return ParseResultType::Err(e); }
        }
        var type_args: Vec<Type> = Vec::new();
        if self.check(TokenKind::Lt) {
            self.advance();
            if !self.check(TokenKind::Gt) {
                loop {
                    match self.parse_type() {
                        ParseResultType::Ok(ta) => { type_args.push(ta); }
                        ParseResultType::Err(e) => { return ParseResultType::Err(e); }
                    }
                    if !self.match_tok(TokenKind::Comma) { break; }
                    if self.check(TokenKind::Gt) { break; }
                }
            }
            match self.expect(TokenKind::Gt, ">") {
                ParseResultUnit::Err(e) => { return ParseResultType::Err(e); }
                ParseResultUnit::Ok => {}
            }
        }
        return ParseResultType::Ok(Type::Assoc(s, "", assoc_name, type_args));
    }
    // Generic type args: Name<T, U>
    if self.check(TokenKind::Lt) {
        self.advance();
        // Special case: Tensor<elem, [dims]> -> ShapedTensor
        if s == "Tensor" {
            var elem: Type = Type::Void;
            match self.parse_type() {
                ParseResultType::Ok(t) => { elem = t; }
                ParseResultType::Err(e) => { return ParseResultType::Err(e); }
            }
            if self.match_tok(TokenKind::Comma) {
                if self.match_tok(TokenKind::LBracket) {
                    var shape: Vec<ShapeDim> = Vec::new();
                    if !self.check(TokenKind::RBracket) {
                        loop {
                            var dtok: Token = self.peek_token();
                            match dtok.kind {
                                TokenKind::IntLit(n: i64) => {
                                    self.advance();
                                    shape.push(ShapeDim::Known(n));
                                }
                                TokenKind::Ident(name: str) => {
                                    self.advance();
                                    shape.push(ShapeDim::Symbolic(name));
                                }
                            }
                            if !self.match_tok(TokenKind::Comma) { break; }
                        }
                    }
                    match self.expect(TokenKind::RBracket, "]") {
                        ParseResultUnit::Err(e) => { return ParseResultType::Err(e); }
                        ParseResultUnit::Ok => {}
                    }
                    match self.expect(TokenKind::Gt, ">") {
                        ParseResultUnit::Err(e) => { return ParseResultType::Err(e); }
                        ParseResultUnit::Ok => {}
                    }
                    return ParseResultType::Ok(Type::ShapedTensor(Box::new(elem), shape));
                }
            }
            // Fallback: Tensor<elem> -> Generic
            match self.expect(TokenKind::Gt, ">") {
                ParseResultUnit::Err(e) => { return ParseResultType::Err(e); }
                ParseResultUnit::Ok => {}
            }
            var args: Vec<Type> = Vec::new();
            args.push(elem);
            return ParseResultType::Ok(Type::Generic(s, args));
        }

        var args: Vec<Type> = Vec::new();
        if !self.check(TokenKind::Gt) {
            loop {
                match self.parse_type() {
                    ParseResultType::Ok(t) => { args.push(t); }
                    ParseResultType::Err(e) => { return ParseResultType::Err(e); }
                }
                if !self.match_tok(TokenKind::Comma) { break; }
            }
        }
        match self.expect(TokenKind::Gt, ">") {
            ParseResultUnit::Err(e) => { return ParseResultType::Err(e); }
            ParseResultUnit::Ok => {}
        }
        return ParseResultType::Ok(Type::Generic(s, args));
    }
    return ParseResultType::Ok(Type::Named(s));
}

// Tuple type: (T, U, ...) or unit ()
if token_kind_eq(k, TokenKind::LParen) {
    self.advance();
    var types: Vec<Type> = Vec::new();
    if !self.check(TokenKind::RParen) {
        loop {
            match self.parse_type() {
                ParseResultType::Ok(t) => { types.push(t); }
                ParseResultType::Err(e) => { return ParseResultType::Err(e); }
            }
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::RParen, ")") {
        ParseResultUnit::Err(e) => { return ParseResultType::Err(e); }
        ParseResultUnit::Ok => {}
    }
    if types.len() == 1 {
        return ParseResultType::Ok(types.get(0));
    }
    return ParseResultType::Ok(Type::Tuple(types));
}

// Reference type: &T or &mut T
if token_kind_eq(k, TokenKind::Ampersand) {
    self.advance();
    var is_mut: bool = self.match_tok(TokenKind::Mut);
    var inner: Type = Type::Void;
    match self.parse_type() {
        ParseResultType::Ok(t) => { inner = t; }
        ParseResultType::Err(e) => { return ParseResultType::Err(e); }
    }
    return ParseResultType::Ok(Type::Ref(Box::new(inner), is_mut));
}

// Raw pointer: *mut T or *const T
if token_kind_eq(k, TokenKind::Star) {
    self.advance();
    var is_mut: bool = false;
    if self.check(TokenKind::Mut) {
        self.advance();
        is_mut = true;
    } else if self.check(TokenKind::Const) {
        self.advance();
        is_mut = false;
    }
    var inner: Type = Type::Void;
    match self.parse_type() {
        ParseResultType::Ok(t) => { inner = t; }
        ParseResultType::Err(e) => { return ParseResultType::Err(e); }
    }
    return ParseResultType::Ok(Type::RawPtr(Box::new(inner), is_mut));
}

// Array type: [T; N] or [T; NAME]
if token_kind_eq(k, TokenKind::LBracket) {
    self.advance();
    var elem: Type = Type::Void;
    match self.parse_type() {
        ParseResultType::Ok(t) => { elem = t; }
        ParseResultType::Err(e) => { return ParseResultType::Err(e); }
    }
    match self.expect(TokenKind::Semicolon, ";") {
        ParseResultUnit::Err(e) => { return ParseResultType::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var size_tok: Token = self.peek_token();
    match size_tok.kind {
        TokenKind::IntLit(n: i64) => {
            self.advance();
            match self.expect(TokenKind::RBracket, "]") {
                ParseResultUnit::Err(e) => { return ParseResultType::Err(e); }
                ParseResultUnit::Ok => {}
            }
            return ParseResultType::Ok(Type::Array(Box::new(elem), n));
        }
        TokenKind::Ident(name: str) => {
            self.advance();
            match self.expect(TokenKind::RBracket, "]") {
                ParseResultUnit::Err(e) => { return ParseResultType::Err(e); }
                ParseResultUnit::Ok => {}
            }
            return ParseResultType::Ok(Type::ArrayConst(Box::new(elem), name));
        }
    }
    return ParseResultType::Err(
        "Parse error at " + int_to_str(size_tok.line) + ":" + int_to_str(size_tok.col) +
        ": expected array size but got '" + token_kind_to_str(size_tok.kind) + "'"
    );
}

return ParseResultType::Err(
    "Parse error at " + int_to_str(tok.line) + ":" + int_to_str(tok.col) +
    ": expected type but got '" + token_kind_to_str(tok.kind) + "'"
);
}

fn parse_block(self: &mut Parser) -> ParseResultStmts {
var stmts: Vec<Stmt> = Vec::new();
while !self.check(TokenKind::RBrace) && !self.is_at_end() {
    match self.parse_stmt() {
        ParseResultStmt::Ok(stmt) => { stmts.push(stmt); }
        ParseResultStmt::Err(e) => {
            self.errors.push(e);
            self.recover_to_sync_token();
        }
    }
}
return ParseResultStmts::Ok(stmts);
}

fn parse_stmt(self: &mut Parser) -> ParseResultStmt {
var k: TokenKind = self.peek();

// @annotation(s) on local variable declarations (e.g. @zeroize, @secret)
if token_kind_eq(k, TokenKind::At) {
    var annotations: Vec<Annotation> = Vec::new();
    while self.check(TokenKind::At) {
        match self.parse_at_annotation() {
            ParseResultAnnotation::Ok(a) => { annotations.push(a); }
            ParseResultAnnotation::Err(e) => { return ParseResultStmt::Err(e); }
        }
    }
    // The annotated statement must be a val/var declaration
    var k2: TokenKind = self.peek();
    if token_kind_eq(k2, TokenKind::Val) || token_kind_eq(k2, TokenKind::Var) {
        match self.parse_let() {
            ParseResultStmt::Ok(stmt) => {
                // Inject annotations into the Let/LetUninit statement
                match stmt {
                    Stmt::Let(n, ty, e, im, p, _anns, ln) => {
                        return ParseResultStmt::Ok(Stmt::Let(n, ty, e, im, p, annotations, ln));
                    }
                    Stmt::LetUninit(n, t, _anns, ln) => {
                        return ParseResultStmt::Ok(Stmt::LetUninit(n, t, annotations, ln));
                    }
                    _ => {
                        return ParseResultStmt::Err("@annotations can only be applied to val/var declarations at line " + int_to_str(self.peek_token().line));
                    }
                }
            }
            ParseResultStmt::Err(e) => { return ParseResultStmt::Err(e); }
        }
    }
    return ParseResultStmt::Err("@annotations on statements require a val/var declaration at line " + int_to_str(self.peek_token().line));
}

if token_kind_eq(k, TokenKind::Persist) { return self.parse_persist_let(); }
if token_kind_eq(k, TokenKind::Val) { return self.parse_let(); }
if token_kind_eq(k, TokenKind::Var) { return self.parse_let(); }
if token_kind_eq(k, TokenKind::Return) { return self.parse_return(); }
if token_kind_eq(k, TokenKind::Query) { return self.parse_query_stmt(); }
if token_kind_eq(k, TokenKind::If) {
    var line: i64 = self.peek_token().line;
    var if_expr: IfExpr = IfExpr {
        cond: Expr::IntLit(0),
        then_block: Vec::new(),
        else_block: OptStmts::None,
    };
    match self.parse_if_expr() {
        ParseResultIfExpr::Ok(ie) => { if_expr = ie; }
        ParseResultIfExpr::Err(e) => { return ParseResultStmt::Err(e); }
    }
    return ParseResultStmt::Ok(Stmt::If(
        if_expr.cond, if_expr.then_block, if_expr.else_block, line
    ));
}
if token_kind_eq(k, TokenKind::While) { return self.parse_while(); }
if token_kind_eq(k, TokenKind::For) { return self.parse_for(); }
if token_kind_eq(k, TokenKind::Loop) { return self.parse_loop(); }
if token_kind_eq(k, TokenKind::Break) {
    var line: i64 = self.peek_token().line;
    self.advance();
    if self.check(TokenKind::Semicolon) || self.check(TokenKind::RBrace) {
        self.match_tok(TokenKind::Semicolon);
        return ParseResultStmt::Ok(Stmt::Break(OptBoxExpr::None, line));
    }
    var expr: Expr = Expr::IntLit(0);
    match self.parse_expr() {
        ParseResultExpr::Ok(e) => { expr = e; }
        ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
    }
    self.match_tok(TokenKind::Semicolon);
    return ParseResultStmt::Ok(Stmt::Break(OptBoxExpr::Some(Box::new(expr)), line));
}
if token_kind_eq(k, TokenKind::Continue) {
    var line: i64 = self.peek_token().line;
    self.advance();
    self.match_tok(TokenKind::Semicolon);
    return ParseResultStmt::Ok(Stmt::Continue(line));
}
if token_kind_eq(k, TokenKind::Defer) {
    var line: i64 = self.peek_token().line;
    self.advance();
    match self.expect(TokenKind::LBrace, "{") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var body: Vec<Stmt> = Vec::new();
    match self.parse_block() {
        ParseResultStmts::Ok(b) => { body = b; }
        ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
    }
    match self.expect(TokenKind::RBrace, "}") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    return ParseResultStmt::Ok(Stmt::Defer(body, line));
}
if token_kind_eq(k, TokenKind::Match) { return self.parse_match_stmt(); }
if token_kind_eq(k, TokenKind::Select) { return self.parse_select_stmt(); }
if token_kind_eq(k, TokenKind::Use) { return self.parse_use_stmt(); }
if token_kind_eq(k, TokenKind::Handle) { return self.parse_handle_stmt(); }
if token_kind_eq(k, TokenKind::Do) { return self.parse_do_stmt(); }
if token_kind_eq(k, TokenKind::Resume) { return self.parse_resume_stmt(); }
// L3B: `spawn scope { body }` — structured concurrency scope (contextual:
// only when spawn is followed by ident "scope" and '{')
if token_kind_eq(k, TokenKind::Spawn) && self.pos + 2 < self.tokens.len() {
    var ss_next: Token = self.tokens.get(self.pos + 1);
    var ss_next2: Token = self.tokens.get(self.pos + 2);
    match ss_next.kind {
        TokenKind::Ident(scope_name) => {
            if scope_name == "scope" && token_kind_eq(ss_next2.kind, TokenKind::LBrace) {
                return self.parse_spawn_scope_stmt();
            }
        }
        _ => {}
    }
}
// L3E: `cancel scope;` — cancel all tasks in the current spawn scope
match k {
    TokenKind::Ident(cancel_name) => {
        if cancel_name == "cancel" && self.pos + 1 < self.tokens.len() {
            var c_next: Token = self.tokens.get(self.pos + 1);
            match c_next.kind {
                TokenKind::Ident(scope_name2) => {
                    if scope_name2 == "scope" {
                        return self.parse_cancel_scope_stmt();
                    }
                }
                _ => {}
            }
        }
    }
    _ => {}
}
if token_kind_eq(k, TokenKind::Region) { return self.parse_region_block(); }
if token_kind_eq(k, TokenKind::Sandbox) { return self.parse_sandbox_block(); }
if token_kind_eq(k, TokenKind::Unsafe) { return self.parse_unsafe_block(); }
if token_kind_eq(k, TokenKind::Txn) { return self.parse_txn_block(); }
if token_kind_eq(k, TokenKind::Grad) { return self.parse_grad_block(); }
if token_kind_eq(k, TokenKind::Backward) {
    var line: i64 = self.peek_token().line;
    self.advance();
    match self.expect(TokenKind::LParen, "(") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var loss: Expr = Expr::IntLit(0);
    match self.parse_expr() {
        ParseResultExpr::Ok(e) => { loss = e; }
        ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
    }
    match self.expect(TokenKind::RParen, ")") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    self.match_tok(TokenKind::Semicolon);
    return ParseResultStmt::Ok(Stmt::Backward(loss, line));
}
if token_kind_eq(k, TokenKind::Comptime) {
    var line: i64 = self.peek_token().line;
    self.advance();
    // comptime gen { block }
    var peek_k: TokenKind = self.peek();
    match peek_k {
        TokenKind::Ident(name: str) => {
            if name == "gen" {
                self.advance();
                match self.expect(TokenKind::LBrace, "{") {
                    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
                    ParseResultUnit::Ok => {}
                }
                var block: Vec<Stmt> = Vec::new();
                match self.parse_block() {
                    ParseResultStmts::Ok(b) => { block = b; }
                    ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
                }
                match self.expect(TokenKind::RBrace, "}") {
                    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
                    ParseResultUnit::Ok => {}
                }
                return ParseResultStmt::Ok(Stmt::ComptimeGen(block, line));
            }
        }
    }
    var expr: Expr = Expr::IntLit(0);
    match self.parse_comptime_expr(line) {
        ParseResultExpr::Ok(e) => { expr = e; }
        ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
    }
    return ParseResultStmt::Ok(Stmt::Expr(expr, line));
}
if token_kind_eq(k, TokenKind::Guard) { return self.parse_guard_stmt(); }

// F13: parallel { | branch1 | branch2 | ... } — contextual keyword
if token_kind_eq(k, TokenKind::Ident("")) {
    match k {
        TokenKind::Ident(s: str) => {
            if s == "parallel" {
                return self.parse_parallel_stmt();
            }
        }
    }
}

return self.parse_assign_or_expr();
}

fn parse_assign_or_expr(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
var expr: Expr = Expr::IntLit(0);
match self.parse_expr() {
    ParseResultExpr::Ok(e) => { expr = e; }
    ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
}

// Check for assignment operator
var assign_op: AssignOp = AssignOp::Assign;
var has_assign: bool = true;
var k: TokenKind = self.peek();
if token_kind_eq(k, TokenKind::Eq) { assign_op = AssignOp::Assign; }
else if token_kind_eq(k, TokenKind::PlusEq) { assign_op = AssignOp::AddAssign; }
else if token_kind_eq(k, TokenKind::MinusEq) { assign_op = AssignOp::SubAssign; }
else if token_kind_eq(k, TokenKind::StarEq) { assign_op = AssignOp::MulAssign; }
else if token_kind_eq(k, TokenKind::SlashEq) { assign_op = AssignOp::DivAssign; }
else if token_kind_eq(k, TokenKind::PercentEq) { assign_op = AssignOp::ModAssign; }
else if token_kind_eq(k, TokenKind::AmpEq) { assign_op = AssignOp::BitAndAssign; }
else if token_kind_eq(k, TokenKind::PipeEq) { assign_op = AssignOp::BitOrAssign; }
else if token_kind_eq(k, TokenKind::CaretEq) { assign_op = AssignOp::BitXorAssign; }
else if token_kind_eq(k, TokenKind::ShlEq) { assign_op = AssignOp::ShlAssign; }
else if token_kind_eq(k, TokenKind::ShrEq) { assign_op = AssignOp::ShrAssign; }
else { has_assign = false; }

if has_assign {
    self.advance();
    // Match the assignment target shape
    match expr {
        Expr::Ident(name) => {
            var rhs: Expr = Expr::IntLit(0);
            match self.parse_expr() {
                ParseResultExpr::Ok(e) => { rhs = e; }
                ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
            }
            self.match_tok(TokenKind::Semicolon);
            return ParseResultStmt::Ok(Stmt::Assign(name, assign_op, rhs, line));
        }
        Expr::Index(array, index) => {
            match array {
                Expr::Ident(name) => {
                    var rhs: Expr = Expr::IntLit(0);
                    match self.parse_expr() {
                        ParseResultExpr::Ok(e) => { rhs = e; }
                        ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
                    }
                    self.match_tok(TokenKind::Semicolon);
                    return ParseResultStmt::Ok(Stmt::IndexAssign(name, box_expr_deref(index), assign_op, rhs, line));
                }
            }
            return ParseResultStmt::Err("Parse error: index assignment target must be an array variable");
        }
        Expr::Deref(ptr_expr) => {
            var rhs: Expr = Expr::IntLit(0);
            match self.parse_expr() {
                ParseResultExpr::Ok(e) => { rhs = e; }
                ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
            }
            self.match_tok(TokenKind::Semicolon);
            return ParseResultStmt::Ok(Stmt::DerefAssign(box_expr_deref(ptr_expr), assign_op, rhs, line));
        }
        Expr::FieldAccess(obj_expr, field) => {
            var rhs: Expr = Expr::IntLit(0);
            match self.parse_expr() {
                ParseResultExpr::Ok(e) => { rhs = e; }
                ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
            }
            self.match_tok(TokenKind::Semicolon);
            return ParseResultStmt::Ok(Stmt::FieldAssign(box_expr_deref(obj_expr), field, assign_op, rhs, line));
        }
    }
    var err_tok: Token = self.peek_token();
    var err_msg: str = "Parse error: assignment target must be an identifier or array index at line ";
    err_msg = err_msg + int_to_str(err_tok.line) + " col " + int_to_str(err_tok.col);
    return ParseResultStmt::Err(err_msg);
}

self.match_tok(TokenKind::Semicolon);
return ParseResultStmt::Ok(Stmt::Expr(expr, line));
}

fn parse_while(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::While, "while") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var cond: Expr = Expr::IntLit(0);
match self.parse_expr() {
    ParseResultExpr::Ok(e) => { cond = e; }
    ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var body: Vec<Stmt> = Vec::new();
match self.parse_block() {
    ParseResultStmts::Ok(b) => { body = b; }
    ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultStmt::Ok(Stmt::While(cond, body, line));
}

fn parse_guard_stmt(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::Guard, "guard") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var cond: Expr = Expr::IntLit(0);
match self.parse_expr() {
    ParseResultExpr::Ok(e) => { cond = e; }
    ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::FatArrow, "=>") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var then_block: Vec<Stmt> = Vec::new();
if self.check(TokenKind::LBrace) {
    self.advance();
    match self.parse_block() {
        ParseResultStmts::Ok(b) => { then_block = b; }
        ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
    }
    match self.expect(TokenKind::RBrace, "}") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
} else {
    match self.parse_stmt() {
        ParseResultStmt::Ok(s) => { then_block.push(s); }
        ParseResultStmt::Err(e) => { return ParseResultStmt::Err(e); }
    }
}
// Desugar: guard cond => action  ->  if !cond { action }
return ParseResultStmt::Ok(Stmt::If(Expr::Unary(UnaryOp::Not, Box::new(cond)), then_block, OptStmts::None, line));
}

fn parse_for(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::For, "for") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var loop_var: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { loop_var = s; }
    ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::In, "in") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var iterator: Expr = Expr::IntLit(0);
match self.parse_expr() {
    ParseResultExpr::Ok(e) => { iterator = e; }
    ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var body: Vec<Stmt> = Vec::new();
match self.parse_block() {
    ParseResultStmts::Ok(b) => { body = b; }
    ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultStmt::Ok(Stmt::For(loop_var, iterator, body, line));
}

fn parse_loop(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::Loop, "loop") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var body: Vec<Stmt> = Vec::new();
match self.parse_block() {
    ParseResultStmts::Ok(b) => { body = b; }
    ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultStmt::Ok(Stmt::Loop(body, line));
}

fn parse_query_stmt(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::Query, "query") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
match self.expect(TokenKind::LParen, "(") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var components: Vec<str> = Vec::new();
if !self.check(TokenKind::RParen) {
    loop {
        var comp_name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => { comp_name = s; }
            ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
        }
        components.push(comp_name);
        if !self.match_tok(TokenKind::Comma) { break; }
    }
}
match self.expect(TokenKind::RParen, ")") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var body: Vec<Stmt> = Vec::new();
match self.parse_block() {
    ParseResultStmts::Ok(b) => { body = b; }
    ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultStmt::Ok(Stmt::Query(components, body, line));
}

fn parse_match_stmt(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::Match, "match") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var expr: Expr = Expr::IntLit(0);
match self.parse_expr() {
    ParseResultExpr::Ok(e) => { expr = e; }
    ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var arms: Vec<MatchArm> = Vec::new();
while !self.check(TokenKind::RBrace) && !self.is_at_end() {
    var pattern: Pattern = Pattern::Wildcard;
    match self.parse_pattern() {
        ParseResultPattern::Ok(p) => { pattern = p; }
        ParseResultPattern::Err(e) => { return ParseResultStmt::Err(e); }
    }
    var match_guard: OptBoxExpr = OptBoxExpr::None;
    if self.check(TokenKind::If) {
        self.advance();
        match self.parse_expr() {
            ParseResultExpr::Ok(g) => { match_guard = OptBoxExpr::Some(Box::new(g)); }
            ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
        }
    }
    match self.expect(TokenKind::FatArrow, "=>") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    match self.expect(TokenKind::LBrace, "{") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var body: Vec<Stmt> = Vec::new();
    match self.parse_block() {
        ParseResultStmts::Ok(b) => { body = b; }
        ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
    }
    match self.expect(TokenKind::RBrace, "}") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    self.match_tok(TokenKind::Comma);
    arms.push(MatchArm_new(pattern, match_guard, body));
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultStmt::Ok(Stmt::Match(expr, arms, line));
}

fn parse_select_stmt(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::Select, "select") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var cases: Vec<SelectCase> = Vec::new();
var default: OptStmts = OptStmts::None;
while !self.check(TokenKind::RBrace) && !self.is_at_end() {
    var ident: str = "";
    match self.expect_ident() {
        ParseResultStr::Ok(s) => { ident = s; }
        ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
    }
    if ident == "default" {
        match self.expect(TokenKind::FatArrow, "=>") {
            ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
            ParseResultUnit::Ok => {}
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
            ParseResultUnit::Ok => {}
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => { body = b; }
            ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
            ParseResultUnit::Ok => {}
        }
        default = OptStmts::Some(body);
        self.match_tok(TokenKind::Comma);
    } else if ident == "case" {
        var channel: Expr = Expr::IntLit(0);
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => { channel = e; }
            ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
        }
        match self.expect(TokenKind::FatArrow, "=>") {
            ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
            ParseResultUnit::Ok => {}
        }
        var var_name: str = "";
        match self.expect_ident() {
            ParseResultStr::Ok(s) => { var_name = s; }
            ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
        }
        match self.expect(TokenKind::FatArrow, "=>") {
            ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
            ParseResultUnit::Ok => {}
        }
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
            ParseResultUnit::Ok => {}
        }
        var body: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => { body = b; }
            ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
            ParseResultUnit::Ok => {}
        }
        self.match_tok(TokenKind::Comma);
        cases.push(SelectCase_new(channel, var_name, body));
    } else {
        return ParseResultStmt::Err("Expected 'case' or 'default' in select, got '" + ident + "'");
    }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultStmt::Ok(Stmt::Select(cases, default, line));
}

fn parse_parallel_stmt(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
// Consume 'parallel' keyword (contextual keyword — an Ident)
self.advance();
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var branches: Vec<Vec<Stmt>> = Vec::new();
// Parse branches separated by '|'
// Optional leading '|' before the first branch
self.match_tok(TokenKind::Pipe);
while !self.check(TokenKind::RBrace) && !self.is_at_end() {
    var branch: Vec<Stmt> = Vec::new();
    while !self.check(TokenKind::Pipe) && !self.check(TokenKind::RBrace) && !self.is_at_end() {
        match self.parse_stmt() {
            ParseResultStmt::Ok(stmt) => { branch.push(stmt); }
            ParseResultStmt::Err(e) => {
                self.errors.push(e);
                self.recover_to_sync_token();
            }
        }
    }
    branches.push(branch);
    // Consume the '|' separator
    if self.check(TokenKind::Pipe) {
        self.advance();
    }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultStmt::Ok(Stmt::Parallel(branches, line));
}

fn parse_let(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
var k: TokenKind = self.peek();
var is_mut: bool = false;
if token_kind_eq(k, TokenKind::Val) {
    self.advance();
    is_mut = false;
} else if token_kind_eq(k, TokenKind::Var) {
    self.advance();
    is_mut = true;
} else {
    return ParseResultStmt::Err("expected 'val' or 'var' at line " + int_to_str(line));
}

// Tuple destructuring: val (a, b) = expr
if self.check(TokenKind::LParen) {
    self.advance();
    var names: Vec<str> = Vec::new();
    if !self.check(TokenKind::RParen) {
        loop {
            var name: str = "";
            match self.expect_ident_or_keyword() {
                ParseResultStr::Ok(s) => { name = s; }
                ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
            }
            names.push(name);
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::RParen, ")") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    match self.expect(TokenKind::Eq, "=") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var expr: Expr = Expr::IntLit(0);
    match self.parse_expr() {
        ParseResultExpr::Ok(e) => { expr = e; }
        ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
    }
    self.match_tok(TokenKind::Semicolon);
    return ParseResultStmt::Ok(Stmt::LetTuple(names, expr, line));
}

var name: str = "";
match self.expect_ident_or_keyword() {
    ParseResultStr::Ok(s) => { name = s; }
    ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
}

var ty: OptType = OptType::None;
if self.match_tok(TokenKind::Colon) {
    match self.parse_type() {
        ParseResultType::Ok(t) => { ty = OptType::Some(t); }
        ParseResultType::Err(e) => { return ParseResultStmt::Err(e); }
    }
}

// var x: i32; without = -> uninitialized
if is_mut && self.check(TokenKind::Semicolon) {
    self.advance();
    match ty {
        OptType::Some(t) => {
            return ParseResultStmt::Ok(Stmt::LetUninit(name, t, Vec::new(), line));
        }
        OptType::None => {
            return ParseResultStmt::Err("var " + name + " needs type annotation for uninitialized declaration at line " + int_to_str(line));
        }
    }
}
if is_mut && !self.check(TokenKind::Eq) {
    match ty {
        OptType::Some(t) => {
            self.match_tok(TokenKind::Semicolon);
            return ParseResultStmt::Ok(Stmt::LetUninit(name, t, Vec::new(), line));
        }
        OptType::None => {
            return ParseResultStmt::Err("var " + name + " needs type annotation for uninitialized declaration at line " + int_to_str(line));
        }
    }
}

match self.expect(TokenKind::Eq, "=") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var expr: Expr = Expr::IntLit(0);
match self.parse_expr() {
    ParseResultExpr::Ok(e) => { expr = e; }
    ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
}
self.match_tok(TokenKind::Semicolon);
return ParseResultStmt::Ok(Stmt::Let(name, ty, expr, is_mut, false, Vec::new(), line));
}

fn parse_persist_let(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::Persist, "persist") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var is_mut: bool = false;
if self.check(TokenKind::Var) {
    self.advance();
    is_mut = true;
} else {
    match self.expect(TokenKind::Val, "val") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
}
var name: str = "";
match self.expect_ident_or_keyword() {
    ParseResultStr::Ok(s) => { name = s; }
    ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
}
var ty: OptType = OptType::None;
if self.match_tok(TokenKind::Colon) {
    match self.parse_type() {
        ParseResultType::Ok(t) => { ty = OptType::Some(t); }
        ParseResultType::Err(e) => { return ParseResultStmt::Err(e); }
    }
}
match self.expect(TokenKind::Eq, "=") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var expr: Expr = Expr::IntLit(0);
match self.parse_expr() {
    ParseResultExpr::Ok(e) => { expr = e; }
    ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
}
self.match_tok(TokenKind::Semicolon);
return ParseResultStmt::Ok(Stmt::Let(name, ty, expr, is_mut, true, Vec::new(), line));
}

fn parse_return(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::Return, "return") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
if self.check(TokenKind::RBrace) || self.check(TokenKind::Semicolon) {
    self.match_tok(TokenKind::Semicolon);
    return ParseResultStmt::Ok(Stmt::Return(OptBoxExpr::None, line));
}
var expr: Expr = Expr::IntLit(0);
match self.parse_expr() {
    ParseResultExpr::Ok(e) => { expr = e; }
    ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
}
self.match_tok(TokenKind::Semicolon);
return ParseResultStmt::Ok(Stmt::Return(OptBoxExpr::Some(Box::new(expr)), line));
}

fn parse_if_expr(self: &mut Parser) -> ParseResultIfExpr {
match self.expect(TokenKind::If, "if") {
    ParseResultUnit::Err(e) => { return ParseResultIfExpr::Err(e); }
    ParseResultUnit::Ok => {}
}
var cond: Expr = Expr::IntLit(0);
match self.parse_expr() {
    ParseResultExpr::Ok(e) => { cond = e; }
    ParseResultExpr::Err(e) => { return ParseResultIfExpr::Err(e); }
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultIfExpr::Err(e); }
    ParseResultUnit::Ok => {}
}
var then_block: Vec<Stmt> = Vec::new();
match self.parse_block() {
    ParseResultStmts::Ok(b) => { then_block = b; }
    ParseResultStmts::Err(e) => { return ParseResultIfExpr::Err(e); }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultIfExpr::Err(e); }
    ParseResultUnit::Ok => {}
}

var else_block: OptStmts = OptStmts::None;
if self.match_tok(TokenKind::Else) {
    if self.check(TokenKind::If) {
        var line: i64 = self.peek_token().line;
        var nested: IfExpr = IfExpr {
            cond: Expr::IntLit(0),
            then_block: Vec::new(),
            else_block: OptStmts::None,
        };
        match self.parse_if_expr() {
            ParseResultIfExpr::Ok(ie) => { nested = ie; }
            ParseResultIfExpr::Err(e) => { return ParseResultIfExpr::Err(e); }
        }
        var stmts: Vec<Stmt> = Vec::new();
        stmts.push(Stmt::If(nested.cond, nested.then_block, nested.else_block, line));
        else_block = OptStmts::Some(stmts);
    } else {
        match self.expect(TokenKind::LBrace, "{") {
            ParseResultUnit::Err(e) => { return ParseResultIfExpr::Err(e); }
            ParseResultUnit::Ok => {}
        }
        var block: Vec<Stmt> = Vec::new();
        match self.parse_block() {
            ParseResultStmts::Ok(b) => { block = b; }
            ParseResultStmts::Err(e) => { return ParseResultIfExpr::Err(e); }
        }
        match self.expect(TokenKind::RBrace, "}") {
            ParseResultUnit::Err(e) => { return ParseResultIfExpr::Err(e); }
            ParseResultUnit::Ok => {}
        }
        else_block = OptStmts::Some(block);
    }
}

return ParseResultIfExpr::Ok(IfExpr {
    cond: cond,
    then_block: then_block,
    else_block: else_block,
});
}

fn parse_use_stmt(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::Use, "use") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var path: str = "";
loop {
    if self.check(TokenKind::LBrace) { break; }
    var name: str = "";
    match self.expect_ident() {
        ParseResultStr::Ok(s) => { name = s; }
        ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
    }
    path = path + name;
    if self.match_tok(TokenKind::DoubleColon) {
        path = path + "::";
    } else {
        break;
    }
}
var items: Vec<str> = Vec::new();
if self.match_tok(TokenKind::LBrace) {
    if !self.check(TokenKind::RBrace) {
        loop {
            var item: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => { item = s; }
                ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
            }
            items.push(item);
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::RBrace, "}") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
}
return ParseResultStmt::Ok(Stmt::Use(path, items, line));
}

fn parse_handle_stmt(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::Handle, "handle") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var body: Vec<Stmt> = Vec::new();
match self.parse_block() {
    ParseResultStmts::Ok(b) => { body = b; }
    ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
match self.expect(TokenKind::With, "with") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var handlers: Vec<EffectHandler> = Vec::new();
while !self.check(TokenKind::RBrace) {
    var effect: str = "";
    match self.expect_ident() {
        ParseResultStr::Ok(s) => { effect = s; }
        ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
    }
    match self.expect(TokenKind::Dot, ".") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var op: str = "";
    match self.expect_ident() {
        ParseResultStr::Ok(s) => { op = s; }
        ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
    }
    match self.expect(TokenKind::LParen, "(") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var params: Vec<str> = Vec::new();
    if !self.check(TokenKind::RParen) {
        loop {
            var p: str = "";
            match self.expect_ident() {
                ParseResultStr::Ok(s) => { p = s; }
                ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
            }
            params.push(p);
            if !self.match_tok(TokenKind::Comma) { break; }
        }
    }
    match self.expect(TokenKind::RParen, ")") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    match self.expect(TokenKind::FatArrow, "=>") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    match self.expect(TokenKind::LBrace, "{") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var handler_body: Vec<Stmt> = Vec::new();
    match self.parse_block() {
        ParseResultStmts::Ok(b) => { handler_body = b; }
        ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
    }
    match self.expect(TokenKind::RBrace, "}") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    handlers.push(EffectHandler_new(effect, op, params, handler_body));
    if !self.match_tok(TokenKind::Comma) { break; }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultStmt::Ok(Stmt::Handle(body, handlers, line));
}

fn parse_do_stmt(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::Do, "do") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var effect: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { effect = s; }
    ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::Dot, ".") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var op: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { op = s; }
    ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::LParen, "(") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var args: Vec<Expr> = Vec::new();
if !self.check(TokenKind::RParen) {
    loop {
        match self.parse_expr() {
            ParseResultExpr::Ok(e) => { args.push(e); }
            ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
        }
        if !self.match_tok(TokenKind::Comma) { break; }
    }
}
match self.expect(TokenKind::RParen, ")") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
self.match_tok(TokenKind::Semicolon);
return ParseResultStmt::Ok(Stmt::Do(effect, op, args, line));
}

// L3A: `resume(cont, value)` — call the continuation captured by the
// enclosing effect handler with the given value.
fn parse_resume_stmt(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::Resume, "resume") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
match self.expect(TokenKind::LParen, "(") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var cont: Expr = Expr::IntLit(0);
match self.parse_expr() {
    ParseResultExpr::Ok(e) => { cont = e; }
    ParseResultExpr::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::Comma, ",") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var value: Expr = Expr::IntLit(0);
match self.parse_expr() {
    ParseResultExpr::Ok(e2) => { value = e2; }
    ParseResultExpr::Err(e2) => { return ParseResultStmt::Err(e2); }
}
match self.expect(TokenKind::RParen, ")") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
self.match_tok(TokenKind::Semicolon);
return ParseResultStmt::Ok(Stmt::Resume(cont, value, line));
}

// L3B: `spawn scope { body }` — structured concurrency scope
fn parse_spawn_scope_stmt(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::Spawn, "spawn") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
// "scope" is a contextual identifier, not a keyword
match self.expect_ident() {
    ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultStr::Ok(_) => {}
}
match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var body: Vec<Stmt> = Vec::new();
match self.parse_block() {
    ParseResultStmts::Ok(b) => { body = b; }
    ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultStmt::Ok(Stmt::SpawnScope(body, line));
}

// L3E: `cancel scope;` — cancel all pending tasks in the current spawn scope
fn parse_cancel_scope_stmt(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect_ident() {
    ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultStr::Ok(_) => {}
}
match self.expect_ident() {
    ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultStr::Ok(_) => {}
}
self.match_tok(TokenKind::Semicolon);
return ParseResultStmt::Ok(Stmt::CancelScope(line));
}

fn parse_region_block(self: &mut Parser) -> ParseResultStmt {
var line: i64 = self.peek_token().line;
match self.expect(TokenKind::Region, "region") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}

// Optional modifier: gpu or kv_cache
var is_gpu: bool = false;
var is_kv_cache: bool = false;
var pk: TokenKind = self.peek();
match pk {
    TokenKind::Ident(s: str) => {
        if s == "gpu" {
            self.advance();
            is_gpu = true;
        } else if s == "kv_cache" {
            self.advance();
            is_kv_cache = true;
        }
    }
}

var name: str = "";
match self.expect_ident() {
    ParseResultStr::Ok(s) => { name = s; }
    ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
}

// Optional: with budget(N)
var budget: OptI64 = OptI64::None;
if self.match_tok(TokenKind::With) {
    var budget_name: str = "";
    match self.expect_ident() {
        ParseResultStr::Ok(s) => { budget_name = s; }
        ParseResultStr::Err(e) => { return ParseResultStmt::Err(e); }
    }
    if budget_name != "budget" {
        return ParseResultStmt::Err("Expected 'budget' after 'with' in region block, got '" + budget_name + "'");
    }
    match self.expect(TokenKind::LParen, "(") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
    var ntok: Token = self.peek_token();
    match ntok.kind {
        TokenKind::IntLit(n: i64) => {
            self.advance();
            budget = OptI64::Some(n);
        }
    }
    match self.expect(TokenKind::RParen, ")") {
        ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
        ParseResultUnit::Ok => {}
    }
}

// Optional: window(W) for KV cache
var window_size: OptI64 = OptI64::None;
if is_kv_cache {
    var wtok: Token = self.peek_token();
    match wtok.kind {
        TokenKind::Ident(s: str) => {
            if s == "window" {
                self.advance();
                match self.expect(TokenKind::LParen, "(") {
                    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
                    ParseResultUnit::Ok => {}
                }
                var wval: Token = self.peek_token();
                match wval.kind {
                    TokenKind::IntLit(w: i64) => {
                        self.advance();
                        window_size = OptI64::Some(w);
                    }
                }
                match self.expect(TokenKind::RParen, ")") {
                    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
                    ParseResultUnit::Ok => {}
                }
            }
        }
    }
}

match self.expect(TokenKind::LBrace, "{") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
var body: Vec<Stmt> = Vec::new();
match self.parse_block() {
    ParseResultStmts::Ok(b) => { body = b; }
    ParseResultStmts::Err(e) => { return ParseResultStmt::Err(e); }
}
match self.expect(TokenKind::RBrace, "}") {
    ParseResultUnit::Err(e) => { return ParseResultStmt::Err(e); }
    ParseResultUnit::Ok => {}
}
return ParseResultStmt::Ok(Stmt::RegionBlock(name, budget, is_gpu, is_kv_cache, window_size, body, line));
}

