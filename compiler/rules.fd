// compiler/rules.fd — rewrite rules as data, and pure calls merged
// (own-backend roadmap ME9, ME10, ME16, WP9).
//
// A rule matches an integer binary operation with a constant operand, or
// with the same value on both sides, and gives the operation's result: the
// other operand, a constant, or a boolean. Every rule here is exact under
// the language's checked arithmetic: its left side never overflows, so
// replacing it cannot remove or add a panic. A value replaced by another
// becomes `BitCast(other, t, t)`, a move, so no use needs renaming.
// `fid test-rules` checks each rule on edge and random values.
//
// Pure calls: two calls of the same program function with the same
// arguments, no effects and a scalar result give the same value; the second
// becomes a move from the first when the first's block dominates it (never
// hoisted: a pure call may still panic). "No effects" is the callee's
// effects joined with everything it calls, transitively (iropt.fd
// iro_effect_masks, Nov 15): before that, a function whose callee called a
// writer looked pure.
//
// Read-only calls (WP10; OP25: on by default since Nov 17, off with
// FID_NAT_OFF=readcse or FID_IROPT_OFF=readcse): the same, for a callee
// that only reads, when no instruction on any path between the two calls
// can write what it reads (ru_read_reuse).
//
// Switches: FID_NAT_OFF=rules, FID_NAT_OFF=purecse, FID_NAT_OFF=readcse;
// FID_NAT_MUTATE=rule<N> / rulec<N> breaks rule N on purpose (RL11,
// ru_mutate_rules).

module compiler::rules;
use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::iropt;
use compiler::checks;
use compiler::inc;
use compiler::ir_ser;
use compiler::egraph;
// Operation codes of the rules
const RU_ADD: i64 = 1;
const RU_SUB: i64 = 2;
const RU_MUL: i64 = 3;
const RU_DIV: i64 = 4;
const RU_AND: i64 = 5;
const RU_OR: i64 = 6;
const RU_XOR: i64 = 7;
const RU_SHL: i64 = 8;
const RU_SHR: i64 = 9;
const RU_EQ: i64 = 10;
const RU_NE: i64 = 11;
const RU_LT: i64 = 12;
const RU_LE: i64 = 13;
const RU_GT: i64 = 14;
const RU_GE: i64 = 15;
// Shapes
const RS_RIGHT: i64 = 0;  // x op c
const RS_LEFT: i64 = 1;  // c op x
const RS_SAME: i64 = 2;  // x op x

// Results
const RR_OTHER: i64 = 0;  // the operand that is not the constant (x)
const RR_CONST: i64 = 1;  // the integer constant `rc`
const RR_TRUE: i64 = 2;
const RR_FALSE: i64 = 3;
// TG2: what a rule needs of its operands beyond the shape match, as bit
// flags checked before the rule fires. A rule with a precondition it does
// not declare (or declares and the caller does not check) is a bug the
// selftest reports; the point is that a future machine-level rule (immediate
// fits, register class) states what it needs here and the framework is
// already checking it.
const RP_INT: i64 = 1;  // both operands integer (ru_is_int)
const RP_SAME_TY: i64 = 2;  // both operands the same type
const RP_SHIFT_LT_64: i64 = 4;  // a shift's amount < the width (64)
const RP_DIV_NONZERO: i64 = 8;  // the divisor is not zero

/// Whether rule `r` fires on operand type `ty` with its constant `c`:
/// every declared precondition must hold. The caller has already matched
/// the shape; this is the extra gate.
pub fn ru_precond_ok(r: RuRule, ty: IrType, other_ty: IrType) -> bool {
    if (r.precond & RP_INT) != 0 {
        if !ru_is_int(ty) || !ru_is_int(other_ty) {
            return false;
        }
    }
    if (r.precond & RP_SAME_TY) != 0 {
        if !ir_type_eq(ty, other_ty) {
            return false;
        }
    }
    if (r.precond & RP_SHIFT_LT_64) != 0 {
        if r.c < 0 || r.c >= 64 {
            return false;
        }
    }
    if (r.precond & RP_DIV_NONZERO) != 0 {
        if r.c == 0 {
            return false;
        }
    }
    return true;
}

pub struct RuRule {
    pub name: str,
    pub op: i64,
    pub shape: i64,
    pub c: i64,
    pub res: i64,
    pub rc: i64,
    pub precond: i64,
}

fn ru(name: str, op: i64, shape: i64, c: i64, res: i64, rc: i64, precond: i64) -> RuRule {
    return RuRule {
        name: name, op: op, shape: shape, c: c, res: res, rc: rc, precond: precond
    };
}

/// The rules, in the order they are tried.
pub fn ru_rules() -> Vec<RuRule> {
    var v: Vec<RuRule> = Vec::new();
    v.push(ru("x + 0 = x", RU_ADD, RS_RIGHT, 0, RR_OTHER, 0, RP_INT | RP_SAME_TY));
    v.push(ru("0 + x = x", RU_ADD, RS_LEFT, 0, RR_OTHER, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x - 0 = x", RU_SUB, RS_RIGHT, 0, RR_OTHER, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x - x = 0", RU_SUB, RS_SAME, 0, RR_CONST, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x * 1 = x", RU_MUL, RS_RIGHT, 1, RR_OTHER, 0, RP_INT | RP_SAME_TY));
    v.push(ru("1 * x = x", RU_MUL, RS_LEFT, 1, RR_OTHER, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x * 0 = 0", RU_MUL, RS_RIGHT, 0, RR_CONST, 0, RP_INT | RP_SAME_TY));
    v.push(ru("0 * x = 0", RU_MUL, RS_LEFT, 0, RR_CONST, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x / 1 = x", RU_DIV, RS_RIGHT, 1, RR_OTHER, 0, RP_INT | RP_SAME_TY | RP_DIV_NONZERO));
    v.push(ru("x & 0 = 0", RU_AND, RS_RIGHT, 0, RR_CONST, 0, RP_INT | RP_SAME_TY));
    v.push(ru("0 & x = 0", RU_AND, RS_LEFT, 0, RR_CONST, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x & -1 = x", RU_AND, RS_RIGHT, 0 - 1, RR_OTHER, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x & x = x", RU_AND, RS_SAME, 0, RR_OTHER, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x | 0 = x", RU_OR, RS_RIGHT, 0, RR_OTHER, 0, RP_INT | RP_SAME_TY));
    v.push(ru("0 | x = x", RU_OR, RS_LEFT, 0, RR_OTHER, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x | x = x", RU_OR, RS_SAME, 0, RR_OTHER, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x ^ 0 = x", RU_XOR, RS_RIGHT, 0, RR_OTHER, 0, RP_INT | RP_SAME_TY));
    v.push(ru("0 ^ x = x", RU_XOR, RS_LEFT, 0, RR_OTHER, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x ^ x = 0", RU_XOR, RS_SAME, 0, RR_CONST, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x << 0 = x", RU_SHL, RS_RIGHT, 0, RR_OTHER, 0, RP_INT | RP_SAME_TY | RP_SHIFT_LT_64));
    v.push(ru("x >> 0 = x", RU_SHR, RS_RIGHT, 0, RR_OTHER, 0, RP_INT | RP_SAME_TY | RP_SHIFT_LT_64));
    v.push(ru("x == x", RU_EQ, RS_SAME, 0, RR_TRUE, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x != x", RU_NE, RS_SAME, 0, RR_FALSE, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x < x", RU_LT, RS_SAME, 0, RR_FALSE, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x <= x", RU_LE, RS_SAME, 0, RR_TRUE, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x > x", RU_GT, RS_SAME, 0, RR_FALSE, 0, RP_INT | RP_SAME_TY));
    v.push(ru("x >= x", RU_GE, RS_SAME, 0, RR_TRUE, 0, RP_INT | RP_SAME_TY));
    ru_mutate_rules(&mut v);
    return v;
}

// --- RL11: rules broken on purpose (mutation testing) ---------------------
// `FID_NAT_MUTATE=rule<N>[,...]` (N a rule's index in ru_rules, from 0, in
// the order `fid test-rules` lists them) gives rule N a wrong result where
// it applies: `x + 0 = x` becomes `x + 0 = 0`, `x * 0 = 0` becomes
// `x * 0 = x`, `x == x` false. `rulec<N>` makes an `x op c` / `c op x` rule
// match the wrong constant instead (`x + 0 = x` becomes `x + 1 = x`; the
// next constant no earlier rule of the same shape takes, so it is not
// masked: `x * 0 = 0` becomes `x * 2 = 0`); on an `x op x` rule it is the
// same as rule<N>. The broken rule's name starts with "MUTANT ", and
// `fid test-rules` reports it failed. scripts/mutation-check.sh asks
// whether the suite notices each one. FID_NAT_MUTATE is part of nat_ir's
// cache key. Never set in a real build.

/// Rule `r` (index `at` of `v`) broken as `FID_NAT_MUTATE` asks: `shift`
/// true for rulec<N>.
fn ru_mutated(v: &Vec<RuRule>, at: i64, shift: bool) -> RuRule {
    var r: RuRule = v.get(at);
    var c: i64 = r.c;
    var res: i64 = r.res;
    var rc: i64 = r.rc;
    if shift && r.shape != RS_SAME {
        var d: i64 = 1;
        var again: bool = true;
        while again {
            again = false;
            var j: i64 = 0;
            while j < at {
                var e: RuRule = v.get(j);
                if e.op == r.op && e.shape == r.shape && e.c == r.c + d {
                    again = true;
                }
                j = j + 1;
            }
            if again {
                d = d + 1;
            }
        }
        c = r.c + d;
    } else if r.res == RR_OTHER {
        res = RR_CONST;
        rc = 0;
    } else if r.res == RR_CONST {
        res = RR_OTHER;
    } else if r.res == RR_TRUE {
        res = RR_FALSE;
    } else {
        res = RR_TRUE;
    }
    return ru("MUTANT " + r.name, r.op, r.shape, c, res, rc, r.precond);
}

fn ru_mutate_rules(v: &mut Vec<RuRule>) {
    var mu: str = p_getenv("FID_NAT_MUTATE");
    if (mu as i64) == 0 || str_len(mu) == 0 {
        return;
    }
    var list: str = "," + mu + ",";
    var i: i64 = 0;
    while i < v.len() {
        var shift: bool = str_contains(list, ",rulec" + int_to_str(i) + ",");
        if shift || str_contains(list, ",rule" + int_to_str(i) + ",") {
            var m: RuRule = ru_mutated(v, i, shift);
            v.set(i, m);
        }
        i = i + 1;
    }
}

// RL3: FID_RULES_OFF=<index>,... (indexes in ru_rules, from 0) or `all`
// turns rules off one by one for the pass matrix. A rule turned off gets
// op 0, which never matches (ru_op gives 0 to no operation and ru_rewrite
// checks code != 0); it keeps its place and name, so FID_RULE_STATS lists
// it with 0 hits. Applied by rules_run only, not in ru_rules, so
// `fid test-rules`, rules_smt and FID_NAT_MUTATE still see every rule.
fn ru_rules_off(v: &mut Vec<RuRule>) {
    var off: str = p_getenv("FID_RULES_OFF");
    if (off as i64) == 0 || str_len(off) == 0 {
        return;
    }
    var list: str = "," + off + ",";
    var every: bool = str_contains(list, ",all,");
    var i: i64 = 0;
    while i < v.len() {
        if every || str_contains(list, "," + int_to_str(i) + ",") {
            var r: RuRule = v.get(i);
            v.set(i, ru(r.name, 0, r.shape, r.c, r.res, r.rc, r.precond));
        }
        i = i + 1;
    }
}

fn ru_op(op: BinOp) -> i64 {
    match op {
        BinOp::Add => {
            return RU_ADD;
        }
        BinOp::Sub => {
            return RU_SUB;
        }
        BinOp::Mul => {
            return RU_MUL;
        }
        BinOp::Div => {
            return RU_DIV;
        }
        BinOp::BitAnd => {
            return RU_AND;
        }
        BinOp::BitOr => {
            return RU_OR;
        }
        BinOp::BitXor => {
            return RU_XOR;
        }
        BinOp::Shl => {
            return RU_SHL;
        }
        BinOp::Shr => {
            return RU_SHR;
        }
        BinOp::Eq => {
            return RU_EQ;
        }
        BinOp::Neq => {
            return RU_NE;
        }
        BinOp::Lt => {
            return RU_LT;
        }
        BinOp::LtEq => {
            return RU_LE;
        }
        BinOp::Gt => {
            return RU_GT;
        }
        BinOp::GtEq => {
            return RU_GE;
        }
        _ => {
        }
    }
    return 0;
}

fn ru_is_int(t: IrType) -> bool {
    return ir_type_eq(t, IrType::I64) || ir_type_eq(t, IrType::U64) || ir_type_eq(t, IrType::I32) || ir_type_eq(t, IrType::U32) || ir_type_eq(t, IrType::I16) || ir_type_eq(t, IrType::U16) || ir_type_eq(t, IrType::I8) || ir_type_eq(t, IrType::U8);
}

fn ru_is_scalar(t: IrType) -> bool {
    return ru_is_int(t) || ir_type_eq(t, IrType::Bool) || ir_type_eq(t, IrType::F64) || ir_type_eq(t, IrType::F32);
}

fn ru_meta_ty(f: &IrFunction, id: i64) -> IrType {
    match IrFunction_get_meta(f, id) {
        OptValueMeta::Some(m) => {
            return m.ty;
        }
        OptValueMeta::None => {
        }
    }
    return IrType::Void;
}

/// Value `id` is an integer constant: [1, value]; else [0].
fn ru_const(f: &IrFunction, id: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::ConstInt(v, _) => {
                    out.push(1);
                    out.push(v);
                    return out;
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    out.push(0);
    return out;
}

fn ru_set_inst(f: &mut IrFunction, id: i64, inst: Inst) {
    var at: i64 = f.inst_at.get(id) - 1;
    var ve: ValueIdInst = f.insts.get(at);
    ve.inst = inst;
    f.insts.set(at, ve);
    // CS1: the memo replays this write (ir_ser.fd mec_*)
    mec_log_inst(at);
}

// ME18: how often each rule fired this build (indexed as ru_rules' Vec).
var g_rule_hits: Vec<i64> = Vec::new();
/// Apply the rules to one function: how many operations they replaced.
fn ru_rewrite(f: &mut IrFunction, rules: &Vec<RuRule>) -> i64 {
    var count: i64 = 0;
    var i: i64 = 0;
    while i < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(i);
        match ve.inst {
            Inst::BinOp(op, a, b, ty) => {
                var code: i64 = ru_op(op);
                var aty: IrType = ru_meta_ty(f, a);
                if code != 0 && ru_is_int(aty) && ir_type_eq(aty, ru_meta_ty(f, b)) {
                    var ca: Vec<i64> = ru_const(f, a);
                    var cb: Vec<i64> = ru_const(f, b);
                    var ri: i64 = 0;
                    var done: bool = false;
                    while ri < rules.len() && !done {
                        var r: RuRule = rules.get(ri);
                        var other: i64 = 0 - 1;
                        if r.op == code && ru_precond_ok(r, aty, ru_meta_ty(f, if r.shape == RS_RIGHT {
                            a
                        } else {
                            b
                        })) {
                            if r.shape == RS_RIGHT && cb.get(0) == 1 && cb.get(1) == r.c {
                                other = a;
                            }
                            if r.shape == RS_LEFT && ca.get(0) == 1 && ca.get(1) == r.c {
                                other = b;
                            }
                            if r.shape == RS_SAME && a == b {
                                other = a;
                            }
                        }
                        if other >= 0 {
                            if r.res == RR_OTHER {
                                // A move keeps the result's own type
                                if ir_type_eq(ru_meta_ty(f, other), ty) {
                                    ru_set_inst(f, ve.id, Inst::BitCast(other, ty, ty));
                                    done = true;
                                }
                            } else if r.res == RR_CONST {
                                ru_set_inst(f, ve.id, Inst::ConstInt(r.rc, ty));
                                done = true;
                            } else {
                                ru_set_inst(f, ve.id, Inst::ConstBool(r.res == RR_TRUE));
                                done = true;
                            }
                            if done && ri < g_rule_hits.len() {
                                g_rule_hits.set(ri, g_rule_hits.get(ri) + 1);
                            }
                        }
                        ri = ri + 1;
                    }
                    if done {
                        count = count + 1;
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return count;
}

// The escape set of a function, the memory an address points into and the
// effects a caller sees are shared with iropt's library facts
// (compiler/iropt.fd: iro_esc_of, iro_local_addr, iro_effect_masks).
// `masks` below is iro_effect_masks(module), computed once per rules_run:
// a function's effects joined with those of everything it calls,
// transitively. A call site's own effect set is empty for a call to a
// program function (lowering fills it for runtime builtins only), so
// neither it nor the callee's `effects` field alone says what the call
// does (a function calling a function that writes a global looked pure).

/// Runtime and backend functions are never merged: the native backends
/// give some of them meanings the IR does not show.
fn ru_runtime_name(name: str) -> bool {
    return str_starts_with(name, "p_") || str_starts_with(name, "pe_") || str_starts_with(name, "pert_") || str_starts_with(name, "nat_");
}

/// A call whose second occurrence may reuse the first's result: the callee
/// has no effects at all, transitively.
fn ru_pure_call(module: &IrModule, masks: &Vec<i64>, name: str, effects: &EffectSet, ret: IrType) -> bool {
    if !ru_is_scalar(ret) {
        return false;
    }
    if ru_runtime_name(name) {
        return false;
    }
    // a function the module does not define counts as pure only when its
    // library facts file says so (WP20, iro_absent_call_mask)
    return iro_mask_pure(iro_call_mask(module, masks, name, effects));
}

/// A call that only reads (WP10): its second occurrence may reuse the
/// first's result when no write lies on any path between them.
fn ru_read_call(module: &IrModule, masks: &Vec<i64>, name: str, effects: &EffectSet, ret: IrType) -> bool {
    if !ru_is_scalar(ret) {
        return false;
    }
    if ru_runtime_name(name) {
        return false;
    }
    return iro_mask_read_only(iro_call_mask(module, masks, name, effects));
}

/// Can `inst`, between two read-only calls, change what the second reads?
/// A store to a local whose address goes nowhere cannot (the callee cannot
/// reach it), nor can a stack slot or a call that writes nothing; a call
/// through a pointer or a `dyn` call may do anything.
fn ru_inst_writes(module: &IrModule, masks: &Vec<i64>, f: &IrFunction, esc: &Vec<i64>, inst: Inst) -> bool {
    match inst {
        Inst::Store(p, _v, _t) => {
            return !iro_local_addr(f, esc, p);
        }
        Inst::Alloca(_, _) => {
            return false;
        }
        Inst::Call(cn, _a, _r, ce) => {
            return !iro_mask_no_write(iro_call_mask(module, masks, cn, &ce));
        }
        Inst::CallPtr(_fp, _pa, _pr, _pe, _pz) => {
            return true;
        }
        Inst::DynCall(_dt, _dm, _da, _dr, _de) => {
            return true;
        }
        _ => {
        }
    }
    var ie: EffectSet = inst_effects(&inst);
    return EffectSet_has_side_effects(&ie);
}

/// Does any instruction at positions lo..hi-1 of block `bi` write what a
/// read-only call could read (ru_inst_writes)?
fn ru_block_barrier(module: &IrModule, masks: &Vec<i64>, f: &IrFunction, esc: &Vec<i64>, bi: i64, lo: i64, hi: i64) -> bool {
    var blk: BasicBlock = f.blocks.get(bi);
    var k: i64 = lo;
    while k < hi && k < blk.instructions.len() {
        match IrFunction_get_inst(f, blk.instructions.get(k)) {
            OptInst::Some(inst) => {
                if ru_inst_writes(module, masks, f, esc, inst) {
                    return true;
                }
            }
            OptInst::None => {
            }
        }
        k = k + 1;
    }
    return false;
}

/// May the call at `bi:k` reuse the read-only call at `pb:pk`? Every path
/// from the first call to the second must be free of writes. `pb`
/// dominates `bi`, so walking back from `bi` along predecessors reaches
/// `pb` on every such path; the part of `pb` after the first call is
/// checked once. A path may also leave `bi` after the second call and come
/// back to it (a loop around `bi` that `pb` is outside of, or that `pb`
/// heads): then `bi`'s part after the call lies on it too (WP10 missed that
/// write on any loop longer than one block).
fn ru_read_reuse(module: &IrModule, masks: &Vec<i64>, f: &IrFunction, cfg: &IroCfg, esc: &Vec<i64>, pb: i64, pk: i64, bi: i64, bk: i64) -> bool {
    if pb != bi && !iro_dominates(cfg, pb, bi) {
        return false;
    }
    if pb == bi {
        // the first call comes first in the block: it runs again before
        // the second on every way round a loop
        return pk < bk && !ru_block_barrier(module, masks, f, esc, bi, pk + 1, bk);
    }
    if ru_block_barrier(module, masks, f, esc, pb, pk + 1, 2147483647) {
        return false;
    }
    if ru_block_barrier(module, masks, f, esc, bi, 0, bk) {
        return false;
    }
    var seen2: Vec<i64> = peir_zeros(cfg.n);
    var stack: Vec<i64> = Vec::new();
    var tail_done: bool = false;
    var first: bool = true;
    var w: i64 = bi;
    while first || stack.len() > 0 {
        if first {
            first = false;
        } else {
            w = stack.get(stack.len() - 1);
            stack.pop();
            if ru_block_barrier(module, masks, f, esc, w, 0, 2147483647) {
                return false;
            }
        }
        var ps: Vec<i64> = cfg.preds.get(w);
        var pi: i64 = 0;
        while pi < ps.len() {
            var p: i64 = ps.get(pi);
            if p == pb {
            // the path starts at the first call: pb's part after it
            // was checked above
            } else if p == bi {
                if !tail_done {
                    tail_done = true;
                    if ru_block_barrier(module, masks, f, esc, bi, bk + 1, 2147483647) {
                        return false;
                    }
                }
            } else if p >= 0 && p < seen2.len() && seen2.get(p) == 0 {
                seen2.set(p, 1);
                stack.push(p);
            }
            pi = pi + 1;
        }
    }
    return true;
}

/// Key for a call argument: constants by value (each call emits its own
/// ConstInt, so ids never match), anything else by id.
fn ru_key_arg(f: &IrFunction, id: i64) -> str {
    match peir_inst_of(f, id) {
        Inst::ConstInt(v, _t) => {
            return "i" + int_to_str(v);
        }
        Inst::ConstBool(b) => {
            if b {
                return "b1";
            }
            return "b0";
        }
        Inst::ConstNull(_t) => {
            return "n";
        }
        _ => {
        }
    }
    return "v" + int_to_str(id);
}

/// Merge pure calls in one function: how many became moves.
/// First index of `key` in `keys`, or -1.
fn ru_vfind(keys: &Vec<str>, key: str) -> i64 {
    var i: i64 = 0;
    while i < keys.len() {
        if keys.get(i) == key {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Merge pure calls in one function: how many became moves.
fn ru_pure_cse(module: &IrModule, masks: &Vec<i64>, f: &mut IrFunction) -> i64 {
    var cfg: IroCfg = iro_cfg(f);
    // key -> earlier call sites, kept typed: pure calls as flat [bi,id]
    // pairs, read-only calls as [bi,k,id] triples (WP10 needs the position
    // to know whether a write lies between the two calls).
    var seen_k: Vec<str> = Vec::new();
    var seen_v: Vec<Vec<i64>> = Vec::new();
    var seen_rk: Vec<str> = Vec::new();
    var seen_rv: Vec<Vec<i64>> = Vec::new();
    // Escaped allocas: a Store to one of these can be seen by a callee.
    var esc: Vec<i64> = iro_esc_of(f);
    var count: i64 = 0;
    var ri: i64 = 0;
    while ri < cfg.rpo.len() {
        var bi: i64 = cfg.rpo.get(ri);
        var block: BasicBlock = f.blocks.get(bi);
        var k: i64 = 0;
        while k < block.instructions.len() {
            var id: i64 = block.instructions.get(k);
            match IrFunction_get_inst(f, id) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::Call(name, args, ret, effects) => {
                            if ru_pure_call(module, masks, name, &effects, ret) {
                                var key: str = name;
                                var ai: i64 = 0;
                                while ai < args.len() {
                                    key = key + "|" + ru_key_arg(f, args.get(ai));
                                    ai = ai + 1;
                                }
                                var hit: i64 = 0 - 1;
                                var kvi: i64 = ru_vfind(&seen_k, key);
                                if kvi >= 0 {
                                    var sites: Vec<i64> = seen_v.get(kvi);
                                    var sv: i64 = 0;
                                    while sv + 1 < sites.len() && hit < 0 {
                                        var pb: i64 = sites.get(sv);
                                        if pb == bi || iro_dominates(&cfg, pb, bi) {
                                            hit = sites.get(sv + 1);
                                        }
                                        sv = sv + 2;
                                    }
                                }
                                if hit >= 0 {
                                    ru_set_inst(f, id, Inst::BitCast(hit, ret, ret));
                                    count = count + 1;
                                } else {
                                    if kvi < 0 {
                                        kvi = seen_k.len();
                                        seen_k.push(key);
                                        seen_v.push(Vec::new());
                                    }
                                    var nv: Vec<i64> = seen_v.get(kvi);
                                    nv.push(bi);
                                    nv.push(id);
                                    seen_v.set(kvi, nv);
                                }
                            } else if g_ru_readcse && ru_read_call(module, masks, name, &effects, ret) {
                                var key2: str = name;
                                var ai2: i64 = 0;
                                while ai2 < args.len() {
                                    key2 = key2 + "|" + ru_key_arg(f, args.get(ai2));
                                    ai2 = ai2 + 1;
                                }
                                var hit2: i64 = 0 - 1;
                                var kvr: i64 = ru_vfind(&seen_rk, key2);
                                if kvr >= 0 {
                                    var sites2: Vec<i64> = seen_rv.get(kvr);
                                    var t: i64 = sites2.len();
                                    while t >= 3 && hit2 < 0 {
                                        t = t - 3;
                                        if ru_read_reuse(module, masks, f, &cfg, &esc, sites2.get(t), sites2.get(t + 1), bi, k) {
                                            hit2 = sites2.get(t + 2);
                                        }
                                    }
                                }
                                if hit2 >= 0 {
                                    ru_set_inst(f, id, Inst::BitCast(hit2, ret, ret));
                                    count = count + 1;
                                    g_ru_readcse_n = g_ru_readcse_n + 1;
                                } else {
                                    if kvr < 0 {
                                        kvr = seen_rk.len();
                                        seen_rk.push(key2);
                                        seen_rv.push(Vec::new());
                                    }
                                    var nv2: Vec<i64> = seen_rv.get(kvr);
                                    nv2.push(bi);
                                    nv2.push(k);
                                    nv2.push(id);
                                    seen_rv.set(kvr, nv2);
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            k = k + 1;
        }
        ri = ri + 1;
    }
    return count;
}

/// Merging read-only calls (WP10, `readcse`). It was opt-in
/// (FID_RULES_ON=readcse) while it was being fixed: an access at -1 on
/// every native program (Nov 9); Nov 15: calls between the two count as
/// writes unless they write nothing, transitively, and a write after the
/// second call in a loop around it stops the merge. Nov 16: 14 programs
/// emitted with `--nat` with it on and off gave the same results, but with
/// a compiler from before those fixes, which merged nothing. OP25 (Nov 17):
/// on by default; FID_NAT_OFF=readcse or FID_IROPT_OFF=readcse turns it off
/// (tests/tooling/op25-check.sh runs the suite both ways). Set by rules_run.
var g_ru_readcse: bool = false;
/// How many read-only calls readcse merged (FID_RULE_STATS: "[rules]
/// readcse: N"; tests/tooling/op25-check.sh reads it).
var g_ru_readcse_n: i64 = 0;

fn ru_on(name: str) -> bool {
    // FID_NAT_OFF, or the `--no-pass` flag (ME5, compiler/checks.fd)
    return !iro_named_off(p_getenv("FID_NAT_OFF"), name);
}

/// The rules and the call merging on one function: [operations rewritten,
/// calls merged].
fn ru_one(module: &IrModule, masks: &Vec<i64>, rules: &Vec<RuRule>, f: &mut IrFunction, on_rules: bool, on_cse: bool) -> Vec<i64> {
    var a: i64 = 0;
    var b: i64 = 0;
    if on_rules {
        a = ru_rewrite(f, rules);
    }
    if on_cse {
        b = ru_pure_cse(module, masks, f);
    }
    var out: Vec<i64> = Vec::new();
    out.push(a);
    out.push(b);
    return out;
}

/// CS1: what ru_pure_cse reads of the functions `f` calls (the effect mask
/// of each call, in order), folded into the memo's key.
fn ru_calls_salt(module: &IrModule, masks: &Vec<i64>, f: &IrFunction) -> i64 {
    var h: i64 = 17;
    var i: i64 = 0;
    while i < f.insts.len() {
        var ins: Inst = f.insts.get(i).inst;
        match ins {
            Inst::Call(cn, _a, _r, ce) => {
                h = mec_mix(h, iro_call_mask(module, masks, cn, &ce));
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return h;
}

/// The rules and pure-call merging over every function of `module`:
/// [operations rewritten, calls merged]. FID_RULE_STATS=1 reports how
/// often each rule fired (ME18; rules that never fire can go).
pub fn rules_run(module: &mut IrModule) -> Vec<i64> {
    var rules: Vec<RuRule> = ru_rules();
    ru_rules_off(&mut rules);
    var n_rules: i64 = 0;
    var n_calls: i64 = 0;
    var on_rules: bool = ru_on("rules");
    var on_cse: bool = ru_on("purecse");
    var stat_env: str = p_getenv("FID_RULE_STATS");
    var stat_rules: bool = (stat_env as i64) != 0 && str_len(stat_env) > 0;
    if stat_rules && g_rule_hits.len() == 0 {
        var zi: i64 = 0;
        while zi < rules.len() {
            g_rule_hits.push(0);
            zi = zi + 1;
        }
    }
    // What each function's callers must assume it does, transitively
    // (iropt.fd). Merging only removes calls, so the masks stay a safe
    // over-estimate while the functions change below.
    // SP3: only the functions main reaches are rewritten (iropt.fd
    // iro_mid_reach; every function without main or with
    // FID_IROPT_OFF=midreach), and the masks are computed for them and
    // their callees only (the same masks for those).
    var reach: i64 = 0;
    if on_rules || on_cse {
        reach = iro_mid_reach(module);
    }
    var masks: Vec<i64> = Vec::new();
    if on_cse {
        masks = iro_effect_masks_in(module, reach);
    }
    g_ru_readcse = on_cse && ru_on("readcse") && !iro_named_off(p_getenv("FID_IROPT_OFF"), "readcse");
    // CS1: the memo of what this pass did to a function of the same IR
    // (ir_ser.fd mec_*): keyed by the function's hash, the switches above
    // and the masks of what it calls; FID_RULE_STATS counts every rewrite,
    // so it runs the pass on every function. The hash after the pass goes
    // to the e-graph that follows (mec_chain_*).
    mec_chain_clear();
    var memo: bool = !stat_rules && (on_rules || on_cse) && mec_begin();
    var cfg_h: i64 = 0;
    if memo {
        mec_pass_begin();
        cfg_h = mec_mix(mec_mix(mec_mix(MEC_RULES, mec_b(on_rules)), mec_b(on_cse)), mec_b(g_ru_readcse));
        cfg_h = mec_mix(cfg_h, hash_source(env_or_empty("FID_NAT_MUTATE")));
        // RL3: the memo is on disk; an entry made with every rule on must
        // not be replayed with some turned off
        cfg_h = mec_mix(cfg_h, hash_source(env_or_empty("FID_RULES_OFF")));
    }
    var i: i64 = 0;
    while i < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(i);
        if !iro_in_reach(reach, entry.name) {
            // SP3: left as it is; the e-graph's chain entry says "unknown"
            if memo {
                mec_chain_push(entry.name, entry.func.insts.len(), 0);
            }
            i = i + 1;
            continue;
        }
        var f: IrFunction = entry.func;
        var changed: i64 = 0;
        if memo {
            var pre_h: i64 = mec_fn_hash(f);
            var salt: i64 = cfg_h;
            if on_cse {
                salt = mec_mix(salt, ru_calls_salt(module, &masks, &f));
            }
            var key: i64 = mec_key(MEC_RULES, pre_h, salt);
            var at: i64 = mec_lookup(key, f.name);
            var done: bool = false;
            if at > 0 {
                if mec_apply_at(at, &mut f) {
                    done = true;
                    var e: MecEntry = mec_entry(at);
                    changed = e.c1 + e.c2;
                    n_calls = n_calls + e.c2;
                    g_ru_readcse_n = g_ru_readcse_n + e.c3;
                    mec_chain_push(f.name, f.insts.len(), e.post);
                }
            }
            if !done {
                var pre: IrFunction = f;
                var rd0: i64 = g_ru_readcse_n;
                mec_log_begin();
                var cs: Vec<i64> = ru_one(module, &masks, &rules, &mut f, on_rules, on_cse);
                mec_log_end();
                changed = cs.get(0) + cs.get(1);
                n_calls = n_calls + cs.get(1);
                var post_h: i64 = mec_note(key, pre, pre_h, f, changed > 0, cs.get(0), cs.get(1), g_ru_readcse_n - rd0);
                mec_chain_push(f.name, f.insts.len(), post_h);
            }
        } else {
            var cs2: Vec<i64> = ru_one(module, &masks, &rules, &mut f, on_rules, on_cse);
            changed = cs2.get(0) + cs2.get(1);
            n_calls = n_calls + cs2.get(1);
        }
        if changed > 0 {
            n_rules = n_rules + changed;
            entry.func = f;
            module.functions.set(i, entry);
        }
        i = i + 1;
    }
    if memo {
        mec_pass_end("rules");
    }
    if stat_rules {
        var si: i64 = 0;
        while si < rules.len() {
            var h: i64 = 0;
            if si < g_rule_hits.len() {
                h = g_rule_hits.get(si);
            }
            p_eprint_str("[rules] " + rules.get(si).name + ": " + int_to_str(h) + "\n");
            si = si + 1;
        }
        // OP25: read-only calls merged (tests/tooling/op25-check.sh)
        p_eprint_str("[rules] readcse: " + int_to_str(g_ru_readcse_n) + "\n");
    }
    var out: Vec<i64> = Vec::new();
    out.push(n_rules - n_calls);
    out.push(n_calls);
    return out;
}

// --- `fid test-rules` ---------------------------------------------------

fn ru_eval(op: i64, x: i64, y: i64) -> i64 {
    if op == RU_ADD {
        return x + y;
    }
    if op == RU_SUB {
        return x - y;
    }
    if op == RU_MUL {
        return x * y;
    }
    if op == RU_DIV {
        return x / y;
    }
    if op == RU_AND {
        return x & y;
    }
    if op == RU_OR {
        return x | y;
    }
    if op == RU_XOR {
        return x ^ y;
    }
    if op == RU_SHL {
        return x << y;
    }
    if op == RU_SHR {
        return x >> y;
    }
    if op == RU_EQ {
        if x == y {
            return 1;
        }
        return 0;
    }
    if op == RU_NE {
        if x != y {
            return 1;
        }
        return 0;
    }
    if op == RU_LT {
        if x < y {
            return 1;
        }
        return 0;
    }
    if op == RU_LE {
        if x <= y {
            return 1;
        }
        return 0;
    }
    if op == RU_GT {
        if x > y {
            return 1;
        }
        return 0;
    }
    if op == RU_GE {
        if x >= y {
            return 1;
        }
        return 0;
    }
    return 0;
}

/// Each rule on edge values and pseudo-random ones: its left side computed,
/// its result compared. Prints a line per rule; the number of failures.
pub fn rules_selftest() -> i64 {
    var rules: Vec<RuRule> = ru_rules();
    var xs: Vec<i64> = Vec::new();
    xs.push(0);
    xs.push(1);
    xs.push(0 - 1);
    xs.push(2);
    xs.push(7);
    xs.push(0 - 7);
    xs.push(9223372036854775807);
    xs.push(0 - 9223372036854775807 - 1);
    xs.push(4611686018427387904);
    var seed: i64 = 88172645463325252;
    var i: i64 = 0;
    while i < 300 {
        seed = seed ^ (seed << 13);
        seed = seed ^ (seed >> 7);
        seed = seed ^ (seed << 17);
        xs.push(seed);
        i = i + 1;
    }
    var fails: i64 = 0;
    var ri: i64 = 0;
    while ri < rules.len() {
        var r: RuRule = rules.get(ri);
        var bad: i64 = 0;
        var xi: i64 = 0;
        while xi < xs.len() {
            var x: i64 = xs.get(xi);
            var lhs: i64 = 0;
            if r.shape == RS_RIGHT {
                lhs = ru_eval(r.op, x, r.c);
            } else if r.shape == RS_LEFT {
                lhs = ru_eval(r.op, r.c, x);
            } else {
                lhs = ru_eval(r.op, x, x);
            }
            var rhs: i64 = x;
            if r.res == RR_CONST {
                rhs = r.rc;
            }
            if r.res == RR_TRUE {
                rhs = 1;
            }
            if r.res == RR_FALSE {
                rhs = 0;
            }
            if lhs != rhs {
                bad = bad + 1;
            }
            xi = xi + 1;
        }
        // TG2: the rule's preconditions hold for these operands (they are
        // integers, and the rule's own constant meets any shift or division
        // constraint it declares). A rule that declares RP_SHIFT_LT_64 with
        // c >= 64, or RP_DIV_NONZERO with c == 0, is a bug: its
        // preconditions contradict its own shape.
        if (r.precond & RP_SHIFT_LT_64) != 0 && (r.c < 0 || r.c >= 64) {
            print("FAIL  " + r.name + " (declares shift < 64 but c = " + int_to_str(r.c) + ")\n");
            fails = fails + 1;
            bad = bad + 1;
        }
        if (r.precond & RP_DIV_NONZERO) != 0 && r.c == 0 {
            print("FAIL  " + r.name + " (declares divisor != 0 but c = 0)\n");
            fails = fails + 1;
            bad = bad + 1;
        }
        if bad == 0 {
            print("ok    " + r.name + "\n");
        } else {
            print("FAIL  " + r.name + " (" + int_to_str(bad) + " values)\n");
            fails = fails + 1;
        }
        ri = ri + 1;
    }
    print(int_to_str(rules.len()) + " rules, " + int_to_str(fails) + " failed\n");
    return fails;
}

// --- SMT proof obligations (own-backend roadmap ME17) -------------------

/// The operation as an SMT-LIB bit-vector term.
fn ru_smt_term(op: i64, a: str, b: str) -> str {
    if op == RU_ADD {
        return "(bvadd " + a + " " + b + ")";
    }
    if op == RU_SUB {
        return "(bvsub " + a + " " + b + ")";
    }
    if op == RU_MUL {
        return "(bvmul " + a + " " + b + ")";
    }
    if op == RU_DIV {
        return "(bvsdiv " + a + " " + b + ")";
    }
    if op == RU_AND {
        return "(bvand " + a + " " + b + ")";
    }
    if op == RU_OR {
        return "(bvor " + a + " " + b + ")";
    }
    if op == RU_XOR {
        return "(bvxor " + a + " " + b + ")";
    }
    if op == RU_SHL {
        return "(bvshl " + a + " " + b + ")";
    }
    if op == RU_SHR {
        return "(bvashr " + a + " " + b + ")";
    }
    if op == RU_EQ {
        return "(= " + a + " " + b + ")";
    }
    if op == RU_NE {
        return "(not (= " + a + " " + b + "))";
    }
    if op == RU_LT {
        return "(bvslt " + a + " " + b + ")";
    }
    if op == RU_LE {
        return "(bvsle " + a + " " + b + ")";
    }
    if op == RU_GT {
        return "(bvsgt " + a + " " + b + ")";
    }
    return "(bvsge " + a + " " + b + ")";
}

fn ru_smt_const(v: i64, width: i64) -> str {
    if v < 0 {
        return "(bvneg (_ bv" + int_to_str(0 - v) + " " + int_to_str(width) + "))";
    }
    return "(_ bv" + int_to_str(v) + " " + int_to_str(width) + ")";
}

/// Write `dir/<rule>_<width>.smt2` for every rule at 8, 16, 32 and 64 bits:
/// each asserts that the two sides differ, so `unsat` (z3, cvc5) proves the
/// rule. scripts/rules-smt.sh runs them. The number of files not written.
pub fn rules_smt(dir: str) -> i64 {
    var rules: Vec<RuRule> = ru_rules();
    var widths: Vec<i64> = Vec::new();
    widths.push(8);
    widths.push(16);
    widths.push(32);
    widths.push(64);
    var failed: i64 = 0;
    var written: i64 = 0;
    var ri: i64 = 0;
    while ri < rules.len() {
        var r: RuRule = rules.get(ri);
        var wi: i64 = 0;
        while wi < widths.len() {
            var w: i64 = widths.get(wi);
            var c: str = ru_smt_const(r.c, w);
            var lhs: str = "";
            if r.shape == RS_RIGHT {
                lhs = ru_smt_term(r.op, "x", c);
            } else if r.shape == RS_LEFT {
                lhs = ru_smt_term(r.op, c, "x");
            } else {
                lhs = ru_smt_term(r.op, "x", "x");
            }
            var rhs: str = "x";
            if r.res == RR_CONST {
                rhs = ru_smt_const(r.rc, w);
            }
            if r.res == RR_TRUE {
                rhs = "true";
            }
            if r.res == RR_FALSE {
                rhs = "false";
            }
            var text: str = "; " + r.name + " at " + int_to_str(w) + " bits: unsat proves it\n" + "(set-logic QF_BV)\n(declare-const x (_ BitVec " + int_to_str(w) + "))\n" + "(assert (not (= " + lhs + " " + rhs + ")))\n(check-sat)\n";
            var path: str = dir + "/rule" + int_to_str(ri) + "_" + int_to_str(w) + ".smt2";
            p_file_write(path, text);
            if c_file_exists(path) {
                written = written + 1;
            } else {
                failed = failed + 1;
            }
            wi = wi + 1;
        }
        ri = ri + 1;
    }
    print(int_to_str(written) + " SMT-LIB files in " + dir + "\n");
    // ME7: the e-graph's own rewrites (egraph.fd egraph_smt), in the same
    // folder: scripts/rules-smt.sh proves every file there
    failed = failed + egraph_smt(dir);
    return failed;
}

// --- WP20: library facts ----------------------------------------------------
// The facts file (FID_LIBFACTS_IN) is read by iropt.fd (iro_lib_mask), in
// the format iro_libfacts writes: ru_pure_call and ru_read_call, and the
// write barriers between read-only calls, take a function the module does
// not define at its recorded effects.
