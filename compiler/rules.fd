// compiler/rules.fd — rewrite rules as data, and pure calls merged
// (own-backend roadmap ME9, ME10, ME16, WP9).
//
// A rule matches an integer binary operation with a constant operand, or
// with the same value on both sides, and gives the operation's result: the
// other operand, a constant, or a boolean. Every rule here is exact under
// the language's checked arithmetic: its left side never overflows, so
// replacing it cannot remove or add a panic. A value replaced by another
// becomes `BitCast(other, t, t)`, a move, so no use needs renaming.
// `fid test-rules` checks each rule on edge and random values.
//
// Pure calls: two calls of the same program function with the same
// arguments, no effects and a scalar result give the same value; the second
// becomes a move from the first when the first's block dominates it (never
// hoisted: a pure call may still panic).
//
// Switches: FID_NAT_OFF=rules, FID_NAT_OFF=purecse.

module compiler::rules;

use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::iropt;
use compiler::checks;

// Operation codes of the rules
const RU_ADD: i64 = 1;
const RU_SUB: i64 = 2;
const RU_MUL: i64 = 3;
const RU_DIV: i64 = 4;
const RU_AND: i64 = 5;
const RU_OR: i64 = 6;
const RU_XOR: i64 = 7;
const RU_SHL: i64 = 8;
const RU_SHR: i64 = 9;
const RU_EQ: i64 = 10;
const RU_NE: i64 = 11;
const RU_LT: i64 = 12;
const RU_LE: i64 = 13;
const RU_GT: i64 = 14;
const RU_GE: i64 = 15;

// Shapes
const RS_RIGHT: i64 = 0;   // x op c
const RS_LEFT: i64 = 1;    // c op x
const RS_SAME: i64 = 2;    // x op x

// Results
const RR_OTHER: i64 = 0;   // the operand that is not the constant (x)
const RR_CONST: i64 = 1;   // the integer constant `rc`
const RR_TRUE: i64 = 2;
const RR_FALSE: i64 = 3;

pub struct RuRule {
    pub name: str,
    pub op: i64,
    pub shape: i64,
    pub c: i64,
    pub res: i64,
    pub rc: i64,
}

fn ru(name: str, op: i64, shape: i64, c: i64, res: i64, rc: i64) -> RuRule {
    return RuRule { name: name, op: op, shape: shape, c: c, res: res, rc: rc };
}

/// The rules, in the order they are tried.
pub fn ru_rules() -> Vec<RuRule> {
    var v: Vec<RuRule> = Vec::new();
    v.push(ru("x + 0 = x", RU_ADD, RS_RIGHT, 0, RR_OTHER, 0));
    v.push(ru("0 + x = x", RU_ADD, RS_LEFT, 0, RR_OTHER, 0));
    v.push(ru("x - 0 = x", RU_SUB, RS_RIGHT, 0, RR_OTHER, 0));
    v.push(ru("x - x = 0", RU_SUB, RS_SAME, 0, RR_CONST, 0));
    v.push(ru("x * 1 = x", RU_MUL, RS_RIGHT, 1, RR_OTHER, 0));
    v.push(ru("1 * x = x", RU_MUL, RS_LEFT, 1, RR_OTHER, 0));
    v.push(ru("x * 0 = 0", RU_MUL, RS_RIGHT, 0, RR_CONST, 0));
    v.push(ru("0 * x = 0", RU_MUL, RS_LEFT, 0, RR_CONST, 0));
    v.push(ru("x / 1 = x", RU_DIV, RS_RIGHT, 1, RR_OTHER, 0));
    v.push(ru("x & 0 = 0", RU_AND, RS_RIGHT, 0, RR_CONST, 0));
    v.push(ru("0 & x = 0", RU_AND, RS_LEFT, 0, RR_CONST, 0));
    v.push(ru("x & -1 = x", RU_AND, RS_RIGHT, 0 - 1, RR_OTHER, 0));
    v.push(ru("x & x = x", RU_AND, RS_SAME, 0, RR_OTHER, 0));
    v.push(ru("x | 0 = x", RU_OR, RS_RIGHT, 0, RR_OTHER, 0));
    v.push(ru("0 | x = x", RU_OR, RS_LEFT, 0, RR_OTHER, 0));
    v.push(ru("x | x = x", RU_OR, RS_SAME, 0, RR_OTHER, 0));
    v.push(ru("x ^ 0 = x", RU_XOR, RS_RIGHT, 0, RR_OTHER, 0));
    v.push(ru("0 ^ x = x", RU_XOR, RS_LEFT, 0, RR_OTHER, 0));
    v.push(ru("x ^ x = 0", RU_XOR, RS_SAME, 0, RR_CONST, 0));
    v.push(ru("x << 0 = x", RU_SHL, RS_RIGHT, 0, RR_OTHER, 0));
    v.push(ru("x >> 0 = x", RU_SHR, RS_RIGHT, 0, RR_OTHER, 0));
    v.push(ru("x == x", RU_EQ, RS_SAME, 0, RR_TRUE, 0));
    v.push(ru("x != x", RU_NE, RS_SAME, 0, RR_FALSE, 0));
    v.push(ru("x < x", RU_LT, RS_SAME, 0, RR_FALSE, 0));
    v.push(ru("x <= x", RU_LE, RS_SAME, 0, RR_TRUE, 0));
    v.push(ru("x > x", RU_GT, RS_SAME, 0, RR_FALSE, 0));
    v.push(ru("x >= x", RU_GE, RS_SAME, 0, RR_TRUE, 0));
    return v;
}

fn ru_op(op: BinOp) -> i64 {
    match op {
        BinOp::Add => { return RU_ADD; }
        BinOp::Sub => { return RU_SUB; }
        BinOp::Mul => { return RU_MUL; }
        BinOp::Div => { return RU_DIV; }
        BinOp::BitAnd => { return RU_AND; }
        BinOp::BitOr => { return RU_OR; }
        BinOp::BitXor => { return RU_XOR; }
        BinOp::Shl => { return RU_SHL; }
        BinOp::Shr => { return RU_SHR; }
        BinOp::Eq => { return RU_EQ; }
        BinOp::Neq => { return RU_NE; }
        BinOp::Lt => { return RU_LT; }
        BinOp::LtEq => { return RU_LE; }
        BinOp::Gt => { return RU_GT; }
        BinOp::GtEq => { return RU_GE; }
        _ => {}
    }
    return 0;
}

fn ru_is_int(t: IrType) -> bool {
    return ir_type_eq(t, IrType::I64) || ir_type_eq(t, IrType::U64) || ir_type_eq(t, IrType::I32)
        || ir_type_eq(t, IrType::U32) || ir_type_eq(t, IrType::I16) || ir_type_eq(t, IrType::U16)
        || ir_type_eq(t, IrType::I8) || ir_type_eq(t, IrType::U8);
}

fn ru_is_scalar(t: IrType) -> bool {
    return ru_is_int(t) || ir_type_eq(t, IrType::Bool) || ir_type_eq(t, IrType::F64) || ir_type_eq(t, IrType::F32);
}

fn ru_meta_ty(f: &IrFunction, id: i64) -> IrType {
    match IrFunction_get_meta(f, id) {
        OptValueMeta::Some(m) => { return m.ty; }
        OptValueMeta::None => {}
    }
    return IrType::Void;
}

/// Value `id` is an integer constant: [1, value]; else [0].
fn ru_const(f: &IrFunction, id: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::ConstInt(v, _) => { out.push(1); out.push(v); return out; }
                _ => {}
            }
        }
        OptInst::None => {}
    }
    out.push(0);
    return out;
}

fn ru_set_inst(f: &mut IrFunction, id: i64, inst: Inst) {
    var at: i64 = f.inst_at.get(id) - 1;
    var ve: ValueIdInst = f.insts.get(at);
    ve.inst = inst;
    f.insts.set(at, ve);
}

// ME18: how often each rule fired this build (indexed as ru_rules' Vec).
var g_rule_hits: Vec<i64> = Vec::new();

/// Apply the rules to one function: how many operations they replaced.
fn ru_rewrite(f: &mut IrFunction, rules: &Vec<RuRule>) -> i64 {
    var count: i64 = 0;
    var i: i64 = 0;
    while i < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(i);
        match ve.inst {
            Inst::BinOp(op, a, b, ty) => {
                var code: i64 = ru_op(op);
                var aty: IrType = ru_meta_ty(f, a);
                if code != 0 && ru_is_int(aty) && ir_type_eq(aty, ru_meta_ty(f, b)) {
                    var ca: Vec<i64> = ru_const(f, a);
                    var cb: Vec<i64> = ru_const(f, b);
                    var ri: i64 = 0;
                    var done: bool = false;
                    while ri < rules.len() && !done {
                        var r: RuRule = rules.get(ri);
                        var other: i64 = 0 - 1;
                        if r.op == code {
                            if r.shape == RS_RIGHT && cb.get(0) == 1 && cb.get(1) == r.c { other = a; }
                            if r.shape == RS_LEFT && ca.get(0) == 1 && ca.get(1) == r.c { other = b; }
                            if r.shape == RS_SAME && a == b { other = a; }
                        }
                        if other >= 0 {
                            if r.res == RR_OTHER {
                                // A move keeps the result's own type
                                if ir_type_eq(ru_meta_ty(f, other), ty) {
                                    ru_set_inst(f, ve.id, Inst::BitCast(other, ty, ty));
                                    done = true;
                                }
                            } else if r.res == RR_CONST {
                                ru_set_inst(f, ve.id, Inst::ConstInt(r.rc, ty));
                                done = true;
                            } else {
                                ru_set_inst(f, ve.id, Inst::ConstBool(r.res == RR_TRUE));
                                done = true;
                            }
                            if done && ri < g_rule_hits.len() { g_rule_hits.set(ri, g_rule_hits.get(ri) + 1); }
                        }
                        ri = ri + 1;
                    }
                    if done { count = count + 1; }
                }
            }
            _ => {}
        }
        i = i + 1;
    }
    return count;
}

/// The escape set of `f`: Alloca ids whose address leaves the function
/// (call args, stored values, returns, copies, persistence).
fn ru_esc_of(f: &IrFunction) -> Vec<i64> {
    var esc: Vec<i64> = peir_zeros(f.next_value + 1);
    var ebi: i64 = 0;
    while ebi < f.blocks.len() {
        var eblk: BasicBlock = f.blocks.get(ebi);
        var ek: i64 = 0;
        while ek < eblk.instructions.len() {
            match IrFunction_get_inst(f, eblk.instructions.get(ek)) {
                OptInst::Some(einst) => {
                    match einst {
                        Inst::Call(_n, eargs, _r, _e) => { ru_mark_escape(f, &mut esc, eargs); }
                        Inst::CallPtr(_fp, eargs, _r, _e, _z) => { ru_mark_escape(f, &mut esc, eargs); }
                        Inst::DynCall(_t, _m, eargs, _r, _e) => { ru_mark_escape(f, &mut esc, eargs); }
                        Inst::Store(_p, v, _t) => { ru_mark_one_escape(f, &mut esc, v); }
                        Inst::StructCopy(d, s, _t) => { ru_mark_one_escape(f, &mut esc, d); ru_mark_one_escape(f, &mut esc, s); }
                        Inst::PersistSave(_n, v2) => { ru_mark_one_escape(f, &mut esc, v2); }
                        Inst::Return(rv) => {
                            match rv {
                                OptValueId::Some(v3) => { ru_mark_one_escape(f, &mut esc, v3); }
                                OptValueId::None => {}
                            }
                        }
                        _ => {}
                    }
                }
                OptInst::None => {}
            }
            ek = ek + 1;
        }
        ebi = ebi + 1;
    }
    return esc;
}

/// Effects of `f` visible outside it: Alloca stack slots and loads/stores
/// through unescaped Allocas are invisible, so a `!read` function's local
/// writes do not count. `f.effects` includes them, so compute it here.
fn ru_ext_effects(module: &IrModule, f: &IrFunction) -> EffectSet {
    var esc: Vec<i64> = ru_esc_of(f);
    var eff: EffectSet = EffectSet_new();
    var ii: i64 = 0;
    while ii < f.insts.len() {
        var inst: Inst = f.insts.get(ii).inst;
        var skip: bool = false;
        match inst {
            Inst::Alloca(_, _) => { skip = true; }
            Inst::Load(p, _t) => {
                var b: i64 = ru_base(f, p);
                match peir_inst_of(f, b) {
                    Inst::Alloca(_, _) => { if b < esc.len() && esc.get(b) == 0 { skip = true; } }
                    _ => {}
                }
            }
            Inst::Store(p, _v, _t) => {
                var b2: i64 = ru_base(f, p);
                match peir_inst_of(f, b2) {
                    Inst::Alloca(_, _) => { if b2 < esc.len() && esc.get(b2) == 0 { skip = true; } }
                    _ => {}
                }
            }
            _ => {}
        }
        if !skip { EffectSet_add_all(&mut eff, inst_effects(&inst)); }
        // A call's own effect set is empty for calls to program functions
        // (lowering fills it for builtins only): count the callee's whole,
        // transitive effects, or a function that writes through a `&mut`
        // parameter in a helper looks pure (test_brotli: bs_bits merged)
        match inst {
            Inst::Call(cn, _cargs, _cr, _ce) => {
                match IrModule_get_function(module, cn) {
                    OptIrFunction::Some(cf) => { EffectSet_add_all(&mut eff, cf.effects); }
                    OptIrFunction::None => {
                        if !str_starts_with(cn, "p_") || !EffectSet_is_read_only(inst_effects(&inst)) {
                            EffectSet_add(&mut eff, Effect::Write);
                        }
                    }
                }
            }
            Inst::CallPtr(_fp, _pa, _pr, _pe, _pz) => { EffectSet_add(&mut eff, Effect::Write); }
            Inst::DynCall(_dt, _dm, _da, _dr, _de) => { EffectSet_add(&mut eff, Effect::Write); }
            _ => {}
        }
        ii = ii + 1;
    }
    // WP11/12: annotation facts — @crashfree asserts no divergent path and
    // @no-alloc asserts no allocation; the caller need not preserve the
    // facts those effects would force it to carry.
    if f.is_crashfree || f.is_no_alloc {
        var eff2: EffectSet = EffectSet_new();
        var ei: i64 = 0;
        while ei < eff.effects.len() {
            var e2: Effect = eff.effects.get(ei);
            var keep: bool = true;
            if f.is_crashfree && e2 == Effect::Diverge { keep = false; }
            if f.is_no_alloc && e2 == Effect::Alloc { keep = false; }
            if keep { EffectSet_add(&mut eff2, e2); }
            ei = ei + 1;
        }
        eff = eff2;
    }
    return eff;
}

/// A call whose second occurrence may reuse the first's result. The call
/// site's own effect set is pessimistic (IO for every user call); the
/// callee's externally visible effects are what matter.
fn ru_pure_call(module: &IrModule, name: str, _effects: EffectSet, ret: IrType) -> bool {
    if !ru_is_scalar(ret) { return false; }
    if str_starts_with(name, "p_") || str_starts_with(name, "pe_") || str_starts_with(name, "pert_")
        || str_starts_with(name, "nat_") { return false; }
    match IrModule_get_function(module, name) {
        OptIrFunction::Some(callee) => { return ru_ext_effects(module, &callee).effects.len() == 0; }
        OptIrFunction::None => {}
    }
    // WP20: absent callee — a library function whose facts artifact says pure
    if ru_lib_kind(name) == 1 { return true; }
    return false;
}

/// A `!read` call whose second occurrence may reuse the first's result when
/// no write lies between them (WP10). The call site's effect set is
/// pessimistic; the callee's computed effects are what matter.
fn ru_read_call(module: &IrModule, name: str, _effects: EffectSet, ret: IrType) -> bool {
    if !ru_is_scalar(ret) { return false; }
    if str_starts_with(name, "p_") || str_starts_with(name, "pe_") || str_starts_with(name, "pert_")
        || str_starts_with(name, "nat_") { return false; }
    match IrModule_get_function(module, name) {
        OptIrFunction::Some(callee) => { return EffectSet_is_read_only(ru_ext_effects(module, &callee)); }
        OptIrFunction::None => {}
    }
    if ru_lib_kind(name) >= 1 { return true; }
    return false;
}

/// Chase a value back to the memory it came from: Alloca ids and loads of
/// pointer chains. Returns the base value's id (itself for anything else).
fn ru_base(f: &IrFunction, id0: i64) -> i64 {
    var id: i64 = id0;
    var steps: i64 = 0;
    while steps < 16 {
        var next: i64 = -1;
        match peir_inst_of(f, id) {
            Inst::GetFieldPtr(p, _, _) => { next = p; }
            Inst::GetElemPtr(p, _, _) => { next = p; }
            Inst::BitCast(p, _, _) => { next = p; }
            _ => {}
        }
        if next < 0 { return id; }
        id = next;
        steps = steps + 1;
    }
    return id;
}

/// An inst between two `!read` calls that can change what the second sees.
/// A Store to an unescaped Alloca is local to the caller — invisible to the
/// callee — and is not a barrier.
fn ru_block_barrier(f: &IrFunction, esc: &Vec<i64>, bi: i64, lo: i64, hi: i64) -> bool {
    var blk: BasicBlock = f.blocks.get(bi);
    var k: i64 = lo;
    while k < hi && k < blk.instructions.len() {
        match IrFunction_get_inst(f, blk.instructions.get(k)) {
            OptInst::Some(inst) => {
                if !EffectSet_has_side_effects(inst_effects(&inst)) { }
                else {
                    match inst {
                        Inst::Store(p, _v, _t) => {
                            var b: i64 = ru_base(f, p);
                            var is_local: bool = false;
                            match peir_inst_of(f, b) {
                                Inst::Alloca(_, _) => { if b < esc.len() && esc.get(b) == 0 { is_local = true; } }
                                _ => {}
                            }
                            if !is_local { return true; }
                        }
                        _ => { return true; }
                    }
                }
            }
            OptInst::None => {}
        }
        k = k + 1;
    }
    return false;
}

fn ru_mark_one_escape(f: &IrFunction, esc: &mut Vec<i64>, v: i64) {
    var b: i64 = ru_base(f, v);
    if b >= 0 && b < esc.len() {
        match peir_inst_of(f, b) {
            Inst::Alloca(_, _) => { esc.set(b, 1); }
            _ => {}
        }
    }
}

fn ru_mark_escape(f: &IrFunction, esc: &mut Vec<i64>, args: Vec<i64>) {
    var i: i64 = 0;
    while i < args.len() {
        ru_mark_one_escape(f, esc, args.get(i));
        i = i + 1;
    }
}

/// May the call at `bi:k` reuse the read-only call at `pb:pk`? Every path
/// from the first call to the second must be free of writes.
fn ru_read_reuse(f: &IrFunction, cfg: &IroCfg, esc: &Vec<i64>, pb: i64, pk: i64, bi: i64, bk: i64) -> bool {
    if pb != bi && !iro_dominates(cfg, pb, bi) { return false; }
    if pb == bi { return !ru_block_barrier(f, esc, bi, pk + 1, bk); }
    if ru_block_barrier(f, esc, pb, pk + 1, 2147483647) { return false; }
    if ru_block_barrier(f, esc, bi, 0, bk) { return false; }
    var seen2: Vec<i64> = peir_zeros(cfg.n);
    var stack: Vec<i64> = Vec::new();
    seen2.set(bi, 1);
    var ps0: Vec<i64> = cfg.preds.get(bi);
    var pi0: i64 = 0;
    while pi0 < ps0.len() {
        var p0: i64 = ps0.get(pi0);
        if p0 == pb {
            if ru_block_barrier(f, esc, pb, 0, pk + 1) { return false; }
        } else if p0 == bi {
            if ru_block_barrier(f, esc, bi, bk + 1, 2147483647) { return false; }
        } else if seen2.get(p0) == 0 {
            seen2.set(p0, 1);
            stack.push(p0);
        }
        pi0 = pi0 + 1;
    }
    while stack.len() > 0 {
        var w: i64 = stack.get(stack.len() - 1);
        stack.pop();
        if ru_block_barrier(f, esc, w, 0, 2147483647) { return false; }
        var ps: Vec<i64> = cfg.preds.get(w);
        var pi: i64 = 0;
        while pi < ps.len() {
            var p: i64 = ps.get(pi);
            if p == pb {
                if ru_block_barrier(f, esc, pb, 0, pk + 1) { return false; }
            } else if seen2.get(p) == 0 {
                seen2.set(p, 1);
                stack.push(p);
            }
            pi = pi + 1;
        }
    }
    return true;
}

/// Key for a call argument: constants by value (each call emits its own
/// ConstInt, so ids never match), anything else by id.
fn ru_key_arg(f: &IrFunction, id: i64) -> str {
    match peir_inst_of(f, id) {
        Inst::ConstInt(v, _t) => { return "i" + int_to_str(v); }
        Inst::ConstBool(b) => { if b { return "b1"; } return "b0"; }
        Inst::ConstNull(_t) => { return "n"; }
        _ => {}
    }
    return "v" + int_to_str(id);
}

/// Merge pure calls in one function: how many became moves.
/// First index of `key` in `keys`, or -1.
fn ru_vfind(keys: &Vec<str>, key: str) -> i64 {
    var i: i64 = 0;
    while i < keys.len() { if keys.get(i) == key { return i; } i = i + 1; }
    return -1;
}

/// Merge pure calls in one function: how many became moves.
fn ru_pure_cse(module: &IrModule, f: &mut IrFunction) -> i64 {
    var cfg: IroCfg = iro_cfg(f);
    // key -> earlier call sites, kept typed: pure calls as flat [bi,id]
    // pairs, read-only calls as [bi,k,id] triples (WP10 needs the position
    // to know whether a write lies between the two calls).
    var seen_k: Vec<str> = Vec::new();
    var seen_v: Vec<Vec<i64>> = Vec::new();
    var seen_rk: Vec<str> = Vec::new();
    var seen_rv: Vec<Vec<i64>> = Vec::new();
    // Escaped allocas: a Store to one of these can be seen by a callee.
    var esc: Vec<i64> = ru_esc_of(f);
    var count: i64 = 0;
    var ri: i64 = 0;
    while ri < cfg.rpo.len() {
        var bi: i64 = cfg.rpo.get(ri);
        var block: BasicBlock = f.blocks.get(bi);
        var k: i64 = 0;
        while k < block.instructions.len() {
            var id: i64 = block.instructions.get(k);
            match IrFunction_get_inst(f, id) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::Call(name, args, ret, effects) => {
                            if ru_pure_call(module, name, effects, ret) {
                                var key: str = name;
                                var ai: i64 = 0;
                                while ai < args.len() { key = key + "|" + ru_key_arg(f, args.get(ai)); ai = ai + 1; }
                                var hit: i64 = 0 - 1;
                                var kvi: i64 = ru_vfind(&seen_k, key);
                                if kvi >= 0 {
                                    var sites: Vec<i64> = seen_v.get(kvi);
                                    var sv: i64 = 0;
                                    while sv + 1 < sites.len() && hit < 0 {
                                        var pb: i64 = sites.get(sv);
                                        if pb == bi || iro_dominates(&cfg, pb, bi) { hit = sites.get(sv + 1); }
                                        sv = sv + 2;
                                    }
                                }
                                if hit >= 0 {
                                    ru_set_inst(f, id, Inst::BitCast(hit, ret, ret));
                                    count = count + 1;
                                } else {
                                    if kvi < 0 {
                                        kvi = seen_k.len();
                                        seen_k.push(key);
                                        seen_v.push(Vec::new());
                                    }
                                    var nv: Vec<i64> = seen_v.get(kvi);
                                    nv.push(bi);
                                    nv.push(id);
                                    seen_v.set(kvi, nv);
                                }
                            } else if ru_opt_in("readcse") && ru_read_call(module, name, effects, ret) {
                                var key2: str = name;
                                var ai2: i64 = 0;
                                while ai2 < args.len() { key2 = key2 + "|" + ru_key_arg(f, args.get(ai2)); ai2 = ai2 + 1; }
                                var hit2: i64 = 0 - 1;
                                var kvr: i64 = ru_vfind(&seen_rk, key2);
                                if kvr >= 0 {
                                    var sites2: Vec<i64> = seen_rv.get(kvr);
                                    var t: i64 = sites2.len();
                                    while t >= 3 && hit2 < 0 {
                                        t = t - 3;
                                        if ru_read_reuse(f, &cfg, &esc, sites2.get(t), sites2.get(t + 1), bi, k) {
                                            hit2 = sites2.get(t + 2);
                                        }
                                    }
                                }
                                if hit2 >= 0 {
                                    ru_set_inst(f, id, Inst::BitCast(hit2, ret, ret));
                                    count = count + 1;
                                } else {
                                    if kvr < 0 {
                                        kvr = seen_rk.len();
                                        seen_rk.push(key2);
                                        seen_rv.push(Vec::new());
                                    }
                                    var nv2: Vec<i64> = seen_rv.get(kvr);
                                    nv2.push(bi);
                                    nv2.push(k);
                                    nv2.push(id);
                                    seen_rv.set(kvr, nv2);
                                }
                            }
                        }
                        _ => {}
                    }
                }
                OptInst::None => {}
            }
            k = k + 1;
        }
        ri = ri + 1;
    }
    return count;
}

/// Opt-in parts (FID_RULES_ON=name,...): merging read-only calls (WP10,
/// `readcse`) is off by default until it stops crashing the build
/// (ru_read_reuse: an access at -1 on every native program, Nov 9).
fn ru_opt_in(name: str) -> bool {
    var on: str = p_getenv("FID_RULES_ON");
    if (on as i64) == 0 || str_len(on) == 0 { return false; }
    return str_contains("," + on + ",", "," + name + ",");
}

fn ru_on(name: str) -> bool {
    var off: str = p_getenv("FID_NAT_OFF");
    if (off as i64) == 0 || str_len(off) == 0 { return true; }
    return !str_contains("," + off + ",", "," + name + ",");
}

/// The rules and pure-call merging over every function of `module`:
/// [operations rewritten, calls merged]. FID_RULE_STATS=1 reports how
/// often each rule fired (ME18; rules that never fire can go).
pub fn rules_run(module: &mut IrModule) -> Vec<i64> {
    var rules: Vec<RuRule> = ru_rules();
    var n_rules: i64 = 0;
    var n_calls: i64 = 0;
    var on_rules: bool = ru_on("rules");
    var on_cse: bool = ru_on("purecse");
    var stat_env: str = p_getenv("FID_RULE_STATS");
    var stat_rules: bool = (stat_env as i64) != 0 && str_len(stat_env) > 0;
    if stat_rules && g_rule_hits.len() == 0 {
        var zi: i64 = 0;
        while zi < rules.len() { g_rule_hits.push(0); zi = zi + 1; }
    }
    var i: i64 = 0;
    while i < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(i);
        var f: IrFunction = entry.func;
        var changed: i64 = 0;
        if on_rules { changed = changed + ru_rewrite(&mut f, &rules); }
        if on_cse {
            var merged: i64 = ru_pure_cse(module, &mut f);
            n_calls = n_calls + merged;
            changed = changed + merged;
        }
        if changed > 0 {
            n_rules = n_rules + changed;
            entry.func = f;
            module.functions.set(i, entry);
        }
        i = i + 1;
    }
    if stat_rules {
        var si: i64 = 0;
        while si < rules.len() {
            var h: i64 = 0;
            if si < g_rule_hits.len() { h = g_rule_hits.get(si); }
            p_eprint_str("[rules] " + rules.get(si).name + ": " + int_to_str(h) + "\n");
            si = si + 1;
        }
    }
    var out: Vec<i64> = Vec::new();
    out.push(n_rules - n_calls);
    out.push(n_calls);
    return out;
}

// --- `fid test-rules` ---------------------------------------------------

fn ru_eval(op: i64, x: i64, y: i64) -> i64 {
    if op == RU_ADD { return x + y; }
    if op == RU_SUB { return x - y; }
    if op == RU_MUL { return x * y; }
    if op == RU_DIV { return x / y; }
    if op == RU_AND { return x & y; }
    if op == RU_OR { return x | y; }
    if op == RU_XOR { return x ^ y; }
    if op == RU_SHL { return x << y; }
    if op == RU_SHR { return x >> y; }
    if op == RU_EQ { if x == y { return 1; } return 0; }
    if op == RU_NE { if x != y { return 1; } return 0; }
    if op == RU_LT { if x < y { return 1; } return 0; }
    if op == RU_LE { if x <= y { return 1; } return 0; }
    if op == RU_GT { if x > y { return 1; } return 0; }
    if op == RU_GE { if x >= y { return 1; } return 0; }
    return 0;
}

/// Each rule on edge values and pseudo-random ones: its left side computed,
/// its result compared. Prints a line per rule; the number of failures.
pub fn rules_selftest() -> i64 {
    var rules: Vec<RuRule> = ru_rules();
    var xs: Vec<i64> = Vec::new();
    xs.push(0); xs.push(1); xs.push(0 - 1); xs.push(2); xs.push(7); xs.push(0 - 7);
    xs.push(9223372036854775807); xs.push(0 - 9223372036854775807 - 1); xs.push(4611686018427387904);
    var seed: i64 = 88172645463325252;
    var i: i64 = 0;
    while i < 300 {
        seed = seed ^ (seed << 13);
        seed = seed ^ (seed >> 7);
        seed = seed ^ (seed << 17);
        xs.push(seed);
        i = i + 1;
    }
    var fails: i64 = 0;
    var ri: i64 = 0;
    while ri < rules.len() {
        var r: RuRule = rules.get(ri);
        var bad: i64 = 0;
        var xi: i64 = 0;
        while xi < xs.len() {
            var x: i64 = xs.get(xi);
            var lhs: i64 = 0;
            if r.shape == RS_RIGHT { lhs = ru_eval(r.op, x, r.c); }
            else if r.shape == RS_LEFT { lhs = ru_eval(r.op, r.c, x); }
            else { lhs = ru_eval(r.op, x, x); }
            var rhs: i64 = x;
            if r.res == RR_CONST { rhs = r.rc; }
            if r.res == RR_TRUE { rhs = 1; }
            if r.res == RR_FALSE { rhs = 0; }
            if lhs != rhs { bad = bad + 1; }
            xi = xi + 1;
        }
        if bad == 0 { print("ok    " + r.name + "\n"); }
        else { print("FAIL  " + r.name + " (" + int_to_str(bad) + " values)\n"); fails = fails + 1; }
        ri = ri + 1;
    }
    print(int_to_str(rules.len()) + " rules, " + int_to_str(fails) + " failed\n");
    return fails;
}

// --- SMT proof obligations (own-backend roadmap ME17) -------------------

/// The operation as an SMT-LIB bit-vector term.
fn ru_smt_term(op: i64, a: str, b: str) -> str {
    if op == RU_ADD { return "(bvadd " + a + " " + b + ")"; }
    if op == RU_SUB { return "(bvsub " + a + " " + b + ")"; }
    if op == RU_MUL { return "(bvmul " + a + " " + b + ")"; }
    if op == RU_DIV { return "(bvsdiv " + a + " " + b + ")"; }
    if op == RU_AND { return "(bvand " + a + " " + b + ")"; }
    if op == RU_OR { return "(bvor " + a + " " + b + ")"; }
    if op == RU_XOR { return "(bvxor " + a + " " + b + ")"; }
    if op == RU_SHL { return "(bvshl " + a + " " + b + ")"; }
    if op == RU_SHR { return "(bvashr " + a + " " + b + ")"; }
    if op == RU_EQ { return "(= " + a + " " + b + ")"; }
    if op == RU_NE { return "(not (= " + a + " " + b + "))"; }
    if op == RU_LT { return "(bvslt " + a + " " + b + ")"; }
    if op == RU_LE { return "(bvsle " + a + " " + b + ")"; }
    if op == RU_GT { return "(bvsgt " + a + " " + b + ")"; }
    return "(bvsge " + a + " " + b + ")";
}

fn ru_smt_const(v: i64, width: i64) -> str {
    if v < 0 { return "(bvneg (_ bv" + int_to_str(0 - v) + " " + int_to_str(width) + "))"; }
    return "(_ bv" + int_to_str(v) + " " + int_to_str(width) + ")";
}

/// Write `dir/<rule>_<width>.smt2` for every rule at 8, 16, 32 and 64 bits:
/// each asserts that the two sides differ, so `unsat` (z3, cvc5) proves the
/// rule. scripts/rules-smt.sh runs them. The number of files not written.
pub fn rules_smt(dir: str) -> i64 {
    var rules: Vec<RuRule> = ru_rules();
    var widths: Vec<i64> = Vec::new();
    widths.push(8); widths.push(16); widths.push(32); widths.push(64);
    var failed: i64 = 0;
    var written: i64 = 0;
    var ri: i64 = 0;
    while ri < rules.len() {
        var r: RuRule = rules.get(ri);
        var wi: i64 = 0;
        while wi < widths.len() {
            var w: i64 = widths.get(wi);
            var c: str = ru_smt_const(r.c, w);
            var lhs: str = "";
            if r.shape == RS_RIGHT { lhs = ru_smt_term(r.op, "x", c); }
            else if r.shape == RS_LEFT { lhs = ru_smt_term(r.op, c, "x"); }
            else { lhs = ru_smt_term(r.op, "x", "x"); }
            var rhs: str = "x";
            if r.res == RR_CONST { rhs = ru_smt_const(r.rc, w); }
            if r.res == RR_TRUE { rhs = "true"; }
            if r.res == RR_FALSE { rhs = "false"; }
            var text: str = "; " + r.name + " at " + int_to_str(w) + " bits: unsat proves it\n"
                + "(set-logic QF_BV)\n(declare-const x (_ BitVec " + int_to_str(w) + "))\n"
                + "(assert (not (= " + lhs + " " + rhs + ")))\n(check-sat)\n";
            var path: str = dir + "/rule" + int_to_str(ri) + "_" + int_to_str(w) + ".smt2";
            p_file_write(path, text);
            if c_file_exists(path) { written = written + 1; } else { failed = failed + 1; }
            wi = wi + 1;
        }
        ri = ri + 1;
    }
    print(int_to_str(written) + " SMT-LIB files in " + dir + "\n");
    return failed;
}

// --- WP20: library-facts consumer -------------------------------------------

var g_lib_state: i64 = 0;   // 0 unread, -1 absent/error, 1 loaded
var g_lib_pure: i64 = 0;    // name -> 1
var g_lib_read: i64 = 0;

/// First index of char `ch` at or after `from`, or -1.
fn ru_find_ch(s: str, ch: i64, from: i64) -> i64 {
    var i: i64 = from;
    while i < str_len(s) {
        if str_byte_at(s, i) == ch { return i; }
        i = i + 1;
    }
    return -1;
}

/// Read FID_LIBFACTS_IN once: `fn <name> params=N effects=<list>` lines only
/// (`ext` and anything malformed are skipped). The first line must be the
/// `# fid-facts 1` version header; anything else is rejected whole-file so a
/// stale or foreign artifact can't feed wrong facts. Kind: 1 pure, 2 read.
fn ru_lib_load() {
    if g_lib_state != 0 { return; }
    g_lib_state = -1;
    var path: str = p_getenv("FID_LIBFACTS_IN");
    if (path as i64) == 0 || str_len(path) == 0 { return; }
    var data: str = p_file_read(path);
    if (data as i64) == 0 { return; }
    if !str_starts_with(data, "# fid-facts 1\n") { return; }
    g_lib_pure = HashMap_new();
    g_lib_read = HashMap_new();
    var ls: Vec<str> = str_split(data, "\n");
    var li: i64 = 0;
    while li < ls.len() {
        var line: str = ls.get(li);
        li = li + 1;
        if !str_starts_with(line, "fn ") { continue; }
        var sp: i64 = ru_find_ch(line, 32, 3);
        var ep: i64 = str_find(line, " effects=");
        if sp < 0 || ep < 0 || ep < sp { continue; }
        var nm: str = str_slice(line, 3, sp);
        var ee: i64 = ep + 9;
        var eend: i64 = ru_find_ch(line, 32, ee);
        if eend < 0 { eend = str_len(line); }
        var elist: str = str_slice(line, ee, eend);
        if elist == "pure" { HashMap_insert(g_lib_pure, nm, 1); }
        var pieces: Vec<str> = str_split(elist, ",");
        var pi: i64 = 0;
        var ok: bool = true;
        while pi < pieces.len() {
            var pc: str = pieces.get(pi);
            if pc != "read" && pc != "diverge" { ok = false; }
            pi = pi + 1;
        }
        if ok { HashMap_insert(g_lib_read, nm, 1); }
    }
    g_lib_state = 1;
}

/// The artifact's effect class for `name`: 1 pure, 2 read-only, else 0.
fn ru_lib_kind(name: str) -> i64 {
    ru_lib_load();
    if g_lib_state != 1 { return 0; }
    if HashMap_contains(g_lib_pure, name) { return 1; }
    if HashMap_contains(g_lib_read, name) { return 2; }
    return 0;
}
