// nat_ir.fd -- IR -> native Linux executables for AArch64 and RISC-V 64
// (release F8): `fid emit <file.fd> --target aarch64-linux|riscv64-linux`.
//
// The same lowering as the Windows backend (compiler/pe_ir.fd), written once
// over a small architecture layer (the ng_* functions): every IR value has a
// stack slot, an instruction loads its operands into scratch registers,
// computes, and stores its result. Integer semantics are pe_ir's (and the
// interpreter's, release F6): i64/u64 arithmetic panics on overflow unless
// the function is @wrapping, a narrow result that does not fit panics,
// division and remainder by zero panic everywhere, MIN / -1 panics.
//
// Calling convention (internal; nothing calls C): arguments in x0..x7 /
// a0..a7, the rest on the stack, the result in x0 / a0; a float travels as
// its bits. Fides functions take `__env` first, as on every backend; a
// builtin p_X runs the runtime's Fides pert_X (stdlib/linux_runtime) with a
// null `__env`, as on Windows.
//
// The runtime's only primitives are machine code here: `_start`,
// `nat_syscall(n, a..f)` and `nat_start_sp()` (the stack pointer the kernel
// started the process with: argc, argv, envp). Functions are compiled from
// `main` on, as they are called (a worklist): unused code is never emitted.

module compiler::nat_ir;
use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::pe_ir_stubs;
use compiler::nat_enc;
use compiler::nat_thumb;
use compiler::checks;
use compiler::inc;
use compiler::ast_ser;
use compiler::pgo;
use compiler::mir;
// MI1: the machine IR itself (MInst, the MO_* operations, the compare,
// extension and panic kinds NCC_* / NEXT_* / NP_*, NG_VBASE, the blocks,
// liveness, the printer and the structural verifier) is compiler/mir.fd.
// The panic messages, in NP_* order:
fn nat_panic_messages() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("Integer overflow on addition");
    v.push("Integer overflow on subtraction");
    v.push("Integer overflow on multiplication");
    v.push("Integer overflow on division");
    v.push("Division by zero");
    v.push("Modulo by zero");
    return v;
}

pub struct NatGen {
    pub arch: i64,
    pub e: NatEnc,
    // Name -> label: compiled (or queued) functions and the primitives
    pub fn_labels: i64,
    // J7: function label -> 1 for @constant_time functions, so ng_ct_check
    // can tell whether a MO_CALL target is itself constant-time
    pub ct_labels: i64,
    // Every function of the module: name -> 1
    pub all_fns: i64,
    // Functions queued for compilation, in order
    pub queue: Vec<str>,
    pub queued: i64,
    // String constant -> label, and the strings in order of first use
    pub str_labels: i64,
    pub strs: Vec<str>,
    // Global name -> label, and the globals in order
    pub glob_labels: i64,
    pub globs: Vec<str>,
    pub panic_labels: Vec<i64>,
    pub start_sp_label: i64,
    pub entry_label: i64,
    // Called but defined nowhere: "name (from caller)"
    pub unresolved: Vec<str>,
    pub unresolved_seen: i64,
    // dyn: sorted type names; the id of a type is its position + 1
    pub dyn_types: Vec<str>,
    // Functions named by a string constant (thread and task entries):
    // the table nat_fn_table returns, for the runtime's lookup by name
    pub named_fns: Vec<str>,
    pub named_seen: i64,
    pub fn_table_label: i64,
    // extern "C" functions: Fides name -> 1 + index in c_list (C names)
    pub c_names: i64,
    pub c_list: Vec<str>,
    // The task trampoline (nat_ctx_tramp)
    pub tramp_label: i64,
    // The current function's area for the arguments of a varargs spawn
    pub va_off: i64,
    // Register allocation of the current function: value id -> register
    // (-1: its slot), the callee-saved registers it uses and where they
    // are saved (sp + save_off)
    pub vreg: Vec<i64>,
    pub save_regs: Vec<i64>,
    pub save_off: i64,
    // Panic traces: [address, name] of each function in placement order,
    // then [end of code, 0] (nat_fn_names)
    pub names_label: i64,
    pub code_end_label: i64,
    pub placed_fns: Vec<str>,
    // The machine IR: recording (lowering appends to `mir`), the next vreg,
    // the promoted locals of the function being recorded (1 + extension
    // kind), its frame once allocated, every recorded function, label ->
    // function name, the clobber masks of allocated functions (IPRA), and
    // how many functions were folded into an identical one
    pub rec: bool,
    pub mir: Vec<MInst>,
    pub nvreg: i64,
    pub promoted: Vec<i64>,
    pub frame: i64,
    pub recs: Vec<NatFnRec>,
    pub label_fn: i64,
    pub fn_mask: i64,
    pub n_folded: i64,
    pub n_peep: i64,
    // The function being compiled
    pub cur_name: str,
    pub cur_wrapping: bool,
    pub cur_crashfree: bool,
    // MI4: the target description (nat_target_desc), built once
    pub td: NatTarget,
    // WP11: the @crashfree functions recorded: name -> 1 (ng_crashfree_check)
    pub cf_fns: i64,
    // CI2: C functions bound by the Linux dynamic linker (ng_ldyn_*)
    pub ld: NatLdyn,
    pub leaf: i64,
    // LF20: the bytes at sp each epilogue of the function being emitted
    // zeroes (a function holding a secret: its frame below the register
    // save area, ng_wipe_frame); 0: none
    pub wipe: i64,
    // ME27 / LF24: the functions that return their struct result in two
    // registers instead of through the hidden result pointer: function
    // label -> the struct's size, 8 or 16 (ng_rr_plan)
    pub rr_size: i64,
    pub internal: i64,
    pub fact_path: str,
    pub lib_mask: i64,
    pub slots: Vec<i64>,
    pub alloca_data: Vec<i64>,
    pub block_labels: i64,
    pub next_block_label: i64,
    // Scratch registers of the architecture
    pub t0: i64,
    pub t1: i64,
    pub t2: i64,
    pub t3: i64,
    pub ad: i64,
    pub ad2: i64,
    pub zr: i64,
    pub arg0: i64,
    // Windows x64 (x86_64-windows on this layer): the import address
    // table's slot per import (ng_win_imports), a table of their
    // addresses, the TLS index, the import directory and IAT bounds
    pub win: bool,
    // macOS (x86_64-macos / aarch64-macos on this layer): the import GOT
    // base label (one 8-byte slot per libSystem symbol, ng_mac_imports)
    pub mac: bool,
    pub mac_got_label: i64,
    pub win_slot_labels: Vec<i64>,
    pub win_slots_label: i64,
    pub win_tls_label: i64,
    pub win_imp_label: i64,
    pub win_imp_end: i64,
    pub win_iat_label: i64,
    pub win_iat_end: i64,
    // Line rows for .debug_line (DB1): the functions of the input file,
    // [image offset, line, 1 = end of a sequence] per row, whether a
    // sequence is open, the function being lowered gets rows, its line
    pub line_fns: i64,
    pub lrows: Vec<i64>,
    pub lrow_open: bool,
    pub lines_cur_fn: bool,
    pub cur_line: i64,
    // DB6: the epilogues of framed functions, for .debug_frame's rules
    // there: [image offset where the frame record is gone (x64/AArch64:
    // the ret; RISC-V: the final addi sp), RISC-V the ret (else -1), the
    // offset after the ret] per epilogue, in address order (ng_cfi_row)
    pub cfi_rows: Vec<i64>,
    // checks.fd's facts for the function being lowered: per value id, bit
    // 1 an operation that needs no overflow or bounds check
    pub unchecked: Vec<i64>,
    // Panics with the source line (as the interpreter prints them): the
    // line of the instruction being lowered, and per "which:line" a stub
    // label ([which, line, label] each in pl_list), emitted after the code
    pub cur_inst_line: i64,
    pub pl_keys: i64,
    pub pl_list: Vec<i64>,
    // x86-64: the general register whose f64 bits xmm0 / xmm1 hold now (-1:
    // none), so a chain of float operations stays in xmm (`xmmcache`)
    pub x0_reg: i64,
    pub x1_reg: i64,
    // TG6: the branch being emitted takes its short form (ng_mir_emit's
    // relaxation found its target in reach): x86-64 rel8, RISC-V one B<cc>
    // (or JAL ra for a call)
    pub br_short: bool,
    // TG14: the label of a position-independent executable's relocation
    // table (0: a fixed-address image)
    pub pie_table: i64,
    // CS6: per-function native artifact cache — opt-in via FID_FNCACHE=<path>.
    // nc_old holds entries read from disk; nc_new entries captured this run.
    pub nc_on: bool,
    pub nc_path: str,
    pub nc_old: Vec<NcEntry>,
    pub nc_ix: i64,
    // name -> index into nc_old + 1
    pub nc_new: Vec<NcEntry>,
    pub nc_hit: i64,
    // name -> index into nc_old + 1 (content key matched)
    pub nc_key: i64,
    // name -> content key computed this run
    pub nc_salt: i64,
    pub label_id: i64,
    // label -> "F:name" / "S:content" / "G:singleton"
    pub fn_label_names: Vec<str>,
    // fn_labels keys in insertion order
    pub pl_names: Vec<str>,
    // pl_keys keys in insertion order
    pub nc_hit_names: Vec<str>,
    // SP5: what the emission of one function keeps between its operations,
    // here and not in module globals so that each worker of the parallel
    // emission (ng_par_*) has its own: RA12's save-area subsets the
    // prologue saves and the epilogue being emitted restores (-1: every
    // one; ng_sw_plan), TG17's count of loads forwarded from a store (added
    // to g_nat_ldfwd_n by the thread that owns the image), CT6's code
    // offset of each machine instruction for the debug ranges and whether
    // they are kept (ng_dbg_mark), MI28's marks of the calls that may pass
    // the frame's address (ng_tail_pre, made before the emission), whether
    // this generator is a worker's (par_w), then the file index of its
    // line rows (line_fix, else nat_enc.fd's g_nat_line_file_ix) and what
    // `--stats` prints about the function (par_log, printed at the join)
    pub sw_pro: i64,
    pub sw_ep: i64,
    pub ldfwd_n: i64,
    pub dbg_mpos: Vec<i64>,
    pub dbg_mark_on: bool,
    pub tc_taint: Vec<i64>,
    pub par_w: bool,
    pub line_fix: i64,
    pub par_log: str,
    // LF20: the register wipe of the function being emitted or allocated
    // (ng_wipe_setup): on, its clobber mask, argument register 1 kept (a
    // result in two registers)
    pub wipe_on: bool,
    pub wipe_regs: i64,
    pub wipe_keep1: bool,
}

/// RA14: the fast allocator of debug builds (ng_fast_alloc_on), for main.fd
/// to set; FID_NAT_FAST=1 turns it on too.
pub var g_nat_fast: bool = false;

// (RA12's save-area subsets of the prologue and the epilogue being emitted
// are NatGen.sw_pro / sw_ep: SP5's workers each have their own.)

/// TG19: `--size` (main.fd): smaller code over faster code: loop heads are
/// not padded to 16 bytes (ng_code_align) and the Vec calls are not
/// inlined (ng_gen_call, as FID_NAT_OFF=vecinline).
pub var g_nat_size: bool = false;

/// RL20: `--crash-report` (main.fd): each function's name on stderr
/// ("[nat] <name>") before its code is made, so a crash names it.
pub var g_nat_trace: bool = false;

/// MI11: a function name (or `*`: all) whose machine IR is printed to
/// stderr after allocation, for main.fd to set (a `dump-mir` command);
/// FID_NAT_DUMP does the same.
pub var g_nat_dump: str = "";

/// RL16: `fid emit --leaks` (main.fd sets it): the runtime keeps every
/// block the program allocates on a list and reports those never freed at
/// exit (stdlib/linux_runtime/base.fd, pe_dbg_*). `--checked-alloc` is
/// pe_ir_stubs' g_pe_checked_alloc, read here too. Both reach the runtime
/// as the initial value of its global lrt_mem_mode (ng_mem_mode).
pub var g_nat_leaks: bool = false;

/// L7C: `fid emit --mem` (main.fd sets it): the runtime's memory profile
/// at exit (stdlib/linux_runtime/base.fd pe_mem_report), as
/// FID_MEM_PROFILE=1 asks for at run time.
pub var g_nat_mem_profile: bool = false;

/// RL16: the runtime's allocator mode: 1 checked blocks, 2 the leak list,
/// 4 the memory profile (L7C).
fn ng_mem_mode() -> i64 {
    var mode: i64 = 0;
    if g_pe_checked_alloc {
        mode = mode | 1;
    }
    if g_nat_leaks {
        mode = mode | 2;
    }
    if g_nat_mem_profile {
        mode = mode | 4;
    }
    return mode;
}

/// The input file and its functions' names (comma-separated), set by
/// main.fd for the line table; empty: no line rows.
pub var g_nat_lines_file: str = "";
pub var g_nat_lines_names: str = "";
/// --cpu <name> (TG10) and --stats (RA17), set by main.fd.
pub var g_nat_cpu: str = "";
pub var g_nat_stats: bool = false;
pub fn NatGen_new(arch: i64) -> NatGen {
    var g: NatGen = NatGen {
        arch: arch, e: NatEnc_new(), fn_labels: HashMap_new(), ct_labels: HashMap_new(), all_fns: HashMap_new(), queue: Vec::new(), queued: HashMap_new(), str_labels: HashMap_new(), strs: Vec::new(), glob_labels: HashMap_new(), globs: Vec::new(), panic_labels: Vec::new(), start_sp_label: 0, entry_label: 0, unresolved: Vec::new(), unresolved_seen: HashMap_new(), dyn_types: Vec::new(), named_fns: Vec::new(), named_seen: HashMap_new(), fn_table_label: 0, c_names: HashMap_new(), c_list: Vec::new(), tramp_label: 0, va_off: 0 - 1, vreg: Vec::new(), save_regs: Vec::new(), save_off: 0, names_label: 0, code_end_label: 0, placed_fns: Vec::new(), rec: false, mir: Vec::new(), nvreg: 0, promoted: Vec::new(), frame: 16, recs: Vec::new(), label_fn: HashMap_new(), fn_mask: HashMap_new(), n_folded: 0, n_peep: 0, cur_name: "", cur_wrapping: false, cur_crashfree: false, leaf: 0, wipe: 0, rr_size: HashMap_new(), internal: HashMap_new(), fact_path: "", lib_mask: HashMap_new(), slots: Vec::new(), alloca_data: Vec::new(), block_labels: HashMap_new(), next_block_label: -1, t0: 9, t1: 10, t2: 11, t3: 12, ad: 16, ad2: 17, zr: 31, arg0: 0, win: false, mac: false, mac_got_label: 0, win_slot_labels: Vec::new(), win_slots_label: 0, win_tls_label: 0, win_imp_label: 0, win_imp_end: 0, win_iat_label: 0, win_iat_end: 0, line_fns: HashMap_new(), lrows: Vec::new(), lrow_open: false, lines_cur_fn: false, cur_line: 0, cfi_rows: Vec::new(), unchecked: Vec::new(), cur_inst_line: 0, pl_keys: HashMap_new(), pl_list: Vec::new(), x0_reg: 0 - 1, x1_reg: 0 - 1, br_short: false, pie_table: 0, nc_on: false, nc_path: "", nc_old: Vec::new(), nc_ix: HashMap_new(), nc_new: Vec::new(), nc_hit: HashMap_new(), nc_key: HashMap_new(), nc_salt: 0, label_id: HashMap_new(), fn_label_names: Vec::new(), pl_names: Vec::new(), nc_hit_names: Vec::new(), td: nat_target_desc(arch), cf_fns: HashMap_new(), ld: NatLdyn_new(), sw_pro: 0 - 1, sw_ep: 0 - 1, ldfwd_n: 0, dbg_mpos: Vec::new(), dbg_mark_on: false, tc_taint: Vec::new(), par_w: false, line_fix: 0, par_log: "", wipe_on: false, wipe_regs: 0, wipe_keep1: false,
    };
    // MI4: the scratch registers come from the target description
    g.t0 = g.td.t0;
    g.t1 = g.td.t1;
    g.t2 = g.td.t2;
    g.t3 = g.td.t3;
    g.ad = g.td.ad;
    g.ad2 = g.td.ad2;
    g.zr = g.td.zr;
    g.arg0 = g.td.arg0;
    // SP5: the tables the emission reads, made before anything is emitted
    // (emission may run on worker threads, which only read them)
    ng_emit_tables();
    return g;
}

// ===========================================================================
// MI4: the target description. Every register fact of a target the
// allocator, the argument lowering and the spill code read is in one
// record per target (nat_target_desc), kept in NatGen.td, instead of `if`
// chains on g.arch in each function.
// RA10: its register classes.
// ===========================================================================

/// RA10: the register classes. A value of class NG_RC_INT lives in a
/// general register, one of NG_RC_FLOAT (an f64) or NG_RC_F32 (an f32,
/// kept single precision: MI25) in a float register. No target of
/// this layer needs register pairs (each is 64-bit: a value is one
/// register), so there is no pair class (NatTarget.pairs is false).
const NG_RC_INT: i64 = 0;
const NG_RC_FLOAT: i64 = 1;
const NG_RC_F32: i64 = 2;
/// MI25: float register f (xmm f, v f, f f) is physical register number
/// NG_FREG + f once allocated; general registers keep 0..31 (and x86-64's
/// zero-register stand-in 60 is past its 16 float registers).
const NG_FREG: i64 = 32;

pub struct NatTarget {
    pub arch: i64,
    // Integer class: the pool registers. Caller-saved ones are lost at a
    // call that clobbers them (in the order the allocator tries them);
    // callee-saved ones are saved by the prologue that uses them. The same
    // sets as bit masks (registers 0..63).
    pub int_caller: Vec<i64>,
    pub int_callee: Vec<i64>,
    pub int_caller_mask: i64,
    pub int_callee_mask: i64,
    // Float class: the target's float registers, those the allocator may
    // hand out (as NG_FREG + f; all caller-saved, so no prologue saves
    // one), the two the float operations use as scratch, and the class a
    // float value is allocated in. MI25 (FID_NAT_ON=fregs): a float value
    // the allocator puts in the float class lives in a float register;
    // otherwise (and for every value without the switch) a float travels
    // as its bits in a general register and each float operation moves
    // its operands to the scratch pair.
    pub float_regs: Vec<i64>,
    pub float_pool: Vec<i64>,
    pub float_scratch: Vec<i64>,
    pub float_class: i64,
    pub pairs: bool,
    // Arguments: the platform convention's registers (the first nregargs),
    // then those the extended internal convention adds (WP6), up to
    // nregargs_int; the result register
    pub argregs: Vec<i64>,
    pub nregargs: i64,
    pub nregargs_int: i64,
    pub result_reg: i64,
    // The spill scratch registers: two for uses, one for the definition
    pub spill_use0: i64,
    pub spill_use1: i64,
    pub spill_def: i64,
    // The lowering's scratch registers: t0..t3 for values, ad and ad2 for
    // addresses, zr the zero register (60 on x86-64, which has none: a
    // physical number the machine IR leaves alone, vregs start at 64),
    // arg0 the first argument register's number
    pub t0: i64,
    pub t1: i64,
    pub t2: i64,
    pub t3: i64,
    pub ad: i64,
    pub ad2: i64,
    pub zr: i64,
    pub arg0: i64,
    // Stack pointer alignment at a call, and the red zone the code may use
    // below sp (none: frames are always allocated)
    pub stack_align: i64,
    pub red_zone: i64,
}

fn nt_mask(v: &Vec<i64>) -> i64 {
    var m: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        m = m | (1 << v.get(i));
        i = i + 1;
    }
    return m;
}

/// The target description of `arch` (NAT_X64, NAT_A64, NAT_RV64).
fn nat_target_desc(arch: i64) -> NatTarget {
    var caller: Vec<i64> = Vec::new();
    var callee: Vec<i64> = Vec::new();
    var fregs: Vec<i64> = Vec::new();
    var fscr: Vec<i64> = Vec::new();
    var args: Vec<i64> = Vec::new();
    // MI25: the float pool, caller-saved registers only, past the scratch
    // pair 0 and 1 and short of the vector operations' scratch (TG11:
    // x86-64 xmm12..xmm15, AArch64 v28..v31): x86-64 xmm2..xmm11 (--nat
    // Windows too, MI14: ng_fregs_on); AArch64 v16..v27;
    // RISC-V ft2..ft7 and ft8..ft11 = f2..f7, f28..f31; as NG_FREG + f
    var fpool: Vec<i64> = Vec::new();
    fscr.push(0);
    fscr.push(1);
    var r: i64 = 0;
    if arch == NAT_X64 {
        // rbx, r12..r15; no caller-saved pool register (rax, rcx, rdx, rsi,
        // rdi, r8..r11 are argument, result and scratch registers; RA7 and
        // RA3 still give rdi, rsi, rdx and rcx to ranges where no operation
        // uses them: ng_arg_hints, ng_arg_free)
        callee.push(3);
        callee.push(12);
        callee.push(13);
        callee.push(14);
        callee.push(15);
        while r < 16 {
            fregs.push(r);
            if r >= 2 && r <= 11 {
                fpool.push(NG_FREG + r);
            }
            r = r + 1;
        }
        // rdi, rsi, rdx, rcx; the internal convention adds r9 (r8, r10,
        // r11 are the generator's temporaries)
        args.push(7);
        args.push(6);
        args.push(2);
        args.push(1);
        args.push(9);
        return NatTarget {
            arch: arch, int_caller: caller, int_callee: callee, int_caller_mask: 0, int_callee_mask: (1 << 3) | (1 << 12) | (1 << 13) | (1 << 14) | (1 << 15), float_regs: fregs, float_pool: fpool, float_scratch: fscr, float_class: NG_RC_FLOAT, pairs: false, argregs: args, nregargs: 4, nregargs_int: 5, result_reg: 0, spill_use0: 8, spill_use1: 9, spill_def: 0, t0: 0, t1: 2, t2: 1, t3: 8, ad: 10, ad2: 11, zr: 60, arg0: 7, stack_align: 16, red_zone: 0,
        };
    }
    while r < 32 {
        fregs.push(r);
        if arch == NAT_RV64 && ((r >= 2 && r <= 7) || r >= 28) {
            fpool.push(NG_FREG + r);
        }
        if arch != NAT_RV64 && r >= 16 && r <= 27 {
            fpool.push(NG_FREG + r);
        }
        r = r + 1;
    }
    if arch == NAT_RV64 {
        // t4 (x29); s1, s2..s11. t1, t2, t3 (x6, x7, x28) for values, t0
        // and t5 (x5, x30) for addresses, t6 (x31) far jumps and the
        // internal convention's ninth argument
        caller.push(29);
        callee.push(9);
        r = 18;
        while r <= 27 {
            callee.push(r);
            r = r + 1;
        }
        r = 10;
        while r <= 17 {
            args.push(r);
            r = r + 1;
        }
        args.push(31);
        var rmask: i64 = nt_mask(&callee);
        return NatTarget {
            arch: arch, int_caller: caller, int_callee: callee, int_caller_mask: 1 << 29, int_callee_mask: rmask, float_regs: fregs, float_pool: fpool, float_scratch: fscr, float_class: NG_RC_FLOAT, pairs: false, argregs: args, nregargs: 8, nregargs_int: 9, result_reg: 10, spill_use0: 6, spill_use1: 7, spill_def: 28, t0: 6, t1: 7, t2: 28, t3: 29, ad: 5, ad2: 30, zr: 0, arg0: 10, stack_align: 16, red_zone: 0,
        };
    }
    // AArch64: x9, x10, x11, x8; x19..x28. x0..x7 arguments, the internal
    // convention adds x13..x15; x12, x14, x15 spill, x16/x17 addresses
    caller.push(9);
    caller.push(10);
    caller.push(11);
    caller.push(8);
    r = 19;
    while r <= 28 {
        callee.push(r);
        r = r + 1;
    }
    r = 0;
    while r <= 7 {
        args.push(r);
        r = r + 1;
    }
    args.push(13);
    args.push(14);
    args.push(15);
    var amask: i64 = nt_mask(&caller);
    var bmask: i64 = nt_mask(&callee);
    return NatTarget {
        arch: arch, int_caller: caller, int_callee: callee, int_caller_mask: amask, int_callee_mask: bmask, float_regs: fregs, float_pool: fpool, float_scratch: fscr, float_class: NG_RC_FLOAT, pairs: false, argregs: args, nregargs: 8, nregargs_int: 11, result_reg: 0, spill_use0: 14, spill_use1: 15, spill_def: 12, t0: 9, t1: 10, t2: 11, t3: 12, ad: 16, ad2: 17, zr: 31, arg0: 0, stack_align: 16, red_zone: 0,
    };
}

/// RA10: the pool of class `cls`: caller-saved (callee false) or
/// callee-saved registers.
fn ng_class_pool(g: &NatGen, cls: i64, callee: bool) -> Vec<i64> {
    if cls != NG_RC_INT {
        if callee {
            // RA18: d8..d15 (AArch64), fs0..fs11 (RISC-V); none on x86-64
            return ng_float_callee_pool(g);
        }
        return ng_float_pool(g);
    }
    if callee {
        return g.td.int_callee;
    }
    return g.td.int_caller;
}

/// MI25 / OP17 / MI14: floats in float registers, on by default on every
/// target (FID_NAT_OFF=fregs: every value an integer, the code as it was).
/// --nat Windows has the same pool as Linux, xmm2..xmm11, and the same
/// vector registers, xmm12..xmm15 (ng_vphys): Windows keeps xmm6..xmm15
/// across its own functions, and the one place Windows calls this code and
/// gets control back, the vectored exception handler, saves and restores
/// them (ng_gen_primitives_win). FID_NAT_OFF=winfregs turns the class off
/// on --nat Windows alone (MI14: the switch to compare the two). (The
/// switches are read once per process: 1 off, 2 on, 3 on and asked for.)
var g_ng_fregs: i64 = 0;
var g_ng_winfregs: bool = true;
/// The switches' state as g_ng_fregs keeps it (1 off, 2 on, 3 on and
/// asked for).
fn ng_fregs_state() -> i64 {
    var st: i64 = 1;
    if ng_on("fregs") {
        st = 2;
        if ng_opt_in("fregs") {
            st = 3;
        }
    }
    return st;
}

/// SP5: read the switches once (NatGen_new, ng_emit_tables), so that
/// ng_fregs_on, which the emission's worker threads call, only reads.
fn ng_fregs_init() {
    if g_ng_fregs == 0 {
        g_ng_fregs = ng_fregs_state();
        g_ng_winfregs = ng_on("winfregs");
    }
}

fn ng_fregs_on(g: &NatGen) -> bool {
    var st: i64 = g_ng_fregs;
    var winf: bool = g_ng_winfregs;
    if st == 0 {
        // (before ng_fregs_init: read now, kept by nothing)
        st = ng_fregs_state();
        winf = ng_on("winfregs");
    }
    if g.win && st != 3 && !winf {
        return false;
    }
    return st >= 2 && g.td.float_pool.len() > 0;
}

/// MI25: the float registers the allocator hands out (none when the switch
/// is off). --nat Windows hands out the same ones as Linux (MI14: the
/// vectored exception handler keeps Windows' xmm6..xmm15, see
/// ng_fregs_on).
fn ng_float_pool(g: &NatGen) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    if !ng_fregs_on(g) {
        return p;
    }
    var i: i64 = 0;
    while i < g.td.float_pool.len() {
        p.push(g.td.float_pool.get(i));
        i = i + 1;
    }
    return p;
}

/// MI25: the float pool as a mask over registers 0..63 (every call
/// clobbers all of them: none is callee-saved).
fn ng_float_mask(g: &NatGen) -> i64 {
    var p: Vec<i64> = ng_float_pool(g);
    return nt_mask(&p);
}

// ---------------------------------------------------------------------------
// RA18: callee-saved float registers. A float range a call falls inside
// takes one of the ABI's callee-saved float registers instead of a slot:
// AArch64 d8..d15 (the low 64 bits of v8..v15, all an f64 or f32 value
// uses), RISC-V fs0, fs1, fs2..fs11 (f8, f9, f18..f27). x86-64 has none
// (System V keeps no xmm register; --nat Windows keeps xmm6..xmm15, but
// those are the float pool and vector class already). A function that
// uses one saves it in its register save area like an integer one
// (ng_save_subset: str d / fsd, stp d pairs on AArch64), so RA12 shrink
// wrapping and OP13 tail calls handle them unchanged; every callee keeps
// them, C ones too (AAPCS64, the RISC-V psABI). The one code that does not
// is the task switch: nat_ctx_swap (ng_prim_ctx_swap) keeps only the
// integer callee-saved registers, so a program that can start a task
// (an IR call of p_co_go / p_co_async, or of their runtime functions from
// outside the scheduler: ng_fcs_tasks) keeps every float off these
// registers (g_ng_fcs_block, decided for the whole module before the code
// cache's salt). FID_NAT_OFF=fcallee: none, a float range across a call
// spills as before. FID_NAT_MUTATE=fcallee (TG2): the registers are used
// but not saved, so tests/bootstrap/test_machine_fcallee.fd must fail.
// ---------------------------------------------------------------------------

/// RA18: the module can start a task (set before allocation, ng_fcs_tasks).
var g_ng_fcs_block: bool = false;

// Roadmap L6C (@7737): C function pointers. Lowering makes an address cast
// to a function type (or a typed p_dl_find) an env whose word 0 is
// ConstFnRef("__fid_c_fnptr"), which resolves to label 0 (no function has
// that name), and word 1 the address. In a module that makes one
// (ng_cfp_scan, decided before the code cache's salt, which names it),
// every CallPtr goes through a stub per C signature (ng_gen_cfp_stubs):
// word 0 not 0, a closure, jumps to its function with the arguments as
// they are; else the address in word 1 is called with the target's C
// convention, without the env. Elsewhere a CallPtr calls word 0 as before.
var g_ng_cfp_on: bool = false;
var g_ng_cfp_sigs: Vec<str> = Vec::new();
var g_ng_cfp_labels: Vec<i64> = Vec::new();

/// L6C: does the module make a C function pointer (the marker's ConstFnRef)?
fn ng_cfp_scan(m: &IrModule) -> bool {
    var fi: i64 = 0;
    while fi < m.functions.len() {
        var insts: Vec<ValueIdInst> = m.functions.get(fi).func.insts;
        var k: i64 = 0;
        while k < insts.len() {
            match insts.get(k).inst {
                Inst::ConstFnRef(fname) => {
                    if fname == "__fid_c_fnptr" {
                        return true;
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        fi = fi + 1;
    }
    return false;
}

/// A CallPtr whose result is a struct or enum (lower.fd
/// Lowerer_lower_call_expr_resolved: its result type is a Struct and
/// args[0] the pointer the callee writes the result to). That pointer is
/// passed first, before the env, as for a direct call (codegen_c's
/// sret_call, iropt's iro_cp_direct_args).
fn ng_callptr_sret(ret: IrType, args: Vec<i64>) -> bool {
    match ret {
        IrType::Struct(_) => {
            return args.len() > 0;
        }
        _ => {
        }
    }
    return false;
}

/// L6C: the C signature of a CallPtr's stub (ng_ldyn_sig's form), "" when
/// the stub cannot pass it in registers (Win64: at most four arguments).
fn ng_cfp_sig(g: &NatGen, func: &IrFunction, id: i64, args: Vec<i64>) -> str {
    if g.win && args.len() > 4 {
        return "";
    }
    return ng_ldyn_sig(func, id, args, 0 - 1);
}

/// L6C: the label of the stub for C signature `sig`, made on first use;
/// -1 for "" (the CallPtr calls word 0, as without C function pointers).
fn ng_cfp_stub_label(g: &mut NatGen, sig: str) -> i64 {
    if sig == "" {
        return 0 - 1;
    }
    var i: i64 = 0;
    while i < g_ng_cfp_sigs.len() {
        if g_ng_cfp_sigs.get(i) == sig {
            return g_ng_cfp_labels.get(i);
        }
        i = i + 1;
    }
    var l: i64 = NatEnc_label(&mut g.e);
    g_ng_cfp_sigs.push(sig);
    g_ng_cfp_labels.push(l);
    return l;
}
/// RA18: FID_NAT_OFF=fcallee, read once: 0 unread, 1 off, 2 on.
var g_ng_fcs_sw: i64 = 0;

/// RA18: callee-saved float registers are handed out in this build.
fn ng_fcs_on(g: &NatGen) -> bool {
    if g_ng_fcs_sw == 0 {
        g_ng_fcs_sw = 1;
        if ng_on("fcallee") {
            g_ng_fcs_sw = 2;
        }
    }
    if g_ng_fcs_sw != 2 || g_ng_fcs_block || g.win || ng_x64(g) {
        return false;
    }
    // RA18 (Nov 21): RISC-V's callee-saved float registers cost more than
    // they win: ra18_float_bench measured a program 1.07x the time of
    // spilling under qemu (AArch64: 0.89) — twelve d-registers to save and
    // restore in every prologue for the ranges that cross calls. Off on
    // RV64 until a cost model weighs it per function; FID_NAT_ON-style
    // opt-in does not exist for this switch, so the check is here.
    if g.arch == NAT_RV64 {
        return false;
    }
    return ng_fregs_on(g);
}

/// RA18: float register f (0..31) is callee-saved on this target.
fn ng_fcs_num(g: &NatGen, f: i64) -> bool {
    if ng_a64(g) {
        return f >= 8 && f <= 15;
    }
    if g.arch == NAT_RV64 {
        return f == 8 || f == 9 || (f >= 18 && f <= 27);
    }
    return false;
}

/// RA18: the callee-saved float registers the allocator may hand out (as
/// NG_FREG + f), in order of preference; empty when ng_fcs_on is false.
fn ng_float_callee_pool(g: &NatGen) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    if !ng_fcs_on(g) {
        return p;
    }
    var f: i64 = 0;
    while f < 32 && f < g.td.float_regs.len() {
        if ng_fcs_num(g, f) {
            p.push(NG_FREG + f);
        }
        f = f + 1;
    }
    return p;
}

/// RA18: `r` is a callee-saved float register the allocator may hand out.
fn ng_float_callee_has(g: &NatGen, r: i64) -> bool {
    if r < NG_FREG || r >= NG_FREG + 32 {
        return false;
    }
    return ng_fcs_num(g, r - NG_FREG) && ng_fcs_on(g);
}

/// RA18: the module can start a task: an IR call of p_co_go or p_co_async
/// (what `task_go`, `async` and the task module lower to), or of the
/// runtime functions that make a task (pert_co_go, pert_co_async_v,
/// pert_co_spawn_v, pe_co_new_block) from a function that is not itself
/// one of the scheduler's (pe_co_*, pert_co_*). Without one, no task ever
/// runs, so nat_ctx_swap never switches and the float registers it does
/// not keep are safe to keep across calls.
fn ng_fcs_tasks(m: &IrModule) -> bool {
    var fi: i64 = 0;
    while fi < m.functions.len() {
        var fname: str = m.functions.get(fi).name;
        var sched: bool = str_starts_with(fname, "pe_co_") || str_starts_with(fname, "pert_co_");
        var insts: Vec<ValueIdInst> = m.functions.get(fi).func.insts;
        var k: i64 = 0;
        while k < insts.len() {
            match insts.get(k).inst {
                Inst::Call(cn, _, _, _) => {
                    if cn == "p_co_go" || cn == "p_co_async" {
                        return true;
                    }
                    if !sched && (cn == "pert_co_go" || cn == "pert_co_async_v" || cn == "pert_co_spawn_v" || cn == "pe_co_new_block") {
                        return true;
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        fi = fi + 1;
    }
    return false;
}

/// RA18: callee-saved float register r (NG_FREG + f) to (store) or from
/// its save slot at sp + off: str / ldr d (stp pairs: ng_save_subset),
/// fsd / fld, the address through ad when the offset is out of reach.
fn ng_fsave_slot(g: &mut NatGen, store: bool, r: i64, off: i64) {
    var f: i64 = r - NG_FREG;
    if ng_x64(g) {
        ng_fmem(g, store, f, 4, off, false);
        return;
    }
    if ng_a64(g) {
        if a64_ldst_fits(8, off) {
            ng_fmem(g, store, f, A64_SP, off, false);
            return;
        }
    } else if rv_fits12(off) {
        ng_fmem(g, store, f, RV_SP, off, false);
        return;
    }
    ng_slot_addr(g, g.ad, off);
    ng_fmem(g, store, f, g.ad, 0, false);
}

/// MI25: `r` is an allocated float register (NG_FREG + f).
fn ng_is_freg(g: &NatGen, r: i64) -> bool {
    return r >= NG_FREG && r < NG_FREG + g.td.float_regs.len() && ng_fregs_on(g);
}

/// RA10: register `r` belongs to the allocatable pool of class `cls`.
fn ng_class_has(g: &NatGen, cls: i64, r: i64) -> bool {
    if r < 0 || r >= 64 {
        return false;
    }
    if cls != NG_RC_INT {
        if r < NG_FREG || !ng_fregs_on(g) {
            return false;
        }
        if ng_float_callee_has(g, r) {
            // RA18: a callee-saved float register
            return true;
        }
        var i: i64 = 0;
        while i < g.td.float_pool.len() {
            if g.td.float_pool.get(i) == r {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    // RA7: the argument registers a move ties a value to (ng_arg_hints;
    // none with FID_NAT_OFF=arghint)
    return ((g.td.int_caller_mask | g.td.int_callee_mask | ng_arg_cands(g)) & (1 << r)) != 0;
}

/// MI25: the float width field `f` of `m` reads or writes: 1 an f64, 2 an
/// f32, 0 when the field is not a float operand (FCMP's result, I2F's
/// integer source, F2I's integer result, and every other operation).
fn ng_float_slot(m: MInst, f: i64) -> i64 {
    var w: i64 = 1;
    if m.op == MO_FBIN || m.op == MO_FCMP {
        if m.i1 != 0 {
            w = 2;
        }
        if m.op == MO_FBIN || f > 0 {
            return w;
        }
        return 0;
    }
    if m.op == MO_I2F && f == 0 {
        if m.i0 != 0 {
            w = 2;
        }
        return w;
    }
    if m.op == MO_F2I && f == 1 {
        if m.i0 != 0 {
            w = 2;
        }
        return w;
    }
    if m.op == MO_F32BITS && f <= 1 {
        // i0 0: r0 (f32) = r1 (f64) narrowed; i0 1: r0 (f64) = r1 (f32)
        // widened
        if (f == 0) == (m.i0 == 0) {
            return 2;
        }
        return 1;
    }
    return 0;
}

/// Field `f` of `m` is a whole 64-bit integer of a conversion: F2I's
/// result (r0), I2F's source (r1). A value of an f32 class reaches an
/// operation on general registers through a 32-bit move (movd, fmov s, fmv
/// w), so such a field must not be in one. `fadd32(x, y) as i64` of -2
/// gave 4294967294: the selection's `f2i v, v` (one vreg, f32 source and
/// i64 result) made v an f32 class, and the result kept its low 32 bits.
fn ng_float_int64(m: MInst, f: i64) -> bool {
    return (m.op == MO_F2I && f == 0) || (m.op == MO_I2F && f == 1);
}

/// MI25: field `f` of `m` moves a value between memory or a vector lane
/// and a register of either class with no move between classes: a load's
/// result or a stored value of 8 or 4 bytes (movsd / movss, ldr / str d
/// or s, fld / fsd / flw / fsw when the register is a float one), the
/// value MO_VSPLAT broadcasts, the lane MO_VLANE reads. These fields
/// count for neither class (ng_mir_classes_c).
fn ng_float_neutral(m: MInst, f: i64) -> bool {
    if m.op == MO_LOAD && f == 0 {
        return m.i1 == 8 || m.i1 == 4;
    }
    if m.op == MO_STORE && f == 1 {
        return m.i1 == 8 || m.i1 == 4;
    }
    return (m.op == MO_VSPLAT && f == 1) || (m.op == MO_VLANE && f == 0);
}

/// MI25: field `f` of `m` takes the float register of a value of class
/// `cls` directly (ng_float_neutral, the access the width of the class:
/// 8 bytes or a 64-bit lane an f64, 4 bytes an f32).
fn ng_float_direct(m: MInst, f: i64, cls: i64) -> bool {
    if cls == NG_RC_INT || !ng_float_neutral(m, f) {
        return false;
    }
    if m.op == MO_LOAD || m.op == MO_STORE {
        return (cls == NG_RC_FLOAT && m.i1 == 8) || (cls == NG_RC_F32 && m.i1 == 4);
    }
    return cls == NG_RC_FLOAT;
}

/// RA10: the class of each vreg of `mir` (index vreg - NG_VBASE), each
/// vreg alone (see ng_mir_classes_c).
fn ng_mir_classes(g: &NatGen, mir: &Vec<MInst>, nv: i64) -> Vec<i64> {
    var ident: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        ident.push(i);
        i = i + 1;
    }
    return ng_mir_classes_c(g, mir, nv, &mut ident);
}

/// RA10 / MI25: the class of each vreg of `mir`, decided per copy class
/// (`crep`: the coalescing representatives, ng_find). A class is a float
/// class when its fields that are float operands (ng_float_slot) are at
/// least as many as its fields of other operations, copies (MO_MOV) not
/// counted: a copy between classes is one move either way (nor loads,
/// stores and lane moves, ng_float_neutral: either class does them in
/// one instruction). Its width is
/// f64 (NG_RC_FLOAT) or f32 (NG_RC_F32); one that is both, or a copy
/// between an f32 and an f64 class, stays an integer. Every other value
/// is an integer (NG_RC_INT), and so is every value while the float pool
/// is empty (td.float_class, the fregs switch).
fn ng_mir_classes_c(g: &NatGen, mir: &Vec<MInst>, nv: i64, crep: &mut Vec<i64>) -> Vec<i64> {
    var cls: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        cls.push(NG_RC_INT);
        i = i + 1;
    }
    if g.td.float_class == NG_RC_INT || !ng_fregs_on(g) {
        return cls;
    }
    var nfl: Vec<i64> = Vec::new();
    var nin: Vec<i64> = Vec::new();
    var wid: Vec<i64> = Vec::new();
    // classes holding a whole 64-bit integer at a conversion (F2I's
    // result, I2F's source): never an f32 class, whose moves between
    // classes keep 32 bits (ng_float_int64)
    var full: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        nfl.push(0);
        nin.push(0);
        wid.push(0);
        full.push(0);
        i = i + 1;
    }
    i = 0;
    while i < mir.len() {
        var m: MInst = mir.get(i);
        if m.op != MO_MOV {
            var um: i64 = mi_use_mask(m.op);
            var f: i64 = 0;
            while f < 3 {
                var v: i64 = mi_field(m, f) - NG_VBASE;
                var touched: bool = (um & (1 << f)) != 0 || (f == 0 && mi_defines(m.op));
                // (a load, store or lane move costs the same in either
                // class: ng_float_neutral)
                if touched && v >= 0 && v < nv && !ng_float_neutral(m, f) {
                    var rv: i64 = ng_find(crep, v);
                    var fw: i64 = ng_float_slot(m, f);
                    if fw == 0 {
                        nin.set(rv, nin.get(rv) + 1);
                        if ng_float_int64(m, f) {
                            full.set(rv, 1);
                        }
                    } else {
                        nfl.set(rv, nfl.get(rv) + 1);
                        wid.set(rv, wid.get(rv) | fw);
                    }
                }
                f = f + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < nv {
        if nfl.get(i) > 0 && nfl.get(i) >= nin.get(i) {
            if wid.get(i) == 1 {
                cls.set(i, NG_RC_FLOAT);
            }
            if wid.get(i) == 2 && full.get(i) == 0 {
                cls.set(i, NG_RC_F32);
            }
        }
        i = i + 1;
    }
    // a copy between an f32 class and an f64 class: both stay integers
    i = 0;
    while i < mir.len() {
        var c: MInst = mir.get(i);
        if c.op == MO_MOV {
            var a: i64 = c.r0 - NG_VBASE;
            var b: i64 = c.r1 - NG_VBASE;
            if a >= 0 && a < nv && b >= 0 && b < nv {
                var ra: i64 = ng_find(crep, a);
                var rb: i64 = ng_find(crep, b);
                if cls.get(ra) != NG_RC_INT && cls.get(rb) != NG_RC_INT && cls.get(ra) != cls.get(rb) {
                    cls.set(ra, NG_RC_INT);
                    cls.set(rb, NG_RC_INT);
                }
            }
        }
        i = i + 1;
    }
    // each member takes its class's
    i = 0;
    while i < nv {
        var ri: i64 = ng_find(crep, i);
        if ri != i {
            cls.set(i, cls.get(ri));
        }
        i = i + 1;
    }
    return cls;
}

fn ng_a64(g: &NatGen) -> bool {
    return g.arch == NAT_A64;
}

/// MI30: the one place that decides the code alignment of functions and
/// loop heads per target. Loop heads align wider on x64; elsewhere the
/// 4-byte instruction size is what the encoders already give. A loop head
/// is only aligned when an unconditional jump or a trap precedes it, so
/// the padding is never executed.
const NG_ALIGN_FN: i64 = 0;
const NG_ALIGN_LOOP: i64 = 1;
fn ng_code_align(g: &NatGen, kind: i64) -> i64 {
    if kind == NG_ALIGN_LOOP && ng_x64(g) && !g_nat_size {
        return 16;
    }
    return 4;
}

// ===========================================================================
// Architecture layer
// ===========================================================================

fn ng_li(g: &mut NatGen, r: i64, v: i64) {
    if g.rec {
        ng_rec(g, MO_LI, r, 0, 0, v, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_li(&mut g.e, r, v);
        return;
    }
    if ng_a64(g) {
        a64_li(&mut g.e, r, v);
    } else {
        rv_li(&mut g.e, r, v);
    }
}

fn ng_mov(g: &mut NatGen, d: i64, s: i64) {
    if g.rec {
        ng_rec(g, MO_MOV, d, s, 0, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        if d != s {
            x64_mov(&mut g.e, d, s);
        }
        return;
    }
    if ng_a64(g) {
        a64_mov(&mut g.e, d, s);
    } else {
        rv_mv(&mut g.e, d, s);
    }
}

/// The argument register `i` (0..7).
fn ng_argreg(g: &NatGen, i: i64) -> i64 {
    // MI4: the platform convention's registers of the target description
    if i >= 0 && i < g.td.nregargs {
        return g.td.argregs.get(i);
    }
    if g.arch == NAT_X64 {
        return 1;
    }
    return g.td.arg0 + i;
}

/// r = sp + off
fn ng_slot_addr(g: &mut NatGen, r: i64, off: i64) {
    if g.rec {
        ng_rec(g, MO_SLOTADDR, r, 0, 0, off, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_lea(&mut g.e, r, 4, off);
        return;
    }
    if ng_a64(g) {
        if off >= 0 && off < 4096 {
            a64_add_imm(&mut g.e, r, A64_SP, off);
        } else {
            a64_li(&mut g.e, r, off);
            a64_add_ext(&mut g.e, r, A64_SP, r);
        }
    } else {
        if rv_fits12(off) {
            rv_addi(&mut g.e, r, RV_SP, off);
        } else {
            rv_li(&mut g.e, r, off);
            rv_add(&mut g.e, r, RV_SP, r);
        }
    }
}

fn ng_ld_slot(g: &mut NatGen, r: i64, off: i64) {
    if g.rec {
        ng_rec(g, MO_LDSLOT, r, 0, 0, off, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_load(&mut g.e, r, 4, off, 8, true);
        return;
    }
    if ng_a64(g) {
        if a64_ldst_fits(8, off) {
            a64_ldr(&mut g.e, r, A64_SP, off);
        } else {
            ng_slot_addr(g, g.ad, off);
            a64_ldr(&mut g.e, r, g.ad, 0);
        }
    } else {
        if rv_fits12(off) {
            rv_load(&mut g.e, r, RV_SP, off, 8, true);
        } else {
            ng_slot_addr(g, g.ad, off);
            rv_load(&mut g.e, r, g.ad, 0, 8, true);
        }
    }
}

fn ng_st_slot(g: &mut NatGen, off: i64, r: i64) {
    if g.rec {
        ng_rec(g, MO_STSLOT, r, 0, 0, off, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_store(&mut g.e, r, 4, off, 8);
        return;
    }
    if ng_a64(g) {
        if a64_ldst_fits(8, off) {
            a64_str(&mut g.e, r, A64_SP, off);
        } else {
            ng_slot_addr(g, g.ad, off);
            a64_str(&mut g.e, r, g.ad, 0);
        }
    } else {
        if rv_fits12(off) {
            rv_store(&mut g.e, r, RV_SP, off, 8);
        } else {
            ng_slot_addr(g, g.ad, off);
            rv_store(&mut g.e, r, g.ad, 0, 8);
        }
    }
}

/// d = *(base + disp), `size` bytes (1, 2, 4, 8), extended
fn ng_load(g: &mut NatGen, d: i64, base: i64, disp: i64, size: i64, signed: bool) {
    if g.rec {
        var sg: i64 = 0;
        if signed {
            sg = 1;
        }
        ng_rec(g, MO_LOAD, d, base, 0, disp, size, sg);
        return;
    }
    if (size == 8 || size == 4) && ng_is_freg(g, d) {
        // MI25: straight into a float register (ng_float_direct)
        ng_fmem(g, false, d - NG_FREG, base, disp, size == 4);
        return;
    }
    if ng_x64(g) {
        x64_load(&mut g.e, d, base, disp, size, signed);
        return;
    }
    if ng_a64(g) {
        if a64_ldst_fits(size, disp) {
            a64_ldr_sized(&mut g.e, d, base, disp, size, signed);
        } else {
            a64_li(&mut g.e, g.ad2, disp);
            a64_add_base(&mut g.e, g.ad2, base, g.ad2);
            a64_ldr_sized(&mut g.e, d, g.ad2, 0, size, signed);
        }
    } else {
        if rv_fits12(disp) {
            rv_load(&mut g.e, d, base, disp, size, signed);
        } else {
            rv_li(&mut g.e, g.ad2, disp);
            rv_add(&mut g.e, g.ad2, base, g.ad2);
            rv_load(&mut g.e, d, g.ad2, 0, size, signed);
        }
    }
}

/// *(base + disp) = v, `size` bytes
fn ng_store(g: &mut NatGen, base: i64, disp: i64, v: i64, size: i64) {
    if g.rec {
        ng_rec(g, MO_STORE, base, v, 0, disp, size, 0);
        return;
    }
    if (size == 8 || size == 4) && ng_is_freg(g, v) {
        // MI25: straight from a float register (ng_float_direct)
        ng_fmem(g, true, v - NG_FREG, base, disp, size == 4);
        return;
    }
    if ng_x64(g) {
        x64_store(&mut g.e, v, base, disp, size);
        return;
    }
    if ng_a64(g) {
        if a64_ldst_fits(size, disp) {
            a64_str_sized(&mut g.e, v, base, disp, size);
        } else {
            a64_li(&mut g.e, g.ad2, disp);
            a64_add_base(&mut g.e, g.ad2, base, g.ad2);
            a64_str_sized(&mut g.e, v, g.ad2, 0, size);
        }
    } else {
        if rv_fits12(disp) {
            rv_store(&mut g.e, v, base, disp, size);
        } else {
            rv_li(&mut g.e, g.ad2, disp);
            rv_add(&mut g.e, g.ad2, base, g.ad2);
            rv_store(&mut g.e, v, g.ad2, 0, size);
        }
    }
}

/// MI25: float register f = *(base + disp) (store false) or *(base +
/// disp) = f (store true), an f32 (is32: 4 bytes, single) or an f64:
/// x86-64 movss / movsd (F3 / F2 [REX] 0F 10 / 11, the ModRM of x64_load),
/// AArch64 ldr / str s or d (unsigned scaled offset, else the address
/// through ad2 as ng_load does), RISC-V flw / fld / fsw / fsd (a 12-bit
/// offset, else through ad2).
fn ng_fmem(g: &mut NatGen, store: bool, f: i64, base: i64, disp: i64, is32: bool) {
    var size: i64 = 8;
    if is32 {
        size = 4;
    }
    if ng_x64(g) {
        if is32 {
            NatEnc_byte(&mut g.e, 0xF3);
        } else {
            NatEnc_byte(&mut g.e, 0xF2);
        }
        var rex: i64 = 0x40;
        if f >= 8 {
            rex = rex | 4;
        }
        if base >= 8 {
            rex = rex | 1;
        }
        if rex != 0x40 {
            NatEnc_byte(&mut g.e, rex);
        }
        NatEnc_byte(&mut g.e, 0x0F);
        if store {
            NatEnc_byte(&mut g.e, 0x11);
        } else {
            NatEnc_byte(&mut g.e, 0x10);
        }
        // ModRM (+ SIB for an rsp / r12 base, displacement) for [base + disp]
        var b: i64 = base & 7;
        var md: i64 = 2;
        if disp == 0 && b != 5 {
            md = 0;
        } else if disp >= 0 - 128 && disp <= 127 {
            md = 1;
        }
        NatEnc_byte(&mut g.e, (md << 6) | ((f & 7) << 3) | b);
        if b == 4 {
            NatEnc_byte(&mut g.e, 0x24);
        }
        if md == 1 {
            NatEnc_byte(&mut g.e, disp & 255);
        }
        if md == 2 {
            NatEnc_u32(&mut g.e, disp);
        }
        return;
    }
    var rb: i64 = base;
    var off: i64 = disp;
    if ng_a64(g) {
        if !a64_ldst_fits(size, disp) {
            a64_li(&mut g.e, g.ad2, disp);
            a64_add_base(&mut g.e, g.ad2, base, g.ad2);
            rb = g.ad2;
            off = 0;
        }
        // LDR / STR (SIMD&FP, unsigned offset): size 11 (d) or 10 (s)
        var op: i64 = 0xFD400000;
        if store {
            op = 0xFD000000;
        }
        if is32 {
            op = op - 0x40000000;
        }
        NatEnc_word(&mut g.e, op | ((off / size) << 10) | (rb << 5) | f);
        return;
    }
    if !rv_fits12(disp) {
        rv_li(&mut g.e, g.ad2, disp);
        rv_add(&mut g.e, g.ad2, base, g.ad2);
        rb = g.ad2;
        off = 0;
    }
    // FLD / FSD funct3 011, FLW / FSW 010
    var fn3: i64 = 3;
    if is32 {
        fn3 = 2;
    }
    if store {
        NatEnc_word(&mut g.e, (((off >> 5) & 0x7F) << 25) | (f << 20) | (rb << 15) | (fn3 << 12) | ((off & 0x1F) << 7) | 0x27);
    } else {
        NatEnc_word(&mut g.e, ((off & 0xFFF) << 20) | (rb << 15) | (fn3 << 12) | (f << 7) | 0x07);
    }
}

fn ng_addr(g: &mut NatGen, d: i64, label: i64) {
    if g.rec {
        ng_rec(g, MO_ADDR, d, 0, 0, label, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_lea_label(&mut g.e, d, label);
        return;
    }
    if ng_a64(g) {
        a64_addr(&mut g.e, d, label);
    } else {
        rv_addr(&mut g.e, d, label);
    }
}

fn ng_call_label(g: &mut NatGen, label: i64) {
    if g.rec {
        ng_rec(g, MO_CALL, 0, 0, 0, label, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_call(&mut g.e, label);
        return;
    }
    if ng_a64(g) {
        a64_bl(&mut g.e, label);
    } else if g.br_short {
        // TG6: the callee is placed and within +-1 MB
        rv_call_near(&mut g.e, label);
    } else {
        rv_call(&mut g.e, label);
    }
}

fn ng_call_reg(g: &mut NatGen, r: i64) {
    if g.rec {
        ng_rec(g, MO_CALLR, r, 0, 0, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_call_r(&mut g.e, r);
        return;
    }
    if ng_a64(g) {
        a64_blr(&mut g.e, r);
    } else {
        rv_jalr(&mut g.e, RV_RA, r, 0);
    }
}

/// A jump inside the function.
fn ng_jmp(g: &mut NatGen, label: i64) {
    if g.rec {
        ng_rec(g, MO_JMP, 0, 0, 0, label, 0, 0);
        return;
    }
    if ng_x64(g) {
        if g.br_short {
            x64_jmp_short(&mut g.e, label);
        } else {
            x64_jmp(&mut g.e, label);
        }
        return;
    }
    if ng_a64(g) {
        a64_b(&mut g.e, label);
    } else {
        rv_jal(&mut g.e, RV_ZERO, label);
    }
}

/// Jump inside the function when r != 0.
fn ng_bnez(g: &mut NatGen, r: i64, label: i64) {
    if g.rec {
        ng_rec(g, MO_BNEZ, r, 0, 0, label, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_test(&mut g.e, r, r);
        if g.br_short {
            x64_jcc_short(&mut g.e, X64_NE, label);
        } else {
            x64_jcc(&mut g.e, X64_NE, label);
        }
        return;
    }
    if ng_a64(g) {
        a64_cbnz(&mut g.e, r, label);
    } else if g.br_short {
        rv_b_label(&mut g.e, RV_BNE, r, RV_ZERO, label);
    } else {
        rv_b_off(&mut g.e, RV_BEQ, r, RV_ZERO, 8);
        rv_jal(&mut g.e, RV_ZERO, label);
    }
}

/// Jump inside the function when r == 0.
fn ng_beqz(g: &mut NatGen, r: i64, label: i64) {
    if g.rec {
        ng_rec(g, MO_BEQZ, r, 0, 0, label, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_test(&mut g.e, r, r);
        if g.br_short {
            x64_jcc_short(&mut g.e, X64_E, label);
        } else {
            x64_jcc(&mut g.e, X64_E, label);
        }
        return;
    }
    if ng_a64(g) {
        a64_cbz(&mut g.e, r, label);
    } else if g.br_short {
        rv_b_label(&mut g.e, RV_BEQ, r, RV_ZERO, label);
    } else {
        rv_b_off(&mut g.e, RV_BNE, r, RV_ZERO, 8);
        rv_jal(&mut g.e, RV_ZERO, label);
    }
}

/// The compare kind that holds exactly when `cc` does not.
fn ng_cc_inverse(cc: i64) -> i64 {
    if cc == NCC_EQ {
        return NCC_NE;
    }
    if cc == NCC_NE {
        return NCC_EQ;
    }
    if cc == NCC_LT {
        return NCC_GE;
    }
    if cc == NCC_GE {
        return NCC_LT;
    }
    if cc == NCC_LE {
        return NCC_GT;
    }
    if cc == NCC_GT {
        return NCC_LE;
    }
    if cc == NCC_LTU {
        return NCC_GEU;
    }
    if cc == NCC_GEU {
        return NCC_LTU;
    }
    if cc == NCC_LEU {
        return NCC_GTU;
    }
    return NCC_LEU;
}

/// AArch64's condition for compare kind `cc` (after CMP a, b).
fn ng_a64_cc(cc: i64) -> i64 {
    if cc == NCC_NE {
        return A64_NE;
    }
    if cc == NCC_LT {
        return A64_LT;
    }
    if cc == NCC_LE {
        return A64_LE;
    }
    if cc == NCC_GT {
        return A64_GT;
    }
    if cc == NCC_GE {
        return A64_GE;
    }
    if cc == NCC_LTU {
        return A64_LO;
    }
    if cc == NCC_LEU {
        return A64_LS;
    }
    if cc == NCC_GTU {
        return A64_HI;
    }
    if cc == NCC_GEU {
        return A64_HS;
    }
    return A64_EQ;
}

/// MI23: jump inside the function when (a cc b): one compare and one
/// conditional branch, where SETCC + BNEZ took three to five instructions.
/// b may be the zero register (g.zr; 60 on x86-64, which has none).
/// RISC-V branches over a JAL with the inverse condition, as ng_bnez does,
/// so the target may be anywhere in the function (+-1 MB).
fn ng_brcc(g: &mut NatGen, a: i64, b: i64, cc: i64, label: i64) {
    if g.rec {
        ng_rec(g, MO_BRCC, a, b, 0, label, cc, 0);
        return;
    }
    if ng_x64(g) {
        if b == 60 {
            x64_test(&mut g.e, a, a);
        } else {
            x64_alu(&mut g.e, 0x39, a, b);
        }
        if g.br_short {
            x64_jcc_short(&mut g.e, ng_x64_cc(cc), label);
        } else {
            x64_jcc(&mut g.e, ng_x64_cc(cc), label);
        }
        return;
    }
    if ng_a64(g) {
        if b == A64_ZR && cc == NCC_EQ {
            a64_cbz(&mut g.e, a, label);
        } else if b == A64_ZR && cc == NCC_NE {
            a64_cbnz(&mut g.e, a, label);
        } else {
            a64_cmp(&mut g.e, a, b);
            a64_bcond(&mut g.e, ng_a64_cc(cc), label);
        }
        return;
    }
    // RISC-V: B<inverse> x, y, +8 over JAL zero, label; TG6: one B<cc>
    // straight to the label when relaxation found it in reach.
    if g.br_short {
        if ng_rv_swaps(cc) {
            rv_b_label(&mut g.e, ng_rv_f3(cc), b, a, label);
        } else {
            rv_b_label(&mut g.e, ng_rv_f3(cc), a, b, label);
        }
        return;
    }
    var inv: i64 = ng_cc_inverse(cc);
    if ng_rv_swaps(inv) {
        rv_b_off(&mut g.e, ng_rv_f3(inv), b, a, 8);
    } else {
        rv_b_off(&mut g.e, ng_rv_f3(inv), a, b, 8);
    }
    rv_jal(&mut g.e, RV_ZERO, label);
}

/// TG8/TG7: jump inside the function when bit `bit` of r is set (clear 0)
/// or clear (clear 1). AArch64 one TBNZ / TBZ when relaxation found the
/// target within its +-32 KB (g.br_short), else the inverse over a B;
/// x86-64 TEST r8/r32, imm (bits 0..31) or BT r64, imm8 (32..63), then
/// jcc (rel8 when short); RISC-V the bit shifted to the sign of ad2 (bit
/// 63 tests r itself) and BLT / BGE against zero, over a JAL when long.
/// Where the lowering took LI, AND, compare and branch (three to five
/// instructions), this is one or two.
fn ng_tbnz(g: &mut NatGen, r: i64, bit: i64, clear: i64, label: i64) {
    if g.rec {
        ng_rec(g, MO_TBNZ, r, 0, 0, label, bit, clear);
        return;
    }
    if ng_x64(g) {
        x64_test_bit(&mut g.e, r, bit);
        var cc: i64 = x64_bit_cc(bit);
        if clear != 0 {
            cc = cc ^ 1;
        }
        if g.br_short {
            x64_jcc_short(&mut g.e, cc, label);
        } else {
            x64_jcc(&mut g.e, cc, label);
        }
        return;
    }
    if ng_a64(g) {
        if g.br_short {
            a64_tbz_label(&mut g.e, r, bit, clear == 0, label);
        } else {
            a64_tbz_words(&mut g.e, r, bit, clear != 0, 2);
            a64_b(&mut g.e, label);
        }
        return;
    }
    var src: i64 = r;
    if bit != 63 {
        rv_slli(&mut g.e, g.ad2, r, 63 - bit);
        src = g.ad2;
    }
    var f3: i64 = RV_BLT;
    var inv: i64 = RV_BGE;
    if clear != 0 {
        f3 = RV_BGE;
        inv = RV_BLT;
    }
    if g.br_short {
        rv_b_label(&mut g.e, f3, src, RV_ZERO, label);
        return;
    }
    rv_b_off(&mut g.e, inv, src, RV_ZERO, 8);
    rv_jal(&mut g.e, RV_ZERO, label);
}

/// The RISC-V branch (BEQ / BNE / BLT / BGE / BLTU / BGEU) that is taken
/// when (a cc b) — with the operands swapped when ng_rv_swaps(cc): GT, LE,
/// GTU and LEU are LT, GE, LTU and GEU of (b, a).
fn ng_rv_f3(cc: i64) -> i64 {
    if cc == NCC_NE {
        return RV_BNE;
    }
    if cc == NCC_LT || cc == NCC_GT {
        return RV_BLT;
    }
    if cc == NCC_GE || cc == NCC_LE {
        return RV_BGE;
    }
    if cc == NCC_LTU || cc == NCC_GTU {
        return RV_BLTU;
    }
    if cc == NCC_GEU || cc == NCC_LEU {
        return RV_BGEU;
    }
    return RV_BEQ;
}

fn ng_rv_swaps(cc: i64) -> bool {
    return cc == NCC_GT || cc == NCC_LE || cc == NCC_GTU || cc == NCC_LEU;
}

/// MI3/MI22: d = a + (b << sh), the address of element b of an array of
/// 2^sh-byte elements at a, chosen per target: AArch64 one ADD with a
/// shifted register, x86-64 one LEA with a scaled index (sh <= 3; else
/// the shift goes through r11, which never holds a value), RISC-V SLLI
/// into ad2 then ADD (ad2 never holds a value either).
fn ng_addshl(g: &mut NatGen, d: i64, a: i64, b: i64, sh: i64) {
    if g.rec {
        ng_rec(g, MO_ADDSHL, d, a, b, sh, 0, 0);
        return;
    }
    if ng_x64(g) {
        if sh <= 3 && b != 4 {
            x64_lea_idx(&mut g.e, d, a, b, sh);
        } else {
            x64_mov(&mut g.e, 11, b);
            x64_shift_imm(&mut g.e, 4, 11, sh);
            x64_lea_idx(&mut g.e, d, a, 11, 0);
        }
        return;
    }
    if ng_a64(g) {
        a64_add_lsl(&mut g.e, d, a, b, sh);
        return;
    }
    if sh == 0 {
        rv_add(&mut g.e, d, a, b);
        return;
    }
    if sh <= 3 && ng_rv_zb(g) {
        // TG9: Zba shNadd, one instruction
        rv_shadd(&mut g.e, d, a, b, sh);
        return;
    }
    rv_slli(&mut g.e, g.ad2, b, sh);
    rv_add(&mut g.e, d, a, g.ad2);
}

/// MI22: the access [base + (index << sh) + disp] of `size` bytes is one
/// instruction on this target: x86-64 through a SIB byte (sh 0..3, a
/// 32-bit displacement), AArch64 the register-offset form (no
/// displacement; sh 0, or log2(size) for the scaled form). RISC-V has no
/// indexed access.
fn ng_ldx_form_ok(g: &NatGen, sh: i64, disp: i64, size: i64) -> bool {
    if sh < 0 || sh > 3 {
        return false;
    }
    if size != 1 && size != 2 && size != 4 && size != 8 {
        return false;
    }
    if ng_x64(g) {
        return disp >= 0 - 2147483647 && disp <= 2147483647;
    }
    if ng_a64(g) {
        return disp == 0 && (sh == 0 || (1 << sh) == size);
    }
    return false;
}

/// The registers of an emitted indexed access can be encoded in its one
/// instruction: x86-64's SIB has no rsp index; AArch64's 31 would be sp
/// as the base and xzr as the index, where the ADD it replaces read xzr
/// for both.
fn ng_ldx_regs_ok(g: &NatGen, base: i64, idx: i64) -> bool {
    if ng_x64(g) {
        return idx != 4;
    }
    if ng_a64(g) {
        return base != 31 && idx != 31;
    }
    return false;
}

/// MI22: d = *(base + (idx << sh) + disp), `size` bytes, extended. One
/// instruction where ng_ldx_form_ok holds, else the address into g.ad (it
/// never holds a value) and an ordinary load: the same as the MO_ADDSHL
/// and MO_LOAD it replaces.
fn ng_ldx(g: &mut NatGen, d: i64, base: i64, idx: i64, sh: i64, disp: i64, size: i64, signed: bool) {
    if g.rec {
        var sg: i64 = sh << 1;
        if signed {
            sg = sg | 1;
        }
        ng_rec(g, MO_LDX, d, base, idx, disp, size, sg);
        return;
    }
    if ng_ldx_form_ok(g, sh, disp, size) && ng_ldx_regs_ok(g, base, idx) {
        if ng_x64(g) {
            x64_load_idx(&mut g.e, d, base, idx, sh, disp, size, signed);
        } else {
            a64_ldr_roff(&mut g.e, d, base, idx, size, signed, sh != 0);
        }
        return;
    }
    ng_addshl(g, g.ad, base, idx, sh);
    ng_load(g, d, g.ad, disp, size, signed);
}

/// MI22: *(base + (idx << sh) + disp) = v, `size` bytes (as ng_ldx).
fn ng_stx(g: &mut NatGen, base: i64, idx: i64, sh: i64, disp: i64, v: i64, size: i64) {
    if g.rec {
        ng_rec(g, MO_STX, base, v, idx, disp, size, sh << 1);
        return;
    }
    if ng_ldx_form_ok(g, sh, disp, size) && ng_ldx_regs_ok(g, base, idx) && (!ng_a64(g) || v != 31) {
        if ng_x64(g) {
            x64_store_idx(&mut g.e, v, base, idx, sh, disp, size);
        } else {
            a64_str_roff(&mut g.e, v, base, idx, size, sh != 0);
        }
        return;
    }
    ng_addshl(g, g.ad, base, idx, sh);
    ng_store(g, g.ad, disp, v, size);
}

/// k when n == 2^k (k >= 0), else -1.
/// TG9: RISC-V with Zba and Zbb (`--cpu rva22u64`, `rva23u64` or
/// `rv64gc_zba_zbb`); the default rv64gc has neither.
fn ng_rv_zb(g: &NatGen) -> bool {
    if g.arch != NAT_RV64 {
        return false;
    }
    return g_nat_cpu == "rva22u64" || g_nat_cpu == "rva23u64" || g_nat_cpu == "rv64gc_zba_zbb";
}

/// TG9/TG19: RVC, the 2-byte instructions of RV64C, for a Linux RISC-V
/// executable. On by default (TG19: rv64gc, the default --cpu, and every
/// other accepted name but `rv64g` has the C extension), and so under
/// `--size` and FID_NAT_ON=rvc; FID_NAT_OFF=rvc wins, and NG_RVC_DEFAULT
/// = false makes it opt-in again (TG9's rule). Never for `--cpu rv64g` (no
/// C extension), an object file (its relocations would need linker
/// relaxation), Windows or macOS.
const NG_RVC_DEFAULT: bool = true;
fn ng_rvc_wanted(g: &NatGen) -> bool {
    if g.arch != NAT_RV64 || g.win || g.mac || g_nat_object || !ng_on("rvc") {
        return false;
    }
    if g_nat_cpu == "rv64g" {
        return false;
    }
    return NG_RVC_DEFAULT || g_nat_size || ng_opt_in("rvc");
}

/// TG19: does the RVC pass report on stderr? Only when asked for: `--size`,
/// FID_NAT_ON=rvc or `--stats`; a default build compresses quietly (a
/// refusal leaves the code as it was, which is correct, only larger).
fn ng_rvc_verbose() -> bool {
    return g_nat_size || ng_opt_in("rvc") || g_nat_stats;
}

/// TG9: compress the code just laid out ([0, the code's end), nothing of
/// the data placed yet) with nat_enc.fd nat_rvc_compress, then move the
/// line rows and frame rows with it. [asm_lo, asm_hi): the asm! thunks,
/// copied as they are. One `[rvc]` line on stderr (when ng_rvc_verbose)
/// says what it did, or why it left the code as it was (then nothing has
/// changed). The variables'
/// code ranges (DB4 g_ng_dbg_vars, text by then) and code sizes (CE8
/// g_ng_dbg_size, for the frame table the data gets) move too.
fn ng_rvc_pass(g: &mut NatGen, asm_lo: i64, asm_hi: i64) {
    g_nat_rvc = false;
    if !ng_rvc_wanted(g) {
        return;
    }
    var starts: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < g.placed_fns.len() {
        starts.push(NatEnc_label_offset(&g.e, HashMap_get(g.fn_labels, g.placed_fns.get(i))));
        i = i + 1;
    }
    var end: i64 = NatEnc_pos(&g.e);
    var m: NatRvcMap = NatRvcMap_new();
    var why: str = nat_rvc_compress(&mut g.e, end, &starts, asm_lo, asm_hi, &mut m);
    if why != "" {
        if ng_rvc_verbose() {
            p_eprint_str("[rvc] not compressed: " + why + "\n");
        }
        return;
    }
    // line rows [offset, line, word]; frame rows [offset, offset or a
    // negative code, offset]
    i = 0;
    while i + 2 < g.lrows.len() {
        g.lrows.set(i, nat_rvc_pos(&m, g.lrows.get(i)));
        i = i + 3;
    }
    i = 0;
    while i + 2 < g.cfi_rows.len() {
        g.cfi_rows.set(i, nat_rvc_pos(&m, g.cfi_rows.get(i)));
        var c1: i64 = g.cfi_rows.get(i + 1);
        if c1 >= 0 {
            g.cfi_rows.set(i + 1, nat_rvc_pos(&m, c1));
        }
        g.cfi_rows.set(i + 2, nat_rvc_pos(&m, g.cfi_rows.get(i + 2)));
        i = i + 3;
    }
    // the variables' ranges and the functions' sizes, from each start
    i = 0;
    while i < g.placed_fns.len() {
        var fname: str = g.placed_fns.get(i);
        var fs: i64 = starts.get(i);
        if g_ng_dbg_vars != 0 && HashMap_contains(g_ng_dbg_vars, fname) {
            var txt: str = HashMap_get(g_ng_dbg_vars, fname);
            HashMap_insert(g_ng_dbg_vars, fname, ng_rvc_dbg_text(txt, fs, &m));
        }
        if g_ng_dbg_size != 0 && HashMap_contains(g_ng_dbg_size, fname) {
            var osize: i64 = HashMap_get(g_ng_dbg_size, fname);
            HashMap_insert(g_ng_dbg_size, fname, nat_rvc_pos(&m, fs + osize) - nat_rvc_pos(&m, fs));
        }
        i = i + 1;
    }
    if ng_rvc_verbose() {
        p_eprint_str("[rvc] " + int_to_str(m.n_short) + " of " + int_to_str(m.n_insn) + " instructions in 2 bytes: code " + int_to_str(end) + " -> " + int_to_str(m.new_end) + " bytes\n");
    }
}

/// TG9: offset `off` (text) from old function start `fs`, moved by `m`.
fn ng_rvc_rel(m: &NatRvcMap, fs: i64, off: str) -> str {
    var o: i64 = str_parse_int(off);
    return int_to_str(nat_rvc_pos(m, fs + o) - nat_rvc_pos(m, fs));
}

/// TG9: a function's resolved variables (g_ng_dbg_vars' text, nat_enc.fd
/// g_nat_dbg_vars) with its code offsets moved: a scope line's start and
/// end ("B", id, parent, start, end) and the ranges after "@" of each
/// place of a location ("r10@0:8,12:40", "f-24@0:8;r3@8:40").
fn ng_rvc_dbg_text(text: str, fs: i64, m: &NatRvcMap) -> str {
    var lines: Vec<str> = str_split(text, "\n");
    var out: Vec<str> = Vec::new();
    var li: i64 = 0;
    while li < lines.len() {
        var p: Vec<str> = str_split(lines.get(li), "\t");
        if p.len() >= 5 && p.get(0) == "B" {
            p.set(3, ng_rvc_rel(m, fs, p.get(3)));
            p.set(4, ng_rvc_rel(m, fs, p.get(4)));
        } else if p.len() >= 6 && str_contains(p.get(5), "@") {
            var places: Vec<str> = str_split(p.get(5), ";");
            var np: Vec<str> = Vec::new();
            var pi: i64 = 0;
            while pi < places.len() {
                var pl: str = places.get(pi);
                var at: i64 = str_find(pl, "@");
                if at < 0 {
                    np.push(pl);
                } else {
                    var rl: Vec<str> = str_split(str_slice(pl, at + 1, str_len(pl)), ",");
                    var nr: Vec<str> = Vec::new();
                    var ri: i64 = 0;
                    while ri < rl.len() {
                        var se: Vec<str> = str_split(rl.get(ri), ":");
                        if se.len() == 2 {
                            nr.push(ng_rvc_rel(m, fs, se.get(0)) + ":" + ng_rvc_rel(m, fs, se.get(1)));
                        } else {
                            nr.push(rl.get(ri));
                        }
                        ri = ri + 1;
                    }
                    np.push(str_slice(pl, 0, at + 1) + str_join(nr, ","));
                }
                pi = pi + 1;
            }
            p.set(5, str_join(np, ";"));
        }
        out.push(str_join(p, "\t"));
        li = li + 1;
    }
    return str_join(out, "\n");
}

/// MI3: the target-specific operations each target selects, one table
/// (instead of a test of g.arch and --cpu in each pass that picks one):
///   MO_ADDSHL  every target (AArch64 ADD lsl, x86-64 LEA, RISC-V
///              SLLI+ADD or Zba shNadd)
///   MO_ANDN    x86-64 with BMI1 (--cpu x86-64-v3|v4), AArch64 (BIC),
///              RISC-V with Zbb (--cpu rva22u64|rva23u64|rv64gc_zba_zbb)
///   MO_BLSR    x86-64 with BMI1 (kinds BLSR, BLSMSK, BLSI: TG7)
///   MO_MUL     AArch64: a MUL fuses with the ADD or SUB right after it
///              into MADD / MSUB when the product dies there (ng_a64_mac,
///              at emission, after allocation)
///   MO_CSEL    x86-64 (CMOV), AArch64 (CSEL), RISC-V with Zicond
///              (--cpu rva23u64): MI24's branch-free selects
fn ng_sel_has(g: &NatGen, op: i64) -> bool {
    if op == MO_ADDSHL {
        return true;
    }
    if op == MO_ANDN {
        return ng_x64_bmi1(g) || ng_a64(g) || ng_rv_zb(g);
    }
    if op == MO_BLSR {
        return ng_x64_bmi1(g);
    }
    if op == MO_MUL {
        return ng_a64(g);
    }
    if op == MO_LDX || op == MO_STX {
        // MI22: SIB operands, AArch64 register offsets (RISC-V: none)
        return ng_x64(g) || ng_a64(g);
    }
    if op == MO_CSEL {
        // MI24: CMOV, CSEL, Zicond; plain RISC-V has no select (its
        // MO_CSEL is a branch over one move, no better than the diamond)
        return ng_x64(g) || ng_a64(g) || ng_rv_zicond(g);
    }
    if op == MO_OPW {
        // TG9: RV64's ADDW / SUBW / MULW
        return g.arch == NAT_RV64;
    }
    if op == MO_ALUM {
        // OP18: ALU operations with a memory source (x86-64 only: AArch64
        // and RISC-V are load/store machines)
        return ng_x64(g);
    }
    if op == MO_BRCCM || op == MO_SETCCM || op == MO_ALUMST {
        // OP18: compares against memory, read-modify-write destinations
        return ng_x64(g);
    }
    return false;
}

/// TG9: d = sext32(a op b), op 0 add, 1 sub, 2 mul (MO_OPW). RISC-V one
/// ADDW / SUBW / MULW; elsewhere (never selected there) the operation and
/// the extension.
fn ng_opw(g: &mut NatGen, d: i64, a: i64, b: i64, op: i64) {
    if g.rec {
        ng_rec(g, MO_OPW, d, a, b, op, 0, 0);
        return;
    }
    if g.arch == NAT_RV64 {
        if op == 0 {
            rv_addw(&mut g.e, d, a, b);
        } else if op == 1 {
            rv_subw(&mut g.e, d, a, b);
        } else {
            rv_mulw(&mut g.e, d, a, b);
        }
        return;
    }
    if op == 0 {
        ng_add(g, d, a, b);
    } else if op == 1 {
        ng_sub(g, d, a, b);
    } else {
        ng_mul(g, d, a, b);
    }
    ng_ext(g, d, d, NEXT_SW);
}

/// OP20: BMI1 (ANDN, BLSR) comes with x86-64-v3; like BMI2 (TG7) only
/// under an explicit `--cpu x86-64-v3|v4`.
fn ng_x64_bmi1(g: &NatGen) -> bool {
    return ng_x64(g) && (g_nat_cpu == "x86-64-v3" || g_nat_cpu == "x86-64-v4");
}

/// MI3: d = ~s & o (MO_ANDN). Only selected where ng_sel_has says so; the
/// other forms keep it correct anywhere (r11 / ad2 never hold a value).
fn ng_andn(g: &mut NatGen, d: i64, s: i64, o: i64) {
    if g.rec {
        ng_rec(g, MO_ANDN, d, s, o, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        if ng_x64_bmi1(g) {
            x64_andn(&mut g.e, d, s, o);
            return;
        }
        x64_mov(&mut g.e, 11, s);
        x64_f7(&mut g.e, 2, 11);
        x64_alu(&mut g.e, 0x21, 11, o);
        x64_mov(&mut g.e, d, 11);
        return;
    }
    if ng_a64(g) {
        a64_bic(&mut g.e, d, o, s);
        return;
    }
    if ng_rv_zb(g) {
        rv_andn(&mut g.e, d, o, s);
        return;
    }
    rv_xori(&mut g.e, g.ad2, s, 0 - 1);
    rv_and(&mut g.e, d, g.ad2, o);
}

/// MI3: d = a & (a - 1) (MO_BLSR kind 0): x86-64 BMI1 one BLSR; else a - 1
/// as ~(-a) in r11 / ad2, then AND. TG7: kind 1 d = a ^ (a - 1) (BLSMSK,
/// else the same a - 1 and an XOR), kind 2 d = a & -a (BLSI, else -a and
/// an AND).
fn ng_blsr(g: &mut NatGen, d: i64, a: i64, kind: i64) {
    if g.rec {
        ng_rec(g, MO_BLSR, d, a, 0, kind, 0, 0);
        return;
    }
    if ng_x64(g) {
        if ng_x64_bmi1(g) {
            if kind == 1 {
                x64_blsmsk(&mut g.e, d, a);
            } else if kind == 2 {
                x64_blsi(&mut g.e, d, a);
            } else {
                x64_blsr(&mut g.e, d, a);
            }
            return;
        }
        x64_mov(&mut g.e, 11, a);
        x64_f7(&mut g.e, 3, 11);
        if kind != 2 {
            x64_f7(&mut g.e, 2, 11);
        }
        if d != a {
            x64_mov(&mut g.e, d, a);
        }
        if kind == 1 {
            x64_alu(&mut g.e, 0x31, d, 11);
        } else {
            x64_alu(&mut g.e, 0x21, d, 11);
        }
        return;
    }
    if ng_a64(g) {
        a64_neg(&mut g.e, g.ad2, a);
        if kind != 2 {
            a64_mvn(&mut g.e, g.ad2, g.ad2);
        }
        if kind == 1 {
            a64_eor(&mut g.e, d, a, g.ad2);
        } else {
            a64_and(&mut g.e, d, a, g.ad2);
        }
        return;
    }
    if kind == 2 {
        rv_sub(&mut g.e, g.ad2, RV_ZERO, a);
    } else {
        rv_addi(&mut g.e, g.ad2, a, 0 - 1);
    }
    if kind == 1 {
        rv_xor(&mut g.e, d, a, g.ad2);
    } else {
        rv_and(&mut g.e, d, a, g.ad2);
    }
}

/// MI24: RISC-V Zicond (czero.eqz / czero.nez) comes with RVA23; only
/// under an explicit `--cpu rva23u64`.
fn ng_rv_zicond(g: &NatGen) -> bool {
    return g.arch == NAT_RV64 && g_nat_cpu == "rva23u64";
}

/// MI24: d = (c != 0) ? t : d (MO_CSEL, inv 0), or d = (c == 0) ? t : d
/// (inv 1). d, c and t are three different registers when the allocation
/// is sound (d lives across the select, c and t are read by it); d == t
/// would keep d, which is what it means. x86-64 TEST + CMOVNE / CMOVE;
/// AArch64 CMP c, xzr + CSEL ne / eq; RISC-V Zicond: ad2 = t or 0, d = d
/// or 0 (czero.eqz / czero.nez, swapped for inv), d |= ad2; plain RISC-V:
/// BEQZ / BNEZ c over one MV (the branch skips a fixed 4 bytes: no label,
/// no relaxation).
fn ng_csel(g: &mut NatGen, d: i64, c: i64, t: i64, inv: i64) {
    if g.rec {
        ng_rec(g, MO_CSEL, d, c, t, inv, 0, 0);
        return;
    }
    if d == t {
        return;
    }
    if ng_x64(g) {
        x64_test(&mut g.e, c, c);
        if inv != 0 {
            x64_cmov(&mut g.e, X64_E, d, t);
        } else {
            x64_cmov(&mut g.e, X64_NE, d, t);
        }
        return;
    }
    if ng_a64(g) {
        a64_cmp(&mut g.e, c, A64_ZR);
        if inv != 0 {
            a64_csel(&mut g.e, d, t, d, A64_EQ);
        } else {
            a64_csel(&mut g.e, d, t, d, A64_NE);
        }
        return;
    }
    if ng_rv_zicond(g) {
        if inv != 0 {
            rv_czero_nez(&mut g.e, g.ad2, t, c);
            rv_czero_eqz(&mut g.e, d, d, c);
        } else {
            rv_czero_eqz(&mut g.e, g.ad2, t, c);
            rv_czero_nez(&mut g.e, d, d, c);
        }
        rv_or(&mut g.e, d, d, g.ad2);
        return;
    }
    if inv != 0 {
        rv_b_off(&mut g.e, RV_BNE, c, RV_ZERO, 8);
    } else {
        rv_b_off(&mut g.e, RV_BEQ, c, RV_ZERO, 8);
    }
    rv_addi(&mut g.e, d, t, 0);
}

/// MI3/TG8: on AArch64, the ADD (sub false: d = a + b) or SUB (sub true:
/// d = a - b) being emitted fuses with the MUL emitted right before it
/// into one MADD / MSUB when that MUL wrote d itself and one operand of
/// this one is d: the product then dies here (the allocator gave the
/// result its register), so nothing else reads it. No label, line row or
/// fixup may sit between them (NatEnc.mul_end is where ng_mul's MUL ended;
/// any other emission moves the position past it). True when fused.
/// `FID_NAT_OFF=madd`: never.
fn ng_a64_mac(g: &mut NatGen, d: i64, a: i64, b: i64, sub: bool) -> bool {
    var pos: i64 = NatEnc_pos(&g.e);
    if g.e.mul_end != pos || pos < 4 || g.e.last_place >= pos || d == A64_ZR {
        return false;
    }
    var nr: i64 = g.lrows.len();
    if nr >= 3 && g.lrows.get(nr - 3) >= pos {
        return false;
    }
    var nf: i64 = g.e.fixups.len();
    if nf > 0 && g.e.fixups.get(nf - 1).pos >= pos - 4 {
        return false;
    }
    var at: i64 = pos - 4;
    var w: i64 = g.e.code.get(at) | (g.e.code.get(at + 1) << 8) | (g.e.code.get(at + 2) << 16) | (g.e.code.get(at + 3) << 24);
    if (w & 0xFFE0FC00) != 0x9B007C00 {
        return false;
    }
    var t: i64 = w & 31;
    var n: i64 = (w >> 5) & 31;
    var m: i64 = (w >> 16) & 31;
    if t != d || !ng_on("madd") {
        return false;
    }
    var addend: i64 = 0 - 1;
    if sub {
        // d = a - t*.. is MSUB; t*.. - b is not one instruction
        if b == t && a != t {
            addend = a;
        }
    } else if a == t && b != t {
        addend = b;
    } else if b == t && a != t {
        addend = a;
    }
    if addend < 0 {
        return false;
    }
    g.e.code.truncate(at);
    g.e.mul_end = 0 - 1;
    if sub {
        a64_msub(&mut g.e, d, n, m, addend);
    } else {
        a64_madd(&mut g.e, d, n, m, addend);
    }
    return true;
}

fn ng_log2_exact(n: i64) -> i64 {
    if n <= 0 {
        return 0 - 1;
    }
    var k: i64 = 0;
    var v: i64 = 1;
    while v < n && k < 62 {
        v = v * 2;
        k = k + 1;
    }
    if v == n {
        return k;
    }
    return 0 - 1;
}

/// Panic `which` when r != 0 (the stubs may be anywhere in the image).
fn ng_panic_if(g: &mut NatGen, r: i64, which: i64) {
    if g.rec {
        // WP11: a check is never dropped on the annotation's word. In a
        // @crashfree function the checks that survive the MIR folds are
        // verified after them (ng_crashfree_check): an overflow check left
        // there rejects the build, so @crashfree code has no overflow
        // panic paths; a division check whose divisor the type checker
        // proved non-zero but no fold could stays.
        ng_rec(g, MO_PANICIF, r, 0, 0, which, g.cur_inst_line, 0);
        return;
    }
    var label: i64 = ng_panic_label(g, which);
    if ng_x64(g) {
        x64_test(&mut g.e, r, r);
        x64_jcc8(&mut g.e, X64_E, 5);
        x64_call(&mut g.e, label);
        return;
    }
    if ng_a64(g) {
        // CBZ r, +8; BL panic (a call: the return address names the
        // function in a panic trace)
        NatEnc_word(&mut g.e, 0xB4000000 | (2 << 5) | r);
        a64_bl(&mut g.e, label);
    } else {
        rv_b_off(&mut g.e, RV_BEQ, r, RV_ZERO, 12);
        rv_call(&mut g.e, label);
    }
}

fn ng_trap(g: &mut NatGen) {
    if g.rec {
        ng_rec(g, MO_TRAP, 0, 0, 0, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_ud2(&mut g.e);
        return;
    }
    if ng_a64(g) {
        a64_brk(&mut g.e);
    } else {
        rv_ebreak(&mut g.e);
    }
}

fn ng_add(g: &mut NatGen, d: i64, a: i64, b: i64) {
    if g.rec {
        ng_rec(g, MO_ADD, d, a, b, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        ng_x64_bin(g, 1, d, a, b);
        return;
    }
    if ng_a64(g) {
        if ng_a64_mac(g, d, a, b, false) {
            return;
        }
        a64_add(&mut g.e, d, a, b);
    } else {
        rv_add(&mut g.e, d, a, b);
    }
}

/// RA6: c fits the immediate of the target's add (MO_ADDI): x86-64 a
/// sign-extended 32-bit immediate, AArch64 12 bits unsigned (ADD, or SUB
/// for a negative c), RISC-V ADDI's 12 bits signed.
fn ng_addi_fits(g: &NatGen, c: i64) -> bool {
    if ng_x64(g) {
        return c >= 0 - 2147483647 && c <= 2147483647;
    }
    if ng_a64(g) {
        return c > 0 - 4096 && c < 4096;
    }
    return c >= 0 - 2048 && c <= 2047;
}

/// RA6: d = a + c (MO_ADDI, c as ng_addi_fits allows): one instruction on
/// every target. x86-64: ADD r, imm when d is a (the counter step once
/// coalesced), else LEA d, [a + c] (flags are never read after an add).
fn ng_addi(g: &mut NatGen, d: i64, a: i64, c: i64) {
    if g.rec {
        ng_rec(g, MO_ADDI, d, a, 0, c, 0, 0);
        return;
    }
    if ng_x64(g) {
        if d == a {
            if c != 0 {
                x64_add_imm(&mut g.e, d, c);
            }
        } else {
            x64_lea(&mut g.e, d, a, c);
        }
        return;
    }
    if ng_a64(g) {
        if c >= 0 {
            a64_add_imm(&mut g.e, d, a, c);
        } else {
            a64_sub_imm(&mut g.e, d, a, 0 - c);
        }
        return;
    }
    rv_addi(&mut g.e, d, a, c);
}

/// RA6: the constant vreg x holds where the operation at k reads it, when
/// that is known: its value comes (through vreg copies in the same
/// stretch, ng_fb_root) from an LI, or x (or the copy chain's root) has
/// one definition in the whole function and that is an LI (`ndef`, `dpos`:
/// definitions per vreg index and the last one's position). [1, value]
/// or [0, 0].
fn ng_fa_const_at(mir: &Vec<MInst>, k: i64, x: i64, ndef: &Vec<i64>, dpos: &Vec<i64>, nv: i64) -> Vec<i64> {
    var res: Vec<i64> = Vec::new();
    var rt: Vec<i64> = ng_fb_root(mir, k, x);
    var root: i64 = rt.get(0);
    if root >= 0 && rt.get(1) >= 0 {
        var m: MInst = mir.get(rt.get(1));
        if m.op == MO_LI {
            res.push(1);
            res.push(m.i0);
            return res;
        }
    }
    if root >= NG_VBASE && root - NG_VBASE < nv && ndef.get(root - NG_VBASE) == 1 {
        var m2: MInst = mir.get(dpos.get(root - NG_VBASE));
        if m2.op == MO_LI {
            res.push(1);
            res.push(m2.i0);
            return res;
        }
    }
    res.push(0);
    res.push(0);
    return res;
}

/// RA6: ADD d, a, x (either order) and SUB d, a, x where x holds a constant
/// c (ng_fa_const_at) that fits the target's add immediate
/// (ng_addi_fits) become ADDI d, a, c (SUB: -c); d and a are vregs. The
/// LIs and vreg MOVs left without a reader go (only those that fed a
/// rewritten operation; never `keep`, the hidden result pointer). Runs
/// after ng_fuse_addr, which folds an ADD of a constant that feeds an
/// access into the access's displacement. Returns the number rewritten.
/// `FID_NAT_OFF=addi`: none.
/// TG1: likewise SHL / SAR / SHR d, a, x where x holds a constant c become
/// SHI d, a, c & 63 (the register forms take the count mod 64 too): one
/// instruction where an LI of the count came first (and, on x86-64 without
/// BMI2, a move into CL). Runs after ng_fuse_addr and ng_fuse_tbz, which
/// look for the shift by a constant itself. `FID_NAT_OFF=shi`: none;
/// FID_NAT_MUTATE=shi shifts by one more (TG2).
fn ng_fuse_addi(g: &NatGen, mir: &mut Vec<MInst>, nvreg: i64, keep: i64) -> i64 {
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    var addi_on: bool = ng_on("addi");
    var shi_on: bool = ng_on("shi");
    if (!addi_on && !shi_on) || nv <= 0 || n == 0 {
        return 0;
    }
    var shi_mut: bool = ng_mutant("shi");
    var ndef: Vec<i64> = Vec::new();
    var dpos: Vec<i64> = Vec::new();
    var touched: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        ndef.push(0);
        dpos.push(0 - 1);
        touched.push(0);
        i = i + 1;
    }
    var k: i64 = 0;
    while k < n {
        var dm: MInst = mir.get(k);
        if dm.op >= 0 && mi_defines(dm.op) && dm.r0 >= NG_VBASE && dm.r0 < nvreg {
            ndef.set(dm.r0 - NG_VBASE, ndef.get(dm.r0 - NG_VBASE) + 1);
            dpos.set(dm.r0 - NG_VBASE, k);
        }
        k = k + 1;
    }
    var made: i64 = 0;
    k = 0;
    while k < n {
        var m: MInst = mir.get(k);
        if shi_on && (m.op == MO_SHL || m.op == MO_SAR || m.op == MO_SHR) && m.r0 >= NG_VBASE && m.r0 < nvreg && m.r1 >= NG_VBASE && m.r1 < nvreg && m.r2 >= NG_VBASE && m.r2 < nvreg {
            var sc: Vec<i64> = ng_fa_const_at(mir, k, m.r2, &ndef, &dpos, nv);
            if sc.get(0) == 1 {
                touched.set(m.r2 - NG_VBASE, 1);
                var cnt: i64 = sc.get(1) & 63;
                if shi_mut {
                    cnt = (cnt + 1) & 63;
                }
                var skind: i64 = 0;
                if m.op == MO_SAR {
                    skind = 1;
                }
                if m.op == MO_SHR {
                    skind = 2;
                }
                mir.set(k, MInst {
                    op: MO_SHI, r0: m.r0, r1: m.r1, r2: 0, i0: cnt, i1: skind, i2: 0
                });
                made = made + 1;
            }
        }
        if addi_on && (m.op == MO_ADD || m.op == MO_SUB) && m.r0 >= NG_VBASE && m.r0 < nvreg && m.r1 >= NG_VBASE && m.r1 < nvreg && m.r2 >= NG_VBASE && m.r2 < nvreg {
            var a: i64 = 0 - 1;
            var c: i64 = 0;
            var x: i64 = 0 - 1;
            var c2: Vec<i64> = ng_fa_const_at(mir, k, m.r2, &ndef, &dpos, nv);
            if c2.get(0) == 1 {
                a = m.r1;
                x = m.r2;
                c = c2.get(1);
                if m.op == MO_SUB {
                    // (no negation of a constant far outside every
                    // immediate: -c could overflow)
                    if c >= 0 - 4294967296 && c <= 4294967296 {
                        c = 0 - c;
                    } else {
                        a = 0 - 1;
                    }
                }
            } else if m.op == MO_ADD {
                var c1: Vec<i64> = ng_fa_const_at(mir, k, m.r1, &ndef, &dpos, nv);
                if c1.get(0) == 1 {
                    a = m.r2;
                    x = m.r1;
                    c = c1.get(1);
                }
            }
            if a >= 0 && ng_addi_fits(g, c) {
                touched.set(x - NG_VBASE, 1);
                if ng_mutant("addi") && ng_addi_fits(g, c + 1) {
                    // TG2: the wrong constant, on purpose
                    c = c + 1;
                }
                mir.set(k, MInst {
                    op: MO_ADDI, r0: m.r0, r1: a, r2: 0, i0: c, i1: 0, i2: 0
                });
                made = made + 1;
            }
        }
        k = k + 1;
    }
    if made == 0 {
        return 0;
    }
    // Copies and constants nothing reads any more (they fed what changed)
    var again: bool = true;
    var rounds: i64 = 0;
    while again && rounds < 8 {
        again = false;
        var uses: Vec<i64> = ng_fb_uses(mir, nv);
        var q: i64 = 0;
        while q < n {
            var mq: MInst = mir.get(q);
            if (mq.op == MO_MOV || mq.op == MO_LI) && mq.r0 >= NG_VBASE && mq.r0 < nvreg && mq.r0 != keep {
                var vi: i64 = mq.r0 - NG_VBASE;
                if touched.get(vi) != 0 && uses.get(vi) == 0 {
                    ng_fb_touch(&mut touched, mq, nv);
                    mir.set(q, mi_nop());
                    again = true;
                }
            }
            q = q + 1;
        }
        rounds = rounds + 1;
    }
    var out: Vec<MInst> = Vec::new();
    var t: i64 = 0;
    while t < mir.len() {
        if mir.get(t).op >= 0 {
            out.push(mir.get(t));
        }
        t = t + 1;
    }
    mir.clear();
    t = 0;
    while t < out.len() {
        mir.push(out.get(t));
        t = t + 1;
    }
    return made;
}

/// TG8: v is a register field `q` reads or writes.
fn ng_mi_names(q: MInst, v: i64) -> bool {
    var um: i64 = mi_use_mask(q.op);
    var f: i64 = 0;
    while f < 3 {
        if ((um & (1 << f)) != 0 || (f == 0 && mi_defines(q.op))) && mi_field(q, f) == v {
            return true;
        }
        f = f + 1;
    }
    return false;
}

/// TG8: the operation at j is a load or store of 1, 2, 4 or 8 bytes
/// through base p (or a vreg holding p's value where the step at k reads
/// p: ng_fb_same) at offset 0 or c, whose loaded value is neither p nor
/// p2: what ng_a64_wb_fuse can make one access with writeback of, once the
/// step `p2 = p + c` comes right after it.
fn ng_wb_access_at(mir: &Vec<MInst>, j: i64, k: i64, p: i64, p2: i64, c: i64) -> bool {
    var q: MInst = mir.get(j);
    var base: i64 = 0 - 1;
    if q.op == MO_LOAD {
        if q.r0 == p || q.r0 == p2 {
            return false;
        }
        base = q.r1;
    } else if q.op == MO_STORE {
        base = q.r0;
    } else {
        return false;
    }
    if q.i1 != 1 && q.i1 != 2 && q.i1 != 4 && q.i1 != 8 {
        return false;
    }
    if q.i0 != 0 && q.i0 != c {
        return false;
    }
    if base == p {
        return true;
    }
    return base >= NG_VBASE && ng_fb_same(mir, j, base, k, p);
}

/// TG8 (AArch64, the MIR before allocation): a pointer's step `ADDI p2,
/// p, c` (c 9 bits signed, not 0) moves up to right after the load or store
/// that goes through p at offset 0 or c (ng_wb_access_at), over the
/// operations between, when none of them names p or p2 and they are one
/// straight stretch (no label, branch or call; line rows are passed). The
/// values are the same: only p2's definition comes earlier, and nothing
/// between read or wrote it. The pair is then adjacent at emission, where
/// ng_a64_wb_fuse makes it one access with writeback once the allocator
/// has given p and p2 one register (they no longer overlap when nothing
/// reads p after the step). The lowering's two-address step `MOV p2, q;
/// ADDI p2, p2, c` (only line rows between) is the step p2 = q + c: it
/// moves as the one operation `ADDI p2, q, c` (the MOV's value was read by
/// the ADDI alone). Not for p2 = `keep` (read without being named).
/// Returns the number of steps moved. `FID_NAT_OFF=wbidx`: none.
fn ng_wb_pair(g: &NatGen, mir: &mut Vec<MInst>, nvreg: i64, keep: i64) -> i64 {
    if !ng_a64(g) || !ng_on("wbidx") {
        return 0;
    }
    var n: i64 = mir.len();
    var moved: i64 = 0;
    var dropped: bool = false;
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        if m.op == MO_ADDI && m.r0 >= NG_VBASE && m.r0 < nvreg && m.r1 >= NG_VBASE && m.r1 < nvreg && m.r0 != keep && m.i0 != 0 && a64_wb_fits(m.i0) {
            var p: i64 = m.r1;
            var p2: i64 = m.r0;
            // where the step starts: its MOV when it is in two-address form
            var start: i64 = k;
            if p == p2 {
                var b: i64 = k - 1;
                while b >= 0 && (mir.get(b).op < 0 || mir.get(b).op == MO_LINE) {
                    b = b - 1;
                }
                if b >= 0 {
                    var mb: MInst = mir.get(b);
                    if mb.op == MO_MOV && mb.r0 == p2 && mb.r1 >= NG_VBASE && mb.r1 < nvreg && mb.r1 != p2 {
                        p = mb.r1;
                        start = b;
                    }
                }
            }
            var j: i64 = start - 1;
            var at: i64 = 0 - 1;
            var stop: bool = false;
            while j >= 0 && !stop && at < 0 {
                var q: MInst = mir.get(j);
                if q.op < 0 || q.op == MO_LINE {
                    j = j - 1;
                } else if ng_wb_access_at(mir, j, k, p, p2, m.i0) {
                    at = j;
                } else if ng_fb_stop(q.op) || ng_mi_names(q, p) || ng_mi_names(q, p2) {
                    stop = true;
                } else {
                    j = j - 1;
                }
            }
            if at >= 0 && at + 1 < start {
                var step: MInst = MInst {
                    op: MO_ADDI, r0: p2, r1: p, r2: 0, i0: m.i0, i1: m.i1, i2: m.i2
                };
                if start < k {
                    mir.set(start, mi_nop());
                    dropped = true;
                }
                var i: i64 = k;
                while i > at + 1 {
                    mir.set(i, mir.get(i - 1));
                    i = i - 1;
                }
                mir.set(at + 1, step);
                moved = moved + 1;
            }
        }
        k = k + 1;
    }
    if dropped {
        var out: Vec<MInst> = Vec::new();
        var t: i64 = 0;
        while t < mir.len() {
            if mir.get(t).op >= 0 {
                out.push(mir.get(t));
            }
            t = t + 1;
        }
        mir.clear();
        t = 0;
        while t < out.len() {
            mir.push(out.get(t));
            t = t + 1;
        }
    }
    return moved;
}

fn ng_sub(g: &mut NatGen, d: i64, a: i64, b: i64) {
    if g.rec {
        ng_rec(g, MO_SUB, d, a, b, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        ng_x64_bin(g, 2, d, a, b);
        return;
    }
    if ng_a64(g) {
        if ng_a64_mac(g, d, a, b, true) {
            return;
        }
        a64_sub(&mut g.e, d, a, b);
    } else {
        rv_sub(&mut g.e, d, a, b);
    }
}

fn ng_mul(g: &mut NatGen, d: i64, a: i64, b: i64) {
    if g.rec {
        ng_rec(g, MO_MUL, d, a, b, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        ng_x64_bin(g, 3, d, a, b);
        return;
    }
    if ng_a64(g) {
        a64_mul(&mut g.e, d, a, b);
        g.e.mul_end = NatEnc_pos(&g.e);
    } else {
        rv_mul(&mut g.e, d, a, b);
    }
}

fn ng_and(g: &mut NatGen, d: i64, a: i64, b: i64) {
    if g.rec {
        ng_rec(g, MO_AND, d, a, b, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        ng_x64_bin(g, 4, d, a, b);
        return;
    }
    if ng_a64(g) {
        a64_and(&mut g.e, d, a, b);
    } else {
        rv_and(&mut g.e, d, a, b);
    }
}

fn ng_or(g: &mut NatGen, d: i64, a: i64, b: i64) {
    if g.rec {
        ng_rec(g, MO_OR, d, a, b, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        ng_x64_bin(g, 5, d, a, b);
        return;
    }
    if ng_a64(g) {
        a64_orr(&mut g.e, d, a, b);
    } else {
        rv_or(&mut g.e, d, a, b);
    }
}

fn ng_xor(g: &mut NatGen, d: i64, a: i64, b: i64) {
    if g.rec {
        ng_rec(g, MO_XOR, d, a, b, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        ng_x64_bin(g, 6, d, a, b);
        return;
    }
    if ng_a64(g) {
        a64_eor(&mut g.e, d, a, b);
    } else {
        rv_xor(&mut g.e, d, a, b);
    }
}

fn ng_shl(g: &mut NatGen, d: i64, a: i64, b: i64) {
    if g.rec {
        ng_rec(g, MO_SHL, d, a, b, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        ng_x64_bin(g, 7, d, a, b);
        return;
    }
    if ng_a64(g) {
        a64_lslv(&mut g.e, d, a, b);
    } else {
        rv_sll(&mut g.e, d, a, b);
    }
}

fn ng_sar(g: &mut NatGen, d: i64, a: i64, b: i64) {
    if g.rec {
        ng_rec(g, MO_SAR, d, a, b, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        ng_x64_bin(g, 8, d, a, b);
        return;
    }
    if ng_a64(g) {
        a64_asrv(&mut g.e, d, a, b);
    } else {
        rv_sra(&mut g.e, d, a, b);
    }
}

fn ng_shr(g: &mut NatGen, d: i64, a: i64, b: i64) {
    if g.rec {
        ng_rec(g, MO_SHR, d, a, b, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        ng_x64_bin(g, 9, d, a, b);
        return;
    }
    if ng_a64(g) {
        a64_lsrv(&mut g.e, d, a, b);
    } else {
        rv_srl(&mut g.e, d, a, b);
    }
}

/// TG1: d = a shifted by the constant c (0..63; MO_SHI), kind 0 shl, 1
/// sar, 2 shr: one instruction where the register form took an LI of the
/// count first (and on x86-64 without BMI2 a move into CL). Formed by
/// ng_fuse_addi from a shift whose count is a known constant. The
/// hand-written selection (FID_NAT_OFF=isel); the table's rules are
/// NG_IF_X64_SHI, NG_IF_A64_SHI, NG_IF_RV_SHI.
fn ng_shi(g: &mut NatGen, d: i64, a: i64, c: i64, kind: i64) {
    if g.rec {
        ng_rec(g, MO_SHI, d, a, 0, c, kind, 0);
        return;
    }
    var s: i64 = c & 63;
    if ng_x64(g) {
        if d != a {
            x64_mov(&mut g.e, d, a);
        }
        if s != 0 {
            if kind == 0 {
                x64_shift_imm(&mut g.e, 4, d, s);
            } else if kind == 1 {
                x64_shift_imm(&mut g.e, 7, d, s);
            } else {
                x64_shift_imm(&mut g.e, 5, d, s);
            }
        }
        return;
    }
    if ng_a64(g) {
        a64_shift_imm(&mut g.e, kind, d, a, s);
        return;
    }
    if kind == 0 {
        rv_slli(&mut g.e, d, a, s);
    } else if kind == 1 {
        rv_srai(&mut g.e, d, a, s);
    } else {
        rv_srli(&mut g.e, d, a, s);
    }
}

// ── TG1: instruction selection as rules ────────────────────────────────
// The integer ALU operations of the machine IR (MO_ADD, MO_ADDI, MO_SUB,
// MO_MUL, MO_AND, MO_OR, MO_XOR, MO_SHL, MO_SAR, MO_SHR) are selected from
// a table, not from the hand-written branches of ng_add..ng_shr: each rule
// is a row [arch, op, form, cost, pre, arg]. For an operation the rules of
// its (arch, op) are tried cheapest first (stable: equal costs in table
// order); a rule applies when its precondition `pre` holds, and its `form`
// names the target instruction (arg: the form's own operand, x86-64's ALU
// kind). A form that can decline (NG_IF_A64_MADD: the multiply before it
// must be the one it folds) is tried the same way, the next rule taken
// when it declines. The table is data in Fides (ng_isel_rows), built once.
// FID_NAT_OFF=isel: the hand-written selection. nat_sel_check compares
// the two byte for byte on every case of nat_sel_cases (FID_VERIFY=1).
//
// Beyond the ALU (TG1, Nov 16): constants (MO_LI, by the class of the
// immediate), shifts by a constant (MO_SHI, formed by ng_fuse_addi from
// a shift whose count is an LI), element addresses (MO_ADDSHL),
// compares (MO_SETCC by condition, MO_BRCC against the zero register or
// a register, short or long), loads and stores with their addressing
// modes (MO_LOAD / MO_STORE: a float register, base + displacement when
// the displacement fits the target's immediate, else through ad2;
// MO_LDX / MO_STX: base + scaled index when the target has the form,
// else ADDSHL then the access), and the float operations (MO_FBIN,
// MO_FCMP: float registers, else through the scratch pair), negation,
// complement and the extensions (MO_NEG, MO_NOT, MO_EXT). A row has a
// seventh field, the precondition's own operand `parg` (a compare kind,
// an immediate). ng_isel_mi is the one entry: ng_mi_dispatch tries it
// first for every operation ng_isel_covers names. TG2: nat_isel_rule_check
// runs each rule alone on random operands (FID_VERIFY=1).
// Mutations (TG2, FID_NAT_MUTATE): isel (MO_SUB's operands swapped),
// iselimm (the constant of LI / ADDI / SHI rules off by one), iselcc
// (SETCC / BRCC rules test the inverse condition), iseldiv (the division
// rules take the other result or signedness).
//
// The rest (TG1, Nov 17: ng_isel_rows_tg1b, ng_isel_emit_tg1b): division,
// remainder and the high product (MO_DIV / MO_REM / MO_MULH), the sign
// mask (MO_ASR63), the conversions (MO_I2F / MO_F2I, float registers
// first), and the fused forms the earlier passes make: MO_ANDN, MO_BLSR
// (BMI1 and Zbb rows under `--cpu`), MO_CSEL (Zicond before the branch
// over a move), MO_TBNZ (short and long), MO_OPW (RISC-V) and MO_ALUM
// (x86-64). The hand-written ng_div .. ng_x64_alum stay as the
// FID_NAT_OFF=isel path and as what nat_isel_tg1b_check compares with.
// Still selected by hand only: moves, the frame's slots and arguments
// (SLOTADDR, LDSLOT, STSLOT, LDIN, STOUT), BNEZ / BEQZ, calls, jumps and
// jump tables, PANICIF / TRAP, F32BITS, COPY, the prologue and epilogue,
// OP18's BRCCM / SETCCM / ALUMST and the vector operations but MO_VBIN.

// Forms (target instructions)
const NG_IF_X64_BIN: i64 = 1;  // ng_x64_bin(kind = arg)
const NG_IF_X64_ADDIMM: i64 = 2;  // add r, imm (nothing for imm 0)
const NG_IF_X64_LEA: i64 = 3;  // lea d, [a + imm]
const NG_IF_A64_MADD: i64 = 10;  // madd/msub over the mul just emitted (may decline)
const NG_IF_A64_RRR: i64 = 11;  // a three-register instruction (arg: which)
const NG_IF_A64_ADDIMM: i64 = 12;  // add d, a, #imm
const NG_IF_A64_SUBIMM: i64 = 13;  // sub d, a, #-imm
const NG_IF_RV_RRR: i64 = 20;  // an R-type instruction (arg: which)
const NG_IF_RV_ADDI: i64 = 21;  // addi d, a, imm
// TG11: MO_VBIN's forms; d, a, b are vector registers (a == d), imm the
// NVK_* kind | (width << 8)
const NG_IF_X64_SSEV: i64 = 40;  // SSE2/SSE4.1 two-operand xmm (x64_vec)
const NG_IF_X64_AVXV: i64 = 41;  // AVX2 three-operand ymm (x64_vvec)
const NG_IF_A64_NEONV: i64 = 42;  // NEON .2d/.4s/.16b (a64_vec)
const NG_IF_RV_VV: i64 = 43;  // RVV .vv at VL 2 x e64 (rv_vec)
// TG1: constants (MO_LI: d, imm)
const NG_IF_X64_LI_ZERO: i64 = 50;  // xor r32, r32
const NG_IF_X64_LI_U32: i64 = 51;  // mov r32, imm32 (zero-extended)
const NG_IF_X64_LI_S32: i64 = 52;  // mov r/m64, simm32
const NG_IF_X64_LI_ABS: i64 = 53;  // movabs r64, imm64
const NG_IF_A64_MOVZ: i64 = 54;  // movz d, #h, lsl 16k
const NG_IF_A64_MOVN: i64 = 55;  // movn d, #h, lsl 16k
const NG_IF_A64_LI_SEQ: i64 = 56;  // movz / movn then movk (a64_li)
const NG_IF_RV_LI_ADDI: i64 = 57;  // addi d, zero, imm
const NG_IF_RV_LI_LUI: i64 = 58;  // lui + addiw
const NG_IF_RV_LI_SEQ: i64 = 59;  // rv_li's lui / addiw / slli / addi chain
// TG1: shifts by a constant (MO_SHI: d, a, count, kind)
const NG_IF_X64_SHI: i64 = 60;  // [mov d, a;] shl / sar / shr d, imm8
const NG_IF_A64_SHI: i64 = 61;  // lsl / asr / lsr #imm (UBFM / SBFM)
const NG_IF_RV_SHI: i64 = 62;  // slli / srai / srli
// TG1: element addresses (MO_ADDSHL: d = a + (b << sh))
const NG_IF_X64_LEA_IDX: i64 = 63;  // lea d, [a + b * 2^sh]
const NG_IF_X64_ADDSHL_R11: i64 = 64;  // r11 = b << sh, lea d, [a + r11]
const NG_IF_A64_ADD_LSL: i64 = 65;  // add d, a, b, lsl #sh
const NG_IF_RV_SHADD: i64 = 66;  // Zba sh1add / sh2add / sh3add
const NG_IF_RV_SLLI_ADD: i64 = 67;  // slli ad2, b, sh; add d, a, ad2
// TG1: compares (MO_SETCC: d = a cc b; MO_BRCC: branch when a cc b)
const NG_IF_X64_SETCC: i64 = 68;  // test / cmp, setcc r11b, movzx (arg 1: test)
const NG_IF_A64_CSET: i64 = 69;  // cmp, cset
const NG_IF_RV_EQNE: i64 = 70;  // sub, then sltiu 1 (arg 0, ==) / sltu zero (arg 1, !=)
const NG_IF_RV_SLT: i64 = 71;  // slt(u) (arg: 1 operands swapped, 2 unsigned, 4 xori 1 after)
const NG_IF_X64_JCC: i64 = 72;  // test / cmp (arg 1: test), jcc
const NG_IF_A64_CBZ: i64 = 73;  // cbz (arg 0) / cbnz (arg 1)
const NG_IF_A64_BCOND: i64 = 74;  // cmp, b.cond
const NG_IF_RV_BCC: i64 = 75;  // b<cc> (arg 0, short) / b<!cc> +8, jal (arg 1)
// TG1: loads and stores (MO_LOAD: d = [base + disp]; MO_STORE: [base +
// disp] = v; MO_LDX / MO_STX: [base + (idx << sh) + disp])
const NG_IF_FMEM: i64 = 76;  // a float register (movss/sd, ldr/str s/d, fl/fs)
const NG_IF_X64_MEM: i64 = 77;  // mov / movzx / movsx / movsxd [base + disp32]
const NG_IF_A64_MEM_UIMM: i64 = 78;  // ldr / str [base, #disp] (scaled unsigned 12 bits)
const NG_IF_A64_MEM_REG: i64 = 79;  // disp into ad2, add ad2, base; [ad2]
const NG_IF_RV_MEM_IMM: i64 = 80;  // l* / s* disp(base) (signed 12 bits)
const NG_IF_RV_MEM_REG: i64 = 81;  // disp into ad2, add ad2, base; 0(ad2)
const NG_IF_X64_MEM_SIB: i64 = 82;  // [base + idx * 2^sh + disp32]
const NG_IF_A64_MEM_ROFF: i64 = 83;  // [base, idx {, lsl #log2(size)}]
const NG_IF_MEM_ADDSHL: i64 = 84;  // ADDSHL into ad, then the base + disp access
// TG1: float operations (MO_FBIN: d = a op b; MO_FCMP: d = a cc b)
const NG_IF_F_FREG: i64 = 85;  // float registers (ng_fbin_fr / ng_fcmp_fr)
const NG_IF_X64_FBIN: i64 = 86;  // bits to xmm0 / xmm1, addsd .. divsd, back
const NG_IF_A64_FBIN: i64 = 87;  // bits to d0 / d1, fadd .. fdiv, back
const NG_IF_RV_FBIN: i64 = 88;  // bits to f0 / f1, fadd.d .. fdiv.d, back
const NG_IF_X64_FCMP_EQ: i64 = 89;  // ucomisd, sete & setnp (arg 0) / setne | setp (arg 1)
const NG_IF_X64_FCMP_ORD: i64 = 90;  // ucomisd (ordered so that above is the test), seta / setae
const NG_IF_A64_FCMP: i64 = 91;  // fcmp, cset
const NG_IF_RV_FCMP: i64 = 92;  // feq.d / flt.d / fle.d (swapped for > and >=)
// TG1: negation, complement and extensions (MO_NEG / MO_NOT: d = -a / ~a;
// MO_EXT: d = a extended from its low bits, kind i0: NEXT_*)
const NG_IF_X64_F7: i64 = 93;  // [mov d, a;] neg (arg 3) / not (arg 2) d
const NG_IF_A64_NEG: i64 = 94;  // neg d, a
const NG_IF_A64_MVN: i64 = 95;  // mvn d, a
const NG_IF_RV_NEG: i64 = 96;  // sub d, zero, a
const NG_IF_RV_NOT: i64 = 97;  // xori d, a, -1
const NG_IF_X64_EXT: i64 = 98;  // movsx / movzx (arg: the opcode byte; 0: mov r32)
const NG_IF_A64_EXT: i64 = 99;  // sxtb .. uxtw (arg: the NEXT_* kind)
const NG_IF_RV_EXT1: i64 = 100;  // one instruction (arg: kind): sext.b/h (Zbb), addiw 0, andi 255, zext.h (Zbb), zext.w (Zba)
const NG_IF_RV_EXT2: i64 = 101;  // slli then srai (arg | 256) / srli by arg
// TG1: division, remainder, the high half of a product and the sign mask
// (MO_DIV / MO_REM / MO_MULH: d = a op b, unsigned when i0 != 0;
// MO_ASR63: d = a >> 63). Forms from 110 on go to ng_isel_emit_tg1b.
const NG_IF_X64_F7RDX: i64 = 110;  // r11 = b, rax = a, [cqo | rdx = 0], F7 /ext r11, d = rax / rdx (arg: ext | res << 4 | prep << 8)
const NG_IF_A64_DIVMUL: i64 = 111;  // sdiv / udiv / smulh / umulh (arg 0..3)
const NG_IF_A64_REM: i64 = 112;  // s/udiv ad2, a, b; msub d, ad2, b, a (arg 1: unsigned)
const NG_IF_RV_MULDIV: i64 = 113;  // div / divu / rem / remu / mulh / mulhu (arg 0..5)
const NG_IF_X64_ASR63: i64 = 114;  // [mov d, a;] sar d, 63
const NG_IF_A64_ASR63: i64 = 115;  // asr d, a, #63
const NG_IF_RV_ASR63: i64 = 116;  // srai d, a, 63
// TG1: conversions (MO_I2F: d = float of integer a; MO_F2I: d = integer
// of float a, truncated; i0 != 0: the float is an f32)
const NG_IF_I2F_FREG: i64 = 117;  // into a float register (ng_i2f_fr)
const NG_IF_X64_I2F: i64 = 118;  // cvtsi2sd xmm0, a; the bits to d
const NG_IF_A64_I2F: i64 = 119;  // scvtf d0, a; the bits to d
const NG_IF_RV_I2F: i64 = 120;  // fcvt.d.l f0, a; the bits to d
const NG_IF_F2I_FREG: i64 = 121;  // from a float register (ng_f2i_fr)
const NG_IF_X64_F2I: i64 = 122;  // the bits to xmm0 (cached), cvttsd2si d
const NG_IF_A64_F2I: i64 = 123;  // fmov d0, a (f32: and fcvt); fcvtzs d
const NG_IF_RV_F2I: i64 = 124;  // fmv.d.x f0, a (f32: and fcvt); fcvt.l.d d
// TG1: the fused bit operations (MO_ANDN: d = ~a & b; MO_BLSR kind i0:
// 0 d = a & (a - 1), 1 a ^ (a - 1), 2 a & -a)
const NG_IF_X64_ANDN: i64 = 125;  // BMI1 andn d, a, b
const NG_IF_X64_ANDN_R11: i64 = 126;  // r11 = ~a & b, then d
const NG_IF_A64_BIC: i64 = 127;  // bic d, b, a
const NG_IF_RV_ANDN: i64 = 128;  // Zbb andn d, b, a
const NG_IF_RV_ANDN_AD2: i64 = 129;  // xori ad2, a, -1; and d, ad2, b
const NG_IF_X64_BLSX: i64 = 130;  // BMI1 blsr / blsmsk / blsi d, a
const NG_IF_X64_BLSX_R11: i64 = 131;  // r11 = a - 1 (or -a), then and / xor
const NG_IF_A64_BLSX: i64 = 132;  // neg [+ mvn] ad2, then and / eor
const NG_IF_RV_BLSX: i64 = 133;  // addi ad2, a, -1 (or sub), then and / xor
// TG1: conditional select (MO_CSEL: d = (a != 0) ? b : d, i0 1: a == 0;
// nothing when d is b)
const NG_IF_X64_CMOV: i64 = 134;  // test a, a; cmovne / cmove d, b
const NG_IF_A64_CSEL: i64 = 135;  // cmp a, xzr; csel d, b, d, ne / eq
const NG_IF_RV_CZERO: i64 = 136;  // Zicond czero.eqz / czero.nez into ad2 and d; or
const NG_IF_RV_CSEL_BR: i64 = 137;  // beqz / bnez a over one mv
// TG1: test a bit and branch (MO_TBNZ: to label i0 when bit i1 of d is
// set, i2 1: clear)
const NG_IF_X64_TBNZ: i64 = 138;  // test r, imm / bt r, imm8; jcc (rel8 when short)
const NG_IF_A64_TBZ: i64 = 139;  // tbz / tbnz to the label (short)
const NG_IF_A64_TBZ_B: i64 = 140;  // the inverse over a b (long)
const NG_IF_RV_TBZ: i64 = 141;  // [slli ad2] then blt / bge zero (arg 1: over a jal, long)
// TG1: 32-bit operations (MO_OPW, RISC-V: d = sext32(a op b), op i0) and
// an operation with a memory operand (MO_ALUM, x86-64: d = a op [b + i0],
// kind i1)
const NG_IF_RV_OPW: i64 = 142;  // addw / subw / mulw
const NG_IF_X64_ALUM: i64 = 143;  // [mov d, a;] op d, [b + i0]
const NG_IF_X64_ALUM_AD2: i64 = 144;  // d is the base: mov ad2, a; op ad2, [d + i0]; mov d, ad2
// Three-register instructions (arg of NG_IF_A64_RRR / NG_IF_RV_RRR)
const NG_IR_ADD: i64 = 1;
const NG_IR_SUB: i64 = 2;
const NG_IR_MUL: i64 = 3;
const NG_IR_AND: i64 = 4;
const NG_IR_OR: i64 = 5;
const NG_IR_XOR: i64 = 6;
const NG_IR_SHL: i64 = 7;
const NG_IR_SAR: i64 = 8;
const NG_IR_SHR: i64 = 9;
// Preconditions
const NG_IP_ANY: i64 = 0;
const NG_IP_D_IS_A: i64 = 1;  // the destination is the first operand
const NG_IP_IMM_GE0: i64 = 2;
const NG_IP_IMM_LT0: i64 = 3;
const NG_IP_ADDEND: i64 = 4;  // MADD: an add (not a sub)
const NG_IP_SUBTRA: i64 = 5;  // MSUB: a sub
const NG_IP_VW16: i64 = 8;  // TG11: a 16-byte vector operation
const NG_IP_VW32: i64 = 9;  // TG11: a 32-byte vector operation
// TG1 (parg: the row's seventh field)
const NG_IP_IMM_EQ: i64 = 10;  // the immediate is parg
const NG_IP_IMM_U32: i64 = 11;  // 0 < imm <= 0xFFFFFFFF
const NG_IP_IMM_S32: i64 = 12;  // imm fits a signed 32-bit field
const NG_IP_IMM_S12: i64 = 13;  // imm fits a signed 12-bit field
const NG_IP_IMM_MOVZ: i64 = 14;  // at most one 16-bit piece of imm is not 0
const NG_IP_IMM_MOVN: i64 = 15;  // at most one 16-bit piece of imm is not 0xFFFF
const NG_IP_CC: i64 = 16;  // the compare kind is parg
const NG_IP_B_ZERO: i64 = 17;  // the second operand is the zero register
const NG_IP_ZERO_CC: i64 = 18;  // both: against zero, kind parg
const NG_IP_SHORT: i64 = 19;  // the branch target is in a short branch's reach
const NG_IP_FREG_MEM: i64 = 20;  // the loaded or stored register is a float register
const NG_IP_A64_UIMM: i64 = 21;  // AArch64's scaled unsigned offset holds disp
const NG_IP_DISP_S12: i64 = 22;  // RISC-V's signed 12-bit offset holds disp
const NG_IP_INDEXED: i64 = 23;  // the target has [base + idx << sh + disp] for it
const NG_IP_FREG_OP: i64 = 24;  // a float operation in float registers (MI25)
const NG_IP_SH_IDX: i64 = 25;  // ADDSHL: sh <= 3 and an index other than rsp
const NG_IP_SH_ZERO: i64 = 26;  // ADDSHL: sh is 0
const NG_IP_SH_ZBA: i64 = 27;  // ADDSHL: sh 1..3 on RISC-V with Zba
const NG_IP_ZB_EXT: i64 = 28;  // EXT of kind parg on RISC-V with Zba and Zbb
const NG_IP_FREG_D: i64 = 29;  // the destination is a float register (MI25)
const NG_IP_FREG_A: i64 = 30;  // the first operand is a float register (MI25)
const NG_IP_BMI1: i64 = 31;  // x86-64 with BMI1 (--cpu x86-64-v3 / v4)
const NG_IP_ZB: i64 = 32;  // RISC-V with Zba and Zbb (--cpu)
const NG_IP_ZICOND: i64 = 33;  // RISC-V with Zicond (--cpu rva23u64)
const NG_IP_D_IS_BASE: i64 = 34;  // ALUM: d is the base register and not a
const NG_IP_NOT_D_BASE: i64 = 35;  // ALUM: the other cases
const NG_IS_W: i64 = 7;  // fields per row

/// The rules, rows of NG_IS_W: [arch, op, form, cost, pre, arg, parg].
var g_ng_isel: Vec<i64> = Vec::new();
/// (arch * 64 + op) -> 1 + the first row of its rules in cost order, 0 none;
/// g_ng_isel_n the number of them.
var g_ng_isel_ix: Vec<i64> = Vec::new();
var g_ng_isel_n: Vec<i64> = Vec::new();
/// 0: not yet known, 1 on, 2 off (FID_NAT_OFF=isel or nat_sel_check's
/// comparison run).
var g_ng_isel_state: i64 = 0;

fn ng_isel_row(v: &mut Vec<i64>, arch: i64, op: i64, form: i64, cost: i64, pre: i64, arg: i64) {
    ng_isel_rowp(v, arch, op, form, cost, pre, 0, arg);
}

/// A row whose precondition has an operand of its own (parg).
fn ng_isel_rowp(v: &mut Vec<i64>, arch: i64, op: i64, form: i64, cost: i64, pre: i64, parg: i64, arg: i64) {
    v.push(arch);
    v.push(op);
    v.push(form);
    v.push(cost);
    v.push(pre);
    v.push(arg);
    v.push(parg);
}

/// The selection table. Costs: instructions emitted (MADD 0: it replaces
/// the multiply before it with one instruction that also adds).
fn ng_isel_rows() -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    // x86-64: two-operand ALU forms through ng_x64_bin (kind = MO order)
    ng_isel_row(&mut v, NAT_X64, MO_ADD, NG_IF_X64_BIN, 1, NG_IP_ANY, 1);
    ng_isel_row(&mut v, NAT_X64, MO_SUB, NG_IF_X64_BIN, 1, NG_IP_ANY, 2);
    ng_isel_row(&mut v, NAT_X64, MO_MUL, NG_IF_X64_BIN, 1, NG_IP_ANY, 3);
    ng_isel_row(&mut v, NAT_X64, MO_AND, NG_IF_X64_BIN, 1, NG_IP_ANY, 4);
    ng_isel_row(&mut v, NAT_X64, MO_OR, NG_IF_X64_BIN, 1, NG_IP_ANY, 5);
    ng_isel_row(&mut v, NAT_X64, MO_XOR, NG_IF_X64_BIN, 1, NG_IP_ANY, 6);
    ng_isel_row(&mut v, NAT_X64, MO_SHL, NG_IF_X64_BIN, 1, NG_IP_ANY, 7);
    ng_isel_row(&mut v, NAT_X64, MO_SAR, NG_IF_X64_BIN, 1, NG_IP_ANY, 8);
    ng_isel_row(&mut v, NAT_X64, MO_SHR, NG_IF_X64_BIN, 1, NG_IP_ANY, 9);
    // d = a + c: ADD r, imm in place, else the three-operand LEA
    ng_isel_row(&mut v, NAT_X64, MO_ADDI, NG_IF_X64_ADDIMM, 1, NG_IP_D_IS_A, 0);
    ng_isel_row(&mut v, NAT_X64, MO_ADDI, NG_IF_X64_LEA, 2, NG_IP_ANY, 0);
    // AArch64
    ng_isel_row(&mut v, NAT_A64, MO_ADD, NG_IF_A64_MADD, 0, NG_IP_ADDEND, 0);
    ng_isel_row(&mut v, NAT_A64, MO_ADD, NG_IF_A64_RRR, 1, NG_IP_ANY, NG_IR_ADD);
    ng_isel_row(&mut v, NAT_A64, MO_SUB, NG_IF_A64_MADD, 0, NG_IP_SUBTRA, 0);
    ng_isel_row(&mut v, NAT_A64, MO_SUB, NG_IF_A64_RRR, 1, NG_IP_ANY, NG_IR_SUB);
    ng_isel_row(&mut v, NAT_A64, MO_MUL, NG_IF_A64_RRR, 1, NG_IP_ANY, NG_IR_MUL);
    ng_isel_row(&mut v, NAT_A64, MO_AND, NG_IF_A64_RRR, 1, NG_IP_ANY, NG_IR_AND);
    ng_isel_row(&mut v, NAT_A64, MO_OR, NG_IF_A64_RRR, 1, NG_IP_ANY, NG_IR_OR);
    ng_isel_row(&mut v, NAT_A64, MO_XOR, NG_IF_A64_RRR, 1, NG_IP_ANY, NG_IR_XOR);
    ng_isel_row(&mut v, NAT_A64, MO_SHL, NG_IF_A64_RRR, 1, NG_IP_ANY, NG_IR_SHL);
    ng_isel_row(&mut v, NAT_A64, MO_SAR, NG_IF_A64_RRR, 1, NG_IP_ANY, NG_IR_SAR);
    ng_isel_row(&mut v, NAT_A64, MO_SHR, NG_IF_A64_RRR, 1, NG_IP_ANY, NG_IR_SHR);
    ng_isel_row(&mut v, NAT_A64, MO_ADDI, NG_IF_A64_ADDIMM, 1, NG_IP_IMM_GE0, 0);
    ng_isel_row(&mut v, NAT_A64, MO_ADDI, NG_IF_A64_SUBIMM, 1, NG_IP_IMM_LT0, 0);
    // RISC-V
    ng_isel_row(&mut v, NAT_RV64, MO_ADD, NG_IF_RV_RRR, 1, NG_IP_ANY, NG_IR_ADD);
    ng_isel_row(&mut v, NAT_RV64, MO_SUB, NG_IF_RV_RRR, 1, NG_IP_ANY, NG_IR_SUB);
    ng_isel_row(&mut v, NAT_RV64, MO_MUL, NG_IF_RV_RRR, 1, NG_IP_ANY, NG_IR_MUL);
    ng_isel_row(&mut v, NAT_RV64, MO_AND, NG_IF_RV_RRR, 1, NG_IP_ANY, NG_IR_AND);
    ng_isel_row(&mut v, NAT_RV64, MO_OR, NG_IF_RV_RRR, 1, NG_IP_ANY, NG_IR_OR);
    ng_isel_row(&mut v, NAT_RV64, MO_XOR, NG_IF_RV_RRR, 1, NG_IP_ANY, NG_IR_XOR);
    ng_isel_row(&mut v, NAT_RV64, MO_SHL, NG_IF_RV_RRR, 1, NG_IP_ANY, NG_IR_SHL);
    ng_isel_row(&mut v, NAT_RV64, MO_SAR, NG_IF_RV_RRR, 1, NG_IP_ANY, NG_IR_SAR);
    ng_isel_row(&mut v, NAT_RV64, MO_SHR, NG_IF_RV_RRR, 1, NG_IP_ANY, NG_IR_SHR);
    ng_isel_row(&mut v, NAT_RV64, MO_ADDI, NG_IF_RV_ADDI, 1, NG_IP_ANY, 0);
    // TG11: the vector operations' arithmetic (MO_VBIN), by width
    ng_isel_row(&mut v, NAT_X64, MO_VBIN, NG_IF_X64_SSEV, 1, NG_IP_VW16, 0);
    ng_isel_row(&mut v, NAT_X64, MO_VBIN, NG_IF_X64_AVXV, 1, NG_IP_VW32, 0);
    ng_isel_row(&mut v, NAT_A64, MO_VBIN, NG_IF_A64_NEONV, 1, NG_IP_VW16, 0);
    ng_isel_row(&mut v, NAT_RV64, MO_VBIN, NG_IF_RV_VV, 1, NG_IP_VW16, 0);
    ng_isel_rows_tg1(&mut v);
    return v;
}

/// TG1: the rules past the integer ALU, by family. Within one (arch, op)
/// the cost orders them (instructions emitted; a sequence whose length
/// depends on the constant counts as its longest common case), equal
/// costs in the order written here.
fn ng_isel_rows_tg1(v: &mut Vec<i64>) {
    // Constants, by the class of the immediate
    ng_isel_rowp(v, NAT_X64, MO_LI, NG_IF_X64_LI_ZERO, 1, NG_IP_IMM_EQ, 0, 0);
    ng_isel_row(v, NAT_X64, MO_LI, NG_IF_X64_LI_U32, 2, NG_IP_IMM_U32, 0);
    ng_isel_row(v, NAT_X64, MO_LI, NG_IF_X64_LI_S32, 3, NG_IP_IMM_S32, 0);
    ng_isel_row(v, NAT_X64, MO_LI, NG_IF_X64_LI_ABS, 4, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_LI, NG_IF_A64_MOVZ, 1, NG_IP_IMM_MOVZ, 0);
    ng_isel_row(v, NAT_A64, MO_LI, NG_IF_A64_MOVN, 1, NG_IP_IMM_MOVN, 0);
    ng_isel_row(v, NAT_A64, MO_LI, NG_IF_A64_LI_SEQ, 3, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_LI, NG_IF_RV_LI_ADDI, 1, NG_IP_IMM_S12, 0);
    ng_isel_row(v, NAT_RV64, MO_LI, NG_IF_RV_LI_LUI, 2, NG_IP_IMM_S32, 0);
    ng_isel_row(v, NAT_RV64, MO_LI, NG_IF_RV_LI_SEQ, 4, NG_IP_ANY, 0);
    // Shifts by a constant
    ng_isel_row(v, NAT_X64, MO_SHI, NG_IF_X64_SHI, 1, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_SHI, NG_IF_A64_SHI, 1, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_SHI, NG_IF_RV_SHI, 1, NG_IP_ANY, 0);
    // Element addresses: a + (b << sh)
    ng_isel_row(v, NAT_X64, MO_ADDSHL, NG_IF_X64_LEA_IDX, 1, NG_IP_SH_IDX, 0);
    ng_isel_row(v, NAT_X64, MO_ADDSHL, NG_IF_X64_ADDSHL_R11, 3, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_ADDSHL, NG_IF_A64_ADD_LSL, 1, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_ADDSHL, NG_IF_RV_RRR, 1, NG_IP_SH_ZERO, NG_IR_ADD);
    ng_isel_row(v, NAT_RV64, MO_ADDSHL, NG_IF_RV_SHADD, 1, NG_IP_SH_ZBA, 0);
    ng_isel_row(v, NAT_RV64, MO_ADDSHL, NG_IF_RV_SLLI_ADD, 2, NG_IP_ANY, 0);
    // Compares to a value
    ng_isel_row(v, NAT_X64, MO_SETCC, NG_IF_X64_SETCC, 3, NG_IP_B_ZERO, 1);
    ng_isel_row(v, NAT_X64, MO_SETCC, NG_IF_X64_SETCC, 3, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_SETCC, NG_IF_A64_CSET, 2, NG_IP_ANY, 0);
    ng_isel_rowp(v, NAT_RV64, MO_SETCC, NG_IF_RV_SLT, 1, NG_IP_CC, NCC_LT, 0);
    ng_isel_rowp(v, NAT_RV64, MO_SETCC, NG_IF_RV_SLT, 1, NG_IP_CC, NCC_GT, 1);
    ng_isel_rowp(v, NAT_RV64, MO_SETCC, NG_IF_RV_SLT, 1, NG_IP_CC, NCC_LTU, 2);
    ng_isel_rowp(v, NAT_RV64, MO_SETCC, NG_IF_RV_SLT, 1, NG_IP_CC, NCC_GTU, 3);
    ng_isel_rowp(v, NAT_RV64, MO_SETCC, NG_IF_RV_EQNE, 2, NG_IP_CC, NCC_EQ, 0);
    ng_isel_rowp(v, NAT_RV64, MO_SETCC, NG_IF_RV_EQNE, 2, NG_IP_CC, NCC_NE, 1);
    ng_isel_rowp(v, NAT_RV64, MO_SETCC, NG_IF_RV_SLT, 2, NG_IP_CC, NCC_GE, 4);
    ng_isel_rowp(v, NAT_RV64, MO_SETCC, NG_IF_RV_SLT, 2, NG_IP_CC, NCC_LE, 5);
    ng_isel_rowp(v, NAT_RV64, MO_SETCC, NG_IF_RV_SLT, 2, NG_IP_CC, NCC_GEU, 6);
    ng_isel_rowp(v, NAT_RV64, MO_SETCC, NG_IF_RV_SLT, 2, NG_IP_CC, NCC_LEU, 7);
    // Compares and branches
    ng_isel_row(v, NAT_X64, MO_BRCC, NG_IF_X64_JCC, 2, NG_IP_B_ZERO, 1);
    ng_isel_row(v, NAT_X64, MO_BRCC, NG_IF_X64_JCC, 2, NG_IP_ANY, 0);
    ng_isel_rowp(v, NAT_A64, MO_BRCC, NG_IF_A64_CBZ, 1, NG_IP_ZERO_CC, NCC_EQ, 0);
    ng_isel_rowp(v, NAT_A64, MO_BRCC, NG_IF_A64_CBZ, 1, NG_IP_ZERO_CC, NCC_NE, 1);
    ng_isel_row(v, NAT_A64, MO_BRCC, NG_IF_A64_BCOND, 2, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_BRCC, NG_IF_RV_BCC, 1, NG_IP_SHORT, 0);
    ng_isel_row(v, NAT_RV64, MO_BRCC, NG_IF_RV_BCC, 2, NG_IP_ANY, 1);
    // Loads and stores, base + displacement
    var arch: i64 = NAT_X64;
    var ai: i64 = 0;
    while ai < 3 {
        if ai == 1 {
            arch = NAT_A64;
        }
        if ai == 2 {
            arch = NAT_RV64;
        }
        ng_isel_row(v, arch, MO_LOAD, NG_IF_FMEM, 1, NG_IP_FREG_MEM, 0);
        ng_isel_row(v, arch, MO_STORE, NG_IF_FMEM, 1, NG_IP_FREG_MEM, 0);
        ng_isel_row(v, arch, MO_FBIN, NG_IF_F_FREG, 1, NG_IP_FREG_OP, 0);
        ng_isel_row(v, arch, MO_FCMP, NG_IF_F_FREG, 1, NG_IP_FREG_OP, 0);
        ai = ai + 1;
    }
    ng_isel_row(v, NAT_X64, MO_LOAD, NG_IF_X64_MEM, 1, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_X64, MO_STORE, NG_IF_X64_MEM, 1, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_LOAD, NG_IF_A64_MEM_UIMM, 1, NG_IP_A64_UIMM, 0);
    ng_isel_row(v, NAT_A64, MO_LOAD, NG_IF_A64_MEM_REG, 3, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_STORE, NG_IF_A64_MEM_UIMM, 1, NG_IP_A64_UIMM, 0);
    ng_isel_row(v, NAT_A64, MO_STORE, NG_IF_A64_MEM_REG, 3, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_LOAD, NG_IF_RV_MEM_IMM, 1, NG_IP_DISP_S12, 0);
    ng_isel_row(v, NAT_RV64, MO_LOAD, NG_IF_RV_MEM_REG, 3, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_STORE, NG_IF_RV_MEM_IMM, 1, NG_IP_DISP_S12, 0);
    ng_isel_row(v, NAT_RV64, MO_STORE, NG_IF_RV_MEM_REG, 3, NG_IP_ANY, 0);
    // Loads and stores, base + scaled index + displacement
    ng_isel_row(v, NAT_X64, MO_LDX, NG_IF_X64_MEM_SIB, 1, NG_IP_INDEXED, 0);
    ng_isel_row(v, NAT_X64, MO_LDX, NG_IF_MEM_ADDSHL, 3, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_X64, MO_STX, NG_IF_X64_MEM_SIB, 1, NG_IP_INDEXED, 0);
    ng_isel_row(v, NAT_X64, MO_STX, NG_IF_MEM_ADDSHL, 3, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_LDX, NG_IF_A64_MEM_ROFF, 1, NG_IP_INDEXED, 0);
    ng_isel_row(v, NAT_A64, MO_LDX, NG_IF_MEM_ADDSHL, 3, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_STX, NG_IF_A64_MEM_ROFF, 1, NG_IP_INDEXED, 0);
    ng_isel_row(v, NAT_A64, MO_STX, NG_IF_MEM_ADDSHL, 3, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_LDX, NG_IF_MEM_ADDSHL, 3, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_STX, NG_IF_MEM_ADDSHL, 3, NG_IP_ANY, 0);
    // Float operations through the general registers' bits
    ng_isel_row(v, NAT_X64, MO_FBIN, NG_IF_X64_FBIN, 4, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_FBIN, NG_IF_A64_FBIN, 4, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_FBIN, NG_IF_RV_FBIN, 4, NG_IP_ANY, 0);
    ng_isel_rowp(v, NAT_X64, MO_FCMP, NG_IF_X64_FCMP_ORD, 4, NG_IP_CC, NCC_LT, 0);
    ng_isel_rowp(v, NAT_X64, MO_FCMP, NG_IF_X64_FCMP_ORD, 4, NG_IP_CC, NCC_LE, 0);
    ng_isel_rowp(v, NAT_X64, MO_FCMP, NG_IF_X64_FCMP_ORD, 4, NG_IP_CC, NCC_GT, 0);
    ng_isel_rowp(v, NAT_X64, MO_FCMP, NG_IF_X64_FCMP_ORD, 4, NG_IP_CC, NCC_GE, 0);
    ng_isel_rowp(v, NAT_X64, MO_FCMP, NG_IF_X64_FCMP_EQ, 8, NG_IP_CC, NCC_EQ, 0);
    ng_isel_rowp(v, NAT_X64, MO_FCMP, NG_IF_X64_FCMP_EQ, 8, NG_IP_CC, NCC_NE, 1);
    ng_isel_row(v, NAT_A64, MO_FCMP, NG_IF_A64_FCMP, 4, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_FCMP, NG_IF_RV_FCMP, 4, NG_IP_ANY, 0);
    // Negation and complement
    ng_isel_row(v, NAT_X64, MO_NEG, NG_IF_X64_F7, 1, NG_IP_ANY, 3);
    ng_isel_row(v, NAT_X64, MO_NOT, NG_IF_X64_F7, 1, NG_IP_ANY, 2);
    ng_isel_row(v, NAT_A64, MO_NEG, NG_IF_A64_NEG, 1, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_NOT, NG_IF_A64_MVN, 1, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_NEG, NG_IF_RV_NEG, 1, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_NOT, NG_IF_RV_NOT, 1, NG_IP_ANY, 0);
    // Extensions, by kind
    ng_isel_rowp(v, NAT_X64, MO_EXT, NG_IF_X64_EXT, 1, NG_IP_IMM_EQ, NEXT_SB, 0xBE);
    ng_isel_rowp(v, NAT_X64, MO_EXT, NG_IF_X64_EXT, 1, NG_IP_IMM_EQ, NEXT_SH, 0xBF);
    ng_isel_rowp(v, NAT_X64, MO_EXT, NG_IF_X64_EXT, 1, NG_IP_IMM_EQ, NEXT_SW, 0x63);
    ng_isel_rowp(v, NAT_X64, MO_EXT, NG_IF_X64_EXT, 1, NG_IP_IMM_EQ, NEXT_ZB, 0xB6);
    ng_isel_rowp(v, NAT_X64, MO_EXT, NG_IF_X64_EXT, 1, NG_IP_IMM_EQ, NEXT_ZH, 0xB7);
    ng_isel_rowp(v, NAT_X64, MO_EXT, NG_IF_X64_EXT, 1, NG_IP_IMM_EQ, NEXT_ZW, 0);
    var kk: i64 = NEXT_SB;
    while kk <= NEXT_ZW {
        ng_isel_rowp(v, NAT_A64, MO_EXT, NG_IF_A64_EXT, 1, NG_IP_IMM_EQ, kk, kk);
        kk = kk + 1;
    }
    ng_isel_rowp(v, NAT_RV64, MO_EXT, NG_IF_RV_EXT1, 1, NG_IP_ZB_EXT, NEXT_SB, NEXT_SB);
    ng_isel_rowp(v, NAT_RV64, MO_EXT, NG_IF_RV_EXT1, 1, NG_IP_ZB_EXT, NEXT_SH, NEXT_SH);
    ng_isel_rowp(v, NAT_RV64, MO_EXT, NG_IF_RV_EXT1, 1, NG_IP_IMM_EQ, NEXT_SW, NEXT_SW);
    ng_isel_rowp(v, NAT_RV64, MO_EXT, NG_IF_RV_EXT1, 1, NG_IP_IMM_EQ, NEXT_ZB, NEXT_ZB);
    ng_isel_rowp(v, NAT_RV64, MO_EXT, NG_IF_RV_EXT1, 1, NG_IP_ZB_EXT, NEXT_ZH, NEXT_ZH);
    ng_isel_rowp(v, NAT_RV64, MO_EXT, NG_IF_RV_EXT1, 1, NG_IP_ZB_EXT, NEXT_ZW, NEXT_ZW);
    ng_isel_rowp(v, NAT_RV64, MO_EXT, NG_IF_RV_EXT2, 2, NG_IP_IMM_EQ, NEXT_SB, 256 | 56);
    ng_isel_rowp(v, NAT_RV64, MO_EXT, NG_IF_RV_EXT2, 2, NG_IP_IMM_EQ, NEXT_SH, 256 | 48);
    ng_isel_rowp(v, NAT_RV64, MO_EXT, NG_IF_RV_EXT2, 2, NG_IP_IMM_EQ, NEXT_ZH, 48);
    ng_isel_rowp(v, NAT_RV64, MO_EXT, NG_IF_RV_EXT2, 2, NG_IP_IMM_EQ, NEXT_ZW, 32);
    ng_isel_rows_tg1b(v);
}

/// TG1: the rest of the operations the hand-written selection still took
/// (ng_isel_emit_tg1b): division and remainder, the high product, the
/// sign mask, the conversions, the fused bit operations, the select,
/// test-bit-and-branch, RISC-V's 32-bit operations and x86-64's memory
/// operand. A conditional branch counts as two instructions.
fn ng_isel_rows_tg1b(v: &mut Vec<i64>) {
    // Division (signed when i0 is 0), remainder, high product. x86-64:
    // F7 /ext over rax:rdx with the other operand in r11; arg = ext | the
    // result register << 4 | the preparation << 8 (1 cqo, 2 rdx = 0)
    ng_isel_rowp(v, NAT_X64, MO_DIV, NG_IF_X64_F7RDX, 5, NG_IP_IMM_EQ, 0, 7 | (1 << 8));
    ng_isel_row(v, NAT_X64, MO_DIV, NG_IF_X64_F7RDX, 5, NG_IP_ANY, 6 | (2 << 8));
    ng_isel_rowp(v, NAT_X64, MO_REM, NG_IF_X64_F7RDX, 5, NG_IP_IMM_EQ, 0, 7 | (2 << 4) | (1 << 8));
    ng_isel_row(v, NAT_X64, MO_REM, NG_IF_X64_F7RDX, 5, NG_IP_ANY, 6 | (2 << 4) | (2 << 8));
    ng_isel_rowp(v, NAT_X64, MO_MULH, NG_IF_X64_F7RDX, 4, NG_IP_IMM_EQ, 0, 5 | (2 << 4));
    ng_isel_row(v, NAT_X64, MO_MULH, NG_IF_X64_F7RDX, 4, NG_IP_ANY, 4 | (2 << 4));
    ng_isel_rowp(v, NAT_A64, MO_DIV, NG_IF_A64_DIVMUL, 1, NG_IP_IMM_EQ, 0, 0);
    ng_isel_row(v, NAT_A64, MO_DIV, NG_IF_A64_DIVMUL, 1, NG_IP_ANY, 1);
    ng_isel_rowp(v, NAT_A64, MO_MULH, NG_IF_A64_DIVMUL, 1, NG_IP_IMM_EQ, 0, 2);
    ng_isel_row(v, NAT_A64, MO_MULH, NG_IF_A64_DIVMUL, 1, NG_IP_ANY, 3);
    ng_isel_rowp(v, NAT_A64, MO_REM, NG_IF_A64_REM, 2, NG_IP_IMM_EQ, 0, 0);
    ng_isel_row(v, NAT_A64, MO_REM, NG_IF_A64_REM, 2, NG_IP_ANY, 1);
    ng_isel_rowp(v, NAT_RV64, MO_DIV, NG_IF_RV_MULDIV, 1, NG_IP_IMM_EQ, 0, 0);
    ng_isel_row(v, NAT_RV64, MO_DIV, NG_IF_RV_MULDIV, 1, NG_IP_ANY, 1);
    ng_isel_rowp(v, NAT_RV64, MO_REM, NG_IF_RV_MULDIV, 1, NG_IP_IMM_EQ, 0, 2);
    ng_isel_row(v, NAT_RV64, MO_REM, NG_IF_RV_MULDIV, 1, NG_IP_ANY, 3);
    ng_isel_rowp(v, NAT_RV64, MO_MULH, NG_IF_RV_MULDIV, 1, NG_IP_IMM_EQ, 0, 4);
    ng_isel_row(v, NAT_RV64, MO_MULH, NG_IF_RV_MULDIV, 1, NG_IP_ANY, 5);
    // The sign mask
    ng_isel_row(v, NAT_X64, MO_ASR63, NG_IF_X64_ASR63, 1, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_ASR63, NG_IF_A64_ASR63, 1, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_ASR63, NG_IF_RV_ASR63, 1, NG_IP_ANY, 0);
    // Conversions: in float registers (MI25), else through the scratch
    // float register 0 and the general register's bits
    var arch: i64 = NAT_X64;
    var ai: i64 = 0;
    while ai < 3 {
        if ai == 1 {
            arch = NAT_A64;
        }
        if ai == 2 {
            arch = NAT_RV64;
        }
        ng_isel_row(v, arch, MO_I2F, NG_IF_I2F_FREG, 1, NG_IP_FREG_D, 0);
        ng_isel_row(v, arch, MO_F2I, NG_IF_F2I_FREG, 1, NG_IP_FREG_A, 0);
        ai = ai + 1;
    }
    ng_isel_row(v, NAT_X64, MO_I2F, NG_IF_X64_I2F, 2, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_I2F, NG_IF_A64_I2F, 2, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_I2F, NG_IF_RV_I2F, 2, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_X64, MO_F2I, NG_IF_X64_F2I, 2, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_F2I, NG_IF_A64_F2I, 2, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_F2I, NG_IF_RV_F2I, 2, NG_IP_ANY, 0);
    // AND NOT and the lowest set bit: x86-64 BMI1 and RISC-V Zbb under
    // `--cpu`, else two to five plain instructions
    ng_isel_row(v, NAT_X64, MO_ANDN, NG_IF_X64_ANDN, 1, NG_IP_BMI1, 0);
    ng_isel_row(v, NAT_X64, MO_ANDN, NG_IF_X64_ANDN_R11, 4, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_ANDN, NG_IF_A64_BIC, 1, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_ANDN, NG_IF_RV_ANDN, 1, NG_IP_ZB, 0);
    ng_isel_row(v, NAT_RV64, MO_ANDN, NG_IF_RV_ANDN_AD2, 2, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_X64, MO_BLSR, NG_IF_X64_BLSX, 1, NG_IP_BMI1, 0);
    ng_isel_row(v, NAT_X64, MO_BLSR, NG_IF_X64_BLSX_R11, 5, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_BLSR, NG_IF_A64_BLSX, 3, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_BLSR, NG_IF_RV_BLSX, 2, NG_IP_ANY, 0);
    // The select: RISC-V Zicond (three instructions) before the branch
    // over a move
    ng_isel_row(v, NAT_X64, MO_CSEL, NG_IF_X64_CMOV, 2, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_CSEL, NG_IF_A64_CSEL, 2, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_CSEL, NG_IF_RV_CZERO, 3, NG_IP_ZICOND, 0);
    ng_isel_row(v, NAT_RV64, MO_CSEL, NG_IF_RV_CSEL_BR, 3, NG_IP_ANY, 0);
    // Test a bit and branch, short when the target is in reach
    ng_isel_row(v, NAT_X64, MO_TBNZ, NG_IF_X64_TBNZ, 3, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_A64, MO_TBNZ, NG_IF_A64_TBZ, 2, NG_IP_SHORT, 0);
    ng_isel_row(v, NAT_A64, MO_TBNZ, NG_IF_A64_TBZ_B, 4, NG_IP_ANY, 0);
    ng_isel_row(v, NAT_RV64, MO_TBNZ, NG_IF_RV_TBZ, 3, NG_IP_SHORT, 0);
    ng_isel_row(v, NAT_RV64, MO_TBNZ, NG_IF_RV_TBZ, 5, NG_IP_ANY, 1);
    // RISC-V's 32-bit operations (ng_sel_has: formed there only)
    ng_isel_row(v, NAT_RV64, MO_OPW, NG_IF_RV_OPW, 1, NG_IP_ANY, 0);
    // x86-64's ALU operation with a memory operand (ng_sel_has: x86-64
    // only); when d is the base the result is formed in ad2
    ng_isel_row(v, NAT_X64, MO_ALUM, NG_IF_X64_ALUM, 2, NG_IP_NOT_D_BASE, 0);
    ng_isel_row(v, NAT_X64, MO_ALUM, NG_IF_X64_ALUM_AD2, 3, NG_IP_D_IS_BASE, 0);
}

/// Build g_ng_isel once: the rows grouped by (arch, op), each group in
/// cost order (stable), and the index over the groups.
fn ng_isel_build() {
    var rows: Vec<i64> = ng_isel_rows();
    var n: i64 = rows.len() / NG_IS_W;
    var ix: Vec<i64> = Vec::new();
    var cnt: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < 4 * 64 {
        ix.push(0);
        cnt.push(0);
        k = k + 1;
    }
    var out: Vec<i64> = Vec::new();
    var key: i64 = 0;
    while key < 4 * 64 {
        // the rules of this key, cheapest first: costs are small, so one
        // pass per cost value keeps equal costs in table order
        var cost: i64 = 0;
        while cost <= 8 {
            var r: i64 = 0;
            while r < n {
                var at: i64 = r * NG_IS_W;
                if rows.get(at) * 64 + rows.get(at + 1) == key && rows.get(at + 3) == cost {
                    if cnt.get(key) == 0 {
                        ix.set(key, out.len() / NG_IS_W + 1);
                    }
                    cnt.set(key, cnt.get(key) + 1);
                    var f: i64 = 0;
                    while f < NG_IS_W {
                        out.push(rows.get(at + f));
                        f = f + 1;
                    }
                }
                r = r + 1;
            }
            cost = cost + 1;
        }
        key = key + 1;
    }
    g_ng_isel = out;
    g_ng_isel_ix = ix;
    g_ng_isel_n = cnt;
}

/// TG2-style mutation of the table (FID_NAT_MUTATE=isel): MO_SUB's rules
/// take their operands the wrong way round, so that nat_sel_check
/// (FID_VERIFY=1) is seen to catch a wrong rule
/// (tests/nattools/isel_table_check.sh). Read once with the state.
var g_ng_isel_mut: bool = false;
/// TG2: FID_NAT_MUTATE=iselimm (the constant of the LI / ADDI / SHI rules
/// off by one) and iselcc (the SETCC / BRCC rules test the inverse
/// condition), caught by nat_isel_rule_check and nat_sel_check.
var g_ng_isel_mut_imm: bool = false;
var g_ng_isel_mut_cc: bool = false;
/// TG1: FID_NAT_MUTATE=iseldiv: the division rules (ng_isel_rows_tg1b)
/// take the other result (x86-64 rdx for rax and back) or the other
/// signedness, caught by nat_isel_tg1b_check (FID_VERIFY=1).
var g_ng_isel_mut_div: bool = false;

fn ng_isel_on() -> bool {
    if g_ng_isel_state == 0 {
        g_ng_isel_state = 2;
        if ng_on("isel") {
            g_ng_isel_state = 1;
        }
        g_ng_isel_mut = ng_mutant("isel");
        g_ng_isel_mut_imm = ng_mutant("iselimm");
        g_ng_isel_mut_cc = ng_mutant("iselcc");
        g_ng_isel_mut_div = ng_mutant("iseldiv");
    }
    return g_ng_isel_state == 1;
}

/// SP5: the switch and the table, read once and built once before anything
/// is emitted (NatGen_new); ng_isel_mi, which the emission's worker
/// threads run, only reads them.
fn ng_isel_init() {
    if ng_isel_on() && g_ng_isel_ix.len() == 0 {
        ng_isel_build();
    }
}

/// SP5: the tables every emission reads: the selection table (TG1) and
/// the float-register switches (MI25). Idempotent; NatGen_new and
/// ng_par_finish call it on the main thread.
fn ng_emit_tables() {
    ng_isel_init();
    ng_fregs_init();
}

/// TG1: the compare kind of a SETCC / FCMP (i0) or a BRCC (i1).
fn ng_isel_cc(m: MInst) -> i64 {
    if m.op == MO_BRCC {
        return m.i1;
    }
    return m.i0;
}

/// TG1: how many 16-bit pieces of v are not `h` (0 or 0xFFFF).
fn ng_isel_pieces(v: i64, h: i64) -> i64 {
    var n: i64 = 0;
    var k: i64 = 0;
    while k < 4 {
        if ((v >> (k * 16)) & 0xFFFF) != h {
            n = n + 1;
        }
        k = k + 1;
    }
    return n;
}

/// Does precondition `pre` (with its operand parg) hold for operation m
/// with registers d, a, b (p0, p1, p2 as ng_mi_dispatch has them: a
/// store's base is d and its value a, a BRCC compares d with a)?
fn ng_isel_pre(g: &NatGen, pre: i64, parg: i64, m: MInst, d: i64, a: i64, b: i64) -> bool {
    var op: i64 = m.op;
    var imm: i64 = m.i0;
    if pre == NG_IP_ANY {
        return true;
    }
    if pre == NG_IP_D_IS_A {
        return d == a;
    }
    if pre == NG_IP_IMM_GE0 {
        return imm >= 0;
    }
    if pre == NG_IP_IMM_LT0 {
        return imm < 0;
    }
    if pre == NG_IP_ADDEND {
        return op == MO_ADD;
    }
    if pre == NG_IP_SUBTRA {
        return op == MO_SUB;
    }
    if pre == NG_IP_VW16 {
        return (imm >> 8) == 16;
    }
    if pre == NG_IP_VW32 {
        return (imm >> 8) == 32;
    }
    if pre == NG_IP_IMM_EQ {
        return imm == parg;
    }
    if pre == NG_IP_IMM_U32 {
        return imm > 0 && imm <= 4294967295;
    }
    if pre == NG_IP_IMM_S32 {
        return imm >= 0 - 2147483648 && imm <= 2147483647;
    }
    if pre == NG_IP_IMM_S12 {
        return rv_fits12(imm);
    }
    if pre == NG_IP_IMM_MOVZ {
        return ng_isel_pieces(imm, 0) <= 1;
    }
    if pre == NG_IP_IMM_MOVN {
        return ng_isel_pieces(imm, 0xFFFF) <= 1;
    }
    if pre == NG_IP_CC {
        return ng_isel_cc(m) == parg;
    }
    // the second operand of the compare: b of a SETCC, a of a BRCC
    var y: i64 = b;
    if op == MO_BRCC {
        y = a;
    }
    if pre == NG_IP_B_ZERO {
        return y == g.zr;
    }
    if pre == NG_IP_ZERO_CC {
        return y == g.zr && ng_isel_cc(m) == parg;
    }
    if pre == NG_IP_SHORT {
        return g.br_short;
    }
    if pre == NG_IP_FREG_MEM {
        var fr: i64 = d;
        if op == MO_STORE || op == MO_STX {
            fr = a;
        }
        return (m.i1 == 8 || m.i1 == 4) && ng_is_freg(g, fr);
    }
    if pre == NG_IP_A64_UIMM {
        return a64_ldst_fits(m.i1, m.i0);
    }
    if pre == NG_IP_DISP_S12 {
        return rv_fits12(m.i0);
    }
    if pre == NG_IP_INDEXED {
        var base: i64 = a;
        if op == MO_STX {
            base = d;
        }
        var ok: bool = ng_ldx_form_ok(g, m.i2 >> 1, m.i0, m.i1) && ng_ldx_regs_ok(g, base, b);
        if op == MO_STX && ng_a64(g) && a == 31 {
            // AArch64's 31 is xzr as a stored value only in the ADD form
            ok = false;
        }
        return ok;
    }
    if pre == NG_IP_FREG_OP {
        var f: bool = ng_is_freg(g, a) || ng_is_freg(g, b) || (m.i1 != 0 && ng_fregs_on(g));
        if op == MO_FBIN && ng_is_freg(g, d) {
            f = true;
        }
        return f;
    }
    if pre == NG_IP_SH_IDX {
        return imm <= 3 && b != 4;
    }
    if pre == NG_IP_SH_ZERO {
        return imm == 0;
    }
    if pre == NG_IP_SH_ZBA {
        return imm >= 1 && imm <= 3 && ng_rv_zb(g);
    }
    if pre == NG_IP_ZB_EXT {
        return imm == parg && ng_rv_zb(g);
    }
    if pre == NG_IP_FREG_D {
        return ng_is_freg(g, d);
    }
    if pre == NG_IP_FREG_A {
        return ng_is_freg(g, a);
    }
    if pre == NG_IP_BMI1 {
        return ng_x64_bmi1(g);
    }
    if pre == NG_IP_ZB {
        return ng_rv_zb(g);
    }
    if pre == NG_IP_ZICOND {
        return ng_rv_zicond(g);
    }
    if pre == NG_IP_D_IS_BASE {
        return d == b && d != a;
    }
    if pre == NG_IP_NOT_D_BASE {
        return !(d == b && d != a);
    }
    return false;
}

fn ng_isel_a64_rrr(g: &mut NatGen, which: i64, d: i64, a: i64, b: i64) {
    if which == NG_IR_ADD {
        a64_add(&mut g.e, d, a, b);
        return;
    }
    if which == NG_IR_SUB {
        a64_sub(&mut g.e, d, a, b);
        return;
    }
    if which == NG_IR_MUL {
        a64_mul(&mut g.e, d, a, b);
        g.e.mul_end = NatEnc_pos(&g.e);  // a following add may fold it (MADD)
        return;
    }
    if which == NG_IR_AND {
        a64_and(&mut g.e, d, a, b);
        return;
    }
    if which == NG_IR_OR {
        a64_orr(&mut g.e, d, a, b);
        return;
    }
    if which == NG_IR_XOR {
        a64_eor(&mut g.e, d, a, b);
        return;
    }
    if which == NG_IR_SHL {
        a64_lslv(&mut g.e, d, a, b);
        return;
    }
    if which == NG_IR_SAR {
        a64_asrv(&mut g.e, d, a, b);
        return;
    }
    a64_lsrv(&mut g.e, d, a, b);
}

fn ng_isel_rv_rrr(g: &mut NatGen, which: i64, d: i64, a: i64, b: i64) {
    if which == NG_IR_ADD {
        rv_add(&mut g.e, d, a, b);
        return;
    }
    if which == NG_IR_SUB {
        rv_sub(&mut g.e, d, a, b);
        return;
    }
    if which == NG_IR_MUL {
        rv_mul(&mut g.e, d, a, b);
        return;
    }
    if which == NG_IR_AND {
        rv_and(&mut g.e, d, a, b);
        return;
    }
    if which == NG_IR_OR {
        rv_or(&mut g.e, d, a, b);
        return;
    }
    if which == NG_IR_XOR {
        rv_xor(&mut g.e, d, a, b);
        return;
    }
    if which == NG_IR_SHL {
        rv_sll(&mut g.e, d, a, b);
        return;
    }
    if which == NG_IR_SAR {
        rv_sra(&mut g.e, d, a, b);
        return;
    }
    rv_srl(&mut g.e, d, a, b);
}

/// Emit `form` for operation m (registers d, a, b: p0, p1, p2); false
/// when it declines (NG_IF_A64_MADD, a vector form without its operands
/// in place).
@wrapping
fn ng_isel_emit(g: &mut NatGen, form: i64, arg: i64, m: MInst, d0: i64, a0: i64, b0: i64) -> bool {
    var op: i64 = m.op;
    var imm: i64 = m.i0;
    var d: i64 = d0;
    var a: i64 = a0;
    var b: i64 = b0;
    if g_ng_isel_mut && op == MO_SUB {
        // TG2 mutation: the operands the wrong way round
        a = b0;
        b = a0;
    }
    if g_ng_isel_mut_imm && (op == MO_LI || op == MO_ADDI || op == MO_SHI) {
        imm = imm + 1;
    }
    if form >= NG_IF_X64_F7RDX {
        return ng_isel_emit_tg1b(g, form, arg, m, d, a, b);
    }
    if form >= NG_IF_X64_LI_ZERO {
        return ng_isel_emit_tg1(g, form, arg, m, d, a, b, imm);
    }
    if form == NG_IF_X64_BIN {
        ng_x64_bin(g, arg, d, a, b);
        return true;
    }
    if form == NG_IF_X64_ADDIMM {
        if imm != 0 {
            x64_add_imm(&mut g.e, d, imm);
        }
        return true;
    }
    if form == NG_IF_X64_LEA {
        x64_lea(&mut g.e, d, a, imm);
        return true;
    }
    if form == NG_IF_A64_MADD {
        return ng_a64_mac(g, d, a, b, op == MO_SUB);
    }
    if form == NG_IF_A64_RRR {
        ng_isel_a64_rrr(g, arg, d, a, b);
        return true;
    }
    if form == NG_IF_A64_ADDIMM {
        a64_add_imm(&mut g.e, d, a, imm);
        return true;
    }
    if form == NG_IF_A64_SUBIMM {
        a64_sub_imm(&mut g.e, d, a, 0 - imm);
        return true;
    }
    if form == NG_IF_RV_RRR {
        ng_isel_rv_rrr(g, arg, d, a, b);
        return true;
    }
    if form == NG_IF_RV_ADDI {
        rv_addi(&mut g.e, d, a, imm);
        return true;
    }
    if form == NG_IF_X64_SSEV {
        if d != a {
            return false;
        }
        x64_vec(&mut g.e, imm & 255, d, b);
        return true;
    }
    if form == NG_IF_X64_AVXV {
        x64_vvec(&mut g.e, imm & 255, d, a, b, true);
        return true;
    }
    if form == NG_IF_A64_NEONV {
        a64_vec(&mut g.e, imm & 255, d, a, b);
        return true;
    }
    if form == NG_IF_RV_VV {
        ng_rv_vset(g);
        rv_vec(&mut g.e, imm & 255, d, a, b);
        return true;
    }
    return false;
}

/// TG1: select operation `op` (d, a, b, imm with physical registers) from
/// the table. False: no rule (the caller's hand-written selection runs),
/// the table is off, or the operation is being recorded.
fn ng_isel(g: &mut NatGen, op: i64, d: i64, a: i64, b: i64, imm: i64) -> bool {
    return ng_isel_mi(g, MInst {
        op: op, r0: d, r1: a, r2: b, i0: imm, i1: 0, i2: 0
    }, d, a, b);
}

/// TG1: the operations the selection table has rules for; ng_mi_dispatch
/// tries ng_isel_mi first for each (MO_VBIN goes through ng_vec_dispatch).
fn ng_isel_covers(op: i64) -> bool {
    if (op >= MO_ADD && op <= MO_SHR) || op == MO_ADDI || op == MO_LI || op == MO_SHI || op == MO_ADDSHL {
        return true;
    }
    if op == MO_SETCC || op == MO_BRCC || op == MO_FBIN || op == MO_FCMP {
        return true;
    }
    if op == MO_NEG || op == MO_NOT || op == MO_EXT {
        return true;
    }
    // TG1: the rest (ng_isel_rows_tg1b)
    if op == MO_DIV || op == MO_REM || op == MO_MULH || op == MO_ASR63 || op == MO_I2F || op == MO_F2I {
        return true;
    }
    if op == MO_ANDN || op == MO_BLSR || op == MO_CSEL || op == MO_TBNZ || op == MO_OPW || op == MO_ALUM {
        return true;
    }
    return op == MO_LOAD || op == MO_STORE || op == MO_LDX || op == MO_STX;
}

/// TG1: select MIR operation m, its register fields already physical (d,
/// a, b: p0, p1, p2), from the table: the rules of (arch, op) cheapest
/// first, the first whose precondition holds and whose form does not
/// decline. False: no rule applies (the hand-written selection runs), the
/// table is off, or the operation is being recorded.
fn ng_isel_mi(g: &mut NatGen, m: MInst, d: i64, a: i64, b: i64) -> bool {
    var op: i64 = m.op;
    // SP5: only reads: the state is set and the table built by
    // ng_isel_init (NatGen_new), so the emission's worker threads can run
    // this; a check that turns the table off sets the state to 2
    if g.rec || op < 0 || op >= 64 || g_ng_isel_state != 1 || g_ng_isel_ix.len() == 0 {
        return false;
    }
    var key: i64 = g.arch * 64 + op;
    if key < 0 || key >= g_ng_isel_ix.len() {
        return false;
    }
    var first: i64 = g_ng_isel_ix.get(key);
    if first == 0 {
        return false;
    }
    var n: i64 = g_ng_isel_n.get(key);
    var i: i64 = 0;
    while i < n {
        var at: i64 = (first - 1 + i) * NG_IS_W;
        if ng_isel_pre(g, g_ng_isel.get(at + 4), g_ng_isel.get(at + 6), m, d, a, b) {
            if ng_isel_emit(g, g_ng_isel.get(at + 2), g_ng_isel.get(at + 5), m, d, a, b) {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

/// TG1: the forms past the integer ALU (ng_isel_emit's codes from
/// NG_IF_X64_LI_ZERO on). imm is m.i0, after a TG2 mutation if one is on.
@wrapping
fn ng_isel_emit_tg1(g: &mut NatGen, form: i64, arg: i64, m: MInst, d: i64, a: i64, b: i64, imm: i64) -> bool {
    var op: i64 = m.op;
    // Constants (MO_LI: d = imm)
    if form == NG_IF_X64_LI_ZERO {
        x64_li_zero(&mut g.e, d);
        return true;
    }
    if form == NG_IF_X64_LI_U32 {
        x64_li_u32(&mut g.e, d, imm);
        return true;
    }
    if form == NG_IF_X64_LI_S32 {
        x64_li_s32(&mut g.e, d, imm);
        return true;
    }
    if form == NG_IF_X64_LI_ABS {
        x64_li_abs(&mut g.e, d, imm);
        return true;
    }
    if form == NG_IF_A64_MOVZ || form == NG_IF_A64_MOVN {
        // the one piece that is not all zeros (MOVZ) or all ones (MOVN)
        var other: i64 = 0;
        if form == NG_IF_A64_MOVN {
            other = 0xFFFF;
        }
        var h: i64 = other;
        var k: i64 = 0;
        var j: i64 = 0;
        while j < 4 {
            var piece: i64 = (imm >> (j * 16)) & 0xFFFF;
            if piece != other {
                h = piece;
                k = j;
            }
            j = j + 1;
        }
        if form == NG_IF_A64_MOVN {
            a64_movn_hw(&mut g.e, d, (~h) & 0xFFFF, k);
        } else {
            a64_movz_hw(&mut g.e, d, h, k);
        }
        return true;
    }
    if form == NG_IF_A64_LI_SEQ {
        a64_li(&mut g.e, d, imm);
        return true;
    }
    if form == NG_IF_RV_LI_ADDI {
        rv_addi(&mut g.e, d, RV_ZERO, imm);
        return true;
    }
    if form == NG_IF_RV_LI_LUI {
        // the sign-extended low 12 bits, and the 20 above them
        var lo: i64 = ((imm & 0xFFF) ^ 0x800) - 0x800;
        rv_lui(&mut g.e, d, (imm - lo) >> 12);
        rv_addiw(&mut g.e, d, d, lo);
        return true;
    }
    if form == NG_IF_RV_LI_SEQ {
        rv_li(&mut g.e, d, imm);
        return true;
    }
    // Shifts by a constant (MO_SHI: d = a shifted by imm, kind m.i1)
    var sc: i64 = imm & 63;
    if form == NG_IF_X64_SHI {
        // C1 /4 shl, /7 sar, /5 shr; a count of 0 is a move
        if d != a {
            x64_mov(&mut g.e, d, a);
        }
        if sc != 0 {
            var ext: i64 = 4;
            if m.i1 == 1 {
                ext = 7;
            }
            if m.i1 == 2 {
                ext = 5;
            }
            x64_shift_imm(&mut g.e, ext, d, sc);
        }
        return true;
    }
    if form == NG_IF_A64_SHI {
        a64_shift_imm(&mut g.e, m.i1, d, a, sc);
        return true;
    }
    if form == NG_IF_RV_SHI {
        if m.i1 == 0 {
            rv_slli(&mut g.e, d, a, sc);
        } else if m.i1 == 1 {
            rv_srai(&mut g.e, d, a, sc);
        } else {
            rv_srli(&mut g.e, d, a, sc);
        }
        return true;
    }
    // Element addresses (MO_ADDSHL: d = a + (b << imm))
    if form == NG_IF_X64_LEA_IDX {
        x64_lea_idx(&mut g.e, d, a, b, imm);
        return true;
    }
    if form == NG_IF_X64_ADDSHL_R11 {
        x64_mov(&mut g.e, 11, b);
        x64_shift_imm(&mut g.e, 4, 11, imm);
        x64_lea_idx(&mut g.e, d, a, 11, 0);
        return true;
    }
    if form == NG_IF_A64_ADD_LSL {
        a64_add_lsl(&mut g.e, d, a, b, imm);
        return true;
    }
    if form == NG_IF_RV_SHADD {
        rv_shadd(&mut g.e, d, a, b, imm);
        return true;
    }
    if form == NG_IF_RV_SLLI_ADD {
        rv_slli(&mut g.e, g.ad2, b, imm);
        rv_add(&mut g.e, d, a, g.ad2);
        return true;
    }
    // Compares
    var cc: i64 = ng_isel_cc(m);
    var carg: i64 = arg;
    if g_ng_isel_mut_cc && (op == MO_SETCC || op == MO_BRCC) {
        // TG2 mutation: the inverse condition
        cc = ng_cc_inverse(cc);
        if form == NG_IF_RV_SLT {
            carg = arg ^ 4;
        }
        if form == NG_IF_RV_EQNE || form == NG_IF_A64_CBZ {
            carg = arg ^ 1;
        }
    }
    if form == NG_IF_X64_SETCC {
        if carg == 1 {
            x64_test(&mut g.e, a, a);
        } else {
            x64_alu(&mut g.e, 0x39, a, b);
        }
        x64_setcc(&mut g.e, ng_x64_cc(cc), 11);
        x64_movx(&mut g.e, 0xB6, d, 11);
        return true;
    }
    if form == NG_IF_A64_CSET {
        a64_cmp(&mut g.e, a, b);
        a64_cset(&mut g.e, d, ng_a64_cc(cc));
        return true;
    }
    if form == NG_IF_RV_EQNE {
        rv_sub(&mut g.e, d, a, b);
        if carg == 0 {
            rv_sltiu(&mut g.e, d, d, 1);
        } else {
            rv_sltu(&mut g.e, d, RV_ZERO, d);
        }
        return true;
    }
    if form == NG_IF_RV_SLT {
        var x: i64 = a;
        var y: i64 = b;
        if (carg & 1) != 0 {
            x = b;
            y = a;
        }
        if (carg & 2) != 0 {
            rv_sltu(&mut g.e, d, x, y);
        } else {
            rv_slt(&mut g.e, d, x, y);
        }
        if (carg & 4) != 0 {
            rv_xori(&mut g.e, d, d, 1);
        }
        return true;
    }
    // Compares and branches (MO_BRCC: d cc a, to label m.i0)
    var label: i64 = m.i0;
    if form == NG_IF_X64_JCC {
        if carg == 1 {
            x64_test(&mut g.e, d, d);
        } else {
            x64_alu(&mut g.e, 0x39, d, a);
        }
        if g.br_short {
            x64_jcc_short(&mut g.e, ng_x64_cc(cc), label);
        } else {
            x64_jcc(&mut g.e, ng_x64_cc(cc), label);
        }
        return true;
    }
    if form == NG_IF_A64_CBZ {
        if carg == 0 {
            a64_cbz(&mut g.e, d, label);
        } else {
            a64_cbnz(&mut g.e, d, label);
        }
        return true;
    }
    if form == NG_IF_A64_BCOND {
        a64_cmp(&mut g.e, d, a);
        a64_bcond(&mut g.e, ng_a64_cc(cc), label);
        return true;
    }
    if form == NG_IF_RV_BCC {
        if carg == 0 {
            if ng_rv_swaps(cc) {
                rv_b_label(&mut g.e, ng_rv_f3(cc), a, d, label);
            } else {
                rv_b_label(&mut g.e, ng_rv_f3(cc), d, a, label);
            }
            return true;
        }
        var inv: i64 = ng_cc_inverse(cc);
        if ng_rv_swaps(inv) {
            rv_b_off(&mut g.e, ng_rv_f3(inv), a, d, 8);
        } else {
            rv_b_off(&mut g.e, ng_rv_f3(inv), d, a, 8);
        }
        rv_jal(&mut g.e, RV_ZERO, label);
        return true;
    }
    if form >= NG_IF_FMEM && form <= NG_IF_MEM_ADDSHL {
        return ng_isel_emit_mem(g, form, m, d, a, b);
    }
    if form >= NG_IF_X64_F7 {
        return ng_isel_emit_unary(g, form, arg, d, a);
    }
    return ng_isel_emit_float(g, form, arg, m, d, a, b);
}

/// TG1: the forms of the operations the hand-written selection kept to
/// itself before (ng_isel_emit's codes from NG_IF_X64_F7RDX on): division,
/// remainder, the high half of a product, the sign mask, the conversions,
/// the fused bit operations, the conditional select, test-bit-and-branch,
/// RISC-V's 32-bit operations and x86-64's memory-operand ALU. Each emits
/// what the hand-written ng_div .. ng_x64_alum emit for its target and
/// case, byte for byte (nat_isel_tg1b_check, FID_VERIFY=1).
@wrapping
fn ng_isel_emit_tg1b(g: &mut NatGen, form: i64, arg0: i64, m: MInst, d: i64, a: i64, b: i64) -> bool {
    var arg: i64 = arg0;
    if g_ng_isel_mut_div {
        // TG1 mutation (FID_NAT_MUTATE=iseldiv): the other result register
        // or the other signedness
        if form == NG_IF_X64_F7RDX {
            arg = arg ^ (2 << 4);
        }
        if form == NG_IF_A64_DIVMUL || form == NG_IF_A64_REM || form == NG_IF_RV_MULDIV {
            arg = arg ^ 1;
        }
    }
    // Division, remainder, high product (d = a op b)
    if form == NG_IF_X64_F7RDX {
        // the divisor or multiplier in r11, the dividend in rax
        x64_mov(&mut g.e, 11, b);
        x64_mov(&mut g.e, 0, a);
        var prep: i64 = (arg >> 8) & 3;
        if prep == 1 {
            x64_cqo(&mut g.e);
        } else if prep == 2 {
            x64_li(&mut g.e, 2, 0);
        }
        x64_f7(&mut g.e, arg & 15, 11);
        x64_mov(&mut g.e, d, (arg >> 4) & 15);
        return true;
    }
    if form == NG_IF_A64_DIVMUL {
        if arg == 0 {
            a64_sdiv(&mut g.e, d, a, b);
        }
        if arg == 1 {
            a64_udiv(&mut g.e, d, a, b);
        }
        if arg == 2 {
            a64_smulh(&mut g.e, d, a, b);
        }
        if arg == 3 {
            a64_umulh(&mut g.e, d, a, b);
        }
        return true;
    }
    if form == NG_IF_A64_REM {
        if arg == 0 {
            a64_sdiv(&mut g.e, g.ad2, a, b);
        } else {
            a64_udiv(&mut g.e, g.ad2, a, b);
        }
        a64_msub(&mut g.e, d, g.ad2, b, a);
        return true;
    }
    if form == NG_IF_RV_MULDIV {
        if arg == 0 {
            rv_div(&mut g.e, d, a, b);
        }
        if arg == 1 {
            rv_divu(&mut g.e, d, a, b);
        }
        if arg == 2 {
            rv_rem(&mut g.e, d, a, b);
        }
        if arg == 3 {
            rv_remu(&mut g.e, d, a, b);
        }
        if arg == 4 {
            rv_mulh(&mut g.e, d, a, b);
        }
        if arg == 5 {
            rv_mulhu(&mut g.e, d, a, b);
        }
        return true;
    }
    // The sign mask (d = a >> 63)
    if form == NG_IF_X64_ASR63 {
        if d != a {
            x64_mov(&mut g.e, d, a);
        }
        x64_shift_imm(&mut g.e, 7, d, 63);
        return true;
    }
    if form == NG_IF_A64_ASR63 {
        a64_asr63(&mut g.e, d, a);
        return true;
    }
    if form == NG_IF_RV_ASR63 {
        rv_srai(&mut g.e, d, a, 63);
        return true;
    }
    // Conversions (i0 != 0: the float is an f32)
    var w32: bool = m.i0 != 0;
    if form == NG_IF_I2F_FREG {
        ng_i2f_fr(g, d, a, w32);
        return true;
    }
    if form == NG_IF_X64_I2F {
        x64_cvtsi2sd(&mut g.e, 0, a);
        ng_x64_fstore0(g, d, w32);
        return true;
    }
    if form == NG_IF_A64_I2F {
        a64_scvtf(&mut g.e, 0, a);
        ng_fstore0(g, d, w32);
        return true;
    }
    if form == NG_IF_RV_I2F {
        rv_fcvt_dl(&mut g.e, 0, a);
        ng_fstore0(g, d, w32);
        return true;
    }
    if form == NG_IF_F2I_FREG {
        ng_f2i_fr(g, d, a, w32);
        return true;
    }
    if form == NG_IF_X64_F2I {
        // xmm0 may already hold a's bits (FID_NAT_OFF=xmmcache: never)
        var cache: bool = ng_on("xmmcache");
        if w32 {
            x64_movq_xr(&mut g.e, 0, a, false);
            x64_sse(&mut g.e, 0xF3, 0x5A, 0, 0);
            g.x0_reg = 0 - 1;
        } else if g.x0_reg != a || !cache {
            x64_movq_xr(&mut g.e, 0, a, true);
            g.x0_reg = a;
        }
        if !cache {
            g.x0_reg = 0 - 1;
        }
        x64_cvttsd2si(&mut g.e, d, 0);
        if g.x0_reg == d {
            g.x0_reg = 0 - 1;
        }
        if g.x1_reg == d {
            g.x1_reg = 0 - 1;
        }
        return true;
    }
    if form == NG_IF_A64_F2I {
        if w32 {
            a64_fmov_sw(&mut g.e, 0, a);
            a64_fcvt_ds(&mut g.e, 0, 0);
        } else {
            a64_fmov_dx(&mut g.e, 0, a);
        }
        a64_fcvtzs(&mut g.e, d, 0);
        return true;
    }
    if form == NG_IF_RV_F2I {
        if w32 {
            rv_fmv_wx(&mut g.e, 0, a);
            rv_fcvt_ds(&mut g.e, 0, 0);
        } else {
            rv_fmv_dx(&mut g.e, 0, a);
        }
        rv_fcvt_ld(&mut g.e, d, 0);
        return true;
    }
    // AND NOT (d = ~a & b)
    if form == NG_IF_X64_ANDN {
        x64_andn(&mut g.e, d, a, b);
        return true;
    }
    if form == NG_IF_X64_ANDN_R11 {
        x64_mov(&mut g.e, 11, a);
        x64_f7(&mut g.e, 2, 11);
        x64_alu(&mut g.e, 0x21, 11, b);
        x64_mov(&mut g.e, d, 11);
        return true;
    }
    if form == NG_IF_A64_BIC {
        a64_bic(&mut g.e, d, b, a);
        return true;
    }
    if form == NG_IF_RV_ANDN {
        rv_andn(&mut g.e, d, b, a);
        return true;
    }
    if form == NG_IF_RV_ANDN_AD2 {
        rv_xori(&mut g.e, g.ad2, a, 0 - 1);
        rv_and(&mut g.e, d, g.ad2, b);
        return true;
    }
    // The lowest set bit (MO_BLSR kind i0)
    var kind: i64 = m.i0;
    if form == NG_IF_X64_BLSX {
        if kind == 1 {
            x64_blsmsk(&mut g.e, d, a);
        } else if kind == 2 {
            x64_blsi(&mut g.e, d, a);
        } else {
            x64_blsr(&mut g.e, d, a);
        }
        return true;
    }
    if form == NG_IF_X64_BLSX_R11 {
        // r11 = -a, then ~(-a) = a - 1 unless BLSI
        x64_mov(&mut g.e, 11, a);
        x64_f7(&mut g.e, 3, 11);
        if kind != 2 {
            x64_f7(&mut g.e, 2, 11);
        }
        if d != a {
            x64_mov(&mut g.e, d, a);
        }
        if kind == 1 {
            x64_alu(&mut g.e, 0x31, d, 11);
        } else {
            x64_alu(&mut g.e, 0x21, d, 11);
        }
        return true;
    }
    if form == NG_IF_A64_BLSX {
        a64_neg(&mut g.e, g.ad2, a);
        if kind != 2 {
            a64_mvn(&mut g.e, g.ad2, g.ad2);
        }
        if kind == 1 {
            a64_eor(&mut g.e, d, a, g.ad2);
        } else {
            a64_and(&mut g.e, d, a, g.ad2);
        }
        return true;
    }
    if form == NG_IF_RV_BLSX {
        if kind == 2 {
            rv_sub(&mut g.e, g.ad2, RV_ZERO, a);
        } else {
            rv_addi(&mut g.e, g.ad2, a, 0 - 1);
        }
        if kind == 1 {
            rv_xor(&mut g.e, d, a, g.ad2);
        } else {
            rv_and(&mut g.e, d, a, g.ad2);
        }
        return true;
    }
    // Conditional select (d = a ? b : d; i0 1: the inverse): nothing to
    // do when d is b
    var inv: bool = m.i0 != 0;
    if form >= NG_IF_X64_CMOV && form <= NG_IF_RV_CSEL_BR && d == b {
        return true;
    }
    if form == NG_IF_X64_CMOV {
        x64_test(&mut g.e, a, a);
        if inv {
            x64_cmov(&mut g.e, X64_E, d, b);
        } else {
            x64_cmov(&mut g.e, X64_NE, d, b);
        }
        return true;
    }
    if form == NG_IF_A64_CSEL {
        a64_cmp(&mut g.e, a, A64_ZR);
        if inv {
            a64_csel(&mut g.e, d, b, d, A64_EQ);
        } else {
            a64_csel(&mut g.e, d, b, d, A64_NE);
        }
        return true;
    }
    if form == NG_IF_RV_CZERO {
        if inv {
            rv_czero_nez(&mut g.e, g.ad2, b, a);
            rv_czero_eqz(&mut g.e, d, d, a);
        } else {
            rv_czero_eqz(&mut g.e, g.ad2, b, a);
            rv_czero_nez(&mut g.e, d, d, a);
        }
        rv_or(&mut g.e, d, d, g.ad2);
        return true;
    }
    if form == NG_IF_RV_CSEL_BR {
        // the branch skips a fixed 4 bytes: no label, no relaxation
        if inv {
            rv_b_off(&mut g.e, RV_BNE, a, RV_ZERO, 8);
        } else {
            rv_b_off(&mut g.e, RV_BEQ, a, RV_ZERO, 8);
        }
        rv_addi(&mut g.e, d, b, 0);
        return true;
    }
    // Test a bit and branch (bit i1 of d; i2 != 0: when clear; label i0)
    var bit: i64 = m.i1;
    var clear: bool = m.i2 != 0;
    var label: i64 = m.i0;
    if form == NG_IF_X64_TBNZ {
        x64_test_bit(&mut g.e, d, bit);
        var cc: i64 = x64_bit_cc(bit);
        if clear {
            cc = cc ^ 1;
        }
        if g.br_short {
            x64_jcc_short(&mut g.e, cc, label);
        } else {
            x64_jcc(&mut g.e, cc, label);
        }
        return true;
    }
    if form == NG_IF_A64_TBZ {
        a64_tbz_label(&mut g.e, d, bit, !clear, label);
        return true;
    }
    if form == NG_IF_A64_TBZ_B {
        a64_tbz_words(&mut g.e, d, bit, clear, 2);
        a64_b(&mut g.e, label);
        return true;
    }
    if form == NG_IF_RV_TBZ {
        // the bit moved to the sign of ad2 (bit 63 is the sign already)
        var src: i64 = d;
        if bit != 63 {
            rv_slli(&mut g.e, g.ad2, d, 63 - bit);
            src = g.ad2;
        }
        var f3: i64 = RV_BLT;
        var finv: i64 = RV_BGE;
        if clear {
            f3 = RV_BGE;
            finv = RV_BLT;
        }
        if arg == 0 {
            rv_b_label(&mut g.e, f3, src, RV_ZERO, label);
        } else {
            rv_b_off(&mut g.e, finv, src, RV_ZERO, 8);
            rv_jal(&mut g.e, RV_ZERO, label);
        }
        return true;
    }
    // RISC-V's 32-bit operations (op i0: 0 add, 1 sub, 2 mul)
    if form == NG_IF_RV_OPW {
        if m.i0 == 0 {
            rv_addw(&mut g.e, d, a, b);
        } else if m.i0 == 1 {
            rv_subw(&mut g.e, d, a, b);
        } else {
            rv_mulw(&mut g.e, d, a, b);
        }
        return true;
    }
    // x86-64's ALU operation with a memory operand (d = a op [b + i0],
    // kind i1)
    if form == NG_IF_X64_ALUM || form == NG_IF_X64_ALUM_AD2 {
        var code: i64 = ng_x64_alum_code(m.i1);
        if ng_mutant("ldop") {
            // TG2: the wrong operation, on purpose (as ng_x64_alum)
            if code == 0x03 {
                code = 0x2B;
            } else {
                code = 0x03;
            }
        }
        if form == NG_IF_X64_ALUM_AD2 {
            x64_mov(&mut g.e, g.ad2, a);
            x64_alu_mem(&mut g.e, code, g.ad2, b, m.i0);
            x64_mov(&mut g.e, d, g.ad2);
            return true;
        }
        if d != a {
            x64_mov(&mut g.e, d, a);
        }
        x64_alu_mem(&mut g.e, code, d, b, m.i0);
        return true;
    }
    return false;
}

/// TG1: negation, complement and the extensions (d = op a).
fn ng_isel_emit_unary(g: &mut NatGen, form: i64, arg: i64, d: i64, a: i64) -> bool {
    if form == NG_IF_X64_F7 {
        if d != a {
            x64_mov(&mut g.e, d, a);
        }
        x64_f7(&mut g.e, arg, d);
        return true;
    }
    if form == NG_IF_A64_NEG {
        a64_neg(&mut g.e, d, a);
        return true;
    }
    if form == NG_IF_A64_MVN {
        a64_mvn(&mut g.e, d, a);
        return true;
    }
    if form == NG_IF_RV_NEG {
        rv_sub(&mut g.e, d, RV_ZERO, a);
        return true;
    }
    if form == NG_IF_RV_NOT {
        rv_xori(&mut g.e, d, a, 0 - 1);
        return true;
    }
    if form == NG_IF_X64_EXT {
        if arg == 0 {
            x64_mov32(&mut g.e, d, a);
        } else {
            x64_movx(&mut g.e, arg, d, a);
        }
        return true;
    }
    if form == NG_IF_A64_EXT {
        if arg == NEXT_SB {
            a64_sxtb(&mut g.e, d, a);
        }
        if arg == NEXT_SH {
            a64_sxth(&mut g.e, d, a);
        }
        if arg == NEXT_SW {
            a64_sxtw(&mut g.e, d, a);
        }
        if arg == NEXT_ZB {
            a64_uxtb(&mut g.e, d, a);
        }
        if arg == NEXT_ZH {
            a64_uxth(&mut g.e, d, a);
        }
        if arg == NEXT_ZW {
            a64_uxtw(&mut g.e, d, a);
        }
        return true;
    }
    if form == NG_IF_RV_EXT1 {
        if arg == NEXT_SB {
            rv_sext_b(&mut g.e, d, a);
        }
        if arg == NEXT_SH {
            rv_sext_h(&mut g.e, d, a);
        }
        if arg == NEXT_SW {
            rv_addiw(&mut g.e, d, a, 0);
        }
        if arg == NEXT_ZB {
            rv_andi(&mut g.e, d, a, 255);
        }
        if arg == NEXT_ZH {
            rv_zext_h(&mut g.e, d, a);
        }
        if arg == NEXT_ZW {
            rv_zext_w(&mut g.e, d, a);
        }
        return true;
    }
    if form == NG_IF_RV_EXT2 {
        val sh: i64 = arg & 255;
        rv_slli(&mut g.e, d, a, sh);
        if (arg & 256) != 0 {
            rv_srai(&mut g.e, d, d, sh);
        } else {
            rv_srli(&mut g.e, d, d, sh);
        }
        return true;
    }
    return false;
}

/// TG1: the load and store forms. MO_LOAD d = [a + i0]; MO_STORE [d + i0]
/// = a; MO_LDX d = [a + (b << sh) + i0]; MO_STX [d + (b << sh) + i0] = a
/// (sh = i2 >> 1); i1 bytes, a load signed when i2 & 1.
fn ng_isel_emit_mem(g: &mut NatGen, form: i64, m: MInst, d: i64, a: i64, b: i64) -> bool {
    var op: i64 = m.op;
    var disp: i64 = m.i0;
    var size: i64 = m.i1;
    var signed: bool = (m.i2 & 1) != 0;
    var load: bool = op == MO_LOAD || op == MO_LDX;
    // the register loaded or stored, and the base
    var r: i64 = d;
    var base: i64 = a;
    if !load {
        r = a;
        base = d;
    }
    if op == MO_LOAD || op == MO_STORE {
        signed = load && m.i2 != 0;
    }
    if form == NG_IF_FMEM {
        ng_fmem(g, !load, r - NG_FREG, base, disp, size == 4);
        return true;
    }
    if form == NG_IF_X64_MEM {
        if load {
            x64_load(&mut g.e, r, base, disp, size, signed);
        } else {
            x64_store(&mut g.e, r, base, disp, size);
        }
        return true;
    }
    if form == NG_IF_A64_MEM_UIMM || form == NG_IF_A64_MEM_REG {
        var at: i64 = base;
        var off: i64 = disp;
        if form == NG_IF_A64_MEM_REG {
            a64_li(&mut g.e, g.ad2, disp);
            a64_add_base(&mut g.e, g.ad2, base, g.ad2);
            at = g.ad2;
            off = 0;
        }
        if load {
            a64_ldr_sized(&mut g.e, r, at, off, size, signed);
        } else {
            a64_str_sized(&mut g.e, r, at, off, size);
        }
        return true;
    }
    if form == NG_IF_RV_MEM_IMM || form == NG_IF_RV_MEM_REG {
        var rat: i64 = base;
        var roff: i64 = disp;
        if form == NG_IF_RV_MEM_REG {
            rv_li(&mut g.e, g.ad2, disp);
            rv_add(&mut g.e, g.ad2, base, g.ad2);
            rat = g.ad2;
            roff = 0;
        }
        if load {
            rv_load(&mut g.e, r, rat, roff, size, signed);
        } else {
            rv_store(&mut g.e, r, rat, roff, size);
        }
        return true;
    }
    var sh: i64 = m.i2 >> 1;
    if form == NG_IF_X64_MEM_SIB {
        if load {
            x64_load_idx(&mut g.e, r, base, b, sh, disp, size, signed);
        } else {
            x64_store_idx(&mut g.e, r, base, b, sh, disp, size);
        }
        return true;
    }
    if form == NG_IF_A64_MEM_ROFF {
        if load {
            a64_ldr_roff(&mut g.e, r, base, b, size, signed, sh != 0);
        } else {
            a64_str_roff(&mut g.e, r, base, b, size, sh != 0);
        }
        return true;
    }
    if form == NG_IF_MEM_ADDSHL {
        // the element address into ad (it never holds a value), then the
        // access at ad + disp: each selected again (table or hand-written)
        ng_mi_dispatch(g, MInst {
            op: MO_ADDSHL, r0: g.ad, r1: base, r2: b, i0: sh, i1: 0, i2: 0
        }, g.ad, base, b);
        if load {
            var lsg: i64 = 0;
            if signed {
                lsg = 1;
            }
            ng_mi_dispatch(g, MInst {
                op: MO_LOAD, r0: r, r1: g.ad, r2: 0, i0: disp, i1: size, i2: lsg
            }, r, g.ad, 0);
        } else {
            ng_mi_dispatch(g, MInst {
                op: MO_STORE, r0: g.ad, r1: r, r2: 0, i0: disp, i1: size, i2: 0
            }, g.ad, r, 0);
        }
        return true;
    }
    return false;
}

/// TG1: the float forms. MO_FBIN d = a op b (op i0: 1 add, 2 sub, 3 mul,
/// 4 div); MO_FCMP d = (a cc b) (cc i0); i1 != 0: f32.
fn ng_isel_emit_float(g: &mut NatGen, form: i64, arg: i64, m: MInst, d: i64, a: i64, b: i64) -> bool {
    var is32: bool = m.i1 != 0;
    var fop: i64 = m.i0;
    if form == NG_IF_F_FREG {
        if m.op == MO_FBIN {
            ng_fbin_fr(g, fop, d, a, b, is32);
        } else {
            ng_fcmp_fr(g, d, a, b, fop, is32);
        }
        return true;
    }
    if form == NG_IF_X64_FBIN {
        ng_x64_fload2(g, a, b, is32);
        var fo: i64 = 0x58;
        if fop == 2 {
            fo = 0x5C;
        }
        if fop == 3 {
            fo = 0x59;
        }
        if fop == 4 {
            fo = 0x5E;
        }
        x64_sse(&mut g.e, 0xF2, fo, 0, 1);
        ng_x64_fstore0(g, d, is32);
        return true;
    }
    if form == NG_IF_A64_FBIN {
        ng_fload2(g, a, b, is32);
        if fop == 1 {
            a64_fadd(&mut g.e, 0, 0, 1);
        }
        if fop == 2 {
            a64_fsub(&mut g.e, 0, 0, 1);
        }
        if fop == 3 {
            a64_fmul(&mut g.e, 0, 0, 1);
        }
        if fop == 4 {
            a64_fdiv(&mut g.e, 0, 0, 1);
        }
        ng_fstore0(g, d, is32);
        return true;
    }
    if form == NG_IF_RV_FBIN {
        ng_fload2(g, a, b, is32);
        if fop == 1 {
            rv_fadd_d(&mut g.e, 0, 0, 1);
        }
        if fop == 2 {
            rv_fsub_d(&mut g.e, 0, 0, 1);
        }
        if fop == 3 {
            rv_fmul_d(&mut g.e, 0, 0, 1);
        }
        if fop == 4 {
            rv_fdiv_d(&mut g.e, 0, 0, 1);
        }
        ng_fstore0(g, d, is32);
        return true;
    }
    var cc: i64 = m.i0;
    if form == NG_IF_X64_FCMP_EQ {
        // ucomisd: equal is ZF without PF (unordered sets both)
        ng_x64_fload2(g, a, b, is32);
        x64_sse(&mut g.e, 0x66, 0x2E, 0, 1);
        if arg == 0 {
            x64_setcc(&mut g.e, X64_E, 11);
            x64_setcc(&mut g.e, X64_NP, 10);
        } else {
            x64_setcc(&mut g.e, X64_NE, 11);
            x64_setcc(&mut g.e, X64_P, 10);
        }
        x64_movx(&mut g.e, 0xB6, 11, 11);
        x64_movx(&mut g.e, 0xB6, 10, 10);
        if arg == 0 {
            x64_alu(&mut g.e, 0x21, 11, 10);
        } else {
            x64_alu(&mut g.e, 0x09, 11, 10);
        }
        x64_mov(&mut g.e, d, 11);
        return true;
    }
    if form == NG_IF_X64_FCMP_ORD {
        // a < b as b > a: "above" is false when unordered
        ng_x64_fload2(g, a, b, is32);
        if cc == NCC_LT || cc == NCC_LE {
            x64_sse(&mut g.e, 0x66, 0x2E, 1, 0);
        } else {
            x64_sse(&mut g.e, 0x66, 0x2E, 0, 1);
        }
        if cc == NCC_LT || cc == NCC_GT {
            x64_setcc(&mut g.e, X64_A, 11);
        } else {
            x64_setcc(&mut g.e, X64_AE, 11);
        }
        x64_movx(&mut g.e, 0xB6, d, 11);
        return true;
    }
    if form == NG_IF_A64_FCMP {
        ng_fload2(g, a, b, is32);
        a64_fcmp(&mut g.e, 0, 1);
        var c: i64 = A64_EQ;
        if cc == NCC_NE {
            c = A64_NE;
        }
        if cc == NCC_LT {
            c = A64_MI;
        }
        if cc == NCC_LE {
            c = A64_LS;
        }
        if cc == NCC_GT {
            c = A64_GT;
        }
        if cc == NCC_GE {
            c = A64_GE;
        }
        a64_cset(&mut g.e, d, c);
        return true;
    }
    if form == NG_IF_RV_FCMP {
        ng_fload2(g, a, b, is32);
        if cc == NCC_EQ {
            rv_feq_d(&mut g.e, d, 0, 1);
        } else if cc == NCC_NE {
            rv_feq_d(&mut g.e, d, 0, 1);
            rv_xori(&mut g.e, d, d, 1);
        } else if cc == NCC_LT {
            rv_flt_d(&mut g.e, d, 0, 1);
        } else if cc == NCC_LE {
            rv_fle_d(&mut g.e, d, 0, 1);
        } else if cc == NCC_GT {
            rv_flt_d(&mut g.e, d, 1, 0);
        } else {
            rv_fle_d(&mut g.e, d, 1, 0);
        }
        return true;
    }
    return false;
}

fn ng_neg(g: &mut NatGen, d: i64, a: i64) {
    if g.rec {
        ng_rec(g, MO_NEG, d, a, 0, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        if d != a {
            x64_mov(&mut g.e, d, a);
        }
        x64_f7(&mut g.e, 3, d);
        return;
    }
    if ng_a64(g) {
        a64_neg(&mut g.e, d, a);
    } else {
        rv_sub(&mut g.e, d, RV_ZERO, a);
    }
}

fn ng_not_bits(g: &mut NatGen, d: i64, a: i64) {
    if g.rec {
        ng_rec(g, MO_NOT, d, a, 0, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        if d != a {
            x64_mov(&mut g.e, d, a);
        }
        x64_f7(&mut g.e, 2, d);
        return;
    }
    if ng_a64(g) {
        a64_mvn(&mut g.e, d, a);
    } else {
        rv_xori(&mut g.e, d, a, 0 - 1);
    }
}

/// d = a / b (b != 0; MIN / -1 handled by the caller)
fn ng_div(g: &mut NatGen, d: i64, a: i64, b: i64, unsigned: bool) {
    if g.rec {
        var u: i64 = 0;
        if unsigned {
            u = 1;
        }
        ng_rec(g, MO_DIV, d, a, b, u, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_mov(&mut g.e, 11, b);
        x64_mov(&mut g.e, 0, a);
        if unsigned {
            x64_li(&mut g.e, 2, 0);
            x64_f7(&mut g.e, 6, 11);
        } else {
            x64_cqo(&mut g.e);
            x64_f7(&mut g.e, 7, 11);
        }
        x64_mov(&mut g.e, d, 0);
        return;
    }
    if ng_a64(g) {
        if unsigned {
            a64_udiv(&mut g.e, d, a, b);
        } else {
            a64_sdiv(&mut g.e, d, a, b);
        }
    } else {
        if unsigned {
            rv_divu(&mut g.e, d, a, b);
        } else {
            rv_div(&mut g.e, d, a, b);
        }
    }
}

/// d = a % b (b != 0); d must differ from a and b on AArch64 (it uses ad2)
fn ng_rem(g: &mut NatGen, d: i64, a: i64, b: i64, unsigned: bool) {
    if g.rec {
        var u: i64 = 0;
        if unsigned {
            u = 1;
        }
        ng_rec(g, MO_REM, d, a, b, u, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_mov(&mut g.e, 11, b);
        x64_mov(&mut g.e, 0, a);
        if unsigned {
            x64_li(&mut g.e, 2, 0);
            x64_f7(&mut g.e, 6, 11);
        } else {
            x64_cqo(&mut g.e);
            x64_f7(&mut g.e, 7, 11);
        }
        x64_mov(&mut g.e, d, 2);
        return;
    }
    if ng_a64(g) {
        if unsigned {
            a64_udiv(&mut g.e, g.ad2, a, b);
        } else {
            a64_sdiv(&mut g.e, g.ad2, a, b);
        }
        a64_msub(&mut g.e, d, g.ad2, b, a);
    } else {
        if unsigned {
            rv_remu(&mut g.e, d, a, b);
        } else {
            rv_rem(&mut g.e, d, a, b);
        }
    }
}

/// d = the high 64 bits of a * b
fn ng_mulh(g: &mut NatGen, d: i64, a: i64, b: i64, unsigned: bool) {
    if g.rec {
        var u: i64 = 0;
        if unsigned {
            u = 1;
        }
        ng_rec(g, MO_MULH, d, a, b, u, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_mov(&mut g.e, 11, b);
        x64_mov(&mut g.e, 0, a);
        if unsigned {
            x64_f7(&mut g.e, 4, 11);
        } else {
            x64_f7(&mut g.e, 5, 11);
        }
        x64_mov(&mut g.e, d, 2);
        return;
    }
    if ng_a64(g) {
        if unsigned {
            a64_umulh(&mut g.e, d, a, b);
        } else {
            a64_smulh(&mut g.e, d, a, b);
        }
    } else {
        if unsigned {
            rv_mulhu(&mut g.e, d, a, b);
        } else {
            rv_mulh(&mut g.e, d, a, b);
        }
    }
}

/// d = (a cc b) as 0 / 1
fn ng_setcc(g: &mut NatGen, d: i64, a: i64, b: i64, cc: i64) {
    if g.rec {
        ng_rec(g, MO_SETCC, d, a, b, cc, 0, 0);
        return;
    }
    if ng_x64(g) {
        if b == 60 {
            x64_test(&mut g.e, a, a);
        } else {
            x64_alu(&mut g.e, 0x39, a, b);
        }
        x64_setcc(&mut g.e, ng_x64_cc(cc), 11);
        x64_movx(&mut g.e, 0xB6, d, 11);
        return;
    }
    if ng_a64(g) {
        a64_cmp(&mut g.e, a, b);
        a64_cset(&mut g.e, d, ng_a64_cc(cc));
    } else {
        if cc == NCC_EQ {
            rv_sub(&mut g.e, d, a, b);
            rv_sltiu(&mut g.e, d, d, 1);
        } else if cc == NCC_NE {
            rv_sub(&mut g.e, d, a, b);
            rv_sltu(&mut g.e, d, RV_ZERO, d);
        } else if cc == NCC_LT {
            rv_slt(&mut g.e, d, a, b);
        } else if cc == NCC_GT {
            rv_slt(&mut g.e, d, b, a);
        } else if cc == NCC_LE {
            rv_slt(&mut g.e, d, b, a);
            rv_xori(&mut g.e, d, d, 1);
        } else if cc == NCC_GE {
            rv_slt(&mut g.e, d, a, b);
            rv_xori(&mut g.e, d, d, 1);
        } else if cc == NCC_LTU {
            rv_sltu(&mut g.e, d, a, b);
        } else if cc == NCC_GTU {
            rv_sltu(&mut g.e, d, b, a);
        } else if cc == NCC_LEU {
            rv_sltu(&mut g.e, d, b, a);
            rv_xori(&mut g.e, d, d, 1);
        } else {
            rv_sltu(&mut g.e, d, a, b);
            rv_xori(&mut g.e, d, d, 1);
        }
    }
}

/// d = s extended from its low bits (`kind`: NEXT_*)
fn ng_ext(g: &mut NatGen, d: i64, s: i64, kind: i64) {
    if g.rec {
        ng_rec(g, MO_EXT, d, s, 0, kind, 0, 0);
        return;
    }
    if ng_x64(g) {
        if kind == NEXT_SB {
            x64_movx(&mut g.e, 0xBE, d, s);
        }
        if kind == NEXT_SH {
            x64_movx(&mut g.e, 0xBF, d, s);
        }
        if kind == NEXT_SW {
            x64_movx(&mut g.e, 0x63, d, s);
        }
        if kind == NEXT_ZB {
            x64_movx(&mut g.e, 0xB6, d, s);
        }
        if kind == NEXT_ZH {
            x64_movx(&mut g.e, 0xB7, d, s);
        }
        if kind == NEXT_ZW {
            x64_mov32(&mut g.e, d, s);
        }
        return;
    }
    if ng_a64(g) {
        if kind == NEXT_SB {
            a64_sxtb(&mut g.e, d, s);
        }
        if kind == NEXT_SH {
            a64_sxth(&mut g.e, d, s);
        }
        if kind == NEXT_SW {
            a64_sxtw(&mut g.e, d, s);
        }
        if kind == NEXT_ZB {
            a64_uxtb(&mut g.e, d, s);
        }
        if kind == NEXT_ZH {
            a64_uxth(&mut g.e, d, s);
        }
        if kind == NEXT_ZW {
            a64_uxtw(&mut g.e, d, s);
        }
    } else if ng_rv_zb(g) {
        // TG9: one Zbb/Zba instruction where the base ISA takes two
        if kind == NEXT_SB {
            rv_sext_b(&mut g.e, d, s);
        }
        if kind == NEXT_SH {
            rv_sext_h(&mut g.e, d, s);
        }
        if kind == NEXT_SW {
            rv_addiw(&mut g.e, d, s, 0);
        }
        if kind == NEXT_ZB {
            rv_andi(&mut g.e, d, s, 255);
        }
        if kind == NEXT_ZH {
            rv_zext_h(&mut g.e, d, s);
        }
        if kind == NEXT_ZW {
            rv_zext_w(&mut g.e, d, s);
        }
    } else {
        if kind == NEXT_SB {
            rv_slli(&mut g.e, d, s, 56);
            rv_srai(&mut g.e, d, d, 56);
        }
        if kind == NEXT_SH {
            rv_slli(&mut g.e, d, s, 48);
            rv_srai(&mut g.e, d, d, 48);
        }
        if kind == NEXT_SW {
            rv_addiw(&mut g.e, d, s, 0);
        }
        if kind == NEXT_ZB {
            rv_andi(&mut g.e, d, s, 255);
        }
        if kind == NEXT_ZH {
            rv_slli(&mut g.e, d, s, 48);
            rv_srli(&mut g.e, d, d, 48);
        }
        if kind == NEXT_ZW {
            rv_slli(&mut g.e, d, s, 32);
            rv_srli(&mut g.e, d, d, 32);
        }
    }
}

/// Float registers 0 and 1 = the floats whose bits are in a and b (an f32,
/// when is32, is widened to f64: an f32 operation is the f64 one rounded
/// once, exact for + - * /).
fn ng_fload2(g: &mut NatGen, a: i64, b: i64, is32: bool) {
    if ng_a64(g) {
        if is32 {
            a64_fmov_sw(&mut g.e, 0, a);
            a64_fcvt_ds(&mut g.e, 0, 0);
            a64_fmov_sw(&mut g.e, 1, b);
            a64_fcvt_ds(&mut g.e, 1, 1);
        } else {
            a64_fmov_dx(&mut g.e, 0, a);
            a64_fmov_dx(&mut g.e, 1, b);
        }
    } else {
        if is32 {
            rv_fmv_wx(&mut g.e, 0, a);
            rv_fcvt_ds(&mut g.e, 0, 0);
            rv_fmv_wx(&mut g.e, 1, b);
            rv_fcvt_ds(&mut g.e, 1, 1);
        } else {
            rv_fmv_dx(&mut g.e, 0, a);
            rv_fmv_dx(&mut g.e, 1, b);
        }
    }
}

/// d = the bits of float register 0 (as f32 bits, zero-extended, if is32)
fn ng_fstore0(g: &mut NatGen, d: i64, is32: bool) {
    if ng_a64(g) {
        if is32 {
            a64_fcvt_sd(&mut g.e, 0, 0);
            a64_fmov_ws(&mut g.e, d, 0);
        } else {
            a64_fmov_xd(&mut g.e, d, 0);
        }
    } else {
        if is32 {
            rv_fcvt_sd(&mut g.e, 0, 0);
            rv_fmv_xw(&mut g.e, d, 0);
            ng_ext(g, d, d, NEXT_ZW);
        } else {
            rv_fmv_xd(&mut g.e, d, 0);
        }
    }
}

/// d = a op b in floating point (op: 1 add, 2 sub, 3 mul, 4 div)
fn ng_fbin(g: &mut NatGen, op: i64, d: i64, a: i64, b: i64, is32: bool) {
    if g.rec {
        var w: i64 = 0;
        if is32 {
            w = 1;
        }
        ng_rec(g, MO_FBIN, d, a, b, op, w, 0);
        return;
    }
    if ng_is_freg(g, d) || ng_is_freg(g, a) || ng_is_freg(g, b) || (is32 && ng_fregs_on(g)) {
        // MI25: an operand or the result in a float register (and every
        // f32 operation once floats have their registers: single
        // precision, never widened)
        ng_fbin_fr(g, op, d, a, b, is32);
        return;
    }
    if ng_x64(g) {
        ng_x64_fload2(g, a, b, is32);
        var fo: i64 = 0x58;
        if op == 2 {
            fo = 0x5C;
        }
        if op == 3 {
            fo = 0x59;
        }
        if op == 4 {
            fo = 0x5E;
        }
        x64_sse(&mut g.e, 0xF2, fo, 0, 1);
        ng_x64_fstore0(g, d, is32);
        return;
    }
    ng_fload2(g, a, b, is32);
    if ng_a64(g) {
        if op == 1 {
            a64_fadd(&mut g.e, 0, 0, 1);
        }
        if op == 2 {
            a64_fsub(&mut g.e, 0, 0, 1);
        }
        if op == 3 {
            a64_fmul(&mut g.e, 0, 0, 1);
        }
        if op == 4 {
            a64_fdiv(&mut g.e, 0, 0, 1);
        }
    } else {
        if op == 1 {
            rv_fadd_d(&mut g.e, 0, 0, 1);
        }
        if op == 2 {
            rv_fsub_d(&mut g.e, 0, 0, 1);
        }
        if op == 3 {
            rv_fmul_d(&mut g.e, 0, 0, 1);
        }
        if op == 4 {
            rv_fdiv_d(&mut g.e, 0, 0, 1);
        }
    }
    ng_fstore0(g, d, is32);
}

/// d = (a cc b) for floats, IEEE: every comparison with NaN is false but !=
fn ng_fcmp(g: &mut NatGen, d: i64, a: i64, b: i64, cc: i64, is32: bool) {
    if g.rec {
        var w: i64 = 0;
        if is32 {
            w = 1;
        }
        ng_rec(g, MO_FCMP, d, a, b, cc, w, 0);
        return;
    }
    if ng_is_freg(g, a) || ng_is_freg(g, b) || (is32 && ng_fregs_on(g)) {
        // MI25: an operand in a float register (and every f32 comparison
        // once floats have their registers: single precision)
        ng_fcmp_fr(g, d, a, b, cc, is32);
        return;
    }
    if ng_x64(g) {
        ng_x64_fload2(g, a, b, is32);
        if cc == NCC_EQ || cc == NCC_NE {
            x64_sse(&mut g.e, 0x66, 0x2E, 0, 1);
            if cc == NCC_EQ {
                x64_setcc(&mut g.e, X64_E, 11);
                x64_setcc(&mut g.e, X64_NP, 10);
            } else {
                x64_setcc(&mut g.e, X64_NE, 11);
                x64_setcc(&mut g.e, X64_P, 10);
            }
            x64_movx(&mut g.e, 0xB6, 11, 11);
            x64_movx(&mut g.e, 0xB6, 10, 10);
            if cc == NCC_EQ {
                x64_alu(&mut g.e, 0x21, 11, 10);
            } else {
                x64_alu(&mut g.e, 0x09, 11, 10);
            }
            x64_mov(&mut g.e, d, 11);
        } else {
            if cc == NCC_LT || cc == NCC_LE {
                x64_sse(&mut g.e, 0x66, 0x2E, 1, 0);
            } else {
                x64_sse(&mut g.e, 0x66, 0x2E, 0, 1);
            }
            if cc == NCC_LT || cc == NCC_GT {
                x64_setcc(&mut g.e, X64_A, 11);
            } else {
                x64_setcc(&mut g.e, X64_AE, 11);
            }
            x64_movx(&mut g.e, 0xB6, d, 11);
        }
        return;
    }
    ng_fload2(g, a, b, is32);
    if ng_a64(g) {
        a64_fcmp(&mut g.e, 0, 1);
        var c: i64 = A64_EQ;
        if cc == NCC_NE {
            c = A64_NE;
        }
        if cc == NCC_LT {
            c = A64_MI;
        }
        if cc == NCC_LE {
            c = A64_LS;
        }
        if cc == NCC_GT {
            c = A64_GT;
        }
        if cc == NCC_GE {
            c = A64_GE;
        }
        a64_cset(&mut g.e, d, c);
    } else {
        if cc == NCC_EQ {
            rv_feq_d(&mut g.e, d, 0, 1);
        } else if cc == NCC_NE {
            rv_feq_d(&mut g.e, d, 0, 1);
            rv_xori(&mut g.e, d, d, 1);
        } else if cc == NCC_LT {
            rv_flt_d(&mut g.e, d, 0, 1);
        } else if cc == NCC_LE {
            rv_fle_d(&mut g.e, d, 0, 1);
        } else if cc == NCC_GT {
            rv_flt_d(&mut g.e, d, 1, 0);
        } else {
            rv_fle_d(&mut g.e, d, 1, 0);
        }
    }
}

/// d = the float of integer s
fn ng_i2f(g: &mut NatGen, d: i64, s: i64, to_f32: bool) {
    if g.rec {
        var w: i64 = 0;
        if to_f32 {
            w = 1;
        }
        ng_rec(g, MO_I2F, d, s, 0, w, 0, 0);
        return;
    }
    if ng_is_freg(g, d) {
        // MI25: the result in a float register
        ng_i2f_fr(g, d, s, to_f32);
        return;
    }
    if ng_x64(g) {
        x64_cvtsi2sd(&mut g.e, 0, s);
        ng_x64_fstore0(g, d, to_f32);
        return;
    }
    if ng_a64(g) {
        a64_scvtf(&mut g.e, 0, s);
    } else {
        rv_fcvt_dl(&mut g.e, 0, s);
    }
    ng_fstore0(g, d, to_f32);
}

/// d = the integer of float bits s, truncated toward zero
fn ng_f2i(g: &mut NatGen, d: i64, s: i64, from_f32: bool) {
    if g.rec {
        var w: i64 = 0;
        if from_f32 {
            w = 1;
        }
        ng_rec(g, MO_F2I, d, s, 0, w, 0, 0);
        return;
    }
    if ng_is_freg(g, s) {
        // MI25: the operand in a float register
        ng_f2i_fr(g, d, s, from_f32);
        return;
    }
    if ng_x64(g) {
        if from_f32 {
            x64_movq_xr(&mut g.e, 0, s, false);
            x64_sse(&mut g.e, 0xF3, 0x5A, 0, 0);
            g.x0_reg = 0 - 1;
        } else if g.x0_reg != s || g.rec || !ng_on("xmmcache") {
            x64_movq_xr(&mut g.e, 0, s, true);
            g.x0_reg = s;
        }
        if g.rec || !ng_on("xmmcache") {
            g.x0_reg = 0 - 1;
        }
        x64_cvttsd2si(&mut g.e, d, 0);
        if g.x0_reg == d {
            g.x0_reg = 0 - 1;
        }
        if g.x1_reg == d {
            g.x1_reg = 0 - 1;
        }
        return;
    }
    if ng_a64(g) {
        if from_f32 {
            a64_fmov_sw(&mut g.e, 0, s);
            a64_fcvt_ds(&mut g.e, 0, 0);
        } else {
            a64_fmov_dx(&mut g.e, 0, s);
        }
        a64_fcvtzs(&mut g.e, d, 0);
    } else {
        if from_f32 {
            rv_fmv_wx(&mut g.e, 0, s);
            rv_fcvt_ds(&mut g.e, 0, 0);
        } else {
            rv_fmv_dx(&mut g.e, 0, s);
        }
        rv_fcvt_ld(&mut g.e, d, 0);
    }
}

// ---------------------------------------------------------------------------
// MI25: float operations on float registers. An allocated float register is
// NG_FREG + f (xmm f, v f, f f); every other operand is a general register
// holding the value's bits (an f32 as its 32-bit pattern, zero-extended),
// moved into scratch float register 0 or 1 first, as before. A float
// register holds an f64 as a double and an f32 as a single, never widened:
// f32 operations are single precision (addss, fadd s, fadd.s), which is
// the result the f64 operation rounded once gave (exact for + - * /).
// Conversions keep their old rounding (an integer to f32 goes through f64).
// ---------------------------------------------------------------------------

/// float register f = the bits of general register r (an f32: the low 32)
fn ng_fput(g: &mut NatGen, f: i64, r: i64, is32: bool) {
    if ng_x64(g) {
        x64_movq_xr(&mut g.e, f, r, !is32);
    } else if ng_a64(g) {
        if is32 {
            a64_fmov_sw(&mut g.e, f, r);
        } else {
            a64_fmov_dx(&mut g.e, f, r);
        }
    } else {
        if is32 {
            rv_fmv_wx(&mut g.e, f, r);
        } else {
            rv_fmv_dx(&mut g.e, f, r);
        }
    }
}

/// general register r = the bits of float register f (an f32 zero-extended)
fn ng_fget(g: &mut NatGen, r: i64, f: i64, is32: bool) {
    if ng_x64(g) {
        x64_movq_rx(&mut g.e, r, f, !is32);
    } else if ng_a64(g) {
        if is32 {
            a64_fmov_ws(&mut g.e, r, f);
        } else {
            a64_fmov_xd(&mut g.e, r, f);
        }
    } else {
        if is32 {
            rv_fmv_xw(&mut g.e, r, f);
            ng_ext(g, r, r, NEXT_ZW);
        } else {
            rv_fmv_xd(&mut g.e, r, f);
        }
    }
}

/// x86-64: 0F op /r between xmm registers, no prefix (28 movaps, 2E ucomiss)
fn ng_x64_sse_np(g: &mut NatGen, op: i64, x1: i64, x2: i64) {
    var rex: i64 = 0x40;
    if x1 >= 8 {
        rex = rex | 4;
    }
    if x2 >= 8 {
        rex = rex | 1;
    }
    if rex != 0x40 {
        NatEnc_byte(&mut g.e, rex);
    }
    NatEnc_byte(&mut g.e, 0x0F);
    NatEnc_byte(&mut g.e, op);
    NatEnc_byte(&mut g.e, 0xC0 | ((x1 & 7) << 3) | (x2 & 7));
}

/// x86-64 cvttss2si r64, xmm (F3 REX.W 0F 2C)
fn ng_x64_cvttss2si(g: &mut NatGen, r: i64, x: i64) {
    NatEnc_byte(&mut g.e, 0xF3);
    var rex: i64 = 0x48;
    if r >= 8 {
        rex = rex | 4;
    }
    if x >= 8 {
        rex = rex | 1;
    }
    NatEnc_byte(&mut g.e, rex);
    NatEnc_byte(&mut g.e, 0x0F);
    NatEnc_byte(&mut g.e, 0x2C);
    NatEnc_byte(&mut g.e, 0xC0 | ((r & 7) << 3) | (x & 7));
}

/// float register d = float register s (the whole register)
fn ng_fcopy(g: &mut NatGen, d: i64, s: i64) {
    if d == s {
        return;
    }
    if ng_x64(g) {
        ng_x64_sse_np(g, 0x28, d, s);
    } else if ng_a64(g) {
        // fmov d<d>, d<s>
        NatEnc_word(&mut g.e, 0x1E604000 | (s << 5) | d);
    } else {
        rv_fsgnj_d(&mut g.e, d, s, s);
    }
}

/// MI25: d = s for registers of either class (NG_FREG + f a float
/// register): a copy within a class, or a move across (an f32 as its 32
/// bits, zero-extended in a general register).
fn ng_fmov_any(g: &mut NatGen, d: i64, s: i64, is32: bool) {
    var df: bool = ng_is_freg(g, d);
    var sf: bool = ng_is_freg(g, s);
    if df && sf {
        ng_fcopy(g, d - NG_FREG, s - NG_FREG);
    } else if df {
        ng_fput(g, d - NG_FREG, s, is32);
    } else if sf {
        ng_fget(g, d, s - NG_FREG, is32);
    } else if d != s {
        ng_mov(g, d, s);
    }
}

/// The float register number operand r is read from: its own, or scratch
/// `scr` loaded with r's bits.
fn ng_fsrc(g: &mut NatGen, r: i64, scr: i64, is32: bool) -> i64 {
    if ng_is_freg(g, r) {
        return r - NG_FREG;
    }
    ng_fput(g, scr, r, is32);
    return scr;
}

/// MI25: ng_fbin with float registers among d, a, b
fn ng_fbin_fr(g: &mut NatGen, op: i64, d: i64, a: i64, b: i64, is32: bool) {
    g.x0_reg = 0 - 1;
    g.x1_reg = 0 - 1;
    var dfr: bool = ng_is_freg(g, d);
    if ng_x64(g) {
        // two-operand SSE: d = a, then d op= b; through xmm0 when d is b
        // (and not a) or a general register
        var xb: i64 = ng_fsrc(g, b, 1, is32);
        var xd: i64 = 0;
        if dfr && (d != b || a == b) {
            xd = d - NG_FREG;
        }
        if ng_is_freg(g, a) {
            ng_fcopy(g, xd, a - NG_FREG);
        } else {
            ng_fput(g, xd, a, is32);
        }
        var fo: i64 = 0x58;
        if op == 2 {
            fo = 0x5C;
        }
        if op == 3 {
            fo = 0x59;
        }
        if op == 4 {
            fo = 0x5E;
        }
        var pfx: i64 = 0xF2;
        if is32 {
            pfx = 0xF3;
        }
        x64_sse(&mut g.e, pfx, fo, xd, xb);
        if !dfr {
            ng_fget(g, d, xd, is32);
        } else if xd != d - NG_FREG {
            ng_fcopy(g, d - NG_FREG, xd);
        }
        return;
    }
    var fa: i64 = ng_fsrc(g, a, 0, is32);
    var fb: i64 = ng_fsrc(g, b, 1, is32);
    var fd: i64 = 0;
    if dfr {
        fd = d - NG_FREG;
    }
    if ng_a64(g) {
        // fadd / fsub / fmul / fdiv, type 01 (double) or 00 (single)
        var base: i64 = 0x1E602800;
        if op == 2 {
            base = 0x1E603800;
        }
        if op == 3 {
            base = 0x1E600800;
        }
        if op == 4 {
            base = 0x1E601800;
        }
        if is32 {
            base = base - 0x00400000;
        }
        a64_rrr(&mut g.e, base, fd, fa, fb);
    } else {
        // fadd.d .. fdiv.d, or .s (fmt bit 25 clear)
        var rb: i64 = 0x02000053;
        if op == 2 {
            rb = 0x0A000053;
        }
        if op == 3 {
            rb = 0x12000053;
        }
        if op == 4 {
            rb = 0x1A000053;
        }
        if is32 {
            rb = rb - 0x02000000;
        }
        rv_fop_d(&mut g.e, rb, fd, fa, fb);
    }
    if !dfr {
        ng_fget(g, d, 0, is32);
    }
}

/// MI25: ng_fcmp with a float register among a, b (d is a general
/// register: 1 when a cc b, IEEE, every comparison with NaN false but !=)
fn ng_fcmp_fr(g: &mut NatGen, d: i64, a: i64, b: i64, cc: i64, is32: bool) {
    g.x0_reg = 0 - 1;
    g.x1_reg = 0 - 1;
    var fa: i64 = ng_fsrc(g, a, 0, is32);
    var fb: i64 = ng_fsrc(g, b, 1, is32);
    if ng_x64(g) {
        var x1: i64 = fa;
        var x2: i64 = fb;
        if cc == NCC_LT || cc == NCC_LE {
            x1 = fb;
            x2 = fa;
        }
        if is32 {
            // ucomiss
            ng_x64_sse_np(g, 0x2E, x1, x2);
        } else {
            // ucomisd
            x64_sse(&mut g.e, 0x66, 0x2E, x1, x2);
        }
        if cc == NCC_EQ || cc == NCC_NE {
            if cc == NCC_EQ {
                x64_setcc(&mut g.e, X64_E, 11);
                x64_setcc(&mut g.e, X64_NP, 10);
            } else {
                x64_setcc(&mut g.e, X64_NE, 11);
                x64_setcc(&mut g.e, X64_P, 10);
            }
            x64_movx(&mut g.e, 0xB6, 11, 11);
            x64_movx(&mut g.e, 0xB6, 10, 10);
            if cc == NCC_EQ {
                x64_alu(&mut g.e, 0x21, 11, 10);
            } else {
                x64_alu(&mut g.e, 0x09, 11, 10);
            }
            x64_mov(&mut g.e, d, 11);
        } else {
            if cc == NCC_LT || cc == NCC_GT {
                x64_setcc(&mut g.e, X64_A, 11);
            } else {
                x64_setcc(&mut g.e, X64_AE, 11);
            }
            x64_movx(&mut g.e, 0xB6, d, 11);
        }
        return;
    }
    if ng_a64(g) {
        // fcmp d / s
        if is32 {
            NatEnc_word(&mut g.e, 0x1E202000 | (fb << 16) | (fa << 5));
        } else {
            a64_fcmp(&mut g.e, fa, fb);
        }
        var c: i64 = A64_EQ;
        if cc == NCC_NE {
            c = A64_NE;
        }
        if cc == NCC_LT {
            c = A64_MI;
        }
        if cc == NCC_LE {
            c = A64_LS;
        }
        if cc == NCC_GT {
            c = A64_GT;
        }
        if cc == NCC_GE {
            c = A64_GE;
        }
        a64_cset(&mut g.e, d, c);
        return;
    }
    // RISC-V feq / flt / fle, .d or .s (fmt bit 25 clear)
    var weq: i64 = 0xA2002053;
    var wlt: i64 = 0xA2001053;
    var wle: i64 = 0xA2000053;
    if is32 {
        weq = 0xA0002053;
        wlt = 0xA0001053;
        wle = 0xA0000053;
    }
    var w: i64 = weq;
    var x: i64 = fa;
    var y: i64 = fb;
    if cc == NCC_LT {
        w = wlt;
    } else if cc == NCC_LE {
        w = wle;
    } else if cc == NCC_GT {
        w = wlt;
        x = fb;
        y = fa;
    } else if cc == NCC_GE {
        w = wle;
        x = fb;
        y = fa;
    }
    NatEnc_word(&mut g.e, w | (y << 20) | (x << 15) | (d << 7));
    if cc == NCC_NE {
        rv_xori(&mut g.e, d, d, 1);
    }
}

/// MI25: ng_i2f into float register d (an f32 through f64, as before)
fn ng_i2f_fr(g: &mut NatGen, d: i64, s: i64, to_f32: bool) {
    g.x0_reg = 0 - 1;
    g.x1_reg = 0 - 1;
    var fd: i64 = d - NG_FREG;
    if ng_x64(g) {
        if to_f32 {
            x64_cvtsi2sd(&mut g.e, 0, s);
            // cvtsd2ss xd, xmm0
            x64_sse(&mut g.e, 0xF2, 0x5A, fd, 0);
        } else {
            x64_cvtsi2sd(&mut g.e, fd, s);
        }
        return;
    }
    if ng_a64(g) {
        if to_f32 {
            a64_scvtf(&mut g.e, 0, s);
            a64_fcvt_sd(&mut g.e, fd, 0);
        } else {
            a64_scvtf(&mut g.e, fd, s);
        }
        return;
    }
    if to_f32 {
        rv_fcvt_dl(&mut g.e, 0, s);
        rv_fcvt_sd(&mut g.e, fd, 0);
    } else {
        rv_fcvt_dl(&mut g.e, fd, s);
    }
}

/// MI25: ng_f2i from float register s, truncated toward zero
fn ng_f2i_fr(g: &mut NatGen, d: i64, s: i64, from_f32: bool) {
    g.x0_reg = 0 - 1;
    g.x1_reg = 0 - 1;
    var fs: i64 = s - NG_FREG;
    if ng_x64(g) {
        if from_f32 {
            ng_x64_cvttss2si(g, d, fs);
        } else {
            x64_cvttsd2si(&mut g.e, d, fs);
        }
        return;
    }
    if ng_a64(g) {
        if from_f32 {
            // fcvtzs x<d>, s<s>
            NatEnc_word(&mut g.e, 0x9E380000 | (fs << 5) | d);
        } else {
            a64_fcvtzs(&mut g.e, d, fs);
        }
        return;
    }
    if from_f32 {
        // fcvt.l.s d, fs, rtz
        NatEnc_word(&mut g.e, 0xC0201053 | (fs << 15) | (d << 7));
    } else {
        rv_fcvt_ld(&mut g.e, d, fs);
    }
}

/// d = the f32 bit pattern (zero-extended) of the f64 whose bits are in s,
/// rounded to single: `x as f32` from an f64, and `p_f32_to_bits` of an
/// f64 argument.
fn ng_f32bits(g: &mut NatGen, d: i64, s: i64) {
    if g.rec {
        ng_rec(g, MO_F32BITS, d, s, 0, 0, 0, 0);
        return;
    }
    if ng_is_freg(g, d) || ng_is_freg(g, s) {
        // MI25: a side in a float register
        ng_fcvt_fr(g, d, s, true);
        return;
    }
    if ng_x64(g) {
        x64_movq_xr(&mut g.e, 0, s, true);
        x64_sse(&mut g.e, 0xF2, 0x5A, 0, 0);
        // cvtsd2ss xmm0, xmm0
        x64_movq_rx(&mut g.e, d, 0, false);
        // movd eax, xmm0 (zero-extends)
        g.x0_reg = 0 - 1;
        if g.x1_reg == d {
            g.x1_reg = 0 - 1;
        }
        return;
    }
    if ng_a64(g) {
        a64_fmov_dx(&mut g.e, 0, s);
        a64_fcvt_sd(&mut g.e, 0, 0);
        a64_fmov_ws(&mut g.e, d, 0);
        // writes w, upper x cleared
        return;
    }
    rv_fmv_dx(&mut g.e, 0, s);
    rv_fcvt_sd(&mut g.e, 0, 0);
    rv_fmv_xw(&mut g.e, d, 0);
    ng_ext(g, d, d, NEXT_ZW);
}

/// MI25: d = the f64 bits of the f32 whose pattern (zero-extended) is in s:
/// an f32 widened to f64 (`x as f64`; MO_F32BITS with i0 = 1, the
/// inverse of ng_f32bits).
fn ng_f32widen(g: &mut NatGen, d: i64, s: i64) {
    if g.rec {
        ng_rec(g, MO_F32BITS, d, s, 0, 1, 0, 0);
        return;
    }
    if ng_is_freg(g, d) || ng_is_freg(g, s) {
        ng_fcvt_fr(g, d, s, false);
        return;
    }
    if ng_x64(g) {
        x64_movq_xr(&mut g.e, 0, s, false);
        // movd xmm0, s; cvtss2sd xmm0, xmm0; movq d, xmm0
        x64_sse(&mut g.e, 0xF3, 0x5A, 0, 0);
        x64_movq_rx(&mut g.e, d, 0, true);
        g.x0_reg = 0 - 1;
        if g.x1_reg == d {
            g.x1_reg = 0 - 1;
        }
        return;
    }
    if ng_a64(g) {
        a64_fmov_sw(&mut g.e, 0, s);
        a64_fcvt_ds(&mut g.e, 0, 0);
        a64_fmov_xd(&mut g.e, d, 0);
        return;
    }
    rv_fmv_wx(&mut g.e, 0, s);
    rv_fcvt_ds(&mut g.e, 0, 0);
    rv_fmv_xd(&mut g.e, d, 0);
}

/// MI25: ng_f32bits (to32: f64 -> f32) or ng_f32widen (f32 -> f64) with a
/// float register among d, s: one cvtsd2ss / cvtss2sd, fcvt, fcvt.s.d /
/// fcvt.d.s, the other side through scratch float register 0.
fn ng_fcvt_fr(g: &mut NatGen, d: i64, s: i64, to32: bool) {
    g.x0_reg = 0 - 1;
    g.x1_reg = 0 - 1;
    var fs: i64 = ng_fsrc(g, s, 0, !to32);
    var dfr: bool = ng_is_freg(g, d);
    var fd: i64 = 0;
    if dfr {
        fd = d - NG_FREG;
    }
    if ng_x64(g) {
        if to32 {
            x64_sse(&mut g.e, 0xF2, 0x5A, fd, fs);
        } else {
            x64_sse(&mut g.e, 0xF3, 0x5A, fd, fs);
        }
    } else if ng_a64(g) {
        if to32 {
            a64_fcvt_sd(&mut g.e, fd, fs);
        } else {
            a64_fcvt_ds(&mut g.e, fd, fs);
        }
    } else {
        if to32 {
            rv_fcvt_sd(&mut g.e, fd, fs);
        } else {
            rv_fcvt_ds(&mut g.e, fd, fs);
        }
    }
    if !dfr {
        ng_fget(g, d, fd, to32);
    }
}

/// Function entry: save the return address and frame pointer, reserve
/// `frame` bytes (a multiple of 16).
fn ng_prologue(g: &mut NatGen, frame: i64) {
    if g.rec {
        ng_rec(g, MO_PROLOGUE, 0, 0, 0, 0, 0, 0);
        return;
    }
    if g.leaf > 0 {
        return;
    }
    if ng_x64(g) {
        x64_push(&mut g.e, 5);
        // push rbp
        x64_mov(&mut g.e, 5, 4);
        // mov rbp, rsp
        if frame > NG_PAGE && ng_on("probe") {
            ng_probe_frame(g, frame);
        } else if frame > 0 {
            x64_sub_imm(&mut g.e, 4, frame);
        }
    } else if ng_a64(g) {
        NatEnc_word(&mut g.e, 0xA9BF7BFD);
        // stp x29, x30, [sp, #-16]!
        a64_add_imm(&mut g.e, A64_FP, A64_SP, 0);
        // mov x29, sp
        if frame < 4096 {
            a64_sub_imm(&mut g.e, A64_SP, A64_SP, frame);
        } else if frame > NG_PAGE && ng_on("probe") {
            ng_probe_frame(g, frame);
        } else {
            a64_li(&mut g.e, g.ad, frame);
            a64_sub_ext(&mut g.e, A64_SP, A64_SP, g.ad);
        }
    } else {
        rv_addi(&mut g.e, RV_SP, RV_SP, 0 - 16);
        rv_store(&mut g.e, RV_RA, RV_SP, 8, 8);
        rv_store(&mut g.e, RV_S0, RV_SP, 0, 8);
        rv_addi(&mut g.e, RV_S0, RV_SP, 16);
        // s0 = the caller's sp
        if frame <= 2048 {
            rv_addi(&mut g.e, RV_SP, RV_SP, 0 - frame);
        } else if frame > NG_PAGE && ng_on("probe") {
            ng_probe_frame(g, frame);
        } else {
            rv_li(&mut g.e, g.ad, frame);
            rv_sub(&mut g.e, RV_SP, RV_SP, g.ad);
        }
    }
    // The callee-saved registers this function uses, two at a time with
    // stp on AArch64 (RA13; the same slots either way); RA12: only those
    // of g.sw_pro when the function defers the others (ng_sw_plan)
    var sw_pro: i64 = g.sw_pro;
    ng_save_subset(g, sw_pro);
    ng_cfi_saves(g, frame, sw_pro);
}

/// DWARF's number of machine register r (x86-64: rax, rdx, rcx, rbx, rsi,
/// rdi, rbp, rsp, r8-r15; AArch64 and RISC-V: the register number).
fn ng_dwarf_reg(g: &NatGen, r: i64) -> i64 {
    if ng_is_freg(g, r) {
        // MI25: a value in a float register has no location recorded
        return 0 - 1;
    }
    if ng_x64(g) {
        if r == 1 {
            return 2;
        }
        if r == 2 {
            return 1;
        }
        if r == 4 {
            return 7;
        }
        if r == 5 {
            return 6;
        }
        if r == 6 {
            return 4;
        }
        if r == 7 {
            return 5;
        }
    }
    return r;
}

/// DB6: the callee-saved registers the prologue stored (save-area index k
/// in `mask`), for .debug_frame: rows [pos, -2 - (dwarf reg | n << 8),
/// pos] in g.cfi_rows (nat_enc.fd nat_elf_debug), the register saved at
/// CFA - 8n from pos, the end of the stores (until then the registers
/// still hold the caller's values, so one position serves all). The slot
/// is sp + save_off + 8k with sp = CFA - 16 - frame on all three targets
/// (the frame record is 16 bytes under the CFA).
fn ng_cfi_saves(g: &mut NatGen, frame: i64, mask: i64) {
    var pos: i64 = NatEnc_pos(&g.e);
    var k: i64 = 0;
    while k < g.save_regs.len() {
        if ng_sw_in(mask, k) {
            var n: i64 = (16 + frame - g.save_off - 8 * k) / 8;
            var dr: i64 = ng_dwarf_reg(g, g.save_regs.get(k));
            if n > 0 && n < 65536 && dr >= 0 && dr < 64 {
                g.cfi_rows.push(pos);
                g.cfi_rows.push(0 - 2 - (dr | (n << 8)));
                g.cfi_rows.push(pos);
            }
        }
        k = k + 1;
    }
}

/// DB6: for RA12's plan `swp` (ng_sw_plan) of the machine IR of `rec`,
/// the save-area registers whose deferred save has run when instruction
/// k starts (before its code), for each k: a forward walk of the blocks
/// (mi_blocks) from the entry, where none is saved, through the saves
/// after an instruction (swp 2 + 3k) and the early restores (4 + 3k).
/// What comes after a conditional branch runs on its fall-through only,
/// so the branch's target gets the state before it. Every way into a
/// block brings the same state (ng_sw_plan saves once, on no cycle); the
/// first one found is taken. Empty when nothing is deferred.
fn ng_dbg_sw_states(rec: &NatFnRec, swp: &Vec<i64>) -> Vec<i64> {
    var st: Vec<i64> = Vec::new();
    var n: i64 = rec.mir.len();
    if swp.len() < 2 + 3 * n || n == 0 {
        return st;
    }
    var mb: MBlocks = mi_blocks(&rec.mir);
    var nb: i64 = mb.start.len();
    var inb: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < nb {
        inb.push(0 - 1);
        b = b + 1;
    }
    inb.set(0, 0);
    var changed: bool = true;
    var rounds: i64 = 0;
    while changed && rounds <= nb + 1 {
        changed = false;
        b = 0;
        while b < nb {
            if inb.get(b) >= 0 {
                var cur: i64 = inb.get(b);
                var j: i64 = mb.start.get(b);
                var e: i64 = mb.end.get(b);
                while j < e {
                    cur = (cur & (0 - 1 - swp.get(4 + 3 * j))) | swp.get(2 + 3 * j);
                    j = j + 1;
                }
                var taken: i64 = cur;
                var fall: i64 = (cur & (0 - 1 - swp.get(4 + 3 * e))) | swp.get(2 + 3 * e);
                var lop: i64 = rec.mir.get(e).op;
                var sc: Vec<i64> = mb.succs.get(b);
                var q: i64 = 0;
                while q < sc.len() {
                    var t: i64 = sc.get(q);
                    var falls: bool = (mi_is_cond_br(lop) && q == 1) || (!mi_is_br(lop) && q == 0);
                    var v: i64 = taken;
                    if falls {
                        v = fall;
                    }
                    if t >= 0 && t < nb && inb.get(t) < 0 {
                        inb.set(t, v);
                        changed = true;
                    }
                    q = q + 1;
                }
            }
            b = b + 1;
        }
        rounds = rounds + 1;
    }
    var k: i64 = 0;
    while k < n {
        st.push(0);
        k = k + 1;
    }
    b = 0;
    while b < nb {
        var cur2: i64 = inb.get(b);
        if cur2 < 0 {
            cur2 = 0;
        }
        var j2: i64 = mb.start.get(b);
        while j2 <= mb.end.get(b) {
            st.set(j2, cur2);
            cur2 = (cur2 & (0 - 1 - swp.get(4 + 3 * j2))) | swp.get(2 + 3 * j2);
            j2 = j2 + 1;
        }
        b = b + 1;
    }
    return st;
}

/// DB6: the frame rows (g.cfi_rows, as ng_cfi_saves) that take the
/// deferred saves the CFI describes from the mask `cur` to `want` at the
/// current position: the register saved at CFA - 8n for each one saved
/// now, n = 0 (the CIE's rule: nat_enc.fd nat_dwarf_build writes
/// DW_CFA_restore) for each one given back or not saved on the way here.
/// Returns `want`. `FID_NAT_OFF=swcfi`: no rows (only the prologue's, as
/// before).
fn ng_dbg_sw_to(g: &mut NatGen, cur: i64, want: i64) -> i64 {
    if cur == want || !ng_on("swcfi") {
        return want;
    }
    var pos: i64 = NatEnc_pos(&g.e);
    var k: i64 = 0;
    while k < g.save_regs.len() && k < 62 {
        if ng_sw_in(cur, k) != ng_sw_in(want, k) {
            var dr: i64 = ng_dwarf_reg(g, g.save_regs.get(k));
            var n: i64 = (16 + g.frame - g.save_off - 8 * k) / 8;
            if dr >= 0 && dr < 64 && n > 0 && n < 65536 {
                var code: i64 = dr;
                if ng_sw_in(want, k) {
                    code = dr | (n << 8);
                }
                g.cfi_rows.push(pos);
                g.cfi_rows.push(0 - 2 - code);
                g.cfi_rows.push(pos);
            }
        }
        k = k + 1;
    }
    return want;
}

/// RA12: save-area index k is in `mask`.
fn ng_sw_in(mask: i64, k: i64) -> bool {
    return (mask & (1 << k)) != 0;
}

/// The callee-saved registers of g.save_regs whose index is in `mask` to
/// their slots (sp + save_off + 8 * index), two at a time with stp on
/// AArch64 when both of a pair are in (RA13).
fn ng_save_subset(g: &mut NatGen, mask: i64) {
    var k: i64 = 0;
    var npair: i64 = g.save_regs.len();
    while k < npair {
        var off: i64 = g.save_off + 8 * k;
        if !ng_sw_in(mask, k) {
            k = k + 1;
        } else if ng_pair_ok(g, k, off) && ng_sw_in(mask, k + 1) {
            if ng_is_freg(g, g.save_regs.get(k)) {
                // RA18: stp d, d (SIMD&FP, 64-bit, signed offset)
                ng_a64_fpair(g, false, g.save_regs.get(k), g.save_regs.get(k + 1), off);
            } else {
                a64_stp(&mut g.e, g.save_regs.get(k), g.save_regs.get(k + 1), A64_SP, off);
            }
            k = k + 2;
        } else if ng_is_freg(g, g.save_regs.get(k)) {
            // RA18: a callee-saved float register
            ng_fsave_slot(g, true, g.save_regs.get(k), off);
            k = k + 1;
        } else {
            ng_st_slot(g, off, g.save_regs.get(k));
            k = k + 1;
        }
    }
}

/// RA18: stp (load false) / ldp (load true) of float registers r1, r2
/// (NG_FREG + f) at sp + off, 64 bits each: 0x6D000000 / 0x6D400000 |
/// imm7 (off / 8) << 15 | Rt2 << 10 | sp << 5 | Rt (`stp d8, d9, [sp,
/// #16]` = 0x6D0127E8).
fn ng_a64_fpair(g: &mut NatGen, load: bool, r1: i64, r2: i64, off: i64) {
    var op: i64 = 0x6D000000;
    if load {
        op = 0x6D400000;
    }
    NatEnc_word(&mut g.e, op | (((off / 8) & 0x7F) << 15) | ((r2 - NG_FREG) << 10) | (A64_SP << 5) | (r1 - NG_FREG));
}

/// The callee-saved registers of g.save_regs whose index is in `mask`
/// back from their slots (ldp pairs on AArch64, as ng_save_subset).
fn ng_restore_subset(g: &mut NatGen, mask: i64) {
    var k: i64 = 0;
    var npair: i64 = g.save_regs.len();
    while k < npair {
        var off: i64 = g.save_off + 8 * k;
        if !ng_sw_in(mask, k) {
            k = k + 1;
        } else if ng_pair_ok(g, k, off) && ng_sw_in(mask, k + 1) {
            if ng_is_freg(g, g.save_regs.get(k)) {
                // RA18: ldp d, d
                ng_a64_fpair(g, true, g.save_regs.get(k), g.save_regs.get(k + 1), off);
            } else {
                a64_ldp(&mut g.e, g.save_regs.get(k), g.save_regs.get(k + 1), A64_SP, off);
            }
            k = k + 2;
        } else if ng_is_freg(g, g.save_regs.get(k)) {
            // RA18: a callee-saved float register
            ng_fsave_slot(g, false, g.save_regs.get(k), off);
            k = k + 1;
        } else {
            ng_ld_slot(g, g.save_regs.get(k), off);
            k = k + 1;
        }
    }
}

// RA12: the largest function (in machine blocks) shrink wrapping plans,
// and the most save points it tries in one function (each try walks the
// blocks reachable from the candidate once).
const NG_SW_MAX_BLOCKS: i64 = 4096;
const NG_SW_MAX_TRIES: i64 = 64;

/// RA12: shrink wrapping. Each callee-saved register of the save area
/// (index k) is saved where it is first needed instead of in the
/// prologue: at the start of the block S_k nearest the exits that
/// dominates every block whose instructions name it (any operand field,
/// after allocation), provided S_k is on no cycle (the save runs at most
/// once a call) and every exit reachable from S_k (an epilogue, or a call
/// that may become a tail jump, ng_tail_at) is dominated by S_k
/// (ng_sw_ok). Each exit then restores just the registers whose S_k
/// dominates it: on every way to it those were saved exactly once before
/// anything wrote them, and the others were neither saved nor written.
/// The blocks are the MIR's (mi_blocks) plus an edge block on each
/// fall-through into a labelled block, whose code goes right after the
/// instruction that falls through, so a save can sit on the way into a
/// loop without running each time round it. The early exit of `if n < 2 {
/// return n; }` is one case of it: the saves go on the branch's other way.
/// S_k starts at the nearest common dominator of the blocks naming k and
/// moves up the dominator tree until it qualifies; the entry block means
/// the prologue, as before. A node whose reachable exits lie past the part
/// of the function it dominates (`if rare { calls }` in the middle) can
/// still be S_k with restores: k is then given back where each way leaves
/// that part (before the jump that ends the block, or on the edge) and
/// the exits after it restore nothing of k (ng_sw_rest;
/// `FID_NAT_OFF=swrestore`: not tried). The slots do not move; the CFI of
/// the deferred saves and early restores comes from ng_dbg_sw_states /
/// ng_dbg_sw_to (DB6). Returns [prologue mask, registers deferred, then for each MIR
/// index k: the mask saved right after instruction k, the mask an exit at
/// k restores (-1: all), the mask restored right after instruction k
/// (before the saves there)], or empty when the prologue saves
/// everything. `FID_NAT_OFF=shrinkwrap`.
fn ng_sw_plan(g: &NatGen, rec: &NatFnRec, al: &NatAlloc) -> Vec<i64> {
    var res: Vec<i64> = Vec::new();
    var ns: i64 = al.save_regs.len();
    // (MI27: not with a jump table, whose entries nothing may come between)
    if ns == 0 || ns > 62 || !ng_on("shrinkwrap") || mi_has_jtab(&rec.mir) {
        return res;
    }
    var n: i64 = rec.mir.len();
    var nv: i64 = rec.nvreg - NG_VBASE;
    var k: i64 = 0;
    while k < n && rec.mir.get(k).op == MO_LINE {
        k = k + 1;
    }
    if k >= n || rec.mir.get(k).op != MO_PROLOGUE {
        return res;
    }
    var pro: i64 = k;
    // Every label placed once, every branch to one of them, and none of
    // them address-taken or called (a way in the blocks would not show)
    var labs: i64 = HashMap_new();
    k = 0;
    while k < n {
        var lm: MInst = rec.mir.get(k);
        if lm.op == MO_PROLOGUE && k != pro {
            return res;
        }
        if lm.op == MO_PLACE {
            if HashMap_contains_i(labs, lm.i0) {
                return res;
            }
            HashMap_insert_i(labs, lm.i0, 1);
        }
        k = k + 1;
    }
    k = 0;
    while k < n {
        var bm: MInst = rec.mir.get(k);
        if mi_is_br(bm.op) && !HashMap_contains_i(labs, bm.i0) {
            return res;
        }
        if (bm.op == MO_ADDR || mi_is_call(bm.op)) && HashMap_contains_i(labs, bm.i0) {
            return res;
        }
        k = k + 1;
    }
    var mb: MBlocks = mi_blocks(&rec.mir);
    var nb: i64 = mb.start.len();
    if nb < 2 || nb > NG_SW_MAX_BLOCKS {
        return res;
    }
    // Nodes: block b, and nb + b the edge block on b's fall-through into a
    // labelled block; two successors each at most (s0, s1; -1: none)
    var nt: i64 = 2 * nb;
    var s0: Vec<i64> = Vec::new();
    var s1: Vec<i64> = Vec::new();
    var exitb: Vec<i64> = Vec::new();
    var touch: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nt {
        s0.push(0 - 1);
        s1.push(0 - 1);
        exitb.push(0);
        touch.push(0);
        i = i + 1;
    }
    var b: i64 = 0;
    while b < nb {
        var sc: Vec<i64> = mb.succs.get(b);
        var lop: i64 = rec.mir.get(mb.end.get(b)).op;
        var q: i64 = 0;
        while q < sc.len() && q < 2 {
            var t: i64 = sc.get(q);
            var falls: bool = (mi_is_cond_br(lop) && q == 1) || (!mi_is_br(lop) && q == 0);
            if falls && t == b + 1 && rec.mir.get(mb.start.get(t)).op == MO_PLACE {
                s0.set(nb + b, t);
                t = nb + b;
            }
            if q == 0 {
                s0.set(b, t);
            } else {
                s1.set(b, t);
            }
            q = q + 1;
        }
        // which save-area registers the block's instructions name, and
        // whether it leaves the function
        var j: i64 = mb.start.get(b);
        while j <= mb.end.get(b) {
            var m3: MInst = rec.mir.get(j);
            if m3.op == MO_EPILOGUE || m3.op == MO_CALL {
                exitb.set(b, 1);
            }
            // RA12: a tail call (MI28) is a MO_JMP to a function, not to
            // a placed label — the block leaves the function too, so its
            // callee-saved registers must be restored
            if m3.op == MO_JMP && m3.i0 >= 0 && !HashMap_contains_i(labs, m3.i0) {
                exitb.set(b, 1);
            }
            if m3.op >= 0 && m3.op != MO_LINE && m3.op != MO_PLACE && m3.op != MO_PROLOGUE && m3.op != MO_EPILOGUE {
                var f: i64 = 0;
                while f < 3 {
                    var r: i64 = mi_field(m3, f);
                    if r >= NG_VBASE && r - NG_VBASE < nv {
                        r = al.assign.get(r - NG_VBASE);
                    }
                    var si: i64 = 0;
                    while r >= 0 && si < ns {
                        if al.save_regs.get(si) == r {
                            touch.set(b, touch.get(b) | (1 << si));
                        }
                        si = si + 1;
                    }
                    f = f + 1;
                }
            }
            j = j + 1;
        }
        b = b + 1;
    }
    // the nodes a restore can end (ng_sw_rest): an edge block, or a block
    // that ends in a jump (the restore goes before it)
    var rok: Vec<i64> = Vec::new();
    i = 0;
    while i < nt {
        var can: i64 = 0;
        if i >= nb && s0.get(i) >= 0 {
            can = 1;
        } else if i < nb && rec.mir.get(mb.end.get(i)).op == MO_JMP {
            can = 1;
        }
        rok.push(can);
        i = i + 1;
    }
    var dom: NgDom = ng_dom_build(&s0, &s1);
    // S_k for each save-area register (0: the prologue); memo per node:
    // 0 not tried, 1 qualifies, 2 does not
    var sblk: Vec<i64> = Vec::new();
    var memo: Vec<i64> = Vec::new();
    i = 0;
    while i < nt {
        memo.push(0);
        i = i + 1;
    }
    var tries: i64 = 0;
    var pmask: i64 = 0;
    var deferred: i64 = 0;
    // For a register restored before the exits (ng_sw_rest): the state of
    // each node while it runs (1 not saved, 2 saved) in kst from kat[k]
    // (-1: none, saved wherever S_k dominates), and its restore nodes in
    // rlist from rat[k] to rat[k + 1]
    var kst: Vec<i64> = Vec::new();
    var kat: Vec<i64> = Vec::new();
    var rlist: Vec<i64> = Vec::new();
    var rat: Vec<i64> = Vec::new();
    var stv: Vec<i64> = Vec::new();
    var rmk: Vec<i64> = Vec::new();
    var rest_on: bool = ng_on("swrestore");
    var sk: i64 = 0;
    while sk < ns {
        var withr: bool = false;
        var at: i64 = 0 - 1;
        b = 0;
        while b < nb {
            if dom.rnum.get(b) >= 0 && (touch.get(b) & (1 << sk)) != 0 {
                if at < 0 {
                    at = b;
                } else {
                    at = ng_dom_isect(&dom.idom, &dom.rnum, at, b);
                }
            }
            b = b + 1;
        }
        if at < 0 {
            at = 0;
        }
        var placed: bool = false;
        while !placed {
            if at <= 0 {
                at = 0;
                placed = true;
            } else {
                if memo.get(at) == 0 && tries < NG_SW_MAX_TRIES {
                    tries = tries + 1;
                    if ng_sw_ok(at, nb, &s0, &s1, &exitb, &dom) {
                        memo.set(at, 1);
                    } else {
                        memo.set(at, 2);
                    }
                }
                if memo.get(at) == 1 {
                    placed = true;
                } else if memo.get(at) == 2 {
                    // or saved here and restored where the ways leave the
                    // part this node dominates (ng_sw_rest)
                    if rest_on && tries < NG_SW_MAX_TRIES {
                        tries = tries + 1;
                        if ng_sw_rest(at, 1 << sk, nb, &s0, &s1, &exitb, &touch, &rok, &dom, &mut stv, &mut rmk) {
                            withr = true;
                            placed = true;
                        }
                    }
                    if !placed {
                        at = dom.idom.get(at);
                    }
                } else {
                    // out of tries: the prologue
                    at = 0;
                }
            }
        }
        rat.push(rlist.len());
        if withr {
            kat.push(kst.len());
            var x: i64 = 0;
            while x < nt {
                kst.push(stv.get(x));
                if rmk.get(x) == 1 {
                    rlist.push(x);
                }
                x = x + 1;
            }
        } else {
            kat.push(0 - 1);
        }
        if at == 0 {
            pmask = pmask | (1 << sk);
        } else {
            deferred = deferred + 1;
        }
        sblk.push(at);
        sk = sk + 1;
    }
    rat.push(rlist.len());
    if deferred == 0 {
        return res;
    }
    res.push(pmask);
    res.push(deferred);
    k = 0;
    while k < n {
        res.push(0);
        res.push(0 - 1);
        res.push(0);
        k = k + 1;
    }
    // where each deferred save goes: after the label of its block, or
    // after the instruction that falls into it (an edge block, or a block
    // without a label, which only its predecessor's fall-through enters)
    sk = 0;
    while sk < ns {
        var sb: i64 = sblk.get(sk);
        if sb != 0 {
            var after: i64 = 0;
            if sb >= nb {
                after = mb.end.get(sb - nb);
            } else if rec.mir.get(mb.start.get(sb)).op == MO_PLACE {
                after = mb.start.get(sb);
            } else {
                after = mb.start.get(sb) - 1;
            }
            res.set(2 + 3 * after, res.get(2 + 3 * after) | (1 << sk));
        }
        // the early restores: before the jump that ends a block, or after
        // the instruction that falls into an edge block's successor
        var rq: i64 = rat.get(sk);
        while rq < rat.get(sk + 1) {
            var rn: i64 = rlist.get(rq);
            var rpos: i64 = 0;
            if rn >= nb {
                rpos = mb.end.get(rn - nb);
            } else {
                rpos = mb.end.get(rn) - 1;
            }
            res.set(4 + 3 * rpos, res.get(4 + 3 * rpos) | (1 << sk));
            rq = rq + 1;
        }
        sk = sk + 1;
    }
    // what each exit restores: the registers saved on every way to it
    b = 0;
    while b < nb {
        if exitb.get(b) == 1 && dom.rnum.get(b) >= 0 {
            var rm: i64 = 0;
            sk = 0;
            while sk < ns {
                var saved: bool = false;
                if kat.get(sk) >= 0 {
                    saved = kst.get(kat.get(sk) + b) == 2;
                } else {
                    saved = ng_dom_has(&dom, sblk.get(sk), b);
                }
                if saved {
                    rm = rm | (1 << sk);
                }
                sk = sk + 1;
            }
            var e: i64 = mb.start.get(b);
            while e <= mb.end.get(b) {
                var eo: i64 = rec.mir.get(e).op;
                if eo == MO_EPILOGUE || eo == MO_CALL {
                    res.set(3 + 3 * e, rm);
                }
                e = e + 1;
            }
        }
        b = b + 1;
    }
    return res;
}

/// RA12: node s as a save point with restores (ng_sw_plan, when ng_sw_ok
/// rejects it because an exit it reaches lies past the part it
/// dominates): the register (`bit`) is restored at the end of each node
/// s dominates whose one successor s does not dominate (rok: an edge
/// block, or a block ending in a jump); rmk marks them. It qualifies when
/// no way leads from s back to itself, and over every way from the entry
/// (a forward walk of the two states, in stv: 1 not saved, 2 saved) the
/// state is one state where it matters: not saved on reaching s, saved on
/// reaching each restore node and each block naming the register, and
/// either at each exit (which then restores it or not). stv is left as
/// the state while each node runs (s: saved).
fn ng_sw_rest(s: i64, bit: i64, nb: i64, s0: &Vec<i64>, s1: &Vec<i64>, exitb: &Vec<i64>, touch: &Vec<i64>, rok: &Vec<i64>, dom: &NgDom, stv: &mut Vec<i64>, rmk: &mut Vec<i64>) -> bool {
    var nt: i64 = s0.len();
    stv.clear();
    rmk.clear();
    var seen: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nt {
        stv.push(0);
        rmk.push(0);
        seen.push(0);
        i = i + 1;
    }
    // no way from s back to itself
    var work: Vec<i64> = Vec::new();
    work.push(s);
    seen.set(s, 1);
    while work.len() > 0 {
        var x: i64 = work.get(work.len() - 1);
        work.truncate(work.len() - 1);
        var q: i64 = 0;
        while q < 2 {
            var y: i64 = s0.get(x);
            if q == 1 {
                y = s1.get(x);
            }
            if y == s {
                return false;
            }
            if y >= 0 && seen.get(y) == 0 {
                seen.set(y, 1);
                work.push(y);
            }
            q = q + 1;
        }
    }
    // the restore nodes
    var nr: i64 = 0;
    i = 0;
    while i < nt {
        if i != s && rok.get(i) == 1 && dom.rnum.get(i) >= 0 && ng_dom_has(dom, s, i) {
            var y2: i64 = s0.get(i);
            if y2 >= 0 && s1.get(i) < 0 && !ng_dom_has(dom, s, y2) {
                rmk.set(i, 1);
                nr = nr + 1;
            }
        }
        i = i + 1;
    }
    if nr == 0 {
        return false;
    }
    // the states on reaching each node, forward in reverse postorder until
    // nothing changes
    var ord: Vec<i64> = Vec::new();
    var nreach: i64 = 0;
    i = 0;
    while i < nt {
        ord.push(0);
        i = i + 1;
    }
    i = 0;
    while i < nt {
        if dom.rnum.get(i) >= 0 {
            ord.set(dom.rnum.get(i), i);
            nreach = nreach + 1;
        }
        i = i + 1;
    }
    stv.set(0, 1);
    var changed: bool = true;
    var rounds: i64 = 0;
    while changed && rounds < nt + 2 {
        changed = false;
        var r: i64 = 0;
        while r < nreach {
            var xn: i64 = ord.get(r);
            var o: i64 = stv.get(xn);
            if xn == s {
                o = 2;
            }
            if rmk.get(xn) == 1 {
                o = 1;
            }
            if o != 0 {
                var q2: i64 = 0;
                while q2 < 2 {
                    var yn: i64 = s0.get(xn);
                    if q2 == 1 {
                        yn = s1.get(xn);
                    }
                    if yn >= 0 && (stv.get(yn) | o) != stv.get(yn) {
                        stv.set(yn, stv.get(yn) | o);
                        changed = true;
                    }
                    q2 = q2 + 1;
                }
            }
            r = r + 1;
        }
        rounds = rounds + 1;
    }
    if changed || stv.get(s) != 1 {
        return false;
    }
    i = 0;
    while i < nt {
        if dom.rnum.get(i) >= 0 {
            var during: i64 = stv.get(i);
            if i == s {
                during = 2;
            }
            if rmk.get(i) == 1 && stv.get(i) != 2 {
                return false;
            }
            if i < nb && (touch.get(i) & bit) != 0 && during != 2 {
                return false;
            }
            if i < nb && exitb.get(i) == 1 && during != 1 && during != 2 {
                return false;
            }
        }
        i = i + 1;
    }
    stv.set(s, 2);
    return true;
}

/// RA12: node s qualifies as a save point (ng_sw_plan): no way leads from
/// it back to itself, and every exit block (exitb) it reaches is one it
/// dominates. Nodes below nb are blocks, the others edge blocks.
fn ng_sw_ok(s: i64, nb: i64, s0: &Vec<i64>, s1: &Vec<i64>, exitb: &Vec<i64>, dom: &NgDom) -> bool {
    var nt: i64 = s0.len();
    var seen: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nt {
        seen.push(0);
        i = i + 1;
    }
    var work: Vec<i64> = Vec::new();
    work.push(s);
    seen.set(s, 1);
    while work.len() > 0 {
        var x: i64 = work.get(work.len() - 1);
        work.truncate(work.len() - 1);
        if x < nb && exitb.get(x) == 1 && !ng_dom_has(dom, s, x) {
            return false;
        }
        var q: i64 = 0;
        while q < 2 {
            var y: i64 = s0.get(x);
            if q == 1 {
                y = s1.get(x);
            }
            if y == s {
                return false;
            }
            if y >= 0 && seen.get(y) == 0 {
                seen.set(y, 1);
                work.push(y);
            }
            q = q + 1;
        }
    }
    return true;
}

/// Dominators of a graph whose nodes have two successors at most (RA12,
/// RA19), entered at node 0: idom (-1: not reachable; the entry is its
/// own), rnum (the reverse-postorder number, -1: not reachable), and pre /
/// post (the order the dominator tree is entered and left: a dominates b
/// when pre[a] <= pre[b] and post[b] <= post[a], ng_dom_has).
pub struct NgDom {
    pub idom: Vec<i64>,
    pub rnum: Vec<i64>,
    pub pre: Vec<i64>,
    pub post: Vec<i64>,
}

/// The dominator tree of the graph s0 / s1 (successors, -1: none) from node
/// 0, by Cooper, Harvey and Kennedy's iteration over reverse postorder.
fn ng_dom_build(s0: &Vec<i64>, s1: &Vec<i64>) -> NgDom {
    var nt: i64 = s0.len();
    var idom: Vec<i64> = Vec::new();
    var rnum: Vec<i64> = Vec::new();
    var pre: Vec<i64> = Vec::new();
    var post: Vec<i64> = Vec::new();
    var state: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nt {
        idom.push(0 - 1);
        rnum.push(0 - 1);
        pre.push(0 - 1);
        post.push(0 - 1);
        state.push(0);
        i = i + 1;
    }
    if nt == 0 {
        return NgDom {
            idom: idom, rnum: rnum, pre: pre, post: post
        };
    }
    // postorder from node 0, by an explicit stack (node, next successor)
    var order: Vec<i64> = Vec::new();
    var stk: Vec<i64> = Vec::new();
    var nxt: Vec<i64> = Vec::new();
    stk.push(0);
    nxt.push(0);
    state.set(0, 1);
    while stk.len() > 0 {
        var top: i64 = stk.get(stk.len() - 1);
        var e: i64 = nxt.get(nxt.len() - 1);
        if e < 2 {
            nxt.set(nxt.len() - 1, e + 1);
            var y: i64 = s0.get(top);
            if e == 1 {
                y = s1.get(top);
            }
            if y >= 0 && state.get(y) == 0 {
                state.set(y, 1);
                stk.push(y);
                nxt.push(0);
            }
        } else {
            order.push(top);
            stk.truncate(stk.len() - 1);
            nxt.truncate(nxt.len() - 1);
        }
    }
    var nr: i64 = order.len();
    i = 0;
    while i < nr {
        rnum.set(order.get(i), nr - 1 - i);
        i = i + 1;
    }
    // predecessors of the reachable nodes, as offsets into one list
    var poff: Vec<i64> = Vec::new();
    i = 0;
    while i <= nt {
        poff.push(0);
        i = i + 1;
    }
    i = 0;
    while i < nt {
        if rnum.get(i) >= 0 {
            if s0.get(i) >= 0 {
                poff.set(s0.get(i) + 1, poff.get(s0.get(i) + 1) + 1);
            }
            if s1.get(i) >= 0 {
                poff.set(s1.get(i) + 1, poff.get(s1.get(i) + 1) + 1);
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < nt {
        poff.set(i + 1, poff.get(i + 1) + poff.get(i));
        i = i + 1;
    }
    var plist: Vec<i64> = Vec::new();
    var fill: Vec<i64> = Vec::new();
    i = 0;
    while i < nt {
        fill.push(poff.get(i));
        i = i + 1;
    }
    i = 0;
    while i < poff.get(nt) {
        plist.push(0);
        i = i + 1;
    }
    i = 0;
    while i < nt {
        if rnum.get(i) >= 0 {
            var w: i64 = 0;
            while w < 2 {
                var to: i64 = s0.get(i);
                if w == 1 {
                    to = s1.get(i);
                }
                if to >= 0 {
                    plist.set(fill.get(to), i);
                    fill.set(to, fill.get(to) + 1);
                }
                w = w + 1;
            }
        }
        i = i + 1;
    }
    idom.set(0, 0);
    var changed: bool = true;
    while changed {
        changed = false;
        // reverse postorder after the entry (order's last)
        var oi: i64 = nr - 2;
        while oi >= 0 {
            var bb: i64 = order.get(oi);
            var nd: i64 = 0 - 1;
            var pi: i64 = poff.get(bb);
            while pi < poff.get(bb + 1) {
                var p: i64 = plist.get(pi);
                if idom.get(p) >= 0 {
                    if nd < 0 {
                        nd = p;
                    } else {
                        nd = ng_dom_isect(&idom, &rnum, p, nd);
                    }
                }
                pi = pi + 1;
            }
            if nd != idom.get(bb) {
                idom.set(bb, nd);
                changed = true;
            }
            oi = oi - 1;
        }
    }
    // the dominator tree's children, then its preorder and postorder
    var coff: Vec<i64> = Vec::new();
    i = 0;
    while i <= nt {
        coff.push(0);
        i = i + 1;
    }
    i = 1;
    while i < nt {
        if rnum.get(i) >= 0 && idom.get(i) >= 0 && idom.get(i) != i {
            coff.set(idom.get(i) + 1, coff.get(idom.get(i) + 1) + 1);
        }
        i = i + 1;
    }
    i = 0;
    while i < nt {
        coff.set(i + 1, coff.get(i + 1) + coff.get(i));
        i = i + 1;
    }
    var clist: Vec<i64> = Vec::new();
    var cfill: Vec<i64> = Vec::new();
    i = 0;
    while i < nt {
        cfill.push(coff.get(i));
        i = i + 1;
    }
    i = 0;
    while i < coff.get(nt) {
        clist.push(0);
        i = i + 1;
    }
    i = 1;
    while i < nt {
        if rnum.get(i) >= 0 && idom.get(i) >= 0 && idom.get(i) != i {
            clist.set(cfill.get(idom.get(i)), i);
            cfill.set(idom.get(i), cfill.get(idom.get(i)) + 1);
        }
        i = i + 1;
    }
    var clk_in: i64 = 0;
    var clk_out: i64 = 0;
    stk.clear();
    nxt.clear();
    stk.push(0);
    nxt.push(0);
    pre.set(0, clk_in);
    clk_in = clk_in + 1;
    while stk.len() > 0 {
        var tn: i64 = stk.get(stk.len() - 1);
        var ci: i64 = nxt.get(nxt.len() - 1);
        if coff.get(tn) + ci < coff.get(tn + 1) {
            nxt.set(nxt.len() - 1, ci + 1);
            var ch: i64 = clist.get(coff.get(tn) + ci);
            pre.set(ch, clk_in);
            clk_in = clk_in + 1;
            stk.push(ch);
            nxt.push(0);
        } else {
            post.set(tn, clk_out);
            clk_out = clk_out + 1;
            stk.truncate(stk.len() - 1);
            nxt.truncate(nxt.len() - 1);
        }
    }
    return NgDom {
        idom: idom, rnum: rnum, pre: pre, post: post
    };
}

/// The nearest common dominator of reachable nodes a and b (ng_dom_build).
fn ng_dom_isect(idom: &Vec<i64>, rnum: &Vec<i64>, a: i64, b: i64) -> i64 {
    var x: i64 = a;
    var y: i64 = b;
    while x != y {
        while rnum.get(x) > rnum.get(y) {
            x = idom.get(x);
        }
        while rnum.get(y) > rnum.get(x) {
            y = idom.get(y);
        }
    }
    return x;
}

/// Node a dominates node b (both reachable; a node dominates itself).
fn ng_dom_has(d: &NgDom, a: i64, b: i64) -> bool {
    if a < 0 || b < 0 || d.pre.get(a) < 0 || d.pre.get(b) < 0 {
        return false;
    }
    return d.pre.get(a) <= d.pre.get(b) && d.post.get(b) <= d.post.get(a);
}

/// MI29: the page size the stack probes step by. A frame larger than this
/// could otherwise move sp past a stack's guard page in one step, so its
/// first access lands in whatever is mapped below (another thread's or
/// task's stack) instead of faulting as a stack overflow; Windows also
/// commits its stacks one guard page at a time.
const NG_PAGE: i64 = 4096;

/// MI29: reserve `frame` (> NG_PAGE) bytes below sp one page at a time,
/// touching each page as sp reaches it (a store of a register that is
/// already in the new frame's memory, so nothing is lost), then the rest,
/// whose last word is touched too. Up to two pages are unrolled; more go
/// through a counted loop in the address scratch register ad (free at
/// entry: it never holds a value). `FID_NAT_OFF=probe`: one subtraction,
/// as before. The frame pointer is already set, so the epilogue is as
/// for any frame.
fn ng_probe_frame(g: &mut NatGen, frame: i64) {
    var pages: i64 = frame / NG_PAGE;
    var rest: i64 = frame - pages * NG_PAGE;
    if ng_x64(g) {
        if pages <= 2 {
            var k: i64 = 0;
            while k < pages {
                x64_sub_imm(&mut g.e, 4, NG_PAGE);
                x64_store(&mut g.e, 5, 4, 0, 8);
                // mov [rsp], rbp
                k = k + 1;
            }
        } else {
            x64_li(&mut g.e, g.ad, pages);
            var top: i64 = NatEnc_label(&mut g.e);
            NatEnc_place(&mut g.e, top);
            x64_sub_imm(&mut g.e, 4, NG_PAGE);
            x64_store(&mut g.e, 5, 4, 0, 8);
            x64_sub_imm(&mut g.e, g.ad, 1);
            x64_jcc(&mut g.e, X64_NE, top);
        }
        if rest > 0 {
            x64_sub_imm(&mut g.e, 4, rest);
            x64_store(&mut g.e, 5, 4, 0, 8);
        }
        return;
    }
    if ng_a64(g) {
        if pages <= 2 {
            var k2: i64 = 0;
            while k2 < pages {
                a64_sub_imm_lsl12(&mut g.e, A64_SP, A64_SP, 1);
                a64_str(&mut g.e, A64_ZR, A64_SP, 0);
                // str xzr, [sp]
                k2 = k2 + 1;
            }
        } else {
            a64_li(&mut g.e, g.ad, pages);
            var top2: i64 = NatEnc_label(&mut g.e);
            NatEnc_place(&mut g.e, top2);
            a64_sub_imm_lsl12(&mut g.e, A64_SP, A64_SP, 1);
            a64_str(&mut g.e, A64_ZR, A64_SP, 0);
            a64_sub_imm(&mut g.e, g.ad, g.ad, 1);
            a64_cbnz(&mut g.e, g.ad, top2);
        }
        if rest > 0 {
            a64_sub_imm(&mut g.e, A64_SP, A64_SP, rest);
            a64_str(&mut g.e, A64_ZR, A64_SP, 0);
        }
        return;
    }
    // RISC-V: the page size in ad2 (no 12-bit immediate holds it)
    rv_li(&mut g.e, g.ad2, NG_PAGE);
    if pages <= 2 {
        var k3: i64 = 0;
        while k3 < pages {
            rv_sub(&mut g.e, RV_SP, RV_SP, g.ad2);
            rv_store(&mut g.e, RV_ZERO, RV_SP, 0, 8);
            // sd zero, 0(sp)
            k3 = k3 + 1;
        }
    } else {
        rv_li(&mut g.e, g.ad, pages);
        // sub sp, sp, ad2; sd zero, 0(sp); addi ad, ad, -1; bne ad, zero, -12
        rv_sub(&mut g.e, RV_SP, RV_SP, g.ad2);
        rv_store(&mut g.e, RV_ZERO, RV_SP, 0, 8);
        rv_addi(&mut g.e, g.ad, g.ad, 0 - 1);
        rv_b_off(&mut g.e, RV_BNE, g.ad, RV_ZERO, 0 - 12);
    }
    if rest > 0 {
        if rest <= 2048 {
            rv_addi(&mut g.e, RV_SP, RV_SP, 0 - rest);
        } else {
            rv_li(&mut g.e, g.ad2, rest);
            rv_sub(&mut g.e, RV_SP, RV_SP, g.ad2);
        }
        rv_store(&mut g.e, RV_ZERO, RV_SP, 0, 8);
    }
}

/// RA13: save registers k and k + 1 go together with stp/ldp at sp + off
/// (AArch64, the offset in reach; `FID_NAT_OFF=pairs`: one at a time).
/// RA18: both general registers or both float registers (stp x / stp d).
fn ng_pair_ok(g: &NatGen, k: i64, off: i64) -> bool {
    if !ng_a64(g) || k + 1 >= g.save_regs.len() {
        return false;
    }
    if ng_is_freg(g, g.save_regs.get(k)) != ng_is_freg(g, g.save_regs.get(k + 1)) {
        return false;
    }
    return a64_ldstp_fits(off) && ng_on("pairs");
}

fn ng_epilogue(g: &mut NatGen) {
    if g.rec {
        ng_rec(g, MO_EPILOGUE, 0, 0, 0, 0, 0, 0);
        return;
    }
    // WP8: a leaf function needs no frame record — just the return
    if g.leaf > 0 {
        // LF20: (a leaf has no frame) nor in a scratch register
        if g.wipe_on {
            ng_wipe_regs(g);
        }
        if ng_x64(g) {
            x64_ret(&mut g.e);
        } else if ng_a64(g) {
            a64_ret(&mut g.e);
        } else {
            rv_ret(&mut g.e);
        }
        return;
    }
    // LF20: a function holding a secret leaves no copy of it in its frame
    if g.wipe > 0 {
        ng_wipe_frame(g, g.wipe);
    }
    // LF20: nor in a register no call keeps (ng_wipe_regs)
    if g.wipe_on {
        ng_wipe_regs(g);
    }
    // (RA12: an early exit restores only what its prologue saved,
    // g.sw_ep)
    var sw_ep: i64 = g.sw_ep;
    ng_restore_subset(g, sw_ep);
    // DB6: where the frame record is gone, for the CFI (ng_cfi_row)
    if ng_x64(g) {
        x64_mov(&mut g.e, 4, 5);
        // mov rsp, rbp
        x64_pop(&mut g.e, 5);
        var xp: i64 = NatEnc_pos(&g.e);
        x64_ret(&mut g.e);
        ng_cfi_row(g, xp, 0 - 1);
        return;
    }
    if ng_a64(g) {
        a64_add_imm(&mut g.e, A64_SP, A64_FP, 0);
        // mov sp, x29
        NatEnc_word(&mut g.e, 0xA8C17BFD);
        // ldp x29, x30, [sp], #16
        var ap: i64 = NatEnc_pos(&g.e);
        a64_ret(&mut g.e);
        ng_cfi_row(g, ap, 0 - 1);
    } else {
        rv_addi(&mut g.e, RV_SP, RV_S0, 0 - 16);
        rv_load(&mut g.e, RV_RA, RV_SP, 8, 8, true);
        rv_load(&mut g.e, RV_S0, RV_SP, 0, 8, true);
        var rp: i64 = NatEnc_pos(&g.e);
        rv_addi(&mut g.e, RV_SP, RV_SP, 16);
        var rp2: i64 = NatEnc_pos(&g.e);
        rv_ret(&mut g.e);
        ng_cfi_row(g, rp, rp2);
    }
}

/// DB6: an epilogue of a framed function for .debug_frame
/// (nat_elf_debug): from p1 the CFA is sp-based again and the frame
/// pointer and return address are back in their registers; RISC-V's
/// final `addi sp` ends at p2; the function's body rules hold again from
/// here (after the ret), should more code follow.
fn ng_cfi_row(g: &mut NatGen, p1: i64, p2: i64) {
    g.cfi_rows.push(p1);
    g.cfi_rows.push(p2);
    g.cfi_rows.push(NatEnc_pos(&g.e));
}

/// OP13: a sibling call in tail position (ng_tail_at) as a jump: the frame
/// goes as at a return (callee-saved registers back, the frame record
/// popped, LF20's wipe first), then a jump to `label`, so the callee
/// returns to this function's caller with its result in the result
/// register. The arguments are in their registers already, and stack
/// arguments in this function's incoming argument area (MI28,
/// ng_tail_stack_ok / ng_st_incoming), which the epilogue leaves alone and
/// the callee reads from the same stack pointer. RISC-V jumps through the address
/// scratch register (t6 may hold an internal call's ninth argument).
fn ng_epilogue_tail(g: &mut NatGen, label: i64) {
    if g.wipe > 0 {
        ng_wipe_frame(g, g.wipe);
    }
    // (RA12: only what was saved on every way here, g.sw_ep; -1: all,
    // in pairs on AArch64 as before)
    var sw_ep: i64 = g.sw_ep;
    ng_restore_subset(g, sw_ep);
    if ng_x64(g) {
        x64_mov(&mut g.e, 4, 5);
        // mov rsp, rbp
        x64_pop(&mut g.e, 5);
        var xp: i64 = NatEnc_pos(&g.e);
        x64_jmp(&mut g.e, label);
        ng_cfi_row(g, xp, 0 - 1);
        return;
    }
    if ng_a64(g) {
        a64_add_imm(&mut g.e, A64_SP, A64_FP, 0);
        // mov sp, x29
        NatEnc_word(&mut g.e, 0xA8C17BFD);
        // ldp x29, x30, [sp], #16
        var ap: i64 = NatEnc_pos(&g.e);
        a64_b(&mut g.e, label);
        ng_cfi_row(g, ap, 0 - 1);
        return;
    }
    rv_addi(&mut g.e, RV_SP, RV_S0, 0 - 16);
    rv_load(&mut g.e, RV_RA, RV_SP, 8, 8, true);
    rv_load(&mut g.e, RV_S0, RV_SP, 0, 8, true);
    var rp: i64 = NatEnc_pos(&g.e);
    rv_addi(&mut g.e, RV_SP, RV_SP, 16);
    var rp2: i64 = NatEnc_pos(&g.e);
    // auipc ad, hi(label); jalr zero, lo(label)(ad)
    NatEnc_fix(&mut g.e, label, NATFIX_RV_AUIPC_I);
    NatEnc_word(&mut g.e, (g.ad << 7) | 0x17);
    rv_jalr(&mut g.e, RV_ZERO, g.ad, 0);
    ng_cfi_row(g, rp, rp2);
}

/// LF20: zero `bytes` (a multiple of 8) at sp: every spill slot, value
/// slot, local and outgoing argument of the frame, so no copy of a secret
/// outlives the call. Only registers no value is in at an epilogue: the
/// address scratch registers ad / ad2, and on x86-64 rax for the zero (the
/// result is in rdi, a second word in rsi). AArch64 and RISC-V store their
/// zero register.
fn ng_wipe_frame(g: &mut NatGen, bytes: i64) {
    var words: i64 = bytes / 8;
    if words <= 0 {
        return;
    }
    var z: i64 = g.zr;
    if ng_x64(g) {
        z = 0;
        x64_li(&mut g.e, z, 0);
    }
    if words <= 16 {
        var k: i64 = 0;
        while k < words {
            ng_st_slot(g, 8 * k, z);
            k = k + 1;
        }
        return;
    }
    ng_slot_addr(g, g.ad, 0);
    ng_li(g, g.ad2, words);
    var top: i64 = NatEnc_label(&mut g.e);
    NatEnc_place(&mut g.e, top);
    ng_store(g, g.ad, 0, z, 8);
    if ng_x64(g) {
        x64_add_imm(&mut g.e, g.ad, 8);
        x64_sub_imm(&mut g.e, g.ad2, 1);
        x64_jcc(&mut g.e, X64_NE, top);
    } else if ng_a64(g) {
        a64_add_imm(&mut g.e, g.ad, g.ad, 8);
        a64_sub_imm(&mut g.e, g.ad2, g.ad2, 1);
        a64_cbnz(&mut g.e, g.ad2, top);
    } else {
        // sd zero, 0(ad); addi ad, ad, 8; addi ad2, ad2, -1; bne ad2, zero, -12
        rv_addi(&mut g.e, g.ad, g.ad, 8);
        rv_addi(&mut g.e, g.ad2, g.ad2, 0 - 1);
        rv_b_off(&mut g.e, RV_BNE, g.ad2, RV_ZERO, 0 - 12);
    }
}

// --- LF20: scratch registers of a function holding a secret ---------------
// pe_ir clears rcx, rdx, r8-r11 and xmm0-xmm5 before a secret function
// returns (PeirGen_wipe_frame). The machine layer does the same at every
// return of a function holding a secret (NatFnRec.secret), leaf or not:
// it zeroes each register the internal convention lets any call clobber,
// so no caller can count on it and no copy of a secret stays in it:
//   integer: x86-64 rax, rcx, rdx, rsi, rdi, r8..r11; AArch64 x0..x17
//     (not x18, the platform register); RISC-V t0..t6 and a0..a7 (not ra,
//     sp, gp, tp, s0) — less argument register 0, which holds the result
//     (Inst::Return), and argument register 1 when the function returns a
//     struct in two registers (ME27, ng_rr_plan: size 16). A caller-saved
//     pool register (AArch64 x8..x11, RISC-V t4) only when the function's
//     clobber mask holds it (it or a callee wrote it): IPRA callers keep
//     values in the others across the call (ng_call_mask);
//   float and vector: x86-64 xmm0..xmm15 (pxor; --nat Windows with floats
//     off: xmm0..xmm5, which Windows' own convention lets go too);
//     AArch64 v0..v7 and v16..v31 (fmov d, xzr clears the whole register;
//     d8..d15 are callee-saved, RA18); RISC-V ft0..ft7, fa0..fa7,
//     ft8..ft11 (fmv.d.x f, zero; fs0..fs11 are callee-saved, RA18).
// The vector registers of RISC-V's V extension are not cleared. Such a
// function makes no sibling-call jump (ng_tail_fn_ok): a jump keeps the
// callee's arguments in their registers. Set by ng_wipe_setup for the
// function being emitted (ng_mir_emit_pass) or allocated (the `--stats`
// line). `FID_NAT_OFF=wiperegs`: the registers stay as they are (the frame
// is still wiped, `wipe`). The decision is NatGen.wipe_on, wipe_regs and
// wipe_keep1 (SP5: in the generator, so each worker thread of the
// parallel emission has its own).

/// LF20: decide the register wipe of `rec`, whose clobber mask is `mask`.
fn ng_wipe_setup(g: &mut NatGen, rec: &NatFnRec, mask: i64) {
    g.wipe_on = rec.secret && ng_on("wipe") && ng_on("wiperegs");
    g.wipe_regs = mask;
    g.wipe_keep1 = false;
    if g.wipe_on && HashMap_contains(g.fn_labels, rec.name) {
        var wl: i64 = HashMap_get(g.fn_labels, rec.name);
        g.wipe_keep1 = HashMap_contains_i(g.rr_size, wl) && HashMap_get_i(g.rr_size, wl) > 8;
    }
}

/// LF20: integer register r is one no call keeps (see above).
fn ng_wipe_int_ok(g: &NatGen, r: i64) -> bool {
    if ng_x64(g) {
        return r == 0 || r == 1 || r == 2 || r == 6 || r == 7 || (r >= 8 && r <= 11);
    }
    if ng_a64(g) {
        return r >= 0 && r <= 17;
    }
    return (r >= 5 && r <= 7) || (r >= 10 && r <= 17) || (r >= 28 && r <= 31);
}

/// LF20: integer register r is zeroed at a return of the function set up
/// by ng_wipe_setup (not a result, a pool register only when written).
fn ng_wipe_int_take(g: &NatGen, r: i64) -> bool {
    if !ng_wipe_int_ok(g, r) || r == ng_argreg(g, 0) {
        return false;
    }
    if g.wipe_keep1 && r == ng_argreg(g, 1) {
        return false;
    }
    if (g.td.int_caller_mask & (1 << r)) != 0 && (g.wipe_regs & (1 << r)) == 0 {
        return false;
    }
    return true;
}

/// LF20: float / vector register f is one no call keeps (see above).
fn ng_wipe_float_ok(g: &NatGen, f: i64) -> bool {
    if ng_x64(g) {
        if g.win && !ng_fregs_on(g) {
            return f >= 0 && f < 6;
        }
        return f >= 0 && f < 16;
    }
    if ng_a64(g) {
        return (f >= 0 && f < 8) || (f >= 16 && f < 32);
    }
    return (f >= 0 && f < 8) || (f >= 10 && f <= 17) || (f >= 28 && f < 32);
}

/// LF20: how many registers each return zeroes (the `--stats` line).
fn ng_wipe_reg_count(g: &NatGen) -> i64 {
    var n: i64 = 0;
    var r: i64 = 0;
    while r < 32 {
        if ng_wipe_int_take(g, r) {
            n = n + 1;
        }
        if ng_wipe_float_ok(g, r) {
            n = n + 1;
        }
        r = r + 1;
    }
    return n;
}

/// LF20: zero the registers of a return of a function holding a secret
/// (emission only; after the frame wipe, before the saved registers come
/// back: none of these is a saved one).
fn ng_wipe_regs(g: &mut NatGen) {
    var r: i64 = 0;
    while r < 32 {
        if ng_wipe_int_take(g, r) {
            ng_li(g, r, 0);
        }
        r = r + 1;
    }
    var f: i64 = 0;
    while f < 32 {
        if ng_wipe_float_ok(g, f) {
            if ng_x64(g) {
                // pxor xmm f, xmm f
                x64_sse(&mut g.e, 0x66, 0xEF, f, f);
            } else if ng_a64(g) {
                // fmov d f, xzr (the upper half of v f cleared too)
                a64_fmov_dx(&mut g.e, f, 31);
            } else {
                // fmv.d.x f, zero
                rv_fmv_dx(&mut g.e, f, RV_ZERO);
            }
        }
        f = f + 1;
    }
}

/// r = incoming stack argument k (argument 8 + k)
fn ng_ld_incoming(g: &mut NatGen, r: i64, k: i64) {
    if g.rec {
        ng_rec(g, MO_LDIN, r, 0, 0, k, 0, 0);
        return;
    }
    if ng_x64(g) {
        x64_load(&mut g.e, r, 5, 16 + 8 * k, 8, true);
        return;
    }
    if ng_a64(g) {
        ng_load(g, r, A64_FP, 16 + 8 * k, 8, true);
    } else {
        ng_load(g, r, RV_S0, 8 * k, 8, true);
    }
}

/// [sp + off] = r for an outgoing stack argument
fn ng_st_outgoing(g: &mut NatGen, k: i64, r: i64) {
    if g.rec {
        ng_rec(g, MO_STOUT, r, 0, 0, k, 0, 0);
        return;
    }
    ng_st_slot(g, 8 * k, r);
}

/// MI28: incoming stack argument k = r (emission only): a tail call's own
/// stack argument k goes where this function's caller put this function's
/// k-th one (the slot ng_ld_incoming reads), which is where the callee,
/// entered with the same stack pointer after ng_epilogue_tail, reads it.
fn ng_st_incoming(g: &mut NatGen, k: i64, r: i64) {
    if ng_x64(g) {
        x64_store(&mut g.e, r, 5, 16 + 8 * k, 8);
        return;
    }
    if ng_a64(g) {
        ng_store(g, A64_FP, 16 + 8 * k, r, 8);
    } else {
        ng_store(g, RV_S0, 8 * k, r, 8);
    }
}

/// Copy `size` bytes from the address in src to the address in dst (src
/// and dst are kept). The word in flight is ad2; a long copy walks ad over
/// dst and x13 / t6 over src, counting in the third spill register: none of
/// them ever holds a value, so a copy clobbers nothing allocated.
fn ng_copy(g: &mut NatGen, dst: i64, src: i64, size: i64) {
    if g.rec {
        ng_rec(g, MO_COPY, dst, src, 0, size, 0, 0);
        return;
    }
    var w: i64 = g.ad2;
    var off: i64 = 0;
    if size <= 256 {
        while off + 8 <= size {
            ng_load(g, w, src, off, 8, false);
            ng_store(g, dst, off, w, 8);
            off = off + 8;
        }
        while off < size {
            ng_load(g, w, src, off, 1, false);
            ng_store(g, dst, off, w, 1);
            off = off + 1;
        }
        return;
    }
    var words: i64 = size / 8;
    var cs: i64 = 13;
    if !ng_a64(g) {
        cs = 31;
    }
    if ng_x64(g) {
        cs = 2;
    }
    var cn: i64 = ng_spill_reg(g, 2);
    var top: i64 = NatEnc_label(&mut g.e);
    ng_mov(g, g.ad, dst);
    ng_mov(g, cs, src);
    ng_li(g, cn, words);
    NatEnc_place(&mut g.e, top);
    if ng_x64(g) {
        x64_load(&mut g.e, w, cs, 0, 8, true);
        x64_store(&mut g.e, w, g.ad, 0, 8);
        x64_add_imm(&mut g.e, cs, 8);
        x64_add_imm(&mut g.e, g.ad, 8);
        x64_sub_imm(&mut g.e, cn, 1);
        x64_jcc(&mut g.e, X64_NE, top);
    } else if ng_a64(g) {
        a64_ldr(&mut g.e, w, cs, 0);
        a64_str(&mut g.e, w, g.ad, 0);
        a64_add_imm(&mut g.e, cs, cs, 8);
        a64_add_imm(&mut g.e, g.ad, g.ad, 8);
        a64_sub_imm(&mut g.e, cn, cn, 1);
        a64_cbnz(&mut g.e, cn, top);
    } else {
        rv_load(&mut g.e, w, cs, 0, 8, true);
        rv_store(&mut g.e, w, g.ad, 0, 8);
        rv_addi(&mut g.e, cs, cs, 8);
        rv_addi(&mut g.e, g.ad, g.ad, 8);
        rv_addi(&mut g.e, cn, cn, 0 - 1);
        rv_b_off(&mut g.e, RV_BEQ, cn, RV_ZERO, 8);
        rv_jal(&mut g.e, RV_ZERO, top);
    }
    // The bytes after the last word, from the cursors
    var t: i64 = 0;
    while t < size - words * 8 {
        ng_load(g, w, cs, t, 1, false);
        ng_store(g, g.ad, t, w, 1);
        t = t + 1;
    }
}

// ===========================================================================
// Names: functions, strings, globals
// ===========================================================================

fn ng_has_fn(g: &NatGen, name: str) -> bool {
    return HashMap_contains(g.all_fns, name);
}

/// The runtime function the Linux signal handlers call: DB9's
/// pe_on_signal_uc(sig, info, uc) when the runtime has it (base.fd: the
/// profiler's SIGPROF, then pe_on_signal), else pe_on_signal(sig, info);
/// "" when there is neither.
fn ng_sig_fn(g: &NatGen) -> str {
    if ng_has_fn(g, "pe_on_signal_uc") {
        return "pe_on_signal_uc";
    }
    if ng_has_fn(g, "pe_on_signal") {
        return "pe_on_signal";
    }
    return "";
}

/// The function a call to `name` runs: a pe_runtime_alias (p_vec_* ->
/// core's Vec_*), the runtime's pert_X for builtin p_X, else `name`.
fn ng_resolve(g: &NatGen, name: str) -> str {
    var alias: str = pe_runtime_alias(name);
    if alias != name {
        return alias;
    }
    var p: str = pert_name(name);
    if p != "" && ng_has_fn(g, p) {
        return p;
    }
    return name;
}

/// The label of function `name`, queueing it for compilation; 0 when the
/// program defines no such function and it is not a primitive.
fn ng_fn_label(g: &mut NatGen, name: str) -> i64 {
    if g_nc_log_on {
        nc_log("F:" + name);
    }
    if HashMap_contains(g.fn_labels, name) {
        return HashMap_get(g.fn_labels, name);
    }
    if !ng_has_fn(g, name) {
        return 0;
    }
    var l: i64 = NatEnc_label(&mut g.e);
    HashMap_insert(g.fn_labels, name, l);
    g.fn_label_names.push(name);
    g.queue.push(name);
    return l;
}

fn ng_unresolved(g: &mut NatGen, name: str) {
    var key: str = name + " (from " + g.cur_name + ")";
    if !HashMap_contains(g.unresolved_seen, name) {
        HashMap_insert(g.unresolved_seen, name, 1);
        g.unresolved.push(key);
    }
}

fn ng_str_label(g: &mut NatGen, s: str) -> i64 {
    if g_nc_log_on {
        nc_log("S:" + s);
    }
    if HashMap_contains(g.str_labels, s) {
        return HashMap_get(g.str_labels, s);
    }
    var l: i64 = NatEnc_label(&mut g.e);
    HashMap_insert(g.str_labels, s, l);
    g.strs.push(s);
    return l;
}

fn ng_glob_label(g: &mut NatGen, name: str) -> i64 {
    if g_nc_log_on {
        nc_log("G:" + name);
    }
    if HashMap_contains(g.glob_labels, name) {
        return HashMap_get(g.glob_labels, name);
    }
    var l: i64 = NatEnc_label(&mut g.e);
    HashMap_insert(g.glob_labels, name, l);
    g.globs.push(name);
    return l;
}

/// A string naming a program function (a thread or task entry): compiled,
/// and found by name at run time (nat_fn_table).
fn ng_named_fn(g: &mut NatGen, value: str) {
    if ng_has_fn(g, value) && !HashMap_contains(g.named_seen, value) {
        HashMap_insert(g.named_seen, value, 1);
        ng_fn_label(g, value);
        g.named_fns.push(value);
    }
    if g_nc_log_on {
        nc_log("N:" + value);
    }
}

// SP6/SP20: while a function is recorded under the CS6 cache, the labels it
// asks for (functions, strings, globals, functions named by strings), in
// order and once each. A cache hit records nothing, so its skeleton asks
// for the same labels in the same order (nc_skel_fn): the queue, the
// strings, the globals and the function table come out as in a fresh build
// (before, a hit's strings were registered only when its fixups replayed,
// later, and a string naming a thread entry not at all).
var g_nc_log_on: bool = false;
var g_nc_log: Vec<str> = Vec::new();
var g_nc_log_seen: i64 = 0;
// name -> start + 1 / length of its log in g_nc_logs
var g_nc_logs: Vec<str> = Vec::new();
var g_nc_log_at: i64 = 0;
var g_nc_log_len: i64 = 0;

fn nc_log(s: str) {
    if HashMap_contains(g_nc_log_seen, s) {
        return;
    }
    HashMap_insert(g_nc_log_seen, s, 1);
    g_nc_log.push(s);
}

/// Start logging the recording of a function (the cache is on).
fn nc_log_begin() {
    if g_nc_log_at == 0 {
        g_nc_log_at = HashMap_new();
        g_nc_log_len = HashMap_new();
    }
    g_nc_log = Vec::new();
    g_nc_log_seen = HashMap_new();
    g_nc_log_on = true;
}

/// Stop logging; keep function `name`'s log for its cache entry.
fn nc_log_end(name: str) {
    g_nc_log_on = false;
    HashMap_insert(g_nc_log_at, name, g_nc_logs.len() + 1);
    HashMap_insert(g_nc_log_len, name, g_nc_log.len());
    var i: i64 = 0;
    while i < g_nc_log.len() {
        g_nc_logs.push(g_nc_log.get(i));
        i = i + 1;
    }
}

/// Function `name`'s recorded log (empty when it was not recorded here).
fn nc_log_of(name: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if g_nc_log_at == 0 || !HashMap_contains(g_nc_log_at, name) {
        return out;
    }
    var at: i64 = HashMap_get(g_nc_log_at, name) - 1;
    var n: i64 = HashMap_get(g_nc_log_len, name);
    var i: i64 = 0;
    while i < n {
        out.push(g_nc_logs.get(at + i));
        i = i + 1;
    }
    return out;
}

/// A hit asks again for what its recording asked for (nc_log).
fn nc_log_replay(g: &mut NatGen, log: &Vec<str>) {
    var i: i64 = 0;
    while i < log.len() {
        var s: str = log.get(i);
        var v: str = str_slice(s, 2, str_len(s));
        if str_starts_with(s, "F:") {
            ng_fn_label(g, v);
        } else if str_starts_with(s, "S:") {
            ng_str_label(g, v);
        } else if str_starts_with(s, "G:") {
            ng_glob_label(g, v);
        } else if str_starts_with(s, "N:") {
            ng_named_fn(g, v);
        }
        i = i + 1;
    }
}

fn ng_dyn_id(g: &NatGen, name: str) -> i64 {
    var i: i64 = 0;
    while i < g.dyn_types.len() {
        if g.dyn_types.get(i) == name {
            return i + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn ng_insert_sorted(v: Vec<str>, s: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var placed: bool = false;
    var i: i64 = 0;
    while i < v.len() {
        var x: str = v.get(i);
        if x == s {
            return v;
        }
        if !placed && str_compare(x, s) > 0 {
            out.push(s);
            placed = true;
        }
        out.push(x);
        i = i + 1;
    }
    if !placed {
        out.push(s);
    }
    return out;
}

// ===========================================================================
// Values
// ===========================================================================

fn ng_slot(g: &NatGen, id: i64) -> i64 {
    if id < 0 || id >= g.slots.len() {
        return -1;
    }
    return g.slots.get(id);
}

/// r = value `id` (0 for a value without a slot)
fn ng_ld_val(g: &mut NatGen, r: i64, id: i64) {
    if g.rec {
        if ng_slot(g, id) >= 0 {
            ng_mov(g, r, NG_VBASE + id);
        } else {
            ng_li(g, r, 0);
        }
        return;
    }
    var vr: i64 = ng_vreg(g, id);
    if vr >= 0 {
        if vr != r {
            ng_mov(g, r, vr);
        }
        return;
    }
    var off: i64 = ng_slot(g, id);
    if off < 0 {
        ng_li(g, r, 0);
    } else {
        ng_ld_slot(g, r, off);
    }
}

fn ng_st_val(g: &mut NatGen, id: i64, r: i64) {
    if g.rec {
        if ng_slot(g, id) >= 0 {
            ng_mov(g, NG_VBASE + id, r);
        }
        return;
    }
    var vr: i64 = ng_vreg(g, id);
    if vr >= 0 {
        if vr != r {
            ng_mov(g, vr, r);
        }
        return;
    }
    var off: i64 = ng_slot(g, id);
    if off >= 0 {
        ng_st_slot(g, off, r);
    }
}

fn ng_meta_ty(func: &IrFunction, id: i64) -> IrType {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => {
            return m.ty;
        }
        OptValueMeta::None => {
        }
    }
    // a parameter has no instruction: its declared type (a u64 parameter
    // compared signed)
    var pi: i64 = 0;
    while pi < func.params.len() {
        if func.params.get(pi).id == id {
            return func.params.get(pi).ty;
        }
        pi = pi + 1;
    }
    return IrType::I64;
}

/// Does `Store(ptr, value, explicit_ty)` put an f64 value into an f32
/// place (the explicit type, else the pointee type, as ng_gen_inst picks
/// it)? Lowering stores the f64 constant of `var y: f32 = 3.75` as it is;
/// the C path converts it (`*(float*)p = d`), and so must the store here.
fn ng_store_f64_to_f32(func: &IrFunction, ptr: i64, value: i64, explicit_ty: OptIrType) -> bool {
    if !ir_type_eq(ng_meta_ty(func, value), IrType::F64) {
        return false;
    }
    match explicit_ty {
        OptIrType::Some(t0) => {
            return ir_type_eq(t0, IrType::F32);
        }
        OptIrType::None => {
        }
    }
    match ng_meta_ty(func, ptr) {
        IrType::Ptr(inner) => {
            return ir_type_eq(box_ir_type_unbox(inner), IrType::F32);
        }
        _ => {
        }
    }
    return false;
}

/// A float BinOp mixing f32 and f64 among its operand types (lty, rty)
/// and its float type (fty: the result's, or the left operand's for a
/// compare): ng_gen_binop then computes in f64 (C's usual arithmetic
/// conversions) and narrows an f32 result.
fn ng_float_mixed(lty: IrType, rty: IrType, fty: IrType) -> bool {
    var has32: bool = ir_type_eq(lty, IrType::F32) || ir_type_eq(rty, IrType::F32) || ir_type_eq(fty, IrType::F32);
    var has64: bool = ir_type_eq(lty, IrType::F64) || ir_type_eq(rty, IrType::F64) || ir_type_eq(fty, IrType::F64);
    return has32 && has64;
}

fn ng_is_unsigned_ty(t: IrType) -> bool {
    return ir_type_eq(t, IrType::U8) || ir_type_eq(t, IrType::U16) || ir_type_eq(t, IrType::U32) || ir_type_eq(t, IrType::U64);
}

fn ng_is_ptr_ty(t: IrType) -> bool {
    match t {
        IrType::Ptr(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// ME27: a struct type (a struct-returning function's IR result type)
fn ng_is_struct_ty(t: IrType) -> bool {
    match t {
        IrType::Struct(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// ME27: a pointer to a struct (the hidden result parameter's type)
fn ng_is_struct_ptr_ty(t: IrType) -> bool {
    match t {
        IrType::Ptr(inner) => {
            return ng_is_struct_ty(box_ir_type_unbox(inner));
        }
        _ => {
        }
    }
    return false;
}

/// The extension that normalizes a narrow integer type (0: none)
fn ng_narrow_kind(t: IrType) -> i64 {
    match t {
        IrType::I8 => {
            return NEXT_SB;
        }
        IrType::I16 => {
            return NEXT_SH;
        }
        IrType::I32 => {
            return NEXT_SW;
        }
        IrType::U8 => {
            return NEXT_ZB;
        }
        IrType::U16 => {
            return NEXT_ZH;
        }
        IrType::U32 => {
            return NEXT_ZW;
        }
        _ => {
        }
    }
    return 0;
}

// ===========================================================================
// Register allocation
//
// A value lives in a callee-saved register for its whole live range, or in
// its stack slot: AArch64 x19..x28, RISC-V s1..s11. Calls keep them (the
// callee saves what it uses), so a value needs no saving around a call; the
// task switch (nat_ctx_swap) saves them too. Live ranges are the hull of
// every position where the value is live: its definition and uses in
// layout order, and for a value used outside the block that defines it,
// the starts and ends of the blocks it is live into and out of (block
// liveness to a fixed point). Linear scan over the hulls; when the
// registers run out, the range that ends last stays in its slot.
// ===========================================================================

const NG_REGALLOC: bool = true;
/// The callee-saved registers values may live in.
fn ng_callee_saved(g: &NatGen) -> Vec<i64> {
    // MI4: the integer class's callee-saved pool of the target description
    return ng_class_pool(g, NG_RC_INT, true);
}

fn ng_vreg(g: &NatGen, id: i64) -> i64 {
    if id < 0 || id >= g.vreg.len() {
        return 0 - 1;
    }
    return g.vreg.get(id);
}

/// Every value `inst` reads (what ng_gen_inst loads with ng_ld_val).
fn ng_inst_operands(inst: Inst, out: &mut Vec<i64>) {
    match inst {
        Inst::BinOp(_, l, r, _) => {
            out.push(l);
            out.push(r);
        }
        Inst::UnaryOp(_, v, _) => {
            out.push(v);
        }
        Inst::Load(p, _) => {
            out.push(p);
        }
        Inst::Store(p, v, _) => {
            out.push(p);
            out.push(v);
        }
        Inst::StructCopy(d, s, _) => {
            out.push(d);
            out.push(s);
        }
        Inst::GetFieldPtr(p, _, _) => {
            out.push(p);
        }
        Inst::GetElemPtr(p, i, _) => {
            out.push(p);
            out.push(i);
        }
        Inst::Branch(c, _, _) => {
            out.push(c);
        }
        Inst::Switch(sv, _, _, _) => {
            out.push(sv);
        }
        Inst::Return(rv) => {
            match rv {
                OptValueId::Some(v) => {
                    out.push(v);
                }
                OptValueId::None => {
                }
            }
        }
        Inst::Call(_, args, _, _) => {
            var i: i64 = 0;
            while i < args.len() {
                out.push(args.get(i));
                i = i + 1;
            }
        }
        Inst::CallPtr(fp, args, _, _, _) => {
            out.push(fp);
            var j: i64 = 0;
            while j < args.len() {
                out.push(args.get(j));
                j = j + 1;
            }
        }
        Inst::DynCall(_, _, args, _, _) => {
            var k: i64 = 0;
            while k < args.len() {
                out.push(args.get(k));
                k = k + 1;
            }
        }
        Inst::MakeDyn(v, _, _) => {
            out.push(v);
        }
        Inst::BitCast(v, _, _) => {
            out.push(v);
        }
        Inst::IntExtend(v, _, _) => {
            out.push(v);
        }
        Inst::IntTrunc(v, _, _) => {
            out.push(v);
        }
        Inst::IntToFloat(v, _, _) => {
            out.push(v);
        }
        Inst::FloatToInt(v, _, _) => {
            out.push(v);
        }
        Inst::TryUnwrap(v, _, _, _) => {
            out.push(v);
        }
        Inst::Print(v, _) => {
            out.push(v);
        }
        Inst::Asm(_, inputs, _, _) => {
            var m: i64 = 0;
            while m < inputs.len() {
                // a clobber travels as an input with id -1 (2g.53)
                if inputs.get(m).id >= 0 {
                    out.push(inputs.get(m).id);
                }
                m = m + 1;
            }
        }
        Inst::PersistLoad(_, d, _) => {
            out.push(d);
        }
        Inst::PersistSave(_, v) => {
            out.push(v);
        }
        Inst::Backward(l) => {
            out.push(l);
        }
        _ => {
        }
    }
}

/// The blocks control can go to after block `bi` (indexes).
fn ng_block_succs(func: &IrFunction, bi: i64, bindex: i64, out: &mut Vec<i64>) {
    out.clear();
    var block: BasicBlock = func.blocks.get(bi);
    var n: i64 = block.instructions.len();
    var ends: bool = false;
    if n > 0 {
        match IrFunction_get_inst(func, block.instructions.get(n - 1)) {
            OptInst::Some(last) => {
                match last {
                    Inst::Jump(t) => {
                        ends = true;
                        if HashMap_contains(bindex, int_to_str(t)) {
                            out.push(HashMap_get(bindex, int_to_str(t)));
                        }
                    }
                    Inst::Branch(_, t1, t2) => {
                        ends = true;
                        if HashMap_contains(bindex, int_to_str(t1)) {
                            out.push(HashMap_get(bindex, int_to_str(t1)));
                        }
                        if HashMap_contains(bindex, int_to_str(t2)) {
                            out.push(HashMap_get(bindex, int_to_str(t2)));
                        }
                    }
                    Inst::Switch(_, _, sw_t, sw_d) => {
                        // ME28: each block the switch may go to
                        ends = true;
                        var swb: Vec<i64> = switch_succ_blocks(sw_t, sw_d);
                        var swi: i64 = 0;
                        while swi < swb.len() {
                            if HashMap_contains(bindex, int_to_str(swb.get(swi))) {
                                out.push(HashMap_get(bindex, int_to_str(swb.get(swi))));
                            }
                            swi = swi + 1;
                        }
                    }
                    Inst::Return(_) => {
                        ends = true;
                    }
                    Inst::Unreachable => {
                        ends = true;
                    }
                    _ => {
                    }
                }
            }
            OptInst::None => {
            }
        }
    }
    // A block without a terminator runs into the next one
    if !ends && bi + 1 < func.blocks.len() {
        out.push(bi + 1);
    }
}

fn ng_touch(lo: &mut Vec<i64>, hi: &mut Vec<i64>, v: i64, p: i64) {
    if v < 0 || v >= lo.len() {
        return;
    }
    if lo.get(v) < 0 || p < lo.get(v) {
        lo.set(v, p);
    }
    if p > hi.get(v) {
        hi.set(v, p);
    }
}

/// g.vreg (value id -> register, -1: its slot) and g.save_regs for the
/// function about to be compiled.
fn ng_regalloc(g: &mut NatGen, func: &IrFunction, nvals: i64) {
    var vreg: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nvals {
        vreg.push(0 - 1);
        i = i + 1;
    }
    g.save_regs = Vec::new();
    g.vreg = vreg;
    if !NG_REGALLOC || nvals == 0 {
        return;
    }

    var lo: Vec<i64> = Vec::new();
    var hi: Vec<i64> = Vec::new();
    var defb: Vec<i64> = Vec::new();
    var global: Vec<i64> = Vec::new();
    i = 0;
    while i < nvals {
        lo.push(0 - 1);
        hi.push(0 - 1);
        defb.push(0 - 1);
        global.push(0);
        i = i + 1;
    }
    // Parameters are defined at position 0, in block 0
    i = 0;
    while i < func.params.len() {
        var pid: i64 = func.params.get(i).id;
        ng_touch(&mut lo, &mut hi, pid, 0);
        if pid >= 0 && pid < nvals {
            defb.set(pid, 0);
        }
        i = i + 1;
    }
    var nb: i64 = func.blocks.len();
    var bindex: i64 = HashMap_new();
    var bstart: Vec<i64> = Vec::new();
    var bend: Vec<i64> = Vec::new();
    var bi: i64 = 0;
    while bi < nb {
        HashMap_insert(bindex, int_to_str(func.blocks.get(bi).id), bi);
        bi = bi + 1;
    }
    // Positions, definitions, uses; a value used outside its defining
    // block is global
    var ops: Vec<i64> = Vec::new();
    var pos: i64 = 1;
    bi = 0;
    while bi < nb {
        var block: BasicBlock = func.blocks.get(bi);
        bstart.push(pos);
        var ii: i64 = 0;
        while ii < block.instructions.len() {
            var iid: i64 = block.instructions.get(ii);
            match IrFunction_get_inst(func, iid) {
                OptInst::Some(inst) => {
                    ops.clear();
                    ng_inst_operands(inst, &mut ops);
                    var k: i64 = 0;
                    while k < ops.len() {
                        var v: i64 = ops.get(k);
                        if v >= 0 && v < nvals {
                            ng_touch(&mut lo, &mut hi, v, pos);
                            if defb.get(v) != bi {
                                global.set(v, 1);
                            }
                        }
                        k = k + 1;
                    }
                }
                OptInst::None => {
                }
            }
            if iid >= 0 && iid < nvals {
                ng_touch(&mut lo, &mut hi, iid, pos);
                defb.set(iid, bi);
            }
            pos = pos + 1;
            ii = ii + 1;
        }
        bend.push(pos);
        pos = pos + 1;
        bi = bi + 1;
    }
    // Block liveness of the global values (bit sets of `words` words)
    var gidx: Vec<i64> = Vec::new();
    var gval: Vec<i64> = Vec::new();
    i = 0;
    while i < nvals {
        if global.get(i) != 0 && lo.get(i) >= 0 {
            gidx.push(gval.len());
            gval.push(i);
        } else {
            gidx.push(0 - 1);
        }
        i = i + 1;
    }
    var ng: i64 = gval.len();
    if ng > 0 && nb > 0 {
        var words: i64 = (ng + 63) / 64;
        var use_b: Vec<i64> = Vec::new();
        var def_b: Vec<i64> = Vec::new();
        var live_in: Vec<i64> = Vec::new();
        var live_out: Vec<i64> = Vec::new();
        i = 0;
        while i < nb * words {
            use_b.push(0);
            def_b.push(0);
            live_in.push(0);
            live_out.push(0);
            i = i + 1;
        }
        bi = 0;
        while bi < nb {
            var blk: BasicBlock = func.blocks.get(bi);
            var j: i64 = 0;
            while j < blk.instructions.len() {
                var jid: i64 = blk.instructions.get(j);
                match IrFunction_get_inst(func, jid) {
                    OptInst::Some(inst2) => {
                        ops.clear();
                        ng_inst_operands(inst2, &mut ops);
                        var k2: i64 = 0;
                        while k2 < ops.len() {
                            var u: i64 = ops.get(k2);
                            if u >= 0 && u < nvals && gidx.get(u) >= 0 && defb.get(u) != bi {
                                var gi: i64 = gidx.get(u);
                                var w: i64 = bi * words + gi / 64;
                                use_b.set(w, use_b.get(w) | (1 << (gi % 64)));
                            }
                            k2 = k2 + 1;
                        }
                    }
                    OptInst::None => {
                    }
                }
                j = j + 1;
            }
            bi = bi + 1;
        }
        i = 0;
        while i < ng {
            var dv: i64 = gval.get(i);
            var db: i64 = defb.get(dv);
            if db >= 0 {
                var w2: i64 = db * words + i / 64;
                def_b.set(w2, def_b.get(w2) | (1 << (i % 64)));
            }
            i = i + 1;
        }
        var succs: Vec<i64> = Vec::new();
        var changed: bool = true;
        var rounds: i64 = 0;
        while changed && rounds < 1000 {
            changed = false;
            rounds = rounds + 1;
            bi = nb - 1;
            while bi >= 0 {
                ng_block_succs(func, bi, bindex, &mut succs);
                var wi: i64 = 0;
                while wi < words {
                    var o: i64 = 0;
                    var si: i64 = 0;
                    while si < succs.len() {
                        o = o | live_in.get(succs.get(si) * words + wi);
                        si = si + 1;
                    }
                    var at: i64 = bi * words + wi;
                    var inn: i64 = use_b.get(at) | (o & ~def_b.get(at));
                    if o != live_out.get(at) {
                        live_out.set(at, o);
                        changed = true;
                    }
                    if inn != live_in.get(at) {
                        live_in.set(at, inn);
                        changed = true;
                    }
                    wi = wi + 1;
                }
                bi = bi - 1;
            }
        }
        bi = 0;
        while bi < nb {
            var gi2: i64 = 0;
            while gi2 < ng {
                var bit: i64 = 1 << (gi2 % 64);
                var at2: i64 = bi * words + gi2 / 64;
                if (live_in.get(at2) & bit) != 0 {
                    ng_touch(&mut lo, &mut hi, gval.get(gi2), bstart.get(bi));
                }
                if (live_out.get(at2) & bit) != 0 {
                    ng_touch(&mut lo, &mut hi, gval.get(gi2), bend.get(bi));
                }
                gi2 = gi2 + 1;
            }
            bi = bi + 1;
        }
    }

    // Linear scan in order of start (a counting sort over positions)
    var count: Vec<i64> = Vec::new();
    i = 0;
    while i <= pos + 1 {
        count.push(0);
        i = i + 1;
    }
    i = 0;
    while i < nvals {
        if lo.get(i) >= 0 {
            count.set(lo.get(i) + 1, count.get(lo.get(i) + 1) + 1);
        }
        i = i + 1;
    }
    i = 1;
    while i < count.len() {
        count.set(i, count.get(i) + count.get(i - 1));
        i = i + 1;
    }
    var order: Vec<i64> = Vec::new();
    i = 0;
    while i < nvals {
        order.push(0 - 1);
        i = i + 1;
    }
    var total: i64 = 0;
    i = 0;
    while i < nvals {
        if lo.get(i) >= 0 {
            var slot: i64 = count.get(lo.get(i));
            order.set(slot, i);
            count.set(lo.get(i), slot + 1);
            total = total + 1;
        }
        i = i + 1;
    }
    var pool: Vec<i64> = ng_callee_saved(g);
    var free: Vec<i64> = Vec::new();
    i = pool.len() - 1;
    while i >= 0 {
        free.push(pool.get(i));
        i = i - 1;
    }
    var used: Vec<i64> = Vec::new();
    i = 0;
    while i < pool.len() {
        used.push(0);
        i = i + 1;
    }
    var active: Vec<i64> = Vec::new();
    var oi: i64 = 0;
    while oi < total {
        var v2: i64 = order.get(oi);
        var st: i64 = lo.get(v2);
        // Expire the ranges that ended
        var kept: Vec<i64> = Vec::new();
        var ai: i64 = 0;
        while ai < active.len() {
            var a: i64 = active.get(ai);
            if hi.get(a) < st {
                free.push(g.vreg.get(a));
            } else {
                kept.push(a);
            }
            ai = ai + 1;
        }
        active = kept;
        if free.len() > 0 {
            var r: i64 = free.get(free.len() - 1);
            free.pop();
            g.vreg.set(v2, r);
            active.push(v2);
        } else {
            // The active range that ends last gives up its register
            var far: i64 = 0 - 1;
            var fi: i64 = 0;
            while fi < active.len() {
                if far < 0 || hi.get(active.get(fi)) > hi.get(active.get(far)) {
                    far = fi;
                }
                fi = fi + 1;
            }
            if far >= 0 && hi.get(active.get(far)) > hi.get(v2) {
                var loser: i64 = active.get(far);
                g.vreg.set(v2, g.vreg.get(loser));
                g.vreg.set(loser, 0 - 1);
                active.set(far, v2);
            }
        }
        oi = oi + 1;
    }
    i = 0;
    while i < nvals {
        var rr: i64 = g.vreg.get(i);
        if rr >= 0 {
            var pi: i64 = 0;
            while pi < pool.len() {
                if pool.get(pi) == rr {
                    used.set(pi, 1);
                }
                pi = pi + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < pool.len() {
        if used.get(i) != 0 {
            g.save_regs.push(pool.get(i));
        }
        i = i + 1;
    }
}

// ===========================================================================
// The machine IR (own-backend roadmap, Tracks MI and RA)
//
// With NG_MIR on, lowering does not encode: each operation of the
// architecture layer above (ng_li, ng_add, ng_load, ng_call_label, ...)
// records itself as an MInst whose register operands are physical (< 64:
// argument registers, sp, the reserved scratch registers) or virtual (>= 64:
// IR value `id` is vreg 64 + id; each IR instruction gets four fresh scratch
// vregs as g.t0..g.t3). After every function is recorded, functions are
// allocated callee first (interprocedural: a caller knows which registers a
// call really clobbers) by one linear scan over all registers the backend
// may use, caller-saved included, checked (FID_VERIFY=1) by an independent
// liveness walk, then replayed through the same operations with physical
// registers. Spilled vregs live in frame slots, reached through three
// reserved scratch registers. Identical functions are emitted once.
//
// Kill switches (FID_NAT_OFF=name,name): mir (the direct path of before),
// promote (locals stay in memory), ipra (every call clobbers every
// caller-saved register), fold (no identical-function folding), hint (no
// move coalescing hints), vecinline (Vec_len/get/set/push always calls),
// unchecked (every overflow and bounds check stays, checks.fd unused),
// coalesce (every copy between vregs keeps two of them), panicline (no
// " at line N" in division panics), remat (spilled constants and
// addresses reload from their slots), xmmcache (every float operation moves
// its operands into xmm0/xmm1), weights (spill the range ending last, not
// the cheapest by loop-weighted uses), pairs (AArch64 saves and restores
// callee-saved registers one at a time, not with stp/ldp), relax (TG6:
// every branch in its long form), lea (TG7: x86-64 three-operand adds as
// MOV + ADD), mirfold (TG18: no constant compares or double extensions
// folded in ng_peep), leaf (WP8: every function keeps its frame), tailcall
// (OP13: no sibling call becomes a jump), retregs (ME27: struct results
// always through the hidden pointer), wipe (LF20: frames of functions
// holding secrets are not zeroed), wiperegs (LF20: nor their scratch
// registers, ng_wipe_regs), secretregs (LF20: secret values spill like
// any other, ng_secret_weights), csel (MI24: branch diamonds stay
// branches), extstate (MI26: every extension emitted, known state or not),
// holes (RA2: hulls, not segments with holes, in the scan and the greedy
// allocator, and no second allocation over segments), segscan (RA2: the
// scan over hulls, the second allocation over segments kept), uselive
// (RA2: liveness to a block fixed point, not from use lists), livecoal
// (RA6: no second coalescing round over exact liveness), addi (RA6: adds
// of a constant keep the constant in a register), shrinkwrap (RA12: every
// callee-saved register saved in the prologue), vectorize (OP22: no loop
// vectorization, ng_vz_try). FID_NAT_ON=pie: a position-independent Linux
// executable (TG14).
// FID_NAT_FAST=1 (or g_nat_fast): the fast allocator of debug builds (RA14).
// FID_NAT_ON=greedy: the greedy allocator (priority queue, eviction by
// spill weight) in place of the linear scan (RA9, ng_greedy_assign);
// FID_NAT_ON=greedycmp with --stats: the scan allocates and an `[ra9]`
// line per function compares its spills with the greedy assignment's.
// Values a move ties to an argument register may take it (RA7,
// ng_arg_hints; on by default, FID_NAT_OFF=arghint: never). Spilled
// values are split around call-free loops and between calls (RA4,
// ng_mir_alloc_split; FID_NAT_OFF=split: never, FID_NAT_ON=splitall: every
// value, always kept; FID_NAT_OFF=splitprune: no second split without the
// values whose pieces all spilled).
// Floats in float registers, f32 operations in single precision (MI25,
// RA10's float classes: ng_mir_classes_c, ng_float_assign; ng_fregs_on):
// on by default on every target, FID_NAT_OFF=fregs: off;
// FID_NAT_OFF=winfregs: off on --nat Windows alone (MI14). Spilled floats
// are split too (MI14; FID_NAT_OFF=splitfloat: integers only).
// ===========================================================================

const NG_MIR: bool = true;
// MI1: NG_VBASE, the operations (MO_*: what each takes is written there,
// with MO_LAST, the highest code; a new operation goes there) and MInst
// are in compiler/mir.fd.

/// A recorded function, waiting for allocation and emission.
pub struct NatFnRec {
    pub name: str,
    pub mir: Vec<MInst>,
    pub nvreg: i64,
    pub base_frame: i64,
    pub slots: Vec<i64>,
    pub is_ct: bool,  // J7: @constant_time — ng_ct_check scans the final MIR
    // ME27: the vreg of the hidden result pointer of a struct-returning
    // function (lowering's sret, its first parameter; -1: none) and the
    // struct's size
    pub sret_v: i64,
    pub sret_size: i64,
    // LF20: the function holds a secret (IrFunction.has_secret, @zeroize
    // locals, @constant_time): its frame is wiped at exit
    pub secret: bool,
}

/// RA14: the switch variables read once per image (ng_env_cache_load, by
/// nat_generate_image1 on the main thread before any emission worker
/// starts), as "," + value + "," ("": not set), and FID_VERIFY /
/// FID_NAT_FAST set. ng_on and the others were a getenv each, and the
/// allocator asks per move (the copy hints) and per call (IPRA): in a debug
/// build's allocation (RA14's fast allocator) the lookups were a good part
/// of its time. Before the first image (unit hooks) they read the
/// environment as before.
var g_ng_env_ok: bool = false;
var g_ng_env_off: str = "";
var g_ng_env_on: str = "";
var g_ng_env_mut: str = "";
var g_ng_env_verify: bool = false;
var g_ng_env_fast: bool = false;
var g_ng_env_dump: str = "";
var g_ng_env_frames: bool = false;

fn ng_env_list(name: str) -> str {
    var v: str = p_getenv(name);
    if (v as i64) == 0 || str_len(v) == 0 {
        return "";
    }
    return "," + v + ",";
}

fn ng_env_cache_load() {
    g_ng_env_off = ng_env_list("FID_NAT_OFF");
    g_ng_env_on = ng_env_list("FID_NAT_ON");
    g_ng_env_mut = ng_env_list("FID_NAT_MUTATE");
    var v: str = p_getenv("FID_VERIFY");
    g_ng_env_verify = (v as i64) != 0 && str_len(v) > 0;
    var fv: str = p_getenv("FID_NAT_FAST");
    g_ng_env_fast = (fv as i64) != 0 && str_len(fv) > 0 && fv != "0";
    var rv: str = p_getenv("FID_NAT_FRAMES");
    g_ng_env_frames = (rv as i64) != 0 && str_len(rv) > 0 && rv != "0";
    g_ng_env_dump = "";
    var dv: str = p_getenv("FID_NAT_DUMP");
    if (dv as i64) != 0 {
        g_ng_env_dump = dv;
    }
    g_ng_env_ok = true;
}

/// RA14: FID_NAT_DUMP ("" when not set; asked a few times per function)
fn ng_env_dump() -> str {
    if g_ng_env_ok {
        return g_ng_env_dump;
    }
    var dv: str = p_getenv("FID_NAT_DUMP");
    if (dv as i64) == 0 {
        return "";
    }
    return dv;
}

/// A backend switch, on unless FID_NAT_OFF names it.
fn ng_on(name: str) -> bool {
    if g_ng_env_ok {
        return str_len(g_ng_env_off) == 0 || !str_contains(g_ng_env_off, "," + name + ",");
    }
    var off: str = p_getenv("FID_NAT_OFF");
    if (off as i64) == 0 || str_len(off) == 0 {
        return true;
    }
    return !str_contains("," + off + ",", "," + name + ",");
}

/// TG2: `FID_NAT_MUTATE=<rule>[,<rule>]` breaks that selection rule on
/// purpose (a wrong bit, operand, operation or slot), so that the random
/// rule test (tests/bootstrap/test_machine_rules_random.fd, run by
/// tests/nattools/rule_mutation_check.sh) is seen to catch a wrong rule.
/// Rules: tbz, brgap, opw, memop, andn, addi; RA19's brnot, brandor and
/// brxblock (the branch tests the wrong way); RA18's fcallee (callee-saved
/// float registers used but not saved); TG17's ldfwdmov (the forwarded
/// register is taken even when a move in between wrote it). Never set in
/// a real build.
fn ng_mutant(name: str) -> bool {
    if g_ng_env_ok {
        return str_len(g_ng_env_mut) > 0 && str_contains(g_ng_env_mut, "," + name + ",");
    }
    var mu: str = p_getenv("FID_NAT_MUTATE");
    if (mu as i64) == 0 || str_len(mu) == 0 {
        return false;
    }
    return str_contains("," + mu + ",", "," + name + ",");
}

fn ng_verify_on() -> bool {
    if g_ng_verify_unit {
        // RA4: tests/nattools/split_alloc_unit.fd (nat_split_alloc_unit)
        return true;
    }
    if g_ng_env_ok {
        return g_ng_env_verify;
    }
    var v: str = p_getenv("FID_VERIFY");
    return (v as i64) != 0 && str_len(v) > 0;
}

fn ng_rec(g: &mut NatGen, op: i64, r0: i64, r1: i64, r2: i64, i0: i64, i1: i64, i2: i64) {
    g.mir.push(MInst {
        op: op, r0: r0, r1: r1, r2: r2, i0: i0, i1: i1, i2: i2
    });
}

fn ng_new_vreg(g: &mut NatGen) -> i64 {
    var v: i64 = g.nvreg;
    g.nvreg = v + 1;
    return v;
}

/// Four fresh scratch vregs for the next IR instruction.
fn ng_fresh_temps(g: &mut NatGen) {
    g.t0 = ng_new_vreg(g);
    g.t1 = ng_new_vreg(g);
    g.t2 = ng_new_vreg(g);
    g.t3 = ng_new_vreg(g);
}

/// Place a label: an operation of its own in the machine IR.
fn ng_place(g: &mut NatGen, label: i64) {
    if g.rec {
        ng_rec(g, MO_PLACE, 0, 0, 0, label, 0, 0);
        return;
    }
    NatEnc_place(&mut g.e, label);
}

/// d = s >> 63 (arithmetic)
fn ng_asr63(g: &mut NatGen, d: i64, s: i64) {
    if g.rec {
        ng_rec(g, MO_ASR63, d, s, 0, 0, 0, 0);
        return;
    }
    if ng_x64(g) {
        if d != s {
            x64_mov(&mut g.e, d, s);
        }
        x64_shift_imm(&mut g.e, 7, d, 63);
        return;
    }
    if ng_a64(g) {
        a64_asr63(&mut g.e, d, s);
    } else {
        rv_srai(&mut g.e, d, s, 63);
    }
}

// (MI1: mi_defines, mi_use_mask, mi_is_call, mi_is_cond_br, mi_is_br and
// mi_nop, what an operation reads and writes, are in compiler/mir.fd.)

// --- Recorded-MIR peephole (OP19) -------------------------------------------
// Local patterns over one recorded function before allocation. Everything
// here is block-local or goes through the label->block map, so it stays
// correct when it rewrites branch targets or deletes whole instructions.

/// `m` uses vreg `d` (through the fields mi_use_mask reports).
fn ng_peep_uses(m: MInst, d: i64) -> bool {
    var um: i64 = mi_use_mask(m.op);
    if (um & 1) != 0 && m.r0 == d {
        return true;
    }
    if (um & 2) != 0 && m.r1 == d {
        return true;
    }
    if (um & 4) != 0 && m.r2 == d {
        return true;
    }
    return false;
}

/// `m` could write or clobber memory (a barrier for load forwarding).
fn ng_peep_mem_barrier(m: MInst) -> bool {
    return m.op == MO_STORE || m.op == MO_STX || m.op == MO_STSLOT || m.op == MO_CALL || m.op == MO_CALLR || m.op == MO_COPY || m.op == MO_TRAP || m.op == MO_VST || m.op == MO_ALUMST;
}

/// TG18: does compare kind cc hold for (a, b)? (unsigned kinds compare
/// with the sign bit flipped)
@wrapping
fn ng_cc_holds(cc: i64, a: i64, b: i64) -> bool {
    var flip: i64 = 0 - 9223372036854775807 - 1;
    var ua: i64 = a ^ flip;
    var ub: i64 = b ^ flip;
    if cc == NCC_EQ {
        return a == b;
    }
    if cc == NCC_NE {
        return a != b;
    }
    if cc == NCC_LT {
        return a < b;
    }
    if cc == NCC_LE {
        return a <= b;
    }
    if cc == NCC_GT {
        return a > b;
    }
    if cc == NCC_GE {
        return a >= b;
    }
    if cc == NCC_LTU {
        return ua < ub;
    }
    if cc == NCC_LEU {
        return ua <= ub;
    }
    if cc == NCC_GTU {
        return ua > ub;
    }
    return ua >= ub;
}

/// TG18: extension k2 leaves every result of extension k1 as it is (the
/// same signedness and no narrower, or zero-extended into a wider signed
/// field).
fn ng_ext_keeps(k1: i64, k2: i64) -> bool {
    var w1: i64 = 32;
    if k1 == NEXT_SB || k1 == NEXT_ZB {
        w1 = 8;
    } else if k1 == NEXT_SH || k1 == NEXT_ZH {
        w1 = 16;
    }
    var w2: i64 = 32;
    if k2 == NEXT_SB || k2 == NEXT_ZB {
        w2 = 8;
    } else if k2 == NEXT_SH || k2 == NEXT_ZH {
        w2 = 16;
    }
    var s1: bool = k1 == NEXT_SB || k1 == NEXT_SH || k1 == NEXT_SW;
    var s2: bool = k2 == NEXT_SB || k2 == NEXT_SH || k2 == NEXT_SW;
    if s1 == s2 {
        return w1 <= w2;
    }
    return !s1 && s2 && w1 < w2;
}

/// TG18: the shared MIR peephole's value patterns (before allocation, every
/// target), block by block. A vreg is known while the block has not
/// redefined it since an MO_LI (or a MOV of a known one); `zr` (-1: none,
/// as on AArch64, where 31 is also sp) reads as 0. Rewrites:
///   SETCC d, x, y, cc, x and y known        -> LI d, 0 or 1
///   BNEZ / BEQZ r, L, r known: never taken  -> nothing
///                              always taken -> JMP L, when a label starts
///                              the next instruction (no unlabeled code is
///                              left behind the jump)
///   PANICIF r, r known 0                    -> nothing (it cannot fire)
///   EXT d2, d1, k2 of an EXT d1, s, k1 (d1 unchanged) that k2 leaves as
///   it is (sign 8 then sign 32, zero 8 then sign 16, ...) -> MOV d2, d1
/// The MIR has no flags between operations, so the "dead flags" pattern
/// has nothing to act on here. `FID_NAT_OFF=mirfold`: none of these.
fn ng_peep_fold(mir: &mut Vec<MInst>, zr: i64) -> i64 {
    if !ng_on("mirfold") {
        return 0;
    }
    var n: i64 = mir.len();
    // the highest register any instruction reads or writes
    var maxv: i64 = 0;
    var k: i64 = 0;
    while k < n {
        var mm: MInst = mir.get(k);
        if mm.op >= 0 {
            var um: i64 = mi_use_mask(mm.op);
            var f: i64 = 0;
            while f < 3 {
                if (um & (1 << f)) != 0 || (f == 0 && mi_defines(mm.op)) {
                    var rv: i64 = mi_field(mm, f);
                    if rv > maxv {
                        maxv = rv;
                    }
                }
                f = f + 1;
            }
        }
        k = k + 1;
    }
    // per register number: the block that knows its constant / its
    // extension (0: none), the constant, the extension kind
    var kst: Vec<i64> = Vec::new();
    var kval: Vec<i64> = Vec::new();
    var est: Vec<i64> = Vec::new();
    var ekind: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i <= maxv {
        kst.push(0);
        kval.push(0);
        est.push(0);
        ekind.push(0);
        i = i + 1;
    }
    var changed: i64 = 0;
    var blk: i64 = 1;
    k = 0;
    while k < n {
        var m: MInst = mir.get(k);
        if k > 0 && (m.op == MO_PLACE || mi_ends_block(mir.get(k - 1).op)) {
            blk = blk + 1;
        }
        var a_known: bool = (m.r0 == zr && zr >= 0) || ng_pf_known(&kst, m.r0, blk);
        var a_val: i64 = 0;
        if ng_pf_known(&kst, m.r0, blk) {
            a_val = kval.get(m.r0);
        }
        if m.op == MO_SETCC {
            var x_known: bool = (m.r1 == zr && zr >= 0) || ng_pf_known(&kst, m.r1, blk);
            var y_known: bool = (m.r2 == zr && zr >= 0) || ng_pf_known(&kst, m.r2, blk);
            if x_known && y_known {
                var xv: i64 = 0;
                var yv: i64 = 0;
                if ng_pf_known(&kst, m.r1, blk) {
                    xv = kval.get(m.r1);
                }
                if ng_pf_known(&kst, m.r2, blk) {
                    yv = kval.get(m.r2);
                }
                var res: i64 = 0;
                if ng_cc_holds(m.i0, xv, yv) {
                    res = 1;
                }
                m = MInst {
                    op: MO_LI, r0: m.r0, r1: 0, r2: 0, i0: res, i1: 0, i2: 0
                };
                mir.set(k, m);
                changed = changed + 1;
            }
        } else if (m.op == MO_BNEZ || m.op == MO_BEQZ) && a_known {
            var taken: bool = (a_val != 0) == (m.op == MO_BNEZ);
            if !taken {
                m = mi_nop();
                mir.set(k, m);
                changed = changed + 1;
            } else {
                var nx: i64 = k + 1;
                while nx < n && mir.get(nx).op == MO_LINE {
                    nx = nx + 1;
                }
                if nx < n && mir.get(nx).op == MO_PLACE {
                    m = MInst {
                        op: MO_JMP, r0: 0, r1: 0, r2: 0, i0: m.i0, i1: 0, i2: 0
                    };
                    mir.set(k, m);
                    changed = changed + 1;
                }
            }
        } else if m.op == MO_PANICIF && a_known && a_val == 0 {
            m = mi_nop();
            mir.set(k, m);
            changed = changed + 1;
        } else if m.op == MO_EXT && ng_pf_known(&est, m.r1, blk) && ng_ext_keeps(ekind.get(m.r1), m.i0) {
            m = MInst {
                op: MO_MOV, r0: m.r0, r1: m.r1, r2: 0, i0: 0, i1: 0, i2: 0
            };
            mir.set(k, m);
            changed = changed + 1;
        }
        // What this instruction leaves in its destination
        if m.op >= 0 && mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 < kst.len() {
            var d: i64 = m.r0;
            var nk: i64 = 0;
            var nkv: i64 = 0;
            var ne: i64 = 0;
            var nek: i64 = 0;
            if m.op == MO_LI {
                nk = blk;
                nkv = m.i0;
            } else if m.op == MO_EXT {
                ne = blk;
                nek = m.i0;
            } else if m.op == MO_MOV {
                if ng_pf_known(&kst, m.r1, blk) {
                    nk = blk;
                    nkv = kval.get(m.r1);
                }
                if ng_pf_known(&est, m.r1, blk) {
                    ne = blk;
                    nek = ekind.get(m.r1);
                }
            }
            kst.set(d, nk);
            kval.set(d, nkv);
            est.set(d, ne);
            ekind.set(d, nek);
        }
        k = k + 1;
    }
    if changed == 0 {
        return 0;
    }
    var out: Vec<MInst> = Vec::new();
    var j: i64 = 0;
    while j < mir.len() {
        if mir.get(j).op >= 0 {
            out.push(mir.get(j));
        }
        j = j + 1;
    }
    mir.clear();
    j = 0;
    while j < out.len() {
        mir.push(out.get(j));
        j = j + 1;
    }
    return changed;
}

/// TG18: vreg v's entry in a per-register table is stamped with block blk.
fn ng_pf_known(stamp: &Vec<i64>, v: i64, blk: i64) -> bool {
    return v >= NG_VBASE && v < stamp.len() && stamp.get(v) == blk;
}

// --- MI26: extension state of narrow integers --------------------------------
// A state is a set of extension kinds the value already satisfies (bit
// 1 << NEXT_*: ext_kind(v) == v), closed under ng_ext_keeps: 126 is every
// kind (NEXT_SB..NEXT_ZW), 112 the zero-extensions (ZB, ZH, ZW).
const NG_ES_ALL: i64 = 126;
const NG_ES_ZERO: i64 = 112;
/// MI26: the kinds a value extended by `kind` satisfies.
fn ng_es_kind_mask(kind: i64) -> i64 {
    var m: i64 = 0;
    var k2: i64 = NEXT_SB;
    while k2 <= NEXT_ZW {
        if ng_ext_keeps(kind, k2) {
            m = m | (1 << k2);
        }
        k2 = k2 + 1;
    }
    return m;
}

/// MI26: the kinds constant c satisfies.
fn ng_es_const_mask(c: i64) -> i64 {
    var m: i64 = 0;
    if c >= 0 - 128 && c <= 127 {
        m = m | (1 << NEXT_SB);
    }
    if c >= 0 - 32768 && c <= 32767 {
        m = m | (1 << NEXT_SH);
    }
    if c >= 0 - 2147483648 && c <= 2147483647 {
        m = m | (1 << NEXT_SW);
    }
    if c >= 0 && c <= 255 {
        m = m | (1 << NEXT_ZB);
    }
    if c >= 0 && c <= 65535 {
        m = m | (1 << NEXT_ZH);
    }
    if c >= 0 && c <= 4294967295 {
        m = m | (1 << NEXT_ZW);
    }
    return m;
}

/// MI26: the closure of the kinds in z (each with what it implies).
fn ng_es_closure(z: i64) -> i64 {
    var m: i64 = 0;
    var k: i64 = NEXT_SB;
    while k <= NEXT_ZW {
        if (z & (1 << k)) != 0 {
            m = m | ng_es_kind_mask(k);
        }
        k = k + 1;
    }
    return m;
}

/// MI26: a value below 2^w (unsigned): the zero-extension of the smallest
/// width it fits, with what that implies.
fn ng_es_ubound(w: i64) -> i64 {
    if w <= 8 {
        return ng_es_kind_mask(NEXT_ZB);
    }
    if w <= 16 {
        return ng_es_kind_mask(NEXT_ZH);
    }
    if w <= 32 {
        return ng_es_kind_mask(NEXT_ZW);
    }
    return 0;
}

/// MI26: a value in [-2^(w-1), 2^(w-1)): the sign-extension of the
/// smallest width it fits.
fn ng_es_sbound(w: i64) -> i64 {
    if w <= 8 {
        return ng_es_kind_mask(NEXT_SB);
    }
    if w <= 16 {
        return ng_es_kind_mask(NEXT_SH);
    }
    if w <= 32 {
        return ng_es_kind_mask(NEXT_SW);
    }
    return 0;
}

/// MI26: the state of what `m` defines, from the states of its operands
/// r1 (s1) and r2 (s2), and r2's constant when it is one (k2, c2).
fn ng_es_def(m: MInst, s1: i64, s2: i64, k2: bool, c2: i64) -> i64 {
    var op: i64 = m.op;
    if op == MO_LI {
        return ng_es_const_mask(m.i0);
    }
    if op == MO_SETCC {
        return NG_ES_ALL;
    }
    if op == MO_EXT {
        return ng_es_kind_mask(m.i0);
    }
    if op == MO_OPW {
        // TG9: ADDW / SUBW / MULW sign-extend their 32-bit result
        return ng_es_kind_mask(NEXT_SW);
    }
    if op == MO_LOAD || op == MO_LDX {
        var signed: bool = (m.i2 & 1) != 0;
        if m.i1 == 1 {
            if signed {
                return ng_es_kind_mask(NEXT_SB);
            }
            return ng_es_kind_mask(NEXT_ZB);
        }
        if m.i1 == 2 {
            if signed {
                return ng_es_kind_mask(NEXT_SH);
            }
            return ng_es_kind_mask(NEXT_ZH);
        }
        if m.i1 == 4 {
            if signed {
                return ng_es_kind_mask(NEXT_SW);
            }
            return ng_es_kind_mask(NEXT_ZW);
        }
        return 0;
    }
    if op == MO_MOV {
        return s1;
    }
    if op == MO_AND {
        // a zero-extended operand bounds the result; two sign-extended
        // ones keep their copies of the sign bit
        return ng_es_closure((s1 | s2) & NG_ES_ZERO) | (s1 & s2);
    }
    if op == MO_OR || op == MO_XOR {
        return s1 & s2;
    }
    if op == MO_ANDN {
        return ng_es_closure(s2 & NG_ES_ZERO);
    }
    if op == MO_BLSR {
        // (TG7: BLSMSK of 0 is all ones: no bound kept)
        if m.i0 == 1 {
            return 0;
        }
        return ng_es_closure(s1 & NG_ES_ZERO);
    }
    if op == MO_SHR || op == MO_SAR {
        // a right shift keeps a value inside the width it fitted (a
        // logical one only for a non-negative value: the zero-extensions);
        // by a constant c it also leaves 64 - c bits
        var keepk: i64 = s1;
        if op == MO_SHR {
            keepk = ng_es_closure(s1 & NG_ES_ZERO);
        }
        if k2 {
            var c: i64 = c2 & 63;
            if c == 0 {
                return s1;
            }
            if op == MO_SHR {
                return keepk | ng_es_ubound(64 - c);
            }
            return keepk | ng_es_sbound(64 - c);
        }
        return keepk;
    }
    return 0;
}

/// MI26: narrow integers with a known extension state (before
/// allocation, after the peephole, every target). Each vreg gets the set of
/// extension kinds every value it may hold satisfies: the meet over its
/// definitions of what each leaves (a load of 1/2/4 bytes its extension, an
/// EXT its kind, a constant its range, a compare 0/1, a move its source's,
/// AND/OR/XOR/ANDN/BLSR what bit operations keep, a shift right the width
/// its operand fitted and, by a constant, the bits that are left), to a
/// fixed point from "everything"
/// (a value is only ever written by its definitions, each of which leaves
/// what the meet claims, given that its operands did). Inside a block an
/// operand defined earlier in the block counts with that definition's
/// state, not the meet. An EXT d, s, k whose s already satisfies k is then
/// MOV d, s (a move to itself goes): a promoted `u8` local's store, a
/// truncation or widening of a value that already fits, across blocks
/// (ng_peep_fold sees one block). Returns the number of extensions
/// removed. `FID_NAT_OFF=extstate`.
fn ng_fold_ext_state(mir: &mut Vec<MInst>, nvreg: i64) -> i64 {
    if !ng_on("extstate") {
        return 0;
    }
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if nv <= 0 || n == 0 {
        return 0;
    }
    var any: bool = false;
    var k: i64 = 0;
    while k < n && !any {
        if mir.get(k).op == MO_EXT {
            any = true;
        }
        k = k + 1;
    }
    if !any {
        return 0;
    }
    // definitions per vreg; the constant of a vreg defined once by an LI
    var ndef: Vec<i64> = Vec::new();
    var gc_val: Vec<i64> = Vec::new();
    var gc_ok: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        ndef.push(0);
        gc_val.push(0);
        gc_ok.push(0);
        i = i + 1;
    }
    k = 0;
    while k < n {
        var m: MInst = mir.get(k);
        if m.op >= 0 && mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 < nvreg {
            var di: i64 = m.r0 - NG_VBASE;
            ndef.set(di, ndef.get(di) + 1);
            if m.op == MO_LI {
                gc_val.set(di, m.i0);
                gc_ok.set(di, 1);
            } else {
                gc_ok.set(di, 0);
            }
        }
        k = k + 1;
    }
    var glob: Vec<i64> = Vec::new();
    var lstamp: Vec<i64> = Vec::new();
    var lstate: Vec<i64> = Vec::new();
    var lcok: Vec<i64> = Vec::new();
    var lcval: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        if ndef.get(i) > 0 {
            glob.push(NG_ES_ALL);
        } else {
            glob.push(0);
        }
        if ndef.get(i) != 1 {
            gc_ok.set(i, 0);
        }
        lstamp.push(0);
        lstate.push(0);
        lcok.push(0);
        lcval.push(0);
        i = i + 1;
    }
    var stamp: i64 = 0;
    var round: i64 = 0;
    var changed: bool = true;
    var folded: i64 = 0;
    // rounds of the fixed point, then one more that rewrites (final)
    var final: bool = false;
    while changed || final {
        var newg: Vec<i64> = Vec::new();
        i = 0;
        while i < nv {
            if ndef.get(i) > 0 {
                newg.push(NG_ES_ALL);
            } else {
                newg.push(0);
            }
            i = i + 1;
        }
        stamp = stamp + 1;
        k = 0;
        while k < n {
            var m2: MInst = mir.get(k);
            if k > 0 && (m2.op == MO_PLACE || mi_ends_block(mir.get(k - 1).op)) {
                stamp = stamp + 1;
            }
            if m2.op >= 0 && m2.op != MO_LINE {
                // operand states: a definition earlier in this block, else
                // the meet over all definitions
                var s1: i64 = 0;
                var v1: i64 = m2.r1 - NG_VBASE;
                if v1 >= 0 && v1 < nv {
                    if lstamp.get(v1) == stamp {
                        s1 = lstate.get(v1);
                    } else {
                        s1 = glob.get(v1);
                    }
                }
                var s2: i64 = 0;
                var k2: bool = false;
                var c2: i64 = 0;
                var v2: i64 = m2.r2 - NG_VBASE;
                if v2 >= 0 && v2 < nv {
                    if lstamp.get(v2) == stamp {
                        s2 = lstate.get(v2);
                        if lcok.get(v2) != 0 {
                            k2 = true;
                            c2 = lcval.get(v2);
                        }
                    } else {
                        s2 = glob.get(v2);
                        if gc_ok.get(v2) != 0 {
                            k2 = true;
                            c2 = gc_val.get(v2);
                        }
                    }
                }
                if final && m2.op == MO_EXT && v1 >= 0 && v1 < nv && (s1 & (1 << m2.i0)) != 0 {
                    // the source already satisfies the extension
                    if m2.r0 == m2.r1 {
                        m2 = mi_nop();
                    } else {
                        m2 = MInst {
                            op: MO_MOV, r0: m2.r0, r1: m2.r1, r2: 0, i0: 0, i1: 0, i2: 0
                        };
                    }
                    mir.set(k, m2);
                    folded = folded + 1;
                }
                if m2.op >= 0 && mi_defines(m2.op) && m2.r0 >= NG_VBASE && m2.r0 < nvreg {
                    var d: i64 = m2.r0 - NG_VBASE;
                    var st: i64 = ng_es_def(m2, s1, s2, k2, c2) & NG_ES_ALL;
                    newg.set(d, newg.get(d) & st);
                    lstamp.set(d, stamp);
                    lstate.set(d, st);
                    if m2.op == MO_LI {
                        lcok.set(d, 1);
                        lcval.set(d, m2.i0);
                    } else {
                        lcok.set(d, 0);
                    }
                }
            }
            k = k + 1;
        }
        if final {
            final = false;
            changed = false;
        } else {
            changed = false;
            i = 0;
            while i < nv {
                if newg.get(i) != glob.get(i) {
                    changed = true;
                }
                i = i + 1;
            }
            glob = newg;
            round = round + 1;
            if round > 64 && changed {
                // (cannot happen: each round only takes kinds away)
                return 0;
            }
            if !changed {
                final = true;
            }
        }
    }
    if folded == 0 {
        return 0;
    }
    var out: Vec<MInst> = Vec::new();
    k = 0;
    while k < mir.len() {
        if mir.get(k).op >= 0 {
            out.push(mir.get(k));
        }
        k = k + 1;
    }
    mir.clear();
    k = 0;
    while k < out.len() {
        mir.push(out.get(k));
        k = k + 1;
    }
    return folded;
}

fn ng_peep(mir: &mut Vec<MInst>, zr: i64) -> i64 {
    var changed: i64 = ng_peep_fold(mir, zr);
    var mb: MBlocks = mi_blocks(mir);
    var nb: i64 = mb.start.len();
    var lab_blk: i64 = HashMap_new();
    var k: i64 = 0;
    while k < mir.len() {
        var mp: MInst = mir.get(k);
        if mp.op == MO_PLACE {
            HashMap_insert_i(lab_blk, mp.i0, mb.of.get(k));
        }
        k = k + 1;
    }
    var b: i64 = 0;
    while b < nb {
        var st: i64 = mb.start.get(b);
        var en: i64 = mb.end.get(b);
        var k2: i64 = st;
        while k2 <= en {
            var m: MInst = mir.get(k2);
            // mov d,d -> nop
            if m.op == MO_MOV && m.r0 == m.r1 {
                mir.set(k2, mi_nop());
                changed = changed + 1;
            }
            // li/mov d overwritten before any use -> nop. Virtual registers
            // only: a physical one (an argument or the return register) is
            // read by a call, a return or a primitive without naming it, so
            // `mov p1, s; call f; ...; mov p1, 1` kept f from its argument
            // (every native Linux and --nat program printed nothing: its
            // first print called pe_len without the string)
            if (m.op == MO_LI || m.op == MO_MOV) && m.r0 >= 64 {
                var d: i64 = m.r0;
                var k3: i64 = k2 + 1;
                while k3 <= en {
                    var m3: MInst = mir.get(k3);
                    if m3.op >= 0 {
                        if ng_peep_uses(m3, d) {
                            k3 = en + 1;
                        } else if mi_defines(m3.op) && m3.r0 == d {
                            mir.set(k2, mi_nop());
                            changed = changed + 1;
                            k3 = en + 1;
                        }
                    }
                    k3 = k3 + 1;
                }
            }
            // load d,[b+x] then load d2,[b+x] with no store/call and no
            // redefine of b or d between -> mov d2,d
            if m.op == MO_LOAD {
                var k4: i64 = k2 + 1;
                while k4 <= en {
                    var m4: MInst = mir.get(k4);
                    if m4.op >= 0 {
                        if ng_peep_mem_barrier(m4) {
                            k4 = en + 1;
                        } else if m4.op == MO_LOAD && m4.r1 == m.r1 && m4.i0 == m.i0 && m4.i1 == m.i1 && m4.i2 == m.i2 {
                            mir.set(k4, MInst {
                                op: MO_MOV, r0: m4.r0, r1: m.r0, r2: 0, i0: 0, i1: 0, i2: 0
                            });
                            changed = changed + 1;
                            k4 = en + 1;
                        } else if (mi_defines(m4.op) && (m4.r0 == m.r1 || m4.r0 == m.r0)) {
                            k4 = en + 1;
                        }
                    }
                    k4 = k4 + 1;
                }
            }
            k2 = k2 + 1;
        }
        // Terminator patterns on the block's last live instruction.
        var last: i64 = en;
        while last >= st && mir.get(last).op < 0 {
            last = last - 1;
        }
        if last >= st {
            var t: MInst = mir.get(last);
            if t.op == MO_JMP || t.op == MO_BNEZ || t.op == MO_BEQZ {
                if HashMap_contains_i(lab_blk, t.i0) {
                    var tb: i64 = HashMap_get_i(lab_blk, t.i0);
                    // branch to the immediately following block -> nop
                    if tb == b + 1 {
                        mir.set(last, mi_nop());
                        changed = changed + 1;
                    } else {
                        var ts: i64 = mb.start.get(tb);
                        var te: i64 = mb.end.get(tb);
                        // first non-place inst of the target block
                        var tl: i64 = ts;
                        while tl <= te && (mir.get(tl).op == MO_PLACE || mir.get(tl).op == MO_LINE) {
                            tl = tl + 1;
                        }
                        // jump threading: target block is [PLACE* JMP L2]
                        if tl == te && tl >= ts && mir.get(tl).op == MO_JMP && mir.get(tl).i0 != t.i0 {
                            mir.set(last, MInst {
                                op: t.op, r0: t.r0, r1: t.r1, r2: t.r2, i0: mir.get(tl).i0, i1: 0, i2: 0
                            });
                            changed = changed + 1;
                        }
                        // BEQZ r,L ; JMP L2 ; L: -> BNEZ r,L2 and drop the
                        // lone-JMP block (it has no label, so only
                        // fallthrough reaches it; r==0 then lands on L's
                        // block = the one after it).
                        if t.op == MO_BEQZ || t.op == MO_BNEZ {
                            var nb2: i64 = b + 1;
                            if nb2 < nb && tb == nb2 + 1 && mb.start.get(nb2) == mb.end.get(nb2) && mir.get(mb.start.get(nb2)).op == MO_JMP {
                                var nop2: i64 = MO_BNEZ;
                                if t.op == MO_BNEZ {
                                    nop2 = MO_BEQZ;
                                }
                                var jt: MInst = mir.get(mb.start.get(nb2));
                                mir.set(last, MInst {
                                    op: nop2, r0: t.r0, r1: 0, r2: 0, i0: jt.i0, i1: 0, i2: 0
                                });
                                mir.set(mb.start.get(nb2), mi_nop());
                                changed = changed + 1;
                            }
                        }
                    }
                }
            }
        }
        b = b + 1;
    }
    if changed == 0 {
        return 0;
    }
    var out: Vec<MInst> = Vec::new();
    var j: i64 = 0;
    while j < mir.len() {
        if mir.get(j).op >= 0 {
            out.push(mir.get(j));
        }
        j = j + 1;
    }
    mir.clear();
    j = 0;
    while j < out.len() {
        mir.push(out.get(j));
        j = j + 1;
    }
    return changed;
}

// RA19: the most instructions between a compare and the branch on its
// value that ng_fuse_branches looks past (most of them are copies).
const NG_BRFUSE_GAP: i64 = 32;

/// RA19: operations whose value nothing reads, removed before branch
/// fusion: the lowering normalizes a `val c: bool` it never reads again
/// (MOV, EXT, MOV of the compare's value), and that dead read of the
/// compare kept it out of the flags. Only operations that cannot trap or
/// touch memory, defining a vreg of the function no field of any
/// operation reads (mi_use_mask: what the allocator's liveness reads
/// too), and not `keep`. Repeated while something goes. Returns the
/// number removed. `FID_NAT_OFF=deadmir`: never.
fn ng_dead_mir(mir: &mut Vec<MInst>, nvreg: i64, keep: i64) -> i64 {
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if !ng_on("deadmir") || nv <= 0 || n == 0 {
        return 0;
    }
    var removed: i64 = 0;
    var again: bool = true;
    var rounds: i64 = 0;
    while again && rounds < 8 {
        again = false;
        var uses: Vec<i64> = ng_fb_uses(mir, nv);
        var k: i64 = 0;
        while k < n {
            var m: MInst = mir.get(k);
            var op: i64 = m.op;
            var pure: bool = op == MO_LI || op == MO_MOV || op == MO_EXT || op == MO_SETCC || (op >= MO_ADD && op <= MO_NOT) || op == MO_ASR63;
            // (the lowering's `EXT v, v`: its own read is the only one,
            // so what it writes is read by nothing)
            if pure && m.r0 >= NG_VBASE && m.r0 < nvreg && m.r0 != keep && uses.get(m.r0 - NG_VBASE) == ng_fb_count(m, m.r0) {
                mir.set(k, mi_nop());
                removed = removed + 1;
                again = true;
            }
            k = k + 1;
        }
        rounds = rounds + 1;
    }
    if removed == 0 {
        return 0;
    }
    var out: Vec<MInst> = Vec::new();
    var t: i64 = 0;
    while t < mir.len() {
        if mir.get(t).op >= 0 {
            out.push(mir.get(t));
        }
        t = t + 1;
    }
    mir.clear();
    t = 0;
    while t < out.len() {
        mir.push(out.get(t));
        t = t + 1;
    }
    return removed;
}

/// MI23: fuse each compare with the conditional branch that tests it.
/// The lowering of `if a < b` records
///     SETCC c, x, y, LT     (c may be x itself: the compare's t0)
///     MOV v, c              (the IR value)
///     MOV t, v              (the branch's operand)
///     BNEZ t, L             (or BEQZ: branch when false)
/// with only MO_LINE rows between. When none of c, v, t is live after the
/// branch (block liveness over just those vregs) and no MOV of the chain
/// writes x or y, the chain becomes one `BRCC x, y, cc, L` (the inverse
/// compare for BEQZ) at the branch: x and y still hold the operands there,
/// since nothing between writes them once the SETCC is gone. A compare
/// whose value is also used elsewhere keeps its SETCC (the chain is then
/// live out). Returns the number of branches fused.
/// `FID_NAT_OFF=brfuse`: never.
/// RA19: the compare need not sit right before the branch. Up to
/// NG_BRFUSE_GAP other instructions of the same straight stretch (no
/// label, block end or call) may come between, as in `let c = a < b;
/// n = n + 1; if c { ... }`: the value then never leaves the flags (the
/// compare is made again at the branch) when none of them reads a value of
/// the chain or writes x, y or a value of the chain, and x and y are vregs
/// (or y the zero register `zr`), which no call or fixed-register
/// operation between could clobber. `FID_NAT_OFF=brgap`: adjacent only.
/// RA19, more: the chain may hold `!` of the value (an XOR with an LI 1,
/// ng_fb_not_of: the branch tests the other way; the LI goes too when
/// nothing else reads it; `FID_NAT_OFF=brnot`); before this, `&&` / `||`
/// of two compares become two compare-and-branches (ng_fuse_andor,
/// `FID_NAT_OFF=brandor`) and a compare in another block whose value only
/// a branch reads is made at the branch (ng_fuse_xblock,
/// `FID_NAT_OFF=brxblock`). The count returned includes theirs. An EXT
/// in the chain (`EXT v, v`, the lowering's normalization of a bool, or
/// `EXT d, s`) is followed like a copy: any extension of the compare's 0
/// or 1 is the same 0 or 1 (`FID_NAT_OFF=brext`).
fn ng_fuse_branches(mir: &mut Vec<MInst>, nvreg: i64, zr: i64) -> i64 {
    var gap_on: bool = ng_on("brgap");
    var not_on: bool = ng_on("brnot");
    // RA19: an EXT in the chain (`EXT v, v` normalizing a bool, or EXT d,
    // s): every extension of a 0 or 1 is the same 0 or 1
    var ext_on: bool = ng_on("brext");
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if nv <= 0 || n == 0 {
        return 0;
    }
    var pre: i64 = 0;
    if ng_on("brandor") {
        pre = pre + ng_fuse_andor(mir, nvreg, zr);
    }
    if ng_on("brxblock") {
        pre = pre + ng_fuse_xblock(mir, nvreg, zr);
    }
    n = mir.len();
    // RA19: reads of each vreg, for the LI of a `!` (ng_fb_not_of)
    var uses0: Vec<i64> = ng_fb_uses(mir, nv);
    // Candidates: the branch's position, then the positions of its chain
    // (cand_pos[cand_at[c] .. cand_at[c + 1]]), the SETCC last
    var cand_br: Vec<i64> = Vec::new();
    var cand_inv: Vec<i64> = Vec::new();
    var cand_li: Vec<i64> = Vec::new();
    var cand_gap: Vec<i64> = Vec::new();
    var cand_at: Vec<i64> = Vec::new();
    var cand_pos: Vec<i64> = Vec::new();
    var sel: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        sel.push(0 - 1);
        i = i + 1;
    }
    var nbits: i64 = 0;
    var k: i64 = 0;
    while k < n {
        var br: MInst = mir.get(k);
        if (br.op == MO_BNEZ || br.op == MO_BEQZ) && br.r0 >= NG_VBASE && br.r0 < nvreg {
            var chain: Vec<i64> = Vec::new();
            var gap: Vec<i64> = Vec::new();
            var cur: i64 = br.r0;
            var found: bool = false;
            var inv: i64 = 0;
            var lipos: i64 = 0 - 1;
            var j: i64 = k - 1;
            var walking: bool = true;
            while walking && j >= 0 {
                var mj: MInst = mir.get(j);
                var notv: Vec<i64> = Vec::new();
                if not_on && mj.op == MO_XOR && mj.r0 == cur {
                    notv = ng_fb_not_of(mir, j, nvreg);
                }
                if mj.op == MO_LINE || mj.op < 0 {
                    j = j - 1;
                } else if (mj.op == MO_MOV || (ext_on && mj.op == MO_EXT)) && mj.r0 == cur && mj.r1 >= NG_VBASE && mj.r1 < nvreg {
                    // (RA19: an EXT of the 0/1 value below it is that
                    // value again, whatever its width: brext)
                    chain.push(j);
                    cur = mj.r1;
                    j = j - 1;
                } else if notv.len() == 3 {
                    // RA19: `!` of the 0/1 value below it
                    chain.push(j);
                    inv = inv + 1;
                    cur = notv.get(0);
                    if uses0.get(notv.get(1) - NG_VBASE) == 1 {
                        lipos = notv.get(2);
                    }
                    j = j - 1;
                } else if mj.op == MO_SETCC && mj.r0 == cur {
                    chain.push(j);
                    found = true;
                    walking = false;
                } else if gap_on && gap.len() < NG_BRFUSE_GAP && !ng_fb_stop(mj.op) && mj.op != MO_PROLOGUE && !(mi_defines(mj.op) && mj.r0 == cur) {
                    // RA19: an instruction between, checked once the
                    // compare is found
                    gap.push(j);
                    j = j - 1;
                } else {
                    walking = false;
                }
            }
            if found {
                var sc: MInst = mir.get(chain.get(chain.len() - 1));
                var ok: bool = true;
                var q: i64 = 0;
                while q + 1 < chain.len() {
                    var mq: MInst = mir.get(chain.get(q));
                    if mq.r0 == sc.r1 || mq.r0 == sc.r2 {
                        ok = false;
                    }
                    q = q + 1;
                }
                if gap.len() > 0 {
                    // RA19: what lies between must leave x, y and the
                    // chain alone, and x, y must be vregs (or y zero)
                    if sc.r1 < NG_VBASE || sc.r1 >= nvreg || ((sc.r2 < NG_VBASE || sc.r2 >= nvreg) && sc.r2 != zr) {
                        ok = false;
                    }
                    var gq: i64 = 0;
                    while ok && gq < gap.len() {
                        var mg: MInst = mir.get(gap.get(gq));
                        if mi_defines(mg.op) && (mg.r0 == sc.r1 || mg.r0 == sc.r2) {
                            ok = false;
                        }
                        var cq: i64 = 0;
                        while ok && cq < chain.len() {
                            var cv: i64 = mir.get(chain.get(cq)).r0;
                            if ng_fb_count(mg, cv) > 0 || (mi_defines(mg.op) && mg.r0 == cv) {
                                ok = false;
                            }
                            cq = cq + 1;
                        }
                        gq = gq + 1;
                    }
                }
                if ok {
                    cand_br.push(k);
                    cand_inv.push(inv);
                    cand_li.push(lipos);
                    cand_gap.push(gap.len());
                    cand_at.push(cand_pos.len());
                    q = 0;
                    while q < chain.len() {
                        var pos: i64 = chain.get(q);
                        cand_pos.push(pos);
                        var dv: i64 = mir.get(pos).r0 - NG_VBASE;
                        if sel.get(dv) < 0 {
                            sel.set(dv, nbits);
                            nbits = nbits + 1;
                        }
                        q = q + 1;
                    }
                }
            }
        }
        k = k + 1;
    }
    if cand_br.len() == 0 {
        return pre;
    }
    cand_at.push(cand_pos.len());
    var mb: MBlocks = mi_blocks(mir);
    var words: i64 = (nbits + 63) / 64;
    var lin: Vec<i64> = Vec::new();
    var lout: Vec<i64> = Vec::new();
    // (RA2: from use lists)
    ng_alloc_liveness(mir, &mb, &sel, words, &mut lin, &mut lout);
    var fused: i64 = 0;
    var c: i64 = 0;
    while c < cand_br.len() {
        var bk: i64 = cand_br.get(c);
        var blk: i64 = mb.of.get(bk);
        var live: bool = false;
        var p: i64 = cand_at.get(c);
        while p < cand_at.get(c + 1) {
            var bit: i64 = sel.get(mir.get(cand_pos.get(p)).r0 - NG_VBASE);
            if (lout.get(blk * words + bit / 64) & (1 << (bit % 64))) != 0 {
                live = true;
            }
            p = p + 1;
        }
        if !live {
            var setcc: MInst = mir.get(cand_pos.get(cand_at.get(c + 1) - 1));
            var b0: MInst = mir.get(bk);
            var cc: i64 = setcc.i0;
            if b0.op == MO_BEQZ {
                cc = ng_cc_inverse(cc);
            }
            if cand_gap.get(c) > 0 && ng_mutant("brgap") {
                // TG2: the wrong sense, on purpose
                cc = ng_cc_inverse(cc);
            }
            if cand_inv.get(c) % 2 == 1 {
                // RA19: an odd number of `!` in the chain
                cc = ng_cc_inverse(cc);
                if ng_mutant("brnot") {
                    cc = ng_cc_inverse(cc);
                }
            }
            p = cand_at.get(c);
            while p < cand_at.get(c + 1) {
                mir.set(cand_pos.get(p), mi_nop());
                p = p + 1;
            }
            if cand_li.get(c) >= 0 && mir.get(cand_li.get(c)).op == MO_LI {
                // (the LI 1 of the `!`, read by nothing else)
                mir.set(cand_li.get(c), mi_nop());
            }
            mir.set(bk, MInst {
                op: MO_BRCC, r0: setcc.r1, r1: setcc.r2, r2: 0, i0: b0.i0, i1: cc, i2: 0
            });
            fused = fused + 1;
        }
        c = c + 1;
    }
    if fused == 0 {
        return pre;
    }
    var out: Vec<MInst> = Vec::new();
    var t: i64 = 0;
    while t < mir.len() {
        if mir.get(t).op >= 0 {
            out.push(mir.get(t));
        }
        t = t + 1;
    }
    mir.clear();
    t = 0;
    while t < out.len() {
        mir.push(out.get(t));
        t = t + 1;
    }
    return fused + pre;
}

/// RA19: the XOR at j as `!` of a 0/1 value: XOR d, s, o (or d, o, s)
/// with o holding an LI 1 there (ng_fb_is_li) and s another vreg: [s, o,
/// the LI's position when o is the LI's own vreg, else -1], or empty.
fn ng_fb_not_of(mir: &Vec<MInst>, j: i64, nvreg: i64) -> Vec<i64> {
    var res: Vec<i64> = Vec::new();
    var m: MInst = mir.get(j);
    if m.op != MO_XOR {
        return res;
    }
    var side: i64 = 0;
    while side < 2 {
        var s: i64 = m.r1;
        var o: i64 = m.r2;
        if side == 1 {
            s = m.r2;
            o = m.r1;
        }
        if s >= NG_VBASE && s < nvreg && o >= NG_VBASE && o < nvreg && s != o && ng_fb_is_li(mir, j, o, 1) {
            var rt: Vec<i64> = ng_fb_root(mir, j, o);
            var lp: i64 = 0 - 1;
            if rt.get(0) == o && rt.get(1) >= 0 {
                lp = rt.get(1);
            }
            res.push(s);
            res.push(o);
            res.push(lp);
            return res;
        }
        side = side + 1;
    }
    return res;
}

/// RA19: membership in a short list of vregs (ng_fuse_andor).
fn ng_ao_has(vs: &Vec<i64>, v: i64) -> bool {
    var i: i64 = 0;
    while i < vs.len() {
        if vs.get(i) == v {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// RA19: `if a < b && c < d` and `||` on the targets with flags, after
/// select formation (MI24) made the condition one select of two compares:
///     SETCC s1, x1, y1, cc1     (its copies: c, and r's value before)
///     ...                       (the second compare's operands)
///     SETCC s2, x2, y2, cc2     (its copies: t)
///     CSEL r, c, t, sense       (0: r = c ? t : r, `&&`; 1: r = c ? r : t,
///                                `||`)
///     [PLACE L0]                (labels nothing refers to)
///     MOV ... r                 (copies)
///     BEQZ / BNEZ u, L
/// becomes two compare-and-branches at the branch, no compare result in a
/// register:
///     `&&`, BEQZ: BRCC x1, y1, !cc1, L; BRCC x2, y2, !cc2, L
///     `&&`, BNEZ: BRCC x1, y1, !cc1, M; BRCC x2, y2, cc2, L
///     `||`, BNEZ: BRCC x1, y1, cc1, L;  BRCC x2, y2, cc2, L
///     `||`, BEQZ: BRCC x1, y1, cc1, M;  BRCC x2, y2, !cc2, L
/// (M: the label placed right after the branch; without one those two
/// forms stay as they are). It applies when c and r's value before the
/// CSEL come from s1 and t from s2 (copies only); the compares, the copies
/// of their values, the CSEL and the branch's copies (D) are read by D
/// only and nothing they define is live after the branch (block
/// liveness); nothing else from s1 to the branch writes x1 or y1 (from s2:
/// x2, y2); x2 and y2 are not s1's value; all four are vregs (y may be the
/// zero register zr); and the stretch from s1 to the branch has no call,
/// block end or label anything refers to. Every operation that stays ran
/// before the select on every path already. Returns the number of
/// branches rewritten. FID_NAT_MUTATE=brandor (TG2) inverts the second
/// branch.
fn ng_fuse_andor(mir: &mut Vec<MInst>, nvreg: i64, zr: i64) -> i64 {
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if nv <= 0 || n == 0 {
        return 0;
    }
    var refd: i64 = HashMap_new();
    var any: bool = false;
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        if mi_is_br(m.op) || m.op == MO_ADDR {
            HashMap_insert_i(refd, m.i0, 1);
        }
        if m.op == MO_CSEL {
            any = true;
        }
        k = k + 1;
    }
    if !any {
        return 0;
    }
    // Candidates, 7 words each: branch, CSEL, s1, s2, M (-1: none), and
    // where its D positions start and end in dlist
    var cands: Vec<i64> = Vec::new();
    var dlist: Vec<i64> = Vec::new();
    var claimed: Vec<i64> = Vec::new();
    var sel: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        claimed.push(0);
        i = i + 1;
    }
    i = 0;
    while i < nv {
        sel.push(0 - 1);
        i = i + 1;
    }
    var nbits: i64 = 0;
    k = 0;
    while k < n {
        var br: MInst = mir.get(k);
        var p: i64 = 0 - 1;
        if (br.op == MO_BNEZ || br.op == MO_BEQZ) && br.r0 >= NG_VBASE && br.r0 < nvreg {
            // back from the branch through copies (and labels nothing
            // refers to) to the CSEL
            var cur: i64 = br.r0;
            var j: i64 = k - 1;
            var walking: bool = true;
            while walking && j >= 0 {
                var mj: MInst = mir.get(j);
                if mj.op == MO_LINE || mj.op < 0 || (mj.op == MO_PLACE && !HashMap_contains_i(refd, mj.i0)) {
                    j = j - 1;
                } else if mj.op == MO_MOV && mj.r0 == cur && mj.r1 >= NG_VBASE && mj.r1 < nvreg {
                    cur = mj.r1;
                    j = j - 1;
                } else {
                    if mj.op == MO_CSEL && mj.r0 == cur && (mj.i0 == 0 || mj.i0 == 1) {
                        p = j;
                    }
                    walking = false;
                }
            }
        }
        var ok: bool = p >= 0;
        var s1: i64 = 0 - 1;
        var s2: i64 = 0 - 1;
        if ok {
            var cs: MInst = mir.get(p);
            var rc: Vec<i64> = ng_fb_root(mir, p, cs.r1);
            var rr: Vec<i64> = ng_fb_root(mir, p, cs.r0);
            var rt: Vec<i64> = ng_fb_root(mir, p, cs.r2);
            if rc.get(1) < 0 || rt.get(1) < 0 || rr.get(0) != rc.get(0) || rr.get(1) != rc.get(1) || rc.get(1) >= rt.get(1) {
                ok = false;
            } else {
                s1 = rc.get(1);
                s2 = rt.get(1);
                if mir.get(s1).op != MO_SETCC || mir.get(s2).op != MO_SETCC {
                    ok = false;
                }
            }
        }
        var a1: MInst = mi_nop();
        var a2: MInst = mi_nop();
        if ok {
            a1 = mir.get(s1);
            a2 = mir.get(s2);
            if a1.r1 < NG_VBASE || a1.r1 >= nvreg || ((a1.r2 < NG_VBASE || a1.r2 >= nvreg) && a1.r2 != zr) {
                ok = false;
            }
            if a2.r1 < NG_VBASE || a2.r1 >= nvreg || ((a2.r2 < NG_VBASE || a2.r2 >= nvreg) && a2.r2 != zr) {
                ok = false;
            }
            if a1.r0 < NG_VBASE || a1.r0 >= nvreg || a2.r0 < NG_VBASE || a2.r0 >= nvreg {
                ok = false;
            }
        }
        // the label right after the branch, for the forms that skip the
        // second one
        var mlab: i64 = 0 - 1;
        if ok {
            var after: i64 = k + 1;
            while after < n && mir.get(after).op == MO_LINE {
                after = after + 1;
            }
            if after < n && mir.get(after).op == MO_PLACE {
                mlab = mir.get(after).i0;
            }
            var andf: bool = mir.get(p).i0 == 0;
            if (andf && br.op == MO_BNEZ) || (!andf && br.op == MO_BEQZ) {
                if mlab < 0 {
                    ok = false;
                }
            }
        }
        // D, forward from s1: what derives from the two compares
        var dvals: Vec<i64> = Vec::new();
        var dpos: Vec<i64> = Vec::new();
        var q: i64 = s1;
        while ok && q <= k {
            var mq: MInst = mir.get(q);
            // (line rows, holes and labels nothing refers to: no code)
            var plain: bool = mq.op == MO_LINE || mq.op < 0 || (mq.op == MO_PLACE && !HashMap_contains_i(refd, mq.i0));
            if claimed.get(q) != 0 {
                ok = false;
            } else if plain {
                plain = true;
            } else if q == s1 || q == s2 {
                if q == s2 && (ng_ao_has(&dvals, mq.r1) || ng_ao_has(&dvals, mq.r2)) {
                    ok = false;
                }
                dpos.push(q);
                dvals.push(mq.r0);
            } else if q == p {
                if !ng_ao_has(&dvals, mq.r0) || !ng_ao_has(&dvals, mq.r1) || !ng_ao_has(&dvals, mq.r2) {
                    ok = false;
                }
                dpos.push(q);
            } else if q == k {
                if !ng_ao_has(&dvals, mq.r0) {
                    ok = false;
                }
                dpos.push(q);
            } else if ng_fb_stop(mq.op) || mq.op == MO_PROLOGUE {
                ok = false;
            } else if mq.op == MO_MOV && ng_ao_has(&dvals, mq.r1) {
                if mq.r0 < NG_VBASE || mq.r0 >= nvreg {
                    ok = false;
                }
                dpos.push(q);
                dvals.push(mq.r0);
            } else {
                // an operation that stays: it reads no value of D and
                // leaves the compares' operands alone
                var um: i64 = mi_use_mask(mq.op);
                var f: i64 = 0;
                while f < 3 {
                    if (um & (1 << f)) != 0 && ng_ao_has(&dvals, mi_field(mq, f)) {
                        ok = false;
                    }
                    f = f + 1;
                }
                if mi_defines(mq.op) {
                    if mq.r0 == a1.r1 || mq.r0 == a1.r2 {
                        ok = false;
                    }
                    if q > s2 && (mq.r0 == a2.r1 || mq.r0 == a2.r2) {
                        ok = false;
                    }
                    // (overwritten: no longer a value of D)
                    var w: i64 = 0;
                    while w < dvals.len() {
                        if dvals.get(w) == mq.r0 {
                            dvals.set(w, 0 - 1);
                        }
                        w = w + 1;
                    }
                }
            }
            q = q + 1;
        }
        if ok {
            cands.push(k);
            cands.push(p);
            cands.push(s1);
            cands.push(s2);
            cands.push(mlab);
            cands.push(dlist.len());
            var dq: i64 = 0;
            while dq < dpos.len() {
                var at: i64 = dpos.get(dq);
                dlist.push(at);
                claimed.set(at, 1);
                if at != k {
                    var dv: i64 = mir.get(at).r0 - NG_VBASE;
                    if sel.get(dv) < 0 {
                        sel.set(dv, nbits);
                        nbits = nbits + 1;
                    }
                }
                dq = dq + 1;
            }
            cands.push(dlist.len());
        }
        k = k + 1;
    }
    if cands.len() == 0 {
        return 0;
    }
    var mb: MBlocks = mi_blocks(mir);
    var words: i64 = (nbits + 63) / 64;
    var lin: Vec<i64> = Vec::new();
    var lout: Vec<i64> = Vec::new();
    mi_liveness(mir, &mb, &sel, words, &mut lin, &mut lout);
    // per position: 0 keep, 1 drop, 2 the branch (two BRCCs at it)
    var act: Vec<i64> = Vec::new();
    var first: Vec<MInst> = Vec::new();
    var second: Vec<MInst> = Vec::new();
    i = 0;
    while i < n {
        act.push(0);
        first.push(mi_nop());
        second.push(mi_nop());
        i = i + 1;
    }
    var done: i64 = 0;
    var c: i64 = 0;
    while c + 7 <= cands.len() {
        var bk: i64 = cands.get(c);
        var blk: i64 = mb.of.get(bk);
        var live: bool = false;
        var dq2: i64 = cands.get(c + 5);
        while dq2 < cands.get(c + 6) {
            var at2: i64 = dlist.get(dq2);
            if at2 != bk {
                var bit: i64 = sel.get(mir.get(at2).r0 - NG_VBASE);
                if (lout.get(blk * words + bit / 64) & (1 << (bit % 64))) != 0 {
                    live = true;
                }
            }
            dq2 = dq2 + 1;
        }
        if !live {
            var b0: MInst = mir.get(bk);
            var c1: MInst = mir.get(cands.get(c + 2));
            var c2: MInst = mir.get(cands.get(c + 3));
            var andf2: bool = mir.get(cands.get(c + 1)).i0 == 0;
            var cc1: i64 = c1.i0;
            var cc2: i64 = c2.i0;
            var l1: i64 = b0.i0;
            if andf2 {
                cc1 = ng_cc_inverse(cc1);
                if b0.op == MO_BEQZ {
                    cc2 = ng_cc_inverse(cc2);
                } else {
                    l1 = cands.get(c + 4);
                }
            } else if b0.op == MO_BEQZ {
                cc2 = ng_cc_inverse(cc2);
                l1 = cands.get(c + 4);
            }
            if ng_mutant("brandor") {
                // TG2: the wrong sense, on purpose
                cc2 = ng_cc_inverse(cc2);
            }
            dq2 = cands.get(c + 5);
            while dq2 < cands.get(c + 6) {
                act.set(dlist.get(dq2), 1);
                dq2 = dq2 + 1;
            }
            act.set(bk, 2);
            first.set(bk, MInst {
                op: MO_BRCC, r0: c1.r1, r1: c1.r2, r2: 0, i0: l1, i1: cc1, i2: 0
            });
            second.set(bk, MInst {
                op: MO_BRCC, r0: c2.r1, r1: c2.r2, r2: 0, i0: b0.i0, i1: cc2, i2: 0
            });
            done = done + 1;
        }
        c = c + 7;
    }
    if done == 0 {
        return 0;
    }
    var out: Vec<MInst> = Vec::new();
    var t: i64 = 0;
    while t < n {
        if act.get(t) == 2 {
            out.push(first.get(t));
            out.push(second.get(t));
        } else if act.get(t) == 0 && mir.get(t).op >= 0 {
            out.push(mir.get(t));
        }
        t = t + 1;
    }
    mir.clear();
    t = 0;
    while t < out.len() {
        mir.push(out.get(t));
        t = t + 1;
    }
    return done;
}

/// RA19: a compare in another block whose value only a branch reads, as in
/// `val c: bool = a < b; if x > 0 { ... } if c { ... }`. The branch
/// becomes `BRCC x, y, cc, L` on the compare's operands, the compare and
/// the copies of its value (D) go, and the value is never in a register:
/// x and y live to the branch instead. It applies when the branch's
/// operand comes through copies from a SETCC s, x y, cc in a block A that
/// dominates the branch's block; the copies outside the branch's own
/// stretch are in A after s; every vreg D defines is written by D only
/// (when the compare writes over x: x also by its one definition) and read
/// by D and the branch only; and x and y are vregs (y may be the zero
/// register zr), each written once apart from D, in A before s. Wherever
/// the branch then runs, x and y hold what s compared: A runs whole once
/// entered (calls return, a panic does not come back), so each time x or
/// y is written, s and the copies after it run too, and A ran on every
/// way to the branch. Not when a label of the function is address-taken
/// (a way in the blocks would not show). Returns the number of branches
/// rewritten. FID_NAT_MUTATE=brxblock (TG2): the inverse condition.
/// RA19, more: the chain may also hold an EXT (`EXT d, s`, or the in-place
/// `EXT v, v` that normalizes a bool: an extension of 0 or 1 is the same
/// value; FID_NAT_OFF=brext) and `!` (an XOR with an LI 1, in place or
/// not, ng_fb_not_of: each flips the branch's condition, and its LI goes
/// when nothing else reads it; FID_NAT_OFF=brnot), in the branch's stretch
/// or in A; a vreg an in-place one changes then has two definitions, both
/// in the chain.
fn ng_fuse_xblock(mir: &mut Vec<MInst>, nvreg: i64, zr: i64) -> i64 {
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if nv <= 0 || n == 0 {
        return 0;
    }
    var ndef: Vec<i64> = Vec::new();
    var lastdef: Vec<i64> = Vec::new();
    // (RA19: the definition before the last, for an in-place EXT v, v or
    // XOR v, v, one: the value it changes)
    var prevdef: Vec<i64> = Vec::new();
    var not_on: bool = ng_on("brnot");
    var ext_on: bool = ng_on("brext");
    var i: i64 = 0;
    while i < nv {
        ndef.push(0);
        lastdef.push(0 - 1);
        prevdef.push(0 - 1);
        i = i + 1;
    }
    var placed: i64 = HashMap_new();
    var nbr: i64 = 0;
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        if m.op >= 0 && mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 < nvreg {
            ndef.set(m.r0 - NG_VBASE, ndef.get(m.r0 - NG_VBASE) + 1);
            prevdef.set(m.r0 - NG_VBASE, lastdef.get(m.r0 - NG_VBASE));
            lastdef.set(m.r0 - NG_VBASE, k);
        }
        if m.op == MO_BNEZ || m.op == MO_BEQZ {
            nbr = nbr + 1;
        }
        if m.op == MO_PLACE {
            HashMap_insert_i(placed, m.i0, 1);
        }
        k = k + 1;
    }
    if nbr == 0 {
        return 0;
    }
    k = 0;
    while k < n {
        if mir.get(k).op == MO_ADDR && HashMap_contains_i(placed, mir.get(k).i0) {
            return 0;
        }
        k = k + 1;
    }
    var uses: Vec<i64> = ng_fb_uses(mir, nv);
    var mb: MBlocks = mi_blocks(mir);
    var nb: i64 = mb.start.len();
    // Candidates, 6 words each: branch, compare, block A, end of its
    // positions in clist (from the previous candidate's end), the number
    // of `!` in its chain, end of its LIs to remove in xlis (RA19)
    var cands: Vec<i64> = Vec::new();
    var clist: Vec<i64> = Vec::new();
    var xlis: Vec<i64> = Vec::new();
    var claimed: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        claimed.push(0);
        i = i + 1;
    }
    k = 0;
    while k < n {
        var br: MInst = mir.get(k);
        var ok: bool = false;
        var chain: Vec<i64> = Vec::new();
        var cur: i64 = br.r0;
        // RA19: `!` links in the chain (each an XOR with an LI 1) and the
        // LIs only those XORs read
        var inv: i64 = 0;
        var lis: Vec<i64> = Vec::new();
        if (br.op == MO_BNEZ || br.op == MO_BEQZ) && br.r0 >= NG_VBASE && br.r0 < nvreg {
            // the branch's own stretch: copies (EXT and `!` of the 0/1
            // value too), the value made before it
            var j: i64 = k - 1;
            var walking: bool = true;
            while walking && j >= 0 {
                var mj: MInst = mir.get(j);
                if mj.op < 0 || mj.op == MO_LINE {
                    j = j - 1;
                } else if ng_fb_stop(mj.op) || mj.op == MO_PROLOGUE {
                    ok = true;
                    walking = false;
                } else if mi_defines(mj.op) && mj.r0 == cur {
                    var nv1: Vec<i64> = Vec::new();
                    if not_on && mj.op == MO_XOR {
                        nv1 = ng_fb_not_of(mir, j, nvreg);
                    }
                    if (mj.op == MO_MOV || (ext_on && mj.op == MO_EXT)) && mj.r1 >= NG_VBASE && mj.r1 < nvreg {
                        chain.push(j);
                        cur = mj.r1;
                        j = j - 1;
                    } else if nv1.len() == 3 {
                        chain.push(j);
                        inv = inv + 1;
                        cur = nv1.get(0);
                        if nv1.get(2) >= 0 && uses.get(nv1.get(1) - NG_VBASE) == 1 {
                            lis.push(nv1.get(2));
                        }
                        j = j - 1;
                    } else {
                        // (made in the stretch: ng_fuse_branches' own case)
                        walking = false;
                    }
                } else {
                    j = j - 1;
                }
            }
        }
        // then each value's one definition, back to the compare, all in A
        var s: i64 = 0 - 1;
        var blka: i64 = 0 - 1;
        var lastp: i64 = n;
        var steps: i64 = 0;
        while ok && s < 0 && steps < 16 {
            if cur < NG_VBASE || cur >= nvreg {
                ok = false;
            } else {
                var vi: i64 = cur - NG_VBASE;
                var d: i64 = 0 - 1;
                var ld: i64 = lastdef.get(vi);
                var pd: i64 = prevdef.get(vi);
                // (RA19: definitions of cur the chain holds already: an
                // in-place EXT / `!` of the branch's stretch)
                var already: i64 = 0;
                var aq: i64 = 0;
                while aq < chain.len() {
                    if mir.get(chain.get(aq)).r0 == cur {
                        already = already + 1;
                    }
                    aq = aq + 1;
                }
                var ipn: Vec<i64> = Vec::new();
                if not_on && already == 0 && ndef.get(vi) == 2 && ld >= 0 && mir.get(ld).op == MO_XOR && mir.get(ld).r1 == cur {
                    ipn = ng_fb_not_of(mir, ld, nvreg);
                }
                if already == 0 && ndef.get(vi) == 1 {
                    d = ld;
                } else if already == 0 && ndef.get(vi) == 2 && mir.get(ld).op == MO_SETCC && mir.get(ld).r1 == cur {
                    // the compare over its own first operand
                    d = ld;
                } else if already == 1 && ndef.get(vi) == 2 && ng_ao_has(&chain, ld) && pd >= 0 {
                    // RA19: the stretch's in-place EXT / `!` changed the
                    // value made by its one other definition
                    d = pd;
                } else if already == 0 && ndef.get(vi) == 2 && pd >= 0 && mb.of.get(pd) == mb.of.get(ld) && ((ext_on && mir.get(ld).op == MO_EXT && mir.get(ld).r1 == cur) || (ipn.len() == 3 && ipn.get(0) == cur)) {
                    // RA19: an in-place EXT v, v or `!` (XOR v, v, one) in
                    // A after the value's one other definition
                    if blka >= 0 && (mb.of.get(ld) != blka || ld >= lastp) {
                        ok = false;
                    }
                    blka = mb.of.get(ld);
                    lastp = ld;
                    chain.push(ld);
                    if mir.get(ld).op == MO_XOR {
                        inv = inv + 1;
                        if ipn.get(2) >= 0 && uses.get(ipn.get(1) - NG_VBASE) == 1 {
                            lis.push(ipn.get(2));
                        }
                    }
                    d = pd;
                }
                if d < 0 || !ok {
                    ok = false;
                } else {
                    if blka >= 0 && (mb.of.get(d) != blka || d >= lastp) {
                        ok = false;
                    }
                    blka = mb.of.get(d);
                    lastp = d;
                    var md: MInst = mir.get(d);
                    var nv2: Vec<i64> = Vec::new();
                    if not_on && md.op == MO_XOR && md.r1 != md.r0 && md.r2 != md.r0 {
                        nv2 = ng_fb_not_of(mir, d, nvreg);
                    }
                    if md.op == MO_SETCC {
                        s = d;
                        chain.push(d);
                    } else if (md.op == MO_MOV || (ext_on && md.op == MO_EXT && md.r1 != md.r0)) && md.r1 >= NG_VBASE && md.r1 < nvreg {
                        chain.push(d);
                        cur = md.r1;
                    } else if nv2.len() == 3 {
                        // RA19: `!` of a 0/1 value in A
                        chain.push(d);
                        inv = inv + 1;
                        if nv2.get(2) >= 0 && uses.get(nv2.get(1) - NG_VBASE) == 1 {
                            lis.push(nv2.get(2));
                        }
                        cur = nv2.get(0);
                    } else {
                        ok = false;
                    }
                }
            }
            steps = steps + 1;
        }
        if s < 0 {
            ok = false;
        }
        var sc: MInst = mi_nop();
        if ok {
            sc = mir.get(s);
            // x and y: written once apart from D, in A before s
            var oi: i64 = 0;
            while ok && oi < 2 {
                var o: i64 = sc.r1;
                if oi == 1 {
                    o = sc.r2;
                }
                if oi == 1 && o == zr {
                    oi = oi + 0;
                } else if o < NG_VBASE || o >= nvreg {
                    ok = false;
                } else {
                    var cd: i64 = 0;
                    var cq: i64 = 0;
                    while cq < chain.len() {
                        if mir.get(chain.get(cq)).r0 == o {
                            cd = cd + 1;
                        }
                        cq = cq + 1;
                    }
                    if cd > 1 || (cd == 1 && sc.r0 != o) || ndef.get(o - NG_VBASE) - cd != 1 {
                        ok = false;
                    }
                    var fd: bool = false;
                    var p2: i64 = mb.start.get(blka);
                    while p2 < s {
                        var m2: MInst = mir.get(p2);
                        if m2.op >= 0 && mi_defines(m2.op) && m2.r0 == o {
                            fd = true;
                        }
                        p2 = p2 + 1;
                    }
                    if !fd {
                        ok = false;
                    }
                }
                oi = oi + 1;
            }
        }
        if ok {
            // D's values: written by D only, read by D and the branch only
            var cq2: i64 = 0;
            while ok && cq2 < chain.len() {
                var v: i64 = mir.get(chain.get(cq2)).r0;
                if claimed.get(chain.get(cq2)) != 0 || v < NG_VBASE || v >= nvreg {
                    ok = false;
                } else {
                    var dcount: i64 = 0;
                    var rcount: i64 = ng_fb_count(br, v);
                    var cq3: i64 = 0;
                    while cq3 < chain.len() {
                        var mc: MInst = mir.get(chain.get(cq3));
                        if mc.r0 == v {
                            dcount = dcount + 1;
                        }
                        rcount = rcount + ng_fb_count(mc, v);
                        cq3 = cq3 + 1;
                    }
                    var extra: i64 = 0;
                    if v == sc.r1 || v == sc.r2 {
                        extra = 1;
                    }
                    if ndef.get(v - NG_VBASE) != dcount + extra || uses.get(v - NG_VBASE) != rcount {
                        ok = false;
                    }
                }
                cq2 = cq2 + 1;
            }
        }
        if ok && nb > 0 {
            cands.push(k);
            cands.push(s);
            cands.push(blka);
            var cq4: i64 = 0;
            while cq4 < chain.len() {
                clist.push(chain.get(cq4));
                claimed.set(chain.get(cq4), 1);
                cq4 = cq4 + 1;
            }
            cands.push(clist.len());
            // RA19: the number of `!` and the end of its LIs in xlis
            cands.push(inv);
            var lq: i64 = 0;
            while lq < lis.len() {
                xlis.push(lis.get(lq));
                lq = lq + 1;
            }
            cands.push(xlis.len());
        }
        k = k + 1;
    }
    if cands.len() == 0 {
        return 0;
    }
    var s0: Vec<i64> = Vec::new();
    var s1: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < nb {
        var ss: Vec<i64> = mb.succs.get(b);
        s0.push(0 - 1);
        s1.push(0 - 1);
        if ss.len() > 0 {
            s0.set(b, ss.get(0));
        }
        if ss.len() > 1 {
            s1.set(b, ss.get(1));
        }
        b = b + 1;
    }
    var dom: NgDom = ng_dom_build(&s0, &s1);
    var done: i64 = 0;
    var from: i64 = 0;
    var lfrom: i64 = 0;
    var c: i64 = 0;
    while c + 6 <= cands.len() {
        var bk: i64 = cands.get(c);
        var sp: i64 = cands.get(c + 1);
        var ba: i64 = cands.get(c + 2);
        var to: i64 = cands.get(c + 3);
        var ninv: i64 = cands.get(c + 4);
        var lto: i64 = cands.get(c + 5);
        var bb: i64 = mb.of.get(bk);
        if ng_dom_has(&dom, ba, bb) && (ba != bb || sp < bk) {
            var setcc: MInst = mir.get(sp);
            var b0: MInst = mir.get(bk);
            var cc: i64 = setcc.i0;
            if b0.op == MO_BEQZ {
                cc = ng_cc_inverse(cc);
            }
            if ng_mutant("brxblock") {
                // TG2: the wrong sense, on purpose
                cc = ng_cc_inverse(cc);
            }
            if ninv % 2 == 1 {
                // RA19: an odd number of `!` in the chain
                cc = ng_cc_inverse(cc);
                if ng_mutant("brnot") {
                    cc = ng_cc_inverse(cc);
                }
            }
            var p: i64 = from;
            while p < to {
                mir.set(clist.get(p), mi_nop());
                p = p + 1;
            }
            p = lfrom;
            while p < lto {
                // (the LI 1 of a `!`, read by nothing else)
                if mir.get(xlis.get(p)).op == MO_LI {
                    mir.set(xlis.get(p), mi_nop());
                }
                p = p + 1;
            }
            mir.set(bk, MInst {
                op: MO_BRCC, r0: setcc.r1, r1: setcc.r2, r2: 0, i0: b0.i0, i1: cc, i2: 0
            });
            done = done + 1;
        }
        from = to;
        lfrom = lto;
        c = c + 6;
    }
    if done == 0 {
        return 0;
    }
    var out: Vec<MInst> = Vec::new();
    var t: i64 = 0;
    while t < mir.len() {
        if mir.get(t).op >= 0 {
            out.push(mir.get(t));
        }
        t = t + 1;
    }
    mir.clear();
    t = 0;
    while t < out.len() {
        mir.push(out.get(t));
        t = t + 1;
    }
    return done;
}

/// TG8/TG7: the bit a constant has when it has exactly one, else -1.
fn ng_one_bit(v: i64) -> i64 {
    var b: i64 = 0;
    while b < 64 {
        if v == (1 << b) {
            return b;
        }
        b = b + 1;
    }
    return 0 - 1;
}

/// TG8/TG7: a branch on one bit as one test-bit branch (MO_TBNZ). The
/// lowering of `if (x & 8) != 0` or `if (x >> k) & 1 == 1` records
///     LI c, 8                  (or SHR s, x, LI k; LI c, 1)
///     AND a, x, c              (either operand order)
///     MOV ... a                (vreg copies, MOV / LI / line rows only)
///     BRCC a, zero, NE, L      (after ng_fuse_branches; or BNEZ / BEQZ
///                               a, or BRCC a, c', EQ / NE with c' = LI c)
/// and when nothing else reads what the AND (and the SHR) and the copies
/// define, and x is not written before the branch, the branch becomes
/// `TBNZ x, bit, L` (branch when set, i2 0) or the clear test (i2 1). The
/// constants left without a reader go. `keep`: a vreg read without naming
/// it, never removed. `zr`: the zero register of compares (g.zr).
/// Returns the number of branches selected. `FID_NAT_OFF=tbz`: never.
fn ng_fuse_tbz(mir: &mut Vec<MInst>, nvreg: i64, keep: i64, zr: i64) -> i64 {
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if !ng_on("tbz") || nv <= 0 || n == 0 {
        return 0;
    }
    var uses: Vec<i64> = ng_fb_uses(mir, nv);
    var touched: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        touched.push(0);
        i = i + 1;
    }
    var fused: i64 = 0;
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        // sense: 0 branch when a != 0, 1 when a == 0; other: the BRCC's
        // second operand when it is not zero (a compare with the mask)
        var a: i64 = 0 - 1;
        var sense: i64 = 0 - 1;
        var other: i64 = 0 - 1;
        if m.op == MO_BNEZ || m.op == MO_BEQZ {
            a = m.r0;
            sense = 0;
            if m.op == MO_BEQZ {
                sense = 1;
            }
        } else if m.op == MO_BRCC && (m.i1 == NCC_NE || m.i1 == NCC_EQ) {
            a = m.r0;
            sense = 0;
            if m.i1 == NCC_EQ {
                sense = 1;
            }
            if m.r1 != zr && !(m.r1 >= NG_VBASE && m.r1 < nvreg && ng_fb_is_li(mir, k, m.r1, 0)) {
                if m.r1 >= NG_VBASE && m.r1 < nvreg {
                    other = m.r1;
                } else {
                    a = 0 - 1;
                }
            }
        }
        var done: bool = false;
        if a >= NG_VBASE && a < nvreg && a != keep {
            var dpos: Vec<i64> = Vec::new();
            var p: i64 = ng_fb_chain(mir, k, a, &mut dpos);
            if p >= 0 && mir.get(p).op == MO_AND {
                var md: MInst = mir.get(p);
                var side: i64 = 0;
                while side < 2 && !done {
                    var x: i64 = md.r1;
                    var c: i64 = md.r2;
                    if side == 1 {
                        x = md.r2;
                        c = md.r1;
                    }
                    var bit: i64 = 0 - 1;
                    var mval: i64 = 0;
                    var rt: Vec<i64> = ng_fb_root(mir, p, c);
                    if rt.get(0) >= 0 && rt.get(1) >= 0 && mir.get(rt.get(1)).op == MO_LI {
                        mval = mir.get(rt.get(1)).i0;
                        bit = ng_one_bit(mval);
                    }
                    // a compare with the mask itself: equal = the bit set
                    var bsense: i64 = sense;
                    if bit >= 0 && other >= 0 {
                        if ng_fb_is_li(mir, k, other, mval) {
                            bsense = 1 - sense;
                        } else {
                            bit = 0 - 1;
                        }
                    }
                    if bit >= 0 && x >= NG_VBASE && x < nvreg && x != c {
                        var del: Vec<i64> = Vec::new();
                        var q: i64 = 0;
                        while q < dpos.len() {
                            del.push(dpos.get(q));
                            q = q + 1;
                        }
                        del.push(p);
                        var tested: i64 = x;
                        var tbit: i64 = bit;
                        var from: i64 = p;
                        if mval == 1 {
                            // (y >> s) & 1: bit s of y, when the shift's
                            // value goes too
                            var sp: Vec<i64> = Vec::new();
                            var ps: i64 = ng_fb_chain(mir, p, x, &mut sp);
                            if ps >= 0 && (mir.get(ps).op == MO_SHR || mir.get(ps).op == MO_SAR) {
                                var ms: MInst = mir.get(ps);
                                var rs: Vec<i64> = ng_fb_root(mir, ps, ms.r2);
                                if ms.r1 >= NG_VBASE && ms.r1 < nvreg && ms.r1 != ms.r2 && rs.get(0) >= 0 && rs.get(1) >= 0 && mir.get(rs.get(1)).op == MO_LI {
                                    var sh: i64 = mir.get(rs.get(1)).i0;
                                    if sh >= 0 && sh <= 63 {
                                        var del2: Vec<i64> = Vec::new();
                                        q = 0;
                                        while q < del.len() {
                                            del2.push(del.get(q));
                                            q = q + 1;
                                        }
                                        q = 0;
                                        while q < sp.len() {
                                            del2.push(sp.get(q));
                                            q = q + 1;
                                        }
                                        del2.push(ps);
                                        if ng_tbz_ok(mir, &uses, &del2, ps, k, ms.r1, keep, nv) {
                                            del = del2;
                                            tested = ms.r1;
                                            tbit = sh;
                                            from = ps;
                                        }
                                    }
                                }
                            }
                        }
                        if ng_tbz_ok(mir, &uses, &del, from, k, tested, keep, nv) {
                            if ng_mutant("tbz") {
                                // TG2: the wrong bit, on purpose
                                tbit = (tbit + 1) % 64;
                            }
                            q = 0;
                            while q < del.len() {
                                ng_fb_touch(&mut touched, mir.get(del.get(q)), nv);
                                mir.set(del.get(q), mi_nop());
                                q = q + 1;
                            }
                            ng_fb_touch(&mut touched, m, nv);
                            mir.set(k, MInst {
                                op: MO_TBNZ, r0: tested, r1: 0, r2: 0, i0: m.i0, i1: tbit, i2: bsense
                            });
                            uses = ng_fb_uses(mir, nv);
                            fused = fused + 1;
                            done = true;
                        }
                    }
                    side = side + 1;
                }
            }
        }
        k = k + 1;
    }
    if fused == 0 {
        return 0;
    }
    // Constants and copies nothing reads any more (they fed what went)
    var again: bool = true;
    var rounds: i64 = 0;
    while again && rounds < 8 {
        again = false;
        uses = ng_fb_uses(mir, nv);
        var r: i64 = 0;
        while r < n {
            var mr: MInst = mir.get(r);
            if (mr.op == MO_MOV || mr.op == MO_LI) && mr.r0 >= NG_VBASE && mr.r0 < nvreg && mr.r0 != keep {
                var vi: i64 = mr.r0 - NG_VBASE;
                if touched.get(vi) != 0 && uses.get(vi) == 0 {
                    ng_fb_touch(&mut touched, mr, nv);
                    mir.set(r, mi_nop());
                    again = true;
                }
            }
            r = r + 1;
        }
        rounds = rounds + 1;
    }
    var out: Vec<MInst> = Vec::new();
    var t: i64 = 0;
    while t < mir.len() {
        if mir.get(t).op >= 0 {
            out.push(mir.get(t));
        }
        t = t + 1;
    }
    mir.clear();
    t = 0;
    while t < out.len() {
        mir.push(out.get(t));
        t = t + 1;
    }
    return fused;
}

/// TG8: the instructions at `del` may go and the branch at k test
/// `tested` instead: what they define only they and k read (none of it
/// `keep`), and `tested` keeps its value from `from` (where the deleted
/// code read it) to k. The instruction at `from` may itself write
/// `tested` (the lowering's `AND v, v, c`): once it is gone, v holds what
/// it read.
fn ng_tbz_ok(mir: &Vec<MInst>, uses: &Vec<i64>, del: &Vec<i64>, from: i64, k: i64, tested: i64, keep: i64, nv: i64) -> bool {
    var q: i64 = 0;
    while q < del.len() {
        if mir.get(del.get(q)).r0 == keep {
            return false;
        }
        q = q + 1;
    }
    return ng_fb_deletable(mir, uses, del, k, nv) && !ng_fb_defines_but(mir, del, tested, from) && !ng_fb_redef(mir, del, from, k, tested);
}

/// TG8/TG9: an instruction at dpos other than the one at `but` writes v.
fn ng_fb_defines_but(mir: &Vec<MInst>, dpos: &Vec<i64>, v: i64, but: i64) -> bool {
    var j: i64 = 0;
    while j < dpos.len() {
        if dpos.get(j) != but && mir.get(dpos.get(j)).r0 == v {
            return true;
        }
        j = j + 1;
    }
    return false;
}

/// TG9: sext.w elision. A wrapping i32 add, sub or mul is recorded as
///     ADD s, a, b          (SUB, MUL)
///     MOV ... s            (vreg copies; MOV / LI / line rows only)
///     EXT e, s', SW        (the normalization, ng_gen_narrow)
/// and when nothing else reads s and its copies (a checked operation
/// compares s with e: it keeps both) and a, b are not written in between,
/// the pair becomes `OPW e, a, b` — one ADDW / SUBW / MULW on RISC-V
/// (ng_sel_has MO_OPW). Returns the number formed.
/// `FID_NAT_OFF=opw`: never.
fn ng_fuse_opw(g: &NatGen, mir: &mut Vec<MInst>, nvreg: i64, keep: i64) -> i64 {
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if !ng_sel_has(g, MO_OPW) || !ng_on("opw") || nv <= 0 || n == 0 {
        return 0;
    }
    var uses: Vec<i64> = ng_fb_uses(mir, nv);
    var fused: i64 = 0;
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        if m.op == MO_EXT && m.i0 == NEXT_SW && m.r1 >= NG_VBASE && m.r1 < nvreg && m.r1 != keep {
            var dpos: Vec<i64> = Vec::new();
            var p: i64 = ng_fb_chain(mir, k, m.r1, &mut dpos);
            if p >= 0 {
                var md: MInst = mir.get(p);
                var kind: i64 = 0 - 1;
                if md.op == MO_ADD {
                    kind = 0;
                } else if md.op == MO_SUB {
                    kind = 1;
                } else if md.op == MO_MUL {
                    kind = 2;
                }
                if kind >= 0 {
                    dpos.push(p);
                    var ok: bool = ng_fb_deletable(mir, &uses, &dpos, k, nv);
                    var q: i64 = 0;
                    while ok && q < dpos.len() {
                        if mir.get(dpos.get(q)).r0 == keep {
                            ok = false;
                        }
                        q = q + 1;
                    }
                    // (the operation itself may write its operand: the
                    // lowering's `ADD v, v, w`; once gone, v holds a)
                    if ok && (ng_fb_defines_but(mir, &dpos, md.r1, p) || ng_fb_defines_but(mir, &dpos, md.r2, p)) {
                        ok = false;
                    }
                    if ok && (ng_fb_redef(mir, &dpos, p, k, md.r1) || ng_fb_redef(mir, &dpos, p, k, md.r2)) {
                        ok = false;
                    }
                    if ok {
                        if ng_mutant("opw") {
                            // TG2: the wrong operation, on purpose
                            kind = (kind + 1) % 3;
                        }
                        q = 0;
                        while q < dpos.len() {
                            mir.set(dpos.get(q), mi_nop());
                            q = q + 1;
                        }
                        mir.set(k, MInst {
                            op: MO_OPW, r0: m.r0, r1: md.r1, r2: md.r2, i0: kind, i1: 0, i2: 0
                        });
                        uses = ng_fb_uses(mir, nv);
                        fused = fused + 1;
                    }
                }
            }
        }
        k = k + 1;
    }
    if fused == 0 {
        return 0;
    }
    var out: Vec<MInst> = Vec::new();
    var t: i64 = 0;
    while t < mir.len() {
        if mir.get(t).op >= 0 {
            out.push(mir.get(t));
        }
        t = t + 1;
    }
    mir.clear();
    t = 0;
    while t < out.len() {
        mir.push(out.get(t));
        t = t + 1;
    }
    return fused;
}

// --- MI24: conditional selects ----------------------------------------------

// The most operations (moves and line rows aside, which mostly cost
// nothing once coalesced) one arm of a diamond may hold to become a
// select: both arms run unconditionally afterwards. NG_SEL_ARM_OPS bounds
// the moves too.
const NG_SEL_ARM_MAX: i64 = 4;
const NG_SEL_ARM_OPS: i64 = 16;

/// MI24: may `m` sit in an arm that a select runs unconditionally? An
/// operation that cannot trap, touch memory or flags between operations,
/// or branch, and whose every register operand is a vreg of the function.
fn ng_sel_pure(m: MInst, nvreg: i64) -> bool {
    var op: i64 = m.op;
    var ok: bool = op == MO_LI || op == MO_MOV || (op >= MO_ADD && op <= MO_NOT) || op == MO_SETCC || op == MO_EXT || op == MO_ASR63 || op == MO_ADDSHL || op == MO_ANDN || op == MO_BLSR;
    if !ok {
        return false;
    }
    var um: i64 = mi_use_mask(op);
    var f: i64 = 0;
    while f < 3 {
        if (um & (1 << f)) != 0 || (f == 0 && mi_defines(op)) {
            var v: i64 = mi_field(m, f);
            if v < NG_VBASE || v >= nvreg {
                return false;
            }
        }
        f = f + 1;
    }
    return true;
}

/// MI24: every definition in mir[lo .. hi) (but the one at `skip`) writes
/// either `allow` or a vreg all of whose definitions and uses in the
/// function lie in [lo, hi) (counts ndef / nuse): nothing outside the arm
/// can see it. Never c (the condition) or keep (a vreg read unnamed).
fn ng_sel_locals(mir: &Vec<MInst>, lo: i64, hi: i64, skip: i64, allow: i64, c: i64, keep: i64, ndef: &Vec<i64>, nuse: &Vec<i64>) -> bool {
    var k: i64 = lo;
    while k < hi {
        var m: MInst = mir.get(k);
        if k != skip && m.op != MO_LINE && mi_defines(m.op) {
            var d: i64 = m.r0;
            if d != allow {
                if d == c || d == keep {
                    return false;
                }
                var dn: i64 = 0;
                var un: i64 = 0;
                var j: i64 = lo;
                while j < hi {
                    var mj: MInst = mir.get(j);
                    if mj.op != MO_LINE {
                        if mi_defines(mj.op) && mj.r0 == d {
                            dn = dn + 1;
                        }
                        var um: i64 = mi_use_mask(mj.op);
                        var f: i64 = 0;
                        while f < 3 {
                            if (um & (1 << f)) != 0 && mi_field(mj, f) == d {
                                un = un + 1;
                            }
                            f = f + 1;
                        }
                    }
                    j = j + 1;
                }
                var di: i64 = d - NG_VBASE;
                if di < 0 || di >= ndef.len() || dn != ndef.get(di) || un != nuse.get(di) {
                    return false;
                }
            }
        }
        k = k + 1;
    }
    return true;
}

/// MI24: the arm mir[s_lo .. s_hi) can be the selected one, with
/// mir[b_lo .. b_hi) the other: its last operation (line rows aside)
/// defines x, an integer vreg that is neither the condition nor `keep`;
/// its other operations only define vregs of its own; the other arm only
/// vregs of its own and x. The position of that last operation, or -1.
fn ng_sel_check(mir: &Vec<MInst>, s_lo: i64, s_hi: i64, b_lo: i64, b_hi: i64, c: i64, keep: i64, ndef: &Vec<i64>, nuse: &Vec<i64>, cls: &Vec<i64>) -> i64 {
    var last: i64 = s_hi - 1;
    while last >= s_lo && mir.get(last).op == MO_LINE {
        last = last - 1;
    }
    if last < s_lo {
        return 0 - 1;
    }
    var lm: MInst = mir.get(last);
    if !mi_defines(lm.op) {
        return 0 - 1;
    }
    var x: i64 = lm.r0;
    var xi: i64 = x - NG_VBASE;
    if x == c || x == keep || xi < 0 || xi >= cls.len() || cls.get(xi) != NG_RC_INT {
        return 0 - 1;
    }
    // (a MOV x, x would select x itself, after the other arm changed it)
    if lm.op == MO_MOV && lm.r1 == x {
        return 0 - 1;
    }
    if !ng_sel_locals(mir, s_lo, s_hi, last, 0 - 1, c, keep, ndef, nuse) {
        return 0 - 1;
    }
    if !ng_sel_locals(mir, b_lo, b_hi, 0 - 1, x, c, keep, ndef, nuse) {
        return 0 - 1;
    }
    return last;
}

/// MI24: small branch diamonds become conditional selects, on the MIR
/// before allocation (after the peephole, before branch fusion), on the
/// targets that have one (ng_sel_has MO_CSEL: x86-64 CMOV, AArch64 CSEL,
/// RISC-V Zicond under --cpu rva23u64):
///
///   BEQZ c, Le        (BNEZ: the sense flips)
///   [PLACE Lt]        no other jump reaches it
///   F1 .. Fn          the arm that falls through
///   JMP Lend
///   PLACE Le          no other jump reaches it
///   G1 .. Gm          the arm the branch takes
///   PLACE Lend        (other jumps may join here)
///
/// and the one-armed form `BEQZ c, Lend; F1 .. Fn; PLACE Lend`. Each arm
/// holds at most NG_SEL_ARM_MAX operations besides moves (NG_SEL_ARM_OPS
/// in all), all of them pure
/// (ng_sel_pure). One arm S (the fall-through one if it fits, else the
/// taken one) ends with an operation defining x and otherwise defines only
/// vregs nothing outside it reads or writes; the other arm B defines only
/// such vregs and x. The diamond becomes
///
///   S1 .. Sn-1, Sn writing t (t: a new vreg; a final MOV x, s gives t = s
///   and goes), B1 .. Bm, CSEL x, c, t (i0: 0 picks t when c != 0, 1 when
///   c == 0)
///
/// S runs before B, so both read the x of before the diamond, as they did;
/// B leaves x as its arm did, and the select puts S's value there when S's
/// condition holds. Not in @constant_time functions (the caller): their
/// check judges the branches the source wrote. Returns the number of
/// selects made; rec.nvreg grows by the new vregs. `FID_NAT_OFF=csel`.
fn ng_fuse_select(g: &NatGen, rec: &mut NatFnRec) -> i64 {
    // (MI27: a function with a jump table keeps its blocks as they are)
    if !ng_on("csel") || !ng_sel_has(g, MO_CSEL) || mi_has_jtab(&rec.mir) {
        return 0;
    }
    var nvreg: i64 = rec.nvreg;
    var keep: i64 = rec.sret_v;
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = rec.mir.len();
    if nv <= 0 || n == 0 {
        return 0;
    }
    var any: bool = false;
    var k: i64 = 0;
    while k < n && !any {
        var op0: i64 = rec.mir.get(k).op;
        if op0 == MO_BEQZ || op0 == MO_BNEZ {
            any = true;
        }
        k = k + 1;
    }
    if !any {
        return 0;
    }
    // Branch references per label; definitions and uses per vreg
    var refs: i64 = HashMap_new();
    var ndef: Vec<i64> = Vec::new();
    var nuse: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        ndef.push(0);
        nuse.push(0);
        i = i + 1;
    }
    k = 0;
    while k < n {
        var m: MInst = rec.mir.get(k);
        if m.op >= 0 && m.op != MO_LINE {
            // (an address taken of a label counts as a jump to it)
            if mi_is_br(m.op) || m.op == MO_ADDR {
                var key: str = int_to_str(m.i0);
                var cnt: i64 = 0;
                if HashMap_contains(refs, key) {
                    cnt = HashMap_get(refs, key);
                }
                HashMap_insert(refs, key, cnt + 1);
            }
            var um: i64 = mi_use_mask(m.op);
            var f: i64 = 0;
            while f < 3 {
                var v: i64 = mi_field(m, f);
                if (um & (1 << f)) != 0 && v >= NG_VBASE && v < nvreg {
                    nuse.set(v - NG_VBASE, nuse.get(v - NG_VBASE) + 1);
                }
                f = f + 1;
            }
            if mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 < nvreg {
                ndef.set(m.r0 - NG_VBASE, ndef.get(m.r0 - NG_VBASE) + 1);
            }
        }
        k = k + 1;
    }
    var cls: Vec<i64> = ng_mir_classes(g, &rec.mir, nv);
    var out: Vec<MInst> = Vec::new();
    var made: i64 = 0;
    var next_v: i64 = nvreg;
    k = 0;
    while k < n {
        var m2: MInst = rec.mir.get(k);
        var end_at: i64 = 0 - 1;
        if (m2.op == MO_BEQZ || m2.op == MO_BNEZ) && m2.r0 >= NG_VBASE && m2.r0 < nvreg && m2.r0 != keep {
            var c: i64 = m2.r0;
            var target: i64 = m2.i0;
            var tkey: str = int_to_str(target);
            var j: i64 = k + 1;
            var lt_ok: bool = true;
            if j < n && rec.mir.get(j).op == MO_PLACE && rec.mir.get(j).i0 != target {
                // the fall-through arm's own label: nothing else may jump in
                if HashMap_contains(refs, int_to_str(rec.mir.get(j).i0)) {
                    lt_ok = false;
                }
                j = j + 1;
            }
            var f_lo: i64 = j;
            var f_hi: i64 = j;
            var fcount: i64 = 0;
            var fall: i64 = 0;
            var walking: bool = true;
            while walking && f_hi < n {
                var mf: MInst = rec.mir.get(f_hi);
                if mf.op == MO_LINE {
                    f_hi = f_hi + 1;
                } else if ng_sel_pure(mf, nvreg) && fall < NG_SEL_ARM_OPS {
                    if mf.op != MO_MOV {
                        fcount = fcount + 1;
                    }
                    fall = fall + 1;
                    f_hi = f_hi + 1;
                } else {
                    walking = false;
                }
            }
            var g_lo: i64 = f_hi;
            var g_hi: i64 = f_hi;
            var gcount: i64 = 0;
            var gall: i64 = 0;
            var two: bool = false;
            var shape: bool = false;
            if lt_ok && fall >= 1 && fcount <= NG_SEL_ARM_MAX && f_hi < n {
                var mt: MInst = rec.mir.get(f_hi);
                if mt.op == MO_PLACE && mt.i0 == target {
                    // one arm: the branch jumps over it to the join
                    end_at = f_hi;
                    shape = true;
                } else if mt.op == MO_JMP && mt.i0 != target && f_hi + 1 < n && rec.mir.get(f_hi + 1).op == MO_PLACE && rec.mir.get(f_hi + 1).i0 == target && HashMap_get(refs, tkey) == 1 {
                    var lend: i64 = mt.i0;
                    g_lo = f_hi + 2;
                    g_hi = g_lo;
                    walking = true;
                    while walking && g_hi < n {
                        var mg: MInst = rec.mir.get(g_hi);
                        if mg.op == MO_LINE {
                            g_hi = g_hi + 1;
                        } else if ng_sel_pure(mg, nvreg) && gall < NG_SEL_ARM_OPS {
                            if mg.op != MO_MOV {
                                gcount = gcount + 1;
                            }
                            gall = gall + 1;
                            g_hi = g_hi + 1;
                        } else {
                            walking = false;
                        }
                    }
                    if gcount <= NG_SEL_ARM_MAX && g_hi < n && rec.mir.get(g_hi).op == MO_PLACE && rec.mir.get(g_hi).i0 == lend {
                        end_at = g_hi;
                        two = true;
                        shape = true;
                    }
                }
            }
            // the arm that is selected (s), the one that always runs (b)
            var s_lo: i64 = f_lo;
            var s_hi: i64 = f_hi;
            var b_lo: i64 = g_lo;
            var b_hi: i64 = g_hi;
            var inv: i64 = 0;
            if m2.op == MO_BNEZ {
                inv = 1;
            }
            var last: i64 = 0 - 1;
            if shape {
                last = ng_sel_check(&rec.mir, s_lo, s_hi, b_lo, b_hi, c, keep, &ndef, &nuse, &cls);
                if last < 0 && two && gall >= 1 {
                    s_lo = g_lo;
                    s_hi = g_hi;
                    b_lo = f_lo;
                    b_hi = f_hi;
                    inv = 1 - inv;
                    last = ng_sel_check(&rec.mir, s_lo, s_hi, b_lo, b_hi, c, keep, &ndef, &nuse, &cls);
                }
            }
            if last >= 0 {
                var lm: MInst = rec.mir.get(last);
                var x: i64 = lm.r0;
                var t: i64 = 0;
                var q: i64 = s_lo;
                while q < s_hi {
                    if q != last {
                        out.push(rec.mir.get(q));
                    }
                    q = q + 1;
                }
                if lm.op == MO_MOV {
                    t = lm.r1;
                } else {
                    t = next_v;
                    next_v = next_v + 1;
                    out.push(MInst {
                        op: lm.op, r0: t, r1: lm.r1, r2: lm.r2, i0: lm.i0, i1: lm.i1, i2: lm.i2
                    });
                }
                q = b_lo;
                while q < b_hi {
                    out.push(rec.mir.get(q));
                    q = q + 1;
                }
                out.push(MInst {
                    op: MO_CSEL, r0: x, r1: c, r2: t, i0: inv, i1: 0, i2: 0
                });
                made = made + 1;
                // the join label stays: the next round of the loop keeps it
                k = end_at;
            } else {
                end_at = 0 - 1;
            }
        }
        if end_at < 0 {
            out.push(m2);
            k = k + 1;
        }
    }
    if made == 0 {
        return 0;
    }
    rec.mir = out;
    rec.nvreg = next_v;
    return made;
}

/// MI3/OP20: bit operations the target has as one instruction, selected
/// on the MIR before allocation (ng_sel_has says which the target has):
///   AND d, x, y  where x comes from NOT s            ->  ANDN d, s, y
///   AND d, x, y  where x comes from SUB a, c (c = LI 1) or ADD a, c
///                (c = LI -1), and y holds a's value   ->  BLSR d, y
/// (either operand order; x through vreg MOVs only, with only MOV, LI and
/// line rows between the definition and the AND: one stretch of straight
/// code). The NOT / SUB and the MOVs that carried its value go, so only
/// when nothing else reads what they define (ng_fb_deletable); s must not
/// be written in between; y must not be one of the values that go. MOVs
/// and LIs left without a reader go too. Returns the number selected.
/// TG7, the other two BMI1 forms (MO_BLSR's kind i0):
///   XOR d, x, y  where x comes from a - 1 as above, y a's value
///                                                    ->  BLSR kind 1 (BLSMSK)
///   AND d, x, y  where x comes from NEG a or SUB c, a (c = LI 0), y a's
///                value                               ->  BLSR kind 2 (BLSI)
/// `FID_NAT_OFF=andn` / `blsr` / `blsmsk` / `blsi`: never that one;
/// FID_NAT_MUTATE=blsx selects the wrong kind. `keep`: a vreg read
/// without naming it (the hidden result pointer), never removed.
fn ng_fuse_bits(g: &NatGen, mir: &mut Vec<MInst>, nvreg: i64, keep: i64) -> i64 {
    var andn_on: bool = ng_sel_has(g, MO_ANDN) && ng_on("andn");
    var blsr_on: bool = ng_sel_has(g, MO_BLSR) && ng_on("blsr");
    var blsmsk_on: bool = ng_sel_has(g, MO_BLSR) && ng_on("blsmsk");
    var blsi_on: bool = ng_sel_has(g, MO_BLSR) && ng_on("blsi");
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if (!andn_on && !blsr_on && !blsmsk_on && !blsi_on) || nv <= 0 || n == 0 {
        return 0;
    }
    var uses: Vec<i64> = ng_fb_uses(mir, nv);
    var touched: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        touched.push(0);
        i = i + 1;
    }
    var fused: i64 = 0;
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        var side: i64 = 0;
        while (m.op == MO_AND || m.op == MO_XOR) && side < 2 {
            var x: i64 = m.r1;
            var o: i64 = m.r2;
            if side == 1 {
                x = m.r2;
                o = m.r1;
            }
            var dpos: Vec<i64> = Vec::new();
            var p: i64 = 0 - 1;
            if x >= NG_VBASE && x < nvreg && x != o {
                p = ng_fb_chain(mir, k, x, &mut dpos);
            }
            var repl: i64 = 0;
            var src: i64 = 0;
            var bkind: i64 = 0;
            if p >= 0 {
                var r: MInst = mir.get(p);
                dpos.push(p);
                if andn_on && m.op == MO_AND && r.op == MO_NOT {
                    if ng_fb_deletable(mir, &uses, &dpos, k, nv) && !ng_fb_defines_any(mir, &dpos, o) && !ng_fb_redef(mir, &dpos, p, k, r.r1) {
                        repl = 1;
                        src = r.r1;
                    }
                } else if r.op == MO_SUB || r.op == MO_ADD || r.op == MO_NEG {
                    // a - 1 (kind 0 under AND, 1 under XOR) or -a (kind 2,
                    // under AND only)
                    var a: i64 = r.r1;
                    var kind: i64 = 0 - 1;
                    if r.op == MO_NEG {
                        kind = 2;
                    } else if r.op == MO_SUB && ng_fb_is_li(mir, p, r.r2, 1) {
                        kind = 0;
                    } else if r.op == MO_SUB && ng_fb_is_li(mir, p, r.r1, 0) {
                        kind = 2;
                        a = r.r2;
                    } else if r.op == MO_ADD && ng_fb_is_li(mir, p, r.r2, 0 - 1) {
                        kind = 0;
                    } else if r.op == MO_ADD && ng_fb_is_li(mir, p, r.r1, 0 - 1) {
                        kind = 0;
                        a = r.r2;
                    }
                    if kind == 0 && m.op == MO_XOR {
                        kind = 1;
                    } else if kind == 2 && m.op != MO_AND {
                        kind = 0 - 1;
                    }
                    var kon: bool = (kind == 0 && blsr_on) || (kind == 1 && blsmsk_on) || (kind == 2 && blsi_on);
                    if kon && ng_fb_same(mir, p, a, k, o) && ng_fb_deletable(mir, &uses, &dpos, k, nv) && !ng_fb_defines_any(mir, &dpos, o) {
                        repl = 2;
                        bkind = kind;
                        if ng_mutant("blsx") {
                            // TG2: the wrong one of the three, on purpose
                            bkind = (kind + 1) % 3;
                        }
                    }
                }
            }
            if repl != 0 {
                var nd: i64 = 0;
                while nd < dpos.len() {
                    ng_fb_touch(&mut touched, mir.get(dpos.get(nd)), nv);
                    mir.set(dpos.get(nd), mi_nop());
                    nd = nd + 1;
                }
                ng_fb_touch(&mut touched, m, nv);
                if repl == 1 && ng_mutant("andn") {
                    // TG2: the operands swapped, on purpose
                    mir.set(k, MInst {
                        op: MO_ANDN, r0: m.r0, r1: o, r2: src, i0: 0, i1: 0, i2: 0
                    });
                } else if repl == 1 {
                    mir.set(k, MInst {
                        op: MO_ANDN, r0: m.r0, r1: src, r2: o, i0: 0, i1: 0, i2: 0
                    });
                } else {
                    mir.set(k, MInst {
                        op: MO_BLSR, r0: m.r0, r1: o, r2: 0, i0: bkind, i1: 0, i2: 0
                    });
                }
                uses = ng_fb_uses(mir, nv);
                fused = fused + 1;
                side = 2;
            } else {
                side = side + 1;
            }
        }
        k = k + 1;
    }
    if fused == 0 {
        return 0;
    }
    // Copies and constants nothing reads any more (they fed what went)
    var again: bool = true;
    var rounds: i64 = 0;
    while again && rounds < 8 {
        again = false;
        uses = ng_fb_uses(mir, nv);
        var q: i64 = 0;
        while q < n {
            var mq: MInst = mir.get(q);
            if (mq.op == MO_MOV || mq.op == MO_LI) && mq.r0 >= NG_VBASE && mq.r0 < nvreg && mq.r0 != keep {
                var vi: i64 = mq.r0 - NG_VBASE;
                if touched.get(vi) != 0 && uses.get(vi) == 0 {
                    ng_fb_touch(&mut touched, mq, nv);
                    mir.set(q, mi_nop());
                    again = true;
                }
            }
            q = q + 1;
        }
        rounds = rounds + 1;
    }
    var out: Vec<MInst> = Vec::new();
    var t: i64 = 0;
    while t < mir.len() {
        if mir.get(t).op >= 0 {
            out.push(mir.get(t));
        }
        t = t + 1;
    }
    mir.clear();
    t = 0;
    while t < out.len() {
        mir.push(out.get(t));
        t = t + 1;
    }
    return fused;
}

/// MI22: the element address folded into the access that uses it. A
/// LOAD (or STORE) whose address register comes, through MOVs
/// (ng_fb_chain: straight-line code of one block), from an MO_ADDSHL
/// becomes one MO_LDX (MO_STX) of the ADDSHL's base and index where the
/// target has that form (ng_ldx_form_ok), when: base, index (and a
/// store's value) are vregs; nothing else between the ADDSHL and the
/// access reads what the ADDSHL and the MOVs define, or writes the base
/// or the index; what they define is dead after the access (block
/// liveness, ng_fa_dead_after); a store does not store one of them; none
/// is `keep` (the hidden result pointer). The ADDSHL and the MOVs go.
/// The same for a constant offset (every target): an address that is an
/// ADD of a register and a constant (a field address, GetFieldPtr's LI +
/// ADD) becomes the access's displacement when the sum fits the target's
/// form (ng_disp_fits); the LI goes too once nothing reads it. Both may
/// apply to one access (x86-64: [base + index * 8 + disp]).
/// Folds never overlap: each starts after the last access folded before
/// (the folds of one access stay inside its own stretch), so the
/// liveness of the unchanged MIR stays true for every later one.
/// Returns the number folded. `FID_NAT_OFF=ldx`: never.
fn ng_fuse_addr(g: &NatGen, mir: &mut Vec<MInst>, nvreg: i64, keep: i64) -> i64 {
    if !ng_on("ldx") {
        return 0;
    }
    var idx_on: bool = ng_sel_has(g, MO_LDX);
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if nv <= 0 || n == 0 {
        return 0;
    }
    // The registers the candidate chains define get a liveness bit each
    var sel: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        sel.push(0 - 1);
        i = i + 1;
    }
    var nsel: i64 = 0;
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        var x: i64 = ng_fa_addr_reg(m);
        if x >= NG_VBASE && x < nvreg {
            var dpos: Vec<i64> = Vec::new();
            var p: i64 = ng_fb_chain(mir, k, x, &mut dpos);
            if p >= 0 && ((idx_on && mir.get(p).op == MO_ADDSHL) || ng_fa_add_const(mir, p) > 0) {
                dpos.push(p);
                var cf: i64 = ng_fa_add_const(mir, p);
                if idx_on && cf > 0 {
                    // the register part of base + constant may be an
                    // element address in turn (both folds on one access)
                    var ob: i64 = mi_field(mir.get(p), 3 - cf);
                    if ob >= NG_VBASE && ob < nvreg {
                        var p3: i64 = ng_fb_chain(mir, p, ob, &mut dpos);
                        if p3 >= 0 && mir.get(p3).op == MO_ADDSHL {
                            dpos.push(p3);
                        }
                    }
                }
                var j: i64 = 0;
                while j < dpos.len() {
                    var r: i64 = mir.get(dpos.get(j)).r0;
                    if r >= NG_VBASE && r < nvreg && sel.get(r - NG_VBASE) < 0 {
                        sel.set(r - NG_VBASE, nsel);
                        nsel = nsel + 1;
                    }
                    j = j + 1;
                }
            }
        }
        k = k + 1;
    }
    if nsel == 0 {
        return 0;
    }
    var words: i64 = (nsel + 63) / 64;
    var mb: MBlocks = mi_blocks(mir);
    var live_in: Vec<i64> = Vec::new();
    var live_out: Vec<i64> = Vec::new();
    mi_liveness(mir, &mb, &sel, words, &mut live_in, &mut live_out);
    var fused: i64 = 0;
    var last_k: i64 = 0 - 1;
    // the constant registers of folded ADDs (their LIs go once unread)
    var touched: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        touched.push(0);
        i = i + 1;
    }
    k = 0;
    while k < n {
        // every fold of this access starts after the last access folded
        // before it
        var bound: i64 = last_k;
        var tries: i64 = 0;
        while tries < 2 {
            tries = tries + 1;
            var m2: MInst = mir.get(k);
            var x2: i64 = ng_fa_addr_reg(m2);
            var kind: i64 = 0;
            var dpos2: Vec<i64> = Vec::new();
            var p2: i64 = 0 - 1;
            if x2 >= NG_VBASE && x2 < nvreg {
                p2 = ng_fb_chain(mir, k, x2, &mut dpos2);
            }
            var cf2: i64 = 0 - 1;
            if p2 > bound {
                if idx_on && mir.get(p2).op == MO_ADDSHL {
                    kind = 1;
                } else {
                    cf2 = ng_fa_add_const(mir, p2);
                    if cf2 > 0 {
                        kind = 2;
                    }
                }
            }
            if kind == 0 {
                tries = 2;
            } else {
                var a: MInst = mir.get(p2);
                dpos2.push(p2);
                var ok: bool = true;
                // the registers the access reads instead of the address
                var b1: i64 = a.r1;
                var b2: i64 = a.r2;
                var nd: i64 = m2.i0;
                if kind == 1 {
                    ok = ng_ldx_form_ok(g, a.i0, m2.i0, m2.i1);
                } else {
                    b1 = mi_field(a, 3 - cf2);
                    b2 = b1;
                    nd = m2.i0 + ng_fa_const_val(mir, p2, cf2);
                    ok = ng_disp_fits(g, m2.i1, nd);
                }
                ok = ok && b1 >= NG_VBASE && b1 < nvreg && b2 >= NG_VBASE && b2 < nvreg;
                if ok && m2.op == MO_STORE {
                    ok = m2.r1 >= NG_VBASE && m2.r1 < nvreg && !ng_fb_defines_any(mir, &dpos2, m2.r1);
                }
                ok = ok && !ng_fb_defines_any(mir, &dpos2, keep);
                ok = ok && !ng_fb_redef(mir, &dpos2, p2, k, b1) && !ng_fb_redef(mir, &dpos2, p2, k, b2);
                if ok {
                    ok = ng_fa_quiet(mir, &dpos2, p2, k);
                }
                var j2: i64 = 0;
                while ok && j2 < dpos2.len() {
                    var rd: i64 = mir.get(dpos2.get(j2)).r0;
                    if rd < NG_VBASE || rd >= nvreg || !ng_fa_dead_after(mir, &mb, &sel, words, &live_out, k, rd) {
                        ok = false;
                    }
                    j2 = j2 + 1;
                }
                if ok {
                    var d2: i64 = 0;
                    while d2 < dpos2.len() {
                        mir.set(dpos2.get(d2), mi_nop());
                        d2 = d2 + 1;
                    }
                    if kind == 2 {
                        var cr: i64 = mi_field(a, cf2);
                        if cr >= NG_VBASE && cr < nvreg {
                            touched.set(cr - NG_VBASE, 1);
                        }
                        if m2.op == MO_LOAD {
                            mir.set(k, MInst {
                                op: MO_LOAD, r0: m2.r0, r1: b1, r2: 0, i0: nd, i1: m2.i1, i2: m2.i2
                            });
                        } else {
                            mir.set(k, MInst {
                                op: MO_STORE, r0: b1, r1: m2.r1, r2: 0, i0: nd, i1: m2.i1, i2: m2.i2
                            });
                        }
                    } else if m2.op == MO_LOAD {
                        mir.set(k, MInst {
                            op: MO_LDX, r0: m2.r0, r1: a.r1, r2: a.r2, i0: m2.i0, i1: m2.i1, i2: (a.i0 << 1) | (m2.i2 & 1)
                        });
                    } else {
                        mir.set(k, MInst {
                            op: MO_STX, r0: a.r1, r1: m2.r1, r2: a.r2, i0: m2.i0, i1: m2.i1, i2: a.i0 << 1
                        });
                    }
                    last_k = k;
                    fused = fused + 1;
                } else {
                    tries = 2;
                }
            }
        }
        k = k + 1;
    }
    if fused == 0 {
        return 0;
    }
    // LIs and copies of the folded constants that nothing reads any more
    var again: bool = true;
    var rounds: i64 = 0;
    while again && rounds < 4 {
        again = false;
        var uses: Vec<i64> = ng_fb_uses(mir, nv);
        var q: i64 = 0;
        while q < n {
            var mq: MInst = mir.get(q);
            if (mq.op == MO_LI || mq.op == MO_MOV) && mq.r0 >= NG_VBASE && mq.r0 < nvreg && mq.r0 != keep {
                var vq: i64 = mq.r0 - NG_VBASE;
                if touched.get(vq) != 0 && uses.get(vq) == 0 {
                    if mq.op == MO_MOV && mq.r1 >= NG_VBASE && mq.r1 < nvreg {
                        touched.set(mq.r1 - NG_VBASE, 1);
                    }
                    mir.set(q, mi_nop());
                    again = true;
                }
            }
            q = q + 1;
        }
        rounds = rounds + 1;
    }
    var out: Vec<MInst> = Vec::new();
    var t: i64 = 0;
    while t < mir.len() {
        if mir.get(t).op >= 0 {
            out.push(mir.get(t));
        }
        t = t + 1;
    }
    mir.clear();
    t = 0;
    while t < out.len() {
        mir.push(out.get(t));
        t = t + 1;
    }
    return fused;
}

/// MI22: the operand field (1 or 2) of the MO_ADD at p whose value is a
/// constant (an LI, through copies, in the same stretch: ng_fb_root), the
/// other operand a different register; -1 when it is not such an ADD.
fn ng_fa_add_const(mir: &Vec<MInst>, p: i64) -> i64 {
    var m: MInst = mir.get(p);
    if m.op != MO_ADD || m.r1 == m.r2 {
        return 0 - 1;
    }
    var f: i64 = 2;
    while f >= 1 {
        var rt: Vec<i64> = ng_fb_root(mir, p, mi_field(m, f));
        if rt.get(0) >= 0 && rt.get(1) >= 0 && mir.get(rt.get(1)).op == MO_LI {
            return f;
        }
        f = f - 1;
    }
    return 0 - 1;
}

/// The constant operand field f of the ADD at p holds (ng_fa_add_const).
fn ng_fa_const_val(mir: &Vec<MInst>, p: i64, f: i64) -> i64 {
    var rt: Vec<i64> = ng_fb_root(mir, p, mi_field(mir.get(p), f));
    return mir.get(rt.get(1)).i0;
}

/// MI22: displacement d is part of one access of `size` bytes here:
/// x86-64 a signed 32-bit displacement, AArch64 the unsigned scaled
/// 12-bit offset (a64_ldst_fits), RISC-V a signed 12-bit one. (ng_load and
/// ng_store take any displacement; this says when folding one saves code.)
fn ng_disp_fits(g: &NatGen, size: i64, d: i64) -> bool {
    if ng_x64(g) {
        return d >= 0 - 2147483647 && d <= 2147483647;
    }
    if ng_a64(g) {
        return a64_ldst_fits(size, d);
    }
    return rv_fits12(d);
}

/// The address register of a LOAD or STORE (-1: neither).
fn ng_fa_addr_reg(m: MInst) -> i64 {
    if m.op == MO_LOAD {
        return m.r1;
    }
    if m.op == MO_STORE {
        return m.r0;
    }
    return 0 - 1;
}

/// No instruction strictly between p and k other than those at dpos reads
/// a register that one at dpos defines.
fn ng_fa_quiet(mir: &Vec<MInst>, dpos: &Vec<i64>, p: i64, k: i64) -> bool {
    var q: i64 = p + 1;
    while q < k {
        var inside: bool = false;
        var j: i64 = 0;
        while j < dpos.len() {
            if dpos.get(j) == q {
                inside = true;
            }
            j = j + 1;
        }
        if !inside {
            var m: MInst = mir.get(q);
            var j2: i64 = 0;
            while j2 < dpos.len() {
                if ng_fb_count(m, mir.get(dpos.get(j2)).r0) > 0 {
                    return false;
                }
                j2 = j2 + 1;
            }
        }
        q = q + 1;
    }
    return true;
}

/// Vreg r holds nothing read after the instruction at k: written by k
/// itself, or, walking on through k's block, written before any read, or
/// not live out of the block (`live_out` of mi_liveness over `sel`).
fn ng_fa_dead_after(mir: &Vec<MInst>, mb: &MBlocks, sel: &Vec<i64>, words: i64, live_out: &Vec<i64>, k: i64, r: i64) -> bool {
    var mk: MInst = mir.get(k);
    if mi_defines(mk.op) && mk.r0 == r {
        return true;
    }
    var b: i64 = mb.of.get(k);
    var q: i64 = k + 1;
    while q <= mb.end.get(b) {
        var m: MInst = mir.get(q);
        if m.op >= 0 {
            if ng_fb_count(m, r) > 0 {
                return false;
            }
            if mi_defines(m.op) && m.r0 == r {
                return true;
            }
        }
        q = q + 1;
    }
    var bit: i64 = sel.get(r - NG_VBASE);
    if bit < 0 {
        return false;
    }
    return (live_out.get(b * words + bit / 64) & (1 << (bit % 64))) == 0;
}

/// Reads of each vreg over the function (per operand field read).
fn ng_fb_uses(mir: &Vec<MInst>, nv: i64) -> Vec<i64> {
    var uses: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        uses.push(0);
        i = i + 1;
    }
    var k: i64 = 0;
    while k < mir.len() {
        var m: MInst = mir.get(k);
        if m.op >= 0 {
            var um: i64 = mi_use_mask(m.op);
            var f: i64 = 0;
            while f < 3 {
                var v: i64 = mi_field(m, f) - NG_VBASE;
                if (um & (1 << f)) != 0 && v >= 0 && v < nv {
                    uses.set(v, uses.get(v) + 1);
                }
                f = f + 1;
            }
        }
        k = k + 1;
    }
    return uses;
}

/// How many operand fields of m read r.
fn ng_fb_count(m: MInst, r: i64) -> i64 {
    if m.op < 0 {
        return 0;
    }
    var um: i64 = mi_use_mask(m.op);
    var c: i64 = 0;
    var f: i64 = 0;
    while f < 3 {
        if (um & (1 << f)) != 0 && mi_field(m, f) == r {
            c = c + 1;
        }
        f = f + 1;
    }
    return c;
}

fn ng_fb_touch(touched: &mut Vec<i64>, m: MInst, nv: i64) {
    if m.op < 0 {
        return;
    }
    var um: i64 = mi_use_mask(m.op);
    var f: i64 = 0;
    while f < 3 {
        var v: i64 = mi_field(m, f) - NG_VBASE;
        if (um & (1 << f)) != 0 && v >= 0 && v < nv {
            touched.set(v, 1);
        }
        f = f + 1;
    }
}

/// Not straight-line code inside one block: a label, a block end, a call.
fn ng_fb_stop(op: i64) -> bool {
    return op == MO_PLACE || mi_ends_block(op) || mi_is_call(op);
}

/// The MOVs (vreg to vreg) that bring the value the operation at k reads
/// in x from its definition, walking back: their positions go to dpos;
/// the definition's position, or -1 when anything but MOV, LI or a line
/// row comes first.
fn ng_fb_chain(mir: &Vec<MInst>, k: i64, x: i64, dpos: &mut Vec<i64>) -> i64 {
    var cur: i64 = x;
    var p: i64 = k - 1;
    while p >= 0 {
        var m: MInst = mir.get(p);
        if m.op < 0 || m.op == MO_LINE {
            p = p - 1;
        } else if mi_defines(m.op) && m.r0 == cur {
            if m.op == MO_MOV && m.r1 >= NG_VBASE {
                dpos.push(p);
                cur = m.r1;
                p = p - 1;
            } else {
                return p;
            }
        } else if m.op == MO_MOV || m.op == MO_LI {
            p = p - 1;
        } else {
            return 0 - 1;
        }
    }
    return 0 - 1;
}

/// Deleting the instructions at dpos (k, which reads the last value, is
/// replaced) changes nothing else: every register they define is a vreg
/// that only they and k read.
fn ng_fb_deletable(mir: &Vec<MInst>, uses: &Vec<i64>, dpos: &Vec<i64>, k: i64, nv: i64) -> bool {
    var j: i64 = 0;
    while j < dpos.len() {
        var r: i64 = mir.get(dpos.get(j)).r0;
        if r < NG_VBASE || r - NG_VBASE >= nv {
            return false;
        }
        var inside: i64 = ng_fb_count(mir.get(k), r);
        var q: i64 = 0;
        while q < dpos.len() {
            inside = inside + ng_fb_count(mir.get(dpos.get(q)), r);
            q = q + 1;
        }
        if uses.get(r - NG_VBASE) != inside {
            return false;
        }
        j = j + 1;
    }
    return true;
}

/// OP18: ng_fb_deletable when the operation at k writes d (-1: nothing)
/// and so does what replaces it. A definition of d at dpos is then dead
/// past k (the code from it to k is straight, k writes d again), so only
/// the reads of d between it and k count, and each must be at dpos: the
/// two-address forms (`MOV d, t; EXT d, d`, `MOV d, t; ADD d, d, x`)
/// whose d also carries the loaded value. Other registers as
/// ng_fb_deletable (only dpos and k read them).
fn ng_fb_deletable_def(mir: &Vec<MInst>, uses: &Vec<i64>, dpos: &Vec<i64>, k: i64, nv: i64, d: i64) -> bool {
    var j: i64 = 0;
    while j < dpos.len() {
        var q: i64 = dpos.get(j);
        var r: i64 = mir.get(q).r0;
        if r < NG_VBASE || r - NG_VBASE >= nv {
            return false;
        }
        if r == d && q < k {
            var x: i64 = q + 1;
            while x < k {
                if ng_fb_count(mir.get(x), r) > 0 {
                    var at: bool = false;
                    var t: i64 = 0;
                    while t < dpos.len() {
                        if dpos.get(t) == x {
                            at = true;
                        }
                        t = t + 1;
                    }
                    if !at {
                        return false;
                    }
                }
                x = x + 1;
            }
        } else {
            var inside: i64 = ng_fb_count(mir.get(k), r);
            var t2: i64 = 0;
            while t2 < dpos.len() {
                inside = inside + ng_fb_count(mir.get(dpos.get(t2)), r);
                t2 = t2 + 1;
            }
            if uses.get(r - NG_VBASE) != inside {
                return false;
            }
        }
        j = j + 1;
    }
    return true;
}

fn ng_fb_defines_any(mir: &Vec<MInst>, dpos: &Vec<i64>, v: i64) -> bool {
    var j: i64 = 0;
    while j < dpos.len() {
        if mir.get(dpos.get(j)).r0 == v {
            return true;
        }
        j = j + 1;
    }
    return false;
}

/// ng_fb_defines_any with one position of dpos left out: the read-modify-
/// write's own operation (its position is in the deleted set) may be the
/// two-address destination `and d, d, x` — deleted, it defines nothing.
fn ng_fb_defines_any_but(mir: &Vec<MInst>, dpos: &Vec<i64>, v: i64, skip: i64) -> bool {
    var j: i64 = 0;
    while j < dpos.len() {
        if dpos.get(j) != skip && mir.get(dpos.get(j)).r0 == v {
            return true;
        }
        j = j + 1;
    }
    return false;
}

/// An instruction strictly between p and k, other than those at dpos,
/// writes v.
fn ng_fb_redef(mir: &Vec<MInst>, dpos: &Vec<i64>, p: i64, k: i64, v: i64) -> bool {
    var q: i64 = p + 1;
    while q < k {
        var m: MInst = mir.get(q);
        if m.op >= 0 && mi_defines(m.op) && m.r0 == v {
            var inside: bool = false;
            var j: i64 = 0;
            while j < dpos.len() {
                if dpos.get(j) == q {
                    inside = true;
                }
                j = j + 1;
            }
            if !inside {
                return true;
            }
        }
        q = q + 1;
    }
    return false;
}

/// Where v's value at `pos` comes from, through vreg copies: [vreg,
/// position of its definition], or [vreg, -2 - stop] when no definition
/// comes before the stretch's start (`stop`: the label, block end or call
/// there, -1 the function's start); [-1, -1] when the walk gives up.
fn ng_fb_root(mir: &Vec<MInst>, pos: i64, v: i64) -> Vec<i64> {
    var res: Vec<i64> = Vec::new();
    var cur: i64 = v;
    var at: i64 = pos;
    var steps: i64 = 0;
    while steps < 64 {
        var p: i64 = at - 1;
        var found: i64 = 0 - 1;
        var stop: i64 = 0 - 1;
        var walking: bool = true;
        while walking && p >= 0 {
            var m: MInst = mir.get(p);
            if m.op >= 0 && ng_fb_stop(m.op) {
                stop = p;
                walking = false;
            } else if m.op >= 0 && mi_defines(m.op) && m.r0 == cur {
                found = p;
                walking = false;
            } else {
                p = p - 1;
            }
        }
        if found < 0 {
            res.push(cur);
            res.push(0 - 2 - stop);
            return res;
        }
        var md: MInst = mir.get(found);
        if md.op == MO_MOV && md.r1 >= NG_VBASE {
            cur = md.r1;
            at = found;
            steps = steps + 1;
        } else {
            res.push(cur);
            res.push(found);
            return res;
        }
    }
    res.push(0 - 1);
    res.push(0 - 1);
    return res;
}

/// v at p1 and w at p2 hold the same value (one definition, through copies).
fn ng_fb_same(mir: &Vec<MInst>, p1: i64, v: i64, p2: i64, w: i64) -> bool {
    var a: Vec<i64> = ng_fb_root(mir, p1, v);
    var b: Vec<i64> = ng_fb_root(mir, p2, w);
    return a.get(0) >= 0 && a.get(0) == b.get(0) && a.get(1) == b.get(1);
}

/// v at p holds the constant want: its definition (through copies, in the
/// same stretch) is LI want.
fn ng_fb_is_li(mir: &Vec<MInst>, p: i64, v: i64, want: i64) -> bool {
    var rt: Vec<i64> = ng_fb_root(mir, p, v);
    if rt.get(0) < 0 || rt.get(1) < 0 {
        return false;
    }
    var m: MInst = mir.get(rt.get(1));
    return m.op == MO_LI && m.i0 == want;
}

// (MI1: mi_ends_block and mi_field are in compiler/mir.fd.)

/// The registers values may be allocated to: caller-saved (lost at a call
/// that clobbers them) and callee-saved. The argument registers, sp, fp,
/// lr, the platform register and the scratch registers the operations use
/// themselves (ad, ad2, the copy cursor, the three spill registers) are
/// never allocated.
fn ng_pool_caller(g: &NatGen) -> Vec<i64> {
    // MI4: the integer class's caller-saved pool of the target description
    return ng_class_pool(g, NG_RC_INT, false);
}

fn ng_is_callee_saved(g: &NatGen, r: i64) -> bool {
    if r < 0 || r >= 64 {
        return false;
    }
    return (g.td.int_callee_mask & (1 << r)) != 0;
}

/// The spill scratch registers: two for uses, one for the definition.
fn ng_spill_reg(g: &NatGen, k: i64) -> i64 {
    if k == 0 {
        return g.td.spill_use0;
    }
    if k == 1 {
        return g.td.spill_use1;
    }
    return g.td.spill_def;
}

/// Every pool register a call may clobber (an unknown callee).
fn ng_full_mask(g: &NatGen) -> i64 {
    var m: i64 = 0;
    var p: Vec<i64> = ng_pool_caller(g);
    var i: i64 = 0;
    while i < p.len() {
        m = m | (1 << p.get(i));
        i = i + 1;
    }
    return m;
}

// --- Promotion of locals (roadmap ME3 in the backend) -------------------

/// The scalar locals of `func` whose address is only loaded from and stored
/// to, with the local's own type: they become vregs (their Alloca emits
/// nothing). 1 per promoted id.
fn ng_promotable(g: &NatGen, func: &IrFunction, module: &IrModule, n: i64) -> Vec<i64> {
    var cand: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        cand.push(0);
        i = i + 1;
    }
    if !ng_on("promote") {
        return cand;
    }
    var atys: Vec<IrType> = Vec::new();
    i = 0;
    while i < n {
        atys.push(IrType::I64);
        i = i + 1;
    }
    i = 0;
    while i < func.insts.len() {
        var ve: ValueIdInst = func.insts.get(i);
        match ve.inst {
            Inst::Alloca(aty, _) => {
                var ok: bool = false;
                match aty {
                    IrType::Struct(_) => {
                    }
                    IrType::Array(_, _) => {
                    }
                    IrType::Void => {
                    }
                    _ => {
                        ok = IrModule_type_size(module, aty) <= 8;
                    }
                }
                if ok && ve.id >= 0 && ve.id < n {
                    cand.set(ve.id, 1);
                    atys.set(ve.id, aty);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    var ops: Vec<i64> = Vec::new();
    i = 0;
    while i < func.insts.len() {
        var ve2: ValueIdInst = func.insts.get(i);
        var keep_ptr: i64 = 0 - 1;
        match ve2.inst {
            Inst::Load(p, lty) => {
                if p >= 0 && p < n && cand.get(p) != 0 && !ir_type_eq(lty, atys.get(p)) {
                    cand.set(p, 0);
                }
                keep_ptr = p;
            }
            Inst::Store(p2, v2, ety) => {
                if p2 >= 0 && p2 < n && cand.get(p2) != 0 {
                    var sty: IrType = atys.get(p2);
                    var same: bool = true;
                    match ety {
                        OptIrType::Some(t) => {
                            same = ir_type_eq(t, sty);
                        }
                        OptIrType::None => {
                        }
                    }
                    if !same {
                        cand.set(p2, 0);
                    }
                }
                keep_ptr = p2;
                if v2 >= 0 && v2 < n && cand.get(v2) != 0 {
                    cand.set(v2, 0);
                }
            }
            _ => {
            }
        }
        if keep_ptr < 0 {
            ops.clear();
            ng_inst_operands(ve2.inst, &mut ops);
            var k: i64 = 0;
            while k < ops.len() {
                var u: i64 = ops.get(k);
                if u >= 0 && u < n {
                    cand.set(u, 0);
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    // 1 + the extension a load of the local's type does from memory
    i = 0;
    while i < n {
        if cand.get(i) != 0 {
            var t: IrType = atys.get(i);
            var kind: i64 = ng_narrow_kind(t);
            if ir_type_eq(t, IrType::F32) {
                kind = NEXT_SW;
            }
            if ir_type_eq(t, IrType::Bool) {
                kind = NEXT_ZB;
            }
            cand.set(i, 1 + kind);
        }
        i = i + 1;
    }
    return cand;
}

fn ng_is_promoted(g: &NatGen, id: i64) -> bool {
    return g.rec && id >= 0 && id < g.promoted.len() && g.promoted.get(id) != 0;
}

// --- Allocation ---------------------------------------------------------

pub struct NatAlloc {
    pub assign: Vec<i64>,
    // vreg - 64 -> register, -1 spilled, -2 unused
    pub remat: Vec<i64>,
    // vreg - 64 -> NG_REMAT_* (a constant, a global's or a slot's
    // address), computed again where used; 0: not rematerialized
    pub remat_val: Vec<i64>,
    // its value
    pub spill: Vec<i64>,
    // vreg - 64 -> frame offset of its slot (spilled)
    pub frame: i64,
    pub save_regs: Vec<i64>,
    pub save_off: i64,
    pub mask: i64,
    // pool registers this function clobbers
    pub err: str,
    // RA10 / MI25: vreg - 64 -> its register class (NG_RC_*), as the
    // allocator decided it (ng_mir_classes_c over the copy classes)
    pub cls: Vec<i64>,
}

// (MI1: MBlocks, mi_blocks and the block liveness mi_liveness are in
// compiler/mir.fd.)

fn ng_touch2(lo: &mut Vec<i64>, hi: &mut Vec<i64>, v: i64, p: i64) {
    var vi: i64 = v - NG_VBASE;
    if vi < 0 || vi >= lo.len() {
        return;
    }
    if lo.get(vi) < 0 || p < lo.get(vi) {
        lo.set(vi, p);
    }
    if p > hi.get(vi) {
        hi.set(vi, p);
    }
}

/// The clobber mask of the call at `m` (interprocedural: what the callee
/// was found to clobber, when it was allocated before; else all).
fn ng_call_mask(g: &NatGen, m: MInst) -> i64 {
    if m.op != MO_CALL || !ng_on("ipra") {
        return ng_full_mask(g);
    }
    return ng_label_mask(g, m.i0);
}

fn ng_label_mask(g: &NatGen, label: i64) -> i64 {
    var key: str = int_to_str(label);
    if HashMap_contains(g.label_fn, key) {
        var name: str = HashMap_get(g.label_fn, key);
        if HashMap_contains(g.fn_mask, name) {
            return HashMap_get(g.fn_mask, name);
        }
        // WP20: a library function's recorded clobber mask
        if HashMap_contains(g.lib_mask, name) {
            return HashMap_get(g.lib_mask, name);
        }
    }
    return -1;
}

/// First index of char `ch` at or after `from`, or -1.
fn ng_find_ch(s: str, ch: i64, from: i64) -> i64 {
    var i: i64 = from;
    while i < str_len(s) {
        if str_byte_at(s, i) == ch {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// WP20 consumer: load `ext <name> mask=N size=M` lines from the
/// FID_LIBFACTS_IN artifact into `g.lib_mask`, so IPRA keeps live values
/// across calls to functions outside this module. Malformed lines skip.
fn ng_libfacts_load(g: &mut NatGen) {
    var path: str = p_getenv("FID_LIBFACTS_IN");
    if (path as i64) == 0 || str_len(path) == 0 {
        return;
    }
    var data: str = p_file_read(path);
    if (data as i64) == 0 {
        return;
    }
    // Same contract as the rules consumer: the version header is required.
    if !str_starts_with(data, "# fid-facts 1\n") {
        return;
    }
    var ls: Vec<str> = str_split(data, "\n");
    var li: i64 = 0;
    while li < ls.len() {
        var line: str = ls.get(li);
        li = li + 1;
        if !str_starts_with(line, "ext ") {
            continue;
        }
        var sp: i64 = ng_find_ch(line, 32, 4);
        var mp: i64 = str_find(line, " mask=");
        if sp < 0 || mp < 0 || mp < sp {
            continue;
        }
        var nm: str = str_slice(line, 4, sp);
        var me: i64 = mp + 6;
        var mend: i64 = ng_find_ch(line, 32, me);
        if mend < 0 {
            mend = str_len(line);
        }
        var mv: i64 = str_parse_int(str_slice(line, me, mend));
        HashMap_insert(g.lib_mask, nm, mv);
    }
}

/// Trace `v` back through its most recent definitions before mir index `k`
/// in the same block: [label] when the chain ends at MO_ADDR, [-1] when an
/// unknown op writes it, [-2, v] when it was last defined in another block.
fn ng_trace_label(mir: &Vec<MInst>, bs: i64, k: i64, v0: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var v: i64 = v0;
    var j: i64 = k - 1;
    var steps: i64 = 0;
    while j >= bs && steps < 64 {
        var dm: MInst = mir.get(j);
        if mi_defines(dm.op) && dm.r0 == v {
            if dm.op == MO_ADDR {
                out.push(dm.i0);
                return out;
            }
            if dm.op == MO_MOV {
                v = dm.r1;
            } else {
                out.push(-1);
                return out;
            }
        }
        j = j - 1;
        steps = steps + 1;
    }
    out.push(-2);
    out.push(v);
    return out;
}

fn ng_block_start(mb: &MBlocks, k: i64) -> i64 {
    return mb.start.get(mb.of.get(k));
}

/// WP5: the clobber mask of the call at mir index `k`. Direct calls keep the
/// recorded callee mask; indirect calls trace the target back to the
/// address-of-function values that can reach it and take the union of their
/// masks — only when every possible target resolves, else all registers.
fn ng_call_mask_i(g: &NatGen, mir: &Vec<MInst>, mb: &MBlocks, k: i64) -> i64 {
    var m: MInst = mir.get(k);
    if !ng_on("ipra") {
        return ng_full_mask(g);
    }
    if m.op == MO_CALL {
        var lm: i64 = ng_label_mask(g, m.i0);
        if lm >= 0 {
            return lm;
        }
        return ng_full_mask(g);
    }
    if m.op != MO_CALLR {
        return ng_full_mask(g);
    }
    var bs: i64 = ng_block_start(mb, k);
    var tr: Vec<i64> = ng_trace_label(mir, bs, k, m.r0);
    if tr.get(0) >= 0 {
        var lm2: i64 = ng_label_mask(g, tr.get(0));
        if lm2 >= 0 {
            return lm2;
        }
        return ng_full_mask(g);
    }
    if tr.get(0) == -2 && tr.len() == 2 {
        var v: i64 = tr.get(1);
        var mask: i64 = 0;
        var ok: bool = true;
        var j2: i64 = 0;
        while j2 < mir.len() && ok {
            var dm: MInst = mir.get(j2);
            if mi_defines(dm.op) && dm.r0 == v {
                if dm.op == MO_MOV {
                    var tr2: Vec<i64> = ng_trace_label(mir, ng_block_start(mb, j2), j2, dm.r1);
                    if tr2.get(0) >= 0 {
                        var lm3: i64 = ng_label_mask(g, tr2.get(0));
                        if lm3 < 0 {
                            ok = false;
                        } else {
                            mask = mask | lm3;
                        }
                    } else {
                        ok = false;
                    }
                } else {
                    ok = false;
                }
            }
            j2 = j2 + 1;
        }
        if ok {
            return mask;
        }
    }
    return ng_full_mask(g);
}

/// RA2: two lists of segments [lo, hi] (pairs, in order, disjoint inside a
/// list) share no position.
fn ng_segs_disjoint(a: &Vec<i64>, b: &Vec<i64>) -> bool {
    var i: i64 = 0;
    var j: i64 = 0;
    while i + 1 < a.len() && j + 1 < b.len() {
        var alo: i64 = a.get(i);
        var ahi: i64 = a.get(i + 1);
        var blo: i64 = b.get(j);
        var bhi: i64 = b.get(j + 1);
        if ahi < blo {
            i = i + 2;
        } else if bhi < alo {
            j = j + 2;
        } else {
            return false;
        }
    }
    return true;
}

// ---------------------------------------------------------------------------
// RA2: liveness from use lists, and the main allocation over live ranges
// that are lists of segments with holes (not hulls).
//   ng_use_liveness   block liveness from each vreg's uses and definitions
//                     (per-variable path exploration over the
//                     predecessors), in mi_liveness's bit sets; the
//                     allocator's liveness (ng_alloc_liveness) unless
//                     FID_NAT_OFF=uselive; FID_VERIFY=1 compares it with
//                     the block fixed point (mi_liveness) on every function
//   ng_class_segs     each class's live range as segments over doubled
//                     positions (2k: what instruction k reads and the
//                     values live into it; 2k + 1: what it writes and the
//                     values live after it), exact per instruction
//   ng_seg_scan       ng_mir_alloc's linear scan over those segments: a
//                     range may take a register in the holes of the ranges
//                     that hold it
//   ng_greedy_assign  the same interference when given segments (RA9)
// Two ranges sharing no position never conflict in the allocation
// checker's sense (no definition writes a register a value live after it
// holds); a call at c clobbers the values whose segments hold 2c + 1.
// `FID_NAT_OFF=holes`: hulls throughout, as before (and no second chance,
// ng_alloc_holes); `FID_NAT_OFF=segscan`: the hull scan with the second
// chance; `FID_NAT_OFF=uselive`: the block fixed point.
// ---------------------------------------------------------------------------

/// RA2 (FID_VERIFY=1): the first difference found between the use-list
/// liveness and the block fixed point in the function being allocated, ""
/// while they agree. ng_mir_alloc resets it and reports it as an
/// allocation error.
var g_ng_live_err: str = "";

/// RA2: block liveness in mi_liveness's form (`words` words per block, bit
/// sel[vi] for vreg index vi, sel[vi] < 0: not tracked), from use lists
/// rather than to a fixed point: one pass over the instructions finds, per
/// vreg, the blocks that read it before writing it (live in) and the blocks
/// that write it; from each live-in block, liveness walks back over the
/// predecessors: live out of each, and live in (then walked on) where the
/// predecessor does not write the vreg. Each vreg visits only the blocks
/// where it is live.
fn ng_use_liveness(mir: &Vec<MInst>, mb: &MBlocks, sel: &Vec<i64>, words: i64, live_in: &mut Vec<i64>, live_out: &mut Vec<i64>) {
    var nb: i64 = mb.start.len();
    var i: i64 = 0;
    while i < nb * words {
        live_in.push(0);
        live_out.push(0);
        i = i + 1;
    }
    var nbits: i64 = 0;
    i = 0;
    while i < sel.len() {
        if sel.get(i) + 1 > nbits {
            nbits = sel.get(i) + 1;
        }
        i = i + 1;
    }
    if nb == 0 || words == 0 || nbits == 0 {
        return;
    }
    // predecessors, packed: block b's are plist[pstart[b] .. pstart[b + 1])
    var pcount: Vec<i64> = Vec::new();
    i = 0;
    while i <= nb {
        pcount.push(0);
        i = i + 1;
    }
    var b: i64 = 0;
    while b < nb {
        var ss: Vec<i64> = mb.succs.get(b);
        var si: i64 = 0;
        while si < ss.len() {
            pcount.set(ss.get(si) + 1, pcount.get(ss.get(si) + 1) + 1);
            si = si + 1;
        }
        b = b + 1;
    }
    var pstart: Vec<i64> = Vec::new();
    var pfill: Vec<i64> = Vec::new();
    var acc: i64 = 0;
    i = 0;
    while i <= nb {
        acc = acc + pcount.get(i);
        pstart.push(acc);
        pfill.push(acc);
        i = i + 1;
    }
    var plist: Vec<i64> = Vec::new();
    i = 0;
    while i < acc {
        plist.push(0);
        i = i + 1;
    }
    b = 0;
    while b < nb {
        var ss2: Vec<i64> = mb.succs.get(b);
        var sj: i64 = 0;
        while sj < ss2.len() {
            var to: i64 = ss2.get(sj);
            plist.set(pfill.get(to), b);
            pfill.set(to, pfill.get(to) + 1);
            sj = sj + 1;
        }
        b = b + 1;
    }
    // per bit: the blocks reading it first (ue) and the blocks writing it
    // (def), as lists threaded through *_next
    var ue_head: Vec<i64> = Vec::new();
    var def_head: Vec<i64> = Vec::new();
    var last_ue: Vec<i64> = Vec::new();
    var last_def: Vec<i64> = Vec::new();
    i = 0;
    while i < nbits {
        ue_head.push(0 - 1);
        def_head.push(0 - 1);
        last_ue.push(0 - 1);
        last_def.push(0 - 1);
        i = i + 1;
    }
    var ue_blk: Vec<i64> = Vec::new();
    var ue_next: Vec<i64> = Vec::new();
    var def_blk: Vec<i64> = Vec::new();
    var def_next: Vec<i64> = Vec::new();
    b = 0;
    while b < nb {
        var k: i64 = mb.start.get(b);
        while k <= mb.end.get(b) {
            var m: MInst = mir.get(k);
            var um: i64 = mi_use_mask(m.op);
            var f: i64 = 0;
            while f < 3 {
                if (um & (1 << f)) != 0 {
                    var v: i64 = mi_field(m, f);
                    if v >= NG_VBASE && v - NG_VBASE < sel.len() && sel.get(v - NG_VBASE) >= 0 {
                        var ub: i64 = sel.get(v - NG_VBASE);
                        if last_def.get(ub) != b && last_ue.get(ub) != b {
                            last_ue.set(ub, b);
                            ue_blk.push(b);
                            ue_next.push(ue_head.get(ub));
                            ue_head.set(ub, ue_blk.len() - 1);
                        }
                    }
                }
                f = f + 1;
            }
            if mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 - NG_VBASE < sel.len() && sel.get(m.r0 - NG_VBASE) >= 0 {
                var db: i64 = sel.get(m.r0 - NG_VBASE);
                if last_def.get(db) != b {
                    last_def.set(db, b);
                    def_blk.push(b);
                    def_next.push(def_head.get(db));
                    def_head.set(db, def_blk.len() - 1);
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    // per bit: walk back from its live-in blocks
    var dstamp: Vec<i64> = Vec::new();
    i = 0;
    while i < nb {
        dstamp.push(0);
        i = i + 1;
    }
    var stack: Vec<i64> = Vec::new();
    var bit: i64 = 0;
    while bit < nbits {
        var e: i64 = def_head.get(bit);
        while e >= 0 {
            dstamp.set(def_blk.get(e), bit + 1);
            e = def_next.get(e);
        }
        var w: i64 = bit / 64;
        var mbit: i64 = 1 << (bit % 64);
        var e2: i64 = ue_head.get(bit);
        while e2 >= 0 {
            var lb: i64 = ue_blk.get(e2);
            var at: i64 = lb * words + w;
            if (live_in.get(at) & mbit) == 0 {
                live_in.set(at, live_in.get(at) | mbit);
                stack.push(lb);
            }
            e2 = ue_next.get(e2);
        }
        while stack.len() > 0 {
            var sb: i64 = stack.get(stack.len() - 1);
            stack.truncate(stack.len() - 1);
            var pi: i64 = pstart.get(sb);
            while pi < pstart.get(sb + 1) {
                var p: i64 = plist.get(pi);
                var pat: i64 = p * words + w;
                if (live_out.get(pat) & mbit) == 0 {
                    live_out.set(pat, live_out.get(pat) | mbit);
                    if dstamp.get(p) != bit + 1 && (live_in.get(pat) & mbit) == 0 {
                        live_in.set(pat, live_in.get(pat) | mbit);
                        stack.push(p);
                    }
                }
                pi = pi + 1;
            }
        }
        bit = bit + 1;
    }
}

/// RA2: the allocator's block liveness: from use lists (ng_use_liveness),
/// or the block fixed point with FID_NAT_OFF=uselive. FID_VERIFY=1 runs
/// both and records the first difference in g_ng_live_err.
fn ng_alloc_liveness(mir: &Vec<MInst>, mb: &MBlocks, sel: &Vec<i64>, words: i64, live_in: &mut Vec<i64>, live_out: &mut Vec<i64>) {
    if !ng_on("uselive") {
        mi_liveness(mir, mb, sel, words, live_in, live_out);
        return;
    }
    ng_use_liveness(mir, mb, sel, words, live_in, live_out);
    if ng_verify_on() && g_ng_live_err == "" && words > 0 {
        var fin: Vec<i64> = Vec::new();
        var fout: Vec<i64> = Vec::new();
        mi_liveness(mir, mb, sel, words, &mut fin, &mut fout);
        var j: i64 = 0;
        while j < fin.len() && g_ng_live_err == "" {
            if fin.get(j) != live_in.get(j) || fout.get(j) != live_out.get(j) {
                g_ng_live_err = "RA2: the use-list liveness differs from the block fixed point at block " + int_to_str(j / words) + " (word " + int_to_str(j % words) + ")";
            }
            j = j + 1;
        }
    }
}

/// RA2: prepend segment [plo, phi] to vreg v's list (built back to front,
/// so each new segment lies before the list's first), joined with it when
/// they touch.
fn ng_seg_prepend(head: &mut Vec<i64>, s_lo: &mut Vec<i64>, s_hi: &mut Vec<i64>, s_next: &mut Vec<i64>, v: i64, plo: i64, phi: i64) {
    var h: i64 = head.get(v);
    if h >= 0 && phi + 1 >= s_lo.get(h) {
        if plo < s_lo.get(h) {
            s_lo.set(h, plo);
        }
        if phi > s_hi.get(h) {
            s_hi.set(h, phi);
        }
        return;
    }
    s_lo.push(plo);
    s_hi.push(phi);
    s_next.push(h);
    head.set(v, s_lo.len() - 1);
}

/// RA2: the union of two segment lists (pairs in order), segments that
/// overlap or touch joined.
fn ng_seg_union(a: &Vec<i64>, b: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    var j: i64 = 0;
    while i + 1 < a.len() || j + 1 < b.len() {
        var plo: i64 = 0;
        var phi: i64 = 0;
        if j + 1 >= b.len() || (i + 1 < a.len() && a.get(i) <= b.get(j)) {
            plo = a.get(i);
            phi = a.get(i + 1);
            i = i + 2;
        } else {
            plo = b.get(j);
            phi = b.get(j + 1);
            j = j + 2;
        }
        var n: i64 = out.len();
        if n >= 2 && plo <= out.get(n - 1) + 1 {
            if phi > out.get(n - 1) {
                out.set(n - 1, phi);
            }
        } else {
            out.push(plo);
            out.push(phi);
        }
    }
    return out;
}

/// RA2: each copy class's live range as segments with holes, exact per
/// instruction, over doubled positions: a definition at k starts a segment
/// at 2k + 1 (a dead one is [2k + 1, 2k + 1]), a read at k ends one at 2k,
/// live in starts one at 2 * (block start), live out ends one at
/// 2 * (block end) + 1. Each block is walked back from its live-out set
/// (`lout`, bits sel[vi], `words` words per block; words 0: no vreg crosses
/// a block), as the allocation checker walks it. Indexed by vreg index:
/// a class representative (crep) holds the union of its members' segments
/// (pairs in order, joined where they touch); a member keeps its own.
fn ng_class_segs(mir: &Vec<MInst>, mb: &MBlocks, sel: &Vec<i64>, words: i64, lout: &Vec<i64>, crep: &mut Vec<i64>, nv: i64) -> Vec<Vec<i64>> {
    var nb: i64 = mb.start.len();
    var nbits: i64 = 0;
    var i: i64 = 0;
    while i < nv && i < sel.len() {
        if sel.get(i) + 1 > nbits {
            nbits = sel.get(i) + 1;
        }
        i = i + 1;
    }
    var gv: Vec<i64> = Vec::new();
    i = 0;
    while i < nbits {
        gv.push(0 - 1);
        i = i + 1;
    }
    i = 0;
    while i < nv && i < sel.len() {
        if sel.get(i) >= 0 {
            gv.set(sel.get(i), i);
        }
        i = i + 1;
    }
    var head: Vec<i64> = Vec::new();
    var open: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        head.push(0 - 1);
        open.push(0 - 1);
        i = i + 1;
    }
    var s_lo: Vec<i64> = Vec::new();
    var s_hi: Vec<i64> = Vec::new();
    var s_next: Vec<i64> = Vec::new();
    var openl: Vec<i64> = Vec::new();
    // the blocks from the last, each from its end: every segment comes
    // before the ones already made for its vreg
    var b: i64 = nb - 1;
    while b >= 0 {
        var bs: i64 = mb.start.get(b);
        var be: i64 = mb.end.get(b);
        if words > 0 && lout.len() >= (b + 1) * words {
            var gi: i64 = 0;
            while gi < nbits {
                if (lout.get(b * words + gi / 64) & (1 << (gi % 64))) != 0 {
                    var ov: i64 = gv.get(gi);
                    if ov >= 0 && open.get(ov) < 0 {
                        open.set(ov, 2 * be + 1);
                        openl.push(ov);
                    }
                }
                gi = gi + 1;
            }
        }
        var k: i64 = be;
        while k >= bs {
            var m: MInst = mir.get(k);
            if mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 - NG_VBASE < nv {
                var d: i64 = m.r0 - NG_VBASE;
                var dend: i64 = 2 * k + 1;
                if open.get(d) >= 0 {
                    dend = open.get(d);
                    open.set(d, 0 - 1);
                }
                ng_seg_prepend(&mut head, &mut s_lo, &mut s_hi, &mut s_next, d, 2 * k + 1, dend);
            }
            var um: i64 = mi_use_mask(m.op);
            var f: i64 = 0;
            while f < 3 {
                if (um & (1 << f)) != 0 {
                    var u: i64 = mi_field(m, f) - NG_VBASE;
                    if u >= 0 && u < nv && open.get(u) < 0 {
                        open.set(u, 2 * k);
                        openl.push(u);
                    }
                }
                f = f + 1;
            }
            k = k - 1;
        }
        var oi: i64 = 0;
        while oi < openl.len() {
            var ou: i64 = openl.get(oi);
            if open.get(ou) >= 0 {
                ng_seg_prepend(&mut head, &mut s_lo, &mut s_hi, &mut s_next, ou, 2 * bs, open.get(ou));
                open.set(ou, 0 - 1);
            }
            oi = oi + 1;
        }
        openl.truncate(0);
        b = b - 1;
    }
    var segs: Vec<Vec<i64>> = Vec::new();
    i = 0;
    while i < nv {
        var lst: Vec<i64> = Vec::new();
        var e: i64 = head.get(i);
        while e >= 0 {
            lst.push(s_lo.get(e));
            lst.push(s_hi.get(e));
            e = s_next.get(e);
        }
        segs.push(lst);
        i = i + 1;
    }
    // members join their representative
    i = 0;
    while i < nv {
        var r: i64 = ng_find(crep, i);
        if r != i {
            var ml: Vec<i64> = segs.get(i);
            if ml.len() > 0 {
                var rl: Vec<i64> = segs.get(r);
                segs.set(r, ng_seg_union(&rl, &ml));
            }
        }
        i = i + 1;
    }
    return segs;
}

/// RA2: v's segments, or its hull [sb, se] when it has none.
fn ng_seg_of(segs: &Vec<Vec<i64>>, sb: &Vec<i64>, se: &Vec<i64>, v: i64) -> Vec<i64> {
    if v < segs.len() {
        var s: Vec<i64> = segs.get(v);
        if s.len() >= 2 {
            return s;
        }
    }
    var h: Vec<i64> = Vec::new();
    h.push(sb.get(v));
    h.push(se.get(v));
    return h;
}

/// RA2: register r may hold a value with segments `s` (doubled positions):
/// callee-saved, or no call it is live after (a call at c with 2c + 1 in a
/// segment) clobbers r.
fn ng_seg_reg_ok(g: &NatGen, r: i64, s: &Vec<i64>, calls: &Vec<i64>, masks: &Vec<i64>) -> bool {
    if ng_is_callee_saved(g, r) {
        return true;
    }
    var si: i64 = 0;
    while si + 1 < s.len() {
        var cmin: i64 = s.get(si) / 2;
        var cmax: i64 = 0 - 1;
        if s.get(si + 1) >= 1 {
            cmax = (s.get(si + 1) - 1) / 2;
        }
        if cmax >= cmin && !ng_reg_ok(g, r, cmin - 1, cmax + 1, calls, masks) {
            return false;
        }
        si = si + 2;
    }
    return true;
}

/// RA2: ranges w and v (v's segments `vs`) share a position. sb/se are the
/// first and last positions of each; past the budget of segment
/// comparisons, meeting first and last positions count as sharing (sound,
/// less precise).
fn ng_seg_meet(segs: &Vec<Vec<i64>>, sb: &Vec<i64>, se: &Vec<i64>, w: i64, v: i64, vs: &Vec<i64>, budget: &mut i64) -> bool {
    if se.get(w) < sb.get(v) || se.get(v) < sb.get(w) {
        return false;
    }
    var left: i64 = *budget;
    if left <= 0 {
        return true;
    }
    var ws: Vec<i64> = ng_seg_of(segs, sb, se, w);
    *budget = left - ws.len() - vs.len() - 1;
    return !ng_segs_disjoint(vs, &ws);
}

/// RA2: no range of `lst` (one register's, in order of hull start `lo`)
/// shares a position with v.
fn ng_seg_free(lst: &Vec<i64>, segs: &Vec<Vec<i64>>, sb: &Vec<i64>, se: &Vec<i64>, lo: &Vec<i64>, hi: &Vec<i64>, v: i64, vs: &Vec<i64>, budget: &mut i64) -> bool {
    var j: i64 = 0;
    var vh: i64 = hi.get(v);
    while j < lst.len() {
        var w: i64 = lst.get(j);
        if lo.get(w) > vh {
            // (the rest start later still)
            return true;
        }
        if ng_seg_meet(segs, sb, se, w, v, vs, budget) {
            return false;
        }
        j = j + 1;
    }
    return true;
}

/// RA2: the ranges of `lst` (one register's, in order of hull start) that
/// share a position with v.
fn ng_seg_hits(lst: &Vec<i64>, segs: &Vec<Vec<i64>>, sb: &Vec<i64>, se: &Vec<i64>, lo: &Vec<i64>, hi: &Vec<i64>, v: i64, vs: &Vec<i64>, budget: &mut i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var j: i64 = 0;
    var vh: i64 = hi.get(v);
    var more: bool = true;
    while more && j < lst.len() {
        var w: i64 = lst.get(j);
        if lo.get(w) > vh {
            more = false;
        } else if ng_seg_meet(segs, sb, se, w, v, vs, budget) {
            out.push(w);
        }
        j = j + 1;
    }
    return out;
}

fn ng_seg_in(lst: &Vec<i64>, x: i64) -> bool {
    var j: i64 = 0;
    while j < lst.len() {
        if lst.get(j) == x {
            return true;
        }
        j = j + 1;
    }
    return false;
}

/// RA2: the first and last doubled positions of each vreg's range: its
/// segments', or its hull's [2 lo, 2 hi + 1].
fn ng_seg_bounds(segs: &Vec<Vec<i64>>, lo: &Vec<i64>, hi: &Vec<i64>, nv: i64, sb: &mut Vec<i64>, se: &mut Vec<i64>) {
    var i: i64 = 0;
    while i < nv {
        var s: Vec<i64> = Vec::new();
        if i < segs.len() {
            s = segs.get(i);
        }
        if s.len() >= 2 {
            sb.push(s.get(0));
            se.push(s.get(s.len() - 1));
        } else {
            sb.push(2 * lo.get(i));
            se.push(2 * hi.get(i) + 1);
        }
        i = i + 1;
    }
}

/// RA2: the linear scan over segments with holes, in place of ng_mir_alloc's
/// scan over hulls: the ranges order[0 .. total) (by hull start) each take,
/// in the scan's order, the copy partner's register (`hint`, by class
/// representative), a caller-saved register of the pool, a callee-saved
/// one, the first that no range holding it shares a position with (so a
/// range lives in the holes of the others) and that no call it is live
/// after clobbers (ng_seg_reg_ok). When none is free: with spill weights
/// (RA5, `weights_on`) the register whose interfering ranges all weigh
/// less than this one, the heaviest of them lightest, is taken from them
/// (they spill); without, a register only one range holds against it,
/// that range ending after it (the furthest such). Else the range spills
/// (ng_alloc_holes may still place it). A register's ranges whose last
/// position is before the current hull start leave its list. Fills
/// `assign` (register, -1 spilled); returns the number of ranges evicted.
fn ng_seg_scan(g: &NatGen, order: &Vec<i64>, total: i64, lo: &Vec<i64>, hi: &Vec<i64>, segs: &Vec<Vec<i64>>, hint: &Vec<i64>, weight: &Vec<i64>, weights_on: bool, calls: &Vec<i64>, masks: &Vec<i64>, nv: i64, assign: &mut Vec<i64>) -> i64 {
    var pool: Vec<i64> = ng_pool_caller(g);
    var callee: Vec<i64> = ng_callee_saved(g);
    var i: i64 = 0;
    while i < callee.len() {
        pool.push(callee.get(i));
        i = i + 1;
    }
    var held: Vec<Vec<i64>> = Vec::new();
    i = 0;
    while i < 64 {
        held.push(Vec::new());
        i = i + 1;
    }
    var sb: Vec<i64> = Vec::new();
    var se: Vec<i64> = Vec::new();
    ng_seg_bounds(segs, lo, hi, nv, &mut sb, &mut se);
    // (compile time: at most this many segment comparisons per function)
    var budget: i64 = 8000000;
    var n_ev: i64 = 0;
    var oi: i64 = 0;
    while oi < total {
        var v: i64 = order.get(oi);
        var vs: Vec<i64> = ng_seg_of(segs, &sb, &se, v);
        // ranges over before this hull starts (and so before every later
        // one's) leave the lists
        var from: i64 = 2 * lo.get(v);
        var pi: i64 = 0;
        while pi < pool.len() {
            var pr: i64 = pool.get(pi);
            var pl: Vec<i64> = held.get(pr);
            var stale: bool = false;
            var qi: i64 = 0;
            while !stale && qi < pl.len() {
                if se.get(pl.get(qi)) < from {
                    stale = true;
                }
                qi = qi + 1;
            }
            if stale {
                var kept: Vec<i64> = Vec::new();
                var qj: i64 = 0;
                while qj < pl.len() {
                    if se.get(pl.get(qj)) >= from {
                        kept.push(pl.get(qj));
                    }
                    qj = qj + 1;
                }
                held.set(pr, kept);
            }
            pi = pi + 1;
        }
        var r: i64 = 0 - 1;
        var h: i64 = hint.get(v);
        if h >= 0 && h < nv && assign.get(h) >= 0 && ng_seg_in(&pool, assign.get(h)) {
            var hr: i64 = assign.get(h);
            var hl: Vec<i64> = held.get(hr);
            if ng_seg_reg_ok(g, hr, &vs, calls, masks) && ng_seg_free(&hl, segs, &sb, &se, lo, hi, v, &vs, &mut budget) {
                r = hr;
            }
        }
        var ci: i64 = 0;
        while r < 0 && ci < pool.len() {
            var c: i64 = pool.get(ci);
            var cl: Vec<i64> = held.get(c);
            if ng_seg_reg_ok(g, c, &vs, calls, masks) && ng_seg_free(&cl, segs, &sb, &se, lo, hi, v, &vs, &mut budget) {
                r = c;
            }
            ci = ci + 1;
        }
        if r < 0 {
            var best: i64 = 0 - 1;
            var best_cost: i64 = 0;
            var best_hits: Vec<i64> = Vec::new();
            var ei: i64 = 0;
            while ei < pool.len() {
                var c2: i64 = pool.get(ei);
                if ng_seg_reg_ok(g, c2, &vs, calls, masks) {
                    var el: Vec<i64> = held.get(c2);
                    var hits: Vec<i64> = ng_seg_hits(&el, segs, &sb, &se, lo, hi, v, &vs, &mut budget);
                    var ok: bool = hits.len() > 0;
                    var cost: i64 = 0;
                    var hj: i64 = 0;
                    while ok && hj < hits.len() {
                        var w: i64 = hits.get(hj);
                        if weights_on {
                            if weight.get(w) >= weight.get(v) {
                                ok = false;
                            } else if weight.get(w) > cost {
                                cost = weight.get(w);
                            }
                        } else if hits.len() != 1 || hi.get(w) <= hi.get(v) {
                            ok = false;
                        } else {
                            cost = 0 - hi.get(w);
                        }
                        hj = hj + 1;
                    }
                    if ok && (best < 0 || cost < best_cost) {
                        best = c2;
                        best_cost = cost;
                        best_hits = hits;
                    }
                }
                ei = ei + 1;
            }
            if best >= 0 {
                var bl: Vec<i64> = held.get(best);
                var bkept: Vec<i64> = Vec::new();
                var bj: i64 = 0;
                while bj < bl.len() {
                    var bw: i64 = bl.get(bj);
                    if ng_seg_in(&best_hits, bw) {
                        assign.set(bw, 0 - 1);
                        n_ev = n_ev + 1;
                    } else {
                        bkept.push(bw);
                    }
                    bj = bj + 1;
                }
                held.set(best, bkept);
                r = best;
            }
        }
        if r >= 0 {
            var al: Vec<i64> = held.get(r);
            al.push(v);
            held.set(r, al);
            assign.set(v, r);
        } else {
            assign.set(v, 0 - 1);
        }
        oi = oi + 1;
    }
    return n_ev;
}

/// RA2: nat_seg_unit's generator (31-bit linear congruential: no product
/// overflows).
fn ng_su_next(x: i64) -> i64 {
    return (x * 1103515245 + 12345) % 2147483648;
}

/// RA2: a test of the use-list liveness, the segments and the scan over
/// segments on a random function of target `arch` (NAT_A64, NAT_RV64,
/// NAT_X64): `nblk` blocks over `nvr` vregs, each block a label, a few
/// definitions, reads and calls, and a jump, a conditional branch or a fall
/// through (the last block returns), from the generator seeded with
/// `seed`. Checks that ng_use_liveness equals mi_liveness; that each vreg's
/// segments hold position 2k + 1 exactly when instruction k writes it or it
/// is live after k, and 2k exactly when it is live into k (k reads it, or
/// it is live after k without k writing it); and that the scan's
/// assignment passes the allocation checker's rules (no definition writes
/// a register another value live after it holds; no call clobbers a
/// register a value live after it holds; registers from the pool). Returns
/// "" or the first failure; with `stats`, "" is replaced by
/// "<ranges> <spilled> <evicted>" when everything passes. For
/// tests/nattools/seg_unit.fd.
pub fn nat_seg_unit(arch: i64, seed: i64, nblk: i64, nvr: i64, stats: bool) -> str {
    var g: NatGen = NatGen_new(arch);
    var mir: Vec<MInst> = Vec::new();
    var x: i64 = (seed % 100000) * 7919 + 12345;
    var b: i64 = 0;
    while b < nblk {
        mir.push(MInst {
            op: MO_PLACE, r0: 0, r1: 0, r2: 0, i0: b + 1, i1: 0, i2: 0
        });
        x = ng_su_next(x);
        var nops: i64 = 1 + (x / 65536) % 6;
        var oq: i64 = 0;
        while oq < nops {
            x = ng_su_next(x);
            var kind: i64 = (x / 65536) % 10;
            x = ng_su_next(x);
            var va: i64 = NG_VBASE + (x / 65536) % nvr;
            x = ng_su_next(x);
            var vb: i64 = NG_VBASE + (x / 65536) % nvr;
            x = ng_su_next(x);
            var vc: i64 = NG_VBASE + (x / 65536) % nvr;
            if kind < 3 {
                mir.push(MInst {
                    op: MO_LI, r0: va, r1: 0, r2: 0, i0: kind, i1: 0, i2: 0
                });
            } else if kind < 7 {
                mir.push(MInst {
                    op: MO_ADD, r0: va, r1: vb, r2: vc, i0: 0, i1: 0, i2: 0
                });
            } else if kind < 9 {
                mir.push(MInst {
                    op: MO_MOV, r0: va, r1: vb, r2: 0, i0: 0, i1: 0, i2: 0
                });
            } else {
                mir.push(MInst {
                    op: MO_CALL, r0: 0, r1: 0, r2: 0, i0: 0, i1: 0, i2: 0
                });
            }
            oq = oq + 1;
        }
        x = ng_su_next(x);
        var tail: i64 = (x / 65536) % 4;
        x = ng_su_next(x);
        var target: i64 = 1 + (x / 65536) % nblk;
        x = ng_su_next(x);
        var cond: i64 = NG_VBASE + (x / 65536) % nvr;
        if b == nblk - 1 {
            mir.push(MInst {
                op: MO_EPILOGUE, r0: 0, r1: 0, r2: 0, i0: 0, i1: 0, i2: 0
            });
        } else if tail == 0 {
            mir.push(MInst {
                op: MO_JMP, r0: 0, r1: 0, r2: 0, i0: target, i1: 0, i2: 0
            });
        } else if tail == 1 {
            mir.push(MInst {
                op: MO_BNEZ, r0: cond, r1: 0, r2: 0, i0: target, i1: 0, i2: 0
            });
        }
        b = b + 1;
    }
    var n: i64 = mir.len();
    var mb: MBlocks = mi_blocks(&mir);
    var nb: i64 = mb.start.len();
    var sel: Vec<i64> = Vec::new();
    var crep: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nvr {
        sel.push(i);
        crep.push(i);
        i = i + 1;
    }
    var words: i64 = (nvr + 63) / 64;
    var uin: Vec<i64> = Vec::new();
    var uout: Vec<i64> = Vec::new();
    ng_use_liveness(&mir, &mb, &sel, words, &mut uin, &mut uout);
    var fin: Vec<i64> = Vec::new();
    var fout: Vec<i64> = Vec::new();
    mi_liveness(&mir, &mb, &sel, words, &mut fin, &mut fout);
    i = 0;
    while i < fin.len() {
        if fin.get(i) != uin.get(i) || fout.get(i) != uout.get(i) {
            return "liveness differs at block " + int_to_str(i / words);
        }
        i = i + 1;
    }
    var segs: Vec<Vec<i64>> = ng_class_segs(&mir, &mb, &sel, words, &uout, &mut crep, nvr);
    // exact liveness per instruction: each block walked back from live out
    var after: Vec<i64> = Vec::new();
    var before: Vec<i64> = Vec::new();
    i = 0;
    while i < n * words {
        after.push(0);
        before.push(0);
        i = i + 1;
    }
    b = 0;
    while b < nb {
        var live: Vec<i64> = Vec::new();
        var wi: i64 = 0;
        while wi < words {
            live.push(uout.get(b * words + wi));
            wi = wi + 1;
        }
        var k: i64 = mb.end.get(b);
        while k >= mb.start.get(b) {
            var wj: i64 = 0;
            while wj < words {
                after.set(k * words + wj, live.get(wj));
                wj = wj + 1;
            }
            var m: MInst = mir.get(k);
            if mi_defines(m.op) && m.r0 >= NG_VBASE {
                var d: i64 = m.r0 - NG_VBASE;
                live.set(d / 64, live.get(d / 64) & ~(1 << (d % 64)));
            }
            var um: i64 = mi_use_mask(m.op);
            var f: i64 = 0;
            while f < 3 {
                if (um & (1 << f)) != 0 && mi_field(m, f) >= NG_VBASE {
                    var u: i64 = mi_field(m, f) - NG_VBASE;
                    live.set(u / 64, live.get(u / 64) | (1 << (u % 64)));
                }
                f = f + 1;
            }
            var wk: i64 = 0;
            while wk < words {
                before.set(k * words + wk, live.get(wk));
                wk = wk + 1;
            }
            k = k - 1;
        }
        b = b + 1;
    }
    // each vreg's segments against it, position by position
    var lo: Vec<i64> = Vec::new();
    var hi: Vec<i64> = Vec::new();
    var v: i64 = 0;
    while v < nvr {
        var s: Vec<i64> = segs.get(v);
        var si: i64 = 0;
        while si + 3 < s.len() {
            if s.get(si + 1) + 1 >= s.get(si + 2) {
                return "v" + int_to_str(v + NG_VBASE) + ": segments out of order or touching";
            }
            si = si + 2;
        }
        var vw: i64 = v / 64;
        var vbit: i64 = 1 << (v % 64);
        var k2: i64 = 0;
        while k2 < n {
            var m2: MInst = mir.get(k2);
            var writes: bool = mi_defines(m2.op) && m2.r0 == v + NG_VBASE;
            var want_after: bool = writes || (after.get(k2 * words + vw) & vbit) != 0;
            var want_before: bool = (before.get(k2 * words + vw) & vbit) != 0;
            var p: i64 = 0;
            while p < 2 {
                var pos: i64 = 2 * k2 + p;
                var has: bool = false;
                var sj: i64 = 0;
                while sj + 1 < s.len() {
                    if s.get(sj) <= pos && pos <= s.get(sj + 1) {
                        has = true;
                    }
                    sj = sj + 2;
                }
                var want: bool = want_before;
                if p == 1 {
                    want = want_after;
                }
                if has != want {
                    return "v" + int_to_str(v + NG_VBASE) + " at position " + int_to_str(pos) + ": segments say " + bool_to_str(has) + ", liveness " + bool_to_str(want);
                }
                p = p + 1;
            }
            k2 = k2 + 1;
        }
        if s.len() >= 2 {
            lo.push(s.get(0) / 2);
            hi.push(s.get(s.len() - 1) / 2);
        } else {
            lo.push(0 - 1);
            hi.push(0 - 1);
        }
        v = v + 1;
    }
    // the scan, ranges in order of start
    var order: Vec<i64> = Vec::new();
    var k3: i64 = 0;
    while k3 <= n {
        var v3: i64 = 0;
        while v3 < nvr {
            if lo.get(v3) == k3 {
                order.push(v3);
            }
            v3 = v3 + 1;
        }
        k3 = k3 + 1;
    }
    var calls: Vec<i64> = Vec::new();
    var masks: Vec<i64> = Vec::new();
    var k4: i64 = 0;
    while k4 < n {
        if mi_is_call(mir.get(k4).op) {
            calls.push(k4);
            masks.push(ng_full_mask(&g));
        }
        k4 = k4 + 1;
    }
    var hint: Vec<i64> = Vec::new();
    i = 0;
    while i < nvr {
        hint.push(0 - 1);
        i = i + 1;
    }
    var weight: Vec<i64> = Vec::new();
    var full: i64 = ng_full_mask(&g);
    var report: str = int_to_str(order.len());
    // pass 0: the scan over segments; pass 1: the greedy allocator over
    // the same segments (RA9)
    var pass: i64 = 0;
    while pass < 2 {
        var assign: Vec<i64> = Vec::new();
        i = 0;
        while i < nvr {
            assign.push(0 - 2);
            i = i + 1;
        }
        var n_ev: i64 = 0;
        var who: str = "scan";
        if pass == 0 {
            n_ev = ng_seg_scan(&g, &order, order.len(), &lo, &hi, &segs, &hint, &weight, false, &calls, &masks, nvr, &mut assign);
        } else {
            who = "greedy";
            n_ev = ng_greedy_assign(&g, &lo, &hi, &segs, &hint, &weight, &calls, &masks, nvr, &mut assign);
        }
        var n_sp: i64 = 0;
        i = 0;
        while i < nvr {
            var ar: i64 = assign.get(i);
            if lo.get(i) >= 0 && ar == 0 - 1 {
                n_sp = n_sp + 1;
            }
            if lo.get(i) >= 0 && ar != 0 - 1 && !ng_class_has(&g, NG_RC_INT, ar) {
                return who + ": v" + int_to_str(i + NG_VBASE) + " holds register " + int_to_str(ar) + ", outside the pool";
            }
            i = i + 1;
        }
        var k5: i64 = 0;
        while k5 < n {
            var m5: MInst = mir.get(k5);
            var w5: i64 = 0;
            while w5 < nvr {
                var live5: bool = (after.get(k5 * words + w5 / 64) & (1 << (w5 % 64))) != 0;
                var r5: i64 = assign.get(w5);
                if live5 && r5 >= 0 {
                    if mi_defines(m5.op) && m5.r0 >= NG_VBASE && m5.r0 - NG_VBASE != w5 && assign.get(m5.r0 - NG_VBASE) == r5 {
                        return who + ": instruction " + int_to_str(k5) + " writes register " + int_to_str(r5) + " while v" + int_to_str(w5 + NG_VBASE) + " is live in it";
                    }
                    if mi_is_call(m5.op) && (full & (1 << r5)) != 0 && !ng_is_callee_saved(&g, r5) {
                        return who + ": the call at " + int_to_str(k5) + " clobbers register " + int_to_str(r5) + " of v" + int_to_str(w5 + NG_VBASE);
                    }
                }
                w5 = w5 + 1;
            }
            k5 = k5 + 1;
        }
        report = report + " " + int_to_str(n_sp) + " " + int_to_str(n_ev);
        pass = pass + 1;
    }
    if stats {
        return report;
    }
    return "";
}

/// RA2: a function of target `arch` whose ranges fit the registers only
/// with holes: `a` is made before a branch and read only on its far side,
/// while the near side keeps as many values live as the pool has
/// registers (K; with a running sum `s` written at each read). As hulls, K
/// + 1 ranges meet in the near side; as segments, `a` is not live there.
/// Returns the spills of the scan over segments, of the greedy allocator
/// over segments and of the greedy allocator over hulls, separated by
/// spaces ("0 0 n", n >= 1, is the expected answer). For
/// tests/nattools/seg_unit.fd.
pub fn nat_seg_designed(arch: i64) -> str {
    var g: NatGen = NatGen_new(arch);
    var kreg: i64 = ng_pool_caller(&g).len() + ng_callee_saved(&g).len();
    var mir: Vec<MInst> = Vec::new();
    var vc: i64 = NG_VBASE;
    var va: i64 = NG_VBASE + 1;
    var sink: i64 = NG_VBASE + 2 + kreg;
    var nvr: i64 = kreg + 3;
    // block 0: c, a; branch to the far side on c
    mir.push(MInst {
        op: MO_PLACE, r0: 0, r1: 0, r2: 0, i0: 1, i1: 0, i2: 0
    });
    mir.push(MInst {
        op: MO_LI, r0: vc, r1: 0, r2: 0, i0: 1, i1: 0, i2: 0
    });
    mir.push(MInst {
        op: MO_LI, r0: va, r1: 0, r2: 0, i0: 7, i1: 0, i2: 0
    });
    mir.push(MInst {
        op: MO_BNEZ, r0: vc, r1: 0, r2: 0, i0: 3, i1: 0, i2: 0
    });
    // block 1, the near side: K values live at once, then read in turn
    mir.push(MInst {
        op: MO_PLACE, r0: 0, r1: 0, r2: 0, i0: 2, i1: 0, i2: 0
    });
    var j: i64 = 0;
    while j < kreg {
        mir.push(MInst {
            op: MO_LI, r0: NG_VBASE + 2 + j, r1: 0, r2: 0, i0: j, i1: 0, i2: 0
        });
        j = j + 1;
    }
    j = 0;
    while j < kreg {
        mir.push(MInst {
            op: MO_ADD, r0: sink, r1: NG_VBASE + 2 + j, r2: NG_VBASE + 2 + j, i0: 0, i1: 0, i2: 0
        });
        j = j + 1;
    }
    mir.push(MInst {
        op: MO_JMP, r0: 0, r1: 0, r2: 0, i0: 4, i1: 0, i2: 0
    });
    // block 2, the far side: reads a
    mir.push(MInst {
        op: MO_PLACE, r0: 0, r1: 0, r2: 0, i0: 3, i1: 0, i2: 0
    });
    mir.push(MInst {
        op: MO_ADD, r0: va, r1: va, r2: va, i0: 0, i1: 0, i2: 0
    });
    // block 3: return
    mir.push(MInst {
        op: MO_PLACE, r0: 0, r1: 0, r2: 0, i0: 4, i1: 0, i2: 0
    });
    mir.push(MInst {
        op: MO_EPILOGUE, r0: 0, r1: 0, r2: 0, i0: 0, i1: 0, i2: 0
    });
    var mb: MBlocks = mi_blocks(&mir);
    var sel: Vec<i64> = Vec::new();
    var crep: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nvr {
        sel.push(i);
        crep.push(i);
        i = i + 1;
    }
    var words: i64 = (nvr + 63) / 64;
    var lin: Vec<i64> = Vec::new();
    var lout: Vec<i64> = Vec::new();
    ng_use_liveness(&mir, &mb, &sel, words, &mut lin, &mut lout);
    var segs: Vec<Vec<i64>> = ng_class_segs(&mir, &mb, &sel, words, &lout, &mut crep, nvr);
    var lo: Vec<i64> = Vec::new();
    var hi: Vec<i64> = Vec::new();
    var hint: Vec<i64> = Vec::new();
    i = 0;
    while i < nvr {
        var s: Vec<i64> = segs.get(i);
        if s.len() >= 2 {
            lo.push(s.get(0) / 2);
            hi.push(s.get(s.len() - 1) / 2);
        } else {
            lo.push(0 - 1);
            hi.push(0 - 1);
        }
        hint.push(0 - 1);
        i = i + 1;
    }
    var order: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k <= mir.len() {
        var v: i64 = 0;
        while v < nvr {
            if lo.get(v) == k {
                order.push(v);
            }
            v = v + 1;
        }
        k = k + 1;
    }
    var calls: Vec<i64> = Vec::new();
    var masks: Vec<i64> = Vec::new();
    var weight: Vec<i64> = Vec::new();
    var nosegs: Vec<Vec<i64>> = Vec::new();
    var out: str = "";
    var mode: i64 = 0;
    while mode < 3 {
        var assign: Vec<i64> = Vec::new();
        i = 0;
        while i < nvr {
            assign.push(0 - 2);
            i = i + 1;
        }
        var n_ev: i64 = 0;
        if mode == 0 {
            n_ev = ng_seg_scan(&g, &order, order.len(), &lo, &hi, &segs, &hint, &weight, false, &calls, &masks, nvr, &mut assign);
        } else if mode == 1 {
            n_ev = ng_greedy_assign(&g, &lo, &hi, &segs, &hint, &weight, &calls, &masks, nvr, &mut assign);
        } else {
            n_ev = ng_greedy_assign(&g, &lo, &hi, &nosegs, &hint, &weight, &calls, &masks, nvr, &mut assign);
        }
        if n_ev < 0 {
            return "negative eviction count";
        }
        var n_sp: i64 = 0;
        i = 0;
        while i < nvr {
            if lo.get(i) >= 0 && assign.get(i) == 0 - 1 {
                n_sp = n_sp + 1;
            }
            i = i + 1;
        }
        if mode > 0 {
            out = out + " ";
        }
        out = out + int_to_str(n_sp);
        mode = mode + 1;
    }
    return out;
}

/// RA2: live ranges as lists of segments with holes, for the ranges the
/// linear scan (over hulls) left without a register. A value's segments
/// come from block liveness: in each block where it lives, from the block's
/// start (live in) or its first appearance to the block's end (live out)
/// or its last appearance; between them are the holes (blocks where it is
/// not live, which a hull covers). A coalesced class is the union of its
/// members'. Each spilled class (not a rematerialized one, which costs
/// nothing), the most costly first (spill weights when on), takes the
/// first register no class holding it shares a position with (strictly:
/// touching segments count as shared) and that no call inside one of its
/// segments clobbers (ng_reg_ok over each segment widened by one, so a
/// call at either end counts): callee-saved registers already in use
/// first, then the caller-saved pool, then the other callee-saved ones.
/// The allocation checker (FID_VERIFY=1) judges the result like any
/// other. Returns the number of classes given a register.
/// When the main allocation ran over segments (`xsegs`, one list per vreg
/// from ng_class_segs: exact, doubled positions), those are used instead
/// of the block-level ones (ng_seg_reg_ok for the calls): a range evicted
/// late in the scan may still fit where the ranges holding a register are
/// not live. `FID_NAT_OFF=holes`: none.
fn ng_alloc_holes(g: &NatGen, mir: &Vec<MInst>, mb: &MBlocks, sel: &Vec<i64>, ng: i64, crep: &mut Vec<i64>, assign: &mut Vec<i64>, remat: &Vec<i64>, weight: &Vec<i64>, calls: &Vec<i64>, masks: &Vec<i64>, nv: i64, xsegs: &Vec<Vec<i64>>) -> i64 {
    var exact: bool = nv > 0 && xsegs.len() == nv;
    // The candidates: spilled representatives
    var cand: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        if ng_find(crep, i) == i && assign.get(i) == 0 - 1 && !ng_remat_is(remat.get(i)) {
            cand.push(i);
        }
        i = i + 1;
    }
    if cand.len() == 0 {
        return 0;
    }
    // the most costly first (insertion sort, over the first 512)
    if cand.len() > 512 {
        var cut: Vec<i64> = Vec::new();
        i = 0;
        while i < 512 {
            cut.push(cand.get(i));
            i = i + 1;
        }
        cand = cut;
    }
    if weight.len() == nv {
        i = 1;
        while i < cand.len() {
            var cv: i64 = cand.get(i);
            var j: i64 = i - 1;
            while j >= 0 && weight.get(cand.get(j)) < weight.get(cv) {
                cand.set(j + 1, cand.get(j));
                j = j - 1;
            }
            cand.set(j + 1, cv);
            i = i + 1;
        }
    }
    var nb: i64 = mb.start.len();
    var words: i64 = (ng + 63) / 64;
    var lin: Vec<i64> = Vec::new();
    var lout: Vec<i64> = Vec::new();
    var gv: Vec<i64> = Vec::new();
    if ng > 0 && !exact {
        ng_alloc_liveness(mir, mb, sel, words, &mut lin, &mut lout);
        i = 0;
        while i < ng {
            gv.push(0);
            i = i + 1;
        }
        i = 0;
        while i < nv {
            if sel.get(i) >= 0 {
                gv.set(sel.get(i), i);
            }
            i = i + 1;
        }
    }
    // Segments per class representative, block by block
    var segs: Vec<Vec<i64>> = Vec::new();
    var lastb: Vec<i64> = Vec::new();
    var first: Vec<i64> = Vec::new();
    var last: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        segs.push(Vec::new());
        lastb.push(0 - 1);
        first.push(0 - 1);
        last.push(0 - 1);
        i = i + 1;
    }
    var b: i64 = 0;
    // (none with exact segments)
    while b < nb && !exact {
        var bs: i64 = mb.start.get(b);
        var be: i64 = mb.end.get(b);
        var touched: Vec<i64> = Vec::new();
        var k: i64 = bs;
        while k <= be {
            var m: MInst = mir.get(k);
            var um: i64 = mi_use_mask(m.op);
            var f: i64 = 0;
            while f < 3 {
                var v: i64 = mi_field(m, f);
                if ((um & (1 << f)) != 0 || (f == 0 && mi_defines(m.op))) && v >= NG_VBASE && v - NG_VBASE < nv {
                    var vi: i64 = v - NG_VBASE;
                    if first.get(vi) < 0 {
                        first.set(vi, k);
                        touched.push(vi);
                    }
                    last.set(vi, k);
                }
                f = f + 1;
            }
            k = k + 1;
        }
        // the values live in or out here that this block never names
        var gi: i64 = 0;
        while gi < ng {
            var at: i64 = b * words + gi / 64;
            var bit: i64 = 1 << (gi % 64);
            if ((lin.get(at) | lout.get(at)) & bit) != 0 {
                var gvi: i64 = gv.get(gi);
                if first.get(gvi) < 0 {
                    first.set(gvi, bs);
                    last.set(gvi, bs);
                    touched.push(gvi);
                }
            }
            gi = gi + 1;
        }
        var ti: i64 = 0;
        while ti < touched.len() {
            var tv: i64 = touched.get(ti);
            var slo: i64 = first.get(tv);
            var shi: i64 = last.get(tv);
            var sg: i64 = sel.get(tv);
            if sg >= 0 {
                var at2: i64 = b * words + sg / 64;
                var bit2: i64 = 1 << (sg % 64);
                if (lin.get(at2) & bit2) != 0 {
                    slo = bs;
                }
                if (lout.get(at2) & bit2) != 0 {
                    shi = be;
                }
            }
            var rep: i64 = ng_find(crep, tv);
            var sl: Vec<i64> = segs.get(rep);
            if lastb.get(rep) == b && sl.len() >= 2 {
                if slo < sl.get(sl.len() - 2) {
                    sl.set(sl.len() - 2, slo);
                }
                if shi > sl.get(sl.len() - 1) {
                    sl.set(sl.len() - 1, shi);
                }
            } else {
                sl.push(slo);
                sl.push(shi);
            }
            segs.set(rep, sl);
            lastb.set(rep, b);
            first.set(tv, 0 - 1);
            last.set(tv, 0 - 1);
            ti = ti + 1;
        }
        b = b + 1;
    }
    // The classes in each register
    var owners: Vec<Vec<i64>> = Vec::new();
    i = 0;
    while i < 64 {
        owners.push(Vec::new());
        i = i + 1;
    }
    i = 0;
    while i < nv {
        var ar: i64 = assign.get(i);
        if ar >= 0 && ar < 64 && ng_find(crep, i) == i {
            var ol: Vec<i64> = owners.get(ar);
            ol.push(i);
            owners.set(ar, ol);
        }
        i = i + 1;
    }
    // Registers in the order tried
    var callee: Vec<i64> = ng_callee_saved(g);
    var caller: Vec<i64> = ng_pool_caller(g);
    var regs: Vec<i64> = Vec::new();
    i = 0;
    while i < callee.len() {
        if owners.get(callee.get(i)).len() > 0 {
            regs.push(callee.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < caller.len() {
        regs.push(caller.get(i));
        i = i + 1;
    }
    i = 0;
    while i < callee.len() {
        if owners.get(callee.get(i)).len() == 0 {
            regs.push(callee.get(i));
        }
        i = i + 1;
    }
    var placed: i64 = 0;
    // (compile time: at most this many segment comparisons per function)
    var budget: i64 = 4000000;
    var ci: i64 = 0;
    while ci < cand.len() && budget > 0 {
        var v2: i64 = cand.get(ci);
        var vs: Vec<i64> = segs.get(v2);
        if exact {
            vs = xsegs.get(v2);
        }
        var got: i64 = 0 - 1;
        var ri: i64 = 0;
        while got < 0 && vs.len() > 0 && ri < regs.len() && budget > 0 {
            var r: i64 = regs.get(ri);
            var ok: bool = true;
            var si: i64 = 0;
            if exact {
                ok = ng_seg_reg_ok(g, r, &vs, calls, masks);
                si = vs.len();
            }
            while ok && si + 1 < vs.len() {
                if !ng_reg_ok(g, r, vs.get(si) - 1, vs.get(si + 1) + 1, calls, masks) {
                    ok = false;
                }
                si = si + 2;
            }
            var oi: i64 = 0;
            var ol2: Vec<i64> = owners.get(r);
            while ok && oi < ol2.len() {
                var ou: Vec<i64> = segs.get(ol2.get(oi));
                if exact {
                    ou = xsegs.get(ol2.get(oi));
                }
                budget = budget - vs.len() - ou.len() - 1;
                if !ng_segs_disjoint(&vs, &ou) {
                    ok = false;
                }
                oi = oi + 1;
            }
            if ok && budget > 0 {
                got = r;
            }
            ri = ri + 1;
        }
        if got >= 0 {
            assign.set(v2, got);
            var ol3: Vec<i64> = owners.get(got);
            ol3.push(v2);
            owners.set(got, ol3);
            placed = placed + 1;
        }
        ci = ci + 1;
    }
    return placed;
}

// ---------------------------------------------------------------------------
// RA7: register hints for arguments, results and call operands. A value a
// move ties to an argument register (a parameter copied out of it at
// entry, a call operand copied into it, a call's result copied out of the
// result register, which is argument register 0 on AArch64 and RISC-V, or
// out of argument register 1 for a second result word) may be given that
// register once the scan is done, so the move becomes a move to itself and
// emits nothing (and a spilled value loses its loads and stores). The
// argument registers are outside the pools (ng_class_pool) because the MIR
// names them to pass arguments and results and some operations use them
// without naming them, so a value may hold one only where neither happens.
// ng_ra7_info models both, per operation:
//   named: an operand field that is an argument register (read when the
//     operation's use mask has the field, written when it is the r0 of a
//     defining operation);
//   implicit (ng_implicit_regs, ng_implicit_writes): a call loses every
//     argument register, writes the result registers and reads each
//     argument register some path wrote since the last call (all of them
//     at entry: the parameters); an epilogue reads the result registers;
//     on x86-64 division, remainder and high multiply write rdx (with rax
//     and r11, which never hold values), shifts rcx (the CL count, also
//     when BMI2 needs none), a copy rdx (the long copy's source cursor);
//     prologue, epilogue and vector operations touch them all.
// An argument register's own value lives from such a write to its last
// read (backward liveness over the blocks). Range [lo, hi] may take
// argument register R when no operation in [lo, hi] touches R implicitly
// (so no call falls inside it), none in [lo, hi) writes R by name or
// leaves R's own value live after it, and no range given R before
// interferes (ng_gr_clash). A read by name inside (lo, hi] keeps R live
// before it, so it is excluded too; a read at lo (the parameter copy) and
// a write at hi (the operand copy) are what a hint is for. The allocation
// checker walks the same model against exact value liveness
// (ng_mir_check_args). On by default since Nov 17 (OP16; it was opt-in
// through FID_NAT_ON=arghint, which still names it): FID_NAT_OFF=arghint
// turns it off. FID_NAT_MUTATE=arghint
// ignores the implicit uses (a value may then live across a call in an
// argument register): the checker must reject that (machine_ra7_check.sh).
// ---------------------------------------------------------------------------

/// RA7: argument-register hints on (read once per process).
var g_ng_arghint: i64 = 0;
fn ng_arghint_on() -> bool {
    if g_ng_arghint == 0 {
        g_ng_arghint = 1;
        if ng_on("arghint") {
            g_ng_arghint = 2;
        }
    }
    return g_ng_arghint == 2;
}

/// RA7: the argument registers a value may hold, as a mask: the platform
/// convention's (td.argregs 0..nregargs-1) that are no pool, spill or
/// address scratch register. 0 when the hints are off.
fn ng_arg_cands(g: &NatGen) -> i64 {
    if !ng_arghint_on() {
        return 0;
    }
    var reserved: i64 = (1 << g.td.spill_use0) | (1 << g.td.spill_use1) | (1 << g.td.spill_def) | (1 << g.td.ad) | (1 << g.td.ad2) | g.td.int_caller_mask | g.td.int_callee_mask;
    var m: i64 = 0;
    var i: i64 = 0;
    while i < g.td.nregargs && i < g.td.argregs.len() {
        var r: i64 = g.td.argregs.get(i);
        if r >= 0 && r < 32 && r != g.td.zr && (reserved & (1 << r)) == 0 {
            m = m | (1 << r);
        }
        i = i + 1;
    }
    return m;
}

/// RA7: the argument registers (within `cands`) operation `m` uses
/// without naming them (see above).
fn ng_implicit_regs(g: &NatGen, m: MInst, cands: i64) -> i64 {
    var op: i64 = m.op;
    if mi_is_call(op) || op == MO_PROLOGUE || op == MO_EPILOGUE || (op >= MO_VLD && op <= MO_VEND) {
        return cands;
    }
    if g.arch == NAT_X64 {
        if op == MO_DIV || op == MO_REM || op == MO_MULH || op == MO_COPY {
            return cands & (1 << 2);
        }
        if op == MO_SHL || op == MO_SAR || op == MO_SHR {
            return cands & (1 << 1);
        }
    }
    return 0;
}

/// RA7: the argument registers (within `cands`) operation `m` writes
/// without naming them: a call all of them, the x86-64 operations above
/// theirs; prologue, epilogue and vector operations none (they only keep
/// values out).
fn ng_implicit_writes(g: &NatGen, m: MInst, cands: i64) -> i64 {
    if mi_is_call(m.op) {
        return cands;
    }
    if m.op == MO_PROLOGUE || m.op == MO_EPILOGUE || (m.op >= MO_VLD && m.op <= MO_VEND) {
        return 0;
    }
    return ng_implicit_regs(g, m, cands);
}

/// RA7: what each operation of a function does to the argument registers
/// (masks over registers 0..63, within the candidates).
pub struct NgPhys {
    pub rd: Vec<i64>,
    // read at k: by name, by a call (the registers written since the last
    // call), by an epilogue (the result registers)
    pub wr: Vec<i64>,
    // written at k by name
    pub imp: Vec<i64>,
    // used at k without being named (ng_implicit_regs)
    pub kill: Vec<i64>,
    // written at k without being named (ng_implicit_writes)
    pub live: Vec<i64>,
    // holding a value some later operation reads, after k
    pub cpy: Vec<i64>,
    // 2g.88: the register a move at k copies into a value (`mov v, r`),
    // which may define v into r itself
}

/// RA7: the argument-register model of `mir` (see above).
fn ng_ra7_info(g: &NatGen, mir: &Vec<MInst>, mb: &MBlocks, cands: i64) -> NgPhys {
    var n: i64 = mir.len();
    var nb: i64 = mb.start.len();
    var rd: Vec<i64> = Vec::new();
    var wr: Vec<i64> = Vec::new();
    var imp: Vec<i64> = Vec::new();
    var kill: Vec<i64> = Vec::new();
    var live: Vec<i64> = Vec::new();
    var cpy: Vec<i64> = Vec::new();
    // (the result words are argument registers 0 and 1, Inst::Return; on
    // x86-64 result_reg is rax, a scratch register, and word 0 is rdi:
    // without it here a range ending between `mov rdi, result` and the
    // epilogue could take rdi, RA3)
    var res: i64 = ((1 << g.td.result_reg) | (1 << ng_argreg(g, 0)) | (1 << ng_argreg(g, 1))) & cands;
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        var um: i64 = mi_use_mask(m.op);
        var r: i64 = 0;
        var w: i64 = 0;
        var f: i64 = 0;
        while f < 3 {
            var v: i64 = mi_field(m, f);
            if v >= 0 && v < 64 && (cands & (1 << v)) != 0 {
                if (um & (1 << f)) != 0 {
                    r = r | (1 << v);
                }
                if f == 0 && mi_defines(m.op) {
                    w = w | (1 << v);
                }
            }
            f = f + 1;
        }
        if m.op == MO_EPILOGUE {
            r = r | res;
        }
        rd.push(r);
        wr.push(w);
        imp.push(ng_implicit_regs(g, m, cands));
        kill.push(ng_implicit_writes(g, m, cands));
        live.push(0);
        if m.op == MO_MOV && m.r0 >= NG_VBASE && m.r1 >= 0 && m.r1 < 64 && (cands & (1 << m.r1)) != 0 {
            cpy.push(1 << m.r1);
        } else {
            cpy.push(0);
        }
        k = k + 1;
    }
    // The registers some path wrote since the last call (forward, union
    // over predecessors; every one at entry); a call reads those
    var ain: Vec<i64> = Vec::new();
    var lin: Vec<i64> = Vec::new();
    var lout: Vec<i64> = Vec::new();
    var use_b: Vec<i64> = Vec::new();
    var def_b: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < nb {
        ain.push(0);
        lin.push(0);
        lout.push(0);
        use_b.push(0);
        def_b.push(0);
        b = b + 1;
    }
    if nb > 0 {
        ain.set(0, cands);
    }
    var changed: bool = true;
    var rounds: i64 = 0;
    while changed && rounds < 1000 {
        changed = false;
        rounds = rounds + 1;
        b = 0;
        while b < nb {
            var a: i64 = ain.get(b);
            k = mb.start.get(b);
            while k <= mb.end.get(b) {
                if mi_is_call(mir.get(k).op) {
                    a = res;
                } else {
                    a = a | wr.get(k) | kill.get(k);
                }
                k = k + 1;
            }
            var ss: Vec<i64> = mb.succs.get(b);
            var si: i64 = 0;
            while si < ss.len() {
                var s: i64 = ss.get(si);
                if (ain.get(s) | a) != ain.get(s) {
                    ain.set(s, ain.get(s) | a);
                    changed = true;
                }
                si = si + 1;
            }
            b = b + 1;
        }
    }
    b = 0;
    while b < nb {
        var a2: i64 = ain.get(b);
        k = mb.start.get(b);
        while k <= mb.end.get(b) {
            if mi_is_call(mir.get(k).op) {
                rd.set(k, rd.get(k) | a2);
                a2 = res;
            } else {
                a2 = a2 | wr.get(k) | kill.get(k);
            }
            k = k + 1;
        }
        b = b + 1;
    }
    // Liveness of the registers' own values (backward over the blocks)
    b = 0;
    while b < nb {
        var u: i64 = 0;
        var d: i64 = 0;
        k = mb.start.get(b);
        while k <= mb.end.get(b) {
            u = u | (rd.get(k) & ~d);
            d = d | wr.get(k) | kill.get(k);
            k = k + 1;
        }
        use_b.set(b, u);
        def_b.set(b, d);
        b = b + 1;
    }
    changed = true;
    rounds = 0;
    while changed && rounds < 1000 {
        changed = false;
        rounds = rounds + 1;
        b = nb - 1;
        while b >= 0 {
            var ss2: Vec<i64> = mb.succs.get(b);
            var o: i64 = 0;
            var si2: i64 = 0;
            while si2 < ss2.len() {
                o = o | lin.get(ss2.get(si2));
                si2 = si2 + 1;
            }
            var inn: i64 = use_b.get(b) | (o & ~def_b.get(b));
            if o != lout.get(b) {
                lout.set(b, o);
                changed = true;
            }
            if inn != lin.get(b) {
                lin.set(b, inn);
                changed = true;
            }
            b = b - 1;
        }
    }
    b = 0;
    while b < nb {
        var cur: i64 = lout.get(b);
        k = mb.end.get(b);
        while k >= mb.start.get(b) {
            live.set(k, cur);
            cur = (cur & ~(wr.get(k) | kill.get(k))) | rd.get(k);
            k = k - 1;
        }
        b = b + 1;
    }
    return NgPhys {
        rd: rd, wr: wr, imp: imp, kill: kill, live: live, cpy: cpy
    };
}

/// RA7: argument register r may hold a value over [lo, hi] (see above).
/// `blind` (FID_NAT_MUTATE=arghint only) ignores the implicit uses.
fn ng_arg_fit(ph: &NgPhys, r: i64, lo: i64, hi: i64, blind: bool) -> bool {
    var bit: i64 = 1 << r;
    var k: i64 = lo;
    while k <= hi {
        if !blind && (ph.imp.get(k) & bit) != 0 {
            return false;
        }
        if k < hi {
            var named: i64 = ph.live.get(k) | ph.wr.get(k);
            if !blind {
                named = named | ph.kill.get(k);
            }
            if (named & bit) != 0 {
                return false;
            }
        }
        k = k + 1;
    }
    return ng_arg_fit_end(ph, r, hi);
}

/// RA7 / RA3 (2g.88): at the last position `hi` of a range, r's own value
/// may be live after it only when that operation writes r by name (the
/// operand copy `mov r, v` a hint is for) or copies r into the value (`mov
/// v, r`: the value then is r's own, as the checker allows). Else the range's value is
/// defined there (a dead definition, the hull one position long: an `li`
/// whose use add-immediate selection folded away) and would overwrite the
/// argument or result r holds; before, such a range took r (the allocation
/// checker's "defines vN in argument register R, whose argument or result
/// is still to be read": case_n of test_machine_simd on x86-64 with RA4's
/// split, FID_NAT_ON=splitall). Elsewhere the value is live before hi too,
/// and [lo, hi) already excludes it.
fn ng_arg_fit_end(ph: &NgPhys, r: i64, hi: i64) -> bool {
    if hi < 0 || hi >= ph.live.len() {
        return false;
    }
    var bit: i64 = 1 << r;
    return (ph.live.get(hi) & bit) == 0 || ((ph.wr.get(hi) | ph.cpy.get(hi)) & bit) != 0;
}

/// RA7: after the scan (and RA2), each integer range a move ties to an
/// argument register takes it when it fits (ng_arg_fit) and no range
/// given it before interferes: first the ranges the scan spilled, then
/// the others, each trying its registers in argument order; then, a few
/// rounds, the copy partners of a range now in an argument register try
/// that one. `lo`/`hi` are the hulls of the representatives (members have
/// lo -1). Returns how many ranges moved to an argument register.
fn ng_arg_hints(g: &NatGen, mir: &Vec<MInst>, mb: &MBlocks, lo: &Vec<i64>, hi: &Vec<i64>, crep: &mut Vec<i64>, rcls: &Vec<i64>, nv: i64, assign: &mut Vec<i64>) -> i64 {
    var cands: i64 = ng_arg_cands(g);
    if cands == 0 || nv <= 0 {
        return 0;
    }
    var blind: bool = ng_mutant("arghint") || g_ng_arg_blind;
    var ph: NgPhys = ng_ra7_info(g, mir, mb, cands);
    var n: i64 = mir.len();
    var want: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        want.push(0);
        i = i + 1;
    }
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        if m.op == MO_MOV {
            if m.r0 >= NG_VBASE && m.r0 - NG_VBASE < nv && m.r1 >= 0 && m.r1 < 64 && (cands & (1 << m.r1)) != 0 {
                var a: i64 = ng_find(crep, m.r0 - NG_VBASE);
                want.set(a, want.get(a) | (1 << m.r1));
            }
            if m.r1 >= NG_VBASE && m.r1 - NG_VBASE < nv && m.r0 >= 0 && m.r0 < 64 && (cands & (1 << m.r0)) != 0 {
                var a1: i64 = ng_find(crep, m.r1 - NG_VBASE);
                want.set(a1, want.get(a1) | (1 << m.r0));
            }
        }
        k = k + 1;
    }
    // the ranges each argument register holds
    var lists: Vec<Vec<i64>> = Vec::new();
    i = 0;
    while i < 64 {
        lists.push(Vec::new());
        i = i + 1;
    }
    var placed: i64 = 0;
    var pass: i64 = 0;
    while pass < 2 {
        i = 0;
        while i < nv {
            var spilled: bool = assign.get(i) == 0 - 1;
            if lo.get(i) >= 0 && want.get(i) != 0 && rcls.get(i) == NG_RC_INT && spilled == (pass == 0) && ng_find(crep, i) == i {
                var got: bool = false;
                var j: i64 = 0;
                while !got && j < g.td.nregargs && j < g.td.argregs.len() {
                    var r: i64 = g.td.argregs.get(j);
                    if r >= 0 && r < 64 && (want.get(i) & (cands & (1 << r))) != 0 && ng_arg_fit(&ph, r, lo.get(i), hi.get(i), blind) {
                        var lst: Vec<i64> = lists.get(r);
                        var free: bool = true;
                        var li: i64 = 0;
                        while free && li < lst.len() {
                            var w: i64 = lst.get(li);
                            if ng_gr_clash(lo.get(w), hi.get(w), lo.get(i), hi.get(i)) {
                                free = false;
                            }
                            li = li + 1;
                        }
                        if free {
                            lst.push(i);
                            lists.set(r, lst);
                            assign.set(i, r);
                            placed = placed + 1;
                            got = true;
                        }
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    // copy partners (a move between two values) of a range now in an
    // argument register try that register too
    var round: i64 = 0;
    var grew: bool = placed > 0;
    while grew && round < 4 {
        grew = false;
        k = 0;
        while k < n {
            var cm: MInst = mir.get(k);
            if cm.op == MO_MOV && cm.r0 >= NG_VBASE && cm.r1 >= NG_VBASE && cm.r0 - NG_VBASE < nv && cm.r1 - NG_VBASE < nv {
                var da: i64 = ng_find(crep, cm.r0 - NG_VBASE);
                var sa: i64 = ng_find(crep, cm.r1 - NG_VBASE);
                var t: i64 = 0;
                while da != sa && t < 2 {
                    var from: i64 = da;
                    var to: i64 = sa;
                    if t == 1 {
                        from = sa;
                        to = da;
                    }
                    var fr: i64 = assign.get(from);
                    var tr: i64 = assign.get(to);
                    var to_arg: bool = tr >= 0 && tr < 64 && (cands & (1 << tr)) != 0;
                    if fr >= 0 && fr < 64 && (cands & (1 << fr)) != 0 && !to_arg && lo.get(to) >= 0 && rcls.get(to) == NG_RC_INT && ng_arg_fit(&ph, fr, lo.get(to), hi.get(to), blind) {
                        var lst2: Vec<i64> = lists.get(fr);
                        var free2: bool = true;
                        var l2: i64 = 0;
                        while free2 && l2 < lst2.len() {
                            var w2: i64 = lst2.get(l2);
                            if ng_gr_clash(lo.get(w2), hi.get(w2), lo.get(to), hi.get(to)) {
                                free2 = false;
                            }
                            l2 = l2 + 1;
                        }
                        if free2 {
                            lst2.push(to);
                            lists.set(fr, lst2);
                            assign.set(to, fr);
                            placed = placed + 1;
                            grew = true;
                        }
                    }
                    t = t + 1;
                }
            }
            k = k + 1;
        }
        round = round + 1;
    }
    return placed;
}

// ---------------------------------------------------------------------------
// RA3: the argument registers for any range no clobbering call crosses.
// On x86-64 every caller-saved register is a fixed argument, result or
// scratch register (nat_target_desc), so the pools have none: rdi, rsi,
// rdx and rcx (RA7's candidates, ng_arg_cands) are free wherever no
// operation names them or uses them without naming them (RA7's table,
// ng_implicit_regs: calls, prologue, epilogue and vector operations; on
// x86-64 division, remainder, high multiply and the long copy for rdx,
// shifts by a register for rcx). RA7 gives one to a range a move ties to
// it; RA3, after RA7, to any integer range that fits (ng_arg_fit's model,
// as prefix counts: ng_af_prefix, ng_af_fit):
//   fill: each range the scan, RA2 and RA7 left spilled, the most costly
//     first, takes the first argument register it fits and no range there
//     shares a position with (hulls, ng_gr_clash);
//   trade: each callee-saved register whose ranges all fit argument
//     registers (so none crosses a call) gives them all up, unless a move
//     between two of them would stop being a move to itself. The register
//     is then free: its save goes away (a leaf may lose its frame,
//     ng_leaf_ok), and ng_mir_alloc runs RA2's allocation in holes again
//     so that a spilled range crossing a call may take it.
// A range live across a call still takes a callee-saved register or is
// split around the call (RA4, ng_mir_alloc_split). The allocation checker
// judges the result as it judges RA7's (ng_mir_check_args). On every
// target with RA7's candidates (FID_NAT_OFF=arghint: none);
// FID_NAT_OFF=argfree: no RA3 at all, FID_NAT_OFF=argtrade: no trade.
// FID_NAT_MUTATE=argfree ignores the implicit uses (a spilled value may
// then take an argument register across a call): the checker must reject
// that (tests/nattools/machine_ra3_check.sh, tests/nattools/argfree_unit.fd).
// ---------------------------------------------------------------------------

/// RA3: per register r of `cands`, two lists of n + 1 prefix counts over
/// the operations: in pimp[r] those before k that use r without naming it
/// (ph.imp), in pnam[r] those that write r by name or leave r's own value
/// live after them (ph.wr, ph.live, and ph.kill unless `blind`). Other
/// registers get empty lists.
fn ng_af_prefix(ph: &NgPhys, cands: i64, blind: bool, n: i64, pimp: &mut Vec<Vec<i64>>, pnam: &mut Vec<Vec<i64>>) {
    var r: i64 = 0;
    while r < 64 {
        var a: Vec<i64> = Vec::new();
        var b: Vec<i64> = Vec::new();
        if r < 62 && (cands & (1 << r)) != 0 {
            var bit: i64 = 1 << r;
            var ca: i64 = 0;
            var cb: i64 = 0;
            a.push(0);
            b.push(0);
            var k: i64 = 0;
            while k < n {
                if !blind && (ph.imp.get(k) & bit) != 0 {
                    ca = ca + 1;
                }
                var named: i64 = ph.live.get(k) | ph.wr.get(k);
                if !blind {
                    named = named | ph.kill.get(k);
                }
                if (named & bit) != 0 {
                    cb = cb + 1;
                }
                a.push(ca);
                b.push(cb);
                k = k + 1;
            }
        }
        pimp.push(a);
        pnam.push(b);
        r = r + 1;
    }
}

/// RA3: ng_arg_fit(ph, r, lo, hi, blind) from the prefix counts of
/// ng_af_prefix: no implicit use of r in [lo, hi], no write by name and no
/// own value of r live after any operation in [lo, hi).
fn ng_af_fit(ph: &NgPhys, pimp: &Vec<Vec<i64>>, pnam: &Vec<Vec<i64>>, r: i64, lo: i64, hi: i64) -> bool {
    if r < 0 || r >= pimp.len() || lo < 0 || hi < lo {
        return false;
    }
    var a: Vec<i64> = pimp.get(r);
    var b: Vec<i64> = pnam.get(r);
    if hi + 1 >= a.len() || hi >= b.len() {
        return false;
    }
    if a.get(hi + 1) - a.get(lo) != 0 {
        return false;
    }
    // (2g.88: and at hi, as ng_arg_fit)
    return b.get(hi) - b.get(lo) == 0 && ng_arg_fit_end(ph, r, hi);
}

/// RA3: no range of `lst` (other than v) shares a position with v's hull.
fn ng_af_free(lst: &Vec<i64>, lo: &Vec<i64>, hi: &Vec<i64>, v: i64) -> bool {
    var i: i64 = 0;
    while i < lst.len() {
        var w: i64 = lst.get(i);
        if w != v && ng_gr_clash(lo.get(w), hi.get(w), lo.get(v), hi.get(v)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// RA3: no range tentatively given register r (tv / tr: ranges and their
/// registers) shares a position with v's hull.
fn ng_af_free_t(tv: &Vec<i64>, tr: &Vec<i64>, r: i64, lo: &Vec<i64>, hi: &Vec<i64>, v: i64) -> bool {
    var i: i64 = 0;
    while i < tv.len() {
        var w: i64 = tv.get(i);
        if tr.get(i) == r && w != v && ng_gr_clash(lo.get(w), hi.get(w), lo.get(v), hi.get(v)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// RA3 (see above): after RA7, the spilled integer ranges take free
/// argument registers (fill), then callee-saved registers whose ranges all
/// fit argument registers give them up (trade). `lo`/`hi` are the hulls
/// of the representatives (members have lo -1). `out` gets three counts:
/// ranges filled, ranges traded, callee-saved registers freed. Returns
/// the ranges that moved to an argument register.
fn ng_arg_free(g: &NatGen, mir: &Vec<MInst>, mb: &MBlocks, lo: &Vec<i64>, hi: &Vec<i64>, crep: &mut Vec<i64>, rcls: &Vec<i64>, weight: &Vec<i64>, nv: i64, assign: &mut Vec<i64>, out: &mut Vec<i64>) -> i64 {
    out.push(0);
    out.push(0);
    out.push(0);
    var cands: i64 = ng_arg_cands(g);
    if cands == 0 || nv <= 0 || !ng_on("argfree") {
        return 0;
    }
    var blind: bool = ng_mutant("argfree") || g_ng_arg_blind;
    var ph: NgPhys = ng_ra7_info(g, mir, mb, cands);
    var n: i64 = mir.len();
    var pimp: Vec<Vec<i64>> = Vec::new();
    var pnam: Vec<Vec<i64>> = Vec::new();
    ng_af_prefix(&ph, cands, blind, n, &mut pimp, &mut pnam);
    // the candidate registers in argument order, and the ranges each holds
    var aregs: Vec<i64> = Vec::new();
    var j: i64 = 0;
    while j < g.td.nregargs && j < g.td.argregs.len() {
        var ar: i64 = g.td.argregs.get(j);
        if ar >= 0 && ar < 62 && (cands & (1 << ar)) != 0 {
            aregs.push(ar);
        }
        j = j + 1;
    }
    var lists: Vec<Vec<i64>> = Vec::new();
    var i: i64 = 0;
    while i < 64 {
        lists.push(Vec::new());
        i = i + 1;
    }
    i = 0;
    while i < nv {
        var a0: i64 = assign.get(i);
        if lo.get(i) >= 0 && a0 >= 0 && a0 < 62 && (cands & (1 << a0)) != 0 && ng_find(crep, i) == i {
            var l0: Vec<i64> = lists.get(a0);
            l0.push(i);
            lists.set(a0, l0);
        }
        i = i + 1;
    }
    // fill: the spilled integer ranges, the most costly first (at most 512)
    var cand: Vec<i64> = Vec::new();
    i = 0;
    while i < nv && cand.len() < 512 {
        if lo.get(i) >= 0 && hi.get(i) >= lo.get(i) && assign.get(i) == 0 - 1 && rcls.get(i) == NG_RC_INT && ng_find(crep, i) == i {
            cand.push(i);
        }
        i = i + 1;
    }
    if weight.len() == nv {
        i = 1;
        while i < cand.len() {
            var cv: i64 = cand.get(i);
            var cj: i64 = i - 1;
            while cj >= 0 && weight.get(cand.get(cj)) < weight.get(cv) {
                cand.set(cj + 1, cand.get(cj));
                cj = cj - 1;
            }
            cand.set(cj + 1, cv);
            i = i + 1;
        }
    }
    var filled: i64 = 0;
    var ci: i64 = 0;
    while ci < cand.len() {
        var v: i64 = cand.get(ci);
        var got: bool = false;
        var ri: i64 = 0;
        while !got && ri < aregs.len() {
            var r: i64 = aregs.get(ri);
            if ng_af_fit(&ph, &pimp, &pnam, r, lo.get(v), hi.get(v)) {
                var lr: Vec<i64> = lists.get(r);
                if ng_af_free(&lr, lo, hi, v) {
                    lr.push(v);
                    lists.set(r, lr);
                    assign.set(v, r);
                    filled = filled + 1;
                    got = true;
                }
            }
            ri = ri + 1;
        }
        ci = ci + 1;
    }
    // trade: each callee-saved register whose ranges all fit argument
    // registers gives them up
    var traded: i64 = 0;
    var freed: i64 = 0;
    if ng_on("argtrade") {
        // a copy partner of each representative (a move between the two),
        // whose register an owner tries first
        var part: Vec<i64> = Vec::new();
        var treg: Vec<i64> = Vec::new();
        i = 0;
        while i < nv {
            part.push(0 - 1);
            treg.push(0 - 1);
            i = i + 1;
        }
        var k: i64 = 0;
        while k < n {
            var pm: MInst = mir.get(k);
            if pm.op == MO_MOV && pm.r0 >= NG_VBASE && pm.r1 >= NG_VBASE && pm.r0 - NG_VBASE < nv && pm.r1 - NG_VBASE < nv {
                var pd: i64 = ng_find(crep, pm.r0 - NG_VBASE);
                var ps: i64 = ng_find(crep, pm.r1 - NG_VBASE);
                if pd != ps {
                    if part.get(pd) < 0 {
                        part.set(pd, ps);
                    }
                    if part.get(ps) < 0 {
                        part.set(ps, pd);
                    }
                }
            }
            k = k + 1;
        }
        var callee: Vec<i64> = ng_callee_saved(g);
        var ki: i64 = 0;
        while ki < callee.len() {
            var cr: i64 = callee.get(ki);
            var owners: Vec<i64> = Vec::new();
            i = 0;
            while i < nv {
                if lo.get(i) >= 0 && assign.get(i) == cr && ng_find(crep, i) == i {
                    owners.push(i);
                }
                i = i + 1;
            }
            var ok: bool = owners.len() > 0 && owners.len() <= 256;
            // by start
            i = 1;
            while ok && i < owners.len() {
                var ov: i64 = owners.get(i);
                var oj: i64 = i - 1;
                while oj >= 0 && lo.get(owners.get(oj)) > lo.get(ov) {
                    owners.set(oj + 1, owners.get(oj));
                    oj = oj - 1;
                }
                owners.set(oj + 1, ov);
                i = i + 1;
            }
            var tv: Vec<i64> = Vec::new();
            var tr: Vec<i64> = Vec::new();
            var oi: i64 = 0;
            while ok && oi < owners.len() {
                var o: i64 = owners.get(oi);
                var pr: i64 = 0 - 1;
                var po: i64 = part.get(o);
                if po >= 0 && treg.get(po) >= 0 {
                    pr = treg.get(po);
                }
                var tg: i64 = 0 - 1;
                // (-1: the partner's register first)
                var ti: i64 = 0 - 1;
                while tg < 0 && ti < aregs.len() {
                    var tr0: i64 = pr;
                    if ti >= 0 {
                        tr0 = aregs.get(ti);
                    }
                    if tr0 >= 0 && ng_af_fit(&ph, &pimp, &pnam, tr0, lo.get(o), hi.get(o)) {
                        var tl: Vec<i64> = lists.get(tr0);
                        if ng_af_free(&tl, lo, hi, o) && ng_af_free_t(&tv, &tr, tr0, lo, hi, o) {
                            tg = tr0;
                        }
                    }
                    ti = ti + 1;
                }
                if tg < 0 {
                    ok = false;
                } else {
                    tv.push(o);
                    tr.push(tg);
                    treg.set(o, tg);
                }
                oi = oi + 1;
            }
            // no move between two of them may stop being a move to itself
            k = 0;
            while ok && k < n {
                var mm: MInst = mir.get(k);
                if mm.op == MO_MOV && mm.r0 >= NG_VBASE && mm.r1 >= NG_VBASE && mm.r0 - NG_VBASE < nv && mm.r1 - NG_VBASE < nv {
                    var md: i64 = ng_find(crep, mm.r0 - NG_VBASE);
                    var ms: i64 = ng_find(crep, mm.r1 - NG_VBASE);
                    if md != ms && treg.get(md) >= 0 && treg.get(ms) >= 0 && treg.get(md) != treg.get(ms) {
                        ok = false;
                    }
                }
                k = k + 1;
            }
            oi = 0;
            while oi < tv.len() {
                var to: i64 = tv.get(oi);
                if ok {
                    var tg2: i64 = tr.get(oi);
                    assign.set(to, tg2);
                    var tl2: Vec<i64> = lists.get(tg2);
                    tl2.push(to);
                    lists.set(tg2, tl2);
                }
                treg.set(to, 0 - 1);
                oi = oi + 1;
            }
            if ok {
                traded = traded + tv.len();
                freed = freed + 1;
            }
            ki = ki + 1;
        }
    }
    out.set(0, filled);
    out.set(1, traded);
    out.set(2, freed);
    return filled + traded;
}

/// RA7: the first register of `mask` (within `cands`) a live value holds
/// (cnt: live values per register), or -1.
fn ng_arg_both(cnt: &Vec<i64>, mask: i64, cands: i64) -> i64 {
    var mm: i64 = mask & cands;
    var r: i64 = 0;
    while r < 64 {
        if (mm & (1 << r)) != 0 && cnt.get(r) > 0 {
            return r;
        }
        r = r + 1;
    }
    return 0 - 1;
}

/// RA7: the allocation checker's part for values in argument registers
/// (ng_mir_check calls it last): exact value liveness per instruction
/// (mi_liveness over every vreg) against the argument-register model
/// (ng_ra7_info). No operation may write an argument register by name or
/// use one without naming it while a live value holds it (nor use one
/// that holds an operand it reads or the value it defines), no value may
/// be defined into one whose own argument or result is still to be read,
/// and at no point may one hold a live value and a live argument or
/// result at once. "" when sound (or when no value holds one).
fn ng_mir_check_args(g: &NatGen, rec: &NatFnRec, mb: &MBlocks, al: &NatAlloc) -> str {
    var cands: i64 = ng_arg_cands(g);
    var nv: i64 = rec.nvreg - NG_VBASE;
    if cands == 0 || nv <= 0 {
        return "";
    }
    var any: bool = false;
    var i: i64 = 0;
    while i < nv {
        var a: i64 = al.assign.get(i);
        if a >= 0 && a < 64 && (cands & (1 << a)) != 0 {
            any = true;
        }
        i = i + 1;
    }
    if !any {
        return "";
    }
    var mir: Vec<MInst> = rec.mir;
    var ph: NgPhys = ng_ra7_info(g, &mir, mb, cands);
    var sel: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        sel.push(i);
        i = i + 1;
    }
    var words: i64 = (nv + 63) / 64;
    var lin: Vec<i64> = Vec::new();
    var lout: Vec<i64> = Vec::new();
    mi_liveness(&mir, mb, &sel, words, &mut lin, &mut lout);
    var b: i64 = 0;
    while b < mb.start.len() {
        var live: Vec<i64> = Vec::new();
        var cnt: Vec<i64> = Vec::new();
        i = 0;
        while i < 64 {
            cnt.push(0);
            i = i + 1;
        }
        i = 0;
        while i < words {
            live.push(lout.get(b * words + i));
            i = i + 1;
        }
        i = 0;
        while i < nv {
            var a0: i64 = al.assign.get(i);
            if (live.get(i / 64) & (1 << (i % 64))) != 0 && a0 >= 0 && a0 < 64 {
                cnt.set(a0, cnt.get(a0) + 1);
            }
            i = i + 1;
        }
        var plive: i64 = ph.live.get(mb.end.get(b));
        var eb: i64 = ng_arg_both(&cnt, plive, cands);
        if eb >= 0 {
            return rec.name + ": at the end of block " + int_to_str(b) + ", argument register " + int_to_str(eb) + " holds a live value and a live argument or result at once";
        }
        var k: i64 = mb.end.get(b);
        while k >= mb.start.get(b) {
            var m: MInst = mir.get(k);
            var w: i64 = ph.wr.get(k);
            // a register written by name (a move of the value it holds
            // writes that value again)
            if w != 0 && !(m.op == MO_MOV && m.r1 >= NG_VBASE && m.r1 - NG_VBASE < nv && al.assign.get(m.r1 - NG_VBASE) == m.r0) {
                var wb: i64 = ng_arg_both(&cnt, w, cands);
                if wb >= 0 {
                    return rec.name + ": instruction " + int_to_str(k) + " (" + mi_op_name(m.op) + ") writes argument register " + int_to_str(wb) + " while a live value holds it";
                }
            }
            var um: i64 = mi_use_mask(m.op);
            // a register used without being named
            var im: i64 = ph.imp.get(k);
            if im != 0 {
                var ib: i64 = ng_arg_both(&cnt, im, cands);
                if ib >= 0 {
                    return rec.name + ": instruction " + int_to_str(k) + " (" + mi_op_name(m.op) + ") uses argument register " + int_to_str(ib) + " without naming it while a live value holds it";
                }
                var f: i64 = 0;
                while f < 3 {
                    var v: i64 = mi_field(m, f);
                    if ((um & (1 << f)) != 0 || (f == 0 && mi_defines(m.op))) && v >= NG_VBASE && v - NG_VBASE < nv {
                        var ar: i64 = al.assign.get(v - NG_VBASE);
                        if ar >= 0 && ar < 64 && (im & (1 << ar)) != 0 {
                            return rec.name + ": instruction " + int_to_str(k) + " (" + mi_op_name(m.op) + ") has operand v" + int_to_str(v) + " in argument register " + int_to_str(ar) + ", which it uses without naming it";
                        }
                    }
                    f = f + 1;
                }
            }
            // a value defined into a register whose own argument or result
            // is still to be read
            if mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 - NG_VBASE < nv {
                var dr: i64 = al.assign.get(m.r0 - NG_VBASE);
                if dr >= 0 && dr < 64 && (cands & (1 << dr)) != 0 && (ph.live.get(k) & (1 << dr)) != 0 && !(m.op == MO_MOV && m.r1 == dr) {
                    return rec.name + ": instruction " + int_to_str(k) + " defines v" + int_to_str(m.r0) + " in argument register " + int_to_str(dr) + ", whose argument or result is still to be read";
                }
            }
            // live = (live - defs) + uses, for the values and for the
            // registers' own contents
            if mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 - NG_VBASE < nv {
                var d2: i64 = m.r0 - NG_VBASE;
                if (live.get(d2 / 64) & (1 << (d2 % 64))) != 0 {
                    live.set(d2 / 64, live.get(d2 / 64) & ~(1 << (d2 % 64)));
                    var a2: i64 = al.assign.get(d2);
                    if a2 >= 0 && a2 < 64 {
                        cnt.set(a2, cnt.get(a2) - 1);
                    }
                }
            }
            var f2: i64 = 0;
            while f2 < 3 {
                if (um & (1 << f2)) != 0 {
                    var u: i64 = mi_field(m, f2) - NG_VBASE;
                    if u >= 0 && u < nv && (live.get(u / 64) & (1 << (u % 64))) == 0 {
                        live.set(u / 64, live.get(u / 64) | (1 << (u % 64)));
                        var a3: i64 = al.assign.get(u);
                        if a3 >= 0 && a3 < 64 {
                            cnt.set(a3, cnt.get(a3) + 1);
                        }
                    }
                }
                f2 = f2 + 1;
            }
            plive = (plive & ~(w | ph.kill.get(k))) | ph.rd.get(k);
            var lb: i64 = ng_arg_both(&cnt, plive, cands);
            if lb >= 0 {
                return rec.name + ": before instruction " + int_to_str(k) + " (" + mi_op_name(m.op) + "), argument register " + int_to_str(lb) + " holds a live value and a live argument or result at once";
            }
            k = k - 1;
        }
        b = b + 1;
    }
    return "";
}

/// RA7: tests/nattools/arghint_unit.fd sets this to make the hints ignore
/// the implicit uses (as FID_NAT_MUTATE=arghint does).
var g_ng_arg_blind: bool = false;

/// RA7: hand-made MIR for the unit test: `flat` holds 7 numbers per
/// operation (op, r0, r1, r2, i0, i1, i2).
fn ng_unit_mir(flat: &Vec<i64>) -> Vec<MInst> {
    var mir: Vec<MInst> = Vec::new();
    var k: i64 = 0;
    while k + 6 < flat.len() {
        mir.push(MInst {
            op: flat.get(k), r0: flat.get(k + 1), r1: flat.get(k + 2), r2: flat.get(k + 3), i0: flat.get(k + 4), i1: flat.get(k + 5), i2: flat.get(k + 6)
        });
        k = k + 7;
    }
    return mir;
}

/// RA7: the argument-register hints (switched on here) on target `arch`
/// (NAT_A64, NAT_RV64, NAT_X64) for the hand-made function `flat` with `nv`
/// values (vregs 64..64+nv-1), every one first given register 20 (a pool
/// register stand-in) and its hull from its appearances; `blind` ignores
/// the implicit uses. Each value's register, then how many moved, for
/// tests/nattools/arghint_unit.fd.
pub fn nat_arghint_unit(arch: i64, flat: &Vec<i64>, nv: i64, blind: bool) -> Vec<i64> {
    g_ng_arghint = 2;
    g_ng_arg_blind = blind;
    var g: NatGen = NatGen_new(arch);
    var mir: Vec<MInst> = ng_unit_mir(flat);
    var lo: Vec<i64> = Vec::new();
    var hi: Vec<i64> = Vec::new();
    var crep: Vec<i64> = Vec::new();
    var rcls: Vec<i64> = Vec::new();
    var assign: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        lo.push(0 - 1);
        hi.push(0 - 1);
        crep.push(i);
        rcls.push(NG_RC_INT);
        assign.push(20);
        i = i + 1;
    }
    var k: i64 = 0;
    while k < mir.len() {
        var m: MInst = mir.get(k);
        var um: i64 = mi_use_mask(m.op);
        var f: i64 = 0;
        while f < 3 {
            var v: i64 = mi_field(m, f);
            if ((um & (1 << f)) != 0 || (f == 0 && mi_defines(m.op))) && v >= NG_VBASE && v - NG_VBASE < nv {
                ng_touch2(&mut lo, &mut hi, v, k);
            }
            f = f + 1;
        }
        k = k + 1;
    }
    var mb: MBlocks = mi_blocks(&mir);
    var n: i64 = ng_arg_hints(&g, &mir, &mb, &lo, &hi, &mut crep, &rcls, nv, &mut assign);
    g_ng_arg_blind = false;
    assign.push(n);
    return assign;
}

/// RA7: the checker's verdict (ng_mir_check_args: "" when sound) on the
/// hand-made function `flat` with the registers `assign` (one per value),
/// for tests/nattools/arghint_unit.fd.
pub fn nat_arghint_check_unit(arch: i64, flat: &Vec<i64>, nv: i64, assign: &Vec<i64>) -> str {
    g_ng_arghint = 2;
    var g: NatGen = NatGen_new(arch);
    var mir: Vec<MInst> = ng_unit_mir(flat);
    var a: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        a.push(assign.get(i));
        i = i + 1;
    }
    var rec: NatFnRec = NatFnRec {
        name: "unit", mir: mir, nvreg: NG_VBASE + nv, base_frame: 0, slots: Vec::new(), is_ct: false, sret_v: 0 - 1, sret_size: 0, secret: false
    };
    var mb: MBlocks = mi_blocks(&rec.mir);
    var al: NatAlloc = NatAlloc {
        assign: a, remat: Vec::new(), remat_val: Vec::new(), spill: Vec::new(), frame: 16, save_regs: Vec::new(), save_off: 0, mask: 0, err: "", cls: Vec::new()
    };
    return ng_mir_check_args(&g, &rec, &mb, &al);
}

/// RA3: the free argument registers (ng_arg_free, with RA7's candidates
/// switched on) on target `arch` for the hand-made function `flat` with
/// `nv` values (vregs 64..64+nv-1), each starting in the register `init`
/// gives it (-1: spilled), its hull from its appearances; `blind` ignores
/// the implicit uses (as FID_NAT_MUTATE=argfree). Each value's register,
/// then the ranges filled, traded and the callee-saved registers freed,
/// for tests/nattools/argfree_unit.fd (nat_arghint_check_unit judges it).
pub fn nat_argfree_unit(arch: i64, flat: &Vec<i64>, nv: i64, init: &Vec<i64>, blind: bool) -> Vec<i64> {
    g_ng_arghint = 2;
    g_ng_arg_blind = blind;
    var g: NatGen = NatGen_new(arch);
    var mir: Vec<MInst> = ng_unit_mir(flat);
    var lo: Vec<i64> = Vec::new();
    var hi: Vec<i64> = Vec::new();
    var crep: Vec<i64> = Vec::new();
    var rcls: Vec<i64> = Vec::new();
    var assign: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        lo.push(0 - 1);
        hi.push(0 - 1);
        crep.push(i);
        rcls.push(NG_RC_INT);
        assign.push(init.get(i));
        i = i + 1;
    }
    var k: i64 = 0;
    while k < mir.len() {
        var m: MInst = mir.get(k);
        var um: i64 = mi_use_mask(m.op);
        var f: i64 = 0;
        while f < 3 {
            var v: i64 = mi_field(m, f);
            if ((um & (1 << f)) != 0 || (f == 0 && mi_defines(m.op))) && v >= NG_VBASE && v - NG_VBASE < nv {
                ng_touch2(&mut lo, &mut hi, v, k);
            }
            f = f + 1;
        }
        k = k + 1;
    }
    var mb: MBlocks = mi_blocks(&mir);
    var weight: Vec<i64> = Vec::new();
    var out: Vec<i64> = Vec::new();
    ng_arg_free(&g, &mir, &mb, &lo, &hi, &mut crep, &rcls, &weight, nv, &mut assign, &mut out);
    g_ng_arg_blind = false;
    i = 0;
    while i < out.len() {
        assign.push(out.get(i));
        i = i + 1;
    }
    return assign;
}

// --- SP11: one function's allocation in an arena window -----------------
// With FID_FN_ARENA=1 (and a compiler built through C, whose runtime has
// allocator marks: compiler/inc.fd fn_arena_*), every allocation of one
// function's vregs runs in a window: its liveness, intervals, segments,
// interference, copy classes, weights, the checker's tables and every
// string it builds come from the arena, and the window's end gives them
// back in one step. Only the NatAlloc comes out, copied through the hold
// block (ng_alloc_keep / fn_arena_take_*). The rule of inc.fd holds for
// everything ng_mir_alloc_body reaches (checked over its call graph,
// Nov 17): it changes no container of g (no label, no insert or push) and
// no global container; what it sets is integers and flags (g_ng_fcs_*,
// g_ng_arghint, g_ng_fregs, g.wipe_on / wipe_regs / wipe_keep1) or
// g_ng_live_err, which it sets back to "" before it returns; it builds no
// table lazily.
// The containers made before the window that it takes an owner of are
// pinned (shared once before the window, the pin kept past its end):
// rec.mir (ng_mir_alloc_body, ng_mir_check, ng_mir_check_args), rec.slots,
// g.td.int_callee and g.td.int_caller (ng_class_pool), and RA4's
// g_ng_split_base / _orig / _src (ng_mir_check while a split function is
// allocated). The emission stays outside: it grows the image's containers
// (g.e's code, labels and fixups, the line and frame rows), which a
// window would give back. Without FID_FN_ARENA, or when a window cannot
// open (another one or a region open, no allocator marks), the allocation
// runs as before.

/// Allocate the vregs of one recorded function (SP11: in an arena window
/// with FID_FN_ARENA=1, see above).
fn ng_mir_alloc(g: &mut NatGen, rec: &NatFnRec) -> NatAlloc {
    if !fn_arena_on() {
        return ng_mir_alloc_body(g, rec);
    }
    var pin_mir: Vec<MInst> = rec.mir;
    var pin_slots: Vec<i64> = rec.slots;
    var pin_callee: Vec<i64> = g.td.int_callee;
    var pin_caller: Vec<i64> = g.td.int_caller;
    var pin_sbase: Vec<MInst> = g_ng_split_base;
    var pin_sorig: Vec<i64> = g_ng_split_orig;
    var pin_ssrc: Vec<i64> = g_ng_split_src;
    var m: i64 = fn_arena_begin();
    if m == 0 {
        return ng_mir_alloc_body(g, rec);
    }
    ng_alloc_keep(g, rec);
    fn_arena_end(m);
    var assign: Vec<i64> = fn_arena_take_words();
    var remat: Vec<i64> = fn_arena_take_words();
    var remat_val: Vec<i64> = fn_arena_take_words();
    var spill: Vec<i64> = fn_arena_take_words();
    var save_regs: Vec<i64> = fn_arena_take_words();
    var cls: Vec<i64> = fn_arena_take_words();
    var frame: i64 = fn_arena_take_word();
    var save_off: i64 = fn_arena_take_word();
    var mask: i64 = fn_arena_take_word();
    var err: str = fn_arena_take_str();
    return NatAlloc {
        assign: assign, remat: remat, remat_val: remat_val, spill: spill, frame: frame, save_regs: save_regs, save_off: save_off, mask: mask, err: err, cls: cls
    };
}

/// SP11: the allocation inside the window, its result copied out to the
/// hold block (in the order ng_mir_alloc takes it back).
/// MI8: give each vreg marked in `pack` an 8-byte frame slot from `base` up;
/// returns the first byte past them. Vregs whose linear position ranges
/// never overlap share a slot (a range covers every point the slot is
/// written or read). A vreg joins a slot only when its range is disjoint
/// from the range of EVERY vreg already in it: the Nov 21 first version
/// checked only the first disjoint vreg it found, so a third value could
/// land in a slot another live value still held (known-bugs 2g.115:
/// test_threads, test_fstring_float on --nat). A vreg with no range (lo <
/// 0) gets a slot of its own nobody shares; past 4096 vregs, a slot each
/// (the scan is quadratic in the spilled count).
fn ng_pack_spill_slots(spill: &mut Vec<i64>, pack: &Vec<i64>, lo: &Vec<i64>, hi: &Vec<i64>, nv: i64, base: i64) -> i64 {
    var cur: i64 = base;
    var s_off: Vec<i64> = Vec::new();
    var s_head: Vec<i64> = Vec::new();
    var s_ok: Vec<i64> = Vec::new();
    var m_next: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        m_next.push(0 - 1);
        i = i + 1;
    }
    i = 0;
    while i < nv {
        if pack.get(i) != 0 {
            var share: i64 = 0 - 1;
            var li: i64 = lo.get(i);
            var hi_i: i64 = hi.get(i);
            if i < 4096 && li >= 0 {
                var s: i64 = 0;
                while s < s_off.len() && share < 0 {
                    if s_ok.get(s) != 0 {
                        var fits: bool = true;
                        var k: i64 = s_head.get(s);
                        while k >= 0 && fits {
                            if !(hi_i < lo.get(k) || hi.get(k) < li) {
                                fits = false;
                            }
                            k = m_next.get(k);
                        }
                        if fits {
                            share = s;
                        }
                    }
                    s = s + 1;
                }
            }
            if share >= 0 {
                spill.set(i, s_off.get(share));
                m_next.set(i, s_head.get(share));
                s_head.set(share, i);
            } else {
                spill.set(i, cur);
                s_off.push(cur);
                s_head.push(i);
                if i < 4096 && li >= 0 {
                    s_ok.push(1);
                } else {
                    s_ok.push(0);
                }
                cur = cur + 8;
            }
        }
        i = i + 1;
    }
    return cur;
}

fn ng_alloc_keep(g: &mut NatGen, rec: &NatFnRec) {
    var a: NatAlloc = ng_mir_alloc_body(g, rec);
    fn_arena_keep_words(a.assign);
    fn_arena_keep_words(a.remat);
    fn_arena_keep_words(a.remat_val);
    fn_arena_keep_words(a.spill);
    fn_arena_keep_words(a.save_regs);
    fn_arena_keep_words(a.cls);
    fn_arena_keep_word(a.frame);
    fn_arena_keep_word(a.save_off);
    fn_arena_keep_word(a.mask);
    fn_arena_keep_str(a.err);
}

/// Allocate the vregs of one recorded function (the work itself).
fn ng_mir_alloc_body(g: &mut NatGen, rec: &NatFnRec) -> NatAlloc {
    var nv: i64 = rec.nvreg - NG_VBASE;
    var mir: Vec<MInst> = rec.mir;
    var n: i64 = mir.len();
    var mb: MBlocks = mi_blocks(&mir);
    var nb: i64 = mb.start.len();
    var lo: Vec<i64> = Vec::new();
    var hi: Vec<i64> = Vec::new();
    var first_b: Vec<i64> = Vec::new();
    var sel: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        lo.push(0 - 1);
        hi.push(0 - 1);
        first_b.push(0 - 1);
        sel.push(0 - 1);
        i = i + 1;
    }
    // Positions; a vreg seen in two blocks is global
    var ng: i64 = 0;
    var calls: Vec<i64> = Vec::new();
    var masks: Vec<i64> = Vec::new();
    var hint: Vec<i64> = Vec::new();
    var def_in: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        hint.push(0 - 1);
        def_in.push(0 - 1);
        i = i + 1;
    }
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        var bk: i64 = mb.of.get(k);
        var f: i64 = 0;
        var um: i64 = mi_use_mask(m.op);
        while f < 3 {
            var v: i64 = mi_field(m, f);
            var used: bool = (um & (1 << f)) != 0;
            var defd: bool = f == 0 && mi_defines(m.op);
            if (used || defd) && v >= NG_VBASE && v - NG_VBASE < nv {
                ng_touch2(&mut lo, &mut hi, v, k);
                var vi: i64 = v - NG_VBASE;
                var upward: bool = used && def_in.get(vi) != bk;
                if first_b.get(vi) < 0 {
                    first_b.set(vi, bk);
                }
                if (first_b.get(vi) != bk || upward) && sel.get(vi) < 0 {
                    sel.set(vi, ng);
                    ng = ng + 1;
                }
            }
            f = f + 1;
        }
        if mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 - NG_VBASE < nv {
            def_in.set(m.r0 - NG_VBASE, bk);
        }
        if mi_is_call(m.op) {
            calls.push(k);
            masks.push(ng_call_mask_i(g, &mir, &mb, k));
        }
        if m.op == MO_MOV && m.r0 >= NG_VBASE && m.r1 >= NG_VBASE && ng_on("hint") {
            if m.r0 - NG_VBASE < nv && m.r1 - NG_VBASE < nv {
                hint.set(m.r0 - NG_VBASE, m.r1 - NG_VBASE);
                if hint.get(m.r1 - NG_VBASE) < 0 {
                    hint.set(m.r1 - NG_VBASE, m.r0 - NG_VBASE);
                }
            }
        }
        k = k + 1;
    }
    // RA14: the fast allocator of debug builds: no liveness fixed point, no
    // coalescing, no spill weights. A value that lives in more than one
    // block (sel >= 0) stays in its frame slot (each use loads it, each
    // definition stores it); the values local to a block, whose ranges
    // the positions above give exactly, share the registers by one linear
    // scan.
    var fast: bool = ng_fast_alloc_on();
    // RA2: the block liveness (from use lists, ng_alloc_liveness), kept
    // for the segments (ng_class_segs)
    var a_words: i64 = 0;
    var lout: Vec<i64> = Vec::new();
    if ng > 0 && nb > 0 && !fast {
        var words: i64 = (ng + 63) / 64;
        a_words = words;
        var lin: Vec<i64> = Vec::new();
        ng_alloc_liveness(&mir, &mb, &sel, words, &mut lin, &mut lout);
        var gv: Vec<i64> = Vec::new();
        i = 0;
        while i < ng {
            gv.push(0);
            i = i + 1;
        }
        i = 0;
        while i < nv {
            if sel.get(i) >= 0 {
                gv.set(sel.get(i), i);
            }
            i = i + 1;
        }
        var b: i64 = 0;
        while b < nb {
            var gi: i64 = 0;
            while gi < ng {
                var bit: i64 = 1 << (gi % 64);
                var at: i64 = b * words + gi / 64;
                if (lin.get(at) & bit) != 0 {
                    ng_touch2(&mut lo, &mut hi, gv.get(gi) + NG_VBASE, mb.start.get(b));
                }
                if (lout.get(at) & bit) != 0 {
                    ng_touch2(&mut lo, &mut hi, gv.get(gi) + NG_VBASE, mb.end.get(b));
                }
                gi = gi + 1;
            }
            b = b + 1;
        }
    }

    // Copy coalescing (RA, aggressive within the hulls): d <- s share one
    // vreg when one of them never changes while the other lives: d's only
    // definition is this copy and s is not defined inside d's range, or s
    // has a single definition and d is not defined inside s's range (but
    // by this copy). The representative takes the union of the ranges;
    // the members get its register or slot after the scan, and the copy
    // becomes a move to itself, which emits nothing. The checker sees the
    // same thing (a move into the register its source holds).
    // `FID_NAT_OFF=coalesce`.
    var crep: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        crep.push(i);
        i = i + 1;
    }
    var n_coal: i64 = 0;
    if ng_on("coalesce") && !fast {
        var defs: Vec<Vec<i64>> = Vec::new();
        i = 0;
        while i < nv {
            defs.push(Vec::new());
            i = i + 1;
        }
        k = 0;
        while k < n {
            var dm: MInst = mir.get(k);
            if mi_defines(dm.op) && dm.r0 >= NG_VBASE && dm.r0 - NG_VBASE < nv {
                var dl: Vec<i64> = defs.get(dm.r0 - NG_VBASE);
                dl.push(k);
                defs.set(dm.r0 - NG_VBASE, dl);
            }
            k = k + 1;
        }
        k = 0;
        while k < n {
            var cm: MInst = mir.get(k);
            // (RA4: not the moves that join a value to its pieces)
            if cm.op == MO_MOV && cm.r0 >= NG_VBASE && cm.r1 >= NG_VBASE && cm.r0 - NG_VBASE < nv && cm.r1 - NG_VBASE < nv && !ng_split_pair(cm.r0, cm.r1) {
                var cd: i64 = ng_find(&mut crep, cm.r0 - NG_VBASE);
                var cs: i64 = ng_find(&mut crep, cm.r1 - NG_VBASE);
                if cd != cs && lo.get(cd) >= 0 && lo.get(cs) >= 0 {
                    var ddefs: Vec<i64> = defs.get(cd);
                    var sdefs: Vec<i64> = defs.get(cs);
                    var ok: bool = false;
                    if ddefs.len() == 1 && ddefs.get(0) == k && !ng_any_in(sdefs, lo.get(cd), hi.get(cd), 0 - 1) {
                        ok = true;
                    }
                    // (s's definition and the copy in one block: every way
                    // on from s's definition reaches the copy, so d, unread
                    // between them, is dead where s is written. Across
                    // blocks a way past the copy can still read d's older
                    // value, which s's definition would overwrite: found by
                    // tests/nattools/split_alloc_unit.fd; RA6's round
                    // below, over exact liveness, takes those copies.)
                    if !ok && sdefs.len() == 1 && sdefs.get(0) < k && mb.of.get(sdefs.get(0)) == mb.of.get(k) && !ng_any_in(ddefs, lo.get(cs), hi.get(cs), k) && !ng_class_read(&mir, &mut crep, cd, sdefs.get(0) + 1, k, nv) {
                        ok = true;
                    }
                    if ok {
                        crep.set(cd, cs);
                        if lo.get(cd) < lo.get(cs) {
                            lo.set(cs, lo.get(cd));
                        }
                        if hi.get(cd) > hi.get(cs) {
                            hi.set(cs, hi.get(cd));
                        }
                        var md: i64 = 0;
                        while md < ddefs.len() {
                            sdefs.push(ddefs.get(md));
                            md = md + 1;
                        }
                        defs.set(cs, sdefs);
                        n_coal = n_coal + 1;
                    }
                }
            }
            k = k + 1;
        }
        // RA6: a second round over exact liveness. A copy d <- s the
        // first round left alone (each side is written while the other's
        // hull lasts: in `i = i + 1` the sum's temporary is copied from i,
        // stepped, and copied back, all inside i's hull) still shares one
        // register when the two classes never interfere: no instruction
        // writes one while the other is live after it (a copy between
        // them aside: both then hold one value), each block walked back
        // from its live-out set (ng_classes_interfere). Only when one hull
        // holds the other, so the union is the larger hull and no other
        // range meets more pressure; only within one register class.
        // `FID_NAT_OFF=livecoal`.
        if ng_on("livecoal") && nb > 0 {
            var xw: i64 = (ng + 63) / 64;
            var xin: Vec<i64> = Vec::new();
            var xout: Vec<i64> = Vec::new();
            if ng > 0 {
                ng_alloc_liveness(&mir, &mb, &sel, xw, &mut xin, &mut xout);
            }
            // (the classes of the copy classes the first round made)
            var xcls: Vec<i64> = ng_mir_classes_c(g, &mir, nv, &mut crep);
            k = 0;
            while k < n {
                var xm: MInst = mir.get(k);
                if xm.op == MO_MOV && xm.r0 >= NG_VBASE && xm.r1 >= NG_VBASE && xm.r0 - NG_VBASE < nv && xm.r1 - NG_VBASE < nv && !ng_split_pair(xm.r0, xm.r1) {
                    var xd: i64 = ng_find(&mut crep, xm.r0 - NG_VBASE);
                    var xs: i64 = ng_find(&mut crep, xm.r1 - NG_VBASE);
                    if xd != xs && lo.get(xd) >= 0 && lo.get(xs) >= 0 && xcls.get(xd) == xcls.get(xs) {
                        var big: i64 = 0 - 1;
                        var small: i64 = 0 - 1;
                        if lo.get(xs) <= lo.get(xd) && hi.get(xs) >= hi.get(xd) {
                            big = xs;
                            small = xd;
                        } else if lo.get(xd) <= lo.get(xs) && hi.get(xd) >= hi.get(xs) {
                            big = xd;
                            small = xs;
                        }
                        if big >= 0 && !ng_classes_interfere(&mir, &mb, &sel, xw, &xout, &mut crep, xd, xs, lo.get(small), hi.get(small), nv) {
                            crep.set(small, big);
                            n_coal = n_coal + 1;
                        }
                    }
                }
                k = k + 1;
            }
        }
        // members leave the scan; their representative stands for them
        i = 0;
        while i < nv {
            if ng_find(&mut crep, i) != i {
                lo.set(i, 0 - 1);
            }
            i = i + 1;
        }
    }

    // Rematerialization (RA8): a vreg (with its coalesced members) defined
    // once, by a constant (MO_LI), the address of a global (MO_ADDR) or the
    // address of a frame slot (MO_SLOTADDR: sp does not move inside a
    // body), is never stored: a spilled one is computed again where it is
    // used (ng_ld_spilled), and costs nothing to spill. The kinds are the
    // NG_REMAT_* constants; 2 marks "defined by anything else" while
    // counting. `FID_NAT_OFF=remat`.
    var remat: Vec<i64> = Vec::new();
    var remat_val: Vec<i64> = Vec::new();
    var rdefs: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        remat.push(0);
        remat_val.push(0);
        rdefs.push(0);
        i = i + 1;
    }
    if ng_on("remat") {
        // MI8: a move between two vregs of one copy class (coalesced: it
        // moves nothing) is not a definition of the class, so `val k = C`
        // (li, then a move into the local's vreg) is rematerialized and,
        // spilled, takes no slot. `FID_NAT_OFF=rematmov`: every move counts.
        var rm_mov: bool = ng_on("rematmov");
        k = 0;
        while k < n {
            var rm: MInst = mir.get(k);
            var rm_same: bool = false;
            if rm_mov && rm.op == MO_MOV && rm.r0 >= NG_VBASE && rm.r0 - NG_VBASE < nv && rm.r1 >= NG_VBASE && rm.r1 - NG_VBASE < nv {
                rm_same = ng_find(&mut crep, rm.r0 - NG_VBASE) == ng_find(&mut crep, rm.r1 - NG_VBASE);
            }
            if !rm_same && mi_defines(rm.op) && rm.r0 >= NG_VBASE && rm.r0 - NG_VBASE < nv {
                var rr: i64 = ng_find(&mut crep, rm.r0 - NG_VBASE);
                rdefs.set(rr, rdefs.get(rr) + 1);
                var rk: i64 = ng_remat_kind(rm.op);
                if rk > 0 {
                    remat.set(rr, rk);
                    remat_val.set(rr, rm.i0);
                } else {
                    remat.set(rr, 2);
                }
            }
            k = k + 1;
        }
        i = 0;
        while i < nv {
            var rr2: i64 = ng_find(&mut crep, i);
            var ok2: bool = rdefs.get(rr2) == 1 && ng_remat_is(remat.get(rr2));
            if rr2 == i {
                if !ok2 {
                    remat.set(i, 0);
                }
            }
            i = i + 1;
        }
        i = 0;
        while i < nv {
            var rr3: i64 = ng_find(&mut crep, i);
            if rr3 != i {
                remat.set(i, remat.get(rr3));
                remat_val.set(i, remat_val.get(rr3));
            }
            i = i + 1;
        }
    }

    // Spill weights (RA5): each use or definition counts 8^(loop depth), the
    // loops being the ranges [label, jump back to it]; the cheapest range
    // is the one to spill (`FID_NAT_OFF=weights`: the range ending last)
    var weights_on: bool = ng_on("weights") && !fast;
    var weight: Vec<i64> = Vec::new();
    if weights_on {
        // OP30: blocks a profiled run never entered weigh 1 per use
        // (`FID_NAT_OFF=pgoweights`: loop depth only)
        var pcold_w: i64 = 0;
        if g_pgo_use_path != "" && ng_on("pgoweights") {
            pcold_w = ng_pgo_cold_labels(rec.name, &mir);
        }
        weight = ng_spill_weights(&mir, nv, pcold_w);
        if n_coal > 0 {
            i = 0;
            while i < nv {
                var wr: i64 = ng_find(&mut crep, i);
                if wr != i {
                    weight.set(wr, weight.get(wr) + weight.get(i));
                }
                i = i + 1;
            }
        }
        i = 0;
        while i < nv {
            if ng_remat_is(remat.get(i)) {
                weight.set(i, 1);
            }
            i = i + 1;
        }
        // LF20: a secret value is the last to spill (ng_secret_weights)
        var n_sec: i64 = ng_secret_weights(rec, nv, &mut crep, &remat, &mut weight);
        if n_sec > 0 && ng_alloc_dump_wanted(rec.name) && !g_ng_split_trial {
            p_eprint_str("[mir] " + rec.name + ": " + int_to_str(n_sec) + " secret values weigh more than any other\n");
        }
    }

    // RA10 / MI25: the register class of each value, decided per copy
    // class (a coalesced class is one value). The float classes' ranges
    // leave the integer scan here (flo keeps their starts) and take the
    // float pool's registers after it (ng_float_assign); nothing changes
    // while the float pool is empty (FID_NAT_OFF=fregs, ng_fregs_on).
    var rcls: Vec<i64> = ng_mir_classes_c(g, &mir, nv, &mut crep);
    var flo: Vec<i64> = Vec::new();
    var n_fl: i64 = 0;
    i = 0;
    while i < nv {
        flo.push(0 - 1);
        if rcls.get(i) != NG_RC_INT && lo.get(i) >= 0 {
            flo.set(i, lo.get(i));
            lo.set(i, 0 - 1);
            n_fl = n_fl + 1;
        }
        i = i + 1;
    }

    // RA14: in the fast mode the values that cross blocks leave the scan
    // (they are given their slots below)
    var fast_slot: Vec<i64> = Vec::new();
    // CE8: `-g` (g_nat_dbg_frames): the source variables of a function with
    // debug rows leave the scan too (a slot of their own each, below), so
    // a panic finds their values in the frame (ng_dbg_frame_vregs)
    var dbg_slot: Vec<i64> = ng_dbg_frame_vregs(rec.name, nv, &mut crep);
    var n_dbg_slot: i64 = 0;
    i = 0;
    while i < nv {
        fast_slot.push(0);
        if fast && sel.get(i) >= 0 && lo.get(i) >= 0 {
            fast_slot.set(i, 1);
            lo.set(i, 0 - 1);
        }
        if dbg_slot.len() > i && dbg_slot.get(i) != 0 && (lo.get(i) >= 0 || flo.get(i) >= 0) {
            fast_slot.set(i, 1);
            lo.set(i, 0 - 1);
            flo.set(i, 0 - 1);
            n_dbg_slot = n_dbg_slot + 1;
        }
        i = i + 1;
    }

    // Linear scan in order of start
    var count: Vec<i64> = Vec::new();
    i = 0;
    while i <= n + 1 {
        count.push(0);
        i = i + 1;
    }
    i = 0;
    while i < nv {
        if lo.get(i) >= 0 {
            count.set(lo.get(i) + 1, count.get(lo.get(i) + 1) + 1);
        }
        i = i + 1;
    }
    i = 1;
    while i < count.len() {
        count.set(i, count.get(i) + count.get(i - 1));
        i = i + 1;
    }
    var order: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        order.push(0 - 1);
        i = i + 1;
    }
    var total: i64 = 0;
    i = 0;
    while i < nv {
        if lo.get(i) >= 0 {
            var slot: i64 = count.get(lo.get(i));
            order.set(slot, i);
            count.set(lo.get(i), slot + 1);
            total = total + 1;
        }
        i = i + 1;
    }
    var assign: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        assign.push(0 - 2);
        i = i + 1;
    }
    var caller: Vec<i64> = ng_pool_caller(g);
    var callee: Vec<i64> = ng_callee_saved(g);
    var busy: Vec<i64> = Vec::new();
    i = 0;
    while i < 32 {
        busy.push(0);
        i = i + 1;
    }
    // RA9: the copy hints by coalescing representative (a member's move
    // ties its representative to the other side's), for the greedy
    // allocator, which sees representatives only
    var ghint: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        ghint.push(0 - 1);
        i = i + 1;
    }
    i = 0;
    while i < nv {
        var gh: i64 = hint.get(i);
        if gh >= 0 && gh < nv {
            var gr: i64 = ng_find(&mut crep, i);
            var ghr: i64 = ng_find(&mut crep, gh);
            if gr != ghr && ghint.get(gr) < 0 {
                ghint.set(gr, ghr);
            }
        }
        i = i + 1;
    }
    // RA2: the ranges as segments with holes (ng_class_segs, exact per
    // instruction) for the scan and the greedy allocator, which then
    // interfere only where both are live; empty (hulls) with
    // FID_NAT_OFF=holes or FID_NAT_OFF=segscan, and in the fast mode
    var seg_on: bool = !fast && nb > 0 && total > 0 && ng_on("holes") && ng_on("segscan");
    var segs: Vec<Vec<i64>> = Vec::new();
    if seg_on {
        segs = ng_class_segs(&mir, &mb, &sel, a_words, &lout, &mut crep, nv);
    }
    // RA9: FID_NAT_ON=greedycmp with --stats (the linear scan allocates):
    // the greedy assignment on a copy, compared with the scan's after it
    // (an `[ra9]` line per function: spills and their weight, each way)
    var cmp_on: bool = !fast && g_nat_stats && ng_opt_in("greedycmp") && !ng_opt_in("greedy");
    var cmp_assign: Vec<i64> = Vec::new();
    var cmp_ev: i64 = 0;
    if cmp_on {
        i = 0;
        while i < nv {
            cmp_assign.push(0 - 2);
            i = i + 1;
        }
        cmp_ev = ng_greedy_assign(g, &lo, &hi, &segs, &ghint, &weight, &calls, &masks, nv, &mut cmp_assign);
    }
    // RA9: the greedy allocator in place of the scan (FID_NAT_ON=greedy;
    // not with the fast allocator of debug builds)
    if !fast && ng_opt_in("greedy") {
        var n_ev: i64 = ng_greedy_assign(g, &lo, &hi, &segs, &ghint, &weight, &calls, &masks, nv, &mut assign);
        if g_nat_stats {
            var n_sp: i64 = 0;
            var gi2: i64 = 0;
            while gi2 < nv {
                if lo.get(gi2) >= 0 && assign.get(gi2) == 0 - 1 {
                    n_sp = n_sp + 1;
                }
                gi2 = gi2 + 1;
            }
            p_eprint_str("[greedy] " + rec.name + ": " + int_to_str(total) + " ranges, " + int_to_str(n_ev) + " evictions, " + int_to_str(n_sp) + " spilled before holes\n");
        }
        total = 0;
    }
    // RA2: the linear scan over segments with holes (ng_seg_scan) in
    // place of the one over hulls below
    var seg_done: bool = false;
    if seg_on && total > 0 {
        var n_sev: i64 = ng_seg_scan(g, &order, total, &lo, &hi, &segs, &ghint, &weight, weights_on, &calls, &masks, nv, &mut assign);
        seg_done = true;
        if g_nat_stats {
            var n_holed: i64 = 0;
            var n_ssp: i64 = 0;
            var si2: i64 = 0;
            while si2 < total {
                var sv: i64 = order.get(si2);
                var svs: Vec<i64> = segs.get(sv);
                if svs.len() > 2 {
                    n_holed = n_holed + 1;
                }
                if assign.get(sv) == 0 - 1 {
                    n_ssp = n_ssp + 1;
                }
                si2 = si2 + 1;
            }
            p_eprint_str("[segs] " + rec.name + ": " + int_to_str(total) + " ranges, " + int_to_str(n_holed) + " with holes, " + int_to_str(n_sev) + " evictions, " + int_to_str(n_ssp) + " spilled before holes\n");
        }
    }
    var active: Vec<i64> = Vec::new();
    var oi: i64 = 0;
    while oi < total && !seg_done {
        var v2: i64 = order.get(oi);
        var st: i64 = lo.get(v2);
        // Expire: a range ending where this one starts gives its register
        // up (every operation reads its operands before it writes)
        var kept: Vec<i64> = Vec::new();
        var ai: i64 = 0;
        while ai < active.len() {
            var a: i64 = active.get(ai);
            if hi.get(a) <= st && assign.get(a) >= 0 {
                busy.set(assign.get(a), 0);
            } else {
                kept.push(a);
            }
            ai = ai + 1;
        }
        active = kept;
        var r: i64 = 0 - 1;
        var h: i64 = hint.get(v2);
        if h >= 0 && assign.get(h) >= 0 && busy.get(assign.get(h)) == 0 && ng_reg_ok(g, assign.get(h), lo.get(v2), hi.get(v2), &calls, &masks) {
            r = assign.get(h);
        }
        var ci: i64 = 0;
        while r < 0 && ci < caller.len() {
            var c: i64 = caller.get(ci);
            if busy.get(c) == 0 && ng_reg_ok(g, c, lo.get(v2), hi.get(v2), &calls, &masks) {
                r = c;
            }
            ci = ci + 1;
        }
        var ki: i64 = 0;
        while r < 0 && ki < callee.len() {
            if busy.get(callee.get(ki)) == 0 {
                r = callee.get(ki);
            }
            ki = ki + 1;
        }
        if r < 0 && weights_on {
            // The cheapest active range whose register suits this one gives
            // it up when it costs less than this one, else this one spills
            var cheap: i64 = 0 - 1;
            var wi: i64 = 0;
            while wi < active.len() {
                var wc: i64 = active.get(wi);
                if assign.get(wc) >= 0 && ng_reg_ok(g, assign.get(wc), lo.get(v2), hi.get(v2), &calls, &masks) {
                    if cheap < 0 || weight.get(wc) < weight.get(active.get(cheap)) {
                        cheap = wi;
                    }
                }
                wi = wi + 1;
            }
            if cheap >= 0 && weight.get(active.get(cheap)) < weight.get(v2) {
                var wl: i64 = active.get(cheap);
                r = assign.get(wl);
                assign.set(wl, 0 - 1);
                active.set(cheap, v2);
                assign.set(v2, r);
            } else {
                assign.set(v2, 0 - 1);
            }
        } else if r < 0 {
            // The active range that ends last gives up its register if it
            // ends after this one and the register suits this one
            var far: i64 = 0 - 1;
            var fi: i64 = 0;
            while fi < active.len() {
                var cand: i64 = active.get(fi);
                if assign.get(cand) >= 0 && hi.get(cand) > hi.get(v2) && ng_reg_ok(g, assign.get(cand), lo.get(v2), hi.get(v2), &calls, &masks) {
                    if far < 0 || hi.get(cand) > hi.get(active.get(far)) {
                        far = fi;
                    }
                }
                fi = fi + 1;
            }
            if far >= 0 {
                var loser: i64 = active.get(far);
                r = assign.get(loser);
                assign.set(loser, 0 - 1);
                active.set(far, v2);
                assign.set(v2, r);
            } else {
                assign.set(v2, 0 - 1);
            }
        } else {
            assign.set(v2, r);
            busy.set(r, 1);
            active.push(v2);
        }
        oi = oi + 1;
    }
    if cmp_on {
        // RA9: the scan's spills against the greedy assignment's, before
        // RA2 gives either a second chance (weight: the spill weights,
        // RA5, or the hull's length when they are off)
        var c_ls: i64 = 0;
        var c_lw: i64 = 0;
        var c_gs: i64 = 0;
        var c_gw: i64 = 0;
        i = 0;
        while i < nv {
            if lo.get(i) >= 0 {
                var cw: i64 = hi.get(i) - lo.get(i) + 1;
                if weight.len() == nv {
                    cw = weight.get(i);
                }
                if assign.get(i) == 0 - 1 {
                    c_ls = c_ls + 1;
                    c_lw = c_lw + cw;
                }
                if cmp_assign.get(i) == 0 - 1 {
                    c_gs = c_gs + 1;
                    c_gw = c_gw + cw;
                }
            }
            i = i + 1;
        }
        p_eprint_str("[ra9] " + rec.name + ": " + int_to_str(total) + " ranges; linear scan spills " + int_to_str(c_ls) + " (weight " + int_to_str(c_lw) + "), greedy " + int_to_str(c_gs) + " (weight " + int_to_str(c_gw) + ", " + int_to_str(cmp_ev) + " evictions)\n");
    }

    // RA2: the ranges the scan spilled, again over segments with holes
    if !fast && ng_on("holes") && nb > 0 {
        var n_holes: i64 = ng_alloc_holes(g, &mir, &mb, &sel, ng, &mut crep, &mut assign, &remat, &weight, &calls, &masks, nv, &segs);
        if g_nat_stats && n_holes > 0 {
            p_eprint_str("[holes] " + rec.name + ": " + int_to_str(n_holes) + " spilled ranges given a register\n");
        }
    }

    // RA7: a value a move ties to an argument register takes it where
    // nothing else needs it (ng_arg_hints; FID_NAT_OFF=arghint: never). After the
    // scan and RA2, so their pools never see these registers.
    if !fast && nb > 0 && ng_arg_cands(g) != 0 {
        var n_ah: i64 = ng_arg_hints(g, &mir, &mb, &lo, &hi, &mut crep, &rcls, nv, &mut assign);
        if g_nat_stats && n_ah > 0 {
            p_eprint_str("[arghint] " + rec.name + ": " + int_to_str(n_ah) + " ranges in argument registers\n");
        }
    }

    // RA3: after RA7, any integer range no call crosses may take a free
    // argument register: the spilled ones first, then the ranges of a
    // callee-saved register that all fit (ng_arg_free; FID_NAT_OFF=argfree:
    // none). A callee-saved register so freed may take a spilled range
    // that crosses a call: RA2's allocation in holes runs again.
    if !fast && nb > 0 && ng_arg_cands(g) != 0 {
        var af: Vec<i64> = Vec::new();
        var n_af: i64 = ng_arg_free(g, &mir, &mb, &lo, &hi, &mut crep, &rcls, &weight, nv, &mut assign, &mut af);
        var n_af_h: i64 = 0;
        if n_af > 0 && af.get(2) > 0 && ng_on("holes") {
            n_af_h = ng_alloc_holes(g, &mir, &mb, &sel, ng, &mut crep, &mut assign, &remat, &weight, &calls, &masks, nv, &segs);
        }
        if g_nat_stats && n_af > 0 {
            p_eprint_str("[argfree] " + rec.name + ": " + int_to_str(af.get(0)) + " spilled ranges in argument registers, " + int_to_str(af.get(1)) + " ranges moved off " + int_to_str(af.get(2)) + " callee-saved registers, " + int_to_str(n_af_h) + " spilled ranges then given one\n");
        }
    }

    if fast || n_dbg_slot > 0 {
        i = 0;
        while i < nv {
            if fast_slot.get(i) != 0 {
                assign.set(i, 0 - 1);
            }
            i = i + 1;
        }
    }

    // MI25: the float ranges, over the float pool
    if n_fl > 0 {
        var n_fa: i64 = ng_float_assign(g, &flo, &hi, &weight, &calls, &sel, fast, n, nv, &mut assign);
        if g_nat_stats {
            p_eprint_str("[fregs] " + rec.name + ": " + int_to_str(n_fl) + " float ranges, " + int_to_str(n_fa) + " in float registers\n");
            if g_ng_fcs_last > 0 {
                // RA18
                p_eprint_str("[fcallee] " + rec.name + ": " + int_to_str(g_ng_fcs_last) + " float ranges across calls in callee-saved float registers\n");
            }
        }
        i = 0;
        while i < nv {
            if flo.get(i) >= 0 {
                lo.set(i, flo.get(i));
            }
            i = i + 1;
        }
    }

    // RA10: a register outside the pool of a value's class (the class its
    // copy class has: rcls) is given up: the value spills (a slot holds
    // any class). While the float pool is empty every value is an integer
    // and nothing changes.
    i = 0;
    while i < nv {
        var cr: i64 = i;
        if n_coal > 0 {
            cr = ng_find(&mut crep, i);
        }
        if assign.get(cr) >= 0 && !ng_class_has(g, rcls.get(i), assign.get(cr)) {
            assign.set(cr, 0 - 1);
        }
        i = i + 1;
    }

    // Coalesced members: their representative's register (or slot, below)
    if n_coal > 0 {
        i = 0;
        while i < nv {
            var ar: i64 = ng_find(&mut crep, i);
            if ar != i {
                assign.set(i, assign.get(ar));
            }
            i = i + 1;
        }
    }

    // Spill slots: a new one for each spilled vreg (MI8: IR values have no
    // frame room of their own; `FID_NAT_OFF=frameslots`: an IR value's own
    // slot, as before)
    var spill: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        spill.push(0 - 1);
        i = i + 1;
    }
    var cur: i64 = rec.base_frame;
    var own_slots: bool = !ng_on("frameslots");
    var pack: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        pack.push(0);
        i = i + 1;
    }
    i = 0;
    while i < nv {
        if assign.get(i) == 0 - 1 {
            if own_slots && i < rec.slots.len() && rec.slots.get(i) >= 0 {
                spill.set(i, rec.slots.get(i));
            } else if !own_slots && ng_remat_is(remat.get(i)) {
                // MI8: a rematerialized vreg (with its coalesced members,
                // which share its kind) is computed again at each use and
                // never stored (ng_ld_spilled, ng_mir_emit_pass's skip_def):
                // no slot
                spill.set(i, 0 - 1);
            } else if !own_slots && n_coal > 0 && ng_find(&mut crep, i) != i {
                // MI8: a coalesced vreg takes its representative's slot
                // (set below), none of its own
                spill.set(i, 0 - 1);
            } else {
                // MI8 (Nov 21): packed below (ng_pack_spill_slots)
                pack.set(i, 1);
            }
        }
        i = i + 1;
    }
    cur = ng_pack_spill_slots(&mut spill, &pack, &lo, &hi, nv, cur);
    if n_coal > 0 {
        i = 0;
        while i < nv {
            var sr: i64 = ng_find(&mut crep, i);
            if sr != i && assign.get(i) == 0 - 1 {
                spill.set(i, spill.get(sr));
            }
            i = i + 1;
        }
    }
    var save: Vec<i64> = Vec::new();
    var mask: i64 = 0;
    var used: Vec<i64> = Vec::new();
    i = 0;
    // (64: float registers are NG_FREG + f, MI25)
    while i < 64 {
        used.push(0);
        i = i + 1;
    }
    i = 0;
    while i < nv {
        if assign.get(i) >= 0 {
            used.set(assign.get(i), 1);
        }
        i = i + 1;
    }
    i = 0;
    while i < callee.len() {
        if used.get(callee.get(i)) != 0 {
            save.push(callee.get(i));
        }
        i = i + 1;
    }
    // RA18: the callee-saved float registers it uses, after the integer
    // ones (stp d pairs on AArch64: ng_save_subset). FID_NAT_MUTATE=fcallee
    // (TG2): not saved, on purpose
    var fcs: Vec<i64> = ng_float_callee_pool(g);
    i = 0;
    while i < fcs.len() && !ng_mutant("fcallee") {
        if used.get(fcs.get(i)) != 0 {
            save.push(fcs.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < caller.len() {
        if used.get(caller.get(i)) != 0 {
            mask = mask | (1 << caller.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < masks.len() {
        mask = mask | masks.get(i);
        i = i + 1;
    }
    // MI8 (Nov 21 evening): RA2/RA7/RA3 above may have rescued spilled
    // ranges into registers (argfree's trade moved 242 ranges off the
    // callee-saved pair in test_machine_frame's `big`, whose frame was
    // 1952 bytes with 0 spills left). A rescued range's slot is never
    // touched again (codegen reads spill only of assign == -1 values), so
    // the frame is re-packed over the still-spilled ones — disjoint
    // ranges share, as in the first packing. FID_NAT_OFF=frameslots keeps
    // the old per-value layout (own_slots).
    if !own_slots {
        i = 0;
        while i < nv {
            spill.set(i, 0 - 1);
            if assign.get(i) == 0 - 1 && !ng_remat_is(remat.get(i)) && !(n_coal > 0 && ng_find(& mut crep, i) != i) {
                pack.set(i, 1);
            } else {
                pack.set(i, 0);
            }
            i = i + 1;
        }
        var cur2: i64 = ng_pack_spill_slots(&mut spill, &pack, &lo, &hi, nv, rec.base_frame);
        if n_coal > 0 {
            i = 0;
            while i < nv {
                var sr: i64 = ng_find(& mut crep, i);
                if sr != i && assign.get(i) == 0 - 1 {
                    spill.set(i, spill.get(sr));
                }
                i = i + 1;
            }
        }
        cur = cur2;
    }
    var save_off: i64 = cur;
    cur = cur + 8 * save.len();
    var frame: i64 = (cur + 15) & (0 - 16);
    if frame < 16 {
        frame = 16;
    }
    // LF20 (`--stats`): the secret values that took a register, and the
    // registers each return zeroes
    if g_nat_stats && rec.secret {
        ng_secret_stats(g, rec, nv, &assign, &remat, mask);
    }
    var al: NatAlloc = NatAlloc {
        assign: assign, remat: remat, remat_val: remat_val, spill: spill, frame: frame, save_regs: save, save_off: save_off, mask: mask, err: "", cls: rcls
    };
    if ng_verify_on() {
        // MI8 (FID_VERIFY=1): every spilled vreg that is stored has a slot
        // inside the frame below the save area; a rematerialized one has
        // none (with frame slots on)
        i = 0;
        while i < nv && al.err == "" {
            if assign.get(i) == 0 - 1 {
                var vsl: i64 = al.spill.get(i);
                if ng_remat_is(remat.get(i)) {
                    if !own_slots && vsl >= 0 {
                        al.err = "MI8: rematerialized v" + int_to_str(i + NG_VBASE) + " has a spill slot at " + int_to_str(vsl);
                    }
                } else if vsl < 0 || vsl + 8 > save_off {
                    al.err = "MI8: spilled v" + int_to_str(i + NG_VBASE) + " has no slot in the frame (" + int_to_str(vsl) + ", save area at " + int_to_str(save_off) + ")";
                }
            }
            i = i + 1;
        }
    }
    // MI11: FID_NAT_DUMP=<function> (or `*`: every function; main.fd may
    // set g_nat_dump instead) prints the function's MIR with its allocation
    var dump: str = ng_env_dump();
    var dump_on: bool = g_nat_dump == rec.name || g_nat_dump == "*";
    if (dump as i64) != 0 && str_len(dump) > 0 && (dump == rec.name || dump == "*") {
        dump_on = true;
    }
    if g_ng_split_trial {
        // RA4: an allocation ng_mir_alloc_split may throw away
        dump_on = false;
    }
    if dump_on {
        p_eprint_str("[mir] " + rec.name + ": " + int_to_str(n) + " operations, frame " + int_to_str(frame) + "\n");
        var dk: i64 = 0;
        while dk < n {
            var dm: MInst = mir.get(dk);
            var line: str = int_to_str(dk) + ": " + mi_op_name(dm.op);
            var df: i64 = 0;
            while df < 3 {
                var dv: i64 = mi_field(dm, df);
                if dv >= NG_VBASE && dv - NG_VBASE < nv {
                    line = line + " v" + int_to_str(dv) + "=r" + int_to_str(assign.get(dv - NG_VBASE)) + "[" + int_to_str(lo.get(dv - NG_VBASE)) + "," + int_to_str(hi.get(dv - NG_VBASE)) + "]";
                } else {
                    line = line + " p" + int_to_str(dv);
                }
                df = df + 1;
            }
            line = line + " i " + int_to_str(dm.i0) + " " + int_to_str(dm.i1);
            p_eprint_str("[mir] " + line + "\n");
            dk = dk + 1;
        }
    }
    // RA2 (FID_VERIFY=1): the use-list liveness of this function's passes
    // against the block fixed point
    if g_ng_live_err != "" {
        if al.err == "" {
            al.err = rec.name + ": " + g_ng_live_err;
        }
        g_ng_live_err = "";
    }
    if ng_verify_on() && al.err == "" {
        al.err = ng_mir_check(g, rec, &mb, &al, &calls, &masks);
    }
    return al;
}

// --- RA4: allocation with live-range splitting ------------------------------

/// RA4: while a split function is allocated (ng_mir_alloc_split): each
/// piece's value (vreg - NG_VBASE -> vreg, -1: no piece), each
/// instruction's original index (-1: inserted) and the machine IR before
/// the split, for the coalescer (ng_split_pair) and the checker
/// (ng_mir_check -> ng_split_check). Empty otherwise.
var g_ng_split_orig: Vec<i64> = Vec::new();
var g_ng_split_src: Vec<i64> = Vec::new();
var g_ng_split_base: Vec<MInst> = Vec::new();
/// RA4: an allocation that may be thrown away prints nothing (no
/// `--stats` lines, no FID_NAT_DUMP listing): the one kept is run again
/// when they were asked for.
var g_ng_split_trial: bool = false;
/// RA4 unit hooks (nat_split_alloc_unit): the checkers on as with
/// FID_VERIFY=1; g_ng_split_unit_mode 0: not in a unit hook (the switches
/// decide), 1: the default, 2: the split forced off, 3: every value split
/// and kept (as FID_NAT_ON=splitall); and what the last split made, while
/// g_ng_split_unit_mode is set: [pieces, around loops,
/// edge blocks, cost without, cost with, kept (1/0), candidates, values
/// left whole by the second split] and why
/// the planner made nothing (NgSplit.err).
var g_ng_verify_unit: bool = false;
var g_ng_split_unit_mode: i64 = 0;
var g_ng_split_last: Vec<i64> = Vec::new();
var g_ng_split_why: str = "";

/// RA4: a move between a value and one of its pieces (or two pieces of one
/// value), which the coalescer must leave alone: the pieces exist to take
/// registers or slots of their own.
fn ng_split_pair(a: i64, b: i64) -> bool {
    var n: i64 = g_ng_split_orig.len();
    if n == 0 {
        return false;
    }
    var ai: i64 = a - NG_VBASE;
    var bi: i64 = b - NG_VBASE;
    if ai < 0 || bi < 0 || ai >= n || bi >= n {
        return false;
    }
    var oa: i64 = g_ng_split_orig.get(ai);
    var ob: i64 = g_ng_split_orig.get(bi);
    return oa == b || ob == a || (oa >= 0 && oa == ob);
}

fn ng_split_globals_clear() {
    g_ng_split_orig = Vec::new();
    g_ng_split_src = Vec::new();
    g_ng_split_base = Vec::new();
}

/// RA4: FID_NAT_DUMP names this function (the listing ng_mir_alloc prints).
fn ng_alloc_dump_wanted(name: str) -> bool {
    if g_nat_dump == name || g_nat_dump == "*" {
        return true;
    }
    var dump: str = ng_env_dump();
    return (dump as i64) != 0 && str_len(dump) > 0 && (dump == name || dump == "*");
}

/// RA4: ng_mir_alloc printing nothing (g_ng_split_trial).
fn ng_alloc_quiet(g: &mut NatGen, rec: &NatFnRec) -> NatAlloc {
    var stats: bool = g_nat_stats;
    g_nat_stats = false;
    g_ng_split_trial = true;
    var al: NatAlloc = ng_mir_alloc(g, rec);
    g_nat_stats = stats;
    g_ng_split_trial = false;
    return al;
}

// --- LF20: secret values the last to spill ---------------------------------
// "Never spilled to memory where a register will do": in a function holding
// a secret, the values that carry one weigh more than every other value
// (1 << 40 on top of their RA5 spill weight), so the linear scan, the
// greedy allocator (RA9), the second chance in holes (RA2), the free
// argument registers (RA3) and the float pass (MI25) give a register to a
// secret value before any other and spill one only when nothing else is
// left to spill. The secret values (ng_secret_ids) start at the front
// end's marks the IR carries per value: the slots of @zeroize locals
// (IrFunction.zeroize_locals) and the values of @secret / @sensitive
// parameters and slots of such locals (IrFunction.secret_values, Nov 18);
// what is loaded from one, stored into one,
// or computed from a secret value (any operand) is secret too, to a fixed
// point over the function. A piece of a split value (RA4) is as secret as
// the value. They are noted per function when it is lowered
// (ng_secret_note: "<name>:<vreg>" -> 1, "<name>" -> how many) and read by
// the allocator (ng_secret_weights). `FID_NAT_OFF=secretregs`: the weights
// as they were. Only with spill weights (RA5, `weights`; not the fast
// allocator of RA14, which has none). `--stats` prints an `[lf20]` line
// per secret function: its secret values, how many took a register, and
// the registers each return zeroes (ng_wipe_regs).
var g_ng_sec: i64 = 0;

/// LF20: 1 for each IR value of `func` (ids below n) that holds a secret
/// (see above).
fn ng_secret_ids(func: &IrFunction, n: i64) -> Vec<i64> {
    var sec: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        sec.push(0);
        i = i + 1;
    }
    var seeds: i64 = 0;
    i = 0;
    while i < func.zeroize_locals.len() {
        var zid: i64 = func.zeroize_locals.get(i).id;
        if zid >= 0 && zid < n {
            sec.set(zid, 1);
            seeds = seeds + 1;
        }
        i = i + 1;
    }
    // the front end's per-value list (IrFunction.secret_values): the
    // @secret / @sensitive parameters' values and locals' slots
    i = 0;
    while i < func.secret_values.len() {
        var sv: i64 = func.secret_values.get(i);
        if sv >= 0 && sv < n {
            sec.set(sv, 1);
            seeds = seeds + 1;
        }
        i = i + 1;
    }
    if seeds == 0 {
        return sec;
    }
    var ops: Vec<i64> = Vec::new();
    var changed: bool = true;
    var round: i64 = 0;
    while changed && round < 16 {
        changed = false;
        round = round + 1;
        var k: i64 = 0;
        while k < func.insts.len() {
            var ve: ValueIdInst = func.insts.get(k);
            var id: i64 = ve.id;
            var handled: bool = false;
            match ve.inst {
                Inst::Store(p, v, _) => {
                    // a secret stored makes the place secret; what is
                    // stored into a secret place is secret
                    handled = true;
                    if p >= 0 && p < n && v >= 0 && v < n {
                        if sec.get(v) != 0 && sec.get(p) == 0 {
                            sec.set(p, 1);
                            changed = true;
                        }
                        if sec.get(p) != 0 && sec.get(v) == 0 {
                            sec.set(v, 1);
                            changed = true;
                        }
                    }
                }
                Inst::StructCopy(d, s, _) => {
                    handled = true;
                    if d >= 0 && d < n && s >= 0 && s < n && sec.get(s) != 0 && sec.get(d) == 0 {
                        sec.set(d, 1);
                        changed = true;
                    }
                }
                Inst::Alloca(_, _) => {
                    handled = true;
                }
                _ => {
                }
            }
            if !handled && id >= 0 && id < n && sec.get(id) == 0 {
                ops.clear();
                ng_inst_operands(ve.inst, &mut ops);
                var j: i64 = 0;
                while j < ops.len() {
                    var u: i64 = ops.get(j);
                    if u >= 0 && u < n && sec.get(u) != 0 {
                        sec.set(id, 1);
                        changed = true;
                        j = ops.len();
                    }
                    j = j + 1;
                }
            }
            k = k + 1;
        }
    }
    return sec;
}

/// LF20: note the secret values of function `name` (its IR, n values) for
/// the allocator (ng_secret_weights).
fn ng_secret_note(name: str, func: &IrFunction, n: i64) {
    var sec: Vec<i64> = ng_secret_ids(func, n);
    var c: i64 = 0;
    var i: i64 = 0;
    while i < sec.len() {
        if sec.get(i) != 0 {
            if g_ng_sec == 0 {
                g_ng_sec = HashMap_new();
            }
            HashMap_insert(g_ng_sec, name + ":" + int_to_str(NG_VBASE + i), 1);
            c = c + 1;
        }
        i = i + 1;
    }
    if g_ng_sec != 0 {
        HashMap_insert(g_ng_sec, name, c);
    }
}

/// LF20: function `name` has secret values noted.
fn ng_secret_has(name: str) -> bool {
    return g_ng_sec != 0 && HashMap_contains(g_ng_sec, name) && HashMap_get(g_ng_sec, name) > 0;
}

/// LF20: vreg index i of function `name`, being allocated, holds a secret
/// (a piece of a split value as that value, RA4: g_ng_split_orig).
fn ng_secret_at(name: str, i: i64) -> bool {
    var v: i64 = NG_VBASE + i;
    if i < g_ng_split_orig.len() && g_ng_split_orig.get(i) >= NG_VBASE {
        v = g_ng_split_orig.get(i);
    }
    return HashMap_contains(g_ng_sec, name + ":" + int_to_str(v));
}

/// LF20: raise the spill weight of each secret value of `rec` (and of its
/// copy class's representative, which the scan allocates) above every
/// other weight; a rematerialized value is left alone (it is recomputed,
/// never stored). The number of secret values raised.
fn ng_secret_weights(rec: &NatFnRec, nv: i64, crep: &mut Vec<i64>, remat: &Vec<i64>, weight: &mut Vec<i64>) -> i64 {
    if !rec.secret || weight.len() != nv || !ng_on("secretregs") || !ng_secret_has(rec.name) {
        return 0;
    }
    var big: i64 = 1 << 40;
    var c: i64 = 0;
    var i: i64 = 0;
    while i < nv {
        if !ng_remat_is(remat.get(i)) && ng_secret_at(rec.name, i) {
            var r: i64 = ng_find(crep, i);
            weight.set(r, weight.get(r) + big);
            if r != i {
                weight.set(i, weight.get(i) + big);
            }
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

/// LF20 (`--stats`): `[lf20] <fn>: S secret values, R in registers; each
/// return zeroes W registers` (mask: the function's clobber mask).
fn ng_secret_stats(g: &mut NatGen, rec: &NatFnRec, nv: i64, assign: &Vec<i64>, remat: &Vec<i64>, mask: i64) {
    var s: i64 = 0;
    var r: i64 = 0;
    if ng_secret_has(rec.name) {
        var i: i64 = 0;
        while i < nv {
            if !ng_remat_is(remat.get(i)) && ng_secret_at(rec.name, i) {
                s = s + 1;
                if assign.get(i) >= 0 {
                    r = r + 1;
                }
            }
            i = i + 1;
        }
    }
    ng_wipe_setup(g, rec, mask);
    var w: i64 = 0;
    if g.wipe_on {
        w = ng_wipe_reg_count(g);
    }
    p_eprint_str("[lf20] " + rec.name + ": " + int_to_str(s) + " secret values, " + int_to_str(r) + " in registers; each return zeroes " + int_to_str(w) + " registers\n");
}

/// RA4: the loop depth of each instruction (each jump back to a label
/// placed before it is one loop over the indices between), as the spill
/// weights count it (ng_spill_weights).
fn ng_loop_depths(mir: &Vec<MInst>) -> Vec<i64> {
    var n: i64 = mir.len();
    var place: i64 = HashMap_new();
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        if m.op == MO_PLACE {
            HashMap_insert_i(place, m.i0, k);
        }
        k = k + 1;
    }
    var diff: Vec<i64> = Vec::new();
    k = 0;
    while k <= n {
        diff.push(0);
        k = k + 1;
    }
    k = 0;
    while k < n {
        var m2: MInst = mir.get(k);
        if mi_is_br(m2.op) && HashMap_contains_i(place, m2.i0) {
            var at: i64 = HashMap_get_i(place, m2.i0);
            if at < k {
                diff.set(at, diff.get(at) + 1);
                diff.set(k + 1, diff.get(k + 1) - 1);
            }
        }
        k = k + 1;
    }
    var out: Vec<i64> = Vec::new();
    var depth: i64 = 0;
    k = 0;
    while k < n {
        depth = depth + diff.get(k);
        out.push(depth);
        k = k + 1;
    }
    return out;
}

/// RA4: the estimated cost of running `mir` under allocation `al`, each
/// instruction weighted 8^(loop depth) (depth at most 4): 2 for each
/// access of a spilled value's slot (rematerialized values aside), 1 for
/// a move between two registers and for each jump, and 2 for each
/// callee-saved register the prologue saves.
@wrapping
fn ng_split_cost(mir: &Vec<MInst>, al: &NatAlloc, nv: i64) -> i64 {
    var depth: Vec<i64> = ng_loop_depths(mir);
    var c: i64 = 0;
    var k: i64 = 0;
    while k < mir.len() {
        var d: i64 = depth.get(k);
        if d > 4 {
            d = 4;
        }
        if d < 0 {
            d = 0;
        }
        var w: i64 = 1 << (3 * d);
        var m: MInst = mir.get(k);
        var counted: bool = true;
        if m.op == MO_MOV && !ng_mov_emits(m, al, nv) {
            counted = false;
        }
        if counted {
            var um: i64 = mi_use_mask(m.op);
            var f: i64 = 0;
            while f < 3 {
                var v: i64 = mi_field(m, f);
                var touched: bool = (um & (1 << f)) != 0 || (f == 0 && mi_defines(m.op));
                if touched && v >= NG_VBASE && v - NG_VBASE < nv {
                    var vi: i64 = v - NG_VBASE;
                    if al.assign.get(vi) == 0 - 1 && !ng_remat_is(al.remat.get(vi)) {
                        c = c + 2 * w;
                    }
                }
                f = f + 1;
            }
            if m.op == MO_MOV && m.r0 >= NG_VBASE && m.r1 >= NG_VBASE && m.r0 - NG_VBASE < nv && m.r1 - NG_VBASE < nv {
                if al.assign.get(m.r0 - NG_VBASE) >= 0 && al.assign.get(m.r1 - NG_VBASE) >= 0 {
                    c = c + w;
                }
            }
        }
        if m.op == MO_JMP {
            c = c + w;
        }
        k = k + 1;
    }
    return c + 2 * al.save_regs.len();
}

/// RA4: the allocation without the split, printed again when `loud`.
fn ng_alloc_unsplit(g: &mut NatGen, rec: &NatFnRec, al: NatAlloc, loud: bool) -> NatAlloc {
    if loud {
        return ng_mir_alloc(g, rec);
    }
    return al;
}

/// RA4: allocate `rec`; when values spill, split them (ng_split_plan) and
/// allocate the split function, which replaces `rec`'s machine IR when it
/// costs less (ng_split_cost; always with FID_NAT_ON=splitall). With
/// `--stats` a `[split] <fn>: ...` line tells what was split and whether it
/// was kept. `FID_NAT_OFF=split`: ng_mir_alloc alone.
fn ng_mir_alloc_split(g: &mut NatGen, rec: &mut NatFnRec) -> NatAlloc {
    // (MI27: no split moves on the fall-throughs of a jump table's entries)
    if !ng_on("split") || g_ng_split_unit_mode == 2 || ng_fast_alloc_on() || rec.is_ct || rec.mir.len() == 0 || mi_has_jtab(&rec.mir) {
        return ng_mir_alloc(g, rec);
    }
    var all: bool = ng_opt_in("splitall") || g_ng_split_unit_mode == 3;
    var loud: bool = g_nat_stats || ng_alloc_dump_wanted(rec.name);
    var al: NatAlloc = ng_alloc_quiet(g, rec);
    if al.err != "" {
        return al;
    }
    var nv: i64 = rec.nvreg - NG_VBASE;
    var cand: Vec<i64> = Vec::new();
    var ncand: i64 = 0;
    // MI14: floats too (no float register is callee-saved, so a float
    // live across a call spills for its whole range, ng_float_assign; its
    // pieces between the calls and in call-free loops take float
    // registers). FID_NAT_OFF=splitfloat: integers only.
    var split_fl: bool = ng_on("splitfloat");
    var i: i64 = 0;
    while i < nv {
        var cn: i64 = 0;
        var pick: bool = al.assign.get(i) == 0 - 1;
        if all {
            pick = al.assign.get(i) != 0 - 2;
        }
        var cls_ok: bool = al.cls.get(i) == NG_RC_INT || (split_fl && (al.cls.get(i) == NG_RC_FLOAT || al.cls.get(i) == NG_RC_F32));
        if pick && !ng_remat_is(al.remat.get(i)) && cls_ok && i + NG_VBASE != rec.sret_v {
            cn = 1;
            ncand = ncand + 1;
        }
        cand.push(cn);
        i = i + 1;
    }
    if g_ng_split_unit_mode != 0 {
        var l0: Vec<i64> = Vec::new();
        var z: i64 = 0;
        while z < 6 {
            l0.push(0);
            z = z + 1;
        }
        l0.push(ncand);
        g_ng_split_last = l0;
    }
    if ncand == 0 {
        return ng_alloc_unsplit(g, rec, al, loud);
    }
    var label0: i64 = g.e.labels.len();
    var sp: NgSplit = ng_split_plan(&rec.mir, rec.nvreg, &cand, label0, ng_mutant("split"));
    if g_ng_split_unit_mode != 0 {
        g_ng_split_why = sp.err;
    }
    if sp.n_split == 0 {
        if g_nat_stats && sp.err != "" {
            p_eprint_str("[split] " + rec.name + ": not split: " + sp.err + "\n");
        }
        return ng_alloc_unsplit(g, rec, al, loud);
    }
    var li: i64 = 0;
    while li < sp.n_edges {
        var lab: i64 = NatEnc_label(&mut g.e);
        if lab != label0 + li {
            return ng_alloc_unsplit(g, rec, al, loud);
        }
        li = li + 1;
    }
    var rs: NatFnRec = NatFnRec {
        name: rec.name, mir: sp.mir, nvreg: sp.nvreg, base_frame: rec.base_frame, slots: rec.slots, is_ct: rec.is_ct, sret_v: rec.sret_v, sret_size: rec.sret_size, secret: rec.secret
    };
    if ng_verify_on() {
        // MI10's verifier on what the split made
        var verr: str = ng_mir_verify(g, &rs);
        if verr != "" {
            al.err = "live-range split: MIR verifier: " + verr;
            return al;
        }
    }
    var base: Vec<MInst> = rec.mir;
    g_ng_split_orig = sp.orig;
    g_ng_split_src = sp.src;
    g_ng_split_base = base;
    var al2: NatAlloc = ng_alloc_quiet(g, &rs);
    ng_split_globals_clear();
    if al2.err != "" {
        return al2;
    }
    var c1: i64 = ng_split_cost(&base, &al, nv);
    var c2: i64 = ng_split_cost(&rs.mir, &al2, rs.nvreg - NG_VBASE);
    // A value none of whose pieces took a register gained only moves (the
    // pieces of one loop can crowd each other out of a small caller-saved
    // pool, RISC-V's t4): split once more without such values and keep the
    // cheaper of the two splits. Not with splitall (every value split).
    // FID_NAT_OFF=splitprune: the first split only.
    var n_pruned: i64 = 0;
    if !all && ng_on("splitprune") {
        var has: Vec<i64> = Vec::new();
        i = 0;
        while i < nv {
            has.push(0);
            i = i + 1;
        }
        var pj: i64 = 0;
        while pj < sp.orig.len() && pj < al2.assign.len() {
            var po: i64 = sp.orig.get(pj);
            if po >= NG_VBASE && po - NG_VBASE < nv && al2.assign.get(pj) >= 0 {
                has.set(po - NG_VBASE, 1);
            }
            pj = pj + 1;
        }
        var cand2: Vec<i64> = Vec::new();
        var n2: i64 = 0;
        i = 0;
        while i < nv {
            var c2n: i64 = 0;
            if cand.get(i) == 1 && has.get(i) == 1 {
                c2n = 1;
                n2 = n2 + 1;
            }
            cand2.push(c2n);
            i = i + 1;
        }
        if n2 > 0 && n2 < ncand {
            var label1: i64 = g.e.labels.len();
            var sp2: NgSplit = ng_split_plan(&base, rec.nvreg, &cand2, label1, ng_mutant("split"));
            var lab_ok: bool = sp2.n_split > 0;
            var lj: i64 = 0;
            while lab_ok && lj < sp2.n_edges {
                var lab2: i64 = NatEnc_label(&mut g.e);
                if lab2 != label1 + lj {
                    lab_ok = false;
                }
                lj = lj + 1;
            }
            if lab_ok {
                var rs2: NatFnRec = NatFnRec {
                    name: rec.name, mir: sp2.mir, nvreg: sp2.nvreg, base_frame: rec.base_frame, slots: rec.slots, is_ct: rec.is_ct, sret_v: rec.sret_v, sret_size: rec.sret_size, secret: rec.secret
                };
                if ng_verify_on() {
                    var verr2: str = ng_mir_verify(g, &rs2);
                    if verr2 != "" {
                        al.err = "live-range split: MIR verifier: " + verr2;
                        return al;
                    }
                }
                g_ng_split_orig = sp2.orig;
                g_ng_split_src = sp2.src;
                g_ng_split_base = base;
                var al2b: NatAlloc = ng_alloc_quiet(g, &rs2);
                ng_split_globals_clear();
                if al2b.err != "" {
                    return al2b;
                }
                var c2b: i64 = ng_split_cost(&rs2.mir, &al2b, rs2.nvreg - NG_VBASE);
                if c2b < c2 {
                    n_pruned = ncand - n2;
                    sp = sp2;
                    rs = rs2;
                    al2 = al2b;
                    c2 = c2b;
                }
            }
        }
    }
    var keep: bool = c2 < c1 || all;
    if g_ng_split_unit_mode != 0 {
        var last: Vec<i64> = Vec::new();
        last.push(sp.n_split);
        last.push(sp.n_loops);
        last.push(sp.n_edges);
        last.push(c1);
        last.push(c2);
        if keep {
            last.push(1);
        } else {
            last.push(0);
        }
        last.push(ncand);
        last.push(n_pruned);
        g_ng_split_last = last;
    }
    if g_nat_stats {
        var verdict: str = "kept";
        if !keep {
            verdict = "not kept";
        }
        var pruned: str = "";
        if n_pruned > 0 {
            pruned = int_to_str(n_pruned) + " values left whole, ";
        }
        p_eprint_str("[split] " + rec.name + ": " + int_to_str(sp.n_split) + " pieces (" + int_to_str(sp.n_loops) + " around loops), " + int_to_str(sp.n_edges) + " edge blocks, " + pruned + "cost " + int_to_str(c1) + " -> " + int_to_str(c2) + ", " + verdict + "\n");
    }
    if !keep {
        return ng_alloc_unsplit(g, rec, al, loud);
    }
    rec.mir = rs.mir;
    rec.nvreg = rs.nvreg;
    ng_dbg_split_note(rec.name, &sp.orig);
    if loud {
        g_ng_split_orig = sp.orig;
        g_ng_split_src = sp.src;
        g_ng_split_base = base;
        var al3: NatAlloc = ng_mir_alloc(g, rec);
        ng_split_globals_clear();
        return al3;
    }
    return al2;
}

// --- RA4: live-range splitting -------------------------------------------
// A value the allocator spilled is split into pieces where that helps, and
// the function is allocated again (ng_mir_alloc_split):
//   around loops: in the largest call-free natural loop that reads or
//     writes it, the value is a vreg of its own; it is loaded on each edge
//     that enters the loop's head from outside (the preheader) and, when
//     the loop writes it, stored back on each edge that leaves the loop to a
//     block where it is still live (the exits);
//   at calls: inside one block, a run of two or more reads or writes with
//     no call (nor prologue or epilogue) between them is a vreg of its own,
//     loaded before the first read and stored after the last write when the
//     value is live after the run.
// A piece is an ordinary vreg joined to the value by moves, so it takes its
// own register or slot (the allocator does not coalesce these moves:
// ng_split_pair), and the checker sees ordinary machine IR; ng_split_check
// (FID_VERIFY=1, from ng_mir_check) also proves the split program reads,
// at every read, a vreg that holds the value the original read. The moves
// on one edge are one parallel move (nat_enc.fd nat_par_moves): before a
// jump that is the edge's only way, after the last instruction of a block
// that falls through, or in an edge block of a conditional branch (a label,
// the moves and a jump to the old target, placed where nothing falls into
// it). The split is kept when its estimated cost (ng_split_cost: memory
// accesses and moves weighted by loop depth) is lower than the allocation
// without it. `FID_NAT_OFF=split`: no splitting; FID_NAT_ON=splitall: every
// value is a candidate and the split is always kept (to test the
// machinery); FID_NAT_MUTATE=split leaves the stores at loop exits out (the
// checker must reject that: tests/nattools/machine_split_check.sh).
// MI14: spilled floats (f64 and f32 classes) are candidates too: no float
// register is callee-saved, so a float a call falls inside spills whole;
// its pieces between calls and in call-free loops take float registers
// (each piece's class comes from its own operations, ng_mir_classes_c; a
// move between a piece and the value may cross classes, ng_fmov_any).
// FID_NAT_OFF=splitfloat: integers only (tests/nattools/
// machine_mi14_check.sh). docs/reference/live-range-splitting.md.
// ---------------------------------------------------------------------------

/// RA4: a function's machine IR after live-range splitting.
pub struct NgSplit {
    pub mir: Vec<MInst>,
    pub nvreg: i64,
    // vreg - NG_VBASE (over the new nvreg) -> the vreg it was split from
    // (-1: not a piece)
    pub orig: Vec<i64>,
    // index in `mir` -> index of the original instruction (-1: inserted)
    pub src: Vec<i64>,
    // pieces made, of them around loops, edge blocks
    pub n_split: i64,
    pub n_loops: i64,
    pub n_edges: i64,
    // why nothing was split, when a move could not be placed
    pub err: str,
}

/// RA4: where the moves of a split go while it is planned: `slots` are
/// lists of [phase, destination, source]; pre_ix / post_ix map an original
/// index to the slot run before / after it, edge_ix a conditional branch
/// to its edge block (e_*: the branch, its slot, its old target label and
/// the index the block goes before).
pub struct NgLsState {
    pub slots: Vec<Vec<i64>>,
    pub pre_ix: i64,
    pub post_ix: i64,
    pub edge_ix: i64,
    pub e_t: Vec<i64>,
    pub e_slot: Vec<i64>,
    pub e_to: Vec<i64>,
    pub e_q: Vec<i64>,
}

const NG_SPLIT_MAX_CAND: i64 = 512;
const NG_SPLIT_MAX_BLOCKS: i64 = 4096;
const NG_SPLIT_MAX_LOOPS: i64 = 128;

/// RA4: a split piece does not cross a call (every caller-saved register
/// is lost there), the prologue or the epilogue.
fn ng_ls_barrier(op: i64) -> bool {
    return mi_is_call(op) || op == MO_PROLOGUE || op == MO_EPILOGUE;
}

/// RA4: control never goes on to the next instruction.
fn ng_ls_nofall(op: i64) -> bool {
    return op == MO_JMP || op == MO_EPILOGUE || op == MO_TRAP;
}

fn ng_ls_has(v: &Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// x is one of v[0..upto)
fn ng_ls_has_before(v: &Vec<i64>, x: i64, upto: i64) -> bool {
    var i: i64 = 0;
    while i < upto && i < v.len() {
        if v.get(i) == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Bit `bit` of block b's set in `sets` (`words` words a block).
fn ng_ls_bit(sets: &Vec<i64>, b: i64, words: i64, bit: i64) -> bool {
    return (sets.get(b * words + bit / 64) & (1 << (bit % 64))) != 0;
}

/// m reads vreg v (a field of its use mask names it).
fn ng_ls_reads(m: MInst, v: i64) -> bool {
    var um: i64 = mi_use_mask(m.op);
    var f: i64 = 0;
    while f < 3 {
        if (um & (1 << f)) != 0 && mi_field(m, f) == v {
            return true;
        }
        f = f + 1;
    }
    return false;
}

fn ng_ls_writes(m: MInst, v: i64) -> bool {
    return mi_defines(m.op) && m.r0 == v;
}

/// m with each field that reads or writes vreg `from` naming `to`.
fn ng_ls_rename(m: MInst, from: i64, to: i64) -> MInst {
    var um: i64 = mi_use_mask(m.op);
    var r0: i64 = m.r0;
    var r1: i64 = m.r1;
    var r2: i64 = m.r2;
    if ((um & 1) != 0 || mi_defines(m.op)) && r0 == from {
        r0 = to;
    }
    if (um & 2) != 0 && r1 == from {
        r1 = to;
    }
    if (um & 4) != 0 && r2 == from {
        r2 = to;
    }
    return MInst {
        op: m.op, r0: r0, r1: r1, r2: r2, i0: m.i0, i1: m.i1, i2: m.i2
    };
}

fn ng_ls_inst(op: i64, r0: i64, r1: i64, i0: i64) -> MInst {
    return MInst {
        op: op, r0: r0, r1: r1, r2: 0, i0: i0, i1: 0, i2: 0
    };
}

fn ng_ls_push(st: &mut NgLsState, at: i64, phase: i64, d: i64, s: i64) {
    var l: Vec<i64> = st.slots.get(at);
    l.push(phase);
    l.push(d);
    l.push(s);
    st.slots.set(at, l);
}

/// A move d <- s before (which 0) or after (which 1) original instruction k.
/// Phases order the moves at one place: 0 a piece's store after its last
/// write, 1 the stores at loop exits, 2 the loads at loop entries, 3 a
/// piece's load before its first read.
fn ng_ls_add(st: &mut NgLsState, which: i64, k: i64, phase: i64, d: i64, s: i64) {
    var ix: i64 = st.pre_ix;
    if which == 1 {
        ix = st.post_ix;
    }
    var at: i64 = 0;
    if HashMap_contains_i(ix, k) {
        at = HashMap_get_i(ix, k);
    } else {
        at = st.slots.len();
        st.slots.push(Vec::new());
        HashMap_insert_i(ix, k, at);
    }
    ng_ls_push(st, at, phase, d, s);
}

/// RA4: where an edge block for a jump to the block starting at s0 goes:
/// right before s0 when nothing falls into s0 (the block then falls into
/// it), else after the nearest earlier instruction control never goes on
/// from (a forward jump to s0), else after the nearest later one.
fn ng_ls_edge_at(mir: &Vec<MInst>, s0: i64) -> i64 {
    var n: i64 = mir.len();
    if s0 > 0 && ng_ls_nofall(mir.get(s0 - 1).op) {
        return s0;
    }
    var j: i64 = s0 - 1;
    while j >= 1 {
        if ng_ls_nofall(mir.get(j - 1).op) {
            return j;
        }
        j = j - 1;
    }
    j = s0 + 1;
    while j < n {
        if ng_ls_nofall(mir.get(j - 1).op) {
            return j;
        }
        j = j + 1;
    }
    return n;
}

/// RA4: the edge block of the conditional branch at t (to block s): its
/// slot, made the first time.
fn ng_ls_edge_slot(st: &mut NgLsState, mir: &Vec<MInst>, mb: &MBlocks, t: i64, s: i64) -> i64 {
    if HashMap_contains_i(st.edge_ix, t) {
        return st.e_slot.get(HashMap_get_i(st.edge_ix, t));
    }
    var at: i64 = st.slots.len();
    st.slots.push(Vec::new());
    HashMap_insert_i(st.edge_ix, t, st.e_t.len());
    st.e_t.push(t);
    st.e_slot.push(at);
    st.e_to.push(mir.get(t).i0);
    st.e_q.push(ng_ls_edge_at(mir, mb.start.get(s)));
    return at;
}

/// RA4: the move d <- src on every way block p goes to block s: before
/// p's ending jump, in the edge block of its conditional branch, after its
/// last instruction when it falls into s. False when p does not reach s.
fn ng_ls_on_edge(st: &mut NgLsState, mir: &Vec<MInst>, mb: &MBlocks, lab_blk: i64, p: i64, s: i64, phase: i64, d: i64, src: i64) -> bool {
    var t: i64 = mb.end.get(p);
    var m: MInst = mir.get(t);
    var found: bool = false;
    if mi_is_br(m.op) && HashMap_contains_i(lab_blk, m.i0) && HashMap_get_i(lab_blk, m.i0) == s {
        if m.op == MO_JMP {
            ng_ls_add(st, 0, t, phase, d, src);
        } else {
            var at: i64 = ng_ls_edge_slot(st, mir, mb, t, s);
            ng_ls_push(st, at, phase, d, src);
        }
        found = true;
    }
    if !ng_ls_nofall(m.op) && p + 1 == s && s < mb.start.len() {
        ng_ls_add(st, 1, t, phase, d, src);
        found = true;
    }
    return found;
}

/// RA4: the moves of one place, phase by phase, each phase one parallel
/// move (nat_par_moves). False when a phase is no parallel move (a
/// destination twice) or would need a scratch location (a cycle): the
/// split is then given up.
fn ng_ls_emit(nm: &mut Vec<MInst>, ns: &mut Vec<i64>, sl: &Vec<i64>) -> bool {
    var ph: i64 = 0;
    while ph < 4 {
        var d: Vec<i64> = Vec::new();
        var s: Vec<i64> = Vec::new();
        var t: i64 = 0;
        while t + 2 < sl.len() {
            if sl.get(t) == ph {
                d.push(sl.get(t + 1));
                s.push(sl.get(t + 2));
            }
            t = t + 3;
        }
        if d.len() > 0 {
            var seq: Vec<i64> = nat_par_moves(&d, &s, 0 - 1);
            if seq.len() != 2 * d.len() {
                return false;
            }
            var p: i64 = 0;
            while p + 1 < seq.len() {
                nm.push(ng_ls_inst(MO_MOV, seq.get(p), seq.get(p + 1), 0));
                ns.push(0 - 1);
                p = p + 2;
            }
        }
        ph = ph + 1;
    }
    return true;
}

/// RA4: candidate v's bit (sel over vreg - NG_VBASE), -1: no candidate.
fn ng_ls_cbit(sel: &Vec<i64>, v: i64) -> i64 {
    if v < NG_VBASE || v - NG_VBASE >= sel.len() {
        return 0 - 1;
    }
    return sel.get(v - NG_VBASE);
}

/// RA4: vreg v (candidate bit `bit`) is live right after instruction k of
/// block b: read later in the block before it is written, or live out.
fn ng_ls_live_after(mir: &Vec<MInst>, mb: &MBlocks, b: i64, k: i64, v: i64, lout: &Vec<i64>, words: i64, bit: i64) -> bool {
    var j: i64 = k + 1;
    while j <= mb.end.get(b) {
        var m: MInst = mir.get(j);
        if ng_ls_reads(m, v) {
            return true;
        }
        if ng_ls_writes(m, v) {
            return false;
        }
        j = j + 1;
    }
    return ng_ls_bit(lout, b, words, bit);
}

/// RA4: the piece of candidate c in a block's loop regions (the block's
/// list of pairs [candidate, piece]), -1: none.
fn ng_ls_region(l: &Vec<i64>, c: i64) -> i64 {
    var i: i64 = 0;
    while i + 1 < l.len() {
        if l.get(i) == c {
            return l.get(i + 1);
        }
        i = i + 2;
    }
    return 0 - 1;
}

/// RA4: instruction k reads or writes vreg `from` as `to` (rix: k -> its
/// list of pairs in rens).
fn ng_ls_ren(rix: i64, rens: &mut Vec<Vec<i64>>, k: i64, from: i64, to: i64) {
    var at: i64 = 0;
    if HashMap_contains_i(rix, k) {
        at = HashMap_get_i(rix, k);
    } else {
        at = rens.len();
        rens.push(Vec::new());
        HashMap_insert_i(rix, k, at);
    }
    var l: Vec<i64> = rens.get(at);
    l.push(from);
    l.push(to);
    rens.set(at, l);
}

/// RA4: no split (why: the reason, or "" when there was nothing to split).
fn ng_split_none(nvreg: i64, why: str) -> NgSplit {
    return NgSplit {
        mir: Vec::new(), nvreg: nvreg, orig: Vec::new(), src: Vec::new(), n_split: 0, n_loops: 0, n_edges: 0, err: why
    };
}

/// RA4: split the candidates (cand[vreg - NG_VBASE] != 0) of `mir`: pieces
/// around the largest call-free loops that use them, then pieces for runs
/// of two or more accesses between calls inside a block (see the comment
/// at the top of this section). Edge blocks take labels label0,
/// label0 + 1, ... (the caller makes them). `mutate` (FID_NAT_MUTATE=split)
/// leaves the stores at loop exits out. n_split == 0: nothing was split
/// (err says why when something prevented it).
fn ng_split_plan(mir: &Vec<MInst>, nvreg: i64, cand: &Vec<i64>, label0: i64, mutate: bool) -> NgSplit {
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if n == 0 || nv <= 0 {
        return ng_split_none(nvreg, "");
    }
    // Every label placed once (and below label0), every branch to one of
    // them, none address-taken or called (a way in the blocks would not
    // show)
    var place_ix: i64 = HashMap_new();
    var k: i64 = 0;
    while k < n {
        var pm: MInst = mir.get(k);
        if pm.op == MO_PLACE {
            if HashMap_contains_i(place_ix, pm.i0) {
                return ng_split_none(nvreg, "label " + int_to_str(pm.i0) + " placed twice");
            }
            if pm.i0 >= label0 {
                return ng_split_none(nvreg, "label " + int_to_str(pm.i0) + " not below the edge labels");
            }
            HashMap_insert_i(place_ix, pm.i0, k);
        }
        k = k + 1;
    }
    k = 0;
    while k < n {
        var bm: MInst = mir.get(k);
        if mi_is_br(bm.op) && !HashMap_contains_i(place_ix, bm.i0) {
            return ng_split_none(nvreg, "a branch to a label the function does not place");
        }
        if (bm.op == MO_ADDR || mi_is_call(bm.op)) && HashMap_contains_i(place_ix, bm.i0) {
            return ng_split_none(nvreg, "a label is address-taken or called");
        }
        k = k + 1;
    }
    var mb: MBlocks = mi_blocks(mir);
    var nb: i64 = mb.start.len();
    if nb == 0 || nb > NG_SPLIT_MAX_BLOCKS {
        return ng_split_none(nvreg, "too many blocks");
    }
    var lab_blk: i64 = HashMap_new();
    k = 0;
    while k < n {
        var lm: MInst = mir.get(k);
        if lm.op == MO_PLACE {
            HashMap_insert_i(lab_blk, lm.i0, mb.of.get(k));
        }
        k = k + 1;
    }
    // The candidates and their bits
    var sel: Vec<i64> = Vec::new();
    var cvs: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        var cb: i64 = 0 - 1;
        if i < cand.len() && cand.get(i) != 0 && cvs.len() < NG_SPLIT_MAX_CAND {
            cb = cvs.len();
            cvs.push(i + NG_VBASE);
        }
        sel.push(cb);
        i = i + 1;
    }
    var nc: i64 = cvs.len();
    if nc == 0 {
        return ng_split_none(nvreg, "");
    }
    var words: i64 = (nc + 63) / 64;
    var lin: Vec<i64> = Vec::new();
    var lout: Vec<i64> = Vec::new();
    // (RA2: from use lists)
    ng_alloc_liveness(mir, &mb, &sel, words, &mut lin, &mut lout);
    // Predecessors (each once) and the blocks holding a call, the prologue
    // or an epilogue
    var preds: Vec<Vec<i64>> = Vec::new();
    var bar: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < nb {
        preds.push(Vec::new());
        bar.push(0);
        b = b + 1;
    }
    b = 0;
    while b < nb {
        var ss: Vec<i64> = mb.succs.get(b);
        var si: i64 = 0;
        while si < ss.len() {
            var s: i64 = ss.get(si);
            if !ng_ls_has_before(&ss, s, si) {
                var pl: Vec<i64> = preds.get(s);
                pl.push(b);
                preds.set(s, pl);
            }
            si = si + 1;
        }
        k = mb.start.get(b);
        while k <= mb.end.get(b) {
            if ng_ls_barrier(mir.get(k).op) {
                bar.set(b, 1);
            }
            k = k + 1;
        }
        b = b + 1;
    }
    // Loops: for each head h, the blocks that reach a jump back to it
    // without passing it (so every way in from outside enters at h); not
    // when the entry block is among them or one of them is a barrier
    var lhead: Vec<i64> = Vec::new();
    var lmem: Vec<Vec<i64>> = Vec::new();
    var lblk: Vec<Vec<i64>> = Vec::new();
    var lacc: Vec<Vec<i64>> = Vec::new();
    var lwr: Vec<Vec<i64>> = Vec::new();
    var h: i64 = 0;
    while h < nb && lhead.len() < NG_SPLIT_MAX_LOOPS {
        var hp: Vec<i64> = preds.get(h);
        var latch: bool = false;
        var pi: i64 = 0;
        while pi < hp.len() {
            if hp.get(pi) >= h {
                latch = true;
            }
            pi = pi + 1;
        }
        if latch && h > 0 {
            var mem: Vec<i64> = Vec::new();
            b = 0;
            while b < nb {
                mem.push(0);
                b = b + 1;
            }
            mem.set(h, 1);
            var blks: Vec<i64> = Vec::new();
            blks.push(h);
            var work: Vec<i64> = Vec::new();
            pi = 0;
            while pi < hp.len() {
                var lp: i64 = hp.get(pi);
                if lp >= h && mem.get(lp) == 0 {
                    mem.set(lp, 1);
                    work.push(lp);
                    blks.push(lp);
                }
                pi = pi + 1;
            }
            var wi: i64 = 0;
            while wi < work.len() {
                var x: i64 = work.get(wi);
                wi = wi + 1;
                var xp: Vec<i64> = preds.get(x);
                var xi: i64 = 0;
                while xi < xp.len() {
                    var q: i64 = xp.get(xi);
                    if mem.get(q) == 0 {
                        mem.set(q, 1);
                        work.push(q);
                        blks.push(q);
                    }
                    xi = xi + 1;
                }
            }
            var ok: bool = mem.get(0) == 0;
            var bi: i64 = 0;
            while ok && bi < blks.len() {
                if bar.get(blks.get(bi)) != 0 {
                    ok = false;
                }
                bi = bi + 1;
            }
            if ok {
                // the candidates it reads or writes, and writes
                var acc: Vec<i64> = Vec::new();
                var wr: Vec<i64> = Vec::new();
                var wd: i64 = 0;
                while wd < words {
                    acc.push(0);
                    wr.push(0);
                    wd = wd + 1;
                }
                bi = 0;
                while bi < blks.len() {
                    var xb: i64 = blks.get(bi);
                    k = mb.start.get(xb);
                    while k <= mb.end.get(xb) {
                        var am: MInst = mir.get(k);
                        var aum: i64 = mi_use_mask(am.op);
                        var f: i64 = 0;
                        while f < 3 {
                            var defd: bool = f == 0 && mi_defines(am.op);
                            if (aum & (1 << f)) != 0 || defd {
                                var c: i64 = ng_ls_cbit(&sel, mi_field(am, f));
                                if c >= 0 {
                                    acc.set(c / 64, acc.get(c / 64) | (1 << (c % 64)));
                                    if defd {
                                        wr.set(c / 64, wr.get(c / 64) | (1 << (c % 64)));
                                    }
                                }
                            }
                            f = f + 1;
                        }
                        k = k + 1;
                    }
                    bi = bi + 1;
                }
                lhead.push(h);
                lmem.push(mem);
                lblk.push(blks);
                lacc.push(acc);
                lwr.push(wr);
            }
        }
        h = h + 1;
    }
    var nl: i64 = lhead.len();
    // Largest loops first (loops of different heads are nested or apart)
    var order: Vec<i64> = Vec::new();
    var taken: Vec<i64> = Vec::new();
    i = 0;
    while i < nl {
        taken.push(0);
        i = i + 1;
    }
    while order.len() < nl {
        var best: i64 = 0 - 1;
        i = 0;
        while i < nl {
            if taken.get(i) == 0 {
                if best < 0 || lblk.get(i).len() > lblk.get(best).len() {
                    best = i;
                }
            }
            i = i + 1;
        }
        taken.set(best, 1);
        order.push(best);
    }
    // Each candidate takes the largest loops that use it and lie in no loop
    // it already took: a piece each
    var orig: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        orig.push(0 - 1);
        i = i + 1;
    }
    var next: i64 = nvreg;
    var blkreg: Vec<Vec<i64>> = Vec::new();
    b = 0;
    while b < nb {
        blkreg.push(Vec::new());
        b = b + 1;
    }
    var cl_c: Vec<i64> = Vec::new();
    var cl_l: Vec<i64> = Vec::new();
    var cl_p: Vec<i64> = Vec::new();
    var c2: i64 = 0;
    while c2 < nc {
        var oi: i64 = 0;
        while oi < nl {
            var l: i64 = order.get(oi);
            var la: Vec<i64> = lacc.get(l);
            if ng_ls_bit(&la, 0, words, c2) {
                var hl: Vec<i64> = blkreg.get(lhead.get(l));
                if ng_ls_region(&hl, c2) < 0 {
                    var piece: i64 = next;
                    next = next + 1;
                    orig.push(cvs.get(c2));
                    cl_c.push(c2);
                    cl_l.push(l);
                    cl_p.push(piece);
                    var lb: Vec<i64> = lblk.get(l);
                    var bi2: i64 = 0;
                    while bi2 < lb.len() {
                        var rl: Vec<i64> = blkreg.get(lb.get(bi2));
                        rl.push(c2);
                        rl.push(piece);
                        blkreg.set(lb.get(bi2), rl);
                        bi2 = bi2 + 1;
                    }
                }
            }
            oi = oi + 1;
        }
        c2 = c2 + 1;
    }
    // Renaming inside the regions, and the runs elsewhere: per block, the
    // accesses of a candidate with no barrier between them
    var rix: i64 = HashMap_new();
    var rens: Vec<Vec<i64>> = Vec::new();
    var r_cnt: Vec<i64> = Vec::new();
    var r_first: Vec<i64> = Vec::new();
    var r_last: Vec<i64> = Vec::new();
    var r_lastw: Vec<i64> = Vec::new();
    var r_rf: Vec<i64> = Vec::new();
    var r_ix: Vec<Vec<i64>> = Vec::new();
    i = 0;
    while i < nc {
        r_cnt.push(0);
        r_first.push(0 - 1);
        r_last.push(0 - 1);
        r_lastw.push(0 - 1);
        r_rf.push(0);
        r_ix.push(Vec::new());
        i = i + 1;
    }
    var ru_c: Vec<i64> = Vec::new();
    var ru_first: Vec<i64> = Vec::new();
    var ru_last: Vec<i64> = Vec::new();
    var ru_lastw: Vec<i64> = Vec::new();
    var ru_rf: Vec<i64> = Vec::new();
    var ru_b: Vec<i64> = Vec::new();
    var ru_ix: Vec<Vec<i64>> = Vec::new();
    b = 0;
    while b < nb {
        var breg: Vec<i64> = blkreg.get(b);
        var open: Vec<i64> = Vec::new();
        var kend: i64 = mb.end.get(b);
        k = mb.start.get(b);
        while k <= kend + 1 {
            var flush: bool = k > kend;
            var m: MInst = mi_nop();
            if !flush {
                m = mir.get(k);
                flush = ng_ls_barrier(m.op);
            }
            if flush {
                var oj: i64 = 0;
                while oj < open.len() {
                    var oc: i64 = open.get(oj);
                    if r_cnt.get(oc) >= 2 {
                        ru_c.push(oc);
                        ru_first.push(r_first.get(oc));
                        ru_last.push(r_last.get(oc));
                        ru_lastw.push(r_lastw.get(oc));
                        ru_rf.push(r_rf.get(oc));
                        ru_b.push(b);
                        ru_ix.push(r_ix.get(oc));
                    }
                    r_cnt.set(oc, 0);
                    r_lastw.set(oc, 0 - 1);
                    r_ix.set(oc, Vec::new());
                    oj = oj + 1;
                }
                open = Vec::new();
            }
            if k <= kend && !ng_ls_barrier(m.op) {
                // the candidates this instruction reads or writes (each once)
                var um: i64 = mi_use_mask(m.op);
                var seen: Vec<i64> = Vec::new();
                var f2: i64 = 0;
                while f2 < 3 {
                    var dd: bool = f2 == 0 && mi_defines(m.op);
                    if (um & (1 << f2)) != 0 || dd {
                        var c3: i64 = ng_ls_cbit(&sel, mi_field(m, f2));
                        if c3 >= 0 && !ng_ls_has(&seen, c3) {
                            seen.push(c3);
                        }
                    }
                    f2 = f2 + 1;
                }
                var sj: i64 = 0;
                while sj < seen.len() {
                    var c4: i64 = seen.get(sj);
                    var v4: i64 = cvs.get(c4);
                    var rp: i64 = ng_ls_region(&breg, c4);
                    if rp >= 0 {
                        ng_ls_ren(rix, &mut rens, k, v4, rp);
                    } else {
                        if r_cnt.get(c4) == 0 {
                            open.push(c4);
                            r_first.set(c4, k);
                            var rf: i64 = 0;
                            if ng_ls_reads(m, v4) {
                                rf = 1;
                            }
                            r_rf.set(c4, rf);
                        }
                        r_cnt.set(c4, r_cnt.get(c4) + 1);
                        r_last.set(c4, k);
                        if ng_ls_writes(m, v4) {
                            r_lastw.set(c4, k);
                        }
                        var rx: Vec<i64> = r_ix.get(c4);
                        rx.push(k);
                        r_ix.set(c4, rx);
                    }
                    sj = sj + 1;
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    if cl_c.len() + ru_c.len() == 0 {
        return ng_split_none(nvreg, "");
    }
    var st: NgLsState = NgLsState {
        slots: Vec::new(), pre_ix: HashMap_new(), post_ix: HashMap_new(), edge_ix: HashMap_new(), e_t: Vec::new(), e_slot: Vec::new(), e_to: Vec::new(), e_q: Vec::new()
    };
    // A run's piece: loaded before its first access when that reads, stored
    // after its last write when the value is still live after the run
    var ri: i64 = 0;
    while ri < ru_c.len() {
        var rc: i64 = ru_c.get(ri);
        var rv: i64 = cvs.get(rc);
        var rpiece: i64 = next;
        next = next + 1;
        orig.push(rv);
        var rxs: Vec<i64> = ru_ix.get(ri);
        var xi2: i64 = 0;
        while xi2 < rxs.len() {
            ng_ls_ren(rix, &mut rens, rxs.get(xi2), rv, rpiece);
            xi2 = xi2 + 1;
        }
        if ru_rf.get(ri) != 0 {
            ng_ls_add(&mut st, 0, ru_first.get(ri), 3, rpiece, rv);
        }
        var lw: i64 = ru_lastw.get(ri);
        if lw >= 0 && ng_ls_live_after(mir, &mb, ru_b.get(ri), ru_last.get(ri), rv, &lout, words, rc) {
            ng_ls_add(&mut st, 1, lw, 0, rv, rpiece);
        }
        ri = ri + 1;
    }
    // A loop's piece: loaded on each way into the head from outside when the
    // value is live there, stored on each way out to a block where it is
    // live when the loop writes it
    var ci: i64 = 0;
    while ci < cl_c.len() {
        var cc: i64 = cl_c.get(ci);
        var cl: i64 = cl_l.get(ci);
        var cp: i64 = cl_p.get(ci);
        var cv: i64 = cvs.get(cc);
        var cmem: Vec<i64> = lmem.get(cl);
        var chd: i64 = lhead.get(cl);
        if ng_ls_bit(&lin, chd, words, cc) {
            var chp: Vec<i64> = preds.get(chd);
            var pj: i64 = 0;
            while pj < chp.len() {
                var pb: i64 = chp.get(pj);
                if cmem.get(pb) == 0 {
                    if !ng_ls_on_edge(&mut st, mir, &mb, lab_blk, pb, chd, 2, cp, cv) {
                        return ng_split_none(nvreg, "no place for the moves into a loop");
                    }
                }
                pj = pj + 1;
            }
        }
        var cw: Vec<i64> = lwr.get(cl);
        if ng_ls_bit(&cw, 0, words, cc) && !mutate {
            var cb2: Vec<i64> = lblk.get(cl);
            var bj: i64 = 0;
            while bj < cb2.len() {
                var xb2: i64 = cb2.get(bj);
                var xs: Vec<i64> = mb.succs.get(xb2);
                var sj2: i64 = 0;
                while sj2 < xs.len() {
                    var sb: i64 = xs.get(sj2);
                    if !ng_ls_has_before(&xs, sb, sj2) && cmem.get(sb) == 0 && ng_ls_bit(&lin, sb, words, cc) {
                        if !ng_ls_on_edge(&mut st, mir, &mb, lab_blk, xb2, sb, 1, cv, cp) {
                            return ng_split_none(nvreg, "no place for the moves out of a loop");
                        }
                    }
                    sj2 = sj2 + 1;
                }
                bj = bj + 1;
            }
        }
        ci = ci + 1;
    }
    // Edge blocks by the index they go before
    var eqix: i64 = HashMap_new();
    var eql: Vec<Vec<i64>> = Vec::new();
    var e: i64 = 0;
    while e < st.e_t.len() {
        var q: i64 = st.e_q.get(e);
        if q >= n && !ng_ls_nofall(mir.get(n - 1).op) {
            return ng_split_none(nvreg, "no place for an edge block");
        }
        var at: i64 = 0;
        if HashMap_contains_i(eqix, q) {
            at = HashMap_get_i(eqix, q);
        } else {
            at = eql.len();
            eql.push(Vec::new());
            HashMap_insert_i(eqix, q, at);
        }
        var ql: Vec<i64> = eql.get(at);
        ql.push(e);
        eql.set(at, ql);
        e = e + 1;
    }
    // The split function
    var nm: Vec<MInst> = Vec::new();
    var ns: Vec<i64> = Vec::new();
    k = 0;
    while k <= n {
        if HashMap_contains_i(eqix, k) {
            var el: Vec<i64> = eql.get(HashMap_get_i(eqix, k));
            var ei: i64 = 0;
            while ei < el.len() {
                var ee: i64 = el.get(ei);
                nm.push(ng_ls_inst(MO_PLACE, 0, 0, label0 + ee));
                ns.push(0 - 1);
                var esl: Vec<i64> = st.slots.get(st.e_slot.get(ee));
                if !ng_ls_emit(&mut nm, &mut ns, &esl) {
                    return ng_split_none(nvreg, "the moves of an edge are no parallel move");
                }
                var to: i64 = st.e_to.get(ee);
                var falls: bool = ei == el.len() - 1 && k < n && mir.get(k).op == MO_PLACE && mir.get(k).i0 == to;
                if !falls {
                    nm.push(ng_ls_inst(MO_JMP, 0, 0, to));
                    ns.push(0 - 1);
                }
                ei = ei + 1;
            }
        }
        if k < n {
            if HashMap_contains_i(st.pre_ix, k) {
                var psl: Vec<i64> = st.slots.get(HashMap_get_i(st.pre_ix, k));
                if !ng_ls_emit(&mut nm, &mut ns, &psl) {
                    return ng_split_none(nvreg, "the moves before an instruction are no parallel move");
                }
            }
            var mk: MInst = mir.get(k);
            if HashMap_contains_i(rix, k) {
                var rl2: Vec<i64> = rens.get(HashMap_get_i(rix, k));
                var rj: i64 = 0;
                while rj + 1 < rl2.len() {
                    mk = ng_ls_rename(mk, rl2.get(rj), rl2.get(rj + 1));
                    rj = rj + 2;
                }
            }
            if HashMap_contains_i(st.edge_ix, k) {
                mk = MInst {
                    op: mk.op, r0: mk.r0, r1: mk.r1, r2: mk.r2, i0: label0 + HashMap_get_i(st.edge_ix, k), i1: mk.i1, i2: mk.i2
                };
            }
            nm.push(mk);
            ns.push(k);
            if HashMap_contains_i(st.post_ix, k) {
                var qsl: Vec<i64> = st.slots.get(HashMap_get_i(st.post_ix, k));
                if !ng_ls_emit(&mut nm, &mut ns, &qsl) {
                    return ng_split_none(nvreg, "the moves after an instruction are no parallel move");
                }
            }
        }
        k = k + 1;
    }
    return NgSplit {
        mir: nm, nvreg: next, orig: orig, src: ns, n_split: cl_c.len() + ru_c.len(), n_loops: cl_c.len(), n_edges: st.e_t.len(), err: ""
    };
}

// --- RA4: the split checker ------------------------------------------------
// ng_split_check proves a split function (ng_split_plan's) does what the
// original did. Structure: the original's instructions appear in order,
// each once, each with its operands the same or renamed to a piece of the
// same value, and a conditional branch may go to an edge label instead of
// its target; what was inserted is moves between a value and its pieces,
// and edge blocks: an edge label nothing falls into, moves, then a jump to
// the old target or the old target's label right after. Values: by a
// forward must-analysis over the split function's blocks, the set of
// vregs (a value and its pieces) that hold the value's current contents;
// a write makes its vreg the only one, a move between two of them copies
// the source's state, and every read must name a vreg in the set on every
// way there.
// ---------------------------------------------------------------------------

/// RA4: the holder bit of vreg v (hidx over vreg - NG_VBASE), -1: none.
fn ng_spc_hold(hidx: &Vec<i64>, v: i64) -> i64 {
    if v < NG_VBASE || v - NG_VBASE >= hidx.len() {
        return 0 - 1;
    }
    return hidx.get(v - NG_VBASE);
}

fn ng_spc_put(cur: &mut Vec<i64>, h: i64, on: bool) {
    var w: i64 = cur.get(h / 64);
    var bit: i64 = 1 << (h % 64);
    if on {
        w = w | bit;
    } else {
        w = w & ~bit;
    }
    cur.set(h / 64, w);
}

/// RA4: the holders' state through block b (cur: on entry, then on exit).
/// With `check`, the first read of a vreg that does not hold its value's
/// current contents is returned as an error.
fn ng_spc_block(mir: &Vec<MInst>, mb: &MBlocks, b: i64, cur: &mut Vec<i64>, hidx: &Vec<i64>, hgrp: &Vec<i64>, gbits: &Vec<Vec<i64>>, gval: &Vec<i64>, check: bool) -> str {
    var k: i64 = mb.start.get(b);
    while k <= mb.end.get(b) {
        var m: MInst = mir.get(k);
        var copied: bool = false;
        if m.op == MO_MOV {
            var dh: i64 = ng_spc_hold(hidx, m.r0);
            var sh: i64 = ng_spc_hold(hidx, m.r1);
            if dh >= 0 && sh >= 0 && hgrp.get(dh) == hgrp.get(sh) {
                var on: bool = (cur.get(sh / 64) & (1 << (sh % 64))) != 0;
                ng_spc_put(cur, dh, on);
                copied = true;
            }
        }
        if !copied {
            if check {
                var um: i64 = mi_use_mask(m.op);
                var f: i64 = 0;
                while f < 3 {
                    if (um & (1 << f)) != 0 {
                        var w: i64 = mi_field(m, f);
                        var hw: i64 = ng_spc_hold(hidx, w);
                        if hw >= 0 && (cur.get(hw / 64) & (1 << (hw % 64))) == 0 {
                            return "instruction " + int_to_str(k) + " (" + mi_op_name(m.op) + ") reads v" + int_to_str(w) + ", which does not hold the value of v" + int_to_str(gval.get(hgrp.get(hw))) + " there";
                        }
                    }
                    f = f + 1;
                }
            }
            if mi_defines(m.op) {
                var hd: i64 = ng_spc_hold(hidx, m.r0);
                if hd >= 0 {
                    var gb: Vec<i64> = gbits.get(hgrp.get(hd));
                    var gi: i64 = 0;
                    while gi < gb.len() {
                        ng_spc_put(cur, gb.get(gi), false);
                        gi = gi + 1;
                    }
                    ng_spc_put(cur, hd, true);
                }
            }
        }
        k = k + 1;
    }
    return "";
}

/// RA4: check the split function `mir` (blocks mb; orig and src as in
/// NgSplit) against the original `base`. "" when it is sound.
fn ng_split_check(name: str, base: &Vec<MInst>, mir: &Vec<MInst>, mb: &MBlocks, orig: &Vec<i64>, src: &Vec<i64>) -> str {
    var pre: str = "live-range split: " + name + ": ";
    var n: i64 = mir.len();
    var nbase: i64 = base.len();
    if src.len() != n {
        return pre + "the instruction map has " + int_to_str(src.len()) + " entries for " + int_to_str(n) + " instructions";
    }
    // Holders: each split value and its pieces, a bit each; groups by value
    var no: i64 = orig.len();
    var hidx: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < no {
        hidx.push(0 - 1);
        i = i + 1;
    }
    var hgrp: Vec<i64> = Vec::new();
    var gbits: Vec<Vec<i64>> = Vec::new();
    var gval: Vec<i64> = Vec::new();
    var gof: i64 = HashMap_new();
    i = 0;
    while i < no {
        var ov: i64 = orig.get(i);
        if ov >= 0 {
            if ov < NG_VBASE || ov - NG_VBASE >= no || orig.get(ov - NG_VBASE) >= 0 {
                return pre + "v" + int_to_str(i + NG_VBASE) + " is a piece of v" + int_to_str(ov) + ", which is no value";
            }
            var gr: i64 = 0;
            if HashMap_contains_i(gof, ov) {
                gr = HashMap_get_i(gof, ov);
            } else {
                gr = gval.len();
                gval.push(ov);
                var first: Vec<i64> = Vec::new();
                first.push(hgrp.len());
                gbits.push(first);
                hidx.set(ov - NG_VBASE, hgrp.len());
                hgrp.push(gr);
                HashMap_insert_i(gof, ov, gr);
            }
            var gl: Vec<i64> = gbits.get(gr);
            gl.push(hgrp.len());
            gbits.set(gr, gl);
            hidx.set(i, hgrp.len());
            hgrp.push(gr);
        }
        i = i + 1;
    }
    // Structure: the original's instructions in order, operands renamed
    // to pieces of the same value only, branches sent to edge labels
    var blabs: i64 = HashMap_new();
    i = 0;
    while i < nbase {
        if base.get(i).op == MO_PLACE {
            HashMap_insert_i(blabs, base.get(i).i0, 1);
        }
        i = i + 1;
    }
    var eold: i64 = HashMap_new();
    var n_eold: i64 = 0;
    var nxt: i64 = 0;
    var j: i64 = 0;
    while j < n {
        var m: MInst = mir.get(j);
        var s: i64 = src.get(j);
        var at: str = pre + "instruction " + int_to_str(j) + " (" + mi_op_name(m.op) + ")";
        if s >= 0 {
            if s != nxt || s >= nbase {
                return at + " is the original's " + int_to_str(s) + ", not its " + int_to_str(nxt);
            }
            nxt = nxt + 1;
            var bm: MInst = base.get(s);
            if m.op != bm.op || m.i1 != bm.i1 || m.i2 != bm.i2 {
                return at + " differs from the original's " + int_to_str(s);
            }
            var um: i64 = mi_use_mask(m.op);
            var f: i64 = 0;
            while f < 3 {
                var bv: i64 = mi_field(bm, f);
                var sv: i64 = mi_field(m, f);
                if bv != sv {
                    var isreg: bool = (um & (1 << f)) != 0 || (f == 0 && mi_defines(m.op));
                    if !isreg {
                        return at + ": field " + int_to_str(f) + " changed";
                    }
                    var piece_of: i64 = 0 - 1;
                    if sv >= NG_VBASE && sv - NG_VBASE < no {
                        piece_of = orig.get(sv - NG_VBASE);
                    }
                    if piece_of != bv {
                        return at + ": v" + int_to_str(sv) + " in place of v" + int_to_str(bv) + ", which it is no piece of";
                    }
                }
                f = f + 1;
            }
            if m.i0 != bm.i0 {
                if !mi_is_cond_br(m.op) {
                    return at + ": i0 changed";
                }
                if HashMap_contains_i(blabs, m.i0) || HashMap_contains_i(eold, m.i0) {
                    return at + ": sent to label " + int_to_str(m.i0) + ", which is in use";
                }
                HashMap_insert_i(eold, m.i0, bm.i0);
                n_eold = n_eold + 1;
            }
        } else {
            if m.op == MO_MOV {
                var dh: i64 = ng_spc_hold(&hidx, m.r0);
                var sh: i64 = ng_spc_hold(&hidx, m.r1);
                if dh < 0 || sh < 0 || hgrp.get(dh) != hgrp.get(sh) || m.r0 == m.r1 {
                    return at + ": an inserted move v" + int_to_str(m.r0) + " <- v" + int_to_str(m.r1) + " joins no value and its piece";
                }
            } else if m.op == MO_PLACE {
                if HashMap_contains_i(blabs, m.i0) {
                    return at + ": an inserted label " + int_to_str(m.i0) + " the original places";
                }
            } else if m.op != MO_JMP {
                return at + " was inserted";
            }
        }
        j = j + 1;
    }
    if nxt != nbase {
        return pre + int_to_str(nbase - nxt) + " of the original's instructions are missing";
    }
    // Edge blocks: nothing falls in; moves; on to the old target
    var placed: i64 = HashMap_new();
    var n_placed: i64 = 0;
    j = 0;
    while j < n {
        var em: MInst = mir.get(j);
        if src.get(j) < 0 && em.op == MO_PLACE {
            var lab: i64 = em.i0;
            if !HashMap_contains_i(eold, lab) {
                return pre + "edge label " + int_to_str(lab) + " (instruction " + int_to_str(j) + ") no branch goes to";
            }
            if HashMap_contains_i(placed, lab) {
                return pre + "edge label " + int_to_str(lab) + " placed twice";
            }
            HashMap_insert_i(placed, lab, 1);
            n_placed = n_placed + 1;
            if j == 0 || !ng_ls_nofall(mir.get(j - 1).op) {
                return pre + "control falls into the edge block of label " + int_to_str(lab);
            }
            var old: i64 = HashMap_get_i(eold, lab);
            var j2: i64 = j + 1;
            while j2 < n && src.get(j2) < 0 && mir.get(j2).op == MO_MOV {
                j2 = j2 + 1;
            }
            if j2 < n && src.get(j2) < 0 && mir.get(j2).op == MO_JMP && mir.get(j2).i0 == old {
                j = j2 + 1;
            } else if j2 < n && src.get(j2) >= 0 && mir.get(j2).op == MO_PLACE && mir.get(j2).i0 == old {
                j = j2;
            } else {
                return pre + "the edge block of label " + int_to_str(lab) + " does not go on to label " + int_to_str(old);
            }
        } else {
            if src.get(j) < 0 && em.op == MO_JMP {
                return pre + "an inserted jump (instruction " + int_to_str(j) + ") outside an edge block";
            }
            j = j + 1;
        }
    }
    if n_placed != n_eold {
        return pre + int_to_str(n_eold - n_placed) + " edge labels are never placed";
    }
    // Values: the holders' must-analysis
    var hn: i64 = hgrp.len();
    if hn == 0 {
        return "";
    }
    var words: i64 = (hn + 63) / 64;
    var nb: i64 = mb.start.len();
    var preds: Vec<Vec<i64>> = Vec::new();
    var outs: Vec<i64> = Vec::new();
    var inn: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < nb {
        preds.push(Vec::new());
        var wi: i64 = 0;
        while wi < words {
            outs.push(0 - 1);
            inn.push(0 - 1);
            wi = wi + 1;
        }
        b = b + 1;
    }
    b = 0;
    while b < nb {
        var ss: Vec<i64> = mb.succs.get(b);
        var si: i64 = 0;
        while si < ss.len() {
            if !ng_ls_has_before(&ss, ss.get(si), si) {
                var pl: Vec<i64> = preds.get(ss.get(si));
                pl.push(b);
                preds.set(ss.get(si), pl);
            }
            si = si + 1;
        }
        b = b + 1;
    }
    // On entry only the values hold their contents (a parameter, or
    // nothing yet): a piece holds nothing until a move or a write gives it
    // the value, so a missing load before a loop is caught too
    var init: Vec<i64> = Vec::new();
    var iw: i64 = 0;
    while iw < words {
        init.push(0);
        iw = iw + 1;
    }
    var gi0: i64 = 0;
    while gi0 < gbits.len() {
        var g0: Vec<i64> = gbits.get(gi0);
        ng_spc_put(&mut init, g0.get(0), true);
        gi0 = gi0 + 1;
    }
    var changed: bool = true;
    var rounds: i64 = 0;
    while changed && rounds < 1000 {
        changed = false;
        rounds = rounds + 1;
        b = 0;
        while b < nb {
            var cur: Vec<i64> = Vec::new();
            var w2: i64 = 0;
            while w2 < words {
                var x: i64 = 0 - 1;
                if b == 0 {
                    x = init.get(w2);
                }
                var bp: Vec<i64> = preds.get(b);
                var pi: i64 = 0;
                while pi < bp.len() {
                    x = x & outs.get(bp.get(pi) * words + w2);
                    pi = pi + 1;
                }
                cur.push(x);
                inn.set(b * words + w2, x);
                w2 = w2 + 1;
            }
            var ign: str = ng_spc_block(mir, mb, b, &mut cur, &hidx, &hgrp, &gbits, &gval, false);
            w2 = 0;
            while w2 < words {
                if cur.get(w2) != outs.get(b * words + w2) {
                    outs.set(b * words + w2, cur.get(w2));
                    changed = true;
                }
                w2 = w2 + 1;
            }
            b = b + 1;
        }
    }
    if changed {
        return pre + "the value analysis does not settle";
    }
    b = 0;
    while b < nb {
        var cur2: Vec<i64> = Vec::new();
        var w3: i64 = 0;
        while w3 < words {
            cur2.push(inn.get(b * words + w3));
            w3 = w3 + 1;
        }
        var err: str = ng_spc_block(mir, mb, b, &mut cur2, &hidx, &hgrp, &gbits, &gval, true);
        if err != "" {
            return pre + err;
        }
        b = b + 1;
    }
    return "";
}

// --- RA4: unit hooks (tests/nattools/split_unit.fd) -------------------------

/// Machine IR from rows of 7 numbers (op, r0, r1, r2, i0, i1, i2).
fn ng_split_unit_rows(flat: &Vec<i64>) -> Vec<MInst> {
    var mir: Vec<MInst> = Vec::new();
    var k: i64 = 0;
    while k + 6 < flat.len() {
        mir.push(MInst {
            op: flat.get(k), r0: flat.get(k + 1), r1: flat.get(k + 2), r2: flat.get(k + 3), i0: flat.get(k + 4), i1: flat.get(k + 5), i2: flat.get(k + 6)
        });
        k = k + 7;
    }
    return mir;
}

/// The split of `flat` (nv vregs from NG_VBASE) with the vregs numbered
/// in `spilled` (0 = v64) as candidates; edge labels after the highest
/// label the rows name.
fn ng_split_unit_plan(flat: &Vec<i64>, nv: i64, spilled: &Vec<i64>, mutate: bool) -> NgSplit {
    var mir: Vec<MInst> = ng_split_unit_rows(flat);
    var cand: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        cand.push(0);
        i = i + 1;
    }
    i = 0;
    while i < spilled.len() {
        var s: i64 = spilled.get(i);
        if s >= 0 && s < nv {
            cand.set(s, 1);
        }
        i = i + 1;
    }
    var label0: i64 = 1;
    i = 0;
    while i < mir.len() {
        var m: MInst = mir.get(i);
        if (m.op == MO_PLACE || mi_is_br(m.op)) && m.i0 >= label0 {
            label0 = m.i0 + 1;
        }
        i = i + 1;
    }
    return ng_split_plan(&mir, NG_VBASE + nv, &cand, label0, mutate);
}

/// RA4 unit hook: "pieces N loops L edges E" and the checker's verdict
/// ("check: ok", "check: <error>", "check: nothing split").
pub fn nat_split_unit(flat: &Vec<i64>, nv: i64, spilled: &Vec<i64>, mutate: bool) -> Vec<str> {
    var sp: NgSplit = ng_split_unit_plan(flat, nv, spilled, mutate);
    var out: Vec<str> = Vec::new();
    var head: str = "pieces " + int_to_str(sp.n_split) + " loops " + int_to_str(sp.n_loops) + " edges " + int_to_str(sp.n_edges);
    if sp.err != "" {
        head = head + " (" + sp.err + ")";
    }
    out.push(head);
    if sp.n_split == 0 {
        out.push("check: nothing split");
        return out;
    }
    var base: Vec<MInst> = ng_split_unit_rows(flat);
    var smb: MBlocks = mi_blocks(&sp.mir);
    var err: str = ng_split_check("unit", &base, &sp.mir, &smb, &sp.orig, &sp.src);
    if err == "" {
        out.push("check: ok");
    } else {
        out.push("check: " + err);
    }
    return out;
}

/// RA4 unit hook: the split function as rows (the rows themselves when
/// nothing was split).
pub fn nat_split_unit_mir(flat: &Vec<i64>, nv: i64, spilled: &Vec<i64>, mutate: bool) -> Vec<i64> {
    var sp: NgSplit = ng_split_unit_plan(flat, nv, spilled, mutate);
    if sp.n_split == 0 {
        var same: Vec<i64> = Vec::new();
        var k0: i64 = 0;
        while k0 < flat.len() {
            same.push(flat.get(k0));
            k0 = k0 + 1;
        }
        return same;
    }
    var out: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < sp.mir.len() {
        var m: MInst = sp.mir.get(k);
        out.push(m.op);
        out.push(m.r0);
        out.push(m.r1);
        out.push(m.r2);
        out.push(m.i0);
        out.push(m.i1);
        out.push(m.i2);
        k = k + 1;
    }
    return out;
}

/// RA4: split function `sp` without its `nth` inserted move (0: the first)
/// into nm / ns (instructions, original indices). False: no such move.
fn ng_split_unit_dropped(sp: &NgSplit, nth: i64, nm: &mut Vec<MInst>, ns: &mut Vec<i64>) -> bool {
    var seen: i64 = 0;
    var dropped: bool = false;
    var k: i64 = 0;
    while k < sp.mir.len() {
        var m: MInst = sp.mir.get(k);
        var s: i64 = sp.src.get(k);
        var skip: bool = false;
        if s < 0 && m.op == MO_MOV {
            if seen == nth {
                skip = true;
                dropped = true;
            }
            seen = seen + 1;
        }
        if !skip {
            nm.push(m);
            ns.push(s);
        }
        k = k + 1;
    }
    return dropped;
}

/// RA4 unit hook: the split of `flat` without its `nth` inserted move, as
/// rows (empty when there is no such move or nothing was split).
pub fn nat_split_unit_drop_mir(flat: &Vec<i64>, nv: i64, spilled: &Vec<i64>, nth: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var sp: NgSplit = ng_split_unit_plan(flat, nv, spilled, false);
    if sp.n_split == 0 {
        return out;
    }
    var nm: Vec<MInst> = Vec::new();
    var ns: Vec<i64> = Vec::new();
    if !ng_split_unit_dropped(&sp, nth, &mut nm, &mut ns) {
        return out;
    }
    var k: i64 = 0;
    while k < nm.len() {
        var m: MInst = nm.get(k);
        out.push(m.op);
        out.push(m.r0);
        out.push(m.r1);
        out.push(m.r2);
        out.push(m.i0);
        out.push(m.i1);
        out.push(m.i2);
        k = k + 1;
    }
    return out;
}

/// RA4 unit hook: the checker's verdict on the split of `flat` with the
/// `nth` inserted move (0: the first) left out, as a broken planner would
/// leave it ("check: ok", "check: <error>", "check: no such move" or
/// "check: nothing split").
pub fn nat_split_unit_drop(flat: &Vec<i64>, nv: i64, spilled: &Vec<i64>, nth: i64) -> str {
    var sp: NgSplit = ng_split_unit_plan(flat, nv, spilled, false);
    if sp.n_split == 0 {
        return "check: nothing split";
    }
    var nm: Vec<MInst> = Vec::new();
    var ns: Vec<i64> = Vec::new();
    if !ng_split_unit_dropped(&sp, nth, &mut nm, &mut ns) {
        return "check: no such move";
    }
    var base: Vec<MInst> = ng_split_unit_rows(flat);
    var smb: MBlocks = mi_blocks(&nm);
    var err: str = ng_split_check("unit", &base, &nm, &smb, &sp.orig, &ns);
    if err == "" {
        return "check: ok";
    }
    return "check: " + err;
}

/// RA4: the error of the last nat_split_alloc_unit ("" when every checker
/// passed).
var g_ng_split_unit_err: str = "";

pub fn nat_split_alloc_unit_err() -> str {
    return g_ng_split_unit_err;
}

/// RA4: why the planner split nothing in the last nat_split_alloc_unit
/// ("" when it split something or did not run).
pub fn nat_split_alloc_unit_why() -> str {
    return g_ng_split_why;
}

/// RA4 unit hook: the whole allocation with live-range splitting
/// (ng_mir_alloc_split, as a build runs it, with the MIR verifier, the
/// allocation checker and the split checker on, as under FID_VERIFY=1) of
/// the hand-made function `flat` (rows of 7: op, r0, r1, r2, i0, i1, i2;
/// `nv` vregs from NG_VBASE) on target `arch` (NAT_A64, NAT_RV64,
/// NAT_X64). `mode`: 0 the default (kept when cheaper), 1 no splitting
/// (FID_NAT_OFF=split), 2 every value split and kept (FID_NAT_ON=splitall).
/// The result, for tests/nattools/split_alloc_unit.fd, which runs the
/// allocated function: [pieces, around loops, edge blocks, cost without,
/// cost with, kept (1/0) (zeros when nothing was split), the candidates
/// (values the first allocation spilled), the values the second split
/// left whole (splitprune), the registers a
/// call keeps (the callee-saved mask), the result register, the number of
/// rows, the rows of the function as allocated (split or not), the number
/// of vregs, then 4 per vreg: register (-1 spilled, -2 unused), remat kind
/// (0: none), remat value, slot]. The error: nat_split_alloc_unit_err().
pub fn nat_split_alloc_unit(arch: i64, flat: &Vec<i64>, nv: i64, mode: i64) -> Vec<i64> {
    var g: NatGen = NatGen_new(arch);
    var mir: Vec<MInst> = ng_split_unit_rows(flat);
    // the labels the rows name exist before the split's edge labels
    var top: i64 = 0;
    var k: i64 = 0;
    while k < mir.len() {
        var m: MInst = mir.get(k);
        if (m.op == MO_PLACE || mi_is_br(m.op)) && m.i0 > top {
            top = m.i0;
        }
        k = k + 1;
    }
    var made: i64 = 0 - 1;
    while g.e.labels.len() <= top && made < top {
        made = NatEnc_label(&mut g.e);
    }
    var rec: NatFnRec = NatFnRec {
        name: "unit", mir: mir, nvreg: NG_VBASE + nv, base_frame: 0, slots: Vec::new(), is_ct: false, sret_v: 0 - 1, sret_size: 0, secret: false
    };
    g_ng_verify_unit = true;
    g_ng_split_unit_mode = mode + 1;
    g_ng_split_last = Vec::new();
    g_ng_split_why = "";
    var al: NatAlloc = ng_mir_alloc_split(&mut g, &mut rec);
    g_ng_verify_unit = false;
    g_ng_split_unit_mode = 0;
    g_ng_split_unit_err = al.err;
    var out: Vec<i64> = Vec::new();
    var h: i64 = 0;
    while h < 8 {
        if h < g_ng_split_last.len() {
            out.push(g_ng_split_last.get(h));
        } else {
            out.push(0);
        }
        h = h + 1;
    }
    g_ng_split_last = Vec::new();
    out.push(g.td.int_callee_mask);
    out.push(g.td.result_reg);
    out.push(rec.mir.len());
    k = 0;
    while k < rec.mir.len() {
        var rm: MInst = rec.mir.get(k);
        out.push(rm.op);
        out.push(rm.r0);
        out.push(rm.r1);
        out.push(rm.r2);
        out.push(rm.i0);
        out.push(rm.i1);
        out.push(rm.i2);
        k = k + 1;
    }
    var nvf: i64 = rec.nvreg - NG_VBASE;
    out.push(nvf);
    var i: i64 = 0;
    while i < nvf {
        var a: i64 = 0 - 2;
        var rk: i64 = 0;
        var rv: i64 = 0;
        var sl: i64 = 0 - 1;
        if i < al.assign.len() {
            a = al.assign.get(i);
        }
        if i < al.remat.len() {
            rk = al.remat.get(i);
        }
        if i < al.remat_val.len() {
            rv = al.remat_val.get(i);
        }
        if i < al.spill.len() {
            sl = al.spill.get(i);
        }
        out.push(a);
        out.push(rk);
        out.push(rv);
        out.push(sl);
        i = i + 1;
    }
    return out;
}

/// MI25: a call strictly inside [lo, hi] (calls in order; ng_reg_ok's
/// search): every float register is caller-saved, so a float range across
/// a call cannot keep one.
fn ng_float_call_in(calls: &Vec<i64>, lo: i64, hi: i64) -> bool {
    var a: i64 = 0;
    var b: i64 = calls.len();
    while a < b {
        var mid: i64 = (a + b) / 2;
        if calls.get(mid) <= lo {
            a = mid + 1;
        } else {
            b = mid;
        }
    }
    return a < calls.len() && calls.get(a) < hi;
}

/// MI25: the float ranges (flo[v] >= 0: the hull [flo[v], hi[v]] of a
/// copy class's representative) take the float pool's registers, one
/// linear scan in order of start. Each pool register is caller-saved on
/// every target: a range a call falls inside cannot keep one. RA18: such
/// a range takes a callee-saved float register (ng_float_callee_pool:
/// AArch64 d8..d15, RISC-V fs0..fs11; the function then saves it, see
/// ng_mir_alloc), and spills only when there is none (x86-64, a program
/// with tasks, FID_NAT_OFF=fcallee) or none is free; a range no call
/// falls inside takes a caller-saved one first, then a callee-saved one.
/// A range that crosses blocks in the fast mode of debug builds (RA14)
/// spills. With no register free, the cheapest active range (spill
/// weights, when given: weight.len() == nv) or else the one ending last
/// gives its register up when that costs less than spilling this one,
/// among the active ranges whose register this one may hold. Fills
/// `assign` (register, or -1 spilled) for those ranges; returns how many
/// got a register (g_ng_fcs_last: how many of those that a call falls
/// inside are in callee-saved ones).
var g_ng_fcs_last: i64 = 0;
fn ng_float_assign(g: &NatGen, flo: &Vec<i64>, hi: &Vec<i64>, weight: &Vec<i64>, calls: &Vec<i64>, sel: &Vec<i64>, fast: bool, n: i64, nv: i64, assign: &mut Vec<i64>) -> i64 {
    var pool: Vec<i64> = ng_float_pool(g);
    var cpool: Vec<i64> = ng_float_callee_pool(g);
    g_ng_fcs_last = 0;
    var by_w: bool = weight.len() == nv;
    var busy: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 64 {
        busy.push(0);
        i = i + 1;
    }
    // in order of start (counting sort over the positions)
    var count: Vec<i64> = Vec::new();
    i = 0;
    while i <= n + 1 {
        count.push(0);
        i = i + 1;
    }
    i = 0;
    while i < nv {
        if flo.get(i) >= 0 {
            count.set(flo.get(i) + 1, count.get(flo.get(i) + 1) + 1);
        }
        i = i + 1;
    }
    i = 1;
    while i < count.len() {
        count.set(i, count.get(i) + count.get(i - 1));
        i = i + 1;
    }
    var order: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        order.push(0 - 1);
        i = i + 1;
    }
    var total: i64 = 0;
    i = 0;
    while i < nv {
        if flo.get(i) >= 0 {
            var slot: i64 = count.get(flo.get(i));
            order.set(slot, i);
            count.set(flo.get(i), slot + 1);
            total = total + 1;
        }
        i = i + 1;
    }
    var active: Vec<i64> = Vec::new();
    var oi: i64 = 0;
    while oi < total {
        var v: i64 = order.get(oi);
        var st: i64 = flo.get(v);
        // a range ending where this one starts gives its register up
        var kept: Vec<i64> = Vec::new();
        var ai: i64 = 0;
        while ai < active.len() {
            var a: i64 = active.get(ai);
            if assign.get(a) >= 0 {
                if hi.get(a) <= st {
                    busy.set(assign.get(a), 0);
                } else {
                    kept.push(a);
                }
            }
            ai = ai + 1;
        }
        active = kept;
        // RA18: a call inside the range: callee-saved registers only
        var crosses: bool = ng_float_call_in(calls, st, hi.get(v));
        if (fast && sel.get(v) >= 0) || (crosses && cpool.len() == 0) {
            assign.set(v, 0 - 1);
        } else {
            var r: i64 = 0 - 1;
            var pi: i64 = 0;
            while !crosses && r < 0 && pi < pool.len() {
                if busy.get(pool.get(pi)) == 0 {
                    r = pool.get(pi);
                }
                pi = pi + 1;
            }
            pi = 0;
            while r < 0 && pi < cpool.len() {
                if busy.get(cpool.get(pi)) == 0 {
                    r = cpool.get(pi);
                }
                pi = pi + 1;
            }
            if r >= 0 {
                assign.set(v, r);
                busy.set(r, 1);
                active.push(v);
            } else {
                var pick: i64 = 0 - 1;
                var wi: i64 = 0;
                while wi < active.len() {
                    var c: i64 = active.get(wi);
                    if crosses && !ng_ao_has(&cpool, assign.get(c)) {
                    // (RA18: a caller-saved register is no use to it)
                    } else if pick < 0 {
                        pick = wi;
                    } else if by_w && weight.get(c) < weight.get(active.get(pick)) {
                        pick = wi;
                    } else if !by_w && hi.get(c) > hi.get(active.get(pick)) {
                        pick = wi;
                    }
                    wi = wi + 1;
                }
                var steal: bool = false;
                if pick >= 0 {
                    var pc: i64 = active.get(pick);
                    if by_w {
                        steal = weight.get(pc) < weight.get(v);
                    } else {
                        steal = hi.get(pc) > hi.get(v);
                    }
                }
                if steal {
                    var loser: i64 = active.get(pick);
                    r = assign.get(loser);
                    assign.set(loser, 0 - 1);
                    active.set(pick, v);
                    assign.set(v, r);
                } else {
                    assign.set(v, 0 - 1);
                }
            }
        }
        oi = oi + 1;
    }
    var placed: i64 = 0;
    i = 0;
    while i < nv {
        if flo.get(i) >= 0 && assign.get(i) >= 0 {
            placed = placed + 1;
            if ng_ao_has(&cpool, assign.get(i)) && ng_float_call_in(calls, flo.get(i), hi.get(i)) {
                g_ng_fcs_last = g_ng_fcs_last + 1;
            }
        }
        i = i + 1;
    }
    return placed;
}

// ---------------------------------------------------------------------------
// RA9: the greedy allocator (LLVM's greedy / regalloc2's backtracking
// style), in place of the linear scan with FID_NAT_ON=greedy. It sees the
// same ranges (the hulls [lo, hi] after coalescing), the same register
// constraints (ng_reg_ok: a caller-saved register no call inside the range
// clobbers; a callee-saved one) and the same spill weights, and fills the
// same `assign` (register, -1 spilled, -2 not a range), so everything after
// the scan (RA2 holes, RA10 classes, members, slots, the checker) runs
// unchanged. Ranges leave a priority queue longest first; each takes, in
// order, its copy partner's register, a free caller-saved one, a free
// callee-saved one; failing that, it evicts the ranges that hold the
// register over its hull when each of them weighs less than it does (the
// register whose heaviest such range is lightest), and they go back into
// the queue; failing that, it spills (RA2 then gives it a second chance
// over the segments of its liveness, as LLVM's splitting would). A range
// is evicted at most NG_GR_EVICT_MAX times, and a range evicts only lighter
// ones, so the queue empties.
// ---------------------------------------------------------------------------

const NG_GR_EVICT_MAX: i64 = 4;

/// RA9: two hulls interfere as the linear scan sees them: a range ending
/// where another starts gives its register up (an operation reads its
/// operands before it writes), two ranges starting at one position always
/// interfere.
fn ng_gr_clash(alo: i64, ahi: i64, blo: i64, bhi: i64) -> bool {
    if alo == blo {
        return true;
    }
    return alo < bhi && blo < ahi;
}

/// RA9: the first index of register list `lst` (ranges sorted by start and
/// pairwise apart, so their ends ascend too) whose range ends at or after p.
fn ng_gr_first(lst: &Vec<i64>, hi: &Vec<i64>, p: i64) -> i64 {
    var a: i64 = 0;
    var b: i64 = lst.len();
    while a < b {
        var mid: i64 = (a + b) / 2;
        if hi.get(lst.get(mid)) < p {
            a = mid + 1;
        } else {
            b = mid;
        }
    }
    return a;
}

/// RA9: no range of `lst` interferes with [vl, vh].
fn ng_gr_free(lst: &Vec<i64>, lo: &Vec<i64>, hi: &Vec<i64>, vl: i64, vh: i64) -> bool {
    var j: i64 = ng_gr_first(lst, hi, vl);
    while j < lst.len() && lo.get(lst.get(j)) <= vh {
        var w: i64 = lst.get(j);
        if ng_gr_clash(lo.get(w), hi.get(w), vl, vh) {
            return false;
        }
        j = j + 1;
    }
    return true;
}

/// RA9: the queue's order: the longer hull first, then the earlier start,
/// then the lower vreg (deterministic).
fn ng_gr_before(a: i64, b: i64, lo: &Vec<i64>, hi: &Vec<i64>) -> bool {
    var la: i64 = hi.get(a) - lo.get(a);
    var lb: i64 = hi.get(b) - lo.get(b);
    if la != lb {
        return la > lb;
    }
    if lo.get(a) != lo.get(b) {
        return lo.get(a) < lo.get(b);
    }
    return a < b;
}

fn ng_gr_push(heap: &mut Vec<i64>, lo: &Vec<i64>, hi: &Vec<i64>, v: i64) {
    heap.push(v);
    var c: i64 = heap.len() - 1;
    var moving: bool = true;
    while moving && c > 0 {
        var p: i64 = (c - 1) / 2;
        if ng_gr_before(heap.get(c), heap.get(p), lo, hi) {
            var t: i64 = heap.get(c);
            heap.set(c, heap.get(p));
            heap.set(p, t);
            c = p;
        } else {
            moving = false;
        }
    }
}

fn ng_gr_pop(heap: &mut Vec<i64>, lo: &Vec<i64>, hi: &Vec<i64>) -> i64 {
    var top: i64 = heap.get(0);
    var last: i64 = heap.get(heap.len() - 1);
    heap.truncate(heap.len() - 1);
    var n: i64 = heap.len();
    if n == 0 {
        return top;
    }
    heap.set(0, last);
    var c: i64 = 0;
    var moving: bool = true;
    while moving {
        var l: i64 = 2 * c + 1;
        var r: i64 = l + 1;
        var best: i64 = c;
        if l < n && ng_gr_before(heap.get(l), heap.get(best), lo, hi) {
            best = l;
        }
        if r < n && ng_gr_before(heap.get(r), heap.get(best), lo, hi) {
            best = r;
        }
        if best != c {
            var t: i64 = heap.get(c);
            heap.set(c, heap.get(best));
            heap.set(best, t);
            c = best;
        } else {
            moving = false;
        }
    }
    return top;
}

/// RA9: `lst` with v inserted at its place by start.
fn ng_gr_insert(lst: &Vec<i64>, lo: &Vec<i64>, v: i64) -> Vec<i64> {
    var a: i64 = 0;
    var b: i64 = lst.len();
    while a < b {
        var mid: i64 = (a + b) / 2;
        if lo.get(lst.get(mid)) < lo.get(v) {
            a = mid + 1;
        } else {
            b = mid;
        }
    }
    var out: Vec<i64> = Vec::new();
    var j: i64 = 0;
    while j < a {
        out.push(lst.get(j));
        j = j + 1;
    }
    out.push(v);
    while j < lst.len() {
        out.push(lst.get(j));
        j = j + 1;
    }
    return out;
}

/// RA2: in the greedy allocator, register r suits range v: over its
/// segments `vs` when there are segments, else over its hull [vl, vh].
fn ng_gr_ok(g: &NatGen, r: i64, seg_mode: bool, vs: &Vec<i64>, vl: i64, vh: i64, calls: &Vec<i64>, masks: &Vec<i64>) -> bool {
    if seg_mode {
        return ng_seg_reg_ok(g, r, vs, calls, masks);
    }
    return ng_reg_ok(g, r, vl, vh, calls, masks);
}

/// RA2: in the greedy allocator, ranges w and v interfere: share a position
/// of their segments, or clash as hulls (ng_gr_clash) without segments.
fn ng_gr_hit(seg_mode: bool, segs: &Vec<Vec<i64>>, sb: &Vec<i64>, se: &Vec<i64>, lo: &Vec<i64>, hi: &Vec<i64>, w: i64, v: i64, vs: &Vec<i64>, budget: &mut i64) -> bool {
    if seg_mode {
        return ng_seg_meet(segs, sb, se, w, v, vs, budget);
    }
    return ng_gr_clash(lo.get(w), hi.get(w), lo.get(v), hi.get(v));
}

/// RA2: in the greedy allocator, no range of `lst` interferes with v.
fn ng_gr_free_v(lst: &Vec<i64>, seg_mode: bool, segs: &Vec<Vec<i64>>, sb: &Vec<i64>, se: &Vec<i64>, lo: &Vec<i64>, hi: &Vec<i64>, v: i64, vs: &Vec<i64>, budget: &mut i64) -> bool {
    if seg_mode {
        return ng_seg_free(lst, segs, sb, se, lo, hi, v, vs, budget);
    }
    return ng_gr_free(lst, lo, hi, lo.get(v), hi.get(v));
}

/// RA9: the greedy assignment (see above) over the ranges with lo >= 0.
/// `weight` is the spill weight per vreg (RA5), or empty (weights off: the
/// hull's length stands for it). Returns the number of evictions.
/// RA2: with `segs` (one list per vreg, ng_class_segs) ranges interfere
/// only where their segments share a position, so a range may take a
/// register in the holes of those holding it (a register's ranges are then
/// no longer apart as hulls: its list is searched from the start); with
/// `segs` empty, the hulls as before.
fn ng_greedy_assign(g: &NatGen, lo: &Vec<i64>, hi: &Vec<i64>, segs: &Vec<Vec<i64>>, hint: &Vec<i64>, weight: &Vec<i64>, calls: &Vec<i64>, masks: &Vec<i64>, nv: i64, assign: &mut Vec<i64>) -> i64 {
    var seg_mode: bool = nv > 0 && segs.len() == nv;
    var sb: Vec<i64> = Vec::new();
    var se: Vec<i64> = Vec::new();
    if seg_mode {
        ng_seg_bounds(segs, lo, hi, nv, &mut sb, &mut se);
    }
    // (compile time: at most this many segment comparisons)
    var budget: i64 = 8000000;
    var cand: Vec<i64> = ng_pool_caller(g);
    var callee: Vec<i64> = ng_callee_saved(g);
    var i: i64 = 0;
    while i < callee.len() {
        cand.push(callee.get(i));
        i = i + 1;
    }
    var maxr: i64 = 0;
    i = 0;
    while i < cand.len() {
        if cand.get(i) + 1 > maxr {
            maxr = cand.get(i) + 1;
        }
        i = i + 1;
    }
    var lists: Vec<Vec<i64>> = Vec::new();
    i = 0;
    while i < maxr {
        lists.push(Vec::new());
        i = i + 1;
    }
    var cost: Vec<i64> = Vec::new();
    var evicted: Vec<i64> = Vec::new();
    var heap: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        if weight.len() == nv {
            cost.push(weight.get(i));
        } else {
            cost.push(hi.get(i) - lo.get(i) + 1);
        }
        evicted.push(0);
        if lo.get(i) >= 0 {
            ng_gr_push(&mut heap, lo, hi, i);
        }
        i = i + 1;
    }
    var n_ev: i64 = 0;
    while heap.len() > 0 {
        var v: i64 = ng_gr_pop(&mut heap, lo, hi);
        var vl: i64 = lo.get(v);
        var vh: i64 = hi.get(v);
        var vs: Vec<i64> = Vec::new();
        if seg_mode {
            vs = ng_seg_of(segs, &sb, &se, v);
        }
        var r: i64 = 0 - 1;
        // the copy partner's register, then the pool in order
        var h: i64 = hint.get(v);
        if h >= 0 && h < nv && assign.get(h) >= 0 && assign.get(h) < maxr {
            var hr: i64 = assign.get(h);
            var hl: Vec<i64> = lists.get(hr);
            if ng_gr_ok(g, hr, seg_mode, &vs, vl, vh, calls, masks) && ng_gr_free_v(&hl, seg_mode, segs, &sb, &se, lo, hi, v, &vs, &mut budget) {
                r = hr;
            }
        }
        var ci: i64 = 0;
        while r < 0 && ci < cand.len() {
            var c: i64 = cand.get(ci);
            var cl: Vec<i64> = lists.get(c);
            if ng_gr_ok(g, c, seg_mode, &vs, vl, vh, calls, masks) && ng_gr_free_v(&cl, seg_mode, segs, &sb, &se, lo, hi, v, &vs, &mut budget) {
                r = c;
            }
            ci = ci + 1;
        }
        if r < 0 {
            // eviction: the register whose heaviest interfering range is
            // the lightest, each of them lighter than v and evictable
            var best: i64 = 0 - 1;
            var best_cost: i64 = 0;
            var best_hits: Vec<i64> = Vec::new();
            ci = 0;
            while ci < cand.len() {
                var c2: i64 = cand.get(ci);
                if ng_gr_ok(g, c2, seg_mode, &vs, vl, vh, calls, masks) {
                    var el: Vec<i64> = lists.get(c2);
                    var ok: bool = true;
                    var worst: i64 = 0;
                    var hits: Vec<i64> = Vec::new();
                    // (hulls: a register's ranges are apart, so those
                    // ending before v starts come first; segments: from
                    // the start)
                    var j: i64 = 0;
                    if !seg_mode {
                        j = ng_gr_first(&el, hi, vl);
                    }
                    while ok && j < el.len() && lo.get(el.get(j)) <= vh {
                        var w: i64 = el.get(j);
                        if ng_gr_hit(seg_mode, segs, &sb, &se, lo, hi, w, v, &vs, &mut budget) {
                            if cost.get(w) >= cost.get(v) || evicted.get(w) >= NG_GR_EVICT_MAX {
                                ok = false;
                            } else {
                                hits.push(w);
                                if cost.get(w) > worst {
                                    worst = cost.get(w);
                                }
                            }
                        }
                        j = j + 1;
                    }
                    if ok && (best < 0 || worst < best_cost) {
                        best = c2;
                        best_cost = worst;
                        best_hits = hits;
                    }
                }
                ci = ci + 1;
            }
            if best >= 0 {
                var ol: Vec<i64> = lists.get(best);
                var kept: Vec<i64> = Vec::new();
                var j2: i64 = 0;
                while j2 < ol.len() {
                    var w2: i64 = ol.get(j2);
                    // (exactly the ranges judged above)
                    if ng_seg_in(&best_hits, w2) {
                        assign.set(w2, 0 - 2);
                        evicted.set(w2, evicted.get(w2) + 1);
                        ng_gr_push(&mut heap, lo, hi, w2);
                        n_ev = n_ev + 1;
                    } else {
                        kept.push(w2);
                    }
                    j2 = j2 + 1;
                }
                lists.set(best, kept);
                r = best;
            }
        }
        if r >= 0 {
            var al: Vec<i64> = lists.get(r);
            lists.set(r, ng_gr_insert(&al, lo, v));
            assign.set(v, r);
        } else {
            assign.set(v, 0 - 1);
        }
    }
    return n_ev;
}

/// RA9: the greedy assignment of target `arch` (NAT_A64, NAT_RV64,
/// NAT_X64) on given hulls with no calls and no copy hints, for
/// tests/nattools/greedy_unit.fd: each range's register (-1 spilled), then
/// the number of evictions, then the size of the integer pool.
pub fn nat_greedy_unit(arch: i64, lo: &Vec<i64>, hi: &Vec<i64>, weight: &Vec<i64>) -> Vec<i64> {
    var g: NatGen = NatGen_new(arch);
    var nv: i64 = lo.len();
    var hint: Vec<i64> = Vec::new();
    var assign: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        hint.push(0 - 1);
        assign.push(0 - 2);
        i = i + 1;
    }
    var calls: Vec<i64> = Vec::new();
    var masks: Vec<i64> = Vec::new();
    var nosegs: Vec<Vec<i64>> = Vec::new();
    var n_ev: i64 = ng_greedy_assign(&g, lo, hi, &nosegs, &hint, weight, &calls, &masks, nv, &mut assign);
    assign.push(n_ev);
    assign.push(ng_pool_caller(&g).len() + ng_callee_saved(&g).len());
    return assign;
}

/// RA14: the fast allocator is on (main.fd's g_nat_fast, or FID_NAT_FAST
/// set to anything but "" or "0").
fn ng_fast_alloc_on() -> bool {
    if g_nat_fast {
        return true;
    }
    if g_ng_env_ok {
        return g_ng_env_fast;
    }
    var v: str = p_getenv("FID_NAT_FAST");
    if (v as i64) == 0 {
        return false;
    }
    return str_len(v) > 0 && v != "0";
}

/// Union-find: the representative of vreg index v (paths halved).
fn ng_find(rep: &mut Vec<i64>, v: i64) -> i64 {
    var x: i64 = v;
    while rep.get(x) != x {
        rep.set(x, rep.get(rep.get(x)));
        x = rep.get(x);
    }
    return x;
}

/// An instruction in [from, to) reads a vreg of class c.
fn ng_class_read(mir: &Vec<MInst>, rep: &mut Vec<i64>, c: i64, from: i64, to: i64, nv: i64) -> bool {
    var k: i64 = from;
    while k < to {
        var m: MInst = mir.get(k);
        var um: i64 = mi_use_mask(m.op);
        var f: i64 = 0;
        while f < 3 {
            var v: i64 = mi_field(m, f);
            if (um & (1 << f)) != 0 && v >= NG_VBASE && v - NG_VBASE < nv && ng_find(rep, v - NG_VBASE) == c {
                return true;
            }
            f = f + 1;
        }
        k = k + 1;
    }
    return false;
}

/// RA6: coalescing classes a and b (representatives, union-find `crep`)
/// interfere: in a block that overlaps [from, to] (the smaller hull: the
/// two can only meet inside it), an instruction writes a member of one
/// while a member of the other is live after it (unless it is a copy from
/// the other class: both hold one value then), or both are live where the
/// function starts. Exact liveness: each such block is walked back from
/// its live-out set (`lout`, `words` words per block over the `sel` bits
/// of the vregs that cross blocks; a vreg local to a block is defined
/// there before it is read).
fn ng_classes_interfere(mir: &Vec<MInst>, mb: &MBlocks, sel: &Vec<i64>, words: i64, lout: &Vec<i64>, crep: &mut Vec<i64>, a: i64, b: i64, from: i64, to: i64, nv: i64) -> bool {
    var abits: Vec<i64> = Vec::new();
    var bbits: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        if sel.get(i) >= 0 {
            var r: i64 = ng_find(crep, i);
            if r == a {
                abits.push(sel.get(i));
            } else if r == b {
                bbits.push(sel.get(i));
            }
        }
        i = i + 1;
    }
    var nb: i64 = mb.start.len();
    var bl: i64 = 0;
    while bl < nb {
        if mb.end.get(bl) >= from && mb.start.get(bl) <= to {
            var la: bool = ng_bits_any(lout, bl, words, &abits);
            var lb: bool = ng_bits_any(lout, bl, words, &bbits);
            var k: i64 = mb.end.get(bl);
            while k >= mb.start.get(bl) {
                var m: MInst = mir.get(k);
                if m.op >= 0 {
                    if mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 - NG_VBASE < nv {
                        var dc: i64 = ng_find(crep, m.r0 - NG_VBASE);
                        var sc: i64 = 0 - 1;
                        if m.op == MO_MOV && m.r1 >= NG_VBASE && m.r1 - NG_VBASE < nv {
                            sc = ng_find(crep, m.r1 - NG_VBASE);
                        }
                        if dc == a {
                            if lb && sc != b {
                                return true;
                            }
                            la = false;
                        } else if dc == b {
                            if la && sc != a {
                                return true;
                            }
                            lb = false;
                        }
                    }
                    var um: i64 = mi_use_mask(m.op);
                    var f: i64 = 0;
                    while f < 3 {
                        var v: i64 = mi_field(m, f);
                        if (um & (1 << f)) != 0 && v >= NG_VBASE && v - NG_VBASE < nv {
                            var uc: i64 = ng_find(crep, v - NG_VBASE);
                            if uc == a {
                                la = true;
                            } else if uc == b {
                                lb = true;
                            }
                        }
                        f = f + 1;
                    }
                }
                k = k - 1;
            }
            if bl == 0 && la && lb {
                return true;
            }
        }
        bl = bl + 1;
    }
    return false;
}

/// One of the bits `bits` is set in block b's row of `set` (`words` words
/// per block).
fn ng_bits_any(set: &Vec<i64>, b: i64, words: i64, bits: &Vec<i64>) -> bool {
    var j: i64 = 0;
    while j < bits.len() {
        var bit: i64 = bits.get(j);
        if (set.get(b * words + bit / 64) & (1 << (bit % 64))) != 0 {
            return true;
        }
        j = j + 1;
    }
    return false;
}

/// A position of `ps` in [lo, hi], other than `except`.
fn ng_any_in(ps: Vec<i64>, lo: i64, hi: i64, except: i64) -> bool {
    var i: i64 = 0;
    while i < ps.len() {
        var p: i64 = ps.get(i);
        if p >= lo && p <= hi && p != except {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The spill cost of each vreg: its uses and definitions, 8^(loop depth)
/// each (depth up to 4), a loop being [a label, a later jump back to it].
/// `cold` (OP30): a label map as ng_pgo_cold_labels returns, 0 for none;
/// a use or definition in a block a profiled run never or rarely entered
/// (label -> 1) costs 1 whatever its loop depth, so those ranges spill first.
@wrapping
fn ng_spill_weights(mir: &Vec<MInst>, nv: i64, cold: i64) -> Vec<i64> {
    var n: i64 = mir.len();
    var place: i64 = HashMap_new();
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        if m.op == MO_PLACE {
            HashMap_insert(place, int_to_str(m.i0), k);
        }
        k = k + 1;
    }
    var diff: Vec<i64> = Vec::new();
    k = 0;
    while k <= n {
        diff.push(0);
        k = k + 1;
    }
    k = 0;
    while k < n {
        var m2: MInst = mir.get(k);
        if mi_is_br(m2.op) {
            var key: str = int_to_str(m2.i0);
            if HashMap_contains(place, key) {
                var at: i64 = HashMap_get(place, key);
                if at < k {
                    diff.set(at, diff.get(at) + 1);
                    diff.set(k + 1, diff.get(k + 1) - 1);
                }
            }
        }
        k = k + 1;
    }
    var w: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        w.push(0);
        i = i + 1;
    }
    var in_cold: bool = false;
    var depth: i64 = 0;
    k = 0;
    while k < n {
        depth = depth + diff.get(k);
        var d: i64 = depth;
        if d > 4 {
            d = 4;
        }
        var m3: MInst = mir.get(k);
        var cost: i64 = 1 << (3 * d);
        if cold != 0 && m3.op == MO_PLACE && HashMap_contains_i(cold, m3.i0) {
            in_cold = HashMap_get_i(cold, m3.i0) == 1;
        }
        if in_cold {
            cost = 1;
        }
        var um: i64 = mi_use_mask(m3.op);
        var f: i64 = 0;
        while f < 3 {
            var v: i64 = mi_field(m3, f);
            var touched: bool = (um & (1 << f)) != 0 || (f == 0 && mi_defines(m3.op));
            if touched && v >= NG_VBASE && v - NG_VBASE < nv {
                w.set(v - NG_VBASE, w.get(v - NG_VBASE) + cost);
            }
            f = f + 1;
        }
        k = k + 1;
    }
    return w;
}

/// Register r may hold a value live over [lo, hi]: callee-saved, or no call
/// strictly inside clobbers it.
fn ng_reg_ok(g: &NatGen, r: i64, lo: i64, hi: i64, calls: &Vec<i64>, masks: &Vec<i64>) -> bool {
    if ng_is_callee_saved(g, r) {
        return true;
    }
    // the first call after lo (binary search)
    var a: i64 = 0;
    var b: i64 = calls.len();
    while a < b {
        var mid: i64 = (a + b) / 2;
        if calls.get(mid) <= lo {
            a = mid + 1;
        } else {
            b = mid;
        }
    }
    while a < calls.len() && calls.get(a) < hi {
        if (masks.get(a) & (1 << r)) != 0 {
            return false;
        }
        a = a + 1;
    }
    return true;
}

/// The allocation checker (roadmap RA15): exact liveness per instruction,
/// computed afresh over every vreg; no definition may write a register
/// another live value holds, and no call may clobber one that holds a live
/// value. "" when the allocation is sound.
/// J7: post-selection @constant_time check, the machine-layer counterpart
/// of src/codegen_x64.rs's verify_constant_time_asm (which covers the
/// x86-64 ELF path only; this runs on every native target, --nat Windows
/// included). A @constant_time function may not contain, in its final MIR:
///   a conditional branch (BNEZ/BEQZ) or a data-dependent check (PANICIF) —
///     the condition is a function of the operands; @wrapping removes the
///     overflow checks that would otherwise appear
///   MO_DIV / MO_REM / float divide — variable-latency instructions
///   an indirect call (CALLR)
///   a call to a function that is not @constant_time itself
/// Indexed memory is not checked: the address of a LOAD/STORE is an
/// ordinary register by then and the MIR cannot tell whether it was derived
/// from a secret — the source-level check rejects indexing on secrets.
/// WP11: a @crashfree function's machine IR after the folds: an overflow
/// check (addition, subtraction, multiplication, or a narrow result that
/// does not fit: NP_ADD..NP_MUL) still there is a panic path the type
/// checker let through (unary minus, `+=`; it rejects `+ - *` outside
/// @wrapping), so the annotation is wrong and the build fails. A division
/// check stays: the type checker proved its divisor non-zero.
/// "" when the function is clean, else the first violation.
fn ng_crashfree_check(rec: &NatFnRec) -> str {
    var msgs: Vec<str> = nat_panic_messages();
    var i: i64 = 0;
    while i < rec.mir.len() {
        var m: MInst = rec.mir.get(i);
        if m.op == MO_PANICIF && m.i0 >= NP_ADD && m.i0 <= NP_MUL {
            var at: str = "";
            if m.i1 > 0 {
                at = " (line " + int_to_str(m.i1) + ")";
            }
            return "function '" + rec.name + "' is @crashfree but can panic: " + msgs.get(m.i0) + at + ". Mark it @wrapping for two's-complement arithmetic, or remove @crashfree";
        }
        i = i + 1;
    }
    return "";
}

/// A function a @constant_time function may call without being
/// @constant_time itself: what the source-level check
/// (TypeChecker_verify_constant_time) and pe_ir's (peir_ct_check) allow.
/// Runtime builtins (`p_*`, `__*`, and the runtime's own `pert_*`, `pe_*`,
/// `nat_*` they lower to) and core's implementations of the built-in
/// types' methods (`v.len()`, `v.get(i)` are calls of Vec_len, Vec_get
/// here; the source check does not count a method on Vec, HashMap or str
/// as a call). Before, `ct_sum`'s `v.get(i)` failed the build on the
/// machine layer only (test_windows_ct_public_loops). A user function that
/// is not @constant_time is still rejected.
fn ng_ct_exempt_callee(name: str) -> bool {
    return str_starts_with(name, "p_") || str_starts_with(name, "__") || str_starts_with(name, "pert_") || str_starts_with(name, "pe_") || str_starts_with(name, "nat_") || str_starts_with(name, "Vec_") || str_starts_with(name, "HashMap_") || str_starts_with(name, "Str_");
}

/// "" when the function is clean, else one line per violation.
/// The machine-level half of J7: what only the final MIR shows (a divide
/// instruction, an indirect call, a call of a function that is not
/// @constant_time). Branches are judged on the IR, with taint, by the
/// check pe_ir runs too (checks.fd peir_ct_check, called from the driver
/// loop): a branch on a value derived from a secret is rejected there, a
/// loop on a public counter passes. Before, every conditional branch and
/// every overflow/bounds check (MO_PANICIF) was rejected here, so no
/// @constant_time function with a loop built on this backend; a check
/// whose jump is taken only on a run that ends in a panic executes the
/// same instructions on every run that completes (pe_ir's rule).
fn ng_ct_check(g: &NatGen, rec: &NatFnRec) -> str {
    var errs: str = "";
    var i: i64 = 0;
    while i < rec.mir.len() {
        var m: MInst = rec.mir.get(i);
        var what: str = "";
        if m.op == MO_DIV || m.op == MO_REM {
            what = "integer division (variable latency)";
        }
        if m.op == MO_FBIN && m.i0 == 4 {
            what = "float division (variable latency)";
        }
        if m.op == MO_CALLR {
            what = "indirect call";
        }
        if m.op == MO_CALL {
            if HashMap_get_or_i(g.ct_labels, m.i0, 0) == 0 {
                what = "call to a function that is not @constant_time";
            }
        }
        if what != "" {
            errs = errs + "@constant_time function '" + rec.name + "': " + what + " at MIR " + int_to_str(i) + "\n";
        }
        i = i + 1;
    }
    return errs;
}

// (MI1: the operations' names, mi_op_name, and the printer, mi_text, are
// in compiler/mir.fd.)

/// MI10: the structural MIR verifier (`FID_VERIFY=1`, before allocation,
/// after the peephole and the branch fusion): every operation known; every
/// register operand a vreg of the function or a physical register; every
/// temporary (a vreg past the IR values') read somewhere written somewhere
/// (a temporary belongs to one IR instruction's lowering, so one read
/// with no write is a lowering bug: an IR value's vreg may be read on a
/// path that never sets it, which is the IR verifier's to judge); every
/// jump to a label the function places, each placed once; operand classes
/// (access sizes 1/2/4/8, extension kinds, compare kinds, shift counts,
/// panic kinds); block parameters well formed; the prologue first and
/// nothing falling off the end. The target-independent checks are
/// compiler/mir.fd's mir_verify (MI1); this adds the target's: x86-64's
/// zero operand 60, the vector operations' widths and registers (TG11).
/// The allocation checker (ng_mir_check, RA15) checks the registers after.
fn ng_mir_verify(g: &NatGen, rec: &NatFnRec) -> str {
    var zr: i64 = 0 - 1;
    if ng_x64(g) {
        zr = 60;
    }
    var err: str = mir_verify(rec.name, &rec.mir, rec.nvreg, rec.slots.len(), zr);
    if err != "" {
        return err;
    }
    var k: i64 = 0;
    while k < rec.mir.len() {
        var m2: MInst = rec.mir.get(k);
        if m2.op >= MO_VLD && m2.op <= MO_VEND {
            // TG11: a width the target has, vector registers of the class,
            // a known operation and lane
            var verr: str = ng_vec_verify(g, m2);
            if verr != "" {
                return mir_verify_at(rec.name, k, m2.op) + verr;
            }
        }
        k = k + 1;
    }
    // TG11: no vector value read where no path left it
    return ng_vec_live_check(rec);
}

// --- TG11: vector values and calls ----------------------------------------
// A vector register holds a value from the operation that writes it to the
// ones that read it, and no call may come between: every vector register
// is caller-saved (on --nat Windows the code is treated the same way). A
// value that must outlive a call goes through a frame slot (MO_VST into a
// slot's address, MO_VLD back: ng_vz_vput / ng_vz_vget, the vectorizer's
// spill slots). A state is a mask over the class: bit k, register k holds
// 16 bytes; bit 8 + k, it holds 32 (AVX2). A 32-byte VEND (VZEROUPPER)
// keeps the low 16 bytes only.

/// TG11: state st after register k is written at width w.
fn ng_vlive_def(st: i64, k: i64, w: i64) -> i64 {
    if w == 32 {
        return st | (1 << k) | (1 << (8 + k));
    }
    return (st | (1 << k)) & (0xFFFF ^ (1 << (8 + k)));
}

/// TG11: register k holds w bytes in state st.
fn ng_vlive_has(st: i64, k: i64, w: i64) -> bool {
    if w == 32 {
        return ((st >> (8 + k)) & 1) != 0;
    }
    return ((st >> k) & 1) != 0;
}

/// TG11: the register vector operation m reads without its value being
/// there in state st, -1 when none.
fn ng_vlive_bad(m: MInst, st: i64) -> i64 {
    var op: i64 = m.op;
    var w: i64 = m.i1;
    var a: i64 = m.i2 & 15;
    var b: i64 = (m.i2 >> 4) & 15;
    if op == MO_VST {
        if !ng_vlive_has(st, m.i2, w) {
            return m.i2;
        }
        return 0 - 1;
    }
    if op == MO_VBIN {
        if m.i0 == NVK_XOR && a == b {
            // the zeroing idiom reads nothing
            return 0 - 1;
        }
        if !ng_vlive_has(st, a, w) {
            return a;
        }
        if !ng_vlive_has(st, b, w) {
            return b;
        }
        return 0 - 1;
    }
    if op == MO_VZMASK {
        if !ng_vlive_has(st, a, w) {
            return a;
        }
        if !ng_vlive_has(st, b, w) {
            return b;
        }
        return 0 - 1;
    }
    if op == MO_VBTEST {
        if !ng_vlive_has(st, a, w) {
            return a;
        }
        if !ng_vlive_has(st, b, w) {
            return b;
        }
        return 0 - 1;
    }
    if op == MO_VLANE {
        if !ng_vlive_has(st, a, 16) {
            return a;
        }
    }
    return 0 - 1;
}

/// TG11: the state after operation m.
fn ng_vlive_step(m: MInst, st: i64) -> i64 {
    var op: i64 = m.op;
    if mi_is_call(op) {
        return 0;
    }
    var w: i64 = m.i1;
    if op == MO_VLD || op == MO_VSPLAT {
        return ng_vlive_def(st, m.i2, w);
    }
    if op == MO_VBIN {
        return ng_vlive_def(st, m.i2 & 15, w);
    }
    if op == MO_VZMASK {
        var s1: i64 = ng_vlive_def(st, (m.i2 >> 8) & 15, w);
        return ng_vlive_def(s1, m.i2 & 15, w);
    }
    if op == MO_VLANE && m.i0 == 1 {
        // lane 1 passes through register t (x86-64, RISC-V)
        return ng_vlive_def(st, (m.i2 >> 4) & 15, 16);
    }
    if op == MO_VEND && w == 32 {
        return st & 0xFF;
    }
    return st;
}

/// TG11: "" when every read of a vector register in rec's MIR finds the
/// value on every path into it (a forward must-analysis over the machine
/// blocks), else where it does not (part of ng_mir_verify, FID_VERIFY=1).
fn ng_vec_live_check(rec: &NatFnRec) -> str {
    var n: i64 = rec.mir.len();
    var any: bool = false;
    var k: i64 = 0;
    while k < n && !any {
        var op0: i64 = rec.mir.get(k).op;
        if op0 >= MO_VLD && op0 <= MO_VEND {
            any = true;
        }
        k = k + 1;
    }
    if !any {
        return "";
    }
    var mb: MBlocks = mi_blocks(&rec.mir);
    var nb: i64 = mb.start.len();
    var top: i64 = 0xFFFF;
    var es: Vec<i64> = Vec::new();
    var ed: Vec<i64> = Vec::new();
    var outm: Vec<i64> = Vec::new();
    var inm: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < nb {
        var sl: Vec<i64> = mb.succs.get(b);
        var j: i64 = 0;
        while j < sl.len() {
            es.push(b);
            ed.push(sl.get(j));
            j = j + 1;
        }
        outm.push(top);
        inm.push(top);
        b = b + 1;
    }
    var changed: bool = true;
    while changed {
        changed = false;
        b = 0;
        while b < nb {
            inm.set(b, top);
            b = b + 1;
        }
        if nb > 0 {
            inm.set(0, 0);
        }
        var e: i64 = 0;
        while e < es.len() {
            var d: i64 = ed.get(e);
            inm.set(d, inm.get(d) & outm.get(es.get(e)));
            e = e + 1;
        }
        b = 0;
        while b < nb {
            var st: i64 = inm.get(b);
            var q: i64 = mb.start.get(b);
            while q <= mb.end.get(b) {
                st = ng_vlive_step(rec.mir.get(q), st);
                q = q + 1;
            }
            if st != outm.get(b) {
                outm.set(b, st);
                changed = true;
            }
            b = b + 1;
        }
    }
    b = 0;
    while b < nb {
        var st2: i64 = inm.get(b);
        var q2: i64 = mb.start.get(b);
        while q2 <= mb.end.get(b) {
            var m: MInst = rec.mir.get(q2);
            if m.op >= MO_VLD && m.op <= MO_VEND {
                var bad: i64 = ng_vlive_bad(m, st2);
                if bad >= 0 {
                    return mir_verify_at(rec.name, q2, m.op) + "vector register " + int_to_str(bad) + " read at " + int_to_str(m.i1) + " bytes where some path leaves no value in it (a call or a 32-byte VEND between, or never written)";
                }
            }
            st2 = ng_vlive_step(m, st2);
            q2 = q2 + 1;
        }
        b = b + 1;
    }
    return "";
}

/// TG11: ng_vec_live_check on one small MIR sequence: "" when it accepts
/// it exactly when `ok`.
fn ng_vlive_case(what: str, mir: Vec<MInst>, ok: bool) -> str {
    var rec: NatFnRec = NatFnRec {
        name: "unit", mir: mir, nvreg: NG_VBASE + 2, base_frame: 0, slots: Vec::new(), is_ct: false, sret_v: 0 - 1, sret_size: 0, secret: false
    };
    var err: str = ng_vec_live_check(&rec);
    if ok && err != "" {
        return "TG11: the vector liveness check rejects " + what + ": " + err;
    }
    if !ok && err == "" {
        return "TG11: the vector liveness check accepts " + what;
    }
    return "";
}

/// TG11: the vector liveness check (ng_vec_live_check) on small MIR
/// sequences: a value read after a call, on a path that skips its write,
/// or at 32 bytes after VEND is caught; a loop over a splat, a lane read
/// after VEND, the zeroing idiom and a value through a frame slot around a
/// call (the vectorizer's spill slots) pass. Run with nat_sel_check
/// (FID_VERIFY=1).
pub fn nat_vlive_unit_check() -> str {
    var r: i64 = NG_VBASE;
    var r1: i64 = NG_VBASE + 1;
    // written, then stored
    var m1: Vec<MInst> = Vec::new();
    m1.push(ng_mi(MO_VLD, 0, r, 0, 0, 16, 0));
    m1.push(ng_mi(MO_VST, r, 0, 0, 0, 16, 0));
    m1.push(ng_mi(MO_EPILOGUE, 0, 0, 0, 0, 0, 0));
    var e: str = ng_vlive_case("a load then a store", m1, true);
    if e != "" {
        return e;
    }
    // a call between: every vector register is caller-saved
    var m2: Vec<MInst> = Vec::new();
    m2.push(ng_mi(MO_VLD, 0, r, 0, 0, 16, 0));
    m2.push(ng_mi(MO_CALL, 0, 0, 0, 0, 0, 0));
    m2.push(ng_mi(MO_VST, r, 0, 0, 0, 16, 0));
    m2.push(ng_mi(MO_EPILOGUE, 0, 0, 0, 0, 0, 0));
    e = ng_vlive_case("a vector value held across a call", m2, false);
    if e != "" {
        return e;
    }
    // the same value through a frame slot around the call
    var m3: Vec<MInst> = Vec::new();
    m3.push(ng_mi(MO_VLD, 0, r, 0, 0, 16, 0));
    m3.push(ng_mi(MO_SLOTADDR, r1, 0, 0, 16, 0, 0));
    m3.push(ng_mi(MO_VST, r1, 0, 0, 0, 16, 0));
    m3.push(ng_mi(MO_CALL, 0, 0, 0, 0, 0, 0));
    m3.push(ng_mi(MO_SLOTADDR, r1, 0, 0, 16, 0, 0));
    m3.push(ng_mi(MO_VLD, 0, r1, 0, 0, 16, 2));
    m3.push(ng_mi(MO_VST, r, 0, 0, 0, 16, 2));
    m3.push(ng_mi(MO_EPILOGUE, 0, 0, 0, 0, 0, 0));
    e = ng_vlive_case("a vector value through a frame slot around a call", m3, true);
    if e != "" {
        return e;
    }
    // a 32-byte splat used in a loop, then lane 0 after VEND
    var m4: Vec<MInst> = Vec::new();
    m4.push(ng_mi(MO_VSPLAT, 0, r, 0, 0, 32, 1));
    m4.push(ng_mi(MO_PLACE, 0, 0, 0, 7, 0, 0));
    m4.push(ng_mi(MO_VLD, 0, r, 0, 0, 32, 0));
    m4.push(ng_mi(MO_VBIN, 0, 0, 0, NVK_FADD64, 32, 0 | (1 << 4)));
    m4.push(ng_mi(MO_BNEZ, r, 0, 0, 7, 0, 0));
    m4.push(ng_mi(MO_VEND, 0, 0, 0, 0, 32, 0));
    m4.push(ng_mi(MO_VLANE, r1, 0, 0, 0, 16, 0 | (2 << 4)));
    m4.push(ng_mi(MO_EPILOGUE, 0, 0, 0, 0, 0, 0));
    e = ng_vlive_case("a loop over a splat and a lane after VEND", m4, true);
    if e != "" {
        return e;
    }
    // 32 bytes read after VEND
    var m5: Vec<MInst> = Vec::new();
    m5.push(ng_mi(MO_VSPLAT, 0, r, 0, 0, 32, 1));
    m5.push(ng_mi(MO_VEND, 0, 0, 0, 0, 32, 0));
    m5.push(ng_mi(MO_VST, r, 0, 0, 0, 32, 1));
    m5.push(ng_mi(MO_EPILOGUE, 0, 0, 0, 0, 0, 0));
    e = ng_vlive_case("a 32-byte read after VEND", m5, false);
    if e != "" {
        return e;
    }
    // a path that skips the write
    var m6: Vec<MInst> = Vec::new();
    m6.push(ng_mi(MO_BNEZ, r, 0, 0, 9, 0, 0));
    m6.push(ng_mi(MO_VLD, 0, r, 0, 0, 16, 3));
    m6.push(ng_mi(MO_PLACE, 0, 0, 0, 9, 0, 0));
    m6.push(ng_mi(MO_VST, r, 0, 0, 0, 16, 3));
    m6.push(ng_mi(MO_EPILOGUE, 0, 0, 0, 0, 0, 0));
    e = ng_vlive_case("a read on a path that skips the write", m6, false);
    if e != "" {
        return e;
    }
    // the zeroing idiom, then a copy (ng_vz_vcopy)
    var m7: Vec<MInst> = Vec::new();
    m7.push(ng_mi(MO_VLD, 0, r, 0, 0, 16, 0));
    m7.push(ng_mi(MO_VBIN, 0, 0, 0, NVK_XOR, 16, 2 | (2 << 4)));
    m7.push(ng_mi(MO_VBIN, 0, 0, 0, NVK_OR, 16, 2 | (0 << 4)));
    m7.push(ng_mi(MO_VST, r, 0, 0, 0, 16, 2));
    m7.push(ng_mi(MO_EPILOGUE, 0, 0, 0, 0, 0, 0));
    e = ng_vlive_case("a copy through the zeroing idiom", m7, true);
    if e != "" {
        return e;
    }
    // an operand never written
    var m8: Vec<MInst> = Vec::new();
    m8.push(ng_mi(MO_VLD, 0, r, 0, 0, 16, 0));
    m8.push(ng_mi(MO_VBIN, 0, 0, 0, NVK_ADD64, 16, 0 | (3 << 4)));
    m8.push(ng_mi(MO_EPILOGUE, 0, 0, 0, 0, 0, 0));
    return ng_vlive_case("an operand never written", m8, false);
}

/// MI1: block parameters on the machine IR (FID_NAT_ON=bparams; not in
/// @constant_time code, whose check judged the MIR as recorded). The
/// function's MIR goes into block-parameter form (mir_bparams_form: a vreg
/// several operations write becomes a value per write, and labeled blocks
/// take the values live into them as parameters), which FID_VERIFY=1
/// checks (mir_verify with the block-parameter rules, and SSA:
/// mir_bparams_ssa_check), then out of it (mir_bparams_lower: moves on the
/// edges, edge blocks after the end for taken branches that pass
/// arguments), and the result is verified again. The allocator, its
/// liveness and the checker (ng_mir_check) then see ordinary MIR. "" or
/// the error.
fn ng_bparams_round(g: &mut NatGen, rec: &mut NatFnRec) -> str {
    // (MI27: a jump table's entries take no edge moves)
    if !ng_opt_in("bparams") || rec.is_ct || mi_has_jtab(&rec.mir) {
        return "";
    }
    var orig: Vec<MInst> = rec.mir;
    var fm: MirBp = mir_bparams_form(&orig, rec.nvreg, rec.sret_v);
    if fm.nvreg == rec.nvreg {
        // no vreg is written twice (or the function takes a label's address)
        return "";
    }
    var zr: i64 = 0 - 1;
    if ng_x64(g) {
        zr = 60;
    }
    ng_dump_mir(rec.name, "block parameters", &fm.mir);
    if ng_verify_on() {
        var ferr: str = mir_verify(rec.name, &fm.mir, fm.nvreg, rec.slots.len(), zr);
        if ferr == "" {
            ferr = mir_bparams_ssa_check(rec.name, &orig, &fm.mir, fm.nvreg, rec.sret_v);
        }
        if ferr != "" {
            return "block parameters: " + ferr;
        }
    }
    var label0: i64 = g.e.labels.len();
    var lw: MirBp = mir_bparams_lower(&fm.mir, fm.nvreg, label0);
    if lw.err != "" {
        return "block parameters: " + rec.name + ": " + lw.err;
    }
    var li: i64 = 0;
    while li < lw.n_labels {
        var lab: i64 = NatEnc_label(&mut g.e);
        if lab != label0 + li {
            return "block parameters: " + rec.name + ": edge label " + int_to_str(lab) + " where " + int_to_str(label0 + li) + " was expected";
        }
        li = li + 1;
    }
    ng_dump_mir(rec.name, "block parameters taken out", &lw.mir);
    if ng_verify_on() {
        var lerr: str = mir_verify(rec.name, &lw.mir, lw.nvreg, rec.slots.len(), zr);
        if lerr != "" {
            return "block parameters out: " + lerr;
        }
    }
    rec.mir = lw.mir;
    rec.nvreg = lw.nvreg;
    if g_nat_stats {
        p_eprint_str("[bparams] " + rec.name + ": " + int_to_str(fm.n_params) + " parameters, " + int_to_str(lw.n_labels) + " edge blocks, " + int_to_str(lw.nvreg - fm.nvreg) + " cycle temporaries\n");
    }
    return "";
}

fn ng_mir_check(g: &NatGen, rec: &NatFnRec, mb: &MBlocks, al: &NatAlloc, calls: &Vec<i64>, masks: &Vec<i64>) -> str {
    var nv: i64 = rec.nvreg - NG_VBASE;
    var mir: Vec<MInst> = rec.mir;
    // RA10: every register a value holds is in the pool of its class (the
    // class the allocator decided for its copy class: al.cls)
    var vcls: Vec<i64> = al.cls;
    // MI25: every call clobbers each float register (none is callee-saved)
    var fmask: i64 = ng_float_mask(g);
    var ci: i64 = 0;
    while ci < nv {
        var cr: i64 = al.assign.get(ci);
        if cr >= 0 && !ng_class_has(g, vcls.get(ci), cr) {
            var cname: str = "integer";
            if vcls.get(ci) == NG_RC_FLOAT {
                cname = "f64";
            }
            if vcls.get(ci) == NG_RC_F32 {
                cname = "f32";
            }
            return rec.name + ": v" + int_to_str(ci + NG_VBASE) + " (" + cname + " class) holds register " + int_to_str(cr) + ", which is not in its class's pool";
        }
        if cr >= 0 && ng_float_callee_has(g, cr) && !ng_ao_has(&al.save_regs, cr) {
            // RA18: a callee-saved float register the function changes
            // must be in its save area
            return rec.name + ": v" + int_to_str(ci + NG_VBASE) + " holds callee-saved float register " + int_to_str(cr - NG_FREG) + ", which the function does not save";
        }
        ci = ci + 1;
    }
    var sel: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        sel.push(i);
        i = i + 1;
    }
    var words: i64 = (nv + 63) / 64;
    if words == 0 {
        return "";
    }
    var lin: Vec<i64> = Vec::new();
    var lout: Vec<i64> = Vec::new();
    mi_liveness(&mir, mb, &sel, words, &mut lin, &mut lout);
    var call_at: i64 = HashMap_new();
    i = 0;
    while i < calls.len() {
        HashMap_insert(call_at, int_to_str(calls.get(i)), masks.get(i));
        i = i + 1;
    }
    var b: i64 = 0;
    while b < mb.start.len() {
        var live: Vec<i64> = Vec::new();
        var cnt: Vec<i64> = Vec::new();
        i = 0;
        // (64: float registers are NG_FREG + f, MI25)
        while i < 64 {
            cnt.push(0);
            i = i + 1;
        }
        i = 0;
        while i < words {
            live.push(lout.get(b * words + i));
            i = i + 1;
        }
        i = 0;
        while i < nv {
            if (live.get(i / 64) & (1 << (i % 64))) != 0 && al.assign.get(i) >= 0 {
                cnt.set(al.assign.get(i), cnt.get(al.assign.get(i)) + 1);
            }
            i = i + 1;
        }
        var k: i64 = mb.end.get(b);
        while k >= mb.start.get(b) {
            var m: MInst = mir.get(k);
            if mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 - NG_VBASE < nv {
                var dv: i64 = m.r0 - NG_VBASE;
                var dr: i64 = al.assign.get(dv);
                if dr >= 0 {
                    var mine: i64 = 0;
                    if (live.get(dv / 64) & (1 << (dv % 64))) != 0 {
                        mine = 1;
                    }
                    var others: i64 = cnt.get(dr) - mine;
                    // a move into the register its source already holds
                    // writes the same value
                    if others > 0 && !(m.op == MO_MOV && m.r1 >= NG_VBASE && al.assign.get(m.r1 - NG_VBASE) == dr) {
                        return rec.name + ": instruction " + int_to_str(k) + " writes register " + int_to_str(dr) + " while another live value holds it";
                    }
                }
            }
            if mi_is_call(m.op) {
                var cm: i64 = HashMap_get(call_at, int_to_str(k)) | fmask;
                var r: i64 = 0;
                while r < 64 {
                    if (cm & (1 << r)) != 0 && cnt.get(r) > 0 {
                        return rec.name + ": the call at " + int_to_str(k) + " clobbers register " + int_to_str(r) + ", which holds a live value";
                    }
                    r = r + 1;
                }
            }
            // live = (live - defs) + uses
            if mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 - NG_VBASE < nv {
                var d2: i64 = m.r0 - NG_VBASE;
                if (live.get(d2 / 64) & (1 << (d2 % 64))) != 0 {
                    live.set(d2 / 64, live.get(d2 / 64) & ~(1 << (d2 % 64)));
                    if al.assign.get(d2) >= 0 {
                        cnt.set(al.assign.get(d2), cnt.get(al.assign.get(d2)) - 1);
                    }
                }
            }
            var um: i64 = mi_use_mask(m.op);
            var f: i64 = 0;
            while f < 3 {
                if (um & (1 << f)) != 0 {
                    var u: i64 = mi_field(m, f) - NG_VBASE;
                    if u >= 0 && u < nv && (live.get(u / 64) & (1 << (u % 64))) == 0 {
                        live.set(u / 64, live.get(u / 64) | (1 << (u % 64)));
                        if al.assign.get(u) >= 0 {
                            cnt.set(al.assign.get(u), cnt.get(al.assign.get(u)) + 1);
                        }
                    }
                }
                f = f + 1;
            }
            k = k - 1;
        }
        b = b + 1;
    }
    // RA7: values in argument registers against the registers' own
    // arguments and results and the operations that use them unnamed
    var aerr: str = ng_mir_check_args(g, rec, mb, al);
    if aerr != "" {
        return aerr;
    }
    // RA4: a split function (ng_mir_alloc_split) reads, at every read, a
    // vreg holding the value the original read, and is the original but
    // for the split's moves and edge blocks
    if g_ng_split_src.len() > 0 && g_ng_split_src.len() == rec.mir.len() {
        var sbase: Vec<MInst> = g_ng_split_base;
        var sorig: Vec<i64> = g_ng_split_orig;
        var ssrc: Vec<i64> = g_ng_split_src;
        return ng_split_check(rec.name, &sbase, &mir, mb, &sorig, &ssrc);
    }
    return "";
}

// --- Emission -----------------------------------------------------------

/// Emit a recorded function with its allocation: each operation through the
/// architecture layer with physical registers.
/// RA17: spills, reloads and moves per function (`fid emit --stats`).
/// RA6: the MO_MOV `m` emits code under allocation `al`: its two sides are
/// not one register, nor one frame slot (coalesced spilled vregs share
/// their representative's slot), as ng_mir_emit_pass decides.
fn ng_mov_emits(m: MInst, al: &NatAlloc, nv: i64) -> bool {
    var d: i64 = m.r0;
    var s: i64 = m.r1;
    if d >= NG_VBASE && d - NG_VBASE < nv {
        d = al.assign.get(m.r0 - NG_VBASE);
        if d < 0 {
            if ng_remat_is(al.remat.get(m.r0 - NG_VBASE)) {
                // MI8: into a spilled rematerialized vreg (a move inside
                // its copy class): ng_mir_emit_pass emits nothing
                return false;
            }
            if s >= NG_VBASE && s - NG_VBASE < nv && al.assign.get(s - NG_VBASE) < 0 {
                var si: i64 = s - NG_VBASE;
                if !ng_remat_is(al.remat.get(m.r0 - NG_VBASE)) && !ng_remat_is(al.remat.get(si)) && al.spill.get(si) == al.spill.get(m.r0 - NG_VBASE) {
                    return false;
                }
            }
            return true;
        }
    }
    if s >= NG_VBASE && s - NG_VBASE < nv {
        s = al.assign.get(m.r1 - NG_VBASE);
        if s < 0 {
            return true;
        }
    }
    return d != s;
}

fn ng_mir_stats(rec: &NatFnRec, al: &NatAlloc) {
    var nv: i64 = rec.nvreg - NG_VBASE;
    var nsp: i64 = 0;
    var nrl: i64 = 0;
    var nmv: i64 = 0;
    var i: i64 = 0;
    while i < nv {
        if al.assign.get(i) == 0 - 1 {
            nsp = nsp + 1;
        }
        i = i + 1;
    }
    var k: i64 = 0;
    while k < rec.mir.len() {
        var m: MInst = rec.mir.get(k);
        // (RA6: a move the allocation made a move to itself is not counted:
        // it emits nothing)
        if (m.op == MO_MOV && ng_mov_emits(m, al, nv)) || m.op == MO_COPY {
            nmv = nmv + 1;
        }
        var um: i64 = mi_use_mask(m.op);
        var f: i64 = 0;
        while f < 3 {
            if (um & (1 << f)) != 0 {
                var v: i64 = mi_field(m, f) - NG_VBASE;
                if v >= 0 && v < nv && al.assign.get(v) < 0 {
                    nrl = nrl + 1;
                }
            }
            f = f + 1;
        }
        k = k + 1;
    }
    // (MI8: the frame in bytes, outgoing area, spill slots and save area)
    p_eprint_str("[stats] " + rec.name + ": spilled " + int_to_str(nsp) + ", reloads " + int_to_str(nrl) + ", moves " + int_to_str(nmv) + ", frame " + int_to_str(al.frame) + "\n");
    // DB8: why each spilled IR value spilled (at most 20 per function): its
    // range crosses a call (every caller-saved register is lost there), or
    // more ranges were live than the allocator has registers
    var shown: i64 = 0;
    var vi: i64 = 0;
    while vi < nv && vi < rec.slots.len() && shown < 20 {
        if al.assign.get(vi) == 0 - 1 {
            var first: i64 = 0 - 1;
            var last: i64 = 0 - 1;
            var q: i64 = 0;
            while q < rec.mir.len() {
                var mq: MInst = rec.mir.get(q);
                var fq: i64 = 0;
                while fq < 3 {
                    if mi_field(mq, fq) == vi + NG_VBASE {
                        if first < 0 {
                            first = q;
                        }
                        last = q;
                    }
                    fq = fq + 1;
                }
                q = q + 1;
            }
            if first >= 0 {
                var why: str = "register pressure (more ranges live than registers)";
                var c: i64 = first + 1;
                while c < last {
                    if mi_is_call(rec.mir.get(c).op) {
                        why = "live across a call";
                        c = last;
                    }
                    c = c + 1;
                }
                p_eprint_str("[remark] fn " + rec.name + ": v" + int_to_str(vi) + " spilled: " + why + "\n");
                shown = shown + 1;
            }
        }
        vi = vi + 1;
    }
}

/// WP8: may the allocated function `rec` run without a frame? No call
/// (its return address would be lost on AArch64 and RISC-V, and a callee
/// may need sp aligned), no panic (a trace needs the frame record), no
/// callee-saved register to save, and nothing on the stack: no slot
/// operation, no incoming or outgoing stack argument, no spilled vreg other
/// than a rematerialized constant or global address. `FID_NAT_OFF=leaf`:
/// every function keeps its frame.
fn ng_leaf_ok(g: &NatGen, rec: &NatFnRec, al: &NatAlloc) -> bool {
    if al.save_regs.len() > 0 || !ng_on("leaf") {
        return false;
    }
    var nv: i64 = rec.nvreg - NG_VBASE;
    var k: i64 = 0;
    while k < rec.mir.len() {
        var m: MInst = rec.mir.get(k);
        var op: i64 = m.op;
        if mi_is_call(op) || op == MO_SLOTADDR || op == MO_LDSLOT || op == MO_STSLOT || op == MO_LDIN || op == MO_STOUT || op == MO_PANICIF || op == MO_TRAP {
            return false;
        }
        var um: i64 = mi_use_mask(op);
        var f: i64 = 0;
        while f < 3 {
            var v: i64 = mi_field(m, f);
            var touched: bool = (um & (1 << f)) != 0 || (f == 0 && mi_defines(op));
            if touched && v >= NG_VBASE && v - NG_VBASE < nv {
                var vi: i64 = v - NG_VBASE;
                if al.assign.get(vi) < 0 {
                    var rk: i64 = al.remat.get(vi);
                    if rk != NG_REMAT_LI && rk != NG_REMAT_ADDR {
                        return false;
                    }
                }
            }
            f = f + 1;
        }
        k = k + 1;
    }
    return true;
}

/// OP13: may the calls of `rec` become jumps at all? Not in @constant_time
/// code. A function that takes its frame's address (MO_SLOTADDR: a local,
/// a struct result or a spawn's arguments handed to a callee by address
/// would be gone with the frame) is judged per call (MI28: ng_tail_taint:
/// a call none of whose arguments may carry a frame address); with
/// `FID_NAT_OFF=tailframe` it gets no jumps at all, as before. A call with
/// arguments on the stack is judged per call (MI28: ng_tail_stack_ok).
/// `FID_NAT_OFF=tailcall`: never. LF20: nor in a function holding a secret
/// whose returns zero the scratch registers (ng_wipe_regs: a jump would
/// leave them, the callee's arguments among them).
fn ng_tail_fn_ok(g: &NatGen, rec: &NatFnRec) -> bool {
    if rec.is_ct || !ng_on("tailcall") {
        return false;
    }
    if rec.secret && ng_on("wipe") && ng_on("wiperegs") {
        return false;
    }
    if ng_on("tailframe") {
        return true;
    }
    var k: i64 = 0;
    while k < rec.mir.len() {
        var op: i64 = rec.mir.get(k).op;
        if op == MO_SLOTADDR {
            return false;
        }
        k = k + 1;
    }
    return true;
}

/// MI28: which calls of `rec` may pass the address of its own frame.
/// Empty: none can (the function never takes its frame's address, or
/// `FID_NAT_OFF=tailframe`, where ng_tail_fn_ok already refused such a
/// function). Otherwise one entry per MIR index: 1 at a call (MO_CALL /
/// MO_CALLR) one of whose arguments (a register its window sets, or a
/// stack one: an MO_STOUT in its window) may hold a frame address, and 1
/// everywhere when such an address may escape: stored to memory, or
/// handed to a callee that may keep it or give it back (ng_ft_settle's
/// summaries; a callee outside the recorded functions, an indirect call),
/// or when the analysis does not settle. Only a call at a 0 may become a
/// jump: after the jump the frame is the callee's.
///
/// The analysis (ng_ft_run, mode 0): a frame address starts at
/// MO_SLOTADDR (or a read of the stack or frame register) and flows
/// through every operation that computes a register from registers
/// (moves, adds, selects, ...: ng_ft_deft). A load gives a clean value:
/// no frame address is ever in memory unless one escaped (then every call
/// is marked). Virtual registers are tracked for the whole function (a
/// promoted local is written in several places: one tainted write taints
/// it); physical registers per block, forward over the machine blocks
/// (every call reuses the argument and result registers, and leaves only
/// the callee-saved ones). A call's arguments are the registers set in its
/// window (ng_load_args sets each one there; the callee reads no other).
/// A callee whose summary is clean neither keeps nor returns anything
/// derived from what it is given (it may read through it), so a call to
/// it that receives a frame address keeps only itself from being a jump.
/// With the function cache (FID_FNCACHE) the summaries are the same
/// (SP20): a replayed callee's comes from its entry (ng_ft_esc_map), and a
/// replayed caller is kept only while the summaries it read still hold
/// (nc_deps_ok, nc_ft_hold).
/// A function of more than 40000 operations: every call is marked.
fn ng_tail_taint(g: &NatGen, rec: &NatFnRec) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if !ng_on("tailframe") {
        return out;
    }
    var n: i64 = rec.mir.len();
    var has: bool = false;
    var k: i64 = 0;
    while k < n && !has {
        if rec.mir.get(k).op == MO_SLOTADDR {
            has = true;
        }
        k = k + 1;
    }
    if !has {
        return out;
    }
    var all: bool = n > 40000;
    var res: Vec<i64> = Vec::new();
    // SP20: with the function cache too (a hit's summary is its entry's,
    // ng_ft_esc_map), so a build with the cache makes the jumps one
    // without it makes
    var esc: i64 = ng_ft_esc_map(g);
    var tries: i64 = 0;
    var done: bool = all;
    while !done {
        var pend: Vec<i64> = Vec::new();
        res = ng_ft_run(g, rec, 0, esc, 0, &mut pend);
        if res.get(n) != 0 {
            all = true;
            done = true;
        } else if pend.len() == 0 {
            done = true;
        } else {
            tries = tries + 1;
            if tries > 8 {
                all = true;
                done = true;
            } else {
                ng_ft_settle(g, esc, &pend);
            }
        }
    }
    k = 0;
    while k < n {
        if all {
            out.push(1);
        } else {
            out.push(res.get(k));
        }
        k = k + 1;
    }
    return out;
}

/// SP5 / MI28: the taint marks ng_mir_emit_pass reads (g.tc_taint) for
/// `rec`: ng_tail_taint's, made when one of its calls could become a jump
/// (ng_tail_fn_ok, ng_tail_at, as the pass asks them), else none. Made
/// once per function, before its emission (ng_mir_emit; the parallel
/// emission makes every function's on the main thread, in placement
/// order, ng_par_finish): ng_tail_taint fills module-level summaries,
/// so the marks of a function depend on which functions were analysed
/// before it, and the order must be the serial one.
fn ng_tail_pre(g: &NatGen, rec: &NatFnRec, al: &NatAlloc) -> Vec<i64> {
    var none: Vec<i64> = Vec::new();
    if !ng_tail_fn_ok(g, rec) {
        return none;
    }
    var place: i64 = HashMap_new();
    var k: i64 = 0;
    while k < rec.mir.len() {
        var pm: MInst = rec.mir.get(k);
        if pm.op == MO_PLACE {
            HashMap_insert(place, int_to_str(pm.i0), k);
        }
        k = k + 1;
    }
    k = 0;
    while k < rec.mir.len() {
        if rec.mir.get(k).op == MO_CALL && ng_tail_at(g, rec, al, k, place) {
            return ng_tail_taint(g, rec);
        }
        k = k + 1;
    }
    return none;
}

// MI28: g.recs by name (index + 1) for ng_ft_rec_index, the length of
// g.recs it was built from, and the callee summaries settled so far
// (label -> 1 clean, 2 may keep or return what it is given). ng_mir_finish
// clears them for each build (ng_ft_reset); a different g.recs rebuilds
// them.
var g_ng_ft_names: i64 = 0;
var g_ng_ft_nrecs: i64 = 0 - 1;
var g_ng_ft_esc: i64 = 0;

fn ng_ft_reset() {
    g_ng_ft_names = 0;
    g_ng_ft_nrecs = 0 - 1;
    g_ng_ft_esc = 0;
}

/// MI28: the name index and summaries belong to this g.recs (else both
/// start again).
fn ng_ft_names_check(g: &NatGen) {
    if g_ng_ft_names != 0 && g_ng_ft_nrecs == g.recs.len() {
        return;
    }
    g_ng_ft_names = HashMap_new();
    var i: i64 = 0;
    while i < g.recs.len() {
        var rn: NatFnRec = g.recs.get(i);
        HashMap_insert(g_ng_ft_names, rn.name, i + 1);
        i = i + 1;
    }
    g_ng_ft_nrecs = g.recs.len();
    g_ng_ft_esc = 0;
}

/// SP20: the settled summaries (g_ng_ft_esc), made when there are none
/// yet. With the function cache each hit's summary is there from the
/// start, its entry's (ft_self; 2 when the entry has none): its MIR here
/// is a skeleton (nc_skel_fn), never analysed.
fn ng_ft_esc_map(g: &NatGen) -> i64 {
    ng_ft_names_check(g);
    if g_ng_ft_esc == 0 {
        g_ng_ft_esc = HashMap_new();
        if g.nc_on {
            var i: i64 = 0;
            while i < g.nc_hit_names.len() {
                var hn: str = g.nc_hit_names.get(i);
                var hix: i64 = nc_hit_at(g, hn);
                if hix != 0 && HashMap_contains(g.fn_labels, hn) {
                    var ft: i64 = g.nc_old.get(hix - 1).ft_self;
                    if ft == 0 {
                        ft = 2;
                    }
                    HashMap_insert(g_ng_ft_esc, int_to_str(HashMap_get(g.fn_labels, hn)), ft);
                }
                i = i + 1;
            }
        }
    }
    return g_ng_ft_esc;
}

/// MI28: the index in g.recs of the function at `label`; -1 for anything
/// else (a runtime stub, an import, a primitive).
fn ng_ft_rec_index(g: &NatGen, label: i64) -> i64 {
    var lk: str = int_to_str(label);
    if !HashMap_contains(g.label_fn, lk) {
        return 0 - 1;
    }
    var name: str = HashMap_get(g.label_fn, lk);
    ng_ft_names_check(g);
    if !HashMap_contains(g_ng_ft_names, name) {
        return 0 - 1;
    }
    var ix: i64 = HashMap_get(g_ng_ft_names, name) - 1;
    if ix < 0 || ix >= g.recs.len() {
        return 0 - 1;
    }
    var rx: NatFnRec = g.recs.get(ix);
    if rx.name != name {
        return 0 - 1;
    }
    return ix;
}

/// MI28: the summary of the callee at `label` for ng_ft_run: 1 it keeps
/// and returns nothing derived from its arguments, 2 it may, 0 not
/// settled yet (a recorded function: ng_ft_run lists it in pend and counts
/// it clean meanwhile). esc: the settled summaries (0: none, every callee
/// may); tent: ng_ft_settle's tentative ones (0: none).
fn ng_ft_callee(g: &NatGen, label: i64, esc: i64, tent: i64) -> i64 {
    if esc == 0 {
        return 2;
    }
    var key: str = int_to_str(label);
    if HashMap_contains(esc, key) {
        return HashMap_get(esc, key);
    }
    if tent != 0 && HashMap_contains(tent, key) {
        return HashMap_get(tent, key);
    }
    if ng_ft_rec_index(g, label) < 0 {
        return 2;
    }
    return 0;
}

/// MI28: settles into esc the summaries (ng_ft_run, mode 1) of the
/// recorded functions at the labels in pend and of every function they
/// hand an argument to. The least fixed point: the group starts clean and
/// each member is analysed again while one of them changes (taint only
/// grows, so it settles); past 64 functions or 32 rounds the whole group
/// escapes.
fn ng_ft_settle(g: &NatGen, esc: i64, pend: &Vec<i64>) {
    var tent: i64 = HashMap_new();
    var group: Vec<i64> = Vec::new();
    var gix: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < pend.len() {
        var l: i64 = pend.get(i);
        var key: str = int_to_str(l);
        if !HashMap_contains(esc, key) && !HashMap_contains(tent, key) {
            var ix: i64 = ng_ft_rec_index(g, l);
            if ix < 0 {
                HashMap_insert(esc, key, 2);
            } else {
                HashMap_insert(tent, key, 1);
                group.push(l);
                gix.push(ix);
            }
        }
        i = i + 1;
    }
    var giveup: bool = false;
    var changed: bool = group.len() > 0;
    var rounds: i64 = 0;
    while changed && !giveup {
        changed = false;
        rounds = rounds + 1;
        i = 0;
        while i < group.len() && !giveup {
            var r: NatFnRec = g.recs.get(gix.get(i));
            var more: Vec<i64> = Vec::new();
            var res: Vec<i64> = ng_ft_run(g, &r, 1, esc, tent, &mut more);
            var st: i64 = 1;
            if res.get(r.mir.len()) != 0 {
                st = 2;
            }
            var key2: str = int_to_str(group.get(i));
            if HashMap_get(tent, key2) != st {
                HashMap_insert(tent, key2, st);
                changed = true;
            }
            var j: i64 = 0;
            while j < more.len() {
                var l2: i64 = more.get(j);
                var key3: str = int_to_str(l2);
                if !HashMap_contains(esc, key3) && !HashMap_contains(tent, key3) {
                    var ix2: i64 = ng_ft_rec_index(g, l2);
                    if ix2 < 0 {
                        HashMap_insert(esc, key3, 2);
                    } else {
                        HashMap_insert(tent, key3, 1);
                        group.push(l2);
                        gix.push(ix2);
                    }
                    changed = true;
                }
                j = j + 1;
            }
            if group.len() > 64 {
                giveup = true;
            }
            i = i + 1;
        }
        if changed && rounds >= 32 {
            giveup = true;
        }
    }
    i = 0;
    while i < group.len() {
        var key4: str = int_to_str(group.get(i));
        if giveup {
            HashMap_insert(esc, key4, 2);
        } else {
            HashMap_insert(esc, key4, HashMap_get(tent, key4));
        }
        i = i + 1;
    }
}

/// MI28: one taint analysis of `rec`. Mode 0: the roots are this frame's
/// addresses (MO_SLOTADDR, a read of the stack or frame register); mode 1:
/// the function's own arguments (the argument registers at entry,
/// MO_LDIN), for its summary. Returns one entry per MIR index (1: a call
/// that receives a tainted value), then one more: 1 when a tainted value
/// escapes — stored to memory, handed to a callee whose summary is not
/// clean (ng_ft_callee), in mode 1 also returned (in a result register at
/// an epilogue, written there by the function: not an incoming argument
/// left in place) — or the analysis does not settle in 32 rounds. The
/// labels of recorded callees handed a tainted value before they have a
/// summary go to pend, once each, counted clean meanwhile. A function that
/// takes the address of one of its own labels (a jump through it, past
/// the blocks' edges) escapes.
fn ng_ft_run(g: &NatGen, rec: &NatFnRec, mode: i64, esc: i64, tent: i64, pend: &mut Vec<i64>) -> Vec<i64> {
    var n: i64 = rec.mir.len();
    var nv: i64 = rec.nvreg - NG_VBASE;
    var ct: Vec<i64> = Vec::new();
    var vt: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < n {
        ct.push(0);
        k = k + 1;
    }
    k = 0;
    while k < nv {
        vt.push(0);
        k = k + 1;
    }
    var escaped: bool = false;
    var placed: i64 = HashMap_new();
    k = 0;
    while k < n {
        var mp: MInst = rec.mir.get(k);
        if mp.op == MO_PLACE {
            HashMap_insert(placed, int_to_str(mp.i0), 1);
        }
        k = k + 1;
    }
    k = 0;
    while k < n {
        var ma: MInst = rec.mir.get(k);
        if ma.op == MO_ADDR && HashMap_contains(placed, int_to_str(ma.i0)) {
            escaped = true;
        }
        k = k + 1;
    }
    var mb: MBlocks = mi_blocks(&rec.mir);
    var nb: i64 = mb.start.len();
    // per block: the tainted physical registers at its start, those still
    // holding an incoming argument (mode 1) and those a definition wrote
    var ine: Vec<i64> = Vec::new();
    var ind: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < nb {
        ine.push(0);
        ind.push(0);
        b = b + 1;
    }
    var argmask: i64 = 0;
    var i: i64 = 0;
    while i < g.td.nregargs_int {
        var ar: i64 = ng_argreg_i(g, i, true);
        if ar >= 0 && ar < 63 {
            argmask = argmask | (1 << ar);
        }
        i = i + 1;
    }
    if mode == 1 && nb > 0 {
        ine.set(0, argmask);
    }
    var rmask: i64 = (1 << g.td.result_reg) | (1 << ng_argreg(g, 0)) | (1 << ng_argreg(g, 1));
    // what a call clobbers (the caller-saved pool, the argument and result
    // registers); any other register keeps what it held
    var keep: i64 = 0 - 1 - (g.td.int_caller_mask | argmask | rmask);
    var changed: bool = !escaped && nb > 0;
    var rounds: i64 = 0;
    while changed {
        changed = false;
        rounds = rounds + 1;
        b = 0;
        while b < nb && !escaped {
            var e: i64 = ine.get(b);
            var d: i64 = ind.get(b);
            // the window of the next call: the registers set since the
            // last call (or the block's start), and whether a tainted
            // stack argument was stored
            var wdef: i64 = 0;
            var wout: bool = false;
            k = mb.start.get(b);
            while k <= mb.end.get(b) && !escaped {
                var m: MInst = rec.mir.get(k);
                var op: i64 = m.op;
                var cur: i64 = e | d;
                if mi_is_call(op) {
                    var tainted: bool = wout || (wdef & argmask & cur) != 0;
                    if op == MO_CALLR && ng_ft_val(g, mode, m.r0, &vt, cur) {
                        tainted = true;
                    }
                    if tainted {
                        if ct.get(k) == 0 {
                            ct.set(k, 1);
                            changed = true;
                        }
                        var cs: i64 = 2;
                        if op == MO_CALL {
                            cs = ng_ft_callee(g, m.i0, esc, tent);
                        }
                        if cs == 2 {
                            escaped = true;
                        } else if cs == 0 {
                            var listed: bool = false;
                            var pi: i64 = 0;
                            while pi < pend.len() {
                                if pend.get(pi) == m.i0 {
                                    listed = true;
                                }
                                pi = pi + 1;
                            }
                            if !listed {
                                pend.push(m.i0);
                            }
                        }
                    }
                    // a call clobbers the registers outside keep; its
                    // result is clean (from a callee that is not, the
                    // function escaped already)
                    e = e & keep;
                    d = d & keep;
                    wdef = 0;
                    wout = false;
                } else {
                    if op == MO_PROLOGUE {
                        wdef = 0;
                        wout = false;
                    }
                    var st: bool = false;
                    var sv: i64 = 0;
                    if op == MO_STORE || op == MO_STX || op == MO_VSPLAT {
                        st = true;
                        sv = m.r1;
                    } else if op == MO_STSLOT {
                        st = true;
                        sv = m.r0;
                    } else if op == MO_ALUMST && ((m.i1 >> 4) & 15) == 0 {
                        st = true;
                        sv = m.r1;
                    }
                    if st && ng_ft_val(g, mode, sv, &vt, cur) {
                        escaped = true;
                    }
                    if op == MO_STOUT && ng_ft_val(g, mode, m.r0, &vt, cur) {
                        wout = true;
                    }
                    if mode == 1 && op == MO_EPILOGUE && (d & rmask) != 0 {
                        escaped = true;
                    }
                    if mi_defines(op) {
                        var t: bool = ng_ft_deft(g, mode, m, &vt, cur);
                        if m.r0 >= NG_VBASE {
                            var vi: i64 = m.r0 - NG_VBASE;
                            if vi < nv && t && vt.get(vi) == 0 {
                                vt.set(vi, 1);
                                changed = true;
                            }
                        } else if m.r0 >= 0 && m.r0 < 63 {
                            var bit: i64 = 1 << m.r0;
                            e = e & (0 - 1 - bit);
                            if t {
                                d = d | bit;
                            } else {
                                d = d & (0 - 1 - bit);
                            }
                            wdef = wdef | bit;
                        }
                    }
                }
                k = k + 1;
            }
            var sl: Vec<i64> = mb.succs.get(b);
            var si: i64 = 0;
            while si < sl.len() {
                var s: i64 = sl.get(si);
                if (ine.get(s) | e) != ine.get(s) {
                    ine.set(s, ine.get(s) | e);
                    changed = true;
                }
                if (ind.get(s) | d) != ind.get(s) {
                    ind.set(s, ind.get(s) | d);
                    changed = true;
                }
                si = si + 1;
            }
            b = b + 1;
        }
        if escaped {
            changed = false;
        }
        if changed && rounds >= 32 {
            escaped = true;
            changed = false;
        }
    }
    if escaped {
        ct.push(1);
    } else {
        ct.push(0);
    }
    return ct;
}

/// MI28: the call at k may not become a jump (ng_tail_taint's marks;
/// empty: every call may).
fn ng_tail_tainted(taint: &Vec<i64>, k: i64) -> bool {
    return k >= 0 && k < taint.len() && taint.get(k) != 0;
}

/// MI28: a physical register that holds this frame's own address when
/// read (x86-64 rsp and rbp, AArch64 fp, RISC-V sp and s0).
fn ng_ft_stackreg(g: &NatGen, p: i64) -> bool {
    if ng_x64(g) {
        return p == 4 || p == 5;
    }
    if ng_a64(g) {
        return p == A64_FP;
    }
    return p == RV_SP || p == RV_S0;
}

/// MI28: may register operand v hold a tainted value (ng_ft_run), given
/// the tainted virtual registers vt and physical ones cur? Mode 0 also
/// counts a read of the stack or frame register; the zero register never.
fn ng_ft_val(g: &NatGen, mode: i64, v: i64, vt: &Vec<i64>, cur: i64) -> bool {
    if v >= NG_VBASE {
        var vi: i64 = v - NG_VBASE;
        if vi < vt.len() {
            return vt.get(vi) != 0;
        }
        return true;
    }
    if v == g.zr || v == 60 || v < 0 || v >= 63 {
        return false;
    }
    if mode == 0 && ng_ft_stackreg(g, v) {
        return true;
    }
    return ((cur >> v) & 1) != 0;
}

/// MI28: is the value operation m defines tainted (ng_ft_run)? A frame
/// slot's address is in mode 0, an incoming stack argument in mode 1; a
/// constant, a global's address, a loaded value or a compare's 0 / 1 never
/// is; anything else is when an operand it reads is.
fn ng_ft_deft(g: &NatGen, mode: i64, m: MInst, vt: &Vec<i64>, cur: i64) -> bool {
    var op: i64 = m.op;
    if op == MO_SLOTADDR {
        return mode == 0;
    }
    if op == MO_LDIN {
        return mode == 1;
    }
    if op == MO_BPARAM {
        return true;
    }
    if op == MO_LI || op == MO_ADDR || op == MO_LOAD || op == MO_LDX || op == MO_LDSLOT || op == MO_SETCC || op == MO_SETCCM || op == MO_FCMP || op == MO_VLANE {
        return false;
    }
    if op == MO_ALUM {
        // r1 op *(r2 + i0): the loaded word is clean
        return ng_ft_val(g, mode, m.r1, vt, cur);
    }
    var um: i64 = mi_use_mask(op);
    var f: i64 = 0;
    while f < 3 {
        if (um & (1 << f)) != 0 && ng_ft_val(g, mode, mi_field(m, f), vt, cur) {
            return true;
        }
        f = f + 1;
    }
    return false;
}

/// MI28: the window of the call at k: the positions before it, back to
/// the previous call, label, branch or prologue (where its argument
/// stores are).
fn ng_tail_window_start(rec: &NatFnRec, k: i64) -> i64 {
    var j: i64 = k - 1;
    while j >= 0 {
        var op: i64 = rec.mir.get(j).op;
        if mi_is_call(op) || op == MO_PLACE || mi_is_br(op) || op == MO_PROLOGUE || op == MO_EPILOGUE || op == MO_TRAP {
            return j + 1;
        }
        j = j - 1;
    }
    return 0;
}

/// MI28: may the call at k pass its stack arguments in this function's own
/// incoming argument area (ng_st_incoming), so that it can be a jump? Each
/// of its MO_STOUTs (in its window) has an index below the number of
/// stack parameters this function loads (one more than its highest
/// MO_LDIN index: every stack parameter is loaded once, at entry; a
/// parameter never loaded only makes the count smaller), and no MO_LDIN
/// follows the first of them (it would read a slot already overwritten).
/// The callee is entered with this function's entry stack pointer, so its
/// k-th stack argument is read from the same slot. Without stack
/// arguments: true.
fn ng_tail_stack_ok(rec: &NatFnRec, k: i64) -> bool {
    var w: i64 = ng_tail_window_start(rec, k);
    var nout: i64 = 0;
    var j: i64 = w;
    while j < k {
        if rec.mir.get(j).op == MO_STOUT {
            nout = nout + 1;
        }
        j = j + 1;
    }
    if nout == 0 {
        return true;
    }
    var nin: i64 = 0;
    j = 0;
    while j < rec.mir.len() {
        var m: MInst = rec.mir.get(j);
        if m.op == MO_LDIN && m.i0 + 1 > nin {
            nin = m.i0 + 1;
        }
        j = j + 1;
    }
    var stored: bool = false;
    j = w;
    while j < k {
        var m2: MInst = rec.mir.get(j);
        if m2.op == MO_STOUT {
            if m2.i0 < 0 || m2.i0 >= nin {
                return false;
            }
            stored = true;
        }
        if m2.op == MO_LDIN && stored {
            return false;
        }
        j = j + 1;
    }
    return true;
}

/// OP13: the physical register of operand `v` after allocation (-1: a
/// spilled vreg).
fn ng_tail_phys(al: &NatAlloc, v: i64, nv: i64) -> i64 {
    if v < NG_VBASE {
        return v;
    }
    if v - NG_VBASE >= nv {
        return 0 - 1;
    }
    return al.assign.get(v - NG_VBASE);
}

/// F8: does `rec` itself return a struct in two registers (ng_rr_plan:
/// g.rr_size of its own label above 8 bytes)? Then no call of it is a
/// jump: its return sets the second result register too (`mov x1, ...`
/// before the epilogue), and after a jump the caller would read whatever
/// the callee left there. ng_tail_at tracks the first result register
/// only. Seen as `StringBuilder::new()` returning
/// `{ handle: p_sb_new(), len: 0 }`: with SRA (iropt_me ime_sra) the struct
/// became two vregs, the call of p_sb_new a jump, and `len` the callee's x1
/// (sb.len() printed an address on AArch64, bench_stringbuilder,
/// test_lang_features).
fn ng_tail_own_rr2(g: &NatGen, rec: &NatFnRec) -> bool {
    if !HashMap_contains(g.fn_labels, rec.name) {
        return false;
    }
    var own: i64 = HashMap_get(g.fn_labels, rec.name);
    return HashMap_contains_i(g.rr_size, own) && HashMap_get_i(g.rr_size, own) > 8;
}

/// MI28 (2g.98): the extension each recorded function's narrow result
/// leaves in the result register (name -> 1 + NEXT_*; bool NEXT_ZB): M7
/// keeps a narrow value extended as its type says (ng_narrow_kind), so a
/// Fides function returns one so. Filled as functions are recorded
/// (ng_ret_ext_note), cleared at the start of each image (a function the
/// cache replays has no entry: its calls keep their extension).
var g_ng_ret_ext: i64 = 0;

fn ng_ret_ext_reset() {
    g_ng_ret_ext = HashMap_new();
}

fn ng_ret_ext_note(name: str, ty: IrType) {
    if g_ng_ret_ext == 0 {
        g_ng_ret_ext = HashMap_new();
    }
    var kind: i64 = ng_narrow_kind(ty);
    if ir_type_eq(ty, IrType::Bool) {
        kind = NEXT_ZB;
    }
    if kind > 0 {
        HashMap_insert(g_ng_ret_ext, name, 1 + kind);
    }
}

/// MI28 (2g.98): does the result of a call to label `label` already satisfy
/// extension `kind`? Then `ext d, s, kind` of that result keeps it as it is
/// (a bool result stored into a promoted bool local after inlining), and
/// the call may still become a jump: the callee leaves its result extended
/// (ng_ret_ext_note). Seen as is_odd's call of itself (is_even inlined)
/// staying a call on AArch64 and RISC-V, tests/nattools/tailcall_deep.fd.
fn ng_tail_ext_kept(g: &NatGen, label: i64, kind: i64) -> bool {
    var key: str = int_to_str(label);
    if g_ng_ret_ext == 0 || !HashMap_contains(g.label_fn, key) {
        return false;
    }
    var name: str = HashMap_get(g.label_fn, key);
    if !HashMap_contains(g_ng_ret_ext, name) {
        return false;
    }
    var ck: i64 = HashMap_get(g_ng_ret_ext, name) - 1;
    return kind >= NEXT_SB && kind <= NEXT_ZW && ng_ext_keeps(ck, kind);
}

/// OP13: is the MO_CALL at `k` a sibling call in tail position? Its target
/// is a compiled Fides function (not a primitive or an import thunk, not
/// one returning in two registers), and from the call, through moves,
/// constants, line rows, labels and jumps only, the path reaches an
/// epilogue with the call's result still in the result register (tracked
/// over the physical registers the allocation gave: `mov v, x0; ...; mov
/// x0, v` keeps it, anything else written there loses it).
fn ng_tail_at(g: &NatGen, rec: &NatFnRec, al: &NatAlloc, k: i64, place: i64) -> bool {
    var m: MInst = rec.mir.get(k);
    if !HashMap_contains(g.label_fn, int_to_str(m.i0)) || HashMap_contains_i(g.rr_size, m.i0) {
        return false;
    }
    if ng_tail_own_rr2(g, rec) {
        return false;
    }
    // MI28: stack arguments only where they fit the incoming area
    if !ng_tail_stack_ok(rec, k) {
        return false;
    }
    var nv: i64 = rec.nvreg - NG_VBASE;
    var a: i64 = ng_argreg(g, 0);
    var res: i64 = 1 << a;
    var j: i64 = k + 1;
    var steps: i64 = 0;
    while j < rec.mir.len() && steps < 64 {
        var t: MInst = rec.mir.get(j);
        steps = steps + 1;
        if t.op == MO_EPILOGUE {
            return (res & (1 << a)) != 0;
        }
        if t.op == MO_LINE || t.op == MO_PLACE {
            j = j + 1;
        } else if t.op == MO_JMP {
            var tk: str = int_to_str(t.i0);
            if !HashMap_contains(place, tk) {
                return false;
            }
            j = HashMap_get(place, tk) + 1;
        } else if t.op == MO_MOV || t.op == MO_LI {
            var pd: i64 = ng_tail_phys(al, t.r0, nv);
            if pd < 0 || pd >= 63 {
                return false;
            }
            var held: bool = false;
            if t.op == MO_MOV {
                var ps: i64 = ng_tail_phys(al, t.r1, nv);
                if ps < 0 || ps >= 63 {
                    return false;
                }
                held = (res & (1 << ps)) != 0;
            }
            if held {
                res = res | (1 << pd);
            } else {
                res = res & (0 - 1 - (1 << pd));
            }
            j = j + 1;
        } else if t.op == MO_EXT && ng_tail_ext_kept(g, m.i0, t.i0) {
            // (2g.98: an extension the callee's result already satisfies
            // copies it)
            var ed: i64 = ng_tail_phys(al, t.r0, nv);
            var es: i64 = ng_tail_phys(al, t.r1, nv);
            if ed < 0 || ed >= 63 || es < 0 || es >= 63 {
                return false;
            }
            if (res & (1 << es)) != 0 {
                res = res | (1 << ed);
            } else {
                res = res & (0 - 1 - (1 << ed));
            }
            j = j + 1;
        } else {
            return false;
        }
    }
    return false;
}

/// TG6: branch relaxation. The function is emitted with every branch in
/// its long form (x86-64 rel32; RISC-V B<inverse> over JAL, calls AUIPC +
/// JALR), which records where each branch ends and the label it targets.
/// A branch whose target, measured in that layout, stays in reach of the
/// short form however the layout changes is marked short, and the function
/// is emitted again from the same position. Shortening only brings code
/// closer together; the one thing that can grow is a loop head's alignment
/// padding (MI30), so every aligned head between a branch and its target
/// counts with its largest padding. Targets: local labels (the function's
/// blocks and cold panic blocks), and on RISC-V the callees already placed
/// (before this function: a call can only come closer to them). AArch64
/// needs nothing (every form is one word). A short branch found out of
/// reach anyway is a build error in NatEnc_resolve, never a wrong jump.
/// `FID_NAT_OFF=relax`: every branch long, as before.
fn ng_mir_emit(g: &mut NatGen, rec: &NatFnRec, al: &NatAlloc) {
    // SP5: the tables emission reads, and MI28's marks of the calls that
    // may pass this frame's address (once per function: both passes below
    // use the same marks)
    ng_emit_tables();
    var taint: Vec<i64> = ng_tail_pre(g, rec, al);
    g.tc_taint = taint;
    var n0: i64 = g.ldfwd_n;
    ng_mir_emit_w(g, rec, al);
    g_nat_ldfwd_n = g_nat_ldfwd_n + g.ldfwd_n - n0;
}

/// SP5: `--stats` text about the function being emitted: on stderr, or
/// on a worker's generator kept for the join to print in order.
fn ng_stat_text(g: &mut NatGen, s: str) {
    if g.par_w {
        g.par_log = g.par_log + s;
    } else {
        p_eprint_str(s);
    }
}

/// ng_mir_emit's emission with g.tc_taint already made: what a worker of
/// the parallel emission runs (SP5). It and what it calls write no module
/// global (tests/nattools/par_emit_globals.py checks every function the
/// spawned ng_par_thread reaches).
fn ng_mir_emit_w(g: &mut NatGen, rec: &NatFnRec, al: &NatAlloc) {
    var none: Vec<i64> = Vec::new();
    var bpos: Vec<i64> = Vec::new();
    var blab: Vec<i64> = Vec::new();
    var heads: Vec<i64> = Vec::new();
    var c0: i64 = g.e.code.len();
    var f0: i64 = g.e.fixups.len();
    var l0: i64 = g.lrows.len();
    var cf0: i64 = g.cfi_rows.len();
    var open0: bool = g.lrow_open;
    var lf0: i64 = g.ldfwd_n;
    if g_nat_stats {
        // RA12: what the prologue saves, and at how many other places the
        // rest are saved (`fid emit --stats`)
        var swp: Vec<i64> = ng_sw_plan(g, rec, al);
        if swp.len() > 2 {
            var npts: i64 = 0;
            var nrest: i64 = 0;
            var sq: i64 = 0;
            while sq < rec.mir.len() {
                if swp.get(2 + 3 * sq) != 0 {
                    npts = npts + 1;
                }
                if swp.get(4 + 3 * sq) != 0 {
                    nrest = nrest + 1;
                }
                sq = sq + 1;
            }
            ng_stat_text(g, "[shrinkwrap] " + rec.name + ": the prologue saves " + int_to_str(al.save_regs.len() - swp.get(1)) + " of " + int_to_str(al.save_regs.len()) + " callee-saved registers, the others at " + int_to_str(npts) + " later points, restored early at " + int_to_str(nrest) + "\n");
        }
    }
    ng_mir_emit_pass(g, rec, al, &none, &mut bpos, &mut blab, &mut heads);
    if !ng_on("relax") {
        return;
    }
    if ng_a64(g) {
        // TG8: on AArch64 only TBZ / TBNZ has a short form (+-32 KB)
        var has_tb: bool = false;
        var tk: i64 = 0;
        while tk < rec.mir.len() {
            if rec.mir.get(tk).op == MO_TBNZ {
                has_tb = true;
            }
            tk = tk + 1;
        }
        if !has_tb {
            return;
        }
    }
    var c1: i64 = g.e.code.len();
    var padw: i64 = ng_code_align(g, NG_ALIGN_LOOP) - 1;
    var short: Vec<i64> = Vec::new();
    var nshort: i64 = 0;
    var k: i64 = 0;
    while k < rec.mir.len() {
        var ok: i64 = 0;
        var at: i64 = bpos.get(k);
        if at >= 0 {
            var t: i64 = g.e.labels.get(blab.get(k));
            if rec.mir.get(k).op == MO_CALL {
                // RISC-V JAL ra: +-1 MB (SP6: under the CS6 cache too; a
                // replay whose callee is no longer in reach is built again,
                // nc_replay)
                if t >= 0 && t <= c0 && at - t <= 1040000 {
                    ok = 1;
                }
            } else if rec.mir.get(k).op == MO_JMP && !ng_x64(g) {
                // RISC-V's jump is one JAL already: nothing shorter
                ok = 0;
            } else if t >= c0 && t <= c1 {
                var lo: i64 = t;
                var hi: i64 = at;
                if t > at {
                    lo = at;
                    hi = t;
                }
                var pad: i64 = 0;
                var h: i64 = 0;
                while h < heads.len() {
                    if heads.get(h) >= lo && heads.get(h) <= hi {
                        pad = pad + padw;
                    }
                    h = h + 1;
                }
                if ng_a64(g) {
                    // TG8: TBZ / TBNZ counts from its own start, 8 bytes
                    // before the end of the long form (TBZ-inverse + B)
                    if rec.mir.get(k).op == MO_TBNZ && ((t >= at && t - at + 8 + pad <= 32764) || (t < at && t - at + 8 - pad >= 0 - 32768)) {
                        ok = 1;
                    }
                } else if ng_x64(g) {
                    // rel8 from the end of the short jump, which ends no
                    // later than the long one did (forward) and no further
                    // from the target (backward)
                    if (t >= at && t - at + pad <= 127) || (t < at && t - at - pad >= 0 - 128) {
                        ok = 1;
                    }
                } else {
                    // B<cc> counts from its own start: 4 bytes before the
                    // end of the short form
                    if (t >= at && t - at + 4 + pad <= 4094) || (t < at && t - at + 4 - pad >= 0 - 4096) {
                        ok = 1;
                    }
                }
            }
        }
        short.push(ok);
        nshort = nshort + ok;
        k = k + 1;
    }
    if nshort == 0 {
        return;
    }
    // Again from the same position: what the first pass wrote goes (its
    // fresh labels stay unplaced-for-good and nothing refers to them)
    g.e.code.truncate(c0);
    g.e.fixups.truncate(f0);
    g.lrows.truncate(l0);
    g.cfi_rows.truncate(cf0);
    g.lrow_open = open0;
    g.ldfwd_n = lf0;
    ng_mir_emit_pass(g, rec, al, &short, &mut bpos, &mut blab, &mut heads);
}

/// One emission of a recorded function (ng_mir_emit). `short`: per MIR
/// index, 1 when that branch takes its short form (empty: none). Fills
/// `bpos` / `blab` per MIR index with where a relaxable branch or call ends
/// and the label it targets (-1: not one), and `heads` with the positions
/// where loop-head alignment padding went.
fn ng_mir_emit_pass(g: &mut NatGen, rec: &NatFnRec, al: &NatAlloc, short: &Vec<i64>, bpos: &mut Vec<i64>, blab: &mut Vec<i64>, heads_at: &mut Vec<i64>) {
    bpos.clear();
    blab.clear();
    heads_at.clear();
    var bi: i64 = 0;
    while bi < rec.mir.len() {
        bpos.push(0 - 1);
        blab.push(0);
        bi = bi + 1;
    }
    var rv_calls: bool = !ng_x64(g) && !ng_a64(g);
    // MI25: values in float registers (ng_fregs_on)
    var fr_on: bool = ng_fregs_on(g);
    var memop_on: bool = ng_post_rule(g, "memop");
    // TG7: compares against a spilled operand's slot, read-modify-writes
    // of a spilled destination's slot (x86-64); TG8: loads and stores with
    // writeback (AArch64)
    var cmpslot_on: bool = ng_post_rule(g, "cmpslot");
    var rmwslot_on: bool = ng_post_rule(g, "rmwslot");
    var wb_on: bool = ng_post_rule(g, "wbidx");
    // TG17: load after store (ng_post_rules "ldfwd"): the vreg whose spill
    // slot the previous instruction stored, and the register it stored
    // from (-1: none; forgotten at a label)
    var fwd_on: bool = ng_post_rule(g, "ldfwd");
    var fwd_vi: i64 = 0 - 1;
    var fwd_r: i64 = 0 - 1;
    // TG17: the forward also survives register moves that leave the
    // stored register alone (ng_post_rules "ldfwdmov")
    var ldfwdmov_on: bool = fwd_on && ng_post_rule(g, "ldfwdmov");
    g.br_short = false;
    g.rec = false;
    g.save_regs = al.save_regs;
    g.save_off = al.save_off;
    g.frame = al.frame;
    // WP8: a function that calls nothing, cannot panic and touches no stack
    // is a leaf — its prologue is nothing and its epilogue only a return
    // (ng_leaf_ok; the allocator's frame is never 0, so testing it never
    // let a function be one).
    g.leaf = 0;
    if ng_leaf_ok(g, rec, al) {
        g.leaf = 1;
    }
    // LF20: a function holding a secret wipes its frame below the register
    // save area at every epilogue (`FID_NAT_OFF=wipe`: never)
    g.wipe = 0;
    if rec.secret && g.leaf == 0 && ng_on("wipe") {
        g.wipe = al.save_off;
    }
    // LF20: and zeroes the registers no call keeps, leaf or not
    // (ng_wipe_regs; `FID_NAT_OFF=wiperegs`: not those)
    ng_wipe_setup(g, rec, al.mask);
    // OP13: sibling calls in tail position become jumps (ng_tail_at)
    var tc_on: bool = ng_tail_fn_ok(g, rec);
    var nv: i64 = rec.nvreg - NG_VBASE;
    g.x0_reg = 0 - 1;
    g.x1_reg = 0 - 1;
    // MI6: the function's cold panic blocks, [which, line, label] each, by
    // "which:line" (`FID_NAT_OFF=coldpanic`: each check calls its stub
    // inline, as before)
    var cold_on: bool = ng_on("coldpanic");
    var cold_keys: i64 = HashMap_new();
    var cold_list: Vec<i64> = Vec::new();
    // RA12 / DB6: for each cold block, the deferred saves made where its
    // checks branch to it (ng_dbg_sw_states), for its CFI rows
    var cold_sw: Vec<i64> = Vec::new();
    // MI30: the labels a later jump reaches back to (loop heads).
    var heads: i64 = HashMap_new();
    var place: i64 = HashMap_new();
    var hp: i64 = 0;
    while hp < rec.mir.len() {
        var hm: MInst = rec.mir.get(hp);
        if hm.op == MO_PLACE {
            HashMap_insert(place, int_to_str(hm.i0), hp);
        }
        hp = hp + 1;
    }
    hp = 0;
    while hp < rec.mir.len() {
        var hm2: MInst = rec.mir.get(hp);
        if mi_is_br(hm2.op) && HashMap_contains(place, int_to_str(hm2.i0)) && HashMap_get(place, int_to_str(hm2.i0)) < hp {
            HashMap_insert(heads, int_to_str(hm2.i0), 1);
        }
        hp = hp + 1;
    }
    // OP13 / MI28: which calls become jumps, decided before emission since
    // the stack arguments of such a call (its MO_STOUTs, emitted before
    // it) go to the incoming argument area instead (ng_st_incoming)
    var tail_call: Vec<i64> = Vec::new();
    var to_incoming: Vec<i64> = Vec::new();
    hp = 0;
    while hp < rec.mir.len() {
        tail_call.push(0);
        to_incoming.push(0);
        hp = hp + 1;
    }
    if tc_on {
        // MI28: not a call that may pass this frame's address (analysed
        // once per function before its emission, ng_tail_pre: g.tc_taint)
        var tc_taint: Vec<i64> = g.tc_taint;
        hp = 0;
        while hp < rec.mir.len() {
            var tc_cand: bool = rec.mir.get(hp).op == MO_CALL && ng_tail_at(g, rec, al, hp, place);
            if tc_cand && !ng_tail_tainted(&tc_taint, hp) {
                tail_call.set(hp, 1);
                var ws: i64 = ng_tail_window_start(rec, hp);
                while ws < hp {
                    if rec.mir.get(ws).op == MO_STOUT {
                        to_incoming.set(ws, 1);
                    }
                    ws = ws + 1;
                }
            }
            hp = hp + 1;
        }
    }
    // RA12: where the callee-saved registers are saved and which each exit
    // restores (ng_sw_plan); only where the prologue is this function's
    // own (not a leaf)
    var swp: Vec<i64> = Vec::new();
    if g.leaf == 0 {
        swp = ng_sw_plan(g, rec, al);
    }
    // DB6: the deferred saves in the CFI (ng_dbg_sw_states: which have run
    // where each instruction starts; sw_cur: what the rows say so far)
    var sw_st: Vec<i64> = ng_dbg_sw_states(rec, &swp);
    var sw_cur: i64 = 0;
    var k: i64 = 0;
    while k < rec.mir.len() {
        var m: MInst = rec.mir.get(k);
        // CT6: where instruction k starts (its variables' live ranges)
        ng_dbg_mark(g, rec, k);
        // DB6: a block's state where its code starts (a label's: after
        // its alignment, below)
        if k < sw_st.len() && m.op != MO_PLACE {
            sw_cur = ng_dbg_sw_to(g, sw_cur, sw_st.get(k));
        }
        if !ng_xc_keeps(m.op) {
            g.x0_reg = 0 - 1;
            g.x1_reg = 0 - 1;
        }
        if m.op == MO_PLACE || !fwd_on {
            // TG17: another path may reach a label
            fwd_vi = 0 - 1;
        }
        var set_vi: i64 = 0 - 1;
        var set_r: i64 = 0 - 1;
        var keep_fwd: bool = false;
        g.sw_pro = 0 - 1;
        g.sw_ep = 0 - 1;
        if swp.len() > 2 {
            if m.op == MO_PROLOGUE {
                g.sw_pro = swp.get(0);
            }
            // (an epilogue, or a call that becomes a tail jump:
            // ng_epilogue / ng_epilogue_tail; -1 elsewhere)
            g.sw_ep = swp.get(3 + 3 * k);
        }
        var p0: i64 = m.r0;
        var p1: i64 = m.r1;
        var p2: i64 = m.r2;
        var um: i64 = mi_use_mask(m.op);
        var store_off: i64 = 0 - 1;
        var skip_def: bool = false;
        var loaded_v: i64 = 0 - 1;
        var loaded_p: i64 = 0 - 1;
        var nscr: i64 = 0;
        // MI25: a float register's value read by an operation on general
        // registers (fb_v, moved to fb_p), and the float register a value
        // that operation writes goes to afterwards (fdef_r, -1: none)
        var fb_v: i64 = 0 - 1;
        var fb_p: i64 = 0 - 1;
        var fdef_r: i64 = 0 - 1;
        var fdef_w32: bool = false;
        // TG7: x86-64 reads a spilled second operand of an ALU operation
        // from its slot (the operation's memory form), no load first
        var mem_off: i64 = 0 - 1;
        // TG7: a compare (BRCC, SETCC) reading one spilled operand from its
        // slot (cm_off; cm_swap: the left one, so the compare is swapped),
        // and an operation whose destination and left operand share one
        // spilled slot, done on the slot (rmw_off: fields 0 and 1 are
        // neither loaded nor stored)
        var cm_off: i64 = 0 - 1;
        var cm_swap: bool = false;
        var rmw_off: i64 = 0 - 1;
        if rmwslot_on {
            rmw_off = ng_rmw_slot(m, al, nv);
        }
        var f: i64 = 0;
        while f < 3 {
            var v: i64 = mi_field(m, f);
            var used: bool = (um & (1 << f)) != 0;
            var defd: bool = f == 0 && mi_defines(m.op);
            var p: i64 = v;
            if rmw_off >= 0 && f < 2 {
                // (TG7: the slot itself)
                used = false;
                defd = false;
            }
            if (used || defd) && v >= NG_VBASE && v - NG_VBASE < nv {
                var vi: i64 = v - NG_VBASE;
                var r: i64 = al.assign.get(vi);
                if r >= 0 && fr_on && m.op != MO_MOV && ng_is_freg(g, r) && ng_float_slot(m, f) == 0 && !ng_float_direct(m, f, al.cls.get(vi)) {
                    // MI25: the operation takes general registers (not a
                    // load, store or lane move of the class's width, which
                    // takes the float register itself: ng_float_direct): the
                    // value goes through the spill scratch register this
                    // operand would use if it were spilled (a move between
                    // classes in place of the load), and a value it writes
                    // is moved to its float register after it
                    var w32: bool = al.cls.get(vi) == NG_RC_F32;
                    p = ng_spill_reg(g, 2);
                    if used {
                        if v == fb_v {
                            p = fb_p;
                        } else {
                            p = ng_spill_reg(g, nscr);
                            ng_fmov_any(g, p, r, w32);
                            ng_xc_kill(g, p);
                            if p == fwd_r {
                                // BG57: the stored register (TG17's
                                // forward) holds this float operand now: a
                                // later operand of the same instruction
                                // must load the stored vreg from its slot
                                fwd_vi = 0 - 1;
                            }
                            fb_v = v;
                            fb_p = p;
                            nscr = nscr + 1;
                        }
                    }
                    if defd {
                        fdef_r = r;
                        fdef_w32 = w32;
                    }
                } else if r >= 0 {
                    p = r;
                } else if used && f == 2 && v != loaded_v && memop_on && rmw_off < 0 && ng_x64_memop(m.op, p0, p1) && !ng_remat_is(al.remat.get(vi)) {
                    mem_off = al.spill.get(vi);
                    p = 0 - 1;
                } else if used && cmpslot_on && cm_off < 0 && v != loaded_v && ng_cmp_slot_field(m, f) && !ng_remat_is(al.remat.get(vi)) {
                    // TG7: compared with its slot (ng_x64_cmp_slot)
                    cm_off = al.spill.get(vi);
                    cm_swap = (m.op == MO_BRCC && f == 0) || (m.op == MO_SETCC && f == 1);
                    p = 0 - 1;
                } else if used {
                    if v == loaded_v {
                        // (the register it was loaded into: the second
                        // scratch register when another operand came first)
                        p = loaded_p;
                    } else {
                        p = ng_spill_reg(g, nscr);
                        if m.op != MO_MOV {
                            ng_ld_fwd(g, p, al, vi, fwd_vi, fwd_r);
                            ng_xc_kill(g, p);
                            if p == fwd_r {
                                // TG17: the stored register now holds vi
                                // (also read from its slot)
                                fwd_vi = vi;
                            }
                        }
                        loaded_v = v;
                        loaded_p = p;
                        nscr = nscr + 1;
                    }
                    if defd {
                        // MI24: an operand read and written (MO_CSEL's r0)
                        // is loaded into its scratch register above and
                        // stored back from it after the operation
                        store_off = al.spill.get(vi);
                    }
                } else {
                    p = ng_spill_reg(g, 2);
                    if ng_remat_is(al.remat.get(vi)) {
                        // RA8: this is the value's one definition, and each
                        // use computes it again: nothing to emit here
                        skip_def = true;
                    } else {
                        store_off = al.spill.get(vi);
                    }
                }
            }
            if f == 0 {
                p0 = p;
            } else if f == 1 {
                p1 = p;
            } else {
                p2 = p;
            }
            f = f + 1;
        }
        if m.op == MO_PLACE && HashMap_contains(heads, int_to_str(m.i0)) {
            // MI30: align a loop head only when the padding can never be
            // executed — the previous emitting op (over MO_LINE) is an
            // unconditional jump or a trap.
            var pb: i64 = k - 1;
            while pb >= 0 && rec.mir.get(pb).op == MO_LINE {
                pb = pb - 1;
            }
            if pb >= 0 && (rec.mir.get(pb).op == MO_JMP || rec.mir.get(pb).op == MO_TRAP) {
                heads_at.push(NatEnc_pos(&g.e));
                NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_LOOP));
            }
        }
        if m.op == MO_MOV {
            // Moves to and from slots directly
            var sv: i64 = m.r1;
            var src_spilled: bool = sv >= NG_VBASE && sv - NG_VBASE < nv && al.assign.get(sv - NG_VBASE) < 0;
            // MI25: a side in a float register: the move crosses classes
            // where the other side is a general register or a slot (an
            // f32 moves as its 32 bits, zero-extended in a general one)
            var mf0: bool = fr_on && ng_is_freg(g, p0);
            var mf1: bool = fr_on && ng_is_freg(g, p1);
            var mw32: bool = false;
            if fr_on && m.r0 >= NG_VBASE && m.r0 - NG_VBASE < nv && al.cls.get(m.r0 - NG_VBASE) == NG_RC_F32 {
                mw32 = true;
            }
            if fr_on && sv >= NG_VBASE && sv - NG_VBASE < nv && al.cls.get(sv - NG_VBASE) == NG_RC_F32 {
                mw32 = true;
            }
            if skip_def {
            // MI8: the destination is a spilled rematerialized vreg,
            // computed again at each use; the move is inside its copy
            // class (ng_mir_alloc), so there is nothing to move
            } else if src_spilled && store_off >= 0 && store_off == al.spill.get(sv - NG_VBASE) && !ng_remat_is(al.remat.get(sv - NG_VBASE)) {
            // RA6: a copy between coalesced vregs that share one slot
            // (MI8) moves nothing
            } else if src_spilled && store_off >= 0 {
                ng_ld_fwd(g, p1, al, sv - NG_VBASE, fwd_vi, fwd_r);
                ng_st_slot(g, store_off, p1);
                set_vi = m.r0 - NG_VBASE;
                set_r = p1;
            } else if src_spilled && mf0 {
                // MI25: the slot into the scratch register, then across
                ng_ld_fwd(g, p1, al, sv - NG_VBASE, fwd_vi, fwd_r);
                ng_fmov_any(g, p0, p1, mw32);
            } else if src_spilled {
                ng_ld_fwd(g, p0, al, sv - NG_VBASE, fwd_vi, fwd_r);
            } else if store_off >= 0 && mf1 {
                // MI25: across into the scratch register, then the slot
                ng_fmov_any(g, p0, p1, mw32);
                ng_st_slot(g, store_off, p0);
                set_vi = m.r0 - NG_VBASE;
                set_r = p0;
            } else if store_off >= 0 {
                ng_st_slot(g, store_off, p1);
                set_vi = m.r0 - NG_VBASE;
                set_r = p1;
            } else if p0 != p1 && (mf0 || mf1) {
                ng_fmov_any(g, p0, p1, mw32);
            } else {
                if p0 != p1 {
                    ng_mov(g, p0, p1);
                }
                // TG17 (ldfwdmov): one register move (or none) between
                // the store and the read leaves the stored register as it
                // was unless it writes it (FID_NAT_MUTATE=ldfwdmov: kept
                // even then, so the ldfwd test sees a wrong forward)
                if ldfwdmov_on && fwd_vi >= 0 && fwd_r >= 0 && (p0 != fwd_r || ng_mutant("ldfwdmov")) {
                    keep_fwd = true;
                }
            }
            if src_spilled || store_off >= 0 {
                ng_xc_kill(g, p0);
                ng_xc_kill(g, p1);
            } else if p0 != p1 {
                // both hold the value now: the cache follows the destination
                var c0: bool = g.x0_reg == p1;
                var c1: bool = g.x1_reg == p1;
                ng_xc_kill(g, p0);
                if c0 {
                    g.x0_reg = p0;
                }
                if c1 {
                    g.x1_reg = p0;
                }
            }
        } else if m.op == MO_PANICIF && cold_on {
            // MI6: the check is one branch to the function's cold block for
            // this panic and line (shared by every check that has both)
            var ckey: str = int_to_str(m.i0) + ":" + int_to_str(m.i1);
            // RA12 / DB6: and the same deferred saves made at the branch
            // (RA12 places none inside an instruction: the state where k
            // starts), so that the block's CFI rows hold for each check
            var csw: i64 = 0;
            if k < sw_st.len() {
                csw = sw_st.get(k);
                ckey = ckey + ":" + int_to_str(csw);
            }
            var cl: i64 = 0;
            if HashMap_contains(cold_keys, ckey) {
                cl = HashMap_get(cold_keys, ckey);
            } else {
                cl = NatEnc_label(&mut g.e);
                HashMap_insert(cold_keys, ckey, cl);
                cold_list.push(m.i0);
                cold_list.push(m.i1);
                cold_list.push(cl);
                cold_sw.push(csw);
            }
            g.br_short = short.len() > k && short.get(k) == 1;
            ng_bnez(g, p0, cl);
            g.br_short = false;
            bpos.set(k, NatEnc_pos(&g.e));
            blab.set(k, cl);
        } else if m.op == MO_STOUT && to_incoming.get(k) == 1 {
            // MI28: a stack argument of a call that becomes a jump
            ng_st_incoming(g, m.i0, p0);
        } else if m.op == MO_CALL && tail_call.get(k) == 1 {
            // OP13: `return g(x)` as a jump (the moves and the epilogue
            // recorded after the call still follow, unreached from here)
            ng_epilogue_tail(g, m.i0);
            g.x0_reg = 0 - 1;
            g.x1_reg = 0 - 1;
        } else if !skip_def || ng_remat_kind(m.op) == 0 {
            // (RA8: a spilled rematerialized value's definition, an MO_LI,
            // MO_ADDR or MO_SLOTADDR that reads no register, emits nothing)
            // (MI27: a jump table's dispatch and entries keep their one
            // form: the entries are data, the dispatch's bounds check is
            // not where its end is)
            var relaxable: bool = (mi_is_br(m.op) && m.op != MO_JTAB && m.op != MO_JTE) || (rv_calls && m.op == MO_CALL);
            if relaxable {
                g.br_short = short.len() > k && short.get(k) == 1;
            }
            if mem_off >= 0 {
                ng_x64_bin_mem(g, m.op, p0, p1, mem_off);
            } else if rmw_off >= 0 {
                ng_x64_rmw_slot(g, m, p2, rmw_off);
            } else if cm_off >= 0 {
                ng_x64_cmp_slot(g, m, p0, p1, p2, cm_off, cm_swap);
            } else {
                ng_mi_dispatch(g, m, p0, p1, p2);
                if wb_on && (m.op == MO_LOAD || m.op == MO_STORE || m.op == MO_ADDI) {
                    // TG8: with the add of the base next to it, one access
                    // with writeback
                    ng_a64_wb_fuse(g);
                }
            }
            if relaxable {
                g.br_short = false;
                bpos.set(k, NatEnc_pos(&g.e));
                blab.set(k, m.i0);
            }
            if mi_defines(m.op) && m.op != MO_FBIN && m.op != MO_I2F {
                ng_xc_kill(g, p0);
            }
            if fdef_r >= 0 {
                // MI25: the result into its float register
                ng_fmov_any(g, fdef_r, p0, fdef_w32);
            }
            if store_off >= 0 {
                ng_st_slot(g, store_off, p0);
                set_vi = m.r0 - NG_VBASE;
                set_r = p0;
            }
        }
        if m.op != MO_LINE && !keep_fwd {
            // TG17: only the next instruction reads the stored register
            // (MO_LINE emits nothing and keeps it; so does a register
            // move that leaves it alone, ldfwdmov)
            fwd_vi = set_vi;
            fwd_r = set_r;
            if mi_is_br(m.op) || m.op == MO_CALL || m.op == MO_CALLR || m.op == MO_PLACE {
                fwd_vi = 0 - 1;
            }
        }
        if k < sw_st.len() && rec.mir.get(k).op == MO_PLACE {
            // DB6: the state of the block this label starts
            sw_cur = ng_dbg_sw_to(g, sw_cur, sw_st.get(k));
        }
        if swp.len() > 2 && (swp.get(2 + 3 * k) != 0 || swp.get(4 + 3 * k) != 0) {
            // (the code below comes between: forget it)
            fwd_vi = 0 - 1;
            if swp.get(4 + 3 * k) != 0 {
                // RA12: registers given back where the ways leave the part
                // of the function that uses them (before the jump that
                // follows, or on the fall-through), first
                ng_restore_subset(g, swp.get(4 + 3 * k));
                g.x0_reg = 0 - 1;
                g.x1_reg = 0 - 1;
                // DB6: back in their registers from here
                sw_cur = ng_dbg_sw_to(g, sw_cur, sw_cur & (0 - 1 - swp.get(4 + 3 * k)));
            }
            if swp.get(2 + 3 * k) != 0 {
                // RA12: the saves deferred to here: after the label of the
                // block that needs them first, or after the instruction
                // that falls into it
                ng_save_subset(g, swp.get(2 + 3 * k));
                // DB6: in their slots from here (ng_dbg_sw_to)
                sw_cur = ng_dbg_sw_to(g, sw_cur, sw_cur | swp.get(2 + 3 * k));
            }
        }
        g.sw_pro = 0 - 1;
        g.sw_ep = 0 - 1;
        k = k + 1;
    }
    // MI6: the cold panic blocks, after the function's last instruction and
    // so still inside its code (a trace names the function from the call's
    // return address; the trap after the call keeps that address inside
    // the function even for its last block). Each calls the shared stub
    // with the message, and the line when the panic has one.
    var ci: i64 = 0;
    while ci + 2 < cold_list.len() {
        var cwhich: i64 = cold_list.get(ci);
        var cline: i64 = cold_list.get(ci + 1);
        NatEnc_place(&mut g.e, cold_list.get(ci + 2));
        // RA12 / DB6: the deferred saves made where its checks branch here
        // (the rows so far describe the function's last instruction)
        if ci / 3 < cold_sw.len() {
            sw_cur = ng_dbg_sw_to(g, sw_cur, cold_sw.get(ci / 3));
        }
        if g.lrow_open && cline > 0 {
            ng_line_row(g, cline);
        }
        g.cur_inst_line = cline;
        var stub: i64 = ng_panic_label(g, cwhich);
        g.cur_inst_line = 0;
        ng_call_label(g, stub);
        ng_trap(g);
        ci = ci + 3;
    }
}

/// A line row at the current position.
fn ng_line_row(g: &mut NatGen, line: i64) {
    // SP5: a worker's generator carries its function's file (line_fix)
    var fix: i64 = g_nat_line_file_ix;
    if g.par_w {
        fix = g.line_fix;
    }
    g.lrows.push(NatEnc_pos(&g.e));
    g.lrows.push(line);
    g.lrows.push(2 * fix);
    // DB1: the row's file (nat_enc.fd's file table; 0 the input file)
    g.lrow_open = true;
}

/// DB1: a line row against file `fx` - 1 of nat_enc.fd's table (code
/// inlined from another file: ng_dbg_inst_file), or, with `fx` 0, against
/// the function's own file (ng_line_row).
fn ng_dbg_line_row_fx(g: &mut NatGen, line: i64, fx: i64) {
    if fx <= 0 {
        ng_line_row(g, line);
        return;
    }
    g.lrows.push(NatEnc_pos(&g.e));
    g.lrows.push(line);
    g.lrows.push(2 * (fx - 1));
    g.lrow_open = true;
}

/// DB1: the file of the row of instruction `id` of `func`, as
/// ng_dbg_line_row_fx takes it: 0 for the function's own file, else 1 +
/// the file-table index of the file the instruction's code was inlined
/// from (ir.fd ir_copy_value_file, recorded by the IR inliners).
fn ng_dbg_inst_file(func: &IrFunction, id: i64) -> i64 {
    if !ir_fn_has_value_files(func.name) {
        return 0;
    }
    var p: str = ir_value_file_rec(func.name, id);
    if str_len(p) == 0 {
        return 0;
    }
    var ix: i64 = nat_line_file_index(p);
    if ix == g_nat_line_file_ix {
        return 0;
    }
    return ix + 1;
}

/// DB1: the file (as ng_dbg_inst_file gives it) of the last line noted, so
/// the same line number in another file starts a row too.
var g_ng_dbg_line_fx: i64 = 0;

/// The end of the open sequence (the function's code ends here).
fn ng_line_close(g: &mut NatGen) {
    if !g.lrow_open {
        return;
    }
    g.lrows.push(NatEnc_pos(&g.e));
    g.lrows.push(0);
    g.lrows.push(1);
    g.lrow_open = false;
}

/// Instruction id's source line, when it starts a new one: a row now, or a
/// MO_LINE recorded for the emission.
fn ng_note_line(g: &mut NatGen, func: &IrFunction, id: i64) {
    var l: i64 = ng_meta_line(func, id);
    if l <= 0 {
        return;
    }
    // DB1: code inlined from another file has its rows against that file
    // (MO_LINE's i1: 0 the function's own, else 1 + the file's index)
    var fx: i64 = ng_dbg_inst_file(func, id);
    if l == g.cur_line && fx == g_ng_dbg_line_fx {
        return;
    }
    g.cur_line = l;
    g_ng_dbg_line_fx = fx;
    if g.rec {
        ng_rec(g, MO_LINE, 0, 0, 0, l, fx, 0);
    } else {
        ng_dbg_line_row_fx(g, l, fx);
    }
}

/// The xmm cache forgets general register r (just written).
fn ng_xc_kill(g: &mut NatGen, r: i64) {
    if g.x0_reg == r {
        g.x0_reg = 0 - 1;
    }
    if g.x1_reg == r {
        g.x1_reg = 0 - 1;
    }
}

/// Operations that write no register but their destination and leave
/// xmm0/xmm1 alone (or keep the cache right themselves): the cache
/// survives them. Anything else (calls, labels, division, shifts, copies,
/// prologues) empties it.
fn ng_xc_keeps(op: i64) -> bool {
    if op == MO_FBIN || op == MO_FCMP || op == MO_I2F || op == MO_F2I || op == MO_F32BITS || op == MO_LINE {
        return true;
    }
    if op == MO_LI || op == MO_MOV || op == MO_LOAD || op == MO_STORE || op == MO_ADDR || op == MO_SLOTADDR {
        return true;
    }
    if op == MO_LDSLOT || op == MO_STSLOT || op == MO_LDIN || op == MO_EXT || op == MO_NEG || op == MO_NOT {
        return true;
    }
    if op == MO_ADD || op == MO_SUB || op == MO_MUL || op == MO_AND || op == MO_OR || op == MO_XOR {
        return true;
    }
    return op == MO_SETCC || op == MO_PANICIF || mi_is_br(op) || op == MO_ADDSHL || op == MO_ANDN || op == MO_BLSR || op == MO_LDX || op == MO_STX || op == MO_ADDI;
}

// RA8: what a rematerialized vreg is computed again from (NatAlloc.remat).
const NG_REMAT_LI: i64 = 1;
const NG_REMAT_ADDR: i64 = 3;
const NG_REMAT_SLOT: i64 = 4;

/// The rematerialization kind of a defining operation: 0 when its value
/// cannot be computed again for free (it reads registers or memory).
fn ng_remat_kind(op: i64) -> i64 {
    if op == MO_LI {
        return NG_REMAT_LI;
    }
    if op == MO_ADDR {
        return NG_REMAT_ADDR;
    }
    if op == MO_SLOTADDR {
        return NG_REMAT_SLOT;
    }
    return 0;
}

fn ng_remat_is(kind: i64) -> bool {
    return kind == NG_REMAT_LI || kind == NG_REMAT_ADDR || kind == NG_REMAT_SLOT;
}

/// r = spilled vreg vi: its constant, global address or slot address
/// again (RA8), or its slot.
fn ng_ld_spilled(g: &mut NatGen, r: i64, al: &NatAlloc, vi: i64) {
    var kind: i64 = al.remat.get(vi);
    if kind == NG_REMAT_LI {
        ng_li(g, r, al.remat_val.get(vi));
    } else if kind == NG_REMAT_ADDR {
        ng_addr(g, r, al.remat_val.get(vi));
    } else if kind == NG_REMAT_SLOT {
        ng_slot_addr(g, r, al.remat_val.get(vi));
    } else {
        ng_ld_slot(g, r, al.spill.get(vi));
    }
}

/// TG17: the rewrites made after allocation, while the allocated MIR is
/// emitted, as each target's row of rule names (the data; FID_NAT_OFF=<rule>
/// turns one off):
///   ldfwd  load after store: a spilled vreg read by the instruction right
///          after the one that stored it to its slot (no label, branch,
///          call or deferred save between) is a register move from the
///          register it was stored from (none when that is the same
///          register), not a load from the slot
///   ldfwdmov  ldfwd past register moves: a move between two registers
///          (or none, when they came out equal) that does not write the
///          stored register leaves the forward standing, so the read
///          after it still takes the register (the moves that set up a
///          call's arguments, copies at a block's end)
///   memop  x86-64 only: a spilled second operand of an ALU operation is
///          read from its slot by the operation itself (TG7)
///   cmpslot  x86-64 only: a compare-and-branch or SETCC with a spilled
///          operand compares with its slot (`cmp r, [rsp + off]`, the
///          compare swapped when it was the left one; `cmp qword [rsp +
///          off], 0` against the zero register) (TG7, ng_x64_cmp_slot)
///   rmwslot  x86-64 only: ADD / SUB / AND / OR / XOR / ADDI whose
///          destination and left operand are spilled to one slot work on
///          the slot (`op [rsp + off], r`, `op qword [rsp + off], imm`)
///          (TG7, ng_rmw_slot)
///   wbidx  AArch64 only: a load or store through n and `add n, n, #c`
///          emitted next to each other are one load or store with
///          writeback (pre- or post-indexed; TG8, ng_a64_wb_fuse)
/// (A move whose registers came out equal emits nothing on every target,
/// and branches to the next block go before allocation, ng_peep.)
fn ng_post_rules(g: &NatGen) -> str {
    if ng_x64(g) {
        return "ldfwd,ldfwdmov,memop,cmpslot,rmwslot";
    }
    if ng_a64(g) {
        return "ldfwd,ldfwdmov,wbidx";
    }
    return "ldfwd,ldfwdmov";
}

/// TG17: post-allocation rule `name` runs for this target.
fn ng_post_rule(g: &NatGen, name: str) -> bool {
    return str_contains("," + ng_post_rules(g) + ",", "," + name + ",") && ng_post_rule_switch(name);
}

/// TG17: the switch of each post-allocation rule (FID_NAT_OFF=<rule>),
/// each spelled out so that scripts/switch-check.sh and
/// scripts/pass-matrix.sh, which read `ng_on("...")` in the source, try
/// every rule with the others.
fn ng_post_rule_switch(name: str) -> bool {
    if name == "ldfwd" {
        return ng_on("ldfwd");
    }
    if name == "ldfwdmov" {
        return ng_on("ldfwdmov");
    }
    if name == "memop" {
        return ng_on("memop");
    }
    if name == "cmpslot" {
        return ng_on("cmpslot");
    }
    if name == "rmwslot" {
        return ng_on("rmwslot");
    }
    if name == "wbidx" {
        return ng_on("wbidx");
    }
    return ng_on(name);
}

/// TG17: r = spilled vreg vi, from register fwd_r when it still holds what
/// the previous instruction stored to vi's slot (fwd_vi == vi), else
/// ng_ld_spilled.
fn ng_ld_fwd(g: &mut NatGen, r: i64, al: &NatAlloc, vi: i64, fwd_vi: i64, fwd_r: i64) {
    if fwd_vi >= 0 && fwd_vi == vi && fwd_r >= 0 {
        // (SP5: counted per generator; ng_mir_emit and the parallel join
        // add it to g_nat_ldfwd_n)
        g.ldfwd_n = g.ldfwd_n + 1;
        if r != fwd_r {
            ng_mov(g, r, fwd_r);
        }
        return;
    }
    ng_ld_spilled(g, r, al, vi);
}

/// TG17: how many slot loads ldfwd replaced in this build (`--stats`).
pub var g_nat_ldfwd_n: i64 = 0;

fn ng_mi_dispatch(g: &mut NatGen, m: MInst, p0: i64, p1: i64, p2: i64) {
    if m.op == MO_LINE {
        // DB1: i1 is the row's file (ng_note_line)
        ng_dbg_line_row_fx(g, m.i0, m.i1);
        return;
    }
    var op: i64 = m.op;
    // TG1: the operations the selection table covers (constants, the ALU,
    // shifts by a constant, element addresses, compares, loads and stores,
    // float operations); the hand-written selection below when no rule
    // applies or with FID_NAT_OFF=isel
    if ng_isel_covers(op) {
        if ng_isel_mi(g, m, p0, p1, p2) {
            return;
        }
    }
    if op == MO_SHI {
        ng_shi(g, p0, p1, m.i0, m.i1);
        return;
    }
    if op == MO_LI {
        ng_li(g, p0, m.i0);
        return;
    }
    if op == MO_SLOTADDR {
        ng_slot_addr(g, p0, m.i0);
        return;
    }
    if op == MO_LDSLOT {
        ng_ld_slot(g, p0, m.i0);
        return;
    }
    if op == MO_STSLOT {
        ng_st_slot(g, m.i0, p0);
        return;
    }
    if op == MO_LOAD {
        ng_load(g, p0, p1, m.i0, m.i1, m.i2 != 0);
        return;
    }
    if op == MO_STORE {
        ng_store(g, p0, m.i0, p1, m.i1);
        return;
    }
    if op == MO_ADDR {
        ng_addr(g, p0, m.i0);
        return;
    }
    if op == MO_CALL {
        ng_call_label(g, m.i0);
        return;
    }
    if op == MO_CALLR {
        ng_call_reg(g, p0);
        return;
    }
    if op == MO_JMP {
        ng_jmp(g, m.i0);
        return;
    }
    if op == MO_JTAB {
        // MI27: the dispatch; the MO_JTEs right after it are its table
        ng_jtab_emit(g, p0, m.i0, m.i1);
        return;
    }
    if op == MO_JTE {
        nat_jt_entry(&mut g.e, m.i0);
        return;
    }
    if op == MO_BNEZ {
        ng_bnez(g, p0, m.i0);
        return;
    }
    if op == MO_BEQZ {
        ng_beqz(g, p0, m.i0);
        return;
    }
    if op == MO_BRCC {
        ng_brcc(g, p0, p1, m.i1, m.i0);
        return;
    }
    if op == MO_TBNZ {
        ng_tbnz(g, p0, m.i1, m.i2, m.i0);
        return;
    }
    if op == MO_OPW {
        ng_opw(g, p0, p1, p2, m.i0);
        return;
    }
    if op == MO_ALUM {
        ng_x64_alum(g, p0, p1, p2, m.i0, m.i1);
        return;
    }
    if op == MO_BRCCM {
        ng_x64_brccm(g, p0, p1, m.i1, m.i2, m.i0);
        return;
    }
    if op == MO_SETCCM {
        ng_x64_setccm(g, p0, p1, p2, m.i0, m.i1, m.i2);
        return;
    }
    if op == MO_ALUMST {
        ng_x64_alumst(g, p0, p1, m.i0, m.i1, m.i2);
        return;
    }
    if op == MO_ADDSHL {
        ng_addshl(g, p0, p1, p2, m.i0);
        return;
    }
    if op == MO_LDX {
        ng_ldx(g, p0, p1, p2, m.i2 >> 1, m.i0, m.i1, (m.i2 & 1) != 0);
        return;
    }
    if op == MO_STX {
        ng_stx(g, p0, p2, m.i2 >> 1, m.i0, p1, m.i1);
        return;
    }
    if op == MO_ANDN {
        ng_andn(g, p0, p1, p2);
        return;
    }
    if op == MO_BLSR {
        ng_blsr(g, p0, p1, m.i0);
        return;
    }
    if op == MO_CSEL {
        ng_csel(g, p0, p1, p2, m.i0);
        return;
    }
    if op == MO_PANICIF {
        g.cur_inst_line = m.i1;
        ng_panic_if(g, p0, m.i0);
        g.cur_inst_line = 0;
        return;
    }
    if op == MO_TRAP {
        ng_trap(g);
        return;
    }
    // TG11: the vector operations (MO_VBIN from the selection table)
    if op >= MO_VLD && op <= MO_VEND {
        ng_vec_dispatch(g, m, p0, p1);
        return;
    }
    if op == MO_ADD {
        ng_add(g, p0, p1, p2);
        return;
    }
    if op == MO_ADDI {
        ng_addi(g, p0, p1, m.i0);
        return;
    }
    if op == MO_SUB {
        ng_sub(g, p0, p1, p2);
        return;
    }
    if op == MO_MUL {
        ng_mul(g, p0, p1, p2);
        return;
    }
    if op == MO_AND {
        ng_and(g, p0, p1, p2);
        return;
    }
    if op == MO_OR {
        ng_or(g, p0, p1, p2);
        return;
    }
    if op == MO_XOR {
        ng_xor(g, p0, p1, p2);
        return;
    }
    if op == MO_SHL {
        ng_shl(g, p0, p1, p2);
        return;
    }
    if op == MO_SAR {
        ng_sar(g, p0, p1, p2);
        return;
    }
    if op == MO_SHR {
        ng_shr(g, p0, p1, p2);
        return;
    }
    if op == MO_NEG {
        ng_neg(g, p0, p1);
        return;
    }
    if op == MO_NOT {
        ng_not_bits(g, p0, p1);
        return;
    }
    if op == MO_DIV {
        ng_div(g, p0, p1, p2, m.i0 != 0);
        return;
    }
    if op == MO_REM {
        ng_rem(g, p0, p1, p2, m.i0 != 0);
        return;
    }
    if op == MO_MULH {
        ng_mulh(g, p0, p1, p2, m.i0 != 0);
        return;
    }
    if op == MO_SETCC {
        ng_setcc(g, p0, p1, p2, m.i0);
        return;
    }
    if op == MO_EXT {
        ng_ext(g, p0, p1, m.i0);
        return;
    }
    if op == MO_FBIN {
        ng_fbin(g, m.i0, p0, p1, p2, m.i1 != 0);
        return;
    }
    if op == MO_FCMP {
        ng_fcmp(g, p0, p1, p2, m.i0, m.i1 != 0);
        return;
    }
    if op == MO_I2F {
        ng_i2f(g, p0, p1, m.i0 != 0);
        return;
    }
    if op == MO_F2I {
        ng_f2i(g, p0, p1, m.i0 != 0);
        return;
    }
    if op == MO_F32BITS {
        if m.i0 == 1 {
            // MI25: f32 -> f64
            ng_f32widen(g, p0, p1);
        } else {
            ng_f32bits(g, p0, p1);
        }
        return;
    }
    if op == MO_PROLOGUE {
        ng_prologue(g, g.frame);
        return;
    }
    if op == MO_EPILOGUE {
        ng_epilogue(g);
        return;
    }
    if op == MO_LDIN {
        ng_ld_incoming(g, p0, m.i0);
        return;
    }
    if op == MO_STOUT {
        ng_st_outgoing(g, m.i0, p0);
        return;
    }
    if op == MO_COPY {
        ng_copy(g, p0, p1, m.i0);
        return;
    }
    if op == MO_PLACE {
        NatEnc_place(&mut g.e, m.i0);
        return;
    }
    if op == MO_ASR63 {
        ng_asr63(g, p0, p1);
        return;
    }
}

/// A function's identity for folding: two functions with the same
/// operations, registers, immediates (local labels by order) and frame emit
/// the same bytes.
@wrapping
fn ng_mir_key(rec: &NatFnRec, al: &NatAlloc) -> str {
    var h1: i64 = 0 - 3750763034362895579;
    var h2: i64 = 1469598103934665603;
    var local: i64 = HashMap_new();
    var nloc: i64 = 0;
    var k: i64 = 0;
    while k < rec.mir.len() {
        var m: MInst = rec.mir.get(k);
        if m.op == MO_PLACE {
            HashMap_insert(local, int_to_str(m.i0), nloc);
            nloc = nloc + 1;
        }
        k = k + 1;
    }
    var nv: i64 = rec.nvreg - NG_VBASE;
    k = 0;
    while k < rec.mir.len() {
        var m2: MInst = rec.mir.get(k);
        var vals: Vec<i64> = Vec::new();
        vals.push(m2.op);
        var f: i64 = 0;
        while f < 3 {
            var v: i64 = mi_field(m2, f);
            if v >= NG_VBASE && v - NG_VBASE < nv {
                var r: i64 = al.assign.get(v - NG_VBASE);
                if r >= 0 {
                    vals.push(r);
                } else {
                    vals.push(1000000 + al.spill.get(v - NG_VBASE));
                }
            } else {
                vals.push(v);
            }
            f = f + 1;
        }
        var i0: i64 = m2.i0;
        if (m2.op == MO_PLACE || mi_is_br(m2.op)) && HashMap_contains(local, int_to_str(i0)) {
            i0 = 0 - 1 - HashMap_get(local, int_to_str(i0));
        }
        vals.push(i0);
        vals.push(m2.i1);
        vals.push(m2.i2);
        var j: i64 = 0;
        while j < vals.len() {
            h1 = (h1 ^ vals.get(j)) * 1099511628211;
            h2 = h2 * 6364136223846793005 + vals.get(j) + 1442695040888963407;
            j = j + 1;
        }
        k = k + 1;
    }
    var sv: i64 = 0;
    var si: i64 = 0;
    while si < al.save_regs.len() {
        sv = sv * 64 + al.save_regs.get(si);
        si = si + 1;
    }
    // LF20: a function that wipes its frame is never the same bytes as one
    // that does not; its returns zero the registers its clobber mask and
    // its result's size leave (ng_wipe_regs), so those are in the key too
    var wk: str = "";
    if rec.secret {
        wk = ":w" + int_to_str(al.mask) + ":" + int_to_str(rec.sret_size);
    }
    return int_to_str(h1) + ":" + int_to_str(h2) + ":" + int_to_str(rec.mir.len()) + ":" + int_to_str(al.frame) + ":" + int_to_str(sv) + wk;
}

// --- ME27 / LF24 / WP6: struct results in two registers ------------------
// A function returning a struct takes the address to write it to as its
// hidden first parameter (lowering's sret) and returns nothing. For a
// struct of one or two words (an Option or a Result of a word is two:
// tag and payload) whose callers are all direct calls in this image, the
// machine layer changes the convention (`FID_NAT_OFF=retregs`: never):
// the callee keeps the words in two vregs instead of storing them and
// returns them in the result register and argument register 1; each call
// site keeps the address it passed and stores the two registers there
// after the call. The IR, its single-value Return and every other function
// stay as they are; the hidden parameter is still passed, and not read. A
// callee qualifies when the address is only moved, offset by constants and
// stored through (never loaded from, copied to, given to a call, compared
// or stored itself), each store inside the struct and inside one word; a
// vreg that carries it is written once, or only inside one block and
// first by a definition (the analysis follows it in program order).

fn ng_mi(op: i64, r0: i64, r1: i64, r2: i64, i0: i64, i1: i64, i2: i64) -> MInst {
    return MInst {
        op: op, r0: r0, r1: r1, r2: r2, i0: i0, i1: i1, i2: i2
    };
}

/// v[r - 64] for a vreg r of the function, -1 for anything else.
fn ng_rr_get(v: &Vec<i64>, r: i64, nv: i64) -> i64 {
    if r < NG_VBASE || r - NG_VBASE >= nv {
        return 0 - 1;
    }
    return v.get(r - NG_VBASE);
}

/// The low `sz` bytes (1, 2 or 4) of a word.
@wrapping
fn ng_rr_mask(sz: i64) -> i64 {
    return (1 << (sz * 8)) - 1;
}

/// Every bit of a word but `mask` shifted left by `sh`.
@wrapping
fn ng_rr_clear(mask: i64, sh: i64) -> i64 {
    return (0 - 1) ^ (mask << sh);
}

/// Per MIR index + 1, the byte offset in the struct of an MO_STORE through
/// the result address (-1: not one); index 0 is 1 when `rec` qualifies.
fn ng_rr_analyze(rec: &NatFnRec) -> Vec<i64> {
    var n: i64 = rec.mir.len();
    var out: Vec<i64> = Vec::new();
    out.push(0);
    var k: i64 = 0;
    while k < n {
        out.push(0 - 1);
        k = k + 1;
    }
    var nv: i64 = rec.nvreg - NG_VBASE;
    var s: i64 = rec.sret_v - NG_VBASE;
    var size: i64 = rec.sret_size;
    if s < 0 || s >= nv || (size != 8 && size != 16) {
        return out;
    }
    var mb: MBlocks = mi_blocks(&rec.mir);
    // Per vreg: its definitions, its block (-2: more than one), whether
    // its first appearance defines it (1) or reads it (0)
    var ndef: Vec<i64> = Vec::new();
    var blk: Vec<i64> = Vec::new();
    var firstdef: Vec<i64> = Vec::new();
    var off: Vec<i64> = Vec::new();
    var kc: Vec<i64> = Vec::new();
    var cv: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        ndef.push(0);
        blk.push(0 - 1);
        firstdef.push(0 - 1);
        off.push(0 - 1);
        kc.push(0);
        cv.push(0);
        i = i + 1;
    }
    k = 0;
    while k < n {
        var m: MInst = rec.mir.get(k);
        var um: i64 = mi_use_mask(m.op);
        var b: i64 = mb.of.get(k);
        var f: i64 = 0;
        while f < 3 {
            var v: i64 = mi_field(m, f);
            var used: bool = (um & (1 << f)) != 0;
            var defd: bool = f == 0 && mi_defines(m.op);
            if (used || defd) && v >= NG_VBASE && v - NG_VBASE < nv {
                var vi: i64 = v - NG_VBASE;
                if blk.get(vi) == 0 - 1 {
                    blk.set(vi, b);
                } else if blk.get(vi) != b {
                    blk.set(vi, 0 - 2);
                }
                if used && firstdef.get(vi) < 0 {
                    firstdef.set(vi, 0);
                }
            }
            f = f + 1;
        }
        if mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 - NG_VBASE < nv {
            var dvi: i64 = m.r0 - NG_VBASE;
            ndef.set(dvi, ndef.get(dvi) + 1);
            if firstdef.get(dvi) < 0 {
                firstdef.set(dvi, 1);
            }
        }
        k = k + 1;
    }
    if ndef.get(s) != 1 {
        return out;
    }
    // In program order: each vreg's offset from the result address (-1:
    // none) and its known constant; values written more than once are
    // forgotten at each block's start (they are local to one block)
    var dirty: Vec<i64> = Vec::new();
    var cur_b: i64 = 0 - 1;
    k = 0;
    while k < n {
        var m2: MInst = rec.mir.get(k);
        var b2: i64 = mb.of.get(k);
        if b2 != cur_b {
            cur_b = b2;
            var di: i64 = 0;
            while di < dirty.len() {
                off.set(dirty.get(di), 0 - 1);
                kc.set(dirty.get(di), 0);
                di = di + 1;
            }
            dirty.clear();
        }
        var um2: i64 = mi_use_mask(m2.op);
        var f2: i64 = 0;
        while f2 < 3 {
            var u: i64 = mi_field(m2, f2);
            var uo: i64 = ng_rr_get(&off, u, nv);
            if (um2 & (1 << f2)) != 0 && uo >= 0 {
                var ok: bool = false;
                if m2.op == MO_MOV && f2 == 1 && m2.r0 >= NG_VBASE {
                    ok = true;
                }
                if m2.op == MO_ADD && m2.r0 >= NG_VBASE {
                    if f2 == 1 && ng_rr_get(&kc, m2.r2, nv) == 1 && ng_rr_get(&off, m2.r2, nv) < 0 {
                        ok = true;
                    }
                    if f2 == 2 && ng_rr_get(&kc, m2.r1, nv) == 1 && ng_rr_get(&off, m2.r1, nv) < 0 {
                        ok = true;
                    }
                }
                if m2.op == MO_STORE && f2 == 0 && ng_rr_get(&off, m2.r1, nv) < 0 {
                    var d: i64 = uo + m2.i0;
                    var sz: i64 = m2.i1;
                    if d >= 0 && d + sz <= size && (d % 8) + sz <= 8 {
                        ok = true;
                        out.set(k + 1, d);
                    }
                }
                if !ok {
                    return out;
                }
            }
            f2 = f2 + 1;
        }
        if mi_defines(m2.op) && m2.r0 >= NG_VBASE && m2.r0 - NG_VBASE < nv {
            var dv: i64 = m2.r0 - NG_VBASE;
            var no: i64 = 0 - 1;
            var nk: i64 = 0;
            var nc: i64 = 0;
            if dv == s {
                no = 0;
            } else if m2.op == MO_MOV {
                no = ng_rr_get(&off, m2.r1, nv);
                nk = ng_rr_get(&kc, m2.r1, nv);
                nc = ng_rr_get(&cv, m2.r1, nv);
            } else if m2.op == MO_ADD {
                var o1: i64 = ng_rr_get(&off, m2.r1, nv);
                var o2: i64 = ng_rr_get(&off, m2.r2, nv);
                var addc: i64 = 0 - 1;
                if o1 >= 0 && ng_rr_get(&kc, m2.r2, nv) == 1 {
                    addc = ng_rr_get(&cv, m2.r2, nv);
                } else if o2 >= 0 && ng_rr_get(&kc, m2.r1, nv) == 1 {
                    addc = ng_rr_get(&cv, m2.r1, nv);
                    o1 = o2;
                }
                if o1 >= 0 || o2 >= 0 {
                    // an address inside the struct, or the function keeps
                    // its convention (an offset the stores could not follow)
                    if addc < 0 || addc > 64 {
                        return out;
                    }
                    no = o1 + addc;
                }
            } else if m2.op == MO_LI {
                nk = 1;
                nc = m2.i0;
            }
            if no >= 0 && ndef.get(dv) > 1 && (blk.get(dv) < 0 || firstdef.get(dv) != 1) {
                return out;
            }
            off.set(dv, no);
            kc.set(dv, nk);
            cv.set(dv, nc);
            if ndef.get(dv) > 1 {
                dirty.push(dv);
            }
        }
        k = k + 1;
    }
    out.set(0, 1);
    return out;
}

/// A function the convention may change for: not one machine code or the
/// runtime calls by name or address (main, the runtime's and the
/// primitives' prefixes, core's Vec / HashMap that builtins run, a thread
/// or task entry named by a string, an extern, a dyn method).
fn ng_rr_name_ok(g: &NatGen, name: str) -> bool {
    if name == "main" || name == "main_entry" || pe_runtime_alias_target(name) {
        return false;
    }
    if str_starts_with(name, "p_") || str_starts_with(name, "pe_") || str_starts_with(name, "pet_") || str_starts_with(name, "ped_") || str_starts_with(name, "pert_") || str_starts_with(name, "nat_") || str_starts_with(name, "__") {
        return false;
    }
    if str_starts_with(name, "Vec_") || str_starts_with(name, "HashMap_") {
        return false;
    }
    if HashMap_contains(g.named_seen, name) || HashMap_contains(g.c_names, name) {
        return false;
    }
    var i: i64 = 0;
    while i < g.dyn_types.len() {
        if str_starts_with(name, g.dyn_types.get(i) + "_") {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// The callee's half: the words go to vregs w0 / w1 (zero from the
/// prologue on), each store through the result address becomes a move
/// (a whole word) or a masked insert (1, 2 or 4 bytes), and every
/// epilogue returns w0 in the result register and w1 in argument
/// register 1.
fn ng_rr_callee_rewrite(g: &NatGen, rec: &mut NatFnRec) -> bool {
    var an: Vec<i64> = ng_rr_analyze(rec);
    if an.get(0) != 1 {
        return false;
    }
    var size: i64 = rec.sret_size;
    var w0: i64 = rec.nvreg;
    var w1: i64 = w0 + 1;
    var nvr: i64 = w0 + 2;
    var out: Vec<MInst> = Vec::new();
    var k: i64 = 0;
    while k < rec.mir.len() {
        var m: MInst = rec.mir.get(k);
        if m.op == MO_EPILOGUE {
            out.push(ng_mi(MO_MOV, ng_argreg(g, 0), w0, 0, 0, 0, 0));
            if size == 16 {
                out.push(ng_mi(MO_MOV, ng_argreg(g, 1), w1, 0, 0, 0, 0));
            }
            out.push(m);
        } else if m.op == MO_STORE && an.get(k + 1) >= 0 {
            var d: i64 = an.get(k + 1);
            var w: i64 = w0;
            if d >= 8 {
                w = w1;
            }
            var sh: i64 = (d % 8) * 8;
            if m.i1 == 8 {
                out.push(ng_mi(MO_MOV, w, m.r1, 0, 0, 0, 0));
            } else {
                var mask: i64 = ng_rr_mask(m.i1);
                var t1: i64 = nvr;
                var t2: i64 = nvr + 1;
                var t3: i64 = nvr + 2;
                nvr = nvr + 3;
                out.push(ng_mi(MO_LI, t1, 0, 0, ng_rr_clear(mask, sh), 0, 0));
                out.push(ng_mi(MO_AND, w, w, t1, 0, 0, 0));
                out.push(ng_mi(MO_LI, t2, 0, 0, mask, 0, 0));
                out.push(ng_mi(MO_AND, t3, m.r1, t2, 0, 0, 0));
                var src: i64 = t3;
                if sh > 0 {
                    var t4: i64 = nvr;
                    var t5: i64 = nvr + 1;
                    nvr = nvr + 2;
                    out.push(ng_mi(MO_LI, t4, 0, 0, sh, 0, 0));
                    out.push(ng_mi(MO_SHL, t5, t3, t4, 0, 0, 0));
                    src = t5;
                }
                out.push(ng_mi(MO_OR, w, w, src, 0, 0, 0));
            }
        } else {
            out.push(m);
        }
        if m.op == MO_PROLOGUE {
            out.push(ng_mi(MO_LI, w0, 0, 0, 0, 0, 0));
            if size == 16 {
                out.push(ng_mi(MO_LI, w1, 0, 0, 0, 0, 0));
            }
        }
        k = k + 1;
    }
    rec.mir = out;
    rec.nvreg = nvr;
    return true;
}

/// The callers' half: before each call of such a function the address in
/// argument register 0 is kept in a new vreg; after it the result
/// register and argument register 1 are stored there. OP12: when argument
/// register 0 was set by a move from a vreg x with only argument set-up
/// after it (moves, constants, addresses, line rows; nothing writes x),
/// the kept address is a move from x itself (the same value), and
/// `feeds` (one entry per operation of the new MIR) marks that move into
/// argument register 0: the hidden argument such a callee no longer reads,
/// which ng_rf_promote does not count as the slot's address escaping.
fn ng_rr_caller_rewrite(g: &NatGen, rec: &mut NatFnRec, feeds: &mut Vec<i64>) -> bool {
    feeds.clear();
    var any: bool = false;
    var k: i64 = 0;
    while k < rec.mir.len() {
        var m: MInst = rec.mir.get(k);
        if m.op == MO_CALL && HashMap_contains_i(g.rr_size, m.i0) {
            any = true;
        }
        k = k + 1;
    }
    if !any {
        return false;
    }
    var a0: i64 = ng_argreg(g, 0);
    var nvr: i64 = rec.nvreg;
    var out: Vec<MInst> = Vec::new();
    k = 0;
    while k < rec.mir.len() {
        var m2: MInst = rec.mir.get(k);
        if m2.op == MO_CALL && HashMap_contains_i(g.rr_size, m2.i0) {
            var p: i64 = nvr;
            nvr = nvr + 1;
            // the move that set argument register 0 for this call
            var src: i64 = a0;
            var fpos: i64 = 0 - 1;
            var j: i64 = k - 1;
            var looking: bool = true;
            while looking && j >= 0 {
                var mj: MInst = rec.mir.get(j);
                if mj.op == MO_MOV && mj.r0 == a0 {
                    if mj.r1 >= NG_VBASE && mj.r1 < rec.nvreg {
                        src = mj.r1;
                        fpos = j;
                    }
                    looking = false;
                } else if mj.op == MO_MOV || mj.op == MO_LI || mj.op == MO_LINE || mj.op == MO_SLOTADDR || mj.op == MO_ADDR {
                    if mj.r0 == a0 && mj.op != MO_LINE {
                        looking = false;
                    }
                    j = j - 1;
                } else {
                    looking = false;
                }
            }
            if fpos >= 0 {
                var q: i64 = fpos + 1;
                while q < k {
                    var mq: MInst = rec.mir.get(q);
                    if mq.op != MO_LINE && mi_defines(mq.op) && mq.r0 == src {
                        src = a0;
                        fpos = 0 - 1;
                    }
                    q = q + 1;
                }
            }
            if fpos >= 0 {
                // (no call between fpos and k: each operation there went
                // to `out` as it was)
                feeds.set(out.len() - (k - fpos), 1);
            }
            out.push(ng_mi(MO_MOV, p, src, 0, 0, 0, 0));
            feeds.push(0);
            out.push(m2);
            feeds.push(0);
            out.push(ng_mi(MO_STORE, p, ng_argreg(g, 0), 0, 0, 8, 0));
            feeds.push(0);
            if HashMap_get_i(g.rr_size, m2.i0) == 16 {
                out.push(ng_mi(MO_STORE, p, ng_argreg(g, 1), 0, 8, 8, 0));
                feeds.push(0);
            }
        } else {
            out.push(m2);
            feeds.push(0);
        }
        k = k + 1;
    }
    rec.mir = out;
    rec.nvreg = nvr;
    return true;
}

// --- OP12 / LF24: the caller's result slot in registers -------------------
// After ng_rr_caller_rewrite each call of a function whose struct result
// comes back in two registers is followed by the two stores into the
// caller's result slot (a frame slot: an alloca's MO_SLOTADDR), and the
// caller reads the struct back from there, often after copying it into the
// slot of a local first (`val p: Pair = f()` is a COPY between two slots).
// ng_rf_promote keeps such slots in vregs, one per word: the stores after
// the call become moves from the two result registers, loads become moves
// (a field narrower than a word: a shift and an extension), stores masked
// inserts, and copies between such slots moves, so the struct never goes
// through memory. A slot qualifies when its address goes nowhere the pass
// cannot see: every vreg that holds an address into it is only moved
// (into vregs), offset by a constant, loaded from, stored through (never
// stored itself), copied to or from, or passed as the hidden argument of
// such a call (which no longer reads it: `feeds`). Every access must lie
// inside one word of the first 64 bytes; no slot operation by offset
// (MO_LDSLOT, MO_STSLOT, MO_STOUT) may touch it. The slots a qualifying
// call result is copied to (and on, through further copies) qualify the
// same way; a copy between such a slot and memory elsewhere becomes word
// loads or stores. Facts about a vreg come from its one definition, or,
// for a vreg written more than once, from the walk of the one block it
// lives in (as ng_rr_analyze). Not in @constant_time code or functions
// holding secrets. `FID_NAT_OFF=retfwd`: the slots stay in memory.

/// The index of frame slot `off` in the slot list (added when new).
fn ng_rf_ix(map: i64, offs: &mut Vec<i64>, off: i64) -> i64 {
    if HashMap_contains_i(map, off) {
        return HashMap_get_i(map, off);
    }
    var ix: i64 = offs.len();
    offs.push(off);
    HashMap_insert_i(map, off, ix);
    return ix;
}

/// The fact about register r at this point: from `gv` (the facts of
/// vregs defined once) or from `fv` (the block's walk); `dflt` for a
/// physical register.
fn ng_rf_pick(ndef: &Vec<i64>, gv: &Vec<i64>, fv: &Vec<i64>, r: i64, nv: i64, dflt: i64) -> i64 {
    if r < NG_VBASE || r - NG_VBASE >= nv {
        return dflt;
    }
    var i: i64 = r - NG_VBASE;
    if ndef.get(i) == 1 {
        return gv.get(i);
    }
    return fv.get(i);
}

/// r is a vreg of the function defined exactly once.
fn ng_rf_single(ndef: &Vec<i64>, r: i64, nv: i64) -> bool {
    return r >= NG_VBASE && r - NG_VBASE < nv && ndef.get(r - NG_VBASE) == 1;
}

/// A constant an address may be offset by inside a slot.
fn ng_rf_dok(c: i64) -> bool {
    return c >= 0 && c <= 4096;
}

/// The vreg of word `w` of slot `b` (wbase: the first word's vreg, -1:
/// the slot stays in memory).
fn ng_rf_word(wbase: &Vec<i64>, b: i64, w: i64) -> i64 {
    return wbase.get(b) + w;
}

/// ng_rf_promote's walk over `mir`: per slot (index into offs) whether
/// its address escapes, and the accesses, copies and slot operations by
/// offset. Returns false when the facts could not be settled.
fn ng_rf_scan(g: &NatGen, rec: &NatFnRec, feeds: &Vec<i64>, bmap: i64, offs: &mut Vec<i64>, acc_at: &mut Vec<i64>, accs: &mut Vec<i64>, cp_at: &mut Vec<i64>, cps: &mut Vec<i64>, slotops: &mut Vec<i64>, pois: &mut Vec<i64>, cands: &mut Vec<i64>) -> bool {
    var n: i64 = rec.mir.len();
    var nv: i64 = rec.nvreg - NG_VBASE;
    var mb: MBlocks = mi_blocks(&rec.mir);
    var ndef: Vec<i64> = Vec::new();
    var blk: Vec<i64> = Vec::new();
    var firstdef: Vec<i64> = Vec::new();
    // facts of the vregs defined once (g*) and of the others along the
    // block (f*): the slot an address points into (-1: none) and its
    // offset there, whether a constant is known and its value
    var gb: Vec<i64> = Vec::new();
    var gd: Vec<i64> = Vec::new();
    var gk: Vec<i64> = Vec::new();
    var gc: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        ndef.push(0);
        blk.push(0 - 1);
        firstdef.push(0 - 1);
        gb.push(0 - 1);
        gd.push(0);
        gk.push(0);
        gc.push(0);
        i = i + 1;
    }
    var k: i64 = 0;
    while k < n {
        var m: MInst = rec.mir.get(k);
        var um: i64 = mi_use_mask(m.op);
        var b: i64 = mb.of.get(k);
        var f: i64 = 0;
        while f < 3 {
            var v: i64 = mi_field(m, f);
            var used: bool = (um & (1 << f)) != 0;
            var defd: bool = f == 0 && mi_defines(m.op);
            if (used || defd) && v >= NG_VBASE && v - NG_VBASE < nv {
                var vi: i64 = v - NG_VBASE;
                if blk.get(vi) == 0 - 1 {
                    blk.set(vi, b);
                } else if blk.get(vi) != b {
                    blk.set(vi, 0 - 2);
                }
                if used && firstdef.get(vi) < 0 {
                    firstdef.set(vi, 0);
                }
            }
            f = f + 1;
        }
        if mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 - NG_VBASE < nv {
            var dvi: i64 = m.r0 - NG_VBASE;
            ndef.set(dvi, ndef.get(dvi) + 1);
            if firstdef.get(dvi) < 0 {
                firstdef.set(dvi, 1);
            }
        }
        k = k + 1;
    }
    // Walks until the facts of the vregs defined once settle (a
    // definition may come after a read in the layout: blocks moved out of
    // line, a loop's head); what the last walk recorded is the answer
    var changed: bool = true;
    var rounds: i64 = 0;
    while changed {
        if rounds >= 64 {
            return false;
        }
        rounds = rounds + 1;
        acc_at.clear();
        accs.clear();
        cp_at.clear();
        cps.clear();
        slotops.clear();
        pois.clear();
        cands.clear();
        changed = ng_rf_walk(g, rec, feeds, bmap, offs, &mb, &ndef, &blk, &firstdef, &mut gb, &mut gd, &mut gk, &mut gc, acc_at, accs, cp_at, cps, slotops, pois, cands);
    }
    return true;
}

/// One walk of ng_rf_scan in program order: the facts of the vregs
/// defined once (gb, gd, gk, gc) are kept and grown, those of the others
/// are followed along each block (forgotten at its start); every read of
/// an address is judged and every access, copy and slot operation by
/// offset recorded. True when a settled fact changed.
fn ng_rf_walk(g: &NatGen, rec: &NatFnRec, feeds: &Vec<i64>, bmap: i64, offs: &mut Vec<i64>, mb: &MBlocks, ndef: &Vec<i64>, blk: &Vec<i64>, firstdef: &Vec<i64>, gb: &mut Vec<i64>, gd: &mut Vec<i64>, gk: &mut Vec<i64>, gc: &mut Vec<i64>, acc_at: &mut Vec<i64>, accs: &mut Vec<i64>, cp_at: &mut Vec<i64>, cps: &mut Vec<i64>, slotops: &mut Vec<i64>, pois: &mut Vec<i64>, cands: &mut Vec<i64>) -> bool {
    var n: i64 = rec.mir.len();
    var nv: i64 = rec.nvreg - NG_VBASE;
    var changed: bool = false;
    var fb: Vec<i64> = Vec::new();
    var fd: Vec<i64> = Vec::new();
    var fk: Vec<i64> = Vec::new();
    var fc: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        fb.push(0 - 1);
        fd.push(0);
        fk.push(0);
        fc.push(0);
        i = i + 1;
    }
    var dirty: Vec<i64> = Vec::new();
    var cur_b: i64 = 0 - 1;
    var k: i64 = 0;
    while k < n {
        acc_at.push(0 - 1);
        cp_at.push(0 - 1);
        var m2: MInst = rec.mir.get(k);
        var b2: i64 = mb.of.get(k);
        if b2 != cur_b {
            cur_b = b2;
            var di2: i64 = 0;
            while di2 < dirty.len() {
                fb.set(dirty.get(di2), 0 - 1);
                fk.set(dirty.get(di2), 0);
                di2 = di2 + 1;
            }
            dirty.clear();
        }
        var um2: i64 = mi_use_mask(m2.op);
        var f2: i64 = 0;
        while f2 < 3 {
            if (um2 & (1 << f2)) != 0 {
                var u: i64 = mi_field(m2, f2);
                var ub: i64 = ng_rf_pick(ndef, gb, &fb, u, nv, 0 - 1);
                if ub >= 0 {
                    var ud: i64 = ng_rf_pick(ndef, gd, &fd, u, nv, 0);
                    var ok: bool = false;
                    if m2.op == MO_MOV && f2 == 1 && m2.r0 >= NG_VBASE && m2.r0 - NG_VBASE < nv {
                        ok = true;
                    }
                    if m2.op == MO_MOV && f2 == 1 && feeds.get(k) == 1 {
                        // the hidden argument of a call that no longer reads it
                        ok = true;
                        cands.push(ub);
                    }
                    if m2.op == MO_ADD && f2 >= 1 && m2.r0 >= NG_VBASE && m2.r0 - NG_VBASE < nv {
                        var o: i64 = m2.r1;
                        if f2 == 1 {
                            o = m2.r2;
                        }
                        if ng_rf_pick(ndef, gb, &fb, o, nv, 0 - 1) < 0 && ng_rf_pick(ndef, gk, &fk, o, nv, 0) == 1 && ng_rf_dok(ng_rf_pick(ndef, gc, &fc, o, nv, 0)) {
                            ok = true;
                        }
                    }
                    if m2.op == MO_LOAD && f2 == 1 {
                        ok = true;
                        acc_at.set(k, accs.len());
                        accs.push(ub);
                        accs.push(ud + m2.i0);
                        if m2.r0 >= 32 && m2.r0 < NG_VBASE {
                            // (a float or a fixed register: kept as it is)
                            accs.push(1);
                        } else {
                            accs.push(0);
                        }
                    }
                    if m2.op == MO_STORE && f2 == 0 {
                        ok = true;
                        acc_at.set(k, accs.len());
                        accs.push(ub);
                        accs.push(ud + m2.i0);
                        if m2.r1 >= 32 && m2.r1 < NG_VBASE && m2.r1 != g.zr {
                            accs.push(1);
                        } else {
                            accs.push(0);
                        }
                    }
                    if m2.op == MO_COPY && f2 <= 1 {
                        ok = true;
                    }
                    if !ok {
                        pois.push(ub);
                    }
                }
            }
            f2 = f2 + 1;
        }
        if m2.op == MO_COPY {
            var cdb: i64 = ng_rf_pick(ndef, gb, &fb, m2.r0, nv, 0 - 1);
            var csb: i64 = ng_rf_pick(ndef, gb, &fb, m2.r1, nv, 0 - 1);
            if cdb >= 0 || csb >= 0 {
                cp_at.set(k, cps.len());
                cps.push(cdb);
                cps.push(ng_rf_pick(ndef, gd, &fd, m2.r0, nv, 0));
                cps.push(csb);
                cps.push(ng_rf_pick(ndef, gd, &fd, m2.r1, nv, 0));
                cps.push(m2.i0);
            }
        }
        if m2.op == MO_LDSLOT || m2.op == MO_STSLOT {
            slotops.push(m2.i0);
            slotops.push(m2.i0 + 8);
        }
        if m2.op == MO_STOUT {
            slotops.push(8 * m2.i0);
            slotops.push(8 * m2.i0 + 8);
        }
        if m2.op == MO_SLOTADDR && (m2.r0 < NG_VBASE || m2.r0 - NG_VBASE >= nv) {
            // a slot's address straight into a fixed register
            pois.push(ng_rf_ix(bmap, offs, m2.i0));
        }
        if mi_defines(m2.op) && m2.r0 >= NG_VBASE && m2.r0 - NG_VBASE < nv {
            var dv: i64 = m2.r0 - NG_VBASE;
            var nb2: i64 = 0 - 1;
            var nd2: i64 = 0;
            var nk2: i64 = 0;
            var nc2: i64 = 0;
            if m2.op == MO_SLOTADDR {
                nb2 = ng_rf_ix(bmap, offs, m2.i0);
            } else if m2.op == MO_LI {
                nk2 = 1;
                nc2 = m2.i0;
            } else if m2.op == MO_MOV {
                nb2 = ng_rf_pick(ndef, gb, &fb, m2.r1, nv, 0 - 1);
                nd2 = ng_rf_pick(ndef, gd, &fd, m2.r1, nv, 0);
                nk2 = ng_rf_pick(ndef, gk, &fk, m2.r1, nv, 0);
                nc2 = ng_rf_pick(ndef, gc, &fc, m2.r1, nv, 0);
            } else if m2.op == MO_ADD {
                var ab: i64 = ng_rf_pick(ndef, gb, &fb, m2.r1, nv, 0 - 1);
                var bb: i64 = ng_rf_pick(ndef, gb, &fb, m2.r2, nv, 0 - 1);
                if ab >= 0 && bb < 0 && ng_rf_pick(ndef, gk, &fk, m2.r2, nv, 0) == 1 && ng_rf_dok(ng_rf_pick(ndef, gc, &fc, m2.r2, nv, 0)) {
                    nb2 = ab;
                    nd2 = ng_rf_pick(ndef, gd, &fd, m2.r1, nv, 0) + ng_rf_pick(ndef, gc, &fc, m2.r2, nv, 0);
                } else if bb >= 0 && ab < 0 && ng_rf_pick(ndef, gk, &fk, m2.r1, nv, 0) == 1 && ng_rf_dok(ng_rf_pick(ndef, gc, &fc, m2.r1, nv, 0)) {
                    nb2 = bb;
                    nd2 = ng_rf_pick(ndef, gd, &fd, m2.r2, nv, 0) + ng_rf_pick(ndef, gc, &fc, m2.r1, nv, 0);
                }
            }
            if ndef.get(dv) == 1 {
                // a settled fact: what the walk sees at the definition
                if nb2 != gb.get(dv) || nd2 != gd.get(dv) || nk2 != gk.get(dv) || nc2 != gc.get(dv) {
                    gb.set(dv, nb2);
                    gd.set(dv, nd2);
                    gk.set(dv, nk2);
                    gc.set(dv, nc2);
                    changed = true;
                }
            } else {
                if nb2 >= 0 && (blk.get(dv) < 0 || firstdef.get(dv) != 1) {
                    // an address in a vreg written in several blocks
                    pois.push(nb2);
                    nb2 = 0 - 1;
                }
                fb.set(dv, nb2);
                fd.set(dv, nd2);
                fk.set(dv, nk2);
                fc.set(dv, nc2);
                dirty.push(dv);
            }
        }
        k = k + 1;
    }
    return changed;
}

/// OP12 / LF24: the result slots of calls returning in two registers, and
/// the slots they are copied to, in vregs (see above). `feeds` from
/// ng_rr_caller_rewrite. Returns the number of slots replaced.
/// 2g.94: where ng_rf_promote sets its words to 0: at the first label after
/// the prologue (the entry block's), after the moves of the incoming
/// arguments out of their registers. Right after the prologue a word's
/// definition could take an argument register still to be read (the
/// allocation checker's "defines vN in argument register"; a natively
/// built parser read a clobbered `self`). -1: no prologue.
fn ng_rf_zero_at(mir: &Vec<MInst>) -> i64 {
    var pro: i64 = 0 - 1;
    var k: i64 = 0;
    while k < mir.len() {
        var op: i64 = mir.get(k).op;
        if op == MO_PROLOGUE && pro < 0 {
            pro = k;
        } else if pro >= 0 && op == MO_PLACE {
            return k;
        }
        k = k + 1;
    }
    if pro >= 0 {
        return pro + 1;
    }
    return 0 - 1;
}

fn ng_rf_promote(g: &NatGen, rec: &mut NatFnRec, feeds: &Vec<i64>) -> i64 {
    var n: i64 = rec.mir.len();
    var nv: i64 = rec.nvreg - NG_VBASE;
    if !ng_on("retfwd") || rec.is_ct || rec.secret || n == 0 || nv <= 0 || feeds.len() != n {
        return 0;
    }
    // (the words are set to 0 after the prologue)
    var pro: bool = false;
    var pk: i64 = 0;
    while pk < n {
        if rec.mir.get(pk).op == MO_PROLOGUE {
            pro = true;
        }
        pk = pk + 1;
    }
    if !pro {
        return 0;
    }
    var bmap: i64 = HashMap_new();
    var offs: Vec<i64> = Vec::new();
    // per operation: its access (index of [slot, offset, kept] in accs) or
    // copy (index of [dst slot, dst offset, src slot, src offset, size] in
    // cps), -1: none
    var acc_at: Vec<i64> = Vec::new();
    var accs: Vec<i64> = Vec::new();
    var cp_at: Vec<i64> = Vec::new();
    var cps: Vec<i64> = Vec::new();
    var slotops: Vec<i64> = Vec::new();
    var pois: Vec<i64> = Vec::new();
    var cands: Vec<i64> = Vec::new();
    if !ng_rf_scan(g, rec, feeds, bmap, &mut offs, &mut acc_at, &mut accs, &mut cp_at, &mut cps, &mut slotops, &mut pois, &mut cands) {
        return 0;
    }
    var ns: i64 = offs.len();
    if ns == 0 || cands.len() == 0 {
        return 0;
    }
    var bad: Vec<i64> = Vec::new();
    var cand: Vec<i64> = Vec::new();
    var ext: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < ns {
        bad.push(0);
        cand.push(0);
        ext.push(0);
        i = i + 1;
    }
    i = 0;
    while i < pois.len() {
        bad.set(pois.get(i), 1);
        i = i + 1;
    }
    i = 0;
    while i < cands.len() {
        cand.set(cands.get(i), 1);
        i = i + 1;
    }
    // The accesses: inside one word of the first 64 bytes
    var k: i64 = 0;
    while k < n {
        var ai: i64 = acc_at.get(k);
        if ai >= 0 {
            var m: MInst = rec.mir.get(k);
            var sb: i64 = accs.get(ai);
            var d: i64 = accs.get(ai + 1);
            var sz: i64 = m.i1;
            if accs.get(ai + 2) != 0 || d < 0 || (sz != 1 && sz != 2 && sz != 4 && sz != 8) || (d % 8) + sz > 8 || d + sz > 64 {
                bad.set(sb, 1);
            } else if d + sz > ext.get(sb) {
                ext.set(sb, d + sz);
            }
        }
        var ci: i64 = cp_at.get(k);
        if ci >= 0 {
            var size: i64 = cps.get(ci + 4);
            var side: i64 = 0;
            while side < 2 {
                var cb: i64 = cps.get(ci + 2 * side);
                var cd: i64 = cps.get(ci + 2 * side + 1);
                if cb >= 0 {
                    if cd < 0 || (cd % 8) != 0 || size <= 0 || (size % 8) != 0 || cd + size > 64 {
                        bad.set(cb, 1);
                    } else if cd + size > ext.get(cb) {
                        ext.set(cb, cd + size);
                    }
                }
                side = side + 1;
            }
            if cps.get(ci) >= 0 && cps.get(ci) == cps.get(ci + 2) {
                bad.set(cps.get(ci), 1);
            }
        }
        k = k + 1;
    }
    // No slot operation by offset inside, no two slots overlapping
    var s: i64 = 0;
    while s < ns {
        var lo: i64 = offs.get(s);
        var hi: i64 = lo + ext.get(s);
        var q: i64 = 0;
        while q + 1 < slotops.len() {
            if slotops.get(q) < hi && lo < slotops.get(q + 1) {
                bad.set(s, 1);
            }
            q = q + 2;
        }
        var s2: i64 = 0;
        while s2 < ns {
            if s2 != s {
                // (a slot whose accesses could not be followed, its
                // address escaping, still holds at least its first word)
                var lo2: i64 = offs.get(s2);
                var e2: i64 = ext.get(s2);
                if e2 < 8 {
                    e2 = 8;
                }
                var hi2: i64 = lo2 + e2;
                if lo < hi2 && lo2 < hi && ext.get(s) > 0 {
                    bad.set(s, 1);
                }
            }
            s2 = s2 + 1;
        }
        s = s + 1;
    }
    // The slots a qualifying slot is copied to or from qualify too
    var grow: bool = true;
    while grow {
        grow = false;
        var c: i64 = 0;
        while c + 4 < cps.len() {
            var db: i64 = cps.get(c);
            var sb2: i64 = cps.get(c + 2);
            if db >= 0 && sb2 >= 0 {
                if cand.get(sb2) == 1 && bad.get(sb2) == 0 && cand.get(db) == 0 && bad.get(db) == 0 {
                    cand.set(db, 1);
                    grow = true;
                }
                if cand.get(db) == 1 && bad.get(db) == 0 && cand.get(sb2) == 0 && bad.get(sb2) == 0 {
                    cand.set(sb2, 1);
                    grow = true;
                }
            }
            c = c + 5;
        }
    }
    // Words of the slots kept in vregs
    var nvr: i64 = rec.nvreg;
    var wbase: Vec<i64> = Vec::new();
    var nprom: i64 = 0;
    s = 0;
    while s < ns {
        if cand.get(s) == 1 && bad.get(s) == 0 && ext.get(s) > 0 {
            wbase.push(nvr);
            nvr = nvr + (ext.get(s) + 7) / 8;
            nprom = nprom + 1;
        } else {
            wbase.push(0 - 1);
        }
        s = s + 1;
    }
    if nprom == 0 {
        return 0;
    }
    var out: Vec<MInst> = Vec::new();
    var zero_at: i64 = ng_rf_zero_at(&rec.mir);
    k = 0;
    while k < n {
        var m2: MInst = rec.mir.get(k);
        var ai2: i64 = acc_at.get(k);
        var ci2: i64 = cp_at.get(k);
        var done: bool = false;
        if k == zero_at {
            // every word starts as 0 (no read before a write is left
            // without a definition)
            s = 0;
            while s < ns {
                if wbase.get(s) >= 0 {
                    var wi: i64 = 0;
                    while wi < (ext.get(s) + 7) / 8 {
                        out.push(ng_mi(MO_LI, wbase.get(s) + wi, 0, 0, 0, 0, 0));
                        wi = wi + 1;
                    }
                }
                s = s + 1;
            }
        }
        if ai2 >= 0 && wbase.get(accs.get(ai2)) >= 0 {
            var sl: i64 = accs.get(ai2);
            var dd: i64 = accs.get(ai2 + 1);
            var w: i64 = ng_rf_word(&wbase, sl, dd / 8);
            var sh: i64 = (dd % 8) * 8;
            var sz2: i64 = m2.i1;
            if m2.op == MO_LOAD {
                if sz2 == 8 {
                    out.push(ng_mi(MO_MOV, m2.r0, w, 0, 0, 0, 0));
                } else {
                    var srcw: i64 = w;
                    if sh > 0 {
                        var t1: i64 = nvr;
                        var t2: i64 = nvr + 1;
                        nvr = nvr + 2;
                        out.push(ng_mi(MO_LI, t1, 0, 0, sh, 0, 0));
                        out.push(ng_mi(MO_SHR, t2, w, t1, 0, 0, 0));
                        srcw = t2;
                    }
                    var kind: i64 = NEXT_ZW;
                    if sz2 == 1 {
                        kind = NEXT_ZB;
                    } else if sz2 == 2 {
                        kind = NEXT_ZH;
                    }
                    if m2.i2 != 0 {
                        kind = NEXT_SW;
                        if sz2 == 1 {
                            kind = NEXT_SB;
                        } else if sz2 == 2 {
                            kind = NEXT_SH;
                        }
                    }
                    out.push(ng_mi(MO_EXT, m2.r0, srcw, 0, kind, 0, 0));
                }
            } else {
                // MO_STORE: the value r1 (the zero register: 0)
                var sval: i64 = m2.r1;
                if sval == g.zr {
                    sval = nvr;
                    nvr = nvr + 1;
                    out.push(ng_mi(MO_LI, sval, 0, 0, 0, 0, 0));
                }
                if sz2 == 8 {
                    out.push(ng_mi(MO_MOV, w, sval, 0, 0, 0, 0));
                } else {
                    var mask: i64 = ng_rr_mask(sz2);
                    var u1: i64 = nvr;
                    var u2: i64 = nvr + 1;
                    var u3: i64 = nvr + 2;
                    nvr = nvr + 3;
                    out.push(ng_mi(MO_LI, u1, 0, 0, ng_rr_clear(mask, sh), 0, 0));
                    out.push(ng_mi(MO_AND, w, w, u1, 0, 0, 0));
                    out.push(ng_mi(MO_LI, u2, 0, 0, mask, 0, 0));
                    out.push(ng_mi(MO_AND, u3, sval, u2, 0, 0, 0));
                    var ins: i64 = u3;
                    if sh > 0 {
                        var u4: i64 = nvr;
                        var u5: i64 = nvr + 1;
                        nvr = nvr + 2;
                        out.push(ng_mi(MO_LI, u4, 0, 0, sh, 0, 0));
                        out.push(ng_mi(MO_SHL, u5, u3, u4, 0, 0, 0));
                        ins = u5;
                    }
                    out.push(ng_mi(MO_OR, w, w, ins, 0, 0, 0));
                }
            }
            done = true;
        }
        if !done && ci2 >= 0 {
            var cdb2: i64 = cps.get(ci2);
            var cdd2: i64 = cps.get(ci2 + 1);
            var csb2: i64 = cps.get(ci2 + 2);
            var csd2: i64 = cps.get(ci2 + 3);
            var csize: i64 = cps.get(ci2 + 4);
            var dprom: bool = cdb2 >= 0 && wbase.get(cdb2) >= 0;
            var sprom: bool = csb2 >= 0 && wbase.get(csb2) >= 0;
            if dprom || sprom {
                var j: i64 = 0;
                while j < csize / 8 {
                    if dprom && sprom {
                        out.push(ng_mi(MO_MOV, ng_rf_word(&wbase, cdb2, cdd2 / 8 + j), ng_rf_word(&wbase, csb2, csd2 / 8 + j), 0, 0, 0, 0));
                    } else if dprom {
                        out.push(ng_mi(MO_LOAD, ng_rf_word(&wbase, cdb2, cdd2 / 8 + j), m2.r1, 0, 8 * j, 8, 0));
                    } else {
                        out.push(ng_mi(MO_STORE, m2.r0, ng_rf_word(&wbase, csb2, csd2 / 8 + j), 0, 8 * j, 8, 0));
                    }
                    j = j + 1;
                }
                done = true;
            }
        }
        if !done && m2.op == MO_SLOTADDR && m2.r0 >= NG_VBASE && m2.r0 < rec.nvreg && HashMap_contains_i(bmap, m2.i0) {
            // LF24: the address of a slot kept in vregs is read by nothing
            // that still reaches memory (moves and constant offsets of it,
            // accesses and copies rewritten above, the hidden argument the
            // callee ignores), so it is not taken at all: a constant
            // instead, whose moves ng_dead_mir removes, and the callee
            // gets 0 as its unread hidden argument
            if wbase.get(HashMap_get_i(bmap, m2.i0)) >= 0 {
                out.push(ng_mi(MO_LI, m2.r0, 0, 0, 0, 0, 0));
                done = true;
            }
        }
        if !done {
            out.push(m2);
        }
        k = k + 1;
    }
    rec.mir = out;
    rec.nvreg = nvr;
    return nprom;
}

/// OP12: a unit function record over `mir` with vregs below NG_VBASE + nv.
fn ng_ru_rec(mir: Vec<MInst>, nv: i64, sret_v: i64, sret_size: i64) -> NatFnRec {
    return NatFnRec {
        name: "unit", mir: mir, nvreg: NG_VBASE + nv, base_frame: 0, slots: Vec::new(), is_ct: false, sret_v: sret_v, sret_size: sret_size, secret: false
    };
}

/// OP12 / ME27 / LF24: both halves of struct results in two registers on
/// small MIR functions (FID_VERIFY=1, from nat_sel_check). The callee
/// `PROLOGUE; MOV s, a0; STORE [s], x; STORE [s + 8], y; EPILOGUE` keeps
/// the words in vregs and returns them in argument registers 0 and 1. The
/// caller `SLOTADDR p, 32; MOV a0, p; CALL f; LOAD [p]; LOAD [p + 8]`
/// reads them from those registers with no load or store left
/// (ng_rr_caller_rewrite, ng_rf_promote); a caller that also passes the
/// slot's address to another call keeps it in memory. Skipped when
/// FID_NAT_OFF names retregs or retfwd. "" when every case holds.
pub fn nat_retfwd_unit_check(arch: i64) -> str {
    if !ng_on("retregs") || !ng_on("retfwd") {
        return "";
    }
    var g: NatGen = NatGen_new(arch);
    var v: i64 = NG_VBASE;
    var a0: i64 = ng_argreg(&g, 0);
    var a1: i64 = ng_argreg(&g, 1);
    var a2: i64 = ng_argreg(&g, 2);
    var err: str = "";
    // the callee
    var cm: Vec<MInst> = Vec::new();
    cm.push(ng_mi(MO_PROLOGUE, 0, 0, 0, 0, 0, 0));
    cm.push(ng_mi(MO_MOV, v, a0, 0, 0, 0, 0));
    cm.push(ng_mi(MO_MOV, v + 1, a1, 0, 0, 0, 0));
    cm.push(ng_mi(MO_LI, v + 2, 0, 0, 1, 0, 0));
    cm.push(ng_mi(MO_STORE, v, v + 1, 0, 0, 8, 0));
    cm.push(ng_mi(MO_LI, v + 3, 0, 0, 8, 0, 0));
    cm.push(ng_mi(MO_ADD, v + 4, v, v + 3, 0, 0, 0));
    cm.push(ng_mi(MO_STORE, v + 4, v + 2, 0, 0, 1, 0));
    cm.push(ng_mi(MO_EPILOGUE, 0, 0, 0, 0, 0, 0));
    var cr: NatFnRec = ng_ru_rec(cm, 8, v, 16);
    var an: Vec<i64> = ng_rr_analyze(&cr);
    if an.get(0) != 1 {
        err = err + "a callee storing a word and a byte not taken; ";
    } else if !ng_rr_callee_rewrite(&g, &mut cr) || ng_mu_count(&cr.mir, MO_STORE) != 0 {
        err = err + "the callee still stores its result; ";
    } else {
        var ep: i64 = ng_mu_find(&cr.mir, MO_EPILOGUE);
        if ep < 2 || cr.mir.get(ep - 2).op != MO_MOV || cr.mir.get(ep - 2).r0 != a0 || cr.mir.get(ep - 1).op != MO_MOV || cr.mir.get(ep - 1).r0 != a1 {
            err = err + "the callee does not return the words in registers; ";
        }
    }
    // a callee that reads its result back is not taken
    var bm: Vec<MInst> = Vec::new();
    bm.push(ng_mi(MO_PROLOGUE, 0, 0, 0, 0, 0, 0));
    bm.push(ng_mi(MO_MOV, v, a0, 0, 0, 0, 0));
    bm.push(ng_mi(MO_STORE, v, a1, 0, 0, 8, 0));
    bm.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
    bm.push(ng_mi(MO_STORE, v, v + 1, 0, 8, 8, 0));
    bm.push(ng_mi(MO_EPILOGUE, 0, 0, 0, 0, 0, 0));
    var br: NatFnRec = ng_ru_rec(bm, 8, v, 16);
    if ng_rr_analyze(&br).get(0) == 1 {
        err = err + "a callee loading from its result taken; ";
    }
    // the caller: the result slot read back field by field
    HashMap_insert_i(g.rr_size, 77, 16);
    var km: Vec<MInst> = Vec::new();
    km.push(ng_mi(MO_PROLOGUE, 0, 0, 0, 0, 0, 0));
    km.push(ng_mi(MO_SLOTADDR, v, 0, 0, 32, 0, 0));
    km.push(ng_mi(MO_MOV, a0, v, 0, 0, 0, 0));
    km.push(ng_mi(MO_LI, a1, 0, 0, 3, 0, 0));
    km.push(ng_mi(MO_CALL, 0, 0, 0, 77, 0, 0));
    km.push(ng_mi(MO_SLOTADDR, v + 1, 0, 0, 32, 0, 0));
    km.push(ng_mi(MO_LOAD, v + 2, v + 1, 0, 0, 8, 0));
    km.push(ng_mi(MO_SLOTADDR, v + 3, 0, 0, 32, 0, 0));
    km.push(ng_mi(MO_LI, v + 4, 0, 0, 8, 0, 0));
    km.push(ng_mi(MO_ADD, v + 5, v + 3, v + 4, 0, 0, 0));
    km.push(ng_mi(MO_LOAD, v + 6, v + 5, 0, 0, 1, 1));
    km.push(ng_mi(MO_ADD, v + 7, v + 2, v + 6, 0, 0, 0));
    km.push(ng_mi(MO_MOV, a0, v + 7, 0, 0, 0, 0));
    km.push(ng_mi(MO_EPILOGUE, 0, 0, 0, 0, 0, 0));
    var kr: NatFnRec = ng_ru_rec(km, 8, 0 - 1, 0);
    var feeds: Vec<i64> = Vec::new();
    if !ng_rr_caller_rewrite(&g, &mut kr, &mut feeds) {
        err = err + "the caller not rewritten; ";
    } else {
        var np: i64 = ng_rf_promote(&g, &mut kr, &feeds);
        if np != 1 || ng_mu_count(&kr.mir, MO_LOAD) != 0 || ng_mu_count(&kr.mir, MO_STORE) != 0 {
            err = err + "the caller's result slot left in memory; ";
        }
        // LF24: nor is its address taken any more
        if ng_mu_count(&kr.mir, MO_SLOTADDR) != 0 {
            err = err + "the caller's kept result slot still addressed; ";
        }
        // the byte at offset 8 is the low byte of the second register,
        // sign-extended
        if ng_mu_count(&kr.mir, MO_EXT) != 1 {
            err = err + "the caller's byte field not extended; ";
        }
    }
    // the same slot's address also given to another call: in memory
    var em: Vec<MInst> = Vec::new();
    em.push(ng_mi(MO_PROLOGUE, 0, 0, 0, 0, 0, 0));
    em.push(ng_mi(MO_SLOTADDR, v, 0, 0, 32, 0, 0));
    em.push(ng_mi(MO_MOV, a0, v, 0, 0, 0, 0));
    em.push(ng_mi(MO_CALL, 0, 0, 0, 77, 0, 0));
    em.push(ng_mi(MO_SLOTADDR, v + 1, 0, 0, 32, 0, 0));
    em.push(ng_mi(MO_MOV, a2, v + 1, 0, 0, 0, 0));
    em.push(ng_mi(MO_CALL, 0, 0, 0, 99, 0, 0));
    em.push(ng_mi(MO_SLOTADDR, v + 2, 0, 0, 32, 0, 0));
    em.push(ng_mi(MO_LOAD, v + 3, v + 2, 0, 0, 8, 0));
    em.push(ng_mi(MO_MOV, a0, v + 3, 0, 0, 0, 0));
    em.push(ng_mi(MO_EPILOGUE, 0, 0, 0, 0, 0, 0));
    var er: NatFnRec = ng_ru_rec(em, 8, 0 - 1, 0);
    var feeds2: Vec<i64> = Vec::new();
    if ng_rr_caller_rewrite(&g, &mut er, &mut feeds2) {
        if ng_rf_promote(&g, &mut er, &feeds2) != 0 || ng_mu_count(&er.mir, MO_LOAD) != 1 || ng_mu_count(&er.mir, MO_SLOTADDR) != 3 {
            err = err + "an escaping result slot promoted; ";
        }
    } else {
        err = err + "the second caller not rewritten; ";
    }
    if err != "" {
        return "struct results in registers (OP12): " + err;
    }
    return "";
}

/// ME27 / LF24: choose the functions whose struct result travels in two
/// registers and rewrite them and their callers (before allocation, so the
/// allocator, IPRA and the folding key see the new code). SP6: under the
/// CS6 cache a replayed function keeps the convention it was recorded with
/// (its entry's rr_self), takes part in `taken` through the addresses its
/// entry lists, and is not rewritten (its MIR is a summary); one that no
/// longer fits (its address now taken, its name now refused) has the image
/// built again without it (nc_give_up). Each function compiled here notes
/// the addresses it takes for its entry (g_nc_addrs).
fn ng_rr_plan(g: &mut NatGen) {
    g.rr_size = HashMap_new();
    if !ng_on("retregs") {
        return;
    }
    // Functions whose address is taken (a closure, a function value) may be
    // called from anywhere
    var taken: i64 = HashMap_new();
    if g.nc_on {
        g_nc_addrs = HashMap_new();
    }
    var ri: i64 = 0;
    while ri < g.recs.len() {
        var r: NatFnRec = g.recs.get(ri);
        var hix: i64 = nc_hit_at(g, r.name);
        if hix != 0 {
            // SP6: a replayed function's entry lists the addresses it takes
            var ha: Vec<str> = g.nc_old.get(hix - 1).addrs;
            var hk: i64 = 0;
            while hk < ha.len() {
                if HashMap_contains(g.fn_labels, ha.get(hk)) {
                    HashMap_insert_i(taken, HashMap_get(g.fn_labels, ha.get(hk)), 1);
                }
                hk = hk + 1;
            }
        }
        var anames: Vec<str> = Vec::new();
        var k: i64 = 0;
        while k < r.mir.len() {
            if r.mir.get(k).op == MO_ADDR {
                HashMap_insert_i(taken, r.mir.get(k).i0, 1);
                if g.nc_on && hix == 0 {
                    var ak: str = int_to_str(r.mir.get(k).i0);
                    if HashMap_contains(g.label_fn, ak) {
                        anames.push(HashMap_get(g.label_fn, ak));
                    }
                }
            }
            k = k + 1;
        }
        if g.nc_on && hix == 0 {
            HashMap_insert(g_nc_addrs, r.name, str_join(anames, ","));
        }
        ri = ri + 1;
    }
    ri = 0;
    while ri < g.recs.len() {
        var r2: NatFnRec = g.recs.get(ri);
        var hix2: i64 = nc_hit_at(g, r2.name);
        if hix2 != 0 {
            // SP6: the convention it was recorded with, while it still fits
            var rs: i64 = g.nc_old.get(hix2 - 1).rr_self;
            if rs > 0 {
                var hl: i64 = HashMap_get(g.fn_labels, r2.name);
                if HashMap_contains_i(taken, hl) || !ng_rr_name_ok(g, r2.name) {
                    nc_give_up_callers(g, r2.name);
                } else {
                    HashMap_insert_i(g.rr_size, hl, rs);
                }
            }
        } else if r2.sret_v >= 0 && !r2.is_ct && ng_rr_name_ok(g, r2.name) {
            var lab: i64 = HashMap_get(g.fn_labels, r2.name);
            if !HashMap_contains_i(taken, lab) {
                var an: Vec<i64> = ng_rr_analyze(&r2);
                if an.get(0) == 1 {
                    HashMap_insert_i(g.rr_size, lab, r2.sret_size);
                }
            }
        }
        ri = ri + 1;
    }
    ri = 0;
    while ri < g.recs.len() {
        var r3: NatFnRec = g.recs.get(ri);
        if nc_hit_at(g, r3.name) != 0 {
            // SP6: replayed as recorded (its MIR is a summary)
            ri = ri + 1;
            continue;
        }
        var changed: bool = false;
        if HashMap_contains_i(g.rr_size, HashMap_get(g.fn_labels, r3.name)) {
            changed = ng_rr_callee_rewrite(g, &mut r3);
        }
        var feeds: Vec<i64> = Vec::new();
        if ng_rr_caller_rewrite(g, &mut r3, &mut feeds) {
            changed = true;
            // OP12: the result slots in vregs, not memory
            var nprom: i64 = ng_rf_promote(g, &mut r3, &feeds);
            g.n_peep = g.n_peep + nprom;
        }
        if changed {
            g.recs.set(ri, r3);
        }
        ri = ri + 1;
    }
}

// SP2: the machine layer's rows of the `--time` table. compiler.fd's
// time_mark / time_row are out of reach here (nat_ir does not import
// compiler::compiler), so the rows are kept here, as iropt.fd keeps its
// passes' times, and the driver appends them (nat_time_names / nat_time_ms
// through time_row) after nat_generate, when it turned them on with
// nat_set_time_on.
var g_nat_time_on: bool = false;
var g_nat_time_names: Vec<str> = Vec::new();
var g_nat_time_ms: Vec<i64> = Vec::new();

pub fn nat_set_time_on() {
    g_nat_time_on = true;
}

/// The rows recorded so far (nat_time_clear empties them: a long-lived
/// process builds again).
pub fn nat_time_names() -> Vec<str> {
    return g_nat_time_names;
}

pub fn nat_time_ms() -> Vec<i64> {
    return g_nat_time_ms;
}

pub fn nat_time_clear() {
    g_nat_time_names = Vec::new();
    g_nat_time_ms = Vec::new();
}

/// Record `now - since` under `name` when the rows are on; returns `now`
/// (as compiler.fd time_mark).
fn nat_time_mark(name: str, since: i64) -> i64 {
    var now: i64 = p_clock_now_ms();
    if g_nat_time_on {
        g_nat_time_names.push(name);
        g_nat_time_ms.push(now - since);
    }
    return now;
}

/// A row of `ms` measured elsewhere (as compiler.fd time_row).
fn nat_time_row(name: str, ms: i64) {
    if g_nat_time_on {
        g_nat_time_names.push(name);
        g_nat_time_ms.push(ms);
    }
}

// ===========================================================================
// SP5 (llvm-roadmap): code generation by workers. With FID_NAT_PAR set
// (not "0"), ng_mir_finish allocates every function and decides its fold
// as before, then (ng_par_finish):
//   1. a worker emits each placed function into a buffer of its own
//      (ng_par_emit_job): a copy of the generator whose encoder knows the
//      image's label numbers but no position (every label unplaced), the
//      function's own label at 0, its own panic-line stubs, line and frame
//      rows. It never reads where anything is, so the workers do not
//      depend on each other or on the order they run in;
//   2. the buffers are joined in placement order (ng_par_join): bytes at
//      the function's offset, the labels it made renumbered into the
//      image (a panic-line stub the image has already is that one), its
//      fixups, rows and the generator's state after it.
// The image is the serial one byte for byte. Where a function's bytes
// depend on its position, the join emits it again in place instead
// (ng_par_redo): x86-64 aligns loop heads to 16 bytes, functions to 4, so
// a function with a loop head that does not start on 16; RISC-V shortens
// a call to a function already placed within reach of a JAL.
// FID_NAT_MUTATE=par joins those too (tests/nattools/par_emit_check.sh
// sees the image differ). The build prints one "[par]" line: functions
// joined, emitted again, the threads, and the milliseconds of the taint
// marks, the workers and the join.
//
// Threads: FID_NAT_PAR=<n> runs the workers on n threads (16 at most;
// any other value than a number or "0": 4), each over a contiguous chunk
// of the jobs of about the same size (ng_par_chunks); 1 runs them on this
// thread. A thread (ng_par_thread, spawned with its chunk's bounds as
// borrowck.fd bc_par_worker is) shares nothing it writes with another:
//  - the emission (ng_mir_emit_w and all it calls) writes no module
//    global and inserts into no map of the generator but the job's own
//    pl_keys, which tests/nattools/par_emit_globals.py checks over every
//    function the spawned ng_par_thread reaches (the race check,
//    typechecker.fd TypeChecker_verify_no_races, sees only the spawns of
//    the program's main file, not those of an imported module):
//    what one function's emission keeps is in NatGen (sw_pro, sw_ep,
//    ldfwd_n, dbg_mpos, dbg_mark_on, line_fix, par_log); the tables it
//    reads are made before (ng_emit_tables: the selection table, the
//    float-register switches); MI28's taint marks, whose summaries are
//    module state and depend on the order functions are analysed in, are
//    made for every function on this thread in placement order
//    (ng_tail_pre) and handed to each job; the debug locations
//    (ng_dbg_vars_resolve) are made at the join;
//  - owner counts are not atomic (core.fd "Copies for another thread"),
//    so each thread has a generator of its own, made here before the
//    spawns (ng_par_gen: a NatGen_new with g's numbers and the maps' raw
//    handles, which emission only reads; nothing of it shares a buffer
//    with g or another thread's), and a job's function and allocation are
//    touched by the one thread that emits it.
// The join is on this thread, in placement order, as before; so the image
// is the same with any number of threads.
// ===========================================================================

/// What the driver keeps for each function ng_mir_finish allocated, in
/// placement order: the final MIR, its allocation, the job whose bytes it
/// shares (-1: placed itself), its line rows' file.
pub struct NatParState {
    pub recs: Vec<NatFnRec>,
    pub als: Vec<NatAlloc>,
    pub fold_to: Vec<i64>,
    pub file_ix: Vec<i64>,
    // fold key -> 1 + the job placed with it
    pub fold_ix: i64,
    // labels below n0 are the image's (all made by recording); at and above
    // n0, a worker's own
    pub n0: i64,
    pub n_redo: i64,
    // MI28: each job's taint marks (ng_tail_pre), made in placement order
    pub taints: Vec<Vec<i64>>,
}

/// A worker's output: the function's bytes and fixups with offsets from
/// its start, the image's labels it placed ([label, offset] pairs), where
/// each label it made was placed (-1: not placed by it), the panic-line
/// stubs it asked for ([which, line, its label] and the keys), its line
/// and frame rows, and the generator's per-function state after it.
pub struct NatParBuf {
    pub code: Vec<i64>,
    pub fixups: Vec<NatFix>,
    pub placed: Vec<i64>,
    pub fresh: Vec<i64>,
    pub pl_list: Vec<i64>,
    pub pl_names: Vec<str>,
    pub lrows: Vec<i64>,
    pub cfi_rows: Vec<i64>,
    pub lrow_open: bool,
    pub last_place: i64,
    pub mul_end: i64,
    pub ldfwd: i64,
    pub save_regs: Vec<i64>,
    pub save_off: i64,
    pub frame: i64,
    pub leaf: i64,
    pub wipe: i64,
    pub x0_reg: i64,
    pub x1_reg: i64,
    pub br_short: bool,
    pub err: str,
    // CT6: where each machine instruction starts (offsets from the
    // function's start; -1 none) when its variables are described, for
    // ng_dbg_vars_resolve at the join; what `--stats` says about it
    pub dbg_mpos: Vec<i64>,
    pub dbg_on: bool,
    pub log: str,
}

/// FID_NAT_PAR set and not "0". Not with the function cache (CS6, whose
/// capture reads the image) or a line sequence left open before the code.
fn ng_par_on(g: &NatGen) -> bool {
    if ng_par_workers() == 0 {
        return false;
    }
    return !g.nc_on && !g.lrow_open;
}

/// SP5: the threads FID_NAT_PAR asks for: 0 off (unset, empty or "0"), a
/// number n (1..16; 1: the workers run on this thread), any other value 4.
fn ng_par_workers() -> i64 {
    var v: str = p_getenv("FID_NAT_PAR");
    if (v as i64) == 0 || str_len(v) == 0 || v == "0" {
        return 0;
    }
    var n: i64 = 0;
    var i: i64 = 0;
    while i < str_len(v) {
        var c: i64 = str_byte_at(v, i);
        if c < 48 || c > 57 || n > 1000 {
            return 4;
        }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    if n < 1 {
        return 0;
    }
    if n > 16 {
        return 16;
    }
    return n;
}

fn ng_par_state_new() -> NatParState {
    return NatParState {
        recs: Vec::new(), als: Vec::new(), fold_to: Vec::new(), file_ix: Vec::new(), fold_ix: HashMap_new(), n0: 0, n_redo: 0, taints: Vec::new(),
    };
}

fn ng_par_buf_new() -> NatParBuf {
    return NatParBuf {
        code: Vec::new(), fixups: Vec::new(), placed: Vec::new(), fresh: Vec::new(), pl_list: Vec::new(), pl_names: Vec::new(), lrows: Vec::new(), cfi_rows: Vec::new(), lrow_open: false, last_place: 0 - 1, mul_end: 0 - 1, ldfwd: 0, save_regs: Vec::new(), save_off: 0, frame: 0, leaf: 0, wipe: 0, x0_reg: 0 - 1, x1_reg: 0 - 1, br_short: false, err: "", dbg_mpos: Vec::new(), dbg_on: false, log: "",
    };
}

/// A function allocated by ng_mir_finish, for the workers: folded into the
/// first job with the same key as the serial loop folds it.
fn ng_par_add(st: &mut NatParState, rec: NatFnRec, al: NatAlloc, key: str, fold_on: bool) {
    var to: i64 = 0 - 1;
    if fold_on && HashMap_contains(st.fold_ix, key) {
        to = HashMap_get(st.fold_ix, key) - 1;
    } else if fold_on {
        HashMap_insert(st.fold_ix, key, st.recs.len() + 1);
    }
    // SP5: the job's function and allocation in buffers of their own, so
    // that the one worker thread that emits it shares no owner count with
    // another (a recorded MIR may still share its buffer with g.recs)
    var orec: NatFnRec = rec;
    orec.name = ng_par_own_str(rec.name);
    orec.mir = ng_par_own_mir(&rec.mir);
    orec.slots = ng_par_own_i64s(&rec.slots);
    var oal: NatAlloc = al;
    oal.assign = ng_par_own_i64s(&al.assign);
    oal.remat = ng_par_own_i64s(&al.remat);
    oal.remat_val = ng_par_own_i64s(&al.remat_val);
    oal.spill = ng_par_own_i64s(&al.spill);
    oal.save_regs = ng_par_own_i64s(&al.save_regs);
    oal.cls = ng_par_own_i64s(&al.cls);
    oal.err = ng_par_own_str(al.err);
    st.recs.push(orec);
    st.als.push(oal);
    st.fold_to.push(to);
    st.file_ix.push(g_nat_line_file_ix);
}

/// SP5: `s` in a buffer of its own (escape.fd par_own_str).
fn ng_par_own_str(s: str) -> str {
    return p_str_adopt(p_str_send_copy(s as i64));
}

/// SP5: a machine IR in a buffer of its own.
fn ng_par_own_mir(v: &Vec<MInst>) -> Vec<MInst> {
    var out: Vec<MInst> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        out.push(v.get(i));
        i = i + 1;
    }
    return out;
}

/// The function has a loop head (a label a later branch goes back to)
/// that x86-64 pads to 16 bytes (ng_mir_emit_pass, MI30: only after an
/// unconditional jump or a trap), so its bytes depend on where it starts.
fn ng_par_loop_heads(rec: &NatFnRec) -> bool {
    var place: i64 = HashMap_new();
    var k: i64 = 0;
    while k < rec.mir.len() {
        if rec.mir.get(k).op == MO_PLACE {
            HashMap_insert(place, int_to_str(rec.mir.get(k).i0), k);
        }
        k = k + 1;
    }
    var heads: i64 = HashMap_new();
    k = 0;
    while k < rec.mir.len() {
        var m: MInst = rec.mir.get(k);
        if mi_is_br(m.op) && HashMap_contains(place, int_to_str(m.i0)) && HashMap_get(place, int_to_str(m.i0)) < k {
            HashMap_insert(heads, int_to_str(m.i0), 1);
        }
        k = k + 1;
    }
    // As ng_mir_emit_pass (MI30): a head is padded only where the op before
    // it (over MO_LINE) is an unconditional jump or a trap
    var found: bool = false;
    k = 0;
    while k < rec.mir.len() && !found {
        var mp: MInst = rec.mir.get(k);
        if mp.op == MO_PLACE && HashMap_contains(heads, int_to_str(mp.i0)) {
            var pb: i64 = k - 1;
            while pb >= 0 && rec.mir.get(pb).op == MO_LINE {
                pb = pb - 1;
            }
            if pb >= 0 && (rec.mir.get(pb).op == MO_JMP || rec.mir.get(pb).op == MO_TRAP) {
                found = true;
            }
        }
        k = k + 1;
    }
    return found;
}

/// The worker's bytes may differ from what the serial loop emits at `base`:
/// x86-64 with a loop head when `base` is not on the loop alignment;
/// RISC-V (with relaxation) when a call goes to a function already placed.
fn ng_par_redo(g: &NatGen, rec: &NatFnRec, base: i64) -> bool {
    if ng_x64(g) {
        var la: i64 = ng_code_align(g, NG_ALIGN_LOOP);
        if la > ng_code_align(g, NG_ALIGN_FN) && base % la != 0 {
            return ng_par_loop_heads(rec);
        }
        return false;
    }
    if ng_a64(g) || !ng_on("relax") {
        return false;
    }
    var own: i64 = HashMap_get(g.fn_labels, rec.name);
    var k: i64 = 0;
    while k < rec.mir.len() {
        var m: MInst = rec.mir.get(k);
        if m.op == MO_CALL && m.i0 != own && m.i0 > 0 && m.i0 < g.e.labels.len() && g.e.labels.get(m.i0) >= 0 {
            return true;
        }
        k = k + 1;
    }
    return false;
}

/// SP5: what the worker threads read, set by ng_par_finish before they
/// start and emptied after the last one ends (spawn arguments are numbers:
/// a thread gets its index and its chunk's bounds, as borrowck.fd's
/// bc_par_worker does). Only read while they run: a generator per thread
/// (ng_par_gen), and per job the function, its allocation, its taint marks
/// (ng_tail_pre), the file of its line rows, the job it is folded into
/// (-1: none); n0 the image's label count.
pub var g_ng_par_gens: Vec<NatGen> = Vec::new();
pub var g_ng_par_recs: Vec<NatFnRec> = Vec::new();
pub var g_ng_par_als: Vec<NatAlloc> = Vec::new();
pub var g_ng_par_taints: Vec<Vec<i64>> = Vec::new();
pub var g_ng_par_fix: Vec<i64> = Vec::new();
pub var g_ng_par_fold: Vec<i64> = Vec::new();
pub var g_ng_par_n0: i64 = 0;

/// SP5: `v` in a buffer of its own: it shares no owner count with `v`.
fn ng_par_own_i64s(v: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        out.push(v.get(i));
        i = i + 1;
    }
    return out;
}

/// SP5: a worker thread's generator, made on the main thread before the
/// threads start. It shares no Vec or string with `g` or with another
/// thread's (owner counts are not atomic): a NatGen_new of the target (its
/// target description is that one's: NatGen.td never changes after it),
/// with g's numbers and switches, the raw handles of g's maps (emission
/// only looks them up; the one it writes, pl_keys, is each job's own,
/// ng_par_emit_job) and copies of the lists emission reads. What emission
/// never reads (the recorded functions, the string, global and import
/// lists, the cache) stays empty; ng_par_emit_job checks that the lists a
/// new label of the image would go to stay empty. A field added to NatGen
/// that emission reads must be copied here (else par_emit_check.sh sees
/// the image differ).
fn ng_par_gen(g: &NatGen) -> NatGen {
    var w: NatGen = NatGen_new(g.arch);
    w.fn_labels = g.fn_labels;
    w.ct_labels = g.ct_labels;
    w.all_fns = g.all_fns;
    w.queued = g.queued;
    w.str_labels = g.str_labels;
    w.glob_labels = g.glob_labels;
    w.panic_labels = ng_par_own_i64s(&g.panic_labels);
    w.start_sp_label = g.start_sp_label;
    w.entry_label = g.entry_label;
    w.unresolved_seen = g.unresolved_seen;
    w.named_seen = g.named_seen;
    w.fn_table_label = g.fn_table_label;
    w.c_names = g.c_names;
    w.tramp_label = g.tramp_label;
    w.va_off = g.va_off;
    w.vreg = ng_par_own_i64s(&g.vreg);
    w.save_regs = ng_par_own_i64s(&g.save_regs);
    w.save_off = g.save_off;
    w.names_label = g.names_label;
    w.code_end_label = g.code_end_label;
    w.rec = g.rec;
    w.nvreg = g.nvreg;
    w.promoted = ng_par_own_i64s(&g.promoted);
    w.frame = g.frame;
    w.label_fn = g.label_fn;
    w.fn_mask = g.fn_mask;
    w.n_folded = g.n_folded;
    w.n_peep = g.n_peep;
    w.cur_wrapping = g.cur_wrapping;
    w.cur_crashfree = g.cur_crashfree;
    w.cf_fns = g.cf_fns;
    w.leaf = g.leaf;
    w.wipe = g.wipe;
    w.rr_size = g.rr_size;
    w.internal = g.internal;
    w.lib_mask = g.lib_mask;
    w.slots = ng_par_own_i64s(&g.slots);
    w.alloca_data = ng_par_own_i64s(&g.alloca_data);
    w.block_labels = g.block_labels;
    w.next_block_label = g.next_block_label;
    w.t0 = g.t0;
    w.t1 = g.t1;
    w.t2 = g.t2;
    w.t3 = g.t3;
    w.ad = g.ad;
    w.ad2 = g.ad2;
    w.zr = g.zr;
    w.arg0 = g.arg0;
    w.win = g.win;
    w.mac = g.mac;
    w.mac_got_label = g.mac_got_label;
    w.win_slot_labels = ng_par_own_i64s(&g.win_slot_labels);
    w.win_slots_label = g.win_slots_label;
    w.win_tls_label = g.win_tls_label;
    w.win_imp_label = g.win_imp_label;
    w.win_imp_end = g.win_imp_end;
    w.win_iat_label = g.win_iat_label;
    w.win_iat_end = g.win_iat_end;
    w.line_fns = g.line_fns;
    w.lines_cur_fn = g.lines_cur_fn;
    w.cur_line = g.cur_line;
    w.unchecked = ng_par_own_i64s(&g.unchecked);
    w.cur_inst_line = g.cur_inst_line;
    w.x0_reg = g.x0_reg;
    w.x1_reg = g.x1_reg;
    w.br_short = g.br_short;
    w.pie_table = g.pie_table;
    w.nc_ix = g.nc_ix;
    w.nc_hit = g.nc_hit;
    w.nc_key = g.nc_key;
    w.nc_salt = g.nc_salt;
    w.label_id = g.label_id;
    w.sw_pro = g.sw_pro;
    w.sw_ep = g.sw_ep;
    w.par_w = true;
    return w;
}

/// SP5: chunks of the jobs for `nw` threads, in order, of about the same
/// number of machine instructions (a folded job counts nothing), as
/// [start0, end0, start1, end1, ...]; nw at most, none empty.
fn ng_par_chunks(st: &NatParState, nw: i64) -> Vec<i64> {
    var nj: i64 = st.recs.len();
    var out: Vec<i64> = Vec::new();
    var sizes: Vec<i64> = Vec::new();
    var total: i64 = 0;
    var j: i64 = 0;
    while j < nj {
        var sz: i64 = 0;
        if st.fold_to.get(j) < 0 {
            var rj: NatFnRec = st.recs.get(j);
            sz = rj.mir.len() + 1;
        }
        sizes.push(sz);
        total = total + sz;
        j = j + 1;
    }
    var target: i64 = (total + nw - 1) / nw;
    if target < 1 {
        target = 1;
    }
    var s: i64 = 0;
    var acc: i64 = 0;
    j = 0;
    while j < nj {
        acc = acc + sizes.get(j);
        if acc >= target && out.len() / 2 < nw - 1 {
            out.push(s);
            out.push(j + 1);
            s = j + 1;
            acc = 0;
        }
        j = j + 1;
    }
    if s < nj {
        out.push(s);
        out.push(nj);
    }
    return out;
}

/// SP5: a worker thread: jobs s..e with generator wi of g_ng_par_gens, one
/// buffer per job (a folded one's empty), in order. Its label table (n0
/// entries, every one unplaced between two jobs) is its own.
pub fn ng_par_thread(wi: i64, s: i64, e: i64) -> Vec<NatParBuf> {
    var out: Vec<NatParBuf> = Vec::new();
    var scratch: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < g_ng_par_n0 {
        scratch.push(0 - 1);
        i = i + 1;
    }
    var ji: i64 = s;
    while ji < e {
        if g_ng_par_fold.get(ji) >= 0 {
            out.push(ng_par_buf_new());
        } else {
            var w: NatGen = g_ng_par_gens.get(wi);
            w.e.labels = scratch;
            scratch = Vec::new();
            var b: NatParBuf = ng_par_emit_job(&mut w, ji);
            scratch = w.e.labels;
            w.e.labels = Vec::new();
            out.push(b);
        }
        ji = ji + 1;
    }
    return out;
}

/// Emit job `ji` into a buffer of its own, with `w` a fresh copy of its
/// thread's generator whose encoder's label table has every label
/// unplaced. The job gets its own panic-line stubs and rows. The labels it
/// places are reset afterwards, so the next job sees the table unplaced
/// again.
fn ng_par_emit_job(w: &mut NatGen, ji: i64) -> NatParBuf {
    var rec: NatFnRec = g_ng_par_recs.get(ji);
    var al: NatAlloc = g_ng_par_als.get(ji);
    var taint: Vec<i64> = g_ng_par_taints.get(ji);
    var n0: i64 = g_ng_par_n0;
    w.pl_keys = HashMap_new();
    w.lrow_open = false;
    w.cur_name = rec.name;
    w.line_fix = g_ng_par_fix.get(ji);
    w.tc_taint = taint;
    w.ldfwd_n = 0;
    w.par_log = "";
    var own: i64 = HashMap_get(w.fn_labels, rec.name);
    NatEnc_place(&mut w.e, own);
    ng_mir_emit_w(w, &rec, &al);
    HashMap_drop(w.pl_keys);
    w.pl_keys = 0;
    var err: str = "";
    if w.strs.len() + w.globs.len() + w.fn_label_names.len() + w.queue.len() + w.named_fns.len() + w.unresolved.len() + w.ld.names.len() + w.ld.stub_keys.len() != 0 {
        // a label of the image made while emitting: its number is the
        // worker's, so the image's tables would be wrong (never so far:
        // recording makes them)
        err = "native backend: parallel code generation (FID_NAT_PAR): " + rec.name + " made a label of the image while it was emitted";
    }
    // The image's labels it placed: its own and its MO_PLACE labels
    var placed: Vec<i64> = Vec::new();
    var k: i64 = 0 - 1;
    while k < rec.mir.len() {
        var l: i64 = 0;
        if k < 0 {
            l = own;
        } else if rec.mir.get(k).op == MO_PLACE {
            l = rec.mir.get(k).i0;
        }
        if l > 0 && l < n0 && w.e.labels.get(l) >= 0 {
            placed.push(l);
            placed.push(w.e.labels.get(l));
            w.e.labels.set(l, 0 - 1);
        }
        k = k + 1;
    }
    var fresh: Vec<i64> = Vec::new();
    var fi: i64 = n0;
    while fi < w.e.labels.len() {
        fresh.push(w.e.labels.get(fi));
        fi = fi + 1;
    }
    w.e.labels.truncate(n0);
    if ng_verify_on() && err == "" {
        // every label unplaced again for the next job
        var vi: i64 = 0;
        while vi < n0 && err == "" {
            if w.e.labels.get(vi) >= 0 {
                err = "native backend: parallel code generation (FID_NAT_PAR): " + rec.name + " placed label " + int_to_str(vi) + ", which is not its own or one of its MO_PLACE labels";
            }
            vi = vi + 1;
        }
    }
    return NatParBuf {
        code: w.e.code, fixups: w.e.fixups, placed: placed, fresh: fresh, pl_list: w.pl_list, pl_names: w.pl_names, lrows: w.lrows, cfi_rows: w.cfi_rows, lrow_open: w.lrow_open, last_place: w.e.last_place, mul_end: w.e.mul_end, ldfwd: w.ldfwd_n, save_regs: w.save_regs, save_off: w.save_off, frame: w.frame, leaf: w.leaf, wipe: w.wipe, x0_reg: w.x0_reg, x1_reg: w.x1_reg, br_short: w.br_short, err: err, dbg_mpos: w.dbg_mpos, dbg_on: w.dbg_mark_on, log: w.par_log,
    };
}

/// Append a worker's function at `base` (its label already placed there).
fn ng_par_join(g: &mut NatGen, b: &NatParBuf, base: i64, n0: i64) {
    // The labels it made: placed ones become labels of the image at their
    // offsets; a panic-line stub is the image's stub for that key, made
    // here (in the worker's order) when the image has none yet
    var fmap: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < b.fresh.len() {
        var nl: i64 = 0;
        if b.fresh.get(i) >= 0 {
            nl = NatEnc_label(&mut g.e);
            g.e.labels.set(nl, base + b.fresh.get(i));
        }
        fmap.push(nl);
        i = i + 1;
    }
    i = 0;
    while i + 2 < b.pl_list.len() {
        var key: str = b.pl_names.get(i / 3);
        var ml: i64 = 0;
        if HashMap_contains(g.pl_keys, key) {
            ml = HashMap_get(g.pl_keys, key);
        } else {
            ml = NatEnc_label(&mut g.e);
            HashMap_insert(g.pl_keys, key, ml);
            g.pl_names.push(key);
            g.pl_list.push(b.pl_list.get(i));
            g.pl_list.push(b.pl_list.get(i + 1));
            g.pl_list.push(ml);
        }
        var wl: i64 = b.pl_list.get(i + 2);
        if wl >= n0 && wl - n0 < fmap.len() {
            fmap.set(wl - n0, ml);
        }
        i = i + 3;
    }
    i = 0;
    while i + 1 < b.placed.len() {
        g.e.labels.set(b.placed.get(i), base + b.placed.get(i + 1));
        i = i + 2;
    }
    i = 0;
    while i < b.code.len() {
        g.e.code.push(b.code.get(i));
        i = i + 1;
    }
    i = 0;
    while i < b.fixups.len() {
        var fx: NatFix = b.fixups.get(i);
        var lab: i64 = fx.label;
        if lab >= n0 {
            lab = 0;
            if fx.label - n0 < fmap.len() {
                lab = fmap.get(fx.label - n0);
            }
        }
        NatEnc_fix_at(&mut g.e, base + fx.pos, lab, fx.kind);
        i = i + 1;
    }
    // Line rows [offset, line, word] and frame rows [offset, offset or a
    // negative code, offset], as the serial emission made them
    i = 0;
    while i + 2 < b.lrows.len() {
        g.lrows.push(base + b.lrows.get(i));
        g.lrows.push(b.lrows.get(i + 1));
        g.lrows.push(b.lrows.get(i + 2));
        i = i + 3;
    }
    i = 0;
    while i + 2 < b.cfi_rows.len() {
        g.cfi_rows.push(base + b.cfi_rows.get(i));
        var c1: i64 = b.cfi_rows.get(i + 1);
        if c1 >= 0 {
            c1 = base + c1;
        }
        g.cfi_rows.push(c1);
        g.cfi_rows.push(base + b.cfi_rows.get(i + 2));
        i = i + 3;
    }
    g.lrow_open = b.lrow_open;
    if b.last_place >= 0 {
        g.e.last_place = base + b.last_place;
    }
    g.e.mul_end = 0 - 1;
    if b.mul_end >= 0 {
        g.e.mul_end = base + b.mul_end;
    }
    // The per-function state the serial emission leaves behind
    g.save_regs = b.save_regs;
    g.save_off = b.save_off;
    g.frame = b.frame;
    g.leaf = b.leaf;
    g.wipe = b.wipe;
    g.x0_reg = b.x0_reg;
    g.x1_reg = b.x1_reg;
    g.br_short = b.br_short;
    // SP5: TG17's count, CT6's instruction positions at the image's
    // offsets (for ng_dbg_vars_resolve, run next by ng_par_finish) and
    // what `--stats` says about the function, in placement order
    g_nat_ldfwd_n = g_nat_ldfwd_n + b.ldfwd;
    g.dbg_mark_on = b.dbg_on;
    var mp: Vec<i64> = Vec::new();
    i = 0;
    while i < b.dbg_mpos.len() {
        var pos: i64 = b.dbg_mpos.get(i);
        if pos >= 0 {
            pos = base + pos;
        }
        mp.push(pos);
        i = i + 1;
    }
    g.dbg_mpos = mp;
    if str_len(b.log) > 0 {
        p_eprint_str(b.log);
    }
}

/// After ng_mir_finish's loop: the workers, then the join in placement
/// order (the serial loop's placement, folds and facts lines).
fn ng_par_finish(g: &mut NatGen, st: &mut NatParState) -> str {
    var nj: i64 = st.recs.len();
    st.n0 = g.e.labels.len();
    ng_emit_tables();
    // MI28: every job's taint marks, here and in placement order, as the
    // serial emission makes them (ng_tail_pre fills module-level summaries)
    var t_pre: i64 = p_clock_now_ms();
    var taints: Vec<Vec<i64>> = Vec::new();
    var ji: i64 = 0;
    while ji < nj {
        if st.fold_to.get(ji) >= 0 {
            var none: Vec<i64> = Vec::new();
            taints.push(none);
        } else {
            var rec0: NatFnRec = st.recs.get(ji);
            var al0: NatAlloc = st.als.get(ji);
            g.cur_name = rec0.name;
            var tt: Vec<i64> = ng_tail_pre(g, &rec0, &al0);
            taints.push(tt);
        }
        ji = ji + 1;
    }
    st.taints = taints;
    // The workers: a generator per thread, the jobs in chunks
    var t_work: i64 = p_clock_now_ms();
    var nw: i64 = ng_par_workers();
    var bounds: Vec<i64> = ng_par_chunks(st, nw);
    var nch: i64 = bounds.len() / 2;
    var gens: Vec<NatGen> = Vec::new();
    var gi: i64 = 0;
    while gi < nch || gi == 0 {
        gens.push(ng_par_gen(g));
        gi = gi + 1;
    }
    g_ng_par_gens = gens;
    g_ng_par_recs = st.recs;
    g_ng_par_als = st.als;
    g_ng_par_taints = st.taints;
    g_ng_par_fix = st.file_ix;
    g_ng_par_fold = st.fold_to;
    g_ng_par_n0 = st.n0;
    var bufs: Vec<NatParBuf> = Vec::new();
    var nthreads: i64 = 1;
    if nw <= 1 || nch <= 1 {
        // on this thread
        bufs = ng_par_thread(0, 0, nj);
    } else {
        nthreads = nch;
        var futs: Vec<Future<Vec<NatParBuf>> > = Vec::new();
        var wi: i64 = 0;
        while wi < nch {
            var cs: i64 = bounds.get(2 * wi);
            var ce: i64 = bounds.get(2 * wi + 1);
            futs.push(spawn ng_par_thread(wi, cs, ce));
            wi = wi + 1;
        }
        wi = 0;
        while wi < futs.len() {
            var part: Vec<NatParBuf> = await futs.get(wi);
            var pi: i64 = 0;
            while pi < part.len() {
                bufs.push(part.get(pi));
                pi = pi + 1;
            }
            wi = wi + 1;
        }
    }
    var no_gens: Vec<NatGen> = Vec::new();
    g_ng_par_gens = no_gens;
    var no_recs: Vec<NatFnRec> = Vec::new();
    g_ng_par_recs = no_recs;
    var no_als: Vec<NatAlloc> = Vec::new();
    g_ng_par_als = no_als;
    var no_taints: Vec<Vec<i64>> = Vec::new();
    g_ng_par_taints = no_taints;
    var no_fix: Vec<i64> = Vec::new();
    g_ng_par_fix = no_fix;
    var no_fold: Vec<i64> = Vec::new();
    g_ng_par_fold = no_fold;
    g_ng_par_n0 = 0;
    if bufs.len() != nj {
        return "native backend: parallel code generation (FID_NAT_PAR): " + int_to_str(bufs.len()) + " buffers for " + int_to_str(nj) + " functions";
    }
    ji = 0;
    while ji < nj {
        var eb: NatParBuf = bufs.get(ji);
        if eb.err != "" {
            return eb.err;
        }
        ji = ji + 1;
    }
    var t_join: i64 = p_clock_now_ms();
    var jbase: Vec<i64> = Vec::new();
    var n_joined: i64 = 0;
    ji = 0;
    while ji < nj {
        var rec: NatFnRec = st.recs.get(ji);
        g.cur_name = rec.name;
        g_nat_line_file_ix = st.file_ix.get(ji);
        var label: i64 = HashMap_get(g.fn_labels, rec.name);
        var to: i64 = st.fold_to.get(ji);
        if to >= 0 {
            // The same bytes are already in the image: this name points there
            g.e.labels.set(label, jbase.get(to));
            g.n_folded = g.n_folded + 1;
            jbase.push(jbase.get(to));
        } else {
            NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
            NatEnc_place(&mut g.e, label);
            var base: i64 = g.e.code.len();
            jbase.push(base);
            g.placed_fns.push(rec.name);
            var al: NatAlloc = st.als.get(ji);
            var b: NatParBuf = bufs.get(ji);
            // (FID_NAT_MUTATE=par: never emitted again, so a function whose
            // bytes depend on its position is joined wrong: the check
            // tests/nattools/par_emit_check.sh must see the image differ)
            if ng_par_redo(g, &rec, base) && !ng_mutant("par") {
                // in place, with the marks made for it in order (not
                // ng_mir_emit, which would analyse it again now)
                var rt: Vec<i64> = st.taints.get(ji);
                g.tc_taint = rt;
                var lfr: i64 = g.ldfwd_n;
                ng_mir_emit_w(g, &rec, &al);
                g_nat_ldfwd_n = g_nat_ldfwd_n + g.ldfwd_n - lfr;
                st.n_redo = st.n_redo + 1;
            } else {
                ng_par_join(g, &b, base, st.n0);
                n_joined = n_joined + 1;
            }
            // DB4: its variables' locations, now that its frame and place
            // are known (here, not in the worker: it fills module state)
            ng_dbg_vars_resolve(g, &rec, &al);
            // WP20: the facts artifact's line, as the serial loop writes it
            if (g.fact_path as i64) != 0 && str_len(g.fact_path) > 0 {
                p_file_append(g.fact_path, "ext " + rec.name + " mask=" + int_to_str(al.mask) + " size=" + int_to_str(g.e.code.len() - base) + "\n");
            }
            ng_line_close(g);
        }
        ji = ji + 1;
    }
    var t_end: i64 = p_clock_now_ms();
    p_eprint_str("[par] FID_NAT_PAR: " + int_to_str(n_joined) + " functions joined from worker buffers, " + int_to_str(st.n_redo) + " emitted again in place (" + int_to_str(nthreads) + " threads; taint marks " + int_to_str(t_work - t_pre) + " ms, workers " + int_to_str(t_join - t_work) + " ms, join " + int_to_str(t_end - t_join) + " ms)\n");
    return "";
}

/// SP20: the fold key of a function when the per-function cache (CS6,
/// FID_FNCACHE) is on. ng_mir_key counts the target of a call, an address
/// or a jump by its label number, and label numbers follow the order the
/// labels were made in, which is not the same in a build that replays
/// cached functions and in one that does not. The key a cached function
/// was recorded under then never matched the key of a fresh function with
/// the same code, so the fresh one was not folded onto the replayed copy
/// and a hit's image had one function more than a fresh build's
/// (test_hashmap: pert_str_copy_n, folded onto vec_copy_bytes when fresh).
/// Here a target with an identity (nc_label_ids: a function, a string, a
/// global, a singleton) counts by that identity, which is the same in
/// every run; labels inside the function stay as ng_mir_key numbers them
/// (by order). Within one run the two keys fold the same functions.
fn ng_fold_key_ids(g: &NatGen, rec: &NatFnRec, al: &NatAlloc) -> str {
    var mir2: Vec<MInst> = Vec::new();
    var k: i64 = 0;
    while k < rec.mir.len() {
        var m: MInst = rec.mir.get(k);
        var i0: i64 = m.i0;
        if m.op == MO_CALL || m.op == MO_ADDR || mi_is_br(m.op) {
            var lk: str = int_to_str(i0);
            if HashMap_contains(g.label_id, lk) {
                var id: str = HashMap_get(g.label_id, lk);
                i0 = hash_source("label " + id);
            }
        }
        mir2.push(ng_mi(m.op, m.r0, m.r1, m.r2, i0, m.i1, m.i2));
        k = k + 1;
    }
    var r2: NatFnRec = NatFnRec {
        name: rec.name, mir: mir2, nvreg: rec.nvreg, base_frame: rec.base_frame, slots: Vec::new(), is_ct: rec.is_ct, sret_v: rec.sret_v, sret_size: rec.sret_size, secret: rec.secret
    };
    return ng_mir_key(&r2, al);
}

/// Allocate and emit every recorded function, callees first.
/// SP2: milliseconds ng_mir_finish spent in register allocation.
var g_nat_alloc_ms: i64 = 0;
fn ng_mir_finish(g: &mut NatGen) -> str {
    g_nat_alloc_ms = 0;
    // MI28: the tail-call summaries of an earlier build are not this one's
    ng_ft_reset();
    // label -> function name, and each function's callees
    var by_name: i64 = HashMap_new();
    var ri: i64 = 0;
    while ri < g.recs.len() {
        var r: NatFnRec = g.recs.get(ri);
        HashMap_insert(by_name, r.name, ri);
        HashMap_insert(g.label_fn, int_to_str(HashMap_get(g.fn_labels, r.name)), r.name);
        ri = ri + 1;
    }
    // ME27 / LF24: struct results of two words in two registers
    ng_rr_plan(g);
    if g_nc_retry.len() > 0 {
        // SP6: a replayed function no longer fits (nat_generate_image)
        return NC_RETRY;
    }
    // Post-order over the call graph (iterative), roots in recording order
    var order: Vec<i64> = Vec::new();
    var state: Vec<i64> = Vec::new();
    ri = 0;
    while ri < g.recs.len() {
        state.push(0);
        ri = ri + 1;
    }
    // WP17: with a profile (--profile-use), the roots most called first, so
    // hot functions and what they call come first (nat_enc.fd
    // nat_hot_first); without one, the recording order
    var hot_names: Vec<str> = Vec::new();
    var roots: Vec<i64> = Vec::new();
    ri = 0;
    while ri < g.recs.len() {
        roots.push(ri);
        hot_names.push(g.recs.get(ri).name);
        ri = ri + 1;
    }
    roots = nat_hot_first(roots, hot_names);
    var rpos: i64 = 0;
    while rpos < roots.len() {
        var root: i64 = roots.get(rpos);
        if state.get(root) == 0 {
            var stack: Vec<i64> = Vec::new();
            var pos: Vec<i64> = Vec::new();
            stack.push(root);
            pos.push(0);
            state.set(root, 1);
            while stack.len() > 0 {
                var top: i64 = stack.get(stack.len() - 1);
                var at: i64 = pos.get(pos.len() - 1);
                var rec: NatFnRec = g.recs.get(top);
                var next: i64 = 0 - 1;
                while at < rec.mir.len() && next < 0 {
                    var m: MInst = rec.mir.get(at);
                    at = at + 1;
                    if m.op == MO_CALL {
                        var key: str = int_to_str(m.i0);
                        if HashMap_contains(g.label_fn, key) {
                            var callee: i64 = HashMap_get(by_name, HashMap_get(g.label_fn, key));
                            if state.get(callee) == 0 {
                                next = callee;
                            }
                        }
                    }
                }
                pos.set(pos.len() - 1, at);
                if next >= 0 {
                    state.set(next, 1);
                    stack.push(next);
                    pos.push(0);
                } else {
                    state.set(top, 2);
                    order.push(top);
                    stack.pop();
                    pos.pop();
                }
            }
        }
        rpos = rpos + 1;
    }
    // WP17: functions that are only panic paths — trap dispatchers with no
    // real body — go to the end of the image, after the hot code.
    var cold: Vec<i64> = Vec::new();
    var warm: Vec<i64> = Vec::new();
    var wi: i64 = 0;
    while wi < order.len() {
        var wrec: NatFnRec = g.recs.get(order.get(wi));
        var wk: i64 = 0;
        var traps: i64 = 0;
        var calls: i64 = 0;
        while wk < wrec.mir.len() {
            var wop: i64 = wrec.mir.get(wk).op;
            if wop == MO_TRAP {
                traps = traps + 1;
            }
            if wop == MO_CALL {
                calls = calls + 1;
            }
            wk = wk + 1;
        }
        if traps > 0 && calls == 0 && wrec.mir.len() < 24 {
            cold.push(order.get(wi));
        } else {
            warm.push(order.get(wi));
        }
        wi = wi + 1;
    }
    order = Vec::new();
    wi = 0;
    while wi < warm.len() {
        order.push(warm.get(wi));
        wi = wi + 1;
    }
    wi = 0;
    while wi < cold.len() {
        order.push(cold.get(wi));
        wi = wi + 1;
    }
    var folded: i64 = HashMap_new();
    var fold_on: bool = ng_on("fold");
    if g.nc_on {
        nc_label_ids(g);
    }
    // OP15: the functions whose calls mark a block cold (`@cold`,
    // cold_path(), panic, the functions found above to be only panic paths);
    // each function that calls one is laid out again below, before its MIR
    // passes, so those blocks go after its hot code (`FID_NAT_OFF=coldhint`)
    var cold_calls: i64 = 0;
    if ng_on("coldhint") {
        cold_calls = ng_cold_call_labels(g, &cold);
    }
    // SP5: FID_NAT_PAR: each function is emitted by a worker into a buffer
    // of its own and the buffers are joined in order after this loop
    // (ng_par_finish); the loop only allocates and decides the folds
    var par_on: bool = ng_par_on(g);
    var pst: NatParState = ng_par_state_new();
    // SP7: the last build's places of the functions, kept in this process
    // (nl_begin: that much code reserved, each function back in its slot
    // when it fits)
    nl_begin(g, &order, par_on);
    var oi: i64 = 0;
    while oi < order.len() {
        var rec2: NatFnRec = g.recs.get(order.get(oi));
        g.cur_name = rec2.name;
        // DB1: this function's line rows go against its own file
        g_nat_line_file_ix = nat_line_fn_file(rec2.name);
        // OP15: blocks calling a cold function after the hot code (not in
        // @constant_time code, nor a function cache hit, whose recorded
        // MIR is only a summary)
        // and, with a profile that counts blocks (`fid run --profile`,
        // `--profile-use`), the blocks the run never or rarely entered
        // (ng_pgo_cold_labels; `FID_NAT_OFF=pgolayout`: not those)
        if !rec2.is_ct && nc_hit_at(g, rec2.name) == 0 {
            var pcold: i64 = 0;
            if ng_on("pgolayout") {
                pcold = ng_pgo_cold_labels(rec2.name, &rec2.mir);
            }
            if pcold != 0 || (cold_calls != 0 && ng_mir_calls_cold(&rec2.mir, cold_calls)) {
                var relaid: Vec<MInst> = ng_cold_last(&rec2.mir, cold_calls, pcold);
                rec2.mir = relaid;
            }
        }
        // DB7: the MIR after each pass (g_nat_dump / FID_NAT_DUMP)
        ng_dump_mir(rec2.name, "the cold-path layout", &rec2.mir);
        if ng_on("peep") {
            // TG18: x86-64's 60 and RISC-V's x0 always read 0; AArch64's
            // 31 is also sp, so it is not taken for a known zero
            var pzr: i64 = g.zr;
            if ng_a64(g) {
                pzr = 0 - 1;
            }
            g.n_peep = g.n_peep + ng_peep(&mut rec2.mir, pzr);
            ng_dump_mir(rec2.name, "the peephole", &rec2.mir);
        }
        // TG9: wrapping i32 add / sub / mul and their sext.w as one ADDW /
        // SUBW / MULW (RISC-V)
        var n_opw: i64 = ng_fuse_opw(g, &mut rec2.mir, rec2.nvreg, rec2.sret_v);
        if n_opw > 0 {
            g.n_peep = g.n_peep + n_opw;
            ng_dump_mir(rec2.name, "32-bit operations", &rec2.mir);
        }
        // MI26: extensions of values already extended that far become moves
        var n_ext: i64 = ng_fold_ext_state(&mut rec2.mir, rec2.nvreg);
        if n_ext > 0 {
            g.n_peep = g.n_peep + n_ext;
            ng_dump_mir(rec2.name, "extension state", &rec2.mir);
        }
        // MI24: small branch diamonds as selects (not in @constant_time
        // code, whose check judges the branches the source wrote)
        if !rec2.is_ct {
            var nsel: i64 = ng_fuse_select(g, &mut rec2);
            if nsel > 0 {
                g.n_peep = g.n_peep + nsel;
                ng_dump_mir(rec2.name, "select formation", &rec2.mir);
            }
        }
        if ng_on("brfuse") {
            // RA19: values nothing reads first (a dead read of a compare
            // keeps it out of the flags)
            g.n_peep = g.n_peep + ng_dead_mir(&mut rec2.mir, rec2.nvreg, rec2.sret_v);
            g.n_peep = g.n_peep + ng_fuse_branches(&mut rec2.mir, rec2.nvreg, g.zr);
            ng_dump_mir(rec2.name, "branch fusion", &rec2.mir);
        }
        // TG8/TG7: branches on one bit as one test-bit branch (not in
        // @constant_time code, which keeps the branches it was judged by)
        if !rec2.is_ct {
            var ntb: i64 = ng_fuse_tbz(&mut rec2.mir, rec2.nvreg, rec2.sret_v, g.zr);
            if ntb > 0 {
                g.n_peep = g.n_peep + ntb;
                ng_dump_mir(rec2.name, "test-bit branches", &rec2.mir);
            }
        }
        // MI3/OP20: ANDN / BLSR where the target has them (ng_sel_has)
        var nfb: i64 = ng_fuse_bits(g, &mut rec2.mir, rec2.nvreg, rec2.sret_v);
        if nfb > 0 {
            g.n_peep = g.n_peep + nfb;
            ng_dump_mir(rec2.name, "bit-operation selection", &rec2.mir);
        }
        // MI22: element addresses folded into their loads and stores
        var nfa: i64 = ng_fuse_addr(g, &mut rec2.mir, rec2.nvreg, rec2.sret_v);
        if nfa > 0 {
            g.n_peep = g.n_peep + nfa;
            ng_dump_mir(rec2.name, "address-mode selection", &rec2.mir);
        }
        // OP18: an extension of a load read once as a narrower load (every
        // target; before the memory compares, which then take it)
        if !rec2.is_ct {
            var nle: i64 = ng_fuse_ldext(g, &mut rec2.mir, rec2.nvreg, rec2.sret_v);
            if nle > 0 {
                g.n_peep = g.n_peep + nle;
                ng_dump_mir(rec2.name, "extending loads", &rec2.mir);
            }
        }
        // OP18: read-modify-write destinations (before ng_fuse_ldop takes
        // their loads) and compares against memory; not in @constant_time
        // code (its check judges the operations the source wrote)
        if !rec2.is_ct {
            var nrmw: i64 = ng_fuse_rmw(g, &mut rec2.mir, rec2.nvreg, rec2.sret_v);
            var nmc: i64 = ng_fuse_memcmp(g, &mut rec2.mir, rec2.nvreg, rec2.sret_v);
            if nrmw + nmc > 0 {
                g.n_peep = g.n_peep + nrmw + nmc;
                ng_dump_mir(rec2.name, "memory compares and read-modify-writes", &rec2.mir);
            }
        }
        // OP18: loads read once by an ALU operation as its memory operand
        var nlo: i64 = ng_fuse_ldop(g, &mut rec2.mir, rec2.nvreg, rec2.sret_v);
        if nlo > 0 {
            g.n_peep = g.n_peep + nlo;
            ng_dump_mir(rec2.name, "memory-operand selection", &rec2.mir);
        }
        // RA6: adds of a constant as one add-immediate
        var nai: i64 = ng_fuse_addi(g, &mut rec2.mir, rec2.nvreg, rec2.sret_v);
        if nai > 0 {
            g.n_peep = g.n_peep + nai;
            ng_dump_mir(rec2.name, "add-immediate selection", &rec2.mir);
        }
        // TG8: a pointer's step next to the access through it (AArch64),
        // for the writeback forms at emission (ng_a64_wb_fuse); not in
        // @constant_time code (its check judges the MIR as the source wrote it)
        if !rec2.is_ct {
            var nwb: i64 = ng_wb_pair(g, &mut rec2.mir, rec2.nvreg, rec2.sret_v);
            if nwb > 0 {
                g.n_peep = g.n_peep + nwb;
                ng_dump_mir(rec2.name, "pointer steps by their accesses", &rec2.mir);
            }
        }
        if rec2.is_ct {
            var cterr: str = ng_ct_check(g, &rec2);
            if cterr != "" {
                return "native backend: @constant_time violated: " + cterr;
            }
        }
        // (FID_NAT_OFF=unchecked keeps the increments of counted loops
        // checked, which a @crashfree loop may hold: no verdict then)
        if HashMap_contains(g.cf_fns, rec2.name) && ng_on("unchecked") {
            var cferr: str = ng_crashfree_check(&rec2);
            if cferr != "" {
                return "native backend: @crashfree violated: " + cferr;
            }
        }
        var hix: i64 = nc_hit_at(g, rec2.name);
        if hix != 0 {
            // CS6: a cache hit — the recorded bytes replay at this offset and
            // their symbolic fixups re-register against this image's labels.
            var ent: NcEntry = g.nc_old.get(hix - 1);
            if !nc_masks_hold(g, &ent) || !nc_ft_hold(g, &ent) {
                // SP6: a callee compiled again clobbers other registers than
                // the recorded code expects: this image is made again
                // without it and what relied on it (the loop goes on, to
                // find all of them in one attempt; ng_mir_finish's end)
                nc_give_up_callers(g, rec2.name);
            }
            var label2: i64 = HashMap_get(g.fn_labels, rec2.name);
            // SP7: back at its offset of the last build when it still fits
            // there (nl_slot), else after the code laid out so far
            var nl_at: i64 = nl_slot(rec2.name, ent.bytes.len());
            var nl_lr: i64 = g.lrows.len();
            var nl_cf: i64 = g.cfi_rows.len();
            if nl_at >= 0 {
                g.e.labels.set(label2, nl_at);
                g.e.last_place = nl_at;
            } else {
                NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
                NatEnc_place(&mut g.e, label2);
            }
            g.placed_fns.push(rec2.name);
            var fbase: i64 = g.e.code.len();
            if nl_at >= 0 {
                fbase = nl_at;
            }
            var rerr: str = nc_replay(g, &ent, nl_at);
            if rerr != "" {
                return rerr;
            }
            HashMap_insert(g.fn_mask, rec2.name, ent.mask);
            if fold_on && str_len(ent.fold_key) > 0 {
                HashMap_insert(folded, ent.fold_key, fbase);
            }
            if (g.fact_path as i64) != 0 && str_len(g.fact_path) > 0 {
                p_file_append(g.fact_path, "ext " + rec2.name + " mask=" + int_to_str(ent.mask) + " size=" + int_to_str(ent.bytes.len()) + "\n");
            }
            if nl_at >= 0 {
                // SP7: its line sequence ends where its bytes do
                nl_line_close_at(g, nl_at + ent.bytes.len());
                g.e.mul_end = 0 - 1;
                nl_placed(rec2.name, 1, ent.bytes.len());
            } else {
                ng_line_close(g);
                nl_placed(rec2.name, 0, ent.bytes.len());
            }
            nl_block(fbase, nl_lr, g.lrows.len(), nl_cf, g.cfi_rows.len());
        } else {
            if ng_verify_on() {
                // MI10: the machine IR's structure, before allocation
                var verr: str = ng_mir_verify(g, &rec2);
                if verr != "" {
                    return "native backend: MIR verifier: " + verr;
                }
            }
            // MI1: FID_NAT_ON=bparams: into block-parameter form and out
            // again before allocation (verified under FID_VERIFY=1)
            var bperr: str = ng_bparams_round(g, &mut rec2);
            if bperr != "" {
                return "native backend: " + bperr;
            }
            var t_al: i64 = p_clock_now_ms();
            // (RA4: with live-range splitting, which may replace rec2's
            // machine IR and vreg count)
            var al: NatAlloc = ng_mir_alloc_split(g, &mut rec2);
            g_nat_alloc_ms = g_nat_alloc_ms + p_clock_now_ms() - t_al;
            if al.err != "" {
                return "native backend: register allocation check failed: " + al.err;
            }
            if g_nat_stats {
                ng_mir_stats(&rec2, &al);
            }
            HashMap_insert(g.fn_mask, rec2.name, al.mask);
            var label: i64 = HashMap_get(g.fn_labels, rec2.name);
            var key: str = "";
            if fold_on {
                if g.nc_on {
                    // SP20: the same key in a build that replays cached
                    // functions as in the one that recorded them
                    key = ng_fold_key_ids(g, &rec2, &al);
                } else {
                    key = ng_mir_key(&rec2, &al);
                }
            }
            if par_on {
                // SP5: emitted and placed by ng_par_finish
                ng_par_add(&mut pst, rec2, al, key, fold_on);
            } else if fold_on && HashMap_contains(folded, key) {
                // The same bytes are already in the image: this name points there
                g.e.labels.set(label, HashMap_get(folded, key));
                g.n_folded = g.n_folded + 1;
            } else {
                // SP7: where the code ended before its alignment (nl_move)
                var nl_pre: i64 = g.e.code.len();
                NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
                NatEnc_place(&mut g.e, label);
                if fold_on {
                    HashMap_insert(folded, key, g.e.code.len());
                }
                g.placed_fns.push(rec2.name);
                var pre_sz: i64 = g.e.code.len();
                var pre_fx: i64 = g.e.fixups.len();
                var pre_lr: i64 = g.lrows.len();
                var pre_cf: i64 = g.cfi_rows.len();
                var nl_lab0: i64 = g.e.labels.len();
                ng_mir_emit(g, &rec2, &al);
                // DB4: its variables' locations, now that its frame is known
                ng_dbg_vars_resolve(g, &rec2, &al);
                if g.nc_on {
                    var cap_ok: bool = nc_capture(g, &rec2, pre_sz, pre_fx, key, pre_lr, pre_cf);
                }
                // WP20: the backend's half of the facts artifact — the callee's
                // clobber mask and emitted size, which iropt cannot see.
                if (g.fact_path as i64) != 0 && str_len(g.fact_path) > 0 {
                    p_file_append(g.fact_path, "ext " + rec2.name + " mask=" + int_to_str(al.mask) + " size=" + int_to_str(g.e.code.len() - pre_sz) + "\n");
                }
                ng_line_close(g);
                // SP7: into its slot of the last build when it fits there
                // (emitted after the reserved code, then moved: nl_move)
                var nl_size: i64 = g.e.code.len() - pre_sz;
                var nl_to: i64 = nl_slot(rec2.name, nl_size);
                if nl_to >= 0 && !nl_align_kept(g, &rec2, pre_sz, nl_to) {
                    nl_to = 0 - 1;
                }
                var nl_start: i64 = pre_sz;
                if nl_to >= 0 {
                    nl_move(g, nl_lab0, nl_pre, pre_sz, nl_to, pre_fx, pre_lr, pre_cf);
                    if fold_on {
                        HashMap_insert(folded, key, nl_to);
                    }
                    nl_start = nl_to;
                    nl_placed(rec2.name, 2, nl_size);
                } else {
                    nl_placed(rec2.name, 0, nl_size);
                }
                nl_block(nl_start, pre_lr, g.lrows.len(), pre_cf, g.cfi_rows.len());
            }
        }
        oi = oi + 1;
    }
    // SP7: rows and names in address order again; this layout kept for
    // the next build once its fixups resolve (nl_commit)
    nl_loop_end(g, par_on);
    if g_nc_retry.len() > 0 {
        // SP6: hits that did not fit after all (nc_masks_hold, nc_replay)
        return NC_RETRY;
    }
    if par_on {
        return ng_par_finish(g, &mut pst);
    }
    return "";
}

// ===========================================================================
// x86-64 Linux (own-backend roadmap MI15): the target's description and its
// primitives. The internal convention: arguments in rdi, rsi, rdx, rcx, the
// rest on the stack; the result in rdi (argument register 0, as on the other
// targets). Reserved: r10 (ad), r11 (ad2), r8 / r9 / rax (the spill
// registers; rax also for division and the high half of products), rcx (the
// shift count), rdx (division, the copy cursor). Values live in rbx and
// r12-r15. The runtime's system call numbers are Linux's generic ones: the
// nat_syscall primitive maps them to x86-64's.
// ===========================================================================

fn ng_x64(g: &NatGen) -> bool {
    return g.arch == NAT_X64;
}

/// How many arguments travel in registers.
fn ng_nregargs(g: &NatGen) -> i64 {
    return g.td.nregargs;
}

/// WP6: functions only ever called from inside the program may use the
/// extended convention — argument registers the platform ABI spends on
/// nothing else. x64 gains r9 (r8/r10/r11 are the generator's temporaries),
/// AArch64 gains x13–x15, RISC-V gains t6.
fn ng_nregargs_i(g: &NatGen, internal: bool) -> i64 {
    if !internal {
        return ng_nregargs(g);
    }
    return g.td.nregargs_int;
}

fn ng_argreg_i(g: &NatGen, i: i64, internal: bool) -> i64 {
    if !internal || i < ng_nregargs(g) {
        return ng_argreg(g, i);
    }
    // MI4: the extended convention's registers follow the platform's in
    // the target description
    if i < g.td.argregs.len() {
        return g.td.argregs.get(i);
    }
    return g.td.argregs.get(g.td.argregs.len() - 1);
}

fn ng_internal(g: &NatGen, name: str) -> bool {
    return HashMap_contains(g.internal, name);
}

/// ng_load_args under convention `internal`: the first registers are the
/// extended set, the rest go to the outgoing stack slots past them.
fn ng_load_args_i(g: &mut NatGen, srcs: Vec<i64>, internal: bool) {
    var nr: i64 = ng_nregargs_i(g, internal);
    var i: i64 = nr;
    while i < srcs.len() {
        if srcs.get(i) < 0 {
            ng_li(g, g.t0, 0);
        } else {
            ng_ld_val(g, g.t0, srcs.get(i));
        }
        ng_st_outgoing(g, i - nr, g.t0);
        i = i + 1;
    }
    i = 0;
    while i < srcs.len() && i < nr {
        var r: i64 = ng_argreg_i(g, i, internal);
        if srcs.get(i) < 0 {
            ng_li(g, r, 0);
        } else {
            ng_ld_val(g, r, srcs.get(i));
        }
        i = i + 1;
    }
}

/// d = a op b for the binary operations: 1 add, 2 sub, 3 mul, 4 and, 5 or,
/// 6 xor, 7 shl, 8 sar, 9 shr (two-operand forms; a result register that is
/// also the right operand goes through r11)
fn ng_x64_bin(g: &mut NatGen, kind: i64, d: i64, a: i64, b: i64) {
    if kind >= 7 && ng_x64_bmi2(g) {
        // TG7: SHLX / SARX / SHRX: three operands, the count in any register
        var pp: i64 = 1;
        if kind == 8 {
            pp = 2;
        }
        if kind == 9 {
            pp = 3;
        }
        x64_shiftx(&mut g.e, pp, d, a, b);
        return;
    }
    if kind == 1 && d != a && d != b && ng_on("lea") {
        // TG7: d = a + b in one LEA (no MOV first; flags are never read
        // after an add: overflow checks compute their condition apart).
        // rsp cannot be an index: it goes in the base.
        if b != 4 {
            x64_lea_idx(&mut g.e, d, a, b, 0);
            return;
        }
        if a != 4 {
            x64_lea_idx(&mut g.e, d, b, a, 0);
            return;
        }
    }
    if kind >= 7 {
        var ext: i64 = 4;
        if kind == 8 {
            ext = 7;
        }
        if kind == 9 {
            ext = 5;
        }
        if b != 1 {
            x64_mov(&mut g.e, 1, b);
        }
        if d != a {
            x64_mov(&mut g.e, d, a);
        }
        x64_shift_cl(&mut g.e, ext, d);
        return;
    }
    var code: i64 = 0x01;
    if kind == 2 {
        code = 0x29;
    }
    if kind == 4 {
        code = 0x21;
    }
    if kind == 5 {
        code = 0x09;
    }
    if kind == 6 {
        code = 0x31;
    }
    var commutes: bool = kind != 2;
    var src: i64 = b;
    if d == b && d != a {
        if commutes {
            src = a;
        } else {
            x64_mov(&mut g.e, 11, a);
            x64_alu(&mut g.e, code, 11, b);
            x64_mov(&mut g.e, d, 11);
            return;
        }
    } else if d != a {
        x64_mov(&mut g.e, d, a);
    }
    if kind == 3 {
        x64_imul(&mut g.e, d, src);
    } else {
        x64_alu(&mut g.e, code, d, src);
    }
}

/// TG7: an operation whose spilled second operand x86-64 reads straight
/// from its slot: ADD (only when d is a: else LEA d, [a + scratch] is as
/// short), SUB, MUL, AND, OR, XOR. d (p0) and a (p1) are the registers the
/// emission found for them. `FID_NAT_OFF=memop`: every operand loaded.
fn ng_x64_memop(op: i64, d: i64, a: i64) -> bool {
    if op == MO_ADD {
        return d == a && d >= 0;
    }
    return (op == MO_SUB || op == MO_MUL || op == MO_AND || op == MO_OR || op == MO_XOR) && d >= 0 && a >= 0;
}

/// TG7: d = a op [rsp + off] (ng_x64_memop): MOV d, a when they differ,
/// then the operation's memory form. One instruction fewer than loading
/// the operand into a scratch register first.
fn ng_x64_bin_mem(g: &mut NatGen, op: i64, d: i64, a: i64, off: i64) {
    var code: i64 = 0x03;
    if op == MO_SUB {
        code = 0x2B;
    }
    if op == MO_MUL {
        code = 0x0FAF;
    }
    if op == MO_AND {
        code = 0x23;
    }
    if op == MO_OR {
        code = 0x0B;
    }
    if op == MO_XOR {
        code = 0x33;
    }
    if d != a {
        x64_mov(&mut g.e, d, a);
    }
    if ng_mutant("memop") {
        // TG2: the wrong operation, on purpose
        if code == 0x03 {
            code = 0x2B;
        } else {
            code = 0x03;
        }
    }
    x64_alu_mem(&mut g.e, code, d, 4, off);
}

/// TG7: the slot offset when `m` can work on a spilled destination's slot
/// in place (x86-64 `op [rsp + off], r` / `op qword [rsp + off], imm`):
/// ADD, SUB, AND, OR or XOR (MUL has no memory destination) or ADDI whose
/// destination r0 and left operand r1 are spilled vregs, neither
/// rematerialized, in the same slot (one vreg, or two that share it,
/// MI8), the right operand a register or a vreg in another slot (loaded
/// first) and an ADDI's constant 32 bits signed; else -1.
fn ng_rmw_slot(m: MInst, al: &NatAlloc, nv: i64) -> i64 {
    var op: i64 = m.op;
    if op != MO_ADD && op != MO_SUB && op != MO_AND && op != MO_OR && op != MO_XOR && op != MO_ADDI {
        return 0 - 1;
    }
    if m.r0 < NG_VBASE || m.r0 - NG_VBASE >= nv || m.r1 < NG_VBASE || m.r1 - NG_VBASE >= nv {
        return 0 - 1;
    }
    var d: i64 = m.r0 - NG_VBASE;
    var a: i64 = m.r1 - NG_VBASE;
    if al.assign.get(d) != 0 - 1 || al.assign.get(a) != 0 - 1 {
        return 0 - 1;
    }
    if ng_remat_is(al.remat.get(d)) || ng_remat_is(al.remat.get(a)) {
        return 0 - 1;
    }
    var off: i64 = al.spill.get(d);
    if off < 0 || al.spill.get(a) != off {
        return 0 - 1;
    }
    if op == MO_ADDI {
        if m.i0 < 0 - 2147483648 || m.i0 > 2147483647 {
            return 0 - 1;
        }
        return off;
    }
    if m.r2 >= NG_VBASE {
        if m.r2 - NG_VBASE >= nv {
            return 0 - 1;
        }
        var b: i64 = m.r2 - NG_VBASE;
        if al.assign.get(b) == 0 - 1 && al.spill.get(b) == off {
            // (x op x: the operand would be read from the slot written)
            return 0 - 1;
        }
    } else if m.r2 < 0 || m.r2 >= 16 {
        return 0 - 1;
    }
    return off;
}

/// TG7: MO_ADD / SUB / AND / OR / XOR / ADDI on the slot at [rsp + off]
/// (ng_rmw_slot): `op [rsp + off], b` (b the right operand's register) or
/// `op qword [rsp + off], imm` (ADDI; nothing for an add of 0). One
/// instruction where the slot was loaded, operated on and stored back.
fn ng_x64_rmw_slot(g: &mut NatGen, m: MInst, b: i64, off: i64) {
    var op: i64 = m.op;
    if ng_mutant("rmwslot") {
        // TG2: the wrong operation, on purpose
        if op == MO_ADD || op == MO_ADDI {
            op = MO_XOR;
        } else {
            op = MO_ADD;
        }
    }
    if m.op == MO_ADDI {
        if m.i0 == 0 && op == MO_ADDI {
            return;
        }
        var ext: i64 = 0;
        if op == MO_XOR {
            ext = 6;
        }
        x64_alu_mem_imm(&mut g.e, ext, 4, off, m.i0);
        return;
    }
    var code: i64 = 0x01;
    if op == MO_SUB {
        code = 0x29;
    } else if op == MO_AND {
        code = 0x21;
    } else if op == MO_OR {
        code = 0x09;
    } else if op == MO_XOR {
        code = 0x31;
    }
    x64_alu_to_mem(&mut g.e, code, b, 4, off);
}

/// TG7: field f of `m` is an operand of a compare that x86-64 can read from
/// its slot: either side of MO_BRCC (r0, r1) or of MO_SETCC (r1, r2).
fn ng_cmp_slot_field(m: MInst, f: i64) -> bool {
    if m.op == MO_BRCC {
        return f == 0 || f == 1;
    }
    if m.op == MO_SETCC {
        return f == 1 || f == 2;
    }
    return false;
}

/// TG7: MO_BRCC (branch to i0 on kind i1) or MO_SETCC (p0 = 0 / 1, kind
/// i0) with one spilled operand compared in its slot at [rsp + off]: swap
/// says it was the left one. The other side's register r: `cmp r, [rsp +
/// off]` (the kind swapped when the slot was on the left); when r is the
/// zero register (60), `cmp qword [rsp + off], 0` (swapped the other way).
/// Then jcc (rel8 when relaxation said short) or setcc r11 + movzx, as
/// ng_brcc / ng_setcc. One load fewer than loading the slot first.
fn ng_x64_cmp_slot(g: &mut NatGen, m: MInst, p0: i64, p1: i64, p2: i64, off: i64, swap: bool) {
    var cc: i64 = m.i1;
    var r: i64 = p0;
    if m.op == MO_BRCC {
        if swap {
            r = p1;
        }
    } else {
        cc = m.i0;
        r = p1;
        if swap {
            r = p2;
        }
    }
    if r == 60 {
        // flags of [slot] - 0: the slot is the compare's left side
        x64_cmp_mem_imm(&mut g.e, 8, 4, off, 0);
        if !swap {
            cc = ng_cc_swap(cc);
        }
    } else {
        // flags of r - [slot]: r is the left side
        x64_alu_mem(&mut g.e, 0x3B, r, 4, off);
        if swap {
            cc = ng_cc_swap(cc);
        }
    }
    if ng_mutant("cmpslot") {
        // TG2: the compare the wrong way, on purpose
        cc = ng_cc_inverse(cc);
    }
    if m.op == MO_BRCC {
        if g.br_short {
            x64_jcc_short(&mut g.e, ng_x64_cc(cc), m.i0);
        } else {
            x64_jcc(&mut g.e, ng_x64_cc(cc), m.i0);
        }
        return;
    }
    x64_setcc(&mut g.e, ng_x64_cc(cc), 11);
    x64_movx(&mut g.e, 0xB6, p0, 11);
}

/// TG8: the 4-byte word of the code at `at`.
fn ng_code_word(g: &NatGen, at: i64) -> i64 {
    return g.e.code.get(at) | (g.e.code.get(at + 1) << 8) | (g.e.code.get(at + 2) << 16) | (g.e.code.get(at + 3) << 24);
}

/// TG8: the last two AArch64 instructions emitted are an access and the
/// add of its base, straight code: no label placed between them or after
/// (a jump could arrive there), no line row from the second's start on,
/// no fixup in either.
fn ng_a64_pair_free(g: &NatGen) -> bool {
    var pos: i64 = NatEnc_pos(&g.e);
    if pos < 8 || g.e.last_place > pos - 8 {
        return false;
    }
    var nr: i64 = g.lrows.len();
    if nr >= 3 && g.lrows.get(nr - 3) >= pos - 4 {
        return false;
    }
    var nf: i64 = g.e.fixups.len();
    if nf > 0 && g.e.fixups.get(nf - 1).pos >= pos - 8 {
        return false;
    }
    return true;
}

/// TG8: the step of an AArch64 `add n, n, #c` / `sub n, n, #c` word (64
/// bits, no shift) as [n, c], or [-1, 0].
fn ng_a64_step_of(w: i64) -> Vec<i64> {
    var res: Vec<i64> = Vec::new();
    var top: i64 = w & 0xFFC00000;
    var d: i64 = w & 31;
    var n: i64 = (w >> 5) & 31;
    var imm: i64 = (w >> 10) & 0xFFF;
    if (top == 0x91000000 || top == 0xD1000000) && d == n && n != 31 {
        res.push(n);
        if top == 0xD1000000 {
            res.push(0 - imm);
        } else {
            res.push(imm);
        }
        return res;
    }
    res.push(0 - 1);
    res.push(0);
    return res;
}

/// TG8: an AArch64 general-register load or store with an unsigned scaled
/// offset (what ng_load / ng_store emit: a64_ldr_sized / a64_str_sized),
/// LDRS sign-extending into x included, as [t, n, byte offset], or [-1].
fn ng_a64_access_of(w: i64) -> Vec<i64> {
    var res: Vec<i64> = Vec::new();
    // bits 29:24 111001 (V, bit 26, clear: not a float register), opc
    // 00 store, 01 load, 10 load sign-extending to 64 bits
    // (size 11 with opc 10 is PRFM, not a load)
    var opc: i64 = (w >> 22) & 3;
    if (w & 0x3F000000) != 0x39000000 || opc == 3 || (((w >> 30) & 3) == 3 && opc == 2) {
        res.push(0 - 1);
        return res;
    }
    var size: i64 = 1 << ((w >> 30) & 3);
    res.push(w & 31);
    res.push((w >> 5) & 31);
    res.push(((w >> 10) & 0xFFF) * size);
    return res;
}

/// TG8 (AArch64, after emission): the last two instructions emitted, an
/// access through n and the add of a constant c to n, as one access with
/// writeback, when they are straight code (ng_a64_pair_free), the access
/// has a general register t other than n and n is not sp, and c fits
/// 9 bits signed:
///   ldr/str t, [n, #o]; add n, n, #c   o 0: `[n], #c` (post-indexed),
///                                      o c: `[n, #c]!` (pre-indexed)
///   add n, n, #c; ldr/str t, [n]       `[n, #c]!` (pre-indexed)
/// Both forms leave every register and memory as the two did. The MIR
/// pass ng_wb_pair puts a pointer's step next to its access in the
/// machine IR, and the allocator gives the stepped pointer and its old
/// value one register when nothing reads the old value after the step.
/// `FID_NAT_OFF=wbidx`: never; FID_NAT_MUTATE=wbidx: post where pre is
/// right and pre where post is.
fn ng_a64_wb_fuse(g: &mut NatGen) -> bool {
    if !ng_a64(g) || !ng_a64_pair_free(g) {
        return false;
    }
    var pos: i64 = NatEnc_pos(&g.e);
    var w1: i64 = ng_code_word(g, pos - 8);
    var w2: i64 = ng_code_word(g, pos - 4);
    var acc: Vec<i64> = ng_a64_access_of(w1);
    var step: Vec<i64> = ng_a64_step_of(w2);
    var aw: i64 = w1;
    var pre: bool = false;
    var c: i64 = 0;
    if acc.get(0) >= 0 && step.get(0) >= 0 && acc.get(1) == step.get(0) {
        // access, then the step
        c = step.get(1);
        if acc.get(2) == 0 {
            pre = false;
        } else if acc.get(2) == c {
            pre = true;
        } else {
            return false;
        }
    } else {
        acc = ng_a64_access_of(w2);
        step = ng_a64_step_of(w1);
        if acc.get(0) < 0 || step.get(0) < 0 || acc.get(1) != step.get(0) || acc.get(2) != 0 {
            return false;
        }
        // the step, then the access through the stepped base
        aw = w2;
        c = step.get(1);
        pre = true;
    }
    var t: i64 = acc.get(0);
    var n: i64 = acc.get(1);
    if t == n || n == 31 || !a64_wb_fits(c) || c == 0 {
        return false;
    }
    if ng_mutant("wbidx") {
        // TG2: the wrong address, on purpose
        pre = !pre;
    }
    g.e.code.truncate(pos - 8);
    NatEnc_word(&mut g.e, a64_wb_word(aw, t, n, c, pre));
    return true;
}

/// OP18: the x86-64 opcode of MO_ALUM operation kind (0 add, 1 sub, 2 mul,
/// 3 and, 4 or, 5 xor) in its memory-source form (x64_alu_mem).
fn ng_x64_alum_code(kind: i64) -> i64 {
    if kind == 1 {
        return 0x2B;
    }
    if kind == 2 {
        return 0x0FAF;
    }
    if kind == 3 {
        return 0x23;
    }
    if kind == 4 {
        return 0x0B;
    }
    if kind == 5 {
        return 0x33;
    }
    return 0x03;
}

/// OP18: d = a op *(base + off) (MO_ALUM, x86-64): MOV d, a when they
/// differ, then the operation's memory form. When d is base (and not a)
/// the MOV would overwrite the address first, so the result is formed in
/// ad2 (r11, never allocated) and moved to d.
fn ng_x64_alum(g: &mut NatGen, d: i64, a: i64, base: i64, off: i64, kind: i64) {
    if g.rec {
        ng_rec(g, MO_ALUM, d, a, base, off, kind, 0);
        return;
    }
    var code: i64 = ng_x64_alum_code(kind);
    if ng_mutant("ldop") {
        // TG2: the wrong operation, on purpose
        if code == 0x03 {
            code = 0x2B;
        } else {
            code = 0x03;
        }
    }
    if d == base && d != a {
        x64_mov(&mut g.e, g.ad2, a);
        x64_alu_mem(&mut g.e, code, g.ad2, base, off);
        x64_mov(&mut g.e, d, g.ad2);
        return;
    }
    if d != a {
        x64_mov(&mut g.e, d, a);
    }
    x64_alu_mem(&mut g.e, code, d, base, off);
}

/// OP18: the MO_ALUM kind of a two-operand ALU operation (-1: none), and
/// whether it commutes (a load on its left may then be read from memory).
fn ng_ldop_kind(op: i64) -> i64 {
    if op == MO_ADD {
        return 0;
    }
    if op == MO_SUB {
        return 1;
    }
    if op == MO_MUL {
        return 2;
    }
    if op == MO_AND {
        return 3;
    }
    if op == MO_OR {
        return 4;
    }
    if op == MO_XOR {
        return 5;
    }
    return 0 - 1;
}

/// OP18: memory operands. An 8-byte LOAD t = *(base + off) whose only
/// reader is a later ADD, SUB, MUL, AND, OR or XOR of the same straight
/// stretch (through vreg MOVs, ng_fb_chain: only MOVs, LIs and line rows
/// in between, so no store or call) becomes that operation's memory
/// source: `d = a op [base + off]` (MO_ALUM), one instruction instead of
/// a load and the operation. t may be the right operand of any of them or
/// the left one of those that commute. Not when: t and the other operand
/// are the same vreg; base or the other operand is written by the chain;
/// base is written between the load and the operation; anything else
/// reads t or the chain's copies (ng_fb_deletable); the chain defines
/// `keep` (the hidden result pointer). x86-64 only (ng_sel_has MO_ALUM).
/// Returns the number formed. `FID_NAT_OFF=ldop`: never.
fn ng_fuse_ldop(g: &NatGen, mir: &mut Vec<MInst>, nvreg: i64, keep: i64) -> i64 {
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if !ng_sel_has(g, MO_ALUM) || !ng_on("ldop") || nv <= 0 || n == 0 {
        return 0;
    }
    var uses: Vec<i64> = ng_fb_uses(mir, nv);
    var fused: i64 = 0;
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        var kind: i64 = ng_ldop_kind(m.op);
        if kind >= 0 && m.r1 != m.r2 && m.r1 >= NG_VBASE && m.r1 < nvreg && m.r2 >= NG_VBASE && m.r2 < nvreg && m.r0 >= NG_VBASE && m.r0 < nvreg {
            var side: i64 = 2;
            var done: bool = false;
            while side >= 1 && !done {
                // the right operand first; the left one where op commutes
                var t: i64 = m.r2;
                var a: i64 = m.r1;
                if side == 1 {
                    t = m.r1;
                    a = m.r2;
                }
                if side == 2 || kind != 1 {
                    var dpos: Vec<i64> = Vec::new();
                    var p: i64 = ng_fb_chain(mir, k, t, &mut dpos);
                    if p >= 0 {
                        var ld: MInst = mir.get(p);
                        var base: i64 = ld.r1;
                        var ok: bool = ld.op == MO_LOAD && ld.i1 == 8 && base >= NG_VBASE && base < nvreg && ld.r0 != keep;
                        if ok {
                            dpos.push(p);
                            // (the operation's two-address form: its result
                            // register is often the moved load itself)
                            ok = ng_fb_deletable_def(mir, &uses, &dpos, k, nv, m.r0);
                        }
                        ok = ok && !ng_fb_defines_any(mir, &dpos, a) && !ng_fb_defines_any(mir, &dpos, base) && !ng_fb_defines_any(mir, &dpos, keep);
                        ok = ok && !ng_fb_redef(mir, &dpos, p, k, base);
                        if ok {
                            var q: i64 = 0;
                            while q < dpos.len() {
                                mir.set(dpos.get(q), mi_nop());
                                q = q + 1;
                            }
                            mir.set(k, MInst {
                                op: MO_ALUM, r0: m.r0, r1: a, r2: base, i0: ld.i0, i1: kind, i2: 0
                            });
                            uses = ng_fb_uses(mir, nv);
                            fused = fused + 1;
                            done = true;
                        }
                    }
                }
                side = side - 1;
            }
        }
        k = k + 1;
    }
    if fused == 0 {
        return 0;
    }
    var out: Vec<MInst> = Vec::new();
    var t2: i64 = 0;
    while t2 < mir.len() {
        if mir.get(t2).op >= 0 {
            out.push(mir.get(t2));
        }
        t2 = t2 + 1;
    }
    mir.clear();
    t2 = 0;
    while t2 < out.len() {
        mir.push(out.get(t2));
        t2 = t2 + 1;
    }
    return fused;
}

/// OP18: the bytes an extension kind keeps (NEXT_*: 1, 2, 4; 0: none).
fn ng_ldext_width(kind: i64) -> i64 {
    if kind == NEXT_SB || kind == NEXT_ZB {
        return 1;
    }
    if kind == NEXT_SH || kind == NEXT_ZH {
        return 2;
    }
    if kind == NEXT_SW || kind == NEXT_ZW {
        return 4;
    }
    return 0;
}

/// OP18: extending loads (every target). An EXT d, t, k whose operand t
/// comes, through vreg moves of the same straight stretch (ng_fb_chain:
/// only moves, constants and line rows in between, so no store or call),
/// from a LOAD or LDX of at least k's width that nothing else reads
/// (ng_fb_deletable) becomes the load of k's width with k's extension,
/// into d, where the EXT was: the targets are little-endian, so the low
/// bytes of the loaded value are the first ones in memory. `p.x as u8` of
/// an i64 field is one movzx / ldrb / lbu, an i32 field read `as i16` one
/// movsx / ldrsh / lh; a narrow load extended the other way (a u8 field
/// `as i8`) is the load with the other extension. Not when the chain writes
/// the base (or the index), they are written between the load and the
/// extension, or the load defines `keep` (the hidden result pointer). On
/// AArch64 an indexed load whose shift would no longer match the narrower
/// size (its one-instruction form takes shift 0 or log2(size)) stays.
/// Returns the number folded. `FID_NAT_OFF=ldext`: never;
/// FID_NAT_MUTATE=ldext extends the wrong way, to show the fold is taken.
fn ng_fuse_ldext(g: &NatGen, mir: &mut Vec<MInst>, nvreg: i64, keep: i64) -> i64 {
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if !ng_on("ldext") || nv <= 0 || n == 0 {
        return 0;
    }
    var mutant: bool = ng_mutant("ldext");
    var uses: Vec<i64> = ng_fb_uses(mir, nv);
    var fused: i64 = 0;
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        var w: i64 = 0;
        if m.op == MO_EXT {
            w = ng_ldext_width(m.i0);
        }
        if w > 0 && m.r0 >= NG_VBASE && m.r0 < nvreg && m.r1 >= NG_VBASE && m.r1 < nvreg {
            var sg: i64 = 0;
            if m.i0 == NEXT_SB || m.i0 == NEXT_SH || m.i0 == NEXT_SW {
                sg = 1;
            }
            if mutant {
                sg = 1 - sg;
            }
            var dpos: Vec<i64> = Vec::new();
            var p: i64 = ng_fb_chain(mir, k, m.r1, &mut dpos);
            if p >= 0 {
                var ld: MInst = mir.get(p);
                var ok: bool = (ld.op == MO_LOAD || ld.op == MO_LDX) && ld.i1 >= w && ld.r0 != keep && ld.r1 >= NG_VBASE && ld.r1 < nvreg;
                if ok && ld.op == MO_LDX {
                    var sh: i64 = ld.i2 >> 1;
                    ok = ld.r2 >= NG_VBASE && ld.r2 < nvreg && sh >= 0 && sh <= 3;
                    if ok && ng_a64(g) && sh != 0 && (1 << sh) != w {
                        ok = false;
                    }
                }
                if ok {
                    dpos.push(p);
                    // (an EXT in its two-address form: d is the moved load)
                    ok = ng_fb_deletable_def(mir, &uses, &dpos, k, nv, m.r0);
                }
                ok = ok && !ng_fb_defines_any(mir, &dpos, ld.r1) && !ng_fb_redef(mir, &dpos, p, k, ld.r1) && !ng_fb_defines_any(mir, &dpos, keep);
                if ok && ld.op == MO_LDX {
                    ok = !ng_fb_defines_any(mir, &dpos, ld.r2) && !ng_fb_redef(mir, &dpos, p, k, ld.r2);
                }
                if ok {
                    var q: i64 = 0;
                    while q < dpos.len() {
                        mir.set(dpos.get(q), mi_nop());
                        q = q + 1;
                    }
                    var i2: i64 = sg;
                    if ld.op == MO_LDX {
                        i2 = (ld.i2 & (0 - 2)) | sg;
                    }
                    mir.set(k, MInst {
                        op: ld.op, r0: m.r0, r1: ld.r1, r2: ld.r2, i0: ld.i0, i1: w, i2: i2
                    });
                    uses = ng_fb_uses(mir, nv);
                    fused = fused + 1;
                }
            }
        }
        k = k + 1;
    }
    if fused == 0 {
        return 0;
    }
    var out: Vec<MInst> = Vec::new();
    var t2: i64 = 0;
    while t2 < mir.len() {
        if mir.get(t2).op >= 0 {
            out.push(mir.get(t2));
        }
        t2 = t2 + 1;
    }
    mir.clear();
    t2 = 0;
    while t2 < out.len() {
        mir.push(out.get(t2));
        t2 = t2 + 1;
    }
    return fused;
}

/// OP18: the compare kind with its operands swapped (a cc b == b cc' a).
fn ng_cc_swap(cc: i64) -> i64 {
    if cc == NCC_LT {
        return NCC_GT;
    }
    if cc == NCC_GT {
        return NCC_LT;
    }
    if cc == NCC_LE {
        return NCC_GE;
    }
    if cc == NCC_GE {
        return NCC_LE;
    }
    if cc == NCC_LTU {
        return NCC_GTU;
    }
    if cc == NCC_GTU {
        return NCC_LTU;
    }
    if cc == NCC_LEU {
        return NCC_GEU;
    }
    if cc == NCC_GEU {
        return NCC_LEU;
    }
    return cc;
}

/// OP18: the compare kind for `mem cc c` made on the `size` bytes of the
/// memory operand itself (`cmp size [m], imm`) where the program compared
/// the load of them (sign-extended when sx) with the constant c; -1 when
/// the narrow compare could differ from the wide one. A sign-extended
/// field compares for equality or signed with a c in its signed range; a
/// zero-extended one for equality or unsigned with a c in its unsigned
/// range, a signed kind becoming the unsigned one (both sides are then
/// non-negative). 8 bytes: any kind, c in 32 bits signed (the immediate
/// is sign-extended).
fn ng_memcmp_cc(size: i64, sx: bool, cc: i64, c: i64) -> i64 {
    if size == 8 {
        if c >= 0 - 2147483648 && c <= 2147483647 {
            return cc;
        }
        return 0 - 1;
    }
    if size != 1 && size != 2 && size != 4 {
        return 0 - 1;
    }
    var bits: i64 = size * 8;
    var eqne: bool = cc == NCC_EQ || cc == NCC_NE;
    var scc: bool = cc == NCC_LT || cc == NCC_LE || cc == NCC_GT || cc == NCC_GE;
    if sx {
        var lo: i64 = 0 - (1 << (bits - 1));
        var hi: i64 = (1 << (bits - 1)) - 1;
        if c < lo || c > hi || !(eqne || scc) {
            return 0 - 1;
        }
        return cc;
    }
    var top: i64 = (1 << bits) - 1;
    if c < 0 || c > top {
        return 0 - 1;
    }
    if cc == NCC_LT {
        return NCC_LTU;
    }
    if cc == NCC_LE {
        return NCC_LEU;
    }
    if cc == NCC_GT {
        return NCC_GTU;
    }
    if cc == NCC_GE {
        return NCC_GEU;
    }
    return cc;
}

/// OP18: the flags of a memory compare (MO_BRCCM / MO_SETCCM `flags`): mode
/// 0 `cmp a, [base + disp]`, mode 1 `cmp size [base + disp], imm`.
fn ng_x64_cmpm(g: &mut NatGen, a: i64, base: i64, flags: i64, disp: i64, imm: i64) {
    var size: i64 = (flags >> 4) & 15;
    if ((flags >> 8) & 1) == 1 {
        x64_cmp_mem_imm(&mut g.e, size, base, disp, imm);
    } else {
        x64_alu_mem(&mut g.e, 0x3B, a, base, disp);
    }
}

/// OP18: MO_BRCCM, a branch on a compare against memory (x86-64).
fn ng_x64_brccm(g: &mut NatGen, a: i64, base: i64, fd: i64, imm: i64, label: i64) {
    if g.rec {
        ng_rec(g, MO_BRCCM, a, base, 0, label, fd, imm);
        return;
    }
    var flags: i64 = fd & 1023;
    ng_x64_cmpm(g, a, base, flags, fd >> 10, imm);
    var cc: i64 = flags & 15;
    if ng_mutant("memcmp") {
        // TG2: the branch the wrong way, on purpose
        cc = ng_cc_inverse(cc);
    }
    if g.br_short {
        x64_jcc_short(&mut g.e, ng_x64_cc(cc), label);
    } else {
        x64_jcc(&mut g.e, ng_x64_cc(cc), label);
    }
}

/// OP18: MO_SETCCM, d = a compare against memory as 0 / 1 (x86-64; the
/// byte goes through r11, as ng_setcc's).
fn ng_x64_setccm(g: &mut NatGen, d: i64, a: i64, base: i64, flags: i64, disp: i64, imm: i64) {
    if g.rec {
        ng_rec(g, MO_SETCCM, d, a, base, flags, disp, imm);
        return;
    }
    ng_x64_cmpm(g, a, base, flags, disp, imm);
    var cc: i64 = flags & 15;
    if ng_mutant("memcmp") {
        cc = ng_cc_inverse(cc);
    }
    x64_setcc(&mut g.e, ng_x64_cc(cc), 11);
    x64_movx(&mut g.e, 0xB6, d, 11);
}

/// OP18: MO_ALUMST, *(base + disp) op= s or imm, 8 bytes (x86-64): `op
/// [m], r` (01 add, 29 sub, 21 and, 09 or, 31 xor) or `op qword [m], imm`
/// (83 / 81 with /0 add, /5 sub, /4 and, /1 or, /6 xor).
fn ng_x64_alumst(g: &mut NatGen, base: i64, s: i64, disp: i64, km: i64, imm: i64) {
    if g.rec {
        ng_rec(g, MO_ALUMST, base, s, 0, disp, km, imm);
        return;
    }
    var kind: i64 = km & 15;
    if ng_mutant("rmw") {
        // TG2: the wrong operation, on purpose
        if kind == 0 {
            kind = 5;
        } else {
            kind = 0;
        }
    }
    var code: i64 = 0x01;
    var ext: i64 = 0;
    if kind == 1 {
        code = 0x29;
        ext = 5;
    } else if kind == 3 {
        code = 0x21;
        ext = 4;
    } else if kind == 4 {
        code = 0x09;
        ext = 1;
    } else if kind == 5 {
        code = 0x31;
        ext = 6;
    }
    if ((km >> 4) & 1) == 1 {
        x64_alu_mem_imm(&mut g.e, ext, base, disp, imm);
    } else {
        x64_alu_to_mem(&mut g.e, code, s, base, disp);
    }
}

/// OP18: compares against memory (x86-64). A BRCC or SETCC (or a BNEZ /
/// BEQZ on t, a compare with 0) one of whose
/// operands t comes, through vreg moves of the same straight stretch
/// (ng_fb_chain: only moves, constants and line rows in between, so no
/// store or call), from a LOAD nothing else reads (ng_fb_deletable)
/// compares with the memory itself: with the other operand's register
/// when the load is 8 bytes (`cmp r, [base + disp]`, mode 0), or with an
/// immediate when the other operand is the zero register or a constant of
/// the stretch: `cmp size [base + disp], imm` for a load of any size, the
/// compare kind adjusted to the field (ng_memcmp_cc; mode 1). A load on
/// the left swaps the compare. Not when t and the other operand are the
/// same vreg, the chain writes the base, the other operand or `keep`, the
/// base is written between the load and the compare, or the displacement
/// is negative or past 31 bits. The constant's LI goes too when nothing
/// else reads it. Returns the number formed. `FID_NAT_OFF=memcmp`: never;
/// FID_NAT_MUTATE=memcmp tests the other way at emission.
fn ng_fuse_memcmp(g: &NatGen, mir: &mut Vec<MInst>, nvreg: i64, keep: i64) -> i64 {
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if !ng_sel_has(g, MO_BRCCM) || !ng_on("memcmp") || nv <= 0 || n == 0 {
        return 0;
    }
    var uses: Vec<i64> = ng_fb_uses(mir, nv);
    var fused: i64 = 0;
    var k: i64 = 0;
    while k < n {
        var m: MInst = mir.get(k);
        if m.op == MO_BRCC || m.op == MO_SETCC || m.op == MO_BNEZ || m.op == MO_BEQZ {
            var x: i64 = m.r0;
            var y: i64 = m.r1;
            var cc: i64 = m.i1;
            if m.op == MO_SETCC {
                x = m.r1;
                y = m.r2;
                cc = m.i0;
            }
            if m.op == MO_BNEZ || m.op == MO_BEQZ {
                // a branch on the loaded value itself (`if p.flag`): the
                // other operand is the constant 0 (-7: no register)
                y = 0 - 7;
                cc = NCC_NE;
                if m.op == MO_BEQZ {
                    cc = NCC_EQ;
                }
            }
            // the register the compare writes (a SETCC's two-address form
            // often writes the moved load itself; SETCCM writes it too)
            var kd: i64 = 0 - 1;
            if m.op == MO_SETCC {
                kd = m.r0;
            }
            var side: i64 = 0;
            var done: bool = false;
            while side < 2 && !done {
                // the load on the right first (o cc [m]), then on the left
                var t: i64 = y;
                var o: i64 = x;
                var occ: i64 = cc;
                if side == 1 {
                    t = x;
                    o = y;
                    occ = ng_cc_swap(cc);
                }
                if t != o && t >= NG_VBASE && t < nvreg {
                    var dpos: Vec<i64> = Vec::new();
                    var p: i64 = ng_fb_chain(mir, k, t, &mut dpos);
                    if p >= 0 {
                        var ld: MInst = mir.get(p);
                        var base: i64 = ld.r1;
                        var ok: bool = ld.op == MO_LOAD && base >= NG_VBASE && base < nvreg && ld.r0 != keep && ld.i0 >= 0 && ld.i0 <= 2147483647;
                        if ok {
                            dpos.push(p);
                            ok = ng_fb_deletable_def(mir, &uses, &dpos, k, nv, kd);
                        }
                        ok = ok && !ng_fb_defines_any(mir, &dpos, base) && !ng_fb_defines_any(mir, &dpos, keep) && !ng_fb_redef(mir, &dpos, p, k, base);
                        if ok && o >= NG_VBASE && o < nvreg && ng_fb_defines_any(mir, &dpos, o) {
                            ok = false;
                        }
                        if ok {
                            // the other operand: a constant (or the zero
                            // register) for mode 1, a vreg for mode 0
                            var mode: i64 = 0 - 1;
                            var icc: i64 = 0 - 1;
                            var imm: i64 = 0;
                            var have_c: bool = false;
                            var c: i64 = 0;
                            var dli: Vec<i64> = Vec::new();
                            if (g.zr >= 0 && o == g.zr) || o == 0 - 7 {
                                have_c = true;
                            } else if o >= NG_VBASE && o < nvreg {
                                var pl: i64 = ng_fb_chain(mir, k, o, &mut dli);
                                if pl >= 0 && mir.get(pl).op == MO_LI {
                                    have_c = true;
                                    c = mir.get(pl).i0;
                                    dli.push(pl);
                                }
                            }
                            if have_c {
                                // o occ [m] == [m] (swap occ) o
                                icc = ng_memcmp_cc(ld.i1, ld.i2 != 0, ng_cc_swap(occ), c);
                                if icc >= 0 {
                                    mode = 1;
                                    imm = c;
                                }
                            }
                            if mode < 0 && ld.i1 == 8 && o >= NG_VBASE && o < nvreg {
                                mode = 0;
                                icc = occ;
                            }
                            if mode >= 0 {
                                var areg: i64 = o;
                                if mode == 1 {
                                    areg = base;
                                    if dli.len() > 0 {
                                        var all: Vec<i64> = Vec::new();
                                        var q0: i64 = 0;
                                        while q0 < dpos.len() {
                                            all.push(dpos.get(q0));
                                            q0 = q0 + 1;
                                        }
                                        q0 = 0;
                                        while q0 < dli.len() {
                                            all.push(dli.get(q0));
                                            q0 = q0 + 1;
                                        }
                                        if ng_fb_deletable_def(mir, &uses, &all, k, nv, kd) && !ng_fb_defines_any(mir, &all, base) && !ng_fb_defines_any(mir, &all, keep) {
                                            dpos = all;
                                        }
                                    }
                                }
                                var flags: i64 = icc | (ld.i1 << 4) | (mode << 8);
                                var q: i64 = 0;
                                while q < dpos.len() {
                                    mir.set(dpos.get(q), mi_nop());
                                    q = q + 1;
                                }
                                if m.op != MO_SETCC {
                                    mir.set(k, MInst {
                                        op: MO_BRCCM, r0: areg, r1: base, r2: 0, i0: m.i0, i1: flags | (ld.i0 << 10), i2: imm
                                    });
                                } else {
                                    mir.set(k, MInst {
                                        op: MO_SETCCM, r0: m.r0, r1: areg, r2: base, i0: flags, i1: ld.i0, i2: imm
                                    });
                                }
                                uses = ng_fb_uses(mir, nv);
                                fused = fused + 1;
                                done = true;
                            }
                        }
                    }
                }
                side = side + 1;
            }
        }
        k = k + 1;
    }
    if fused == 0 {
        return 0;
    }
    var out: Vec<MInst> = Vec::new();
    var t2: i64 = 0;
    while t2 < mir.len() {
        if mir.get(t2).op >= 0 {
            out.push(mir.get(t2));
        }
        t2 = t2 + 1;
    }
    mir.clear();
    t2 = 0;
    while t2 < out.len() {
        mir.push(out.get(t2));
        t2 = t2 + 1;
    }
    return fused;
}

/// OP18: read-modify-write destinations (x86-64). An 8-byte STORE whose
/// value comes (through vreg moves of the straight stretch, ng_fb_chain)
/// from an ADD, SUB, AND, OR or XOR one operand of which comes the same way
/// from an 8-byte LOAD of the same address (the same base value,
/// ng_fb_same, and displacement) — `p.f = p.f | x` — becomes one `op
/// [base + disp], x` (MO_ALUMST mode 0), or `op qword [base + disp], imm`
/// (mode 1) when x is a constant of the stretch that fits 32 bits signed.
/// The load may be either operand of a commuting operation, the left one
/// of SUB. Not when anything but the store and the chain reads the loaded
/// value, the result or their copies (ng_fb_deletable: a checked add
/// reads its operands again, so it keeps its load), when the chain writes
/// the base, x or `keep`, or when x is written between the operation and
/// the store. Between the load and the store there are only moves,
/// constants and line rows, so no other store or call. Formed before
/// ng_fuse_ldop (which would take the load into the operation). Returns
/// the number formed. `FID_NAT_OFF=rmw`: never; FID_NAT_MUTATE=rmw uses
/// the wrong operation at emission.
fn ng_fuse_rmw(g: &NatGen, mir: &mut Vec<MInst>, nvreg: i64, keep: i64) -> i64 {
    var nv: i64 = nvreg - NG_VBASE;
    var n: i64 = mir.len();
    if !ng_sel_has(g, MO_ALUMST) || !ng_on("rmw") || nv <= 0 || n == 0 {
        return 0;
    }
    var uses: Vec<i64> = ng_fb_uses(mir, nv);
    var fused: i64 = 0;
    var s: i64 = 0;
    while s < n {
        var st: MInst = mir.get(s);
        if st.op == MO_STORE && st.i1 == 8 && st.r0 >= NG_VBASE && st.r0 < nvreg && st.r1 >= NG_VBASE && st.r1 < nvreg && st.r0 != st.r1 && st.i0 >= 0 && st.i0 <= 2147483647 {
            var dval: Vec<i64> = Vec::new();
            var k: i64 = ng_fb_chain(mir, s, st.r1, &mut dval);
            if k >= 0 {
                var m: MInst = mir.get(k);
                var kind: i64 = ng_ldop_kind(m.op);
                if kind >= 0 && kind != 2 && m.r0 >= NG_VBASE && m.r0 < nvreg && m.r1 != m.r2 && m.r1 >= NG_VBASE && m.r1 < nvreg && m.r2 >= NG_VBASE && m.r2 < nvreg {
                    var side: i64 = 1;
                    var done: bool = false;
                    while side <= 2 && !done {
                        // the load on the left first; on the right where
                        // the operation commutes
                        var t: i64 = m.r1;
                        var a: i64 = m.r2;
                        if side == 2 {
                            t = m.r2;
                            a = m.r1;
                        }
                        if side == 1 || kind != 1 {
                            var dload: Vec<i64> = Vec::new();
                            var p: i64 = ng_fb_chain(mir, k, t, &mut dload);
                            if p >= 0 {
                                var ld: MInst = mir.get(p);
                                var lb: i64 = ld.r1;
                                var ok: bool = ld.op == MO_LOAD && ld.i1 == 8 && ld.i0 == st.i0 && lb >= NG_VBASE && lb < nvreg && ld.r0 != keep;
                                ok = ok && ng_fb_same(mir, p, lb, s, st.r0);
                                var set: Vec<i64> = Vec::new();
                                if ok {
                                    var q0: i64 = 0;
                                    while q0 < dload.len() {
                                        set.push(dload.get(q0));
                                        q0 = q0 + 1;
                                    }
                                    set.push(p);
                                    set.push(k);
                                    q0 = 0;
                                    while q0 < dval.len() {
                                        set.push(dval.get(q0));
                                        q0 = q0 + 1;
                                    }
                                    // OP18: on the load-on-the-right side the
                                    // other operand may be the operation's
                                    // own destination (`and d, d, x`); the
                                    // operation is in the set and deleted,
                                    // so only the rest may not define it
                                    ok = ng_fb_deletable(mir, &uses, &set, s, nv) && !ng_fb_defines_any(mir, &set, st.r0) && !ng_fb_defines_any(mir, &set, lb) && !ng_fb_defines_any_but(mir, &set, a, k) && !ng_fb_defines_any(mir, &set, keep);
                                }
                                if ok {
                                    // the operand: a constant of the stretch
                                    // (mode 1) or a's register, unchanged
                                    // up to the store (mode 0)
                                    var mode: i64 = 0 - 1;
                                    var imm: i64 = 0;
                                    var dimm: Vec<i64> = Vec::new();
                                    var pl: i64 = ng_fb_chain(mir, k, a, &mut dimm);
                                    if pl >= 0 && mir.get(pl).op == MO_LI && mir.get(pl).i0 >= 0 - 2147483648 && mir.get(pl).i0 <= 2147483647 {
                                        mode = 1;
                                        imm = mir.get(pl).i0;
                                        dimm.push(pl);
                                        var all: Vec<i64> = Vec::new();
                                        var q1: i64 = 0;
                                        while q1 < set.len() {
                                            all.push(set.get(q1));
                                            q1 = q1 + 1;
                                        }
                                        q1 = 0;
                                        while q1 < dimm.len() {
                                            all.push(dimm.get(q1));
                                            q1 = q1 + 1;
                                        }
                                        if ng_fb_deletable(mir, &uses, &all, s, nv) && !ng_fb_defines_any(mir, &all, st.r0) && !ng_fb_defines_any(mir, &all, keep) {
                                            set = all;
                                        }
                                    } else if ng_fb_same(mir, k, a, s, a) {
                                        mode = 0;
                                    } else if a == m.r0 && !ng_fb_redef(mir, &set, k, s, a) {
                                        // OP18: two-address form (`and d, d,
                                        // x`, d the other operand): deleted,
                                        // d keeps the operand's value up to
                                        // the store, which is what the fused
                                        // `op [base + disp], d` reads
                                        mode = 0;
                                    }
                                    if mode >= 0 {
                                        var q: i64 = 0;
                                        while q < set.len() {
                                            mir.set(set.get(q), mi_nop());
                                            q = q + 1;
                                        }
                                        var ra: i64 = a;
                                        if mode == 1 {
                                            ra = st.r0;
                                        }
                                        mir.set(s, MInst {
                                            op: MO_ALUMST, r0: st.r0, r1: ra, r2: 0, i0: st.i0, i1: kind | (mode << 4), i2: imm
                                        });
                                        uses = ng_fb_uses(mir, nv);
                                        fused = fused + 1;
                                        done = true;
                                    }
                                }
                            }
                        }
                        side = side + 1;
                    }
                }
            }
        }
        s = s + 1;
    }
    if fused == 0 {
        return 0;
    }
    var out: Vec<MInst> = Vec::new();
    var t2: i64 = 0;
    while t2 < mir.len() {
        if mir.get(t2).op >= 0 {
            out.push(mir.get(t2));
        }
        t2 = t2 + 1;
    }
    mir.clear();
    t2 = 0;
    while t2 < out.len() {
        mir.push(out.get(t2));
        t2 = t2 + 1;
    }
    return fused;
}

/// TG7: BMI2 is used under `--cpu x86-64-v3` / `x86-64-v4` only (the
/// default and `baseline` keep to what every x86-64 the runtime runs on has).
fn ng_x64_bmi2(g: &NatGen) -> bool {
    return ng_x64(g) && (g_nat_cpu == "x86-64-v3" || g_nat_cpu == "x86-64-v4");
}

fn ng_x64_cc(cc: i64) -> i64 {
    if cc == NCC_EQ {
        return X64_E;
    }
    if cc == NCC_NE {
        return X64_NE;
    }
    if cc == NCC_LT {
        return X64_L;
    }
    if cc == NCC_LE {
        return X64_LE;
    }
    if cc == NCC_GT {
        return X64_G;
    }
    if cc == NCC_GE {
        return X64_GE;
    }
    if cc == NCC_LTU {
        return X64_B;
    }
    if cc == NCC_LEU {
        return X64_BE;
    }
    if cc == NCC_GTU {
        return X64_A;
    }
    return X64_AE;
}

/// xmm0, xmm1 = the floats of a and b (an f32 widened); an f64 already
/// there (the xmm cache) is not moved again.
fn ng_x64_fload2(g: &mut NatGen, a: i64, b: i64, is32: bool) {
    if !is32 && !g.rec && ng_on("xmmcache") {
        if g.x1_reg != b {
            if g.x0_reg == b && g.x0_reg != a {
                x64_sse(&mut g.e, 0xF2, 0x10, 1, 0);
                // movsd xmm1, xmm0
            } else {
                x64_movq_xr(&mut g.e, 1, b, true);
            }
        }
        if g.x0_reg != a {
            x64_movq_xr(&mut g.e, 0, a, true);
        }
        g.x0_reg = a;
        g.x1_reg = b;
        return;
    }
    g.x0_reg = 0 - 1;
    g.x1_reg = 0 - 1;
    if is32 {
        x64_movq_xr(&mut g.e, 0, a, false);
        x64_sse(&mut g.e, 0xF3, 0x5A, 0, 0);
        x64_movq_xr(&mut g.e, 1, b, false);
        x64_sse(&mut g.e, 0xF3, 0x5A, 1, 1);
    } else {
        x64_movq_xr(&mut g.e, 0, a, true);
        x64_movq_xr(&mut g.e, 1, b, true);
    }
}

/// d = the bits of xmm0 (f32 bits, zero-extended, if is32)
fn ng_x64_fstore0(g: &mut NatGen, d: i64, is32: bool) {
    if g.x1_reg == d {
        g.x1_reg = 0 - 1;
    }
    if !is32 && !g.rec && ng_on("xmmcache") {
        x64_movq_rx(&mut g.e, d, 0, true);
        g.x0_reg = d;
        return;
    }
    g.x0_reg = 0 - 1;
    if is32 {
        x64_sse(&mut g.e, 0xF2, 0x5A, 0, 0);
        x64_movq_rx(&mut g.e, d, 0, false);
    } else {
        x64_movq_rx(&mut g.e, d, 0, true);
    }
}

/// The generic Linux system call numbers the runtime uses -> x86-64's.
fn ng_x64_sysmap() -> Vec<i64> {
    var m: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 300 {
        m.push(65535);
        i = i + 1;
    }
    var pairs: Vec<i64> = Vec::new();
    pairs.push(25);
    pairs.push(72);
    // fcntl
    pairs.push(34);
    pairs.push(258);
    // mkdirat
    pairs.push(35);
    pairs.push(263);
    // unlinkat
    pairs.push(56);
    pairs.push(257);
    // openat
    pairs.push(57);
    pairs.push(3);
    // close
    pairs.push(61);
    pairs.push(217);
    // getdents64
    pairs.push(62);
    pairs.push(8);
    // lseek
    pairs.push(63);
    pairs.push(0);
    // read
    pairs.push(64);
    pairs.push(1);
    // write
    pairs.push(73);
    pairs.push(271);
    // ppoll
    pairs.push(79);
    pairs.push(262);
    // newfstatat
    pairs.push(93);
    pairs.push(60);
    // exit
    pairs.push(94);
    pairs.push(231);
    // exit_group
    pairs.push(98);
    pairs.push(202);
    // futex
    pairs.push(101);
    pairs.push(35);
    // nanosleep
    pairs.push(103);
    pairs.push(38);
    // setitimer (DB9's profiler)
    pairs.push(113);
    pairs.push(228);
    // clock_gettime
    pairs.push(123);
    pairs.push(204);
    // sched_getaffinity
    pairs.push(124);
    pairs.push(24);
    // sched_yield
    pairs.push(129);
    pairs.push(62);
    // kill
    pairs.push(131);
    pairs.push(234);
    // tgkill
    pairs.push(132);
    pairs.push(131);
    // sigaltstack
    pairs.push(134);
    pairs.push(13);
    // rt_sigaction
    pairs.push(172);
    pairs.push(39);
    // getpid
    pairs.push(173);
    pairs.push(110);
    // getppid
    pairs.push(174);
    pairs.push(102);
    // getuid
    pairs.push(176);
    pairs.push(104);
    // getgid
    pairs.push(178);
    pairs.push(186);
    // gettid
    pairs.push(179);
    pairs.push(99);
    // sysinfo
    pairs.push(198);
    pairs.push(41);
    // socket
    pairs.push(200);
    pairs.push(49);
    // bind
    pairs.push(201);
    pairs.push(50);
    // listen
    pairs.push(202);
    pairs.push(43);
    // accept
    pairs.push(203);
    pairs.push(42);
    // connect
    pairs.push(206);
    pairs.push(44);
    // sendto
    pairs.push(207);
    pairs.push(45);
    // recvfrom
    pairs.push(208);
    pairs.push(54);
    // setsockopt
    pairs.push(209);
    pairs.push(55);
    // getsockopt
    pairs.push(215);
    pairs.push(11);
    // munmap
    pairs.push(220);
    pairs.push(56);
    // clone
    pairs.push(221);
    pairs.push(59);
    // execve
    pairs.push(222);
    pairs.push(9);
    // mmap
    pairs.push(226);
    pairs.push(10);
    // mprotect
    pairs.push(233);
    pairs.push(28);
    // madvise (RT11: linux_runtime/conc.fd pe_task_stack_new, MADV_GUARD_INSTALL)
    pairs.push(260);
    pairs.push(61);
    // wait4
    pairs.push(276);
    pairs.push(316);
    // renameat2
    pairs.push(278);
    pairs.push(318);
    // getrandom
    pairs.push(19);
    pairs.push(290);
    // eventfd2
    pairs.push(20);
    pairs.push(291);
    // epoll_create1
    pairs.push(21);
    pairs.push(233);
    // epoll_ctl
    pairs.push(22);
    pairs.push(281);
    // epoll_pwait
    pairs.push(261);
    pairs.push(302);
    // prlimit64 (SP16: sys.fd pe_main_stack_raise)
    i = 0;
    while i < pairs.len() {
        m.set(pairs.get(i), pairs.get(i + 1));
        i = i + 2;
    }
    return m;
}

/// Every primitive of the x86-64 target (what ng_gen_primitives and
/// ng_gen_primitives2 give the other targets).
fn ng_gen_primitives_x64(g: &mut NatGen) {
    if g.win {
        ng_gen_primitives_win(g);
    } else if g.mac {
        ng_gen_primitives_mac(g);
    } else {
        ng_gen_primitives_x64_linux(g);
    }
    ng_gen_primitives_x64_common(g);
}

/// The Linux-only primitives of x86-64: _start, nat_syscall, threads
/// through clone, the thread pointer, signals.
fn ng_gen_primitives_x64_linux(g: &mut NatGen) {
    // _start: keep the initial sp, the runtime's initialization, main(env 0),
    // exit_group(its result)
    g.entry_label = NatEnc_label(&mut g.e);
    NatEnc_place(&mut g.e, g.entry_label);
    var main_label: i64 = ng_fn_label(g, "main");
    ng_gen_pie_reloc(g);
    x64_mov(&mut g.e, 0, 4);
    x64_store_label(&mut g.e, 0, g.start_sp_label);
    x64_li(&mut g.e, 5, 0);
    if ng_has_fn(g, "pe_rt_init") {
        x64_li(&mut g.e, 7, 0);
        x64_call(&mut g.e, ng_fn_label(g, "pe_rt_init"));
    }
    x64_li(&mut g.e, 7, 0);
    x64_call(&mut g.e, main_label);
    // DB9: pe_rt_exit(its result) (the profile's report), which exits
    if ng_has_fn(g, "pe_rt_exit") {
        x64_mov(&mut g.e, 6, 7);
        x64_li(&mut g.e, 7, 0);
        x64_call(&mut g.e, ng_fn_label(g, "pe_rt_exit"));
    }
    x64_li(&mut g.e, 0, 231);
    x64_syscall(&mut g.e);
    x64_ud2(&mut g.e);

    // nat_syscall(n, a, b, c, d, e, f): the generic number mapped, then the
    // kernel's convention (rax; rdi, rsi, rdx, r10, r8, r9)
    var systab: i64 = NatEnc_label(&mut g.e);
    ng_prim(g, "nat_syscall");
    x64_lea_label(&mut g.e, 11, systab);
    // movzx eax, word [r11 + rdi * 2]
    NatEnc_byte(&mut g.e, 0x41);
    NatEnc_byte(&mut g.e, 0x0F);
    NatEnc_byte(&mut g.e, 0xB7);
    NatEnc_byte(&mut g.e, 0x04);
    NatEnc_byte(&mut g.e, 0x7B);
    x64_mov(&mut g.e, 7, 6);
    x64_mov(&mut g.e, 6, 2);
    x64_mov(&mut g.e, 2, 1);
    x64_load(&mut g.e, 10, 4, 8, 8, true);
    x64_load(&mut g.e, 8, 4, 16, 8, true);
    x64_load(&mut g.e, 9, 4, 24, 8, true);
    x64_syscall(&mut g.e);
    x64_mov(&mut g.e, 7, 0);
    x64_ret(&mut g.e);
    NatEnc_align(&mut g.e, 2);
    NatEnc_place(&mut g.e, systab);
    var map: Vec<i64> = ng_x64_sysmap();
    var si: i64 = 0;
    while si < map.len() {
        NatEnc_byte(&mut g.e, map.get(si) & 255);
        NatEnc_byte(&mut g.e, (map.get(si) >> 8) & 255);
        si = si + 1;
    }

    // nat_clone_thread(entry, arg, stack_top, ctid, tls [stack]) -> tid
    ng_prim(g, "nat_clone_thread");
    x64_load(&mut g.e, 11, 4, 8, 8, true);
    // tls
    x64_lea(&mut g.e, 9, 2, 0 - 16);
    // the child's stack
    x64_store(&mut g.e, 7, 9, 0, 8);
    x64_store(&mut g.e, 6, 9, 8, 8);
    x64_mov(&mut g.e, 10, 1);
    // ctid
    x64_mov(&mut g.e, 8, 11);
    // tls: the thread pointer is the block + 72, so that fs:[-8] is the
    // block's word at +64, its own address (2g.99: see nat_tls_get)
    x64_add_imm(&mut g.e, 8, 72);
    x64_mov(&mut g.e, 6, 9);
    // newsp
    x64_li(&mut g.e, 2, 0);
    // ptid
    x64_li(&mut g.e, 7, 0x2D0F00);
    x64_li(&mut g.e, 0, 56);
    // clone
    x64_syscall(&mut g.e);
    var parent: i64 = NatEnc_label(&mut g.e);
    x64_test(&mut g.e, 0, 0);
    x64_jcc(&mut g.e, X64_NE, parent);
    x64_load(&mut g.e, 0, 4, 0, 8, true);
    x64_load(&mut g.e, 6, 4, 8, 8, true);
    x64_li(&mut g.e, 7, 0);
    x64_li(&mut g.e, 5, 0);
    x64_call_r(&mut g.e, 0);
    x64_li(&mut g.e, 7, 0);
    x64_li(&mut g.e, 0, 60);
    // exit (this thread)
    x64_syscall(&mut g.e);
    x64_ud2(&mut g.e);
    NatEnc_place(&mut g.e, parent);
    x64_mov(&mut g.e, 7, 0);
    x64_ret(&mut g.e);

    // The thread pointer: fs. The block is the word at fs:[-8]: where the
    // static TLS of the executable is (variant II: an 8-byte PT_TLS block
    // right below the thread pointer), so a dynamically linked image (CI2)
    // keeps the C library's thread pointer, whose TLS strtod and the rest of
    // libc read (2g.99: with fs moved to the block, strtod read its locale
    // from the block's neighbours and faulted at 0x8). A static image (and
    // a thread of nat_clone_thread) sets fs to the block + 72: fs:[-8] is
    // then the block's word at +64, its own address.
    ng_prim(g, "nat_tls_get");
    x64_load_fs(&mut g.e, 7, 0 - 8);
    x64_ret(&mut g.e);
    // nat_tls_set(v): without a thread pointer yet (arch_prctl(ARCH_GET_FS)
    // gives 0: a static image's first thread), fs = v + 72; else fs:[-8] = v
    ng_prim(g, "nat_tls_set");
    var tls_have: i64 = NatEnc_label(&mut g.e);
    x64_mov(&mut g.e, 2, 7);
    x64_add_imm(&mut g.e, 4, 0 - 16);
    x64_li(&mut g.e, 0, 0);
    x64_store(&mut g.e, 0, 4, 0, 8);
    x64_mov(&mut g.e, 6, 4);
    // ARCH_GET_FS
    x64_li(&mut g.e, 7, 4099);
    x64_li(&mut g.e, 0, 158);
    x64_syscall(&mut g.e);
    x64_load(&mut g.e, 0, 4, 0, 8, true);
    x64_add_imm(&mut g.e, 4, 16);
    x64_test(&mut g.e, 0, 0);
    x64_jcc(&mut g.e, X64_NE, tls_have);
    x64_lea(&mut g.e, 6, 2, 72);
    // ARCH_SET_FS
    x64_li(&mut g.e, 7, 4098);
    x64_li(&mut g.e, 0, 158);
    // arch_prctl
    x64_syscall(&mut g.e);
    x64_ret(&mut g.e);
    NatEnc_place(&mut g.e, tls_have);
    x64_store_fs(&mut g.e, 2, 0 - 8);
    x64_ret(&mut g.e);

    // Signals: the handler (sig, info, uc) calls pe_on_signal_uc(sig, info,
    // uc) (DB9: the profiler reads the interrupted pc from uc), else
    // pe_on_signal(sig, info); the restorer returns through rt_sigreturn
    // (x86-64 has no vdso one)
    var sig_entry: i64 = NatEnc_label(&mut g.e);
    NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
    NatEnc_place(&mut g.e, sig_entry);
    var x_sig_fn: str = ng_sig_fn(g);
    if x_sig_fn != "" {
        x64_push(&mut g.e, 5);
        x64_mov(&mut g.e, 5, 4);
        x64_mov(&mut g.e, 1, 2);
        // rcx = uc
        x64_mov(&mut g.e, 2, 6);
        x64_mov(&mut g.e, 6, 7);
        x64_li(&mut g.e, 7, 0);
        x64_call(&mut g.e, ng_fn_label(g, x_sig_fn));
        x64_pop(&mut g.e, 5);
    }
    x64_ret(&mut g.e);
    ng_prim(g, "nat_sig_handler");
    x64_lea_label(&mut g.e, 7, sig_entry);
    x64_ret(&mut g.e);
    var restorer: i64 = NatEnc_label(&mut g.e);
    NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
    NatEnc_place(&mut g.e, restorer);
    x64_li(&mut g.e, 0, 15);
    // rt_sigreturn
    x64_syscall(&mut g.e);
    ng_prim(g, "nat_sig_restorer");
    x64_lea_label(&mut g.e, 7, restorer);
    x64_ret(&mut g.e);
}

/// The primitives x86-64 Linux and Windows share.
fn ng_gen_primitives_x64_common(g: &mut NatGen) {
    // Atomics (x86's ordering is total for these)
    ng_prim(g, "nat_atomic_load");
    x64_load(&mut g.e, 7, 7, 0, 8, true);
    x64_ret(&mut g.e);
    ng_prim(g, "nat_atomic_store");
    x64_xchg_mem(&mut g.e, 7, 6);
    x64_ret(&mut g.e);
    ng_prim(g, "nat_atomic_add");
    x64_lock_xadd(&mut g.e, 7, 6);
    x64_mov(&mut g.e, 7, 6);
    x64_ret(&mut g.e);
    ng_prim(g, "nat_atomic_cas");
    x64_mov(&mut g.e, 0, 6);
    x64_lock_cmpxchg(&mut g.e, 7, 2);
    x64_setcc(&mut g.e, X64_E, 11);
    x64_movx(&mut g.e, 0xB6, 7, 11);
    x64_ret(&mut g.e);

    // nat_ctx_swap and the task trampoline: one generator for every
    // machine-layer target (MI19, ng_prim_ctx_swap / ng_prim_task_tramp)
    ng_prim_ctx_swap(g);
    ng_prim_task_tramp(g);
    var k: i64 = 0;

    // nat_call_fn(addr, nargs, argv): addr(env 0, argv[0..8])
    ng_prim(g, "nat_call_fn");
    x64_push(&mut g.e, 5);
    x64_mov(&mut g.e, 5, 4);
    x64_sub_imm(&mut g.e, 4, 48);
    x64_mov(&mut g.e, 11, 7);
    x64_mov(&mut g.e, 10, 2);
    k = 3;
    while k < 8 {
        x64_load(&mut g.e, 0, 10, 8 * k, 8, true);
        x64_store(&mut g.e, 0, 4, 8 * (k - 3), 8);
        k = k + 1;
    }
    x64_load(&mut g.e, 6, 10, 0, 8, true);
    x64_load(&mut g.e, 2, 10, 8, 8, true);
    x64_load(&mut g.e, 1, 10, 16, 8, true);
    x64_li(&mut g.e, 7, 0);
    x64_call_r(&mut g.e, 11);
    x64_mov(&mut g.e, 4, 5);
    x64_pop(&mut g.e, 5);
    x64_ret(&mut g.e);

    ng_prim(g, "nat_fn_table");
    x64_lea_label(&mut g.e, 7, g.fn_table_label);
    x64_ret(&mut g.e);
    ng_prim(g, "nat_fn_names");
    x64_lea_label(&mut g.e, 7, g.names_label);
    x64_ret(&mut g.e);

    ng_prim(g, "nat_frame_fp");
    x64_mov(&mut g.e, 7, 5);
    x64_ret(&mut g.e);
    ng_prim(g, "nat_frame_ret");
    x64_load(&mut g.e, 7, 7, 8, 8, true);
    x64_ret(&mut g.e);
    ng_prim(g, "nat_frame_next");
    x64_load(&mut g.e, 7, 7, 0, 8, true);
    x64_ret(&mut g.e);

    ng_prim(g, "nat_arch");
    x64_li(&mut g.e, 7, NAT_X64);
    x64_ret(&mut g.e);
    // nat_os() -> 0 Linux, 1 Windows (macOS defines its own: 2)
    if !g.mac {
        ng_prim(g, "nat_os");
        if g.win {
            x64_li(&mut g.e, 7, 1);
        } else {
            x64_li(&mut g.e, 7, 0);
        }
        x64_ret(&mut g.e);
    }

    // nat_fma(a, b, c): FMA3 (x86-64-v3)
    ng_prim(g, "nat_fma");
    x64_movq_xr(&mut g.e, 0, 7, true);
    x64_movq_xr(&mut g.e, 1, 6, true);
    x64_movq_xr(&mut g.e, 2, 2, true);
    x64_vfmadd213sd_012(&mut g.e);
    x64_movq_rx(&mut g.e, 7, 0, true);
    x64_ret(&mut g.e);

    // The C math functions that are an instruction or a few
    ng_prim(g, "nat_c_sqrt");
    x64_movq_xr(&mut g.e, 0, 7, true);
    x64_sse(&mut g.e, 0xF2, 0x51, 0, 0);
    x64_movq_rx(&mut g.e, 7, 0, true);
    x64_ret(&mut g.e);
    ng_prim(g, "nat_c_fabs");
    x64_li(&mut g.e, 11, 9223372036854775807);
    x64_alu(&mut g.e, 0x21, 7, 11);
    x64_ret(&mut g.e);
    var modes: Vec<i64> = Vec::new();
    modes.push(9);
    modes.push(10);
    modes.push(11);
    var mnames: Vec<str> = Vec::new();
    mnames.push("nat_c_floor");
    mnames.push("nat_c_ceil");
    mnames.push("nat_c_trunc");
    var mi: i64 = 0;
    while mi < 3 {
        ng_prim(g, mnames.get(mi));
        x64_movq_xr(&mut g.e, 0, 7, true);
        x64_roundsd(&mut g.e, 0, 0, modes.get(mi));
        x64_movq_rx(&mut g.e, 7, 0, true);
        x64_ret(&mut g.e);
        mi = mi + 1;
    }
    // round: halves away from zero (t = trunc x; |x - t| >= 0.5: t +- 1)
    ng_prim(g, "nat_c_round");
    x64_movq_xr(&mut g.e, 0, 7, true);
    x64_roundsd(&mut g.e, 1, 0, 11);
    x64_movq_rx(&mut g.e, 11, 0, true);
    x64_movq_xr(&mut g.e, 2, 11, true);
    x64_sse(&mut g.e, 0xF2, 0x5C, 2, 1);
    // xmm2 = x - t
    x64_movq_rx(&mut g.e, 11, 2, true);
    x64_li(&mut g.e, 10, 9223372036854775807);
    x64_alu(&mut g.e, 0x21, 11, 10);
    x64_movq_xr(&mut g.e, 2, 11, true);
    // |x - t|
    x64_li(&mut g.e, 10, 4602678819172646912);
    // 0.5
    x64_movq_xr(&mut g.e, 3, 10, true);
    x64_sse(&mut g.e, 0x66, 0x2E, 2, 3);
    var rdone: i64 = NatEnc_label(&mut g.e);
    x64_jcc(&mut g.e, X64_B, rdone);
    x64_mov(&mut g.e, 11, 7);
    x64_li(&mut g.e, 10, 0 - 9223372036854775807 - 1);
    x64_alu(&mut g.e, 0x21, 11, 10);
    // the sign of x
    x64_li(&mut g.e, 10, 4607182418800017408);
    // 1.0
    x64_alu(&mut g.e, 0x09, 11, 10);
    x64_movq_xr(&mut g.e, 3, 11, true);
    x64_sse(&mut g.e, 0xF2, 0x58, 1, 3);
    NatEnc_place(&mut g.e, rdone);
    x64_movq_rx(&mut g.e, 7, 1, true);
    x64_ret(&mut g.e);

    // nat_start_sp()
    var ssp: i64 = NatEnc_label(&mut g.e);
    HashMap_insert(g.fn_labels, "nat_start_sp", ssp);
    g.fn_label_names.push("nat_start_sp");
    NatEnc_place(&mut g.e, ssp);
    x64_load_label(&mut g.e, 7, g.start_sp_label);
    x64_ret(&mut g.e);
}

// ===========================================================================
// Calls
// ===========================================================================

/// Load call arguments: `srcs` are value ids (-1: a null `__env`).
/// Arguments 8 and up go to the outgoing area.
fn ng_load_args(g: &mut NatGen, srcs: Vec<i64>) {
    var nr: i64 = ng_nregargs(g);
    var i: i64 = nr;
    while i < srcs.len() {
        if srcs.get(i) < 0 {
            ng_li(g, g.t0, 0);
        } else {
            ng_ld_val(g, g.t0, srcs.get(i));
        }
        ng_st_outgoing(g, i - nr, g.t0);
        i = i + 1;
    }
    i = 0;
    while i < srcs.len() && i < nr {
        var r: i64 = ng_argreg(g, i);
        if srcs.get(i) < 0 {
            ng_li(g, r, 0);
        } else {
            ng_ld_val(g, r, srcs.get(i));
        }
        i = i + 1;
    }
}

/// Call function `name` (already resolved) with its arguments loaded,
/// queueing it for compilation. False, and a trap, when nothing defines it.
fn ng_emit_call(g: &mut NatGen, name: str) -> bool {
    var l: i64 = ng_fn_label(g, name);
    if l == 0 {
        ng_unresolved(g, name);
        ng_trap(g);
        return false;
    }
    ng_call_label(g, l);
    return true;
}

/// Call builtin `name` whose `nargs` (at most 7) arguments are in the first
/// argument registers: through the runtime's Fides function when there is
/// one (shifting the arguments for its `__env`).
fn ng_call_builtin(g: &mut NatGen, name: str, nargs: i64) {
    var target: str = ng_resolve(g, name);
    if ng_has_fn(g, target) && !ng_has_fn(g, name) {
        var i: i64 = nargs;
        while i > 0 {
            ng_mov(g, ng_argreg(g, i), ng_argreg(g, i - 1));
            i = i - 1;
        }
        ng_li(g, ng_argreg(g, 0), 0);
    }
    ng_emit_call(g, target);
}

/// IR Call: pe_ir's routing (print, p_to_str by argument type), then the
/// resolved function with its arguments; the result goes to `dst`.
/// The element code of a Vec of bytes (core's VEC_BYTES; pe_ir's
/// PEIR_VEC_BYTES): Vec<u8> and Vec<bool> hold one byte per element.
const NG_VEC_BYTES: i64 = 0x4649445645430009;
/// Value v's static type is Vec<u8> or Vec<bool>.
fn ng_vec_bytes_typed(func: &IrFunction, v: i64) -> bool {
    match IrFunction_get_meta(func, v) {
        OptValueMeta::Some(m) => {
            match m.ty {
                IrType::Generic(n, targs) => {
                    if n == "Vec" && targs.len() == 1 {
                        match targs.get(0) {
                            IrType::U8 => {
                                return true;
                            }
                            IrType::Bool => {
                                return true;
                            }
                            _ => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
        }
        OptValueMeta::None => {
        }
    }
    return false;
}

/// t3 = 1 when the Vec at t0 holds elements of the static kind (words:
/// code 0; bytes: NG_VEC_BYTES), via t2; jumps to slow otherwise.
fn ng_vec_kind_check(g: &mut NatGen, bytes: bool, slow: i64) {
    ng_load(g, g.t2, g.t0, 24, 8, false);
    if bytes {
        ng_li(g, g.t3, NG_VEC_BYTES);
        ng_setcc(g, g.t3, g.t2, g.t3, NCC_EQ);
        ng_beqz(g, g.t3, slow);
    } else {
        ng_bnez(g, g.t2, slow);
    }
}

/// checks.fd proved operation id needs no overflow or bounds check.
fn ng_unchecked(g: &NatGen, id: i64) -> bool {
    return id >= 0 && id < g.unchecked.len() && (g.unchecked.get(id) & 1) != 0;
}

/// t2 = the address of element t1 of the Vec at t0 (data + t1 * size), via t3.
fn ng_vec_elem_addr(g: &mut NatGen, bytes: bool) {
    ng_load(g, g.t2, g.t0, 0, 8, false);
    if bytes {
        ng_add(g, g.t2, g.t2, g.t1);
    } else if ng_on("addshl") {
        // MI22: data + index * 8 in one operation
        ng_addshl(g, g.t2, g.t2, g.t1, 3);
    } else {
        ng_li(g, g.t3, 3);
        ng_shl(g, g.t3, g.t1, g.t3);
        ng_add(g, g.t2, g.t2, g.t3);
    }
}

// ===========================================================================
// TG11 / OP21: SIMD as machine IR vector operations
//
// The vector class (NG_RC_VEC) is the four vector registers that the
// vector operations name (MO_VLD .. MO_VEND, see their definition), apart
// from the float operations' scratch pair (xmm0/xmm1, v0/v1, f0/f1) and
// from MI25's float pool, so a float value may stay in its register across
// vector code and a float operation may come between two vector ones:
// x86-64 xmm12..xmm15 (ymm under AVX2; the pool is xmm2..xmm11; all
// caller-saved in the System V convention), --nat Windows the same (MI14:
// xmm6..xmm15 are callee-saved in the Windows convention, but Windows
// calls this code back and gets control again only through the vectored
// exception handler, which keeps them: ng_gen_primitives_win); AArch64
// v28..v31 (caller-saved; the pool is v16..v27); RISC-V v1..v4 (v0 the
// mask; the V registers are apart from the float ones). The class has no
// allocatable pool: a vector value is held from the load that fills its
// register to the store or lane move that empties it, inside one IR
// instruction's lowering, with no call between (every vector register is
// caller-saved). Spill code only touches general registers, so it may
// come between.
//
// Selection: MO_VBIN from the TG1 table (ng_isel: SSE2 / AVX2 / NEON / RVV
// rows by width; FID_NAT_OFF=isel the hand-written ng_vbin_hw, checked
// byte for byte against the table by nat_vsel_check under FID_VERIFY=1),
// the others by hand. Targets: x86-64 always (SSE2 16 bytes; AVX2 32
// bytes under --cpu x86-64-v3|v4), AArch64 always (NEON), RISC-V under
// --cpu rva23u64 or rv64gcv (V 1.0 at VL = 2 x e64, which every VLEN >=
// 128 has). `FID_NAT_OFF=simd`: the intrinsics stay calls.
// ===========================================================================

const NG_RC_VEC: i64 = 8;

/// RISC-V with the V extension (RVA23 makes it mandatory).
fn ng_rv_v(g: &NatGen) -> bool {
    return g.arch == NAT_RV64 && (g_nat_cpu == "rva23u64" || g_nat_cpu == "rv64gcv");
}

/// TG11: 32-byte vectors, x86-64 AVX2 (--cpu x86-64-v3|v4).
fn ng_x64_avx2(g: &NatGen) -> bool {
    return ng_x64(g) && (g_nat_cpu == "x86-64-v3" || g_nat_cpu == "x86-64-v4");
}

/// TG11: the target has the vector operations (x86-64 on every OS: --nat
/// Windows too since MI14, see the section's comment).
fn ng_vec_has(g: &NatGen) -> bool {
    if ng_x64(g) {
        return true;
    }
    if ng_a64(g) {
        return true;
    }
    return ng_rv_v(g);
}

/// TG11: how many registers of the vector class the operations may name.
fn ng_vec_nregs(g: &NatGen) -> i64 {
    return 4;
}

/// TG11: the physical register of vector-class register k (its number in
/// the vector register file).
fn ng_vphys(g: &NatGen, k: i64) -> i64 {
    if ng_x64(g) {
        // (--nat Windows too since MI14: xmm12..xmm15)
        return 12 + k;
    }
    if ng_a64(g) {
        return 28 + k;
    }
    return 1 + k;
}

/// TG11: "" when no register of the vector class is one the allocator
/// may hand out (the float pool, MI25) or a float scratch register, else
/// what overlaps (ng_vec_verify, FID_VERIFY=1).
fn ng_vec_class_check(g: &NatGen) -> str {
    var regs: Vec<i64> = ng_vec_class_regs(g);
    var k: i64 = 0;
    while k < regs.len() {
        var x: i64 = regs.get(k);
        if g.arch != NAT_RV64 {
            // RISC-V's V registers are a file of their own
            if ng_class_has(g, NG_RC_FLOAT, NG_FREG + x) {
                return "vector register " + int_to_str(x) + " is in the float pool";
            }
            var s: i64 = 0;
            while s < g.td.float_scratch.len() {
                if g.td.float_scratch.get(s) == x {
                    return "vector register " + int_to_str(x) + " is a float scratch register";
                }
                s = s + 1;
            }
        }
        k = k + 1;
    }
    return "";
}

/// TG11: the vector class's registers, physical numbers in the vector
/// register file (none of them allocatable: see the section's comment).
fn ng_vec_class_regs(g: &NatGen) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < ng_vec_nregs(g) {
        v.push(ng_vphys(g, k));
        k = k + 1;
    }
    return v;
}

/// RISC-V: VL = 2 elements of 64 bits (vsetvli x0, ad2, e64, m1, ta, ma
/// with ad2 = 2); ad2 never holds a value.
fn ng_rv_vset(g: &mut NatGen) {
    rv_addi(&mut g.e, g.ad2, 0, 2);
    rv_vsetvli(&mut g.e, 0, g.ad2, 0xD8);
}

/// The register holding base + disp for a vector access (AArch64 and
/// RISC-V): base itself, else ad (which never holds a value).
fn ng_vaddr(g: &mut NatGen, base: i64, disp: i64) -> i64 {
    if disp == 0 {
        return base;
    }
    if ng_a64(g) {
        a64_li(&mut g.e, g.ad, disp);
        a64_add(&mut g.e, g.ad, g.ad, base);
    } else {
        rv_li(&mut g.e, g.ad, disp);
        rv_add(&mut g.e, g.ad, g.ad, base);
    }
    return g.ad;
}

/// MO_VLD: vector register k = the w bytes at base + disp (unaligned).
fn ng_vld(g: &mut NatGen, k: i64, base: i64, disp: i64, w: i64) {
    if g.rec {
        ng_rec(g, MO_VLD, 0, base, 0, disp, w, k);
        return;
    }
    var x: i64 = ng_vphys(g, k);
    if ng_x64(g) {
        if w == 32 {
            x64_vvld(&mut g.e, x, base, disp, true);
        } else {
            x64_vld(&mut g.e, x, base, disp);
        }
        return;
    }
    if ng_a64(g) && disp >= 0 && disp < 65536 && (disp & 15) == 0 {
        a64_ldr_q(&mut g.e, x, base, disp);
        return;
    }
    var b: i64 = ng_vaddr(g, base, disp);
    if ng_a64(g) {
        a64_ldr_q(&mut g.e, x, b, 0);
        return;
    }
    ng_rv_vset(g);
    rv_vle(&mut g.e, x, b, 64);
}

/// MO_VST: the w bytes at base + disp = vector register k.
fn ng_vst(g: &mut NatGen, base: i64, disp: i64, k: i64, w: i64) {
    if g.rec {
        ng_rec(g, MO_VST, base, 0, 0, disp, w, k);
        return;
    }
    var x: i64 = ng_vphys(g, k);
    if ng_x64(g) {
        if w == 32 {
            x64_vvst(&mut g.e, base, disp, x, true);
        } else {
            x64_vst(&mut g.e, base, disp, x);
        }
        return;
    }
    if ng_a64(g) && disp >= 0 && disp < 65536 && (disp & 15) == 0 {
        a64_str_q(&mut g.e, x, base, disp);
        return;
    }
    var b: i64 = ng_vaddr(g, base, disp);
    if ng_a64(g) {
        a64_str_q(&mut g.e, x, b, 0);
        return;
    }
    ng_rv_vset(g);
    rv_vse(&mut g.e, x, b, 64);
}

/// MO_VBIN: vector register d = d op b (op an NVK_* kind of nat_enc.fd).
fn ng_vbin(g: &mut NatGen, kind: i64, d: i64, b: i64, w: i64) {
    if g.rec {
        ng_rec(g, MO_VBIN, 0, 0, 0, kind, w, d | (b << 4));
        return;
    }
    ng_vbin_hw(g, kind, ng_vphys(g, d), ng_vphys(g, b), w);
}

/// MO_VBIN's hand-written selection (FID_NAT_OFF=isel), on physical
/// vector registers: the same instructions as the table's rows.
fn ng_vbin_hw(g: &mut NatGen, kind: i64, d: i64, b: i64, w: i64) {
    if ng_x64(g) {
        if w == 32 {
            x64_vvec(&mut g.e, kind, d, d, b, true);
        } else {
            x64_vec(&mut g.e, kind, d, b);
        }
        return;
    }
    if ng_a64(g) {
        a64_vec(&mut g.e, kind, d, d, b);
        return;
    }
    ng_rv_vset(g);
    rv_vec(&mut g.e, kind, d, d, b);
}

/// MO_VSPLAT: every 64-bit lane of vector register k = r (a general
/// register holding the bits, or an allocated float register, MI25).
fn ng_vsplat(g: &mut NatGen, k: i64, r: i64, w: i64) {
    if g.rec {
        ng_rec(g, MO_VSPLAT, 0, r, 0, 0, w, k);
        return;
    }
    var x: i64 = ng_vphys(g, k);
    var fr: bool = ng_is_freg(g, r);
    var f: i64 = r - NG_FREG;
    if ng_x64(g) {
        if fr {
            if w == 32 {
                x64_vpbroadcastq(&mut g.e, x, f, true);
            } else {
                x64_pshufd(&mut g.e, x, f, 0x44);
            }
            return;
        }
        x64_movq_xr(&mut g.e, x, r, true);
        if w == 32 {
            x64_vpbroadcastq(&mut g.e, x, x, true);
        } else {
            x64_punpcklqdq(&mut g.e, x, x);
        }
        return;
    }
    if ng_a64(g) {
        if fr {
            a64_dup_elem_2d(&mut g.e, x, f, 0);
        } else {
            a64_dup_2d(&mut g.e, x, r);
        }
        return;
    }
    ng_rv_vset(g);
    if fr {
        rv_vfmv_v_f(&mut g.e, x, f);
    } else {
        rv_vmv_v_x(&mut g.e, x, r);
    }
}

/// MO_VLANE: d = 64-bit lane `lane` (0 or 1) of vector register k; lane 1
/// passes through vector register t on x86-64 and RISC-V (t != k). d is a
/// general register or an allocated float register (MI25).
fn ng_vlane(g: &mut NatGen, d: i64, k: i64, lane: i64, t: i64, w: i64) {
    if g.rec {
        ng_rec(g, MO_VLANE, d, 0, 0, lane, w, k | (t << 4));
        return;
    }
    var x: i64 = ng_vphys(g, k);
    var tx: i64 = ng_vphys(g, t);
    var fr: bool = ng_is_freg(g, d);
    var f: i64 = d - NG_FREG;
    if ng_x64(g) {
        if fr {
            if lane == 0 {
                x64_pshufd(&mut g.e, f, x, 0x44);
            } else {
                x64_pshufd(&mut g.e, f, x, 0xEE);
            }
            return;
        }
        if lane == 0 {
            x64_movq_rx(&mut g.e, d, x, true);
            return;
        }
        x64_pshufd(&mut g.e, tx, x, 0xEE);
        x64_movq_rx(&mut g.e, d, tx, true);
        return;
    }
    if ng_a64(g) {
        if fr {
            a64_dup_d_elem(&mut g.e, f, x, lane);
        } else {
            a64_umov_d(&mut g.e, d, x, lane);
        }
        return;
    }
    ng_rv_vset(g);
    var src: i64 = x;
    if lane != 0 {
        rv_vslidedown_vi(&mut g.e, tx, x, lane);
        src = tx;
    }
    if fr {
        rv_vfmv_f_s(&mut g.e, f, src);
    } else {
        rv_vmv_x_s(&mut g.e, d, src);
    }
}

/// MO_VZMASK: the f64 lanes of vector register d zeroed where the lanes of
/// vector register b are +0.0 or -0.0 (NaN keeps its lane: the runtime's
/// `if d != 0.0`); vector register t is clobbered (t, d, b distinct).
/// Registers only: a legacy SSE compare with a memory operand would fault
/// on a buffer that is not 16-byte aligned. x86-64 pxor t + cmpneqpd t, b
/// (0 != y) + pand d, t (VEX three-operand forms at 32 bytes); AArch64
/// fcmeq t, b, #0.0 + bic d, d, t; RISC-V vsll.vi t, b, 1 (the sign out)
/// + vmseq.vi v0, t, 0 + vmerge.vim d, d, 0.
fn ng_vzmask(g: &mut NatGen, d: i64, b: i64, t: i64, w: i64) {
    if g.rec {
        ng_rec(g, MO_VZMASK, 0, 0, 0, 0, w, d | (b << 4) | (t << 8));
        return;
    }
    var dx: i64 = ng_vphys(g, d);
    var bx: i64 = ng_vphys(g, b);
    var tx: i64 = ng_vphys(g, t);
    if ng_x64(g) {
        if w == 32 {
            x64_vvec(&mut g.e, NVK_XOR, tx, tx, tx, true);
            x64_vcmppd(&mut g.e, tx, tx, bx, 4, true);
            x64_vvec(&mut g.e, NVK_AND, dx, dx, tx, true);
        } else {
            x64_vec(&mut g.e, NVK_XOR, tx, tx);
            x64_cmppd(&mut g.e, tx, bx, 4);
            x64_vec(&mut g.e, NVK_AND, dx, tx);
        }
        return;
    }
    if ng_a64(g) {
        a64_fcmeq_zero_2d(&mut g.e, tx, bx);
        a64_bic_16b(&mut g.e, dx, dx, tx);
        return;
    }
    ng_rv_vset(g);
    rv_vsll_vi(&mut g.e, tx, bx, 1);
    rv_vmseq_vi(&mut g.e, 0, tx, 0);
    rv_vmerge_vim(&mut g.e, dx, dx, 0);
}

/// OP23: MO_VBTEST — r0 = the byte test `mode` of V[a], V[b] (x86-64;
/// pcmpeqb / pmovmskb and the integer test all land in r0 itself, so no
/// scratch is taken). mode 0: every byte of a equals b's; 1: any byte
/// does; 2: any byte of a is zero (b ignored).
fn ng_vbtest_hw(g: &mut NatGen, r0: i64, a: i64, b: i64, mode: i64, w: i64) {
    var full: i64 = 65535;
    if w == 32 {
        full = 0 - 1;
    }
    if mode == 2 {
        // b = 0, then the ordinary byte-equality of a with it
        NatEnc_byte(&mut g.e, 0x66);
        x64_rex(&mut g.e, false, b, 0, b, false);
        NatEnc_byte(&mut g.e, 0x0F);
        NatEnc_byte(&mut g.e, 0xEF);
        x64_modrm_rr(&mut g.e, b, b);
    }
    // pcmpeqb a, b (per-byte 0xFF where equal)
    NatEnc_byte(&mut g.e, 0x66);
    x64_rex(&mut g.e, false, b, 0, a, false);
    NatEnc_byte(&mut g.e, 0x0F);
    NatEnc_byte(&mut g.e, 0x74);
    x64_modrm_rr(&mut g.e, b, a);
    // pmovmskb r0, a (two mask bits per byte, zero-extended)
    NatEnc_byte(&mut g.e, 0x66);
    x64_rex(&mut g.e, false, r0, 0, a, false);
    NatEnc_byte(&mut g.e, 0x0F);
    NatEnc_byte(&mut g.e, 0xD7);
    x64_modrm_rr(&mut g.e, r0, a);
    if mode == 0 {
        // cmp r0, 0xFFFF/0xFFFFFFFF: every byte equal
        x64_rex(&mut g.e, false, 0, 0, r0, false);
        NatEnc_byte(&mut g.e, 0x81);
        x64_modrm_rr(&mut g.e, 7, r0);
        var k: i64 = 0;
        while k < 4 {
            NatEnc_byte(&mut g.e, (full >> (k * 8)) & 255);
            k = k + 1;
        }
        x64_setcc(&mut g.e, 4, r0);
    } else {
        x64_test(&mut g.e, r0, r0);
        x64_setcc(&mut g.e, 5, r0);
    }
    // movzx r0, r0's low byte (the boolean)
    x64_rex(&mut g.e, false, r0, 0, r0, false);
    NatEnc_byte(&mut g.e, 0x0F);
    NatEnc_byte(&mut g.e, 0xB6);
    x64_modrm_rr(&mut g.e, r0, r0);
}

/// OP23: r0 = the byte test `mode` of vector registers a, b (MO_VBTEST;
/// x86-64 only, ng_vbtest_ok).
fn ng_vbtest(g: &mut NatGen, r0: i64, a: i64, b: i64, mode: i64, w: i64) {
    if g.rec {
        ng_rec(g, MO_VBTEST, r0, 0, 0, mode, w, a | (b << 4));
        return;
    }
    ng_vbtest_hw(g, r0, ng_vphys(g, a), ng_vphys(g, b), mode, w);
}

/// OP23: this target encodes MO_VBTEST (x86-64; AArch64 and RVV keep the
/// word SWAR of the runtime routines).
fn ng_vbtest_ok(g: &NatGen) -> bool {
    return ng_x64(g);
}

/// MO_VEND: after 256-bit code, VZEROUPPER (x86-64), so that the SSE code
/// after it pays no state transition; nothing elsewhere.
fn ng_vend(g: &mut NatGen, w: i64) {
    if g.rec {
        ng_rec(g, MO_VEND, 0, 0, 0, 0, w, 0);
        return;
    }
    if ng_x64(g) && w == 32 {
        x64_vzeroupper(&mut g.e);
    }
}

/// The replay of a vector operation (ng_mi_dispatch): p0 / p1 the physical
/// registers of r0 / r1.
fn ng_vec_dispatch(g: &mut NatGen, m: MInst, p0: i64, p1: i64) {
    var op: i64 = m.op;
    if op == MO_VLD {
        ng_vld(g, m.i2, p1, m.i0, m.i1);
        return;
    }
    if op == MO_VST {
        ng_vst(g, p0, m.i0, m.i2, m.i1);
        return;
    }
    if op == MO_VBIN {
        var d: i64 = ng_vphys(g, m.i2 & 15);
        var b: i64 = ng_vphys(g, m.i2 >> 4);
        if ng_isel(g, MO_VBIN, d, d, b, m.i0 | (m.i1 << 8)) {
            return;
        }
        ng_vbin_hw(g, m.i0, d, b, m.i1);
        return;
    }
    if op == MO_VSPLAT {
        ng_vsplat(g, m.i2, p1, m.i1);
        return;
    }
    if op == MO_VLANE {
        ng_vlane(g, p0, m.i2 & 15, m.i0, m.i2 >> 4, m.i1);
        return;
    }
    if op == MO_VZMASK {
        ng_vzmask(g, m.i2 & 15, (m.i2 >> 4) & 15, (m.i2 >> 8) & 15, m.i1);
        return;
    }
    if op == MO_VBTEST {
        ng_vbtest_hw(g, p0, ng_vphys(g, m.i2 & 15), ng_vphys(g, m.i2 >> 4), m.i0, m.i1);
        return;
    }
    if op == MO_VEND {
        ng_vend(g, m.i1);
    }
}

/// The MIR verifier's checks of a vector operation (ng_mir_verify): ""
/// when it is well formed.
fn ng_vec_verify(g: &NatGen, m: MInst) -> str {
    var op: i64 = m.op;
    var w: i64 = m.i1;
    if w != 16 && !(w == 32 && ng_x64(g)) {
        return "vector width " + int_to_str(w);
    }
    if !ng_vec_has(g) {
        return "a vector operation on a target without vectors";
    }
    var cerr: str = ng_vec_class_check(g);
    if cerr != "" {
        return cerr;
    }
    var nr: i64 = ng_vec_nregs(g);
    var a: i64 = m.i2 & 15;
    var b: i64 = (m.i2 >> 4) & 15;
    var t: i64 = (m.i2 >> 8) & 15;
    if op == MO_VLD || op == MO_VST || op == MO_VSPLAT {
        if m.i2 < 0 || m.i2 >= nr {
            return "vector register " + int_to_str(m.i2);
        }
        return "";
    }
    if op == MO_VEND {
        return "";
    }
    if m.i2 < 0 || a >= nr || b >= nr {
        return "vector registers " + int_to_str(a) + ", " + int_to_str(b);
    }
    if op == MO_VZMASK {
        if (m.i2 >> 12) != 0 || t >= nr || t == a || t == b || a == b {
            return "zero mask registers d " + int_to_str(a) + ", b " + int_to_str(b) + ", scratch " + int_to_str(t);
        }
        return "";
    }
    if op == MO_VBTEST {
        if m.i0 < 0 || m.i0 > 2 {
            return "byte test mode " + int_to_str(m.i0);
        }
        if !ng_vbtest_ok(g) {
            return "a byte test on a target without its encoder";
        }
        if m.i0 != 2 && a == b {
            return "byte test of one register " + int_to_str(a);
        }
        return "";
    }
    if (m.i2 >> 8) != 0 {
        return "vector register field " + int_to_str(m.i2);
    }
    if op == MO_VBIN {
        if m.i0 < 0 || m.i0 > NVK_LAST {
            return "vector operation " + int_to_str(m.i0);
        }
        if g.arch == NAT_RV64 && (m.i0 == NVK_ADD32 || m.i0 == NVK_SUB32 || m.i0 == NVK_MUL32) {
            // VSETVLI sets 64-bit elements
            return "32-bit lanes under e64 (vector operation " + int_to_str(m.i0) + ")";
        }
        return "";
    }
    if op == MO_VLANE && (m.i0 < 0 || m.i0 > 1 || (m.i0 == 1 && a == b)) {
        return "lane " + int_to_str(m.i0) + " through register " + int_to_str(b);
    }
    return "";
}

/// TG11: MO_VBIN's selection table and its hand-written selection agree
/// byte for byte on every kind, width and a few register pairs of the
/// target (run with nat_sel_check under FID_VERIFY=1).
pub fn nat_vsel_check(arch: i64) -> str {
    if !ng_isel_on() {
        return "";
    }
    var g0: NatGen = NatGen_new(arch);
    var widths: Vec<i64> = Vec::new();
    widths.push(16);
    if ng_x64(&g0) {
        widths.push(32);
    }
    var nr: i64 = ng_vec_nregs(&g0);
    var wi: i64 = 0;
    while wi < widths.len() {
        var w: i64 = widths.get(wi);
        var kind: i64 = 0;
        while kind <= NVK_LAST {
            var d: i64 = 0;
            while d < nr {
                var b: i64 = 0;
                while b < nr {
                    var m: MInst = MInst {
                        op: MO_VBIN, r0: 0, r1: 0, r2: 0, i0: kind, i1: w, i2: d | (b << 4)
                    };
                    var ga: NatGen = NatGen_new(arch);
                    ga.rec = false;
                    ng_mi_dispatch(&mut ga, m, 0, 0, 0);
                    g_ng_isel_state = 2;
                    var gb: NatGen = NatGen_new(arch);
                    gb.rec = false;
                    ng_mi_dispatch(&mut gb, m, 0, 0, 0);
                    g_ng_isel_state = 1;
                    var same: bool = ga.e.code.len() == gb.e.code.len() && ga.e.code.len() > 0;
                    var q: i64 = 0;
                    while same && q < ga.e.code.len() {
                        if ga.e.code.get(q) != gb.e.code.get(q) {
                            same = false;
                        }
                        q = q + 1;
                    }
                    if !same {
                        return "TG11: the selection table and the hand-written selection differ on vbin kind=" + int_to_str(kind) + " w=" + int_to_str(w) + " d=" + int_to_str(d) + " b=" + int_to_str(b);
                    }
                    b = b + 1;
                }
                d = d + 1;
            }
            kind = kind + 1;
        }
        wi = wi + 1;
    }
    return "";
}

/// d = base + i * 8, the address of f64 element i (MI22's ADDSHL).
fn ng_simd_elem(g: &mut NatGen, d: i64, base: i64, i: i64) {
    if ng_on("addshl") {
        ng_addshl(g, d, base, i, 3);
    } else {
        ng_li(g, d, 3);
        ng_shl(g, d, i, d);
        ng_add(g, d, base, d);
    }
}

/// d = core function `name`(__env = 0, a): one argument.
fn ng_simd_core_call(g: &mut NatGen, d: i64, name: str, a: i64, nargs: i64) {
    var ic: bool = ng_internal(g, name);
    ng_li(g, ng_argreg_i(g, 0, ic), 0);
    if nargs > 0 {
        ng_mov(g, ng_argreg_i(g, 1, ic), a);
    }
    ng_emit_call(g, name);
    ng_mov(g, d, ng_argreg(g, 0));
}

/// OP21: the vector kind (NVK_*) of the simd module's Vec<i64> function
/// `name` (stdlib/simd.fd simd_lanes_*_i64: wrapping 64-bit lanes), -1 for
/// any other name.
fn ng_simd_i64_kind(name: str) -> i64 {
    if name == "simd_lanes_add_i64" {
        return NVK_ADD64;
    }
    if name == "simd_lanes_sub_i64" {
        return NVK_SUB64;
    }
    if name == "simd_lanes_and_i64" {
        return NVK_AND;
    }
    if name == "simd_lanes_or_i64" {
        return NVK_OR;
    }
    if name == "simd_lanes_xor_i64" {
        return NVK_XOR;
    }
    return 0 - 1;
}

/// OP21: type `t` is Vec<i64> (a value whose type was not kept, a plain
/// word, is left a call: a same-named function over integers must not be
/// read as Vec headers).
fn ng_simd_i64_ty(t: IrType) -> bool {
    match t {
        IrType::Generic(n, targs) => {
            if n == "Vec" && targs.len() == 1 {
                match targs.get(0) {
                    IrType::I64 => {
                        return true;
                    }
                    _ => {
                    }
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// OP21: call `id`'s last two arguments and its result are Vec<i64> (a
/// function of the same name with other types is left a call).
fn ng_simd_i64_args(func: &IrFunction, id: i64, args: Vec<i64>) -> bool {
    var na: i64 = args.len();
    if na < 2 {
        return false;
    }
    if !ng_simd_i64_ty(ng_meta_ty(func, args.get(na - 2))) || !ng_simd_i64_ty(ng_meta_ty(func, args.get(na - 1))) {
        return false;
    }
    return ng_simd_i64_ty(ng_meta_ty(func, id));
}

/// OP21: d = a op b for an integer vector kind (the scalar loop of the
/// Vec<i64> functions), wrapping at 64 bits like the lanes.
fn ng_simd_iop(g: &mut NatGen, kind: i64, d: i64, a: i64, b: i64) {
    if kind == NVK_SUB64 {
        ng_sub(g, d, a, b);
    } else if kind == NVK_AND {
        ng_and(g, d, a, b);
    } else if kind == NVK_OR {
        ng_or(g, d, a, b);
    } else if kind == NVK_XOR {
        ng_xor(g, d, a, b);
    } else {
        ng_add(g, d, a, b);
    }
}

/// OP23: stdlib/linux_runtime pert_vblk_copy(dst, src, n) (8-aligned, no
/// overlap; copies n & ~15 bytes, returns that count) as 16-byte MO_VLD /
/// MO_VST steps. FID_NAT_OFF=simd keeps the call. The call passes __env
/// first: the three arguments are the last ones. pert_vblk_diff, _cmpz and
/// _find can follow once nat_enc has a byte compare with mask extraction
/// (x86 pcmpeqb / pmovmskb, NEON cmeq.16b + umaxv, RVV vmseq + vfirst.m).
fn ng_vblk_call(g: &mut NatGen, id: i64, name: str, args: Vec<i64>, _func: &IrFunction) -> bool {
    if name != "pert_vblk_copy" || !g.rec || !ng_on("simd") || g_nat_size || !ng_vec_has(g) || args.len() < 3 {
        return false;
    }
    var k: i64 = args.len();
    var d: i64 = ng_new_vreg(g);
    var s: i64 = ng_new_vreg(g);
    var n: i64 = ng_new_vreg(g);
    var m: i64 = ng_new_vreg(g);
    var off: i64 = ng_new_vreg(g);
    var t: i64 = ng_new_vreg(g);
    var c: i64 = ng_new_vreg(g);
    // the addresses in vregs of their own (one register class each: MI25)
    var ax: i64 = ng_new_vreg(g);
    var ay: i64 = ng_new_vreg(g);
    var vloop: i64 = NatEnc_label(&mut g.e);
    var vexit: i64 = NatEnc_label(&mut g.e);
    ng_ld_val(g, d, args.get(k - 3));
    ng_ld_val(g, s, args.get(k - 2));
    ng_ld_val(g, n, args.get(k - 1));
    // m = n & ~15, off = 0
    ng_li(g, t, 0 - 16);
    ng_and(g, m, n, t);
    ng_li(g, off, 0);
    // while off < m: 16 bytes from s + off to d + off
    ng_place(g, vloop);
    ng_setcc(g, c, off, m, NCC_LT);
    ng_beqz(g, c, vexit);
    ng_add(g, ax, s, off);
    ng_vld(g, 0, ax, 0, 16);
    ng_add(g, ay, d, off);
    ng_vst(g, ay, 0, 0, 16);
    ng_li(g, t, 16);
    ng_add(g, off, off, t);
    ng_jmp(g, vloop);
    ng_place(g, vexit);
    ng_vend(g, 16);
    ng_st_val(g, id, m);
    return true;
}

/// OP23 (Nov 21 evening): pert_vblk_diff / _cmpz / _find lowered as a
/// 16-byte block loop with MO_VBTEST: the offset of the first block whose
/// test fires, m = n & ~15 when none does — the routines' own contract.
/// diff(a, b, n): a block that differs; cmpz(a, b, n): a block where a
/// and b differ or a holds a zero byte; find(p, n, byte): a block that
/// holds the byte (replicated to all 16 and matched per byte).
fn ng_vblk_search(g: &mut NatGen, id: i64, name: str, args: Vec<i64>) {
    var k: i64 = args.len();
    var pa: i64 = ng_new_vreg(g);
    var pb: i64 = ng_new_vreg(g);
    var n: i64 = ng_new_vreg(g);
    var m: i64 = ng_new_vreg(g);
    var off: i64 = ng_new_vreg(g);
    var t: i64 = ng_new_vreg(g);
    var c: i64 = ng_new_vreg(g);
    var tv: i64 = ng_new_vreg(g);
    var res: i64 = ng_new_vreg(g);
    var rep: i64 = ng_new_vreg(g);
    var ax: i64 = ng_new_vreg(g);
    var bx: i64 = ng_new_vreg(g);
    var vloop: i64 = NatEnc_label(&mut g.e);
    var vfound: i64 = NatEnc_label(&mut g.e);
    var vdone: i64 = NatEnc_label(&mut g.e);
    if name == "pert_vblk_find" {
        // find(p, n, b)
        ng_ld_val(g, pa, args.get(k - 3));
        ng_ld_val(g, n, args.get(k - 2));
        ng_ld_val(g, t, args.get(k - 1));
        ng_li(g, c, 255);
        ng_and(g, rep, t, c);
        ng_li(g, c, 72340172838076673);
        ng_mul(g, rep, rep, c);
        ng_vsplat(g, 1, rep, 16);
    } else {
        // diff(a, b, n) / cmpz(a, b, n)
        ng_ld_val(g, pa, args.get(k - 3));
        ng_ld_val(g, pb, args.get(k - 2));
        ng_ld_val(g, n, args.get(k - 1));
    }
    ng_li(g, t, 0 - 16);
    ng_and(g, m, n, t);
    ng_li(g, off, 0);
    ng_mov(g, res, m);
    ng_place(g, vloop);
    ng_setcc(g, c, off, m, NCC_LT);
    ng_beqz(g, c, vdone);
    ng_add(g, ax, pa, off);
    ng_vld(g, 0, ax, 0, 16);
    if name == "pert_vblk_find" {
        // any byte of the block equals the replicated one
        ng_vbtest(g, tv, 0, 1, 1, 16);
        ng_beqz(g, tv, vfound);
    } else {
        if name == "pert_vblk_diff" {
            ng_add(g, bx, pb, off);
            ng_vld(g, 1, bx, 0, 16);
            ng_vbtest(g, tv, 0, 1, 0, 16);
            ng_beqz(g, tv, vfound);
        } else {
            // cmpz: the blocks differ, or a holds a zero byte (mode 2
            // reads the first register only)
            ng_add(g, bx, pb, off);
            ng_vld(g, 1, bx, 0, 16);
            ng_vbtest(g, tv, 0, 1, 0, 16);
            ng_beqz(g, tv, vfound);
            ng_vbtest(g, tv, 0, 1, 2, 16);
            ng_beqz(g, tv, vfound);
        }
    }
    ng_li(g, t, 16);
    ng_add(g, off, off, t);
    ng_jmp(g, vloop);
    ng_place(g, vfound);
    ng_mov(g, res, off);
    ng_place(g, vdone);
    ng_vend(g, 16);
    ng_st_val(g, id, res);
}

/// OP21 / TG11: the f64 intrinsics of stdlib/simd.fd as vector loops on
/// the machine IR's vector operations: p_simd_add, _sub, _mul, _div
/// (elementwise, a fresh Vec of a's length), p_simd_scale (a * k, k
/// splat into a vector register once) and p_simd_dot (products in vectors,
/// summed lane by lane in the runtime's order, so the result is the same
/// bits as pert_simd_dot's). The common case in place: a and b plain Vecs
/// of 8-byte elements (code word 0), b at least as long as a; anything
/// else is the runtime's function (pert_simd_*: b shorter panics there as
/// before). The result Vec is built as Vec_new + vec_buf_alloc of n
/// words, len = cap = n. A vector loop of w / 8 lanes, then a scalar loop
/// over the rest. Division keeps pert_simd_div's `x / 0 is 0`
/// (MO_VZMASK). Integer lanes (mode 3): the module's Vec<i64> functions
/// simd_lanes_add/sub/and/or/xor_i64, Fides loops wrapping at 64 bits
/// (paddq / add .2d / vadd.vv and the bitwise forms), taken only when both
/// arguments and the result are typed Vec<i64>; their slow path is the
/// Fides function itself (a shorter b panics there). False: the call is
/// not one of them, or the target has no vectors (the caller emits the
/// call).
fn ng_simd_call(g: &mut NatGen, id: i64, name: str, args: Vec<i64>, func: &IrFunction) -> bool {
    if !g.rec || !ng_on("simd") || g_nat_size || !ng_vec_has(g) || func.is_constant_time {
        return false;
    }
    var kind: i64 = 0 - 1;
    var fop: i64 = 0;
    // 0: a op b elementwise, 1: a * splat(k), 2: the dot product,
    // 3: a op b elementwise on i64 lanes (wrapping), fop the integer op
    var mode: i64 = 0;
    if str_starts_with(name, "simd_lanes_") {
        // OP21: the simd module's Vec<i64> functions (Fides loops; their
        // call passes __env first)
        if (args.len() != 2 && args.len() != 3) || !ng_simd_i64_args(func, id, args) {
            return false;
        }
        kind = ng_simd_i64_kind(name);
        if kind < 0 {
            return false;
        }
        mode = 3;
        fop = kind;
    } else if !str_starts_with(name, "p_simd_") || args.len() != 2 {
        return false;
    }
    var a0: i64 = args.get(args.len() - 2);
    var a1: i64 = args.get(args.len() - 1);
    if name == "p_simd_add" {
        kind = NVK_FADD64;
        fop = 1;
    }
    if name == "p_simd_sub" {
        kind = NVK_FSUB64;
        fop = 2;
    }
    if name == "p_simd_mul" {
        kind = NVK_FMUL64;
        fop = 3;
    }
    if name == "p_simd_div" {
        kind = NVK_FDIV64;
        fop = 4;
    }
    if name == "p_simd_scale" {
        kind = NVK_FMUL64;
        fop = 3;
        mode = 1;
    }
    if name == "p_simd_dot" {
        kind = NVK_FMUL64;
        fop = 3;
        mode = 2;
    }
    if kind < 0 {
        return false;
    }
    if mode != 2 && (!ng_has_fn(g, "Vec_new") || !ng_has_fn(g, "vec_buf_alloc")) {
        return false;
    }
    var w: i64 = 16;
    if mode != 2 && ng_x64_avx2(g) {
        w = 32;
    }
    var lanes: i64 = w / 8;
    var va: i64 = ng_new_vreg(g);
    var vb: i64 = ng_new_vreg(g);
    var kv: i64 = ng_new_vreg(g);
    var n: i64 = ng_new_vreg(g);
    var t: i64 = ng_new_vreg(g);
    var c: i64 = ng_new_vreg(g);
    var pa: i64 = ng_new_vreg(g);
    var pb: i64 = ng_new_vreg(g);
    var pr: i64 = ng_new_vreg(g);
    var r: i64 = ng_new_vreg(g);
    var i: i64 = ng_new_vreg(g);
    var lim: i64 = ng_new_vreg(g);
    // addresses (ax, ay) and float values (x, y, s, z) in vregs of their
    // own, so that each has one register class (MI25)
    var ax: i64 = ng_new_vreg(g);
    var ay: i64 = ng_new_vreg(g);
    var x: i64 = ng_new_vreg(g);
    var y: i64 = ng_new_vreg(g);
    var s: i64 = ng_new_vreg(g);
    var z: i64 = ng_new_vreg(g);
    var slow: i64 = NatEnc_label(&mut g.e);
    var done: i64 = NatEnc_label(&mut g.e);
    var have: i64 = NatEnc_label(&mut g.e);
    var vloop: i64 = NatEnc_label(&mut g.e);
    var vexit: i64 = NatEnc_label(&mut g.e);
    var sloop: i64 = NatEnc_label(&mut g.e);
    var sexit: i64 = NatEnc_label(&mut g.e);
    var keep: i64 = NatEnc_label(&mut g.e);
    // a: 8-byte elements, its length and buffer
    ng_ld_val(g, va, a0);
    ng_load(g, t, va, 24, 8, false);
    ng_bnez(g, t, slow);
    ng_load(g, n, va, 8, 8, false);
    ng_load(g, pa, va, 0, 8, false);
    if mode == 1 {
        ng_ld_val(g, kv, a1);
    } else {
        // b: 8-byte elements, at least n of them
        ng_ld_val(g, vb, a1);
        ng_load(g, t, vb, 24, 8, false);
        ng_bnez(g, t, slow);
        ng_load(g, t, vb, 8, 8, false);
        ng_setcc(g, c, t, n, NCC_LT);
        ng_bnez(g, c, slow);
        ng_load(g, pb, vb, 0, 8, false);
    }
    if mode == 2 {
        // s = +0.0
        ng_li(g, s, 0);
    } else {
        // the result: n words (none for an empty a), then its header
        ng_li(g, pr, 0);
        ng_beqz(g, n, have);
        ng_li(g, t, 3);
        ng_shl(g, t, n, t);
        ng_simd_core_call(g, pr, "vec_buf_alloc", t, 1);
        ng_beqz(g, pr, slow);
        ng_place(g, have);
        ng_simd_core_call(g, r, "Vec_new", 0, 0);
        ng_store(g, r, 0, pr, 8);
        ng_store(g, r, 8, n, 8);
        ng_store(g, r, 16, n, 8);
    }
    // the vector loop: while i + lanes <= n
    ng_li(g, i, 0);
    ng_li(g, t, lanes - 1);
    ng_sub(g, lim, n, t);
    if mode == 1 {
        ng_vsplat(g, 1, kv, w);
    }
    ng_place(g, vloop);
    ng_setcc(g, c, i, lim, NCC_LT);
    ng_beqz(g, c, vexit);
    ng_simd_elem(g, ax, pa, i);
    ng_vld(g, 0, ax, 0, w);
    if mode != 1 {
        ng_simd_elem(g, ay, pb, i);
        ng_vld(g, 1, ay, 0, w);
    }
    ng_vbin(g, kind, 0, 1, w);
    if mode == 2 {
        // the products out of their lanes, then s = (s + lane 0) + lane 1,
        // the runtime's order (so the same bits as pert_simd_dot)
        ng_vlane(g, x, 0, 1, 1, w);
        ng_vlane(g, y, 0, 0, 1, w);
        ng_fbin(g, 1, s, s, y, false);
        ng_fbin(g, 1, s, s, x, false);
    } else {
        if mode != 3 && fop == 4 {
            // the quotient's lanes zeroed where the divisor (still in
            // vector register 1) is +-0.0; register 2 the scratch
            ng_vzmask(g, 0, 1, 2, w);
        }
        ng_simd_elem(g, ax, pr, i);
        ng_vst(g, ax, 0, 0, w);
    }
    ng_li(g, t, lanes);
    ng_add(g, i, i, t);
    ng_jmp(g, vloop);
    ng_place(g, vexit);
    ng_vend(g, w);
    // the scalar loop over the last n % lanes elements
    ng_place(g, sloop);
    ng_setcc(g, c, i, n, NCC_LT);
    ng_beqz(g, c, sexit);
    ng_simd_elem(g, ax, pa, i);
    ng_load(g, x, ax, 0, 8, false);
    if mode == 1 {
        ng_fbin(g, 3, x, x, kv, false);
    } else {
        ng_simd_elem(g, ay, pb, i);
        ng_load(g, y, ay, 0, 8, false);
        if mode == 3 {
            // OP21: the integer lane operation, wrapping like the vector one
            ng_simd_iop(g, fop, x, x, y);
        } else if fop == 4 {
            // x / 0 is 0 (pert_simd_div)
            ng_li(g, z, 0);
            ng_fcmp(g, c, y, z, NCC_EQ, false);
            ng_fbin(g, 4, x, x, y, false);
            ng_beqz(g, c, keep);
            ng_li(g, x, 0);
            ng_place(g, keep);
        } else {
            ng_fbin(g, fop, x, x, y, false);
        }
    }
    if mode == 2 {
        ng_fbin(g, 1, s, s, x, false);
    } else {
        ng_simd_elem(g, ay, pr, i);
        ng_store(g, ay, 0, x, 8);
    }
    ng_li(g, t, 1);
    ng_add(g, i, i, t);
    ng_jmp(g, sloop);
    ng_place(g, sexit);
    if mode == 2 {
        ng_st_val(g, id, s);
    } else {
        ng_st_val(g, id, r);
    }
    ng_jmp(g, done);
    ng_place(g, slow);
    ng_gen_call_std(g, id, name, args, func);
    ng_place(g, done);
    return true;
}

// ===========================================================================
// OP22: automatic loop vectorization
//
// A counted loop over plain 8-byte Vec<i64> / Vec<f64> elements gets a
// vector loop in front of it, emitted where its preheader jumps to the
// header (ng_gen_inst's Jump calls ng_vz_try). The loops taken:
//   header  i = load I; [n = Vec_len(V), a constant or another invariant];
//           c = i < n (signed i64); branch c, body, exit
//   body    one to four blocks in a chain (each the only way into the
//           next), the last jumping back to the header, holding only loads
//           of the counter I (the index), element reads v.get(i) / v[i],
//           lane arithmetic on them and on invariants (f64 + - * /; i64
//           & | ^, and + - where they wrap: a @wrapping function, or
//           checks.fd proved they cannot overflow), element writes
//           v.set(i, x) / v[i] = x after every read, at most one reduction
//           s = s op lane (i64 ^ | &, + where it wraps; an f64 sum is never
//           taken: its rounding depends on the order) and i = i + 1.
// Invariants: constants, parameters and values from before the loop, loads
// of locals and of parameter pointers (nothing in the loop stores to them:
// its only stores are I, the accumulator and Vec elements) and Vec_len of
// an invariant Vec. Every access is at index i, so different iterations
// never touch the same element, even when two of the Vecs are one.
//
// The vector loop runs only when, at run time, i >= 0, n >= lanes, every
// Vec holds 8-byte words (code word 0) and at least n of them, and every
// Vec written is neither shared nor owning elements (the Vec_set fast
// path's conditions): then no iteration in [i, n) can fail a bounds check,
// and doing `lanes` of them at once changes nothing but the speed. It runs
// while i + lanes <= n, then stores i (and the accumulator, its lanes
// folded in) back, and the original loop runs the rest as the scalar tail.
// Otherwise it is skipped and the loop runs as before.
//
// Vector registers: the class's four (TG11). Invariants used as lanes are
// splat once before the loop, the accumulator starts at the identity (0;
// all ones for &), lane values take free registers in order and give them
// back at their last use. A loop that needs more than four (TG11 vector
// spill slots, `FID_NAT_OFF=vzspill`: it stays scalar) is allocated again
// over up to NG_VZ_HOMES vector homes: the accumulator and the first
// splats keep vector registers 2 and 3, every other value lives in a frame
// slot of w bytes (ng_vz_vslot, room past the locals the function's record
// takes: ng_vz_frame_end), and each operation loads its operands into the
// scratch registers 0 and 1 and stores its result back (ng_vz_vget /
// ng_vz_vput). 32-byte vectors under AVX2 (--cpu
// x86-64-v3|v4) unless there is a reduction (MO_VLANE reads lanes 0 and 1
// only); 16 bytes otherwise (SSE2, NEON, RVV at VL = 2 x e64).
//
// `FID_NAT_OFF=vectorize`: none. `--stats` or FID_NAT_ON=vzdump: a line per
// counted loop on stderr, `[vectorize] <fn>: bb<header> ...`, taken (with
// its width, reads, writes, splats and reduction) or why not.
//
// K10, `@simd` (IrFunction.is_simd; FID_NAT_OFF=vzsimd: such a function is
// treated as any other): its loops also take a checked i64 + or - whose
// operands are element reads or invariants, and a checked i64 + reduction
// of an element read (ng_vz_simd_kind). A pre-scan before the vector loop
// (ng_vz_guard) proves that none of them can overflow (every element they
// read and every invariant operand within 2^31, the accumulator's start
// within 2^61, fewer than 2^30 iterations) or skips the vector loop, so no
// panic is lost and the results are the scalar loop's. Its vector loop is
// also unrolled twice (FID_NAT_OFF=vzunroll: not): two vectors a trip,
// then one, then the scalar tail.
// ===========================================================================

// What a loop instruction is to the vectorizer (NgVz.cls)
const NG_VZ_INV: i64 = 1;
const NG_VZ_IDX: i64 = 2;
const NG_VZ_LANE: i64 = 3;
const NG_VZ_ACC: i64 = 4;
const NG_VZ_RED: i64 = 5;
const NG_VZ_INC: i64 = 6;
const NG_VZ_CMP: i64 = 7;
const NG_VZ_SET: i64 = 8;
const NG_VZ_STI: i64 = 9;
const NG_VZ_STS: i64 = 10;
const NG_VZ_GET: i64 = 11;
// the most instructions (header and body) of a loop looked at
const NG_VZ_MAX: i64 = 128;
// TG11: the most vector homes (registers and frame slots) a loop that
// spills may use
const NG_VZ_HOMES: i64 = 16;

/// TG11: the frame of the function being generated past its locals
/// (ng_gen_function's base_frame) and the bytes of vector spill slots its
/// vectorized loops took there (ng_vz_vslot).
var g_vz_frame0: i64 = 0;
var g_vz_xbytes: i64 = 0;

/// TG11: a frame slot of w bytes (16 or 32) for a vector value, at
/// sp + the result; aligned to w (the accesses are unaligned ones anyway).
fn ng_vz_vslot(w: i64) -> i64 {
    g_vz_xbytes = (g_vz_xbytes + w - 1) & (0 - w);
    var off: i64 = ((g_vz_frame0 + 31) & (0 - 32)) + g_vz_xbytes;
    g_vz_xbytes = g_vz_xbytes + w;
    return off;
}

/// TG11: the frame past the locals once the vector spill slots are in
/// (the allocator's spill slots start there: ng_mir_alloc).
fn ng_vz_frame_end(base: i64) -> i64 {
    if g_vz_xbytes == 0 {
        return base;
    }
    return ((g_vz_frame0 + 31) & (0 - 32)) + g_vz_xbytes;
}

/// OP22: the blocks of the function being generated (ng_vz_begin): block
/// id -> index, the CFG edges into each block (by index), the function's
/// name and whether the vectorizer and its dump are on.
var g_vz_bix: Vec<i64> = Vec::new();
var g_vz_npred: Vec<i64> = Vec::new();
var g_vz_fn: str = "";
var g_vz_on: bool = false;
var g_vz_loud: bool = false;

/// OP22: a loop ng_vz_match looked at. Per instruction of the loop (the
/// header's, then the body blocks', terminators left out): its class
/// (NG_VZ_*), kind (a lane operation's or reduction's NVK_* kind; an
/// element access's index into vecs), vector register and, for a lane
/// operation, how its destination is had (0 the left operand's register,
/// 1 the right one's, the operation commuted, 2 a fresh register holding a
/// copy of the left operand).
pub struct NgVz {
    pub head: i64,
    pub islot: i64,
    pub sslot: i64,
    pub sop: i64,
    pub bound: i64,
    pub ids: Vec<i64>,
    pub cls: Vec<i64>,
    pub kind: Vec<i64>,
    pub vreg: Vec<i64>,
    pub how: Vec<i64>,
    // the distinct Vecs read or written (value ids), 1 when written
    pub vecs: Vec<i64>,
    pub vst: Vec<i64>,
    // invariants used as lanes, and their vector registers
    pub splat: Vec<i64>,
    pub sreg: Vec<i64>,
    pub acc: i64,
    pub nget: i64,
    pub nset: i64,
    pub nsti: i64,
    pub nsts: i64,
    pub nred: i64,
    pub seen_set: bool,
    pub istored: bool,
    pub w: i64,
    // TG11: the loop spills (vreg, sreg and acc then name vector homes,
    // not registers), and per home the vector register it keeps (2 or 3),
    // -1 for a frame slot
    pub spill: bool,
    pub pin: Vec<i64>,
    // K10: the function is @simd (FID_NAT_OFF=vzsimd: as any other); the
    // checked i64 + and - it let in (nchk), the Vecs (indexes into vecs)
    // whose elements the pre-scan checks, the invariants checked before
    // the loop, the reduction is a checked +
    pub simd: bool,
    pub nchk: i64,
    pub scan: Vec<i64>,
    pub ichk: Vec<i64>,
    pub redchk: bool,
}

fn ng_vz_new() -> NgVz {
    return NgVz {
        head: 0 - 1, islot: 0 - 1, sslot: 0 - 1, sop: 0 - 1, bound: 0 - 1, ids: Vec::new(), cls: Vec::new(), kind: Vec::new(), vreg: Vec::new(), how: Vec::new(), vecs: Vec::new(), vst: Vec::new(), splat: Vec::new(), sreg: Vec::new(), acc: 0 - 1, nget: 0, nset: 0, nsti: 0, nsts: 0, nred: 0, seen_set: false, istored: false, w: 16, spill: false, pin: Vec::new(), simd: false, nchk: 0, scan: Vec::new(), ichk: Vec::new(), redchk: false
    };
}

/// OP22: block id -> its index in func.blocks (-1: none).
fn ng_vz_bix(b: i64) -> i64 {
    if b < 0 || b >= g_vz_bix.len() {
        return 0 - 1;
    }
    return g_vz_bix.get(b);
}

fn ng_vz_edge(b: i64) {
    var ix: i64 = ng_vz_bix(b);
    if ix >= 0 {
        g_vz_npred.set(ix, g_vz_npred.get(ix) + 1);
    }
}

/// OP22: block index bix's last instruction (-1: an empty block).
fn ng_vz_last(func: &IrFunction, bix: i64) -> i64 {
    var blk: BasicBlock = func.blocks.get(bix);
    var nb: i64 = blk.instructions.len();
    if nb == 0 {
        return 0 - 1;
    }
    return blk.instructions.get(nb - 1);
}

/// OP22: the function's blocks and the edges into them, before its code
/// is generated (ng_gen_function).
fn ng_vz_begin(name: str, func: &IrFunction) {
    g_vz_fn = name;
    g_vz_bix = Vec::new();
    g_vz_npred = Vec::new();
    g_vz_on = ng_on("vectorize");
    g_vz_loud = g_nat_stats || ng_opt_in("vzdump");
    if !g_vz_on {
        return;
    }
    var nb: i64 = func.blocks.len();
    var maxb: i64 = 0 - 1;
    var i: i64 = 0;
    while i < nb {
        var bid: i64 = func.blocks.get(i).id;
        if bid > maxb {
            maxb = bid;
        }
        g_vz_npred.push(0);
        i = i + 1;
    }
    i = 0;
    while i <= maxb {
        g_vz_bix.push(0 - 1);
        i = i + 1;
    }
    i = 0;
    while i < nb {
        var bid2: i64 = func.blocks.get(i).id;
        if bid2 >= 0 {
            g_vz_bix.set(bid2, i);
        }
        i = i + 1;
    }
    i = 0;
    while i < nb {
        var last: i64 = ng_vz_last(func, i);
        if last >= 0 {
            match IrFunction_get_inst(func, last) {
                OptInst::Some(t) => {
                    match t {
                        Inst::Jump(jt) => {
                            ng_vz_edge(jt);
                        }
                        Inst::Branch(_, bt, be) => {
                            ng_vz_edge(bt);
                            ng_vz_edge(be);
                        }
                        Inst::Switch(_, _, sts, sdf) => {
                            var q: i64 = 0;
                            while q < sts.len() {
                                ng_vz_edge(sts.get(q));
                                q = q + 1;
                            }
                            ng_vz_edge(sdf);
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
        }
        i = i + 1;
    }
}

/// OP22: Jump id's target (-1: id is not a Jump).
fn ng_vz_jump_to(func: &IrFunction, id: i64) -> i64 {
    match IrFunction_get_inst(func, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Jump(t) => {
                    return t;
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return 0 - 1;
}

/// OP22: [cond, then, else] of Branch id (empty: not a Branch).
fn ng_vz_branch(func: &IrFunction, id: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    match IrFunction_get_inst(func, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Branch(c, t, e) => {
                    out.push(c);
                    out.push(t);
                    out.push(e);
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return out;
}

/// OP22: [l, r] of id = l < r on i64 (empty: anything else).
fn ng_vz_lt(func: &IrFunction, id: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    match IrFunction_get_inst(func, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::BinOp(op, l, r, _) => {
                    match op {
                        BinOp::Lt => {
                            if ir_type_eq(ng_meta_ty(func, l), IrType::I64) && ir_type_eq(ng_meta_ty(func, r), IrType::I64) {
                                out.push(l);
                                out.push(r);
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return out;
}

/// OP22: [l, r] of BinOp id (empty: not a BinOp).
fn ng_vz_bin_ops(func: &IrFunction, id: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    match IrFunction_get_inst(func, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::BinOp(_, l, r, _) => {
                    out.push(l);
                    out.push(r);
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return out;
}

/// OP22: the value an element write (Vec_set / p_vec_set) id stores.
fn ng_vz_set_val(func: &IrFunction, id: i64) -> i64 {
    match IrFunction_get_inst(func, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Call(_, args, _, _) => {
                    if args.len() > 0 {
                        return args.get(args.len() - 1);
                    }
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return 0 - 1;
}

/// OP22: the pointer Load id reads (-1: not a Load).
fn ng_vz_load_src(func: &IrFunction, id: i64) -> i64 {
    match IrFunction_get_inst(func, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Load(p, _) => {
                    return p;
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return 0 - 1;
}

/// OP22: the pointer Store id writes (-1: not a Store).
fn ng_vz_store_ptr(func: &IrFunction, id: i64) -> i64 {
    match IrFunction_get_inst(func, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Store(p, _, _) => {
                    return p;
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return 0 - 1;
}

/// OP22: id is an Alloca (of an i64 when `i64_only`).
fn ng_vz_alloca(func: &IrFunction, id: i64, i64_only: bool) -> bool {
    match IrFunction_get_inst(func, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Alloca(aty, _) => {
                    return !i64_only || ir_type_eq(aty, IrType::I64);
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return false;
}

/// OP22: id is a parameter of pointer type.
fn ng_vz_ptr_param(func: &IrFunction, id: i64) -> bool {
    var i: i64 = 0;
    while i < func.params.len() {
        if func.params.get(i).id == id {
            match func.params.get(i).ty {
                IrType::Ptr(_) => {
                    return true;
                }
                _ => {
                }
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

/// OP22: id is the constant 1.
fn ng_vz_is_one(func: &IrFunction, id: i64) -> bool {
    match IrFunction_get_inst(func, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::ConstInt(v, _) => {
                    return v == 1;
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return false;
}

/// OP22: 1 for i64, 2 for f64, 0 for any other type.
fn ng_vz_sty(t: IrType) -> i64 {
    if ir_type_eq(t, IrType::I64) {
        return 1;
    }
    if ir_type_eq(t, IrType::F64) {
        return 2;
    }
    return 0;
}

/// OP22: 1 for Vec<i64>, 2 for Vec<f64>, 0 for any other type.
fn ng_vz_elem(t: IrType) -> i64 {
    match t {
        IrType::Generic(n, targs) => {
            if n == "Vec" && targs.len() == 1 {
                return ng_vz_sty(targs.get(0));
            }
        }
        _ => {
        }
    }
    return 0;
}

/// OP22: the vector kind of lane operation `op` on i64 (sty 1) or f64
/// (sty 2) lanes, -1 when it has none: an integer + or - only where it
/// wraps (a @wrapping function, or checks.fd proved operation id cannot
/// overflow), so that no overflow panic is lost.
fn ng_vz_kind(g: &NatGen, op: BinOp, sty: i64, id: i64) -> i64 {
    var wraps: bool = g.cur_wrapping || ng_unchecked(g, id);
    if sty == 2 {
        match op {
            BinOp::Add => {
                return NVK_FADD64;
            }
            BinOp::Sub => {
                return NVK_FSUB64;
            }
            BinOp::Mul => {
                return NVK_FMUL64;
            }
            BinOp::Div => {
                return NVK_FDIV64;
            }
            _ => {
            }
        }
        return 0 - 1;
    }
    if sty == 1 {
        match op {
            BinOp::BitAnd => {
                return NVK_AND;
            }
            BinOp::BitOr => {
                return NVK_OR;
            }
            BinOp::BitXor => {
                return NVK_XOR;
            }
            BinOp::Add => {
                if wraps {
                    return NVK_ADD64;
                }
            }
            BinOp::Sub => {
                if wraps {
                    return NVK_SUB64;
                }
            }
            _ => {
            }
        }
    }
    return 0 - 1;
}

/// OP22: a reduction's vector kind (associative and commutative on i64:
/// ^ | &, and + where it wraps), -1 for any other operation.
fn ng_vz_red_kind(g: &NatGen, op: BinOp, id: i64) -> i64 {
    var k: i64 = ng_vz_kind(g, op, 1, id);
    if k == NVK_SUB64 {
        return 0 - 1;
    }
    return k;
}

/// OP22: the vector kind commutes bit for bit (the integer ones; an f64
/// operation is kept in order, for the NaN it returns).
fn ng_vz_comm(kind: i64) -> bool {
    return kind == NVK_ADD64 || kind == NVK_AND || kind == NVK_OR || kind == NVK_XOR;
}

fn ng_vz_binop_is_add(op: BinOp) -> bool {
    match op {
        BinOp::Add => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// K10: the loop's instruction k (an element read) is one the pre-scan
/// checks: its Vec (vz.kind, an index into vz.vecs) into vz.scan, once.
fn ng_vz_scan(vz: &mut NgVz, k: i64) {
    if k < 0 {
        return;
    }
    var vi: i64 = vz.kind.get(k);
    var q: i64 = 0;
    while q < vz.scan.len() {
        if vz.scan.get(q) == vi {
            return;
        }
        q = q + 1;
    }
    vz.scan.push(vi);
}

/// K10: the vector kind of a checked i64 + or - (op) in a @simd function,
/// -1 when it is not taken. Each operand (l, class cl; r, class cr) must
/// be an element read, whose Vec the pre-scan checks, or an invariant,
/// checked before the loop (ng_vz_guard): both then lie in [-2^31, 2^31),
/// so the lane's + or - cannot overflow and a wrapping one gives the same
/// result.
fn ng_vz_simd_kind(vz: &mut NgVz, op: BinOp, l: i64, r: i64, cl: i64, cr: i64) -> i64 {
    var kind: i64 = 0 - 1;
    match op {
        BinOp::Add => {
            kind = NVK_ADD64;
        }
        BinOp::Sub => {
            kind = NVK_SUB64;
        }
        _ => {
        }
    }
    if kind < 0 {
        return 0 - 1;
    }
    if (cl != NG_VZ_GET && cl != NG_VZ_INV) || (cr != NG_VZ_GET && cr != NG_VZ_INV) {
        return 0 - 1;
    }
    var lk: i64 = ng_vz_at(vz, l);
    var rk: i64 = ng_vz_at(vz, r);
    if cl == NG_VZ_GET {
        ng_vz_scan(vz, lk);
    } else {
        vz.ichk.push(l);
    }
    if cr == NG_VZ_GET {
        ng_vz_scan(vz, rk);
    } else {
        vz.ichk.push(r);
    }
    vz.nchk = vz.nchk + 1;
    return kind;
}

/// OP22: the position of value id among the loop's instructions (-1: it
/// is defined before the loop).
fn ng_vz_at(vz: &NgVz, id: i64) -> i64 {
    var k: i64 = 0;
    while k < vz.ids.len() {
        if vz.ids.get(k) == id {
            return k;
        }
        k = k + 1;
    }
    return 0 - 1;
}

/// OP22: value id's class; one from before the loop is invariant.
fn ng_vz_cls(vz: &NgVz, id: i64) -> i64 {
    var k: i64 = ng_vz_at(vz, id);
    if k < 0 {
        return NG_VZ_INV;
    }
    return vz.cls.get(k);
}

fn ng_vz_lane(c: i64) -> bool {
    return c == NG_VZ_LANE || c == NG_VZ_GET;
}

/// OP22: values a and b are the same Vec: one value, or two loads in the
/// loop of the same pointer (`& mut Vec` read twice).
fn ng_vz_same(func: &IrFunction, vz: &NgVz, a: i64, b: i64) -> bool {
    if a == b {
        return true;
    }
    if ng_vz_at(vz, a) < 0 || ng_vz_at(vz, b) < 0 {
        return false;
    }
    var pa: i64 = ng_vz_load_src(func, a);
    return pa >= 0 && pa == ng_vz_load_src(func, b);
}

/// OP22: Vec v's index in vz.vecs (added when new), marked written when
/// `stored`.
fn ng_vz_vec(func: &IrFunction, vz: &mut NgVz, v: i64, stored: bool) -> i64 {
    var k: i64 = 0;
    while k < vz.vecs.len() {
        var vk: i64 = vz.vecs.get(k);
        if ng_vz_same(func, vz, vk, v) {
            if stored {
                vz.vst.set(k, 1);
            }
            return k;
        }
        k = k + 1;
    }
    vz.vecs.push(v);
    if stored {
        vz.vst.push(1);
    } else {
        vz.vst.push(0);
    }
    return vz.vecs.len() - 1;
}

/// OP22: invariant id is used as a lane (splat before the loop).
fn ng_vz_splat(vz: &mut NgVz, id: i64) {
    var k: i64 = 0;
    while k < vz.splat.len() {
        if vz.splat.get(k) == id {
            return;
        }
        k = k + 1;
    }
    vz.splat.push(id);
}

/// OP22: the vector register holding lane or splat value id.
fn ng_vz_reg(vz: &NgVz, id: i64) -> i64 {
    var k: i64 = ng_vz_at(vz, id);
    if k >= 0 && ng_vz_lane(vz.cls.get(k)) {
        return vz.vreg.get(k);
    }
    var s: i64 = 0;
    while s < vz.splat.len() {
        if vz.splat.get(s) == id {
            return vz.sreg.get(s);
        }
        s = s + 1;
    }
    return 0;
}

/// OP22: the class of the loop's instruction k (id, `inst`), "" when the
/// vectorizer can take it, else why not.
fn ng_vz_class(g: &NatGen, func: &IrFunction, vz: &mut NgVz, k: i64, id: i64, inst: Inst, inhead: bool, cond: i64) -> str {
    match inst {
        Inst::ConstInt(_, _) => {
            vz.cls.set(k, NG_VZ_INV);
            return "";
        }
        Inst::ConstFloat(_, _) => {
            vz.cls.set(k, NG_VZ_INV);
            return "";
        }
        Inst::ConstBool(_) => {
            vz.cls.set(k, NG_VZ_INV);
            return "";
        }
        Inst::Load(p, lty) => {
            if p == vz.islot {
                if vz.istored {
                    return "the counter read after its increment";
                }
                vz.cls.set(k, NG_VZ_IDX);
                return "";
            }
            if p == vz.sslot {
                // OP22 (Nov 21): also in the loop header — after the ssa
                // round trip the accumulator's load sits at the top of the
                // header (the phi's slot), and it is the same loop-carried
                // start value the generated code loads itself before the
                // vector loop (ng_vz_slot_ld below)
                if !ir_type_eq(lty, IrType::I64) {
                    return "an accumulator that is not an i64";
                }
                vz.cls.set(k, NG_VZ_ACC);
                return "";
            }
            if ng_vz_at(vz, p) >= 0 || (!ng_vz_alloca(func, p, false) && !ng_vz_ptr_param(func, p)) {
                return "a load through a pointer other than a local or a parameter";
            }
            if ng_vz_sty(lty) == 0 && ng_vz_elem(lty) == 0 {
                return "a load of a type other than i64, f64, Vec<i64> or Vec<f64>";
            }
            vz.cls.set(k, NG_VZ_INV);
            return "";
        }
        Inst::Call(cname, cargs, crty, _) => {
            var na: i64 = cargs.len();
            if (cname == "Vec_len" && na == 2) || (cname == "p_vec_len" && na == 1) {
                var lv: i64 = cargs.get(na - 1);
                if ng_vz_cls(vz, lv) != NG_VZ_INV || ng_vz_elem(ng_meta_ty(func, lv)) == 0 {
                    return "the length of a Vec that is not invariant";
                }
                vz.cls.set(k, NG_VZ_INV);
                return "";
            }
            if (cname == "Vec_get" && na == 3) || (cname == "p_vec_get" && na == 2) {
                if inhead {
                    return "an element read in the loop header";
                }
                var gv: i64 = cargs.get(na - 2);
                var gi: i64 = cargs.get(na - 1);
                if ng_vz_cls(vz, gi) != NG_VZ_IDX {
                    return "an element read at an index other than the counter";
                }
                var get_et: i64 = ng_vz_elem(ng_meta_ty(func, gv));
                if ng_vz_cls(vz, gv) != NG_VZ_INV || get_et == 0 {
                    return "an element read from a Vec that is not an invariant Vec<i64> or Vec<f64>";
                }
                if ng_vz_sty(crty) != get_et {
                    return "an element read of another type";
                }
                if vz.seen_set {
                    return "an element read after an element write";
                }
                vz.kind.set(k, ng_vz_vec(func, vz, gv, false));
                vz.cls.set(k, NG_VZ_GET);
                vz.nget = vz.nget + 1;
                return "";
            }
            if (cname == "Vec_set" && na == 4) || (cname == "p_vec_set" && na == 3) {
                if inhead {
                    return "an element write in the loop header";
                }
                var sv: i64 = cargs.get(na - 3);
                var si: i64 = cargs.get(na - 2);
                var sx: i64 = cargs.get(na - 1);
                if ng_vz_cls(vz, si) != NG_VZ_IDX {
                    return "an element write at an index other than the counter";
                }
                var set_et: i64 = ng_vz_elem(ng_meta_ty(func, sv));
                if ng_vz_cls(vz, sv) != NG_VZ_INV || set_et == 0 {
                    return "an element write into a Vec that is not an invariant Vec<i64> or Vec<f64>";
                }
                if ng_vz_sty(ng_meta_ty(func, sx)) != set_et {
                    return "an element write of another type";
                }
                var xc: i64 = ng_vz_cls(vz, sx);
                if xc == NG_VZ_INV {
                    ng_vz_splat(vz, sx);
                } else if !ng_vz_lane(xc) {
                    return "an element write of a value that is not a lane";
                }
                vz.kind.set(k, ng_vz_vec(func, vz, sv, true));
                vz.seen_set = true;
                vz.cls.set(k, NG_VZ_SET);
                vz.nset = vz.nset + 1;
                return "";
            }
            return "a call of " + cname;
        }
        Inst::BinOp(bop, bl, brr, bty) => {
            var cl: i64 = ng_vz_cls(vz, bl);
            var cr: i64 = ng_vz_cls(vz, brr);
            if id == cond {
                if cr != NG_VZ_INV {
                    return "a bound that changes in the loop";
                }
                vz.cls.set(k, NG_VZ_CMP);
                return "";
            }
            if cl == NG_VZ_IDX || cr == NG_VZ_IDX {
                var other: i64 = brr;
                if cr == NG_VZ_IDX {
                    other = bl;
                }
                if (cl == NG_VZ_IDX && cr == NG_VZ_IDX) || !ng_vz_binop_is_add(bop) || !ng_vz_is_one(func, other) || !ir_type_eq(bty, IrType::I64) {
                    return "the counter used other than as the index and in i = i + 1";
                }
                vz.cls.set(k, NG_VZ_INC);
                return "";
            }
            if inhead {
                return "arithmetic in the loop header";
            }
            if cl == NG_VZ_ACC || cr == NG_VZ_ACC {
                var rv: i64 = brr;
                var rc: i64 = cr;
                if cr == NG_VZ_ACC {
                    rv = bl;
                    rc = cl;
                }
                if !ng_vz_lane(rc) || !ir_type_eq(bty, IrType::I64) || !ir_type_eq(ng_meta_ty(func, rv), IrType::I64) {
                    return "a reduction over something other than an i64 lane";
                }
                var rk: i64 = ng_vz_red_kind(g, bop, id);
                if rk < 0 && vz.simd && ng_vz_binop_is_add(bop) && rc == NG_VZ_GET {
                    // K10: a checked + of an element read in a @simd
                    // function: the pre-scan (ng_vz_guard) proves no
                    // order of the sum overflows
                    var rvk: i64 = ng_vz_at(vz, rv);
                    ng_vz_scan(vz, rvk);
                    vz.redchk = true;
                    vz.nchk = vz.nchk + 1;
                    rk = NVK_ADD64;
                }
                if rk < 0 {
                    return "a reduction other than ^ | & or a wrapping +";
                }
                vz.sop = rk;
                vz.kind.set(k, rk);
                vz.cls.set(k, NG_VZ_RED);
                vz.nred = vz.nred + 1;
                return "";
            }
            var sty: i64 = ng_vz_sty(bty);
            if sty == 0 || ng_vz_sty(ng_meta_ty(func, bl)) != sty || ng_vz_sty(ng_meta_ty(func, brr)) != sty {
                return "arithmetic on types other than i64 or f64";
            }
            if (cl != NG_VZ_INV && !ng_vz_lane(cl)) || (cr != NG_VZ_INV && !ng_vz_lane(cr)) {
                return "arithmetic on a value that is neither a lane nor an invariant";
            }
            if cl == NG_VZ_INV && cr == NG_VZ_INV {
                return "invariant arithmetic inside the loop";
            }
            var lk: i64 = ng_vz_kind(g, bop, sty, id);
            if lk < 0 && vz.simd && sty == 1 {
                // K10: a checked i64 + or - in a @simd function
                lk = ng_vz_simd_kind(vz, bop, bl, brr, cl, cr);
            }
            if lk < 0 {
                return "an operation without a vector form (or a checked integer + or -)";
            }
            if cl == NG_VZ_INV {
                ng_vz_splat(vz, bl);
            }
            if cr == NG_VZ_INV {
                ng_vz_splat(vz, brr);
            }
            vz.kind.set(k, lk);
            vz.cls.set(k, NG_VZ_LANE);
            return "";
        }
        Inst::Store(sp, sval, _) => {
            if sp == vz.islot {
                if ng_vz_cls(vz, sval) != NG_VZ_INC {
                    return "the counter stored other than as i + 1";
                }
                vz.istored = true;
                vz.nsti = vz.nsti + 1;
                vz.cls.set(k, NG_VZ_STI);
                return "";
            }
            if sp == vz.sslot && ng_vz_cls(vz, sval) == NG_VZ_RED {
                vz.nsts = vz.nsts + 1;
                vz.cls.set(k, NG_VZ_STS);
                return "";
            }
            return "a store other than i = i + 1 and s = s op lane";
        }
        _ => {
        }
    }
    return "an instruction the vectorizer does not handle";
}

/// OP22: value id's operands (ng_inst_operands of its instruction).
fn ng_vz_ops(func: &IrFunction, id: i64, out: &mut Vec<i64>) {
    match IrFunction_get_inst(func, id) {
        OptInst::Some(inst) => {
            ng_inst_operands(inst, out);
        }
        OptInst::None => {
        }
    }
}

/// OP22: the first free register of `used` (taken), -1 when none is.
fn ng_vz_take(used: &mut Vec<i64>) -> i64 {
    var r: i64 = 0;
    while r < used.len() {
        if used.get(r) == 0 {
            used.set(r, 1);
            return r;
        }
        r = r + 1;
    }
    return 0 - 1;
}

/// OP22: vector registers for the splats, the accumulator and the lane
/// values; "" when nr of them are enough (the class's registers, or TG11's
/// NG_VZ_HOMES vector homes of a loop that spills).
fn ng_vz_regs(g: &NatGen, func: &IrFunction, vz: &mut NgVz, nr: i64) -> str {
    var used: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < nr {
        used.push(0);
        k = k + 1;
    }
    k = 0;
    while k < vz.splat.len() {
        var sr: i64 = ng_vz_take(&mut used);
        if sr < 0 {
            return "more invariants than vector registers";
        }
        vz.sreg.push(sr);
        k = k + 1;
    }
    if vz.sslot >= 0 {
        vz.acc = ng_vz_take(&mut used);
        if vz.acc < 0 {
            return "no vector register left for the accumulator";
        }
    }
    // each value's last use in the loop
    var n: i64 = vz.ids.len();
    var lastu: Vec<i64> = Vec::new();
    var ops: Vec<i64> = Vec::new();
    k = 0;
    while k < n {
        lastu.push(0 - 1);
        k = k + 1;
    }
    k = 0;
    while k < n {
        ops.clear();
        ng_vz_ops(func, vz.ids.get(k), &mut ops);
        var q: i64 = 0;
        while q < ops.len() {
            var d: i64 = ng_vz_at(vz, ops.get(q));
            if d >= 0 {
                lastu.set(d, k);
            }
            q = q + 1;
        }
        k = k + 1;
    }
    k = 0;
    while k < n {
        var c: i64 = vz.cls.get(k);
        var dreg: i64 = 0 - 1;
        if c == NG_VZ_GET {
            dreg = ng_vz_take(&mut used);
            if dreg < 0 {
                return "needs more than " + int_to_str(nr) + " vector registers";
            }
        } else if c == NG_VZ_LANE {
            var lr: Vec<i64> = ng_vz_bin_ops(func, vz.ids.get(k));
            var kl: i64 = ng_vz_at(vz, lr.get(0));
            var kr: i64 = ng_vz_at(vz, lr.get(1));
            var ll: bool = kl >= 0 && ng_vz_lane(vz.cls.get(kl));
            var rl: bool = kr >= 0 && ng_vz_lane(vz.cls.get(kr));
            if ll && lastu.get(kl) == k {
                dreg = vz.vreg.get(kl);
                vz.how.set(k, 0);
            } else if rl && lastu.get(kr) == k && ng_vz_comm(vz.kind.get(k)) && lr.get(0) != lr.get(1) {
                dreg = vz.vreg.get(kr);
                vz.how.set(k, 1);
            } else {
                dreg = ng_vz_take(&mut used);
                if dreg < 0 {
                    return "needs more than " + int_to_str(nr) + " vector registers";
                }
                vz.how.set(k, 2);
            }
        }
        if dreg >= 0 {
            vz.vreg.set(k, dreg);
        }
        // lane operands at their last use give their registers back
        ops.clear();
        ng_vz_ops(func, vz.ids.get(k), &mut ops);
        var q2: i64 = 0;
        while q2 < ops.len() {
            var ko: i64 = ng_vz_at(vz, ops.get(q2));
            if ko >= 0 && ng_vz_lane(vz.cls.get(ko)) && lastu.get(ko) == k {
                var orr: i64 = vz.vreg.get(ko);
                if orr >= 0 && orr != dreg {
                    used.set(orr, 0);
                }
            }
            q2 = q2 + 1;
        }
        if dreg >= 0 && lastu.get(k) < 0 {
            used.set(dreg, 0);
        }
        k = k + 1;
    }
    return "";
}

/// OP22: does the loop whose header is block `head`, entered by Jump jid,
/// fit the vectorizer (see the section's comment)? "" yes (vz filled in),
/// "-" it is not a counted loop at all, else why not.
fn ng_vz_match(g: &NatGen, func: &IrFunction, head: i64, jid: i64, vz: &mut NgVz) -> str {
    var hix: i64 = ng_vz_bix(head);
    if hix < 0 || g_vz_npred.get(hix) != 2 {
        return "-";
    }
    var hb: BasicBlock = func.blocks.get(hix);
    var nhi: i64 = hb.instructions.len();
    if hb.params.len() > 0 || nhi < 2 {
        return "-";
    }
    var br: Vec<i64> = ng_vz_branch(func, hb.instructions.get(nhi - 1));
    if br.len() != 3 {
        return "-";
    }
    var cond: i64 = br.get(0);
    var exitb: i64 = br.get(2);
    // the body: a chain of blocks back to the header
    var body: Vec<i64> = Vec::new();
    var cur: i64 = br.get(1);
    var going: bool = true;
    while going {
        var bix: i64 = ng_vz_bix(cur);
        if bix < 0 || cur == head || cur == exitb || g_vz_npred.get(bix) != 1 || body.len() >= 4 {
            return "-";
        }
        var bb: BasicBlock = func.blocks.get(bix);
        if bb.params.len() > 0 || bb.instructions.len() == 0 {
            return "-";
        }
        body.push(bix);
        var last: i64 = bb.instructions.get(bb.instructions.len() - 1);
        var nx: i64 = ng_vz_jump_to(func, last);
        if nx < 0 {
            return "-";
        }
        if nx == head {
            if last == jid {
                // this is the back edge, not the way in
                return "-";
            }
            going = false;
        } else {
            cur = nx;
        }
    }
    // the loop's instructions, header first, terminators left out
    var nh: i64 = nhi - 1;
    var q: i64 = 0;
    while q < nh {
        ng_vz_push(vz, hb.instructions.get(q));
        q = q + 1;
    }
    q = 0;
    while q < body.len() {
        var blk: BasicBlock = func.blocks.get(body.get(q));
        var m: i64 = 0;
        while m + 1 < blk.instructions.len() {
            ng_vz_push(vz, blk.instructions.get(m));
            m = m + 1;
        }
        q = q + 1;
    }
    if vz.ids.len() > NG_VZ_MAX {
        return "-";
    }
    // the counter: c = load I < n in the header, I an i64 local
    var ck: i64 = ng_vz_at(vz, cond);
    if ck < 0 || ck >= nh {
        return "-";
    }
    var cmp: Vec<i64> = ng_vz_lt(func, cond);
    if cmp.len() != 2 {
        return "-";
    }
    var lk: i64 = ng_vz_at(vz, cmp.get(0));
    if lk < 0 || lk >= nh {
        return "-";
    }
    var islot: i64 = ng_vz_load_src(func, cmp.get(0));
    if islot < 0 || !ng_vz_alloca(func, islot, true) {
        return "-";
    }
    vz.head = head;
    vz.islot = islot;
    vz.bound = cmp.get(1);
    // the stores: the counter's, and at most one other local's (the
    // accumulator)
    q = 0;
    while q < vz.ids.len() {
        var sp: i64 = ng_vz_store_ptr(func, vz.ids.get(q));
        if sp >= 0 {
            if q < nh {
                return "a store in the loop header";
            }
            if sp != islot {
                if vz.sslot >= 0 && sp != vz.sslot {
                    return "stores into more than the counter and one accumulator";
                }
                if !ng_vz_alloca(func, sp, true) {
                    return "a store into memory other than an i64 local (an f64 sum, a field)";
                }
                vz.sslot = sp;
            }
        }
        q = q + 1;
    }
    // each instruction's class
    q = 0;
    while q < vz.ids.len() {
        var iid: i64 = vz.ids.get(q);
        var why: str = "an instruction without a definition";
        match IrFunction_get_inst(func, iid) {
            OptInst::Some(inst) => {
                why = ng_vz_class(g, func, vz, q, iid, inst, q < nh, cond);
            }
            OptInst::None => {
            }
        }
        if why != "" {
            return why;
        }
        q = q + 1;
    }
    if vz.nsti != 1 {
        return "no single i = i + 1";
    }
    if vz.sslot >= 0 && (vz.nred != 1 || vz.nsts != 1) {
        return "the accumulator is not one s = s op lane";
    }
    if vz.nset == 0 && vz.sslot < 0 {
        return "nothing written";
    }
    // the bookkeeping values are each used once: the accumulator's load by
    // the reduction, the reduction by its store, i + 1 by its store, the
    // compare by the branch
    var uses: Vec<i64> = Vec::new();
    var ops: Vec<i64> = Vec::new();
    q = 0;
    while q < vz.ids.len() {
        uses.push(0);
        q = q + 1;
    }
    uses.set(ck, 1);
    q = 0;
    while q < vz.ids.len() {
        ops.clear();
        ng_vz_ops(func, vz.ids.get(q), &mut ops);
        var o: i64 = 0;
        while o < ops.len() {
            var d: i64 = ng_vz_at(vz, ops.get(o));
            if d >= 0 {
                uses.set(d, uses.get(d) + 1);
            }
            o = o + 1;
        }
        q = q + 1;
    }
    q = 0;
    while q < vz.ids.len() {
        var c: i64 = vz.cls.get(q);
        if (c == NG_VZ_ACC || c == NG_VZ_RED || c == NG_VZ_INC || c == NG_VZ_CMP) && uses.get(q) != 1 {
            return "a value of the loop's bookkeeping used elsewhere";
        }
        q = q + 1;
    }
    vz.w = 16;
    if vz.sslot < 0 && ng_x64_avx2(g) {
        vz.w = 32;
    }
    var rwhy: str = ng_vz_regs(g, func, vz, ng_vec_nregs(g));
    if rwhy == "" || !ng_on("vzspill") {
        return rwhy;
    }
    // TG11: more than the registers hold: again over vector homes, most of
    // them frame slots (see the section's comment)
    vz.sreg.clear();
    vz.acc = 0 - 1;
    q = 0;
    while q < vz.ids.len() {
        vz.vreg.set(q, 0 - 1);
        vz.how.set(q, 0);
        q = q + 1;
    }
    var rwhy2: str = ng_vz_regs(g, func, vz, NG_VZ_HOMES);
    if rwhy2 != "" {
        return rwhy + " (with spill slots: " + rwhy2 + ")";
    }
    vz.spill = true;
    ng_vz_pins(g, vz);
    return "";
}

/// TG11: which homes of a loop that spills keep a vector register: the
/// accumulator register 2, the first splats what is left of 2 and 3 (the
/// splats' and the accumulator's homes are never given back, so no lane
/// value shares one); every other home is a frame slot, and registers 0
/// and 1 are the operations' scratch.
fn ng_vz_pins(g: &NatGen, vz: &mut NgVz) {
    var nh: i64 = vz.acc + 1;
    var k: i64 = 0;
    while k < vz.vreg.len() {
        if vz.vreg.get(k) + 1 > nh {
            nh = vz.vreg.get(k) + 1;
        }
        k = k + 1;
    }
    k = 0;
    while k < vz.sreg.len() {
        if vz.sreg.get(k) + 1 > nh {
            nh = vz.sreg.get(k) + 1;
        }
        k = k + 1;
    }
    vz.pin.clear();
    k = 0;
    while k < nh {
        vz.pin.push(0 - 1);
        k = k + 1;
    }
    var next: i64 = 2;
    if vz.acc >= 0 {
        vz.pin.set(vz.acc, 2);
        next = 3;
    }
    k = 0;
    while k < vz.sreg.len() && next < ng_vec_nregs(g) {
        vz.pin.set(vz.sreg.get(k), next);
        next = next + 1;
        k = k + 1;
    }
}

/// TG11: the vector register holding home v of a loop that spills: its
/// own when pinned, else `scratch`, loaded from the home's frame slot.
fn ng_vz_vget(g: &mut NatGen, pin: &Vec<i64>, home: &Vec<i64>, v: i64, scratch: i64, w: i64) -> i64 {
    var p: i64 = pin.get(v);
    if p >= 0 {
        return p;
    }
    var a: i64 = ng_new_vreg(g);
    ng_slot_addr(g, a, home.get(v));
    ng_vld(g, scratch, a, 0, w);
    return scratch;
}

/// TG11: home v of a loop that spills = vector register r (a copy into its
/// pinned register, or a store into its frame slot).
fn ng_vz_vput(g: &mut NatGen, pin: &Vec<i64>, home: &Vec<i64>, v: i64, r: i64, w: i64) {
    var p: i64 = pin.get(v);
    if p >= 0 {
        if p != r {
            ng_vz_vcopy(g, p, r, w);
        }
        return;
    }
    var a: i64 = ng_new_vreg(g);
    ng_slot_addr(g, a, home.get(v));
    ng_vst(g, a, 0, r, w);
}

/// TG11: vector register d = vector register s (0, then | it: d != s).
fn ng_vz_vcopy(g: &mut NatGen, d: i64, s: i64, w: i64) {
    ng_vbin(g, NVK_XOR, d, d, w);
    ng_vbin(g, NVK_OR, d, s, w);
}

fn ng_vz_push(vz: &mut NgVz, id: i64) {
    vz.ids.push(id);
    vz.cls.push(0);
    vz.kind.push(0 - 1);
    vz.vreg.push(0 - 1);
    vz.how.push(0);
}

/// OP22: r = local `slot` (a vreg when promoted, else its memory).
fn ng_vz_slot_ld(g: &mut NatGen, r: i64, slot: i64) {
    if ng_is_promoted(g, slot) {
        ng_mov(g, r, NG_VBASE + slot);
        return;
    }
    ng_ld_val(g, r, slot);
    ng_load(g, r, r, 0, 8, true);
}

/// OP22: local `slot` = r (as ng_gen_inst's Store of an 8-byte value).
fn ng_vz_slot_st(g: &mut NatGen, slot: i64, r: i64) {
    if ng_is_promoted(g, slot) {
        var pk: i64 = g.promoted.get(slot) - 1;
        if pk > 0 {
            ng_ext(g, r, r, pk);
        }
        ng_mov(g, NG_VBASE + slot, r);
        return;
    }
    var a: i64 = ng_new_vreg(g);
    ng_ld_val(g, a, slot);
    ng_store(g, a, 0, r, 8);
}

/// OP22: r = invariant id, at the loop's preheader (a value defined in the
/// loop is computed again here: a constant, a load of a local or of a
/// parameter pointer, a Vec's length).
fn ng_vz_inv(g: &mut NatGen, func: &IrFunction, vz: &NgVz, r: i64, id: i64) {
    if ng_vz_at(vz, id) < 0 {
        ng_ld_val(g, r, id);
        return;
    }
    match IrFunction_get_inst(func, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::ConstInt(v, _) => {
                    ng_li(g, r, v);
                }
                Inst::ConstFloat(fv, fty) => {
                    if ir_type_eq(fty, IrType::F32) {
                        ng_li(g, r, p_f32_to_bits(fv) & 0xFFFFFFFF);
                    } else {
                        ng_li(g, r, p_f64_to_bits(fv));
                    }
                }
                Inst::ConstBool(bv) => {
                    if bv {
                        ng_li(g, r, 1);
                    } else {
                        ng_li(g, r, 0);
                    }
                }
                Inst::Load(p, _) => {
                    ng_vz_slot_ld(g, r, p);
                }
                Inst::Call(_, cargs, _, _) => {
                    // Vec_len: the word at +8 of the header
                    ng_vz_inv(g, func, vz, r, cargs.get(cargs.len() - 1));
                    ng_load(g, r, r, 8, 8, false);
                }
                _ => {
                    ng_li(g, r, 0);
                }
            }
        }
        OptInst::None => {
            ng_li(g, r, 0);
        }
    }
}

/// OP22: the vector loop of a loop ng_vz_match took, in front of it (see
/// the section's comment).
fn ng_vz_emit(g: &mut NatGen, func: &IrFunction, vz: &NgVz) {
    var w: i64 = vz.w;
    var lanes: i64 = w / 8;
    // TG11: a loop that spills: its homes' registers (ng_vz_pins) and frame
    // slots (-1: none), and the accumulator's register
    var pin: Vec<i64> = vz.pin;
    var home: Vec<i64> = Vec::new();
    var accr: i64 = vz.acc;
    if vz.spill {
        var hk: i64 = 0;
        while hk < pin.len() {
            if pin.get(hk) >= 0 {
                home.push(0 - 1);
            } else {
                home.push(ng_vz_vslot(w));
            }
            hk = hk + 1;
        }
        if vz.acc >= 0 {
            accr = pin.get(vz.acc);
        }
    }
    var skip: i64 = NatEnc_label(&mut g.e);
    var vloop: i64 = NatEnc_label(&mut g.e);
    var vexit: i64 = NatEnc_label(&mut g.e);
    var vi: i64 = ng_new_vreg(g);
    var nv: i64 = ng_new_vreg(g);
    var t: i64 = ng_new_vreg(g);
    var c: i64 = ng_new_vreg(g);
    var lim: i64 = ng_new_vreg(g);
    // i >= 0 and n >= lanes
    ng_vz_slot_ld(g, vi, vz.islot);
    ng_setcc(g, c, vi, g.zr, NCC_LT);
    ng_bnez(g, c, skip);
    ng_vz_inv(g, func, vz, nv, vz.bound);
    ng_li(g, t, lanes);
    ng_setcc(g, c, nv, t, NCC_LT);
    ng_bnez(g, c, skip);
    // each Vec: 8-byte words, at least n of them; one written: not shared,
    // owning no elements. Then its buffer.
    var pd: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < vz.vecs.len() {
        var h: i64 = ng_new_vreg(g);
        ng_vz_inv(g, func, vz, h, vz.vecs.get(k));
        ng_load(g, t, h, 24, 8, false);
        ng_bnez(g, t, skip);
        ng_load(g, t, h, 8, 8, false);
        ng_setcc(g, c, t, nv, NCC_LT);
        ng_bnez(g, c, skip);
        if vz.vst.get(k) != 0 {
            ng_load(g, t, h, 16, 8, false);
            ng_setcc(g, c, t, g.zr, NCC_LT);
            ng_bnez(g, c, skip);
            ng_load(g, t, h, 32, 8, false);
            ng_bnez(g, t, skip);
        }
        var pk: i64 = ng_new_vreg(g);
        ng_load(g, pk, h, 0, 8, false);
        pd.push(pk);
        k = k + 1;
    }
    // the vector loop runs while i < n - (lanes - 1); none: skip it all
    ng_li(g, t, lanes - 1);
    ng_sub(g, lim, nv, t);
    ng_setcc(g, c, vi, lim, NCC_LT);
    ng_beqz(g, c, skip);
    if vz.nchk > 0 {
        // K10: the checked + and - of a @simd function cannot overflow
        ng_vz_guard(g, func, vz, &pd, vi, nv, skip);
    }
    k = 0;
    while k < vz.splat.len() {
        var sv: i64 = ng_new_vreg(g);
        ng_vz_inv(g, func, vz, sv, vz.splat.get(k));
        if vz.spill {
            // TG11: into its pinned register, else through scratch 0 into
            // its frame slot
            var sh: i64 = vz.sreg.get(k);
            var sx: i64 = 0;
            if pin.get(sh) >= 0 {
                sx = pin.get(sh);
            }
            ng_vsplat(g, sx, sv, w);
            ng_vz_vput(g, &pin, &home, sh, sx, w);
        } else {
            ng_vsplat(g, vz.sreg.get(k), sv, w);
        }
        k = k + 1;
    }
    if vz.sslot >= 0 {
        var idv: i64 = ng_new_vreg(g);
        if vz.sop == NVK_AND {
            ng_li(g, idv, 0 - 1);
        } else {
            ng_li(g, idv, 0);
        }
        ng_vsplat(g, accr, idv, w);
    }
    if vz.simd && ng_on("vzunroll") {
        // K10: in a @simd function two vectors a trip (the second at
        // displacement w) while i < n - (2 lanes - 1), then the loop of
        // one vector a trip below for one that is left
        var lim2: i64 = ng_new_vreg(g);
        var vloop2: i64 = NatEnc_label(&mut g.e);
        ng_li(g, t, 2 * lanes - 1);
        ng_sub(g, lim2, nv, t);
        ng_place(g, vloop2);
        ng_setcc(g, c, vi, lim2, NCC_LT);
        ng_beqz(g, c, vloop);
        ng_vz_body(g, func, vz, &pd, &pin, &home, accr, vi, 0, w);
        ng_vz_body(g, func, vz, &pd, &pin, &home, accr, vi, w, w);
        ng_li(g, t, 2 * lanes);
        ng_add(g, vi, vi, t);
        ng_jmp(g, vloop2);
    }
    ng_place(g, vloop);
    ng_setcc(g, c, vi, lim, NCC_LT);
    ng_beqz(g, c, vexit);
    ng_vz_body(g, func, vz, &pd, &pin, &home, accr, vi, 0, w);
    ng_li(g, t, lanes);
    ng_add(g, vi, vi, t);
    ng_jmp(g, vloop);
    ng_place(g, vexit);
    ng_vend(g, w);
    if vz.sslot >= 0 {
        // the accumulator's lanes folded into s (w is 16: two lanes); the
        // scratch for lane 1 is any register but the accumulator
        var s: i64 = ng_new_vreg(g);
        var x: i64 = ng_new_vreg(g);
        var y: i64 = ng_new_vreg(g);
        var tr: i64 = (accr + 1) % ng_vec_nregs(g);
        ng_vz_slot_ld(g, s, vz.sslot);
        ng_vlane(g, x, accr, 0, tr, w);
        ng_simd_iop(g, vz.sop, s, s, x);
        ng_vlane(g, y, accr, 1, tr, w);
        ng_simd_iop(g, vz.sop, s, s, y);
        ng_vz_slot_st(g, vz.sslot, s);
    }
    ng_vz_slot_st(g, vz.islot, vi);
    ng_place(g, skip);
}

/// OP22: one vector's worth of the loop's body (ng_vz_emit): the lanes at
/// element i + disp / 8 of each Vec (pd: the Vecs' buffers; pin, home and
/// accr as in ng_vz_emit). K10's unrolled loop runs it twice a trip, at
/// displacements 0 and w.
fn ng_vz_body(g: &mut NatGen, func: &IrFunction, vz: &NgVz, pd: &Vec<i64>, pin: &Vec<i64>, home: &Vec<i64>, accr: i64, vi: i64, disp: i64, w: i64) {
    var k: i64 = 0;
    while k < vz.ids.len() {
        var cl: i64 = vz.cls.get(k);
        var iid: i64 = vz.ids.get(k);
        if vz.spill {
            // TG11: operands through the scratch registers 0 and 1 (a
            // pinned one is read where it is), results back to their homes
            if cl == NG_VZ_GET {
                var sax: i64 = ng_new_vreg(g);
                ng_simd_elem(g, sax, pd.get(vz.kind.get(k)), vi);
                ng_vld(g, 0, sax, disp, w);
                ng_vz_vput(g, pin, home, vz.vreg.get(k), 0, w);
            } else if cl == NG_VZ_LANE {
                var slr: Vec<i64> = ng_vz_bin_ops(func, iid);
                var spa: i64 = ng_vz_vget(g, pin, home, ng_vz_reg(vz, slr.get(0)), 0, w);
                var spb: i64 = ng_vz_vget(g, pin, home, ng_vz_reg(vz, slr.get(1)), 1, w);
                if spa != 0 {
                    ng_vz_vcopy(g, 0, spa, w);
                }
                ng_vbin(g, vz.kind.get(k), 0, spb, w);
                ng_vz_vput(g, pin, home, vz.vreg.get(k), 0, w);
            } else if cl == NG_VZ_SET {
                var spv: i64 = ng_vz_vget(g, pin, home, ng_vz_reg(vz, ng_vz_set_val(func, iid)), 0, w);
                var say: i64 = ng_new_vreg(g);
                ng_simd_elem(g, say, pd.get(vz.kind.get(k)), vi);
                ng_vst(g, say, disp, spv, w);
            } else if cl == NG_VZ_RED {
                var slr2: Vec<i64> = ng_vz_bin_ops(func, iid);
                var slane: i64 = slr2.get(0);
                if ng_vz_cls(vz, slane) == NG_VZ_ACC {
                    slane = slr2.get(1);
                }
                var spl: i64 = ng_vz_vget(g, pin, home, ng_vz_reg(vz, slane), 1, w);
                ng_vbin(g, vz.sop, accr, spl, w);
            }
        } else if cl == NG_VZ_GET {
            var ax: i64 = ng_new_vreg(g);
            ng_simd_elem(g, ax, pd.get(vz.kind.get(k)), vi);
            ng_vld(g, vz.vreg.get(k), ax, disp, w);
        } else if cl == NG_VZ_LANE {
            var lr: Vec<i64> = ng_vz_bin_ops(func, iid);
            var ra: i64 = ng_vz_reg(vz, lr.get(0));
            var rb: i64 = ng_vz_reg(vz, lr.get(1));
            var d: i64 = vz.vreg.get(k);
            var how: i64 = vz.how.get(k);
            if how == 1 {
                ng_vbin(g, vz.kind.get(k), d, ra, w);
            } else {
                if how == 2 {
                    // d = a copy of the left operand: 0, then | it
                    ng_vbin(g, NVK_XOR, d, d, w);
                    ng_vbin(g, NVK_OR, d, ra, w);
                }
                ng_vbin(g, vz.kind.get(k), d, rb, w);
            }
        } else if cl == NG_VZ_SET {
            var ay: i64 = ng_new_vreg(g);
            ng_simd_elem(g, ay, pd.get(vz.kind.get(k)), vi);
            ng_vst(g, ay, disp, ng_vz_reg(vz, ng_vz_set_val(func, iid)), w);
        } else if cl == NG_VZ_RED {
            var lr2: Vec<i64> = ng_vz_bin_ops(func, iid);
            var lane: i64 = lr2.get(0);
            if ng_vz_cls(vz, lane) == NG_VZ_ACC {
                lane = lr2.get(1);
            }
            ng_vbin(g, vz.sop, accr, ng_vz_reg(vz, lane), w);
        }
        k = k + 1;
    }
}

/// K10: before the vector loop of a @simd function that let in checked
/// i64 + or - (NgVz.nchk), at its preheader once the run-time checks of
/// ng_vz_emit passed (vi = i, nv = n, pd the Vecs' buffers): jumps to skip
/// (the loop then runs as written, and panics where it would) unless
/// - each invariant operand of a checked + or - (vz.ichk) is in
///   [-2^31, 2^31);
/// - for a checked + reduction: s in [-2^61, 2^61) and n - i < 2^30;
/// - every element in [i, n - 1) of each Vec whose reads feed one
///   (vz.scan) is in [-2^31, 2^31): a vector pre-scan, two lanes at a time
///   whatever w is (registers 0 to 2 are free here: the splats come
///   after), x + 2^31 or-ed into one vector, its high 32 bits tested once.
/// Then no lane's + or - overflows (both operands within 2^31) and no sum
/// of the reduction's elements in any order leaves [-2^62, 2^62], so the
/// vector loop's wrapping operations give what the checked ones would and
/// none of them would have panicked. The scan reads what the loop reads:
/// the loop reads each element at index i only, before writing it.
fn ng_vz_guard(g: &mut NatGen, func: &IrFunction, vz: &NgVz, pd: &Vec<i64>, vi: i64, nv: i64, skip: i64) {
    var t: i64 = ng_new_vreg(g);
    var c: i64 = ng_new_vreg(g);
    var x: i64 = ng_new_vreg(g);
    var hi: i64 = ng_new_vreg(g);
    // the high 32 bits
    ng_li(g, hi, 0 - 4294967296);
    var k: i64 = 0;
    while k < vz.ichk.len() {
        ng_vz_inv(g, func, vz, x, vz.ichk.get(k));
        ng_li(g, t, 2147483648);
        ng_add(g, x, x, t);
        ng_and(g, x, x, hi);
        ng_bnez(g, x, skip);
        k = k + 1;
    }
    if vz.redchk {
        // (s + 2^61) & the top two bits == 0: s in [-2^61, 2^61)
        ng_vz_slot_ld(g, x, vz.sslot);
        ng_li(g, t, 2305843009213693952);
        ng_add(g, x, x, t);
        ng_li(g, t, 0 - 4611686018427387904);
        ng_and(g, x, x, t);
        ng_bnez(g, x, skip);
        // n - i < 2^30 (n - i >= lanes here)
        ng_sub(g, x, nv, vi);
        ng_li(g, t, 1073741824);
        ng_setcc(g, c, x, t, NCC_GE);
        ng_bnez(g, c, skip);
    }
    if vz.scan.len() == 0 {
        return;
    }
    var j: i64 = ng_new_vreg(g);
    var jlim: i64 = ng_new_vreg(g);
    var lp: i64 = NatEnc_label(&mut g.e);
    var done: i64 = NatEnc_label(&mut g.e);
    ng_mov(g, j, vi);
    ng_li(g, t, 1);
    ng_sub(g, jlim, nv, t);
    // vector register 0 = 2^31 in each lane, 1 = 0 (what is or-ed in)
    ng_li(g, t, 2147483648);
    ng_vsplat(g, 0, t, 16);
    ng_vbin(g, NVK_XOR, 1, 1, 16);
    ng_place(g, lp);
    ng_setcc(g, c, j, jlim, NCC_LT);
    ng_beqz(g, c, done);
    k = 0;
    while k < vz.scan.len() {
        var a: i64 = ng_new_vreg(g);
        ng_simd_elem(g, a, pd.get(vz.scan.get(k)), j);
        ng_vld(g, 2, a, 0, 16);
        ng_vbin(g, NVK_ADD64, 2, 0, 16);
        ng_vbin(g, NVK_OR, 1, 2, 16);
        k = k + 1;
    }
    ng_li(g, t, 2);
    ng_add(g, j, j, t);
    ng_jmp(g, lp);
    ng_place(g, done);
    // both lanes (lane 1 through register 0, free now), their high bits
    var y: i64 = ng_new_vreg(g);
    ng_vlane(g, x, 1, 0, 0, 16);
    ng_vlane(g, y, 1, 1, 0, 16);
    ng_or(g, x, x, y);
    ng_and(g, x, x, hi);
    ng_bnez(g, x, skip);
}

/// OP22: at Jump jid to block `head`: when it enters a loop the vectorizer
/// takes, its vector loop first (the Jump then goes on to the header, the
/// original loop being the scalar tail).
fn ng_vz_try(g: &mut NatGen, jid: i64, head: i64, func: &IrFunction) {
    if !g_vz_on || !g.rec || g_nat_size || func.is_constant_time || g_vz_fn != g.cur_name {
        return;
    }
    if !ng_vec_has(g) {
        return;
    }
    var vz: NgVz = ng_vz_new();
    // K10: a @simd function lets in checked i64 + and - (pre-scanned) and
    // gets its vector loop unrolled twice
    vz.simd = func.is_simd && ng_on("vzsimd");
    var why: str = ng_vz_match(g, func, head, jid, &mut vz);
    if why == "-" {
        return;
    }
    if why != "" {
        if g_vz_loud {
            p_eprint_str("[vectorize] " + g.cur_name + ": bb" + int_to_str(head) + " not vectorized: " + why + "\n");
        }
        return;
    }
    if g_vz_loud {
        var red: str = "";
        if vz.sslot >= 0 {
            red = ", reduction " + ng_vz_kind_name(vz.sop);
        }
        if vz.spill {
            // TG11: how many of its vector homes are frame slots
            var nslot: i64 = 0;
            var hq: i64 = 0;
            while hq < vz.pin.len() {
                if vz.pin.get(hq) < 0 {
                    nslot = nslot + 1;
                }
                hq = hq + 1;
            }
            red = red + ", spilled to " + int_to_str(nslot) + " vector slots";
        }
        if vz.simd {
            // K10: what @simd added
            if vz.nchk > 0 {
                red = red + ", @simd: " + int_to_str(vz.nchk) + " checked (pre-scan of " + int_to_str(vz.scan.len()) + " Vecs, " + int_to_str(vz.ichk.len()) + " invariants)";
            }
            if ng_on("vzunroll") {
                red = red + ", unrolled x2";
            }
        }
        p_eprint_str("[vectorize] " + g.cur_name + ": bb" + int_to_str(head) + " vectorized: " + int_to_str(vz.w) + "-byte vectors (" + int_to_str(vz.w / 8) + " lanes), " + int_to_str(vz.nget) + " reads, " + int_to_str(vz.nset) + " writes, " + int_to_str(vz.splat.len()) + " splats" + red + "\n");
    }
    ng_vz_emit(g, func, &vz);
}

fn ng_vz_kind_name(kind: i64) -> str {
    if kind == NVK_ADD64 {
        return "+";
    }
    if kind == NVK_AND {
        return "&";
    }
    if kind == NVK_OR {
        return "|";
    }
    if kind == NVK_XOR {
        return "^";
    }
    return int_to_str(kind);
}

/// Vec_len, Vec_get, Vec_set and Vec_push, the hottest calls of most
/// programs (pe_ir's PeirGen_inline_vec_call, here on every target): the
/// common case in place, anything else core's function (an out-of-bounds
/// index panics there). A Vec is {data, len, cap, code, tid}: a shared
/// buffer has a negative cap, a Vec owning its elements a tid at +32,
/// structs held inline element codes of 16 and up. `FID_NAT_OFF=vecinline`.
fn ng_gen_call(g: &mut NatGen, id: i64, call_name: str, args: Vec<i64>, func: &IrFunction) {
    // OP23: the runtime's block copy as 16-byte vector steps
    if ng_vblk_call(g, id, call_name, args, func) {
        return;
    }
    // OP21 / TG11: the simd module's f64 intrinsics as vector loops
    if ng_simd_call(g, id, call_name, args, func) {
        return;
    }
    // SP16: p_zero_words with a constant word count, as stores
    if ng_zero_words_inline(g, call_name, args, func) {
        return;
    }
    if !ng_on("vecinline") || g_nat_size || !ng_has_fn(g, call_name) {
        ng_gen_call_std(g, id, call_name, args, func);
        return;
    }
    var na: i64 = args.len();
    if call_name == "Vec_len" && na >= 1 {
        ng_ld_val(g, g.t0, args.get(na - 1));
        ng_load(g, g.t1, g.t0, 8, 8, false);
        ng_st_val(g, id, g.t1);
        return;
    }
    var kind: i64 = 0;
    if call_name == "Vec_get" && na >= 2 {
        kind = 1;
    }
    if call_name == "Vec_set" && na >= 3 {
        kind = 2;
    }
    if call_name == "Vec_push" && na == 3 {
        kind = 3;
    }
    if kind == 0 {
        ng_gen_call_std(g, id, call_name, args, func);
        return;
    }
    var slow: i64 = NatEnc_label(&mut g.e);
    var done: i64 = NatEnc_label(&mut g.e);
    var vid: i64 = args.get(na - 2);
    if kind == 2 {
        vid = args.get(na - 3);
    }
    if kind == 3 {
        vid = args.get(1);
    }
    var bytes: bool = ng_vec_bytes_typed(func, vid);
    var esize: i64 = 8;
    if bytes {
        esize = 1;
    }
    ng_ld_val(g, g.t0, vid);
    if (kind == 1 || kind == 2) && ng_unchecked(g, id) {
        if kind == 1 {
            ng_ld_val(g, g.t1, args.get(na - 1));
        } else {
            ng_ld_val(g, g.t1, args.get(na - 2));
        }
    } else if kind == 1 || kind == 2 {
        // index < len, unsigned (a negative index fails it too)
        if kind == 1 {
            ng_ld_val(g, g.t1, args.get(na - 1));
        } else {
            ng_ld_val(g, g.t1, args.get(na - 2));
        }
        ng_load(g, g.t2, g.t0, 8, 8, false);
        ng_setcc(g, g.t3, g.t1, g.t2, NCC_LTU);
        ng_beqz(g, g.t3, slow);
    }
    if kind == 2 {
        // not shared, owning no elements
        ng_load(g, g.t2, g.t0, 16, 8, false);
        ng_setcc(g, g.t3, g.t2, g.zr, NCC_LT);
        ng_bnez(g, g.t3, slow);
        ng_load(g, g.t2, g.t0, 32, 8, false);
        ng_bnez(g, g.t2, slow);
    }
    ng_vec_kind_check(g, bytes, slow);
    if kind == 1 {
        ng_vec_elem_addr(g, bytes);
        ng_load(g, g.t3, g.t2, 0, esize, false);
        ng_st_val(g, id, g.t3);
    } else if kind == 2 {
        ng_vec_elem_addr(g, bytes);
        ng_ld_val(g, g.t3, args.get(na - 1));
        ng_store(g, g.t2, 0, g.t3, esize);
    } else {
        // room in the buffer: len < cap, signed (a shared one's is negative)
        ng_load(g, g.t1, g.t0, 8, 8, false);
        ng_load(g, g.t2, g.t0, 16, 8, false);
        ng_setcc(g, g.t3, g.t1, g.t2, NCC_LT);
        ng_beqz(g, g.t3, slow);
        ng_vec_elem_addr(g, bytes);
        ng_ld_val(g, g.t3, args.get(2));
        ng_store(g, g.t2, 0, g.t3, esize);
        ng_li(g, g.t3, 1);
        ng_add(g, g.t1, g.t1, g.t3);
        ng_store(g, g.t0, 8, g.t1, 8);
    }
    ng_jmp(g, done);
    ng_place(g, slow);
    ng_gen_call_std(g, id, call_name, args, func);
    ng_place(g, done);
}

/// SP16: at most this many words are cleared by stores in place of a call
/// to p_zero_words (4 with --size).
const NG_ZW_MAX: i64 = 16;

/// SP16: `p_zero_words(p, n)` (stdlib/core.fd: zero n words at p; the
/// lowering calls it to clear every owning struct variable it drops,
/// proposal 0004) with a constant n of at most NG_ZW_MAX becomes n word
/// stores of zero, with no call. In the natively built parser this call was
/// 10% of the profile's samples (FID_PROF), most of it the call itself for
/// two to ten words. Taken with the env argument first (3 arguments, as the
/// lowering emits it) or without it (2). FID_NAT_OFF=zerowords keeps the
/// call. True when the stores were emitted.
fn ng_zero_words_inline(g: &mut NatGen, call_name: str, args: Vec<i64>, func: &IrFunction) -> bool {
    if call_name != "p_zero_words" {
        return false;
    }
    var na: i64 = args.len();
    if na != 2 && na != 3 {
        return false;
    }
    if !ng_on("zerowords") {
        return false;
    }
    var n: i64 = 0 - 1;
    match IrFunction_get_inst(func, args.get(na - 1)) {
        OptInst::Some(inst) => {
            match inst {
                Inst::ConstInt(v, _) => {
                    n = v;
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    var lim: i64 = NG_ZW_MAX;
    if g_nat_size {
        lim = 4;
    }
    if n < 0 || n > lim {
        return false;
    }
    ng_ld_val(g, g.t0, args.get(na - 2));
    ng_li(g, g.t1, 0);
    var k: i64 = 0;
    while k < n {
        ng_store(g, g.t0, k * 8, g.t1, 8);
        k = k + 1;
    }
    return true;
}

fn ng_gen_call_std(g: &mut NatGen, id: i64, call_name: str, args: Vec<i64>, func: &IrFunction) {
    // An f64 lives in its slot as its bits: these copy the word
    if (call_name == "p_f64_to_bits" || call_name == "p_f64_from_bits") && args.len() == 1 {
        ng_ld_val(g, g.t0, args.get(0));
        ng_st_val(g, id, g.t0);
        return;
    }
    // Float/int runtime shims: conversions are native ops already.
    if call_name == "p_int_to_float" && args.len() == 1 {
        ng_ld_val(g, g.t0, args.get(0));
        ng_i2f(g, g.t0, g.t0, false);
        ng_st_val(g, id, g.t0);
        return;
    }
    if call_name == "p_float_to_int" && args.len() == 1 {
        ng_ld_val(g, g.t0, args.get(0));
        ng_f2i(g, g.t0, g.t0, false);
        ng_st_val(g, id, g.t0);
        return;
    }
    if call_name == "p_f32_to_bits" && args.len() == 1 {
        // MI25: an f32 argument already is its 32-bit pattern (the machine
        // layer never widens one); an f64 argument (the C path converts it
        // at the call: compiler code passes ConstFloat's f64) is narrowed
        // to single first. The result is sign-extended, as C's
        // `(int64_t)` of the int32_t and pe_runtime's pert_f32_to_bits give
        // (codegen_c prints it into the C it writes: the same text from a
        // natively built compiler)
        ng_ld_val(g, g.t0, args.get(0));
        if !ir_type_eq(ng_meta_ty(func, args.get(0)), IrType::F32) {
            ng_f32bits(g, g.t0, g.t0);
        }
        ng_ext(g, g.t0, g.t0, NEXT_SW);
        ng_st_val(g, id, g.t0);
        return;
    }
    // Varargs spawns: the arguments after `nargs` go to the function's
    // varargs area and are handed over as an array (as pe_ir's stubs do)
    var va_target: str = "";
    var va_first: i64 = 0;
    if call_name == "p_thread_spawn" {
        va_target = "pert_thread_spawn_v";
    }
    if call_name == "p_co_async" {
        va_target = "pert_co_async_v";
    }
    if call_name == "p_executor_spawn" {
        va_target = "pert_executor_spawn_v";
        va_first = 1;
    }
    if va_target != "" && ng_has_fn(g, va_target) && args.len() >= va_first + 2 && g.va_off >= 0 {
        var k: i64 = va_first + 2;
        var slot: i64 = 0;
        while k < args.len() && slot < 8 {
            ng_ld_val(g, g.t0, args.get(k));
            ng_st_slot(g, g.va_off + slot * 8, g.t0);
            k = k + 1;
            slot = slot + 1;
        }
        ng_li(g, ng_argreg(g, 0), 0);
        ng_ld_val(g, ng_argreg(g, 1), args.get(va_first));
        ng_ld_val(g, ng_argreg(g, 2), args.get(va_first + 1));
        ng_slot_addr(g, ng_argreg(g, 3), g.va_off);
        ng_emit_call(g, va_target);
        ng_st_val(g, id, ng_argreg(g, 0));
        return;
    }
    // extern "C" functions: the runtime's Fides pert_c_<C name>, else an
    // instruction primitive nat_c_<C name> (sqrt, fabs, floor, ...).
    // F8: not the machine layer's own primitives (nat_tls_set, nat_arch,
    // ...: stdlib/linux_runtime declares them in an `extern "C"` block,
    // ng_gen_primitives defines them in the image). Before, CI2's dynamic
    // imports took them for C functions: every Linux executable named
    // ld-linux and libc and imported nat_*, and stopped at load.
    // RL2: nor an extern the runtime implements as a builtin (core's
    // `extern fn p_sensitive_*` run as linux_runtime's pert_sensitive_*)
    if HashMap_contains(g.c_names, call_name) && !ng_has_fn(g, call_name) && !ng_is_own_prim(g, call_name) && !ng_is_runtime_builtin(g, call_name) {
        var cname: str = g.c_list.get(HashMap_get(g.c_names, call_name) - 1);
        var over: str = "pert_c_" + cname;
        var prim: str = "nat_c_" + cname;
        if ng_has_fn(g, over) || HashMap_contains(g.fn_labels, prim) {
            var csrcs: Vec<i64> = Vec::new();
            var cfn: str = prim;
            if ng_has_fn(g, over) {
                csrcs.push(0 - 1);
                cfn = over;
            }
            var ci: i64 = 0;
            while ci < args.len() {
                csrcs.push(args.get(ci));
                ci = ci + 1;
            }
            ng_load_args(g, csrcs);
            ng_emit_call(g, cfn);
            ng_st_val(g, id, ng_argreg(g, 0));
            return;
        }
        // CI2: else the C function itself, bound at load time by the
        // system's dynamic linker (no C compiler, no linker): a stub per
        // signature moves the arguments to the C convention; never the
        // runtime's machine-code primitives (nat_tls_set, nat_syscall,
        // nat_win_call, nat_mac_call, ...): linux_runtime declares them in
        // `extern "C"` blocks and ng_prim defines them; importing them made
        // every Linux build fail at load ("undefined symbol: nat_tls_set")
        if ng_ldyn_ok(g) && !HashMap_contains(g.fn_labels, call_name) && !str_starts_with(call_name, "nat_") && !str_starts_with(cname, "nat_") {
            var lci: i64 = HashMap_get(g.c_names, call_name) - 1;
            var lfix: i64 = 0 - 1;
            if lci < g.ld.c_fixed.len() {
                lfix = g.ld.c_fixed.get(lci);
            }
            // Windows x64: no register limit (the stub passes the rest on
            // the stack)
            var lsig: str = ng_ldyn_var_sig(g, ng_ldyn_sig_lim(func, id, args, lfix, !g.win));
            if lsig != "" {
                var stub: i64 = ng_ldyn_stub_label(g, lci, lsig);
                ng_load_args(g, args);
                ng_call_label(g, stub);
                ng_st_val(g, id, ng_argreg(g, 0));
                return;
            }
        }
    }
    var target: str = call_name;
    if call_name == "print" {
        target = "p_print_int";
        if args.len() > 0 {
            var aty: IrType = ng_meta_ty(func, args.get(0));
            if ng_is_ptr_ty(aty) {
                target = "p_print_str";
            } else if ir_type_is_float(aty) {
                target = "p_print_float";
            } else if ir_type_eq(aty, IrType::Bool) {
                target = "p_print_bool";
            } else if ir_type_is_opaque_named(aty, "Vec") {
                target = "p_print_vec";
            } else if ir_type_is_opaque_named(aty, "HashMap") {
                target = "p_print_map";
            } else if ir_type_is_opaque_named(aty, "Tensor") {
                target = "p_print_tensor";
            }
        }
    } else if call_name == "p_to_str" {
        if args.len() > 0 {
            var aty2: IrType = ng_meta_ty(func, args.get(0));
            if ir_type_is_opaque_named(aty2, "Vec") {
                target = "p_to_str_vec";
            } else if ir_type_is_float(aty2) {
                target = "p_to_str_float";
            } else if ng_is_ptr_ty(aty2) {
                target = "p_to_str_str";
            } else if ir_type_eq(aty2, IrType::Bool) {
                target = "p_to_str_bool";
            }
        }
    }
    var resolved: str = ng_resolve(g, target);
    var srcs: Vec<i64> = Vec::new();
    if ng_has_fn(g, resolved) && !ng_has_fn(g, call_name) {
        srcs.push(0 - 1);
    }
    var ai: i64 = 0;
    while ai < args.len() {
        srcs.push(args.get(ai));
        ai = ai + 1;
    }
    // WP6: an internal callee takes its arguments in the extended register
    // set; every other target keeps the platform convention.
    ng_load_args_i(g, srcs, ng_internal(g, resolved));
    ng_emit_call(g, resolved);
    ng_st_val(g, id, ng_argreg(g, 0));
}

// ===========================================================================
// Integer arithmetic (pe_ir's meaning)
// ===========================================================================

/// t0 = t0 / t1 or t0 % t1 in type `ty`
fn ng_gen_divmod(g: &mut NatGen, is_mod: bool, ty: IrType, checked: bool) {
    // Division by zero panics, even in @wrapping code
    ng_setcc(g, g.t2, g.t1, g.zr, NCC_EQ);
    if is_mod {
        ng_panic_if(g, g.t2, NP_MOD_ZERO);
    } else {
        ng_panic_if(g, g.t2, NP_DIV_ZERO);
    }
    var unsigned: bool = ng_is_unsigned_ty(ty);
    if unsigned {
        if is_mod {
            ng_rem(g, g.t2, g.t0, g.t1, true);
            ng_mov(g, g.t0, g.t2);
        } else {
            ng_div(g, g.t0, g.t0, g.t1, true);
        }
        return;
    }
    var normal: i64 = NatEnc_label(&mut g.e);
    var done: i64 = NatEnc_label(&mut g.e);
    ng_li(g, g.t2, 0 - 1);
    ng_setcc(g, g.t3, g.t1, g.t2, NCC_EQ);
    ng_beqz(g, g.t3, normal);
    if is_mod {
        ng_li(g, g.t0, 0);
    } else {
        if checked && ir_type_eq(ty, IrType::I64) {
            ng_li(g, g.t2, 0 - 9223372036854775807 - 1);
            ng_setcc(g, g.t3, g.t0, g.t2, NCC_EQ);
            ng_panic_if(g, g.t3, NP_DIV_OVF);
        }
        ng_neg(g, g.t0, g.t0);
    }
    ng_jmp(g, done);
    ng_place(g, normal);
    if is_mod {
        ng_rem(g, g.t2, g.t0, g.t1, false);
        ng_mov(g, g.t0, g.t2);
    } else {
        ng_div(g, g.t0, g.t0, g.t1, false);
    }
    ng_place(g, done);
}

/// t0 normalized to narrow type `ty`; with a panic: one that does not fit
fn ng_gen_narrow(g: &mut NatGen, ty: IrType, panic: i64) {
    var kind: i64 = ng_narrow_kind(ty);
    if kind == 0 {
        return;
    }
    ng_ext(g, g.t2, g.t0, kind);
    if panic >= 0 {
        ng_setcc(g, g.t3, g.t2, g.t0, NCC_NE);
        ng_panic_if(g, g.t3, panic);
    }
    ng_mov(g, g.t0, g.t2);
}

/// t0 = t0 op t1 for add (0), sub (1), mul (2), with overflow checks
fn ng_gen_checked(g: &mut NatGen, kind: i64, ty: IrType, checked: bool) {
    var is_i64: bool = ir_type_eq(ty, IrType::I64);
    var is_u64: bool = ir_type_eq(ty, IrType::U64);
    var which: i64 = NP_ADD;
    if kind == 1 {
        which = NP_SUB;
    }
    if kind == 2 {
        which = NP_MUL;
    }
    // BG55: the third scratch of the i64 checks. In the machine IR it is a
    // fresh vreg: g.ad is the address scratch a spill reload with a far
    // frame offset (RISC-V, AArch64) computes its address in, so a value
    // left in it from one MIR instruction to the next could be overwritten
    // (a missed or a false overflow). The direct path has no allocator.
    var sc: i64 = g.ad;
    if checked && is_i64 {
        if g.rec {
            sc = ng_new_vreg(g);
        }
        if kind == 0 {
            ng_add(g, g.t2, g.t0, g.t1);
            ng_xor(g, g.t3, g.t0, g.t2);
            ng_xor(g, sc, g.t1, g.t2);
            ng_and(g, g.t3, g.t3, sc);
            ng_setcc(g, g.t3, g.t3, g.zr, NCC_LT);
            ng_panic_if(g, g.t3, which);
            ng_mov(g, g.t0, g.t2);
        } else if kind == 1 {
            ng_sub(g, g.t2, g.t0, g.t1);
            ng_xor(g, g.t3, g.t0, g.t1);
            ng_xor(g, sc, g.t0, g.t2);
            ng_and(g, g.t3, g.t3, sc);
            ng_setcc(g, g.t3, g.t3, g.zr, NCC_LT);
            ng_panic_if(g, g.t3, which);
            ng_mov(g, g.t0, g.t2);
        } else {
            ng_mulh(g, g.t3, g.t0, g.t1, false);
            ng_mul(g, g.t2, g.t0, g.t1);
            ng_asr63(g, sc, g.t2);
            ng_setcc(g, g.t3, g.t3, sc, NCC_NE);
            ng_panic_if(g, g.t3, which);
            ng_mov(g, g.t0, g.t2);
        }
        return;
    }
    if checked && is_u64 {
        if kind == 0 {
            ng_add(g, g.t2, g.t0, g.t1);
            ng_setcc(g, g.t3, g.t2, g.t0, NCC_LTU);
            ng_panic_if(g, g.t3, which);
            ng_mov(g, g.t0, g.t2);
        } else if kind == 1 {
            ng_setcc(g, g.t3, g.t0, g.t1, NCC_LTU);
            ng_panic_if(g, g.t3, which);
            ng_sub(g, g.t0, g.t0, g.t1);
        } else {
            ng_mulh(g, g.t3, g.t0, g.t1, true);
            ng_setcc(g, g.t3, g.t3, g.zr, NCC_NE);
            ng_panic_if(g, g.t3, which);
            ng_mul(g, g.t0, g.t0, g.t1);
        }
        return;
    }
    if kind == 0 {
        ng_add(g, g.t0, g.t0, g.t1);
    } else if kind == 1 {
        ng_sub(g, g.t0, g.t0, g.t1);
    } else {
        ng_mul(g, g.t0, g.t0, g.t1);
    }
    // A narrow result that changes did not fit (checked); else normalized
    if checked {
        ng_gen_narrow(g, ty, which);
    } else {
        ng_gen_narrow(g, ty, 0 - 1);
    }
}

fn ng_gen_binop(g: &mut NatGen, id: i64, op: BinOp, left: i64, right: i64, ty: IrType, func: &IrFunction) {
    var lty: IrType = ng_meta_ty(func, left);
    var rty: IrType = ng_meta_ty(func, right);
    ng_ld_val(g, g.t0, left);
    ng_ld_val(g, g.t1, right);
    var float_ty: IrType = ty;
    var is_float: bool = ir_type_is_float(ty);
    if !is_float && ir_type_is_float(lty) {
        is_float = true;
        float_ty = lty;
    }
    if is_float {
        var is32: bool = ir_type_eq(float_ty, IrType::F32);
        // An f32 with an f64 (`z * 4.0` of an f32 z: the literal is an f64
        // constant): computed in f64 and the result narrowed to its type,
        // as C does with `float * double` (the f64 operand's bits were read
        // as an f32: 0)
        var mixed: bool = ng_float_mixed(lty, rty, float_ty);
        if mixed {
            if ir_type_eq(lty, IrType::F32) {
                ng_f32widen(g, g.t0, g.t0);
            }
            if ir_type_eq(rty, IrType::F32) {
                ng_f32widen(g, g.t1, g.t1);
            }
            is32 = false;
        }
        match op {
            BinOp::Add => {
                ng_fbin(g, 1, g.t0, g.t0, g.t1, is32);
            }
            BinOp::Sub => {
                ng_fbin(g, 2, g.t0, g.t0, g.t1, is32);
            }
            BinOp::Mul => {
                ng_fbin(g, 3, g.t0, g.t0, g.t1, is32);
            }
            BinOp::Div => {
                ng_fbin(g, 4, g.t0, g.t0, g.t1, is32);
            }
            BinOp::Eq => {
                ng_fcmp(g, g.t0, g.t0, g.t1, NCC_EQ, is32);
            }
            BinOp::Neq => {
                ng_fcmp(g, g.t0, g.t0, g.t1, NCC_NE, is32);
            }
            BinOp::Lt => {
                ng_fcmp(g, g.t0, g.t0, g.t1, NCC_LT, is32);
            }
            BinOp::LtEq => {
                ng_fcmp(g, g.t0, g.t0, g.t1, NCC_LE, is32);
            }
            BinOp::Gt => {
                ng_fcmp(g, g.t0, g.t0, g.t1, NCC_GT, is32);
            }
            BinOp::GtEq => {
                ng_fcmp(g, g.t0, g.t0, g.t1, NCC_GE, is32);
            }
            BinOp::Mod => {
                // MI17: the remainder of C's fmod, as `fid run` and the C
                // path give (it was 0): the runtime's pert_c_fmod
                // (stdlib/linux_runtime/math.fd); an f32 is widened first
                // (the f64 remainder is exact, so narrowing it is too)
                if is32 {
                    ng_f32widen(g, g.t0, g.t0);
                    ng_f32widen(g, g.t1, g.t1);
                }
                ng_mov(g, ng_argreg(g, 2), g.t1);
                ng_mov(g, ng_argreg(g, 1), g.t0);
                ng_li(g, ng_argreg(g, 0), 0);
                ng_emit_call(g, "pert_c_fmod");
                ng_mov(g, g.t0, ng_argreg(g, 0));
                if is32 {
                    ng_f32bits(g, g.t0, g.t0);
                }
            }
            _ => {
                ng_li(g, g.t0, 0);
            }
        }
        if mixed && ir_type_eq(ty, IrType::F32) {
            // (an arithmetic result of type f32; a compare gives a bool)
            ng_f32bits(g, g.t0, g.t0);
        }
        ng_st_val(g, id, g.t0);
        return;
    }
    var checked: bool = !g.cur_wrapping && !ng_unchecked(g, id);
    var unsigned_cmp: bool = ir_type_eq(lty, IrType::U64) || ir_type_eq(rty, IrType::U64);
    match op {
        BinOp::Add => {
            ng_gen_checked(g, 0, ty, checked);
        }
        BinOp::Sub => {
            ng_gen_checked(g, 1, ty, checked);
        }
        BinOp::Mul => {
            ng_gen_checked(g, 2, ty, checked);
        }
        BinOp::Div => {
            g.cur_inst_line = ng_meta_line(func, id);
            ng_gen_divmod(g, false, ty, checked);
            if checked {
                ng_gen_narrow(g, ty, NP_DIV_OVF);
            } else {
                ng_gen_narrow(g, ty, 0 - 1);
            }
            g.cur_inst_line = 0;
        }
        BinOp::Mod => {
            g.cur_inst_line = ng_meta_line(func, id);
            ng_gen_divmod(g, true, ty, checked);
            g.cur_inst_line = 0;
        }
        BinOp::BitAnd => {
            ng_and(g, g.t0, g.t0, g.t1);
        }
        BinOp::BitOr => {
            ng_or(g, g.t0, g.t0, g.t1);
        }
        BinOp::BitXor => {
            ng_xor(g, g.t0, g.t0, g.t1);
        }
        BinOp::Shl => {
            ng_shl(g, g.t0, g.t0, g.t1);
            ng_gen_narrow(g, ty, 0 - 1);
        }
        BinOp::Shr => {
            if ir_type_eq(ty, IrType::U64) {
                ng_shr(g, g.t0, g.t0, g.t1);
            } else {
                ng_sar(g, g.t0, g.t0, g.t1);
            }
        }
        BinOp::And => {
            ng_setcc(g, g.t0, g.t0, g.zr, NCC_NE);
            ng_setcc(g, g.t1, g.t1, g.zr, NCC_NE);
            ng_and(g, g.t0, g.t0, g.t1);
        }
        BinOp::Or => {
            ng_or(g, g.t0, g.t0, g.t1);
            ng_setcc(g, g.t0, g.t0, g.zr, NCC_NE);
        }
        BinOp::Eq => {
            ng_setcc(g, g.t0, g.t0, g.t1, NCC_EQ);
        }
        BinOp::Neq => {
            ng_setcc(g, g.t0, g.t0, g.t1, NCC_NE);
        }
        BinOp::Lt => {
            if unsigned_cmp {
                ng_setcc(g, g.t0, g.t0, g.t1, NCC_LTU);
            } else {
                ng_setcc(g, g.t0, g.t0, g.t1, NCC_LT);
            }
        }
        BinOp::LtEq => {
            if unsigned_cmp {
                ng_setcc(g, g.t0, g.t0, g.t1, NCC_LEU);
            } else {
                ng_setcc(g, g.t0, g.t0, g.t1, NCC_LE);
            }
        }
        BinOp::Gt => {
            if unsigned_cmp {
                ng_setcc(g, g.t0, g.t0, g.t1, NCC_GTU);
            } else {
                ng_setcc(g, g.t0, g.t0, g.t1, NCC_GT);
            }
        }
        BinOp::GtEq => {
            if unsigned_cmp {
                ng_setcc(g, g.t0, g.t0, g.t1, NCC_GEU);
            } else {
                ng_setcc(g, g.t0, g.t0, g.t1, NCC_GE);
            }
        }
    }
    ng_st_val(g, id, g.t0);
}

// ===========================================================================
// Instructions
// ===========================================================================

fn ng_block_label(g: &NatGen, block: i64) -> i64 {
    return HashMap_get(g.block_labels, int_to_str(block));
}

// ---------------------------------------------------------------------------
// MI27: jump tables. A dense Switch is one bounds check and one indirect
// jump through a table of 4-byte entries, each its target's offset from the
// entry itself (NATFIX_SELF32: position-independent, so a PIE, a PE, a
// Mach-O image and an object file need no relocation for it). The table
// sits in the code right after the indirect jump, which never falls
// through. In the machine IR: MO_JTAB (the index, the default label, the
// table's length), one MO_JTE per index (its label), then a JMP to the
// default (compiler/mir.fd). Emitted as
//   x86-64   cmp ix, r11 (= n - 1); ja dflt; lea r10, [rip + T];
//            lea r10, [r10 + ix*4]; movsxd r11, [r10]; add r10, r11;
//            jmp r10; T: entries
//   AArch64  cmp ix, x17; b.hi dflt; adrp/add x16, T; add x16, x16, ix,
//            lsl #2; ldrsw x17, [x16]; add x16, x16, x17; br x16; T: ...
//   RISC-V   bgeu t5, ix, +8; jal dflt (the long form of ng_brcc); auipc/
//            addi t0, T; slli t5, ix, 2; add t0, t0, t5; lw t5, 0(t0);
//            add t0, t0, t5; jalr x0, 0(t0); T: ...
// FID_NAT_OFF=jtab: every switch is ir_switch_plan's tree, as before.
// ---------------------------------------------------------------------------

/// MI27: the fewest keys a jump table is made for, and the most entries.
const NG_JT_MIN_KEYS: i64 = 4;
const NG_JT_MAX_SPAN: i64 = 1024;

/// MI27: the length of the jump table Switch(_, keys, targets, _) gets (the
/// keys' span, max - min + 1), or 0: the tree (ir_switch_plan) instead. A
/// table when the machine IR is recorded (the direct path, FID_NAT_OFF=mir,
/// keeps the tree), FID_NAT_OFF=jtab is not set, there are at least
/// NG_JT_MIN_KEYS keys filling at least 40% of a span of at most
/// NG_JT_MAX_SPAN, and the tree would not be bit tests anyway (a span of at
/// most 64 values going to at most 3 blocks: one AND per block).
fn ng_jt_span(g: &NatGen, keys: &Vec<i64>, targets: &Vec<i64>) -> i64 {
    if !g.rec || !ng_on("jtab") || keys.len() < NG_JT_MIN_KEYS || targets.len() < keys.len() {
        return 0;
    }
    var lo: i64 = keys.get(0);
    var hi: i64 = keys.get(0);
    var blocks: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < keys.len() {
        var kv: i64 = keys.get(i);
        if kv < lo {
            lo = kv;
        }
        if kv > hi {
            hi = kv;
        }
        if !ng_ls_has(&blocks, targets.get(i)) {
            blocks.push(targets.get(i));
        }
        i = i + 1;
    }
    // (keys this far apart are never dense; it also keeps hi - lo in range)
    if lo < 0 - 4611686018427387904 || hi > 4611686018427387903 {
        return 0;
    }
    var span: i64 = hi - lo + 1;
    if span > NG_JT_MAX_SPAN {
        return 0;
    }
    if span <= 64 && blocks.len() <= 3 {
        return 0;
    }
    if keys.len() * 100 < span * 40 {
        return 0;
    }
    return span;
}

/// MI27: Switch(x, keys, targets, dflt) as a jump table of `span` entries
/// (ng_jt_span): index = x - min key, MO_JTAB, an MO_JTE per index (the
/// default where no key is; the first of equal keys wins, as in the tree),
/// then the JMP to the default that ends the chain of entries.
@wrapping
fn ng_gen_jtab(g: &mut NatGen, x: i64, keys: Vec<i64>, targets: Vec<i64>, dflt: i64, span: i64) {
    var lo: i64 = keys.get(0);
    var i: i64 = 0;
    while i < keys.len() {
        if keys.get(i) < lo {
            lo = keys.get(i);
        }
        i = i + 1;
    }
    var dl: i64 = ng_block_label(g, dflt);
    var ents: Vec<i64> = Vec::new();
    var filled: Vec<i64> = Vec::new();
    i = 0;
    while i < span {
        ents.push(dl);
        filled.push(0);
        i = i + 1;
    }
    i = 0;
    while i < keys.len() {
        var at: i64 = keys.get(i) - lo;
        if at >= 0 && at < span && filled.get(at) == 0 {
            ents.set(at, ng_block_label(g, targets.get(i)));
            filled.set(at, 1);
        }
        i = i + 1;
    }
    ng_ld_val(g, g.t0, x);
    var ix: i64 = g.t0;
    if lo != 0 {
        // (wrapping: every x outside [lo, lo + span) lands above span - 1)
        ng_li(g, g.t1, lo);
        ng_sub(g, g.t2, g.t0, g.t1);
        ix = g.t2;
    }
    ng_rec(g, MO_JTAB, ix, 0, 0, dl, span, 0);
    i = 0;
    while i < span {
        ng_rec(g, MO_JTE, 0, 0, 0, ents.get(i), 0, 0);
        i = i + 1;
    }
    ng_jmp(g, dl);
}

/// MI27: emit MO_JTAB: the bounds check to `dflt` (index `ix` above n - 1,
/// unsigned), the entry's address, its offset added, the indirect jump,
/// and the label of the table the MO_JTEs after it fill (see above). Uses
/// the address scratch registers ad and ad2 only. Always the long branch
/// forms (not relaxed: ng_mir_emit_pass).
fn ng_jtab_emit(g: &mut NatGen, ix: i64, dflt: i64, n: i64) {
    ng_li(g, g.ad2, n - 1);
    ng_brcc(g, ix, g.ad2, NCC_GTU, dflt);
    var tab: i64 = NatEnc_label(&mut g.e);
    ng_addr(g, g.ad, tab);
    ng_addshl(g, g.ad, g.ad, ix, 2);
    ng_load(g, g.ad2, g.ad, 0, 4, true);
    ng_add(g, g.ad, g.ad, g.ad2);
    if ng_x64(g) {
        x64_jmp_r(&mut g.e, g.ad);
    } else if ng_a64(g) {
        a64_br(&mut g.e, g.ad);
    } else {
        rv_jalr(&mut g.e, RV_ZERO, g.ad, 0);
    }
    NatEnc_place(&mut g.e, tab);
}

/// ME28/MI27: Switch(x, keys, targets, dflt) as ir_switch_plan (ir.fd)
/// lays it out: a balanced tree of signed compares, equality tests and
/// bit tests (x - lo <=u 63, then one AND with the mask of a block's
/// keys). Records: 1 EQ, 2 LT, 3 BITS, 4 LABEL, 5 JMP (SWP_* in ir.fd).
/// MI27: a dense switch the tree does poorly is a jump table instead
/// (ng_jt_span, ng_gen_jtab).
fn ng_gen_switch(g: &mut NatGen, x: i64, keys: Vec<i64>, targets: Vec<i64>, dflt: i64) {
    var jspan: i64 = ng_jt_span(g, &keys, &targets);
    if jspan > 0 {
        ng_gen_jtab(g, x, keys, targets, dflt, jspan);
        return;
    }
    var plan: Vec<i64> = ir_switch_plan(keys, targets, dflt);
    var labs: Vec<i64> = Vec::new();
    while labs.len() < plan.get(0) {
        labs.push(NatEnc_label(&mut g.e));
    }
    ng_ld_val(g, g.t0, x);
    var pi: i64 = 1;
    while pi + 4 <= plan.len() {
        var op: i64 = plan.get(pi);
        var a: i64 = plan.get(pi + 1);
        var b: i64 = plan.get(pi + 2);
        var c: i64 = plan.get(pi + 3);
        if op == 1 {
            ng_li(g, g.t1, a);
            ng_brcc(g, g.t0, g.t1, NCC_EQ, ng_block_label(g, b));
        } else if op == 2 {
            ng_li(g, g.t1, a);
            ng_brcc(g, g.t0, g.t1, NCC_LT, labs.get(b));
        } else if op == 3 {
            var skip: i64 = NatEnc_label(&mut g.e);
            ng_li(g, g.t1, a);
            ng_sub(g, g.t2, g.t0, g.t1);
            ng_li(g, g.t1, 63);
            ng_brcc(g, g.t2, g.t1, NCC_GTU, skip);
            ng_li(g, g.t1, 1);
            ng_shl(g, g.t1, g.t1, g.t2);
            ng_li(g, g.t3, b);
            ng_and(g, g.t1, g.t1, g.t3);
            ng_bnez(g, g.t1, ng_block_label(g, c));
            ng_place(g, skip);
        } else if op == 4 {
            ng_place(g, labs.get(a));
        } else if op == 5 {
            var dl: i64 = ng_block_label(g, a);
            if dl != g.next_block_label || pi + 4 < plan.len() {
                ng_jmp(g, dl);
            }
        }
        pi = pi + 4;
    }
}

fn ng_gen_inst(g: &mut NatGen, id: i64, inst: Inst, func: &IrFunction, module: &IrModule) {
    match inst {
        Inst::ConstInt(value, _) => {
            ng_li(g, g.t0, value);
            ng_st_val(g, id, g.t0);
        }
        Inst::ConstBool(value) => {
            if value {
                ng_li(g, g.t0, 1);
            } else {
                ng_li(g, g.t0, 0);
            }
            ng_st_val(g, id, g.t0);
        }
        Inst::ConstFloat(value, ty) => {
            if ir_type_eq(ty, IrType::F32) {
                ng_li(g, g.t0, p_f32_to_bits(value) & 0xFFFFFFFF);
            } else {
                ng_li(g, g.t0, p_f64_to_bits(value));
            }
            ng_st_val(g, id, g.t0);
        }
        Inst::ConstStr(value) => {
            // A string naming a program function (a thread or task entry):
            // compiled, and found by name at run time (nat_fn_table)
            ng_named_fn(g, value);
            ng_addr(g, g.t0, ng_str_label(g, value));
            ng_st_val(g, id, g.t0);
        }
        Inst::ConstFnRef(name) => {
            // A function handed to C (qsort's comparison) is named through
            // its C adapter, __c_fn_<f>: here the runtime calls f itself
            var fl: i64 = ng_fn_label(g, c_fn_target(name));
            if fl == 0 {
                ng_li(g, g.t0, 0);
            } else {
                ng_addr(g, g.t0, fl);
            }
            ng_st_val(g, id, g.t0);
        }
        Inst::ConstNull(_) => {
            ng_li(g, g.t0, 0);
            ng_st_val(g, id, g.t0);
        }
        Inst::GlobalAddr(name, _) => {
            ng_addr(g, g.t0, ng_glob_label(g, name));
            ng_st_val(g, id, g.t0);
        }
        Inst::BinOp(op, left, right, ty) => {
            ng_gen_binop(g, id, op, left, right, ty, func);
        }
        Inst::UnaryOp(op, operand, ty) => {
            ng_ld_val(g, g.t0, operand);
            match op {
                UnaryOp::Neg => {
                    if ir_type_eq(ty, IrType::F32) {
                        ng_li(g, g.t1, 2147483648);
                        ng_xor(g, g.t0, g.t0, g.t1);
                    } else if ir_type_is_float(ty) {
                        ng_li(g, g.t1, 0 - 9223372036854775807 - 1);
                        ng_xor(g, g.t0, g.t0, g.t1);
                    } else {
                        ng_neg(g, g.t0, g.t0);
                    }
                }
                UnaryOp::Not => {
                    ng_li(g, g.t1, 1);
                    ng_xor(g, g.t0, g.t0, g.t1);
                }
                UnaryOp::BitNot => {
                    ng_not_bits(g, g.t0, g.t0);
                }
            }
            ng_st_val(g, id, g.t0);
        }
        Inst::Alloca(_, _) => {
            if ng_is_promoted(g, id) {
                return;
            }
            var data: i64 = 0 - 1;
            if id >= 0 && id < g.alloca_data.len() {
                data = g.alloca_data.get(id);
            }
            if data >= 0 {
                ng_slot_addr(g, g.t0, data);
                ng_st_val(g, id, g.t0);
            }
        }
        Inst::Load(ptr, ty) => {
            if ng_is_promoted(g, ptr) {
                ng_mov(g, g.t0, NG_VBASE + ptr);
                ng_st_val(g, id, g.t0);
                return;
            }
            var size: i64 = IrModule_type_size(module, ty);
            var unsigned: bool = false;
            match ty {
                IrType::U8 => {
                    unsigned = true;
                }
                IrType::U16 => {
                    unsigned = true;
                }
                IrType::U32 => {
                    unsigned = true;
                }
                IrType::Bool => {
                    unsigned = true;
                }
                _ => {
                }
            }
            var lsize: i64 = 8;
            if size <= 1 {
                lsize = 1;
            } else if size == 2 {
                lsize = 2;
            } else if size == 4 {
                lsize = 4;
            }
            ng_ld_val(g, g.t1, ptr);
            ng_load(g, g.t0, g.t1, 0, lsize, !unsigned);
            ng_st_val(g, id, g.t0);
        }
        Inst::Store(ptr, value, explicit_ty) => {
            // An f64 stored into an f32 place (`var y: f32 = 3.75`: the
            // literal is an f64 constant) is converted, as C's
            // `*(float*)p = d` (the low 32 bits of its f64 pattern were
            // stored: 0)
            var st_f32: bool = ng_store_f64_to_f32(func, ptr, value, explicit_ty);
            if ng_is_promoted(g, ptr) {
                // The local's type decides the extension a load from memory
                // would have done
                ng_ld_val(g, g.t1, value);
                var pk: i64 = g.promoted.get(ptr) - 1;
                if st_f32 {
                    // (the f32 pattern, zero-extended as the load gives it)
                    ng_f32bits(g, g.t1, g.t1);
                } else if pk > 0 {
                    ng_ext(g, g.t1, g.t1, pk);
                }
                ng_mov(g, NG_VBASE + ptr, g.t1);
                return;
            }
            // The explicit store type, else the pointee type, else the
            // value's type (as the C backend and pe_ir)
            var store_ty: IrType = IrType::I64;
            var have: bool = false;
            match explicit_ty {
                OptIrType::Some(t0) => {
                    store_ty = t0;
                    have = true;
                }
                OptIrType::None => {
                }
            }
            if !have {
                match ng_meta_ty(func, ptr) {
                    IrType::Ptr(inner) => {
                        store_ty = box_ir_type_unbox(inner);
                        have = true;
                    }
                    _ => {
                    }
                }
            }
            if !have {
                store_ty = ng_meta_ty(func, value);
            }
            ng_ld_val(g, g.t0, ptr);
            ng_ld_val(g, g.t1, value);
            if st_f32 {
                ng_f32bits(g, g.t1, g.t1);
            }
            match store_ty {
                IrType::Struct(_) => {
                    ng_copy(g, g.t0, g.t1, IrModule_type_size(module, store_ty));
                }
                IrType::Array(_, _) => {
                    ng_store(g, g.t0, 0, g.t1, 8);
                }
                IrType::Ptr(_) => {
                    ng_store(g, g.t0, 0, g.t1, 8);
                }
                IrType::Opaque(_) => {
                    ng_store(g, g.t0, 0, g.t1, 8);
                }
                IrType::Generic(_, _) => {
                    ng_store(g, g.t0, 0, g.t1, 8);
                }
                _ => {
                    var sz: i64 = IrModule_type_size(module, store_ty);
                    if sz == 1 {
                        ng_store(g, g.t0, 0, g.t1, 1);
                    } else if sz == 2 {
                        ng_store(g, g.t0, 0, g.t1, 2);
                    } else if sz == 4 {
                        ng_store(g, g.t0, 0, g.t1, 4);
                    } else {
                        ng_store(g, g.t0, 0, g.t1, 8);
                    }
                }
            }
        }
        Inst::StructCopy(dst_v, src_v, ty) => {
            ng_ld_val(g, g.t0, dst_v);
            ng_ld_val(g, g.t1, src_v);
            ng_copy(g, g.t0, g.t1, IrModule_type_size(module, ty));
        }
        Inst::GetFieldPtr(struct_ptr, field_index, _) => {
            var offset: i64 = field_index * 8;
            var sname: str = "";
            match ng_meta_ty(func, struct_ptr) {
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(n) => {
                            sname = n;
                        }
                        _ => {
                        }
                    }
                }
                IrType::Struct(n2) => {
                    sname = n2;
                }
                _ => {
                }
            }
            if sname != "" {
                match IrModule_get_struct(module, sname) {
                    OptStructLayout::Some(layout) => {
                        if field_index >= 0 && field_index < layout.fields.len() {
                            offset = layout.fields.get(field_index).offset;
                        }
                    }
                    OptStructLayout::None => {
                    }
                }
            }
            ng_ld_val(g, g.t0, struct_ptr);
            if offset != 0 {
                ng_li(g, g.t1, offset);
                ng_add(g, g.t0, g.t0, g.t1);
            }
            ng_st_val(g, id, g.t0);
        }
        Inst::GetElemPtr(array_ptr, index, elem_ty) => {
            var esize: i64 = IrModule_type_size(module, elem_ty);
            if esize < 1 {
                esize = 1;
            }
            ng_ld_val(g, g.t0, array_ptr);
            ng_ld_val(g, g.t1, index);
            var esh: i64 = ng_log2_exact(esize);
            if esh == 0 {
                ng_add(g, g.t0, g.t0, g.t1);
            } else if esh > 0 && ng_on("addshl") {
                // MI22: base + index * 2^k in one operation (the product
                // wraps as the multiplication did)
                ng_addshl(g, g.t0, g.t0, g.t1, esh);
            } else {
                ng_li(g, g.t2, esize);
                ng_mul(g, g.t1, g.t1, g.t2);
                ng_add(g, g.t0, g.t0, g.t1);
            }
            ng_st_val(g, id, g.t0);
        }
        Inst::Jump(target) => {
            // OP22: entering a loop the vectorizer takes, its vector loop
            ng_vz_try(g, id, target, func);
            var bl: i64 = ng_block_label(g, target);
            if bl != g.next_block_label {
                ng_jmp(g, bl);
            }
        }
        Inst::Switch(sv, sw_keys, sw_targets, sw_dflt) => {
            ng_gen_switch(g, sv, sw_keys, sw_targets, sw_dflt);
        }
        Inst::Branch(cond, then, else_) => {
            var tl: i64 = ng_block_label(g, then);
            var el: i64 = ng_block_label(g, else_);
            ng_ld_val(g, g.t0, cond);
            if tl == g.next_block_label {
                ng_beqz(g, g.t0, el);
            } else {
                ng_bnez(g, g.t0, tl);
                if el != g.next_block_label {
                    ng_jmp(g, el);
                }
            }
        }
        Inst::Return(ret) => {
            match ret {
                OptValueId::Some(v) => {
                    ng_ld_val(g, ng_argreg(g, 0), v);
                }
                OptValueId::None => {
                    ng_li(g, ng_argreg(g, 0), 0);
                }
            }
            ng_epilogue(g);
        }
        Inst::Unreachable => {
            ng_trap(g);
        }
        Inst::Call(call_name, args, _, _) => {
            ng_gen_call(g, id, call_name, args, func);
        }
        Inst::CallPtr(fn_ptr, args, cp_ret, _, _) => {
            // A closure: its environment, whose word 0 is the function. A
            // struct or enum result (lower.fd: the CallPtr's result type is
            // a Struct): args[0] is the pointer the callee writes it to,
            // passed first, before the env, as for a direct call (the
            // arguments were shifted by one: 0 or garbage fields)
            var cp_sret: bool = ng_callptr_sret(cp_ret, args);
            var srcs: Vec<i64> = Vec::new();
            var ai: i64 = 0;
            if cp_sret {
                srcs.push(args.get(0));
                ai = 1;
            }
            srcs.push(fn_ptr);
            while ai < args.len() {
                srcs.push(args.get(ai));
                ai = ai + 1;
            }
            // L6C: in a module with C function pointers, the stub of the
            // call's C signature tells a closure from one (g_ng_cfp_on). A
            // struct result is never a C function's (as codegen_c): the
            // closure is called directly
            var cfp_stub: i64 = 0 - 1;
            if g_ng_cfp_on && !cp_sret {
                cfp_stub = ng_cfp_stub_label(g, ng_cfp_sig(g, func, id, args));
            }
            ng_load_args(g, srcs);
            if cfp_stub >= 0 {
                ng_call_label(g, cfp_stub);
            } else {
                var cp_env: i64 = ng_argreg(g, 0);
                if cp_sret {
                    cp_env = ng_argreg(g, 1);
                }
                ng_load(g, g.ad2, cp_env, 0, 8, false);
                ng_call_reg(g, g.ad2);
            }
            ng_st_val(g, id, ng_argreg(g, 0));
        }
        Inst::DynCall(_, method, args, _, _) => {
            // env 0, the receiver, then args[1..]; the dyn value is
            // {type id, receiver}
            var srcs: Vec<i64> = Vec::new();
            srcs.push(0 - 1);
            srcs.push(0 - 1);
            var ai: i64 = 1;
            while ai < args.len() {
                srcs.push(args.get(ai));
                ai = ai + 1;
            }
            ng_load_args(g, srcs);
            if args.len() > 0 {
                ng_ld_val(g, g.t1, args.get(0));
                ng_load(g, g.t3, g.t1, 0, 8, false);
                // type id
                ng_load(g, ng_argreg(g, 1), g.t1, 8, 8, false);
                // receiver
            }
            var done: i64 = NatEnc_label(&mut g.e);
            var ti: i64 = 0;
            while ti < g.dyn_types.len() {
                var tname: str = g.dyn_types.get(ti);
                var mname: str = tname + "_" + method;
                if ng_has_fn(g, mname) {
                    var next: i64 = NatEnc_label(&mut g.e);
                    ng_li(g, g.t2, ti + 1);
                    ng_setcc(g, g.t2, g.t3, g.t2, NCC_EQ);
                    ng_beqz(g, g.t2, next);
                    ng_call_label(g, ng_fn_label(g, mname));
                    ng_jmp(g, done);
                    ng_place(g, next);
                }
                ti = ti + 1;
            }
            ng_trap(g);
            // no implementation for this type
            ng_place(g, done);
            ng_st_val(g, id, ng_argreg(g, 0));
        }
        Inst::MakeDyn(value, type_name, _) => {
            ng_li(g, ng_argreg(g, 0), 16);
            ng_call_builtin(g, "p_malloc", 1);
            ng_mov(g, g.t0, ng_argreg(g, 0));
            ng_li(g, g.t1, ng_dyn_id(g, type_name));
            ng_store(g, g.t0, 0, g.t1, 8);
            ng_ld_val(g, g.t1, value);
            ng_store(g, g.t0, 8, g.t1, 8);
            ng_st_val(g, id, g.t0);
        }
        Inst::BitCast(value, bc_from, bc_to) => {
            ng_ld_val(g, g.t0, value);
            // MI25 / 2g.13: `x as f32` and `x as f64` between the float
            // types convert the value (an f32 is its 32-bit pattern, an
            // f64 its 64), as the C path and the interpreter do; every
            // other bit cast keeps the bits
            if ir_type_eq(bc_from, IrType::F64) && ir_type_eq(bc_to, IrType::F32) {
                ng_f32bits(g, g.t0, g.t0);
            } else if ir_type_eq(bc_from, IrType::F32) && ir_type_eq(bc_to, IrType::F64) {
                ng_f32widen(g, g.t0, g.t0);
            }
            ng_st_val(g, id, g.t0);
        }
        Inst::IntExtend(value, from, _) => {
            ng_ld_val(g, g.t0, value);
            match from {
                IrType::I8 => {
                    ng_ext(g, g.t0, g.t0, NEXT_SB);
                }
                IrType::I16 => {
                    ng_ext(g, g.t0, g.t0, NEXT_SH);
                }
                IrType::I32 => {
                    ng_ext(g, g.t0, g.t0, NEXT_SW);
                }
                _ => {
                }
            }
            ng_st_val(g, id, g.t0);
        }
        Inst::IntTrunc(value, _, to) => {
            ng_ld_val(g, g.t0, value);
            match to {
                // M7: a signed narrow value is kept sign-extended
                // (ng_narrow_kind), an unsigned one zero-extended
                IrType::I8 => {
                    ng_ext(g, g.t0, g.t0, NEXT_SB);
                }
                IrType::U8 => {
                    ng_ext(g, g.t0, g.t0, NEXT_ZB);
                }
                IrType::I16 => {
                    ng_ext(g, g.t0, g.t0, NEXT_SH);
                }
                IrType::U16 => {
                    ng_ext(g, g.t0, g.t0, NEXT_ZH);
                }
                IrType::I32 => {
                    ng_ext(g, g.t0, g.t0, NEXT_SW);
                }
                IrType::U32 => {
                    ng_ext(g, g.t0, g.t0, NEXT_ZW);
                }
                _ => {
                }
            }
            ng_st_val(g, id, g.t0);
        }
        Inst::IntToFloat(value, _, to) => {
            ng_ld_val(g, g.t0, value);
            ng_i2f(g, g.t0, g.t0, ir_type_eq(to, IrType::F32));
            ng_st_val(g, id, g.t0);
        }
        Inst::FloatToInt(value, from, _) => {
            ng_ld_val(g, g.t0, value);
            ng_f2i(g, g.t0, g.t0, ir_type_eq(from, IrType::F32));
            ng_st_val(g, id, g.t0);
        }
        Inst::Print(value, ty) => {
            var formatter: str = pe_ir_print_formatter(ty);
            if formatter != "" {
                // Collections print through their Fides formatter
                ng_li(g, ng_argreg(g, 0), 0);
                ng_ld_val(g, ng_argreg(g, 1), value);
                ng_emit_call(g, ng_resolve(g, formatter));
                ng_call_builtin(g, "p_print_str", 1);
            } else {
                var print_fn: str = "p_print_int";
                match ty {
                    IrType::Ptr(_) => {
                        print_fn = "p_print_str";
                    }
                    IrType::Opaque(n) => {
                        if n == "String" {
                            print_fn = "p_print_str";
                        }
                    }
                    IrType::F64 => {
                        print_fn = "p_print_float";
                    }
                    IrType::F32 => {
                        print_fn = "p_print_float";
                    }
                    IrType::Bool => {
                        print_fn = "p_print_bool";
                    }
                    _ => {
                    }
                }
                ng_ld_val(g, ng_argreg(g, 0), value);
                if ir_type_eq(ty, IrType::F32) {
                    // the runtime prints an f64 (MI25: one recorded
                    // widening; ng_fload2 / ng_fstore0 encode directly
                    // and are not recorded in the machine IR)
                    ng_f32widen(g, g.t0, ng_argreg(g, 0));
                    ng_mov(g, ng_argreg(g, 0), g.t0);
                }
                ng_call_builtin(g, print_fn, 1);
            }
        }
        Inst::Panic(message) => {
            ng_addr(g, ng_argreg(g, 0), ng_str_label(g, message));
            ng_call_builtin(g, "p_panic", 1);
            ng_trap(g);
        }
        Inst::PersistLoad(_, default, _) => {
            ng_ld_val(g, g.t0, default);
            ng_st_val(g, id, g.t0);
        }
        Inst::PersistSave(_, _) => {
        }
        Inst::TxnBegin => {
        }
        Inst::TxnEnd => {
        }
        Inst::UnsafeBegin => {
        }
        Inst::UnsafeEnd => {
        }
        Inst::GradBegin(_) => {
            ng_call_builtin(g, pe_ir_autograd_builtin(inst), 0);
        }
        Inst::GradEnd => {
            ng_call_builtin(g, pe_ir_autograd_builtin(inst), 0);
        }
        Inst::Backward(v) => {
            ng_ld_val(g, ng_argreg(g, 0), v);
            ng_call_builtin(g, pe_ir_autograd_builtin(inst), 1);
        }
        Inst::TryUnwrap(_, _, _, _) => {
        }
        Inst::Asm(asm_tpl, asm_ins, asm_outs, asm_ty) => {
            if ng_on("asm") {
                // LG13: a process runs the template, in a thunk of its own
                // (as pe_ir does; privileged or unknown instructions give 0)
                ng_gen_asm(g, id, asm_tpl, asm_ins, asm_outs);
            } else {
                // FID_NAT_OFF=asm: no inline assembly in a process (as before)
                ng_li(g, g.t0, 0);
                ng_st_val(g, id, g.t0);
            }
        }
        Inst::RegionBegin(_, _, _, _) => {
            ng_li(g, g.t0, 0);
            ng_st_val(g, id, g.t0);
        }
        Inst::RegionEnd(_, _, _) => {
        }
    }
}

// ===========================================================================
// Functions
// ===========================================================================

fn ng_note_id(maxid: i64, id: i64) -> i64 {
    if id > maxid {
        return id;
    }
    return maxid;
}

fn ng_gen_function(g: &mut NatGen, name: str, func: &IrFunction, module: &IrModule) {
    g.cur_name = name;
    // Line rows (debug sections only, not on Windows): this function's
    ng_line_close(g);
    // (CT6: on Windows only for an image with DWARF, ng_dbg_lines_ok)
    g.lines_cur_fn = ng_dbg_lines_ok(g) && ng_on("debug") && HashMap_contains(g.line_fns, name);
    // DB1: a function of another file of the program gets rows too, against
    // that file (ir.fd ir_fn_file; nat_enc.fd's file table); core and the
    // runtime against theirs, a monomorphized instance or an optimizer's
    // clone against its generic's (ir_fn_src_file)
    g_nat_line_file_ix = 0;
    if !g.lines_cur_fn && ng_dbg_lines_ok(g) && ng_on("debug") && str_len(g_nat_lines_file) > 0 && str_len(ir_fn_src_file(name)) > 0 {
        g.lines_cur_fn = true;
        g_nat_line_file_ix = nat_line_file_index(ir_fn_src_file(name));
    }
    nat_line_fn_set(name, g_nat_line_file_ix);
    g.cur_line = 0;
    // The runtime's arithmetic wraps, as pe_ir's does
    g.cur_wrapping = func.is_wrapping || is_pe_runtime_fn(name);
    // WP11: @crashfree asserts no panic path exists; the checks left after
    // the MIR folds are verified (ng_crashfree_check)
    g.cur_crashfree = func.is_crashfree;
    if func.is_crashfree {
        HashMap_insert(g.cf_fns, name, 1);
    }
    // Counted loops and integer ranges (checks.fd, shared with pe_ir and C):
    // the operations that cannot overflow or index out of bounds
    // (`FID_NAT_OFF=unchecked`: every check stays)
    if ng_on("unchecked") {
        g.unchecked = peir_unchecked_ops(func, func.value_metas.len() + func.insts.len() + 16);
    } else {
        g.unchecked = Vec::new();
    }
    // OP22: the blocks and their edges, for the loop vectorizer
    ng_vz_begin(name, func);
    // The machine IR records the function (placed when it is emitted, after
    // allocation); the direct path places and encodes it now
    var mir_on: bool = NG_MIR && (ng_on("mir") || ng_x64(g));
    if !mir_on {
        NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
        NatEnc_place(&mut g.e, HashMap_get(g.fn_labels, name));
        g.placed_fns.push(name);
        // DB4: where each position's code starts (ng_dbg_vars_direct)
        g_ng_dbg_dpos = Vec::new();
    }

    // Every value id gets a slot (8 bytes, or its type's size)
    var maxid: i64 = 0;
    var i: i64 = 0;
    while i < func.value_metas.len() {
        maxid = ng_note_id(maxid, func.value_metas.get(i).id);
        i = i + 1;
    }
    i = 0;
    while i < func.insts.len() {
        maxid = ng_note_id(maxid, func.insts.get(i).id);
        i = i + 1;
    }
    i = 0;
    while i < func.params.len() {
        maxid = ng_note_id(maxid, func.params.get(i).id);
        i = i + 1;
    }
    var slots: Vec<i64> = Vec::new();
    var adata: Vec<i64> = Vec::new();
    i = 0;
    while i <= maxid {
        slots.push(0 - 1);
        adata.push(0 - 1);
        i = i + 1;
    }

    // Outgoing argument area: the widest call's arguments past 8
    var most: i64 = 0;
    i = 0;
    while i < func.insts.len() {
        var n: i64 = 0;
        match func.insts.get(i).inst {
            Inst::Call(_, a1, _, _) => {
                n = a1.len() + 1;
            }
            Inst::CallPtr(_, a2, _, _, _) => {
                n = a2.len() + 1;
            }
            Inst::DynCall(_, _, a3, _, _) => {
                n = a3.len() + 1;
            }
            _ => {
            }
        }
        if n > most {
            most = n;
        }
        i = i + 1;
    }
    var out: i64 = 0;
    if most > ng_nregargs(g) {
        out = (most - ng_nregargs(g)) * 8;
    }
    out = (out + 15) & (0 - 16);
    var cur: i64 = out;
    // MI8: on the machine IR a value lives in its vreg; only the
    // allocator's spill slots (ng_mir_alloc) take frame room, so a value's
    // slot here only says that the value exists (0, no bytes reserved).
    // The direct path (FID_NAT_OFF=mir) keeps a slot in memory per value.
    var vstep: bool = !mir_on || !ng_on("frameslots");
    i = 0;
    while i < func.value_metas.len() {
        var vm: ValueIdMeta = func.value_metas.get(i);
        var size: i64 = IrModule_type_size(module, vm.meta.ty);
        if size < 8 {
            size = 8;
        }
        size = (size + 7) & (0 - 8);
        if slots.get(vm.id) < 0 {
            if vstep {
                slots.set(vm.id, cur);
                cur = cur + size;
            } else {
                slots.set(vm.id, 0);
            }
        }
        i = i + 1;
    }
    // MI8: the ids some instruction names as an operand (an Alloca nothing
    // addresses is dead — ssa or promote removed its loads and stores)
    var used_ids: Vec<i64> = peir_zeros(func.next_value + 1);
    {
        var uops: Vec<i64> = Vec::new();
        var ub: i64 = 0;
        while ub < func.blocks.len() {
            var uids: Vec<i64> = func.blocks.get(ub).instructions;
            var uk2: i64 = 0;
            while uk2 < uids.len() {
                uops.clear();
                peir_inst_operands(peir_inst_of(func, uids.get(uk2)), &mut uops);
                var uo: i64 = 0;
                while uo < uops.len() {
                    if uops.get(uo) >= 0 && uops.get(uo) < used_ids.len() {
                        used_ids.set(uops.get(uo), 1);
                    }
                    uo = uo + 1;
                }
                uk2 = uk2 + 1;
            }
            ub = ub + 1;
        }
    }
    i = 0;
    while i < func.insts.len() {
        var ve: ValueIdInst = func.insts.get(i);
        if slots.get(ve.id) < 0 {
            if vstep {
                slots.set(ve.id, cur);
                cur = cur + 8;
            } else {
                slots.set(ve.id, 0);
            }
        }
        match ve.inst {
            Inst::Alloca(aty, _) => {
                var dsize: i64 = IrModule_type_size(module, aty);
                if dsize < 8 {
                    dsize = 8;
                }
                dsize = (dsize + 7) & (0 - 8);
                // MI8 (Nov 21 evening): ssa/promote leave a promoted
                // local's Alloca in the IR unused (locals and debug info
                // still name a value that exists) — nothing addresses it,
                // so it keeps no frame bytes. big's ~240 dead 8-byte
                // allocas were its 1.9 KB frame.
                // FID_NAT_OFF=deadalloca: every Alloca keeps its bytes
                var aused: bool = !ng_on("deadalloca") || (ve.id >= 0 && ve.id < used_ids.len() && used_ids.get(ve.id) != 0);
                if aused {
                    adata.set(ve.id, cur);
                    cur = cur + dsize;
                } else {
                    adata.set(ve.id, 0 - 1);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < func.params.len() {
        var pid: i64 = func.params.get(i).id;
        if slots.get(pid) < 0 {
            if vstep {
                slots.set(pid, cur);
                cur = cur + 8;
            } else {
                slots.set(pid, 0);
            }
        }
        i = i + 1;
    }
    // The varargs area of spawn calls (8 words)
    g.va_off = 0 - 1;
    i = 0;
    while i < func.insts.len() {
        match func.insts.get(i).inst {
            Inst::Call(vname, _, _, _) => {
                if vname == "p_thread_spawn" || vname == "p_co_async" || vname == "p_executor_spawn" {
                    g.va_off = cur;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    if g.va_off >= 0 {
        cur = cur + 64;
    }
    var frame: i64 = 16;
    var base_frame: i64 = cur;
    // TG11: vector spill slots of the vectorized loops go past the locals
    g_vz_frame0 = cur;
    g_vz_xbytes = 0;
    if mir_on {
        g.vreg = Vec::new();
        g.save_regs = Vec::new();
    } else {
        // Registers for values, and the area that saves them
        ng_regalloc(g, func, slots.len());
        g.save_off = cur;
        cur = cur + 8 * g.save_regs.len();
        frame = (cur + 15) & (0 - 16);
        if frame < 16 {
            frame = 16;
        }
    }
    g.slots = slots;
    g.alloca_data = adata;
    var saved_t: Vec<i64> = Vec::new();
    if mir_on {
        saved_t.push(g.t0);
        saved_t.push(g.t1);
        saved_t.push(g.t2);
        saved_t.push(g.t3);
        g.rec = true;
        g.mir = Vec::new();
        g.nvreg = NG_VBASE + g.slots.len();
        g.promoted = ng_promotable(g, func, module, g.slots.len());
        ng_fresh_temps(g);
    }

    ng_prologue(g, frame);
    // Parameters: registers, then the caller's stack
    i = 0;
    var ic: bool = func.internal_conv;
    while i < func.params.len() {
        var p: ValueIdType = func.params.get(i);
        if i < ng_nregargs_i(g, ic) {
            ng_st_val(g, p.id, ng_argreg_i(g, i, ic));
        } else {
            ng_ld_incoming(g, g.t0, i - ng_nregargs_i(g, ic));
            ng_st_val(g, p.id, g.t0);
        }
        i = i + 1;
    }

    g.block_labels = HashMap_new();
    var bi: i64 = 0;
    while bi < func.blocks.len() {
        var blab: i64 = NatEnc_label(&mut g.e);
        HashMap_insert(g.block_labels, int_to_str(func.blocks.get(bi).id), blab);
        // OP15: which IR block each label starts, for the profile's block
        // counts (ng_pgo_cold_labels)
        if g_pgo_use_path != "" {
            ng_note_block_label(blab, func.blocks.get(bi).id);
        }
        bi = bi + 1;
    }
    bi = 0;
    while bi < func.blocks.len() {
        var block: BasicBlock = func.blocks.get(bi);
        ng_place(g, ng_block_label(g, block.id));
        g.next_block_label = 0 - 1;
        if bi + 1 < func.blocks.len() {
            g.next_block_label = ng_block_label(g, func.blocks.get(bi + 1).id);
        }
        var ii: i64 = 0;
        while ii < block.instructions.len() {
            var iid: i64 = block.instructions.get(ii);
            if g.rec {
                ng_fresh_temps(g);
            }
            if g.lines_cur_fn {
                ng_note_line(g, func, iid);
                if !mir_on {
                    ng_dbg_dpos_mark(g);
                }
            }
            match IrFunction_get_inst(func, iid) {
                OptInst::Some(inst) => {
                    ng_gen_inst(g, iid, inst, func, module);
                }
                OptInst::None => {
                }
            }
            ii = ii + 1;
        }
        if g.lines_cur_fn && !mir_on {
            ng_dbg_dpos_mark(g);
        }
        bi = bi + 1;
    }
    // Falling off the end returns 0
    ng_li(g, ng_argreg(g, 0), 0);
    ng_epilogue(g);
    // DB4: the direct path's variables (FID_NAT_OFF=mir), now that its
    // code is in place
    if !mir_on && g.lines_cur_fn && ng_on("dbgvars") {
        ng_dbg_vars_direct(g, name, func, module, frame);
    }
    if mir_on {
        g.rec = false;
        // WP17: panic paths — segments containing MO_TRAP — go to the end of
        // the function's code so the hot path stays compact and contiguous.
        var is_ct: bool = func.is_constant_time;
        // ME27: a struct result goes out through the hidden first parameter
        // (lowering's sret): its vreg and the struct's size
        var sret_v: i64 = 0 - 1;
        var sret_size: i64 = 0;
        if ng_is_struct_ty(func.ret_ty) && func.params.len() > 0 {
            var sp0: ValueIdType = func.params.get(0);
            if ng_is_struct_ptr_ty(sp0.ty) && ng_slot(g, sp0.id) >= 0 {
                sret_v = NG_VBASE + sp0.id;
                sret_size = IrModule_type_size(module, func.ret_ty);
            }
        }
        // LF20: a function holding a secret (the front end's has_secret, a
        // @zeroize local, @constant_time code)
        var secret: bool = func.has_secret || func.is_constant_time || func.zeroize_locals.len() > 0;
        // LF20: and its secret values, the last the allocator spills
        // (ng_secret_note, ng_secret_weights)
        if secret {
            ng_secret_note(name, func, g.slots.len());
        }
        // DB4: the source variables of a function that gets line rows;
        // CE8: on `--nat` Windows (no line rows) those of the input file's
        // functions too when -g asks for the frame table (ng_dbg_frames_on)
        if (g.lines_cur_fn || (g.win && ng_dbg_frames_on() && HashMap_contains(g.line_fns, name))) && ng_on("dbgvars") {
            ng_dbg_vars_note(g, name, func, module);
        }
        // DB7: the MIR as instruction selection recorded it
        ng_dump_mir(name, "selection", &g.mir);
        // MI28 (2g.98): the extension its narrow result leaves
        ng_ret_ext_note(name, func.ret_ty);
        g.recs.push(NatFnRec {
            name: name, mir: ng_cold_last(&g.mir, 0, 0), nvreg: g.nvreg, base_frame: ng_vz_frame_end(base_frame), slots: g.slots, is_ct: is_ct, sret_v: sret_v, sret_size: sret_size, secret: secret
        });
        if is_ct || ng_ct_exempt_callee(name) {
            // labels are numbers: an integer-keyed map (a plain insert
            // hashed the label as a string and crashed, MI17)
            HashMap_insert_i(g.ct_labels, ng_fn_label(g, name), 1);
        }
        g.mir = Vec::new();
        g.t0 = saved_t.get(0);
        g.t1 = saved_t.get(1);
        g.t2 = saved_t.get(2);
        g.t3 = saved_t.get(3);
    }
}

// ===========================================================================
// Primitives, panics, data
// ===========================================================================

fn ng_gen_primitives(g: &mut NatGen) {
    if ng_x64(g) {
        ng_gen_primitives_x64(g);
        return;
    }
    if g.mac {
        // macOS arm64: the Mach-O entry, nat_syscall and the rest; the
        // shared primitives (ng_gen_primitives2) skip their Linux-only
        // versions when g.mac is set.
        ng_gen_primitives_mac(g);
        ng_gen_primitives2(g);
        var ssp_m: i64 = NatEnc_label(&mut g.e);
        HashMap_insert(g.fn_labels, "nat_start_sp", ssp_m);
        g.fn_label_names.push("nat_start_sp");
        NatEnc_place(&mut g.e, ssp_m);
        a64_addr(&mut g.e, g.t0, g.start_sp_label);
        a64_ldr(&mut g.e, 0, g.t0, 0);
        a64_ret(&mut g.e);
        return;
    }
    // _start: keep the initial sp (argc, argv, envp), call main(env = 0),
    // exit_group(its result)
    g.entry_label = NatEnc_label(&mut g.e);
    NatEnc_place(&mut g.e, g.entry_label);
    var main_label: i64 = ng_fn_label(g, "main");
    ng_gen_pie_reloc(g);
    if ng_a64(g) {
        a64_add_imm(&mut g.e, g.t0, A64_SP, 0);
        a64_addr(&mut g.e, g.t1, g.start_sp_label);
        a64_str(&mut g.e, g.t0, g.t1, 0);
        a64_li(&mut g.e, A64_FP, 0);
        if ng_has_fn(g, "pe_rt_init") {
            a64_li(&mut g.e, 0, 0);
            a64_bl(&mut g.e, ng_fn_label(g, "pe_rt_init"));
        }
        a64_li(&mut g.e, 0, 0);
        a64_bl(&mut g.e, main_label);
        // DB9: pe_rt_exit(its result) (the profile's report), which exits
        if ng_has_fn(g, "pe_rt_exit") {
            a64_mov(&mut g.e, 1, 0);
            a64_li(&mut g.e, 0, 0);
            a64_bl(&mut g.e, ng_fn_label(g, "pe_rt_exit"));
        }
        a64_li(&mut g.e, 8, 94);
        a64_svc0(&mut g.e);
        a64_brk(&mut g.e);
    } else {
        rv_mv(&mut g.e, g.t0, RV_SP);
        rv_addr(&mut g.e, g.t1, g.start_sp_label);
        rv_store(&mut g.e, g.t0, g.t1, 0, 8);
        rv_li(&mut g.e, RV_S0, 0);
        if ng_has_fn(g, "pe_rt_init") {
            rv_li(&mut g.e, RV_A0, 0);
            rv_call(&mut g.e, ng_fn_label(g, "pe_rt_init"));
        }
        rv_li(&mut g.e, RV_A0, 0);
        rv_call(&mut g.e, main_label);
        // DB9: pe_rt_exit(its result) (the profile's report), which exits
        if ng_has_fn(g, "pe_rt_exit") {
            rv_mv(&mut g.e, RV_A0 + 1, RV_A0);
            rv_li(&mut g.e, RV_A0, 0);
            rv_call(&mut g.e, ng_fn_label(g, "pe_rt_exit"));
        }
        rv_li(&mut g.e, RV_A7, 94);
        rv_ecall(&mut g.e);
        rv_ebreak(&mut g.e);
    }

    // nat_syscall(n, a, b, c, d, e, f) -> result
    var sys: i64 = NatEnc_label(&mut g.e);
    HashMap_insert(g.fn_labels, "nat_syscall", sys);
    g.fn_label_names.push("nat_syscall");
    NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
    NatEnc_place(&mut g.e, sys);
    if ng_a64(g) {
        a64_mov(&mut g.e, 8, 0);
        var k: i64 = 0;
        while k < 6 {
            a64_mov(&mut g.e, k, k + 1);
            k = k + 1;
        }
        a64_svc0(&mut g.e);
        a64_ret(&mut g.e);
    } else {
        rv_mv(&mut g.e, RV_A7, RV_A0);
        var k2: i64 = 0;
        while k2 < 6 {
            rv_mv(&mut g.e, RV_A0 + k2, RV_A0 + k2 + 1);
            k2 = k2 + 1;
        }
        rv_ecall(&mut g.e);
        rv_ret(&mut g.e);
    }

    ng_gen_primitives2(g);

    // nat_start_sp() -> the stack pointer the process started with
    var ssp: i64 = NatEnc_label(&mut g.e);
    HashMap_insert(g.fn_labels, "nat_start_sp", ssp);
    g.fn_label_names.push("nat_start_sp");
    NatEnc_place(&mut g.e, ssp);
    if ng_a64(g) {
        a64_addr(&mut g.e, g.t0, g.start_sp_label);
        a64_ldr(&mut g.e, 0, g.t0, 0);
        a64_ret(&mut g.e);
    } else {
        rv_addr(&mut g.e, g.t0, g.start_sp_label);
        rv_load(&mut g.e, RV_A0, g.t0, 0, 8, true);
        rv_ret(&mut g.e);
    }
}

/// Start primitive `name`: its label, aligned and placed.
fn ng_prim(g: &mut NatGen, name: str) -> i64 {
    var l: i64 = NatEnc_label(&mut g.e);
    HashMap_insert(g.fn_labels, name, l);
    g.fn_label_names.push(name);
    NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
    NatEnc_place(&mut g.e, l);
    return l;
}

/// F8: `name` is one of the image's own machine-code primitives (a
/// `nat_*` name ng_prim has placed), not a C function to import.
fn ng_is_own_prim(g: &NatGen, name: str) -> bool {
    return str_starts_with(name, "nat_") && HashMap_contains(g.fn_labels, name);
}

/// RL2: `name` is declared `extern` (core's `extern fn p_sensitive_check`,
/// `_free`, `_remark`) but the runtime defines it as a builtin (ng_resolve
/// finds linux_runtime's pert_sensitive_*), so it is a call into the image,
/// not a C function to import. CI2 bound these through ld.so: every native
/// Linux executable that used a Vec imported them from libc.so.6 and
/// stopped at load (stage 0 on x86_64/aarch64/riscv64-linux; the nat_*
/// half is ng_is_own_prim).
fn ng_is_runtime_builtin(g: &NatGen, name: str) -> bool {
    var r: str = ng_resolve(g, name);
    return r != name && ng_has_fn(g, r);
}

/// MI20: the interface of the runtime's machine-code primitives — the
/// `nat_*` names every machine-layer target (Linux AArch64 / RISC-V /
/// x86-64, `--nat` Windows, macOS) defines, whatever generator makes them
/// (ng_gen_primitives_x64_linux / _x64_common / _win / _mac,
/// ng_gen_primitives, ng_gen_primitives2, ng_prim_ctx_swap,
/// ng_prim_task_tramp), and the only names stdlib/linux_runtime calls them
/// by. Grouped: system calls and threads; atomics; tasks; traces; the
/// rest. Target-only helpers (nat_win_call, nat_mac_call, the thread
/// trampolines of those) are not part of it.
fn nat_prim_interface() -> Vec<str> {
    // one list with pe_ir (pe_ir_stubs.fd prim_interface_names)
    return prim_interface_names();
}

/// MI20 (FID_VERIFY=1, after ng_gen_primitives): "" when every name of
/// nat_prim_interface has a label, else the missing ones.
fn ng_prim_check(g: &NatGen) -> str {
    var names: Vec<str> = nat_prim_interface();
    var missing: str = "";
    var i: i64 = 0;
    while i < names.len() {
        if !HashMap_contains(g.fn_labels, names.get(i)) {
            if missing != "" {
                missing = missing + ", ";
            }
            missing = missing + names.get(i);
        }
        i = i + 1;
    }
    if missing == "" {
        return "";
    }
    return "the runtime primitives of this target lack " + missing;
}

// --- Runtime primitives written once (MI19) --------------------------------
// Over the architecture layer (ng_load, ng_store, ng_mov, ng_li,
// ng_call_reg, ng_trap, ng_addr; g.rec is off while primitives are made)
// and the few target facts below: the stack, frame and link registers, how
// sp is adjusted, copied out and set, and a primitive's return. The bytes
// are those of the per-target versions they replaced (x86-64 in
// ng_gen_primitives_x64_common, AArch64 and RISC-V in ng_gen_primitives2).
// What must stay per target stays there: the atomics (lock-prefixed
// instructions, LL/SC, AMOs), thread creation (each kernel's clone or
// the OS's thread call), the thread pointer, signals and the entry point.

/// The stack pointer's register number (rsp, sp, sp).
fn ng_sp_reg(g: &NatGen) -> i64 {
    if ng_x64(g) {
        return 4;
    }
    if ng_a64(g) {
        return A64_SP;
    }
    return RV_SP;
}

/// The frame pointer's register (rbp, x29, s0).
fn ng_fp_reg(g: &NatGen) -> i64 {
    if ng_x64(g) {
        return 5;
    }
    if ng_a64(g) {
        return A64_FP;
    }
    return RV_S0;
}

/// The link register (x30, ra); -1 on x86-64, whose call pushes the
/// return address.
fn ng_lr_reg(g: &NatGen) -> i64 {
    if ng_x64(g) {
        return 0 - 1;
    }
    if ng_a64(g) {
        return 30;
    }
    return RV_RA;
}

/// sp = sp + delta (delta < 0: room below the stack pointer)
fn ng_sp_adjust(g: &mut NatGen, delta: i64) {
    if ng_x64(g) {
        if delta < 0 {
            x64_sub_imm(&mut g.e, 4, 0 - delta);
        } else {
            x64_add_imm(&mut g.e, 4, delta);
        }
        return;
    }
    if ng_a64(g) {
        if delta < 0 {
            a64_sub_imm(&mut g.e, A64_SP, A64_SP, 0 - delta);
        } else {
            a64_add_imm(&mut g.e, A64_SP, A64_SP, delta);
        }
        return;
    }
    rv_addi(&mut g.e, RV_SP, RV_SP, delta);
}

/// *(base + disp) = sp (AArch64's STR cannot name sp: through t0, which
/// a primitive may clobber)
fn ng_store_sp(g: &mut NatGen, base: i64, disp: i64) {
    if ng_a64(g) {
        a64_add_imm(&mut g.e, g.td.t0, A64_SP, 0);
        ng_store(g, base, disp, g.td.t0, 8);
        return;
    }
    ng_store(g, base, disp, ng_sp_reg(g), 8);
}

/// sp = r (AArch64: ADD sp, r, #0, as the ORR of a MOV cannot write sp)
fn ng_set_sp(g: &mut NatGen, r: i64) {
    if ng_a64(g) {
        a64_add_imm(&mut g.e, A64_SP, r, 0);
        return;
    }
    ng_mov(g, ng_sp_reg(g), r);
}

/// The return of a primitive (it keeps no frame of its own).
fn ng_prim_ret(g: &mut NatGen) {
    if ng_x64(g) {
        x64_ret(&mut g.e);
    } else if ng_a64(g) {
        a64_ret(&mut g.e);
    } else {
        rv_ret(&mut g.e);
    }
}

/// nat_ctx_swap(save, sp): save the callee-saved registers (values live in
/// them), the frame pointer and the return address in a record on this
/// stack (12 words of registers, fp at +96, the return address at +104:
/// the link register's, or on x86-64 the one the call pushed, so the
/// record there is 104 bytes below it), *save = sp; switch to `sp` and
/// restore its record. A new task's stack starts as such a record
/// (stdlib/linux_runtime/conc.fd pe_co_new_block): zeros, fp 0, the
/// return address the trampoline, then the entry and its argument.
/// Windows (`--nat`) also carries the TEB's stack fields in the record.
fn ng_prim_ctx_swap(g: &mut NatGen) {
    ng_prim(g, "nat_ctx_swap");
    var sp: i64 = ng_sp_reg(g);
    var lr: i64 = ng_lr_reg(g);
    var size: i64 = 112;
    if lr < 0 {
        size = 104;
    }
    ng_sp_adjust(g, 0 - size);
    var cs: Vec<i64> = ng_callee_saved(g);
    var k: i64 = 0;
    while k < cs.len() {
        ng_store(g, sp, 8 * k, cs.get(k), 8);
        k = k + 1;
    }
    ng_store(g, sp, 96, ng_fp_reg(g), 8);
    if lr >= 0 {
        ng_store(g, sp, 104, lr, 8);
    }
    if g.win {
        // Windows: the TEB's StackBase (gs:8), StackLimit (gs:16) and
        // DeallocationStack (gs:0x1478) travel with the context at +40,
        // +48, +56 (a new task's record has its own stack's: pe_co_new_block),
        // so a task's overflow into its guard page is STATUS_STACK_OVERFLOW
        x64_load_gs(&mut g.e, 11, 8);
        x64_store(&mut g.e, 11, 4, 40, 8);
        x64_load_gs(&mut g.e, 11, 16);
        x64_store(&mut g.e, 11, 4, 48, 8);
        x64_load_gs(&mut g.e, 11, 0x1478);
        x64_store(&mut g.e, 11, 4, 56, 8);
    }
    ng_store_sp(g, ng_argreg(g, 0), 0);
    ng_set_sp(g, ng_argreg(g, 1));
    if g.win {
        x64_load(&mut g.e, 11, 4, 40, 8, true);
        x64_store_gs(&mut g.e, 11, 8);
        x64_load(&mut g.e, 11, 4, 48, 8, true);
        x64_store_gs(&mut g.e, 11, 16);
        x64_load(&mut g.e, 11, 4, 56, 8, true);
        x64_store_gs(&mut g.e, 11, 0x1478);
    }
    k = 0;
    while k < cs.len() {
        ng_load(g, cs.get(k), sp, 8 * k, 8, true);
        k = k + 1;
    }
    ng_load(g, ng_fp_reg(g), sp, 96, 8, true);
    if lr >= 0 {
        ng_load(g, lr, sp, 104, 8, true);
    }
    ng_sp_adjust(g, size);
    ng_prim_ret(g);
}

/// The first switch to a new task "returns" here, with [sp] = entry and
/// [sp + 8] = its argument: entry(env 0, arg), which never returns; and
/// nat_ctx_tramp(), its address (what pe_co_new_block puts in the record).
fn ng_prim_task_tramp(g: &mut NatGen) {
    var sp: i64 = ng_sp_reg(g);
    g.tramp_label = NatEnc_label(&mut g.e);
    NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
    NatEnc_place(&mut g.e, g.tramp_label);
    ng_load(g, g.td.t0, sp, 0, 8, true);
    ng_load(g, ng_argreg(g, 1), sp, 8, 8, true);
    ng_li(g, ng_argreg(g, 0), 0);
    ng_call_reg(g, g.td.t0);
    ng_trap(g);
    ng_prim(g, "nat_ctx_tramp");
    ng_addr(g, ng_argreg(g, 0), g.tramp_label);
    ng_prim_ret(g);
}

/// The primitives of threads, tasks, atomics, and the C math functions
/// that are single instructions.
fn ng_gen_primitives2(g: &mut NatGen) {
    var a64: bool = ng_a64(g);
    // nat_atomic_load(addr) / nat_atomic_store(addr, v): sequentially
    // consistent word access
    ng_prim(g, "nat_atomic_load");
    if a64 {
        a64_ldar(&mut g.e, 0, 0);
        a64_ret(&mut g.e);
    } else {
        rv_fence(&mut g.e);
        rv_load(&mut g.e, RV_A0, RV_A0, 0, 8, true);
        rv_fence(&mut g.e);
        rv_ret(&mut g.e);
    }
    ng_prim(g, "nat_atomic_store");
    if a64 {
        a64_stlr(&mut g.e, 1, 0);
        a64_dmb(&mut g.e);
        a64_ret(&mut g.e);
    } else {
        rv_fence(&mut g.e);
        rv_store(&mut g.e, RV_A0 + 1, RV_A0, 0, 8);
        rv_fence(&mut g.e);
        rv_ret(&mut g.e);
    }
    // nat_atomic_add(addr, v) -> the previous value
    ng_prim(g, "nat_atomic_add");
    if a64 {
        a64_ldaxr(&mut g.e, 9, 0);
        // retry:
        a64_add(&mut g.e, 10, 9, 1);
        a64_stlxr(&mut g.e, 11, 10, 0);
        a64_cbnz_w_words(&mut g.e, 11, 0 - 3);
        a64_mov(&mut g.e, 0, 9);
        a64_ret(&mut g.e);
    } else {
        rv_amoadd_d(&mut g.e, RV_A0, RV_A0 + 1, RV_A0);
        rv_ret(&mut g.e);
    }
    // nat_atomic_cas(addr, expected, new) -> 1 when *addr was expected (and
    // is now new), else 0
    ng_prim(g, "nat_atomic_cas");
    if a64 {
        a64_ldaxr(&mut g.e, 9, 0);
        // retry:
        a64_cmp(&mut g.e, 9, 1);
        a64_bcond_words(&mut g.e, A64_NE, 5);
        // -> fail
        a64_stlxr(&mut g.e, 11, 2, 0);
        a64_cbnz_w_words(&mut g.e, 11, 0 - 4);
        // -> retry
        a64_li(&mut g.e, 0, 1);
        a64_ret(&mut g.e);
        a64_clrex(&mut g.e);
        // fail:
        a64_li(&mut g.e, 0, 0);
        a64_ret(&mut g.e);
    } else {
        rv_lr_d(&mut g.e, 6, RV_A0);
        // retry: t1 = *a0
        rv_b_off(&mut g.e, RV_BNE, 6, RV_A0 + 1, 20);
        // -> fail
        rv_sc_d(&mut g.e, 7, RV_A0 + 2, RV_A0);
        rv_b_off(&mut g.e, RV_BNE, 7, RV_ZERO, 0 - 12);
        // -> retry
        rv_addi(&mut g.e, RV_A0, RV_ZERO, 1);
        rv_ret(&mut g.e);
        rv_addi(&mut g.e, RV_A0, RV_ZERO, 0);
        // fail:
        rv_ret(&mut g.e);
    }

    // nat_ctx_swap and the task trampoline: one generator for every
    // machine-layer target (MI19, ng_prim_ctx_swap / ng_prim_task_tramp)
    ng_prim_ctx_swap(g);
    ng_prim_task_tramp(g);

    // nat_clone_thread, nat_tls_get/set: macOS defines its own
    // (ng_gen_primitives_mac); here they are the Linux ones.
    if !g.mac {
        // nat_clone_thread(entry, arg, stack_top, ctid, tls) -> tid: a thread
        // sharing the address space, files and signal handlers, its thread
        // pointer `tls`, that runs entry(env 0, arg) on its own stack and exits.
        // The kernel zeroes the 32-bit word at ctid and wakes its futex once the
        // thread is gone (CLONE_CHILD_CLEARTID): then its stack may be freed.
        ng_prim(g, "nat_clone_thread");
        // VM | FS | FILES | SIGHAND | THREAD | SYSVSEM | SETTLS | CHILD_CLEARTID
        var flags: i64 = 0x2D0F00;
        if a64 {
            a64_sub_imm(&mut g.e, 9, 2, 16);
            a64_str(&mut g.e, 0, 9, 0);
            a64_str(&mut g.e, 1, 9, 8);
            a64_mov(&mut g.e, 10, 3);
            a64_mov(&mut g.e, 11, 4);
            a64_li(&mut g.e, 0, flags);
            a64_mov(&mut g.e, 1, 9);
            a64_li(&mut g.e, 2, 0);
            a64_mov(&mut g.e, 3, 11);
            // tls
            a64_mov(&mut g.e, 4, 10);
            // child tid
            a64_li(&mut g.e, 8, 220);
            // clone
            a64_svc0(&mut g.e);
            var parent: i64 = NatEnc_label(&mut g.e);
            a64_cbnz(&mut g.e, 0, parent);
            a64_ldr(&mut g.e, 9, A64_SP, 0);
            a64_ldr(&mut g.e, 1, A64_SP, 8);
            a64_li(&mut g.e, 0, 0);
            a64_li(&mut g.e, A64_FP, 0);
            a64_blr(&mut g.e, 9);
            a64_li(&mut g.e, 0, 0);
            a64_li(&mut g.e, 8, 93);
            // exit (this thread)
            a64_svc0(&mut g.e);
            a64_brk(&mut g.e);
            NatEnc_place(&mut g.e, parent);
            a64_ret(&mut g.e);
        } else {
            rv_addi(&mut g.e, 6, RV_A0 + 2, 0 - 16);
            rv_store(&mut g.e, RV_A0, 6, 0, 8);
            rv_store(&mut g.e, RV_A0 + 1, 6, 8, 8);
            rv_mv(&mut g.e, 28, RV_A0 + 3);
            rv_mv(&mut g.e, 29, RV_A0 + 4);
            rv_li(&mut g.e, RV_A0, flags);
            rv_mv(&mut g.e, RV_A0 + 1, 6);
            rv_addi(&mut g.e, RV_A0 + 2, RV_ZERO, 0);
            rv_mv(&mut g.e, RV_A0 + 3, 29);
            // tls
            rv_mv(&mut g.e, RV_A0 + 4, 28);
            // child tid
            rv_li(&mut g.e, RV_A7, 220);
            rv_ecall(&mut g.e);
            var rparent: i64 = NatEnc_label(&mut g.e);
            ng_bnez(g, RV_A0, rparent);
            rv_load(&mut g.e, 6, RV_SP, 0, 8, true);
            rv_load(&mut g.e, RV_A0 + 1, RV_SP, 8, 8, true);
            rv_addi(&mut g.e, RV_A0, RV_ZERO, 0);
            rv_addi(&mut g.e, RV_S0, RV_ZERO, 0);
            rv_jalr(&mut g.e, RV_RA, 6, 0);
            rv_addi(&mut g.e, RV_A0, RV_ZERO, 0);
            rv_li(&mut g.e, RV_A7, 93);
            rv_ecall(&mut g.e);
            rv_ebreak(&mut g.e);
            NatEnc_place(&mut g.e, rparent);
            rv_ret(&mut g.e);
        }

        // nat_tls_get() / nat_tls_set(v): the thread pointer (TPIDR_EL0, tp),
        // the runtime's per-thread block
        ng_prim(g, "nat_tls_get");
        if a64 {
            NatEnc_word(&mut g.e, 0xD53BD040);
            a64_ret(&mut g.e);
        }  // mrs x0, tpidr_el0
        else {
            rv_addi(&mut g.e, RV_A0, 4, 0);
            rv_ret(&mut g.e);
        }
        ng_prim(g, "nat_tls_set");
        if a64 {
            NatEnc_word(&mut g.e, 0xD51BD040);
            a64_ret(&mut g.e);
        }  // msr tpidr_el0, x0
        else {
            rv_addi(&mut g.e, 4, RV_A0, 0);
            rv_ret(&mut g.e);
        }
    }

    // nat_frame_fp() -> the caller's frame pointer (a trace starts there)
    ng_prim(g, "nat_frame_fp");
    if a64 {
        a64_mov(&mut g.e, 0, A64_FP);
        a64_ret(&mut g.e);
    } else {
        rv_mv(&mut g.e, RV_A0, RV_S0);
        rv_ret(&mut g.e);
    }

    // nat_frame_ret(fp) / nat_frame_next(fp): a frame record's return
    // address and the caller's frame pointer (AArch64: [fp + 8], [fp];
    // RISC-V: [s0 - 8], [s0 - 16])
    ng_prim(g, "nat_frame_ret");
    if a64 {
        a64_ldr(&mut g.e, 0, 0, 8);
        a64_ret(&mut g.e);
    } else {
        rv_load(&mut g.e, RV_A0, RV_A0, 0 - 8, 8, true);
        rv_ret(&mut g.e);
    }
    ng_prim(g, "nat_frame_next");
    if a64 {
        a64_ldr(&mut g.e, 0, 0, 0);
        a64_ret(&mut g.e);
    } else {
        rv_load(&mut g.e, RV_A0, RV_A0, 0 - 16, 8, true);
        rv_ret(&mut g.e);
    }

    // nat_fn_names() -> [address, name]* then [end of code, 0]
    ng_prim(g, "nat_fn_names");
    ng_addr(g, ng_argreg(g, 0), g.names_label);
    if a64 {
        a64_ret(&mut g.e);
    } else {
        rv_ret(&mut g.e);
    }

    // The signal handler (sig, info, ucontext): the runtime's
    // pe_on_signal(sig, info); nat_sig_handler() -> its address. macOS
    // defines its own (ng_gen_primitives_mac).
    if !g.mac {
        var sig_entry: i64 = NatEnc_label(&mut g.e);
        NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
        NatEnc_place(&mut g.e, sig_entry);
        var sig_fn: str = ng_sig_fn(g);
        if sig_fn != "" {
            // DB9: the ucontext goes on as the third argument (it is
            // ignored by pe_on_signal, read by pe_on_signal_uc)
            var on_sig: i64 = ng_fn_label(g, sig_fn);
            if a64 {
                NatEnc_word(&mut g.e, 0xA9BF7BFD);
                // stp x29, x30, [sp, #-16]!
                a64_add_imm(&mut g.e, A64_FP, A64_SP, 0);
                a64_mov(&mut g.e, 3, 2);
                a64_mov(&mut g.e, 2, 1);
                a64_mov(&mut g.e, 1, 0);
                a64_li(&mut g.e, 0, 0);
                a64_bl(&mut g.e, on_sig);
                NatEnc_word(&mut g.e, 0xA8C17BFD);
                // ldp x29, x30, [sp], #16
                a64_ret(&mut g.e);
            } else {
                rv_addi(&mut g.e, RV_SP, RV_SP, 0 - 16);
                rv_store(&mut g.e, RV_RA, RV_SP, 8, 8);
                rv_store(&mut g.e, RV_S0, RV_SP, 0, 8);
                rv_addi(&mut g.e, RV_S0, RV_SP, 16);
                rv_mv(&mut g.e, RV_A0 + 3, RV_A0 + 2);
                rv_mv(&mut g.e, RV_A0 + 2, RV_A0 + 1);
                rv_mv(&mut g.e, RV_A0 + 1, RV_A0);
                rv_addi(&mut g.e, RV_A0, RV_ZERO, 0);
                rv_call(&mut g.e, on_sig);
                rv_load(&mut g.e, RV_RA, RV_SP, 8, 8, true);
                rv_load(&mut g.e, RV_S0, RV_SP, 0, 8, true);
                rv_addi(&mut g.e, RV_SP, RV_SP, 16);
                rv_ret(&mut g.e);
            }
        } else {
            if a64 {
                a64_ret(&mut g.e);
            } else {
                rv_ret(&mut g.e);
            }
        }
        ng_prim(g, "nat_sig_handler");
        ng_addr(g, ng_argreg(g, 0), sig_entry);
        if a64 {
            a64_ret(&mut g.e);
        } else {
            rv_ret(&mut g.e);
        }
    }

    // nat_arch() -> the target (1 AArch64, 2 RISC-V 64): for the few
    // structures whose layout differs between them and x86-64
    ng_prim(g, "nat_arch");
    ng_li(g, ng_argreg(g, 0), g.arch);
    if a64 {
        a64_ret(&mut g.e);
    } else {
        rv_ret(&mut g.e);
    }

    if !g.mac {
        // nat_sig_restorer() -> 0: the kernel returns from handlers itself here
        ng_prim(g, "nat_sig_restorer");
        ng_li(g, ng_argreg(g, 0), 0);
        if a64 {
            a64_ret(&mut g.e);
        } else {
            rv_ret(&mut g.e);
        }
        // nat_os() -> 0: Linux
        ng_prim(g, "nat_os");
        ng_li(g, ng_argreg(g, 0), 0);
        if a64 {
            a64_ret(&mut g.e);
        } else {
            rv_ret(&mut g.e);
        }
    }

    // nat_fma(a, b, c) -> a * b + c rounded once (bits)
    ng_prim(g, "nat_fma");
    if a64 {
        a64_fmov_dx(&mut g.e, 0, 0);
        a64_fmov_dx(&mut g.e, 1, 1);
        a64_fmov_dx(&mut g.e, 2, 2);
        NatEnc_word(&mut g.e, 0x1F400000 | (1 << 16) | (2 << 10) | (0 << 5) | 0);
        // fmadd d0, d0, d1, d2
        a64_fmov_xd(&mut g.e, 0, 0);
        a64_ret(&mut g.e);
    } else {
        rv_fmv_dx(&mut g.e, 0, RV_A0);
        rv_fmv_dx(&mut g.e, 1, RV_A0 + 1);
        rv_fmv_dx(&mut g.e, 2, RV_A0 + 2);
        NatEnc_word(&mut g.e, (2 << 27) | (1 << 25) | (1 << 20) | (0 << 15) | (7 << 12) | (0 << 7) | 0x43);
        // fmadd.d f0, f0, f1, f2
        rv_fmv_xd(&mut g.e, RV_A0, 0);
        rv_ret(&mut g.e);
    }

    // nat_call_fn(addr, nargs, argv) -> the result of the Fides function at
    // addr, called with a null __env and argv[0..8]
    ng_prim(g, "nat_call_fn");
    if a64 {
        NatEnc_word(&mut g.e, 0xA9BF7BFD);
        // stp x29, x30, [sp, #-16]!
        a64_add_imm(&mut g.e, A64_FP, A64_SP, 0);
        a64_sub_imm(&mut g.e, A64_SP, A64_SP, 16);
        a64_mov(&mut g.e, 9, 0);
        a64_mov(&mut g.e, 10, 2);
        a64_ldr(&mut g.e, 11, 10, 56);
        a64_str(&mut g.e, 11, A64_SP, 0);
        // argument 8: the stack
        var k: i64 = 1;
        while k < 8 {
            a64_ldr(&mut g.e, k, 10, (k - 1) * 8);
            k = k + 1;
        }
        a64_li(&mut g.e, 0, 0);
        a64_blr(&mut g.e, 9);
        a64_add_imm(&mut g.e, A64_SP, A64_FP, 0);
        NatEnc_word(&mut g.e, 0xA8C17BFD);
        // ldp x29, x30, [sp], #16
        a64_ret(&mut g.e);
    } else {
        rv_addi(&mut g.e, RV_SP, RV_SP, 0 - 32);
        rv_store(&mut g.e, RV_RA, RV_SP, 24, 8);
        rv_store(&mut g.e, RV_S0, RV_SP, 16, 8);
        rv_addi(&mut g.e, RV_S0, RV_SP, 32);
        rv_mv(&mut g.e, 6, RV_A0);
        rv_mv(&mut g.e, 7, RV_A0 + 2);
        rv_load(&mut g.e, 28, 7, 56, 8, true);
        rv_store(&mut g.e, 28, RV_SP, 0, 8);
        // argument 8: the stack
        var k2: i64 = 1;
        while k2 < 8 {
            rv_load(&mut g.e, RV_A0 + k2, 7, (k2 - 1) * 8, 8, true);
            k2 = k2 + 1;
        }
        rv_addi(&mut g.e, RV_A0, RV_ZERO, 0);
        rv_jalr(&mut g.e, RV_RA, 6, 0);
        rv_load(&mut g.e, RV_RA, RV_SP, 24, 8, true);
        rv_load(&mut g.e, RV_S0, RV_SP, 16, 8, true);
        rv_addi(&mut g.e, RV_SP, RV_SP, 32);
        rv_ret(&mut g.e);
    }

    // nat_fn_table() -> [name, address]*, 0: the functions named by strings
    ng_prim(g, "nat_fn_table");
    ng_addr(g, ng_argreg(g, 0), g.fn_table_label);
    if a64 {
        a64_ret(&mut g.e);
    } else {
        rv_ret(&mut g.e);
    }

    // C math functions that are one instruction: nat_c_<name>(bits) -> bits
    var mops: Vec<str> = Vec::new();
    mops.push("sqrt");
    mops.push("fabs");
    mops.push("floor");
    mops.push("ceil");
    mops.push("trunc");
    mops.push("round");
    var mi: i64 = 0;
    while mi < mops.len() {
        var op: str = mops.get(mi);
        ng_prim(g, "nat_c_" + op);
        if a64 {
            a64_fmov_dx(&mut g.e, 0, 0);
            if op == "sqrt" {
                a64_fsqrt(&mut g.e, 0, 0);
            }
            if op == "fabs" {
                a64_fabs(&mut g.e, 0, 0);
            }
            if op == "floor" {
                a64_frintm(&mut g.e, 0, 0);
            }
            if op == "ceil" {
                a64_frintp(&mut g.e, 0, 0);
            }
            if op == "trunc" {
                a64_frintz(&mut g.e, 0, 0);
            }
            if op == "round" {
                a64_frinta(&mut g.e, 0, 0);
            }
            a64_fmov_xd(&mut g.e, 0, 0);
            a64_ret(&mut g.e);
        } else {
            rv_fmv_dx(&mut g.e, 0, RV_A0);
            if op == "sqrt" {
                rv_fsqrt_d(&mut g.e, 0, 0);
            } else if op == "fabs" {
                rv_fsgnjx_d(&mut g.e, 0, 0, 0);
            } else {
                // |x| >= 2^52 or NaN: already integral; else through an
                // integer in the rounding mode, keeping the sign of zero
                var rm: i64 = 2;
                if op == "ceil" {
                    rm = 3;
                }
                if op == "trunc" {
                    rm = 1;
                }
                if op == "round" {
                    rm = 4;
                }
                rv_li(&mut g.e, 6, 4841369599423283200);
                // 2^52
                rv_fmv_dx(&mut g.e, 1, 6);
                rv_fsgnjx_d(&mut g.e, 2, 0, 0);
                rv_flt_d(&mut g.e, 7, 2, 1);
                var done: i64 = NatEnc_label(&mut g.e);
                ng_beqz(g, 7, done);
                rv_fcvt_ld_rm(&mut g.e, 28, 0, rm);
                rv_fcvt_dl(&mut g.e, 3, 28);
                rv_fsgnj_d(&mut g.e, 0, 3, 0);
                NatEnc_place(&mut g.e, done);
            }
            rv_fmv_xd(&mut g.e, RV_A0, 0);
            rv_ret(&mut g.e);
        }
        mi = mi + 1;
    }
}

/// The stub panic `which` calls: with " at line N" for the messages the
/// interpreter prints with a line and no operands (division by zero,
/// modulo by zero, division overflow), when the instruction has one;
/// `FID_NAT_OFF=panicline`: never.
fn ng_panic_label(g: &mut NatGen, which: i64) -> i64 {
    var line: i64 = g.cur_inst_line;
    if line <= 0 || which < NP_DIV_OVF || !ng_on("panicline") {
        return g.panic_labels.get(which);
    }
    var key: str = int_to_str(which) + ":" + int_to_str(line);
    if HashMap_contains(g.pl_keys, key) {
        return HashMap_get(g.pl_keys, key);
    }
    var l: i64 = NatEnc_label(&mut g.e);
    HashMap_insert(g.pl_keys, key, l);
    g.pl_names.push(key);
    g.pl_list.push(which);
    g.pl_list.push(line);
    g.pl_list.push(l);
    return l;
}

/// The source line of instruction id (0: none).
fn ng_meta_line(func: &IrFunction, id: i64) -> i64 {
    match IrFunction_get_meta(func, id) {
        OptValueMeta::Some(m) => {
            match m.source_line {
                OptU64::Some(v) => {
                    return v as i64;
                }
                OptU64::None => {
                }
            }
        }
        OptValueMeta::None => {
        }
    }
    return 0;
}

/// The stubs of panics with a line (after the code: they are known once
/// every function is emitted).
fn ng_gen_panic_line_stubs(g: &mut NatGen) {
    var msgs: Vec<str> = nat_panic_messages();
    var i: i64 = 0;
    while i + 2 < g.pl_list.len() {
        var which: i64 = g.pl_list.get(i);
        var line: i64 = g.pl_list.get(i + 1);
        NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
        NatEnc_place(&mut g.e, g.pl_list.get(i + 2));
        ng_panic_stub_body(g, msgs.get(which) + " at line " + int_to_str(line));
        i = i + 3;
    }
}

fn ng_panic_stub_body(g: &mut NatGen, msg: str) {
    if ng_x64(g) {
        x64_push(&mut g.e, 5);
        x64_mov(&mut g.e, 5, 4);
    } else if ng_a64(g) {
        NatEnc_word(&mut g.e, 0xA9BF7BFD);
        // stp x29, x30, [sp, #-16]!
        a64_add_imm(&mut g.e, A64_FP, A64_SP, 0);
    } else {
        rv_addi(&mut g.e, RV_SP, RV_SP, 0 - 16);
        rv_store(&mut g.e, RV_RA, RV_SP, 8, 8);
        rv_store(&mut g.e, RV_S0, RV_SP, 0, 8);
        rv_addi(&mut g.e, RV_S0, RV_SP, 16);
    }
    ng_addr(g, ng_argreg(g, 0), ng_str_label(g, msg));
    ng_call_builtin(g, "p_panic", 1);
    ng_trap(g);
}

fn ng_gen_panic_stubs(g: &mut NatGen) {
    var msgs: Vec<str> = nat_panic_messages();
    var i: i64 = 0;
    while i < msgs.len() {
        NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
        NatEnc_place(&mut g.e, g.panic_labels.get(i));
        // A frame record, so the trace walk sees the caller
        if ng_x64(g) {
            x64_push(&mut g.e, 5);
            x64_mov(&mut g.e, 5, 4);
        } else if ng_a64(g) {
            NatEnc_word(&mut g.e, 0xA9BF7BFD);
            // stp x29, x30, [sp, #-16]!
            a64_add_imm(&mut g.e, A64_FP, A64_SP, 0);
        } else {
            rv_addi(&mut g.e, RV_SP, RV_SP, 0 - 16);
            rv_store(&mut g.e, RV_RA, RV_SP, 8, 8);
            rv_store(&mut g.e, RV_S0, RV_SP, 0, 8);
            rv_addi(&mut g.e, RV_S0, RV_SP, 16);
        }
        ng_addr(g, ng_argreg(g, 0), ng_str_label(g, msgs.get(i)));
        ng_call_builtin(g, "p_panic", 1);
        ng_trap(g);
        i = i + 1;
    }
}

/// The strings and globals after the code, each 8-aligned.
fn ng_gen_data(g: &mut NatGen, module: &IrModule) {
    NatEnc_align(&mut g.e, 8);
    NatEnc_place(&mut g.e, g.start_sp_label);
    NatEnc_quad(&mut g.e, 0);
    var gi: i64 = 0;
    while gi < g.globs.len() {
        var gname: str = g.globs.get(gi);
        NatEnc_align(&mut g.e, 8);
        NatEnc_place(&mut g.e, HashMap_get(g.glob_labels, gname));
        var size: i64 = 8;
        var bits: i64 = 0;
        var str_label: i64 = 0;
        var f32_init: bool = false;
        match IrModule_get_global(module, gname) {
            OptGlobalLookup::Some(gty, init_expr) => {
                size = IrModule_type_size(module, gty);
                if size < 8 {
                    size = 8;
                }
                size = (size + 7) & (0 - 8);
                match init_expr {
                    Expr::IntLit(v) => {
                        bits = v;
                    }
                    Expr::BoolLit(b) => {
                        if b {
                            bits = 1;
                        }
                    }
                    Expr::FloatLit(f) => {
                        if ir_type_eq(gty, IrType::F32) {
                            bits = p_f32_to_bits(f) & 0xFFFFFFFF;
                        } else {
                            bits = p_f64_to_bits(f);
                        }
                    }
                    Expr::StringLit(s) => {
                        str_label = ng_str_label(g, s);
                    }
                    _ => {
                    }
                }
            }
            OptGlobalLookup::None => {
            }
        }
        // RL16: the runtime's allocator mode, from --checked-alloc / --leaks
        if gname == "lrt_mem_mode" || str_ends_with(gname, "::lrt_mem_mode") {
            bits = ng_mem_mode();
        }
        if str_label != 0 {
            NatEnc_fix(&mut g.e, str_label, NATFIX_ABS64);
        }
        NatEnc_quad(&mut g.e, bits);
        var k: i64 = 8;
        while k < size {
            NatEnc_byte(&mut g.e, 0);
            k = k + 1;
        }
        gi = gi + 1;
    }
    // Panic traces: [address, name] per function in placement order, then
    // [end of code, 0]
    NatEnc_align(&mut g.e, 8);
    NatEnc_place(&mut g.e, g.names_label);
    var ni: i64 = 0;
    while ni < g.placed_fns.len() {
        var pname: str = g.placed_fns.get(ni);
        NatEnc_fix(&mut g.e, HashMap_get(g.fn_labels, pname), NATFIX_ABS64);
        NatEnc_quad(&mut g.e, 0);
        NatEnc_fix(&mut g.e, ng_str_label(g, pname), NATFIX_ABS64);
        NatEnc_quad(&mut g.e, 0);
        ni = ni + 1;
    }
    NatEnc_fix(&mut g.e, g.code_end_label, NATFIX_ABS64);
    NatEnc_quad(&mut g.e, 0);
    NatEnc_quad(&mut g.e, 0);
    // CE8 (`-g`): the frame table a panic reads, right after it
    if ng_dbg_frames_on() {
        ng_dbg_frames_data(g);
    }
    // The functions named by strings: [name, address] pairs, then 0, 0
    NatEnc_align(&mut g.e, 8);
    NatEnc_place(&mut g.e, g.fn_table_label);
    var ti: i64 = 0;
    while ti < g.named_fns.len() {
        var fname: str = g.named_fns.get(ti);
        NatEnc_fix(&mut g.e, ng_str_label(g, fname), NATFIX_ABS64);
        NatEnc_quad(&mut g.e, 0);
        NatEnc_fix(&mut g.e, HashMap_get(g.fn_labels, fname), NATFIX_ABS64);
        NatEnc_quad(&mut g.e, 0);
        ti = ti + 1;
    }
    NatEnc_quad(&mut g.e, 0);
    NatEnc_quad(&mut g.e, 0);
    // Strings last: a global's initializer may have added one
    var si: i64 = 0;
    while si < g.strs.len() {
        var s: str = g.strs.get(si);
        NatEnc_align(&mut g.e, 8);
        var n: i64 = str_len(s);
        // RT2: [static magic][length] before the bytes, as pe_ir's .rdata
        // and the C string table: the length comes from the literal, so a
        // zero byte inside it is kept, and str_len is O(1)
        NatEnc_quad(&mut g.e, 0x4649444553545202);
        NatEnc_quad(&mut g.e, n);
        NatEnc_place(&mut g.e, HashMap_get(g.str_labels, s));
        var bi: i64 = 0;
        while bi < n {
            NatEnc_byte(&mut g.e, str_byte_at(s, bi));
            bi = bi + 1;
        }
        NatEnc_byte(&mut g.e, 0);
        si = si + 1;
    }
}

/// The dyn types: every type made into a dyn value or named by a trait
/// impl, sorted (as pe_ir finds DynCall candidates).
fn ng_collect_dyn_types(g: &mut NatGen, module: &IrModule) {
    var types: Vec<str> = Vec::new();
    var ti: i64 = 0;
    while ti < module.trait_impls.len() {
        var items: Vec<str> = module.trait_impls.get(ti).items;
        var ii: i64 = 0;
        while ii < items.len() {
            types = ng_insert_sorted(types, items.get(ii));
            ii = ii + 1;
        }
        ti = ti + 1;
    }
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var f: IrFunction = module.functions.get(fi).func;
        var k: i64 = 0;
        while k < f.insts.len() {
            match f.insts.get(k).inst {
                Inst::MakeDyn(_, tname, _) => {
                    types = ng_insert_sorted(types, tname);
                }
                _ => {
                }
            }
            k = k + 1;
        }
        fi = fi + 1;
    }
    g.dyn_types = types;
}

// ===========================================================================
// Entry point
// ===========================================================================

/// A backend switch that is off unless FID_NAT_ON names it.
fn ng_opt_in(name: str) -> bool {
    if g_ng_env_ok {
        return str_len(g_ng_env_on) > 0 && str_contains(g_ng_env_on, "," + name + ",");
    }
    var on: str = p_getenv("FID_NAT_ON");
    if (on as i64) == 0 || str_len(on) == 0 {
        return false;
    }
    return str_contains("," + on + ",", "," + name + ",");
}

/// TG14: a position-independent Linux executable? The driver's `--pie` /
/// `--no-pie` (g_nat_pie_req) first, else FID_NAT_ON=pie (FID_NAT_OFF=pie
/// wins over both, to compare).
pub fn nat_pie_wanted() -> bool {
    if !ng_on("pie") {
        return false;
    }
    if g_nat_pie_req > 0 {
        return true;
    }
    if g_nat_pie_req < 0 {
        return false;
    }
    // TG14: PIE is the default on Linux targets (since Nov 22): --pie /
    // --no-pie override; FID_NAT_OFF=pie turns it off for a comparison
    return true;
}

/// TG14: the first thing a position-independent executable's _start does.
/// The image runs wherever the kernel mapped it, but its absolute words
/// (NATFIX_ABS64: the function and name tables, string and global
/// addresses in data) hold link addresses. The table (ng_gen_pie_table)
/// starts with its own link address, so the load bias is the table's
/// pc-relative address minus that word; then come the count and the link
/// address of each absolute word, to each of which the bias is added. Only
/// registers no one reads at entry are used, and not the stack.
fn ng_gen_pie_reloc(g: &mut NatGen) {
    if g.pie_table == 0 {
        return;
    }
    var top: i64 = NatEnc_label(&mut g.e);
    var done: i64 = NatEnc_label(&mut g.e);
    if ng_x64(g) {
        // rsi = table, r8 = bias, rcx = count; rdi the word's address, r9 it
        x64_lea_label(&mut g.e, 6, g.pie_table);
        x64_load(&mut g.e, 7, 6, 0, 8, true);
        x64_mov(&mut g.e, 8, 6);
        x64_alu(&mut g.e, 0x29, 8, 7);
        x64_load(&mut g.e, 1, 6, 8, 8, true);
        x64_add_imm(&mut g.e, 6, 16);
        NatEnc_place(&mut g.e, top);
        x64_test(&mut g.e, 1, 1);
        x64_jcc(&mut g.e, X64_E, done);
        x64_load(&mut g.e, 7, 6, 0, 8, true);
        x64_alu(&mut g.e, 0x01, 7, 8);
        x64_load(&mut g.e, 9, 7, 0, 8, true);
        x64_alu(&mut g.e, 0x01, 9, 8);
        x64_store(&mut g.e, 9, 7, 0, 8);
        x64_add_imm(&mut g.e, 6, 8);
        x64_sub_imm(&mut g.e, 1, 1);
        x64_jmp(&mut g.e, top);
        NatEnc_place(&mut g.e, done);
        return;
    }
    if ng_a64(g) {
        // x9 = table, x11 = bias, x12 = count; x13 the word's address, x14 it
        a64_addr(&mut g.e, 9, g.pie_table);
        a64_ldr(&mut g.e, 10, 9, 0);
        a64_sub(&mut g.e, 11, 9, 10);
        a64_ldr(&mut g.e, 12, 9, 8);
        a64_add_imm(&mut g.e, 9, 9, 16);
        NatEnc_place(&mut g.e, top);
        a64_cbz(&mut g.e, 12, done);
        a64_ldr(&mut g.e, 13, 9, 0);
        a64_add(&mut g.e, 13, 13, 11);
        a64_ldr(&mut g.e, 14, 13, 0);
        a64_add(&mut g.e, 14, 14, 11);
        a64_str(&mut g.e, 14, 13, 0);
        a64_add_imm(&mut g.e, 9, 9, 8);
        a64_sub_imm(&mut g.e, 12, 12, 1);
        a64_b(&mut g.e, top);
        NatEnc_place(&mut g.e, done);
        return;
    }
    // RISC-V: t1 (x6) = table, t3 (x28) = bias, t4 (x29) = count; t2 (x7)
    // the word's address, t5 (x30) it
    rv_addr(&mut g.e, 6, g.pie_table);
    rv_load(&mut g.e, 7, 6, 0, 8, true);
    rv_sub(&mut g.e, 28, 6, 7);
    rv_load(&mut g.e, 29, 6, 8, 8, true);
    rv_addi(&mut g.e, 6, 6, 16);
    NatEnc_place(&mut g.e, top);
    rv_b_off(&mut g.e, RV_BNE, 29, RV_ZERO, 8);
    rv_jal(&mut g.e, RV_ZERO, done);
    rv_load(&mut g.e, 7, 6, 0, 8, true);
    rv_add(&mut g.e, 7, 7, 28);
    rv_load(&mut g.e, 30, 7, 0, 8, true);
    rv_add(&mut g.e, 30, 30, 28);
    rv_store(&mut g.e, 30, 7, 0, 8);
    rv_addi(&mut g.e, 6, 6, 8);
    rv_addi(&mut g.e, 29, 29, 0 - 1);
    rv_jal(&mut g.e, RV_ZERO, top);
    NatEnc_place(&mut g.e, done);
}

/// TG14: the relocation table of a position-independent executable, after
/// every absolute word is in the image: [its own link address (an ABS64
/// word, itself not in the list)] [count] [link address of each ABS64
/// word]. The words in the list are the fixups recorded so far, so this
/// comes after the data (and the Windows imports, which PIE never has).
fn ng_gen_pie_table(g: &mut NatGen) {
    if g.pie_table == 0 {
        return;
    }
    var words: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < g.e.fixups.len() {
        if g.e.fixups.get(i).kind == NATFIX_ABS64 {
            words.push(g.e.fixups.get(i).pos);
        }
        i = i + 1;
    }
    NatEnc_align(&mut g.e, 8);
    NatEnc_place(&mut g.e, g.pie_table);
    NatEnc_fix(&mut g.e, g.pie_table, NATFIX_ABS64);
    NatEnc_quad(&mut g.e, 0);
    NatEnc_quad(&mut g.e, words.len());
    i = 0;
    while i < words.len() {
        NatEnc_quad(&mut g.e, g_nat_abs_base + words.get(i));
        i = i + 1;
    }
}

/// `target`: "aarch64-linux" or "riscv64-linux" (also "arm64-linux",
/// "riscv-linux", "arm64", "riscv64").
pub fn nat_target_arch(target: str) -> i64 {
    // PL5: ARMv7-M (Cortex-M3) through compiler/nat_thumb.fd:
    // "thumbv7m-none" (no OS: a board image) or "thumbv7m-linux" (qemu-arm)
    if str_starts_with(target, "thumbv7m") || str_starts_with(target, "thumb") {
        g_nat_thumb_bare = !str_contains(target, "linux");
        return NAT_THUMB;
    }
    if str_starts_with(target, "x86_64") || str_starts_with(target, "x64") || str_starts_with(target, "amd64") {
        return NAT_X64;
    }
    if str_starts_with(target, "aarch64") || str_starts_with(target, "arm64") {
        return NAT_A64;
    }
    if str_starts_with(target, "riscv") {
        return NAT_RV64;
    }
    return 0;
}

/// TG10: `--cpu <name>` per target, with safe defaults — x86-64-v3 (the
/// runtime's fma uses FMA3), armv8.0-a, rv64gc. Accepted names are recorded
/// in `g_nat_cpu`; selection consults it where a CPU adds instructions:
/// an explicit `--cpu x86-64-v3|v4` turns on BMI2 shifts (TG7,
/// ng_x64_bmi2), `--cpu rva22u64|rva23u64|rv64gc_zba_zbb` Zba/Zbb (TG9,
/// ng_rv_zb). Without --cpu (or with `baseline`/`native`) neither is used.
pub fn nat_cpu_default(arch: i64) -> str {
    if arch == NAT_X64 {
        return "x86-64-v3";
    }
    if arch == NAT_A64 {
        return "armv8.0-a";
    }
    if arch == NAT_THUMB {
        return "cortex-m3";
    }
    return "rv64gc";
}

/// "" when `cpu` is a name target `arch` accepts, an error message else.
pub fn nat_cpu_check(arch: i64, cpu: str) -> str {
    if cpu == "native" || cpu == "baseline" {
        return "";
    }
    if arch == NAT_X64 {
        if cpu == "x86-64-v3" || cpu == "x86-64-v4" {
            return "";
        }
        if cpu == "x86-64-v1" || cpu == "x86-64-v2" {
            return "--cpu " + cpu + ": not supported on x86-64 — the runtime's fma needs FMA3 (x86-64-v3)";
        }
        return "Unknown --cpu '" + cpu + "' for x86-64: use x86-64-v3, x86-64-v4, baseline or native";
    }
    if arch == NAT_A64 {
        if cpu == "armv8.0-a" || cpu == "armv8.1-a" || cpu == "armv8.2-a" || cpu == "armv8.4-a" || cpu == "armv9-a" {
            return "";
        }
        return "Unknown --cpu '" + cpu + "' for AArch64: use armv8.0-a through armv9-a, baseline or native";
    }
    if arch == NAT_RV64 {
        if cpu == "rv64gc" || cpu == "rv64g" || cpu == "rv64imafdc" {
            return "";
        }
        // TG9: with Zba/Zbb (sh1add..sh3add, zext.w, sext.b/h, zext.h)
        if cpu == "rva22u64" || cpu == "rva23u64" || cpu == "rv64gc_zba_zbb" {
            return "";
        }
        // TG11: with the V extension (vector operations; rva23u64 has it too)
        if cpu == "rv64gcv" {
            return "";
        }
        return "Unknown --cpu '" + cpu + "' for RISC-V 64: use rv64gc, rv64gcv, rva22u64, rva23u64, rv64gc_zba_zbb, baseline or native";
    }
    if arch == NAT_THUMB {
        // PL5: ARMv7-M code (no FPU instructions) runs on all of these
        if cpu == "cortex-m3" || cpu == "cortex-m4" || cpu == "cortex-m7" || cpu == "armv7-m" {
            return "";
        }
        return "Unknown --cpu '" + cpu + "' for thumbv7m: use cortex-m3, cortex-m4, cortex-m7, armv7-m or baseline";
    }
    return "Unknown --cpu '" + cpu + "'";
}

/// A static Linux executable for `arch` from an IR module that has the
/// Linux runtime (stdlib/linux_runtime) merged in.
pub fn nat_generate_elf(module: IrModule, arch: i64) -> ResultBytes {
    // PL5: Cortex-M (compiler/nat_thumb.fd): a board image or, for
    // thumbv7m-linux, a 32-bit ARM Linux executable
    if arch == NAT_THUMB {
        return nat_thumb_generate(module, g_nat_thumb_bare);
    }
    return nat_generate_image(module, arch, false, false);
}

/// A Windows x64 executable (PE) from an IR module that has the Linux
/// runtime and its Windows layer (stdlib/linux_runtime/win.fd) merged in.
pub fn nat_generate_pe(module: IrModule) -> ResultBytes {
    return nat_generate_image(module, NAT_X64, true, false);
}

/// A macOS executable (Mach-O) for `arch` from an IR module that has the
/// Linux runtime and its macOS layer (stdlib/linux_runtime/darwin.fd) merged.
pub fn nat_generate_macho(module: IrModule, arch: i64) -> ResultBytes {
    return nat_generate_image(module, arch, false, true);
}

/// L2B: `--target universal` (macOS): the x86-64 and the AArch64 Mach-O of
/// a program, each from its own IR module (built for that target, with
/// the macOS layer merged), in one fat binary (nat_enc.fd nat_macho_fat)
/// that `lipo -info` reports as "x86_64 arm64". The --cpu choice applies
/// per slice: one that is not a name of a slice's target is left out for
/// it (baseline there).
pub fn nat_generate_macho_universal(x64_module: IrModule, a64_module: IrModule) -> ResultBytes {
    var cpu: str = g_nat_cpu;
    if nat_cpu_check(NAT_X64, cpu) != "" {
        g_nat_cpu = "";
    }
    var rx: ResultBytes = nat_generate_image(x64_module, NAT_X64, false, true);
    g_nat_cpu = cpu;
    var xbytes: Vec<i64> = Vec::new();
    match rx {
        ResultBytes::Ok(b) => {
            xbytes = b;
        }
        ResultBytes::Err(e) => {
            return ResultBytes::Err(e);
        }
    }
    if nat_cpu_check(NAT_A64, cpu) != "" {
        g_nat_cpu = "";
    }
    var ra: ResultBytes = nat_generate_image(a64_module, NAT_A64, false, true);
    g_nat_cpu = cpu;
    var abytes: Vec<i64> = Vec::new();
    match ra {
        ResultBytes::Ok(b2) => {
            abytes = b2;
        }
        ResultBytes::Err(e2) => {
            return ResultBytes::Err(e2);
        }
    }
    var fat: Vec<i64> = nat_macho_fat(xbytes, abytes);
    if fat.len() == 0 {
        return ResultBytes::Err(c_vec1("native backend: --target universal: the two slices are not an x86-64 and an AArch64 Mach-O"));
    }
    return ResultBytes::Ok(fat);
}

/// SP6: an image with the function cache (CS6) is made again, without the
/// hits a first attempt found not to fit this program (g_nc_retry: a struct
/// result in registers whose function's address is now taken, a short
/// RISC-V call whose callee is out of reach); a third attempt has no hits
/// at all, so it never asks for another.
fn nat_generate_image(module: IrModule, arch: i64, win: bool, mac: bool) -> ResultBytes {
    g_nc_deny = 0;
    g_nc_deny_all = false;
    g_nc_retried = Vec::new();
    var attempt: i64 = 0;
    while attempt < 2 {
        var r: ResultBytes = nat_generate_image1(module, arch, win, mac);
        if !nc_is_retry(r) {
            return r;
        }
        if g_nc_deny == 0 {
            g_nc_deny = HashMap_new();
        }
        var i: i64 = 0;
        while i < g_nc_retry.len() {
            HashMap_insert(g_nc_deny, g_nc_retry.get(i), 1);
            g_nc_retried.push(g_nc_retry.get(i));
            i = i + 1;
        }
        attempt = attempt + 1;
    }
    g_nc_deny_all = true;
    return nat_generate_image1(module, arch, win, mac);
}

fn nat_generate_image1(module: IrModule, arch: i64, win: bool, mac: bool) -> ResultBytes {
    // WP20: without `main`, a library build: the input file's functions
    // are the roots (ng_lib_roots) and the entry point only traps
    var lib_mode: bool = !pe_module_has_fn(&module, "main");
    if lib_mode && str_len(g_nat_lines_names) == 0 {
        return ResultBytes::Err(c_vec1("native backend: the program has no `main` function"));
    }
    nat_enc_image_start(g_nat_lines_file);
    // RA14: the switch variables, once per image
    ng_env_cache_load();
    if ng_verify_on() {
        // RL6: instruction selection checked on values (nat_sel_check)
        var serr: str = nat_sel_check(arch);
        if serr != "" {
            return ResultBytes::Err(c_vec1("native backend: instruction selection check (RL6): " + serr));
        }
    }
    var t_start: i64 = p_clock_now_ms();
    var g: NatGen = NatGen_new(arch);
    g.win = win;
    g.mac = mac;
    g_nat_ldfwd_n = 0;
    // MI28 (2g.98): this image's functions' result extensions
    ng_ret_ext_reset();
    // TG14: a position-independent Linux executable (`--pie` / `--no-pie`,
    // else FID_NAT_ON=pie: nat_pie_wanted; it becomes the default once the
    // suite has run with it on the three Linux targets); Mach-O is always
    // rebased by dyld.
    g_nat_pie = !win && !mac && nat_pie_wanted() && !g_nat_object;
    g_nat_abs_base = nat_elf_image_base();
    if mac {
        g_nat_abs_base = NAT_MACHO_BASE + NAT_MACHO_HDR;
    }
    if g_nat_pie {
        g.pie_table = NatEnc_label(&mut g.e);
    }
    var fi: i64 = 0;
    while fi < module.functions.len() {
        HashMap_insert(g.all_fns, module.functions.get(fi).name, 1);
        if module.functions.get(fi).func.internal_conv {
            HashMap_insert(g.internal, module.functions.get(fi).name, 1);
        }
        fi = fi + 1;
    }
    g.fact_path = p_getenv("FID_LIBFACTS");
    ng_libfacts_load(&mut g);
    ng_collect_dyn_types(&mut g, &module);
    if g_nat_lines_names != "" {
        var lnames: Vec<str> = str_split(g_nat_lines_names, ",");
        var lni: i64 = 0;
        while lni < lnames.len() {
            HashMap_insert(g.line_fns, lnames.get(lni), 1);
            lni = lni + 1;
        }
        // CT9 / DB4: the instances of the input file's generic functions
        ng_dbg_line_instances(&mut g, &module);
    }
    var ei: i64 = 0;
    while ei < module.extern_decls.len() {
        var ext: ExternDecl = module.extern_decls.get(ei);
        if !HashMap_contains(g.c_names, ext.pledge_name) {
            g.c_list.push(ext.c_name);
            HashMap_insert(g.c_names, ext.pledge_name, g.c_list.len());
            // CI2: the library its `link` names ("": the C library)
            match ext.link_lib {
                OptStr::Some(lib) => {
                    g.ld.c_libs.push(lib);
                }
                OptStr::None => {
                    g.ld.c_libs.push("");
                }
            }
            // TG15: a variadic C function's fixed parameters (ng_ldyn_sig)
            var nfix: i64 = 0 - 1;
            if ext.params.len() > 0 && ext.params.get(ext.params.len() - 1).is_variadic {
                nfix = ext.params.len() - 1;
            }
            g.ld.c_fixed.push(nfix);
        }
        ei = ei + 1;
    }
    g.fn_table_label = NatEnc_label(&mut g.e);
    g.names_label = NatEnc_label(&mut g.e);
    g.code_end_label = NatEnc_label(&mut g.e);
    var pi: i64 = 0;
    while pi < nat_panic_messages().len() {
        g.panic_labels.push(NatEnc_label(&mut g.e));
        pi = pi + 1;
    }
    g.start_sp_label = NatEnc_label(&mut g.e);
    if g.win {
        if !ng_has_fn(&g, "pe_win_syscall") {
            return ResultBytes::Err(c_vec1("native backend: the Windows layer of the runtime (stdlib/linux_runtime/win.fd) is not merged"));
        }
        var ni: i64 = 0;
        while ni < ng_win_imports().len() {
            g.win_slot_labels.push(NatEnc_label(&mut g.e));
            ni = ni + 1;
        }
        g.win_slots_label = NatEnc_label(&mut g.e);
        g.win_tls_label = NatEnc_label(&mut g.e);
        g.win_imp_label = NatEnc_label(&mut g.e);
        g.win_imp_end = NatEnc_label(&mut g.e);
        g.win_iat_label = NatEnc_label(&mut g.e);
        g.win_iat_end = NatEnc_label(&mut g.e);
    }
    if g.mac {
        if !ng_has_fn(&g, "pe_mac_syscall") {
            return ResultBytes::Err(c_vec1("native backend: the macOS layer of the runtime (stdlib/linux_runtime/darwin.fd) is not merged"));
        }
        g.mac_got_label = NatEnc_label(&mut g.e);
    }

    // RA18: callee-saved float registers only in a program that never
    // switches tasks (before the code cache's salt, which names it)
    g_ng_fcs_block = ng_fcs_tasks(&module);
    // L6C: C function pointers, the same way (ng_cfp_scan)
    g_ng_cfp_on = ng_cfp_scan(&module);
    g_ng_cfp_sigs = Vec::new();
    g_ng_cfp_labels = Vec::new();
    nc_start(&mut g, &module);
    ng_gen_primitives(&mut g);
    if ng_verify_on() {
        // MI20: every target defines the whole primitive interface
        var perr: str = ng_prim_check(&g);
        if perr != "" {
            return ResultBytes::Err(c_vec1("native backend: " + perr));
        }
    }
    // Compile what main reaches, as calls are met; the panic stubs' calls
    // come last but are queued like any other
    ng_gen_panic_stubs(&mut g);
    if lib_mode {
        ng_lib_roots(&mut g, &module);
    }
    // A global's string initializer names a function too (`var g: str =
    // "f"; task_go(g, 1)`): compiled and in nat_fn_table, as a ConstStr's
    // (the mid-end keeps it alive: ir.fd ir_data_named_fns)
    var gni: i64 = 0;
    while gni < module.globals.len() {
        match module.globals.get(gni).init {
            Expr::StringLit(gns) => {
                if str_len(gns) > 0 {
                    ng_named_fn(&mut g, gns);
                }
            }
            _ => {
            }
        }
        gni = gni + 1;
    }
    var qi: i64 = 0;
    while qi < g.queue.len() {
        var name: str = g.queue.get(qi);
        match IrModule_get_function(&module, name) {
            OptIrFunction::Some(func0) => {
                // ME28/MI27: compare chains on one value become a Switch
                // (ir.fd, after the mid-end; FID_SWITCH=off: no)
                var func: IrFunction = func0;
                if ir_switch_on() {
                    IrFunction_form_switches(&mut func);
                }
                if g_nat_trace {
                    p_eprint_str("[nat] " + name + "\n");
                }
                var nix: i64 = nc_lookup(&mut g, &func, &module);
                if nix != 0 {
                    nc_skel_fn(&mut g, name, nix, func.is_constant_time);
                } else if g.nc_on {
                    // SP6: the labels it asks for go with its entry
                    nc_log_begin();
                    ng_gen_function(&mut g, name, &func, &module);
                    nc_log_end(name);
                } else {
                    ng_gen_function(&mut g, name, &func, &module);
                }
                // J7: the IR-level @constant_time check pe_ir runs
                // (checks.fd peir_ct_check: a branch or a division on a
                // value derived from a parameter, followed through memory
                // and calls). It judges branches here too, so a loop on a
                // public counter passes as it does on pe_ir; before, the
                // machine-level check rejected every conditional branch
                // (ge_scalarmult_ct, x25519_ladder_xz, ct_sum on the nat
                // lane). It also covers a function replayed from the cache,
                // which the machine-level check never sees.
                // FID_NAT_OFF=ctir turns it off.
                if func.is_constant_time && ng_on("ctir") {
                    var cte: Vec<str> = peir_ct_check(&func, name);
                    if cte.len() > 0 {
                        return ResultBytes::Err(c_vec1("native backend: @constant_time violated: " + cte.get(0)));
                    }
                }
            }
            OptIrFunction::None => {
            }
        }
        qi = qi + 1;
    }
    var t_rec: i64 = p_clock_now_ms();
    nat_time_mark("nat record", t_start);
    if NG_MIR && (ng_on("mir") || ng_x64(&g)) {
        var merr: str = ng_mir_finish(&mut g);
        if merr != "" {
            return ResultBytes::Err(c_vec1(merr));
        }
        nc_finish(&mut g);
    }
    if g_nat_stats {
        // TG17: what the post-allocation load-after-store rule removed
        p_eprint_str("[ldfwd] " + int_to_str(g_nat_ldfwd_n) + " slot loads after a store became register moves\n");
    }
    ng_line_close(&mut g);
    ng_gen_panic_line_stubs(&mut g);
    // LG13: the asm! thunks, after the code (TG9: RVC copies them as they are)
    var rvc_asm_lo: i64 = NatEnc_pos(&g.e);
    nat_asm_emit(&mut g.e);
    var rvc_asm_hi: i64 = NatEnc_pos(&g.e);
    // CI2: the stubs of C functions the dynamic linker binds
    ng_gen_ldyn_stubs(&mut g);
    // L6C: the stubs of calls through C function pointers
    ng_gen_cfp_stubs(&mut g);
    var t_emit: i64 = p_clock_now_ms();
    nat_time_mark("nat alloc+emit", t_rec);
    // SP2: the allocation part of that row, and the rest (peephole, encoding)
    nat_time_row("  nat allocation", g_nat_alloc_ms);
    nat_time_row("  nat peephole+encoding", t_emit - t_rec - g_nat_alloc_ms);
    p_eprint_str("[prof] native: lower " + int_to_str(t_rec - t_start) + "ms, allocate and emit " + int_to_str(t_emit - t_rec) + "ms, " + int_to_str(g.recs.len()) + " functions, " + int_to_str(g.n_folded) + " folded, " + int_to_str(g.n_peep) + " peep\n");
    // RA14: the allocation part of that (ng_mir_alloc_split, live-range
    // splitting included, of every function not replayed from the function
    // cache) and which allocator ran (tests/nattools/ra14_fast_alloc_time.sh)
    var al_mode: str = "default allocator";
    if ng_fast_alloc_on() {
        al_mode = "fast allocator";
    } else if ng_opt_in("greedy") {
        // RA9: tests/nattools/greedy_bench.sh and docs/reference/greedy-allocator.md
        al_mode = "greedy allocator";
    }
    p_eprint_str("[prof] native allocation: " + int_to_str(g_nat_alloc_ms) + "ms, " + al_mode + "\n");
    NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
    NatEnc_place(&mut g.e, g.code_end_label);
    // TG9: RISC-V's 2-byte instructions, before the data is laid out
    ng_rvc_pass(&mut g, rvc_asm_lo, rvc_asm_hi);
    // Windows: the data on pages of its own (a read/execute .text, a
    // read/write .data: one RWX section looks packed to scanners)
    var data_off: i64 = 0;
    g_nat_elf_data_off = 0 - 1;
    if !g.win && !g.mac && !g_nat_object && ng_on("wxsplit") {
        // TG14: on Linux too: nat_elf maps the code read/execute and the
        // data read/write from the next page (file offset 0x1000 + image
        // offset on a page boundary). Every word written at run time, the
        // PIE relocation's included, is in the data.
        var lpage: i64 = nat_elf_page(arch);
        while ((0x1000 + NatEnc_pos(&g.e)) & (lpage - 1)) != 0 {
            NatEnc_byte(&mut g.e, 0);
        }
        data_off = NatEnc_pos(&g.e);
        g_nat_elf_data_off = data_off;
    }
    if g.win {
        NatEnc_align(&mut g.e, 4096);
        data_off = NatEnc_pos(&g.e);
    } else if g.mac {
        // Split code (__TEXT, r-x) from data (__DATA, rw) at a page.
        var mac_page: i64 = 4096;
        if arch == NAT_A64 {
            mac_page = 16384;
        }
        NatEnc_align(&mut g.e, mac_page);
        data_off = NatEnc_pos(&g.e);
    }
    ng_gen_data(&mut g, &module);
    if g.win {
        ng_gen_win_imports(&mut g);
    }
    ng_gen_pie_table(&mut g);
    // CI2: the dynamic linker's tables (none without C imports)
    ng_gen_ldyn(&mut g);
    if g.mac {
        ng_gen_mac_got(&mut g);
    }

    // CB9: a C function the image cannot reach is reported by name, as a
    // linker would ("undefined symbol"; main.fd link_error_report names its
    // declaration and library), not by the dynamic linker at the first run:
    // a dynamic import that no library of the program (nor the C library)
    // defines (Linux only: nat_enc.fd nat_elf_link_missing reads this
    // machine's ELF libraries, and lists nothing when one is missing or
    // unreadable; a macOS or Windows image's imports are not ELF), and a
    // call to a declared C function left unresolved (no dynamic import:
    // FID_NAT_OFF=ldyn, a signature the stubs do not take).
    var c_missing: Vec<str> = Vec::new();
    if !g.win && !g.mac && ng_ldyn_ok(&g) && g.ld.names.len() > 0 {
        c_missing = nat_elf_link_missing(arch, &g.ld.names, &g.ld.libs);
    }
    // 2g.106: `--nat` Windows from each DLL's export directory (the DLLs of
    // this machine's system folder or FID_NAT_LIBPATH), macOS from the SDK's
    // text-based stubs (nat_enc.fd nat_pe_link_missing,
    // nat_macho_link_missing; nothing when they are not here)
    // (not for an object, 2g.110: its C functions may come from the other
    // objects and libraries it is linked with; the linker reports them)
    if g.win && !g_nat_object && ng_ldyn_ok(&g) && g.ld.names.len() > 0 {
        c_missing = nat_pe_link_missing(&g.ld.names, &g.ld.libs);
    } else if g.mac && !g_nat_object && ng_ldyn_ok(&g) && g.ld.names.len() > 0 {
        c_missing = nat_macho_link_missing(&g.ld.names, &g.ld.libs);
    }
    var other_unres: Vec<str> = Vec::new();
    var uix: i64 = 0;
    while uix < g.unresolved.len() {
        var ukey: str = g.unresolved.get(uix);
        var ucut: i64 = str_find(ukey, " (from ");
        var uname: str = ukey;
        if ucut >= 0 {
            uname = str_slice(ukey, 0, ucut);
        }
        if HashMap_contains(g.c_names, uname) {
            c_missing.push(g.c_list.get(HashMap_get(g.c_names, uname) - 1));
        } else {
            other_unres.push(ukey);
        }
        uix = uix + 1;
    }
    if c_missing.len() > 0 || other_unres.len() > 0 {
        var uerrs: Vec<str> = Vec::new();
        var ucx: i64 = 0;
        while ucx < c_missing.len() {
            uerrs.push("native backend: undefined symbol: " + c_missing.get(ucx));
            ucx = ucx + 1;
        }
        if other_unres.len() > 0 {
            var os_word: str = "Linux";
            if g.win {
                os_word = "Windows";
            } else if g.mac {
                os_word = "macOS";
            }
            uerrs.push("native backend: not available in native " + os_word + " executables yet: " + str_join(other_unres, ", ") + " (build with `fid ccompile --target` instead)");
        }
        return ResultBytes::Err(uerrs);
    }
    var err: str = NatEnc_resolve(&mut g.e);
    if err != "" {
        if nl_in_use() {
            // SP7: a reference out of reach in the kept layout (a short
            // branch to code now further away): this build again, laid
            // out afresh
            if g_nat_stats {
                p_eprint_str("[relink] the kept layout does not resolve (" + err + "): laid out afresh\n");
            }
            nl_drop();
            return nat_generate_image1(module, arch, win, mac);
        }
        return ResultBytes::Err(c_vec1(err));
    }
    // SP7: this build's layout is the one the next build in this process
    // starts from
    nl_commit();
    nat_time_mark("nat data+image", t_emit);
    var entry_off: i64 = NatEnc_label_offset(&g.e, g.entry_label);
    // Symbols (and on Linux DWARF) for the functions in the image, in
    // address order (DB2, DB10: Mach-O and `--nat` PE get the symbols too)
    var dnames: Vec<str> = Vec::new();
    var dstarts: Vec<i64> = Vec::new();
    var dends: Vec<i64> = Vec::new();
    var di: i64 = 0;
    while di < g.placed_fns.len() {
        var dn: str = g.placed_fns.get(di);
        dnames.push(dn);
        dstarts.push(NatEnc_label_offset(&g.e, HashMap_get(g.fn_labels, dn)));
        di = di + 1;
    }
    di = 0;
    while di < dstarts.len() {
        if di + 1 < dstarts.len() {
            dends.push(dstarts.get(di + 1));
        } else {
            dends.push(NatEnc_label_offset(&g.e, g.code_end_label));
        }
        di = di + 1;
    }
    if g.win {
        var imp_off: i64 = NatEnc_label_offset(&g.e, g.win_imp_label);
        var iat_off: i64 = NatEnc_label_offset(&g.e, g.win_iat_label);
        // TG12: a COFF object instead of the PE (nat_emit_object)
        if g_nat_object {
            var cobj: Vec<i64> = nat_coff_object(&g.e, entry_off, data_off, imp_off, NatEnc_label_offset(&g.e, g.win_imp_end) - imp_off, iat_off, NatEnc_label_offset(&g.e, g.win_iat_end) - iat_off, &dnames, &dstarts, &dends);
            if cobj.len() == 0 {
                return ResultBytes::Err(c_vec1(g_nat_obj_err));
            }
            return ResultBytes::Ok(cobj);
        }
        // DB6: .pdata / .xdata after the data (the exception directory),
        // so debuggers, profilers and the exception dispatcher walk our
        // frames (FID_NAT_OFF=unwind: none)
        var pdata_off: i64 = 0;
        var pdata_size: i64 = 0;
        if ng_on("unwind") {
            pdata_off = nat_pe_unwind_pdata(g.e.code.len());
            var uw: Vec<i64> = nat_pe_unwind(&g.e.code, dstarts, dends);
            var ui: i64 = 0;
            while ui < uw.len() {
                g.e.code.push(uw.get(ui));
                ui = ui + 1;
            }
            pdata_size = g.e.code.len() - pdata_off;
        }
        var pe_img: Vec<i64> = nat_pe(g.e.code, entry_off, data_off, imp_off, NatEnc_label_offset(&g.e, g.win_imp_end) - imp_off, iat_off, NatEnc_label_offset(&g.e, g.win_iat_end) - iat_off);
        if pdata_size > 0 {
            nat_pe_set_dir(&mut pe_img, 3, 0x1000 + pdata_off, pdata_size);
        }
        // CT6: a debug build's DWARF (line rows, functions, variables,
        // frames) in COFF sections, then the symbols (nat_enc.fd
        // nat_pe_debug); the names and types as on Linux (CT9, DB4)
        if ng_on("debug") && ng_dbg_win_dwarf() && g.lrows.len() > 2 {
            g_nat_dbg_shown = ng_dbg_shown_names(&module, dnames);
            g_nat_dbg_types = ng_dbg_type_descs(&module);
            g_nat_dbg_ext = ng_on("dbgvars");
            g_nat_dbg_vars = ng_dbg_vars_for(dnames);
            return ResultBytes::Ok(nat_pe_debug(pe_img, g.e.code, dnames, dstarts, dends, g_nat_lines_file, g.lrows, g.cfi_rows));
        }
        if ng_on("debug") {
            nat_pe_symbols(&mut pe_img, dnames, dstarts);
        }
        return ResultBytes::Ok(pe_img);
    }
    if g.mac {
        // Rebase every ABS64 word; bind each GOT slot to its libSystem symbol.
        var rebase_offs: Vec<i64> = Vec::new();
        var rfi: i64 = 0;
        while rfi < g.e.fixups.len() {
            if g.e.fixups.get(rfi).kind == NATFIX_ABS64 {
                rebase_offs.push(g.e.fixups.get(rfi).pos);
            }
            rfi = rfi + 1;
        }
        var imp_names: Vec<str> = ng_mac_imports(ng_x64(&g));
        var got_base: i64 = NatEnc_label_offset(&g.e, g.mac_got_label);
        var imp_offs: Vec<i64> = Vec::new();
        var mii: i64 = 0;
        while mii < imp_names.len() {
            imp_offs.push(got_base + mii * 8);
            mii = mii + 1;
        }
        // TG15: the C functions of `extern "C"` blocks (ng_ldyn_import), each
        // bound from its dylib (nat_enc.fd nat_macho_import)
        var lgi: i64 = 0;
        while lgi < g.ld.names.len() {
            imp_names.push(nat_macho_import(g.ld.libs.get(lgi), "_" + g.ld.names.get(lgi)));
            imp_offs.push(NatEnc_label_offset(&g.e, g.ld.got_labels.get(lgi)));
            lgi = lgi + 1;
        }
        // TG12: a Mach-O object instead of the executable (nat_emit_object)
        if g_nat_object {
            var mobj: Vec<i64> = nat_macho_object(arch, &g.e, entry_off, data_off, &imp_names, &imp_offs, &dnames, &dstarts, &dends);
            if mobj.len() == 0 {
                return ResultBytes::Err(c_vec1(g_nat_obj_err));
            }
            return ResultBytes::Ok(mobj);
        }
        var mnames: Vec<str> = Vec::new();
        var mstarts: Vec<i64> = Vec::new();
        if ng_on("debug") {
            mnames = dnames;
            mstarts = dstarts;
        }
        // TL5: a debug build's line table and functions in DWARF, in a
        // __DWARF segment of the image (nat_enc.fd nat_macho_debug)
        if ng_on("debug") && g.lrows.len() > 2 {
            g_nat_dbg_shown = ng_dbg_shown_names(&module, dnames);
            // CT9: the struct types and the variables too, as on Linux
            // (nat_enc.fd nat_macho_debug_cfi: the full DWARF, frames
            // from the frame rows)
            g_nat_dbg_types = ng_dbg_type_descs(&module);
            g_nat_dbg_ext = ng_on("dbgvars");
            g_nat_dbg_vars = ng_dbg_vars_for(dnames);
            return ResultBytes::Ok(nat_macho_debug_cfi(arch, g.e.code, entry_off, data_off, rebase_offs, imp_names, imp_offs, mnames, mstarts, dends, g_nat_lines_file, g.lrows, g.cfi_rows));
        }
        return ResultBytes::Ok(nat_macho(arch, g.e.code, entry_off, data_off, rebase_offs, imp_names, imp_offs, mnames, mstarts));
    }
    // CI2: the dynamic linker's segments when C functions are imported
    ng_ldyn_set_segments(&g);
    // TG12: a relocatable object instead of an executable (nat_emit_object)
    if g_nat_object {
        return ResultBytes::Ok(nat_elf_object(arch, g.e.code, entry_off, dnames, dstarts, dends, g.e.fixups));
    }
    if !ng_on("debug") {
        return ResultBytes::Ok(nat_elf(arch, g.e.code, entry_off));
    }
    // CT9: the names and struct types a debugger shows, as Fides writes them
    g_nat_dbg_shown = ng_dbg_shown_names(&module, dnames);
    g_nat_dbg_types = ng_dbg_type_descs(&module);
    // DB2/DB4: frame bases, declaration lines, variables
    g_nat_dbg_ext = ng_on("dbgvars");
    g_nat_dbg_vars = ng_dbg_vars_for(dnames);
    return ResultBytes::Ok(nat_elf_debug(arch, g.e.code, entry_off, dnames, dstarts, dends, g_nat_lines_file, g.lrows, g.cfi_rows));
}

// ===========================================================================
// CI2: C functions without a C compiler on Linux x86-64. A function of an
// `extern "C"` block the runtime does not provide (pert_c_<name>,
// nat_c_<name>) becomes a dynamic import: the executable names the system's
// dynamic linker (PT_INTERP) and a dynamic section (PT_DYNAMIC: DT_NEEDED
// for libc and each `link` library, a symbol table, a hash table, one
// R_X86_64_GLOB_DAT relocation per GOT slot, bound at load: DF_BIND_NOW).
// A call goes to a stub per import and signature, which moves the
// arguments from the internal convention to System V (integers in rdi,
// rsi, rdx, rcx, r8, r9; f64/f32 in xmm0..7) and calls through the GOT.
// FID_NAT_OFF=ldyn: such a call is unresolved, as before.
// ===========================================================================

pub struct NatLdyn {
    // The library of each entry of NatGen.c_list ("": the C library)
    pub c_libs: Vec<str>,
    // TG15: of each entry of NatGen.c_list, the number of fixed parameters
    // of a variadic C function (`...rest: T` last), -1 for any other
    pub c_fixed: Vec<i64>,
    // The imports (C names) in GOT order, their libraries, C name -> 1 + index
    pub names: Vec<str>,
    pub libs: Vec<str>,
    pub ix: i64,
    // The stubs: "import|signature" -> 1 + index; label and import of each
    pub stub_keys: Vec<str>,
    pub stub_ix: i64,
    pub stub_labels: Vec<i64>,
    pub stub_imp: Vec<i64>,
    pub stub_sigs: Vec<str>,
    // The GOT slots' labels; the program interpreter's path and the dynamic
    // section's start and end (-1: not laid out)
    pub got_labels: Vec<i64>,
    pub interp_label: i64,
    pub dyn_label: i64,
    pub dyn_end_label: i64,
}

fn NatLdyn_new() -> NatLdyn {
    return NatLdyn {
        c_libs: Vec::new(), c_fixed: Vec::new(), names: Vec::new(), libs: Vec::new(), ix: HashMap_new(), stub_keys: Vec::new(), stub_ix: HashMap_new(), stub_labels: Vec::new(), stub_imp: Vec::new(), stub_sigs: Vec::new(), got_labels: Vec::new(), interp_label: 0 - 1, dyn_label: 0 - 1, dyn_end_label: 0 - 1,
    };
}

/// Dynamic imports are possible: a Linux, macOS or Windows executable (not
/// an object file). TG15: Linux x86-64, AArch64 and RISC-V 64
/// (each its own stubs, ng_gen_ldyn_stubs; its relocation and interpreter,
/// ng_ldyn_rel_type, ng_ldyn_interp), macOS (GOT slots dyld binds) and
/// Windows (IAT entries). TG14: a Linux PIE too: nat_enc.fd writes PT_PHDR
/// for a PIE with PT_INTERP (ld.so takes the load bias from it), and
/// ng_gen_pie_table runs before ng_gen_ldyn, so the dynamic section's
/// words and the GOT slots are not in the self-relocation table (ld.so
/// relocates them).
fn ng_ldyn_ok(g: &NatGen) -> bool {
    // TG15: Linux (ELF dynamic section), macOS (GOT slots dyld binds:
    // nat_macho) and --nat Windows (IAT entries: ng_gen_win_imports).
    // 2g.110: a COFF or Mach-O object too: its import slots become
    // relocations against the functions (nat_enc.fd nat_coff_object,
    // nat_macho_object), so the runtime's kernel32 functions (LoadLibraryA,
    // GetProcAddress, FreeLibrary: linux_runtime/win.fd) and the program's
    // C functions resolve when it is linked; before, every --obj --nat
    // build stopped on them as undefined. An ELF object has no dynamic
    // section of its own: still none there.
    if g_nat_object && !g.win && !g.mac {
        return false;
    }
    return ng_on("ldyn");
}

/// TG15: the relocation that binds a GOT slot to a symbol's address:
/// R_X86_64_GLOB_DAT, R_AARCH64_GLOB_DAT, R_RISCV_64 (RISC-V has no
/// GLOB_DAT; glibc's ld.so resolves R_RISCV_64 against the symbol).
fn ng_ldyn_rel_type(g: &NatGen) -> i64 {
    if ng_x64(g) {
        return 6;
    }
    if ng_a64(g) {
        return 1025;
    }
    return 2;
}

/// TG15: the program interpreter of the target's glibc systems.
fn ng_ldyn_interp(g: &NatGen) -> str {
    if ng_x64(g) {
        return NG_LDYN_INTERP;
    }
    if ng_a64(g) {
        return "/lib/ld-linux-aarch64.so.1";
    }
    return "/lib/ld-linux-riscv64-lp64d.so.1";
}

/// The C signature of a call: a character per argument (`i` an integer or
/// pointer word, `d` f64, `s` f32), `>`, the result (`d`, `s`, `w` i32,
/// `W` u32, `h` i16, `H` u16, `b` i8, `B` u8 or bool, `v` none, `i` a word).
/// "" when System V cannot take it in registers (more than six integer or
/// eight float arguments). TG15: `nfixed` >= 0 for a variadic C function
/// (`...rest: T` after `nfixed` parameters): a `.` after the fixed
/// arguments' classes ("iii.ii>w"; ng_ldyn_var_sig fits it to the target).
fn ng_ldyn_sig(func: &IrFunction, id: i64, args: Vec<i64>, nfixed: i64) -> str {
    return ng_ldyn_sig_lim(func, id, args, nfixed, true);
}

/// ng_ldyn_sig, with System V's register limit (six integer, eight float
/// arguments) only when `sysv_limit`: a `--nat` Windows stub
/// (nat_enc.fd nat_pe_win64_stub) passes arguments 4 and up on the stack,
/// so any number goes (BCryptEncrypt's 10, InitializeSecurityContextA's 12:
/// without this they were left unresolved, "not in any library the
/// program links").
fn ng_ldyn_sig_lim(func: &IrFunction, id: i64, args: Vec<i64>, nfixed: i64, sysv_limit: bool) -> str {
    var s: str = "";
    var ni: i64 = 0;
    var nf: i64 = 0;
    var i: i64 = 0;
    while i < args.len() {
        if i == nfixed {
            s = s + ".";
        }
        var t: IrType = ng_meta_ty(func, args.get(i));
        if ir_type_eq(t, IrType::F64) {
            s = s + "d";
            nf = nf + 1;
        } else if ir_type_eq(t, IrType::F32) {
            s = s + "s";
            nf = nf + 1;
        } else {
            s = s + "i";
            ni = ni + 1;
        }
        i = i + 1;
    }
    if sysv_limit && (ni > 6 || nf > 8) {
        return "";
    }
    var rt: IrType = ng_meta_ty(func, id);
    var r: str = "i";
    if ir_type_eq(rt, IrType::F64) {
        r = "d";
    } else if ir_type_eq(rt, IrType::F32) {
        r = "s";
    } else if ir_type_eq(rt, IrType::I32) {
        r = "w";
    } else if ir_type_eq(rt, IrType::U32) {
        r = "W";
    } else if ir_type_eq(rt, IrType::I16) {
        r = "h";
    } else if ir_type_eq(rt, IrType::U16) {
        r = "H";
    } else if ir_type_eq(rt, IrType::I8) {
        r = "b";
    } else if ir_type_eq(rt, IrType::U8) || ir_type_eq(rt, IrType::Bool) {
        r = "B";
    } else if ir_type_eq(rt, IrType::Void) {
        r = "v";
    }
    return s + ">" + r;
}

/// TG15: ng_ldyn_sig's signature of a variadic C call fitted to the
/// target's stubs. Windows x64 (nat_pe_win64_stub: each float in its
/// integer register as well) and Apple arm64 (nat_macho_a64_stub: the
/// variadic arguments in 8-byte stack slots) keep the `.`. The System V
/// stubs (Linux, x86-64 macOS) and AAPCS64 on Linux pass a variadic
/// argument as a fixed one (x86-64: al counts the vector registers), so
/// the `.` goes; RISC-V's psABI passes a variadic float in the integer
/// registers, so an f64 there becomes `i` (its bits already travel in a
/// general register). An f32 among the variadic arguments needs C's
/// promotion to double, which only the Apple arm64 stub does: "" (the call
/// is not bound) elsewhere.
fn ng_ldyn_var_sig(g: &NatGen, sig: str) -> str {
    var dot: i64 = str_find(sig, ".");
    if sig == "" || dot < 0 {
        return sig;
    }
    if g.mac && !ng_x64(g) {
        return sig;
    }
    var gt: i64 = str_find(sig, ">");
    var rest: str = "";
    var j: i64 = dot + 1;
    while j < gt {
        var c: i64 = str_byte_at(sig, j);
        if c == 115 {
            return "";
        }
        if c == 100 && !g.win && !ng_x64(g) && !ng_a64(g) {
            rest = rest + "i";
        } else {
            rest = rest + byte_to_str(c);
        }
        j = j + 1;
    }
    if g.win {
        return sig;
    }
    return str_slice(sig, 0, dot) + rest + str_slice(sig, gt, str_len(sig));
}

/// The GOT index of the C function c_list[ci], imported on first use.
fn ng_ldyn_import(g: &mut NatGen, ci: i64) -> i64 {
    var cname: str = g.c_list.get(ci);
    if HashMap_contains(g.ld.ix, cname) {
        return HashMap_get(g.ld.ix, cname) - 1;
    }
    var lib: str = "";
    if ci < g.ld.c_libs.len() {
        lib = g.ld.c_libs.get(ci);
    }
    g.ld.names.push(cname);
    g.ld.libs.push(lib);
    g.ld.got_labels.push(NatEnc_label(&mut g.e));
    HashMap_insert(g.ld.ix, cname, g.ld.names.len());
    return g.ld.names.len() - 1;
}

/// The label of the stub calling c_list[ci] with signature `sig`.
fn ng_ldyn_stub_label(g: &mut NatGen, ci: i64, sig: str) -> i64 {
    var k: i64 = ng_ldyn_import(g, ci);
    var key: str = int_to_str(k) + "|" + sig;
    if HashMap_contains(g.ld.stub_ix, key) {
        return g.ld.stub_labels.get(HashMap_get(g.ld.stub_ix, key) - 1);
    }
    var l: i64 = NatEnc_label(&mut g.e);
    g.ld.stub_keys.push(key);
    g.ld.stub_labels.push(l);
    g.ld.stub_imp.push(k);
    g.ld.stub_sigs.push(sig);
    HashMap_insert(g.ld.stub_ix, key, g.ld.stub_keys.len());
    return l;
}

/// Each stub: arguments 0..3 arrive in rdi, rsi, rdx, rcx, the rest on the
/// stack above the return address (ng_load_args); each goes to the next
/// free System V register of its class. An integer argument's register is
/// never one a later argument still has to be read from (its index is at
/// most the argument's own). The result goes to rdi (argument register 0,
/// where the caller reads it), an f64 as its 64 bits, an f32 as its 32-bit
/// pattern zero-extended (MI25: never widened), a narrow integer extended
/// as Fides holds it.
fn ng_gen_ldyn_stubs(g: &mut NatGen) {
    if g.win || (g.mac && !ng_x64(g)) {
        // TG15: Windows x64 (positional registers, shadow space) and Apple
        // arm64 (variadic arguments on the stack): nat_enc.fd
        // nat_pe_win64_stub, nat_macho_a64_stub
        var wsi: i64 = 0;
        while wsi < g.ld.stub_labels.len() {
            NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
            NatEnc_place(&mut g.e, g.ld.stub_labels.get(wsi));
            var wslot: i64 = g.ld.got_labels.get(g.ld.stub_imp.get(wsi));
            if g.win {
                nat_pe_win64_stub(&mut g.e, g.ld.stub_sigs.get(wsi), wslot);
            } else {
                nat_macho_a64_stub(&mut g.e, g.ld.stub_sigs.get(wsi), wslot);
            }
            wsi = wsi + 1;
        }
        return;
    }
    if !ng_x64(g) {
        // TG15: AAPCS64 / the RISC-V psABI
        ng_gen_ldyn_stubs_risc(g);
        return;
    }
    var si: i64 = 0;
    while si < g.ld.stub_labels.len() {
        var sig: str = g.ld.stub_sigs.get(si);
        var k: i64 = g.ld.stub_imp.get(si);
        NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
        NatEnc_place(&mut g.e, g.ld.stub_labels.get(si));
        var gt: i64 = str_find(sig, ">");
        var ii: i64 = 0;
        var fi: i64 = 0;
        var j: i64 = 0;
        while j < gt {
            var c: i64 = str_byte_at(sig, j);
            var src: i64 = 0;
            if j < 4 {
                src = ng_argreg(g, j);
            } else {
                // r11 = [rsp + 8 + 8 * (j - 4)]
                x64_load(&mut g.e, 11, 4, 8 + 8 * (j - 4), 8, true);
                src = 11;
            }
            if c == 100 || c == 115 {
                // MI25: an f64 as its 64 bits (movq); an f32 as its 32-bit
                // pattern, as the machine layer holds it (movd: the float C
                // takes, never widened)
                x64_movq_xr(&mut g.e, fi, src, c == 100);
                fi = fi + 1;
            } else {
                var dst: i64 = ng_ldyn_sysv_int(ii);
                if dst != src {
                    x64_mov(&mut g.e, dst, src);
                }
                ii = ii + 1;
            }
            j = j + 1;
        }
        // r11 = GOT[k]; al = the vector registers used (variadic callees)
        x64_lea_label(&mut g.e, 11, g.ld.got_labels.get(k));
        x64_load(&mut g.e, 11, 11, 0, 8, true);
        x64_li(&mut g.e, 0, fi);
        // rsp is 8 past a 16-byte boundary here (the call pushed the return
        // address): realign for the C function
        x64_sub_imm(&mut g.e, 4, 8);
        x64_call_r(&mut g.e, 11);
        x64_add_imm(&mut g.e, 4, 8);
        var rc: i64 = str_byte_at(sig, gt + 1);
        if rc == 100 {
            x64_movq_rx(&mut g.e, 7, 0, true);
        } else if rc == 115 {
            // MI25: the float's 32-bit pattern, zero-extended (movd edi,
            // xmm0), as the machine layer holds an f32
            x64_movq_rx(&mut g.e, 7, 0, false);
        } else if rc == 119 {
            ng_ext(g, 7, 0, NEXT_SW);
        } else if rc == 87 {
            ng_ext(g, 7, 0, NEXT_ZW);
        } else if rc == 104 {
            ng_ext(g, 7, 0, NEXT_SH);
        } else if rc == 72 {
            ng_ext(g, 7, 0, NEXT_ZH);
        } else if rc == 98 {
            ng_ext(g, 7, 0, NEXT_SB);
        } else if rc == 66 {
            ng_ext(g, 7, 0, NEXT_ZB);
        } else {
            x64_mov(&mut g.e, 7, 0);
        }
        x64_ret(&mut g.e);
        si = si + 1;
    }
}

/// TG15: the stubs of AArch64 (AAPCS64) and RISC-V 64 (lp64d). The
/// platform convention ng_load_args uses already is the C one for
/// integers: arguments 0..7 arrive in x0..x7 / a0..a7, the rest at
/// [sp + 8 * (j - 8)]. A float travels as its bits in a general register
/// at a call, so each f64 goes to the next free d / fa register (an f32,
/// its 32-bit pattern, to the next s / fa register as a single: MI25),
/// and each integer to the next free
/// integer register, whose index is never above the argument's own (it
/// was already read). The frame record saves the return address around
/// the call through the GOT; the result comes back in x0 / a0 as Fides
/// holds it.
fn ng_gen_ldyn_stubs_risc(g: &mut NatGen) {
    var a64: bool = ng_a64(g);
    var si: i64 = 0;
    while si < g.ld.stub_labels.len() {
        var sig: str = g.ld.stub_sigs.get(si);
        var k: i64 = g.ld.stub_imp.get(si);
        NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
        NatEnc_place(&mut g.e, g.ld.stub_labels.get(si));
        var gt: i64 = str_find(sig, ">");
        var ii: i64 = 0;
        var fi: i64 = 0;
        var j: i64 = 0;
        while j < gt {
            var c: i64 = str_byte_at(sig, j);
            var src: i64 = 0;
            if j < 8 {
                src = ng_argreg(g, j);
            } else if a64 {
                src = 16;
                a64_ldr(&mut g.e, 16, A64_SP, 8 * (j - 8));
            } else {
                src = RV_T0;
                rv_load(&mut g.e, RV_T0, RV_SP, 8 * (j - 8), 8, true);
            }
            if c == 100 || c == 115 {
                // MI25: an f32 is its 32-bit pattern (fmov s / fmv.w.x),
                // never widened; an f64 its 64 bits
                if a64 {
                    if c == 115 {
                        a64_fmov_sw(&mut g.e, fi, src);
                    } else {
                        a64_fmov_dx(&mut g.e, fi, src);
                    }
                } else {
                    if c == 115 {
                        rv_fmv_wx(&mut g.e, 10 + fi, src);
                    } else {
                        rv_fmv_dx(&mut g.e, 10 + fi, src);
                    }
                }
                fi = fi + 1;
            } else {
                var dst: i64 = ng_argreg(g, ii);
                if dst != src {
                    if a64 {
                        a64_mov(&mut g.e, dst, src);
                    } else {
                        rv_mv(&mut g.e, dst, src);
                    }
                }
                ii = ii + 1;
            }
            j = j + 1;
        }
        if a64 {
            NatEnc_word(&mut g.e, 0xA9BF7BFD);
            // stp x29, x30, [sp, #-16]!
            a64_add_imm(&mut g.e, A64_FP, A64_SP, 0);
            a64_addr(&mut g.e, 16, g.ld.got_labels.get(k));
            a64_ldr(&mut g.e, 16, 16, 0);
            a64_blr(&mut g.e, 16);
            NatEnc_word(&mut g.e, 0xA8C17BFD);
            // ldp x29, x30, [sp], #16
        } else {
            rv_addi(&mut g.e, RV_SP, RV_SP, 0 - 16);
            rv_store(&mut g.e, RV_RA, RV_SP, 8, 8);
            rv_addr(&mut g.e, RV_T0, g.ld.got_labels.get(k));
            rv_load(&mut g.e, RV_T0, RV_T0, 0, 8, true);
            rv_jalr(&mut g.e, RV_RA, RV_T0, 0);
            rv_load(&mut g.e, RV_RA, RV_SP, 8, 8, true);
            rv_addi(&mut g.e, RV_SP, RV_SP, 16);
        }
        var r0: i64 = ng_argreg(g, 0);
        var rc: i64 = str_byte_at(sig, gt + 1);
        if rc == 100 {
            if a64 {
                a64_fmov_xd(&mut g.e, r0, 0);
            } else {
                rv_fmv_xd(&mut g.e, r0, 10);
            }
        } else if rc == 115 {
            // MI25: an f32 result as its 32-bit pattern, zero-extended
            // (fmov w0, s0 clears the top; fmv.x.w sign-extends)
            if a64 {
                a64_fmov_ws(&mut g.e, r0, 0);
            } else {
                rv_fmv_xw(&mut g.e, r0, 10);
                ng_ext(g, r0, r0, NEXT_ZW);
            }
        } else if rc == 119 {
            ng_ext(g, r0, r0, NEXT_SW);
        } else if rc == 87 {
            ng_ext(g, r0, r0, NEXT_ZW);
        } else if rc == 104 {
            ng_ext(g, r0, r0, NEXT_SH);
        } else if rc == 72 {
            ng_ext(g, r0, r0, NEXT_ZH);
        } else if rc == 98 {
            ng_ext(g, r0, r0, NEXT_SB);
        } else if rc == 66 {
            ng_ext(g, r0, r0, NEXT_ZB);
        }
        if a64 {
            a64_ret(&mut g.e);
        } else {
            rv_ret(&mut g.e);
        }
        si = si + 1;
    }
}

/// L6C: the stubs of CallPtr in a module with C function pointers
/// (g_ng_cfp_on), one per C signature (ng_cfp_stub_label). Each is called
/// as the closure's function would be: the env in argument register 0, the
/// call's arguments after it (ng_load_args). Word 0 of the env not 0: a
/// closure, so jump to it with everything as it is (it returns to the
/// caller). Else word 1 is a C function: each argument goes to the next
/// free C register of its class (System V, AAPCS64, lp64d; Win64: by
/// position) and the result comes back in argument register 0 as Fides
/// holds it, as the CI2 stubs (ng_gen_ldyn_stubs) do.
fn ng_gen_cfp_stubs(g: &mut NatGen) {
    var si: i64 = 0;
    while si < g_ng_cfp_labels.len() {
        var sig: str = g_ng_cfp_sigs.get(si);
        NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
        NatEnc_place(&mut g.e, g_ng_cfp_labels.get(si));
        if ng_x64(g) {
            ng_cfp_stub_x64(g, sig);
        } else {
            ng_cfp_stub_risc(g, sig);
        }
        si = si + 1;
    }
}

/// L6C: one x86-64 stub (ng_gen_cfp_stubs). Arguments 0..3 arrive in rdi,
/// rsi, rdx, rcx, the rest on the stack above the return address; the env
/// is argument 0, so the call's argument j is at position j + 1. r11 holds
/// word 0, r10 the C function.
fn ng_cfp_stub_x64(g: &mut NatGen, sig: str) {
    var c_label: i64 = NatEnc_label(&mut g.e);
    var env: i64 = ng_argreg(g, 0);
    x64_load(&mut g.e, 11, env, 0, 8, true);
    x64_test(&mut g.e, 11, 11);
    x64_jcc(&mut g.e, 4, c_label);
    // je: a C function pointer; else the closure's function
    x64_jmp_r(&mut g.e, 11);
    NatEnc_place(&mut g.e, c_label);
    x64_load(&mut g.e, 10, env, 8, 8, true);
    var gt: i64 = str_find(sig, ">");
    if g.win {
        // Win64: argument j in rcx, rdx, r8, r9 or xmm<j> by position (at
        // most four, ng_cfp_sig). From the last to the first: argument j's
        // register is never one an earlier argument is still read from
        // (rcx holds argument 2, moved before argument 0 takes rcx).
        var j: i64 = gt - 1;
        while j >= 0 {
            var c: i64 = str_byte_at(sig, j);
            var p: i64 = j + 1;
            var src: i64 = 11;
            if p < 4 {
                src = ng_argreg(g, p);
            } else {
                x64_load(&mut g.e, 11, 4, 8 + 8 * (p - 4), 8, true);
            }
            if c == 100 || c == 115 {
                x64_movq_xr(&mut g.e, j, src, c == 100);
            } else {
                var dst: i64 = ng_cfp_win_int(j);
                if dst != src {
                    x64_mov(&mut g.e, dst, src);
                }
            }
            j = j - 1;
        }
        // the 32-byte shadow space, and rsp back on a 16-byte boundary
        // (the call to the stub pushed the return address)
        x64_sub_imm(&mut g.e, 4, 40);
        x64_call_r(&mut g.e, 10);
        x64_add_imm(&mut g.e, 4, 40);
    } else {
        var ii: i64 = 0;
        var fi: i64 = 0;
        var j2: i64 = 0;
        while j2 < gt {
            var c2: i64 = str_byte_at(sig, j2);
            var p2: i64 = j2 + 1;
            var src2: i64 = 11;
            if p2 < 4 {
                src2 = ng_argreg(g, p2);
            } else {
                x64_load(&mut g.e, 11, 4, 8 + 8 * (p2 - 4), 8, true);
            }
            if c2 == 100 || c2 == 115 {
                // MI25: an f64 as its 64 bits, an f32 as its 32-bit pattern
                x64_movq_xr(&mut g.e, fi, src2, c2 == 100);
                fi = fi + 1;
            } else {
                // System V register ii (ii <= j2): the register of position
                // ii, already read (the env, or argument ii - 1)
                var dst2: i64 = ng_ldyn_sysv_int(ii);
                if dst2 != src2 {
                    x64_mov(&mut g.e, dst2, src2);
                }
                ii = ii + 1;
            }
            j2 = j2 + 1;
        }
        // al = the vector registers used (variadic callees)
        x64_li(&mut g.e, 0, fi);
        x64_sub_imm(&mut g.e, 4, 8);
        x64_call_r(&mut g.e, 10);
        x64_add_imm(&mut g.e, 4, 8);
    }
    var rc: i64 = str_byte_at(sig, gt + 1);
    if rc == 100 {
        x64_movq_rx(&mut g.e, 7, 0, true);
    } else if rc == 115 {
        // MI25: the float's 32-bit pattern, zero-extended
        x64_movq_rx(&mut g.e, 7, 0, false);
    } else if rc == 119 {
        ng_ext(g, 7, 0, NEXT_SW);
    } else if rc == 87 {
        ng_ext(g, 7, 0, NEXT_ZW);
    } else if rc == 104 {
        ng_ext(g, 7, 0, NEXT_SH);
    } else if rc == 72 {
        ng_ext(g, 7, 0, NEXT_ZH);
    } else if rc == 98 {
        ng_ext(g, 7, 0, NEXT_SB);
    } else if rc == 66 {
        ng_ext(g, 7, 0, NEXT_ZB);
    } else {
        x64_mov(&mut g.e, 7, 0);
    }
    x64_ret(&mut g.e);
}

/// Win64's integer argument register of position `j`: rcx, rdx, r8, r9.
fn ng_cfp_win_int(j: i64) -> i64 {
    if j == 0 {
        return 1;
    }
    if j == 1 {
        return 2;
    }
    if j == 2 {
        return 8;
    }
    return 9;
}

/// L6C: one AArch64 / RISC-V 64 stub (ng_gen_cfp_stubs). Arguments 0..7
/// arrive in x0..x7 / a0..a7, the rest at [sp + 8 * (p - 8)]; the env is
/// argument 0, so the call's argument j is at position j + 1. x17 / t1
/// holds word 0, then the C function; x16 / t0 a stack argument.
fn ng_cfp_stub_risc(g: &mut NatGen, sig: str) {
    var a64: bool = ng_a64(g);
    var tg: i64 = 6;
    if a64 {
        tg = 17;
    }
    var env: i64 = ng_argreg(g, 0);
    var c_label: i64 = NatEnc_label(&mut g.e);
    if a64 {
        a64_ldr(&mut g.e, tg, env, 0);
        a64_cbz(&mut g.e, tg, c_label);
        a64_br(&mut g.e, tg);
    } else {
        rv_load(&mut g.e, tg, env, 0, 8, true);
        rv_b_label(&mut g.e, RV_BEQ, tg, RV_ZERO, c_label);
        rv_jalr(&mut g.e, RV_ZERO, tg, 0);
    }
    NatEnc_place(&mut g.e, c_label);
    if a64 {
        a64_ldr(&mut g.e, tg, env, 8);
    } else {
        rv_load(&mut g.e, tg, env, 8, 8, true);
    }
    var gt: i64 = str_find(sig, ">");
    var ii: i64 = 0;
    var fi: i64 = 0;
    var j: i64 = 0;
    while j < gt {
        var c: i64 = str_byte_at(sig, j);
        var p: i64 = j + 1;
        var src: i64 = 0;
        if p < 8 {
            src = ng_argreg(g, p);
        } else if a64 {
            src = 16;
            a64_ldr(&mut g.e, 16, A64_SP, 8 * (p - 8));
        } else {
            src = RV_T0;
            rv_load(&mut g.e, RV_T0, RV_SP, 8 * (p - 8), 8, true);
        }
        if c == 100 || c == 115 {
            // MI25: an f32 is its 32-bit pattern, never widened
            if a64 {
                if c == 115 {
                    a64_fmov_sw(&mut g.e, fi, src);
                } else {
                    a64_fmov_dx(&mut g.e, fi, src);
                }
            } else {
                if c == 115 {
                    rv_fmv_wx(&mut g.e, 10 + fi, src);
                } else {
                    rv_fmv_dx(&mut g.e, 10 + fi, src);
                }
            }
            fi = fi + 1;
        } else {
            // the C register ii (ii <= j): that of position ii, already read
            var dst: i64 = ng_argreg(g, ii);
            if dst != src {
                if a64 {
                    a64_mov(&mut g.e, dst, src);
                } else {
                    rv_mv(&mut g.e, dst, src);
                }
            }
            ii = ii + 1;
        }
        j = j + 1;
    }
    if a64 {
        NatEnc_word(&mut g.e, 0xA9BF7BFD);
        // stp x29, x30, [sp, #-16]!
        a64_add_imm(&mut g.e, A64_FP, A64_SP, 0);
        a64_blr(&mut g.e, tg);
        NatEnc_word(&mut g.e, 0xA8C17BFD);
        // ldp x29, x30, [sp], #16
    } else {
        rv_addi(&mut g.e, RV_SP, RV_SP, 0 - 16);
        rv_store(&mut g.e, RV_RA, RV_SP, 8, 8);
        rv_jalr(&mut g.e, RV_RA, tg, 0);
        rv_load(&mut g.e, RV_RA, RV_SP, 8, 8, true);
        rv_addi(&mut g.e, RV_SP, RV_SP, 16);
    }
    var r0: i64 = ng_argreg(g, 0);
    var rc: i64 = str_byte_at(sig, gt + 1);
    if rc == 100 {
        if a64 {
            a64_fmov_xd(&mut g.e, r0, 0);
        } else {
            rv_fmv_xd(&mut g.e, r0, 10);
        }
    } else if rc == 115 {
        // MI25: an f32 result as its 32-bit pattern, zero-extended
        if a64 {
            a64_fmov_ws(&mut g.e, r0, 0);
        } else {
            rv_fmv_xw(&mut g.e, r0, 10);
            ng_ext(g, r0, r0, NEXT_ZW);
        }
    } else if rc == 119 {
        ng_ext(g, r0, r0, NEXT_SW);
    } else if rc == 87 {
        ng_ext(g, r0, r0, NEXT_ZW);
    } else if rc == 104 {
        ng_ext(g, r0, r0, NEXT_SH);
    } else if rc == 72 {
        ng_ext(g, r0, r0, NEXT_ZH);
    } else if rc == 98 {
        ng_ext(g, r0, r0, NEXT_SB);
    } else if rc == 66 {
        ng_ext(g, r0, r0, NEXT_ZB);
    }
    if a64 {
        a64_ret(&mut g.e);
    } else {
        rv_ret(&mut g.e);
    }
}

/// System V's integer argument register `i`: rdi, rsi, rdx, rcx, r8, r9.
fn ng_ldyn_sysv_int(i: i64) -> i64 {
    if i == 0 {
        return 7;
    }
    if i == 1 {
        return 6;
    }
    if i == 2 {
        return 2;
    }
    if i == 3 {
        return 1;
    }
    if i == 4 {
        return 8;
    }
    return 9;
}

/// The file the dynamic linker loads for `link "lib"` ("" or "c": libc).
fn ng_ldyn_lib_file(lib: str) -> str {
    if lib == "" || lib == "c" || lib == "pthread" || lib == "dl" || lib == "rt" {
        // glibc 2.34 and later: pthread, dl and rt are part of libc
        return "libc.so.6";
    }
    if lib == "m" {
        return "libm.so.6";
    }
    if str_contains(lib, ".so") {
        return lib;
    }
    return "lib" + lib + ".so";
}

fn ng_ldyn_bytes(g: &mut NatGen, s: str) {
    var i: i64 = 0;
    while i < str_len(s) {
        NatEnc_byte(&mut g.e, str_byte_at(s, i));
        i = i + 1;
    }
    NatEnc_byte(&mut g.e, 0);
}

/// An 8-byte word holding the absolute address of `label`.
fn ng_ldyn_addr(g: &mut NatGen, label: i64) {
    NatEnc_fix(&mut g.e, label, NATFIX_ABS64);
    NatEnc_quad(&mut g.e, 0);
}

/// The dynamic linker's tables in the image's data: the GOT, the
/// interpreter path, .dynstr, .dynsym, the hash table (one bucket, no
/// symbol of its own defined), the relocations and the dynamic section.
fn ng_gen_ldyn(g: &mut NatGen) {
    var n: i64 = g.ld.names.len();
    if n == 0 {
        return;
    }
    // TG15: on Windows the slots are IAT entries (ng_gen_win_imports)
    if g.win {
        return;
    }
    NatEnc_align(&mut g.e, 8);
    var i: i64 = 0;
    while i < n {
        NatEnc_place(&mut g.e, g.ld.got_labels.get(i));
        NatEnc_quad(&mut g.e, 0);
        i = i + 1;
    }
    // TG15: macOS needs only the slots (dyld binds them: nat_macho)
    if g.mac {
        return;
    }
    g.ld.interp_label = NatEnc_label(&mut g.e);
    NatEnc_place(&mut g.e, g.ld.interp_label);
    ng_ldyn_bytes(g, ng_ldyn_interp(g));
    // .dynstr: "", the libraries (each once), the imports
    var needed: Vec<str> = Vec::new();
    var seen: i64 = HashMap_new();
    i = 0;
    while i < n {
        var lf: str = ng_ldyn_lib_file(g.ld.libs.get(i));
        if !HashMap_contains(seen, lf) {
            HashMap_insert(seen, lf, 1);
            needed.push(lf);
        }
        i = i + 1;
    }
    if !HashMap_contains(seen, "libc.so.6") {
        needed.push("libc.so.6");
    }
    var str_label: i64 = NatEnc_label(&mut g.e);
    NatEnc_place(&mut g.e, str_label);
    var spos: i64 = 1;
    NatEnc_byte(&mut g.e, 0);
    var need_off: Vec<i64> = Vec::new();
    i = 0;
    while i < needed.len() {
        need_off.push(spos);
        ng_ldyn_bytes(g, needed.get(i));
        spos = spos + str_len(needed.get(i)) + 1;
        i = i + 1;
    }
    var name_off: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        name_off.push(spos);
        ng_ldyn_bytes(g, g.ld.names.get(i));
        spos = spos + str_len(g.ld.names.get(i)) + 1;
        i = i + 1;
    }
    var strsz: i64 = spos;
    // .dynsym: the null symbol, then each import (global function,
    // undefined)
    NatEnc_align(&mut g.e, 8);
    var sym_label: i64 = NatEnc_label(&mut g.e);
    NatEnc_place(&mut g.e, sym_label);
    NatEnc_quad(&mut g.e, 0);
    NatEnc_quad(&mut g.e, 0);
    NatEnc_quad(&mut g.e, 0);
    i = 0;
    while i < n {
        NatEnc_u32(&mut g.e, name_off.get(i));
        NatEnc_byte(&mut g.e, 0x12);
        NatEnc_byte(&mut g.e, 0);
        NatEnc_byte(&mut g.e, 0);
        NatEnc_byte(&mut g.e, 0);
        NatEnc_quad(&mut g.e, 0);
        NatEnc_quad(&mut g.e, 0);
        i = i + 1;
    }
    // DT_HASH: nbucket 1, nchain n + 1, the bucket and the chains all 0
    // (STN_UNDEF: the executable defines nothing others look up)
    var hash_label: i64 = NatEnc_label(&mut g.e);
    NatEnc_place(&mut g.e, hash_label);
    NatEnc_u32(&mut g.e, 1);
    NatEnc_u32(&mut g.e, n + 1);
    NatEnc_u32(&mut g.e, 0);
    i = 0;
    while i <= n {
        NatEnc_u32(&mut g.e, 0);
        i = i + 1;
    }
    // .rela.dyn: GOT slot i = the address of symbol i + 1
    NatEnc_align(&mut g.e, 8);
    var rela_label: i64 = NatEnc_label(&mut g.e);
    NatEnc_place(&mut g.e, rela_label);
    i = 0;
    while i < n {
        ng_ldyn_addr(g, g.ld.got_labels.get(i));
        NatEnc_quad(&mut g.e, ((i + 1) << 32) | ng_ldyn_rel_type(g));
        // R_X86_64_GLOB_DAT (TG15: the target's, ng_ldyn_rel_type)
        NatEnc_quad(&mut g.e, 0);
        i = i + 1;
    }
    // .dynamic
    g.ld.dyn_label = NatEnc_label(&mut g.e);
    NatEnc_place(&mut g.e, g.ld.dyn_label);
    i = 0;
    while i < needed.len() {
        NatEnc_quad(&mut g.e, 1);
        // DT_NEEDED
        NatEnc_quad(&mut g.e, need_off.get(i));
        i = i + 1;
    }
    NatEnc_quad(&mut g.e, 4);
    // DT_HASH
    ng_ldyn_addr(g, hash_label);
    NatEnc_quad(&mut g.e, 5);
    // DT_STRTAB
    ng_ldyn_addr(g, str_label);
    NatEnc_quad(&mut g.e, 6);
    // DT_SYMTAB
    ng_ldyn_addr(g, sym_label);
    NatEnc_quad(&mut g.e, 10);
    // DT_STRSZ
    NatEnc_quad(&mut g.e, strsz);
    NatEnc_quad(&mut g.e, 11);
    // DT_SYMENT
    NatEnc_quad(&mut g.e, 24);
    NatEnc_quad(&mut g.e, 7);
    // DT_RELA
    ng_ldyn_addr(g, rela_label);
    NatEnc_quad(&mut g.e, 8);
    // DT_RELASZ
    NatEnc_quad(&mut g.e, 24 * n);
    NatEnc_quad(&mut g.e, 9);
    // DT_RELAENT
    NatEnc_quad(&mut g.e, 24);
    NatEnc_quad(&mut g.e, 30);
    // DT_FLAGS: DF_BIND_NOW
    NatEnc_quad(&mut g.e, 8);
    NatEnc_quad(&mut g.e, 21);
    // DT_DEBUG
    NatEnc_quad(&mut g.e, 0);
    NatEnc_quad(&mut g.e, 0);
    // DT_NULL
    NatEnc_quad(&mut g.e, 0);
    g.ld.dyn_end_label = NatEnc_label(&mut g.e);
    NatEnc_place(&mut g.e, g.ld.dyn_end_label);
}

/// The interpreter of x86-64 glibc systems.
const NG_LDYN_INTERP: str = "/lib64/ld-linux-x86-64.so.2";

/// nat_elf's PT_INTERP and PT_DYNAMIC (g_nat_ldyn_*), or none.
fn ng_ldyn_set_segments(g: &NatGen) {
    g_nat_ldyn_interp = 0 - 1;
    g_nat_ldyn_dyn = 0 - 1;
    g_nat_elf_tls = 0 - 1;
    if g.ld.names.len() == 0 || g.ld.dyn_label < 0 {
        return;
    }
    g_nat_ldyn_interp = NatEnc_label_offset(&g.e, g.ld.interp_label);
    g_nat_ldyn_interp_len = str_len(ng_ldyn_interp(g)) + 1;
    g_nat_ldyn_dyn = NatEnc_label_offset(&g.e, g.ld.dyn_label);
    g_nat_ldyn_dyn_len = NatEnc_label_offset(&g.e, g.ld.dyn_end_label) - g_nat_ldyn_dyn;
    // 2g.99: x86-64 keeps the runtime's thread block in the executable's
    // static TLS (nat_tls_get reads fs:[-8]); the dynamic loader makes that
    // block from PT_TLS (no file bytes: any 8-aligned place of the image)
    if ng_x64(g) && (g_nat_ldyn_dyn & 7) == 0 {
        g_nat_elf_tls = g_nat_ldyn_dyn;
    }
}

// --- CT9: debug info names Fides functions and types as written ----------

/// The type checker's builtin types whose methods lower as Type_method.
fn ng_dbg_builtin_type(p: str) -> bool {
    return p == "Vec" || p == "HashMap" || p == "StringBuilder" || p == "Option" || p == "Result" || p == "Box" || p == "String";
}

/// A one-word CamelCase type name: an upper-case letter first, no `_`,
/// some lower-case letter.
fn ng_dbg_camel(p: str) -> bool {
    var n: i64 = str_len(p);
    if n < 2 {
        return false;
    }
    var c0: i64 = str_byte_at(p, 0);
    if c0 < 65 || c0 > 90 {
        return false;
    }
    var lower: bool = false;
    var i: i64 = 1;
    while i < n {
        var c: i64 = str_byte_at(p, i);
        if c == 95 {
            return false;
        }
        if c >= 97 && c <= 122 {
            lower = true;
        }
        i = i + 1;
    }
    return lower;
}

/// The name a debugger shows for function `name`: a method, lowered as
/// Type_method, as Fides writes it, Type::method. The type is the longest
/// prefix before a `_` that names a struct of the module or a builtin
/// collection, else a CamelCase first word (an enum's or a trait impl's
/// methods); anything else shows as it is. CT9: an instance of a generic
/// function (compiler/mono.fd `mangle`: `max__i64`, `pair__i64_str`)
/// shows with its type arguments as written, `max<i64>`, `pair<i64, str>`;
/// a generic method (`mangle_method`: `Stack__push__i64`) as
/// `Stack::push<i64>`.
fn ng_dbg_shown_name(module: &IrModule, name: str) -> str {
    if str_starts_with(name, "__") || !str_contains(name, "__") {
        return ng_dbg_method_name(module, name);
    }
    var parts: Vec<str> = str_split(name, "__");
    if parts.len() < 2 || parts.len() > 3 {
        return ng_dbg_method_name(module, name);
    }
    var pi: i64 = 0;
    while pi < parts.len() {
        if str_len(parts.get(pi)) == 0 {
            return ng_dbg_method_name(module, name);
        }
        pi = pi + 1;
    }
    var targs: str = ng_dbg_type_args(module, parts.get(parts.len() - 1));
    if str_len(targs) == 0 {
        return ng_dbg_method_name(module, name);
    }
    if parts.len() == 3 {
        return parts.get(0) + "::" + parts.get(1) + "<" + targs + ">";
    }
    return ng_dbg_method_name(module, parts.get(0)) + "<" + targs + ">";
}

/// CT9 / DB4: the instances of a generic function of the input file
/// (mono.fd: `pick__i64` of `pick`, `Stack__push__i64` of the method
/// `Stack_push`) get line rows and variables as the function itself
/// would: their code is its body, so its lines (g.line_fns holds the input
/// file's functions by name; an instance named nowhere had no rows, so a
/// debugger could not stop in it).
fn ng_dbg_line_instances(g: &mut NatGen, module: &IrModule) {
    var i: i64 = 0;
    while i < module.functions.len() {
        var nm: str = module.functions.get(i).name;
        if !str_starts_with(nm, "__") && str_contains(nm, "__") && !HashMap_contains(g.line_fns, nm) {
            var parts: Vec<str> = str_split(nm, "__");
            var base: str = "";
            if parts.len() == 2 {
                base = parts.get(0);
            } else if parts.len() == 3 {
                base = parts.get(0) + "_" + parts.get(1);
            }
            if str_len(base) > 0 && HashMap_contains(g.line_fns, base) {
                HashMap_insert(g.line_fns, nm, 1);
            }
        }
        i = i + 1;
    }
}

/// CT9: a type argument mono.fd's `mangle_type` writes as one word: a
/// primitive, a struct of the module, a builtin collection or a CamelCase
/// name.
fn ng_dbg_simple_type(module: &IrModule, t: str) -> bool {
    if t == "i8" || t == "i16" || t == "i32" || t == "i64" || t == "i128" || t == "u8" || t == "u16" || t == "u32" || t == "u64" || t == "u128" {
        return true;
    }
    if t == "f32" || t == "f64" || t == "bool" || t == "str" || t == "void" {
        return true;
    }
    return HashMap_contains(module.struct_index, t) || ng_dbg_builtin_type(t) || ng_dbg_camel(t);
}

/// CT9: the type arguments of a mangled instance (`i64_str`, the words
/// mangle joins with `_`) as written, "i64, str"; each is the longest
/// run of words that is a simple type (a struct name may hold a `_`).
/// "" when the text is not such a list (the name then shows as it is).
fn ng_dbg_type_args(module: &IrModule, s: str) -> str {
    var out: Vec<str> = Vec::new();
    var n: i64 = str_len(s);
    var pos: i64 = 0;
    while pos < n {
        var best: i64 = 0 - 1;
        var k: i64 = pos + 1;
        while k <= n {
            if k == n || str_byte_at(s, k) == 95 {
                if ng_dbg_simple_type(module, str_slice(s, pos, k)) {
                    best = k;
                }
            }
            k = k + 1;
        }
        if best < 0 {
            return "";
        }
        out.push(str_slice(s, pos, best));
        pos = best + 1;
    }
    if out.len() == 0 || pos != n + 1 {
        return "";
    }
    return str_join(out, ", ");
}

/// Type_method as Type::method (ng_dbg_shown_name without type arguments).
fn ng_dbg_method_name(module: &IrModule, name: str) -> str {
    var n: i64 = str_len(name);
    var best: i64 = 0 - 1;
    var first: i64 = 0 - 1;
    var k: i64 = 1;
    while k < n - 1 {
        if str_byte_at(name, k) == 95 {
            var p: str = str_slice(name, 0, k);
            if first < 0 {
                first = k;
            }
            if HashMap_contains(module.struct_index, p) || ng_dbg_builtin_type(p) {
                best = k;
            }
        }
        k = k + 1;
    }
    if best < 0 && first > 0 && ng_dbg_camel(str_slice(name, 0, first)) {
        best = first;
    }
    if best < 0 || str_byte_at(name, best + 1) == 95 {
        return name;
    }
    return str_slice(name, 0, best) + "::" + str_slice(name, best + 1, n);
}

/// ng_dbg_shown_name of each function in `names`; empty when every one
/// shows as its symbol (nat_elf_debug's sections stay as they were).
fn ng_dbg_shown_names(module: &IrModule, names: Vec<str>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var any: bool = false;
    var i: i64 = 0;
    while i < names.len() {
        var s: str = ng_dbg_shown_name(module, names.get(i));
        if s != names.get(i) {
            any = true;
        }
        out.push(s);
        i = i + 1;
    }
    if !any {
        return Vec::new();
    }
    return out;
}

/// CT9 for pe_ir (which does not import nat_ir): each function of
/// `module` whose debugger name (ng_dbg_shown_name) differs from its
/// symbol, as pairs [symbol, shown, symbol, shown, ...]. compiler/main.fd
/// gives them to pe_ir_enc.fd g_pe_dbg_shown_pairs before a debug build.
pub fn ng_dbg_shown_pairs(module: &IrModule) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < module.functions.len() {
        var nm: str = module.functions.get(i).name;
        var s: str = ng_dbg_shown_name(module, nm);
        if s != nm {
            out.push(nm);
            out.push(s);
        }
        i = i + 1;
    }
    return out;
}

// --- DB4: where each source variable lives ---------------------------------

/// DB4: per function (by name), its parameters and variables as
/// selection left them, one per line: kind, name, type name, size,
/// encoding (nat_enc.fd g_nat_dbg_vars), then "M<off>" (memory at sp + off:
/// an alloca not promoted) or "R<id>" (IR value id's vreg). 0: none yet.
pub var g_ng_dbg_pend: i64 = 0;
/// DB4: the same with the locations resolved after allocation
/// (ng_dbg_vars_resolve), in g_nat_dbg_vars' format.
pub var g_ng_dbg_vars: i64 = 0;

/// The type of a variable for g_ng_dbg_pend: name, size, encoding ("S" a
/// struct held inline, "P" a pointer to a struct, both named by the
/// struct; else the scalar's DWARF encoding).
fn ng_dbg_var_type(module: &IrModule, t: IrType) -> str {
    match t {
        IrType::Struct(sn) => {
            return sn + "\t" + int_to_str(IrModule_type_size(module, t)) + "\tS";
        }
        IrType::Ptr(inner) => {
            var it: IrType = box_ir_type_unbox(inner);
            match it {
                IrType::Struct(sn2) => {
                    return sn2 + "\t8\tP";
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    if ng_dbg_is_str(t) {
        // CT9: the text type (nat_enc.fd nat_dbg_str_type)
        return "str\t8\tZ";
    }
    var size: i64 = IrModule_type_size(module, t);
    if size <= 0 || size > 8 {
        size = 8;
    }
    return ng_dbg_type_name(t) + "\t" + int_to_str(size) + "\t" + int_to_str(ng_dbg_encoding(t));
}

/// CT6: the values of `func` whose memory something may write (by id):
/// the pointer of a Store, and any value used other than as a Load's
/// pointer (its address escapes: a call, a field address, a stored
/// pointer may write through it).
fn ng_dbg_written(func: &IrFunction) -> i64 {
    var w: i64 = HashMap_new();
    var ops: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < func.insts.len() {
        var inst: Inst = func.insts.get(i).inst;
        match inst {
            Inst::Load(_, _) => {
            }
            Inst::Store(p, v, _) => {
                HashMap_insert(w, int_to_str(p), 1);
                HashMap_insert(w, int_to_str(v), 1);
            }
            _ => {
                ops.clear();
                ng_inst_operands(inst, &mut ops);
                var k: i64 = 0;
                while k < ops.len() {
                    HashMap_insert(w, int_to_str(ops.get(k)), 1);
                    k = k + 1;
                }
            }
        }
        i = i + 1;
    }
    return w;
}

/// DB4: the source variables of `func` (IrFunction.locals: each name with
/// the alloca or value it is bound to) and where selection put them; called
/// once the function is recorded (g.promoted, g.alloca_data are its own).
/// A parameter the body rebinds (a copy it changes) is shown at the copy.
/// Hidden names (`__env`, ...) are left out.
fn ng_dbg_vars_note(g: &NatGen, name: str, func: &IrFunction, module: &IrModule) {
    // DB4: an earlier build's split of this name no longer holds
    // (ng_dbg_split_note comes again when this one's split is kept)
    if g_ng_dbg_split != 0 && HashMap_contains(g_ng_dbg_split, name) {
        HashMap_insert(g_ng_dbg_split, name, "");
    }
    var written: i64 = ng_dbg_written(func);
    var params: i64 = HashMap_new();
    var i: i64 = 0;
    while i < func.params.len() {
        HashMap_insert(params, int_to_str(func.params.get(i).id), i + 1);
        i = i + 1;
    }
    var entries: Vec<str> = Vec::new();
    // DB4: the value each entry is bound to (its source lines: scopes)
    var eids: Vec<i64> = Vec::new();
    var seen: i64 = HashMap_new();
    var pnames: i64 = HashMap_new();
    i = 0;
    while i < func.locals.len() {
        var lv: StringValueId = func.locals.get(i);
        var nm: str = lv.name;
        var id: i64 = lv.id;
        var key: str = nm + "\t" + int_to_str(id);
        if str_len(nm) > 0 && !str_starts_with(nm, "__") && !str_contains(nm, "\t") && !str_contains(nm, "\n") && !HashMap_contains(seen, key) {
            HashMap_insert(seen, key, 1);
            var tdesc: str = "";
            var loc: str = "";
            var is_alloca: bool = false;
            var gone: bool = true;
            match IrFunction_get_inst(func, id) {
                OptInst::Some(inst) => {
                    gone = false;
                    match inst {
                        Inst::Alloca(aty, _) => {
                            is_alloca = true;
                            tdesc = ng_dbg_var_type(module, aty);
                            // g.promoted directly: ng_is_promoted also
                            // asks g.rec, already off once recorded (a
                            // promoted local was shown at its unused slot)
                            if id >= 0 && id < g.promoted.len() && g.promoted.get(id) != 0 {
                                loc = "R" + int_to_str(id);
                            } else if id >= 0 && id < g.alloca_data.len() && g.alloca_data.get(id) >= 0 && HashMap_contains(written, int_to_str(id)) {
                                // CT6: only while something still writes
                                // it (the mid-end forwards a local's
                                // loads and drops its stores: its slot
                                // then never holds the value)
                                loc = "M" + int_to_str(g.alloca_data.get(id));
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            if !is_alloca {
                // a value: a parameter, or a value bound as it is
                loc = "R" + int_to_str(id);
                if HashMap_contains(params, int_to_str(id)) {
                    tdesc = ng_dbg_var_type(module, func.params.get(HashMap_get(params, int_to_str(id)) - 1).ty);
                } else {
                    match IrFunction_get_meta(func, id) {
                        OptValueMeta::Some(vm) => {
                            tdesc = ng_dbg_var_type(module, vm.ty);
                            if gone {
                                // an alloca the IR optimizer promoted
                                // away (iropt iro_promote): its loads
                                // became the stored values, so it has no
                                // one place; its type is what it held
                                loc = "";
                                match vm.ty {
                                    IrType::Ptr(held) => {
                                        tdesc = ng_dbg_var_type(module, box_ir_type_unbox(held));
                                    }
                                    _ => {
                                    }
                                }
                            }
                        }
                        OptValueMeta::None => {
                            tdesc = ng_dbg_var_type(module, IrType::I64);
                        }
                    }
                }
            }
            var is_param: bool = HashMap_contains(params, int_to_str(id));
            if HashMap_contains(pnames, nm) {
                // the body's copy of a parameter replaces it
                entries.set(HashMap_get(pnames, nm) - 1, "P\t" + nm + "\t" + tdesc + "\t" + loc);
                eids.set(HashMap_get(pnames, nm) - 1, id);
            } else if is_param {
                entries.push("P\t" + nm + "\t" + tdesc + "\t" + loc);
                eids.push(id);
                HashMap_insert(pnames, nm, entries.len());
            } else {
                entries.push("V\t" + nm + "\t" + tdesc + "\t" + loc);
                eids.push(id);
            }
        }
        i = i + 1;
    }
    if entries.len() == 0 {
        return;
    }
    // DB4: a name bound more than once gets its source lines, from which
    // the emission makes lexical scopes (ng_dbg_scope_blocks)
    if ng_on("dbgscopes") {
        ng_dbg_scope_lines(name, func, &mut entries, &eids);
    }
    if g_ng_dbg_pend == 0 {
        g_ng_dbg_pend = HashMap_new();
    }
    HashMap_insert(g_ng_dbg_pend, name, str_join(entries, "\n"));
}

/// DB4: the variables ("V") of function `name`'s `entries` whose name is
/// bound more than once (shadowing, `var e` in two loops) get a seventh
/// field "L<lo>:<hi>", the lines of its scope in the function's own file:
/// from its declaration (the line of the value it is bound to: lowering
/// gives an alloca its `var` statement's line, which stays when the IR
/// optimizer removes the alloca) to the `}` that closes the block it is
/// declared in (nat_enc.fd nat_dbg_scope_end, read from the source), and
/// at least over every line that defines or reads it (`eids`: the value
/// each entry is bound to; an alloca's own instruction is not a use).
/// Code inlined from another file does not count. Without a line the
/// binding keeps six fields (the whole function). `FID_NAT_OFF=dbgbraces`:
/// the lines of its definitions and uses only.
fn ng_dbg_scope_lines(name: str, func: &IrFunction, entries: &mut Vec<str>, eids: &Vec<i64>) {
    var count: i64 = HashMap_new();
    var k: i64 = 0;
    while k < entries.len() {
        var p: Vec<str> = str_split(entries.get(k), "\t");
        if p.len() >= 2 && p.get(0) == "V" {
            var c: i64 = 0;
            if HashMap_contains(count, p.get(1)) {
                c = HashMap_get(count, p.get(1));
            }
            HashMap_insert(count, p.get(1), c + 1);
        }
        k = k + 1;
    }
    // the values whose lines are wanted, by id -> entry indexes
    var want: i64 = HashMap_new();
    var any: bool = false;
    k = 0;
    while k < entries.len() && k < eids.len() {
        var p2: Vec<str> = str_split(entries.get(k), "\t");
        if p2.len() >= 2 && p2.get(0) == "V" && HashMap_get(count, p2.get(1)) > 1 && eids.get(k) >= 0 {
            HashMap_insert(want, int_to_str(eids.get(k)), 1);
            any = true;
        }
        k = k + 1;
    }
    if !any {
        HashMap_drop(count);
        HashMap_drop(want);
        return;
    }
    var lo: i64 = HashMap_new();
    var hi: i64 = HashMap_new();
    var ops: Vec<i64> = Vec::new();
    var bi: i64 = 0;
    while bi < func.blocks.len() {
        var block: BasicBlock = func.blocks.get(bi);
        var ii: i64 = 0;
        while ii < block.instructions.len() {
            var iid: i64 = block.instructions.get(ii);
            var l: i64 = ng_meta_line(func, iid);
            if l > 0 && ng_dbg_inst_file(func, iid) == 0 {
                match IrFunction_get_inst(func, iid) {
                    OptInst::Some(inst) => {
                        var is_alloca: bool = false;
                        match inst {
                            Inst::Alloca(_, _) => {
                                is_alloca = true;
                            }
                            _ => {
                            }
                        }
                        ops.clear();
                        ng_inst_operands(inst, &mut ops);
                        if !is_alloca {
                            ops.push(iid);
                        }
                        var oi: i64 = 0;
                        while oi < ops.len() {
                            var key: str = int_to_str(ops.get(oi));
                            if HashMap_contains(want, key) {
                                if !HashMap_contains(lo, key) || l < HashMap_get(lo, key) {
                                    HashMap_insert(lo, key, l);
                                }
                                if !HashMap_contains(hi, key) || l > HashMap_get(hi, key) {
                                    HashMap_insert(hi, key, l);
                                }
                            }
                            oi = oi + 1;
                        }
                    }
                    OptInst::None => {
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    var path: str = ng_dbg_src_path(name);
    var braces: bool = ng_on("dbgbraces");
    k = 0;
    while k < entries.len() && k < eids.len() {
        var p3: Vec<str> = str_split(entries.get(k), "\t");
        var id3: i64 = eids.get(k);
        var key2: str = int_to_str(id3);
        if p3.len() >= 2 && p3.get(0) == "V" && HashMap_get(count, p3.get(1)) > 1 && id3 >= 0 {
            // its declaration's line (its own value's)
            var dl: i64 = ng_meta_line(func, id3);
            if dl > 0 && ng_dbg_inst_file(func, id3) != 0 {
                dl = 0;
            }
            var l0: i64 = dl;
            var l1: i64 = dl;
            if HashMap_contains(lo, key2) {
                if l0 <= 0 || HashMap_get(lo, key2) < l0 {
                    l0 = HashMap_get(lo, key2);
                }
                if HashMap_get(hi, key2) > l1 {
                    l1 = HashMap_get(hi, key2);
                }
            }
            if dl > 0 && braces {
                var se: i64 = nat_dbg_scope_end(path, dl);
                if se > l1 {
                    l1 = se;
                }
            }
            if l0 > 0 && l1 >= l0 {
                entries.set(k, entries.get(k) + "\tL" + int_to_str(l0) + ":" + int_to_str(l1));
            }
        }
        k = k + 1;
    }
    HashMap_drop(count);
    HashMap_drop(want);
    HashMap_drop(lo);
    HashMap_drop(hi);
}

/// DB4: the source file of function `name`'s line rows (nat_enc.fd's file
/// table: the input file, or the file of an imported module's function);
/// "" when not known.
fn ng_dbg_src_path(name: str) -> str {
    var ix: i64 = nat_line_fn_file(name);
    if ix >= 0 && ix < g_nat_line_files.len() && str_len(g_nat_line_files.get(ix)) > 0 {
        return g_nat_line_files.get(ix);
    }
    if ix == 0 {
        return g_nat_lines_file;
    }
    return "";
}

/// DB4: where function `name`'s code starts in g.e (its label's offset);
/// -1 when it has no label or the label is not placed.
fn ng_dbg_fn_start(g: &NatGen, name: str) -> i64 {
    if !HashMap_contains(g.fn_labels, name) {
        return 0 - 1;
    }
    var lab: i64 = HashMap_get(g.fn_labels, name);
    if lab < 0 || lab >= g.e.labels.len() {
        return 0 - 1;
    }
    return NatEnc_label_offset(&g.e, lab);
}

/// DB4: the indexes 0..a.len() ordered by `a` ascending, then `b`
/// ascending, then `c` descending (an insertion sort: a function's scopes
/// are few).
fn ng_dbg_sort3(a: &Vec<i64>, b: &Vec<i64>, c: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < a.len() {
        out.push(i);
        var j: i64 = out.len() - 1;
        while j > 0 {
            var x: i64 = out.get(j - 1);
            var before: bool = false;
            if a.get(i) < a.get(x) {
                before = true;
            } else if a.get(i) == a.get(x) {
                if b.get(i) < b.get(x) {
                    before = true;
                } else if b.get(i) == b.get(x) && c.get(i) > c.get(x) {
                    before = true;
                }
            }
            if !before {
                break;
            }
            out.set(j, x);
            out.set(j - 1, i);
            j = j - 1;
        }
        i = i + 1;
    }
    return out;
}

/// DB4: the resolved variables `lines` of function `name` (its code at
/// [fstart, fend) of g.e, its line rows the last of g.lrows), with
/// DW_TAG_lexical_block scopes for the names bound more than once
/// (ng_dbg_scope_lines' seventh field "L<lo>:<hi>"), as the text
/// nat_enc.fd's g_nat_dbg_vars takes: the variables of the whole function
/// with six fields; one line per scope, "B", its id, its parent's id (0:
/// the function), its code range from the function's start, in pre-order
/// (a parent before its children); and each scoped variable once per code
/// range of its scope, its seventh field that range's id.
///
/// The scopes come from the source lines: the line intervals are first
/// made to nest (when two overlap without one holding the other, the one
/// that starts first is widened to hold the other: a binding declared
/// inside another's lines lies in its scope), equal intervals are one
/// scope, and a scope's code is each maximal run of code whose rows have a
/// line inside its interval (code inlined from another file counts as the
/// line before it; a close row ends a run). Nested intervals give nested
/// runs, so the blocks nest as DWARF requires (a run that would cross its
/// parent's end is cut there). A variable whose scope has no code stays a
/// variable of the whole function. `FID_NAT_OFF=dbgscopes`: no scopes.
fn ng_dbg_scope_blocks(g: &NatGen, name: str, fstart: i64, fend: i64, lines: &Vec<str>) -> str {
    var n: i64 = lines.len();
    var plain: Vec<str> = Vec::new();
    var vint: Vec<i64> = Vec::new();
    var ilo: Vec<i64> = Vec::new();
    var ihi: Vec<i64> = Vec::new();
    var any: bool = false;
    var i: i64 = 0;
    while i < n {
        var p: Vec<str> = str_split(lines.get(i), "\t");
        var iv: i64 = 0 - 1;
        if p.len() >= 7 {
            plain.push(p.get(0) + "\t" + p.get(1) + "\t" + p.get(2) + "\t" + p.get(3) + "\t" + p.get(4) + "\t" + p.get(5));
            var f6: str = p.get(6);
            var colon: i64 = str_find(f6, ":");
            if str_len(f6) > 3 && str_byte_at(f6, 0) == 76 && colon > 1 {
                var lo: i64 = str_parse_int(str_slice(f6, 1, colon));
                var hi: i64 = str_parse_int(str_slice(f6, colon + 1, str_len(f6)));
                if lo > 0 && hi >= lo {
                    var j: i64 = 0;
                    while j < ilo.len() && iv < 0 {
                        if ilo.get(j) == lo && ihi.get(j) == hi {
                            iv = j;
                        }
                        j = j + 1;
                    }
                    if iv < 0 {
                        ilo.push(lo);
                        ihi.push(hi);
                        iv = ilo.len() - 1;
                    }
                    any = true;
                }
            }
        } else {
            plain.push(lines.get(i));
        }
        vint.push(iv);
        i = i + 1;
    }
    if !any || fstart < 0 || fend <= fstart {
        return str_join(plain, "\n");
    }
    var ni: i64 = ilo.len();
    var zeros: Vec<i64> = Vec::new();
    i = 0;
    while i < ni {
        zeros.push(0);
        i = i + 1;
    }
    // Make the intervals nest
    var round: i64 = 0;
    var changed: bool = true;
    while changed && round < 16 {
        changed = false;
        round = round + 1;
        var ord: Vec<i64> = ng_dbg_sort3(&ilo, &zeros, &ihi);
        var st: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < ord.len() {
            var b: i64 = ord.get(k);
            while st.len() > 0 && ihi.get(st.get(st.len() - 1)) < ilo.get(b) {
                st.pop();
            }
            if st.len() > 0 && ihi.get(b) > ihi.get(st.get(st.len() - 1)) {
                var s: i64 = 0;
                while s < st.len() {
                    if ihi.get(st.get(s)) < ihi.get(b) {
                        ihi.set(st.get(s), ihi.get(b));
                    }
                    s = s + 1;
                }
                changed = true;
            }
            st.push(b);
            k = k + 1;
        }
    }
    // Equal intervals are one scope; each scope's depth (how many hold it)
    var canon: Vec<i64> = Vec::new();
    i = 0;
    while i < ni {
        var cv: i64 = i;
        var j2: i64 = 0;
        while j2 < i && cv == i {
            if ilo.get(j2) == ilo.get(i) && ihi.get(j2) == ihi.get(i) {
                cv = canon.get(j2);
            }
            j2 = j2 + 1;
        }
        canon.push(cv);
        i = i + 1;
    }
    var depth: Vec<i64> = Vec::new();
    i = 0;
    while i < ni {
        var d: i64 = 0;
        var j3: i64 = 0;
        while j3 < ni {
            if canon.get(j3) == j3 && j3 != canon.get(i) && ilo.get(j3) <= ilo.get(i) && ihi.get(j3) >= ihi.get(i) && (ilo.get(j3) != ilo.get(i) || ihi.get(j3) != ihi.get(i)) {
                d = d + 1;
            }
            j3 = j3 + 1;
        }
        depth.push(d);
        i = i + 1;
    }
    // The function's rows: segments [start, next start) with their line
    // (offsets from fstart; its rows are the last ones of g.lrows)
    var own: i64 = 2 * nat_line_fn_file(name);
    var first: i64 = (g.lrows.len() / 3) * 3;
    while first >= 3 && g.lrows.get(first - 3) >= fstart {
        first = first - 3;
    }
    var sst: Vec<i64> = Vec::new();
    var sln: Vec<i64> = Vec::new();
    var last_own: i64 = 0;
    var r: i64 = first;
    while r + 2 < g.lrows.len() {
        var off: i64 = g.lrows.get(r);
        if off >= fstart && off < fend {
            var w: i64 = g.lrows.get(r + 2);
            var ln: i64 = 0;
            if (w & 1) == 0 {
                if w == own {
                    ln = g.lrows.get(r + 1);
                    last_own = ln;
                } else {
                    ln = last_own;
                }
            } else {
                last_own = 0;
            }
            sst.push(off - fstart);
            sln.push(ln);
        }
        r = r + 3;
    }
    var ns: i64 = sst.len();
    var flen: i64 = fend - fstart;
    // Each scope's runs: start, end, scope, depth
    var rs: Vec<i64> = Vec::new();
    var re: Vec<i64> = Vec::new();
    var rsc: Vec<i64> = Vec::new();
    var rdp: Vec<i64> = Vec::new();
    var c: i64 = 0;
    while c < ni {
        if canon.get(c) == c {
            var open: i64 = 0 - 1;
            var oend: i64 = 0 - 1;
            var k2: i64 = 0;
            while k2 < ns {
                var s0: i64 = sst.get(k2);
                var e0: i64 = flen;
                if k2 + 1 < ns {
                    e0 = sst.get(k2 + 1);
                }
                if e0 > s0 {
                    var inside: bool = sln.get(k2) >= ilo.get(c) && sln.get(k2) <= ihi.get(c);
                    if inside {
                        if open < 0 {
                            open = s0;
                        }
                        oend = e0;
                    } else if open >= 0 {
                        rs.push(open);
                        re.push(oend);
                        rsc.push(c);
                        rdp.push(depth.get(c));
                        open = 0 - 1;
                    }
                }
                k2 = k2 + 1;
            }
            if open >= 0 {
                rs.push(open);
                re.push(oend);
                rsc.push(c);
                rdp.push(depth.get(c));
            }
        }
        c = c + 1;
    }
    // Pre-order: by start, the outer first; parents from a stack
    var nr: i64 = rs.len();
    var rid: Vec<i64> = Vec::new();
    i = 0;
    while i < nr {
        rid.push(0);
        i = i + 1;
    }
    var ord2: Vec<i64> = ng_dbg_sort3(&rs, &rdp, &re);
    var st2: Vec<i64> = Vec::new();
    var blines: Vec<str> = Vec::new();
    var nid: i64 = 0;
    var k3: i64 = 0;
    while k3 < ord2.len() {
        var x: i64 = ord2.get(k3);
        while st2.len() > 0 && re.get(st2.get(st2.len() - 1)) <= rs.get(x) {
            st2.pop();
        }
        var parent: i64 = 0;
        if st2.len() > 0 {
            var top: i64 = st2.get(st2.len() - 1);
            if re.get(x) > re.get(top) {
                re.set(x, re.get(top));
            }
            parent = rid.get(top);
        }
        if re.get(x) > rs.get(x) {
            nid = nid + 1;
            rid.set(x, nid);
            st2.push(x);
            blines.push("B\t" + int_to_str(nid) + "\t" + int_to_str(parent) + "\t" + int_to_str(rs.get(x)) + "\t" + int_to_str(re.get(x)));
        }
        k3 = k3 + 1;
    }
    // The variables: of the whole function, then the blocks, then each
    // scoped one in each of its scope's runs
    var top_lines: Vec<str> = Vec::new();
    var scoped: Vec<str> = Vec::new();
    i = 0;
    while i < n {
        var placed: bool = false;
        if vint.get(i) >= 0 {
            var sc: i64 = canon.get(vint.get(i));
            var q: i64 = 0;
            while q < nr {
                if rsc.get(q) == sc && rid.get(q) > 0 {
                    scoped.push(plain.get(i) + "\t" + int_to_str(rid.get(q)));
                    placed = true;
                }
                q = q + 1;
            }
        }
        if !placed {
            top_lines.push(plain.get(i));
        }
        i = i + 1;
    }
    var k4: i64 = 0;
    while k4 < blines.len() {
        top_lines.push(blines.get(k4));
        k4 = k4 + 1;
    }
    k4 = 0;
    while k4 < scoped.len() {
        top_lines.push(scoped.get(k4));
        k4 = k4 + 1;
    }
    return str_join(top_lines, "\n");
}

/// DB4: ng_dbg_scope_blocks for a unit test (tests/nattools/
/// dbg_scopes_unit.fd): function `name` at [fstart, fend) of a code
/// buffer whose line rows are `lrows` (g.lrows' [offset, line, file word];
/// word 0 the function's own file, 2k another file, odd a close row), its
/// resolved variables `lines`.
pub fn nat_dbg_scope_unit(name: str, fstart: i64, fend: i64, lrows: Vec<i64>, lines: Vec<str>) -> str {
    var g: NatGen = NatGen_new(NAT_A64);
    g.lrows = lrows;
    nat_line_fn_set(name, 0);
    return ng_dbg_scope_blocks(&g, name, fstart, fend, &lines);
}

/// DB4: the position-to-code table of the direct path (FID_NAT_OFF=mir):
/// where the code of each of ng_regalloc's positions after 0 starts (one
/// per instruction, then one per block's end), recorded while a function
/// with line rows is emitted (ng_dbg_dpos_mark); read by
/// ng_dbg_vars_direct.
pub var g_ng_dbg_dpos: Vec<i64> = Vec::new();

/// DB4: the next position of the direct path starts here.
fn ng_dbg_dpos_mark(g: &NatGen) {
    g_ng_dbg_dpos.push(g.e.code.len());
}

/// DB4: the parameters and variables of a function the direct path
/// (FID_NAT_OFF=mir: no machine IR, one frame slot per value and
/// ng_regalloc's callee-saved registers) just emitted, with frame `frame`
/// (sp = CFA - 16 - frame, as on the machine IR). As there: an alloca
/// that something writes is at its data (sp + g.alloca_data); a value is
/// in its register (g.vreg) where it is held, else in its slot. A register
/// is the value's over ng_regalloc's whole range for it, which holds every
/// position that defines or reads it: the location list covers the code
/// from just after its first definition or read to the end of its last
/// read (narrower than the range: never another value's register). The
/// scopes as ng_dbg_scope_blocks makes them.
fn ng_dbg_vars_direct(g: &mut NatGen, name: str, func: &IrFunction, module: &IrModule, frame: i64) {
    // the machine IR's promotion does not apply here
    g.promoted = Vec::new();
    ng_dbg_vars_note(g, name, func, module);
    if g_ng_dbg_pend == 0 || !HashMap_contains(g_ng_dbg_pend, name) {
        return;
    }
    var fstart: i64 = ng_dbg_fn_start(g, name);
    var fend: i64 = g.e.code.len();
    if fstart < 0 {
        return;
    }
    // first and last position (ng_regalloc's numbering) that defines or
    // reads each value
    var nv: i64 = g.vreg.len();
    var tlo: Vec<i64> = Vec::new();
    var thi: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        tlo.push(0 - 1);
        thi.push(0 - 1);
        i = i + 1;
    }
    i = 0;
    while i < func.params.len() {
        ng_touch(&mut tlo, &mut thi, func.params.get(i).id, 0);
        i = i + 1;
    }
    var ops: Vec<i64> = Vec::new();
    var pos: i64 = 1;
    var bi: i64 = 0;
    while bi < func.blocks.len() {
        var block: BasicBlock = func.blocks.get(bi);
        var ii: i64 = 0;
        while ii < block.instructions.len() {
            var iid: i64 = block.instructions.get(ii);
            match IrFunction_get_inst(func, iid) {
                OptInst::Some(inst) => {
                    ops.clear();
                    ng_inst_operands(inst, &mut ops);
                    var k: i64 = 0;
                    while k < ops.len() {
                        ng_touch(&mut tlo, &mut thi, ops.get(k), pos);
                        k = k + 1;
                    }
                }
                OptInst::None => {
                }
            }
            ng_touch(&mut tlo, &mut thi, iid, pos);
            pos = pos + 1;
            ii = ii + 1;
        }
        pos = pos + 1;
        bi = bi + 1;
    }
    var pend: str = HashMap_get(g_ng_dbg_pend, name);
    var lines: Vec<str> = str_split(pend, "\n");
    var out: Vec<str> = Vec::new();
    var li: i64 = 0;
    while li < lines.len() {
        var p: Vec<str> = str_split(lines.get(li), "\t");
        if p.len() >= 6 {
            var loc: str = p.get(5);
            var res: str = "";
            if str_len(loc) >= 2 {
                var v: i64 = str_parse_int(str_slice(loc, 1, str_len(loc)));
                if str_byte_at(loc, 0) == 77 {
                    // 'M': the alloca's data at sp + v
                    res = "f" + int_to_str(v - frame - 16);
                } else if v >= 0 && v < nv && g.vreg.get(v) >= 0 {
                    var dr: i64 = ng_dbg_reg(g, g.vreg.get(v), p.get(3), p.get(4));
                    var a: i64 = tlo.get(v);
                    var b: i64 = thi.get(v);
                    if dr >= 0 && a >= 0 && b + 1 <= g_ng_dbg_dpos.len() + 1 {
                        var s: i64 = fend;
                        if a < g_ng_dbg_dpos.len() {
                            s = g_ng_dbg_dpos.get(a);
                        }
                        var e: i64 = fend;
                        if b < g_ng_dbg_dpos.len() {
                            e = g_ng_dbg_dpos.get(b);
                        }
                        if e > s && s >= fstart {
                            res = "r" + int_to_str(dr) + "@" + int_to_str(s - fstart) + ":" + int_to_str(e - fstart);
                        }
                    }
                } else if v >= 0 && v < g.slots.len() && g.slots.get(v) >= 0 {
                    res = "f" + int_to_str(g.slots.get(v) - frame - 16);
                }
            }
            var sc: str = "";
            if p.len() >= 7 {
                sc = "\t" + p.get(6);
            }
            out.push(p.get(0) + "\t" + p.get(1) + "\t" + p.get(2) + "\t" + p.get(3) + "\t" + p.get(4) + "\t" + res + sc);
        }
        li = li + 1;
    }
    if g_ng_dbg_vars == 0 {
        g_ng_dbg_vars = HashMap_new();
    }
    HashMap_insert(g_ng_dbg_vars, name, ng_dbg_scope_blocks(g, name, fstart, fend, &out));
}

/// DB4: per function (by name) whose values RA4 split (ng_mir_alloc_split
/// keeps a split), NgSplit.orig joined by ",": for each vreg - NG_VBASE,
/// the vreg it is a piece of (-1: not a piece); "" none. 0: none yet.
pub var g_ng_dbg_split: i64 = 0;

/// DB4: RA4 kept a split of function `name` with pieces `orig`
/// (NgSplit.orig), for ng_dbg_vars_resolve; only for a function with
/// variables (g_ng_dbg_pend).
pub fn ng_dbg_split_note(name: str, orig: &Vec<i64>) {
    if g_ng_dbg_pend == 0 || !HashMap_contains(g_ng_dbg_pend, name) {
        return;
    }
    var parts: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < orig.len() {
        parts.push(int_to_str(orig.get(i)));
        i = i + 1;
    }
    if g_ng_dbg_split == 0 {
        g_ng_dbg_split = HashMap_new();
    }
    HashMap_insert(g_ng_dbg_split, name, str_join(parts, ","));
}

/// DB4: the pieces ng_dbg_split_note recorded for `name` (empty: none).
fn ng_dbg_split_orig(name: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if g_ng_dbg_split == 0 || !HashMap_contains(g_ng_dbg_split, name) {
        return out;
    }
    var s: str = HashMap_get(g_ng_dbg_split, name);
    if str_len(s) == 0 {
        return out;
    }
    var parts: Vec<str> = str_split(s, ",");
    var i: i64 = 0;
    while i < parts.len() {
        out.push(str_parse_int(parts.get(i)));
        i = i + 1;
    }
    return out;
}

/// DB4: value index `v` (vreg - NG_VBASE) has pieces in `orig`.
fn ng_dbg_has_pieces(orig: &Vec<i64>, v: i64) -> bool {
    var i: i64 = 0;
    while i < orig.len() {
        if orig.get(i) == NG_VBASE + v {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// DB4: the location of a value RA4 split (on line `li` of `nlines`):
/// once its pieces take it over (a loop's piece is loaded at the
/// preheader and stored back at the exits), its slot `slot` holds it only
/// where the value itself is live (`rv`, ng_dbg_live_ranges), and each
/// piece (pc_line / pc_v, its ranges after the lines' in `ranges`) holds it
/// where the piece is live, in its register or its own slot. The places
/// are joined by ";" (nat_enc.fd nat_dbg_put_var makes one location list
/// of them); "" when none is live anywhere.
fn ng_dbg_split_loc(g: &NatGen, al: &NatAlloc, slot: str, rv: str, li: i64, nlines: i64, pc_line: &Vec<i64>, pc_v: &Vec<i64>, ranges: &Vec<str>, size: str, enc: str) -> str {
    var parts: Vec<str> = Vec::new();
    if str_len(rv) > 0 {
        parts.push(slot + "@" + rv);
    }
    var k: i64 = 0;
    while k < pc_v.len() {
        if pc_line.get(k) == li && nlines + k < ranges.len() {
            var pr: str = ranges.get(nlines + k);
            var pv: i64 = pc_v.get(k);
            if str_len(pr) > 0 && pr != "*" && pv >= 0 && pv < al.assign.len() {
                var a: i64 = al.assign.get(pv);
                var prk: i64 = 0;
                if pv < al.remat.len() {
                    prk = al.remat.get(pv);
                }
                if a >= 0 {
                    var dr: i64 = ng_dbg_reg(g, a, size, enc);
                    if dr >= 0 {
                        parts.push("r" + int_to_str(dr) + "@" + pr);
                    }
                } else if a == 0 - 1 && prk == 0 && g.leaf == 0 && pv < al.spill.len() {
                    if al.spill.get(pv) >= 0 {
                        parts.push("f" + int_to_str(al.spill.get(pv) - g.frame - 16) + "@" + pr);
                    }
                }
            }
        }
        k = k + 1;
    }
    return str_join(parts, ";");
}

/// DB4: the locations of `rec`'s variables once it is allocated and
/// emitted (g.frame, g.leaf are its own): memory and spill slots become
/// CFA offsets (sp = CFA - 16 - frame on all three targets, ng_cfi_saves),
/// a vreg in a register its DWARF number, a rematerialized constant its
/// value. A slot holds its value for the whole function (a spilled vreg
/// has a slot of its own, ng_mir_alloc); a register only where the value
/// is live (CT6: another value takes the register elsewhere), so a value
/// in a register gets the code ranges where it is (ng_dbg_live_ranges),
/// written "r<n>@<start>:<end>,..." (offsets from the function's start)
/// for nat_enc.fd's location lists; never live there: optimized out.
/// DB4: a value RA4 split into pieces is not in its slot while a piece
/// holds a newer value, so it gets its slot where it is live and each
/// piece's place where that is (ng_dbg_split_loc). Then the scopes
/// (ng_dbg_scope_blocks).
fn ng_dbg_vars_resolve(g: &NatGen, rec: &NatFnRec, al: &NatAlloc) {
    if g_ng_dbg_pend == 0 || !HashMap_contains(g_ng_dbg_pend, rec.name) {
        return;
    }
    var pend: str = HashMap_get(g_ng_dbg_pend, rec.name);
    var lines: Vec<str> = str_split(pend, "\n");
    // DB4: the pieces RA4's live-range splitting made of this function's
    // values (ng_dbg_split_note; empty: not split)
    var sorig: Vec<i64> = ng_dbg_split_orig(rec.name);
    // CT6: the vregs held in registers, and where each is live; DB4: a
    // split value held in its slot too (where it is live), and after the
    // lines each of its pieces (pc_line: the line, pc_v: the piece)
    var regvis: Vec<i64> = Vec::new();
    var pc_line: Vec<i64> = Vec::new();
    var pc_v: Vec<i64> = Vec::new();
    var li0: i64 = 0;
    while li0 < lines.len() {
        var p0: Vec<str> = str_split(lines.get(li0), "\t");
        if p0.len() >= 6 && str_len(p0.get(5)) >= 2 && str_byte_at(p0.get(5), 0) == 82 {
            var v0: i64 = str_parse_int(str_slice(p0.get(5), 1, str_len(p0.get(5))));
            if v0 >= 0 && v0 < al.assign.len() && al.assign.get(v0) >= 0 {
                regvis.push(v0);
            } else if v0 >= 0 && v0 < al.assign.len() && al.assign.get(v0) == 0 - 1 && ng_dbg_has_pieces(&sorig, v0) {
                regvis.push(v0);
                var pj: i64 = 0;
                while pj < sorig.len() && pj < al.assign.len() {
                    if sorig.get(pj) == NG_VBASE + v0 {
                        pc_line.push(li0);
                        pc_v.push(pj);
                    }
                    pj = pj + 1;
                }
            } else {
                regvis.push(0 - 1);
            }
        } else {
            regvis.push(0 - 1);
        }
        li0 = li0 + 1;
    }
    var pk0: i64 = 0;
    while pk0 < pc_v.len() {
        regvis.push(pc_v.get(pk0));
        pk0 = pk0 + 1;
    }
    var ranges: Vec<str> = ng_dbg_live_ranges(g, rec, &regvis);
    var out: Vec<str> = Vec::new();
    var li: i64 = 0;
    while li < lines.len() {
        var p: Vec<str> = str_split(lines.get(li), "\t");
        if p.len() >= 6 {
            var loc: str = p.get(5);
            var res: str = "";
            if str_len(loc) >= 2 {
                var v: i64 = str_parse_int(str_slice(loc, 1, str_len(loc)));
                if str_byte_at(loc, 0) == 77 {
                    // 'M': the alloca's data at sp + v
                    if g.leaf == 0 {
                        res = "f" + int_to_str(v - g.frame - 16);
                    }
                } else if v >= 0 && v < al.assign.len() {
                    var a: i64 = al.assign.get(v);
                    if a >= 0 {
                        var dr: i64 = ng_dbg_reg(g, a, p.get(3), p.get(4));
                        var rr: str = "*";
                        if li < ranges.len() {
                            rr = ranges.get(li);
                        }
                        if dr >= 0 && rr == "*" {
                            res = "r" + int_to_str(dr);
                        } else if dr >= 0 && str_len(rr) > 0 {
                            res = "r" + int_to_str(dr) + "@" + rr;
                        }
                    } else if a == 0 - 1 {
                        var rk: i64 = 0;
                        if v < al.remat.len() {
                            rk = al.remat.get(v);
                        }
                        if rk == NG_REMAT_LI && v < al.remat_val.len() {
                            res = "c" + int_to_str(al.remat_val.get(v));
                        } else if rk == 0 && g.leaf == 0 && v < al.spill.len() && al.spill.get(v) >= 0 {
                            res = "f" + int_to_str(al.spill.get(v) - g.frame - 16);
                            var rv: str = "*";
                            if li < ranges.len() {
                                rv = ranges.get(li);
                            }
                            if ng_dbg_has_pieces(&sorig, v) && rv != "*" {
                                res = ng_dbg_split_loc(g, al, res, rv, li, lines.len(), &pc_line, &pc_v, &ranges, p.get(3), p.get(4));
                            }
                        }
                    }
                }
            }
            var sc: str = "";
            if p.len() >= 7 {
                // DB4: its source lines (ng_dbg_scope_lines)
                sc = "\t" + p.get(6);
            }
            out.push(p.get(0) + "\t" + p.get(1) + "\t" + p.get(2) + "\t" + p.get(3) + "\t" + p.get(4) + "\t" + res + sc);
        }
        li = li + 1;
    }
    if g_ng_dbg_vars == 0 {
        g_ng_dbg_vars = HashMap_new();
    }
    // DB4: the lexical scopes of names bound twice, from the line rows
    // its emission just made
    var dfs: i64 = ng_dbg_fn_start(g, rec.name);
    HashMap_insert(g_ng_dbg_vars, rec.name, ng_dbg_scope_blocks(g, rec.name, dfs, g.e.code.len(), &out));
    // CE8: the size of its code (emitted just now), so the frame table
    // (ng_dbg_frames_data) does not take a stub after it for it
    if ng_dbg_frames_on() && HashMap_contains(g.fn_labels, rec.name) {
        var at: i64 = NatEnc_label_offset(&g.e, HashMap_get(g.fn_labels, rec.name));
        if at >= 0 && at <= g.e.code.len() {
            if g_ng_dbg_size == 0 {
                g_ng_dbg_size = HashMap_new();
            }
            HashMap_insert(g_ng_dbg_size, rec.name, g.e.code.len() - at);
        }
    }
}

// CT6: the code offset where each machine instruction of the function
// being emitted starts (-1: emitted with the one before it, or not at
// all) is NatGen.dbg_mpos, set by ng_dbg_mark from ng_mir_emit_pass for a
// function with variables (NatGen.dbg_mark_on); read by
// ng_dbg_live_ranges. (SP5: in the generator, so each worker of the
// parallel emission has its own; ng_par_join carries a worker's over.)

/// DB4: the DWARF register of a variable held in machine register r: a
/// general register as ng_dwarf_reg numbers it; an 8-byte float in a float
/// register (MI25) as DWARF numbers that file (x86-64 xmm0.. 17.., AArch64
/// v0.. 64.., RISC-V f0.. 32..); anything else held there (an f32, bits
/// of another type) has no location (-1).
fn ng_dbg_reg(g: &NatGen, r: i64, size: str, enc: str) -> i64 {
    if ng_is_freg(g, r) {
        if enc != "4" || size != "8" {
            return 0 - 1;
        }
        var f: i64 = r - NG_FREG;
        if ng_x64(g) {
            return 17 + f;
        }
        if g.arch == NAT_A64 {
            return 64 + f;
        }
        return 32 + f;
    }
    return ng_dwarf_reg(g, r);
}

/// CT6: instruction k of `rec` starts at the current position. Each
/// emission pass starts again from k = 0 (the last pass, ng_mir_emit's
/// relaxation, wins).
fn ng_dbg_mark(g: &mut NatGen, rec: &NatFnRec, k: i64) {
    if k == 0 {
        g.dbg_mark_on = g_ng_dbg_pend != 0 && HashMap_contains(g_ng_dbg_pend, rec.name);
        var fresh: Vec<i64> = Vec::new();
        if g.dbg_mark_on {
            var i: i64 = 0;
            while i < rec.mir.len() {
                fresh.push(0 - 1);
                i = i + 1;
            }
        }
        g.dbg_mpos = fresh;
    }
    if g.dbg_mark_on && k >= 0 && k < g.dbg_mpos.len() {
        var at: i64 = g.e.code.len();
        g.dbg_mpos.set(k, at);
    }
}

/// CT6: `rs` with the range [s, e) (offsets from the function's start)
/// added.
fn ng_dbg_range_add(rs: str, s: i64, e: i64) -> str {
    if s < 0 || e <= s {
        return rs;
    }
    var r: str = int_to_str(s) + ":" + int_to_str(e);
    if str_len(rs) == 0 {
        return r;
    }
    return rs + "," + r;
}

/// CT6: for each vreg index of `vis` (vreg - NG_VBASE; -1: not one), the
/// code ranges where it is live, "<start>:<end>,..." as offsets from the
/// function's start: "" never live (optimized out), "*" the whole function
/// (no positions recorded, or `FID_NAT_OFF=dbgranges`). Liveness is per
/// machine instruction (mi_liveness at block edges, a backward scan inside
/// each block): a value is in its register through an instruction's code
/// when it is live before and after it (a definition that keeps it live
/// changes it from one value of the variable to the next), and at the
/// instruction's first byte when live before it only (its last use may
/// take the register for its result).
fn ng_dbg_live_ranges(g: &NatGen, rec: &NatFnRec, vis: &Vec<i64>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var n: i64 = rec.mir.len();
    var nt: i64 = vis.len();
    var any: bool = false;
    var t: i64 = 0;
    while t < nt {
        if vis.get(t) >= 0 {
            any = true;
        }
        out.push("*");
        t = t + 1;
    }
    if !any || n == 0 || g.dbg_mpos.len() != n || !ng_on("dbgranges") {
        return out;
    }
    var nv: i64 = rec.nvreg - NG_VBASE;
    var sel: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        sel.push(0 - 1);
        i = i + 1;
    }
    var bitof: Vec<i64> = Vec::new();
    var nbits: i64 = 0;
    t = 0;
    while t < nt {
        var vi: i64 = vis.get(t);
        var bt: i64 = 0 - 1;
        if vi >= 0 && vi < nv {
            if sel.get(vi) < 0 {
                sel.set(vi, nbits);
                nbits = nbits + 1;
            }
            bt = sel.get(vi);
        }
        bitof.push(bt);
        t = t + 1;
    }
    if nbits == 0 {
        return out;
    }
    var words: i64 = (nbits + 63) / 64;
    var mir: Vec<MInst> = rec.mir;
    var mb: MBlocks = mi_blocks(&mir);
    var nb: i64 = mb.start.len();
    var lin: Vec<i64> = Vec::new();
    var lout: Vec<i64> = Vec::new();
    mi_liveness(&mir, &mb, &sel, words, &mut lin, &mut lout);
    // live before (bef) and after (aft) each instruction
    var bef: Vec<i64> = Vec::new();
    var aft: Vec<i64> = Vec::new();
    i = 0;
    while i < n * words {
        bef.push(0);
        aft.push(0);
        i = i + 1;
    }
    var cur: Vec<i64> = Vec::new();
    i = 0;
    while i < words {
        cur.push(0);
        i = i + 1;
    }
    var b: i64 = 0;
    while b < nb {
        var w: i64 = 0;
        while w < words {
            cur.set(w, lout.get(b * words + w));
            w = w + 1;
        }
        var k: i64 = mb.end.get(b);
        while k >= mb.start.get(b) {
            w = 0;
            while w < words {
                aft.set(k * words + w, cur.get(w));
                w = w + 1;
            }
            var m: MInst = mir.get(k);
            if mi_defines(m.op) && m.r0 >= NG_VBASE && m.r0 - NG_VBASE < nv && sel.get(m.r0 - NG_VBASE) >= 0 {
                var db: i64 = sel.get(m.r0 - NG_VBASE);
                cur.set(db / 64, cur.get(db / 64) & ~(1 << (db % 64)));
            }
            var um: i64 = mi_use_mask(m.op);
            var f: i64 = 0;
            while f < 3 {
                if (um & (1 << f)) != 0 {
                    var u: i64 = mi_field(m, f);
                    if u >= NG_VBASE && u - NG_VBASE < nv && sel.get(u - NG_VBASE) >= 0 {
                        var ub: i64 = sel.get(u - NG_VBASE);
                        cur.set(ub / 64, cur.get(ub / 64) | (1 << (ub % 64)));
                    }
                }
                f = f + 1;
            }
            w = 0;
            while w < words {
                bef.set(k * words + w, cur.get(w));
                w = w + 1;
            }
            k = k - 1;
        }
        b = b + 1;
    }
    // The function's start (its label) and end; the groups of
    // instructions emitted together (the first has a position)
    var fstart: i64 = g.dbg_mpos.get(0);
    if HashMap_contains(g.fn_labels, rec.name) {
        var flo: i64 = NatEnc_label_offset(&g.e, HashMap_get(g.fn_labels, rec.name));
        if flo >= 0 {
            fstart = flo;
        }
    }
    var fend: i64 = g.e.code.len();
    // A group starts at the first instruction of each position: the ones
    // that emit nothing (a label, a line, a move the allocator made a
    // no-op) leave the registers as they were, so what is live before
    // the first of them is in place at that address
    var gs: Vec<i64> = Vec::new();
    var gpos: i64 = 0 - 1;
    i = 0;
    while i < n {
        if g.dbg_mpos.get(i) >= 0 && g.dbg_mpos.get(i) != gpos {
            gs.push(i);
            gpos = g.dbg_mpos.get(i);
        }
        i = i + 1;
    }
    if gs.len() == 0 || fstart < 0 {
        return out;
    }
    t = 0;
    while t < nt {
        var bt2: i64 = bitof.get(t);
        if bt2 >= 0 {
            var wi: i64 = bt2 / 64;
            var mask: i64 = 1 << (bt2 % 64);
            var rs: str = "";
            var os: i64 = 0 - 1;
            var oe: i64 = 0 - 1;
            var gi: i64 = 0;
            while gi < gs.len() {
                var k0: i64 = gs.get(gi);
                var k1: i64 = n;
                var e: i64 = fend;
                if gi + 1 < gs.len() {
                    k1 = gs.get(gi + 1);
                    e = g.dbg_mpos.get(k1);
                }
                var s: i64 = g.dbg_mpos.get(k0);
                if e > s {
                    var at_start: bool = (bef.get(k0 * words + wi) & mask) != 0;
                    var through: bool = at_start;
                    var kk: i64 = k0;
                    while kk < k1 && through {
                        if (aft.get(kk * words + wi) & mask) == 0 {
                            through = false;
                        }
                        kk = kk + 1;
                    }
                    var re: i64 = 0 - 1;
                    if through {
                        re = e;
                    } else if at_start {
                        re = s + 1;
                    }
                    if re > s {
                        if os >= 0 && oe == s {
                            oe = re;
                        } else {
                            if os >= 0 {
                                rs = ng_dbg_range_add(rs, os - fstart, oe - fstart);
                            }
                            os = s;
                            oe = re;
                        }
                    }
                }
                gi = gi + 1;
            }
            if os >= 0 {
                rs = ng_dbg_range_add(rs, os - fstart, oe - fstart);
            }
            out.set(t, rs);
        }
        t = t + 1;
    }
    return out;
}

// --- CE8: the failing frame's values (`fid emit -g`) -----------------------

/// CE8: `-g` on the machine layer (main.fd sets it; FID_NAT_FRAMES=1 does
/// the same): a panic prints the source variables of the failing frame
/// before the trace (stdlib/linux_runtime/base.fd pe_dbg_frame_print), as
/// `fid ccompile -g` does (codegen_c.fd cg_dbg_prologue). The functions
/// with debug rows keep those variables in frame slots (ng_mir_alloc,
/// ng_dbg_frame_vregs) and the image gets a table of where they are
/// (ng_dbg_frames_data). Linux, macOS and `--nat` Windows (whose input-file
/// functions get their variables noted for this alone: it has no line
/// rows). The default Windows backend (pe_ir) does not do this yet.
pub var g_nat_dbg_frames: bool = false;
/// CE8: per function (by name) the size of its code, set when its
/// variables' locations are resolved (ng_dbg_vars_resolve). 0: none yet.
pub var g_ng_dbg_size: i64 = 0;
/// The word after the function table's [end of code, 0] that says a frame
/// table follows (base.fd PE_DBG_FRAMES_MAGIC).
const NG_DBG_FRAMES_MAGIC: i64 = 0x464944464D455331;

fn ng_dbg_frames_on() -> bool {
    if g_nat_dbg_frames {
        return true;
    }
    if g_ng_env_ok {
        return g_ng_env_frames;
    }
    var v: str = p_getenv("FID_NAT_FRAMES");
    if (v as i64) == 0 {
        return false;
    }
    return str_len(v) > 0 && v != "0";
}

// --- CT6: DWARF in `--nat` Windows images ----------------------------------

/// CT6: a `--nat` Windows image carries DWARF as COFF sections (line rows,
/// functions, their variables with location lists, frames: nat_enc.fd
/// nat_pe_debug), which gdb and lldb read, in a debug build only: main.fd
/// sets this for `fid emit --nat --debug` / `-g`; FID_NAT_DWARF=1,
/// FID_PE_DEBUG (pe_ir's switch for the same) and -g's frame table
/// (ng_dbg_frames_on) do the same. Other `--nat` builds keep COFF symbols
/// only (DB10), byte for byte as before. Linux and macOS images do not
/// depend on it.
pub var g_nat_win_dwarf: bool = false;

fn ng_dbg_win_dwarf() -> bool {
    if g_nat_win_dwarf || ng_dbg_frames_on() {
        return true;
    }
    var v: str = env_or_empty("FID_NAT_DWARF");
    if str_len(v) > 0 && v != "0" {
        return true;
    }
    return str_len(env_or_empty("FID_PE_DEBUG")) > 0;
}

/// CT6: functions of target `g` get line rows (with FID_NAT_OFF=debug
/// still off): every target but Windows, and Windows when its image gets
/// DWARF (ng_dbg_win_dwarf).
fn ng_dbg_lines_ok(g: &NatGen) -> bool {
    return !g.win || ng_dbg_win_dwarf();
}

/// CE8: marks (1) by coalescing representative the vregs of `name`'s
/// source variables that selection left in values (g_ng_dbg_pend's
/// "R<id>"); empty when the frame table is off or `name` has none.
fn ng_dbg_frame_vregs(name: str, nv: i64, crep: &mut Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if g_ng_dbg_pend == 0 || !HashMap_contains(g_ng_dbg_pend, name) || !ng_dbg_frames_on() {
        return out;
    }
    var i: i64 = 0;
    while i < nv {
        out.push(0);
        i = i + 1;
    }
    var pend: str = HashMap_get(g_ng_dbg_pend, name);
    var lines: Vec<str> = str_split(pend, "\n");
    var li: i64 = 0;
    while li < lines.len() {
        var p: Vec<str> = str_split(lines.get(li), "\t");
        if p.len() >= 6 && str_len(p.get(5)) >= 2 && str_byte_at(p.get(5), 0) == 82 {
            var v: i64 = str_parse_int(str_slice(p.get(5), 1, str_len(p.get(5))));
            if v >= 0 && v < nv {
                out.set(ng_find(crep, v), 1);
            }
        }
        li = li + 1;
    }
    return out;
}

/// CE8: how the runtime reads a variable of g_ng_dbg_vars' type name, size
/// and encoding: the C backend's letter (codegen_c.fd cg_dbg_kind: i u 4 U
/// 2 w 1 c integers, b bool, d f64, f f32, s str); 0 for anything else (a
/// struct, a pointer, a handle of another type).
fn ng_dbg_frame_kind(tname: str, size: str, enc: str) -> i64 {
    if enc == "Z" {
        return 115;
    }
    if enc == "2" {
        return 98;
    }
    if enc == "4" {
        if size == "8" {
            return 100;
        }
        if size == "4" {
            return 102;
        }
        return 0;
    }
    if enc == "5" {
        if size == "8" {
            return 105;
        }
        if size == "4" {
            return 52;
        }
        if size == "2" {
            return 50;
        }
        if size == "1" {
            return 49;
        }
        return 0;
    }
    if enc == "7" {
        if tname == "u64" {
            return 117;
        }
        if tname == "u32" {
            return 85;
        }
        if tname == "u16" {
            return 119;
        }
        if tname == "u8" {
            return 99;
        }
    }
    return 0;
}

/// CE8 (`-g`): the frame table, right after the function table's [end of
/// code, 0]: [NG_DBG_FRAMES_MAGIC, frames], frames one word per function
/// of that table (placement order): 0, or the address of its record
/// [code size, n, then n entries of [name, kind, place, value]] (kind:
/// ng_dbg_frame_kind; place 1: memory at CFA + value, 2: the constant
/// value). Only variables with one place for the whole function (a slot or
/// a constant; ng_dbg_frame_vregs put them there). A name bound twice keeps
/// its first position and its last binding, as the C backend's record; at
/// most 32 per function.
fn ng_dbg_frames_data(g: &mut NatGen) {
    NatEnc_quad(&mut g.e, NG_DBG_FRAMES_MAGIC);
    var tab: i64 = NatEnc_label(&mut g.e);
    NatEnc_fix(&mut g.e, tab, NATFIX_ABS64);
    NatEnc_quad(&mut g.e, 0);
    NatEnc_place(&mut g.e, tab);
    var labs: Vec<i64> = Vec::new();
    var ni: i64 = 0;
    while ni < g.placed_fns.len() {
        var pname: str = g.placed_fns.get(ni);
        var lab: i64 = 0 - 1;
        if g_ng_dbg_vars != 0 && g_ng_dbg_size != 0 && HashMap_contains(g_ng_dbg_vars, pname) && HashMap_contains(g_ng_dbg_size, pname) {
            lab = NatEnc_label(&mut g.e);
            NatEnc_fix(&mut g.e, lab, NATFIX_ABS64);
        }
        NatEnc_quad(&mut g.e, 0);
        labs.push(lab);
        ni = ni + 1;
    }
    ni = 0;
    while ni < labs.len() {
        if labs.get(ni) >= 0 {
            var rname: str = g.placed_fns.get(ni);
            var rvars: str = HashMap_get(g_ng_dbg_vars, rname);
            var rsize: i64 = HashMap_get(g_ng_dbg_size, rname);
            ng_dbg_frame_record(g, labs.get(ni), rsize, rvars);
        }
        ni = ni + 1;
    }
}

/// CE8: one function's record of the frame table (ng_dbg_frames_data) at
/// label `lab`, from its resolved variables `vars` (g_ng_dbg_vars).
fn ng_dbg_frame_record(g: &mut NatGen, lab: i64, size: i64, vars: str) {
    var names: Vec<str> = Vec::new();
    var kinds: Vec<i64> = Vec::new();
    var places: Vec<i64> = Vec::new();
    var vals: Vec<i64> = Vec::new();
    var seen: i64 = HashMap_new();
    var lines: Vec<str> = str_split(vars, "\n");
    var li: i64 = 0;
    while li < lines.len() {
        var p: Vec<str> = str_split(lines.get(li), "\t");
        li = li + 1;
        if p.len() < 6 {
            continue;
        }
        var kind: i64 = ng_dbg_frame_kind(p.get(2), p.get(3), p.get(4));
        var loc: str = p.get(5);
        var place: i64 = 0;
        var lval: i64 = 0;
        if kind != 0 && str_len(loc) >= 2 && !str_contains(loc, "@") {
            var c0: i64 = str_byte_at(loc, 0);
            if c0 == 102 {
                // 'f': memory at CFA + offset
                place = 1;
                lval = str_parse_int(str_slice(loc, 1, str_len(loc)));
            } else if c0 == 99 {
                // 'c': a rematerialized constant
                place = 2;
                lval = str_parse_int(str_slice(loc, 1, str_len(loc)));
            }
        }
        if place == 0 {
            continue;
        }
        var nm: str = p.get(1);
        if HashMap_contains(seen, nm) {
            var at: i64 = HashMap_get(seen, nm) - 1;
            kinds.set(at, kind);
            places.set(at, place);
            vals.set(at, lval);
        } else if names.len() < 32 {
            names.push(nm);
            kinds.push(kind);
            places.push(place);
            vals.push(lval);
            HashMap_insert(seen, nm, names.len());
        }
    }
    HashMap_drop(seen);
    NatEnc_align(&mut g.e, 8);
    NatEnc_place(&mut g.e, lab);
    NatEnc_quad(&mut g.e, size);
    NatEnc_quad(&mut g.e, names.len());
    var k: i64 = 0;
    while k < names.len() {
        var sl: i64 = ng_str_label(g, names.get(k));
        NatEnc_fix(&mut g.e, sl, NATFIX_ABS64);
        NatEnc_quad(&mut g.e, 0);
        NatEnc_quad(&mut g.e, kinds.get(k));
        NatEnc_quad(&mut g.e, places.get(k));
        NatEnc_quad(&mut g.e, vals.get(k));
        k = k + 1;
    }
}

/// DB4: g_nat_dbg_vars for nat_elf_debug's `names` (empty: no function
/// has variables).
fn ng_dbg_vars_for(names: Vec<str>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if g_ng_dbg_vars == 0 {
        return out;
    }
    var any: bool = false;
    var i: i64 = 0;
    while i < names.len() {
        if HashMap_contains(g_ng_dbg_vars, names.get(i)) {
            var s: str = HashMap_get(g_ng_dbg_vars, names.get(i));
            out.push(s);
            any = true;
        } else {
            out.push("");
        }
        i = i + 1;
    }
    if !any {
        return Vec::new();
    }
    return out;
}

/// A field type's name as Fides writes it (Point, Vec<Point>, *u8), not
/// the IR's (struct.Point, generic.Vec<struct.Point>).
fn ng_dbg_type_name(t: IrType) -> str {
    var s: str = ir_type_to_str(t);
    s = str_replace(s, "struct.", "");
    s = str_replace(s, "opaque.", "");
    return str_replace(s, "generic.", "");
}

/// The DWARF encoding of a scalar field type: 5 signed, 7 unsigned,
/// 4 float, 2 boolean; 7 for anything held as a word (a handle, a
/// pointer). (CT9: 8 is DW_ATE_unsigned_char, which made a debugger
/// print a u8 as a character and a word as nonsense.)
fn ng_dbg_encoding(t: IrType) -> i64 {
    if ir_type_eq(t, IrType::Bool) {
        return 2;
    }
    if ir_type_is_float(t) {
        return 4;
    }
    if ir_type_is_signed(t) {
        return 5;
    }
    return 7;
}

/// CT9: a `str` (the IR's pointer to u8): nat_enc.fd describes it as the
/// type `str`, a pointer to characters, so a debugger prints the text.
fn ng_dbg_is_str(t: IrType) -> bool {
    match t {
        IrType::Ptr(inner) => {
            return ir_type_eq(box_ir_type_unbox(inner), IrType::U8);
        }
        _ => {
        }
    }
    return false;
}

/// CT9: the struct of the module a field of type `t` points to when it
/// is not held inline (a pointer to the struct, or the struct type of a
/// word that holds its address); "" otherwise. Used for fields only
/// (ng_dbg_type_descs decides inline first).
fn ng_dbg_held_struct(module: &IrModule, t: IrType) -> str {
    match t {
        IrType::Struct(sn) => {
            if HashMap_contains(module.struct_index, sn) {
                return sn;
            }
        }
        IrType::Ptr(inner) => {
            var it: IrType = box_ir_type_unbox(inner);
            match it {
                IrType::Struct(sn2) => {
                    if HashMap_contains(module.struct_index, sn2) {
                        return sn2;
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return "";
}

/// The module's struct types for nat_elf_debug (g_nat_dbg_types' format):
/// a field's size is the distance to the next field (to the struct's end
/// for the last); a struct field that size of a struct of the module is
/// held inline and refers to that struct's entry.
fn ng_dbg_type_descs(module: &IrModule) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < module.struct_layouts.len() {
        var lay: StructLayout = module.struct_layouts.get(i).layout;
        var d: str = module.struct_layouts.get(i).name + "\t" + int_to_str(lay.size);
        var f: i64 = 0;
        while f < lay.fields.len() {
            var fl: StringIrTypeOffset = lay.fields.get(f);
            var end: i64 = lay.size;
            if f + 1 < lay.fields.len() {
                end = lay.fields.get(f + 1).offset;
            }
            var size: i64 = end - fl.offset;
            var tname: str = ng_dbg_type_name(fl.ty);
            var enc: str = int_to_str(ng_dbg_encoding(fl.ty));
            var inline_struct: bool = false;
            match fl.ty {
                IrType::Struct(sn) => {
                    if HashMap_contains(module.struct_index, sn) {
                        var si: i64 = HashMap_get(module.struct_index, sn) - 1;
                        if si >= 0 && si < module.struct_layouts.len() && module.struct_layouts.get(si).layout.size == size && size > 0 {
                            inline_struct = true;
                        }
                    }
                }
                _ => {
                }
            }
            if inline_struct {
                enc = "S";
            } else {
                if size > 8 || size <= 0 {
                    size = 8;
                }
                var sc: i64 = ir_type_size(fl.ty);
                if sc > 0 && sc < size {
                    size = sc;
                }
                // CT9: a str field as the text type; a struct of the
                // module held by its address as a pointer to that struct
                var held: str = ng_dbg_held_struct(module, fl.ty);
                if ng_dbg_is_str(fl.ty) {
                    tname = "str";
                    enc = "Z";
                    size = 8;
                } else if str_len(held) > 0 && end - fl.offset == 8 {
                    tname = held;
                    enc = "P";
                    size = 8;
                }
            }
            d = d + "\t" + fl.name + "\t" + int_to_str(fl.offset) + "\t" + tname + "\t" + int_to_str(size) + "\t" + enc;
            f = f + 1;
        }
        out.push(d);
        i = i + 1;
    }
    return out;
}

// ===========================================================================
// Windows x64 (`--target x86_64-windows --nat`): the x86-64 code of this
// layer in a PE (nat_pe), the Linux runtime over kernel32 and ws2_32. The
// runtime's system calls go to pe_win_syscall (stdlib/linux_runtime/win.fd),
// which calls Windows through nat_win_call(k, ...): k indexes the import
// list below, in the same order as PE_W_* in win.fd.
// ===========================================================================

/// "dll|function" per import; the index is the PE_W_* constant of win.fd.
fn ng_win_imports() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    var k32: Vec<str> = Vec::new();
    k32.push("ExitProcess");
    k32.push("GetStdHandle");
    k32.push("WriteFile");
    k32.push("ReadFile");
    k32.push("CreateFileA");
    k32.push("CloseHandle");
    k32.push("SetFilePointerEx");
    k32.push("DeleteFileA");
    k32.push("RemoveDirectoryA");
    k32.push("CreateDirectoryA");
    k32.push("MoveFileExA");
    k32.push("GetFileAttributesExA");
    k32.push("FindFirstFileA");
    k32.push("FindNextFileA");
    k32.push("FindClose");
    k32.push("VirtualAlloc");
    k32.push("VirtualFree");
    k32.push("VirtualProtect");
    k32.push("GetSystemTimePreciseAsFileTime");
    k32.push("QueryPerformanceCounter");
    k32.push("QueryPerformanceFrequency");
    k32.push("Sleep");
    k32.push("SwitchToThread");
    k32.push("GetCurrentProcessId");
    k32.push("GetCurrentThreadId");
    k32.push("CreateThread");
    k32.push("ExitThread");
    k32.push("TlsAlloc");
    k32.push("AddVectoredExceptionHandler");
    k32.push("SetThreadStackGuarantee");
    k32.push("GetCommandLineA");
    k32.push("GetEnvironmentStringsA");
    k32.push("GetSystemInfo");
    k32.push("GlobalMemoryStatusEx");
    k32.push("CreateProcessA");
    k32.push("WaitForSingleObject");
    k32.push("GetExitCodeProcess");
    k32.push("GetLastError");
    k32.push("GetCurrentProcess");
    k32.push("TerminateProcess");
    k32.push("SetConsoleOutputCP");
    k32.push("GetFileType");
    k32.push("PeekNamedPipe");
    k32.push("GetFileSizeEx");
    var i: i64 = 0;
    while i < k32.len() {
        v.push("kernel32.dll|" + k32.get(i));
        i = i + 1;
    }
    v.push("api-ms-win-core-synch-l1-2-0.dll|WaitOnAddress");
    v.push("api-ms-win-core-synch-l1-2-0.dll|WakeByAddressSingle");
    v.push("api-ms-win-core-synch-l1-2-0.dll|WakeByAddressAll");
    v.push("bcrypt.dll|BCryptGenRandom");
    var ws: Vec<str> = Vec::new();
    ws.push("WSAStartup");
    ws.push("socket");
    ws.push("bind");
    ws.push("listen");
    ws.push("accept");
    ws.push("connect");
    ws.push("send");
    ws.push("recv");
    ws.push("closesocket");
    ws.push("setsockopt");
    ws.push("getsockopt");
    ws.push("ioctlsocket");
    ws.push("WSAPoll");
    ws.push("WSAGetLastError");
    ws.push("gethostbyname");
    i = 0;
    while i < ws.len() {
        v.push("ws2_32.dll|" + ws.get(i));
        i = i + 1;
    }
    // 63-68: epoll over AFD and an I/O completion port (win.fd, RT11)
    v.push("kernel32.dll|CreateIoCompletionPort");
    v.push("kernel32.dll|GetQueuedCompletionStatusEx");
    v.push("kernel32.dll|PostQueuedCompletionStatus");
    v.push("ntdll.dll|NtDeviceIoControlFile");
    v.push("ntdll.dll|NtCancelIoFileEx");
    v.push("ws2_32.dll|WSAIoctl");
    // 69-74: the sampling profiler's thread (win.fd pe_win_prof_main, DB9)
    v.push("kernel32.dll|OpenThread");
    v.push("kernel32.dll|SuspendThread");
    v.push("kernel32.dll|ResumeThread");
    v.push("kernel32.dll|GetThreadContext");
    v.push("kernel32.dll|QueryThreadCycleTime");
    v.push("ntdll.dll|NtSetTimerResolution");
    // 75-76: every address of a name, IPv6 included (win.fd pe_win_resolve_all, SL5)
    v.push("ws2_32.dll|getaddrinfo");
    v.push("ws2_32.dll|freeaddrinfo");
    // 77-78: anonymous pipes for a child's stdin/stdout (win.fd
    // PE_W_CREATE_PIPE, PE_W_SET_HANDLE_INFO)
    v.push("kernel32.dll|CreatePipe");
    v.push("kernel32.dll|SetHandleInformation");
    // 79: the working set (win.fd PE_W_MEM_INFO, pert_mem_resident, RT7)
    v.push("kernel32.dll|K32GetProcessMemoryInfo");
    // 80: a file's identity (win.fd PE_W_FILE_INFO: pe_win_stat fills st_dev
    // and st_ino, which sys.fd's pe_zc_same_file compares, RT14)
    v.push("kernel32.dll|GetFileInformationByHandle");
    return v;
}

fn ng_win_import_index(name: str) -> i64 {
    var v: Vec<str> = ng_win_imports();
    var i: i64 = 0;
    while i < v.len() {
        var e: str = v.get(i);
        if str_ends_with(e, "|" + name) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/// A call from machine code into Windows: the function in import slot
/// `name` (rcx, rdx, r8, r9 already set; rsp 16-aligned with 32 bytes of
/// shadow space below the caller's).
fn ng_win_call_import(g: &mut NatGen, name: str) {
    x64_load_label(&mut g.e, 0, g.win_slot_labels.get(ng_win_import_index(name)));
    x64_call_r(&mut g.e, 0);
}

/// A primitive that is the Fides function `target` taking (env, the
/// primitive's arguments): four arguments came in rdi, rsi, rdx, rcx and
/// `nstack` more on the stack; each moves one place up.
fn ng_win_forward(g: &mut NatGen, target: str, nstack: i64) {
    x64_push(&mut g.e, 5);
    x64_mov(&mut g.e, 5, 4);
    var out: i64 = (nstack + 1) * 8;
    if (out % 16) != 0 {
        out = out + 8;
    }
    x64_sub_imm(&mut g.e, 4, out);
    // the 4th register argument becomes the first stack one
    x64_store(&mut g.e, 1, 4, 0, 8);
    var j: i64 = 0;
    while j < nstack {
        x64_load(&mut g.e, 0, 5, 16 + 8 * j, 8, true);
        x64_store(&mut g.e, 0, 4, 8 + 8 * j, 8);
        j = j + 1;
    }
    x64_mov(&mut g.e, 1, 2);
    x64_mov(&mut g.e, 2, 6);
    x64_mov(&mut g.e, 6, 7);
    x64_li(&mut g.e, 7, 0);
    x64_call(&mut g.e, ng_fn_label(g, target));
    x64_mov(&mut g.e, 4, 5);
    x64_pop(&mut g.e, 5);
    x64_ret(&mut g.e);
}

/// The Windows-only primitives of x86-64 (what ng_gen_primitives_x64_linux
/// gives Linux).
/// Any new entry Windows calls that returns to it (a callback, a handler)
/// must save rdi, rsi and xmm6..xmm15 as the vectored exception handler
/// does: Windows keeps them across calls, while the machine layer's code
/// uses rdi/rsi (RA7/RA3 argument registers) and xmm6..xmm15 freely
/// (tests/nattools/win_callback_regs_check.sh).
fn ng_gen_primitives_win(g: &mut NatGen) {
    // The entry point (rsp = 8 mod 16): the TLS index, the Linux-style
    // start block (argc, argv, envp) from the command line and the
    // environment, the runtime's initialization, main(env 0), ExitProcess
    g.entry_label = NatEnc_label(&mut g.e);
    NatEnc_place(&mut g.e, g.entry_label);
    var main_label: i64 = ng_fn_label(g, "main");
    x64_align_sp16(&mut g.e);
    x64_sub_imm(&mut g.e, 4, 32);
    x64_li(&mut g.e, 5, 0);
    ng_win_call_import(g, "TlsAlloc");
    x64_mov32(&mut g.e, 0, 0);
    x64_store_label(&mut g.e, 0, g.win_tls_label);
    x64_li(&mut g.e, 7, 0);
    x64_call(&mut g.e, ng_fn_label(g, "pe_win_start"));
    x64_store_label(&mut g.e, 7, g.start_sp_label);
    if ng_has_fn(g, "pe_rt_init") {
        x64_li(&mut g.e, 7, 0);
        x64_call(&mut g.e, ng_fn_label(g, "pe_rt_init"));
    }
    x64_li(&mut g.e, 7, 0);
    x64_call(&mut g.e, main_label);
    // DB9: pe_rt_exit(its result) as on Linux (the profile's report from
    // win.fd's sampler thread, --leaks), which exits through ExitProcess
    if ng_has_fn(g, "pe_rt_exit") {
        x64_mov(&mut g.e, 6, 7);
        x64_li(&mut g.e, 7, 0);
        x64_call(&mut g.e, ng_fn_label(g, "pe_rt_exit"));
    }
    // RL16: --leaks reports before the process ends (main's result kept
    // in rbx, which the call preserves)
    if g_nat_leaks && ng_has_fn(g, "pe_leak_report") {
        x64_mov(&mut g.e, 3, 7);
        x64_li(&mut g.e, 7, 0);
        x64_call(&mut g.e, ng_fn_label(g, "pe_leak_report"));
        x64_mov(&mut g.e, 7, 3);
    }
    x64_mov(&mut g.e, 1, 7);
    ng_win_call_import(g, "ExitProcess");
    x64_ud2(&mut g.e);

    // nat_syscall(n, a, b, c, d, e, f) -> pe_win_syscall(env, n, ..., f)
    ng_prim(g, "nat_syscall");
    ng_win_forward(g, "pe_win_syscall", 3);
    // nat_clone_thread(entry, arg, stack_top, ctid, tls) -> pe_win_clone
    ng_prim(g, "nat_clone_thread");
    ng_win_forward(g, "pe_win_clone", 1);

    // nat_win_call(k, a, b, c, d, e, f, g, h, i, j): import k with up to
    // ten arguments in the Windows x64 convention (rcx, rdx, r8, r9, then
    // the stack above 32 bytes of shadow space); its rax. Windows keeps
    // rbx, rbp, rdi, rsi, r12-r15: every register this layer allocates.
    ng_prim(g, "nat_win_call");
    x64_push(&mut g.e, 5);
    x64_mov(&mut g.e, 5, 4);
    x64_align_sp16(&mut g.e);
    x64_sub_imm(&mut g.e, 4, 96);
    x64_lea_label(&mut g.e, 11, g.win_slots_label);
    x64_shift_imm(&mut g.e, 4, 7, 3);
    x64_alu(&mut g.e, 0x01, 11, 7);
    x64_load(&mut g.e, 11, 11, 0, 8, true);
    x64_load(&mut g.e, 11, 11, 0, 8, true);
    x64_load(&mut g.e, 9, 5, 16, 8, true);
    var j: i64 = 0;
    while j < 6 {
        x64_load(&mut g.e, 0, 5, 24 + 8 * j, 8, true);
        x64_store(&mut g.e, 0, 4, 32 + 8 * j, 8);
        j = j + 1;
    }
    x64_mov(&mut g.e, 8, 1);
    x64_mov(&mut g.e, 1, 6);
    x64_call_r(&mut g.e, 11);
    x64_mov(&mut g.e, 7, 0);
    x64_mov(&mut g.e, 4, 5);
    x64_pop(&mut g.e, 5);
    x64_ret(&mut g.e);

    // A thread's start routine (Windows: rcx = its parameter):
    // pe_win_thread_main(env 0, parameter), which never returns
    var tramp: i64 = NatEnc_label(&mut g.e);
    NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
    NatEnc_place(&mut g.e, tramp);
    x64_li(&mut g.e, 5, 0);
    x64_mov(&mut g.e, 6, 1);
    x64_li(&mut g.e, 7, 0);
    x64_call(&mut g.e, ng_fn_label(g, "pe_win_thread_main"));
    x64_ud2(&mut g.e);
    ng_prim(g, "nat_win_tramp");
    x64_lea_label(&mut g.e, 7, tramp);
    x64_ret(&mut g.e);

    // The thread pointer: TLS slot [win_tls] of the TEB (gs:[0x30] is the
    // TEB's own address, its TlsSlots at +0x1480)
    ng_prim(g, "nat_tls_get");
    x64_load_label(&mut g.e, 10, g.win_tls_label);
    x64_shift_imm(&mut g.e, 4, 10, 3);
    x64_load_gs(&mut g.e, 11, 48);
    x64_alu(&mut g.e, 0x01, 11, 10);
    x64_load(&mut g.e, 7, 11, 0x1480, 8, true);
    x64_ret(&mut g.e);
    ng_prim(g, "nat_tls_set");
    x64_load_label(&mut g.e, 10, g.win_tls_label);
    x64_shift_imm(&mut g.e, 4, 10, 3);
    x64_load_gs(&mut g.e, 11, 48);
    x64_alu(&mut g.e, 0x01, 11, 10);
    x64_store(&mut g.e, 7, 11, 0x1480, 8);
    x64_ret(&mut g.e);

    // The vectored exception handler (rcx = EXCEPTION_POINTERS): a frame
    // record for the faulting function (its rbp and rip from the CONTEXT),
    // so the trace walks the program's frames, then
    // pe_win_on_exception(env 0, pointers): 0 continue the search, -1
    // continue execution. MI14: this is the one place Windows calls this
    // code and gets control back, so it keeps what Windows' convention
    // keeps and the float pool (xmm2..xmm11) and the vector registers
    // (xmm12..xmm15) do not: xmm6..xmm15, 160 bytes below the pushes (rsp
    // stays 16-aligned at the call)
    var veh: i64 = NatEnc_label(&mut g.e);
    NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
    NatEnc_place(&mut g.e, veh);
    x64_push(&mut g.e, 5);
    x64_push(&mut g.e, 7);
    x64_push(&mut g.e, 6);
    x64_mov(&mut g.e, 6, 1);
    x64_sub_imm(&mut g.e, 4, 160);
    var vx: i64 = 6;
    while vx < 16 {
        x64_vst(&mut g.e, 4, 16 * (vx - 6), vx);
        vx = vx + 1;
    }
    x64_load(&mut g.e, 0, 1, 8, 8, true);
    x64_load(&mut g.e, 10, 0, 0xF8, 8, true);
    x64_load(&mut g.e, 11, 0, 0xA0, 8, true);
    x64_push(&mut g.e, 10);
    x64_push(&mut g.e, 11);
    x64_mov(&mut g.e, 5, 4);
    x64_li(&mut g.e, 7, 0);
    x64_call(&mut g.e, ng_fn_label(g, "pe_win_on_exception"));
    x64_mov(&mut g.e, 0, 7);
    x64_add_imm(&mut g.e, 4, 16);
    vx = 6;
    while vx < 16 {
        x64_vld(&mut g.e, vx, 4, 16 * (vx - 6));
        vx = vx + 1;
    }
    x64_add_imm(&mut g.e, 4, 160);
    x64_pop(&mut g.e, 6);
    x64_pop(&mut g.e, 7);
    x64_pop(&mut g.e, 5);
    x64_ret(&mut g.e);
    ng_prim(g, "nat_sig_handler");
    x64_lea_label(&mut g.e, 7, veh);
    x64_ret(&mut g.e);
    ng_prim(g, "nat_sig_restorer");
    x64_li(&mut g.e, 7, 0);
    x64_ret(&mut g.e);
}

/// The import directory, the import lookup and address tables, the names,
/// then the table of slot addresses nat_win_call reads and the TLS index.
fn ng_gen_win_imports(g: &mut NatGen) {
    var imps: Vec<str> = ng_win_imports();
    // TG15: the C functions of `extern "C"` blocks (ng_ldyn_import), each
    // from the DLL of its `link` (nat_enc.fd nat_pe_dll_for); its IAT entry
    // is its GOT slot (placed below with the others)
    var lwi: i64 = 0;
    while lwi < g.ld.names.len() {
        imps.push(nat_pe_dll_for(g.ld.libs.get(lwi)) + "|" + g.ld.names.get(lwi));
        g.win_slot_labels.push(g.ld.got_labels.get(lwi));
        lwi = lwi + 1;
    }
    var dlls: Vec<str> = Vec::new();
    var fdll: Vec<i64> = Vec::new();
    var fname: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < imps.len() {
        var e: str = imps.get(i);
        var bar: i64 = str_find(e, "|");
        var dn: str = str_slice(e, 0, bar);
        fname.push(str_slice(e, bar + 1, str_len(e)));
        var di: i64 = 0 - 1;
        var k: i64 = 0;
        while k < dlls.len() {
            if dlls.get(k) == dn {
                di = k;
            }
            k = k + 1;
        }
        if di < 0 {
            dlls.push(dn);
            di = dlls.len() - 1;
        }
        fdll.push(di);
        i = i + 1;
    }
    var ilt: Vec<i64> = Vec::new();
    var iat: Vec<i64> = Vec::new();
    var dname: Vec<i64> = Vec::new();
    var hint: Vec<i64> = Vec::new();
    var d: i64 = 0;
    while d < dlls.len() {
        ilt.push(NatEnc_label(&mut g.e));
        iat.push(NatEnc_label(&mut g.e));
        dname.push(NatEnc_label(&mut g.e));
        d = d + 1;
    }
    i = 0;
    while i < imps.len() {
        hint.push(NatEnc_label(&mut g.e));
        i = i + 1;
    }
    NatEnc_align(&mut g.e, 8);
    NatEnc_place(&mut g.e, g.win_imp_label);
    d = 0;
    while d < dlls.len() {
        NatEnc_rva32(&mut g.e, ilt.get(d));
        NatEnc_u32(&mut g.e, 0);
        NatEnc_u32(&mut g.e, 0);
        NatEnc_rva32(&mut g.e, dname.get(d));
        NatEnc_rva32(&mut g.e, iat.get(d));
        d = d + 1;
    }
    var z: i64 = 0;
    while z < 5 {
        NatEnc_u32(&mut g.e, 0);
        z = z + 1;
    }
    NatEnc_place(&mut g.e, g.win_imp_end);
    // The lookup table, then the address table (the loader fills it)
    var pass: i64 = 0;
    while pass < 2 {
        NatEnc_align(&mut g.e, 8);
        if pass == 1 {
            NatEnc_place(&mut g.e, g.win_iat_label);
        }
        d = 0;
        while d < dlls.len() {
            if pass == 0 {
                NatEnc_place(&mut g.e, ilt.get(d));
            } else {
                NatEnc_place(&mut g.e, iat.get(d));
            }
            i = 0;
            while i < imps.len() {
                if fdll.get(i) == d {
                    if pass == 1 {
                        NatEnc_place(&mut g.e, g.win_slot_labels.get(i));
                    }
                    NatEnc_rva32(&mut g.e, hint.get(i));
                    NatEnc_u32(&mut g.e, 0);
                }
                i = i + 1;
            }
            NatEnc_quad(&mut g.e, 0);
            d = d + 1;
        }
        if pass == 1 {
            NatEnc_place(&mut g.e, g.win_iat_end);
        }
        pass = pass + 1;
    }
    i = 0;
    while i < imps.len() {
        NatEnc_align(&mut g.e, 2);
        NatEnc_place(&mut g.e, hint.get(i));
        NatEnc_byte(&mut g.e, 0);
        NatEnc_byte(&mut g.e, 0);
        var nm: str = fname.get(i);
        var c: i64 = 0;
        while c < str_len(nm) {
            NatEnc_byte(&mut g.e, str_byte_at(nm, c));
            c = c + 1;
        }
        NatEnc_byte(&mut g.e, 0);
        i = i + 1;
    }
    d = 0;
    while d < dlls.len() {
        NatEnc_place(&mut g.e, dname.get(d));
        var dn2: str = dlls.get(d);
        var c2: i64 = 0;
        while c2 < str_len(dn2) {
            NatEnc_byte(&mut g.e, str_byte_at(dn2, c2));
            c2 = c2 + 1;
        }
        NatEnc_byte(&mut g.e, 0);
        d = d + 1;
    }
    NatEnc_align(&mut g.e, 8);
    NatEnc_place(&mut g.e, g.win_slots_label);
    i = 0;
    while i < imps.len() {
        NatEnc_fix(&mut g.e, g.win_slot_labels.get(i), NATFIX_ABS64);
        NatEnc_quad(&mut g.e, 0);
        i = i + 1;
    }
    NatEnc_place(&mut g.e, g.win_tls_label);
    NatEnc_quad(&mut g.e, 0);
}

fn NatEnc_label_offset(e: &NatEnc, label: i64) -> i64 {
    return e.labels.get(label);
}

/// One segment of ng_cold_last to the hot code (`out`) or the cold code:
/// cold when it holds a trap and nothing falls into it, or when what falls
/// into it can jump to its label instead (a JMP is added to `out`).
fn ng_cold_flush(seg: &Vec<MInst>, traps: bool, fallen_into: bool, out: &mut Vec<MInst>, cold: &mut Vec<MInst>) {
    if seg.len() == 0 {
        return;
    }
    var to_cold: bool = traps;
    if traps && fallen_into {
        var first: MInst = seg.get(0);
        if first.op == MO_PLACE {
            out.push(MInst {
                op: MO_JMP, r0: 0, r1: 0, r2: 0, i0: first.i0, i1: 0, i2: 0
            });
        } else {
            to_cold = false;
        }
    }
    var z: i64 = 0;
    while z < seg.len() {
        if to_cold {
            cold.push(seg.get(z));
        } else {
            out.push(seg.get(z));
        }
        z = z + 1;
    }
}

/// OP15: whether MIR segment [s, e) calls one of the labels of `cold_calls`
/// (an integer-keyed map, ng_cold_call_labels; 0: none). The entry segment
/// (it holds the prologue) never counts.
fn ng_seg_calls_cold(mir: &Vec<MInst>, s: i64, e: i64, cold_calls: i64) -> bool {
    if cold_calls == 0 {
        return false;
    }
    var found: bool = false;
    var k: i64 = s;
    while k < e {
        var m: MInst = mir.get(k);
        if m.op == MO_PROLOGUE {
            return false;
        }
        if m.op == MO_CALL && HashMap_contains_i(cold_calls, m.i0) {
            found = true;
        }
        k = k + 1;
    }
    return found;
}

/// OP15: whether `mir` calls one of the labels of `cold_calls` at all.
fn ng_mir_calls_cold(mir: &Vec<MInst>, cold_calls: i64) -> bool {
    if cold_calls == 0 {
        return false;
    }
    var k: i64 = 0;
    while k < mir.len() {
        var m: MInst = mir.get(k);
        if m.op == MO_CALL && HashMap_contains_i(cold_calls, m.i0) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

/// OP15: whether MIR segment [s, e) holds the prologue.
fn ng_seg_has_prologue(mir: &Vec<MInst>, s: i64, e: i64) -> bool {
    var k: i64 = s;
    while k < e {
        if mir.get(k).op == MO_PROLOGUE {
            return true;
        }
        k = k + 1;
    }
    return false;
}

/// OP15: label -> the id of the IR block it starts (an integer-keyed map,
/// 0 until a profile is in use), filled as functions are recorded; label
/// ids are absolute, so one map serves every function.
var g_ng_label_block: i64 = 0;

/// OP15: a profile's block counts below 1/NG_PGO_COLD_RATIO of the
/// function's calls make the block cold.
const NG_PGO_COLD_RATIO: i64 = 1000;

fn ng_note_block_label(label: i64, block_id: i64) {
    if g_ng_label_block == 0 {
        g_ng_label_block = HashMap_new();
    }
    HashMap_insert_i(g_ng_label_block, label, block_id);
}

/// OP15: the block profile of function `name` as ng_cold_last's
/// `cold_labels`: for each label in `mir` that starts an IR block the
/// profile counts, 1 when the run entered that block less than once per
/// NG_PGO_COLD_RATIO calls of the function (never, in particular), else 2;
/// 0 when no block is cold or there is no block profile. The profile
/// (compiler/pgo.fd, written by `fid run --profile`) holds, besides each
/// function's calls, a line "<n> <function>@<block id>" per block of each
/// function the run called, n being 1 + the times the block was entered
/// (1: never; a block it does not name, one optimization made, counts as
/// hot).
fn ng_pgo_cold_labels(name: str, mir: &Vec<MInst>) -> i64 {
    if g_ng_label_block == 0 {
        return 0;
    }
    var calls: i64 = pgo_count(name);
    if calls <= 0 {
        return 0;
    }
    var m: i64 = HashMap_new();
    var ncold: i64 = 0;
    var k: i64 = 0;
    while k < mir.len() {
        var pm: MInst = mir.get(k);
        if pm.op == MO_PLACE && HashMap_contains_i(g_ng_label_block, pm.i0) && !HashMap_contains_i(m, pm.i0) {
            var c: i64 = pgo_count(name + "@" + int_to_str(HashMap_get_i(g_ng_label_block, pm.i0)));
            if c >= 1 && (c - 1) * NG_PGO_COLD_RATIO < calls {
                HashMap_insert_i(m, pm.i0, 1);
                ncold = ncold + 1;
            } else {
                HashMap_insert_i(m, pm.i0, 2);
            }
        }
        k = k + 1;
    }
    if ncold == 0 {
        return 0;
    }
    return m;
}

/// OP15: the labels of the functions whose call marks the block making it
/// cold: those marked `@cold` and core's cold_path() (compiler/ast.fd
/// is_cold_fn_hint), panic, and the functions that are only panic paths
/// (`only_panic`: indexes into g.recs, ng_mir_finish's WP17 list). An
/// integer-keyed map, 0 when there is none.
fn ng_cold_call_labels(g: &NatGen, only_panic: &Vec<i64>) -> i64 {
    var m: i64 = HashMap_new();
    var n: i64 = 0;
    var i: i64 = 0;
    while i < g.fn_label_names.len() {
        var nm: str = g.fn_label_names.get(i);
        if nm == "panic" || nm == "p_panic" || nm == "pert_panic" || is_cold_fn_hint(nm) {
            if HashMap_contains(g.fn_labels, nm) {
                HashMap_insert_i(m, HashMap_get(g.fn_labels, nm), 1);
                n = n + 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < only_panic.len() {
        var pn: str = g.recs.get(only_panic.get(i)).name;
        if HashMap_contains(g.fn_labels, pn) {
            HashMap_insert_i(m, HashMap_get(g.fn_labels, pn), 1);
            n = n + 1;
        }
        i = i + 1;
    }
    // The functions that never return but by a panic: panic, p_panic, the
    // WP17 list, and to a fixed point each function whose entry runs into
    // a trap or a call of one of them before any branch (`fn fail(msg:
    // str) { panic(msg); }` calls core's panic, so WP17 leaves it out).
    // A function cache hit's recorded MIR is only a summary: its entry run
    // (NcEntry.entry_run, CS6 part 3) answers for it (ng_entry_run_noret).
    var noret: i64 = HashMap_new();
    i = 0;
    while i < only_panic.len() {
        var opn: str = g.recs.get(only_panic.get(i)).name;
        if HashMap_contains(g.fn_labels, opn) {
            HashMap_insert_i(noret, HashMap_get(g.fn_labels, opn), 1);
        }
        i = i + 1;
    }
    if HashMap_contains(g.fn_labels, "panic") {
        HashMap_insert_i(noret, HashMap_get(g.fn_labels, "panic"), 1);
    }
    if HashMap_contains(g.fn_labels, "p_panic") {
        HashMap_insert_i(noret, HashMap_get(g.fn_labels, "p_panic"), 1);
    }
    // the runtime's p_panic (stdlib/linux_runtime/base.fd: it exits)
    if HashMap_contains(g.fn_labels, "pert_panic") {
        HashMap_insert_i(noret, HashMap_get(g.fn_labels, "pert_panic"), 1);
    }
    var changed: bool = true;
    var rounds: i64 = 0;
    while changed && rounds <= g.recs.len() {
        changed = false;
        rounds = rounds + 1;
        i = 0;
        while i < g.recs.len() {
            var pr: NatFnRec = g.recs.get(i);
            if HashMap_contains(g.fn_labels, pr.name) {
                var pl: i64 = HashMap_get(g.fn_labels, pr.name);
                var hix: i64 = nc_hit_at(g, pr.name);
                var enters: bool = false;
                if !HashMap_contains_i(noret, pl) {
                    if hix != 0 {
                        var er: Vec<str> = g.nc_old.get(hix - 1).entry_run;
                        enters = ng_entry_run_noret(g, er, noret);
                    } else {
                        enters = ng_mir_enters_noret(&pr.mir, noret);
                    }
                }
                if enters {
                    HashMap_insert_i(noret, pl, 1);
                    changed = true;
                    if !HashMap_contains_i(m, pl) {
                        HashMap_insert_i(m, pl, 1);
                        n = n + 1;
                    }
                }
            }
            i = i + 1;
        }
    }
    if n == 0 {
        return 0;
    }
    return m;
}

/// CS6 part 3: ng_mir_enters_noret for a function cache hit, from its
/// entry run (NcEntry.entry_run): a trap ("!") or a call of a function
/// whose label is in `noret`.
fn ng_entry_run_noret(g: &NatGen, run: Vec<str>, noret: i64) -> bool {
    var k: i64 = 0;
    while k < run.len() {
        var nm: str = run.get(k);
        if nm == "!" {
            return true;
        }
        if nm != "?" && HashMap_contains(g.fn_labels, nm) && HashMap_contains_i(noret, HashMap_get(g.fn_labels, nm)) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

/// OP15: whether every call of the recorded function `mir` panics: the
/// code from its entry to its first branch or epilogue (all of which runs
/// on each call) holds a trap or a call of a label of `noret` (functions
/// that never return).
fn ng_mir_enters_noret(mir: &Vec<MInst>, noret: i64) -> bool {
    var k: i64 = 0;
    while k < mir.len() {
        var m: MInst = mir.get(k);
        if m.op == MO_TRAP {
            return true;
        }
        if m.op == MO_CALL && HashMap_contains_i(noret, m.i0) {
            return true;
        }
        if m.op == MO_EPILOGUE || mi_is_br(m.op) {
            return false;
        }
        k = k + 1;
    }
    return false;
}

/// WP17: reorder a recorded function's segments so runs that end in a trap
/// (the panic paths) come last. Segments end at block terminators; a
/// MO_PLACE starts a fresh one. Label ids are absolute, so moving a run is
/// layout-only.
/// OP15: with `cold_calls` (ng_cold_call_labels; 0 at recording, when the
/// callees are not all known yet), a segment that calls one of those
/// functions (`@cold`, cold_path(), one that only panics) goes after the
/// hot code too (ng_mir_finish, `FID_NAT_OFF=coldhint`: never). It may be
/// fallen into (a JMP to its label is left behind, as for a trap) and may
/// fall out (it gets a JMP to the label of the segment after it); when
/// either has no label to jump to, it stays. With `cold_labels`
/// (ng_pgo_cold_labels; 0: no block profile) the blocks a profiled run
/// never or rarely entered move the same way (`FID_NAT_OFF=pgolayout`).
fn ng_cold_last(mir: &Vec<MInst>, cold_calls: i64, cold_labels: i64) -> Vec<MInst> {
    var out: Vec<MInst> = Vec::new();
    var cold: Vec<MInst> = Vec::new();
    if mi_has_jtab(mir) {
        // MI27: a jump table's dispatch and entries stay together: the
        // layout as recorded
        var jk: i64 = 0;
        while jk < mir.len() {
            out.push(mir.get(jk));
            jk = jk + 1;
        }
        return out;
    }
    // The segments: [start, end), holds a trap, fallen into, falls out
    var ss: Vec<i64> = Vec::new();
    var se: Vec<i64> = Vec::new();
    var st: Vec<bool> = Vec::new();
    var sf: Vec<bool> = Vec::new();
    var so: Vec<bool> = Vec::new();
    var traps: bool = false;
    // MI6: whether control falls from the instruction before into the
    // current point (the function's entry counts: its label is placed
    // before the first instruction), and whether it fell into the segment
    // being collected. A segment that is fallen into (the else block of a
    // BNEZ, a block after one with no jump) cannot just move: when it
    // starts with its label it moves with a JMP to it left behind (the
    // peephole turns `BEQZ r, L; JMP C; L:` into `BNEZ r, C`); without one
    // (the entry, code after a conditional branch) it stays.
    var falls: bool = true;
    var seg_falls: bool = true;
    var start: i64 = 0;
    var k: i64 = 0;
    while k < mir.len() {
        var m: MInst = mir.get(k);
        if m.op == MO_PLACE && k > start {
            ss.push(start);
            se.push(k);
            st.push(traps);
            sf.push(seg_falls);
            so.push(falls);
            start = k;
            traps = false;
        }
        if k == start {
            seg_falls = falls;
        }
        if m.op == MO_TRAP {
            traps = true;
        }
        if m.op == MO_JMP || m.op == MO_EPILOGUE || m.op == MO_TRAP {
            falls = false;
        } else if m.op != MO_LINE && m.op != MO_PLACE {
            falls = true;
        }
        if mi_ends_block(m.op) {
            ss.push(start);
            se.push(k + 1);
            st.push(traps);
            sf.push(seg_falls);
            so.push(falls);
            start = k + 1;
            traps = false;
        }
        k = k + 1;
    }
    if start < mir.len() {
        ss.push(start);
        se.push(mir.len());
        st.push(traps);
        sf.push(seg_falls);
        so.push(falls);
    }
    // OP15: the segment before went to the cold code with a JMP to this
    // one, so nothing falls into this one in `out`
    var prev_moved: bool = false;
    // OP15: inside an IR block the profile found cold (cold_labels)
    var in_pcold: bool = false;
    var i: i64 = 0;
    while i < ss.len() {
        var s: i64 = ss.get(i);
        var e: i64 = se.get(i);
        var fallen: bool = sf.get(i) && !prev_moved;
        prev_moved = false;
        var seg: Vec<MInst> = Vec::new();
        var z: i64 = s;
        while z < e {
            seg.push(mir.get(z));
            z = z + 1;
        }
        var hinted: bool = !st.get(i) && ng_seg_calls_cold(mir, s, e, cold_calls);
        // OP15: with a block profile, the segments of an IR block the run
        // never or rarely entered (`cold_labels`, ng_pgo_cold_labels: 1
        // cold, 2 hot, by the label that starts the block; the segments
        // after its first one, up to the next block's label, inherit it)
        if cold_labels != 0 {
            var fm: MInst = mir.get(s);
            if fm.op == MO_PLACE && HashMap_contains_i(cold_labels, fm.i0) {
                in_pcold = HashMap_get_i(cold_labels, fm.i0) == 1;
            }
            if in_pcold && !st.get(i) && !ng_seg_has_prologue(mir, s, e) {
                hinted = true;
            }
        }
        if hinted {
            var first: MInst = mir.get(s);
            var in_label: i64 = 0 - 1;
            if first.op == MO_PLACE {
                in_label = first.i0;
            }
            var out_label: i64 = 0 - 1;
            if i + 1 < ss.len() {
                var nx: MInst = mir.get(ss.get(i + 1));
                if nx.op == MO_PLACE {
                    out_label = nx.i0;
                }
            }
            if (fallen && in_label < 0) || (so.get(i) && out_label < 0) {
                hinted = false;
            } else {
                if fallen {
                    out.push(MInst {
                        op: MO_JMP, r0: 0, r1: 0, r2: 0, i0: in_label, i1: 0, i2: 0
                    });
                }
                var c: i64 = 0;
                while c < seg.len() {
                    cold.push(seg.get(c));
                    c = c + 1;
                }
                if so.get(i) {
                    cold.push(MInst {
                        op: MO_JMP, r0: 0, r1: 0, r2: 0, i0: out_label, i1: 0, i2: 0
                    });
                    prev_moved = true;
                }
            }
        }
        if !hinted {
            ng_cold_flush(&seg, st.get(i), fallen, &mut out, &mut cold);
        }
        i = i + 1;
    }
    var k2: i64 = 0;
    while k2 < cold.len() {
        out.push(cold.get(k2));
        k2 = k2 + 1;
    }
    return out;
}

// ===========================================================================
// CS6: per-function native artifact cache (opt-in, FID_FNCACHE=<path>).
//
// Each cache entry is a function's emitted bytes BEFORE fixup resolution plus
// the relocation descriptors (position, patch kind, symbolic target). On a
// rebuild whose content key matches — post-opt IR, module salt, and backend
// configuration all identical — the bytes are replayed into the current
// NatEnc at whatever offset the function lands, and the symbolic fixups are
// re-registered against the new label space. Raw linked bytes are never
// reused: every image layout is relinked.
// ===========================================================================

pub struct NcFix {
    pub pos: i64,
    // byte offset inside the function's slice
    pub kind: i64,
    // NatFix kind (patch format)
    pub tkind: i64,
    // 0 internal offset, 1 function, 2 string, 3 singleton
    pub toff: i64,
    // tkind 0: offset inside the function
    pub tstr: str,  // tkind 1/2/3: target identity
}

pub struct NcEntry {
    pub name: str,
    pub key: i64,
    pub mir_len: i64,
    pub n_traps: i64,
    pub n_calls: i64,
    pub mask: i64,
    pub bytes: Vec<i64>,
    pub fixes: Vec<NcFix>,
    pub edges: Vec<str>,
    // call-graph edges (MIR calls that resolve to fns)
    pub refs: Vec<str>,
    // every function the code references (queue deps)
    pub fold_key: str,  // ng_mir_key under the run's alloc — lets fresh fns fold onto the copy
    // SP6/SP20: the labels its recording asked for, in order (nc_log)
    pub regs: Vec<str>,
    // CS6/SP20: its debug rows, so a hit's image has them as a fresh
    // build's: line rows [offset, line, file word] (the file word is
    // re-made from the function's file at replay), .debug_frame rows
    // [offset, offset or code (< 0), offset] (g.cfi_rows), its variables
    // (g_ng_dbg_vars' text, "" for none)
    pub lrows: Vec<i64>,
    pub cfi: Vec<i64>,
    pub dvars: str,
    // SP6: what its code took for granted about the functions it refers to
    // (its refs, once each): the clobber mask its allocation saw for each
    // one (ng_label_mask, -1: every register) and the size of each one's
    // struct result in registers (ME27 / LF24, 0: through memory). A hit is
    // kept only while these still hold (nc_validate).
    pub deps: Vec<str>,
    pub dep_masks: Vec<i64>,
    pub dep_rr: Vec<i64>,
    // SP6: its own struct result in registers (bytes, 0: through memory),
    // and the functions whose address its code takes (ng_rr_plan's `taken`)
    pub rr_self: i64,
    pub addrs: Vec<str>,
    // SP20: MI28's escape summary of the function itself in the build that
    // recorded it (ng_ft_settle: 1 keeps and returns nothing derived from
    // its arguments, 2 may; 0: none, FID_NAT_OFF=tailframe), and the one
    // its own analyses read of each dep (dep_ft parallel to deps; 0: not
    // read). A hit is kept only while those still hold (nc_deps_ok,
    // nc_ft_hold), and a function compiled again reads a hit's summary from
    // here (ng_ft_esc_map): the summaries, so the tail jumps, are a cache-off
    // build's.
    pub ft_self: i64,
    pub dep_ft: Vec<i64>,
    // CS6 part 3: what its code does from the entry to the first branch or
    // epilogue (all of which runs on each call), for ng_cold_call_labels's
    // noret fixpoint on a hit (whose MIR is only a summary): "!" for a trap
    // (and nothing after it), else the name of each function it calls in
    // order ("?" for a call of a label that is not a function's)
    pub entry_run: Vec<str>,
}

// --- content hash ---------------------------------------------------------

@wrapping
fn nc_h(h: i64, v: i64) -> i64 {
    return h * 131 + v;
}

fn nc_hs(h: i64, s: str) -> i64 {
    return nc_h(h, hash_source(s));
}

fn nc_hty(h: i64, t: IrType) -> i64 {
    match t {
        IrType::I8 => {
            return nc_h(h, 1);
        }
        IrType::I16 => {
            return nc_h(h, 2);
        }
        IrType::I32 => {
            return nc_h(h, 3);
        }
        IrType::I64 => {
            return nc_h(h, 4);
        }
        IrType::U8 => {
            return nc_h(h, 5);
        }
        IrType::U16 => {
            return nc_h(h, 6);
        }
        IrType::U32 => {
            return nc_h(h, 7);
        }
        IrType::U64 => {
            return nc_h(h, 8);
        }
        IrType::F32 => {
            return nc_h(h, 9);
        }
        IrType::F64 => {
            return nc_h(h, 10);
        }
        IrType::Bool => {
            return nc_h(h, 11);
        }
        IrType::Ptr(inner) => {
            return nc_hty(nc_h(h, 12), inner);
        }
        IrType::Struct(n) => {
            return nc_hs(nc_h(h, 13), n);
        }
        IrType::Array(inner, n) => {
            return nc_hty(nc_h(nc_h(h, 14), n), inner);
        }
        IrType::Void => {
            return nc_h(h, 15);
        }
        IrType::Never => {
            return nc_h(h, 16);
        }
        IrType::Opaque(n) => {
            return nc_hs(nc_h(h, 17), n);
        }
        IrType::Generic(n, args) => {
            var hh: i64 = nc_hs(nc_h(h, 18), n);
            var i: i64 = 0;
            while i < args.len() {
                hh = nc_hty(hh, args.get(i));
                i = i + 1;
            }
            // BG86: the count ends the list (Generic(G, [Generic(H, [a]), b])
            // and Generic(G, [Generic(H, [a, b])]) hashed alike)
            return nc_h(hh, args.len());
        }
    }
    return h;
}

fn nc_hopt_ty(h: i64, t: OptIrType) -> i64 {
    match t {
        OptIrType::Some(inner) => {
            return nc_hty(nc_h(h, 1), inner);
        }
        OptIrType::None => {
            return nc_h(h, 0);
        }
    }
    return h;
}

fn nc_hbinop(h: i64, op: BinOp) -> i64 {
    match op {
        BinOp::Add => {
            return nc_h(h, 1);
        }
        BinOp::Sub => {
            return nc_h(h, 2);
        }
        BinOp::Mul => {
            return nc_h(h, 3);
        }
        BinOp::Div => {
            return nc_h(h, 4);
        }
        BinOp::Mod => {
            return nc_h(h, 5);
        }
        BinOp::Eq => {
            return nc_h(h, 6);
        }
        BinOp::Neq => {
            return nc_h(h, 7);
        }
        BinOp::Lt => {
            return nc_h(h, 8);
        }
        BinOp::Gt => {
            return nc_h(h, 9);
        }
        BinOp::LtEq => {
            return nc_h(h, 10);
        }
        BinOp::GtEq => {
            return nc_h(h, 11);
        }
        BinOp::And => {
            return nc_h(h, 12);
        }
        BinOp::Or => {
            return nc_h(h, 13);
        }
        BinOp::BitAnd => {
            return nc_h(h, 14);
        }
        BinOp::BitOr => {
            return nc_h(h, 15);
        }
        BinOp::BitXor => {
            return nc_h(h, 16);
        }
        BinOp::Shl => {
            return nc_h(h, 17);
        }
        BinOp::Shr => {
            return nc_h(h, 18);
        }
    }
    return h;
}

fn nc_hunop(h: i64, op: UnaryOp) -> i64 {
    match op {
        UnaryOp::Neg => {
            return nc_h(h, 1);
        }
        UnaryOp::Not => {
            return nc_h(h, 2);
        }
        UnaryOp::BitNot => {
            return nc_h(h, 3);
        }
    }
    return h;
}

fn nc_heff(h: i64, e: EffectSet) -> i64 {
    var i: i64 = 0;
    while i < e.effects.len() {
        var tag: i64 = 0;
        match e.effects.get(i) {
            Effect::Alloc => {
                tag = 1;
            }
            Effect::IO => {
                tag = 2;
            }
            Effect::Net => {
                tag = 3;
            }
            Effect::Spawn => {
                tag = 4;
            }
            Effect::Diverge => {
                tag = 5;
            }
            Effect::Read => {
                tag = 6;
            }
            Effect::Write => {
                tag = 7;
            }
            Effect::Diff => {
                tag = 8;
            }
            Effect::Noise => {
                tag = 9;
            }
            Effect::Comm => {
                tag = 10;
            }
        }
        h = nc_h(h, tag);
        i = i + 1;
    }
    return h;
}

fn nc_hregion(h: i64, r: Region) -> i64 {
    match r {
        Region::Stack => {
            return nc_h(h, 1);
        }
        Region::Heap => {
            return nc_h(h, 2);
        }
        Region::Static => {
            return nc_h(h, 3);
        }
        Region::Named(n) => {
            return nc_hs(nc_h(h, 4), n);
        }
    }
    return h;
}

fn nc_hids(h: i64, v: Vec<i64>) -> i64 {
    var i: i64 = 0;
    while i < v.len() {
        h = nc_h(h, v.get(i));
        i = i + 1;
    }
    return nc_h(h, v.len());
}

fn nc_hinst(h: i64, inst: Inst) -> i64 {
    match inst {
        Inst::ConstInt(v, ty) => {
            return nc_hty(nc_h(nc_h(h, 1), v), ty);
        }
        Inst::ConstFloat(v, ty) => {
            return nc_hty(nc_h(nc_h(h, 2), p_f64_to_bits(v)), ty);
        }
        Inst::ConstBool(v) => {
            if v {
                return nc_h(h, 4);
            }
            return nc_h(h, 3);
        }
        Inst::ConstStr(s) => {
            return nc_hs(nc_h(h, 5), s);
        }
        Inst::ConstFnRef(n) => {
            return nc_hs(nc_h(h, 6), n);
        }
        Inst::ConstNull(ty) => {
            return nc_hty(nc_h(h, 7), ty);
        }
        Inst::GlobalAddr(n, ty) => {
            return nc_hty(nc_hs(nc_h(h, 8), n), ty);
        }
        Inst::BinOp(op, l, r, ty) => {
            return nc_hty(nc_h(nc_h(nc_hbinop(nc_h(h, 9), op), l), r), ty);
        }
        Inst::UnaryOp(op, v, ty) => {
            return nc_hty(nc_h(nc_hunop(nc_h(h, 10), op), v), ty);
        }
        Inst::Alloca(ty, r) => {
            return nc_hregion(nc_hty(nc_h(h, 11), ty), r);
        }
        Inst::Load(p, ty) => {
            return nc_hty(nc_h(nc_h(h, 12), p), ty);
        }
        Inst::Store(p, v, ty) => {
            return nc_hopt_ty(nc_h(nc_h(nc_h(h, 13), p), v), ty);
        }
        Inst::GetFieldPtr(b, f, ty) => {
            return nc_hty(nc_h(nc_h(nc_h(h, 14), b), f), ty);
        }
        Inst::GetElemPtr(b, i, ty) => {
            return nc_hty(nc_h(nc_h(nc_h(h, 15), b), i), ty);
        }
        Inst::Jump(t) => {
            return nc_h(nc_h(h, 16), t);
        }
        Inst::Branch(c, t, f) => {
            return nc_h(nc_h(nc_h(nc_h(h, 17), c), t), f);
        }
        Inst::Switch(sv, sk, st, sd) => {
            return nc_h(nc_hids(nc_hids(nc_h(nc_h(h, 43), sv), sk), st), sd);
        }
        Inst::Return(v) => {
            match v {
                OptValueId::Some(x) => {
                    return nc_h(nc_h(h, 18), x);
                }
                OptValueId::None => {
                    return nc_h(h, 19);
                }
            }
            return h;
        }
        Inst::Unreachable => {
            return nc_h(h, 20);
        }
        Inst::Call(n, args, ty, fx) => {
            return nc_heff(nc_hty(nc_hids(nc_hs(nc_h(h, 21), n), args), ty), fx);
        }
        Inst::CallPtr(fp, args, ty, fx, tail) => {
            var hh: i64 = nc_heff(nc_hty(nc_hids(nc_h(nc_h(h, 22), fp), args), ty), fx);
            if tail {
                return nc_h(hh, 1);
            }
            return hh;
        }
        Inst::DynCall(tn, mn, args, ty, fx) => {
            return nc_heff(nc_hty(nc_hids(nc_hs(nc_hs(nc_h(h, 23), tn), mn), args), ty), fx);
        }
        Inst::MakeDyn(v, tn, mn) => {
            return nc_hs(nc_hs(nc_h(nc_h(h, 24), v), tn), mn);
        }
        Inst::BitCast(v, a, b) => {
            return nc_hty(nc_hty(nc_h(nc_h(h, 25), v), a), b);
        }
        Inst::IntExtend(v, a, b) => {
            return nc_hty(nc_hty(nc_h(nc_h(h, 26), v), a), b);
        }
        Inst::IntTrunc(v, a, b) => {
            return nc_hty(nc_hty(nc_h(nc_h(h, 27), v), a), b);
        }
        Inst::IntToFloat(v, a, b) => {
            return nc_hty(nc_hty(nc_h(nc_h(h, 28), v), a), b);
        }
        Inst::FloatToInt(v, a, b) => {
            return nc_hty(nc_hty(nc_h(nc_h(h, 29), v), a), b);
        }
        Inst::TryUnwrap(v, ok, bad, out) => {
            return nc_h(nc_h(nc_h(nc_h(nc_h(h, 30), v), ok), bad), out);
        }
        Inst::Print(v, ty) => {
            return nc_hty(nc_h(nc_h(h, 31), v), ty);
        }
        Inst::Panic(m) => {
            return nc_hs(nc_h(h, 32), m);
        }
        Inst::Asm(tpl, outs, ins, ty) => {
            var hh: i64 = nc_hty(nc_hs(nc_h(h, 33), tpl), ty);
            var i: i64 = 0;
            while i < outs.len() {
                hh = nc_h(nc_hs(hh, outs.get(i).name), outs.get(i).id);
                i = i + 1;
            }
            // BG86: the counts keep the outputs and the inputs apart (one
            // output and no input hashed as no output and one input)
            hh = nc_h(hh, outs.len());
            var j: i64 = 0;
            while j < ins.len() {
                hh = nc_h(nc_hs(hh, ins.get(j).name), ins.get(j).id);
                j = j + 1;
            }
            return nc_h(hh, ins.len());
        }
        Inst::RegionBegin(n, a, b, l) => {
            var hh: i64 = nc_hs(nc_h(h, 34), n);
            if a {
                hh = nc_h(hh, 1);
            }
            if b {
                hh = nc_h(hh, 2);
            }
            match l {
                OptU64::Some(x) => {
                    return nc_h(hh, x);
                }
                OptU64::None => {
                    return hh;
                }
            }
            return hh;
        }
        Inst::RegionEnd(n, a, b) => {
            var hh: i64 = nc_hs(nc_h(h, 35), n);
            if a {
                hh = nc_h(hh, 1);
            }
            if b {
                hh = nc_h(hh, 2);
            }
            return hh;
        }
        Inst::PersistLoad(n, v, ty) => {
            return nc_hty(nc_h(nc_hs(nc_h(h, 36), n), v), ty);
        }
        Inst::PersistSave(n, v) => {
            return nc_h(nc_hs(nc_h(h, 37), n), v);
        }
        Inst::TxnBegin => {
            return nc_h(h, 38);
        }
        Inst::TxnEnd => {
            return nc_h(h, 39);
        }
        Inst::UnsafeBegin => {
            return nc_h(h, 40);
        }
        Inst::UnsafeEnd => {
            return nc_h(h, 41);
        }
        Inst::GradBegin(n) => {
            return nc_hs(nc_h(h, 42), n);
        }
        Inst::GradEnd => {
            return nc_h(h, 43);
        }
        Inst::Backward(v) => {
            return nc_h(nc_h(h, 44), v);
        }
        Inst::StructCopy(d, s, ty) => {
            return nc_hty(nc_h(nc_h(nc_h(h, 45), d), s), ty);
        }
    }
    return h;
}

/// The content key: everything about the function that can change the bytes
/// the backend emits for it. Covers the instructions, block shape, value
/// types/regions, params, return type, and every codegen-relevant flag.
fn nc_fn_hash(f: &IrFunction) -> i64 {
    var h: i64 = nc_hs(1469598103934665603, f.name);
    h = nc_hty(h, f.ret_ty);
    h = nc_h(h, f.entry);
    var i: i64 = 0;
    while i < f.params.len() {
        h = nc_hty(nc_h(h, f.params.get(i).id), f.params.get(i).ty);
        i = i + 1;
    }
    var b: i64 = 0;
    while b < f.blocks.len() {
        var bb: BasicBlock = f.blocks.get(b);
        h = nc_h(h, bb.id);
        h = nc_hids(h, bb.instructions);
        h = nc_hids(h, bb.predecessors);
        var p: i64 = 0;
        while p < bb.params.len() {
            h = nc_hty(nc_h(h, bb.params.get(p).id), bb.params.get(p).ty);
            p = p + 1;
        }
        b = b + 1;
    }
    var v: i64 = 0;
    while v < f.value_metas.len() {
        var vm: ValueIdMeta = f.value_metas.get(v);
        h = nc_hregion(nc_hty(nc_h(h, vm.id), vm.meta.ty), vm.meta.region);
        v = v + 1;
    }
    var j: i64 = 0;
    while j < f.insts.len() {
        h = nc_hinst(nc_h(h, f.insts.get(j).id), f.insts.get(j).inst);
        j = j + 1;
    }
    var k: i64 = 0;
    while k < f.locals.len() {
        h = nc_h(nc_hs(h, f.locals.get(k).name), f.locals.get(k).id);
        k = k + 1;
    }
    var w: i64 = 0;
    while w < f.persist_vars.len() {
        h = nc_h(nc_hs(h, f.persist_vars.get(w).name), f.persist_vars.get(w).id);
        w = w + 1;
    }
    var d: i64 = 0;
    while d < f.drop_locals.len() {
        h = nc_h(nc_hs(h, f.drop_locals.get(d).name), f.drop_locals.get(d).id);
        d = d + 1;
    }
    var z: i64 = 0;
    while z < f.zeroize_locals.len() {
        h = nc_h(nc_h(h, f.zeroize_locals.get(z).id), f.zeroize_locals.get(z).val);
        z = z + 1;
    }
    if f.has_secret {
        // LF20: the frame wipe is part of the function's code
        h = nc_h(h, 88);
    }
    // BG56: @constant_time changes the code (no SIMD, vectorization or
    // writeback forms, the secret spill weights, the frame wipe) and
    // secret_values picks the values the allocator spills last and wipes
    if f.is_constant_time {
        h = nc_h(h, 89);
    }
    h = nc_hids(h, f.secret_values);
    h = nc_hids(h, f.workgroup_size);
    h = nc_heff(h, f.effects);
    if f.is_wrapping {
        h = nc_h(h, 1);
    }
    if f.is_deterministic {
        h = nc_h(h, 2);
    }
    if f.is_crashfree {
        h = nc_h(h, 4);
    }
    if f.is_no_alloc {
        h = nc_h(h, 8);
    }
    if f.is_medical {
        h = nc_h(h, 16);
    }
    if f.is_kernel {
        h = nc_h(h, 32);
    }
    if f.is_simd {
        h = nc_h(h, 64);
    }
    if f.is_interrupt {
        h = nc_h(h, 128);
    }
    if f.internal_conv {
        h = nc_h(h, 256);
    }
    h = nc_h(h, f.interrupt_vector);
    match f.gas_limit {
        OptU64::Some(x) => {
            h = nc_h(h, x);
        }
        OptU64::None => {
        }
    }
    return h;
}

// --- salts -----------------------------------------------------------------

/// Backend configuration that can change emitted bytes: target, output
/// format, and every pass toggle that feeds the machine layer.
fn nc_cfg_salt(g: &NatGen) -> i64 {
    // nc2: cold panic blocks, fused branches, element addresses and stack
    // probes (Nov 15) changed the bytes of most functions
    // nc3: branch relaxation, LEA adds, MIR constant folding (TG6/7/18);
    // --cpu picks instructions (TG7 BMI2, TG9 Zba/Zbb) and FID_NAT_ON=pie
    // changes absolute words (TG14)
    // nc4: selects (MI24), extension state (MI26), tail calls with stack
    // arguments (MI28) and allocation in holes (RA2), Nov 16
    // nc5: compares across a gap (RA19), test-bit branches (TG8), memory
    // operands (TG7) and ADDW / SUBW / MULW (TG9), Nov 16
    // nc6: load after store after allocation (TG17), the driver's --pie
    // (TG14), Nov 16
    // nc7: shifts by a constant as one instruction (TG1, MO_SHI), Nov 16
    // nc8: saves placed by dominators (RA12), `!`, `&&` / `||` and compares
    // of other blocks in branches (RA19), Nov 16
    // nc9: live-range splitting (RA4) and argument-register hints by
    // default (RA7), Nov 17
    // nc10: floats in float registers by default off Windows (MI25 /
    // OP17), no slot for a spilled rematerialized value (MI8), Nov 17
    // nc11: floats in float registers on --nat Windows too, its vector
    // registers xmm12..xmm15, spilled floats split (MI14), Nov 17
    // nc12: copy coalescing's second rule within one block, a second
    // split without the values whose pieces all spilled (RA4), Nov 17
    // nc13: free argument registers for ranges no call crosses (RA3),
    // Nov 17
    // nc14: callee-saved float registers (RA18), loads forwarded past
    // moves (TG17 ldfwdmov), `!` and EXT in fused branches (RA19), Nov 17
    // nc15: secret functions zero their scratch registers at each return
    // and make no sibling-call jumps; their secret values spill last
    // (LF20), Nov 17
    var s: str = "nc15;" + int_to_str(g.arch) + ";" + g_nat_cpu + ";" + env_or_empty("FID_NAT_ON") + ";" + int_to_str(g_nat_pie_req) + ";";
    if g.win {
        s = s + "w;";
    }
    // RA18: a program with tasks keeps floats off the callee-saved ones
    if g_ng_fcs_block {
        s = s + "fcsb;";
    }
    // L6C: with C function pointers every CallPtr goes through a stub
    if g_ng_cfp_on {
        s = s + "cfp;";
    }
    if g.mac {
        s = s + "m;";
    }
    // CT6: a Windows image with DWARF has line rows (ng_dbg_lines_ok)
    if g.win && ng_dbg_win_dwarf() {
        s = s + "wdwarf;";
    }
    // RA14's fast allocator and TG19's --size change the bytes too
    if ng_fast_alloc_on() {
        s = s + "fast;";
    }
    if g_nat_size {
        s = s + "size;";
    }
    // CE8: under -g the variables get their own slots and a frame record
    if ng_dbg_frames_on() {
        s = s + "frames;";
    }
    s = s + env_or_empty("FID_NAT_MUTATE") + ";";
    // CS6/SP20: line rows (MO_LINE) can change a function's bytes, and an
    // entry carries the rows of the build that made it
    // (the input file, not its list of function names: nc_mod_salt
    // already covers the name set)
    s = s + "lines:" + g_nat_lines_file + ";";
    s = s + env_or_empty("FID_NAT_OFF") + ";" + env_or_empty("FID_NAT_LINES") + ";" + env_or_empty("FID_IROPT_OFF") + ";" + env_or_empty("FID_IROPT_ON") + ";" + env_or_empty("FID_RULES_ON") + ";" + env_or_empty("FID_RULES_OFF") + ";" + env_or_empty("FID_EGRAPH_OFF") + ";" + env_or_empty("FID_NAT_DEBUG") + ";" + env_or_empty("FID_VERIFY") + ";";
    var lp: str = env_or_empty("FID_LIBFACTS");
    if str_len(lp) > 0 {
        if p_file_exists(lp) {
            s = s + int_to_str(hash_source(p_file_read(lp)));
        }
    }
    // SP6: on by default, so an entry also names the compiler that made it
    // (another fid emits other bytes for the same function) and the profile
    // a --profile-use build lays blocks out by (OP15 / WP17)
    s = s + ";fid:" + int_to_str(inc_compiler_hash());
    if g_pgo_use_path != "" {
        if p_file_exists(g_pgo_use_path) {
            s = s + ";pgo:" + int_to_str(hash_source(p_file_read(g_pgo_use_path)));
        }
    }
    return hash_source(s);
}

/// Module state outside any one function that still steers its codegen:
/// struct layouts (field offsets), globals, externs, the dyn-dispatch
/// tables, the internal-convention set, and the full function-name set.
fn nc_mod_salt(g: &NatGen, m: &IrModule) -> i64 {
    var h: i64 = 1469598103934665603;
    var i: i64 = 0;
    while i < m.struct_layouts.len() {
        var sl: StructLayout = m.struct_layouts.get(i).layout;
        h = nc_hs(h, sl.name);
        h = nc_h(h, sl.size);
        h = nc_h(h, sl.align);
        if sl.repr_c {
            h = nc_h(h, 1);
        }
        if sl.packed_layout {
            h = nc_h(h, 2);
        }
        var f: i64 = 0;
        while f < sl.fields.len() {
            var fd: StringIrTypeOffset = sl.fields.get(f);
            h = nc_hty(nc_h(nc_hs(h, fd.name), fd.offset), fd.ty);
            f = f + 1;
        }
        i = i + 1;
    }
    var gi: i64 = 0;
    while gi < m.globals.len() {
        h = nc_hty(nc_hs(h, m.globals.get(gi).name), m.globals.get(gi).ty);
        gi = gi + 1;
    }
    var ei: i64 = 0;
    while ei < m.extern_functions.len() {
        var ef: StringVecIrType = m.extern_functions.get(ei);
        h = nc_hs(h, ef.name);
        h = nc_hty(h, ef.ret);
        var p: i64 = 0;
        while p < ef.params.len() {
            h = nc_hty(h, ef.params.get(p));
            p = p + 1;
        }
        ei = ei + 1;
    }
    var ed: i64 = 0;
    while ed < m.extern_decls.len() {
        var d: ExternDecl = m.extern_decls.get(ed);
        h = nc_hs(nc_hs(nc_h(h, d.params.len()), d.pledge_name), d.c_name);
        ed = ed + 1;
    }
    var cb: i64 = 0;
    while cb < m.c_callbacks.len() {
        h = nc_hs(h, m.c_callbacks.get(cb));
        cb = cb + 1;
    }
    var tm: i64 = 0;
    while tm < m.trait_methods.len() {
        var t: StringVecStr = m.trait_methods.get(tm);
        h = nc_hs(h, t.name);
        var q: i64 = 0;
        while q < t.items.len() {
            h = nc_hs(h, t.items.get(q));
            q = q + 1;
        }
        tm = tm + 1;
    }
    var ti: i64 = 0;
    while ti < m.trait_impls.len() {
        var t2: StringVecStr = m.trait_impls.get(ti);
        h = nc_hs(h, t2.name);
        var q2: i64 = 0;
        while q2 < t2.items.len() {
            h = nc_hs(h, t2.items.get(q2));
            q2 = q2 + 1;
        }
        ti = ti + 1;
    }
    var ls: i64 = 0;
    while ls < m.linear_structs.len() {
        h = nc_hs(h, m.linear_structs.get(ls));
        ls = ls + 1;
    }
    var fi: i64 = 0;
    while fi < m.functions.len() {
        h = nc_hs(h, m.functions.get(fi).name);
        if m.functions.get(fi).func.internal_conv {
            h = nc_h(h, 1);
        }
        fi = fi + 1;
    }
    return h;
}

// --- symbolic label identities ---------------------------------------------

fn nc_lid(g: &mut NatGen, label: i64, id: str) {
    HashMap_insert(g.label_id, int_to_str(label), id);
}

/// label -> identity, for every label a function's fixups can legally point
/// at: other functions, string/data blobs, and the backend's singletons.
/// Intra-function labels are handled by offset at capture time.
fn nc_label_ids(g: &mut NatGen) {
    var i: i64 = 0;
    while i < g.fn_label_names.len() {
        var fn2: str = g.fn_label_names.get(i);
        nc_lid(g, HashMap_get(g.fn_labels, fn2), "F:" + fn2);
        i = i + 1;
    }
    var j: i64 = 0;
    while j < g.strs.len() {
        nc_lid(g, HashMap_get(g.str_labels, g.strs.get(j)), "S:" + g.strs.get(j));
        j = j + 1;
    }
    var k: i64 = 0;
    while k < g.globs.len() {
        nc_lid(g, HashMap_get(g.glob_labels, g.globs.get(k)), "G:glob:" + g.globs.get(k));
        k = k + 1;
    }
    nc_lid(g, g.entry_label, "G:entry");
    nc_lid(g, g.start_sp_label, "G:start_sp");
    nc_lid(g, g.fn_table_label, "G:fn_table");
    nc_lid(g, g.names_label, "G:names");
    nc_lid(g, g.code_end_label, "G:code_end");
    nc_lid(g, g.tramp_label, "G:tramp");
    var p: i64 = 0;
    while p < g.panic_labels.len() {
        nc_lid(g, g.panic_labels.get(p), "G:panic:" + int_to_str(p));
        p = p + 1;
    }
    var w: i64 = 0;
    while w < g.win_slot_labels.len() {
        nc_lid(g, g.win_slot_labels.get(w), "G:winslot:" + int_to_str(w));
        w = w + 1;
    }
    nc_lid(g, g.win_tls_label, "G:win_tls");
    nc_lid(g, g.win_imp_label, "G:win_imp");
    nc_lid(g, g.win_imp_end, "G:win_imp_end");
    nc_lid(g, g.win_iat_label, "G:win_iat");
    nc_lid(g, g.win_iat_end, "G:win_iat_end");
}

/// Singleton identity -> this run's label. 0 when that label does not
/// exist on this target (the fixup can only have referenced one that did).
fn nc_singleton(g: &mut NatGen, id: str) -> i64 {
    if id == "G:entry" {
        return g.entry_label;
    }
    if id == "G:start_sp" {
        return g.start_sp_label;
    }
    if id == "G:fn_table" {
        return g.fn_table_label;
    }
    if id == "G:names" {
        return g.names_label;
    }
    if id == "G:code_end" {
        return g.code_end_label;
    }
    if id == "G:tramp" {
        return g.tramp_label;
    }
    if id == "G:win_tls" {
        return g.win_tls_label;
    }
    if id == "G:win_imp" {
        return g.win_imp_label;
    }
    if id == "G:win_imp_end" {
        return g.win_imp_end;
    }
    if id == "G:win_iat" {
        return g.win_iat_label;
    }
    if id == "G:win_iat_end" {
        return g.win_iat_end;
    }
    if str_starts_with(id, "G:panic:") {
        var n: i64 = str_parse_int(str_slice(id, 8, str_len(id)));
        if n >= 0 && n < g.panic_labels.len() {
            return g.panic_labels.get(n);
        }
        return 0;
    }
    if str_starts_with(id, "G:winslot:") {
        var n2: i64 = str_parse_int(str_slice(id, 10, str_len(id)));
        if n2 >= 0 && n2 < g.win_slot_labels.len() {
            return g.win_slot_labels.get(n2);
        }
        return 0;
    }
    if str_starts_with(id, "G:glob:") {
        var nm: str = str_slice(id, 7, str_len(id));
        if HashMap_contains(g.glob_labels, nm) {
            return HashMap_get(g.glob_labels, nm);
        }
        return 0;
    }
    return 0;
}

// --- capture / replay ------------------------------------------------------

fn nc_hit_at(g: &NatGen, name: str) -> i64 {
    if !g.nc_on {
        return 0;
    }
    if HashMap_contains(g.nc_hit, name) {
        return HashMap_get(g.nc_hit, name);
    }
    return 0;
}

/// Key the function under and return its cache entry index + 1 on a hit
/// (same content key), 0 on a miss. The key is recorded either way — the
/// emit path uses it for the entry it captures. SP6: a hit is an entry
/// nc_validate kept (its key, and what it took for granted of the
/// functions it refers to, still hold); it runs at the first lookup.
fn nc_lookup(g: &mut NatGen, f: &IrFunction, m: &IrModule) -> i64 {
    if !g.nc_on {
        return 0;
    }
    if g_nc_valid == 0 {
        nc_validate(g, m);
    }
    var key: i64 = 0;
    if g_nc_cur_key != 0 && HashMap_contains(g_nc_cur_key, f.name) {
        key = HashMap_get(g_nc_cur_key, f.name);
    } else {
        key = nc_fn_hash(f);
    }
    HashMap_insert(g.nc_key, f.name, key);
    if HashMap_contains(g_nc_valid, f.name) {
        var ix: i64 = HashMap_get(g_nc_valid, f.name);
        if ix != 0 && g.nc_old.get(ix - 1).key == key {
            return ix;
        }
    }
    return 0;
}

/// Panic-line stub labels get registered in label_id lazily: the ones a
/// function references are created during its own emit, after the map was
/// first built.
fn nc_sync_pl(g: &mut NatGen) {
    var i: i64 = 0;
    while i < g.pl_names.len() {
        var l: i64 = HashMap_get(g.pl_keys, g.pl_names.get(i));
        var lk: str = int_to_str(l);
        if !HashMap_contains(g.label_id, lk) {
            HashMap_insert(g.label_id, lk, "P:" + g.pl_names.get(i));
        }
        i = i + 1;
    }
}

/// A "P:which:line" target back to a live stub label, registering the stub
/// for emission like a fresh compile would have.
fn nc_pl_label(g: &mut NatGen, key: str) -> i64 {
    if HashMap_contains(g.pl_keys, key) {
        return HashMap_get(g.pl_keys, key);
    }
    var l: i64 = NatEnc_label(&mut g.e);
    HashMap_insert(g.pl_keys, key, l);
    g.pl_names.push(key);
    var ci: i64 = str_find(key, ":");
    g.pl_list.push(str_parse_int(str_slice(key, 0, ci)));
    g.pl_list.push(str_parse_int(str_slice(key, ci + 1, str_len(key))));
    g.pl_list.push(l);
    HashMap_insert(g.label_id, int_to_str(l), "P:" + key);
    return l;
}

/// Capture the just-emitted function at [base, code.len): its bytes and its
/// fixups with symbolic targets. Returns false (and stores nothing) when a
/// fixup points at a label with no describable identity.
fn nc_capture(g: &mut NatGen, rec: &NatFnRec, base: i64, fstart: i64, fold_key: str, lstart: i64, cstart: i64) -> bool {
    nc_sync_pl(g);
    var e: NcEntry = NcEntry {
        name: rec.name, key: HashMap_get(g.nc_key, rec.name), mir_len: rec.mir.len(), n_traps: 0, n_calls: 0, mask: HashMap_get(g.fn_mask, rec.name), bytes: Vec::new(), fixes: Vec::new(), edges: Vec::new(), refs: Vec::new(), fold_key: fold_key, regs: nc_log_of(rec.name), lrows: Vec::new(), cfi: Vec::new(), dvars: "", deps: Vec::new(), dep_masks: Vec::new(), dep_rr: Vec::new(), rr_self: nc_rr_of(g, rec.name), addrs: nc_addrs_of(rec.name), ft_self: 0, dep_ft: Vec::new(), entry_run: Vec::new(),
    };
    var end: i64 = g.e.code.len();
    g_nc_reemit.push(rec.name);
    // CS6/SP20: the rows its emission added, relative to its start
    var li: i64 = lstart;
    while li + 2 < g.lrows.len() {
        e.lrows.push(g.lrows.get(li) - base);
        e.lrows.push(g.lrows.get(li + 1));
        e.lrows.push(g.lrows.get(li + 2));
        // DB1: a row against another file (code inlined from it) holds
        // this build's index of that file, which a later build need not
        // share (a replay writes every row against the function's own):
        // such a function is not stored, it is emitted again each build
        var lw: i64 = g.lrows.get(li + 2);
        if (lw & 1) == 0 && lw != 2 * g_nat_line_file_ix {
            return false;
        }
        li = li + 3;
    }
    var ci: i64 = cstart;
    while ci + 2 < g.cfi_rows.len() {
        e.cfi.push(g.cfi_rows.get(ci) - base);
        var c1: i64 = g.cfi_rows.get(ci + 1);
        if c1 >= 0 {
            c1 = c1 - base;
        }
        e.cfi.push(c1);
        e.cfi.push(g.cfi_rows.get(ci + 2) - base);
        ci = ci + 3;
    }
    if g_ng_dbg_vars != 0 && HashMap_contains(g_ng_dbg_vars, rec.name) {
        e.dvars = HashMap_get(g_ng_dbg_vars, rec.name);
    }
    var i: i64 = base;
    while i < end {
        e.bytes.push(g.e.code.get(i));
        i = i + 1;
    }
    var k: i64 = 0;
    while k < rec.mir.len() {
        var mop: i64 = rec.mir.get(k).op;
        if mop == MO_TRAP {
            e.n_traps = e.n_traps + 1;
        }
        if mop == MO_CALL {
            e.n_calls = e.n_calls + 1;
            var lk: str = int_to_str(rec.mir.get(k).i0);
            if HashMap_contains(g.label_fn, lk) {
                e.edges.push(HashMap_get(g.label_fn, lk));
            }
        }
        k = k + 1;
    }
    // CS6 part 3: the entry run, as ng_mir_enters_noret reads it
    var ek: i64 = 0;
    var e_going: bool = true;
    while e_going && ek < rec.mir.len() {
        var em: MInst = rec.mir.get(ek);
        if em.op == MO_TRAP {
            e.entry_run.push("!");
            e_going = false;
        } else if em.op == MO_EPILOGUE || mi_is_br(em.op) {
            e_going = false;
        } else {
            if em.op == MO_CALL {
                var elk: str = int_to_str(em.i0);
                if HashMap_contains(g.label_fn, elk) {
                    e.entry_run.push(HashMap_get(g.label_fn, elk));
                } else {
                    e.entry_run.push("?");
                }
            }
            ek = ek + 1;
        }
    }
    var f: i64 = fstart;
    var ok: bool = true;
    while f < g.e.fixups.len() {
        var fx: NatFix = g.e.fixups.get(f);
        if fx.pos >= base && fx.pos < end {
            var lk2: str = int_to_str(fx.label);
            if HashMap_contains(g.label_id, lk2) {
                var id: str = HashMap_get(g.label_id, lk2);
                var tk: i64 = 3;
                var tstr: str = id;
                if str_starts_with(id, "F:") {
                    tk = 1;
                    tstr = str_slice(id, 2, str_len(id));
                    e.refs.push(tstr);
                } else {
                    if str_starts_with(id, "S:") {
                        tk = 2;
                        tstr = str_slice(id, 2, str_len(id));
                    }
                }
                e.fixes.push(NcFix {
                    pos: fx.pos - base, kind: fx.kind, tkind: tk, toff: 0, tstr: tstr
                });
            } else {
                var loff: i64 = g.e.labels.get(fx.label);
                if loff >= base && loff < end {
                    e.fixes.push(NcFix {
                        pos: fx.pos - base, kind: fx.kind, tkind: 0, toff: loff - base, tstr: ""
                    });
                } else {
                    ok = false;
                }
            }
        }
        f = f + 1;
    }
    // SP6: what the code took for granted about each function it refers to
    nc_note_deps(g, &mut e);
    // SP20: its escape summary and the ones it read (MI28)
    nc_note_ft(g, &mut e);
    if ok {
        g.nc_new.push(e);
    }
    return ok;
}

/// SP6: the size of `name`'s struct result in registers in this build
/// (ng_rr_plan's g.rr_size), 0 when it goes through memory.
fn nc_rr_of(g: &NatGen, name: str) -> i64 {
    if !HashMap_contains(g.fn_labels, name) {
        return 0;
    }
    var l: i64 = HashMap_get(g.fn_labels, name);
    if HashMap_contains_i(g.rr_size, l) {
        return HashMap_get_i(g.rr_size, l);
    }
    return 0;
}

/// SP6: the deps of entry `e` (its function refs, once each, in order)
/// with the clobber mask its allocation saw for each (ng_label_mask; the
/// function's own is its final mask, more than its allocation assumed for
/// a call to itself, which was every register) and each one's struct
/// result in registers.
fn nc_note_deps(g: &NatGen, e: &mut NcEntry) {
    var seen: i64 = HashMap_new();
    var i: i64 = 0;
    while i < e.refs.len() {
        var d: str = e.refs.get(i);
        if !HashMap_contains(seen, d) && HashMap_contains(g.fn_labels, d) {
            HashMap_insert(seen, d, 1);
            e.deps.push(d);
            e.dep_masks.push(ng_label_mask(g, HashMap_get(g.fn_labels, d)));
            e.dep_rr.push(nc_rr_of(g, d));
        }
        i = i + 1;
    }
}

/// SP20: entry e's MI28 escape summary (settled now when no analysis has
/// asked for it yet: a later build may compile a caller of it again while
/// replaying it) and, per dep, the summary this build's analyses settled
/// for it (0: none was read). Nothing with FID_NAT_OFF=tailframe.
fn nc_note_ft(g: &NatGen, e: &mut NcEntry) {
    var on: bool = ng_on("tailframe") && HashMap_contains(g.fn_labels, e.name);
    var esc: i64 = 0;
    if on {
        esc = ng_ft_esc_map(g);
        var lab: i64 = HashMap_get(g.fn_labels, e.name);
        var key: str = int_to_str(lab);
        if !HashMap_contains(esc, key) {
            var pend: Vec<i64> = Vec::new();
            pend.push(lab);
            ng_ft_settle(g, esc, &pend);
        }
        if HashMap_contains(esc, key) {
            e.ft_self = HashMap_get(esc, key);
        }
    }
    var i: i64 = 0;
    while i < e.deps.len() {
        var df: i64 = 0;
        if on && HashMap_contains(g.fn_labels, e.deps.get(i)) {
            var dk: str = int_to_str(HashMap_get(g.fn_labels, e.deps.get(i)));
            if HashMap_contains(esc, dk) {
                df = HashMap_get(esc, dk);
            }
        }
        e.dep_ft.push(df);
        i = i + 1;
    }
}

/// SP20: at the replay of hit e, do the summaries it read of the functions
/// compiled again in this build (nc_deps_ok checks the replayed ones)
/// still hold? Each is settled now when no analysis has yet.
fn nc_ft_hold(g: &NatGen, e: &NcEntry) -> bool {
    if !ng_on("tailframe") {
        return true;
    }
    var i: i64 = 0;
    while i < e.deps.len() && i < e.dep_ft.len() {
        var d: str = e.deps.get(i);
        var df: i64 = e.dep_ft.get(i);
        var kept: bool = g_nc_valid != 0 && HashMap_contains(g_nc_valid, d) && HashMap_get(g_nc_valid, d) != 0;
        if df != 0 && !kept && HashMap_contains(g.fn_labels, d) {
            var esc: i64 = ng_ft_esc_map(g);
            var lab: i64 = HashMap_get(g.fn_labels, d);
            var key: str = int_to_str(lab);
            if !HashMap_contains(esc, key) {
                var pend: Vec<i64> = Vec::new();
                pend.push(lab);
                ng_ft_settle(g, esc, &pend);
            }
            if !HashMap_contains(esc, key) || HashMap_get(esc, key) != df {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

/// Replay a cached function at the current position: bytes verbatim,
/// fixups re-registered against this run's label space. SP7: with `at`
/// >= 0, at that offset of the code already reserved (its slot of the
/// last build, nl_slot) instead.
fn nc_replay(g: &mut NatGen, e: &NcEntry, at: i64) -> str {
    var base: i64 = g.e.code.len();
    var i: i64 = 0;
    if at >= 0 {
        base = at;
        while i < e.bytes.len() {
            g.e.code.set(at + i, e.bytes.get(i));
            i = i + 1;
        }
    } else {
        while i < e.bytes.len() {
            g.e.code.push(e.bytes.get(i));
            i = i + 1;
        }
    }
    var k: i64 = 0;
    while k < e.fixes.len() {
        var fx: NcFix = e.fixes.get(k);
        var tl: i64 = 0;
        if fx.tkind == 0 {
            tl = NatEnc_label(&mut g.e);
            g.e.labels.set(tl, base + fx.toff);
        } else {
            if fx.tkind == 1 {
                tl = ng_fn_label(g, fx.tstr);
                if tl == 0 {
                    return "native cache: " + e.name + " references missing function " + fx.tstr;
                }
                if fx.kind == NATFIX_RV_JAL && nc_rv_jal_ra(e, fx.pos) {
                    // SP6: a short call (TG6, JAL ra): its callee must be
                    // placed already and in reach, as when it was recorded
                    var tpos: i64 = g.e.labels.get(tl);
                    var dl: i64 = tpos - (base + fx.pos);
                    if tpos < 0 || dl < 0 - 1048576 || dl >= 1048576 {
                        // (the image is made again without it: the end of
                        // ng_mir_finish; its fixup is left out meanwhile)
                        nc_give_up_callers(g, e.name);
                        k = k + 1;
                        continue;
                    }
                }
            } else {
                if fx.tkind == 2 {
                    tl = ng_str_label(g, fx.tstr);
                } else {
                    if str_starts_with(fx.tstr, "P:") {
                        tl = nc_pl_label(g, str_slice(fx.tstr, 2, str_len(fx.tstr)));
                    } else {
                        if str_starts_with(fx.tstr, "G:glob:") {
                            tl = ng_glob_label(g, str_slice(fx.tstr, 7, str_len(fx.tstr)));
                        } else {
                            tl = nc_singleton(g, fx.tstr);
                        }
                    }
                }
            }
            if tl == 0 {
                return "native cache: " + e.name + " has stale target " + fx.tstr;
            }
        }
        NatEnc_fix_at(&mut g.e, base + fx.pos, tl, fx.kind);
        k = k + 1;
    }
    // CS6/SP20: its debug rows, as its emission made them. Line rows only
    // when this build gives the function rows (nc_skel_fn), against its
    // file's index in this build (g_nat_line_file_ix, set from
    // nat_line_fn_file before the replay); a close row keeps its word.
    if g_nc_line_fns != 0 && HashMap_contains(g_nc_line_fns, e.name) && e.lrows.len() > 2 {
        var li: i64 = 0;
        var fw: i64 = 0;
        while li + 2 < e.lrows.len() {
            fw = e.lrows.get(li + 2);
            if (fw & 1) == 0 {
                fw = 2 * g_nat_line_file_ix;
            }
            g.lrows.push(base + e.lrows.get(li));
            g.lrows.push(e.lrows.get(li + 1));
            g.lrows.push(fw);
            li = li + 3;
        }
        g.lrow_open = (fw & 1) == 0;
    }
    var ci: i64 = 0;
    while ci + 2 < e.cfi.len() {
        g.cfi_rows.push(base + e.cfi.get(ci));
        var c1: i64 = e.cfi.get(ci + 1);
        if c1 >= 0 {
            c1 = base + c1;
        }
        g.cfi_rows.push(c1);
        g.cfi_rows.push(base + e.cfi.get(ci + 2));
        ci = ci + 3;
    }
    if str_len(e.dvars) > 0 {
        if g_ng_dbg_vars == 0 {
            g_ng_dbg_vars = HashMap_new();
        }
        HashMap_insert(g_ng_dbg_vars, e.name, e.dvars);
    }
    return "";
}

/// SP6: is the RISC-V word at `pos` of entry e a JAL ra (a short call, TG6
/// rv_call_near), not a JAL zero (a jump)?
fn nc_rv_jal_ra(e: &NcEntry, pos: i64) -> bool {
    if pos < 0 || pos + 1 >= e.bytes.len() {
        return false;
    }
    var w: i64 = e.bytes.get(pos) | (e.bytes.get(pos + 1) << 8);
    return ((w >> 7) & 31) == RV_RA;
}

/// A cache hit's record: a synthetic MIR with the same trap/call counts and
/// the same call edges, so the postorder and the cold splitter see the same
/// shape; allocation/emission is skipped for it.
fn nc_skel_fn(g: &mut NatGen, name: str, ix: i64, is_ct: bool) {
    // CS6/SP20: its line rows' file, registered where ng_gen_function
    // would have registered it (the file table's order is the image's)
    var lon: bool = ng_dbg_lines_ok(g) && ng_on("debug") && HashMap_contains(g.line_fns, name);
    var lix: i64 = 0;
    if !lon && ng_dbg_lines_ok(g) && ng_on("debug") && str_len(g_nat_lines_file) > 0 && str_len(ir_fn_src_file(name)) > 0 {
        lon = true;
        lix = nat_line_file_index(ir_fn_src_file(name));
    }
    nat_line_fn_set(name, lix);
    if lon {
        if g_nc_line_fns == 0 {
            g_nc_line_fns = HashMap_new();
        }
        HashMap_insert(g_nc_line_fns, name, 1);
    }
    var e: NcEntry = g.nc_old.get(ix - 1);
    // SP6/SP20: what the recording asked for, in its order, first (2g.82:
    // before the skeleton's call edges below, which asked for their labels
    // first: a callee the recording asked for later, after a string or
    // another function, was queued earlier, so a hit image placed the
    // functions in another order than a build without the cache; 25,528
    // bytes of hello differed from pe_dbg_free on)
    nc_log_replay(g, &e.regs);
    var rec2: NatFnRec = NatFnRec {
        name: name, mir: Vec::new(), nvreg: 0, base_frame: 0, slots: Vec::new(), is_ct: false, sret_v: 0 - 1, sret_size: 0, secret: false
    };
    var i: i64 = 0;
    while i < e.n_traps {
        rec2.mir.push(MInst {
            op: MO_TRAP, r0: 0, r1: 0, r2: 0, i0: 0, i1: 0, i2: 0
        });
        i = i + 1;
    }
    var c: i64 = 0;
    while c < e.edges.len() {
        var l: i64 = ng_fn_label(g, e.edges.get(c));
        rec2.mir.push(MInst {
            op: MO_CALL, r0: 0, r1: 0, r2: 0, i0: l, i1: 0, i2: 0
        });
        c = c + 1;
    }
    var pc: i64 = e.n_calls - e.edges.len();
    while pc > 0 {
        rec2.mir.push(MInst {
            op: MO_CALL, r0: 0, r1: 0, r2: 0, i0: 0, i1: 0, i2: 0
        });
        pc = pc - 1;
    }
    while rec2.mir.len() < e.mir_len {
        rec2.mir.push(MInst {
            op: MO_LI, r0: 0, r1: 0, r2: 0, i0: 0, i1: 0, i2: 0
        });
    }
    g.recs.push(rec2);
    var r: i64 = 0;
    while r < e.refs.len() {
        var rl: i64 = ng_fn_label(g, e.refs.get(r));
        r = r + 1;
    }
    // BG44: a @constant_time function (or one a @constant_time caller may
    // call, ng_ct_exempt_callee) replayed from the cache is still one:
    // ng_gen_function records its label in ct_labels, so without this a
    // recompiled @constant_time caller of a cached callee failed the
    // machine-level check ("not @constant_time")
    if is_ct || ng_ct_exempt_callee(name) {
        HashMap_insert_i(g.ct_labels, ng_fn_label(g, name), 1);
    }
    HashMap_insert(g.nc_hit, name, ix);
    g.nc_hit_names.push(name);
}

// --- disk format ------------------------------------------------------------
//
// FIDFNC1
// <salt>
// <count>
// then per entry: header line, hex name, space-separated bytes,
// per-fixup "pos kind tkind toff hex(tstr)", hex edge names, hex ref names,
// hex fold key.

// CS6 cache file format v2: a binary byte vector (the text/hex format
// cost ~20 s to parse at -O0 for a 550 KB file). Magic + version + salt,
// then entries through the shared byte codec in compiler::ast_ser.
fn nc_wentry(b: &mut AwBuf, e: NcEntry) {
    aw_i64(b, e.key);
    aw_i64(b, e.mir_len);
    aw_i64(b, e.n_traps);
    aw_i64(b, e.n_calls);
    aw_i64(b, e.mask);
    aw_str(b, e.name);
    aw_i64(b, e.bytes.len());
    var i: i64 = 0;
    while i < e.bytes.len() {
        aw_u8(b, e.bytes.get(i));
        i = i + 1;
    }
    aw_i64(b, e.fixes.len());
    var k: i64 = 0;
    while k < e.fixes.len() {
        var fx: NcFix = e.fixes.get(k);
        aw_i64(b, fx.pos);
        aw_i64(b, fx.kind);
        aw_i64(b, fx.tkind);
        aw_i64(b, fx.toff);
        aw_str(b, fx.tstr);
        k = k + 1;
    }
    aw_strs(b, e.edges);
    aw_strs(b, e.refs);
    aw_str(b, e.fold_key);
    aw_strs(b, e.regs);
    // (4: debug rows, CS6/SP20)
    aw_i64(b, e.lrows.len());
    var li: i64 = 0;
    while li < e.lrows.len() {
        aw_i64(b, e.lrows.get(li));
        li = li + 1;
    }
    aw_i64(b, e.cfi.len());
    var ci: i64 = 0;
    while ci < e.cfi.len() {
        aw_i64(b, e.cfi.get(ci));
        ci = ci + 1;
    }
    aw_str(b, e.dvars);
    // (7: its entry run, CS6 part 3)
    aw_strs(b, e.entry_run);
    // (5: what it took for granted of its refs, its own result convention
    // and the functions whose address it takes, SP6)
    aw_strs(b, e.deps);
    aw_i64(b, e.dep_masks.len());
    var di: i64 = 0;
    while di < e.dep_masks.len() {
        aw_i64(b, e.dep_masks.get(di));
        aw_i64(b, e.dep_rr.get(di));
        di = di + 1;
    }
    aw_i64(b, e.rr_self);
    aw_strs(b, e.addrs);
    // (6: its escape summary and the ones it read, SP20)
    aw_i64(b, e.ft_self);
    aw_i64(b, e.dep_ft.len());
    var fi: i64 = 0;
    while fi < e.dep_ft.len() {
        aw_i64(b, e.dep_ft.get(fi));
        fi = fi + 1;
    }
}

fn nc_rentry(r: &mut ArBuf) -> NcEntry {
    var key: i64 = ar_i64(r);
    var mir_len: i64 = ar_i64(r);
    var n_traps: i64 = ar_i64(r);
    var n_calls: i64 = ar_i64(r);
    var mask: i64 = ar_i64(r);
    var name: str = ar_str(r);
    var nb: i64 = ar_i64(r);
    var bytes: Vec<i64> = Vec::new();
    var bi: i64 = 0;
    while bi < nb {
        bytes.push(ar_u8(r));
        bi = bi + 1;
    }
    var nf: i64 = ar_i64(r);
    var fixes: Vec<NcFix> = Vec::new();
    var fi: i64 = 0;
    while fi < nf {
        fixes.push(NcFix {
            pos: ar_i64(r), kind: ar_i64(r), tkind: ar_i64(r), toff: ar_i64(r), tstr: ar_str(r),
        });
        fi = fi + 1;
    }
    var edges: Vec<str> = ar_strs(r);
    var refs: Vec<str> = ar_strs(r);
    var fold: str = ar_str(r);
    var regs: Vec<str> = ar_strs(r);
    var lrows: Vec<i64> = Vec::new();
    var nl: i64 = ar_i64(r);
    var li: i64 = 0;
    while li < nl && r.ok {
        lrows.push(ar_i64(r));
        li = li + 1;
    }
    var cfi: Vec<i64> = Vec::new();
    var nc: i64 = ar_i64(r);
    var ci: i64 = 0;
    while ci < nc && r.ok {
        cfi.push(ar_i64(r));
        ci = ci + 1;
    }
    var dvars: str = ar_str(r);
    var entry_run: Vec<str> = ar_strs(r);
    var deps: Vec<str> = ar_strs(r);
    var dep_masks: Vec<i64> = Vec::new();
    var dep_rr: Vec<i64> = Vec::new();
    var nd: i64 = ar_i64(r);
    var di: i64 = 0;
    while di < nd && r.ok {
        dep_masks.push(ar_i64(r));
        dep_rr.push(ar_i64(r));
        di = di + 1;
    }
    var rr_self: i64 = ar_i64(r);
    var addrs: Vec<str> = ar_strs(r);
    var ft_self: i64 = ar_i64(r);
    var dep_ft: Vec<i64> = Vec::new();
    var nft: i64 = ar_i64(r);
    var fti: i64 = 0;
    while fti < nft && r.ok {
        dep_ft.push(ar_i64(r));
        fti = fti + 1;
    }
    // (a damaged entry whose lists disagree is read as not usable)
    if dep_masks.len() != deps.len() || dep_ft.len() != deps.len() {
        r.ok = false;
    }
    return NcEntry {
        name: name, key: key, mir_len: mir_len, n_traps: n_traps, n_calls: n_calls, mask: mask, bytes: bytes, fixes: fixes, edges: edges, refs: refs, fold_key: fold, regs: regs, lrows: lrows, cfi: cfi, dvars: dvars, deps: deps, dep_masks: dep_masks, dep_rr: dep_rr, rr_self: rr_self, addrs: addrs, ft_self: ft_self, dep_ft: dep_ft, entry_run: entry_run,
    };
}

fn nc_load(g: &mut NatGen) {
    var vb: Vec<i64> = p_file_read_bytes(g.nc_path);
    if vb.len() < 32 {
        return;
    }
    var r: ArBuf = arbuf_new(vb);
    if ar_i64(&mut r) != 4473415 {
        return;
    }
    if ar_i64(&mut r) != 7 {
        return;
    }
    if ar_i64(&mut r) != g.nc_salt {
        return;
    }
    var count: i64 = ar_i64(&mut r);
    var i: i64 = 0;
    while i < count && r.ok {
        var e: NcEntry = nc_rentry(&mut r);
        if !r.ok {
            return;
        }
        g.nc_old.push(e);
        HashMap_insert(g.nc_ix, e.name, g.nc_old.len());
        i = i + 1;
    }
}

/// Write back the entries that were used or freshly captured -- hits stay
/// live in the cache, misses get replaced, dead functions drop out.
fn nc_finish(g: &mut NatGen) {
    if !g.nc_on {
        return;
    }
    // SP18: the file is written only when its entries change: something
    // was compiled, or a stored entry was not used (it drops out). A build
    // that hit every entry it had leaves the file as it is.
    var changed: bool = g.nc_new.len() > 0 || g.nc_hit_names.len() != g.nc_old.len();
    // (p_file_exists is i64 to the type checker: tested alone in an `if`)
    var write: bool = false;
    if g.nc_path != NC_MEM {
        write = true;
        if !changed {
            if p_file_exists(g.nc_path) {
                write = false;
            }
        }
    }
    var b: AwBuf = awbuf_new();
    var i: i64 = 0;
    var j: i64 = 0;
    if write {
        aw_i64(&mut b, 4473415);
        aw_i64(&mut b, 7);
        // (3: entries carry their label log, SP6; 4: their debug rows, CS6;
        // 5: their deps, result convention and addresses taken, SP6; 6:
        // their escape summaries, SP20; 7: their entry runs, CS6 part 3)
        aw_i64(&mut b, g.nc_salt);
        aw_i64(&mut b, g.nc_new.len() + g.nc_hit_names.len());
        while i < g.nc_hit_names.len() {
            var ix: i64 = HashMap_get(g.nc_hit, g.nc_hit_names.get(i));
            nc_wentry(&mut b, g.nc_old.get(ix - 1));
            i = i + 1;
        }
        while j < g.nc_new.len() {
            nc_wentry(&mut b, g.nc_new.get(j));
            j = j + 1;
        }
    }
    // SP7: the same entries stay in this process for its next build
    // (`fid serve`): no file read then, and none written for "mem"
    var keep: Vec<NcEntry> = Vec::new();
    i = 0;
    while i < g.nc_hit_names.len() {
        keep.push(g.nc_old.get(HashMap_get(g.nc_hit, g.nc_hit_names.get(i)) - 1));
        i = i + 1;
    }
    j = 0;
    while j < g.nc_new.len() {
        keep.push(g.nc_new.get(j));
        j = j + 1;
    }
    if g_nat_stats {
        var src: str = "none";
        if g_nc_src == 1 {
            src = "file";
        } else if g_nc_src == 2 {
            src = "memory";
        }
        var wr: str = "unchanged";
        if write {
            wr = "written";
        } else if g.nc_path == NC_MEM {
            wr = "in memory";
        }
        p_eprint_str("[fncache] entries from " + src + ", " + int_to_str(g.nc_hit_names.len()) + " hits, " + int_to_str(g.nc_new.len()) + " compiled, cache " + wr + "\n");
        // CB3: which functions went through allocation and emission again
        if g_nc_reemit.len() > 0 {
            p_eprint_str("[fncache] re-emitted: " + str_join(g_nc_reemit, ", ") + "\n");
        }
        // SP6: entries whose code was the same but whose callees changed
        // what it took for granted (nc_validate), and the ones a first
        // attempt had to give up (nat_generate_image)
        if g_nc_stale.len() > 0 {
            p_eprint_str("[fncache] stale (a callee changed): " + str_join(g_nc_stale, ", ") + "\n");
        }
        if g_nc_retried.len() > 0 {
            p_eprint_str("[fncache] built again without: " + str_join(g_nc_retried, ", ") + "\n");
        }
    }
    g_nc_mem = keep;
    g_nc_mem_path = g.nc_path;
    g_nc_mem_salt = g.nc_salt;
    g_nc_mem_on = true;
    if write {
        p_file_write_vec(g.nc_path, b.bytes);
    }
}

// SP7: the per-function cache of this process's last native build, kept in
// memory (nc_finish) for the next one with the same cache path and salt
// (nc_start). FID_FNCACHE=mem keeps it only there (no file); a long-lived
// process (`fid serve`) can set g_nat_fncache_mem for that without the
// variable. Entries are keyed by content (nc_fn_hash), so a file another
// process changed in between does not make them wrong.
const NC_MEM: str = "mem";
var g_nc_mem_on: bool = false;
var g_nc_mem_path: str = "";
var g_nc_mem_salt: i64 = 0;
var g_nc_mem: Vec<NcEntry> = Vec::new();
/// SP7: the driver sets it to keep the cache in memory only (as
/// FID_FNCACHE=mem) when the variable names no file.
pub var g_nat_fncache_mem: bool = false;
/// SP7: where the last build's entries came from: 0 none, 1 the file,
/// 2 memory (a test reads it through nat_fncache_source).
var g_nc_src: i64 = 0;
/// CS6/SP20: the functions of a cache hit that get line rows in this build
/// (nc_skel_fn), a HashMap name -> 1 (0 before the first).
var g_nc_line_fns: i64 = 0;
/// CB3: the functions this build allocated and emitted with the cache on
/// (misses), in emission order.
var g_nc_reemit: Vec<str> = Vec::new();

pub fn nat_fncache_source() -> i64 {
    return g_nc_src;
}

/// CB3: the functions the last native build with the per-function cache
/// on emitted again (not replayed), for the driver to report.
pub fn nat_fncache_reemitted() -> Vec<str> {
    return g_nc_reemit;
}

/// Enable the cache when FID_FNCACHE names a file and the MIR path is the
/// one that will emit (the record/direct path has no per-function slice to
/// capture). The salt folds the whole backend configuration and module
/// layout; a mismatch makes every stored entry dead on arrival.
fn nc_start(g: &mut NatGen, m: &IrModule) {
    // SP6: on by default (nc_path_pick)
    var path: str = nc_path_pick();
    // SP7: nothing of this build's layout yet (nl_begin decides)
    nl_reset();
    g_nc_src = 0;
    g_nc_valid = 0;
    g_nc_cur_key = 0;
    g_nc_stale = Vec::new();
    g_nc_retry = Vec::new();
    g_nc_addrs = 0;
    if str_len(path) == 0 {
        return;
    }
    if !(NG_MIR && (ng_on("mir") || ng_x64(g))) {
        return;
    }
    g.nc_salt = nc_h(nc_cfg_salt(g), nc_mod_salt(g, m));
    g.nc_on = true;
    g_nc_line_fns = HashMap_new();
    g_nc_reemit = Vec::new();
    // SP6: this build's label logs (a long-lived process builds again)
    g_nc_logs = Vec::new();
    g_nc_log_at = 0;
    g_nc_log_on = false;
    g.nc_path = path;
    if g_nc_mem_on && g_nc_mem_path == path && g_nc_mem_salt == g.nc_salt {
        // SP7: the previous build of this process left them in memory
        var i: i64 = 0;
        while i < g_nc_mem.len() {
            var e: NcEntry = g_nc_mem.get(i);
            g.nc_old.push(e);
            HashMap_insert(g.nc_ix, e.name, g.nc_old.len());
            i = i + 1;
        }
        g_nc_src = 2;
        return;
    }
    if path != NC_MEM {
        if p_file_exists(path) {
            nc_load(g);
            g_nc_src = 1;
        }
    }
}

// ---------------------------------------------------------------------------
// SP6: the cache on by default, and hits that stay right when the
// functions they refer to change.
//
// A function's code depends on more than its own IR: the allocator keeps
// values in registers its callees do not clobber (IPRA: their masks), a
// call to a function whose struct result travels in registers (ME27 /
// LF24, ng_rr_plan) is made differently, and on RISC-V a call to a
// function placed within 1 MB before it is one JAL (TG6). Each entry keeps
// what its code took for granted (nc_note_deps): for each function it
// refers to, the mask its allocation saw and that function's result
// convention; its own result convention; the functions whose address it
// takes. Before the first hit (nc_lookup), nc_validate keeps the entries
// whose key matches and whose assumptions still hold, a greatest fixpoint
// over those: a dep with a known mask that is kept has that mask (one
// outside the program: a library's recorded mask, WP20); a dep's result
// convention is the kept entry's, and a dep compiled again must not be
// able to take one (nc_may_rr). What is known only later is checked then:
// the mask of a dep compiled again, after its allocation (nc_masks_hold,
// at the replay); a function with its result in registers whose address
// is now taken or whose name a string now names (ng_rr_plan); a short call
// whose callee is now out of reach (nc_replay). The image is then made
// again without those entries and what relied on them
// (nc_give_up_callers, nat_generate_image), at most twice, the last time
// with no hits at all.
// ---------------------------------------------------------------------------

/// What a build that must be made again returns (never shown: the last
/// attempt has no hits, so nothing asks for another).
const NC_RETRY: str = "native backend: function cache: build again";
/// name -> index into g.nc_old + 1 of the entries kept (0: not kept), made
/// at the first lookup of a build (the map itself 0 before).
var g_nc_valid: i64 = 0;
/// name -> this build's content key of the functions nc_validate keyed.
var g_nc_cur_key: i64 = 0;
/// The entries whose key matched but whose deps no longer hold.
var g_nc_stale: Vec<str> = Vec::new();
/// The hits this attempt found not to fit (gone without in the next one).
var g_nc_retry: Vec<str> = Vec::new();
/// Over the attempts at one image: the entries gone without (name -> 1;
/// 0: none), all of them, and their names for `--stats`.
var g_nc_deny: i64 = 0;
var g_nc_deny_all: bool = false;
var g_nc_retried: Vec<str> = Vec::new();
/// name -> the functions whose address its recorded MIR takes, joined by
/// "," (ng_rr_plan; 0 before), for its entry.
var g_nc_addrs: i64 = 0;
/// SP6: the cache file the driver picked for this build ("": the `-o` of
/// the command line decides, nc_path_pick).
pub var g_nat_fncache_path: str = "";

/// SP6: the cache file of this build, "" for no cache. FID_FNCACHE wins: a
/// file, `mem` (this process's memory only), or 0 / off / no / none / false
/// (no cache). Else `fid serve`'s memory (g_nat_fncache_mem). Else, by
/// default, the driver's choice (g_nat_fncache_path) or
/// `<output>.fides-fncache` beside the `-o` output of `fid emit` / `build`
/// (as pe_ir's B5 cache sits beside its output). No default cache with
/// --no-cache, --no-fncache or FIDES_NO_CACHE, for an object file, or for
/// a build whose output reports on each function it compiles: --stats,
/// dump-mir (g_nat_dump, FID_NAT_DUMP), FID_VERIFY, FID_NAT_PAR (whose
/// workers do not run with the cache).
fn nc_path_pick() -> str {
    var v: str = env_or_empty("FID_FNCACHE");
    if v == "0" || v == "off" || v == "no" || v == "none" || v == "false" {
        return "";
    }
    if str_len(v) > 0 {
        return v;
    }
    if g_nat_fncache_mem {
        return NC_MEM;
    }
    if str_len(env_or_empty("FIDES_NO_CACHE")) > 0 || nc_argv_has("--no-cache") || nc_argv_has("--no-fncache") {
        return "";
    }
    if g_nat_object || g_nat_stats || ng_verify_on() || str_len(g_nat_dump) > 0 || str_len(env_or_empty("FID_NAT_DUMP")) > 0 || ng_par_workers() > 0 {
        return "";
    }
    if str_len(g_nat_fncache_path) > 0 {
        return g_nat_fncache_path;
    }
    var out: str = nc_argv_output();
    if str_len(out) == 0 {
        return "";
    }
    return out + ".fides-fncache";
}

fn nc_argv_has(flag: str) -> bool {
    var n: i64 = argv_count();
    var i: i64 = 1;
    while i < n {
        if argv_at(i) == flag {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The `-o` of an `emit` / `build` command line ("" for another command,
/// or none given).
fn nc_argv_output() -> str {
    var n: i64 = argv_count();
    if n < 2 {
        return "";
    }
    var cmd: str = argv_at(1);
    if cmd != "emit" && cmd != "build" {
        return "";
    }
    var i: i64 = 2;
    while i + 1 < n {
        if argv_at(i) == "-o" {
            return argv_at(i + 1);
        }
        i = i + 1;
    }
    return "";
}

fn nc_denied(name: str) -> bool {
    if g_nc_deny_all {
        return true;
    }
    return g_nc_deny != 0 && HashMap_contains(g_nc_deny, name);
}

/// This build's content key of function `name`, as the driver's loop keys
/// it (after IrFunction_form_switches); 0 when the program has none.
fn nc_cur_key(m: &IrModule, name: str) -> i64 {
    if g_nc_cur_key == 0 {
        g_nc_cur_key = HashMap_new();
    }
    if HashMap_contains(g_nc_cur_key, name) {
        return HashMap_get(g_nc_cur_key, name);
    }
    var k: i64 = 0;
    match IrModule_get_function(m, name) {
        OptIrFunction::Some(f0) => {
            var f: IrFunction = f0;
            if ir_switch_on() {
                IrFunction_form_switches(&mut f);
            }
            k = nc_fn_hash(&f);
        }
        OptIrFunction::None => {
        }
    }
    HashMap_insert(g_nc_cur_key, name, k);
    return k;
}

/// Could ng_rr_plan give function `name` its struct result in registers?
/// A superset: the hidden result parameter's shape (as ng_gen_function
/// finds sret_v), not @constant_time, and a name ng_rr_name_ok allows
/// (g.named_seen only grows while functions are recorded, so a name it
/// refuses later is allowed here).
fn nc_may_rr(g: &NatGen, m: &IrModule, name: str) -> bool {
    if !ng_on("retregs") {
        return false;
    }
    match IrModule_get_function(m, name) {
        OptIrFunction::Some(f) => {
            if f.is_constant_time || f.params.len() == 0 {
                return false;
            }
            if !ng_is_struct_ty(f.ret_ty) || !ng_is_struct_ptr_ty(f.params.get(0).ty) {
                return false;
            }
            return ng_rr_name_ok(g, name);
        }
        OptIrFunction::None => {
        }
    }
    return false;
}

// ===========================================================================
// SP7: incremental relinking in memory (docs/reference/incremental-relink.md).
//
// A long-lived process (`fid serve`) keeps where its last build placed each
// function: its slot, from its start to the next function's start (the last
// one's to the end of the functions). The next build with the function
// cache on, for the same target, cache and program salt, with the code in
// front of the functions (the primitives) the same size, reserves that much
// code (zeros, as alignment padding) and puts each function back in its
// slot when it still fits there:
//   - a cache hit (unchanged function) has its recorded bytes replayed at
//     its old offset (nc_replay with `at`);
//   - a function compiled again is emitted after the reserved code, as in
//     any build, then moved into its slot (nl_move: its bytes, the labels
//     placed in it, its fixups, line and frame rows); with an x86-64 loop
//     head it moves only by a multiple of the loop alignment;
//   - a function with no slot, or one it outgrew, stays after the reserved
//     code (its old slot stays zeros, never executed).
// Every fixup is registered again and NatEnc_resolve patches them as in a
// fresh build: only the references are redone, the unchanged functions'
// bytes stay where they were. The panic-trace table, the symbols, the line
// program and the frame rows want address order: nl_loop_end sorts the
// placed names and the rows by their function's start. A reference out of
// reach in the kept layout makes the build start again afresh
// (nat_generate_image1). Off on RISC-V (its short calls and RVC depend on
// where each function is), for object files and with the parallel
// emission (never with the cache on). `FID_NAT_OFF=relink`: every build
// lays its code out afresh. A layout used by less than half of its bytes
// is not kept (the next build starts afresh, compact again).
// ===========================================================================

// The kept layout (nl_commit): for which build, where the functions start,
// where they end, and per function its start and slot size.
var g_nl_on: bool = false;
var g_nl_path: str = "";
var g_nl_salt: i64 = 0;
var g_nl_arch: i64 = 0;
var g_nl_win: bool = false;
var g_nl_mac: bool = false;
var g_nl_pos0: i64 = 0;
var g_nl_end: i64 = 0;
var g_nl_names: Vec<str> = Vec::new();
var g_nl_starts: Vec<i64> = Vec::new();
var g_nl_sizes: Vec<i64> = Vec::new();
/// name -> index + 1 in g_nl_names (0 before the first layout)
var g_nl_ix: i64 = 0;
// This build's layout, staged by nl_loop_end, kept by nl_commit once its
// fixups resolved; g_nl_st_drop: the kept one goes (mostly unused)
var g_nl_st_ok: bool = false;
var g_nl_st_drop: bool = false;
var g_nl_st_path: str = "";
var g_nl_st_salt: i64 = 0;
var g_nl_st_arch: i64 = 0;
var g_nl_st_win: bool = false;
var g_nl_st_mac: bool = false;
var g_nl_st_pos0: i64 = 0;
var g_nl_st_end: i64 = 0;
var g_nl_st_names: Vec<str> = Vec::new();
var g_nl_st_starts: Vec<i64> = Vec::new();
var g_nl_st_sizes: Vec<i64> = Vec::new();
// This build: is the kept layout used, the slots taken (name -> 1), how
// many functions went back in place (hits), were moved into their slot
// (compiled again), were placed after the reserved code, their bytes, why
// not used; where its functions start; per placed function (in emission
// order) its start and its rows [lr0, lr1) of g.lrows, [cf0, cf1) of
// g.cfi_rows.
var g_nl_use: bool = false;
var g_nl_taken: i64 = 0;
var g_nl_n_kept: i64 = 0;
var g_nl_n_moved: i64 = 0;
var g_nl_n_app: i64 = 0;
var g_nl_bytes: i64 = 0;
var g_nl_why: str = "";
var g_nl_pos_begin: i64 = 0;
var g_nl_bk_start: Vec<i64> = Vec::new();
var g_nl_bk_lr0: Vec<i64> = Vec::new();
var g_nl_bk_lr1: Vec<i64> = Vec::new();
var g_nl_bk_cf0: Vec<i64> = Vec::new();
var g_nl_bk_cf1: Vec<i64> = Vec::new();

/// SP7: a build starts with no layout decided (nc_start).
fn nl_reset() {
    g_nl_use = false;
    g_nl_st_ok = false;
    g_nl_st_drop = false;
    g_nl_why = "";
}

/// SP7: did this build put its functions back in the kept layout?
fn nl_in_use() -> bool {
    return g_nl_use;
}

/// SP7: the kept layout goes (its build failed to resolve).
fn nl_drop() {
    g_nl_on = false;
    g_nl_use = false;
    g_nl_st_ok = false;
}

/// SP7: why this build cannot keep a layout at all ("" when it can).
fn nl_unfit(g: &NatGen, par_on: bool) -> str {
    if !g.nc_on {
        return "the function cache is off";
    }
    if !ng_on("relink") {
        return "FID_NAT_OFF=relink";
    }
    if !ng_x64(g) && !ng_a64(g) {
        return "RISC-V places calls by distance";
    }
    if g_nat_object {
        return "an object file";
    }
    if par_on {
        return "the parallel emission";
    }
    return "";
}

/// SP7: before ng_mir_finish's loop places the functions of `order`:
/// use the kept layout when it is this build's (same cache, salt, target,
/// code before the functions, and at least half of its functions are in
/// this build), reserving its code.
fn nl_begin(g: &mut NatGen, order: &Vec<i64>, par_on: bool) {
    g_nl_use = false;
    if g_nl_taken != 0 {
        HashMap_drop(g_nl_taken);
    }
    g_nl_taken = HashMap_new();
    g_nl_n_kept = 0;
    g_nl_n_moved = 0;
    g_nl_n_app = 0;
    g_nl_bytes = 0;
    g_nl_pos_begin = g.e.code.len();
    g_nl_bk_start = Vec::new();
    g_nl_bk_lr0 = Vec::new();
    g_nl_bk_lr1 = Vec::new();
    g_nl_bk_cf0 = Vec::new();
    g_nl_bk_cf1 = Vec::new();
    var why: str = nl_unfit(g, par_on);
    if why == "" && !g_nl_on {
        why = "no earlier build in this process";
    }
    if why == "" {
        if g_nl_path != g.nc_path || g_nl_salt != g.nc_salt || g_nl_arch != g.arch || g_nl_win != g.win || g_nl_mac != g.mac {
            why = "the last build was of another target, cache or program";
        }
    }
    if why == "" && g_nl_pos0 != g.e.code.len() {
        why = "the code before the functions changed size";
    }
    if why == "" {
        var common: i64 = 0;
        var i: i64 = 0;
        while i < order.len() {
            if HashMap_contains(g_nl_ix, g.recs.get(order.get(i)).name) {
                common = common + 1;
            }
            i = i + 1;
        }
        if common * 2 < g_nl_names.len() {
            why = "fewer than half of the last build's functions are in this one";
        }
    }
    g_nl_why = why;
    if why != "" {
        return;
    }
    g_nl_use = true;
    while g.e.code.len() < g_nl_end {
        g.e.code.push(0);
    }
}

/// SP7: the offset of `name`'s slot in the kept layout when this build
/// uses it, the slot is free and `size` bytes fit in it; else -1.
fn nl_slot(name: str, size: i64) -> i64 {
    if !g_nl_use {
        return 0 - 1;
    }
    if !HashMap_contains(g_nl_ix, name) {
        return 0 - 1;
    }
    if HashMap_contains(g_nl_taken, name) {
        return 0 - 1;
    }
    var ix: i64 = HashMap_get(g_nl_ix, name) - 1;
    if size > g_nl_sizes.get(ix) {
        return 0 - 1;
    }
    return g_nl_starts.get(ix);
}

/// SP7: a function of `size` bytes was placed: back in its slot (`how` 1,
/// a cache hit), moved into it (2, compiled again) or after the reserved
/// code (0).
fn nl_placed(name: str, how: i64, size: i64) {
    if !g_nl_use {
        return;
    }
    g_nl_bytes = g_nl_bytes + size;
    if how == 1 {
        g_nl_n_kept = g_nl_n_kept + 1;
        HashMap_insert(g_nl_taken, name, 1);
    } else if how == 2 {
        g_nl_n_moved = g_nl_n_moved + 1;
        HashMap_insert(g_nl_taken, name, 1);
    } else {
        g_nl_n_app = g_nl_n_app + 1;
    }
}

/// SP7: the rows a function placed at `start` made ([lr0, lr1) of g.lrows,
/// [cf0, cf1) of g.cfi_rows), for nl_loop_end's sort.
fn nl_block(start: i64, lr0: i64, lr1: i64, cf0: i64, cf1: i64) {
    if !g_nl_use {
        return;
    }
    g_nl_bk_start.push(start);
    g_nl_bk_lr0.push(lr0);
    g_nl_bk_lr1.push(lr1);
    g_nl_bk_cf0.push(cf0);
    g_nl_bk_cf1.push(cf1);
}

/// SP7: ng_line_close at `pos` (a function replayed into its slot ends
/// there, not at the end of the code).
fn nl_line_close_at(g: &mut NatGen, pos: i64) {
    if !g.lrow_open {
        return;
    }
    g.lrows.push(pos);
    g.lrows.push(0);
    g.lrows.push(1);
    g.lrow_open = false;
}

/// SP7: may a function emitted at `from` move to `to`? On x86-64 a loop
/// head after a jump is padded to 16 bytes (MI30): the function moves only
/// by a multiple of that, or when it has no such head (its padding is
/// never executed: a move would only lose the alignment).
fn nl_align_kept(g: &NatGen, rec: &NatFnRec, from: i64, to: i64) -> bool {
    if !ng_x64(g) {
        return true;
    }
    var la: i64 = ng_code_align(g, NG_ALIGN_LOOP);
    if la <= ng_code_align(g, NG_ALIGN_FN) {
        return true;
    }
    if (to - from) % la == 0 {
        return true;
    }
    return !ng_par_loop_heads(rec);
}

/// SP7: move the function just emitted at [from, end of code) to `to` (its
/// slot, inside the reserved code): its bytes; the labels placed in it
/// (every label at an offset in it, and the labels made while it was
/// emitted that sit at its end); its fixups (from fx0), line rows (from
/// lr0) and frame rows (from cf0). The code then ends where it did before
/// the function's alignment (pre_al).
fn nl_move(g: &mut NatGen, lab0: i64, pre_al: i64, from: i64, to: i64, fx0: i64, lr0: i64, cf0: i64) {
    var end: i64 = g.e.code.len();
    var d: i64 = to - from;
    var i: i64 = from;
    while i < end {
        g.e.code.set(i + d, g.e.code.get(i));
        i = i + 1;
    }
    var l: i64 = 1;
    while l < g.e.labels.len() {
        var off: i64 = g.e.labels.get(l);
        if off >= from {
            if off < end || (off == end && l >= lab0) {
                g.e.labels.set(l, off + d);
            }
        }
        l = l + 1;
    }
    var k: i64 = fx0;
    while k < g.e.fixups.len() {
        var fx: NatFix = g.e.fixups.get(k);
        g.e.fixups.set(k, NatFix {
            pos: fx.pos + d, label: fx.label, kind: fx.kind
        });
        k = k + 1;
    }
    var r: i64 = lr0;
    while r + 2 < g.lrows.len() {
        g.lrows.set(r, g.lrows.get(r) + d);
        r = r + 3;
    }
    var c: i64 = cf0;
    while c + 2 < g.cfi_rows.len() {
        g.cfi_rows.set(c, g.cfi_rows.get(c) + d);
        var c1: i64 = g.cfi_rows.get(c + 1);
        if c1 >= 0 {
            g.cfi_rows.set(c + 1, c1 + d);
        }
        g.cfi_rows.set(c + 2, g.cfi_rows.get(c + 2) + d);
        c = c + 3;
    }
    if g.e.last_place >= from {
        g.e.last_place = g.e.last_place + d;
    }
    g.e.mul_end = 0 - 1;
    var mp: i64 = 0;
    while mp < g.dbg_mpos.len() {
        if g.dbg_mpos.get(mp) >= from {
            g.dbg_mpos.set(mp, g.dbg_mpos.get(mp) + d);
        }
        mp = mp + 1;
    }
    g.e.code.truncate(pre_al);
}

/// SP7: the indexes 0..keys.len() in increasing key order, equal keys in
/// their order (a bottom-up merge sort).
fn nl_order(keys: &Vec<i64>) -> Vec<i64> {
    var n: i64 = keys.len();
    var a: Vec<i64> = Vec::new();
    var b: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        a.push(i);
        b.push(0);
        i = i + 1;
    }
    var w: i64 = 1;
    while w < n {
        var lo: i64 = 0;
        while lo < n {
            var mid: i64 = lo + w;
            if mid > n {
                mid = n;
            }
            var hi: i64 = lo + 2 * w;
            if hi > n {
                hi = n;
            }
            var p: i64 = lo;
            var q: i64 = mid;
            var o: i64 = lo;
            while o < hi {
                var take_p: bool = false;
                if p < mid {
                    if q >= hi {
                        take_p = true;
                    } else if keys.get(a.get(p)) <= keys.get(a.get(q)) {
                        take_p = true;
                    }
                }
                if take_p {
                    b.set(o, a.get(p));
                    p = p + 1;
                } else {
                    b.set(o, a.get(q));
                    q = q + 1;
                }
                o = o + 1;
            }
            lo = hi;
        }
        i = 0;
        while i < n {
            a.set(i, b.get(i));
            i = i + 1;
        }
        w = w * 2;
    }
    return a;
}

/// SP7: rows of three words [offset, ..] ordered by the start of the
/// function whose block holds them (nl_block: [lr0, lr1) per function for
/// line rows, [cf0, cf1) for frame rows when `frame`), a row outside every
/// block by its own offset; a function's rows keep their order.
fn nl_sort_rows(rows: &Vec<i64>, frame: bool) -> Vec<i64> {
    var n: i64 = rows.len() / 3;
    var keys: Vec<i64> = Vec::new();
    var t: i64 = 0;
    while t < n {
        keys.push(rows.get(3 * t));
        t = t + 1;
    }
    var b: i64 = 0;
    while b < g_nl_bk_start.len() {
        var k: i64 = g_nl_bk_lr0.get(b) / 3;
        var kend: i64 = g_nl_bk_lr1.get(b) / 3;
        if frame {
            k = g_nl_bk_cf0.get(b) / 3;
            kend = g_nl_bk_cf1.get(b) / 3;
        }
        while k < kend && k < n {
            keys.set(k, g_nl_bk_start.get(b));
            k = k + 1;
        }
        b = b + 1;
    }
    var ord: Vec<i64> = nl_order(&keys);
    var out: Vec<i64> = Vec::new();
    var j: i64 = 0;
    while j < ord.len() {
        var x: i64 = 3 * ord.get(j);
        out.push(rows.get(x));
        out.push(rows.get(x + 1));
        out.push(rows.get(x + 2));
        j = j + 1;
    }
    return out;
}

/// SP7: after ng_mir_finish's loop. With the kept layout used, the placed
/// names (the panic-trace table, the symbols), the line rows and the frame
/// rows go back into address order. Then this build's layout is staged
/// for the next build (nl_commit keeps it once the fixups resolve), unless
/// it is mostly unused code; `--stats` says what happened.
fn nl_loop_end(g: &mut NatGen, par_on: bool) {
    var pos0: i64 = g_nl_pos_begin;
    var end: i64 = g.e.code.len();
    if g_nl_use {
        var pkeys: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < g.placed_fns.len() {
            pkeys.push(g.e.labels.get(HashMap_get(g.fn_labels, g.placed_fns.get(i))));
            i = i + 1;
        }
        var pord: Vec<i64> = nl_order(&pkeys);
        var pf: Vec<str> = Vec::new();
        i = 0;
        while i < pord.len() {
            pf.push(g.placed_fns.get(pord.get(i)));
            i = i + 1;
        }
        g.placed_fns = pf;
        var lr: Vec<i64> = nl_sort_rows(&g.lrows, false);
        g.lrows = lr;
        var cf: Vec<i64> = nl_sort_rows(&g.cfi_rows, true);
        g.cfi_rows = cf;
    }
    if g_nat_stats {
        if g_nl_use {
            p_eprint_str("[relink] the last build's layout: " + int_to_str(g_nl_n_kept) + " functions in place, " + int_to_str(g_nl_n_moved) + " compiled again into their places, " + int_to_str(g_nl_n_app) + " placed after them\n");
        } else if g.nc_on {
            p_eprint_str("[relink] a fresh layout (" + g_nl_why + ")\n");
        }
    }
    g_nl_st_ok = false;
    g_nl_st_drop = false;
    if nl_unfit(g, par_on) != "" {
        return;
    }
    if g_nl_use && 2 * g_nl_bytes < end - pos0 {
        // mostly unused: the next build lays its code out afresh
        g_nl_st_drop = true;
        if g_nat_stats {
            p_eprint_str("[relink] less than half of the kept layout is code: the next build starts afresh\n");
        }
        return;
    }
    // Each placed function's start, in address order, and its slot: to
    // the next one's start, the last one's to the end of the functions
    var names: Vec<str> = Vec::new();
    var starts: Vec<i64> = Vec::new();
    var skeys: Vec<i64> = Vec::new();
    var j: i64 = 0;
    while j < g.placed_fns.len() {
        skeys.push(g.e.labels.get(HashMap_get(g.fn_labels, g.placed_fns.get(j))));
        j = j + 1;
    }
    var sord: Vec<i64> = nl_order(&skeys);
    j = 0;
    while j < sord.len() {
        var at: i64 = skeys.get(sord.get(j));
        if at >= pos0 && at < end {
            names.push(g.placed_fns.get(sord.get(j)));
            starts.push(at);
        }
        j = j + 1;
    }
    var sizes: Vec<i64> = Vec::new();
    j = 0;
    while j < starts.len() {
        if j + 1 < starts.len() {
            sizes.push(starts.get(j + 1) - starts.get(j));
        } else {
            sizes.push(end - starts.get(j));
        }
        j = j + 1;
    }
    g_nl_st_names = names;
    g_nl_st_starts = starts;
    g_nl_st_sizes = sizes;
    g_nl_st_path = g.nc_path;
    g_nl_st_salt = g.nc_salt;
    g_nl_st_arch = g.arch;
    g_nl_st_win = g.win;
    g_nl_st_mac = g.mac;
    g_nl_st_pos0 = pos0;
    g_nl_st_end = end;
    g_nl_st_ok = true;
}

/// SP7: the build resolved: its staged layout is the one kept for the
/// next build of this process (a build that staged none leaves the kept
/// one as it was; one found mostly unused drops it).
fn nl_commit() {
    if g_nl_st_drop {
        g_nl_on = false;
        return;
    }
    if !g_nl_st_ok {
        return;
    }
    g_nl_names = g_nl_st_names;
    g_nl_starts = g_nl_st_starts;
    g_nl_sizes = g_nl_st_sizes;
    g_nl_path = g_nl_st_path;
    g_nl_salt = g_nl_st_salt;
    g_nl_arch = g_nl_st_arch;
    g_nl_win = g_nl_st_win;
    g_nl_mac = g_nl_st_mac;
    g_nl_pos0 = g_nl_st_pos0;
    g_nl_end = g_nl_st_end;
    if g_nl_ix != 0 {
        HashMap_drop(g_nl_ix);
    }
    g_nl_ix = HashMap_new();
    var i: i64 = 0;
    while i < g_nl_names.len() {
        HashMap_insert(g_nl_ix, g_nl_names.get(i), i + 1);
        i = i + 1;
    }
    g_nl_on = true;
    g_nl_st_ok = false;
}

/// SP7: the kept layout's function `name`: its start, -1 when none (a
/// test reads it through nat_relink_start).
pub fn nat_relink_start(name: str) -> i64 {
    if !g_nl_on || g_nl_ix == 0 || !HashMap_contains(g_nl_ix, name) {
        return 0 - 1;
    }
    return g_nl_starts.get(HashMap_get(g_nl_ix, name) - 1);
}

/// SP7: did the last native build of this process put its functions back
/// in the layout of the one before (nl_begin), and how many: [used (0/1),
/// in place, moved into place, placed after].
pub fn nat_relink_counts() -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if g_nl_use {
        out.push(1);
    } else {
        out.push(0);
    }
    out.push(g_nl_n_kept);
    out.push(g_nl_n_moved);
    out.push(g_nl_n_app);
    return out;
}

/// A library function's recorded clobber mask (WP20, FID_LIBFACTS_IN) is `mk`.
fn nc_lib_mask_is(g: &NatGen, name: str, mk: i64) -> bool {
    return HashMap_contains(g.lib_mask, name) && HashMap_get(g.lib_mask, name) == mk;
}

/// Do entry e's deps still hold against the entries kept so far
/// (g_nc_valid) and the functions compiled again?
fn nc_deps_ok(g: &NatGen, m: &IrModule, e: &NcEntry) -> bool {
    var i: i64 = 0;
    while i < e.deps.len() {
        var d: str = e.deps.get(i);
        var dm: i64 = e.dep_masks.get(i);
        var dr: i64 = e.dep_rr.get(i);
        var dix: i64 = 0;
        if HashMap_contains(g_nc_valid, d) {
            dix = HashMap_get(g_nc_valid, d);
        }
        if dix != 0 {
            // replayed too: its mask and its result convention are its entry's
            if dm >= 0 && g.nc_old.get(dix - 1).mask != dm && !nc_lib_mask_is(g, d, dm) {
                return false;
            }
            if g.nc_old.get(dix - 1).rr_self != dr {
                return false;
            }
            // SP20: and its escape summary (MI28) the one the code read
            if i < e.dep_ft.len() && e.dep_ft.get(i) != 0 && g.nc_old.get(dix - 1).ft_self != e.dep_ft.get(i) {
                return false;
            }
        } else {
            // compiled again: its mask is known once it is allocated, which
            // the post-order does before its callers (nc_masks_hold checks
            // it then); one outside the program has none but a library's
            if dm >= 0 && !HashMap_contains(g.all_fns, d) && !nc_lib_mask_is(g, d, dm) {
                return false;
            }
            // and its result convention is decided before any allocation:
            // it must not be able to take one the code did not expect
            if dr != 0 {
                return false;
            }
            if nc_may_rr(g, m, d) {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

/// SP6: the entries this build may replay (g_nc_valid): the ones with this
/// build's key, not gone without (g_nc_deny), whose deps hold; the ones
/// dropped for a dep go to g_nc_stale.
fn nc_validate(g: &NatGen, m: &IrModule) {
    g_nc_valid = HashMap_new();
    var cand: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < g.nc_old.len() {
        var nm: str = g.nc_old.get(i).name;
        if HashMap_get(g.nc_ix, nm) == i + 1 && !nc_denied(nm) && HashMap_contains(g.all_fns, nm) {
            if nc_cur_key(m, nm) == g.nc_old.get(i).key {
                HashMap_insert(g_nc_valid, nm, i + 1);
                cand.push(i);
            }
        }
        i = i + 1;
    }
    var changed: bool = true;
    while changed {
        changed = false;
        var keep: Vec<i64> = Vec::new();
        var c: i64 = 0;
        while c < cand.len() {
            var ci: i64 = cand.get(c);
            var ce: NcEntry = g.nc_old.get(ci);
            if nc_deps_ok(g, m, &ce) {
                keep.push(ci);
            } else {
                HashMap_insert(g_nc_valid, ce.name, 0);
                g_nc_stale.push(ce.name);
                changed = true;
            }
            c = c + 1;
        }
        cand = keep;
    }
}

/// SP6: the functions whose address `name`'s recorded MIR takes (noted by
/// ng_rr_plan before the passes), for its cache entry.
fn nc_addrs_of(name: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if g_nc_addrs == 0 || !HashMap_contains(g_nc_addrs, name) {
        return out;
    }
    var s: str = HashMap_get(g_nc_addrs, name);
    if str_len(s) == 0 {
        return out;
    }
    return str_split(s, ",");
}

/// SP6: a hit that does not fit this program after all: the image is made
/// again without it (nat_generate_image).
fn nc_give_up(name: str) {
    var i: i64 = 0;
    while i < g_nc_retry.len() {
        if g_nc_retry.get(i) == name {
            return;
        }
        i = i + 1;
    }
    g_nc_retry.push(name);
}

/// SP6: give up hit `name` and every kept entry that took its mask or its
/// result convention for granted, transitively (compiled again, each may
/// end up with another mask): the next attempt then has none of them.
fn nc_give_up_callers(g: &NatGen, name: str) {
    var seen: i64 = HashMap_new();
    var work: Vec<str> = Vec::new();
    work.push(name);
    HashMap_insert(seen, name, 1);
    var w: i64 = 0;
    while w < work.len() {
        var x: str = work.get(w);
        nc_give_up(x);
        var i: i64 = 0;
        while i < g.nc_old.len() {
            var en: str = g.nc_old.get(i).name;
            if !HashMap_contains(seen, en) && g_nc_valid != 0 && HashMap_contains(g_nc_valid, en) && HashMap_get(g_nc_valid, en) == i + 1 {
                var deps: Vec<str> = g.nc_old.get(i).deps;
                var j: i64 = 0;
                var hit: bool = false;
                while j < deps.len() && !hit {
                    if deps.get(j) == x && (g.nc_old.get(i).dep_masks.get(j) >= 0 || g.nc_old.get(i).dep_rr.get(j) != 0 || (j < g.nc_old.get(i).dep_ft.len() && g.nc_old.get(i).dep_ft.get(j) != 0)) {
                        hit = true;
                    }
                    j = j + 1;
                }
                if hit {
                    HashMap_insert(seen, en, 1);
                    work.push(en);
                }
            }
            i = i + 1;
        }
        w = w + 1;
    }
}

/// SP6: at the replay of hit e, do the masks its allocation saw for the
/// functions compiled again in this build (nc_deps_ok left those to now)
/// match what they were allocated with? The post-order has allocated a
/// callee before its callers, except around a cycle: a callee not yet
/// allocated has no mask (ng_label_mask -1), so a hit that knew one does
/// not hold.
fn nc_masks_hold(g: &NatGen, e: &NcEntry) -> bool {
    var i: i64 = 0;
    while i < e.deps.len() {
        var d: str = e.deps.get(i);
        var dm: i64 = e.dep_masks.get(i);
        var kept: bool = g_nc_valid != 0 && HashMap_contains(g_nc_valid, d) && HashMap_get(g_nc_valid, d) != 0;
        if dm >= 0 && !kept && HashMap_contains(g.all_fns, d) && HashMap_contains(g.fn_labels, d) {
            if ng_label_mask(g, HashMap_get(g.fn_labels, d)) != dm {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

fn nc_is_retry(r: ResultBytes) -> bool {
    match r {
        ResultBytes::Err(e) => {
            return e.len() == 1 && e.get(0) == NC_RETRY;
        }
        _ => {
        }
    }
    return false;
}

// ===========================================================================
// macOS (`--target aarch64-macos|x86_64-macos`, F7): the machine layer's
// code in a Mach-O (nat_macho), the Linux runtime over libSystem. The
// runtime's system calls go to pe_mac_syscall (stdlib/linux_runtime/
// darwin.fd), which calls libSystem through nat_mac_call(k, ...): k indexes
// the import list below, in the same order as PE_M_* in darwin.fd.
// ===========================================================================

/// "symbol" per libSystem import; the index is the PE_M_* constant of
/// darwin.fd. Symbols carry the Mach-O leading underscore. On x86-64 the
/// 64-bit-inode `struct stat` (the layout darwin.fd reads) comes from
/// `fstatat$INODE64` (<sys/stat.h> __DARWIN_INODE64); plain `fstatat` there
/// is the old 32-bit-inode layout. arm64 has no suffix.
fn ng_mac_imports(x64: bool) -> Vec<str> {
    var fstatat: str = "_fstatat";
    if x64 {
        fstatat = "_fstatat$INODE64";
    }
    // x86-64 macOS has the 64-bit-inode directory calls under $INODE64
    var fdopendir: str = "_fdopendir";
    var readdir: str = "_readdir";
    if x64 {
        fdopendir = "_fdopendir$INODE64";
        readdir = "_readdir$INODE64";
    }
    var v: Vec<str> = Vec::new();
    v.push("_write");
    v.push("_read");
    v.push("_close");
    v.push("_exit");
    v.push("_mmap");
    v.push("_munmap");
    v.push("_mprotect");
    v.push("_openat");
    v.push("_lseek");
    v.push(fstatat);
    v.push("_clock_gettime");
    v.push("_nanosleep");
    v.push("_sched_yield");
    v.push("_getpid");
    v.push("_arc4random_buf");
    v.push("_pthread_create");
    v.push("_pthread_join");
    v.push("_pthread_self");
    v.push("_pthread_key_create");
    v.push("_pthread_getspecific");
    v.push("_pthread_setspecific");
    v.push("___ulock_wait");
    v.push("___ulock_wake");
    v.push("_sigaction");
    v.push("_sysctlbyname");
    v.push("_unlinkat");
    v.push("_mkdirat");
    v.push("_renameat");
    v.push("_getdirentries");
    v.push("_ftruncate");
    v.push("_kill");
    v.push("_sigaltstack");
    v.push("_pthread_attr_init");
    v.push("_pthread_attr_setstacksize");
    v.push("_pthread_attr_setdetachstate");
    v.push("_abort");
    // stdlib/linux_runtime/darwin.fd PE_M_ERROR.. (errno, directory listing)
    v.push("___error");
    v.push(fdopendir);
    v.push(readdir);
    v.push("_telldir");
    v.push("_seekdir");
    v.push("_closedir");
    v.push("_dup");
    // darwin.fd PE_M_SOCKET.. (F7: sockets and poll, process spawn,
    // DB9's setitimer, the ids)
    v.push("_socket");
    v.push("_bind");
    v.push("_listen");
    v.push("_accept");
    v.push("_connect");
    v.push("_sendto");
    v.push("_recvfrom");
    v.push("_setsockopt");
    v.push("_getsockopt");
    v.push("_poll");
    v.push("_fcntl");
    v.push("_fork");
    v.push("_execve");
    v.push("_wait4");
    v.push("_setitimer");
    v.push("__exit");
    v.push("_getppid");
    v.push("_getuid");
    v.push("_getgid");
    // darwin.fd PE_M_KQUEUE.. (MI16/F7: the reactor's epoll and eventfd
    // over kqueue and a pipe)
    v.push("_kqueue");
    v.push("_kevent");
    v.push("_pipe");
    return v;
}

/// Shift `nargs` internal argument registers up by one and call the Fides
/// function `target` with a null __env first (arm64: all in x0..x7; x64:
/// reuse ng_win_forward, whose internal shuffle is the System V one).
fn ng_mac_forward(g: &mut NatGen, target: str, nargs: i64, nstack_x64: i64) {
    if ng_x64(g) {
        ng_win_forward(g, target, nstack_x64);
        return;
    }
    // arm64: xN = x(N-1) for N = nargs..1, then x0 = 0
    var i: i64 = nargs;
    while i > 0 {
        a64_mov(&mut g.e, i, i - 1);
        i = i - 1;
    }
    a64_li(&mut g.e, 0, 0);
    a64_b(&mut g.e, ng_fn_label(g, target));
    // tail call
}

/// Load GOT slot `k` (argument register 0) and call it with the platform
/// ABI (System V / AAPCS). The result goes to return register 0. Up to six
/// arguments (a..f); mmap needs all six. The runtime calls nat_mac_call
/// with the internal convention: k, a, b, c in registers and d, e, f on the
/// stack (x64) or all in registers (arm64).
fn ng_mac_call_body(g: &mut NatGen) {
    if ng_x64(g) {
        // k=rdi(7) a=rsi(6) b=rdx(2) c=rcx(1); d,e,f at [rsp+8/16/24]
        x64_load(&mut g.e, 9, 4, 24, 8, true);
        // r9 = f
        x64_load(&mut g.e, 8, 4, 16, 8, true);
        // r8 = e
        x64_load(&mut g.e, 10, 4, 8, 8, true);
        // r10 = d
        x64_mov(&mut g.e, 0, 7);
        // rax = k
        x64_shift_imm(&mut g.e, 4, 0, 3);
        // shl rax, 3
        x64_lea_label(&mut g.e, 11, g.mac_got_label);
        x64_alu(&mut g.e, 0x01, 11, 0);
        // add r11, rax
        x64_load(&mut g.e, 11, 11, 0, 8, true);
        // r11 = GOT[k]
        x64_mov(&mut g.e, 7, 6);
        // rdi = a
        x64_mov(&mut g.e, 6, 2);
        // rsi = b
        x64_mov(&mut g.e, 2, 1);
        // rdx = c
        x64_mov(&mut g.e, 1, 10);
        // rcx = d
        x64_li(&mut g.e, 0, 0);
        // varargs: al = 0
        x64_sub_imm(&mut g.e, 4, 8);
        // align rsp to 16
        x64_call_r(&mut g.e, 11);
        x64_add_imm(&mut g.e, 4, 8);
        x64_mov(&mut g.e, 7, 0);
        // return value -> rdi
        x64_ret(&mut g.e);
        return;
    }
    // arm64: k=x0 a=x1 b=x2 c=x3 d=x4 e=x5 f=x6
    NatEnc_word(&mut g.e, 0xA9BF7BFD);
    // stp x29, x30, [sp, #-16]!
    a64_addr(&mut g.e, 9, g.mac_got_label);
    a64_add(&mut g.e, 10, 0, 0);
    // x10 = 2k
    a64_add(&mut g.e, 10, 10, 10);
    // 4k
    a64_add(&mut g.e, 10, 10, 10);
    // 8k
    a64_add(&mut g.e, 9, 9, 10);
    // x9 = got + 8k
    a64_ldr(&mut g.e, 11, 9, 0);
    // x11 = GOT[k]
    // Apple arm64 passes variadic arguments on the stack: openat's mode
    // (argument d, after three fixed ones) goes to [sp] as well. The other
    // imports take at most six arguments, all in registers, and never
    // read the stack.
    a64_sub_imm(&mut g.e, A64_SP, A64_SP, 16);
    a64_str(&mut g.e, 4, A64_SP, 0);
    a64_mov(&mut g.e, 0, 1);
    a64_mov(&mut g.e, 1, 2);
    a64_mov(&mut g.e, 2, 3);
    a64_mov(&mut g.e, 3, 4);
    a64_mov(&mut g.e, 4, 5);
    a64_mov(&mut g.e, 5, 6);
    a64_blr(&mut g.e, 11);
    a64_add_imm(&mut g.e, A64_SP, A64_SP, 16);
    NatEnc_word(&mut g.e, 0xA8C17BFD);
    // ldp x29, x30, [sp], #16
    a64_ret(&mut g.e);
}

/// The macOS primitives of both arches: the Mach-O entry (dyld calls it as
/// main(argc, argv, envp)), nat_syscall (to pe_mac_syscall), nat_mac_call,
/// the thread trampoline, nat_clone_thread, nat_tls_get/set, nat_os and the
/// signal handler. The shared primitives come from ng_gen_primitives2 /
/// ng_gen_primitives_x64_common, which skip their Linux-only versions when
/// g.mac is set.
fn ng_gen_primitives_mac(g: &mut NatGen) {
    g.entry_label = NatEnc_label(&mut g.e);
    NatEnc_place(&mut g.e, g.entry_label);
    var main_label: i64 = ng_fn_label(g, "main");
    if ng_x64(g) {
        // dyld: argc=rdi, argv=rsi, envp=rdx; result (exit code) in rax
        x64_push(&mut g.e, 5);
        x64_mov(&mut g.e, 5, 4);
        x64_mov(&mut g.e, 1, 2);
        // rcx = envp
        x64_mov(&mut g.e, 2, 6);
        // rdx = argv
        x64_mov(&mut g.e, 6, 7);
        // rsi = argc
        x64_li(&mut g.e, 7, 0);
        // rdi = env0
        x64_call(&mut g.e, ng_fn_label(g, "pe_mac_start"));
        x64_store_label(&mut g.e, 7, g.start_sp_label);
        // block in return reg rdi(7)
        if ng_has_fn(g, "pe_rt_init") {
            x64_li(&mut g.e, 7, 0);
            x64_call(&mut g.e, ng_fn_label(g, "pe_rt_init"));
        }
        x64_li(&mut g.e, 7, 0);
        x64_call(&mut g.e, main_label);
        // DB9 / F7: pe_rt_exit(its result) as on Linux (the profile's
        // report, --leaks), which exits through libSystem exit()
        if ng_has_fn(g, "pe_rt_exit") {
            x64_mov(&mut g.e, 6, 7);
            x64_li(&mut g.e, 7, 0);
            x64_call(&mut g.e, ng_fn_label(g, "pe_rt_exit"));
        }
        // RL16: --leaks reports before returning to dyld (main's result on
        // the stack, twice to keep sp aligned)
        if g_nat_leaks && ng_has_fn(g, "pe_leak_report") {
            x64_push(&mut g.e, 7);
            x64_push(&mut g.e, 7);
            x64_li(&mut g.e, 7, 0);
            x64_call(&mut g.e, ng_fn_label(g, "pe_leak_report"));
            x64_pop(&mut g.e, 7);
            x64_pop(&mut g.e, 7);
        }
        x64_mov(&mut g.e, 0, 7);
        // rax = result for dyld exit()
        x64_mov(&mut g.e, 4, 5);
        x64_pop(&mut g.e, 5);
        x64_ret(&mut g.e);
    } else {
        // dyld: argc=x0, argv=x1, envp=x2; result in x0
        NatEnc_word(&mut g.e, 0xA9BF7BFD);
        // stp x29, x30, [sp, #-16]!
        a64_add_imm(&mut g.e, A64_FP, A64_SP, 0);
        a64_mov(&mut g.e, 3, 2);
        // x3 = envp
        a64_mov(&mut g.e, 2, 1);
        // x2 = argv
        a64_mov(&mut g.e, 1, 0);
        // x1 = argc
        a64_li(&mut g.e, 0, 0);
        // x0 = env0
        a64_bl(&mut g.e, ng_fn_label(g, "pe_mac_start"));
        a64_addr(&mut g.e, g.t1, g.start_sp_label);
        a64_str(&mut g.e, 0, g.t1, 0);
        // block in x0
        a64_li(&mut g.e, A64_FP, 0);
        if ng_has_fn(g, "pe_rt_init") {
            a64_li(&mut g.e, 0, 0);
            a64_bl(&mut g.e, ng_fn_label(g, "pe_rt_init"));
        }
        a64_li(&mut g.e, 0, 0);
        a64_bl(&mut g.e, main_label);
        // DB9 / F7: pe_rt_exit(its result) as on Linux, which exits
        if ng_has_fn(g, "pe_rt_exit") {
            a64_mov(&mut g.e, 1, 0);
            a64_li(&mut g.e, 0, 0);
            a64_bl(&mut g.e, ng_fn_label(g, "pe_rt_exit"));
        }
        // RL16: --leaks reports before returning to dyld (main's result
        // kept on the stack)
        if g_nat_leaks && ng_has_fn(g, "pe_leak_report") {
            a64_sub_imm(&mut g.e, A64_SP, A64_SP, 16);
            a64_str(&mut g.e, 0, A64_SP, 0);
            a64_li(&mut g.e, 0, 0);
            a64_bl(&mut g.e, ng_fn_label(g, "pe_leak_report"));
            a64_ldr(&mut g.e, 0, A64_SP, 0);
            a64_add_imm(&mut g.e, A64_SP, A64_SP, 16);
        }
        // result in x0 for dyld
        NatEnc_word(&mut g.e, 0xA8C17BFD);
        // ldp x29, x30, [sp], #16
        a64_ret(&mut g.e);
    }

    // nat_syscall(n, a..f) -> pe_mac_syscall(env, n, a..f)
    ng_prim(g, "nat_syscall");
    ng_mac_forward(g, "pe_mac_syscall", 7, 3);

    // nat_mac_call(k, a..j): a libSystem call through GOT slot k
    ng_prim(g, "nat_mac_call");
    ng_mac_call_body(g);

    // The pthread trampoline: pe_mac_thread_main(env0, arg)
    var tramp: i64 = NatEnc_label(&mut g.e);
    NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
    NatEnc_place(&mut g.e, tramp);
    if ng_x64(g) {
        x64_push(&mut g.e, 5);
        x64_mov(&mut g.e, 5, 4);
        x64_mov(&mut g.e, 6, 7);
        // rsi = arg
        x64_li(&mut g.e, 7, 0);
        // rdi = env0
        x64_call(&mut g.e, ng_fn_label(g, "pe_mac_thread_main"));
        x64_mov(&mut g.e, 0, 7);
        x64_mov(&mut g.e, 4, 5);
        x64_pop(&mut g.e, 5);
        x64_ret(&mut g.e);
    } else {
        NatEnc_word(&mut g.e, 0xA9BF7BFD);
        a64_mov(&mut g.e, 1, 0);
        // x1 = arg
        a64_li(&mut g.e, 0, 0);
        // x0 = env0
        a64_bl(&mut g.e, ng_fn_label(g, "pe_mac_thread_main"));
        NatEnc_word(&mut g.e, 0xA8C17BFD);
        a64_ret(&mut g.e);
    }
    ng_prim(g, "nat_mac_thread_tramp");
    ng_addr(g, ng_argreg(g, 0), tramp);
    if ng_x64(g) {
        x64_ret(&mut g.e);
    } else {
        a64_ret(&mut g.e);
    }

    // nat_clone_thread(entry, arg, stack_top, ctid, tls) -> pe_mac_clone
    ng_prim(g, "nat_clone_thread");
    ng_mac_forward(g, "pe_mac_clone", 5, 1);

    // nat_tls_get() / nat_tls_set(v): a pthread key (Fides helpers)
    ng_prim(g, "nat_tls_get");
    if ng_x64(g) {
        x64_li(&mut g.e, 7, 0);
        x64_call(&mut g.e, ng_fn_label(g, "nat_tls_get_mac"));
        x64_ret(&mut g.e);
    } else {
        NatEnc_word(&mut g.e, 0xA9BF7BFD);
        a64_li(&mut g.e, 0, 0);
        a64_bl(&mut g.e, ng_fn_label(g, "nat_tls_get_mac"));
        NatEnc_word(&mut g.e, 0xA8C17BFD);
        a64_ret(&mut g.e);
    }
    ng_prim(g, "nat_tls_set");
    if ng_x64(g) {
        x64_mov(&mut g.e, 6, 7);
        // rsi = v
        x64_li(&mut g.e, 7, 0);
        // rdi = env0
        x64_call(&mut g.e, ng_fn_label(g, "nat_tls_set_mac"));
        x64_ret(&mut g.e);
    } else {
        NatEnc_word(&mut g.e, 0xA9BF7BFD);
        a64_mov(&mut g.e, 1, 0);
        // x1 = v
        a64_li(&mut g.e, 0, 0);
        // x0 = env0
        a64_bl(&mut g.e, ng_fn_label(g, "nat_tls_set_mac"));
        NatEnc_word(&mut g.e, 0xA8C17BFD);
        a64_ret(&mut g.e);
    }

    // nat_os() -> 2 (macOS)
    ng_prim(g, "nat_os");
    ng_li(g, ng_argreg(g, 0), 2);
    if ng_x64(g) {
        x64_ret(&mut g.e);
    } else {
        a64_ret(&mut g.e);
    }

    // The signal handler (sig, info, uctx) -> pe_mac_on_signal(env0, sig,
    // info) (darwin.fd: macOS numbers and siginfo to Linux ones), else
    // pe_on_signal; the restorer is unused on macOS (0).
    var sig_entry: i64 = NatEnc_label(&mut g.e);
    NatEnc_align(&mut g.e, ng_code_align(g, NG_ALIGN_FN));
    NatEnc_place(&mut g.e, sig_entry);
    var sig_fn: str = "pe_on_signal";
    if ng_has_fn(g, "pe_mac_on_signal") {
        sig_fn = "pe_mac_on_signal";
    }
    if ng_has_fn(g, sig_fn) {
        if ng_x64(g) {
            x64_push(&mut g.e, 5);
            x64_mov(&mut g.e, 5, 4);
            x64_mov(&mut g.e, 1, 2);
            // rcx = uc (DB9: the profiler reads the Darwin mcontext)
            x64_mov(&mut g.e, 2, 6);
            // rdx = info
            x64_mov(&mut g.e, 6, 7);
            // rsi = sig
            x64_li(&mut g.e, 7, 0);
            // rdi = env0
            x64_call(&mut g.e, ng_fn_label(g, sig_fn));
            x64_pop(&mut g.e, 5);
            x64_ret(&mut g.e);
        } else {
            NatEnc_word(&mut g.e, 0xA9BF7BFD);
            a64_add_imm(&mut g.e, A64_FP, A64_SP, 0);
            a64_mov(&mut g.e, 3, 2);
            // x3 = uc (DB9)
            a64_mov(&mut g.e, 2, 1);
            // x2 = info
            a64_mov(&mut g.e, 1, 0);
            // x1 = sig
            a64_li(&mut g.e, 0, 0);
            // x0 = env0
            a64_bl(&mut g.e, ng_fn_label(g, sig_fn));
            NatEnc_word(&mut g.e, 0xA8C17BFD);
            a64_ret(&mut g.e);
        }
    } else {
        if ng_x64(g) {
            x64_ret(&mut g.e);
        } else {
            a64_ret(&mut g.e);
        }
    }
    ng_prim(g, "nat_sig_handler");
    ng_addr(g, ng_argreg(g, 0), sig_entry);
    if ng_x64(g) {
        x64_ret(&mut g.e);
    } else {
        a64_ret(&mut g.e);
    }
    ng_prim(g, "nat_sig_restorer");
    ng_li(g, ng_argreg(g, 0), 0);
    if ng_x64(g) {
        x64_ret(&mut g.e);
    } else {
        a64_ret(&mut g.e);
    }
}

/// The import GOT: one 8-byte slot per libSystem symbol, bound by dyld.
fn ng_gen_mac_got(g: &mut NatGen) {
    NatEnc_align(&mut g.e, 8);
    NatEnc_place(&mut g.e, g.mac_got_label);
    var n: i64 = ng_mac_imports(ng_x64(g)).len();
    var i: i64 = 0;
    while i < n {
        NatEnc_quad(&mut g.e, 0);
        i = i + 1;
    }
}

// ===========================================================================
// Tooling hooks (Nov 16): DB7 MIR dumps per pass, WP20 library roots, TG12
// object files, RL6 instruction-selection check, LG13 asm! thunks. The
// writers, the evaluator and the assemblers are in nat_enc.fd.
// ===========================================================================

/// DB7: is the MIR of `name` to be printed (g_nat_dump, which `fid explain
/// --stages` sets, or FID_NAT_DUMP; `*`: every function)?
fn ng_dump_wanted(name: str) -> bool {
    if g_nat_dump == name || g_nat_dump == "*" {
        return true;
    }
    var dump: str = ng_env_dump();
    if (dump as i64) == 0 || str_len(dump) == 0 {
        return false;
    }
    return dump == name || dump == "*";
}

/// DB7: print function `name`'s MIR after `stage` on stderr, one operation
/// a line as the allocation's dump (ng_mir_alloc) prints them, without the
/// registers it has not chosen yet.
fn ng_dump_mir(name: str, stage: str, mir: &Vec<MInst>) {
    if !ng_dump_wanted(name) {
        return;
    }
    p_eprint_str("[mir] " + name + " after " + stage + ": " + int_to_str(mir.len()) + " operations\n");
    var k: i64 = 0;
    while k < mir.len() {
        // (MI1: the operation as compiler/mir.fd's printer writes it)
        p_eprint_str("[mir] " + int_to_str(k) + ": " + mi_text(mir.get(k)) + "\n");
        k = k + 1;
    }
}

/// WP20: a library build's roots (no `main`): every function of the input
/// file (main.fd's g_nat_lines_names, and the methods ir.fd records for
/// that file). The entry point's call of main goes to label 0, placed here
/// on a trap: a library image is for its facts (FID_LIBFACTS: an `ext`
/// line per function) or its object (TG12), not to run.
fn ng_lib_roots(g: &mut NatGen, module: &IrModule) {
    NatEnc_place(&mut g.e, 0);
    ng_trap(g);
    var names: Vec<str> = str_split(g_nat_lines_names, ",");
    var listed: i64 = HashMap_new();
    var i: i64 = 0;
    while i < names.len() {
        HashMap_insert(listed, names.get(i), 1);
        i = i + 1;
    }
    i = 0;
    while i < module.functions.len() {
        var nm: str = module.functions.get(i).name;
        var own: bool = HashMap_contains(listed, nm);
        if !own && str_len(g_nat_lines_file) > 0 && ir_fn_file(nm) == g_nat_lines_file {
            own = true;
        }
        if own {
            var _root_label: i64 = ng_fn_label(g, nm);
        }
        i = i + 1;
    }
}

/// TG12: a relocatable object of the program for `arch`, for the driver's
/// object-file output (`fid emit --obj`, main.fd nat_write_object): ELF
/// (ET_REL) for the Linux targets (nat_enc.fd nat_elf_object), COFF for
/// `--nat` Windows (nat_coff_object) and Mach-O (MH_OBJECT) for macOS
/// (nat_macho_object); each writer says what is in its object. A program
/// without `main` is a library build (WP20): its functions are in the
/// object and the entry only traps.
pub fn nat_emit_object(module: IrModule, arch: i64, win: bool, mac: bool) -> ResultBytes {
    g_nat_object = true;
    var r: ResultBytes = nat_generate_image(module, arch, win, mac);
    g_nat_object = false;
    return r;
}

/// RL6: translation validation of instruction selection (FID_VERIFY=1, once
/// per build): each integer MIR operation of nat_enc.fd's nat_sel_cases is
/// selected alone with physical registers through ng_mi_dispatch (MO_MOV,
/// which the replay moves itself, through ng_mov), as the replay after
/// allocation selects it, and nat_sel_eval_case runs the bytes on edge and
/// random values against the operation's meaning. "" or the first mismatch.
/// OP18: how many operations of `mir` are `op`.
fn ng_mu_count(mir: &Vec<MInst>, op: i64) -> i64 {
    var c: i64 = 0;
    var k: i64 = 0;
    while k < mir.len() {
        if mir.get(k).op == op {
            c = c + 1;
        }
        k = k + 1;
    }
    return c;
}

/// OP18: the position of the first `op` in `mir` (-1: none).
fn ng_mu_find(mir: &Vec<MInst>, op: i64) -> i64 {
    var k: i64 = 0;
    while k < mir.len() {
        if mir.get(k).op == op {
            return k;
        }
        k = k + 1;
    }
    return 0 - 1;
}

/// OP18: the memory-operand folds on small MIR sequences (FID_VERIFY=1,
/// from nat_sel_check): what ng_fuse_ldext, ng_fuse_memcmp and
/// ng_fuse_rmw make of each, and the sequences they must leave as they
/// are (a store between the load and its reader, a value read twice, a
/// constant out of the field's range, the load on the right of SUB).
/// Compares and read-modify-writes are formed on x86-64 only. A switch
/// that turns a fold off (FID_NAT_OFF) or mutates it (FID_NAT_MUTATE)
/// skips its cases. "" when every case holds, else what failed.
pub fn nat_memop_unit_check(arch: i64) -> str {
    var g: NatGen = NatGen_new(arch);
    var x64: bool = ng_sel_has(&g, MO_BRCCM);
    var v: i64 = NG_VBASE;
    var nvr: i64 = NG_VBASE + 16;
    var none: i64 = 0 - 1;
    var err: str = "";
    if ng_on("ldext") && !ng_mutant("ldext") {
        // `MOV d, t; EXT d, d, ZB` over an 8-byte load: one 1-byte load
        var a: Vec<MInst> = Vec::new();
        a.push(ng_mi(MO_LOAD, v + 1, v, 0, 16, 8, 0));
        a.push(ng_mi(MO_MOV, v + 2, v + 1, 0, 0, 0, 0));
        a.push(ng_mi(MO_EXT, v + 2, v + 2, 0, NEXT_ZB, 0, 0));
        a.push(ng_mi(MO_MOV, v + 3, v + 2, 0, 0, 0, 0));
        var na: i64 = ng_fuse_ldext(&g, &mut a, nvr, none);
        if na != 1 || a.len() != 2 || a.get(0).op != MO_LOAD || a.get(0).r0 != v + 2 || a.get(0).r1 != v || a.get(0).i0 != 16 || a.get(0).i1 != 1 || a.get(0).i2 != 0 {
            err = err + "ldext: (u8) of an 8-byte load; ";
        }
        // a signed 4-byte load read as u16: a zero-extending 2-byte load
        var a2: Vec<MInst> = Vec::new();
        a2.push(ng_mi(MO_LOAD, v + 1, v, 0, 8, 4, 1));
        a2.push(ng_mi(MO_EXT, v + 2, v + 1, 0, NEXT_ZH, 0, 0));
        a2.push(ng_mi(MO_MOV, v + 3, v + 2, 0, 0, 0, 0));
        ng_fuse_ldext(&g, &mut a2, nvr, none);
        if a2.len() != 2 || a2.get(0).op != MO_LOAD || a2.get(0).i1 != 2 || a2.get(0).i2 != 0 || a2.get(0).r0 != v + 2 {
            err = err + "ldext: (u16) of an i32 load; ";
        }
        // a byte load read as i8: the sign-extending load
        var a3: Vec<MInst> = Vec::new();
        a3.push(ng_mi(MO_LOAD, v + 1, v, 0, 3, 1, 0));
        a3.push(ng_mi(MO_EXT, v + 2, v + 1, 0, NEXT_SB, 0, 0));
        ng_fuse_ldext(&g, &mut a3, nvr, none);
        if a3.len() != 1 || a3.get(0).op != MO_LOAD || a3.get(0).i1 != 1 || a3.get(0).i2 != 1 {
            err = err + "ldext: (i8) of a u8 load; ";
        }
        // a narrower load cannot give a wider extension: kept
        var a4: Vec<MInst> = Vec::new();
        a4.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 2, 1));
        a4.push(ng_mi(MO_EXT, v + 2, v + 1, 0, NEXT_ZW, 0, 0));
        ng_fuse_ldext(&g, &mut a4, nvr, none);
        if a4.len() != 2 || ng_mu_count(&a4, MO_EXT) != 1 {
            err = err + "ldext: (u32) of an i16 load folded; ";
        }
        // the loaded value read again: kept
        var a5: Vec<MInst> = Vec::new();
        a5.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        a5.push(ng_mi(MO_EXT, v + 2, v + 1, 0, NEXT_SB, 0, 0));
        a5.push(ng_mi(MO_ADD, v + 3, v + 2, v + 1, 0, 0, 0));
        ng_fuse_ldext(&g, &mut a5, nvr, none);
        if a5.len() != 3 || ng_mu_count(&a5, MO_EXT) != 1 {
            err = err + "ldext: a load read twice folded; ";
        }
        // a store between the load and the extension: kept
        var a6: Vec<MInst> = Vec::new();
        a6.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        a6.push(ng_mi(MO_STORE, v, v + 4, 0, 0, 8, 0));
        a6.push(ng_mi(MO_EXT, v + 2, v + 1, 0, NEXT_ZB, 0, 0));
        ng_fuse_ldext(&g, &mut a6, nvr, none);
        if a6.len() != 3 || ng_mu_count(&a6, MO_EXT) != 1 {
            err = err + "ldext: folded across a store; ";
        }
        // the base written between: kept
        var a7: Vec<MInst> = Vec::new();
        a7.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        a7.push(ng_mi(MO_LI, v, 0, 0, 4096, 0, 0));
        a7.push(ng_mi(MO_EXT, v + 2, v + 1, 0, NEXT_ZB, 0, 0));
        ng_fuse_ldext(&g, &mut a7, nvr, none);
        if a7.len() != 3 || ng_mu_count(&a7, MO_EXT) != 1 {
            err = err + "ldext: folded across a write of the base; ";
        }
    }
    if x64 && ng_on("memcmp") && !ng_mutant("memcmp") {
        // an 8-byte field against a constant: cmp qword [b + 8], 42
        var b: Vec<MInst> = Vec::new();
        b.push(ng_mi(MO_LOAD, v + 1, v, 0, 8, 8, 0));
        b.push(ng_mi(MO_LI, v + 2, 0, 0, 42, 0, 0));
        b.push(ng_mi(MO_BRCC, v + 1, v + 2, 0, 7, NCC_EQ, 0));
        ng_fuse_memcmp(&g, &mut b, nvr, none);
        var bf: i64 = NCC_EQ | (8 << 4) | (1 << 8) | (8 << 10);
        if b.len() != 1 || b.get(0).op != MO_BRCCM || b.get(0).r1 != v || b.get(0).i0 != 7 || b.get(0).i1 != bf || b.get(0).i2 != 42 {
            err = err + "memcmp: qword against a constant; ";
        }
        // a byte flag: cmp byte [b + 3], 0 for a BNEZ
        var b2: Vec<MInst> = Vec::new();
        b2.push(ng_mi(MO_LOAD, v + 1, v, 0, 3, 1, 0));
        b2.push(ng_mi(MO_BNEZ, v + 1, 0, 0, 9, 0, 0));
        ng_fuse_memcmp(&g, &mut b2, nvr, none);
        var bf2: i64 = NCC_NE | (1 << 4) | (1 << 8) | (3 << 10);
        if b2.len() != 1 || b2.get(0).op != MO_BRCCM || b2.get(0).i1 != bf2 || b2.get(0).i0 != 9 {
            err = err + "memcmp: a branch on a byte; ";
        }
        // the load on the left of a register compare: the kind swapped
        var b3: Vec<MInst> = Vec::new();
        b3.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        b3.push(ng_mi(MO_BRCC, v + 1, v + 5, 0, 7, NCC_LT, 0));
        ng_fuse_memcmp(&g, &mut b3, nvr, none);
        var bf3: i64 = NCC_GT | (8 << 4);
        if b3.len() != 1 || b3.get(0).op != MO_BRCCM || b3.get(0).r0 != v + 5 || b3.get(0).i1 != bf3 {
            err = err + "memcmp: a register against a qword; ";
        }
        // a SETCC in its two-address form, against a constant
        var b4: Vec<MInst> = Vec::new();
        b4.push(ng_mi(MO_LOAD, v + 1, v, 0, 16, 8, 0));
        b4.push(ng_mi(MO_MOV, v + 3, v + 1, 0, 0, 0, 0));
        b4.push(ng_mi(MO_LI, v + 2, 0, 0, 1000, 0, 0));
        b4.push(ng_mi(MO_SETCC, v + 3, v + 3, v + 2, NCC_GT, 0, 0));
        b4.push(ng_mi(MO_MOV, v + 4, v + 3, 0, 0, 0, 0));
        ng_fuse_memcmp(&g, &mut b4, nvr, none);
        var sc: i64 = ng_mu_find(&b4, MO_SETCCM);
        if b4.len() != 2 || sc != 0 || b4.get(0).r0 != v + 3 || b4.get(0).r2 != v || b4.get(0).i0 != (NCC_GT | (8 << 4) | (1 << 8)) || b4.get(0).i1 != 16 || b4.get(0).i2 != 1000 {
            err = err + "memcmp: a SETCC against a constant; ";
        }
        // a signed byte against a constant out of its range: kept
        var b5: Vec<MInst> = Vec::new();
        b5.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 1, 1));
        b5.push(ng_mi(MO_LI, v + 2, 0, 0, 300, 0, 0));
        b5.push(ng_mi(MO_BRCC, v + 1, v + 2, 0, 7, NCC_LT, 0));
        ng_fuse_memcmp(&g, &mut b5, nvr, none);
        if b5.len() != 3 || ng_mu_count(&b5, MO_BRCCM) != 0 {
            err = err + "memcmp: a byte against 300; ";
        }
        // a store between the load and the compare: kept
        var b6: Vec<MInst> = Vec::new();
        b6.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        b6.push(ng_mi(MO_STORE, v, v + 4, 0, 0, 8, 0));
        b6.push(ng_mi(MO_BRCC, v + 1, v + 5, 0, 7, NCC_LT, 0));
        ng_fuse_memcmp(&g, &mut b6, nvr, none);
        if b6.len() != 3 || ng_mu_count(&b6, MO_BRCCM) != 0 {
            err = err + "memcmp: across a store; ";
        }
    }
    if x64 && ng_on("rmw") && !ng_mutant("rmw") {
        // p.f = p.f + x (two-address): add [b + 8], x
        var c: Vec<MInst> = Vec::new();
        c.push(ng_mi(MO_LOAD, v + 1, v, 0, 8, 8, 0));
        c.push(ng_mi(MO_MOV, v + 2, v + 1, 0, 0, 0, 0));
        c.push(ng_mi(MO_ADD, v + 2, v + 2, v + 6, 0, 0, 0));
        c.push(ng_mi(MO_MOV, v + 3, v + 2, 0, 0, 0, 0));
        c.push(ng_mi(MO_STORE, v, v + 3, 0, 8, 8, 0));
        ng_fuse_rmw(&g, &mut c, nvr, none);
        if c.len() != 1 || c.get(0).op != MO_ALUMST || c.get(0).r0 != v || c.get(0).r1 != v + 6 || c.get(0).i0 != 8 || c.get(0).i1 != 0 {
            err = err + "rmw: add of a register; ";
        }
        // p.f = p.f | 4: or qword [b], 4
        var c2: Vec<MInst> = Vec::new();
        c2.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        c2.push(ng_mi(MO_LI, v + 7, 0, 0, 4, 0, 0));
        c2.push(ng_mi(MO_OR, v + 2, v + 1, v + 7, 0, 0, 0));
        c2.push(ng_mi(MO_STORE, v, v + 2, 0, 0, 8, 0));
        ng_fuse_rmw(&g, &mut c2, nvr, none);
        if c2.len() != 1 || c2.get(0).op != MO_ALUMST || c2.get(0).i1 != (4 | (1 << 4)) || c2.get(0).i2 != 4 {
            err = err + "rmw: or of a constant; ";
        }
        // p.f = x - p.f: not one instruction, kept
        var c3: Vec<MInst> = Vec::new();
        c3.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        c3.push(ng_mi(MO_SUB, v + 2, v + 6, v + 1, 0, 0, 0));
        c3.push(ng_mi(MO_STORE, v, v + 2, 0, 0, 8, 0));
        ng_fuse_rmw(&g, &mut c3, nvr, none);
        if c3.len() != 3 || ng_mu_count(&c3, MO_ALUMST) != 0 {
            err = err + "rmw: x - p.f formed; ";
        }
        // the store to another field: kept
        var c4: Vec<MInst> = Vec::new();
        c4.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        c4.push(ng_mi(MO_ADD, v + 2, v + 1, v + 6, 0, 0, 0));
        c4.push(ng_mi(MO_STORE, v, v + 2, 0, 8, 8, 0));
        ng_fuse_rmw(&g, &mut c4, nvr, none);
        if c4.len() != 3 || ng_mu_count(&c4, MO_ALUMST) != 0 {
            err = err + "rmw: another field formed; ";
        }
        // the sum read again (a checked add's overflow test): kept
        var c5: Vec<MInst> = Vec::new();
        c5.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        c5.push(ng_mi(MO_ADD, v + 2, v + 1, v + 6, 0, 0, 0));
        c5.push(ng_mi(MO_STORE, v, v + 2, 0, 0, 8, 0));
        c5.push(ng_mi(MO_MOV, v + 8, v + 2, 0, 0, 0, 0));
        ng_fuse_rmw(&g, &mut c5, nvr, none);
        if c5.len() != 4 || ng_mu_count(&c5, MO_ALUMST) != 0 {
            err = err + "rmw: a sum read again formed; ";
        }
    }
    if !x64 {
        // load / store machines: no compare against memory, no
        // read-modify-write
        var d: Vec<MInst> = Vec::new();
        d.push(ng_mi(MO_LOAD, v + 1, v, 0, 8, 8, 0));
        d.push(ng_mi(MO_LI, v + 2, 0, 0, 42, 0, 0));
        d.push(ng_mi(MO_BRCC, v + 1, v + 2, 0, 7, NCC_EQ, 0));
        ng_fuse_memcmp(&g, &mut d, nvr, none);
        var d2: Vec<MInst> = Vec::new();
        d2.push(ng_mi(MO_LOAD, v + 1, v, 0, 8, 8, 0));
        d2.push(ng_mi(MO_ADD, v + 2, v + 1, v + 6, 0, 0, 0));
        d2.push(ng_mi(MO_STORE, v, v + 2, 0, 8, 8, 0));
        ng_fuse_rmw(&g, &mut d2, nvr, none);
        if d.len() != 3 || d2.len() != 3 {
            err = err + "memory operands formed on a load / store machine; ";
        }
    }
    if err != "" {
        return "memory-operand folds (OP18): " + err;
    }
    return "";
}

/// TG7/TG8: do two encoders hold the same bytes (and at least one)?
fn ng_tg_same(x: &NatEnc, y: &NatEnc) -> bool {
    if x.code.len() != y.code.len() || x.code.len() == 0 {
        return false;
    }
    var q: i64 = 0;
    while q < x.code.len() {
        if x.code.get(q) != y.code.get(q) {
            return false;
        }
        q = q + 1;
    }
    return true;
}

/// TG7/TG8: an allocation of `n` vregs, all in registers (vreg i in
/// register i % 8), for the unit cases below to spill by hand.
fn ng_tg_alloc(n: i64) -> NatAlloc {
    var assign: Vec<i64> = Vec::new();
    var zeros: Vec<i64> = Vec::new();
    var zeros2: Vec<i64> = Vec::new();
    var spill: Vec<i64> = Vec::new();
    var cls: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        assign.push(i % 8);
        zeros.push(0);
        zeros2.push(0);
        spill.push(0 - 1);
        cls.push(0);
        i = i + 1;
    }
    return NatAlloc {
        assign: assign, remat: zeros, remat_val: zeros2, spill: spill, frame: 64, save_regs: Vec::new(), save_off: 0, mask: 0, err: "", cls: cls
    };
}

/// TG7/TG8: the selections of llvm-roadmap TG7 and TG8 on small cases
/// (tests/nattools/tg78_unit.fd runs it through `fid run`):
///   x86-64  BLSR's kinds from ng_fuse_bits under --cpu x86-64-v3 (a & (a
///           - 1), a ^ (a - 1), a & -a, a & (0 - a)), none without it;
///           ng_rmw_slot's decisions; the bytes of ng_x64_rmw_slot and
///           ng_x64_cmp_slot (the compare kind swapped when the slot is the
///           left side, `cmp qword [rsp + off], 0` against zero)
///   AArch64 ng_wb_pair's moves and refusals; ng_a64_wb_fuse's words (post-
///           and pre-indexed loads and stores, a step by a SUB) and
///           refusals (t = n, a label between, an offset that is neither
///           0 nor the step, a step past 9 bits, sp as the base)
/// "" when every case holds.
pub fn nat_tg78_unit_check(arch: i64) -> str {
    var err: str = "";
    var v: i64 = NG_VBASE;
    var nvr: i64 = NG_VBASE + 16;
    var none: i64 = 0 - 1;
    if arch == NAT_X64 {
        var cpu0: str = g_nat_cpu;
        g_nat_cpu = "x86-64-v3";
        var g: NatGen = NatGen_new(arch);
        if ng_on("blsr") && ng_on("blsmsk") && ng_on("blsi") && !ng_mutant("blsx") {
            // a & (a - 1), a ^ (a - 1), a & -a, a & (0 - a)
            var b0: Vec<MInst> = Vec::new();
            b0.push(ng_mi(MO_LI, v + 1, 0, 0, 1, 0, 0));
            b0.push(ng_mi(MO_SUB, v + 2, v, v + 1, 0, 0, 0));
            b0.push(ng_mi(MO_AND, v + 3, v, v + 2, 0, 0, 0));
            b0.push(ng_mi(MO_MOV, 0, v + 3, 0, 0, 0, 0));
            ng_fuse_bits(&g, &mut b0, nvr, none);
            if ng_mu_count(&b0, MO_BLSR) != 1 || ng_mu_count(&b0, MO_SUB) != 0 || b0.get(0).i0 != 0 {
                err = err + "blsr: a & (a - 1); ";
            }
            var b1: Vec<MInst> = Vec::new();
            b1.push(ng_mi(MO_LI, v + 1, 0, 0, 1, 0, 0));
            b1.push(ng_mi(MO_SUB, v + 2, v, v + 1, 0, 0, 0));
            b1.push(ng_mi(MO_XOR, v + 3, v + 2, v, 0, 0, 0));
            b1.push(ng_mi(MO_MOV, 0, v + 3, 0, 0, 0, 0));
            ng_fuse_bits(&g, &mut b1, nvr, none);
            if ng_mu_count(&b1, MO_BLSR) != 1 || b1.get(0).op != MO_BLSR || b1.get(0).i0 != 1 || b1.get(0).r1 != v {
                err = err + "blsmsk: a ^ (a - 1); ";
            }
            var b2: Vec<MInst> = Vec::new();
            b2.push(ng_mi(MO_NEG, v + 2, v, 0, 0, 0, 0));
            b2.push(ng_mi(MO_AND, v + 3, v, v + 2, 0, 0, 0));
            b2.push(ng_mi(MO_MOV, 0, v + 3, 0, 0, 0, 0));
            ng_fuse_bits(&g, &mut b2, nvr, none);
            if b2.len() != 2 || b2.get(0).op != MO_BLSR || b2.get(0).i0 != 2 || b2.get(0).r1 != v {
                err = err + "blsi: a & -a; ";
            }
            var b3: Vec<MInst> = Vec::new();
            b3.push(ng_mi(MO_LI, v + 1, 0, 0, 0, 0, 0));
            b3.push(ng_mi(MO_SUB, v + 2, v + 1, v, 0, 0, 0));
            b3.push(ng_mi(MO_AND, v + 3, v + 2, v, 0, 0, 0));
            b3.push(ng_mi(MO_MOV, 0, v + 3, 0, 0, 0, 0));
            ng_fuse_bits(&g, &mut b3, nvr, none);
            if ng_mu_count(&b3, MO_BLSR) != 1 || b3.get(0).i0 != 2 {
                err = err + "blsi: a & (0 - a); ";
            }
            // -a under XOR is no BMI1 operation: kept
            var b4: Vec<MInst> = Vec::new();
            b4.push(ng_mi(MO_NEG, v + 2, v, 0, 0, 0, 0));
            b4.push(ng_mi(MO_XOR, v + 3, v, v + 2, 0, 0, 0));
            ng_fuse_bits(&g, &mut b4, nvr, none);
            if ng_mu_count(&b4, MO_BLSR) != 0 || b4.len() != 2 {
                err = err + "blsi: a ^ -a selected; ";
            }
            // a - 1 read again: kept
            var b5: Vec<MInst> = Vec::new();
            b5.push(ng_mi(MO_LI, v + 1, 0, 0, 1, 0, 0));
            b5.push(ng_mi(MO_SUB, v + 2, v, v + 1, 0, 0, 0));
            b5.push(ng_mi(MO_XOR, v + 3, v, v + 2, 0, 0, 0));
            b5.push(ng_mi(MO_ADD, v + 4, v + 3, v + 2, 0, 0, 0));
            ng_fuse_bits(&g, &mut b5, nvr, none);
            if ng_mu_count(&b5, MO_BLSR) != 0 {
                err = err + "blsmsk: a - 1 read again; ";
            }
            // the bytes: BLSMSK, BLSI
            var eb1: NatGen = NatGen_new(arch);
            ng_blsr(&mut eb1, 0, 1, 1);
            ng_blsr(&mut eb1, 9, 12, 2);
            var x1: NatGen = NatGen_new(arch);
            x64_blsmsk(&mut x1.e, 0, 1);
            x64_blsi(&mut x1.e, 9, 12);
            if !ng_tg_same(&eb1.e, &x1.e) || eb1.e.code.get(3) != 0xF3 || eb1.e.code.get(4) != 0xD1 {
                err = err + "blsmsk / blsi bytes; ";
            }
        }
        g_nat_cpu = "";
        var gb: NatGen = NatGen_new(arch);
        var c0: Vec<MInst> = Vec::new();
        c0.push(ng_mi(MO_NEG, v + 2, v, 0, 0, 0, 0));
        c0.push(ng_mi(MO_AND, v + 3, v, v + 2, 0, 0, 0));
        ng_fuse_bits(&gb, &mut c0, nvr, none);
        if ng_mu_count(&c0, MO_BLSR) != 0 {
            err = err + "blsi without --cpu x86-64-v3; ";
        }
        g_nat_cpu = cpu0;
        // ng_rmw_slot: v0 and v2 spilled to 16 (one copy class), v4 to 24
        var al: NatAlloc = ng_tg_alloc(8);
        al.assign.set(0, 0 - 1);
        al.spill.set(0, 16);
        al.assign.set(2, 0 - 1);
        al.spill.set(2, 16);
        al.assign.set(4, 0 - 1);
        al.spill.set(4, 24);
        if ng_rmw_slot(ng_mi(MO_ADD, v, v, v + 1, 0, 0, 0), &al, 8) != 16 {
            err = err + "rmwslot: x = x + r; ";
        }
        if ng_rmw_slot(ng_mi(MO_SUB, v, v + 2, v + 4, 0, 0, 0), &al, 8) != 16 {
            err = err + "rmwslot: one slot, the operand in another; ";
        }
        if ng_rmw_slot(ng_mi(MO_ADDI, v, v, 0, 5, 0, 0), &al, 8) != 16 {
            err = err + "rmwslot: x = x + 5; ";
        }
        if ng_rmw_slot(ng_mi(MO_ADD, v, v, v, 0, 0, 0), &al, 8) >= 0 || ng_rmw_slot(ng_mi(MO_MUL, v, v, v + 1, 0, 0, 0), &al, 8) >= 0 {
            err = err + "rmwslot: x + x or a multiply; ";
        }
        if ng_rmw_slot(ng_mi(MO_ADD, v, v + 4, v + 1, 0, 0, 0), &al, 8) >= 0 || ng_rmw_slot(ng_mi(MO_ADD, v + 1, v + 1, v + 3, 0, 0, 0), &al, 8) >= 0 {
            err = err + "rmwslot: two slots, or in registers; ";
        }
        if ng_rmw_slot(ng_mi(MO_ADDI, v, v, 0, 1099511627776, 0, 0), &al, 8) >= 0 {
            err = err + "rmwslot: a constant past 32 bits; ";
        }
        al.remat.set(2, NG_REMAT_LI);
        if ng_rmw_slot(ng_mi(MO_SUB, v, v + 2, v + 1, 0, 0, 0), &al, 8) >= 0 {
            err = err + "rmwslot: a rematerialized operand; ";
        }
        if !ng_mutant("rmwslot") {
            var rs1: NatGen = NatGen_new(arch);
            ng_x64_rmw_slot(&mut rs1, ng_mi(MO_SUB, v, v, v + 1, 0, 0, 0), 3, 16);
            ng_x64_rmw_slot(&mut rs1, ng_mi(MO_ADDI, v, v, 0, 0 - 300, 0, 0), 0, 24);
            var y1: NatGen = NatGen_new(arch);
            x64_alu_to_mem(&mut y1.e, 0x29, 3, 4, 16);
            x64_alu_mem_imm(&mut y1.e, 0, 4, 24, 0 - 300);
            if !ng_tg_same(&rs1.e, &y1.e) {
                err = err + "rmwslot bytes; ";
            }
        }
        if !ng_mutant("cmpslot") {
            // the slot on the right: as written; on the left: swapped;
            // against zero: the slot is the left side
            var k1: NatGen = NatGen_new(arch);
            var l1: i64 = NatEnc_label(&mut k1.e);
            ng_x64_cmp_slot(&mut k1, ng_mi(MO_BRCC, 3, v, 0, l1, NCC_LT, 0), 3, 0 - 1, 0, 16, false);
            ng_x64_cmp_slot(&mut k1, ng_mi(MO_BRCC, v, 3, 0, l1, NCC_LT, 0), 0 - 1, 3, 0, 16, true);
            ng_x64_cmp_slot(&mut k1, ng_mi(MO_BRCC, v, 60, 0, l1, NCC_LT, 0), 0 - 1, 60, 0, 16, true);
            ng_x64_cmp_slot(&mut k1, ng_mi(MO_SETCC, 0, v, 6, NCC_LTU, 0, 0), 0, 0 - 1, 6, 8, true);
            var z1: NatGen = NatGen_new(arch);
            var lz: i64 = NatEnc_label(&mut z1.e);
            x64_alu_mem(&mut z1.e, 0x3B, 3, 4, 16);
            x64_jcc(&mut z1.e, ng_x64_cc(NCC_LT), lz);
            x64_alu_mem(&mut z1.e, 0x3B, 3, 4, 16);
            x64_jcc(&mut z1.e, ng_x64_cc(NCC_GT), lz);
            x64_cmp_mem_imm(&mut z1.e, 8, 4, 16, 0);
            x64_jcc(&mut z1.e, ng_x64_cc(NCC_LT), lz);
            x64_alu_mem(&mut z1.e, 0x3B, 6, 4, 8);
            x64_setcc(&mut z1.e, ng_x64_cc(NCC_GTU), 11);
            x64_movx(&mut z1.e, 0xB6, 0, 11);
            if !ng_tg_same(&k1.e, &z1.e) {
                err = err + "cmpslot bytes; ";
            }
        }
    }
    if arch == NAT_A64 && ng_on("wbidx") && !ng_mutant("wbidx") {
        var ga: NatGen = NatGen_new(arch);
        // the step moves up to its load, over an add and a line row
        var w0: Vec<MInst> = Vec::new();
        w0.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        w0.push(ng_mi(MO_ADD, v + 2, v + 2, v + 1, 0, 0, 0));
        w0.push(ng_mi(MO_LINE, 0, 0, 0, 7, 0, 0));
        w0.push(ng_mi(MO_ADDI, v + 3, v, 0, 8, 0, 0));
        if ng_wb_pair(&ga, &mut w0, nvr, none) != 1 || w0.get(1).op != MO_ADDI || w0.get(1).r0 != v + 3 || w0.get(3).op != MO_LINE {
            err = err + "wbpair: step after a load; ";
        }
        // through a copy of the pointer, and a store at the step's offset
        var w1: Vec<MInst> = Vec::new();
        w1.push(ng_mi(MO_MOV, v + 5, v, 0, 0, 0, 0));
        w1.push(ng_mi(MO_STORE, v + 5, v + 1, 0, 16, 4, 0));
        w1.push(ng_mi(MO_ADD, v + 2, v + 2, v + 1, 0, 0, 0));
        w1.push(ng_mi(MO_ADDI, v + 3, v, 0, 16, 0, 0));
        if ng_wb_pair(&ga, &mut w1, nvr, none) != 1 || w1.get(2).op != MO_ADDI {
            err = err + "wbpair: step after a store through a copy; ";
        }
        // the lowering's two-address step: one ADDI v3, v, 8 after the load
        var w7: Vec<MInst> = Vec::new();
        w7.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        w7.push(ng_mi(MO_ADD, v + 2, v + 2, v + 1, 0, 0, 0));
        w7.push(ng_mi(MO_MOV, v + 3, v, 0, 0, 0, 0));
        w7.push(ng_mi(MO_LINE, 0, 0, 0, 9, 0, 0));
        w7.push(ng_mi(MO_ADDI, v + 3, v + 3, 0, 8, 0, 0));
        if ng_wb_pair(&ga, &mut w7, nvr, none) != 1 || w7.len() != 4 || w7.get(1).op != MO_ADDI || w7.get(1).r0 != v + 3 || w7.get(1).r1 != v || w7.get(2).op != MO_ADD {
            err = err + "wbpair: two-address step; ";
        }
        // refusals: the step's result read between, the pointer written
        // between, a label between, another offset, a step past 9 bits
        var w2: Vec<MInst> = Vec::new();
        w2.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        w2.push(ng_mi(MO_ADD, v + 2, v + 3, v + 1, 0, 0, 0));
        w2.push(ng_mi(MO_ADDI, v + 3, v, 0, 8, 0, 0));
        var w3: Vec<MInst> = Vec::new();
        w3.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        w3.push(ng_mi(MO_MOV, v, v + 6, 0, 0, 0, 0));
        w3.push(ng_mi(MO_ADDI, v + 3, v, 0, 8, 0, 0));
        var w4: Vec<MInst> = Vec::new();
        w4.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        w4.push(ng_mi(MO_PLACE, 0, 0, 0, 3, 0, 0));
        w4.push(ng_mi(MO_ADDI, v + 3, v, 0, 8, 0, 0));
        var w5: Vec<MInst> = Vec::new();
        w5.push(ng_mi(MO_LOAD, v + 1, v, 0, 24, 8, 0));
        w5.push(ng_mi(MO_ADD, v + 2, v + 2, v + 1, 0, 0, 0));
        w5.push(ng_mi(MO_ADDI, v + 3, v, 0, 8, 0, 0));
        var w6: Vec<MInst> = Vec::new();
        w6.push(ng_mi(MO_LOAD, v + 1, v, 0, 0, 8, 0));
        w6.push(ng_mi(MO_ADD, v + 2, v + 2, v + 1, 0, 0, 0));
        w6.push(ng_mi(MO_ADDI, v + 3, v, 0, 512, 0, 0));
        var nref: i64 = ng_wb_pair(&ga, &mut w2, nvr, none) + ng_wb_pair(&ga, &mut w3, nvr, none) + ng_wb_pair(&ga, &mut w4, nvr, none) + ng_wb_pair(&ga, &mut w5, nvr, none) + ng_wb_pair(&ga, &mut w6, nvr, none);
        if nref != 0 {
            err = err + "wbpair: moved where it must not (" + int_to_str(nref) + "); ";
        }
        // the words: ldr x0, [x1], #8 = 0xF8408420; ldr x0, [x1, #8]! =
        // 0xF8408C20 (both ways round); str x2, [x3], #-8 = 0xF81F8462;
        // ldrsw x4, [x5, #4]! = 0xB8804CA4; ldrb w6, [x7], #1 = 0x384014E6
        var e1: NatGen = NatGen_new(arch);
        a64_ldr_sized(&mut e1.e, 0, 1, 0, 8, false);
        a64_add_imm(&mut e1.e, 1, 1, 8);
        var f1: bool = ng_a64_wb_fuse(&mut e1);
        var e2: NatGen = NatGen_new(arch);
        a64_ldr_sized(&mut e2.e, 0, 1, 8, 8, false);
        a64_add_imm(&mut e2.e, 1, 1, 8);
        var f2: bool = ng_a64_wb_fuse(&mut e2);
        var e3: NatGen = NatGen_new(arch);
        a64_add_imm(&mut e3.e, 1, 1, 8);
        a64_ldr_sized(&mut e3.e, 0, 1, 0, 8, false);
        var f3: bool = ng_a64_wb_fuse(&mut e3);
        var e4: NatGen = NatGen_new(arch);
        a64_str_sized(&mut e4.e, 2, 3, 0, 8);
        a64_sub_imm(&mut e4.e, 3, 3, 8);
        var f4: bool = ng_a64_wb_fuse(&mut e4);
        var e5: NatGen = NatGen_new(arch);
        a64_add_imm(&mut e5.e, 5, 5, 4);
        a64_ldr_sized(&mut e5.e, 4, 5, 0, 4, true);
        var f5: bool = ng_a64_wb_fuse(&mut e5);
        var e6: NatGen = NatGen_new(arch);
        a64_ldr_sized(&mut e6.e, 6, 7, 0, 1, false);
        a64_add_imm(&mut e6.e, 7, 7, 1);
        var f6: bool = ng_a64_wb_fuse(&mut e6);
        if !f1 || e1.e.code.len() != 4 || ng_code_word(&e1, 0) != 0xF8408420 {
            err = err + "wb: post-indexed ldr; ";
        }
        if !f2 || e2.e.code.len() != 4 || ng_code_word(&e2, 0) != 0xF8408C20 {
            err = err + "wb: pre-indexed ldr (access first); ";
        }
        if !f3 || e3.e.code.len() != 4 || ng_code_word(&e3, 0) != 0xF8408C20 {
            err = err + "wb: pre-indexed ldr (step first); ";
        }
        if !f4 || e4.e.code.len() != 4 || ng_code_word(&e4, 0) != 0xF81F8462 {
            err = err + "wb: post-indexed str, a step down; ";
        }
        if !f5 || e5.e.code.len() != 4 || ng_code_word(&e5, 0) != 0xB8804CA4 {
            err = err + "wb: pre-indexed ldrsw; ";
        }
        if !f6 || e6.e.code.len() != 4 || ng_code_word(&e6, 0) != 0x384014E6 {
            err = err + "wb: post-indexed ldrb; ";
        }
        // refusals: t = n, a label between, another offset, a step past 9
        // bits, sp as the base
        var r1: NatGen = NatGen_new(arch);
        a64_ldr_sized(&mut r1.e, 1, 1, 0, 8, false);
        a64_add_imm(&mut r1.e, 1, 1, 8);
        var r2: NatGen = NatGen_new(arch);
        a64_ldr_sized(&mut r2.e, 0, 1, 0, 8, false);
        var lb: i64 = NatEnc_label(&mut r2.e);
        NatEnc_place(&mut r2.e, lb);
        a64_add_imm(&mut r2.e, 1, 1, 8);
        var r3: NatGen = NatGen_new(arch);
        a64_ldr_sized(&mut r3.e, 0, 1, 16, 8, false);
        a64_add_imm(&mut r3.e, 1, 1, 8);
        var r4: NatGen = NatGen_new(arch);
        a64_ldr_sized(&mut r4.e, 0, 1, 0, 8, false);
        a64_add_imm(&mut r4.e, 1, 1, 256);
        var r5: NatGen = NatGen_new(arch);
        a64_ldr_sized(&mut r5.e, 0, 31, 0, 8, false);
        a64_add_imm(&mut r5.e, 31, 31, 16);
        if ng_a64_wb_fuse(&mut r1) || ng_a64_wb_fuse(&mut r2) || ng_a64_wb_fuse(&mut r3) || ng_a64_wb_fuse(&mut r4) || ng_a64_wb_fuse(&mut r5) {
            err = err + "wb: fused where it must not; ";
        }
        if r1.e.code.len() != 8 || r2.e.code.len() != 8 || r3.e.code.len() != 8 || r4.e.code.len() != 8 || r5.e.code.len() != 8 {
            err = err + "wb: a refusal changed the code; ";
        }
    }
    if err != "" {
        return "TG7/TG8 selections: " + err;
    }
    return "";
}

pub fn nat_sel_check(arch: i64) -> str {
    var cases: Vec<i64> = nat_sel_cases(arch);
    var k: i64 = 0;
    while k + 4 < cases.len() {
        var g: NatGen = NatGen_new(arch);
        g.rec = false;
        var op: i64 = cases.get(k);
        var d: i64 = cases.get(k + 1);
        var a: i64 = cases.get(k + 2);
        var b: i64 = cases.get(k + 3);
        var imm: i64 = cases.get(k + 4);
        if b == 0 - 2 {
            b = g.zr;
        }
        if op == MO_MOV {
            ng_mov(&mut g, d, a);
        } else {
            var m: MInst = ng_sel_case_mi(op, d, a, b, imm);
            ng_mi_dispatch(&mut g, m, d, a, b);
        }
        var err: str = nat_sel_eval_case(arch, g.e.code, op, d, a, b, imm, g.zr);
        if err != "" {
            return err;
        }
        // TG1: the selection table and the hand-written selection agree
        // byte for byte
        if op != MO_MOV && ng_isel_on() && ng_isel_covers(op) {
            var h: NatGen = NatGen_new(arch);
            h.rec = false;
            var mh: MInst = ng_sel_case_mi(op, d, a, b, imm);
            g_ng_isel_state = 2;
            ng_mi_dispatch(&mut h, mh, d, a, b);
            g_ng_isel_state = 1;
            var same: bool = h.e.code.len() == g.e.code.len();
            var q: i64 = 0;
            while same && q < h.e.code.len() {
                if h.e.code.get(q) != g.e.code.get(q) {
                    same = false;
                }
                q = q + 1;
            }
            if !same {
                return "TG1: the selection table and the hand-written selection differ on " + mi_op_name(op) + " d=" + int_to_str(d) + " a=" + int_to_str(a) + " b=" + int_to_str(b) + " imm=" + int_to_str(imm);
            }
        }
        k = k + 5;
    }
    // RL6: floats, loads and stores, branches and calls, evaluated too
    var xerr: str = nat_sel_check_more(arch);
    if xerr != "" {
        return xerr;
    }
    // TG11: MO_VBIN's rows against its hand-written selection
    var verr: str = nat_vsel_check(arch);
    if verr != "" {
        return verr;
    }
    // TG11: the vector liveness check (vector values and calls)
    var vlerr: str = nat_vlive_unit_check();
    if vlerr != "" {
        return vlerr;
    }
    // OP18: the memory-operand folds on small MIR sequences
    var muerr: str = nat_memop_unit_check(arch);
    if muerr != "" {
        return muerr;
    }
    // OP12: struct results in two registers, both halves
    var rferr: str = nat_retfwd_unit_check(arch);
    if rferr != "" {
        return rferr;
    }
    // TG1: the memory, branch and float rules against the hand-written
    // selection, byte for byte
    var merr: str = nat_isel_mem_check(arch);
    if merr != "" {
        return merr;
    }
    // TG1: division .. the memory-operand ALU (ng_isel_rows_tg1b) against
    // the hand-written selection, byte for byte
    var terr: str = nat_isel_tg1b_check(arch);
    if terr != "" {
        return terr;
    }
    // TG2: each rule alone, on random operands
    return nat_isel_rule_check(arch);
}

/// The MIR operation of one nat_sel_cases case [op, d, a, b, imm]: a
/// SHI's case immediate is count | (kind << 6) (nat_enc.fd NSEL_SHI).
fn ng_sel_case_mi(op: i64, d: i64, a: i64, b: i64, imm: i64) -> MInst {
    if op == MO_SHI {
        return MInst {
            op: op, r0: d, r1: a, r2: b, i0: imm & 63, i1: (imm >> 6) & 3, i2: 0
        };
    }
    return MInst {
        op: op, r0: d, r1: a, r2: b, i0: imm, i1: 0, i2: 0
    };
}

/// RL6: translation validation beyond the integer ALU (FID_VERIFY=1, from
/// nat_sel_check): float operations, loads and stores, branches and calls,
/// each selected alone with physical registers through ng_mi_dispatch (the
/// replay's own path), and the bytes run by nat_enc.fd's evaluator against
/// the operation's meaning (nat_sel_eval_float / _mem / _branch / _call).
/// "" or the first mismatch.
pub fn nat_sel_check_more(arch: i64) -> str {
    var err: str = nat_sel_float_check(arch);
    if err != "" {
        return "RL6 floats: " + err;
    }
    err = nat_sel_mem_eval_check(arch);
    if err != "" {
        return "RL6 memory: " + err;
    }
    err = nat_sel_branch_check(arch);
    if err != "" {
        return "RL6 branches: " + err;
    }
    err = nat_sel_call_check(arch);
    if err != "" {
        return "RL6 calls: " + err;
    }
    return "";
}

/// RL6: one part of nat_sel_check_more (0 floats, 1 memory, 2 branches,
/// 3 calls), for tests/nattools/selcheck_more_unit.fd.
pub fn nat_sel_check_more_part(arch: i64, part: i64) -> str {
    if part == 0 {
        return nat_sel_float_check(arch);
    }
    if part == 1 {
        return nat_sel_mem_eval_check(arch);
    }
    if part == 2 {
        return nat_sel_branch_check(arch);
    }
    return nat_sel_call_check(arch);
}

/// RL6: one operation selected alone on a fresh generator of `arch`.
fn ng_sel_one(arch: i64, m: MInst) -> NatGen {
    var g: NatGen = NatGen_new(arch);
    g.rec = false;
    ng_mi_dispatch(&mut g, m, m.r0, m.r1, m.r2);
    return g;
}

/// RL6: MO_FBIN (each operation), MO_FCMP (each kind), MO_I2F and MO_F2I,
/// f64 and f32, with the destination one of the operands or neither, in
/// general registers and (FID_NAT_ON=fregs) float registers.
fn nat_sel_float_check(arch: i64) -> str {
    var g0: NatGen = NatGen_new(arch);
    var rs: Vec<i64> = ng_isel_test_regs(&g0);
    var d: i64 = rs.get(1);
    var a: i64 = rs.get(2);
    var b: i64 = rs.get(3);
    var fr: i64 = 0 - 1;
    var fr2: i64 = 0 - 1;
    if ng_fregs_on(&g0) && g0.td.float_pool.len() > 1 {
        fr = g0.td.float_pool.get(0);
        fr2 = g0.td.float_pool.get(1);
    }
    // [d, a, b] triples
    var tri: Vec<i64> = Vec::new();
    tri.push(d);
    tri.push(a);
    tri.push(b);
    tri.push(a);
    tri.push(a);
    tri.push(b);
    tri.push(b);
    tri.push(a);
    tri.push(b);
    tri.push(a);
    tri.push(a);
    tri.push(a);
    if fr >= 0 {
        tri.push(fr);
        tri.push(fr);
        tri.push(fr2);
        tri.push(fr2);
        tri.push(fr);
        tri.push(fr2);
        tri.push(d);
        tri.push(fr);
        tri.push(b);
        tri.push(fr);
        tri.push(a);
        tri.push(b);
        tri.push(d);
        tri.push(a);
        tri.push(fr2);
    }
    var w: i64 = 0;
    while w < 2 {
        var t: i64 = 0;
        while t + 2 < tri.len() {
            var td: i64 = tri.get(t);
            var ta: i64 = tri.get(t + 1);
            var tb: i64 = tri.get(t + 2);
            var fo: i64 = 1;
            while fo <= 4 {
                var g: NatGen = ng_sel_one(arch, MInst {
                    op: MO_FBIN, r0: td, r1: ta, r2: tb, i0: fo, i1: w, i2: 0
                });
                var err: str = nat_sel_eval_float(arch, g.e.code, NSEL_FBIN, td, ta, tb, fo, w);
                if err != "" {
                    return err;
                }
                fo = fo + 1;
            }
            // a compare's result is an integer: never in a float register
            if td < NG_FREG {
                var cc: i64 = NCC_EQ;
                while cc <= NCC_GE {
                    var gc: NatGen = ng_sel_one(arch, MInst {
                        op: MO_FCMP, r0: td, r1: ta, r2: tb, i0: cc, i1: w, i2: 0
                    });
                    var cerr: str = nat_sel_eval_float(arch, gc.e.code, NSEL_FCMP, td, ta, tb, cc, w);
                    if cerr != "" {
                        return cerr;
                    }
                    cc = cc + 1;
                }
            }
            t = t + 3;
        }
        // conversions: [d, s] pairs; I2F's source and F2I's result are
        // integers (general registers)
        var cv: Vec<i64> = Vec::new();
        cv.push(d);
        cv.push(a);
        cv.push(a);
        cv.push(a);
        if fr >= 0 {
            cv.push(fr);
            cv.push(a);
        }
        var c: i64 = 0;
        while c + 1 < cv.len() {
            var cd: i64 = cv.get(c);
            var cs: i64 = cv.get(c + 1);
            var gi: NatGen = ng_sel_one(arch, MInst {
                op: MO_I2F, r0: cd, r1: cs, r2: 0, i0: w, i1: 0, i2: 0
            });
            var ierr: str = nat_sel_eval_float(arch, gi.e.code, NSEL_I2F, cd, cs, cs, 0, w);
            if ierr != "" {
                return ierr;
            }
            c = c + 2;
        }
        var fv: Vec<i64> = Vec::new();
        fv.push(d);
        fv.push(a);
        fv.push(a);
        fv.push(a);
        if fr >= 0 {
            fv.push(d);
            fv.push(fr);
        }
        c = 0;
        while c + 1 < fv.len() {
            var fd: i64 = fv.get(c);
            var fs: i64 = fv.get(c + 1);
            var gf: NatGen = ng_sel_one(arch, MInst {
                op: MO_F2I, r0: fd, r1: fs, r2: 0, i0: w, i1: 0, i2: 0
            });
            var ferr: str = nat_sel_eval_float(arch, gf.e.code, NSEL_F2I, fd, fs, fs, 0, w);
            if ferr != "" {
                return ferr;
            }
            c = c + 2;
        }
        w = w + 1;
    }
    return "";
}

/// RL6: MO_LOAD / MO_STORE of every size and sign at displacements inside
/// and outside each target's immediate, from a register and from the
/// stack pointer, into and from float registers (FID_NAT_ON=fregs); and
/// MO_LDX / MO_STX with every scale, an index no indexed form takes, and
/// AArch64's xzr as the stored value. The evaluator models memory: a
/// load must read the bytes at the address, a store write exactly them.
fn nat_sel_mem_eval_check(arch: i64) -> str {
    var g0: NatGen = NatGen_new(arch);
    var rs: Vec<i64> = ng_isel_test_regs(&g0);
    var r0: i64 = rs.get(1);
    var r1: i64 = rs.get(2);
    var r2: i64 = rs.get(3);
    var sp: i64 = 4;
    var badix: i64 = 4;
    if arch == NAT_A64 {
        sp = 31;
        badix = 31;
    }
    if arch == NAT_RV64 {
        sp = 2;
        badix = r2;
    }
    var fr: i64 = 0 - 1;
    if ng_fregs_on(&g0) && g0.td.float_pool.len() > 0 {
        fr = g0.td.float_pool.get(0);
    }
    var disps: Vec<i64> = Vec::new();
    disps.push(0);
    disps.push(8);
    disps.push(0 - 8);
    disps.push(127);
    disps.push(2047);
    disps.push(2048);
    disps.push(0 - 2049);
    disps.push(4088);
    disps.push(32768);
    disps.push(1048576);
    var size: i64 = 1;
    while size <= 8 {
        var di: i64 = 0;
        while di < disps.len() {
            var disp: i64 = disps.get(di);
            var sg: i64 = 0;
            while sg < 2 {
                var gl: NatGen = ng_sel_one(arch, MInst {
                    op: MO_LOAD, r0: r0, r1: r1, r2: 0, i0: disp, i1: size, i2: sg
                });
                var err: str = nat_sel_eval_mem(arch, gl.e.code, false, r0, r1, 0 - 1, 0, disp, size, sg != 0);
                if err != "" {
                    return err;
                }
                var gs: NatGen = ng_sel_one(arch, MInst {
                    op: MO_LOAD, r0: r0, r1: sp, r2: 0, i0: disp, i1: size, i2: sg
                });
                err = nat_sel_eval_mem(arch, gs.e.code, false, r0, sp, 0 - 1, 0, disp, size, sg != 0);
                if err != "" {
                    return err;
                }
                sg = sg + 1;
            }
            var gt: NatGen = ng_sel_one(arch, MInst {
                op: MO_STORE, r0: r1, r1: r0, r2: 0, i0: disp, i1: size, i2: 0
            });
            var serr: str = nat_sel_eval_mem(arch, gt.e.code, true, r0, r1, 0 - 1, 0, disp, size, false);
            if serr != "" {
                return serr;
            }
            var gu: NatGen = ng_sel_one(arch, MInst {
                op: MO_STORE, r0: sp, r1: r0, r2: 0, i0: disp, i1: size, i2: 0
            });
            serr = nat_sel_eval_mem(arch, gu.e.code, true, r0, sp, 0 - 1, 0, disp, size, false);
            if serr != "" {
                return serr;
            }
            if fr >= 0 && (size == 4 || size == 8) {
                var gfl: NatGen = ng_sel_one(arch, MInst {
                    op: MO_LOAD, r0: fr, r1: r1, r2: 0, i0: disp, i1: size, i2: 0
                });
                serr = nat_sel_eval_mem(arch, gfl.e.code, false, fr, r1, 0 - 1, 0, disp, size, false);
                if serr != "" {
                    return serr;
                }
                var gfs: NatGen = ng_sel_one(arch, MInst {
                    op: MO_STORE, r0: r1, r1: fr, r2: 0, i0: disp, i1: size, i2: 0
                });
                serr = nat_sel_eval_mem(arch, gfs.e.code, true, fr, r1, 0 - 1, 0, disp, size, false);
                if serr != "" {
                    return serr;
                }
            }
            di = di + 1;
        }
        var sh: i64 = 0;
        while sh <= 3 {
            var xd: i64 = 0;
            while xd < 3 {
                var xdisp: i64 = 0;
                if xd == 1 {
                    xdisp = 16;
                }
                if xd == 2 {
                    xdisp = 0 - 8;
                }
                var xs: i64 = 0;
                while xs < 2 {
                    var gx: NatGen = ng_sel_one(arch, MInst {
                        op: MO_LDX, r0: r0, r1: r1, r2: r2, i0: xdisp, i1: size, i2: (sh << 1) | xs
                    });
                    var xerr: str = nat_sel_eval_mem(arch, gx.e.code, false, r0, r1, r2, sh, xdisp, size, xs != 0);
                    if xerr != "" {
                        return xerr;
                    }
                    var gb: NatGen = ng_sel_one(arch, MInst {
                        op: MO_LDX, r0: r0, r1: r1, r2: badix, i0: xdisp, i1: size, i2: (sh << 1) | xs
                    });
                    xerr = nat_sel_eval_mem(arch, gb.e.code, false, r0, r1, badix, sh, xdisp, size, xs != 0);
                    if xerr != "" {
                        return xerr;
                    }
                    xs = xs + 1;
                }
                var gy: NatGen = ng_sel_one(arch, MInst {
                    op: MO_STX, r0: r1, r1: r0, r2: r2, i0: xdisp, i1: size, i2: sh << 1
                });
                var yerr: str = nat_sel_eval_mem(arch, gy.e.code, true, r0, r1, r2, sh, xdisp, size, false);
                if yerr != "" {
                    return yerr;
                }
                if arch == NAT_A64 {
                    var gz: NatGen = ng_sel_one(arch, MInst {
                        op: MO_STX, r0: r1, r1: 31, r2: r2, i0: xdisp, i1: size, i2: sh << 1
                    });
                    yerr = nat_sel_eval_mem(arch, gz.e.code, true, 31, r1, r2, sh, xdisp, size, false);
                    if yerr != "" {
                        return yerr;
                    }
                }
                xd = xd + 1;
            }
            sh = sh + 1;
        }
        size = size * 2;
    }
    return "";
}

/// RL6: a branch selected alone (br_short as given) with its fall-through
/// at ft and its target placed after a gap (tk); the code resolved. The
/// positions are pushed to pos: [ft, tk]. The branch's label is m.i0.
fn ng_sel_branch(arch: i64, m: MInst, short: bool, pos: &mut Vec<i64>) -> NatGen {
    var g: NatGen = NatGen_new(arch);
    g.rec = false;
    g.br_short = short;
    var l: i64 = NatEnc_label(&mut g.e);
    var mm: MInst = MInst {
        op: m.op, r0: m.r0, r1: m.r1, r2: m.r2, i0: l, i1: m.i1, i2: m.i2
    };
    ng_mi_dispatch(&mut g, mm, m.r0, m.r1, m.r2);
    pos.push(g.e.code.len());
    // a gap the run never reaches (the evaluator stops at the fall-through)
    var k: i64 = 0;
    while k < 8 {
        NatEnc_byte(&mut g.e, 0);
        k = k + 1;
    }
    NatEnc_place(&mut g.e, l);
    pos.push(g.e.code.len());
    k = 0;
    while k < 8 {
        NatEnc_byte(&mut g.e, 0);
        k = k + 1;
    }
    var rerr: str = NatEnc_resolve(&mut g.e);
    if rerr != "" {
        pos.push(0 - 1);
    }
    return g;
}

/// RL6: MO_BRCC of every kind against a register and against the zero
/// register, MO_BNEZ / MO_BEQZ, MO_TBNZ on bits 0, 7, 31, 32 and 63 set
/// and clear; short and long forms. Each must be taken exactly when its
/// condition holds.
fn nat_sel_branch_check(arch: i64) -> str {
    var g0: NatGen = NatGen_new(arch);
    var rs: Vec<i64> = ng_isel_test_regs(&g0);
    var a: i64 = rs.get(2);
    var b: i64 = rs.get(3);
    var zr: i64 = g0.zr;
    var sb: i64 = 0;
    while sb < 2 {
        var short: bool = sb == 1;
        var cc: i64 = NCC_EQ;
        while cc <= NCC_GEU {
            var bi: i64 = 0;
            while bi < 3 {
                var bb: i64 = b;
                if bi == 1 {
                    bb = zr;
                }
                if bi == 2 {
                    bb = a;
                }
                var pos: Vec<i64> = Vec::new();
                var g: NatGen = ng_sel_branch(arch, MInst {
                    op: MO_BRCC, r0: a, r1: bb, r2: 0, i0: 0, i1: cc, i2: 0
                }, short, &mut pos);
                if pos.len() > 2 {
                    return "MO_BRCC (" + int_to_str(cc) + "): the branch does not resolve";
                }
                var err: str = nat_sel_eval_branch(arch, g.e.code, pos.get(0), pos.get(1), NSEL_BRCC, a, bb, cc, 0, zr);
                if err != "" {
                    return err;
                }
                bi = bi + 1;
            }
            cc = cc + 1;
        }
        var z: i64 = 0;
        while z < 2 {
            var zop: i64 = MO_BNEZ;
            var zk: i64 = NSEL_BNEZ;
            if z == 1 {
                zop = MO_BEQZ;
                zk = NSEL_BEQZ;
            }
            var zpos: Vec<i64> = Vec::new();
            var gz: NatGen = ng_sel_branch(arch, MInst {
                op: zop, r0: a, r1: 0, r2: 0, i0: 0, i1: 0, i2: 0
            }, short, &mut zpos);
            if zpos.len() > 2 {
                return "MO_BNEZ / MO_BEQZ: the branch does not resolve";
            }
            var zerr: str = nat_sel_eval_branch(arch, gz.e.code, zpos.get(0), zpos.get(1), zk, a, a, 0, 0, zr);
            if zerr != "" {
                return zerr;
            }
            z = z + 1;
        }
        var bits: Vec<i64> = Vec::new();
        bits.push(0);
        bits.push(7);
        bits.push(31);
        bits.push(32);
        bits.push(63);
        var ti: i64 = 0;
        while ti < bits.len() {
            var clr: i64 = 0;
            while clr < 2 {
                var tpos: Vec<i64> = Vec::new();
                var gt: NatGen = ng_sel_branch(arch, MInst {
                    op: MO_TBNZ, r0: a, r1: 0, r2: 0, i0: 0, i1: bits.get(ti), i2: clr
                }, short, &mut tpos);
                if tpos.len() > 2 {
                    return "MO_TBNZ: the branch does not resolve";
                }
                var terr: str = nat_sel_eval_branch(arch, gt.e.code, tpos.get(0), tpos.get(1), NSEL_TBNZ, a, a, bits.get(ti), clr, zr);
                if terr != "" {
                    return terr;
                }
                // TBNZ of rax / x0 / a0 too (x86-64's short TEST forms)
                var r00: i64 = rs.get(0);
                var tpos2: Vec<i64> = Vec::new();
                var gt2: NatGen = ng_sel_branch(arch, MInst {
                    op: MO_TBNZ, r0: r00, r1: 0, r2: 0, i0: 0, i1: bits.get(ti), i2: clr
                }, short, &mut tpos2);
                if tpos2.len() > 2 {
                    return "MO_TBNZ: the branch does not resolve";
                }
                terr = nat_sel_eval_branch(arch, gt2.e.code, tpos2.get(0), tpos2.get(1), NSEL_TBNZ, r00, r00, bits.get(ti), clr, zr);
                if terr != "" {
                    return terr;
                }
                clr = clr + 1;
            }
            ti = ti + 1;
        }
        sb = sb + 1;
    }
    return "";
}

/// RL6: the argument setup of a call and the call: 0, 1, all register and
/// two stack arguments, under the platform and the internal convention
/// (ng_load_args_i's registers and order: stack arguments first, through
/// a temporary and MO_STOUT, then the registers, by MO_LI of a constant or
/// MO_MOV from a callee-saved register), then MO_CALL to a label (short
/// and long) or MO_CALLR through a register. At the call every argument
/// must be in its register or outgoing slot and the target be the
/// callee's.
@wrapping
fn nat_sel_call_check(arch: i64) -> str {
    var g0: NatGen = NatGen_new(arch);
    var srcs: Vec<i64> = g0.td.int_callee;
    var nsrc: i64 = srcs.len() - 2;
    var rc: i64 = srcs.get(srcs.len() - 2);
    var tmp: i64 = srcs.get(srcs.len() - 1);
    var sp: i64 = 4;
    if arch == NAT_A64 {
        sp = 31;
    }
    if arch == NAT_RV64 {
        sp = 2;
    }
    var spv: i64 = 0x7FFE0000;
    var internal: i64 = 0;
    while internal < 2 {
        var nr: i64 = ng_nregargs_i(&g0, internal == 1);
        var counts: Vec<i64> = Vec::new();
        counts.push(0);
        counts.push(1);
        counts.push(nr);
        counts.push(nr + 2);
        var ci: i64 = 0;
        while ci < counts.len() {
            var nargs: i64 = counts.get(ci);
            var kind: i64 = 0;
            while kind < 3 {
                // kind 0: MO_CALL long, 1: MO_CALL short, 2: MO_CALLR
                var g: NatGen = NatGen_new(arch);
                g.rec = false;
                g.br_short = kind == 1;
                var init_r: Vec<i64> = Vec::new();
                var init_v: Vec<i64> = Vec::new();
                var want_r: Vec<i64> = Vec::new();
                var want_v: Vec<i64> = Vec::new();
                var want_s: Vec<i64> = Vec::new();
                var vals: Vec<i64> = Vec::new();
                var i: i64 = 0;
                while i < nargs {
                    var v: i64 = (i + 1) * 0x123456789AB;
                    if i % 3 == 1 {
                        v = 0 - v;
                    }
                    if i % 3 == 2 {
                        v = v * 0x1000001 + 7;
                    }
                    vals.push(v);
                    i = i + 1;
                }
                // the stack arguments first
                i = nr;
                while i < nargs {
                    ng_mi_dispatch(&mut g, MInst {
                        op: MO_LI, r0: tmp, r1: 0, r2: 0, i0: vals.get(i), i1: 0, i2: 0
                    }, tmp, 0, 0);
                    ng_mi_dispatch(&mut g, MInst {
                        op: MO_STOUT, r0: tmp, r1: 0, r2: 0, i0: i - nr, i1: 0, i2: 0
                    }, tmp, 0, 0);
                    want_s.push(vals.get(i));
                    i = i + 1;
                }
                i = 0;
                var si: i64 = 0;
                while i < nargs && i < nr {
                    var ar: i64 = ng_argreg_i(&g, i, internal == 1);
                    if i % 2 == 0 || si >= nsrc {
                        ng_mi_dispatch(&mut g, MInst {
                            op: MO_LI, r0: ar, r1: 0, r2: 0, i0: vals.get(i), i1: 0, i2: 0
                        }, ar, 0, 0);
                    } else {
                        var src: i64 = srcs.get(si);
                        si = si + 1;
                        init_r.push(src);
                        init_v.push(vals.get(i));
                        ng_mov(&mut g, ar, src);
                    }
                    want_r.push(ar);
                    want_v.push(vals.get(i));
                    i = i + 1;
                }
                var l: i64 = NatEnc_label(&mut g.e);
                if kind == 2 {
                    ng_mi_dispatch(&mut g, MInst {
                        op: MO_CALLR, r0: rc, r1: 0, r2: 0, i0: 0, i1: 0, i2: 0
                    }, rc, 0, 0);
                } else {
                    ng_mi_dispatch(&mut g, MInst {
                        op: MO_CALL, r0: 0, r1: 0, r2: 0, i0: l, i1: 0, i2: 0
                    }, 0, 0, 0);
                }
                var k: i64 = 0;
                while k < 8 {
                    NatEnc_byte(&mut g.e, 0);
                    k = k + 1;
                }
                NatEnc_place(&mut g.e, l);
                var tk: i64 = g.e.code.len();
                k = 0;
                while k < 8 {
                    NatEnc_byte(&mut g.e, 0);
                    k = k + 1;
                }
                var rerr: str = NatEnc_resolve(&mut g.e);
                if rerr != "" {
                    return "the call does not resolve: " + rerr;
                }
                if kind == 2 {
                    init_r.push(rc);
                    init_v.push(tk);
                }
                var err: str = nat_sel_eval_call(arch, g.e.code, init_r, init_v, want_r, want_v, want_s, sp, spv, tk);
                if err != "" {
                    var conv: str = "platform";
                    if internal == 1 {
                        conv = "internal";
                    }
                    return err + " (" + int_to_str(nargs) + " arguments, " + conv + " convention, call kind " + int_to_str(kind) + ")";
                }
                kind = kind + 1;
            }
            ci = ci + 1;
        }
        internal = internal + 1;
    }
    return "";
}

/// Do two selections give the same bytes (and at least one)?
fn ng_isel_same(x: &NatGen, y: &NatGen) -> bool {
    if x.e.code.len() != y.e.code.len() || x.e.code.len() == 0 {
        return false;
    }
    var q: i64 = 0;
    while q < x.e.code.len() {
        if x.e.code.get(q) != y.e.code.get(q) {
            return false;
        }
        q = q + 1;
    }
    return true;
}

/// TG1: operation m selected with the table and with the hand-written
/// selection (FID_NAT_OFF=isel), each on a fresh generator of `arch`
/// (br_short as given, a label placed nowhere for the branch); "" when
/// the bytes are the same, else what differs.
fn ng_isel_cmp_one(arch: i64, m: MInst, p0: i64, p1: i64, p2: i64, short: bool) -> str {
    var ga: NatGen = NatGen_new(arch);
    ga.rec = false;
    ga.br_short = short;
    var mm: MInst = m;
    if m.op == MO_BRCC {
        var la: i64 = NatEnc_label(&mut ga.e);
        mm = MInst {
            op: m.op, r0: m.r0, r1: m.r1, r2: m.r2, i0: la, i1: m.i1, i2: m.i2
        };
    }
    ng_mi_dispatch(&mut ga, mm, p0, p1, p2);
    var gb: NatGen = NatGen_new(arch);
    gb.rec = false;
    gb.br_short = short;
    var mb: MInst = m;
    if m.op == MO_BRCC {
        var lb: i64 = NatEnc_label(&mut gb.e);
        mb = MInst {
            op: m.op, r0: m.r0, r1: m.r1, r2: m.r2, i0: lb, i1: m.i1, i2: m.i2
        };
    }
    g_ng_isel_state = 2;
    ng_mi_dispatch(&mut gb, mb, p0, p1, p2);
    g_ng_isel_state = 1;
    if ng_isel_same(&ga, &gb) {
        return "";
    }
    return "TG1: the selection table and the hand-written selection differ on " + mi_op_name(m.op) + " p=" + int_to_str(p0) + "," + int_to_str(p1) + "," + int_to_str(p2) + " i=" + int_to_str(m.i0) + "," + int_to_str(m.i1) + "," + int_to_str(m.i2) + " short=" + int_to_str(ng_isel_b2i(short));
}

fn ng_isel_b2i(b: bool) -> i64 {
    if b {
        return 1;
    }
    return 0;
}

/// TG1: the rules the value evaluator cannot run (loads and stores, with
/// their addressing modes; compare-and-branch; float operations) compared
/// byte for byte with the hand-written selection on registers the replay
/// hands them (ng_isel_test_regs; the stack pointer as a base; x86-64's
/// rsp and AArch64's 31 as an index, which no indexed form takes), every
/// size and signedness, displacements inside and outside each target's
/// immediate, every compare kind against a register and against zero,
/// short and long branches, f64 and f32, and float registers when
/// FID_NAT_ON=fregs gives them. Run with nat_sel_check (FID_VERIFY=1).
pub fn nat_isel_mem_check(arch: i64) -> str {
    if !ng_isel_on() {
        return "";
    }
    var g0: NatGen = NatGen_new(arch);
    var rs: Vec<i64> = ng_isel_test_regs(&g0);
    var r0: i64 = rs.get(1);
    var r1: i64 = rs.get(2);
    var r2: i64 = rs.get(3);
    var sp: i64 = 4;
    var badix: i64 = 4;
    if arch == NAT_A64 {
        sp = 31;
        badix = 31;
    }
    if arch == NAT_RV64 {
        sp = 2;
        badix = r2;
    }
    var fr: i64 = 0 - 1;
    var fr2: i64 = 0 - 1;
    if ng_fregs_on(&g0) && g0.td.float_pool.len() > 1 {
        fr = g0.td.float_pool.get(0);
        fr2 = g0.td.float_pool.get(1);
    }
    var disps: Vec<i64> = Vec::new();
    disps.push(0);
    disps.push(7);
    disps.push(8);
    disps.push(24);
    disps.push(0 - 8);
    disps.push(127);
    disps.push(128);
    disps.push(2047);
    disps.push(2048);
    disps.push(0 - 2048);
    disps.push(0 - 2049);
    disps.push(4088);
    disps.push(4096);
    disps.push(32760);
    disps.push(32768);
    disps.push(1048576);
    var sizes: Vec<i64> = Vec::new();
    sizes.push(1);
    sizes.push(2);
    sizes.push(4);
    sizes.push(8);
    var err: str = "";
    var si: i64 = 0;
    while si < sizes.len() {
        var size: i64 = sizes.get(si);
        var di: i64 = 0;
        while di < disps.len() {
            var disp: i64 = disps.get(di);
            var sg: i64 = 0;
            while sg < 2 {
                // d = [base + disp]; [base + disp] = v
                err = ng_isel_cmp_one(arch, MInst {
                    op: MO_LOAD, r0: r0, r1: r1, r2: 0, i0: disp, i1: size, i2: sg
                }, r0, r1, 0, false);
                if err != "" {
                    return err;
                }
                err = ng_isel_cmp_one(arch, MInst {
                    op: MO_LOAD, r0: r0, r1: sp, r2: 0, i0: disp, i1: size, i2: sg
                }, r0, sp, 0, false);
                if err != "" {
                    return err;
                }
                if fr >= 0 && (size == 4 || size == 8) {
                    err = ng_isel_cmp_one(arch, MInst {
                        op: MO_LOAD, r0: fr, r1: r1, r2: 0, i0: disp, i1: size, i2: sg
                    }, fr, r1, 0, false);
                    if err != "" {
                        return err;
                    }
                }
                sg = sg + 1;
            }
            err = ng_isel_cmp_one(arch, MInst {
                op: MO_STORE, r0: r1, r1: r0, r2: 0, i0: disp, i1: size, i2: 0
            }, r1, r0, 0, false);
            if err != "" {
                return err;
            }
            err = ng_isel_cmp_one(arch, MInst {
                op: MO_STORE, r0: sp, r1: r0, r2: 0, i0: disp, i1: size, i2: 0
            }, sp, r0, 0, false);
            if err != "" {
                return err;
            }
            if fr >= 0 && (size == 4 || size == 8) {
                err = ng_isel_cmp_one(arch, MInst {
                    op: MO_STORE, r0: r1, r1: fr, r2: 0, i0: disp, i1: size, i2: 0
                }, r1, fr, 0, false);
                if err != "" {
                    return err;
                }
            }
            di = di + 1;
        }
        // [base + (idx << sh) + disp]: every scale, a few displacements,
        // an index no indexed form takes, AArch64's xzr as the value
        var sh: i64 = 0;
        while sh <= 3 {
            var xd: i64 = 0;
            while xd < 4 {
                var xdisp: i64 = 0;
                if xd == 1 {
                    xdisp = 16;
                }
                if xd == 2 {
                    xdisp = 0 - 8;
                }
                if xd == 3 {
                    xdisp = 4096;
                }
                var xs: i64 = 0;
                while xs < 2 {
                    err = ng_isel_cmp_one(arch, MInst {
                        op: MO_LDX, r0: r0, r1: r1, r2: r2, i0: xdisp, i1: size, i2: (sh << 1) | xs
                    }, r0, r1, r2, false);
                    if err != "" {
                        return err;
                    }
                    err = ng_isel_cmp_one(arch, MInst {
                        op: MO_LDX, r0: r0, r1: r1, r2: badix, i0: xdisp, i1: size, i2: (sh << 1) | xs
                    }, r0, r1, badix, false);
                    if err != "" {
                        return err;
                    }
                    xs = xs + 1;
                }
                err = ng_isel_cmp_one(arch, MInst {
                    op: MO_STX, r0: r1, r1: r0, r2: r2, i0: xdisp, i1: size, i2: sh << 1
                }, r1, r0, r2, false);
                if err != "" {
                    return err;
                }
                err = ng_isel_cmp_one(arch, MInst {
                    op: MO_STX, r0: sp, r1: r0, r2: badix, i0: xdisp, i1: size, i2: sh << 1
                }, sp, r0, badix, false);
                if err != "" {
                    return err;
                }
                if arch == NAT_A64 {
                    err = ng_isel_cmp_one(arch, MInst {
                        op: MO_STX, r0: r1, r1: 31, r2: r2, i0: xdisp, i1: size, i2: sh << 1
                    }, r1, 31, r2, false);
                    if err != "" {
                        return err;
                    }
                }
                xd = xd + 1;
            }
            sh = sh + 1;
        }
        si = si + 1;
    }
    // compare and branch: every kind, against a register and zero, short
    // and long
    var cc: i64 = NCC_EQ;
    while cc <= NCC_GEU {
        var sb: i64 = 0;
        while sb < 2 {
            err = ng_isel_cmp_one(arch, MInst {
                op: MO_BRCC, r0: r0, r1: r1, r2: 0, i0: 0, i1: cc, i2: 0
            }, r0, r1, 0, sb == 1);
            if err != "" {
                return err;
            }
            err = ng_isel_cmp_one(arch, MInst {
                op: MO_BRCC, r0: r0, r1: g0.zr, r2: 0, i0: 0, i1: cc, i2: 0
            }, r0, g0.zr, 0, sb == 1);
            if err != "" {
                return err;
            }
            sb = sb + 1;
        }
        cc = cc + 1;
    }
    // float operations: every operation and compare, f64 and f32, in
    // general registers (their bits) and in float registers
    var w: i64 = 0;
    while w < 2 {
        var fo: i64 = 1;
        while fo <= 4 {
            err = ng_isel_cmp_one(arch, MInst {
                op: MO_FBIN, r0: r0, r1: r1, r2: r2, i0: fo, i1: w, i2: 0
            }, r0, r1, r2, false);
            if err != "" {
                return err;
            }
            err = ng_isel_cmp_one(arch, MInst {
                op: MO_FBIN, r0: r1, r1: r1, r2: r2, i0: fo, i1: w, i2: 0
            }, r1, r1, r2, false);
            if err != "" {
                return err;
            }
            if fr >= 0 {
                err = ng_isel_cmp_one(arch, MInst {
                    op: MO_FBIN, r0: fr, r1: fr, r2: fr2, i0: fo, i1: w, i2: 0
                }, fr, fr, fr2, false);
                if err != "" {
                    return err;
                }
                err = ng_isel_cmp_one(arch, MInst {
                    op: MO_FBIN, r0: r0, r1: fr, r2: r2, i0: fo, i1: w, i2: 0
                }, r0, fr, r2, false);
                if err != "" {
                    return err;
                }
            }
            fo = fo + 1;
        }
        var fc: i64 = NCC_EQ;
        while fc <= NCC_GE {
            err = ng_isel_cmp_one(arch, MInst {
                op: MO_FCMP, r0: r0, r1: r1, r2: r2, i0: fc, i1: w, i2: 0
            }, r0, r1, r2, false);
            if err != "" {
                return err;
            }
            if fr >= 0 {
                err = ng_isel_cmp_one(arch, MInst {
                    op: MO_FCMP, r0: r0, r1: fr, r2: fr2, i0: fc, i1: w, i2: 0
                }, r0, fr, fr2, false);
                if err != "" {
                    return err;
                }
            }
            fc = fc + 1;
        }
        w = w + 1;
    }
    return "";
}

/// TG1: operations ms selected one after another with the table and with
/// the hand-written selection (FID_NAT_OFF=isel), each sequence on a fresh
/// generator of `arch` (br_short as given; a test-bit-and-branch gets a
/// label of its generator, placed nowhere). The register fields are
/// physical already. "" when the bytes are the same (none counts: a select
/// whose destination is its value emits nothing), else what differs.
fn ng_isel_cmp_seq(arch: i64, ms: &Vec<MInst>, short: bool) -> str {
    var ga: NatGen = NatGen_new(arch);
    ga.rec = false;
    ga.br_short = short;
    var gb: NatGen = NatGen_new(arch);
    gb.rec = false;
    gb.br_short = short;
    var i: i64 = 0;
    while i < ms.len() {
        var m: MInst = ms.get(i);
        var ma: MInst = m;
        var mb: MInst = m;
        if m.op == MO_TBNZ {
            ma.i0 = NatEnc_label(&mut ga.e);
            mb.i0 = NatEnc_label(&mut gb.e);
        }
        ng_mi_dispatch(&mut ga, ma, m.r0, m.r1, m.r2);
        g_ng_isel_state = 2;
        ng_mi_dispatch(&mut gb, mb, m.r0, m.r1, m.r2);
        g_ng_isel_state = 1;
        i = i + 1;
    }
    var same: bool = ga.e.code.len() == gb.e.code.len();
    var q: i64 = 0;
    while same && q < ga.e.code.len() {
        if ga.e.code.get(q) != gb.e.code.get(q) {
            same = false;
        }
        q = q + 1;
    }
    if same {
        return "";
    }
    var m0: MInst = ms.get(0);
    return "TG1: the selection table and the hand-written selection differ on " + mi_op_name(m0.op) + " p=" + int_to_str(m0.r0) + "," + int_to_str(m0.r1) + "," + int_to_str(m0.r2) + " i=" + int_to_str(m0.i0) + "," + int_to_str(m0.i1) + "," + int_to_str(m0.i2) + " ops=" + int_to_str(ms.len()) + " short=" + int_to_str(ng_isel_b2i(short)) + " cpu=" + g_nat_cpu;
}

/// TG1: ng_isel_cmp_seq of one operation.
fn ng_isel_cmp_mi(arch: i64, m: MInst, short: bool) -> str {
    var ms: Vec<MInst> = Vec::new();
    ms.push(m);
    return ng_isel_cmp_seq(arch, &ms, short);
}

/// TG1: the rules of ng_isel_rows_tg1b against the hand-written selection,
/// byte for byte, under each `--cpu` that changes them (x86-64-v3: BMI1;
/// rva23u64: Zba, Zbb and Zicond): division, remainder and the high
/// product, signed and unsigned, with the destination equal to either
/// operand or neither and the operands in rax / rdx; the sign mask in
/// place and not; I2F / F2I for f64 and f32, in general registers and
/// (FID_NAT_ON=fregs) float registers, and two F2I of one source in a row
/// (x86-64's xmm0 cache); ANDN; each BLSR kind; the select both ways and
/// with its destination as its value; test-bit-and-branch on bits 0, 7,
/// 31, 32 and 63, set and clear, short and long; RISC-V's ADDW / SUBW /
/// MULW; x86-64's memory-operand ALU of every kind with d the base, the
/// first operand or neither. Run by nat_sel_check (FID_VERIFY=1).
pub fn nat_isel_tg1b_check(arch: i64) -> str {
    if !ng_isel_on() {
        return "";
    }
    var cpu0: str = g_nat_cpu;
    var cpus: Vec<str> = Vec::new();
    cpus.push("");
    if arch == NAT_X64 {
        cpus.push("x86-64-v3");
    }
    if arch == NAT_RV64 {
        cpus.push("rva23u64");
    }
    var err: str = "";
    var ci: i64 = 0;
    while ci < cpus.len() && err == "" {
        g_nat_cpu = cpus.get(ci);
        err = ng_isel_tg1b_cases(arch);
        ci = ci + 1;
    }
    g_nat_cpu = cpu0;
    return err;
}

fn ng_isel_tg1b_cases(arch: i64) -> str {
    var g0: NatGen = NatGen_new(arch);
    var rs: Vec<i64> = ng_isel_test_regs(&g0);
    var r0: i64 = rs.get(1);
    var r1: i64 = rs.get(2);
    var r2: i64 = rs.get(3);
    // the registers x86-64's division uses, as operands too
    var rx: i64 = rs.get(0);
    var rd: i64 = r2;
    if arch == NAT_X64 {
        rd = 2;
    }
    var fr: i64 = 0 - 1;
    if ng_fregs_on(&g0) && g0.td.float_pool.len() > 0 {
        fr = g0.td.float_pool.get(0);
    }
    var err: str = "";
    // division, remainder, high product: [d, a, b] shapes
    var shapes: Vec<i64> = Vec::new();
    shapes.push(r0);
    shapes.push(r1);
    shapes.push(r2);
    shapes.push(r1);
    shapes.push(r1);
    shapes.push(r2);
    shapes.push(r2);
    shapes.push(r1);
    shapes.push(r2);
    shapes.push(rx);
    shapes.push(r1);
    shapes.push(rx);
    shapes.push(r0);
    shapes.push(rd);
    shapes.push(rx);
    var ops: Vec<i64> = Vec::new();
    ops.push(MO_DIV);
    ops.push(MO_REM);
    ops.push(MO_MULH);
    var oi: i64 = 0;
    while oi < ops.len() {
        var si: i64 = 0;
        while si + 2 < shapes.len() {
            var u: i64 = 0;
            while u < 2 {
                err = ng_isel_cmp_mi(arch, MInst {
                    op: ops.get(oi), r0: shapes.get(si), r1: shapes.get(si + 1), r2: shapes.get(si + 2), i0: u, i1: 0, i2: 0
                }, false);
                if err != "" {
                    return err;
                }
                u = u + 1;
            }
            si = si + 3;
        }
        oi = oi + 1;
    }
    // the sign mask, in place and not
    err = ng_isel_cmp_mi(arch, MInst {
        op: MO_ASR63, r0: r0, r1: r1, r2: 0, i0: 0, i1: 0, i2: 0
    }, false);
    if err != "" {
        return err;
    }
    err = ng_isel_cmp_mi(arch, MInst {
        op: MO_ASR63, r0: r0, r1: r0, r2: 0, i0: 0, i1: 0, i2: 0
    }, false);
    if err != "" {
        return err;
    }
    // conversions, f64 and f32
    var w: i64 = 0;
    while w < 2 {
        err = ng_isel_cmp_mi(arch, MInst {
            op: MO_I2F, r0: r0, r1: r1, r2: 0, i0: w, i1: 0, i2: 0
        }, false);
        if err != "" {
            return err;
        }
        err = ng_isel_cmp_mi(arch, MInst {
            op: MO_F2I, r0: r0, r1: r1, r2: 0, i0: w, i1: 0, i2: 0
        }, false);
        if err != "" {
            return err;
        }
        err = ng_isel_cmp_mi(arch, MInst {
            op: MO_F2I, r0: r1, r1: r1, r2: 0, i0: w, i1: 0, i2: 0
        }, false);
        if err != "" {
            return err;
        }
        // two conversions of one source: the second may reuse xmm0
        var two: Vec<MInst> = Vec::new();
        two.push(MInst {
            op: MO_F2I, r0: r0, r1: r1, r2: 0, i0: w, i1: 0, i2: 0
        });
        two.push(MInst {
            op: MO_F2I, r0: r2, r1: r1, r2: 0, i0: w, i1: 0, i2: 0
        });
        err = ng_isel_cmp_seq(arch, &two, false);
        if err != "" {
            return err;
        }
        if fr >= 0 {
            err = ng_isel_cmp_mi(arch, MInst {
                op: MO_I2F, r0: fr, r1: r1, r2: 0, i0: w, i1: 0, i2: 0
            }, false);
            if err != "" {
                return err;
            }
            err = ng_isel_cmp_mi(arch, MInst {
                op: MO_F2I, r0: r0, r1: fr, r2: 0, i0: w, i1: 0, i2: 0
            }, false);
            if err != "" {
                return err;
            }
        }
        w = w + 1;
    }
    // AND NOT, the lowest set bit
    err = ng_isel_cmp_mi(arch, MInst {
        op: MO_ANDN, r0: r0, r1: r1, r2: r2, i0: 0, i1: 0, i2: 0
    }, false);
    if err != "" {
        return err;
    }
    err = ng_isel_cmp_mi(arch, MInst {
        op: MO_ANDN, r0: r1, r1: r1, r2: r2, i0: 0, i1: 0, i2: 0
    }, false);
    if err != "" {
        return err;
    }
    var kind: i64 = 0;
    while kind < 3 {
        err = ng_isel_cmp_mi(arch, MInst {
            op: MO_BLSR, r0: r0, r1: r1, r2: 0, i0: kind, i1: 0, i2: 0
        }, false);
        if err != "" {
            return err;
        }
        err = ng_isel_cmp_mi(arch, MInst {
            op: MO_BLSR, r0: r1, r1: r1, r2: 0, i0: kind, i1: 0, i2: 0
        }, false);
        if err != "" {
            return err;
        }
        kind = kind + 1;
    }
    // the select, both ways, and with its destination as its value
    var inv: i64 = 0;
    while inv < 2 {
        err = ng_isel_cmp_mi(arch, MInst {
            op: MO_CSEL, r0: r0, r1: r1, r2: r2, i0: inv, i1: 0, i2: 0
        }, false);
        if err != "" {
            return err;
        }
        err = ng_isel_cmp_mi(arch, MInst {
            op: MO_CSEL, r0: r0, r1: r1, r2: r0, i0: inv, i1: 0, i2: 0
        }, false);
        if err != "" {
            return err;
        }
        inv = inv + 1;
    }
    // test a bit and branch
    var bits: Vec<i64> = Vec::new();
    bits.push(0);
    bits.push(7);
    bits.push(31);
    bits.push(32);
    bits.push(63);
    var bi: i64 = 0;
    while bi < bits.len() {
        var clear: i64 = 0;
        while clear < 2 {
            var sb: i64 = 0;
            while sb < 2 {
                err = ng_isel_cmp_mi(arch, MInst {
                    op: MO_TBNZ, r0: r0, r1: 0, r2: 0, i0: 0, i1: bits.get(bi), i2: clear
                }, sb == 1);
                if err != "" {
                    return err;
                }
                sb = sb + 1;
            }
            clear = clear + 1;
        }
        bi = bi + 1;
    }
    // RISC-V's 32-bit operations
    if arch == NAT_RV64 {
        var wop: i64 = 0;
        while wop < 3 {
            err = ng_isel_cmp_mi(arch, MInst {
                op: MO_OPW, r0: r0, r1: r1, r2: r2, i0: wop, i1: 0, i2: 0
            }, false);
            if err != "" {
                return err;
            }
            wop = wop + 1;
        }
    }
    // x86-64's memory-operand ALU: d = a op [b + disp]
    if arch == NAT_X64 {
        var ak: i64 = 0;
        while ak < 6 {
            err = ng_isel_cmp_mi(arch, MInst {
                op: MO_ALUM, r0: r0, r1: r1, r2: r2, i0: 24, i1: ak, i2: 0
            }, false);
            if err != "" {
                return err;
            }
            err = ng_isel_cmp_mi(arch, MInst {
                op: MO_ALUM, r0: r0, r1: r0, r2: r2, i0: 0 - 8, i1: ak, i2: 0
            }, false);
            if err != "" {
                return err;
            }
            err = ng_isel_cmp_mi(arch, MInst {
                op: MO_ALUM, r0: r2, r1: r1, r2: r2, i0: 4096, i1: ak, i2: 0
            }, false);
            if err != "" {
                return err;
            }
            err = ng_isel_cmp_mi(arch, MInst {
                op: MO_ALUM, r0: r2, r1: r2, r2: r2, i0: 8, i1: ak, i2: 0
            }, false);
            if err != "" {
                return err;
            }
            ak = ak + 1;
        }
    }
    return "";
}

/// TG2: registers a selected operation may be handed after allocation
/// (pool, argument and result registers), none of the target's scratch
/// (x86-64 rcx, r8, r10, r11; AArch64 x12..x17; RISC-V t0..t3, t5) and
/// not the stack pointer. The first is the result register.
fn ng_isel_test_regs(g: &NatGen) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    if ng_x64(g) {
        v.push(0);
        v.push(3);
        v.push(12);
        v.push(13);
        v.push(6);
        v.push(7);
        v.push(9);
        v.push(14);
        v.push(15);
        return v;
    }
    if ng_a64(g) {
        v.push(0);
        v.push(19);
        v.push(20);
        v.push(21);
        v.push(1);
        v.push(8);
        v.push(9);
        v.push(10);
        v.push(28);
        return v;
    }
    v.push(10);
    v.push(18);
    v.push(19);
    v.push(20);
    v.push(9);
    v.push(11);
    v.push(12);
    v.push(27);
    v.push(29);
    return v;
}

/// TG2: the next pseudo-random value (xorshift64).
@wrapping
fn ng_isel_rand(x: i64) -> i64 {
    var y: i64 = x ^ (x << 13);
    y = y ^ ((y >> 7) & 0x01FFFFFFFFFFFFFF);
    y = y ^ (y << 17);
    return y;
}

/// TG2: a non-negative random number below n.
fn ng_isel_below(x: i64, n: i64) -> i64 {
    return ((x >> 11) & 0x7FFFFFFF) % n;
}

/// TG2: does nat_enc.fd's selection evaluator run what rules of `op`
/// emit (and nat_sel_ref know its meaning)?
fn ng_isel_evaluable(op: i64) -> bool {
    return (op >= MO_ADD && op <= MO_SHR) || op == MO_ADDI || op == MO_LI || op == MO_SHI || op == MO_ADDSHL || op == MO_SETCC || op == MO_NEG || op == MO_NOT || op == MO_EXT;
}

/// TG2: a random constant of operation op for a rule whose precondition
/// is `pre` (parg): constants of every class for LI (0, 12-bit, one
/// 16-bit piece, its inverse, 32-bit, 64-bit), an add immediate the
/// target takes (ng_addi_fits), a shift count | kind << 6, an element
/// scale 0..4, a compare kind (parg when the rule names one).
@wrapping
fn ng_isel_rand_imm(g: &NatGen, op: i64, pre: i64, parg: i64, x: i64) -> i64 {
    var y: i64 = ng_isel_rand(x ^ 0x5851F42D4C957F2D);
    if op == MO_LI {
        var cls: i64 = ng_isel_below(x, 9);
        if cls == 0 {
            return 0;
        }
        if cls == 1 {
            return y & 0x7FF;
        }
        if cls == 2 {
            return 0 - (y & 0x7FF) - 1;
        }
        if cls == 3 {
            return (y & 0xFFFF) << (16 * ng_isel_below(y, 4));
        }
        if cls == 4 {
            return ~((y & 0xFFFF) << (16 * ng_isel_below(y, 4)));
        }
        if cls == 5 {
            return y & 0xFFFFFFFF;
        }
        if cls == 6 {
            return ((y & 0xFFFFFFFF) << 32) >> 32;
        }
        if cls == 7 {
            return 0 - 1;
        }
        return y;
    }
    if op == MO_ADDI {
        var lim: i64 = 2048;
        if ng_a64(g) {
            lim = 4096;
        }
        if ng_x64(g) {
            lim = 2147483647;
            if ng_isel_below(x, 2) == 0 {
                lim = 2048;
            }
        }
        var c: i64 = ng_isel_below(y, lim);
        if ng_isel_below(x, 2) == 0 {
            c = 0 - c;
            if !ng_x64(g) && !ng_a64(g) && c < 0 - 2048 {
                c = 0 - 2048;
            }
        }
        if ng_isel_below(x, 7) == 0 {
            c = 0;
        }
        if !ng_addi_fits(g, c) {
            c = 1;
        }
        return c;
    }
    if op == MO_SHI {
        return (y & 63) | (ng_isel_below(x, 3) << 6);
    }
    if op == MO_ADDSHL {
        return ng_isel_below(y, 5);
    }
    if op == MO_SETCC {
        if pre == NG_IP_CC || pre == NG_IP_ZERO_CC {
            return parg;
        }
        return ng_isel_below(y, 10);
    }
    if op == MO_EXT {
        if pre == NG_IP_IMM_EQ || pre == NG_IP_ZB_EXT {
            return parg;
        }
        return NEXT_SB + ng_isel_below(y, 6);
    }
    return 0;
}

const NG_ISEL_RULE_TRIALS: i64 = 6;

/// TG2: would a rule before row r of its (arch, op) group (the cost order
/// ng_isel_mi tries) be taken for m? Then row r is not the one selected
/// for these operands, and its form need not be right for them (a
/// fallback row of precondition ANY). Rules that decline alone (MADD,
/// which needs the multiply before it) do not count.
fn ng_isel_earlier(g: &NatGen, r: i64, m: MInst, d: i64, a: i64, b: i64) -> bool {
    var at: i64 = r * NG_IS_W;
    var key: i64 = g_ng_isel.get(at) * 64 + g_ng_isel.get(at + 1);
    var first: i64 = g_ng_isel_ix.get(key) - 1;
    var j: i64 = first;
    while j >= 0 && j < r {
        var aj: i64 = j * NG_IS_W;
        if g_ng_isel.get(aj + 2) != NG_IF_A64_MADD && ng_isel_pre(g, g_ng_isel.get(aj + 4), g_ng_isel.get(aj + 6), m, d, a, b) {
            return true;
        }
        j = j + 1;
    }
    return false;
}

/// TG2: can random operands meet precondition `pre` on this build's
/// target (Zba rules need `--cpu` with Zba)?
fn ng_isel_pre_reachable(g: &NatGen, pre: i64) -> bool {
    if pre == NG_IP_SH_ZBA || pre == NG_IP_ZB_EXT {
        return ng_rv_zb(g);
    }
    return true;
}

/// TG2: every rule of the selection table for `arch` whose operation the
/// value evaluator runs (ng_isel_evaluable: LI, the ALU, ADDI, SHI,
/// ADDSHL, SETCC, NEG, NOT, EXT), alone, on random operands. Registers
/// (ng_isel_test_regs, sometimes d = a, a = b, or b the zero register)
/// and constants (ng_isel_rand_imm) are drawn until the rule's
/// precondition holds; then its form alone is emitted and run by
/// nat_enc.fd nat_sel_eval_case on edge and random values against the
/// operation's meaning, and so is the generic lowering of the same
/// operation (the hand-written selection, FID_NAT_OFF=isel). Each rule
/// must be met NG_ISEL_RULE_TRIALS times in 600 draws: a rule whose
/// precondition no draw meets is an error, so the generator keeps up with
/// the table (a rule always shadowed by a cheaper one on this target is
/// not counted as checked). Left to
/// nat_sel_check's byte comparison: AArch64's MADD / MSUB (they fold the
/// multiply emitted before them) and the vector rules (nat_vsel_check);
/// the memory, branch and float rules have nat_isel_mem_check.
pub fn nat_isel_rule_check(arch: i64) -> str {
    if !ng_isel_on() {
        return "";
    }
    if g_ng_isel_ix.len() == 0 {
        ng_isel_build();
    }
    var g0: NatGen = NatGen_new(arch);
    var regs: Vec<i64> = ng_isel_test_regs(&g0);
    var seed: i64 = 0x2545F4914F6CDD1D + arch * 7919;
    var nrows: i64 = g_ng_isel.len() / NG_IS_W;
    var checked: i64 = 0;
    var r: i64 = 0;
    while r < nrows {
        var at: i64 = r * NG_IS_W;
        var op: i64 = g_ng_isel.get(at + 1);
        var form: i64 = g_ng_isel.get(at + 2);
        var pre: i64 = g_ng_isel.get(at + 4);
        var arg: i64 = g_ng_isel.get(at + 5);
        var parg: i64 = g_ng_isel.get(at + 6);
        if g_ng_isel.get(at) == arch && ng_isel_evaluable(op) && form != NG_IF_A64_MADD {
            var hits: i64 = 0;
            var tries: i64 = 0;
            // draws that met the precondition (a rule a cheaper one always
            // takes over on this target, as RISC-V's two-instruction
            // extensions under Zbb, is shadowed, not missed)
            var metpre: i64 = 0;
            while hits < NG_ISEL_RULE_TRIALS && tries < 600 {
                seed = ng_isel_rand(seed);
                var d: i64 = regs.get(ng_isel_below(seed, regs.len()));
                var a: i64 = regs.get(ng_isel_below(seed >> 8, regs.len()));
                var b: i64 = regs.get(ng_isel_below(seed >> 16, regs.len()));
                var shape: i64 = ng_isel_below(seed >> 24, 8);
                if shape == 0 {
                    a = d;
                }
                if shape == 1 {
                    b = a;
                }
                if (shape == 2 || shape == 3) && op == MO_SETCC && arch != NAT_A64 {
                    b = g0.zr;
                }
                if pre == NG_IP_D_IS_A && shape >= 4 {
                    a = d;
                }
                if op == MO_SETCC && pre == NG_IP_B_ZERO && arch != NAT_A64 && shape >= 4 {
                    b = g0.zr;
                }
                var imm: i64 = ng_isel_rand_imm(&g0, op, pre, parg, seed);
                var m: MInst = ng_sel_case_mi(op, d, a, b, imm);
                var met: bool = ng_isel_pre(&g0, pre, parg, m, d, a, b);
                if met {
                    metpre = metpre + 1;
                }
                if met && !ng_isel_earlier(&g0, r, m, d, a, b) {
                    var ga: NatGen = NatGen_new(arch);
                    ga.rec = false;
                    if ng_isel_emit(&mut ga, form, arg, m, d, a, b) {
                        var err: str = nat_sel_eval_case(arch, ga.e.code, op, d, a, b, imm, ga.zr);
                        if err != "" {
                            return "TG2: rule " + int_to_str(r) + " (" + mi_op_name(op) + ", form " + int_to_str(form) + ", d=" + int_to_str(d) + " a=" + int_to_str(a) + " b=" + int_to_str(b) + "): " + err;
                        }
                        var gh: NatGen = NatGen_new(arch);
                        gh.rec = false;
                        g_ng_isel_state = 2;
                        ng_mi_dispatch(&mut gh, m, d, a, b);
                        g_ng_isel_state = 1;
                        var herr: str = nat_sel_eval_case(arch, gh.e.code, op, d, a, b, imm, gh.zr);
                        if herr != "" {
                            return "TG2: the generic lowering of " + mi_op_name(op) + " (d=" + int_to_str(d) + " a=" + int_to_str(a) + " b=" + int_to_str(b) + "): " + herr;
                        }
                        hits = hits + 1;
                    }
                }
                tries = tries + 1;
            }
            if hits == 0 && metpre == 0 && ng_isel_pre_reachable(&g0, pre) {
                return "TG2: rule " + int_to_str(r) + " (" + mi_op_name(op) + ", form " + int_to_str(form) + ") was never applied to a random operand: the generator does not reach its precondition";
            }
            if hits > 0 {
                checked = checked + 1;
            }
        }
        r = r + 1;
    }
    if g_nat_stats {
        p_eprint_str("[isel] TG2: " + int_to_str(checked) + " rules of the table checked alone on random operands\n");
    }
    return "";
}

/// LG13: one asm! site as a call to a thunk of its own (nat_enc.fd
/// nat_asm_thunk, placed after the code by nat_asm_emit): the inputs in the
/// argument registers, the output in argument register 0 after the call.
/// x86-64 templates go through pe_asm_encode (the bare builds' encoder),
/// AArch64 and RISC-V through nat_asm_encode. The rule is pe_ir's
/// (PeirGen_gen_asm_process): a template with an instruction a process may
/// not run (pe_asm_privileged: hlt, cli, port I/O, ...), or one the encoder
/// or the register names do not know, gives 0 as before; an output
/// register that is not an input starts at 0. FID_NAT_OFF=asm: always 0.
fn ng_gen_asm(g: &mut NatGen, id: i64, tpl: str, ins: Vec<StringValueId>, outs: Vec<StringValueId>) {
    var code: Vec<i64> = Vec::new();
    var err: str = "";
    if pe_asm_privileged(tpl) {
        err = "privileged";
    } else if ng_x64(g) {
        var xenc: PeAsmResult = pe_asm_encode(tpl);
        code = xenc.bytes;
        err = xenc.error;
    } else {
        var nenc: NatAsmCode = nat_asm_encode(g.arch, tpl);
        code = nenc.bytes;
        err = nenc.error;
    }
    if err == "" && ins.len() > ng_nregargs(g) {
        err = "more than " + int_to_str(ng_nregargs(g)) + " inputs";
    }
    var regs: Vec<i64> = Vec::new();
    var srcs: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < ins.len() && err == "" {
        var r: i64 = nat_asm_reg(g.arch, ins.get(i).name);
        if r < 0 {
            err = "in(\"" + ins.get(i).name + "\") is not a register of this target";
        }
        regs.push(r);
        srcs.push(ins.get(i).id);
        i = i + 1;
    }
    var outr: i64 = 0 - 1;
    if err == "" && outs.len() > 0 {
        outr = nat_asm_reg(g.arch, outs.get(0).name);
        if outr < 0 {
            err = "out(\"" + outs.get(0).name + "\") is not a register of this target";
        }
    }
    if err != "" {
        // not run in a process (as pe_ir): the old 0
        ng_li(g, g.t0, 0);
        ng_st_val(g, id, g.t0);
        return;
    }
    ng_load_args(g, srcs);
    var label: i64 = NatEnc_label(&mut g.e);
    nat_asm_add(label, nat_asm_thunk(g.arch, code, regs, outr));
    ng_call_label(g, label);
    ng_st_val(g, id, ng_argreg(g, 0));
}
