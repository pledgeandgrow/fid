// interp.fd -- IR Interpreter (self-hosted)
// Ported from src/interp.rs (~6,060 LOC)
//
// Executes Fides IR directly without generating machine code.
// This is the reference interpreter for the `run` command, comptime
// evaluation, debugging, and testing.
//
// Adaptations from Rust:
// 1. HashMap<K,V> -> Vec-based maps with helper structs
// 2. Rc<RefCell<...>> -> Vec side-tables indexed by handle
// 3. String/CompactString -> str
// 4. usize/u64/u32 -> i64 (Fides has no usize)
// 5. struct-style enum variants -> tuple-style (Fides convention)
// 6. Option<T> -> Opt* enums
// 7. closures -> top-level helper functions
// 8. SmallVec -> Vec
// 9. to_le_bytes/from_le_bytes -> manual byte operations via unsafe ptr

module compiler::interp;
use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::pgo;
use compiler::green_thread;
use compiler::tensor;
use compiler::json;
use math;
// ===========================================================================
// Value -- runtime value representation
// ===========================================================================
//
// Rust has 13 Value variants. Fides simplifies to 8:
//   Int, Float, Bool, Str, Ptr, Void, Vec, Map
// Tensor/Json/Dyn/Allocator/Future/ThreadHandle are stored as opaque
// pointers (Ptr) with side-table entries when needed.

pub enum Value {
    Int(i64),
    Float(f64),
    Bool(bool),
    Str(str),
    Ptr(i64),
    Void,
    Vec(i64),
    // index into interp.vec_side_table
    Map(i64),  // index into interp.map_side_table
}

pub fn Value_int(v: i64) -> Value {
    return Value::Int(v);
}

/// The variant of `v`, for error messages.
fn interp_value_kind(v: Value) -> str {
    match v {
        Value::Int(_) => {
            return "int";
        }
        Value::Float(_) => {
            return "float";
        }
        Value::Bool(_) => {
            return "bool";
        }
        Value::Str(_) => {
            return "str";
        }
        Value::Ptr(_) => {
            return "ptr";
        }
        Value::Void => {
            return "void";
        }
        Value::Vec(_) => {
            return "vec";
        }
        Value::Map(_) => {
            return "map";
        }
    }
    return "?";
}

// A generic container hands back the 8-byte word it stored; a call typed f64
// (a Vec<f64> element via Vec_get) reads those bits as a float. Functions
// declared `-> f64` convert integer results at `return`, so an Int reaching
// such a call is always a stored word.
pub fn interp_reinterpret_word(v: Value, ty: IrType) -> Value {
    match ty {
        IrType::F64 => {
            match v {
                Value::Int(bits) => {
                    return Value::Float(f64_from_bits_i(bits));
                }
                _ => {
                    return v;
                }
            }
        }
        IrType::F32 => {
            match v {
                Value::Int(bits32) => {
                    return Value::Float(f32_from_bits_i(bits32));
                }
                _ => {
                    return v;
                }
            }
        }
        // A bool kept as a word (a Vec<bool> element): print as true/false,
        // as C and native do
        IrType::Bool => {
            match v {
                Value::Int(bw) => {
                    return Value::Bool(bw != 0);
                }
                _ => {
                    return v;
                }
            }
        }
        _ => {
            return v;
        }
    }
    return v;
}
pub fn Value_float(v: f64) -> Value {
    return Value::Float(v);
}
pub fn Value_bool(v: bool) -> Value {
    return Value::Bool(v);
}
pub fn Value_str(v: str) -> Value {
    return Value::Str(v);
}
pub fn Value_ptr(v: i64) -> Value {
    return Value::Ptr(v);
}
pub fn Value_void() -> Value {
    return Value::Void;
}

/// Check if two values are equal (for PartialEq equivalent)
pub fn value_eq(a: Value, b: Value) -> bool {
    match a {
        Value::Int(x) => {
            match b {
                Value::Int(y) => {
                    return x == y;
                }
                _ => {
                    return false;
                }
            }
        }
        Value::Float(x) => {
            match b {
                Value::Float(y) => {
                    return x == y;
                }
                _ => {
                    return false;
                }
            }
        }
        Value::Bool(x) => {
            match b {
                Value::Bool(y) => {
                    return x == y;
                }
                _ => {
                    return false;
                }
            }
        }
        Value::Str(x) => {
            match b {
                Value::Str(y) => {
                    return x == y;
                }
                _ => {
                    return false;
                }
            }
        }
        Value::Ptr(x) => {
            match b {
                Value::Ptr(y) => {
                    return x == y;
                }
                _ => {
                    return false;
                }
            }
        }
        Value::Void => {
            match b {
                Value::Void => {
                    return true;
                }
                _ => {
                    return false;
                }
            }
        }
        Value::Vec(x) => {
            match b {
                Value::Vec(y) => {
                    return x == y;
                }
                _ => {
                    return false;
                }
            }
        }
        Value::Map(x) => {
            match b {
                Value::Map(y) => {
                    return x == y;
                }
                _ => {
                    return false;
                }
            }
        }
    }
    return false;
}

/// Check if a value is Void (used for overflow/error detection)
pub fn value_is_void(v: Value) -> bool {
    match v {
        Value::Void => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

// ===========================================================================
// Memory -- byte-addressed simulated memory
// ===========================================================================
//
// Replaces Rust's Vec<u8> with a Fides Vec<i64> where each element
// stores one byte (0-255). This is simpler than bit-packing and
// sufficient for the interpreter's performance needs.

pub struct Memory {
    pub data: Vec<i64>,
    pub next_alloc: i64,
    // Every block's start address: Value::Int while live, Value::Void once
    // freed. A live block's Int is its size class's bytes (interp_mem_class),
    // or 1 for an address that is never reused (a string's bytes address,
    // a shared cell)
    pub blocks: I64Table,
    // Freed blocks by size class (stdlib-agent-bugs 20): the first free
    // block of each class, 0 for none; a free block's first word links to
    // the next. Memory_alloc takes one before growing the heap.
    pub free_heads: Vec<i64>,
    // A host string's address -> the address of the copy Memory_store_cstr
    // made of it (checked before reuse: Memory_cstr_cached)
    pub cstr_cache: I64Table,
}

/// Size classes of Memory blocks: 8-byte steps up to 4096 bytes (classes
/// 1-512), then powers of two (class 513 is 8192 bytes).
fn interp_mem_class(size: i64) -> i64 {
    if size <= 4096 {
        return (size + 7) >> 3;
    }
    var p: i64 = 8192;
    var c: i64 = 513;
    while p < size {
        p = p * 2;
        c = c + 1;
    }
    return c;
}

/// The bytes of a block of size class `c` (interp_mem_class).
fn interp_mem_class_bytes(c: i64) -> i64 {
    if c <= 512 {
        return c * 8;
    }
    var p: i64 = 8192;
    var k: i64 = 513;
    while k < c {
        p = p * 2;
        k = k + 1;
    }
    return p;
}

// The most simulated memory the interpreter hands out. Each byte is one
// 8-byte word of Memory.data: 127 MB here is 1 GB of the host's. The
// doublings of Memory.data past that (2 GB, 4 GB) are what died with
// "p_malloc: OOM allocating 2147483656 / 4294967304 bytes": the host's
// p_malloc(2^31 / 2^32) for Memory.data, grown by memory never reused
// (stdlib-agent-bugs 20, 51, 52), not a size computed from garbage.
const INTERP_MEM_LIMIT: i64 = 0x07F00000;

/// The element code in a Vec header's +24 word (core's vec_code_word:
/// 0, or P_VEC_TAG + code + 8; any other word is a word Vec).
fn interp_vec_decode(w: i64) -> i64 {
    if w == 0 {
        return 0;
    }
    var low: i64 = w & 255;
    if w - low != 0x4649445645430000 {
        return 0;
    }
    return low - 8;
}

/// Bytes per element of a Vec whose +24 word is `word` (release D14).
fn interp_vec_esz(word: i64) -> i64 {
    var code: i64 = interp_vec_decode(word);
    if code == 0 {
        return 8;
    }
    if code < 0 {
        return 0 - code;
    }
    // a struct held in the buffer: code - 15 words (core vec_esz)
    if code >= 16 {
        return (code - 15) * 8;
    }
    return code;
}

/// Element `i` of Vec data at `data` with element code `code`.
fn interp_vec_ld(mem: &Memory, data: i64, i: i64, word: i64) -> i64 {
    var code: i64 = interp_vec_decode(word);
    if code == 0 {
        return Memory_load_i64(mem, data + i * 8);
    }
    var esz: i64 = interp_vec_esz(word);
    var a: i64 = data + i * esz;
    // a struct held in the buffer is reached by its address (core vec_ld)
    if code >= 16 {
        return a;
    }
    var v: i64 = 0;
    var k: i64 = esz - 1;
    while k >= 0 {
        v = (v << 8) | Memory_load_byte(mem, a + k);
        k = k - 1;
    }
    if code < 0 {
        var top: i64 = 1 << (esz * 8 - 1);
        if v >= top {
            v = v - top * 2;
        }
    }
    return v;
}

fn interp_vec_st(mem: &mut Memory, data: i64, i: i64, word: i64, x: i64) {
    var code: i64 = interp_vec_decode(word);
    if code == 0 {
        Memory_store_i64(mem, data + i * 8, x);
        return;
    }
    var esz: i64 = interp_vec_esz(word);
    var a: i64 = data + i * esz;
    var k: i64 = 0;
    if code >= 16 {
        // a struct held in the buffer: `x` is the address of the value
        while k < esz {
            Memory_store_byte(mem, a + k, Memory_load_byte(mem, x + k));
            k = k + 1;
        }
        return;
    }
    while k < esz {
        Memory_store_byte(mem, a + k, (x >> (k * 8)) & 255);
        k = k + 1;
    }
}

/// 2g.60: is a value of IR type `ty` (known when `has`) an address?
fn interp_ty_is_ptr(has: bool, ty: IrType) -> bool {
    if !has {
        return false;
    }
    match ty {
        IrType::Ptr(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// 2g.60: the pointer operand of a Load or Store (-1 for any other
/// instruction), for Interpreter_run_function's late allocas.
fn interp_inst_ptr_operand(inst: &Inst) -> i64 {
    match inst {
        Inst::Store(sp, _, _) => {
            return sp;
        }
        Inst::Load(lp, _) => {
            return lp;
        }
        _ => {
        }
    }
    return -1;
}

pub fn Memory_new() -> Memory {
    var data: Vec<i64> = Vec::new();
    // Pre-allocate 1MB (1048576 bytes)
    var i: i64 = 0;
    while i < 1048576 {
        data.push(0);
        i = i + 1;
    }
    var heads: Vec<i64> = Vec::new();
    var hi: i64 = 0;
    while hi < 600 {
        heads.push(0);
        hi = hi + 1;
    }
    return Memory {
        data: data, next_alloc: 0x1000, blocks: I64Table_new(), free_heads: heads, cstr_cache: I64Table_new()
    };
}

/// A zeroed block of at least `size` bytes, 8-byte aligned: a freed block
/// of its size class when there is one, else new memory. 0 when the
/// interpreter's memory (INTERP_MEM_LIMIT) is used up.
pub fn Memory_alloc(self: &mut Memory, size: i64) -> i64 {
    if size <= 0 {
        return self.next_alloc;
    }
    if size > INTERP_MEM_LIMIT {
        return 0;
    }
    var cls: i64 = interp_mem_class(size);
    var csize: i64 = interp_mem_class_bytes(cls);
    if cls < self.free_heads.len() {
        var head: i64 = self.free_heads.get(cls);
        if head != 0 {
            var after: i64 = Memory_load_i64(self, head);
            self.free_heads.set(cls, after);
            // zeroed, as new memory is (C's alloca slots are memset too)
            var zi: i64 = 0;
            while zi < csize {
                self.data.set(head + zi, 0);
                zi = zi + 1;
            }
            I64Table_set(&mut self.blocks, head, Value::Int(csize));
            return head;
        }
    }
    var addr: i64 = self.next_alloc;
    // The globals live at 0x400000 (Interpreter_init_globals, 8 bytes
    // each): a heap past 4 MB jumped over them instead of overwriting them
    if addr < 0x500000 && addr + csize > 0x400000 {
        addr = 0x500000;
    }
    if addr + csize > INTERP_MEM_LIMIT {
        return 0;
    }
    I64Table_set(&mut self.blocks, addr, Value::Int(csize));
    // blocks start 8-byte aligned, as malloc's do: core takes an unaligned
    // string pointer for one without a header (p_str_hdr_len)
    self.next_alloc = addr + csize;
    // Grow if needed
    while self.next_alloc >= self.data.len() {
        var i: i64 = 0;
        while i < 4096 {
            self.data.push(0);
            i = i + 1;
        }
    }
    return addr;
}

/// Free a block: it goes on its size class's free list (a block marked 1
/// is never reused). A bad free fails as it does natively. Returns the
/// panic message, "" when the free is fine. Interpreter_free_block also
/// drops the side tables' entries for the block: free through it.
pub fn Memory_free(self: &mut Memory, addr: i64) -> str {
    var s: i64 = I64Table_find(&self.blocks, addr);
    if s < 0 {
        return "Invalid free: not an allocated block";
    }
    var csize: i64 = 0;
    match self.blocks.vals.get(s) {
        Value::Void => {
            return "Double free";
        }
        Value::Int(bn) => {
            csize = bn;
        }
        _ => {
        }
    }
    I64Table_set(&mut self.blocks, addr, Value::Void);
    if csize >= 8 {
        var cls: i64 = interp_mem_class(csize);
        if cls < self.free_heads.len() {
            var next_free: i64 = self.free_heads.get(cls);
            Memory_store_i64(self, addr, next_free);
            self.free_heads.set(cls, addr);
        }
    }
    return "";
}

/// The size of the live block at `addr` (its size class's bytes), 0 when
/// `addr` is not one or is never reused.
pub fn Memory_block_size(self: &Memory, addr: i64) -> i64 {
    var s: i64 = I64Table_find(&self.blocks, addr);
    if s < 0 {
        return 0;
    }
    match self.blocks.vals.get(s) {
        Value::Int(bn) => {
            if bn >= 8 {
                return bn;
            }
        }
        _ => {
        }
    }
    return 0;
}

/// May a store at `end` (exclusive) grow Memory.data? Only inside what was
/// handed out, or below 16 MB (the globals at 0x400000): a store far past
/// the heap (a garbage address) grew the host's memory to gigabytes.
fn Memory_may_grow_to(self: &Memory, end: i64) -> bool {
    return end < 0x1000000 || end <= self.next_alloc + 65536;
}

pub fn Memory_allocated(self: &Memory) -> i64 {
    return self.next_alloc;
}

pub fn Memory_capacity(self: &Memory) -> i64 {
    return self.data.len();
}

pub fn Memory_is_valid_addr(self: &Memory, addr: i64) -> bool {
    return addr >= 0 && addr < self.data.len();
}

// Store a single byte at addr
pub fn Memory_store_byte(self: &mut Memory, addr: i64, b: i64) {
    if addr < 0 {
        return;
    }
    if addr >= self.data.len() {
        // A store far past anything handed out is dropped (a load there
        // reads 0), not a reason to grow to that address
        if !Memory_may_grow_to(self, addr + 1) {
            return;
        }
        // Grow, as Memory::store (globals live at 0x400000)
        var target: i64 = addr + 1024;
        while self.data.len() < target {
            self.data.push(0);
        }
    }
    self.data.set(addr, b & 0xFF);
}

// Load a single byte from addr
pub fn Memory_load_byte(self: &Memory, addr: i64) -> i64 {
    if addr >= 0 && addr < self.data.len() {
        return self.data.get(addr);
    }
    return 0;
}

// Store an i64 (8 bytes, little-endian) at addr
pub fn Memory_store_i64(self: &mut Memory, addr: i64, val: i64) {
    var v: i64 = val;
    var i: i64 = 0;
    while i < 8 {
        Memory_store_byte(self, addr + i, v & 0xFF);
        v = v >> 8;
        i = i + 1;
    }
}

// Load an i64 (8 bytes, little-endian) from addr
pub fn Memory_load_i64(self: &Memory, addr: i64) -> i64 {
    var result: i64 = 0;
    var i: i64 = 0;
    while i < 8 {
        var b: i64 = Memory_load_byte(self, addr + i);
        result = result | (b << (i * 8));
        i = i + 1;
    }
    return result;
}

// Store a bool (1 byte) at addr
pub fn Memory_store_bool(self: &mut Memory, addr: i64, val: bool) {
    if val {
        Memory_store_byte(self, addr, 1);
    } else {
        Memory_store_byte(self, addr, 0);
    }
}

// Load a bool (1 byte) from addr
pub fn Memory_load_bool(self: &Memory, addr: i64) -> bool {
    return Memory_load_byte(self, addr) != 0;
}

// Store an i32 (4 bytes, little-endian) at addr
pub fn Memory_store_i32(self: &mut Memory, addr: i64, val: i64) {
    var v: i64 = val;
    var i: i64 = 0;
    while i < 4 {
        Memory_store_byte(self, addr + i, v & 0xFF);
        v = v >> 8;
        i = i + 1;
    }
}

// Store an i16 (2 bytes, little-endian) at addr
pub fn Memory_store_i16(self: &mut Memory, addr: i64, val: i64) {
    Memory_store_byte(self, addr, val & 0xFF);
    Memory_store_byte(self, addr + 1, (val >> 8) & 0xFF);
}

// Load an i32 (4 bytes, little-endian) from addr
pub fn Memory_load_i32(self: &Memory, addr: i64) -> i64 {
    var result: i64 = 0;
    var i: i64 = 0;
    while i < 4 {
        var b: i64 = Memory_load_byte(self, addr + i);
        result = result | (b << (i * 8));
        i = i + 1;
    }
    // Sign-extend from 32 bits
    if result >= 0x80000000 {
        result = result - 0x100000000;
    }
    return result;
}

// Store an f64 (8 bytes) at addr using p_f64_to_bits
pub fn Memory_store_f64(self: &mut Memory, addr: i64, val: f64) {
    var bits: i64 = p_f64_to_bits(val);
    Memory_store_i64(self, addr, bits);
}

// Bit reinterpretation through an 8-byte scratch cell (the bootstrap types
// the p_f64_from_bits / p_int_to_float builtins as returning i64).
pub fn f64_from_bits_i(bits: i64) -> f64 {
    var f: f64 = 0.0;
    // M2: the allocation and the int-to-pointer casts are unsafe too
    unsafe {
        var cell: i64 = p_malloc(8);
        var ip: *mut i64 = cell;
        *ip = bits;
        var fp: *mut f64 = cell;
        f = *fp;
        p_free(cell);
    }
    return f;
}

pub fn f32_from_bits_i(bits: i64) -> f64 {
    // IEEE single -> double, by fields (no f32 arithmetic)
    var b: i64 = bits & 0xFFFFFFFF;
    var neg: bool = ((b >> 31) & 1) == 1;
    var e: i64 = (b >> 23) & 0xFF;
    var m: i64 = b & 0x7FFFFF;
    var v: f64 = 0.0;
    if e == 0 {
        // zero / subnormal: m * 2^-149
        v = (m as f64) * f64_from_bits_i(874 * 4503599627370496);
    } else if e == 255 {
        v = f64_from_bits_i(2047 * 4503599627370496 + m * 536870912);
    } else {
        v = f64_from_bits_i((e - 127 + 1023) * 4503599627370496 + m * 536870912);
    }
    if neg {
        v = -v;
    }
    return v;
}

/// An f64 as the program's text: "NaN", "inf" and "-inf" as the native
/// runtimes print them (stdlib/pe_runtime/base.fd), any other value as
/// float_to_str. The C runtime's formatting divided an infinity by 10
/// forever and printed a NaN as "-nan(ind)" (stdlib-agent-bugs 6).
fn interp_f64_text(f: f64) -> str {
    if f != f {
        return "NaN";
    }
    // only an infinity minus itself is not a number
    val d: f64 = f - f;
    if d != d {
        if f > 0.0 {
            return "inf";
        }
        return "-inf";
    }
    return float_to_str(f);
}

// Load an f64 (8 bytes) from addr using p_f64_from_bits
pub fn Memory_load_f64(self: &Memory, addr: i64) -> f64 {
    var bits: i64 = Memory_load_i64(self, addr);
    return f64_from_bits_i(bits);
}

// Store an f32 (4 bytes) at addr
pub fn Memory_store_f32(self: &mut Memory, addr: i64, val: f64) {
    var bits: i64 = p_f32_to_bits(val);
    Memory_store_i32(self, addr, bits);
}

// Load an f32 (4 bytes) from addr
pub fn Memory_load_f32(self: &Memory, addr: i64) -> f64 {
    var bits: i64 = Memory_load_i32(self, addr);
    return f32_from_bits_i(bits);
}

// Copy `size` bytes from src to dst
pub fn Memory_copy(self: &mut Memory, dst: i64, src: i64, size: i64) {
    if size <= 0 || dst < 0 {
        return;
    }
    // Grow so the destination range exists (as Memory::store), but not to
    // a garbage address far past the heap
    if dst + size >= self.data.len() && !Memory_may_grow_to(self, dst + size) {
        return;
    }
    while dst + size >= self.data.len() {
        var gi: i64 = 0;
        while gi < 4096 {
            self.data.push(0);
            gi = gi + 1;
        }
    }
    // As memmove: backwards when the destination starts inside the source
    if dst > src && dst < src + size {
        var j: i64 = size - 1;
        while j >= 0 {
            self.data.set(dst + j, Memory_load_byte(self, src + j));
            j = j - 1;
        }
        return;
    }
    var i: i64 = 0;
    while i < size {
        self.data.set(dst + i, Memory_load_byte(self, src + i));
        i = i + 1;
    }
}

// Store a string as core keeps one (release D16): [magic][length], then
// the bytes and a terminator. Returns the address of the bytes; zero bytes
// inside the string are kept, and str_len reads the header.
pub fn Memory_store_cstr(self: &mut Memory, s: str) -> i64 {
    var slen: i64 = str_len(s);
    // The same string stored before and still there unchanged: that copy
    // (stdlib-agent-bugs 20: a string passed to a `str` or i64 parameter was
    // copied into memory on every call, a block never freed)
    var cached: i64 = Memory_cstr_cached(self, s, slen);
    if cached > 0 {
        return cached;
    }
    var block: i64 = Memory_alloc(self, slen + 17);
    Memory_store_i64(self, block, 0x4649444553545201);
    Memory_store_i64(self, block + 8, slen);
    var addr: i64 = block + 16;
    // Freeing the bytes' address directly (not through p_str_free) is a
    // free of this string too
    I64Table_set(&mut self.blocks, addr, Value::Int(1));
    var i: i64 = 0;
    while i < slen {
        // Read byte from string using pointer arithmetic
        var s_addr: i64 = s + i;
        var ptr: *mut u8 = s_addr;
        var b: i64 = 0;
        unsafe {
            b = *ptr;
        }
        Memory_store_byte(self, addr + i, b);
        i = i + 1;
    }
    Memory_store_byte(self, addr + slen, 0);
    I64Table_set(&mut self.cstr_cache, s as i64, Value::Int(addr));
    return addr;
}

/// The copy Memory_store_cstr made of the host string `s` (`slen` bytes),
/// when its block is still live and still holds exactly those bytes; 0
/// otherwise (a host address can be another string's later, and a block
/// can be freed and reused: both are checked).
fn Memory_cstr_cached(self: &Memory, s: str, slen: i64) -> i64 {
    var ca: i64 = 0;
    match I64Table_get(&self.cstr_cache, s as i64) {
        OptValue::Some(cv) => {
            match cv {
                Value::Int(cai) => {
                    ca = cai;
                }
                _ => {
                }
            }
        }
        OptValue::None => {
        }
    }
    if ca < 16 || Memory_block_size(self, ca - 16) < slen + 17 {
        return 0;
    }
    if Memory_load_i64(self, ca - 16) != 0x4649444553545201 || Memory_load_i64(self, ca - 8) != slen {
        return 0;
    }
    if Memory_load_byte(self, ca + slen) != 0 {
        return 0;
    }
    var i: i64 = 0;
    while i < slen {
        if Memory_load_byte(self, ca + i) != str_byte_at(s, i) {
            return 0;
        }
        i = i + 1;
    }
    return ca;
}

// Load a null-terminated C string from addr, return as str
pub fn Memory_load_cstr(self: &Memory, addr: i64) -> str {
    if addr <= 0 {
        return "";
    }
    // The bytes, then one string made of them (adding a character at a time
    // copied the string so far for each byte)
    var bytes: Vec<i64> = Vec::new();
    // A length-headered string: its length, zero bytes included. The
    // literal (D16) and static headers, and a counted heap string's
    // [P_STR_RC + count] (proposal 0004; stdlib-agent-bugs 35: such a
    // string was cut at its first zero byte, `s + "y"` included)
    if addr >= 16 {
        var magic: i64 = Memory_load_i64(self, addr - 16);
        if magic == 0x4649444553545201 || magic == 0x4649444553545202 || interp_str_count_word(magic) {
            var hlen: i64 = Memory_load_i64(self, addr - 8);
            if hlen >= 0 && addr + hlen <= self.data.len() {
                var hi: i64 = 0;
                while hi < hlen {
                    bytes.push(Memory_load_byte(self, addr + hi));
                    hi = hi + 1;
                }
                return str_from_bytes(bytes);
            }
        }
    }
    var offset: i64 = addr;
    while offset < self.data.len() {
        var b: i64 = Memory_load_byte(self, offset);
        if b == 0 {
            break;
        }
        bytes.push(b);
        offset = offset + 1;
    }
    return str_from_bytes(bytes);
}

/// Is `w` the header word of a counted string (core p_str_count_of > 0:
/// P_STR_RC + a count of owners, with or without P_STR_ROOM)?
fn interp_str_count_word(w: i64) -> bool {
    // compared before subtracting: any word can be here (no overflow)
    if w < 0x4649444500000000 || w >= 0x4649444600000000 {
        return false;
    }
    var d: i64 = w - 0x4649444500000000;
    if (d & 0x40000000) != 0 {
        return false;
    }
    return (d & 0x3FFFFFFF) >= 1;
}

// ===========================================================================
// ExecOutcome / RunResult -- instruction and function results
// ===========================================================================

pub enum ExecOutcome {
    Continue,
    Value(Value),
    Jump(i64),
    Return(Value),
    Panic(str),
}

pub enum RunResult {
    Return(Value),
    Panic(str),
    Paused,
}

// ===========================================================================
// Side-table entries for opaque values (Vec, Map, string addrs, globals)
// ===========================================================================
//
// These replace Rust's HashMap<K, V> with Vec-based lookup tables.

pub struct StringAddrEntry {
    pub content: str,
    pub addr: i64,
}

pub fn StringAddrEntry_new(content: str, addr: i64) -> StringAddrEntry {
    return StringAddrEntry {
        content: content, addr: addr
    };
}

pub struct GlobalAddrEntry {
    pub name: str,
    pub addr: i64,
}

pub fn GlobalAddrEntry_new(name: str, addr: i64) -> GlobalAddrEntry {
    return GlobalAddrEntry {
        name: name, addr: addr
    };
}

pub struct OpaqueEntry {
    pub addr: i64,
    pub value: Value,
}

pub fn OpaqueEntry_new(addr: i64, value: Value) -> OpaqueEntry {
    return OpaqueEntry {
        addr: addr, value: value
    };
}

pub struct OpaqueSnapshot {
    pub entries: I64Table,
}

// ---------------------------------------------------------------------------
// I64Table -- open-addressing hash map i64 -> Value (Rust's HashMap<u64, Value>
// for the opaque side table). state: 0 empty, 1 live, 2 deleted.
// ---------------------------------------------------------------------------

pub struct I64Table {
    pub keys: Vec<i64>,
    pub vals: Vec<Value>,
    pub state: Vec<i64>,
    pub live: i64,
    pub filled: i64,
}

pub fn I64Table_new() -> I64Table {
    var t: I64Table = I64Table {
        keys: Vec::new(), vals: Vec::new(), state: Vec::new(), live: 0, filled: 0
    };
    I64Table_init(&mut t, 256);
    return t;
}

fn I64Table_init(t: &mut I64Table, cap: i64) {
    var k: Vec<i64> = Vec::new();
    var v: Vec<Value> = Vec::new();
    var s: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < cap {
        k.push(0);
        v.push(Value::Void);
        s.push(0);
        i = i + 1;
    }
    t.keys = k;
    t.vals = v;
    t.state = s;
    t.live = 0;
    t.filled = 0;
}

fn i64_hash_slot(key: i64, mask: i64) -> i64 {
    var h: i64 = key ^ (key >> 16);
    h = h ^ (h >> 5);
    return h & mask;
}

pub fn I64Table_find(t: &I64Table, key: i64) -> i64 {
    var cap: i64 = t.keys.len();
    var mask: i64 = cap - 1;
    var i: i64 = i64_hash_slot(key, mask);
    while true {
        var st: i64 = t.state.get(i);
        if st == 0 {
            return -1;
        }
        if st == 1 {
            if t.keys.get(i) == key {
                return i;
            }
        }
        i = (i + 1) & mask;
    }
    return -1;
}

pub fn I64Table_get(t: &I64Table, key: i64) -> OptValue {
    var s: i64 = I64Table_find(t, key);
    if s < 0 {
        return OptValue::None;
    }
    return OptValue::Some(t.vals.get(s));
}

fn I64Table_rehash(t: &mut I64Table) {
    var old_keys: Vec<i64> = t.keys;
    var old_vals: Vec<Value> = t.vals;
    var old_state: Vec<i64> = t.state;
    var cap: i64 = old_keys.len();
    if t.live * 4 >= cap {
        cap = cap * 2;
    }
    I64Table_init(t, cap);
    var i: i64 = 0;
    while i < old_keys.len() {
        if old_state.get(i) == 1 {
            I64Table_set(t, old_keys.get(i), old_vals.get(i));
        }
        i = i + 1;
    }
}

pub fn I64Table_set(t: &mut I64Table, key: i64, val: Value) {
    var s: i64 = I64Table_find(t, key);
    if s >= 0 {
        t.vals.set(s, val);
        return;
    }
    if (t.filled + 1) * 2 > t.keys.len() {
        I64Table_rehash(t);
    }
    var mask: i64 = t.keys.len() - 1;
    var i: i64 = i64_hash_slot(key, mask);
    while t.state.get(i) == 1 {
        i = (i + 1) & mask;
    }
    if t.state.get(i) == 0 {
        t.filled = t.filled + 1;
    }
    t.keys.set(i, key);
    t.vals.set(i, val);
    t.state.set(i, 1);
    t.live = t.live + 1;
}

pub fn I64Table_remove(t: &mut I64Table, key: i64) {
    var s: i64 = I64Table_find(t, key);
    if s >= 0 {
        t.state.set(s, 2);
        t.vals.set(s, Value::Void);
        t.live = t.live - 1;
    }
}

pub fn I64Table_clone(t: &I64Table) -> I64Table {
    return I64Table {
        keys: t.keys.clone(), vals: t.vals.clone(), state: t.state.clone(), live: t.live, filled: t.filled
    };
}

// ---------------------------------------------------------------------------
// StrTable -- open-addressing hash map str -> i64 (function / runtime-name
// caches). No deletion.
// ---------------------------------------------------------------------------

pub struct StrTable {
    pub keys: Vec<str>,
    pub vals: Vec<i64>,
    pub used: Vec<bool>,
    pub count: i64,
}

pub fn StrTable_new(cap: i64) -> StrTable {
    var k: Vec<str> = Vec::new();
    var v: Vec<i64> = Vec::new();
    var u: Vec<bool> = Vec::new();
    var i: i64 = 0;
    while i < cap {
        k.push("");
        v.push(0);
        u.push(false);
        i = i + 1;
    }
    return StrTable {
        keys: k, vals: v, used: u, count: 0
    };
}

fn str_hash_i(s: str) -> i64 {
    var n: i64 = str_len(s);
    var h: i64 = n;
    var i: i64 = 0;
    while i < n && i < 48 {
        var ap: i64 = s + i;
        var bp: *mut u8 = ap;
        var b: i64 = 0;
        unsafe {
            b = *bp;
        }
        h = ((h * 31) + b) & 0x3FFFFFFFFFFF;
        i = i + 1;
    }
    return h;
}

/// Slot of `key`, or -1.
pub fn StrTable_find(t: &StrTable, key: str) -> i64 {
    var mask: i64 = t.keys.len() - 1;
    var i: i64 = str_hash_i(key) & mask;
    while t.used.get(i) {
        if t.keys.get(i) == key {
            return i;
        }
        i = (i + 1) & mask;
    }
    return -1;
}

pub fn StrTable_get(t: &StrTable, key: str, dflt: i64) -> i64 {
    var s: i64 = StrTable_find(t, key);
    if s < 0 {
        return dflt;
    }
    return t.vals.get(s);
}

pub fn StrTable_set(t: &mut StrTable, key: str, val: i64) {
    var s: i64 = StrTable_find(t, key);
    if s >= 0 {
        t.vals.set(s, val);
        return;
    }
    if (t.count + 1) * 2 > t.keys.len() {
        var old_k: Vec<str> = t.keys;
        var old_v: Vec<i64> = t.vals;
        var old_u: Vec<bool> = t.used;
        var nt: StrTable = StrTable_new(old_k.len() * 2);
        t.keys = nt.keys;
        t.vals = nt.vals;
        t.used = nt.used;
        t.count = 0;
        var j: i64 = 0;
        while j < old_k.len() {
            if old_u.get(j) {
                StrTable_set(t, old_k.get(j), old_v.get(j));
            }
            j = j + 1;
        }
    }
    var mask: i64 = t.keys.len() - 1;
    var i: i64 = str_hash_i(key) & mask;
    while t.used.get(i) {
        i = (i + 1) & mask;
    }
    t.keys.set(i, key);
    t.vals.set(i, val);
    t.used.set(i, true);
    t.count = t.count + 1;
}

fn Memory_clone(m: &Memory) -> Memory {
    return Memory {
        data: m.data.clone(), next_alloc: m.next_alloc, blocks: I64Table_clone(&m.blocks), free_heads: m.free_heads.clone(), cstr_cache: I64Table_clone(&m.cstr_cache)
    };
}

pub struct ArrayBoundEntry {
    pub addr: i64,
    pub size: i64,
}

pub fn ArrayBoundEntry_new(addr: i64, size: i64) -> ArrayBoundEntry {
    return ArrayBoundEntry {
        addr: addr, size: size
    };
}

pub struct VecSideEntry {
    pub vec_addr: i64,
    pub side_idx: i64,
}

pub fn VecSideEntry_new(vec_addr: i64, side_idx: i64) -> VecSideEntry {
    return VecSideEntry {
        vec_addr: vec_addr, side_idx: side_idx
    };
}

// Vec side-table: stores Vec<Value> for interpreter-created Vecs
pub struct VecValueEntry {
    pub handle: i64,
    pub elements: Vec<Value>,
}

pub fn VecValueEntry_new(handle: i64) -> VecValueEntry {
    return VecValueEntry {
        handle: handle, elements: Vec::new()
    };
}

// Map side-table: stores key-value pairs for interpreter-created Maps
pub struct MapValueEntry {
    pub handle: i64,
    pub keys: Vec<str>,
    pub vals: Vec<Value>,
}

// Tensor side-table: maps an opaque Ptr addr -> index into interp.tensors.
// Value::Ptr(addr) stands in for Rust's Value::Tensor (see file header).
pub struct TensorSideEntry {
    pub addr: i64,
    pub handle: i64,
}

pub fn TensorSideEntry_new(addr: i64, handle: i64) -> TensorSideEntry {
    return TensorSideEntry {
        addr: addr, handle: handle
    };
}

pub fn MapValueEntry_new(handle: i64) -> MapValueEntry {
    return MapValueEntry {
        handle: handle, keys: Vec::new(), vals: Vec::new()
    };
}

// ===========================================================================
// Interpreter -- the IR interpreter
// ===========================================================================
//
// Fields mirror src/interp.rs::Interpreter, simplified for self-hosting.
// Advanced features (autograd, futures, channels, ECS, etc.) are stubbed
// or omitted in this initial port. Core execution is fully implemented.

pub struct Interpreter {
    pub module: IrModule,
    pub memory: Memory,
    pub string_addrs: Vec<StringAddrEntry>,
    pub global_addrs: Vec<GlobalAddrEntry>,
    pub opaque_values: I64Table,
    // MakeDyn: data pointer -> concrete type name (Rust's Value::Dyn)
    pub dyn_types: I64Table,
    // name -> index in module.functions (-1: none)
    pub fn_cache: StrTable,
    // name -> 1 runtime builtin / 0 not (memo of is_runtime_func)
    pub rt_cache: StrTable,
    // is the current function @wrapping
    pub cur_wrapping: bool,
    pub vec_side_table: Vec<VecSideEntry>,
    pub vec_values: Vec<VecValueEntry>,
    pub map_values: Vec<MapValueEntry>,
    pub tensors: Vec<TensorData>,
    pub tensor_side_table: Vec<TensorSideEntry>,
    pub tensor_index: I64Table,
    pub kv_caches: Vec<KvCache>,
    pub verbose: bool,
    pub debug_mode: bool,
    /// Coverage (fid veil): each instruction run, once, in the order first run
    pub cov_on: bool,
    pub cov_seen: i64,
    pub cov_fns: Vec<str>,
    pub cov_ids: Vec<i64>,
    // CT8 branch coverage: "fn#inst#T" / "fn#inst#F" for each way a
    // conditional branch went (Interpreter_branch_report)
    pub cov_br_seen: i64,
    // An array alloca's address -> Value::Int(its element count) (a hash
    // table: a list scanned on every index grew by one per call)
    pub array_bounds: I64Table,
    // The allocas of the calls running, innermost last: each call frees its
    // own when it returns (stdlib-agent-bugs 20: they were never freed)
    pub frame_allocas: Vec<i64>,
    pub current_func_name: str,
    pub call_stack: Vec<str>,
    pub call_site_lines: Vec<i64>,
    pub pending_call_site: OptU64,
    pub panic_stack_trace: OptStr,
    pub interp_unsafe_depth: i64,
    pub txn_mem_snapshots: Vec<Memory>,
    pub txn_opaque_snapshots: Vec<OpaqueSnapshot>,
    pub max_recursion: i64,
    pub max_steps: i64,
    pub step_count: i64,
    pub max_memory: i64,
    pub region_stack: Vec<str>,
    // PRNG state for DP noise (xorshift128+)
    pub prng_state_a: u64,
    pub prng_state_b: u64,
    // DP epsilon budget tracking
    pub dp_epsilon_budget: f64,
    pub dp_epsilon_limit: f64,
    pub thread_handle_count: i64,
    // Spawn/future results — p_executor_spawn runs eagerly and stores the
    // task's return Value here; the Int handle indexes this table
    // (p_thread_spawn's tasks are itasks since LG11).
    pub future_values: Vec<Value>,
    pub future_exec: Vec<i64>,
    pub executor_count: i64,
    pub shared_mem: I64Table,
    pub next_shared_addr: i64,
    pub next_mutex_handle: i64,
    pub tls: I64Table,
    pub next_tls_key: i64,
    pub chans: Vec<ChanState>,
    pub dl_handles: I64Table,
    pub next_dl_handle: i64,
    pub ecs_entity_count: i64,
    pub ecs_comps: Vec<EcsComp>,
    pub sb_strs: Vec<str>,
    pub db_rows: Vec<DbRow>,
    pub next_db_handle: i64,
    pub closed_dbs: Vec<i64>,
    pub alloc_ptr: i64,
    pub persist_keys: Vec<str>,
    pub persist_vals: Vec<str>,
    pub ag_enabled: bool,
    pub ag_checkpoint: bool,
    pub ag_tape: Vec<AgEntry>,
    pub ag_grad_keys: Vec<i64>,
    pub ag_grad_vals: Vec<TensorData>,
    // Cooperative green-thread scheduler (p_gt_* builtins).
    pub gt_scheduler: GreenThreadScheduler,
    // Run-time capability revocation (roadmap Phase 12 "runtime sandbox"):
    // the capabilities revoked so far (p_cap_revoke, p_sandbox_enter), and
    // the length of that list at each open p_sandbox_enter
    pub revoked_caps: Vec<str>,
    pub cap_marks: Vec<i64>,
    // LG11: the interpreted tasks (p_co_go, p_co_async, p_thread_spawn),
    // the one running on a stack of its own (-1: main), the ones waiting
    // for a free slot (from itask_pending_at on), how many have a stack now
    // and how many of those or the waiting ones have not ended (section
    // "Interleaved tasks")
    pub itasks: Vec<ITask>,
    pub itask_cur: i64,
    pub itask_pending: Vec<i64>,
    pub itask_pending_at: i64,
    pub itask_live: i64,
    pub itask_open: i64,
}

pub fn Interpreter_new(module: IrModule) -> Interpreter {
    var interp: Interpreter = Interpreter {
        module: module, memory: Memory_new(), string_addrs: Vec::new(), global_addrs: Vec::new(), opaque_values: I64Table_new(), dyn_types: I64Table_new(), fn_cache: StrTable_new(1024), rt_cache: StrTable_new(256), cur_wrapping: false, vec_side_table: Vec::new(), vec_values: Vec::new(), map_values: Vec::new(), tensors: Vec::new(), tensor_side_table: Vec::new(), tensor_index: I64Table_new(), kv_caches: Vec::new(), verbose: false, debug_mode: true, cov_on: false, cov_seen: HashMap_new(), cov_fns: Vec::new(), cov_ids: Vec::new(), cov_br_seen: HashMap_new(), array_bounds: I64Table_new(), frame_allocas: Vec::new(), current_func_name: "", call_stack: Vec::new(), call_site_lines: Vec::new(), pending_call_site: OptU64::None, panic_stack_trace: OptStr::None, interp_unsafe_depth: 0, txn_mem_snapshots: Vec::new(), txn_opaque_snapshots: Vec::new(), max_recursion: 1000, max_steps: 0, step_count: 0, max_memory: 0, region_stack: Vec::new(), prng_state_a: 0x9E3779B97F4A7C15, prng_state_b: 0xBF58476D1CE4E5B9, dp_epsilon_budget: 0.0, dp_epsilon_limit: 0.0, thread_handle_count: 0, future_values: Vec::new(), future_exec: Vec::new(), executor_count: 0, shared_mem: I64Table_new(), next_shared_addr: 0x10000000, next_mutex_handle: 1, tls: I64Table_new(), next_tls_key: 0, chans: Vec::new(), dl_handles: I64Table_new(), next_dl_handle: 1, ecs_entity_count: 0, ecs_comps: Vec::new(), sb_strs: Vec::new(), db_rows: Vec::new(), next_db_handle: 1, closed_dbs: Vec::new(), alloc_ptr: 0x10000, persist_keys: Vec::new(), persist_vals: Vec::new(), ag_enabled: false, ag_checkpoint: false, ag_tape: Vec::new(), ag_grad_keys: Vec::new(), ag_grad_vals: Vec::new(), gt_scheduler: GreenThreadScheduler_new(), revoked_caps: Vec::new(), cap_marks: Vec::new(), itasks: Vec::new(), itask_cur: -1, itask_pending: Vec::new(), itask_pending_at: 0, itask_live: 0, itask_open: 0,
    };
    // Function index (first definition wins, as IrModule_get_function)
    var fi: i64 = 0;
    while fi < interp.module.functions.len() {
        var fname: str = interp.module.functions.get(fi).name;
        if StrTable_find(&interp.fn_cache, fname) < 0 {
            StrTable_set(&mut interp.fn_cache, fname, fi);
        }
        fi = fi + 1;
    }
    Interpreter_init_strings(&mut interp);
    Interpreter_init_globals(&mut interp);
    return interp;
}

/// IrModule_get_function through the name index.
pub fn Interpreter_get_function(self: &Interpreter, name: str) -> OptIrFunction {
    var idx: i64 = StrTable_get(&self.fn_cache, name, -1);
    if idx < 0 {
        return OptIrFunction::None;
    }
    return OptIrFunction::Some(self.module.functions.get(idx).func);
}

pub fn Interpreter_verbose(self: &mut Interpreter) {
    self.verbose = true;
}

pub fn Interpreter_set_max_recursion(self: &mut Interpreter, depth: i64) {
    self.max_recursion = depth;
}

pub fn Interpreter_set_max_steps(self: &mut Interpreter, steps: i64) {
    self.max_steps = steps;
}

pub fn Interpreter_set_max_memory(self: &mut Interpreter, bytes: i64) {
    self.max_memory = bytes;
}

// ===========================================================================
// Lookup helpers for Vec-based maps
// ===========================================================================

pub fn Interpreter_lookup_string_addr(self: &Interpreter, content: str) -> i64 {
    var i: i64 = 0;
    while i < self.string_addrs.len() {
        if self.string_addrs.get(i).content == content {
            return self.string_addrs.get(i).addr;
        }
        i = i + 1;
    }
    return 0;
}

pub fn Interpreter_lookup_global_addr(self: &Interpreter, name: str) -> i64 {
    var i: i64 = 0;
    while i < self.global_addrs.len() {
        if self.global_addrs.get(i).name == name {
            return self.global_addrs.get(i).addr;
        }
        i = i + 1;
    }
    return 0;
}

pub fn Interpreter_lookup_opaque(self: &Interpreter, addr: i64) -> OptValue {
    return I64Table_get(&self.opaque_values, addr);
}

pub fn Interpreter_set_opaque(self: &mut Interpreter, addr: i64, value: Value) {
    I64Table_set(&mut self.opaque_values, addr, value);
}

pub fn Interpreter_remove_opaque(self: &mut Interpreter, addr: i64) {
    I64Table_remove(&mut self.opaque_values, addr);
}

pub fn Interpreter_lookup_array_bound(self: &Interpreter, addr: i64) -> i64 {
    match I64Table_get(&self.array_bounds, addr) {
        OptValue::Some(bv) => {
            match bv {
                Value::Int(bn) => {
                    return bn;
                }
                _ => {
                }
            }
        }
        OptValue::None => {
        }
    }
    return -1;
}

pub fn Interpreter_set_array_bound(self: &mut Interpreter, addr: i64, size: i64) {
    I64Table_set(&mut self.array_bounds, addr, Value::Int(size));
}

/// Forget what the side tables know about the `size` bytes at `addr` (a
/// block being freed or an alloca made again): with memory reused, a
/// stale entry would be read for the next block there.
fn Interpreter_clear_block_side(self: &mut Interpreter, addr: i64, size: i64) {
    if self.opaque_values.live > 0 {
        var w: i64 = 0;
        while w < size {
            I64Table_remove(&mut self.opaque_values, addr + w);
            w = w + 8;
        }
    }
    if self.array_bounds.live > 0 {
        I64Table_remove(&mut self.array_bounds, addr);
    }
    if self.dyn_types.live > 0 {
        I64Table_remove(&mut self.dyn_types, addr);
    }
}

/// Free a block of interpreted memory (p_free, a returning call's allocas):
/// its side-table entries go, and Memory_free puts it on a free list.
/// Returns Memory_free's panic message ("" when the free is fine).
pub fn Interpreter_free_block(self: &mut Interpreter, addr: i64) -> str {
    var bsize: i64 = Memory_block_size(&self.memory, addr);
    if bsize > 0 {
        Interpreter_clear_block_side(self, addr, bsize);
    }
    return Memory_free(&mut self.memory, addr);
}

// OptValue for opaque lookups
pub enum OptValue {
    Some(Value),
    None,
}

// OptStr for panic_stack_trace
pub enum OptStr {
    Some(str),
    None,
}

// OptVecI64 for vec extraction helpers
pub enum OptVecI64 {
    Some(Vec<i64>),
    None,
}

// OptVecF64 for vec extraction helpers
pub enum OptVecF64 {
    Some(Vec<f64>),
    None,
}

// ===========================================================================
// init_strings / init_globals
// ===========================================================================

pub fn Interpreter_init_strings(self: &mut Interpreter) {
    var i: i64 = 0;
    while i < self.module.string_constants.len() {
        var s: str = self.module.string_constants.get(i).key;
        var addr: i64 = Memory_store_cstr(&mut self.memory, s);
        self.string_addrs.push(StringAddrEntry_new(s, addr));
        Interpreter_set_opaque(self, addr, Value::Str(s));
        i = i + 1;
    }
}

pub fn Interpreter_init_globals(self: &mut Interpreter) {
    var addr: i64 = 0x00400000;
    var i: i64 = 0;
    while i < self.module.globals.len() {
        var entry: GlobalEntry = self.module.globals.get(i);
        self.global_addrs.push(GlobalAddrEntry_new(entry.name, addr));
        var init_val: Value = eval_global_init(entry.init, entry.ty);
        match init_val {
            Value::Int(v) => {
                Memory_store_i64(&mut self.memory, addr, v);
            }
            Value::Float(v) => {
                Memory_store_f64(&mut self.memory, addr, v);
            }
            Value::Bool(v) => {
                Memory_store_bool(&mut self.memory, addr, v);
            }
            Value::Ptr(v) => {
                Memory_store_i64(&mut self.memory, addr, v);
            }
            Value::Str(s) => {
                var str_addr: i64 = Memory_store_cstr(&mut self.memory, s);
                Interpreter_set_opaque(self, str_addr, Value::Str(s));
                Memory_store_i64(&mut self.memory, addr, str_addr);
            }
            _ => {
                Memory_store_i64(&mut self.memory, addr, 0);
            }
        }
        // A struct or array global takes its whole size (stdlib-agent-bugs
        // 25: one 8-byte slot each let the next global overwrite a struct
        // global's second field)
        var gsize: i64 = IrModule_type_size(&self.module, entry.ty);
        gsize = (gsize + 7) & (0 - 8);
        if gsize < 8 {
            gsize = 8;
        }
        addr = addr + gsize;
        i = i + 1;
    }
}

pub fn eval_global_init(expr: Expr, ty: IrType) -> Value {
    match expr {
        Expr::IntLit(v) => {
            match ty {
                IrType::Bool => {
                    return Value::Bool(v != 0);
                }
                _ => {
                    return Value::Int(v);
                }
            }
        }
        Expr::FloatLit(v) => {
            return Value::Float(v);
        }
        Expr::BoolLit(b) => {
            return Value::Bool(b);
        }
        Expr::StringLit(s) => {
            return Value::Str(s);
        }
        _ => {
            return Value::Int(0);
        }
    }
    return Value::Int(0);
}

// ===========================================================================
// value_to_string -- convert a Value to a display string
// ===========================================================================

pub fn Interpreter_value_to_string(self: &Interpreter, v: Value) -> str {
    match v {
        Value::Str(s) => {
            return s;
        }
        Value::Ptr(addr) => {
            return Memory_load_cstr(&self.memory, addr);
        }
        Value::Int(i) => {
            // An Int may be a string pointer (a Str passed to an i64 param)
            if i > 0 {
                match Interpreter_lookup_opaque(self, i) {
                    OptValue::Some(ov) => {
                        match ov {
                            Value::Str(os) => {
                                return os;
                            }
                            _ => {
                            }
                        }
                    }
                    OptValue::None => {
                    }
                }
            }
            if i > 0 && Memory_is_valid_addr(&self.memory, i) {
                // A string in memory: the length its header gives (core's
                // counted, uncounted and literal strings), else up to the NUL.
                // An empty one is "" (its address is not a number to print).
                var hlen: i64 = -1;
                if i >= 16 && Memory_is_valid_addr(&self.memory, i - 16) {
                    var hw: i64 = Memory_load_i64(&self.memory, i - 16);
                    var hl: i64 = Memory_load_i64(&self.memory, i - 8);
                    // (the range test before any subtraction: any word can
                    // be here, and `hw - base` overflowed on a negative one)
                    if hw >= 0x4649444500000000 && hw < 0x4649444600000000 && hl >= 0 && hl < 0x10000000000 {
                        hlen = hl;
                    }
                    if (hw == 0x4649444553545201 || hw == 0x4649444553545202) && hl >= 0 && hl < 0x10000000000 {
                        hlen = hl;
                    }
                }
                // the bytes, then one string (a string builder per call
                // kept 4 KB of the host's memory each time)
                var obytes: Vec<i64> = Vec::new();
                var n: i64 = 0;
                var limit: i64 = 16777216;
                if hlen >= 0 {
                    limit = hlen;
                }
                while n < limit {
                    var b: i64 = Memory_load_byte(&self.memory, i + n);
                    if b == 0 && hlen < 0 {
                        break;
                    }
                    obytes.push(b);
                    n = n + 1;
                }
                return str_from_bytes(obytes);
            }
            return int_to_str(i);
        }
        _ => {
            return "";
        }
    }
    return "";
}

/// RT2: the first `n` bytes at a (pointer) value, zero bytes included: a
/// string's bytes (at most its length), or `n` bytes of interpreted memory
/// at an address. Fewer than `n` when the value holds fewer.
pub fn Interpreter_value_bytes(self: &Interpreter, v: Value, n: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var addr: i64 = 0;
    match v {
        Value::Str(s) => {
            var sn: i64 = str_len(s);
            var si: i64 = 0;
            while si < n && si < sn {
                out.push(str_byte_at(s, si));
                si = si + 1;
            }
            return out;
        }
        Value::Ptr(a) => {
            addr = a;
        }
        Value::Int(a) => {
            // an Int may be a string the interpreter holds (a Str passed
            // to an i64 parameter)
            if a > 0 {
                match Interpreter_lookup_opaque(self, a) {
                    OptValue::Some(ov) => {
                        match ov {
                            Value::Str(os) => {
                                var on: i64 = str_len(os);
                                var oi: i64 = 0;
                                while oi < n && oi < on {
                                    out.push(str_byte_at(os, oi));
                                    oi = oi + 1;
                                }
                                return out;
                            }
                            _ => {
                            }
                        }
                    }
                    OptValue::None => {
                    }
                }
            }
            addr = a;
        }
        _ => {
        }
    }
    if addr <= 0 || n <= 0 || !Memory_is_valid_addr(&self.memory, addr) {
        return out;
    }
    if !Memory_is_valid_addr(&self.memory, addr + n - 1) {
        return out;
    }
    var i: i64 = 0;
    while i < n {
        out.push(Memory_load_byte(&self.memory, addr + i));
        i = i + 1;
    }
    return out;
}

/// Rust's `Display for Value`.
pub fn Interpreter_display_value(self: &Interpreter, v: Value) -> str {
    match v {
        Value::Int(i) => {
            return int_to_str(i);
        }
        Value::Float(f) => {
            return interp_f64_text(f);
        }
        Value::Bool(b) => {
            if b {
                return "true";
            }
            return "false";
        }
        Value::Str(s) => {
            return s;
        }
        Value::Ptr(p) => {
            var dth: i64 = Interpreter_tensor_handle(self, v);
            if dth >= 0 {
                return interp_tensor_to_string(&self.tensors.get(dth));
            }
            return "ptr(0x" + int_to_hex(p) + ")";
        }
        Value::Void => {
            return "void";
        }
        Value::Vec(h) => {
            var out: str = "[";
            if h >= 0 && h < self.vec_values.len() {
                var elems: Vec<Value> = self.vec_values.get(h).elements;
                var i: i64 = 0;
                while i < elems.len() {
                    if i > 0 {
                        out = out + ", ";
                    }
                    out = out + Interpreter_display_value(self, elems.get(i));
                    i = i + 1;
                }
            }
            return out + "]";
        }
        Value::Map(mh) => {
            var mout: str = "{";
            if mh >= 0 && mh < self.map_values.len() {
                var me: MapValueEntry = self.map_values.get(mh);
                var order: Vec<i64> = sorted_key_order(me.keys);
                var j: i64 = 0;
                while j < order.len() {
                    if j > 0 {
                        mout = mout + ", ";
                    }
                    var k: i64 = order.get(j);
                    mout = mout + me.keys.get(k) + ": " + Interpreter_display_value(self, me.vals.get(k));
                    j = j + 1;
                }
            }
            return mout + "}";
        }
    }
    return "";
}

/// Indices of `keys` in ascending string order (insertion sort).
pub fn sorted_key_order(keys: Vec<str>) -> Vec<i64> {
    var order: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < keys.len() {
        var j: i64 = order.len();
        order.push(i);
        while j > 0 && str_lt(keys.get(i), keys.get(order.get(j - 1))) {
            order.set(j, order.get(j - 1));
            j = j - 1;
        }
        order.set(j, i);
        i = i + 1;
    }
    return order;
}

/// Byte-wise string ordering (Rust's str Ord).
pub fn str_lt(a: str, b: str) -> bool {
    var la: i64 = str_len(a);
    var lb: i64 = str_len(b);
    var i: i64 = 0;
    while i < la && i < lb {
        var ca: i64 = str_byte_at(a, i);
        var cb: i64 = str_byte_at(b, i);
        if ca != cb {
            return ca < cb;
        }
        i = i + 1;
    }
    return la < lb;
}

/// Print `v` with the Fides formatter `fname` (Vec_to_str, HashMap_to_str).
/// Continue / Panic when handled; Value(Void) when the caller should fall
/// back to the default printing.
pub fn Interpreter_print_via(self: &mut Interpreter, fname: str, v: Value) -> ExecOutcome {
    match Interpreter_get_function(self, fname) {
        OptIrFunction::Some(callee) => {
            var fargs: Vec<Value> = Vec::new();
            fargs.push(Value::Int(0));
            fargs.push(v);
            match Interpreter_run_function(self, callee, fargs) {
                RunResult::Return(rv) => {
                    match rv {
                        Value::Str(rs) => {
                            p_print_str(rs);
                            return ExecOutcome::Continue;
                        }
                        Value::Ptr(ra) => {
                            p_print_str(Memory_load_cstr(&self.memory, ra));
                            return ExecOutcome::Continue;
                        }
                        _ => {
                        }
                    }
                }
                RunResult::Panic(msg) => {
                    return ExecOutcome::Panic(msg);
                }
                RunResult::Paused => {
                }
            }
        }
        OptIrFunction::None => {
        }
    }
    return ExecOutcome::Value(Value::Void);
}
// ===========================================================================
// format_call_stack -- for panic stack traces
// ===========================================================================

pub fn Interpreter_format_call_stack(self: &Interpreter) -> str {
    if self.call_stack.len() == 0 {
        return "";
    }
    var out: str = "stack trace:\n";
    var i: i64 = self.call_stack.len() - 1;
    var idx: i64 = 0;
    while i >= 0 {
        var name: str = self.call_stack.get(i);
        var suffix: str = "";
        if i < self.call_site_lines.len() {
            var line: i64 = self.call_site_lines.get(i);
            if line > 0 {
                suffix = " at line " + int_to_str(line);
            }
        }
        if idx == 0 {
            out = out + "    → " + name + suffix + "\n";
        } else {
            out = out + "    ↳ called from " + name + suffix + "\n";
        }
        i = i - 1;
        idx = idx + 1;
    }
    return out;
}

// ===========================================================================
// run -- entry point: find and execute main()
// ===========================================================================

pub fn Interpreter_run(self: &mut Interpreter) -> RunResult {
    match Interpreter_get_function(self, "main") {
        OptIrFunction::Some(main_fn) => {
            return Interpreter_run_function(self, main_fn, Vec::new());
        }
        OptIrFunction::None => {
            return RunResult::Panic("No main function found");
        }
    }
    return RunResult::Panic("No main function found");
}

// ===========================================================================
// run_function -- execute a function with arguments
// ===========================================================================

pub fn Interpreter_run_function(self: &mut Interpreter, func: IrFunction, args: Vec<Value>) -> RunResult {
    // Recursion depth check
    if self.call_stack.len() >= self.max_recursion {
        var depth: i64 = self.max_recursion;
        var caller: str = "";
        if self.call_stack.len() > 0 {
            caller = self.call_stack.get(self.call_stack.len() - 1);
        }
        self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
        return RunResult::Panic("Recursion depth limit (" + int_to_str(depth) + ") exceeded in function '" + func.name + "' (called from '" + caller + "')");
    }
    // LG11: in a task on a small stack, its calls stay within its budget
    if g_itask_top != 0 && g_itask_budget != 0 {
        var stack_msg: str = Interpreter_itask_stack_check(self, func.name);
        if str_len(stack_msg) > 0 {
            self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
            return RunResult::Panic(stack_msg);
        }
    }

    pgo_note_call(func.name);
    var saved_func_name: str = self.current_func_name;
    var saved_wrapping: bool = self.cur_wrapping;
    self.current_func_name = func.name;
    self.cur_wrapping = func.is_wrapping;
    self.call_stack.push(func.name);
    // SL15: p_prof_start's counting profiler, a sample per call
    if g_ip_prof_on {
        interp_prof_count(&self.call_stack);
    }
    var saved_call_site: OptU64 = self.pending_call_site;
    self.pending_call_site = OptU64::None;
    var call_line: i64 = 0;
    match saved_call_site {
        OptU64::Some(line) => {
            call_line = line;
        }
        OptU64::None => {
            call_line = 0;
        }
    }
    self.call_site_lines.push(call_line);

    var saved_region_depth: i64 = self.region_stack.len();
    // this call's allocas are the ones pushed after this mark
    var frame_mark: i64 = self.frame_allocas.len();

    // Build value table: Vec<ValueIdValue> where index = value_id
    // We use a Vec<Value> indexed by value_id for O(1) lookup.
    var max_val: i64 = func.next_value;
    var values: Vec<Value> = Vec::new();
    var vi: i64 = 0;
    while vi < max_val {
        values.push(Value::Void);
        vi = vi + 1;
    }

    // Detect missing __env param: if first param is Ptr(U8) and caller
    // passed one fewer arg, insert a dummy env value.
    var effective_args: Vec<Value> = Vec::new();
    var has_env_param: bool = false;
    if func.params.len() > 0 {
        var first_param: ValueIdType = func.params.get(0);
        match first_param.ty {
            IrType::Ptr(inner) => {
                match inner {
                    IrType::U8 => {
                        has_env_param = true;
                    }
                    _ => {
                    }
                }
            }
            _ => {
            }
        }
    }
    if has_env_param && args.len() == func.params.len() - 1 {
        effective_args.push(Value::Int(0));
        var ai: i64 = 0;
        while ai < args.len() {
            effective_args.push(args.get(ai));
            ai = ai + 1;
        }
    } else {
        effective_args = args;
    }

    // Bind parameters
    var pi: i64 = 0;
    while pi < func.params.len() {
        var param: ValueIdType = func.params.get(pi);
        var pval: Value = Value::Void;
        if pi < effective_args.len() {
            pval = effective_args.get(pi);
        }
        // Phase 10B: When a Value::Str is passed to an i64 or pointer param,
        // materialize the string into memory and pass the address.
        match pval {
            Value::Str(s) => {
                var is_i64_or_ptr: bool = false;
                match param.ty {
                    IrType::I64 => {
                        is_i64_or_ptr = true;
                    }
                    IrType::U64 => {
                        is_i64_or_ptr = true;
                    }
                    IrType::Ptr(_) => {
                        is_i64_or_ptr = true;
                    }
                    _ => {
                    }
                }
                if is_i64_or_ptr {
                    var str_addr: i64 = Memory_store_cstr(&mut self.memory, s);
                    Interpreter_set_opaque(self, str_addr, Value::Str(s));
                    match param.ty {
                        IrType::Ptr(_) => {
                            pval = Value::Ptr(str_addr);
                        }
                        _ => {
                            pval = Value::Int(str_addr);
                        }
                    }
                }
            }
            // An f64 passed where a word is taken (core's Vec_push / Vec_set
            // of a Vec<f64>): its bits, as the C backend passes it
            Value::Float(pf) => {
                match param.ty {
                    IrType::I64 => {
                        pval = Value::Int(p_f64_to_bits(pf));
                    }
                    IrType::U64 => {
                        pval = Value::Int(p_f64_to_bits(pf));
                    }
                    _ => {
                    }
                }
            }
            _ => {
            }
        }
        if param.id < values.len() {
            values.set(param.id, pval);
        }
        pi = pi + 1;
    }

    // CT10: `fid run --trace <fn>` prints the call with its arguments (the
    // hidden closure environment left out), indented by call depth
    var traced: bool = trace_wanted(func.name);
    if traced {
        var targs: str = "";
        var tpi: i64 = 0;
        if has_env_param {
            tpi = 1;
        }
        var tfirst: bool = true;
        while tpi < func.params.len() {
            var tparam: ValueIdType = func.params.get(tpi);
            var tval: Value = Value::Void;
            if tparam.id < values.len() {
                tval = values.get(tparam.id);
            }
            if !tfirst {
                targs = targs + ", ";
            }
            targs = targs + Interpreter_trace_value(self, tval, tparam.ty);
            tfirst = false;
            tpi = tpi + 1;
        }
        p_eprint_str("[trace] " + interp_trace_indent(self.call_stack.len()) + func.name + "(" + targs + ")\n");
    }

    // Execute basic blocks
    var current_block: i64 = func.entry;
    var result: RunResult = RunResult::Return(Value::Void);

    while true {
        if current_block < 0 || current_block >= func.blocks.len() {
            // No valid block — return void
            result = RunResult::Return(Value::Void);
            break;
        }
        var block: BasicBlock = func.blocks.get(current_block);

        if self.verbose {
            p_eprint_str("  -> block ");
            p_eprint_str(int_to_str(current_block));
            p_eprint_str("\n");
        }

        var next_block: i64 = -1;
        var done: bool = false;
        var ii: i64 = 0;
        while ii < block.instructions.len() {
            var inst_id: i64 = block.instructions.get(ii);

            // Step limit check
            if self.max_steps > 0 {
                self.step_count = self.step_count + 1;
                if self.step_count > self.max_steps {
                    self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
                    result = RunResult::Panic("Step limit exceeded: " + int_to_str(self.step_count) + " instructions executed (limit: " + int_to_str(self.max_steps) + ")");
                    done = true;
                    break;
                }
            }

            if self.cov_on {
                var ck: str = func.name + "#" + int_to_str(inst_id);
                if HashMap_get(self.cov_seen, ck) == 0 {
                    HashMap_insert(self.cov_seen, ck, 1);
                    self.cov_fns.push(func.name);
                    self.cov_ids.push(inst_id);
                }
            }

            // Get the instruction
            var inst_opt: OptInst = IrFunction_get_inst(&func, inst_id);
            match inst_opt {
                OptInst::None => {
                }
                OptInst::Some(inst) => {
                    // 2g.60: a Load or Store through an alloca of a block
                    // that has not run (a `select` case's binding, made in
                    // the block of an earlier case): C declares every
                    // alloca at the function's start, so make it now
                    var late_ptr: i64 = interp_inst_ptr_operand(&inst);
                    if late_ptr >= 0 && late_ptr < values.len() {
                        match values.get(late_ptr) {
                            Value::Void => {
                                match IrFunction_get_inst(&func, late_ptr) {
                                    OptInst::Some(late_inst) => {
                                        match late_inst {
                                            Inst::Alloca(_, _) => {
                                                match Interpreter_execute_inst(self, late_inst, late_ptr, values, &func) {
                                                    ExecOutcome::Value(late_v) => {
                                                        values.set(late_ptr, late_v);
                                                    }
                                                    _ => {
                                                    }
                                                }
                                            }
                                            _ => {
                                            }
                                        }
                                    }
                                    OptInst::None => {
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    var outcome: ExecOutcome = Interpreter_execute_inst(self, inst, inst_id, values, &func);
                    match outcome {
                        ExecOutcome::Continue => {
                        }
                        ExecOutcome::Value(v) => {
                            if inst_id < values.len() {
                                values.set(inst_id, v);
                            }
                        }
                        ExecOutcome::Jump(target) => {
                            // On to the target block (`done` is for leaving
                            // the function: return or panic)
                            next_block = target;
                            break;
                        }
                        ExecOutcome::Return(rv) => {
                            result = RunResult::Return(rv);
                            done = true;
                            break;
                        }
                        ExecOutcome::Panic(msg) => {
                            // Capture stack trace
                            match self.panic_stack_trace {
                                OptStr::None => {
                                    self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
                                }
                                OptStr::Some(_) => {
                                }
                            }
                            // Transaction rollback
                            if self.txn_mem_snapshots.len() > 0 {
                                var snap_mem: Memory = self.txn_mem_snapshots.get(self.txn_mem_snapshots.len() - 1);
                                self.memory = snap_mem;
                                self.txn_mem_snapshots.pop();
                            }
                            if self.txn_opaque_snapshots.len() > 0 {
                                var snap_opaque: OpaqueSnapshot = self.txn_opaque_snapshots.get(self.txn_opaque_snapshots.len() - 1);
                                self.opaque_values = snap_opaque.entries;
                                self.txn_opaque_snapshots.pop();
                            }
                            // The panicking instruction's source line (as
                            // src/interp.rs), unless the message has one
                            var pmsg: str = msg;
                            if !str_contains(pmsg, " at line ") {
                                match IrFunction_get_meta(&func, inst_id) {
                                    OptValueMeta::Some(pm) => {
                                        match pm.source_line {
                                            OptU64::Some(pl) => {
                                                pmsg = pmsg + " at line " + int_to_str(pl);
                                            }
                                            OptU64::None => {
                                            }
                                        }
                                    }
                                    OptValueMeta::None => {
                                    }
                                }
                            }
                            result = RunResult::Panic(pmsg);
                            done = true;
                            break;
                        }
                    }
                }
            }
            ii = ii + 1;
        }

        if done {
            break;
        }

        if next_block >= 0 {
            current_block = next_block;
        } else {
            // No terminator found — return void
            result = RunResult::Return(Value::Void);
            break;
        }
    }  // Cleanup: restore region_stack depth
    while self.region_stack.len() > saved_region_depth {
        self.region_stack.pop();
    }
    self.current_func_name = saved_func_name;
    self.cur_wrapping = saved_wrapping;
    // CT10: the traced call's result (or its panic), at the call's depth
    if traced {
        // the call is still on call_stack: the depth its entry line had
        var tind: str = interp_trace_indent(self.call_stack.len());
        match result {
            RunResult::Return(trv) => {
                match func.ret_ty {
                    IrType::Void => {
                        p_eprint_str("[trace] " + tind + func.name + " returned\n");
                    }
                    _ => {
                        p_eprint_str("[trace] " + tind + func.name + " = " + Interpreter_trace_value(self, trv, func.ret_ty) + "\n");
                    }
                }
            }
            RunResult::Panic(tmsg) => {
                p_eprint_str("[trace] " + tind + func.name + " panicked: " + tmsg + "\n");
            }
            _ => {
            }
        }
    }
    self.call_stack.pop();
    self.call_site_lines.pop();
    // The call's allocas are dead now (C's frame goes away): free them for
    // reuse. A struct or enum result is in the caller's memory (sret), so
    // nothing returned points here.
    while self.frame_allocas.len() > frame_mark {
        var dead_slot: i64 = self.frame_allocas.pop();
        Interpreter_free_block(self, dead_slot);
    }

    return result;
}

/// CT10: two spaces per call level below main (for `--trace` lines).
fn interp_trace_indent(depth: i64) -> str {
    var s: str = "";
    var d: i64 = 1;
    while d < depth {
        s = s + "  ";
        d = d + 1;
    }
    return s;
}

/// CT10: a value as `--trace` shows it. A string (a `str` parameter or
/// result: `*u8` in the IR, or a string value) is quoted; anything else
/// is shown as print shows it.
fn Interpreter_trace_value(self: &Interpreter, v: Value, ty: IrType) -> str {
    var is_str: bool = false;
    match ty {
        IrType::Ptr(inner) => {
            match inner {
                IrType::U8 => {
                    is_str = true;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    match v {
        Value::Str(s) => {
            return "\"" + s + "\"";
        }
        Value::Int(i) => {
            // value_to_string reads the string the word points at (a side
            // table string, or one in memory), else gives the number
            if is_str && i > 0 {
                return "\"" + Interpreter_value_to_string(self, v) + "\"";
            }
            return int_to_str(i);
        }
        Value::Ptr(p) => {
            if is_str && p > 0 && Memory_is_valid_addr(&self.memory, p) {
                return "\"" + Interpreter_value_to_string(self, v) + "\"";
            }
            return Interpreter_display_value(self, v);
        }
        _ => {
            return Interpreter_display_value(self, v);
        }
    }
    return "";
}

// ===========================================================================
// get_value -- safe lookup from the value table
// ===========================================================================

/// What an 8-byte integer load at `addr` reads from the side table: a
/// pointer, string, Vec or map stored there (else None: read memory).
fn Interpreter_load_side_word(self: &Interpreter, addr: i64) -> OptValue {
    match Interpreter_lookup_opaque(self, addr) {
        OptValue::Some(ov) => {
            match ov {
                Value::Ptr(_) => {
                    return OptValue::Some(ov);
                }
                Value::Str(_) => {
                    return OptValue::Some(ov);
                }
                Value::Vec(_) => {
                    return OptValue::Some(ov);
                }
                Value::Map(_) => {
                    return OptValue::Some(ov);
                }
                _ => {
                }
            }
        }
        OptValue::None => {
        }
    }
    return OptValue::None;
}

/// The 8-byte word a raw (core) Vec stores for `v`.
pub fn Interpreter_value_word(self: &mut Interpreter, v: Value) -> i64 {
    match v {
        Value::Int(i) => {
            return i;
        }
        Value::Ptr(p) => {
            return p;
        }
        Value::Float(f) => {
            return p_f64_to_bits(f);
        }
        Value::Bool(b) => {
            if b {
                return 1;
            }
            return 0;
        }
        Value::Str(s) => {
            var sa: i64 = Memory_store_cstr(&mut self.memory, s);
            Interpreter_set_opaque(self, sa, Value::Str(s));
            return sa;
        }
        _ => {
        }
    }
    return 0;
}

pub fn get_value(values: Vec<Value>, id: i64) -> Value {
    if id >= 0 && id < values.len() {
        return values.get(id);
    }
    return Value::Void;
}

// ===========================================================================
// execute_inst -- execute a single IR instruction
// ===========================================================================

pub fn Interpreter_execute_inst(self: &mut Interpreter, inst: Inst, inst_id: i64, values: Vec<Value>, func: &IrFunction) -> ExecOutcome {
    match inst {
        // ─── Constants ───
        Inst::ConstInt(value, ty) => {
            match ty {
                IrType::Bool => {
                    return ExecOutcome::Value(Value::Bool(value != 0));
                }
                _ => {
                    return ExecOutcome::Value(Value::Int(value));
                }
            }
        }
        Inst::ConstFloat(value, ty) => {
            // value is already an f64 in Fides IR (unlike Rust which stores bits)
            match ty {
                IrType::F32 => {
                    return ExecOutcome::Value(Value::Float(value));
                }
                _ => {
                    return ExecOutcome::Value(Value::Float(value));
                }
            }
        }
        Inst::ConstBool(value) => {
            return ExecOutcome::Value(Value::Bool(value));
        }
        Inst::ConstStr(value) => {
            return ExecOutcome::Value(Value::Str(value));
        }
        Inst::ConstFnRef(name) => {
            return ExecOutcome::Value(Value::Str(name));
        }
        Inst::ConstNull(_) => {
            return ExecOutcome::Value(Value::Ptr(0));
        }

        // ─── Globals ───
        Inst::GlobalAddr(name, _) => {
            var addr: i64 = Interpreter_lookup_global_addr(self, name);
            return ExecOutcome::Value(Value::Ptr(addr));
        }

        // ─── Arithmetic ───
        Inst::BinOp(op, left, right, ty) => {
            var l: Value = get_value(values, left);
            var r: Value = get_value(values, right);
            // String comparison: when both operands are Ptr(U8) (str type),
            // compare content rather than pointer addresses.
            var is_str_cmp: bool = false;
            var left_meta_opt: OptValueMeta = IrFunction_get_meta(func, left);
            var right_meta_opt: OptValueMeta = IrFunction_get_meta(func, right);
            match left_meta_opt {
                OptValueMeta::Some(lm) => {
                    match right_meta_opt {
                        OptValueMeta::Some(rm) => {
                            match lm.ty {
                                IrType::Ptr(linner) => {
                                    match linner {
                                        IrType::U8 => {
                                            match rm.ty {
                                                IrType::Ptr(rinner) => {
                                                    match rinner {
                                                        IrType::U8 => {
                                                            is_str_cmp = true;
                                                        }
                                                        _ => {
                                                        }
                                                    }
                                                }
                                                _ => {
                                                }
                                            }
                                        }
                                        _ => {
                                        }
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                        OptValueMeta::None => {
                        }
                    }
                }
                OptValueMeta::None => {
                }
            }
            if is_str_cmp {
                match op {
                    BinOp::Eq => {
                        var l_str: str = Interpreter_value_to_string(self, l);
                        var r_str: str = Interpreter_value_to_string(self, r);
                        return ExecOutcome::Value(Value::Bool(l_str == r_str));
                    }
                    BinOp::Neq => {
                        var l_str2: str = Interpreter_value_to_string(self, l);
                        var r_str2: str = Interpreter_value_to_string(self, r);
                        return ExecOutcome::Value(Value::Bool(l_str2 != r_str2));
                    }
                    _ => {
                    }
                }
            }
            // Integer arithmetic on a string is arithmetic on its address
            // (core's `(s & 7)`, `s - 16`): the string goes to memory first,
            // as when it is passed to an i64 parameter (string == and != have
            // returned above; ordering compares stay on the text)
            var addr_op: bool = false;
            match op {
                BinOp::Add => {
                    addr_op = true;
                }
                BinOp::Sub => {
                    addr_op = true;
                }
                BinOp::Mul => {
                    addr_op = true;
                }
                BinOp::Div => {
                    addr_op = true;
                }
                BinOp::Mod => {
                    addr_op = true;
                }
                BinOp::BitAnd => {
                    addr_op = true;
                }
                BinOp::BitOr => {
                    addr_op = true;
                }
                BinOp::BitXor => {
                    addr_op = true;
                }
                BinOp::Shl => {
                    addr_op = true;
                }
                BinOp::Shr => {
                    addr_op = true;
                }
                _ => {
                }
            }
            if addr_op {
                match l {
                    Value::Str(_) => {
                        l = Value::Int(Interpreter_value_word(self, l));
                    }
                    Value::Ptr(lp) => {
                        l = Value::Int(lp);
                    }
                    _ => {
                    }
                }
                match r {
                    Value::Str(_) => {
                        r = Value::Int(Interpreter_value_word(self, r));
                    }
                    Value::Ptr(rp) => {
                        r = Value::Int(rp);
                    }
                    _ => {
                    }
                }
            }
            var result: Value = Interpreter_eval_typed(self, op, l, r, ty, meta_is_u64(left_meta_opt) || meta_is_u64(right_meta_opt));
            if value_is_void(result) {
                var msg: str = "Arithmetic error";
                match op {
                    BinOp::Add => {
                        msg = "Integer overflow on addition: " + int_or_q(l) + " + " + int_or_q(r);
                    }
                    BinOp::Sub => {
                        msg = "Integer overflow on subtraction: " + int_or_q(l) + " - " + int_or_q(r);
                    }
                    BinOp::Mul => {
                        msg = "Integer overflow on multiplication: " + int_or_q(l) + " * " + int_or_q(r);
                    }
                    BinOp::Div => {
                        msg = "Division by zero";
                        if int_or_q(r) != "0" {
                            msg = "Integer overflow on division";
                        }
                    }
                    BinOp::Mod => {
                        msg = "Modulo by zero";
                    }
                    _ => {
                        msg = "Arithmetic error (" + interp_value_kind(l) + ", " + interp_value_kind(r) + ")";
                    }
                }
                return ExecOutcome::Panic(msg);
            }
            return ExecOutcome::Value(result);
        }

        Inst::UnaryOp(op, operand, _) => {
            var v: Value = get_value(values, operand);
            var result: Value = Interpreter_eval_unaryop(self, op, v);
            return ExecOutcome::Value(result);
        }

        // ─── Memory ───
        Inst::Alloca(ty, _) => {
            var size: i64 = IrModule_type_size(&self.module, ty);
            if size < 1 {
                size = 1;
            }
            // Run again in the same call (a `var` in a loop body): the same
            // slot, zeroed, as C has one alloca per function and a memset
            // where the alloca is (stdlib-agent-bugs 20: each pass of a loop
            // took new memory, never freed)
            match get_value(values, inst_id) {
                Value::Ptr(again) => {
                    var asz: i64 = Memory_block_size(&self.memory, again);
                    if asz > 0 {
                        Interpreter_clear_block_side(self, again, asz);
                        var azi: i64 = 0;
                        while azi < asz {
                            self.memory.data.set(again + azi, 0);
                            azi = azi + 1;
                        }
                        match ty {
                            IrType::Array(_, again_n) => {
                                Interpreter_set_array_bound(self, again, again_n);
                            }
                            _ => {
                            }
                        }
                        return ExecOutcome::Value(Value::Ptr(again));
                    }
                }
                _ => {
                }
            }
            // Memory limit check
            if self.max_memory > 0 {
                var current: i64 = Memory_allocated(&self.memory);
                if current + size > self.max_memory {
                    self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
                    return ExecOutcome::Panic("Memory limit exceeded");
                }
            }
            var addr: i64 = Memory_alloc(&mut self.memory, size);
            if addr == 0 {
                self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
                return ExecOutcome::Panic("Out of memory: the interpreter holds at most " + int_to_str(INTERP_MEM_LIMIT) + " bytes");
            }
            // freed when this call returns (Interpreter_run_function)
            self.frame_allocas.push(addr);
            // Track array bounds
            match ty {
                IrType::Array(_, arr_size) => {
                    Interpreter_set_array_bound(self, addr, arr_size);
                }
                _ => {
                }
            }
            return ExecOutcome::Value(Value::Ptr(addr));
        }

        Inst::Load(ptr, ty) => {
            var addr: i64 = 0;
            match get_value(values, ptr) {
                Value::Ptr(a) => {
                    addr = a;
                }
                Value::Int(i) => {
                    addr = i;
                }
                Value::Str(s) => {
                    addr = Memory_store_cstr(&mut self.memory, s);
                }
                _ => {
                    addr = 0;
                }
            }
            if addr == 0 {
                return ExecOutcome::Panic("Invalid memory access (null or dangling pointer)");
            }
            // Load from byte memory based on type. Only a word-sized load can
            // read a value the side table holds (a Vec, map or string stored
            // there): a byte load at a string's address reads its first byte.
            // (As in src/interp.rs.)
            match ty {
                IrType::I8 => {
                    var b: i64 = Memory_load_byte(&self.memory, addr);
                    // Sign-extend from 8 bits
                    if b >= 128 {
                        b = b - 256;
                    }
                    return ExecOutcome::Value(Value::Int(b));
                }
                IrType::U8 => {
                    return ExecOutcome::Value(Value::Int(Memory_load_byte(&self.memory, addr)));
                }
                IrType::I16 => {
                    var lo: i64 = Memory_load_byte(&self.memory, addr);
                    var hi: i64 = Memory_load_byte(&self.memory, addr + 1);
                    var v: i64 = lo | (hi << 8);
                    if v >= 32768 {
                        v = v - 65536;
                    }
                    return ExecOutcome::Value(Value::Int(v));
                }
                IrType::U16 => {
                    var lo: i64 = Memory_load_byte(&self.memory, addr);
                    var hi: i64 = Memory_load_byte(&self.memory, addr + 1);
                    return ExecOutcome::Value(Value::Int(lo | (hi << 8)));
                }
                IrType::I32 => {
                    return ExecOutcome::Value(Value::Int(Memory_load_i32(&self.memory, addr)));
                }
                IrType::U32 => {
                    return ExecOutcome::Value(Value::Int(Memory_load_i32(&self.memory, addr) & 0xFFFFFFFF));
                }
                IrType::I64 => {
                    match Interpreter_load_side_word(self, addr) {
                        OptValue::Some(sv) => {
                            return ExecOutcome::Value(sv);
                        }
                        OptValue::None => {
                        }
                    }
                    return ExecOutcome::Value(Value::Int(Memory_load_i64(&self.memory, addr)));
                }
                IrType::U64 => {
                    match Interpreter_load_side_word(self, addr) {
                        OptValue::Some(sv) => {
                            return ExecOutcome::Value(sv);
                        }
                        OptValue::None => {
                        }
                    }
                    return ExecOutcome::Value(Value::Int(Memory_load_i64(&self.memory, addr)));
                }
                IrType::F32 => {
                    return ExecOutcome::Value(Value::Float(Memory_load_f32(&self.memory, addr)));
                }
                IrType::F64 => {
                    return ExecOutcome::Value(Value::Float(Memory_load_f64(&self.memory, addr)));
                }
                IrType::Bool => {
                    return ExecOutcome::Value(Value::Bool(Memory_load_bool(&self.memory, addr)));
                }
                IrType::Ptr(_) => {
                    // A stored string (str fields have IR type Ptr(U8)) or pointer
                    match Interpreter_lookup_opaque(self, addr) {
                        OptValue::Some(pv) => {
                            match pv {
                                Value::Str(_) => {
                                    return ExecOutcome::Value(pv);
                                }
                                Value::Ptr(_) => {
                                    return ExecOutcome::Value(pv);
                                }
                                _ => {
                                }
                            }
                        }
                        OptValue::None => {
                        }
                    }
                    return ExecOutcome::Value(Value::Ptr(Memory_load_i64(&self.memory, addr)));
                }
                IrType::Opaque(_) => {
                    // Check side-table for opaque types
                    match Interpreter_lookup_opaque(self, addr) {
                        OptValue::Some(ov2) => {
                            return ExecOutcome::Value(ov2);
                        }
                        OptValue::None => {
                            return ExecOutcome::Value(Value::Ptr(Memory_load_i64(&self.memory, addr)));
                        }
                    }
                }
                IrType::Generic(_, _) => {
                    // Check side-table again for generic types
                    match Interpreter_lookup_opaque(self, addr) {
                        OptValue::Some(ov3) => {
                            return ExecOutcome::Value(ov3);
                        }
                        OptValue::None => {
                            return ExecOutcome::Value(Value::Ptr(Memory_load_i64(&self.memory, addr)));
                        }
                    }
                }
                IrType::Array(_, _) => {
                    // CI5: an array value is its address, one word wherever
                    // it is kept (a `[T; N]` struct field, a local's slot), as
                    // the C, native and wasm backends load it. The address
                    // of the word read `g.cells[2]` past it (0, and the
                    // address as element 0: test_wasm_array_index).
                    return ExecOutcome::Value(Value::Ptr(Memory_load_i64(&self.memory, addr)));
                }
                _ => {
                    return ExecOutcome::Value(Value::Ptr(addr));
                }
            }
        }

        Inst::Store(ptr, value, sty_opt) => {
            var addr: i64 = 0;
            match get_value(values, ptr) {
                Value::Ptr(a) => {
                    addr = a;
                    if a == 0 {
                        return ExecOutcome::Panic("Invalid memory access (null or dangling pointer)");
                    }
                }
                Value::Int(ni) => {
                    // a store through a null pointer (`*p = 42` with p = 0)
                    // faults as in C and native builds
                    if ni == 0 {
                        return ExecOutcome::Panic("Invalid memory access (null or dangling pointer)");
                    }
                    addr = 0;
                }
                _ => {
                    addr = 0;
                }
            }
            var v: Value = get_value(values, value);
            // An explicit Struct store type is an inline struct copy (an enum
            // payload, a by-value struct): copy the bytes from the source.
            match sty_opt {
                OptIrType::Some(est) => {
                    match est {
                        IrType::Struct(_) => {
                            var esize: i64 = IrModule_type_size(&self.module, est);
                            var src: i64 = -1;
                            match v {
                                Value::Ptr(sa) => {
                                    src = sa;
                                }
                                Value::Int(si) => {
                                    if si > 0 && Memory_is_valid_addr(&self.memory, si) {
                                        src = si;
                                    }
                                }
                                _ => {
                                }
                            }
                            if src >= 0 {
                                Memory_copy(&mut self.memory, addr, src, esize);
                                return ExecOutcome::Continue;
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptIrType::None => {
                }
            }
            // Pointer / value types (src/interp.rs Store)
            var has_ptr_ty: bool = false;
            var ptr_ty: IrType = IrType::Void;
            match IrFunction_get_meta(func, ptr) {
                OptValueMeta::Some(pm) => {
                    ptr_ty = pm.ty;
                    has_ptr_ty = true;
                }
                OptValueMeta::None => {
                }
            }
            var has_val_ty: bool = false;
            var val_ty: IrType = IrType::I64;
            match IrFunction_get_meta(func, value) {
                OptValueMeta::Some(vm) => {
                    val_ty = vm.ty;
                    has_val_ty = true;
                }
                OptValueMeta::None => {
                }
            }
            var is_opaque: bool = false;
            var is_deref_store: bool = false;
            var has_pointee: bool = false;
            var pointee_ty: IrType = IrType::Void;
            if has_ptr_ty {
                match ptr_ty {
                    IrType::Opaque(_) => {
                        is_opaque = true;
                    }
                    IrType::Generic(_, _) => {
                        is_opaque = true;
                    }
                    IrType::Ptr(inner) => {
                        pointee_ty = box_ir_type_unbox(inner);
                        has_pointee = true;
                        is_deref_store = true;
                        match inner {
                            IrType::Opaque(_) => {
                                is_opaque = true;
                            }
                            IrType::Generic(_, _) => {
                                is_opaque = true;
                            }
                            IrType::I64 => {
                                is_deref_store = false;
                            }
                            IrType::U64 => {
                                is_deref_store = false;
                            }
                            IrType::Ptr(_) => {
                                is_deref_store = false;
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            var sty: IrType = IrType::I64;
            if has_val_ty {
                sty = val_ty;
            }
            if is_deref_store && has_pointee {
                sty = pointee_ty;
            }
            if is_opaque {
                // Opaque-typed slots always use the side table (and byte
                // memory for primitives, as a fallback)
                Interpreter_set_opaque(self, addr, v);
                match v {
                    Value::Int(oi) => {
                        Memory_store_i64(&mut self.memory, addr, oi);
                    }
                    Value::Float(of) => {
                        Memory_store_f64(&mut self.memory, addr, of);
                    }
                    Value::Bool(ob) => {
                        Memory_store_bool(&mut self.memory, addr, ob);
                    }
                    Value::Ptr(op) => {
                        Memory_store_i64(&mut self.memory, addr, op);
                    }
                    Value::Str(os) => {
                        var osa: i64 = Memory_store_cstr(&mut self.memory, os);
                        Memory_store_i64(&mut self.memory, addr, osa);
                    }
                    _ => {
                    }
                }
                return ExecOutcome::Continue;
            }
            // Clear any stale opaque entry
            Interpreter_remove_opaque(self, addr);
            // Struct store: copy the struct bytes from the source pointer
            match sty {
                IrType::Struct(_) => {
                    match v {
                        Value::Ptr(src_addr) => {
                            var ssize: i64 = IrModule_type_size(&self.module, sty);
                            Memory_copy(&mut self.memory, addr, src_addr, ssize);
                            return ExecOutcome::Continue;
                        }
                        // 2g.60: an address held as an Int (p_vec_get of a
                        // Vec of structs or enums held in the buffer, the
                        // element of a `for` loop) is copied too, as C does
                        Value::Int(src_int) => {
                            if src_int > 0 && interp_ty_is_ptr(has_val_ty, val_ty) && Memory_is_valid_addr(&self.memory, src_int) {
                                var src_size: i64 = IrModule_type_size(&self.module, sty);
                                Memory_copy(&mut self.memory, addr, src_int, src_size);
                                return ExecOutcome::Continue;
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            match v {
                Value::Int(iv) => {
                    match sty {
                        IrType::I8 => {
                            Memory_store_byte(&mut self.memory, addr, iv & 0xFF);
                        }
                        IrType::U8 => {
                            Memory_store_byte(&mut self.memory, addr, iv & 0xFF);
                        }
                        IrType::I16 => {
                            Memory_store_i16(&mut self.memory, addr, iv);
                        }
                        IrType::U16 => {
                            Memory_store_i16(&mut self.memory, addr, iv);
                        }
                        IrType::I32 => {
                            Memory_store_i32(&mut self.memory, addr, iv);
                        }
                        IrType::U32 => {
                            Memory_store_i32(&mut self.memory, addr, iv);
                        }
                        _ => {
                            Memory_store_i64(&mut self.memory, addr, iv);
                        }
                    }
                }
                Value::Float(fv) => {
                    match sty {
                        IrType::F32 => {
                            Memory_store_f32(&mut self.memory, addr, fv);
                        }
                        _ => {
                            Memory_store_f64(&mut self.memory, addr, fv);
                        }
                    }
                }
                Value::Bool(bv) => {
                    Memory_store_bool(&mut self.memory, addr, bv);
                }
                Value::Ptr(pv) => {
                    Memory_store_i64(&mut self.memory, addr, pv);
                    if I64Table_find(&self.tensor_index, pv) >= 0 {
                        Interpreter_set_opaque(self, addr, v);
                    }
                }
                Value::Str(s) => {
                    var str_addr: i64 = Memory_store_cstr(&mut self.memory, s);
                    Memory_store_i64(&mut self.memory, addr, str_addr);
                    Interpreter_set_opaque(self, addr, Value::Str(s));
                }
                Value::Vec(_) => {
                    Interpreter_set_opaque(self, addr, v);
                }
                Value::Map(_) => {
                    Interpreter_set_opaque(self, addr, v);
                }
                _ => {
                }
            }
            return ExecOutcome::Continue;
        }

        Inst::GetFieldPtr(struct_ptr, field_index, _) => {
            var base: i64 = 0;
            match get_value(values, struct_ptr) {
                Value::Ptr(a) => {
                    base = a;
                }
                Value::Int(n) => {
                    base = n;
                }
                _ => {
                    base = 0;
                }
            }
            // Look up real field offset from struct layout
            var struct_name: str = "";
            var meta_opt: OptValueMeta = IrFunction_get_meta(func, struct_ptr);
            match meta_opt {
                OptValueMeta::Some(m) => {
                    match m.ty {
                        IrType::Ptr(inner) => {
                            match inner {
                                IrType::Struct(name) => {
                                    struct_name = name;
                                }
                                _ => {
                                }
                            }
                        }
                        IrType::Struct(name) => {
                            struct_name = name;
                        }
                        _ => {
                        }
                    }
                }
                OptValueMeta::None => {
                }
            }
            var offset: i64 = field_index * 8;
            if str_len(struct_name) > 0 {
                match IrModule_get_struct(&self.module, struct_name) {
                    OptStructLayout::Some(layout) => {
                        if field_index >= 0 && field_index < layout.fields.len() {
                            var field: StringIrTypeOffset = layout.fields.get(field_index);
                            offset = field.offset;
                        }
                    }
                    OptStructLayout::None => {
                    }
                }
            }
            return ExecOutcome::Value(Value::Ptr(base + offset));
        }

        Inst::GetElemPtr(base_ptr, index, elem_ty) => {
            var base: i64 = 0;
            match get_value(values, base_ptr) {
                Value::Ptr(a) => {
                    base = a;
                }
                Value::Int(n) => {
                    base = n;
                }
                _ => {
                    base = 0;
                }
            }
            var idx_val: i64 = 0;
            match get_value(values, index) {
                Value::Int(i) => {
                    idx_val = i;
                }
                _ => {
                    idx_val = 0;
                }
            }
            // Bounds checking (when not in unsafe block)
            if self.interp_unsafe_depth == 0 {
                if idx_val < 0 {
                    return ExecOutcome::Panic("Array index out of bounds: negative index " + int_to_str(idx_val));
                }
                var arr_size: i64 = Interpreter_lookup_array_bound(self, base);
                if arr_size >= 0 && idx_val >= arr_size {
                    return ExecOutcome::Panic("Array index out of bounds: index " + int_to_str(idx_val) + " but array has " + int_to_str(arr_size) + " elements");
                }
            }
            var elem_size: i64 = IrModule_type_size(&self.module, elem_ty);
            if elem_size < 1 {
                elem_size = 1;
            }
            return ExecOutcome::Value(Value::Ptr(base + idx_val * elem_size));
        }

        // ─── Control Flow ───
        Inst::Jump(target) => {
            return ExecOutcome::Jump(target);
        }
        Inst::Branch(cond, then_block, else_block) => {
            var c: bool = false;
            match get_value(values, cond) {
                Value::Bool(b) => {
                    c = b;
                }
                Value::Int(i) => {
                    c = (i != 0);
                }
                _ => {
                    c = false;
                }
            }
            if self.cov_on {
                var bk: str = func.name + "#" + int_to_str(inst_id) + "#F";
                if c {
                    bk = func.name + "#" + int_to_str(inst_id) + "#T";
                }
                if HashMap_get(self.cov_br_seen, bk) == 0 {
                    HashMap_insert(self.cov_br_seen, bk, 1);
                }
            }
            if c {
                return ExecOutcome::Jump(then_block);
            } else {
                return ExecOutcome::Jump(else_block);
            }
        }
        Inst::Switch(sv, sw_keys, sw_targets, sw_dflt) => {
            // ME28: the target of the key equal to the value, else the default
            var sw_x: i64 = 0;
            match get_value(values, sv) {
                Value::Int(i) => {
                    sw_x = i;
                }
                Value::Bool(b) => {
                    if b {
                        sw_x = 1;
                    }
                }
                _ => {
                }
            }
            var swi: i64 = 0;
            while swi < sw_keys.len() && swi < sw_targets.len() {
                if sw_keys.get(swi) == sw_x {
                    return ExecOutcome::Jump(sw_targets.get(swi));
                }
                swi = swi + 1;
            }
            return ExecOutcome::Jump(sw_dflt);
        }
        Inst::Return(opt_val) => {
            match opt_val {
                OptValueId::Some(id) => {
                    return ExecOutcome::Return(get_value(values, id));
                }
                OptValueId::None => {
                    return ExecOutcome::Return(Value::Void);
                }
            }
        }
        Inst::Unreachable => {
            return ExecOutcome::Panic("Reached unreachable instruction");
        }

        // ─── Function Calls ───
        Inst::Call(name, arg_ids, call_ret_ty, _) => {
            var arg_vals: Vec<Value> = Vec::new();
            var ai: i64 = 0;
            while ai < arg_ids.len() {
                arg_vals.push(get_value(values, arg_ids.get(ai)));
                ai = ai + 1;
            }
            // Run-time capability revocation (p_cap_revoke, p_sandbox_*)
            if interp_is_cap_builtin(name) {
                return Interpreter_cap_builtin(self, name, arg_vals);
            }
            // Check if it's a runtime function
            if Interpreter_is_runtime_func(self, name) {
                if name == "p_vec_get" || name == "p_vec_pop" {
                    // A raw Vec element is the stored 8-byte word
                    var vout: ExecOutcome = Interpreter_call_runtime(self, name, &mut arg_vals);
                    match vout {
                        ExecOutcome::Value(rv) => {
                            return ExecOutcome::Value(interp_reinterpret_word(rv, call_ret_ty));
                        }
                        _ => {
                        }
                    }
                    return vout;
                }
                return Interpreter_call_runtime(self, name, &mut arg_vals);
            }
            // A string the interpreter holds (Value::Str) is not in its
            // memory, and core's Str_drop leaves a string without a count
            // alone: running it copied the string into memory first, a block
            // never freed, on every drop (stdlib-agent-bugs 20)
            if name == "Str_drop" && arg_vals.len() == 2 {
                match arg_vals.get(1) {
                    Value::Str(_) => {
                        return ExecOutcome::Value(Value::Void);
                    }
                    _ => {
                    }
                }
            }
            // core's p_zero_words (env, p, n): the lowering calls it in the
            // entry block of every function with an owning struct local
            // (proposal 0004); run as Fides it is a loop of about ten
            // interpreted instructions a word on every such call. Done here
            // at once: n words of zeros at p (no side-table value stays at
            // a word that is now 0)
            if name == "p_zero_words" && arg_vals.len() == 3 {
                var zw_p: i64 = 0;
                match arg_vals.get(1) {
                    Value::Ptr(zp) => {
                        zw_p = zp;
                    }
                    Value::Int(zp) => {
                        zw_p = zp;
                    }
                    _ => {
                    }
                }
                var zw_n: i64 = -1;
                match arg_vals.get(2) {
                    Value::Int(zn) => {
                        zw_n = zn;
                    }
                    _ => {
                    }
                }
                if zw_p > 0 && zw_n >= 0 && Memory_is_valid_addr(&self.memory, zw_p + zw_n * 8 - 1) {
                    var zwi: i64 = 0;
                    while zwi < zw_n * 8 {
                        self.memory.data.set(zw_p + zwi, 0);
                        zwi = zwi + 1;
                    }
                    if self.opaque_values.live > 0 {
                        var zwk: i64 = 0;
                        while zwk < zw_n {
                            I64Table_remove(&mut self.opaque_values, zw_p + zwk * 8);
                            zwk = zwk + 1;
                        }
                    }
                    return ExecOutcome::Value(Value::Void);
                }
            }
            // stdlib-agent-bugs 12: core's vec_elem_dup / vec_elem_drop
            // (env, tid, e) of a plain element (tid 0) or a null one do
            // nothing but return `e`: answered here, not by a call per
            // element (Vec::filled, Vec.set)
            if (name == "vec_elem_dup" || name == "vec_elem_drop") && arg_vals.len() == 3 {
                var plain_tid: bool = false;
                match arg_vals.get(1) {
                    Value::Int(etid) => {
                        plain_tid = etid == 0;
                    }
                    _ => {
                    }
                }
                var plain_e: bool = false;
                var null_e: bool = false;
                match arg_vals.get(2) {
                    Value::Int(ev) => {
                        plain_e = true;
                        null_e = ev == 0;
                    }
                    _ => {
                    }
                }
                if name == "vec_elem_drop" && (plain_tid || null_e) {
                    return ExecOutcome::Value(Value::Void);
                }
                if name == "vec_elem_dup" && plain_e && (plain_tid || null_e) {
                    return ExecOutcome::Value(arg_vals.get(2));
                }
            }
            // Check if it's a user function
            match Interpreter_get_function(self, name) {
                OptIrFunction::Some(callee) => {
                    // Record call site
                    var meta_opt2: OptValueMeta = IrFunction_get_meta(func, inst_id);
                    match meta_opt2 {
                        OptValueMeta::Some(m2) => {
                            match m2.source_line {
                                OptU64::Some(sl) => {
                                    self.pending_call_site = OptU64::Some(sl);
                                }
                                OptU64::None => {
                                    self.pending_call_site = OptU64::None;
                                }
                            }
                        }
                        OptValueMeta::None => {
                            self.pending_call_site = OptU64::None;
                        }
                    }
                    var result: RunResult = Interpreter_run_function(self, callee, arg_vals);
                    match result {
                        RunResult::Return(v) => {
                            return ExecOutcome::Value(interp_reinterpret_word(v, call_ret_ty));
                        }
                        RunResult::Panic(msg) => {
                            return ExecOutcome::Panic(msg);
                        }
                        RunResult::Paused => {
                            return ExecOutcome::Continue;
                        }
                    }
                }
                OptIrFunction::None => {
                    return ExecOutcome::Panic("Unknown function '" + name + "'");
                }
            }
        }

        Inst::CallPtr(fn_ptr, arg_ids, cp_ret, _, _) => {
            var arg_vals2: Vec<Value> = Vec::new();
            var ai2: i64 = 0;
            while ai2 < arg_ids.len() {
                arg_vals2.push(get_value(values, arg_ids.get(ai2)));
                ai2 = ai2 + 1;
            }
            // Function pointer is an env struct: field 0 = fn name string
            var fn_name: str = "";
            var env_ptr: i64 = 0;
            var faddr: i64 = -1;
            match get_value(values, fn_ptr) {
                Value::Str(s) => {
                    fn_name = s;
                }
                Value::Ptr(addr) => {
                    faddr = addr;
                }
                // A function value kept as a word (a Vec<fn(..)> element):
                // the same env address (stdlib-agent-bugs 31, 38, 47)
                Value::Int(iaddr) => {
                    faddr = iaddr;
                }
                _ => {
                    return ExecOutcome::Panic("CallPtr: function pointer is not a string or pointer");
                }
            }
            if faddr == 0 {
                return ExecOutcome::Panic("CallPtr: null function value");
            }
            if faddr > 0 {
                // Read fn name pointer from field 0
                var fn_ptr_addr: i64 = Memory_load_i64(&self.memory, faddr);
                match Interpreter_lookup_opaque(self, fn_ptr_addr) {
                    OptValue::Some(nv) => {
                        match nv {
                            Value::Str(ns) => {
                                fn_name = ns;
                            }
                            _ => {
                            }
                        }
                    }
                    OptValue::None => {
                    }
                }
                if fn_name == "" {
                    fn_name = Memory_load_cstr(&self.memory, fn_ptr_addr);
                }
                env_ptr = faddr;
                // or the function's name itself, kept as a word
                var named: bool = false;
                match Interpreter_get_function(self, fn_name) {
                    OptIrFunction::Some(_) => {
                        named = true;
                    }
                    OptIrFunction::None => {
                    }
                }
                if !named && !Interpreter_is_runtime_func(self, fn_name) {
                    match Interpreter_lookup_opaque(self, faddr) {
                        OptValue::Some(dv) => {
                            match dv {
                                Value::Str(ds) => {
                                    fn_name = ds;
                                    env_ptr = 0;
                                }
                                _ => {
                                }
                            }
                        }
                        OptValue::None => {
                        }
                    }
                }
            } else if fn_name == "" {
                return ExecOutcome::Panic("CallPtr: function pointer is not a string or pointer");
            }
            // A C function's address made a function value (`addr as
            // fn(..)`): only a C build can call machine code
            if fn_name == "__fid_c_fnptr" {
                return ExecOutcome::Panic("a C function pointer (`as fn(..)`) can only be called in a C build (fid ccompile)");
            }
            if Interpreter_is_runtime_func(self, fn_name) {
                return Interpreter_call_runtime(self, fn_name, &mut arg_vals2);
            }
            // A struct or enum result (lowering: args[0] is where the
            // callee writes it): the callee takes that pointer first, then
            // the env, as a direct call (stdlib-agent-bugs 2, 14, 22, 46)
            var sret_call: bool = false;
            match cp_ret {
                IrType::Struct(_) => {
                    sret_call = arg_vals2.len() > 0;
                }
                _ => {
                }
            }
            match Interpreter_get_function(self, fn_name) {
                OptIrFunction::Some(callee2) => {
                    var all_args: Vec<Value> = Vec::new();
                    var xi: i64 = 0;
                    if sret_call {
                        all_args.push(arg_vals2.get(0));
                        xi = 1;
                    }
                    if callee2.params.len() > arg_vals2.len() {
                        if env_ptr > 0 {
                            all_args.push(Value::Ptr(env_ptr));
                        } else {
                            all_args.push(Value::Int(0));
                        }
                    }
                    while xi < arg_vals2.len() {
                        all_args.push(arg_vals2.get(xi));
                        xi = xi + 1;
                    }
                    var result2: RunResult = Interpreter_run_function(self, callee2, all_args);
                    match result2 {
                        RunResult::Return(v2) => {
                            // as a direct call: a word read as the result's type
                            return ExecOutcome::Value(interp_reinterpret_word(v2, cp_ret));
                        }
                        RunResult::Panic(msg2) => {
                            return ExecOutcome::Panic(msg2);
                        }
                        RunResult::Paused => {
                            return ExecOutcome::Continue;
                        }
                    }
                }
                OptIrFunction::None => {
                    return ExecOutcome::Panic("Unknown function in CallPtr: '" + fn_name + "'");
                }
            }
        }

        Inst::MakeDyn(value, type_name, _) => {
            var data_ptr: i64 = 0;
            match get_value(values, value) {
                Value::Ptr(p) => {
                    data_ptr = p;
                }
                Value::Int(i) => {
                    data_ptr = i;
                }
                _ => {
                    data_ptr = 0;
                }
            }
            // Rust's Value::Dyn(type, data_ptr): the data pointer, with its
            // concrete type in the dyn side table
            I64Table_set(&mut self.dyn_types, data_ptr, Value::Str(type_name));
            return ExecOutcome::Value(Value::Ptr(data_ptr));
        }

        Inst::DynCall(trait_name, method, arg_ids, _, _) => {
            var arg_vals3: Vec<Value> = Vec::new();
            var ai3: i64 = 0;
            while ai3 < arg_ids.len() {
                arg_vals3.push(get_value(values, arg_ids.get(ai3)));
                ai3 = ai3 + 1;
            }
            // First arg is the receiver (Dyn or Str with type name)
            var type_name: str = "";
            var all_args3: Vec<Value> = Vec::new();
            var recv_ok: bool = false;
            if arg_vals3.len() > 0 {
                var recv_ptr: i64 = -1;
                match arg_vals3.get(0) {
                    Value::Str(s) => {
                        type_name = s;
                        recv_ok = true;
                    }
                    Value::Ptr(rp) => {
                        recv_ptr = rp;
                    }
                    Value::Int(ri) => {
                        recv_ptr = ri;
                    }
                    _ => {
                    }
                }
                if recv_ptr >= 0 {
                    match I64Table_get(&self.dyn_types, recv_ptr) {
                        OptValue::Some(tv) => {
                            match tv {
                                Value::Str(tn) => {
                                    type_name = tn;
                                    recv_ok = true;
                                    arg_vals3.set(0, Value::Ptr(recv_ptr));
                                }
                                _ => {
                                }
                            }
                        }
                        OptValue::None => {
                        }
                    }
                }
            }
            if !recv_ok {
                return ExecOutcome::Panic("DynCall: receiver is not a trait object (" + trait_name + "::" + method + ")");
            }
            var mangled: str = type_name + "_" + method;
            match Interpreter_get_function(self, mangled) {
                OptIrFunction::Some(callee3) => {
                    if callee3.params.len() > arg_vals3.len() {
                        all_args3.push(Value::Int(0));
                    }
                    var zi: i64 = 0;
                    while zi < arg_vals3.len() {
                        all_args3.push(arg_vals3.get(zi));
                        zi = zi + 1;
                    }
                    var result3: RunResult = Interpreter_run_function(self, callee3, all_args3);
                    match result3 {
                        RunResult::Return(v3) => {
                            return ExecOutcome::Value(v3);
                        }
                        RunResult::Panic(msg3) => {
                            return ExecOutcome::Panic(msg3);
                        }
                        RunResult::Paused => {
                            return ExecOutcome::Continue;
                        }
                    }
                }
                OptIrFunction::None => {
                    return ExecOutcome::Panic("DynCall: no method '" + method + "' on type '" + type_name + "' (looked for '" + mangled + "')");
                }
            }
        }

        // ─── Conversions ───
        Inst::BitCast(value, _, to) => {
            var v: Value = get_value(values, value);
            return ExecOutcome::Value(Interpreter_cast_value(self, v, to));
        }
        Inst::IntExtend(value, _, _) => {
            var v: Value = get_value(values, value);
            match v {
                Value::Int(i) => {
                    return ExecOutcome::Value(Value::Int(i));
                }
                _ => {
                    return ExecOutcome::Value(Value::Int(0));
                }
            }
        }
        Inst::IntTrunc(value, _, to) => {
            var v: Value = get_value(values, value);
            match v {
                Value::Int(i) => {
                    match to {
                        IrType::I8 => {
                            var t: i64 = i & 0xFF;
                            if t >= 128 {
                                t = t - 256;
                            }
                            return ExecOutcome::Value(Value::Int(t));
                        }
                        IrType::I16 => {
                            var t2: i64 = i & 0xFFFF;
                            if t2 >= 32768 {
                                t2 = t2 - 65536;
                            }
                            return ExecOutcome::Value(Value::Int(t2));
                        }
                        IrType::I32 => {
                            var t3: i64 = i & 0xFFFFFFFF;
                            if t3 >= 0x80000000 {
                                t3 = t3 - 0x100000000;
                            }
                            return ExecOutcome::Value(Value::Int(t3));
                        }
                        IrType::U8 => {
                            return ExecOutcome::Value(Value::Int(i & 0xFF));
                        }
                        IrType::U16 => {
                            return ExecOutcome::Value(Value::Int(i & 0xFFFF));
                        }
                        IrType::U32 => {
                            return ExecOutcome::Value(Value::Int(i & 0xFFFFFFFF));
                        }
                        _ => {
                            return ExecOutcome::Value(Value::Int(i));
                        }
                    }
                }
                _ => {
                    return ExecOutcome::Value(Value::Int(0));
                }
            }
        }
        Inst::IntToFloat(value, _, _) => {
            var v: Value = get_value(values, value);
            match v {
                Value::Int(i) => {
                    var f: f64 = (i as f64);
                    return ExecOutcome::Value(Value::Float(f));
                }
                _ => {
                    return ExecOutcome::Value(Value::Float(0.0));
                }
            }
        }
        Inst::FloatToInt(value, _, _) => {
            var v: Value = get_value(values, value);
            match v {
                Value::Float(f) => {
                    var i: i64 = (f as i64);
                    return ExecOutcome::Value(Value::Int(i));
                }
                _ => {
                    return ExecOutcome::Value(Value::Int(0));
                }
            }
        }

        // ─── Fides-Specific ───
        Inst::TryUnwrap(value, ok_block, _, _) => {
            return ExecOutcome::Jump(ok_block);
        }
        Inst::Print(value, ty) => {
            if self.revoked_caps.len() > 0 && Interpreter_cap_is_revoked(self, "IO") {
                return interp_sandbox_panic("println", "IO");
            }
            var v: Value = get_value(values, value);
            var is_int_or_ptr: bool = false;
            var raw: i64 = 0;
            match v {
                Value::Int(ri) => {
                    is_int_or_ptr = true;
                    raw = ri;
                }
                Value::Ptr(rp) => {
                    is_int_or_ptr = true;
                    raw = rp;
                }
                _ => {
                }
            }
            // Vec / HashMap values are raw pointers: format with the Fides
            // Vec_to_str / HashMap_to_str (src/interp.rs Print)
            if is_int_or_ptr && ir_type_is_opaque_named(ty, "Vec") {
                match Interpreter_print_via(self, "Vec_to_str", v) {
                    ExecOutcome::Continue => {
                        return ExecOutcome::Continue;
                    }
                    ExecOutcome::Panic(pm) => {
                        return ExecOutcome::Panic(pm);
                    }
                    _ => {
                    }
                }
            }
            if is_int_or_ptr && ir_type_is_opaque_named(ty, "HashMap") {
                match Interpreter_print_via(self, "HashMap_to_str", v) {
                    ExecOutcome::Continue => {
                        return ExecOutcome::Continue;
                    }
                    ExecOutcome::Panic(pm2) => {
                        return ExecOutcome::Panic(pm2);
                    }
                    _ => {
                    }
                }
            }
            if ir_type_is_opaque_named(ty, "String") {
                match v {
                    Value::Int(saddr) => {
                        if saddr > 0 && Memory_is_valid_addr(&self.memory, saddr) {
                            var ss: str = Memory_load_cstr(&self.memory, saddr);
                            if str_len(ss) > 0 {
                                p_print_str(ss);
                                return ExecOutcome::Continue;
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            var is_str: bool = false;
            match ty {
                IrType::Ptr(inner) => {
                    match inner {
                        IrType::U8 => {
                            is_str = true;
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            if is_str {
                match v {
                    Value::Int(addr) => {
                        if addr > 0 && Memory_is_valid_addr(&self.memory, addr) {
                            // A str: print it even when it is empty.
                            p_print_str(Memory_load_cstr(&self.memory, addr));
                            return ExecOutcome::Continue;
                        }
                    }
                    _ => {
                    }
                }
            }
            var tens_h: i64 = -1;
            match v {
                Value::Ptr(tp) => {
                    tens_h = Interpreter_tensor_handle(self, v);
                }
                Value::Int(ti) => {
                    if ir_type_is_opaque_named(ty, "Tensor") {
                        tens_h = Interpreter_tensor_handle(self, v);
                    }
                }
                _ => {
                }
            }
            if tens_h >= 0 {
                p_print_str(interp_tensor_to_string(&self.tensors.get(tens_h)));
                return ExecOutcome::Continue;
            }
            match v {
                Value::Ptr(addr2) => {
                    var s2: str = Memory_load_cstr(&self.memory, addr2);
                    if str_len(s2) == 0 && !is_str {
                        p_print_str("ptr(0x" + int_to_hex(addr2) + ")");
                    } else {
                        p_print_str(s2);
                    }
                }
                _ => {
                    p_print_str(Interpreter_display_value(self, v));
                }
            }
            return ExecOutcome::Continue;
        }
        Inst::Panic(message) => {
            return ExecOutcome::Panic(message);
        }
        Inst::Asm(_, _, _, ret_ty) => {
            if self.revoked_caps.len() > 0 && Interpreter_cap_is_revoked(self, "FFI") {
                return interp_sandbox_panic("asm!", "FFI");
            }
            // Interpreter: no actual assembly execution
            match ret_ty {
                IrType::Void => {
                    return ExecOutcome::Continue;
                }
                _ => {
                    return ExecOutcome::Value(Value::Int(0));
                }
            }
        }

        // ─── Region Management ───
        Inst::RegionBegin(name, _, _, _) => {
            self.region_stack.push(name);
            return ExecOutcome::Value(Value::Int(0));
        }
        Inst::RegionEnd(_, _, _) => {
            if self.region_stack.len() > 0 {
                self.region_stack.pop();
            }
            return ExecOutcome::Continue;
        }

        // ─── Persist Variables ───
        Inst::PersistLoad(name, default, _) => {
            // A value saved earlier (src/interp.rs persist_state), else the default
            var dv: Value = get_value(values, default);
            var pk: i64 = 0;
            while pk < self.persist_keys.len() {
                if self.persist_keys.get(pk) == name {
                    return ExecOutcome::Value(Interpreter_parse_persisted_value(self, self.persist_vals.get(pk), dv));
                }
                pk = pk + 1;
            }
            return ExecOutcome::Value(dv);
        }
        Inst::PersistSave(pname, pvalue) => {
            var ps: str = Interpreter_stringify_value(self, get_value(values, pvalue));
            var pj: i64 = 0;
            while pj < self.persist_keys.len() {
                if self.persist_keys.get(pj) == pname {
                    self.persist_vals.set(pj, ps);
                    return ExecOutcome::Continue;
                }
                pj = pj + 1;
            }
            self.persist_keys.push(pname);
            self.persist_vals.push(ps);
            return ExecOutcome::Continue;
        }

        // ─── Transaction Blocks ───
        Inst::TxnBegin => {
            // Deep snapshot — a struct copy would share the Vec backing, so
            // post-snapshot writes would already be visible in the "snapshot".
            self.txn_mem_snapshots.push(Memory_clone(&self.memory));
            self.txn_opaque_snapshots.push(OpaqueSnapshot {
                entries: I64Table_clone(&self.opaque_values)
            });
            return ExecOutcome::Continue;
        }
        Inst::TxnEnd => {
            if self.txn_mem_snapshots.len() > 0 {
                self.txn_mem_snapshots.pop();
            }
            if self.txn_opaque_snapshots.len() > 0 {
                self.txn_opaque_snapshots.pop();
            }
            return ExecOutcome::Continue;
        }

        // ─── Unsafe Blocks ───
        Inst::UnsafeBegin => {
            self.interp_unsafe_depth = self.interp_unsafe_depth + 1;
            return ExecOutcome::Continue;
        }
        Inst::UnsafeEnd => {
            if self.interp_unsafe_depth > 0 {
                self.interp_unsafe_depth = self.interp_unsafe_depth - 1;
            }
            return ExecOutcome::Continue;
        }

        // ─── Autograd (stubbed) ───
        Inst::GradBegin(_) => {
            self.ag_enabled = true;
            var fresh_tape: Vec<AgEntry> = Vec::new();
            self.ag_tape = fresh_tape;
            var fresh_keys: Vec<i64> = Vec::new();
            self.ag_grad_keys = fresh_keys;
            var fresh_vals: Vec<TensorData> = Vec::new();
            self.ag_grad_vals = fresh_vals;
            return ExecOutcome::Continue;
        }
        Inst::GradEnd => {
            self.ag_enabled = false;
            return ExecOutcome::Continue;
        }
        Inst::Backward(_) => {
            Interpreter_run_backward(self);
            return ExecOutcome::Continue;
        }
        Inst::StructCopy(dst, src, ty) => {
            // memcpy struct data src -> dst (src/interp.rs:1604)
            var dst_addr: i64 = 0;
            match get_value(values, dst) {
                Value::Ptr(a) => {
                    dst_addr = a;
                }
                Value::Int(n) => {
                    dst_addr = n;
                }
                _ => {
                }
            }
            var src_addr: i64 = 0;
            match get_value(values, src) {
                Value::Ptr(a) => {
                    src_addr = a;
                }
                Value::Int(n) => {
                    src_addr = n;
                }
                _ => {
                }
            }
            var size: i64 = IrModule_type_size(&self.module, ty);
            var ci: i64 = 0;
            while ci < size {
                var b: i64 = Memory_load_byte(&self.memory, src_addr + ci);
                Memory_store_byte(&mut self.memory, dst_addr + ci, b);
                ci = ci + 1;
            }
            return ExecOutcome::Continue;
        }
    }
    return ExecOutcome::Continue;
}

// ===========================================================================
// eval_binop -- evaluate a binary operation
// ===========================================================================

fn meta_is_u64(m: OptValueMeta) -> bool {
    match m {
        OptValueMeta::Some(v) => {
            return ir_type_eq(v.ty, IrType::U64);
        }
        OptValueMeta::None => {
            return false;
        }
    }
}

fn interp_plain_int(t: IrType) -> bool {
    match t {
        IrType::I8 => {
            return true;
        }
        IrType::I16 => {
            return true;
        }
        IrType::I32 => {
            return true;
        }
        IrType::I64 => {
            return true;
        }
        IrType::U8 => {
            return true;
        }
        IrType::U16 => {
            return true;
        }
        IrType::U32 => {
            return true;
        }
        IrType::U64 => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// `v` as a value of integer type `t` (as a cast would give it).
fn interp_int_norm(v: i64, t: IrType) -> i64 {
    match t {
        IrType::I8 => {
            return (v << 56) >> 56;
        }
        IrType::I16 => {
            return (v << 48) >> 48;
        }
        IrType::I32 => {
            return (v << 32) >> 32;
        }
        IrType::U8 => {
            return v & 0xFF;
        }
        IrType::U16 => {
            return v & 0xFFFF;
        }
        IrType::U32 => {
            return v & 0xFFFFFFFF;
        }
        _ => {
            return v;
        }
    }
}

/// Integer operands go through the operation's type, the one meaning every
/// backend implements; everything else through eval_binop.
fn Interpreter_eval_typed(self: &Interpreter, op: BinOp, l: Value, r: Value, ty: IrType, u64_operand: bool) -> Value {
    match l {
        Value::Int(a) => {
            match r {
                Value::Int(b) => {
                    if interp_plain_int(ty) {
                        return Interpreter_eval_int_binop(self, op, a, b, ty);
                    }
                    if u64_operand {
                        var ua: u64 = a as u64;
                        var ub: u64 = b as u64;
                        match op {
                            BinOp::Lt => {
                                return Value::Bool(ua < ub);
                            }
                            BinOp::Gt => {
                                return Value::Bool(ua > ub);
                            }
                            BinOp::LtEq => {
                                return Value::Bool(ua <= ub);
                            }
                            BinOp::GtEq => {
                                return Value::Bool(ua >= ub);
                            }
                            _ => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return Interpreter_eval_binop(self, op, l, r);
}

/// Integer arithmetic in type `ty` (as src/interp.rs eval_int_binop).
/// Overflow is Value::Void (the caller panics) or, in a @wrapping program,
/// wraps at that width; dividing by zero is always Void. This function
/// itself wraps: it tests each result.
@wrapping
fn Interpreter_eval_int_binop(self: &Interpreter, op: BinOp, a: i64, b: i64, ty: IrType) -> Value {
    var is_u64: bool = ir_type_eq(ty, IrType::U64);
    var is_i64: bool = ir_type_eq(ty, IrType::I64);
    var ua: u64 = a as u64;
    var ub: u64 = b as u64;
    var r: i64 = 0;
    var ovf: bool = false;
    match op {
        BinOp::Add => {
            r = a + b;
            if is_u64 {
                ovf = (r as u64) < ua;
            } else if is_i64 {
                ovf = ((a ^ r) & (b ^ r)) < 0;
            }
        }
        BinOp::Sub => {
            r = a - b;
            if is_u64 {
                ovf = ua < ub;
            } else if is_i64 {
                ovf = ((a ^ b) & (a ^ r)) < 0;
            }
        }
        BinOp::Mul => {
            r = a * b;
            if is_u64 {
                if a != 0 {
                    ovf = (r as u64) / ua != ub;
                }
            } else if is_i64 {
                var i64_min: i64 = (1 << 63);
                if a != 0 {
                    ovf = (a == -1 && b == i64_min) || r / a != b;
                }
            }
        }
        BinOp::Div => {
            if b == 0 {
                return Value::Void;
            }
            if is_u64 {
                return Value::Int((ua / ub) as i64);
            }
            if b == -1 {
                r = 0 - a;
                if is_i64 {
                    ovf = a == (1 << 63);
                }
            } else {
                r = a / b;
            }
        }
        BinOp::Mod => {
            if b == 0 {
                return Value::Void;
            }
            if is_u64 {
                return Value::Int((ua % ub) as i64);
            }
            if b == -1 {
                return Value::Int(0);
            }
            return Value::Int(a % b);
        }
        BinOp::Shl => {
            return Value::Int(interp_int_norm(a << (b & 63), ty));
        }
        BinOp::Shr => {
            if is_u64 {
                return Value::Int((ua >> (ub & 63)) as i64);
            }
            return Value::Int(a >> (b & 63));
        }
        _ => {
            return Interpreter_eval_binop(self, op, Value::Int(a), Value::Int(b));
        }
    }
    var fit: i64 = interp_int_norm(r, ty);
    if !ovf && !is_u64 && !is_i64 {
        ovf = fit != r;
    }
    if ovf && !Interpreter_is_wrapping_func(self) {
        return Value::Void;
    }
    return Value::Int(fit);
}

pub fn Interpreter_eval_binop(self: &Interpreter, op: BinOp, l: Value, r: Value) -> Value {
    // A bool compared with an integer is 0 or 1, as in C (runtime predicates
    // return bool; `p_file_exists(p) != 0` must work).
    match l {
        Value::Bool(lb) => {
            match r {
                Value::Int(_) => {
                    var li: i64 = 0;
                    if lb {
                        li = 1;
                    }
                    return Interpreter_eval_binop(self, op, Value::Int(li), r);
                }
                _ => {
                }
            }
        }
        Value::Int(_) => {
            match r {
                Value::Bool(rb) => {
                    var ri: i64 = 0;
                    if rb {
                        ri = 1;
                    }
                    return Interpreter_eval_binop(self, op, l, Value::Int(ri));
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    match l {
        Value::Int(a) => {
            match r {
                Value::Int(b) => {
                    var i64_max: i64 = 9223372036854775807;
                    var i64_min: i64 = 0 - 9223372036854775807 - 1;
                    var use_wrapping: bool = Interpreter_is_wrapping_func(self);
                    match op {
                        BinOp::Add => {
                            if !use_wrapping {
                                // Pre-check: computing a+b under a checked host would
                                // trap before we can test the result.
                                if b > 0 && a > i64_max - b {
                                    return Value::Void;
                                }
                                if b < 0 && a < i64_min - b {
                                    return Value::Void;
                                }
                            }
                            if use_wrapping {
                                return Value::Int(wrap_add(a, b));
                            }
                            return Value::Int(a + b);
                        }
                        BinOp::Sub => {
                            if !use_wrapping {
                                if b > 0 && a < i64_min + b {
                                    return Value::Void;
                                }
                                if b < 0 && a > i64_max + b {
                                    return Value::Void;
                                }
                            }
                            if use_wrapping {
                                return Value::Int(wrap_sub(a, b));
                            }
                            return Value::Int(a - b);
                        }
                        BinOp::Mul => {
                            if !use_wrapping {
                                // CERT-style division pre-checks; all divisions are
                                // exact-or-toward-zero and cannot themselves overflow.
                                var mul_ovf: bool = false;
                                if a > 0 {
                                    if b > 0 {
                                        mul_ovf = a > i64_max / b;
                                    } else if b < 0 {
                                        mul_ovf = b < i64_min / a;
                                    }
                                } else if a < 0 {
                                    if b > 0 {
                                        mul_ovf = a < i64_min / b;
                                    } else if b < 0 {
                                        mul_ovf = a < i64_max / b;
                                    }
                                }
                                if mul_ovf {
                                    return Value::Void;
                                }
                            }
                            if use_wrapping {
                                return Value::Int(wrap_mul(a, b));
                            }
                            return Value::Int(a * b);
                        }
                        BinOp::Div => {
                            if b == 0 {
                                return Value::Void;
                            }
                            if b == -1 && a == i64_min {
                                return Value::Int(i64_min);
                            }
                            return Value::Int(a / b);
                        }
                        BinOp::Mod => {
                            if b == 0 {
                                return Value::Void;
                            }
                            if b == -1 && a == i64_min {
                                return Value::Int(0);
                            }
                            return Value::Int(a % b);
                        }
                        BinOp::Eq => {
                            return Value::Bool(a == b);
                        }
                        BinOp::Neq => {
                            return Value::Bool(a != b);
                        }
                        BinOp::Lt => {
                            return Value::Bool(a < b);
                        }
                        BinOp::Gt => {
                            return Value::Bool(a > b);
                        }
                        BinOp::LtEq => {
                            return Value::Bool(a <= b);
                        }
                        BinOp::GtEq => {
                            return Value::Bool(a >= b);
                        }
                        BinOp::And => {
                            return Value::Bool(a != 0 && b != 0);
                        }
                        BinOp::Or => {
                            return Value::Bool(a != 0 || b != 0);
                        }
                        BinOp::BitAnd => {
                            return Value::Int(a & b);
                        }
                        BinOp::BitOr => {
                            return Value::Int(a | b);
                        }
                        BinOp::BitXor => {
                            return Value::Int(a ^ b);
                        }
                        BinOp::Shl => {
                            return Value::Int(a << (b & 63));
                        }
                        BinOp::Shr => {
                            return Value::Int(a >> (b & 63));
                        }
                    }
                }
                Value::Ptr(b_addr) => {
                    match op {
                        BinOp::Add => {
                            return Value::Ptr(a + b_addr);
                        }
                        BinOp::Eq => {
                            return Value::Bool(a == b_addr);
                        }
                        BinOp::Neq => {
                            return Value::Bool(a != b_addr);
                        }
                        BinOp::Lt => {
                            return Value::Bool(a < b_addr);
                        }
                        BinOp::LtEq => {
                            return Value::Bool(a <= b_addr);
                        }
                        BinOp::Gt => {
                            return Value::Bool(a > b_addr);
                        }
                        BinOp::GtEq => {
                            return Value::Bool(a >= b_addr);
                        }
                        _ => {
                            return Value::Void;
                        }
                    }
                }
                Value::Str(bs) => {
                    match op {
                        BinOp::Eq => {
                            return Value::Bool(str_len(bs) == 0 && a == 0);
                        }
                        BinOp::Neq => {
                            return Value::Bool(!(str_len(bs) == 0 && a == 0));
                        }
                        _ => {
                            return Value::Void;
                        }
                    }
                }
                _ => {
                    return Value::Void;
                }
            }
        }
        Value::Float(a) => {
            match r {
                Value::Float(b) => {
                    match op {
                        BinOp::Add => {
                            return Value::Float(a + b);
                        }
                        BinOp::Sub => {
                            return Value::Float(a - b);
                        }
                        BinOp::Mul => {
                            return Value::Float(a * b);
                        }
                        BinOp::Div => {
                            return Value::Float(a / b);
                        }
                        BinOp::Mod => {
                            return Value::Float(a % b);
                        }
                        BinOp::Eq => {
                            return Value::Bool(a == b);
                        }
                        BinOp::Neq => {
                            return Value::Bool(a != b);
                        }
                        BinOp::Lt => {
                            return Value::Bool(a < b);
                        }
                        BinOp::Gt => {
                            return Value::Bool(a > b);
                        }
                        BinOp::LtEq => {
                            return Value::Bool(a <= b);
                        }
                        BinOp::GtEq => {
                            return Value::Bool(a >= b);
                        }
                        _ => {
                            return Value::Float(0.0);
                        }
                    }
                }
                _ => {
                    return Value::Void;
                }
            }
        }
        Value::Bool(a) => {
            match r {
                Value::Bool(b) => {
                    match op {
                        BinOp::Eq => {
                            return Value::Bool(a == b);
                        }
                        BinOp::Neq => {
                            return Value::Bool(a != b);
                        }
                        BinOp::And => {
                            return Value::Bool(a && b);
                        }
                        BinOp::Or => {
                            return Value::Bool(a || b);
                        }
                        _ => {
                            return Value::Bool(false);
                        }
                    }
                }
                _ => {
                    return Value::Void;
                }
            }
        }
        Value::Str(a) => {
            match r {
                Value::Str(b) => {
                    match op {
                        BinOp::Eq => {
                            return Value::Bool(a == b);
                        }
                        BinOp::Neq => {
                            return Value::Bool(a != b);
                        }
                        _ => {
                            return Value::Void;
                        }
                    }
                }
                Value::Int(b2) => {
                    // "" stands for a null str here, except the text of an
                    // empty file (interp_empty_read), which is a real string
                    var str_null: bool = str_len(a) == 0 && b2 == 0 && interp_is_empty_read(a) == false;
                    match op {
                        BinOp::Eq => {
                            return Value::Bool(str_null);
                        }
                        BinOp::Neq => {
                            return Value::Bool(!str_null);
                        }
                        _ => {
                            return Value::Void;
                        }
                    }
                }
                Value::Ptr(pb) => {
                    var ps: str = Memory_load_cstr(&self.memory, pb);
                    match op {
                        BinOp::Eq => {
                            return Value::Bool(a == ps);
                        }
                        BinOp::Neq => {
                            return Value::Bool(a != ps);
                        }
                        _ => {
                            return Value::Void;
                        }
                    }
                }
                _ => {
                    return Value::Void;
                }
            }
        }
        Value::Ptr(a_addr) => {
            match r {
                Value::Int(b3) => {
                    match op {
                        BinOp::Add => {
                            return Value::Ptr(a_addr + b3);
                        }
                        BinOp::Sub => {
                            return Value::Ptr(a_addr - b3);
                        }
                        BinOp::Eq => {
                            return Value::Bool(a_addr == b3);
                        }
                        BinOp::Neq => {
                            return Value::Bool(a_addr != b3);
                        }
                        BinOp::Lt => {
                            return Value::Bool(a_addr < b3);
                        }
                        BinOp::LtEq => {
                            return Value::Bool(a_addr <= b3);
                        }
                        BinOp::Gt => {
                            return Value::Bool(a_addr > b3);
                        }
                        BinOp::GtEq => {
                            return Value::Bool(a_addr >= b3);
                        }
                        _ => {
                            return Value::Void;
                        }
                    }
                }
                Value::Str(sb) => {
                    var pa: str = Memory_load_cstr(&self.memory, a_addr);
                    match op {
                        BinOp::Eq => {
                            return Value::Bool(pa == sb);
                        }
                        BinOp::Neq => {
                            return Value::Bool(pa != sb);
                        }
                        _ => {
                            return Value::Void;
                        }
                    }
                }
                Value::Ptr(b_addr2) => {
                    match op {
                        BinOp::Eq => {
                            return Value::Bool(a_addr == b_addr2);
                        }
                        BinOp::Neq => {
                            return Value::Bool(a_addr != b_addr2);
                        }
                        BinOp::Lt => {
                            return Value::Bool(a_addr < b_addr2);
                        }
                        BinOp::LtEq => {
                            return Value::Bool(a_addr <= b_addr2);
                        }
                        BinOp::Gt => {
                            return Value::Bool(a_addr > b_addr2);
                        }
                        BinOp::GtEq => {
                            return Value::Bool(a_addr >= b_addr2);
                        }
                        _ => {
                            return Value::Void;
                        }
                    }
                }
                _ => {
                    return Value::Void;
                }
            }
        }
        _ => {
            return Value::Void;
        }
    }
    return Value::Void;
}

// ===========================================================================
// eval_unaryop -- evaluate a unary operation
// ===========================================================================

pub fn Interpreter_eval_unaryop(self: &Interpreter, op: UnaryOp, v: Value) -> Value {
    match v {
        Value::Int(i) => {
            match op {
                UnaryOp::Neg => {
                    return Value::Int(-i);
                }
                UnaryOp::Not => {
                    return Value::Bool(i == 0);
                }
                UnaryOp::BitNot => {
                    return Value::Int(~i);
                }
            }
        }
        Value::Float(f) => {
            match op {
                UnaryOp::Neg => {
                    return Value::Float(-f);
                }
                _ => {
                    return Value::Float(0.0);
                }
            }
        }
        Value::Bool(b) => {
            match op {
                UnaryOp::Not => {
                    return Value::Bool(!b);
                }
                _ => {
                    return Value::Bool(false);
                }
            }
        }
        _ => {
            return Value::Void;
        }
    }
    return Value::Void;
}

// ===========================================================================
// cast_value -- cast a value to a different type
// ===========================================================================

pub fn Interpreter_cast_value(self: &Interpreter, v: Value, to: IrType) -> Value {
    match v {
        Value::Int(i) => {
            match to {
                IrType::F32 => {
                    return Value::Float((i as f64));
                }
                IrType::F64 => {
                    return Value::Float((i as f64));
                }
                // An address made a pointer (`p + off` cast to *T): a Store
                // or Load through it needs a pointer value, or it went to 0
                IrType::Ptr(_) => {
                    if i == 0 {
                        return Value::Int(0);
                    }
                    return Value::Ptr(i);
                }
                _ => {
                    return Value::Int(i);
                }
            }
        }
        Value::Ptr(pa) => {
            match to {
                IrType::I64 => {
                    return Value::Int(pa);
                }
                IrType::U64 => {
                    return Value::Int(pa);
                }
                _ => {
                    return v;
                }
            }
        }
        Value::Float(f) => {
            match to {
                IrType::I64 => {
                    return Value::Int((f as i64));
                }
                IrType::I32 => {
                    return Value::Int((f as i64));
                }
                _ => {
                    return Value::Float(f);
                }
            }
        }
        Value::Bool(b) => {
            match to {
                IrType::I64 => {
                    if b {
                        return Value::Int(1);
                    }
                    return Value::Int(0);
                }
                _ => {
                    return Value::Bool(b);
                }
            }
        }
        _ => {
            return v;
        }
    }
    return v;
}

// The text of an empty file (known-bugs 2g.42). A Str that is "" compares
// equal to 0 (it stands for a null str), so read_file of an empty file was
// None. p_file_read gives this one heap string instead, told apart by its
// address; a failed read gives Value::Int(0).
var g_interp_empty_read: i64 = 0;

fn interp_empty_read() -> str {
    if g_interp_empty_read == 0 {
        g_interp_empty_read = p_str_buf(0);
    }
    return g_interp_empty_read as str;
}

fn interp_is_empty_read(s: str) -> bool {
    return g_interp_empty_read != 0 && (s as i64) == g_interp_empty_read;
}

// ===========================================================================
// is_runtime_func -- check if a name is a runtime function
// ===========================================================================

// --- run-time capability revocation (roadmap Phase 12) ---------------------
// `sandbox { }` is checked when the program is compiled (typechecker.fd
// sandbox_depth). These builtins revoke capabilities while the program runs,
// so what the checker cannot see (a function value, a call through a
// pointer, a C function) is stopped too:
//   p_cap_revoke(cap)   revoke "IO", "FS", "Net", "Spawn", "Env", "FFI" or
//                       "all" for the rest of the run (0; -1 unknown cap)
//   p_cap_revoked(cap)  1 when `cap` is revoked, else 0
//   p_sandbox_enter()   revoke every capability until the matching
//   p_sandbox_exit()    (what lowering emits around `sandbox { }`)
// A revoked capability's builtin is not run: the program panics with a
// "Sandbox error". Revocation cannot be undone except by p_sandbox_exit.

/// The capabilities p_cap_revoke("all") and p_sandbox_enter revoke.
fn interp_all_caps() -> Vec<str> {
    var caps: Vec<str> = Vec::new();
    caps.push("IO");
    caps.push("FS");
    caps.push("Net");
    caps.push("Spawn");
    caps.push("Env");
    caps.push("FFI");
    return caps;
}

/// The capability runtime builtin `name` needs ("" for none); the same
/// families as the type checker's (compiler.fd repl_call_cap). Allocation is
/// not one of them: core allocates for every string and Vec.
pub fn interp_builtin_cap(name: str) -> str {
    if name == "print" || str_starts_with(name, "p_print") || str_starts_with(name, "p_eprint") || name == "p_read_line" || name == "p_read_stdin" {
        return "IO";
    }
    if str_starts_with(name, "p_file_") || str_starts_with(name, "p_dir_") || str_starts_with(name, "p_fs_") || name == "p_mkdir" || name == "p_rmdir" || name == "p_rename" || name == "p_remove" || name == "p_is_dir" || name == "p_dl_open" || name == "p_dl_sym" {
        return "FS";
    }
    if str_starts_with(name, "p_socket") || str_starts_with(name, "p_unix_") || str_starts_with(name, "p_http_") || str_starts_with(name, "p_net_") || str_starts_with(name, "p_tcp_") || str_starts_with(name, "p_udp_") || str_starts_with(name, "p_dns_") || str_starts_with(name, "p_tls_") {
        return "Net";
    }
    if name == "p_system" || str_starts_with(name, "p_process_") || name == "p_thread_spawn" || str_starts_with(name, "p_exec") {
        return "Spawn";
    }
    if name == "p_getenv" || str_starts_with(name, "p_env_") || name == "p_setenv" {
        return "Env";
    }
    return "";
}

/// Whether capability `cap` is revoked.
pub fn Interpreter_cap_is_revoked(self: &Interpreter, cap: str) -> bool {
    var i: i64 = 0;
    while i < self.revoked_caps.len() {
        if self.revoked_caps.get(i) == cap {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The capability call `name` needs when it is revoked, else "": a
/// builtin's (interp_builtin_cap), or "FFI" for a C function the module
/// declares extern.
pub fn Interpreter_cap_denied(self: &Interpreter, name: str) -> str {
    if self.revoked_caps.len() == 0 {
        return "";
    }
    var cap: str = interp_builtin_cap(name);
    if str_len(cap) == 0 && !str_starts_with(name, "p_") && name != "print" {
        var i: i64 = 0;
        while i < self.module.extern_functions.len() {
            if self.module.extern_functions.get(i).name == name {
                cap = "FFI";
                i = self.module.extern_functions.len();
            }
            i = i + 1;
        }
    }
    if str_len(cap) > 0 && Interpreter_cap_is_revoked(self, cap) {
        return cap;
    }
    return "";
}

/// The panic of a call to `name`, which needs revoked capability `cap`.
pub fn interp_sandbox_panic(name: str, cap: str) -> ExecOutcome {
    return ExecOutcome::Panic("Sandbox error: '" + name + "' needs capability '" + cap + "', which was revoked at run time\n    Fix: make the call before p_sandbox_enter revokes " + cap + ", or after p_sandbox_exit, or leave " + cap + " out of what the sandbox revokes");
}

/// Whether `name` is one of the revocation builtins.
pub fn interp_is_cap_builtin(name: str) -> bool {
    return name == "p_cap_revoke" || name == "p_cap_revoked" || name == "p_sandbox_enter" || name == "p_sandbox_exit";
}

/// Run revocation builtin `name` (interp_is_cap_builtin) on `args`.
pub fn Interpreter_cap_builtin(self: &mut Interpreter, name: str, args: Vec<Value>) -> ExecOutcome {
    if name == "p_sandbox_enter" {
        self.cap_marks.push(self.revoked_caps.len());
        var all: Vec<str> = interp_all_caps();
        var ai: i64 = 0;
        while ai < all.len() {
            self.revoked_caps.push(all.get(ai));
            ai = ai + 1;
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_sandbox_exit" {
        if self.cap_marks.len() == 0 {
            return ExecOutcome::Panic("Sandbox error: p_sandbox_exit without p_sandbox_enter\n    Fix: pair each p_sandbox_exit with a p_sandbox_enter before it");
        }
        var mark: i64 = self.cap_marks.get(self.cap_marks.len() - 1);
        self.cap_marks.pop();
        while self.revoked_caps.len() > mark {
            self.revoked_caps.pop();
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    var cap: str = "";
    if args.len() > 0 {
        match Interpreter_arg_string(self, args.get(0)) {
            OptStr::Some(s) => {
                cap = s;
            }
            OptStr::None => {
            }
        }
    }
    var known: Vec<str> = interp_all_caps();
    var is_known: bool = false;
    var ki: i64 = 0;
    while ki < known.len() {
        if known.get(ki) == cap {
            is_known = true;
        }
        ki = ki + 1;
    }
    if name == "p_cap_revoked" {
        if Interpreter_cap_is_revoked(self, cap) {
            return ExecOutcome::Value(Value::Int(1));
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    // p_cap_revoke
    if cap == "all" {
        var ki2: i64 = 0;
        while ki2 < known.len() {
            self.revoked_caps.push(known.get(ki2));
            ki2 = ki2 + 1;
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if !is_known {
        return ExecOutcome::Value(Value::Int(0 - 1));
    }
    self.revoked_caps.push(cap);
    return ExecOutcome::Value(Value::Int(0));
}

pub fn Interpreter_is_runtime_func(self: &mut Interpreter, name: str) -> bool {
    var cached: i64 = StrTable_get(&self.rt_cache, name, -1);
    if cached >= 0 {
        return cached == 1;
    }
    var r: bool = Interpreter_is_runtime_func_uncached(self, name);
    if r {
        StrTable_set(&mut self.rt_cache, name, 1);
    } else {
        StrTable_set(&mut self.rt_cache, name, 0);
    }
    return r;
}

pub fn Interpreter_is_runtime_func_uncached(self: &Interpreter, name: str) -> bool {
    // Check if it's an extern function
    var i: i64 = 0;
    while i < self.module.extern_functions.len() {
        if self.module.extern_functions.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    // Check known runtime prefixes
    if name == "print" {
        return true;
    }
    if str_starts_with(name, "p_vec_") {
        return true;
    }
    if str_starts_with(name, "p_map_") {
        return true;
    }
    if str_starts_with(name, "p_string_") {
        return true;
    }
    if str_starts_with(name, "p_json_") {
        return true;
    }
    if str_starts_with(name, "p_tensor_") {
        return true;
    }
    if str_starts_with(name, "p_simd_") {
        return true;
    }
    if str_starts_with(name, "p_socket_") {
        return true;
    }
    // roadmap L4B: Unix-domain sockets (simulated, iux_*)
    if name == "p_unix_listen" || name == "p_unix_connect" {
        return true;
    }
    if str_starts_with(name, "p_http_") {
        return true;
    }
    if str_starts_with(name, "p_db_") {
        return true;
    }
    if str_starts_with(name, "p_file_") {
        return true;
    }
    if str_starts_with(name, "p_dir_") {
        return true;
    }
    if str_starts_with(name, "p_process_") {
        return true;
    }
    if name == "p_mkdir" || name == "p_rmdir" || name == "p_rename" || name == "p_is_dir" {
        return true;
    }
    if name == "p_getpid" {
        return true;
    }
    // CT7: standard input (interp_read_input)
    if name == "p_read_line" || name == "p_read_stdin" {
        return true;
    }
    if str_starts_with(name, "p_thread_") {
        return true;
    }
    if str_starts_with(name, "p_atomic_") {
        return true;
    }
    if str_starts_with(name, "p_mutex_") {
        return true;
    }
    if str_starts_with(name, "p_shared_") {
        return true;
    }
    if str_starts_with(name, "p_future_") {
        return true;
    }
    if str_starts_with(name, "p_grad_") {
        return true;
    }
    if str_starts_with(name, "__ecs_") {
        return true;
    }
    if str_starts_with(name, "p_dp_budget_") {
        return true;
    }
    if str_starts_with(name, "p_tp_") {
        return true;
    }
    if str_starts_with(name, "p_checkpoint_") {
        return true;
    }
    if str_starts_with(name, "p_volatile_") {
        return true;
    }
    // The lowering's fused string forms (`s + int_to_str(n)`, `s = s + x`):
    // core writes them into memory, but here strings are the interpreter's
    // own values, so they run as builtins even though core defines them
    if name == "p_str_concat_int" || name == "p_str_append" {
        return true;
    }
    if str_starts_with(name, "p_signal_") {
        return true;
    }
    // SL15: the profiler a program drives (its counting fallback here)
    if name == "p_prof_start" || name == "p_prof_stop" || name == "p_prof_report" || name == "p_prof_samples" {
        return true;
    }
    // The runtime set of src/interp.rs ends here. A name the program or
    // core defines as a Fides function runs that function (core implements
    // p_str_equal, p_str_length, ... itself): the builtins below are only
    // for names nothing defines.
    match Interpreter_get_function(self, name) {
        OptIrFunction::Some(_) => {
            return false;
        }
        OptIrFunction::None => {
        }
    }
    if str_starts_with(name, "p_sb_") {
        return true;
    }
    // PRNG and noise builtins
    if name == "p_prng_next" {
        return true;
    }
    if name == "p_prng_uniform" {
        return true;
    }
    if name == "p_prng_gaussian" {
        return true;
    }
    if name == "p_dp_noise" {
        return true;
    }
    if name == "p_gaussian_noise" {
        return true;
    }
    if name == "p_dropout" {
        return true;
    }
    // Check common p_ builtins
    if name == "p_print_int" {
        return true;
    }
    if name == "p_print_float" {
        return true;
    }
    if name == "p_print_bool" {
        return true;
    }
    if name == "p_print_str" {
        return true;
    }
    if name == "p_eprint_str" {
        return true;
    }
    if name == "p_print_newline" {
        return true;
    }
    if name == "p_panic" {
        return true;
    }
    if name == "p_alloc" {
        return true;
    }
    if name == "p_malloc" {
        return true;
    }
    if name == "p_free" {
        return true;
    }
    if name == "p_region_free" {
        return true;
    }
    if name == "p_str_concat" {
        return true;
    }
    if name == "p_str_concat_int" {
        return true;
    }
    if name == "p_to_str" {
        return true;
    }
    if name == "p_char_to_str" {
        return true;
    }
    if name == "p_float_to_str" {
        return true;
    }
    if name == "p_str_to_float" {
        return true;
    }
    if name == "p_str_to_int" {
        return true;
    }
    if name == "p_str_len" {
        return true;
    }
    if name == "p_str_equal" {
        return true;
    }
    if name == "p_str_cmp" {
        return true;
    }
    if name == "p_bool_to_str" {
        return true;
    }
    if name == "p_clock_now" {
        return true;
    }
    if name == "p_clock_now_us" {
        return true;
    }
    if name == "p_os_random_u64" {
        return true;
    }
    if name == "p_clock_now_ms" {
        return true;
    }
    if name == "p_clock_mono_ms" {
        return true;
    }
    if name == "p_memset" {
        return true;
    }
    if name == "p_str_zeroize" {
        return true;
    }
    if name == "p_vec_zeroize" {
        return true;
    }
    if name == "p_sensitive_mark" {
        return true;
    }
    if name == "p_sensitive_check" {
        return true;
    }
    if name == "p_sensitive_unmark" {
        return true;
    }
    if name == "p_sensitive_remark" {
        return true;
    }
    if name == "p_sensitive_free" {
        return true;
    }
    if name == "p_sensitive_wipes" {
        return true;
    }
    // RT7: the process's resident bytes (the C runtime's p_mem_resident)
    if name == "p_mem_resident" {
        return true;
    }
    return false;
}

// ===========================================================================
// The profiler a program drives (competitive SL15)
// ===========================================================================
// p_prof_start / p_prof_stop / p_prof_report / p_prof_samples sample the
// running program on the native and C backends (one sample per ms of CPU
// time). The interpreter has no clock to sample by: while it is on, each
// call of a Fides function counts as one sample, "self" for the function
// called and "total" once for every function on the call stack then (the
// called one included). The report has the native runtimes' format, its
// numbers are calls.

var g_ip_prof_on: bool = false;
var g_ip_prof_n: i64 = 0;
var g_ip_prof_idx: i64 = 0;  // map: function name -> row + 1
var g_ip_prof_names: Vec<str> = Vec::new();
var g_ip_prof_self: Vec<i64> = Vec::new();
var g_ip_prof_total: Vec<i64> = Vec::new();
var g_ip_prof_stamp: Vec<i64> = Vec::new();

/// Every count back to 0.
fn interp_prof_reset() {
    g_ip_prof_n = 0;
    g_ip_prof_idx = HashMap_new();
    g_ip_prof_names = Vec::new();
    g_ip_prof_self = Vec::new();
    g_ip_prof_total = Vec::new();
    g_ip_prof_stamp = Vec::new();
}

/// The row of function `name`, made on its first sample.
fn interp_prof_row(name: str) -> i64 {
    if g_ip_prof_idx == 0 {
        g_ip_prof_idx = HashMap_new();
    }
    if HashMap_contains(g_ip_prof_idx, name) {
        return HashMap_get(g_ip_prof_idx, name) - 1;
    }
    g_ip_prof_names.push(name);
    g_ip_prof_self.push(0);
    g_ip_prof_total.push(0);
    g_ip_prof_stamp.push(0);
    var r: i64 = g_ip_prof_names.len() - 1;
    HashMap_insert(g_ip_prof_idx, name, r + 1);
    return r;
}

/// One sample: a call was just entered (its name on top of `stack`).
fn interp_prof_count(stack: &Vec<str>) {
    var n: i64 = stack.len();
    if n == 0 {
        return;
    }
    g_ip_prof_n = g_ip_prof_n + 1;
    var top: i64 = interp_prof_row(stack.get(n - 1));
    g_ip_prof_self.set(top, g_ip_prof_self.get(top) + 1);
    var i: i64 = n - 1;
    while i >= 0 {
        var r: i64 = interp_prof_row(stack.get(i));
        if g_ip_prof_stamp.get(r) != g_ip_prof_n {
            g_ip_prof_stamp.set(r, g_ip_prof_n);
            g_ip_prof_total.set(r, g_ip_prof_total.get(r) + 1);
        }
        i = i - 1;
    }
}

/// p_prof_samples(name): the samples with `name` on the stack.
fn interp_prof_total_of(name: str) -> i64 {
    if g_ip_prof_idx == 0 || !HashMap_contains(g_ip_prof_idx, name) {
        return 0;
    }
    return g_ip_prof_total.get(HashMap_get(g_ip_prof_idx, name) - 1);
}

/// v right-aligned in `width` columns.
fn interp_prof_num(v: i64, width: i64) -> str {
    var s: str = int_to_str(v);
    while str_len(s) < width {
        s = " " + s;
    }
    return s;
}

/// v of n as a percentage with one decimal, in 8 columns.
fn interp_prof_pct(v: i64, n: i64) -> str {
    var p: i64 = v * 1000 / n;
    return interp_prof_num(p / 10, 6) + "." + int_to_str(p % 10);
}

/// p_prof_report(): the table so far on stderr, most self first, at most
/// 40 lines.
fn interp_prof_print() {
    var n: i64 = g_ip_prof_n;
    var out: str = "profile (counting calls): " + int_to_str(n) + " samples, one per call\n";
    var rows: i64 = g_ip_prof_names.len();
    if n > 0 && rows > 0 {
        out = out + "   self%     self  total%    total  function\n";
        var shown: Vec<bool> = Vec::new();
        var i: i64 = 0;
        while i < rows {
            shown.push(false);
            i = i + 1;
        }
        var row: i64 = 0;
        while row < 40 && row < rows {
            var best: i64 = 0 - 1;
            var b: i64 = 0;
            while b < rows {
                if !shown.get(b) {
                    if best < 0 || g_ip_prof_self.get(b) > g_ip_prof_self.get(best) || (g_ip_prof_self.get(b) == g_ip_prof_self.get(best) && g_ip_prof_total.get(b) > g_ip_prof_total.get(best)) {
                        best = b;
                    }
                }
                b = b + 1;
            }
            shown.set(best, true);
            var s: i64 = g_ip_prof_self.get(best);
            var t: i64 = g_ip_prof_total.get(best);
            out = out + interp_prof_pct(s, n) + interp_prof_num(s, 9) + interp_prof_pct(t, n) + interp_prof_num(t, 9) + "  " + g_ip_prof_names.get(best) + "\n";
            row = row + 1;
        }
    }
    p_eprint_str(out);
}

// ===========================================================================
// call_runtime -- dispatch runtime builtin functions
// ===========================================================================
//
// This implements the essential runtime builtins needed for basic
// program execution: printing, panics, allocation, string operations,
// vectors, maps, and numeric conversions.
// Advanced builtins (tensors, networking, threads, etc.) return defaults.

pub fn Interpreter_call_runtime(self: &mut Interpreter, name: str, args: &mut Vec<Value>) -> ExecOutcome {
    // A builtin whose capability was revoked at run time is not run (a
    // direct call, a call through a function value or pointer alike)
    if self.revoked_caps.len() > 0 {
        var denied: str = Interpreter_cap_denied(self, name);
        if str_len(denied) > 0 {
            return interp_sandbox_panic(name, denied);
        }
    }
    // CT7: under `fid run --record` an effect call is made and logged;
    // under `fid replay` it is answered from the trace, not made
    if g_rr_mode != 0 {
        if interp_rr_effect(name) {
            return Interpreter_rr_call(self, name, args);
        }
        if name == "p_exit" {
            interp_rr_exiting(arg_int(args, 0, 0));
        }
    }
    if name == "p_read_line" || name == "p_read_stdin" {
        return interp_read_input(name, args);
    }
    // A raw Vec handle may arrive as a Ptr (loaded from a by-value struct
    // copy's Vec field): the p_vec_* builtins take its address.
    if str_starts_with(name, "p_vec_") && args.len() > 0 {
        match args.get(0) {
            Value::Ptr(vp) => {
                args.set(0, Value::Int(vp));
            }
            _ => {
            }
        }
    }
    var tout: ExecOutcome = Interpreter_call_tensor(self, name, args);
    if !outcome_is_unhandled(tout) {
        return tout;
    }
    // ─── Printing ───
    if name == "p_print_int" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(i) => {
                    p_print_int(i);
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_print_float" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Float(f) => {
                    p_print_str(interp_f64_text(f));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_print_bool" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Bool(b) => {
                    p_print_bool(b);
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_print_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Str(s) => {
                    p_print_str(s);
                }
                Value::Ptr(addr) => {
                    var loaded: str = Memory_load_cstr(&self.memory, addr);
                    p_print_str(loaded);
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_eprint_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Str(s) => {
                    p_eprint_str(s);
                }
                Value::Ptr(addr) => {
                    var loaded: str = Memory_load_cstr(&self.memory, addr);
                    p_eprint_str(loaded);
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_print_newline" {
        p_print_str("\n");
        return ExecOutcome::Value(Value::Void);
    }
    if name == "print" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Ptr(addr) => {
                    p_print_str(Memory_load_cstr(&self.memory, addr));
                }
                Value::Vec(pvh) => {
                    p_print_str(Interpreter_display_vec_quoted(self, pvh));
                }
                Value::Void => {
                    p_print_str("Void");
                }
                _ => {
                    p_print_str(Interpreter_display_value(self, args.get(0)));
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Panic ───
    if name == "p_panic" {
        var msg: str = "panic";
        if args.len() > 0 {
            msg = Interpreter_value_to_string(self, args.get(0));
        }
        return ExecOutcome::Panic(msg);
    }

    // ─── Allocation ───
    if name == "p_alloc" || name == "p_malloc" {
        var size: i64 = 0;
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(s) => {
                    if s < 1 {
                        size = 1;
                    } else {
                        size = s;
                    }
                }
                _ => {
                }
            }
        }
        var addr: i64 = Memory_alloc(&mut self.memory, size);
        if addr == 0 {
            // as the native p_malloc fails, not by growing the host's memory
            // until it cannot (stdlib-agent-bugs 20, 51, 52)
            return ExecOutcome::Panic("p_malloc: OOM allocating " + int_to_str(size) + " bytes (the interpreter holds at most " + int_to_str(INTERP_MEM_LIMIT) + ")");
        }
        return ExecOutcome::Value(Value::Ptr(addr));
    }
    if name == "p_free" {
        // Strings and Vecs are managed values here, not blocks
        var addr: i64 = 0;
        if args.len() > 0 {
            match args.get(0) {
                Value::Ptr(a) => {
                    addr = a;
                }
                Value::Int(a) => {
                    addr = a;
                }
                _ => {
                }
            }
        }
        if addr != 0 {
            // the block is reused (Memory_alloc), so what the side tables
            // know about it goes too
            var msg: str = Interpreter_free_block(self, addr);
            if str_len(msg) > 0 {
                return ExecOutcome::Panic(msg);
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_region_free" {
        return ExecOutcome::Value(Value::Void);
    }
    // Regions freed in one step (proposal 0005): no arenas here, so no
    // region is ever open and core's region checks fall through
    if name == "p_region_word" {
        return ExecOutcome::Value(Value::Int(0));
    }
    // No arenas here (freed blocks go back one at a time), so a mark has
    // nothing to restore.
    if name == "p_arena_save" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_arena_restore" {
        return ExecOutcome::Value(Value::Void);
    }

    // ─── String Operations ───
    if name == "p_str_concat" {
        var left: str = "";
        var right: str = "";
        if args.len() > 0 {
            left = Interpreter_value_to_string(self, args.get(0));
        }
        if args.len() > 1 {
            right = Interpreter_value_to_string(self, args.get(1));
        }
        return ExecOutcome::Value(Value::Str(left + right));
    }
    // SL15: the profiler a program drives (stdlib/profiler.fd prof_*). The
    // interpreter has no sampler: it counts calls (interp_prof_count)
    if name == "p_prof_start" {
        interp_prof_reset();
        g_ip_prof_on = true;
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_prof_stop" {
        g_ip_prof_on = false;
        return ExecOutcome::Value(Value::Int(g_ip_prof_n));
    }
    if name == "p_prof_report" {
        interp_prof_print();
        return ExecOutcome::Value(Value::Int(g_ip_prof_n));
    }
    if name == "p_prof_samples" {
        var pname: str = "";
        if args.len() > 0 {
            pname = Interpreter_value_to_string(self, args.get(0));
        }
        return ExecOutcome::Value(Value::Int(interp_prof_total_of(pname)));
    }
    // Signals within the process (stdlib/signal.fd): registered and pending
    // flags per signal number (< 64)
    if name == "p_signal_register" || name == "p_signal_raise" || name == "p_signal_check" {
        var sn: i64 = arg_int(args, args.len() - 1, 0);
        if sn < 0 || sn >= 64 {
            return ExecOutcome::Value(Value::Int(-1));
        }
        var bit: i64 = 1 << sn;
        if name == "p_signal_register" {
            g_interp_sig_registered = g_interp_sig_registered | bit;
            return ExecOutcome::Value(Value::Int(0));
        }
        if name == "p_signal_raise" {
            if (g_interp_sig_registered & bit) != 0 {
                g_interp_sig_pending = g_interp_sig_pending | bit;
            }
            return ExecOutcome::Value(Value::Int(0));
        }
        var was: i64 = 0;
        if (g_interp_sig_pending & bit) != 0 {
            was = 1;
        }
        g_interp_sig_pending = g_interp_sig_pending & (~bit);
        return ExecOutcome::Value(Value::Int(was));
    }
    if name == "p_str_append" {
        var al: str = "";
        var ar: str = "";
        if args.len() >= 2 {
            al = Interpreter_value_to_string(self, args.get(args.len() - 2));
            ar = Interpreter_value_to_string(self, args.get(args.len() - 1));
        }
        return ExecOutcome::Value(Value::Str(al + ar));
    }
    // `s + int_to_str(n)` fused by the lowering (core's p_str_concat_int):
    // on the interpreter's own strings, as p_str_concat
    if name == "p_str_concat_int" {
        var cl: str = "";
        var cn: i64 = 0;
        if args.len() >= 2 {
            cl = Interpreter_value_to_string(self, args.get(args.len() - 2));
            match args.get(args.len() - 1) {
                Value::Int(ci) => {
                    cn = ci;
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Str(cl + int_to_str(cn)));
    }
    if name == "p_to_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(ti) => {
                    return ExecOutcome::Value(Value::Str(int_to_str(ti)));
                }
                Value::Float(tf) => {
                    return ExecOutcome::Value(Value::Str(interp_f64_text(tf)));
                }
                Value::Bool(tb) => {
                    if tb {
                        return ExecOutcome::Value(Value::Str("true"));
                    }
                    return ExecOutcome::Value(Value::Str("false"));
                }
                Value::Str(ts) => {
                    return ExecOutcome::Value(Value::Str(ts));
                }
                Value::Vec(tvh) => {
                    return ExecOutcome::Value(Value::Str(Interpreter_display_vec_quoted(self, tvh)));
                }
                Value::Map(_) => {
                    return ExecOutcome::Value(Value::Str(Interpreter_display_value(self, args.get(0))));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_char_to_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(i) => {
                    return ExecOutcome::Value(Value::Str(p_char_to_str(i)));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_float_to_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Float(f) => {
                    return ExecOutcome::Value(Value::Str(interp_f64_text(f)));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_str_to_float" {
        if args.len() > 0 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            return ExecOutcome::Value(Value::Float(p_str_to_float(s)));
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "p_str_to_int" {
        if args.len() > 0 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            return ExecOutcome::Value(Value::Int(p_str_to_int(s)));
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_str_len" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Str(s) => {
                    return ExecOutcome::Value(Value::Int(str_len(s)));
                }
                Value::Ptr(addr) => {
                    var loaded: str = Memory_load_cstr(&self.memory, addr);
                    return ExecOutcome::Value(Value::Int(str_len(loaded)));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_str_equal" {
        // p_str_equal(a, b, n) — compare n bytes
        if args.len() >= 3 {
            var a_str: str = Interpreter_value_to_string(self, args.get(0));
            var b_str: str = Interpreter_value_to_string(self, args.get(1));
            match args.get(2) {
                Value::Int(n) => {
                    if n >= str_len(a_str) && n >= str_len(b_str) {
                        return ExecOutcome::Value(Value::Bool(a_str == b_str));
                    }
                    // Compare first n characters
                    var i: i64 = 0;
                    while i < n {
                        var ac: i64 = 0;
                        var bc: i64 = 0;
                        if i < str_len(a_str) {
                            var ap: i64 = a_str + i;
                            var aptr: *mut u8 = ap;
                            unsafe {
                                ac = *aptr;
                            }
                        }
                        if i < str_len(b_str) {
                            var bp: i64 = b_str + i;
                            var bptr: *mut u8 = bp;
                            unsafe {
                                bc = *bptr;
                            }
                        }
                        if ac != bc {
                            return ExecOutcome::Value(Value::Bool(false));
                        }
                        i = i + 1;
                    }
                    return ExecOutcome::Value(Value::Bool(true));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_str_cmp" {
        if args.len() >= 2 {
            var a_str2: str = Interpreter_value_to_string(self, args.get(0));
            var b_str2: str = Interpreter_value_to_string(self, args.get(1));
            if a_str2 == b_str2 {
                return ExecOutcome::Value(Value::Int(0));
            }
            // Simplified: return 1 if a > b, -1 if a < b
            return ExecOutcome::Value(Value::Int(1));
        }
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── Vec Operations ───
    // p_vec_new() -> returns a raw Fides Vec struct (24 bytes: data, len, cap)
    // The interpreter allocates this in simulated memory and tracks it.
    if name == "p_vec_new" {
        // Allocate 24 bytes for the Vec struct {data: i64, len: i64, cap: i64}
        var vec_addr: i64 = Memory_alloc(&mut self.memory, 40);
        // Initialize: data=0, len=0, cap=0, element code 0 (a word, D14),
        // element type 0 (plain values, proposal 0004)
        Memory_store_i64(&mut self.memory, vec_addr, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 8, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 16, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 24, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 32, 0);
        // Also create a side-table entry for interpreter-level Vec operations
        var handle: i64 = self.vec_values.len();
        self.vec_values.push(VecValueEntry_new(handle));
        self.vec_side_table.push(VecSideEntry_new(vec_addr, handle));
        // known by address to the side table: never reused
        I64Table_set(&mut self.memory.blocks, vec_addr, Value::Int(1));
        return ExecOutcome::Value(Value::Int(vec_addr));
    }
    if name == "p_vec_push" {
        // p_vec_push(vec_addr, elem) — elem is an i64 (raw value)
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var elem: i64 = Interpreter_value_word(self, args.get(1));
                    // Read current len and cap
                    var len: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    var cap: i64 = Memory_load_i64(&self.memory, vec_addr + 16);
                    var data: i64 = Memory_load_i64(&self.memory, vec_addr);
                    // Grow if needed
                    if len >= cap {
                        var new_cap: i64 = 8;
                        if cap > 0 {
                            new_cap = cap * 2;
                        }
                        var pcode: i64 = Memory_load_i64(&self.memory, vec_addr + 24);
                        var new_data: i64 = Memory_alloc(&mut self.memory, new_cap * interp_vec_esz(pcode));
                        // Copy old data
                        var ci: i64 = 0;
                        while ci < len {
                            var v: i64 = interp_vec_ld(&self.memory, data, ci, pcode);
                            interp_vec_st(&mut self.memory, new_data, ci, pcode, v);
                            ci = ci + 1;
                        }
                        data = new_data;
                        cap = new_cap;
                        Memory_store_i64(&mut self.memory, vec_addr, data);
                        Memory_store_i64(&mut self.memory, vec_addr + 16, cap);
                    }
                    // Store element (at its size, D14)
                    interp_vec_st(&mut self.memory, data, len, Memory_load_i64(&self.memory, vec_addr + 24), elem);
                    len = len + 1;
                    Memory_store_i64(&mut self.memory, vec_addr + 8, len);
                    return ExecOutcome::Value(Value::Void);
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_get" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    match args.get(1) {
                        Value::Int(idx) => {
                            var len: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                            if idx < 0 || idx >= len {
                                return ExecOutcome::Panic("Vec index out of bounds");
                            }
                            var data: i64 = Memory_load_i64(&self.memory, vec_addr);
                            var elem: i64 = interp_vec_ld(&self.memory, data, idx, Memory_load_i64(&self.memory, vec_addr + 24));
                            return ExecOutcome::Value(Value::Int(elem));
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_vec_set" {
        if args.len() >= 3 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    match args.get(1) {
                        Value::Int(idx) => {
                            var elem2: i64 = Interpreter_value_word(self, args.get(2));
                            var len2: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                            if idx < 0 || idx >= len2 {
                                return ExecOutcome::Panic("Vec index out of bounds");
                            }
                            var data2: i64 = Memory_load_i64(&self.memory, vec_addr);
                            interp_vec_st(&mut self.memory, data2, idx, Memory_load_i64(&self.memory, vec_addr + 24), elem2);
                            return ExecOutcome::Value(Value::Void);
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_len" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var len3: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    return ExecOutcome::Value(Value::Int(len3));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_vec_is_empty" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var len4: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    return ExecOutcome::Value(Value::Bool(len4 == 0));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Bool(true));
    }
    if name == "p_vec_pop" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var len5: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    if len5 == 0 {
                        return ExecOutcome::Panic("Vec is empty");
                    }
                    var data5: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var elem5: i64 = interp_vec_ld(&self.memory, data5, len5 - 1, Memory_load_i64(&self.memory, vec_addr + 24));
                    len5 = len5 - 1;
                    Memory_store_i64(&mut self.memory, vec_addr + 8, len5);
                    return ExecOutcome::Value(Value::Int(elem5));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_vec_clear" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    Memory_store_i64(&mut self.memory, vec_addr + 8, 0);
                    return ExecOutcome::Value(Value::Void);
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Map Operations (simplified) ───
    if name == "p_map_new" {
        // Allocate a HashMap struct (simplified: 32 bytes)
        var map_addr: i64 = Memory_alloc(&mut self.memory, 32);
        Memory_store_i64(&mut self.memory, map_addr, 0);
        // keys ptr
        Memory_store_i64(&mut self.memory, map_addr + 8, 0);
        // vals ptr
        Memory_store_i64(&mut self.memory, map_addr + 16, 0);
        // len
        Memory_store_i64(&mut self.memory, map_addr + 24, 0);
        // cap
        return ExecOutcome::Value(Value::Int(map_addr));
    }
    if name == "p_map_insert" {
        // p_map_insert(map_addr, key, value) — simplified linear scan
        // For now, just return void (full implementation would use
        // a side-table for key-value pairs)
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_map_get" || name == "p_map_get_or" {
        // Simplified: return 0 if not found
        if name == "p_map_get_or" && args.len() >= 3 {
            return ExecOutcome::Value(args.get(2));
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_map_contains" {
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_map_len" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_map_is_empty" {
        return ExecOutcome::Value(Value::Bool(true));
    }
    if name == "p_map_clear" {
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Volatile memory access: the interpreter's byte memory ───
    if str_starts_with(name, "p_volatile_") {
        var va: i64 = -1;
        match args.get(0) {
            Value::Int(vn) => {
                va = vn;
            }
            _ => {
            }
        }
        var vval: i64 = 0;
        var vval_ok: bool = false;
        if args.len() > 1 {
            match args.get(1) {
                Value::Int(vv) => {
                    vval = vv;
                    vval_ok = true;
                }
                _ => {
                }
            }
        }
        var width: i64 = 8;
        if str_ends_with(name, "8") {
            width = 1;
        }
        if str_ends_with(name, "16") {
            width = 2;
        }
        if str_ends_with(name, "32") {
            width = 4;
        }
        var is_load: bool = str_starts_with(name, "p_volatile_load");
        var in_range: bool = va >= 0 && Memory_is_valid_addr(&self.memory, va) && Memory_is_valid_addr(&self.memory, va + width - 1);
        if is_load {
            if in_range {
                if width == 1 {
                    return ExecOutcome::Value(Value::Int(Memory_load_byte(&self.memory, va)));
                }
                if width == 8 {
                    return ExecOutcome::Value(Value::Int(Memory_load_i64(&self.memory, va)));
                }
                return ExecOutcome::Value(Value::Int(Memory_load_i32(&self.memory, va)));
            }
            return ExecOutcome::Value(Value::Int(0));
        }
        if in_range && vval_ok {
            if width == 1 {
                Memory_store_byte(&mut self.memory, va, vval & 0xFF);
            } else if width == 8 {
                Memory_store_i64(&mut self.memory, va, vval);
            } else {
                Memory_store_i32(&mut self.memory, va, vval);
            }
        }
        return ExecOutcome::Value(Value::Void);
    }

    // ─── String builder (p_sb_*): handles index sb_strs (from 1) ───
    if name == "p_sb_new" {
        self.sb_strs.push("");
        return ExecOutcome::Value(Value::Int(self.sb_strs.len()));
    }
    if name == "p_sb_append" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(sbh) => {
                    if sbh >= 1 && sbh <= self.sb_strs.len() {
                        var piece: str = Interpreter_value_to_string(self, args.get(1));
                        self.sb_strs.set(sbh - 1, self.sb_strs.get(sbh - 1) + piece);
                    }
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Continue;
    }
    if name == "p_sb_to_str" || name == "p_sb_len" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(sbh2) => {
                    if sbh2 >= 1 && sbh2 <= self.sb_strs.len() {
                        if name == "p_sb_len" {
                            return ExecOutcome::Value(Value::Int(str_len(self.sb_strs.get(sbh2 - 1))));
                        }
                        return ExecOutcome::Value(Value::Str(self.sb_strs.get(sbh2 - 1)));
                    }
                }
                _ => {
                }
            }
        }
        if name == "p_sb_len" {
            return ExecOutcome::Value(Value::Int(0));
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_sb_free" {
        return ExecOutcome::Continue;
    }

    // ─── PRNG (xorshift128+) for DP noise ───
    if name == "p_prng_next" {
        // xorshift128+ — returns a u64 value as i64
        var a: u64 = self.prng_state_a;
        var b: u64 = self.prng_state_b;
        a = a ^ (a << 23);
        a = a ^ (a >> 17);
        a = a ^ b;
        a = a ^ (b >> 26);
        self.prng_state_a = b;
        self.prng_state_b = a;
        return ExecOutcome::Value(Value::Int(a as i64));
    }
    if name == "p_prng_uniform" {
        // Returns a uniform random f64 in [0, 1)
        var a: u64 = self.prng_state_a;
        var b: u64 = self.prng_state_b;
        a = a ^ (a << 23);
        a = a ^ (a >> 17);
        a = a ^ b;
        a = a ^ (b >> 26);
        self.prng_state_a = b;
        self.prng_state_b = a;
        // Use upper 53 bits for mantissa
        var bits: i64 = (a >> 11) as i64;
        var result: f64 = (bits as f64) / (9007199254740992.0);
        return ExecOutcome::Value(Value::Float(result));
    }
    if name == "p_prng_gaussian" {
        // Box-Muller transform: generates a standard normal random f64
        var a: u64 = self.prng_state_a;
        var b: u64 = self.prng_state_b;
        a = a ^ (a << 23);
        a = a ^ (a >> 17);
        a = a ^ b;
        a = a ^ (b >> 26);
        self.prng_state_a = b;
        self.prng_state_b = a;
        var bits1: i64 = (a >> 11) as i64;
        var u1: f64 = (bits1 as f64) / (9007199254740992.0);
        if u1 < 0.0000001 {
            u1 = 0.0000001;
        }

        a = self.prng_state_a;
        b = self.prng_state_b;
        a = a ^ (a << 23);
        a = a ^ (a >> 17);
        a = a ^ b;
        a = a ^ (b >> 26);
        self.prng_state_a = b;
        self.prng_state_b = a;
        var bits2: i64 = (a >> 11) as i64;
        var u2: f64 = (bits2 as f64) / (9007199254740992.0);

        // Box-Muller: sqrt(-2 * ln(u1)) * cos(2 * pi * u2)
        // We don't have ln/cos in the interpreter, so use a simple
        // approximation: sum of 12 uniforms (Central Limit Theorem)
        var sum: f64 = u1 + u2;
        var i: i64 = 0;
        while i < 10 {
            a = self.prng_state_a;
            b = self.prng_state_b;
            a = a ^ (a << 23);
            a = a ^ (a >> 17);
            a = a ^ b;
            a = a ^ (b >> 26);
            self.prng_state_a = b;
            self.prng_state_b = a;
            var bits3: i64 = (a >> 11) as i64;
            sum = sum + (bits3 as f64) / (9007199254740992.0);
            i = i + 1;
        }
        // Approximate Gaussian: (sum - 6) gives mean 0, variance ~1
        var gaussian: f64 = sum - 6.0;
        return ExecOutcome::Value(Value::Float(gaussian));
    }

    // ─── DP noise functions (use PRNG, not deterministic formulas) ───
    if name == "p_dp_noise" {
        // p_dp_noise(epsilon, sensitivity, value) -> noisy value
        if args.len() >= 3 {
            match args.get(0) {
                Value::Float(epsilon) => {
                    match args.get(1) {
                        Value::Float(sensitivity) => {
                            match args.get(2) {
                                Value::Float(v) => {
                                    // Generate Gaussian noise with sigma = sensitivity / epsilon
                                    var sigma: f64 = sensitivity / epsilon;
                                    // Use CLT approximation for Gaussian
                                    var sum: f64 = 0.0;
                                    var i: i64 = 0;
                                    while i < 12 {
                                        var a: u64 = self.prng_state_a;
                                        var b: u64 = self.prng_state_b;
                                        a = a ^ (a << 23);
                                        a = a ^ (a >> 17);
                                        a = a ^ b;
                                        a = a ^ (b >> 26);
                                        self.prng_state_a = b;
                                        self.prng_state_b = a;
                                        var bits: i64 = (a >> 11) as i64;
                                        sum = sum + (bits as f64) / (9007199254740992.0);
                                        i = i + 1;
                                    }
                                    var noise: f64 = (sum - 6.0) * sigma;
                                    return ExecOutcome::Value(Value::Float(v + noise));
                                }
                                _ => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "p_gaussian_noise" {
        // p_gaussian_noise(sigma, value) -> noisy value
        if args.len() >= 2 {
            match args.get(0) {
                Value::Float(sigma) => {
                    match args.get(1) {
                        Value::Float(v) => {
                            var sum: f64 = 0.0;
                            var i: i64 = 0;
                            while i < 12 {
                                var a: u64 = self.prng_state_a;
                                var b: u64 = self.prng_state_b;
                                a = a ^ (a << 23);
                                a = a ^ (a >> 17);
                                a = a ^ b;
                                a = a ^ (b >> 26);
                                self.prng_state_a = b;
                                self.prng_state_b = a;
                                var bits: i64 = (a >> 11) as i64;
                                sum = sum + (bits as f64) / (9007199254740992.0);
                                i = i + 1;
                            }
                            var noise: f64 = (sum - 6.0) * sigma;
                            return ExecOutcome::Value(Value::Float(v + noise));
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "p_dropout" {
        // p_dropout(prob, value) -> value * 0 with probability prob, else value
        if args.len() >= 2 {
            match args.get(0) {
                Value::Float(prob) => {
                    match args.get(1) {
                        Value::Float(v) => {
                            var a: u64 = self.prng_state_a;
                            var b: u64 = self.prng_state_b;
                            a = a ^ (a << 23);
                            a = a ^ (a >> 17);
                            a = a ^ b;
                            a = a ^ (b >> 26);
                            self.prng_state_a = b;
                            self.prng_state_b = a;
                            var bits: i64 = (a >> 11) as i64;
                            var r: f64 = (bits as f64) / (9007199254740992.0);
                            if r < prob {
                                return ExecOutcome::Value(Value::Float(0.0));
                            }
                            return ExecOutcome::Value(Value::Float(v));
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "p_dp_budget_check" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Float(epsilon) => {
                    match args.get(1) {
                        Value::Float(limit) => {
                            self.dp_epsilon_budget = self.dp_epsilon_budget + epsilon;
                            if self.dp_epsilon_budget > limit {
                                return ExecOutcome::Panic("DP budget exhausted: consumed " + interp_f64_text(self.dp_epsilon_budget) + " > limit " + interp_f64_text(limit));
                            }
                            return ExecOutcome::Value(Value::Void);
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Panic("dp_budget_check: expected (f64, f64)");
    }
    if name == "p_dp_budget_reset" {
        self.dp_epsilon_budget = 0.0;
        if args.len() >= 1 {
            match args.get(0) {
                Value::Float(limit) => {
                    self.dp_epsilon_limit = limit;
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Green threads (cooperative scheduler) ───
    // p_gt_spawn(func_name: *u8, arg: i64) queues a READY thread.
    // p_gt_run_all() resolves each queued thread's func_name and executes it
    // eagerly (interpreter is single-threaded — cooperative ordering, eager
    // bodies). is_done/get_result reflect the scheduler's real state.
    if name == "p_gt_spawn" {
        if args.len() < 2 {
            return ExecOutcome::Value(Value::Int(-1));
        }
        var func_name: str = "";
        match args.get(0) {
            Value::Str(s) => {
                func_name = s;
            }
            Value::Ptr(a) => {
                func_name = Memory_load_cstr(&self.memory, a);
            }
            _ => {
            }
        }
        var arg_val: i64 = 0;
        match args.get(1) {
            Value::Int(n) => {
                arg_val = n;
            }
            _ => {
            }
        }
        var gt_args: Vec<i64> = Vec::new();
        gt_args.push(arg_val);
        var id: i64 = GreenThreadScheduler_spawn(&mut self.gt_scheduler, func_name, gt_args);
        return ExecOutcome::Value(Value::Int(id));
    }
    if name == "p_gt_yield" {
        GreenThreadScheduler_yield_current(&mut self.gt_scheduler);
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_gt_run_all" {
        var last_result: i64 = 0;
        var gi: i64 = 0;
        while gi < self.gt_scheduler.next_id {
            var gt: GreenThread = self.gt_scheduler.threads.get(gi);
            if gt.active && (gt.state == GT_READY || gt.state == GT_SUSPENDED) {
                gt.state = GT_RUNNING;
                self.gt_scheduler.current = gi;
                self.gt_scheduler.threads.set(gi, gt);
                var gt_vals: Vec<Value> = Vec::new();
                gt_vals.push(Value::Int(0));
                // dummy __env
                var gai: i64 = 0;
                while gai < gt.args.len() {
                    gt_vals.push(Value::Int(gt.args.get(gai)));
                    gai = gai + 1;
                }
                var gt_result: Value = Value::Int(0);
                match Interpreter_get_function(self, gt.func_name) {
                    OptIrFunction::Some(gfunc) => {
                        match Interpreter_run_function(self, gfunc, gt_vals) {
                            RunResult::Return(gv) => {
                                gt_result = gv;
                            }
                            RunResult::Panic(gmsg) => {
                                p_eprint_str("Green thread panic: " + gmsg + "\n");
                            }
                            RunResult::Paused => {
                            }
                        }
                    }
                    OptIrFunction::None => {
                        p_eprint_str("Green thread: unknown function '" + gt.func_name + "'\n");
                    }
                }
                match gt_result {
                    Value::Int(gn) => {
                        gt.result = gn;
                    }
                    Value::Bool(gb) => {
                        if gb {
                            gt.result = 1;
                        }
                    }
                    Value::Ptr(gp) => {
                        gt.result = gp;
                    }
                    _ => {
                    }
                }
                gt.state = GT_DONE;
                self.gt_scheduler.current = -1;
                self.gt_scheduler.threads.set(gi, gt);
                last_result = gt.result;
            }
            gi = gi + 1;
        }
        return ExecOutcome::Value(Value::Int(last_result));
    }
    if name == "p_gt_is_done" {
        if args.len() < 1 {
            return ExecOutcome::Value(Value::Bool(false));
        }
        var id: i64 = 0;
        match args.get(0) {
            Value::Int(n) => {
                id = n;
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Bool(GreenThreadScheduler_is_done(&self.gt_scheduler, id)));
    }
    if name == "p_gt_get_result" {
        if args.len() < 1 {
            return ExecOutcome::Value(Value::Int(0));
        }
        var id: i64 = 0;
        match args.get(0) {
            Value::Int(n) => {
                id = n;
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Int(GreenThreadScheduler_get_result(&self.gt_scheduler, id)));
    }
    if name == "p_gt_current" {
        return ExecOutcome::Value(Value::Int(GreenThreadScheduler_current_thread(&self.gt_scheduler)));
    }
    if name == "p_gt_reset" {
        self.gt_scheduler = GreenThreadScheduler_new();
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Autograd (ML3) ───
    if name == "p_grad_get" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_grad_zero" {
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Tensor builtins (Phase 5C.1) — wired to compiler::tensor ───
    // Value::Ptr(addr) stands in for Rust's Value::Tensor (see file header).
    if name == "p_tensor_zeros" {
        match Interpreter_arg_to_vec_i64(self, args.get(0)) {
            OptVecI64::Some(shape) => {
                return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_zeros(shape)));
            }
            _ => {
                return ExecOutcome::Panic("tensor_zeros: expected Vec");
            }
        }
    }
    if name == "p_tensor_ones" {
        match Interpreter_arg_to_vec_i64(self, args.get(0)) {
            OptVecI64::Some(shape) => {
                return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_ones(shape)));
            }
            _ => {
                return ExecOutcome::Panic("tensor_ones: expected Vec");
            }
        }
    }
    if name == "p_tensor_filled" {
        var fill: f64 = 0.0;
        var fill_ok: bool = false;
        match args.get(1) {
            Value::Float(f) => {
                fill = f;
                fill_ok = true;
            }
            _ => {
            }
        }
        match Interpreter_arg_to_vec_i64(self, args.get(0)) {
            OptVecI64::Some(shape) => {
                if fill_ok {
                    return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_filled(shape, fill)));
                }
                return ExecOutcome::Panic("tensor_filled: expected Vec, f64");
            }
            _ => {
                return ExecOutcome::Panic("tensor_filled: expected Vec, f64");
            }
        }
    }
    if name == "p_tensor_get" {
        var th: i64 = Interpreter_tensor_handle(self, args.get(0));
        var idx_opt: OptVecI64 = Interpreter_arg_to_vec_i64(self, args.get(1));
        if th < 0 {
            return ExecOutcome::Panic("tensor_get: expected Tensor, Vec");
        }
        match idx_opt {
            OptVecI64::Some(idx) => {
                return ExecOutcome::Value(Value::Float(Tensor_get(&self.tensors.get(th), idx)));
            }
            _ => {
                return ExecOutcome::Panic("tensor_get: expected Tensor, Vec");
            }
        }
    }
    if name == "p_tensor_set" {
        var th2: i64 = Interpreter_tensor_handle(self, args.get(0));
        var idx_opt2: OptVecI64 = Interpreter_arg_to_vec_i64(self, args.get(1));
        var setv: f64 = 0.0;
        var setv_ok: bool = false;
        match args.get(2) {
            Value::Float(f2) => {
                setv = f2;
                setv_ok = true;
            }
            _ => {
            }
        }
        if th2 < 0 || !setv_ok {
            return ExecOutcome::Panic("tensor_set: expected Tensor, Vec, f64");
        }
        match idx_opt2 {
            OptVecI64::Some(idx2) => {
                var tm: TensorData = self.tensors.get(th2);
                Tensor_set(&mut tm, idx2, setv);
                self.tensors.set(th2, tm);
                return ExecOutcome::Value(Value::Void);
            }
            _ => {
                return ExecOutcome::Panic("tensor_set: expected Tensor, Vec, f64");
            }
        }
    }
    if name == "p_tensor_shape" {
        var th3: i64 = Interpreter_tensor_handle(self, args.get(0));
        if th3 < 0 {
            return ExecOutcome::Panic("tensor_shape: expected Tensor");
        }
        var tsh: TensorData = self.tensors.get(th3);
        var shlen: i64 = tsh.shape.len();
        var struct_addr: i64 = Memory_alloc(&mut self.memory, 32);
        Memory_store_i64(&mut self.memory, struct_addr + 24, 0);
        var data_addr: i64 = 0;
        if shlen > 0 {
            data_addr = Memory_alloc(&mut self.memory, shlen * 8);
            var si: i64 = 0;
            while si < shlen {
                Memory_store_i64(&mut self.memory, data_addr + si * 8, tsh.shape.get(si));
                si = si + 1;
            }
        }
        Memory_store_i64(&mut self.memory, struct_addr, data_addr);
        Memory_store_i64(&mut self.memory, struct_addr + 8, shlen);
        Memory_store_i64(&mut self.memory, struct_addr + 16, shlen);
        return ExecOutcome::Value(Value::Int(struct_addr));
    }
    if name == "p_tensor_ndim" {
        var th4: i64 = Interpreter_tensor_handle(self, args.get(0));
        if th4 < 0 {
            return ExecOutcome::Panic("tensor_ndim: expected Tensor");
        }
        return ExecOutcome::Value(Value::Int(Tensor_ndim(&self.tensors.get(th4))));
    }
    if name == "p_tensor_size" {
        var th5: i64 = Interpreter_tensor_handle(self, args.get(0));
        if th5 < 0 {
            return ExecOutcome::Panic("tensor_size: expected Tensor");
        }
        return ExecOutcome::Value(Value::Int(Tensor_size(&self.tensors.get(th5))));
    }
    if name == "p_tensor_reshape" {
        var th6: i64 = Interpreter_tensor_handle(self, args.get(0));
        var nshape_opt: OptVecI64 = Interpreter_arg_to_vec_i64(self, args.get(1));
        if th6 < 0 {
            return ExecOutcome::Panic("tensor_reshape: expected Tensor, Vec");
        }
        match nshape_opt {
            OptVecI64::Some(nshape) => {
                match Tensor_reshape(&self.tensors.get(th6), nshape) {
                    ResultTensor::Ok(nt) => {
                        return ExecOutcome::Value(Interpreter_alloc_tensor(self, nt));
                    }
                    ResultTensor::Err(e) => {
                        return ExecOutcome::Panic(e);
                    }
                }
            }
            _ => {
                return ExecOutcome::Panic("tensor_reshape: expected Tensor, Vec");
            }
        }
    }
    if name == "p_tensor_transpose" {
        var th7: i64 = Interpreter_tensor_handle(self, args.get(0));
        if th7 < 0 {
            return ExecOutcome::Panic("tensor_transpose: expected Tensor");
        }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_transpose(&self.tensors.get(th7))));
    }
    if name == "p_tensor_add" {
        var ha1: i64 = Interpreter_tensor_handle(self, args.get(0));
        var hb1: i64 = Interpreter_tensor_handle(self, args.get(1));
        if ha1 < 0 || hb1 < 0 {
            return ExecOutcome::Panic("tensor_add: expected Tensor, Tensor");
        }
        match Tensor_add(&self.tensors.get(ha1), &self.tensors.get(hb1)) {
            ResultTensor::Ok(r) => {
                return ExecOutcome::Value(Interpreter_alloc_tensor(self, r));
            }
            ResultTensor::Err(e2) => {
                return ExecOutcome::Panic(e2);
            }
        }
    }
    if name == "p_tensor_sub" {
        var ha2: i64 = Interpreter_tensor_handle(self, args.get(0));
        var hb2: i64 = Interpreter_tensor_handle(self, args.get(1));
        if ha2 < 0 || hb2 < 0 {
            return ExecOutcome::Panic("tensor_sub: expected Tensor, Tensor");
        }
        match Tensor_sub(&self.tensors.get(ha2), &self.tensors.get(hb2)) {
            ResultTensor::Ok(r2) => {
                return ExecOutcome::Value(Interpreter_alloc_tensor(self, r2));
            }
            ResultTensor::Err(e3) => {
                return ExecOutcome::Panic(e3);
            }
        }
    }
    if name == "p_tensor_mul" {
        var ha3: i64 = Interpreter_tensor_handle(self, args.get(0));
        var hb3: i64 = Interpreter_tensor_handle(self, args.get(1));
        if ha3 < 0 || hb3 < 0 {
            return ExecOutcome::Panic("tensor_mul: expected Tensor, Tensor");
        }
        match Tensor_mul(&self.tensors.get(ha3), &self.tensors.get(hb3)) {
            ResultTensor::Ok(r3) => {
                return ExecOutcome::Value(Interpreter_alloc_tensor(self, r3));
            }
            ResultTensor::Err(e4) => {
                return ExecOutcome::Panic(e4);
            }
        }
    }
    if name == "p_tensor_scale" {
        var th8: i64 = Interpreter_tensor_handle(self, args.get(0));
        var sc: f64 = 0.0;
        var sc_ok: bool = false;
        match args.get(1) {
            Value::Float(f3) => {
                sc = f3;
                sc_ok = true;
            }
            _ => {
            }
        }
        if th8 < 0 || !sc_ok {
            return ExecOutcome::Panic("tensor_scale: expected Tensor, f64");
        }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_scale(&self.tensors.get(th8), sc)));
    }
    if name == "p_tensor_matmul" {
        var ha4: i64 = Interpreter_tensor_handle(self, args.get(0));
        var hb4: i64 = Interpreter_tensor_handle(self, args.get(1));
        if ha4 < 0 || hb4 < 0 {
            return ExecOutcome::Panic("tensor_matmul: expected Tensor, Tensor");
        }
        match Tensor_matmul(&self.tensors.get(ha4), &self.tensors.get(hb4)) {
            ResultTensor::Ok(r4) => {
                return ExecOutcome::Value(Interpreter_alloc_tensor(self, r4));
            }
            ResultTensor::Err(e5) => {
                return ExecOutcome::Panic(e5);
            }
        }
    }
    if name == "p_tensor_dot" {
        var ha5: i64 = Interpreter_tensor_handle(self, args.get(0));
        var hb5: i64 = Interpreter_tensor_handle(self, args.get(1));
        if ha5 < 0 || hb5 < 0 {
            return ExecOutcome::Panic("tensor_dot: expected Tensor, Tensor");
        }
        match Tensor_dot(&self.tensors.get(ha5), &self.tensors.get(hb5)) {
            ResultF64::Ok(r5) => {
                return ExecOutcome::Value(Value::Float(r5));
            }
            ResultF64::Err(e6) => {
                return ExecOutcome::Panic(e6);
            }
        }
    }
    if name == "p_tensor_sum" {
        var th9: i64 = Interpreter_tensor_handle(self, args.get(0));
        if th9 < 0 {
            return ExecOutcome::Panic("tensor_sum: expected Tensor");
        }
        return ExecOutcome::Value(Value::Float(Tensor_sum(&self.tensors.get(th9))));
    }
    if name == "p_tensor_mean" {
        var th10: i64 = Interpreter_tensor_handle(self, args.get(0));
        if th10 < 0 {
            return ExecOutcome::Panic("tensor_mean: expected Tensor");
        }
        return ExecOutcome::Value(Value::Float(Tensor_mean(&self.tensors.get(th10))));
    }
    if name == "p_tensor_max" {
        var th11: i64 = Interpreter_tensor_handle(self, args.get(0));
        if th11 < 0 {
            return ExecOutcome::Panic("tensor_max: expected Tensor");
