            _ => {}
        }
        if th8 < 0 || !sc_ok { return ExecOutcome::Panic("tensor_scale: expected Tensor, f64"); }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_scale(&self.tensors.get(th8), sc)));
