    // ─── Tensor builtins (Phase 5C.1) — wired to compiler::tensor ───
    // Value::Ptr(addr) stands in for Rust's Value::Tensor (see file header).
    if name == "p_tensor_zeros" {
        match Interpreter_arg_to_vec_i64(self, args.get(0)) {
            OptVecI64::Some(shape) => { return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_zeros(shape))); }
            _ => { return ExecOutcome::Panic("tensor_zeros: expected Vec"); }
        }
    }
    if name == "p_tensor_ones" {
        match Interpreter_arg_to_vec_i64(self, args.get(0)) {
            OptVecI64::Some(shape) => { return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_ones(shape))); }
            _ => { return ExecOutcome::Panic("tensor_ones: expected Vec"); }
        }
    }
    if name == "p_tensor_filled" {
        var fill: f64 = 0.0;
        var fill_ok: bool = false;
        match args.get(1) {
            Value::Float(f) => { fill = f; fill_ok = true; }
            _ => {}
        }
        match Interpreter_arg_to_vec_i64(self, args.get(0)) {
            OptVecI64::Some(shape) => {
                if fill_ok { return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_filled(shape, fill))); }
                return ExecOutcome::Panic("tensor_filled: expected Vec, f64");
            }
            _ => { return ExecOutcome::Panic("tensor_filled: expected Vec, f64"); }
        }
    }
    if name == "p_tensor_from_vec" {
        // stdlib calls from_vec(data, shape) — args are (data, shape)
        var data_opt: OptVecF64 = Interpreter_args_to_f64_vec(self, args, 0);
        var shape_opt: OptVecI64 = Interpreter_arg_to_vec_i64(self, args.get(1));
        match data_opt {
            OptVecF64::Some(d) => {
                match shape_opt {
                    OptVecI64::Some(sh) => { return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_from_vec(sh, d))); }
                    _ => { return ExecOutcome::Panic("tensor_from_vec: expected Vec, Vec"); }
                }
            }
            _ => { return ExecOutcome::Panic("tensor_from_vec: expected Vec, Vec"); }
        }
    }
    if name == "p_tensor_get" {
        var th: i64 = Interpreter_tensor_handle(self, args.get(0));
        var idx_opt: OptVecI64 = Interpreter_arg_to_vec_i64(self, args.get(1));
        if th < 0 { return ExecOutcome::Panic("tensor_get: expected Tensor, Vec"); }
        match idx_opt {
            OptVecI64::Some(idx) => { return ExecOutcome::Value(Value::Float(Tensor_get(&self.tensors.get(th), idx))); }
            _ => { return ExecOutcome::Panic("tensor_get: expected Tensor, Vec"); }
        }
    }
    if name == "p_tensor_set" {
        var th2: i64 = Interpreter_tensor_handle(self, args.get(0));
        var idx_opt2: OptVecI64 = Interpreter_arg_to_vec_i64(self, args.get(1));
        var setv: f64 = 0.0;
        var setv_ok: bool = false;
        match args.get(2) {
            Value::Float(f2) => { setv = f2; setv_ok = true; }
            _ => {}
        }
        if th2 < 0 || !setv_ok { return ExecOutcome::Panic("tensor_set: expected Tensor, Vec, f64"); }
        match idx_opt2 {
            OptVecI64::Some(idx2) => {
                var tm: TensorData = self.tensors.get(th2);
                Tensor_set(&mut tm, idx2, setv);
                self.tensors.set(th2, tm);
                return ExecOutcome::Value(Value::Void);
            }
            _ => { return ExecOutcome::Panic("tensor_set: expected Tensor, Vec, f64"); }
        }
    }
    if name == "p_tensor_shape" {
        var th3: i64 = Interpreter_tensor_handle(self, args.get(0));
        if th3 < 0 { return ExecOutcome::Panic("tensor_shape: expected Tensor"); }
        var tsh: TensorData = self.tensors.get(th3);
        var shlen: i64 = tsh.shape.len();
        var struct_addr: i64 = Memory_alloc(&mut self.memory, 24);
        var data_addr: i64 = 0;
        if shlen > 0 {
            data_addr = Memory_alloc(&mut self.memory, shlen * 8);
            var si: i64 = 0;
            while si < shlen {
                Memory_store_i64(&mut self.memory, data_addr + si * 8, tsh.shape.get(si));
                si = si + 1;
            }
        }
        Memory_store_i64(&mut self.memory, struct_addr, data_addr);
        Memory_store_i64(&mut self.memory, struct_addr + 8, shlen);
        Memory_store_i64(&mut self.memory, struct_addr + 16, shlen);
        return ExecOutcome::Value(Value::Int(struct_addr));
    }
    if name == "p_tensor_ndim" {
        var th4: i64 = Interpreter_tensor_handle(self, args.get(0));
        if th4 < 0 { return ExecOutcome::Panic("tensor_ndim: expected Tensor"); }
        return ExecOutcome::Value(Value::Int(Tensor_ndim(&self.tensors.get(th4))));
    }
    if name == "p_tensor_size" {
        var th5: i64 = Interpreter_tensor_handle(self, args.get(0));
        if th5 < 0 { return ExecOutcome::Panic("tensor_size: expected Tensor"); }
        return ExecOutcome::Value(Value::Int(Tensor_size(&self.tensors.get(th5))));
    }
    if name == "p_tensor_reshape" {
        var th6: i64 = Interpreter_tensor_handle(self, args.get(0));
        var nshape_opt: OptVecI64 = Interpreter_arg_to_vec_i64(self, args.get(1));
        if th6 < 0 { return ExecOutcome::Panic("tensor_reshape: expected Tensor, Vec"); }
        match nshape_opt {
            OptVecI64::Some(nshape) => {
                match Tensor_reshape(&self.tensors.get(th6), nshape) {
                    ResultTensor::Ok(nt) => { return ExecOutcome::Value(Interpreter_alloc_tensor(self, nt)); }
                    ResultTensor::Err(e) => { return ExecOutcome::Panic(e); }
                }
            }
            _ => { return ExecOutcome::Panic("tensor_reshape: expected Tensor, Vec"); }
        }
    }
    if name == "p_tensor_transpose" {
