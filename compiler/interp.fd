        var setv: f64 = 0.0;
        var setv_ok: bool = false;
        match args.get(2) {
            Value::Float(f2) => { setv = f2; setv_ok = true; }
            _ => {}
        }
        if th2 < 0 || !setv_ok { return ExecOutcome::Panic("tensor_set: expected Tensor, Vec, f64"); }
        match idx_opt2 {
