        var h_dim: i64 = 0;
        match args.get(0) { Value::Int(a0) => { n_layers = a0; } _ => {} }
        match args.get(1) { Value::Int(a1) => { max_seq = a1; } _ => {} }
        match args.get(2) { Value::Int(a2) => { win_size = a2; } _ => {} }
        match args.get(3) { Value::Int(a3) => { h_dim = a3; } _ => {} }
        var cache_id: i64 = self.kv_caches.len();
