                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Bool(true));
    }
    if name == "p_string_push_str" {
        if args.len() >= 2 {
            var left: str = Interpreter_value_to_string(self, args.get(0));
            var right: str = Interpreter_value_to_string(self, args.get(1));
            return ExecOutcome::Value(Value::Str(left + right));
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_string_to_string" {
        if args.len() > 0 {
            return ExecOutcome::Value(Value::Str(Interpreter_value_to_string(self, args.get(0))));
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    // p_string_substring (stdlib/string.fd) is the C runtime's p_string_slice:
    // start clamped to 0, end to the length, empty when start > end
    if name == "p_string_slice" || name == "p_string_substring" {
        if args.len() >= 3 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            var start: i64 = 0;
            var end: i64 = str_len(s);
            match args.get(1) {
                Value::Int(n) => {
                    start = n;
                }
                _ => {
                }
            }
            match args.get(2) {
                Value::Int(n) => {
                    end = n;
                }
                _ => {
                }
            }
            var slen: i64 = str_len(s);
            if start < 0 {
                start = 0;
            }
            if end > slen {
                end = slen;
            }
            if start > end {
                start = end;
            }
            return ExecOutcome::Value(Value::Str(String_slice(s, start, end)));
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_string_contains" {
        if args.len() >= 2 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            var sub: str = Interpreter_value_to_string(self, args.get(1));
            return ExecOutcome::Value(Value::Bool(str_contains(s, sub)));
        }
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_string_starts_with" {
        if args.len() >= 2 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            var prefix: str = Interpreter_value_to_string(self, args.get(1));
            return ExecOutcome::Value(Value::Bool(str_starts_with(s, prefix)));
        }
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_string_ends_with" {
        if args.len() >= 2 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            var suffix: str = Interpreter_value_to_string(self, args.get(1));
            return ExecOutcome::Value(Value::Bool(str_ends_with(s, suffix)));
        }
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_string_trim" {
        if args.len() > 0 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            return ExecOutcome::Value(Value::Str(str_trim(s)));
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_string_split" {
        if args.len() >= 2 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            var delim: str = Interpreter_value_to_string(self, args.get(1));
            // Create a new vec (same as p_vec_new)
            var vec_addr: i64 = Memory_alloc(&mut self.memory, 40);
            Memory_store_i64(&mut self.memory, vec_addr + 24, 0);
            Memory_store_i64(&mut self.memory, vec_addr + 32, 0);
            Memory_store_i64(&mut self.memory, vec_addr, 0);
            Memory_store_i64(&mut self.memory, vec_addr + 8, 0);
            Memory_store_i64(&mut self.memory, vec_addr + 16, 0);
            // Split the string using str_split helper
            var parts: Vec<str> = str_split(s, delim);
            var pi: i64 = 0;
            while pi < parts.len() {
                var part: str = parts.get(pi);
                // Inline vec push logic
                var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                var vcap: i64 = Memory_load_i64(&self.memory, vec_addr + 16);
                var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                if vlen >= vcap {
                    var new_cap: i64 = 8;
                    if vcap > 0 {
                        new_cap = vcap * 2;
                    }
                    var new_data: i64 = Memory_alloc(&mut self.memory, new_cap * 8);
                    var ci: i64 = 0;
                    while ci < vlen {
                        var v: i64 = Memory_load_i64(&self.memory, vdata + ci * 8);
                        Memory_store_i64(&mut self.memory, new_data + ci * 8, v);
                        ci = ci + 1;
                    }
                    vdata = new_data;
                    vcap = new_cap;
                    Memory_store_i64(&mut self.memory, vec_addr, vdata);
                    Memory_store_i64(&mut self.memory, vec_addr + 16, vcap);
                }
                Memory_store_i64(&mut self.memory, vdata + vlen * 8, part as i64);
                vlen = vlen + 1;
                Memory_store_i64(&mut self.memory, vec_addr + 8, vlen);
                pi = pi + 1;
            }
            return ExecOutcome::Value(Value::Int(vec_addr));
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_string_replace" {
        if args.len() >= 3 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            var from: str = Interpreter_value_to_string(self, args.get(1));
            var to: str = Interpreter_value_to_string(self, args.get(2));
            return ExecOutcome::Value(Value::Str(str_replace(s, from, to)));
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_string_char_at" {
