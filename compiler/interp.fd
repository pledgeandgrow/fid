        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_map_clone" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(map_addr) => {
                    // Create a new map (shallow copy of struct)
                    var new_addr: i64 = Memory_alloc(&mut self.memory, 32);
                    var k: i64 = Memory_load_i64(&self.memory, map_addr);
                    var v: i64 = Memory_load_i64(&self.memory, map_addr + 8);
                    var l: i64 = Memory_load_i64(&self.memory, map_addr + 16);
                    var c: i64 = Memory_load_i64(&self.memory, map_addr + 24);
                    Memory_store_i64(&mut self.memory, new_addr, k);
                    Memory_store_i64(&mut self.memory, new_addr + 8, v);
                    Memory_store_i64(&mut self.memory, new_addr + 16, l);
                    Memory_store_i64(&mut self.memory, new_addr + 24, c);
                    return ExecOutcome::Value(Value::Int(new_addr));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── Clock runtime functions (ported from src/interp.rs ~4990-5006) ───
    // Use step_count as a simple monotonic counter for timing.
    if name == "p_clock_now" {
        // the wall clock, as the C and native runtimes give it
        return ExecOutcome::Value(Value::Int(p_clock_now()));
    }
    if name == "p_clock_now_us" {
        // the wall clock, as the C and native runtimes give it
        return ExecOutcome::Value(Value::Int(p_clock_now_us()));
    }
    // 64 bits from the operating system's secure generator (the C runtime's)
    if name == "p_os_random_u64" {
        return ExecOutcome::Value(Value::Int(p_os_random_u64()));
    }
    if name == "p_clock_now_ms" {
        // the wall clock, as the C and native runtimes give it
        return ExecOutcome::Value(Value::Int(p_clock_now_ms()));
    }

    // @zeroize heap wipe: interpreter strings and Vecs are managed values, not
    // raw memory, so there is nothing to wipe.
    if name == "p_str_zeroize" || name == "p_vec_zeroize" {
        return ExecOutcome::Value(Value::Void);
    }
    // ─── Memset (simplified — just return ptr) ───
    if name == "p_memset" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(ptr) => { return ExecOutcome::Value(Value::Int(ptr)); }
                Value::Ptr(ptr) => { return ExecOutcome::Value(Value::Ptr(ptr)); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── File I/O builtins: the interpreter is itself a native program,
    // so it performs them with the host runtime. ───
    if str_starts_with(name, "p_file_") {
        var fpath: str = "";
        if args.len() >= 1 { fpath = Interpreter_value_to_string(self, args.get(0)); }
        var farg: str = "";
        if args.len() >= 2 { farg = Interpreter_value_to_string(self, args.get(1)); }
        if name == "p_file_read" { return ExecOutcome::Value(Value::Str(p_file_read(fpath))); }
        if name == "p_file_write" { return ExecOutcome::Value(Value::Int(p_file_write(fpath, farg))); }
        if name == "p_file_exists" { return ExecOutcome::Value(Value::Bool(p_file_exists(fpath) != 0)); }
        if name == "p_file_append" { return ExecOutcome::Value(Value::Int(p_file_append(fpath, farg))); }
        if name == "p_file_delete" { return ExecOutcome::Value(Value::Int(p_file_delete(fpath))); }
        if name == "p_file_size" { return ExecOutcome::Value(Value::Int(p_file_size(fpath))); }
        if name == "p_file_hash" { return ExecOutcome::Value(Value::Int(p_file_hash(fpath))); }
        if name == "p_file_write_vec" {
            // Each element of the interpreted Vec {data, len, cap} is one byte.
            var bytes: Vec<i64> = Vec::new();
            if args.len() >= 2 {
                var vaddr: i64 = 0;
                match args.get(1) {
                    Value::Int(a) => { vaddr = a; }
                    Value::Ptr(a) => { vaddr = a; }
                    _ => {}
                }
                if vaddr > 0 {
                    var vdata: i64 = Memory_load_i64(&self.memory, vaddr);
                    var vlen: i64 = Memory_load_i64(&self.memory, vaddr + 8);
                    var vword: i64 = Memory_load_i64(&self.memory, vaddr + 24);
                    var bi: i64 = 0;
                    while bi < vlen {
                        bytes.push(interp_vec_ld(&self.memory, vdata, bi, vword));
                        bi = bi + 1;
                    }
                }
            }
            return ExecOutcome::Value(Value::Int(p_file_write_vec(fpath, bytes)));
        }
        if name == "p_file_read_bytes" {
            var read: Vec<i64> = p_file_read_bytes(fpath);
            var n: i64 = read.len();
            var cap: i64 = n;
            if cap < 1 { cap = 1; }
            var rdata: i64 = Memory_alloc(&mut self.memory, cap * 8);
            var ri: i64 = 0;
            while ri < n {
                Memory_store_i64(&mut self.memory, rdata + ri * 8, read.get(ri));
                ri = ri + 1;
            }
            var raddr: i64 = Memory_alloc(&mut self.memory, 40);
            Memory_store_i64(&mut self.memory, raddr + 24, 0);
            Memory_store_i64(&mut self.memory, raddr + 32, 0);
            Memory_store_i64(&mut self.memory, raddr, rdata);
            Memory_store_i64(&mut self.memory, raddr + 8, n);
            Memory_store_i64(&mut self.memory, raddr + 16, cap);
            var rhandle: i64 = self.vec_values.len();
            self.vec_values.push(VecValueEntry_new(rhandle));
            self.vec_side_table.push(VecSideEntry_new(raddr, rhandle));
            return ExecOutcome::Value(Value::Int(raddr));
        }
    }

    // ─── Directory / path builtins: delegate to the host runtime. ───
    if str_starts_with(name, "p_dir_") || name == "p_mkdir" || name == "p_rmdir" || name == "p_rename" || name == "p_is_dir" || name == "p_getpid" {
        var dpath: str = "";
        if args.len() >= 1 { dpath = Interpreter_value_to_string(self, args.get(0)); }
        if name == "p_dir_list" { return ExecOutcome::Value(Value::Str(p_dir_list(dpath))); }
        if name == "p_is_dir" { return ExecOutcome::Value(Value::Bool(p_is_dir(dpath) != 0)); }
        if name == "p_mkdir" { return ExecOutcome::Value(Value::Int(p_mkdir(dpath))); }
        if name == "p_rmdir" { return ExecOutcome::Value(Value::Int(p_rmdir(dpath))); }
        if name == "p_rename" {
            var dst: str = "";
            if args.len() >= 2 { dst = Interpreter_value_to_string(self, args.get(1)); }
            return ExecOutcome::Value(Value::Int(p_rename(dpath, dst)));
        }
        if name == "p_getpid" { return ExecOutcome::Value(Value::Int(p_getpid())); }
    }

    // ─── Captured subprocess: the host runtime keeps the result table. ───
    if str_starts_with(name, "p_process_") {
        var ph: i64 = 0;
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(a) => { ph = a; }
                Value::Ptr(a) => { ph = a; }
                _ => {}
            }
        }
        if name == "p_process_run" {
            var pcmd: str = Interpreter_value_to_string(self, args.get(0));
            return ExecOutcome::Value(Value::Int(p_process_run(pcmd)));
        }
        if name == "p_process_stdout" { return ExecOutcome::Value(Value::Str(p_process_stdout(ph))); }
        if name == "p_process_stderr" { return ExecOutcome::Value(Value::Str(p_process_stderr(ph))); }
        if name == "p_process_code" { return ExecOutcome::Value(Value::Int(p_process_code(ph))); }
        if name == "p_process_close" { p_process_close(ph); return ExecOutcome::Value(Value::Void); }
    }

    var rout: ExecOutcome = Interpreter_call_runtime2(self, name, args);
    if !outcome_is_unhandled(rout) { return rout; }

    // ─── Default: panic for unknown runtime functions ───
    // Matches src/interp.rs:6165 — ExecOutcome::Panic("Unknown runtime
    // function: {name}"). is_runtime_func claims far more names than this
    // dispatch implements; returning Int(0) fabricated results silently.
    // A declared extern "C" function that reached here has no interpreter
    // stub: report it as an FFI call that requires a native build.
    var ei: i64 = 0;
    while ei < self.module.extern_functions.len() {
        if self.module.extern_functions.get(ei).name == name {
            var c_name: str = name;
            var di: i64 = 0;
            while di < self.module.extern_decls.len() {
                var d: ExternDecl = self.module.extern_decls.get(di);
                if d.pledge_name == name { c_name = d.c_name; }
                di = di + 1;
            }
            // The C library calls the interpreter's own runtime can make
            // for real (stdlib/os.fd); others have no source of truth here
            var lout: ExecOutcome = Interpreter_libc_call(self, c_name, args);
            if !outcome_is_unhandled(lout) { return lout; }
            return ExecOutcome::Panic("FFI function '" + name + "' (extern \"C\" " + c_name + ") is not available in the interpreter — this program requires native FFI; build it with `fid ccompile` instead of `fid run`");
        }
        ei = ei + 1;
    }
    return ExecOutcome::Panic("Unknown runtime function: " + name);
}

// ===========================================================================
// run_and_print -- execute main() and print result, return exit code
// ===========================================================================
//
// This wraps Interpreter_run and handles printing the result.
// Returns 0 on success, 1 on panic/error.

/// Run main, as `fidesc run` does: the exit code is main's integer result
/// (0 otherwise); a panic prints "Panic: <message>" and the stack trace.
pub fn Interpreter_run_and_print(self: &mut Interpreter) -> i64 {
    var result: RunResult = Interpreter_run(self);
    match result {
        RunResult::Return(v) => {
            match v {
                Value::Int(code) => { return code; }
                _ => { return 0; }
            }
        }
        RunResult::Panic(msg) => {
            p_eprint_str("Panic: ");
            p_eprint_str(msg);
            p_eprint_str("\n");
            match Interpreter_take_panic_stack_trace(self) {
                OptStr::Some(trace) => { p_eprint_str(trace); }
                OptStr::None => {}
            }
            return 1;
        }
        RunResult::Paused => {
            p_eprint_str("Execution paused\n");
            return 0;
        }
    }
    return 1;
}

// ===========================================================================
// Missing helper functions — ported from src/interp.rs
// ===========================================================================

/// coerce_str_to_int — materialize a Str value into memory and return Int(addr).
/// Used when a string value is passed to an I64/U64 parameter.
pub fn Interpreter_coerce_str_to_int(self: &mut Interpreter, v: Value) -> Value {
    match v {
        Value::Str(s) => {
            var addr: i64 = Memory_store_cstr(&mut self.memory, s);
            return Value::Int(addr);
        }
        _ => { return v; }
    }
}

/// is_wrapping_func — check if the currently executing function is @wrapping.
pub fn Interpreter_is_wrapping_func(self: &Interpreter) -> bool {
    return self.cur_wrapping;
}

/// stringify_value — serialize a Value to a type-prefixed string for persistence.
/// Format: "i:42", "b:true", "f:3.14", "s:hello", "p:0x1234", "pv:elem,elem"
pub fn Interpreter_stringify_value(self: &Interpreter, val: Value) -> str {
    match val {
        Value::Int(n) => { return "i:" + int_to_str(n); }
        Value::Bool(b) => {
            if b { return "b:true"; }
            return "b:false";
        }
        Value::Float(f) => { return "f:" + float_to_str(f); }
        Value::Str(s) => { return "s:" + s; }
        Value::Ptr(addr) => {
            // Look up opaque side-table for richer serialization
            var opaque_opt: OptValue = Interpreter_lookup_opaque(self, addr);
            match opaque_opt {
                OptValue::Some(opaque) => {
                    match opaque {
                        Value::Str(s) => { return "ps:" + s; }
                        _ => { return "p:" + int_to_str(addr); }
                    }
                }
                OptValue::None => { return "p:" + int_to_str(addr); }
            }
        }
        _ => { return "v:void"; }
    }
}

/// parse_persisted_value — parse a type-prefixed string back into a Value.
pub fn Interpreter_parse_persisted_value(self: &Interpreter, saved: str, default: Value) -> Value {
    var colon_idx: i64 = str_find(saved, ":");
    if colon_idx >= 0 {
        var prefix: str = str_slice(saved, 0, colon_idx + 1);
        var rest: str = str_slice(saved, colon_idx + 1, str_len(saved));
        if prefix == "i:" { return Value::Int(str_parse_int(rest)); }
        if prefix == "b:" { return Value::Bool(rest == "true"); }
        if prefix == "f:" { return Value::Float(str_parse_float(rest)); }
        if prefix == "s:" { return Value::Str(rest); }
        if prefix == "ps:" { return Value::Str(rest); }
        if prefix == "p:" { return Value::Ptr(str_parse_int(rest)); }
    }
    return default;
}

/// arg_string — extract a string from a Value argument.
/// Handles Value::Str, Value::Ptr (load C string from memory), and
/// Value::Int (check opaque table or load from memory).
pub fn Interpreter_arg_string(self: &Interpreter, v: Value) -> OptStr {
    match v {
        Value::Str(s) => { return OptStr::Some(s); }
        Value::Ptr(addr) => {
            if addr > 0 {
                var loaded: str = Memory_load_cstr(&self.memory, addr);
                return OptStr::Some(loaded);
            }
            return OptStr::None;
        }
        Value::Int(i) => {
            if i > 0 {
                // Check opaque side-table first
                var opaque_opt: OptValue = Interpreter_lookup_opaque(self, i);
                match opaque_opt {
                    OptValue::Some(o) => {
                        match o {
                            Value::Str(s) => { return OptStr::Some(s); }
                            _ => {}
                        }
                    }
                    OptValue::None => {}
                }
                // Try loading a null-terminated string from memory
                if Memory_is_valid_addr(&self.memory, i) {
                    var loaded2: str = Memory_load_cstr(&self.memory, i);
                    if str_len(loaded2) > 0 { return OptStr::Some(loaded2); }
                }
            }
            return OptStr::None;
        }
        _ => { return OptStr::None; }
    }
}

/// lookup_vec_value — look up a Vec Value from an Int/Ptr address.
/// Checks the vec_side_table first, then the opaque_values table.
pub fn Interpreter_lookup_vec_value(self: &Interpreter, arg: Value) -> OptValue {
    match arg {
        Value::Int(addr) => {
            if addr > 0 {
                // Check vec_side_table
                var si: i64 = 0;
                while si < self.vec_side_table.len() {
                    if self.vec_side_table.get(si).vec_addr == addr {
                        var side_idx: i64 = self.vec_side_table.get(si).side_idx;
                        // Look up in opaque_values by side_idx as address
                        return Interpreter_lookup_opaque(self, side_idx);
                    }
                    si = si + 1;
                }
                // Try opaque_values directly
                return Interpreter_lookup_opaque(self, addr);
            }
            return OptValue::None;
        }
        Value::Ptr(addr) => {
            if addr > 0 {
                var si2: i64 = 0;
                while si2 < self.vec_side_table.len() {
                    if self.vec_side_table.get(si2).vec_addr == addr {
                        var side_idx2: i64 = self.vec_side_table.get(si2).side_idx;
                        return Interpreter_lookup_opaque(self, side_idx2);
                    }
                    si2 = si2 + 1;
                }
                return Interpreter_lookup_opaque(self, addr);
            }
            return OptValue::None;
        }
        _ => { return OptValue::None; }
    }
}

/// read_raw_vec_i64 — read a raw Fides Vec struct from memory.
/// Vec is 32 bytes: { data: i64, len: i64, cap: i64, code word }.
/// Elements are at their size (interp_vec_ld; D14).
pub fn Interpreter_read_raw_vec_i64(self: &Interpreter, addr: i64) -> OptVecI64 {
    if addr == 0 { return OptVecI64::None; }
    var len: i64 = Memory_load_i64(&self.memory, addr + 8);
    if len < 0 { return OptVecI64::None; }
    var data: i64 = Memory_load_i64(&self.memory, addr);
    if data <= 0 { return OptVecI64::Some(Vec::new()); }
    var result: Vec<i64> = Vec::new();
    var word: i64 = Memory_load_i64(&self.memory, addr + 24);
    var i: i64 = 0;
    while i < len {
        var elem: i64 = interp_vec_ld(&self.memory, data, i, word);
        result.push(elem);
        i = i + 1;
    }
    return OptVecI64::Some(result);
}

//// arg_to_vec_i64 — extract a Vec<i64> from an argument.
/// Handles Value::Vec (interpreter builtin) and Value::Int/Ptr (raw Fides Vec).
pub fn Interpreter_arg_to_vec_i64(self: &Interpreter, arg: Value) -> OptVecI64 {
    match arg {
        Value::Vec(vec_handle) => {
            return OptVecI64::Some(Interpreter_vec_handle_i64s(self, vec_handle));
        }
        Value::Int(addr) => {
            if addr > 0 {
                match Interpreter_lookup_vec_value(self, arg) {
                    OptValue::Some(v) => {
                        match v {
                            Value::Vec(h) => { return OptVecI64::Some(Interpreter_vec_handle_i64s(self, h)); }
                            _ => {}
                        }
                    }
                    OptValue::None => {}
                }
                return Interpreter_read_raw_vec_i64(self, addr);
            }
            return OptVecI64::None;
        }
        Value::Ptr(addr) => {
            if addr > 0 {
                match Interpreter_lookup_vec_value(self, arg) {
                    OptValue::Some(v2) => {
                        match v2 {
                            Value::Vec(h2) => { return OptVecI64::Some(Interpreter_vec_handle_i64s(self, h2)); }
                            _ => {}
                        }
                    }
                    OptValue::None => {}
                }
                return Interpreter_read_raw_vec_i64(self, addr);
            }
            return OptVecI64::None;
        }
        _ => { return OptVecI64::None; }
    }
    return OptVecI64::None;
}

/// The elements of side-table Vec `h` as i64 (non-Int elements read as 0).
pub fn Interpreter_vec_handle_i64s(self: &Interpreter, h: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if h < 0 || h >= self.vec_values.len() { return out; }
    var elems: Vec<Value> = self.vec_values.get(h).elements;
    var i: i64 = 0;
    while i < elems.len() {
        match elems.get(i) {
            Value::Int(n) => { out.push(n); }
            _ => { out.push(0); }
        }
        i = i + 1;
    }
    return out;
}

/// The elements of side-table Vec `h` as f64: an Int is a stored f64 word.
pub fn Interpreter_vec_handle_f64s(self: &Interpreter, h: i64, int_is_bits: bool) -> Vec<f64> {
    var out: Vec<f64> = Vec::new();
    if h < 0 || h >= self.vec_values.len() { return out; }
    var elems: Vec<Value> = self.vec_values.get(h).elements;
    var i: i64 = 0;
    while i < elems.len() {
        match elems.get(i) {
            Value::Int(n) => {
                if int_is_bits { out.push(f64_from_bits_i(n)); } else { out.push(n as f64); }
            }
            Value::Float(f) => { out.push(f); }
            _ => { out.push(0.0); }
        }
        i = i + 1;
    }
    return out;
}

/// A new side-table Vec holding `elems`.
pub fn Interpreter_new_vec_value(self: &mut Interpreter, elems: Vec<Value>) -> Value {
    var handle: i64 = self.vec_values.len();
    var e: VecValueEntry = VecValueEntry_new(handle);
    e.elements = elems;
    self.vec_values.push(e);
    return Value::Vec(handle);
}

/// A side-table Vec of floats.
pub fn Interpreter_new_float_vec(self: &mut Interpreter, fs: Vec<f64>) -> Value {
    var elems: Vec<Value> = Vec::new();
    var i: i64 = 0;
    while i < fs.len() {
        elems.push(Value::Float(fs.get(i)));
        i = i + 1;
    }
    return Interpreter_new_vec_value(self, elems);
}

/// alloc_tensor — store a Tensor in the side table and return an opaque Ptr.
/// Value::Ptr(addr) stands in for Rust's Value::Tensor (see file header).
pub fn Interpreter_alloc_tensor(self: &mut Interpreter, t: TensorData) -> Value {
    var addr: i64 = Memory_alloc(&mut self.memory, 8);
    var handle: i64 = self.tensors.len();
    self.tensors.push(t);
    self.tensor_side_table.push(TensorSideEntry_new(addr, handle));
    I64Table_set(&mut self.tensor_index, addr, Value::Int(handle));
    Memory_store_i64(&mut self.memory, addr, handle);
    return Value::Ptr(addr);
}

/// tensor_handle — resolve a Value::Ptr/Int addr to a tensors index, or -1.
pub fn Interpreter_tensor_handle(self: &Interpreter, arg: Value) -> i64 {
    var addr: i64 = -1;
    match arg {
        Value::Ptr(a) => { addr = a; }
        Value::Int(a) => { addr = a; }
        _ => {}
    }
    if addr < 0 { return -1; }
    match I64Table_get(&self.tensor_index, addr) {
        OptValue::Some(hv) => {
            match hv {
                Value::Int(h) => { return h; }
                _ => {}
            }
        }
        OptValue::None => {}
    }
    return -1;
}

/// args_to_f64_vec — extract a Vec<f64> from args[idx].
/// Handles Value::Vec and Value::Int/Ptr (Fides Vec via fides_vec_to_value_vec).
pub fn Interpreter_args_to_f64_vec(self: &mut Interpreter, args: Vec<Value>, idx: i64) -> OptVecF64 {
    if idx < 0 || idx >= args.len() { return OptVecF64::None; }
    var arg: Value = args.get(idx);
    var ptr: i64 = 0;
    match arg {
        Value::Vec(h) => { return OptVecF64::Some(Interpreter_vec_handle_f64s(self, h, true)); }
        Value::Int(p) => { ptr = p; }
        Value::Ptr(p2) => { ptr = p2; }
        _ => { return OptVecF64::None; }
    }
    match Interpreter_fides_vec_to_value_vec(self, ptr) {
        Value::Vec(h2) => { return OptVecF64::Some(Interpreter_vec_handle_f64s(self, h2, true)); }
        _ => {}
    }
    return OptVecF64::None;
}

/// fides_vec_to_value_vec — convert a Fides Vec (i64 pointer) to a Value::Vec
/// by running the program's Vec_len / Vec_get.
pub fn Interpreter_fides_vec_to_value_vec(self: &mut Interpreter, vec_ptr: i64) -> Value {
    var elems: Vec<Value> = Vec::new();
    match Interpreter_get_function(self, "Vec_len") {
        OptIrFunction::Some(len_fn) => {
            match Interpreter_get_function(self, "Vec_get") {
                OptIrFunction::Some(get_fn) => {
                    var len_args: Vec<Value> = Vec::new();
                    len_args.push(Value::Int(0));
                    len_args.push(Value::Int(vec_ptr));
                    var len: i64 = 0;
                    match Interpreter_run_function(self, len_fn, len_args) {
                        RunResult::Return(v) => {
                            match v {
                                Value::Int(n) => { len = n; }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                    var i: i64 = 0;
                    while i < len {
                        var get_args: Vec<Value> = Vec::new();
                        get_args.push(Value::Int(0));
                        get_args.push(Value::Int(vec_ptr));
                        get_args.push(Value::Int(i));
                        match Interpreter_run_function(self, get_fn, get_args) {
                            RunResult::Return(gv) => { elems.push(gv); }
                            _ => {}
                        }
                        i = i + 1;
                    }
                }
                OptIrFunction::None => {}
            }
        }
        OptIrFunction::None => {}
    }
    return Interpreter_new_vec_value(self, elems);
}

/// find_vec_addr — find the Vec struct address for a Value::Vec by scanning vec_side_table.
pub fn Interpreter_find_vec_addr(self: &Interpreter, v: Value) -> i64 {
    match v {
        Value::Vec(target_handle) => {
            var si: i64 = 0;
            while si < self.vec_side_table.len() {
                if self.vec_side_table.get(si).side_idx == target_handle {
                    return self.vec_side_table.get(si).vec_addr;
                }
                si = si + 1;
            }
        }
        _ => {}
    }
    return 0;
}

// format_panic_trace — format the panic stack trace as a string.
pub fn Interpreter_format_panic_trace(self: &Interpreter) -> OptStr {
    match self.panic_stack_trace {
        OptStr::Some(s) => { return OptStr::Some(s); }
        OptStr::None => { return OptStr::None; }
    }
}

/// take_panic_stack_trace — consume the panic stack trace.
pub fn Interpreter_take_panic_stack_trace(self: &mut Interpreter) -> OptStr {
    var trace: OptStr = self.panic_stack_trace;
    self.panic_stack_trace = OptStr::None;
    return trace;
}

/// get_call_stack — return a copy of the call stack.
pub fn Interpreter_get_call_stack(self: &Interpreter) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < self.call_stack.len() {
        result.push(self.call_stack.get(i));
        i = i + 1;
    }
    return result;
}

/// get_current_func_name — return the current function name.
pub fn Interpreter_get_current_func_name(self: &Interpreter) -> str {
    return self.current_func_name;
}

/// get_memory_usage — return (allocated, capacity) as packed i64.
pub fn Interpreter_get_memory_usage(self: &Interpreter) -> i64 {
    var allocated: i64 = Memory_allocated(&self.memory);
    var cap: i64 = Memory_capacity(&self.memory);
    return allocated * 1000000 + cap;
}

/// get_module — return a reference to the IR module.
/// In Fides, we return a copy since references are limited.
pub fn Interpreter_get_module(self: &Interpreter) -> IrModule {
