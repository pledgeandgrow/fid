                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var lo: i64 = 0;
                    var hi: i64 = vlen - 1;
                    while lo < hi {
                        var tmp1: i64 = Memory_load_i64(&self.memory, vdata + lo * 8);
                        var tmp2: i64 = Memory_load_i64(&self.memory, vdata + hi * 8);
                        Memory_store_i64(&mut self.memory, vdata + lo * 8, tmp2);
                        Memory_store_i64(&mut self.memory, vdata + hi * 8, tmp1);
                        lo = lo + 1;
                        hi = hi - 1;
