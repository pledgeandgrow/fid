                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_string_is_empty" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Str(s) => { return ExecOutcome::Value(Value::Bool(str_len(s) == 0)); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Bool(true));
    }
    if name == "p_string_push_str" {
        if args.len() >= 2 {
            var left: str = Interpreter_value_to_string(self, args.get(0));
            var right: str = Interpreter_value_to_string(self, args.get(1));
            return ExecOutcome::Value(Value::Str(left + right));
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_string_to_string" {
        if args.len() > 0 {
            return ExecOutcome::Value(Value::Str(Interpreter_value_to_string(self, args.get(0))));
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_string_slice" {
        if args.len() >= 3 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            var start: i64 = 0;
            var end: i64 = str_len(s);
            match args.get(1) { Value::Int(n) => { start = n; } _ => {} }
            match args.get(2) { Value::Int(n) => { end = n; } _ => {} }
            var slen: i64 = str_len(s);
            if start < 0 { start = 0; }
            if end > slen { end = slen; }
            if start > end { start = end; }
            return ExecOutcome::Value(Value::Str(String_slice(s, start, end)));
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_string_contains" {
