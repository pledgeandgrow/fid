/// wildcard_match — simple wildcard pattern matching.
/// ? matches any single char, * matches zero or more chars.
pub fn wildcard_match(s: str, pattern: str) -> bool {
    var s_len: i64 = str_len(s);
    var p_len: i64 = str_len(pattern);
    var s_idx: i64 = 0;
    var p_idx: i64 = 0;
    var star_s: i64 = -1;
    var star_p: i64 = -1;
    while s_idx < s_len {
        if p_idx < p_len {
            var pc: i64 = str_byte_at(pattern, p_idx);
            var sc: i64 = str_byte_at(s, s_idx);
            if pc == 63 || pc == sc {
                s_idx = s_idx + 1;
                p_idx = p_idx + 1;
            } else if pc == 42 {
                star_p = p_idx;
                star_s = s_idx;
                p_idx = p_idx + 1;
            } else if star_p >= 0 {
                p_idx = star_p + 1;
                s_idx = star_s + 1;
                star_s = s_idx;
            } else {
                return false;
            }
        } else if star_p >= 0 {
            p_idx = star_p + 1;
            s_idx = star_s + 1;
            star_s = s_idx;
        } else {
            return false;
        }
    }
    while p_idx < p_len && str_byte_at(pattern, p_idx) == 42 {
        p_idx = p_idx + 1;
    }
    return p_idx == p_len;
}

/// arg_vec_usize — extract a Vec<usize> from args[idx] (simplified).
pub fn arg_vec_usize(args: Vec<Value>, idx: i64) -> OptVecI64 {
    if idx < 0 || idx >= args.len() { return OptVecI64::None; }
    match args.get(idx) {
        Value::Vec(_) => { return OptVecI64::Some(Vec::new()); }
        _ => { return OptVecI64::None; }
    }
}

/// arg_vec_i64 — extract a Vec<i64> from args[idx] (simplified).
pub fn arg_vec_i64(args: Vec<Value>, idx: i64) -> OptVecI64 {
    if idx < 0 || idx >= args.len() { return OptVecI64::None; }
    match args.get(idx) {
        Value::Vec(_) => { return OptVecI64::Some(Vec::new()); }
        _ => { return OptVecI64::None; }
    }
}

/// arg_vec_f64 — extract a Vec<f64> from args[idx] (simplified).
pub fn arg_vec_f64(args: Vec<Value>, idx: i64) -> OptVecF64 {
    if idx < 0 || idx >= args.len() { return OptVecF64::None; }
    match args.get(idx) {
        Value::Vec(_) => { return OptVecF64::Some(Vec::new()); }
        _ => { return OptVecF64::None; }
    }
}

/// simd_binary — SIMD binary operation helper.
pub fn simd_binary(args: Vec<Value>, f: fn(f64, f64) -> f64) -> ExecOutcome {
    // Simplified — would extract vec elements, apply f, return Vec
    return ExecOutcome::Panic("simd: not fully supported in self-hosted interpreter");
