            match args.get(0) {
                Value::Int(dst_addr) => {
                    match args.get(1) {
                        Value::Int(src_addr) => {
                            var dst_len: i64 = Memory_load_i64(&self.memory, dst_addr + 8);
                            var dst_cap: i64 = Memory_load_i64(&self.memory, dst_addr + 16);
                            var dst_data: i64 = Memory_load_i64(&self.memory, dst_addr);
                            var src_len: i64 = Memory_load_i64(&self.memory, src_addr + 8);
                            var src_data: i64 = Memory_load_i64(&self.memory, src_addr);
                            // Grow dst if needed
                            var needed: i64 = dst_len + src_len;
                            if needed > dst_cap {
                                var new_cap: i64 = 8;
                                if needed > 8 { new_cap = needed; }
                                if dst_cap > 0 { new_cap = dst_cap * 2; }
                                if new_cap < needed { new_cap = needed; }
                                var new_data: i64 = Memory_alloc(&mut self.memory, new_cap * 8);
                                var ci: i64 = 0;
                                while ci < dst_len {
                                    var v: i64 = Memory_load_i64(&self.memory, dst_data + ci * 8);
                                    Memory_store_i64(&mut self.memory, new_data + ci * 8, v);
                                    ci = ci + 1;
                                }
                                dst_data = new_data;
                                dst_cap = new_cap;
                                Memory_store_i64(&mut self.memory, dst_addr, dst_data);
                                Memory_store_i64(&mut self.memory, dst_addr + 16, dst_cap);
                            }
                            // Copy elements from src to dst
                            var si: i64 = 0;
                            while si < src_len {
                                var v: i64 = Memory_load_i64(&self.memory, src_data + si * 8);
                                Memory_store_i64(&mut self.memory, dst_data + (dst_len + si) * 8, v);
                                si = si + 1;
                            }
                            dst_len = dst_len + src_len;
                            Memory_store_i64(&mut self.memory, dst_addr + 8, dst_len);
                            return ExecOutcome::Value(Value::Void);
