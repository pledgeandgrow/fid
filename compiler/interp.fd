// ===========================================================================
// interpret_ir_module -- run a pre-built IrModule, return exit code
// ===========================================================================

pub fn interpret_ir_module(ir_mod: IrModule) -> i64 {
    var interp_inst: Interpreter = Interpreter_new(ir_mod);
    return Interpreter_run_and_print(&mut interp_inst);
}

pub fn interpret_ir_module_with_options(ir_mod: IrModule, max_recursion: i64, max_steps: i64, max_memory: i64, verbose: bool) -> i64 {
    var interp_inst: Interpreter = Interpreter_new(ir_mod);
    if verbose {
        Interpreter_verbose(&mut interp_inst);
    }
    if max_recursion > 0 {
        Interpreter_set_max_recursion(&mut interp_inst, max_recursion);
    }
    if max_steps > 0 {
        Interpreter_set_max_steps(&mut interp_inst, max_steps);
    }
    if max_memory > 0 {
        Interpreter_set_max_memory(&mut interp_inst, max_memory);
    }
    return Interpreter_run_and_print(&mut interp_inst);
}

// ===========================================================================
// call_runtime2 -- builtins ported from src/interp.rs call_runtime that the
// first dispatch does not handle. Returns ExecOutcome::Jump(-99) for a name
// it does not know.
// ===========================================================================

pub struct ChanState {
    pub buf: Vec<i64>,
    pub head: i64,
    pub cap: i64,
    pub closed: bool,
}

pub struct DbRow {
    pub db: i64,
    pub key: str,
    pub val: Value,
}

pub struct EcsComp {
    pub name: str,
    pub table: I64Table,
}

// roadmap L6C: what the host's loader gave the interpreted program: each
// p_dl_load's handle (once per load, as the OS counts them) and each
// symbol p_dl_find found with the handle it was found in. Only these are
// passed back to the host (p_dl_find, p_dl_unload, p_dl_call).
var g_ip_dl_libs: Vec<i64> = Vec::new();
var g_ip_dl_syms: Vec<i64> = Vec::new();
var g_ip_dl_sym_lib: Vec<i64> = Vec::new();

/// Whether `x` is a loaded library's handle (`lib`) or a found symbol.
fn ip_dl_has(x: i64, lib: bool) -> bool {
    var i: i64 = 0;
    if lib {
        while i < g_ip_dl_libs.len() {
            if g_ip_dl_libs.get(i) == x {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    while i < g_ip_dl_syms.len() {
        if g_ip_dl_syms.get(i) == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// One load of library `h` was released: when it was the last, its
/// symbols are forgotten too (their code may be gone).
fn ip_dl_forget(h: i64) {
    var i: i64 = 0;
    var found: bool = false;
    while i < g_ip_dl_libs.len() && !found {
        if g_ip_dl_libs.get(i) == h {
            g_ip_dl_libs.remove(i);
            found = true;
        } else {
            i = i + 1;
        }
    }
    if ip_dl_has(h, true) {
        return;
    }
    var k: i64 = 0;
    while k < g_ip_dl_syms.len() {
        if g_ip_dl_sym_lib.get(k) == h {
            g_ip_dl_syms.remove(k);
            g_ip_dl_sym_lib.remove(k);
        } else {
            k = k + 1;
        }
    }
}

fn arg_int(args: Vec<Value>, i: i64, dflt: i64) -> i64 {
    if i < 0 || i >= args.len() {
        return dflt;
    }
    match args.get(i) {
        Value::Int(n) => {
            return n;
        }
        _ => {
        }
    }
    return dflt;
}

fn arg_int_or_ptr(args: Vec<Value>, i: i64) -> i64 {
    if i < 0 || i >= args.len() {
        return 0;
    }
    match args.get(i) {
        Value::Int(n) => {
            return n;
        }
        Value::Ptr(p) => {
            return p;
        }
        _ => {
        }
    }
    return 0;
}

fn arg_value(args: Vec<Value>, i: i64) -> Value {
    if i < 0 || i >= args.len() {
        return Value::Int(0);
    }
    return args.get(i);
}

fn arg_float_opt_ok(args: Vec<Value>, i: i64) -> bool {
    if i < 0 || i >= args.len() {
        return false;
    }
    match args.get(i) {
        Value::Float(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

fn arg_float(args: Vec<Value>, i: i64) -> f64 {
    if i < 0 || i >= args.len() {
        return 0.0;
    }
    match args.get(i) {
        Value::Float(f) => {
            return f;
        }
        _ => {
        }
    }
    return 0.0;
}

/// Rust's arg_string: Some(text) for a Str / Ptr / string-pointer Int.
pub fn Interpreter_arg_str_ok(self: &Interpreter, v: Value) -> bool {
    match Interpreter_arg_string(self, v) {
        OptStr::Some(_) => {
            return true;
        }
        OptStr::None => {
        }
    }
