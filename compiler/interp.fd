    // ─── KV Cache (ML9) ───
    if name == "p_kv_cache_new" {
        var n_layers: i64 = 0;
        var max_seq: i64 = 0;
        var win_size: i64 = 0;
        var h_dim: i64 = 0;
        match args.get(0) { Value::Int(a0) => { n_layers = a0; } _ => {} }
        match args.get(1) { Value::Int(a1) => { max_seq = a1; } _ => {} }
        match args.get(2) { Value::Int(a2) => { win_size = a2; } _ => {} }
        match args.get(3) { Value::Int(a3) => { h_dim = a3; } _ => {} }
        var cache_id: i64 = self.kv_caches.len();
        self.kv_caches.push(KvCache_new(n_layers, max_seq, win_size, h_dim));
        return ExecOutcome::Value(Value::Int(cache_id));
    }
    if name == "p_kv_cache_append" {
        var cid: i64 = 0;
        var lyr: i64 = 0;
        match args.get(0) { Value::Int(c0) => { cid = c0; } _ => {} }
        match args.get(1) { Value::Int(l0) => { lyr = l0; } _ => {} }
        var kh: i64 = Interpreter_tensor_handle(self, args.get(2));
        var vh: i64 = Interpreter_tensor_handle(self, args.get(3));
        if cid < 0 || cid >= self.kv_caches.len() { return ExecOutcome::Panic("kv_cache_append: invalid cache id"); }
        if kh < 0 || vh < 0 { return ExecOutcome::Panic("kv_cache_append: expected (cache_id, layer, k_tensor, v_tensor)"); }
        var cache: KvCache = self.kv_caches.get(cid);
        KvCache_append(&mut cache, lyr, &self.tensors.get(kh), &self.tensors.get(vh));
        self.kv_caches.set(cid, cache);
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_kv_cache_get" {
        var cid2: i64 = 0;
        var lyr2: i64 = 0;
        match args.get(0) { Value::Int(c1) => { cid2 = c1; } _ => {} }
        match args.get(1) { Value::Int(l1) => { lyr2 = l1; } _ => {} }
        if cid2 < 0 || cid2 >= self.kv_caches.len() { return ExecOutcome::Panic("kv_cache_get: invalid cache id"); }
        var cache2: KvCache = self.kv_caches.get(cid2);
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, KvCache_get(&cache2, lyr2)));
    }
    if name == "p_kv_cache_len" {
        var cid3: i64 = 0;
        var lyr3: i64 = 0;
        match args.get(0) { Value::Int(c2) => { cid3 = c2; } _ => {} }
        match args.get(1) { Value::Int(l2) => { lyr3 = l2; } _ => {} }
        if cid3 < 0 || cid3 >= self.kv_caches.len() { return ExecOutcome::Panic("kv_cache_len: invalid cache id"); }
        var cache3: KvCache = self.kv_caches.get(cid3);
        return ExecOutcome::Value(Value::Int(KvCache_len(&cache3, lyr3)));
    }
    if name == "p_kv_cache_clear" {
        var cid4: i64 = 0;
        match args.get(0) { Value::Int(c3) => { cid4 = c3; } _ => {} }
        if cid4 < 0 || cid4 >= self.kv_caches.len() { return ExecOutcome::Panic("kv_cache_clear: invalid cache id"); }
        var cache4: KvCache = self.kv_caches.get(cid4);
        KvCache_clear(&mut cache4);
        self.kv_caches.set(cid4, cache4);
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_kv_cache_evict" {
        var cid5: i64 = 0;
        var ntok: i64 = 0;
        match args.get(0) { Value::Int(c4) => { cid5 = c4; } _ => {} }
        match args.get(1) { Value::Int(n0) => { ntok = n0; } _ => {} }
        if cid5 < 0 || cid5 >= self.kv_caches.len() { return ExecOutcome::Panic("kv_cache_evict: invalid cache id"); }
        var cache5: KvCache = self.kv_caches.get(cid5);
        KvCache_evict_oldest(&mut cache5, ntok);
        self.kv_caches.set(cid5, cache5);
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Quantization (ML10) ───
    if name == "p_quantize_q8" {
        var thq: i64 = Interpreter_tensor_handle(self, args.get(0));
        var qscale: f64 = 0.0;
        var qzp: i64 = 0;
        var q_ok: bool = false;
        match args.get(1) { Value::Float(qf) => { qscale = qf; } _ => {} }
        match args.get(2) { Value::Int(qz) => { qzp = qz; q_ok = true; } _ => {} }
        if thq < 0 || !q_ok { return ExecOutcome::Panic("quantize_q8: expected (Tensor, f64, i64)"); }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_quantize_q8(&self.tensors.get(thq), qscale, qzp)));
    }
    if name == "p_dequantize_q8" {
        var thd: i64 = Interpreter_tensor_handle(self, args.get(0));
        var dscale: f64 = 0.0;
        var dzp: i64 = 0;
        var d_ok: bool = false;
        match args.get(1) { Value::Float(df) => { dscale = df; } _ => {} }
        match args.get(2) { Value::Int(dz) => { dzp = dz; d_ok = true; } _ => {} }
        if thd < 0 || !d_ok { return ExecOutcome::Panic("dequantize_q8: expected (Tensor, f64, i64)"); }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_dequantize_q8(&self.tensors.get(thd), dscale, dzp)));
    }
    if name == "p_qmatmul" {
        // Issue 12: Quantized matmul using i32 accumulation (ported inline,
        // mirrors src/interp.rs — tensor.fd has no Tensor_qmatmul).
        var qha: i64 = Interpreter_tensor_handle(self, args.get(0));
        var qhb: i64 = Interpreter_tensor_handle(self, args.get(1));
        if qha < 0 || qhb < 0 { return ExecOutcome::Panic("qmatmul: expected (Tensor, Tensor)"); }
        var qa_t: TensorData = self.tensors.get(qha);
        var qb_t: TensorData = self.tensors.get(qhb);
        if Tensor_ndim(&qa_t) != 2 || Tensor_ndim(&qb_t) != 2 {
            return ExecOutcome::Panic("qmatmul: expected 2D tensors");
        }
        var qm: i64 = qa_t.shape.get(0);
        var qk: i64 = qa_t.shape.get(1);
        var qn: i64 = qb_t.shape.get(1);
        if qb_t.shape.get(0) != qk {
            return ExecOutcome::Panic("qmatmul: shape mismatch");
        }
        var qshape: Vec<i64> = Vec::new();
        qshape.push(qm);
        qshape.push(qn);
        var qres: TensorData = Tensor_zeros(qshape);
        var qi: i64 = 0;
        while qi < qm {
            var qj: i64 = 0;
            while qj < qn {
                var acc: i64 = 0;
                var qx: i64 = 0;
                while qx < qk {
                    var qa: i64 = p_float_to_int(qa_t.data.get(qi * qk + qx));
                    var qb: i64 = p_float_to_int(qb_t.data.get(qx * qn + qj));
                    acc = (acc + qa * qb) & 0xFFFFFFFF;
                    if acc >= 0x80000000 { acc = acc - 0x100000000; }
                    qx = qx + 1;
                }
                qres.data.set(qi * qn + qj, p_int_to_float(acc));
                qj = qj + 1;
            }
            qi = qi + 1;
        }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, qres));
    }
