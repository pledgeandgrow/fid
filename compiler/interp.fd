            var s: str = Interpreter_value_to_string(self, args.get(0));
            var sub: str = Interpreter_value_to_string(self, args.get(1));
            return ExecOutcome::Value(Value::Int(str_find(s, sub)));
        }
        return ExecOutcome::Value(Value::Int(-1));
    }
    if name == "p_string_rfind" {
        if args.len() >= 2 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            var sub: str = Interpreter_value_to_string(self, args.get(1));
