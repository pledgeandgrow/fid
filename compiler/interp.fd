    if name == "p_string_split" {
        if args.len() >= 2 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            var delim: str = Interpreter_value_to_string(self, args.get(1));
            // Create a new vec (same as p_vec_new)
            var vec_addr: i64 = Memory_alloc(&mut self.memory, 40);
            Memory_store_i64(&mut self.memory, vec_addr + 24, 0);
            Memory_store_i64(&mut self.memory, vec_addr + 32, 0);
            Memory_store_i64(&mut self.memory, vec_addr, 0);
            Memory_store_i64(&mut self.memory, vec_addr + 8, 0);
            Memory_store_i64(&mut self.memory, vec_addr + 16, 0);
            // Split the string using str_split helper
            var parts: Vec<str> = str_split(s, delim);
            var pi: i64 = 0;
            while pi < parts.len() {
                var part: str = parts.get(pi);
                // Inline vec push logic
                var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                var vcap: i64 = Memory_load_i64(&self.memory, vec_addr + 16);
                var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                if vlen >= vcap {
                    var new_cap: i64 = 8;
                    if vcap > 0 { new_cap = vcap * 2; }
                    var new_data: i64 = Memory_alloc(&mut self.memory, new_cap * 8);
                    var ci: i64 = 0;
                    while ci < vlen {
                        var v: i64 = Memory_load_i64(&self.memory, vdata + ci * 8);
                        Memory_store_i64(&mut self.memory, new_data + ci * 8, v);
                        ci = ci + 1;
                    }
                    vdata = new_data;
                    vcap = new_cap;
                    Memory_store_i64(&mut self.memory, vec_addr, vdata);
                    Memory_store_i64(&mut self.memory, vec_addr + 16, vcap);
                }
                Memory_store_i64(&mut self.memory, vdata + vlen * 8, part as i64);
                vlen = vlen + 1;
                Memory_store_i64(&mut self.memory, vec_addr + 8, vlen);
                pi = pi + 1;
            }
            return ExecOutcome::Value(Value::Int(vec_addr));
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_string_replace" {
