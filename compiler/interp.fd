        return ExecOutcome::Value(Value::Str(""));
    }

    // ─── Bool runtime function ───
    if name == "p_bool_to_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Bool(b) => {
                    if b {
                        return ExecOutcome::Value(Value::Str("true"));
                    }
                    return ExecOutcome::Value(Value::Str("false"));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Str(""));
    }

    // ─── Vec extra runtime functions (ported from src/interp.rs ~2868-3554) ───
    if name == "p_vec_to_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var out: str = "[";
                    var vi: i64 = 0;
                    while vi < vlen {
                        if vi > 0 {
                            out = out + ", ";
                        }
                        var elem: i64 = Memory_load_i64(&self.memory, vdata + vi * 8);
                        out = out + int_to_str(elem);
                        vi = vi + 1;
                    }
                    out = out + "]";
                    return ExecOutcome::Value(Value::Str(out));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Str("[]"));
    }
    if name == "p_vec_insert" {
        if args.len() >= 3 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    match args.get(1) {
                        Value::Int(idx) => {
                            var elem: i64 = 0;
                            match args.get(2) {
                                Value::Int(e) => {
                                    elem = e;
                                }
                                Value::Ptr(p) => {
                                    elem = p;
                                }
                                _ => {
                                }
                            }
                            var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                            var vcap: i64 = Memory_load_i64(&self.memory, vec_addr + 16);
                            var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                            if idx < 0 || idx > vlen {
                                return ExecOutcome::Panic("Vec insert out of bounds");
                            }
                            // Grow if needed
                            if vlen >= vcap {
                                var new_cap: i64 = 8;
                                if vcap > 0 {
                                    new_cap = vcap * 2;
                                }
                                var new_data: i64 = Memory_alloc(&mut self.memory, new_cap * 8);
                                var ci: i64 = 0;
                                while ci < vlen {
                                    var v: i64 = Memory_load_i64(&self.memory, vdata + ci * 8);
                                    Memory_store_i64(&mut self.memory, new_data + ci * 8, v);
                                    ci = ci + 1;
                                }
                                vdata = new_data;
                                vcap = new_cap;
                                Memory_store_i64(&mut self.memory, vec_addr, vdata);
                                Memory_store_i64(&mut self.memory, vec_addr + 16, vcap);
                            }
                            // Shift elements right from idx to vlen-1
                            var si: i64 = vlen;
                            while si > idx {
                                var v: i64 = Memory_load_i64(&self.memory, vdata + (si - 1) * 8);
                                Memory_store_i64(&mut self.memory, vdata + si * 8, v);
                                si = si - 1;
                            }
                            // Insert element
                            Memory_store_i64(&mut self.memory, vdata + idx * 8, elem);
                            vlen = vlen + 1;
                            Memory_store_i64(&mut self.memory, vec_addr + 8, vlen);
                            return ExecOutcome::Value(Value::Void);
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_remove" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    match args.get(1) {
                        Value::Int(idx) => {
                            var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                            var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                            if idx < 0 || idx >= vlen {
                                return ExecOutcome::Panic("Vec remove out of bounds");
                            }
                            var elem: i64 = Memory_load_i64(&self.memory, vdata + idx * 8);
                            // Shift elements left from idx+1 to vlen-1
                            var si: i64 = idx;
                            while si < vlen - 1 {
                                var v: i64 = Memory_load_i64(&self.memory, vdata + (si + 1) * 8);
                                Memory_store_i64(&mut self.memory, vdata + si * 8, v);
                                si = si + 1;
                            }
                            vlen = vlen - 1;
                            Memory_store_i64(&mut self.memory, vec_addr + 8, vlen);
                            return ExecOutcome::Value(Value::Int(elem));
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_contains" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var target: i64 = 0;
                    match args.get(1) {
                        Value::Int(e) => {
                            target = e;
                        }
                        Value::Ptr(p) => {
                            target = p;
                        }
                        _ => {
                        }
                    }
                    var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var ci: i64 = 0;
                    while ci < vlen {
                        var elem: i64 = Memory_load_i64(&self.memory, vdata + ci * 8);
                        if elem == target {
                            return ExecOutcome::Value(Value::Bool(true));
                        }
                        ci = ci + 1;
                    }
                    return ExecOutcome::Value(Value::Bool(false));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_vec_reverse" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var lo: i64 = 0;
                    var hi: i64 = vlen - 1;
                    while lo < hi {
                        var tmp1: i64 = Memory_load_i64(&self.memory, vdata + lo * 8);
                        var tmp2: i64 = Memory_load_i64(&self.memory, vdata + hi * 8);
                        Memory_store_i64(&mut self.memory, vdata + lo * 8, tmp2);
                        Memory_store_i64(&mut self.memory, vdata + hi * 8, tmp1);
                        lo = lo + 1;
                        hi = hi - 1;
                    }
                    return ExecOutcome::Value(Value::Void);
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_first" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    if vlen == 0 {
                        return ExecOutcome::Panic("Vec first() on empty vec");
                    }
                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var elem: i64 = Memory_load_i64(&self.memory, vdata);
                    return ExecOutcome::Value(Value::Int(elem));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_last" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    if vlen == 0 {
                        return ExecOutcome::Panic("Vec last() on empty vec");
                    }
                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var elem: i64 = Memory_load_i64(&self.memory, vdata + (vlen - 1) * 8);
                    return ExecOutcome::Value(Value::Int(elem));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_extend" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(dst_addr) => {
                    match args.get(1) {
                        Value::Int(src_addr) => {
                            var dst_len: i64 = Memory_load_i64(&self.memory, dst_addr + 8);
                            var dst_cap: i64 = Memory_load_i64(&self.memory, dst_addr + 16);
                            var dst_data: i64 = Memory_load_i64(&self.memory, dst_addr);
                            var src_len: i64 = Memory_load_i64(&self.memory, src_addr + 8);
                            var src_data: i64 = Memory_load_i64(&self.memory, src_addr);
                            // Grow dst if needed
                            var needed: i64 = dst_len + src_len;
                            if needed > dst_cap {
                                var new_cap: i64 = 8;
                                if needed > 8 {
                                    new_cap = needed;
                                }
                                if dst_cap > 0 {
                                    new_cap = dst_cap * 2;
                                }
                                if new_cap < needed {
                                    new_cap = needed;
                                }
                                var new_data: i64 = Memory_alloc(&mut self.memory, new_cap * 8);
                                var ci: i64 = 0;
                                while ci < dst_len {
                                    var v: i64 = Memory_load_i64(&self.memory, dst_data + ci * 8);
                                    Memory_store_i64(&mut self.memory, new_data + ci * 8, v);
                                    ci = ci + 1;
                                }
                                dst_data = new_data;
                                dst_cap = new_cap;
                                Memory_store_i64(&mut self.memory, dst_addr, dst_data);
                                Memory_store_i64(&mut self.memory, dst_addr + 16, dst_cap);
                            }
                            // Copy elements from src to dst
                            var si: i64 = 0;
                            while si < src_len {
                                var v: i64 = Memory_load_i64(&self.memory, src_data + si * 8);
                                Memory_store_i64(&mut self.memory, dst_data + (dst_len + si) * 8, v);
                                si = si + 1;
                            }
                            dst_len = dst_len + src_len;
                            Memory_store_i64(&mut self.memory, dst_addr + 8, dst_len);
                            return ExecOutcome::Value(Value::Void);
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_truncate" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    match args.get(1) {
                        Value::Int(n) => {
                            var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                            if n >= 0 && n < vlen {
                                Memory_store_i64(&mut self.memory, vec_addr + 8, n);
                            }
                            return ExecOutcome::Value(Value::Void);
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_sort" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    // Simple bubble sort (ascending) on raw i64 elements
                    var i: i64 = 0;
                    while i < vlen - 1 {
                        var j: i64 = 0;
                        while j < vlen - 1 - i {
                            var a: i64 = Memory_load_i64(&self.memory, vdata + j * 8);
                            var b: i64 = Memory_load_i64(&self.memory, vdata + (j + 1) * 8);
                            if a > b {
                                Memory_store_i64(&mut self.memory, vdata + j * 8, b);
                                Memory_store_i64(&mut self.memory, vdata + (j + 1) * 8, a);
                            }
                            j = j + 1;
                        }
                        i = i + 1;
                    }
                    return ExecOutcome::Value(Value::Void);
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_clone" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(src_addr) => {
                    var src_len: i64 = Memory_load_i64(&self.memory, src_addr + 8);
                    var src_data: i64 = Memory_load_i64(&self.memory, src_addr);
                    // Create a new vec
                    var new_addr: i64 = Memory_alloc(&mut self.memory, 40);
                    var kcode: i64 = Memory_load_i64(&self.memory, src_addr + 24);
                    Memory_store_i64(&mut self.memory, new_addr + 24, kcode);
                    Memory_store_i64(&mut self.memory, new_addr + 32, 0);
                    var new_cap: i64 = 8;
                    if src_len > 8 {
                        new_cap = src_len;
                    }
                    if new_cap == 0 {
                        new_cap = 8;
                    }
                    var new_data: i64 = Memory_alloc(&mut self.memory, new_cap * interp_vec_esz(kcode));
                    // Copy elements
                    var ci: i64 = 0;
                    while ci < src_len {
                        var v: i64 = interp_vec_ld(&self.memory, src_data, ci, kcode);
                        interp_vec_st(&mut self.memory, new_data, ci, kcode, v);
                        ci = ci + 1;
                    }
                    Memory_store_i64(&mut self.memory, new_addr, new_data);
                    Memory_store_i64(&mut self.memory, new_addr + 8, src_len);
                    Memory_store_i64(&mut self.memory, new_addr + 16, new_cap);
                    return ExecOutcome::Value(Value::Int(new_addr));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_vec_capacity" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var vcap: i64 = Memory_load_i64(&self.memory, vec_addr + 16);
                    return ExecOutcome::Value(Value::Int(vcap));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── Map extra runtime functions (ported from src/interp.rs ~3208-3579) ───
    if name == "p_map_keys" {
        // Create a new vec to hold keys (empty since map storage is simplified)
        var vec_addr: i64 = Memory_alloc(&mut self.memory, 40);
        Memory_store_i64(&mut self.memory, vec_addr + 24, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 32, 0);
        Memory_store_i64(&mut self.memory, vec_addr, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 8, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 16, 0);
        return ExecOutcome::Value(Value::Int(vec_addr));
    }
    if name == "p_map_values" {
        // Create a new vec to hold values (empty since map storage is simplified)
        var vec_addr: i64 = Memory_alloc(&mut self.memory, 40);
        Memory_store_i64(&mut self.memory, vec_addr + 24, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 32, 0);
        Memory_store_i64(&mut self.memory, vec_addr, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 8, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 16, 0);
        return ExecOutcome::Value(Value::Int(vec_addr));
    }
    if name == "p_map_remove" {
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_map_clone" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(map_addr) => {
                    // Create a new map (shallow copy of struct)
                    var new_addr: i64 = Memory_alloc(&mut self.memory, 32);
                    var k: i64 = Memory_load_i64(&self.memory, map_addr);
                    var v: i64 = Memory_load_i64(&self.memory, map_addr + 8);
                    var l: i64 = Memory_load_i64(&self.memory, map_addr + 16);
                    var c: i64 = Memory_load_i64(&self.memory, map_addr + 24);
                    Memory_store_i64(&mut self.memory, new_addr, k);
                    Memory_store_i64(&mut self.memory, new_addr + 8, v);
                    Memory_store_i64(&mut self.memory, new_addr + 16, l);
                    Memory_store_i64(&mut self.memory, new_addr + 24, c);
                    return ExecOutcome::Value(Value::Int(new_addr));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── Clock runtime functions (ported from src/interp.rs ~4990-5006) ───
    // Use step_count as a simple monotonic counter for timing.
    if name == "p_clock_now" {
        // the wall clock, as the C and native runtimes give it
        return ExecOutcome::Value(Value::Int(p_clock_now()));
    }
    if name == "p_clock_now_us" {
        // the wall clock, as the C and native runtimes give it
        return ExecOutcome::Value(Value::Int(p_clock_now_us()));
    }
    // 64 bits from the operating system's secure generator (the C runtime's)
    if name == "p_os_random_u64" {
        return ExecOutcome::Value(Value::Int(p_os_random_u64()));
    }
    // RT7: the interpreted program's memory is simulated, not pages of its
    // own: not known (-1), as on a C target without a way to ask
    if name == "p_mem_resident" {
        return ExecOutcome::Value(Value::Int(0 - 1));
    }
    if name == "p_clock_now_ms" {
        // the wall clock, as the C and native runtimes give it
        return ExecOutcome::Value(Value::Int(p_clock_now_ms()));
    }
    if name == "p_clock_mono_ms" {
        // C6: the deadline clock (interp_mono_ms)
        return ExecOutcome::Value(Value::Int(interp_mono_ms()));
    }

    // @zeroize heap wipe: interpreter strings and Vecs are managed values, not
    // raw memory, so there is nothing to wipe.
    if name == "p_str_zeroize" || name == "p_vec_zeroize" {
        return ExecOutcome::Value(Value::Void);
    }
    // J8: interpreter Vecs are managed values — no raw buffers to track
    if name == "p_sensitive_check" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_sensitive_wipes" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_sensitive_mark" || name == "p_sensitive_unmark" || name == "p_sensitive_remark" || name == "p_sensitive_free" {
        return ExecOutcome::Value(Value::Void);
    }
    // ─── Memset: p_memset(ptr, byte, n) fills n bytes of the interpreter's
    // memory with the low byte of `byte`, as C's memset (it did nothing, so
    // stdlib/arena's mem_zero/mem_set left the block as it was), and returns
    // ptr. A managed value (str, Vec) has no bytes here, so it is left. ───
    if name == "p_memset" {
        var ms_ptr: i64 = 0;
        var ms_raw: bool = false;
        var ms_is_ptr: bool = false;
        var ms_byte: i64 = 0;
        var ms_len: i64 = 0;
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(mp) => {
                    ms_ptr = mp;
                    ms_raw = true;
                }
                Value::Ptr(mp) => {
                    ms_ptr = mp;
                    ms_raw = true;
                    ms_is_ptr = true;
                }
                _ => {
                }
            }
        }
        if args.len() >= 2 {
            match args.get(1) {
                Value::Int(mb) => {
                    ms_byte = mb;
                }
                Value::Bool(mbb) => {
                    if mbb {
                        ms_byte = 1;
                    }
                }
                _ => {
                }
            }
        }
        if args.len() >= 3 {
            match args.get(2) {
                Value::Int(ml) => {
                    ms_len = ml;
                }
                _ => {
                }
            }
        }
        if !ms_raw {
            return ExecOutcome::Value(Value::Int(0));
        }
        if ms_ptr > 0 && ms_len > 0 && (Memory_is_valid_addr(&self.memory, ms_ptr + ms_len - 1) || Memory_may_grow_to(&self.memory, ms_ptr + ms_len)) {
            val ms_b: i64 = ms_byte & 0xFF;
            var msi: i64 = 0;
            while msi < ms_len {
                Memory_store_byte(&mut self.memory, ms_ptr + msi, ms_b);
                msi = msi + 1;
            }
        }
        if ms_is_ptr {
            return ExecOutcome::Value(Value::Ptr(ms_ptr));
        }
        return ExecOutcome::Value(Value::Int(ms_ptr));
    }

    // ─── File I/O builtins: the interpreter is itself a native program,
    // so it performs them with the host runtime. ───
    if str_starts_with(name, "p_file_") {
        var fpath: str = "";
        if args.len() >= 1 {
            fpath = Interpreter_value_to_string(self, args.get(0));
        }
        var farg: str = "";
        if args.len() >= 2 {
            farg = Interpreter_value_to_string(self, args.get(1));
        }
        if name == "p_file_read" {
            // A file that cannot be read is the raw 0 the C and native
            // runtimes give (core read_file: None); an empty file is "",
            // which is a Str and not 0 (known-bugs 2g.42: a Str compares
            // equal to 0 when empty, so "" made read_file None)
            var fread: str = p_file_read(fpath);
            if (fread as i64) == 0 {
                return ExecOutcome::Value(Value::Int(0));
            }
            if str_len(fread) == 0 {
                return ExecOutcome::Value(Value::Str(interp_empty_read()));
            }
            return ExecOutcome::Value(Value::Str(fread));
        }
        if name == "p_file_write" {
            return ExecOutcome::Value(Value::Int(p_file_write(fpath, farg)));
        }
        if name == "p_file_exists" {
            return ExecOutcome::Value(Value::Bool(p_file_exists(fpath) != 0));
        }
        if name == "p_file_append" {
            return ExecOutcome::Value(Value::Int(p_file_append(fpath, farg)));
        }
        if name == "p_file_delete" {
            return ExecOutcome::Value(Value::Int(p_file_delete(fpath)));
        }
        if name == "p_file_size" {
            return ExecOutcome::Value(Value::Int(p_file_size(fpath)));
        }
        if name == "p_file_hash" {
            return ExecOutcome::Value(Value::Int(p_file_hash(fpath)));
        }
        if name == "p_file_write_vec" {
            // Each element of the interpreted Vec {data, len, cap} is one byte.
            var bytes: Vec<i64> = Vec::new();
            if args.len() >= 2 {
                var vaddr: i64 = 0;
                match args.get(1) {
                    Value::Int(a) => {
                        vaddr = a;
                    }
                    Value::Ptr(a) => {
                        vaddr = a;
                    }
                    _ => {
                    }
                }
                if vaddr > 0 {
                    var vdata: i64 = Memory_load_i64(&self.memory, vaddr);
                    var vlen: i64 = Memory_load_i64(&self.memory, vaddr + 8);
                    var vword: i64 = Memory_load_i64(&self.memory, vaddr + 24);
                    var bi: i64 = 0;
                    while bi < vlen {
                        bytes.push(interp_vec_ld(&self.memory, vdata, bi, vword));
                        bi = bi + 1;
                    }
                }
            }
            return ExecOutcome::Value(Value::Int(p_file_write_vec(fpath, bytes)));
        }
        if name == "p_file_write_bin" {
            // RT2: p_file_write_bin(path, data, n) writes the n bytes at
            // data, zero bytes included (p_file_write stops at the first),
            // as the C runtime's fwrite and the native runtimes do
            var wn: i64 = 0;
            if args.len() >= 3 {
                match args.get(2) {
                    Value::Int(x) => {
                        wn = x;
                    }
                    _ => {
                    }
                }
            }
            if args.len() < 3 || wn < 0 {
                return ExecOutcome::Value(Value::Int(0 - 1));
            }
            var wbytes: Vec<i64> = Interpreter_value_bytes(self, args.get(1), wn);
            if wbytes.len() < wn {
                return ExecOutcome::Value(Value::Int(0 - 1));
            }
            return ExecOutcome::Value(Value::Int(p_file_write_vec(fpath, wbytes)));
        }
        // roadmap L4B (stdlib/fs.fd File's streaming reads): up to n bytes
        // from byte `offset`, as the C runtime's p_file_read_at. The host
        // compiler's runtime may predate p_file_read_at (the first stage of
        // a bootstrap), so the host reads the file and the slice is taken
        // here: the same bytes, at the cost of reading the whole file.
        if name == "p_file_read_at" {
            var at_off: i64 = 0;
            var at_n: i64 = 0;
            if args.len() >= 3 {
                at_off = arg_int(args, 1, 0);
                at_n = arg_int(args, 2, 0);
            }
            var at_bytes: Vec<i64> = Vec::new();
            if at_off >= 0 && at_n > 0 {
                var whole: Vec<i64> = p_file_read_bytes(fpath);
                var ai: i64 = at_off;
                while ai < whole.len() && ai < at_off + at_n {
                    at_bytes.push(whole.get(ai) & 255);
                    ai = ai + 1;
                }
            }
            return ExecOutcome::Value(Value::Int(Interpreter_new_byte_vec(self, at_bytes)));
        }
        // The bytes of the interpreted Vec appended, zero bytes included
        // (as p_file_append_vec; through the host's p_file_write_vec, which
        // every stage has)
        if name == "p_file_append_vec" {
            var app: Vec<i64> = Vec::new();
            if args.len() >= 2 {
                var avaddr: i64 = arg_int_or_ptr(args, 1);
                if avaddr > 0 {
                    var avdata: i64 = Memory_load_i64(&self.memory, avaddr);
                    var avlen: i64 = Memory_load_i64(&self.memory, avaddr + 8);
                    var avword: i64 = Memory_load_i64(&self.memory, avaddr + 24);
                    var abi: i64 = 0;
                    while abi < avlen {
                        app.push(interp_vec_ld(&self.memory, avdata, abi, avword) & 255);
                        abi = abi + 1;
                    }
                }
            }
            if p_is_dir(fpath) != 0 {
                return ExecOutcome::Value(Value::Int(0 - 1));
            }
            var before: Vec<i64> = Vec::new();
            if p_file_exists(fpath) != 0 {
                before = p_file_read_bytes(fpath);
            }
            var api: i64 = 0;
            while api < app.len() {
                before.push(app.get(api));
                api = api + 1;
            }
            return ExecOutcome::Value(Value::Int(p_file_write_vec(fpath, before)));
        }
        if name == "p_file_mtime_ms" {
            return ExecOutcome::Value(Value::Int(p_file_mtime_ms(fpath)));
        }
        if name == "p_file_read_bytes" {
            var read: Vec<i64> = p_file_read_bytes(fpath);
            var n: i64 = read.len();
            var cap: i64 = n;
            if cap < 1 {
                cap = 1;
            }
            var rdata: i64 = Memory_alloc(&mut self.memory, cap * 8);
            var ri: i64 = 0;
            while ri < n {
                Memory_store_i64(&mut self.memory, rdata + ri * 8, read.get(ri));
                ri = ri + 1;
            }
            var raddr: i64 = Memory_alloc(&mut self.memory, 40);
            Memory_store_i64(&mut self.memory, raddr + 24, 0);
            Memory_store_i64(&mut self.memory, raddr + 32, 0);
            Memory_store_i64(&mut self.memory, raddr, rdata);
            Memory_store_i64(&mut self.memory, raddr + 8, n);
            Memory_store_i64(&mut self.memory, raddr + 16, cap);
            var rhandle: i64 = self.vec_values.len();
            self.vec_values.push(VecValueEntry_new(rhandle));
            self.vec_side_table.push(VecSideEntry_new(raddr, rhandle));
            // known by address to the side table: never reused
            I64Table_set(&mut self.memory.blocks, raddr, Value::Int(1));
            return ExecOutcome::Value(Value::Int(raddr));
        }
    }

    // ─── Directory / path builtins: delegate to the host runtime. ───
    if str_starts_with(name, "p_dir_") || name == "p_mkdir" || name == "p_rmdir" || name == "p_rename" || name == "p_is_dir" || name == "p_getpid" {
        var dpath: str = "";
        if args.len() >= 1 {
            dpath = Interpreter_value_to_string(self, args.get(0));
        }
        if name == "p_dir_list" {
            return ExecOutcome::Value(Value::Str(p_dir_list(dpath)));
        }
        if name == "p_is_dir" {
            return ExecOutcome::Value(Value::Bool(p_is_dir(dpath) != 0));
        }
        if name == "p_mkdir" {
            return ExecOutcome::Value(Value::Int(p_mkdir(dpath)));
        }
        if name == "p_rmdir" {
            return ExecOutcome::Value(Value::Int(p_rmdir(dpath)));
        }
        if name == "p_rename" {
            var dst: str = "";
            if args.len() >= 2 {
                dst = Interpreter_value_to_string(self, args.get(1));
            }
            return ExecOutcome::Value(Value::Int(p_rename(dpath, dst)));
        }
        if name == "p_getpid" {
            return ExecOutcome::Value(Value::Int(p_getpid()));
        }
    }

    // ─── Captured subprocess: the host runtime keeps the result table. ───
    if str_starts_with(name, "p_process_") {
        var ph: i64 = 0;
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(a) => {
                    ph = a;
                }
                Value::Ptr(a) => {
                    ph = a;
                }
                _ => {
                }
            }
        }
        if name == "p_process_run" {
            var pcmd: str = Interpreter_value_to_string(self, args.get(0));
            return ExecOutcome::Value(Value::Int(p_process_run(pcmd)));
        }
        if name == "p_process_stdout" {
            return ExecOutcome::Value(Value::Str(p_process_stdout(ph)));
        }
        if name == "p_process_stderr" {
            return ExecOutcome::Value(Value::Str(p_process_stderr(ph)));
        }
        if name == "p_process_code" {
            return ExecOutcome::Value(Value::Int(p_process_code(ph)));
        }
        if name == "p_process_close" {
            p_process_close(ph);
            return ExecOutcome::Value(Value::Void);
        }
    }

    var rout: ExecOutcome = Interpreter_call_runtime2(self, name, args);
    if !outcome_is_unhandled(rout) {
        return rout;
    }

    // ─── Default: panic for unknown runtime functions ───
    // Matches src/interp.rs:6165 — ExecOutcome::Panic("Unknown runtime
    // function: {name}"). is_runtime_func claims far more names than this
    // dispatch implements; returning Int(0) fabricated results silently.
    // A declared extern "C" function that reached here has no interpreter
    // stub: report it as an FFI call that requires a native build.
    var ei: i64 = 0;
    while ei < self.module.extern_functions.len() {
        if self.module.extern_functions.get(ei).name == name {
            var c_name: str = name;
            var di: i64 = 0;
            while di < self.module.extern_decls.len() {
                var d: ExternDecl = self.module.extern_decls.get(di);
                if d.pledge_name == name {
                    c_name = d.c_name;
                }
                di = di + 1;
            }
            // The C library calls the interpreter's own runtime can make
            // for real (stdlib/os.fd); others have no source of truth here
            var lout: ExecOutcome = Interpreter_libc_call(self, c_name, args);
            if !outcome_is_unhandled(lout) {
                return lout;
            }
            return ExecOutcome::Panic("FFI function '" + name + "' (extern \"C\" " + c_name + ") is not available in the interpreter — this program requires native FFI; build it with `fid ccompile` instead of `fid run`");
        }
        ei = ei + 1;
    }
    return ExecOutcome::Panic("Unknown runtime function: " + name);
}

// ===========================================================================
// run_and_print -- execute main() and print result, return exit code
// ===========================================================================
//
// This wraps Interpreter_run and handles printing the result.
// Returns 0 on success, 1 on panic/error.

// --- CT7: record a run's inputs, replay it --------------------------------
// `fid run <file> --record <trace>` writes, for each call of an effect
// builtin (interp_rr_effect: files, directories, environment, argv, clock,
// OS randomness, stdin, processes started with p_system), its name, its
// arguments and its result. `fid replay <trace>` runs the program again in
// the interpreter and answers each of those calls from the trace instead
// of making it: the run sees the same inputs (the same file contents, time,
// environment, random words) and does no real I/O but its own printing; a
// file it wrote is not written again. A call that is not the next one of
// the trace (another builtin or other arguments) stops the replay: the
// program is not the one recorded or ran differently. `--steps` prints
// each answered call on stderr. Trace format, one item per line, text
// hex-encoded ("-" for an empty text):
//   fid-replay 1
//   program <hex of the source file's path>
//   source <hex of the source file's text>
//   ev <name> <hex of the arguments> <kind> <payload>
//   exit <code>                      (when the run ended)
// kind: i Int, p Ptr, b Bool (0/1), f Float (its bits), s Str (hex),
// e the empty text of an empty file, v Void, x a panic (hex message),
// y the bytes of p_file_read_bytes (hex). p_process_* (captured output)
// are recorded too. The interpreter's sockets and async network calls are
// simulated (no real I/O), so they need no trace. A p_exit or a panic in
// a task ends the recording with its exit code (interp_rr_exiting).
// Imported modules are read from disk again when replayed: only the main
// file's text is in the trace.
var g_rr_mode: i64 = 0;
var g_rr_path: str = "";
var g_rr_pending: Vec<str> = Vec::new();
var g_rr_events: Vec<str> = Vec::new();
var g_rr_next: i64 = 0;
var g_rr_steps: bool = false;
var g_rr_program: str = "";
var g_rr_source: str = "";
var g_rr_exit: i64 = -1;
var g_rr_error: str = "";
// `fid replay --until <k>`: stop before answering effect call k and show
// where the program is (0: run to the end)
var g_rr_until: i64 = 0;

/// CT7: is `name` an effect builtin whose result the trace holds?
/// An interpreted Vec<i64> {data, len, cap, code, tid} holding `bytes`, as
/// p_file_read_bytes makes one; its address.
fn Interpreter_new_byte_vec(self: &mut Interpreter, bytes: Vec<i64>) -> i64 {
    var n: i64 = bytes.len();
    var cap: i64 = n;
    if cap < 1 {
        cap = 1;
    }
    var data: i64 = Memory_alloc(&mut self.memory, cap * 8);
    var i: i64 = 0;
    while i < n {
        Memory_store_i64(&mut self.memory, data + i * 8, bytes.get(i));
        i = i + 1;
    }
    var addr: i64 = Memory_alloc(&mut self.memory, 40);
    Memory_store_i64(&mut self.memory, addr + 24, 0);
    Memory_store_i64(&mut self.memory, addr + 32, 0);
    Memory_store_i64(&mut self.memory, addr, data);
    Memory_store_i64(&mut self.memory, addr + 8, n);
    Memory_store_i64(&mut self.memory, addr + 16, cap);
    var handle: i64 = self.vec_values.len();
    self.vec_values.push(VecValueEntry_new(handle));
    self.vec_side_table.push(VecSideEntry_new(addr, handle));
    // known by address to the side table: never reused
    I64Table_set(&mut self.memory.blocks, addr, Value::Int(1));
    return addr;
}

pub fn interp_rr_effect(name: str) -> bool {
    if name == "p_file_read" || name == "p_file_exists" || name == "p_file_size" || name == "p_file_hash" || name == "p_file_write" || name == "p_file_append" || name == "p_file_delete" {
        return true;
    }
    if name == "p_dir_list" || name == "p_is_dir" || name == "p_mkdir" || name == "p_rmdir" || name == "p_rename" || name == "p_getpid" {
        return true;
    }
    if name == "p_getenv" || name == "p_argc" || name == "p_argv" || name == "p_system" || name == "p_read_line" || name == "p_read_stdin" {
        return true;
    }
    // processes started with captured output: their handle, output and
    // exit code come from the trace (the command is not run again)
    if name == "p_process_run" || name == "p_process_stdout" || name == "p_process_stderr" || name == "p_process_code" || name == "p_process_close" {
        return true;
    }
    // a file read as bytes: its bytes are in the trace (kind y)
    if name == "p_file_read_bytes" {
        return true;
    }
    return name == "p_clock_now" || name == "p_clock_now_us" || name == "p_clock_now_ms" || name == "p_clock_mono_ms" || name == "p_os_random_u64";
}

fn rr_hex_digit(d: i64) -> i64 {
    if d < 10 {
        return 48 + d;
    }
    return 87 + d;
}

fn rr_hex_value(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    return 0;
}

/// CT7: `s` as hex ("-" for "").
pub fn rr_hex(s: str) -> str {
    var n: i64 = str_len(s);
    if n == 0 {
        return "-";
    }
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var b: i64 = str_byte_at(s, i) & 255;
        out.push(rr_hex_digit(b >> 4));
        out.push(rr_hex_digit(b & 15));
        i = i + 1;
    }
    return str_from_bytes(out);
}

/// CT7: the text of hex `h` (rr_hex).
pub fn rr_unhex(h: str) -> str {
    if h == "-" || str_len(h) < 2 {
        return "";
    }
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i + 1 < str_len(h) {
        out.push(rr_hex_value(str_byte_at(h, i)) * 16 + rr_hex_value(str_byte_at(h, i + 1)));
        i = i + 2;
    }
    return str_from_bytes(out);
}

/// CT7: bytes `b` (each 0..255) as hex ("-" for none); a byte 0 is kept,
/// which a text cannot hold.
pub fn rr_hex_bytes(b: Vec<i64>) -> str {
    if b.len() == 0 {
        return "-";
    }
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < b.len() {
        var x: i64 = b.get(i) & 255;
        out.push(rr_hex_digit(x >> 4));
        out.push(rr_hex_digit(x & 15));
        i = i + 1;
    }
    return str_from_bytes(out);
}

/// CT7: the bytes of hex `h` (rr_hex_bytes).
pub fn rr_unhex_bytes(h: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if h == "-" {
        return out;
    }
    var i: i64 = 0;
    while i + 1 < str_len(h) {
        out.push(rr_hex_value(str_byte_at(h, i)) * 16 + rr_hex_value(str_byte_at(h, i + 1)));
        i = i + 2;
    }
    return out;
}

/// CT7: the elements of the interpreted Vec at `vaddr` ({data, len, cap,
/// word}), as p_file_write_vec reads them.
fn Interpreter_rr_vec_bytes(self: &Interpreter, vaddr: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if vaddr <= 0 {
        return out;
    }
    var vdata: i64 = Memory_load_i64(&self.memory, vaddr);
    var vlen: i64 = Memory_load_i64(&self.memory, vaddr + 8);
    var vword: i64 = Memory_load_i64(&self.memory, vaddr + 24);
    var i: i64 = 0;
    while i < vlen {
        out.push(interp_vec_ld(&self.memory, vdata, i, vword));
        i = i + 1;
    }
    return out;
}

/// CT7: a new interpreted Vec holding `bytes`, made as p_file_read_bytes
/// makes its result; its address.
fn Interpreter_rr_new_bytes_vec(self: &mut Interpreter, bytes: Vec<i64>) -> i64 {
    var n: i64 = bytes.len();
    var cap: i64 = n;
    if cap < 1 {
        cap = 1;
    }
    var rdata: i64 = Memory_alloc(&mut self.memory, cap * 8);
    var ri: i64 = 0;
    while ri < n {
        Memory_store_i64(&mut self.memory, rdata + ri * 8, bytes.get(ri));
        ri = ri + 1;
    }
    var raddr: i64 = Memory_alloc(&mut self.memory, 40);
    Memory_store_i64(&mut self.memory, raddr + 24, 0);
    Memory_store_i64(&mut self.memory, raddr + 32, 0);
    Memory_store_i64(&mut self.memory, raddr, rdata);
    Memory_store_i64(&mut self.memory, raddr + 8, n);
    Memory_store_i64(&mut self.memory, raddr + 16, cap);
    var rhandle: i64 = self.vec_values.len();
    self.vec_values.push(VecValueEntry_new(rhandle));
    self.vec_side_table.push(VecSideEntry_new(raddr, rhandle));
    // known by address to the side table: never reused
    I64Table_set(&mut self.memory.blocks, raddr, Value::Int(1));
    return raddr;
}

/// CT7: the arguments of a call as the trace and --steps show them.
fn Interpreter_rr_args(self: &Interpreter, args: Vec<Value>) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < args.len() {
        if i > 0 {
            out = out + ", ";
        }
        match args.get(i) {
            Value::Int(v) => {
                out = out + int_to_str(v);
            }
            Value::Bool(b) => {
                if b {
                    out = out + "true";
                } else {
                    out = out + "false";
                }
            }
            Value::Float(f) => {
                out = out + "f" + int_to_str(p_f64_to_bits(f));
            }
            Value::Void => {
                out = out + "()";
            }
            _ => {
                out = out + "\"" + Interpreter_value_to_string(self, args.get(i)) + "\"";
            }
        }
        i = i + 1;
    }
    return out;
}

/// CT7: start recording into `path` the run of `program` (its text
/// `source`). False when the file cannot be written.
pub fn interp_rr_record_start(path: str, program: str, source: str) -> bool {
    var head: str = "fid-replay 1\nprogram " + rr_hex(program) + "\nsource " + rr_hex(source) + "\n";
    if p_file_write(path, head) < 0 {
        return false;
    }
    g_rr_mode = 1;
    g_rr_path = path;
    g_rr_pending = Vec::new();
    return true;
}

/// CT7: write the recorded calls not written yet.
pub fn interp_rr_flush() {
    if g_rr_mode != 1 || g_rr_pending.len() == 0 {
        return;
    }
    var text: str = "";
    var i: i64 = 0;
    while i < g_rr_pending.len() {
        text = text + g_rr_pending.get(i) + "\n";
        i = i + 1;
    }
    g_rr_pending = Vec::new();
    p_file_append(g_rr_path, text);
}

/// CT7: the recorded run ended with exit code `code`: the rest of the
/// trace and its `exit` line are written, and recording stops.
pub fn interp_rr_record_finish(code: i64) {
    if g_rr_mode != 1 {
        return;
    }
    interp_rr_flush();
    p_file_append(g_rr_path, "exit " + int_to_str(code) + "\n");
    g_rr_mode = 0;
}

/// CT7: read trace `text` and answer the effect calls of the next run from
/// it ("" when it is a trace; else why not). `steps`: print each answered
/// call on stderr.
pub fn interp_rr_replay_start(text: str, steps: bool) -> str {
    var lines: Vec<str> = str_split(text, "\n");
    if lines.len() == 0 || str_trim(lines.get(0)) != "fid-replay 1" {
        return "not a trace of `fid run --record` (no `fid-replay 1` line)";
    }
    g_rr_events = Vec::new();
    g_rr_program = "";
    g_rr_source = "";
    g_rr_exit = -1;
    g_rr_until = 0;
    var i: i64 = 1;
    while i < lines.len() {
        var line: str = str_trim(lines.get(i));
        i = i + 1;
        if str_starts_with(line, "until ") {
            // `fid replay --until <k>` adds this line to the text it reads
            g_rr_until = p_str_to_int(str_slice(line, 6, str_len(line)));
        } else if str_starts_with(line, "program ") {
            g_rr_program = rr_unhex(str_slice(line, 8, str_len(line)));
        } else if str_starts_with(line, "source ") {
            g_rr_source = rr_unhex(str_slice(line, 7, str_len(line)));
        } else if str_starts_with(line, "ev ") {
            g_rr_events.push(line);
        } else if str_starts_with(line, "exit ") {
            g_rr_exit = p_str_to_int(str_slice(line, 5, str_len(line)));
        }
    }
    if str_len(g_rr_program) == 0 {
        return "the trace names no program";
    }
    g_rr_next = 0;
    g_rr_steps = steps;
    g_rr_error = "";
    g_rr_mode = 2;
    return "";
}

pub fn interp_rr_program() -> str {
    return g_rr_program;
}

pub fn interp_rr_source() -> str {
    return g_rr_source;
}

/// CT7: the replayed run ended with exit code `code`: "" when it used every
/// recorded call and ended as the recorded run did; else what differs.
pub fn interp_rr_replay_finish(code: i64) -> str {
    g_rr_mode = 0;
    if str_len(g_rr_error) > 0 {
        return g_rr_error;
    }
    if g_rr_next < g_rr_events.len() {
        return "the replay ended after " + int_to_str(g_rr_next) + " of the " + int_to_str(g_rr_events.len()) + " recorded effect calls";
    }
    if g_rr_exit >= 0 && code != g_rr_exit {
        return "the replay ended with exit code " + int_to_str(code) + ", the recorded run with " + int_to_str(g_rr_exit);
    }
    return "";
}

/// CT7: the program ends the process now with `code` (p_exit, a panic in a
/// task): a recording gets its rest and its `exit` line; a replay is
/// checked against the recording here, since the driver never sees its end
/// (a difference is said on stderr, and a run that would exit 0 exits 1).
pub fn interp_rr_exiting(code: i64) {
    if g_rr_mode == 1 {
        interp_rr_record_finish(code);
        return;
    }
    if g_rr_mode == 2 {
        var differs: str = interp_rr_replay_finish(code);
        if str_len(differs) > 0 {
            p_eprint_str("replay of " + g_rr_program + ": " + differs + "\n");
            if code == 0 {
                p_exit(1);
            }
        }
    }
}

/// CT7: the real call (recording) or the trace's answer (replaying) of
/// effect builtin `name`.
pub fn Interpreter_rr_call(self: &mut Interpreter, name: str, args: &mut Vec<Value>) -> ExecOutcome {
    var shown: str = Interpreter_rr_args(self, args);
    if g_rr_mode == 1 {
        g_rr_mode = 0;
        var out: ExecOutcome = Interpreter_call_runtime(self, name, args);
        g_rr_mode = 1;
        var kind: str = "v";
        var payload: str = "-";
        match out {
            ExecOutcome::Value(v) => {
                match v {
                    Value::Int(x) => {
                        kind = "i";
                        payload = int_to_str(x);
                    }
                    Value::Ptr(x) => {
                        kind = "p";
                        payload = int_to_str(x);
                    }
                    Value::Bool(b) => {
                        kind = "b";
                        payload = "0";
                        if b {
                            payload = "1";
                        }
                    }
                    Value::Float(f) => {
                        kind = "f";
                        payload = int_to_str(p_f64_to_bits(f));
                    }
                    Value::Str(s) => {
                        if interp_is_empty_read(s) {
                            kind = "e";
                        } else {
                            kind = "s";
                            payload = rr_hex(s);
                        }
                    }
                    _ => {
                    }
                }
            }
            ExecOutcome::Panic(msg) => {
                kind = "x";
                payload = rr_hex(msg);
            }
            _ => {
            }
        }
        // the bytes of p_file_read_bytes, not the address of its Vec
        if name == "p_file_read_bytes" && kind == "i" {
            kind = "y";
            payload = rr_hex_bytes(Interpreter_rr_vec_bytes(self, p_str_to_int(payload)));
        }
        g_rr_pending.push("ev " + name + " " + rr_hex(shown) + " " + kind + " " + payload);
        if g_rr_pending.len() >= 256 {
            interp_rr_flush();
        }
        return out;
    }
    // replaying
    if g_rr_next >= g_rr_events.len() {
        g_rr_error = "the program called " + name + "(" + shown + ") after the last recorded effect call";
        return ExecOutcome::Panic("replay: " + g_rr_error);
    }
    var parts: Vec<str> = str_split(g_rr_events.get(g_rr_next), " ");
    var at: i64 = g_rr_next + 1;
    g_rr_next = g_rr_next + 1;
    if parts.len() < 5 {
        g_rr_error = "recorded effect call " + int_to_str(at) + " is not readable";
        return ExecOutcome::Panic("replay: " + g_rr_error);
    }
    var rec_name: str = parts.get(1);
    var rec_args: str = rr_unhex(parts.get(2));
    if rec_name != name || rec_args != shown {
        g_rr_error = "effect call " + int_to_str(at) + " differs: the recorded run called " + rec_name + "(" + rec_args + "), this one " + name + "(" + shown + ")";
        return ExecOutcome::Panic("replay: " + g_rr_error);
    }
    if g_rr_until > 0 && at == g_rr_until {
        // the run as far as effect call `at`: what it is about to receive
        // and the calls it is in (innermost first)
        p_eprint_str("[replay] stopped before effect call " + int_to_str(at) + " of " + int_to_str(g_rr_events.len()) + ": " + name + "(" + shown + ")\n");
        p_eprint_str(Interpreter_format_call_stack(self));
        g_rr_mode = 0;
        p_exit(0);
    }
    var kind2: str = parts.get(3);
    var pay: str = parts.get(4);
    var result: Value = Value::Void;
    var answer: str = "()";
    if kind2 == "i" {
        result = Value::Int(p_str_to_int(pay));
        answer = pay;
    } else if kind2 == "p" {
        result = Value::Ptr(p_str_to_int(pay));
        answer = "null";
        if pay != "0" {
            answer = pay;
        }
    } else if kind2 == "b" {
        result = Value::Bool(pay == "1");
        answer = "false";
        if pay == "1" {
            answer = "true";
        }
    } else if kind2 == "f" {
        result = Value::Float(f64_from_bits_i(p_str_to_int(pay)));
        answer = "f" + pay;
    } else if kind2 == "s" {
        var text: str = rr_unhex(pay);
        result = Value::Str(text);
        answer = "\"" + text + "\"";
    } else if kind2 == "e" {
        result = Value::Str(interp_empty_read());
        answer = "\"\"";
    } else if kind2 == "y" {
        var bytes: Vec<i64> = rr_unhex_bytes(pay);
        result = Value::Int(Interpreter_rr_new_bytes_vec(self, bytes));
        answer = int_to_str(bytes.len()) + " bytes";
    } else if kind2 == "x" {
        var pmsg: str = rr_unhex(pay);
        if g_rr_steps {
            p_eprint_str("[replay " + int_to_str(at) + "] " + name + "(" + shown + ") panicked: " + pmsg + "\n");
        }
        return ExecOutcome::Panic(pmsg);
    }
    if g_rr_steps {
        p_eprint_str("[replay " + int_to_str(at) + "] " + name + "(" + shown + ") -> " + answer + "\n");
    }
    return ExecOutcome::Value(result);
}

/// CT7: p_read_line / p_read_stdin(n): the next line or `n` bytes of
/// standard input, Int 0 at its end (the C runtime's raw null). An empty
/// line is interp_empty_read's text: a Str "" compares equal to 0, which
/// core's read_line would take for the end (as p_file_read, 2g.42).
fn interp_read_input(name: str, args: &mut Vec<Value>) -> ExecOutcome {
    if name == "p_read_line" {
        match read_line() {
            Option::Some(line) => {
                if str_len(line) == 0 {
                    return ExecOutcome::Value(Value::Str(interp_empty_read()));
                }
                return ExecOutcome::Value(Value::Str(line));
            }
            Option::None => {
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    var want: i64 = 0;
    if args.len() > 0 {
        match args.get(0) {
            Value::Int(k) => {
                want = k;
            }
            _ => {
            }
        }
    }
    match read_stdin(want) {
        Option::Some(chunk) => {
            if str_len(chunk) == 0 {
                return ExecOutcome::Value(Value::Str(interp_empty_read()));
            }
            return ExecOutcome::Value(Value::Str(chunk));
        }
        Option::None => {
        }
    }
    return ExecOutcome::Value(Value::Int(0));
}

// --- CO9: crash reports ------------------------------------------------------
// A panic under `fid run --crash-file <file>` (or with FID_CRASH_REPORT
// set to a file) writes a report `fid inspect <file>` reads back
// (main.fd cmd_inspect). Programs built through C write the same format
// (codegen_c.fd __p_crash_report). Format, one field per line:
//   fid-crash-report 1
//   version: <the fid build that ran it>
//   program: <the source file>
//   message: <a line of the panic message>     (one per line of it)
//   trace:
//   <the stack trace's lines, innermost call first>
//   end
var g_crash_report_path: str = "";
var g_crash_version: str = "";
var g_crash_program: str = "";

// CO2: environment variables the driver sets for the interpreted program
// only (p_getenv reads them first): fid has no setenv of its own
var g_interp_env_names: Vec<str> = Vec::new();
var g_interp_env_vals: Vec<str> = Vec::new();

pub fn interp_set_env(name: str, value: str) {
    var i: i64 = 0;
    while i < g_interp_env_names.len() {
        if g_interp_env_names.get(i) == name {
            g_interp_env_vals.set(i, value);
            return;
        }
        i = i + 1;
    }
    g_interp_env_names.push(name);
    g_interp_env_vals.push(value);
}

// 2g.60: the interpreted program's command line. Under `fid run x.fd a b`
// the process's arguments are `fid run x.fd a b`; the program sees
// `x.fd a b` (arg_at(0) its file, arg_at(1) its first argument), as a
// built program sees its own. g_interp_arg0 is the index of the program's
// file in the process's arguments (-1: the process's arguments as they
// are), g_interp_arg_from that of its first argument. Found on first use
// (interp_args_detect) unless a driver set them.
var g_interp_arg0: i64 = -1;
var g_interp_arg_from: i64 = 0;
var g_interp_args_known: bool = false;

/// 2g.60: the program's argument 0 is the process's argument `arg0`, its
/// argument 1 the process's argument `first` (-1, 0: the process's own).
pub fn interp_set_program_args(arg0: i64, first: i64) {
    g_interp_arg0 = arg0;
    g_interp_arg_from = first;
    g_interp_args_known = true;
}

/// 2g.60: under `fid [global flags] run <file.fd> args...` the program's
/// file and arguments, found as main.fd's dispatch finds the command (after
/// a `--` when there is one, past the `--` flags). Any other command keeps
/// the process's arguments.
fn interp_args_detect() {
    if g_interp_args_known {
        return;
    }
    g_interp_args_known = true;
    val n: i64 = p_argc();
    var start: i64 = 1;
    var i: i64 = 0;
    while i < n {
        if p_argv(i) == "--" {
            start = i + 1;
            break;
        }
        i = i + 1;
    }
    var c: i64 = start;
    while c < n {
        if !str_starts_with(p_argv(c), "--") {
            break;
        }
        c = c + 1;
    }
    if c + 1 < n {
        if p_argv(c) != "run" {
            return;
        }
        g_interp_arg0 = c + 1;
        g_interp_arg_from = c + 2;
    }
}

/// 2g.60: how many arguments the interpreted program has (its file
/// included).
fn interp_prog_argc() -> i64 {
    interp_args_detect();
    if g_interp_arg0 < 0 {
        return p_argc();
    }
    var rest: i64 = p_argc() - g_interp_arg_from;
    if rest < 0 {
        rest = 0;
    }
    return 1 + rest;
}

/// 2g.60: the process's argument index of the program's argument `i`
/// (-1 for none).
fn interp_prog_argv_index(i: i64) -> i64 {
    interp_args_detect();
    if g_interp_arg0 < 0 {
        return i;
    }
    if i < 0 {
        return -1;
    }
    if i == 0 {
        return g_interp_arg0;
    }
    var at: i64 = g_interp_arg_from + i - 1;
    if at >= p_argc() {
        return -1;
    }
    return at;
}

/// CO9: where a panic's report goes ("" for FID_CRASH_REPORT or none),
/// which build runs (`version`) and the program's file.
pub fn interp_crash_report_setup(path: str, version: str, program: str) {
    g_crash_report_path = path;
    g_crash_version = version;
    g_crash_program = program;
}

/// CO9: the text of a crash report for panic `msg` with stack trace
/// `trace` (Interpreter_format_call_stack's text, "" for none).
pub fn interp_crash_report_text(msg: str, trace: str, version: str, program: str) -> str {
    var out: str = "fid-crash-report 1\n";
    out = out + "version: " + version + "\n";
    out = out + "program: " + program + "\n";
    var mlines: Vec<str> = str_split(msg, "\n");
    var mi: i64 = 0;
    while mi < mlines.len() {
        out = out + "message: " + mlines.get(mi) + "\n";
        mi = mi + 1;
    }
    out = out + "trace:\n";
    var tlines: Vec<str> = str_split(trace, "\n");
    var ti: i64 = 0;
    while ti < tlines.len() {
        var tl: str = tlines.get(ti);
        // the "stack trace:" heading is the report's own "trace:" line
        if str_len(str_trim(tl)) > 0 && str_trim(tl) != "stack trace:" {
            out = out + tl + "\n";
        }
        ti = ti + 1;
    }
    out = out + "end\n";
    return out;
}

/// CO9: write the crash report of panic `msg` (trace `trace`) when one was
/// asked for; says where on stderr.
pub fn interp_write_crash_report(msg: str, trace: str) {
    var path: str = g_crash_report_path;
    if str_len(path) == 0 {
        match env_var("FID_CRASH_REPORT") {
            Option::Some(p) => {
                path = p;
            }
            Option::None => {
            }
        }
    }
    if str_len(path) == 0 {
        return;
    }
    var version: str = g_crash_version;
    if str_len(version) == 0 {
        version = "fid (version not recorded)";
    }
    if p_file_write(path, interp_crash_report_text(msg, trace, version, g_crash_program)) < 0 {
        p_eprint_str("crash report: cannot write " + path + "\n");
        return;
    }
    p_eprint_str("crash report: " + path + " (read it with: fid inspect " + path + ")\n");
}

/// Run main, as `fidesc run` does: the exit code is main's integer result
/// (0 otherwise); a panic prints "Panic: <message>" and the stack trace.
pub fn Interpreter_run_and_print(self: &mut Interpreter) -> i64 {
    var result: RunResult = Interpreter_run(self);
    match result {
        RunResult::Return(v) => {
            match v {
                Value::Int(code) => {
                    return code;
                }
                _ => {
                    return 0;
                }
            }
        }
        RunResult::Panic(msg) => {
            p_eprint_str("Panic: ");
            p_eprint_str(msg);
            p_eprint_str("\n");
            var crash_trace: str = "";
            match Interpreter_take_panic_stack_trace(self) {
                OptStr::Some(trace) => {
                    p_eprint_str(trace);
                    crash_trace = trace;
                }
                OptStr::None => {
                }
            }
            interp_write_crash_report(msg, crash_trace);
            return 1;
        }
        RunResult::Paused => {
            p_eprint_str("Execution paused\n");
            return 0;
        }
    }
    return 1;
}

// ===========================================================================
// Missing helper functions — ported from src/interp.rs
// ===========================================================================

/// coerce_str_to_int — materialize a Str value into memory and return Int(addr).
/// Used when a string value is passed to an I64/U64 parameter.
pub fn Interpreter_coerce_str_to_int(self: &mut Interpreter, v: Value) -> Value {
    match v {
        Value::Str(s) => {
            var addr: i64 = Memory_store_cstr(&mut self.memory, s);
            return Value::Int(addr);
        }
        _ => {
            return v;
        }
    }
}

/// is_wrapping_func — check if the currently executing function is @wrapping.
pub fn Interpreter_is_wrapping_func(self: &Interpreter) -> bool {
    return self.cur_wrapping;
}

/// stringify_value — serialize a Value to a type-prefixed string for persistence.
/// Format: "i:42", "b:true", "f:3.14", "s:hello", "p:0x1234", "pv:elem,elem"
pub fn Interpreter_stringify_value(self: &Interpreter, val: Value) -> str {
    match val {
        Value::Int(n) => {
            return "i:" + int_to_str(n);
        }
        Value::Bool(b) => {
            if b {
                return "b:true";
            }
            return "b:false";
        }
        Value::Float(f) => {
            return "f:" + interp_f64_text(f);
        }
        Value::Str(s) => {
            return "s:" + s;
        }
        Value::Ptr(addr) => {
            // Look up opaque side-table for richer serialization
            var opaque_opt: OptValue = Interpreter_lookup_opaque(self, addr);
            match opaque_opt {
                OptValue::Some(opaque) => {
                    match opaque {
                        Value::Str(s) => {
                            return "ps:" + s;
                        }
                        _ => {
                            return "p:" + int_to_str(addr);
                        }
                    }
                }
                OptValue::None => {
                    return "p:" + int_to_str(addr);
                }
            }
        }
        _ => {
            return "v:void";
        }
    }
}

/// parse_persisted_value — parse a type-prefixed string back into a Value.
pub fn Interpreter_parse_persisted_value(self: &Interpreter, saved: str, default: Value) -> Value {
    var colon_idx: i64 = str_find(saved, ":");
    if colon_idx >= 0 {
        var prefix: str = str_slice(saved, 0, colon_idx + 1);
        var rest: str = str_slice(saved, colon_idx + 1, str_len(saved));
        if prefix == "i:" {
            return Value::Int(str_parse_int(rest));
        }
        if prefix == "b:" {
            return Value::Bool(rest == "true");
        }
        if prefix == "f:" {
            return Value::Float(str_parse_float(rest));
        }
        if prefix == "s:" {
            return Value::Str(rest);
        }
        if prefix == "ps:" {
            return Value::Str(rest);
        }
        if prefix == "p:" {
            return Value::Ptr(str_parse_int(rest));
        }
    }
    return default;
}

/// arg_string — extract a string from a Value argument.
/// Handles Value::Str, Value::Ptr (load C string from memory), and
/// Value::Int (check opaque table or load from memory).
pub fn Interpreter_arg_string(self: &Interpreter, v: Value) -> OptStr {
    match v {
        Value::Str(s) => {
            return OptStr::Some(s);
        }
        Value::Ptr(addr) => {
            if addr > 0 {
                var loaded: str = Memory_load_cstr(&self.memory, addr);
                return OptStr::Some(loaded);
            }
            return OptStr::None;
        }
        Value::Int(i) => {
            if i > 0 {
                // Check opaque side-table first
                var opaque_opt: OptValue = Interpreter_lookup_opaque(self, i);
                match opaque_opt {
                    OptValue::Some(o) => {
                        match o {
                            Value::Str(s) => {
                                return OptStr::Some(s);
                            }
                            _ => {
                            }
                        }
                    }
                    OptValue::None => {
                    }
                }
                // Try loading a null-terminated string from memory
                if Memory_is_valid_addr(&self.memory, i) {
                    var loaded2: str = Memory_load_cstr(&self.memory, i);
                    if str_len(loaded2) > 0 {
                        return OptStr::Some(loaded2);
                    }
                }
            }
            return OptStr::None;
        }
        _ => {
            return OptStr::None;
        }
    }
}

/// lookup_vec_value — look up a Vec Value from an Int/Ptr address.
/// Checks the vec_side_table first, then the opaque_values table.
pub fn Interpreter_lookup_vec_value(self: &Interpreter, arg: Value) -> OptValue {
    match arg {
        Value::Int(addr) => {
            if addr > 0 {
                // Check vec_side_table
                var si: i64 = 0;
                while si < self.vec_side_table.len() {
                    if self.vec_side_table.get(si).vec_addr == addr {
                        var side_idx: i64 = self.vec_side_table.get(si).side_idx;
                        // Look up in opaque_values by side_idx as address
                        return Interpreter_lookup_opaque(self, side_idx);
                    }
                    si = si + 1;
                }
                // Try opaque_values directly
                return Interpreter_lookup_opaque(self, addr);
            }
            return OptValue::None;
        }
        Value::Ptr(addr) => {
            if addr > 0 {
                var si2: i64 = 0;
                while si2 < self.vec_side_table.len() {
                    if self.vec_side_table.get(si2).vec_addr == addr {
                        var side_idx2: i64 = self.vec_side_table.get(si2).side_idx;
                        return Interpreter_lookup_opaque(self, side_idx2);
                    }
                    si2 = si2 + 1;
                }
                return Interpreter_lookup_opaque(self, addr);
            }
            return OptValue::None;
        }
        _ => {
            return OptValue::None;
        }
    }
}

/// read_raw_vec_i64 — read a raw Fides Vec struct from memory.
/// Vec is 32 bytes: { data: i64, len: i64, cap: i64, code word }.
/// Elements are at their size (interp_vec_ld; D14).
pub fn Interpreter_read_raw_vec_i64(self: &Interpreter, addr: i64) -> OptVecI64 {
    if addr == 0 {
        return OptVecI64::None;
    }
    var len: i64 = Memory_load_i64(&self.memory, addr + 8);
    if len < 0 {
        return OptVecI64::None;
    }
    var data: i64 = Memory_load_i64(&self.memory, addr);
    if data <= 0 {
        return OptVecI64::Some(Vec::new());
    }
    var result: Vec<i64> = Vec::new();
    var word: i64 = Memory_load_i64(&self.memory, addr + 24);
    var i: i64 = 0;
    while i < len {
        var elem: i64 = interp_vec_ld(&self.memory, data, i, word);
        result.push(elem);
        i = i + 1;
    }
    return OptVecI64::Some(result);
}

//// arg_to_vec_i64 — extract a Vec<i64> from an argument.
/// Handles Value::Vec (interpreter builtin) and Value::Int/Ptr (raw Fides Vec).
pub fn Interpreter_arg_to_vec_i64(self: &Interpreter, arg: Value) -> OptVecI64 {
    match arg {
        Value::Vec(vec_handle) => {
            return OptVecI64::Some(Interpreter_vec_handle_i64s(self, vec_handle));
        }
        Value::Int(addr) => {
            if addr > 0 {
                match Interpreter_lookup_vec_value(self, arg) {
                    OptValue::Some(v) => {
                        match v {
                            Value::Vec(h) => {
                                return OptVecI64::Some(Interpreter_vec_handle_i64s(self, h));
                            }
                            _ => {
                            }
                        }
                    }
                    OptValue::None => {
                    }
                }
                return Interpreter_read_raw_vec_i64(self, addr);
            }
            return OptVecI64::None;
        }
        Value::Ptr(addr) => {
            if addr > 0 {
                match Interpreter_lookup_vec_value(self, arg) {
                    OptValue::Some(v2) => {
                        match v2 {
                            Value::Vec(h2) => {
                                return OptVecI64::Some(Interpreter_vec_handle_i64s(self, h2));
                            }
                            _ => {
                            }
                        }
                    }
                    OptValue::None => {
                    }
                }
                return Interpreter_read_raw_vec_i64(self, addr);
            }
            return OptVecI64::None;
        }
        _ => {
            return OptVecI64::None;
        }
    }
    return OptVecI64::None;
}

/// The elements of side-table Vec `h` as i64 (non-Int elements read as 0).
pub fn Interpreter_vec_handle_i64s(self: &Interpreter, h: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if h < 0 || h >= self.vec_values.len() {
        return out;
    }
    var elems: Vec<Value> = self.vec_values.get(h).elements;
    var i: i64 = 0;
    while i < elems.len() {
        match elems.get(i) {
            Value::Int(n) => {
                out.push(n);
            }
            _ => {
                out.push(0);
            }
        }
        i = i + 1;
    }
    return out;
}

/// The elements of side-table Vec `h` as f64: an Int is a stored f64 word.
pub fn Interpreter_vec_handle_f64s(self: &Interpreter, h: i64, int_is_bits: bool) -> Vec<f64> {
    var out: Vec<f64> = Vec::new();
    if h < 0 || h >= self.vec_values.len() {
        return out;
    }
    var elems: Vec<Value> = self.vec_values.get(h).elements;
    var i: i64 = 0;
    while i < elems.len() {
        match elems.get(i) {
            Value::Int(n) => {
                if int_is_bits {
                    out.push(f64_from_bits_i(n));
                } else {
                    out.push(n as f64);
                }
            }
            Value::Float(f) => {
                out.push(f);
            }
            _ => {
                out.push(0.0);
            }
        }
        i = i + 1;
    }
    return out;
}

/// A new side-table Vec holding `elems`.
pub fn Interpreter_new_vec_value(self: &mut Interpreter, elems: Vec<Value>) -> Value {
    var handle: i64 = self.vec_values.len();
    var e: VecValueEntry = VecValueEntry_new(handle);
    e.elements = elems;
    self.vec_values.push(e);
    return Value::Vec(handle);
}

/// A side-table Vec of floats.
pub fn Interpreter_new_float_vec(self: &mut Interpreter, fs: Vec<f64>) -> Value {
    var elems: Vec<Value> = Vec::new();
    var i: i64 = 0;
    while i < fs.len() {
        elems.push(Value::Float(fs.get(i)));
        i = i + 1;
    }
    return Interpreter_new_vec_value(self, elems);
}

/// A core Vec<f64> in the interpreter's memory holding `fs` (as the
/// program's own Vecs are: the 40-byte header {data, len, cap, code, tid},
/// 8-byte elements, each the f64's bits), for a builtin whose result the
/// program keeps: the lowering hands it to core's Vec_share / Vec_get /
/// Vec_push, which read the header, so a side-table Value::Vec failed there
/// ("Arithmetic error (vec, int)" in Vec_share). The buffer is a plain
/// block, as p_string_split's: core gives it a share box of its own.
pub fn Interpreter_new_core_f64_vec(self: &mut Interpreter, fs: Vec<f64>) -> Value {
    val n: i64 = fs.len();
    var vec_addr: i64 = Memory_alloc(&mut self.memory, 40);
    if vec_addr == 0 {
        return Value::Int(0);
    }
    var cap: i64 = 0;
    var data: i64 = 0;
    if n > 0 {
        cap = n;
        if cap < 8 {
            cap = 8;
        }
        data = Memory_alloc(&mut self.memory, cap * 8);
        if data == 0 {
            cap = 0;
        }
    }
    var len: i64 = 0;
    if data != 0 {
        var i: i64 = 0;
        while i < n {
            Memory_store_f64(&mut self.memory, data + i * 8, fs.get(i));
            i = i + 1;
        }
        len = n;
    }
    Memory_store_i64(&mut self.memory, vec_addr, data);
    Memory_store_i64(&mut self.memory, vec_addr + 8, len);
    Memory_store_i64(&mut self.memory, vec_addr + 16, cap);
    Memory_store_i64(&mut self.memory, vec_addr + 24, 0);
    Memory_store_i64(&mut self.memory, vec_addr + 32, 0);
    return Value::Ptr(vec_addr);
}

/// alloc_tensor — store a Tensor in the side table and return an opaque Ptr.
/// Value::Ptr(addr) stands in for Rust's Value::Tensor (see file header).
pub fn Interpreter_alloc_tensor(self: &mut Interpreter, t: TensorData) -> Value {
    var addr: i64 = Memory_alloc(&mut self.memory, 8);
    var handle: i64 = self.tensors.len();
    self.tensors.push(t);
    self.tensor_side_table.push(TensorSideEntry_new(addr, handle));
    I64Table_set(&mut self.tensor_index, addr, Value::Int(handle));
    // known by address to the tensor tables: never reused
    I64Table_set(&mut self.memory.blocks, addr, Value::Int(1));
    Memory_store_i64(&mut self.memory, addr, handle);
    return Value::Ptr(addr);
}

/// tensor_handle — resolve a Value::Ptr/Int addr to a tensors index, or -1.
pub fn Interpreter_tensor_handle(self: &Interpreter, arg: Value) -> i64 {
    var addr: i64 = -1;
    match arg {
        Value::Ptr(a) => {
            addr = a;
        }
        Value::Int(a) => {
            addr = a;
        }
        _ => {
        }
    }
    if addr < 0 {
        return -1;
    }
    match I64Table_get(&self.tensor_index, addr) {
        OptValue::Some(hv) => {
            match hv {
                Value::Int(h) => {
                    return h;
                }
                _ => {
                }
            }
        }
        OptValue::None => {
        }
    }
    return -1;
}

/// args_to_f64_vec — extract a Vec<f64> from args[idx].
/// Handles Value::Vec and Value::Int/Ptr (Fides Vec via fides_vec_to_value_vec).
pub fn Interpreter_args_to_f64_vec(self: &mut Interpreter, args: Vec<Value>, idx: i64) -> OptVecF64 {
    if idx < 0 || idx >= args.len() {
        return OptVecF64::None;
    }
    var arg: Value = args.get(idx);
    var ptr: i64 = 0;
    match arg {
        Value::Vec(h) => {
            return OptVecF64::Some(Interpreter_vec_handle_f64s(self, h, true));
        }
        Value::Int(p) => {
            ptr = p;
        }
        Value::Ptr(p2) => {
            ptr = p2;
        }
        _ => {
            return OptVecF64::None;
        }
    }
    // a core Vec: its words read straight from memory (each an f64's
    // bits), not one interpreted Vec_get call per element
    match Interpreter_read_raw_vec_i64(self, ptr) {
        OptVecI64::Some(raw_words) => {
            var raw_fs: Vec<f64> = Vec::new();
            var rwi: i64 = 0;
            while rwi < raw_words.len() {
                raw_fs.push(f64_from_bits_i(raw_words.get(rwi)));
                rwi = rwi + 1;
            }
            return OptVecF64::Some(raw_fs);
        }
        OptVecI64::None => {
        }
    }
    match Interpreter_fides_vec_to_value_vec(self, ptr) {
        Value::Vec(h2) => {
            return OptVecF64::Some(Interpreter_vec_handle_f64s(self, h2, true));
        }
        _ => {
        }
    }
    return OptVecF64::None;
}

/// fides_vec_to_value_vec — convert a Fides Vec (i64 pointer) to a Value::Vec
/// by running the program's Vec_len / Vec_get.
pub fn Interpreter_fides_vec_to_value_vec(self: &mut Interpreter, vec_ptr: i64) -> Value {
    var elems: Vec<Value> = Vec::new();
    match Interpreter_get_function(self, "Vec_len") {
        OptIrFunction::Some(len_fn) => {
            match Interpreter_get_function(self, "Vec_get") {
                OptIrFunction::Some(get_fn) => {
                    var len_args: Vec<Value> = Vec::new();
                    len_args.push(Value::Int(0));
                    len_args.push(Value::Int(vec_ptr));
                    var len: i64 = 0;
                    match Interpreter_run_function(self, len_fn, len_args) {
                        RunResult::Return(v) => {
                            match v {
                                Value::Int(n) => {
                                    len = n;
                                }
                                _ => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                    var i: i64 = 0;
                    while i < len {
                        var get_args: Vec<Value> = Vec::new();
                        get_args.push(Value::Int(0));
                        get_args.push(Value::Int(vec_ptr));
                        get_args.push(Value::Int(i));
                        match Interpreter_run_function(self, get_fn, get_args) {
                            RunResult::Return(gv) => {
                                elems.push(gv);
                            }
                            _ => {
                            }
                        }
                        i = i + 1;
                    }
                }
                OptIrFunction::None => {
                }
            }
        }
        OptIrFunction::None => {
        }
    }
    return Interpreter_new_vec_value(self, elems);
}

/// find_vec_addr — find the Vec struct address for a Value::Vec by scanning vec_side_table.
pub fn Interpreter_find_vec_addr(self: &Interpreter, v: Value) -> i64 {
    match v {
        Value::Vec(target_handle) => {
            var si: i64 = 0;
            while si < self.vec_side_table.len() {
                if self.vec_side_table.get(si).side_idx == target_handle {
                    return self.vec_side_table.get(si).vec_addr;
                }
                si = si + 1;
            }
        }
        _ => {
        }
    }
    return 0;
}

// format_panic_trace — format the panic stack trace as a string.
pub fn Interpreter_format_panic_trace(self: &Interpreter) -> OptStr {
    match self.panic_stack_trace {
        OptStr::Some(s) => {
            return OptStr::Some(s);
        }
        OptStr::None => {
            return OptStr::None;
        }
    }
}

/// take_panic_stack_trace — consume the panic stack trace.
pub fn Interpreter_take_panic_stack_trace(self: &mut Interpreter) -> OptStr {
    var trace: OptStr = self.panic_stack_trace;
    self.panic_stack_trace = OptStr::None;
    return trace;
}

/// get_call_stack — return a copy of the call stack.
pub fn Interpreter_get_call_stack(self: &Interpreter) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < self.call_stack.len() {
        result.push(self.call_stack.get(i));
        i = i + 1;
    }
    return result;
}

