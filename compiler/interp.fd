                Value::Int(i) => { return ExecOutcome::Value(Value::Str(int_to_str(i))); }
                Value::Float(f) => { return ExecOutcome::Value(Value::Str(float_to_str(f))); }
                Value::Bool(b) => {
                    if b { return ExecOutcome::Value(Value::Str("true")); }
                    return ExecOutcome::Value(Value::Str("false"));
                }
                Value::Str(s) => { return ExecOutcome::Value(Value::Str(s)); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_string_len" {
