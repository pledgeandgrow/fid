// interp.fd -- IR Interpreter (self-hosted)
// Ported from src/interp.rs (~6,060 LOC)
//
// Executes Fides IR directly without generating machine code.
// This is the reference interpreter for the `run` command, comptime
// evaluation, debugging, and testing.
//
// Adaptations from Rust:
// 1. HashMap<K,V> -> Vec-based maps with helper structs
// 2. Rc<RefCell<...>> -> Vec side-tables indexed by handle
// 3. String/CompactString -> str
// 4. usize/u64/u32 -> i64 (Fides has no usize)
// 5. struct-style enum variants -> tuple-style (Fides convention)
// 6. Option<T> -> Opt* enums
// 7. closures -> top-level helper functions
// 8. SmallVec -> Vec
// 9. to_le_bytes/from_le_bytes -> manual byte operations via unsafe ptr

module compiler::interp;

use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::green_thread;
use compiler::tensor;

// ===========================================================================
// Value -- runtime value representation
// ===========================================================================
//
// Rust has 13 Value variants. Fides simplifies to 8:
//   Int, Float, Bool, Str, Ptr, Void, Vec, Map
// Tensor/Json/Dyn/Allocator/Future/ThreadHandle are stored as opaque
// pointers (Ptr) with side-table entries when needed.

pub enum Value {
    Int(i64),
    Float(f64),
    Bool(bool),
    Str(str),
    Ptr(i64),
    Void,
    Vec(i64),   // index into interp.vec_side_table
    Map(i64),   // index into interp.map_side_table
}

pub fn Value_int(v: i64) -> Value { return Value::Int(v); }

// A generic container hands back the 8-byte word it stored; a call typed f64
// (a Vec<f64> element via Vec_get) reads those bits as a float. Functions
// declared `-> f64` convert integer results at `return`, so an Int reaching
// such a call is always a stored word.
pub fn interp_reinterpret_word(v: Value, ty: IrType) -> Value {
    match ty {
        IrType::F64 => {
            match v {
                Value::Int(bits) => { return Value::Float(p_f64_from_bits(bits)); }
                _ => { return v; }
            }
        }
        _ => { return v; }
    }
    return v;
}
pub fn Value_float(v: f64) -> Value { return Value::Float(v); }
pub fn Value_bool(v: bool) -> Value { return Value::Bool(v); }
pub fn Value_str(v: str) -> Value { return Value::Str(v); }
pub fn Value_ptr(v: i64) -> Value { return Value::Ptr(v); }
pub fn Value_void() -> Value { return Value::Void; }

/// Check if two values are equal (for PartialEq equivalent)
pub fn value_eq(a: Value, b: Value) -> bool {
    match a {
        Value::Int(x) => {
            match b {
                Value::Int(y) => { return x == y; }
                _ => { return false; }
            }
        }
        Value::Float(x) => {
            match b {
                Value::Float(y) => { return x == y; }
                _ => { return false; }
            }
        }
        Value::Bool(x) => {
            match b {
                Value::Bool(y) => { return x == y; }
                _ => { return false; }
            }
        }
        Value::Str(x) => {
            match b {
                Value::Str(y) => { return x == y; }
                _ => { return false; }
            }
        }
        Value::Ptr(x) => {
            match b {
                Value::Ptr(y) => { return x == y; }
                _ => { return false; }
            }
        }
        Value::Void => {
            match b {
                Value::Void => { return true; }
                _ => { return false; }
            }
        }
        Value::Vec(x) => {
            match b {
                Value::Vec(y) => { return x == y; }
                _ => { return false; }
            }
        }
        Value::Map(x) => {
            match b {
                Value::Map(y) => { return x == y; }
                _ => { return false; }
            }
        }
    }
    return false;
}

/// Check if a value is Void (used for overflow/error detection)
pub fn value_is_void(v: Value) -> bool {
    match v {
        Value::Void => { return true; }
        _ => { return false; }
    }
    return false;
}

// ===========================================================================
// Memory -- byte-addressed simulated memory
// ===========================================================================
//
// Replaces Rust's Vec<u8> with a Fides Vec<i64> where each element
// stores one byte (0-255). This is simpler than bit-packing and
// sufficient for the interpreter's performance needs.

pub struct Memory {
    pub data: Vec<i64>,
    pub next_alloc: i64,
}

pub fn Memory_new() -> Memory {
    var data: Vec<i64> = Vec::new();
    // Pre-allocate 1MB (1048576 bytes)
    var i: i64 = 0;
    while i < 1048576 {
        data.push(0);
        i = i + 1;
    }
    return Memory { data: data, next_alloc: 0x1000 };
}

pub fn Memory_alloc(self: &mut Memory, size: i64) -> i64 {
    if size <= 0 { return self.next_alloc; }
    var addr: i64 = self.next_alloc;
    self.next_alloc = self.next_alloc + size;
    // Grow if needed
    while self.next_alloc >= self.data.len() {
        var i: i64 = 0;
        while i < 4096 {
            self.data.push(0);
            i = i + 1;
        }
    }
    return addr;
}

pub fn Memory_allocated(self: &Memory) -> i64 {
    return self.next_alloc;
}

pub fn Memory_capacity(self: &Memory) -> i64 {
    return self.data.len();
}

pub fn Memory_is_valid_addr(self: &Memory, addr: i64) -> bool {
    return addr >= 0 && addr < self.data.len();
}

// Store a single byte at addr
pub fn Memory_store_byte(self: &mut Memory, addr: i64, b: i64) {
    if addr >= 0 && addr < self.data.len() {
        self.data.set(addr, b & 0xFF);
    }
}

// Load a single byte from addr
pub fn Memory_load_byte(self: &Memory, addr: i64) -> i64 {
    if addr >= 0 && addr < self.data.len() {
        return self.data.get(addr);
    }
    return 0;
}

// Store an i64 (8 bytes, little-endian) at addr
pub fn Memory_store_i64(self: &mut Memory, addr: i64, val: i64) {
    var v: i64 = val;
    var i: i64 = 0;
    while i < 8 {
        Memory_store_byte(self, addr + i, v & 0xFF);
        v = v >> 8;
        i = i + 1;
    }
}

// Load an i64 (8 bytes, little-endian) from addr
pub fn Memory_load_i64(self: &Memory, addr: i64) -> i64 {
    var result: i64 = 0;
    var i: i64 = 0;
    while i < 8 {
        var b: i64 = Memory_load_byte(self, addr + i);
        result = result | (b << (i * 8));
        i = i + 1;
    }
    return result;
}

// Store a bool (1 byte) at addr
pub fn Memory_store_bool(self: &mut Memory, addr: i64, val: bool) {
    if val {
        Memory_store_byte(self, addr, 1);
    } else {
        Memory_store_byte(self, addr, 0);
    }
}

// Load a bool (1 byte) from addr
pub fn Memory_load_bool(self: &Memory, addr: i64) -> bool {
    return Memory_load_byte(self, addr) != 0;
}

// Store an i32 (4 bytes, little-endian) at addr
pub fn Memory_store_i32(self: &mut Memory, addr: i64, val: i64) {
    var v: i64 = val;
    var i: i64 = 0;
    while i < 4 {
        Memory_store_byte(self, addr + i, v & 0xFF);
        v = v >> 8;
        i = i + 1;
    }
}

// Store an i16 (2 bytes, little-endian) at addr
pub fn Memory_store_i16(self: &mut Memory, addr: i64, val: i64) {
    Memory_store_byte(self, addr, val & 0xFF);
    Memory_store_byte(self, addr + 1, (val >> 8) & 0xFF);
}

// Load an i32 (4 bytes, little-endian) from addr
pub fn Memory_load_i32(self: &Memory, addr: i64) -> i64 {
    var result: i64 = 0;
    var i: i64 = 0;
    while i < 4 {
        var b: i64 = Memory_load_byte(self, addr + i);
        result = result | (b << (i * 8));
        i = i + 1;
    }
    // Sign-extend from 32 bits
    if result >= 0x80000000 {
        result = result - 0x100000000;
    }
    return result;
}

// Store an f64 (8 bytes) at addr using p_f64_to_bits
pub fn Memory_store_f64(self: &mut Memory, addr: i64, val: f64) {
    var bits: i64 = p_f64_to_bits(val);
    Memory_store_i64(self, addr, bits);
}

// Load an f64 (8 bytes) from addr using p_f64_from_bits
pub fn Memory_load_f64(self: &Memory, addr: i64) -> f64 {
    var bits: i64 = Memory_load_i64(self, addr);
    return p_f64_from_bits(bits);
}

// Store an f32 (4 bytes) at addr
pub fn Memory_store_f32(self: &mut Memory, addr: i64, val: f64) {
    var bits: i64 = p_f32_to_bits(val);
    Memory_store_i32(self, addr, bits);
}

// Load an f32 (4 bytes) from addr
pub fn Memory_load_f32(self: &Memory, addr: i64) -> f64 {
    var bits: i64 = Memory_load_i32(self, addr);
    return p_f32_from_bits(bits);
}

// Store a null-terminated string at addr, return the address
pub fn Memory_store_cstr(self: &mut Memory, s: str) -> i64 {
    var slen: i64 = str_len(s);
    var addr: i64 = Memory_alloc(self, slen + 1);
    var i: i64 = 0;
    while i < slen {
        // Read byte from string using pointer arithmetic
        var s_addr: i64 = s + i;
        var ptr: *mut u8 = s_addr;
        var b: i64 = 0;
        unsafe { b = *ptr; }
        Memory_store_byte(self, addr + i, b);
        i = i + 1;
    }
    Memory_store_byte(self, addr + slen, 0);
    return addr;
}

// Load a null-terminated C string from addr, return as str
pub fn Memory_load_cstr(self: &Memory, addr: i64) -> str {
    if addr <= 0 { return ""; }
    var result: str = "";
    var offset: i64 = addr;
    while offset < self.data.len() {
        var b: i64 = Memory_load_byte(self, offset);
        if b == 0 { break; }
        result = result + p_char_to_str(b);
        offset = offset + 1;
    }
    return result;
}

// ===========================================================================
// ExecOutcome / RunResult -- instruction and function results
// ===========================================================================

pub enum ExecOutcome {
    Continue,
    Value(Value),
    Jump(i64),
    Return(Value),
    Panic(str),
}

pub enum RunResult {
    Return(Value),
    Panic(str),
    Paused,
}

// ===========================================================================
// Side-table entries for opaque values (Vec, Map, string addrs, globals)
// ===========================================================================
//
// These replace Rust's HashMap<K, V> with Vec-based lookup tables.

pub struct StringAddrEntry {
    pub content: str,
    pub addr: i64,
}

pub fn StringAddrEntry_new(content: str, addr: i64) -> StringAddrEntry {
    return StringAddrEntry { content: content, addr: addr };
}

pub struct GlobalAddrEntry {
    pub name: str,
    pub addr: i64,
}

pub fn GlobalAddrEntry_new(name: str, addr: i64) -> GlobalAddrEntry {
    return GlobalAddrEntry { name: name, addr: addr };
}

pub struct OpaqueEntry {
    pub addr: i64,
    pub value: Value,
}

pub fn OpaqueEntry_new(addr: i64, value: Value) -> OpaqueEntry {
    return OpaqueEntry { addr: addr, value: value };
}

pub struct OpaqueSnapshot {
    pub entries: Vec<OpaqueEntry>,
}

fn Memory_clone(m: &Memory) -> Memory {
    return Memory { data: m.data.clone(), next_alloc: m.next_alloc };
}

pub struct ArrayBoundEntry {
    pub addr: i64,
    pub size: i64,
}

pub fn ArrayBoundEntry_new(addr: i64, size: i64) -> ArrayBoundEntry {
    return ArrayBoundEntry { addr: addr, size: size };
}

pub struct VecSideEntry {
    pub vec_addr: i64,
    pub side_idx: i64,
}

pub fn VecSideEntry_new(vec_addr: i64, side_idx: i64) -> VecSideEntry {
    return VecSideEntry { vec_addr: vec_addr, side_idx: side_idx };
}

// Vec side-table: stores Vec<Value> for interpreter-created Vecs
pub struct VecValueEntry {
    pub handle: i64,
    pub elements: Vec<Value>,
}

pub fn VecValueEntry_new(handle: i64) -> VecValueEntry {
    return VecValueEntry { handle: handle, elements: Vec::new() };
}

// Map side-table: stores key-value pairs for interpreter-created Maps
pub struct MapValueEntry {
    pub handle: i64,
    pub keys: Vec<str>,
    pub vals: Vec<Value>,
}

// Tensor side-table: maps an opaque Ptr addr -> index into interp.tensors.
// Value::Ptr(addr) stands in for Rust's Value::Tensor (see file header).
pub struct TensorSideEntry {
    pub addr: i64,
    pub handle: i64,
}

pub fn TensorSideEntry_new(addr: i64, handle: i64) -> TensorSideEntry {
    return TensorSideEntry { addr: addr, handle: handle };
}

pub fn MapValueEntry_new(handle: i64) -> MapValueEntry {
    return MapValueEntry { handle: handle, keys: Vec::new(), vals: Vec::new() };
}

// ===========================================================================
// Interpreter -- the IR interpreter
// ===========================================================================
//
// Fields mirror src/interp.rs::Interpreter, simplified for self-hosting.
// Advanced features (autograd, futures, channels, ECS, etc.) are stubbed
// or omitted in this initial port. Core execution is fully implemented.

pub struct Interpreter {
    pub module: IrModule,
    pub memory: Memory,
    pub string_addrs: Vec<StringAddrEntry>,
    pub global_addrs: Vec<GlobalAddrEntry>,
    pub opaque_values: Vec<OpaqueEntry>,
    pub vec_side_table: Vec<VecSideEntry>,
    pub vec_values: Vec<VecValueEntry>,
    pub map_values: Vec<MapValueEntry>,
    pub tensors: Vec<TensorData>,
    pub tensor_side_table: Vec<TensorSideEntry>,
    pub kv_caches: Vec<KvCache>,
    pub verbose: bool,
    pub debug_mode: bool,
    pub array_bounds: Vec<ArrayBoundEntry>,
    pub current_func_name: str,
    pub call_stack: Vec<str>,
    pub call_site_lines: Vec<i64>,
    pub pending_call_site: OptU64,
    pub panic_stack_trace: OptStr,
    pub interp_unsafe_depth: i64,
    pub txn_mem_snapshots: Vec<Memory>,
    pub txn_opaque_snapshots: Vec<OpaqueSnapshot>,
    pub max_recursion: i64,
    pub max_steps: i64,
    pub step_count: i64,
    pub max_memory: i64,
    pub region_stack: Vec<str>,
    // PRNG state for DP noise (xorshift128+)
    pub prng_state_a: u64,
    pub prng_state_b: u64,
    // DP epsilon budget tracking
    pub dp_epsilon_budget: f64,
    pub dp_epsilon_limit: f64,
    pub thread_handle_count: i64,
    // Spawn/future results — p_thread_spawn/p_executor_spawn run eagerly and
    // store the thread's return Value here; the Int handle indexes this table.
    pub future_values: Vec<Value>,
    // Cooperative green-thread scheduler (p_gt_* builtins).
    pub gt_scheduler: GreenThreadScheduler,
}

pub fn Interpreter_new(module: IrModule) -> Interpreter {
    var interp: Interpreter = Interpreter {
        module: module,
        memory: Memory_new(),
        string_addrs: Vec::new(),
        global_addrs: Vec::new(),
        opaque_values: Vec::new(),
        vec_side_table: Vec::new(),
        vec_values: Vec::new(),
        map_values: Vec::new(),
        tensors: Vec::new(),
        tensor_side_table: Vec::new(),
        kv_caches: Vec::new(),
        verbose: false,
        debug_mode: true,
        array_bounds: Vec::new(),
        current_func_name: "",
        call_stack: Vec::new(),
        call_site_lines: Vec::new(),
        pending_call_site: OptU64::None,
        panic_stack_trace: OptStr::None,
        interp_unsafe_depth: 0,
        txn_mem_snapshots: Vec::new(),
        txn_opaque_snapshots: Vec::new(),
        max_recursion: 1000,
        max_steps: 0,
        step_count: 0,
        max_memory: 0,
        region_stack: Vec::new(),
        prng_state_a: 0x9E3779B97F4A7C15,
        prng_state_b: 0xBF58476D1CE4E5B9,
        dp_epsilon_budget: 0.0,
        dp_epsilon_limit: 0.0,
        thread_handle_count: 0,
        future_values: Vec::new(),
        gt_scheduler: GreenThreadScheduler_new(),
    };
    Interpreter_init_strings(&mut interp);
    Interpreter_init_globals(&mut interp);
    return interp;
}

pub fn Interpreter_verbose(self: &mut Interpreter) {
    self.verbose = true;
}

pub fn Interpreter_set_max_recursion(self: &mut Interpreter, depth: i64) {
    self.max_recursion = depth;
}

pub fn Interpreter_set_max_steps(self: &mut Interpreter, steps: i64) {
    self.max_steps = steps;
}

pub fn Interpreter_set_max_memory(self: &mut Interpreter, bytes: i64) {
    self.max_memory = bytes;
}

// ===========================================================================
// Lookup helpers for Vec-based maps
// ===========================================================================

pub fn Interpreter_lookup_string_addr(self: &Interpreter, content: str) -> i64 {
    var i: i64 = 0;
    while i < self.string_addrs.len() {
        if self.string_addrs.get(i).content == content {
            return self.string_addrs.get(i).addr;
        }
        i = i + 1;
    }
    return 0;
}

pub fn Interpreter_lookup_global_addr(self: &Interpreter, name: str) -> i64 {
    var i: i64 = 0;
    while i < self.global_addrs.len() {
        if self.global_addrs.get(i).name == name {
            return self.global_addrs.get(i).addr;
        }
        i = i + 1;
    }
    return 0;
}

pub fn Interpreter_lookup_opaque(self: &Interpreter, addr: i64) -> OptValue {
    var i: i64 = 0;
    while i < self.opaque_values.len() {
        if self.opaque_values.get(i).addr == addr {
            return OptValue::Some(self.opaque_values.get(i).value);
        }
        i = i + 1;
    }
    return OptValue::None;
}

pub fn Interpreter_set_opaque(self: &mut Interpreter, addr: i64, value: Value) {
    // Replace existing or add new
    var i: i64 = 0;
    while i < self.opaque_values.len() {
        if self.opaque_values.get(i).addr == addr {
            self.opaque_values.set(i, OpaqueEntry_new(addr, value));
            return;
        }
        i = i + 1;
    }
    self.opaque_values.push(OpaqueEntry_new(addr, value));
}

pub fn Interpreter_remove_opaque(self: &mut Interpreter, addr: i64) {
    // Mark as Void (removing would shift indices; instead set to Void)
    var i: i64 = 0;
    while i < self.opaque_values.len() {
        if self.opaque_values.get(i).addr == addr {
            self.opaque_values.set(i, OpaqueEntry_new(addr, Value::Void));
            return;
        }
        i = i + 1;
    }
}

pub fn Interpreter_lookup_array_bound(self: &Interpreter, addr: i64) -> i64 {
    var i: i64 = 0;
    while i < self.array_bounds.len() {
        if self.array_bounds.get(i).addr == addr {
            return self.array_bounds.get(i).size;
        }
        i = i + 1;
    }
    return -1;
}

pub fn Interpreter_set_array_bound(self: &mut Interpreter, addr: i64, size: i64) {
    self.array_bounds.push(ArrayBoundEntry_new(addr, size));
}

// OptValue for opaque lookups
pub enum OptValue {
    Some(Value),
    None,
}

// OptStr for panic_stack_trace
pub enum OptStr {
    Some(str),
    None,
}

// OptVecI64 for vec extraction helpers
pub enum OptVecI64 {
    Some(Vec<i64>),
    None,
}

// OptVecF64 for vec extraction helpers
pub enum OptVecF64 {
    Some(Vec<f64>),
    None,
}

// ===========================================================================
// init_strings / init_globals
// ===========================================================================

pub fn Interpreter_init_strings(self: &mut Interpreter) {
    var i: i64 = 0;
    while i < self.module.string_constants.len() {
        var s: str = self.module.string_constants.get(i).key;
        var addr: i64 = Memory_store_cstr(&mut self.memory, s);
        self.string_addrs.push(StringAddrEntry_new(s, addr));
        Interpreter_set_opaque(self, addr, Value::Str(s));
        i = i + 1;
    }
}

pub fn Interpreter_init_globals(self: &mut Interpreter) {
    var addr: i64 = 0x00400000;
    var i: i64 = 0;
    while i < self.module.globals.len() {
        var entry: GlobalEntry = self.module.globals.get(i);
        self.global_addrs.push(GlobalAddrEntry_new(entry.name, addr));
        var init_val: Value = eval_global_init(entry.init, entry.ty);
        match init_val {
            Value::Int(v) => { Memory_store_i64(&mut self.memory, addr, v); }
            Value::Float(v) => { Memory_store_f64(&mut self.memory, addr, v); }
            Value::Bool(v) => { Memory_store_bool(&mut self.memory, addr, v); }
            Value::Ptr(v) => { Memory_store_i64(&mut self.memory, addr, v); }
            Value::Str(s) => {
                var str_addr: i64 = Memory_store_cstr(&mut self.memory, s);
                Interpreter_set_opaque(self, str_addr, Value::Str(s));
                Memory_store_i64(&mut self.memory, addr, str_addr);
            }
            _ => { Memory_store_i64(&mut self.memory, addr, 0); }
        }
        addr = addr + 8;
        i = i + 1;
    }
}

pub fn eval_global_init(expr: Expr, ty: IrType) -> Value {
    match expr {
        Expr::IntLit(v) => {
            match ty {
                IrType::Bool => { return Value::Bool(v != 0); }
                _ => { return Value::Int(v); }
            }
        }
        Expr::FloatLit(v) => { return Value::Float(v); }
        Expr::BoolLit(b) => { return Value::Bool(b); }
        Expr::StringLit(s) => { return Value::Str(s); }
        _ => { return Value::Int(0); }
    }
    return Value::Int(0);
}

// ===========================================================================
// value_to_string -- convert a Value to a display string
// ===========================================================================

pub fn Interpreter_value_to_string(self: &Interpreter, v: Value) -> str {
    match v {
        Value::Str(s) => { return s; }
        Value::Ptr(addr) => { return Memory_load_cstr(&self.memory, addr); }
        Value::Int(i) => { return int_to_str(i); }
        Value::Float(f) => { return float_to_str(f); }
        Value::Bool(b) => {
            if b { return "true"; }
            return "false";
        }
        Value::Void => { return "void"; }
        _ => { return ""; }
    }
    return "";
}

// ===========================================================================
// format_call_stack -- for panic stack traces
// ===========================================================================

pub fn Interpreter_format_call_stack(self: &Interpreter) -> str {
    if self.call_stack.len() == 0 { return ""; }
    var out: str = "stack trace:\n";
    var i: i64 = self.call_stack.len() - 1;
    var idx: i64 = 0;
    while i >= 0 {
        var name: str = self.call_stack.get(i);
        var suffix: str = "";
        if i < self.call_site_lines.len() {
            var line: i64 = self.call_site_lines.get(i);
            if line > 0 {
                suffix = " at line " + int_to_str(line);
            }
        }
        if idx == 0 {
            out = out + "    -> " + name + suffix + "\n";
        } else {
            out = out + "    called from " + name + suffix + "\n";
        }
        i = i - 1;
        idx = idx + 1;
    }
    return out;
}

// ===========================================================================
// run -- entry point: find and execute main()
// ===========================================================================

pub fn Interpreter_run(self: &mut Interpreter) -> RunResult {
    match IrModule_get_function(&self.module, "main") {
        OptIrFunction::Some(main_fn) => {
            return Interpreter_run_function(self, main_fn, Vec::new());
        }
        OptIrFunction::None => {
            return RunResult::Panic("No main function found");
        }
    }
    return RunResult::Panic("No main function found");
}

// ===========================================================================
// run_function -- execute a function with arguments
// ===========================================================================

pub fn Interpreter_run_function(self: &mut Interpreter, func: IrFunction, args: Vec<Value>) -> RunResult {
    // Recursion depth check
    if self.call_stack.len() >= self.max_recursion {
        var depth: i64 = self.max_recursion;
        var caller: str = "";
        if self.call_stack.len() > 0 {
            caller = self.call_stack.get(self.call_stack.len() - 1);
        }
        self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
        return RunResult::Panic("Recursion depth limit (" + int_to_str(depth) + ") exceeded in function '" + func.name + "' (called from '" + caller + "')");
    }

    var saved_func_name: str = self.current_func_name;
    self.current_func_name = func.name;
    self.call_stack.push(func.name);
    var saved_call_site: OptU64 = self.pending_call_site;
    self.pending_call_site = OptU64::None;
    var call_line: i64 = 0;
    match saved_call_site {
        OptU64::Some(line) => { call_line = line; }
        OptU64::None => { call_line = 0; }
    }
    self.call_site_lines.push(call_line);

    var saved_region_depth: i64 = self.region_stack.len();

    // Build value table: Vec<ValueIdValue> where index = value_id
    // We use a Vec<Value> indexed by value_id for O(1) lookup.
    var max_val: i64 = func.next_value;
    var values: Vec<Value> = Vec::new();
    var vi: i64 = 0;
    while vi < max_val {
        values.push(Value::Void);
        vi = vi + 1;
    }

    // Detect missing __env param: if first param is Ptr(U8) and caller
    // passed one fewer arg, insert a dummy env value.
    var effective_args: Vec<Value> = Vec::new();
    var has_env_param: bool = false;
    if func.params.len() > 0 {
        var first_param: ValueIdType = func.params.get(0);
        match first_param.ty {
            IrType::Ptr(inner) => {
                match inner {
                    IrType::U8 => { has_env_param = true; }
                    _ => {}
                }
            }
            _ => {}
        }
    }
    if has_env_param && args.len() == func.params.len() - 1 {
        effective_args.push(Value::Int(0));
        var ai: i64 = 0;
        while ai < args.len() {
            effective_args.push(args.get(ai));
            ai = ai + 1;
        }
    } else {
        effective_args = args;
    }

    // Bind parameters
    var pi: i64 = 0;
    while pi < func.params.len() {
        var param: ValueIdType = func.params.get(pi);
        var pval: Value = Value::Void;
        if pi < effective_args.len() {
            pval = effective_args.get(pi);
        }
        // Phase 10B: When a Value::Str is passed to an i64 or pointer param,
        // materialize the string into memory and pass the address.
        match pval {
            Value::Str(s) => {
                var is_i64_or_ptr: bool = false;
                match param.ty {
                    IrType::I64 => { is_i64_or_ptr = true; }
                    IrType::U64 => { is_i64_or_ptr = true; }
                    IrType::Ptr(_) => { is_i64_or_ptr = true; }
                    _ => {}
                }
                if is_i64_or_ptr {
                    var str_addr: i64 = Memory_store_cstr(&mut self.memory, s);
                    Interpreter_set_opaque(self, str_addr, Value::Str(s));
                    match param.ty {
                        IrType::Ptr(_) => { pval = Value::Ptr(str_addr); }
                        _ => { pval = Value::Int(str_addr); }
                    }
                }
            }
            _ => {}
        }
        if param.id < values.len() {
            values.set(param.id, pval);
        }
        pi = pi + 1;
    }

    // Execute basic blocks
    var current_block: i64 = func.entry;
    var result: RunResult = RunResult::Return(Value::Void);

    while true {
        if current_block < 0 || current_block >= func.blocks.len() {
            // No valid block — return void
            result = RunResult::Return(Value::Void);
            break;
        }
        var block: BasicBlock = func.blocks.get(current_block);

        if self.verbose {
            p_eprint_str("  -> block ");
            p_eprint_str(int_to_str(current_block));
            p_eprint_str("\n");
        }

        var next_block: i64 = -1;
        var done: bool = false;
        var ii: i64 = 0;
        while ii < block.instructions.len() {
            var inst_id: i64 = block.instructions.get(ii);

            // Step limit check
            if self.max_steps > 0 {
                self.step_count = self.step_count + 1;
                if self.step_count > self.max_steps {
                    self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
                    result = RunResult::Panic("Step limit exceeded: " + int_to_str(self.step_count) + " instructions executed (limit: " + int_to_str(self.max_steps) + ")");
                    done = true;
                    break;
                }
            }

            // Get the instruction
            var inst_opt: OptInst = IrFunction_get_inst(&func, inst_id);
            match inst_opt {
                OptInst::None => { }
                OptInst::Some(inst) => {
                    var outcome: ExecOutcome = Interpreter_execute_inst(self, inst, inst_id, values, &func);
                    match outcome {
                        ExecOutcome::Continue => { }
                        ExecOutcome::Value(v) => {
                            if inst_id < values.len() {
                                values.set(inst_id, v);
                            }
                        }
                        ExecOutcome::Jump(target) => {
                            next_block = target;
                            done = true;
                            break;
                        }
                        ExecOutcome::Return(rv) => {
                            result = RunResult::Return(rv);
                            done = true;
                            break;
                        }
                        ExecOutcome::Panic(msg) => {
                            // Capture stack trace
                            match self.panic_stack_trace {
                                OptStr::None => {
                                    self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
                                }
                                OptStr::Some(_) => { }
                            }
                            // Transaction rollback
                            if self.txn_mem_snapshots.len() > 0 {
                                var snap_mem: Memory = self.txn_mem_snapshots.get(self.txn_mem_snapshots.len() - 1);
                                self.memory = snap_mem;
                                self.txn_mem_snapshots.pop();
                            }
                            if self.txn_opaque_snapshots.len() > 0 {
                                var snap_opaque: OpaqueSnapshot = self.txn_opaque_snapshots.get(self.txn_opaque_snapshots.len() - 1);
                                self.opaque_values = snap_opaque.entries;
                                self.txn_opaque_snapshots.pop();
                            }
                            result = RunResult::Panic(msg);
                            done = true;
                            break;
                        }
                    }
                }
            }
            ii = ii + 1;
        }

        if done {
            break;
        }

        if next_block >= 0 {
            current_block = next_block;
        } else {
            // No terminator found — return void
            result = RunResult::Return(Value::Void);
            break;
        }
    }

    // Cleanup: restore region_stack depth
    while self.region_stack.len() > saved_region_depth {
        self.region_stack.pop();
    }
    self.current_func_name = saved_func_name;
    self.call_stack.pop();
    self.call_site_lines.pop();

    return result;
}

// ===========================================================================
// get_value -- safe lookup from the value table
// ===========================================================================

pub fn get_value(values: Vec<Value>, id: i64) -> Value {
    if id >= 0 && id < values.len() {
        return values.get(id);
    }
    return Value::Void;
}

// ===========================================================================
// execute_inst -- execute a single IR instruction
// ===========================================================================

pub fn Interpreter_execute_inst(self: &mut Interpreter, inst: Inst, inst_id: i64, values: Vec<Value>, func: &IrFunction) -> ExecOutcome {
    match inst {
        // ─── Constants ───
        Inst::ConstInt(value, ty) => {
            match ty {
                IrType::Bool => { return ExecOutcome::Value(Value::Bool(value != 0)); }
                _ => { return ExecOutcome::Value(Value::Int(value)); }
            }
        }
        Inst::ConstFloat(value, ty) => {
            // value is already an f64 in Fides IR (unlike Rust which stores bits)
            match ty {
                IrType::F32 => { return ExecOutcome::Value(Value::Float(value)); }
                _ => { return ExecOutcome::Value(Value::Float(value)); }
            }
        }
        Inst::ConstBool(value) => {
            return ExecOutcome::Value(Value::Bool(value));
        }
        Inst::ConstStr(value) => {
            return ExecOutcome::Value(Value::Str(value));
        }
        Inst::ConstFnRef(name) => {
            return ExecOutcome::Value(Value::Str(name));
        }
        Inst::ConstNull(_) => {
            return ExecOutcome::Value(Value::Ptr(0));
        }

        // ─── Globals ───
        Inst::GlobalAddr(name, _) => {
            var addr: i64 = Interpreter_lookup_global_addr(self, name);
            return ExecOutcome::Value(Value::Ptr(addr));
        }

        // ─── Arithmetic ───
        Inst::BinOp(op, left, right, _) => {
            var l: Value = get_value(values, left);
            var r: Value = get_value(values, right);
            // String comparison: when both operands are Ptr(U8) (str type),
            // compare content rather than pointer addresses.
            var is_str_cmp: bool = false;
            var left_meta_opt: OptValueMeta = IrFunction_get_meta(func, left);
            var right_meta_opt: OptValueMeta = IrFunction_get_meta(func, right);
            match left_meta_opt {
                OptValueMeta::Some(lm) => {
                    match right_meta_opt {
                        OptValueMeta::Some(rm) => {
                            match lm.ty {
                                IrType::Ptr(linner) => {
                                    match linner {
                                        IrType::U8 => {
                                            match rm.ty {
                                                IrType::Ptr(rinner) => {
                                                    match rinner {
                                                        IrType::U8 => { is_str_cmp = true; }
                                                        _ => {}
                                                    }
                                                }
                                                _ => {}
                                            }
                                        }
                                        _ => {}
                                    }
                                }
                                _ => {}
                            }
                        }
                        OptValueMeta::None => {}
                    }
                }
                OptValueMeta::None => {}
            }
            if is_str_cmp {
                match op {
                    BinOp::Eq => {
                        var l_str: str = Interpreter_value_to_string(self, l);
                        var r_str: str = Interpreter_value_to_string(self, r);
                        return ExecOutcome::Value(Value::Bool(l_str == r_str));
                    }
                    BinOp::Neq => {
                        var l_str2: str = Interpreter_value_to_string(self, l);
                        var r_str2: str = Interpreter_value_to_string(self, r);
                        return ExecOutcome::Value(Value::Bool(l_str2 != r_str2));
                    }
                    _ => {}
                }
            }
            var result: Value = Interpreter_eval_binop(self, op, l, r);
            if value_is_void(result) {
                var msg: str = "Arithmetic error";
                match op {
                    BinOp::Add => { msg = "Integer overflow on addition"; }
                    BinOp::Sub => { msg = "Integer overflow on subtraction"; }
                    BinOp::Mul => { msg = "Integer overflow on multiplication"; }
                    BinOp::Div => { msg = "Division by zero"; }
                    BinOp::Mod => { msg = "Modulo by zero"; }
                    _ => { msg = "Arithmetic error"; }
                }
                return ExecOutcome::Panic(msg);
            }
            return ExecOutcome::Value(result);
        }

        Inst::UnaryOp(op, operand, _) => {
            var v: Value = get_value(values, operand);
            var result: Value = Interpreter_eval_unaryop(self, op, v);
            return ExecOutcome::Value(result);
        }

        // ─── Memory ───
        Inst::Alloca(ty, _) => {
            var size: i64 = IrModule_type_size(&self.module, ty);
            if size < 1 { size = 1; }
            // Memory limit check
            if self.max_memory > 0 {
                var current: i64 = Memory_allocated(&self.memory);
                if current + size > self.max_memory {
                    self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
                    return ExecOutcome::Panic("Memory limit exceeded");
                }
            }
            var addr: i64 = Memory_alloc(&mut self.memory, size);
            // Track array bounds
            match ty {
                IrType::Array(_, arr_size) => {
                    Interpreter_set_array_bound(self, addr, arr_size);
                }
                _ => {}
            }
            return ExecOutcome::Value(Value::Ptr(addr));
        }

        Inst::Load(ptr, ty) => {
            var addr: i64 = 0;
            match get_value(values, ptr) {
                Value::Ptr(a) => { addr = a; }
                Value::Int(i) => { addr = i; }
                Value::Str(s) => {
                    addr = Memory_store_cstr(&mut self.memory, s);
                }
                _ => { addr = 0; }
            }
            // Check opaque side-table first (for Vec, Map, Str, Ptr values)
            match Interpreter_lookup_opaque(self, addr) {
                OptValue::Some(ov) => {
                    match ov {
                        Value::Ptr(_) => { return ExecOutcome::Value(ov); }
                        Value::Vec(_) => { return ExecOutcome::Value(ov); }
                        Value::Map(_) => { return ExecOutcome::Value(ov); }
                        Value::Str(_) => { return ExecOutcome::Value(ov); }
                        _ => {}
                    }
                }
                OptValue::None => {}
            }
            // Load from byte memory based on type
            match ty {
                IrType::I8 => {
                    var b: i64 = Memory_load_byte(&self.memory, addr);
                    // Sign-extend from 8 bits
                    if b >= 128 { b = b - 256; }
                    return ExecOutcome::Value(Value::Int(b));
                }
                IrType::U8 => {
                    return ExecOutcome::Value(Value::Int(Memory_load_byte(&self.memory, addr)));
                }
                IrType::I16 => {
                    var lo: i64 = Memory_load_byte(&self.memory, addr);
                    var hi: i64 = Memory_load_byte(&self.memory, addr + 1);
                    var v: i64 = lo | (hi << 8);
                    if v >= 32768 { v = v - 65536; }
                    return ExecOutcome::Value(Value::Int(v));
                }
                IrType::U16 => {
                    var lo: i64 = Memory_load_byte(&self.memory, addr);
                    var hi: i64 = Memory_load_byte(&self.memory, addr + 1);
                    return ExecOutcome::Value(Value::Int(lo | (hi << 8)));
                }
                IrType::I32 => {
                    return ExecOutcome::Value(Value::Int(Memory_load_i32(&self.memory, addr)));
                }
                IrType::U32 => {
                    return ExecOutcome::Value(Value::Int(Memory_load_i32(&self.memory, addr)));
                }
                IrType::I64 => {
                    return ExecOutcome::Value(Value::Int(Memory_load_i64(&self.memory, addr)));
                }
                IrType::U64 => {
                    return ExecOutcome::Value(Value::Int(Memory_load_i64(&self.memory, addr)));
                }
                IrType::F32 => {
                    return ExecOutcome::Value(Value::Float(Memory_load_f32(&self.memory, addr)));
                }
                IrType::F64 => {
                    return ExecOutcome::Value(Value::Float(Memory_load_f64(&self.memory, addr)));
                }
                IrType::Bool => {
                    return ExecOutcome::Value(Value::Bool(Memory_load_bool(&self.memory, addr)));
                }
                IrType::Ptr(_) => {
                    return ExecOutcome::Value(Value::Ptr(Memory_load_i64(&self.memory, addr)));
                }
                IrType::Opaque(_) => {
                    // Check side-table again for opaque types
                    match Interpreter_lookup_opaque(self, addr) {
                        OptValue::Some(ov2) => { return ExecOutcome::Value(ov2); }
                        OptValue::None => {
                            return ExecOutcome::Value(Value::Ptr(Memory_load_i64(&self.memory, addr)));
                        }
                    }
                }
                IrType::Generic(_, _) => {
                    // Check side-table again for generic types
                    match Interpreter_lookup_opaque(self, addr) {
                        OptValue::Some(ov3) => { return ExecOutcome::Value(ov3); }
                        OptValue::None => {
                            return ExecOutcome::Value(Value::Ptr(Memory_load_i64(&self.memory, addr)));
                        }
                    }
                }
                _ => {
                    return ExecOutcome::Value(Value::Ptr(addr));
                }
            }
        }

        Inst::Store(ptr, value, sty_opt) => {
            var addr: i64 = 0;
            match get_value(values, ptr) {
                Value::Ptr(a) => { addr = a; }
                _ => { addr = 0; }
            }
            var v: Value = get_value(values, value);
            // Clear any stale opaque entry
            Interpreter_remove_opaque(self, addr);
            // Resolve store width: explicit OptIrType wins, else the value's
            // declared meta type, else I64 (matches src/interp.rs:1497-1512).
            var sty: IrType = IrType::I64;
            match sty_opt {
                OptIrType::Some(t) => { sty = t; }
                OptIrType::None => {
                    match IrFunction_get_meta(func, value) {
                        OptValueMeta::Some(vm) => { sty = vm.ty; }
                        OptValueMeta::None => {}
                    }
                }
            }
            match v {
                Value::Int(iv) => {
                    match sty {
                        IrType::I8 => { Memory_store_byte(&mut self.memory, addr, iv & 0xFF); }
                        IrType::U8 => { Memory_store_byte(&mut self.memory, addr, iv & 0xFF); }
                        IrType::Bool => { Memory_store_byte(&mut self.memory, addr, iv & 1); }
                        IrType::I16 => { Memory_store_i16(&mut self.memory, addr, iv); }
                        IrType::U16 => { Memory_store_i16(&mut self.memory, addr, iv); }
                        IrType::I32 => { Memory_store_i32(&mut self.memory, addr, iv); }
                        IrType::U32 => { Memory_store_i32(&mut self.memory, addr, iv); }
                        _ => { Memory_store_i64(&mut self.memory, addr, iv); }
                    }
                }
                Value::Float(fv) => {
                    match sty {
                        IrType::F32 => { Memory_store_f32(&mut self.memory, addr, fv); }
                        _ => { Memory_store_f64(&mut self.memory, addr, fv); }
                    }
                }
                Value::Bool(bv) => {
                    Memory_store_bool(&mut self.memory, addr, bv);
                }
                Value::Ptr(pv) => {
                    Memory_store_i64(&mut self.memory, addr, pv);
                }
                Value::Str(s) => {
                    var str_addr: i64 = Memory_store_cstr(&mut self.memory, s);
                    Memory_store_i64(&mut self.memory, addr, str_addr);
                    Interpreter_set_opaque(self, addr, Value::Str(s));
                }
                Value::Vec(_) => {
                    // Opaque values stored in side-table
                    Interpreter_set_opaque(self, addr, v);
                }
                Value::Map(_) => {
                    // Opaque values stored in side-table
                    Interpreter_set_opaque(self, addr, v);
                }
                _ => {}
            }
            return ExecOutcome::Continue;
        }

        Inst::GetFieldPtr(struct_ptr, field_index, _) => {
            var base: i64 = 0;
            match get_value(values, struct_ptr) {
                Value::Ptr(a) => { base = a; }
                Value::Int(n) => { base = n; }
                _ => { base = 0; }
            }
            // Look up real field offset from struct layout
            var struct_name: str = "";
            var meta_opt: OptValueMeta = IrFunction_get_meta(func, struct_ptr);
            match meta_opt {
                OptValueMeta::Some(m) => {
                    match m.ty {
                        IrType::Ptr(inner) => {
                            match inner {
                                IrType::Struct(name) => { struct_name = name; }
                                _ => {}
                            }
                        }
                        IrType::Struct(name) => { struct_name = name; }
                        _ => {}
                    }
                }
                OptValueMeta::None => {}
            }
            var offset: i64 = field_index * 8;
            if str_len(struct_name) > 0 {
                match IrModule_get_struct(&self.module, struct_name) {
                    OptStructLayout::Some(layout) => {
                        if field_index >= 0 && field_index < layout.fields.len() {
                            var field: StringIrTypeOffset = layout.fields.get(field_index);
                            offset = field.offset;
                        }
                    }
                    OptStructLayout::None => {}
                }
            }
            return ExecOutcome::Value(Value::Ptr(base + offset));
        }

        Inst::GetElemPtr(base_ptr, index, elem_ty) => {
            var base: i64 = 0;
            match get_value(values, base_ptr) {
                Value::Ptr(a) => { base = a; }
                Value::Int(n) => { base = n; }
                _ => { base = 0; }
            }
            var idx_val: i64 = 0;
            match get_value(values, index) {
                Value::Int(i) => { idx_val = i; }
                _ => { idx_val = 0; }
            }
            // Bounds checking (when not in unsafe block)
            if self.interp_unsafe_depth == 0 {
                if idx_val < 0 {
                    return ExecOutcome::Panic("Array index out of bounds: negative index " + int_to_str(idx_val));
                }
                var arr_size: i64 = Interpreter_lookup_array_bound(self, base);
                if arr_size >= 0 && idx_val >= arr_size {
                    return ExecOutcome::Panic("Array index out of bounds: index " + int_to_str(idx_val) + " but array has " + int_to_str(arr_size) + " elements");
                }
            }
            var elem_size: i64 = IrModule_type_size(&self.module, elem_ty);
            if elem_size < 1 { elem_size = 1; }
            return ExecOutcome::Value(Value::Ptr(base + idx_val * elem_size));
        }

        // ─── Control Flow ───
        Inst::Jump(target) => {
            return ExecOutcome::Jump(target);
        }
        Inst::Branch(cond, then_block, else_block) => {
            var c: bool = false;
            match get_value(values, cond) {
                Value::Bool(b) => { c = b; }
                Value::Int(i) => { c = (i != 0); }
                _ => { c = false; }
            }
            if c {
                return ExecOutcome::Jump(then_block);
            } else {
                return ExecOutcome::Jump(else_block);
            }
        }
        Inst::Return(opt_val) => {
            match opt_val {
                OptValueId::Some(id) => {
                    return ExecOutcome::Return(get_value(values, id));
                }
                OptValueId::None => {
                    return ExecOutcome::Return(Value::Void);
                }
            }
        }
        Inst::Unreachable => {
            return ExecOutcome::Panic("Reached unreachable instruction");
        }

        // ─── Function Calls ───
        Inst::Call(name, arg_ids, call_ret_ty, _) => {
            var arg_vals: Vec<Value> = Vec::new();
            var ai: i64 = 0;
            while ai < arg_ids.len() {
                arg_vals.push(get_value(values, arg_ids.get(ai)));
                ai = ai + 1;
            }
            // Check if it's a runtime function
            if Interpreter_is_runtime_func(self, name) {
                return Interpreter_call_runtime(self, name, arg_vals);
            }
            // Check if it's a user function
            match IrModule_get_function(&self.module, name) {
                OptIrFunction::Some(callee) => {
                    // Record call site
                    var meta_opt2: OptValueMeta = IrFunction_get_meta(func, inst_id);
                    match meta_opt2 {
                        OptValueMeta::Some(m2) => {
                            match m2.source_line {
                                OptU64::Some(sl) => { self.pending_call_site = OptU64::Some(sl); }
                                OptU64::None => { self.pending_call_site = OptU64::None; }
                            }
                        }
                        OptValueMeta::None => { self.pending_call_site = OptU64::None; }
                    }
                    var result: RunResult = Interpreter_run_function(self, callee, arg_vals);
                    match result {
                        RunResult::Return(v) => { return ExecOutcome::Value(interp_reinterpret_word(v, call_ret_ty)); }
                        RunResult::Panic(msg) => { return ExecOutcome::Panic(msg); }
                        RunResult::Paused => { return ExecOutcome::Continue; }
                    }
                }
                OptIrFunction::None => {
                    return ExecOutcome::Panic("Unknown function '" + name + "'");
                }
            }
        }

        Inst::CallPtr(fn_ptr, arg_ids, _, _, _) => {
            var arg_vals2: Vec<Value> = Vec::new();
            var ai2: i64 = 0;
            while ai2 < arg_ids.len() {
                arg_vals2.push(get_value(values, arg_ids.get(ai2)));
                ai2 = ai2 + 1;
            }
            // Function pointer is an env struct: field 0 = fn name string
            var fn_name: str = "";
            var env_ptr: i64 = 0;
            match get_value(values, fn_ptr) {
                Value::Str(s) => {
                    fn_name = s;
                }
                Value::Ptr(addr) => {
                    // Read fn name pointer from field 0
                    var fn_ptr_addr: i64 = Memory_load_i64(&self.memory, addr);
                    fn_name = Memory_load_cstr(&self.memory, fn_ptr_addr);
                    env_ptr = addr;
                }
                _ => {
                    return ExecOutcome::Panic("CallPtr: function pointer is not a string or pointer");
                }
            }
            if Interpreter_is_runtime_func(self, fn_name) {
                return Interpreter_call_runtime(self, fn_name, arg_vals2);
            }
            match IrModule_get_function(&self.module, fn_name) {
                OptIrFunction::Some(callee2) => {
                    var all_args: Vec<Value> = Vec::new();
                    if callee2.params.len() > arg_vals2.len() {
                        if env_ptr > 0 {
                            all_args.push(Value::Ptr(env_ptr));
                        } else {
                            all_args.push(Value::Int(0));
                        }
                    }
                    var xi: i64 = 0;
                    while xi < arg_vals2.len() {
                        all_args.push(arg_vals2.get(xi));
                        xi = xi + 1;
                    }
                    var result2: RunResult = Interpreter_run_function(self, callee2, all_args);
                    match result2 {
                        RunResult::Return(v2) => { return ExecOutcome::Value(v2); }
                        RunResult::Panic(msg2) => { return ExecOutcome::Panic(msg2); }
                        RunResult::Paused => { return ExecOutcome::Continue; }
                    }
                }
                OptIrFunction::None => {
                    return ExecOutcome::Panic("Unknown function in CallPtr: '" + fn_name + "'");
                }
            }
        }

        Inst::MakeDyn(value, type_name, _) => {
            var data_ptr: i64 = 0;
            match get_value(values, value) {
                Value::Ptr(p) => { data_ptr = p; }
                Value::Int(i) => { data_ptr = i; }
                _ => { data_ptr = 0; }
            }
            // Store type_name as a string for DynCall lookup
            return ExecOutcome::Value(Value::Str(type_name));
        }

        Inst::DynCall(trait_name, method, arg_ids, _, _) => {
            var arg_vals3: Vec<Value> = Vec::new();
            var ai3: i64 = 0;
            while ai3 < arg_ids.len() {
                arg_vals3.push(get_value(values, arg_ids.get(ai3)));
                ai3 = ai3 + 1;
            }
            // First arg is the receiver (Dyn or Str with type name)
            var type_name: str = "";
            var all_args3: Vec<Value> = Vec::new();
            if arg_vals3.len() > 0 {
                match arg_vals3.get(0) {
                    Value::Str(s) => { type_name = s; }
                    _ => { type_name = ""; }
                }
            }
            var mangled: str = type_name + "_" + method;
            match IrModule_get_function(&self.module, mangled) {
                OptIrFunction::Some(callee3) => {
                    if callee3.params.len() > arg_vals3.len() {
                        all_args3.push(Value::Int(0));
                    }
                    var zi: i64 = 0;
                    while zi < arg_vals3.len() {
                        all_args3.push(arg_vals3.get(zi));
                        zi = zi + 1;
                    }
                    var result3: RunResult = Interpreter_run_function(self, callee3, all_args3);
                    match result3 {
                        RunResult::Return(v3) => { return ExecOutcome::Value(v3); }
                        RunResult::Panic(msg3) => { return ExecOutcome::Panic(msg3); }
                        RunResult::Paused => { return ExecOutcome::Continue; }
                    }
                }
                OptIrFunction::None => {
                    return ExecOutcome::Panic("DynCall: no method '" + method + "' on type '" + type_name + "' (looked for '" + mangled + "')");
                }
            }
        }

        // ─── Conversions ───
        Inst::BitCast(value, _, to) => {
            var v: Value = get_value(values, value);
            return ExecOutcome::Value(Interpreter_cast_value(self, v, to));
        }
        Inst::IntExtend(value, _, _) => {
            var v: Value = get_value(values, value);
            match v {
                Value::Int(i) => { return ExecOutcome::Value(Value::Int(i)); }
                _ => { return ExecOutcome::Value(Value::Int(0)); }
            }
        }
        Inst::IntTrunc(value, _, to) => {
            var v: Value = get_value(values, value);
            match v {
                Value::Int(i) => {
                    match to {
                        IrType::I8 => {
                            var t: i64 = i & 0xFF;
                            if t >= 128 { t = t - 256; }
                            return ExecOutcome::Value(Value::Int(t));
                        }
                        IrType::I16 => {
                            var t2: i64 = i & 0xFFFF;
                            if t2 >= 32768 { t2 = t2 - 65536; }
                            return ExecOutcome::Value(Value::Int(t2));
                        }
                        IrType::I32 => {
                            var t3: i64 = i & 0xFFFFFFFF;
                            if t3 >= 0x80000000 { t3 = t3 - 0x100000000; }
                            return ExecOutcome::Value(Value::Int(t3));
                        }
                        IrType::U8 => { return ExecOutcome::Value(Value::Int(i & 0xFF)); }
                        IrType::U16 => { return ExecOutcome::Value(Value::Int(i & 0xFFFF)); }
                        IrType::U32 => { return ExecOutcome::Value(Value::Int(i & 0xFFFFFFFF)); }
                        _ => { return ExecOutcome::Value(Value::Int(i)); }
                    }
                }
                _ => { return ExecOutcome::Value(Value::Int(0)); }
            }
        }
        Inst::IntToFloat(value, _, _) => {
            var v: Value = get_value(values, value);
            match v {
                Value::Int(i) => {
                    var f: f64 = p_int_to_float(i);
                    return ExecOutcome::Value(Value::Float(f));
                }
                _ => { return ExecOutcome::Value(Value::Float(0.0)); }
            }
        }
        Inst::FloatToInt(value, _, _) => {
            var v: Value = get_value(values, value);
            match v {
                Value::Float(f) => {
                    var i: i64 = p_float_to_int(f);
                    return ExecOutcome::Value(Value::Int(i));
                }
                _ => { return ExecOutcome::Value(Value::Int(0)); }
            }
        }

        // ─── Fides-Specific ───
        Inst::TryUnwrap(value, ok_block, _, _) => {
            return ExecOutcome::Jump(ok_block);
        }
        Inst::Print(value, ty) => {
            var v: Value = get_value(values, value);
            // Ptr(U8) typed values stored as Int should be printed as strings
            match ty {
                IrType::Ptr(inner) => {
                    match inner {
                        IrType::U8 => {
                            match v {
                                Value::Int(addr) => {
                                    if addr > 0 && Memory_is_valid_addr(&self.memory, addr) {
                                        var s: str = Memory_load_cstr(&self.memory, addr);
                                        if str_len(s) > 0 {
                                            p_print_str(s);
                                            return ExecOutcome::Continue;
                                        }
                                    }
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            // Default printing
            match v {
                Value::Int(i) => { p_print_int(i); }
                Value::Float(f) => { p_print_float(f); }
                Value::Bool(b) => { p_print_bool(b); }
                Value::Str(s) => { p_print_str(s); }
                Value::Ptr(addr2) => {
                    var s2: str = Memory_load_cstr(&self.memory, addr2);
                    if str_len(s2) > 0 {
                        p_print_str(s2);
                    } else {
                        p_print_str("ptr(0x");
                        p_print_str(int_to_str(addr2));
                        p_print_str(")");
                    }
                }
                _ => { p_print_str("void"); }
            }
            return ExecOutcome::Continue;
        }
        Inst::Panic(message) => {
            return ExecOutcome::Panic(message);
        }
        Inst::Asm(_, _, _, ret_ty) => {
            // Interpreter: no actual assembly execution
            match ret_ty {
                IrType::Void => { return ExecOutcome::Continue; }
                _ => { return ExecOutcome::Value(Value::Int(0)); }
            }
        }

        // ─── Region Management ───
        Inst::RegionBegin(name, _, _, _) => {
            self.region_stack.push(name);
            return ExecOutcome::Value(Value::Int(0));
        }
        Inst::RegionEnd(_, _, _) => {
            if self.region_stack.len() > 0 {
                self.region_stack.pop();
            }
            return ExecOutcome::Continue;
        }

        // ─── Persist Variables ───
        Inst::PersistLoad(name, default, _) => {
            // Simplified: just use the default value
            var dv: Value = get_value(values, default);
            return ExecOutcome::Value(dv);
        }
        Inst::PersistSave(_, _) => {
            return ExecOutcome::Continue;
        }

        // ─── Transaction Blocks ───
        Inst::TxnBegin => {
            // Deep snapshot — a struct copy would share the Vec backing, so
            // post-snapshot writes would already be visible in the "snapshot".
            self.txn_mem_snapshots.push(Memory_clone(&self.memory));
            self.txn_opaque_snapshots.push(OpaqueSnapshot { entries: self.opaque_values.clone() });
            return ExecOutcome::Continue;
        }
        Inst::TxnEnd => {
            if self.txn_mem_snapshots.len() > 0 {
                self.txn_mem_snapshots.pop();
            }
            if self.txn_opaque_snapshots.len() > 0 {
                self.txn_opaque_snapshots.pop();
            }
            return ExecOutcome::Continue;
        }

        // ─── Unsafe Blocks ───
        Inst::UnsafeBegin => {
            self.interp_unsafe_depth = self.interp_unsafe_depth + 1;
            return ExecOutcome::Continue;
        }
        Inst::UnsafeEnd => {
            if self.interp_unsafe_depth > 0 {
                self.interp_unsafe_depth = self.interp_unsafe_depth - 1;
            }
            return ExecOutcome::Continue;
        }

        // ─── Autograd (stubbed) ───
        Inst::GradBegin(_) => { return ExecOutcome::Continue; }
        Inst::GradEnd => { return ExecOutcome::Continue; }
        Inst::Backward(_) => { return ExecOutcome::Continue; }
        Inst::StructCopy(dst, src, ty) => {
            // memcpy struct data src -> dst (src/interp.rs:1604)
            var dst_addr: i64 = 0;
            match get_value(values, dst) {
                Value::Ptr(a) => { dst_addr = a; }
                Value::Int(n) => { dst_addr = n; }
                _ => {}
            }
            var src_addr: i64 = 0;
            match get_value(values, src) {
                Value::Ptr(a) => { src_addr = a; }
                Value::Int(n) => { src_addr = n; }
                _ => {}
            }
            var size: i64 = IrModule_type_size(&self.module, ty);
            var ci: i64 = 0;
            while ci < size {
                var b: i64 = Memory_load_byte(&self.memory, src_addr + ci);
                Memory_store_byte(&mut self.memory, dst_addr + ci, b);
                ci = ci + 1;
            }
            return ExecOutcome::Continue;
        }
    }
    return ExecOutcome::Continue;
}

// ===========================================================================
// eval_binop -- evaluate a binary operation
// ===========================================================================

pub fn Interpreter_eval_binop(self: &Interpreter, op: BinOp, l: Value, r: Value) -> Value {
    match l {
        Value::Int(a) => {
            match r {
                Value::Int(b) => {
                    var i64_max: i64 = 9223372036854775807;
                    var i64_min: i64 = 0 - 9223372036854775807 - 1;
                    var use_wrapping: bool = Interpreter_is_wrapping_func(self);
                    match op {
                        BinOp::Add => {
                            if !use_wrapping {
                                // Pre-check: computing a+b under a checked host would
                                // trap before we can test the result.
                                if b > 0 && a > i64_max - b { return Value::Void; }
                                if b < 0 && a < i64_min - b { return Value::Void; }
                            }
                            return Value::Int(a + b);
                        }
                        BinOp::Sub => {
                            if !use_wrapping {
                                if b > 0 && a < i64_min + b { return Value::Void; }
                                if b < 0 && a > i64_max + b { return Value::Void; }
                            }
                            return Value::Int(a - b);
                        }
                        BinOp::Mul => {
                            if !use_wrapping {
                                // CERT-style division pre-checks; all divisions are
                                // exact-or-toward-zero and cannot themselves overflow.
                                var mul_ovf: bool = false;
                                if a > 0 {
                                    if b > 0 { mul_ovf = a > i64_max / b; }
                                    else if b < 0 { mul_ovf = b < i64_min / a; }
                                } else if a < 0 {
                                    if b > 0 { mul_ovf = a < i64_min / b; }
                                    else if b < 0 { mul_ovf = a < i64_max / b; }
                                }
                                if mul_ovf { return Value::Void; }
                            }
                            return Value::Int(a * b);
                        }
                        BinOp::Div => {
                            if b == 0 { return Value::Void; }
                            if b == -1 && a == i64_min { return Value::Int(i64_min); }
                            return Value::Int(a / b);
                        }
                        BinOp::Mod => {
                            if b == 0 { return Value::Void; }
                            if b == -1 && a == i64_min { return Value::Int(0); }
                            return Value::Int(a % b);
                        }
                        BinOp::Eq => { return Value::Bool(a == b); }
                        BinOp::Neq => { return Value::Bool(a != b); }
                        BinOp::Lt => { return Value::Bool(a < b); }
                        BinOp::Gt => { return Value::Bool(a > b); }
                        BinOp::LtEq => { return Value::Bool(a <= b); }
                        BinOp::GtEq => { return Value::Bool(a >= b); }
                        BinOp::And => { return Value::Bool(a != 0 && b != 0); }
                        BinOp::Or => { return Value::Bool(a != 0 || b != 0); }
                        BinOp::BitAnd => { return Value::Int(a & b); }
                        BinOp::BitOr => { return Value::Int(a | b); }
                        BinOp::BitXor => { return Value::Int(a ^ b); }
                        BinOp::Shl => { return Value::Int(a << b); }
                        BinOp::Shr => { return Value::Int(a >> b); }
                    }
                }
                Value::Ptr(b_addr) => {
                    match op {
                        BinOp::Add => { return Value::Ptr(a + b_addr); }
                        BinOp::Eq => { return Value::Bool(a == b_addr); }
                        BinOp::Neq => { return Value::Bool(a != b_addr); }
                        BinOp::Lt => { return Value::Bool(a < b_addr); }
                        BinOp::LtEq => { return Value::Bool(a <= b_addr); }
                        BinOp::Gt => { return Value::Bool(a > b_addr); }
                        BinOp::GtEq => { return Value::Bool(a >= b_addr); }
                        _ => { return Value::Void; }
                    }
                }
                _ => { return Value::Void; }
            }
        }
        Value::Float(a) => {
            match r {
                Value::Float(b) => {
                    match op {
                        BinOp::Add => { return Value::Float(a + b); }
                        BinOp::Sub => { return Value::Float(a - b); }
                        BinOp::Mul => { return Value::Float(a * b); }
                        BinOp::Div => { return Value::Float(a / b); }
                        BinOp::Mod => { return Value::Float(a % b); }
                        BinOp::Eq => { return Value::Bool(a == b); }
                        BinOp::Neq => { return Value::Bool(a != b); }
                        BinOp::Lt => { return Value::Bool(a < b); }
                        BinOp::Gt => { return Value::Bool(a > b); }
                        BinOp::LtEq => { return Value::Bool(a <= b); }
                        BinOp::GtEq => { return Value::Bool(a >= b); }
                        _ => { return Value::Float(0.0); }
                    }
                }
                _ => { return Value::Void; }
            }
        }
        Value::Bool(a) => {
            match r {
                Value::Bool(b) => {
                    match op {
                        BinOp::Eq => { return Value::Bool(a == b); }
                        BinOp::Neq => { return Value::Bool(a != b); }
                        BinOp::And => { return Value::Bool(a && b); }
                        BinOp::Or => { return Value::Bool(a || b); }
                        _ => { return Value::Bool(false); }
                    }
                }
                _ => { return Value::Void; }
            }
        }
        Value::Str(a) => {
            match r {
                Value::Str(b) => {
                    match op {
                        BinOp::Eq => { return Value::Bool(a == b); }
                        BinOp::Neq => { return Value::Bool(a != b); }
                        _ => { return Value::Void; }
                    }
                }
                Value::Int(b2) => {
                    match op {
                        BinOp::Eq => { return Value::Bool(str_len(a) == 0 && b2 == 0); }
                        BinOp::Neq => { return Value::Bool(!(str_len(a) == 0 && b2 == 0)); }
                        _ => { return Value::Void; }
                    }
                }
                _ => { return Value::Void; }
            }
        }
        Value::Ptr(a_addr) => {
            match r {
                Value::Int(b3) => {
                    match op {
                        BinOp::Add => { return Value::Ptr(a_addr + b3); }
                        BinOp::Sub => { return Value::Ptr(a_addr - b3); }
                        BinOp::Eq => { return Value::Bool(a_addr == b3); }
                        BinOp::Neq => { return Value::Bool(a_addr != b3); }
                        BinOp::Lt => { return Value::Bool(a_addr < b3); }
                        BinOp::LtEq => { return Value::Bool(a_addr <= b3); }
                        BinOp::Gt => { return Value::Bool(a_addr > b3); }
                        BinOp::GtEq => { return Value::Bool(a_addr >= b3); }
                        _ => { return Value::Void; }
                    }
                }
                Value::Ptr(b_addr2) => {
                    match op {
                        BinOp::Eq => { return Value::Bool(a_addr == b_addr2); }
                        BinOp::Neq => { return Value::Bool(a_addr != b_addr2); }
                        BinOp::Lt => { return Value::Bool(a_addr < b_addr2); }
                        BinOp::LtEq => { return Value::Bool(a_addr <= b_addr2); }
                        BinOp::Gt => { return Value::Bool(a_addr > b_addr2); }
                        BinOp::GtEq => { return Value::Bool(a_addr >= b_addr2); }
                        _ => { return Value::Void; }
                    }
                }
                _ => { return Value::Void; }
            }
        }
        _ => { return Value::Void; }
    }
    return Value::Void;
}

// ===========================================================================
// eval_unaryop -- evaluate a unary operation
// ===========================================================================

pub fn Interpreter_eval_unaryop(self: &Interpreter, op: UnaryOp, v: Value) -> Value {
    match v {
        Value::Int(i) => {
            match op {
                UnaryOp::Neg => { return Value::Int(-i); }
                UnaryOp::Not => { return Value::Bool(i == 0); }
                UnaryOp::BitNot => { return Value::Int(~i); }
            }
        }
        Value::Float(f) => {
            match op {
                UnaryOp::Neg => { return Value::Float(-f); }
                _ => { return Value::Float(0.0); }
            }
        }
        Value::Bool(b) => {
            match op {
                UnaryOp::Not => { return Value::Bool(!b); }
                _ => { return Value::Bool(false); }
            }
        }
        _ => { return Value::Void; }
    }
    return Value::Void;
}

// ===========================================================================
// cast_value -- cast a value to a different type
// ===========================================================================

pub fn Interpreter_cast_value(self: &Interpreter, v: Value, to: IrType) -> Value {
    match v {
        Value::Int(i) => {
            match to {
                IrType::F32 => { return Value::Float(p_int_to_float(i)); }
                IrType::F64 => { return Value::Float(p_int_to_float(i)); }
                _ => { return Value::Int(i); }
            }
        }
        Value::Float(f) => {
            match to {
                IrType::I64 => { return Value::Int(p_float_to_int(f)); }
                IrType::I32 => { return Value::Int(p_float_to_int(f)); }
                _ => { return Value::Float(f); }
            }
        }
        Value::Bool(b) => {
            match to {
                IrType::I64 => {
                    if b { return Value::Int(1); }
                    return Value::Int(0);
                }
                _ => { return Value::Bool(b); }
            }
        }
        _ => { return v; }
    }
    return v;
}

// ===========================================================================
// is_runtime_func -- check if a name is a runtime function
// ===========================================================================

pub fn Interpreter_is_runtime_func(self: &Interpreter, name: str) -> bool {
    // Check if it's an extern function
    var i: i64 = 0;
    while i < self.module.extern_functions.len() {
        if self.module.extern_functions.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    // Check known runtime prefixes
    if name == "print" { return true; }
    if str_starts_with(name, "p_vec_") { return true; }
    if str_starts_with(name, "p_map_") { return true; }
    if str_starts_with(name, "p_string_") { return true; }
    if str_starts_with(name, "p_json_") { return true; }
    if str_starts_with(name, "p_tensor_") { return true; }
    if str_starts_with(name, "p_simd_") { return true; }
    if str_starts_with(name, "p_socket_") { return true; }
    if str_starts_with(name, "p_http_") { return true; }
    if str_starts_with(name, "p_db_") { return true; }
    if str_starts_with(name, "p_file_") { return true; }
    if str_starts_with(name, "p_thread_") { return true; }
    if str_starts_with(name, "p_atomic_") { return true; }
    if str_starts_with(name, "p_mutex_") { return true; }
    if str_starts_with(name, "p_shared_") { return true; }
    if str_starts_with(name, "p_future_") { return true; }
    if str_starts_with(name, "p_grad_") { return true; }
    if str_starts_with(name, "p_dp_") { return true; }
    if str_starts_with(name, "p_tp_") { return true; }
    if str_starts_with(name, "p_checkpoint_") { return true; }
    if str_starts_with(name, "p_volatile_") { return true; }
    if str_starts_with(name, "p_sb_") { return true; }
    // PRNG and noise builtins
    if name == "p_prng_next" { return true; }
    if name == "p_prng_uniform" { return true; }
    if name == "p_prng_gaussian" { return true; }
    if name == "p_dp_noise" { return true; }
    if name == "p_gaussian_noise" { return true; }
    if name == "p_dropout" { return true; }
    // Check common p_ builtins
    if name == "p_print_int" { return true; }
    if name == "p_print_float" { return true; }
    if name == "p_print_bool" { return true; }
    if name == "p_print_str" { return true; }
    if name == "p_eprint_str" { return true; }
    if name == "p_print_newline" { return true; }
    if name == "p_panic" { return true; }
    if name == "p_alloc" { return true; }
    if name == "p_malloc" { return true; }
    if name == "p_free" { return true; }
    if name == "p_region_free" { return true; }
    if name == "p_str_concat" { return true; }
    if name == "p_to_str" { return true; }
    if name == "p_char_to_str" { return true; }
    if name == "p_float_to_str" { return true; }
    if name == "p_str_to_float" { return true; }
    if name == "p_str_to_int" { return true; }
    if name == "p_str_len" { return true; }
    if name == "p_str_equal" { return true; }
    if name == "p_str_cmp" { return true; }
    if name == "p_bool_to_str" { return true; }
    if name == "p_clock_now" { return true; }
    if name == "p_clock_now_us" { return true; }
    if name == "p_clock_now_ms" { return true; }
    if name == "p_memset" { return true; }
    if name == "p_str_zeroize" { return true; }
    if name == "p_vec_zeroize" { return true; }
    return false;
}

// ===========================================================================
// call_runtime -- dispatch runtime builtin functions
// ===========================================================================
//
// This implements the essential runtime builtins needed for basic
// program execution: printing, panics, allocation, string operations,
// vectors, maps, and numeric conversions.
// Advanced builtins (tensors, networking, threads, etc.) return defaults.

pub fn Interpreter_call_runtime(self: &mut Interpreter, name: str, args: Vec<Value>) -> ExecOutcome {
    // ─── Printing ───
    if name == "p_print_int" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(i) => { p_print_int(i); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_print_float" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Float(f) => { p_print_float(f); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_print_bool" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Bool(b) => { p_print_bool(b); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_print_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Str(s) => { p_print_str(s); }
                Value::Ptr(addr) => {
                    var loaded: str = Memory_load_cstr(&self.memory, addr);
                    p_print_str(loaded);
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_eprint_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Str(s) => { p_eprint_str(s); }
                Value::Ptr(addr) => {
                    var loaded: str = Memory_load_cstr(&self.memory, addr);
                    p_eprint_str(loaded);
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_print_newline" {
        p_print_str("\n");
        return ExecOutcome::Value(Value::Void);
    }
    if name == "print" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(i) => { p_print_int(i); }
                Value::Float(f) => { p_print_float(f); }
                Value::Bool(b) => { p_print_bool(b); }
                Value::Str(s) => { p_print_str(s); }
                Value::Ptr(addr) => {
                    var loaded: str = Memory_load_cstr(&self.memory, addr);
                    p_print_str(loaded);
                }
                _ => { p_print_str("void"); }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Panic ───
    if name == "p_panic" {
        var msg: str = "panic";
        if args.len() > 0 {
            msg = Interpreter_value_to_string(self, args.get(0));
        }
        return ExecOutcome::Panic(msg);
    }

    // ─── Allocation ───
    if name == "p_alloc" || name == "p_malloc" {
        var size: i64 = 0;
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(s) => {
                    if s < 0 { size = 0; } else { size = s; }
                }
                _ => {}
            }
        }
        var addr: i64 = Memory_alloc(&mut self.memory, size);
        return ExecOutcome::Value(Value::Ptr(addr));
    }
    if name == "p_free" || name == "p_region_free" {
        // Interpreter doesn't actually free — memory is arena-based
        return ExecOutcome::Value(Value::Void);
    }

    // ─── String Operations ───
    if name == "p_str_concat" {
        var left: str = "";
        var right: str = "";
        if args.len() > 0 { left = Interpreter_value_to_string(self, args.get(0)); }
        if args.len() > 1 { right = Interpreter_value_to_string(self, args.get(1)); }
        return ExecOutcome::Value(Value::Str(left + right));
    }
    if name == "p_to_str" {
        if args.len() > 0 {
            return ExecOutcome::Value(Value::Str(Interpreter_value_to_string(self, args.get(0))));
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_char_to_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(i) => { return ExecOutcome::Value(Value::Str(p_char_to_str(i))); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_float_to_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Float(f) => { return ExecOutcome::Value(Value::Str(float_to_str(f))); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_str_to_float" {
        if args.len() > 0 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            return ExecOutcome::Value(Value::Float(p_str_to_float(s)));
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "p_str_to_int" {
        if args.len() > 0 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            return ExecOutcome::Value(Value::Int(p_str_to_int(s)));
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_str_len" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Str(s) => { return ExecOutcome::Value(Value::Int(str_len(s))); }
                Value::Ptr(addr) => {
                    var loaded: str = Memory_load_cstr(&self.memory, addr);
                    return ExecOutcome::Value(Value::Int(str_len(loaded)));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_str_equal" {
        // p_str_equal(a, b, n) — compare n bytes
        if args.len() >= 3 {
            var a_str: str = Interpreter_value_to_string(self, args.get(0));
            var b_str: str = Interpreter_value_to_string(self, args.get(1));
            match args.get(2) {
                Value::Int(n) => {
                    if n >= str_len(a_str) && n >= str_len(b_str) {
                        return ExecOutcome::Value(Value::Bool(a_str == b_str));
                    }
                    // Compare first n characters
                    var i: i64 = 0;
                    while i < n {
                        var ac: i64 = 0;
                        var bc: i64 = 0;
                        if i < str_len(a_str) {
                            var ap: i64 = a_str + i;
                            var aptr: *mut u8 = ap;
                            unsafe { ac = *aptr; }
                        }
                        if i < str_len(b_str) {
                            var bp: i64 = b_str + i;
                            var bptr: *mut u8 = bp;
                            unsafe { bc = *bptr; }
                        }
                        if ac != bc { return ExecOutcome::Value(Value::Bool(false)); }
                        i = i + 1;
                    }
                    return ExecOutcome::Value(Value::Bool(true));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_str_cmp" {
        if args.len() >= 2 {
            var a_str2: str = Interpreter_value_to_string(self, args.get(0));
            var b_str2: str = Interpreter_value_to_string(self, args.get(1));
            if a_str2 == b_str2 { return ExecOutcome::Value(Value::Int(0)); }
            // Simplified: return 1 if a > b, -1 if a < b
            return ExecOutcome::Value(Value::Int(1));
        }
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── Vec Operations ───
    // p_vec_new() -> returns a raw Fides Vec struct (24 bytes: data, len, cap)
    // The interpreter allocates this in simulated memory and tracks it.
    if name == "p_vec_new" {
        // Allocate 24 bytes for the Vec struct {data: i64, len: i64, cap: i64}
        var vec_addr: i64 = Memory_alloc(&mut self.memory, 24);
        // Initialize: data=0, len=0, cap=0
        Memory_store_i64(&mut self.memory, vec_addr, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 8, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 16, 0);
        // Also create a side-table entry for interpreter-level Vec operations
        var handle: i64 = self.vec_values.len();
        self.vec_values.push(VecValueEntry_new(handle));
        self.vec_side_table.push(VecSideEntry_new(vec_addr, handle));
        return ExecOutcome::Value(Value::Int(vec_addr));
    }
    if name == "p_vec_push" {
        // p_vec_push(vec_addr, elem) — elem is an i64 (raw value)
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var elem: i64 = 0;
                    match args.get(1) {
                        Value::Int(e) => { elem = e; }
                        Value::Ptr(p) => { elem = p; }
                        _ => {}
                    }
                    // Read current len and cap
                    var len: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    var cap: i64 = Memory_load_i64(&self.memory, vec_addr + 16);
                    var data: i64 = Memory_load_i64(&self.memory, vec_addr);
                    // Grow if needed
                    if len >= cap {
                        var new_cap: i64 = 8;
                        if cap > 0 { new_cap = cap * 2; }
                        var new_data: i64 = Memory_alloc(&mut self.memory, new_cap * 8);
                        // Copy old data
                        var ci: i64 = 0;
                        while ci < len {
                            var v: i64 = Memory_load_i64(&self.memory, data + ci * 8);
                            Memory_store_i64(&mut self.memory, new_data + ci * 8, v);
                            ci = ci + 1;
                        }
                        data = new_data;
                        cap = new_cap;
                        Memory_store_i64(&mut self.memory, vec_addr, data);
                        Memory_store_i64(&mut self.memory, vec_addr + 16, cap);
                    }
                    // Store element
                    Memory_store_i64(&mut self.memory, data + len * 8, elem);
                    len = len + 1;
                    Memory_store_i64(&mut self.memory, vec_addr + 8, len);
                    return ExecOutcome::Value(Value::Void);
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_get" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    match args.get(1) {
                        Value::Int(idx) => {
                            var len: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                            if idx < 0 || idx >= len {
                                return ExecOutcome::Panic("Vec index out of bounds");
                            }
                            var data: i64 = Memory_load_i64(&self.memory, vec_addr);
                            var elem: i64 = Memory_load_i64(&self.memory, data + idx * 8);
                            return ExecOutcome::Value(Value::Int(elem));
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_vec_set" {
        if args.len() >= 3 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    match args.get(1) {
                        Value::Int(idx) => {
                            var elem2: i64 = 0;
                            match args.get(2) {
                                Value::Int(e2) => { elem2 = e2; }
                                Value::Ptr(p2) => { elem2 = p2; }
                                _ => {}
                            }
                            var len2: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                            if idx < 0 || idx >= len2 {
                                return ExecOutcome::Panic("Vec index out of bounds");
                            }
                            var data2: i64 = Memory_load_i64(&self.memory, vec_addr);
                            Memory_store_i64(&mut self.memory, data2 + idx * 8, elem2);
                            return ExecOutcome::Value(Value::Void);
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_len" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var len3: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    return ExecOutcome::Value(Value::Int(len3));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_vec_is_empty" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var len4: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    return ExecOutcome::Value(Value::Bool(len4 == 0));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Bool(true));
    }
    if name == "p_vec_pop" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var len5: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    if len5 == 0 {
                        return ExecOutcome::Panic("Vec is empty");
                    }
                    var data5: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var elem5: i64 = Memory_load_i64(&self.memory, data5 + (len5 - 1) * 8);
                    len5 = len5 - 1;
                    Memory_store_i64(&mut self.memory, vec_addr + 8, len5);
                    return ExecOutcome::Value(Value::Int(elem5));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_vec_clear" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    Memory_store_i64(&mut self.memory, vec_addr + 8, 0);
                    return ExecOutcome::Value(Value::Void);
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Map Operations (simplified) ───
    if name == "p_map_new" {
        // Allocate a HashMap struct (simplified: 32 bytes)
        var map_addr: i64 = Memory_alloc(&mut self.memory, 32);
        Memory_store_i64(&mut self.memory, map_addr, 0);     // keys ptr
        Memory_store_i64(&mut self.memory, map_addr + 8, 0); // vals ptr
        Memory_store_i64(&mut self.memory, map_addr + 16, 0); // len
        Memory_store_i64(&mut self.memory, map_addr + 24, 0); // cap
        return ExecOutcome::Value(Value::Int(map_addr));
    }
    if name == "p_map_insert" {
        // p_map_insert(map_addr, key, value) — simplified linear scan
        // For now, just return void (full implementation would use
        // a side-table for key-value pairs)
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_map_get" || name == "p_map_get_or" {
        // Simplified: return 0 if not found
        if name == "p_map_get_or" && args.len() >= 3 {
            return ExecOutcome::Value(args.get(2));
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_map_contains" {
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_map_len" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_map_is_empty" {
        return ExecOutcome::Value(Value::Bool(true));
    }
    if name == "p_map_clear" {
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Volatile memory access (MMIO simulation) ───
    if name == "p_volatile_load" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_volatile_store" {
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_volatile_load8" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_volatile_store8" {
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_volatile_load16" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_volatile_store16" {
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_volatile_load32" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_volatile_store32" {
        return ExecOutcome::Value(Value::Void);
    }

    // ─── String builder (p_sb_*) ───
    // String builders are represented as Str values that accumulate content.
    if name == "p_sb_new" {
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_sb_append" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Str(sb) => {
                    match args.get(1) {
                        Value::Str(s) => {
                            return ExecOutcome::Value(Value::Str(sb + s));
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_sb_to_str" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Str(sb) => {
                    return ExecOutcome::Value(Value::Str(sb));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_sb_free" {
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_sb_len" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Str(sb) => {
                    return ExecOutcome::Value(Value::Int(str_len(sb)));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── PRNG (xorshift128+) for DP noise ───
    if name == "p_prng_next" {
        // xorshift128+ — returns a u64 value as i64
        var a: u64 = self.prng_state_a;
        var b: u64 = self.prng_state_b;
        a = a ^ (a << 23);
        a = a ^ (a >> 17);
        a = a ^ b;
        a = a ^ (b >> 26);
        self.prng_state_a = b;
        self.prng_state_b = a;
        return ExecOutcome::Value(Value::Int(a as i64));
    }
    if name == "p_prng_uniform" {
        // Returns a uniform random f64 in [0, 1)
        var a: u64 = self.prng_state_a;
        var b: u64 = self.prng_state_b;
        a = a ^ (a << 23);
        a = a ^ (a >> 17);
        a = a ^ b;
        a = a ^ (b >> 26);
        self.prng_state_a = b;
        self.prng_state_b = a;
        // Use upper 53 bits for mantissa
        var bits: i64 = (a >> 11) as i64;
        var result: f64 = (bits as f64) / (9007199254740992.0);
        return ExecOutcome::Value(Value::Float(result));
    }
    if name == "p_prng_gaussian" {
        // Box-Muller transform: generates a standard normal random f64
        var a: u64 = self.prng_state_a;
        var b: u64 = self.prng_state_b;
        a = a ^ (a << 23);
        a = a ^ (a >> 17);
        a = a ^ b;
        a = a ^ (b >> 26);
        self.prng_state_a = b;
        self.prng_state_b = a;
        var bits1: i64 = (a >> 11) as i64;
        var u1: f64 = (bits1 as f64) / (9007199254740992.0);
        if u1 < 0.0000001 { u1 = 0.0000001; }

        a = self.prng_state_a;
        b = self.prng_state_b;
        a = a ^ (a << 23);
        a = a ^ (a >> 17);
        a = a ^ b;
        a = a ^ (b >> 26);
        self.prng_state_a = b;
        self.prng_state_b = a;
        var bits2: i64 = (a >> 11) as i64;
        var u2: f64 = (bits2 as f64) / (9007199254740992.0);

        // Box-Muller: sqrt(-2 * ln(u1)) * cos(2 * pi * u2)
        // We don't have ln/cos in the interpreter, so use a simple
        // approximation: sum of 12 uniforms (Central Limit Theorem)
        var sum: f64 = u1 + u2;
        var i: i64 = 0;
        while i < 10 {
            a = self.prng_state_a;
            b = self.prng_state_b;
            a = a ^ (a << 23);
            a = a ^ (a >> 17);
            a = a ^ b;
            a = a ^ (b >> 26);
            self.prng_state_a = b;
            self.prng_state_b = a;
            var bits3: i64 = (a >> 11) as i64;
            sum = sum + (bits3 as f64) / (9007199254740992.0);
            i = i + 1;
        }
        // Approximate Gaussian: (sum - 6) gives mean 0, variance ~1
        var gaussian: f64 = sum - 6.0;
        return ExecOutcome::Value(Value::Float(gaussian));
    }

    // ─── DP noise functions (use PRNG, not deterministic formulas) ───
    if name == "p_dp_noise" {
        // p_dp_noise(epsilon, sensitivity, value) -> noisy value
        if args.len() >= 3 {
            match args.get(0) {
                Value::Float(epsilon) => {
                    match args.get(1) {
                        Value::Float(sensitivity) => {
                            match args.get(2) {
                                Value::Float(v) => {
                                    // Generate Gaussian noise with sigma = sensitivity / epsilon
                                    var sigma: f64 = sensitivity / epsilon;
                                    // Use CLT approximation for Gaussian
                                    var sum: f64 = 0.0;
                                    var i: i64 = 0;
                                    while i < 12 {
                                        var a: u64 = self.prng_state_a;
                                        var b: u64 = self.prng_state_b;
                                        a = a ^ (a << 23);
                                        a = a ^ (a >> 17);
                                        a = a ^ b;
                                        a = a ^ (b >> 26);
                                        self.prng_state_a = b;
                                        self.prng_state_b = a;
                                        var bits: i64 = (a >> 11) as i64;
                                        sum = sum + (bits as f64) / (9007199254740992.0);
                                        i = i + 1;
                                    }
                                    var noise: f64 = (sum - 6.0) * sigma;
                                    return ExecOutcome::Value(Value::Float(v + noise));
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "p_gaussian_noise" {
        // p_gaussian_noise(sigma, value) -> noisy value
        if args.len() >= 2 {
            match args.get(0) {
                Value::Float(sigma) => {
                    match args.get(1) {
                        Value::Float(v) => {
                            var sum: f64 = 0.0;
                            var i: i64 = 0;
                            while i < 12 {
                                var a: u64 = self.prng_state_a;
                                var b: u64 = self.prng_state_b;
                                a = a ^ (a << 23);
                                a = a ^ (a >> 17);
                                a = a ^ b;
                                a = a ^ (b >> 26);
                                self.prng_state_a = b;
                                self.prng_state_b = a;
                                var bits: i64 = (a >> 11) as i64;
                                sum = sum + (bits as f64) / (9007199254740992.0);
                                i = i + 1;
                            }
                            var noise: f64 = (sum - 6.0) * sigma;
                            return ExecOutcome::Value(Value::Float(v + noise));
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "p_dropout" {
        // p_dropout(prob, value) -> value * 0 with probability prob, else value
        if args.len() >= 2 {
            match args.get(0) {
                Value::Float(prob) => {
                    match args.get(1) {
                        Value::Float(v) => {
                            var a: u64 = self.prng_state_a;
                            var b: u64 = self.prng_state_b;
                            a = a ^ (a << 23);
                            a = a ^ (a >> 17);
                            a = a ^ b;
                            a = a ^ (b >> 26);
                            self.prng_state_a = b;
                            self.prng_state_b = a;
                            var bits: i64 = (a >> 11) as i64;
                            var r: f64 = (bits as f64) / (9007199254740992.0);
                            if r < prob {
                                return ExecOutcome::Value(Value::Float(0.0));
                            }
                            return ExecOutcome::Value(Value::Float(v));
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "p_dp_budget_check" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Float(epsilon) => {
                    match args.get(1) {
                        Value::Float(limit) => {
                            self.dp_epsilon_budget = self.dp_epsilon_budget + epsilon;
                            if self.dp_epsilon_budget > limit {
                                return ExecOutcome::Panic("DP budget exhausted: consumed " + float_to_str(self.dp_epsilon_budget) + " > limit " + float_to_str(limit));
                            }
                            return ExecOutcome::Value(Value::Void);
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Panic("dp_budget_check: expected (f64, f64)");
    }
    if name == "p_dp_budget_reset" {
        self.dp_epsilon_budget = 0.0;
        if args.len() >= 1 {
            match args.get(0) {
                Value::Float(limit) => {
                    self.dp_epsilon_limit = limit;
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Green threads (cooperative scheduler) ───
    // p_gt_spawn(func_name: *u8, arg: i64) queues a READY thread.
    // p_gt_run_all() resolves each queued thread's func_name and executes it
    // eagerly (interpreter is single-threaded — cooperative ordering, eager
    // bodies). is_done/get_result reflect the scheduler's real state.
    if name == "p_gt_spawn" {
        if args.len() < 2 { return ExecOutcome::Value(Value::Int(-1)); }
        var func_name: str = "";
        match args.get(0) {
            Value::Str(s) => { func_name = s; }
            Value::Ptr(a) => { func_name = Memory_load_cstr(&self.memory, a); }
            _ => {}
        }
        var arg_val: i64 = 0;
        match args.get(1) { Value::Int(n) => { arg_val = n; } _ => {} }
        var gt_args: Vec<i64> = Vec::new();
        gt_args.push(arg_val);
        var id: i64 = GreenThreadScheduler_spawn(&mut self.gt_scheduler, func_name, gt_args);
        return ExecOutcome::Value(Value::Int(id));
    }
    if name == "p_gt_yield" {
        GreenThreadScheduler_yield_current(&mut self.gt_scheduler);
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_gt_run_all" {
        var last_result: i64 = 0;
        var gi: i64 = 0;
        while gi < self.gt_scheduler.next_id {
            var gt: GreenThread = self.gt_scheduler.threads.get(gi);
            if gt.active && (gt.state == GT_READY || gt.state == GT_SUSPENDED) {
                gt.state = GT_RUNNING;
                self.gt_scheduler.current = gi;
                self.gt_scheduler.threads.set(gi, gt);
                var gt_vals: Vec<Value> = Vec::new();
                gt_vals.push(Value::Int(0));   // dummy __env
                var gai: i64 = 0;
                while gai < gt.args.len() {
                    gt_vals.push(Value::Int(gt.args.get(gai)));
                    gai = gai + 1;
                }
                var gt_result: Value = Value::Int(0);
                match IrModule_get_function(&self.module, gt.func_name) {
                    OptIrFunction::Some(gfunc) => {
                        match Interpreter_run_function(self, gfunc, gt_vals) {
                            RunResult::Return(gv) => { gt_result = gv; }
                            RunResult::Panic(gmsg) => {
                                p_eprint_str("Green thread panic: " + gmsg + "\n");
                            }
                            RunResult::Paused => { }
                        }
                    }
                    OptIrFunction::None => {
                        p_eprint_str("Green thread: unknown function '" + gt.func_name + "'\n");
                    }
                }
                match gt_result {
                    Value::Int(gn) => { gt.result = gn; }
                    Value::Bool(gb) => { if gb { gt.result = 1; } }
                    Value::Ptr(gp) => { gt.result = gp; }
                    _ => { }
                }
                gt.state = GT_DONE;
                self.gt_scheduler.current = -1;
                self.gt_scheduler.threads.set(gi, gt);
                last_result = gt.result;
            }
            gi = gi + 1;
        }
        return ExecOutcome::Value(Value::Int(last_result));
    }
    if name == "p_gt_is_done" {
        if args.len() < 1 { return ExecOutcome::Value(Value::Bool(false)); }
        var id: i64 = 0;
        match args.get(0) { Value::Int(n) => { id = n; } _ => {} }
        return ExecOutcome::Value(Value::Bool(GreenThreadScheduler_is_done(&self.gt_scheduler, id)));
    }
    if name == "p_gt_get_result" {
        if args.len() < 1 { return ExecOutcome::Value(Value::Int(0)); }
        var id: i64 = 0;
        match args.get(0) { Value::Int(n) => { id = n; } _ => {} }
        return ExecOutcome::Value(Value::Int(GreenThreadScheduler_get_result(&self.gt_scheduler, id)));
    }
    if name == "p_gt_current" {
        return ExecOutcome::Value(Value::Int(GreenThreadScheduler_current_thread(&self.gt_scheduler)));
    }
    if name == "p_gt_reset" {
        self.gt_scheduler = GreenThreadScheduler_new();
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Channels (ML/concurrency) ───
    if name == "p_chan_create" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_chan_send" {
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_chan_recv" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_chan_try_recv" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_chan_close" {
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_chan_is_closed" {
        return ExecOutcome::Value(Value::Bool(false));
    }

    // ─── Autograd (ML3) ───
    if name == "p_grad_get" {
        return ExecOutcome::Value(Value::Int(0));
