/// wildcard_match — simple wildcard pattern matching.
/// ? matches any single char, * matches zero or more chars.
pub fn wildcard_match(s: str, pattern: str) -> bool {
    var s_len: i64 = str_len(s);
    var p_len: i64 = str_len(pattern);
    var s_idx: i64 = 0;
    var p_idx: i64 = 0;
    var star_s: i64 = -1;
    var star_p: i64 = -1;
    while s_idx < s_len {
        if p_idx < p_len {
            var pc: i64 = str_byte_at(pattern, p_idx);
            var sc: i64 = str_byte_at(s, s_idx);
            if pc == 63 || pc == sc {
                s_idx = s_idx + 1;
                p_idx = p_idx + 1;
            } else if pc == 42 {
                star_p = p_idx;
                star_s = s_idx;
                p_idx = p_idx + 1;
            } else if star_p >= 0 {
                p_idx = star_p + 1;
                s_idx = star_s + 1;
                star_s = s_idx;
            } else {
                return false;
            }
        } else if star_p >= 0 {
            p_idx = star_p + 1;
            s_idx = star_s + 1;
            star_s = s_idx;
        } else {
            return false;
        }
    }
    while p_idx < p_len && str_byte_at(pattern, p_idx) == 42 {
        p_idx = p_idx + 1;
    }
    return p_idx == p_len;
}

