        return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_transpose(&self.tensors.get(th7))));
    }
    if name == "p_tensor_add" {
        var ha1: i64 = Interpreter_tensor_handle(self, args.get(0));
        var hb1: i64 = Interpreter_tensor_handle(self, args.get(1));
        if ha1 < 0 || hb1 < 0 { return ExecOutcome::Panic("tensor_add: expected Tensor, Tensor"); }
        match Tensor_add(&self.tensors.get(ha1), &self.tensors.get(hb1)) {
            ResultTensor::Ok(r) => { return ExecOutcome::Value(Interpreter_alloc_tensor(self, r)); }
            ResultTensor::Err(e2) => { return ExecOutcome::Panic(e2); }
