        var th3: i64 = Interpreter_tensor_handle(self, args.get(0));
        if th3 < 0 { return ExecOutcome::Panic("tensor_shape: expected Tensor"); }
        var tsh: TensorData = self.tensors.get(th3);
        var shlen: i64 = tsh.shape.len();
        var struct_addr: i64 = Memory_alloc(&mut self.memory, 32);
        Memory_store_i64(&mut self.memory, struct_addr + 24, 0);
        var data_addr: i64 = 0;
        if shlen > 0 {
            data_addr = Memory_alloc(&mut self.memory, shlen * 8);
            var si: i64 = 0;
            while si < shlen {
                Memory_store_i64(&mut self.memory, data_addr + si * 8, tsh.shape.get(si));
                si = si + 1;
            }
        }
        Memory_store_i64(&mut self.memory, struct_addr, data_addr);
        Memory_store_i64(&mut self.memory, struct_addr + 8, shlen);
        Memory_store_i64(&mut self.memory, struct_addr + 16, shlen);
        return ExecOutcome::Value(Value::Int(struct_addr));
    }
