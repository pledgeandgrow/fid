    // ─── Quantization (ML10) ───
    if name == "p_quantize_q8" {
        var thq: i64 = Interpreter_tensor_handle(self, args.get(0));
        var qscale: f64 = 0.0;
        var qzp: i64 = 0;
        var q_ok: bool = false;
        match args.get(1) {
            Value::Float(qf) => {
                qscale = qf;
            }
            _ => {
            }
        }
        match args.get(2) {
            Value::Int(qz) => {
                qzp = qz;
