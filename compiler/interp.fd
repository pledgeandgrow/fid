    if name == "p_vec_sort" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    // Simple bubble sort (ascending) on raw i64 elements
                    var i: i64 = 0;
                    while i < vlen - 1 {
                        var j: i64 = 0;
                        while j < vlen - 1 - i {
                            var a: i64 = Memory_load_i64(&self.memory, vdata + j * 8);
                            var b: i64 = Memory_load_i64(&self.memory, vdata + (j + 1) * 8);
                            if a > b {
                                Memory_store_i64(&mut self.memory, vdata + j * 8, b);
                                Memory_store_i64(&mut self.memory, vdata + (j + 1) * 8, a);
                            }
                            j = j + 1;
                        }
                        i = i + 1;
                    }
                    return ExecOutcome::Value(Value::Void);
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_clone" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(src_addr) => {
                    var src_len: i64 = Memory_load_i64(&self.memory, src_addr + 8);
                    var src_data: i64 = Memory_load_i64(&self.memory, src_addr);
                    // Create a new vec
                    var new_addr: i64 = Memory_alloc(&mut self.memory, 40);
                    var kcode: i64 = Memory_load_i64(&self.memory, src_addr + 24);
                    Memory_store_i64(&mut self.memory, new_addr + 24, kcode);
                    Memory_store_i64(&mut self.memory, new_addr + 32, 0);
                    var new_cap: i64 = 8;
                    if src_len > 8 { new_cap = src_len; }
                    if new_cap == 0 { new_cap = 8; }
                    var new_data: i64 = Memory_alloc(&mut self.memory, new_cap * interp_vec_esz(kcode));
                    // Copy elements
                    var ci: i64 = 0;
                    while ci < src_len {
                        var v: i64 = interp_vec_ld(&self.memory, src_data, ci, kcode);
                        interp_vec_st(&mut self.memory, new_data, ci, kcode, v);
                        ci = ci + 1;
                    }
                    Memory_store_i64(&mut self.memory, new_addr, new_data);
                    Memory_store_i64(&mut self.memory, new_addr + 8, src_len);
                    Memory_store_i64(&mut self.memory, new_addr + 16, new_cap);
                    return ExecOutcome::Value(Value::Int(new_addr));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_vec_capacity" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
