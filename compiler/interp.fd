// interp.fd -- IR Interpreter (self-hosted)
// Ported from src/interp.rs (~6,060 LOC)
//
// Executes Fides IR directly without generating machine code.
// This is the reference interpreter for the `run` command, comptime
// evaluation, debugging, and testing.
//
// Adaptations from Rust:
// 1. HashMap<K,V> -> Vec-based maps with helper structs
// 2. Rc<RefCell<...>> -> Vec side-tables indexed by handle
// 3. String/CompactString -> str
// 4. usize/u64/u32 -> i64 (Fides has no usize)
// 5. struct-style enum variants -> tuple-style (Fides convention)
// 6. Option<T> -> Opt* enums
// 7. closures -> top-level helper functions
// 8. SmallVec -> Vec
// 9. to_le_bytes/from_le_bytes -> manual byte operations via unsafe ptr

module compiler::interp;

use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::green_thread;
use compiler::tensor;
use compiler::json;
use math;

// ===========================================================================
// Value -- runtime value representation
// ===========================================================================
//
// Rust has 13 Value variants. Fides simplifies to 8:
//   Int, Float, Bool, Str, Ptr, Void, Vec, Map
// Tensor/Json/Dyn/Allocator/Future/ThreadHandle are stored as opaque
// pointers (Ptr) with side-table entries when needed.

pub enum Value {
    Int(i64),
    Float(f64),
    Bool(bool),
    Str(str),
    Ptr(i64),
    Void,
    Vec(i64),   // index into interp.vec_side_table
    Map(i64),   // index into interp.map_side_table
}

pub fn Value_int(v: i64) -> Value { return Value::Int(v); }

// A generic container hands back the 8-byte word it stored; a call typed f64
// (a Vec<f64> element via Vec_get) reads those bits as a float. Functions
// declared `-> f64` convert integer results at `return`, so an Int reaching
// such a call is always a stored word.
pub fn interp_reinterpret_word(v: Value, ty: IrType) -> Value {
    match ty {
        IrType::F64 => {
            match v {
                Value::Int(bits) => { return Value::Float(f64_from_bits_i(bits)); }
                _ => { return v; }
            }
        }
        IrType::F32 => {
            match v {
                Value::Int(bits32) => { return Value::Float(f32_from_bits_i(bits32)); }
                _ => { return v; }
            }
        }
        _ => { return v; }
    }
    return v;
}
pub fn Value_float(v: f64) -> Value { return Value::Float(v); }
pub fn Value_bool(v: bool) -> Value { return Value::Bool(v); }
pub fn Value_str(v: str) -> Value { return Value::Str(v); }
pub fn Value_ptr(v: i64) -> Value { return Value::Ptr(v); }
pub fn Value_void() -> Value { return Value::Void; }

/// Check if two values are equal (for PartialEq equivalent)
pub fn value_eq(a: Value, b: Value) -> bool {
    match a {
        Value::Int(x) => {
            match b {
                Value::Int(y) => { return x == y; }
                _ => { return false; }
            }
        }
        Value::Float(x) => {
            match b {
                Value::Float(y) => { return x == y; }
                _ => { return false; }
            }
        }
        Value::Bool(x) => {
            match b {
                Value::Bool(y) => { return x == y; }
                _ => { return false; }
            }
        }
        Value::Str(x) => {
            match b {
                Value::Str(y) => { return x == y; }
                _ => { return false; }
            }
        }
        Value::Ptr(x) => {
            match b {
                Value::Ptr(y) => { return x == y; }
                _ => { return false; }
            }
        }
        Value::Void => {
            match b {
                Value::Void => { return true; }
                _ => { return false; }
            }
        }
        Value::Vec(x) => {
            match b {
                Value::Vec(y) => { return x == y; }
                _ => { return false; }
            }
        }
        Value::Map(x) => {
            match b {
                Value::Map(y) => { return x == y; }
                _ => { return false; }
            }
        }
    }
    return false;
}

/// Check if a value is Void (used for overflow/error detection)
pub fn value_is_void(v: Value) -> bool {
    match v {
        Value::Void => { return true; }
        _ => { return false; }
    }
    return false;
}

// ===========================================================================
// Memory -- byte-addressed simulated memory
// ===========================================================================
//
// Replaces Rust's Vec<u8> with a Fides Vec<i64> where each element
// stores one byte (0-255). This is simpler than bit-packing and
// sufficient for the interpreter's performance needs.

pub struct Memory {
    pub data: Vec<i64>,
    pub next_alloc: i64,
    // Every block's start address: Value::Int while live, Value::Void once freed
    pub blocks: I64Table,
}

/// The element code in a Vec header's +24 word (core's vec_code_word:
/// 0, or P_VEC_TAG + code + 8; any other word is a word Vec).
fn interp_vec_decode(w: i64) -> i64 {
    if w == 0 { return 0; }
    var low: i64 = w & 255;
    if w - low != 0x4649445645430000 { return 0; }
    return low - 8;
}

/// Bytes per element of a Vec whose +24 word is `word` (release D14).
fn interp_vec_esz(word: i64) -> i64 {
    var code: i64 = interp_vec_decode(word);
    if code == 0 { return 8; }
    if code < 0 { return 0 - code; }
    return code;
}

/// Element `i` of Vec data at `data` with element code `code`.
fn interp_vec_ld(mem: &Memory, data: i64, i: i64, word: i64) -> i64 {
    var code: i64 = interp_vec_decode(word);
    if code == 0 { return Memory_load_i64(mem, data + i * 8); }
    var esz: i64 = interp_vec_esz(word);
    var a: i64 = data + i * esz;
    var v: i64 = 0;
    var k: i64 = esz - 1;
    while k >= 0 {
        v = (v << 8) | Memory_load_byte(mem, a + k);
        k = k - 1;
    }
    if code < 0 {
        var top: i64 = 1 << (esz * 8 - 1);
        if v >= top { v = v - top * 2; }
    }
    return v;
}

fn interp_vec_st(mem: &mut Memory, data: i64, i: i64, word: i64, x: i64) {
    var code: i64 = interp_vec_decode(word);
    if code == 0 {
        Memory_store_i64(mem, data + i * 8, x);
        return;
    }
    var esz: i64 = interp_vec_esz(word);
    var a: i64 = data + i * esz;
    var k: i64 = 0;
    while k < esz {
        Memory_store_byte(mem, a + k, (x >> (k * 8)) & 255);
        k = k + 1;
    }
}

pub fn Memory_new() -> Memory {
    var data: Vec<i64> = Vec::new();
    // Pre-allocate 1MB (1048576 bytes)
    var i: i64 = 0;
    while i < 1048576 {
        data.push(0);
        i = i + 1;
    }
    return Memory { data: data, next_alloc: 0x1000, blocks: I64Table_new() };
}

pub fn Memory_alloc(self: &mut Memory, size: i64) -> i64 {
    if size <= 0 { return self.next_alloc; }
    var addr: i64 = self.next_alloc;
    I64Table_set(&mut self.blocks, addr, Value::Int(1));
    self.next_alloc = self.next_alloc + size;
    // Grow if needed
    while self.next_alloc >= self.data.len() {
        var i: i64 = 0;
        while i < 4096 {
            self.data.push(0);
            i = i + 1;
        }
    }
    return addr;
}

/// Memory is never reused, but a bad free fails as it does natively.
/// Returns the panic message, "" when the free is fine.
pub fn Memory_free(self: &mut Memory, addr: i64) -> str {
    var s: i64 = I64Table_find(&self.blocks, addr);
    if s < 0 { return "Invalid free: not an allocated block"; }
    match self.blocks.vals.get(s) {
        Value::Void => { return "Double free"; }
        _ => {}
    }
    I64Table_set(&mut self.blocks, addr, Value::Void);
    return "";
}

pub fn Memory_allocated(self: &Memory) -> i64 {
    return self.next_alloc;
}

pub fn Memory_capacity(self: &Memory) -> i64 {
    return self.data.len();
}

pub fn Memory_is_valid_addr(self: &Memory, addr: i64) -> bool {
    return addr >= 0 && addr < self.data.len();
}

// Store a single byte at addr
pub fn Memory_store_byte(self: &mut Memory, addr: i64, b: i64) {
    if addr < 0 { return; }
    if addr >= self.data.len() {
        // Grow, as Memory::store (globals live at 0x400000)
        var target: i64 = addr + 1024;
        while self.data.len() < target { self.data.push(0); }
    }
    self.data.set(addr, b & 0xFF);
}

// Load a single byte from addr
pub fn Memory_load_byte(self: &Memory, addr: i64) -> i64 {
    if addr >= 0 && addr < self.data.len() {
        return self.data.get(addr);
    }
    return 0;
}

// Store an i64 (8 bytes, little-endian) at addr
pub fn Memory_store_i64(self: &mut Memory, addr: i64, val: i64) {
    var v: i64 = val;
    var i: i64 = 0;
    while i < 8 {
        Memory_store_byte(self, addr + i, v & 0xFF);
        v = v >> 8;
        i = i + 1;
    }
}

// Load an i64 (8 bytes, little-endian) from addr
pub fn Memory_load_i64(self: &Memory, addr: i64) -> i64 {
    var result: i64 = 0;
    var i: i64 = 0;
    while i < 8 {
        var b: i64 = Memory_load_byte(self, addr + i);
        result = result | (b << (i * 8));
        i = i + 1;
    }
    return result;
}

// Store a bool (1 byte) at addr
pub fn Memory_store_bool(self: &mut Memory, addr: i64, val: bool) {
    if val {
        Memory_store_byte(self, addr, 1);
    } else {
        Memory_store_byte(self, addr, 0);
    }
}

// Load a bool (1 byte) from addr
pub fn Memory_load_bool(self: &Memory, addr: i64) -> bool {
    return Memory_load_byte(self, addr) != 0;
}

// Store an i32 (4 bytes, little-endian) at addr
pub fn Memory_store_i32(self: &mut Memory, addr: i64, val: i64) {
    var v: i64 = val;
    var i: i64 = 0;
    while i < 4 {
        Memory_store_byte(self, addr + i, v & 0xFF);
        v = v >> 8;
        i = i + 1;
    }
}

// Store an i16 (2 bytes, little-endian) at addr
pub fn Memory_store_i16(self: &mut Memory, addr: i64, val: i64) {
    Memory_store_byte(self, addr, val & 0xFF);
    Memory_store_byte(self, addr + 1, (val >> 8) & 0xFF);
}

// Load an i32 (4 bytes, little-endian) from addr
pub fn Memory_load_i32(self: &Memory, addr: i64) -> i64 {
    var result: i64 = 0;
    var i: i64 = 0;
    while i < 4 {
        var b: i64 = Memory_load_byte(self, addr + i);
        result = result | (b << (i * 8));
        i = i + 1;
    }
    // Sign-extend from 32 bits
    if result >= 0x80000000 {
        result = result - 0x100000000;
    }
    return result;
}

// Store an f64 (8 bytes) at addr using p_f64_to_bits
pub fn Memory_store_f64(self: &mut Memory, addr: i64, val: f64) {
    var bits: i64 = p_f64_to_bits(val);
    Memory_store_i64(self, addr, bits);
}

// Bit reinterpretation through an 8-byte scratch cell (the bootstrap types
// the p_f64_from_bits / p_int_to_float builtins as returning i64).
pub fn f64_from_bits_i(bits: i64) -> f64 {
    var cell: i64 = p_malloc(8);
    var ip: *mut i64 = cell;
    unsafe { *ip = bits; }
    var fp: *mut f64 = cell;
    var f: f64 = 0.0;
    unsafe { f = *fp; }
    p_free(cell);
    return f;
}

pub fn f32_from_bits_i(bits: i64) -> f64 {
    // IEEE single -> double, by fields (no f32 arithmetic)
    var b: i64 = bits & 0xFFFFFFFF;
    var neg: bool = ((b >> 31) & 1) == 1;
    var e: i64 = (b >> 23) & 0xFF;
    var m: i64 = b & 0x7FFFFF;
    var v: f64 = 0.0;
    if e == 0 {
        // zero / subnormal: m * 2^-149
        v = (m as f64) * f64_from_bits_i(874 * 4503599627370496);
    } else if e == 255 {
        v = f64_from_bits_i(2047 * 4503599627370496 + m * 536870912);
    } else {
        v = f64_from_bits_i((e - 127 + 1023) * 4503599627370496 + m * 536870912);
    }
    if neg { v = -v; }
    return v;
}

// Load an f64 (8 bytes) from addr using p_f64_from_bits
pub fn Memory_load_f64(self: &Memory, addr: i64) -> f64 {
    var bits: i64 = Memory_load_i64(self, addr);
    return f64_from_bits_i(bits);
}

// Store an f32 (4 bytes) at addr
pub fn Memory_store_f32(self: &mut Memory, addr: i64, val: f64) {
    var bits: i64 = p_f32_to_bits(val);
    Memory_store_i32(self, addr, bits);
}

// Load an f32 (4 bytes) from addr
pub fn Memory_load_f32(self: &Memory, addr: i64) -> f64 {
    var bits: i64 = Memory_load_i32(self, addr);
    return f32_from_bits_i(bits);
}

// Copy `size` bytes from src to dst
pub fn Memory_copy(self: &mut Memory, dst: i64, src: i64, size: i64) {
    if size <= 0 { return; }
    // Grow so the destination range exists (as Memory::store)
    while dst + size >= self.data.len() {
        var gi: i64 = 0;
        while gi < 4096 {
            self.data.push(0);
            gi = gi + 1;
        }
    }
    var tmp: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < size {
        tmp.push(Memory_load_byte(self, src + i));
        i = i + 1;
    }
    i = 0;
    while i < size {
        Memory_store_byte(self, dst + i, tmp.get(i));
        i = i + 1;
    }
}

// Store a string as core keeps one (release D16): [magic][length], then
// the bytes and a terminator. Returns the address of the bytes; zero bytes
// inside the string are kept, and str_len reads the header.
pub fn Memory_store_cstr(self: &mut Memory, s: str) -> i64 {
    var slen: i64 = str_len(s);
    var block: i64 = Memory_alloc(self, slen + 17);
    Memory_store_i64(self, block, 0x4649444553545201);
    Memory_store_i64(self, block + 8, slen);
    var addr: i64 = block + 16;
    // Freeing the bytes' address directly (not through p_str_free) is a
    // free of this string too
    I64Table_set(&mut self.blocks, addr, Value::Int(1));
    var i: i64 = 0;
    while i < slen {
        // Read byte from string using pointer arithmetic
        var s_addr: i64 = s + i;
        var ptr: *mut u8 = s_addr;
        var b: i64 = 0;
        unsafe { b = *ptr; }
        Memory_store_byte(self, addr + i, b);
        i = i + 1;
    }
    Memory_store_byte(self, addr + slen, 0);
    return addr;
}

// Load a null-terminated C string from addr, return as str
pub fn Memory_load_cstr(self: &Memory, addr: i64) -> str {
    if addr <= 0 { return ""; }
    var result: str = "";
    // A length-headered string (D16): its length, zero bytes included
    if addr >= 16 {
        var magic: i64 = Memory_load_i64(self, addr - 16);
        if magic == 0x4649444553545201 || magic == 0x4649444553545202 {
            var hlen: i64 = Memory_load_i64(self, addr - 8);
            if hlen >= 0 && addr + hlen <= self.data.len() {
                var hi: i64 = 0;
                while hi < hlen {
                    result = result + p_char_to_str(Memory_load_byte(self, addr + hi));
                    hi = hi + 1;
                }
                return result;
            }
        }
    }
    var offset: i64 = addr;
    while offset < self.data.len() {
        var b: i64 = Memory_load_byte(self, offset);
        if b == 0 { break; }
        result = result + p_char_to_str(b);
        offset = offset + 1;
    }
    return result;
}

// ===========================================================================
// ExecOutcome / RunResult -- instruction and function results
// ===========================================================================

pub enum ExecOutcome {
    Continue,
    Value(Value),
    Jump(i64),
    Return(Value),
    Panic(str),
}

pub enum RunResult {
    Return(Value),
    Panic(str),
    Paused,
}

// ===========================================================================
// Side-table entries for opaque values (Vec, Map, string addrs, globals)
// ===========================================================================
//
// These replace Rust's HashMap<K, V> with Vec-based lookup tables.

pub struct StringAddrEntry {
    pub content: str,
    pub addr: i64,
}

pub fn StringAddrEntry_new(content: str, addr: i64) -> StringAddrEntry {
    return StringAddrEntry { content: content, addr: addr };
}

pub struct GlobalAddrEntry {
    pub name: str,
    pub addr: i64,
}

pub fn GlobalAddrEntry_new(name: str, addr: i64) -> GlobalAddrEntry {
    return GlobalAddrEntry { name: name, addr: addr };
}

pub struct OpaqueEntry {
    pub addr: i64,
    pub value: Value,
}

pub fn OpaqueEntry_new(addr: i64, value: Value) -> OpaqueEntry {
    return OpaqueEntry { addr: addr, value: value };
}

pub struct OpaqueSnapshot {
    pub entries: I64Table,
}

// ---------------------------------------------------------------------------
// I64Table -- open-addressing hash map i64 -> Value (Rust's HashMap<u64, Value>
// for the opaque side table). state: 0 empty, 1 live, 2 deleted.
// ---------------------------------------------------------------------------

pub struct I64Table {
    pub keys: Vec<i64>,
    pub vals: Vec<Value>,
    pub state: Vec<i64>,
    pub live: i64,
    pub filled: i64,
}

pub fn I64Table_new() -> I64Table {
    var t: I64Table = I64Table { keys: Vec::new(), vals: Vec::new(), state: Vec::new(), live: 0, filled: 0 };
    I64Table_init(&mut t, 256);
    return t;
}

fn I64Table_init(t: &mut I64Table, cap: i64) {
    var k: Vec<i64> = Vec::new();
    var v: Vec<Value> = Vec::new();
    var s: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < cap {
        k.push(0);
        v.push(Value::Void);
        s.push(0);
        i = i + 1;
    }
    t.keys = k;
    t.vals = v;
    t.state = s;
    t.live = 0;
    t.filled = 0;
}

fn i64_hash_slot(key: i64, mask: i64) -> i64 {
    var h: i64 = key ^ (key >> 16);
    h = h ^ (h >> 5);
    return h & mask;
}

pub fn I64Table_find(t: &I64Table, key: i64) -> i64 {
    var cap: i64 = t.keys.len();
    var mask: i64 = cap - 1;
    var i: i64 = i64_hash_slot(key, mask);
    while true {
        var st: i64 = t.state.get(i);
        if st == 0 { return -1; }
        if st == 1 {
            if t.keys.get(i) == key { return i; }
        }
        i = (i + 1) & mask;
    }
    return -1;
}

pub fn I64Table_get(t: &I64Table, key: i64) -> OptValue {
    var s: i64 = I64Table_find(t, key);
    if s < 0 { return OptValue::None; }
    return OptValue::Some(t.vals.get(s));
}

fn I64Table_rehash(t: &mut I64Table) {
    var old_keys: Vec<i64> = t.keys;
    var old_vals: Vec<Value> = t.vals;
    var old_state: Vec<i64> = t.state;
    var cap: i64 = old_keys.len();
    if t.live * 4 >= cap { cap = cap * 2; }
    I64Table_init(t, cap);
    var i: i64 = 0;
    while i < old_keys.len() {
        if old_state.get(i) == 1 {
            I64Table_set(t, old_keys.get(i), old_vals.get(i));
        }
        i = i + 1;
    }
}

pub fn I64Table_set(t: &mut I64Table, key: i64, val: Value) {
    var s: i64 = I64Table_find(t, key);
    if s >= 0 {
        t.vals.set(s, val);
        return;
    }
    if (t.filled + 1) * 2 > t.keys.len() { I64Table_rehash(t); }
    var mask: i64 = t.keys.len() - 1;
    var i: i64 = i64_hash_slot(key, mask);
    while t.state.get(i) == 1 { i = (i + 1) & mask; }
    if t.state.get(i) == 0 { t.filled = t.filled + 1; }
    t.keys.set(i, key);
    t.vals.set(i, val);
    t.state.set(i, 1);
    t.live = t.live + 1;
}

pub fn I64Table_remove(t: &mut I64Table, key: i64) {
    var s: i64 = I64Table_find(t, key);
    if s >= 0 {
        t.state.set(s, 2);
        t.vals.set(s, Value::Void);
        t.live = t.live - 1;
    }
}

pub fn I64Table_clone(t: &I64Table) -> I64Table {
    return I64Table { keys: t.keys.clone(), vals: t.vals.clone(), state: t.state.clone(), live: t.live, filled: t.filled };
}

// ---------------------------------------------------------------------------
// StrTable -- open-addressing hash map str -> i64 (function / runtime-name
// caches). No deletion.
// ---------------------------------------------------------------------------

pub struct StrTable {
    pub keys: Vec<str>,
    pub vals: Vec<i64>,
    pub used: Vec<bool>,
    pub count: i64,
}

pub fn StrTable_new(cap: i64) -> StrTable {
    var k: Vec<str> = Vec::new();
    var v: Vec<i64> = Vec::new();
    var u: Vec<bool> = Vec::new();
    var i: i64 = 0;
    while i < cap {
        k.push("");
        v.push(0);
        u.push(false);
        i = i + 1;
    }
    return StrTable { keys: k, vals: v, used: u, count: 0 };
}

fn str_hash_i(s: str) -> i64 {
    var n: i64 = str_len(s);
    var h: i64 = n;
    var i: i64 = 0;
    while i < n && i < 48 {
        var ap: i64 = s + i;
        var bp: *mut u8 = ap;
        var b: i64 = 0;
        unsafe { b = *bp; }
        h = ((h * 31) + b) & 0x3FFFFFFFFFFF;
        i = i + 1;
    }
    return h;
}

/// Slot of `key`, or -1.
pub fn StrTable_find(t: &StrTable, key: str) -> i64 {
    var mask: i64 = t.keys.len() - 1;
    var i: i64 = str_hash_i(key) & mask;
    while t.used.get(i) {
        if t.keys.get(i) == key { return i; }
        i = (i + 1) & mask;
    }
    return -1;
}

pub fn StrTable_get(t: &StrTable, key: str, dflt: i64) -> i64 {
    var s: i64 = StrTable_find(t, key);
    if s < 0 { return dflt; }
    return t.vals.get(s);
}

pub fn StrTable_set(t: &mut StrTable, key: str, val: i64) {
    var s: i64 = StrTable_find(t, key);
    if s >= 0 {
        t.vals.set(s, val);
        return;
    }
    if (t.count + 1) * 2 > t.keys.len() {
        var old_k: Vec<str> = t.keys;
        var old_v: Vec<i64> = t.vals;
        var old_u: Vec<bool> = t.used;
        var nt: StrTable = StrTable_new(old_k.len() * 2);
        t.keys = nt.keys;
        t.vals = nt.vals;
        t.used = nt.used;
        t.count = 0;
        var j: i64 = 0;
        while j < old_k.len() {
            if old_u.get(j) { StrTable_set(t, old_k.get(j), old_v.get(j)); }
            j = j + 1;
        }
    }
    var mask: i64 = t.keys.len() - 1;
    var i: i64 = str_hash_i(key) & mask;
    while t.used.get(i) { i = (i + 1) & mask; }
    t.keys.set(i, key);
    t.vals.set(i, val);
    t.used.set(i, true);
    t.count = t.count + 1;
}

fn Memory_clone(m: &Memory) -> Memory {
    return Memory { data: m.data.clone(), next_alloc: m.next_alloc, blocks: I64Table_clone(&m.blocks) };
}

pub struct ArrayBoundEntry {
    pub addr: i64,
    pub size: i64,
}

pub fn ArrayBoundEntry_new(addr: i64, size: i64) -> ArrayBoundEntry {
    return ArrayBoundEntry { addr: addr, size: size };
}

pub struct VecSideEntry {
    pub vec_addr: i64,
    pub side_idx: i64,
}

pub fn VecSideEntry_new(vec_addr: i64, side_idx: i64) -> VecSideEntry {
    return VecSideEntry { vec_addr: vec_addr, side_idx: side_idx };
}

// Vec side-table: stores Vec<Value> for interpreter-created Vecs
pub struct VecValueEntry {
    pub handle: i64,
    pub elements: Vec<Value>,
}

pub fn VecValueEntry_new(handle: i64) -> VecValueEntry {
    return VecValueEntry { handle: handle, elements: Vec::new() };
}

// Map side-table: stores key-value pairs for interpreter-created Maps
pub struct MapValueEntry {
    pub handle: i64,
    pub keys: Vec<str>,
    pub vals: Vec<Value>,
}

// Tensor side-table: maps an opaque Ptr addr -> index into interp.tensors.
// Value::Ptr(addr) stands in for Rust's Value::Tensor (see file header).
pub struct TensorSideEntry {
    pub addr: i64,
    pub handle: i64,
}

pub fn TensorSideEntry_new(addr: i64, handle: i64) -> TensorSideEntry {
    return TensorSideEntry { addr: addr, handle: handle };
}

pub fn MapValueEntry_new(handle: i64) -> MapValueEntry {
    return MapValueEntry { handle: handle, keys: Vec::new(), vals: Vec::new() };
}

// ===========================================================================
// Interpreter -- the IR interpreter
// ===========================================================================
//
// Fields mirror src/interp.rs::Interpreter, simplified for self-hosting.
// Advanced features (autograd, futures, channels, ECS, etc.) are stubbed
// or omitted in this initial port. Core execution is fully implemented.

pub struct Interpreter {
    pub module: IrModule,
    pub memory: Memory,
    pub string_addrs: Vec<StringAddrEntry>,
    pub global_addrs: Vec<GlobalAddrEntry>,
    pub opaque_values: I64Table,
    // MakeDyn: data pointer -> concrete type name (Rust's Value::Dyn)
    pub dyn_types: I64Table,
    // name -> index in module.functions (-1: none)
    pub fn_cache: StrTable,
    // name -> 1 runtime builtin / 0 not (memo of is_runtime_func)
    pub rt_cache: StrTable,
    // is the current function @wrapping
    pub cur_wrapping: bool,
    pub vec_side_table: Vec<VecSideEntry>,
    pub vec_values: Vec<VecValueEntry>,
    pub map_values: Vec<MapValueEntry>,
    pub tensors: Vec<TensorData>,
    pub tensor_side_table: Vec<TensorSideEntry>,
    pub tensor_index: I64Table,
    pub kv_caches: Vec<KvCache>,
    pub verbose: bool,
    pub debug_mode: bool,
    pub array_bounds: Vec<ArrayBoundEntry>,
    pub current_func_name: str,
    pub call_stack: Vec<str>,
    pub call_site_lines: Vec<i64>,
    pub pending_call_site: OptU64,
    pub panic_stack_trace: OptStr,
    pub interp_unsafe_depth: i64,
    pub txn_mem_snapshots: Vec<Memory>,
    pub txn_opaque_snapshots: Vec<OpaqueSnapshot>,
    pub max_recursion: i64,
    pub max_steps: i64,
    pub step_count: i64,
    pub max_memory: i64,
    pub region_stack: Vec<str>,
    // PRNG state for DP noise (xorshift128+)
    pub prng_state_a: u64,
    pub prng_state_b: u64,
    // DP epsilon budget tracking
    pub dp_epsilon_budget: f64,
    pub dp_epsilon_limit: f64,
    pub thread_handle_count: i64,
    // Spawn/future results — p_thread_spawn/p_executor_spawn run eagerly and
    // store the thread's return Value here; the Int handle indexes this table.
    pub future_values: Vec<Value>,
    pub future_exec: Vec<i64>,
    pub executor_count: i64,
    pub shared_mem: I64Table,
    pub next_shared_addr: i64,
    pub next_mutex_handle: i64,
    pub tls: I64Table,
    pub next_tls_key: i64,
    pub chans: Vec<ChanState>,
    pub dl_handles: I64Table,
    pub next_dl_handle: i64,
    pub ecs_entity_count: i64,
    pub ecs_comps: Vec<EcsComp>,
    pub sb_strs: Vec<str>,
    pub db_rows: Vec<DbRow>,
    pub next_db_handle: i64,
    pub closed_dbs: Vec<i64>,
    pub alloc_ptr: i64,
    pub persist_keys: Vec<str>,
    pub persist_vals: Vec<str>,
    pub ag_enabled: bool,
    pub ag_checkpoint: bool,
    pub ag_tape: Vec<AgEntry>,
    pub ag_grad_keys: Vec<i64>,
    pub ag_grad_vals: Vec<TensorData>,
    // Cooperative green-thread scheduler (p_gt_* builtins).
    pub gt_scheduler: GreenThreadScheduler,
}

pub fn Interpreter_new(module: IrModule) -> Interpreter {
    var interp: Interpreter = Interpreter {
        module: module,
        memory: Memory_new(),
        string_addrs: Vec::new(),
        global_addrs: Vec::new(),
        opaque_values: I64Table_new(),
        dyn_types: I64Table_new(),
        fn_cache: StrTable_new(1024),
        rt_cache: StrTable_new(256),
        cur_wrapping: false,
        vec_side_table: Vec::new(),
        vec_values: Vec::new(),
        map_values: Vec::new(),
        tensors: Vec::new(),
        tensor_side_table: Vec::new(),
        tensor_index: I64Table_new(),
        kv_caches: Vec::new(),
        verbose: false,
        debug_mode: true,
        array_bounds: Vec::new(),
        current_func_name: "",
        call_stack: Vec::new(),
        call_site_lines: Vec::new(),
        pending_call_site: OptU64::None,
        panic_stack_trace: OptStr::None,
        interp_unsafe_depth: 0,
        txn_mem_snapshots: Vec::new(),
        txn_opaque_snapshots: Vec::new(),
        max_recursion: 1000,
        max_steps: 0,
        step_count: 0,
        max_memory: 0,
        region_stack: Vec::new(),
        prng_state_a: 0x9E3779B97F4A7C15,
        prng_state_b: 0xBF58476D1CE4E5B9,
        dp_epsilon_budget: 0.0,
        dp_epsilon_limit: 0.0,
        thread_handle_count: 0,
        future_values: Vec::new(),
        future_exec: Vec::new(),
        executor_count: 0,
        shared_mem: I64Table_new(),
        next_shared_addr: 0x10000000,
        next_mutex_handle: 1,
        tls: I64Table_new(),
        next_tls_key: 0,
        chans: Vec::new(),
        dl_handles: I64Table_new(),
        next_dl_handle: 1,
        ecs_entity_count: 0,
        ecs_comps: Vec::new(),
        sb_strs: Vec::new(),
        db_rows: Vec::new(),
        next_db_handle: 1,
        closed_dbs: Vec::new(),
        alloc_ptr: 0x10000,
        persist_keys: Vec::new(),
        persist_vals: Vec::new(),
        ag_enabled: false,
        ag_checkpoint: false,
        ag_tape: Vec::new(),
        ag_grad_keys: Vec::new(),
        ag_grad_vals: Vec::new(),
        gt_scheduler: GreenThreadScheduler_new(),
    };
    // Function index (first definition wins, as IrModule_get_function)
    var fi: i64 = 0;
    while fi < interp.module.functions.len() {
        var fname: str = interp.module.functions.get(fi).name;
        if StrTable_find(&interp.fn_cache, fname) < 0 {
            StrTable_set(&mut interp.fn_cache, fname, fi);
        }
        fi = fi + 1;
    }
    Interpreter_init_strings(&mut interp);
    Interpreter_init_globals(&mut interp);
    return interp;
}

/// IrModule_get_function through the name index.
pub fn Interpreter_get_function(self: &Interpreter, name: str) -> OptIrFunction {
    var idx: i64 = StrTable_get(&self.fn_cache, name, -1);
    if idx < 0 { return OptIrFunction::None; }
    return OptIrFunction::Some(self.module.functions.get(idx).func);
}

pub fn Interpreter_verbose(self: &mut Interpreter) {
    self.verbose = true;
}

pub fn Interpreter_set_max_recursion(self: &mut Interpreter, depth: i64) {
    self.max_recursion = depth;
}

pub fn Interpreter_set_max_steps(self: &mut Interpreter, steps: i64) {
    self.max_steps = steps;
}

pub fn Interpreter_set_max_memory(self: &mut Interpreter, bytes: i64) {
    self.max_memory = bytes;
}

// ===========================================================================
// Lookup helpers for Vec-based maps
// ===========================================================================

pub fn Interpreter_lookup_string_addr(self: &Interpreter, content: str) -> i64 {
    var i: i64 = 0;
    while i < self.string_addrs.len() {
        if self.string_addrs.get(i).content == content {
            return self.string_addrs.get(i).addr;
        }
        i = i + 1;
    }
    return 0;
}

pub fn Interpreter_lookup_global_addr(self: &Interpreter, name: str) -> i64 {
    var i: i64 = 0;
    while i < self.global_addrs.len() {
        if self.global_addrs.get(i).name == name {
            return self.global_addrs.get(i).addr;
        }
        i = i + 1;
    }
    return 0;
}

pub fn Interpreter_lookup_opaque(self: &Interpreter, addr: i64) -> OptValue {
    return I64Table_get(&self.opaque_values, addr);
}

pub fn Interpreter_set_opaque(self: &mut Interpreter, addr: i64, value: Value) {
    I64Table_set(&mut self.opaque_values, addr, value);
}

pub fn Interpreter_remove_opaque(self: &mut Interpreter, addr: i64) {
    I64Table_remove(&mut self.opaque_values, addr);
}

pub fn Interpreter_lookup_array_bound(self: &Interpreter, addr: i64) -> i64 {
    var i: i64 = 0;
    while i < self.array_bounds.len() {
        if self.array_bounds.get(i).addr == addr {
            return self.array_bounds.get(i).size;
        }
        i = i + 1;
    }
    return -1;
}

pub fn Interpreter_set_array_bound(self: &mut Interpreter, addr: i64, size: i64) {
    self.array_bounds.push(ArrayBoundEntry_new(addr, size));
}

// OptValue for opaque lookups
pub enum OptValue {
    Some(Value),
    None,
}

// OptStr for panic_stack_trace
pub enum OptStr {
    Some(str),
    None,
}

// OptVecI64 for vec extraction helpers
pub enum OptVecI64 {
    Some(Vec<i64>),
    None,
}

// OptVecF64 for vec extraction helpers
pub enum OptVecF64 {
    Some(Vec<f64>),
    None,
}

// ===========================================================================
// init_strings / init_globals
// ===========================================================================

pub fn Interpreter_init_strings(self: &mut Interpreter) {
    var i: i64 = 0;
    while i < self.module.string_constants.len() {
        var s: str = self.module.string_constants.get(i).key;
        var addr: i64 = Memory_store_cstr(&mut self.memory, s);
        self.string_addrs.push(StringAddrEntry_new(s, addr));
        Interpreter_set_opaque(self, addr, Value::Str(s));
        i = i + 1;
    }
}

pub fn Interpreter_init_globals(self: &mut Interpreter) {
    var addr: i64 = 0x00400000;
    var i: i64 = 0;
    while i < self.module.globals.len() {
        var entry: GlobalEntry = self.module.globals.get(i);
        self.global_addrs.push(GlobalAddrEntry_new(entry.name, addr));
        var init_val: Value = eval_global_init(entry.init, entry.ty);
        match init_val {
            Value::Int(v) => { Memory_store_i64(&mut self.memory, addr, v); }
            Value::Float(v) => { Memory_store_f64(&mut self.memory, addr, v); }
            Value::Bool(v) => { Memory_store_bool(&mut self.memory, addr, v); }
            Value::Ptr(v) => { Memory_store_i64(&mut self.memory, addr, v); }
            Value::Str(s) => {
                var str_addr: i64 = Memory_store_cstr(&mut self.memory, s);
                Interpreter_set_opaque(self, str_addr, Value::Str(s));
                Memory_store_i64(&mut self.memory, addr, str_addr);
            }
            _ => { Memory_store_i64(&mut self.memory, addr, 0); }
        }
        addr = addr + 8;
        i = i + 1;
    }
}

pub fn eval_global_init(expr: Expr, ty: IrType) -> Value {
    match expr {
        Expr::IntLit(v) => {
            match ty {
                IrType::Bool => { return Value::Bool(v != 0); }
                _ => { return Value::Int(v); }
            }
        }
        Expr::FloatLit(v) => { return Value::Float(v); }
        Expr::BoolLit(b) => { return Value::Bool(b); }
        Expr::StringLit(s) => { return Value::Str(s); }
        _ => { return Value::Int(0); }
    }
    return Value::Int(0);
}

// ===========================================================================
// value_to_string -- convert a Value to a display string
// ===========================================================================

pub fn Interpreter_value_to_string(self: &Interpreter, v: Value) -> str {
    match v {
        Value::Str(s) => { return s; }
        Value::Ptr(addr) => { return Memory_load_cstr(&self.memory, addr); }
        Value::Int(i) => {
            // An Int may be a string pointer (a Str passed to an i64 param)
            if i > 0 {
                match Interpreter_lookup_opaque(self, i) {
                    OptValue::Some(ov) => {
                        match ov {
                            Value::Str(os) => { return os; }
                            _ => {}
                        }
                    }
                    OptValue::None => {}
                }
            }
            if i > 0 && Memory_is_valid_addr(&self.memory, i) {
                // A string in memory: the length its header gives (core's
                // counted, uncounted and literal strings), else up to the NUL.
                // An empty one is "" (its address is not a number to print).
                var hlen: i64 = -1;
                if i >= 16 && Memory_is_valid_addr(&self.memory, i - 16) {
                    var hw: i64 = Memory_load_i64(&self.memory, i - 16);
                    var hl: i64 = Memory_load_i64(&self.memory, i - 8);
                    if (hw - 0x4649444500000000) >= 0 && (hw - 0x4649444500000000) < 0x100000000 && hl >= 0 && hl < 0x10000000000 {
                        hlen = hl;
                    }
                    if (hw == 0x4649444553545201 || hw == 0x4649444553545202) && hl >= 0 && hl < 0x10000000000 { hlen = hl; }
                }
                var osb: i64 = p_sb_new();
                var n: i64 = 0;
                var limit: i64 = 16777216;
                if hlen >= 0 { limit = hlen; }
                while n < limit {
                    var b: i64 = Memory_load_byte(&self.memory, i + n);
                    if b == 0 && hlen < 0 { break; }
                    p_sb_append(osb, p_char_to_str(b));
                    n = n + 1;
                }
                return p_sb_to_str(osb);
            }
            return int_to_str(i);
        }
        _ => { return ""; }
    }
    return "";
}

/// Rust's `Display for Value`.
pub fn Interpreter_display_value(self: &Interpreter, v: Value) -> str {
    match v {
        Value::Int(i) => { return int_to_str(i); }
        Value::Float(f) => { return float_to_str(f); }
        Value::Bool(b) => {
            if b { return "true"; }
            return "false";
        }
        Value::Str(s) => { return s; }
        Value::Ptr(p) => {
            var dth: i64 = Interpreter_tensor_handle(self, v);
            if dth >= 0 { return interp_tensor_to_string(&self.tensors.get(dth)); }
            return "ptr(0x" + int_to_hex(p) + ")";
        }
        Value::Void => { return "void"; }
        Value::Vec(h) => {
            var out: str = "[";
            if h >= 0 && h < self.vec_values.len() {
                var elems: Vec<Value> = self.vec_values.get(h).elements;
                var i: i64 = 0;
                while i < elems.len() {
                    if i > 0 { out = out + ", "; }
                    out = out + Interpreter_display_value(self, elems.get(i));
                    i = i + 1;
                }
            }
            return out + "]";
        }
        Value::Map(mh) => {
            var mout: str = "{";
            if mh >= 0 && mh < self.map_values.len() {
                var me: MapValueEntry = self.map_values.get(mh);
                var order: Vec<i64> = sorted_key_order(me.keys);
                var j: i64 = 0;
                while j < order.len() {
                    if j > 0 { mout = mout + ", "; }
                    var k: i64 = order.get(j);
                    mout = mout + me.keys.get(k) + ": " + Interpreter_display_value(self, me.vals.get(k));
                    j = j + 1;
                }
            }
            return mout + "}";
        }
    }
    return "";
}

/// Indices of `keys` in ascending string order (insertion sort).
pub fn sorted_key_order(keys: Vec<str>) -> Vec<i64> {
    var order: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < keys.len() {
        var j: i64 = order.len();
        order.push(i);
        while j > 0 && str_lt(keys.get(i), keys.get(order.get(j - 1))) {
            order.set(j, order.get(j - 1));
            j = j - 1;
        }
        order.set(j, i);
        i = i + 1;
    }
    return order;
}

/// Byte-wise string ordering (Rust's str Ord).
pub fn str_lt(a: str, b: str) -> bool {
    var la: i64 = str_len(a);
    var lb: i64 = str_len(b);
    var i: i64 = 0;
    while i < la && i < lb {
        var ca: i64 = str_byte_at(a, i);
        var cb: i64 = str_byte_at(b, i);
        if ca != cb { return ca < cb; }
        i = i + 1;
    }
    return la < lb;
}

/// Print `v` with the Fides formatter `fname` (Vec_to_str, HashMap_to_str).
/// Continue / Panic when handled; Value(Void) when the caller should fall
/// back to the default printing.
pub fn Interpreter_print_via(self: &mut Interpreter, fname: str, v: Value) -> ExecOutcome {
    match Interpreter_get_function(self, fname) {
        OptIrFunction::Some(callee) => {
            var fargs: Vec<Value> = Vec::new();
            fargs.push(Value::Int(0));
            fargs.push(v);
            match Interpreter_run_function(self, callee, fargs) {
                RunResult::Return(rv) => {
                    match rv {
                        Value::Str(rs) => {
                            p_print_str(rs);
                            return ExecOutcome::Continue;
                        }
                        Value::Ptr(ra) => {
                            p_print_str(Memory_load_cstr(&self.memory, ra));
                            return ExecOutcome::Continue;
                        }
                        _ => {}
                    }
                }
                RunResult::Panic(msg) => { return ExecOutcome::Panic(msg); }
                RunResult::Paused => {}
            }
        }
        OptIrFunction::None => {}
    }
    return ExecOutcome::Value(Value::Void);
}
// ===========================================================================
// format_call_stack -- for panic stack traces
// ===========================================================================

pub fn Interpreter_format_call_stack(self: &Interpreter) -> str {
    if self.call_stack.len() == 0 { return ""; }
    var out: str = "stack trace:\n";
    var i: i64 = self.call_stack.len() - 1;
    var idx: i64 = 0;
    while i >= 0 {
        var name: str = self.call_stack.get(i);
        var suffix: str = "";
        if i < self.call_site_lines.len() {
            var line: i64 = self.call_site_lines.get(i);
            if line > 0 {
                suffix = " at line " + int_to_str(line);
            }
        }
        if idx == 0 {
            out = out + "    → " + name + suffix + "\n";
        } else {
            out = out + "    ↳ called from " + name + suffix + "\n";
        }
        i = i - 1;
        idx = idx + 1;
    }
    return out;
}

// ===========================================================================
// run -- entry point: find and execute main()
// ===========================================================================

pub fn Interpreter_run(self: &mut Interpreter) -> RunResult {
    match Interpreter_get_function(self, "main") {
        OptIrFunction::Some(main_fn) => {
            return Interpreter_run_function(self, main_fn, Vec::new());
        }
        OptIrFunction::None => {
            return RunResult::Panic("No main function found");
        }
    }
    return RunResult::Panic("No main function found");
}

// ===========================================================================
// run_function -- execute a function with arguments
// ===========================================================================

pub fn Interpreter_run_function(self: &mut Interpreter, func: IrFunction, args: Vec<Value>) -> RunResult {
    // Recursion depth check
    if self.call_stack.len() >= self.max_recursion {
        var depth: i64 = self.max_recursion;
        var caller: str = "";
        if self.call_stack.len() > 0 {
            caller = self.call_stack.get(self.call_stack.len() - 1);
        }
        self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
        return RunResult::Panic("Recursion depth limit (" + int_to_str(depth) + ") exceeded in function '" + func.name + "' (called from '" + caller + "')");
    }

    var saved_func_name: str = self.current_func_name;
    var saved_wrapping: bool = self.cur_wrapping;
    self.current_func_name = func.name;
    self.cur_wrapping = func.is_wrapping;
    self.call_stack.push(func.name);
    var saved_call_site: OptU64 = self.pending_call_site;
    self.pending_call_site = OptU64::None;
    var call_line: i64 = 0;
    match saved_call_site {
        OptU64::Some(line) => { call_line = line; }
        OptU64::None => { call_line = 0; }
    }
    self.call_site_lines.push(call_line);

    var saved_region_depth: i64 = self.region_stack.len();

    // Build value table: Vec<ValueIdValue> where index = value_id
    // We use a Vec<Value> indexed by value_id for O(1) lookup.
    var max_val: i64 = func.next_value;
    var values: Vec<Value> = Vec::new();
    var vi: i64 = 0;
    while vi < max_val {
        values.push(Value::Void);
        vi = vi + 1;
    }

    // Detect missing __env param: if first param is Ptr(U8) and caller
    // passed one fewer arg, insert a dummy env value.
    var effective_args: Vec<Value> = Vec::new();
    var has_env_param: bool = false;
    if func.params.len() > 0 {
        var first_param: ValueIdType = func.params.get(0);
        match first_param.ty {
            IrType::Ptr(inner) => {
                match inner {
                    IrType::U8 => { has_env_param = true; }
                    _ => {}
                }
            }
            _ => {}
        }
    }
    if has_env_param && args.len() == func.params.len() - 1 {
        effective_args.push(Value::Int(0));
        var ai: i64 = 0;
        while ai < args.len() {
            effective_args.push(args.get(ai));
            ai = ai + 1;
        }
    } else {
        effective_args = args;
    }

    // Bind parameters
    var pi: i64 = 0;
    while pi < func.params.len() {
        var param: ValueIdType = func.params.get(pi);
        var pval: Value = Value::Void;
        if pi < effective_args.len() {
            pval = effective_args.get(pi);
        }
        // Phase 10B: When a Value::Str is passed to an i64 or pointer param,
        // materialize the string into memory and pass the address.
        match pval {
            Value::Str(s) => {
                var is_i64_or_ptr: bool = false;
                match param.ty {
                    IrType::I64 => { is_i64_or_ptr = true; }
                    IrType::U64 => { is_i64_or_ptr = true; }
                    IrType::Ptr(_) => { is_i64_or_ptr = true; }
                    _ => {}
                }
                if is_i64_or_ptr {
                    var str_addr: i64 = Memory_store_cstr(&mut self.memory, s);
                    Interpreter_set_opaque(self, str_addr, Value::Str(s));
                    match param.ty {
                        IrType::Ptr(_) => { pval = Value::Ptr(str_addr); }
                        _ => { pval = Value::Int(str_addr); }
                    }
                }
            }
            // An f64 passed where a word is taken (core's Vec_push / Vec_set
            // of a Vec<f64>): its bits, as the C backend passes it
            Value::Float(pf) => {
                match param.ty {
                    IrType::I64 => { pval = Value::Int(p_f64_to_bits(pf)); }
                    IrType::U64 => { pval = Value::Int(p_f64_to_bits(pf)); }
                    _ => {}
                }
            }
            _ => {}
        }
        if param.id < values.len() {
            values.set(param.id, pval);
        }
        pi = pi + 1;
    }

    // Execute basic blocks
    var current_block: i64 = func.entry;
    var result: RunResult = RunResult::Return(Value::Void);

    while true {
        if current_block < 0 || current_block >= func.blocks.len() {
            // No valid block — return void
            result = RunResult::Return(Value::Void);
            break;
        }
        var block: BasicBlock = func.blocks.get(current_block);

        if self.verbose {
            p_eprint_str("  -> block ");
            p_eprint_str(int_to_str(current_block));
            p_eprint_str("\n");
        }

        var next_block: i64 = -1;
        var done: bool = false;
        var ii: i64 = 0;
        while ii < block.instructions.len() {
            var inst_id: i64 = block.instructions.get(ii);

            // Step limit check
            if self.max_steps > 0 {
                self.step_count = self.step_count + 1;
                if self.step_count > self.max_steps {
                    self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
                    result = RunResult::Panic("Step limit exceeded: " + int_to_str(self.step_count) + " instructions executed (limit: " + int_to_str(self.max_steps) + ")");
                    done = true;
                    break;
                }
            }

            // Get the instruction
            var inst_opt: OptInst = IrFunction_get_inst(&func, inst_id);
            match inst_opt {
                OptInst::None => { }
                OptInst::Some(inst) => {
                    var outcome: ExecOutcome = Interpreter_execute_inst(self, inst, inst_id, values, &func);
                    match outcome {
                        ExecOutcome::Continue => { }
                        ExecOutcome::Value(v) => {
                            if inst_id < values.len() {
                                values.set(inst_id, v);
                            }
                        }
                        ExecOutcome::Jump(target) => {
                            // On to the target block (`done` is for leaving
                            // the function: return or panic)
                            next_block = target;
                            break;
                        }
                        ExecOutcome::Return(rv) => {
                            result = RunResult::Return(rv);
                            done = true;
                            break;
                        }
                        ExecOutcome::Panic(msg) => {
                            // Capture stack trace
                            match self.panic_stack_trace {
                                OptStr::None => {
                                    self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
                                }
                                OptStr::Some(_) => { }
                            }
                            // Transaction rollback
                            if self.txn_mem_snapshots.len() > 0 {
                                var snap_mem: Memory = self.txn_mem_snapshots.get(self.txn_mem_snapshots.len() - 1);
                                self.memory = snap_mem;
                                self.txn_mem_snapshots.pop();
                            }
                            if self.txn_opaque_snapshots.len() > 0 {
                                var snap_opaque: OpaqueSnapshot = self.txn_opaque_snapshots.get(self.txn_opaque_snapshots.len() - 1);
                                self.opaque_values = snap_opaque.entries;
                                self.txn_opaque_snapshots.pop();
                            }
                            // The panicking instruction's source line (as
                            // src/interp.rs), unless the message has one
                            var pmsg: str = msg;
                            if !str_contains(pmsg, " at line ") {
                                match IrFunction_get_meta(&func, inst_id) {
                                    OptValueMeta::Some(pm) => {
                                        match pm.source_line {
                                            OptU64::Some(pl) => { pmsg = pmsg + " at line " + int_to_str(pl); }
                                            OptU64::None => {}
                                        }
                                    }
                                    OptValueMeta::None => {}
                                }
                            }
                            result = RunResult::Panic(pmsg);
                            done = true;
                            break;
                        }
                    }
                }
            }
            ii = ii + 1;
        }

        if done {
            break;
        }

        if next_block >= 0 {
            current_block = next_block;
        } else {
            // No terminator found — return void
            result = RunResult::Return(Value::Void);
            break;
        }
    }

    // Cleanup: restore region_stack depth
    while self.region_stack.len() > saved_region_depth {
        self.region_stack.pop();
    }
    self.current_func_name = saved_func_name;
    self.cur_wrapping = saved_wrapping;
    self.call_stack.pop();
    self.call_site_lines.pop();

    return result;
}

// ===========================================================================
// get_value -- safe lookup from the value table
// ===========================================================================

/// What an 8-byte integer load at `addr` reads from the side table: a
/// pointer, string, Vec or map stored there (else None: read memory).
fn Interpreter_load_side_word(self: &Interpreter, addr: i64) -> OptValue {
    match Interpreter_lookup_opaque(self, addr) {
        OptValue::Some(ov) => {
            match ov {
                Value::Ptr(_) => { return OptValue::Some(ov); }
                Value::Str(_) => { return OptValue::Some(ov); }
                Value::Vec(_) => { return OptValue::Some(ov); }
                Value::Map(_) => { return OptValue::Some(ov); }
                _ => {}
            }
        }
        OptValue::None => {}
    }
    return OptValue::None;
}

/// The 8-byte word a raw (core) Vec stores for `v`.
pub fn Interpreter_value_word(self: &mut Interpreter, v: Value) -> i64 {
    match v {
        Value::Int(i) => { return i; }
        Value::Ptr(p) => { return p; }
        Value::Float(f) => { return p_f64_to_bits(f); }
        Value::Bool(b) => { if b { return 1; } return 0; }
        Value::Str(s) => {
            var sa: i64 = Memory_store_cstr(&mut self.memory, s);
            Interpreter_set_opaque(self, sa, Value::Str(s));
            return sa;
        }
        _ => {}
    }
    return 0;
}

pub fn get_value(values: Vec<Value>, id: i64) -> Value {
    if id >= 0 && id < values.len() {
        return values.get(id);
    }
    return Value::Void;
}

// ===========================================================================
// execute_inst -- execute a single IR instruction
// ===========================================================================

pub fn Interpreter_execute_inst(self: &mut Interpreter, inst: Inst, inst_id: i64, values: Vec<Value>, func: &IrFunction) -> ExecOutcome {
    match inst {
        // ─── Constants ───
        Inst::ConstInt(value, ty) => {
            match ty {
                IrType::Bool => { return ExecOutcome::Value(Value::Bool(value != 0)); }
                _ => { return ExecOutcome::Value(Value::Int(value)); }
            }
        }
        Inst::ConstFloat(value, ty) => {
            // value is already an f64 in Fides IR (unlike Rust which stores bits)
            match ty {
                IrType::F32 => { return ExecOutcome::Value(Value::Float(value)); }
                _ => { return ExecOutcome::Value(Value::Float(value)); }
            }
        }
        Inst::ConstBool(value) => {
            return ExecOutcome::Value(Value::Bool(value));
        }
        Inst::ConstStr(value) => {
            return ExecOutcome::Value(Value::Str(value));
        }
        Inst::ConstFnRef(name) => {
            return ExecOutcome::Value(Value::Str(name));
        }
        Inst::ConstNull(_) => {
            return ExecOutcome::Value(Value::Ptr(0));
        }

        // ─── Globals ───
        Inst::GlobalAddr(name, _) => {
            var addr: i64 = Interpreter_lookup_global_addr(self, name);
            return ExecOutcome::Value(Value::Ptr(addr));
        }

        // ─── Arithmetic ───
        Inst::BinOp(op, left, right, ty) => {
            var l: Value = get_value(values, left);
            var r: Value = get_value(values, right);
            // String comparison: when both operands are Ptr(U8) (str type),
            // compare content rather than pointer addresses.
            var is_str_cmp: bool = false;
            var left_meta_opt: OptValueMeta = IrFunction_get_meta(func, left);
            var right_meta_opt: OptValueMeta = IrFunction_get_meta(func, right);
            match left_meta_opt {
                OptValueMeta::Some(lm) => {
                    match right_meta_opt {
                        OptValueMeta::Some(rm) => {
                            match lm.ty {
                                IrType::Ptr(linner) => {
                                    match linner {
                                        IrType::U8 => {
                                            match rm.ty {
                                                IrType::Ptr(rinner) => {
                                                    match rinner {
                                                        IrType::U8 => { is_str_cmp = true; }
                                                        _ => {}
                                                    }
                                                }
                                                _ => {}
                                            }
                                        }
                                        _ => {}
                                    }
                                }
                                _ => {}
                            }
                        }
                        OptValueMeta::None => {}
                    }
                }
                OptValueMeta::None => {}
            }
            if is_str_cmp {
                match op {
                    BinOp::Eq => {
                        var l_str: str = Interpreter_value_to_string(self, l);
                        var r_str: str = Interpreter_value_to_string(self, r);
                        return ExecOutcome::Value(Value::Bool(l_str == r_str));
                    }
                    BinOp::Neq => {
                        var l_str2: str = Interpreter_value_to_string(self, l);
                        var r_str2: str = Interpreter_value_to_string(self, r);
                        return ExecOutcome::Value(Value::Bool(l_str2 != r_str2));
                    }
                    _ => {}
                }
            }
            var result: Value = Interpreter_eval_typed(self, op, l, r, ty, meta_is_u64(left_meta_opt) || meta_is_u64(right_meta_opt));
            if value_is_void(result) {
                var msg: str = "Arithmetic error";
                match op {
                    BinOp::Add => { msg = "Integer overflow on addition: " + int_or_q(l) + " + " + int_or_q(r); }
                    BinOp::Sub => { msg = "Integer overflow on subtraction: " + int_or_q(l) + " - " + int_or_q(r); }
                    BinOp::Mul => { msg = "Integer overflow on multiplication: " + int_or_q(l) + " * " + int_or_q(r); }
                    BinOp::Div => {
                        msg = "Division by zero";
                        if int_or_q(r) != "0" { msg = "Integer overflow on division"; }
                    }
                    BinOp::Mod => { msg = "Modulo by zero"; }
                    _ => { msg = "Arithmetic error"; }
                }
                return ExecOutcome::Panic(msg);
            }
            return ExecOutcome::Value(result);
        }

        Inst::UnaryOp(op, operand, _) => {
            var v: Value = get_value(values, operand);
            var result: Value = Interpreter_eval_unaryop(self, op, v);
            return ExecOutcome::Value(result);
        }

        // ─── Memory ───
        Inst::Alloca(ty, _) => {
            var size: i64 = IrModule_type_size(&self.module, ty);
            if size < 1 { size = 1; }
            // Memory limit check
            if self.max_memory > 0 {
                var current: i64 = Memory_allocated(&self.memory);
                if current + size > self.max_memory {
                    self.panic_stack_trace = OptStr::Some(Interpreter_format_call_stack(self));
                    return ExecOutcome::Panic("Memory limit exceeded");
                }
            }
            var addr: i64 = Memory_alloc(&mut self.memory, size);
            // Track array bounds
            match ty {
                IrType::Array(_, arr_size) => {
                    Interpreter_set_array_bound(self, addr, arr_size);
                }
                _ => {}
            }
            return ExecOutcome::Value(Value::Ptr(addr));
        }

        Inst::Load(ptr, ty) => {
            var addr: i64 = 0;
            match get_value(values, ptr) {
                Value::Ptr(a) => { addr = a; }
                Value::Int(i) => { addr = i; }
                Value::Str(s) => {
                    addr = Memory_store_cstr(&mut self.memory, s);
                }
                _ => { addr = 0; }
            }
            if addr == 0 {
                return ExecOutcome::Panic("Invalid memory access (null or dangling pointer)");
            }
            // Load from byte memory based on type. Only a word-sized load can
            // read a value the side table holds (a Vec, map or string stored
            // there): a byte load at a string's address reads its first byte.
            // (As in src/interp.rs.)
            match ty {
                IrType::I8 => {
                    var b: i64 = Memory_load_byte(&self.memory, addr);
                    // Sign-extend from 8 bits
                    if b >= 128 { b = b - 256; }
                    return ExecOutcome::Value(Value::Int(b));
                }
                IrType::U8 => {
                    return ExecOutcome::Value(Value::Int(Memory_load_byte(&self.memory, addr)));
                }
                IrType::I16 => {
                    var lo: i64 = Memory_load_byte(&self.memory, addr);
                    var hi: i64 = Memory_load_byte(&self.memory, addr + 1);
                    var v: i64 = lo | (hi << 8);
                    if v >= 32768 { v = v - 65536; }
                    return ExecOutcome::Value(Value::Int(v));
                }
                IrType::U16 => {
                    var lo: i64 = Memory_load_byte(&self.memory, addr);
                    var hi: i64 = Memory_load_byte(&self.memory, addr + 1);
                    return ExecOutcome::Value(Value::Int(lo | (hi << 8)));
                }
                IrType::I32 => {
                    return ExecOutcome::Value(Value::Int(Memory_load_i32(&self.memory, addr)));
                }
                IrType::U32 => {
                    return ExecOutcome::Value(Value::Int(Memory_load_i32(&self.memory, addr) & 0xFFFFFFFF));
                }
                IrType::I64 => {
                    match Interpreter_load_side_word(self, addr) {
                        OptValue::Some(sv) => { return ExecOutcome::Value(sv); }
                        OptValue::None => {}
                    }
                    return ExecOutcome::Value(Value::Int(Memory_load_i64(&self.memory, addr)));
                }
                IrType::U64 => {
                    match Interpreter_load_side_word(self, addr) {
                        OptValue::Some(sv) => { return ExecOutcome::Value(sv); }
                        OptValue::None => {}
                    }
                    return ExecOutcome::Value(Value::Int(Memory_load_i64(&self.memory, addr)));
                }
                IrType::F32 => {
                    return ExecOutcome::Value(Value::Float(Memory_load_f32(&self.memory, addr)));
                }
                IrType::F64 => {
                    return ExecOutcome::Value(Value::Float(Memory_load_f64(&self.memory, addr)));
                }
                IrType::Bool => {
                    return ExecOutcome::Value(Value::Bool(Memory_load_bool(&self.memory, addr)));
                }
                IrType::Ptr(_) => {
                    // A stored string (str fields have IR type Ptr(U8)) or pointer
                    match Interpreter_lookup_opaque(self, addr) {
                        OptValue::Some(pv) => {
                            match pv {
                                Value::Str(_) => { return ExecOutcome::Value(pv); }
                                Value::Ptr(_) => { return ExecOutcome::Value(pv); }
                                _ => {}
                            }
                        }
                        OptValue::None => {}
                    }
                    return ExecOutcome::Value(Value::Ptr(Memory_load_i64(&self.memory, addr)));
                }
                IrType::Opaque(_) => {
                    // Check side-table for opaque types
                    match Interpreter_lookup_opaque(self, addr) {
                        OptValue::Some(ov2) => { return ExecOutcome::Value(ov2); }
                        OptValue::None => {
                            return ExecOutcome::Value(Value::Ptr(Memory_load_i64(&self.memory, addr)));
                        }
                    }
                }
                IrType::Generic(_, _) => {
                    // Check side-table again for generic types
                    match Interpreter_lookup_opaque(self, addr) {
                        OptValue::Some(ov3) => { return ExecOutcome::Value(ov3); }
                        OptValue::None => {
                            return ExecOutcome::Value(Value::Ptr(Memory_load_i64(&self.memory, addr)));
                        }
                    }
                }
                _ => {
                    return ExecOutcome::Value(Value::Ptr(addr));
                }
            }
        }

        Inst::Store(ptr, value, sty_opt) => {
            var addr: i64 = 0;
            match get_value(values, ptr) {
                Value::Ptr(a) => { addr = a; }
                _ => { addr = 0; }
            }
            var v: Value = get_value(values, value);
            // An explicit Struct store type is an inline struct copy (an enum
            // payload, a by-value struct): copy the bytes from the source.
            match sty_opt {
                OptIrType::Some(est) => {
                    match est {
                        IrType::Struct(_) => {
                            var esize: i64 = IrModule_type_size(&self.module, est);
                            var src: i64 = -1;
                            match v {
                                Value::Ptr(sa) => { src = sa; }
                                Value::Int(si) => {
                                    if si > 0 && Memory_is_valid_addr(&self.memory, si) { src = si; }
                                }
                                _ => {}
                            }
                            if src >= 0 {
                                Memory_copy(&mut self.memory, addr, src, esize);
                                return ExecOutcome::Continue;
                            }
                        }
                        _ => {}
                    }
                }
                OptIrType::None => {}
            }
            // Pointer / value types (src/interp.rs Store)
            var has_ptr_ty: bool = false;
            var ptr_ty: IrType = IrType::Void;
            match IrFunction_get_meta(func, ptr) {
                OptValueMeta::Some(pm) => { ptr_ty = pm.ty; has_ptr_ty = true; }
                OptValueMeta::None => {}
            }
            var has_val_ty: bool = false;
            var val_ty: IrType = IrType::I64;
            match IrFunction_get_meta(func, value) {
                OptValueMeta::Some(vm) => { val_ty = vm.ty; has_val_ty = true; }
                OptValueMeta::None => {}
            }
            var is_opaque: bool = false;
            var is_deref_store: bool = false;
            var has_pointee: bool = false;
            var pointee_ty: IrType = IrType::Void;
            if has_ptr_ty {
                match ptr_ty {
                    IrType::Opaque(_) => { is_opaque = true; }
                    IrType::Generic(_, _) => { is_opaque = true; }
                    IrType::Ptr(inner) => {
                        pointee_ty = box_ir_type_unbox(inner);
                        has_pointee = true;
                        is_deref_store = true;
                        match inner {
                            IrType::Opaque(_) => { is_opaque = true; }
                            IrType::Generic(_, _) => { is_opaque = true; }
                            IrType::I64 => { is_deref_store = false; }
                            IrType::U64 => { is_deref_store = false; }
                            IrType::Ptr(_) => { is_deref_store = false; }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
            var sty: IrType = IrType::I64;
            if has_val_ty { sty = val_ty; }
            if is_deref_store && has_pointee { sty = pointee_ty; }
            if is_opaque {
                // Opaque-typed slots always use the side table (and byte
                // memory for primitives, as a fallback)
                Interpreter_set_opaque(self, addr, v);
                match v {
                    Value::Int(oi) => { Memory_store_i64(&mut self.memory, addr, oi); }
                    Value::Float(of) => { Memory_store_f64(&mut self.memory, addr, of); }
                    Value::Bool(ob) => { Memory_store_bool(&mut self.memory, addr, ob); }
                    Value::Ptr(op) => { Memory_store_i64(&mut self.memory, addr, op); }
                    Value::Str(os) => {
                        var osa: i64 = Memory_store_cstr(&mut self.memory, os);
                        Memory_store_i64(&mut self.memory, addr, osa);
                    }
                    _ => {}
                }
                return ExecOutcome::Continue;
            }
            // Clear any stale opaque entry
            Interpreter_remove_opaque(self, addr);
            // Struct store: copy the struct bytes from the source pointer
            match sty {
                IrType::Struct(_) => {
                    match v {
                        Value::Ptr(src_addr) => {
                            var ssize: i64 = IrModule_type_size(&self.module, sty);
                            Memory_copy(&mut self.memory, addr, src_addr, ssize);
                            return ExecOutcome::Continue;
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            match v {
                Value::Int(iv) => {
                    match sty {
                        IrType::I8 => { Memory_store_byte(&mut self.memory, addr, iv & 0xFF); }
                        IrType::U8 => { Memory_store_byte(&mut self.memory, addr, iv & 0xFF); }
                        IrType::I16 => { Memory_store_i16(&mut self.memory, addr, iv); }
                        IrType::U16 => { Memory_store_i16(&mut self.memory, addr, iv); }
                        IrType::I32 => { Memory_store_i32(&mut self.memory, addr, iv); }
                        IrType::U32 => { Memory_store_i32(&mut self.memory, addr, iv); }
                        _ => { Memory_store_i64(&mut self.memory, addr, iv); }
                    }
                }
                Value::Float(fv) => {
                    match sty {
                        IrType::F32 => { Memory_store_f32(&mut self.memory, addr, fv); }
                        _ => { Memory_store_f64(&mut self.memory, addr, fv); }
                    }
                }
                Value::Bool(bv) => {
                    Memory_store_bool(&mut self.memory, addr, bv);
                }
                Value::Ptr(pv) => {
                    Memory_store_i64(&mut self.memory, addr, pv);
                    if I64Table_find(&self.tensor_index, pv) >= 0 { Interpreter_set_opaque(self, addr, v); }
                }
                Value::Str(s) => {
                    var str_addr: i64 = Memory_store_cstr(&mut self.memory, s);
                    Memory_store_i64(&mut self.memory, addr, str_addr);
                    Interpreter_set_opaque(self, addr, Value::Str(s));
                }
                Value::Vec(_) => { Interpreter_set_opaque(self, addr, v); }
                Value::Map(_) => { Interpreter_set_opaque(self, addr, v); }
                _ => {}
            }
            return ExecOutcome::Continue;
        }

        Inst::GetFieldPtr(struct_ptr, field_index, _) => {
            var base: i64 = 0;
            match get_value(values, struct_ptr) {
                Value::Ptr(a) => { base = a; }
                Value::Int(n) => { base = n; }
                _ => { base = 0; }
            }
            // Look up real field offset from struct layout
            var struct_name: str = "";
            var meta_opt: OptValueMeta = IrFunction_get_meta(func, struct_ptr);
            match meta_opt {
                OptValueMeta::Some(m) => {
                    match m.ty {
                        IrType::Ptr(inner) => {
                            match inner {
                                IrType::Struct(name) => { struct_name = name; }
                                _ => {}
                            }
                        }
                        IrType::Struct(name) => { struct_name = name; }
                        _ => {}
                    }
                }
                OptValueMeta::None => {}
            }
            var offset: i64 = field_index * 8;
            if str_len(struct_name) > 0 {
                match IrModule_get_struct(&self.module, struct_name) {
                    OptStructLayout::Some(layout) => {
                        if field_index >= 0 && field_index < layout.fields.len() {
                            var field: StringIrTypeOffset = layout.fields.get(field_index);
                            offset = field.offset;
                        }
                    }
                    OptStructLayout::None => {}
                }
            }
            return ExecOutcome::Value(Value::Ptr(base + offset));
        }

        Inst::GetElemPtr(base_ptr, index, elem_ty) => {
            var base: i64 = 0;
            match get_value(values, base_ptr) {
                Value::Ptr(a) => { base = a; }
                Value::Int(n) => { base = n; }
                _ => { base = 0; }
            }
            var idx_val: i64 = 0;
            match get_value(values, index) {
                Value::Int(i) => { idx_val = i; }
                _ => { idx_val = 0; }
            }
            // Bounds checking (when not in unsafe block)
            if self.interp_unsafe_depth == 0 {
                if idx_val < 0 {
                    return ExecOutcome::Panic("Array index out of bounds: negative index " + int_to_str(idx_val));
                }
                var arr_size: i64 = Interpreter_lookup_array_bound(self, base);
                if arr_size >= 0 && idx_val >= arr_size {
                    return ExecOutcome::Panic("Array index out of bounds: index " + int_to_str(idx_val) + " but array has " + int_to_str(arr_size) + " elements");
                }
            }
            var elem_size: i64 = IrModule_type_size(&self.module, elem_ty);
            if elem_size < 1 { elem_size = 1; }
            return ExecOutcome::Value(Value::Ptr(base + idx_val * elem_size));
        }

        // ─── Control Flow ───
        Inst::Jump(target) => {
            return ExecOutcome::Jump(target);
        }
        Inst::Branch(cond, then_block, else_block) => {
            var c: bool = false;
            match get_value(values, cond) {
                Value::Bool(b) => { c = b; }
                Value::Int(i) => { c = (i != 0); }
                _ => { c = false; }
            }
            if c {
                return ExecOutcome::Jump(then_block);
            } else {
                return ExecOutcome::Jump(else_block);
            }
        }
        Inst::Return(opt_val) => {
            match opt_val {
                OptValueId::Some(id) => {
                    return ExecOutcome::Return(get_value(values, id));
                }
                OptValueId::None => {
                    return ExecOutcome::Return(Value::Void);
                }
            }
        }
        Inst::Unreachable => {
            return ExecOutcome::Panic("Reached unreachable instruction");
        }

        // ─── Function Calls ───
        Inst::Call(name, arg_ids, call_ret_ty, _) => {
            var arg_vals: Vec<Value> = Vec::new();
            var ai: i64 = 0;
            while ai < arg_ids.len() {
                arg_vals.push(get_value(values, arg_ids.get(ai)));
                ai = ai + 1;
            }
            // Check if it's a runtime function
            if Interpreter_is_runtime_func(self, name) {
                if name == "p_vec_get" || name == "p_vec_pop" {
                    // A raw Vec element is the stored 8-byte word
                    var vout: ExecOutcome = Interpreter_call_runtime(self, name, &mut arg_vals);
                    match vout {
                        ExecOutcome::Value(rv) => { return ExecOutcome::Value(interp_reinterpret_word(rv, call_ret_ty)); }
                        _ => {}
                    }
                    return vout;
                }
                return Interpreter_call_runtime(self, name, &mut arg_vals);
            }
            // Check if it's a user function
            match Interpreter_get_function(self, name) {
                OptIrFunction::Some(callee) => {
                    // Record call site
                    var meta_opt2: OptValueMeta = IrFunction_get_meta(func, inst_id);
                    match meta_opt2 {
                        OptValueMeta::Some(m2) => {
                            match m2.source_line {
                                OptU64::Some(sl) => { self.pending_call_site = OptU64::Some(sl); }
                                OptU64::None => { self.pending_call_site = OptU64::None; }
                            }
                        }
                        OptValueMeta::None => { self.pending_call_site = OptU64::None; }
                    }
                    var result: RunResult = Interpreter_run_function(self, callee, arg_vals);
                    match result {
                        RunResult::Return(v) => { return ExecOutcome::Value(interp_reinterpret_word(v, call_ret_ty)); }
                        RunResult::Panic(msg) => { return ExecOutcome::Panic(msg); }
                        RunResult::Paused => { return ExecOutcome::Continue; }
                    }
                }
                OptIrFunction::None => {
                    return ExecOutcome::Panic("Unknown function '" + name + "'");
                }
            }
        }

        Inst::CallPtr(fn_ptr, arg_ids, _, _, _) => {
            var arg_vals2: Vec<Value> = Vec::new();
            var ai2: i64 = 0;
            while ai2 < arg_ids.len() {
                arg_vals2.push(get_value(values, arg_ids.get(ai2)));
                ai2 = ai2 + 1;
            }
            // Function pointer is an env struct: field 0 = fn name string
            var fn_name: str = "";
            var env_ptr: i64 = 0;
            match get_value(values, fn_ptr) {
                Value::Str(s) => {
                    fn_name = s;
                }
                Value::Ptr(addr) => {
                    // Read fn name pointer from field 0
                    var fn_ptr_addr: i64 = Memory_load_i64(&self.memory, addr);
                    fn_name = Memory_load_cstr(&self.memory, fn_ptr_addr);
                    env_ptr = addr;
                }
                _ => {
                    return ExecOutcome::Panic("CallPtr: function pointer is not a string or pointer");
                }
            }
            if Interpreter_is_runtime_func(self, fn_name) {
                return Interpreter_call_runtime(self, fn_name, &mut arg_vals2);
            }
            match Interpreter_get_function(self, fn_name) {
                OptIrFunction::Some(callee2) => {
                    var all_args: Vec<Value> = Vec::new();
                    if callee2.params.len() > arg_vals2.len() {
                        if env_ptr > 0 {
                            all_args.push(Value::Ptr(env_ptr));
                        } else {
                            all_args.push(Value::Int(0));
                        }
                    }
                    var xi: i64 = 0;
                    while xi < arg_vals2.len() {
                        all_args.push(arg_vals2.get(xi));
                        xi = xi + 1;
                    }
                    var result2: RunResult = Interpreter_run_function(self, callee2, all_args);
                    match result2 {
                        RunResult::Return(v2) => { return ExecOutcome::Value(v2); }
                        RunResult::Panic(msg2) => { return ExecOutcome::Panic(msg2); }
                        RunResult::Paused => { return ExecOutcome::Continue; }
                    }
                }
                OptIrFunction::None => {
                    return ExecOutcome::Panic("Unknown function in CallPtr: '" + fn_name + "'");
                }
            }
        }

        Inst::MakeDyn(value, type_name, _) => {
            var data_ptr: i64 = 0;
            match get_value(values, value) {
                Value::Ptr(p) => { data_ptr = p; }
                Value::Int(i) => { data_ptr = i; }
                _ => { data_ptr = 0; }
            }
            // Rust's Value::Dyn(type, data_ptr): the data pointer, with its
            // concrete type in the dyn side table
            I64Table_set(&mut self.dyn_types, data_ptr, Value::Str(type_name));
            return ExecOutcome::Value(Value::Ptr(data_ptr));
        }

        Inst::DynCall(trait_name, method, arg_ids, _, _) => {
            var arg_vals3: Vec<Value> = Vec::new();
            var ai3: i64 = 0;
            while ai3 < arg_ids.len() {
                arg_vals3.push(get_value(values, arg_ids.get(ai3)));
                ai3 = ai3 + 1;
            }
            // First arg is the receiver (Dyn or Str with type name)
            var type_name: str = "";
            var all_args3: Vec<Value> = Vec::new();
            var recv_ok: bool = false;
            if arg_vals3.len() > 0 {
                var recv_ptr: i64 = -1;
                match arg_vals3.get(0) {
                    Value::Str(s) => { type_name = s; recv_ok = true; }
                    Value::Ptr(rp) => { recv_ptr = rp; }
                    Value::Int(ri) => { recv_ptr = ri; }
                    _ => {}
                }
                if recv_ptr >= 0 {
                    match I64Table_get(&self.dyn_types, recv_ptr) {
                        OptValue::Some(tv) => {
                            match tv {
                                Value::Str(tn) => {
                                    type_name = tn;
                                    recv_ok = true;
                                    arg_vals3.set(0, Value::Ptr(recv_ptr));
                                }
                                _ => {}
                            }
                        }
                        OptValue::None => {}
                    }
                }
            }
            if !recv_ok {
                return ExecOutcome::Panic("DynCall: receiver is not a trait object (" + trait_name + "::" + method + ")");
            }
            var mangled: str = type_name + "_" + method;
            match Interpreter_get_function(self, mangled) {
                OptIrFunction::Some(callee3) => {
                    if callee3.params.len() > arg_vals3.len() {
                        all_args3.push(Value::Int(0));
                    }
                    var zi: i64 = 0;
                    while zi < arg_vals3.len() {
                        all_args3.push(arg_vals3.get(zi));
                        zi = zi + 1;
                    }
                    var result3: RunResult = Interpreter_run_function(self, callee3, all_args3);
                    match result3 {
                        RunResult::Return(v3) => { return ExecOutcome::Value(v3); }
                        RunResult::Panic(msg3) => { return ExecOutcome::Panic(msg3); }
                        RunResult::Paused => { return ExecOutcome::Continue; }
                    }
                }
                OptIrFunction::None => {
                    return ExecOutcome::Panic("DynCall: no method '" + method + "' on type '" + type_name + "' (looked for '" + mangled + "')");
                }
            }
        }

        // ─── Conversions ───
        Inst::BitCast(value, _, to) => {
            var v: Value = get_value(values, value);
            return ExecOutcome::Value(Interpreter_cast_value(self, v, to));
        }
        Inst::IntExtend(value, _, _) => {
            var v: Value = get_value(values, value);
            match v {
                Value::Int(i) => { return ExecOutcome::Value(Value::Int(i)); }
                _ => { return ExecOutcome::Value(Value::Int(0)); }
            }
        }
        Inst::IntTrunc(value, _, to) => {
            var v: Value = get_value(values, value);
            match v {
                Value::Int(i) => {
                    match to {
                        IrType::I8 => {
                            var t: i64 = i & 0xFF;
                            if t >= 128 { t = t - 256; }
                            return ExecOutcome::Value(Value::Int(t));
                        }
                        IrType::I16 => {
                            var t2: i64 = i & 0xFFFF;
                            if t2 >= 32768 { t2 = t2 - 65536; }
                            return ExecOutcome::Value(Value::Int(t2));
                        }
                        IrType::I32 => {
                            var t3: i64 = i & 0xFFFFFFFF;
                            if t3 >= 0x80000000 { t3 = t3 - 0x100000000; }
                            return ExecOutcome::Value(Value::Int(t3));
                        }
                        IrType::U8 => { return ExecOutcome::Value(Value::Int(i & 0xFF)); }
                        IrType::U16 => { return ExecOutcome::Value(Value::Int(i & 0xFFFF)); }
                        IrType::U32 => { return ExecOutcome::Value(Value::Int(i & 0xFFFFFFFF)); }
                        _ => { return ExecOutcome::Value(Value::Int(i)); }
                    }
                }
                _ => { return ExecOutcome::Value(Value::Int(0)); }
            }
        }
        Inst::IntToFloat(value, _, _) => {
            var v: Value = get_value(values, value);
            match v {
                Value::Int(i) => {
                    var f: f64 = (i as f64);
                    return ExecOutcome::Value(Value::Float(f));
                }
                _ => { return ExecOutcome::Value(Value::Float(0.0)); }
            }
        }
        Inst::FloatToInt(value, _, _) => {
            var v: Value = get_value(values, value);
            match v {
                Value::Float(f) => {
                    var i: i64 = (f as i64);
                    return ExecOutcome::Value(Value::Int(i));
                }
                _ => { return ExecOutcome::Value(Value::Int(0)); }
            }
        }

        // ─── Fides-Specific ───
        Inst::TryUnwrap(value, ok_block, _, _) => {
            return ExecOutcome::Jump(ok_block);
        }
        Inst::Print(value, ty) => {
            var v: Value = get_value(values, value);
            var is_int_or_ptr: bool = false;
            var raw: i64 = 0;
            match v {
                Value::Int(ri) => { is_int_or_ptr = true; raw = ri; }
                Value::Ptr(rp) => { is_int_or_ptr = true; raw = rp; }
                _ => {}
            }
            // Vec / HashMap values are raw pointers: format with the Fides
            // Vec_to_str / HashMap_to_str (src/interp.rs Print)
            if is_int_or_ptr && ir_type_is_opaque_named(ty, "Vec") {
                match Interpreter_print_via(self, "Vec_to_str", v) {
                    ExecOutcome::Continue => { return ExecOutcome::Continue; }
                    ExecOutcome::Panic(pm) => { return ExecOutcome::Panic(pm); }
                    _ => {}
                }
            }
            if is_int_or_ptr && ir_type_is_opaque_named(ty, "HashMap") {
                match Interpreter_print_via(self, "HashMap_to_str", v) {
                    ExecOutcome::Continue => { return ExecOutcome::Continue; }
                    ExecOutcome::Panic(pm2) => { return ExecOutcome::Panic(pm2); }
                    _ => {}
                }
            }
            if ir_type_is_opaque_named(ty, "String") {
                match v {
                    Value::Int(saddr) => {
                        if saddr > 0 && Memory_is_valid_addr(&self.memory, saddr) {
                            var ss: str = Memory_load_cstr(&self.memory, saddr);
                            if str_len(ss) > 0 {
                                p_print_str(ss);
                                return ExecOutcome::Continue;
                            }
                        }
                    }
                    _ => {}
                }
            }
            var is_str: bool = false;
            match ty {
                IrType::Ptr(inner) => {
                    match inner {
                        IrType::U8 => { is_str = true; }
                        _ => {}
                    }
                }
                _ => {}
            }
            if is_str {
                match v {
                    Value::Int(addr) => {
                        if addr > 0 && Memory_is_valid_addr(&self.memory, addr) {
                            // A str: print it even when it is empty.
                            p_print_str(Memory_load_cstr(&self.memory, addr));
                            return ExecOutcome::Continue;
                        }
                    }
                    _ => {}
                }
            }
            var tens_h: i64 = -1;
            match v {
                Value::Ptr(tp) => { tens_h = Interpreter_tensor_handle(self, v); }
                Value::Int(ti) => {
                    if ir_type_is_opaque_named(ty, "Tensor") { tens_h = Interpreter_tensor_handle(self, v); }
                }
                _ => {}
            }
            if tens_h >= 0 {
                p_print_str(interp_tensor_to_string(&self.tensors.get(tens_h)));
                return ExecOutcome::Continue;
            }
            match v {
                Value::Ptr(addr2) => {
                    var s2: str = Memory_load_cstr(&self.memory, addr2);
                    if str_len(s2) == 0 && !is_str {
                        p_print_str("ptr(0x" + int_to_hex(addr2) + ")");
                    } else {
                        p_print_str(s2);
                    }
                }
                _ => { p_print_str(Interpreter_display_value(self, v)); }
            }
            return ExecOutcome::Continue;
        }
        Inst::Panic(message) => {
            return ExecOutcome::Panic(message);
        }
        Inst::Asm(_, _, _, ret_ty) => {
            // Interpreter: no actual assembly execution
            match ret_ty {
                IrType::Void => { return ExecOutcome::Continue; }
                _ => { return ExecOutcome::Value(Value::Int(0)); }
            }
        }

        // ─── Region Management ───
        Inst::RegionBegin(name, _, _, _) => {
            self.region_stack.push(name);
            return ExecOutcome::Value(Value::Int(0));
        }
        Inst::RegionEnd(_, _, _) => {
            if self.region_stack.len() > 0 {
                self.region_stack.pop();
            }
            return ExecOutcome::Continue;
        }

        // ─── Persist Variables ───
        Inst::PersistLoad(name, default, _) => {
            // A value saved earlier (src/interp.rs persist_state), else the default
            var dv: Value = get_value(values, default);
            var pk: i64 = 0;
            while pk < self.persist_keys.len() {
                if self.persist_keys.get(pk) == name {
                    return ExecOutcome::Value(Interpreter_parse_persisted_value(self, self.persist_vals.get(pk), dv));
                }
                pk = pk + 1;
            }
            return ExecOutcome::Value(dv);
        }
        Inst::PersistSave(pname, pvalue) => {
            var ps: str = Interpreter_stringify_value(self, get_value(values, pvalue));
            var pj: i64 = 0;
            while pj < self.persist_keys.len() {
                if self.persist_keys.get(pj) == pname {
                    self.persist_vals.set(pj, ps);
                    return ExecOutcome::Continue;
                }
                pj = pj + 1;
            }
            self.persist_keys.push(pname);
            self.persist_vals.push(ps);
            return ExecOutcome::Continue;
        }

        // ─── Transaction Blocks ───
        Inst::TxnBegin => {
            // Deep snapshot — a struct copy would share the Vec backing, so
            // post-snapshot writes would already be visible in the "snapshot".
            self.txn_mem_snapshots.push(Memory_clone(&self.memory));
            self.txn_opaque_snapshots.push(OpaqueSnapshot { entries: I64Table_clone(&self.opaque_values) });
            return ExecOutcome::Continue;
        }
        Inst::TxnEnd => {
            if self.txn_mem_snapshots.len() > 0 {
                self.txn_mem_snapshots.pop();
            }
            if self.txn_opaque_snapshots.len() > 0 {
                self.txn_opaque_snapshots.pop();
            }
            return ExecOutcome::Continue;
        }

        // ─── Unsafe Blocks ───
        Inst::UnsafeBegin => {
            self.interp_unsafe_depth = self.interp_unsafe_depth + 1;
            return ExecOutcome::Continue;
        }
        Inst::UnsafeEnd => {
            if self.interp_unsafe_depth > 0 {
                self.interp_unsafe_depth = self.interp_unsafe_depth - 1;
            }
            return ExecOutcome::Continue;
        }

        // ─── Autograd (stubbed) ───
        Inst::GradBegin(_) => {
            self.ag_enabled = true;
            var fresh_tape: Vec<AgEntry> = Vec::new();
            self.ag_tape = fresh_tape;
            var fresh_keys: Vec<i64> = Vec::new();
            self.ag_grad_keys = fresh_keys;
            var fresh_vals: Vec<TensorData> = Vec::new();
            self.ag_grad_vals = fresh_vals;
            return ExecOutcome::Continue;
        }
        Inst::GradEnd => {
            self.ag_enabled = false;
            return ExecOutcome::Continue;
        }
        Inst::Backward(_) => {
            Interpreter_run_backward(self);
            return ExecOutcome::Continue;
        }
        Inst::StructCopy(dst, src, ty) => {
            // memcpy struct data src -> dst (src/interp.rs:1604)
            var dst_addr: i64 = 0;
            match get_value(values, dst) {
                Value::Ptr(a) => { dst_addr = a; }
                Value::Int(n) => { dst_addr = n; }
                _ => {}
            }
            var src_addr: i64 = 0;
            match get_value(values, src) {
                Value::Ptr(a) => { src_addr = a; }
                Value::Int(n) => { src_addr = n; }
                _ => {}
            }
            var size: i64 = IrModule_type_size(&self.module, ty);
            var ci: i64 = 0;
            while ci < size {
                var b: i64 = Memory_load_byte(&self.memory, src_addr + ci);
                Memory_store_byte(&mut self.memory, dst_addr + ci, b);
                ci = ci + 1;
            }
            return ExecOutcome::Continue;
        }
    }
    return ExecOutcome::Continue;
}

// ===========================================================================
// eval_binop -- evaluate a binary operation
// ===========================================================================

fn meta_is_u64(m: OptValueMeta) -> bool {
    match m {
        OptValueMeta::Some(v) => { return ir_type_eq(v.ty, IrType::U64); }
        OptValueMeta::None => { return false; }
    }
}

fn interp_plain_int(t: IrType) -> bool {
    match t {
        IrType::I8 => { return true; }
        IrType::I16 => { return true; }
        IrType::I32 => { return true; }
        IrType::I64 => { return true; }
        IrType::U8 => { return true; }
        IrType::U16 => { return true; }
        IrType::U32 => { return true; }
        IrType::U64 => { return true; }
        _ => { return false; }
    }
}

/// `v` as a value of integer type `t` (as a cast would give it).
fn interp_int_norm(v: i64, t: IrType) -> i64 {
    match t {
        IrType::I8 => { return (v << 56) >> 56; }
        IrType::I16 => { return (v << 48) >> 48; }
        IrType::I32 => { return (v << 32) >> 32; }
        IrType::U8 => { return v & 0xFF; }
        IrType::U16 => { return v & 0xFFFF; }
        IrType::U32 => { return v & 0xFFFFFFFF; }
        _ => { return v; }
    }
}

/// Integer operands go through the operation's type, the one meaning every
/// backend implements; everything else through eval_binop.
fn Interpreter_eval_typed(self: &Interpreter, op: BinOp, l: Value, r: Value, ty: IrType, u64_operand: bool) -> Value {
    match l {
        Value::Int(a) => {
            match r {
                Value::Int(b) => {
                    if interp_plain_int(ty) {
                        return Interpreter_eval_int_binop(self, op, a, b, ty);
                    }
                    if u64_operand {
                        var ua: u64 = a as u64;
                        var ub: u64 = b as u64;
                        match op {
                            BinOp::Lt => { return Value::Bool(ua < ub); }
                            BinOp::Gt => { return Value::Bool(ua > ub); }
                            BinOp::LtEq => { return Value::Bool(ua <= ub); }
                            BinOp::GtEq => { return Value::Bool(ua >= ub); }
                            _ => {}
                        }
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
    return Interpreter_eval_binop(self, op, l, r);
}

/// Integer arithmetic in type `ty` (as src/interp.rs eval_int_binop).
/// Overflow is Value::Void (the caller panics) or, in a @wrapping program,
/// wraps at that width; dividing by zero is always Void. This function
/// itself wraps: it tests each result.
@wrapping
fn Interpreter_eval_int_binop(self: &Interpreter, op: BinOp, a: i64, b: i64, ty: IrType) -> Value {
    var is_u64: bool = ir_type_eq(ty, IrType::U64);
    var is_i64: bool = ir_type_eq(ty, IrType::I64);
    var ua: u64 = a as u64;
    var ub: u64 = b as u64;
    var r: i64 = 0;
    var ovf: bool = false;
    match op {
        BinOp::Add => {
            r = a + b;
            if is_u64 { ovf = (r as u64) < ua; }
            else if is_i64 { ovf = ((a ^ r) & (b ^ r)) < 0; }
        }
        BinOp::Sub => {
            r = a - b;
            if is_u64 { ovf = ua < ub; }
            else if is_i64 { ovf = ((a ^ b) & (a ^ r)) < 0; }
        }
        BinOp::Mul => {
            r = a * b;
            if is_u64 {
                if a != 0 { ovf = (r as u64) / ua != ub; }
            } else if is_i64 {
                var i64_min: i64 = (1 << 63);
                if a != 0 { ovf = (a == -1 && b == i64_min) || r / a != b; }
            }
        }
        BinOp::Div => {
            if b == 0 { return Value::Void; }
            if is_u64 { return Value::Int((ua / ub) as i64); }
            if b == -1 {
                r = 0 - a;
                if is_i64 { ovf = a == (1 << 63); }
            } else {
                r = a / b;
            }
        }
        BinOp::Mod => {
            if b == 0 { return Value::Void; }
            if is_u64 { return Value::Int((ua % ub) as i64); }
            if b == -1 { return Value::Int(0); }
            return Value::Int(a % b);
        }
        BinOp::Shl => { return Value::Int(interp_int_norm(a << (b & 63), ty)); }
        BinOp::Shr => {
            if is_u64 { return Value::Int((ua >> (ub & 63)) as i64); }
            return Value::Int(a >> (b & 63));
        }
        _ => { return Interpreter_eval_binop(self, op, Value::Int(a), Value::Int(b)); }
    }
    var fit: i64 = interp_int_norm(r, ty);
    if !ovf && !is_u64 && !is_i64 { ovf = fit != r; }
    if ovf && !Interpreter_is_wrapping_func(self) { return Value::Void; }
    return Value::Int(fit);
}

pub fn Interpreter_eval_binop(self: &Interpreter, op: BinOp, l: Value, r: Value) -> Value {
    // A bool compared with an integer is 0 or 1, as in C (runtime predicates
    // return bool; `p_file_exists(p) != 0` must work).
    match l {
        Value::Bool(lb) => {
            match r {
                Value::Int(_) => {
                    var li: i64 = 0;
                    if lb { li = 1; }
                    return Interpreter_eval_binop(self, op, Value::Int(li), r);
                }
                _ => {}
            }
        }
        Value::Int(_) => {
            match r {
                Value::Bool(rb) => {
                    var ri: i64 = 0;
                    if rb { ri = 1; }
                    return Interpreter_eval_binop(self, op, l, Value::Int(ri));
                }
                _ => {}
            }
        }
        _ => {}
    }
    match l {
        Value::Int(a) => {
            match r {
                Value::Int(b) => {
                    var i64_max: i64 = 9223372036854775807;
                    var i64_min: i64 = 0 - 9223372036854775807 - 1;
                    var use_wrapping: bool = Interpreter_is_wrapping_func(self);
                    match op {
                        BinOp::Add => {
                            if !use_wrapping {
                                // Pre-check: computing a+b under a checked host would
                                // trap before we can test the result.
                                if b > 0 && a > i64_max - b { return Value::Void; }
                                if b < 0 && a < i64_min - b { return Value::Void; }
                            }
                            if use_wrapping { return Value::Int(wrap_add(a, b)); }
                            return Value::Int(a + b);
                        }
                        BinOp::Sub => {
                            if !use_wrapping {
                                if b > 0 && a < i64_min + b { return Value::Void; }
                                if b < 0 && a > i64_max + b { return Value::Void; }
                            }
                            if use_wrapping { return Value::Int(wrap_sub(a, b)); }
                            return Value::Int(a - b);
                        }
                        BinOp::Mul => {
                            if !use_wrapping {
                                // CERT-style division pre-checks; all divisions are
                                // exact-or-toward-zero and cannot themselves overflow.
                                var mul_ovf: bool = false;
                                if a > 0 {
                                    if b > 0 { mul_ovf = a > i64_max / b; }
                                    else if b < 0 { mul_ovf = b < i64_min / a; }
                                } else if a < 0 {
                                    if b > 0 { mul_ovf = a < i64_min / b; }
                                    else if b < 0 { mul_ovf = a < i64_max / b; }
                                }
                                if mul_ovf { return Value::Void; }
                            }
                            if use_wrapping { return Value::Int(wrap_mul(a, b)); }
                            return Value::Int(a * b);
                        }
                        BinOp::Div => {
                            if b == 0 { return Value::Void; }
                            if b == -1 && a == i64_min { return Value::Int(i64_min); }
                            return Value::Int(a / b);
                        }
                        BinOp::Mod => {
                            if b == 0 { return Value::Void; }
                            if b == -1 && a == i64_min { return Value::Int(0); }
                            return Value::Int(a % b);
                        }
                        BinOp::Eq => { return Value::Bool(a == b); }
                        BinOp::Neq => { return Value::Bool(a != b); }
                        BinOp::Lt => { return Value::Bool(a < b); }
                        BinOp::Gt => { return Value::Bool(a > b); }
                        BinOp::LtEq => { return Value::Bool(a <= b); }
                        BinOp::GtEq => { return Value::Bool(a >= b); }
                        BinOp::And => { return Value::Bool(a != 0 && b != 0); }
                        BinOp::Or => { return Value::Bool(a != 0 || b != 0); }
                        BinOp::BitAnd => { return Value::Int(a & b); }
                        BinOp::BitOr => { return Value::Int(a | b); }
                        BinOp::BitXor => { return Value::Int(a ^ b); }
                        BinOp::Shl => { return Value::Int(a << (b & 63)); }
                        BinOp::Shr => { return Value::Int(a >> (b & 63)); }
                    }
                }
                Value::Ptr(b_addr) => {
                    match op {
                        BinOp::Add => { return Value::Ptr(a + b_addr); }
                        BinOp::Eq => { return Value::Bool(a == b_addr); }
                        BinOp::Neq => { return Value::Bool(a != b_addr); }
                        BinOp::Lt => { return Value::Bool(a < b_addr); }
                        BinOp::LtEq => { return Value::Bool(a <= b_addr); }
                        BinOp::Gt => { return Value::Bool(a > b_addr); }
                        BinOp::GtEq => { return Value::Bool(a >= b_addr); }
                        _ => { return Value::Void; }
                    }
                }
                Value::Str(bs) => {
                    match op {
                        BinOp::Eq => { return Value::Bool(str_len(bs) == 0 && a == 0); }
                        BinOp::Neq => { return Value::Bool(!(str_len(bs) == 0 && a == 0)); }
                        _ => { return Value::Void; }
                    }
                }
                _ => { return Value::Void; }
            }
        }
        Value::Float(a) => {
            match r {
                Value::Float(b) => {
                    match op {
                        BinOp::Add => { return Value::Float(a + b); }
                        BinOp::Sub => { return Value::Float(a - b); }
                        BinOp::Mul => { return Value::Float(a * b); }
                        BinOp::Div => { return Value::Float(a / b); }
                        BinOp::Mod => { return Value::Float(a % b); }
                        BinOp::Eq => { return Value::Bool(a == b); }
                        BinOp::Neq => { return Value::Bool(a != b); }
                        BinOp::Lt => { return Value::Bool(a < b); }
                        BinOp::Gt => { return Value::Bool(a > b); }
                        BinOp::LtEq => { return Value::Bool(a <= b); }
                        BinOp::GtEq => { return Value::Bool(a >= b); }
                        _ => { return Value::Float(0.0); }
                    }
                }
                _ => { return Value::Void; }
            }
        }
        Value::Bool(a) => {
            match r {
                Value::Bool(b) => {
                    match op {
                        BinOp::Eq => { return Value::Bool(a == b); }
                        BinOp::Neq => { return Value::Bool(a != b); }
                        BinOp::And => { return Value::Bool(a && b); }
                        BinOp::Or => { return Value::Bool(a || b); }
                        _ => { return Value::Bool(false); }
                    }
                }
                _ => { return Value::Void; }
            }
        }
        Value::Str(a) => {
            match r {
                Value::Str(b) => {
                    match op {
                        BinOp::Eq => { return Value::Bool(a == b); }
                        BinOp::Neq => { return Value::Bool(a != b); }
                        _ => { return Value::Void; }
                    }
                }
                Value::Int(b2) => {
                    match op {
                        BinOp::Eq => { return Value::Bool(str_len(a) == 0 && b2 == 0); }
                        BinOp::Neq => { return Value::Bool(!(str_len(a) == 0 && b2 == 0)); }
                        _ => { return Value::Void; }
                    }
                }
                Value::Ptr(pb) => {
                    var ps: str = Memory_load_cstr(&self.memory, pb);
                    match op {
                        BinOp::Eq => { return Value::Bool(a == ps); }
                        BinOp::Neq => { return Value::Bool(a != ps); }
                        _ => { return Value::Void; }
                    }
                }
                _ => { return Value::Void; }
            }
        }
        Value::Ptr(a_addr) => {
            match r {
                Value::Int(b3) => {
                    match op {
                        BinOp::Add => { return Value::Ptr(a_addr + b3); }
                        BinOp::Sub => { return Value::Ptr(a_addr - b3); }
                        BinOp::Eq => { return Value::Bool(a_addr == b3); }
                        BinOp::Neq => { return Value::Bool(a_addr != b3); }
                        BinOp::Lt => { return Value::Bool(a_addr < b3); }
                        BinOp::LtEq => { return Value::Bool(a_addr <= b3); }
                        BinOp::Gt => { return Value::Bool(a_addr > b3); }
                        BinOp::GtEq => { return Value::Bool(a_addr >= b3); }
                        _ => { return Value::Void; }
                    }
                }
                Value::Str(sb) => {
                    var pa: str = Memory_load_cstr(&self.memory, a_addr);
                    match op {
                        BinOp::Eq => { return Value::Bool(pa == sb); }
                        BinOp::Neq => { return Value::Bool(pa != sb); }
                        _ => { return Value::Void; }
                    }
                }
                Value::Ptr(b_addr2) => {
                    match op {
                        BinOp::Eq => { return Value::Bool(a_addr == b_addr2); }
                        BinOp::Neq => { return Value::Bool(a_addr != b_addr2); }
                        BinOp::Lt => { return Value::Bool(a_addr < b_addr2); }
                        BinOp::LtEq => { return Value::Bool(a_addr <= b_addr2); }
                        BinOp::Gt => { return Value::Bool(a_addr > b_addr2); }
                        BinOp::GtEq => { return Value::Bool(a_addr >= b_addr2); }
                        _ => { return Value::Void; }
                    }
                }
                _ => { return Value::Void; }
            }
        }
        _ => { return Value::Void; }
    }
    return Value::Void;
}

// ===========================================================================
// eval_unaryop -- evaluate a unary operation
// ===========================================================================

pub fn Interpreter_eval_unaryop(self: &Interpreter, op: UnaryOp, v: Value) -> Value {
    match v {
        Value::Int(i) => {
            match op {
                UnaryOp::Neg => { return Value::Int(-i); }
                UnaryOp::Not => { return Value::Bool(i == 0); }
                UnaryOp::BitNot => { return Value::Int(~i); }
            }
        }
        Value::Float(f) => {
            match op {
                UnaryOp::Neg => { return Value::Float(-f); }
                _ => { return Value::Float(0.0); }
            }
        }
        Value::Bool(b) => {
            match op {
                UnaryOp::Not => { return Value::Bool(!b); }
                _ => { return Value::Bool(false); }
            }
        }
        _ => { return Value::Void; }
    }
    return Value::Void;
}

// ===========================================================================
// cast_value -- cast a value to a different type
// ===========================================================================

pub fn Interpreter_cast_value(self: &Interpreter, v: Value, to: IrType) -> Value {
    match v {
        Value::Int(i) => {
            match to {
                IrType::F32 => { return Value::Float((i as f64)); }
                IrType::F64 => { return Value::Float((i as f64)); }
                // An address made a pointer (`p + off` cast to *T): a Store
                // or Load through it needs a pointer value, or it went to 0
                IrType::Ptr(_) => {
                    if i == 0 { return Value::Int(0); }
                    return Value::Ptr(i);
                }
                _ => { return Value::Int(i); }
            }
        }
        Value::Ptr(pa) => {
            match to {
                IrType::I64 => { return Value::Int(pa); }
                IrType::U64 => { return Value::Int(pa); }
                _ => { return v; }
            }
        }
        Value::Float(f) => {
            match to {
                IrType::I64 => { return Value::Int((f as i64)); }
                IrType::I32 => { return Value::Int((f as i64)); }
                _ => { return Value::Float(f); }
            }
        }
        Value::Bool(b) => {
            match to {
                IrType::I64 => {
                    if b { return Value::Int(1); }
                    return Value::Int(0);
                }
                _ => { return Value::Bool(b); }
            }
        }
        _ => { return v; }
    }
    return v;
}

// ===========================================================================
// is_runtime_func -- check if a name is a runtime function
// ===========================================================================

pub fn Interpreter_is_runtime_func(self: &mut Interpreter, name: str) -> bool {
    var cached: i64 = StrTable_get(&self.rt_cache, name, -1);
    if cached >= 0 { return cached == 1; }
    var r: bool = Interpreter_is_runtime_func_uncached(self, name);
    if r { StrTable_set(&mut self.rt_cache, name, 1); } else { StrTable_set(&mut self.rt_cache, name, 0); }
    return r;
}

pub fn Interpreter_is_runtime_func_uncached(self: &Interpreter, name: str) -> bool {
    // Check if it's an extern function
    var i: i64 = 0;
    while i < self.module.extern_functions.len() {
        if self.module.extern_functions.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    // Check known runtime prefixes
    if name == "print" { return true; }
    if str_starts_with(name, "p_vec_") { return true; }
    if str_starts_with(name, "p_map_") { return true; }
    if str_starts_with(name, "p_string_") { return true; }
    if str_starts_with(name, "p_json_") { return true; }
    if str_starts_with(name, "p_tensor_") { return true; }
    if str_starts_with(name, "p_simd_") { return true; }
    if str_starts_with(name, "p_socket_") { return true; }
    if str_starts_with(name, "p_http_") { return true; }
    if str_starts_with(name, "p_db_") { return true; }
    if str_starts_with(name, "p_file_") { return true; }
    if str_starts_with(name, "p_dir_") { return true; }
    if str_starts_with(name, "p_process_") { return true; }
    if name == "p_mkdir" || name == "p_rmdir" || name == "p_rename" || name == "p_is_dir" { return true; }
    if name == "p_getpid" { return true; }
    if str_starts_with(name, "p_thread_") { return true; }
    if str_starts_with(name, "p_atomic_") { return true; }
    if str_starts_with(name, "p_mutex_") { return true; }
    if str_starts_with(name, "p_shared_") { return true; }
    if str_starts_with(name, "p_future_") { return true; }
    if str_starts_with(name, "p_grad_") { return true; }
    if str_starts_with(name, "__ecs_") { return true; }
    if str_starts_with(name, "p_dp_budget_") { return true; }
    if str_starts_with(name, "p_tp_") { return true; }
    if str_starts_with(name, "p_checkpoint_") { return true; }
    if str_starts_with(name, "p_volatile_") { return true; }
    // The lowering's fused string forms (`s + int_to_str(n)`, `s = s + x`):
    // core writes them into memory, but here strings are the interpreter's
    // own values, so they run as builtins even though core defines them
    if name == "p_str_concat_int" || name == "p_str_append" { return true; }
    if str_starts_with(name, "p_signal_") { return true; }
    // The runtime set of src/interp.rs ends here. A name the program or
    // core defines as a Fides function runs that function (core implements
    // p_str_equal, p_str_length, ... itself): the builtins below are only
    // for names nothing defines.
    match Interpreter_get_function(self, name) {
        OptIrFunction::Some(_) => { return false; }
        OptIrFunction::None => {}
    }
    if str_starts_with(name, "p_sb_") { return true; }
    // PRNG and noise builtins
    if name == "p_prng_next" { return true; }
    if name == "p_prng_uniform" { return true; }
    if name == "p_prng_gaussian" { return true; }
    if name == "p_dp_noise" { return true; }
    if name == "p_gaussian_noise" { return true; }
    if name == "p_dropout" { return true; }
    // Check common p_ builtins
    if name == "p_print_int" { return true; }
    if name == "p_print_float" { return true; }
    if name == "p_print_bool" { return true; }
    if name == "p_print_str" { return true; }
    if name == "p_eprint_str" { return true; }
    if name == "p_print_newline" { return true; }
    if name == "p_panic" { return true; }
    if name == "p_alloc" { return true; }
    if name == "p_malloc" { return true; }
    if name == "p_free" { return true; }
    if name == "p_region_free" { return true; }
    if name == "p_str_concat" { return true; }
    if name == "p_str_concat_int" { return true; }
    if name == "p_to_str" { return true; }
    if name == "p_char_to_str" { return true; }
    if name == "p_float_to_str" { return true; }
    if name == "p_str_to_float" { return true; }
    if name == "p_str_to_int" { return true; }
    if name == "p_str_len" { return true; }
    if name == "p_str_equal" { return true; }
    if name == "p_str_cmp" { return true; }
    if name == "p_bool_to_str" { return true; }
    if name == "p_clock_now" { return true; }
    if name == "p_clock_now_us" { return true; }
    if name == "p_os_random_u64" { return true; }
    if name == "p_clock_now_ms" { return true; }
    if name == "p_memset" { return true; }
    if name == "p_str_zeroize" { return true; }
    if name == "p_vec_zeroize" { return true; }
    return false;
}

// ===========================================================================
// call_runtime -- dispatch runtime builtin functions
// ===========================================================================
//
// This implements the essential runtime builtins needed for basic
// program execution: printing, panics, allocation, string operations,
// vectors, maps, and numeric conversions.
// Advanced builtins (tensors, networking, threads, etc.) return defaults.

pub fn Interpreter_call_runtime(self: &mut Interpreter, name: str, args: &mut Vec<Value>) -> ExecOutcome {
    // A raw Vec handle may arrive as a Ptr (loaded from a by-value struct
    // copy's Vec field): the p_vec_* builtins take its address.
    if str_starts_with(name, "p_vec_") && args.len() > 0 {
        match args.get(0) {
            Value::Ptr(vp) => { args.set(0, Value::Int(vp)); }
            _ => {}
        }
    }
    var tout: ExecOutcome = Interpreter_call_tensor(self, name, args);
    if !outcome_is_unhandled(tout) { return tout; }
    // ─── Printing ───
    if name == "p_print_int" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(i) => { p_print_int(i); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_print_float" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Float(f) => { p_print_float(f); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_print_bool" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Bool(b) => { p_print_bool(b); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_print_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Str(s) => { p_print_str(s); }
                Value::Ptr(addr) => {
                    var loaded: str = Memory_load_cstr(&self.memory, addr);
                    p_print_str(loaded);
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_eprint_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Str(s) => { p_eprint_str(s); }
                Value::Ptr(addr) => {
                    var loaded: str = Memory_load_cstr(&self.memory, addr);
                    p_eprint_str(loaded);
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_print_newline" {
        p_print_str("\n");
        return ExecOutcome::Value(Value::Void);
    }
    if name == "print" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Ptr(addr) => { p_print_str(Memory_load_cstr(&self.memory, addr)); }
                Value::Vec(pvh) => { p_print_str(Interpreter_display_vec_quoted(self, pvh)); }
                Value::Void => { p_print_str("Void"); }
                _ => { p_print_str(Interpreter_display_value(self, args.get(0))); }
            }
        }
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Panic ───
    if name == "p_panic" {
        var msg: str = "panic";
        if args.len() > 0 {
            msg = Interpreter_value_to_string(self, args.get(0));
        }
        return ExecOutcome::Panic(msg);
    }

    // ─── Allocation ───
    if name == "p_alloc" || name == "p_malloc" {
        var size: i64 = 0;
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(s) => {
                    if s < 1 { size = 1; } else { size = s; }
                }
                _ => {}
            }
        }
        var addr: i64 = Memory_alloc(&mut self.memory, size);
        return ExecOutcome::Value(Value::Ptr(addr));
    }
    if name == "p_free" {
        // Strings and Vecs are managed values here, not blocks
        var addr: i64 = 0;
        if args.len() > 0 {
            match args.get(0) {
                Value::Ptr(a) => { addr = a; }
                Value::Int(a) => { addr = a; }
                _ => {}
            }
        }
        if addr != 0 {
            var msg: str = Memory_free(&mut self.memory, addr);
            if str_len(msg) > 0 { return ExecOutcome::Panic(msg); }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_region_free" { return ExecOutcome::Value(Value::Void); }
    // Interpreter memory is never reused, so a mark has nothing to restore.
    if name == "p_arena_save" { return ExecOutcome::Value(Value::Int(0)); }
    if name == "p_arena_restore" { return ExecOutcome::Value(Value::Void); }

    // ─── String Operations ───
    if name == "p_str_concat" {
        var left: str = "";
        var right: str = "";
        if args.len() > 0 { left = Interpreter_value_to_string(self, args.get(0)); }
        if args.len() > 1 { right = Interpreter_value_to_string(self, args.get(1)); }
        return ExecOutcome::Value(Value::Str(left + right));
    }
    // Signals within the process (stdlib/signal.fd): registered and pending
    // flags per signal number (< 64)
    if name == "p_signal_register" || name == "p_signal_raise" || name == "p_signal_check" {
        var sn: i64 = arg_int(args, args.len() - 1, 0);
        if sn < 0 || sn >= 64 { return ExecOutcome::Value(Value::Int(-1)); }
        var bit: i64 = 1 << sn;
        if name == "p_signal_register" {
            g_interp_sig_registered = g_interp_sig_registered | bit;
            return ExecOutcome::Value(Value::Int(0));
        }
        if name == "p_signal_raise" {
            if (g_interp_sig_registered & bit) != 0 { g_interp_sig_pending = g_interp_sig_pending | bit; }
            return ExecOutcome::Value(Value::Int(0));
        }
        var was: i64 = 0;
        if (g_interp_sig_pending & bit) != 0 { was = 1; }
        g_interp_sig_pending = g_interp_sig_pending & (~bit);
        return ExecOutcome::Value(Value::Int(was));
    }
    if name == "p_str_append" {
        var al: str = "";
        var ar: str = "";
        if args.len() >= 2 {
            al = Interpreter_value_to_string(self, args.get(args.len() - 2));
            ar = Interpreter_value_to_string(self, args.get(args.len() - 1));
        }
        return ExecOutcome::Value(Value::Str(al + ar));
    }
    // `s + int_to_str(n)` fused by the lowering (core's p_str_concat_int):
    // on the interpreter's own strings, as p_str_concat
    if name == "p_str_concat_int" {
        var cl: str = "";
        var cn: i64 = 0;
        if args.len() >= 2 {
            cl = Interpreter_value_to_string(self, args.get(args.len() - 2));
            match args.get(args.len() - 1) {
                Value::Int(ci) => { cn = ci; }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Str(cl + int_to_str(cn)));
    }
    if name == "p_to_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(ti) => { return ExecOutcome::Value(Value::Str(int_to_str(ti))); }
                Value::Float(tf) => { return ExecOutcome::Value(Value::Str(float_to_str(tf))); }
                Value::Bool(tb) => {
                    if tb { return ExecOutcome::Value(Value::Str("true")); }
                    return ExecOutcome::Value(Value::Str("false"));
                }
                Value::Str(ts) => { return ExecOutcome::Value(Value::Str(ts)); }
                Value::Vec(tvh) => { return ExecOutcome::Value(Value::Str(Interpreter_display_vec_quoted(self, tvh))); }
                Value::Map(_) => { return ExecOutcome::Value(Value::Str(Interpreter_display_value(self, args.get(0)))); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_char_to_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(i) => { return ExecOutcome::Value(Value::Str(p_char_to_str(i))); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_float_to_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Float(f) => { return ExecOutcome::Value(Value::Str(float_to_str(f))); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_str_to_float" {
        if args.len() > 0 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            return ExecOutcome::Value(Value::Float(p_str_to_float(s)));
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "p_str_to_int" {
        if args.len() > 0 {
            var s: str = Interpreter_value_to_string(self, args.get(0));
            return ExecOutcome::Value(Value::Int(p_str_to_int(s)));
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_str_len" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Str(s) => { return ExecOutcome::Value(Value::Int(str_len(s))); }
                Value::Ptr(addr) => {
                    var loaded: str = Memory_load_cstr(&self.memory, addr);
                    return ExecOutcome::Value(Value::Int(str_len(loaded)));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_str_equal" {
        // p_str_equal(a, b, n) — compare n bytes
        if args.len() >= 3 {
            var a_str: str = Interpreter_value_to_string(self, args.get(0));
            var b_str: str = Interpreter_value_to_string(self, args.get(1));
            match args.get(2) {
                Value::Int(n) => {
                    if n >= str_len(a_str) && n >= str_len(b_str) {
                        return ExecOutcome::Value(Value::Bool(a_str == b_str));
                    }
                    // Compare first n characters
                    var i: i64 = 0;
                    while i < n {
                        var ac: i64 = 0;
                        var bc: i64 = 0;
                        if i < str_len(a_str) {
                            var ap: i64 = a_str + i;
                            var aptr: *mut u8 = ap;
                            unsafe { ac = *aptr; }
                        }
                        if i < str_len(b_str) {
                            var bp: i64 = b_str + i;
                            var bptr: *mut u8 = bp;
                            unsafe { bc = *bptr; }
                        }
                        if ac != bc { return ExecOutcome::Value(Value::Bool(false)); }
                        i = i + 1;
                    }
                    return ExecOutcome::Value(Value::Bool(true));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_str_cmp" {
        if args.len() >= 2 {
            var a_str2: str = Interpreter_value_to_string(self, args.get(0));
            var b_str2: str = Interpreter_value_to_string(self, args.get(1));
            if a_str2 == b_str2 { return ExecOutcome::Value(Value::Int(0)); }
            // Simplified: return 1 if a > b, -1 if a < b
            return ExecOutcome::Value(Value::Int(1));
        }
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── Vec Operations ───
    // p_vec_new() -> returns a raw Fides Vec struct (24 bytes: data, len, cap)
    // The interpreter allocates this in simulated memory and tracks it.
    if name == "p_vec_new" {
        // Allocate 24 bytes for the Vec struct {data: i64, len: i64, cap: i64}
        var vec_addr: i64 = Memory_alloc(&mut self.memory, 40);
        // Initialize: data=0, len=0, cap=0, element code 0 (a word, D14),
        // element type 0 (plain values, proposal 0004)
        Memory_store_i64(&mut self.memory, vec_addr, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 8, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 16, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 24, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 32, 0);
        // Also create a side-table entry for interpreter-level Vec operations
        var handle: i64 = self.vec_values.len();
        self.vec_values.push(VecValueEntry_new(handle));
        self.vec_side_table.push(VecSideEntry_new(vec_addr, handle));
        return ExecOutcome::Value(Value::Int(vec_addr));
    }
    if name == "p_vec_push" {
        // p_vec_push(vec_addr, elem) — elem is an i64 (raw value)
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var elem: i64 = Interpreter_value_word(self, args.get(1));
                    // Read current len and cap
                    var len: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    var cap: i64 = Memory_load_i64(&self.memory, vec_addr + 16);
                    var data: i64 = Memory_load_i64(&self.memory, vec_addr);
                    // Grow if needed
                    if len >= cap {
                        var new_cap: i64 = 8;
                        if cap > 0 { new_cap = cap * 2; }
                        var pcode: i64 = Memory_load_i64(&self.memory, vec_addr + 24);
                        var new_data: i64 = Memory_alloc(&mut self.memory, new_cap * interp_vec_esz(pcode));
                        // Copy old data
                        var ci: i64 = 0;
                        while ci < len {
                            var v: i64 = interp_vec_ld(&self.memory, data, ci, pcode);
                            interp_vec_st(&mut self.memory, new_data, ci, pcode, v);
                            ci = ci + 1;
                        }
                        data = new_data;
                        cap = new_cap;
                        Memory_store_i64(&mut self.memory, vec_addr, data);
                        Memory_store_i64(&mut self.memory, vec_addr + 16, cap);
                    }
                    // Store element (at its size, D14)
                    interp_vec_st(&mut self.memory, data, len, Memory_load_i64(&self.memory, vec_addr + 24), elem);
                    len = len + 1;
                    Memory_store_i64(&mut self.memory, vec_addr + 8, len);
                    return ExecOutcome::Value(Value::Void);
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_get" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    match args.get(1) {
                        Value::Int(idx) => {
                            var len: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                            if idx < 0 || idx >= len {
                                return ExecOutcome::Panic("Vec index out of bounds");
                            }
                            var data: i64 = Memory_load_i64(&self.memory, vec_addr);
                            var elem: i64 = interp_vec_ld(&self.memory, data, idx, Memory_load_i64(&self.memory, vec_addr + 24));
                            return ExecOutcome::Value(Value::Int(elem));
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_vec_set" {
        if args.len() >= 3 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    match args.get(1) {
                        Value::Int(idx) => {
                            var elem2: i64 = Interpreter_value_word(self, args.get(2));
                            var len2: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                            if idx < 0 || idx >= len2 {
                                return ExecOutcome::Panic("Vec index out of bounds");
                            }
                            var data2: i64 = Memory_load_i64(&self.memory, vec_addr);
                            interp_vec_st(&mut self.memory, data2, idx, Memory_load_i64(&self.memory, vec_addr + 24), elem2);
                            return ExecOutcome::Value(Value::Void);
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_len" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var len3: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    return ExecOutcome::Value(Value::Int(len3));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_vec_is_empty" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var len4: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    return ExecOutcome::Value(Value::Bool(len4 == 0));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Bool(true));
    }
    if name == "p_vec_pop" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var len5: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    if len5 == 0 {
                        return ExecOutcome::Panic("Vec is empty");
                    }
                    var data5: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var elem5: i64 = interp_vec_ld(&self.memory, data5, len5 - 1, Memory_load_i64(&self.memory, vec_addr + 24));
                    len5 = len5 - 1;
                    Memory_store_i64(&mut self.memory, vec_addr + 8, len5);
                    return ExecOutcome::Value(Value::Int(elem5));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_vec_clear" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    Memory_store_i64(&mut self.memory, vec_addr + 8, 0);
                    return ExecOutcome::Value(Value::Void);
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Map Operations (simplified) ───
    if name == "p_map_new" {
        // Allocate a HashMap struct (simplified: 32 bytes)
        var map_addr: i64 = Memory_alloc(&mut self.memory, 32);
        Memory_store_i64(&mut self.memory, map_addr, 0);     // keys ptr
        Memory_store_i64(&mut self.memory, map_addr + 8, 0); // vals ptr
        Memory_store_i64(&mut self.memory, map_addr + 16, 0); // len
        Memory_store_i64(&mut self.memory, map_addr + 24, 0); // cap
        return ExecOutcome::Value(Value::Int(map_addr));
    }
    if name == "p_map_insert" {
        // p_map_insert(map_addr, key, value) — simplified linear scan
        // For now, just return void (full implementation would use
        // a side-table for key-value pairs)
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_map_get" || name == "p_map_get_or" {
        // Simplified: return 0 if not found
        if name == "p_map_get_or" && args.len() >= 3 {
            return ExecOutcome::Value(args.get(2));
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_map_contains" {
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_map_len" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_map_is_empty" {
        return ExecOutcome::Value(Value::Bool(true));
    }
    if name == "p_map_clear" {
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Volatile memory access: the interpreter's byte memory ───
    if str_starts_with(name, "p_volatile_") {
        var va: i64 = -1;
        match args.get(0) { Value::Int(vn) => { va = vn; } _ => {} }
        var vval: i64 = 0;
        var vval_ok: bool = false;
        if args.len() > 1 {
            match args.get(1) { Value::Int(vv) => { vval = vv; vval_ok = true; } _ => {} }
        }
        var width: i64 = 8;
        if str_ends_with(name, "8") { width = 1; }
        if str_ends_with(name, "16") { width = 2; }
        if str_ends_with(name, "32") { width = 4; }
        var is_load: bool = str_starts_with(name, "p_volatile_load");
        var in_range: bool = va >= 0 && Memory_is_valid_addr(&self.memory, va) && Memory_is_valid_addr(&self.memory, va + width - 1);
        if is_load {
            if in_range {
                if width == 1 { return ExecOutcome::Value(Value::Int(Memory_load_byte(&self.memory, va))); }
                if width == 8 { return ExecOutcome::Value(Value::Int(Memory_load_i64(&self.memory, va))); }
                return ExecOutcome::Value(Value::Int(Memory_load_i32(&self.memory, va)));
            }
            return ExecOutcome::Value(Value::Int(0));
        }
        if in_range && vval_ok {
            if width == 1 { Memory_store_byte(&mut self.memory, va, vval & 0xFF); }
            else if width == 8 { Memory_store_i64(&mut self.memory, va, vval); }
            else { Memory_store_i32(&mut self.memory, va, vval); }
        }
        return ExecOutcome::Value(Value::Void);
    }

    // ─── String builder (p_sb_*): handles index sb_strs (from 1) ───
    if name == "p_sb_new" {
        self.sb_strs.push("");
        return ExecOutcome::Value(Value::Int(self.sb_strs.len()));
    }
    if name == "p_sb_append" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(sbh) => {
                    if sbh >= 1 && sbh <= self.sb_strs.len() {
                        var piece: str = Interpreter_value_to_string(self, args.get(1));
                        self.sb_strs.set(sbh - 1, self.sb_strs.get(sbh - 1) + piece);
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Continue;
    }
    if name == "p_sb_to_str" || name == "p_sb_len" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(sbh2) => {
                    if sbh2 >= 1 && sbh2 <= self.sb_strs.len() {
                        if name == "p_sb_len" { return ExecOutcome::Value(Value::Int(str_len(self.sb_strs.get(sbh2 - 1)))); }
                        return ExecOutcome::Value(Value::Str(self.sb_strs.get(sbh2 - 1)));
                    }
                }
                _ => {}
            }
        }
        if name == "p_sb_len" { return ExecOutcome::Value(Value::Int(0)); }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_sb_free" {
        return ExecOutcome::Continue;
    }

    // ─── PRNG (xorshift128+) for DP noise ───
    if name == "p_prng_next" {
        // xorshift128+ — returns a u64 value as i64
        var a: u64 = self.prng_state_a;
        var b: u64 = self.prng_state_b;
        a = a ^ (a << 23);
        a = a ^ (a >> 17);
        a = a ^ b;
        a = a ^ (b >> 26);
        self.prng_state_a = b;
        self.prng_state_b = a;
        return ExecOutcome::Value(Value::Int(a as i64));
    }
    if name == "p_prng_uniform" {
        // Returns a uniform random f64 in [0, 1)
        var a: u64 = self.prng_state_a;
        var b: u64 = self.prng_state_b;
        a = a ^ (a << 23);
        a = a ^ (a >> 17);
        a = a ^ b;
        a = a ^ (b >> 26);
        self.prng_state_a = b;
        self.prng_state_b = a;
        // Use upper 53 bits for mantissa
        var bits: i64 = (a >> 11) as i64;
        var result: f64 = (bits as f64) / (9007199254740992.0);
        return ExecOutcome::Value(Value::Float(result));
    }
    if name == "p_prng_gaussian" {
        // Box-Muller transform: generates a standard normal random f64
        var a: u64 = self.prng_state_a;
        var b: u64 = self.prng_state_b;
        a = a ^ (a << 23);
        a = a ^ (a >> 17);
        a = a ^ b;
        a = a ^ (b >> 26);
        self.prng_state_a = b;
        self.prng_state_b = a;
        var bits1: i64 = (a >> 11) as i64;
        var u1: f64 = (bits1 as f64) / (9007199254740992.0);
        if u1 < 0.0000001 { u1 = 0.0000001; }

        a = self.prng_state_a;
        b = self.prng_state_b;
        a = a ^ (a << 23);
        a = a ^ (a >> 17);
        a = a ^ b;
        a = a ^ (b >> 26);
        self.prng_state_a = b;
        self.prng_state_b = a;
        var bits2: i64 = (a >> 11) as i64;
        var u2: f64 = (bits2 as f64) / (9007199254740992.0);

        // Box-Muller: sqrt(-2 * ln(u1)) * cos(2 * pi * u2)
        // We don't have ln/cos in the interpreter, so use a simple
        // approximation: sum of 12 uniforms (Central Limit Theorem)
        var sum: f64 = u1 + u2;
        var i: i64 = 0;
        while i < 10 {
            a = self.prng_state_a;
            b = self.prng_state_b;
            a = a ^ (a << 23);
            a = a ^ (a >> 17);
            a = a ^ b;
            a = a ^ (b >> 26);
            self.prng_state_a = b;
            self.prng_state_b = a;
            var bits3: i64 = (a >> 11) as i64;
            sum = sum + (bits3 as f64) / (9007199254740992.0);
            i = i + 1;
        }
        // Approximate Gaussian: (sum - 6) gives mean 0, variance ~1
        var gaussian: f64 = sum - 6.0;
        return ExecOutcome::Value(Value::Float(gaussian));
    }

    // ─── DP noise functions (use PRNG, not deterministic formulas) ───
    if name == "p_dp_noise" {
        // p_dp_noise(epsilon, sensitivity, value) -> noisy value
        if args.len() >= 3 {
            match args.get(0) {
                Value::Float(epsilon) => {
                    match args.get(1) {
                        Value::Float(sensitivity) => {
                            match args.get(2) {
                                Value::Float(v) => {
                                    // Generate Gaussian noise with sigma = sensitivity / epsilon
                                    var sigma: f64 = sensitivity / epsilon;
                                    // Use CLT approximation for Gaussian
                                    var sum: f64 = 0.0;
                                    var i: i64 = 0;
                                    while i < 12 {
                                        var a: u64 = self.prng_state_a;
                                        var b: u64 = self.prng_state_b;
                                        a = a ^ (a << 23);
                                        a = a ^ (a >> 17);
                                        a = a ^ b;
                                        a = a ^ (b >> 26);
                                        self.prng_state_a = b;
                                        self.prng_state_b = a;
                                        var bits: i64 = (a >> 11) as i64;
                                        sum = sum + (bits as f64) / (9007199254740992.0);
                                        i = i + 1;
                                    }
                                    var noise: f64 = (sum - 6.0) * sigma;
                                    return ExecOutcome::Value(Value::Float(v + noise));
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "p_gaussian_noise" {
        // p_gaussian_noise(sigma, value) -> noisy value
        if args.len() >= 2 {
            match args.get(0) {
                Value::Float(sigma) => {
                    match args.get(1) {
                        Value::Float(v) => {
                            var sum: f64 = 0.0;
                            var i: i64 = 0;
                            while i < 12 {
                                var a: u64 = self.prng_state_a;
                                var b: u64 = self.prng_state_b;
                                a = a ^ (a << 23);
                                a = a ^ (a >> 17);
                                a = a ^ b;
                                a = a ^ (b >> 26);
                                self.prng_state_a = b;
                                self.prng_state_b = a;
                                var bits: i64 = (a >> 11) as i64;
                                sum = sum + (bits as f64) / (9007199254740992.0);
                                i = i + 1;
                            }
                            var noise: f64 = (sum - 6.0) * sigma;
                            return ExecOutcome::Value(Value::Float(v + noise));
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "p_dropout" {
        // p_dropout(prob, value) -> value * 0 with probability prob, else value
        if args.len() >= 2 {
            match args.get(0) {
                Value::Float(prob) => {
                    match args.get(1) {
                        Value::Float(v) => {
                            var a: u64 = self.prng_state_a;
                            var b: u64 = self.prng_state_b;
                            a = a ^ (a << 23);
                            a = a ^ (a >> 17);
                            a = a ^ b;
                            a = a ^ (b >> 26);
                            self.prng_state_a = b;
                            self.prng_state_b = a;
                            var bits: i64 = (a >> 11) as i64;
                            var r: f64 = (bits as f64) / (9007199254740992.0);
                            if r < prob {
                                return ExecOutcome::Value(Value::Float(0.0));
                            }
                            return ExecOutcome::Value(Value::Float(v));
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "p_dp_budget_check" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Float(epsilon) => {
                    match args.get(1) {
                        Value::Float(limit) => {
                            self.dp_epsilon_budget = self.dp_epsilon_budget + epsilon;
                            if self.dp_epsilon_budget > limit {
                                return ExecOutcome::Panic("DP budget exhausted: consumed " + float_to_str(self.dp_epsilon_budget) + " > limit " + float_to_str(limit));
                            }
                            return ExecOutcome::Value(Value::Void);
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Panic("dp_budget_check: expected (f64, f64)");
    }
    if name == "p_dp_budget_reset" {
        self.dp_epsilon_budget = 0.0;
        if args.len() >= 1 {
            match args.get(0) {
                Value::Float(limit) => {
                    self.dp_epsilon_limit = limit;
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Green threads (cooperative scheduler) ───
    // p_gt_spawn(func_name: *u8, arg: i64) queues a READY thread.
    // p_gt_run_all() resolves each queued thread's func_name and executes it
    // eagerly (interpreter is single-threaded — cooperative ordering, eager
    // bodies). is_done/get_result reflect the scheduler's real state.
    if name == "p_gt_spawn" {
        if args.len() < 2 { return ExecOutcome::Value(Value::Int(-1)); }
        var func_name: str = "";
        match args.get(0) {
            Value::Str(s) => { func_name = s; }
            Value::Ptr(a) => { func_name = Memory_load_cstr(&self.memory, a); }
            _ => {}
        }
        var arg_val: i64 = 0;
        match args.get(1) { Value::Int(n) => { arg_val = n; } _ => {} }
        var gt_args: Vec<i64> = Vec::new();
        gt_args.push(arg_val);
        var id: i64 = GreenThreadScheduler_spawn(&mut self.gt_scheduler, func_name, gt_args);
        return ExecOutcome::Value(Value::Int(id));
    }
    if name == "p_gt_yield" {
        GreenThreadScheduler_yield_current(&mut self.gt_scheduler);
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_gt_run_all" {
        var last_result: i64 = 0;
        var gi: i64 = 0;
        while gi < self.gt_scheduler.next_id {
            var gt: GreenThread = self.gt_scheduler.threads.get(gi);
            if gt.active && (gt.state == GT_READY || gt.state == GT_SUSPENDED) {
                gt.state = GT_RUNNING;
                self.gt_scheduler.current = gi;
                self.gt_scheduler.threads.set(gi, gt);
                var gt_vals: Vec<Value> = Vec::new();
                gt_vals.push(Value::Int(0));   // dummy __env
                var gai: i64 = 0;
                while gai < gt.args.len() {
                    gt_vals.push(Value::Int(gt.args.get(gai)));
                    gai = gai + 1;
                }
                var gt_result: Value = Value::Int(0);
                match Interpreter_get_function(self, gt.func_name) {
                    OptIrFunction::Some(gfunc) => {
                        match Interpreter_run_function(self, gfunc, gt_vals) {
                            RunResult::Return(gv) => { gt_result = gv; }
                            RunResult::Panic(gmsg) => {
                                p_eprint_str("Green thread panic: " + gmsg + "\n");
                            }
                            RunResult::Paused => { }
                        }
                    }
                    OptIrFunction::None => {
                        p_eprint_str("Green thread: unknown function '" + gt.func_name + "'\n");
                    }
                }
                match gt_result {
                    Value::Int(gn) => { gt.result = gn; }
                    Value::Bool(gb) => { if gb { gt.result = 1; } }
                    Value::Ptr(gp) => { gt.result = gp; }
                    _ => { }
                }
                gt.state = GT_DONE;
                self.gt_scheduler.current = -1;
                self.gt_scheduler.threads.set(gi, gt);
                last_result = gt.result;
            }
            gi = gi + 1;
        }
        return ExecOutcome::Value(Value::Int(last_result));
    }
