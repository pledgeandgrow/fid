pub struct ChanState {
    pub buf: Vec<i64>,
    pub head: i64,
    pub cap: i64,
    pub closed: bool,
}

pub struct DbRow {
    pub db: i64,
    pub key: str,
    pub val: Value,
}

pub struct EcsComp {
    pub name: str,
    pub table: I64Table,
}

fn arg_int(args: Vec<Value>, i: i64, dflt: i64) -> i64 {
    if i < 0 || i >= args.len() { return dflt; }
    match args.get(i) {
        Value::Int(n) => { return n; }
        _ => {}
    }
    return dflt;
}

fn arg_int_or_ptr(args: Vec<Value>, i: i64) -> i64 {
    if i < 0 || i >= args.len() { return 0; }
    match args.get(i) {
        Value::Int(n) => { return n; }
        Value::Ptr(p) => { return p; }
        _ => {}
    }
    return 0;
}

fn arg_value(args: Vec<Value>, i: i64) -> Value {
    if i < 0 || i >= args.len() { return Value::Int(0); }
    return args.get(i);
}

fn arg_float_opt_ok(args: Vec<Value>, i: i64) -> bool {
    if i < 0 || i >= args.len() { return false; }
    match args.get(i) {
        Value::Float(_) => { return true; }
        _ => {}
    }
    return false;
}

fn arg_float(args: Vec<Value>, i: i64) -> f64 {
    if i < 0 || i >= args.len() { return 0.0; }
    match args.get(i) {
        Value::Float(f) => { return f; }
        _ => {}
    }
    return 0.0;
}

/// Rust's arg_string: Some(text) for a Str / Ptr / string-pointer Int.
pub fn Interpreter_arg_str_ok(self: &Interpreter, v: Value) -> bool {
    match Interpreter_arg_string(self, v) {
        OptStr::Some(_) => { return true; }
        OptStr::None => {}
    }
    return false;
}

pub fn Interpreter_arg_str(self: &Interpreter, v: Value) -> str {
    match Interpreter_arg_string(self, v) {
        OptStr::Some(s) => { return s; }
        OptStr::None => {}
    }
    return "";
}

fn json_type_name(j: Json) -> str {
    match j {
        Json::Null => { return "null"; }
        Json::Bool(_) => { return "boolean"; }
        Json::Num(_) => { return "number"; }
        Json::Str(_) => { return "string"; }
        Json::Arr(_) => { return "array"; }
        Json::Obj(_) => { return "object"; }
    }
    return "null";
}

/// JSON string-literal escaping (Rust's p_json_string / http esc).
pub fn json_escape_body(s: str) -> str {
    var out: str = "";
    var n: i64 = str_len(s);
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(s, i);
        if c == 34 { out = out + "\\\""; }
        else if c == 92 { out = out + "\\\\"; }
        else if c == 10 { out = out + "\\n"; }
        else if c == 13 { out = out + "\\r"; }
        else if c == 9 { out = out + "\\t"; }
        else if c < 32 {
            var hx: str = int_to_hex(c);
            while str_len(hx) < 4 { hx = "0" + hx; }
            out = out + "\\u" + hx;
        }
        else { out = out + p_char_to_str(c); }
        i = i + 1;
    }
    return out;
}

/// Index of `sub` in `s` at or after `from`, or -1.
fn str_find_from(s: str, sub: str, from: i64) -> i64 {
    var n: i64 = str_len(s);
    var m: i64 = str_len(sub);
    var i: i64 = from;
    while i + m <= n {
        var j: i64 = 0;
        var ok: bool = true;
        while j < m {
            if str_byte_at(s, i + j) != str_byte_at(sub, j) {
                ok = false;
                break;
            }
            j = j + 1;
        }
        if ok { return i; }
        i = i + 1;
    }
    return -1;
}

/// Run `func_name` eagerly with `targs` (a spawned thread / task); the
/// thread's return value. A panic in it ends the program (status 1).
pub fn Interpreter_run_eager(self: &mut Interpreter, func_name: str, targs: Vec<Value>, what: str) -> Value {
    var tv: Vec<Value> = Vec::new();
    tv.push(Value::Int(0));
    var i: i64 = 0;
    while i < targs.len() {
        tv.push(targs.get(i));
        i = i + 1;
    }
    match Interpreter_get_function(self, func_name) {
        OptIrFunction::Some(f) => {
            match Interpreter_run_function(self, f, tv) {
                RunResult::Return(v) => { return v; }
                RunResult::Panic(msg) => {
                    // A panic in a task or thread ends the whole program,
                    // as on every backend (reference.md 8.2: no task
                    // survives another's panic)
                    p_eprint_str("Panic: " + msg + "\n");
                    match Interpreter_take_panic_stack_trace(self) {
                        OptStr::Some(trace) => { p_eprint_str(trace); }
                        OptStr::None => {}
                    }
                    p_exit(1);
                    return Value::Int(0);
                }
                RunResult::Paused => { return Value::Int(0); }
            }
        }
        OptIrFunction::None => {
            p_eprint_str(what + ": unknown function '" + func_name + "'\n");
        }
    }
    return Value::Int(0);
}

pub fn Interpreter_ecs_comp(self: &mut Interpreter, name: str) -> i64 {
    var i: i64 = 0;
    while i < self.ecs_comps.len() {
        if self.ecs_comps.get(i).name == name { return i; }
        i = i + 1;
    }
    self.ecs_comps.push(EcsComp { name: name, table: I64Table_new() });
    return self.ecs_comps.len() - 1;
}

/// The (component name, entity) of an __ecs_* call: args (name, e) or
/// (env, name, e).
fn ecs_name_entity_ok(args: Vec<Value>) -> i64 {
    if args.len() >= 2 {
        match args.get(0) {
            Value::Str(_) => {
                match args.get(1) { Value::Int(_) => { return 0; } _ => {} }
            }
            _ => {}
        }
    }
    if args.len() >= 3 {
        match args.get(1) {
            Value::Str(_) => {
                match args.get(2) { Value::Int(_) => { return 1; } _ => {} }
            }
            _ => {}
        }
    }
    return -1;
}

fn arg_str_raw(args: Vec<Value>, i: i64) -> str {
    match args.get(i) {
        Value::Str(s) => { return s; }
        _ => {}
    }
    return "";
}

pub fn Interpreter_call_runtime2(self: &mut Interpreter, name: str, args: &mut Vec<Value>) -> ExecOutcome {
    // ─── Futures / threads / executors (eager, as src/interp.rs) ───
    if name == "p_future_ready" {
        var fidx: i64 = self.future_values.len();
        self.future_values.push(arg_value(args, 0));
        self.future_exec.push(-1);
        return ExecOutcome::Value(Value::Int(fidx));
    }
    if name == "p_future_poll" || name == "p_task_poll" || name == "p_task_poll_nonblocking" || name == "p_executor_block_on" {
        var ai: i64 = 0;
        if name == "p_executor_block_on" { ai = 1; }
        var idx: i64 = -1;
        var ok: bool = false;
        if ai < args.len() {
            match args.get(ai) {
                Value::Int(n) => { idx = n; ok = true; }
                _ => {}
            }
        }
        if !ok { return ExecOutcome::Panic("Future poll: not a Future value"); }
        if idx < 0 || idx >= self.future_values.len() {
            return ExecOutcome::Panic("Future poll: invalid handle " + int_to_str(idx));
        }
        return ExecOutcome::Value(self.future_values.get(idx));
    }
    if name == "p_thread_spawn" || name == "p_executor_spawn" {
        var base: i64 = 0;
        var exec_idx: i64 = -1;
        if name == "p_executor_spawn" {
            base = 1;
            exec_idx = arg_int(args, 0, 0);
        }
        var func_name: str = Interpreter_value_to_string(self, arg_value(args, base));
        var num_args: i64 = arg_int(args, base + 1, 0);
        var targs: Vec<Value> = Vec::new();
        var tai: i64 = base + 2;
        while tai < args.len() && tai < base + 2 + num_args {
            targs.push(args.get(tai));
            tai = tai + 1;
        }
        var what: str = "Thread";
        if name == "p_executor_spawn" { what = "Executor"; }
        var res: Value = Interpreter_run_eager(self, func_name, targs, what);
        var fidx2: i64 = self.future_values.len();
        self.future_values.push(res);
        if exec_idx >= 0 && exec_idx < self.executor_count {
            self.future_exec.push(exec_idx);
        } else {
            self.future_exec.push(-1);
        }
        return ExecOutcome::Value(Value::Int(fidx2));
    }
    if name == "p_thread_join" {
        return ExecOutcome::Value(Value::Void);
    }
    // The interpreter has one call stack: a task runs to its end when started,
    // and yielding does nothing.
    if name == "p_co_go" {
        var co_args: Vec<Value> = Vec::new();
        co_args.push(Value::Int(0));
        co_args.push(arg_value(args, 0));
        co_args.push(Value::Int(1));
        co_args.push(arg_value(args, 1));
        match Interpreter_call_runtime(self, "p_executor_spawn", &mut co_args) {
            ExecOutcome::Value(cv) => {
                match cv {
                    Value::Int(cf) => { return ExecOutcome::Value(Value::Int(cf + 1)); }
                    _ => { return ExecOutcome::Value(cv); }
                }
            }
            other => { return other; }
        }
    }
    if name == "p_co_async" { return Interpreter_call_runtime(self, "p_thread_spawn", args); }
    if name == "p_co_sleep" { return ExecOutcome::Value(Value::Int(0)); }
    if name == "p_co_wait_fd" { return ExecOutcome::Value(Value::Int(1)); }
    if name == "p_co_detach" { return ExecOutcome::Value(Value::Void); }
    if name == "p_co_yield" { return ExecOutcome::Value(Value::Void); }
    if name == "p_co_run" { return ExecOutcome::Value(Value::Int(self.future_values.len())); }
    if name == "p_co_done" { return ExecOutcome::Value(Value::Int(1)); }
    if name == "p_co_result" {
        var co_get: Vec<Value> = Vec::new();
        co_get.push(Value::Int(arg_int(args, 0, 1) - 1));
        return Interpreter_call_runtime(self, "p_future_poll", &mut co_get);
    }
    if name == "p_executor_new" {
        var eidx: i64 = self.executor_count;
        self.executor_count = self.executor_count + 1;
        return ExecOutcome::Value(Value::Int(eidx));
    }
    if name == "p_task_is_ready" {
        var tidx: i64 = -1;
        match arg_value(args, 0) {
            Value::Int(n) => { tidx = n; }
            _ => { return ExecOutcome::Value(Value::Bool(false)); }
        }
        return ExecOutcome::Value(Value::Bool(tidx >= 0 && tidx < self.future_values.len()));
    }
    if name == "p_executor_run_all" {
        var ex: i64 = arg_int(args, 0, 0);
        if ex < 0 || ex >= self.executor_count { return ExecOutcome::Value(Value::Int(0)); }
        var cnt: i64 = 0;
        var fi: i64 = 0;
        while fi < self.future_exec.len() {
            if self.future_exec.get(fi) == ex { cnt = cnt + 1; }
            fi = fi + 1;
        }
        return ExecOutcome::Value(Value::Int(cnt));
    }
    if name == "p_executor_cancel" || name == "p_executor_poll_all" {
        // Every task ran eagerly: nothing pending, nothing to cancel
        return ExecOutcome::Value(Value::Int(0));
    }
    // ─── Simulated async IO: the futures resolve to the thread's result ───
    if name == "p_net_connect" {
        var cfi: i64 = self.future_values.len();
        self.future_values.push(Value::Int(arg_int(args, 1, 0) + 0x10000));
        self.future_exec.push(-1);
        return ExecOutcome::Value(Value::Int(cfi));
    }
    if name == "p_net_read" {
        var rlen: i64 = arg_int(args, 2, 0);
        if rlen > 13 { rlen = 13; }
        var rfi: i64 = self.future_values.len();
        self.future_values.push(Value::Int(rlen));
        self.future_exec.push(-1);
        return ExecOutcome::Value(Value::Int(rfi));
    }
    if name == "p_net_write" {
        var wfi: i64 = self.future_values.len();
        self.future_values.push(Value::Int(arg_int(args, 2, 0)));
        self.future_exec.push(-1);
        return ExecOutcome::Value(Value::Int(wfi));
    }
    if name == "p_fs_read_async" {
        var fpath: str = Interpreter_value_to_string(self, arg_value(args, 0));
        var flen: i64 = arg_int(args, 2, 1024);
        var fsz: i64 = 0;
        if p_file_exists(fpath) != 0 { fsz = p_file_size(fpath); }
        if fsz < 0 { fsz = 0; }
        if fsz > flen { fsz = flen; }
        var ffi: i64 = self.future_values.len();
        self.future_values.push(Value::Int(fsz));
        self.future_exec.push(-1);
        return ExecOutcome::Value(Value::Int(ffi));
    }
    if name == "p_net_close" { return ExecOutcome::Continue; }

    // ─── Shared memory, atomics, Rc, mutexes, TLS ───
    if name == "p_shared_alloc" {
        var saddr: i64 = self.next_shared_addr;
        self.next_shared_addr = self.next_shared_addr + 8;
        I64Table_set(&mut self.shared_mem, saddr, Value::Int(0));
        I64Table_set(&mut self.memory.blocks, saddr, Value::Int(1));
        return ExecOutcome::Value(Value::Int(saddr));
    }
    if name == "p_atomic_load" {
        return ExecOutcome::Value(Value::Int(Interpreter_shared_get(self, arg_int(args, 0, 0))));
    }
    if name == "p_atomic_store" {
        I64Table_set(&mut self.shared_mem, arg_int(args, 0, 0), Value::Int(arg_int(args, 1, 0)));
        return ExecOutcome::Continue;
    }
    if name == "p_atomic_cas" {
        var caddr: i64 = arg_int(args, 0, 0);
        var cur: i64 = Interpreter_shared_get(self, caddr);
        if cur == arg_int(args, 1, 0) {
            I64Table_set(&mut self.shared_mem, caddr, Value::Int(arg_int(args, 2, 0)));
            return ExecOutcome::Value(Value::Bool(true));
        }
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_atomic_add" || name == "p_atomic_sub" {
        var aaddr: i64 = arg_int(args, 0, 0);
        var old: i64 = Interpreter_shared_get(self, aaddr);
        var delta: i64 = arg_int(args, 1, 0);
        if name == "p_atomic_add" {
            I64Table_set(&mut self.shared_mem, aaddr, Value::Int(old + delta));
        } else {
            I64Table_set(&mut self.shared_mem, aaddr, Value::Int(old - delta));
        }
        return ExecOutcome::Value(Value::Int(old));
    }
    if name == "p_rc_incr" {
        var rca: i64 = arg_int_or_ptr(args, 0);
        var rcv: i64 = arg_int_or_ptr(args, 1);
        Memory_store_i64(&mut self.memory, rca, Memory_load_i64(&self.memory, rca) + 1);
        return ExecOutcome::Value(Value::Int(rcv));
    }
    if name == "p_rc_decr" {
        var rcd: i64 = arg_int_or_ptr(args, 0);
        Memory_store_i64(&mut self.memory, rcd, Memory_load_i64(&self.memory, rcd) - 1);
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_mutex_init" {
        var mh: i64 = self.next_mutex_handle;
        self.next_mutex_handle = self.next_mutex_handle + 1;
        I64Table_set(&mut self.shared_mem, mh, Value::Int(0));
        return ExecOutcome::Value(Value::Int(mh));
    }
    if name == "p_mutex_lock" {
        I64Table_set(&mut self.shared_mem, arg_int(args, 0, 0), Value::Int(1));
        return ExecOutcome::Continue;
    }
    if name == "p_mutex_unlock" {
        I64Table_set(&mut self.shared_mem, arg_int(args, 0, 0), Value::Int(0));
        return ExecOutcome::Continue;
    }
    if name == "p_tls_create" {
        var tk: i64 = self.next_tls_key;
        self.next_tls_key = self.next_tls_key + 1;
        return ExecOutcome::Value(Value::Int(tk));
    }
    if name == "p_tls_get" {
        match I64Table_get(&self.tls, arg_int(args, 0, 0)) {
            OptValue::Some(tv) => { return ExecOutcome::Value(tv); }
            OptValue::None => {}
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_tls_set" {
        I64Table_set(&mut self.tls, arg_int(args, 0, 0), Value::Int(arg_int(args, 1, 0)));
        return ExecOutcome::Continue;
    }

    // ─── Channels (bounded queue; single-threaded) ───
    if name == "p_chan_create" {
        var ccap: i64 = arg_int(args, 0, 1);
        if ccap < 1 { ccap = 1; }
        self.chans.push(ChanState { buf: Vec::new(), head: 0, cap: ccap, closed: false });
        return ExecOutcome::Value(Value::Int(self.chans.len()));
    }
    if name == "p_chan_send" || name == "p_chan_recv" || name == "p_chan_try_recv" || name == "p_chan_close" || name == "p_chan_is_closed" {
        var ch: i64 = arg_int(args, 0, 0);
        var pending: i64 = 0 - 9223372036854775807;
        if ch < 1 || ch > self.chans.len() {
            if name == "p_chan_send" { return ExecOutcome::Value(Value::Bool(false)); }
            if name == "p_chan_close" { return ExecOutcome::Continue; }
            if name == "p_chan_is_closed" { return ExecOutcome::Value(Value::Bool(true)); }
            return ExecOutcome::Value(Value::Int(pending));
        }
        var cs: ChanState = self.chans.get(ch - 1);
        if name == "p_chan_send" {
            if cs.closed { return ExecOutcome::Value(Value::Bool(false)); }
            cs.buf.push(arg_int(args, 1, 0));
            self.chans.set(ch - 1, cs);
            return ExecOutcome::Value(Value::Bool(true));
        }
        if name == "p_chan_close" {
            cs.closed = true;
            self.chans.set(ch - 1, cs);
            return ExecOutcome::Continue;
        }
        if name == "p_chan_is_closed" {
            return ExecOutcome::Value(Value::Bool(cs.closed));
        }
        if cs.head < cs.buf.len() {
            var cv: i64 = cs.buf.get(cs.head);
            cs.head = cs.head + 1;
            self.chans.set(ch - 1, cs);
            return ExecOutcome::Value(Value::Int(cv));
        }
        if name == "p_chan_try_recv" && cs.closed { return ExecOutcome::Value(Value::Int(0)); }
        return ExecOutcome::Value(Value::Int(pending));
    }

    // ─── C library stubs ───
    if name == "abs" || name == "labs" {
        var av: i64 = arg_int(args, 0, 0);
        if av < 0 { av = 0 - av; }
        return ExecOutcome::Value(Value::Int(av));
    }
    if name == "sqrt" || name == "c_sqrt" || name == "pledge_sqrt" {
        match arg_value(args, 0) {
            Value::Float(sf) => { return ExecOutcome::Value(Value::Float(math_sqrt(sf))); }
            Value::Int(si) => { return ExecOutcome::Value(Value::Float(math_sqrt(si as f64))); }
            _ => {}
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "pow" || name == "c_pow" || name == "pledge_pow" {
        if arg_float_opt_ok(args, 0) && arg_float_opt_ok(args, 1) {
            return ExecOutcome::Value(Value::Float(math_pow(arg_float(args, 0), arg_float(args, 1))));
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "floor" || name == "c_floor" || name == "pledge_floor" || name == "ceil" || name == "c_ceil" || name == "pledge_ceil" || name == "sin" || name == "c_sin" || name == "pledge_sin" || name == "cos" || name == "c_cos" || name == "pledge_cos" || name == "fabs" || name == "c_fabs" || name == "pledge_fabs" {
        if !arg_float_opt_ok(args, 0) { return ExecOutcome::Value(Value::Float(0.0)); }
        var x: f64 = arg_float(args, 0);
        if str_ends_with(name, "floor") { return ExecOutcome::Value(Value::Float(math_floor(x))); }
        if str_ends_with(name, "ceil") { return ExecOutcome::Value(Value::Float(math_ceil(x))); }
        if str_ends_with(name, "sin") { return ExecOutcome::Value(Value::Float(math_sin(x))); }
        if str_ends_with(name, "cos") { return ExecOutcome::Value(Value::Float(math_cos(x))); }
        return ExecOutcome::Value(Value::Float(math_fabs(x)));
    }
    if name == "strcmp" || name == "c_strcmp" {
        match arg_value(args, 0) {
            Value::Str(sa) => {
                match arg_value(args, 1) {
                    Value::Str(sb) => {
                        if sa == sb { return ExecOutcome::Value(Value::Int(0)); }
                        if str_lt(sa, sb) { return ExecOutcome::Value(Value::Int(-1)); }
                        return ExecOutcome::Value(Value::Int(1));
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "strlen" || name == "c_strlen" || name == "pledge_strlen" {
        match arg_value(args, 0) {
            Value::Str(ls) => { return ExecOutcome::Value(Value::Int(str_len(ls))); }
            _ => {}
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "printf" {
        match arg_value(args, 0) {
            Value::Str(ps) => { p_print_str(ps); }
            _ => {}
        }
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── Dynamic loading (simulated) ───
    if name == "p_dl_open" {
        var dpath: str = Interpreter_value_to_string(self, arg_value(args, 0));
        if str_len(dpath) == 0 { return ExecOutcome::Value(Value::Int(0)); }
        var dh: i64 = self.next_dl_handle;
        self.next_dl_handle = self.next_dl_handle + 1;
        I64Table_set(&mut self.dl_handles, dh, Value::Str(dpath));
        return ExecOutcome::Value(Value::Int(dh));
    }
    if name == "p_dl_sym" {
        var dsh: i64 = arg_int(args, 0, 0);
        var sym: str = Interpreter_value_to_string(self, arg_value(args, 1));
        if dsh == 0 || I64Table_find(&self.dl_handles, dsh) < 0 || str_len(sym) == 0 {
            return ExecOutcome::Value(Value::Int(0));
        }
        return ExecOutcome::Value(Value::Int(0x1000 + dsh * 0x100));
    }
    if name == "p_dl_close" {
        I64Table_remove(&mut self.dl_handles, arg_int(args, 0, 0));
        return ExecOutcome::Continue;
    }
    if name == "p_dl_call" {
        return ExecOutcome::Value(Value::Int(arg_int(args, 1, 0)));
    }

    // ─── ECS ───
    if name == "__ecs_create_entity" {
        self.ecs_entity_count = self.ecs_entity_count + 1;
        return ExecOutcome::Value(Value::Int(self.ecs_entity_count - 1));
    }
    if name == "__ecs_entity_count" {
        return ExecOutcome::Value(Value::Int(self.ecs_entity_count));
    }
    if name == "__ecs_has" || name == "__ecs_get" || name == "__ecs_remove" {
        var off: i64 = ecs_name_entity_ok(args);
        if off < 0 {
            if name == "__ecs_remove" { return ExecOutcome::Continue; }
            return ExecOutcome::Value(Value::Int(0));
        }
        var cname: str = arg_str_raw(args, off);
        var ent: i64 = arg_int(args, off + 1, 0);
        var ci: i64 = Interpreter_ecs_comp(self, cname);
        var comp: EcsComp = self.ecs_comps.get(ci);
        if name == "__ecs_remove" {
            I64Table_remove(&mut comp.table, ent);
            self.ecs_comps.set(ci, comp);
            return ExecOutcome::Continue;
        }
        match I64Table_get(&comp.table, ent) {
            OptValue::Some(ev) => {
                if name == "__ecs_has" { return ExecOutcome::Value(Value::Int(1)); }
                return ExecOutcome::Value(ev);
            }
            OptValue::None => {}
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "__ecs_add" {
        var have_name: bool = false;
        var have_ent: bool = false;
        var have_val: bool = false;
        var an: str = "";
        var ae: i64 = 0;
        var avv: Value = Value::Int(0);
        var ei: i64 = 0;
        while ei < args.len() {
            match args.get(ei) {
                Value::Str(es) => { if !have_name { an = es; have_name = true; } }
                Value::Int(en) => { if !have_ent && ei > 0 { ae = en; have_ent = true; } }
                Value::Ptr(_) => { if !have_val { avv = args.get(ei); have_val = true; } }
                _ => {}
            }
            ei = ei + 1;
        }
        if have_name && have_ent {
            var ci2: i64 = Interpreter_ecs_comp(self, an);
            var comp2: EcsComp = self.ecs_comps.get(ci2);
            I64Table_set(&mut comp2.table, ae, avv);
            self.ecs_comps.set(ci2, comp2);
        }
        return ExecOutcome::Continue;
    }

    // ─── FFI stubs (audio, input) ───
    if name == "pledge_putchar" {
        match arg_value(args, 0) {
            Value::Int(pc) => { p_print_str(p_char_to_str(pc & 0xFF)); }
            _ => {}
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "pledge_printf" {
        match arg_value(args, 0) {
            Value::Ptr(pa) => { p_print_str(Memory_load_cstr(&self.memory, pa)); }
            _ => {}
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "pledge_fgets" { return ExecOutcome::Value(Value::Ptr(0)); }
    if name == "pledge_getchar" || name == "pledge_fputs" || name == "pledge_fflush" || name == "pledge_audio_init" || name == "pledge_audio_load" || name == "pledge_audio_play" || name == "pledge_audio_is_playing" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "pledge_audio_shutdown" || name == "pledge_audio_stop" || name == "pledge_audio_pause" || name == "pledge_audio_resume" || name == "pledge_audio_stop_all" || name == "pledge_audio_set_volume" || name == "pledge_audio_set_loop" || name == "pledge_audio_set_pan" || name == "pledge_audio_master_volume" {
        return ExecOutcome::Continue;
    }

    // ─── JSON (over JSON text strings) ───
    if str_starts_with(name, "p_json_") {
        if args.len() == 0 { return ExecOutcome::Panic(str_slice(name, 2, str_len(name)) + ": missing argument"); }
        var short: str = str_slice(name, 2, str_len(name));
        if !Interpreter_arg_str_ok(self, args.get(0)) { return ExecOutcome::Panic(short + ": expected string"); }
        var text: str = Interpreter_arg_str(self, args.get(0));
        if name == "p_json_string" {
            return ExecOutcome::Value(Value::Str("\"" + json_escape_body(text) + "\""));
        }
        var jr: JsonResult = json_parse(text);
        var jv: Json = Json::Null;
        match jr {
            JsonResult::Ok(pj) => { jv = pj; }
            JsonResult::Err(e) => {
                if name == "p_json_get" { return ExecOutcome::Panic("json_get: not an object"); }
                if name == "p_json_len" { return ExecOutcome::Panic("json_len: not array or object"); }
                if name == "p_json_at" { return ExecOutcome::Panic("json_at: not an array"); }
                return ExecOutcome::Panic(short + ": " + e);
            }
        }
        if name == "p_json_parse" || name == "p_json_dump" {
            return ExecOutcome::Value(Value::Str(json_dump(jv, false)));
        }
        if name == "p_json_pretty" {
            return ExecOutcome::Value(Value::Str(json_dump(jv, true)));
        }
        if name == "p_json_type" {
            return ExecOutcome::Value(Value::Str(json_type_name(jv)));
        }
        if name == "p_json_get" {
            if args.len() < 2 { return ExecOutcome::Panic("json_get: missing args"); }
            if !Interpreter_arg_str_ok(self, args.get(1)) { return ExecOutcome::Panic("json_get: key must be string"); }
            var key: str = Interpreter_arg_str(self, args.get(1));
            match jv {
                Json::Obj(o) => {
                    if o.contains(key) { return ExecOutcome::Value(Value::Str(json_dump(o.get(key), false))); }
                    return ExecOutcome::Value(Value::Str("null"));
                }
                _ => {}
            }
            return ExecOutcome::Panic("json_get: not an object");
        }
        if name == "p_json_len" {
            match jv {
                Json::Arr(ja) => { return ExecOutcome::Value(Value::Int(ja.len())); }
                Json::Obj(jo) => { return ExecOutcome::Value(Value::Int(jo.len())); }
                _ => {}
            }
            return ExecOutcome::Panic("json_len: not array or object");
        }
        if name == "p_json_at" {
            var jidx: i64 = 0;
            var jidx_ok: bool = false;
            if args.len() >= 2 {
                match args.get(1) { Value::Int(n) => { jidx = n; jidx_ok = true; } _ => {} }
            }
            if !jidx_ok { return ExecOutcome::Panic("json_at: missing args"); }
            match jv {
                Json::Arr(ja2) => {
                    if jidx >= 0 && jidx < ja2.len() { return ExecOutcome::Value(Value::Str(json_dump(ja2.get(jidx), false))); }
                    return ExecOutcome::Panic("json_at: index " + int_to_str(jidx) + " out of bounds");
                }
                _ => {}
            }
            return ExecOutcome::Panic("json_at: not an array");
        }
    }

    // ─── Distributed tensors (single device) ───
    if name == "p_all_reduce" || name == "p_broadcast" || name == "p_all_gather" || name == "p_scatter" {
        var th: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if th < 0 { return ExecOutcome::Panic(str_slice(name, 2, str_len(name)) + ": expected Tensor"); }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_clone_data(&self.tensors.get(th))));
    }
    if name == "p_send_tensor" { return ExecOutcome::Continue; }
    if name == "p_recv_tensor" {
        match Interpreter_arg_to_vec_i64(self, arg_value(args, 0)) {
            OptVecI64::Some(rs) => { return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_zeros(rs))); }
            OptVecI64::None => {}
        }
        return ExecOutcome::Panic("recv_tensor: expected Vec");
    }
    if name == "p_tp_rank" { return ExecOutcome::Value(Value::Int(0)); }
    if name == "p_tp_world_size" { return ExecOutcome::Value(Value::Int(1)); }
    if name == "p_checkpoint_begin" || name == "p_checkpoint_end" { return ExecOutcome::Continue; }

    // ─── SIMD (Vec<f64> values) ───
    if name == "p_simd_add" || name == "p_simd_sub" || name == "p_simd_mul" || name == "p_simd_div" || name == "p_simd_dot" {
        var sa_opt: OptVecF64 = Interpreter_args_to_f64_vec(self, args, 0);
        var sb_opt: OptVecF64 = Interpreter_args_to_f64_vec(self, args, 1);
        match sa_opt {
            OptVecF64::Some(va) => {
                match sb_opt {
                    OptVecF64::Some(vb) => {
                        var n: i64 = va.len();
                        if vb.len() < n { n = vb.len(); }
                        var outv: Vec<f64> = Vec::new();
                        var dot: f64 = 0.0;
                        var k: i64 = 0;
                        while k < n {
                            var x: f64 = va.get(k);
                            var y: f64 = vb.get(k);
                            if name == "p_simd_add" { outv.push(x + y); }
                            if name == "p_simd_sub" { outv.push(x - y); }
                            if name == "p_simd_mul" { outv.push(x * y); }
                            if name == "p_simd_div" {
                                if y != 0.0 { outv.push(x / y); } else { outv.push(0.0); }
                            }
                            if name == "p_simd_dot" { dot = dot + x * y; }
                            k = k + 1;
                        }
                        if name == "p_simd_dot" { return ExecOutcome::Value(Value::Float(dot)); }
                        return ExecOutcome::Value(Interpreter_new_float_vec(self, outv));
                    }
                    OptVecF64::None => {}
                }
            }
            OptVecF64::None => {}
        }
        return ExecOutcome::Panic(str_slice(name, 2, str_len(name)) + ": expected Vec, Vec");
    }
    if name == "p_simd_sum" || name == "p_simd_from_vec" || name == "p_simd_scale" {
        match Interpreter_args_to_f64_vec(self, args, 0) {
            OptVecF64::Some(sv) => {
                if name == "p_simd_sum" {
                    var ssum: f64 = 0.0;
                    var si: i64 = 0;
                    while si < sv.len() { ssum = ssum + sv.get(si); si = si + 1; }
                    return ExecOutcome::Value(Value::Float(ssum));
                }
                if name == "p_simd_from_vec" { return ExecOutcome::Value(Interpreter_new_float_vec(self, sv)); }
                if arg_float_opt_ok(args, 1) {
                    var scl: f64 = arg_float(args, 1);
                    var scaled: Vec<f64> = Vec::new();
                    var sj: i64 = 0;
                    while sj < sv.len() { scaled.push(sv.get(sj) * scl); sj = sj + 1; }
                    return ExecOutcome::Value(Interpreter_new_float_vec(self, scaled));
                }
                return ExecOutcome::Panic("simd_scale: expected Vec, f64");
            }
            OptVecF64::None => {}
        }
        if name == "p_simd_sum" { return ExecOutcome::Panic("simd_sum: expected Vec"); }
        if name == "p_simd_from_vec" { return ExecOutcome::Panic("simd_from_vec: expected Vec"); }
        return ExecOutcome::Panic("simd_scale: expected Vec, f64");
    }
    if name == "p_simd_to_str" {
        match arg_value(args, 0) {
            Value::Vec(svh) => {
                var fl: Vec<f64> = Interpreter_vec_handle_f64s(self, svh, false);
                var st: str = "[";
                var sk: i64 = 0;
                while sk < fl.len() {
                    if sk > 0 { st = st + ", "; }
                    st = st + float_to_str(fl.get(sk));
                    sk = sk + 1;
                }
                return ExecOutcome::Value(Value::Str(st + "]"));
            }
            _ => {}
        }
        return ExecOutcome::Panic("simd_to_str: expected Vec");
    }

    // ─── Sockets / HTTP (simulated) ───
    if name == "p_socket_listen" { return ExecOutcome::Value(Value::Int(1)); }
    if name == "p_socket_accept" { return ExecOutcome::Value(Value::Int(2)); }
    if name == "p_socket_read" { return ExecOutcome::Value(Interpreter_new_vec_value(self, Vec::new())); }
    if name == "p_socket_write" {
        match arg_value(args, 1) {
            Value::Vec(wh) => {
                if wh >= 0 && wh < self.vec_values.len() { return ExecOutcome::Value(Value::Int(self.vec_values.get(wh).elements.len())); }
            }
            _ => {}
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_socket_close" { return ExecOutcome::Continue; }
    if name == "p_socket_recv_str" { return ExecOutcome::Value(Value::Str("")); }
    if name == "p_http_parse_request" {
        if args.len() == 0 || !Interpreter_arg_str_ok(self, args.get(0)) {
            return ExecOutcome::Panic("http_parse_request: expected string");
        }
        var raw: str = Interpreter_arg_str(self, args.get(0));
        var rlen2: i64 = str_len(raw);
        var le: i64 = str_find_from(raw, "\r\n", 0);
        var req_line: str = raw;
        var pos: i64 = rlen2;
        if le >= 0 {
            req_line = str_slice(raw, 0, le);
            pos = le + 2;
        }
        // METHOD PATH VERSION (splitn(3, ' '))
        var method: str = "GET";
        var path: str = "/";
        var version_full: str = "HTTP/1.1";
        var sp1: i64 = str_find_from(req_line, " ", 0);
        if sp1 < 0 {
            method = req_line;
        } else {
            method = str_slice(req_line, 0, sp1);
            var sp2: i64 = str_find_from(req_line, " ", sp1 + 1);
            if sp2 < 0 {
                path = str_slice(req_line, sp1 + 1, str_len(req_line));
            } else {
                path = str_slice(req_line, sp1 + 1, sp2);
                version_full = str_slice(req_line, sp2 + 1, str_len(req_line));
            }
        }
        var version: str = version_full;
        if str_starts_with(version_full, "HTTP/") { version = str_slice(version_full, 5, str_len(version_full)); }
        else { version = "1.1"; }
        var headers: str = "{";
        var first_hdr: bool = true;
        var saw_blank: bool = false;
        while pos <= rlen2 && le >= 0 {
            var nle: i64 = str_find_from(raw, "\r\n", pos);
            var line: str = "";
            if nle < 0 { line = str_slice(raw, pos, rlen2); } else { line = str_slice(raw, pos, nle); }
            if str_len(line) == 0 {
                saw_blank = true;
                break;
            }
            var colon: i64 = str_find_from(line, ":", 0);
            if colon >= 0 {
                if !first_hdr { headers = headers + ","; }
                first_hdr = false;
                headers = headers + "\"" + str_trim(str_slice(line, 0, colon)) + "\":\"" + str_trim(str_slice(line, colon + 1, str_len(line))) + "\"";
            }
            if nle < 0 { break; }
            pos = nle + 2;
        }
        headers = headers + "}";
        var body: str = "";
        if saw_blank {
            var bb: i64 = str_find_from(raw, "\r\n\r\n", 0);
            if bb >= 0 {
                var bstart: i64 = bb + 4;
                var bend: i64 = str_find_from(raw, "\r\n\r\n", bstart);
                if bend < 0 { bend = rlen2; }
                body = str_slice(raw, bstart, bend);
            }
        }
        var js: str = "{\"method\":\"" + json_escape_body(method) + "\",\"path\":\"" + json_escape_body(path) + "\",\"version\":\"" + json_escape_body(version) + "\",\"headers\":" + headers + ",\"body\":\"" + json_escape_body(body) + "\"}";
        return ExecOutcome::Value(Value::Str(js));
    }
    if name == "p_http_build_response" {
        var status_ok: bool = false;
        var status: i64 = 0;
        if args.len() >= 3 {
            match args.get(0) { Value::Int(st2) => { status = st2; status_ok = true; } _ => {} }
        }
        if status_ok {
            var body2: str = Interpreter_arg_str(self, args.get(2));
            return ExecOutcome::Value(Value::Str("HTTP/1.1 " + int_to_str(status) + " OK\r\nContent-Length: " + int_to_str(str_len(body2)) + "\r\n\r\n" + body2));
        }
        return ExecOutcome::Value(Value::Str("HTTP/1.1 500 Internal Server Error\r\n\r\n"));
    }

    // ─── In-memory KV database ───
    if name == "p_db_mem_open" {
        var dbh: i64 = self.next_db_handle;
        self.next_db_handle = self.next_db_handle + 1;
        return ExecOutcome::Value(Value::Int(dbh));
    }
    if name == "p_db_mem_close" {
        var cdb: i64 = arg_int(args, 0, -1);
        var ri: i64 = 0;
        while ri < self.db_rows.len() {
            var row: DbRow = self.db_rows.get(ri);
            if row.db == cdb {
                row.db = -1;
                self.db_rows.set(ri, row);
            }
            ri = ri + 1;
        }
        self.closed_dbs.push(cdb);
        return ExecOutcome::Continue;
    }
    if name == "p_db_mem_query" {
        var qdb: i64 = -1;
        match arg_value(args, 0) { Value::Int(qh) => { qdb = qh; } _ => {} }
        if qdb >= 1 && qdb < self.next_db_handle && !vec_i64_contains(self.closed_dbs, qdb) {
            var qtext: str = "";
            if args.len() > 1 { qtext = Interpreter_value_to_string(self, args.get(1)); }
            var at: i64 = str_find(qtext, "key=");
            if at >= 0 {
                var k: str = str_slice(qtext, at + 4, str_len(qtext));
                while str_len(k) > 0 && (str_byte_at(k, 0) == 39 || str_byte_at(k, 0) == 34) { k = str_slice(k, 1, str_len(k)); }
                var kend: i64 = 0;
                while kend < str_len(k) {
                    var kc: i64 = str_byte_at(k, kend);
                    if kc == 32 || kc == 59 || kc == 39 || kc == 34 { break; }
                    kend = kend + 1;
                }
                k = str_slice(k, 0, kend);
                var qi: i64 = 0;
                while qi < self.db_rows.len() {
                    var qrow: DbRow = self.db_rows.get(qi);
                    if qrow.db == qdb && qrow.key == k {
                        return ExecOutcome::Value(Value::Str(Interpreter_value_to_string(self, qrow.val)));
                    }
                    qi = qi + 1;
                }
                return ExecOutcome::Value(Value::Str(""));
            }
            var arr: str = "[";
            var first: bool = true;
            var qj: i64 = 0;
            while qj < self.db_rows.len() {
                var krow: DbRow = self.db_rows.get(qj);
                if krow.db == qdb {
                    if !first { arr = arr + ","; }
                    first = false;
                    arr = arr + json_escape_string(krow.key);
                }
                qj = qj + 1;
            }
            return ExecOutcome::Value(Value::Str(arr + "]"));
        }
        return ExecOutcome::Value(Value::Str("[]"));
    }
    if name == "p_db_mem_exec" {
        var edb: i64 = -1;
        match arg_value(args, 0) { Value::Int(eh) => { edb = eh; } _ => {} }
        if edb >= 0 && args.len() >= 2 {
            var q: str = Interpreter_value_to_string(self, args.get(1));
            var s1: i64 = str_find_from(q, " ", 0);
            if s1 >= 0 {
                var s2: i64 = str_find_from(q, " ", s1 + 1);
                if s2 >= 0 {
                    var verb: str = str_to_lower(str_slice(q, 0, s1));
                    var ekey: str = str_slice(q, s1 + 1, s2);
                    var evalue: str = str_slice(q, s2 + 1, str_len(q));
                    if (verb == "set" || verb == "insert") && edb >= 1 && edb < self.next_db_handle && !vec_i64_contains(self.closed_dbs, edb) {
                        var ej: i64 = 0;
                        while ej < self.db_rows.len() {
                            var erow: DbRow = self.db_rows.get(ej);
                            if erow.db == edb && erow.key == ekey {
                                erow.val = Value::Str(evalue);
                                self.db_rows.set(ej, erow);
                                return ExecOutcome::Value(Value::Int(1));
                            }
                            ej = ej + 1;
                        }
                        self.db_rows.push(DbRow { db: edb, key: ekey, val: Value::Str(evalue) });
                        return ExecOutcome::Value(Value::Int(1));
                    }
                }
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    // ─── SQLite stubs ───
    if name == "p_sqlite3_prepare_v2" { return ExecOutcome::Value(Value::Int(1)); }
    if name == "p_sqlite3_step" { return ExecOutcome::Value(Value::Int(101)); }
    if name == "p_sqlite3_column_type" { return ExecOutcome::Value(Value::Int(5)); }
    if name == "p_sqlite3_column_double" { return ExecOutcome::Value(Value::Float(0.0)); }
    if name == "p_sqlite3_column_name" || name == "p_sqlite3_column_text" { return ExecOutcome::Value(Value::Str("")); }
    if name == "p_sqlite3_errmsg" { return ExecOutcome::Value(Value::Str("interpreter does not support SQLite")); }
    if name == "p_sqlite3_free" { return ExecOutcome::Continue; }
    if str_starts_with(name, "p_sqlite3_") { return ExecOutcome::Value(Value::Int(0)); }

    // ─── Bare-metal stubs ───
    if name == "p_cli" || name == "p_sti" || name == "p_lidt" || name == "p_idt_set_entry" || name == "p_hlt" || name == "p_outb" || name == "p_cr3_write" || name == "p_cr0_write" || name == "p_cr4_write" || name == "p_invlpg" || name == "p_page_map" || name == "p_page_unmap" || name == "p_phys_write64" || name == "p_lgdt" || name == "p_gdt_set_entry" || name == "p_serial_init" || name == "p_serial_write" {
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_inb" || name == "p_phys_read64" || name == "p_serial_read" || name == "p_serial_ready" { return ExecOutcome::Value(Value::Int(0)); }
    if name == "p_cr3_read" { return ExecOutcome::Value(Value::Int(0x10000)); }
    if name == "p_cr0_read" { return ExecOutcome::Value(Value::Int(0x80000011)); }
    if name == "p_cr4_read" { return ExecOutcome::Value(Value::Int(0x20)); }

    // ─── Allocators ───
    if name == "p_allocator_create" {
        match arg_value(args, 0) {
            Value::Str(an2) => { return ExecOutcome::Value(Value::Str("alloc(" + an2 + ")")); }
            _ => {}
        }
        return ExecOutcome::Value(Value::Str("alloc(default)"));
    }
    if name == "p_allocator_alloc" {
        match arg_value(args, 1) {
            Value::Int(asz) => {
                self.alloc_ptr = self.alloc_ptr + asz;
                return ExecOutcome::Value(Value::Ptr(self.alloc_ptr));
            }
            _ => {}
        }
        return ExecOutcome::Value(Value::Ptr(0));
    }
    if name == "p_allocator_free" { return ExecOutcome::Value(Value::Void); }
    if name == "p_allocator_stats" { return ExecOutcome::Value(Value::Int(0)); }

    // ─── Environment, process ───
    if name == "p_getenv" {
        var en2: str = Interpreter_value_to_string(self, arg_value(args, 0));
        if str_len(en2) > 0 {
            var ev2: str = p_getenv(en2);
            var evp: i64 = ev2 + 0;
            if evp != 0 { return ExecOutcome::Value(Value::Str(ev2)); }
        }
        return ExecOutcome::Value(Value::Ptr(0));
    }
    if name == "p_argc" { return ExecOutcome::Value(Value::Int(p_argc())); }
    if name == "p_argv" {
        match arg_value(args, 0) {
            Value::Int(ai2) => {
                if ai2 >= 0 && ai2 < p_argc() { return ExecOutcome::Value(Value::Str(p_argv(ai2))); }
            }
            _ => {}
        }
        return ExecOutcome::Value(Value::Ptr(0));
    }
    if name == "p_system" {
        var cmd: str = Interpreter_value_to_string(self, arg_value(args, 0));
        if str_len(cmd) > 0 { return ExecOutcome::Value(Value::Int(p_system(cmd))); }
        return ExecOutcome::Value(Value::Int(-1));
    }
    if name == "p_exit" {
        p_exit(arg_int(args, 0, 0));
        return ExecOutcome::Continue;
    }
    if name == "p_regex_match" {
        var rs: str = Interpreter_value_to_string(self, arg_value(args, 0));
        var rp: str = Interpreter_value_to_string(self, arg_value(args, 1));
        return ExecOutcome::Value(Value::Bool(wildcard_match(rs, rp)));
    }
    if name == "p_f64_to_bits" {
        match arg_value(args, 0) {
            Value::Float(bf) => { return ExecOutcome::Value(Value::Int(p_f64_to_bits(bf))); }
            Value::Int(bi) => { return ExecOutcome::Value(Value::Int(p_f64_to_bits(bi as f64))); }
            _ => {}
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_f64_from_bits" {
        return ExecOutcome::Value(Value::Float(f64_from_bits_i(arg_int(args, 0, 0))));
    }
    return ExecOutcome::Jump(-99);
}

fn vec_i64_contains(v: Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x { return true; }
        i = i + 1;
    }
    return false;
}

pub fn Interpreter_shared_get(self: &Interpreter, addr: i64) -> i64 {
    match I64Table_get(&self.shared_mem, addr) {
        OptValue::Some(v) => {
            match v {
                Value::Int(n) => { return n; }
                _ => {}
            }
        }
        OptValue::None => {}
    }
    return 0;
}

pub fn Tensor_clone_data(t: &TensorData) -> TensorData {
    return Tensor_new(t.shape.clone(), t.strides.clone(), t.data.clone());
}

// ===========================================================================
// Tensor builtins with the autograd tape (src/interp.rs ML3/ML11/ML12)
// ===========================================================================

// Tape op kinds
pub fn agop_add() -> i64 { return 1; }
pub fn agop_sub() -> i64 { return 2; }
pub fn agop_mul() -> i64 { return 3; }
pub fn agop_matmul() -> i64 { return 4; }
pub fn agop_scale() -> i64 { return 5; }
pub fn agop_relu() -> i64 { return 6; }
pub fn agop_sigmoid() -> i64 { return 7; }
pub fn agop_sum() -> i64 { return 8; }
pub fn agop_mean() -> i64 { return 9; }

pub struct AgEntry {
    pub result: i64,
    pub op: i64,
    pub a: i64,
    pub b: i64,
    pub s: f64,
    pub a_shape: Vec<i64>,
    pub b_shape: Vec<i64>,
    pub a_size: i64,
    pub data: Vec<f64>,
    pub has_input: bool,
    pub input: Vec<f64>,
}

fn AgEntry_new(result: i64, op: i64, a: i64, b: i64) -> AgEntry {
    return AgEntry { result: result, op: op, a: a, b: b, s: 0.0, a_shape: Vec::new(), b_shape: Vec::new(), a_size: 0, data: Vec::new(), has_input: false, input: Vec::new() };
}

fn tensor_addr_of(v: Value) -> i64 {
    match v {
        Value::Ptr(p) => { return p; }
        Value::Int(i) => { return i; }
        _ => {}
    }
    return 0;
}

pub fn Interpreter_record_ag(self: &mut Interpreter, e: AgEntry) {
    if self.ag_enabled { self.ag_tape.push(e); }
}

fn tensor_map_data(t: &TensorData, data: Vec<f64>) -> TensorData {
    return Tensor_new(t.shape.clone(), t.strides.clone(), data);
}

/// accum_grad: add `g` into the gradient for `addr`.
pub fn Interpreter_accum_grad(self: &mut Interpreter, keys: &mut Vec<i64>, vals: &mut Vec<TensorData>, addr: i64, g: TensorData) {
    var i: i64 = 0;
    while i < keys.len() {
        if keys.get(i) == addr {
            var ex: TensorData = vals.get(i);
            var nd: Vec<f64> = ex.data.clone();
            var j: i64 = 0;
            while j < g.data.len() {
                if j < nd.len() { nd.set(j, nd.get(j) + g.data.get(j)); }
                j = j + 1;
            }
            vals.set(i, Tensor_new(ex.shape.clone(), ex.strides.clone(), nd));
            return;
        }
        i = i + 1;
    }
    keys.push(addr);
    vals.push(Tensor_new(g.shape.clone(), g.strides.clone(), g.data.clone()));
}

fn grad_find(keys: Vec<i64>, addr: i64) -> i64 {
    var i: i64 = 0;
    while i < keys.len() {
        if keys.get(i) == addr { return i; }
        i = i + 1;
    }
    return -1;
}

pub fn Interpreter_run_backward(self: &mut Interpreter) {
    var loss_grad: f64 = 1.0;
    var keys: Vec<i64> = Vec::new();
    var vals: Vec<TensorData> = Vec::new();
    var seed_set: bool = false;
    var n: i64 = self.ag_tape.len();
    var ti: i64 = n - 1;
    while ti >= 0 {
        var e: AgEntry = self.ag_tape.get(ti);
        if e.op == agop_sum() {
            keys.push(e.a);
            vals.push(Tensor_filled(e.a_shape.clone(), loss_grad));
            seed_set = true;
            break;
        }
        if e.op == agop_mean() {
            keys.push(e.a);
            vals.push(Tensor_filled(e.a_shape.clone(), loss_grad / (e.a_size as f64)));
            seed_set = true;
            break;
        }
        ti = ti - 1;
    }
    if !seed_set && n > 0 {
        var last: AgEntry = self.ag_tape.get(n - 1);
        if last.result != 0 {
            var one: Vec<i64> = Vec::new();
            one.push(1);
            keys.push(last.result);
            vals.push(Tensor_filled(one, loss_grad));
        }
    }
    var k: i64 = n - 1;
    while k >= 0 {
        var node: AgEntry = self.ag_tape.get(k);
        k = k - 1;
        var gi: i64 = grad_find(keys, node.result);
        if gi < 0 { continue; }
        var go: TensorData = vals.get(gi);
        var gout: TensorData = Tensor_new(go.shape.clone(), go.strides.clone(), go.data.clone());
        if node.op == agop_add() || node.op == agop_mul() {
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, gout);
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.b, gout);
        } else if node.op == agop_sub() {
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, gout);
            var neg: Vec<f64> = Vec::new();
            var i1: i64 = 0;
            while i1 < gout.data.len() { neg.push(0.0 - gout.data.get(i1)); i1 = i1 + 1; }
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.b, tensor_map_data(&gout, neg));
        } else if node.op == agop_matmul() {
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, Tensor_filled(node.a_shape.clone(), 1.0));
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.b, Tensor_filled(node.b_shape.clone(), 1.0));
        } else if node.op == agop_scale() {
            var sc: Vec<f64> = Vec::new();
            var i2: i64 = 0;
            while i2 < gout.data.len() { sc.push(gout.data.get(i2) * node.s); i2 = i2 + 1; }
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, tensor_map_data(&gout, sc));
        } else if node.op == agop_relu() {
            var eff: Vec<f64> = node.data;
            if node.has_input {
                eff = Vec::new();
                var i3: i64 = 0;
                while i3 < node.input.len() {
                    var x: f64 = node.input.get(i3);
                    if x > 0.0 { eff.push(x); } else { eff.push(0.0); }
                    i3 = i3 + 1;
                }
            }
            var rg: Vec<f64> = Vec::new();
            var i4: i64 = 0;
            while i4 < gout.data.len() && i4 < eff.len() {
                if eff.get(i4) > 0.0 { rg.push(gout.data.get(i4)); } else { rg.push(gout.data.get(i4) * 0.0); }
                i4 = i4 + 1;
            }
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, tensor_map_data(&gout, rg));
        } else if node.op == agop_sigmoid() {
            var eff2: Vec<f64> = node.data;
            if node.has_input {
                eff2 = Vec::new();
                var i5: i64 = 0;
                while i5 < node.input.len() {
                    eff2.push(1.0 / (1.0 + math_exp(0.0 - node.input.get(i5))));
                    i5 = i5 + 1;
                }
            }
            var sg: Vec<f64> = Vec::new();
            var i6: i64 = 0;
            while i6 < gout.data.len() && i6 < eff2.len() {
                var sv: f64 = eff2.get(i6);
                sg.push(gout.data.get(i6) * sv * (1.0 - sv));
                i6 = i6 + 1;
            }
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, tensor_map_data(&gout, sg));
        } else if node.op == agop_sum() {
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, Tensor_filled(node.a_shape.clone(), loss_grad));
        } else if node.op == agop_mean() {
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, Tensor_filled(node.a_shape.clone(), loss_grad / (node.a_size as f64)));
        }
    }
    self.ag_grad_keys = keys;
    self.ag_grad_vals = vals;
}

/// A uniform f64 in [0, 1) (xorshift128+, as src/interp.rs prng_next_f64)
@wrapping
pub fn Interpreter_prng_f64(self: &mut Interpreter) -> f64 {
    var s0: u64 = self.prng_state_a;
    var s1: u64 = self.prng_state_b;
    var result: u64 = s0 + s1;
    s1 = s1 ^ s0;
    self.prng_state_a = ((s0 << 24) | (s0 >> 40)) + s1;
    self.prng_state_b = (s1 << 37) | (s1 >> 27);
    var top: i64 = (result >> 11) as i64;
    if top < 0 { top = 0 - top; }
    return (top as f64) * (1.0 / 9007199254740992.0);
}

pub fn Interpreter_prng_gaussian(self: &mut Interpreter) -> f64 {
    var u1: f64 = 0.0001 + Interpreter_prng_f64(self) * 0.9998;
    var u2: f64 = 0.0001 + Interpreter_prng_f64(self) * 0.9998;
    return math_sqrt(-2.0 * math_log(u1)) * math_cos(2.0 * 3.141592653589793 * u2);
}

pub fn Interpreter_call_tensor(self: &mut Interpreter, name: str, args: Vec<Value>) -> ExecOutcome {
    if !str_starts_with(name, "p_tensor_") && !str_starts_with(name, "p_grad_") && !str_starts_with(name, "p_checkpoint_") && name != "p_dp_noise" && name != "p_gaussian_noise" && name != "p_dropout" {
        return ExecOutcome::Jump(-99);
    }
    if name == "p_checkpoint_begin" { self.ag_checkpoint = true; return ExecOutcome::Value(Value::Void); }
    if name == "p_checkpoint_end" { self.ag_checkpoint = false; return ExecOutcome::Value(Value::Void); }
    if name == "p_tensor_from_vec" {
        var d_opt: OptVecI64 = Interpreter_arg_to_vec_i64(self, arg_value(args, 0));
        var s_opt: OptVecI64 = Interpreter_arg_to_vec_i64(self, arg_value(args, 1));
        match d_opt {
            OptVecI64::Some(di) => {
                match s_opt {
                    OptVecI64::Some(sh) => {
                        var df: Vec<f64> = Vec::new();
                        var i: i64 = 0;
                        while i < di.len() { df.push(di.get(i) as f64); i = i + 1; }
                        return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_from_vec(sh, df)));
                    }
                    OptVecI64::None => {}
                }
            }
            OptVecI64::None => {}
        }
        return ExecOutcome::Panic("tensor_from_vec: expected Vec, Vec");
    }
    if name == "p_tensor_get" || name == "p_tensor_set" {
        var th: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        var idx_opt: OptVecI64 = Interpreter_arg_to_vec_i64(self, arg_value(args, 1));
        match idx_opt {
            OptVecI64::Some(idx) => {
                if th >= 0 {
                    if name == "p_tensor_get" {
                        return ExecOutcome::Value(Value::Float(Tensor_get(&self.tensors.get(th), idx)));
                    }
                    if arg_float_opt_ok(args, 2) {
                        var tm: TensorData = self.tensors.get(th);
                        Tensor_set(&mut tm, idx, arg_float(args, 2));
                        self.tensors.set(th, tm);
                        return ExecOutcome::Continue;
                    }
                }
            }
            OptVecI64::None => {}
        }
        if name == "p_tensor_get" { return ExecOutcome::Panic("tensor_get: expected Tensor, Vec"); }
        return ExecOutcome::Panic("tensor_set: expected Tensor, Vec, f64");
    }
    if name == "p_tensor_add" || name == "p_tensor_sub" || name == "p_tensor_mul" || name == "p_tensor_matmul" {
        var ha: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        var hb: i64 = Interpreter_tensor_handle(self, arg_value(args, 1));
        var short: str = str_slice(name, 2, str_len(name));
        if ha < 0 || hb < 0 { return ExecOutcome::Panic(short + ": expected Tensor, Tensor"); }
        var ta: TensorData = self.tensors.get(ha);
        var tb: TensorData = self.tensors.get(hb);
        var rr: ResultTensor = ResultTensor::Err("");
        var op: i64 = agop_add();
        if name == "p_tensor_add" { rr = Tensor_add(&ta, &tb); }
        if name == "p_tensor_sub" { rr = Tensor_sub(&ta, &tb); op = agop_sub(); }
        if name == "p_tensor_mul" { rr = Tensor_mul(&ta, &tb); op = agop_mul(); }
        if name == "p_tensor_matmul" { rr = Tensor_matmul(&ta, &tb); op = agop_matmul(); }
        match rr {
            ResultTensor::Ok(r) => {
                var rv: Value = Interpreter_alloc_tensor(self, r);
                var e: AgEntry = AgEntry_new(tensor_addr_of(rv), op, tensor_addr_of(args.get(0)), tensor_addr_of(args.get(1)));
                if op == agop_matmul() {
                    e.a_shape = ta.shape.clone();
                    e.b_shape = tb.shape.clone();
                }
                Interpreter_record_ag(self, e);
                return ExecOutcome::Value(rv);
            }
            ResultTensor::Err(msg) => { return ExecOutcome::Panic(msg); }
        }
    }
    if name == "p_tensor_scale" {
        var hs: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if hs < 0 || !arg_float_opt_ok(args, 1) { return ExecOutcome::Panic("tensor_scale: expected Tensor, f64"); }
        var s: f64 = arg_float(args, 1);
        var sv: Value = Interpreter_alloc_tensor(self, Tensor_scale(&self.tensors.get(hs), s));
        var se: AgEntry = AgEntry_new(tensor_addr_of(sv), agop_scale(), tensor_addr_of(args.get(0)), 0);
        se.s = s;
        Interpreter_record_ag(self, se);
        return ExecOutcome::Value(sv);
    }
    if name == "p_tensor_sum" || name == "p_tensor_mean" {
        var hm: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if hm < 0 { return ExecOutcome::Panic(str_slice(name, 2, str_len(name)) + ": expected Tensor"); }
        var tsum: TensorData = self.tensors.get(hm);
        var res: f64 = 0.0;
        var mop: i64 = agop_sum();
        if name == "p_tensor_sum" { res = Tensor_sum(&tsum); } else { res = Tensor_mean(&tsum); mop = agop_mean(); }
        if self.ag_enabled {
            var me: AgEntry = AgEntry_new(0, mop, tensor_addr_of(args.get(0)), 0);
            me.a_shape = tsum.shape.clone();
            me.a_size = Tensor_size(&tsum);
            self.ag_tape.push(me);
        }
        return ExecOutcome::Value(Value::Float(res));
    }
    if name == "p_tensor_relu" || name == "p_tensor_sigmoid" {
        var hr: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if hr < 0 { return ExecOutcome::Panic(str_slice(name, 2, str_len(name)) + ": expected Tensor"); }
        var tin: TensorData = self.tensors.get(hr);
        var tout: TensorData = Tensor_relu(&tin);
        var aop: i64 = agop_relu();
        if name == "p_tensor_sigmoid" { tout = interp_tensor_sigmoid(&tin); aop = agop_sigmoid(); }
        var odata: Vec<f64> = tout.data.clone();
        var ov: Value = Interpreter_alloc_tensor(self, tout);
        var re: AgEntry = AgEntry_new(tensor_addr_of(ov), aop, tensor_addr_of(args.get(0)), 0);
        re.data = odata;
        if self.ag_checkpoint {
            re.has_input = true;
            re.input = tin.data.clone();
        }
        Interpreter_record_ag(self, re);
        return ExecOutcome::Value(ov);
    }
    if name == "p_tensor_softmax" || name == "p_tensor_to_json" {
        var hx: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if hx < 0 { return ExecOutcome::Panic(str_slice(name, 2, str_len(name)) + ": expected Tensor"); }
        if name == "p_tensor_to_json" { return ExecOutcome::Value(Value::Str(interp_tensor_to_json(&self.tensors.get(hx)))); }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, interp_tensor_softmax(&self.tensors.get(hx))));
    }
    if name == "p_grad_get" {
        var hg: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if hg < 0 { return ExecOutcome::Panic("grad_get: expected Tensor"); }
        var gidx: i64 = grad_find(self.ag_grad_keys, tensor_addr_of(args.get(0)));
        if gidx >= 0 {
            return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_clone_data(&self.ag_grad_vals.get(gidx))));
        }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_filled(self.tensors.get(hg).shape.clone(), 0.0)));
    }
    if name == "p_grad_zero" {
        var zk: Vec<i64> = Vec::new();
        self.ag_grad_keys = zk;
        var zv: Vec<TensorData> = Vec::new();
        self.ag_grad_vals = zv;
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_dp_noise" || name == "p_dropout" {
        var hn: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if hn < 0 || !arg_float_opt_ok(args, 1) {
            if name == "p_dp_noise" { return ExecOutcome::Panic("dp_noise: expected (Tensor, f64)"); }
            return ExecOutcome::Panic("dropout: expected (Tensor, f64)");
        }
        var pf: f64 = arg_float(args, 1);
        var src: TensorData = self.tensors.get(hn);
        var nd: Vec<f64> = Vec::new();
        var di2: i64 = 0;
        var dscale: f64 = 1.0 / (1.0 - pf);
        while di2 < src.data.len() {
            var x2: f64 = src.data.get(di2);
            if name == "p_dp_noise" {
                nd.push(x2 + pf * Interpreter_prng_gaussian(self));
            } else {
                if Interpreter_prng_f64(self) < pf { nd.push(0.0); } else { nd.push(x2 * dscale); }
            }
            di2 = di2 + 1;
        }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, tensor_map_data(&src, nd)));
    }
    if name == "p_gaussian_noise" {
        var sigma: f64 = arg_float(args, 1);
        match Interpreter_arg_to_vec_i64(self, arg_value(args, 0)) {
            OptVecI64::Some(gs) => {
                var size: i64 = 1;
                var gi2: i64 = 0;
                while gi2 < gs.len() { size = size * gs.get(gi2); gi2 = gi2 + 1; }
                var gd: Vec<f64> = Vec::new();
                var gk: i64 = 0;
                while gk < size { gd.push(sigma * Interpreter_prng_gaussian(self)); gk = gk + 1; }
                return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_from_vec(gs, gd)));
            }
            OptVecI64::None => {}
        }
        return ExecOutcome::Panic("gaussian_noise: expected (Vec, f64)");
    }
    return ExecOutcome::Jump(-99);
}

// Tensor math with the real exp (tensor.fd's tensor_exp is a short Taylor
// series, far off for |x| > 5): matches src/tensor.rs.
pub fn interp_tensor_sigmoid(t: &TensorData) -> TensorData {
    var d: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < t.data.len() {
        d.push(1.0 / (1.0 + math_exp(0.0 - t.data.get(i))));
        i = i + 1;
    }
    return Tensor_new(t.shape.clone(), t.strides.clone(), d);
}

pub fn interp_tensor_softmax(t: &TensorData) -> TensorData {
    var d: Vec<f64> = t.data.clone();
    if t.shape.len() == 0 { return Tensor_new(t.shape.clone(), t.strides.clone(), d); }
    var row: i64 = t.shape.get(t.shape.len() - 1);
    if row <= 0 { return Tensor_new(t.shape.clone(), t.strides.clone(), d); }
    var rows: i64 = Tensor_size(t) / row;
    var r: i64 = 0;
    while r < rows {
        var start: i64 = r * row;
        var mx: f64 = t.data.get(start);
        var i: i64 = start + 1;
        while i < start + row {
            if t.data.get(i) > mx { mx = t.data.get(i); }
            i = i + 1;
        }
        var sum: f64 = 0.0;
        var j: i64 = start;
        while j < start + row {
            var e: f64 = math_exp(t.data.get(j) - mx);
            d.set(j, e);
            sum = sum + e;
            j = j + 1;
        }
        var k: i64 = start;
        while k < start + row {
            d.set(k, d.get(k) / sum);
            k = k + 1;
        }
        r = r + 1;
    }
    return Tensor_new(t.shape.clone(), t.strides.clone(), d);
}

pub fn interp_tensor_to_json(t: &TensorData) -> str {
    var sh: str = "";
    var i: i64 = 0;
    while i < t.shape.len() {
        if i > 0 { sh = sh + ","; }
        sh = sh + int_to_str(t.shape.get(i));
        i = i + 1;
    }
    var dj: str = "";
    var j: i64 = 0;
    while j < t.data.len() {
        if j > 0 { dj = dj + ","; }
        var v: f64 = t.data.get(j);
        var av: f64 = v;
        if av < 0.0 { av = 0.0 - av; }
        var is_int: bool = false;
        if av < 1000000000000000.0 {
            var iv: i64 = v as i64;
            if (iv as f64) == v { is_int = true; }
        }
        if is_int { dj = dj + int_to_str(v as i64); } else { dj = dj + float_to_str(v); }
        j = j + 1;
    }
    return "{\"shape\":[" + sh + "],\"data\":[" + dj + "]}";
}

/// Rust's `{:.4}` (round half away from zero on the binary value).
pub fn fmt_fixed4(v: f64) -> str {
    var neg: bool = v < 0.0;
    var a: f64 = v;
    if neg { a = 0.0 - v; }
    var scaled: f64 = a * 10000.0 + 0.5;
    var r: i64 = scaled as i64;
    var whole: i64 = r / 10000;
    var frac: i64 = r % 10000;
    var fs: str = int_to_str(frac);
    while str_len(fs) < 4 { fs = "0" + fs; }
    var out: str = int_to_str(whole) + "." + fs;
    if neg { out = "-" + out; }
    return out;
}

fn tensor_fmt_elem(v: f64) -> str {
    var av: f64 = v;
    if av < 0.0 { av = 0.0 - av; }
    if av < 1000000000000000.0 {
        var iv: i64 = v as i64;
        if (iv as f64) == v { return int_to_str(iv); }
    }
    return fmt_fixed4(v);
}

fn tensor_fmt_rec(data: Vec<f64>, shape: Vec<i64>, strides: Vec<i64>, dim: i64, offset: i64) -> str {
    if dim >= shape.len() {
        var v: f64 = 0.0;
        if offset < data.len() { v = data.get(offset); }
        return float_to_str(v);
    }
    var out: str = "[";
    var i: i64 = 0;
    while i < shape.get(dim) {
        if i > 0 { out = out + ", "; }
        var idx: i64 = offset + i * strides.get(dim);
        if dim == shape.len() - 1 {
            var ev: f64 = 0.0;
            if idx < data.len() { ev = data.get(idx); }
            out = out + tensor_fmt_elem(ev);
        } else {
            out = out + tensor_fmt_rec(data, shape, strides, dim + 1, idx);
        }
        i = i + 1;
    }
    return out + "]";
}

/// src/tensor.rs Tensor::to_string
pub fn interp_tensor_to_string(t: &TensorData) -> str {
    return tensor_fmt_rec(t.data, t.shape, t.strides, 0, 0);
}

// src/tensor.rs quantize_q8 / dequantize_q8 (tensor.fd pushes
// p_int_to_float results, which the bootstrap types as i64 words)
pub fn interp_quantize_q8(t: &TensorData, scale: f64, zp: i64) -> TensorData {
    var d: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < t.data.len() {
        var x: f64 = t.data.get(i) / scale;
        var r: f64 = 0.0;
        if x < 0.0 { r = 0.0 - math_floor(0.5 - x); } else { r = math_floor(x + 0.5); }
        var q: i64 = wrap_add(r as i64, zp);
        if q < -128 { q = -128; }
        if q > 127 { q = 127; }
        d.push(q as f64);
        i = i + 1;
    }
    return Tensor_new(t.shape.clone(), t.strides.clone(), d);
}

pub fn interp_dequantize_q8(t: &TensorData, scale: f64, zp: i64) -> TensorData {
    var d: Vec<f64> = Vec::new();
    var zf: f64 = zp as f64;
    var i: i64 = 0;
    while i < t.data.len() {
        d.push((t.data.get(i) - zf) * scale);
        i = i + 1;
    }
    return Tensor_new(t.shape.clone(), t.strides.clone(), d);
}

fn int_or_q(v: Value) -> str {
    match v {
        Value::Int(n) => { return int_to_str(n); }
        _ => {}
    }
    return "?";
}

// Wrap-around arithmetic for @wrapping programs (the interpreter's own
// arithmetic is checked).
@wrapping
fn wrap_add(a: i64, b: i64) -> i64 { return a + b; }
@wrapping
fn wrap_sub(a: i64, b: i64) -> i64 { return a - b; }
@wrapping
fn wrap_mul(a: i64, b: i64) -> i64 { return a * b; }

/// A side-table Vec as `[a, "s", ...]` (string elements quoted).
pub fn Interpreter_display_vec_quoted(self: &Interpreter, h: i64) -> str {
    var out: str = "[";
    if h >= 0 && h < self.vec_values.len() {
        var elems: Vec<Value> = self.vec_values.get(h).elements;
        var i: i64 = 0;
        while i < elems.len() {
            if i > 0 { out = out + ", "; }
            match elems.get(i) {
                Value::Str(es) => { out = out + "\"" + es + "\""; }
                _ => { out = out + Interpreter_display_value(self, elems.get(i)); }
            }
            i = i + 1;
        }
    }
    return out + "]";
}

/// ExecOutcome::Jump(-99): a builtin dispatcher did not know the name.
/// An `extern "C"` call to the C library that the interpreter can make
/// through its own runtime (getenv, printf of a plain string, system, exit,
/// getpid); Jump(-99) for any other.
pub fn Interpreter_libc_call(self: &mut Interpreter, c_name: str, args: Vec<Value>) -> ExecOutcome {
    if c_name == "getenv" {
        var gname: str = "";
        if args.len() > 0 { gname = Interpreter_value_to_string(self, args.get(args.len() - 1)); }
        match env_var(gname) {
            Option::Some(gv) => { return ExecOutcome::Value(Value::Str(gv)); }
            Option::None => { return ExecOutcome::Value(Value::Int(0)); }
        }
    }
    if c_name == "printf" || c_name == "puts" {
        var ptext: str = "";
        if args.len() > 0 { ptext = Interpreter_value_to_string(self, args.get(args.len() - 1)); }
        if c_name == "puts" { ptext = ptext + "\n"; }
        p_print_str(ptext);
        return ExecOutcome::Value(Value::Int(str_len(ptext)));
    }
    if c_name == "system" {
        var scmd: str = "";
        if args.len() > 0 { scmd = Interpreter_value_to_string(self, args.get(args.len() - 1)); }
        var sh: i64 = p_process_run(scmd);
        p_print_str(p_process_stdout(sh));
        p_eprint_str(p_process_stderr(sh));
        var scode: i64 = p_process_code(sh);
        p_process_close(sh);
        return ExecOutcome::Value(Value::Int(scode));
    }
    if c_name == "exit" {
        p_exit(arg_int(args, args.len() - 1, 0));
        return ExecOutcome::Value(Value::Void);
    }
    if c_name == "getpid" { return ExecOutcome::Value(Value::Int(p_getpid())); }
    return ExecOutcome::Jump(-99);
}

// Interpreted signals: bit n set when signal n is registered / pending
var g_interp_sig_registered: i64 = 0;
var g_interp_sig_pending: i64 = 0;

fn outcome_is_unhandled(o: ExecOutcome) -> bool {
    match o {
        ExecOutcome::Jump(j) => { return j == -99; }
        _ => {}
    }
    return false;
}
