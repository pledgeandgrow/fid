    // ─── Quantization (ML10) ───
    if name == "p_quantize_q8" {
        var thq: i64 = Interpreter_tensor_handle(self, args.get(0));
        var qscale: f64 = 0.0;
        var qzp: i64 = 0;
        var q_ok: bool = false;
        match args.get(1) { Value::Float(qf) => { qscale = qf; } _ => {} }
        match args.get(2) { Value::Int(qz) => { qzp = qz; q_ok = true; } _ => {} }
        if thq < 0 || !q_ok { return ExecOutcome::Panic("quantize_q8: expected (Tensor, f64, i64)"); }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, interp_quantize_q8(&self.tensors.get(thq), qscale, qzp)));
    }
    if name == "p_dequantize_q8" {
        var thd: i64 = Interpreter_tensor_handle(self, args.get(0));
        var dscale: f64 = 0.0;
        var dzp: i64 = 0;
        var d_ok: bool = false;
        match args.get(1) { Value::Float(df) => { dscale = df; } _ => {} }
        match args.get(2) { Value::Int(dz) => { dzp = dz; d_ok = true; } _ => {} }
        if thd < 0 || !d_ok { return ExecOutcome::Panic("dequantize_q8: expected (Tensor, f64, i64)"); }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, interp_dequantize_q8(&self.tensors.get(thd), dscale, dzp)));
    }
    if name == "p_qmatmul" {
        // Issue 12: Quantized matmul using i32 accumulation (ported inline,
        // mirrors src/interp.rs — tensor.fd has no Tensor_qmatmul).
        var qha: i64 = Interpreter_tensor_handle(self, args.get(0));
        var qhb: i64 = Interpreter_tensor_handle(self, args.get(1));
        if qha < 0 || qhb < 0 { return ExecOutcome::Panic("qmatmul: expected (Tensor, Tensor)"); }
        var qa_t: TensorData = self.tensors.get(qha);
        var qb_t: TensorData = self.tensors.get(qhb);
        if Tensor_ndim(&qa_t) != 2 || Tensor_ndim(&qb_t) != 2 {
            return ExecOutcome::Panic("qmatmul: expected 2D tensors");
        }
        var qm: i64 = qa_t.shape.get(0);
        var qk: i64 = qa_t.shape.get(1);
        var qn: i64 = qb_t.shape.get(1);
        if qb_t.shape.get(0) != qk {
            return ExecOutcome::Panic("qmatmul: shape mismatch");
        }
        var qshape: Vec<i64> = Vec::new();
        qshape.push(qm);
        qshape.push(qn);
        var qres: TensorData = Tensor_zeros(qshape);
        var qi: i64 = 0;
        while qi < qm {
            var qj: i64 = 0;
            while qj < qn {
                var acc: i64 = 0;
                var qx: i64 = 0;
                while qx < qk {
                    var qa: i64 = p_float_to_int(qa_t.data.get(qi * qk + qx));
                    var qb: i64 = p_float_to_int(qb_t.data.get(qx * qn + qj));
                    acc = (acc + qa * qb) & 0xFFFFFFFF;
                    if acc >= 0x80000000 { acc = acc - 0x100000000; }
                    qx = qx + 1;
                }
                qres.data.set(qi * qn + qj, (acc as f64));
                qj = qj + 1;
            }
            qi = qi + 1;
        }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, qres));
    }
    if name == "p_find_quant_params" {
        var thp: i64 = Interpreter_tensor_handle(self, args.get(0));
        if thp < 0 { return ExecOutcome::Panic("find_quant_params: expected Tensor"); }
        var qp: QuantParams = Tensor_find_quant_params(&self.tensors.get(thp));
        return ExecOutcome::Value(Value::Str(float_to_str(qp.scale) + "," + int_to_str(qp.zero_point)));
    }

