    if name == "p_vec_sort" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    // Simple bubble sort (ascending) on raw i64 elements
                    var i: i64 = 0;
                    while i < vlen - 1 {
                        var j: i64 = 0;
                        while j < vlen - 1 - i {
                            var a: i64 = Memory_load_i64(&self.memory, vdata + j * 8);
                            var b: i64 = Memory_load_i64(&self.memory, vdata + (j + 1) * 8);
                            if a > b {
                                Memory_store_i64(&mut self.memory, vdata + j * 8, b);
                                Memory_store_i64(&mut self.memory, vdata + (j + 1) * 8, a);
                            }
                            j = j + 1;
                        }
                        i = i + 1;
                    }
                    return ExecOutcome::Value(Value::Void);
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_clone" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(src_addr) => {
                    var src_len: i64 = Memory_load_i64(&self.memory, src_addr + 8);
                    var src_data: i64 = Memory_load_i64(&self.memory, src_addr);
                    // Create a new vec
                    var new_addr: i64 = Memory_alloc(&mut self.memory, 24);
                    var new_cap: i64 = 8;
                    if src_len > 8 { new_cap = src_len; }
                    if new_cap == 0 { new_cap = 8; }
                    var new_data: i64 = Memory_alloc(&mut self.memory, new_cap * 8);
                    // Copy elements
                    var ci: i64 = 0;
                    while ci < src_len {
                        var v: i64 = Memory_load_i64(&self.memory, src_data + ci * 8);
                        Memory_store_i64(&mut self.memory, new_data + ci * 8, v);
                        ci = ci + 1;
                    }
                    Memory_store_i64(&mut self.memory, new_addr, new_data);
                    Memory_store_i64(&mut self.memory, new_addr + 8, src_len);
                    Memory_store_i64(&mut self.memory, new_addr + 16, new_cap);
                    return ExecOutcome::Value(Value::Int(new_addr));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_vec_capacity" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var vcap: i64 = Memory_load_i64(&self.memory, vec_addr + 16);
                    return ExecOutcome::Value(Value::Int(vcap));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── Map extra runtime functions (ported from src/interp.rs ~3208-3579) ───
    if name == "p_map_keys" {
        // Create a new vec to hold keys (empty since map storage is simplified)
        var vec_addr: i64 = Memory_alloc(&mut self.memory, 24);
        Memory_store_i64(&mut self.memory, vec_addr, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 8, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 16, 0);
        return ExecOutcome::Value(Value::Int(vec_addr));
    }
    if name == "p_map_values" {
        // Create a new vec to hold values (empty since map storage is simplified)
        var vec_addr: i64 = Memory_alloc(&mut self.memory, 24);
        Memory_store_i64(&mut self.memory, vec_addr, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 8, 0);
        Memory_store_i64(&mut self.memory, vec_addr + 16, 0);
        return ExecOutcome::Value(Value::Int(vec_addr));
    }
    if name == "p_map_remove" {
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_map_clone" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(map_addr) => {
                    // Create a new map (shallow copy of struct)
                    var new_addr: i64 = Memory_alloc(&mut self.memory, 32);
                    var k: i64 = Memory_load_i64(&self.memory, map_addr);
                    var v: i64 = Memory_load_i64(&self.memory, map_addr + 8);
                    var l: i64 = Memory_load_i64(&self.memory, map_addr + 16);
                    var c: i64 = Memory_load_i64(&self.memory, map_addr + 24);
                    Memory_store_i64(&mut self.memory, new_addr, k);
                    Memory_store_i64(&mut self.memory, new_addr + 8, v);
                    Memory_store_i64(&mut self.memory, new_addr + 16, l);
                    Memory_store_i64(&mut self.memory, new_addr + 24, c);
                    return ExecOutcome::Value(Value::Int(new_addr));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── Clock runtime functions (ported from src/interp.rs ~4990-5006) ───
    // Use step_count as a simple monotonic counter for timing.
    if name == "p_clock_now" {
        return ExecOutcome::Value(Value::Int(self.step_count));
    }
    if name == "p_clock_now_us" {
        return ExecOutcome::Value(Value::Int(self.step_count));
    }
    if name == "p_clock_now_ms" {
        return ExecOutcome::Value(Value::Int(self.step_count));
    }

    // @zeroize heap wipe: interpreter strings and Vecs are managed values, not
    // raw memory, so there is nothing to wipe.
    if name == "p_str_zeroize" || name == "p_vec_zeroize" {
        return ExecOutcome::Value(Value::Void);
    }
    // ─── Memset (simplified — just return ptr) ───
    if name == "p_memset" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(ptr) => { return ExecOutcome::Value(Value::Int(ptr)); }
                Value::Ptr(ptr) => { return ExecOutcome::Value(Value::Ptr(ptr)); }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── File I/O builtins (stubs — no real file system access) ───
    if name == "p_file_read" {
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_file_write" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_file_exists" {
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_file_append" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_file_delete" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_file_size" {
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── Threading (interpreter is single-threaded: spawn runs eagerly) ───
    // Mirrors src/interp.rs: spawn resolves func_name, runs it immediately
    // (preserves Vec/Map side-table access), and stores the result in
    // future_values; the Int handle indexes that table via p_future_poll.
    if name == "p_thread_spawn" || name == "p_executor_spawn" {
        var base: i64 = 0;
        if name == "p_executor_spawn" { base = 1; }
        var func_name: str = "";
        match args.get(base) {
            Value::Str(s) => { func_name = s; }
            Value::Ptr(a) => { func_name = Memory_load_cstr(&self.memory, a); }
            _ => {}
        }
        var num_args: i64 = 0;
        match args.get(base + 1) { Value::Int(n) => { num_args = n; } _ => {} }
        var thread_values: Vec<Value> = Vec::new();
        thread_values.push(Value::Int(0));   // dummy __env
        var tai: i64 = 0;
        while tai < num_args {
            var av: i64 = base + 2 + tai;
            if av < args.len() { thread_values.push(args.get(av)); }
            tai = tai + 1;
        }
        var spawn_result: Value = Value::Int(0);
        match IrModule_get_function(&self.module, func_name) {
            OptIrFunction::Some(func2) => {
                match Interpreter_run_function(self, func2, thread_values) {
                    RunResult::Return(v5) => { spawn_result = v5; }
                    RunResult::Panic(pmsg) => {
                        p_eprint_str("Thread panic: " + pmsg + "\n");
                    }
                    RunResult::Paused => { }
                }
            }
            OptIrFunction::None => {
                p_eprint_str("Thread: unknown function '" + func_name + "'\n");
            }
        }
        var fidx: i64 = self.future_values.len();
        self.future_values.push(spawn_result);
        return ExecOutcome::Value(Value::Int(fidx));
    }
    if name == "p_thread_join" {
        // Threads already ran eagerly at spawn — join is a no-op.
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_executor_new" {
        self.thread_handle_count = self.thread_handle_count + 1;
        return ExecOutcome::Value(Value::Int(self.thread_handle_count));
    }
    if name == "p_executor_block_on" {
        // block_on(exec, future) -> i64 — return the (already-resolved) result.
        var bf: i64 = -1;
        match args.get(1) { Value::Int(n) => { bf = n; } _ => {} }
        if bf >= 0 && bf < self.future_values.len() {
            match self.future_values.get(bf) {
                Value::Int(bn) => { return ExecOutcome::Value(Value::Int(bn)); }
                _ => { }
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_executor_run_all" || name == "p_executor_poll_all" {
        // Everything already ran eagerly at spawn.
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_future_poll" || name == "p_future_ready" ||
       name == "p_task_poll" || name == "p_task_poll_nonblocking" {
        var fh: i64 = -1;
        match args.get(0) { Value::Int(n) => { fh = n; } _ => {} }
        if fh >= 0 && fh < self.future_values.len() {
            var fv: Value = self.future_values.get(fh);
            match fv {
                Value::Int(fn2) => { return ExecOutcome::Value(Value::Int(fn2)); }
                Value::Bool(fb) => {
                    if fb { return ExecOutcome::Value(Value::Int(1)); }
                    return ExecOutcome::Value(Value::Int(0));
                }
                Value::Ptr(fp) => { return ExecOutcome::Value(Value::Int(fp)); }
                _ => { }
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_task_is_ready" {
        return ExecOutcome::Value(Value::Bool(true));
    }

    // ─── Default: panic for unknown runtime functions ───
    // Matches src/interp.rs:6165 — ExecOutcome::Panic("Unknown runtime
    // function: {name}"). is_runtime_func claims far more names than this
    // dispatch implements; returning Int(0) fabricated results silently.
    return ExecOutcome::Panic("Unknown runtime function: " + name);
}

// ===========================================================================
// run_and_print -- execute main() and print result, return exit code
// ===========================================================================
//
// This wraps Interpreter_run and handles printing the result.
// Returns 0 on success, 1 on panic/error.

pub fn Interpreter_run_and_print(self: &mut Interpreter) -> i64 {
    var result: RunResult = Interpreter_run(self);
    match result {
        RunResult::Return(v) => {
            match v {
                Value::Void => { }
                _ => {
                    p_print_str("=> ");
                    p_print_str(Interpreter_value_to_string(self, v));
                    p_print_str("\n");
                }
            }
            return 0;
        }
        RunResult::Panic(msg) => {
            p_eprint_str("Runtime panic: ");
            p_eprint_str(msg);
            p_eprint_str("\n");
            return 1;
        }
        RunResult::Paused => {
            p_eprint_str("Execution paused\n");
            return 0;
        }
    }
    return 1;
}

// ===========================================================================
// Missing helper functions — ported from src/interp.rs
// ===========================================================================

/// coerce_str_to_int — materialize a Str value into memory and return Int(addr).
/// Used when a string value is passed to an I64/U64 parameter.
pub fn Interpreter_coerce_str_to_int(self: &mut Interpreter, v: Value) -> Value {
    match v {
        Value::Str(s) => {
            var addr: i64 = Memory_store_cstr(&mut self.memory, s);
            return Value::Int(addr);
        }
        _ => { return v; }
    }
}

/// is_wrapping_func — check if the currently executing function is @wrapping.
pub fn Interpreter_is_wrapping_func(self: &Interpreter) -> bool {
    if str_len(self.current_func_name) == 0 { return false; }
    var func_opt: OptIrFunction = IrModule_get_function(&self.module, self.current_func_name);
    match func_opt {
        OptIrFunction::Some(f) => { return f.is_wrapping; }
        OptIrFunction::None => { return false; }
    }
}

/// stringify_value — serialize a Value to a type-prefixed string for persistence.
/// Format: "i:42", "b:true", "f:3.14", "s:hello", "p:0x1234", "pv:elem,elem"
pub fn Interpreter_stringify_value(self: &Interpreter, val: Value) -> str {
    match val {
        Value::Int(n) => { return "i:" + int_to_str(n); }
        Value::Bool(b) => {
            if b { return "b:true"; }
            return "b:false";
        }
        Value::Float(f) => { return "f:" + float_to_str(f); }
        Value::Str(s) => { return "s:" + s; }
        Value::Ptr(addr) => {
            // Look up opaque side-table for richer serialization
            var opaque_opt: OptValue = Interpreter_lookup_opaque(self, addr);
            match opaque_opt {
                OptValue::Some(opaque) => {
                    match opaque {
                        Value::Str(s) => { return "ps:" + s; }
                        _ => { return "p:" + int_to_str(addr); }
                    }
                }
                OptValue::None => { return "p:" + int_to_str(addr); }
            }
        }
        _ => { return "v:void"; }
    }
}

/// parse_persisted_value — parse a type-prefixed string back into a Value.
pub fn Interpreter_parse_persisted_value(self: &Interpreter, saved: str, default: Value) -> Value {
    var colon_idx: i64 = str_find(saved, ":");
    if colon_idx >= 0 {
        var prefix: str = str_slice(saved, 0, colon_idx + 1);
        var rest: str = str_slice(saved, colon_idx + 1, str_len(saved));
        if prefix == "i:" { return Value::Int(str_parse_int(rest)); }
        if prefix == "b:" { return Value::Bool(rest == "true"); }
        if prefix == "f:" { return Value::Float(str_parse_float(rest)); }
        if prefix == "s:" { return Value::Str(rest); }
        if prefix == "ps:" { return Value::Str(rest); }
        if prefix == "p:" { return Value::Ptr(str_parse_int(rest)); }
    }
    return default;
}

/// arg_string — extract a string from a Value argument.
/// Handles Value::Str, Value::Ptr (load C string from memory), and
/// Value::Int (check opaque table or load from memory).
pub fn Interpreter_arg_string(self: &Interpreter, v: Value) -> OptStr {
    match v {
        Value::Str(s) => { return OptStr::Some(s); }
        Value::Ptr(addr) => {
            if addr > 0 {
                var loaded: str = Memory_load_cstr(&self.memory, addr);
                return OptStr::Some(loaded);
            }
            return OptStr::None;
        }
        Value::Int(i) => {
            if i > 0 {
                // Check opaque side-table first
                var opaque_opt: OptValue = Interpreter_lookup_opaque(self, i);
                match opaque_opt {
                    OptValue::Some(o) => {
                        match o {
                            Value::Str(s) => { return OptStr::Some(s); }
                            _ => {}
                        }
                    }
                    OptValue::None => {}
                }
                // Try loading a null-terminated string from memory
                if Memory_is_valid_addr(&self.memory, i) {
                    var loaded2: str = Memory_load_cstr(&self.memory, i);
                    if str_len(loaded2) > 0 { return OptStr::Some(loaded2); }
                }
            }
            return OptStr::None;
        }
        _ => { return OptStr::None; }
    }
}

/// lookup_vec_value — look up a Vec Value from an Int/Ptr address.
/// Checks the vec_side_table first, then the opaque_values table.
pub fn Interpreter_lookup_vec_value(self: &Interpreter, arg: Value) -> OptValue {
    match arg {
        Value::Int(addr) => {
            if addr > 0 {
                // Check vec_side_table
                var si: i64 = 0;
                while si < self.vec_side_table.len() {
                    if self.vec_side_table.get(si).vec_addr == addr {
                        var side_idx: i64 = self.vec_side_table.get(si).side_idx;
                        // Look up in opaque_values by side_idx as address
                        return Interpreter_lookup_opaque(self, side_idx);
                    }
                    si = si + 1;
                }
                // Try opaque_values directly
                return Interpreter_lookup_opaque(self, addr);
            }
            return OptValue::None;
        }
        Value::Ptr(addr) => {
            if addr > 0 {
                var si2: i64 = 0;
                while si2 < self.vec_side_table.len() {
                    if self.vec_side_table.get(si2).vec_addr == addr {
                        var side_idx2: i64 = self.vec_side_table.get(si2).side_idx;
                        return Interpreter_lookup_opaque(self, side_idx2);
                    }
                    si2 = si2 + 1;
                }
                return Interpreter_lookup_opaque(self, addr);
            }
            return OptValue::None;
        }
        _ => { return OptValue::None; }
    }
}

/// read_raw_vec_i64 — read a raw Fides Vec struct from memory.
/// Vec is 24 bytes: { data: i64, len: i64, cap: i64 }.
/// Elements are at data[i*8] as raw i64 values.
pub fn Interpreter_read_raw_vec_i64(self: &Interpreter, addr: i64) -> OptVecI64 {
    if addr == 0 { return OptVecI64::None; }
    var len: i64 = Memory_load_i64(&self.memory, addr + 8);
    if len < 0 { return OptVecI64::None; }
    var data: i64 = Memory_load_i64(&self.memory, addr);
    if data <= 0 { return OptVecI64::Some(Vec::new()); }
    var result: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < len {
        var elem: i64 = Memory_load_i64(&self.memory, data + i * 8);
        result.push(elem);
        i = i + 1;
    }
    return OptVecI64::Some(result);
}

/// arg_to_vec_i64 — extract a Vec<i64> from an argument.
/// Handles Value::Vec (interpreter builtin) and Value::Int/Ptr (raw Fides Vec).
pub fn Interpreter_arg_to_vec_i64(self: &Interpreter, arg: Value) -> OptVecI64 {
    match arg {
        Value::Vec(vec_handle) => {
            // Read from vec_values side table
            if vec_handle >= 0 && vec_handle < self.vec_values.len() {
                // This is a simplified version — returns empty for now
                return OptVecI64::Some(Vec::new());
            }
            return OptVecI64::None;
        }
        Value::Int(addr) => {
            if addr > 0 {
                // First try the side-table
                var lookup: OptValue = Interpreter_lookup_vec_value(self, arg);
                match lookup {
                    OptValue::Some(v) => {
                        match v {
                            Value::Vec(_) => {
                                // Simplified — would extract elements
                                return OptVecI64::Some(Vec::new());
                            }
                            _ => {}
                        }
                    }
                    OptValue::None => {}
                }
                // Try reading as raw Fides Vec
                return Interpreter_read_raw_vec_i64(self, addr);
            }
            return OptVecI64::None;
        }
        Value::Ptr(addr) => {
            if addr > 0 {
                var lookup2: OptValue = Interpreter_lookup_vec_value(self, arg);
                match lookup2 {
                    OptValue::Some(v2) => {
                        match v2 {
                            Value::Vec(_) => { return OptVecI64::Some(Vec::new()); }
                            _ => {}
                        }
                    }
                    OptValue::None => {}
                }
                return Interpreter_read_raw_vec_i64(self, addr);
            }
            return OptVecI64::None;
        }
        _ => { return OptVecI64::None; }
    }
}

/// alloc_tensor — store a Tensor in the side table and return an opaque Ptr.
/// Value::Ptr(addr) stands in for Rust's Value::Tensor (see file header).
pub fn Interpreter_alloc_tensor(self: &mut Interpreter, t: TensorData) -> Value {
    var addr: i64 = Memory_alloc(&mut self.memory, 8);
    var handle: i64 = self.tensors.len();
    self.tensors.push(t);
    self.tensor_side_table.push(TensorSideEntry_new(addr, handle));
    Memory_store_i64(&mut self.memory, addr, handle);
    return Value::Ptr(addr);
}

/// tensor_handle — resolve a Value::Ptr/Int addr to a tensors index, or -1.
pub fn Interpreter_tensor_handle(self: &Interpreter, arg: Value) -> i64 {
    var addr: i64 = -1;
    match arg {
        Value::Ptr(a) => { addr = a; }
        Value::Int(a) => { addr = a; }
        _ => {}
    }
    if addr < 0 { return -1; }
    var i: i64 = 0;
    while i < self.tensor_side_table.len() {
        if self.tensor_side_table.get(i).addr == addr {
            return self.tensor_side_table.get(i).handle;
        }
        i = i + 1;
    }
    return -1;
}

/// args_to_f64_vec — extract a Vec<f64> from args[idx].
/// Handles Value::Vec and Value::Int/Ptr (Fides Vec via fides_vec_to_value_vec).
pub fn Interpreter_args_to_f64_vec(self: &mut Interpreter, args: Vec<Value>, idx: i64) -> OptVecF64 {
    if idx < 0 || idx >= args.len() { return OptVecF64::None; }
    var arg: Value = args.get(idx);
    match arg {
        Value::Vec(_) => {
            // Simplified — would extract float elements
            return OptVecF64::Some(Vec::new());
        }
        Value::Int(ptr) => {
            // Fides Vec — convert via fides_vec_to_value_vec
            var v: Value = Interpreter_fides_vec_to_value_vec(self, ptr);
            match v {
                Value::Vec(_) => { return OptVecF64::Some(Vec::new()); }
                _ => { return OptVecF64::None; }
            }
        }
        Value::Ptr(ptr) => {
            var v2: Value = Interpreter_fides_vec_to_value_vec(self, ptr);
            match v2 {
                Value::Vec(_) => { return OptVecF64::Some(Vec::new()); }
                _ => { return OptVecF64::None; }
            }
        }
        _ => { return OptVecF64::None; }
    }
}

/// fides_vec_to_value_vec — convert a Fides Vec (i64 pointer) to a Value::Vec.
/// Uses Vec_len and Vec_get functions if available.
pub fn Interpreter_fides_vec_to_value_vec(self: &mut Interpreter, vec_ptr: i64) -> Value {
    // Try using Vec_len/Vec_get from the module
    var len_fn_opt: OptIrFunction = IrModule_get_function(&self.module, "Vec_len");
    var get_fn_opt: OptIrFunction = IrModule_get_function(&self.module, "Vec_get");
    match len_fn_opt {
        OptIrFunction::Some(len_fn) => {
            match get_fn_opt {
                OptIrFunction::Some(get_fn) => {
                    var len_args: Vec<Value> = Vec::new();
                    len_args.push(Value::Int(0));
                    len_args.push(Value::Int(vec_ptr));
                    var len_result: RunResult = Interpreter_run_function(self, len_fn, len_args);
                    var len: i64 = 0;
                    match len_result {
                        RunResult::Return(v) => {
                            match v {
                                Value::Int(n) => { len = n; }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                    // Simplified — return empty Vec Value
                    return Value::Void;
                }
                OptIrFunction::None => {}
            }
        }
        OptIrFunction::None => {}
    }
    return Value::Void;
}

/// find_vec_addr — find the Vec struct address for a Value::Vec by scanning vec_side_table.
pub fn Interpreter_find_vec_addr(self: &Interpreter, v: Value) -> i64 {
    match v {
        Value::Vec(target_handle) => {
            var si: i64 = 0;
            while si < self.vec_side_table.len() {
                if self.vec_side_table.get(si).side_idx == target_handle {
                    return self.vec_side_table.get(si).vec_addr;
                }
                si = si + 1;
            }
        }
        _ => {}
    }
    return 0;
}

/// format_panic_trace — format the panic stack trace as a string.
pub fn Interpreter_format_panic_trace(self: &Interpreter) -> OptStr {
    match self.panic_stack_trace {
        OptStr::Some(s) => { return OptStr::Some(s); }
        OptStr::None => { return OptStr::None; }
    }
}

/// take_panic_stack_trace — consume the panic stack trace.
pub fn Interpreter_take_panic_stack_trace(self: &mut Interpreter) -> OptStr {
    var trace: OptStr = self.panic_stack_trace;
    self.panic_stack_trace = OptStr::None;
    return trace;
}

/// get_call_stack — return a copy of the call stack.
pub fn Interpreter_get_call_stack(self: &Interpreter) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < self.call_stack.len() {
        result.push(self.call_stack.get(i));
        i = i + 1;
    }
    return result;
}

/// get_current_func_name — return the current function name.
pub fn Interpreter_get_current_func_name(self: &Interpreter) -> str {
    return self.current_func_name;
}

/// get_memory_usage — return (allocated, capacity) as packed i64.
pub fn Interpreter_get_memory_usage(self: &Interpreter) -> i64 {
    var allocated: i64 = Memory_allocated(&self.memory);
    var cap: i64 = Memory_capacity(&self.memory);
    return allocated * 1000000 + cap;
}

/// get_module — return a reference to the IR module.
/// In Fides, we return a copy since references are limited.
pub fn Interpreter_get_module(self: &Interpreter) -> IrModule {
    return self.module;
}

/// get_thread_count — return the number of threads (always 1 for interpreter).
pub fn Interpreter_get_thread_count(self: &Interpreter) -> i64 {
    return 1;
}

/// enable_profiling — enable profiling mode.
pub fn Interpreter_enable_profiling(self: &mut Interpreter) {
    self.verbose = true;
}

/// enable_recording — enable trace recording.
pub fn Interpreter_enable_recording(self: &mut Interpreter) {
    self.verbose = true;
}

/// get_profile — return profiling data (simplified: empty).
pub fn Interpreter_get_profile(self: &Interpreter) -> Vec<str> {
    return Vec::new();
}

/// get_trace — return trace data (simplified: empty).
pub fn Interpreter_get_trace(self: &Interpreter) -> Vec<str> {
    return Vec::new();
}

/// set_debug_hook — set a debug hook (simplified: no-op in self-hosted).
pub fn Interpreter_set_debug_hook(self: &mut Interpreter) {
    self.debug_mode = true;
}

/// save_persist_state — save persistent state (simplified: no-op).
pub fn Interpreter_save_persist_state(self: &Interpreter) {
