    // ─── Vec extra runtime functions (ported from src/interp.rs ~2868-3554) ───
    if name == "p_vec_to_str" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var out: str = "[";
                    var vi: i64 = 0;
                    while vi < vlen {
                        if vi > 0 { out = out + ", "; }
                        var elem: i64 = Memory_load_i64(&self.memory, vdata + vi * 8);
                        out = out + int_to_str(elem);
                        vi = vi + 1;
                    }
                    out = out + "]";
                    return ExecOutcome::Value(Value::Str(out));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Str("[]"));
    }
    if name == "p_vec_insert" {
        if args.len() >= 3 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    match args.get(1) {
                        Value::Int(idx) => {
                            var elem: i64 = 0;
                            match args.get(2) {
                                Value::Int(e) => { elem = e; }
                                Value::Ptr(p) => { elem = p; }
                                _ => {}
                            }
                            var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                            var vcap: i64 = Memory_load_i64(&self.memory, vec_addr + 16);
                            var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                            if idx < 0 || idx > vlen {
                                return ExecOutcome::Panic("Vec insert out of bounds");
                            }
                            // Grow if needed
                            if vlen >= vcap {
                                var new_cap: i64 = 8;
                                if vcap > 0 { new_cap = vcap * 2; }
                                var new_data: i64 = Memory_alloc(&mut self.memory, new_cap * 8);
                                var ci: i64 = 0;
                                while ci < vlen {
                                    var v: i64 = Memory_load_i64(&self.memory, vdata + ci * 8);
                                    Memory_store_i64(&mut self.memory, new_data + ci * 8, v);
                                    ci = ci + 1;
                                }
                                vdata = new_data;
                                vcap = new_cap;
                                Memory_store_i64(&mut self.memory, vec_addr, vdata);
                                Memory_store_i64(&mut self.memory, vec_addr + 16, vcap);
                            }
                            // Shift elements right from idx to vlen-1
                            var si: i64 = vlen;
                            while si > idx {
                                var v: i64 = Memory_load_i64(&self.memory, vdata + (si - 1) * 8);
                                Memory_store_i64(&mut self.memory, vdata + si * 8, v);
                                si = si - 1;
                            }
                            // Insert element
                            Memory_store_i64(&mut self.memory, vdata + idx * 8, elem);
                            vlen = vlen + 1;
                            Memory_store_i64(&mut self.memory, vec_addr + 8, vlen);
                            return ExecOutcome::Value(Value::Void);
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_remove" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    match args.get(1) {
                        Value::Int(idx) => {
                            var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                            var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                            if idx < 0 || idx >= vlen {
                                return ExecOutcome::Panic("Vec remove out of bounds");
                            }
                            var elem: i64 = Memory_load_i64(&self.memory, vdata + idx * 8);
                            // Shift elements left from idx+1 to vlen-1
                            var si: i64 = idx;
                            while si < vlen - 1 {
                                var v: i64 = Memory_load_i64(&self.memory, vdata + (si + 1) * 8);
                                Memory_store_i64(&mut self.memory, vdata + si * 8, v);
                                si = si + 1;
                            }
                            vlen = vlen - 1;
                            Memory_store_i64(&mut self.memory, vec_addr + 8, vlen);
                            return ExecOutcome::Value(Value::Int(elem));
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_contains" {
        if args.len() >= 2 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var target: i64 = 0;
                    match args.get(1) {
                        Value::Int(e) => { target = e; }
                        Value::Ptr(p) => { target = p; }
                        _ => {}
                    }
                    var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var ci: i64 = 0;
                    while ci < vlen {
                        var elem: i64 = Memory_load_i64(&self.memory, vdata + ci * 8);
                        if elem == target {
                            return ExecOutcome::Value(Value::Bool(true));
                        }
                        ci = ci + 1;
                    }
                    return ExecOutcome::Value(Value::Bool(false));
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_vec_reverse" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var lo: i64 = 0;
                    var hi: i64 = vlen - 1;
                    while lo < hi {
                        var tmp1: i64 = Memory_load_i64(&self.memory, vdata + lo * 8);
                        var tmp2: i64 = Memory_load_i64(&self.memory, vdata + hi * 8);
                        Memory_store_i64(&mut self.memory, vdata + lo * 8, tmp2);
                        Memory_store_i64(&mut self.memory, vdata + hi * 8, tmp1);
                        lo = lo + 1;
                        hi = hi - 1;
                    }
                    return ExecOutcome::Value(Value::Void);
                }
                _ => {}
            }
        }
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_vec_first" {
        if args.len() >= 1 {
            match args.get(0) {
                Value::Int(vec_addr) => {
                    var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    if vlen == 0 {
                        return ExecOutcome::Panic("Vec first() on empty vec");
                    }
                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var elem: i64 = Memory_load_i64(&self.memory, vdata);
                    return ExecOutcome::Value(Value::Int(elem));
