                    var vlen: i64 = Memory_load_i64(&self.memory, vec_addr + 8);
                    if vlen == 0 {
                        return ExecOutcome::Panic("Vec last() on empty vec");
                    }
                    var vdata: i64 = Memory_load_i64(&self.memory, vec_addr);
                    var elem: i64 = Memory_load_i64(&self.memory, vdata + (vlen - 1) * 8);
