            var s: str = Interpreter_value_to_string(self, args.get(0));
            var idx: i64 = -1;
            match args.get(1) {
                Value::Int(i) => {
                    idx = i;
                }
                _ => {
                }
            }
            if idx < 0 || idx >= str_len(s) {
                return ExecOutcome::Panic("String char_at out of bounds");
