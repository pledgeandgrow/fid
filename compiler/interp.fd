fn json_type_name(j: Json) -> str {
    match j {
        Json::Null => {
            return "null";
        }
        Json::Bool(_) => {
            return "boolean";
        }
        Json::Num(_) => {
            return "number";
        }
        Json::Str(_) => {
            return "string";
        }
        Json::Arr(_) => {
            return "array";
        }
        Json::Obj(_) => {
            return "object";
        }
    }
    return "null";
}

/// JSON string-literal escaping (Rust's p_json_string / http esc).
pub fn json_escape_body(s: str) -> str {
    var out: str = "";
    var n: i64 = str_len(s);
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(s, i);
        if c == 34 {
            out = out + "\\\"";
        } else if c == 92 {
            out = out + "\\\\";
        } else if c == 10 {
            out = out + "\\n";
        } else if c == 13 {
            out = out + "\\r";
        } else if c == 9 {
            out = out + "\\t";
        } else if c < 32 {
            var hx: str = int_to_hex(c);
            while str_len(hx) < 4 {
                hx = "0" + hx;
            }
            out = out + "\\u" + hx;
        } else {
            out = out + p_char_to_str(c);
        }
        i = i + 1;
    }
    return out;
}

/// Index of `sub` in `s` at or after `from`, or -1.
fn str_find_from(s: str, sub: str, from: i64) -> i64 {
    var n: i64 = str_len(s);
    var m: i64 = str_len(sub);
    var i: i64 = from;
    while i + m <= n {
        var j: i64 = 0;
        var ok: bool = true;
        while j < m {
            if str_byte_at(s, i + j) != str_byte_at(sub, j) {
                ok = false;
                break;
            }
            j = j + 1;
        }
        if ok {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Run `func_name` eagerly with `targs` (a spawned thread / task); the
/// thread's return value. A panic in it ends the program (status 1).
pub fn Interpreter_run_eager(self: &mut Interpreter, func_name: str, targs: Vec<Value>, what: str) -> Value {
    var tv: Vec<Value> = Vec::new();
    tv.push(Value::Int(0));
    var i: i64 = 0;
    while i < targs.len() {
        tv.push(targs.get(i));
        i = i + 1;
    }
    match Interpreter_get_function(self, func_name) {
        OptIrFunction::Some(f) => {
            match Interpreter_run_function(self, f, tv) {
                RunResult::Return(v) => {
                    return v;
                }
                RunResult::Panic(msg) => {
                    // A panic in a task or thread ends the whole program,
                    // as on every backend (reference.md 8.2: no task
                    // survives another's panic)
                    p_eprint_str("Panic: " + msg + "\n");
                    var task_trace: str = "";
                    match Interpreter_take_panic_stack_trace(self) {
                        OptStr::Some(trace) => {
                            p_eprint_str(trace);
                            task_trace = trace;
                        }
                        OptStr::None => {
                        }
                    }
                    interp_write_crash_report(msg, task_trace);
                    interp_rr_exiting(1);
                    p_exit(1);
                    return Value::Int(0);
                }
                RunResult::Paused => {
                    return Value::Int(0);
                }
            }
        }
        OptIrFunction::None => {
            p_eprint_str(what + ": unknown function '" + func_name + "'\n");
        }
    }
    return Value::Int(0);
}

pub fn Interpreter_ecs_comp(self: &mut Interpreter, name: str) -> i64 {
    var i: i64 = 0;
    while i < self.ecs_comps.len() {
        if self.ecs_comps.get(i).name == name {
            return i;
        }
        i = i + 1;
    }
    self.ecs_comps.push(EcsComp {
        name: name, table: I64Table_new()
    });
    return self.ecs_comps.len() - 1;
}

/// The (component name, entity) of an __ecs_* call: args (name, e) or
/// (env, name, e).
fn ecs_name_entity_ok(args: Vec<Value>) -> i64 {
    if args.len() >= 2 {
        match args.get(0) {
            Value::Str(_) => {
                match args.get(1) {
                    Value::Int(_) => {
                        return 0;
                    }
                    _ => {
                    }
                }
            }
            _ => {
            }
        }
    }
    if args.len() >= 3 {
        match args.get(1) {
            Value::Str(_) => {
                match args.get(2) {
                    Value::Int(_) => {
                        return 1;
                    }
                    _ => {
                    }
                }
            }
            _ => {
            }
        }
    }
    return -1;
}

fn arg_str_raw(args: Vec<Value>, i: i64) -> str {
    match args.get(i) {
        Value::Str(s) => {
            return s;
        }
        _ => {
        }
    }
    return "";
}

// ===========================================================================
// Interleaved tasks (competitive roadmap LG11)
// ===========================================================================
//
// Each interpreted task has a call stack of its own: it runs on a task of
// the C runtime fid is built with (interp_task_entry, started with p_co_go
// or p_co_async), on a stack as deep as the main thread's (p_co_stack,
// asked by name as p_thread_spawn("__p_co_stack", ..): fid is built by the
// previous fid, whose runtime may not have it), so
// it switches where it does natively: at a yield, a sleep, an await, a
// join, a channel receive that has to wait, a socket wait -- the
// cancellation checkpoints of stdlib/task.fd. Only one runs at a time (the
// C runtime's tasks share one thread): the interpreter's state is shared,
// and what belongs to the running call chain (InterpCtx: its call stack,
// the allocas of its frames, its regions, its unsafe depth) is set aside in
// the switching call's own locals and put back when it resumes.
//
// p_co_go queues the task (it starts at the next switch, as the C runtime
// starts it); p_co_async and p_thread_spawn enter it at once and come back
// when it first waits. At most ITASK_LIVE_MAX tasks have a stack at a
// time: further p_co_go tasks wait in itask_pending for one to end, and an
// async call or thread past that runs to its end at once. A runtime older
// than p_co_stack (-1) gives a task its default stack (1 MB on Windows):
// tasks still interleave there, a task's calls kept within
// g_itask_budget bytes of that stack (Interpreter_itask_stack_check), and
// where that leaves too little (256 KB on Linux and macOS) they do not.
// Where tasks cannot switch or run on several threads at once (fid built
// natively, or for WebAssembly: -2; a recording or a replay, which needs
// one order) every task runs to its end when it starts, as before LG11.
//
// There is no kill: cancelling is a request (a token, a scope's flag) that
// a task sees at its next checkpoint, which returns "cancelled"; the task
// then returns along its normal path, so its drops and `defer` blocks run
// (reference.md 8.2: nothing unwinds).

const ITASK_TAG: i64 = 0x7FA5;
const ITASK_LIVE_MAX: i64 = 256;
// the main thread's stack (scripts/bootstrap.sh): --max-recursion's limit
// holds in a task as in main
const ITASK_STACK: i64 = 268435456;
const ITASK_LOW48: i64 = 281474976710655;

// an older C runtime's task stack on Windows (1 MB) and elsewhere (256 KB
// and its guard page); what the calls below the check may still take (the
// builtins' frames, a switch); the least worth interleaving with
const ITASK_OLD_STACK_WIN: i64 = 1048576;
const ITASK_OLD_STACK: i64 = 266240;
const ITASK_MARGIN: i64 = 393216;
const ITASK_MIN_BUDGET: i64 = 393216;

/// 0 not decided yet, 1 tasks interleave, 2 each runs to its end when it
/// starts.
var g_itask_mode: i64 = 0;
/// The address of the interpreter whose tasks run (interp_task_entry).
var g_itask_interp: i64 = 0;
/// How many bytes of its stack a task's calls may take (0: no limit but
/// --max-recursion), and where the running task's stack starts (0: main).
var g_itask_budget: i64 = 0;
var g_itask_top: i64 = 0;

/// An interpreted task: its function and arguments, its result once done.
pub struct ITask {
    pub func: str,
    pub args: Vec<Value>,
    pub what: str,
    pub started: bool,
    pub done: bool,
    pub result: Value,
    // CA7/CA8: its token slot (p_task_token), empty when it starts
    pub token: i64,
}

/// What belongs to one call chain: set aside while another task runs.
pub struct InterpCtx {
    pub func_name: str,
    pub wrapping: bool,
    pub call_stack: Vec<str>,
    pub call_site_lines: Vec<i64>,
    pub pending_call_site: OptU64,
    pub frame_allocas: Vec<i64>,
    pub region_stack: Vec<str>,
    pub unsafe_depth: i64,
    pub cur: i64,
    pub top: i64,
}

/// 1 when tasks interleave, 2 when each runs to its end at its start.
fn itask_mode() -> i64 {
    if g_itask_mode == 0 {
        g_itask_mode = 2;
        if g_rr_mode == 0 {
            // p_co_stack by name: -1 from a runtime that has no such thing
            var ctl: str = "__p_co_stack";
            var r: i64 = p_thread_spawn(ctl, 1, ITASK_STACK);
            if r >= 0 {
                g_itask_mode = 1;
                g_itask_budget = 0;
            }
            if r == -1 {
                var b: i64 = itask_old_stack() - ITASK_MARGIN;
                if b >= ITASK_MIN_BUDGET {
                    g_itask_mode = 1;
                    g_itask_budget = b;
                }
            }
        }
    }
    return g_itask_mode;
}

/// A task's stack in a C runtime older than p_co_stack.
fn itask_old_stack() -> i64 {
    match env_var("OS") {
        Option::Some(os) => {
            if os == "Windows_NT" {
                return ITASK_OLD_STACK_WIN;
            }
        }
        Option::None => {
        }
    }
    return ITASK_OLD_STACK;
}

/// The address of a local of this call: how deep the host stack is here.
fn itask_stack_here() -> i64 {
    var probe: i64 = 0;
    var at: i64 = 0;
    unsafe {
        at = (&mut probe) as * mut i64 as i64;
    }
    return at + probe;
}

/// In a task with a stack budget: a panic message once its calls have
/// taken more of the stack than that, else "".
pub fn Interpreter_itask_stack_check(self: &Interpreter, fname: str) -> str {
    if g_itask_top == 0 || g_itask_budget == 0 {
        return "";
    }
    var used: i64 = g_itask_top - itask_stack_here();
    if used <= g_itask_budget {
        return "";
    }
    return "Task stack exhausted in function '" + fname + "' (" + int_to_str(used / 1024) + " KB of " + int_to_str((g_itask_budget + ITASK_MARGIN) / 1024) + " KB, " + int_to_str(self.call_stack.len()) + " calls deep): this fid's runtime gives a task a small stack; a fid built by itself gives each task one as deep as main's";
}

/// The future of task `idx`: tagged as the C runtime tags a task's.
fn itask_handle(idx: i64) -> i64 {
    return (ITASK_TAG << 48) | (idx + 1);
}

/// The running call chain's state, taken out (the interpreter is left with
/// a fresh one).
pub fn Interpreter_ctx_take(self: &mut Interpreter) -> InterpCtx {
    var c: InterpCtx = InterpCtx {
        func_name: self.current_func_name, wrapping: self.cur_wrapping, call_stack: self.call_stack, call_site_lines: self.call_site_lines, pending_call_site: self.pending_call_site, frame_allocas: self.frame_allocas, region_stack: self.region_stack, unsafe_depth: self.interp_unsafe_depth, cur: self.itask_cur, top: g_itask_top
    };
    g_itask_top = 0;
    self.current_func_name = "";
    self.cur_wrapping = false;
    self.call_stack = Vec::new();
    self.call_site_lines = Vec::new();
    self.pending_call_site = OptU64::None;
    self.frame_allocas = Vec::new();
    self.region_stack = Vec::new();
    self.interp_unsafe_depth = 0;
    self.itask_cur = -1;
    return c;
}

/// Put back what Interpreter_ctx_take took.
pub fn Interpreter_ctx_put(self: &mut Interpreter, c: InterpCtx) {
    self.current_func_name = c.func_name;
    self.cur_wrapping = c.wrapping;
    self.call_stack = c.call_stack;
    self.call_site_lines = c.call_site_lines;
    self.pending_call_site = c.pending_call_site;
    self.frame_allocas = c.frame_allocas;
    self.region_stack = c.region_stack;
    self.interp_unsafe_depth = c.unsafe_depth;
    self.itask_cur = c.cur;
    g_itask_top = c.top;
}

/// A call into the C runtime's scheduler, which runs other tasks
/// meanwhile: `op` 0 yields, 1 sleeps `a` ms, 2 runs every task to its
/// end, 3 waits for socket `a` (`b` 0 read, 1 write) at most `c` ms.
pub fn Interpreter_host_switch(self: &mut Interpreter, op: i64, a: i64, b: i64, c: i64) -> i64 {
    // main's sleep and run make at least one pass of the scheduler, which
    // drops every ended task from its list: the ended tasks set aside
    // before it may be detached after it
    val from_main: bool = self.itask_cur < 0 && (op == 1 || op == 2);
    val before: i64 = g_itask_detach_later.len();
    var saved: InterpCtx = Interpreter_ctx_take(self);
    var r: i64 = 0;
    if op == 0 {
        p_co_yield();
    }
    if op == 1 {
        r = p_co_sleep(a);
    }
    if op == 2 {
        r = p_co_run();
    }
    if op == 3 {
        r = p_co_wait_fd(a, b, c);
    }
    Interpreter_ctx_put(self, saved);
    if from_main && before > 0 {
        itask_detach_flush(before);
    }
    return r;
}

/// LG11: the C runtime blocks of tasks that ended inside p_co_async (they
/// never waited), detached once a pass of the scheduler has dropped them
/// from its task list (Interpreter_itask_launch).
var g_itask_detach_later: Vec<i64> = Vec::new();

/// Detach the first `n` blocks set aside; the rest stay for the next pass.
fn itask_detach_flush(n: i64) {
    var rest: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < g_itask_detach_later.len() {
        if i < n {
            p_co_detach(g_itask_detach_later.get(i));
        } else {
            rest.push(g_itask_detach_later.get(i));
        }
        i = i + 1;
    }
    g_itask_detach_later = rest;
}

/// One turn of a wait that has to wait: the others run. The first turns
/// hand over at once (main, which is no task, runs one round of them);
/// later ones sleep a millisecond, so a long wait does not spin.
pub fn Interpreter_itask_wait_turn(self: &mut Interpreter, spins: i64) {
    if spins >= 16 {
        Interpreter_host_switch(self, 1, 1, 0, 0);
        return;
    }
    if self.itask_cur >= 0 {
        Interpreter_host_switch(self, 0, 0, 0, 0);
    } else {
        Interpreter_host_switch(self, 1, 0, 0, 0);
    }
}

/// Whether a task other than the running one may still run (so waiting
/// for it is not waiting forever).
pub fn Interpreter_itask_others(self: &Interpreter) -> bool {
    if g_itask_mode != 1 {
        return false;
    }
    var own: i64 = 0;
    if self.itask_cur >= 0 {
        own = 1;
    }
    return self.itask_open - own > 0;
}

/// A new task of `func` with `targs`; not started.
pub fn Interpreter_itask_new(self: &mut Interpreter, func: str, targs: Vec<Value>, what: str) -> i64 {
    self.itasks.push(ITask {
        func: func, args: targs, what: what, started: false, done: false, result: Value::Int(0), token: 0
    });
    return self.itasks.len() - 1;
}

/// Make task `idx` run: when tasks interleave on a stack of its own
/// (`now`: entered at once until it first waits, else at the next switch),
/// else to its end here and now.
pub fn Interpreter_itask_start(self: &mut Interpreter, idx: i64, now: bool) {
    if itask_mode() == 1 {
        if self.itask_live < ITASK_LIVE_MAX {
            self.itask_open = self.itask_open + 1;
            Interpreter_itask_launch(self, idx, now);
            return;
        }
        if !now {
            self.itask_open = self.itask_open + 1;
            self.itask_pending.push(idx);
            return;
        }
    }
    Interpreter_itask_run_here(self, idx);
}

/// Start task `idx` on a C runtime task of its own.
fn Interpreter_itask_launch(self: &mut Interpreter, idx: i64, now: bool) {
    var t: ITask = self.itasks.get(idx);
    t.started = true;
    self.itasks.set(idx, t);
    self.itask_live = self.itask_live + 1;
    unsafe {
        g_itask_interp = self as * mut Interpreter as i64;
    }
    // a name held in a variable: the checker's task lint (CA10) would
    // otherwise walk the whole interpreter as task code
    var entry: str = "interp_task_entry";
    if now {
        var saved: InterpCtx = Interpreter_ctx_take(self);
        var h: i64 = p_co_async(entry, 1, idx);
        Interpreter_ctx_put(self, saved);
        // its result is kept in self.itasks: the runtime frees its block
        // when it ends. A task that already ended (it never waited) is
        // still in the runtime's task list until the scheduler's next
        // pass drops it, and p_co_detach frees an ended task's block at
        // once: the pass then read freed memory (test_lowering_async_method:
        // fid exited 127 at the second await). It is detached after main's
        // next pass instead (itask_detach_flush).
        val ch: i64 = h & ITASK_LOW48;
        if p_co_done(ch) != 0 {
            g_itask_detach_later.push(ch);
        } else {
            p_co_detach(ch);
        }
    } else {
        var h2: i64 = p_co_go(entry, idx);
        p_co_detach(h2);
    }
}

/// Run task `idx` to its end on this call stack (tasks do not interleave,
/// or too many have a stack).
fn Interpreter_itask_run_here(self: &mut Interpreter, idx: i64) {
    var t: ITask = self.itasks.get(idx);
    t.started = true;
    self.itasks.set(idx, t);
    // CA8: the task starts with an empty token slot, here on the caller's
    // stack too; the caller's comes back after it
    var outer_tok: i64 = Interpreter_tok_set(self, 0);
    var rv: Value = Interpreter_run_eager(self, t.func, t.args, t.what);
    Interpreter_tok_set(self, outer_tok);
    var t2: ITask = self.itasks.get(idx);
    t2.done = true;
    t2.result = rv;
    self.itasks.set(idx, t2);
}

/// The C runtime task of interpreted task `idx`.
fn interp_task_entry(idx: i64) -> i64 {
    unsafe {
        var p: *mut Interpreter = g_itask_interp;
        Interpreter_itask_body(&mut * p, idx);
    }
    return 0;
}

/// Task `idx` from its start to its end, then the next one waiting for a
/// stack starts.
pub fn Interpreter_itask_body(self: &mut Interpreter, idx: i64) {
    // the chain that ran before set its state aside: this one starts afresh
    var _before: InterpCtx = Interpreter_ctx_take(self);
    self.itask_cur = idx;
    // where this task's stack starts, for Interpreter_itask_stack_check
    g_itask_top = itask_stack_here();
    var t: ITask = self.itasks.get(idx);
    var rv: Value = Interpreter_run_eager(self, t.func, t.args, t.what);
    var t2: ITask = self.itasks.get(idx);
    t2.done = true;
    t2.result = rv;
    self.itasks.set(idx, t2);
    self.itask_cur = -1;
    g_itask_top = 0;
    self.itask_live = self.itask_live - 1;
    self.itask_open = self.itask_open - 1;
    if self.itask_pending_at < self.itask_pending.len() {
        var nx: i64 = self.itask_pending.get(self.itask_pending_at);
        self.itask_pending_at = self.itask_pending_at + 1;
        if self.itask_pending_at == self.itask_pending.len() {
            self.itask_pending = Vec::new();
            self.itask_pending_at = 0;
        }
        // counted in itask_open when it was queued
        Interpreter_itask_launch(self, nx, false);
    }
}

/// The task a handle names, or -1: a tagged future (p_co_async,
/// p_thread_spawn) or, unless `tagged_only`, a p_co_go handle.
pub fn Interpreter_itask_of(self: &Interpreter, v: Value, tagged_only: bool) -> i64 {
    var n: i64 = 0;
    match v {
        Value::Int(x) => {
            n = x;
        }
        Value::Ptr(x) => {
            n = x;
        }
        _ => {
            return -1;
        }
    }
    if (n >> 48) == ITASK_TAG {
        n = n & ITASK_LOW48;
    } else {
        if tagged_only {
            return -1;
        }
    }
    var idx: i64 = n - 1;
    if idx < 0 || idx >= self.itasks.len() {
        return -1;
    }
    return idx;
}

/// Wait until task `idx` has ended (the others run meanwhile); its result.
pub fn Interpreter_itask_await(self: &mut Interpreter, idx: i64) -> Value {
    var spins: i64 = 0;
    // CA7: a token in the slot stops the wait once cancelled (result 0)
    val jtok: i64 = Interpreter_tok_get(self);
    while !self.itasks.get(idx).done && idx != self.itask_cur {
        if !Interpreter_itask_others(self) {
            break;
        }
        if jtok != 0 && Interpreter_tok_cancelled(self, jtok) {
            return Value::Int(0);
        }
        Interpreter_itask_wait_turn(self, spins);
        spins = spins + 1;
    }
    return self.itasks.get(idx).result;
}

// --- CA7/CA8: the token slot and waits that respect it -------------------
// A timeout block's token (lower.fd Lowerer_to_enter) is three words in
// shared memory (p_atomic_*): [cancelled][deadline on p_clock_mono_ms's
// clock (interp_mono_ms), 0 none][the token the slot held before]. The slot is the running
// task's ITask.token, else g_itask_tok_outside. The waits (p_co_sleep,
// await, a channel receive, p_co_wait_fd) look at the slot's token and at
// the ones it replaced, at least every 10 ms, and give up once one is
// cancelled or past its deadline, as the C and native runtimes do.

/// C6: the clock of the interpreted program's deadlines (p_clock_mono_ms).
/// The interpreter is compiled by the previous stage, whose runtime may
/// not have p_clock_mono_ms yet, so this reads the host's wall clock: the
/// compiled program's deadlines are monotonic, the interpreted ones move
/// with a change of the wall clock (only the interpreter's own reads are
/// on this clock, so they agree with each other).
fn interp_mono_ms() -> i64 {
    return p_clock_now_ms();
}

/// The token slot of the code outside tasks.
var g_itask_tok_outside: i64 = 0;

/// The token in the running task's slot (p_task_token), 0 if none.
pub fn Interpreter_tok_get(self: &Interpreter) -> i64 {
    if self.itask_cur >= 0 && self.itask_cur < self.itasks.len() {
        return self.itasks.get(self.itask_cur).token;
    }
    return g_itask_tok_outside;
}

/// Put `tok` in the running task's slot (p_task_set_token); the one it held.
pub fn Interpreter_tok_set(self: &mut Interpreter, tok: i64) -> i64 {
    if self.itask_cur >= 0 && self.itask_cur < self.itasks.len() {
        var task: ITask = self.itasks.get(self.itask_cur);
        val old: i64 = task.token;
        task.token = tok;
        self.itasks.set(self.itask_cur, task);
        return old;
    }
    val old2: i64 = g_itask_tok_outside;
    g_itask_tok_outside = tok;
    return old2;
}

/// Whether `tok`, or a token it replaced, is cancelled or past its
/// deadline (a token past its deadline is marked cancelled).
pub fn Interpreter_tok_cancelled(self: &mut Interpreter, tok: i64) -> bool {
    var t: i64 = tok;
    var depth: i64 = 0;
    while t != 0 && depth < 64 {
        if Interpreter_shared_get(self, t) != 0 {
            return true;
        }
        val dl: i64 = Interpreter_shared_get(self, t + 8);
        if dl != 0 && interp_mono_ms() >= dl {
            I64Table_set(&mut self.shared_mem, t, Value::Int(1));
            return true;
        }
        t = Interpreter_shared_get(self, t + 16);
        depth = depth + 1;
    }
    return false;
}

/// The next slice of a wait of `left` ms (-1: no limit) under `tok`: 10 ms
/// at most, and no later than the first deadline of its chain.
pub fn Interpreter_tok_slice(self: &Interpreter, tok: i64, left: i64) -> i64 {
    var s: i64 = 10;
    if left >= 0 && left < s {
        s = left;
    }
    val now: i64 = interp_mono_ms();
    var t: i64 = tok;
    var depth: i64 = 0;
    while t != 0 && depth < 64 {
        val dl: i64 = Interpreter_shared_get(self, t + 8);
        if dl != 0 {
            var r: i64 = 0;
            if dl > now {
                r = dl - now;
            }
            if r < s {
                s = r;
            }
        }
        t = Interpreter_shared_get(self, t + 16);
        depth = depth + 1;
    }
    return s;
}

/// Whether a receive on channel `ch` has to wait: it is empty and open,
/// and someone may still send -- another task, or main when a task waits
/// (main runs again once the tasks let it).
pub fn Interpreter_chan_must_wait(self: &Interpreter, ch: i64) -> bool {
    if ch < 1 || ch > self.chans.len() {
        return false;
    }
    var cs: ChanState = self.chans.get(ch - 1);
    if cs.closed || cs.head < cs.buf.len() {
        return false;
    }
    if g_itask_mode == 1 && self.itask_cur >= 0 {
        return true;
    }
    return Interpreter_itask_others(self);
}

/// The task builtins (LG11); Jump(-99) when `name` is none of them.
pub fn Interpreter_itask_builtin(self: &mut Interpreter, name: str, args: &mut Vec<Value>) -> ExecOutcome {
    if name == "p_co_go" {
        // 2g.60: a task of a function the program does not have is a
        // panic, as in the C runtime (__p_co_new), not a message and status 0
        var co_fn: str = Interpreter_value_to_string(self, arg_value(args, 0));
        match Interpreter_get_function(self, co_fn) {
            OptIrFunction::Some(_) => {
            }
            OptIrFunction::None => {
                return ExecOutcome::Panic("task: no such function '" + co_fn + "'");
            }
        }
        var go_args: Vec<Value> = Vec::new();
        go_args.push(arg_value(args, 1));
        var gi: i64 = Interpreter_itask_new(self, co_fn, go_args, "task");
        Interpreter_itask_start(self, gi, false);
        return ExecOutcome::Value(Value::Int(gi + 1));
    }
    if name == "p_co_async" || name == "p_thread_spawn" {
        var fname: str = Interpreter_value_to_string(self, arg_value(args, 0));
        if fname == "__p_co_stack" {
            // the C runtime's p_co_stack by name: an interpreted task
            // already has a stack as deep as main's
            return ExecOutcome::Value(Value::Int(0));
        }
        var nargs: i64 = arg_int(args, 1, 0);
        var targs: Vec<Value> = Vec::new();
        var ai: i64 = 2;
        while ai < args.len() && ai < 2 + nargs {
            targs.push(args.get(ai));
            ai = ai + 1;
        }
        var what: str = "Thread";
        if name == "p_co_async" {
            what = "task";
        }
        var ti: i64 = Interpreter_itask_new(self, fname, targs, what);
        Interpreter_itask_start(self, ti, true);
        return ExecOutcome::Value(Value::Int(itask_handle(ti)));
    }
    if name == "p_future_poll" || name == "p_task_poll" || name == "p_executor_block_on" || name == "p_thread_join" {
        var pa: i64 = 0;
        if name == "p_executor_block_on" {
            pa = 1;
        }
        var fi: i64 = Interpreter_itask_of(self, arg_value(args, pa), true);
        if fi < 0 {
            if name == "p_thread_join" {
                return ExecOutcome::Value(Value::Void);
            }
            return ExecOutcome::Jump(-99);
        }
        var fv: Value = Interpreter_itask_await(self, fi);
        if name == "p_thread_join" {
            return ExecOutcome::Value(Value::Void);
        }
        return ExecOutcome::Value(fv);
    }
    if name == "p_task_poll_nonblocking" || name == "p_task_is_ready" {
        var ni: i64 = Interpreter_itask_of(self, arg_value(args, 0), true);
        if ni < 0 {
            return ExecOutcome::Jump(-99);
        }
        // not done yet: a poll is a checkpoint, the others get a turn
        if !self.itasks.get(ni).done && Interpreter_itask_others(self) {
            Interpreter_itask_wait_turn(self, 0);
        }
        var ready: bool = self.itasks.get(ni).done;
        if name == "p_task_is_ready" {
            return ExecOutcome::Value(Value::Bool(ready));
        }
        if !ready {
            return ExecOutcome::Value(Value::Int(0 - 9223372036854775807));
        }
        return ExecOutcome::Value(self.itasks.get(ni).result);
    }
    if name == "p_co_done" || name == "p_co_result" {
        var di: i64 = Interpreter_itask_of(self, arg_value(args, 0), false);
        if name == "p_co_done" {
            if di < 0 || self.itasks.get(di).done {
                return ExecOutcome::Value(Value::Int(1));
            }
            return ExecOutcome::Value(Value::Int(0));
        }
        if di < 0 {
            return ExecOutcome::Value(Value::Int(0));
        }
        return ExecOutcome::Value(self.itasks.get(di).result);
    }
    if name == "p_co_detach" {
        // the result stays in self.itasks; the runtime's block was let go
        // when the task started
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_co_yield" {
        if itask_mode() == 1 {
            Interpreter_host_switch(self, 0, 0, 0, 0);
        }
        return ExecOutcome::Value(Value::Void);
    }
    // CA7/CA8: the running task's token slot (a timeout block's token);
    // never the host runtime's, which belongs to the interpreter itself
    if name == "p_task_token" {
        return ExecOutcome::Value(Value::Int(Interpreter_tok_get(self)));
    }
    if name == "p_task_set_token" {
        return ExecOutcome::Value(Value::Int(Interpreter_tok_set(self, arg_int(args, 0, 0))));
    }
    if name == "p_co_sleep" {
        // CA7: with a token in the slot, sleep in slices and stop (1) once
        // it is cancelled
        val stok: i64 = Interpreter_tok_get(self);
        if stok != 0 {
            if Interpreter_tok_cancelled(self, stok) {
                return ExecOutcome::Value(Value::Int(1));
            }
            if itask_mode() == 1 {
                val send: i64 = interp_mono_ms() + arg_int(args, 0, 0);
                while true {
                    val sleft: i64 = send - interp_mono_ms();
                    if sleft <= 0 {
                        return ExecOutcome::Value(Value::Int(0));
                    }
                    Interpreter_host_switch(self, 1, Interpreter_tok_slice(self, stok, sleft), 0, 0);
                    if Interpreter_tok_cancelled(self, stok) {
                        return ExecOutcome::Value(Value::Int(1));
                    }
                }
            }
            return ExecOutcome::Value(Value::Int(0));
        }
        // where tasks run to their end at their start, a sleep would only
        // delay the program: it returns at once, as before LG11
        if itask_mode() == 1 {
            Interpreter_host_switch(self, 1, arg_int(args, 0, 0), 0, 0);
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_co_wait_fd" {
        // the interpreter's sockets are simulated and always ready: the
        // wait is a checkpoint, the others get a turn
        if itask_mode() == 1 {
            Interpreter_host_switch(self, 0, 0, 0, 0);
        }
        // CA7: a cancelled token in the slot: not ready
        val ftok: i64 = Interpreter_tok_get(self);
        if ftok != 0 && Interpreter_tok_cancelled(self, ftok) {
            return ExecOutcome::Value(Value::Int(0));
        }
        return ExecOutcome::Value(Value::Int(1));
    }
    if name == "p_co_run" {
        if itask_mode() == 1 {
            // main runs the scheduler; a task waits its turns instead (the
            // C runtime's p_co_run is the scheduler's own loop)
            if self.itask_cur < 0 {
                Interpreter_host_switch(self, 2, 0, 0, 0);
            }
            var rspins: i64 = 0;
            while Interpreter_itask_others(self) {
                Interpreter_itask_wait_turn(self, rspins);
                rspins = rspins + 1;
            }
        }
        return ExecOutcome::Value(Value::Int(self.itasks.len()));
    }
    if name == "p_co_stack" {
        // an interpreted task already has a stack as deep as main's
        return ExecOutcome::Value(Value::Int(0));
    }
    return ExecOutcome::Jump(-99);
}

pub fn Interpreter_call_runtime2(self: &mut Interpreter, name: str, args: &mut Vec<Value>) -> ExecOutcome {
    // LG11: tasks, their futures and the waits that switch between them
    if str_starts_with(name, "p_co_") || name == "p_thread_spawn" || name == "p_thread_join" || name == "p_future_poll" || str_starts_with(name, "p_task_") || name == "p_executor_block_on" {
        var tout: ExecOutcome = Interpreter_itask_builtin(self, name, args);
        if !outcome_is_unhandled(tout) {
            return tout;
        }
    }
    // ─── Futures / threads / executors (eager, as src/interp.rs) ───
    if name == "p_future_ready" {
        var fidx: i64 = self.future_values.len();
        self.future_values.push(arg_value(args, 0));
        self.future_exec.push(-1);
        return ExecOutcome::Value(Value::Int(fidx));
    }
    if name == "p_future_poll" || name == "p_task_poll" || name == "p_task_poll_nonblocking" || name == "p_executor_block_on" {
        var ai: i64 = 0;
        if name == "p_executor_block_on" {
            ai = 1;
        }
        var idx: i64 = -1;
        var ok: bool = false;
        if ai < args.len() {
            match args.get(ai) {
                Value::Int(n) => {
                    idx = n;
                    ok = true;
                }
                _ => {
                }
            }
        }
        if !ok {
            return ExecOutcome::Panic("Future poll: not a Future value");
        }
        if idx < 0 || idx >= self.future_values.len() {
            return ExecOutcome::Panic("Future poll: invalid handle " + int_to_str(idx));
        }
        return ExecOutcome::Value(self.future_values.get(idx));
    }
    if name == "p_thread_spawn" || name == "p_executor_spawn" {
        var base: i64 = 0;
        var exec_idx: i64 = -1;
        if name == "p_executor_spawn" {
            base = 1;
            exec_idx = arg_int(args, 0, 0);
        }
        var func_name: str = Interpreter_value_to_string(self, arg_value(args, base));
        var num_args: i64 = arg_int(args, base + 1, 0);
        var targs: Vec<Value> = Vec::new();
        var tai: i64 = base + 2;
        while tai < args.len() && tai < base + 2 + num_args {
            targs.push(args.get(tai));
            tai = tai + 1;
        }
        var what: str = "Thread";
        if name == "p_executor_spawn" {
            what = "Executor";
        }
        var res: Value = Interpreter_run_eager(self, func_name, targs, what);
        var fidx2: i64 = self.future_values.len();
        self.future_values.push(res);
        if exec_idx >= 0 && exec_idx < self.executor_count {
            self.future_exec.push(exec_idx);
        } else {
            self.future_exec.push(-1);
        }
        return ExecOutcome::Value(Value::Int(fidx2));
    }
    if name == "p_thread_join" {
        return ExecOutcome::Value(Value::Void);
    }
    // p_co_go, p_co_async, p_co_yield/sleep/run/wait_fd/done/result/detach
    // and p_thread_spawn: Interpreter_itask_builtin (LG11, tasks interleave)
    if name == "p_executor_new" {
        var eidx: i64 = self.executor_count;
        self.executor_count = self.executor_count + 1;
        return ExecOutcome::Value(Value::Int(eidx));
    }
    if name == "p_task_is_ready" {
        var tidx: i64 = -1;
        match arg_value(args, 0) {
            Value::Int(n) => {
                tidx = n;
            }
            _ => {
                return ExecOutcome::Value(Value::Bool(false));
            }
        }
        return ExecOutcome::Value(Value::Bool(tidx >= 0 && tidx < self.future_values.len()));
    }
    if name == "p_executor_run_all" {
        var ex: i64 = arg_int(args, 0, 0);
        if ex < 0 || ex >= self.executor_count {
            return ExecOutcome::Value(Value::Int(0));
        }
        var cnt: i64 = 0;
        var fi: i64 = 0;
        while fi < self.future_exec.len() {
            if self.future_exec.get(fi) == ex {
                cnt = cnt + 1;
            }
            fi = fi + 1;
        }
        return ExecOutcome::Value(Value::Int(cnt));
    }
    if name == "p_executor_cancel" || name == "p_executor_poll_all" {
        // Every task ran eagerly: nothing pending, nothing to cancel
        return ExecOutcome::Value(Value::Int(0));
    }
    // ─── Simulated async IO: the futures resolve to the thread's result ───
    if name == "p_net_connect" {
        var cfi: i64 = self.future_values.len();
        self.future_values.push(Value::Int(arg_int(args, 1, 0) + 0x10000));
        self.future_exec.push(-1);
        return ExecOutcome::Value(Value::Int(cfi));
    }
    if name == "p_net_read" {
        var rlen: i64 = arg_int(args, 2, 0);
        if rlen > 13 {
            rlen = 13;
        }
        var rfi: i64 = self.future_values.len();
        self.future_values.push(Value::Int(rlen));
        self.future_exec.push(-1);
        return ExecOutcome::Value(Value::Int(rfi));
    }
    if name == "p_net_write" {
        var wfi: i64 = self.future_values.len();
        self.future_values.push(Value::Int(arg_int(args, 2, 0)));
        self.future_exec.push(-1);
        return ExecOutcome::Value(Value::Int(wfi));
    }
    if name == "p_fs_read_async" {
        var fpath: str = Interpreter_value_to_string(self, arg_value(args, 0));
        var flen: i64 = arg_int(args, 2, 1024);
        var fsz: i64 = 0;
        if p_file_exists(fpath) != 0 {
            fsz = p_file_size(fpath);
        }
        if fsz < 0 {
            fsz = 0;
        }
        if fsz > flen {
            fsz = flen;
        }
        var ffi: i64 = self.future_values.len();
        self.future_values.push(Value::Int(fsz));
        self.future_exec.push(-1);
        return ExecOutcome::Value(Value::Int(ffi));
    }
    if name == "p_net_close" {
        return ExecOutcome::Continue;
    }

    // ─── Shared memory, atomics, Rc, mutexes, TLS ───
    if name == "p_shared_alloc" {
        var saddr: i64 = self.next_shared_addr;
        // CA7: room for every word asked for (a cancellation token is two
        // or three words; 8 bytes each time made the next block overlap it)
        var swords: i64 = (arg_int(args, 0, 8) + 7) / 8;
        if swords < 1 {
            swords = 1;
        }
        self.next_shared_addr = self.next_shared_addr + swords * 8;
        I64Table_set(&mut self.shared_mem, saddr, Value::Int(0));
        I64Table_set(&mut self.memory.blocks, saddr, Value::Int(1));
        return ExecOutcome::Value(Value::Int(saddr));
    }
    // The address may be a p_malloc block (Value::Ptr: stdlib/http2's job
    // slots) and the word a pointer or a string (`resp as i64`): before,
    // arg_int read both as 0, so every slot was address 0 and every word
    // stored 0 (test_http2_tasks: the handlers' responses came back empty)
    if name == "p_atomic_load" {
        return ExecOutcome::Value(Value::Int(Interpreter_shared_get(self, arg_int_or_ptr(args, 0))));
    }
    if name == "p_atomic_store" {
        var st_word: i64 = 0;
        if args.len() > 1 {
            st_word = Interpreter_value_word(self, args.get(1));
        }
        I64Table_set(&mut self.shared_mem, arg_int_or_ptr(args, 0), Value::Int(st_word));
        return ExecOutcome::Continue;
    }
    if name == "p_atomic_cas" {
        var caddr: i64 = arg_int_or_ptr(args, 0);
        var cur: i64 = Interpreter_shared_get(self, caddr);
        var cas_old: i64 = 0;
        var cas_new: i64 = 0;
        if args.len() > 2 {
            cas_old = Interpreter_value_word(self, args.get(1));
            cas_new = Interpreter_value_word(self, args.get(2));
        }
        if cur == cas_old {
            I64Table_set(&mut self.shared_mem, caddr, Value::Int(cas_new));
            return ExecOutcome::Value(Value::Bool(true));
        }
        return ExecOutcome::Value(Value::Bool(false));
    }
    if name == "p_atomic_add" || name == "p_atomic_sub" {
        var aaddr: i64 = arg_int_or_ptr(args, 0);
        var old: i64 = Interpreter_shared_get(self, aaddr);
        var delta: i64 = arg_int(args, 1, 0);
        if name == "p_atomic_add" {
            I64Table_set(&mut self.shared_mem, aaddr, Value::Int(old + delta));
        } else {
            I64Table_set(&mut self.shared_mem, aaddr, Value::Int(old - delta));
        }
        return ExecOutcome::Value(Value::Int(old));
    }
    if name == "p_rc_incr" {
        var rca: i64 = arg_int_or_ptr(args, 0);
        var rcv: i64 = arg_int_or_ptr(args, 1);
        Memory_store_i64(&mut self.memory, rca, Memory_load_i64(&self.memory, rca) + 1);
        return ExecOutcome::Value(Value::Int(rcv));
    }
    if name == "p_rc_decr" {
        var rcd: i64 = arg_int_or_ptr(args, 0);
        Memory_store_i64(&mut self.memory, rcd, Memory_load_i64(&self.memory, rcd) - 1);
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_mutex_init" {
        var mh: i64 = self.next_mutex_handle;
        self.next_mutex_handle = self.next_mutex_handle + 1;
        I64Table_set(&mut self.shared_mem, mh, Value::Int(0));
        return ExecOutcome::Value(Value::Int(mh));
    }
    if name == "p_mutex_lock" {
        I64Table_set(&mut self.shared_mem, arg_int(args, 0, 0), Value::Int(1));
        return ExecOutcome::Continue;
    }
    if name == "p_mutex_unlock" {
        I64Table_set(&mut self.shared_mem, arg_int(args, 0, 0), Value::Int(0));
        return ExecOutcome::Continue;
    }
    if name == "p_tls_create" {
        var tk: i64 = self.next_tls_key;
        self.next_tls_key = self.next_tls_key + 1;
        return ExecOutcome::Value(Value::Int(tk));
    }
    if name == "p_tls_get" {
        match I64Table_get(&self.tls, arg_int(args, 0, 0)) {
            OptValue::Some(tv) => {
                return ExecOutcome::Value(tv);
            }
            OptValue::None => {
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_tls_set" {
        I64Table_set(&mut self.tls, arg_int(args, 0, 0), Value::Int(arg_int(args, 1, 0)));
        return ExecOutcome::Continue;
    }

    // ─── Channels (bounded queue; single-threaded) ───
    if name == "p_chan_create" {
        var ccap: i64 = arg_int(args, 0, 1);
        if ccap < 1 {
            ccap = 1;
        }
        self.chans.push(ChanState {
            buf: Vec::new(), head: 0, cap: ccap, closed: false
        });
        return ExecOutcome::Value(Value::Int(self.chans.len()));
    }
    if name == "p_chan_send" || name == "p_chan_recv" || name == "p_chan_try_recv" || name == "p_chan_close" || name == "p_chan_is_closed" {
        var ch: i64 = arg_int(args, 0, 0);
        var pending: i64 = 0 - 9223372036854775807;
        if ch < 1 || ch > self.chans.len() {
            if name == "p_chan_send" {
                return ExecOutcome::Value(Value::Bool(false));
            }
            if name == "p_chan_close" {
                return ExecOutcome::Continue;
            }
            if name == "p_chan_is_closed" {
                return ExecOutcome::Value(Value::Bool(true));
            }
            return ExecOutcome::Value(Value::Int(pending));
        }
        // LG11: a receive that has to wait lets the other tasks run until a
        // value comes, the channel is closed or no task is left that could
        // send; a try_recv that finds nothing gives them one turn first
        if name == "p_chan_recv" || name == "p_chan_try_recv" {
            var wspins: i64 = 0;
            // CA7: a receive that waits stops once the slot's token is
            // cancelled, with what a closed, empty channel gives
            val rtok: i64 = Interpreter_tok_get(self);
            while Interpreter_chan_must_wait(self, ch) {
                if name == "p_chan_recv" && rtok != 0 && Interpreter_tok_cancelled(self, rtok) {
                    return ExecOutcome::Value(Value::Int(pending));
                }
                Interpreter_itask_wait_turn(self, wspins);
                wspins = wspins + 1;
                if name == "p_chan_try_recv" {
                    break;
                }
            }
        }
        var cs: ChanState = self.chans.get(ch - 1);
        if name == "p_chan_send" {
            if cs.closed {
                return ExecOutcome::Value(Value::Bool(false));
            }
            cs.buf.push(arg_int(args, 1, 0));
            self.chans.set(ch - 1, cs);
            return ExecOutcome::Value(Value::Bool(true));
        }
        if name == "p_chan_close" {
            cs.closed = true;
            self.chans.set(ch - 1, cs);
            return ExecOutcome::Continue;
        }
        if name == "p_chan_is_closed" {
            return ExecOutcome::Value(Value::Bool(cs.closed));
        }
        if cs.head < cs.buf.len() {
            var cv: i64 = cs.buf.get(cs.head);
            cs.head = cs.head + 1;
            self.chans.set(ch - 1, cs);
            return ExecOutcome::Value(Value::Int(cv));
        }
        if name == "p_chan_try_recv" && cs.closed {
            return ExecOutcome::Value(Value::Int(0));
        }
        return ExecOutcome::Value(Value::Int(pending));
    }

    // ─── C library stubs ───
    if name == "abs" || name == "labs" {
        var av: i64 = arg_int(args, 0, 0);
        if av < 0 {
            av = 0 - av;
        }
        return ExecOutcome::Value(Value::Int(av));
    }
    if name == "sqrt" || name == "c_sqrt" || name == "pledge_sqrt" {
        match arg_value(args, 0) {
            Value::Float(sf) => {
                return ExecOutcome::Value(Value::Float(math_sqrt(sf)));
            }
            Value::Int(si) => {
                return ExecOutcome::Value(Value::Float(math_sqrt(si as f64)));
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "pow" || name == "c_pow" || name == "pledge_pow" {
        if arg_float_opt_ok(args, 0) && arg_float_opt_ok(args, 1) {
            return ExecOutcome::Value(Value::Float(math_pow(arg_float(args, 0), arg_float(args, 1))));
        }
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "floor" || name == "c_floor" || name == "pledge_floor" || name == "ceil" || name == "c_ceil" || name == "pledge_ceil" || name == "sin" || name == "c_sin" || name == "pledge_sin" || name == "cos" || name == "c_cos" || name == "pledge_cos" || name == "fabs" || name == "c_fabs" || name == "pledge_fabs" || name == "exp" || name == "c_exp" || name == "pledge_exp" || name == "log" || name == "c_log" || name == "pledge_log" {
        if !arg_float_opt_ok(args, 0) {
            return ExecOutcome::Value(Value::Float(0.0));
        }
        var x: f64 = arg_float(args, 0);
        if str_ends_with(name, "floor") {
            return ExecOutcome::Value(Value::Float(math_floor(x)));
        }
        if str_ends_with(name, "ceil") {
            return ExecOutcome::Value(Value::Float(math_ceil(x)));
        }
        if str_ends_with(name, "sin") {
            return ExecOutcome::Value(Value::Float(math_sin(x)));
        }
        if str_ends_with(name, "cos") {
            return ExecOutcome::Value(Value::Float(math_cos(x)));
        }
        if str_ends_with(name, "exp") {
            return ExecOutcome::Value(Value::Float(math_exp(x)));
        }
        if str_ends_with(name, "log") {
            return ExecOutcome::Value(Value::Float(math_log(x)));
        }
        return ExecOutcome::Value(Value::Float(math_fabs(x)));
    }
    if name == "strcmp" || name == "c_strcmp" {
        match arg_value(args, 0) {
            Value::Str(sa) => {
                match arg_value(args, 1) {
                    Value::Str(sb) => {
                        if sa == sb {
                            return ExecOutcome::Value(Value::Int(0));
                        }
                        if str_lt(sa, sb) {
                            return ExecOutcome::Value(Value::Int(-1));
                        }
                        return ExecOutcome::Value(Value::Int(1));
                    }
                    _ => {
                    }
                }
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "strlen" || name == "c_strlen" || name == "pledge_strlen" {
        match arg_value(args, 0) {
            Value::Str(ls) => {
                return ExecOutcome::Value(Value::Int(str_len(ls)));
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "printf" {
        match arg_value(args, 0) {
            Value::Str(ps) => {
                p_print_str(ps);
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── Dynamic loading (simulated) ───
    if name == "p_dl_open" {
        var dpath: str = Interpreter_value_to_string(self, arg_value(args, 0));
        if str_len(dpath) == 0 {
            return ExecOutcome::Value(Value::Int(0));
        }
        var dh: i64 = self.next_dl_handle;
        self.next_dl_handle = self.next_dl_handle + 1;
        I64Table_set(&mut self.dl_handles, dh, Value::Str(dpath));
        return ExecOutcome::Value(Value::Int(dh));
    }
    if name == "p_dl_sym" {
        var dsh: i64 = arg_int(args, 0, 0);
        var sym: str = Interpreter_value_to_string(self, arg_value(args, 1));
        if dsh == 0 || I64Table_find(&self.dl_handles, dsh) < 0 || str_len(sym) == 0 {
            return ExecOutcome::Value(Value::Int(0));
        }
        return ExecOutcome::Value(Value::Int(0x1000 + dsh * 0x100));
    }
    if name == "p_dl_close" {
        I64Table_remove(&mut self.dl_handles, arg_int(args, 0, 0));
        return ExecOutcome::Continue;
    }
    if name == "p_dl_call" {
        // roadmap L6C: an address p_dl_find gave (the host's loader) is
        // called as i64 -> i64, as on the C path; any other (p_dl_sym's
        // simulated symbols) gives the argument back
        var dcf: i64 = arg_int(args, 0, 0);
        if ip_dl_has(dcf, false) {
            return ExecOutcome::Value(Value::Int(p_dl_call(dcf, arg_int(args, 1, 0))));
        }
        return ExecOutcome::Value(Value::Int(arg_int(args, 1, 0)));
    }
    // p_dl_load/p_dl_find/p_dl_unload (roadmap L6C, the C runtime's
    // dlopen/LoadLibrary): the interpreter loads through its host's loader
    // (this compiler's own runtime: dlopen/LoadLibrary on a C or pe_ir
    // build, always 0 on a static nat_ir one). Only handles and addresses
    // the host gave are passed back to it, so a made-up number never
    // reaches dlsym or a call.
    if name == "p_dl_load" {
        var dlp: str = Interpreter_value_to_string(self, arg_value(args, 0));
        if str_len(dlp) == 0 {
            return ExecOutcome::Value(Value::Int(0));
        }
        var dlh: i64 = p_dl_load(dlp);
        // once per load: the OS counts them, p_dl_unload takes one back
        if dlh != 0 {
            g_ip_dl_libs.push(dlh);
        }
        return ExecOutcome::Value(Value::Int(dlh));
    }
    if name == "p_dl_find" {
        var dfh: i64 = arg_int(args, 0, 0);
        var dfn: str = Interpreter_value_to_string(self, arg_value(args, 1));
        if dfh == 0 || str_len(dfn) == 0 || !ip_dl_has(dfh, true) {
            return ExecOutcome::Value(Value::Int(0));
        }
        var dfa: i64 = p_dl_find(dfh, dfn);
        if dfa != 0 && !ip_dl_has(dfa, false) {
            g_ip_dl_syms.push(dfa);
            g_ip_dl_sym_lib.push(dfh);
        }
        return ExecOutcome::Value(Value::Int(dfa));
    }
    if name == "p_dl_unload" {
        var duh: i64 = arg_int(args, 0, 0);
        if duh == 0 || !ip_dl_has(duh, true) {
            return ExecOutcome::Value(Value::Int(-1));
        }
        val dur: i64 = p_dl_unload(duh);
        if dur == 0 {
            ip_dl_forget(duh);
        }
        return ExecOutcome::Value(Value::Int(dur));
    }

    // ─── ECS ───
    if name == "__ecs_create_entity" {
        self.ecs_entity_count = self.ecs_entity_count + 1;
        return ExecOutcome::Value(Value::Int(self.ecs_entity_count - 1));
    }
    if name == "__ecs_entity_count" {
        return ExecOutcome::Value(Value::Int(self.ecs_entity_count));
    }
    if name == "__ecs_has" || name == "__ecs_get" || name == "__ecs_remove" {
        var off: i64 = ecs_name_entity_ok(args);
        if off < 0 {
            if name == "__ecs_remove" {
                return ExecOutcome::Continue;
            }
            return ExecOutcome::Value(Value::Int(0));
        }
        var cname: str = arg_str_raw(args, off);
        var ent: i64 = arg_int(args, off + 1, 0);
        var ci: i64 = Interpreter_ecs_comp(self, cname);
        var comp: EcsComp = self.ecs_comps.get(ci);
        if name == "__ecs_remove" {
            I64Table_remove(&mut comp.table, ent);
            self.ecs_comps.set(ci, comp);
            return ExecOutcome::Continue;
        }
        match I64Table_get(&comp.table, ent) {
            OptValue::Some(ev) => {
                if name == "__ecs_has" {
                    return ExecOutcome::Value(Value::Int(1));
                }
                return ExecOutcome::Value(ev);
            }
            OptValue::None => {
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "__ecs_add" {
        var have_name: bool = false;
        var have_ent: bool = false;
        var have_val: bool = false;
        var an: str = "";
        var ae: i64 = 0;
        var avv: Value = Value::Int(0);
        var ei: i64 = 0;
        while ei < args.len() {
            match args.get(ei) {
                Value::Str(es) => {
                    if !have_name {
                        an = es;
                        have_name = true;
                    }
                }
                Value::Int(en) => {
                    if !have_ent && ei > 0 {
                        ae = en;
                        have_ent = true;
                    }
                }
                Value::Ptr(_) => {
                    if !have_val {
                        avv = args.get(ei);
                        have_val = true;
                    }
                }
                _ => {
                }
            }
            ei = ei + 1;
        }
        if have_name && have_ent {
            var ci2: i64 = Interpreter_ecs_comp(self, an);
            var comp2: EcsComp = self.ecs_comps.get(ci2);
            I64Table_set(&mut comp2.table, ae, avv);
            self.ecs_comps.set(ci2, comp2);
        }
        return ExecOutcome::Continue;
    }

    // ─── FFI stubs (audio, input) ───
    if name == "pledge_putchar" {
        match arg_value(args, 0) {
            Value::Int(pc) => {
                p_print_str(p_char_to_str(pc & 0xFF));
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "pledge_printf" {
        match arg_value(args, 0) {
            Value::Ptr(pa) => {
                p_print_str(Memory_load_cstr(&self.memory, pa));
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "pledge_fgets" {
        return ExecOutcome::Value(Value::Ptr(0));
    }
    if name == "pledge_getchar" || name == "pledge_fputs" || name == "pledge_fflush" || name == "pledge_audio_init" || name == "pledge_audio_load" || name == "pledge_audio_play" || name == "pledge_audio_is_playing" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "pledge_audio_shutdown" || name == "pledge_audio_stop" || name == "pledge_audio_pause" || name == "pledge_audio_resume" || name == "pledge_audio_stop_all" || name == "pledge_audio_set_volume" || name == "pledge_audio_set_loop" || name == "pledge_audio_set_pan" || name == "pledge_audio_master_volume" {
        return ExecOutcome::Continue;
    }

    // ─── JSON (over JSON text strings) ───
    if str_starts_with(name, "p_json_") {
        if args.len() == 0 {
            return ExecOutcome::Panic(str_slice(name, 2, str_len(name)) + ": missing argument");
        }
        var short: str = str_slice(name, 2, str_len(name));
        if !Interpreter_arg_str_ok(self, args.get(0)) {
            return ExecOutcome::Panic(short + ": expected string");
        }
        var text: str = Interpreter_arg_str(self, args.get(0));
        if name == "p_json_string" {
            return ExecOutcome::Value(Value::Str("\"" + json_escape_body(text) + "\""));
        }
        var jr: JsonResult = json_parse(text);
        var jv: Json = Json::Null;
        match jr {
            JsonResult::Ok(pj) => {
                jv = pj;
            }
            JsonResult::Err(e) => {
                if name == "p_json_get" {
                    return ExecOutcome::Panic("json_get: not an object");
                }
                if name == "p_json_len" {
                    return ExecOutcome::Panic("json_len: not array or object");
                }
                if name == "p_json_at" {
                    return ExecOutcome::Panic("json_at: not an array");
                }
                return ExecOutcome::Panic(short + ": " + e);
            }
        }
        if name == "p_json_parse" || name == "p_json_dump" {
            return ExecOutcome::Value(Value::Str(json_dump(jv, false)));
        }
        if name == "p_json_pretty" {
            return ExecOutcome::Value(Value::Str(json_dump(jv, true)));
        }
        if name == "p_json_type" {
            return ExecOutcome::Value(Value::Str(json_type_name(jv)));
        }
        if name == "p_json_get" {
            if args.len() < 2 {
                return ExecOutcome::Panic("json_get: missing args");
            }
            if !Interpreter_arg_str_ok(self, args.get(1)) {
                return ExecOutcome::Panic("json_get: key must be string");
            }
            var key: str = Interpreter_arg_str(self, args.get(1));
            match jv {
                Json::Obj(o) => {
                    if o.contains(key) {
                        return ExecOutcome::Value(Value::Str(json_dump(o.get(key), false)));
                    }
                    return ExecOutcome::Value(Value::Str("null"));
                }
                _ => {
                }
            }
            return ExecOutcome::Panic("json_get: not an object");
        }
        if name == "p_json_len" {
            match jv {
                Json::Arr(ja) => {
                    return ExecOutcome::Value(Value::Int(ja.len()));
                }
                Json::Obj(jo) => {
                    return ExecOutcome::Value(Value::Int(jo.len()));
                }
                _ => {
                }
            }
            return ExecOutcome::Panic("json_len: not array or object");
        }
        if name == "p_json_at" {
            var jidx: i64 = 0;
            var jidx_ok: bool = false;
            if args.len() >= 2 {
                match args.get(1) {
                    Value::Int(n) => {
                        jidx = n;
                        jidx_ok = true;
                    }
                    _ => {
                    }
                }
            }
            if !jidx_ok {
                return ExecOutcome::Panic("json_at: missing args");
            }
            match jv {
                Json::Arr(ja2) => {
                    if jidx >= 0 && jidx < ja2.len() {
                        return ExecOutcome::Value(Value::Str(json_dump(ja2.get(jidx), false)));
                    }
                    return ExecOutcome::Panic("json_at: index " + int_to_str(jidx) + " out of bounds");
                }
                _ => {
                }
            }
            return ExecOutcome::Panic("json_at: not an array");
        }
    }

    // ─── Distributed tensors (single device) ───
    if name == "p_all_reduce" || name == "p_broadcast" || name == "p_all_gather" || name == "p_scatter" {
        var th: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if th < 0 {
            return ExecOutcome::Panic(str_slice(name, 2, str_len(name)) + ": expected Tensor");
        }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_clone_data(&self.tensors.get(th))));
    }
    if name == "p_send_tensor" {
        return ExecOutcome::Continue;
    }
    if name == "p_recv_tensor" {
        match Interpreter_arg_to_vec_i64(self, arg_value(args, 0)) {
            OptVecI64::Some(rs) => {
                return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_zeros(rs)));
            }
            OptVecI64::None => {
            }
        }
        return ExecOutcome::Panic("recv_tensor: expected Vec");
    }
    if name == "p_tp_rank" {
        return ExecOutcome::Value(Value::Int(0));
    }
    // the interpreter runs one rank: nothing to start
    if name == "p_tp_init" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_tp_world_size" {
        return ExecOutcome::Value(Value::Int(1));
    }
    if name == "p_checkpoint_begin" || name == "p_checkpoint_end" {
        return ExecOutcome::Continue;
    }

    // ─── SIMD (Vec<f64> values) ───
    if name == "p_simd_add" || name == "p_simd_sub" || name == "p_simd_mul" || name == "p_simd_div" || name == "p_simd_dot" {
        var sa_opt: OptVecF64 = Interpreter_args_to_f64_vec(self, args, 0);
        var sb_opt: OptVecF64 = Interpreter_args_to_f64_vec(self, args, 1);
        match sa_opt {
            OptVecF64::Some(va) => {
                match sb_opt {
                    OptVecF64::Some(vb) => {
                        var n: i64 = va.len();
                        if vb.len() < n {
                            n = vb.len();
                        }
                        var outv: Vec<f64> = Vec::new();
                        var dot: f64 = 0.0;
                        var k: i64 = 0;
                        while k < n {
                            var x: f64 = va.get(k);
                            var y: f64 = vb.get(k);
                            if name == "p_simd_add" {
                                outv.push(x + y);
                            }
                            if name == "p_simd_sub" {
                                outv.push(x - y);
                            }
                            if name == "p_simd_mul" {
                                outv.push(x * y);
                            }
                            if name == "p_simd_div" {
                                if y != 0.0 {
                                    outv.push(x / y);
                                } else {
                                    outv.push(0.0);
                                }
                            }
                            if name == "p_simd_dot" {
                                dot = dot + x * y;
                            }
                            k = k + 1;
                        }
                        if name == "p_simd_dot" {
                            return ExecOutcome::Value(Value::Float(dot));
                        }
                        return ExecOutcome::Value(Interpreter_new_core_f64_vec(self, outv));
                    }
                    OptVecF64::None => {
                    }
                }
            }
            OptVecF64::None => {
            }
        }
        return ExecOutcome::Panic(str_slice(name, 2, str_len(name)) + ": expected Vec, Vec");
    }
    if name == "p_simd_sum" || name == "p_simd_from_vec" || name == "p_simd_scale" {
        match Interpreter_args_to_f64_vec(self, args, 0) {
            OptVecF64::Some(sv) => {
                if name == "p_simd_sum" {
                    var ssum: f64 = 0.0;
                    var si: i64 = 0;
                    while si < sv.len() {
                        ssum = ssum + sv.get(si);
                        si = si + 1;
                    }
                    return ExecOutcome::Value(Value::Float(ssum));
                }
                if name == "p_simd_from_vec" {
                    return ExecOutcome::Value(Interpreter_new_core_f64_vec(self, sv));
                }
                if arg_float_opt_ok(args, 1) {
                    var scl: f64 = arg_float(args, 1);
                    var scaled: Vec<f64> = Vec::new();
                    var sj: i64 = 0;
                    while sj < sv.len() {
                        scaled.push(sv.get(sj) * scl);
                        sj = sj + 1;
                    }
                    return ExecOutcome::Value(Interpreter_new_core_f64_vec(self, scaled));
                }
                return ExecOutcome::Panic("simd_scale: expected Vec, f64");
            }
            OptVecF64::None => {
            }
        }
        if name == "p_simd_sum" {
            return ExecOutcome::Panic("simd_sum: expected Vec");
        }
        if name == "p_simd_from_vec" {
            return ExecOutcome::Panic("simd_from_vec: expected Vec");
        }
        return ExecOutcome::Panic("simd_scale: expected Vec, f64");
    }
    if name == "p_simd_to_str" {
        match arg_value(args, 0) {
            Value::Vec(svh) => {
                var fl: Vec<f64> = Interpreter_vec_handle_f64s(self, svh, false);
                var st: str = "[";
                var sk: i64 = 0;
                while sk < fl.len() {
                    if sk > 0 {
                        st = st + ", ";
                    }
                    st = st + interp_f64_text(fl.get(sk));
                    sk = sk + 1;
                }
                return ExecOutcome::Value(Value::Str(st + "]"));
            }
            _ => {
            }
        }
        // a core Vec<f64> (the program's own, or a p_simd_* result)
        match Interpreter_args_to_f64_vec(self, args, 0) {
            OptVecF64::Some(cfl) => {
                var cst: str = "[";
                var ck: i64 = 0;
                while ck < cfl.len() {
                    if ck > 0 {
                        cst = cst + ", ";
                    }
                    cst = cst + interp_f64_text(cfl.get(ck));
                    ck = ck + 1;
                }
                return ExecOutcome::Value(Value::Str(cst + "]"));
            }
            OptVecF64::None => {
            }
        }
        return ExecOutcome::Panic("simd_to_str: expected Vec");
    }

    // ─── Sockets / HTTP (simulated) ───
    // roadmap L4B: Unix-domain sockets, simulated in this process (iux_*)
    if name == "p_unix_listen" {
        return ExecOutcome::Value(Value::Int(iux_listen(Interpreter_value_to_string(self, arg_value(args, 0)))));
    }
    if name == "p_unix_connect" {
        return ExecOutcome::Value(Value::Int(iux_connect(Interpreter_value_to_string(self, arg_value(args, 0)))));
    }
    if str_starts_with(name, "p_socket_") && iux_index(arg_int(args, 0, 0)) >= 0 {
        val ufd: i64 = arg_int(args, 0, 0);
        if name == "p_socket_accept" {
            return ExecOutcome::Value(Value::Int(iux_accept(ufd)));
        }
        if name == "p_socket_write_str" {
            return ExecOutcome::Value(Value::Int(iux_write(ufd, Interpreter_value_to_string(self, arg_value(args, 1)))));
        }
        if name == "p_socket_recv_str" {
            return ExecOutcome::Value(Value::Str(iux_recv(ufd)));
        }
        if name == "p_socket_close" {
            iux_close(ufd);
            return ExecOutcome::Continue;
        }
    }
    if name == "p_socket_write_str" {
        return ExecOutcome::Value(Value::Int(str_len(Interpreter_value_to_string(self, arg_value(args, 1)))));
    }
    if name == "p_socket_listen" {
        return ExecOutcome::Value(Value::Int(1));
    }
    if name == "p_socket_accept" {
        return ExecOutcome::Value(Value::Int(2));
    }
    if name == "p_socket_read" {
        return ExecOutcome::Value(Interpreter_new_vec_value(self, Vec::new()));
    }
    if name == "p_socket_write" {
        match arg_value(args, 1) {
            Value::Vec(wh) => {
                if wh >= 0 && wh < self.vec_values.len() {
                    return ExecOutcome::Value(Value::Int(self.vec_values.get(wh).elements.len()));
                }
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_socket_close" {
        return ExecOutcome::Continue;
    }
    if name == "p_socket_recv_str" {
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_http_parse_request" {
        if args.len() == 0 || !Interpreter_arg_str_ok(self, args.get(0)) {
            return ExecOutcome::Panic("http_parse_request: expected string");
        }
        var raw: str = Interpreter_arg_str(self, args.get(0));
        var rlen2: i64 = str_len(raw);
        var le: i64 = str_find_from(raw, "\r\n", 0);
        var req_line: str = raw;
        var pos: i64 = rlen2;
        if le >= 0 {
            req_line = str_slice(raw, 0, le);
            pos = le + 2;
        }
        // METHOD PATH VERSION (splitn(3, ' '))
        var method: str = "GET";
        var path: str = "/";
        var version_full: str = "HTTP/1.1";
        var sp1: i64 = str_find_from(req_line, " ", 0);
        if sp1 < 0 {
            method = req_line;
        } else {
            method = str_slice(req_line, 0, sp1);
            var sp2: i64 = str_find_from(req_line, " ", sp1 + 1);
            if sp2 < 0 {
                path = str_slice(req_line, sp1 + 1, str_len(req_line));
            } else {
                path = str_slice(req_line, sp1 + 1, sp2);
                version_full = str_slice(req_line, sp2 + 1, str_len(req_line));
            }
        }
        var version: str = version_full;
        if str_starts_with(version_full, "HTTP/") {
            version = str_slice(version_full, 5, str_len(version_full));
        } else {
            version = "1.1";
        }
        var headers: str = "{";
        var first_hdr: bool = true;
        var saw_blank: bool = false;
        while pos <= rlen2 && le >= 0 {
            var nle: i64 = str_find_from(raw, "\r\n", pos);
            var line: str = "";
            if nle < 0 {
                line = str_slice(raw, pos, rlen2);
            } else {
                line = str_slice(raw, pos, nle);
            }
            if str_len(line) == 0 {
                saw_blank = true;
                break;
            }
            var colon: i64 = str_find_from(line, ":", 0);
            if colon >= 0 {
                if !first_hdr {
                    headers = headers + ",";
                }
                first_hdr = false;
                headers = headers + "\"" + str_trim(str_slice(line, 0, colon)) + "\":\"" + str_trim(str_slice(line, colon + 1, str_len(line))) + "\"";
            }
            if nle < 0 {
                break;
            }
            pos = nle + 2;
        }
        headers = headers + "}";
        var body: str = "";
        if saw_blank {
            var bb: i64 = str_find_from(raw, "\r\n\r\n", 0);
            if bb >= 0 {
                var bstart: i64 = bb + 4;
                var bend: i64 = str_find_from(raw, "\r\n\r\n", bstart);
                if bend < 0 {
                    bend = rlen2;
                }
                body = str_slice(raw, bstart, bend);
            }
        }
        var js: str = "{\"method\":\"" + json_escape_body(method) + "\",\"path\":\"" + json_escape_body(path) + "\",\"version\":\"" + json_escape_body(version) + "\",\"headers\":" + headers + ",\"body\":\"" + json_escape_body(body) + "\"}";
        return ExecOutcome::Value(Value::Str(js));
    }
    if name == "p_http_build_response" {
        var status_ok: bool = false;
        var status: i64 = 0;
        if args.len() >= 3 {
            match args.get(0) {
                Value::Int(st2) => {
                    status = st2;
                    status_ok = true;
                }
                _ => {
                }
            }
        }
        if status_ok {
            var body2: str = Interpreter_arg_str(self, args.get(2));
            return ExecOutcome::Value(Value::Str("HTTP/1.1 " + int_to_str(status) + " OK\r\nContent-Length: " + int_to_str(str_len(body2)) + "\r\n\r\n" + body2));
        }
        return ExecOutcome::Value(Value::Str("HTTP/1.1 500 Internal Server Error\r\n\r\n"));
    }

    // ─── In-memory KV database ───
    if name == "p_db_mem_open" {
        var dbh: i64 = self.next_db_handle;
        self.next_db_handle = self.next_db_handle + 1;
        return ExecOutcome::Value(Value::Int(dbh));
    }
    if name == "p_db_mem_close" {
        var cdb: i64 = arg_int(args, 0, -1);
        var ri: i64 = 0;
        while ri < self.db_rows.len() {
            var row: DbRow = self.db_rows.get(ri);
            if row.db == cdb {
                row.db = -1;
                self.db_rows.set(ri, row);
            }
            ri = ri + 1;
        }
        self.closed_dbs.push(cdb);
        return ExecOutcome::Continue;
    }
    if name == "p_db_mem_query" {
        var qdb: i64 = -1;
        match arg_value(args, 0) {
            Value::Int(qh) => {
                qdb = qh;
            }
            _ => {
            }
        }
        if qdb >= 1 && qdb < self.next_db_handle && !vec_i64_contains(self.closed_dbs, qdb) {
            var qtext: str = "";
            if args.len() > 1 {
                qtext = Interpreter_value_to_string(self, args.get(1));
            }
            var at: i64 = str_find(qtext, "key=");
            if at >= 0 {
                var k: str = str_slice(qtext, at + 4, str_len(qtext));
                while str_len(k) > 0 && (str_byte_at(k, 0) == 39 || str_byte_at(k, 0) == 34) {
                    k = str_slice(k, 1, str_len(k));
                }
                var kend: i64 = 0;
                while kend < str_len(k) {
                    var kc: i64 = str_byte_at(k, kend);
                    if kc == 32 || kc == 59 || kc == 39 || kc == 34 {
                        break;
                    }
                    kend = kend + 1;
                }
                k = str_slice(k, 0, kend);
                var qi: i64 = 0;
                while qi < self.db_rows.len() {
                    var qrow: DbRow = self.db_rows.get(qi);
                    if qrow.db == qdb && qrow.key == k {
                        return ExecOutcome::Value(Value::Str(Interpreter_value_to_string(self, qrow.val)));
                    }
                    qi = qi + 1;
                }
                return ExecOutcome::Value(Value::Str(""));
            }
            var arr: str = "[";
            var first: bool = true;
            var qj: i64 = 0;
            while qj < self.db_rows.len() {
                var krow: DbRow = self.db_rows.get(qj);
                if krow.db == qdb {
                    if !first {
                        arr = arr + ",";
                    }
                    first = false;
                    arr = arr + json_escape_string(krow.key);
                }
                qj = qj + 1;
            }
            return ExecOutcome::Value(Value::Str(arr + "]"));
        }
        return ExecOutcome::Value(Value::Str("[]"));
    }
    if name == "p_db_mem_exec" {
        var edb: i64 = -1;
        match arg_value(args, 0) {
            Value::Int(eh) => {
                edb = eh;
            }
            _ => {
            }
        }
        if edb >= 0 && args.len() >= 2 {
            var q: str = Interpreter_value_to_string(self, args.get(1));
            var s1: i64 = str_find_from(q, " ", 0);
            if s1 >= 0 {
                var s2: i64 = str_find_from(q, " ", s1 + 1);
                if s2 >= 0 {
                    var verb: str = str_to_lower(str_slice(q, 0, s1));
                    var ekey: str = str_slice(q, s1 + 1, s2);
                    var evalue: str = str_slice(q, s2 + 1, str_len(q));
                    if (verb == "set" || verb == "insert") && edb >= 1 && edb < self.next_db_handle && !vec_i64_contains(self.closed_dbs, edb) {
                        var ej: i64 = 0;
                        while ej < self.db_rows.len() {
                            var erow: DbRow = self.db_rows.get(ej);
                            if erow.db == edb && erow.key == ekey {
                                erow.val = Value::Str(evalue);
                                self.db_rows.set(ej, erow);
                                return ExecOutcome::Value(Value::Int(1));
                            }
                            ej = ej + 1;
                        }
                        self.db_rows.push(DbRow {
                            db: edb, key: ekey, val: Value::Str(evalue)
                        });
                        return ExecOutcome::Value(Value::Int(1));
                    }
                }
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    // ─── SQLite stubs ───
    if name == "p_sqlite3_prepare_v2" {
        return ExecOutcome::Value(Value::Int(1));
    }
    if name == "p_sqlite3_step" {
        return ExecOutcome::Value(Value::Int(101));
    }
    if name == "p_sqlite3_column_type" {
        return ExecOutcome::Value(Value::Int(5));
    }
    if name == "p_sqlite3_column_double" {
        return ExecOutcome::Value(Value::Float(0.0));
    }
    if name == "p_sqlite3_column_name" || name == "p_sqlite3_column_text" {
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_sqlite3_errmsg" {
        return ExecOutcome::Value(Value::Str("interpreter does not support SQLite"));
    }
    if name == "p_sqlite3_free" {
        return ExecOutcome::Continue;
    }
    if str_starts_with(name, "p_sqlite3_") {
        return ExecOutcome::Value(Value::Int(0));
    }

    // ─── Bare-metal stubs ───
    if name == "p_cli" || name == "p_sti" || name == "p_lidt" || name == "p_idt_set_entry" || name == "p_hlt" || name == "p_outb" || name == "p_cr3_write" || name == "p_cr0_write" || name == "p_cr4_write" || name == "p_invlpg" || name == "p_page_map" || name == "p_page_unmap" || name == "p_phys_write64" || name == "p_lgdt" || name == "p_gdt_set_entry" || name == "p_serial_init" || name == "p_serial_write" {
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_inb" || name == "p_phys_read64" || name == "p_serial_read" || name == "p_serial_ready" {
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_cr3_read" {
        return ExecOutcome::Value(Value::Int(0x10000));
    }
    if name == "p_cr0_read" {
        return ExecOutcome::Value(Value::Int(0x80000011));
    }
    if name == "p_cr4_read" {
        return ExecOutcome::Value(Value::Int(0x20));
    }

    // ─── Allocators ───
    if name == "p_allocator_create" {
        match arg_value(args, 0) {
            Value::Str(an2) => {
                return ExecOutcome::Value(Value::Str("alloc(" + an2 + ")"));
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Str("alloc(default)"));
    }
    if name == "p_allocator_alloc" {
        match arg_value(args, 1) {
            Value::Int(asz) => {
                self.alloc_ptr = self.alloc_ptr + asz;
                return ExecOutcome::Value(Value::Ptr(self.alloc_ptr));
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Ptr(0));
    }
    if name == "p_allocator_free" {
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_allocator_stats" {
        return ExecOutcome::Value(Value::Int(0));
    }

    // io_flush, Writer.flush, BufWriter.flush on stdout: the interpreter
    // prints through this process's own stdout
    if name == "p_flush_stdout" {
        p_flush_stdout();
        return ExecOutcome::Value(Value::Void);
    }

    // ─── Environment, process ───
    if name == "p_getenv" {
        var en2: str = Interpreter_value_to_string(self, arg_value(args, 0));
        // CO2: variables the driver set for the program (`fid run
        // --trace-spans`: FIDES_TRACE=1) come before the process's own
        var eoi: i64 = 0;
        while eoi < g_interp_env_names.len() {
            if g_interp_env_names.get(eoi) == en2 {
                return ExecOutcome::Value(Value::Str(g_interp_env_vals.get(eoi)));
            }
            eoi = eoi + 1;
        }
        if str_len(en2) > 0 {
            var ev2: str = p_getenv(en2);
            var evp: i64 = ev2 + 0;
            if evp != 0 {
                return ExecOutcome::Value(Value::Str(ev2));
            }
        }
        return ExecOutcome::Value(Value::Ptr(0));
    }
    if name == "p_argc" {
        return ExecOutcome::Value(Value::Int(interp_prog_argc()));
    }
    if name == "p_argv" {
        match arg_value(args, 0) {
            Value::Int(ai2) => {
                // 2g.60: the program's own arguments (interp_set_program_args)
                var real_ai: i64 = interp_prog_argv_index(ai2);
                if real_ai >= 0 && real_ai < p_argc() {
                    return ExecOutcome::Value(Value::Str(p_argv(real_ai)));
                }
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Ptr(0));
    }
    if name == "p_system" {
        var cmd: str = Interpreter_value_to_string(self, arg_value(args, 0));
        if str_len(cmd) > 0 {
            return ExecOutcome::Value(Value::Int(p_system(cmd)));
        }
        return ExecOutcome::Value(Value::Int(-1));
    }
    if name == "p_exit" {
        p_exit(arg_int(args, 0, 0));
        return ExecOutcome::Continue;
    }
    if name == "p_regex_match" {
        var rs: str = Interpreter_value_to_string(self, arg_value(args, 0));
        var rp: str = Interpreter_value_to_string(self, arg_value(args, 1));
        return ExecOutcome::Value(Value::Bool(wildcard_match(rs, rp)));
    }
    if name == "p_f64_to_bits" {
        match arg_value(args, 0) {
            Value::Float(bf) => {
                return ExecOutcome::Value(Value::Int(p_f64_to_bits(bf)));
            }
            Value::Int(bi) => {
                return ExecOutcome::Value(Value::Int(p_f64_to_bits(bi as f64)));
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_f64_from_bits" {
        // an f64 already (a word the interpreter read back as one)
        match arg_value(args, 0) {
            Value::Float(ff) => {
                return ExecOutcome::Value(Value::Float(ff));
            }
            _ => {
            }
        }
        return ExecOutcome::Value(Value::Float(f64_from_bits_i(arg_int(args, 0, 0))));
    }
    return ExecOutcome::Jump(-99);
}

// ─── Unix-domain sockets (roadmap L4B), simulated ───────────────────────
// stdlib/unix_socket.fd's p_unix_listen / p_unix_connect under `fid run`.
// Like the interpreter's other sockets they are simulated: fid cannot name
// the runtime builtins it interprets (the compiler that builds its first
// stage has none). A listener and the streams connected to it live in this
// process: connect queues the server's end on the listener (as the
// system's backlog does), accept takes it, a write appends to the other
// end's bytes, a read takes up to 4095 of its own ("" when there are none
// or the other end is closed: no blocking). No file is made at the path
// and another process cannot connect: compiled programs use real sockets.

const IUX_BASE: i64 = 2199023255552;  // 2 << 40: a simulated socket
var g_iux_kind: Vec<i64> = Vec::new();  // 1 listener, 2 stream, 0 closed
var g_iux_path: Vec<str> = Vec::new();
var g_iux_peer: Vec<i64> = Vec::new();  // a stream's other end (index)
var g_iux_buf: Vec<str> = Vec::new();  // bytes waiting to be read
var g_iux_q_owner: Vec<i64> = Vec::new();  // pending accepts: the listener
var g_iux_q_end: Vec<i64> = Vec::new();  // and the server's end

/// The index of simulated socket fd, -1 when it is not one (or closed).
fn iux_index(fd: i64) -> i64 {
    val s: i64 = fd - IUX_BASE;
    if s < 0 || s >= g_iux_kind.len() {
        return -1;
    }
    if g_iux_kind.get(s) == 0 {
        return -1;
    }
    return s;
}

fn iux_new(kind: i64, path: str) -> i64 {
    g_iux_kind.push(kind);
    g_iux_path.push(path);
    g_iux_peer.push(-1);
    g_iux_buf.push("");
    return g_iux_kind.len() - 1;
}

/// The open listener at path, -1 when there is none.
fn iux_find_listener(path: str) -> i64 {
    var i: i64 = 0;
    while i < g_iux_kind.len() {
        if g_iux_kind.get(i) == 1 && g_iux_path.get(i) == path {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn iux_listen(path: str) -> i64 {
    if str_len(path) == 0 || str_len(path) > 103 {
        return -1;
    }
    if iux_find_listener(path) >= 0 {
        return -1;
    }
    return IUX_BASE + iux_new(1, path);
}

fn iux_connect(path: str) -> i64 {
    val l: i64 = iux_find_listener(path);
    if l < 0 {
        return -1;
    }
    val a: i64 = iux_new(2, path);
    val b: i64 = iux_new(2, path);
    g_iux_peer.set(a, b);
    g_iux_peer.set(b, a);
    g_iux_q_owner.push(l);
    g_iux_q_end.push(b);
    return IUX_BASE + a;
}

/// The first connection queued on listener fd, -1 when there is none.
fn iux_accept(fd: i64) -> i64 {
    val l: i64 = iux_index(fd);
    if l < 0 || g_iux_kind.get(l) != 1 {
        return -1;
    }
    var i: i64 = 0;
    while i < g_iux_q_owner.len() {
        if g_iux_q_owner.get(i) == l {
            val e: i64 = g_iux_q_end.get(i);
            g_iux_q_owner.set(i, -1);
            if g_iux_kind.get(e) == 2 {
                return IUX_BASE + e;
            }
        }
        i = i + 1;
    }
    return -1;
}

fn iux_write(fd: i64, data: str) -> i64 {
    val s: i64 = iux_index(fd);
    if s < 0 || g_iux_kind.get(s) != 2 {
        return -1;
    }
    val p: i64 = g_iux_peer.get(s);
    if p < 0 || g_iux_kind.get(p) != 2 {
        return -1;
    }
    g_iux_buf.set(p, g_iux_buf.get(p) + data);
    return str_len(data);
}

fn iux_recv(fd: i64) -> str {
    val s: i64 = iux_index(fd);
    if s < 0 || g_iux_kind.get(s) != 2 {
        return "";
    }
    val b: str = g_iux_buf.get(s);
    if str_len(b) <= 4095 {
        g_iux_buf.set(s, "");
        return b;
    }
    g_iux_buf.set(s, str_slice(b, 4095, str_len(b)));
    return str_slice(b, 0, 4095);
}

fn iux_close(fd: i64) {
    val s: i64 = iux_index(fd);
    if s < 0 {
        return;
    }
    if g_iux_kind.get(s) == 1 {
        // connections never accepted end with it
        var i: i64 = 0;
        while i < g_iux_q_owner.len() {
            if g_iux_q_owner.get(i) == s {
                g_iux_kind.set(g_iux_q_end.get(i), 0);
                g_iux_q_owner.set(i, -1);
            }
            i = i + 1;
        }
    }
    g_iux_kind.set(s, 0);
    g_iux_buf.set(s, "");
}

fn vec_i64_contains(v: Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn Interpreter_shared_get(self: &Interpreter, addr: i64) -> i64 {
    match I64Table_get(&self.shared_mem, addr) {
        OptValue::Some(v) => {
            match v {
                Value::Int(n) => {
                    return n;
                }
                _ => {
                }
            }
        }
        OptValue::None => {
        }
    }
    return 0;
}

pub fn Tensor_clone_data(t: &TensorData) -> TensorData {
    return Tensor_new(t.shape.clone(), t.strides.clone(), t.data.clone());
}

// ===========================================================================
// Tensor builtins with the autograd tape (src/interp.rs ML3/ML11/ML12)
// ===========================================================================

// Tape op kinds
pub fn agop_add() -> i64 {
    return 1;
}
pub fn agop_sub() -> i64 {
    return 2;
}
pub fn agop_mul() -> i64 {
    return 3;
}
pub fn agop_matmul() -> i64 {
    return 4;
}
pub fn agop_scale() -> i64 {
    return 5;
}
pub fn agop_relu() -> i64 {
    return 6;
}
pub fn agop_sigmoid() -> i64 {
    return 7;
}
pub fn agop_sum() -> i64 {
    return 8;
}
pub fn agop_mean() -> i64 {
    return 9;
}

pub struct AgEntry {
    pub result: i64,
    pub op: i64,
    pub a: i64,
    pub b: i64,
    pub s: f64,
    pub a_shape: Vec<i64>,
    pub b_shape: Vec<i64>,
    pub a_size: i64,
    pub data: Vec<f64>,
    pub has_input: bool,
    pub input: Vec<f64>,
}

fn AgEntry_new(result: i64, op: i64, a: i64, b: i64) -> AgEntry {
    return AgEntry {
        result: result, op: op, a: a, b: b, s: 0.0, a_shape: Vec::new(), b_shape: Vec::new(), a_size: 0, data: Vec::new(), has_input: false, input: Vec::new()
    };
}

fn tensor_addr_of(v: Value) -> i64 {
    match v {
        Value::Ptr(p) => {
            return p;
        }
        Value::Int(i) => {
            return i;
        }
        _ => {
        }
    }
    return 0;
}

pub fn Interpreter_record_ag(self: &mut Interpreter, e: AgEntry) {
    if self.ag_enabled {
        self.ag_tape.push(e);
    }
}

fn tensor_map_data(t: &TensorData, data: Vec<f64>) -> TensorData {
    return Tensor_new(t.shape.clone(), t.strides.clone(), data);
}

/// accum_grad: add `g` into the gradient for `addr`.
pub fn Interpreter_accum_grad(self: &mut Interpreter, keys: &mut Vec<i64>, vals: &mut Vec<TensorData>, addr: i64, g: TensorData) {
    var i: i64 = 0;
    while i < keys.len() {
        if keys.get(i) == addr {
            var ex: TensorData = vals.get(i);
            var nd: Vec<f64> = ex.data.clone();
            var j: i64 = 0;
            while j < g.data.len() {
                if j < nd.len() {
                    nd.set(j, nd.get(j) + g.data.get(j));
                }
                j = j + 1;
            }
            vals.set(i, Tensor_new(ex.shape.clone(), ex.strides.clone(), nd));
            return;
        }
        i = i + 1;
    }
    keys.push(addr);
    vals.push(Tensor_new(g.shape.clone(), g.strides.clone(), g.data.clone()));
}

fn grad_find(keys: Vec<i64>, addr: i64) -> i64 {
    var i: i64 = 0;
    while i < keys.len() {
        if keys.get(i) == addr {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn Interpreter_run_backward(self: &mut Interpreter) {
    var loss_grad: f64 = 1.0;
    var keys: Vec<i64> = Vec::new();
    var vals: Vec<TensorData> = Vec::new();
    var seed_set: bool = false;
    var n: i64 = self.ag_tape.len();
    var ti: i64 = n - 1;
    while ti >= 0 {
        var e: AgEntry = self.ag_tape.get(ti);
        if e.op == agop_sum() {
            keys.push(e.a);
            vals.push(Tensor_filled(e.a_shape.clone(), loss_grad));
            seed_set = true;
            break;
        }
        if e.op == agop_mean() {
            keys.push(e.a);
            vals.push(Tensor_filled(e.a_shape.clone(), loss_grad / (e.a_size as f64)));
            seed_set = true;
            break;
        }
        ti = ti - 1;
    }
    if !seed_set && n > 0 {
        var last: AgEntry = self.ag_tape.get(n - 1);
        if last.result != 0 {
            var one: Vec<i64> = Vec::new();
            one.push(1);
            keys.push(last.result);
            vals.push(Tensor_filled(one, loss_grad));
        }
    }
    var k: i64 = n - 1;
    while k >= 0 {
        var node: AgEntry = self.ag_tape.get(k);
        k = k - 1;
        var gi: i64 = grad_find(keys, node.result);
        if gi < 0 {
            continue;
        }
        var go: TensorData = vals.get(gi);
        var gout: TensorData = Tensor_new(go.shape.clone(), go.strides.clone(), go.data.clone());
        if node.op == agop_add() || node.op == agop_mul() {
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, gout);
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.b, gout);
        } else if node.op == agop_sub() {
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, gout);
            var neg: Vec<f64> = Vec::new();
            var i1: i64 = 0;
            while i1 < gout.data.len() {
                neg.push(0.0 - gout.data.get(i1));
                i1 = i1 + 1;
            }
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.b, tensor_map_data(&gout, neg));
        } else if node.op == agop_matmul() {
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, Tensor_filled(node.a_shape.clone(), 1.0));
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.b, Tensor_filled(node.b_shape.clone(), 1.0));
        } else if node.op == agop_scale() {
            var sc: Vec<f64> = Vec::new();
            var i2: i64 = 0;
            while i2 < gout.data.len() {
                sc.push(gout.data.get(i2) * node.s);
                i2 = i2 + 1;
            }
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, tensor_map_data(&gout, sc));
        } else if node.op == agop_relu() {
            var eff: Vec<f64> = node.data;
            if node.has_input {
                eff = Vec::new();
                var i3: i64 = 0;
                while i3 < node.input.len() {
                    var x: f64 = node.input.get(i3);
                    if x > 0.0 {
                        eff.push(x);
                    } else {
                        eff.push(0.0);
                    }
                    i3 = i3 + 1;
                }
            }
            var rg: Vec<f64> = Vec::new();
            var i4: i64 = 0;
            while i4 < gout.data.len() && i4 < eff.len() {
                if eff.get(i4) > 0.0 {
                    rg.push(gout.data.get(i4));
                } else {
                    rg.push(gout.data.get(i4) * 0.0);
                }
                i4 = i4 + 1;
            }
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, tensor_map_data(&gout, rg));
        } else if node.op == agop_sigmoid() {
            var eff2: Vec<f64> = node.data;
            if node.has_input {
                eff2 = Vec::new();
                var i5: i64 = 0;
                while i5 < node.input.len() {
                    eff2.push(1.0 / (1.0 + math_exp(0.0 - node.input.get(i5))));
                    i5 = i5 + 1;
                }
            }
            var sg: Vec<f64> = Vec::new();
            var i6: i64 = 0;
            while i6 < gout.data.len() && i6 < eff2.len() {
                var sv: f64 = eff2.get(i6);
                sg.push(gout.data.get(i6) * sv * (1.0 - sv));
                i6 = i6 + 1;
            }
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, tensor_map_data(&gout, sg));
        } else if node.op == agop_sum() {
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, Tensor_filled(node.a_shape.clone(), loss_grad));
        } else if node.op == agop_mean() {
            Interpreter_accum_grad(self, &mut keys, &mut vals, node.a, Tensor_filled(node.a_shape.clone(), loss_grad / (node.a_size as f64)));
        }
    }
    self.ag_grad_keys = keys;
    self.ag_grad_vals = vals;
}

/// A uniform f64 in [0, 1) (xorshift128+, as src/interp.rs prng_next_f64)
@wrapping
pub fn Interpreter_prng_f64(self: &mut Interpreter) -> f64 {
    var s0: u64 = self.prng_state_a;
    var s1: u64 = self.prng_state_b;
    var result: u64 = s0 + s1;
    s1 = s1 ^ s0;
    self.prng_state_a = ((s0 << 24) | (s0 >> 40)) + s1;
    self.prng_state_b = (s1 << 37) | (s1 >> 27);
    var top: i64 = (result >> 11) as i64;
    if top < 0 {
        top = 0 - top;
    }
    return (top as f64) * (1.0 / 9007199254740992.0);
}

pub fn Interpreter_prng_gaussian(self: &mut Interpreter) -> f64 {
    var u1: f64 = 0.0001 + Interpreter_prng_f64(self) * 0.9998;
    var u2: f64 = 0.0001 + Interpreter_prng_f64(self) * 0.9998;
    return math_sqrt(-2.0 * math_log(u1)) * math_cos(2.0 * 3.141592653589793 * u2);
}

pub fn Interpreter_call_tensor(self: &mut Interpreter, name: str, args: Vec<Value>) -> ExecOutcome {
    if !str_starts_with(name, "p_tensor_") && !str_starts_with(name, "p_grad_") && !str_starts_with(name, "p_checkpoint_") && name != "p_dp_noise" && name != "p_gaussian_noise" && name != "p_dropout" {
        return ExecOutcome::Jump(-99);
    }
    if name == "p_checkpoint_begin" {
        self.ag_checkpoint = true;
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_checkpoint_end" {
        self.ag_checkpoint = false;
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_tensor_from_vec" {
        var d_opt: OptVecI64 = Interpreter_arg_to_vec_i64(self, arg_value(args, 0));
        var s_opt: OptVecI64 = Interpreter_arg_to_vec_i64(self, arg_value(args, 1));
        match d_opt {
            OptVecI64::Some(di) => {
                match s_opt {
                    OptVecI64::Some(sh) => {
                        var df: Vec<f64> = Vec::new();
                        var i: i64 = 0;
                        while i < di.len() {
                            df.push(di.get(i) as f64);
                            i = i + 1;
                        }
                        return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_from_vec(sh, df)));
                    }
                    OptVecI64::None => {
                    }
                }
            }
            OptVecI64::None => {
            }
        }
        return ExecOutcome::Panic("tensor_from_vec: expected Vec, Vec");
    }
    if name == "p_tensor_get" || name == "p_tensor_set" {
        var th: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        var idx_opt: OptVecI64 = Interpreter_arg_to_vec_i64(self, arg_value(args, 1));
        match idx_opt {
            OptVecI64::Some(idx) => {
                if th >= 0 {
                    if name == "p_tensor_get" {
                        return ExecOutcome::Value(Value::Float(Tensor_get(&self.tensors.get(th), idx)));
                    }
                    if arg_float_opt_ok(args, 2) {
                        var tm: TensorData = self.tensors.get(th);
                        Tensor_set(&mut tm, idx, arg_float(args, 2));
                        self.tensors.set(th, tm);
                        return ExecOutcome::Continue;
                    }
                }
            }
            OptVecI64::None => {
            }
        }
        if name == "p_tensor_get" {
            return ExecOutcome::Panic("tensor_get: expected Tensor, Vec");
        }
        return ExecOutcome::Panic("tensor_set: expected Tensor, Vec, f64");
    }
    if name == "p_tensor_add" || name == "p_tensor_sub" || name == "p_tensor_mul" || name == "p_tensor_matmul" {
        var ha: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        var hb: i64 = Interpreter_tensor_handle(self, arg_value(args, 1));
        var short: str = str_slice(name, 2, str_len(name));
        if ha < 0 || hb < 0 {
            return ExecOutcome::Panic(short + ": expected Tensor, Tensor");
        }
        var ta: TensorData = self.tensors.get(ha);
        var tb: TensorData = self.tensors.get(hb);
        var rr: ResultTensor = ResultTensor::Err("");
        var op: i64 = agop_add();
        if name == "p_tensor_add" {
            rr = Tensor_add(&ta, &tb);
        }
        if name == "p_tensor_sub" {
            rr = Tensor_sub(&ta, &tb);
            op = agop_sub();
        }
        if name == "p_tensor_mul" {
            rr = Tensor_mul(&ta, &tb);
            op = agop_mul();
        }
        if name == "p_tensor_matmul" {
            rr = Tensor_matmul(&ta, &tb);
            op = agop_matmul();
        }
        match rr {
            ResultTensor::Ok(r) => {
                var rv: Value = Interpreter_alloc_tensor(self, r);
                var e: AgEntry = AgEntry_new(tensor_addr_of(rv), op, tensor_addr_of(args.get(0)), tensor_addr_of(args.get(1)));
                if op == agop_matmul() {
                    e.a_shape = ta.shape.clone();
                    e.b_shape = tb.shape.clone();
                }
                Interpreter_record_ag(self, e);
                return ExecOutcome::Value(rv);
            }
            ResultTensor::Err(msg) => {
                return ExecOutcome::Panic(msg);
            }
        }
    }
    if name == "p_tensor_scale" {
        var hs: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if hs < 0 || !arg_float_opt_ok(args, 1) {
            return ExecOutcome::Panic("tensor_scale: expected Tensor, f64");
        }
        var s: f64 = arg_float(args, 1);
        var sv: Value = Interpreter_alloc_tensor(self, Tensor_scale(&self.tensors.get(hs), s));
        var se: AgEntry = AgEntry_new(tensor_addr_of(sv), agop_scale(), tensor_addr_of(args.get(0)), 0);
        se.s = s;
        Interpreter_record_ag(self, se);
        return ExecOutcome::Value(sv);
    }
    if name == "p_tensor_sum" || name == "p_tensor_mean" {
        var hm: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if hm < 0 {
            return ExecOutcome::Panic(str_slice(name, 2, str_len(name)) + ": expected Tensor");
        }
        var tsum: TensorData = self.tensors.get(hm);
        var res: f64 = 0.0;
        var mop: i64 = agop_sum();
        if name == "p_tensor_sum" {
            res = Tensor_sum(&tsum);
        } else {
            res = Tensor_mean(&tsum);
            mop = agop_mean();
        }
        if self.ag_enabled {
            var me: AgEntry = AgEntry_new(0, mop, tensor_addr_of(args.get(0)), 0);
            me.a_shape = tsum.shape.clone();
            me.a_size = Tensor_size(&tsum);
            self.ag_tape.push(me);
        }
        return ExecOutcome::Value(Value::Float(res));
    }
    if name == "p_tensor_relu" || name == "p_tensor_sigmoid" {
        var hr: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if hr < 0 {
            return ExecOutcome::Panic(str_slice(name, 2, str_len(name)) + ": expected Tensor");
        }
        var tin: TensorData = self.tensors.get(hr);
        var tout: TensorData = Tensor_relu(&tin);
        var aop: i64 = agop_relu();
        if name == "p_tensor_sigmoid" {
            tout = interp_tensor_sigmoid(&tin);
            aop = agop_sigmoid();
        }
        var odata: Vec<f64> = tout.data.clone();
        var ov: Value = Interpreter_alloc_tensor(self, tout);
        var re: AgEntry = AgEntry_new(tensor_addr_of(ov), aop, tensor_addr_of(args.get(0)), 0);
        re.data = odata;
        if self.ag_checkpoint {
            re.has_input = true;
            re.input = tin.data.clone();
        }
        Interpreter_record_ag(self, re);
        return ExecOutcome::Value(ov);
    }
    if name == "p_tensor_softmax" || name == "p_tensor_to_json" {
        var hx: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if hx < 0 {
            return ExecOutcome::Panic(str_slice(name, 2, str_len(name)) + ": expected Tensor");
        }
        if name == "p_tensor_to_json" {
            return ExecOutcome::Value(Value::Str(interp_tensor_to_json(&self.tensors.get(hx))));
        }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, interp_tensor_softmax(&self.tensors.get(hx))));
    }
    if name == "p_grad_get" {
        var hg: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if hg < 0 {
            return ExecOutcome::Panic("grad_get: expected Tensor");
        }
        var gidx: i64 = grad_find(self.ag_grad_keys, tensor_addr_of(args.get(0)));
        if gidx >= 0 {
            return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_clone_data(&self.ag_grad_vals.get(gidx))));
        }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_filled(self.tensors.get(hg).shape.clone(), 0.0)));
    }
    if name == "p_grad_zero" {
        var zk: Vec<i64> = Vec::new();
        self.ag_grad_keys = zk;
        var zv: Vec<TensorData> = Vec::new();
        self.ag_grad_vals = zv;
        return ExecOutcome::Value(Value::Void);
    }
    if name == "p_dp_noise" || name == "p_dropout" {
        var hn: i64 = Interpreter_tensor_handle(self, arg_value(args, 0));
        if hn < 0 || !arg_float_opt_ok(args, 1) {
            if name == "p_dp_noise" {
                return ExecOutcome::Panic("dp_noise: expected (Tensor, f64)");
            }
            return ExecOutcome::Panic("dropout: expected (Tensor, f64)");
        }
        var pf: f64 = arg_float(args, 1);
        var src: TensorData = self.tensors.get(hn);
        var nd: Vec<f64> = Vec::new();
        var di2: i64 = 0;
        var dscale: f64 = 1.0 / (1.0 - pf);
        while di2 < src.data.len() {
            var x2: f64 = src.data.get(di2);
            if name == "p_dp_noise" {
                nd.push(x2 + pf * Interpreter_prng_gaussian(self));
            } else {
                if Interpreter_prng_f64(self) < pf {
                    nd.push(0.0);
                } else {
                    nd.push(x2 * dscale);
                }
            }
            di2 = di2 + 1;
        }
        return ExecOutcome::Value(Interpreter_alloc_tensor(self, tensor_map_data(&src, nd)));
    }
    if name == "p_gaussian_noise" {
        var sigma: f64 = arg_float(args, 1);
        match Interpreter_arg_to_vec_i64(self, arg_value(args, 0)) {
            OptVecI64::Some(gs) => {
                var size: i64 = 1;
                var gi2: i64 = 0;
                while gi2 < gs.len() {
                    size = size * gs.get(gi2);
                    gi2 = gi2 + 1;
                }
                var gd: Vec<f64> = Vec::new();
                var gk: i64 = 0;
                while gk < size {
                    gd.push(sigma * Interpreter_prng_gaussian(self));
                    gk = gk + 1;
                }
                return ExecOutcome::Value(Interpreter_alloc_tensor(self, Tensor_from_vec(gs, gd)));
            }
            OptVecI64::None => {
            }
        }
        return ExecOutcome::Panic("gaussian_noise: expected (Vec, f64)");
    }
    return ExecOutcome::Jump(-99);
}

// Tensor math with the real exp (tensor.fd's tensor_exp is a short Taylor
// series, far off for |x| > 5): matches src/tensor.rs.
pub fn interp_tensor_sigmoid(t: &TensorData) -> TensorData {
    var d: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < t.data.len() {
        d.push(1.0 / (1.0 + math_exp(0.0 - t.data.get(i))));
        i = i + 1;
    }
    return Tensor_new(t.shape.clone(), t.strides.clone(), d);
}

pub fn interp_tensor_softmax(t: &TensorData) -> TensorData {
    var d: Vec<f64> = t.data.clone();
    if t.shape.len() == 0 {
        return Tensor_new(t.shape.clone(), t.strides.clone(), d);
    }
    var row: i64 = t.shape.get(t.shape.len() - 1);
    if row <= 0 {
        return Tensor_new(t.shape.clone(), t.strides.clone(), d);
    }
    var rows: i64 = Tensor_size(t) / row;
    var r: i64 = 0;
    while r < rows {
        var start: i64 = r * row;
        var mx: f64 = t.data.get(start);
        var i: i64 = start + 1;
        while i < start + row {
            if t.data.get(i) > mx {
                mx = t.data.get(i);
            }
            i = i + 1;
        }
        var sum: f64 = 0.0;
        var j: i64 = start;
        while j < start + row {
            var e: f64 = math_exp(t.data.get(j) - mx);
            d.set(j, e);
            sum = sum + e;
            j = j + 1;
        }
        var k: i64 = start;
        while k < start + row {
            d.set(k, d.get(k) / sum);
            k = k + 1;
        }
        r = r + 1;
    }
    return Tensor_new(t.shape.clone(), t.strides.clone(), d);
}

pub fn interp_tensor_to_json(t: &TensorData) -> str {
    var sh: str = "";
    var i: i64 = 0;
    while i < t.shape.len() {
        if i > 0 {
            sh = sh + ",";
        }
        sh = sh + int_to_str(t.shape.get(i));
        i = i + 1;
    }
    var dj: str = "";
    var j: i64 = 0;
    while j < t.data.len() {
        if j > 0 {
            dj = dj + ",";
        }
        var v: f64 = t.data.get(j);
        var av: f64 = v;
        if av < 0.0 {
            av = 0.0 - av;
        }
        var is_int: bool = false;
        if av < 1000000000000000.0 {
            var iv: i64 = v as i64;
            if (iv as f64) == v {
                is_int = true;
            }
        }
        if is_int {
            dj = dj + int_to_str(v as i64);
        } else {
            dj = dj + interp_f64_text(v);
        }
        j = j + 1;
    }
    return "{\"shape\":[" + sh + "],\"data\":[" + dj + "]}";
}

/// Rust's `{:.4}` (round half away from zero on the binary value).
pub fn fmt_fixed4(v: f64) -> str {
    var neg: bool = v < 0.0;
    var a: f64 = v;
    if neg {
        a = 0.0 - v;
    }
    var scaled: f64 = a * 10000.0 + 0.5;
    var r: i64 = scaled as i64;
    var whole: i64 = r / 10000;
    var frac: i64 = r % 10000;
    var fs: str = int_to_str(frac);
    while str_len(fs) < 4 {
        fs = "0" + fs;
    }
    var out: str = int_to_str(whole) + "." + fs;
    if neg {
        out = "-" + out;
    }
    return out;
}

fn tensor_fmt_elem(v: f64) -> str {
    var av: f64 = v;
    if av < 0.0 {
        av = 0.0 - av;
    }
    if av < 1000000000000000.0 {
        var iv: i64 = v as i64;
        if (iv as f64) == v {
            return int_to_str(iv);
        }
    }
    return fmt_fixed4(v);
}

fn tensor_fmt_rec(data: Vec<f64>, shape: Vec<i64>, strides: Vec<i64>, dim: i64, offset: i64) -> str {
    if dim >= shape.len() {
        var v: f64 = 0.0;
        if offset < data.len() {
            v = data.get(offset);
        }
        return interp_f64_text(v);
    }
    var out: str = "[";
    var i: i64 = 0;
    while i < shape.get(dim) {
        if i > 0 {
            out = out + ", ";
        }
        var idx: i64 = offset + i * strides.get(dim);
        if dim == shape.len() - 1 {
            var ev: f64 = 0.0;
            if idx < data.len() {
                ev = data.get(idx);
            }
            out = out + tensor_fmt_elem(ev);
        } else {
            out = out + tensor_fmt_rec(data, shape, strides, dim + 1, idx);
        }
        i = i + 1;
    }
    return out + "]";
}

/// src/tensor.rs Tensor::to_string
pub fn interp_tensor_to_string(t: &TensorData) -> str {
    return tensor_fmt_rec(t.data, t.shape, t.strides, 0, 0);
}

// src/tensor.rs quantize_q8 / dequantize_q8 (tensor.fd pushes
// p_int_to_float results, which the bootstrap types as i64 words)
pub fn interp_quantize_q8(t: &TensorData, scale: f64, zp: i64) -> TensorData {
    var d: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < t.data.len() {
        var x: f64 = t.data.get(i) / scale;
        var r: f64 = 0.0;
        if x < 0.0 {
            r = 0.0 - math_floor(0.5 - x);
        } else {
            r = math_floor(x + 0.5);
        }
        var q: i64 = wrap_add(r as i64, zp);
        if q < -128 {
            q = -128;
        }
        if q > 127 {
            q = 127;
        }
        d.push(q as f64);
        i = i + 1;
    }
    return Tensor_new(t.shape.clone(), t.strides.clone(), d);
}

pub fn interp_dequantize_q8(t: &TensorData, scale: f64, zp: i64) -> TensorData {
    var d: Vec<f64> = Vec::new();
    var zf: f64 = zp as f64;
    var i: i64 = 0;
    while i < t.data.len() {
        d.push((t.data.get(i) - zf) * scale);
        i = i + 1;
    }
    return Tensor_new(t.shape.clone(), t.strides.clone(), d);
}

fn int_or_q(v: Value) -> str {
    match v {
        Value::Int(n) => {
            return int_to_str(n);
        }
        _ => {
        }
    }
    return "?";
}

// Wrap-around arithmetic for @wrapping programs (the interpreter's own
// arithmetic is checked).
@wrapping
fn wrap_add(a: i64, b: i64) -> i64 {
    return a + b;
}
@wrapping
fn wrap_sub(a: i64, b: i64) -> i64 {
    return a - b;
}
@wrapping
fn wrap_mul(a: i64, b: i64) -> i64 {
    return a * b;
}

/// A side-table Vec as `[a, "s", ...]` (string elements quoted).
pub fn Interpreter_display_vec_quoted(self: &Interpreter, h: i64) -> str {
    var out: str = "[";
    if h >= 0 && h < self.vec_values.len() {
        var elems: Vec<Value> = self.vec_values.get(h).elements;
        var i: i64 = 0;
        while i < elems.len() {
            if i > 0 {
                out = out + ", ";
            }
            match elems.get(i) {
                Value::Str(es) => {
                    out = out + "\"" + es + "\"";
                }
                _ => {
                    out = out + Interpreter_display_value(self, elems.get(i));
                }
            }
            i = i + 1;
        }
    }
    return out + "]";
}

// ─── Child processes (roadmap AD4) ──────────────────────────────────────
// stdlib/process.fd's fid_proc_* (process_spawn, process_wait,
// process_kill) for a program `fid run` interprets. The interpreter cannot
// call the C runtime's own fid_proc_*: the compiler that builds fid's first
// stage (an earlier fid, or fidesc) has none, so fid must not name them.
// It starts each child through the shell with p_process_run, in the
// background so that it returns at once:
//   POSIX: ( /bin/sh -c <launcher> fid-proc <pid file> <dir> <out>
//          [env -u K K=V ..] <program> <args>; echo $? > <code file> ) &
//   the launcher writing its pid (the program's, after exec) first;
//   Windows: PowerShell's Start-Process of cmd /c "[set "K=V"&] <program>
//   > <out> 2>&1 & call echo %^errorlevel%> <code file>" (about half a
//   second per child), its process id printed back.
// process_wait polls for the code file (127 / 9009: the program was not
// found); process_kill is kill -9 / taskkill /F /T (code 137). A child
// given no output file writes to temporary ones, printed to our stdout and
// stderr once it has ended. Limits: on Windows the arguments are quoted for cmd, so
// `%` (and `!`) in them are not passed as written; a child the program
// never waits for leaves its two small files in the temp directory.

var g_ipx_used: Vec<i64> = Vec::new();
var g_ipx_pid: Vec<i64> = Vec::new();
var g_ipx_done: Vec<i64> = Vec::new();
var g_ipx_code: Vec<i64> = Vec::new();
var g_ipx_codef: Vec<str> = Vec::new();
var g_ipx_pidf: Vec<str> = Vec::new();
var g_ipx_relay: Vec<str> = Vec::new();
var g_ipx_relay_err: Vec<str> = Vec::new();
var g_ipx_ctr: i64 = 0;

fn ipx_windows() -> bool {
    match env_var("OS") {
        Option::Some(s) => {
            return str_contains(str_to_lower(s), "windows");
        }
        Option::None => {
        }
    }
    return false;
}

fn ipx_tmp() -> str {
    var names: Vec<str> = Vec::new();
    names.push("TEMP");
    names.push("TMP");
    names.push("TMPDIR");
    var i: i64 = 0;
    while i < names.len() {
        match env_var(names.get(i)) {
            Option::Some(s) => {
                if str_len(s) > 0 {
                    if ipx_windows() {
                        return s + "\\";
                    }
                    return s + "/";
                }
            }
            Option::None => {
            }
        }
        i = i + 1;
    }
    return "/tmp/";
}

/// A str argument of an extern "C" call (0 or a missing one: "").
fn ipx_arg_str(self: &Interpreter, args: &Vec<Value>, i: i64) -> str {
    if i >= args.len() {
        return "";
    }
    match args.get(i) {
        Value::Int(n) => {
            if n == 0 {
                return "";
            }
        }
        _ => {
        }
    }
    return Interpreter_value_to_string(self, args.get(i));
}

/// A byte-31 list's items ("" has none).
fn ipx_items(s: str) -> Vec<str> {
    if str_len(s) == 0 {
        return Vec::new();
    }
    return str_split(s, char_to_str(31));
}

fn ipx_sh_quote(s: str) -> str {
    return "'" + str_replace(s, "'", "'\\''") + "'";
}

fn ipx_ps_quote(s: str) -> str {
    return "'" + str_replace(s, "'", "''") + "'";
}

/// An argument for cmd's command line: as it is when plain, else in
/// double quotes with the C runtime's escapes.
fn ipx_cmd_arg(a: str) -> str {
    val n: i64 = str_len(a);
    var plain: bool = n > 0;
    var i: i64 = 0;
    while i < n {
        val c: i64 = str_byte_at(a, i);
        // space, tab, " & | < > ^ ( ) % ! , ; =
        if c == 32 || c == 9 || c == 34 || c == 38 || c == 124 || c == 60 || c == 62 || c == 94 || c == 40 || c == 41 || c == 37 || c == 33 || c == 44 || c == 59 || c == 61 {
            plain = false;
        }
        i = i + 1;
    }
    if plain {
        return a;
    }
    var out: str = "\"";
    var bs: i64 = 0;
    i = 0;
    while i < n {
        val c2: i64 = str_byte_at(a, i);
        if c2 == 92 {
            bs = bs + 1;
        } else {
            if c2 == 34 {
                out = out + str_repeat("\\", bs * 2 + 1) + "\"";
            } else {
                out = out + str_repeat("\\", bs) + char_to_str(c2);
            }
            bs = 0;
        }
        i = i + 1;
    }
    return out + str_repeat("\\", bs * 2) + "\"";
}

/// Text as PowerShell's -EncodedCommand takes it: UTF-16LE, base64.
fn ipx_encode_ps(s: str) -> str {
    var b: Vec<i64> = Vec::new();
    val n: i64 = str_len(s);
    var i: i64 = 0;
    while i < n {
        val c: i64 = str_byte_at(s, i);
        var cp: i64 = 65533;
        var adv: i64 = 1;
        if c < 128 {
            cp = c;
        } else if c >= 240 && i + 3 < n {
            cp = ((c & 7) << 18) | ((str_byte_at(s, i + 1) & 63) << 12) | ((str_byte_at(s, i + 2) & 63) << 6) | (str_byte_at(s, i + 3) & 63);
            adv = 4;
        } else if c >= 224 && c < 240 && i + 2 < n {
            cp = ((c & 15) << 12) | ((str_byte_at(s, i + 1) & 63) << 6) | (str_byte_at(s, i + 2) & 63);
            adv = 3;
        } else if c >= 192 && c < 224 && i + 1 < n {
            cp = ((c & 31) << 6) | (str_byte_at(s, i + 1) & 63);
            adv = 2;
        }
        if cp >= 65536 {
            val v: i64 = cp - 65536;
            val hi: i64 = 55296 + (v >> 10);
            val lo: i64 = 56320 + (v & 1023);
            b.push(hi & 255);
            b.push(hi >> 8);
            b.push(lo & 255);
            b.push(lo >> 8);
        } else {
            b.push(cp & 255);
            b.push(cp >> 8);
        }
        i = i + adv;
    }
    val abc: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var out: str = "";
    var k: i64 = 0;
    while k < b.len() {
        val b0: i64 = b.get(k);
        var b1: i64 = 0;
        var b2: i64 = 0;
        if k + 1 < b.len() {
            b1 = b.get(k + 1);
        }
        if k + 2 < b.len() {
            b2 = b.get(k + 2);
        }
        val w: i64 = (b0 << 16) | (b1 << 8) | b2;
        out = out + char_to_str(str_byte_at(abc, (w >> 18) & 63)) + char_to_str(str_byte_at(abc, (w >> 12) & 63));
        if k + 1 < b.len() {
            out = out + char_to_str(str_byte_at(abc, (w >> 6) & 63));
        } else {
            out = out + "=";
        }
        if k + 2 < b.len() {
            out = out + char_to_str(str_byte_at(abc, w & 63));
        } else {
            out = out + "=";
        }
        k = k + 3;
    }
    return out;
}

fn ipx_read_int(path: str) -> i64 {
    match read_file(path) {
        Option::Some(t) => {
            val s: str = str_trim(t);
            if str_len(s) > 0 {
                return str_parse_int(s);
            }
        }
        Option::None => {
        }
    }
    return -1;
}

/// Whether the file at `path` holds more than white space (a code file
/// written to the end; a child may exit with -1 itself).
fn ipx_has_text(path: str) -> bool {
    match read_file(path) {
        Option::Some(t) => {
            return str_len(str_trim(t)) > 0;
        }
        Option::None => {
        }
    }
    return false;
}

/// fid_proc_spawn: the handle (slot + 1), 0 when it could not start.
/// in_path: a file the child reads as its stdin ("" for none; roadmap
/// L4H's pipes, ipx_io_start).
fn ipx_spawn(argl: str, envl: str, dir: str, out_in: str, in_path: str) -> i64 {
    val argv: Vec<str> = ipx_items(argl);
    if argv.len() == 0 {
        return 0;
    }
    val env: Vec<str> = ipx_items(envl);
    g_ipx_ctr = g_ipx_ctr + 1;
    val base: str = ipx_tmp() + ".fid_iproc_" + int_to_str(p_getpid()) + "_" + int_to_str(p_clock_now_us()) + "_" + int_to_str(g_ipx_ctr);
    val codef: str = base + ".code";
    val pidf: str = base + ".pid";
    // out_in: the file for stdout, then the one for stderr ("" or none:
    // the stdout file, or ours: then temporary files, printed at the end)
    val outs: Vec<str> = ipx_items(out_in);
    var out: str = "";
    var err: str = "";
    if outs.len() > 0 {
        out = outs.get(0);
    }
    if outs.len() > 1 {
        err = outs.get(1);
    }
    var relay: str = "";
    var relay_err: str = "";
    if str_len(out) == 0 {
        out = base + ".out";
        relay = out;
        if str_len(err) == 0 {
            err = base + ".err";
            relay_err = err;
        }
    }
    var pid: i64 = -1;
    if ipx_windows() {
        var inner: str = "";
        var e: i64 = 0;
        while e < env.len() {
            val item: str = env.get(e);
            if str_contains(item, "=") {
                inner = inner + "set \"" + item + "\"& ";
            } else {
                inner = inner + "set \"" + item + "=\"& ";
            }
            e = e + 1;
        }
        var a: i64 = 0;
        while a < argv.len() {
            if a > 0 {
                inner = inner + " ";
            }
            inner = inner + ipx_cmd_arg(argv.get(a));
            a = a + 1;
        }
        var wd: str = "";
        if str_len(dir) > 0 {
            wd = " -WorkingDirectory " + ipx_ps_quote(dir);
        }
        // the files' full paths from our directory (Start-Process changes
        // to dir first)
        var redir: str = "' > \"' + $o + '\" 2>&1";
        var errpath: str = "";
        if str_len(err) > 0 {
            redir = "' > \"' + $o + '\" 2> \"' + $e + '\"";
            errpath = "$e = [IO.Path]::GetFullPath(" + ipx_ps_quote(err) + "); ";
        }
        if str_len(in_path) > 0 {
            // ' < "<in>" > "<out>" ...: the input file first
            redir = "' < \"' + $i + '\" " + str_slice(redir, 2, str_len(redir));
            errpath = errpath + "$i = [IO.Path]::GetFullPath(" + ipx_ps_quote(in_path) + "); ";
        }
        val script: str = "$o = [IO.Path]::GetFullPath(" + ipx_ps_quote(out) + "); " + errpath + "$a = '/d /s /c \"' + " + ipx_ps_quote(inner) + " + " + redir + " & call echo %^errorlevel%> \"' + " + ipx_ps_quote(codef) + " + '\"\"'; $p = Start-Process -FilePath 'cmd.exe' -ArgumentList $a -WindowStyle Hidden -PassThru" + wd + "; [Console]::Out.Write($p.Id)";
        val h: i64 = p_process_run("powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand " + ipx_encode_ps(script));
        if h == 0 {
            return 0;
        }
        val text: str = str_trim(p_process_stdout(h));
        val pcode: i64 = p_process_code(h);
        p_process_close(h);
        if pcode != 0 || str_len(text) == 0 {
            return 0;
        }
        pid = str_parse_int(text);
    } else {
        val launcher: str = "echo $$ > \"$1\"; d=$2; o=$3; e=$4; i=$5; shift 5; if [ -n \"$i\" ]; then exec < \"$i\" || exit 127; fi; if [ -n \"$o\" ]; then exec > \"$o\" || exit 127; fi; if [ -n \"$e\" ]; then exec 2> \"$e\" || exit 127; elif [ -n \"$o\" ]; then exec 2>&1; fi; if [ -n \"$d\" ]; then cd -- \"$d\" || exit 127; fi; exec \"$@\"";
        var cmd: str = "/bin/sh -c " + ipx_sh_quote(launcher) + " fid-proc " + ipx_sh_quote(pidf) + " " + ipx_sh_quote(dir) + " " + ipx_sh_quote(out) + " " + ipx_sh_quote(err) + " " + ipx_sh_quote(in_path);
        if env.len() > 0 {
            // env's options (-u: remove) before its assignments
            cmd = cmd + " env";
            var e2: i64 = 0;
            while e2 < env.len() {
                if !str_contains(env.get(e2), "=") {
                    cmd = cmd + " -u " + ipx_sh_quote(env.get(e2));
                }
                e2 = e2 + 1;
            }
            e2 = 0;
            while e2 < env.len() {
                if str_contains(env.get(e2), "=") {
                    cmd = cmd + " " + ipx_sh_quote(env.get(e2));
                }
                e2 = e2 + 1;
            }
        }
        var a2: i64 = 0;
        while a2 < argv.len() {
            cmd = cmd + " " + ipx_sh_quote(argv.get(a2));
            a2 = a2 + 1;
        }
        val tmpc: str = codef + ".t";
        val line: str = "( " + cmd + "; echo $? > " + ipx_sh_quote(tmpc) + "; mv " + ipx_sh_quote(tmpc) + " " + ipx_sh_quote(codef) + " ) > /dev/null 2>&1 < /dev/null &";
        val h2: i64 = p_process_run(line);
        if h2 == 0 {
            return 0;
        }
        p_process_close(h2);
        // the launcher writes its pid at once: wait for it (5 s at most)
        var waited: i64 = 0;
        while p_file_exists(pidf) == 0 && p_file_exists(codef) == 0 && waited < 5000 {
            p_co_sleep(2);
            waited = waited + 2;
        }
        pid = ipx_read_int(pidf);
    }
    g_ipx_used.push(1);
    g_ipx_pid.push(pid);
    g_ipx_done.push(0);
    g_ipx_code.push(-1);
    g_ipx_codef.push(codef);
    g_ipx_pidf.push(pidf);
    g_ipx_relay.push(relay);
    g_ipx_relay_err.push(relay_err);
    return g_ipx_used.len();
}

fn ipx_slot(h: i64) -> i64 {
    if h < 1 || h > g_ipx_used.len() {
        return -1;
    }
    if g_ipx_used.get(h - 1) == 0 {
        return -1;
    }
    return h - 1;
}

/// The child in slot s has ended with `code`: keep it, print what it wrote
/// to a temporary file of ours.
fn ipx_finish(s: i64, code: i64) {
    g_ipx_done.set(s, 1);
    g_ipx_code.set(s, code);
    val relay: str = g_ipx_relay.get(s);
    if str_len(relay) > 0 {
        match read_file(relay) {
            Option::Some(t) => {
                p_print_str(t);
            }
            Option::None => {
            }
        }
        p_file_delete(relay);
    }
    val relay_err: str = g_ipx_relay_err.get(s);
    if str_len(relay_err) > 0 {
        match read_file(relay_err) {
            Option::Some(t2) => {
                p_eprint_str(t2);
            }
            Option::None => {
            }
        }
        p_file_delete(relay_err);
    }
}

/// fid_proc_wait: 1 once ended, 0 while running after timeout_ms (< 0: no
/// limit), -1 for a bad handle.
fn ipx_wait(h: i64, timeout_ms: i64) -> i64 {
    val s: i64 = ipx_slot(h);
    if s < 0 {
        return -1;
    }
    if g_ipx_done.get(s) != 0 {
        return 1;
    }
    val codef: str = g_ipx_codef.get(s);
    val t0: i64 = p_clock_now_ms();
    var nap: i64 = 1;
    while true {
        if p_file_exists(codef) != 0 {
            var code: i64 = ipx_read_int(codef);
            // being written: look again until it holds the code (2 s at
            // most). 2g.113: on Windows cmd's `echo %errorlevel%> file`
            // creates the file before it writes to it; one more look after
            // 1 ms was too soon under load, and the child's code read as
            // -1 (`parallel codes: 0 1 -1`)
            val tw: i64 = p_clock_now_ms();
            while code < 0 && !ipx_has_text(codef) && p_clock_now_ms() - tw < 2000 {
                p_co_sleep(2);
                code = ipx_read_int(codef);
            }
            ipx_finish(s, code);
            return 1;
        }
        val ms: i64 = p_clock_now_ms() - t0;
        if timeout_ms >= 0 && ms >= timeout_ms {
            return 0;
        }
        var n: i64 = nap;
        if timeout_ms >= 0 && n > timeout_ms - ms {
            n = timeout_ms - ms;
        }
        p_co_sleep(n);
        if nap < 20 {
            nap = nap + 1;
        }
    }
    return 0;
}

/// fid_proc_kill: 1 when it was running and was told to stop.
fn ipx_kill(h: i64) -> i64 {
    val s: i64 = ipx_slot(h);
    if s < 0 {
        return 0;
    }
    if g_ipx_done.get(s) != 0 || g_ipx_pid.get(s) <= 0 {
        return 0;
    }
    if ipx_wait(h, 0) == 1 {
        return 0;
    }
    val pid: str = int_to_str(g_ipx_pid.get(s));
    if ipx_windows() {
        val hk: i64 = p_process_run("taskkill /F /T /PID " + pid);
        var ok: bool = false;
        if hk != 0 {
            ok = p_process_code(hk) == 0;
            p_process_close(hk);
        }
        if !ok {
            return 0;
        }
        // cmd was killed before it could write the code file
        ipx_finish(s, 137);
        return 1;
    }
    val hp: i64 = p_process_run("kill -9 " + pid);
    var ok2: bool = false;
    if hp != 0 {
        ok2 = p_process_code(hp) == 0;
        p_process_close(hp);
    }
    if ok2 {
        return 1;
    }
    return 0;
}

/// fid_proc_free: forget the handle and its files.
fn ipx_free(h: i64) -> i64 {
    val s: i64 = ipx_slot(h);
    if s < 0 {
        return -1;
    }
    if g_ipx_done.get(s) != 0 {
        p_file_delete(g_ipx_codef.get(s));
    }
    p_file_delete(g_ipx_pidf.get(s));
    g_ipx_used.set(s, 0);
    return 0;
}

// ─── Pipes (roadmap L4H: process_spawn_io, Command::spawn) ─────────────
// The interpreter has no pipes to a child (fid cannot name the C runtime's
// fid_proc_* functions, see above). A child given pipes starts only when it
// is first read from, waited for, killed or asked its pid: what was written
// to its stdin before then is its input (a file), its piped stdout and
// stderr go to files, and a read waits for it to end and hands the file
// over in chunks. So a program that writes all its input, then reads, gets
// what the compiled program gets; one that answers each line it reads
// cannot run here (a write after the start fails, -1).

const IPX_IO_BASE: i64 = 1099511627776;  // 1 << 40: a pipe child's handle
var g_iox_argl: Vec<str> = Vec::new();
var g_iox_envl: Vec<str> = Vec::new();
var g_iox_dir: Vec<str> = Vec::new();
var g_iox_io: Vec<i64> = Vec::new();
var g_iox_input: Vec<str> = Vec::new();  // stdin written so far
var g_iox_in_open: Vec<i64> = Vec::new();
var g_iox_h: Vec<i64> = Vec::new();  // the ipx handle once started (0: not yet, -1: failed)
var g_iox_base: Vec<str> = Vec::new();  // its temp files' common name
var g_iox_text: Vec<str> = Vec::new();  // [2 s] stdout's, [2 s + 1] stderr's text once ended
var g_iox_pos: Vec<i64> = Vec::new();  // how much of each was read
var g_iox_loaded: Vec<i64> = Vec::new();
var g_iox_used: Vec<i64> = Vec::new();

fn ipx_io_new(argl: str, envl: str, dir: str, io: i64) -> i64 {
    if str_len(argl) == 0 {
        return 0;
    }
    g_ipx_ctr = g_ipx_ctr + 1;
    g_iox_argl.push(argl);
    g_iox_envl.push(envl);
    g_iox_dir.push(dir);
    g_iox_io.push(io);
    g_iox_input.push("");
    g_iox_in_open.push(io & 1);
    g_iox_h.push(0);
    g_iox_base.push(ipx_tmp() + ".fid_iopipe_" + int_to_str(p_getpid()) + "_" + int_to_str(p_clock_now_us()) + "_" + int_to_str(g_ipx_ctr));
    g_iox_text.push("");
    g_iox_text.push("");
    g_iox_pos.push(0);
    g_iox_pos.push(0);
    g_iox_loaded.push(0);
    g_iox_used.push(1);
    return IPX_IO_BASE + g_iox_used.len();
}

fn ipx_io_slot(h: i64) -> i64 {
    val s: i64 = h - IPX_IO_BASE - 1;
    if s < 0 || s >= g_iox_used.len() {
        return -1;
    }
    if g_iox_used.get(s) == 0 {
        return -1;
    }
    return s;
}

/// Start the child of slot s (once): its input file, then ipx_spawn with
/// the piped streams going to files. Its ipx handle, -1 when it failed.
fn ipx_io_start(s: i64) -> i64 {
    if g_iox_h.get(s) != 0 {
        return g_iox_h.get(s);
    }
    val io: i64 = g_iox_io.get(s);
    val base: str = g_iox_base.get(s);
    var inp: str = "";
    if (io & 1) != 0 {
        inp = base + ".in";
        if p_file_write(inp, g_iox_input.get(s)) != 0 {
            g_iox_h.set(s, -1);
            return -1;
        }
    }
    g_iox_in_open.set(s, 0);
    // stdout piped: its file (stderr with it unless piped apart); only
    // stderr piped: stdout is ours (an empty first item)
    var outs: str = "";
    if (io & 2) != 0 {
        outs = base + ".out";
    }
    if (io & 4) != 0 {
        outs = outs + char_to_str(31) + base + ".err";
    } else if (io & 10) == 2 {
        // stdout piped, stderr ours: a file printed once it has ended
        // (ipx_io_relay)
        outs = outs + char_to_str(31) + base + ".rel";
    }
    var h: i64 = ipx_spawn(g_iox_argl.get(s), g_iox_envl.get(s), g_iox_dir.get(s), outs, inp);
    if h == 0 {
        h = -1;
    }
    g_iox_h.set(s, h);
    return h;
}

/// fid_proc_write: before the start, kept as the child's input.
fn ipx_io_write(h: i64, data: str, n: i64) -> i64 {
    val s: i64 = ipx_io_slot(h);
    if s < 0 || n < 0 {
        return -1;
    }
    if g_iox_in_open.get(s) == 0 {
        return -1;
    }
    var part: str = data;
    if n < str_len(data) {
        part = str_slice(data, 0, n);
    }
    g_iox_input.set(s, g_iox_input.get(s) + part);
    return str_len(part);
}

fn ipx_io_close_in(h: i64) -> i64 {
    val s: i64 = ipx_io_slot(h);
    if s < 0 {
        return -1;
    }
    g_iox_in_open.set(s, 0);
    return 0;
}

/// fid_proc_read: up to max bytes of the stream's file into the program's
/// memory at buf, once the child has ended; 0 at the end, -1 without that
/// pipe.
fn Interpreter_ipx_io_read(self: &mut Interpreter, h: i64, which: i64, buf: i64, max: i64) -> i64 {
    val s: i64 = ipx_io_slot(h);
    if s < 0 || max <= 0 {
        return -1;
    }
    val io: i64 = g_iox_io.get(s);
    var k: i64 = 0;
    if which == 2 {
        k = 1;
        if (io & 4) == 0 {
            return -1;
        }
    } else if (io & 2) == 0 {
        return -1;
    }
    if g_iox_loaded.get(s) == 0 {
        val ih: i64 = ipx_io_start(s);
        if ih > 0 {
            ipx_wait(ih, -1);
        }
        val base: str = g_iox_base.get(s);
        if (io & 2) != 0 {
            match read_file(base + ".out") {
                Option::Some(t) => {
                    g_iox_text.set(2 * s, t);
                }
                Option::None => {
                }
            }
            p_file_delete(base + ".out");
        }
        if (io & 4) != 0 {
            match read_file(base + ".err") {
                Option::Some(t2) => {
                    g_iox_text.set(2 * s + 1, t2);
                }
                Option::None => {
                }
            }
            p_file_delete(base + ".err");
        }
        ipx_io_relay(s);
        g_iox_loaded.set(s, 1);
    }
    val text: str = g_iox_text.get(2 * s + k);
    val pos: i64 = g_iox_pos.get(2 * s + k);
    var n: i64 = str_len(text) - pos;
    if n > max {
        n = max;
    }
    if n <= 0 {
        return 0;
    }
    if !Memory_is_valid_addr(&self.memory, buf) || !Memory_is_valid_addr(&self.memory, buf + n - 1) {
        return -1;
    }
    var i: i64 = 0;
    while i < n {
        Memory_store_byte(&mut self.memory, buf + i, str_byte_at(text, pos + i));
        i = i + 1;
    }
    g_iox_pos.set(2 * s + k, pos + n);
    return n;
}

/// The stderr of a child whose stdout alone was piped, printed to ours
/// once it has ended (once).
fn ipx_io_relay(s: i64) {
    val rel: str = g_iox_base.get(s) + ".rel";
    if p_file_exists(rel) == 0 {
        return;
    }
    match read_file(rel) {
        Option::Some(t) => {
            p_eprint_str(t);
        }
        Option::None => {
        }
    }
    p_file_delete(rel);
}

/// fid_proc_wait / code / kill / pid / free of a pipe child.
fn ipx_io_call(c_name: str, h: i64, timeout_ms: i64) -> i64 {
    val s: i64 = ipx_io_slot(h);
    if s < 0 {
        if c_name == "fid_proc_kill" {
            return 0;
        }
        return -1;
    }
    if c_name == "fid_proc_free" {
        val fh: i64 = g_iox_h.get(s);
        if fh > 0 {
            ipx_free(fh);
        }
        val base: str = g_iox_base.get(s);
        p_file_delete(base + ".in");
        p_file_delete(base + ".out");
        p_file_delete(base + ".err");
        p_file_delete(base + ".rel");
        g_iox_used.set(s, 0);
        g_iox_input.set(s, "");
        g_iox_text.set(2 * s, "");
        g_iox_text.set(2 * s + 1, "");
        return 0;
    }
    val ih: i64 = ipx_io_start(s);
    if ih <= 0 {
        if c_name == "fid_proc_kill" {
            return 0;
        }
        return -1;
    }
    if c_name == "fid_proc_wait" {
        val wr: i64 = ipx_wait(ih, timeout_ms);
        if wr == 1 {
            ipx_io_relay(s);
        }
        return wr;
    }
    if c_name == "fid_proc_kill" {
        return ipx_kill(ih);
    }
    val si: i64 = ipx_slot(ih);
    if si < 0 {
        return -1;
    }
    if c_name == "fid_proc_pid" {
        return g_ipx_pid.get(si);
    }
    // fid_proc_code
    if g_ipx_done.get(si) == 0 {
        return -1;
    }
    return g_ipx_code.get(si);
}

/// ExecOutcome::Jump(-99): a builtin dispatcher did not know the name.
/// An `extern "C"` call to the C library that the interpreter can make
/// through its own runtime (getenv, printf of a plain string, system, exit,
/// getpid); Jump(-99) for any other.
pub fn Interpreter_libc_call(self: &mut Interpreter, c_name: str, args: Vec<Value>) -> ExecOutcome {
    // AD4: stdlib/process.fd's child processes
    if c_name == "fid_proc_spawn" {
        val pa: str = ipx_arg_str(self, &args, 0);
        val pe: str = ipx_arg_str(self, &args, 1);
        val pd: str = ipx_arg_str(self, &args, 2);
        val po: str = ipx_arg_str(self, &args, 3);
        return ExecOutcome::Value(Value::Int(ipx_spawn(pa, pe, pd, po, "")));
    }
    // roadmap L4H: pipes (ipx_io_*); a handle >= IPX_IO_BASE is one of
    // those children, the calls below go to its started child
    if c_name == "fid_proc_spawn_io" {
        val qa: str = ipx_arg_str(self, &args, 0);
        val qe: str = ipx_arg_str(self, &args, 1);
        val qd: str = ipx_arg_str(self, &args, 2);
        val qo: str = ipx_arg_str(self, &args, 3);
        val qio: i64 = arg_int(args, 4, 0) & 15;
        if (qio & 7) == 0 {
            return ExecOutcome::Value(Value::Int(ipx_spawn(qa, qe, qd, qo, "")));
        }
        return ExecOutcome::Value(Value::Int(ipx_io_new(qa, qe, qd, qio)));
    }
    if c_name == "fid_proc_write" {
        val wdata: str = ipx_arg_str(self, &args, 1);
        return ExecOutcome::Value(Value::Int(ipx_io_write(arg_int(args, 0, 0), wdata, arg_int(args, 2, 0))));
    }
    if c_name == "fid_proc_close_in" {
        return ExecOutcome::Value(Value::Int(ipx_io_close_in(arg_int(args, 0, 0))));
    }
    if c_name == "fid_proc_read" {
        return ExecOutcome::Value(Value::Int(Interpreter_ipx_io_read(self, arg_int(args, 0, 0), arg_int(args, 1, 1), arg_int_or_ptr(args, 2), arg_int(args, 3, 0))));
    }
    if (c_name == "fid_proc_wait" || c_name == "fid_proc_code" || c_name == "fid_proc_kill" || c_name == "fid_proc_pid" || c_name == "fid_proc_free") && arg_int(args, 0, 0) >= IPX_IO_BASE {
        return ExecOutcome::Value(Value::Int(ipx_io_call(c_name, arg_int(args, 0, 0), arg_int(args, 1, -1))));
    }
    if c_name == "fid_proc_wait" {
        return ExecOutcome::Value(Value::Int(ipx_wait(arg_int(args, 0, 0), arg_int(args, 1, -1))));
    }
    if c_name == "fid_proc_code" {
        val sc: i64 = ipx_slot(arg_int(args, 0, 0));
        if sc < 0 || g_ipx_done.get(sc) == 0 {
            return ExecOutcome::Value(Value::Int(-1));
        }
        return ExecOutcome::Value(Value::Int(g_ipx_code.get(sc)));
    }
    if c_name == "fid_proc_kill" {
        return ExecOutcome::Value(Value::Int(ipx_kill(arg_int(args, 0, 0))));
    }
    if c_name == "fid_proc_pid" {
        val sp: i64 = ipx_slot(arg_int(args, 0, 0));
        if sp < 0 {
            return ExecOutcome::Value(Value::Int(-1));
        }
        return ExecOutcome::Value(Value::Int(g_ipx_pid.get(sp)));
    }
    if c_name == "fid_proc_free" {
        return ExecOutcome::Value(Value::Int(ipx_free(arg_int(args, 0, 0))));
    }
    if c_name == "getenv" {
        var gname: str = "";
        if args.len() > 0 {
            gname = Interpreter_value_to_string(self, args.get(args.len() - 1));
        }
        match env_var(gname) {
            Option::Some(gv) => {
                return ExecOutcome::Value(Value::Str(gv));
            }
            Option::None => {
                return ExecOutcome::Value(Value::Int(0));
            }
        }
    }
    if c_name == "printf" || c_name == "puts" {
        var ptext: str = "";
        if args.len() > 0 {
            ptext = Interpreter_value_to_string(self, args.get(args.len() - 1));
        }
        if c_name == "puts" {
            ptext = ptext + "\n";
        }
        p_print_str(ptext);
        return ExecOutcome::Value(Value::Int(str_len(ptext)));
    }
    if c_name == "system" {
        var scmd: str = "";
        if args.len() > 0 {
            scmd = Interpreter_value_to_string(self, args.get(args.len() - 1));
        }
        var sh: i64 = p_process_run(scmd);
        p_print_str(p_process_stdout(sh));
        p_eprint_str(p_process_stderr(sh));
        var scode: i64 = p_process_code(sh);
        p_process_close(sh);
        return ExecOutcome::Value(Value::Int(scode));
    }
    if c_name == "exit" {
        p_exit(arg_int(args, args.len() - 1, 0));
        return ExecOutcome::Value(Value::Void);
    }
    if c_name == "getpid" {
        return ExecOutcome::Value(Value::Int(p_getpid()));
    }
    // VF14: the C library calls that take a Fides callback, run on the
    // interpreter's memory with the callback called as CallPtr calls it
    // (test_c_callback printed nothing under `fid run`)
    if c_name == "qsort" && args.len() >= 4 {
        return Interpreter_libc_qsort(self, args);
    }
    if c_name == "bsearch" && args.len() >= 5 {
        return Interpreter_libc_bsearch(self, args);
    }
    return ExecOutcome::Jump(-99);
}

/// A callback's result as a word (an `i32` comparison result sign-extended
/// from its low 32 bits, as C reads it).
fn interp_cb_i32(v: Value) -> i64 {
    var w: i64 = 0;
    match v {
        Value::Int(n) => {
            w = n;
        }
        Value::Ptr(p) => {
            w = p;
        }
        Value::Bool(b) => {
            if b {
                w = 1;
            }
        }
        _ => {
        }
    }
    var low: i64 = w & 4294967295;
    if low >= 2147483648 {
        return low - 4294967296;
    }
    return low;
}

/// Call a function value (a closure env, or a function's name) with
/// `cargs` as CallPtr does; ExecOutcome::Value holds the result. For the C
/// library calls that take a callback (qsort, bsearch).
pub fn Interpreter_call_fn_value(self: &mut Interpreter, fv: Value, cargs: Vec<Value>) -> ExecOutcome {
    var fn_name: str = "";
    var env_ptr: i64 = 0;
    var faddr: i64 = 0;
    match fv {
        Value::Str(s) => {
            fn_name = s;
        }
        Value::Ptr(a) => {
            faddr = a;
        }
        Value::Int(a) => {
            faddr = a;
        }
        _ => {
        }
    }
    if faddr > 0 {
        var fn_ptr_addr: i64 = Memory_load_i64(&self.memory, faddr);
        match Interpreter_lookup_opaque(self, fn_ptr_addr) {
            OptValue::Some(nv) => {
                match nv {
                    Value::Str(ns) => {
                        fn_name = ns;
                    }
                    _ => {
                    }
                }
            }
            OptValue::None => {
            }
        }
        if fn_name == "" {
            fn_name = Memory_load_cstr(&self.memory, fn_ptr_addr);
        }
        env_ptr = faddr;
        var named: bool = false;
        match Interpreter_get_function(self, fn_name) {
            OptIrFunction::Some(_) => {
                named = true;
            }
            OptIrFunction::None => {
            }
        }
        if !named {
            match Interpreter_lookup_opaque(self, faddr) {
                OptValue::Some(dv) => {
                    match dv {
                        Value::Str(ds) => {
                            fn_name = ds;
                            env_ptr = 0;
                        }
                        _ => {
                        }
                    }
                }
                OptValue::None => {
                }
            }
        }
    }
    if fn_name == "" {
        return ExecOutcome::Panic("a C library callback is not a function value");
    }
    // a Fides function given to C is its adapter's name (`__c_fn_<name>`,
    // lower.fd Lowerer_c_callback); the interpreter calls the function
    fn_name = c_fn_target(fn_name);
    match Interpreter_get_function(self, fn_name) {
        OptIrFunction::Some(callee) => {
            var all: Vec<Value> = Vec::new();
            if callee.params.len() > cargs.len() {
                if env_ptr > 0 {
                    all.push(Value::Ptr(env_ptr));
                } else {
                    all.push(Value::Int(0));
                }
            }
            var ci: i64 = 0;
            while ci < cargs.len() {
                all.push(cargs.get(ci));
                ci = ci + 1;
            }
            match Interpreter_run_function(self, callee, all) {
                RunResult::Return(rv) => {
                    return ExecOutcome::Value(rv);
                }
                RunResult::Panic(pm) => {
                    return ExecOutcome::Panic(pm);
                }
                RunResult::Paused => {
                    return ExecOutcome::Panic("a C library callback cannot wait (task_yield, await, a channel)");
                }
            }
        }
        OptIrFunction::None => {
        }
    }
    return ExecOutcome::Panic("Unknown function in a C library callback: '" + fn_name + "'");
}

/// Swap two `size`-byte elements of the interpreter's memory (word by word
/// when the size allows, so a word the memory keeps a value for moves whole).
fn Interpreter_libc_swap(self: &mut Interpreter, a: i64, b: i64, size: i64) {
    if size % 8 == 0 {
        var w: i64 = 0;
        while w < size {
            var x: i64 = Memory_load_i64(&self.memory, a + w);
            var y: i64 = Memory_load_i64(&self.memory, b + w);
            Memory_store_i64(&mut self.memory, a + w, y);
            Memory_store_i64(&mut self.memory, b + w, x);
            w = w + 8;
        }
        return;
    }
    var k: i64 = 0;
    while k < size {
        var bx: i64 = Memory_load_byte(&self.memory, a + k);
        var by: i64 = Memory_load_byte(&self.memory, b + k);
        Memory_store_byte(&mut self.memory, a + k, by);
        Memory_store_byte(&mut self.memory, b + k, bx);
        k = k + 1;
    }
}

/// qsort(base, n, size, cmp): an insertion sort in place, `cmp` called on
/// the addresses of the array's own elements as C's qsort calls it.
pub fn Interpreter_libc_qsort(self: &mut Interpreter, args: Vec<Value>) -> ExecOutcome {
    var an: i64 = args.len();
    var base: i64 = arg_int_or_ptr(args, an - 4);
    var count: i64 = arg_int_or_ptr(args, an - 3);
    var size: i64 = arg_int_or_ptr(args, an - 2);
    var cmp: Value = args.get(an - 1);
    if base == 0 || count < 2 || size <= 0 {
        return ExecOutcome::Value(Value::Void);
    }
    var i: i64 = 1;
    while i < count {
        var j: i64 = i;
        while j > 0 {
            var pa: i64 = base + (j - 1) * size;
            var pb: i64 = base + j * size;
            var cargs: Vec<Value> = Vec::new();
            cargs.push(Value::Ptr(pa));
            cargs.push(Value::Ptr(pb));
            var c: i64 = 0;
            match Interpreter_call_fn_value(self, cmp, cargs) {
                ExecOutcome::Value(cv) => {
                    c = interp_cb_i32(cv);
                }
                ExecOutcome::Panic(pm) => {
                    return ExecOutcome::Panic(pm);
                }
                _ => {
                }
            }
            if c <= 0 {
                j = 0;
            } else {
                Interpreter_libc_swap(self, pa, pb, size);
                j = j - 1;
            }
        }
        i = i + 1;
    }
    return ExecOutcome::Value(Value::Void);
}

/// bsearch(key, base, n, size, cmp): the element `cmp(key, element)` finds
/// equal (glibc's halving order), or a null pointer.
pub fn Interpreter_libc_bsearch(self: &mut Interpreter, args: Vec<Value>) -> ExecOutcome {
    var an: i64 = args.len();
    var key: Value = args.get(an - 5);
    var base: i64 = arg_int_or_ptr(args, an - 4);
    var count: i64 = arg_int_or_ptr(args, an - 3);
    var size: i64 = arg_int_or_ptr(args, an - 2);
    var cmp: Value = args.get(an - 1);
    var lo: i64 = 0;
    var hi: i64 = count;
    while lo < hi && base != 0 && size > 0 {
        var mid: i64 = (lo + hi) / 2;
        var p: i64 = base + mid * size;
        var cargs: Vec<Value> = Vec::new();
        cargs.push(key);
        cargs.push(Value::Ptr(p));
        var c: i64 = 0;
        match Interpreter_call_fn_value(self, cmp, cargs) {
            ExecOutcome::Value(cv) => {
                c = interp_cb_i32(cv);
            }
            ExecOutcome::Panic(pm) => {
                return ExecOutcome::Panic(pm);
            }
            _ => {
            }
        }
        if c < 0 {
            hi = mid;
        } else if c > 0 {
            lo = mid + 1;
        } else {
            return ExecOutcome::Value(Value::Ptr(p));
        }
    }
    return ExecOutcome::Value(Value::Int(0));
}

// Interpreted signals: bit n set when signal n is registered / pending
var g_interp_sig_registered: i64 = 0;
var g_interp_sig_pending: i64 = 0;
fn outcome_is_unhandled(o: ExecOutcome) -> bool {
    match o {
        ExecOutcome::Jump(j) => {
            return j == -99;
        }
        _ => {
        }
    }
    return false;
}
