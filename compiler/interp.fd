pub fn Interpreter_cov_count(self: &Interpreter) -> i64 {
    return self.cov_ids.len();
}
pub fn Interpreter_cov_fn(self: &Interpreter, i: i64) -> str {
    return self.cov_fns.get(i);
}
pub fn Interpreter_cov_id(self: &Interpreter, i: i64) -> i64 {
    return self.cov_ids.get(i);
}

/// CT8 branch coverage, after a run with Interpreter_set_debug_hook: every
/// conditional branch of the functions named in `user_fns` (all functions
/// when it is empty) that has a source line counts two ways, taken and not
/// taken. The text is a "Branches:" summary line, then one line per way
/// never taken ("  f line 12: true never taken").
pub fn Interpreter_branch_report(self: &Interpreter, user_fns: Vec<str>) -> str {
    var total: i64 = 0;
    var covered: i64 = 0;
    var missing: str = "";
    var fi: i64 = 0;
    while fi < self.module.functions.len() {
        var func: IrFunction = self.module.functions.get(fi).func;
        var wanted: bool = user_fns.len() == 0;
        var ui: i64 = 0;
        while !wanted && ui < user_fns.len() {
            if user_fns.get(ui) == func.name {
                wanted = true;
            }
            ui = ui + 1;
        }
        if wanted {
            var ii: i64 = 0;
            while ii < func.insts.len() {
                var vi: ValueIdInst = func.insts.get(ii);
                match vi.inst {
                    Inst::Branch(_, tb, eb) => {
                        var line: i64 = 0;
                        match IrFunction_get_meta(&func, vi.id) {
                            OptValueMeta::Some(meta) => {
                                match meta.source_line {
                                    OptU64::Some(sl) => {
                                        line = sl as i64;
                                    }
                                    OptU64::None => {
                                    }
                                }
                            }
                            OptValueMeta::None => {
                            }
                        }
                        if tb != eb && line > 0 {
                            total = total + 2;
                            var key: str = func.name + "#" + int_to_str(vi.id);
                            if HashMap_get(self.cov_br_seen, key + "#T") != 0 {
                                covered = covered + 1;
                            } else {
                                missing = missing + "  " + func.name + " line " + int_to_str(line) + ": true never taken\n";
                            }
                            if HashMap_get(self.cov_br_seen, key + "#F") != 0 {
                                covered = covered + 1;
                            } else {
                                missing = missing + "  " + func.name + " line " + int_to_str(line) + ": false never taken\n";
                            }
                        }
                    }
                    _ => {
                    }
                }
                ii = ii + 1;
            }
        }
        fi = fi + 1;
    }
    var pct: str = "100.0";
    if total > 0 {
        var tenths: i64 = covered * 1000 / total;
        pct = int_to_str(tenths / 10) + "." + int_to_str(tenths % 10);
    }
    var text: str = "Branches:      " + int_to_str(covered) + "/" + int_to_str(total) + " (" + pct + "%)\n";
    if str_len(missing) > 0 {
        text = text + "Branches never taken:\n" + missing;
    }
    return text;
}

