    // ─── String runtime functions (ported from src/interp.rs ~3288-3455) ───
    if name == "p_string_from" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Int(i) => {
                    // null (`0 as str`): "" as the C runtime (p_str_alloc_c(0))
                    if i == 0 {
                        return ExecOutcome::Value(Value::Str(""));
                    }
                    return ExecOutcome::Value(Value::Str(int_to_str(i)));
                }
                Value::Float(f) => {
                    return ExecOutcome::Value(Value::Str(interp_f64_text(f)));
                }
                Value::Bool(b) => {
                    if b {
                        return ExecOutcome::Value(Value::Str("true"));
                    }
                    return ExecOutcome::Value(Value::Str("false"));
                }
                Value::Str(s) => {
                    return ExecOutcome::Value(Value::Str(s));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Str(""));
    }
    if name == "p_string_len" {
        if args.len() > 0 {
            match args.get(0) {
                Value::Str(s) => {
                    return ExecOutcome::Value(Value::Int(str_len(s)));
                }
                _ => {
                }
            }
        }
        return ExecOutcome::Value(Value::Int(0));
    }
    if name == "p_string_is_empty" {
