// compiler.fd -- Compiler pipeline driver (rewritten from src/compiler.rs)
//
// This module provides:
// 1. Helper functions and utilities (edit_distance, error enrichment, string/path
//    helpers, capability checking) -- fully functional and tested.
// 2. Pipeline orchestration functions (build_program_with_path, lower_to_ir_module,
//    ccompile_source_with_path, etc.) -- fully functional.
// 3. AST transformation passes (merge_programs, apply_cfg_filter, process_derive,
//    desugar_layers_models, fill_default_trait_methods) -- fully functional.
// 4. Capability stripping (strip_ungranted_caps) -- fully functional.
//
// Adaptations from Rust:
// 1. Result<T, Vec<String>> -> custom Result types (ResultProgram, ResultStr, etc.)
// 2. &str -> str, usize -> i64
// 3. HashSet<T> -> Vec<T> with str_vec_contains helper
// 4. Path operations -> string manipulation (path_dirname, path_join)
// 5. include_str! -> file_read at runtime (stdlib/core.fd loaded from disk)
// 6. No closures -- all helpers are top-level functions
// 7. No ? operator -- explicit match on Result types

module compiler::compiler;
use core;
use vec;
use string;
use compiler::ast;
use compiler::token;
use compiler::lexer;
use compiler::parser;
use compiler::ir;
use compiler::typechecker;
use compiler::lower;
use compiler::mono;
use compiler::borrowck;
use compiler::escape;
use compiler::lockcheck;
use compiler::secrecy;
use compiler::codegen_c;
use compiler::comptime_eval;
use compiler::cparser;
use compiler::pe_ir;
use compiler::inc;
use compiler::interp;
use compiler::ast_ser;
use compiler::reach;
use compiler::green_thread;
use compiler::elf64;
use compiler::linker;
use compiler::x86;
use compiler::wasm;
use compiler::iropt;
use compiler::cowcheck;
use compiler::ir_ser;
use compiler::build_info;
// ===========================================================================
// Result types (Fides has no generic Result<T,E>)
// ===========================================================================

pub enum ResultStr {
    Ok(str),
    Err(Vec<str>),
}

pub enum ResultProgram {
    Ok(Program),
    Err(Vec<str>),
}

pub enum ResultIrModule {
    Ok(IrModule),
    Err(Vec<str>),
}

// ResultBytes moved to compiler::ir (shared with backends that cannot
// import this module).

/// G8.7: Result type for lint_source — Ok holds a Vec<str> of warnings.
pub enum ResultVecStr {
    Ok(Vec<str>),
    Err(Vec<str>),
}

/// G8.7: Program + lint warnings (returned by build_program_with_lints).
pub struct ProgramAndWarnings {
    pub program: Program,
    pub warnings: Vec<str>,
}

pub enum ResultProgramAndWarnings {
    Ok(ProgramAndWarnings),
    Err(Vec<str>),
}

pub struct CompileResult {
    pub assembly: str,
}

// ===========================================================================
// Error codes (mirrors crate::diag::ErrCode)
// ===========================================================================

pub enum ErrCode {
    UndefinedVariable,
    UndefinedFunction,
    UndefinedStruct,
    UndefinedField,
    TypeMismatch,
    IfConditionNotBool,
    ArgCountMismatch,
    MissingReturn,
    InitBeforeAssign,
    NotLinear,
    CapabilityDenied,
    SandboxViolation,
    ConservationViolation,
    GasExceeded,
    EffectMismatch,
    ExpectedToken,
    UnexpectedChar,
    BorrowConflict,
    NoMain,
    Custom,
    // CE4: classes classify_error gives beyond the fidesc set
    UnterminatedString,
    UnterminatedFString,
    UnknownEscape,
    DuplicateDefinition,
    TaintViolation,
    NonExhaustiveMatch,
    OtherTypeError,
    DataRace,
    Deadlock,
    SafetyViolation,
    ConstantTimeViolation,
    RealtimeViolation,
    // CE4: the other checks' errors ("Event error", "Contract error", ...)
    OtherCheck,
    // CA6: a task never awaited, joined or detached ("Concurrency error")
    UnjoinedTask,
}

pub fn errcode_to_str(code: ErrCode) -> str {
    match code {
        ErrCode::UndefinedVariable => {
            return "UndefinedVariable";
        }
        ErrCode::UndefinedFunction => {
            return "UndefinedFunction";
        }
        ErrCode::UndefinedStruct => {
            return "UndefinedStruct";
        }
        ErrCode::UndefinedField => {
            return "UndefinedField";
        }
        ErrCode::TypeMismatch => {
            return "TypeMismatch";
        }
        ErrCode::IfConditionNotBool => {
            return "IfConditionNotBool";
        }
        ErrCode::ArgCountMismatch => {
            return "ArgCountMismatch";
        }
        ErrCode::MissingReturn => {
            return "MissingReturn";
        }
        ErrCode::InitBeforeAssign => {
            return "InitBeforeAssign";
        }
        ErrCode::NotLinear => {
            return "NotLinear";
        }
        ErrCode::CapabilityDenied => {
            return "CapabilityDenied";
        }
        ErrCode::SandboxViolation => {
            return "SandboxViolation";
        }
        ErrCode::ConservationViolation => {
            return "ConservationViolation";
        }
        ErrCode::GasExceeded => {
            return "GasExceeded";
        }
        ErrCode::EffectMismatch => {
            return "EffectMismatch";
        }
        ErrCode::ExpectedToken => {
            return "ExpectedToken";
        }
        ErrCode::UnexpectedChar => {
            return "UnexpectedChar";
        }
        ErrCode::BorrowConflict => {
            return "BorrowConflict";
        }
        ErrCode::NoMain => {
            return "NoMain";
        }
        ErrCode::Custom => {
            return "Custom";
        }
        ErrCode::UnterminatedString => {
            return "UnterminatedString";
        }
        ErrCode::UnterminatedFString => {
            return "UnterminatedFString";
        }
        ErrCode::UnknownEscape => {
            return "UnknownEscape";
        }
        ErrCode::DuplicateDefinition => {
            return "DuplicateDefinition";
        }
        ErrCode::TaintViolation => {
            return "TaintViolation";
        }
        ErrCode::NonExhaustiveMatch => {
            return "NonExhaustiveMatch";
        }
        ErrCode::OtherTypeError => {
            return "OtherTypeError";
        }
        ErrCode::DataRace => {
            return "DataRace";
        }
        ErrCode::Deadlock => {
            return "Deadlock";
        }
        ErrCode::SafetyViolation => {
            return "SafetyViolation";
        }
        ErrCode::ConstantTimeViolation => {
            return "ConstantTimeViolation";
        }
        ErrCode::RealtimeViolation => {
            return "RealtimeViolation";
        }
        ErrCode::OtherCheck => {
            return "OtherCheck";
        }
        ErrCode::UnjoinedTask => {
            return "UnjoinedTask";
        }
    }
    return "Custom";
}

/// TL2: the stable code of an error class, as docs/reference/diagnostics.md
/// lists them ("E000": uncategorized).
