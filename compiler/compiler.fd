    match c {
        ErrCode::UndefinedVariable => {
            return "E040";
        }
        ErrCode::UndefinedFunction => {
            return "E041";
        }
        ErrCode::UndefinedStruct => {
            return "E042";
        }
        ErrCode::UndefinedField => {
            return "E043";
        }
        ErrCode::TypeMismatch => {
            return "E044";
        }
        ErrCode::IfConditionNotBool => {
            return "E045";
        }
        ErrCode::ArgCountMismatch => {
            return "E046";
        }
        ErrCode::MissingReturn => {
            return "E047";
        }
        ErrCode::InitBeforeAssign => {
            return "E048";
        }
        ErrCode::NotLinear => {
            return "E050";
        }
        ErrCode::CapabilityDenied => {
            return "E090";
        }
        ErrCode::SandboxViolation => {
            return "E091";
        }
        ErrCode::ConservationViolation => {
            return "E092";
        }
        ErrCode::GasExceeded => {
            return "E093";
        }
        ErrCode::EffectMismatch => {
            return "E110";
        }
        ErrCode::ExpectedToken => {
            return "E020";
        }
        ErrCode::UnexpectedChar => {
            return "E004";
        }
        ErrCode::BorrowConflict => {
            return "E080";
        }
        ErrCode::NoMain => {
            return "E120";
        }
        ErrCode::Custom => {
            return "E000";
        }
        ErrCode::UnterminatedString => {
            return "E001";
        }
        ErrCode::UnterminatedFString => {
            return "E002";
        }
        ErrCode::UnknownEscape => {
            return "E003";
        }
        ErrCode::DuplicateDefinition => {
            return "E060";
        }
        ErrCode::TaintViolation => {
            return "E061";
        }
        ErrCode::NonExhaustiveMatch => {
            return "E062";
        }
        ErrCode::OtherTypeError => {
            return "E079";
        }
        ErrCode::OtherCheck => {
            return "E078";
        }
        ErrCode::DataRace => {
            return "E082";
        }
        ErrCode::Deadlock => {
            return "E083";
        }
        ErrCode::SafetyViolation => {
            return "E097";
        }
        ErrCode::ConstantTimeViolation => {
            return "E098";
        }
        ErrCode::RealtimeViolation => {
            return "E099";
        }
        ErrCode::UnjoinedTask => {
            return "E084";
        }
    }
    return "E000";
}

// ===========================================================================
// Helper types
// ===========================================================================

/// Cache entry: file path -> source content (avoids re-reading from disk)
pub struct PathContent {
    pub path: str,
    pub content: str,
}

pub fn PathContent_new(path: str, content: str) -> PathContent {
    return PathContent {
        path: path, content: content
    };
}

/// Cache entry: file path -> tokens (avoids re-lexing)
pub struct PathTokens {
    pub path: str,
    pub tokens: Vec<Token>,
}

pub fn PathTokens_new(path: str, tokens: Vec<Token>) -> PathTokens {
    return PathTokens {
        path: path, tokens: tokens
    };
}

/// Cache entry: file path -> parsed Program (avoids re-parsing deferred modules)
pub struct PathProgram {
    pub path: str,
    pub prog: Program,
}

pub fn PathProgram_new(path: str, prog: Program) -> PathProgram {
    return PathProgram {
        path: path, prog: prog
    };
}

/// Cached file read -- returns cached content if available, otherwise reads from disk.
fn cached_file_read(cache: &mut Vec<PathContent>, path: str) -> str {
    var i: i64 = 0;
    while i < cache.len() {
        if cache.get(i).path == path {
            return cache.get(i).content;
        }
        i = i + 1;
    }
    var content: str = c_file_read(path);
    cache.push(PathContent_new(path, content));
    return content;
}

/// Cached lex -- returns cached tokens if available, otherwise lexes.
fn cached_lex(token_cache: &mut Vec<PathTokens>, content_cache: &mut Vec<PathContent>, path: str) -> Vec<Token> {
    var i: i64 = 0;
    while i < token_cache.len() {
        if token_cache.get(i).path == path {
            return token_cache.get(i).tokens;
        }
        i = i + 1;
    }
    var source: str = cached_file_read(content_cache, path);
    var lex: Lexer = Lexer::new(source);
    var toks: Vec<Token> = lex.tokenize();
    if lex.errors.len() > 0 {
        // 2g.18: the lexer's own message, against the module's own file
        g_import_lex_errors = enrich_errors(lex.errors, source, path);
    }
    token_cache.push(PathTokens_new(path, toks));
    return toks;
}

// 2g.18: lexer errors of the module cached_lex just tokenized (the import
// loop returns them before the parse turns them into a vaguer error)
var g_import_lex_errors: Vec<str> = Vec::new();

/// SP9: the file `use <import_path>` names, found as the import loop finds a
/// module (.fd and mod.fd candidates in the loop's order; keep the two lists
/// in step); "" when none (the loop then looks for a header itself).
/// Records nothing for incremental builds (only the loop does).
fn imp_module_file(import_path: str, base_dir: str, ark_root: str, project_root: str) -> str {
    var path_str: str = c_platform_module(str_replace(import_path, "::", "/"));
    var candidates: Vec<str> = Vec::new();
    candidates.push(c_path_join(base_dir, str_concat(path_str, ".fd")));
    candidates.push(c_path_join(base_dir, c_path_join(path_str, "mod.fd")));
    ark_push_candidates(&mut candidates, ark_root, path_str);
    candidates.push(c_path_join(stdlib_dir(), str_concat(path_str, ".fd")));
    candidates.push(c_path_join(stdlib_dir(), c_path_join(path_str, "mod.fd")));
    candidates.push(c_path_join(project_root, str_concat(path_str, ".fd")));
    candidates.push(c_path_join(project_root, c_path_join(path_str, "mod.fd")));
    var ci: i64 = 0;
    while ci < candidates.len() {
        if c_file_exists(candidates.get(ci)) {
            return candidates.get(ci);
        }
        ci = ci + 1;
    }
    return "";
}

/// SP9: with FID_PAR=N (2 or more), read and lex the modules of the import
/// closure before the import loop, one breadth-first wave at a time, each
/// wave in up to N threads (lexer.fd lex_texts_par). A file that lexed
/// without an error goes into token_cache, where the loop's cached_lex finds
/// it; a file with a lex error is left to the loop, which lexes it again and
/// reports as before. Parse order and messages are unchanged. Returns the
/// module graph of what it found (lexer.fd ModGraph).
fn imp_prefetch_lex(user: Program, base_dir: str, ark_root: str, project_root: str, nw: i64, content_cache: &mut Vec<PathContent>, token_cache: &mut Vec<PathTokens>) -> ModGraph {
    var g: ModGraph = ModGraph_new();
    // import path -> 1 + its index in g.names; a file -> 1 once lexed
    var seen: i64 = HashMap_new();
    var lexed_files: i64 = HashMap_new();
    var i: i64 = 0;
    while i < user.imports.len() {
        var ip: str = user.imports.get(i).path;
        if ip != "core" && HashMap_get(seen, ip) == 0 {
            g.names.push(ip);
            HashMap_insert(seen, ip, g.names.len());
        }
        i = i + 1;
    }
    var ws: i64 = 0;
    while ws < g.names.len() {
        var we: i64 = g.names.len();
        var texts: Vec<str> = Vec::new();
        var at: Vec<i64> = Vec::new();
        var ix: i64 = ws;
        while ix < we {
            var f: str = "";
            if at_import_flags(g.names.get(ix)) == 0 {
                f = imp_module_file(g.names.get(ix), base_dir, ark_root, project_root);
            }
            g.files.push(f);
            if str_len(f) > 0 && HashMap_get(lexed_files, f) == 0 {
                HashMap_insert(lexed_files, f, 1);
                at.push(texts.len());
                texts.push(cached_file_read(content_cache, f));
            } else {
                at.push(-1);
            }
            ix = ix + 1;
        }
        var lexed: Vec<LexedText> = lex_texts_par(texts, nw);
        ix = ws;
        while ix < we {
            var deps: Vec<i64> = Vec::new();
            var k: i64 = at.get(ix - ws);
            if k >= 0 {
                if lexed.get(k).errors.len() == 0 {
                    token_cache.push(PathTokens_new(g.files.get(ix), lexed.get(k).tokens));
                }
                var ups: Vec<str> = token_use_paths(lexed.get(k).tokens);
                var u: i64 = 0;
                while u < ups.len() {
                    var up: str = ups.get(u);
                    if up != "core" {
                        var n1: i64 = HashMap_get(seen, up);
                        if n1 == 0 {
                            g.names.push(up);
                            n1 = g.names.len();
                            HashMap_insert(seen, up, n1);
                        }
                        deps.push(n1 - 1);
                    }
                    u = u + 1;
                }
            }
            g.deps.push(deps);
            ix = ix + 1;
        }
        ws = we;
    }
    HashMap_drop(seen);
    HashMap_drop(lexed_files);
    return g;
}

// CB2 (complaint-roadmap): the imported modules a long-lived process (fid
// serve, fid fix, fid lsp) parsed in an earlier build, by path with the
// text they were parsed from. A module whose file still holds that text is
// neither lexed nor parsed again: after an edit of one file, only that
// file is. Off for one-shot commands (it keeps every module's AST alive
// for the rest of the build); modcache_enable turns it on. The Programs
// are values (a Vec changed by a later pass is copied first, core's
// Vec_set/vec_own), so a build cannot change what the next one gets.
pub struct ModCacheEntry {
    pub path: str,
    pub src: str,
    pub prog: Program,
}

var g_modcache: Vec<ModCacheEntry> = Vec::new();
var g_modcache_on: bool = false;
// cache hits since the process started (fid serve prints them)
var g_modcache_hits: i64 = 0;

pub fn modcache_enable() {
    g_modcache_on = true;
}

pub fn modcache_hits() -> i64 {
    return g_modcache_hits;
}

/// The Program parsed earlier from `path` when the file still holds the
/// same text.
fn modcache_get(content_cache: &mut Vec<PathContent>, path: str) -> OptProgram {
    if !g_modcache_on {
        return OptProgram::None;
    }
    var i: i64 = 0;
    while i < g_modcache.len() {
        if g_modcache.get(i).path == path {
            var src: str = cached_file_read(content_cache, path);
            if str_len(src) > 0 && g_modcache.get(i).src == src {
                g_modcache_hits = g_modcache_hits + 1;
                return OptProgram::Some(g_modcache.get(i).prog);
            }
            return OptProgram::None;
        }
        i = i + 1;
    }
    return OptProgram::None;
}

/// Keep `prog`, parsed from `path`, for the next build of this process.
fn modcache_put(content_cache: &mut Vec<PathContent>, path: str, prog: Program) {
    if !g_modcache_on {
        return;
    }
    var src: str = cached_file_read(content_cache, path);
    var entry: ModCacheEntry = ModCacheEntry {
        path: path, src: src, prog: prog
    };
    var i: i64 = 0;
    while i < g_modcache.len() {
        if g_modcache.get(i).path == path {
            g_modcache.set(i, entry);
            return;
        }
        i = i + 1;
    }
    g_modcache.push(entry);
}

/// Cached parse -- returns cached Program if available, otherwise parses.
/// This avoids re-parsing modules that were pre-scanned then deferred due to
/// unloaded transitive dependencies. The pre-scan parse is the most expensive
/// step (~4s per module), and deferred modules get re-parsed on re-encounter.
fn cached_parse(parse_cache: &mut Vec<PathProgram>, token_cache: &mut Vec<PathTokens>, content_cache: &mut Vec<PathContent>, path: str, struct_names: Vec<str>, enum_names: Vec<str>) -> OptProgram {
    var i: i64 = 0;
    while i < parse_cache.len() {
        if parse_cache.get(i).path == path {
            return OptProgram::Some(parse_cache.get(i).prog);
        }
        i = i + 1;
    }
    // CB1: the import cache on disk (neither lexed nor parsed on a hit)
    var imp_on: bool = imp_active();
    var imp_k: i64 = 0;
    // imp_scan_empty, not an ImpScan literal: ImpScan is declared below, and
    // the stage-0 compiler (fidesc) parses a struct literal only of a type
    // it has already seen (release A4)
    var sc: ImpScan = imp_scan_empty();
    if imp_on {
        var isrc: str = cached_file_read(content_cache, path);
        sc = imp_scan(isrc);
        if str_len(isrc) == 0 {
            imp_on = false;
        } else {
            imp_k = imp_key(&sc, struct_names, enum_names);
            match imp_load(path, imp_k) {
                OptProgram::Some(cp) => {
                    parse_cache.push(PathProgram_new(path, cp));
                    return OptProgram::Some(cp);
                }
                OptProgram::None => {
                }
            }
        }
    }
    var toks: Vec<Token> = cached_lex(token_cache, content_cache, path);
    if g_import_lex_errors.len() > 0 {
        // the import loop reports them (before any parse, as it always did)
        return OptProgram::None;
    }
    // the `module::name` calls parsed before this module, then its own
    imp_acc_push(take_qualified_calls());
    var tf0: i64 = turbofish_all().len();
    var sec0: bool = parser_saw_secret();
    var parser: Parser = Parser_with_names(toks, struct_names, enum_names);
    var result: ParseResultProgram = parser.parse();
    match result {
        ParseResultProgram::Ok(prog) => {
            parse_cache.push(PathProgram_new(path, prog));
            var mine: Vec<str> = take_qualified_calls();
            imp_acc_push(mine);
            imp_note_imports(prog);
            if imp_on {
                g_imp_parsed = g_imp_parsed + 1;
                // A parse that numbered a turbofish call or saw @secret /
                // @sensitive (parser globals a hit could not set again) is
                // not kept. With the flag already set by an earlier file,
                // only a text without those words is known to have none.
                var keep: bool = turbofish_all().len() == tf0;
                if keep && (sec0 || parser_saw_secret()) {
                    keep = !imp_has_word(&sc, "secret") && !imp_has_word(&sc, "sensitive");
                }
                if keep && !g_imp_broken {
                    imp_save(path, imp_k, imp_import_names(prog), mine, prog);
                }
            }
            return OptProgram::Some(prog);
        }
        ParseResultProgram::Err(_) => {
            // what a failed parse put in the parser's import set is not
            // known: no more cache use in this build
            g_imp_broken = true;
            return OptProgram::None;
        }
    }
}

// --- CB1: import cache on disk ------------------------------------------------
// The modcache above lives only as long as one process. This one keeps the
// Program of each imported module in a file (FID_IMPCACHE_DIR, else TEMP),
// so a later compile neither lexes nor parses a module whose text has not
// changed. A module's parse also depends on what the parser knows when it
// starts: the struct, enum and import names. Only names that occur as words
// of the module's text can change its parse, so the key is the text's hash,
// for each word of the text whether it is a known struct / enum / import
// name, and the compiler's hash. The parser's globals a parse changes are
// put back on a hit: the import set (a parse of `use <name>;`), the
// `module::name` calls (g_imp_qcalls, read by cc_qualify_shadowed_imports).
// A parse that numbered turbofish calls, saw @secret/@sensitive or an
// @import is never kept. The parser's import set is never cleared, so the
// cache is used only by the first build of a process (one-shot commands;
// `fid serve`, `fid fix` and the LSP have the modcache). FID_IMPCACHE=off
// turns it off, for comparing output with and without it.

pub struct ImpScan {
    pub text_hash: i64,
    // word hash -> 1 + index in order
    pub words: i64,
    // the text's distinct words (FNV-1a, as hash_source), first occurrence first
    pub order: Vec<i64>,
}

/// An ImpScan of no text (no word map): what a build with the import
/// cache off holds.
fn imp_scan_empty() -> ImpScan {
    return ImpScan {
        text_hash: 0, words: 0, order: Vec::new()
    };
}

// on in this build (set at its start)
var g_imp_on: bool = false;
// a failed parse or an @import seen: off for the rest of this build
var g_imp_broken: bool = false;
// builds started in this process
var g_imp_builds: i64 = 0;
var g_imp_hits: i64 = 0;
var g_imp_parsed: i64 = 0;
var g_imp_saved: i64 = 0;
// the names in the parser's import set (process-wide, as that set is)
var g_imp_names: i64 = HashMap_new();
var g_imp_names_vec: Vec<str> = Vec::new();
// `module::name` calls taken from the parser (cc_qualify_shadowed_imports
// reads these first, then the parser's own list)
var g_imp_qcalls: Vec<str> = Vec::new();

/// Called when a build starts: the cache is on only in the first build of
/// the process, without the modcache, unless FID_IMPCACHE=off.
fn imp_build_start() {
    g_imp_builds = g_imp_builds + 1;
    g_imp_broken = false;
    g_imp_hits = 0;
    g_imp_parsed = 0;
    g_imp_saved = 0;
    g_imp_on = g_imp_builds == 1 && !g_modcache_on && !g_serve_mode && env_or_empty("FID_IMPCACHE") != "off";
}

fn imp_active() -> bool {
    return g_imp_on && !g_imp_broken;
}

/// `[build] import cache: ...` for this build (empty when it was off).
pub fn impcache_summary() -> str {
    if !g_imp_on {
        return "";
    }
    return "import cache: " + int_to_str(g_imp_hits) + " hit(s), " + int_to_str(g_imp_parsed) + " parsed, " + int_to_str(g_imp_saved) + " saved";
}

fn imp_acc_push(v: Vec<str>) {
    var i: i64 = 0;
    while i < v.len() {
        g_imp_qcalls.push(v.get(i));
        i = i + 1;
    }
}

/// The calls taken so far and the parser's remaining ones, in parse order.
fn imp_take_qcalls() -> Vec<str> {
    var out: Vec<str> = g_imp_qcalls;
    g_imp_qcalls = Vec::new();
    var rest: Vec<str> = take_qualified_calls();
    var i: i64 = 0;
    while i < rest.len() {
        out.push(rest.get(i));
        i = i + 1;
    }
    return out;
}

/// The names a parse of `p` put in the parser's import set (parse_use: the
/// alias, else the path's last segment).
fn imp_import_names(p: Program) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < p.imports.len() {
        var imp: ImportDef = p.imports.get(i);
        var nm: str = path_last(imp.path);
        match imp.alias {
            OptStr::Some(al) => {
                nm = al;
            }
            OptStr::None => {
            }
        }
        if str_len(nm) > 0 {
            out.push(nm);
        }
        i = i + 1;
    }
    return out;
}

/// Mirror what parsing `p` put in the parser's import set. An @import'ed
/// header path (not in that set) turns the cache off for this build.
fn imp_note_imports(p: Program) {
    var i: i64 = 0;
    while i < p.imports.len() {
        if at_import_flags(p.imports.get(i).path) > 0 {
            g_imp_broken = true;
        }
        i = i + 1;
    }
    var names: Vec<str> = imp_import_names(p);
    i = 0;
    while i < names.len() {
        var nm: str = names.get(i);
        if HashMap_get(g_imp_names, nm) == 0 {
            HashMap_insert(g_imp_names, nm, 1);
            g_imp_names_vec.push(nm);
        }
        i = i + 1;
    }
}

fn imp_add_word(words: i64, order: &mut Vec<i64>, h: i64) {
    if HashMap_get_i(words, h) == 0 {
        order.push(h);
        HashMap_insert_i(words, h, order.len());
    }
}

fn imp_word_byte(c: i64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c >= 128;
}

/// One pass over the text: its hash (= hash_source) and its words.
@wrapping
fn imp_scan(src: str) -> ImpScan {
    var th: i64 = 8834263827529598795;
    var words: i64 = HashMap_new();
    var order: Vec<i64> = Vec::new();
    var n: i64 = str_len(src);
    var in_word: bool = false;
    var wh: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(src, i) & 255;
        th = th ^ c;
        th = th * 1099511628211;
        if imp_word_byte(c) {
            if !in_word {
                in_word = true;
                wh = 8834263827529598795;
            }
            wh = wh ^ c;
            wh = wh * 1099511628211;
        } else {
            if in_word {
                imp_add_word(words, &mut order, wh);
                in_word = false;
            }
        }
        i = i + 1;
    }
    if in_word {
        imp_add_word(words, &mut order, wh);
    }
    return ImpScan {
        text_hash: th, words: words, order: order
    };
}

fn imp_has_word(sc: &ImpScan, w: str) -> bool {
    return HashMap_get_i(sc.words, hash_source(w)) != 0;
}

fn imp_is_word(name: str) -> bool {
    if str_len(name) == 0 {
        return false;
    }
    var i: i64 = 0;
    while i < str_len(name) {
        if !imp_word_byte(str_byte_at(name, i) & 255) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Set `bit` in flags for each word of the text that is one of `names`.
/// A name that is not a single word is folded into the returned value.
@wrapping
fn imp_mark(sc: &ImpScan, flags: &mut Vec<i64>, names: Vec<str>, bit: i64) -> i64 {
    var odd: i64 = 0;
    var i: i64 = 0;
    while i < names.len() {
        var nm: str = names.get(i);
        if imp_is_word(nm) {
            var at: i64 = HashMap_get_i(sc.words, hash_source(nm));
            if at > 0 {
                flags.set(at - 1, flags.get(at - 1) | bit);
            }
        } else {
            odd = odd ^ hash_source(int_to_str(bit) + " " + nm);
            odd = odd * 1099511628211;
        }
        i = i + 1;
    }
    return odd;
}

/// The key of a parse of the scanned text with these names known.
@wrapping
fn imp_key(sc: &ImpScan, struct_names: Vec<str>, enum_names: Vec<str>) -> i64 {
    var flags: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < sc.order.len() {
        flags.push(0);
        i = i + 1;
    }
    var odd: i64 = imp_mark(sc, &mut flags, struct_names, 1);
    odd = odd ^ imp_mark(sc, &mut flags, enum_names, 2);
    odd = odd ^ imp_mark(sc, &mut flags, g_imp_names_vec, 4);
    var k: i64 = sc.text_hash;
    i = 0;
    while i < flags.len() {
        k = k ^ flags.get(i);
        k = k * 1099511628211;
        i = i + 1;
    }
    return hash_source("imp1 " + int_to_str(k) + " " + int_to_str(odd) + " " + int_to_str(sc.order.len()) + " " + int_to_str(inc_compiler_hash()));
}

fn imp_dir() -> str {
    var dir: str = env_or_empty("FID_IMPCACHE_DIR");
    if dir == "" {
        dir = env_or_empty("TEMP");
    }
    if dir == "" {
        dir = env_or_empty("TMPDIR");
    }
    if dir == "" {
        dir = "/tmp";
    }
    return dir;
}

/// One file per module path and compiler: a changed key overwrites it.
fn imp_file(path: str) -> str {
    var name: str = int_to_str(hash_source("imp1 " + path + " " + int_to_str(inc_compiler_hash())));
    if str_starts_with(name, "-") {
        name = "n" + str_slice(name, 1, str_len(name));
    }
    return imp_dir() + "/fid-imp-" + name + ".bin";
}

/// Put the parser's import set back as a parse of the module would leave it.
fn imp_replay_names(names: Vec<str>) {
    if names.len() == 0 {
        return;
    }
    var src: str = "";
    var i: i64 = 0;
    while i < names.len() {
        src = src + "use " + names.get(i) + ";\n";
        i = i + 1;
    }
    var lex: Lexer = Lexer::new(src);
    var toks: Vec<Token> = lex.tokenize();
    var no_structs: Vec<str> = Vec::new();
    var no_enums: Vec<str> = Vec::new();
    var p: Parser = Parser_with_names(toks, no_structs, no_enums);
    match p.parse() {
        ParseResultProgram::Ok(_) => {
        }
        ParseResultProgram::Err(_) => {
            g_imp_broken = true;
        }
    }
}

fn imp_load(path: str, key: i64) -> OptProgram {
    var file: str = imp_file(path);
    if p_file_exists(file) == 0 {
        return OptProgram::None;
    }
    var vb: Vec<i64> = p_file_read_bytes(file);
    if vb.len() < 40 {
        return OptProgram::None;
    }
    var r: ArBuf = arbuf_new(vb);
    var magic: i64 = ar_i64(&mut r);
    var ver: i64 = ar_i64(&mut r);
    var stored: i64 = ar_i64(&mut r);
    if magic != 4473417 || ver != 1 || stored != key {
        return OptProgram::None;
    }
    var spath: str = ar_str(&mut r);
    if spath != path {
        return OptProgram::None;
    }
    var names: Vec<str> = ar_strs(&mut r);
    var qcalls: Vec<str> = ar_strs(&mut r);
    var prog: Program = ar_program(&mut r);
    if !r.ok {
        return OptProgram::None;
    }
    imp_replay_names(names);
    imp_acc_push(take_qualified_calls());
    imp_acc_push(qcalls);
    imp_note_imports(prog);
    g_imp_hits = g_imp_hits + 1;
    return OptProgram::Some(prog);
}

fn imp_save(path: str, key: i64, names: Vec<str>, qcalls: Vec<str>, prog: Program) {
    var b: AwBuf = awbuf_new();
    aw_i64(&mut b, 4473417);
    aw_i64(&mut b, 1);
    aw_i64(&mut b, key);
    aw_str(&mut b, path);
    aw_strs(&mut b, names);
    aw_strs(&mut b, qcalls);
    aw_program(&mut b, prog);
    var file: str = imp_file(path);
    // written whole under another name first: a reader never sees half a file
    var tmp: str = file + "." + int_to_str(p_getpid()) + ".tmp";
    if p_file_write_vec(tmp, b.bytes) < 0 {
        return;
    }
    if p_rename(tmp, file) != 0 {
        // Windows' rename does not replace a file
        p_file_delete(file);
        if p_rename(tmp, file) != 0 {
            p_file_delete(tmp);
            return;
        }
    }
    g_imp_saved = g_imp_saved + 1;
}

pub struct I64Pair {
    pub first: i64,
    pub second: i64,
}

pub fn cc_I64Pair_new(first: i64, second: i64) -> I64Pair {
    return I64Pair {
        first: first, second: second
    };
}

pub struct StrTriple {
    pub line: i64,
    pub col: i64,
    pub msg: str,
}

pub fn StrTriple_new(line: i64, col: i64, msg: str) -> StrTriple {
    return StrTriple {
        line: line, col: col, msg: msg
    };
}

// ===========================================================================
// Error enrichment -- extract line/col from error strings and render with
// source context (rewritten from enrich_errors in compiler.rs)
// ===========================================================================

/// Extract (line, col) from an error string.
/// Formats recognized:
///   "Type error (line N): ..."
///   "Parse error at L:C: ..."
///   "Error:L:C: ..."
pub fn extract_line_col(err: str) -> I64Pair {
    // "Type error (line N): ..."
    var idx: i64 = str_find(err, "(line ");
    if idx >= 0 {
        var rest: str = c_str_substr(err, idx + 6, str_len(err));
        var end: i64 = str_find(rest, ")");
        if end >= 0 {
            var line_str: str = c_str_substr(rest, 0, end);
            var line: i64 = c_str_parse_i64(line_str);
            if line > 0 {
                return cc_I64Pair_new(line, 1);
            }
        }
    }

    // "Parse error at L:C: ..."
    idx = str_find(err, "at ");
    if idx >= 0 {
        var rest2: str = c_str_substr(err, idx + 3, str_len(err));
        var colon: i64 = str_find(rest2, ":");
        if colon >= 0 {
            var line_str2: str = c_str_substr(rest2, 0, colon);
            var line2: i64 = c_str_parse_i64(line_str2);
            if line2 > 0 {
                var after_colon: str = c_str_substr(rest2, colon + 1, str_len(rest2));
                var end2: i64 = str_find(after_colon, ":");
                if end2 >= 0 {
                    var col_str: str = c_str_substr(after_colon, 0, end2);
                    var col: i64 = c_str_parse_i64(col_str);
                    if col > 0 {
                        return cc_I64Pair_new(line2, col);
                    }
                }
                return cc_I64Pair_new(line2, 1);
            }
        }
    }

    // "Error:L:C: ..." (lexer format)
    if str_starts_with(err, "Error:") {
        var rest3: str = c_str_substr(err, 6, str_len(err));
        var colon1: i64 = str_find(rest3, ":");
        if colon1 >= 0 {
            var line_str3: str = c_str_substr(rest3, 0, colon1);
            var line3: i64 = c_str_parse_i64(line_str3);
            if line3 > 0 {
                var after: str = c_str_substr(rest3, colon1 + 1, str_len(rest3));
                var colon2: i64 = str_find(after, ":");
                if colon2 >= 0 {
                    var col_str2: str = c_str_substr(after, 0, colon2);
                    var col2: i64 = c_str_parse_i64(col_str2);
                    if col2 > 0 {
                        return cc_I64Pair_new(line3, col2);
                    }
                }
                return cc_I64Pair_new(line3, 1);
            }
        }
    }

    return cc_I64Pair_new(0, 0);
}

/// Parse an error string to extract (line, column, message).
/// Used by LSP for diagnostics.
pub fn parse_error_position(full: str) -> StrTriple {
    // An enriched error: "error[E040]: <message>", then the source around it
    var error: str = full;
    var newline: i64 = str_find(error, "\n");
    if newline > 0 {
        error = c_str_substr(error, 0, newline);
    }
    var mark: i64 = str_find(error, "]: ");
    if str_starts_with(error, "error[") && mark >= 0 {
        error = c_str_substr(error, mark + 3, str_len(error));
    }
    // Format 1: "Error:line:col: message"
    if str_starts_with(error, "Error:") {
        var rest: str = c_str_substr(error, 6, str_len(error));
        var parts: Vec<str> = c_str_split_n(rest, ":", 3);
        if parts.len() >= 3 {
            var line: i64 = c_str_parse_i64(parts.get(0));
            var col: i64 = c_str_parse_i64(parts.get(1));
            return StrTriple_new(line, col, str_trim(parts.get(2)));
        }
    }

    // Format 2: "Type error (line X): message"
    if str_starts_with(error, "Type error") {
        var start: i64 = str_find(error, "(line ");
        if start >= 0 {
            var rest2: str = c_str_substr(error, start + 6, str_len(error));
            var end: i64 = 0;
            while end < str_len(rest2) && char_is_digit(str_byte_at(rest2, end)) {
                end = end + 1;
            }
            if end > 0 {
                var line2: i64 = c_str_parse_i64(c_str_substr(rest2, 0, end));
                return StrTriple_new(line2, 1, error);
            }
        }
        // "Type error:line:col: message"
        if str_starts_with(error, "Type error:") {
            var rest3: str = c_str_substr(error, 11, str_len(error));
            var parts2: Vec<str> = c_str_split_n(rest3, ":", 3);
            if parts2.len() >= 3 {
                var line3: i64 = c_str_parse_i64(str_trim(parts2.get(0)));
                var col3: i64 = c_str_parse_i64(str_trim(parts2.get(1)));
                return StrTriple_new(line3, col3, str_trim(parts2.get(2)));
            }
        }
    }

    // Format 3: "Parse error at line:col: message"
    if str_starts_with(error, "Parse error at ") {
        var rest4: str = c_str_substr(error, 14, str_len(error));
        var parts3: Vec<str> = c_str_split_n(rest4, ":", 3);
        if parts3.len() >= 3 {
            var line4: i64 = c_str_parse_i64(parts3.get(0));
            var col4: i64 = c_str_parse_i64(parts3.get(1));
            return StrTriple_new(line4, col4, str_trim(parts3.get(2)));
        }
    }

    // Any other message that names its line ("Linear type error (line 3)",
    // "Sandbox error ... at 4:2", an enriched " --> file:4:2"): the
    // diagnostic was published at line 1 (0 in LSP) for all of them
    var lc: I64Pair = extract_line_col(full);
    if lc.first > 0 {
        var col5: i64 = lc.second;
        if col5 <= 0 {
            col5 = 1;
        }
        return StrTriple_new(lc.first, col5, error);
    }
    return StrTriple_new(1, 1, error);
}

/// Enrich a list of error strings with source context.
/// Parses the "line N" or "at L:C" from each error string, extracts the
/// corresponding source line, and renders a full diagnostic with caret.
/// Errors that don't have line info are passed through unchanged.
// 2g.27: the file each imported module was loaded from, so an error tagged
// "(module 'm', line N)" is shown against m's own file and line. Filled by
// the import loops (record_module_file); read only on the error path.
var g_mod_file_names: Vec<str> = Vec::new();
var g_mod_file_paths: Vec<str> = Vec::new();

pub fn record_module_file(module: str, path: str) {
    g_mod_file_names.push(module);
    g_mod_file_paths.push(path);
    // M2: the typechecker tells stdlib modules from user ones by their file
    tc_note_module_file(module, path, stdlib_dir());
}

/// M2: tell the typechecker which file the program being compiled is, so a
/// file of the standard library compiled as the program (with `module x;`)
/// keeps the stdlib's exemption. Called right before the program is
/// registered; no path ("" ) means a program that is not a stdlib file.
fn note_program_path(source_path: OptStr) {
    match source_path {
        OptStr::Some(sp) => {
            tc_note_program_file(sp, stdlib_dir());
        }
        OptStr::None => {
            tc_note_program_file("", stdlib_dir());
        }
    }
}

/// The file a module was loaded from, or "" (error path only: a short list).
pub fn module_file_of(module: str) -> str {
    var i: i64 = g_mod_file_names.len() - 1;
    while i >= 0 {
        if g_mod_file_names.get(i) == module {
            return g_mod_file_paths.get(i);
        }
        i = i - 1;
    }
    return "";
}

/// CB9: how many imported modules' files were recorded (record_module_file),
/// and the i-th of them: the link-error report searches their `extern "C"`
/// declarations (main.fd link_error_report).
pub fn module_file_count() -> i64 {
    return g_mod_file_paths.len();
}

pub fn module_file_path_at(i: i64) -> str {
    return g_mod_file_paths.get(i);
}

/// "... (module 'm', line N): ..." -> m (or "" when the error has no tag).
fn module_tag_of(err: str) -> str {
    var at: i64 = str_find(err, "(module '");
    if at < 0 {
        return "";
    }
    var rest: str = c_str_substr(err, at + 9, str_len(err));
    var end: i64 = str_find(rest, "'");
    if end <= 0 {
        return "";
    }
    return c_str_substr(rest, 0, end);
}

/// The N of a "(module 'm', line N)" tag, or 0.
fn module_tag_line(err: str) -> i64 {
    var at: i64 = str_find(err, "', line ");
    if at < 0 {
        return 0;
    }
    var rest: str = c_str_substr(err, at + 8, str_len(err));
    var end: i64 = 0;
    while end < str_len(rest) && char_is_digit(str_byte_at(rest, end)) {
        end = end + 1;
    }
    if end == 0 {
        return 0;
    }
    return c_str_parse_i64(c_str_substr(rest, 0, end));
}

/// An error tagged with an imported module, rendered against that module's
/// file and source line; "" when the module's file or line is unknown.
fn enrich_module_error(err: str) -> str {
    var module: str = module_tag_of(err);
    if str_len(module) == 0 {
        return "";
    }
    var line: i64 = module_tag_line(err);
    if line <= 0 {
        return "";
    }
    var path: str = module_file_of(module);
    if str_len(path) == 0 {
        // core and the merged runtime: stdlib/<module>.fd when it exists
        var guess: str = c_path_join(stdlib_dir(), module + ".fd");
        if c_file_exists(guess) {
            path = guess;
        } else {
            return "";
        }
    }
    var msrc: str = c_file_read(path);
    var mlines: Vec<str> = c_str_lines(msrc);
    if line > mlines.len() {
        return "";
    }
    var source_line: str = mlines.get(line - 1);
    return render_error_with_source(err, path, line, 1, source_line, estimate_span(err, source_line, 1));
}

/// CE9: the places of an error's "note: at ..." lines as files. "at line N"
/// is a line of `file` (the program's own), "at module 'm', line N" one of
/// m's file; both become "at <file>:N". A module whose file is not known
/// keeps its "module 'm', line N".
fn enrich_note_locations(err: str, file: str) -> str {
    val mark: str = "\n    note: at ";
    var at: i64 = str_find(err, mark);
    if at < 0 {
        return err;
    }
    var out: str = "";
    var rest: str = err;
    while at >= 0 {
        var head_end: i64 = at + str_len(mark);
        out = out + c_str_substr(rest, 0, head_end);
        rest = c_str_substr(rest, head_end, str_len(rest));
        var path: str = file;
        if str_starts_with(rest, "module '") {
            path = "";
            var after: str = c_str_substr(rest, 8, str_len(rest));
            var q: i64 = str_find(after, "', line ");
            if q > 0 {
                var module: str = c_str_substr(after, 0, q);
                path = module_file_of(module);
                if str_len(path) == 0 {
                    var guess: str = c_path_join(stdlib_dir(), module + ".fd");
                    if c_file_exists(guess) {
                        path = guess;
                    }
                }
                if str_len(path) > 0 {
                    // what follows is "line N, in 'f': ..."
                    rest = c_str_substr(after, q + 3, str_len(after));
                }
            }
        }
        if str_len(path) > 0 && str_starts_with(rest, "line ") {
            var end: i64 = 5;
            while end < str_len(rest) && char_is_digit(str_byte_at(rest, end)) {
                end = end + 1;
            }
            if end > 5 {
                out = out + path + ":" + c_str_substr(rest, 5, end);
                rest = c_str_substr(rest, end, str_len(rest));
            }
        }
        at = str_find(rest, mark);
    }
    return out + rest;
}

pub fn enrich_errors(errors: Vec<str>, source: str, file: str) -> Vec<str> {
    var source_lines: Vec<str> = c_str_lines(source);
    var result: Vec<str> = Vec::new();

    var i: i64 = 0;
    while i < errors.len() {
        var err: str = enrich_note_locations(errors.get(i), file);
        var in_module: str = enrich_module_error(err);
        if str_len(in_module) > 0 {
            result.push(in_module);
            i = i + 1;
            continue;
        }
        if str_len(module_tag_of(err)) > 0 {
            // a line of another file: never shown against this one
            result.push(err);
            i = i + 1;
            continue;
        }
        // TL2: an undefined name gets the closest name of the program
        err = err + did_you_mean_suffix(err, source);
        // TL2: the error's code (docs/reference/diagnostics.md), as
        // "error[E044]: ..."; an uncategorized one stays plain "error: "
        var code_head: str = "";
        val ecode: ErrCode = classify_error(err);
        match ecode {
            ErrCode::Custom => {
            }
            _ => {
                code_head = "error[" + errcode_number(ecode) + "]: ";
            }
        }
        var lc: I64Pair = extract_line_col(err);
        var line: i64 = lc.first;
        var col: i64 = lc.second;

        if line == 0 || line > source_lines.len() {
            result.push(code_head + err);
            i = i + 1;
            continue;
        }

        var source_line: str = source_lines.get(line - 1);
        var span_len: i64 = estimate_span(err, source_line, col);

        // Build a simple enriched error message with source context
        var rendered: str = render_error_with_source(err, file, line, col, source_line, span_len);
        if str_len(code_head) > 0 && str_starts_with(rendered, "error: ") {
            rendered = code_head + c_str_substr(rendered, 7, str_len(rendered));
        }
        result.push(rendered);

        i = i + 1;
    }

    return result;
}

// --- TL2: "did you mean" for undefined names --------------------------------

/// Is `w` a keyword (never offered as a name)?
fn dym_is_keyword(w: str) -> bool {
    return w == "fn" || w == "var" || w == "val" || w == "if" || w == "else" || w == "while" || w == "for" || w == "in" || w == "return" || w == "match" || w == "use" || w == "pub" || w == "struct" || w == "enum" || w == "impl" || w == "true" || w == "false" || w == "loop" || w == "break" || w == "continue" || w == "const" || w == "mut" || w == "as" || w == "module" || w == "trait" || w == "type";
}

/// Is `c` a byte of an identifier (letter, digit, `_`)?
fn dym_ident_byte(c: i64) -> bool {
    return c == 95 || char_is_digit(c) || char_is_alpha(c);
}

/// The identifiers written in `source`, each once, in order of first
/// appearance: not those in `//` comments or string literals, not numbers.
pub fn source_identifiers(source: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var seen: i64 = HashMap_new();
    var n: i64 = str_len(source);
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(source, i);
        if c == 47 && i + 1 < n && str_byte_at(source, i + 1) == 47 {
            // `//` comment: to the end of the line
            while i < n && str_byte_at(source, i) != 10 {
                i = i + 1;
            }
        } else if c == 34 {
            // string literal, with backslash escapes
            i = i + 1;
            while i < n && str_byte_at(source, i) != 34 {
                if str_byte_at(source, i) == 92 {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
        } else if char_is_digit(c) {
            // a number (0xFF, 1_000, 2u8): not a name
            while i < n && dym_ident_byte(str_byte_at(source, i)) {
                i = i + 1;
            }
        } else if c == 95 || char_is_alpha(c) {
            var j: i64 = i;
            while j < n && dym_ident_byte(str_byte_at(source, j)) {
                j = j + 1;
            }
            var w: str = str_slice(source, i, j);
            if HashMap_get(seen, w) == 0 {
                HashMap_insert(seen, w, 1);
                out.push(w);
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    return out;
}

/// The closest of `cands` to `name` within the edit distance `limit`
/// (the first of equals), or "".
fn dym_closest(name: str, cands: Vec<str>, limit: i64) -> str {
    var best: str = "";
    var best_d: i64 = limit + 1;
    var nlen: i64 = str_len(name);
    var i: i64 = 0;
    while i < cands.len() {
        var w: str = cands.get(i);
        var wlen: i64 = str_len(w);
        var dl: i64 = wlen - nlen;
        if dl < 0 {
            dl = 0 - dl;
        }
        if w != name && dl <= limit && !dym_is_keyword(w) {
            var d: i64 = edit_distance(name, w);
            if d < best_d {
                best_d = d;
                best = w;
            }
        }
        i = i + 1;
    }
    return best;
}

/// For "undefined variable 'x'" or "undefined function 'f'": the line
/// "\n    Fix: did you mean 'y'?" with the closest identifier of the source
/// (for a function, also of core's functions), or "" when nothing is
/// close: an edit distance of at most 1 for names of up to 4 bytes, 2
/// above. `fid fix` and the editor's quick fix apply it.
pub fn did_you_mean_suffix(err: str, source: str) -> str {
    if str_contains(err, "did you mean") {
        return "";
    }
    var is_fn: bool = false;
    var at: i64 = str_find(err, "undefined variable '");
    if at < 0 {
        at = str_find(err, "undefined function '");
        is_fn = true;
    }
    if at < 0 {
        return "";
    }
    // both markers are 20 bytes long
    var rest: str = c_str_substr(err, at + 20, str_len(err));
    var q: i64 = str_find(rest, "'");
    if q <= 0 {
        return "";
    }
    var name: str = c_str_substr(rest, 0, q);
    var limit: i64 = 2;
    if str_len(name) <= 4 {
        limit = 1;
    }
    var best: str = dym_closest(name, source_identifiers(source), limit);
    if str_len(best) == 0 && is_fn {
        match get_cached_stdlib() {
            OptProgram::Some(core_prog) => {
                var names: Vec<str> = Vec::new();
                var fi: i64 = 0;
                while fi < core_prog.funcs.len() {
                    names.push(core_prog.funcs.get(fi).name);
                    fi = fi + 1;
                }
                best = dym_closest(name, names, limit);
            }
            OptProgram::None => {
            }
        }
    }
    if str_len(best) == 0 {
        return "";
    }
    return "\n    Fix: did you mean '" + best + "'?";
}

/// Render an error with source context (simplified version of diag::error_with_source).
fn render_error_with_source(msg: str, file: str, line: i64, col: i64, source_line: str, span_len: i64) -> str {
    var result: str = "";
    result = str_concat(result, "error: ");
    result = str_concat(result, msg);
    result = str_concat(result, "\n  --> ");
    result = str_concat(result, file);
    result = str_concat(result, ":");
    result = str_concat(result, int_to_str(line));
    result = str_concat(result, ":");
    result = str_concat(result, int_to_str(col));
    result = str_concat(result, "\n   | ");
    result = str_concat(result, source_line);
    result = str_concat(result, "\n   | ");

    // Print caret pointing at the error position
    var c: i64 = 1;
    while c < col {
        result = str_concat(result, " ");
        c = c + 1;
    }
    result = str_concat(result, "^");

    var s: i64 = 1;
    while s < span_len {
        result = str_concat(result, "~");
        s = s + 1;
    }

    return result;
}

/// Estimate the span length for the caret.
fn estimate_span(err: str, source_line: str, col: i64) -> i64 {
    // Look for "variable 'name'" pattern
    var idx: i64 = str_find(err, "variable '");
    if idx >= 0 {
        var rest: str = c_str_substr(err, idx + 10, str_len(err));
        var end: i64 = str_find(rest, "'");
        if end >= 0 {
            var name: str = c_str_substr(rest, 0, end);
            if str_contains(source_line, name) {
                return str_len(name);
            }
        }
    }

    // Look for "function 'name'" pattern
    idx = str_find(err, "function '");
    if idx >= 0 {
        var rest2: str = c_str_substr(err, idx + 10, str_len(err));
        var end2: i64 = str_find(rest2, "'");
        if end2 >= 0 {
            var name2: str = c_str_substr(rest2, 0, end2);
            if str_contains(source_line, name2) {
                return str_len(name2);
            }
        }
    }

    // Look for "field 'name'" pattern
    idx = str_find(err, "field '");
    if idx >= 0 {
        var rest3: str = c_str_substr(err, idx + 7, str_len(err));
        var end3: i64 = str_find(rest3, "'");
        if end3 >= 0 {
            var name3: str = c_str_substr(rest3, 0, end3);
            if str_contains(source_line, name3) {
                return str_len(name3);
            }
        }
    }

    return 1;
}

/// Extract help text from an error that contains "Fix:" or "Hint:".
pub fn extract_help(err: str) -> Option<str> {
    var idx: i64 = str_find(err, "Fix: ");
    if idx >= 0 {
        return Option::Some(str_trim(c_str_substr(err, idx + 5, str_len(err))));
    }
    idx = str_find(err, "Hint: ");
    if idx >= 0 {
        return Option::Some(str_trim(c_str_substr(err, idx + 6, str_len(err))));
    }
    return Option::None;
}

/// Classify an error string into an ErrCode.
/// Mirrors classify_error() in src/compiler.rs.
pub fn classify_error(err: str) -> ErrCode {
    // Normalize: strip "(line N)" from "Type error (line N): ..." -> "Type error: ..."
    var normalized: str = err;
    if str_starts_with(err, "Type error (line ") {
        var idx: i64 = str_find(err, "): ");
        if idx >= 0 {
            normalized = str_concat("Type error: ", c_str_substr(err, idx + 3, str_len(err)));
        }
    }

    if str_starts_with(normalized, "Type error: undefined variable") {
        return ErrCode::UndefinedVariable;
    }
    if str_starts_with(normalized, "Type error: undefined function") {
        return ErrCode::UndefinedFunction;
    }
    if str_starts_with(normalized, "Type error: undefined struct") {
        return ErrCode::UndefinedStruct;
    }
    if str_starts_with(normalized, "Type error: struct") && str_contains(normalized, "has no field") {
        return ErrCode::UndefinedField;
    }
    if str_contains(normalized, "cannot assign") {
        return ErrCode::TypeMismatch;
    }
    if str_starts_with(normalized, "Type error: if condition must be bool") {
        return ErrCode::IfConditionNotBool;
    }
    if str_contains(normalized, "expects") && str_contains(normalized, "args") {
        return ErrCode::ArgCountMismatch;
    }
    if str_contains(normalized, "missing return") {
        return ErrCode::MissingReturn;
    }
    if str_starts_with(normalized, "Init error") {
        return ErrCode::InitBeforeAssign;
    }
    if str_starts_with(normalized, "Linear error") || str_contains(normalized, "linear") {
        return ErrCode::NotLinear;
    }
    if str_starts_with(normalized, "Capability error") {
        return ErrCode::CapabilityDenied;
    }
    if str_starts_with(normalized, "Sandbox error") {
        return ErrCode::SandboxViolation;
    }
    if str_starts_with(normalized, "Conservation error") {
        return ErrCode::ConservationViolation;
    }
    if str_starts_with(normalized, "Gas error") {
        return ErrCode::GasExceeded;
    }
    if str_starts_with(normalized, "Effect error") {
        return ErrCode::EffectMismatch;
    }
    if str_starts_with(normalized, "Parse error") {
        return ErrCode::ExpectedToken;
    }
    // CE4: the lexer's "Error:L:C: <message>" by message, then the classes
    // the fidesc set had no code for (docs/reference/diagnostics.md)
    if str_starts_with(normalized, "Error:") || str_starts_with(normalized, "unterminated ") || str_starts_with(normalized, "unknown escape") || str_starts_with(normalized, "invalid hex digit") {
        if str_contains(normalized, "unterminated f-string") {
            return ErrCode::UnterminatedFString;
        }
        if str_contains(normalized, "unterminated string") || str_contains(normalized, "unterminated raw string") || str_contains(normalized, "unterminated char literal") {
            return ErrCode::UnterminatedString;
        }
        if str_contains(normalized, "escape") || str_contains(normalized, "\\x expects") || str_contains(normalized, "to close \\u{") {
            return ErrCode::UnknownEscape;
        }
        return ErrCode::UnexpectedChar;
    }
    if str_starts_with(normalized, "empty char literal") || str_starts_with(normalized, "unexpected character") {
        return ErrCode::UnexpectedChar;
    }
    if str_starts_with(normalized, "borrow error") || str_starts_with(normalized, "Borrow error") {
        return ErrCode::BorrowConflict;
    }
    if str_starts_with(normalized, "Panic:") {
        return ErrCode::NoMain;
    }
    if str_starts_with(normalized, "Duplicate definition") || str_contains(normalized, "conflicting implementations") {
        return ErrCode::DuplicateDefinition;
    }
    if str_starts_with(normalized, "Taint error") {
        return ErrCode::TaintViolation;
    }
    if str_contains(normalized, "non-exhaustive match") {
        return ErrCode::NonExhaustiveMatch;
    }
    if str_starts_with(normalized, "Race error") {
        return ErrCode::DataRace;
    }
    if str_starts_with(normalized, "Deadlock error") {
        return ErrCode::Deadlock;
    }
    if str_starts_with(normalized, "Concurrency error") {
        return ErrCode::UnjoinedTask;
    }
    if str_starts_with(normalized, "Constant-time error") || str_starts_with(normalized, "Security error (constant_time)") {
        return ErrCode::ConstantTimeViolation;
    }
    if str_starts_with(normalized, "Realtime error") || str_starts_with(normalized, "Real-time error") {
        return ErrCode::RealtimeViolation;
    }
    if str_starts_with(normalized, "Safety error") || str_starts_with(normalized, "Determinism error") {
        return ErrCode::SafetyViolation;
    }
    // CE4: the other check classes (E078)
    if str_starts_with(normalized, "Event error") || str_starts_with(normalized, "Redundancy error") || str_starts_with(normalized, "Contract error") || str_starts_with(normalized, "Thread safety error") || str_starts_with(normalized, "Partition error") || str_starts_with(normalized, "Transaction error") || str_starts_with(normalized, "Serverless error") || str_starts_with(normalized, "Differential privacy error") || str_starts_with(normalized, "Comptime error") || str_starts_with(normalized, "Shard error") || str_starts_with(normalized, "Quantization error") || str_starts_with(normalized, "Linear type error") || str_starts_with(normalized, "Checkpoint error") || str_starts_with(normalized, "Budget error") || str_starts_with(normalized, "Visibility error") || str_starts_with(normalized, "Privacy error") || str_starts_with(normalized, "Unknown annotation") || str_starts_with(normalized, "Misplaced annotation") || str_starts_with(normalized, "Differentiability error") || str_starts_with(normalized, "DP error") || str_starts_with(normalized, "Adapter error") || str_starts_with(normalized, "Hermetic error") || str_starts_with(normalized, "Allocator error") || str_starts_with(normalized, "KV cache region error") || str_starts_with(normalized, "Injection error") {
        return ErrCode::OtherCheck;
    }
    if str_starts_with(normalized, "Type error") {
        return ErrCode::OtherTypeError;
    }
    return ErrCode::Custom;
}

// ===========================================================================
// Capability checking
// ===========================================================================

/// Check if an effect name is a capability (Net, IO, FS, etc.)
pub fn is_capability(eff: str) -> bool {
    if eff == "Net" {
        return true;
    }
    if eff == "IO" {
        return true;
    }
    if eff == "FS" {
        return true;
    }
    if eff == "Process" {
        return true;
    }
    if eff == "Env" {
        return true;
    }
    if eff == "Medical" {
        return true;
    }
    return false;
}

// ===========================================================================
// Levenshtein edit distance (for module name suggestions)
// ===========================================================================

pub fn edit_distance(a: str, b: str) -> i64 {
    var a_len: i64 = str_len(a);
    var b_len: i64 = str_len(b);

    if a_len == 0 {
        return b_len;
    }
    if b_len == 0 {
        return a_len;
    }

    // Use a 2D matrix (flattened to 1D)
    var matrix: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i <= a_len {
        var j: i64 = 0;
        while j <= b_len {
            if i == 0 {
                matrix.push(j);
            } else if j == 0 {
                matrix.push(i);
            } else {
                var cost: i64 = 1;
                if str_slice(a, i - 1, i) == str_slice(b, j - 1, j) {
                    cost = 0;
                }

                var del: i64 = matrix.get((i - 1) * (b_len + 1) + j) + 1;
                var ins: i64 = matrix.get(i * (b_len + 1) + (j - 1)) + 1;
                var sub: i64 = matrix.get((i - 1) * (b_len + 1) + (j - 1)) + cost;

                var min_val: i64 = del;
                if ins < min_val {
                    min_val = ins;
                }
                if sub < min_val {
                    min_val = sub;
                }
                matrix.push(min_val);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    return matrix.get(a_len * (b_len + 1) + b_len);
}

// ===========================================================================
// Project root discovery
// ===========================================================================

/// Walk up from `start` to find the project root -- the first directory
/// containing a `stdlib/` or `compiler/` subdirectory.
/// Falls back to `start` itself if none is found.
pub fn find_project_root(start: str) -> str {
    var current: str = start;
    var i: i64 = 0;
    while i < 100 {
        // Check for specific markers that identify the project root
        // (stdlib/core.fd or Cargo.toml) rather than just "stdlib" or "compiler"
        // which could match compiled binaries in subdirectories
        if c_file_exists(c_path_join(current, "stdlib/core.fd")) || c_file_exists(c_path_join(current, "Cargo.toml")) {
            return current;
        }
        var parent: str = c_path_dirname(current);
        if parent == current || str_len(parent) == 0 {
            break;
        }
        current = parent;
        i = i + 1;
    }
    return start;
}

// ===========================================================================
// TL9: pacts installed by `ark install` (compiler/ark.fd)
// ===========================================================================

/// The directory holding the ark.toml of a program in `base_dir` (that
/// directory or one above it), or "" when there is none.
pub fn ark_project_root(base_dir: str) -> str {
    var current: str = base_dir;
    var i: i64 = 0;
    while i < 64 {
        if c_file_exists(c_path_join(current, "ark.toml")) {
            return current;
        }
        var parent: str = c_path_dirname(current);
        if parent == current || str_len(parent) == 0 {
            return "";
        }
        current = parent;
        i = i + 1;
    }
    return "";
}

/// Where `use <path>` (`path_str` with `/` for `::`) finds an installed
/// pact, appended to `candidates`; nothing when `ark_root` is "":
///   ark_modules/<path>.fd, ark_modules/<path>/mod.fd    (a file pact, any path)
///   ark_modules/<p>/lib.fd, ark_modules/<p>/src/lib.fd  (`use p`)
///   ark_modules/<p>/src/<rest>.fd                       (`use p::rest`)
pub fn ark_push_candidates(candidates: &mut Vec<str>, ark_root: str, path_str: str) {
    if str_len(ark_root) == 0 {
        return;
    }
    // CD9 (complaint-roadmap): a pact `ark vendor` copied into vendor/ is
    // looked for first, in the same places, so a checkout with vendor/
    // builds offline with no `ark install`
    ark_push_candidates_in(candidates, c_path_join(ark_root, "vendor"), path_str);
    ark_push_candidates_in(candidates, c_path_join(ark_root, "ark_modules"), path_str);
    // rm-L5A-dev-deps: dev pacts (ark_modules/.dev/<name>) only for `fid test`
    if ark_dev_visible() {
        ark_push_candidates_in(candidates, c_path_join(ark_root, c_path_join("ark_modules", ".dev")), path_str);
    }
    // L5F: a workspace member finds the pacts installed at the root
    var ws: str = ark_workspace_root_of(ark_root);
    if str_len(ws) > 0 {
        ark_push_candidates_in(candidates, c_path_join(ws, "vendor"), path_str);
        ark_push_candidates_in(candidates, c_path_join(ws, "ark_modules"), path_str);
        if ark_dev_visible() {
            ark_push_candidates_in(candidates, c_path_join(ws, c_path_join("ark_modules", ".dev")), path_str);
        }
    }
}

// rm-L5A-dev-deps: dev-dependencies are visible to `fid test` (main.fd
// passes `--dev-deps` to the ccompile it runs) or with FID_ARK_DEV=1, never
// to a normal build
var g_ark_dev_visible: bool = false;

pub fn set_ark_dev_visible(v: bool) {
    g_ark_dev_visible = v;
}

pub fn ark_dev_visible() -> bool {
    return g_ark_dev_visible || env_or_empty("FID_ARK_DEV") == "1";
}

/// L5F: the workspace root above the project in `dir`: the nearest
/// directory above it (at most 8 levels) whose ark.toml has a
/// `[workspace]` section. "" when `dir`'s own ark.toml is the workspace's,
/// or there is none.
pub fn ark_workspace_root_of(dir: str) -> str {
    if str_len(dir) == 0 {
        return "";
    }
    val own: str = c_path_join(dir, "ark.toml");
    if c_file_exists(own) && str_contains(c_file_read(own), "[workspace]") {
        return "";
    }
    var current: str = c_path_dirname(dir);
    var prev: str = dir;
    var i: i64 = 0;
    while i < 8 {
        if current == prev || str_len(current) == 0 {
            return "";
        }
        val toml: str = c_path_join(current, "ark.toml");
        if c_file_exists(toml) && str_contains(c_file_read(toml), "[workspace]") {
            return current;
        }
        prev = current;
        current = c_path_dirname(current);
        i = i + 1;
    }
    return "";
}

/// The places of ark_push_candidates under one directory of pacts.
fn ark_push_candidates_in(candidates: &mut Vec<str>, mods: str, path_str: str) {
    candidates.push(c_path_join(mods, str_concat(path_str, ".fd")));
    candidates.push(c_path_join(mods, c_path_join(path_str, "mod.fd")));
    var slash: i64 = str_find(path_str, "/");
    if slash < 0 {
        candidates.push(c_path_join(mods, c_path_join(path_str, "lib.fd")));
        candidates.push(c_path_join(mods, c_path_join(path_str, "src/lib.fd")));
    } else {
        var pact: str = str_slice(path_str, 0, slash);
        var rest: str = str_slice(path_str, slash + 1, str_len(path_str));
        candidates.push(c_path_join(mods, c_path_join(pact, c_path_join("src", str_concat(rest, ".fd")))));
    }
}

// ===========================================================================
// CD1: per-dependency capabilities in a direct build
// ===========================================================================
// `fid build`, `fid run`, `fid ccompile`, `fid check` (every command that
// goes through build_program_with_path_borrowck) of a program in a project
// whose ark.toml has a [capabilities] section check each pact the program
// imports (a module found in ark_modules/ or vendor/, as
// ark_push_candidates looks for it) against its grant, as `ark build` does
// (compiler/ark.fd ark_cap_check), and fail the same way: the pact, each
// capability it uses and is not granted, where, and the grant line. A pact
// not listed is granted nothing; `"*"` grants everything.
//
// What a pact uses comes from the checked program, not from its text:
//   - the calls of its functions, followed through the stdlib and core (and
//     methods by name, when the type checker inferred IO or Net for them)
//     to the runtime builtins: net, fs, process, env, ffi (cd1_builtin_cap);
//     the walk stops at another pact's functions (each answers for its own)
//   - the effects the type checker inferred for each of its functions and
//     methods: Net is net (also through calls the walk does not see)
//   - its extern declarations: ffi; what its imports ask for (`use core
//     with { IO }`: io), as ark does; `unsafe {` in its files: unsafe
// A pact that is installed but not imported by the program is not linked
// into it and is not checked here (`ark build`/`ark audit` check those).
// FID_ARK_CAPS=off skips the check.

// The modules of this build that came from a pact: module, pact, file
var g_cd1_mods: Vec<str> = Vec::new();
var g_cd1_pacts: Vec<str> = Vec::new();
var g_cd1_files: Vec<str> = Vec::new();
// The project root (the directory of ark.toml) of the build's program
var g_cd1_root: str = "";

fn cd1_reset() {
    g_cd1_mods = Vec::new();
    g_cd1_pacts = Vec::new();
    g_cd1_files = Vec::new();
    g_cd1_root = "";
}

/// The pact of `file` when it lies under the directory of pacts `mods`:
/// the first directory below it (or `<name>` of a file pact `<name>.fd`).
fn cd1_pact_in(file: str, mods: str) -> str {
    var f: str = str_replace(file, "\\", "/");
    var d: str = str_replace(mods, "\\", "/") + "/";
    if !str_starts_with(f, d) {
        return "";
    }
    var rest: str = str_slice(f, str_len(d), str_len(f));
    var slash: i64 = str_find(rest, "/");
    if slash < 0 {
        if str_ends_with(rest, ".fd") {
            return str_slice(rest, 0, str_len(rest) - 3);
        }
        return rest;
    }
    return str_slice(rest, 0, slash);
}

/// The pact `file` (found by `use` in a program of the project at
/// `ark_root`) belongs to, in the places ark_push_candidates searches;
/// "" for any other file.
pub fn cd1_pact_of(file: str, ark_root: str) -> str {
    if str_len(ark_root) == 0 {
        return "";
    }
    var dirs: Vec<str> = Vec::new();
    dirs.push(c_path_join(ark_root, c_path_join("ark_modules", ".dev")));
    dirs.push(c_path_join(ark_root, "ark_modules"));
    dirs.push(c_path_join(ark_root, "vendor"));
    var ws: str = ark_workspace_root_of(ark_root);
    if str_len(ws) > 0 {
        dirs.push(c_path_join(ws, c_path_join("ark_modules", ".dev")));
        dirs.push(c_path_join(ws, "ark_modules"));
        dirs.push(c_path_join(ws, "vendor"));
    }
    var i: i64 = 0;
    while i < dirs.len() {
        var p: str = cd1_pact_in(file, dirs.get(i));
        if str_len(p) > 0 && p != ".dev" {
            return p;
        }
        i = i + 1;
    }
    return "";
}

/// CD1: the import loop's note of module `mod_name`, loaded from `file`.
pub fn cd1_note_module(mod_name: str, file: str, ark_root: str) {
    var pact: str = cd1_pact_of(file, ark_root);
    if str_len(pact) == 0 {
        return;
    }
    g_cd1_root = ark_root;
    g_cd1_mods.push(mod_name);
    g_cd1_pacts.push(pact);
    g_cd1_files.push(file);
}

/// The [capabilities] of an ark.toml: `on` when the section is there;
/// `caps[i]` the comma-joined (lower-case) grants of pact `names[i]`.
pub struct Cd1Grants {
    pub on: bool,
    pub names: Vec<str>,
    pub caps: Vec<str>,
}

/// `line` without a `# comment` (a `#` inside quotes stays).
fn cd1_strip_comment(line: str) -> str {
    var in_q: bool = false;
    var i: i64 = 0;
    while i < str_len(line) {
        var b: i64 = str_byte_at(line, i);
        if b == 34 {
            in_q = !in_q;
        } else if b == 35 && !in_q {
            return str_slice(line, 0, i);
        }
        i = i + 1;
    }
    return line;
}

fn cd1_unquote(s: str) -> str {
    var t: str = str_trim(s);
    if str_len(t) >= 2 && ((str_starts_with(t, "\"") && str_ends_with(t, "\"")) || (str_starts_with(t, "'") && str_ends_with(t, "'"))) {
        return str_slice(t, 1, str_len(t) - 1);
    }
    return t;
}

/// `["net", "fs"]` (or one `"net"`) as `net,fs`.
fn cd1_toml_list(value: str) -> str {
    var v: str = str_trim(value);
    if str_starts_with(v, "[") {
        v = str_slice(v, 1, str_len(v));
    }
    var close: i64 = str_find(v, "]");
    if close >= 0 {
        v = str_slice(v, 0, close);
    }
    var parts: Vec<str> = str_split(v, ",");
    var out: str = "";
    var i: i64 = 0;
    while i < parts.len() {
        var item: str = str_to_lower(cd1_unquote(parts.get(i)));
        if str_len(item) > 0 {
            if str_len(out) > 0 {
                out = out + ",";
            }
            out = out + item;
        }
        i = i + 1;
    }
    return out;
}

/// The [capabilities] of ark.toml text `content` (the reading of
/// compiler/ark.fd ark_cap_grants_of; an array may span lines).
pub fn cd1_grants_of(content: str) -> Cd1Grants {
    var on: bool = false;
    var names: Vec<str> = Vec::new();
    var caps: Vec<str> = Vec::new();
    var lines: Vec<str> = str_split(str_replace(content, "\r", ""), "\n");
    var in_caps: bool = false;
    var open: bool = false;
    var key: str = "";
    var cval: str = "";
    var li: i64 = 0;
    while li < lines.len() {
        var line: str = str_trim(cd1_strip_comment(lines.get(li)));
        li = li + 1;
        if open {
            cval = cval + " " + line;
            if str_contains(line, "]") {
                open = false;
                names.push(key);
                caps.push(cd1_toml_list(cval));
            }
            continue;
        }
        if str_starts_with(line, "[") {
            in_caps = line == "[capabilities]";
            if in_caps {
                on = true;
            }
            continue;
        }
        if !in_caps || str_len(line) == 0 {
            continue;
        }
        var eq: i64 = str_find(line, "=");
        if eq <= 0 {
            continue;
        }
        key = cd1_unquote(str_slice(line, 0, eq));
        cval = str_trim(str_slice(line, eq + 1, str_len(line)));
        if str_starts_with(cval, "[") && !str_contains(cval, "]") {
            open = true;
            continue;
        }
        names.push(key);
        caps.push(cd1_toml_list(cval));
    }
    return Cd1Grants {
        on: on, names: names, caps: caps
    };
}

/// The capabilities `g` grants pact `name` (none when it is not listed).
pub fn cd1_granted(g: Cd1Grants, name: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < g.names.len() {
        if g.names.get(i) == name {
            var parts: Vec<str> = str_split(g.caps.get(i), ",");
            var k: i64 = 0;
            while k < parts.len() {
                if str_len(parts.get(k)) > 0 {
                    out.push(parts.get(k));
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

/// The capability a runtime builtin needs (ark_cap_rules' names, with the
/// type checker's split of IO and Net); "" for one that needs none (the
/// console, the clock, memory, ...).
pub fn cd1_builtin_cap(c: str) -> str {
    if !str_starts_with(c, "p_") {
        return "";
    }
    if str_starts_with(c, "p_socket") || str_starts_with(c, "p_tcp_") || str_starts_with(c, "p_udp_") || str_starts_with(c, "p_dns_") || str_starts_with(c, "p_tls_") || str_starts_with(c, "p_net_") || str_starts_with(c, "p_unix_") {
        return "net";
    }
    if str_starts_with(c, "p_http_") && !str_contains(c, "build") && !str_contains(c, "parse") {
        return "net";
    }
    if str_starts_with(c, "p_file_") || str_starts_with(c, "p_dir_") || c == "p_mkdir" || c == "p_rmdir" || c == "p_rename" || c == "p_remove" || c == "p_fs_read" || c == "p_fs_write" {
        return "fs";
    }
    if c == "p_system" || str_starts_with(c, "p_process_") || c == "p_spawn_process" {
        return "process";
    }
    if c == "p_getenv" || c == "p_env_get" {
        return "env";
    }
    if str_starts_with(c, "p_dl_") || str_starts_with(c, "p_syscall") {
        return "ffi";
    }
    return "";
}

/// What a pact uses: each capability once, with where it was first seen.
pub struct Cd1Use {
    pub names: Vec<str>,
    pub why: Vec<str>,
}

fn cd1_add(u: &mut Cd1Use, cap: str, why: str) {
    if str_len(cap) == 0 || cc_c_str_vec_contains(u.names, cap) {
        return;
    }
    u.names.push(cap);
    u.why.push(why);
}

/// The walk's state: what is still to scan (`codes`: 1 + function index,
/// or -(1 + impl * 65536 + method)), the pact file and the call path that
/// reached each; `seen` the codes already queued.
struct Cd1Walk {
    codes: Vec<i64>,
    files: Vec<str>,
    paths: Vec<str>,
    seen: i64,
    // the bare method names already looked up
    mseen: i64,
}

/// The program's functions by name (1 + index, the first of a name) and
/// its impl methods by bare name (`m_head`/`m_next`/`m_code`: a list per
/// name, as -(1 + impl * 65536 + method)).
struct Cd1Index {
    fns: i64,
    m_head: i64,
    m_next: Vec<i64>,
    m_code: Vec<i64>,
    m_type: Vec<str>,
}

fn cd1_index(program: Program) -> Cd1Index {
    var fns: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var name: str = program.funcs.get(fi).name;
        if HashMap_get(fns, name) == 0 {
            HashMap_insert(fns, name, fi + 1);
        }
        fi = fi + 1;
    }
    var m_head: i64 = HashMap_new();
    var m_next: Vec<i64> = Vec::new();
    var m_code: Vec<i64> = Vec::new();
    var m_type: Vec<str> = Vec::new();
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var mname: str = imp.methods.get(mi).name;
            m_next.push(HashMap_get(m_head, mname));
            m_code.push(0 - (1 + ii * 65536 + mi));
            m_type.push(imp.struct_name);
            HashMap_insert(m_head, mname, m_code.len());
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    return Cd1Index {
        fns: fns, m_head: m_head, m_next: m_next, m_code: m_code, m_type: m_type
    };
}

fn cd1_queue(w: &mut Cd1Walk, code: i64, file: str, path: str) {
    var key: str = int_to_str(code);
    if HashMap_get(w.seen, key) != 0 {
        return;
    }
    HashMap_insert(w.seen, key, 1);
    w.codes.push(code);
    w.files.push(file);
    w.paths.push(path);
}

/// Scan one body of the walk: its builtin calls are what the pact uses;
/// the functions it calls (not another pact's: `stop`) are queued, and
/// the impl methods of a name it calls when the type checker inferred IO
/// or Net for them.
fn cd1_scan(program: Program, ix: Cd1Index, tc: &TypeChecker, body: Vec<Stmt>, file: str, path: str, stop: i64, w: &mut Cd1Walk, u: &mut Cd1Use) {
    var calls: Vec<str> = Vec::new();
    scan_stmts_for_calls(body, &mut calls);
    var ci: i64 = 0;
    while ci < calls.len() {
        var c: str = calls.get(ci);
        ci = ci + 1;
        var cap: str = cd1_builtin_cap(c);
        if str_len(cap) > 0 {
            cd1_add(u, cap, file + " (" + path + " -> " + c + ")");
            continue;
        }
        if HashMap_get(stop, c) != 0 {
            continue;
        }
        var f_at: i64 = HashMap_get(ix.fns, c);
        if f_at != 0 {
            cd1_queue(w, f_at, file, path + " -> " + c);
        }
        var m: i64 = 0;
        if HashMap_get(w.mseen, c) == 0 {
            HashMap_insert(w.mseen, c, 1);
            m = HashMap_get(ix.m_head, c);
        }
        while m != 0 {
            var code: i64 = ix.m_code.get(m - 1);
            var mtype: str = ix.m_type.get(m - 1);
            var effs: Vec<str> = TypeChecker_effects_of(tc, mtype + "." + c);
            if cc_c_str_vec_contains(effs, "IO") || cc_c_str_vec_contains(effs, "Net") {
                cd1_queue(w, code, file, path + " -> " + mtype + "." + c);
            }
            m = ix.m_next.get(m - 1);
        }
    }
}

/// What pact `pact` uses in the checked `program`: the modules of `mods`
/// (named `mod_names`) that belong to it. `stop`: the function and method
/// names of the other pacts' modules.
fn cd1_pact_uses(program: Program, ix: Cd1Index, tc: &TypeChecker, pact: str, mods: Vec<Program>, mod_names: Vec<str>, stop: i64) -> Cd1Use {
    var u: Cd1Use = Cd1Use {
        names: Vec::new(), why: Vec::new()
    };
    var w: Cd1Walk = Cd1Walk {
        codes: Vec::new(), files: Vec::new(), paths: Vec::new(), seen: HashMap_new(), mseen: HashMap_new()
    };
    // the pact's functions and methods, for their inferred effects (after
    // the walk, which names the call that shows a capability)
    var eff_names: Vec<str> = Vec::new();
    var eff_files: Vec<str> = Vec::new();
    var mi: i64 = 0;
    while mi < mods.len() {
        var file: str = "";
        var k: i64 = 0;
        while k < g_cd1_mods.len() {
            if g_cd1_mods.get(k) == mod_names.get(mi) && g_cd1_pacts.get(k) == pact {
                file = g_cd1_files.get(k);
            }
            k = k + 1;
        }
        if str_len(file) > 0 {
            var m: Program = mods.get(mi);
            var fi: i64 = 0;
            while fi < m.funcs.len() {
                var f: Func = m.funcs.get(fi);
                var f_at: i64 = HashMap_get(ix.fns, f.name);
                if f_at != 0 {
                    HashMap_insert(w.seen, int_to_str(f_at), 1);
                }
                eff_names.push(f.name);
                eff_files.push(file);
                cd1_scan(program, ix, tc, f.body, file, f.name, stop, &mut w, &mut u);
                fi = fi + 1;
            }
            var ii: i64 = 0;
            while ii < m.impls.len() {
                var imp: ImplDef = m.impls.get(ii);
                var ki: i64 = 0;
                while ki < imp.methods.len() {
                    var meth: Func = imp.methods.get(ki);
                    var mname: str = imp.struct_name + "." + meth.name;
                    eff_names.push(mname);
                    eff_files.push(file);
                    cd1_scan(program, ix, tc, meth.body, file, mname, stop, &mut w, &mut u);
                    ki = ki + 1;
                }
                ii = ii + 1;
            }
            var ei: i64 = 0;
            while ei < m.extern_decls.len() {
                var ed: ExternDecl = m.extern_decls.get(ei);
                if !str_starts_with(ed.pledge_name, "p_") {
                    cd1_add(&mut u, "ffi", file + " (extern \"" + ed.abi + "\" " + ed.c_name + ")");
                }
                ei = ei + 1;
            }
            var ui: i64 = 0;
            while ui < m.imports.len() {
                var imd: ImportDef = m.imports.get(ui);
                var qi: i64 = 0;
                while qi < imd.capabilities.len() {
                    var qc: str = str_trim(imd.capabilities.get(qi));
                    cd1_add(&mut u, str_to_lower(qc), file + " (use " + imd.path + " with { " + qc + " })");
                    qi = qi + 1;
                }
                ui = ui + 1;
            }
            var src: str = c_file_read(file);
            if str_contains(src, "unsafe {") || str_contains(src, "unsafe{") {
                cd1_add(&mut u, "unsafe", file + " (unsafe {)");
            }
        }
        mi = mi + 1;
    }
    // what those functions call, through the stdlib and core
    var at: i64 = 0;
    while at < w.codes.len() {
        var code: i64 = w.codes.get(at);
        var wfile: str = w.files.get(at);
        var wpath: str = w.paths.get(at);
        at = at + 1;
        if code > 0 {
            cd1_scan(program, ix, tc, program.funcs.get(code - 1).body, wfile, wpath, stop, &mut w, &mut u);
        } else {
            var enc: i64 = 0 - code - 1;
            var imp2: ImplDef = program.impls.get(enc / 65536);
            cd1_scan(program, ix, tc, imp2.methods.get(enc % 65536).body, wfile, wpath, stop, &mut w, &mut u);
        }
    }
    HashMap_drop(w.seen);
    HashMap_drop(w.mseen);
    // the type checker's inferred effects: Net is net, also through what
    // the walk does not follow (calls through function values, methods)
    var ni: i64 = 0;
    while ni < eff_names.len() {
        if cc_c_str_vec_contains(TypeChecker_effects_of(tc, eff_names.get(ni)), "Net") {
            cd1_add(&mut u, "net", eff_files.get(ni) + " (" + eff_names.get(ni) + ": the type checker inferred the Net effect)");
        }
        ni = ni + 1;
    }
    return u;
}

fn cd1_sorted(names: Vec<str>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < names.len() {
        var at: i64 = out.len();
        var k: i64 = 0;
        while k < out.len() {
            if str_compare(names.get(i), out.get(k)) < 0 {
                at = k;
                break;
            }
            k = k + 1;
        }
        out.insert(at, names.get(i));
        i = i + 1;
    }
    return out;
}

/// CD1: each pact the checked `program` imports (`mods`/`mod_names`: the
/// imported modules) against the [capabilities] of the project's ark.toml
/// (the workspace root's in a member). The errors: one per pact that uses
/// a capability it is not granted, in the words of ark_cap_check.
pub fn cd1_check(program: Program, tc: &TypeChecker, mods: Vec<Program>, mod_names: Vec<str>) -> Vec<str> {
    var errs: Vec<str> = Vec::new();
    if g_cd1_pacts.len() == 0 || env_or_empty("FID_ARK_CAPS") == "off" {
        return errs;
    }
    var manifest: str = c_path_join(g_cd1_root, "ark.toml");
    var ws: str = ark_workspace_root_of(g_cd1_root);
    if str_len(ws) > 0 {
        manifest = c_path_join(ws, "ark.toml");
    }
    var g: Cd1Grants = cd1_grants_of(c_file_read(manifest));
    if !g.on {
        return errs;
    }
    var pacts: Vec<str> = Vec::new();
    var pi: i64 = 0;
    while pi < g_cd1_pacts.len() {
        if !cc_c_str_vec_contains(pacts, g_cd1_pacts.get(pi)) {
            pacts.push(g_cd1_pacts.get(pi));
        }
        pi = pi + 1;
    }
    var ix: Cd1Index = cd1_index(program);
    var bad: i64 = 0;
    pi = 0;
    while pi < pacts.len() {
        var pact: str = pacts.get(pi);
        pi = pi + 1;
        var granted: Vec<str> = cd1_granted(g, pact);
        if cc_c_str_vec_contains(granted, "*") {
            continue;
        }
        // the functions of the other pacts' modules: not walked into
        var stop: i64 = HashMap_new();
        var mi: i64 = 0;
        while mi < mods.len() {
            var other: bool = false;
            var k: i64 = 0;
            while k < g_cd1_mods.len() {
                if g_cd1_mods.get(k) == mod_names.get(mi) && g_cd1_pacts.get(k) != pact {
                    other = true;
                }
                k = k + 1;
            }
            if other {
                var om: Program = mods.get(mi);
                var fi: i64 = 0;
                while fi < om.funcs.len() {
                    HashMap_insert(stop, om.funcs.get(fi).name, 1);
                    fi = fi + 1;
                }
            }
            mi = mi + 1;
        }
        var used: Cd1Use = cd1_pact_uses(program, ix, tc, pact, mods, mod_names, stop);
        HashMap_drop(stop);
        var missing: str = "";
        var k2: i64 = 0;
        while k2 < used.names.len() {
            if !cc_c_str_vec_contains(granted, used.names.get(k2)) {
                missing = missing + "  " + used.names.get(k2) + "  " + used.why.get(k2) + "\n";
            }
            k2 = k2 + 1;
        }
        if str_len(missing) > 0 {
            bad = bad + 1;
            var sorted: Vec<str> = cd1_sorted(used.names);
            var list: str = "[";
            var si: i64 = 0;
            while si < sorted.len() {
                if si > 0 {
                    list = list + ", ";
                }
                list = list + "\"" + sorted.get(si) + "\"";
                si = si + 1;
            }
            list = list + "]";
            errs.push("Capability error: pact '" + pact + "' uses capabilities ark.toml does not grant it:\n" + missing + "    Fix: grant them under [capabilities] (" + pact + " = " + list + ") or drop the pact (" + manifest + ")");
        }
    }
    HashMap_drop(ix.fns);
    HashMap_drop(ix.m_head);
    if bad > 0 {
        errs.push("Capability error: " + int_to_str(bad) + " pact(s) use capabilities they are not granted (FID_ARK_CAPS=off skips this check)\n    Fix: grant each pact what it uses under [capabilities] in ark.toml (the errors above name them), or drop the pact");
    }
    return errs;
}

// ===========================================================================
// Pipeline -- parse, typecheck, lower, mono
// ===========================================================================

/// Parse source code into a Program (without stdlib merge).
fn parse_source(source: str) -> ParseResultProgram {
    var lex: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lex.tokenize();
    var p: Parser = Parser_new(tokens);
    return p.parse();
}

/// The user's program as parsed, without the stdlib, type checking or
/// lowering: what an editor can still show symbols from while the code
/// has a type error (fid lsp).
pub fn parse_program_only(source: str) -> OptProgram {
    match parse_source(source) {
        ParseResultProgram::Ok(p) => {
            return OptProgram::Some(p);
        }
        ParseResultProgram::Err(_) => {
        }
    }
    return OptProgram::None;
}

/// Build a program from source code (no path -- no import resolution).
pub fn build_program(source: str) -> ResultProgram {
    return build_program_with_path(source, OptStr::None);
}

/// G8.2: Wrapper that uses default borrowck mode "on".
pub fn build_program_with_path(source: str, source_path: OptStr) -> ResultProgram {
    return build_program_with_path_borrowck(source, source_path, "on");
}

/// Build a program in no-stdlib mode (--bare / --no-std).
/// Skips loading stdlib/core.fd entirely. The user program must define
/// everything it needs, including any runtime functions.
/// This is for kernel/UEFI/bare-metal development where the program
/// must have ZERO hidden runtime dependencies.
pub fn build_program_no_std(source: str, source_path: OptStr) -> ResultProgram {
    // Legacy entry point used by main.fd (--boot / --bare). Those callers do
    // not pass the --borrowck mode through, so no-std builds reached via this
    // function skip borrow checking entirely. Callers that have the mode
    // should use build_program_no_std_borrowck instead.
    return build_program_no_std_borrowck(source, source_path, "off");
}

/// No-std build that honors the borrow-checker mode ("off", "warn", "on")
/// exactly like build_program_with_path_borrowck does for the stdlib path.
pub fn build_program_no_std_borrowck(source: str, source_path: OptStr, borrowck_mode: str) -> ResultProgram {
    p_eprint_str("[build] No-stdlib mode: skipping stdlib/core.fd\n");
    // CB1: counts as a build (its parses fill the parser's import set); its
    // own import loop does not use the import cache
    imp_build_start();
    g_imp_on = false;
    // Parse user code without stdlib names
    var lex: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lex.tokenize();
    if lex.errors.len() > 0 {
        var file: str = "<stdin>";
        match source_path {
            OptStr::Some(p) => {
                file = p;
            }
            OptStr::None => {
            }
        }
        return ResultProgram::Err(enrich_errors(lex.errors, source, file));
    }
    var empty_struct_names: Vec<str> = Vec::new();
    var empty_enum_names: Vec<str> = Vec::new();
    var p: Parser = Parser_with_names(tokens, empty_struct_names, empty_enum_names);
    var user_result: ParseResultProgram = p.parse();
    match user_result {
        ParseResultProgram::Err(e) => {
            var file2: str = "<stdin>";
            match source_path {
                OptStr::Some(p2) => {
                    file2 = p2;
                }
                OptStr::None => {
                }
            }
            return ResultProgram::Err(enrich_errors(c_vec1(e), source, file2));
        }
        ParseResultProgram::Ok(user) => {
            // CB1: this build's parses fill the parser's import set too
            imp_note_imports(user);
            // In no-std mode, skip stdlib merge but DO resolve `use` imports
            // from disk (for multi-module kernels/firmware).
            var program: Program = user;

            // -- Resolve use imports from disk (no stdlib in no-std mode) ----
            var imported_modules: Vec<Program> = Vec::new();
            var imported_module_names: Vec<str> = Vec::new();
            var loaded_module_names: Vec<str> = Vec::new();
            var has_source_path: bool = false;
            var base_dir: str = ".";
            match source_path {
                OptStr::Some(sp) => {
                    has_source_path = true;
                    base_dir = c_path_dirname(sp);
                }
                OptStr::None => {
                }
            }

            if has_source_path && user.imports.len() > 0 {
                p_eprint_str("[build] No-std: resolving imports...\n");
                var project_root: str = find_project_root(base_dir);
                var imports_to_process: Vec<str> = Vec::new();
                var ui: i64 = user.imports.len() - 1;
                while ui >= 0 {
                    imports_to_process.push(user.imports.get(ui).path);
                    ui = ui - 1;
                }
                while imports_to_process.len() > 0 {
                    var import_path: str = imports_to_process.get(imports_to_process.len() - 1);
                    imports_to_process.pop();
                    // Skip "core" -- not available in no-std mode
                    if import_path == "core" {
                        continue;
                    }
                    // Skip already-loaded modules
                    var already_loaded: bool = false;
                    var li: i64 = 0;
                    while li < loaded_module_names.len() {
                        if loaded_module_names.get(li) == import_path {
                            already_loaded = true;
                            break;
                        }
                        li = li + 1;
                    }
                    if already_loaded {
                        continue;
                    }

                    // Try candidate paths (base_dir + project_root, no stdlib)
                    var path_str: str = c_platform_module(str_replace(import_path, "::", "/"));
                    var candidates: Vec<str> = Vec::new();
                    candidates.push(c_path_join(base_dir, str_concat(path_str, ".fd")));
                    candidates.push(c_path_join(base_dir, c_path_join(path_str, "mod.fd")));
                    // TL9: an installed pact
                    ark_push_candidates(&mut candidates, ark_project_root(base_dir), path_str);
                    candidates.push(c_path_join(project_root, str_concat(path_str, ".fd")));
                    candidates.push(c_path_join(project_root, c_path_join(path_str, "mod.fd")));

                    var found_path: str = "";
                    var found: bool = false;
                    var ci: i64 = 0;
                    while ci < candidates.len() {
                        if c_file_exists(candidates.get(ci)) {
                            found_path = candidates.get(ci);
                            found = true;
                            break;
                        }
                        ci = ci + 1;
                    }

                    if found {
                        p_eprint_str("[build] No-std: loading import: ");
                        p_eprint_str(found_path);
                        p_eprint_str("\n");
                        var module_source: str = p_file_read(found_path);
                        if (module_source as i64) == 0 {
                            p_eprint_str("[build] Warning: could not read: ");
                            p_eprint_str(found_path);
                            p_eprint_str("\n");
                            continue;
                        }
                        var empty_struct_names: Vec<str> = Vec::new();
                        var empty_enum_names: Vec<str> = Vec::new();
                        var ilex: Lexer = Lexer::new(module_source);
                        var itokens: Vec<Token> = ilex.tokenize();
                        if ilex.errors.len() > 0 {
                            return ResultProgram::Err(enrich_errors(ilex.errors, module_source, found_path));
                        }
                        var ip: Parser = Parser_with_names(itokens, empty_struct_names, empty_enum_names);
                        var iresult: ParseResultProgram = ip.parse();
                        match iresult {
                            ParseResultProgram::Err(e) => {
                                return ResultProgram::Err(enrich_errors(c_vec1(e), module_source, found_path));
                            }
                            ParseResultProgram::Ok(imported) => {
                                imp_note_imports(imported);
                                var module_name: str = import_path;
                                match imported.module {
                                    OptStr::Some(mn) => {
                                        module_name = mn;
                                    }
                                    OptStr::None => {
                                    }
                                }
                                // Queue transitive imports
                                var ti: i64 = 0;
                                while ti < imported.imports.len() {
                                    var trans_path: str = imported.imports.get(ti).path;
                                    var trans_loaded: bool = false;
                                    var tli: i64 = 0;
                                    while tli < loaded_module_names.len() {
                                        if loaded_module_names.get(tli) == trans_path {
                                            trans_loaded = true;
                                            break;
                                        }
                                        tli = tli + 1;
                                    }
                                    if !trans_loaded && trans_path != "core" {
                                        imports_to_process.push(trans_path);
                                    }
                                    ti = ti + 1;
                                }
                                loaded_module_names.push(import_path);
                                imported_modules.push(imported);
                                imported_module_names.push(module_name);
                                record_module_file(module_name, found_path);
                                ir_note_program_files(&imported, found_path);
                            }
                        }
                    }
                }
            }

            // Apply desugar and default trait methods
            desugar_layers_models(&mut program);
            desugar_phase8b(&mut program);
            ct_sync_target();
            program = process_gen(program);
            fill_default_trait_methods(&mut program);

            // Merge imported modules into the program (imports first, user wins)
            var mi: i64 = 0;
            while mi < imported_modules.len() {
                program = merge_programs(program, imported_modules.get(mi));
                mi = mi + 1;
            }
            // L8E: variadic calls packed, as the main build does
            program = mono_desugar_variadics(program);

            // Typecheck — register imported modules first, then user
            p_eprint_str("[build] No-std: typechecking (no stdlib)...\n");
            var tc: TypeChecker = TypeChecker::new();
            // Register imported modules first so their functions are visible
            var mi2: i64 = 0;
            while mi2 < imported_modules.len() {
                TypeChecker_register_program(&mut tc, imported_modules.get(mi2), imported_module_names.get(mi2));
                mi2 = mi2 + 1;
            }
            var user_module: str = "main";
            match user.module {
                OptStr::Some(m2) => {
                    user_module = m2;
                }
                OptStr::None => {
                }
            }
            note_program_path(source_path);
            TypeChecker_register_program(&mut tc, user, user_module);
            TypeChecker_register_trait_impls(&mut tc, program);
            TypeChecker_register_generated_decls(&mut tc, program);
            TypeChecker_verify_trait_impls(&mut tc, program);
            TypeChecker_collect_capabilities(&mut tc, user);
            TypeChecker_check_bodies(&mut tc, program);
            // Also check imported module bodies
            var mi3: i64 = 0;
            while mi3 < imported_modules.len() {
                TypeChecker_collect_capabilities(&mut tc, imported_modules.get(mi3));
                TypeChecker_check_bodies(&mut tc, imported_modules.get(mi3));
                mi3 = mi3 + 1;
            }
            if tc.errors.len() > 0 {
                var file3: str = "<stdin>";
                match source_path {
                    OptStr::Some(p3) => {
                        file3 = p3;
                    }
                    OptStr::None => {
                    }
                }
                return ResultProgram::Err(enrich_errors(tc.errors, source, file3));
            }
            var escape_errors: Vec<str> = escape_check(program);
            if escape_errors.len() > 0 {
                var file6: str = "<stdin>";
                match source_path {
                    OptStr::Some(p6) => {
                        file6 = p6;
                    }
                    OptStr::None => {
                    }
                }
                return ResultProgram::Err(enrich_errors(escape_errors, source, file6));
            }
            var secret_errors: Vec<str> = secrecy_check(program);
            if secret_errors.len() > 0 {
                var file7: str = "<stdin>";
                match source_path {
                    OptStr::Some(p7) => {
                        file7 = p7;
                    }
                    OptStr::None => {
                    }
                }
                return ResultProgram::Err(enrich_errors(secret_errors, source, file7));
            }
            // G8.2: Borrow check -- same mode handling as the stdlib path.
            //   "off"  : skip borrow checking entirely
            //   "warn" : report errors as warnings, don't fail
            //   "on"   : report errors and fail compilation
            if borrowck_mode != "off" {
                p_eprint_str("[build] No-std: borrow checking (mode=");
                p_eprint_str(borrowck_mode);
                p_eprint_str(")...\n");
                var bc_mode: BorrowckMode = BorrowckMode::On;
                if borrowck_mode == "warn" {
                    bc_mode = BorrowckMode::Warn;
                }
                var bc: BorrowChecker = BorrowChecker_new(bc_mode);
                check(&mut bc, program);
                // Warn mode collects into bc.warnings (known-bugs 2g.9: nothing was
                // printed, the code below reads bc.errors only)
                var wi: i64 = 0;
                while wi < bc.warnings.len() {
                    p_eprint_str("warning: ");
                    p_eprint_str(bc.warnings.get(wi));
                    p_eprint_str("
");
                    wi = wi + 1;
                }
                if bc.errors.len() > 0 {
                    var file4: str = "<stdin>";
                    match source_path {
                        OptStr::Some(p4) => {
                            file4 = p4;
                        }
                        OptStr::None => {
                        }
                    }
                    if borrowck_mode == "warn" {
                        var ei: i64 = 0;
                        while ei < bc.errors.len() {
                            p_eprint_str("warning: ");
                            p_eprint_str(bc.errors.get(ei));
                            p_eprint_str("\n");
                            ei = ei + 1;
                        }
                    } else {
                        return ResultProgram::Err(enrich_errors(bc.errors, source, file4));
                    }
                }
            } else {
                p_eprint_str("[build] No-std: borrow checking skipped (mode=off).\n");
            }
            // Monomorphize
            p_eprint_str("[build] No-std: monomorphizing...\n");
            var mono_result: Program = monomorphize(program);
            return ResultProgram::Ok(mono_result);
        }
    }
}

/// Build a program with optional file path for resolving `use` imports.
/// Cached parsed stdlib for LSP (avoids re-parsing on every keystroke).
/// Uses module-level vars for persistence across calls in a single process.
pub var g_stdlib_cache: OptProgram = OptProgram::None;
var g_stdlib_struct_names: Vec<str> = Vec::new();
var g_stdlib_enum_names: Vec<str> = Vec::new();
var g_stdlib_cache_init: bool = false;  // Hash of core.fd's text (release D9: a core checked clean once is not
// checked again by the same compiler)
var g_stdlib_hash: i64 = 0;
var g_stdlib_dir_found: bool = false;
var g_stdlib_dir: str = "stdlib";  // Native Windows emit: merge the Fides PE runtime (pe_runtime/*.fd) into
// core before the user program parses, as Rust's build_program_with_runtime
// does, so a call to builtin `p_X` can run `pert_X` (see pe_ir resolve_call).
pub var g_pe_runtime_merge: bool = false;
pub fn set_pe_runtime_merge(v: bool) {
    g_pe_runtime_merge = v;
}
/// The runtime merged: "pe_runtime" (native Windows), or "linux_runtime"
/// (native Linux AArch64 / RISC-V, compiler/nat_ir.fd, release F8)
pub var g_native_rt_dir: str = "pe_runtime";  // Windows x64 on the machine layer (`fid emit --nat`): the Linux runtime
// plus its Windows layer (linux_runtime/win.fd)
pub var g_native_rt_win: bool = false;  // macOS on the machine layer (`fid emit --target *-macos`): the Linux
// runtime plus its macOS layer (linux_runtime/darwin.fd)
pub var g_native_rt_mac: bool = false;  // WebAssembly (`fid wasm`, compiler/wasm.fd): the Linux runtime plus its
// WASI layer (linux_runtime/wasi.fd)
pub var g_native_rt_wasi: bool = false;
pub fn set_native_runtime(dir: str) {
    g_native_rt_dir = dir;
    g_pe_runtime_merge = true;
}

/// Locate a PE runtime source file: under stdlib/pe_runtime/ (repo and
/// installed layouts alike), with a legacy src/pe_runtime/ fallback.
pub fn pe_runtime_path(name: str) -> str {
    var p1: str = c_path_join(stdlib_dir(), c_path_join(g_native_rt_dir, name));
    if c_file_exists(p1) {
        return p1;
    }
    return c_path_join("src", c_path_join(g_native_rt_dir, name));
}

/// The standard library's directory: ./stdlib (the repository), else that
/// of an installed toolchain: $FID_HOME/stdlib, <exe dir>/stdlib,
/// <exe dir>/../stdlib (as the Rust compiler looks).
/// `use tls` is a different module on each system.
pub fn c_platform_module(path: str) -> str {
    if path == "tls" {
        // TL6: a cross build takes the target's module, not the host's
        if g_cfg_os == "windows" {
            return "tls_windows";
        }
        if g_cfg_os == "linux" || g_cfg_os == "macos" || g_cfg_os == "freebsd" {
            return "tls_unix";
        }
        // the host: Windows sets OS=Windows_NT (macOS has no /proc, so the
        // /proc test alone took a Mac for Windows)
        if c_file_exists("/proc/self/exe") || env_or_empty("OS") != "Windows_NT" {
            return "tls_unix";
        }
        return "tls_windows";
    }
    if path == "crypto_bind" {
        // J5: BCrypt on Windows, the libcrypto twin on Linux and macOS
        // (same cb_* functions); a cross build follows the target
        if g_cfg_os == "windows" {
            return "crypto_bind";
        }
        if g_cfg_os == "linux" || g_cfg_os == "macos" || g_cfg_os == "freebsd" {
            return "crypto_bind_unix";
        }
        if c_file_exists("/proc/self/exe") || env_or_empty("OS") != "Windows_NT" {
            return "crypto_bind_unix";
        }
        return "crypto_bind";
    }
    return path;
}

pub fn stdlib_dir() -> str {
    if g_stdlib_dir_found {
        return g_stdlib_dir;
    }
    g_stdlib_dir_found = true;
    var candidates: Vec<str> = Vec::new();
    candidates.push("stdlib");
    var home: str = env_or_empty("FID_HOME");
    if str_len(home) > 0 {
        candidates.push(c_path_join(home, "stdlib"));
    }
    var dir: str = exe_dir();
    candidates.push(c_path_join(dir, "stdlib"));
    candidates.push(c_path_join(c_path_dirname(dir), "stdlib"));
    var i: i64 = 0;
    while i < candidates.len() {
        if c_file_exists(c_path_join(candidates.get(i), "core.fd")) {
            g_stdlib_dir = candidates.get(i);
            return g_stdlib_dir;
        }
        i = i + 1;
    }
    return g_stdlib_dir;
}

/// B6 (inc-roadmap): the read-only seeded store of unit objects an
/// installed toolchain ships, `cache/` beside the compiler (fides.nsi
/// installs it; inc.fd inc_seed_get reads it). A missing directory is
/// a store that has nothing.
pub fn fid_seed_store_dir() -> str {
    return c_path_join(exe_dir(), "cache");
}

/// The directory of this compiler's executable: from argv[0], or (started
/// by name, as `fides run x.fd`) the PATH entry that holds it.
fn exe_dir() -> str {
    var exe: str = p_argv(0);
    if str_contains(exe, "/") || str_contains(exe, "\\") {
        return c_path_dirname(exe);
    }
    var path: str = env_or_empty("PATH");
    var sep: str = ":";
    if str_contains(path, ";") {
        sep = ";";
    }
    var dirs: Vec<str> = str_split(path, sep);
    var i: i64 = 0;
    while i < dirs.len() {
        var d: str = dirs.get(i);
        if str_len(d) > 0 {
            if c_file_exists(c_path_join(d, exe)) || c_file_exists(c_path_join(d, exe + ".exe")) {
                return d;
            }
        }
        i = i + 1;
    }
    return ".";
}

/// G8.7: Global lint warnings populated by build_program_with_path.
/// Read by lint_source after a successful build.
pub var g_lint_warnings: Vec<str> = Vec::new();
/// G8.2: Global borrow-checker mode. Set by the CLI before calling the pipeline.
/// "off" = skip borrow checking, "warn" = report but don't fail, "on" = fail on errors.
pub var g_borrowck_mode: str = "on";
/// G8.2: Setter for the borrow-checker mode (called from main.fd).
/// Fides doesn't support module-qualified assignment, so we use a function.
pub fn set_borrowck_mode(mode: str) {
    g_borrowck_mode = mode;
}

// SP2 (own-backend roadmap): one per-stage timing table for `--time`.
// Stages are recorded only while the flag is on; the helpers cost a clock
// read plus two Vec pushes per mark.
pub var g_time_on: bool = false;
var g_time_names: Vec<str> = Vec::new();
var g_time_ms: Vec<i64> = Vec::new();
/// Turn the --time table on (main.fd: globals are set through functions).
pub fn set_time_on() {
    g_time_on = true;
    iropt_set_time_on();
}

/// Record `now - since` under `name` when --time is on; returns `now`, so
/// stages chain as `t = time_mark("stage", t)`.
pub fn time_mark(name: str, since: i64) -> i64 {
    var now: i64 = p_clock_now_ms();
    if g_time_on {
        g_time_names.push(name);
        g_time_ms.push(now - since);
        // SP2: under the iropt row, each of its passes (iropt.fd)
        if name == "iropt" {
            var ipn: Vec<str> = iropt_pass_time_names();
            var ipm: Vec<i64> = iropt_pass_time_ms();
            var ipi: i64 = 0;
            while ipi < ipn.len() && ipi < ipm.len() {
                g_time_names.push("  iropt " + ipn.get(ipi));
                g_time_ms.push(ipm.get(ipi));
                ipi = ipi + 1;
            }
        }
    }
    return now;
}

/// A row of `ms` measured elsewhere (a part of the row above it).
pub fn time_row(name: str, ms: i64) {
    if g_time_on {
        g_time_names.push(name);
        g_time_ms.push(ms);
    }
}

/// Print the table to stderr: one `[time] <stage>: <ms> ms` line per stage.
pub fn time_report() {
    if !g_time_on {
        return;
    }
    var i: i64 = 0;
    while i < g_time_names.len() {
        p_eprint_str("[time] " + g_time_names.get(i) + ": " + int_to_str(g_time_ms.get(i)) + " ms\n");
        i = i + 1;
    }
    // SP11: the per-function arenas (inc.fd fn_arena_*), when any was used
    var far: str = fn_arena_report();
    if str_len(far) > 0 {
        p_eprint_str("[time] " + far + "\n");
    }
}

/// Get the cached parsed stdlib. Parses on first call, returns cache on subsequent calls.
/// Returns (stdlib_program, struct_names, enum_names).
pub fn get_cached_stdlib() -> OptProgram {
    if g_stdlib_cache_init {
        return g_stdlib_cache;
    }
    // Parse stdlib/core.fd
    var stdlib_raw: str = p_file_read(c_path_join(stdlib_dir(), "core.fd"));
    if (stdlib_raw as i64) == 0 {
        return OptProgram::None;
    }
    g_stdlib_hash = hash_source(stdlib_raw);
    var stdlib_result: ParseResultProgram = parse_source(stdlib_raw);
    match stdlib_result {
        ParseResultProgram::Ok(stdlib) => {
            g_stdlib_cache = OptProgram::Some(stdlib);
            g_stdlib_cache_init = true;
            return g_stdlib_cache;
        }
        ParseResultProgram::Err(_) => {
            return OptProgram::None;
        }
    }
}

// --- CS2: binary checked-stdlib artifact ------------------------------------
// The merged (core + runtime) Program persists to a versioned binary file.
// The key is the same lib_hash the checked-library stamp uses (a fold over
// every source file's hash) plus this compiler's hash, so a changed source,
// a changed runtime file or a rebuilt compiler misses and the parse path
// runs. The artifact stores two Programs: core alone (what get_cached_stdlib
// returns for reach_keep_set) and the merged program the pipeline merges.
var g_astcache_hit: bool = false;
var g_astcache_lib_hash: i64 = 0;
var g_astcache_rt_files: Vec<str> = Vec::new();
var g_astcache_rt_raws: Vec<str> = Vec::new();
fn astcache_path(lib_hash: i64) -> str {
    var over: str = env_or_empty("FID_ASTCACHE");
    if str_len(over) > 0 {
        return over;
    }
    var dir: str = env_or_empty("TEMP");
    if dir == "" {
        dir = env_or_empty("TMPDIR");
    }
    if dir == "" {
        dir = "/tmp";
    }
    var name: str = int_to_str(hash_source("ast2 " + int_to_str(lib_hash) + " " + int_to_str(inc_compiler_hash())));
    if str_starts_with(name, "-") {
        name = "n" + str_slice(name, 1, str_len(name));
    }
    return dir + "/fid-ast-" + name + ".bin";
}

// SP20 (own-backend roadmap): `FID_ASTCACHE=off` turns the artifact off
// (no read, no write), so a build with the cache can be
// compared byte for byte with one without it (scripts/repro-check.sh).
fn astcache_off() -> bool {
    return env_or_empty("FID_ASTCACHE") == "off";
}

// SP4/SP18 (own-backend roadmap): the hash of the core.fd text whose
// Program g_stdlib_cache holds (0: none yet). A long-lived process (the LSP,
// `fid serve`) reuses that Program while core is unchanged, and parses core
// again when it changed.
var g_astcache_core_key: i64 = 0;

// SP18: in `fid serve` (g_serve_mode), the core+runtime Program of an
// emit request stays in memory too, under its lib_hash (every library
// file's hash): a later emit with the same runtime reads no artifact.
pub var g_serve_mode: bool = false;
var g_astcache_merged_key: i64 = 0;
var g_astcache_merged: OptProgram = OptProgram::None;

/// SP18: keep the merged Program of `lib_hash` for the next request.
fn astcache_memo_merged(lib_hash: i64, merged_p: Program) {
    if g_serve_mode && g_pe_runtime_merge {
        g_astcache_merged = OptProgram::Some(merged_p);
        g_astcache_merged_key = lib_hash;
    }
}

/// CB4: `fid build` on a Linux or macOS host whose machine-layer build was
/// rejected goes on through C (main.fd cmd_build): the second front end
/// merges no native runtime, and @cfg sees the host, as for --via-c.
pub fn native_runtime_reset() {
    g_pe_runtime_merge = false;
    g_native_rt_dir = "pe_runtime";
    g_native_rt_win = false;
    g_native_rt_mac = false;
    g_native_rt_wasi = false;
    g_cfg_os = "";
    g_cfg_arch = "";
}

/// SP18: `fid serve` runs many builds in one process: what one request's
/// command set (the runtime merged, @cfg's target, --time, --debug, the
/// borrow-check mode) is put back as a fresh process has it, so the next
/// request builds as its one-shot command would.
pub fn serve_reset_build_state() {
    g_pe_runtime_merge = false;
    g_native_rt_dir = "pe_runtime";
    g_native_rt_win = false;
    g_native_rt_mac = false;
    g_native_rt_wasi = false;
    g_cfg_os = "";
    g_cfg_arch = "";
    g_cfg_now_freebsd = false;
    g_cfg_debug = false;
    set_fuzz_cov(false, false);
    g_borrowck_mode = "on";
    g_time_on = false;
    g_time_names = Vec::new();
    g_time_ms = Vec::new();
}

// ===========================================================================
// CB2 (complaint-roadmap): incremental body checks in `fid serve`
// ===========================================================================
// A check request of `fid serve` (and check-text over its socket) keeps,
// after a check that passed, what each module of the program held: its
// text, and per top-level item (a function, an impl or trait-impl method, a
// declaration, an import line) a hash of its tokens without their positions,
// the names it defines and the words it mentions. The next check request
// compares the modules with that clean state:
//   - an item whose tokens changed, a new one and a removed one are
//     "changed": the names they define go into a pool;
//   - an item that mentions a pooled name (an identifier of its tokens, or a
//     word of an f-string) is "affected": what its check sees may differ (a
//     signature, a struct, the effects or allocations of a callee), and the
//     names it defines go into the pool too, to a fixpoint (callers of
//     callers: effects, escape summaries and allocation facts flow up calls).
//     `main` counts only where it is called or passed (`main(`, `(main)`):
//     the entry point is a word of many programs;
//   - a changed import line, module line or `#[..]` attribute changes every
//     item of its module; in the program's own file, or in the settings (core,
//     the borrow-check mode, @cfg target and features, the edition), every
//     body of the program is checked;
//   - when any module spawns threads, every body of the program's own file
//     is checked (the race check reads the global writes of that module).
// Every other function, impl method and trait-impl method body, when its key
// is defined once in the program, goes into the skip set the checker, the
// reference-escape and secrecy passes and the borrow checker already take
// for core (release D9). A request ends after the borrow check (no comptime
// substitution or monomorphization: neither reports an error), and a request
// that passed becomes the new clean state. FID_CB2=off: as before.
// FID_CB2_DEBUG=1: the changed and checked keys on stderr.

/// One top-level item of a module (see above). kind: 0 a body (function or
/// method), 1 a declaration, 2 an import line, module line or attribute.
pub struct Cb2Item {
    pub key: str,
    pub hash: i64,
    pub names: Vec<str>,
    pub words: Vec<i64>,
    pub kind: i64,
}

/// One module of the program: its file and text, its items, the words its
/// items mention (wset: word hash -> nonzero), whether it spawns threads.
pub struct Cb2Mod {
    pub path: str,
    pub text: str,
    pub items: Vec<Cb2Item>,
    pub wset: i64,
    pub spawns: bool,
    pub is_user: bool,
    // registered as module `main`: the checker records its global writes
    pub main_mod: bool,
    pub same: bool,
}

var g_cb2_req: bool = false;  // this build is a serve check request
var g_cb2_build: bool = false;  // SP8: ... or a serve build request
var g_cb2_base: Vec<Cb2Mod> = Vec::new();  // the last clean check's modules
var g_cb2_base_on: bool = false;
var g_cb2_base_cfg: i64 = 0;
var g_cb2_cur: Vec<Cb2Mod> = Vec::new();  // this request's modules
var g_cb2_cur_cfg: i64 = 0;
var g_cb2_cur_ok: bool = false;  // every module has a file
var g_cb2_pending: bool = false;  // g_cb2_cur holds a request's modules
var g_cb2_note: str = "";
var g_cb2_debug: bool = false;
var g_cb2_tags_done: bool = false;
var g_cb2_t_fn: i64 = 0;
var g_cb2_t_impl: i64 = 0;
var g_cb2_t_for: i64 = 0;
var g_cb2_t_struct: i64 = 0;
var g_cb2_t_enum: i64 = 0;
var g_cb2_t_cap: i64 = 0;
var g_cb2_t_type: i64 = 0;
var g_cb2_t_var: i64 = 0;
var g_cb2_t_val: i64 = 0;
var g_cb2_t_static: i64 = 0;
var g_cb2_t_const: i64 = 0;
var g_cb2_t_use: i64 = 0;
var g_cb2_t_module: i64 = 0;
var g_cb2_t_extern: i64 = 0;
var g_cb2_t_layer: i64 = 0;
var g_cb2_t_model: i64 = 0;
var g_cb2_t_component: i64 = 0;
var g_cb2_t_system: i64 = 0;
var g_cb2_t_state: i64 = 0;
var g_cb2_t_on: i64 = 0;
var g_cb2_t_lbrace: i64 = 0;
var g_cb2_t_rbrace: i64 = 0;
var g_cb2_t_lparen: i64 = 0;
var g_cb2_t_rparen: i64 = 0;
var g_cb2_t_lbracket: i64 = 0;
var g_cb2_t_rbracket: i64 = 0;
var g_cb2_t_semi: i64 = 0;
var g_cb2_t_comma: i64 = 0;
var g_cb2_t_eq: i64 = 0;
var g_cb2_t_lt: i64 = 0;
var g_cb2_t_gt: i64 = 0;
var g_cb2_t_shr: i64 = 0;
var g_cb2_t_hash: i64 = 0;
var g_cb2_t_at: i64 = 0;
var g_cb2_t_eof: i64 = 0;

/// A serve check request starts (true) or ends (false). FID_CB2=off keeps
/// every request a full build, as before CB2.
pub fn cb2_request(on: bool) {
    g_cb2_req = on && env_or_empty("FID_CB2") != "off";
    g_cb2_debug = env_or_empty("FID_CB2_DEBUG") == "1";
    g_cb2_build = false;
    if on {
        g_cb2_note = "";
    }
}

// SP8 (own-backend roadmap): a build request of `fid serve` (emit, build,
// ccompile) checks again only the bodies an edit can reach, as a check
// request does, but goes on past the borrow check (comptime substitution,
// monomorphization) to the program its command lowers. Skipping a body's
// checks does not change what is lowered: the checkers do not change the
// Program, as core's skipped bodies (release D9) show on every build.
// What passed the checks is the clean state of the next request (a check
// and a build compare as "settings changed": the runtime merged and the
// @cfg target are in cb2_config). FID_CB2=off: full checks.

/// A serve build request starts (true) or ends (false).
pub fn cb2_request_build(on: bool) {
    cb2_request(on);
    g_cb2_build = on && g_cb2_req;
}

/// What the last request checked ("3 of 7171 bodies checked", or why all
/// were), "" when CB2 was off.
pub fn cb2_note() -> str {
    return g_cb2_note;
}

fn cb2_tags_init() {
    if g_cb2_tags_done {
        return;
    }
    g_cb2_tags_done = true;
    g_cb2_t_fn = token_kind_tag(TokenKind::Fn);
    g_cb2_t_impl = token_kind_tag(TokenKind::Impl);
    g_cb2_t_for = token_kind_tag(TokenKind::For);
    g_cb2_t_struct = token_kind_tag(TokenKind::Struct);
    g_cb2_t_enum = token_kind_tag(TokenKind::Enum);
    g_cb2_t_cap = token_kind_tag(TokenKind::Cap);
    g_cb2_t_type = token_kind_tag(TokenKind::Type);
    g_cb2_t_var = token_kind_tag(TokenKind::Var);
    g_cb2_t_val = token_kind_tag(TokenKind::Val);
    g_cb2_t_static = token_kind_tag(TokenKind::Static);
    g_cb2_t_const = token_kind_tag(TokenKind::Const);
    g_cb2_t_use = token_kind_tag(TokenKind::Use);
    g_cb2_t_module = token_kind_tag(TokenKind::Module);
    g_cb2_t_extern = token_kind_tag(TokenKind::Extern);
    g_cb2_t_layer = token_kind_tag(TokenKind::Layer);
    g_cb2_t_model = token_kind_tag(TokenKind::Model);
    g_cb2_t_component = token_kind_tag(TokenKind::Component);
    g_cb2_t_system = token_kind_tag(TokenKind::System);
    g_cb2_t_state = token_kind_tag(TokenKind::State);
    g_cb2_t_on = token_kind_tag(TokenKind::On);
    g_cb2_t_lbrace = token_kind_tag(TokenKind::LBrace);
    g_cb2_t_rbrace = token_kind_tag(TokenKind::RBrace);
    g_cb2_t_lparen = token_kind_tag(TokenKind::LParen);
    g_cb2_t_rparen = token_kind_tag(TokenKind::RParen);
    g_cb2_t_lbracket = token_kind_tag(TokenKind::LBracket);
    g_cb2_t_rbracket = token_kind_tag(TokenKind::RBracket);
    g_cb2_t_semi = token_kind_tag(TokenKind::Semicolon);
    g_cb2_t_comma = token_kind_tag(TokenKind::Comma);
    g_cb2_t_eq = token_kind_tag(TokenKind::Eq);
    g_cb2_t_lt = token_kind_tag(TokenKind::Lt);
    g_cb2_t_gt = token_kind_tag(TokenKind::Gt);
    g_cb2_t_shr = token_kind_tag(TokenKind::Shr);
    g_cb2_t_hash = token_kind_tag(TokenKind::Hash);
    g_cb2_t_at = token_kind_tag(TokenKind::At);
    g_cb2_t_eof = token_kind_tag(TokenKind::Eof);
}

fn cb2_tag(toks: &Vec<Token>, i: i64) -> i64 {
    if i < 0 || i >= toks.len() {
        return g_cb2_t_eof;
    }
    return token_kind_tag(toks.get(i).kind);
}

fn cb2_is_open(t: i64) -> bool {
    return t == g_cb2_t_lbrace || t == g_cb2_t_lparen || t == g_cb2_t_lbracket;
}

fn cb2_is_close(t: i64) -> bool {
    return t == g_cb2_t_rbrace || t == g_cb2_t_rparen || t == g_cb2_t_rbracket;
}

/// An item keyword whose item ends with its `}` (or a `;`).
fn cb2_is_block_head(t: i64) -> bool {
    return t == g_cb2_t_fn || t == g_cb2_t_impl || t == g_cb2_t_struct || t == g_cb2_t_enum || t == g_cb2_t_cap || t == g_cb2_t_extern || t == g_cb2_t_layer || t == g_cb2_t_model || t == g_cb2_t_component || t == g_cb2_t_system || t == g_cb2_t_state || t == g_cb2_t_on;
}

/// An item keyword whose item ends with a `;` at its own level.
fn cb2_is_line_head(t: i64) -> bool {
    return t == g_cb2_t_var || t == g_cb2_t_val || t == g_cb2_t_static || t == g_cb2_t_const || t == g_cb2_t_type || t == g_cb2_t_use || t == g_cb2_t_module;
}

/// A keyword followed by the name its item defines.
fn cb2_is_name_head(t: i64) -> bool {
    return t == g_cb2_t_struct || t == g_cb2_t_enum || t == g_cb2_t_cap || t == g_cb2_t_type || t == g_cb2_t_var || t == g_cb2_t_val || t == g_cb2_t_static || t == g_cb2_t_const || t == g_cb2_t_layer || t == g_cb2_t_model || t == g_cb2_t_component || t == g_cb2_t_system || t == g_cb2_t_state || t == g_cb2_t_on;
}

fn cb2_ident(toks: &Vec<Token>, i: i64) -> str {
    if i < 0 || i >= toks.len() {
        return "";
    }
    match toks.get(i).kind {
        TokenKind::Ident(s: str) => {
            return s;
        }
        _ => {
        }
    }
    return "";
}

/// The last token of the item that starts at `start` (tokens before
/// `limit` only): a `;` at its level, or the `}` that closes a block item.
fn cb2_item_end(toks: &Vec<Token>, start: i64, limit: i64) -> i64 {
    var t0: i64 = cb2_tag(toks, start);
    // `#[..]` / `#![..]`: an attribute of the module, an item of its own;
    // `@import("x.h")` likewise
    var bracket_only: bool = t0 == g_cb2_t_hash || (t0 == g_cb2_t_at && cb2_ident(toks, start + 1) == "import");
    var depth: i64 = 0;
    var decided: bool = bracket_only;
    var block: bool = true;
    var opened: bool = false;
    var j: i64 = start;
    while j < limit {
        var t: i64 = cb2_tag(toks, j);
        if t == g_cb2_t_eof {
            if j > start {
                return j - 1;
            }
            return start;
        }
        if depth == 0 && !decided {
            if cb2_is_block_head(t) {
                decided = true;
                block = true;
            } else if cb2_is_line_head(t) {
                decided = true;
                block = false;
            }
        }
        if cb2_is_open(t) {
            depth = depth + 1;
            opened = true;
        } else if cb2_is_close(t) {
            depth = depth - 1;
            if depth < 0 {
                depth = 0;
            }
            if depth == 0 && bracket_only && opened {
                return j;
            }
            if depth == 0 && t == g_cb2_t_rbrace && block {
                return j;
            }
        } else if t == g_cb2_t_semi && depth == 0 {
            return j;
        }
        j = j + 1;
    }
    return limit - 1;
}

@wrapping
fn cb2_mix(h: i64, v: i64) -> i64 {
    var x: i64 = h;
    var y: i64 = v;
    var i: i64 = 0;
    while i < 8 {
        x = x ^ (y & 255);
        x = x * 1099511628211;
        y = y >> 8;
        i = i + 1;
    }
    return x;
}

@wrapping
fn cb2_mix_str(h: i64, s: str) -> i64 {
    var n: i64 = str_len(s);
    var x: i64 = cb2_mix(h, n);
    var i: i64 = 0;
    while i < n {
        x = x ^ (str_byte_at(s, i) & 255);
        x = x * 1099511628211;
        i = i + 1;
    }
    return x;
}

/// The hash of tokens a..=b folded into h: kinds and payloads, no positions.
fn cb2_hash_range(toks: &Vec<Token>, a: i64, b: i64, h: i64) -> i64 {
    var x: i64 = h;
    var j: i64 = a;
    while j <= b {
        var tk: TokenKind = toks.get(j).kind;
        x = cb2_mix(x, token_kind_tag(tk));
        match tk {
            TokenKind::Ident(s1: str) => {
                x = cb2_mix_str(x, s1);
            }
            TokenKind::StringLit(s2: str) => {
                x = cb2_mix_str(x, s2);
            }
            TokenKind::FString(s3: str) => {
                x = cb2_mix_str(x, s3);
            }
            TokenKind::Lifetime(s4: str) => {
                x = cb2_mix_str(x, s4);
            }
            TokenKind::BadChar(s5: str) => {
                x = cb2_mix_str(x, s5);
            }
            TokenKind::IntLit(iv: i64) => {
                x = cb2_mix(x, iv);
            }
            TokenKind::FloatLit(fv: f64) => {
                x = cb2_mix(x, p_f64_to_bits(fv));
            }
            _ => {
            }
        }
        j = j + 1;
    }
    return x;
}

/// Note word hash h for the item numbered id (wset remembers the last item
/// that noted each word, so an item lists a word once).
fn cb2_word(wset: i64, id: i64, out: &mut Vec<i64>, h: i64) {
    if HashMap_get_i(wset, h) != id {
        HashMap_insert_i(wset, h, id);
        out.push(h);
    }
}

/// The words of an f-string's text (its `{..}` parts are code).
@wrapping
fn cb2_text_words(wset: i64, id: i64, out: &mut Vec<i64>, s: str) {
    var n: i64 = str_len(s);
    var in_w: bool = false;
    var wh: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(s, i) & 255;
        if imp_word_byte(c) {
            if !in_w {
                in_w = true;
                wh = 8834263827529598795;
            }
            wh = wh ^ c;
            wh = wh * 1099511628211;
        } else if in_w {
            cb2_word(wset, id, out, wh);
            in_w = false;
        }
        i = i + 1;
    }
    if in_w {
        cb2_word(wset, id, out, wh);
    }
}

/// The words tokens a..=b mention: identifiers (`main` only where it is
/// called or passed) and the words of f-strings.
fn cb2_words_range(toks: &Vec<Token>, a: i64, b: i64, wset: i64, id: i64, out: &mut Vec<i64>) {
    var j: i64 = a;
    while j <= b {
        match toks.get(j).kind {
            TokenKind::Ident(s: str) => {
                var keep: bool = true;
                if s == "main" {
                    var pv: i64 = cb2_tag(toks, j - 1);
                    var nx: i64 = cb2_tag(toks, j + 1);
                    keep = nx == g_cb2_t_lparen || ((pv == g_cb2_t_lparen || pv == g_cb2_t_comma || pv == g_cb2_t_eq) && (nx == g_cb2_t_rparen || nx == g_cb2_t_comma || nx == g_cb2_t_semi));
                }
                if keep {
                    cb2_word(wset, id, out, hash_source(s));
                }
            }
            TokenKind::FString(fs: str) => {
                cb2_text_words(wset, id, out, fs);
            }
            _ => {
            }
        }
        j = j + 1;
    }
}

fn cb2_push_name(names: &mut Vec<str>, s: str) {
    if str_len(s) == 0 {
        return;
    }
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == s {
            return;
        }
        i = i + 1;
    }
    names.push(s);
}

/// The names tokens a..=b define: the name after an item keyword at their
/// own level, the name after every `fn`, and an enum's variants.
fn cb2_names_range(toks: &Vec<Token>, a: i64, b: i64, names: &mut Vec<str>) {
    var depth: i64 = 0;
    var in_enum: bool = false;
    var j: i64 = a;
    while j <= b {
        var t: i64 = cb2_tag(toks, j);
        if t == g_cb2_t_fn {
            cb2_push_name(names, cb2_ident(toks, j + 1));
        } else if depth == 0 && cb2_is_name_head(t) {
            cb2_push_name(names, cb2_ident(toks, j + 1));
            if t == g_cb2_t_enum {
                in_enum = true;
            }
        }
        if cb2_is_open(t) {
            depth = depth + 1;
        } else if cb2_is_close(t) {
            depth = depth - 1;
            if depth < 0 {
                depth = 0;
            }
        } else if in_enum && depth == 1 {
            var pv: i64 = cb2_tag(toks, j - 1);
            if pv == g_cb2_t_lbrace || pv == g_cb2_t_comma {
                cb2_push_name(names, cb2_ident(toks, j));
            }
        }
        j = j + 1;
    }
}

/// The first item keyword of tokens a..=b at their own level, or -1.
fn cb2_head_at(toks: &Vec<Token>, a: i64, b: i64) -> i64 {
    var depth: i64 = 0;
    var j: i64 = a;
    while j <= b {
        var t: i64 = cb2_tag(toks, j);
        if depth == 0 && (cb2_is_block_head(t) || cb2_is_line_head(t)) {
            return j;
        }
        if cb2_is_open(t) {
            depth = depth + 1;
        } else if cb2_is_close(t) {
            depth = depth - 1;
            if depth < 0 {
                depth = 0;
            }
        }
        j = j + 1;
    }
    return -1;
}

/// How many `fn` tokens a..=b hold at their own level.
fn cb2_fn_count(toks: &Vec<Token>, a: i64, b: i64) -> i64 {
    var depth: i64 = 0;
    var count: i64 = 0;
    var j: i64 = a;
    while j <= b {
        var t: i64 = cb2_tag(toks, j);
        if depth == 0 && t == g_cb2_t_fn {
            count = count + 1;
        }
        if cb2_is_open(t) {
            depth = depth + 1;
        } else if cb2_is_close(t) {
            depth = depth - 1;
            if depth < 0 {
                depth = 0;
            }
        }
        j = j + 1;
    }
    return count;
}

fn cb2_item_new(key: str, hash: i64, names: Vec<str>, words: Vec<i64>, kind: i64) -> Cb2Item {
    return Cb2Item {
        key: key, hash: hash, names: names, words: words, kind: kind
    };
}

/// An `impl` item s..=e (its keyword at head): one body item per method,
/// keyed "impl:T:m" ("trait:T:m" for `impl Trait for T`), and one
/// declaration item for the rest (the header, associated types).
fn cb2_add_impl(items: &mut Vec<Cb2Item>, toks: &Vec<Token>, s: i64, e: i64, head: i64, wset: i64, next_id: &mut i64) {
    var j: i64 = head + 1;
    // `impl<T> ...`: the parameters come first
    if cb2_tag(toks, j) == g_cb2_t_lt {
        var ang: i64 = 0;
        while j <= e {
            var ta: i64 = cb2_tag(toks, j);
            if ta == g_cb2_t_lt {
                ang = ang + 1;
            } else if ta == g_cb2_t_gt {
                ang = ang - 1;
            } else if ta == g_cb2_t_shr {
                ang = ang - 2;
            }
            j = j + 1;
            if ang <= 0 {
                break;
            }
        }
    }
    var first: str = "";
    var after_for: str = "";
    var is_trait: bool = false;
    var open: i64 = -1;
    while j <= e && open < 0 {
        var th: i64 = cb2_tag(toks, j);
        if th == g_cb2_t_lbrace {
            open = j;
        } else if th == g_cb2_t_for {
            is_trait = true;
        } else {
            var nm: str = cb2_ident(toks, j);
            if str_len(nm) > 0 {
                if is_trait && str_len(after_for) == 0 {
                    after_for = nm;
                } else if !is_trait && str_len(first) == 0 {
                    first = nm;
                }
            }
        }
        j = j + 1;
    }
    var ty: str = first;
    var prefix: str = "impl:";
    if is_trait {
        ty = after_for;
        prefix = "trait:";
    }
    var hid: i64 = *next_id;
    *next_id = *next_id + 1;
    var hnames: Vec<str> = Vec::new();
    cb2_push_name(&mut hnames, ty);
    if is_trait {
        cb2_push_name(&mut hnames, first);
    }
    var hwords: Vec<i64> = Vec::new();
    if open < 0 || str_len(ty) == 0 {
        // not the shape expected: one declaration item for all of it
        cb2_names_range(toks, s, e, &mut hnames);
        cb2_words_range(toks, s, e, wset, hid, &mut hwords);
        items.push(cb2_item_new("implx:" + ty, cb2_hash_range(toks, s, e, 8834263827529598795), hnames, hwords, 1));
        return;
    }
    var hhash: i64 = cb2_hash_range(toks, s, open, 8834263827529598795);
    cb2_words_range(toks, s, open, wset, hid, &mut hwords);
    var k: i64 = open + 1;
    while k < e {
        var me: i64 = cb2_item_end(toks, k, e);
        if me < k {
            me = k;
        }
        var mh: i64 = cb2_head_at(toks, k, me);
        var mname: str = "";
        if mh >= 0 && cb2_tag(toks, mh) == g_cb2_t_fn && cb2_fn_count(toks, k, me) == 1 {
            mname = cb2_ident(toks, mh + 1);
        }
        if str_len(mname) > 0 {
            var mid: i64 = *next_id;
            *next_id = *next_id + 1;
            var mnames: Vec<str> = Vec::new();
            cb2_names_range(toks, k, me, &mut mnames);
            if is_trait {
                // a trait method is also called without its name (an
                // operator, a `for` loop, printing): its type and trait too
                cb2_push_name(&mut mnames, ty);
                cb2_push_name(&mut mnames, first);
            }
            var mwords: Vec<i64> = Vec::new();
            cb2_words_range(toks, k, me, wset, mid, &mut mwords);
            items.push(cb2_item_new(prefix + ty + ":" + mname, cb2_hash_range(toks, k, me, 8834263827529598795), mnames, mwords, 0));
        } else {
            hhash = cb2_hash_range(toks, k, me, hhash);
            cb2_names_range(toks, k, me, &mut hnames);
            cb2_words_range(toks, k, me, wset, hid, &mut hwords);
        }
        k = me + 1;
    }
    items.push(cb2_item_new(prefix + "head:" + ty + ":" + first, hhash, hnames, hwords, 1));
}

/// The item s..=e of a module.
fn cb2_add_item(items: &mut Vec<Cb2Item>, toks: &Vec<Token>, s: i64, e: i64, wset: i64, next_id: &mut i64) {
    var head: i64 = cb2_head_at(toks, s, e);
    var ht: i64 = -1;
    if head >= 0 {
        ht = cb2_tag(toks, head);
    }
    if ht == g_cb2_t_impl {
        cb2_add_impl(items, toks, s, e, head, wset, next_id);
        return;
    }
    var id: i64 = *next_id;
    *next_id = *next_id + 1;
    var names: Vec<str> = Vec::new();
    cb2_names_range(toks, s, e, &mut names);
    var words: Vec<i64> = Vec::new();
    cb2_words_range(toks, s, e, wset, id, &mut words);
    var hash: i64 = cb2_hash_range(toks, s, e, 8834263827529598795);
    var t0: i64 = cb2_tag(toks, s);
    if ht == g_cb2_t_use || ht == g_cb2_t_module || t0 == g_cb2_t_hash || (t0 == g_cb2_t_at && cb2_ident(toks, s + 1) == "import") {
        items.push(cb2_item_new("head#", hash, names, words, 2));
        return;
    }
    if ht == g_cb2_t_fn {
        var fname: str = cb2_ident(toks, head + 1);
        if str_len(fname) > 0 && cb2_fn_count(toks, s, e) == 1 {
            items.push(cb2_item_new("fn:" + fname, hash, names, words, 0));
            return;
        }
        // several functions in one item (not the shape expected): never
        // skipped, its names go into the pool when it changes
        items.push(cb2_item_new("fnx:" + fname, hash, names, words, 1));
        return;
    }
    var dname: str = "";
    if names.len() > 0 {
        dname = names.get(0);
    }
    items.push(cb2_item_new("decl:" + dname, hash, names, words, 1));
}

/// The items of one module's tokens. A key defined twice in the module
/// becomes "dup<k>:key" (never skipped; the checker's key covers both).
fn cb2_items(toks: &Vec<Token>, wset: i64) -> Vec<Cb2Item> {
    cb2_tags_init();
    var items: Vec<Cb2Item> = Vec::new();
    var next_id: i64 = 1;
    var n: i64 = toks.len();
    var i: i64 = 0;
    while i < n {
        if cb2_tag(toks, i) == g_cb2_t_eof {
            break;
        }
        var e: i64 = cb2_item_end(toks, i, n);
        if e < i {
            e = i;
        }
        cb2_add_item(&mut items, toks, i, e, wset, &mut next_id);
        i = e + 1;
    }
    var counts: i64 = HashMap_new();
    var c: i64 = 0;
    while c < items.len() {
        var ck: str = items.get(c).key;
        HashMap_insert(counts, ck, HashMap_get(counts, ck) + 1);
        c = c + 1;
    }
    var seen: i64 = HashMap_new();
    c = 0;
    while c < items.len() {
        var it: Cb2Item = items.get(c);
        if HashMap_get(counts, it.key) > 1 || it.key == "head#" {
            var nth: i64 = HashMap_get(seen, it.key) + 1;
            HashMap_insert(seen, it.key, nth);
            it.key = "dup" + int_to_str(nth) + ":" + it.key;
            items.set(c, it);
        }
        c = c + 1;
    }
    HashMap_drop(counts);
    HashMap_drop(seen);
    return items;
}

/// A module's state from its text and tokens.
fn cb2_module(path: str, text: str, toks: &Vec<Token>, is_user: bool, main_mod: bool) -> Cb2Mod {
    var wset: i64 = HashMap_new();
    var items: Vec<Cb2Item> = cb2_items(toks, wset);
    return Cb2Mod {
        path: path, text: text, items: items, wset: wset, spawns: str_contains(text, "spawn"), is_user: is_user, main_mod: main_mod, same: false
    };
}

fn cb2_base_find(path: str) -> i64 {
    var i: i64 = 0;
    while i < g_cb2_base.len() {
        if g_cb2_base.get(i).path == path {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn cb2_cur_find(path: str) -> i64 {
    var i: i64 = 0;
    while i < g_cb2_cur.len() {
        if g_cb2_cur.get(i).path == path {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn cb2_has_wset(v: &Vec<Cb2Mod>, w: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i).wset == w {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Forget the modules of a request that did not pass.
fn cb2_drop_pending() {
    if !g_cb2_pending {
        return;
    }
    var i: i64 = 0;
    while i < g_cb2_cur.len() {
        var w: i64 = g_cb2_cur.get(i).wset;
        if w != 0 && !cb2_has_wset(&g_cb2_base, w) {
            HashMap_drop(w);
        }
        i = i + 1;
    }
    g_cb2_cur = Vec::new();
    g_cb2_pending = false;
}

/// The request passed every check: its modules are the clean state now.
pub fn cb2_commit() {
    if !g_cb2_req || !g_cb2_pending {
        return;
    }
    if !g_cb2_cur_ok {
        cb2_drop_pending();
        return;
    }
    var i: i64 = 0;
    while i < g_cb2_base.len() {
        var w: i64 = g_cb2_base.get(i).wset;
        if w != 0 && !cb2_has_wset(&g_cb2_cur, w) {
            HashMap_drop(w);
        }
        i = i + 1;
    }
    g_cb2_base = g_cb2_cur;
    g_cb2_base_cfg = g_cb2_cur_cfg;
    g_cb2_base_on = true;
    g_cb2_cur = Vec::new();
    g_cb2_pending = false;
}

/// The tokens of `path` lexed in this build, or its text lexed now.
fn cb2_tokens_of(token_cache: &Vec<PathTokens>, path: str, text: str) -> Vec<Token> {
    var i: i64 = 0;
    while i < token_cache.len() {
        if token_cache.get(i).path == path {
            return token_cache.get(i).tokens;
        }
        i = i + 1;
    }
    var lx: Lexer = Lexer::new(text);
    return lx.tokenize();
}

/// Add a module of this request: the clean state's when its text is the
/// same, else built from its tokens.
fn cb2_cur_add(path: str, text: str, token_cache: &Vec<PathTokens>, have_toks: bool, toks: Vec<Token>, is_user: bool, main_mod: bool) {
    var b: i64 = cb2_base_find(path);
    if b >= 0 && g_cb2_base.get(b).text == text {
        var bm: Cb2Mod = g_cb2_base.get(b);
        bm.is_user = is_user;
        bm.main_mod = main_mod;
        bm.same = true;
        g_cb2_cur.push(bm);
        return;
    }
    var tk: Vec<Token> = toks;
    if !have_toks {
        tk = cb2_tokens_of(token_cache, path, text);
    }
    g_cb2_cur.push(cb2_module(path, text, &tk, is_user, main_mod));
}

/// Everything a module's check depends on besides the modules' texts.
pub fn cb2_config(lib_hash: i64, borrowck_mode: str, base_dir: str) -> i64 {
    var s: str = int_to_str(lib_hash) + "|" + borrowck_mode + "|" + g_cfg_os + "|" + g_cfg_arch + "|" + g_cfg_features + "|" + int_to_str(cc_manifest_edition(base_dir)) + "|" + g_native_rt_dir;
    if g_cfg_debug {
        s = s + "|debug";
    }
    if g_cfg_now_freebsd {
        s = s + "|freebsd";
    }
    if g_pe_runtime_merge {
        s = s + "|runtime";
    }
    if g_fuzz_cov {
        s = s + "|fuzz";
    }
    return hash_str(s);
}

/// Put the names of `it` into the pool.
fn cb2_pool_add(pool: i64, pool_list: &mut Vec<i64>, it: &Cb2Item) {
    var i: i64 = 0;
    while i < it.names.len() {
        var h: i64 = hash_source(it.names.get(i));
        if HashMap_get_i(pool, h) == 0 {
            HashMap_insert_i(pool, h, 1);
            pool_list.push(h);
        }
        i = i + 1;
    }
}

fn cb2_skippable_key(key: str) -> bool {
    return str_starts_with(key, "fn:") || str_starts_with(key, "impl:") || str_starts_with(key, "trait:");
}

/// CB2: the skip set of a serve check request: `skip0` (core's, or 0) with
/// every body no edit since the last clean check can reach (see above).
/// `mod_names`: the imported modules; the program's own file is
/// `user_text`, lexed as `user_toks`, registered as module `user_module`.
pub fn cb2_skip_set(skip0: i64, user_text: str, source_path: OptStr, user_toks: Vec<Token>, user_module: str, mod_names: Vec<str>, content_cache: &mut Vec<PathContent>, token_cache: &Vec<PathTokens>, cfg: i64) -> i64 {
    if !g_cb2_req {
        return skip0;
    }
    cb2_drop_pending();
    g_cb2_pending = true;
    g_cb2_cur = Vec::new();
    g_cb2_cur_cfg = cfg;
    g_cb2_cur_ok = true;
    var none_toks: Vec<Token> = Vec::new();
    var i: i64 = 0;
    while i < mod_names.len() {
        var path: str = module_file_of(mod_names.get(i));
        if str_len(path) == 0 {
            // a C header (no file of its own): nothing to compare
            g_cb2_cur_ok = false;
        } else if cb2_cur_find(path) < 0 {
            cb2_cur_add(path, cached_file_read(content_cache, path), token_cache, false, none_toks, false, mod_names.get(i) == "main");
        }
        i = i + 1;
    }
    var upath: str = "<text>";
    match source_path {
        OptStr::Some(sp) => {
            upath = sp;
        }
        OptStr::None => {
        }
    }
    cb2_cur_add(upath, user_text, token_cache, true, user_toks, true, user_module == "main");
    var why: str = "";
    if !g_cb2_cur_ok {
        why = "a module has no file";
    } else if !g_cb2_base_on {
        why = "first check";
    } else if cfg != g_cb2_base_cfg {
        why = "settings changed";
    }
    if str_len(why) > 0 {
        g_cb2_note = "all bodies checked: " + why;
        return skip0;
    }
    // each item's state, by module (offs): 0 clean, 1 changed, 2 affected,
    // 3 checked (no names pooled)
    var offs: Vec<i64> = Vec::new();
    var st: Vec<i64> = Vec::new();
    var mi: i64 = 0;
    while mi < g_cb2_cur.len() {
        offs.push(st.len());
        var mm: Cb2Mod = g_cb2_cur.get(mi);
        var k0: i64 = 0;
        while k0 < mm.items.len() {
            st.push(0);
            k0 = k0 + 1;
        }
        mi = mi + 1;
    }
    var pool: i64 = HashMap_new();
    var pool_list: Vec<i64> = Vec::new();
    // 1. what changed since the clean state
    mi = 0;
    while mi < g_cb2_cur.len() {
        var m: Cb2Mod = g_cb2_cur.get(mi);
        if !m.same {
            var b: i64 = cb2_base_find(m.path);
            var all: bool = b < 0;
            if b >= 0 {
                var bm: Cb2Mod = g_cb2_base.get(b);
                var bkeys: i64 = HashMap_new();
                var bi: i64 = 0;
                while bi < bm.items.len() {
                    HashMap_insert(bkeys, bm.items.get(bi).key, bi + 1);
                    bi = bi + 1;
                }
                var ckeys: i64 = HashMap_new();
                var k: i64 = 0;
                while k < m.items.len() {
                    var it: Cb2Item = m.items.get(k);
                    HashMap_insert(ckeys, it.key, 1);
                    var at: i64 = HashMap_get(bkeys, it.key);
                    if at == 0 || bm.items.get(at - 1).hash != it.hash {
                        st.set(offs.get(mi) + k, 1);
                        cb2_pool_add(pool, &mut pool_list, &it);
                        if it.kind == 2 {
                            all = true;
                        }
                        if g_cb2_debug {
                            p_eprint_str("cb2: changed " + m.path + " " + it.key + "\n");
                        }
                    }
                    k = k + 1;
                }
                bi = 0;
                while bi < bm.items.len() {
                    var bit: Cb2Item = bm.items.get(bi);
                    if !HashMap_contains(ckeys, bit.key) {
                        cb2_pool_add(pool, &mut pool_list, &bit);
                        if bit.kind == 2 {
                            all = true;
                        }
                        if g_cb2_debug {
                            p_eprint_str("cb2: removed " + m.path + " " + bit.key + "\n");
                        }
                    }
                    bi = bi + 1;
                }
                HashMap_drop(bkeys);
                HashMap_drop(ckeys);
            }
            if all && m.is_user {
                // the program's own imports or attributes (its
                // capabilities), or another program: every body is checked
                why = "the program's imports or attributes changed";
            }
            if all {
                var ka: i64 = 0;
                while ka < m.items.len() {
                    var ita: Cb2Item = m.items.get(ka);
                    st.set(offs.get(mi) + ka, 1);
                    cb2_pool_add(pool, &mut pool_list, &ita);
                    ka = ka + 1;
                }
            }
        }
        mi = mi + 1;
    }
    // modules no longer in the program
    var gb: i64 = 0;
    while gb < g_cb2_base.len() {
        var gm: Cb2Mod = g_cb2_base.get(gb);
        if cb2_cur_find(gm.path) < 0 {
            var gk: i64 = 0;
            while gk < gm.items.len() {
                var git: Cb2Item = gm.items.get(gk);
                cb2_pool_add(pool, &mut pool_list, &git);
                gk = gk + 1;
            }
        }
        gb = gb + 1;
    }
    if str_len(why) > 0 {
        HashMap_drop(pool);
        g_cb2_note = "all bodies checked: " + why;
        return skip0;
    }
    // 2. what mentions a pooled name, to a fixpoint
    var scanned: Vec<i64> = Vec::new();
    mi = 0;
    while mi < g_cb2_cur.len() {
        scanned.push(0);
        mi = mi + 1;
    }
    var grew: bool = true;
    while grew {
        var before: i64 = pool_list.len();
        mi = 0;
        while mi < g_cb2_cur.len() {
            var cm: Cb2Mod = g_cb2_cur.get(mi);
            var from: i64 = scanned.get(mi);
            var upto: i64 = pool_list.len();
            scanned.set(mi, upto);
            var hit: bool = false;
            var q: i64 = from;
            while q < upto && !hit {
                if HashMap_get_i(cm.wset, pool_list.get(q)) != 0 {
                    hit = true;
                }
                q = q + 1;
            }
            if hit {
                var ck: i64 = 0;
                while ck < cm.items.len() {
                    if st.get(offs.get(mi) + ck) == 0 {
                        var cit: Cb2Item = cm.items.get(ck);
                        var ws: Vec<i64> = cit.words;
                        var w: i64 = 0;
                        var found: bool = false;
                        while w < ws.len() && !found {
                            if HashMap_get_i(pool, ws.get(w)) != 0 {
                                found = true;
                            }
                            w = w + 1;
                        }
                        if found {
                            st.set(offs.get(mi) + ck, 2);
                            cb2_pool_add(pool, &mut pool_list, &cit);
                        }
                    }
                    ck = ck + 1;
                }
            }
            mi = mi + 1;
        }
        grew = pool_list.len() > before;
    }
    HashMap_drop(pool);
    // 3. threads: the race check needs the global writes of module `main`
    // (typechecker.fd records them for that module only), which only its
    // checked bodies record
    var spawns: bool = false;
    mi = 0;
    while mi < g_cb2_cur.len() {
        if g_cb2_cur.get(mi).spawns {
            spawns = true;
        }
        mi = mi + 1;
    }
    if spawns {
        mi = 0;
        while mi < g_cb2_cur.len() {
            var um: Cb2Mod = g_cb2_cur.get(mi);
            if um.main_mod {
                var uk: i64 = 0;
                while uk < um.items.len() {
                    if st.get(offs.get(mi) + uk) == 0 {
                        st.set(offs.get(mi) + uk, 3);
                    }
                    uk = uk + 1;
                }
            }
            mi = mi + 1;
        }
    }
    // 4. the skip set: clean bodies whose key the program defines once
    var counts: i64 = HashMap_new();
    mi = 0;
    while mi < g_cb2_cur.len() {
        var km: Cb2Mod = g_cb2_cur.get(mi);
        var kk: i64 = 0;
        while kk < km.items.len() {
            var kit: Cb2Item = km.items.get(kk);
            if kit.kind == 0 {
                HashMap_insert(counts, kit.key, HashMap_get(counts, kit.key) + 1);
            }
            kk = kk + 1;
        }
        mi = mi + 1;
    }
    var skip: i64 = skip0;
    if skip == 0 {
        skip = HashMap_new();
    }
    var total: i64 = 0;
    var checked: i64 = 0;
    mi = 0;
    while mi < g_cb2_cur.len() {
        var sm: Cb2Mod = g_cb2_cur.get(mi);
        var sk: i64 = 0;
        while sk < sm.items.len() {
            var sit: Cb2Item = sm.items.get(sk);
            if sit.kind == 0 {
                total = total + 1;
                if st.get(offs.get(mi) + sk) == 0 && HashMap_get(counts, sit.key) == 1 && cb2_skippable_key(sit.key) {
                    HashMap_insert(skip, sit.key, 1);
                } else {
                    checked = checked + 1;
                    if g_cb2_debug {
                        p_eprint_str("cb2: check " + sm.path + " " + sit.key + "\n");
                    }
                }
            }
            sk = sk + 1;
        }
        mi = mi + 1;
    }
    HashMap_drop(counts);
    g_cb2_note = int_to_str(checked) + " of " + int_to_str(total) + " bodies checked";
    return skip;
}

// CB1: `same` when nothing is merged into core (check, run, ccompile,
// dump-c): the artifact (version 3; 4 adds DB1's library file pairs) then holds core once, and a hit decodes
// one Program instead of the same one twice.
fn astcache_save(lib_hash: i64, core_p: Program, merged_p: Program, same: bool) {
    // g_stdlib_cache now holds the core of this hash (parsed or decoded)
    g_astcache_core_key = g_stdlib_hash;
    astcache_memo_merged(lib_hash, merged_p);
    if astcache_off() {
        return;
    }
    var b: AwBuf = awbuf_new();
    aw_i64(&mut b, 4473414);
    aw_i64(&mut b, 4);
    aw_i64(&mut b, lib_hash);
    aw_bool(&mut b, same);
    aw_program(&mut b, core_p);
    if !same {
        aw_program(&mut b, merged_p);
    }
    // DB1 (version 4): which library file (core, a runtime file) each
    // library function came from, as name/path pairs (ir.fd ir_lib_file_pairs)
    var lib_pairs: Vec<str> = ir_lib_file_pairs();
    aw_i64(&mut b, lib_pairs.len());
    var lpi: i64 = 0;
    while lpi < lib_pairs.len() {
        aw_str(&mut b, lib_pairs.get(lpi));
        lpi = lpi + 1;
    }
    p_file_write_vec(astcache_path(lib_hash), b.bytes);
}

// Load stdlib: reads core + the runtime files once (the lib_hash fold needs
// them anyway), returns the merged Program on an artifact hit or the parsed
// core Program on a miss, in which case the caller runs the runtime merge
// over g_astcache_rt_raws.
fn astcache_load() -> OptProgram {
    g_astcache_hit = false;
    var rt_files: Vec<str> = Vec::new();
    if g_pe_runtime_merge {
        rt_files.push("base.fd");
        if g_native_rt_dir == "pe_runtime" {
            rt_files.push("conc.fd");
            rt_files.push("tensor.fd");
            rt_files.push("data.fd");
        } else {
            // Linux: its own base, threads, system calls; JSON, HTTP, the
            // in-memory DB and tensors are the Windows runtime's Fides code.
            rt_files.push("conc.fd");
            rt_files.push("sys.fd");
            rt_files.push("math.fd");
            rt_files.push("../pe_runtime/data.fd");
            rt_files.push("../pe_runtime/tensor.fd");
            if g_native_rt_win {
                rt_files.push("win.fd");
            }
            if g_native_rt_mac {
                rt_files.push("darwin.fd");
            }
            if g_native_rt_wasi {
                rt_files.push("wasi.fd");
            }
        }
    }
    var core_raw: str = p_file_read(c_path_join(stdlib_dir(), "core.fd"));
    if (core_raw as i64) == 0 {
        return OptProgram::None;
    }
    g_stdlib_hash = hash_source(core_raw);
    var lib_hash: i64 = g_stdlib_hash;
    g_astcache_rt_files = rt_files;
    g_astcache_rt_raws = Vec::new();
    var rti: i64 = 0;
    while rti < rt_files.len() {
        var rt_path: str = pe_runtime_path(rt_files.get(rti));
        inc_record_file(rt_path);
        var rt_raw: str = p_file_read(rt_path);
        if (rt_raw as i64) == 0 {
            p_eprint_str("[build] PE runtime source not found: " + rt_path + "\n");
            return OptProgram::None;
        }
        // CO9: a native crash report names the version `fid version` prints
        // (linux_runtime/base.fd pe_crash_version, pe_runtime/base.fd
        // pe_cr_version hold a development build's text)
        val cr_ver: str = "\"fid " + fid_version() + " (native)\"";
        if cr_ver != "\"fid 1.0.0+dev (native)\"" {
            rt_raw = str_replace(rt_raw, "\"fid 1.0.0+dev (native)\"", cr_ver);
        }
        lib_hash = hash_source(int_to_str(lib_hash) + " " + rt_files.get(rti) + " " + int_to_str(hash_source(rt_raw)));
        g_astcache_rt_raws.push(rt_raw);
        rti = rti + 1;
    }
    g_astcache_lib_hash = lib_hash;
    // A process that already holds this core (the LSP's later builds, `fid
    // serve`) uses it when nothing is merged into it: no artifact read. A
    // core changed on disk since then is parsed again, never served stale
    // (nor saved under the new key).
    if g_stdlib_cache_init && g_astcache_core_key != 0 && g_astcache_core_key != g_stdlib_hash {
        g_stdlib_cache_init = false;
    }
    if !g_pe_runtime_merge && g_stdlib_cache_init && g_astcache_core_key == g_stdlib_hash {
        g_astcache_hit = true;
        return get_cached_stdlib();
    }
    // SP18: `fid serve`'s earlier emit with this very library (core and
    // every runtime file unchanged): its merged Program, no artifact read
    if g_serve_mode && g_pe_runtime_merge && g_astcache_merged_key != 0 && g_astcache_merged_key == lib_hash && g_stdlib_cache_init && g_astcache_core_key == g_stdlib_hash {
        g_astcache_hit = true;
        return g_astcache_merged;
    }
    var path: str = astcache_path(lib_hash);
    if !astcache_off() && p_file_exists(path) != 0 {
        var vb: Vec<i64> = p_file_read_bytes(path);
        if vb.len() > 24 {
            var r: ArBuf = arbuf_new(vb);
            var magic: i64 = ar_i64(&mut r);
            var ver: i64 = ar_i64(&mut r);
            var stored: i64 = ar_i64(&mut r);
            if magic == 4473414 && ver == 4 && stored == lib_hash {
                var same: bool = ar_bool(&mut r);
                var core_p: Program = ar_program(&mut r);
                var merged_p: Program = core_p;
                if !same {
                    merged_p = ar_program(&mut r);
                }
                // DB1: the library functions' files (astcache_save)
                var lib_pairs: Vec<str> = Vec::new();
                var npairs: i64 = ar_i64(&mut r);
                var lpi: i64 = 0;
                while lpi < npairs && r.ok {
                    lib_pairs.push(ar_str(&mut r));
                    lpi = lpi + 1;
                }
                if r.ok {
                    ir_note_lib_pairs(lib_pairs);
                    g_stdlib_cache = OptProgram::Some(core_p);
                    g_stdlib_cache_init = true;
                    g_astcache_hit = true;
                    g_astcache_core_key = g_stdlib_hash;
                    astcache_memo_merged(lib_hash, merged_p);
                    return OptProgram::Some(merged_p);
                }
            }
        }
    }
    return get_cached_stdlib();
}

/// This is the main entry point for the compiler pipeline:
///   parse stdlib -> parse user -> resolve imports -> merge -> cfg filter ->
///   derive -> desugar layers/models -> comptime -> typecheck -> borrowck -> mono
/// G8.2: borrowck_mode is "off", "warn", or "on" (default).
pub fn build_program_with_path_borrowck(source: str, source_path: OptStr, borrowck_mode: str) -> ResultProgram {
    var t0: i64 = p_clock_now_ms();
    var t_t: i64 = t0;
    // CB1: the import cache is on for the first build of the process
    imp_build_start();
    // CD1: the pact modules of this build (noted by the import loop)
    cd1_reset();
    match source_path {
        OptStr::Some(main_path) => {
            inc_record_file(main_path);
        }
        OptStr::None => {
        }
    }
    // core is read from disk here (Rust embeds it): an input like any other
    inc_record_file(c_path_join(stdlib_dir(), "core.fd"));
    // Parse stdlib first (use cache if available); CS2: astcache_load
    // returns the merged core+runtime Program straight from the binary
    // artifact when its lib_hash key matches.
    var stdlib_opt: OptProgram = astcache_load();
    match stdlib_opt {
        OptProgram::None => {
            p_eprint_str("[build] FAILED: stdlib/core.fd not found or parse error\n");
            return ResultProgram::Err(c_vec1("Stdlib not found: stdlib/core.fd (CWD must be project root)"));
        }
        OptProgram::Some(stdlib_parsed) => {
            var stdlib: Program = stdlib_parsed;
            // DB1: core's functions get core.fd's line rows (an artifact hit
            // restored the records in astcache_load)
            if !g_astcache_hit {
                ir_note_lib_program(&stdlib_parsed, c_path_join(stdlib_dir(), "core.fd"));
            }
            // The checked-library stamp (release D9) covers core and the
            // runtime merged into it: a library checked clean once is not
            // checked again until core, a runtime file or the compiler changes
            var lib_hash: i64 = g_astcache_lib_hash;
            t_t = time_mark("stdlib", t_t);
            p_eprint_str("[build] Stdlib parsed ok (cached). Extracting names...\n");
            // Extract stdlib struct/enum names for parser
            var struct_names: Vec<str> = Vec::new();
            var enum_names: Vec<str> = Vec::new();
            var i: i64 = 0;
            while i < stdlib.structs.len() {
                struct_names.push(stdlib.structs.get(i).name);
                i = i + 1;
            }
            i = 0;
            while i < stdlib.enums.len() {
                enum_names.push(stdlib.enums.get(i).name);
                i = i + 1;
            }

            // The Fides runtime of native Windows executables
            // (pe_runtime/*.fd): merged into core before the user program
            // is parsed — the same merge as Rust's
            // build_program_with_runtime (core's definitions win).
            // Skipped on an artifact hit: stdlib arrives already merged.
            if g_pe_runtime_merge && !g_astcache_hit {
                var rt_files: Vec<str> = g_astcache_rt_files;
                var rt_raws: Vec<str> = g_astcache_rt_raws;
                var rti: i64 = 0;
                while rti < rt_files.len() {
                    var rt_raw: str = rt_raws.get(rti);
                    var rt_lex: Lexer = Lexer::new(rt_raw);
                    var rt_tokens: Vec<Token> = rt_lex.tokenize();
                    var rt_parser: Parser = Parser_with_names(rt_tokens, struct_names, enum_names);
                    var rt_res: ParseResultProgram = rt_parser.parse();
                    match rt_res {
                        ParseResultProgram::Err(e) => {
                            return ResultProgram::Err(c_vec1("PE runtime: " + e));
                        }
                        ParseResultProgram::Ok(rt_program) => {
                            imp_note_imports(rt_program);
                            var rsi: i64 = 0;
                            while rsi < rt_program.structs.len() {
                                struct_names.push(rt_program.structs.get(rsi).name);
                                rsi = rsi + 1;
                            }
                            rsi = 0;
                            while rsi < rt_program.enums.len() {
                                enum_names.push(rt_program.enums.get(rsi).name);
                                rsi = rsi + 1;
                            }
                            // DB1: the runtime file's functions get its rows
                            ir_note_lib_program(&rt_program, pe_runtime_path(rt_files.get(rti)));
                            stdlib = merge_programs(rt_program, stdlib);
                        }
                    }
                    rti = rti + 1;
                }
                // First full parse under this key: persist the artifact for
                // later compiles (stdlib_parsed is the core-only Program).
                astcache_save(lib_hash, stdlib_parsed, stdlib, false);
            } else if !g_astcache_hit {
                // SP4: no runtime to merge (`check`, `ccompile`, `dump-c`,
                // `run`): core alone is the artifact, so those builds skip
                // core's lexing and parsing too. Its key is core's hash
                // alone, apart from every merged key.
                astcache_save(lib_hash, stdlib_parsed, stdlib_parsed, true);
            }

            t_t = time_mark("runtime", t_t);
            // Parse user code with stdlib names pre-populated
            p_eprint_str("[build] Lexing user code...\n");
            var t3: i64 = p_clock_now_ms();
            var lex: Lexer = Lexer::new(source);
            var tokens: Vec<Token> = lex.tokenize();
            var t4: i64 = p_clock_now_ms();
            p_eprint_str("[prof] user lex: ");
            p_eprint_str(int_to_str(t4 - t3));
            p_eprint_str("ms\n");
            p_eprint_str("[build] User code lexed. Checking errors...\n");

            // Check for lexer errors
            if lex.errors.len() > 0 {
                p_eprint_str("[build] FAILED: lexer errors\n");
                var file: str = "<stdin>";
                match source_path {
                    OptStr::Some(p) => {
                        file = p;
                    }
                    OptStr::None => {
                    }
                }
                return ResultProgram::Err(enrich_errors(lex.errors, source, file));
            }
            p_eprint_str("[build] Parsing user code...\n");
            var t5: i64 = p_clock_now_ms();
            var p: Parser = Parser_with_names(tokens, struct_names, enum_names);
            p_eprint_str("[build] Parser created. Calling parse()...\n");
            var user_result: ParseResultProgram = p.parse();
            var t6: i64 = p_clock_now_ms();
            t_t = time_mark("user lex+parse", t_t);
            p_eprint_str("[prof] user parse: ");
            p_eprint_str(int_to_str(t6 - t5));
            p_eprint_str("ms\n");
            p_eprint_str("[build] Parse done.\n");
            match user_result {
                ParseResultProgram::Err(e) => {
                    var file2: str = "<stdin>";
                    match source_path {
                        OptStr::Some(p2) => {
                            file2 = p2;
                        }
                        OptStr::None => {
                        }
                    }
                    return ResultProgram::Err(enrich_errors(c_vec1(e), source, file2));
                }
                ParseResultProgram::Ok(user) => {
                    // CB1: the user file's `use` names are in the parser's
                    // import set before any module is parsed
                    imp_note_imports(user);
                    // Collect all known struct/enum names
                    i = 0;
                    while i < user.structs.len() {
                        struct_names.push(user.structs.get(i).name);
                        i = i + 1;
                    }
                    i = 0;
                    while i < user.enums.len() {
                        enum_names.push(user.enums.get(i).name);
                        i = i + 1;
                    }

                    // -- Resolve use imports from disk --------------------------
                    // When source_path is provided, load `use foo::bar;` imports
                    // from disk, handling transitive dependencies.
                    //
                    // OPTIMIZATION (session 4): file content and tokens are cached
                    // by path to avoid re-reading and re-lexing deferred modules.
                    // Previously each module was read+lexed 2-3 times; now once.
                    var imported_modules: Vec<Program> = Vec::new();
                    var imported_module_names: Vec<str> = Vec::new();
                    var loaded_module_names: Vec<str> = Vec::new();
                    // O(1) membership set for loaded modules -- avoids O(n) linear
                    // search in c_str_vec_contains during import resolution.
                    var loaded_module_set: i64 = HashMap_new();
                    var struct_name_set: i64 = HashMap_new();
                    var enum_name_set: i64 = HashMap_new();
                    var content_cache: Vec<PathContent> = Vec::new();
                    var token_cache: Vec<PathTokens> = Vec::new();
                    var parse_cache: Vec<PathProgram> = Vec::new();
                    var has_source_path: bool = false;
                    var base_dir: str = ".";
                    match source_path {
                        OptStr::Some(sp) => {
                            has_source_path = true;
                            base_dir = c_path_dirname(sp);
                        }
                        OptStr::None => {
                        }
                    }

                    // ST3: the project's edition (ark.toml), then the user file's
                    if has_source_path {
                        var proj_ed: i64 = cc_manifest_edition(base_dir);
                        if proj_ed > 0 {
                            set_project_edition(proj_ed);
                        }
                    }
                    var user_ed_module: str = "main";
                    match user.module {
                        OptStr::Some(uem) => {
                            user_ed_module = uem;
                        }
                        OptStr::None => {
                        }
                    }
                    var user_ed_file: str = "<stdin>";
                    match source_path {
                        OptStr::Some(uef) => {
                            user_ed_file = uef;
                        }
                        OptStr::None => {
                        }
                    }
                    var user_ed_err: str = cc_record_edition(user, user_ed_module, user_ed_file);
                    if str_len(user_ed_err) > 0 {
                        return ResultProgram::Err(c_vec1(user_ed_err));
                    }
                    if has_source_path {
                        p_eprint_str("[build] Resolving imports...\n");
                        // Collect imports to process (LIFO -- reversed so earlier
                        // imports are processed first via pop())
                        var imports_to_process: Vec<str> = Vec::new();
                        var ui: i64 = user.imports.len() - 1;
                        p_eprint_str("[build] user.imports.len() = ");
                        p_eprint_str(int_to_str(user.imports.len()));
                        p_eprint_str("\n");
                        while ui >= 0 {
                            imports_to_process.push(user.imports.get(ui).path);
                            ui = ui - 1;
                        }

                        // Track modules that are currently deferred (waiting for deps).
                        // If a module is deferred again while already in this set,
                        // it means there's a cyclic import -- report an error.
                        var currently_deferred: Vec<str> = Vec::new();

                        var project_root: str = find_project_root(base_dir);
                        // TL9: the pacts `ark install` put in ark_modules/
                        var ark_root: str = ark_project_root(base_dir);
                        // SP9: FID_PAR=N lexes the import closure first, in N
                        // threads (not with the import or module cache: a hit
                        // neither lexes nor parses)
                        var pf_nw: i64 = esc_par_workers();
                        if pf_nw >= 2 && !imp_active() && !g_modcache_on {
                            var t_pf: i64 = p_clock_now_ms();
                            var pf_graph: ModGraph = imp_prefetch_lex(user, base_dir, ark_root, project_root, pf_nw, &mut content_cache, &mut token_cache);
                            time_row("  imports: lexed ahead, " + modgraph_summary(modgraph_levels(pf_graph.deps)), p_clock_now_ms() - t_pf);
                        }

                        while imports_to_process.len() > 0 {
                            var import_path: str = imports_to_process.get(imports_to_process.len() - 1);
                            imports_to_process.pop();
                            p_eprint_str("[build] Processing import: ");
                            p_eprint_str(import_path);
                            p_eprint_str("\n");

                            // Skip "core" -- auto-included
                            if import_path == "core" {
                                continue;
                            }

                            // Skip already-loaded modules -- O(1) HashMap lookup
                            if HashMap_get(loaded_module_set, import_path) != 0 {
                                continue;
                            }

                            // Try candidate paths
                            var path_str: str = c_platform_module(str_replace(import_path, "::", "/"));
                            var candidates: Vec<str> = Vec::new();
                            candidates.push(c_path_join(base_dir, str_concat(path_str, ".fd")));
                            candidates.push(c_path_join(base_dir, c_path_join(path_str, "mod.fd")));
                            // TL9: an installed pact, before the stdlib (a
                            // dependency is a deliberate choice)
                            ark_push_candidates(&mut candidates, ark_root, path_str);
                            candidates.push(c_path_join(stdlib_dir(), str_concat(path_str, ".fd")));
                            candidates.push(c_path_join(stdlib_dir(), c_path_join(path_str, "mod.fd")));
                            candidates.push(c_path_join(project_root, str_concat(path_str, ".fd")));
                            candidates.push(c_path_join(project_root, c_path_join(path_str, "mod.fd")));

                            var found_path: str = "";
                            var found: bool = false;
                            var is_header: bool = false;
                            var ci: i64 = 0;
                            while ci < candidates.len() {
                                if c_file_exists(candidates.get(ci)) {
                                    found_path = candidates.get(ci);
                                    found = true;
                                    break;
                                }
                                // A file created here later would change this import.
                                inc_record_absent(candidates.get(ci));
                                ci = ci + 1;
                            }

                            if !found {
                                // LG15: `use foo` with no foo.fd but a foo.h
                                // beside the program (or at the project root)
                                // imports generated C bindings — the Zig
                                // @cImport shape, resolved by filename.
                                var hc: Vec<str> = Vec::new();
                                hc.push(c_path_join(base_dir, str_concat(path_str, ".h")));
                                hc.push(c_path_join(project_root, str_concat(path_str, ".h")));
                                // LG16: a C++ header (its extern "C" functions)
                                hc.push(c_path_join(base_dir, str_concat(path_str, ".hpp")));
                                hc.push(c_path_join(project_root, str_concat(path_str, ".hpp")));
                                ci = 0;
                                while ci < hc.len() {
                                    if c_file_exists(hc.get(ci)) {
                                        found_path = hc.get(ci);
                                        found = true;
                                        is_header = true;
                                        break;
                                    }
                                    inc_record_absent(hc.get(ci));
                                    ci = ci + 1;
                                }
                            }
                            // LG15: a header written as @import("stdio.h") that
                            // is not beside the program: the system include
                            // directories; the C code then includes it (<...>)
                            var sys_include: str = "";
                            if !found && at_import_flags(import_path) > 0 {
                                var sdirs: Vec<str> = cc_system_include_dirs();
                                ci = 0;
                                while ci < sdirs.len() {
                                    var sh: str = c_path_join(sdirs.get(ci), str_concat(path_str, ".h"));
                                    if c_file_exists(sh) {
                                        found_path = sh;
                                        found = true;
                                        is_header = true;
                                        sys_include = "<" + path_str + ".h>";
                                        break;
                                    }
                                    ci = ci + 1;
                                }
                            }

                            if found {
                                inc_record_file(found_path);
                                var pre_result_opt: OptProgram = OptProgram::None;
                                var pre_toks: Vec<Token> = Vec::new();
                                if is_header {
                                    p_eprint_str("[build] C header import: ");
                                    p_eprint_str(found_path);
                                    p_eprint_str("\n");
                                    var hsrc: str = cparse_header_file_for(found_path, "", "", sys_include, source);
                                    var hlex: Lexer = Lexer::new(hsrc);
                                    var htoks: Vec<Token> = hlex.tokenize();
                                    var hpar: Parser = Parser_with_names(htoks, struct_names, enum_names);
                                    match hpar.parse() {
                                        ParseResultProgram::Ok(hprog) => {
                                            imp_note_imports(hprog);
                                            // LG15: @import("x.h", trusted): its
                                            // functions need no `unsafe`
                                            if at_import_flags(import_path) == 3 {
                                                var trusted_prog: Program = hprog;
                                                trusted_prog.attributes.push(Attribute_new("trusted_c", Vec::new()));
                                                pre_result_opt = OptProgram::Some(trusted_prog);
                                            } else {
                                                pre_result_opt = OptProgram::Some(hprog);
                                            }
                                        }
                                        ParseResultProgram::Err(herr) => {
                                            return ResultProgram::Err(c_vec1("C header import " + found_path + ": " + herr));
                                        }
                                    }
                                } else {
                                    // CB2: parsed by an earlier build of this
                                    // process (serve, fix, lsp) from the same text
                                    pre_result_opt = modcache_get(&mut content_cache, found_path);
                                    var mc_hit: bool = false;
                                    match pre_result_opt {
                                        OptProgram::Some(_) => {
                                            mc_hit = true;
                                        }
                                        OptProgram::None => {
                                        }
                                    }
                                    if !mc_hit {
                                        // OPTIMIZATION: use cached file read + cached lex + cached parse
                                        // Pre-scan: parse to extract imports and type names.
                                        // OPTIMIZATION: use cached_parse to avoid re-parsing deferred modules.
                                        // CB1: cached_parse lexes only when the
                                        // import cache misses; a lex error stops
                                        // it before the parse
                                        pre_result_opt = cached_parse(&mut parse_cache, &mut token_cache, &mut content_cache, found_path, struct_names, enum_names);
                                        if g_import_lex_errors.len() > 0 {
                                            var lex_errs: Vec<str> = g_import_lex_errors;
                                            g_import_lex_errors = Vec::new();
                                            return ResultProgram::Err(lex_errs);
                                        }
                                        match pre_result_opt {
                                            OptProgram::Some(mc_prog) => {
                                                modcache_put(&mut content_cache, found_path, mc_prog);
                                            }
                                            OptProgram::None => {
                                                // the full parse below reads the tokens
                                                pre_toks = cached_lex(&mut token_cache, &mut content_cache, found_path);
                                            }
                                        }
                                    }
                                }

                                match pre_result_opt {
                                    OptProgram::Some(pre_prog) => {
                                        // Add this module's type names to name sets
                                        var si: i64 = 0;
                                        while si < pre_prog.structs.len() {
                                            var sn: str = pre_prog.structs.get(si).name;
                                            if HashMap_get(struct_name_set, sn) == 0 {
                                                struct_names.push(sn);
                                                HashMap_insert(struct_name_set, sn, 1);
                                            }
                                            si = si + 1;
                                        }
                                        var ei: i64 = 0;
                                        while ei < pre_prog.enums.len() {
                                            var en: str = pre_prog.enums.get(ei).name;
                                            if HashMap_get(enum_name_set, en) == 0 {
                                                enum_names.push(en);
                                                HashMap_insert(enum_name_set, en, 1);
                                            }
                                            ei = ei + 1;
                                        }

                                        // Check for unloaded transitive deps
                                        var unloaded_deps: Vec<str> = Vec::new();
                                        var di: i64 = 0;
                                        while di < pre_prog.imports.len() {
                                            var dep: str = pre_prog.imports.get(di).path;
                                            if dep != "core" && HashMap_get(loaded_module_set, dep) == 0 {
                                                unloaded_deps.push(dep);
                                            }
                                            di = di + 1;
                                        }

                                        if unloaded_deps.len() > 0 {
                                            // Cycle detection: if this module is already deferred,
                                            // it means we're in a cyclic import chain.
                                            if cc_c_str_vec_contains(currently_deferred, import_path) {
                                                p_eprint_str("[build] WARNING: cyclic import detected involving '");
                                                p_eprint_str(import_path);
                                                p_eprint_str("' -- skipping\n");
                                                continue;
                                            }
                                            // Defer: push this module back, then push deps
                                            currently_deferred.push(import_path);
                                            imports_to_process.push(import_path);
                                            var di2: i64 = 0;
                                            while di2 < unloaded_deps.len() {
                                                if HashMap_get(loaded_module_set, unloaded_deps.get(di2)) == 0 {
                                                    imports_to_process.push(unloaded_deps.get(di2));
                                                }
                                                di2 = di2 + 1;
                                            }
                                            continue;
                                        }

                                        // All deps loaded — reuse pre-scan result as the
                                        // final parse. The pre-scan already parsed the
                                        // module successfully; the only difference between
                                        // pre-scan and full parse is the name sets, but a
                                        // module rarely needs its own type names
                                        // pre-registered to parse correctly (the pre-scan
                                        // already succeeded without them).
                                        // OPTIMIZATION: this eliminates the second parse
                                        // (pre-scan + full → just pre-scan), cutting parse
                                        // time in half for the import phase.
                                        var imported: Program = pre_prog;

                                        var mod_name: str = import_path;
                                        match imported.module {
                                            OptStr::Some(mn) => {
                                                mod_name = mn;
                                            }
                                            OptStr::None => {
                                            }
                                        }
                                        loaded_module_names.push(import_path);
                                        loaded_module_names.push(mod_name);
                                        HashMap_insert(loaded_module_set, import_path, 1);
                                        HashMap_insert(loaded_module_set, mod_name, 1);

                                        // Clear from deferred set -- successfully loaded
                                        var deferred_idx: i64 = 0;
                                        while deferred_idx < currently_deferred.len() {
                                            if currently_deferred.get(deferred_idx) == import_path {
                                                currently_deferred.remove(deferred_idx);
                                                break;
                                            }
                                            deferred_idx = deferred_idx + 1;
                                        }

                                        // Extract names for future imports
                                        var si2: i64 = 0;
                                        while si2 < imported.structs.len() {
                                            var sn2: str = imported.structs.get(si2).name;
                                            if HashMap_get(struct_name_set, sn2) == 0 {
                                                struct_names.push(sn2);
                                                HashMap_insert(struct_name_set, sn2, 1);
                                            }
                                            si2 = si2 + 1;
                                        }
                                        var ei2: i64 = 0;
                                        while ei2 < imported.enums.len() {
                                            var en2: str = imported.enums.get(ei2).name;
                                            if HashMap_get(enum_name_set, en2) == 0 {
                                                enum_names.push(en2);
                                                HashMap_insert(enum_name_set, en2, 1);
                                            }
                                            ei2 = ei2 + 1;
                                        }

                                        // Add transitive imports
                                        var ti: i64 = 0;
                                        while ti < imported.imports.len() {
                                            var tpath: str = imported.imports.get(ti).path;
                                            if HashMap_get(loaded_module_set, tpath) == 0 {
                                                imports_to_process.push(tpath);
                                            }
                                            ti = ti + 1;
                                        }

                                        imported_modules.push(imported);
                                        imported_module_names.push(mod_name);
                                        if !is_header {
                                            record_module_file(mod_name, found_path);
                                            ir_note_program_files(&imported, found_path);
                                            cd1_note_module(mod_name, found_path, ark_root);
                                        }
                                        var imp_ed_err: str = cc_record_edition(imported, mod_name, found_path);
                                        if str_len(imp_ed_err) > 0 {
                                            return ResultProgram::Err(c_vec1(imp_ed_err));
                                        }
                                    }
                                    OptProgram::None => {
                                        // Pre-scan failed -- try full parse directly
                                        // OPTIMIZATION: reuse cached tokens
                                        var p2: Parser = Parser_with_names(pre_toks, struct_names, enum_names);
                                        var full_result: ParseResultProgram = p2.parse();
                                        match full_result {
                                            ParseResultProgram::Ok(imported) => {
                                                imp_note_imports(imported);
                                                var mod_name: str = import_path;
                                                match imported.module {
                                                    OptStr::Some(mn) => {
                                                        mod_name = mn;
                                                    }
                                                    OptStr::None => {
                                                    }
                                                }
                                                loaded_module_names.push(import_path);
                                                loaded_module_names.push(mod_name);
                                                HashMap_insert(loaded_module_set, import_path, 1);
                                                HashMap_insert(loaded_module_set, mod_name, 1);
                                                imported_modules.push(imported);
                                                imported_module_names.push(mod_name);
                                                record_module_file(mod_name, found_path);
                                                ir_note_program_files(&imported, found_path);
                                                cd1_note_module(mod_name, found_path, ark_root);
                                                var imp_ed_err2: str = cc_record_edition(imported, mod_name, found_path);
                                                if str_len(imp_ed_err2) > 0 {
                                                    return ResultProgram::Err(c_vec1(imp_ed_err2));
                                                }
                                            }
                                            ParseResultProgram::Err(errs2) => {
                                                // Full parse also failed -- return error
                                                var err_msg: str = "Import error: failed to parse module '" + import_path + "'";
                                                err_msg = err_msg + ": " + errs2;
                                                return ResultProgram::Err(c_vec1(err_msg));
                                            }
                                        }
                                    }
                                }
                            } else {
                                // Import not found -- return error
                                return ResultProgram::Err(c_vec1(str_concat("Import error: could not resolve module '", str_concat(import_path, "'"))));
                            }
                        }

                        // Re-parse user code with full name set (including imported types)
                        var reparser: Parser = Parser_with_names(tokens, struct_names, enum_names);
                        var reparse_result: ParseResultProgram = reparser.parse();
                        match reparse_result {
                            ParseResultProgram::Ok(reparsed) => {
                                user = reparsed;
                            }
                            ParseResultProgram::Err(_) => {
                            }
                        }
                        // CB1: how many modules came from the import cache
                        var imp_sum: str = impcache_summary();
                        if str_len(imp_sum) > 0 {
                            p_eprint_str("[build] " + imp_sum + "\n");
                        }
                    }

                    t_t = time_mark("imports", t_t);
                    // L8H: a module's narrower definitions of a generic one of a module it
                    // imports are its specializations (parser.fd)
                    var cms_errs: Vec<str> = pd_cross_module_specializations(&mut imported_modules, imported_module_names, &mut user);
                    if cms_errs.len() > 0 {
                        return ResultProgram::Err(cms_errs);
                    }
                    // A user function named like a function of one imported
                    // module: each side keeps its own (module__name).
                    cc_qualify_shadowed_imports(&mut imported_modules, imported_module_names, &mut user, stdlib);
                    t_t = time_mark("merge: shadowed imports", t_t);

                    // `cap Sub: Super`: Sub carries Super's methods.
                    var trait_defs: Vec<TraitDef> = Vec::new();
                    cc_push_traits(&mut trait_defs, stdlib);
                    var tmi: i64 = 0;
                    while tmi < imported_modules.len() {
                        cc_push_traits(&mut trait_defs, imported_modules.get(tmi));
                        tmi = tmi + 1;
                    }
                    cc_push_traits(&mut trait_defs, user);
                    var super_errors: Vec<str> = Vec::new();
                    tmi = 0;
                    while tmi < imported_modules.len() {
                        cc_inherit_supertraits(imported_modules.get(tmi), trait_defs, &mut super_errors);
                        tmi = tmi + 1;
                    }
                    cc_inherit_supertraits(&mut user, trait_defs, &mut super_errors);
                    if super_errors.len() > 0 {
                        return ResultProgram::Err(super_errors);
                    }
                    t_t = time_mark("merge: supertraits", t_t);

                    // A function defined twice in one module used to collapse
                    // silently into one (src/compiler.rs find_module_conflicts).
                    var dup_errors: Vec<str> = Vec::new();
                    var dmi: i64 = 0;
                    while dmi < imported_modules.len() {
                        cc_find_duplicate_funcs(imported_modules.get(dmi), imported_module_names.get(dmi), &mut dup_errors);
                        dmi = dmi + 1;
                    }
                    var dup_user_module: str = "main";
                    match user.module {
                        OptStr::Some(um) => {
                            dup_user_module = um;
                        }
                        OptStr::None => {
                        }
                    }
                    cc_find_duplicate_funcs(user, dup_user_module, &mut dup_errors);
                    cc_find_module_conflicts(stdlib, imported_modules, imported_module_names, user, dup_user_module, &mut dup_errors);
                    cc_find_trait_impl_conflicts(imported_modules, imported_module_names, user, &mut dup_errors);
                    if dup_errors.len() > 0 {
                        return ResultProgram::Err(dup_errors);
                    }
                    t_t = time_mark("merge: duplicate checks", t_t);

                    // SL13: `ccompile --fuzz-cov` (fid test --fuzz): the
                    // harness's program and its own modules get a
                    // `__fz_hit(k)` per block (fuzz_cov_program)
                    if g_fuzz_cov && fzc_has_hook(user) {
                        fuzz_cov_program(&mut user);
                        var fz_mods: Vec<Program> = Vec::new();
                        var fzi: i64 = 0;
                        while fzi < imported_modules.len() {
                            var fz_m: Program = imported_modules.get(fzi);
                            if fzc_module_wanted(imported_module_names.get(fzi)) {
                                fuzz_cov_program(&mut fz_m);
                            }
                            fz_mods.push(fz_m);
                            fzi = fzi + 1;
                        }
                        imported_modules = fz_mods;
                        p_eprint_str("[build] fuzz coverage: " + int_to_str(fuzz_cov_sites()) + " blocks\n");
                    }

                    // Merge: start with stdlib, then imported modules, then user
                    record_func_modules(stdlib, "core");
                    var program: Program = stdlib;

                    // Merge imported modules
                    var mi: i64 = 0;
                    while mi < imported_modules.len() {
                        var imported_name: str = "module" + int_to_str(mi);
                        match imported_modules.get(mi).module {
                            OptStr::Some(im) => {
                                imported_name = im;
                            }
                            OptStr::None => {
                            }
                        }
                        record_func_modules(imported_modules.get(mi), imported_name);
                        program = merge_programs(program, imported_modules.get(mi));
                        mi = mi + 1;
                    }

                    // Merge user (highest priority)
                    record_func_modules(user, dup_user_module);
                    program = merge_programs(program, user);
                    t_t = time_mark("merge: merge_programs", t_t);

                    // Phase 7.7: Conditional compilation filter
                    // rm-L5A-dep-features: `@cfg(feature = "x")` from
                    // ark_modules/.features
                    g_cfg_features = cfg_ark_features(base_dir);
                    ct_sync_target();
                    apply_cfg_filter(&mut program);

                    // Phase 7.7: Process @derive annotations
                    process_derive(&mut program);
                    // OP15: the @cold functions, for the native backends' block layout
                    cc_collect_cold_hints(program);

                    // R1.2: structural `==` for enums (the lowerer calls `__eq_<Enum>`).
                    synthesize_enum_eq(&mut program);
                    // R1.2b: structural `==` for structs (`__eq_<Struct>`).
                    synthesize_struct_eq(&mut program);
                    t_t = time_mark("merge: cfg+derive+eq", t_t);

                    // Desugar layer/model declarations
                    desugar_layers_models(&mut program);
                    desugar_phase8b(&mut program);
                    t_t = time_mark("merge: desugars", t_t);

                    // Comptime: process gen blocks (before typechecking so generated code is visible)
                    program = process_gen(program);
                    var ctg_errors: Vec<str> = comptime_gen_errors();
                    if ctg_errors.len() > 0 {
                        var file_ctg: str = "<stdin>";
                        match source_path {
                            OptStr::Some(pcg) => {
                                file_ctg = pcg;
                            }
                            OptStr::None => {
                            }
                        }
                        return ResultProgram::Err(enrich_errors(ctg_errors, source, file_ctg));
                    }
                    // §4.11: statement `comptime if` selection and `inline
                    // for` unrolling, before type checking (the branch not
                    // taken is never checked; generic functions wait for
                    // substitute's second pass, after mono)
                    program = expand_comptime(program);
                    var cte_errors: Vec<str> = comptime_expand_errors();
                    if cte_errors.len() > 0 {
                        var file_cte: str = "<stdin>";
                        match source_path {
                            OptStr::Some(pce) => {
                                file_cte = pce;
                            }
                            OptStr::None => {
                            }
                        }
                        return ResultProgram::Err(enrich_errors(cte_errors, source, file_cte));
                    }
                    // LG9: `==` for the structs and enums `comptime gen`
                    // created (both skip a type whose __eq_ exists already)
                    synthesize_enum_eq(&mut program);
                    synthesize_struct_eq(&mut program);
                    t_t = time_mark("merge: comptime+eq", t_t);

                    // Phase 3B.1: Fill in default trait methods
                    fill_default_trait_methods(&mut program);
                    t_t = time_mark("merge: trait defaults", t_t);

                    // Turbofish calls `f::<T>(..)`: instantiated before type
                    // checking, so every pass sees an ordinary call (0002)
                    program = mono_resolve_turbofish(program, turbofish_all());
                    var tf_errors: Vec<str> = mono_turbofish_errors();
                    if tf_errors.len() > 0 {
                        var file_tf: str = "<stdin>";
                        match source_path {
                            OptStr::Some(ptf) => {
                                file_tf = ptf;
                            }
                            OptStr::None => {
                            }
                        }
                        return ResultProgram::Err(enrich_errors(tf_errors, source, file_tf));
                    }

                    t_t = time_mark("merge+desugar", t_t);
                    p_eprint_str("[build] Type checking...\n");
                    var t_tc: i64 = p_clock_now_ms();
                    // Type check -- register each module with its own name
                    var tc: TypeChecker = TypeChecker::new();
                    var stdlib_module: str = "core";
                    match stdlib.module {
                        OptStr::Some(m) => {
                            stdlib_module = m;
                        }
                        OptStr::None => {
                        }
                    }
                    TypeChecker_register_program(&mut tc, stdlib, stdlib_module);

                    // Register imported modules
                    var mi2: i64 = 0;
                    while mi2 < imported_modules.len() {
                        TypeChecker_register_program(&mut tc, imported_modules.get(mi2), imported_module_names.get(mi2));
                        mi2 = mi2 + 1;
                    }

                    var user_module: str = "main";
                    match user.module {
                        OptStr::Some(m2) => {
                            user_module = m2;
                        }
                        OptStr::None => {
                        }
                    }
                    note_program_path(source_path);
                    TypeChecker_register_program(&mut tc, user, user_module);

                    TypeChecker_register_trait_impls(&mut tc, program);
                    TypeChecker_register_generated_decls(&mut tc, program);
                    TypeChecker_verify_trait_impls(&mut tc, program);
                    TypeChecker_collect_capabilities(&mut tc, user);
                    // Core's bodies are checked once per core and compiler
                    // (release D9): user code still sees every declaration
                    // of core; only re-checking its bodies is skipped
                    var core_checked: bool = false;
                    var core_skip: i64 = 0;
                    match g_stdlib_cache {
                        OptProgram::Some(_core_only) => {
                            // the skip set covers the merged library (core and
                            // the runtime), keyed by both (lib_hash)
                            var core_prog: Program = stdlib;
                            core_checked = inc_core_checked(lib_hash);
                            if core_checked {
                                var others: Vec<Program> = Vec::new();
                                others.push(user);
                                var oi2: i64 = 0;
                                while oi2 < imported_modules.len() {
                                    others.push(imported_modules.get(oi2));
                                    oi2 = oi2 + 1;
                                }
                                core_skip = tc_core_skip_set(core_prog, others);
                                tc.skip_bodies = core_skip;
                            }
                        }
                        OptProgram::None => {
                        }
                    }
                    t_t = time_mark("tc register", t_t);
                    // CB2: a `fid serve` check request leaves out the bodies
                    // no edit since its last clean check can reach
                    if g_cb2_req {
                        core_skip = cb2_skip_set(core_skip, source, source_path, tokens, user_module, imported_module_names, &mut content_cache, &token_cache, cb2_config(lib_hash, borrowck_mode, base_dir));
                        tc.skip_bodies = core_skip;
                        t_t = time_mark("cb2 plan", t_t);
                    }
                    TypeChecker_check_bodies(&mut tc, program);
                    t_t = time_mark("typecheck", t_t);

                    if tc.errors.len() > 0 {
                        p_eprint_str("[build] FAILED: type errors\n");
                        var file3: str = "<stdin>";
                        match source_path {
                            OptStr::Some(p3) => {
                                file3 = p3;
                            }
                            OptStr::None => {
                            }
                        }
                        return ResultProgram::Err(enrich_errors(tc.errors, source, file3));
                    }
                    // References are second-class: none may outlive what it points to.
                    var escape_errors: Vec<str> = escape_check_skipped(program, core_skip);
                    if escape_errors.len() > 0 {
                        p_eprint_str("[build] FAILED: reference errors\n");
                        var file5: str = "<stdin>";
                        match source_path {
                            OptStr::Some(p5) => {
                                file5 = p5;
                            }
                            OptStr::None => {
                            }
                        }
                        return ResultProgram::Err(enrich_errors(escape_errors, source, file5));
                    }
                    var secret_errors: Vec<str> = secrecy_check_skipped(program, core_skip);
                    if secret_errors.len() > 0 {
                        p_eprint_str("[build] FAILED: @secret/@sensitive errors\n");
                        var file8: str = "<stdin>";
                        match source_path {
                            OptStr::Some(p8) => {
                                file8 = p8;
                            }
                            OptStr::None => {
                            }
                        }
                        return ResultProgram::Err(enrich_errors(secret_errors, source, file8));
                    }
                    t_t = time_mark("escape+secrecy", t_t);
                    // CD1: each pact the program imports against ark.toml's
                    // [capabilities] (nothing to do outside a project with
                    // that section), from what the checker inferred
                    var cap_errors: Vec<str> = cd1_check(program, &tc, imported_modules, imported_module_names);
                    if cap_errors.len() > 0 {
                        p_eprint_str("[build] FAILED: pact capabilities not granted\n");
                        return ResultProgram::Err(cap_errors);
                    }
                    p_eprint_str("[build] Type check ok.\n");
                    var t_bc: i64 = p_clock_now_ms();
                    p_eprint_str("[prof] typecheck: ");
                    p_eprint_str(int_to_str(t_bc - t_tc));
                    p_eprint_str("ms\n");

                    // Run lints (warnings only; CB2: not for a serve check
                    // request, whose answer holds errors only)
                    if !g_cb2_req {
                        tc.run_lints(program);
                    }
                    t_t = time_mark("lints", t_t);
                    // G8.7: Stash warnings for lint_source to read
                    g_lint_warnings = tc.warnings;
                    // CU3 (complaint-roadmap): a call of a @deprecated
                    // function is a warning on every build, run and check,
                    // on stderr (before, only `fid lint` printed it). The
                    // other checker warnings (unused function or import)
                    // stay with `fid lint`.
                    var dwi: i64 = 0;
                    while dwi < tc.warnings.len() {
                        var dw: str = tc.warnings.get(dwi);
                        // CA10: a blocking call in async code, likewise
                        if str_contains(dw, "' is deprecated") || str_contains(dw, "which blocks the worker thread") {
                            p_eprint_str(dw);
                            p_eprint_str("\n");
                        }
                        dwi = dwi + 1;
                    }
                    // The typechecker is done: its tables go now, not at the
                    // end of the build
                    TypeChecker_free_maps(&mut tc);

                    // G8.2: Borrow check — mode controlled by borrowck_mode parameter.
                    //   "off"  : skip borrow checking entirely
                    //   "warn" : report errors as warnings, don't fail
                    //   "on"  : report errors and fail compilation (default)
                    if borrowck_mode != "off" {
                        p_eprint_str("[build] Borrow checking (mode=");
                        p_eprint_str(borrowck_mode);
                        p_eprint_str(")...\n");
                        var bc_mode: BorrowckMode = BorrowckMode::On;
                        if borrowck_mode == "warn" {
                            bc_mode = BorrowckMode::Warn;
                        }
                        var bc: BorrowChecker = BorrowChecker_new(bc_mode);
                        bc.skip_bodies = core_skip;
                        check(&mut bc, program);
                        // Warn mode collects into bc.warnings (known-bugs 2g.9: nothing was
                        // printed, the code below reads bc.errors only)
                        var wi: i64 = 0;
                        while wi < bc.warnings.len() {
                            p_eprint_str("warning: ");
                            p_eprint_str(bc.warnings.get(wi));
                            p_eprint_str("
");
                            wi = wi + 1;
                        }
                        BorrowChecker_free_maps(&mut bc);
                        if bc.errors.len() > 0 {
                            var file4: str = "<stdin>";
                            match source_path {
                                OptStr::Some(p4) => {
                                    file4 = p4;
                                }
                                OptStr::None => {
                                }
                            }
                            if borrowck_mode == "warn" {
                                // Report as warnings, don't fail
                                var ei: i64 = 0;
                                while ei < bc.errors.len() {
                                    p_eprint_str("warning: ");
                                    p_eprint_str(bc.errors.get(ei));
                                    p_eprint_str("\n");
                                    ei = ei + 1;
                                }
                            } else {
                                return ResultProgram::Err(enrich_errors(bc.errors, source, file4));
                            }
                        }
                    } else {
                        p_eprint_str("[build] Borrow checking skipped (mode=off).\n");
                    }
                    t_t = time_mark("borrowck", t_t);

                    // FIDES_COW_CHECK=1: the copy-on-write migration report
                    // (proposal 0001, release M5): changes that only reach
                    // their place while Vecs are shared handles
                    if str_len(env_or_empty("FIDES_COW_CHECK")) > 0 {
                        var cow_reports: Vec<str> = cow_check_program(program);
                        var cri: i64 = 0;
                        while cri < cow_reports.len() {
                            p_eprint_str("cow: " + cow_reports.get(cri) + "
");
                            cri = cri + 1;
                        }
                        p_eprint_str("cow: " + int_to_str(cow_reports.len()) + " place(s)
");
                    }

                    // Comptime: substitute comptime expressions with their values
                    // Everything in core passed: later builds skip its bodies
                    if !core_checked && borrowck_mode == "on" {
                        inc_core_mark_checked(lib_hash);
                    }
                    // CB2: a serve check request is answered here: comptime
                    // substitution and monomorphization report no errors.
                    // What passed is the clean state of the next request.
                    if g_cb2_req {
                        cb2_commit();
                        // SP8: a build request goes on to the program
                        if !g_cb2_build {
                            p_eprint_str("[build] Done (check only).\n");
                            return ResultProgram::Ok(program);
                        }
                    }
                    program = substitute(program);
                    // A `comptime` that could not be evaluated is a compile
                    // error (FID_CT_FALLBACK=1 restores the old warn-and-
                    // run-at-runtime behavior)
                    var cts_errors: Vec<str> = comptime_subst_errors();
                    if cts_errors.len() > 0 {
                        var file_cts: str = "<stdin>";
                        match source_path {
                            OptStr::Some(pcs) => {
                                file_cts = pcs;
                            }
                            OptStr::None => {
                            }
                        }
                        return ResultProgram::Err(enrich_errors(cts_errors, source, file_cts));
                    }
                    t_t = time_mark("comptime", t_t);

                    p_eprint_str("[build] Monomorphizing...\n");
                    var t_mono: i64 = p_clock_now_ms();
                    p_eprint_str("[prof] borrowck: ");
                    p_eprint_str(int_to_str(t_mono - t_bc));
                    p_eprint_str("ms\n");
                    // Monomorphize generics
                    var mono_result: Program = monomorphize(program);
                    var t_mono_end: i64 = p_clock_now_ms();
                    t_t = time_mark("mono", t_t);
                    // Comptime over instantiations (§4.11): a generic
                    // function's comptime nodes (the reflection its
                    // `comptime T: type` parameters drive) are evaluated now,
                    // once T is a concrete type. The need-scan keeps the
                    // second pass to the functions that have comptime nodes
                    // (the first pass left theirs: generics were skipped).
                    mono_result = substitute(mono_result);
                    var cts2_errors: Vec<str> = comptime_subst_errors();
                    if cts2_errors.len() > 0 {
                        var file_cts2: str = "<stdin>";
                        match source_path {
                            OptStr::Some(pcs2) => {
                                file_cts2 = pcs2;
                            }
                            OptStr::None => {
                            }
                        }
                        return ResultProgram::Err(enrich_errors(cts2_errors, source, file_cts2));
                    }
                    p_eprint_str("[prof] mono: ");
                    p_eprint_str(int_to_str(t_mono_end - t_mono));
                    p_eprint_str("ms\n");
                    p_eprint_str("[build] Done. Program built successfully.\n");
                    p_eprint_str("[prof] total build: ");
                    p_eprint_str(int_to_str(t_mono_end - t0));
                    p_eprint_str("ms\n");
                    return ResultProgram::Ok(mono_result);
                }
            }
        }
    }
    return ResultProgram::Err(c_vec1("unreachable"));
}

/// Compile source to C code.
pub fn ccompile_source_with_path(source: str, source_path: str, borrowck_mode: str) -> ResultStr {
    // Check incremental cache -- skip full pipeline if source is unchanged
    var src_hash: i64 = hash_source(source);
    match global_cache_get(source_path, src_hash) {
        OptIrModule::Some(cached_module) => {
            p_eprint_str("[ccompile] Cache HIT -- skipping parse/typecheck/lower/optimize\n");
            var t_codegen: i64 = p_clock_now_ms();
            var cg: CCodeGen = CCodeGen_new();
            var c_code: str = CCodeGen_generate(&mut cg, cached_module);
            // LF18: a @constant_time violation is a compile error, not C
            // with an #error line handed to the C compiler
            val ct_errs_hit: Vec<str> = c_ct_error_lines();
            if ct_errs_hit.len() > 0 {
                return ResultStr::Err(ct_errs_hit);
            }
            var t_cg_end: i64 = time_mark("C generation", t_codegen);
            p_eprint_str("[prof] codegen (cached): ");
            p_eprint_str(int_to_str(t_cg_end - t_codegen));
            p_eprint_str("ms\n");
            return ResultStr::Ok(c_code);
        }
        OptIrModule::None => {
        }
    }

    p_eprint_str("[ccompile] Building program...\n");
    // Built and lowered in a function of its own: the program's tree and
    // the checkers' tables are freed before C generation (release item 10)
    var t_lower: i64 = p_clock_now_ms();
    g_c_reach = true;
    var lowered: ResultIrModule = lower_to_ir_module_with_path(source, source_path, borrowck_mode);
    g_c_reach = false;
    match lowered {
        ResultIrModule::Err(errs) => {
            p_eprint_str("[ccompile] Building program FAILED\n");
            return ResultStr::Err(errs);
        }
        ResultIrModule::Ok(lmod) => {
            var t_codegen: i64 = p_clock_now_ms();
            p_eprint_str("[prof] lower: ");
            p_eprint_str(int_to_str(t_codegen - t_lower));
            p_eprint_str("ms\n");
            // Note: The Rust compiler's ccompile_source_traced does NOT run
            // IrModule_optimize (DCE/const-fold) before C codegen. We match
            // that behavior to produce identical C output.
            // Store in incremental cache for future invocations
            global_cache_store(source_path, src_hash, lmod);
            p_eprint_str("[ccompile] Generating C code...\n");
            var cg: CCodeGen = CCodeGen_new();
            var c_code: str = CCodeGen_generate(&mut cg, lmod);
            // LF18: as above
            val ct_errs: Vec<str> = c_ct_error_lines();
            if ct_errs.len() > 0 {
                return ResultStr::Err(ct_errs);
            }
            var t_cg_end: i64 = time_mark("C generation", t_codegen);
            p_eprint_str("[prof] codegen: ");
            p_eprint_str(int_to_str(t_cg_end - t_codegen));
            p_eprint_str("ms\n");
            p_eprint_str("[ccompile] C codegen done.\n");
            return ResultStr::Ok(c_code);
        }
    }
    return ResultStr::Err(c_vec1("unreachable"));
}

/// G8.5: Compile source to WASM binary (or WAT text if wat_mode=true).
/// Pipeline: build_program → lower → generate_wasm/dump_wat
pub fn compile_to_wasm(source: str, source_path: str, wat_mode: bool) -> ResultBytes {
    var result: ResultProgram = build_program_with_path(source, OptStr::Some(source_path));
    match result {
        ResultProgram::Err(errs) => {
            return ResultBytes::Err(errs);
        }
        ResultProgram::Ok(program) => {
            var module: IrModule = lower(program);
            if wat_mode {
                var wat_text: str = dump_wat(module);
                var bytes: Vec<i64> = Vec::new();
                var n: i64 = str_len(wat_text);
                var i: i64 = 0;
                while i < n {
                    bytes.push(str_byte_at(wat_text, i));
                    i = i + 1;
                }
                return ResultBytes::Ok(bytes);
            } else {
                var wasm_bytes: Vec<i64> = generate_wasm(module);
                return ResultBytes::Ok(wasm_bytes);
            }
        }
    }
    return ResultBytes::Err(c_vec1("unreachable"));
}

/// G8.7: Lint a source file. Returns warnings as a vector of strings.
/// Returns Err with errors if compilation fails.
pub fn lint_source(source: str, source_path: str, perf: bool) -> ResultVecStr {
    // G8.7: Lint a source file. Returns warnings as a vector of strings.
    // We do a minimal parse + typecheck + lint, without monomorphization.
    // `perf` adds the CP9 quadratic-pattern warnings (`fid lint --perf`).
    g_lint_warnings = Vec::new();

    // Parse user code
    var user_result: ParseResultProgram = parse_source(source);
    match user_result {
        ParseResultProgram::Err(e) => {
            return ResultVecStr::Err(c_vec1(e));
        }
        ParseResultProgram::Ok(user) => {
            // CB1: this parse filled the parser's import set too
            imp_note_imports(user);
            // N5 (release-roadmap): a file with `use` imports is checked
            // by the real build, which resolves them (lint_with_imports)
            if lint_has_imports(user) {
                return lint_with_imports(source, source_path, perf, user);
            }
            // Load stdlib
            var stdlib_opt: OptProgram = get_cached_stdlib();
            match stdlib_opt {
                OptProgram::None => {
                    return ResultVecStr::Err(c_vec1("Stdlib not found: stdlib/core.fd (CWD must be project root)"));
                }
                OptProgram::Some(stdlib) => {
                    var user_module: str = "main";
                    match user.module {
                        OptStr::Some(m) => {
                            user_module = m;
                        }
                        OptStr::None => {
                        }
                    }
                    var stdlib_module: str = "core";
                    match stdlib.module {
                        OptStr::Some(m2) => {
                            stdlib_module = m2;
                        }
                        OptStr::None => {
                        }
                    }

                    // Build a merged program (simplified — no import resolution)
                    var program: Program = stdlib;
                    program = merge_programs(program, user);
                    // L8E: variadic calls packed, as the build does
                    // (mono_resolve_turbofish), or each reads as too many args
                    program = mono_desugar_variadics(program);

                    var tc: TypeChecker = TypeChecker::new();
                    TypeChecker_register_program(&mut tc, stdlib, stdlib_module);
                    tc_note_program_file(source_path, stdlib_dir());
                    TypeChecker_register_program(&mut tc, user, user_module);
                    TypeChecker_register_trait_impls(&mut tc, program);
                    TypeChecker_register_generated_decls(&mut tc, program);
                    TypeChecker_verify_trait_impls(&mut tc, program);
                    TypeChecker_collect_capabilities(&mut tc, user);
                    TypeChecker_check_bodies(&mut tc, program);

                    if tc.errors.len() > 0 {
                        var file: str = source_path;
                        return ResultVecStr::Err(enrich_errors(tc.errors, source, file));
                    }
                    var escape_errors: Vec<str> = escape_check(program);
                    if escape_errors.len() > 0 {
                        return ResultVecStr::Err(enrich_errors(escape_errors, source, source_path));
                    }
                    var secret_errors: Vec<str> = secrecy_check(program);
                    if secret_errors.len() > 0 {
                        return ResultVecStr::Err(enrich_errors(secret_errors, source, source_path));
                    }

                    // Run lints
                    tc.run_lints(program);
                    lint_unwraps(&mut tc, user, source, source_path);
                    // L7E: unused variables, naming, import order
                    var sw: Vec<str> = lint_source_scan(source);
                    var swi: i64 = 0;
                    while swi < sw.len() {
                        tc.warnings.push(sw.get(swi));
                        swi = swi + 1;
                    }
                    if perf {
                        var pw: Vec<str> = lint_perf(user);
                        var pi: i64 = 0;
                        while pi < pw.len() {
                            tc.warnings.push(pw.get(pi));
                            pi = pi + 1;
                        }
                    }
                    return ResultVecStr::Ok(tc.warnings);
                }
            }
        }
    }
    return ResultVecStr::Err(c_vec1("unreachable"));
}

/// N5: does `user` import a module other than core?
fn lint_has_imports(user: Program) -> bool {
    var i: i64 = 0;
    while i < user.imports.len() {
        if user.imports.get(i).path != "core" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// N5: the name a warning quotes after `marker` (up to the next quote), or "".
fn lint_quoted_after(w: str, marker: str) -> str {
    var at: i64 = str_find(w, marker);
    if at < 0 {
        return "";
    }
    var rest: str = str_slice(w, at + str_len(marker), str_len(w));
    var end: i64 = str_find(rest, "'");
    if end <= 0 {
        return "";
    }
    return str_slice(rest, 0, end);
}

/// N5: is the checker warning `w` (of the whole program: core, the imported
/// modules and the file) about the linted file? An unused function or a
/// warning `in 'f'` names one of its functions; an unused import, one of
/// its `use` lines.
fn lint_warning_is_users(w: str, fnames: i64, user: Program) -> bool {
    var uf: str = lint_quoted_after(w, "unused function '");
    if str_len(uf) > 0 {
        return HashMap_get(fnames, uf) != 0;
    }
    var ui: str = lint_quoted_after(w, "unused import: '");
    if str_len(ui) > 0 {
        var i: i64 = 0;
        while i < user.imports.len() {
            if user.imports.get(i).path == ui {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    var inf: str = lint_quoted_after(w, ", in '");
    if str_len(inf) > 0 {
        return HashMap_get(fnames, inf) != 0;
    }
    return true;
}

/// N5 (release-roadmap): lint a file that imports other modules. lint_source
/// merges only core with the file, so the imported modules' names were
/// errors and the file could not be linted ("unchecked" in
/// scripts/lint-check.sh). Here the build checks it as `fid check` does
/// (imports resolved from disk, borrow check off as in lint_source), and
/// the checker's warnings it stashed (g_lint_warnings) are kept when they
/// concern this file; then the source lints (unwrap, unused variables,
/// naming, import order, --perf) run as for any file.
fn lint_with_imports(source: str, source_path: str, perf: bool, user: Program) -> ResultVecStr {
    g_lint_warnings = Vec::new();
    var warnings: Vec<str> = Vec::new();
    match build_program_with_path_borrowck(source, OptStr::Some(source_path), "off") {
        ResultProgram::Err(errs) => {
            return ResultVecStr::Err(errs);
        }
        ResultProgram::Ok(_) => {
        }
    }
    var fnames: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < user.funcs.len() {
        HashMap_insert(fnames, user.funcs.get(fi).name, 1);
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < user.impls.len() {
        var imp: ImplDef = user.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            HashMap_insert(fnames, imp.methods.get(mi).name, 1);
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var stashed: Vec<str> = g_lint_warnings;
    var wi: i64 = 0;
    while wi < stashed.len() {
        var w: str = stashed.get(wi);
        if lint_warning_is_users(w, fnames, user) && !str_vec_contains(warnings, w) {
            warnings.push(w);
        }
        wi = wi + 1;
    }
    var tc: TypeChecker = TypeChecker::new();
    lint_unwraps(&mut tc, user, source, source_path);
    var ti: i64 = 0;
    while ti < tc.warnings.len() {
        warnings.push(tc.warnings.get(ti));
        ti = ti + 1;
    }
    var sw: Vec<str> = lint_source_scan(source);
    var swi: i64 = 0;
    while swi < sw.len() {
        warnings.push(sw.get(swi));
        swi = swi + 1;
    }
    if perf {
        var pw: Vec<str> = lint_perf(user);
        var pi: i64 = 0;
        while pi < pw.len() {
            warnings.push(pw.get(pi));
            pi = pi + 1;
        }
    }
    return ResultVecStr::Ok(warnings);
}

/// L7G: `:type <expr>` in `fid repl` — the type the checker gives the
/// expression `expr_src`, written alone in a function body (no locals), as
/// `type_to_str` spells it ("i64", "str", "Vec<i64>"); or the errors that
/// checking it gives. Nothing is run.
pub fn repl_expr_type(expr_src: str) -> ResultStr {
    return repl_expr_type_in("", expr_src);
}

/// L7G: repl_expr_type with the REPL session's definitions `defs` (source
/// text after the expression's function, which stays the program's first),
/// so that `:type` sees the functions and types defined so far.
pub fn repl_expr_type_in(defs: str, expr_src: str) -> ResultStr {
    var source: str = "fn __repl_type() -> i64 {\n    (" + expr_src + ");\n    return 0;\n}\n" + defs;
    match parse_source(source) {
        ParseResultProgram::Err(e) => {
            return ResultStr::Err(c_vec1(e));
        }
        ParseResultProgram::Ok(user) => {
            // CB1: this parse filled the parser's import set too
            imp_note_imports(user);
            match get_cached_stdlib() {
                OptProgram::None => {
                    return ResultStr::Err(c_vec1("Stdlib not found: stdlib/core.fd (CWD must be project root)"));
                }
                OptProgram::Some(stdlib) => {
                    var stdlib_module: str = "core";
                    match stdlib.module {
                        OptStr::Some(m2) => {
                            stdlib_module = m2;
                        }
                        OptStr::None => {
                        }
                    }
                    var program: Program = stdlib;
                    program = merge_programs(program, user);
                    var tc: TypeChecker = TypeChecker::new();
                    TypeChecker_register_program(&mut tc, stdlib, stdlib_module);
                    TypeChecker_register_program(&mut tc, user, "main");
                    TypeChecker_register_trait_impls(&mut tc, program);
                    TypeChecker_register_generated_decls(&mut tc, program);
                    TypeChecker_verify_trait_impls(&mut tc, program);
                    TypeChecker_collect_capabilities(&mut tc, user);
                    TypeChecker_check_bodies(&mut tc, program);
                    if tc.errors.len() > 0 {
                        return ResultStr::Err(enrich_errors(tc.errors, source, "<repl>"));
                    }
                    if user.funcs.len() == 0 {
                        return ResultStr::Err(c_vec1("not an expression: " + expr_src));
                    }
                    var f: Func = user.funcs.get(0);
                    if f.body.len() == 0 {
                        return ResultStr::Err(c_vec1("not an expression: " + expr_src));
                    }
                    match f.body.get(0) {
                        Stmt::Expr(e, _) => {
                            // the body checked clean: check the expression
                            // once more in a fresh scope, for its type
                            TypeChecker_push_scope(&mut tc);
                            var ty: Type = TypeChecker_check_expr(&mut tc, e);
                            TypeChecker_pop_scope(&mut tc);
                            // an integer made of literals is an i64, as
                            // in a `val` without a type (typechecker.fd
                            // Stmt::Let), not the smallest type holding
                            // it: `:type 1 + 2` is i64, not i8
                            if repl_const_int_expr(e) && repl_narrow_int(ty) {
                                ty = Type::I64;
                            }
                            return ResultStr::Ok(type_to_str(ty));
                        }
                        _ => {
                        }
                    }
                    return ResultStr::Err(c_vec1("not an expression: " + expr_src));
                }
            }
        }
    }
    return ResultStr::Err(c_vec1("unreachable"));
}

/// L7G `:type`: whether `e` is made of integer literals only, joined by
/// unary and binary operators (typechecker.fd tc_is_constant_expr, which
/// is private): the expressions a `val` without a type widens to i64.
fn repl_const_int_expr(e: Expr) -> bool {
    match e {
        Expr::IntLit(_) => {
            return true;
        }
        Expr::Unary(_, inner) => {
            return repl_const_int_expr(box_expr_unbox(inner));
        }
        Expr::Binary(_, l, r) => {
            return repl_const_int_expr(box_expr_unbox(l)) && repl_const_int_expr(box_expr_unbox(r));
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// L7G `:type`: a signed integer type narrower than i64 (the types
/// typechecker.fd infer_int_type gives a literal by its value).
fn repl_narrow_int(t: Type) -> bool {
    match t {
        Type::I8 => {
            return true;
        }
        Type::I16 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

// --- L7G: the REPL's AST printer (`:ast`) ------------------------------------
// One node per line, two spaces per level: the node's kind and its names or
// literal, then its children (flat_ast.fd's layout; that module is not
// imported: its private int_to_hex would hide string's).

fn rast_ind(depth: i64) -> str {
    var s: str = "";
    var i: i64 = 0;
    while i < depth {
        s = s + "  ";
        i = i + 1;
    }
    return s;
}

fn rast_quote(s: str) -> str {
    var out: str = "\"";
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c == 10 {
            out = out + "\\n";
        } else if c == 9 {
            out = out + "\\t";
        } else if c == 34 {
            out = out + "\\\"";
        } else if c == 92 {
            out = out + "\\\\";
        } else {
            out = out + str_slice(s, i, i + 1);
        }
        i = i + 1;
    }
    return out + "\"";
}

fn rast_binop(op: BinOp) -> str {
    match op {
        BinOp::Add => {
            return "+";
        }
        BinOp::Sub => {
            return "-";
        }
        BinOp::Mul => {
            return "*";
        }
        BinOp::Div => {
            return "/";
        }
        BinOp::Mod => {
            return "%";
        }
        BinOp::Eq => {
            return "==";
        }
        BinOp::Neq => {
            return "!=";
        }
        BinOp::Lt => {
            return "<";
        }
        BinOp::Gt => {
            return ">";
        }
        BinOp::LtEq => {
            return "<=";
        }
        BinOp::GtEq => {
            return ">=";
        }
        BinOp::And => {
            return "&&";
        }
        BinOp::Or => {
            return "||";
        }
        BinOp::BitAnd => {
            return "&";
        }
        BinOp::BitOr => {
            return "|";
        }
        BinOp::BitXor => {
            return "^";
        }
        BinOp::Shl => {
            return "<<";
        }
        BinOp::Shr => {
            return ">>";
        }
    }
    return "?";
}

fn rast_unop(op: UnaryOp) -> str {
    match op {
        UnaryOp::Neg => {
            return "-";
        }
        UnaryOp::Not => {
            return "!";
        }
        UnaryOp::BitNot => {
            return "~";
        }
    }
    return "?";
}

fn rast_assignop(op: AssignOp) -> str {
    match op {
        AssignOp::Assign => {
            return "=";
        }
        AssignOp::AddAssign => {
            return "+=";
        }
        AssignOp::SubAssign => {
            return "-=";
        }
        AssignOp::MulAssign => {
            return "*=";
        }
        AssignOp::DivAssign => {
            return "/=";
        }
        AssignOp::ModAssign => {
            return "%=";
        }
        AssignOp::BitAndAssign => {
            return "&=";
        }
        AssignOp::BitOrAssign => {
            return "|=";
        }
        AssignOp::BitXorAssign => {
            return "^=";
        }
        AssignOp::ShlAssign => {
            return "<<=";
        }
        AssignOp::ShrAssign => {
            return ">>=";
        }
    }
    return "?";
}

fn rast_pattern(p: Pattern) -> str {
    match p {
        Pattern::Wildcard => {
            return "_";
        }
        Pattern::IntLit(n) => {
            return int_to_str(n);
        }
        Pattern::BoolLit(b) => {
            if b {
                return "true";
            }
            return "false";
        }
        Pattern::Ident(s) => {
            return s;
        }
        Pattern::EnumVariant(en, v, binds) => {
            var s: str = en + "::" + v;
            if binds.len() > 0 {
                s = s + "(";
                var i: i64 = 0;
                while i < binds.len() {
                    if i > 0 {
                        s = s + ", ";
                    }
                    s = s + binds.get(i).name;
                    i = i + 1;
                }
                s = s + ")";
            }
            return s;
        }
        Pattern::StrLit(s) => {
            return rast_quote(s);
        }
        Pattern::Range(a, b) => {
            return rast_pattern(box_pattern_unbox(a)) + "..=" + rast_pattern(box_pattern_unbox(b));
        }
    }
    return "?";
}

fn rast_exprs(es: Vec<Expr>, depth: i64, out: &mut Vec<str>) {
    var i: i64 = 0;
    while i < es.len() {
        rast_expr(es.get(i), depth, out);
        i = i + 1;
    }
}

fn rast_stmts(ss: Vec<Stmt>, depth: i64, out: &mut Vec<str>) {
    var i: i64 = 0;
    while i < ss.len() {
        rast_stmt(ss.get(i), depth, out);
        i = i + 1;
    }
}

/// A child list under a label line ("Then", "Body"), one level deeper.
fn rast_block(label: str, ss: Vec<Stmt>, depth: i64, out: &mut Vec<str>) {
    out.push(rast_ind(depth) + label);
    rast_stmts(ss, depth + 1, out);
}

fn rast_arms(arms: Vec<MatchArm>, depth: i64, out: &mut Vec<str>) {
    var i: i64 = 0;
    while i < arms.len() {
        var arm: MatchArm = arms.get(i);
        out.push(rast_ind(depth) + "Arm " + rast_pattern(arm.pattern));
        match arm.guard {
            OptBoxExpr::Some(g) => {
                out.push(rast_ind(depth + 1) + "Guard");
                rast_expr(box_expr_unbox(g), depth + 2, out);
            }
            OptBoxExpr::None => {
            }
        }
        rast_stmts(arm.body, depth + 1, out);
        i = i + 1;
    }
}

fn rast_opt_expr(e: OptBoxExpr, depth: i64, out: &mut Vec<str>) {
    match e {
        OptBoxExpr::Some(x) => {
            rast_expr(box_expr_unbox(x), depth, out);
        }
        OptBoxExpr::None => {
        }
    }
}

fn rast_if(cond: Expr, then_b: Vec<Stmt>, else_b: OptStmts, depth: i64, out: &mut Vec<str>) {
    out.push(rast_ind(depth) + "If");
    rast_expr(cond, depth + 1, out);
    rast_block("Then", then_b, depth + 1, out);
    match else_b {
        OptStmts::Some(ss) => {
            rast_block("Else", ss, depth + 1, out);
        }
        OptStmts::None => {
        }
    }
}

fn rast_expr(e: Expr, depth: i64, out: &mut Vec<str>) {
    var ind: str = rast_ind(depth);
    match e {
        Expr::IntLit(n) => {
            out.push(ind + "Int " + int_to_str(n));
        }
        Expr::FloatLit(f) => {
            out.push(ind + "Float " + float_to_str(f));
        }
        Expr::StringLit(s) => {
            out.push(ind + "Str " + rast_quote(s));
        }
        Expr::BoolLit(b) => {
            if b {
                out.push(ind + "Bool true");
            } else {
                out.push(ind + "Bool false");
            }
        }
        Expr::Ident(s) => {
            out.push(ind + "Ident " + s);
        }
        Expr::Binary(op, l, r) => {
            out.push(ind + "Binary " + rast_binop(op));
            rast_expr(box_expr_unbox(l), depth + 1, out);
            rast_expr(box_expr_unbox(r), depth + 1, out);
        }
        Expr::Unary(op, x) => {
            out.push(ind + "Unary " + rast_unop(op));
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
        Expr::Call(callee, args) => {
            out.push(ind + "Call " + callee);
            rast_exprs(args, depth + 1, out);
        }
        Expr::FieldAccess(x, field) => {
            out.push(ind + "Field " + field);
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
        Expr::OptionalFieldAccess(x, field) => {
            out.push(ind + "OptionalField " + field);
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
        Expr::StructLit(name, fields, spread) => {
            out.push(ind + "StructLit " + name);
            var i: i64 = 0;
            while i < fields.len() {
                var fi: FieldInit = fields.get(i);
                out.push(rast_ind(depth + 1) + "FieldInit " + fi.name);
                rast_expr(fi.value, depth + 2, out);
                i = i + 1;
            }
            match spread {
                OptBoxExpr::Some(sp) => {
                    out.push(rast_ind(depth + 1) + "Spread");
                    rast_expr(box_expr_unbox(sp), depth + 2, out);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::If(cond, then_b, else_b) => {
            rast_if(box_expr_unbox(cond), then_b, else_b, depth, out);
        }
        Expr::Range(a, b, inclusive) => {
            if inclusive {
                out.push(ind + "Range inclusive");
            } else {
                out.push(ind + "Range");
            }
            rast_expr(box_expr_unbox(a), depth + 1, out);
            rast_expr(box_expr_unbox(b), depth + 1, out);
        }
        Expr::Block(ss) => {
            out.push(ind + "Block");
            rast_stmts(ss, depth + 1, out);
        }
        Expr::MethodCall(recv, method, args) => {
            out.push(ind + "MethodCall " + method);
            rast_expr(box_expr_unbox(recv), depth + 1, out);
            rast_exprs(args, depth + 1, out);
        }
        Expr::ArrayLit(_, elems) => {
            out.push(ind + "Array");
            rast_exprs(elems, depth + 1, out);
        }
        Expr::Index(a, i) => {
            out.push(ind + "Index");
            rast_expr(box_expr_unbox(a), depth + 1, out);
            rast_expr(box_expr_unbox(i), depth + 1, out);
        }
        Expr::FString(parts) => {
            out.push(ind + "FString");
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Literal(s) => {
                        out.push(rast_ind(depth + 1) + "Text " + rast_quote(s));
                    }
                    FStringPart::Expr(x) => {
                        rast_expr(x, depth + 1, out);
                    }
                }
                i = i + 1;
            }
        }
        Expr::Match(x, arms) => {
            out.push(ind + "Match");
            rast_expr(box_expr_unbox(x), depth + 1, out);
            rast_arms(arms, depth + 1, out);
        }
        Expr::EnumLit(en, v, args) => {
            out.push(ind + "EnumLit " + en + "::" + v);
            rast_exprs(args, depth + 1, out);
        }
        Expr::Ref(x, is_mut) => {
            if is_mut {
                out.push(ind + "Ref mut");
            } else {
                out.push(ind + "Ref");
            }
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
        Expr::Deref(x) => {
            out.push(ind + "Deref");
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
        Expr::StrConcat(a, b) => {
            out.push(ind + "StrConcat");
            rast_expr(box_expr_unbox(a), depth + 1, out);
            rast_expr(box_expr_unbox(b), depth + 1, out);
        }
        Expr::Try(x) => {
            out.push(ind + "Try");
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
        Expr::Coalesce(a, b) => {
            out.push(ind + "Coalesce");
            rast_expr(box_expr_unbox(a), depth + 1, out);
            rast_expr(box_expr_unbox(b), depth + 1, out);
        }
        Expr::IsCheck(x, name) => {
            out.push(ind + "Is " + name);
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
        Expr::TryBlock(ss) => {
            out.push(ind + "TryBlock");
            rast_stmts(ss, depth + 1, out);
        }
        Expr::TupleLit(es) => {
            out.push(ind + "Tuple");
            rast_exprs(es, depth + 1, out);
        }
        Expr::Closure(params, body, ret) => {
            var sig: str = "(";
            var i: i64 = 0;
            while i < params.len() {
                if i > 0 {
                    sig = sig + ", ";
                }
                var pm: Param = params.get(i);
                sig = sig + pm.name + ": " + type_to_str(pm.ty);
                i = i + 1;
            }
            sig = sig + ")";
            match ret {
                OptType::Some(t) => {
                    sig = sig + " -> " + type_to_str(t);
                }
                OptType::None => {
                }
            }
            out.push(ind + "Closure " + sig);
            rast_stmts(body, depth + 1, out);
        }
        Expr::Cast(x, ty) => {
            out.push(ind + "Cast " + type_to_str(ty));
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
        Expr::Asm(text, _) => {
            out.push(ind + "Asm " + rast_quote(text));
        }
        Expr::Comptime(x) => {
            out.push(ind + "Comptime");
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
        Expr::ComptimeBlock(ss) => {
            out.push(ind + "ComptimeBlock");
            rast_stmts(ss, depth + 1, out);
        }
        Expr::ComptimeReflect(_, ty) => {
            out.push(ind + "ComptimeReflect " + type_to_str(ty));
        }
        Expr::PipeForward(a, b) => {
            out.push(ind + "Pipe");
            rast_expr(box_expr_unbox(a), depth + 1, out);
            rast_expr(box_expr_unbox(b), depth + 1, out);
        }
        Expr::QuantCast(x, ty) => {
            out.push(ind + "QuantCast " + type_to_str(ty));
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
        Expr::Await(x) => {
            out.push(ind + "Await");
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
        Expr::Spawn(x) => {
            out.push(ind + "Spawn");
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
        Expr::Yield(x) => {
            out.push(ind + "Yield");
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
        Expr::NamedArg(name, x) => {
            out.push(ind + "NamedArg " + name);
            rast_expr(box_expr_unbox(x), depth + 1, out);
        }
    }
}

fn rast_stmt(s: Stmt, depth: i64, out: &mut Vec<str>) {
    var ind: str = rast_ind(depth);
    match s {
        Stmt::Let(name, oty, init, is_mut, _, _, _) => {
            var head: str = "Let ";
            if is_mut {
                head = "Var ";
            }
            head = head + name;
            match oty {
                OptType::Some(t) => {
                    head = head + ": " + type_to_str(t);
                }
                OptType::None => {
                }
            }
            out.push(ind + head);
            rast_expr(init, depth + 1, out);
        }
        Stmt::LetTuple(names, init, _) => {
            out.push(ind + "LetTuple (" + str_join(names, ", ") + ")");
            rast_expr(init, depth + 1, out);
        }
        Stmt::LetUninit(name, ty, _, _) => {
            out.push(ind + "LetUninit " + name + ": " + type_to_str(ty));
        }
        Stmt::Assign(name, op, value, _) => {
            out.push(ind + "Assign " + name + " " + rast_assignop(op));
            rast_expr(value, depth + 1, out);
        }
        Stmt::IndexAssign(name, idx, op, value, _) => {
            out.push(ind + "IndexAssign " + name + " " + rast_assignop(op));
            rast_expr(idx, depth + 1, out);
            rast_expr(value, depth + 1, out);
        }
        Stmt::DerefAssign(target, op, value, _) => {
            out.push(ind + "DerefAssign " + rast_assignop(op));
            rast_expr(target, depth + 1, out);
            rast_expr(value, depth + 1, out);
        }
        Stmt::FieldAssign(obj, field, op, value, _) => {
            out.push(ind + "FieldAssign " + field + " " + rast_assignop(op));
            rast_expr(obj, depth + 1, out);
            rast_expr(value, depth + 1, out);
        }
        Stmt::Expr(x, _) => {
            out.push(ind + "ExprStmt");
            rast_expr(x, depth + 1, out);
        }
        Stmt::Return(x, _) => {
            out.push(ind + "Return");
            rast_opt_expr(x, depth + 1, out);
        }
        Stmt::If(cond, then_b, else_b, _) => {
            rast_if(cond, then_b, else_b, depth, out);
        }
        Stmt::While(cond, body, _) => {
            out.push(ind + "While");
            rast_expr(cond, depth + 1, out);
            rast_block("Body", body, depth + 1, out);
        }
        Stmt::For(name, iter, body, _) => {
            out.push(ind + "For " + name);
            rast_expr(iter, depth + 1, out);
            rast_block("Body", body, depth + 1, out);
        }
        Stmt::Loop(body, _) => {
            rast_block("Loop", body, depth, out);
        }
        Stmt::Break(x, _) => {
            out.push(ind + "Break");
            rast_opt_expr(x, depth + 1, out);
        }
        Stmt::Continue(_) => {
            out.push(ind + "Continue");
        }
        Stmt::Defer(body, _) => {
            rast_block("Defer", body, depth, out);
        }
        Stmt::Match(x, arms, _) => {
            out.push(ind + "Match");
            rast_expr(x, depth + 1, out);
            rast_arms(arms, depth + 1, out);
        }
        Stmt::Use(path, names, _) => {
            out.push(ind + "Use " + path);
        }
        Stmt::Handle(body, handlers, _) => {
            rast_block("Handle (" + int_to_str(handlers.len()) + " handlers)", body, depth, out);
        }
        Stmt::Do(effect, op, args, _) => {
            out.push(ind + "Do " + effect + "." + op);
            rast_exprs(args, depth + 1, out);
        }
        Stmt::RegionBlock(name, _, _, _, _, body, _) => {
            rast_block("Region " + name, body, depth, out);
        }
        Stmt::Sandbox(body, _) => {
            rast_block("Sandbox", body, depth, out);
        }
        Stmt::Unsafe(body, _) => {
            rast_block("Unsafe", body, depth, out);
        }
        Stmt::Txn(body, _) => {
            rast_block("Txn", body, depth, out);
        }
        Stmt::ComptimeGen(body, _) => {
            rast_block("ComptimeGen", body, depth, out);
        }
        Stmt::GradBlock(name, body, _) => {
            rast_block("Grad " + name, body, depth, out);
        }
        Stmt::Backward(x, _) => {
            out.push(ind + "Backward");
            rast_expr(x, depth + 1, out);
        }
        Stmt::Query(names, body, _) => {
            rast_block("Query (" + str_join(names, ", ") + ")", body, depth, out);
        }
        Stmt::Select(cases, _, _) => {
            out.push(ind + "Select (" + int_to_str(cases.len()) + " cases)");
        }
        Stmt::Parallel(branches, _) => {
            out.push(ind + "Parallel");
            var i: i64 = 0;
            while i < branches.len() {
                rast_block("Branch", branches.get(i), depth + 1, out);
                i = i + 1;
            }
        }
        Stmt::Resume(k, v, _) => {
            out.push(ind + "Resume");
            rast_expr(k, depth + 1, out);
            rast_expr(v, depth + 1, out);
        }
        Stmt::SpawnScope(body, _) => {
            rast_block("SpawnScope", body, depth, out);
        }
        Stmt::CancelScope(_) => {
            out.push(ind + "CancelScope");
        }
    }
}

// --- L7G: the REPL session and its inspection commands ----------------------
// `fid repl` (main.fd cmd_repl) keeps the definitions typed so far (`defs`,
// source text) and builds each command's program from them: `main` holds
// what the command needs (println(<expr>) to run or to show its IR).

/// L7G: whether a REPL line defines something the session keeps (a
/// function, a type, an import, a constant) rather than being an
/// expression to run.
pub fn repl_is_definition(line: str) -> bool {
    var t: str = str_trim(line);
    if str_starts_with(t, "@") {
        return true;
    }
    var heads: Vec<str> = Vec::new();
    heads.push("fn ");
    heads.push("pub ");
    heads.push("async fn ");
    heads.push("struct ");
    heads.push("enum ");
    heads.push("impl ");
    heads.push("trait ");
    heads.push("const ");
    heads.push("type ");
    heads.push("use ");
    heads.push("extern ");
    var i: i64 = 0;
    while i < heads.len() {
        if str_starts_with(t, heads.get(i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// L7G: the program of a REPL command: the session's definitions and a
/// `main` holding `body`.
pub fn repl_program(defs: str, body: str) -> str {
    return defs + "fn main() -> i64 {\n" + body + "    return 0;\n}\n";
}

/// L7G: the `main` body that prints expression `expr` (what the REPL runs
/// for an expression line); "" for no expression.
pub fn repl_print_body(expr: str) -> str {
    if str_len(expr) == 0 {
        return "";
    }
    return "    println(" + expr + ");\n";
}

/// L7G: definition `def_src` added to the session's `defs`: the new
/// definitions when the program still checks, or its errors (the session
/// keeps the old ones).
pub fn repl_add_definition(defs: str, def_src: str) -> ResultStr {
    var next: str = defs + def_src + "\n";
    inc_deps_reset();
    match build_program_with_path_borrowck(repl_program(next, ""), OptStr::Some("<repl>"), "on") {
        ResultProgram::Ok(_) => {
            return ResultStr::Ok(next);
        }
        ResultProgram::Err(errs) => {
            return ResultStr::Err(errs);
        }
    }
    return ResultStr::Err(c_vec1("unreachable"));
}

/// L7G: the names of the functions the session defined (not the stdlib's).
pub fn repl_user_fns(defs: str) -> Vec<str> {
    var names: Vec<str> = Vec::new();
    match parse_program_only(repl_program(defs, "")) {
        OptProgram::Some(p) => {
            var i: i64 = 0;
            while i < p.funcs.len() {
                names.push(p.funcs.get(i).name);
                i = i + 1;
            }
        }
        OptProgram::None => {
        }
    }
    return names;
}

/// L7G: the session lowered to IR, its `main` printing `expr` ("" for an
/// empty `main`), as the REPL would run it.
pub fn repl_lower(defs: str, expr: str) -> ResultIrModule {
    inc_deps_reset();
    return lower_to_ir_module_with_path(repl_program(defs, repl_print_body(expr)), "<repl>", "on");
}

fn repl_no_fn(name: str) -> ResultStr {
    return ResultStr::Err(c_vec1("no function '" + name + "' in this session (define one with `fn " + name + "(...) { ... }`)"));
}

/// L7G: `:ir` — function `name` of the lowered session as IR text.
pub fn repl_fn_ir(module: IrModule, name: str) -> ResultStr {
    var text: str = IrModule_function_detail_str(&module, name);
    if str_len(text) == 0 {
        return repl_no_fn(name);
    }
    return ResultStr::Ok(text);
}

/// L7G: an IR effect as the language spells it (`IO`, `Alloc`).
fn repl_effect_name(e: Effect) -> str {
    match e {
        Effect::Alloc => {
            return "Alloc";
        }
        Effect::IO => {
            return "IO";
        }
        Effect::Net => {
            return "Net";
        }
        Effect::Spawn => {
            return "Spawn";
        }
        Effect::Diverge => {
            return "Diverge";
        }
        Effect::Read => {
            return "Read";
        }
        Effect::Write => {
            return "Write";
        }
        Effect::Diff => {
            return "Diff";
        }
        Effect::Noise => {
            return "Noise";
        }
        Effect::Comm => {
            return "Comm";
        }
    }
    return "?";
}

/// L7G: `:effects` — the effects of function `name` in the lowered session
/// (its own and those of the functions it calls), "pure" when it has none.
pub fn repl_fn_effects(module: IrModule, name: str) -> ResultStr {
    match IrModule_get_function(&module, name) {
        OptIrFunction::Some(f) => {
            if f.effects.effects.len() == 0 {
                return ResultStr::Ok("pure");
            }
            var names: Vec<str> = Vec::new();
            var i: i64 = 0;
            while i < f.effects.effects.len() {
                var en: str = repl_effect_name(f.effects.effects.get(i));
                if !cc_c_str_vec_contains(names, en) {
                    names.push(en);
                }
                i = i + 1;
            }
            return ResultStr::Ok(str_join(names, ", "));
        }
        OptIrFunction::None => {
        }
    }
    return repl_no_fn(name);
}

/// L7G `:effects`: whether the checked `program` has a method `method` in
/// an impl of type `owner`.
fn repl_has_method(program: Program, owner: str, method: str) -> bool {
    var i: i64 = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        if imp.struct_name == owner {
            var k: i64 = 0;
            while k < imp.methods.len() {
                if imp.methods.get(k).name == method {
                    return true;
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    return false;
}

/// L7G: `:effects <fn>` — the effects the type checker infers for function
/// `name` of the session `defs` (or of the stdlib) in the language's terms
/// (reference §9.1: IO, Net, Spawn, Diverge, Alloc, ...), with those of the
/// functions it calls; "pure" when it has none. Unlike the IR's set
/// (repl_fn_effects), a stack local is no Alloc/Read/Write effect, so a
/// pure loop is pure. A method is named `Type.method` or `Type::method`.
pub fn repl_lang_effects(defs: str, name: str) -> ResultStr {
    var source: str = repl_program(defs, "");
    match parse_source(source) {
        ParseResultProgram::Err(e) => {
            return ResultStr::Err(c_vec1(e));
        }
        ParseResultProgram::Ok(user) => {
            imp_note_imports(user);
            match get_cached_stdlib() {
                OptProgram::None => {
                    return ResultStr::Err(c_vec1("Stdlib not found: stdlib/core.fd (CWD must be project root)"));
                }
                OptProgram::Some(stdlib) => {
                    var stdlib_module: str = "core";
                    match stdlib.module {
                        OptStr::Some(m2) => {
                            stdlib_module = m2;
                        }
                        OptStr::None => {
                        }
                    }
                    var program: Program = stdlib;
                    program = merge_programs(program, user);
                    var tc: TypeChecker = TypeChecker::new();
                    TypeChecker_register_program(&mut tc, stdlib, stdlib_module);
                    TypeChecker_register_program(&mut tc, user, "main");
                    TypeChecker_register_trait_impls(&mut tc, program);
                    TypeChecker_register_generated_decls(&mut tc, program);
                    TypeChecker_verify_trait_impls(&mut tc, program);
                    TypeChecker_collect_capabilities(&mut tc, user);
                    TypeChecker_check_bodies(&mut tc, program);
                    if tc.errors.len() > 0 {
                        return ResultStr::Err(enrich_errors(tc.errors, source, "<repl>"));
                    }
                    // a method: `Type::m` is looked up as `Type.m`, the
                    // name the checker keeps a method's own effects under
                    var key: str = str_replace(name, "::", ".");
                    var known: bool = false;
                    var dot: i64 = str_find(key, ".");
                    if dot > 0 {
                        known = repl_has_method(program, str_slice(key, 0, dot), str_slice(key, dot + 1, str_len(key)));
                    } else {
                        known = TypeChecker_knows_fn(&tc, key);
                    }
                    if !known || key == "main" {
                        return repl_no_fn(name);
                    }
                    var effs: Vec<str> = TypeChecker_effects_of(&tc, key);
                    if effs.len() == 0 {
                        return ResultStr::Ok("pure");
                    }
                    var names: Vec<str> = Vec::new();
                    var i: i64 = 0;
                    while i < effs.len() {
                        if !cc_c_str_vec_contains(names, effs.get(i)) {
                            names.push(effs.get(i));
                        }
                        i = i + 1;
                    }
                    return ResultStr::Ok(str_join(names, ", "));
                }
            }
        }
    }
    return ResultStr::Err(c_vec1("unreachable"));
}

/// L7G: the capability a call of `callee` needs by itself: the builtins
/// the type checker checks (TypeChecker_check_capability: print -> IO,
/// read_file -> FS, http_get -> Net, spawn -> Spawn, p_malloc -> Alloc)
/// and the runtime's file, socket and process calls; "" for none.
fn repl_call_cap(callee: str) -> str {
    if callee == "print" || callee == "println" || callee == "print_int" || callee == "print_float" || callee == "print_str" || callee == "eprint" || callee == "eprintln" || str_starts_with(callee, "p_print") || str_starts_with(callee, "p_eprint") {
        return "IO";
    }
    if callee == "read_file" || callee == "write_file" || callee == "file_open" || callee == "file_read" || callee == "file_write" || callee == "p_dl_open" || str_starts_with(callee, "p_file_") || str_starts_with(callee, "p_dir_") {
        return "FS";
    }
    if callee == "http_get" || callee == "http_post" || callee == "socket_connect" || callee == "socket_send" || callee == "socket_recv" || str_starts_with(callee, "p_socket") || str_starts_with(callee, "p_net_") || str_starts_with(callee, "p_tcp_") || str_starts_with(callee, "p_udp_") {
        return "Net";
    }
    if callee == "spawn" || callee == "exec" || callee == "system" || callee == "p_thread_spawn" || callee == "p_system" || str_starts_with(callee, "p_process_") {
        return "Spawn";
    }
    if callee == "p_malloc" || callee == "p_free" || callee == "p_malloc_persistent" || callee == "p_arena_save" || callee == "p_arena_restore" {
        return "Alloc";
    }
    return "";
}

fn repl_cap_add(caps: &mut Vec<str>, c: str) {
    if str_len(c) > 0 && !cc_c_str_vec_contains(caps, c) {
        caps.push(c);
    }
}

/// L7G: `:caps` — the capabilities function `name` needs: what its calls
/// need (repl_call_cap), followed through the session's own functions
/// `user` (the stdlib's are not entered: the type checker does not check
/// capabilities inside core either), and what its effects need (Net, Spawn;
/// IO when no call named the IO or FS one). "none" when it needs nothing.
pub fn repl_fn_caps(module: IrModule, name: str, user: Vec<str>) -> ResultStr {
    var start_effects: Vec<Effect> = Vec::new();
    match IrModule_get_function(&module, name) {
        OptIrFunction::Some(f) => {
            start_effects = f.effects.effects;
        }
        OptIrFunction::None => {
            return repl_no_fn(name);
        }
    }
    var caps: Vec<str> = Vec::new();
    var todo: Vec<str> = Vec::new();
    var seen: Vec<str> = Vec::new();
    todo.push(name);
    seen.push(name);
    while todo.len() > 0 {
        var fname: str = todo.get(todo.len() - 1);
        todo.remove(todo.len() - 1);
        match IrModule_get_function(&module, fname) {
            OptIrFunction::Some(f) => {
                var k: i64 = 0;
                while k < f.insts.len() {
                    match f.insts.get(k).inst {
                        Inst::Print(_, _) => {
                            repl_cap_add(&mut caps, "IO");
                        }
                        Inst::Call(callee, _, _, _) => {
                            repl_cap_add(&mut caps, repl_call_cap(callee));
                            if cc_c_str_vec_contains(user, callee) && !cc_c_str_vec_contains(seen, callee) {
                                seen.push(callee);
                                todo.push(callee);
                            }
                        }
                        _ => {
                        }
                    }
                    k = k + 1;
                }
            }
            OptIrFunction::None => {
            }
        }
    }
    var e: i64 = 0;
    while e < start_effects.len() {
        match start_effects.get(e) {
            Effect::Net => {
                repl_cap_add(&mut caps, "Net");
            }
            Effect::Spawn => {
                repl_cap_add(&mut caps, "Spawn");
            }
            Effect::IO => {
                if !cc_c_str_vec_contains(caps, "IO") && !cc_c_str_vec_contains(caps, "FS") {
                    caps.push("IO");
                }
            }
            _ => {
            }
        }
        e = e + 1;
    }
    if caps.len() == 0 {
        return ResultStr::Ok("none");
    }
    return ResultStr::Ok(str_join(caps, ", "));
}

/// MI18: `:opt` in `fid repl` (it replaced `:pir`, the PIR path's levels)
/// — function `name` of the lowered session after the IR optimizer that
/// `emit` runs before the machine layer (iropt.fd iropt_native, on the
/// whole session so calls can be inlined), headed by its effects as
/// `:effects` names them (repl_lang_effects over the session `defs`; the
/// IR's set when the checker does not know the name).
pub fn repl_fn_opt(module: IrModule, name: str, defs: str) -> ResultStr {
    if str_len(IrModule_function_detail_str(&module, name)) == 0 {
        return repl_no_fn(name);
    }
    var effects: str = "";
    match repl_lang_effects(defs, name) {
        ResultStr::Ok(le) => {
            effects = le;
        }
        ResultStr::Err(_) => {
            match repl_fn_effects(module, name) {
                ResultStr::Ok(e) => {
                    effects = e;
                }
                ResultStr::Err(_) => {
                }
            }
        }
    }
    var opt_mod: IrModule = module;
    iropt_native(&mut opt_mod);
    var text: str = IrModule_function_detail_str(&opt_mod, name);
    if str_len(text) == 0 {
        return ResultStr::Err(c_vec1("'" + name + "' was inlined into its callers and removed by the optimizer (:ir " + name + " shows it as lowered)"));
    }
    return ResultStr::Ok("; --- function " + name + " after iropt (effects: " + effects + ") ---\n" + text);
}

/// L7G: `:ast <expr>` in `fid repl` — the parsed expression `expr_src` as
/// rast_expr prints it (the session's definitions `defs` follow it in the
/// parsed source), or the parse error. Nothing is checked or run.
pub fn repl_expr_ast(defs: str, expr_src: str) -> ResultStr {
    var source: str = "fn __repl_ast() -> i64 {\n    (" + expr_src + ");\n    return 0;\n}\n" + defs;
    match parse_source(source) {
        ParseResultProgram::Err(e) => {
            return ResultStr::Err(c_vec1(e));
        }
        ParseResultProgram::Ok(p) => {
            if p.funcs.len() == 0 {
                return ResultStr::Err(c_vec1("not an expression: " + expr_src));
            }
            var f: Func = p.funcs.get(0);
            if f.body.len() == 0 {
                return ResultStr::Err(c_vec1("not an expression: " + expr_src));
            }
            var lines: Vec<str> = Vec::new();
            match f.body.get(0) {
                Stmt::Expr(e, _) => {
                    rast_expr(e, 0, &mut lines);
                }
                _ => {
                    rast_stmt(f.body.get(0), 0, &mut lines);
                }
            }
            return ResultStr::Ok(str_join(lines, "\n"));
        }
    }
    return ResultStr::Err(c_vec1("unreachable"));
}

/// CE2: unwrap() and expect() panic on None or Err. Outside tests (a file
/// named *_test.fd, or a fn test_* or bench_* as `fid test` runs), warn at
/// each function that calls one.
fn lint_unwraps(tc: &mut TypeChecker, user: Program, source: str, source_path: str) {
    if str_ends_with(source_path, "_test.fd") {
        return;
    }
    var names: Vec<str> = Vec::new();
    var bodies: Vec<Vec<Stmt>> = Vec::new();
    var fi: i64 = 0;
    while fi < user.funcs.len() {
        names.push(user.funcs.get(fi).name);
        bodies.push(user.funcs.get(fi).body);
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < user.impls.len() {
        var imp: ImplDef = user.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            names.push(imp.methods.get(mi).name);
            bodies.push(imp.methods.get(mi).body);
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var i: i64 = 0;
    while i < names.len() {
        val name: str = names.get(i);
        if !str_starts_with(name, "test_") && !str_starts_with(name, "bench_") {
            var called: Vec<str> = Vec::new();
            TypeChecker_collect_called_funcs(tc, bodies.get(i), &mut called);
            if str_vec_contains(called, "#unwrap") {
                tc.warnings.push(lint_unwrap_where(source, name) + "'" + name + "' calls unwrap() or expect(), which panic on None or Err.\n" + "    Fix: match on it, use unwrap_or(default), or return the error with ?.");
            }
        }
        i = i + 1;
    }
}

/// "line N: " for the first unwrap( or expect( after `fn <name>`, or "".
fn lint_unwrap_where(source: str, name: str) -> str {
    val at: i64 = str_find(source, "fn " + name + "(");
    if at < 0 {
        return "";
    }
    val rest: str = str_slice(source, at, str_len(source));
    var u: i64 = str_find(rest, ".unwrap(");
    val e: i64 = str_find(rest, ".expect(");
    if u < 0 || (e >= 0 && e < u) {
        u = e;
    }
    if u < 0 {
        return "";
    }
    var line: i64 = 1;
    var k: i64 = 0;
    while k < at + u {
        if str_byte_at(source, k) == 10 {
            line = line + 1;
        }
        k = k + 1;
    }
    return "line " + int_to_str(line) + ": ";
}

// --- L7E: unused variables and style lints ---------------------------------
// roadmap L7E: a scan of the user's source text (its tokens), not of the
// AST: a local or parameter whose name is never read in its function is
// unused; function, variable, type and constant names follow the naming
// conventions; the `use` lines of a group are sorted. Names that start with
// `_` are left alone. Every rule errs on the side of no warning (a name that
// appears in a string, after shadowing, or as a struct field counts as read).
// The same code was run over stdlib/, examples/ and tests/projects/ before
// it went in: the five examples and the projects `scripts/examples-check.sh`
// and `scripts/projects-check.sh` lint stay clean.

/// One token of the lint scan: an identifier (kind 0), a punctuation byte
/// (1), a string literal's contents (2) or a number (3), and its line.
struct LxTok {
    text: str,
    kind: i64,
    line: i64,
}

fn lx_is_alpha(c: i64) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

fn lx_is_alnum(c: i64) -> bool {
    return lx_is_alpha(c) || (c >= 48 && c <= 57);
}

/// The tokens of `source`, without comments and white space.
fn lx_tokens(source: str) -> Vec<LxTok> {
    var out: Vec<LxTok> = Vec::new();
    var n: i64 = str_len(source);
    var line: i64 = 1;
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(source, i);
        if c == 10 {
            line = line + 1;
            i = i + 1;
        } else if c == 32 || c == 9 || c == 13 {
            i = i + 1;
        } else if c == 47 && i + 1 < n && str_byte_at(source, i + 1) == 47 {
            while i < n && str_byte_at(source, i) != 10 {
                i = i + 1;
            }
        } else if c == 47 && i + 1 < n && str_byte_at(source, i + 1) == 42 {
            i = i + 2;
            while i < n && !(str_byte_at(source, i) == 42 && i + 1 < n && str_byte_at(source, i + 1) == 47) {
                if str_byte_at(source, i) == 10 {
                    line = line + 1;
                }
                i = i + 1;
            }
            i = i + 2;
        } else if c == 34 {
            var start_line: i64 = line;
            var j: i64 = i + 1;
            while j < n && str_byte_at(source, j) != 34 {
                if str_byte_at(source, j) == 92 {
                    j = j + 1;
                }
                if j < n && str_byte_at(source, j) == 10 {
                    line = line + 1;
                }
                j = j + 1;
            }
            var end: i64 = j;
            if end > n {
                end = n;
            }
            out.push(LxTok {
                text: str_slice(source, i + 1, end), kind: 2, line: start_line
            });
            i = j + 1;
        } else if lx_is_alpha(c) {
            var j2: i64 = i;
            while j2 < n && lx_is_alnum(str_byte_at(source, j2)) {
                j2 = j2 + 1;
            }
            out.push(LxTok {
                text: str_slice(source, i, j2), kind: 0, line: line
            });
            i = j2;
        } else if c >= 48 && c <= 57 {
            var j3: i64 = i;
            // digits, suffixes (`10_i64`, `0xff`) and a decimal point that
            // a digit follows (`0..n` is a range: the `n` is a name)
            while j3 < n && (lx_is_alnum(str_byte_at(source, j3)) || (str_byte_at(source, j3) == 46 && j3 + 1 < n && str_byte_at(source, j3 + 1) >= 48 && str_byte_at(source, j3 + 1) <= 57)) {
                j3 = j3 + 1;
            }
            out.push(LxTok {
                text: str_slice(source, i, j3), kind: 3, line: line
            });
            i = j3;
        } else {
            out.push(LxTok {
                text: str_slice(source, i, i + 1), kind: 1, line: line
            });
            i = i + 1;
        }
    }
    return out;
}

fn lx_is(toks: Vec<LxTok>, i: i64, text: str) -> bool {
    if i < 0 || i >= toks.len() {
        return false;
    }
    var t: LxTok = toks.get(i);
    return t.kind <= 1 && t.text == text;
}

fn lx_ident_at(toks: Vec<LxTok>, i: i64) -> bool {
    if i < 0 || i >= toks.len() {
        return false;
    }
    var t: LxTok = toks.get(i);
    return t.kind == 0;
}

/// Is `name` written in `s` as a whole word?
fn lx_word_in(s: str, name: str) -> bool {
    var from: i64 = 0;
    var nl: i64 = str_len(name);
    var sl: i64 = str_len(s);
    while from + nl <= sl {
        var rest: str = str_slice(s, from, sl);
        var at: i64 = str_find(rest, name);
        if at < 0 {
            return false;
        }
        var p: i64 = from + at;
        var ok: bool = true;
        if p > 0 && lx_is_alnum(str_byte_at(s, p - 1)) {
            ok = false;
        }
        if p + nl < sl && lx_is_alnum(str_byte_at(s, p + nl)) {
            ok = false;
        }
        if ok {
            return true;
        }
        from = p + 1;
    }
    return false;
}

/// Is the identifier at `i` a field, method or argument name rather than a
/// read of a local: after `.` (not `..`), or before a single `:` (a struct
/// literal's field, a named argument), or the name a declaration introduces?
fn lx_not_a_read(toks: Vec<LxTok>, i: i64) -> bool {
    // `.name` is a field or method; `..name` the end of a range
    if lx_is(toks, i - 1, ".") && !lx_is(toks, i - 2, ".") {
        return true;
    }
    // the name a declaration introduces
    var k: i64 = i - 1;
    if lx_is(toks, k, "mut") {
        k = k - 1;
    }
    if lx_is(toks, k, "var") || lx_is(toks, k, "val") || lx_is(toks, k, "let") || lx_is(toks, k, "for") {
        return true;
    }
    if lx_is(toks, i + 1, ":") && !lx_is(toks, i + 2, ":") && !lx_is(toks, i - 1, ":") {
        return true;
    }
    return false;
}

/// How many times the body tokens [b0, b1) read `name` (strings that
/// mention it count as reads).
fn lx_reads(toks: Vec<LxTok>, b0: i64, b1: i64, name: str) -> i64 {
    var count: i64 = 0;
    var i: i64 = b0;
    while i < b1 {
        var t: LxTok = toks.get(i);
        if t.kind == 0 && t.text == name && !lx_not_a_read(toks, i) {
            count = count + 1;
        } else if t.kind == 2 && lx_word_in(t.text, name) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

/// The index just after the bracket that closes the one at `open`.
fn lx_close(toks: Vec<LxTok>, open: i64, o: str, c: str) -> i64 {
    var depth: i64 = 0;
    var i: i64 = open;
    while i < toks.len() {
        if lx_is(toks, i, o) {
            depth = depth + 1;
        } else if lx_is(toks, i, c) {
            depth = depth - 1;
            if depth == 0 {
                return i + 1;
            }
        }
        i = i + 1;
    }
    return toks.len();
}

/// snake_case: lower-case letters, digits and `_`.
fn lx_is_snake(s: str) -> bool {
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c >= 65 && c <= 90 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// A function name that follows the convention: snake_case, or the
/// `Type_method` form of a method written as a free function.
fn lx_fn_name_ok(s: str) -> bool {
    if lx_is_snake(s) {
        return true;
    }
    var us: i64 = str_find(s, "_");
    if us <= 0 {
        return false;
    }
    var head: str = str_slice(s, 0, us);
    var tail: str = str_slice(s, us + 1, str_len(s));
    return lx_is_camel(head) && str_len(tail) > 0 && lx_is_snake(tail);
}

/// UpperCamelCase: an upper-case first letter and no `_`.
fn lx_is_camel(s: str) -> bool {
    if str_len(s) == 0 {
        return false;
    }
    var c0: i64 = str_byte_at(s, 0);
    if c0 < 65 || c0 > 90 {
        return false;
    }
    return str_find(s, "_") < 0;
}

/// SCREAMING_SNAKE_CASE: no lower-case letter.
fn lx_is_upper_snake(s: str) -> bool {
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c >= 97 && c <= 122 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// `myCount` / `MyCount` -> `my_count`, `HTTPServer` -> `http_server`.
fn lx_to_snake(s: str) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c >= 65 && c <= 90 {
            // a new word: after a lower-case letter or digit, or the last
            // capital of a run before a lower-case letter (HTTPServer)
            if i > 0 {
                var pc: i64 = str_byte_at(s, i - 1);
                var prev_lower: bool = (pc >= 97 && pc <= 122) || (pc >= 48 && pc <= 57);
                var next_lower: bool = false;
                if i + 1 < str_len(s) {
                    var nc: i64 = str_byte_at(s, i + 1);
                    next_lower = nc >= 97 && nc <= 122;
                }
                if prev_lower || (pc >= 65 && pc <= 90 && next_lower) {
                    out = out + "_";
                }
            }
            out = out + str_slice(" abcdefghijklmnopqrstuvwxyz", c - 64, c - 63);
        } else {
            out = out + str_slice(s, i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

/// `my_type` -> `MyType`.
fn lx_to_camel(s: str) -> str {
    var out: str = "";
    var up: bool = true;
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c == 95 {
            up = true;
        } else if up && c >= 97 && c <= 122 {
            out = out + str_slice(" ABCDEFGHIJKLMNOPQRSTUVWXYZ", c - 96, c - 95);
            up = false;
        } else {
            out = out + str_slice(s, i, i + 1);
            up = false;
        }
        i = i + 1;
    }
    return out;
}

/// `max_len` -> `MAX_LEN`.
fn lx_upper(s: str) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c >= 97 && c <= 122 {
            out = out + str_slice(" ABCDEFGHIJKLMNOPQRSTUVWXYZ", c - 96, c - 95);
        } else {
            out = out + str_slice(s, i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

/// The annotation names written just before the item at `i` (`@repr(C)
/// struct` gives " repr").
fn lx_annotations_before(toks: Vec<LxTok>, i: i64) -> str {
    var out: str = "";
    var k: i64 = i - 1;
    if lx_is(toks, k, "pub") {
        k = k - 1;
    }
    var steps: i64 = 0;
    while k >= 0 && steps < 16 {
        if lx_is(toks, k, ")") {
            k = lx_open_of(toks, k) - 1;
        }
        if lx_ident_at(toks, k) && lx_is(toks, k - 1, "@") {
            var t: LxTok = toks.get(k);
            out = out + " " + t.text;
            k = k - 2;
        } else {
            return out;
        }
        steps = steps + 1;
    }
    return out;
}

/// The index of the `(` that the `)` at `close` closes.
fn lx_open_of(toks: Vec<LxTok>, close: i64) -> i64 {
    var depth: i64 = 0;
    var i: i64 = close;
    while i >= 0 {
        if lx_is(toks, i, ")") {
            depth = depth + 1;
        } else if lx_is(toks, i, "(") {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i - 1;
    }
    return 0;
}

/// Is token `i` inside one of the ranges [starts[k], ends[k])?
fn lx_in_ranges(starts: Vec<i64>, ends: Vec<i64>, i: i64) -> bool {
    var k: i64 = 0;
    while k < starts.len() {
        if i >= starts.get(k) && i < ends.get(k) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

/// The unused-variable and naming warnings of one function `name`: its
/// parameter list is the tokens [p0, p1), its body [b0, b1). A method of a
/// trait impl (`check_params` false) takes the parameters the trait gives
/// it: those are not reported unused.
fn lx_lint_fn(toks: Vec<LxTok>, name: str, p0: i64, p1: i64, b0: i64, b1: i64, check_params: bool, out: &mut Vec<str>) {
    // the body's declarations: var/val/let [mut] NAME, for NAME in
    var dnames: Vec<str> = Vec::new();
    var dlines: Vec<i64> = Vec::new();
    var i: i64 = b0;
    while i < b1 {
        if lx_is(toks, i, "var") || lx_is(toks, i, "val") || lx_is(toks, i, "let") || lx_is(toks, i, "for") {
            var k: i64 = i + 1;
            if lx_is(toks, k, "mut") {
                k = k + 1;
            }
            if lx_ident_at(toks, k) && (!lx_is(toks, i, "for") || lx_is(toks, k + 1, "in")) {
                var d: LxTok = toks.get(k);
                dnames.push(d.text);
                dlines.push(d.line);
            }
        }
        i = i + 1;
    }
    // parameters: NAME before `:` at the list's own depth
    var pnames: Vec<str> = Vec::new();
    var plines: Vec<i64> = Vec::new();
    var depth: i64 = 0;
    var j: i64 = p0;
    while j < p1 {
        if lx_is(toks, j, "(") || lx_is(toks, j, "<") || lx_is(toks, j, "[") {
            depth = depth + 1;
        } else if lx_is(toks, j, ")") || (lx_is(toks, j, ">") && !lx_is(toks, j - 1, "-")) || lx_is(toks, j, "]") {
            depth = depth - 1;
        } else if depth == 1 && lx_ident_at(toks, j) && lx_is(toks, j + 1, ":") && !lx_is(toks, j + 2, ":") && (lx_is(toks, j - 1, "(") || lx_is(toks, j - 1, ",") || lx_is(toks, j - 1, "mut")) {
            var pt: LxTok = toks.get(j);
            pnames.push(pt.text);
            plines.push(pt.line);
        }
        j = j + 1;
    }
    var di: i64 = 0;
    while di < dnames.len() {
        var dn: str = dnames.get(di);
        if !str_starts_with(dn, "_") {
            if lx_reads(toks, b0, b1, dn) == 0 {
                out.push("line " + int_to_str(dlines.get(di)) + ": unused variable '" + dn + "' in '" + name + "' — it is declared but never read.\n    Fix: remove it, or name it _" + dn + " if it must stay.");
            }
            if !lx_is_snake(dn) {
                out.push("line " + int_to_str(dlines.get(di)) + ": variable '" + dn + "' in '" + name + "' should be snake_case: " + lx_to_snake(dn));
            }
        }
        di = di + 1;
    }
    var pi: i64 = 0;
    while pi < pnames.len() {
        var pn: str = pnames.get(pi);
        if check_params && pn != "self" && !str_starts_with(pn, "_") {
            if lx_reads(toks, b0, b1, pn) == 0 {
                out.push("line " + int_to_str(plines.get(pi)) + ": unused parameter '" + pn + "' of '" + name + "' — it is never read.\n    Fix: remove it, or name it _" + pn + " if the signature needs it.");
            }
            if !lx_is_snake(pn) {
                out.push("line " + int_to_str(plines.get(pi)) + ": parameter '" + pn + "' of '" + name + "' should be snake_case: " + lx_to_snake(pn));
            }
        }
        pi = pi + 1;
    }
}

/// The sort key of a `use` path: the prelude modules first, in the order
/// every module of the compiler and the standard library writes them
/// (`use core; use vec; use string;`), then the rest by path.
fn lx_use_key(path: str) -> str {
    if path == "core" {
        return "0";
    }
    if path == "vec" {
        return "1";
    }
    if path == "string" {
        return "2";
    }
    return "3" + path;
}

/// The import-order warnings: within a group of `use` lines (one after the
/// other, no blank line or other item between), the paths are sorted
/// (lx_use_key).
fn lx_lint_uses(toks: Vec<LxTok>, out: &mut Vec<str>) {
    var depth: i64 = 0;
    var prev_path: str = "";
    var prev_end_line: i64 = -10;
    var prev_end_tok: i64 = -10;
    var i: i64 = 0;
    while i < toks.len() {
        if lx_is(toks, i, "{") {
            depth = depth + 1;
        } else if lx_is(toks, i, "}") {
            depth = depth - 1;
        } else if depth == 0 && lx_is(toks, i, "use") {
            var start: i64 = i;
            if lx_is(toks, i - 1, "pub") {
                start = i - 1;
            }
            var path: str = "";
            var k: i64 = i + 1;
            while k < toks.len() && !lx_is(toks, k, ";") && !lx_is(toks, k, "{") {
                var pt: LxTok = toks.get(k);
                path = path + pt.text;
                k = k + 1;
            }
            var st: LxTok = toks.get(start);
            var same_group: bool = prev_end_tok == start - 1 && st.line - prev_end_line <= 1;
            if same_group && str_compare(lx_use_key(path), lx_use_key(prev_path)) < 0 {
                out.push("line " + int_to_str(st.line) + ": imports are not sorted: 'use " + path + "' should come before 'use " + prev_path + "'.\n    Fix: sort the use lines of this group by path (core, vec and string first).");
            }
            prev_path = path;
            if k < toks.len() && lx_is(toks, k, ";") {
                var et: LxTok = toks.get(k);
                prev_end_line = et.line;
                prev_end_tok = k;
            } else {
                prev_end_tok = -10;
            }
            i = k;
        }
        i = i + 1;
    }
}

/// L7E: the unused-variable, naming and import-order warnings of `source`
/// (lint_source adds them to the checker's).
pub fn lint_source_scan(source: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var toks: Vec<LxTok> = lx_tokens(source);
    lx_lint_uses(toks, &mut out);
    // the token ranges of `impl Trait for Type { ... }` blocks
    var trait_starts: Vec<i64> = Vec::new();
    var trait_ends: Vec<i64> = Vec::new();
    var ti: i64 = 0;
    while ti < toks.len() {
        if lx_is(toks, ti, "impl") {
            var k2: i64 = ti + 1;
            var is_trait: bool = false;
            while k2 < toks.len() && !lx_is(toks, k2, "{") && !lx_is(toks, k2, ";") {
                if lx_is(toks, k2, "for") {
                    is_trait = true;
                }
                k2 = k2 + 1;
            }
            if is_trait && k2 < toks.len() && lx_is(toks, k2, "{") {
                trait_starts.push(k2);
                trait_ends.push(lx_close(toks, k2, "{", "}"));
            }
        }
        ti = ti + 1;
    }
    var i: i64 = 0;
    while i < toks.len() {
        if lx_is(toks, i, "fn") && lx_ident_at(toks, i + 1) && !lx_is(toks, i - 1, ".") {
            var nt: LxTok = toks.get(i + 1);
            var name: str = nt.text;
            var k: i64 = i + 2;
            if lx_is(toks, k, "<") {
                // generics: to the matching `>`
                var gd: i64 = 0;
                while k < toks.len() {
                    if lx_is(toks, k, "<") {
                        gd = gd + 1;
                    } else if lx_is(toks, k, ">") && !lx_is(toks, k - 1, "-") {
                        gd = gd - 1;
                        if gd == 0 {
                            k = k + 1;
                            break;
                        }
                    }
                    k = k + 1;
                }
            }
            if lx_is(toks, k, "(") {
                var p0: i64 = k;
                var p1: i64 = lx_close(toks, k, "(", ")");
                // the body: the first `{` before any `;` (none: an extern
                // or trait declaration, not checked)
                var b: i64 = p1;
                while b < toks.len() && !lx_is(toks, b, "{") && !lx_is(toks, b, ";") {
                    b = b + 1;
                }
                if b < toks.len() && lx_is(toks, b, "{") {
                    var b1: i64 = lx_close(toks, b, "{", "}");
                    // a function without parameters named like a constant
                    // (`fn CHAN_CLOSED() -> i64`) stands for one
                    var const_fn: bool = p1 == p0 + 2 && lx_is_upper_snake(name);
                    if !lx_fn_name_ok(name) && !str_starts_with(name, "_") && !const_fn {
                        out.push("line " + int_to_str(nt.line) + ": function '" + name + "' should be snake_case: " + lx_to_snake(name));
                    }
                    lx_lint_fn(toks, name, p0, p1, b + 1, b1 - 1, !lx_in_ranges(trait_starts, trait_ends, i), &mut out);
                }
            }
        } else if (lx_is(toks, i, "struct") || lx_is(toks, i, "enum") || lx_is(toks, i, "trait") || (lx_is(toks, i, "cap") && !lx_is(toks, i - 1, ".") && (lx_is(toks, i + 2, "{") || lx_is(toks, i + 2, ":") || lx_is(toks, i + 2, "<")))) && lx_ident_at(toks, i + 1) {
            var tt: LxTok = toks.get(i + 1);
            var kw: LxTok = toks.get(i);
            // @repr(C) / @packed types mirror C names
            var ann: str = lx_annotations_before(toks, i);
            if !lx_is_camel(tt.text) && !str_contains(ann, "repr") && !str_contains(ann, "packed") && !str_starts_with(tt.text, "_") {
                out.push("line " + int_to_str(tt.line) + ": " + kw.text + " '" + tt.text + "' should be UpperCamelCase: " + lx_to_camel(tt.text));
            }
        } else if lx_is(toks, i, "const") && lx_ident_at(toks, i + 1) && lx_is(toks, i + 2, ":") {
            var ct: LxTok = toks.get(i + 1);
            if !lx_is_upper_snake(ct.text) {
                out.push("line " + int_to_str(ct.line) + ": constant '" + ct.text + "' should be SCREAMING_SNAKE_CASE: " + lx_upper(lx_to_snake(ct.text)));
            }
        }
        i = i + 1;
    }
    return out;
}

// --- CP9: fid lint --perf ---------------------------------------------------
// Quadratic patterns that read as cheap: `str + str` inside a loop (each +
// copies the whole string), `v.remove(0)` inside a loop (shifts every
// element), and linear lookups (`find`, `index_of`, `position`, `contains`,
// `rfind`) nested in a loop.

/// All `--perf` warnings in one user program.
pub fn lint_perf(user: Program) -> Vec<str> {
    var warnings: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < user.funcs.len() {
        lint_perf_func(user.funcs.get(fi), &mut warnings);
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < user.impls.len() {
        var imp: ImplDef = user.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            lint_perf_func(imp.methods.get(mi), &mut warnings);
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    return warnings;
}

fn lint_perf_func(f: Func, warnings: &mut Vec<str>) {
    var str_names: Vec<str> = Vec::new();
    var pi: i64 = 0;
    while pi < f.params.len() {
        var prm: Param = f.params.get(pi);
        if lint_perf_ty_str(prm.ty) {
            str_names.push(prm.name);
        }
        pi = pi + 1;
    }
    lint_perf_stmts(f.body, f.name, 0, str_names.clone(), warnings);
}

/// True when a declared type is `str`/`String` (or a reference to one).
fn lint_perf_ty_str(ty: Type) -> bool {
    match ty {
        Type::Str => {
            return true;
        }
        Type::Named(n) => {
            return n == "str" || n == "String";
        }
        Type::Ref(inner, _) => {
            return lint_perf_ty_str(box_type_unbox(inner));
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// True when a `Let` declares `name` as `str`-typed or string-initialised.
fn lint_perf_let_str(oty: OptType, init: Expr, str_names: Vec<str>) -> bool {
    match oty {
        OptType::Some(t) => {
            return lint_perf_ty_str(t);
        }
        OptType::None => {
            return lint_perf_is_str(init, str_names);
        }
    }
    return false;
}

/// True when `e` is visibly a string value: a literal, a known `str` var, a
/// string-producing call/method, or `+` on something already a string.
fn lint_perf_is_str(e: Expr, str_names: Vec<str>) -> bool {
    match e {
        Expr::StringLit(_) => {
            return true;
        }
        Expr::FString(_) => {
            return true;
        }
        Expr::StrConcat(_, _) => {
            return true;
        }
        Expr::Ident(n) => {
            var i: i64 = 0;
            while i < str_names.len() {
                if str_names.get(i) == n {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        Expr::MethodCall(_, m, _) => {
            return m == "to_str" || m == "concat" || m == "join" || m == "slice" || m == "as_str" || m == "to_string" || m == "substr" || m == "upper" || m == "lower" || m == "trim" || m == "replace" || m == "repeat";
        }
        Expr::Call(n, _) => {
            return n == "int_to_str" || n == "f64_to_str" || n == "f32_to_str" || n == "bool_to_str" || n == "str_slice" || n == "str_concat" || n == "char_to_str" || n == "u64_to_str" || n == "i64_to_str";
        }
        Expr::Binary(o2, a, b) => {
            if o2 == BinOp::Add {
                return lint_perf_is_str(box_expr_unbox(a), str_names.clone()) || lint_perf_is_str(box_expr_unbox(b), str_names.clone());
            }
            return false;
        }
        Expr::Coalesce(a, b) => {
            return lint_perf_is_str(box_expr_unbox(a), str_names.clone()) || lint_perf_is_str(box_expr_unbox(b), str_names.clone());
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// True when `e` is a `str`-typed *variable* — the accumulating operand of a
/// quadratic `s = s + piece` concat. Fresh short strings (int_to_str(x) + y)
/// are linear, not quadratic, and are deliberately not flagged.
fn lint_perf_is_str_var(e: Expr, str_names: Vec<str>) -> bool {
    match e {
        Expr::Ident(n) => {
            var i: i64 = 0;
            while i < str_names.len() {
                if str_names.get(i) == n {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn lint_perf_warn(warnings: &mut Vec<str>, fname: str, line: i64, what: str) {
    warnings.push(fname + ": line " + int_to_str(line) + ": " + what);
}

fn lint_perf_stmts(body: Vec<Stmt>, fname: str, depth: i64, base_names: Vec<str>, warnings: &mut Vec<str>) {
    // Pre-pass: names this block declares `str`-typed are visible everywhere
    // in the block (slight over-approximation is fine for a lint).
    var str_names: Vec<str> = base_names;
    var i: i64 = 0;
    while i < body.len() {
        match body.get(i) {
            Stmt::Let(n, oty, e, _, _, _, _) => {
                if lint_perf_let_str(oty, e, str_names.clone()) {
                    str_names.push(n);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    var j: i64 = 0;
    while j < body.len() {
        var st: Stmt = body.get(j);
        lint_perf_stmt(st, fname, depth, stmt_line(st), str_names.clone(), warnings);
        j = j + 1;
    }
}

fn lint_perf_stmt(s: Stmt, fname: str, depth: i64, site: i64, str_names: Vec<str>, warnings: &mut Vec<str>) {
    match s {
        Stmt::Let(n, oty, e, _, _, _, _) => {
            lint_perf_expr(e, fname, depth, site, str_names.clone(), warnings);
        }
        Stmt::LetTuple(_, e, _) => {
            lint_perf_expr(e, fname, depth, site, str_names.clone(), warnings);
        }
        Stmt::LetUninit(_, _, _, _) => {
        }
        Stmt::Assign(_, _, e, _) => {
            lint_perf_expr(e, fname, depth, site, str_names.clone(), warnings);
        }
        Stmt::IndexAssign(_, a, _, b, _) => {
            lint_perf_expr(a, fname, depth, site, str_names.clone(), warnings);
            lint_perf_expr(b, fname, depth, site, str_names.clone(), warnings);
        }
        Stmt::DerefAssign(a, _, b, _) => {
            lint_perf_expr(a, fname, depth, site, str_names.clone(), warnings);
            lint_perf_expr(b, fname, depth, site, str_names.clone(), warnings);
        }
        Stmt::FieldAssign(a, _, _, b, _) => {
            lint_perf_expr(a, fname, depth, site, str_names.clone(), warnings);
            lint_perf_expr(b, fname, depth, site, str_names.clone(), warnings);
        }
        Stmt::Expr(e, _) => {
            lint_perf_expr(e, fname, depth, site, str_names.clone(), warnings);
        }
        Stmt::Return(oe, _) => {
            match oe {
                OptBoxExpr::Some(be) => {
                    lint_perf_expr(box_expr_unbox(be), fname, depth, site, str_names.clone(), warnings);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(c, t, e, _) => {
            lint_perf_expr(c, fname, depth, site, str_names.clone(), warnings);
            lint_perf_stmts(t, fname, depth, str_names.clone(), warnings);
            match e {
                OptStmts::Some(eb) => {
                    lint_perf_stmts(eb, fname, depth, str_names.clone(), warnings);
                }
                OptStmts::None => {
                }
            }
        }
        // The condition and range re-evaluate every iteration: they count as
        // inside the loop.
        Stmt::While(c, b, _) => {
            lint_perf_expr(c, fname, depth + 1, site, str_names.clone(), warnings);
            lint_perf_stmts(b, fname, depth + 1, str_names.clone(), warnings);
        }
        Stmt::For(_, e, b, _) => {
            lint_perf_expr(e, fname, depth + 1, site, str_names.clone(), warnings);
            lint_perf_stmts(b, fname, depth + 1, str_names.clone(), warnings);
        }
        Stmt::Loop(b, _) => {
            lint_perf_stmts(b, fname, depth + 1, str_names.clone(), warnings);
        }
        Stmt::Break(obe, _) => {
            match obe {
                OptBoxExpr::Some(be2) => {
                    lint_perf_expr(box_expr_unbox(be2), fname, depth, site, str_names.clone(), warnings);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::Continue(_) => {
        }
        Stmt::Defer(b, _) => {
            lint_perf_stmts(b, fname, 0, str_names.clone(), warnings);
        }
        Stmt::Match(e, arms, _) => {
            lint_perf_expr(e, fname, depth, site, str_names.clone(), warnings);
            var ai: i64 = 0;
            while ai < arms.len() {
                var arm: MatchArm = arms.get(ai);
                match arm.guard {
                    OptBoxExpr::Some(ge) => {
                        lint_perf_expr(box_expr_unbox(ge), fname, depth, site, str_names.clone(), warnings);
                    }
                    OptBoxExpr::None => {
                    }
                }
                lint_perf_stmts(arm.body, fname, depth, str_names.clone(), warnings);
                ai = ai + 1;
            }
        }
        Stmt::Use(_, _, _) => {
        }
        Stmt::Handle(b, hs, _) => {
            lint_perf_stmts(b, fname, depth, str_names.clone(), warnings);
            var hi: i64 = 0;
            while hi < hs.len() {
                lint_perf_stmts(hs.get(hi).body, fname, depth, str_names.clone(), warnings);
                hi = hi + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var di: i64 = 0;
            while di < args.len() {
                lint_perf_expr(args.get(di), fname, depth, site, str_names.clone(), warnings);
                di = di + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, b, _) => {
            lint_perf_stmts(b, fname, depth, str_names.clone(), warnings);
        }
        Stmt::Sandbox(b, _) => {
            lint_perf_stmts(b, fname, depth, str_names.clone(), warnings);
        }
        Stmt::Unsafe(b, _) => {
            lint_perf_stmts(b, fname, depth, str_names.clone(), warnings);
        }
        Stmt::Txn(b, _) => {
            lint_perf_stmts(b, fname, depth, str_names.clone(), warnings);
        }
        Stmt::ComptimeGen(b, _) => {
            lint_perf_stmts(b, fname, 0, str_names.clone(), warnings);
        }
        Stmt::GradBlock(_, b, _) => {
            lint_perf_stmts(b, fname, depth, str_names.clone(), warnings);
        }
        Stmt::Backward(e, _) => {
            lint_perf_expr(e, fname, depth, site, str_names.clone(), warnings);
        }
        Stmt::Query(_, b, _) => {
            lint_perf_stmts(b, fname, depth, str_names.clone(), warnings);
        }
        Stmt::Select(cases, dflt, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                var sc: SelectCase = cases.get(ci);
                lint_perf_expr(sc.channel, fname, depth, site, str_names.clone(), warnings);
                lint_perf_stmts(sc.body, fname, depth, str_names.clone(), warnings);
                ci = ci + 1;
            }
            match dflt {
                OptStmts::Some(db) => {
                    lint_perf_stmts(db, fname, depth, str_names.clone(), warnings);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::Parallel(branches, _) => {
            var pi: i64 = 0;
            while pi < branches.len() {
                lint_perf_stmts(branches.get(pi), fname, depth, str_names.clone(), warnings);
                pi = pi + 1;
            }
        }
        Stmt::Resume(a, b, _) => {
            lint_perf_expr(a, fname, depth, site, str_names.clone(), warnings);
            lint_perf_expr(b, fname, depth, site, str_names.clone(), warnings);
        }
        Stmt::SpawnScope(b, _) => {
            lint_perf_stmts(b, fname, depth, str_names.clone(), warnings);
        }
        Stmt::CancelScope(_) => {
        }
    }
}

fn lint_perf_exprs(args: Vec<Expr>, fname: str, depth: i64, site: i64, str_names: Vec<str>, warnings: &mut Vec<str>) {
    var i: i64 = 0;
    while i < args.len() {
        lint_perf_expr(args.get(i), fname, depth, site, str_names.clone(), warnings);
        i = i + 1;
    }
}

fn lint_perf_expr(e: Expr, fname: str, depth: i64, site: i64, str_names: Vec<str>, warnings: &mut Vec<str>) {
    match e {
        Expr::StrConcat(a, b) => {
            if depth > 0 {
                lint_perf_warn(warnings, fname, site, "str + str in a loop copies the whole string each iteration — quadratic.\n    Fix: append to a StringBuilder and to_str once after the loop.");
            }
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
            lint_perf_expr(box_expr_unbox(b), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::MethodCall(recv, m, args) => {
            if depth > 0 {
                if m == "remove" && args.len() > 0 {
                    match args.get(0) {
                        Expr::IntLit(z) => {
                            if z == 0 {
                                lint_perf_warn(warnings, fname, site, "v.remove(0) in a loop shifts every element each call — quadratic.\n    Fix: pop from the end, collect indices and remove once, or use a deque.");
                            }
                        }
                        _ => {
                        }
                    }
                }
                if m == "index_of" || m == "position" || m == "find" || m == "rfind" || m == "contains" {
                    lint_perf_warn(warnings, fname, site, m + " in a loop is a linear lookup each iteration — quadratic on a Vec.\n    Fix: use a HashMap/Set, or hoist the lookup out of the loop.");
                }
            }
            lint_perf_expr(box_expr_unbox(recv), fname, depth, site, str_names.clone(), warnings);
            lint_perf_exprs(args, fname, depth, site, str_names.clone(), warnings);
        }
        Expr::Call(_, args) => {
            lint_perf_exprs(args, fname, depth, site, str_names.clone(), warnings);
        }
        Expr::Binary(op, a, b) => {
            if op == BinOp::Add && depth > 0 {
                if lint_perf_is_str_var(box_expr_unbox(a), str_names.clone()) {
                    lint_perf_warn(warnings, fname, site, "str + str in a loop copies the whole string each iteration — quadratic.\n    Fix: append to a StringBuilder and to_str once after the loop.");
                }
            }
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
            lint_perf_expr(box_expr_unbox(b), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::Unary(_, a) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::FieldAccess(a, _) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::OptionalFieldAccess(a, _) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::StructLit(_, inits, base) => {
            var si: i64 = 0;
            while si < inits.len() {
                lint_perf_expr(inits.get(si).value, fname, depth, site, str_names.clone(), warnings);
                si = si + 1;
            }
            match base {
                OptBoxExpr::Some(bv) => {
                    lint_perf_expr(box_expr_unbox(bv), fname, depth, site, str_names.clone(), warnings);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::If(c, t, e2) => {
            lint_perf_expr(box_expr_unbox(c), fname, depth, site, str_names.clone(), warnings);
            lint_perf_stmts(t, fname, depth, str_names.clone(), warnings);
            match e2 {
                OptStmts::Some(eb) => {
                    lint_perf_stmts(eb, fname, depth, str_names.clone(), warnings);
                }
                OptStmts::None => {
                }
            }
        }
        Expr::ArrayLit(_, elems) => {
            lint_perf_exprs(elems, fname, depth, site, str_names.clone(), warnings);
        }
        Expr::Index(a, b) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
            lint_perf_expr(box_expr_unbox(b), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::FString(parts) => {
            var fi: i64 = 0;
            while fi < parts.len() {
                match parts.get(fi) {
                    FStringPart::Expr(pe) => {
                        lint_perf_expr(pe, fname, depth, site, str_names.clone(), warnings);
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                fi = fi + 1;
            }
        }
        Expr::Match(me, arms) => {
            lint_perf_expr(box_expr_unbox(me), fname, depth, site, str_names.clone(), warnings);
            var ai: i64 = 0;
            while ai < arms.len() {
                var arm: MatchArm = arms.get(ai);
                match arm.guard {
                    OptBoxExpr::Some(ge) => {
                        lint_perf_expr(box_expr_unbox(ge), fname, depth, site, str_names.clone(), warnings);
                    }
                    OptBoxExpr::None => {
                    }
                }
                lint_perf_stmts(arm.body, fname, depth, str_names.clone(), warnings);
                ai = ai + 1;
            }
        }
        Expr::EnumLit(_, _, args) => {
            lint_perf_exprs(args, fname, depth, site, str_names.clone(), warnings);
        }
        Expr::Ref(a, _) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::Deref(a) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::Try(a) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::Coalesce(a, b) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
            lint_perf_expr(box_expr_unbox(b), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::IsCheck(a, _) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::TupleLit(elems) => {
            lint_perf_exprs(elems, fname, depth, site, str_names.clone(), warnings);
        }
        // A closure runs when called, not per enclosing iteration: the loop
        // depth resets and only its own loops count.
        Expr::Closure(_, body, _) => {
            lint_perf_stmts(body, fname, 0, str_names.clone(), warnings);
        }
        Expr::Cast(a, _) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::Asm(_, ops) => {
            var ai: i64 = 0;
            while ai < ops.len() {
                lint_perf_expr(ops.get(ai).expr, fname, depth, site, str_names.clone(), warnings);
                ai = ai + 1;
            }
        }
        Expr::Comptime(a) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::ComptimeBlock(b) => {
            lint_perf_stmts(b, fname, 0, str_names.clone(), warnings);
        }
        Expr::ComptimeReflect(_, _) => {
        }
        Expr::PipeForward(a, b) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
            lint_perf_expr(box_expr_unbox(b), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::QuantCast(a, _) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::Await(a) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::Spawn(a) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::Yield(a) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::NamedArg(_, a) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
        }
        Expr::Block(b) => {
            lint_perf_stmts(b, fname, depth, str_names.clone(), warnings);
        }
        Expr::TryBlock(b) => {
            lint_perf_stmts(b, fname, depth, str_names.clone(), warnings);
        }
        Expr::Range(a, b, _) => {
            lint_perf_expr(box_expr_unbox(a), fname, depth, site, str_names.clone(), warnings);
            lint_perf_expr(box_expr_unbox(b), fname, depth, site, str_names.clone(), warnings);
        }
        _ => {
        }
    }
}

/// Lower source to an IR module.
pub fn lower_to_ir_module(source: str) -> ResultIrModule {
    var result: ResultProgram = build_program(source);
    match result {
        ResultProgram::Err(errs) => {
            return ResultIrModule::Err(errs);
        }
        ResultProgram::Ok(program) => {
            var module: IrModule = lower(program);
            return ResultIrModule::Ok(module);
        }
    }
    return ResultIrModule::Err(c_vec1("unreachable"));
}

// CD3: set by the C path (ccompile_source_with_path, ccompile_inc_prepare):
// lower only what reach_keep_set keeps, as emit does
var g_c_reach: bool = false;
/// G8.3: Lower source to IR with source path (for import resolution).
pub fn lower_to_ir_module_with_path(source: str, source_path: str, borrowck_mode: str) -> ResultIrModule {
    var result: ResultProgram = build_program_with_path_borrowck(source, OptStr::Some(source_path), borrowck_mode);
    match result {
        ResultProgram::Err(errs) => {
            return ResultIrModule::Err(errs);
        }
        ResultProgram::Ok(program) => {
            // SP2: lowering is a row of the --time table on this path too
            var t_lw: i64 = p_clock_now_ms();
            // CD3: the C path (g_c_reach) lowers only what reach_keep_set
            // keeps, as `emit` does, so a pact's unused functions stay out of
            // the binary; FID_C_REACH=0 or FID_LOWER_ALL=1 lowers everything;
            // FID_C_REACH=1 asks for it on any path
            var reach_env: str = p_getenv("FID_C_REACH");
            var reach_set: bool = (reach_env as i64) != 0 && str_len(reach_env) > 0;
            if (reach_set && reach_env != "0") || (g_c_reach && !reach_set) {
                g_lower_keep = c_reach_keep_set(program);
            }
            var module: IrModule = lower(program);
            g_lower_keep = 0;
            // inc-roadmap B1: one IrModule per source module, linked back
            if str_len(env_or_empty("FID_IR_UNITS")) > 0 {
                module = c_ir_units(module);
            }
            time_mark("lower", t_lw);
            return ResultIrModule::Ok(module);
        }
    }
    return ResultIrModule::Err(c_vec1("unreachable"));
}

/// B1: lower.fd `ir_units_roundtrip` with each function's source module
/// (`func_module_of`, as the C units are split).
fn c_ir_units(module: IrModule) -> IrModule {
    var unit_of: Vec<str> = Vec::new();
    var owner: str = func_module_of("main", "main");
    var i: i64 = 0;
    while i < module.functions.len() {
        unit_of.push(func_module_of(module.functions.get(i).name, owner));
        i = i + 1;
    }
    return ir_units_roundtrip(module, unit_of, env_or_empty("FID_IR_UNITS"));
}

/// Core-name list for reach_keep_set from the cached core program (the same
/// shape main.fd's lw_keep_set builds for the native emit path).
fn c_reach_keep_set(program: Program) -> i64 {
    var core_names: Vec<str> = Vec::new();
    match g_stdlib_cache {
        OptProgram::Some(cp) => {
            var i: i64 = 0;
            while i < cp.funcs.len() {
                core_names.push(cp.funcs.get(i).name);
                i = i + 1;
            }
            i = 0;
            while i < cp.impls.len() {
                var im: ImplDef = cp.impls.get(i);
                var j: i64 = 0;
                while j < im.methods.len() {
                    core_names.push(im.struct_name + "_" + im.methods.get(j).name);
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        OptProgram::None => {
            return 0;
        }
    }
    // 2g.85: a library's `--export` functions are roots, as core's are
    // (reach_keep_set keeps a core name and what it calls): before, an
    // export was not, so the functions it calls were not lowered and the
    // export returned 0 (42 with FID_LOWER_ALL=1)
    val lib_exports: Vec<str> = CGen_lib_export_names();
    var lei: i64 = 0;
    while lei < lib_exports.len() {
        core_names.push(lib_exports.get(lei));
        lei = lei + 1;
    }
    return reach_keep_set(program, core_names);
}

/// Interpret a source file by lowering to IR and executing via the
/// self-hosted interpreter. Returns exit code (0 = success, 1 = error).
pub fn interpret_source(source: str) -> i64 {
    var result: ResultIrModule = lower_to_ir_module(source);
    match result {
        ResultIrModule::Err(errs) => {
            var msg: str = "Compilation error:\n";
            var i: i64 = 0;
            while i < errs.len() {
                if !str_starts_with(errs.get(i), "error") {
                    msg = msg + "error: ";
                }
                msg = msg + errs.get(i) + "\n";
                i = i + 1;
            }
            p_eprint_str(msg);
            return 1;
        }
        ResultIrModule::Ok(ir_mod) => {
            return interpret_ir_module(ir_mod);
        }
    }
    return 1;
}

/// Interpret a source file with execution limits and verbose flag.
/// Returns exit code (0 = success, 1 = error).
pub fn interpret_source_with_options(source: str, max_recursion: i64, max_steps: i64, max_memory: i64, verbose: bool) -> i64 {
    var result: ResultIrModule = lower_to_ir_module(source);
    match result {
        ResultIrModule::Err(errs) => {
            var msg: str = "Compilation error:\n";
            var i: i64 = 0;
            while i < errs.len() {
                if !str_starts_with(errs.get(i), "error") {
                    msg = msg + "error: ";
                }
                msg = msg + errs.get(i) + "\n";
                i = i + 1;
            }
            p_eprint_str(msg);
            return 1;
        }
        ResultIrModule::Ok(ir_mod2) => {
            return interpret_ir_module_with_options(ir_mod2, max_recursion, max_steps, max_memory, verbose);
        }
    }
    return 1;
}

/// CO9: ask the interpreter for a crash report at `path` ("" for the
/// FID_CRASH_REPORT file) when the program panics, recording build
/// `version` and source file `program` (interp.fd interp_crash_report_setup).
pub fn run_crash_report_setup(path: str, version: str, program: str) {
    interp_crash_report_setup(path, version, program);
}

/// CO2: environment variable `name` = `value` for the next interpreted run
/// only (interp.fd interp_set_env).
pub fn run_set_env(name: str, value: str) {
    interp_set_env(name, value);
}

/// CT7: record the effect calls of the next interpreted run into `path`
/// (interp.fd interp_rr_record_start); false when it cannot be written.
pub fn run_record_start(path: str, program: str, source: str) -> bool {
    return interp_rr_record_start(path, program, source);
}

/// CT7: the recorded run ended with exit code `code`.
pub fn run_record_finish(code: i64) {
    interp_rr_record_finish(code);
}

/// CT7: answer the next run's effect calls from trace `text` ("" or why
/// it is not a trace); the recorded program's path and text.
pub fn run_replay_start(text: str, steps: bool) -> str {
    return interp_rr_replay_start(text, steps);
}

pub fn run_replay_program() -> str {
    return interp_rr_program();
}

pub fn run_replay_source() -> str {
    return interp_rr_source();
}

/// CT7: "" when the replay used every recorded call and ended as the
/// recorded run did; else what differs.
pub fn run_replay_finish(code: i64) -> str {
    return interp_rr_replay_finish(code);
}

/// G8.3: Interpret a source file with source path (for import resolution).
pub fn interpret_source_with_path(source: str, source_path: str, max_recursion: i64, max_steps: i64, max_memory: i64, verbose: bool, borrowck_mode: str) -> i64 {
    var result: ResultIrModule = lower_to_ir_module_with_path(source, source_path, borrowck_mode);
    match result {
        ResultIrModule::Err(errs) => {
            var msg: str = "Compilation error:\n";
            var i: i64 = 0;
            while i < errs.len() {
                if !str_starts_with(errs.get(i), "error") {
                    msg = msg + "error: ";
                }
                msg = msg + errs.get(i) + "\n";
                i = i + 1;
            }
            p_eprint_str(msg);
            return 1;
        }
        ResultIrModule::Ok(ir_mod2) => {
            return interpret_ir_module_with_options(ir_mod2, max_recursion, max_steps, max_memory, verbose);
        }
    }
    return 1;
}

// MI18: build_executable (the PIR path: IR -> pir.fd L1/L2/L3 -> opt.fd ->
// codegen_x64/arm64/riscv.fd assembly -> elf64/arm64_enc/riscv_enc ->
// runtime_linux/arm64/riscv.fd -> linker.fd) was removed with it on Nov 17:
// no command reached it since Nov 16 (`build --native` is the machine layer
// on every target, main.fd cmd_build).

/// Build a native Linux ELF executable using the x86.rs stack-machine backend.
/// This is the simpler backend (no PIR, no register allocation) — each SSA value
/// lives on the stack. Emits AT&T assembly -> elf64 assembler -> linker with no
/// runtime (the x86 backend includes its own runtime stubs).
/// Mirrors src/compiler.rs::build_x86_linux.
pub fn build_x86_linux(source: str, source_path: str) -> ResultBytes {
    var mod_result: ResultIrModule = lower_to_ir_module_with_path(source, source_path, "on");
    match mod_result {
        ResultIrModule::Err(errs) => {
            return ResultBytes::Err(errs);
        }
        ResultIrModule::Ok(ir_mod) => {
            // Generate AT&T assembly via the x86 backend
            var asm: str = generate_asm_x86(ir_mod);

            // Assemble to ELF64 object (module param unused — assembler only reads asm text)
            var obj_result: ResultVec = emit_object_file(0, asm);
            match obj_result {
                ResultVec::Err(e) => {
                    return ResultBytes::Err(c_vec1(e));
                }
                ResultVec::Ok(obj) => {
                    // Link with an empty runtime — the x86 backend emits its own _start + stubs
                    var objects: Vec<Vec> = Vec::new();
                    objects.push(obj);
                    var empty_text: Vec = Vec::new();
                    var empty_rodata: Vec = Vec::new();
                    var empty_syms: Vec<LinkerSymbol> = Vec::new();
                    var empty_rodata_syms: Vec<LinkerRodataSym> = Vec::new();
                    var empty_relocs: Vec<LinkerReloc> = Vec::new();
                    var link_result: LinkerResult = link_with_runtime(objects, "_start", empty_text, empty_syms, empty_rodata, empty_rodata_syms, empty_relocs);
                    if LinkerResult_is_ok(link_result) {
                        return ResultBytes::Ok(LinkerResult_bytes(link_result));
                    }
                    return ResultBytes::Err(c_vec1(LinkerResult_err_msg(link_result)));
                }
            }
        }
    }
    return ResultBytes::Err(c_vec1("unreachable"));
}

pub fn get_diagnostics(source: str, source_path: OptStr) -> Vec<StrTriple> {
    var errors: Vec<str> = check_text_errors(source, source_path);
    var diags: Vec<StrTriple> = Vec::new();
    var i: i64 = 0;
    while i < errors.len() {
        var st: StrTriple = parse_error_position(errors.get(i));
        diags.push(st);
        i = i + 1;
    }
    return diags;
}

/// The errors of an editor's text (the LSP's check): from a running
/// `fid serve --port` when FID_SERVE names its port (SP19: the server's
/// stdlib and module parses are warm, and they are shared with `fid
/// check`), else checked in this process. Both run build_program_with_path,
/// so the diagnostics are the same.
pub fn check_text_errors(source: str, source_path: OptStr) -> Vec<str> {
    var port: i64 = serve_env_port();
    if port > 0 {
        var path: str = "-";
        match source_path {
            OptStr::Some(p) => {
                path = p;
            }
            OptStr::None => {
            }
        }
        var ans: ServeAnswer = serve_client_ask(port, "check-text " + int_to_str(str_len(source)) + " " + path, source);
        if ans.ok {
            return ans.errors;
        }
    }
    // CB2: a long-lived checker (the LSP: modcache_enable) checks again
    // only what an edit since its last clean check can reach
    if g_modcache_on {
        cb2_request(true);
        var inc_errs: Vec<str> = check_text_errors_here(source, source_path);
        cb2_request(false);
        return inc_errs;
    }
    return check_text_errors_here(source, source_path);
}

/// check_text_errors in this process (also what `fid serve` runs for a
/// `check-text` request).
pub fn check_text_errors_here(source: str, source_path: OptStr) -> Vec<str> {
    match build_program_with_path(source, source_path) {
        ResultProgram::Ok(_) => {
            return Vec::new();
        }
        ResultProgram::Err(errors) => {
            return errors;
        }
    }
    return Vec::new();
}

// --- SP19: the client side of `fid serve --port <n>` -------------------------
// A server on this machine listens on a TCP port and writes a random key to
// <home>/.fid/serve-<port>.key; a client (`fid check`, the LSP) connects to
// 127.0.0.1, sends `key <key>`, one request line (and, for check-text, the
// text), and reads the answer up to `done <status>`: `e <error>` lines (the
// error text with `\` and line ends escaped, so an error of several lines is
// one line) and `o <note>` lines. No server, or a wrong key: ok is false,
// and the caller does the work itself.

pub struct ServeAnswer {
    pub ok: bool,
    pub status: i64,
    pub errors: Vec<str>,
    pub notes: Vec<str>,
}

fn serve_answer_none() -> ServeAnswer {
    var errors: Vec<str> = Vec::new();
    var notes: Vec<str> = Vec::new();
    return ServeAnswer {
        ok: false, status: 0, errors: errors, notes: notes
    };
}

/// The directory of the server's key files: <home>/.fid (a user's own).
pub fn serve_key_dir() -> str {
    var home: str = env_or_empty("USERPROFILE");
    if str_len(home) == 0 {
        home = env_or_empty("HOME");
    }
    if str_len(home) == 0 {
        home = ".";
    }
    return home + "/.fid";
}

pub fn serve_key_path(port: i64) -> str {
    return serve_key_dir() + "/serve-" + int_to_str(port) + ".key";
}

/// FID_SERVE=<port>: the port of a running `fid serve --port`; 0 when it
/// is unset, and always in the server itself (it never asks itself).
pub fn serve_env_port() -> i64 {
    if g_serve_mode {
        return 0;
    }
    var v: str = env_or_empty("FID_SERVE");
    if str_len(v) == 0 {
        return 0;
    }
    return c_str_parse_i64(v);
}

/// An error's text as one protocol line: `\` -> `\\`, LF -> `\n`, CR -> `\r`.
pub fn serve_escape(s: str) -> str {
    return str_replace(str_replace(str_replace(s, "\\", "\\\\"), "\n", "\\n"), "\r", "\\r");
}

pub fn serve_unescape(s: str) -> str {
    if str_find(s, "\\") < 0 {
        return s;
    }
    var bytes: Vec<i64> = Vec::new();
    var n: i64 = str_len(s);
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(s, i);
        if c == 92 && i + 1 < n {
            var d: i64 = str_byte_at(s, i + 1);
            if d == 110 {
                bytes.push(10);
            } else if d == 114 {
                bytes.push(13);
            } else {
                bytes.push(d);
            }
            i = i + 2;
        } else {
            bytes.push(c);
            i = i + 1;
        }
    }
    return str_from_bytes(bytes);
}

/// Write all of `data` to a socket (a send may take only part of it).
pub fn serve_send_all(fd: i64, data: str) -> bool {
    var rest: str = data;
    while str_len(rest) > 0 {
        var sent: i64 = p_socket_write_str(fd, rest);
        if sent <= 0 {
            return false;
        }
        if sent >= str_len(rest) {
            return true;
        }
        rest = str_slice(rest, sent, str_len(rest));
    }
    return true;
}

/// Does `buf` end with a whole `done <status>` line?
fn serve_answer_complete(buf: str) -> bool {
    if !str_ends_with(buf, "\n") {
        return false;
    }
    var body: str = str_slice(buf, 0, str_len(buf) - 1);
    var last_nl: i64 = -1;
    var i: i64 = str_len(body) - 1;
    while i >= 0 && last_nl < 0 {
        if str_byte_at(body, i) == 10 {
            last_nl = i;
        }
        i = i - 1;
    }
    return str_starts_with(str_slice(body, last_nl + 1, str_len(body)), "done ");
}

/// One request to the `fid serve --port <port>` of this machine: the key,
/// `request` as a line, then `body` (check-text's text; "" for none).
pub fn serve_client_ask(port: i64, request: str, body: str) -> ServeAnswer {
    var ans: ServeAnswer = serve_answer_none();
    var key: str = str_trim(c_file_read(serve_key_path(port)));
    if str_len(key) == 0 {
        return ans;
    }
    var fd: i64 = p_net_connect("127.0.0.1", port);
    if fd < 0 {
        return ans;
    }
    if !serve_send_all(fd, "key " + key + "\n" + request + "\n" + body) {
        p_socket_close(fd);
        return ans;
    }
    var buf: str = "";
    var reading: bool = true;
    while reading {
        var chunk: str = p_socket_recv_str(fd);
        if str_len(chunk) == 0 {
            reading = false;
        } else {
            buf = buf + chunk;
            if serve_answer_complete(buf) {
                reading = false;
            }
        }
    }
    serve_send_all(fd, "quit\n");
    p_socket_close(fd);
    if !serve_answer_complete(buf) {
        // the server went away (or refused the key) before answering
        return ans;
    }
    var errors: Vec<str> = Vec::new();
    var notes: Vec<str> = Vec::new();
    var status: i64 = 0;
    var got: bool = false;
    var lines: Vec<str> = str_split(buf, "\n");
    var li: i64 = 0;
    while li < lines.len() {
        var l: str = lines.get(li);
        if str_starts_with(l, "e ") {
            errors.push(serve_unescape(str_slice(l, 2, str_len(l))));
        } else if str_starts_with(l, "o ") {
            notes.push(serve_unescape(str_slice(l, 2, str_len(l))));
        } else if str_starts_with(l, "done ") {
            status = c_str_parse_i64(str_trim(str_slice(l, 5, str_len(l))));
            got = true;
        }
        li = li + 1;
    }
    return ServeAnswer {
        ok: got, status: status, errors: errors, notes: notes
    };
}

// ===========================================================================
// merge_programs -- merge stdlib and user programs (user wins on conflicts)
// ===========================================================================

/// Merge two programs: user definitions take priority over stdlib.
/// Report functions defined twice within one module (platform
/// alternatives selected by @cfg are filtered later and are skipped).
/// Items defined by two modules used to collapse silently into one (src/compiler.rs
/// find_module_conflicts): functions and consts conflict on name alone, structs
/// when their fields differ. Enums and core's own names follow the Rust check.
/// CL7: two imported libraries that implement the same trait for the same
/// type. The program's own impl of that (trait, type) wins over both
/// (merge_programs), so the pair is reported only when the program has none:
/// otherwise the one merged later won silently.
fn cc_find_trait_impl_conflicts(imported: Vec<Program>, names: Vec<str>, user: Program, errors: &mut Vec<str>) {
    var user_pairs: i64 = HashMap_new();
    var ui: i64 = 0;
    while ui < user.trait_impls.len() {
        HashMap_insert(user_pairs, user.trait_impls.get(ui).trait_name + " for " + user.trait_impls.get(ui).type_name, 1);
        ui = ui + 1;
    }
    // "Trait for Type" -> 1 + index of the module that implements it first
    var seen: i64 = HashMap_new();
    var mi: i64 = 0;
    while mi < imported.len() {
        var prog: Program = imported.get(mi);
        var ti: i64 = 0;
        while ti < prog.trait_impls.len() {
            var key: str = prog.trait_impls.get(ti).trait_name + " for " + prog.trait_impls.get(ti).type_name;
            if HashMap_get(user_pairs, key) == 0 {
                var first: i64 = HashMap_get(seen, key);
                if first == 0 {
                    HashMap_insert(seen, key, mi + 1);
                } else if first - 1 != mi {
                    errors.push("Type error: conflicting implementations of `impl " + key + "`: both module '" + names.get(first - 1) + "' and module '" + names.get(mi) + "' define it.\n    Fix: implement `" + key + "` in your own program (it then replaces both), or import only one of the two modules.");
                }
            }
            ti = ti + 1;
        }
        mi = mi + 1;
    }
    HashMap_drop(seen);
    HashMap_drop(user_pairs);
}

fn cc_find_module_conflicts(stdlib: Program, imported: Vec<Program>, names: Vec<str>, user: Program, user_name: str, errors: &mut Vec<str>) {
    // name -> index+1 into func_mods_of/struct_mods_of/struct_shapes_of:
    // the modules (and shapes) a name was already defined in. A linear
    // Vec scan here was O(total decls) per decl — quadratic when a
    // program imports modules that define thousands of functions.
    var func_ix: i64 = HashMap_new();
    var func_mods_of: Vec<Vec<str>> = Vec::new();
    var struct_ix: i64 = HashMap_new();
    var struct_mods_of: Vec<Vec<str>> = Vec::new();
    var struct_shapes_of: Vec<Vec<str>> = Vec::new();
    var core_structs: i64 = HashMap_new();
    var c0: i64 = 0;
    while c0 < stdlib.structs.len() {
        HashMap_insert(core_structs, stdlib.structs.get(c0).name, 1);
        c0 = c0 + 1;
    }
    var mi: i64 = 0;
    while mi <= imported.len() {
        var prog: Program = user;
        var module: str = user_name;
        if mi < imported.len() {
            prog = imported.get(mi);
            module = names.get(mi);
        }
        var fi: i64 = 0;
        while fi < prog.funcs.len() {
            var f: Func = prog.funcs.get(fi);
            var is_cfg: bool = false;
            var ai: i64 = 0;
            while ai < f.annotations.len() {
                if f.annotations.get(ai).name == "cfg" {
                    is_cfg = true;
                }
                ai = ai + 1;
            }
            if !is_cfg {
                var fix: i64 = HashMap_get(func_ix, f.name);
                if fix > 0 {
                    var mods: Vec<str> = func_mods_of.get(fix - 1);
                    var k: i64 = 0;
                    while k < mods.len() {
                        if mods.get(k) != module {
                            errors.push("Duplicate definition: function '" + f.name + "' is defined in both module '" + mods.get(k) + "' and module '" + module + "'\n    Fix: rename one of them (a module's functions share one namespace with every module the program uses)");
                        }
                        k = k + 1;
                    }
                }
                // The user's program may shadow an imported function
                if mi < imported.len() {
                    if fix == 0 {
                        var nm: Vec<str> = Vec::new();
                        nm.push(module);
                        func_mods_of.push(nm);
                        HashMap_insert(func_ix, f.name, func_mods_of.len());
                    } else {
                        var mods2: Vec<str> = func_mods_of.get(fix - 1);
                        if !cc_c_str_vec_contains(mods2, module) {
                            mods2.push(module);
                            func_mods_of.set(fix - 1, mods2);
                        }
                    }
                }
            }
            fi = fi + 1;
        }
        var si: i64 = 0;
        while si < prog.structs.len() {
            var s: StructDef = prog.structs.get(si);
            var shape: str = "";
            var fj: i64 = 0;
            while fj < s.fields.len() {
                shape = shape + s.fields.get(fj).name + ",";
                fj = fj + 1;
            }
            if mi < imported.len() {
                if HashMap_get(core_structs, s.name) != 0 {
                    errors.push("Duplicate definition: type '" + s.name + "' is defined in both module 'core' and module '" + module + "'\n    Fix: give this type another name: core's '" + s.name + "' is in every program");
                }
            }
            var six: i64 = HashMap_get(struct_ix, s.name);
            if six > 0 {
                var smods: Vec<str> = struct_mods_of.get(six - 1);
                var sshapes: Vec<str> = struct_shapes_of.get(six - 1);
                var k: i64 = 0;
                while k < smods.len() {
                    if smods.get(k) != module && sshapes.get(k) != shape {
                        errors.push("Duplicate definition: type '" + s.name + "' is defined differently in module '" + smods.get(k) + "' and module '" + module + "'\n    Fix: rename one of them, or define the type once in a module both `use`");
                    }
                    k = k + 1;
                }
            }
            if six == 0 {
                var nm2: Vec<str> = Vec::new();
                nm2.push(module);
                struct_mods_of.push(nm2);
                var sh2: Vec<str> = Vec::new();
                sh2.push(shape);
                struct_shapes_of.push(sh2);
                HashMap_insert(struct_ix, s.name, struct_mods_of.len());
            } else {
                var smods2: Vec<str> = struct_mods_of.get(six - 1);
                var sshapes2: Vec<str> = struct_shapes_of.get(six - 1);
                smods2.push(module);
                sshapes2.push(shape);
                struct_mods_of.set(six - 1, smods2);
                struct_shapes_of.set(six - 1, sshapes2);
            }
            si = si + 1;
        }
        mi = mi + 1;
    }
    HashMap_drop(func_ix);
    HashMap_drop(struct_ix);
    HashMap_drop(core_structs);
}

fn cc_find_duplicate_funcs(prog: Program, module: str, errors: &mut Vec<str>) {
    var seen: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < prog.funcs.len() {
        var f: Func = prog.funcs.get(fi);
        var is_cfg: bool = false;
        var ai: i64 = 0;
        while ai < f.annotations.len() {
            if f.annotations.get(ai).name == "cfg" {
                is_cfg = true;
            }
            ai = ai + 1;
        }
        if !is_cfg {
            if HashMap_get(seen, f.name) != 0 {
                errors.push("Duplicate definition: function '" + f.name + "' is defined twice in module '" + module + "'\n    Fix: remove one definition or rename it");
            } else {
                HashMap_insert(seen, f.name, 1);
            }
        }
        fi = fi + 1;
    }
    HashMap_drop(seen);
}

pub fn merge_programs(stdlib: Program, user: Program) -> Program {
    // Build sets of user-defined names for conflict detection (HashMap
    // sets: a linear Vec scan here is O(stdlib x user), quadratic on
    // programs with tens of thousands of declarations).
    var user_funcs: i64 = HashMap_new();
    var i: i64 = 0;
    while i < user.funcs.len() {
        HashMap_insert(user_funcs, user.funcs.get(i).name, 1);
        i = i + 1;
    }
    var user_structs: i64 = HashMap_new();
    i = 0;
    while i < user.structs.len() {
        HashMap_insert(user_structs, user.structs.get(i).name, 1);
        i = i + 1;
    }
    var user_enums: i64 = HashMap_new();
    i = 0;
    while i < user.enums.len() {
        HashMap_insert(user_enums, user.enums.get(i).name, 1);
        i = i + 1;
    }
    var user_consts: i64 = HashMap_new();
    i = 0;
    while i < user.consts.len() {
        HashMap_insert(user_consts, user.consts.get(i).name, 1);
        i = i + 1;
    }
    var user_globals: i64 = HashMap_new();
    i = 0;
    while i < user.globals.len() {
        HashMap_insert(user_globals, user.globals.get(i).name, 1);
        i = i + 1;
    }
    var user_aliases: i64 = HashMap_new();
    i = 0;
    while i < user.type_aliases.len() {
        HashMap_insert(user_aliases, user.type_aliases.get(i).name, 1);
        i = i + 1;
    }

    // Start with user program as the base
    var merged: Program = user;

    // Add stdlib items that don't conflict with user definitions
    i = 0;
    while i < stdlib.funcs.len() {
        if HashMap_get(user_funcs, stdlib.funcs.get(i).name) == 0 {
            merged.funcs.push(stdlib.funcs.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < stdlib.structs.len() {
        if HashMap_get(user_structs, stdlib.structs.get(i).name) == 0 {
            merged.structs.push(stdlib.structs.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < stdlib.enums.len() {
        if HashMap_get(user_enums, stdlib.enums.get(i).name) == 0 {
            merged.enums.push(stdlib.enums.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < stdlib.consts.len() {
        if HashMap_get(user_consts, stdlib.consts.get(i).name) == 0 {
            merged.consts.push(stdlib.consts.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < stdlib.globals.len() {
        if HashMap_get(user_globals, stdlib.globals.get(i).name) == 0 {
            merged.globals.push(stdlib.globals.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < stdlib.type_aliases.len() {
        if HashMap_get(user_aliases, stdlib.type_aliases.get(i).name) == 0 {
            merged.type_aliases.push(stdlib.type_aliases.get(i));
        }
        i = i + 1;
    }
    // Merge impls (skip if user has impl for same struct). The user's impl
    // names are taken first: merged.impls is user.impls, so a pushed impl
    // would otherwise hide a second impl block of the same struct.
    var user_impl_structs: i64 = HashMap_new();
    i = 0;
    while i < user.impls.len() {
        // L8H: a narrower impl (`impl Wrap<i64>`) is no replacement of the
        // other program's generic `impl<T> Wrap<T>`: both are kept
        if !pd_impl_is_narrowed(user.impls.get(i)) {
            HashMap_insert(user_impl_structs, user.impls.get(i).struct_name, 1);
        }
        i = i + 1;
    }
    i = 0;
    while i < stdlib.impls.len() {
        if HashMap_get(user_impl_structs, stdlib.impls.get(i).struct_name) == 0 {
            merged.impls.push(stdlib.impls.get(i));
        }
        i = i + 1;
    }
    // Merge traits (user wins on name conflicts)
    var user_traits: i64 = HashMap_new();
    i = 0;
    while i < user.traits.len() {
        HashMap_insert(user_traits, user.traits.get(i).name, 1);
        i = i + 1;
    }
    i = 0;
    while i < stdlib.traits.len() {
        if HashMap_get(user_traits, stdlib.traits.get(i).name) == 0 {
            merged.traits.push(stdlib.traits.get(i));
        }
        i = i + 1;
    }
    // Merge trait impls (user wins on (trait, type) conflicts)
    var user_tis: i64 = HashMap_new();
    i = 0;
    while i < user.trait_impls.len() {
        HashMap_insert(user_tis, user.trait_impls.get(i).trait_name + " for " + user.trait_impls.get(i).type_name, 1);
        i = i + 1;
    }
    i = 0;
    while i < stdlib.trait_impls.len() {
        if HashMap_get(user_tis, stdlib.trait_impls.get(i).trait_name + " for " + stdlib.trait_impls.get(i).type_name) == 0 {
            merged.trait_impls.push(stdlib.trait_impls.get(i));
        }
        i = i + 1;
    }
    // Merge extern_decls (user wins on conflicts by pledge_name)
    var user_exts: i64 = HashMap_new();
    i = 0;
    while i < user.extern_decls.len() {
        HashMap_insert(user_exts, user.extern_decls.get(i).pledge_name, 1);
        i = i + 1;
    }
    i = 0;
    while i < stdlib.extern_decls.len() {
        if HashMap_get(user_exts, stdlib.extern_decls.get(i).pledge_name) == 0 {
            merged.extern_decls.push(stdlib.extern_decls.get(i));
        }
        i = i + 1;
    }

    HashMap_drop(user_funcs);
    HashMap_drop(user_structs);
    HashMap_drop(user_enums);
    HashMap_drop(user_consts);
    HashMap_drop(user_globals);
    HashMap_drop(user_aliases);
    HashMap_drop(user_impl_structs);
    HashMap_drop(user_traits);
    HashMap_drop(user_tis);
    HashMap_drop(user_exts);
    return merged;
}

// ===========================================================================
// apply_cfg_filter -- conditional compilation (@cfg)
// ===========================================================================

/// The target of a cross build: "" = the host. `fid ccompile --target`
/// sets them (os: linux, macos, windows; arch: x86_64, aarch64, riscv64).
pub var g_cfg_os: str = "";
/// `--debug` on the command line: `@cfg(debug)` holds (known-bugs 2g.14:
/// check_cfg was always given false)
pub var g_cfg_debug: bool = false;
pub var g_cfg_arch: str = "";
/// Does `@cfg(arch)` name the target's architecture? (x86_64 on the host.)
fn cfg_arch_is(name: str) -> bool {
    var want: str = name;
    if want == "arm64" {
        want = "aarch64";
    }
    if want == "riscv" {
        want = "riscv64";
    }
    var arch: str = g_cfg_arch;
    if arch == "" {
        arch = "x86_64";
    }
    return want == arch;
}

/// rm-L5A-dep-features: the features ark turned on for the project in
/// `base_dir`, "\n" + each name + "\n" ("" when none): the `[...]` lists of
/// ark_modules/.features (and, for `fid test`, ark_modules/.dev/.features),
/// at the project root and at its workspace root.
pub var g_cfg_features: str = "";

/// PL3: whether the build's system is FreeBSD (set by apply_cfg_filter from
/// the target, or the host when there is none; read by check_cfg).
pub var g_cfg_now_freebsd: bool = false;

/// PL3: does an OS condition hold? `linux`, `windows`, `macos`, `freebsd`,
/// `wasi`; `unix` is Linux, macOS or FreeBSD. 0 = holds, 1 = does not,
/// 2 = not an OS name (the caller decides).
fn cfg_os_cond(name: str, is_linux: bool, is_windows: bool, is_macos: bool) -> i64 {
    var holds: bool = false;
    if name == "linux" {
        holds = is_linux;
    } else if name == "windows" {
        holds = is_windows;
    } else if name == "macos" || name == "darwin" {
        holds = is_macos;
    } else if name == "freebsd" {
        holds = g_cfg_now_freebsd;
    } else if name == "unix" {
        holds = is_linux || is_macos || g_cfg_now_freebsd;
    } else if name == "wasi" {
        holds = g_cfg_os == "wasi";
    } else {
        return 2;
    }
    if holds {
        return 0;
    }
    return 1;
}

fn cfg_features_file(path: str, acc: str) -> str {
    if !c_file_exists(path) {
        return acc;
    }
    var out: str = acc;
    val lines: Vec<str> = c_str_lines(c_file_read(path));
    var i: i64 = 0;
    while i < lines.len() {
        val line: str = str_trim(lines.get(i));
        val open: i64 = str_find(line, "[");
        val close: i64 = str_find(line, "]");
        if !str_starts_with(line, "#") && open >= 0 && close > open {
            val items: Vec<str> = str_split(c_str_substr(line, open + 1, close), ",");
            var j: i64 = 0;
            while j < items.len() {
                val name: str = c_str_trim_quotes(str_trim(items.get(j)));
                if str_len(name) > 0 && !str_contains(out, "\n" + name + "\n") {
                    if str_len(out) == 0 {
                        out = "\n";
                    }
                    out = out + name + "\n";
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

fn cfg_ark_features_at(root: str, acc: str) -> str {
    var out: str = cfg_features_file(c_path_join(root, "ark_modules/.features"), acc);
    if ark_dev_visible() {
        out = cfg_features_file(c_path_join(root, "ark_modules/.dev/.features"), out);
    }
    return out;
}

pub fn cfg_ark_features(base_dir: str) -> str {
    val root: str = ark_project_root(base_dir);
    if str_len(root) == 0 {
        return "";
    }
    var out: str = cfg_ark_features_at(root, "");
    val ws: str = ark_workspace_root_of(root);
    if str_len(ws) > 0 {
        out = cfg_ark_features_at(ws, out);
    }
    return out;
}

/// Set comptime's view of the build's target (§4.11): the same flags
/// @cfg reads — the target a --target named, the host otherwise — as
/// values `comptime target_os()` & co. give. One derivation with
/// apply_cfg_filter's, kept beside it.
fn ct_sync_target() {
    var os: str = g_cfg_os;
    if str_len(os) == 0 {
        var is_windows: bool = p_getenv("OS") == "Windows_NT";
        var is_linux: bool = !is_windows && c_file_exists("/proc/self/exe");
        var is_freebsd: bool = !is_windows && !is_linux && c_file_exists("/bin/freebsd-version");
        var is_macos: bool = !is_windows && !is_linux && !is_freebsd;
        if is_windows {
            os = "windows";
        } else if is_macos {
            os = "macos";
        } else if is_freebsd {
            os = "freebsd";
        } else {
            os = "linux";
        }
    }
    g_ct_target_os = os;
    var arch: str = g_cfg_arch;
    if str_len(arch) == 0 {
        arch = "x86_64";
    }
    g_ct_target_arch = arch;
    g_ct_debug = g_cfg_debug;
    g_ct_features = g_cfg_features;
}

/// Conditional compilation (release K10, as src/compiler.rs apply_cfg_filter):
/// a function or struct whose @cfg names another platform, architecture or
/// build mode is left out. Lists are rebuilt with plain pushes (the old
/// Vec-of-struct copy problem that made this a no-op is long fixed).
pub fn apply_cfg_filter(program: &mut Program) {
    var is_windows: bool = p_getenv("OS") == "Windows_NT";
    var is_linux: bool = !is_windows && c_file_exists("/proc/self/exe");
    // PL3: a FreeBSD host has no /proc by default but has freebsd-version
    var is_freebsd: bool = !is_windows && !is_linux && c_file_exists("/bin/freebsd-version");
    var is_macos: bool = !is_windows && !is_linux && !is_freebsd;
    // A cross build (`ccompile --target`, release F5/F8) decides by the target
    if g_cfg_os != "" {
        is_windows = g_cfg_os == "windows";
        is_linux = g_cfg_os == "linux";
        is_macos = g_cfg_os == "macos";
        is_freebsd = g_cfg_os == "freebsd";
    }
    g_cfg_now_freebsd = is_freebsd;
    var any: bool = false;
    var i: i64 = 0;
    while i < program.funcs.len() && !any {
        if !check_cfg(program.funcs.get(i).annotations, is_linux, is_windows, is_macos, g_cfg_debug) {
            any = true;
        }
        i = i + 1;
    }
    i = 0;
    while i < program.structs.len() && !any {
        if !check_cfg(program.structs.get(i).annotations, is_linux, is_windows, is_macos, g_cfg_debug) {
            any = true;
        }
        i = i + 1;
    }
    if !any {
        return;
    }
    var funcs: Vec<Func> = Vec::new();
    i = 0;
    while i < program.funcs.len() {
        if check_cfg(program.funcs.get(i).annotations, is_linux, is_windows, is_macos, g_cfg_debug) {
            funcs.push(program.funcs.get(i));
        }
        i = i + 1;
    }
    program.funcs = funcs;
    var structs: Vec<StructDef> = Vec::new();
    i = 0;
    while i < program.structs.len() {
        if check_cfg(program.structs.get(i).annotations, is_linux, is_windows, is_macos, g_cfg_debug) {
            structs.push(program.structs.get(i));
        }
        i = i + 1;
    }
    program.structs = structs;
}

/// Whether an item's @cfg annotations hold for this build. fid runs on
/// x86-64 hosts only, so the architecture is x86-64.
fn check_cfg(annotations: Vec<Annotation>, is_linux: bool, is_windows: bool, is_macos: bool, is_debug: bool) -> bool {
    var i: i64 = 0;
    while i < annotations.len() {
        if annotations.get(i).name == "cfg" {
            var args: Vec<str> = annotations.get(i).args;
            var j: i64 = 0;
            while j < args.len() {
                var arg: str = str_trim(args.get(j));
                var eq_pos: i64 = str_find(arg, "=");
                var include: bool = true;
                if eq_pos >= 0 {
                    var key: str = str_trim(c_str_substr(arg, 0, eq_pos));
                    var val: str = c_str_trim_quotes(str_trim(c_str_substr(arg, eq_pos + 1, str_len(arg))));
                    if key == "platform" || key == "os" || key == "target_os" {
                        val os_c: i64 = cfg_os_cond(val, is_linux, is_windows, is_macos);
                        if os_c != 2 {
                            include = os_c == 0;
                        }
                    }
                    if key == "target_arch" || key == "arch" {
                        include = cfg_arch_is(val);
                    }
                    // rm-L5A-dep-features: a feature ark turned on
                    if key == "feature" {
                        include = str_contains(g_cfg_features, "\n" + val + "\n");
                    }
                } else {
                    if arg == "debug" {
                        include = is_debug;
                    }
                    if arg == "release" {
                        include = !is_debug;
                    }
                    val os_b: i64 = cfg_os_cond(arg, is_linux, is_windows, is_macos);
                    if os_b != 2 {
                        include = os_b == 0;
                    }
                    if arg == "x86_64" || arg == "aarch64" || arg == "arm64" || arg == "riscv64" || arg == "riscv" {
                        include = cfg_arch_is(arg);
                    }
                }
                if !include {
                    return false;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return true;
}

// ===========================================================================
// SL13: block coverage for `fid test --fuzz` (`ccompile --fuzz-cov`)
// ===========================================================================

/// `ccompile --fuzz-cov`, which `fid test --fuzz` passes for its harness
/// (main.fd fz_harness_lib): every block of the program's own functions
/// starts with `__fz_hit(<k>)`, k a number per block (a function's body,
/// each branch of an `if` (an `if` without `else` gets one), each loop
/// body, each `match` arm), so the harness's fuzz loop sees which blocks
/// an input reached and keeps the inputs that reach new ones. Only a
/// program that defines `__fz_hit` is changed. Core, the runtime and the
/// stdlib modules are left alone unless `--fuzz-cov-std` is given too;
/// functions with declared effects, `comptime`, `@interrupt` or a safety
/// annotation, and sandbox/txn/parallel/defer/region blocks are left as
/// written (their rules would reject the call).
pub var g_fuzz_cov: bool = false;
pub var g_fuzz_cov_std: bool = false;
var g_fuzz_cov_sites: i64 = 0;

pub fn set_fuzz_cov(on: bool, std_too: bool) {
    g_fuzz_cov = on;
    g_fuzz_cov_std = std_too;
    g_fuzz_cov_sites = 0;
}

/// How many blocks the last instrumented build numbered.
pub fn fuzz_cov_sites() -> i64 {
    return g_fuzz_cov_sites;
}

fn fzc_hit(line: i64) -> Stmt {
    g_fuzz_cov_sites = g_fuzz_cov_sites + 1;
    var args: Vec<Expr> = Vec::new();
    args.push(Expr::IntLit(g_fuzz_cov_sites));
    return Stmt::Expr(Expr::Call("__fz_hit", args), line);
}

/// The statements of `body`, instrumented, after a hit of their own
fn fzc_block(body: Vec<Stmt>, line: i64) -> Vec<Stmt> {
    var at: i64 = line;
    if body.len() > 0 && stmt_line(body.get(0)) > 0 {
        at = stmt_line(body.get(0));
    }
    var out: Vec<Stmt> = Vec::new();
    out.push(fzc_hit(at));
    var i: i64 = 0;
    while i < body.len() {
        out.push(fzc_stmt(body.get(i)));
        i = i + 1;
    }
    return out;
}

/// The statements of `body`, instrumented, with no hit of their own
fn fzc_stmts(body: Vec<Stmt>) -> Vec<Stmt> {
    var out: Vec<Stmt> = Vec::new();
    var i: i64 = 0;
    while i < body.len() {
        out.push(fzc_stmt(body.get(i)));
        i = i + 1;
    }
    return out;
}

fn fzc_stmt(stmt: Stmt) -> Stmt {
    match stmt {
        Stmt::If(cond, then_block, else_block, line) => {
            var new_then: Vec<Stmt> = fzc_block(then_block, line);
            match else_block {
                OptStmts::Some(eb) => {
                    return Stmt::If(cond, new_then, OptStmts::Some(fzc_block(eb, line)), line);
                }
                OptStmts::None => {
                }
            }
            // the branch not taken is a block of its own
            var no_else: Vec<Stmt> = Vec::new();
            return Stmt::If(cond, new_then, OptStmts::Some(fzc_block(no_else, line)), line);
        }
        Stmt::While(cond, body, line) => {
            return Stmt::While(cond, fzc_block(body, line), line);
        }
        Stmt::For(var_name, iterator, body, line) => {
            return Stmt::For(var_name, iterator, fzc_block(body, line), line);
        }
        Stmt::Loop(body, line) => {
            return Stmt::Loop(fzc_block(body, line), line);
        }
        Stmt::Match(scrut, arms, line) => {
            var new_arms: Vec<MatchArm> = Vec::new();
            var ai: i64 = 0;
            while ai < arms.len() {
                var arm: MatchArm = arms.get(ai);
                new_arms.push(MatchArm_new(arm.pattern, arm.guard, fzc_block(arm.body, line)));
                ai = ai + 1;
            }
            return Stmt::Match(scrut, new_arms, line);
        }
        Stmt::Unsafe(body, line) => {
            return Stmt::Unsafe(fzc_stmts(body), line);
        }
        other => {
            return other;
        }
    }
    return stmt;
}

/// Is `f` one the pass may change? Not the harness's own functions, not one
/// whose declared effects, kind or annotations an extra call could break.
fn fzc_func_wanted(f: Func) -> bool {
    if f.body.len() == 0 || f.is_comptime || f.is_interrupt || f.has_effect_annotation {
        return false;
    }
    if f.name == "main" || str_starts_with(f.name, "_fz") || str_starts_with(f.name, "__fz") || str_starts_with(f.name, "_fuzz_") {
        return false;
    }
    var i: i64 = 0;
    while i < f.annotations.len() {
        val an: str = f.annotations.get(i).name;
        if an != "cfg" && an != "inline" && an != "cold" && an != "deprecated" && an != "test" && an != "doc" {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn fzc_func(f: Func) -> Func {
    var g: Func = f;
    if fzc_func_wanted(f) {
        var line: i64 = 0;
        if f.body.len() > 0 {
            line = stmt_line(f.body.get(0));
        }
        g.body = fzc_block(f.body, line);
    }
    return g;
}

/// Instrument every function and method of `program` (fzc_func_wanted).
/// 2g.83: the lists are refilled in place, not replaced, as parser.fd
/// pd_cross_module_specializations does: the user program is
/// build_program_with_path_borrowck's match binding of the parse result,
/// and a compiler built by a lowering from before the match-binding fix
/// dropped a replaced list the parse result still held, then dropped it
/// again with the result ("Double free" in Vec_drop_inplace from
/// __own_drop_100 there, under `ccompile --fuzz-cov`).
pub fn fuzz_cov_program(program: &mut Program) {
    var funcs: Vec<Func> = Vec::new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        funcs.push(fzc_func(program.funcs.get(i)));
        i = i + 1;
    }
    fzc_refill_funcs(&mut program.funcs, funcs);
    var impls: Vec<ImplDef> = Vec::new();
    i = 0;
    while i < program.impls.len() {
        var im: ImplDef = program.impls.get(i);
        var methods: Vec<Func> = Vec::new();
        var j: i64 = 0;
        while j < im.methods.len() {
            methods.push(fzc_func(im.methods.get(j)));
            j = j + 1;
        }
        im.methods = methods;
        impls.push(im);
        i = i + 1;
    }
    fzc_refill_impls(&mut program.impls, impls);
}

fn fzc_refill_funcs(dst: &mut Vec<Func>, src: Vec<Func>) {
    dst.clear();
    var i: i64 = 0;
    while i < src.len() {
        dst.push(src.get(i));
        i = i + 1;
    }
}

fn fzc_refill_impls(dst: &mut Vec<ImplDef>, src: Vec<ImplDef>) {
    dst.clear();
    var i: i64 = 0;
    while i < src.len() {
        dst.push(src.get(i));
        i = i + 1;
    }
}

/// Does `program` define the harness's `__fz_hit`?
pub fn fzc_has_hook(program: Program) -> bool {
    var i: i64 = 0;
    while i < program.funcs.len() {
        if program.funcs.get(i).name == "__fz_hit" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Is the imported module `name` instrumented? One loaded from the
/// stdlib only with --fuzz-cov-std; a C header import never.
fn fzc_module_wanted(name: str) -> bool {
    val file: str = module_file_of(name);
    if str_len(file) == 0 || str_ends_with(file, ".h") || str_ends_with(file, ".hpp") {
        return false;
    }
    if g_fuzz_cov_std {
        return true;
    }
    val sd: str = str_replace(stdlib_dir(), "\\", "/");
    val fp: str = str_replace(file, "\\", "/");
    return !(str_len(sd) > 0 && str_starts_with(fp, sd));
}

// ===========================================================================
// process_derive -- generate methods from @derive annotations
// ===========================================================================

/// Process @derive annotations -- generate methods based on the derive list.
/// Supported derives: Debug, Clone, Serialize, Default, Deserialize, PartialEq
// R1.2: `==` / `!=` on enum values compare tag and payload. For every
// non-generic enum, synthesize `__eq_<Enum>(__eq_a, __eq_b) -> bool` (a match
// on both values; payload fields compared with `==`, so strings compare by
// content and nested enums recursively), and the lowerer turns `==` on enum
// operands into a call. Mirrors synthesize_enum_eq in src/compiler.rs.
fn enum_eq_pattern(enum_name: str, variant: str, prefix: str, n: i64) -> Pattern {
    var binds: Vec<Binding> = Vec::new();
    var i: i64 = 0;
    while i < n {
        binds.push(Binding_new(prefix + int_to_str(i), ""));
        i = i + 1;
    }
    return Pattern::EnumVariant(enum_name, variant, binds);
}

pub fn synthesize_enum_eq(program: &mut Program) {
    var generated: Vec<Func> = Vec::new();
    // name set of the existing functions: a Vec scan per enum was
    // O(enums x funcs)
    var fnames: i64 = HashMap_new();
    var nfi: i64 = 0;
    while nfi < program.funcs.len() {
        HashMap_insert(fnames, program.funcs.get(nfi).name, 1);
        nfi = nfi + 1;
    }
    var ei: i64 = 0;
    while ei < program.enums.len() {
        var e: EnumDef = program.enums.get(ei);
        ei = ei + 1;
        if e.type_params.len() > 0 {
            continue;
        }
        var fname: str = "__eq_" + e.name;
        if HashMap_get(fnames, fname) != 0 {
            continue;
        }

        var arms: Vec<MatchArm> = Vec::new();
        var vi: i64 = 0;
        while vi < e.variants.len() {
            var v: EnumVariant = e.variants.get(vi);
            var n: i64 = 0;
            match v.data {
                OptParams::Some(ps) => {
                    n = ps.len();
                }
                OptParams::None => {
                }
            }
            var same: Expr = Expr::BoolLit(true);
            var i: i64 = 0;
            while i < n {
                var field_eq: Expr = Expr::Binary(BinOp::Eq, Box::new(Expr::Ident("__a" + int_to_str(i))), Box::new(Expr::Ident("__b" + int_to_str(i))));
                if i == 0 {
                    same = field_eq;
                } else {
                    same = Expr::Binary(BinOp::And, Box::new(same), Box::new(field_eq));
                }
                i = i + 1;
            }
            var same_body: Vec<Stmt> = Vec::new();
            same_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(same)), 0));
            var differ_body: Vec<Stmt> = Vec::new();
            differ_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::BoolLit(false))), 0));
            var inner_arms: Vec<MatchArm> = Vec::new();
            inner_arms.push(MatchArm_new(enum_eq_pattern(e.name, v.name, "__b", n), OptBoxExpr::None, same_body));
            inner_arms.push(MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, differ_body));
            var outer_body: Vec<Stmt> = Vec::new();
            outer_body.push(Stmt::Match(Expr::Ident("__eq_b"), inner_arms, 0));
            arms.push(MatchArm_new(enum_eq_pattern(e.name, v.name, "__a", n), OptBoxExpr::None, outer_body));
            vi = vi + 1;
        }
        var params: Vec<Param> = Vec::new();
        params.push(Param_new("__eq_a", Type::Named(e.name), false));
        params.push(Param_new("__eq_b", Type::Named(e.name), false));
        var body: Vec<Stmt> = Vec::new();
        body.push(Stmt::Match(Expr::Ident("__eq_a"), arms, 0));
        body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::BoolLit(false))), 0));
        generated.push(Func_new_full(fname, params, Type::Bool, body, true));
    }
    HashMap_drop(fnames);
    var gi: i64 = 0;
    while gi < generated.len() {
        program.funcs.push(generated.get(gi));
        gi = gi + 1;
    }
}

/// R1.2b: `==` on structs compares fields (proposal 0001). For every
/// non-generic struct, as src/compiler.rs synthesize_struct_eq:
///
///     fn __eq_S(__eq_a: S, __eq_b: S) -> bool {
///         return __eq_a.f0 == __eq_b.f0 && __eq_a.f1 == __eq_b.f1 && ...;
///     }
///
/// Each field goes back through `==`: nested structs and enums use their own
/// __eq, strings compare by content. A struct with a field of a generic
/// struct or enum type is skipped (its `==` would not type-check yet).
pub fn synthesize_struct_eq(program: &mut Program) {
    var generic_defs: Vec<str> = Vec::new();
    var gi: i64 = 0;
    while gi < program.structs.len() {
        if program.structs.get(gi).type_params.len() > 0 {
            generic_defs.push(program.structs.get(gi).name);
        }
        gi = gi + 1;
    }
    gi = 0;
    while gi < program.enums.len() {
        if program.enums.get(gi).type_params.len() > 0 {
            generic_defs.push(program.enums.get(gi).name);
        }
        gi = gi + 1;
    }
    var have: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        if str_starts_with(program.funcs.get(fi).name, "__eq_") {
            HashMap_insert(have, program.funcs.get(fi).name, 1);
        }
        fi = fi + 1;
    }
    var generated: Vec<Func> = Vec::new();
    var si: i64 = 0;
    while si < program.structs.len() {
        var s: StructDef = program.structs.get(si);
        si = si + 1;
        if s.type_params.len() > 0 {
            continue;
        }
        var fname: str = "__eq_" + s.name;
        if HashMap_get(have, fname) != 0 {
            continue;
        }
        var skip: bool = false;
        var same: Expr = Expr::BoolLit(true);
        var i: i64 = 0;
        while i < s.fields.len() {
            var f: Param = s.fields.get(i);
            match f.ty {
                Type::Generic(gname, _) => {
                    if str_vec_contains(generic_defs, gname) {
                        skip = true;
                    }
                }
                _ => {
                }
            }
            var fa: Expr = Expr::FieldAccess(Box::new(Expr::Ident("__eq_a")), f.name);
            var fb: Expr = Expr::FieldAccess(Box::new(Expr::Ident("__eq_b")), f.name);
            var cmp: Expr = Expr::Binary(BinOp::Eq, Box::new(fa), Box::new(fb));
            // A Vec field compares element by element (proposal 0001)
            var veq: str = vec_eq_fn_for(f.ty);
            if veq != "" {
                var vargs: Vec<Expr> = Vec::new();
                vargs.push(fa);
                vargs.push(fb);
                cmp = Expr::Call(veq, vargs);
            }
            if i == 0 {
                same = cmp;
            } else {
                same = Expr::Binary(BinOp::And, Box::new(same), Box::new(cmp));
            }
            i = i + 1;
        }
        if skip {
            continue;
        }
        var params: Vec<Param> = Vec::new();
        params.push(Param_new("__eq_a", Type::Named(s.name), false));
        params.push(Param_new("__eq_b", Type::Named(s.name), false));
        var body: Vec<Stmt> = Vec::new();
        body.push(Stmt::Return(OptBoxExpr::Some(Box::new(same)), 0));
        generated.push(Func_new_full(fname, params, Type::Bool, body, true));
    }
    HashMap_drop(have);
    var ni: i64 = 0;
    while ni < generated.len() {
        program.funcs.push(generated.get(ni));
        ni = ni + 1;
    }
}

pub fn process_derive(program: &mut Program) {
    var generated: Vec<Func> = Vec::new();
    // CL1: the structs that derive Deserialize (a field of one of them is
    // read with its own <T>_from_json), and the readers they need
    var deser_structs: i64 = HashMap_new();
    var dj_wanted: bool = false;
    var dsi: i64 = 0;
    while dsi < program.structs.len() {
        var ds: StructDef = program.structs.get(dsi);
        var dai: i64 = 0;
        while dai < ds.annotations.len() {
            if ds.annotations.get(dai).name == "derive" {
                var dargs: Vec<str> = ds.annotations.get(dai).args;
                var dak: i64 = 0;
                while dak < dargs.len() {
                    if str_trim(dargs.get(dak)) == "Deserialize" {
                        HashMap_insert(deser_structs, ds.name, 1);
                        dj_wanted = true;
                    }
                    dak = dak + 1;
                }
            }
            dai = dai + 1;
        }
        dsi = dsi + 1;
    }
    var dj_ready: bool = false;
    var dj_src: str = "";
    if dj_wanted {
        dj_ready = cc_add_derive_json(program);
    }

    var i: i64 = 0;
    while i < program.structs.len() {
        var s: StructDef = program.structs.get(i);
        var j: i64 = 0;
        while j < s.annotations.len() {
            if s.annotations.get(j).name == "derive" {
                var args: Vec<str> = s.annotations.get(j).args;
                var k: i64 = 0;
                while k < args.len() {
                    var arg: str = str_trim(args.get(k));

                    if arg == "Debug" {
                        var func_name: str = str_concat(s.name, "_debug_str");
                        var field_list: str = "";
                        var f: i64 = 0;
                        while f < s.fields.len() {
                            if f > 0 {
                                field_list = str_concat(field_list, ", ");
                            }
                            field_list = str_concat(field_list, s.fields.get(f).name);
                            field_list = str_concat(field_list, ": ?");
                            f = f + 1;
                        }
                        var debug_str: str = str_concat(str_concat(s.name, "("), str_concat(field_list, ")"));
                        var params: Vec<Param> = Vec::new();
                        params.push(Param_new("self", Type::Named(s.name), false));
                        var body: Vec<Stmt> = Vec::new();
                        body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::StringLit(debug_str))), 0));
                        generated.push(Func_new_full(func_name, params, Type::Str, body, true));
                    }

                    if arg == "Clone" {
                        var func_name2: str = str_concat(s.name, "_clone");
                        var params2: Vec<Param> = Vec::new();
                        params2.push(Param_new("self", Type::Named(s.name), false));
                        var body2: Vec<Stmt> = Vec::new();
                        body2.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::Ident("self"))), 0));
                        generated.push(Func_new_full(func_name2, params2, Type::Named(s.name), body2, true));
                    }

                    if arg == "Serialize" {
                        var func_name3: str = str_concat(s.name, "_to_json");
                        // "{\"a\":" + <a> + ",\"b\":" + <b> + "}"
                        var body_expr: Expr = Expr::StringLit("{");
                        var f2: i64 = 0;
                        while f2 < s.fields.len() {
                            var key: str = "\"" + s.fields.get(f2).name + "\":";
                            if f2 > 0 {
                                key = "," + key;
                            }
                            body_expr = cc_add(body_expr, Expr::StringLit(key));
                            body_expr = cc_add(body_expr, cc_serialize_field(s.fields.get(f2).name, s.fields.get(f2).ty));
                            f2 = f2 + 1;
                        }
                        body_expr = cc_add(body_expr, Expr::StringLit("}"));
                        var params3: Vec<Param> = Vec::new();
                        params3.push(Param_new("self", Type::Named(s.name), false));
                        var body3: Vec<Stmt> = Vec::new();
                        body3.push(Stmt::Return(OptBoxExpr::Some(Box::new(body_expr)), 0));
                        generated.push(Func_new_full(func_name3, params3, Type::Str, body3, true));
                    }

                    if arg == "Default" {
                        var func_name4: str = str_concat(s.name, "_default");
                        var field_inits: Vec<FieldInit> = Vec::new();
                        var f3: i64 = 0;
                        while f3 < s.fields.len() {
                            field_inits.push(FieldInit_new(s.fields.get(f3).name, default_expr_for_type(s.fields.get(f3).ty)));
                            f3 = f3 + 1;
                        }
                        var body4: Vec<Stmt> = Vec::new();
                        body4.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::StructLit(s.name, field_inits, OptBoxExpr::None))), 0));
                        generated.push(Func_new_full(func_name4, Vec::new(), Type::Named(s.name), body4, true));
                    }

                    if arg == "Deserialize" {
                        var func_name5: str = str_concat(s.name, "_from_json");
                        var field_inits2: Vec<FieldInit> = Vec::new();
                        // CL1: each field read from its key (stdlib
                        // derive_json.fd); `S_from_json_error` says which key
                        // is missing or of the wrong type
                        var err_src: str = "pub fn " + s.name + "_from_json_error(json: str) -> str {\n    var e: str = djson_object_error(json);\n";
                        var f4: i64 = 0;
                        while f4 < s.fields.len() {
                            var dfname: str = s.fields.get(f4).name;
                            var dfty: Type = s.fields.get(f4).ty;
                            if dj_ready {
                                field_inits2.push(FieldInit_new(dfname, cc_deserialize_field(dfname, dfty, deser_structs)));
                                err_src = err_src + cc_deserialize_check(dfname, dfty, deser_structs);
                            } else {
                                field_inits2.push(FieldInit_new(dfname, default_expr_for_type(dfty)));
                            }
                            f4 = f4 + 1;
                        }
                        dj_src = dj_src + err_src + "    return e;\n}\n";
                        var params5: Vec<Param> = Vec::new();
                        params5.push(Param_new("json", Type::Str, false));
                        var body5: Vec<Stmt> = Vec::new();
                        body5.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::StructLit(s.name, field_inits2, OptBoxExpr::None))), 0));
                        generated.push(Func_new_full(func_name5, params5, Type::Named(s.name), body5, true));
                    }

                    // Eq is PartialEq plus a promise; one function serves both.
                    var eq_alias: bool = arg == "Eq" && !str_vec_contains(args, "PartialEq");
                    if arg == "PartialEq" || eq_alias {
                        var func_name6: str = str_concat(s.name, "_equals");
                        var params6: Vec<Param> = Vec::new();
                        params6.push(Param_new("self", Type::Named(s.name), false));
                        params6.push(Param_new("other", Type::Named(s.name), false));
                        var body6: Vec<Stmt> = Vec::new();
                        // Build: self.f1 == other.f1 && self.f2 == other.f2 && ...
                        if s.fields.len() == 0 {
                            body6.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::BoolLit(true))), 0));
                        } else {
                            var result_expr: Expr = Expr::BoolLit(true);
                            var f5: i64 = 0;
                            while f5 < s.fields.len() {
                                var fname: str = s.fields.get(f5).name;
                                var self_access: Expr = Expr::FieldAccess(Box::new(Expr::Ident("self")), fname);
                                var other_access: Expr = Expr::FieldAccess(Box::new(Expr::Ident("other")), fname);
                                var cmp: Expr = Expr::Binary(BinOp::Eq, Box::new(self_access), Box::new(other_access));
                                if f5 == 0 {
                                    result_expr = cmp;
                                } else {
                                    result_expr = Expr::Binary(BinOp::And, Box::new(result_expr), Box::new(cmp));
                                }
                                f5 = f5 + 1;
                            }
                            body6.push(Stmt::Return(OptBoxExpr::Some(Box::new(result_expr)), 0));
                        }
                        generated.push(Func_new_full(func_name6, params6, Type::Bool, body6, true));
                    }

                    if arg == "Hash" {
                        // {name}_hash(self) -> i64: h = h * 31 + field (strings via
                        // p_str_hash, bools as 0/1). @wrapping: it never panics.
                        var params7: Vec<Param> = Vec::new();
                        params7.push(Param_new("self", Type::Named(s.name), false));
                        var body7: Vec<Stmt> = Vec::new();
                        body7.push(Stmt::Let("__h", OptType::Some(Type::I64), Expr::IntLit(17), true, false, Vec::new(), 0));
                        var f7: i64 = 0;
                        while f7 < s.fields.len() {
                            var fld: Param = s.fields.get(f7);
                            var access: Expr = Expr::FieldAccess(Box::new(Expr::Ident("self")), fld.name);
                            var part: Expr = Expr::IntLit(0);
                            var use_part: bool = true;
                            match fld.ty {
                                Type::I8 => {
                                    part = access;
                                }
                                Type::I16 => {
                                    part = access;
                                }
                                Type::I32 => {
                                    part = access;
                                }
                                Type::I64 => {
                                    part = access;
                                }
                                Type::U8 => {
                                    part = access;
                                }
                                Type::U16 => {
                                    part = access;
                                }
                                Type::U32 => {
                                    part = access;
                                }
                                Type::U64 => {
                                    part = access;
                                }
                                Type::Str => {
                                    var hargs: Vec<Expr> = Vec::new();
                                    hargs.push(access);
                                    part = Expr::Call("p_str_hash", hargs);
                                }
                                Type::Bool => {
                                    part = Expr::Cast(Box::new(access), Type::I64);
                                }
                                _ => {
                                    use_part = false;
                                }
                            }
                            if use_part {
                                var times: Expr = Expr::Binary(BinOp::Mul, Box::new(Expr::Ident("__h")), Box::new(Expr::IntLit(31)));
                                var mixed: Expr = Expr::Binary(BinOp::Add, Box::new(times), Box::new(part));
                                body7.push(Stmt::Assign("__h", AssignOp::Assign, mixed, 0));
                            }
                            f7 = f7 + 1;
                        }
                        body7.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::Ident("__h"))), 0));
                        var hash_fn: Func = Func_new_full(str_concat(s.name, "_hash"), params7, Type::I64, body7, true);
                        hash_fn.annotations.push(Annotation_new("wrapping", Vec::new()));
                        generated.push(hash_fn);
                    }

                    k = k + 1;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // CL1: the <S>_from_json_error functions, parsed from their source
    if dj_ready && str_len(dj_src) > 0 {
        var dj_funcs: Vec<Func> = cc_parse_funcs(dj_src);
        var dg: i64 = 0;
        while dg < dj_funcs.len() {
            generated.push(dj_funcs.get(dg));
            dg = dg + 1;
        }
    }
    HashMap_drop(deser_structs);

    // Add generated functions to program
    var g: i64 = 0;
    while g < generated.len() {
        program.funcs.push(generated.get(g));
        g = g + 1;
    }
}

/// LG15: where `@import("x.h")` looks for a system header, in order: the
/// directories in FID_INCLUDE, C_INCLUDE_PATH and INCLUDE (MSVC's), each a
/// list split at `;` (and `:` off Windows), then /usr/local/include,
/// /usr/include and /opt/homebrew/include.
fn cc_system_include_dirs() -> Vec<str> {
    var dirs: Vec<str> = Vec::new();
    var vars: Vec<str> = Vec::new();
    vars.push("FID_INCLUDE");
    vars.push("C_INCLUDE_PATH");
    vars.push("INCLUDE");
    var on_windows: bool = env_or_empty("OS") == "Windows_NT";
    var vi: i64 = 0;
    while vi < vars.len() {
        var v: str = env_or_empty(vars.get(vi));
        if str_len(v) > 0 {
            if on_windows == false {
                v = str_replace(v, ":", ";");
            }
            var parts: Vec<str> = c_str_split_n(v, ";", 64);
            var pi: i64 = 0;
            while pi < parts.len() {
                var d: str = str_trim(parts.get(pi));
                if str_len(d) > 0 {
                    dirs.push(d);
                }
                pi = pi + 1;
            }
        }
        vi = vi + 1;
    }
    dirs.push("/usr/local/include");
    dirs.push("/usr/include");
    dirs.push("/opt/homebrew/include");
    return dirs;
}

/// ST3: ark.toml's `edition = "N"` under [package], for the project that
/// holds `base_dir`; 0 when there is no manifest or no edition in it.
fn cc_manifest_edition(base_dir: str) -> i64 {
    var root: str = ark_project_root(base_dir);
    if str_len(root) == 0 {
        return 0;
    }
    var text: str = c_file_read(c_path_join(root, "ark.toml"));
    var lines: Vec<str> = c_str_lines(text);
    var section: str = "";
    var i: i64 = 0;
    while i < lines.len() {
        var l: str = str_trim(lines.get(i));
        if str_starts_with(l, "[") {
            section = l;
        } else if section == "[package]" && str_starts_with(l, "edition") {
            var eq: i64 = str_find(l, "=");
            if eq > 0 {
                var v: str = str_trim(c_str_substr(l, eq + 1, str_len(l)));
                v = str_replace(v, "\"", "");
                return c_str_parse_i64(str_trim(v));
            }
        }
        i = i + 1;
    }
    return 0;
}

/// ST3: record the edition `p` states (or the default) for `module`; an
/// error message for an edition this compiler does not know, else "".
pub fn cc_record_edition(p: Program, module: str, file: str) -> str {
    var e: i64 = program_edition(p);
    if e < 0 {
        return "Error: " + file + ": `#[edition(...)]` takes one year, as `#[edition(2026)]`";
    }
    if e == 0 {
        e = default_edition();
    }
    if edition_known(e) == false {
        return "Error: " + file + ": unknown edition " + int_to_str(e) + " (this compiler knows editions 2026 and 2027)";
    }
    edition_set(module, e);
    return "";
}

/// OP15: record each function marked `@cold` (and `Type_method` for a
/// method) in compiler/ast.fd's set, which the native backends read when
/// they lay out blocks: a block calling one goes after the hot code.
pub fn cc_collect_cold_hints(program: Program) {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var f: Func = program.funcs.get(fi);
        var ai: i64 = 0;
        while ai < f.annotations.len() {
            if f.annotations.get(ai).name == "cold" {
                cold_fn_mark(f.name);
            }
            ai = ai + 1;
        }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var m: Func = imp.methods.get(mi);
            var mai: i64 = 0;
            while mai < m.annotations.len() {
                if m.annotations.get(mai).name == "cold" {
                    cold_fn_mark(imp.struct_name + "_" + m.name);
                }
                mai = mai + 1;
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
}

/// The functions of Fides source `src` (generated code: no imports).
fn cc_parse_funcs(src: str) -> Vec<Func> {
    var lex: Lexer = Lexer::new(src);
    var toks: Vec<Token> = lex.tokenize();
    var no_structs: Vec<str> = Vec::new();
    var no_enums: Vec<str> = Vec::new();
    var parser: Parser = Parser_with_names(toks, no_structs, no_enums);
    var result: ParseResultProgram = parser.parse();
    match result {
        ParseResultProgram::Ok(prog) => {
            return prog.funcs;
        }
        ParseResultProgram::Err(e) => {
            p_eprint_str("[build] @derive(Deserialize): generated code does not parse: " + e + "\n");
        }
    }
    var none: Vec<Func> = Vec::new();
    return none;
}

/// CL1: add stdlib/derive_json.fd's readers to the program (once; a program
/// that imports derive_json has them already). false when the file is not
/// found: `S_from_json` then gives every field its default, as before.
fn cc_add_derive_json(program: &mut Program) -> bool {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        if program.funcs.get(fi).name == "djson_find" {
            return true;
        }
        fi = fi + 1;
    }
    var path: str = c_path_join(stdlib_dir(), "derive_json.fd");
    if c_file_exists(path) == false {
        return false;
    }
    inc_record_file(path);
    var funcs: Vec<Func> = cc_parse_funcs(c_file_read(path));
    if funcs.len() == 0 {
        return false;
    }
    var gi: i64 = 0;
    while gi < funcs.len() {
        program.funcs.push(funcs.get(gi));
        gi = gi + 1;
    }
    return true;
}

/// CL1: the reader of field `name` of type `ty` from the JSON text `json`.
fn cc_deserialize_field(name: str, ty: Type, deser_structs: i64) -> Expr {
    var args: Vec<Expr> = Vec::new();
    args.push(Expr::Ident("json"));
    args.push(Expr::StringLit(name));
    var narrow: bool = false;
    match ty {
        Type::I64 => {
            return Expr::Call("djson_int", args);
        }
        Type::I8 => {
            narrow = true;
        }
        Type::I16 => {
            narrow = true;
        }
        Type::I32 => {
            narrow = true;
        }
        Type::U8 => {
            narrow = true;
        }
        Type::U16 => {
            narrow = true;
        }
        Type::U32 => {
            narrow = true;
        }
        Type::U64 => {
            narrow = true;
        }
        Type::F64 => {
            return Expr::Call("djson_float", args);
        }
        Type::F32 => {
            return Expr::Cast(Box::new(Expr::Call("djson_float", args)), Type::F32);
        }
        Type::Bool => {
            return Expr::Call("djson_bool", args);
        }
        Type::Str => {
            return Expr::Call("djson_str", args);
        }
        Type::Named(n) => {
            if n == "str" {
                return Expr::Call("djson_str", args);
            }
            if HashMap_get(deser_structs, n) != 0 {
                var inner: Vec<Expr> = Vec::new();
                inner.push(Expr::Call("djson_raw", args));
                return Expr::Call(n + "_from_json", inner);
            }
        }
        _ => {
        }
    }
    if narrow {
        return Expr::Cast(Box::new(Expr::Call("djson_int", args)), ty);
    }
    return default_expr_for_type(ty);
}

/// CL1: the line of `<S>_from_json_error` that checks field `name`.
fn cc_deserialize_check(name: str, ty: Type, deser_structs: i64) -> str {
    var kind: i64 = 0;
    var nested: str = "";
    match ty {
        Type::I8 => {
            kind = 1;
        }
        Type::I16 => {
            kind = 1;
        }
        Type::I32 => {
            kind = 1;
        }
        Type::I64 => {
            kind = 1;
        }
        Type::U8 => {
            kind = 1;
        }
        Type::U16 => {
            kind = 1;
        }
        Type::U32 => {
            kind = 1;
        }
        Type::U64 => {
            kind = 1;
        }
        Type::F32 => {
            kind = 2;
        }
        Type::F64 => {
            kind = 2;
        }
        Type::Bool => {
            kind = 3;
        }
        Type::Str => {
            kind = 4;
        }
        Type::Named(n) => {
            if n == "str" {
                kind = 4;
            } else if HashMap_get(deser_structs, n) != 0 {
                kind = 5;
                nested = n;
            }
        }
        _ => {
        }
    }
    var line: str = "    e = djson_need(e, json, \"" + name + "\", " + int_to_str(kind) + ");\n";
    if str_len(nested) > 0 {
        line = line + "    e = djson_nest(e, \"" + name + "\", " + nested + "_from_json_error(djson_raw(json, \"" + name + "\")));\n";
    }
    return line;
}

/// Generate a default expression for a given type (used by @derive(Deserialize)).
pub fn default_expr_for_type(ty: Type) -> Expr {
    match ty {
        Type::I64 => {
            return Expr::IntLit(0);
        }
        Type::I32 => {
            return Expr::IntLit(0);
        }
        Type::I16 => {
            return Expr::IntLit(0);
        }
        Type::I8 => {
            return Expr::IntLit(0);
        }
        Type::U64 => {
            return Expr::IntLit(0);
        }
        Type::U32 => {
            return Expr::IntLit(0);
        }
        Type::U16 => {
            return Expr::IntLit(0);
        }
        Type::U8 => {
            return Expr::IntLit(0);
        }
        Type::F64 => {
            return Expr::FloatLit(0.0);
        }
        Type::F32 => {
            return Expr::FloatLit(0.0);
        }
        Type::Bool => {
            return Expr::BoolLit(false);
        }
        Type::Str => {
            return Expr::StringLit("");
        }
        Type::Named(name) => {
            var inits: Vec<FieldInit> = Vec::new();
            return Expr::StructLit(name, inits, OptBoxExpr::None);
        }
        _ => {
        }
    }
    return Expr::IntLit(0);
}

// ===========================================================================
// desugar_layers_models -- desugar layer/model declarations
// ===========================================================================

/// Desugar layer/model declarations into structs + impls + constructor functions.
pub fn desugar_layers_models(program: &mut Program) {
    // Desugar layers: struct + impl + constructor
    var i: i64 = 0;
    while i < program.layers.len() {
        var layer: LayerDef = program.layers.get(i);
        // Create struct
        var new_struct: StructDef = StructDef_new_full(layer.name, layer.fields, layer.is_pub, Vec::new(), Vec::new());
        program.structs.push(new_struct);
        // Create impl block with forward method
        var forward: Func = layer.forward;
        forward.is_pub = true;
        var new_impl: ImplDef = ImplDef_new_full(layer.name, Vec::new(), c_vec1_func(forward));
        program.impls.push(new_impl);
        // Create constructor: LayerName_new(fields...) -> LayerName
        var ctor_name: str = str_concat(layer.name, "_new");
        var ctor_body: Vec<Stmt> = Vec::new();
        var field_inits: Vec<FieldInit> = Vec::new();
        var f: i64 = 0;
        while f < layer.fields.len() {
            field_inits.push(FieldInit_new(layer.fields.get(f).name, Expr::Ident(layer.fields.get(f).name)));
            f = f + 1;
        }
        ctor_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::StructLit(layer.name, field_inits, OptBoxExpr::None))), 0));
        program.funcs.push(Func_new_full(ctor_name, layer.fields, Type::Named(layer.name), ctor_body, layer.is_pub));
        i = i + 1;
    }
    var empty_layers: Vec<LayerDef> = Vec::new();
    program.layers = empty_layers;

    // Desugar models: struct + impl + constructor
    i = 0;
    while i < program.models.len() {
        var model: ModelDef = program.models.get(i);
        // Create struct with layer fields
        var fields: Vec<Param> = Vec::new();
        var j: i64 = 0;
        while j < model.layers.len() {
            var layer_inst: LayerInst = model.layers.get(j);
            fields.push(Param_new(layer_inst.field, Type::Named(layer_inst.layer_type), false));
            j = j + 1;
        }
        var mstruct: StructDef = StructDef_new_full(model.name, fields, model.is_pub, Vec::new(), Vec::new());
        program.structs.push(mstruct);
        // Create impl block with forward method
        var mforward: Func = model.forward;
        mforward.is_pub = true;
        var mimpl: ImplDef = ImplDef_new_full(model.name, Vec::new(), c_vec1_func(mforward));
        program.impls.push(mimpl);
        // Create constructor: ModelName_new() -> ModelName
        var mctor_name: str = str_concat(model.name, "_new");
        var mfield_inits: Vec<FieldInit> = Vec::new();
        var j2: i64 = 0;
        while j2 < model.layers.len() {
            var li: LayerInst = model.layers.get(j2);
            var args: Vec<Expr> = Vec::new();
            var a: i64 = 0;
            while a < li.args.len() {
                var arg_str: str = li.args.get(a);
                var parsed: i64 = str_parse_int(arg_str);
                if parsed > 0 || arg_str == "0" {
                    args.push(Expr::IntLit(parsed));
                } else {
                    args.push(Expr::Ident(arg_str));
                }
                a = a + 1;
            }
            var layer_ctor: str = str_concat(li.layer_type, "_new");
            mfield_inits.push(FieldInit_new(li.field, Expr::Call(layer_ctor, args)));
            j2 = j2 + 1;
        }
        var mctor_body: Vec<Stmt> = Vec::new();
        mctor_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::StructLit(model.name, mfield_inits, OptBoxExpr::None))), 0));
        program.funcs.push(Func_new_full(mctor_name, Vec::new(), Type::Named(model.name), mctor_body, model.is_pub));
        i = i + 1;
    }
    var empty_models: Vec<ModelDef> = Vec::new();
    program.models = empty_models;
}

// ===========================================================================
// desugar_phase8b -- desugar components, event handlers, state machines
// ===========================================================================

/// Desugar F18 components → structs, F20 event handlers → functions,
/// F19 state machines → enum + initial/handle functions.
pub fn desugar_phase8b(program: &mut Program) {
    // F18: Desugar components → structs
    var ci: i64 = 0;
    while ci < program.components.len() {
        var comp: ComponentDef = program.components.get(ci);
        var new_struct: StructDef = StructDef_new_full(comp.name, comp.fields, comp.is_pub, Vec::new(), Vec::new());
        program.structs.push(new_struct);
        ci = ci + 1;
    }
    var empty_comps: Vec<ComponentDef> = Vec::new();
    program.components = empty_comps;

    // F20: Desugar event handlers → functions
    var ei: i64 = 0;
    while ei < program.event_handlers.len() {
        var eh: EventHandlerDef = program.event_handlers.get(ei);
        var func_name: str = str_concat("__on_", eh.event_name);
        program.funcs.push(Func_new_full(func_name, eh.params, Type::Void, eh.body, eh.is_pub));
        ei = ei + 1;
    }
    var empty_ehs: Vec<EventHandlerDef> = Vec::new();
    program.event_handlers = empty_ehs;

    // F19: Desugar state machines → enum + initial/handle functions
    var si: i64 = 0;
    while si < program.state_machines.len() {
        var sm: StateMachineDef = program.state_machines.get(si);
        var sm_name: str = sm.name;

        // Create enum with one variant per state (no data)
        var variants: Vec<EnumVariant> = Vec::new();
        var sti: i64 = 0;
        while sti < sm.states.len() {
            var state: StateDef = sm.states.get(sti);
            variants.push(EnumVariant_new(state.name, OptParams::None));
            sti = sti + 1;
        }
        program.enums.push(EnumDef_new(sm_name, variants, sm.is_pub));

        // Create <SM>_initial() function — returns first state
        var first_state: str = "Error";
        if sm.states.len() > 0 {
            first_state = sm.states.get(0).name;
        }
        var initial_name: str = str_concat(sm_name, "_initial");
        var initial_body: Vec<Stmt> = Vec::new();
        var initial_args: Vec<Expr> = Vec::new();
        initial_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::EnumLit(sm_name, first_state, initial_args))), 0));
        program.funcs.push(Func_new_full(initial_name, Vec::new(), Type::Named(sm_name), initial_body, sm.is_pub));

        // Create <SM>_handle(state, event) -> state function
        var handle_name: str = str_concat(sm_name, "_handle");
        var arms: Vec<MatchArm> = Vec::new();
        var si2: i64 = 0;
        while si2 < sm.states.len() {
            var state: StateDef = sm.states.get(si2);
            // Pattern: StateName
            var pattern: Pattern = Pattern::EnumVariant(sm_name, state.name, Vec::new());
            // Body: match on event string
            var event_arms: Vec<MatchArm> = Vec::new();
            var ti: i64 = 0;
            while ti < state.transitions.len() {
                var trans: StateTransition = state.transitions.get(ti);
                var trans_body: Vec<Stmt> = Vec::new();
                var trans_args: Vec<Expr> = Vec::new();
                trans_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::EnumLit(sm_name, trans.target, trans_args))), 0));
                event_arms.push(MatchArm_new(Pattern::StrLit(trans.event), OptBoxExpr::None, trans_body));
                ti = ti + 1;
            }
            // Default arm: return current state (no transition)
            var default_body: Vec<Stmt> = Vec::new();
            default_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::Ident("__state"))), 0));
            event_arms.push(MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, default_body));
            var inner_body: Vec<Stmt> = Vec::new();
            inner_body.push(Stmt::Match(Expr::Ident("__event_type"), event_arms, 0));
            arms.push(MatchArm_new(pattern, OptBoxExpr::None, inner_body));
            si2 = si2 + 1;
        }
        // Default arm for unknown state
        var unk_body: Vec<Stmt> = Vec::new();
        unk_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::Ident("__state"))), 0));
        arms.push(MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, unk_body));

        var handle_params: Vec<Param> = Vec::new();
        handle_params.push(Param_new("__state", Type::Named(sm_name), false));
        handle_params.push(Param_new("__event_type", Type::Str, false));
        var handle_body: Vec<Stmt> = Vec::new();
        handle_body.push(Stmt::Match(Expr::Ident("__state"), arms, 0));
        program.funcs.push(Func_new_full(handle_name, handle_params, Type::Named(sm_name), handle_body, sm.is_pub));

        si = si + 1;
    }
    var empty_sms: Vec<StateMachineDef> = Vec::new();
    program.state_machines = empty_sms;

    // F18: Desugar systems -> functions (their query statements are
    // desugared below with every other function body).
    var syi: i64 = 0;
    while syi < program.systems.len() {
        var sys: SystemDef = program.systems.get(syi);
        program.funcs.push(Func_new_full(sys.name, sys.params, Type::Void, sys.body, sys.is_pub));
        syi = syi + 1;
    }
    var empty_systems: Vec<SystemDef> = Vec::new();
    program.systems = empty_systems;

    // F18: Desugar query statements -> loops over entities.
    var qfi: i64 = 0;
    while qfi < program.funcs.len() {
        var qf: Func = program.funcs.get(qfi);
        if stmts_have_query(qf.body) {
            qf.body = desugar_query_stmts(qf.body);
            program.funcs.set(qfi, qf);
        }
        qfi = qfi + 1;
    }
    var qii: i64 = 0;
    while qii < program.impls.len() {
        var qimp: ImplDef = program.impls.get(qii);
        var changed: bool = false;
        var qmi: i64 = 0;
        while qmi < qimp.methods.len() {
            var qm: Func = qimp.methods.get(qmi);
            if stmts_have_query(qm.body) {
                qm.body = desugar_query_stmts(qm.body);
                qimp.methods.set(qmi, qm);
                changed = true;
            }
            qmi = qmi + 1;
        }
        if changed {
            program.impls.set(qii, qimp);
        }
        qii = qii + 1;
    }
}

/// Whether any statement (at any depth) is a `query`.
fn stmts_have_query(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Query(_, _, _) => {
                return true;
            }
            Stmt::If(_, tb, eb, _) => {
                if stmts_have_query(tb) {
                    return true;
                }
                match eb {
                    OptStmts::Some(e) => {
                        if stmts_have_query(e) {
                            return true;
                        }
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::While(_, b, _) => {
                if stmts_have_query(b) {
                    return true;
                }
            }
            Stmt::For(_, _, b, _) => {
                if stmts_have_query(b) {
                    return true;
                }
            }
            Stmt::Loop(b, _) => {
                if stmts_have_query(b) {
                    return true;
                }
            }
            Stmt::Defer(b, _) => {
                if stmts_have_query(b) {
                    return true;
                }
            }
            Stmt::Match(_, arms, _) => {
                var ai: i64 = 0;
                while ai < arms.len() {
                    if stmts_have_query(arms.get(ai).body) {
                        return true;
                    }
                    ai = ai + 1;
                }
            }
            Stmt::Handle(b, hs, _) => {
                if stmts_have_query(b) {
                    return true;
                }
                var hi: i64 = 0;
                while hi < hs.len() {
                    if stmts_have_query(hs.get(hi).body) {
                        return true;
                    }
                    hi = hi + 1;
                }
            }
            Stmt::RegionBlock(_, _, _, _, _, b, _) => {
                if stmts_have_query(b) {
                    return true;
                }
            }
            Stmt::Sandbox(b, _) => {
                if stmts_have_query(b) {
                    return true;
                }
            }
            Stmt::Unsafe(b, _) => {
                if stmts_have_query(b) {
                    return true;
                }
            }
            Stmt::Txn(b, _) => {
                if stmts_have_query(b) {
                    return true;
                }
            }
            Stmt::ComptimeGen(b, _) => {
                if stmts_have_query(b) {
                    return true;
                }
            }
            Stmt::GradBlock(_, b, _) => {
                if stmts_have_query(b) {
                    return true;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return false;
}

/// `query (A, B) { body }` -> `for entity in 0..__ecs_entity_count() {
/// if __ecs_has("A", entity) != 0 && __ecs_has("B", entity) != 0 { body } }`
/// (src/compiler.rs desugar_query_stmts), recursively.
fn desugar_query_stmts(stmts: Vec<Stmt>) -> Vec<Stmt> {
    var out: Vec<Stmt> = Vec::new();
    var i: i64 = 0;
    while i < stmts.len() {
        var st: Stmt = stmts.get(i);
        match st {
            Stmt::Query(components, body, _) => {
                var qbody: Vec<Stmt> = desugar_query_stmts(body);
                var cond: Expr = Expr::BoolLit(true);
                var has_cond: bool = false;
                var ci: i64 = 0;
                while ci < components.len() {
                    var has_args: Vec<Expr> = Vec::new();
                    has_args.push(Expr::StringLit(components.get(ci)));
                    has_args.push(Expr::Ident("entity"));
                    var check: Expr = Expr::Binary(BinOp::Neq, Box::new(Expr::Call("__ecs_has", has_args)), Box::new(Expr::IntLit(0)));
                    if has_cond {
                        cond = Expr::Binary(BinOp::And, Box::new(cond), Box::new(check));
                    } else {
                        cond = check;
                        has_cond = true;
                    }
                    ci = ci + 1;
                }
                var for_body: Vec<Stmt> = Vec::new();
                for_body.push(Stmt::If(cond, qbody, OptStmts::None, 0));
                var range: Expr = Expr::Range(Box::new(Expr::IntLit(0)), Box::new(Expr::Call("__ecs_entity_count", Vec::new())), false);
                out.push(Stmt::For("entity", range, for_body, 0));
            }
            Stmt::If(c, tb, eb, line) => {
                var neb: OptStmts = OptStmts::None;
                match eb {
                    OptStmts::Some(e) => {
                        neb = OptStmts::Some(desugar_query_stmts(e));
                    }
                    OptStmts::None => {
                    }
                }
                out.push(Stmt::If(c, desugar_query_stmts(tb), neb, line));
            }
            Stmt::While(c, b, line) => {
                out.push(Stmt::While(c, desugar_query_stmts(b), line));
            }
            Stmt::For(v, it, b, line) => {
                out.push(Stmt::For(v, it, desugar_query_stmts(b), line));
            }
            Stmt::Loop(b, line) => {
                out.push(Stmt::Loop(desugar_query_stmts(b), line));
            }
            Stmt::Defer(b, line) => {
                out.push(Stmt::Defer(desugar_query_stmts(b), line));
            }
            Stmt::Match(e, arms, line) => {
                var narms: Vec<MatchArm> = Vec::new();
                var ai: i64 = 0;
                while ai < arms.len() {
                    var arm: MatchArm = arms.get(ai);
                    narms.push(MatchArm_new(arm.pattern, arm.guard, desugar_query_stmts(arm.body)));
                    ai = ai + 1;
                }
                out.push(Stmt::Match(e, narms, line));
            }
            Stmt::Handle(b, hs, line) => {
                var nhs: Vec<EffectHandler> = Vec::new();
                var hi: i64 = 0;
                while hi < hs.len() {
                    var h: EffectHandler = hs.get(hi);
                    h.body = desugar_query_stmts(h.body);
                    nhs.push(h);
                    hi = hi + 1;
                }
                out.push(Stmt::Handle(desugar_query_stmts(b), nhs, line));
            }
            Stmt::RegionBlock(n, bud, g, kv, ws, b, line) => {
                out.push(Stmt::RegionBlock(n, bud, g, kv, ws, desugar_query_stmts(b), line));
            }
            Stmt::Sandbox(b, line) => {
                out.push(Stmt::Sandbox(desugar_query_stmts(b), line));
            }
            Stmt::Unsafe(b, line) => {
                out.push(Stmt::Unsafe(desugar_query_stmts(b), line));
            }
            Stmt::Txn(b, line) => {
                out.push(Stmt::Txn(desugar_query_stmts(b), line));
            }
            Stmt::ComptimeGen(b, line) => {
                out.push(Stmt::ComptimeGen(desugar_query_stmts(b), line));
            }
            Stmt::GradBlock(n, b, line) => {
                out.push(Stmt::GradBlock(n, desugar_query_stmts(b), line));
            }
            _ => {
                out.push(st);
            }
        }
        i = i + 1;
    }
    return out;
}

/// Helper: create a Vec with one Func element.
fn c_vec1_func(f: Func) -> Vec<Func> {
    var v: Vec<Func> = Vec::new();
    v.push(f);
    return v;
}

// ===========================================================================
// fill_default_trait_methods -- fill in default trait method implementations
// ===========================================================================

/// Phase 3B.1: Fill in default trait methods.
/// For each trait impl, if the trait defines a method with a default body that
/// the impl doesn't override, add the default body to the impl.
pub fn fill_default_trait_methods(program: &mut Program) {
    // trait_name -> index+1 into program.traits (a Vec scan per impl was
    // O(impls x traits))
    var trait_ix: i64 = HashMap_new();
    var ti0: i64 = 0;
    while ti0 < program.traits.len() {
        HashMap_insert(trait_ix, program.traits.get(ti0).name, ti0 + 1);
        ti0 = ti0 + 1;
    }

    var i: i64 = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        // Find the trait definition
        var tix: i64 = HashMap_get(trait_ix, ti.trait_name);
        if tix == 0 {
            i = i + 1;
            continue;
        }
        var trait_def: TraitDef = program.traits.get(tix - 1);

        // Build set of provided method names
        var provided: Vec<str> = Vec::new();
        var k: i64 = 0;
        while k < ti.methods.len() {
            provided.push(ti.methods.get(k).name);
            k = k + 1;
        }

        // The `self` a method filled below carries. 2g.97: it keeps the
        // impl's own type arguments — `impl<T> Show for Wrap<T>` gives
        // self: Wrap<T> (the pd_generic_self rule), a narrower impl's
        // self is its narrower pattern (pd_impl_narrow_self reads it off
        // the written methods). A bare `Wrap` left T unbound, so a call
        // on self in a default method could not bind it and method_subst
        // defaulted it to i64: `self.show()` ran the i64 impl's body on
        // every receiver.
        var fill_self: Type = pd_impl_narrow_self(ti.type_name, ti.type_params, ti.methods);
        match fill_self {
            Type::Void => {
                fill_self = Type::Named(ti.type_name);
                if ti.type_params.len() > 0 {
                    var ftps: Vec<Type> = Vec::new();
                    var ftpi: i64 = 0;
                    while ftpi < ti.type_params.len() {
                        ftps.push(Type::Named(ti.type_params.get(ftpi)));
                        ftpi = ftpi + 1;
                    }
                    fill_self = Type::Generic(ti.type_name, ftps);
                }
            }
            _ => {
            }
        }

        // For each trait method with a default body not in provided, add it
        var added: bool = false;
        var m: i64 = 0;
        while m < trait_def.methods.len() {
            var tm: TraitMethod = trait_def.methods.get(m);
            if cc_c_str_vec_contains(provided, tm.name) {
                m = m + 1;
                continue;
            }
            // Check if there's a default body
            match tm.default_body {
                OptStmts::None => {
                }
                OptStmts::Some(default_body) => {
                    // Build params: replace self type
                    var self_type: Type = fill_self;
                    var params: Vec<Param> = Vec::new();
                    var p: i64 = 0;
                    while p < tm.params.len() {
                        if tm.params.get(p).name == "self" {
                            params.push(Param_new("self", self_type, false));
                        } else {
                            params.push(tm.params.get(p));
                        }
                        p = p + 1;
                    }
                    // Add the method to the trait impl
                    var new_func: Func = Func_new_full(tm.name, params, tm.ret_ty, default_body, tm.is_pub);
                    // LG4: a generic default method keeps its own type
                    // parameters (bound at calls, instantiated by mono)
                    new_func.type_params = tm.type_params;
                    new_func.type_param_bounds = tm.type_param_bounds;
                    // LG14: an async default method of a cap stays async in
                    // each impl it is filled into
                    new_func.is_async = tm.is_async;
                    // LG3: the trait method's annotations (its @lifetime)
                    var tma: i64 = 0;
                    while tma < tm.annotations.len() {
                        new_func.annotations.push(tm.annotations.get(tma));
                        tma = tma + 1;
                    }
                    ti.methods.push(new_func);
                    added = true;
                }
            }
            m = m + 1;
        }
        if added {
            program.trait_impls.set(i, ti);
        }
        i = i + 1;
    }
    HashMap_drop(trait_ix);
}

// ===========================================================================
// strip_ungranted_caps -- capability-aware dead code elimination
// ===========================================================================

/// I-3A: Transitive Capability DCE -- strip functions requiring capabilities not
/// in the granted set, then transitively eliminate all functions only reachable
/// through the stripped functions.
pub fn strip_ungranted_caps(module: &mut IrModule, granted_caps: Vec<str>) {
    // Map capability names to the effects they grant
    var granted_io: bool = cc_c_str_vec_contains(granted_caps, "IO") || cc_c_str_vec_contains(granted_caps, "FS");
    var granted_net: bool = cc_c_str_vec_contains(granted_caps, "Net");
    var granted_spawn: bool = cc_c_str_vec_contains(granted_caps, "Spawn");

    // Find functions that require effects not in the granted set.
    // Entry points (main, _start) are never stripped.
    var to_remove: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < module.function_effects.len() {
        var entry: StringEffectSetEntry = module.function_effects.get(i);
        if entry.name == "main" || entry.name == "_start" {
            i = i + 1;
            continue;
        }
        var effects: EffectSet = entry.effects;
        var j: i64 = 0;
        while j < effects.effects.len() {
            var eff: Effect = effects.effects.get(j);
            match eff {
                Effect::IO => {
                    if !granted_io {
                        if !cc_c_str_vec_contains(to_remove, entry.name) {
                            to_remove.push(entry.name);
                        }
                    }
                }
                Effect::Net => {
                    if !granted_net {
                        if !cc_c_str_vec_contains(to_remove, entry.name) {
                            to_remove.push(entry.name);
                        }
                    }
                }
                Effect::Spawn => {
                    if !granted_spawn {
                        if !cc_c_str_vec_contains(to_remove, entry.name) {
                            to_remove.push(entry.name);
                        }
                    }
                }
                _ => {
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    if to_remove.len() == 0 {
        return;
    }

    // Build call graph: for each function, which functions does it call?
    var call_graph_names: Vec<StringVecStr> = Vec::new();
    var all_func_names: Vec<str> = Vec::new();
    i = 0;
    while i < module.functions.len() {
        all_func_names.push(module.functions.get(i).name);
        var callees: Vec<str> = Vec::new();
        var func: IrFunction = module.functions.get(i).func;
        var j2: i64 = 0;
        while j2 < func.insts.len() {
            var inst: Inst = func.insts.get(j2).inst;
            match inst {
                Inst::Call(callee, _, _, _) => {
                    callees.push(callee);
                }
                Inst::ConstStr(value) => {
                    if cc_c_str_vec_contains(all_func_names, value) {
                        callees.push(value);
                    }
                }
                Inst::ConstFnRef(name) => {
                    var target: str = c_fn_target(name);
                    if cc_c_str_vec_contains(all_func_names, target) {
                        callees.push(target);
                    }
                }
                _ => {
                }
            }
            j2 = j2 + 1;
        }
        call_graph_names.push(StringVecStr_new(module.functions.get(i).name, callees));
        i = i + 1;
    }

    // BFS from all entry points to find reachable functions
    var reachable: Vec<str> = Vec::new();
    var queue: Vec<str> = Vec::new();

    // Start from all entry points
    if cc_c_str_vec_contains(all_func_names, "main") && !cc_c_str_vec_contains(to_remove, "main") {
        queue.push("main");
    }
    if cc_c_str_vec_contains(all_func_names, "_start") && !cc_c_str_vec_contains(to_remove, "_start") {
        queue.push("_start");
    }
    while queue.len() > 0 {
        var name: str = queue.get(0);
        queue = c_vec_remove_first(queue);
        if cc_c_str_vec_contains(reachable, name) || cc_c_str_vec_contains(to_remove, name) {
            continue;
        }
        reachable.push(name);
        // Find callees of this function
        var callees2: Vec<str> = Vec::new();
        var k2: i64 = 0;
        while k2 < call_graph_names.len() {
            if call_graph_names.get(k2).name == name {
                callees2 = call_graph_names.get(k2).items;
            }
            k2 = k2 + 1;
        }
        var c2: i64 = 0;
        while c2 < callees2.len() {
            if !cc_c_str_vec_contains(reachable, callees2.get(c2)) {
                queue.push(callees2.get(c2));
            }
            c2 = c2 + 1;
        }
    }

    // Remove unreachable functions
    var new_functions: Vec<IrFunctionEntry> = Vec::new();
    var new_function_effects: Vec<StringEffectSetEntry> = Vec::new();
    i = 0;
    while i < module.functions.len() {
        if cc_c_str_vec_contains(reachable, module.functions.get(i).name) {
            new_functions.push(module.functions.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < module.function_effects.len() {
        if cc_c_str_vec_contains(reachable, module.function_effects.get(i).name) {
            new_function_effects.push(module.function_effects.get(i));
        }
        i = i + 1;
    }
    module.functions = new_functions;
    HashMap_clear(module.fn_index);
    module.function_effects = new_function_effects;
}

/// Helper: remove the first element from a Vec and return the rest.
fn c_vec_remove_first(v: Vec<str>) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var i: i64 = 1;
    while i < v.len() {
        result.push(v.get(i));
        i = i + 1;
    }
    return result;
}

// ===========================================================================
// String helpers (only functions NOT in core.fd)
// ===========================================================================

/// Concatenate three strings.
pub fn c_str_concat3(a: str, b: str, c: str) -> str {
    return str_concat(str_concat(a, b), c);
}

/// Split a string by a delimiter, returning at most n parts.
pub fn c_str_split_n(s: str, delim: str, n: i64) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var remaining: str = s;
    var count: i64 = 1;

    while count < n {
        var idx: i64 = str_find(remaining, delim);
        if idx < 0 {
            break;
        }
        result.push(c_str_substr(remaining, 0, idx));
        remaining = c_str_substr(remaining, idx + str_len(delim), str_len(remaining));
        count = count + 1;
    }
    result.push(remaining);
    return result;
}

/// Split a string into lines.
/// LF18: the @constant_time violations the last CCodeGen_generate found
/// (codegen_c.fd CGen_ct_error_text), one per element; empty when none.
pub fn c_ct_error_lines() -> Vec<str> {
    var out: Vec<str> = Vec::new();
    val txt: str = CGen_ct_error_text();
    if str_len(txt) == 0 {
        return out;
    }
    val lines: Vec<str> = c_str_lines(txt);
    var i: i64 = 0;
    while i < lines.len() {
        if str_len(str_trim(lines.get(i))) > 0 {
            out.push(lines.get(i));
        }
        i = i + 1;
    }
    return out;
}

pub fn c_str_lines(s: str) -> Vec<str> {
    var lines: Vec<str> = str_split(s, "\n");
    var result: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < lines.len() {
        var line: str = lines.get(i);
        // Strip trailing \r (Windows CRLF line endings)
        if str_len(line) > 0 {
            var last: str = str_slice(line, str_len(line) - 1, str_len(line));
            if last == "\r" {
                line = str_slice(line, 0, str_len(line) - 1);
            }
        }
        // Every line is kept, empty ones too: callers index the result
        // by line number (enrich_errors).
        result.push(line);
        i = i + 1;
    }
    return result;
}

/// Get a substring from start (inclusive) to end (exclusive).
pub fn c_str_substr(s: str, start: i64, end: i64) -> str {
    if start < 0 {
        start = 0;
    }
    if end > str_len(s) {
        end = str_len(s);
    }
    if start >= end {
        return "";
    }
    return str_slice(s, start, end);
}

/// Parse an i64 from a string. Returns 0 on failure.
pub fn c_str_parse_i64(s: str) -> i64 {
    return str_parse_int(s);
}

/// Trim surrounding quotes from a string.
pub fn c_str_trim_quotes(s: str) -> str {
    if str_len(s) >= 2 {
        var first: str = str_slice(s, 0, 1);
        var last: str = str_slice(s, str_len(s) - 1, str_len(s));
        if (first == "\"" && last == "\"") || (first == "'" && last == "'") {
            return c_str_substr(s, 1, str_len(s) - 1);
        }
    }
    return s;
}

/// Check if a Vec<str> contains a string.
fn cc_is_cfg(f: Func) -> bool {
    var i: i64 = 0;
    while i < f.annotations.len() {
        if f.annotations.get(i).name == "cfg" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// `funcs` with names and calls rewritten through `renames`.
fn cc_rename_funcs(funcs: &mut Vec<Func>, renames: Vec<RenameEntry>, rename_defs: bool) {
    var empty_subst: Vec<SubstEntry> = subst_new();
    var no_methods: Vec<RenameEntry> = rename_new();
    var fi: i64 = 0;
    while fi < funcs.len() {
        var f: Func = funcs.get(fi);
        if rename_defs && !cc_is_cfg(f) {
            match rename_get(renames, f.name) {
                OptStr::Some(q) => {
                    f.name = q;
                }
                OptStr::None => {
                }
            }
        }
        var body: Vec<Stmt> = Vec::new();
        var si: i64 = 0;
        while si < f.body.len() {
            body.push(subst_stmt(f.body.get(si), empty_subst, renames, no_methods));
            si = si + 1;
        }
        f.body = body;
        funcs.set(fi, f);
        fi = fi + 1;
    }
}

/// The user's program may define a function whose name an imported module
/// also defines. The imported copy is renamed `module__name`, and calls inside
/// the imported modules follow it: they cannot see the user's definitions,
/// so every caller keeps the function it was written against. A name that
/// two imported modules define is left alone.
fn cc_add(a: Expr, b: Expr) -> Expr {
    return Expr::Binary(BinOp::Add, Box::new(a), Box::new(b));
}

/// @derive(Serialize): the JSON text of field `name`.
fn cc_serialize_field(name: str, ty: Type) -> Expr {
    var field: Expr = Expr::FieldAccess(Box::new(Expr::Ident("self")), name);
    var args: Vec<Expr> = Vec::new();
    match ty {
        Type::F32 => {
            args.push(Expr::Cast(Box::new(field), Type::F64));
            return Expr::Call("p_float_to_str", args);
        }
        Type::F64 => {
            args.push(Expr::Cast(Box::new(field), Type::F64));
            return Expr::Call("p_float_to_str", args);
        }
        Type::Bool => {
            args.push(field);
            return Expr::Call("p_bool_to_str", args);
        }
        Type::Str => {
            args.push(field);
            return Expr::Call("p_json_string", args);
        }
        Type::Named(n) => {
            args.push(field);
            if n == "str" {
                return Expr::Call("p_json_string", args);
            }
            return Expr::Call(n + "_to_json", args);
        }
        Type::I8 => {
        }
        Type::I16 => {
        }
        Type::I32 => {
        }
        Type::I64 => {
        }
        Type::U8 => {
        }
        Type::U16 => {
        }
        Type::U32 => {
        }
        Type::U64 => {
        }
        _ => {
            return Expr::StringLit("null");
        }
    }
    args.push(Expr::Cast(Box::new(field), Type::I64));
    return Expr::Call("int_to_str", args);
}

fn cc_qualify_shadowed_imports(imported: &mut Vec<Program>, names: Vec<str>, user: &mut Program, core: Program) {
    // name -> 1 + index of the one module defining it, or -1 for several
    var definer: i64 = HashMap_new();
    var core_fns: i64 = HashMap_new();
    var ci0: i64 = 0;
    while ci0 < core.funcs.len() {
        HashMap_insert(core_fns, core.funcs.get(ci0).name, 1);
        ci0 = ci0 + 1;
    }
    var mi: i64 = 0;
    while mi < imported.len() {
        var fs: Vec<Func> = imported.get(mi).funcs;
        var fi: i64 = 0;
        while fi < fs.len() {
            var f: Func = fs.get(fi);
            if !cc_is_cfg(f) {
                var prev: i64 = HashMap_get(definer, f.name);
                if prev == 0 {
                    HashMap_insert(definer, f.name, mi + 1);
                } else if prev != mi + 1 {
                    HashMap_insert(definer, f.name, 0 - 1);
                }
                // A private helper named like a core function stays the module's own
                if !f.is_pub && HashMap_get(core_fns, f.name) != 0 {
                    HashMap_insert(definer, f.name, 0 - 1);
                }
            }
            fi = fi + 1;
        }
        mi = mi + 1;
    }
    var renames: Vec<RenameEntry> = rename_new();
    var any: bool = false;
    var ui: i64 = 0;
    while ui < user.funcs.len() {
        var uf: Func = user.funcs.get(ui);
        var d: i64 = HashMap_get(definer, uf.name);
        if d > 0 && !cc_is_cfg(uf) {
            var module: str = str_replace(names.get(d - 1), "::", "__");
            rename_set(&mut renames, uf.name, module + "__" + uf.name);
            any = true;
        }
        ui = ui + 1;
    }
    // Names several imported modules define: every copy is renamed, per module
    var own: Vec<Vec<RenameEntry>> = Vec::new();
    mi = 0;
    while mi < imported.len() {
        var mine: Vec<RenameEntry> = rename_new();
        var fs: Vec<Func> = imported.get(mi).funcs;
        var fi: i64 = 0;
        while fi < fs.len() {
            var f: Func = fs.get(fi);
            if !cc_is_cfg(f) && HashMap_get(definer, f.name) == 0 - 1 {
                rename_set(&mut mine, f.name, str_replace(names.get(mi), "::", "__") + "__" + f.name);
                any = true;
            }
            fi = fi + 1;
        }
        own.push(mine);
        mi = mi + 1;
    }
    // `module::name`, by the name the module is imported under
    var qualified: Vec<RenameEntry> = rename_new();
    // CB1: the import loop takes the parser's list as it goes (a module
    // from the import cache adds its own calls there)
    var calls: Vec<str> = imp_take_qcalls();
    // one func-name set per module: the per-call scan below was
    // O(calls x modules x funcs-per-module)
    var fsets: Vec<i64> = Vec::new();
    mi = 0;
    while mi < imported.len() {
        var mset: i64 = HashMap_new();
        var mfs: Vec<Func> = imported.get(mi).funcs;
        var mfi: i64 = 0;
        while mfi < mfs.len() {
            HashMap_insert(mset, mfs.get(mfi).name, 1);
            mfi = mfi + 1;
        }
        fsets.push(mset);
        mi = mi + 1;
    }
    var ci: i64 = 0;
    while ci < calls.len() {
        var call: str = calls.get(ci);
        var at: i64 = str_find(call, "::");
        var seg: str = str_slice(call, 0, at);
        var fname: str = str_slice(call, at + 2, str_len(call));
        var path: str = seg;
        var ai: i64 = 0;
        while ai < user.imports.len() {
            var imp: ImportDef = user.imports.get(ai);
            match imp.alias {
                OptStr::Some(al) => {
                    if al == seg {
                        path = imp.path;
                    }
                }
                OptStr::None => {
                }
            }
            ai = ai + 1;
        }
        if seg == "core" {
            rename_set(&mut qualified, call, fname);
        }
        mi = 0;
        while mi < imported.len() {
            if names.get(mi) == path || path_last(names.get(mi)) == path {
                var target: str = fname;
                var hit: bool = HashMap_get(fsets.get(mi), fname) != 0;
                match rename_get(own.get(mi), fname) {
                    OptStr::Some(q) => {
                        target = q;
                    }
                    OptStr::None => {
                        match rename_get(renames, fname) {
                            OptStr::Some(q2) => {
                                target = q2;
                            }
                            OptStr::None => {
                            }
                        }
                    }
                }
                if hit {
                    rename_set(&mut qualified, call, target);
                    any = true;
                }
            }
            mi = mi + 1;
        }
        ci = ci + 1;
    }
    mi = 0;
    while mi < fsets.len() {
        HashMap_drop(fsets.get(mi));
        mi = mi + 1;
    }
    if !any {
        return;
    }
    mi = 0;
    while mi < imported.len() {
        var prog: Program = imported.get(mi);
        var map: Vec<RenameEntry> = rename_new();
        cc_rename_extend(&mut map, renames);
        cc_rename_extend(&mut map, qualified);
        // A name it does not define: the copy of a module it imports
        var ip: i64 = 0;
        while ip < prog.imports.len() {
            var ik: i64 = 0;
            while ik < imported.len() {
                if names.get(ik) == prog.imports.get(ip).path {
                    cc_rename_extend(&mut map, own.get(ik));
                }
                ik = ik + 1;
            }
            ip = ip + 1;
        }
        cc_rename_extend(&mut map, own.get(mi));
        cc_rename_funcs(&mut prog.funcs, map, true);
        var ii: i64 = 0;
        while ii < prog.impls.len() {
            var rimp: ImplDef = prog.impls.get(ii);
            cc_rename_funcs(&mut rimp.methods, map, false);
            prog.impls.set(ii, rimp);
            ii = ii + 1;
        }
        ii = 0;
        while ii < prog.trait_impls.len() {
            var rti: TraitImpl = prog.trait_impls.get(ii);
            cc_rename_funcs(&mut rti.methods, map, false);
            prog.trait_impls.set(ii, rti);
            ii = ii + 1;
        }
        imported.set(mi, prog);
        mi = mi + 1;
    }
    if qualified.len() > 0 {
        cc_rename_funcs(&mut user.funcs, qualified, false);
        var ui2: i64 = 0;
        while ui2 < user.impls.len() {
            var uimp: ImplDef = user.impls.get(ui2);
            cc_rename_funcs(&mut uimp.methods, qualified, false);
            user.impls.set(ui2, uimp);
            ui2 = ui2 + 1;
        }
        ui2 = 0;
        while ui2 < user.trait_impls.len() {
            var uti: TraitImpl = user.trait_impls.get(ui2);
            cc_rename_funcs(&mut uti.methods, qualified, false);
            user.trait_impls.set(ui2, uti);
            ui2 = ui2 + 1;
        }
    }
}

fn cc_rename_extend(map: &mut Vec<RenameEntry>, more: Vec<RenameEntry>) {
    var i: i64 = 0;
    while i < more.len() {
        map.push(more.get(i));
        i = i + 1;
    }
}

fn cc_push_traits(defs: &mut Vec<TraitDef>, p: Program) {
    var i: i64 = 0;
    while i < p.traits.len() {
        defs.push(p.traits.get(i));
        i = i + 1;
    }
}

/// Supertrait methods first (transitively), then the trait's own; a method
/// the trait redeclares keeps its signature.
fn cc_collect_trait_methods(name: str, defs: Vec<TraitDef>, seen: &mut Vec<str>, out: &mut Vec<TraitMethod>) {
    if cc_c_str_vec_contains(seen, name) {
        return;
    }
    seen.push(name);
    var i: i64 = 0;
    while i < defs.len() {
        var t: TraitDef = defs.get(i);
        if t.name == name {
            var s: i64 = 0;
            while s < t.supertraits.len() {
                cc_collect_trait_methods(t.supertraits.get(s), defs, seen, out);
                s = s + 1;
            }
            var m: i64 = 0;
            while m < t.methods.len() {
                var tm: TraitMethod = t.methods.get(m);
                var replaced: bool = false;
                var o: i64 = 0;
                while o < out.len() {
                    if out.get(o).name == tm.name {
                        out.set(o, tm);
                        replaced = true;
                        break;
                    }
                    o = o + 1;
                }
                if !replaced {
                    out.push(tm);
                }
                m = m + 1;
            }
            return;
        }
        i = i + 1;
    }
}

/// `cap Sub: Super { .. }`: a subtrait inherits its supertraits' methods, so
/// an impl of Sub must provide them and a `dyn Sub` vtable carries them.
fn cc_inherit_supertraits(p: &mut Program, defs: Vec<TraitDef>, errors: &mut Vec<str>) {
    var i: i64 = 0;
    while i < p.traits.len() {
        var t: TraitDef = p.traits.get(i);
        if t.supertraits.len() > 0 {
            var s: i64 = 0;
            while s < t.supertraits.len() {
                var sup: str = t.supertraits.get(s);
                var found: bool = false;
                var d: i64 = 0;
                while d < defs.len() {
                    if defs.get(d).name == sup {
                        found = true;
                        break;
                    }
                    d = d + 1;
                }
                if !found {
                    errors.push("Type error: trait '" + sup + "' is not defined (supertrait of '" + t.name + "')\n    Fix: define trait '" + sup + "', or `use` the module that defines it, or correct the name");
                }
                s = s + 1;
            }
            var out: Vec<TraitMethod> = Vec::new();
            var seen: Vec<str> = Vec::new();
            cc_collect_trait_methods(t.name, defs, &mut seen, &mut out);
            t.methods = out.clone();
            p.traits.set(i, t);
        }
        i = i + 1;
    }
}

pub fn cc_c_str_vec_contains(vec: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < vec.len() {
        if vec.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Fast contains check using pointer equality (==) instead of str_equal.
/// Only safe to use when all strings in the vec AND the search string are
/// interned (i.e., produced by Lexer_intern or from the same str_slice).
/// This is O(n) but each comparison is a single i64 == instead of a
/// function call + byte-by-byte comparison.
pub fn c_str_vec_contains_ptr(vec: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < vec.len() {
        if vec.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Join a Vec<str> with a separator.
pub fn c_str_join(vec: Vec<str>, sep: str) -> str {
    var result: str = "";
    var i: i64 = 0;
    while i < vec.len() {
        if i > 0 {
            result = str_concat(result, sep);
        }
        result = str_concat(result, vec.get(i));
        i = i + 1;
    }
    return result;
}

/// Pad a string on the left to a given width.
pub fn c_str_pad_left(s: str, width: i64, ch: i64) -> str {
    var result: str = s;
    while str_len(result) < width {
        result = str_concat(p_char_to_str(ch), result);
    }
    return result;
}

/// Find the last occurrence of a character in a string.
pub fn c_str_find_last(s: str, ch: str) -> i64 {
    // Search from the end using str_slice for single-char comparison
    var i: i64 = str_len(s) - 1;
    while i >= 0 {
        if str_slice(s, i, i + 1) == ch {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

// c_vec1 and c_file_exists moved to compiler::ir (shared with backends
// that cannot import this module).

// ===========================================================================
// File/Path/OS helpers (using builtins directly)
// ===========================================================================

pub fn c_vec0_str() -> Vec<str> {
    return Vec::new();
}

pub fn c_vec2_str(a: str, b: str) -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}

/// Read a file as a string. Returns empty string on failure.
pub fn c_file_read(path: str) -> str {
    var content = p_file_read(path);
    if (content as i64) == 0 {
        return "";
    }
    return content;
}

/// Get the directory part of a path (everything before the last /).
pub fn c_path_dirname(path: str) -> str {
    // Either separator (a Windows path: C:\Fides\fides.exe)
    var idx: i64 = c_str_find_last(path, "/");
    var bidx: i64 = c_str_find_last(path, "\\");
    if bidx > idx {
        idx = bidx;
    }
    if idx < 0 {
        return ".";
    }
    if idx == 0 {
        return "/";
    }
    return c_str_substr(path, 0, idx);
}

/// Join two path components with a /.
pub fn c_path_join(a: str, b: str) -> str {
    if str_len(a) == 0 {
        return b;
    }
    if str_len(b) == 0 {
        return a;
    }
    var last_char: str = str_slice(a, str_len(a) - 1, str_len(a));
    if last_char == "/" {
        return str_concat(a, b);
    }
    return c_str_concat3(a, "/", b);
}

/// Get the current working directory.
pub fn c_os_cwd() -> str {
    return ".";
}

// --- Per-module C units (`ccompile --inc`, as src/codegen_c.rs) ----------

var g_func_module_index: i64 = 0;
var g_func_module_names: Vec<str> = Vec::new();
fn set_func_module(name: str, module: str) {
    if g_func_module_index == 0 {
        g_func_module_index = HashMap_new();
        var names: Vec<str> = Vec::new();
        g_func_module_names = names;
    }
    g_func_module_names.push(module);
    HashMap_insert(g_func_module_index, name, g_func_module_names.len());
}

/// Record which module defines each function of `prog`.
fn record_func_modules(prog: Program, module: str) {
    var i: i64 = 0;
    while i < prog.funcs.len() {
        set_func_module(prog.funcs.get(i).name, module);
        i = i + 1;
    }
    i = 0;
    while i < prog.impls.len() {
        var imp: ImplDef = prog.impls.get(i);
        var m: i64 = 0;
        while m < imp.methods.len() {
            set_func_module(imp.struct_name + "_" + imp.methods.get(m).name, module);
            m = m + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < prog.trait_impls.len() {
        var ti: TraitImpl = prog.trait_impls.get(i);
        var m: i64 = 0;
        while m < ti.methods.len() {
            set_func_module(ti.type_name + "_" + ti.methods.get(m).name, module);
            m = m + 1;
        }
        i = i + 1;
    }
    // B2 (inc-roadmap): the `==` helpers synthesize_struct_eq and
    // synthesize_enum_eq make (`__eq_<S>`, `__eq_<Enum>`) belong to the
    // module of their type, not to main's unit (where func_module_of sends
    // a name it does not know): a struct added to lib1 then changes lib1's
    // unit only. FIDES_INC_EQ=main: the old placement (split_c_units).
    i = 0;
    while i < prog.structs.len() {
        if prog.structs.get(i).type_params.len() == 0 {
            set_func_module("__eq_" + prog.structs.get(i).name, module);
        }
        i = i + 1;
    }
    i = 0;
    while i < prog.enums.len() {
        if prog.enums.get(i).type_params.len() == 0 {
            set_func_module("__eq_" + prog.enums.get(i).name, module);
        }
        i = i + 1;
    }
}

fn func_module_of(name: str, fallback: str) -> str {
    if g_func_module_index == 0 {
        return fallback;
    }
    var slot: i64 = HashMap_get(g_func_module_index, name);
    if slot != 0 {
        return g_func_module_names.get(slot - 1);
    }
    var at: i64 = str_find(name, "__");
    // Generic instances go to the unit of the module defining the generic
    // (inc-roadmap B3): a method instance is `S__m__T1_T2` (mono.fd
    // mangle_method), registered as `S_m`; a function instance is `f__T`.
    if at > 0 {
        var rest: str = str_slice(name, at + 2, str_len(name));
        var at2: i64 = str_find(rest, "__");
        if at2 > 0 {
            slot = HashMap_get(g_func_module_index, str_slice(name, 0, at) + "_" + str_slice(rest, 0, at2));
            if slot != 0 {
                return g_func_module_names.get(slot - 1);
            }
        }
    }
    if at > 0 {
        slot = HashMap_get(g_func_module_index, str_slice(name, 0, at));
        if slot != 0 {
            return g_func_module_names.get(slot - 1);
        }
    }
    return fallback;
}

/// B3: is `name` a generic instance (`f__T`, `S__m__T`): not a function
/// of a module itself, but placed by the generic it was made from?
fn func_is_instance(name: str) -> bool {
    if g_func_module_index == 0 {
        return false;
    }
    if HashMap_get(g_func_module_index, name) != 0 {
        return false;
    }
    return str_len(func_module_of(name, "")) > 0;
}

/// B3 (inc-roadmap): caller-unit placement of generic instances. Each
/// instance (`snames`, at `units` = the unit of its generic's module)
/// moves to the unit of the functions that name it when they are all in
/// one unit other than the generic's own: a new instantiation of a core
/// generic from one module then changes that module's unit, not core's.
/// An instance its generic's module names too, or that two other units
/// name, stays where it is: each instance is still defined once, with
/// external linkage (no weak/COMDAT symbols, which tcc and cl do not share,
/// and no per-unit copies), so any placement links, and each unit's
/// prototypes are those its text names (split_c_units). The table of
/// function names in the tail (`__p_fns`) does not count as a caller.
/// An instance calling another moves that one along: placement repeats
/// until nothing moves (at most 8 rounds).
fn c_place_instances_at_callers(full: str, full_len: i64, snames: Vec<str>, cnames: Vec<str>, starts: Vec<i64>, ends: Vec<i64>, units: &mut Vec<i64>) {
    var n: i64 = snames.len();
    // instance C name -> its index + 1
    var inst_at: i64 = HashMap_new();
    var is_inst: Vec<i64> = Vec::new();
    var home: Vec<i64> = Vec::new();
    var n_inst: i64 = 0;
    var i: i64 = 0;
    while i < n {
        home.push(units.get(i));
        if str_len(cnames.get(i)) > 0 && func_is_instance(snames.get(i)) {
            HashMap_insert(inst_at, cnames.get(i), i + 1);
            is_inst.push(1);
            n_inst = n_inst + 1;
        } else {
            is_inst.push(0);
        }
        i = i + 1;
    }
    if n_inst == 0 {
        return;
    }
    // Who names which instance: an edge from each function to each
    // instance its text names (an instance's C name holds `__`, so only
    // identifiers with `__` past their first byte are looked up)
    var e_from: Vec<i64> = Vec::new();
    var e_to: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        var k: i64 = starts.get(i);
        var e: i64 = ends.get(i);
        while k < e {
            var c: i64 = str_byte_at(full, k);
            if c_ident_byte(c) && !(c >= 48 && c <= 57) {
                var s0: i64 = k;
                var dunder: bool = false;
                while k < e && c_ident_byte(str_byte_at(full, k)) {
                    if k > s0 && str_byte_at(full, k) == 95 && str_byte_at(full, k - 1) == 95 {
                        dunder = true;
                    }
                    k = k + 1;
                }
                if dunder {
                    var t: i64 = HashMap_get(inst_at, str_slice_len(full, full_len, s0, k));
                    if t != 0 && t - 1 != i {
                        e_from.push(i);
                        e_to.push(t - 1);
                    }
                }
            } else if c >= 48 && c <= 57 {
                // a number (and any letters glued to it, as 10LL)
                while k < e && c_ident_byte(str_byte_at(full, k)) {
                    k = k + 1;
                }
            } else {
                k = k + 1;
            }
        }
        i = i + 1;
    }
    if e_from.len() == 0 {
        return;
    }
    var round: i64 = 0;
    var changed: bool = true;
    while changed && round < 8 {
        changed = false;
        // per instance: the one unit other than home naming it (-1: none),
        // whether more than one does, whether home does
        var first_u: Vec<i64> = Vec::new();
        var multi: Vec<i64> = Vec::new();
        var home_calls: Vec<i64> = Vec::new();
        i = 0;
        while i < n {
            first_u.push(-1);
            multi.push(0);
            home_calls.push(0);
            i = i + 1;
        }
        var ei: i64 = 0;
        while ei < e_from.len() {
            var j: i64 = e_to.get(ei);
            var u: i64 = units.get(e_from.get(ei));
            if u == home.get(j) {
                home_calls.set(j, 1);
            } else if first_u.get(j) < 0 {
                first_u.set(j, u);
            } else if first_u.get(j) != u {
                multi.set(j, 1);
            }
            ei = ei + 1;
        }
        i = 0;
        while i < n {
            if is_inst.get(i) == 1 {
                var target: i64 = home.get(i);
                if home_calls.get(i) == 0 && multi.get(i) == 0 && first_u.get(i) >= 0 {
                    target = first_u.get(i);
                }
                if units.get(i) != target {
                    units.set(i, target);
                    changed = true;
                }
            }
            i = i + 1;
        }
        round = round + 1;
    }
    if str_len(env_or_empty("FIDES_INC_DEBUG")) > 0 {
        var moved: i64 = 0;
        i = 0;
        while i < n {
            if units.get(i) != home.get(i) {
                moved = moved + 1;
            }
            i = i + 1;
        }
        p_eprint_str("[inc] instances: " + int_to_str(moved) + " of " + int_to_str(n_inst) + " placed in their caller's unit\n");
    }
}

/// B3 (inc-roadmap): per-unit copies of a generic instance that two or more
/// units call, after c_place_instances_at_callers. Without them such an
/// instance stays in the unit of its generic's module, so a new
/// instantiation of a core generic from lib1 and lib2 rebuilds core's unit.
/// Now, when the generic's own unit does not call it, the instance's one
/// external definition goes to the calling unit first by name and every
/// other calling unit gets a `static` copy (split_c_units adds `static` to
/// the copy's definition line and to that unit's prototype of it). A copy
/// calls the instances it needs; those are placed the same way (an edge
/// from a copied function counts for each unit that holds it), until
/// nothing changes. An instance whose address is taken (its name, outside
/// a call, anywhere in the C other than its `__p_fns` entry: a function
/// value, a table) is never copied: two copies would have two addresses.
/// The external definition stays the one `__p_fns` names, so a panic trace
/// names its frames; a frame in a `static` copy has no name in a trace.
/// Each unit's text still holds every function it runs, so a unit's object
/// key changes exactly when a copy it holds does.
fn c_copy_instances_to_callers(full: str, full_len: i64, tail_at: i64, snames: Vec<str>, cnames: Vec<str>, starts: Vec<i64>, ends: Vec<i64>, decl_at: Vec<i64>, unit_names: Vec<str>, units: &mut Vec<i64>, copy_fn: &mut Vec<i64>, copy_unit: &mut Vec<i64>) {
    var n: i64 = snames.len();
    var nu: i64 = unit_names.len();
    if nu < 2 {
        return;
    }
    // instance C name -> fn index + 1; fn index -> instance number (-1:
    // not an instance); instance number -> fn index, home unit
    var inst_at: i64 = HashMap_new();
    var kidx: Vec<i64> = Vec::new();
    var inst_fn: Vec<i64> = Vec::new();
    var home: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var k0: i64 = -1;
        if str_len(cnames.get(i)) > 0 && decl_at.get(i) >= starts.get(i) && func_is_instance(snames.get(i)) {
            var h: i64 = c_unit_slot(unit_names, func_module_of(snames.get(i), ""));
            if h >= 0 {
                HashMap_insert(inst_at, cnames.get(i), i + 1);
                k0 = inst_fn.len();
                inst_fn.push(i);
                home.push(h);
            }
        }
        kidx.push(k0);
        i = i + 1;
    }
    var n_inst: i64 = inst_fn.len();
    if n_inst == 0 {
        return;
    }
    // One scan of the whole C text: which function names which instance
    // (edges), and which instance is named other than in a call or a
    // declaration (taken). Strings, character literals and comments are
    // skipped (`//@FN name` is a comment; `"name"` in __p_fns a string).
    var taken: Vec<i64> = Vec::new();
    var ti: i64 = 0;
    while ti < n_inst {
        taken.push(0);
        ti = ti + 1;
    }
    var e_from: Vec<i64> = Vec::new();
    var e_to: Vec<i64> = Vec::new();
    var cur: i64 = -1;
    var nf: i64 = 0;
    var k: i64 = 0;
    while k < full_len {
        if cur >= 0 && k >= ends.get(cur) {
            cur = -1;
        }
        while nf < n && starts.get(nf) <= k {
            cur = nf;
            nf = nf + 1;
        }
        if cur >= 0 && k >= ends.get(cur) {
            cur = -1;
        }
        var c: i64 = str_byte_at(full, k);
        if c == 34 || c == 39 {
            // a string or character literal
            k = k + 1;
            while k < full_len && str_byte_at(full, k) != c && str_byte_at(full, k) != 10 {
                if str_byte_at(full, k) == 92 {
                    k = k + 1;
                }
                k = k + 1;
            }
            k = k + 1;
        } else if c == 47 && k + 1 < full_len && str_byte_at(full, k + 1) == 47 {
            while k < full_len && str_byte_at(full, k) != 10 {
                k = k + 1;
            }
        } else if c == 47 && k + 1 < full_len && str_byte_at(full, k + 1) == 42 {
            k = k + 2;
            while k + 1 < full_len && !(str_byte_at(full, k) == 42 && str_byte_at(full, k + 1) == 47) {
                k = k + 1;
            }
            k = k + 2;
        } else if c_ident_byte(c) && !(c >= 48 && c <= 57) {
            var s0: i64 = k;
            var dunder: bool = false;
            while k < full_len && c_ident_byte(str_byte_at(full, k)) {
                if k > s0 && str_byte_at(full, k) == 95 && str_byte_at(full, k - 1) == 95 {
                    dunder = true;
                }
                k = k + 1;
            }
            if dunder {
                var t: i64 = HashMap_get(inst_at, str_slice_len(full, full_len, s0, k));
                if t != 0 {
                    var j: i64 = t - 1;
                    var q: i64 = k;
                    while q < full_len && (str_byte_at(full, q) == 32 || str_byte_at(full, q) == 9) {
                        q = q + 1;
                    }
                    if q >= full_len || str_byte_at(full, q) != 40 {
                        // not a call or a declaration: taken, unless it is
                        // the instance's `{(const void*)name, "name"}` row
                        // of the tail's __p_fns
                        var row: bool = cur < 0 && s0 >= tail_at && s0 >= 13 && str_slice_len(full, full_len, s0 - 13, s0) == "(const void*)";
                        if !row {
                            taken.set(kidx.get(j), 1);
                        }
                    }
                    if cur >= 0 && cur != j {
                        e_from.push(cur);
                        e_to.push(j);
                    }
                }
            }
        } else if c >= 48 && c <= 57 {
            while k < full_len && c_ident_byte(str_byte_at(full, k)) {
                k = k + 1;
            }
        } else {
            k = k + 1;
        }
    }
    if e_from.len() == 0 {
        return;
    }
    // has: instance x unit, 1 = a static copy there; cu: the units calling
    // each instance (recomputed each round)
    var has: Vec<i64> = Vec::new();
    var cu: Vec<i64> = Vec::new();
    var hi: i64 = 0;
    while hi < n_inst * nu {
        has.push(0);
        cu.push(0);
        hi = hi + 1;
    }
    var round: i64 = 0;
    var changed: bool = true;
    while changed && round < 16 {
        changed = false;
        hi = 0;
        while hi < n_inst * nu {
            cu.set(hi, 0);
            hi = hi + 1;
        }
        var ei: i64 = 0;
        while ei < e_from.len() {
            var f: i64 = e_from.get(ei);
            var kj: i64 = kidx.get(e_to.get(ei));
            cu.set(kj * nu + units.get(f), 1);
            var kf: i64 = kidx.get(f);
            if kf >= 0 {
                var u0: i64 = 0;
                while u0 < nu {
                    if has.get(kf * nu + u0) == 1 {
                        cu.set(kj * nu + u0, 1);
                    }
                    u0 = u0 + 1;
                }
            }
            ei = ei + 1;
        }
        var kk: i64 = 0;
        while kk < n_inst {
            if taken.get(kk) == 0 {
                var j2: i64 = inst_fn.get(kk);
                var p: i64 = units.get(j2);
                var h2: i64 = home.get(kk);
                var others: i64 = 0;
                var best: i64 = -1;
                var u: i64 = 0;
                while u < nu {
                    if cu.get(kk * nu + u) == 1 {
                        if u != p {
                            others = others + 1;
                        }
                        if best < 0 || str_compare(unit_names.get(u), unit_names.get(best)) < 0 {
                            best = u;
                        }
                    }
                    u = u + 1;
                }
                // Its generic's unit calls it and holds it: the others
                // call that one (a copy would not keep it out of home)
                var keep: bool = others == 0 || (p == h2 && cu.get(kk * nu + h2) == 1);
                if !keep {
                    if p == h2 {
                        // home does not call it: its definition moves to
                        // the calling unit first by name
                        units.set(j2, best);
                        has.set(kk * nu + best, 0);
                        p = best;
                        changed = true;
                    }
                    u = 0;
                    while u < nu {
                        if cu.get(kk * nu + u) == 1 && u != p && has.get(kk * nu + u) == 0 {
                            has.set(kk * nu + u, 1);
                            changed = true;
                        }
                        u = u + 1;
                    }
                }
            }
            kk = kk + 1;
        }
        round = round + 1;
    }
    var n_copied: i64 = 0;
    var kk2: i64 = 0;
    while kk2 < n_inst {
        var any: bool = false;
        var u2: i64 = 0;
        while u2 < nu {
            if has.get(kk2 * nu + u2) == 1 {
                copy_fn.push(inst_fn.get(kk2));
                copy_unit.push(u2);
                any = true;
            }
            u2 = u2 + 1;
        }
        if any {
            n_copied = n_copied + 1;
        }
        kk2 = kk2 + 1;
    }
    if str_len(env_or_empty("FIDES_INC_DEBUG")) > 0 {
        var n_taken: i64 = 0;
        var tk: i64 = 0;
        while tk < n_inst {
            n_taken = n_taken + taken.get(tk);
            tk = tk + 1;
        }
        p_eprint_str("[inc] instance copies: " + int_to_str(copy_fn.len()) + " static copies of " + int_to_str(n_copied) + " of " + int_to_str(n_inst) + " instances (" + int_to_str(n_taken) + " address-taken, never copied)\n");
    }
}

pub struct CUnit {
    pub name: str,
    pub code: str,
}

fn c_unit_slot(names: Vec<str>, name: str) -> i64 {
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// The `_strN` names `body` uses, appended to `used` (a HashMap as a set).
fn c_collect_str_names(body: str, used: i64) {
    var n: i64 = str_len(body);
    var i: i64 = 0;
    while i + 4 < n {
        if str_byte_at(body, i) == 95 && str_byte_at(body, i + 1) == 115 && str_byte_at(body, i + 2) == 116 && str_byte_at(body, i + 3) == 114 {
            var e: i64 = i + 4;
            while e < n && str_byte_at(body, e) >= 48 && str_byte_at(body, e) <= 57 {
                e = e + 1;
            }
            if e > i + 4 {
                HashMap_insert(used, str_slice(body, i, e), 1);
            }
            i = e;
        } else {
            i = i + 1;
        }
    }
}

/// Byte is a C identifier character.
fn c_ident_byte(c: i64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
}

/// Every C identifier in `src` (digit-led runs skipped) — the per-unit
/// scan that scopes prototypes to the fns a unit's text names.
fn c_collect_idents(src: str, set: i64) {
    var n: i64 = str_len(src);
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(src, i);
        if c_ident_byte(c) && !(c >= 48 && c <= 57) {
            var s: i64 = i;
            while i < n && c_ident_byte(str_byte_at(src, i)) {
                i = i + 1;
            }
            HashMap_insert(set, str_slice(src, s, i), 1);
        } else {
            i = i + 1;
        }
    }
}

/// The function name in a one-line C declaration — the identifier just
/// before the first `(`. "" when the line has no `(`.
fn c_decl_name(line: str) -> str {
    var op: i64 = str_find(line, "(");
    if op < 0 {
        return "";
    }
    var e: i64 = op;
    while e > 0 && str_byte_at(line, e - 1) == 32 {
        e = e - 1;
    }
    var s: i64 = e;
    while s > 0 && c_ident_byte(str_byte_at(line, s - 1)) {
        s = s - 1;
    }
    return str_slice(line, s, e);
}

/// Offset of the next "//@FN " line after `from`, else limit + 1.
fn c_next_fn_mark(full: str, from: i64, limit: i64) -> i64 {
    var i: i64 = from;
    while i < limit {
        if str_byte_at(full, i) == 10 && str_byte_at(full, i + 1) == 47 && str_byte_at(full, i + 2) == 47 && str_byte_at(full, i + 3) == 64 && str_byte_at(full, i + 4) == 70 {
            return i + 1;
        }
        i = i + 1;
    }
    return limit + 1;
}

/// The `_strN` name a string-constant line of the prelude declares, else
/// "". codegen_c.fd emit_string_consts writes three forms:
///   static const char _strN[] = "...";                      (fn names)
///   static const struct { ... } _strN_h = { P_STR_STATIC_C, ... };
///   #define _strN (_strN_h.s)
/// The last two travel together: both are keyed by `_strN`, so a unit that
/// names `_strN` gets both, in their original order. Before Nov 15 only
/// the first form was scoped and every unit carried every literal, so a
/// literal added anywhere rebuilt every unit (inc-roadmap B7).
fn c_str_decl_key(t: str) -> str {
    var at: i64 = -1;
    if str_starts_with(t, "static const char _str") {
        at = 18;
    } else if str_starts_with(t, "#define _str") {
        at = 8;
    } else if str_starts_with(t, "static const struct {") {
        // The name follows the struct type's closing brace; the literal's
        // text comes later, after `= {`, so this finds the type's brace.
        var cb: i64 = str_find(t, "} _str");
        if cb < 0 {
            return "";
        }
        at = cb + 2;
    } else {
        return "";
    }
    var n: i64 = str_len(t);
    var e: i64 = at + 4;
    while e < n && str_byte_at(t, e) >= 48 && str_byte_at(t, e) <= 57 {
        e = e + 1;
    }
    if e == at + 4 {
        return "";
    }
    return str_slice(t, at, e);
}

/// B2 (inc-roadmap): the struct a prelude line opens (`struct Pt_s {` ->
/// "Pt_s"), else "". codegen_c.fd emit_struct_defs writes one such block
/// per layout, closed by a line starting with `}` (`};` or the @repr(C)
/// form `} __attribute__((aligned(N)));`).
fn c_struct_block_key(t: str) -> str {
    if !str_starts_with(t, "struct ") || !str_ends_with(t, " {") {
        return "";
    }
    var name: str = str_trim(str_slice(t, 7, str_len(t) - 2));
    var i: i64 = 0;
    while i < str_len(name) {
        if !c_ident_byte(str_byte_at(name, i)) {
            return "";
        }
        i = i + 1;
    }
    return name;
}

/// B2: the name a `#define A B` line of the FFI section defines and the
/// name it stands for ("" when the line is not that form).
fn c_ffi_define_names(t: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if !str_starts_with(t, "#define ") {
        return out;
    }
    var parts: Vec<str> = str_split(str_trim(str_slice(t, 8, str_len(t))), " ");
    if parts.len() != 2 {
        return out;
    }
    out.push(parts.get(0));
    out.push(parts.get(1));
    return out;
}

/// B2: the scoped layout/extern entries `text` names (other than `self_at`),
/// looked up in `key_at` (key -> entry index + 1).
fn c_entry_refs(text: str, key_at: i64, self_at: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var n: i64 = str_len(text);
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(text, i);
        if c_ident_byte(c) && !(c >= 48 && c <= 57) {
            var s: i64 = i;
            while i < n && c_ident_byte(str_byte_at(text, i)) {
                i = i + 1;
            }
            var e: i64 = HashMap_get(key_at, str_slice(text, s, i));
            if e != 0 && e - 1 != self_at {
                out.push(e - 1);
            }
        } else if c >= 48 && c <= 57 {
            while i < n && c_ident_byte(str_byte_at(text, i)) {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return out;
}

/// Split generated C with //@FN marks into one unit per source module. The
/// prelude's small runtime definitions move to the unit owning `main` (a
/// prototype stays); a global is defined there and `extern` elsewhere.
pub fn split_c_units(full: str) -> Vec<CUnit> {
    var full_len: i64 = str_len(full);
    var first: i64 = str_find(full, "\n//@FN ");
    var tail_at: i64 = str_find(full, "\n//@TAIL\n");
    var units: Vec<CUnit> = Vec::new();
    if first < 0 || tail_at < 0 {
        units.push(CUnit {
            name: "main", code: full
        });
        return units;
    }
    var prelude: str = str_slice(full, 0, first + 1);
    var tail: str = str_slice(full, tail_at + 9, str_len(full));
    // B1: with the IR units' assignment set (ccompile_inc_prepare), each
    // function goes to its IrUnit (c_unit_of_fn)
    var owner: str = c_unit_of_fn("main", func_module_of("main", "main"));
    var flat: bool = str_len(env_or_empty("FIDES_INC_FLAT")) > 0;
    if flat {
        owner = "main";
    }

    // Move the prelude's definitions to the tail; each prototype stands
    // where its definition stood (collecting them at the end broke macros
    // that expand into calls mid-prelude, like P_VEC_UNCHECKED).
    var spans: CDefSpans = inc_c_fn_defs(prelude);
    var stripped: StringBuilder = StringBuilder::new();
    var moved: StringBuilder = StringBuilder::new();
    var init_def: str = "";
    var cursor: i64 = 0;
    var si: i64 = 0;
    while si < spans.names.len() {
        var brace: i64 = spans.braces.get(si);
        // The header is the text from the last completed construct
        // (`;`, `}` or newline) to the `{`. Generated decls are one line
        // each; token stmt_start can't anchor them because bare macro
        // invocations like `P_ARITH(int8_t, i8)` have no `;`.
        var s: i64 = str_rfind(str_slice(prelude, 0, brace), "\n");
        var sc: i64 = str_rfind(str_slice(prelude, 0, brace), ";");
        var bc: i64 = str_rfind(str_slice(prelude, 0, brace), "}");
        if sc > s {
            s = sc;
        }
        if bc > s {
            s = bc;
        }
        s = s + 1;
        var header: str = str_trim(str_slice(prelude, s, brace));
        // `static` helpers stay: internal linkage can't cross a TU, so
        // every unit keeps its own copy (as P_VEC_UNCHECKED's callees).
        // B8: except the globals' initializer (codegen_c.fd
        // emit_global_init_function): it names the globals, defined or
        // declared after the prelude, and functions whose prototypes come
        // later too, and only main calls it: main's unit gets it, after
        // the globals (`init_def`); its forward declaration stays.
        if header == "static void __init_globals(void)" {
            stripped.append_str(str_slice(prelude, cursor, s));
            init_def = str_slice(prelude, s, spans.ends.get(si)) + "\n";
            cursor = spans.ends.get(si);
        } else if !str_starts_with(header, "static") {
            stripped.append_str(str_slice(prelude, cursor, s));
            stripped.append_str(header);
            stripped.append_str(";\n");
            moved.append_str(str_slice(prelude, s, spans.ends.get(si)));
            moved.append_str("\n");
            cursor = spans.ends.get(si);
        }
        si = si + 1;
    }
    stripped.append_str(str_slice(prelude, cursor, str_len(prelude)));
    tail = moved.to_str() + "\n" + tail;

    // Function bodies by unit; the C name of each fn is read off its
    // definition's first line (//@FN carries the source name, which
    // sanitization can rename — `main` emits as `main_entry`).
    var unit_names: Vec<str> = Vec::new();
    var fn_units: Vec<i64> = Vec::new();
    var fn_starts: Vec<i64> = Vec::new();
    var fn_ends: Vec<i64> = Vec::new();
    var fn_cnames: Vec<str> = Vec::new();
    var fn_snames: Vec<str> = Vec::new();
    // B3: offset of each fn's definition line (where a copy gets `static`)
    var fn_decl_at: Vec<i64> = Vec::new();
    var eq_in_main: bool = env_or_empty("FIDES_INC_EQ") == "main";
    var at: i64 = first + 1;
    while at < tail_at {
        var line_end: i64 = at;
        while str_byte_at(full, line_end) != 10 {
            line_end = line_end + 1;
        }
        var fname: str = str_slice_len(full, full_len, at + 6, line_end);
        var body_end: i64 = c_next_fn_mark(full, line_end, tail_at);
        var cname: str = "";
        var decl_at: i64 = -1;
        var dl: i64 = line_end + 1;
        while dl < body_end && cname == "" {
            var de: i64 = dl;
            while de < body_end && str_byte_at(full, de) != 10 {
                de = de + 1;
            }
            var dline: str = str_slice_len(full, full_len, dl, de);
            if str_find(dline, "(") >= 0 && !str_starts_with(str_trim(dline), "#") {
                cname = c_decl_name(dline);
                decl_at = dl;
            }
            dl = de + 1;
        }
        fn_cnames.push(cname);
        fn_snames.push(fname);
        fn_decl_at.push(decl_at);
        var unit: str = "main";
        if !flat {
            unit = c_unit_of_fn(fname, owner);
            // B2: FIDES_INC_EQ=main puts the `==` helpers back in main's
            // unit (the placement before record_func_modules knew them)
            if eq_in_main && str_starts_with(fname, "__eq_") {
                unit = owner;
            }
        }
        var slot: i64 = c_unit_slot(unit_names, unit);
        if slot < 0 {
            unit_names.push(unit);
            slot = unit_names.len() - 1;
        }
        fn_units.push(slot);
        fn_starts.push(line_end + 1);
        fn_ends.push(body_end);
        at = body_end;
    }
    // B3 (inc-roadmap): a generic instance moves to the unit of its caller
    // (c_place_instances_at_callers); FIDES_INC_INSTANCES=home keeps every
    // instance in the unit of the generic's module
    // (B1: the IR units place instances themselves, ccompile_inc_prepare;
    // the text of one unit does not show every caller)
    if !flat && env_or_empty("FIDES_INC_INSTANCES") != "home" && g_split_assign == 0 {
        c_place_instances_at_callers(full, full_len, fn_snames, fn_cnames, fn_starts, fn_ends, &mut fn_units);
    }
    // B3: an instance two or more units call gets a `static` copy in each
    // (c_copy_instances_to_callers; FIDES_INC_INSTANCES=move: the moves
    // above only). Needs per-unit prototypes, so not with
    // FIDES_INC_EFFECTS=off. copy_fn/copy_unit: function i is copied
    // (static) into unit u.
    var copy_fn: Vec<i64> = Vec::new();
    var copy_unit: Vec<i64> = Vec::new();
    var inst_mode: str = env_or_empty("FIDES_INC_INSTANCES");
    if !flat && inst_mode != "home" && inst_mode != "move" && env_or_empty("FIDES_INC_EFFECTS") != "off" && g_split_assign == 0 {
        c_copy_instances_to_callers(full, full_len, tail_at, fn_snames, fn_cnames, fn_starts, fn_ends, fn_decl_at, unit_names, &mut fn_units, &mut copy_fn, &mut copy_unit);
    }
    // B3 on the IR units: the copies ccompile_inc_prepare gave the unit
    // being cut (incu_copy_instances; its C holds their bodies)
    if g_split_assign != 0 && g_split_copies != 0 && str_len(g_split_only) > 0 {
        var cs: i64 = c_unit_slot(unit_names, g_split_only);
        if cs < 0 {
            unit_names.push(g_split_only);
            cs = unit_names.len() - 1;
        }
        var ck: i64 = 0;
        while ck < fn_snames.len() {
            if HashMap_get(g_split_copies, fn_snames.get(ck)) != 0 && fn_units.get(ck) != cs && str_len(fn_cnames.get(ck)) > 0 && fn_decl_at.get(ck) >= fn_starts.get(ck) {
                copy_fn.push(ck);
                copy_unit.push(cs);
            }
            ck = ck + 1;
        }
    }

    // Prelude lines: shared, global definitions, string constants. With
    // effect-scoped protos (C2/C9, on unless FIDES_INC_EFFECTS=off or a
    // flat split) a user-fn prototype leaves the shared prelude: each
    // unit re-emits only the protos its text names, so a signature edit
    // rebuilds just the units that call or define that fn.
    var scope: bool = !flat && env_or_empty("FIDES_INC_EFFECTS") != "off";
    var cname_set: i64 = HashMap_new();
    if scope {
        var ci: i64 = 0;
        while ci < fn_cnames.len() {
            if str_len(fn_cnames.get(ci)) > 0 {
                HashMap_insert(cname_set, fn_cnames.get(ci), 1);
            }
            ci = ci + 1;
        }
    }
    var proto_names: Vec<str> = Vec::new();
    var proto_lines: Vec<str> = Vec::new();
    var pre_common: StringBuilder = StringBuilder::new();
    var global_defs: Vec<str> = Vec::new();
    var global_externs: Vec<str> = Vec::new();
    var global_cnames: Vec<str> = Vec::new();
    // String constants: each unit declares only the ones its text names
    // (`str_decl_keys` holds the `_strN` name of each kept line).
    var str_decl_keys: Vec<str> = Vec::new();
    var str_decls: Vec<str> = Vec::new();
    // B2 (inc-roadmap): struct layouts and FFI extern declarations are
    // scoped per unit too (FIDES_INC_LAYOUTS=off: every unit carries them
    // all): a unit keeps the blocks its text, its prototypes, the shared
    // prelude or another kept block names, each at its place in the
    // prelude (`lay_pos`: offset in the shared text), so a struct or extern
    // added for one module changes only the units that use it.
    var lay_scope: bool = scope && env_or_empty("FIDES_INC_LAYOUTS") != "off";
    var lay_section: i64 = 0;
    var lay_text: Vec<str> = Vec::new();
    var lay_pos: Vec<i64> = Vec::new();
    var lay_is_struct: Vec<i64> = Vec::new();
    var lay_keys: Vec<str> = Vec::new();
    var lay_key_entry: Vec<i64> = Vec::new();
    var lay_prev_decl_line: i64 = -2;
    var common_len: i64 = 0;
    var lines: Vec<str> = str_split(stripped.to_str(), "\n");
    var li: i64 = 0;
    while li < lines.len() {
        var line: str = lines.get(li);
        var t: str = str_trim(line);
        if str_starts_with(t, "// ---") {
            lay_section = 0;
            if t == "// --- Struct definitions ---" {
                lay_section = 1;
            } else if t == "// --- User-defined extern declarations (FFI) ---" {
                lay_section = 2;
            }
        }
        if lay_scope && lay_section == 1 {
            var sk: str = c_struct_block_key(t);
            if str_len(sk) > 0 {
                var blk: StringBuilder = StringBuilder::new();
                blk.append_str(line);
                blk.append_str("\n");
                var lj: i64 = li + 1;
                var closed: bool = false;
                while lj < lines.len() && !closed {
                    blk.append_str(lines.get(lj));
                    blk.append_str("\n");
                    if str_starts_with(str_trim(lines.get(lj)), "}") {
                        closed = true;
                    }
                    lj = lj + 1;
                }
                if closed {
                    lay_text.push(blk.to_str());
                    lay_pos.push(common_len);
                    lay_is_struct.push(1);
                    lay_keys.push(sk);
                    lay_key_entry.push(lay_text.len() - 1);
                    li = lj;
                    continue;
                }
            }
        }
        if lay_scope && lay_section == 2 {
            var defn: Vec<str> = c_ffi_define_names(t);
            if defn.len() == 2 {
                var le: i64 = lay_text.len() - 1;
                if lay_prev_decl_line == li - 1 && le >= 0 && lay_keys.get(lay_keys.len() - 1) == defn.get(1) {
                    // `#define pledge c_name` after the decl of c_name
                    lay_text.set(le, lay_text.get(le) + line + "\n");
                } else {
                    lay_text.push(line + "\n");
                    lay_pos.push(common_len);
                    lay_is_struct.push(0);
                    le = lay_text.len() - 1;
                }
                lay_keys.push(defn.get(0));
                lay_key_entry.push(le);
                li = li + 1;
                continue;
            }
            if str_ends_with(t, ");") && !str_starts_with(t, "#") && !str_starts_with(t, "//") && str_find(t, "{") < 0 {
                var dn: str = c_decl_name(t);
                if str_len(dn) > 0 {
                    lay_text.push(line + "\n");
                    lay_pos.push(common_len);
                    lay_is_struct.push(0);
                    lay_keys.push(dn);
                    lay_key_entry.push(lay_text.len() - 1);
                    lay_prev_decl_line = li;
                    li = li + 1;
                    continue;
                }
            }
        }
        var is_proto: bool = false;
        if scope && str_ends_with(t, ";") && !str_starts_with(t, "#") && !str_starts_with(t, "//") {
            var pn: str = c_decl_name(t);
            if str_len(pn) > 0 && HashMap_get(cname_set, pn) != 0 {
                proto_names.push(pn);
                proto_lines.push(line);
                is_proto = true;
            }
        }
        var str_key: str = "";
        if !is_proto {
            str_key = c_str_decl_key(t);
        }
        if is_proto {
        } else if str_len(str_key) > 0 {
            // Before the `_g_` test: a literal's text may contain " _g_"
            str_decls.push(line);
            str_decl_keys.push(str_key);
        } else if str_starts_with(t, "static ") && str_contains(t, " _g_") {
            var decl: str = str_slice(t, 7, str_len(t));
            var eq: i64 = str_find(decl, " = ");
            if eq >= 0 {
                decl = str_slice(decl, 0, eq);
            }
            if str_ends_with(decl, ";") {
                decl = str_slice(decl, 0, str_len(decl) - 1);
            }
            // B8: main's unit defines the global with its initializer
            // (`var g: i64 = 7` read 0 in an --inc build: the definition
            // had lost `= 7LL`); the others declare it
            var gdef: str = str_slice(t, 7, str_len(t));
            if !str_ends_with(gdef, ";") {
                gdef = gdef + ";";
            }
            global_defs.push(gdef);
            global_externs.push("extern " + decl + ";");
            // B6: the global's C name (another unit declares it only when
            // its text names it)
            var gnp: i64 = str_rfind(decl, " _g_") + 1;
            var gne: i64 = gnp;
            while gne < str_len(decl) && c_ident_byte(str_byte_at(decl, gne)) {
                gne = gne + 1;
            }
            global_cnames.push(str_slice(decl, gnp, gne));
        } else {
            pre_common.append_str(line);
            pre_common.append_str("\n");
            common_len = common_len + str_len(line) + 1;
        }
        li = li + 1;
    }
    var common: str = pre_common.to_str();
    // What the shared prelude itself calls (P_STR_DUP/P_STR_DROP expand to
    // Str_dup/Str_drop): every unit needs those prototypes too
    var pre_idents: i64 = HashMap_new();
    if scope {
        c_collect_idents(common, pre_idents);
    }
    // B2: what the shared text names (kept in every unit), and which
    // scoped block names which (a struct field of another struct's type,
    // an extern's parameter type)
    var lay_base: i64 = HashMap_new();
    var lay_ref_from: Vec<i64> = Vec::new();
    var lay_ref_to: Vec<i64> = Vec::new();
    if lay_text.len() > 0 {
        c_collect_idents(common, lay_base);
        // (the types of the globals a unit declares join that unit's
        // names below, B6: not every unit's)
        var key_at: i64 = HashMap_new();
        var lk: i64 = 0;
        while lk < lay_keys.len() {
            HashMap_insert(key_at, lay_keys.get(lk), lay_key_entry.get(lk) + 1);
            lk = lk + 1;
        }
        var le2: i64 = 0;
        while le2 < lay_text.len() {
            var refs: Vec<i64> = c_entry_refs(lay_text.get(le2), key_at, le2);
            var ri: i64 = 0;
            while ri < refs.len() {
                lay_ref_from.push(le2);
                lay_ref_to.push(refs.get(ri));
                ri = ri + 1;
            }
            le2 = le2 + 1;
        }
    }

    // Units, sorted by name
    var order: Vec<i64> = Vec::new();
    var oi: i64 = 0;
    while oi < unit_names.len() {
        order.push(oi);
        var k: i64 = order.len() - 1;
        while k > 0 && str_compare(unit_names.get(order.get(k)), unit_names.get(order.get(k - 1))) < 0 {
            var tmp: i64 = order.get(k);
            order.set(k, order.get(k - 1));
            order.set(k - 1, tmp);
            k = k - 1;
        }
        oi = oi + 1;
    }
    oi = 0;
    while oi < order.len() {
        var idx: i64 = order.get(oi);
        // B1: the C of one IR unit keeps only that unit (incu_unit_c)
        if str_len(g_split_only) > 0 && unit_names.get(idx) != g_split_only {
            oi = oi + 1;
            continue;
        }
        var body_sb: StringBuilder = StringBuilder::new();
        var fi: i64 = 0;
        while fi < fn_units.len() {
            if fn_units.get(fi) == idx {
                body_sb.append_str(str_slice_len(full, full_len, fn_starts.get(fi), fn_ends.get(fi)));
            }
            fi = fi + 1;
        }
        // B3: the `static` copies of instances this unit calls (their
        // prototypes below get `static` too: static_here, C name -> 1)
        var static_here: i64 = HashMap_new();
        var cpi: i64 = 0;
        while cpi < copy_fn.len() {
            if copy_unit.get(cpi) == idx {
                var cf: i64 = copy_fn.get(cpi);
                var cd: i64 = fn_decl_at.get(cf);
                body_sb.append_str(str_slice_len(full, full_len, fn_starts.get(cf), cd));
                body_sb.append_str("static ");
                body_sb.append_str(str_slice_len(full, full_len, cd, fn_ends.get(cf)));
                HashMap_insert(static_here, fn_cnames.get(cf), 1);
            }
            cpi = cpi + 1;
        }
        var body: str = body_sb.to_str();
        var used: i64 = HashMap_new();
        c_collect_str_names(body, used);
        if unit_names.get(idx) == owner {
            c_collect_str_names(tail, used);
            c_collect_str_names(init_def, used);
            var gsn: i64 = 0;
            while gsn < global_defs.len() {
                c_collect_str_names(global_defs.get(gsn), used);
                gsn = gsn + 1;
            }
        }
        var code: StringBuilder = StringBuilder::new();
        var idents: i64 = 0;
        if scope {
            idents = HashMap_new();
            c_collect_idents(body, idents);
            if unit_names.get(idx) == owner {
                c_collect_idents(tail, idents);
                c_collect_idents(init_def, idents);
            }
            // B6: the types of the globals this unit declares (all of
            // them in main's unit, else the ones its text names)
            var gt: i64 = 0;
            while gt < global_defs.len() {
                if unit_names.get(idx) == owner || HashMap_get(idents, global_cnames.get(gt)) != 0 || HashMap_get(pre_idents, global_cnames.get(gt)) != 0 {
                    c_collect_idents(global_defs.get(gt), idents);
                }
                gt = gt + 1;
            }
        }
        if lay_text.len() > 0 {
            // B2: the blocks this unit needs: named by its text, by a
            // prototype it carries or by the shared text, then what those
            // name, until nothing is added
            var p_idents: i64 = HashMap_new();
            var pp: i64 = 0;
            while pp < proto_lines.len() {
                if HashMap_get(idents, proto_names.get(pp)) != 0 || HashMap_get(pre_idents, proto_names.get(pp)) != 0 {
                    c_collect_idents(proto_lines.get(pp), p_idents);
                }
                pp = pp + 1;
            }
            var need: Vec<i64> = Vec::new();
            var ne: i64 = 0;
            while ne < lay_text.len() {
                need.push(0);
                ne = ne + 1;
            }
            var nk: i64 = 0;
            while nk < lay_keys.len() {
                var kn: str = lay_keys.get(nk);
                if HashMap_get(idents, kn) != 0 || HashMap_get(p_idents, kn) != 0 || HashMap_get(lay_base, kn) != 0 {
                    need.set(lay_key_entry.get(nk), 1);
                }
                nk = nk + 1;
            }
            var grew: bool = true;
            while grew {
                grew = false;
                var nr: i64 = 0;
                while nr < lay_ref_from.len() {
                    if need.get(lay_ref_from.get(nr)) == 1 && need.get(lay_ref_to.get(nr)) == 0 {
                        need.set(lay_ref_to.get(nr), 1);
                        grew = true;
                    }
                    nr = nr + 1;
                }
            }
            var cpos: i64 = 0;
            var n_struct: i64 = 0;
            var n_struct_all: i64 = 0;
            var n_ext: i64 = 0;
            var ce: i64 = 0;
            while ce < lay_text.len() {
                var cp: i64 = lay_pos.get(ce);
                if cp > cpos {
                    code.append_str(str_slice(common, cpos, cp));
                    cpos = cp;
                }
                if lay_is_struct.get(ce) == 1 {
                    n_struct_all = n_struct_all + 1;
                }
                if need.get(ce) == 1 {
                    code.append_str(lay_text.get(ce));
                    if lay_is_struct.get(ce) == 1 {
                        n_struct = n_struct + 1;
                    } else {
                        n_ext = n_ext + 1;
                    }
                }
                ce = ce + 1;
            }
            code.append_str(str_slice(common, cpos, str_len(common)));
            // (B1: an IR unit's line is ccompile_inc_prepare's, over the
            // whole program's layouts)
            if str_len(env_or_empty("FIDES_INC_DEBUG")) > 0 && str_len(g_split_only) == 0 {
                p_eprint_str("[inc] layouts " + unit_names.get(idx) + ": " + int_to_str(n_struct) + " of " + int_to_str(n_struct_all) + " structs, " + int_to_str(n_ext) + " of " + int_to_str(lay_text.len() - n_struct_all) + " externs\n");
            }
        } else {
            code.append_str(common);
        }
        if scope {
            var pi: i64 = 0;
            var n_proto: i64 = 0;
            while pi < proto_lines.len() {
                if HashMap_get(idents, proto_names.get(pi)) != 0 || HashMap_get(pre_idents, proto_names.get(pi)) != 0 {
                    if HashMap_get(static_here, proto_names.get(pi)) != 0 {
                        // B3: this unit defines its own static copy
                        code.append_str("static ");
                        code.append_str(str_trim(proto_lines.get(pi)));
                    } else {
                        code.append_str(proto_lines.get(pi));
                    }
                    code.append_str("\n");
                    n_proto = n_proto + 1;
                }
                pi = pi + 1;
            }
            // The effect-edge table, inspectable (inc-roadmap C1, as
            // fidesc): unit -> how many of the protos it names.
            if str_len(env_or_empty("FIDES_INC_DEBUG")) > 0 {
                p_eprint_str("[inc] unit " + unit_names.get(idx) + ": " + int_to_str(n_proto) + " of " + int_to_str(proto_lines.len()) + " protos\n");
            }
        }
        var d: i64 = 0;
        while d < str_decls.len() {
            if HashMap_get(used, str_decl_keys.get(d)) != 0 {
                code.append_str(str_decls.get(d));
                code.append_str("\n");
            }
            d = d + 1;
        }
        var g: i64 = 0;
        while g < global_defs.len() {
            if unit_names.get(idx) == owner {
                code.append_str(global_defs.get(g));
                code.append_str("\n");
            } else if !scope || HashMap_get(idents, global_cnames.get(g)) != 0 || HashMap_get(pre_idents, global_cnames.get(g)) != 0 {
                // B6: another unit declares only the globals its text
                // names, so its C does not change with the program's other
                // globals (a seeded store's core object fits any program)
                code.append_str(global_externs.get(g));
                code.append_str("\n");
            }
            g = g + 1;
        }
        // B8: the globals' initializer, after the globals it sets
        if unit_names.get(idx) == owner {
            code.append_str(init_def);
        }
        code.append_str(body);
        if unit_names.get(idx) == owner {
            code.append_str(tail);
        }
        units.push(CUnit {
            name: unit_names.get(idx), code: code.to_str()
        });
        oi = oi + 1;
    }
    return units;
}

// --- B1 (inc-roadmap): C per IrUnit for `ccompile --inc` -------------------
//
// `ccompile --inc` cuts the lowered program into lower.fd's IrUnits
// (ir_units_split: one per source module, generic instances moved to their
// callers as B3 does) and generates each unit's C from that unit alone: its
// own functions, a stub of every function it imports (name, parameters and
// return type: the C generator writes its prototype and casts calls by it),
// and only the tables the C generator reads (extern declarations, C
// callbacks, globals), with only the struct layouts the unit names (B2).
// Each object is keyed by that input, serialized as IrUnit.key is (ir_ser
// bytes), with the build's flags: a unit whose key has an object is neither
// generated nor compiled, so a body edit in one module generates and
// compiles that module's unit only. A stub of a function another unit
// defines carries no body, so no other unit's body is part of a key.
// The unit owning `main` also writes the tail (C main, the runtime, the
// table of functions for panic traces and lookups by name): it has a stub
// of every function and registers and lists all of them
// (set_c_register_all), so its C depends on the other units' signatures,
// not on their bodies (a function that loads libraries, p_dl_*, keeps its
// body there: the tail writes the loader only for a program that calls
// it). The text of one unit's C is then cut by split_c_units with the
// units' assignment (c_unit_of_fn), keeping that unit only: the prelude's
// definitions and the globals' definitions stay in main's unit, and a
// unit declares only the prototypes, literals and layouts its text names.
// FIDES_INC_IR=off (or FIDES_INC_FLAT): the whole program's C, cut by
// split_c_units, as before.

var g_incu_ready: bool = false;
var g_incu_names: Vec<str> = Vec::new();
var g_incu_keys: Vec<i64> = Vec::new();
var g_incu_mods: Vec<IrModule> = Vec::new();
var g_incu_owner: str = "";
var g_incu_estimate: i64 = 0;
// split_c_units: the unit of each function (name -> index + 1 into
// g_split_assign_names; 0: func_module_of decides) and the only unit it
// returns ("" = every unit)
var g_split_assign: i64 = 0;
var g_split_assign_names: Vec<str> = Vec::new();
var g_split_only: str = "";
// B3: the instances unit i holds a `static` copy of (one name per line),
// and for the unit incu_unit_c cuts, the same names (name -> 1; 0: none)
var g_incu_copies: Vec<str> = Vec::new();
var g_split_copies: i64 = 0;

/// The unit split_c_units puts function `name` in: its IR unit while
/// ccompile_inc_prepare's assignment is set, else its module.
fn c_unit_of_fn(name: str, fallback: str) -> str {
    if g_split_assign != 0 {
        var s: i64 = HashMap_get(g_split_assign, name);
        if s != 0 {
            return g_split_assign_names.get(s - 1);
        }
        return fallback;
    }
    return func_module_of(name, fallback);
}

/// Whether `ccompile --inc` generates C per IrUnit (not with
/// FIDES_INC_IR=off or FIDES_INC_FLAT: then the program's C is cut).
pub fn incu_on() -> bool {
    return env_or_empty("FIDES_INC_IR") != "off" && str_len(env_or_empty("FIDES_INC_FLAT")) == 0;
}

/// Whether ccompile_inc_prepare made the units of this build.
pub fn incu_ready() -> bool {
    return g_incu_ready;
}

pub fn incu_count() -> i64 {
    return g_incu_names.len();
}

pub fn incu_name(i: i64) -> str {
    return g_incu_names.get(i);
}

/// The object key of unit `i`.
pub fn incu_key(i: i64) -> i64 {
    return g_incu_keys.get(i);
}

/// Whether unit `i` owns `main` (its object is this program's alone: B6
/// seeds a store with the other units' objects only).
pub fn incu_is_owner(i: i64) -> bool {
    return g_incu_names.get(i) == g_incu_owner;
}

/// An estimate of the size of the program's C, in bytes (cmd_ccompile
/// compiles a program of more than 16 MB of C at -O0).
pub fn incu_c_estimate() -> i64 {
    return g_incu_estimate;
}

/// Forget an earlier build's units (split_c_units cuts by module again).
pub fn incu_reset() {
    g_incu_ready = false;
    g_incu_names = Vec::new();
    g_incu_keys = Vec::new();
    g_incu_mods = Vec::new();
    g_incu_owner = "";
    g_incu_estimate = 0;
    if g_split_assign != 0 {
        HashMap_drop(g_split_assign);
        g_split_assign = 0;
    }
    g_split_assign_names = Vec::new();
    g_split_only = "";
    g_incu_copies = Vec::new();
    if g_split_copies != 0 {
        HashMap_drop(g_split_copies);
        g_split_copies = 0;
    }
}

@wrapping
fn incu_hash(v: Vec<i64>, seed: i64) -> i64 {
    var h: i64 = 1469598103934665603 ^ seed;
    var i: i64 = 0;
    while i < v.len() {
        h = (h ^ v.get(i)) * 1099511628211;
        i = i + 1;
    }
    return h;
}

/// What `f` names: the functions it calls or takes the address of (to
/// `names`), the methods of its dynamic calls (to `dyns`); true when it
/// calls the library loader (p_dl_*).
fn incu_named(f: &IrFunction, names: &mut Vec<str>, dyns: &mut Vec<str>) -> bool {
    var dl: bool = false;
    var i: i64 = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Call(cn, _, _, _) => {
                names.push(cn);
                if cn == "p_dl_load" || cn == "p_dl_find" || cn == "p_dl_unload" {
                    dl = true;
                }
            }
            Inst::ConstFnRef(rn) => {
                names.push(c_fn_target(rn));
            }
            Inst::DynCall(_, method, _, _, _) => {
                dyns.push(method);
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return dl;
}

/// B6: the globals `f` addresses, into `set` (name -> 1).
fn incu_globals_named(f: &IrFunction, set: i64) {
    var i: i64 = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::GlobalAddr(gn, _) => {
                HashMap_insert(set, gn, 1);
            }
            _ => {
            }
        }
        i = i + 1;
    }
}

/// The function of `fe` with its signature only (one empty block), so a
/// unit that imports it gets its prototype and nothing of its body.
fn incu_stub(fe: &IrFunctionEntry) -> IrFunctionEntry {
    var f: IrFunction = IrFunction_new(fe.func.name, fe.func.ret_ty);
    f.params = fe.func.params;
    var nv: i64 = 0;
    var p: i64 = 0;
    while p < f.params.len() {
        if f.params.get(p).id + 1 > nv {
            nv = f.params.get(p).id + 1;
        }
        p = p + 1;
    }
    f.next_value = nv;
    return IrFunctionEntry_new(fe.name, f);
}

/// The struct names in type `t`.
fn incu_type_names(t: IrType, out: &mut Vec<str>) {
    match t {
        IrType::Struct(n) => {
            out.push(n);
        }
        IrType::Opaque(n) => {
            out.push(n);
        }
        IrType::Ptr(inner) => {
            incu_type_names(cc_box_ir_type_unbox(inner), out);
        }
        IrType::Array(inner, _) => {
            incu_type_names(cc_box_ir_type_unbox(inner), out);
        }
        IrType::Generic(n, args) => {
            out.push(n);
            var i: i64 = 0;
            while i < args.len() {
                incu_type_names(args.get(i), out);
                i = i + 1;
            }
        }
        _ => {
        }
    }
}

/// B2 at the IR level: the struct layouts (indexes into
/// `module.struct_layouts`, in order) whose name is a string of `bytes`,
/// with the layouts their fields name, and so on. ir_ser writes a string
/// as its length (8 bytes, low first) and its bytes, so every type, field
/// and name the unit holds is found; an integer that happens to look like
/// a name only keeps one layout too many.
fn incu_layouts_named(bytes: Vec<i64>, module: &IrModule, lay_at: i64, max_len: i64) -> Vec<i64> {
    var nl: i64 = module.struct_layouts.len();
    var need: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nl {
        need.push(0);
        i = i + 1;
    }
    var work: Vec<i64> = Vec::new();
    var n: i64 = bytes.len();
    var p: i64 = 0;
    while p + 8 < n {
        var len: i64 = bytes.get(p);
        if len >= 1 && len <= max_len && p + 8 + len <= n && bytes.get(p + 1) == 0 && bytes.get(p + 2) == 0 && bytes.get(p + 3) == 0 && bytes.get(p + 4) == 0 && bytes.get(p + 5) == 0 && bytes.get(p + 6) == 0 && bytes.get(p + 7) == 0 {
            var cand: Vec<i64> = Vec::new();
            var k: i64 = 0;
            var ok: bool = true;
            while ok && k < len {
                var c: i64 = bytes.get(p + 8 + k);
                if c <= 32 || c >= 127 {
                    ok = false;
                } else {
                    cand.push(c);
                }
                k = k + 1;
            }
            if ok {
                var at: i64 = HashMap_get(lay_at, str_from_bytes(cand));
                if at != 0 && need.get(at - 1) == 0 {
                    need.set(at - 1, 1);
                    work.push(at - 1);
                }
            }
        }
        p = p + 1;
    }
    while work.len() > 0 {
        var li: i64 = work.get(work.len() - 1);
        work.pop();
        var sl: StructLayout = module.struct_layouts.get(li).layout;
        var fi: i64 = 0;
        while fi < sl.fields.len() {
            var tn: Vec<str> = Vec::new();
            incu_type_names(sl.fields.get(fi).ty, &mut tn);
            var ti: i64 = 0;
            while ti < tn.len() {
                var at2: i64 = HashMap_get(lay_at, tn.get(ti));
                if at2 != 0 && need.get(at2 - 1) == 0 {
                    need.set(at2 - 1, 1);
                    work.push(at2 - 1);
                }
                ti = ti + 1;
            }
            fi = fi + 1;
        }
    }
    var out: Vec<i64> = Vec::new();
    i = 0;
    while i < nl {
        if need.get(i) == 1 {
            out.push(i);
        }
        i = i + 1;
    }
    return out;
}

/// B3 at the IR level (as c_place_instances_at_callers on the C text): a
/// generic instance moves to the unit of the functions that name it (a
/// call, a function reference, a dynamic call of its method) when those
/// are all in one unit other than its generic's own; an instance calling
/// another moves that one along, until nothing moves (8 rounds at most).
/// `units`: each function's unit number.
fn incu_place_instances(module: &IrModule, units: &mut Vec<i64>) {
    var n: i64 = module.functions.len();
    var pos: i64 = HashMap_new();
    var is_inst: Vec<i64> = Vec::new();
    var home: Vec<i64> = Vec::new();
    var inst_ix: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var nm: str = module.functions.get(i).name;
        if HashMap_get(pos, nm) == 0 {
            HashMap_insert(pos, nm, i + 1);
        }
        home.push(units.get(i));
        if func_is_instance(nm) {
            is_inst.push(1);
            inst_ix.push(i);
        } else {
            is_inst.push(0);
        }
        i = i + 1;
    }
    if inst_ix.len() == 0 {
        HashMap_drop(pos);
        return;
    }
    var e_from: Vec<i64> = Vec::new();
    var e_to: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        var fe: IrFunctionEntry = module.functions.get(i);
        var names: Vec<str> = Vec::new();
        var dyns: Vec<str> = Vec::new();
        incu_named(&fe.func, &mut names, &mut dyns);
        var k: i64 = 0;
        while k < names.len() {
            var t: i64 = HashMap_get(pos, names.get(k)) - 1;
            if t >= 0 && t != i && is_inst.get(t) == 1 {
                e_from.push(i);
                e_to.push(t);
            }
            k = k + 1;
        }
        var d: i64 = 0;
        while d < dyns.len() {
            var suffix: str = "_" + dyns.get(d);
            var j: i64 = 0;
            while j < inst_ix.len() {
                var t2: i64 = inst_ix.get(j);
                if t2 != i && str_ends_with(module.functions.get(t2).name, suffix) {
                    e_from.push(i);
                    e_to.push(t2);
                }
                j = j + 1;
            }
            d = d + 1;
        }
        i = i + 1;
    }
    HashMap_drop(pos);
    var round: i64 = 0;
    var changed: bool = true;
    while changed && round < 8 && e_from.len() > 0 {
        changed = false;
        var first_u: Vec<i64> = Vec::new();
        var multi: Vec<i64> = Vec::new();
        var home_calls: Vec<i64> = Vec::new();
        i = 0;
        while i < n {
            first_u.push(-1);
            multi.push(0);
            home_calls.push(0);
            i = i + 1;
        }
        var ei: i64 = 0;
        while ei < e_from.len() {
            var j2: i64 = e_to.get(ei);
            var u: i64 = units.get(e_from.get(ei));
            if u == home.get(j2) {
                home_calls.set(j2, 1);
            } else if first_u.get(j2) < 0 {
                first_u.set(j2, u);
            } else if first_u.get(j2) != u {
                multi.set(j2, 1);
            }
            ei = ei + 1;
        }
        i = 0;
        while i < n {
            if is_inst.get(i) == 1 {
                var target: i64 = home.get(i);
                if home_calls.get(i) == 0 && multi.get(i) == 0 && first_u.get(i) >= 0 {
                    target = first_u.get(i);
                }
                if units.get(i) != target {
                    units.set(i, target);
                    changed = true;
                }
            }
            i = i + 1;
        }
        round = round + 1;
    }
    if str_len(env_or_empty("FIDES_INC_DEBUG")) > 0 {
        var moved: i64 = 0;
        i = 0;
        while i < n {
            if units.get(i) != home.get(i) {
                moved = moved + 1;
            }
            i = i + 1;
        }
        p_eprint_str("[inc] ir instances: " + int_to_str(moved) + " of " + int_to_str(inst_ix.len()) + " placed in their caller's unit\n");
    }
}

/// LF18 before any C is written: the @constant_time violations of `module`
/// (as the C generator reports them; FID_C_CT_OFF=1: none).
fn incu_ct_errors(module: &IrModule) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var sw: str = p_getenv("FID_C_CT_OFF");
    if (sw as i64) != 0 && str_len(sw) > 0 && sw != "0" {
        return out;
    }
    var f: i64 = 0;
    while f < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(f);
        if entry.func.is_constant_time {
            var cfunc: IrFunction = entry.func;
            var errs: Vec<str> = cg_ct_check(&cfunc, entry.name);
            var i: i64 = 0;
            while i < errs.len() {
                out.push("C backend: @constant_time violated: " + errs.get(i));
                i = i + 1;
            }
        }
        f = f + 1;
    }
    return out;
}

/// `ix` ordered by `names` (names.get(k) is the name of ix.get(k)), a
/// stable merge sort.
fn incu_sort_by_name(ix: Vec<i64>, names: Vec<str>) -> Vec<i64> {
    var n: i64 = ix.len();
    var a: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        a.push(i);
        i = i + 1;
    }
    var width: i64 = 1;
    while width < n {
        var b: Vec<i64> = Vec::new();
        var lo: i64 = 0;
        while lo < n {
            var mid: i64 = lo + width;
            if mid > n {
                mid = n;
            }
            var hi: i64 = lo + width * 2;
            if hi > n {
                hi = n;
            }
            var p: i64 = lo;
            var q: i64 = mid;
            while p < mid || q < hi {
                if q >= hi || (p < mid && str_compare(names.get(a.get(p)), names.get(a.get(q))) <= 0) {
                    b.push(a.get(p));
                    p = p + 1;
                } else {
                    b.push(a.get(q));
                    q = q + 1;
                }
            }
            lo = hi;
        }
        a = b;
        width = width * 2;
    }
    var out: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        out.push(ix.get(a.get(i)));
        i = i + 1;
    }
    return out;
}

fn incu_all_digits(s: str) -> bool {
    if str_len(s) == 0 {
        return false;
    }
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c < 48 || c > 57 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// B6 (2g.91): the lowering numbers the own types' functions
/// (`__own_drop_<i>`, `__own_dup_<i>`) in the order it meets the types, so
/// core's calls to the ones of core's types changed with the rest of the
/// program (a struct of the program met first renumbered them) and so did
/// core's unit key: a fresh project never found core's object in a seeded
/// store. They are named after their type's key instead
/// (`__own_dup_t<hash>`, lower.fd lw_own_type_keys): one renaming of
/// function names over the whole module, the same in every function, so
/// the program does what it did. Nothing is renamed when a key is missing
/// or two names would meet. FIDES_INC_OWN_NAMES=index: the lowering's
/// numbers.
fn incu_canon_own_names(module: &mut IrModule) {
    if env_or_empty("FIDES_INC_OWN_NAMES") == "index" {
        return;
    }
    var keys: Vec<str> = lw_own_type_keys();
    var n: i64 = module.functions.len();
    var names: i64 = HashMap_new();
    var i: i64 = 0;
    while i < n {
        HashMap_insert(names, module.functions.get(i).name, 1);
        i = i + 1;
    }
    // old name -> index + 1 into new_names
    var ren: i64 = HashMap_new();
    var new_names: Vec<str> = Vec::new();
    var taken: i64 = HashMap_new();
    var ok: bool = true;
    i = 0;
    while i < n && ok {
        var nm: str = module.functions.get(i).name;
        var pre: str = "";
        if str_starts_with(nm, "__own_dup_") {
            pre = "__own_dup_";
        } else if str_starts_with(nm, "__own_drop_") {
            pre = "__own_drop_";
        }
        if str_len(pre) > 0 && HashMap_get(ren, nm) == 0 {
            var rest: str = str_slice(nm, str_len(pre), str_len(nm));
            if incu_all_digits(rest) {
                var ix: i64 = str_parse_int(rest);
                if ix < 0 || ix >= keys.len() {
                    ok = false;
                } else {
                    var h: i64 = hash_source(keys.get(ix)) & 0x7FFFFFFFFFFFFFFF;
                    var nn: str = pre + "t" + int_to_str(h);
                    if HashMap_get(names, nn) != 0 || HashMap_get(taken, nn) != 0 {
                        ok = false;
                    } else {
                        HashMap_insert(taken, nn, 1);
                        new_names.push(nn);
                        HashMap_insert(ren, nm, new_names.len());
                    }
                }
            }
        }
        i = i + 1;
    }
    if ok && new_names.len() > 0 {
        i = 0;
        while i < n {
            var fe: IrFunctionEntry = module.functions.get(i);
            var changed: bool = false;
            var at: i64 = HashMap_get(ren, fe.name);
            if at != 0 {
                fe.name = new_names.get(at - 1);
                fe.func.name = new_names.get(at - 1);
                changed = true;
            }
            var k: i64 = 0;
            while k < fe.func.insts.len() {
                var vi: ValueIdInst = fe.func.insts.get(k);
                match vi.inst {
                    Inst::Call(cn, ca, ct, ce) => {
                        var to: i64 = HashMap_get(ren, cn);
                        if to != 0 {
                            IrFunction_set_inst(&mut fe.func, vi.id, Inst::Call(new_names.get(to - 1), ca, ct, ce));
                            changed = true;
                        }
                    }
                    _ => {
                    }
                }
                k = k + 1;
            }
            if changed {
                module.functions.set(i, fe);
            }
            i = i + 1;
        }
        var ei: i64 = 0;
        while ei < module.function_effects.len() {
            var ee: StringEffectSetEntry = module.function_effects.get(ei);
            var ea: i64 = HashMap_get(ren, ee.name);
            if ea != 0 {
                ee.name = new_names.get(ea - 1);
                module.function_effects.set(ei, ee);
            }
            ei = ei + 1;
        }
        HashMap_clear(module.fn_index);
    }
    HashMap_drop(names);
    HashMap_drop(ren);
    HashMap_drop(taken);
}

/// The functions the C runtime or the generated C calls by name without an
/// IR call (as codegen_c.fd cg_runtime_root).
fn incu_runtime_root(name: str) -> bool {
    return name == "Vec_to_str" || name == "HashMap_to_str" || name == "Str_dup" || name == "Str_drop" || name == "Vec_new" || name == "HashMap_new" || name == "Vec_push" || name == "Vec_get" || name == "Vec_set" || name == "Vec_len" || name == "Vec_pop" || name == "Vec_is_empty" || name == "Vec_filled_typed";
}

fn incu_live_push(pos: i64, live: i64, work: &mut Vec<i64>, name: str) {
    if HashMap_get(live, name) != 0 {
        return;
    }
    var at: i64 = HashMap_get(pos, name);
    if at == 0 {
        return;
    }
    HashMap_insert(live, name, 1);
    work.push(at - 1);
}

/// What a run of the whole program can reach, as codegen_c.fd
/// cg_compute_live finds it in a single TU: main (everything without one),
/// the functions a string or a function reference names anywhere, C
/// callbacks and the runtime's roots, then through calls, function
/// references, strings and dynamic calls (every `<Type>_<method>`). A map
/// name -> 1.
fn incu_live(module: &IrModule) -> i64 {
    var n: i64 = module.functions.len();
    var pos: i64 = HashMap_new();
    var named: i64 = HashMap_new();
    var main_found: bool = false;
    var i: i64 = 0;
    while i < n {
        var fe: IrFunctionEntry = module.functions.get(i);
        if HashMap_get(pos, fe.name) == 0 {
            HashMap_insert(pos, fe.name, i + 1);
        }
        if fe.name == "main" {
            main_found = true;
        }
        var k: i64 = 0;
        while k < fe.func.insts.len() {
            match fe.func.insts.get(k).inst {
                Inst::ConstStr(sv) => {
                    if str_len(sv) > 0 && str_len(sv) < 256 {
                        HashMap_insert(named, sv, 1);
                    }
                }
                Inst::ConstFnRef(rn) => {
                    HashMap_insert(named, rn, 1);
                    HashMap_insert(named, c_fn_target(rn), 1);
                }
                _ => {
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    var live: i64 = HashMap_new();
    var work: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        var rn2: str = module.functions.get(i).name;
        if !main_found || rn2 == "main" || incu_runtime_root(rn2) || HashMap_get(named, rn2) != 0 {
            incu_live_push(pos, live, &mut work, rn2);
        }
        i = i + 1;
    }
    var cb: i64 = 0;
    while cb < module.c_callbacks.len() {
        incu_live_push(pos, live, &mut work, module.c_callbacks.get(cb));
        cb = cb + 1;
    }
    var dyn_done: i64 = HashMap_new();
    while work.len() > 0 {
        var at: i64 = work.get(work.len() - 1);
        work.pop();
        var we: IrFunctionEntry = module.functions.get(at);
        var k2: i64 = 0;
        while k2 < we.func.insts.len() {
            match we.func.insts.get(k2).inst {
                Inst::Call(cn, _, _, _) => {
                    incu_live_push(pos, live, &mut work, cn);
                }
                Inst::ConstFnRef(fr) => {
                    incu_live_push(pos, live, &mut work, c_fn_target(fr));
                }
                Inst::ConstStr(sv2) => {
                    if str_len(sv2) > 0 && str_len(sv2) < 256 {
                        incu_live_push(pos, live, &mut work, sv2);
                    }
                }
                Inst::DynCall(_, method, _, _, _) => {
                    if HashMap_get(dyn_done, method) == 0 {
                        HashMap_insert(dyn_done, method, 1);
                        var suffix: str = "_" + method;
                        var di: i64 = 0;
                        while di < n {
                            var dn: str = module.functions.get(di).name;
                            if str_ends_with(dn, suffix) {
                                incu_live_push(pos, live, &mut work, dn);
                            }
                            di = di + 1;
                        }
                    }
                }
                _ => {
                }
            }
            k2 = k2 + 1;
        }
    }
    HashMap_drop(dyn_done);
    HashMap_drop(named);
    HashMap_drop(pos);
    return live;
}

/// B3 on the IR units (as c_copy_instances_to_callers on the C text): an
/// instance that two or more units call, that its generic's unit does not
/// call and whose address is not taken (a function reference, a string
/// naming it, a dynamic call's method), has its definition in the calling
/// unit first by name and a `static` copy in each other calling unit; a
/// copy's instance callees count as called from the copy's unit, so they
/// are placed the same way (16 rounds at most). `units`: each function's
/// unit (definitions move); copy_fn/copy_unit: function i gets a static
/// copy in unit u.
fn incu_copy_instances(module: &IrModule, unames: Vec<str>, units: &mut Vec<i64>, copy_fn: &mut Vec<i64>, copy_unit: &mut Vec<i64>) {
    var n: i64 = module.functions.len();
    var nu: i64 = unames.len();
    if nu < 2 {
        return;
    }
    var pos: i64 = HashMap_new();
    var kidx: Vec<i64> = Vec::new();
    var inst_fn: Vec<i64> = Vec::new();
    var home: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var nm: str = module.functions.get(i).name;
        if HashMap_get(pos, nm) == 0 {
            HashMap_insert(pos, nm, i + 1);
        }
        var k0: i64 = -1;
        if func_is_instance(nm) {
            var h: i64 = c_unit_slot(unames, func_module_of(nm, ""));
            if h >= 0 {
                k0 = inst_fn.len();
                inst_fn.push(i);
                home.push(h);
            }
        }
        kidx.push(k0);
        i = i + 1;
    }
    var n_inst: i64 = inst_fn.len();
    if n_inst == 0 {
        HashMap_drop(pos);
        return;
    }
    var taken: Vec<i64> = Vec::new();
    i = 0;
    while i < n_inst {
        taken.push(0);
        i = i + 1;
    }
    var e_from: Vec<i64> = Vec::new();
    var e_to: Vec<i64> = Vec::new();
    var dyn_done: i64 = HashMap_new();
    i = 0;
    while i < n {
        var fe: IrFunctionEntry = module.functions.get(i);
        var k: i64 = 0;
        while k < fe.func.insts.len() {
            var refd: str = "";
            match fe.func.insts.get(k).inst {
                Inst::Call(cn, _, _, _) => {
                    var t: i64 = HashMap_get(pos, cn) - 1;
                    if t >= 0 && t != i && kidx.get(t) >= 0 {
                        e_from.push(i);
                        e_to.push(t);
                    }
                }
                Inst::ConstFnRef(rn) => {
                    refd = c_fn_target(rn);
                    var t2: i64 = HashMap_get(pos, rn) - 1;
                    if t2 >= 0 && kidx.get(t2) >= 0 {
                        taken.set(kidx.get(t2), 1);
                    }
                }
                Inst::ConstStr(sv) => {
                    if str_len(sv) > 0 && str_len(sv) < 256 {
                        refd = sv;
                    }
                }
                Inst::DynCall(_, method, _, _, _) => {
                    if HashMap_get(dyn_done, method) == 0 {
                        HashMap_insert(dyn_done, method, 1);
                        var suffix: str = "_" + method;
                        var j: i64 = 0;
                        while j < n_inst {
                            if str_ends_with(module.functions.get(inst_fn.get(j)).name, suffix) {
                                taken.set(j, 1);
                            }
                            j = j + 1;
                        }
                    }
                }
                _ => {
                }
            }
            if str_len(refd) > 0 {
                var t3: i64 = HashMap_get(pos, refd) - 1;
                if t3 >= 0 && kidx.get(t3) >= 0 {
                    taken.set(kidx.get(t3), 1);
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    HashMap_drop(dyn_done);
    HashMap_drop(pos);
    // has: instance x unit, 1 = a static copy there; cu: the units calling
    // each instance (recomputed each round)
    var has: Vec<i64> = Vec::new();
    var cu: Vec<i64> = Vec::new();
    var hi: i64 = 0;
    while hi < n_inst * nu {
        has.push(0);
        cu.push(0);
        hi = hi + 1;
    }
    var round: i64 = 0;
    var changed: bool = true;
    while changed && round < 16 && e_from.len() > 0 {
        changed = false;
        hi = 0;
        while hi < n_inst * nu {
            cu.set(hi, 0);
            hi = hi + 1;
        }
        var ei: i64 = 0;
        while ei < e_from.len() {
            var f: i64 = e_from.get(ei);
            var kj: i64 = kidx.get(e_to.get(ei));
            cu.set(kj * nu + units.get(f), 1);
            var kf: i64 = kidx.get(f);
            if kf >= 0 {
                var u0: i64 = 0;
                while u0 < nu {
                    if has.get(kf * nu + u0) == 1 {
                        cu.set(kj * nu + u0, 1);
                    }
                    u0 = u0 + 1;
                }
            }
            ei = ei + 1;
        }
        var kk: i64 = 0;
        while kk < n_inst {
            if taken.get(kk) == 0 {
                var j2: i64 = inst_fn.get(kk);
                var p: i64 = units.get(j2);
                var h2: i64 = home.get(kk);
                var others: i64 = 0;
                var best: i64 = -1;
                var u: i64 = 0;
                while u < nu {
                    if cu.get(kk * nu + u) == 1 {
                        if u != p {
                            others = others + 1;
                        }
                        if best < 0 || str_compare(unames.get(u), unames.get(best)) < 0 {
                            best = u;
                        }
                    }
                    u = u + 1;
                }
                // its generic's unit calls it and holds it: the others call
                // that one (a copy would not keep it out of home)
                var keep: bool = others == 0 || (p == h2 && cu.get(kk * nu + h2) == 1);
                if !keep {
                    if p == h2 {
                        // home does not call it: its definition moves to the
                        // calling unit first by name
                        units.set(j2, best);
                        has.set(kk * nu + best, 0);
                        p = best;
                        changed = true;
                    }
                    u = 0;
                    while u < nu {
                        if cu.get(kk * nu + u) == 1 && u != p && has.get(kk * nu + u) == 0 {
                            has.set(kk * nu + u, 1);
                            changed = true;
                        }
                        u = u + 1;
                    }
                }
            }
            kk = kk + 1;
        }
        round = round + 1;
    }
    var n_copied: i64 = 0;
    var kk2: i64 = 0;
    while kk2 < n_inst {
        var any: bool = false;
        var u2: i64 = 0;
        while u2 < nu {
            if has.get(kk2 * nu + u2) == 1 && u2 != units.get(inst_fn.get(kk2)) {
                copy_fn.push(inst_fn.get(kk2));
                copy_unit.push(u2);
                any = true;
            }
            u2 = u2 + 1;
        }
        if any {
            n_copied = n_copied + 1;
        }
        kk2 = kk2 + 1;
    }
    if str_len(env_or_empty("FIDES_INC_DEBUG")) > 0 {
        var n_taken: i64 = 0;
        var tk: i64 = 0;
        while tk < n_inst {
            n_taken = n_taken + taken.get(tk);
            tk = tk + 1;
        }
        p_eprint_str("[inc] instance copies: " + int_to_str(copy_fn.len()) + " static copies of " + int_to_str(n_copied) + " of " + int_to_str(n_inst) + " instances (" + int_to_str(n_taken) + " address-taken, never copied)\n");
    }
}

/// `ccompile --inc` (B1): lower `source`, cut it into IrUnits and make each
/// unit's C generator input and object key (`build_key`: the build's
/// compiler, flags and environment, inc_build_key). Ok: a short C-comment
/// text that stands for the program's C in cmd_ccompile: the libraries it
/// links (`// PLINK:` lines, as the C has them) and every unit's key, so a
/// build whose keys all match the last one is up to date. build_c_units
/// then generates and compiles only the units it must (incu_unit_c). When
/// the units cannot be made (a function in two units), Ok holds the whole
/// program's C and incu_ready() is false: the C text is cut as before.
pub fn ccompile_inc_prepare(source: str, source_path: str, borrowck_mode: str, build_key: i64) -> ResultStr {
    incu_reset();
    set_c_unit_marks(true);
    var src_hash: i64 = hash_source(source);
    var module: IrModule = IrModule_new();
    var have_module: bool = false;
    match global_cache_get(source_path, src_hash) {
        OptIrModule::Some(cached_module) => {
            module = cached_module;
            have_module = true;
        }
        OptIrModule::None => {
        }
    }
    if !have_module {
        g_c_reach = true;
        var lowered: ResultIrModule = lower_to_ir_module_with_path(source, source_path, borrowck_mode);
        g_c_reach = false;
        match lowered {
            ResultIrModule::Err(errs) => {
                return ResultStr::Err(errs);
            }
            ResultIrModule::Ok(lmod) => {
                global_cache_store(source_path, src_hash, lmod);
                module = lmod;
            }
        }
    }
    // B6: the own types' functions named by their type, not by the order
    // this program's lowering met the types
    incu_canon_own_names(&mut module);
    var ct_errs: Vec<str> = incu_ct_errors(&module);
    if ct_errs.len() > 0 {
        return ResultStr::Err(ct_errs);
    }
    var t_units: i64 = p_clock_now_ms();
    var n: i64 = module.functions.len();
    // each function's module (func_module_of, as split_c_units), then the
    // instances at their callers
    var owner: str = func_module_of("main", "main");
    var uidx: i64 = HashMap_new();
    var unames: Vec<str> = Vec::new();
    var units: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var un0: str = func_module_of(module.functions.get(i).name, owner);
        var s: i64 = HashMap_get(uidx, un0);
        if s == 0 {
            unames.push(un0);
            s = unames.len();
            HashMap_insert(uidx, un0, s);
        }
        units.push(s - 1);
        i = i + 1;
    }
    HashMap_drop(uidx);
    if env_or_empty("FIDES_INC_INSTANCES") != "home" {
        incu_place_instances(&module, &mut units);
    }
    // B6: core's dispatches over the program's struct and enum types
    // (lower.fd Lowerer_rc_gen_elem_fn, Lowerer_rc_gen_mem_drop_fn) change
    // with every program: main's unit holds them (core keeps a stub), so
    // core's unit is the same in every program that does not change core.
    // FIDES_INC_DISPATCH=core: they stay in core's unit.
    if env_or_empty("FIDES_INC_DISPATCH") != "core" {
        var disp_u: i64 = -1;
        i = 0;
        while i < unames.len() {
            if unames.get(i) == owner {
                disp_u = i;
            }
            i = i + 1;
        }
        i = 0;
        while i < n && disp_u >= 0 {
            var dn: str = module.functions.get(i).name;
            // (__p_key_strs too, lower.fd Lowerer_rc_gen_key_strs_fn: which
            // words of each struct type hold strings, 2g.91)
            if dn == "__p_elem_drop" || dn == "__p_elem_dup" || dn == "__p_mem_drop" || dn == "__p_mem_dup" || dn == "__p_key_strs" {
                units.set(i, disp_u);
            }
            i = i + 1;
        }
    }
    // FIDES_INC_EQ=main: the `==` helpers in main's unit, as split_c_units
    // puts them (else the unit that holds one would lose its body there)
    if env_or_empty("FIDES_INC_EQ") == "main" {
        var main_u: i64 = -1;
        i = 0;
        while i < unames.len() {
            if unames.get(i) == owner {
                main_u = i;
            }
            i = i + 1;
        }
        i = 0;
        while i < n && main_u >= 0 {
            if str_starts_with(module.functions.get(i).name, "__eq_") {
                units.set(i, main_u);
            }
            i = i + 1;
        }
    }
    // B3: an instance two or more units call gets a `static` copy in each
    // of them but the one holding its definition (incu_copy_instances;
    // FIDES_INC_INSTANCES=move: the moves above only; not with
    // FIDES_INC_EFFECTS=off, whose prototypes are shared by every unit)
    var copy_fn: Vec<i64> = Vec::new();
    var copy_unit: Vec<i64> = Vec::new();
    var inst_mode: str = env_or_empty("FIDES_INC_INSTANCES");
    if inst_mode != "home" && inst_mode != "move" && env_or_empty("FIDES_INC_EFFECTS") != "off" {
        incu_copy_instances(&module, unames, &mut units, &mut copy_fn, &mut copy_unit);
    }
    var unit_of: Vec<str> = Vec::new();
    i = 0;
    while i < n {
        unit_of.push(unames.get(units.get(i)));
        i = i + 1;
    }
    var t: IrLinkTable = ir_units_split(&module, unit_of);
    var problems: Vec<str> = ir_units_check(&t);
    if problems.len() > 0 || t.units.len() == 0 {
        if problems.len() > 0 {
            p_eprint_str("[inc] IR units: " + problems.get(0) + "; cutting the program's C instead\n");
        }
        HashMap_drop(t.owner);
        incu_reset();
        var wcg: CCodeGen = CCodeGen_new();
        var whole: str = CCodeGen_generate(&mut wcg, module);
        val wct: Vec<str> = c_ct_error_lines();
        if wct.len() > 0 {
            return ResultStr::Err(wct);
        }
        return ResultStr::Ok(whole);
    }
    // split_c_units cuts each unit's C by this assignment
    g_split_assign = HashMap_new();
    g_split_assign_names = unames;
    i = 0;
    while i < n {
        HashMap_insert(g_split_assign, module.functions.get(i).name, units.get(i) + 1);
        i = i + 1;
    }
    // what each function names, and whether it loads libraries
    var dl_at: Vec<i64> = Vec::new();
    var estimate: i64 = 400000;
    i = 0;
    while i < n {
        var fe0: IrFunctionEntry = module.functions.get(i);
        var nm0: Vec<str> = Vec::new();
        var dy0: Vec<str> = Vec::new();
        if incu_named(&fe0.func, &mut nm0, &mut dy0) {
            dl_at.push(1);
        } else {
            dl_at.push(0);
        }
        estimate = estimate + 200 + fe0.func.insts.len() * 40;
        i = i + 1;
    }
    var lay_at: i64 = HashMap_new();
    var max_len: i64 = 0;
    i = 0;
    while i < module.struct_layouts.len() {
        var ln: str = module.struct_layouts.get(i).name;
        if HashMap_get(lay_at, ln) == 0 {
            HashMap_insert(lay_at, ln, i + 1);
        }
        if str_len(ln) > max_len {
            max_len = str_len(ln);
        }
        i = i + 1;
    }
    // B1 (2g.92): a unit's dynamic and function-value calls dispatch over
    // functions of other units too. The C generator takes a dyn call's
    // candidates among the types its module's trait impls and MakeDyns
    // name (cg_collect_dyn_types) and a function-value call's among the
    // functions it has: a unit gets the dyn types its calls can reach (a
    // trait impl table of its own) and stubs of their methods, and stubs
    // of every function a function value can name (a function reference)
    // with the arity of a call through a function value its live functions
    // make. Before, lib2's `d.area()` on main's Sq had no candidate and
    // aborted (exit 127), and so did lib2's `f(x)` on main's function.
    var live: i64 = incu_live(&module);
    var dyn_types: i64 = HashMap_new();
    var ti0: i64 = 0;
    while ti0 < module.trait_impls.len() {
        var titems: Vec<str> = module.trait_impls.get(ti0).items;
        var tj: i64 = 0;
        while tj < titems.len() {
            HashMap_insert(dyn_types, titems.get(tj), 1);
            tj = tj + 1;
        }
        ti0 = ti0 + 1;
    }
    var fn_pos: i64 = HashMap_new();
    i = 0;
    while i < n {
        if HashMap_get(fn_pos, module.functions.get(i).name) == 0 {
            HashMap_insert(fn_pos, module.functions.get(i).name, i + 1);
        }
        i = i + 1;
    }
    var fnref_ix: Vec<i64> = Vec::new();
    var fnref_seen: i64 = HashMap_new();
    i = 0;
    while i < n {
        var fe1: IrFunctionEntry = module.functions.get(i);
        var k1: i64 = 0;
        while k1 < fe1.func.insts.len() {
            match fe1.func.insts.get(k1).inst {
                Inst::MakeDyn(_, mtn, _) => {
                    HashMap_insert(dyn_types, mtn, 1);
                }
                Inst::ConstFnRef(frn) => {
                    var fat: i64 = HashMap_get(fn_pos, frn);
                    if fat != 0 && HashMap_get(fnref_seen, frn) == 0 {
                        HashMap_insert(fnref_seen, frn, 1);
                        fnref_ix.push(fat - 1);
                    }
                }
                _ => {
                }
            }
            k1 = k1 + 1;
        }
        i = i + 1;
    }
    HashMap_drop(fnref_seen);
    HashMap_drop(fn_pos);
    var opts: str = "fid-ir-unit 1 build " + int_to_str(build_key) + " FID_SWITCH=" + env_or_empty("FID_SWITCH") + " FID_C_CT_OFF=" + env_or_empty("FID_C_CT_OFF") + " FIDES_INC_EFFECTS=" + env_or_empty("FIDES_INC_EFFECTS") + " FIDES_INC_LAYOUTS=" + env_or_empty("FIDES_INC_LAYOUTS") + " FIDES_INC_EQ=" + env_or_empty("FIDES_INC_EQ") + " FIDES_INC_INSTANCES=" + env_or_empty("FIDES_INC_INSTANCES") + " FIDES_INC_SCOPE_DATA=" + env_or_empty("FIDES_INC_SCOPE_DATA") + " FIDES_INC_DISPATCH=" + env_or_empty("FIDES_INC_DISPATCH");
    // units sorted by name (the order of the .fides-tu files)
    var order: Vec<i64> = Vec::new();
    var oi: i64 = 0;
    while oi < t.units.len() {
        order.push(oi);
        var k: i64 = order.len() - 1;
        while k > 0 && str_compare(t.units.get(order.get(k)).name, t.units.get(order.get(k - 1)).name) < 0 {
            var tmp: i64 = order.get(k);
            order.set(k, order.get(k - 1));
            order.set(k - 1, tmp);
            k = k - 1;
        }
        oi = oi + 1;
    }
    var summary: StringBuilder = StringBuilder::new();
    summary.append_str("// fid ccompile --inc: C per IrUnit (inc-roadmap B1), in <output>.fides-tu\n");
    oi = 0;
    while oi < order.len() {
        var un: IrUnit = t.units.get(order.get(oi));
        var is_owner: bool = un.name == owner;
        var cg: IrModule = IrModule_new();
        var own: i64 = HashMap_new();
        var want: i64 = HashMap_new();
        var dyn_done: i64 = HashMap_new();
        // its functions, then the static copies of instances it calls (B3)
        var unit_fns: Vec<IrFunctionEntry> = Vec::new();
        var k2: i64 = 0;
        while k2 < un.module.functions.len() {
            unit_fns.push(un.module.functions.get(k2));
            k2 = k2 + 1;
        }
        var u_slot: i64 = c_unit_slot(unames, un.name);
        var copy_names: Vec<str> = Vec::new();
        k2 = 0;
        while k2 < copy_fn.len() {
            if copy_unit.get(k2) == u_slot {
                var cfe: IrFunctionEntry = module.functions.get(copy_fn.get(k2));
                unit_fns.push(cfe);
                copy_names.push(cfe.name);
            }
            k2 = k2 + 1;
        }
        var u_dyn: Vec<str> = Vec::new();
        var u_dyn_set: i64 = HashMap_new();
        var ptr_arity: Vec<i64> = Vec::new();
        k2 = 0;
        while k2 < unit_fns.len() {
            var fe: IrFunctionEntry = unit_fns.get(k2);
            cg.functions.push(fe);
            HashMap_insert(own, fe.name, 1);
            var nms: Vec<str> = Vec::new();
            var dys: Vec<str> = Vec::new();
            incu_named(&fe.func, &mut nms, &mut dys);
            var q: i64 = 0;
            while q < nms.len() {
                HashMap_insert(want, nms.get(q), 1);
                q = q + 1;
            }
            // a dynamic call dispatches to every `<Type>_<method>` whose
            // type is a dyn type (cg_dyn_candidate)
            q = 0;
            while q < dys.len() {
                if HashMap_get(dyn_done, dys.get(q)) == 0 {
                    HashMap_insert(dyn_done, dys.get(q), 1);
                    var suffix: str = "_" + dys.get(q);
                    var w: i64 = 0;
                    while w < n {
                        var wn: str = module.functions.get(w).name;
                        if str_ends_with(wn, suffix) && str_len(wn) > str_len(suffix) {
                            var wt: str = str_slice(wn, 0, str_len(wn) - str_len(suffix));
                            if HashMap_get(dyn_types, wt) != 0 {
                                HashMap_insert(want, wn, 1);
                                if HashMap_get(u_dyn_set, wt) == 0 {
                                    HashMap_insert(u_dyn_set, wt, 1);
                                    u_dyn.push(wt);
                                }
                            }
                        }
                        w = w + 1;
                    }
                }
                q = q + 1;
            }
            // the arities of its calls through a function value (env
            // first: the C generator's candidates take args + 1), when a
            // run can reach it
            if HashMap_get(live, fe.name) != 0 {
                var pk: i64 = 0;
                while pk < fe.func.insts.len() {
                    match fe.func.insts.get(pk).inst {
                        Inst::CallPtr(_, pargs, _, _, _) => {
                            if !vec_contains_i64(ptr_arity, pargs.len() + 1) {
                                ptr_arity.push(pargs.len() + 1);
                            }
                        }
                        _ => {
                        }
                    }
                    pk = pk + 1;
                }
            }
            k2 = k2 + 1;
        }
        HashMap_drop(u_dyn_set);
        // the functions a function value can name, with a matching arity
        if ptr_arity.len() > 0 {
            k2 = 0;
            while k2 < fnref_ix.len() {
                var rfe: IrFunctionEntry = module.functions.get(fnref_ix.get(k2));
                if vec_contains_i64(ptr_arity, rfe.func.params.len()) {
                    HashMap_insert(want, rfe.name, 1);
                }
                k2 = k2 + 1;
            }
        }
        // the dyn types its dynamic calls dispatch over, sorted by name
        if u_dyn.len() > 0 {
            var di2: i64 = 1;
            while di2 < u_dyn.len() {
                var dk: i64 = di2;
                while dk > 0 && str_compare(u_dyn.get(dk), u_dyn.get(dk - 1)) < 0 {
                    var dtmp: str = u_dyn.get(dk);
                    u_dyn.set(dk, u_dyn.get(dk - 1));
                    u_dyn.set(dk - 1, dtmp);
                    dk = dk - 1;
                }
                di2 = di2 + 1;
            }
            cg.trait_impls.push(StringVecStr_new("__inc_dyn", u_dyn));
        }
        k2 = 0;
        while k2 < un.imports.len() {
            HashMap_insert(want, un.imports.get(k2), 1);
            k2 = k2 + 1;
        }
        // C callbacks: their adapters name the functions
        k2 = 0;
        while k2 < module.c_callbacks.len() {
            HashMap_insert(want, module.c_callbacks.get(k2), 1);
            k2 = k2 + 1;
        }
        // stubs of what it imports, sorted by name (the program's order
        // changes with the rest of the program: B6); main's unit, whose
        // tail lists and registers them, gets every function in the
        // program's order but a compiler-made one (`__eq_<S>` and the like)
        // no run can reach, as a single TU's tail lists only those, so a
        // struct whose `==` nothing uses changes its module's unit only (B2)
        var stub_ix: Vec<i64> = Vec::new();
        var stub_nm: Vec<str> = Vec::new();
        var w2: i64 = 0;
        while w2 < n {
            var we: IrFunctionEntry = module.functions.get(w2);
            if HashMap_get(own, we.name) == 0 {
                var take: bool = HashMap_get(want, we.name) != 0;
                if !take && is_owner {
                    take = dl_at.get(w2) == 1 || !str_starts_with(we.name, "__") || HashMap_get(live, we.name) != 0;
                }
                if take {
                    HashMap_insert(own, we.name, 2);
                    stub_ix.push(w2);
                    stub_nm.push(we.name);
                }
            }
            w2 = w2 + 1;
        }
        if !is_owner {
            stub_ix = incu_sort_by_name(stub_ix, stub_nm);
        }
        w2 = 0;
        while w2 < stub_ix.len() {
            var se: IrFunctionEntry = module.functions.get(stub_ix.get(w2));
            if is_owner && dl_at.get(stub_ix.get(w2)) == 1 {
                cg.functions.push(se);
            } else {
                cg.functions.push(incu_stub(&se));
            }
            w2 = w2 + 1;
        }
        HashMap_drop(own);
        HashMap_drop(dyn_done);
        if is_owner || env_or_empty("FIDES_INC_SCOPE_DATA") == "off" {
            cg.extern_decls = module.extern_decls;
            cg.globals = module.globals;
        } else {
            // B6: another unit carries only the globals its functions
            // address and the C functions it calls or takes (main's unit
            // defines every global), so its key and its C stay the same
            // whatever else the program holds: core's object from one
            // program fits the next (a seeded store, inc.fd).
            // FIDES_INC_SCOPE_DATA=off: every unit carries them all.
            var gnamed: i64 = HashMap_new();
            var gf: i64 = 0;
            while gf < un.module.functions.len() {
                var gfe: IrFunctionEntry = un.module.functions.get(gf);
                incu_globals_named(&gfe.func, gnamed);
                gf = gf + 1;
            }
            var gx: i64 = 0;
            while gx < module.globals.len() {
                if HashMap_get(gnamed, module.globals.get(gx).name) != 0 {
                    cg.globals.push(module.globals.get(gx));
                }
                gx = gx + 1;
            }
            HashMap_drop(gnamed);
            var ex: i64 = 0;
            while ex < module.extern_decls.len() {
                var xd: ExternDecl = module.extern_decls.get(ex);
                if HashMap_get(want, xd.pledge_name) != 0 || HashMap_get(want, xd.c_name) != 0 {
                    cg.extern_decls.push(xd);
                }
                ex = ex + 1;
            }
        }
        HashMap_drop(want);
        cg.c_callbacks = module.c_callbacks;
        // B2: the layouts the unit names
        var body: Vec<i64> = ir_module_bytes(&cg, "fid-unit");
        var used: Vec<i64> = Vec::new();
        if env_or_empty("FIDES_INC_LAYOUTS") == "off" {
            // every unit carries every layout (as split_c_units then does)
            var la: i64 = 0;
            while la < module.struct_layouts.len() {
                if HashMap_get(lay_at, module.struct_layouts.get(la).name) == la + 1 {
                    used.push(la);
                }
                la = la + 1;
            }
        } else {
            used = incu_layouts_named(body, &module, lay_at, max_len);
        }
        var lm: IrModule = IrModule_new();
        var ui: i64 = 0;
        while ui < used.len() {
            var lay: StructLayout = module.struct_layouts.get(used.get(ui)).layout;
            IrModule_add_struct(&mut cg, lay);
            IrModule_add_struct(&mut lm, lay);
            ui = ui + 1;
        }
        var lay_bytes: Vec<i64> = ir_module_bytes(&lm, "layouts");
        HashMap_drop(lm.fn_index);
        HashMap_drop(lm.struct_index);
        HashMap_drop(lm.str_index);
        HashMap_drop(lm.global_index);
        var role: str = " unit";
        if is_owner {
            role = " owner";
        }
        var key: i64 = incu_hash(body, incu_hash(lay_bytes, hash_source(opts + role)));
        if str_len(env_or_empty("FIDES_INC_DEBUG")) > 0 {
            p_eprint_str("[inc] ir unit " + un.name + ": " + int_to_str(un.module.functions.len()) + " functions, " + int_to_str(cg.functions.len() - un.module.functions.len()) + " stubs, " + int_to_str(used.len()) + " of " + int_to_str(module.struct_layouts.len()) + " layouts\n");
            // B2: the layout table of the unit, as split_c_units prints it
            // on the C text path (the structs of the program it carries,
            // the FFI declarations), tests/tooling/inc-layouts-check.sh
            var n_lay_all: i64 = 0;
            var lc: i64 = 0;
            while lc < module.struct_layouts.len() {
                if HashMap_get(lay_at, module.struct_layouts.get(lc).name) == lc + 1 {
                    n_lay_all = n_lay_all + 1;
                }
                lc = lc + 1;
            }
            p_eprint_str("[inc] layouts " + un.name + ": " + int_to_str(used.len()) + " of " + int_to_str(n_lay_all) + " structs, " + int_to_str(cg.extern_decls.len()) + " of " + int_to_str(module.extern_decls.len()) + " externs\n");
        }
        g_incu_names.push(un.name);
        g_incu_copies.push(str_join(copy_names, "\n"));
        g_incu_keys.push(key);
        g_incu_mods.push(cg);
        summary.append_str("// unit " + un.name + " " + int_to_str(key) + "\n");
        oi = oi + 1;
    }
    HashMap_drop(lay_at);
    HashMap_drop(live);
    HashMap_drop(dyn_types);
    HashMap_drop(t.owner);
    // the libraries the C names (codegen_c.fd emit_extern_decls), and the
    // loader the runtime header declares
    var libs: Vec<str> = Vec::new();
    var ed: i64 = 0;
    while ed < module.extern_decls.len() {
        var ext: ExternDecl = module.extern_decls.get(ed);
        match ext.link_lib {
            OptStr::Some(lib) => {
                if !str_vec_contains(libs, lib) {
                    libs.push(lib);
                    summary.append_str("// PLINK: " + lib + "\n");
                }
            }
            OptStr::None => {
            }
        }
        ed = ed + 1;
    }
    summary.append_str("// int64_t p_dl_load(const char* path);\n");
    g_incu_owner = owner;
    g_incu_estimate = estimate;
    g_incu_ready = true;
    time_mark("IR units", t_units);
    return ResultStr::Ok(summary.to_str());
}

/// The C of unit `i` (B1): its module through the C generator, then its
/// part of that text (split_c_units with the units' assignment). "" when
/// the C generator reported an error.
pub fn incu_unit_c(i: i64) -> str {
    var name: str = g_incu_names.get(i);
    var m: IrModule = g_incu_mods.get(i);
    if name == g_incu_owner {
        set_c_register_all(true);
    }
    var cg: CCodeGen = CCodeGen_new();
    var text: str = CCodeGen_generate(&mut cg, m);
    set_c_register_all(false);
    val ct: Vec<str> = c_ct_error_lines();
    if ct.len() > 0 {
        return "";
    }
    g_split_only = name;
    // B3: the static copies this unit holds
    if g_split_copies != 0 {
        HashMap_drop(g_split_copies);
        g_split_copies = 0;
    }
    if i < g_incu_copies.len() && str_len(g_incu_copies.get(i)) > 0 {
        g_split_copies = HashMap_new();
        var cnames: Vec<str> = str_split(g_incu_copies.get(i), "\n");
        var ci: i64 = 0;
        while ci < cnames.len() {
            if str_len(cnames.get(ci)) > 0 {
                HashMap_insert(g_split_copies, cnames.get(ci), 1);
            }
            ci = ci + 1;
        }
    }
    var parts: Vec<CUnit> = split_c_units(text);
    g_split_only = "";
    if g_split_copies != 0 {
        HashMap_drop(g_split_copies);
        g_split_copies = 0;
    }
    var p: i64 = 0;
    while p < parts.len() {
        if parts.get(p).name == name {
            return parts.get(p).code;
        }
        p = p + 1;
    }
    return "";
}
