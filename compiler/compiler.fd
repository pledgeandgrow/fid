use compiler::x86;
use compiler::wasm;
// ===========================================================================
// Result types (Fides has no generic Result<T,E>)
// ===========================================================================

pub enum ResultStr {
    Ok(str),
    Err(Vec<str>),
}

pub enum ResultProgram {
    Ok(Program),
    Err(Vec<str>),
}

pub enum ResultIrModule {
    Ok(IrModule),
    Err(Vec<str>),
}

// ResultBytes moved to compiler::ir (shared with backends that cannot
// import this module).

/// G8.7: Result type for lint_source — Ok holds a Vec<str> of warnings.
pub enum ResultVecStr {
    Ok(Vec<str>),
    Err(Vec<str>),
}

/// G8.7: Program + lint warnings (returned by build_program_with_lints).
pub struct ProgramAndWarnings {
    pub program: Program,
    pub warnings: Vec<str>,
}

pub enum ResultProgramAndWarnings {
    Ok(ProgramAndWarnings),
    Err(Vec<str>),
}

pub struct CompileResult {
    pub assembly: str,
}

// ===========================================================================
// Error codes (mirrors crate::diag::ErrCode)
// ===========================================================================

pub enum ErrCode {
    UndefinedVariable,
    UndefinedFunction,
    UndefinedStruct,
    UndefinedField,
    TypeMismatch,
    IfConditionNotBool,
    ArgCountMismatch,
    MissingReturn,
    InitBeforeAssign,
    NotLinear,
    CapabilityDenied,
    SandboxViolation,
    ConservationViolation,
    GasExceeded,
    EffectMismatch,
    ExpectedToken,
    UnexpectedChar,
    BorrowConflict,
    NoMain,
    Custom,
}

pub fn errcode_to_str(code: ErrCode) -> str {
    match code {
        ErrCode::UndefinedVariable => { return "UndefinedVariable"; }
        ErrCode::UndefinedFunction => { return "UndefinedFunction"; }
        ErrCode::UndefinedStruct => { return "UndefinedStruct"; }
        ErrCode::UndefinedField => { return "UndefinedField"; }
        ErrCode::TypeMismatch => { return "TypeMismatch"; }
        ErrCode::IfConditionNotBool => { return "IfConditionNotBool"; }
        ErrCode::ArgCountMismatch => { return "ArgCountMismatch"; }
        ErrCode::MissingReturn => { return "MissingReturn"; }
        ErrCode::InitBeforeAssign => { return "InitBeforeAssign"; }
        ErrCode::NotLinear => { return "NotLinear"; }
        ErrCode::CapabilityDenied => { return "CapabilityDenied"; }
        ErrCode::SandboxViolation => { return "SandboxViolation"; }
        ErrCode::ConservationViolation => { return "ConservationViolation"; }
        ErrCode::GasExceeded => { return "GasExceeded"; }
        ErrCode::EffectMismatch => { return "EffectMismatch"; }
        ErrCode::ExpectedToken => { return "ExpectedToken"; }
        ErrCode::UnexpectedChar => { return "UnexpectedChar"; }
        ErrCode::BorrowConflict => { return "BorrowConflict"; }
        ErrCode::NoMain => { return "NoMain"; }
        ErrCode::Custom => { return "Custom"; }
    }
    return "Custom";
}

// ===========================================================================
// Helper types
// ===========================================================================

/// Cache entry: file path -> source content (avoids re-reading from disk)
pub struct PathContent {
    pub path: str,
    pub content: str,
}

pub fn PathContent_new(path: str, content: str) -> PathContent {
    return PathContent { path: path, content: content };
}

/// Cache entry: file path -> tokens (avoids re-lexing)
pub struct PathTokens {
    pub path: str,
    pub tokens: Vec<Token>,
}

pub fn PathTokens_new(path: str, tokens: Vec<Token>) -> PathTokens {
    return PathTokens { path: path, tokens: tokens };
}

/// Cache entry: file path -> parsed Program (avoids re-parsing deferred modules)
pub struct PathProgram {
    pub path: str,
    pub prog: Program,
}

pub fn PathProgram_new(path: str, prog: Program) -> PathProgram {
    return PathProgram { path: path, prog: prog };
}

/// Cached file read -- returns cached content if available, otherwise reads from disk.
fn cached_file_read(cache: Vec<PathContent>, path: str) -> str {
    var i: i64 = 0;
    while i < cache.len() {
        if cache.get(i).path == path {
            return cache.get(i).content;
        }
        i = i + 1;
    }
    var content: str = c_file_read(path);
    cache.push(PathContent_new(path, content));
    return content;
}

/// Cached lex -- returns cached tokens if available, otherwise lexes.
fn cached_lex(token_cache: Vec<PathTokens>, content_cache: Vec<PathContent>, path: str) -> Vec<Token> {
    var i: i64 = 0;
    while i < token_cache.len() {
        if token_cache.get(i).path == path {
            return token_cache.get(i).tokens;
        }
        i = i + 1;
    }
    var source: str = cached_file_read(content_cache, path);
    var lex: Lexer = Lexer::new(source);
    var toks: Vec<Token> = lex.tokenize();
    token_cache.push(PathTokens_new(path, toks));
    return toks;
}

/// Cached parse -- returns cached Program if available, otherwise parses.
/// This avoids re-parsing modules that were pre-scanned then deferred due to
/// unloaded transitive dependencies. The pre-scan parse is the most expensive
/// step (~4s per module), and deferred modules get re-parsed on re-encounter.
fn cached_parse(parse_cache: Vec<PathProgram>, token_cache: Vec<PathTokens>, content_cache: Vec<PathContent>, path: str, struct_names: Vec<str>, enum_names: Vec<str>) -> OptProgram {
    var i: i64 = 0;
    while i < parse_cache.len() {
        if parse_cache.get(i).path == path {
            return OptProgram::Some(parse_cache.get(i).prog);
        }
        i = i + 1;
    }
    var toks: Vec<Token> = cached_lex(token_cache, content_cache, path);
    var parser: Parser = Parser_with_names(toks, struct_names, enum_names);
    var result: ParseResultProgram = parser.parse();
    match result {
        ParseResultProgram::Ok(prog) => {
            parse_cache.push(PathProgram_new(path, prog));
            return OptProgram::Some(prog);
        }
        ParseResultProgram::Err(_) => {
            return OptProgram::None;
        }
    }
}

pub struct I64Pair {
    pub first: i64,
    pub second: i64,
}

pub fn cc_I64Pair_new(first: i64, second: i64) -> I64Pair {
    return I64Pair { first: first, second: second };
}

pub struct StrTriple {
    pub line: i64,
    pub col: i64,
    pub msg: str,
}

pub fn StrTriple_new(line: i64, col: i64, msg: str) -> StrTriple {
    return StrTriple { line: line, col: col, msg: msg };
}

// ===========================================================================
// Error enrichment -- extract line/col from error strings and render with
// source context (rewritten from enrich_errors in compiler.rs)
// ===========================================================================

/// Extract (line, col) from an error string.
/// Formats recognized:
///   "Type error (line N): ..."
///   "Parse error at L:C: ..."
///   "Error:L:C: ..."
pub fn extract_line_col(err: str) -> I64Pair {
    // "Type error (line N): ..."
    var idx: i64 = str_find(err, "(line ");
    if idx >= 0 {
        var rest: str = c_str_substr(err, idx + 6, str_len(err));
        var end: i64 = str_find(rest, ")");
        if end >= 0 {
            var line_str: str = c_str_substr(rest, 0, end);
            var line: i64 = c_str_parse_i64(line_str);
            if line > 0 {
                return cc_I64Pair_new(line, 1);
            }
        }
    }

    // "Parse error at L:C: ..."
    idx = str_find(err, "at ");
    if idx >= 0 {
        var rest2: str = c_str_substr(err, idx + 3, str_len(err));
        var colon: i64 = str_find(rest2, ":");
        if colon >= 0 {
            var line_str2: str = c_str_substr(rest2, 0, colon);
            var line2: i64 = c_str_parse_i64(line_str2);
            if line2 > 0 {
                var after_colon: str = c_str_substr(rest2, colon + 1, str_len(rest2));
                var end2: i64 = str_find(after_colon, ":");
                if end2 >= 0 {
                    var col_str: str = c_str_substr(after_colon, 0, end2);
                    var col: i64 = c_str_parse_i64(col_str);
                    if col > 0 {
                        return cc_I64Pair_new(line2, col);
                    }
                }
                return cc_I64Pair_new(line2, 1);
            }
        }
    }

    // "Error:L:C: ..." (lexer format)
    if str_starts_with(err, "Error:") {
        var rest3: str = c_str_substr(err, 6, str_len(err));
        var colon1: i64 = str_find(rest3, ":");
        if colon1 >= 0 {
            var line_str3: str = c_str_substr(rest3, 0, colon1);
            var line3: i64 = c_str_parse_i64(line_str3);
            if line3 > 0 {
                var after: str = c_str_substr(rest3, colon1 + 1, str_len(rest3));
                var colon2: i64 = str_find(after, ":");
                if colon2 >= 0 {
                    var col_str2: str = c_str_substr(after, 0, colon2);
                    var col2: i64 = c_str_parse_i64(col_str2);
                    if col2 > 0 {
                        return cc_I64Pair_new(line3, col2);
                    }
                }
                return cc_I64Pair_new(line3, 1);
            }
        }
    }

    return cc_I64Pair_new(0, 0);
}

/// Parse an error string to extract (line, column, message).
/// Used by LSP for diagnostics.
pub fn parse_error_position(error: str) -> StrTriple {
    // Format 1: "Error:line:col: message"
    if str_starts_with(error, "Error:") {
        var rest: str = c_str_substr(error, 6, str_len(error));
        var parts: Vec<str> = c_str_split_n(rest, ":", 3);
        if parts.len() >= 3 {
            var line: i64 = c_str_parse_i64(parts.get(0));
            var col: i64 = c_str_parse_i64(parts.get(1));
            return StrTriple_new(line, col, str_trim(parts.get(2)));
        }
    }

    // Format 2: "Type error (line X): message"
    if str_starts_with(error, "Type error") {
        var start: i64 = str_find(error, "(line ");
        if start >= 0 {
            var rest2: str = c_str_substr(error, start + 6, str_len(error));
            var end: i64 = str_find(rest2, ")");
            if end >= 0 {
                var line2: i64 = c_str_parse_i64(c_str_substr(rest2, 0, end));
                return StrTriple_new(line2, 1, error);
            }
        }
        // "Type error:line:col: message"
        if str_starts_with(error, "Type error:") {
            var rest3: str = c_str_substr(error, 11, str_len(error));
            var parts2: Vec<str> = c_str_split_n(rest3, ":", 3);
            if parts2.len() >= 3 {
                var line3: i64 = c_str_parse_i64(str_trim(parts2.get(0)));
                var col3: i64 = c_str_parse_i64(str_trim(parts2.get(1)));
                return StrTriple_new(line3, col3, str_trim(parts2.get(2)));
            }
        }
    }

    // Format 3: "Parse error at line:col: message"
    if str_starts_with(error, "Parse error at ") {
        var rest4: str = c_str_substr(error, 14, str_len(error));
        var parts3: Vec<str> = c_str_split_n(rest4, ":", 3);
        if parts3.len() >= 3 {
            var line4: i64 = c_str_parse_i64(parts3.get(0));
            var col4: i64 = c_str_parse_i64(parts3.get(1));
            return StrTriple_new(line4, col4, str_trim(parts3.get(2)));
        }
    }

    return StrTriple_new(1, 1, error);
}

/// Enrich a list of error strings with source context.
/// Parses the "line N" or "at L:C" from each error string, extracts the
/// corresponding source line, and renders a full diagnostic with caret.
/// Errors that don't have line info are passed through unchanged.
pub fn enrich_errors(errors: Vec<str>, source: str, file: str) -> Vec<str> {
    var source_lines: Vec<str> = c_str_lines(source);
    var result: Vec<str> = Vec::new();

    var i: i64 = 0;
    while i < errors.len() {
        var err: str = errors.get(i);
        var lc: I64Pair = extract_line_col(err);
        var line: i64 = lc.first;
        var col: i64 = lc.second;

        if line == 0 || line > source_lines.len() {
            result.push(err);
            i = i + 1;
            continue;
        }

        var source_line: str = source_lines.get(line - 1);
        var span_len: i64 = estimate_span(err, source_line, col);

        // Build a simple enriched error message with source context
        var rendered: str = render_error_with_source(err, file, line, col, source_line, span_len);
        result.push(rendered);

        i = i + 1;
    }

    return result;
}

/// Render an error with source context (simplified version of diag::error_with_source).
fn render_error_with_source(msg: str, file: str, line: i64, col: i64, source_line: str, span_len: i64) -> str {
    var result: str = "";
    result = str_concat(result, "error: ");
    result = str_concat(result, msg);
    result = str_concat(result, "\n  --> ");
    result = str_concat(result, file);
    result = str_concat(result, ":");
    result = str_concat(result, int_to_str(line));
    result = str_concat(result, ":");
    result = str_concat(result, int_to_str(col));
    result = str_concat(result, "\n   | ");
    result = str_concat(result, source_line);
    result = str_concat(result, "\n   | ");

    // Print caret pointing at the error position
    var c: i64 = 1;
    while c < col {
        result = str_concat(result, " ");
        c = c + 1;
    }
    result = str_concat(result, "^");

    var s: i64 = 1;
    while s < span_len {
        result = str_concat(result, "~");
        s = s + 1;
    }

    return result;
}

/// Estimate the span length for the caret.
fn estimate_span(err: str, source_line: str, col: i64) -> i64 {
    // Look for "variable 'name'" pattern
    var idx: i64 = str_find(err, "variable '");
    if idx >= 0 {
        var rest: str = c_str_substr(err, idx + 10, str_len(err));
        var end: i64 = str_find(rest, "'");
        if end >= 0 {
            var name: str = c_str_substr(rest, 0, end);
            if str_contains(source_line, name) {
                return str_len(name);
            }
        }
    }

    // Look for "function 'name'" pattern
    idx = str_find(err, "function '");
    if idx >= 0 {
        var rest2: str = c_str_substr(err, idx + 10, str_len(err));
        var end2: i64 = str_find(rest2, "'");
        if end2 >= 0 {
            var name2: str = c_str_substr(rest2, 0, end2);
            if str_contains(source_line, name2) {
                return str_len(name2);
            }
        }
    }

    // Look for "field 'name'" pattern
    idx = str_find(err, "field '");
    if idx >= 0 {
        var rest3: str = c_str_substr(err, idx + 7, str_len(err));
        var end3: i64 = str_find(rest3, "'");
        if end3 >= 0 {
            var name3: str = c_str_substr(rest3, 0, end3);
            if str_contains(source_line, name3) {
                return str_len(name3);
            }
        }
    }

    return 1;
}

/// Extract help text from an error that contains "Fix:" or "Hint:".
pub fn extract_help(err: str) -> Option<str> {
    var idx: i64 = str_find(err, "Fix: ");
    if idx >= 0 {
        return Option::Some(str_trim(c_str_substr(err, idx + 5, str_len(err))));
    }
    idx = str_find(err, "Hint: ");
    if idx >= 0 {
        return Option::Some(str_trim(c_str_substr(err, idx + 6, str_len(err))));
    }
    return Option::None;
}

/// Classify an error string into an ErrCode.
/// Mirrors classify_error() in src/compiler.rs.
pub fn classify_error(err: str) -> ErrCode {
    // Normalize: strip "(line N)" from "Type error (line N): ..." -> "Type error: ..."
    var normalized: str = err;
    if str_starts_with(err, "Type error (line ") {
        var idx: i64 = str_find(err, "): ");
        if idx >= 0 {
            normalized = str_concat("Type error: ", c_str_substr(err, idx + 3, str_len(err)));
        }
    }

    if str_starts_with(normalized, "Type error: undefined variable") { return ErrCode::UndefinedVariable; }
    if str_starts_with(normalized, "Type error: undefined function") { return ErrCode::UndefinedFunction; }
    if str_starts_with(normalized, "Type error: undefined struct") { return ErrCode::UndefinedStruct; }
    if str_starts_with(normalized, "Type error: struct") && str_contains(normalized, "has no field") { return ErrCode::UndefinedField; }
    if str_contains(normalized, "cannot assign") { return ErrCode::TypeMismatch; }
    if str_starts_with(normalized, "Type error: if condition must be bool") { return ErrCode::IfConditionNotBool; }
    if str_contains(normalized, "expects") && str_contains(normalized, "args") { return ErrCode::ArgCountMismatch; }
    if str_contains(normalized, "missing return") { return ErrCode::MissingReturn; }
    if str_starts_with(normalized, "Init error") { return ErrCode::InitBeforeAssign; }
    if str_starts_with(normalized, "Linear error") || str_contains(normalized, "linear") { return ErrCode::NotLinear; }
    if str_starts_with(normalized, "Capability error") { return ErrCode::CapabilityDenied; }
    if str_starts_with(normalized, "Sandbox error") { return ErrCode::SandboxViolation; }
    if str_starts_with(normalized, "Conservation error") { return ErrCode::ConservationViolation; }
    if str_starts_with(normalized, "Gas error") { return ErrCode::GasExceeded; }
    if str_starts_with(normalized, "Effect error") { return ErrCode::EffectMismatch; }
    if str_starts_with(normalized, "Parse error") { return ErrCode::ExpectedToken; }
    if str_starts_with(normalized, "Error:") { return ErrCode::UnexpectedChar; }
    if str_starts_with(normalized, "borrow error") { return ErrCode::BorrowConflict; }
    if str_starts_with(normalized, "Panic:") { return ErrCode::NoMain; }
    return ErrCode::Custom;
}

// ===========================================================================
// Capability checking
// ===========================================================================

/// Check if an effect name is a capability (Net, IO, FS, etc.)
pub fn is_capability(eff: str) -> bool {
    if eff == "Net" { return true; }
    if eff == "IO" { return true; }
    if eff == "FS" { return true; }
    if eff == "Process" { return true; }
    if eff == "Env" { return true; }
    if eff == "Medical" { return true; }
    return false;
}

// ===========================================================================
// Levenshtein edit distance (for module name suggestions)
// ===========================================================================

pub fn edit_distance(a: str, b: str) -> i64 {
    var a_len: i64 = str_len(a);
    var b_len: i64 = str_len(b);

    if a_len == 0 { return b_len; }
    if b_len == 0 { return a_len; }

    // Use a 2D matrix (flattened to 1D)
    var matrix: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i <= a_len {
        var j: i64 = 0;
        while j <= b_len {
            if i == 0 {
                matrix.push(j);
            } else if j == 0 {
                matrix.push(i);
            } else {
                var cost: i64 = 1;
                if str_slice(a, i - 1, i) == str_slice(b, j - 1, j) { cost = 0; }

                var del: i64 = matrix.get((i - 1) * (b_len + 1) + j) + 1;
                var ins: i64 = matrix.get(i * (b_len + 1) + (j - 1)) + 1;
                var sub: i64 = matrix.get((i - 1) * (b_len + 1) + (j - 1)) + cost;

                var min_val: i64 = del;
                if ins < min_val { min_val = ins; }
                if sub < min_val { min_val = sub; }
                matrix.push(min_val);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    return matrix.get(a_len * (b_len + 1) + b_len);
}

// ===========================================================================
// Project root discovery
// ===========================================================================

/// Walk up from `start` to find the project root -- the first directory
/// containing a `stdlib/` or `compiler/` subdirectory.
/// Falls back to `start` itself if none is found.
pub fn find_project_root(start: str) -> str {
    var current: str = start;
    var i: i64 = 0;
    while i < 100 {
        // Check for specific markers that identify the project root
        // (stdlib/core.fd or Cargo.toml) rather than just "stdlib" or "compiler"
        // which could match compiled binaries in subdirectories
        if c_file_exists(c_path_join(current, "stdlib/core.fd")) || c_file_exists(c_path_join(current, "Cargo.toml")) {
            return current;
        }
        var parent: str = c_path_dirname(current);
        if parent == current || str_len(parent) == 0 {
            break;
        }
        current = parent;
        i = i + 1;
    }
    return start;
}

// ===========================================================================
// Pipeline -- parse, typecheck, lower, mono
// ===========================================================================

/// Parse source code into a Program (without stdlib merge).
fn parse_source(source: str) -> ParseResultProgram {
    var lex: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lex.tokenize();
    var p: Parser = Parser_new(tokens);
    return p.parse();
}

/// Build a program from source code (no path -- no import resolution).
pub fn build_program(source: str) -> ResultProgram {
    return build_program_with_path(source, OptStr::None);
}

/// G8.2: Wrapper that uses default borrowck mode "on".
pub fn build_program_with_path(source: str, source_path: OptStr) -> ResultProgram {
    return build_program_with_path_borrowck(source, source_path, "on");
}

/// Build a program in no-stdlib mode (--bare / --no-std).
/// Skips loading stdlib/core.fd entirely. The user program must define
/// everything it needs, including any runtime functions.
/// This is for kernel/UEFI/bare-metal development where the program
/// must have ZERO hidden runtime dependencies.
pub fn build_program_no_std(source: str, source_path: OptStr) -> ResultProgram {
    // Legacy entry point used by main.fd (--boot / --bare). Those callers do
    // not pass the --borrowck mode through, so no-std builds reached via this
    // function skip borrow checking entirely. Callers that have the mode
    // should use build_program_no_std_borrowck instead.
    return build_program_no_std_borrowck(source, source_path, "off");
}

/// No-std build that honors the borrow-checker mode ("off", "warn", "on")
/// exactly like build_program_with_path_borrowck does for the stdlib path.
pub fn build_program_no_std_borrowck(source: str, source_path: OptStr, borrowck_mode: str) -> ResultProgram {
    p_eprint_str("[build] No-stdlib mode: skipping stdlib/core.fd\n");
    // Parse user code without stdlib names
    var lex: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lex.tokenize();
    if lex.errors.len() > 0 {
        var file: str = "<stdin>";
        match source_path {
            OptStr::Some(p) => { file = p; }
            OptStr::None => { }
        }
        return ResultProgram::Err(enrich_errors(lex.errors, source, file));
    }
    var empty_struct_names: Vec<str> = Vec::new();
    var empty_enum_names: Vec<str> = Vec::new();
    var p: Parser = Parser_with_names(tokens, empty_struct_names, empty_enum_names);
    var user_result: ParseResultProgram = p.parse();
    match user_result {
        ParseResultProgram::Err(e) => {
            var file2: str = "<stdin>";
            match source_path {
                OptStr::Some(p2) => { file2 = p2; }
                OptStr::None => { }
            }
            return ResultProgram::Err(enrich_errors(c_vec1(e), source, file2));
        }
        ParseResultProgram::Ok(user) => {
            // In no-std mode, skip stdlib merge but DO resolve `use` imports
            // from disk (for multi-module kernels/firmware).
            var program: Program = user;

            // -- Resolve use imports from disk (no stdlib in no-std mode) ----
            var imported_modules: Vec<Program> = Vec::new();
            var imported_module_names: Vec<str> = Vec::new();
            var loaded_module_names: Vec<str> = Vec::new();
            var has_source_path: bool = false;
            var base_dir: str = ".";
            match source_path {
                OptStr::Some(sp) => {
                    has_source_path = true;
                    base_dir = c_path_dirname(sp);
                }
                OptStr::None => { }
            }

            if has_source_path && user.imports.len() > 0 {
                p_eprint_str("[build] No-std: resolving imports...\n");
                var project_root: str = find_project_root(base_dir);
                var imports_to_process: Vec<str> = Vec::new();
                var ui: i64 = user.imports.len() - 1;
                while ui >= 0 {
                    imports_to_process.push(user.imports.get(ui).path);
                    ui = ui - 1;
                }

                while imports_to_process.len() > 0 {
                    var import_path: str = imports_to_process.get(imports_to_process.len() - 1);
                    imports_to_process.pop();
                    // Skip "core" -- not available in no-std mode
                    if import_path == "core" { continue; }
                    // Skip already-loaded modules
                    var already_loaded: bool = false;
                    var li: i64 = 0;
                    while li < loaded_module_names.len() {
                        if loaded_module_names.get(li) == import_path {
                            already_loaded = true;
                            break;
                        }
                        li = li + 1;
                    }
                    if already_loaded { continue; }

                    // Try candidate paths (base_dir + project_root, no stdlib)
                    var path_str: str = str_replace(import_path, "::", "/");
                    var candidates: Vec<str> = Vec::new();
                    candidates.push(c_path_join(base_dir, str_concat(path_str, ".fd")));
                    candidates.push(c_path_join(base_dir, c_path_join(path_str, "mod.fd")));
                    candidates.push(c_path_join(project_root, str_concat(path_str, ".fd")));
                    candidates.push(c_path_join(project_root, c_path_join(path_str, "mod.fd")));

                    var found_path: str = "";
                    var found: bool = false;
                    var ci: i64 = 0;
                    while ci < candidates.len() {
                        if c_file_exists(candidates.get(ci)) {
                            found_path = candidates.get(ci);
                            found = true;
                            break;
                        }
                        ci = ci + 1;
                    }

                    if found {
                        p_eprint_str("[build] No-std: loading import: ");
                        p_eprint_str(found_path);
                        p_eprint_str("\n");
                        var module_source: str = p_file_read(found_path);
                        if module_source == 0 {
                            p_eprint_str("[build] Warning: could not read: ");
                            p_eprint_str(found_path);
                            p_eprint_str("\n");
                            continue;
                        }
                        var empty_struct_names: Vec<str> = Vec::new();
                        var empty_enum_names: Vec<str> = Vec::new();
                        var ilex: Lexer = Lexer::new(module_source);
                        var itokens: Vec<Token> = ilex.tokenize();
                        var ip: Parser = Parser_with_names(itokens, empty_struct_names, empty_enum_names);
                        var iresult: ParseResultProgram = ip.parse();
                        match iresult {
                            ParseResultProgram::Err(e) => {
                                return ResultProgram::Err(enrich_errors(c_vec1(e), module_source, found_path));
                            }
                            ParseResultProgram::Ok(imported) => {
                                var module_name: str = import_path;
                                match imported.module {
                                    OptStr::Some(mn) => { module_name = mn; }
                                    OptStr::None => { }
                                }
                                // Queue transitive imports
                                var ti: i64 = 0;
                                while ti < imported.imports.len() {
                                    var trans_path: str = imported.imports.get(ti).path;
                                    var trans_loaded: bool = false;
                                    var tli: i64 = 0;
                                    while tli < loaded_module_names.len() {
                                        if loaded_module_names.get(tli) == trans_path {
                                            trans_loaded = true;
                                            break;
                                        }
                                        tli = tli + 1;
                                    }
                                    if !trans_loaded && trans_path != "core" {
                                        imports_to_process.push(trans_path);
                                    }
                                    ti = ti + 1;
                                }
                                loaded_module_names.push(import_path);
                                imported_modules.push(imported);
                                imported_module_names.push(module_name);
                            }
                        }
                    }
                }
            }

            // Apply desugar and default trait methods
            desugar_layers_models(&mut program);
            desugar_phase8b(&mut program);
            program = process_gen(program);
            fill_default_trait_methods(&mut program);

            // Merge imported modules into the program (imports first, user wins)
            var mi: i64 = 0;
            while mi < imported_modules.len() {
                program = merge_programs(program, imported_modules.get(mi));
                mi = mi + 1;
            }

            // Typecheck — register imported modules first, then user
            p_eprint_str("[build] No-std: typechecking (no stdlib)...\n");
            var tc: TypeChecker = TypeChecker::new();
            // Register imported modules first so their functions are visible
            var mi2: i64 = 0;
            while mi2 < imported_modules.len() {
                TypeChecker_register_program(&mut tc, imported_modules.get(mi2), imported_module_names.get(mi2));
                mi2 = mi2 + 1;
            }
            var user_module: str = "main";
            match user.module {
                OptStr::Some(m2) => { user_module = m2; }
                OptStr::None => { }
            }
            TypeChecker_register_program(&mut tc, user, user_module);
            TypeChecker_register_trait_impls(&mut tc, program);
            TypeChecker_register_generated_decls(&mut tc, program);
            TypeChecker_verify_trait_impls(&mut tc, program);
            TypeChecker_collect_capabilities(&mut tc, user);
            TypeChecker_check_bodies(&mut tc, program);
            // Also check imported module bodies
            var mi3: i64 = 0;
            while mi3 < imported_modules.len() {
                TypeChecker_collect_capabilities(&mut tc, imported_modules.get(mi3));
                TypeChecker_check_bodies(&mut tc, imported_modules.get(mi3));
                mi3 = mi3 + 1;
            }
            if tc.errors.len() > 0 {
                var file3: str = "<stdin>";
                match source_path {
                    OptStr::Some(p3) => { file3 = p3; }
                    OptStr::None => { }
                }
                return ResultProgram::Err(enrich_errors(tc.errors, source, file3));
            }
            var escape_errors: Vec<str> = escape_check(program);
            if escape_errors.len() > 0 {
                var file6: str = "<stdin>";
                match source_path {
                    OptStr::Some(p6) => { file6 = p6; }
                    OptStr::None => { }
                }
                return ResultProgram::Err(enrich_errors(escape_errors, source, file6));
            }
            var secret_errors: Vec<str> = secrecy_check(program);
            if secret_errors.len() > 0 {
                var file7: str = "<stdin>";
                match source_path {
                    OptStr::Some(p7) => { file7 = p7; }
                    OptStr::None => { }
                }
                return ResultProgram::Err(enrich_errors(secret_errors, source, file7));
            }
            // G8.2: Borrow check -- same mode handling as the stdlib path.
            //   "off"  : skip borrow checking entirely
            //   "warn" : report errors as warnings, don't fail
            //   "on"   : report errors and fail compilation
            if borrowck_mode != "off" {
                p_eprint_str("[build] No-std: borrow checking (mode=");
                p_eprint_str(borrowck_mode);
                p_eprint_str(")...\n");
                var bc_mode: BorrowckMode = BorrowckMode::On;
                if borrowck_mode == "warn" {
                    bc_mode = BorrowckMode::Warn;
                }
                var bc: BorrowChecker = BorrowChecker_new(bc_mode);
                check(&mut bc, program);
                if bc.errors.len() > 0 {
                    var file4: str = "<stdin>";
                    match source_path {
                        OptStr::Some(p4) => { file4 = p4; }
                        OptStr::None => { }
                    }
                    if borrowck_mode == "warn" {
                        var ei: i64 = 0;
                        while ei < bc.errors.len() {
                            p_eprint_str("warning: ");
                            p_eprint_str(bc.errors.get(ei));
                            p_eprint_str("\n");
                            ei = ei + 1;
                        }
                    } else {
                        return ResultProgram::Err(enrich_errors(bc.errors, source, file4));
                    }
                }
            } else {
                p_eprint_str("[build] No-std: borrow checking skipped (mode=off).\n");
            }
            // Monomorphize
            p_eprint_str("[build] No-std: monomorphizing...\n");
            var mono_result: Program = monomorphize(program);
            return ResultProgram::Ok(mono_result);
        }
    }
}

/// Build a program with optional file path for resolving `use` imports.
/// Cached parsed stdlib for LSP (avoids re-parsing on every keystroke).
/// Uses module-level vars for persistence across calls in a single process.
pub var g_stdlib_cache: OptProgram = OptProgram::None;
var g_stdlib_struct_names: Vec<str> = Vec::new();
var g_stdlib_enum_names: Vec<str> = Vec::new();
var g_stdlib_cache_init: bool = false;
var g_stdlib_dir_found: bool = false;
var g_stdlib_dir: str = "stdlib";

// Native Windows emit: merge the Fides PE runtime (pe_runtime/*.fd) into
// core before the user program parses, as Rust's build_program_with_runtime
// does, so a call to builtin `p_X` can run `pert_X` (see pe_ir resolve_call).
pub var g_pe_runtime_merge: bool = false;
pub fn set_pe_runtime_merge(v: bool) { g_pe_runtime_merge = v; }

/// Locate a PE runtime source file: beside stdlib/ when installed, in the
/// repo's src/pe_runtime/ otherwise.
pub fn pe_runtime_path(name: str) -> str {
    var p1: str = c_path_join(stdlib_dir(), c_path_join("pe_runtime", name));
    if c_file_exists(p1) { return p1; }
    return c_path_join("src", c_path_join("pe_runtime", name));
}

/// The standard library's directory: ./stdlib (the repository), else that
/// of an installed toolchain: $FID_HOME/stdlib, <exe dir>/stdlib,
/// <exe dir>/../stdlib (as the Rust compiler looks).
pub fn stdlib_dir() -> str {
    if g_stdlib_dir_found {
        return g_stdlib_dir;
    }
    g_stdlib_dir_found = true;
    var candidates: Vec<str> = Vec::new();
    candidates.push("stdlib");
    var home: str = env_or_empty("FID_HOME");
    if str_len(home) > 0 {
        candidates.push(c_path_join(home, "stdlib"));
    }
    var dir: str = exe_dir();
    candidates.push(c_path_join(dir, "stdlib"));
    candidates.push(c_path_join(c_path_dirname(dir), "stdlib"));
    var i: i64 = 0;
    while i < candidates.len() {
        p_print_str("[sd] cand=" + candidates.get(i));
        if c_file_exists(c_path_join(candidates.get(i), "core.fd")) {
            p_print_str("[sd] hit=" + candidates.get(i));
            g_stdlib_dir = candidates.get(i);
            return g_stdlib_dir;
        }
        i = i + 1;
    }
    return g_stdlib_dir;
}

/// The directory of this compiler's executable: from argv[0], or (started
/// by name, as `fides run x.fd`) the PATH entry that holds it.
fn exe_dir() -> str {
    var exe: str = p_argv(0);
    if str_contains(exe, "/") || str_contains(exe, "\\") {
        return c_path_dirname(exe);
    }
    var path: str = env_or_empty("PATH");
    var sep: str = ":";
    if str_contains(path, ";") {
        sep = ";";
    }
    var dirs: Vec<str> = str_split(path, sep);
    var i: i64 = 0;
    while i < dirs.len() {
        var d: str = dirs.get(i);
        if str_len(d) > 0 {
            if c_file_exists(c_path_join(d, exe)) || c_file_exists(c_path_join(d, exe + ".exe")) {
                return d;
            }
        }
        i = i + 1;
    }
    return ".";
}

/// G8.7: Global lint warnings populated by build_program_with_path.
/// Read by lint_source after a successful build.
pub var g_lint_warnings: Vec<str> = Vec::new();

/// G8.2: Global borrow-checker mode. Set by the CLI before calling the pipeline.
/// "off" = skip borrow checking, "warn" = report but don't fail, "on" = fail on errors.
pub var g_borrowck_mode: str = "on";

/// G8.2: Setter for the borrow-checker mode (called from main.fd).
/// Fides doesn't support module-qualified assignment, so we use a function.
pub fn set_borrowck_mode(mode: str) {
    g_borrowck_mode = mode;
}

/// Get the cached parsed stdlib. Parses on first call, returns cache on subsequent calls.
/// Returns (stdlib_program, struct_names, enum_names).
pub fn get_cached_stdlib() -> OptProgram {
    if g_stdlib_cache_init {
        return g_stdlib_cache;
    }
    // Parse stdlib/core.fd
    var stdlib_raw: str = p_file_read(c_path_join(stdlib_dir(), "core.fd"));
    if stdlib_raw == 0 {
        return OptProgram::None;
    }
    var stdlib_result: ParseResultProgram = parse_source(stdlib_raw);
    match stdlib_result {
        ParseResultProgram::Ok(stdlib) => {
            g_stdlib_cache = OptProgram::Some(stdlib);
            g_stdlib_cache_init = true;
            return g_stdlib_cache;
        }
        ParseResultProgram::Err(_) => {
            return OptProgram::None;
        }
    }
}

/// This is the main entry point for the compiler pipeline:
///   parse stdlib -> parse user -> resolve imports -> merge -> cfg filter ->
///   derive -> desugar layers/models -> comptime -> typecheck -> borrowck -> mono
/// G8.2: borrowck_mode is "off", "warn", or "on" (default).
pub fn build_program_with_path_borrowck(source: str, source_path: OptStr, borrowck_mode: str) -> ResultProgram {
    var t0: i64 = p_clock_now_ms();
    match source_path {
        OptStr::Some(main_path) => { inc_record_file(main_path); }
        OptStr::None => {}
    }
    // Parse stdlib first (use cache if available)
    var stdlib_opt: OptProgram = get_cached_stdlib();
    match stdlib_opt {
        OptProgram::None => {
            p_eprint_str("[build] FAILED: stdlib/core.fd not found or parse error\n");
            return ResultProgram::Err(c_vec1("Stdlib not found: stdlib/core.fd (CWD must be project root)"));
        }
        OptProgram::Some(stdlib_parsed) => {
            var stdlib: Program = stdlib_parsed;
            p_eprint_str("[build] Stdlib parsed ok (cached). Extracting names...\n");
            // Extract stdlib struct/enum names for parser
            var struct_names: Vec<str> = Vec::new();
            var enum_names: Vec<str> = Vec::new();
            var i: i64 = 0;
            while i < stdlib.structs.len() {
                struct_names.push(stdlib.structs.get(i).name);
                i = i + 1;
            }
            i = 0;
            while i < stdlib.enums.len() {
                enum_names.push(stdlib.enums.get(i).name);
                i = i + 1;
            }

            // The Fides runtime of native Windows executables
            // (pe_runtime/*.fd): merged into core before the user program
            // is parsed — the same merge as Rust's
            // build_program_with_runtime (core's definitions win).
            if g_pe_runtime_merge {
                var rt_files: Vec<str> = Vec::new();
                rt_files.push("base.fd");
                rt_files.push("conc.fd");
                rt_files.push("tensor.fd");
                rt_files.push("data.fd");
                var rti: i64 = 0;
                while rti < rt_files.len() {
                    var rt_path: str = pe_runtime_path(rt_files.get(rti));
                    var rt_raw: str = p_file_read(rt_path);
                    if rt_raw == 0 {
                        return ResultProgram::Err(c_vec1("PE runtime source not found: " + rt_path));
                    }
                    var rt_lex: Lexer = Lexer::new(rt_raw);
                    var rt_tokens: Vec<Token> = rt_lex.tokenize();
                    var rt_parser: Parser = Parser_with_names(rt_tokens, struct_names, enum_names);
                    var rt_res: ParseResultProgram = rt_parser.parse();
                    match rt_res {
                        ParseResultProgram::Err(e) => {
                            return ResultProgram::Err(c_vec1("PE runtime: " + e));
                        }
                        ParseResultProgram::Ok(rt_program) => {
                            var rsi: i64 = 0;
                            while rsi < rt_program.structs.len() {
                                struct_names.push(rt_program.structs.get(rsi).name);
                                rsi = rsi + 1;
                            }
                            rsi = 0;
                            while rsi < rt_program.enums.len() {
                                enum_names.push(rt_program.enums.get(rsi).name);
                                rsi = rsi + 1;
                            }
                            stdlib = merge_programs(rt_program, stdlib);
                        }
                    }
                    rti = rti + 1;
                }
            }

            // Parse user code with stdlib names pre-populated
            p_eprint_str("[build] Lexing user code...\n");
            var t3: i64 = p_clock_now_ms();
            var lex: Lexer = Lexer::new(source);
            var tokens: Vec<Token> = lex.tokenize();
            var t4: i64 = p_clock_now_ms();
            p_eprint_str("[prof] user lex: ");
            p_eprint_str(int_to_str(t4 - t3));
            p_eprint_str("ms\n");
            p_eprint_str("[build] User code lexed. Checking errors...\n");

            // Check for lexer errors
            if lex.errors.len() > 0 {
                p_eprint_str("[build] FAILED: lexer errors\n");
                var file: str = "<stdin>";
                match source_path {
                    OptStr::Some(p) => { file = p; }
                    OptStr::None => { }
                }
                return ResultProgram::Err(enrich_errors(lex.errors, source, file));
            }
            p_eprint_str("[build] Parsing user code...\n");
            var t5: i64 = p_clock_now_ms();
            var p: Parser = Parser_with_names(tokens, struct_names, enum_names);
            p_eprint_str("[build] Parser created. Calling parse()...\n");
            var user_result: ParseResultProgram = p.parse();
            var t6: i64 = p_clock_now_ms();
            p_eprint_str("[prof] user parse: ");
            p_eprint_str(int_to_str(t6 - t5));
            p_eprint_str("ms\n");
            p_eprint_str("[build] Parse done.\n");
            match user_result {
                ParseResultProgram::Err(e) => {
                    var file2: str = "<stdin>";
                    match source_path {
                        OptStr::Some(p2) => { file2 = p2; }
                        OptStr::None => { }
                    }
                    return ResultProgram::Err(enrich_errors(c_vec1(e), source, file2));
                }
                ParseResultProgram::Ok(user) => {
                    // Collect all known struct/enum names
                    i = 0;
                    while i < user.structs.len() {
                        struct_names.push(user.structs.get(i).name);
                        i = i + 1;
                    }
                    i = 0;
                    while i < user.enums.len() {
                        enum_names.push(user.enums.get(i).name);
                        i = i + 1;
                    }

                    // -- Resolve use imports from disk --------------------------
                    // When source_path is provided, load `use foo::bar;` imports
                    // from disk, handling transitive dependencies.
                    //
                    // OPTIMIZATION (session 4): file content and tokens are cached
                    // by path to avoid re-reading and re-lexing deferred modules.
                    // Previously each module was read+lexed 2-3 times; now once.
                    var imported_modules: Vec<Program> = Vec::new();
                    var imported_module_names: Vec<str> = Vec::new();
                    var loaded_module_names: Vec<str> = Vec::new();
                    // O(1) membership set for loaded modules -- avoids O(n) linear
                    // search in c_str_vec_contains during import resolution.
                    var loaded_module_set: i64 = HashMap_new();
                    var struct_name_set: i64 = HashMap_new();
                    var enum_name_set: i64 = HashMap_new();
                    var content_cache: Vec<PathContent> = Vec::new();
                    var token_cache: Vec<PathTokens> = Vec::new();
                    var parse_cache: Vec<PathProgram> = Vec::new();
                    var has_source_path: bool = false;
                    var base_dir: str = ".";
                    match source_path {
                        OptStr::Some(sp) => {
                            has_source_path = true;
                            base_dir = c_path_dirname(sp);
                        }
                        OptStr::None => { }
                    }

                    if has_source_path {
                        p_eprint_str("[build] Resolving imports...\n");
                        // Collect imports to process (LIFO -- reversed so earlier
                        // imports are processed first via pop())
                        var imports_to_process: Vec<str> = Vec::new();
                        var ui: i64 = user.imports.len() - 1;
                        p_eprint_str("[build] user.imports.len() = ");
                        p_eprint_str(int_to_str(user.imports.len()));
                        p_eprint_str("\n");
                        while ui >= 0 {
                            imports_to_process.push(user.imports.get(ui).path);
                            ui = ui - 1;
                        }

                        // Track modules that are currently deferred (waiting for deps).
                        // If a module is deferred again while already in this set,
                        // it means there's a cyclic import -- report an error.
                        var currently_deferred: Vec<str> = Vec::new();

                        var project_root: str = find_project_root(base_dir);

                        while imports_to_process.len() > 0 {
                            var import_path: str = imports_to_process.get(imports_to_process.len() - 1);
                            imports_to_process.pop();
                            p_eprint_str("[build] Processing import: ");
                            p_eprint_str(import_path);
                            p_eprint_str("\n");

                            // Skip "core" -- auto-included
                            if import_path == "core" { continue; }

                            // Skip already-loaded modules -- O(1) HashMap lookup
                            if HashMap_get(loaded_module_set, import_path) != 0 { continue; }

                            // Try candidate paths
                            var path_str: str = str_replace(import_path, "::", "/");
                            var candidates: Vec<str> = Vec::new();
                            candidates.push(c_path_join(base_dir, str_concat(path_str, ".fd")));
                            candidates.push(c_path_join(base_dir, c_path_join(path_str, "mod.fd")));
                            candidates.push(c_path_join(stdlib_dir(), str_concat(path_str, ".fd")));
                            candidates.push(c_path_join(stdlib_dir(), c_path_join(path_str, "mod.fd")));
                            candidates.push(c_path_join(project_root, str_concat(path_str, ".fd")));
                            candidates.push(c_path_join(project_root, c_path_join(path_str, "mod.fd")));

                            var found_path: str = "";
                            var found: bool = false;
                            var ci: i64 = 0;
                            while ci < candidates.len() {
                                if c_file_exists(candidates.get(ci)) {
                                    found_path = candidates.get(ci);
                                    found = true;
                                    break;
                                }
                                // A file created here later would change this import.
                                inc_record_absent(candidates.get(ci));
                                ci = ci + 1;
                            }

                            if found {
                                inc_record_file(found_path);
                                // OPTIMIZATION: use cached file read + cached lex + cached parse
                                var pre_toks: Vec<Token> = cached_lex(token_cache, content_cache, found_path);

                                // Pre-scan: parse to extract imports and type names.
                                // OPTIMIZATION: use cached_parse to avoid re-parsing deferred modules.
                                var pre_result_opt: OptProgram = cached_parse(parse_cache, token_cache, content_cache, found_path, struct_names, enum_names);

                                match pre_result_opt {
                                    OptProgram::Some(pre_prog) => {
                                        // Add this module's type names to name sets
                                        var si: i64 = 0;
                                        while si < pre_prog.structs.len() {
                                            var sn: str = pre_prog.structs.get(si).name;
                                            if HashMap_get(struct_name_set, sn) == 0 {
                                                struct_names.push(sn);
                                                HashMap_insert(struct_name_set, sn, 1);
                                            }
                                            si = si + 1;
                                        }
                                        var ei: i64 = 0;
                                        while ei < pre_prog.enums.len() {
                                            var en: str = pre_prog.enums.get(ei).name;
                                            if HashMap_get(enum_name_set, en) == 0 {
                                                enum_names.push(en);
                                                HashMap_insert(enum_name_set, en, 1);
                                            }
                                            ei = ei + 1;
                                        }

                                        // Check for unloaded transitive deps
                                        var unloaded_deps: Vec<str> = Vec::new();
                                        var di: i64 = 0;
                                        while di < pre_prog.imports.len() {
                                            var dep: str = pre_prog.imports.get(di).path;
                                            if dep != "core" && HashMap_get(loaded_module_set, dep) == 0 {
                                                unloaded_deps.push(dep);
                                            }
                                            di = di + 1;
                                        }

                                        if unloaded_deps.len() > 0 {
                                            // Cycle detection: if this module is already deferred,
                                            // it means we're in a cyclic import chain.
                                            if cc_c_str_vec_contains(currently_deferred, import_path) {
                                                p_eprint_str("[build] WARNING: cyclic import detected involving '");
                                                p_eprint_str(import_path);
                                                p_eprint_str("' -- skipping\n");
                                                continue;
                                            }
                                            // Defer: push this module back, then push deps
                                            currently_deferred.push(import_path);
                                            imports_to_process.push(import_path);
                                            var di2: i64 = 0;
                                            while di2 < unloaded_deps.len() {
                                                if HashMap_get(loaded_module_set, unloaded_deps.get(di2)) == 0 {
                                                    imports_to_process.push(unloaded_deps.get(di2));
                                                }
                                                di2 = di2 + 1;
                                            }
                                            continue;
                                        }

                                        // All deps loaded — reuse pre-scan result as the
                                        // final parse. The pre-scan already parsed the
                                        // module successfully; the only difference between
                                        // pre-scan and full parse is the name sets, but a
                                        // module rarely needs its own type names
                                        // pre-registered to parse correctly (the pre-scan
                                        // already succeeded without them).
                                        // OPTIMIZATION: this eliminates the second parse
                                        // (pre-scan + full → just pre-scan), cutting parse
                                        // time in half for the import phase.
                                        var imported: Program = pre_prog;

                                        var mod_name: str = import_path;
                                        match imported.module {
                                            OptStr::Some(mn) => { mod_name = mn; }
                                            OptStr::None => { }
                                        }
                                        loaded_module_names.push(import_path);
                                        loaded_module_names.push(mod_name);
                                        HashMap_insert(loaded_module_set, import_path, 1);
                                        HashMap_insert(loaded_module_set, mod_name, 1);

                                        // Clear from deferred set -- successfully loaded
                                        var deferred_idx: i64 = 0;
                                        while deferred_idx < currently_deferred.len() {
                                            if currently_deferred.get(deferred_idx) == import_path {
                                                currently_deferred.remove(deferred_idx);
                                                break;
                                            }
                                            deferred_idx = deferred_idx + 1;
                                        }

                                        // Extract names for future imports
                                        var si2: i64 = 0;
                                        while si2 < imported.structs.len() {
                                            var sn2: str = imported.structs.get(si2).name;
                                            if HashMap_get(struct_name_set, sn2) == 0 {
                                                struct_names.push(sn2);
                                                HashMap_insert(struct_name_set, sn2, 1);
                                            }
                                            si2 = si2 + 1;
                                        }
                                        var ei2: i64 = 0;
                                        while ei2 < imported.enums.len() {
                                            var en2: str = imported.enums.get(ei2).name;
                                            if HashMap_get(enum_name_set, en2) == 0 {
                                                enum_names.push(en2);
                                                HashMap_insert(enum_name_set, en2, 1);
                                            }
                                            ei2 = ei2 + 1;
                                        }

                                        // Add transitive imports
                                        var ti: i64 = 0;
                                        while ti < imported.imports.len() {
                                            var tpath: str = imported.imports.get(ti).path;
                                            if HashMap_get(loaded_module_set, tpath) == 0 {
                                                imports_to_process.push(tpath);
                                            }
                                            ti = ti + 1;
                                        }

                                        imported_modules.push(imported);
                                        imported_module_names.push(mod_name);
                                    }
                                    OptProgram::None => {
                                        // Pre-scan failed -- try full parse directly
                                        // OPTIMIZATION: reuse cached tokens
                                        var p2: Parser = Parser_with_names(pre_toks, struct_names, enum_names);
                                        var full_result: ParseResultProgram = p2.parse();
                                        match full_result {
                                            ParseResultProgram::Ok(imported) => {
                                                var mod_name: str = import_path;
                                                match imported.module {
                                                    OptStr::Some(mn) => { mod_name = mn; }
                                                    OptStr::None => { }
                                                }
                                                loaded_module_names.push(import_path);
                                                loaded_module_names.push(mod_name);
                                                HashMap_insert(loaded_module_set, import_path, 1);
                                                HashMap_insert(loaded_module_set, mod_name, 1);
                                                imported_modules.push(imported);
                                                imported_module_names.push(mod_name);
                                            }
                                            ParseResultProgram::Err(errs2) => {
                                                // Full parse also failed -- return error
                                                var err_msg: str = "Import error: failed to parse module '" + import_path + "'";
                                                err_msg = err_msg + ": " + errs2;
                                                return ResultProgram::Err(c_vec1(err_msg));
                                            }
                                        }
                                    }
                                }
                            } else {
                                // Import not found -- return error
                                var dbg_i: i64 = 0;
                                while dbg_i < candidates.len() {
                                    p_eprint_str("[dbg] candidate: '");
                                    p_eprint_str(candidates.get(dbg_i));
                                    p_eprint_str("'\n");
                                    dbg_i = dbg_i + 1;
                                }
                                p_eprint_str("[dbg] base_dir='");
                                p_eprint_str(base_dir);
                                p_eprint_str("' stdlib_dir='");
                                p_eprint_str(stdlib_dir());
                                p_eprint_str("' project_root='");
                                p_eprint_str(project_root);
                                p_eprint_str("'\n");
                                return ResultProgram::Err(c_vec1(str_concat("Import error: could not resolve module '", str_concat(import_path, "'"))));
                            }
                        }

                        // Re-parse user code with full name set (including imported types)
                        var reparser: Parser = Parser_with_names(tokens, struct_names, enum_names);
                        var reparse_result: ParseResultProgram = reparser.parse();
                        match reparse_result {
                            ParseResultProgram::Ok(reparsed) => {
                                user = reparsed;
                            }
                            ParseResultProgram::Err(_) => { }
                        }
                    }

                    // A user function named like a function of one imported
                    // module: each side keeps its own (module__name).
                    cc_qualify_shadowed_imports(imported_modules, imported_module_names, user);

                    // `cap Sub: Super`: Sub carries Super's methods.
                    var trait_defs: Vec<TraitDef> = Vec::new();
                    cc_push_traits(trait_defs, stdlib);
                    var tmi: i64 = 0;
                    while tmi < imported_modules.len() {
                        cc_push_traits(trait_defs, imported_modules.get(tmi));
                        tmi = tmi + 1;
                    }
                    cc_push_traits(trait_defs, user);
                    var super_errors: Vec<str> = Vec::new();
                    tmi = 0;
                    while tmi < imported_modules.len() {
                        cc_inherit_supertraits(imported_modules.get(tmi), trait_defs, super_errors);
                        tmi = tmi + 1;
                    }
                    cc_inherit_supertraits(user, trait_defs, super_errors);
                    if super_errors.len() > 0 {
                        return ResultProgram::Err(super_errors);
                    }

                    // A function defined twice in one module used to collapse
                    // silently into one (src/compiler.rs find_module_conflicts).
                    var dup_errors: Vec<str> = Vec::new();
                    var dmi: i64 = 0;
                    while dmi < imported_modules.len() {
                        cc_find_duplicate_funcs(imported_modules.get(dmi), imported_module_names.get(dmi), dup_errors);
                        dmi = dmi + 1;
                    }
                    var dup_user_module: str = "main";
                    match user.module {
                        OptStr::Some(um) => { dup_user_module = um; }
                        OptStr::None => {}
                    }
                    cc_find_duplicate_funcs(user, dup_user_module, dup_errors);
                    if dup_errors.len() > 0 {
                        return ResultProgram::Err(dup_errors);
                    }

                    // Merge: start with stdlib, then imported modules, then user
                    var program: Program = stdlib;

                    // Merge imported modules
                    var mi: i64 = 0;
                    while mi < imported_modules.len() {
                        program = merge_programs(program, imported_modules.get(mi));
                        mi = mi + 1;
                    }

                    // Merge user (highest priority)
                    program = merge_programs(program, user);

                    // Phase 7.7: Conditional compilation filter
                    apply_cfg_filter(&mut program);

                    // Phase 7.7: Process @derive annotations
                    process_derive(&mut program);

                    // R1.2: structural `==` for enums (the lowerer calls `__eq_<Enum>`).
                    synthesize_enum_eq(&mut program);

                    // Desugar layer/model declarations
                    desugar_layers_models(&mut program);
                    desugar_phase8b(&mut program);

                    // Comptime: process gen blocks (before typechecking so generated code is visible)
                    program = process_gen(program);

                    // Phase 3B.1: Fill in default trait methods
                    fill_default_trait_methods(&mut program);

                    p_eprint_str("[build] Type checking...\n");
                    var t_tc: i64 = p_clock_now_ms();
                    // Type check -- register each module with its own name
                    var tc: TypeChecker = TypeChecker::new();
                    var stdlib_module: str = "core";
                    match stdlib.module {
                        OptStr::Some(m) => { stdlib_module = m; }
                        OptStr::None => { }
                    }
                    TypeChecker_register_program(&mut tc, stdlib, stdlib_module);

                    // Register imported modules
                    var mi2: i64 = 0;
                    while mi2 < imported_modules.len() {
                        TypeChecker_register_program(&mut tc, imported_modules.get(mi2), imported_module_names.get(mi2));
                        mi2 = mi2 + 1;
                    }

                    var user_module: str = "main";
                    match user.module {
                        OptStr::Some(m2) => { user_module = m2; }
                        OptStr::None => { }
                    }
                    TypeChecker_register_program(&mut tc, user, user_module);

                    TypeChecker_register_trait_impls(&mut tc, program);
                    TypeChecker_register_generated_decls(&mut tc, program);
                    TypeChecker_verify_trait_impls(&mut tc, program);
                    TypeChecker_collect_capabilities(&mut tc, user);
                    TypeChecker_check_bodies(&mut tc, program);

                    if tc.errors.len() > 0 {
                        p_eprint_str("[build] FAILED: type errors\n");
                        var file3: str = "<stdin>";
                        match source_path {
                            OptStr::Some(p3) => { file3 = p3; }
                            OptStr::None => { }
                        }
                        return ResultProgram::Err(enrich_errors(tc.errors, source, file3));
                    }
                    // References are second-class: none may outlive what it points to.
                    var escape_errors: Vec<str> = escape_check(program);
                    if escape_errors.len() > 0 {
                        p_eprint_str("[build] FAILED: reference errors\n");
                        var file5: str = "<stdin>";
                        match source_path {
                            OptStr::Some(p5) => { file5 = p5; }
                            OptStr::None => { }
                        }
                        return ResultProgram::Err(enrich_errors(escape_errors, source, file5));
                    }
                    var secret_errors: Vec<str> = secrecy_check(program);
                    if secret_errors.len() > 0 {
                        p_eprint_str("[build] FAILED: @secret errors\n");
                        var file8: str = "<stdin>";
                        match source_path {
                            OptStr::Some(p8) => { file8 = p8; }
                            OptStr::None => { }
                        }
                        return ResultProgram::Err(enrich_errors(secret_errors, source, file8));
                    }
                    p_eprint_str("[build] Type check ok.\n");
                    var t_bc: i64 = p_clock_now_ms();
                    p_eprint_str("[prof] typecheck: ");
                    p_eprint_str(int_to_str(t_bc - t_tc));
                    p_eprint_str("ms\n");

                    // Run lints (warnings only)
                    tc.run_lints(program);
                    // G8.7: Stash warnings for lint_source to read
                    g_lint_warnings = tc.warnings;

                    // G8.2: Borrow check — mode controlled by borrowck_mode parameter.
                    //   "off"  : skip borrow checking entirely
                    //   "warn" : report errors as warnings, don't fail
                    //   "on"  : report errors and fail compilation (default)
                    if borrowck_mode != "off" {
                        p_eprint_str("[build] Borrow checking (mode=");
                        p_eprint_str(borrowck_mode);
                        p_eprint_str(")...\n");
                        var bc_mode: BorrowckMode = BorrowckMode::On;
                        if borrowck_mode == "warn" {
                            bc_mode = BorrowckMode::Warn;
                        }
                        var bc: BorrowChecker = BorrowChecker_new(bc_mode);
                        check(&mut bc, program);
                        if bc.errors.len() > 0 {
                            var file4: str = "<stdin>";
                            match source_path {
                                OptStr::Some(p4) => { file4 = p4; }
                                OptStr::None => { }
                            }
                            if borrowck_mode == "warn" {
                                // Report as warnings, don't fail
                                var ei: i64 = 0;
                                while ei < bc.errors.len() {
                                    p_eprint_str("warning: ");
                                    p_eprint_str(bc.errors.get(ei));
                                    p_eprint_str("\n");
                                    ei = ei + 1;
                                }
                            } else {
                                return ResultProgram::Err(enrich_errors(bc.errors, source, file4));
                            }
                        }
                    } else {
                        p_eprint_str("[build] Borrow checking skipped (mode=off).\n");
                    }

                    // Comptime: substitute comptime expressions with their values
                    program = substitute(program);

                    p_eprint_str("[build] Monomorphizing...\n");
                    var t_mono: i64 = p_clock_now_ms();
                    p_eprint_str("[prof] borrowck: ");
                    p_eprint_str(int_to_str(t_mono - t_bc));
                    p_eprint_str("ms\n");
                    // Monomorphize generics
                    var mono_result: Program = monomorphize(program);
                    var t_mono_end: i64 = p_clock_now_ms();
                    p_eprint_str("[prof] mono: ");
                    p_eprint_str(int_to_str(t_mono_end - t_mono));
                    p_eprint_str("ms\n");
                    p_eprint_str("[build] Done. Program built successfully.\n");
                    p_eprint_str("[prof] total build: ");
                    p_eprint_str(int_to_str(t_mono_end - t0));
                    p_eprint_str("ms\n");
                    return ResultProgram::Ok(mono_result);
                }
            }
        }
    }
    return ResultProgram::Err(c_vec1("unreachable"));
}

/// Compile source to C code.
pub fn ccompile_source_with_path(source: str, source_path: str, borrowck_mode: str) -> ResultStr {
    // Check incremental cache -- skip full pipeline if source is unchanged
    var src_hash: i64 = hash_source(source);
    match global_cache_get(source_path, src_hash) {
        OptIrModule::Some(cached_module) => {
            p_eprint_str("[ccompile] Cache HIT -- skipping parse/typecheck/lower/optimize\n");
            var t_codegen: i64 = p_clock_now_ms();
            var cg: CCodeGen = CCodeGen_new();
            var c_code: str = CCodeGen_generate(&mut cg, cached_module);
            var t_cg_end: i64 = p_clock_now_ms();
            p_eprint_str("[prof] codegen (cached): ");
            p_eprint_str(int_to_str(t_cg_end - t_codegen));
            p_eprint_str("ms\n");
            return ResultStr::Ok(c_code);
        }
        OptIrModule::None => {}
    }

    p_eprint_str("[ccompile] Building program...\n");
    var result: ResultProgram = build_program_with_path_borrowck(source, OptStr::Some(source_path), borrowck_mode);
    match result {
        ResultProgram::Err(errs) => {
            p_eprint_str("[ccompile] Building program FAILED\n");
            return ResultStr::Err(errs);
        }
        ResultProgram::Ok(program) => {
            p_eprint_str("[ccompile] Lowering to IR...\n");
            var t_lower: i64 = p_clock_now_ms();
            var module: IrModule = lower(program);
            var t_codegen: i64 = p_clock_now_ms();
            p_eprint_str("[prof] lower: ");
            p_eprint_str(int_to_str(t_codegen - t_lower));
            p_eprint_str("ms\n");
            // Note: The Rust compiler's ccompile_source_traced does NOT run
            // IrModule_optimize (DCE/const-fold) before C codegen. We match
            // that behavior to produce identical C output.
            // Store in incremental cache for future invocations
            global_cache_store(source_path, src_hash, module);
            p_eprint_str("[ccompile] Generating C code...\n");
            var cg: CCodeGen = CCodeGen_new();
            var c_code: str = CCodeGen_generate(&mut cg, module);
            var t_cg_end: i64 = p_clock_now_ms();
            p_eprint_str("[prof] codegen: ");
            p_eprint_str(int_to_str(t_cg_end - t_codegen));
            p_eprint_str("ms\n");
            p_eprint_str("[ccompile] C codegen done.\n");
            return ResultStr::Ok(c_code);
        }
    }
    return ResultStr::Err(c_vec1("unreachable"));
}

/// G8.5: Compile source to WASM binary (or WAT text if wat_mode=true).
/// Pipeline: build_program → lower → generate_wasm/dump_wat
pub fn compile_to_wasm(source: str, source_path: str, wat_mode: bool) -> ResultBytes {
    var result: ResultProgram = build_program_with_path(source, OptStr::Some(source_path));
    match result {
        ResultProgram::Err(errs) => { return ResultBytes::Err(errs); }
        ResultProgram::Ok(program) => {
            var module: IrModule = lower(program);
            if wat_mode {
                var wat_text: str = dump_wat(module);
                var bytes: Vec<i64> = Vec::new();
                var n: i64 = str_len(wat_text);
                var i: i64 = 0;
                while i < n {
                    bytes.push(str_byte_at(wat_text, i));
                    i = i + 1;
                }
                return ResultBytes::Ok(bytes);
            } else {
                var wasm_bytes: Vec<i64> = generate_wasm(module);
                return ResultBytes::Ok(wasm_bytes);
            }
        }
    }
    return ResultBytes::Err(c_vec1("unreachable"));
}

/// G8.7: Lint a source file. Returns warnings as a vector of strings.
/// Returns Err with errors if compilation fails.
pub fn lint_source(source: str, source_path: str) -> ResultVecStr {
    // G8.7: Lint a source file. Returns warnings as a vector of strings.
    // We do a minimal parse + typecheck + lint, without monomorphization.
    g_lint_warnings = Vec::new();

    // Parse user code
    var user_result: ParseResultProgram = parse_source(source);
    match user_result {
        ParseResultProgram::Err(e) => { return ResultVecStr::Err(c_vec1(e)); }
        ParseResultProgram::Ok(user) => {
            // Load stdlib
            var stdlib_opt: OptProgram = get_cached_stdlib();
            match stdlib_opt {
                OptProgram::None => {
                    return ResultVecStr::Err(c_vec1("Stdlib not found: stdlib/core.fd (CWD must be project root)"));
                }
                OptProgram::Some(stdlib) => {
                    var user_module: str = "main";
                    match user.module {
                        OptStr::Some(m) => { user_module = m; }
                        OptStr::None => { }
                    }
                    var stdlib_module: str = "core";
                    match stdlib.module {
                        OptStr::Some(m2) => { stdlib_module = m2; }
                        OptStr::None => { }
                    }

                    // Build a merged program (simplified — no import resolution)
                    var program: Program = stdlib;
                    program = merge_programs(program, user);

                    var tc: TypeChecker = TypeChecker::new();
                    TypeChecker_register_program(&mut tc, stdlib, stdlib_module);
                    TypeChecker_register_program(&mut tc, user, user_module);
                    TypeChecker_register_trait_impls(&mut tc, program);
                    TypeChecker_register_generated_decls(&mut tc, program);
                    TypeChecker_verify_trait_impls(&mut tc, program);
                    TypeChecker_collect_capabilities(&mut tc, user);
                    TypeChecker_check_bodies(&mut tc, program);

                    if tc.errors.len() > 0 {
                        var file: str = source_path;
                        return ResultVecStr::Err(enrich_errors(tc.errors, source, file));
                    }
                    var escape_errors: Vec<str> = escape_check(program);
                    if escape_errors.len() > 0 {
                        return ResultVecStr::Err(enrich_errors(escape_errors, source, source_path));
                    }
                    var secret_errors: Vec<str> = secrecy_check(program);
                    if secret_errors.len() > 0 {
                        return ResultVecStr::Err(enrich_errors(secret_errors, source, source_path));
                    }

                    // Run lints
                    tc.run_lints(program);
                    return ResultVecStr::Ok(tc.warnings);
                }
            }
        }
    }
    return ResultVecStr::Err(c_vec1("unreachable"));
}

/// Lower source to an IR module.
pub fn lower_to_ir_module(source: str) -> ResultIrModule {
    var result: ResultProgram = build_program(source);
    match result {
        ResultProgram::Err(errs) => { return ResultIrModule::Err(errs); }
        ResultProgram::Ok(program) => {
            var module: IrModule = lower(program);
            return ResultIrModule::Ok(module);
        }
    }
    return ResultIrModule::Err(c_vec1("unreachable"));
}

/// G8.3: Lower source to IR with source path (for import resolution).
pub fn lower_to_ir_module_with_path(source: str, source_path: str, borrowck_mode: str) -> ResultIrModule {
    var result: ResultProgram = build_program_with_path_borrowck(source, OptStr::Some(source_path), borrowck_mode);
    match result {
        ResultProgram::Err(errs) => { return ResultIrModule::Err(errs); }
        ResultProgram::Ok(program) => {
            var module: IrModule = lower(program);
            return ResultIrModule::Ok(module);
        }
    }
    return ResultIrModule::Err(c_vec1("unreachable"));
}

/// Interpret a source file by lowering to IR and executing via the
/// self-hosted interpreter. Returns exit code (0 = success, 1 = error).
pub fn interpret_source(source: str) -> i64 {
    var result: ResultIrModule = lower_to_ir_module(source);
    match result {
        ResultIrModule::Err(errs) => {
            var msg: str = "Compilation error:\n";
            var i: i64 = 0;
            while i < errs.len() {
                msg = msg + errs.get(i) + "\n";
                i = i + 1;
            }
            p_eprint_str(msg);
            return 1;
        }
        ResultIrModule::Ok(ir_mod) => {
            return interpret_ir_module(ir_mod);
        }
    }
    return 1;
}

/// Interpret a source file with execution limits and verbose flag.
/// Returns exit code (0 = success, 1 = error).
pub fn interpret_source_with_options(source: str, max_recursion: i64, max_steps: i64, max_memory: i64, verbose: bool) -> i64 {
    var result: ResultIrModule = lower_to_ir_module(source);
    match result {
        ResultIrModule::Err(errs) => {
            var msg: str = "Compilation error:\n";
            var i: i64 = 0;
            while i < errs.len() {
                msg = msg + errs.get(i) + "\n";
                i = i + 1;
            }
            p_eprint_str(msg);
            return 1;
        }
        ResultIrModule::Ok(ir_mod2) => {
            return interpret_ir_module_with_options(ir_mod2, max_recursion, max_steps, max_memory, verbose);
        }
    }
    return 1;
}

/// G8.3: Interpret a source file with source path (for import resolution).
pub fn interpret_source_with_path(source: str, source_path: str, max_recursion: i64, max_steps: i64, max_memory: i64, verbose: bool, borrowck_mode: str) -> i64 {
    var result: ResultIrModule = lower_to_ir_module_with_path(source, source_path, borrowck_mode);
    match result {
        ResultIrModule::Err(errs) => {
            var msg: str = "Compilation error:\n";
            var i: i64 = 0;
            while i < errs.len() {
                msg = msg + errs.get(i) + "\n";
                i = i + 1;
            }
            p_eprint_str(msg);
            return 1;
        }
        ResultIrModule::Ok(ir_mod2) => {
            return interpret_ir_module_with_options(ir_mod2, max_recursion, max_steps, max_memory, verbose);
        }
    }
    return 1;
}

/// Build a native executable from source.
/// Dispatches to the appropriate backend based on target:
///   x86-64 / x64       -> codegen_x64 + elf64 + runtime_linux + linker
///   arm64 / aarch64    -> codegen_arm64 + arm64_enc + runtime_arm64 + linker
///   riscv / riscv64    -> codegen_riscv + riscv_enc + runtime_riscv + linker
///   windows / x64-win  -> pe::generate_pe
///   wasm               -> (future)
/// Convert a capability name list to the runtime bitfield:
///   bit0 = FS (also covers IO), bit1 = Net, bit2 = Spawn.
fn caps_to_bits(caps: Vec<str>) -> i64 {
    var bits: i64 = 0;
    var ci: i64 = 0;
    while ci < caps.len() {
        var c: str = caps.get(ci);
        if c == "FS" || c == "IO" { bits = bits | 1; }
        if c == "Net" { bits = bits | 2; }
        if c == "Spawn" { bits = bits | 4; }
        ci = ci + 1;
    }
    return bits;
}

pub fn build_executable(source: str, source_path: str, target: str, do_opt: bool, do_lto: bool, granted_caps: Vec<str>) -> ResultBytes {
    // The direct IR -> PE backend needs the pe_runtime sources merged into
    // the program (pert_* Fides runtime functions)
    if target == "x86-64-windows" || target == "x64-windows" || target == "windows" {
        set_pe_runtime_merge(true);
    }
    // Parse + lower to IR
    var prog_result: ResultProgram = build_program_with_path(source, OptStr::Some(source_path));
    match prog_result {
        ResultProgram::Err(errs) => { return ResultBytes::Err(errs); }
        ResultProgram::Ok(program) => {
            var module: IrModule = lower(program);

            // F5: Capability-aware linking — strip functions requiring ungranted capabilities
            if granted_caps.len() > 0 {
                strip_ungranted_caps(&mut module, granted_caps);
            }

            // PIR pipeline: IR -> L1 -> L2 -> (optimize) -> L3
            var l1: L1Module = lower_ir_to_l1(&module);
            var l2: L2Module = lower_l1_to_l2(&l1);

            if do_lto {
                var _stats: OptStats = optimize_l2_lto(&mut l2);
            } else if do_opt {
                var _stats2: OptStats = optimize_l2(&mut l2);
            }

            var l3: L3Module = lower_l2_to_l3(&l2, &module);

            // Dispatch to backend
            if target == "x86-64" || target == "x64" {
                // Generate x86-64 assembly
                var asm: str = generate_asm(l3);
                // Run peephole optimization
                asm = peephole_optimize(asm);
                // Emit ELF64 object file
                var obj_result: ResultVec = emit_object_file(0, asm);
                if ResultVec_is_err(obj_result) {
                    return ResultBytes::Err(c_vec1(ResultVec_err_msg(obj_result)));
                }
                var obj: Vec<i64> = ResultVec_bytes(obj_result);
                // Get runtime parts — F-1B: capability-aware runtime when caps are granted
                var rt: RuntimeParts = runtime_parts();
                if granted_caps.len() > 0 {
                    rt = runtime_parts_with_caps(caps_to_bits(granted_caps));
                }
                var rt_relocs: Vec<RuntimeReloc> = runtime_relocations();
                // Link
                var objects: Vec<Vec> = Vec::new();
                objects.push(obj);
                // Convert runtime symbols to linker symbols
                var rt_syms: Vec<LinkerSymbol> = Vec::new();
                var si: i64 = 0;
                while si < rt.symbols.len() {
                    var rs: RuntimeSymbol = rt.symbols.get(si);
                    rt_syms.push(LinkerSymbol_new(rs.name, rs.offset, true));
                    si = si + 1;
                }
                // Convert runtime rodata syms to linker rodata syms
                var rt_rodata_syms: Vec<LinkerRodataSym> = Vec::new();
                var rsi: i64 = 0;
                while rsi < rt.rodata_syms.len() {
                    var rrs: RuntimeRodataSym = rt.rodata_syms.get(rsi);
                    rt_rodata_syms.push(LinkerRodataSym_new(rrs.name, rrs.offset));
                    rsi = rsi + 1;
                }
                // Convert runtime relocs to linker relocs
                var rt_linker_relocs: Vec<LinkerReloc> = Vec::new();
                var rri: i64 = 0;
                while rri < rt_relocs.len() {
                    var rr: RuntimeReloc = rt_relocs.get(rri);
                    rt_linker_relocs.push(LinkerReloc_new(rr.offset, rr.symbol, rr.rtype));
                    rri = rri + 1;
                }
                var link_result: LinkerResult = link_with_runtime(
                    objects, "_start",
                    rt.text, rt_syms,
                    rt.rodata, rt_rodata_syms,
                    rt_linker_relocs
                );
                if LinkerResult_is_ok(link_result) {
                    return ResultBytes::Ok(LinkerResult_bytes(link_result));
                }
                return ResultBytes::Err(c_vec1(LinkerResult_err_msg(link_result)));
            }
            if target == "x86-64-windows" || target == "x64-windows" || target == "windows" {
                // Windows PE — direct IR -> machine code backend (pe_ir),
                // no assembler/linker in the loop
                return pe_ir_generate_pe(module);
            }
            if target == "arm64" || target == "aarch64" {
                // ARM64: PIR L3 -> codegen_arm64 -> arm64_enc -> runtime_arm64 -> linker
                var asm_arm: str = generate_asm_arm64(l3);
                // Assemble ARM64 assembly into machine code
                var arm_obj: Vec<i64> = Vec::new();
                var arm_rodata: Vec<i64> = Vec::new();
                var arm_syms: Vec<LinkerSymbol> = Vec::new();
                var arm_rodata_syms: Vec<LinkerRodataSym> = Vec::new();
                var arm_relocs: Vec<LinkerReloc> = Vec::new();
                match assemble_arm64(asm_arm) {
                    ResultArm64Assemble::Ok(arm_result) => {
                        var oi: i64 = 0;
                        while oi < arm_result.text.len() {
                            arm_obj.push(arm_result.text.get(oi));
                            oi = oi + 1;
                        }
                        var roi: i64 = 0;
                        while roi < arm_result.rodata.len() {
                            arm_rodata.push(arm_result.rodata.get(roi));
                            roi = roi + 1;
                        }
                        var asi: i64 = 0;
                        while asi < arm_result.symbols.len() {
                            var s: Arm64Symbol = arm_result.symbols.get(asi);
                            arm_syms.push(LinkerSymbol_new(s.name, s.offset, true));
                            asi = asi + 1;
                        }
                        var rasi: i64 = 0;
                        while rasi < arm_result.rodata_symbols.len() {
                            var rs: Arm64Symbol = arm_result.rodata_symbols.get(rasi);
                            arm_rodata_syms.push(LinkerRodataSym_new(rs.name, rs.offset));
                            rasi = rasi + 1;
                        }
                        var ari: i64 = 0;
                        while ari < arm_result.relocations.len() {
                            var r: Arm64Reloc = arm_result.relocations.get(ari);
                            arm_relocs.push(LinkerReloc_new(r.offset, r.symbol, r.rtype));
                            ari = ari + 1;
                        }
                    }
                    ResultArm64Assemble::Err(e) => {
                        return ResultBytes::Err(c_vec1("ARM64 assembly error: " + e));
                    }
                }
                // Get ARM64 runtime parts — capability-aware when caps are granted
                var rt_arm: RuntimeParts = runtime_parts_arm64();
                if granted_caps.len() > 0 {
                    rt_arm = runtime_parts_with_caps_arm64(caps_to_bits(granted_caps));
                }
                var rt_arm_relocs: Vec<RuntimeReloc> = runtime_relocations_arm64();
                var rt_arm_syms: Vec<LinkerSymbol> = Vec::new();
                var si2: i64 = 0;
                while si2 < rt_arm.symbols.len() {
                    var rs2: RuntimeSymbol = rt_arm.symbols.get(si2);
                    rt_arm_syms.push(LinkerSymbol_new(rs2.name, rs2.offset, true));
                    si2 = si2 + 1;
                }
                var rt_arm_rodata_syms: Vec<LinkerRodataSym> = Vec::new();
                var rsi2: i64 = 0;
                while rsi2 < rt_arm.rodata_syms.len() {
                    var rrs2: RuntimeRodataSym = rt_arm.rodata_syms.get(rsi2);
                    rt_arm_rodata_syms.push(LinkerRodataSym_new(rrs2.name, rrs2.offset));
                    rsi2 = rsi2 + 1;
                }
                var rt_arm_linker_relocs: Vec<LinkerReloc> = Vec::new();
                var rri2: i64 = 0;
                while rri2 < rt_arm_relocs.len() {
                    var rr2: RuntimeReloc = rt_arm_relocs.get(rri2);
                    rt_arm_linker_relocs.push(LinkerReloc_new(rr2.offset, rr2.symbol, rr2.rtype));
                    rri2 = rri2 + 1;
                }
                var arm_link_result: LinkerResult = link_raw_with_runtime_for_target(
                    arm_obj, arm_syms, arm_relocs, arm_rodata, arm_rodata_syms,
                    "_start",
                    rt_arm.text, rt_arm_syms,
                    rt_arm.rodata, rt_arm_rodata_syms,
                    rt_arm_linker_relocs, "arm64"
                );
                if LinkerResult_is_ok(arm_link_result) {
                    return ResultBytes::Ok(LinkerResult_bytes(arm_link_result));
                }
                return ResultBytes::Err(c_vec1(LinkerResult_err_msg(arm_link_result)));
            }
            if target == "riscv" || target == "riscv64" {
                // RISC-V: PIR L3 -> codegen_riscv -> riscv_enc -> runtime_riscv -> linker
                var asm_rv: str = generate_asm_riscv(l3);
                var rv_obj: Vec<i64> = Vec::new();
                var rv_syms: Vec<LinkerSymbol> = Vec::new();
                var rv_relocs: Vec<LinkerReloc> = Vec::new();
                match assemble_riscv(asm_rv) {
                    ResultRiscVAssemble::Ok(rv_result) => {
                        var oi: i64 = 0;
                        while oi < rv_result.text.len() {
                            rv_obj.push(rv_result.text.get(oi));
                            oi = oi + 1;
                        }
                        var rsi3: i64 = 0;
                        while rsi3 < rv_result.symbols.len() {
                            var s: RiscVSymbol = rv_result.symbols.get(rsi3);
                            rv_syms.push(LinkerSymbol_new(s.name, s.offset, true));
                            rsi3 = rsi3 + 1;
                        }
                        var rri3: i64 = 0;
                        while rri3 < rv_result.relocations.len() {
                            var r: RiscVReloc = rv_result.relocations.get(rri3);
                            rv_relocs.push(LinkerReloc_new(r.offset, r.symbol, r.rtype));
                            rri3 = rri3 + 1;
                        }
                    }
                    ResultRiscVAssemble::Err(e) => {
                        return ResultBytes::Err(c_vec1("RISC-V assembly error: " + e));
                    }
                }
                var rt_rv: RuntimeParts = runtime_parts_riscv();
                if granted_caps.len() > 0 {
                    rt_rv = runtime_parts_with_caps_riscv(caps_to_bits(granted_caps));
                }
                var rt_rv_relocs: Vec<RuntimeReloc> = runtime_relocations_riscv();
                var rt_rv_syms: Vec<LinkerSymbol> = Vec::new();
                var si3: i64 = 0;
                while si3 < rt_rv.symbols.len() {
                    var rs3: RuntimeSymbol = rt_rv.symbols.get(si3);
                    rt_rv_syms.push(LinkerSymbol_new(rs3.name, rs3.offset, true));
                    si3 = si3 + 1;
                }
                var rt_rv_rodata_syms: Vec<LinkerRodataSym> = Vec::new();
                var rsi4: i64 = 0;
                while rsi4 < rt_rv.rodata_syms.len() {
                    var rrs4: RuntimeRodataSym = rt_rv.rodata_syms.get(rsi4);
                    rt_rv_rodata_syms.push(LinkerRodataSym_new(rrs4.name, rrs4.offset));
                    rsi4 = rsi4 + 1;
                }
                var rt_rv_linker_relocs: Vec<LinkerReloc> = Vec::new();
                var rri4: i64 = 0;
                while rri4 < rt_rv_relocs.len() {
                    var rr4: RuntimeReloc = rt_rv_relocs.get(rri4);
                    rt_rv_linker_relocs.push(LinkerReloc_new(rr4.offset, rr4.symbol, rr4.rtype));
                    rri4 = rri4 + 1;
                }
                var rv_link_result: LinkerResult = link_raw_with_runtime_for_target(
                    rv_obj, rv_syms, rv_relocs, Vec::new(), Vec::new(),
                    "_start",
                    rt_rv.text, rt_rv_syms,
                    rt_rv.rodata, rt_rv_rodata_syms,
                    rt_rv_linker_relocs, "riscv"
                );
                if LinkerResult_is_ok(rv_link_result) {
                    return ResultBytes::Ok(LinkerResult_bytes(rv_link_result));
                }
                return ResultBytes::Err(c_vec1(LinkerResult_err_msg(rv_link_result)));
            }
            // Unknown target
            return ResultBytes::Err(c_vec1("Unknown target: " + target));
        }
    }
    return ResultBytes::Err(c_vec1("unreachable"));
}

/// Build a native Linux ELF executable using the x86.rs stack-machine backend.
/// This is the simpler backend (no PIR, no register allocation) — each SSA value
/// lives on the stack. Emits AT&T assembly -> elf64 assembler -> linker with no
/// runtime (the x86 backend includes its own runtime stubs).
/// Mirrors src/compiler.rs::build_x86_linux.
pub fn build_x86_linux(source: str, source_path: str) -> ResultBytes {
    var mod_result: ResultIrModule = lower_to_ir_module_with_path(source, source_path, "on");
    match mod_result {
        ResultIrModule::Err(errs) => { return ResultBytes::Err(errs); }
        ResultIrModule::Ok(ir_mod) => {
            // Generate AT&T assembly via the x86 backend
            var asm: str = generate_asm_x86(ir_mod);

            // Assemble to ELF64 object (module param unused — assembler only reads asm text)
            var obj_result: ResultVec = emit_object_file(0, asm);
            match obj_result {
                ResultVec::Err(e) => { return ResultBytes::Err(c_vec1(e)); }
                ResultVec::Ok(obj) => {
                    // Link with an empty runtime — the x86 backend emits its own _start + stubs
                    var objects: Vec<Vec> = Vec::new();
                    objects.push(obj);
                    var empty_text: Vec = Vec::new();
                    var empty_rodata: Vec = Vec::new();
                    var empty_syms: Vec<LinkerSymbol> = Vec::new();
                    var empty_rodata_syms: Vec<LinkerRodataSym> = Vec::new();
                    var empty_relocs: Vec<LinkerReloc> = Vec::new();
                    var link_result: LinkerResult = link_with_runtime(
                        objects, "_start",
                        empty_text, empty_syms,
                        empty_rodata, empty_rodata_syms,
                        empty_relocs
                    );
                    if LinkerResult_is_ok(link_result) {
                        return ResultBytes::Ok(LinkerResult_bytes(link_result));
                    }
                    return ResultBytes::Err(c_vec1(LinkerResult_err_msg(link_result)));
                }
            }
        }
    }
    return ResultBytes::Err(c_vec1("unreachable"));
}

pub fn get_diagnostics(source: str, source_path: OptStr) -> Vec<StrTriple> {
    var result: ResultProgram = build_program_with_path(source, source_path);
    match result {
        ResultProgram::Ok(_) => { return Vec::new(); }
        ResultProgram::Err(errors) => {
            var diags: Vec<StrTriple> = Vec::new();
            var i: i64 = 0;
            while i < errors.len() {
                var st: StrTriple = parse_error_position(errors.get(i));
                diags.push(st);
                i = i + 1;
            }
            return diags;
        }
    }
    return Vec::new();
}

// ===========================================================================
// merge_programs -- merge stdlib and user programs (user wins on conflicts)
// ===========================================================================

/// Merge two programs: user definitions take priority over stdlib.
/// Report functions defined twice within one module (platform
/// alternatives selected by @cfg are filtered later and are skipped).
fn cc_find_duplicate_funcs(prog: Program, module: str, errors: Vec<str>) {
    var seen: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < prog.funcs.len() {
        var f: Func = prog.funcs.get(fi);
        var is_cfg: bool = false;
        var ai: i64 = 0;
        while ai < f.annotations.len() {
            if f.annotations.get(ai).name == "cfg" { is_cfg = true; }
            ai = ai + 1;
        }
        if !is_cfg {
            if cc_c_str_vec_contains(seen, f.name) {
                errors.push("Duplicate definition: function '" + f.name + "' is defined twice in module '" + module + "'");
            } else {
                seen.push(f.name);
            }
        }
        fi = fi + 1;
    }
}

pub fn merge_programs(stdlib: Program, user: Program) -> Program {
    // Build sets of user-defined names for conflict detection
    var user_func_names: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < user.funcs.len() {
        user_func_names.push(user.funcs.get(i).name);
        i = i + 1;
    }
    var user_struct_names: Vec<str> = Vec::new();
    i = 0;
    while i < user.structs.len() {
        user_struct_names.push(user.structs.get(i).name);
        i = i + 1;
    }
    var user_enum_names: Vec<str> = Vec::new();
    i = 0;
    while i < user.enums.len() {
        user_enum_names.push(user.enums.get(i).name);
        i = i + 1;
    }
    var user_const_names: Vec<str> = Vec::new();
    i = 0;
    while i < user.consts.len() {
        user_const_names.push(user.consts.get(i).name);
        i = i + 1;
    }
    var user_global_names: Vec<str> = Vec::new();
    i = 0;
    while i < user.globals.len() {
        user_global_names.push(user.globals.get(i).name);
        i = i + 1;
    }
    var user_alias_names: Vec<str> = Vec::new();
    i = 0;
    while i < user.type_aliases.len() {
        user_alias_names.push(user.type_aliases.get(i).name);
        i = i + 1;
    }

    // Start with user program as the base
    var merged: Program = user;

    // Add stdlib items that don't conflict with user definitions
    i = 0;
    while i < stdlib.funcs.len() {
        if !cc_c_str_vec_contains(user_func_names, stdlib.funcs.get(i).name) {
            merged.funcs.push(stdlib.funcs.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < stdlib.structs.len() {
        if !cc_c_str_vec_contains(user_struct_names, stdlib.structs.get(i).name) {
            merged.structs.push(stdlib.structs.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < stdlib.enums.len() {
        if !cc_c_str_vec_contains(user_enum_names, stdlib.enums.get(i).name) {
            merged.enums.push(stdlib.enums.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < stdlib.consts.len() {
        if !cc_c_str_vec_contains(user_const_names, stdlib.consts.get(i).name) {
            merged.consts.push(stdlib.consts.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < stdlib.globals.len() {
        if !cc_c_str_vec_contains(user_global_names, stdlib.globals.get(i).name) {
            merged.globals.push(stdlib.globals.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < stdlib.type_aliases.len() {
        if !cc_c_str_vec_contains(user_alias_names, stdlib.type_aliases.get(i).name) {
            merged.type_aliases.push(stdlib.type_aliases.get(i));
        }
        i = i + 1;
    }
    // Merge impls (skip if user has impl for same struct). The user's impl
    // names are taken first: merged.impls is user.impls, so a pushed impl
    // would otherwise hide a second impl block of the same struct.
    var user_impl_structs: Vec<str> = Vec::new();
    i = 0;
    while i < user.impls.len() {
        user_impl_structs.push(user.impls.get(i).struct_name);
        i = i + 1;
    }
    i = 0;
    while i < stdlib.impls.len() {
        if !cc_c_str_vec_contains(user_impl_structs, stdlib.impls.get(i).struct_name) {
            merged.impls.push(stdlib.impls.get(i));
        }
        i = i + 1;
    }
    // Merge traits (user wins on name conflicts)
    i = 0;
    while i < stdlib.traits.len() {
        var stdlib_trait_name: str = stdlib.traits.get(i).name;
        var has_user_trait: bool = false;
        var j2: i64 = 0;
        while j2 < user.traits.len() {
            if user.traits.get(j2).name == stdlib_trait_name {
                has_user_trait = true;
            }
            j2 = j2 + 1;
        }
        if !has_user_trait {
            merged.traits.push(stdlib.traits.get(i));
        }
        i = i + 1;
    }
    // Merge trait impls (user wins on (trait, type) conflicts)
    i = 0;
    while i < stdlib.trait_impls.len() {
        var stdlib_ti_trait: str = stdlib.trait_impls.get(i).trait_name;
        var stdlib_ti_type: str = stdlib.trait_impls.get(i).type_name;
        var has_user_ti: bool = false;
        var j3: i64 = 0;
        while j3 < user.trait_impls.len() {
            if user.trait_impls.get(j3).trait_name == stdlib_ti_trait && user.trait_impls.get(j3).type_name == stdlib_ti_type {
                has_user_ti = true;
            }
            j3 = j3 + 1;
        }
        if !has_user_ti {
            merged.trait_impls.push(stdlib.trait_impls.get(i));
        }
        i = i + 1;
    }
    // Merge extern_decls (user wins on conflicts by pledge_name)
    i = 0;
    while i < stdlib.extern_decls.len() {
        var stdlib_ext_name: str = stdlib.extern_decls.get(i).pledge_name;
        var has_user_ext: bool = false;
        var j4: i64 = 0;
        while j4 < user.extern_decls.len() {
            if user.extern_decls.get(j4).pledge_name == stdlib_ext_name {
                has_user_ext = true;
            }
            j4 = j4 + 1;
        }
        if !has_user_ext {
            merged.extern_decls.push(stdlib.extern_decls.get(i));
        }
        i = i + 1;
    }

    return merged;
}

// ===========================================================================
// apply_cfg_filter -- conditional compilation (simplified: always include)
// ===========================================================================

/// Apply conditional compilation filtering -- remove items with @cfg annotations
/// that don't match the current platform/features.
/// NO-OP: The self-hosted compiler includes all items. @cfg filtering is only
/// needed for cross-compilation, which the self-hosted compiler doesn't do yet.
/// This was previously a no-op-free rebuild of Vec<Func>/Vec<StructDef> which
/// crashed due to the Vec-of-struct push problem (only 8 bytes copied per
/// struct). Skipping it entirely avoids that crash and is correct for bootstrap.
pub fn apply_cfg_filter(program: &mut Program) {
    // No-op -- include all items.
}

/// Check if an item's @cfg annotations match the current platform.
fn check_cfg(annotations: Vec<Annotation>, is_linux: bool, is_debug: bool) -> bool {
    var i: i64 = 0;
    while i < annotations.len() {
        if annotations.get(i).name == "cfg" {
            var args: Vec<str> = annotations.get(i).args;
            var j: i64 = 0;
            while j < args.len() {
                var arg: str = str_trim(args.get(j));
                // Parse key=value pairs
                var eq_pos: i64 = str_find(arg, "=");
                if eq_pos >= 0 {
                    var key: str = str_trim(c_str_substr(arg, 0, eq_pos));
                    var val: str = c_str_trim_quotes(str_trim(c_str_substr(arg, eq_pos + 1, str_len(arg))));
                    var include: bool = true;
                    if key == "platform" || key == "os" {
                        if val == "linux" { include = is_linux; }
                        else { include = false; }
                    }
                    if key == "feature" { include = true; }
                    if key == "backend" || key == "target" { include = true; }
                    if !include { return false; }
                } else {
                    // Bare flags
                    var include2: bool = true;
                    if arg == "debug" { include2 = is_debug; }
                    if arg == "release" { include2 = !is_debug; }
                    if arg == "linux" { include2 = is_linux; }
                    if !include2 { return false; }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return true;
}

// ===========================================================================
// process_derive -- generate methods from @derive annotations
// ===========================================================================

/// Process @derive annotations -- generate methods based on the derive list.
/// Supported derives: Debug, Clone, Serialize, Default, Deserialize, PartialEq
// R1.2: `==` / `!=` on enum values compare tag and payload. For every
// non-generic enum, synthesize `__eq_<Enum>(__eq_a, __eq_b) -> bool` (a match
// on both values; payload fields compared with `==`, so strings compare by
// content and nested enums recursively), and the lowerer turns `==` on enum
// operands into a call. Mirrors synthesize_enum_eq in src/compiler.rs.
fn enum_eq_pattern(enum_name: str, variant: str, prefix: str, n: i64) -> Pattern {
    var binds: Vec<Binding> = Vec::new();
    var i: i64 = 0;
    while i < n {
        binds.push(Binding_new(prefix + int_to_str(i), ""));
        i = i + 1;
    }
    return Pattern::EnumVariant(enum_name, variant, binds);
}

pub fn synthesize_enum_eq(program: &mut Program) {
    var generated: Vec<Func> = Vec::new();
    var ei: i64 = 0;
    while ei < program.enums.len() {
        var e: EnumDef = program.enums.get(ei);
        ei = ei + 1;
        if e.type_params.len() > 0 { continue; }
        var fname: str = "__eq_" + e.name;
        var exists: bool = false;
        var fi: i64 = 0;
        while fi < program.funcs.len() {
            if program.funcs.get(fi).name == fname { exists = true; }
            fi = fi + 1;
        }
        if exists { continue; }

        var arms: Vec<MatchArm> = Vec::new();
        var vi: i64 = 0;
        while vi < e.variants.len() {
            var v: EnumVariant = e.variants.get(vi);
            var n: i64 = 0;
            match v.data {
                OptParams::Some(ps) => { n = ps.len(); }
                OptParams::None => {}
            }
            var same: Expr = Expr::BoolLit(true);
            var i: i64 = 0;
            while i < n {
                var field_eq: Expr = Expr::Binary(BinOp::Eq, Box::new(Expr::Ident("__a" + int_to_str(i))), Box::new(Expr::Ident("__b" + int_to_str(i))));
                if i == 0 {
                    same = field_eq;
                } else {
                    same = Expr::Binary(BinOp::And, Box::new(same), Box::new(field_eq));
                }
                i = i + 1;
            }
            var same_body: Vec<Stmt> = Vec::new();
            same_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(same)), 0));
            var differ_body: Vec<Stmt> = Vec::new();
            differ_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::BoolLit(false))), 0));
            var inner_arms: Vec<MatchArm> = Vec::new();
            inner_arms.push(MatchArm_new(enum_eq_pattern(e.name, v.name, "__b", n), OptBoxExpr::None, same_body));
            inner_arms.push(MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, differ_body));
            var outer_body: Vec<Stmt> = Vec::new();
            outer_body.push(Stmt::Match(Expr::Ident("__eq_b"), inner_arms, 0));
            arms.push(MatchArm_new(enum_eq_pattern(e.name, v.name, "__a", n), OptBoxExpr::None, outer_body));
            vi = vi + 1;
        }
        var params: Vec<Param> = Vec::new();
        params.push(Param_new("__eq_a", Type::Named(e.name), false));
        params.push(Param_new("__eq_b", Type::Named(e.name), false));
        var body: Vec<Stmt> = Vec::new();
        body.push(Stmt::Match(Expr::Ident("__eq_a"), arms, 0));
        body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::BoolLit(false))), 0));
        generated.push(Func_new_full(fname, params, Type::Bool, body, true));
    }
    var gi: i64 = 0;
    while gi < generated.len() {
        program.funcs.push(generated.get(gi));
        gi = gi + 1;
    }
}

pub fn process_derive(program: &mut Program) {
    var generated: Vec<Func> = Vec::new();

    var i: i64 = 0;
    while i < program.structs.len() {
        var s: StructDef = program.structs.get(i);
        var j: i64 = 0;
        while j < s.annotations.len() {
            if s.annotations.get(j).name == "derive" {
                var args: Vec<str> = s.annotations.get(j).args;
                var k: i64 = 0;
                while k < args.len() {
                    var arg: str = str_trim(args.get(k));

                    if arg == "Debug" {
                        var func_name: str = str_concat(s.name, "_debug_str");
                        var field_list: str = "";
                        var f: i64 = 0;
                        while f < s.fields.len() {
                            if f > 0 { field_list = str_concat(field_list, ", "); }
                            field_list = str_concat(field_list, s.fields.get(f).name);
                            field_list = str_concat(field_list, ": ?");
                            f = f + 1;
                        }
                        var debug_str: str = str_concat(str_concat(s.name, "("), str_concat(field_list, ")"));
                        var params: Vec<Param> = Vec::new();
                        params.push(Param_new("self", Type::Named(s.name), false));
                        var body: Vec<Stmt> = Vec::new();
                        body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::StringLit(debug_str))), 0));
                        generated.push(Func_new_full(func_name, params, Type::Str, body, true));
                    }

                    if arg == "Clone" {
                        var func_name2: str = str_concat(s.name, "_clone");
                        var params2: Vec<Param> = Vec::new();
                        params2.push(Param_new("self", Type::Named(s.name), false));
                        var body2: Vec<Stmt> = Vec::new();
                        body2.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::Ident("self"))), 0));
                        generated.push(Func_new_full(func_name2, params2, Type::Named(s.name), body2, true));
                    }

                    if arg == "Serialize" {
                        var func_name3: str = str_concat(s.name, "_to_json");
                        var fields_json: str = "";
                        var f2: i64 = 0;
                        while f2 < s.fields.len() {
                            if f2 > 0 { fields_json = str_concat(fields_json, ","); }
                            fields_json = str_concat(fields_json, "\"");
                            fields_json = str_concat(fields_json, s.fields.get(f2).name);
                            fields_json = str_concat(fields_json, "\":0");
                            f2 = f2 + 1;
                        }
                        var json_str: str = str_concat("{", str_concat(fields_json, "}"));
                        var params3: Vec<Param> = Vec::new();
                        params3.push(Param_new("self", Type::Named(s.name), false));
                        var body3: Vec<Stmt> = Vec::new();
                        body3.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::StringLit(json_str))), 0));
                        generated.push(Func_new_full(func_name3, params3, Type::Str, body3, true));
                    }

                    if arg == "Default" {
                        var func_name4: str = str_concat(s.name, "_default");
                        var field_inits: Vec<FieldInit> = Vec::new();
                        var f3: i64 = 0;
                        while f3 < s.fields.len() {
                            field_inits.push(FieldInit_new(s.fields.get(f3).name, default_expr_for_type(s.fields.get(f3).ty)));
                            f3 = f3 + 1;
                        }
                        var body4: Vec<Stmt> = Vec::new();
                        body4.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::StructLit(s.name, field_inits, OptBoxExpr::None))), 0));
                        generated.push(Func_new_full(func_name4, Vec::new(), Type::Named(s.name), body4, true));
                    }

                    if arg == "Deserialize" {
                        var func_name5: str = str_concat(s.name, "_from_json");
                        var field_inits2: Vec<FieldInit> = Vec::new();
                        var f4: i64 = 0;
                        while f4 < s.fields.len() {
                            field_inits2.push(FieldInit_new(s.fields.get(f4).name, default_expr_for_type(s.fields.get(f4).ty)));
                            f4 = f4 + 1;
                        }
                        var params5: Vec<Param> = Vec::new();
                        params5.push(Param_new("json", Type::Str, false));
                        var body5: Vec<Stmt> = Vec::new();
                        body5.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::StructLit(s.name, field_inits2, OptBoxExpr::None))), 0));
                        generated.push(Func_new_full(func_name5, params5, Type::Named(s.name), body5, true));
                    }

                    // Eq is PartialEq plus a promise; one function serves both.
                    var eq_alias: bool = arg == "Eq" && !str_vec_contains(args, "PartialEq");
                    if arg == "PartialEq" || eq_alias {
                        var func_name6: str = str_concat(s.name, "_equals");
                        var params6: Vec<Param> = Vec::new();
                        params6.push(Param_new("self", Type::Named(s.name), false));
                        params6.push(Param_new("other", Type::Named(s.name), false));
                        var body6: Vec<Stmt> = Vec::new();
                        // Build: self.f1 == other.f1 && self.f2 == other.f2 && ...
                        if s.fields.len() == 0 {
                            body6.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::BoolLit(true))), 0));
                        } else {
                            var result_expr: Expr = Expr::BoolLit(true);
                            var f5: i64 = 0;
                            while f5 < s.fields.len() {
                                var fname: str = s.fields.get(f5).name;
                                var self_access: Expr = Expr::FieldAccess(Box::new(Expr::Ident("self")), fname);
                                var other_access: Expr = Expr::FieldAccess(Box::new(Expr::Ident("other")), fname);
                                var cmp: Expr = Expr::Binary(BinOp::Eq, Box::new(self_access), Box::new(other_access));
                                if f5 == 0 {
                                    result_expr = cmp;
                                } else {
                                    result_expr = Expr::Binary(BinOp::And, Box::new(result_expr), Box::new(cmp));
                                }
                                f5 = f5 + 1;
                            }
                            body6.push(Stmt::Return(OptBoxExpr::Some(Box::new(result_expr)), 0));
                        }
                        generated.push(Func_new_full(func_name6, params6, Type::Bool, body6, true));
                    }

                    if arg == "Hash" {
                        // {name}_hash(self) -> i64: h = h * 31 + field (strings via
                        // p_str_hash, bools as 0/1). @wrapping: it never panics.
                        var params7: Vec<Param> = Vec::new();
                        params7.push(Param_new("self", Type::Named(s.name), false));
                        var body7: Vec<Stmt> = Vec::new();
                        body7.push(Stmt::Let("__h", OptType::Some(Type::I64), Expr::IntLit(17), true, false, Vec::new(), 0));
                        var f7: i64 = 0;
                        while f7 < s.fields.len() {
                            var fld: Param = s.fields.get(f7);
                            var access: Expr = Expr::FieldAccess(Box::new(Expr::Ident("self")), fld.name);
                            var part: Expr = Expr::IntLit(0);
                            var use_part: bool = true;
                            match fld.ty {
                                Type::I8 => { part = access; }
                                Type::I16 => { part = access; }
                                Type::I32 => { part = access; }
                                Type::I64 => { part = access; }
                                Type::U8 => { part = access; }
                                Type::U16 => { part = access; }
                                Type::U32 => { part = access; }
                                Type::U64 => { part = access; }
                                Type::Str => {
                                    var hargs: Vec<Expr> = Vec::new();
                                    hargs.push(access);
                                    part = Expr::Call("p_str_hash", hargs);
                                }
                                Type::Bool => { part = Expr::Cast(Box::new(access), Type::I64); }
                                _ => { use_part = false; }
                            }
                            if use_part {
                                var times: Expr = Expr::Binary(BinOp::Mul, Box::new(Expr::Ident("__h")), Box::new(Expr::IntLit(31)));
                                var mixed: Expr = Expr::Binary(BinOp::Add, Box::new(times), Box::new(part));
                                body7.push(Stmt::Assign("__h", AssignOp::Assign, mixed, 0));
                            }
                            f7 = f7 + 1;
                        }
                        body7.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::Ident("__h"))), 0));
                        var hash_fn: Func = Func_new_full(str_concat(s.name, "_hash"), params7, Type::I64, body7, true);
                        hash_fn.annotations.push(Annotation_new("wrapping", Vec::new()));
                        generated.push(hash_fn);
                    }

                    k = k + 1;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Add generated functions to program
    var g: i64 = 0;
    while g < generated.len() {
        program.funcs.push(generated.get(g));
        g = g + 1;
    }
}

/// Generate a default expression for a given type (used by @derive(Deserialize)).
pub fn default_expr_for_type(ty: Type) -> Expr {
    match ty {
        Type::I64 => { return Expr::IntLit(0); }
        Type::I32 => { return Expr::IntLit(0); }
        Type::I16 => { return Expr::IntLit(0); }
        Type::I8 => { return Expr::IntLit(0); }
        Type::U64 => { return Expr::IntLit(0); }
        Type::U32 => { return Expr::IntLit(0); }
        Type::U16 => { return Expr::IntLit(0); }
        Type::U8 => { return Expr::IntLit(0); }
        Type::F64 => { return Expr::FloatLit(0.0); }
        Type::F32 => { return Expr::FloatLit(0.0); }
        Type::Bool => { return Expr::BoolLit(false); }
        Type::Str => { return Expr::StringLit(""); }
        Type::Named(name) => {
            var inits: Vec<FieldInit> = Vec::new();
            return Expr::StructLit(name, inits, OptBoxExpr::None);
        }
    }
    return Expr::IntLit(0);
}

// ===========================================================================
// desugar_layers_models -- desugar layer/model declarations
// ===========================================================================

/// Desugar layer/model declarations into structs + impls + constructor functions.
pub fn desugar_layers_models(program: &mut Program) {
    // Desugar layers: struct + impl + constructor
    var i: i64 = 0;
    while i < program.layers.len() {
        var layer: LayerDef = program.layers.get(i);
        // Create struct
        var new_struct: StructDef = StructDef_new_full(layer.name, layer.fields, layer.is_pub, Vec::new(), Vec::new());
        program.structs.push(new_struct);
        // Create impl block with forward method
        var forward: Func = layer.forward;
        forward.is_pub = true;
        var new_impl: ImplDef = ImplDef_new_full(layer.name, Vec::new(), c_vec1_func(forward));
        program.impls.push(new_impl);
        // Create constructor: LayerName_new(fields...) -> LayerName
        var ctor_name: str = str_concat(layer.name, "_new");
        var ctor_body: Vec<Stmt> = Vec::new();
        var field_inits: Vec<FieldInit> = Vec::new();
        var f: i64 = 0;
        while f < layer.fields.len() {
            field_inits.push(FieldInit_new(layer.fields.get(f).name, Expr::Ident(layer.fields.get(f).name)));
            f = f + 1;
        }
        ctor_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::StructLit(layer.name, field_inits, OptBoxExpr::None))), 0));
        program.funcs.push(Func_new_full(ctor_name, layer.fields, Type::Named(layer.name), ctor_body, layer.is_pub));
        i = i + 1;
    }
    var empty_layers: Vec<LayerDef> = Vec::new();
    program.layers = empty_layers;

    // Desugar models: struct + impl + constructor
    i = 0;
    while i < program.models.len() {
        var model: ModelDef = program.models.get(i);
        // Create struct with layer fields
        var fields: Vec<Param> = Vec::new();
        var j: i64 = 0;
        while j < model.layers.len() {
            var layer_inst: LayerInst = model.layers.get(j);
            fields.push(Param_new(layer_inst.field, Type::Named(layer_inst.layer_type), false));
            j = j + 1;
        }
        var mstruct: StructDef = StructDef_new_full(model.name, fields, model.is_pub, Vec::new(), Vec::new());
        program.structs.push(mstruct);
        // Create impl block with forward method
        var mforward: Func = model.forward;
        mforward.is_pub = true;
        var mimpl: ImplDef = ImplDef_new_full(model.name, Vec::new(), c_vec1_func(mforward));
        program.impls.push(mimpl);
        // Create constructor: ModelName_new() -> ModelName
        var mctor_name: str = str_concat(model.name, "_new");
        var mfield_inits: Vec<FieldInit> = Vec::new();
        var j2: i64 = 0;
        while j2 < model.layers.len() {
            var li: LayerInst = model.layers.get(j2);
            var args: Vec<Expr> = Vec::new();
            var a: i64 = 0;
            while a < li.args.len() {
                var arg_str: str = li.args.get(a);
                var parsed: i64 = str_parse_int(arg_str);
                if parsed > 0 || arg_str == "0" {
                    args.push(Expr::IntLit(parsed));
                } else {
                    args.push(Expr::Ident(arg_str));
                }
                a = a + 1;
            }
            var layer_ctor: str = str_concat(li.layer_type, "_new");
            mfield_inits.push(FieldInit_new(li.field, Expr::Call(layer_ctor, args)));
            j2 = j2 + 1;
        }
        var mctor_body: Vec<Stmt> = Vec::new();
        mctor_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::StructLit(model.name, mfield_inits, OptBoxExpr::None))), 0));
        program.funcs.push(Func_new_full(mctor_name, Vec::new(), Type::Named(model.name), mctor_body, model.is_pub));
        i = i + 1;
    }
    var empty_models: Vec<ModelDef> = Vec::new();
    program.models = empty_models;
}

// ===========================================================================
// desugar_phase8b -- desugar components, event handlers, state machines
// ===========================================================================

/// Desugar F18 components → structs, F20 event handlers → functions,
/// F19 state machines → enum + initial/handle functions.
pub fn desugar_phase8b(program: &mut Program) {
    // F18: Desugar components → structs
    var ci: i64 = 0;
    while ci < program.components.len() {
        var comp: ComponentDef = program.components.get(ci);
        var new_struct: StructDef = StructDef_new_full(comp.name, comp.fields, comp.is_pub, Vec::new(), Vec::new());
        program.structs.push(new_struct);
        ci = ci + 1;
    }
    var empty_comps: Vec<ComponentDef> = Vec::new();
    program.components = empty_comps;

    // F20: Desugar event handlers → functions
    var ei: i64 = 0;
    while ei < program.event_handlers.len() {
        var eh: EventHandlerDef = program.event_handlers.get(ei);
        var func_name: str = str_concat("__on_", eh.event_name);
        program.funcs.push(Func_new_full(func_name, eh.params, Type::Void, eh.body, eh.is_pub));
        ei = ei + 1;
    }
    var empty_ehs: Vec<EventHandlerDef> = Vec::new();
    program.event_handlers = empty_ehs;

    // F19: Desugar state machines → enum + initial/handle functions
    var si: i64 = 0;
    while si < program.state_machines.len() {
        var sm: StateMachineDef = program.state_machines.get(si);
        var sm_name: str = sm.name;

        // Create enum with one variant per state (no data)
        var variants: Vec<EnumVariant> = Vec::new();
        var sti: i64 = 0;
        while sti < sm.states.len() {
            var state: StateDef = sm.states.get(sti);
            variants.push(EnumVariant_new(state.name, OptParams::None));
            sti = sti + 1;
        }
        program.enums.push(EnumDef_new(sm_name, variants, sm.is_pub));

        // Create <SM>_initial() function — returns first state
        var first_state: str = "Error";
        if sm.states.len() > 0 {
            first_state = sm.states.get(0).name;
        }
        var initial_name: str = str_concat(sm_name, "_initial");
        var initial_body: Vec<Stmt> = Vec::new();
        var initial_args: Vec<Expr> = Vec::new();
        initial_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::EnumLit(sm_name, first_state, initial_args))), 0));
        program.funcs.push(Func_new_full(initial_name, Vec::new(), Type::Named(sm_name), initial_body, sm.is_pub));

        // Create <SM>_handle(state, event) -> state function
        var handle_name: str = str_concat(sm_name, "_handle");
        var arms: Vec<MatchArm> = Vec::new();
        var si2: i64 = 0;
        while si2 < sm.states.len() {
            var state: StateDef = sm.states.get(si2);
            // Pattern: StateName
            var pattern: Pattern = Pattern::EnumVariant(sm_name, state.name, Vec::new());
            // Body: match on event string
            var event_arms: Vec<MatchArm> = Vec::new();
            var ti: i64 = 0;
            while ti < state.transitions.len() {
                var trans: StateTransition = state.transitions.get(ti);
                var trans_body: Vec<Stmt> = Vec::new();
                var trans_args: Vec<Expr> = Vec::new();
                trans_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::EnumLit(sm_name, trans.target, trans_args))), 0));
                event_arms.push(MatchArm_new(Pattern::StrLit(trans.event), OptBoxExpr::None, trans_body));
                ti = ti + 1;
            }
            // Default arm: return current state (no transition)
            var default_body: Vec<Stmt> = Vec::new();
            default_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::Ident("__state"))), 0));
            event_arms.push(MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, default_body));
            var inner_body: Vec<Stmt> = Vec::new();
            inner_body.push(Stmt::Match(Expr::Ident("__event_type"), event_arms, 0));
            arms.push(MatchArm_new(pattern, OptBoxExpr::None, inner_body));
            si2 = si2 + 1;
        }
        // Default arm for unknown state
        var unk_body: Vec<Stmt> = Vec::new();
        unk_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::Ident("__state"))), 0));
        arms.push(MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, unk_body));

        var handle_params: Vec<Param> = Vec::new();
        handle_params.push(Param_new("__state", Type::Named(sm_name), false));
        handle_params.push(Param_new("__event_type", Type::Str, false));
        var handle_body: Vec<Stmt> = Vec::new();
        handle_body.push(Stmt::Match(Expr::Ident("__state"), arms, 0));
        program.funcs.push(Func_new_full(handle_name, handle_params, Type::Named(sm_name), handle_body, sm.is_pub));

        si = si + 1;
    }
    var empty_sms: Vec<StateMachineDef> = Vec::new();
    program.state_machines = empty_sms;

    // F18: Desugar systems -> functions (their query statements are
    // desugared below with every other function body).
    var syi: i64 = 0;
    while syi < program.systems.len() {
        var sys: SystemDef = program.systems.get(syi);
        program.funcs.push(Func_new_full(sys.name, sys.params, Type::Void, sys.body, sys.is_pub));
        syi = syi + 1;
    }
    var empty_systems: Vec<SystemDef> = Vec::new();
    program.systems = empty_systems;

    // F18: Desugar query statements -> loops over entities.
    var qfi: i64 = 0;
    while qfi < program.funcs.len() {
        var qf: Func = program.funcs.get(qfi);
        if stmts_have_query(qf.body) {
            qf.body = desugar_query_stmts(qf.body);
            program.funcs.set(qfi, qf);
        }
        qfi = qfi + 1;
    }
    var qii: i64 = 0;
    while qii < program.impls.len() {
        var qimp: ImplDef = program.impls.get(qii);
        var changed: bool = false;
        var qmi: i64 = 0;
        while qmi < qimp.methods.len() {
            var qm: Func = qimp.methods.get(qmi);
            if stmts_have_query(qm.body) {
                qm.body = desugar_query_stmts(qm.body);
                qimp.methods.set(qmi, qm);
                changed = true;
            }
            qmi = qmi + 1;
        }
        if changed { program.impls.set(qii, qimp); }
        qii = qii + 1;
    }
}

/// Whether any statement (at any depth) is a `query`.
fn stmts_have_query(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Query(_, _, _) => { return true; }
            Stmt::If(_, tb, eb, _) => {
                if stmts_have_query(tb) { return true; }
                match eb {
                    OptStmts::Some(e) => { if stmts_have_query(e) { return true; } }
                    OptStmts::None => {}
                }
            }
            Stmt::While(_, b, _) => { if stmts_have_query(b) { return true; } }
            Stmt::For(_, _, b, _) => { if stmts_have_query(b) { return true; } }
            Stmt::Loop(b, _) => { if stmts_have_query(b) { return true; } }
            Stmt::Defer(b, _) => { if stmts_have_query(b) { return true; } }
            Stmt::Match(_, arms, _) => {
                var ai: i64 = 0;
                while ai < arms.len() {
                    if stmts_have_query(arms.get(ai).body) { return true; }
                    ai = ai + 1;
                }
            }
            Stmt::Handle(b, hs, _) => {
                if stmts_have_query(b) { return true; }
                var hi: i64 = 0;
                while hi < hs.len() {
                    if stmts_have_query(hs.get(hi).body) { return true; }
                    hi = hi + 1;
                }
            }
            Stmt::RegionBlock(_, _, _, _, _, b, _) => { if stmts_have_query(b) { return true; } }
            Stmt::Sandbox(b, _) => { if stmts_have_query(b) { return true; } }
            Stmt::Unsafe(b, _) => { if stmts_have_query(b) { return true; } }
            Stmt::Txn(b, _) => { if stmts_have_query(b) { return true; } }
            Stmt::ComptimeGen(b, _) => { if stmts_have_query(b) { return true; } }
            Stmt::GradBlock(_, b, _) => { if stmts_have_query(b) { return true; } }
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

/// `query (A, B) { body }` -> `for entity in 0..__ecs_entity_count() {
/// if __ecs_has("A", entity) != 0 && __ecs_has("B", entity) != 0 { body } }`
/// (src/compiler.rs desugar_query_stmts), recursively.
fn desugar_query_stmts(stmts: Vec<Stmt>) -> Vec<Stmt> {
    var out: Vec<Stmt> = Vec::new();
    var i: i64 = 0;
    while i < stmts.len() {
        var st: Stmt = stmts.get(i);
        match st {
            Stmt::Query(components, body, _) => {
                var qbody: Vec<Stmt> = desugar_query_stmts(body);
                var cond: Expr = Expr::BoolLit(true);
                var has_cond: bool = false;
                var ci: i64 = 0;
                while ci < components.len() {
                    var has_args: Vec<Expr> = Vec::new();
                    has_args.push(Expr::StringLit(components.get(ci)));
                    has_args.push(Expr::Ident("entity"));
                    var check: Expr = Expr::Binary(BinOp::Neq, Box::new(Expr::Call("__ecs_has", has_args)), Box::new(Expr::IntLit(0)));
                    if has_cond {
                        cond = Expr::Binary(BinOp::And, Box::new(cond), Box::new(check));
                    } else {
                        cond = check;
                        has_cond = true;
                    }
                    ci = ci + 1;
                }
                var for_body: Vec<Stmt> = Vec::new();
                for_body.push(Stmt::If(cond, qbody, OptStmts::None, 0));
                var range: Expr = Expr::Range(Box::new(Expr::IntLit(0)), Box::new(Expr::Call("__ecs_entity_count", Vec::new())), false);
                out.push(Stmt::For("entity", range, for_body, 0));
            }
            Stmt::If(c, tb, eb, line) => {
                var neb: OptStmts = OptStmts::None;
                match eb {
                    OptStmts::Some(e) => { neb = OptStmts::Some(desugar_query_stmts(e)); }
                    OptStmts::None => {}
                }
                out.push(Stmt::If(c, desugar_query_stmts(tb), neb, line));
            }
            Stmt::While(c, b, line) => { out.push(Stmt::While(c, desugar_query_stmts(b), line)); }
            Stmt::For(v, it, b, line) => { out.push(Stmt::For(v, it, desugar_query_stmts(b), line)); }
            Stmt::Loop(b, line) => { out.push(Stmt::Loop(desugar_query_stmts(b), line)); }
            Stmt::Defer(b, line) => { out.push(Stmt::Defer(desugar_query_stmts(b), line)); }
            Stmt::Match(e, arms, line) => {
                var narms: Vec<MatchArm> = Vec::new();
                var ai: i64 = 0;
                while ai < arms.len() {
                    var arm: MatchArm = arms.get(ai);
                    narms.push(MatchArm_new(arm.pattern, arm.guard, desugar_query_stmts(arm.body)));
                    ai = ai + 1;
                }
                out.push(Stmt::Match(e, narms, line));
            }
            Stmt::Handle(b, hs, line) => {
                var nhs: Vec<EffectHandler> = Vec::new();
                var hi: i64 = 0;
                while hi < hs.len() {
                    var h: EffectHandler = hs.get(hi);
                    h.body = desugar_query_stmts(h.body);
                    nhs.push(h);
                    hi = hi + 1;
                }
                out.push(Stmt::Handle(desugar_query_stmts(b), nhs, line));
            }
            Stmt::RegionBlock(n, bud, g, kv, ws, b, line) => { out.push(Stmt::RegionBlock(n, bud, g, kv, ws, desugar_query_stmts(b), line)); }
            Stmt::Sandbox(b, line) => { out.push(Stmt::Sandbox(desugar_query_stmts(b), line)); }
            Stmt::Unsafe(b, line) => { out.push(Stmt::Unsafe(desugar_query_stmts(b), line)); }
            Stmt::Txn(b, line) => { out.push(Stmt::Txn(desugar_query_stmts(b), line)); }
            Stmt::ComptimeGen(b, line) => { out.push(Stmt::ComptimeGen(desugar_query_stmts(b), line)); }
            Stmt::GradBlock(n, b, line) => { out.push(Stmt::GradBlock(n, desugar_query_stmts(b), line)); }
            _ => { out.push(st); }
        }
        i = i + 1;
    }
    return out;
}

/// Helper: create a Vec with one Func element.
fn c_vec1_func(f: Func) -> Vec<Func> {
    var v: Vec<Func> = Vec::new();
    v.push(f);
    return v;
}

// ===========================================================================
// fill_default_trait_methods -- fill in default trait method implementations
// ===========================================================================

/// Phase 3B.1: Fill in default trait methods.
/// For each trait impl, if the trait defines a method with a default body that
/// the impl doesn't override, add the default body to the impl.
pub fn fill_default_trait_methods(program: &mut Program) {
    // Build trait map: trait_name -> TraitDef
    // We can't use HashMap in Fides, so we do linear search

    var i: i64 = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        // Find the trait definition
        var trait_def: TraitDef = TraitDef_empty();
        var found_trait: bool = false;
        var j: i64 = 0;
        while j < program.traits.len() {
            if program.traits.get(j).name == ti.trait_name {
                trait_def = program.traits.get(j);
                found_trait = true;
            }
            j = j + 1;
        }
        if !found_trait {
            i = i + 1;
            continue;
        }

        // Build set of provided method names
        var provided: Vec<str> = Vec::new();
        var k: i64 = 0;
        while k < ti.methods.len() {
            provided.push(ti.methods.get(k).name);
            k = k + 1;
        }

        // For each trait method with a default body not in provided, add it
        var added: bool = false;
        var m: i64 = 0;
        while m < trait_def.methods.len() {
            var tm: TraitMethod = trait_def.methods.get(m);
            if cc_c_str_vec_contains(provided, tm.name) {
                m = m + 1;
                continue;
            }
            // Check if there's a default body
            match tm.default_body {
                OptStmts::None => { }
                OptStmts::Some(default_body) => {
                    // Build params: replace self type
                    var self_type: Type = Type::Named(ti.type_name);
                    var params: Vec<Param> = Vec::new();
                    var p: i64 = 0;
                    while p < tm.params.len() {
                        if tm.params.get(p).name == "self" {
                            params.push(Param_new("self", self_type, false));
                        } else {
                            params.push(tm.params.get(p));
                        }
                        p = p + 1;
                    }
                    // Add the method to the trait impl
                    var new_func: Func = Func_new_full(tm.name, params, tm.ret_ty, default_body, tm.is_pub);
                    ti.methods.push(new_func);
                    added = true;
                }
            }
            m = m + 1;
        }
        if added { program.trait_impls.set(i, ti); }
        i = i + 1;
    }
}

// ===========================================================================
// strip_ungranted_caps -- capability-aware dead code elimination
// ===========================================================================

/// I-3A: Transitive Capability DCE -- strip functions requiring capabilities not
/// in the granted set, then transitively eliminate all functions only reachable
/// through the stripped functions.
pub fn strip_ungranted_caps(module: &mut IrModule, granted_caps: Vec<str>) {
    // Map capability names to the effects they grant
    var granted_io: bool = cc_c_str_vec_contains(granted_caps, "IO") || cc_c_str_vec_contains(granted_caps, "FS");
    var granted_net: bool = cc_c_str_vec_contains(granted_caps, "Net");
    var granted_spawn: bool = cc_c_str_vec_contains(granted_caps, "Spawn");

    // Find functions that require effects not in the granted set.
    // Entry points (main, _start) are never stripped.
    var to_remove: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < module.function_effects.len() {
        var entry: StringEffectSetEntry = module.function_effects.get(i);
        if entry.name == "main" || entry.name == "_start" {
            i = i + 1;
            continue;
        }
        var effects: EffectSet = entry.effects;
        var j: i64 = 0;
        while j < effects.effects.len() {
            var eff: Effect = effects.effects.get(j);
            match eff {
                Effect::IO => {
                    if !granted_io {
                        if !cc_c_str_vec_contains(to_remove, entry.name) {
                            to_remove.push(entry.name);
                        }
                    }
                }
                Effect::Net => {
                    if !granted_net {
                        if !cc_c_str_vec_contains(to_remove, entry.name) {
                            to_remove.push(entry.name);
                        }
                    }
                }
                Effect::Spawn => {
                    if !granted_spawn {
                        if !cc_c_str_vec_contains(to_remove, entry.name) {
                            to_remove.push(entry.name);
                        }
                    }
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    if to_remove.len() == 0 { return; }

    // Build call graph: for each function, which functions does it call?
    var call_graph_names: Vec<StringVecStr> = Vec::new();
    var all_func_names: Vec<str> = Vec::new();
    i = 0;
    while i < module.functions.len() {
        all_func_names.push(module.functions.get(i).name);
        var callees: Vec<str> = Vec::new();
        var func: IrFunction = module.functions.get(i).func;
        var j2: i64 = 0;
        while j2 < func.insts.len() {
            var inst: Inst = func.insts.get(j2).inst;
            match inst {
                Inst::Call(callee, _, _, _) => {
                    callees.push(callee);
                }
                Inst::ConstStr(value) => {
                    if cc_c_str_vec_contains(all_func_names, value) {
                        callees.push(value);
                    }
                }
                Inst::ConstFnRef(name) => {
                    if cc_c_str_vec_contains(all_func_names, name) {
                        callees.push(name);
                    }
                }
            }
            j2 = j2 + 1;
        }
        call_graph_names.push(StringVecStr_new(module.functions.get(i).name, callees));
        i = i + 1;
    }

    // BFS from all entry points to find reachable functions
    var reachable: Vec<str> = Vec::new();
    var queue: Vec<str> = Vec::new();

    // Start from all entry points
    if cc_c_str_vec_contains(all_func_names, "main") && !cc_c_str_vec_contains(to_remove, "main") {
        queue.push("main");
    }
    if cc_c_str_vec_contains(all_func_names, "_start") && !cc_c_str_vec_contains(to_remove, "_start") {
        queue.push("_start");
    }

    while queue.len() > 0 {
        var name: str = queue.get(0);
        queue = c_vec_remove_first(queue);
        if cc_c_str_vec_contains(reachable, name) || cc_c_str_vec_contains(to_remove, name) {
            continue;
        }
        reachable.push(name);
        // Find callees of this function
        var callees2: Vec<str> = Vec::new();
        var k2: i64 = 0;
        while k2 < call_graph_names.len() {
            if call_graph_names.get(k2).name == name {
                callees2 = call_graph_names.get(k2).items;
            }
            k2 = k2 + 1;
        }
        var c2: i64 = 0;
        while c2 < callees2.len() {
            if !cc_c_str_vec_contains(reachable, callees2.get(c2)) {
                queue.push(callees2.get(c2));
            }
            c2 = c2 + 1;
        }
    }

    // Remove unreachable functions
    var new_functions: Vec<IrFunctionEntry> = Vec::new();
    var new_function_effects: Vec<StringEffectSetEntry> = Vec::new();
    i = 0;
    while i < module.functions.len() {
        if cc_c_str_vec_contains(reachable, module.functions.get(i).name) {
            new_functions.push(module.functions.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < module.function_effects.len() {
        if cc_c_str_vec_contains(reachable, module.function_effects.get(i).name) {
            new_function_effects.push(module.function_effects.get(i));
        }
        i = i + 1;
    }
    module.functions = new_functions;
    module.function_effects = new_function_effects;
}

/// Helper: remove the first element from a Vec and return the rest.
fn c_vec_remove_first(v: Vec<str>) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var i: i64 = 1;
    while i < v.len() {
        result.push(v.get(i));
        i = i + 1;
    }
    return result;
}

// ===========================================================================
// String helpers (only functions NOT in core.fd)
// ===========================================================================

/// Concatenate three strings.
pub fn c_str_concat3(a: str, b: str, c: str) -> str {
    return str_concat(str_concat(a, b), c);
}

/// Split a string by a delimiter, returning at most n parts.
pub fn c_str_split_n(s: str, delim: str, n: i64) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var remaining: str = s;
    var count: i64 = 1;

    while count < n {
        var idx: i64 = str_find(remaining, delim);
        if idx < 0 { break; }
        result.push(c_str_substr(remaining, 0, idx));
        remaining = c_str_substr(remaining, idx + str_len(delim), str_len(remaining));
        count = count + 1;
    }
    result.push(remaining);
    return result;
}

/// Split a string into lines.
pub fn c_str_lines(s: str) -> Vec<str> {
    var lines: Vec<str> = str_split(s, "\n");
    var result: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < lines.len() {
        var line: str = lines.get(i);
        // Strip trailing \r (Windows CRLF line endings)
        if str_len(line) > 0 {
            var last: str = str_slice(line, str_len(line) - 1, str_len(line));
            if last == "\r" {
                line = str_slice(line, 0, str_len(line) - 1);
            }
        }
        // Every line is kept, empty ones too: callers index the result
        // by line number (enrich_errors).
        result.push(line);
        i = i + 1;
    }
    return result;
}

/// Get a substring from start (inclusive) to end (exclusive).
pub fn c_str_substr(s: str, start: i64, end: i64) -> str {
    if start < 0 { start = 0; }
    if end > str_len(s) { end = str_len(s); }
    if start >= end { return ""; }
    return str_slice(s, start, end);
}

/// Parse an i64 from a string. Returns 0 on failure.
pub fn c_str_parse_i64(s: str) -> i64 {
    return str_parse_int(s);
}

/// Trim surrounding quotes from a string.
pub fn c_str_trim_quotes(s: str) -> str {
    if str_len(s) >= 2 {
        var first: str = str_slice(s, 0, 1);
        var last: str = str_slice(s, str_len(s) - 1, str_len(s));
        if (first == "\"" && last == "\"") || (first == "'" && last == "'") {
            return c_str_substr(s, 1, str_len(s) - 1);
        }
    }
    return s;
}

/// Check if a Vec<str> contains a string.
fn cc_is_cfg(f: Func) -> bool {
    var i: i64 = 0;
    while i < f.annotations.len() {
        if f.annotations.get(i).name == "cfg" { return true; }
        i = i + 1;
    }
    return false;
}

/// `funcs` with names and calls rewritten through `renames`.
fn cc_rename_funcs(funcs: Vec<Func>, renames: Vec<RenameEntry>, rename_defs: bool) {
    var empty_subst: Vec<SubstEntry> = subst_new();
    var no_methods: Vec<RenameEntry> = rename_new();
    var fi: i64 = 0;
    while fi < funcs.len() {
        var f: Func = funcs.get(fi);
        if rename_defs && !cc_is_cfg(f) {
            match rename_get(renames, f.name) {
                OptStr::Some(q) => { f.name = q; }
                OptStr::None => {}
            }
        }
        var body: Vec<Stmt> = Vec::new();
        var si: i64 = 0;
        while si < f.body.len() {
            body.push(subst_stmt(f.body.get(si), empty_subst, renames, no_methods));
            si = si + 1;
        }
        f.body = body;
        funcs.set(fi, f);
        fi = fi + 1;
    }
}

/// The user's program may define a function whose name an imported module
/// also defines. The imported copy is renamed `module__name`, and calls inside
/// the imported modules follow it: they cannot see the user's definitions,
/// so every caller keeps the function it was written against. A name that
/// two imported modules define is left alone.
fn cc_qualify_shadowed_imports(imported: Vec<Program>, names: Vec<str>, user: Program) {
    // name -> 1 + index of the one module defining it, or -1 for several
    var definer: i64 = HashMap_new();
    var mi: i64 = 0;
    while mi < imported.len() {
        var fs: Vec<Func> = imported.get(mi).funcs;
        var fi: i64 = 0;
        while fi < fs.len() {
            var f: Func = fs.get(fi);
            if !cc_is_cfg(f) {
                var prev: i64 = HashMap_get(definer, f.name);
                if prev == 0 {
                    HashMap_insert(definer, f.name, mi + 1);
                } else if prev != mi + 1 {
                    HashMap_insert(definer, f.name, 0 - 1);
                }
            }
            fi = fi + 1;
        }
        mi = mi + 1;
    }
    var renames: Vec<RenameEntry> = rename_new();
    var any: bool = false;
    var ui: i64 = 0;
    while ui < user.funcs.len() {
        var uf: Func = user.funcs.get(ui);
        var d: i64 = HashMap_get(definer, uf.name);
        if d > 0 && !cc_is_cfg(uf) {
            var module: str = str_replace(names.get(d - 1), "::", "__");
            rename_set(renames, uf.name, module + "__" + uf.name);
            any = true;
        }
        ui = ui + 1;
    }
    if !any { return; }
    mi = 0;
    while mi < imported.len() {
        var prog: Program = imported.get(mi);
        cc_rename_funcs(prog.funcs, renames, true);
        var ii: i64 = 0;
        while ii < prog.impls.len() {
            cc_rename_funcs(prog.impls.get(ii).methods, renames, false);
            ii = ii + 1;
        }
        ii = 0;
        while ii < prog.trait_impls.len() {
            cc_rename_funcs(prog.trait_impls.get(ii).methods, renames, false);
            ii = ii + 1;
        }
        mi = mi + 1;
    }
}

fn cc_push_traits(defs: Vec<TraitDef>, p: Program) {
    var i: i64 = 0;
    while i < p.traits.len() {
        defs.push(p.traits.get(i));
        i = i + 1;
    }
}

/// Supertrait methods first (transitively), then the trait's own; a method
/// the trait redeclares keeps its signature.
fn cc_collect_trait_methods(name: str, defs: Vec<TraitDef>, seen: Vec<str>, out: Vec<TraitMethod>) {
    if cc_c_str_vec_contains(seen, name) { return; }
    seen.push(name);
    var i: i64 = 0;
    while i < defs.len() {
        var t: TraitDef = defs.get(i);
        if t.name == name {
            var s: i64 = 0;
            while s < t.supertraits.len() {
                cc_collect_trait_methods(t.supertraits.get(s), defs, seen, out);
                s = s + 1;
            }
            var m: i64 = 0;
            while m < t.methods.len() {
                var tm: TraitMethod = t.methods.get(m);
                var replaced: bool = false;
                var o: i64 = 0;
                while o < out.len() {
                    if out.get(o).name == tm.name {
                        out.set(o, tm);
                        replaced = true;
                        break;
                    }
                    o = o + 1;
                }
                if !replaced { out.push(tm); }
                m = m + 1;
            }
            return;
        }
        i = i + 1;
    }
}

/// `cap Sub: Super { .. }`: a subtrait inherits its supertraits' methods, so
/// an impl of Sub must provide them and a `dyn Sub` vtable carries them.
fn cc_inherit_supertraits(p: Program, defs: Vec<TraitDef>, errors: Vec<str>) {
    var i: i64 = 0;
    while i < p.traits.len() {
        var t: TraitDef = p.traits.get(i);
        if t.supertraits.len() > 0 {
            var s: i64 = 0;
            while s < t.supertraits.len() {
                var sup: str = t.supertraits.get(s);
                var found: bool = false;
                var d: i64 = 0;
                while d < defs.len() {
                    if defs.get(d).name == sup { found = true; break; }
                    d = d + 1;
                }
                if !found {
                    errors.push("Type error: trait '" + sup + "' is not defined (supertrait of '" + t.name + "')");
                }
                s = s + 1;
            }
            var out: Vec<TraitMethod> = Vec::new();
            var seen: Vec<str> = Vec::new();
            cc_collect_trait_methods(t.name, defs, seen, out);
            t.methods = out;
            p.traits.set(i, t);
        }
        i = i + 1;
    }
}

pub fn cc_c_str_vec_contains(vec: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < vec.len() {
        if vec.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

/// Fast contains check using pointer equality (==) instead of str_equal.
/// Only safe to use when all strings in the vec AND the search string are
/// interned (i.e., produced by Lexer_intern or from the same str_slice).
/// This is O(n) but each comparison is a single i64 == instead of a
/// function call + byte-by-byte comparison.
pub fn c_str_vec_contains_ptr(vec: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < vec.len() {
        if vec.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

/// Join a Vec<str> with a separator.
pub fn c_str_join(vec: Vec<str>, sep: str) -> str {
    var result: str = "";
    var i: i64 = 0;
    while i < vec.len() {
        if i > 0 { result = str_concat(result, sep); }
        result = str_concat(result, vec.get(i));
        i = i + 1;
    }
    return result;
}

/// Pad a string on the left to a given width.
pub fn c_str_pad_left(s: str, width: i64, ch: i64) -> str {
    var result: str = s;
    while str_len(result) < width {
        result = str_concat(p_char_to_str(ch), result);
    }
    return result;
}

/// Find the last occurrence of a character in a string.
pub fn c_str_find_last(s: str, ch: str) -> i64 {
    // Search from the end using str_slice for single-char comparison
    var i: i64 = str_len(s) - 1;
    while i >= 0 {
        if str_slice(s, i, i + 1) == ch { return i; }
        i = i - 1;
    }
    return -1;
}

// c_vec1 and c_file_exists moved to compiler::ir (shared with backends
// that cannot import this module).

// ===========================================================================
// File/Path/OS helpers (using builtins directly)
// ===========================================================================

pub fn c_vec0_str() -> Vec<str> {
    return Vec::new();
}

pub fn c_vec2_str(a: str, b: str) -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}

/// Read a file as a string. Returns empty string on failure.
pub fn c_file_read(path: str) -> str {
    var content = p_file_read(path);
    if content == 0 { return ""; }
    return content;
}

/// Get the directory part of a path (everything before the last /).
pub fn c_path_dirname(path: str) -> str {
    // Either separator (a Windows path: C:\Fides\fides.exe)
    var idx: i64 = c_str_find_last(path, "/");
    var bidx: i64 = c_str_find_last(path, "\\");
    if bidx > idx { idx = bidx; }
    if idx < 0 { return "."; }
    if idx == 0 { return "/"; }
    return c_str_substr(path, 0, idx);
}

/// Join two path components with a /.
pub fn c_path_join(a: str, b: str) -> str {
    if str_len(a) == 0 { return b; }
    if str_len(b) == 0 { return a; }
    var last_char: str = str_slice(a, str_len(a) - 1, str_len(a));
    if last_char == "/" {
        return str_concat(a, b);
    }
    return c_str_concat3(a, "/", b);
}

/// Get the current working directory.
pub fn c_os_cwd() -> str {
    return ".";
}
