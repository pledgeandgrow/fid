// compiler.fd -- Compiler pipeline driver (rewritten from src/compiler.rs)
//
// This module provides:
// 1. Helper functions and utilities (edit_distance, error enrichment, string/path
//    helpers, capability checking) -- fully functional and tested.
// 2. Pipeline orchestration functions (build_program_with_path, lower_to_ir_module,
//    ccompile_source_with_path, etc.) -- fully functional.
// 3. AST transformation passes (merge_programs, apply_cfg_filter, process_derive,
//    desugar_layers_models, fill_default_trait_methods) -- fully functional.
// 4. Capability stripping (strip_ungranted_caps) -- fully functional.
//
// Adaptations from Rust:
// 1. Result<T, Vec<String>> -> custom Result types (ResultProgram, ResultStr, etc.)
// 2. &str -> str, usize -> i64
// 3. HashSet<T> -> Vec<T> with str_vec_contains helper
// 4. Path operations -> string manipulation (path_dirname, path_join)
// 5. include_str! -> file_read at runtime (stdlib/core.fd loaded from disk)
// 6. No closures -- all helpers are top-level functions
// 7. No ? operator -- explicit match on Result types

module compiler::compiler;

