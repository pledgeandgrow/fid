// escape.fd -- Reference escape check, rewritten from src/escape.rs
//
// References are second-class values: they may be passed to calls, held in
// locals and returned when they come from one of the function's reference
// parameters, but never kept anywhere they could outlive what they point to.
// src/escape.rs lists the rules; docs/guides/references.md explains the
// design. Runs after type checking.
//
// Adaptations from Rust:
// 1. BTreeSet<Root> -> sorted Vec<EscRoot>, in the order Rust derives
// 2. HashMap<String, _> -> core HashMap (str -> index + 1) over Vecs
// 3. Box<Expr>/Box<Type> -> box_expr_deref / box_type_unbox
//
// Dependencies: compiler::ast

module compiler::escape;

use core;
use vec;
use string;
use compiler::ast;

/// What a reference-holding value points into: a local variable (or
/// by-value parameter) declared at block depth `depth`, or the function's
/// `index`-th parameter, a reference the caller supplied.
pub struct EscRoot {
    pub is_param: bool,
    pub name: str,
    pub depth: i64,
    pub index: i64,
}

pub struct EscVar {
    pub name: str,
    pub depth: i64,
    pub roots: Vec<EscRoot>,
    // The value is itself a reference (rather than an Option, Result or
    // tuple holding one): what it points to holds no reference (rule 2).
    pub is_ref: bool,
}

pub enum OptEscVar {
    Some(EscVar),
    None,
}

/// A function body with the name it is called by (`Type_method` for methods).
pub struct EscFunc {
    pub key: str,
    pub func: Func,
}

pub struct EscapeChecker {
    pub all: Vec<EscFunc>,
    pub func_index: i64,       // HashMap: key -> index + 1 into all
    pub method_index: i64,     // HashMap: method name -> index + 1 into method_keys
    pub method_keys: Vec<Vec<str>>,
    pub globals: i64,          // HashMap: global or const name -> 1
    pub summary_index: i64,    // HashMap: key -> index + 1 into summaries
    pub summaries: Vec<Vec<i64>>,
    pub scopes: Vec<Vec<EscVar>>,
    pub func_name: str,
    pub flows: Vec<i64>,
    pub loop_depths: Vec<i64>,
    pub closure_base: i64,
    pub unsafe_depth: i64,
    pub line: i64,
    pub report: bool,
    pub errors: Vec<str>,
}

// --- Root sets ------------------------------------------------------------

fn esc_local(name: str, depth: i64) -> EscRoot {
    return EscRoot { is_param: false, name: name, depth: depth, index: 0 };
}

fn esc_param(index: i64) -> EscRoot {
    return EscRoot { is_param: true, name: "", depth: 0, index: index };
}

// Rust's derived order: every Local before every Param; Locals by name, then
// depth; Params by index.
fn esc_root_cmp(a: EscRoot, b: EscRoot) -> i64 {
    if a.is_param != b.is_param {
        if a.is_param { return 1; }
        return -1;
    }
    if a.is_param { return a.index - b.index; }
    var c: i64 = str_compare(a.name, b.name);
    if c != 0 { return c; }
    return a.depth - b.depth;
}

// A new set with `r` added. Sets are small sorted Vecs, never changed in
// place (a Vec value is a shared handle).
fn esc_with(rs: Vec<EscRoot>, r: EscRoot) -> Vec<EscRoot> {
    var out: Vec<EscRoot> = Vec::new();
    var placed: bool = false;
    var i: i64 = 0;
    while i < rs.len() {
        var x: EscRoot = rs.get(i);
        if !placed {
            var c: i64 = esc_root_cmp(r, x);
            if c == 0 {
                placed = true;
            } else if c < 0 {
                out.push(r);
                placed = true;
            }
        }
        out.push(x);
        i = i + 1;
    }
    if !placed { out.push(r); }
    return out;
}

fn esc_union(a: Vec<EscRoot>, b: Vec<EscRoot>) -> Vec<EscRoot> {
    var out: Vec<EscRoot> = Vec::new();
    var i: i64 = 0;
    while i < a.len() {
        out.push(a.get(i));
        i = i + 1;
    }
    var j: i64 = 0;
    while j < b.len() {
        out = esc_with(out, b.get(j));
        j = j + 1;
    }
    return out;
}

fn esc_one(r: EscRoot) -> Vec<EscRoot> {
    var out: Vec<EscRoot> = Vec::new();
    out.push(r);
    return out;
}

fn esc_none() -> Vec<EscRoot> {
    return Vec::new();
}

// --- Types ----------------------------------------------------------------

/// `Option`, `Result` and tuples pass a reference through without storing it.
fn esc_is_transparent(name: str) -> bool {
    return name == "Option" || name == "Result";
}

/// Whether `t` holds a reference anywhere (function types do not hold their
/// parameters' or result's references).
pub fn esc_contains_ref(t: Type) -> bool {
    match t {
        Type::Ref(_, _) => { return true; }
        Type::Generic(_, args) => { return esc_any_ref(args); }
        Type::Tuple(args) => { return esc_any_ref(args); }
        Type::Array(e, _) => { return esc_contains_ref(box_type_unbox(e)); }
        Type::ArrayConst(e, _) => { return esc_contains_ref(box_type_unbox(e)); }
        Type::ShapedTensor(e, _) => { return esc_contains_ref(box_type_unbox(e)); }
        _ => { return false; }
    }
    return false;
}

fn esc_any_ref(ts: Vec<Type>) -> bool {
    var i: i64 = 0;
    while i < ts.len() {
        if esc_contains_ref(ts.get(i)) { return true; }
        i = i + 1;
    }
    return false;
}

fn esc_all_digits(s: str) -> bool {
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c < 48 || c > 57 { return false; }
        i = i + 1;
    }
    return true;
}

/// Read-only builtins that may be handed a reference.
fn esc_read_only_call(name: str) -> bool {
    return name == "print" || name == "println" || name == "eprint" || name == "eprintln" || name == "assert" || name == "assert_eq" || name == "format" || name == "panic" || name == "debug";
}

fn esc_read_only_method(name: str) -> bool {
    return name == "contains" || name == "starts_with" || name == "ends_with" || name == "find" || name == "index_of" || name == "eq" || name == "equals" || name == "cmp" || name == "compare" || name == "len" || name == "get";
}

// --- Setup ----------------------------------------------------------------

pub fn EscapeChecker_new(program: Program) -> EscapeChecker {
    var all: Vec<EscFunc> = Vec::new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        var f: Func = program.funcs.get(i);
        all.push(EscFunc { key: f.name, func: f });
        i = i + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var m: Func = imp.methods.get(mi);
            all.push(EscFunc { key: imp.struct_name + "_" + m.name, func: m });
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var ti: i64 = 0;
    while ti < program.trait_impls.len() {
        var timp: TraitImpl = program.trait_impls.get(ti);
        var tmi: i64 = 0;
        while tmi < timp.methods.len() {
            var tm: Func = timp.methods.get(tmi);
            all.push(EscFunc { key: timp.type_name + "_" + tm.name, func: tm });
            tmi = tmi + 1;
        }
        ti = ti + 1;
    }
    var func_index: i64 = HashMap_new();
    var method_index: i64 = HashMap_new();
    var method_keys: Vec<Vec<str>> = Vec::new();
    var k: i64 = 0;
    while k < all.len() {
        var key: str = all.get(k).key;
        if HashMap_get(func_index, key) == 0 {
            HashMap_insert(func_index, key, k + 1);
        }
        // `Type_method` is callable as `.method()`; the type name may itself
        // contain underscores, so register every suffix.
        var p: i64 = 0;
        while p < str_len(key) {
            if str_byte_at(key, p) == 95 {
                var suffix: str = str_slice(key, p + 1, str_len(key));
                var slot: i64 = HashMap_get(method_index, suffix);
                if slot == 0 {
                    method_keys.push(Vec::new());
                    slot = method_keys.len();
                    HashMap_insert(method_index, suffix, slot);
                }
                var keys: Vec<str> = method_keys.get(slot - 1);
                keys.push(key);
            }
            p = p + 1;
        }
        k = k + 1;
    }
    var globals: i64 = HashMap_new();
    var gi: i64 = 0;
    while gi < program.globals.len() {
        HashMap_insert(globals, program.globals.get(gi).name, 1);
        gi = gi + 1;
    }
    var ci: i64 = 0;
    while ci < program.consts.len() {
        HashMap_insert(globals, program.consts.get(ci).name, 1);
        ci = ci + 1;
    }
    return EscapeChecker {
        all: all,
        func_index: func_index,
        method_index: method_index,
        method_keys: method_keys,
        globals: globals,
        summary_index: HashMap_new(),
        summaries: Vec::new(),
        scopes: Vec::new(),
        func_name: "",
        flows: Vec::new(),
        loop_depths: Vec::new(),
        closure_base: 0,
        unsafe_depth: 0,
        line: 0,
        report: false,
        errors: Vec::new(),
    };
}

fn esc_error(self: &mut EscapeChecker, msg: str) {
    if self.report && self.unsafe_depth == 0 {
        var full: str = "Reference error (line " + int_to_str(self.line) + "): in '" + self.func_name + "', " + msg;
        if !str_vec_contains(self.errors, full) {
            self.errors.push(full);
        }
    }
}

fn esc_is_global(self: &EscapeChecker, name: str) -> bool {
    return HashMap_get(self.globals, name) != 0;
}

fn esc_summary(self: &EscapeChecker, key: str) -> Vec<i64> {
    var slot: i64 = HashMap_get(self.summary_index, key);
    if slot == 0 { return Vec::new(); }
    return self.summaries.get(slot - 1);
}

fn esc_set_summary(self: &mut EscapeChecker, key: str, flows: Vec<i64>) {
    var slot: i64 = HashMap_get(self.summary_index, key);
    if slot == 0 {
        self.summaries.push(flows);
        HashMap_insert(self.summary_index, key, self.summaries.len());
    } else {
        self.summaries.set(slot - 1, flows);
    }
}

fn esc_summary_total(self: &EscapeChecker) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < self.summaries.len() {
        n = n + self.summaries.get(i).len();
        i = i + 1;
    }
    return n;
}

// --- Types ----------------------------------------------------------------

/// A parameter, local or return type: a reference may sit at the top or
/// inside Option/Result/tuples, never inside storage.
fn esc_check_value_type(self: &mut EscapeChecker, t: Type, what: str) {
    match t {
        Type::Ref(inner, _) => {
            if esc_contains_ref(box_type_unbox(inner)) {
                esc_error(self, what + " has type '" + type_to_str(t) + "': a reference cannot point to another reference");
            }
        }
        Type::Generic(name, args) => {
            if esc_is_transparent(name) {
                var i: i64 = 0;
                while i < args.len() {
                    esc_check_value_type(self, args.get(i), what);
                    i = i + 1;
                }
            } else {
                esc_check_storage_type(self, t, what);
            }
        }
        Type::Tuple(args) => {
            var j: i64 = 0;
            while j < args.len() {
                esc_check_value_type(self, args.get(j), what);
                j = j + 1;
            }
        }
        _ => { esc_check_storage_type(self, t, what); }
    }
}

fn esc_check_storage_type(self: &mut EscapeChecker, t: Type, what: str) {
    if esc_contains_ref(t) {
        esc_error(self, what + " has type '" + type_to_str(t) + "', which stores a reference; references can only be passed to calls, held in locals and returned");
    }
}

fn esc_check_decls(self: &mut EscapeChecker, program: Program) {
    self.report = true;
    var si: i64 = 0;
    while si < program.structs.len() {
        var s: StructDef = program.structs.get(si);
        self.func_name = s.name;
        self.line = 0;
        var fi: i64 = 0;
        while fi < s.fields.len() {
            var fld: Param = s.fields.get(fi);
            esc_check_storage_type(self, fld.ty, "field '" + s.name + "." + fld.name + "'");
            fi = fi + 1;
        }
        si = si + 1;
    }
    var ei: i64 = 0;
    while ei < program.enums.len() {
        var en: EnumDef = program.enums.get(ei);
        self.func_name = en.name;
        self.line = 0;
        var vi: i64 = 0;
        while vi < en.variants.len() {
            var v: EnumVariant = en.variants.get(vi);
            match v.data {
                OptParams::Some(ps) => {
                    var pi: i64 = 0;
                    while pi < ps.len() {
                        esc_check_storage_type(self, ps.get(pi).ty, "variant '" + en.name + "::" + v.name + "'");
                        pi = pi + 1;
                    }
                }
                OptParams::None => {}
            }
            vi = vi + 1;
        }
        ei = ei + 1;
    }
    var gi: i64 = 0;
    while gi < program.globals.len() {
        var g: GlobalVar = program.globals.get(gi);
        self.func_name = g.name;
        self.line = 0;
        esc_check_storage_type(self, g.ty, "global '" + g.name + "'");
        gi = gi + 1;
    }
    self.report = false;
}

// --- Scopes ---------------------------------------------------------------

fn esc_depth(self: &EscapeChecker) -> i64 {
    return self.scopes.len();
}

fn esc_push_scope(self: &mut EscapeChecker) {
    self.scopes.push(Vec::new());
}

fn esc_pop_scope(self: &mut EscapeChecker) {
    self.scopes.pop();
}

fn esc_declare(self: &mut EscapeChecker, name: str, roots: Vec<EscRoot>, is_ref: bool) {
    var top: Vec<EscVar> = self.scopes.get(self.scopes.len() - 1);
    // A redeclaration in the same block shadows the earlier one.
    var i: i64 = 0;
    while i < top.len() {
        if top.get(i).name == name {
            top.set(i, EscVar { name: name, depth: self.scopes.len(), roots: roots, is_ref: is_ref });
            return;
        }
        i = i + 1;
    }
    top.push(EscVar { name: name, depth: self.scopes.len(), roots: roots, is_ref: is_ref });
}

fn esc_is_ref_type(t: Type) -> bool {
    match t {
        Type::Ref(_, _) => { return true; }
        _ => { return false; }
    }
    return false;
}

/// Whether `e` evaluates to a reference itself (so a `match` on it binds
/// plain payload values, which hold no reference).
fn esc_is_reference(self: &EscapeChecker, e: Expr) -> bool {
    match e {
        Expr::Ref(_, _) => { return true; }
        Expr::Ident(name) => {
            match esc_lookup(self, name) {
                OptEscVar::Some(v) => { return v.is_ref; }
                OptEscVar::None => { return false; }
            }
        }
        Expr::Call(callee, _) => {
            var slot: i64 = HashMap_get(self.func_index, callee);
            if slot == 0 { return false; }
            return esc_is_ref_type(self.all.get(slot - 1).func.ret_ty);
        }
        Expr::MethodCall(_, method, _) => {
            var mslot: i64 = HashMap_get(self.method_index, method);
            if mslot == 0 { return false; }
            var keys: Vec<str> = self.method_keys.get(mslot - 1);
            if keys.len() == 0 { return false; }
            var k: i64 = 0;
            while k < keys.len() {
                var f: Func = self.all.get(HashMap_get(self.func_index, keys.get(k)) - 1).func;
                if !esc_is_ref_type(f.ret_ty) { return false; }
                k = k + 1;
            }
            return true;
        }
        _ => { return false; }
    }
    return false;
}

/// The roots a `match` on `e` passes to its bindings.
fn esc_binding_roots(self: &mut EscapeChecker, e: Expr) -> Vec<EscRoot> {
    var r: Vec<EscRoot> = esc_expr(self, e);
    if esc_is_reference(self, e) { return esc_none(); }
    return r;
}

fn esc_lookup(self: &EscapeChecker, name: str) -> OptEscVar {
    var s: i64 = self.scopes.len() - 1;
    while s >= 0 {
        var scope: Vec<EscVar> = self.scopes.get(s);
        var i: i64 = 0;
        while i < scope.len() {
            var v: EscVar = scope.get(i);
            if v.name == name { return OptEscVar::Some(v); }
            i = i + 1;
        }
        s = s - 1;
    }
    return OptEscVar::None;
}

fn esc_var_roots(self: &EscapeChecker, name: str) -> Vec<EscRoot> {
    match esc_lookup(self, name) {
        OptEscVar::Some(v) => { return v.roots; }
        OptEscVar::None => { return esc_none(); }
    }
    return esc_none();
}

// Add `extra` to the roots of the innermost variable called `name`.
fn esc_add_roots(self: &mut EscapeChecker, name: str, extra: Vec<EscRoot>) {
    var s: i64 = self.scopes.len() - 1;
    while s >= 0 {
        var scope: Vec<EscVar> = self.scopes.get(s);
        var i: i64 = 0;
        while i < scope.len() {
            var v: EscVar = scope.get(i);
            if v.name == name {
                scope.set(i, EscVar { name: v.name, depth: v.depth, roots: esc_union(v.roots, extra), is_ref: v.is_ref });
                return;
            }
            i = i + 1;
        }
        s = s - 1;
    }
}

/// Drop the roots that point into blocks deeper than `depth`, reporting each
/// one: a value leaving those blocks would dangle.
fn esc_leave_blocks(self: &mut EscapeChecker, roots: Vec<EscRoot>, depth: i64, what: str) -> Vec<EscRoot> {
    var kept: Vec<EscRoot> = Vec::new();
    var i: i64 = 0;
    while i < roots.len() {
        var r: EscRoot = roots.get(i);
        if !r.is_param && r.depth > depth {
            esc_error(self, what + " refers to '" + r.name + "', which is freed at the end of its block");
        } else {
            kept.push(r);
        }
        i = i + 1;
    }
    return kept;
}

// --- Functions ------------------------------------------------------------

fn esc_analyze_func(self: &mut EscapeChecker, key: str, f: Func) {
    self.func_name = f.name;
    self.line = 0;
    var no_flows: Vec<i64> = Vec::new();
    var no_scopes: Vec<Vec<EscVar>> = Vec::new();
    var no_loops: Vec<i64> = Vec::new();
    self.flows = no_flows;
    self.scopes = no_scopes;
    esc_push_scope(self);
    self.loop_depths = no_loops;
    self.closure_base = 0;
    self.unsafe_depth = 0;
    var i: i64 = 0;
    while i < f.params.len() {
        var p: Param = f.params.get(i);
        esc_check_value_type(self, p.ty, "parameter '" + p.name + "'");
        if esc_contains_ref(p.ty) {
            esc_declare(self, p.name, esc_one(esc_param(i)), esc_is_ref_type(p.ty));
        } else {
            esc_declare(self, p.name, esc_none(), false);
        }
        i = i + 1;
    }
    esc_check_value_type(self, f.ret_ty, "the return type");
    var is_void: bool = false;
    match f.ret_ty {
        Type::Void => { is_void = true; }
        _ => {}
    }
    if is_void {
        var si: i64 = 0;
        while si < f.body.len() {
            esc_stmt(self, f.body.get(si));
            si = si + 1;
        }
    } else {
        var tail: Vec<EscRoot> = esc_stmts_value(self, f.body);
        esc_check_return(self, tail);
    }
    esc_set_summary(self, key, self.flows);
}

fn esc_check_return(self: &mut EscapeChecker, roots: Vec<EscRoot>) {
    var i: i64 = 0;
    while i < roots.len() {
        var r: EscRoot = roots.get(i);
        if r.is_param {
            if self.closure_base == 0 && !vec_contains_i64(self.flows, r.index) {
                self.flows = esc_sorted_insert_i64(self.flows, r.index);
            }
        } else if r.depth > self.closure_base {
            var what: str = "a closure";
            if self.closure_base == 0 { what = "'" + self.func_name + "'"; }
            esc_error(self, what + " returns a reference to local '" + r.name + "', which is freed when it returns");
        }
        i = i + 1;
    }
}

fn esc_sorted_insert_i64(v: Vec<i64>, x: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var placed: bool = false;
    var i: i64 = 0;
    while i < v.len() {
        var y: i64 = v.get(i);
        if !placed && x < y {
            out.push(x);
            placed = true;
        }
        out.push(y);
        i = i + 1;
    }
    if !placed { out.push(x); }
    return out;
}

// --- Statements -----------------------------------------------------------

/// Process `stmts` in the current scope and return the roots of their value
/// (the last statement's, when it is an expression or a branch).
fn esc_stmts_value(self: &mut EscapeChecker, stmts: Vec<Stmt>) -> Vec<EscRoot> {
    var n: i64 = stmts.len();
    if n == 0 { return esc_none(); }
    var i: i64 = 0;
    while i < n - 1 {
        esc_stmt(self, stmts.get(i));
        i = i + 1;
    }
    return esc_stmt_value(self, stmts.get(n - 1));
}

fn esc_stmt_value(self: &mut EscapeChecker, s: Stmt) -> Vec<EscRoot> {
    self.line = stmt_line(s);
    match s {
        Stmt::Expr(e, _) => { return esc_expr(self, e); }
        Stmt::If(cond, then_block, else_block, _) => {
            esc_expr(self, cond);
            var r: Vec<EscRoot> = esc_block_value(self, then_block, "the value of this branch");
            match else_block {
                OptStmts::Some(eb) => { r = esc_union(r, esc_block_value(self, eb, "the value of this branch")); }
                OptStmts::None => {}
            }
            return r;
        }
        Stmt::Match(expr, arms, _) => {
            var scrutinee: Vec<EscRoot> = esc_binding_roots(self, expr);
            return esc_arms(self, arms, scrutinee, true);
        }
        Stmt::Unsafe(body, _) => {
            self.unsafe_depth = self.unsafe_depth + 1;
            var ur: Vec<EscRoot> = esc_block_value(self, body, "the value of this block");
            self.unsafe_depth = self.unsafe_depth - 1;
            return ur;
        }
        Stmt::Sandbox(body, _) => { return esc_block_value(self, body, "the value of this block"); }
        Stmt::Txn(body, _) => { return esc_block_value(self, body, "the value of this block"); }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => { return esc_block_value(self, body, "the value of this block"); }
        Stmt::Handle(body, _, _) => { return esc_block_value(self, body, "the value of this block"); }
        _ => {
            esc_stmt(self, s);
            return esc_none();
        }
    }
    return esc_none();
}

/// Evaluate a nested block's value; it must not point at the block's own locals.
fn esc_block_value(self: &mut EscapeChecker, stmts: Vec<Stmt>, what: str) -> Vec<EscRoot> {
    var outer: i64 = esc_depth(self);
    esc_push_scope(self);
    var r: Vec<EscRoot> = esc_stmts_value(self, stmts);
    esc_pop_scope(self);
    return esc_leave_blocks(self, r, outer, what);
}

fn esc_block(self: &mut EscapeChecker, stmts: Vec<Stmt>) {
    esc_push_scope(self);
    var i: i64 = 0;
    while i < stmts.len() {
        esc_stmt(self, stmts.get(i));
        i = i + 1;
    }
    esc_pop_scope(self);
}

/// Check the arms of a `match`; with `want_value`, also return the roots of
/// the value it produces.
fn esc_arms(self: &mut EscapeChecker, arms: Vec<MatchArm>, scrutinee: Vec<EscRoot>, want_value: bool) -> Vec<EscRoot> {
    var outer: i64 = esc_depth(self);
    var out: Vec<EscRoot> = Vec::new();
    var ai: i64 = 0;
    while ai < arms.len() {
        var arm: MatchArm = arms.get(ai);
        esc_push_scope(self);
        match arm.pattern {
            // A binding is the reference an Option/Result/tuple held.
            Pattern::Ident(name) => { esc_declare(self, name, scrutinee, scrutinee.len() > 0); }
            Pattern::EnumVariant(_, _, bindings) => {
                var bi: i64 = 0;
                while bi < bindings.len() {
                    esc_declare(self, bindings.get(bi).name, scrutinee, scrutinee.len() > 0);
                    bi = bi + 1;
                }
            }
            _ => {}
        }
        match arm.guard {
            OptBoxExpr::Some(g) => { esc_expr(self, box_expr_deref(g)); }
            OptBoxExpr::None => {}
        }
        if want_value {
            var r: Vec<EscRoot> = esc_stmts_value(self, arm.body);
            esc_pop_scope(self);
            out = esc_union(out, esc_leave_blocks(self, r, outer, "the value of this match arm"));
        } else {
            var si: i64 = 0;
            while si < arm.body.len() {
                esc_stmt(self, arm.body.get(si));
                si = si + 1;
            }
            esc_pop_scope(self);
        }
        ai = ai + 1;
    }
    return out;
}

fn esc_loop_body(self: &mut EscapeChecker, body: Vec<Stmt>) {
    self.loop_depths.push(esc_depth(self));
    esc_block(self, body);
    self.loop_depths.pop();
}

fn esc_stmt(self: &mut EscapeChecker, s: Stmt) {
    self.line = stmt_line(s);
    match s {
        Stmt::Let(name, ty, expr, _, _, _, _) => {
            match ty {
                OptType::Some(t) => { esc_check_value_type(self, t, "local '" + name + "'"); }
                OptType::None => {}
            }
            var r: Vec<EscRoot> = esc_expr(self, expr);
            var is_ref: bool = false;
            match ty {
                OptType::Some(t2) => { is_ref = esc_is_ref_type(t2); }
                OptType::None => { is_ref = esc_is_reference(self, expr); }
            }
            esc_declare(self, name, r, is_ref);
        }
        Stmt::LetTuple(names, expr, _) => {
            var tr: Vec<EscRoot> = esc_expr(self, expr);
            var ni: i64 = 0;
            while ni < names.len() {
                esc_declare(self, names.get(ni), tr, false);
                ni = ni + 1;
            }
        }
        Stmt::LetUninit(name, ty, _, _) => {
            esc_check_value_type(self, ty, "local '" + name + "'");
            esc_declare(self, name, esc_none(), esc_is_ref_type(ty));
        }
        Stmt::Assign(target, _, expr, _) => {
            var ar: Vec<EscRoot> = esc_expr(self, expr);
            esc_assign_to(self, target, ar);
        }
        Stmt::IndexAssign(array, index, _, expr, _) => {
            esc_expr(self, index);
            var ir: Vec<EscRoot> = esc_expr(self, expr);
            if ir.len() > 0 {
                esc_error(self, "a reference cannot be stored in an element of '" + array + "'");
            }
        }
        Stmt::FieldAssign(object, field, _, expr, _) => {
            esc_expr(self, object);
            var fr: Vec<EscRoot> = esc_expr(self, expr);
            if fr.len() > 0 {
                if esc_all_digits(field) {
                    match object {
                        Expr::Ident(base) => { esc_assign_to(self, base, fr); }
                        _ => {}
                    }
                } else {
                    esc_error(self, "a reference cannot be stored in field '" + field + "'");
                }
            }
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            esc_expr(self, ptr_expr);
            var dr: Vec<EscRoot> = esc_expr(self, expr);
            if dr.len() > 0 {
                esc_error(self, "a reference cannot be stored through another reference");
            }
        }
        Stmt::Expr(e, _) => { esc_expr(self, e); }
        Stmt::Return(value, _) => {
            match value {
                OptBoxExpr::Some(e) => {
                    var rr: Vec<EscRoot> = esc_expr(self, box_expr_deref(e));
                    esc_check_return(self, rr);
                }
                OptBoxExpr::None => {}
            }
        }
        Stmt::Break(value, _) => {
            match value {
                OptBoxExpr::Some(e) => {
                    var br: Vec<EscRoot> = esc_expr(self, box_expr_deref(e));
                    if self.loop_depths.len() > 0 {
                        esc_leave_blocks(self, br, self.loop_depths.get(self.loop_depths.len() - 1), "the value of this loop");
                    }
                }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            esc_expr(self, cond);
            esc_block(self, then_block);
            match else_block {
                OptStmts::Some(eb) => { esc_block(self, eb); }
                OptStmts::None => {}
            }
        }
        Stmt::While(cond, body, _) => {
            esc_expr(self, cond);
            esc_loop_body(self, body);
        }
        Stmt::For(var_name, iterator, body, _) => {
            esc_expr(self, iterator);
            self.loop_depths.push(esc_depth(self));
            esc_push_scope(self);
            esc_declare(self, var_name, esc_none(), false);
            var fi: i64 = 0;
            while fi < body.len() {
                esc_stmt(self, body.get(fi));
                fi = fi + 1;
            }
            esc_pop_scope(self);
            self.loop_depths.pop();
        }
        Stmt::Loop(body, _) => { esc_loop_body(self, body); }
        Stmt::Match(expr, arms, _) => {
            var mr: Vec<EscRoot> = esc_binding_roots(self, expr);
            esc_arms(self, arms, mr, false);
        }
        Stmt::Unsafe(body, _) => {
            self.unsafe_depth = self.unsafe_depth + 1;
            esc_block(self, body);
            self.unsafe_depth = self.unsafe_depth - 1;
        }
        Stmt::Defer(body, _) => { esc_block(self, body); }
        Stmt::Sandbox(body, _) => { esc_block(self, body); }
        Stmt::Txn(body, _) => { esc_block(self, body); }
        Stmt::Handle(body, _, _) => { esc_block(self, body); }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => { esc_block(self, body); }
        Stmt::SpawnScope(body, _) => { esc_block(self, body); }
        Stmt::Query(_, body, _) => { esc_block(self, body); }
        Stmt::GradBlock(_, body, _) => { esc_block(self, body); }
        Stmt::Parallel(branches, _) => {
            var pi: i64 = 0;
            while pi < branches.len() {
                esc_block(self, branches.get(pi));
                pi = pi + 1;
            }
        }
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                var c: SelectCase = cases.get(ci);
                esc_expr(self, c.channel);
                esc_push_scope(self);
                esc_declare(self, c.var_name, esc_none(), false);
                var cs: i64 = 0;
                while cs < c.body.len() {
                    esc_stmt(self, c.body.get(cs));
                    cs = cs + 1;
                }
                esc_pop_scope(self);
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(d) => { esc_block(self, d); }
                OptStmts::None => {}
            }
        }
        Stmt::Do(_, _, args, _) => {
            var di: i64 = 0;
            while di < args.len() {
                esc_expr(self, args.get(di));
                di = di + 1;
            }
        }
        Stmt::Resume(cont, value, _) => {
            esc_expr(self, cont);
            esc_expr(self, value);
        }
        Stmt::Backward(loss, _) => { esc_expr(self, loss); }
        _ => {}
    }
}

/// `target = <value with roots r>`: the target must not outlive any root.
fn esc_assign_to(self: &mut EscapeChecker, target: str, r: Vec<EscRoot>) {
    if r.len() == 0 { return; }
    var target_depth: i64 = 0;
    match esc_lookup(self, target) {
        OptEscVar::Some(v) => { target_depth = v.depth; }
        OptEscVar::None => {
            if esc_is_global(self, target) {
                esc_error(self, "global '" + target + "' cannot hold a reference");
            }
            return;
        }
    }
    var kept: Vec<EscRoot> = Vec::new();
    var i: i64 = 0;
    while i < r.len() {
        var x: EscRoot = r.get(i);
        if !x.is_param && x.depth > target_depth {
            esc_error(self, "'" + target + "' would outlive '" + x.name + "': '" + x.name + "' is freed at the end of its block while '" + target + "' is still in scope");
        } else {
            kept.push(x);
        }
        i = i + 1;
    }
    esc_add_roots(self, target, kept);
}

// --- Expressions ----------------------------------------------------------

fn esc_exprs(self: &mut EscapeChecker, es: Vec<Expr>) -> Vec<Vec<EscRoot>> {
    var out: Vec<Vec<EscRoot>> = Vec::new();
    var i: i64 = 0;
    while i < es.len() {
        out.push(esc_expr(self, es.get(i)));
        i = i + 1;
    }
    return out;
}

fn esc_union_all(rs: Vec<Vec<EscRoot>>) -> Vec<EscRoot> {
    var out: Vec<EscRoot> = Vec::new();
    var i: i64 = 0;
    while i < rs.len() {
        out = esc_union(out, rs.get(i));
        i = i + 1;
    }
    return out;
}

/// The roots of `e`'s value (empty when it holds no reference).
fn esc_expr(self: &mut EscapeChecker, e: Expr) -> Vec<EscRoot> {
    match e {
        Expr::Ident(name) => { return esc_var_roots(self, name); }
        Expr::Ref(inner, _) => { return esc_place(self, box_expr_deref(inner)); }
        Expr::Deref(inner) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::FieldAccess(inner, field) => {
            // A tuple field passes its reference through; any other field
            // cannot hold one (rule 2).
            var fr: Vec<EscRoot> = esc_expr(self, box_expr_deref(inner));
            if esc_all_digits(field) { return fr; }
            return esc_none();
        }
        Expr::OptionalFieldAccess(inner, _) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::Index(array, index) => {
            esc_expr(self, box_expr_deref(array));
            esc_expr(self, box_expr_deref(index));
            return esc_none();
        }
        Expr::Binary(_, left, right) => {
            esc_expr(self, box_expr_deref(left));
            esc_expr(self, box_expr_deref(right));
            return esc_none();
        }
        Expr::StrConcat(left, right) => {
            esc_expr(self, box_expr_deref(left));
            esc_expr(self, box_expr_deref(right));
            return esc_none();
        }
        Expr::Range(start, end, _) => {
            esc_expr(self, box_expr_deref(start));
            esc_expr(self, box_expr_deref(end));
            return esc_none();
        }
        Expr::Unary(_, inner) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::IsCheck(inner, _) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::Cast(inner, _) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::QuantCast(inner, _) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::Comptime(inner) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::Yield(inner) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::Await(inner) => { return esc_expr(self, box_expr_deref(inner)); }
        Expr::NamedArg(_, inner) => { return esc_expr(self, box_expr_deref(inner)); }
        Expr::Spawn(inner) => {
            // Everything handed to the task: a call's arguments as well as its result.
            var task: Expr = box_expr_deref(inner);
            var sr: Vec<EscRoot> = esc_expr(self, task);
            match task {
                Expr::Call(_, args) => { sr = esc_union(sr, esc_union_all(esc_exprs(self, args))); }
                Expr::MethodCall(recv, _, margs) => {
                    sr = esc_union(sr, esc_expr(self, box_expr_deref(recv)));
                    sr = esc_union(sr, esc_union_all(esc_exprs(self, margs)));
                }
                _ => {}
            }
            if sr.len() > 0 {
                esc_error(self, "a reference cannot be sent to another task");
            }
            return esc_none();
        }
        Expr::Try(inner) => { return esc_expr(self, box_expr_deref(inner)); }
        Expr::Coalesce(inner, default) => {
            var cr: Vec<EscRoot> = esc_expr(self, box_expr_deref(inner));
            return esc_union(cr, esc_expr(self, box_expr_deref(default)));
        }
        Expr::Call(callee, args) => { return esc_call(self, callee, args); }
        Expr::MethodCall(receiver, method, args) => { return esc_method_call(self, box_expr_deref(receiver), method, args); }
        Expr::PipeForward(left, right) => {
            var pr: Vec<EscRoot> = esc_expr(self, box_expr_deref(left));
            return esc_union(pr, esc_expr(self, box_expr_deref(right)));
        }
        Expr::StructLit(name, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                var init: FieldInit = fields.get(fi);
                var vr: Vec<EscRoot> = esc_expr(self, init.value);
                if vr.len() > 0 {
                    esc_error(self, "a reference cannot be stored in field '" + name + "." + init.name + "'");
                }
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(sp) => { esc_expr(self, box_expr_deref(sp)); }
                OptBoxExpr::None => {}
            }
            return esc_none();
        }
        Expr::EnumLit(enum_name, variant, args) => {
            var rs: Vec<Vec<EscRoot>> = esc_exprs(self, args);
            var joined: Vec<EscRoot> = esc_union_all(rs);
            if esc_is_transparent(enum_name) { return joined; }
            if joined.len() > 0 {
                esc_error(self, "a reference cannot be stored in variant '" + enum_name + "::" + variant + "'");
            }
            return esc_none();
        }
        Expr::TupleLit(items) => { return esc_union_all(esc_exprs(self, items)); }
        Expr::ArrayLit(_, elements) => {
            var ai: i64 = 0;
            while ai < elements.len() {
                var er: Vec<EscRoot> = esc_expr(self, elements.get(ai));
                if er.len() > 0 {
                    esc_error(self, "a reference cannot be stored in an array");
                }
                ai = ai + 1;
            }
            return esc_none();
        }
        Expr::If(cond, then_block, else_block) => {
            esc_expr(self, box_expr_deref(cond));
            var ir: Vec<EscRoot> = esc_block_value(self, then_block, "the value of this `if`");
            match else_block {
                OptStmts::Some(eb) => { ir = esc_union(ir, esc_block_value(self, eb, "the value of this `if`")); }
                OptStmts::None => {}
            }
            return ir;
        }
        Expr::Match(scrut, arms) => {
            var s: Vec<EscRoot> = esc_binding_roots(self, box_expr_deref(scrut));
            return esc_arms(self, arms, s, true);
        }
        Expr::Block(b) => { return esc_block_value(self, b, "the value of this block"); }
        Expr::TryBlock(b) => { return esc_block_value(self, b, "the value of this block"); }
        Expr::Closure(params, body, _) => { return esc_closure(self, params, body); }
        Expr::FString(parts) => {
            var pi: i64 = 0;
            while pi < parts.len() {
                match parts.get(pi) {
                    FStringPart::Expr(x) => { esc_expr(self, x); }
                    FStringPart::Literal(_) => {}
                }
                pi = pi + 1;
            }
            return esc_none();
        }
        _ => { return esc_none(); }
    }
    return esc_none();
}

/// The roots of `&place`.
fn esc_place(self: &mut EscapeChecker, e: Expr) -> Vec<EscRoot> {
    match e {
        // The variable's own storage (for a reference variable `r`, `&r`
        // points at `r` itself, a local).
        Expr::Ident(name) => {
            match esc_lookup(self, name) {
                OptEscVar::Some(v) => { return esc_one(esc_local(name, v.depth)); }
                OptEscVar::None => { return esc_none(); }
            }
        }
        Expr::FieldAccess(inner, _) => { return esc_place_inside(self, box_expr_deref(inner)); }
        Expr::OptionalFieldAccess(inner, _) => { return esc_place_inside(self, box_expr_deref(inner)); }
        Expr::Index(array, index) => {
            esc_expr(self, box_expr_deref(index));
            return esc_place_inside(self, box_expr_deref(array));
        }
        Expr::Deref(inner) => { return esc_expr(self, box_expr_deref(inner)); }
        _ => {
            // `&f()`, `&(a + b)`: a temporary in the current block.
            esc_expr(self, e);
            return esc_one(esc_local("a temporary value", esc_depth(self)));
        }
    }
    return esc_none();
}

/// The roots of a place inside `base` (`base.field`, `base[i]`): when `base`
/// is a reference the place is behind it, otherwise it is part of `base`'s
/// own storage.
fn esc_place_inside(self: &mut EscapeChecker, base: Expr) -> Vec<EscRoot> {
    var through: Vec<EscRoot> = esc_expr(self, base);
    if through.len() == 0 { return esc_place(self, base); }
    return through;
}

fn esc_is_closure(e: Expr) -> bool {
    match e {
        Expr::Closure(_, _, _) => { return true; }
        _ => { return false; }
    }
    return false;
}

fn esc_call(self: &mut EscapeChecker, callee: str, args: Vec<Expr>) -> Vec<EscRoot> {
    var rs: Vec<Vec<EscRoot>> = esc_exprs(self, args);
    if callee == "Some" || callee == "Ok" || callee == "Err" {
        return esc_union_all(rs);
    }
    // Calling a closure held in a local: its result may be any reference it
    // captured or was given.
    match esc_lookup(self, callee) {
        OptEscVar::Some(v) => { return esc_union(v.roots, esc_union_all(rs)); }
        OptEscVar::None => {}
    }
    var slot: i64 = HashMap_get(self.func_index, callee);
    if slot == 0 { return esc_none(); }
    var f: Func = self.all.get(slot - 1).func;
    var i: i64 = 0;
    while i < rs.len() {
        if rs.get(i).len() > 0 && !esc_read_only_call(callee) && i < f.params.len() {
            var p: Param = f.params.get(i);
            if !esc_contains_ref(p.ty) {
                var what: str = "a reference";
                if esc_is_closure(args.get(i)) { what = "a closure that captures a reference"; }
                esc_error(self, what + " cannot be passed to parameter '" + p.name + "' of '" + callee + "' (type '" + type_to_str(p.ty) + "'), which may keep it; only reference parameters can borrow");
            }
        }
        i = i + 1;
    }
    var flows: Vec<i64> = esc_summary(self, callee);
    var out: Vec<EscRoot> = Vec::new();
    var fi: i64 = 0;
    while fi < flows.len() {
        var idx: i64 = flows.get(fi);
        if idx < rs.len() { out = esc_union(out, rs.get(idx)); }
        fi = fi + 1;
    }
    return out;
}

fn esc_method_call(self: &mut EscapeChecker, receiver: Expr, method: str, args: Vec<Expr>) -> Vec<EscRoot> {
    var recv: Vec<EscRoot> = esc_expr(self, receiver);
    var rs: Vec<Vec<EscRoot>> = esc_exprs(self, args);
    var keys: Vec<str> = Vec::new();
    var mslot: i64 = HashMap_get(self.method_index, method);
    if mslot != 0 { keys = self.method_keys.get(mslot - 1); }
    var j: i64 = 0;
    while j < rs.len() {
        if rs.get(j).len() > 0 {
            // Argument j is the method's parameter j + 1 (after `self`).
            var borrows: bool = false;
            var ki: i64 = 0;
            while ki < keys.len() {
                var cand: Func = self.all.get(HashMap_get(self.func_index, keys.get(ki)) - 1).func;
                if j + 1 < cand.params.len() && esc_contains_ref(cand.params.get(j + 1).ty) { borrows = true; }
                ki = ki + 1;
            }
            if !borrows && !esc_read_only_method(method) {
                esc_error(self, "a reference cannot be passed to method '" + method + "', which may keep it");
            }
        }
        j = j + 1;
    }
    var out: Vec<EscRoot> = Vec::new();
    var k: i64 = 0;
    while k < keys.len() {
        var key: str = keys.get(k);
        var f: Func = self.all.get(HashMap_get(self.func_index, key) - 1).func;
        if esc_contains_ref(f.ret_ty) {
            var flows: Vec<i64> = esc_summary(self, key);
            var fi: i64 = 0;
            while fi < flows.len() {
                var idx: i64 = flows.get(fi);
                if idx == 0 {
                    out = esc_union(out, recv);
                } else if idx - 1 < rs.len() {
                    out = esc_union(out, rs.get(idx - 1));
                }
                fi = fi + 1;
            }
        }
        k = k + 1;
    }
    return out;
}

fn esc_closure(self: &mut EscapeChecker, params: Vec<Param>, body: Vec<Stmt>) -> Vec<EscRoot> {
    // Captured references root the closure value (captures are by value).
    var used: Vec<str> = Vec::new();
    esc_idents_stmts(body, used);
    var roots: Vec<EscRoot> = Vec::new();
    var ui: i64 = 0;
    while ui < used.len() {
        var name: str = used.get(ui);
        var is_param: bool = false;
        var pi: i64 = 0;
        while pi < params.len() {
            if params.get(pi).name == name { is_param = true; }
            pi = pi + 1;
        }
        if !is_param {
            roots = esc_union(roots, esc_var_roots(self, name));
        }
        ui = ui + 1;
    }
    // Check the body as its own function: its locals must not escape it.
    var saved_base: i64 = self.closure_base;
    var saved_loops: Vec<i64> = self.loop_depths;
    var no_loops: Vec<i64> = Vec::new();
    self.loop_depths = no_loops;
    esc_push_scope(self);
    self.closure_base = esc_depth(self) - 1;
    var qi: i64 = 0;
    while qi < params.len() {
        var p: Param = params.get(qi);
        esc_check_value_type(self, p.ty, "closure parameter '" + p.name + "'");
        esc_declare(self, p.name, esc_none(), esc_is_ref_type(p.ty));
        qi = qi + 1;
    }
    var tail: Vec<EscRoot> = esc_stmts_value(self, body);
    esc_check_return(self, tail);
    esc_pop_scope(self);
    self.closure_base = saved_base;
    self.loop_depths = saved_loops;
    return roots;
}

// --- Identifiers a closure body reads (a superset of its captures) ---------

fn esc_note(out: Vec<str>, name: str) {
    if !str_vec_contains(out, name) { out.push(name); }
}

fn esc_idents_stmts(stmts: Vec<Stmt>, out: Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        esc_idents_stmt(stmts.get(i), out);
        i = i + 1;
    }
}

fn esc_idents_opt_stmts(stmts: OptStmts, out: Vec<str>) {
    match stmts {
        OptStmts::Some(b) => { esc_idents_stmts(b, out); }
        OptStmts::None => {}
    }
}

fn esc_idents_stmt(s: Stmt, out: Vec<str>) {
    match s {
        Stmt::Let(_, _, expr, _, _, _, _) => { esc_idents_expr(expr, out); }
        Stmt::LetTuple(_, expr, _) => { esc_idents_expr(expr, out); }
        Stmt::Assign(_, _, expr, _) => { esc_idents_expr(expr, out); }
        Stmt::Expr(expr, _) => { esc_idents_expr(expr, out); }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            esc_idents_expr(index, out);
            esc_idents_expr(expr, out);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            esc_idents_expr(ptr_expr, out);
            esc_idents_expr(expr, out);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            esc_idents_expr(object, out);
            esc_idents_expr(expr, out);
        }
        Stmt::Return(value, _) => {
            match value {
                OptBoxExpr::Some(e) => { esc_idents_expr(box_expr_deref(e), out); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::Break(value, _) => {
            match value {
                OptBoxExpr::Some(e) => { esc_idents_expr(box_expr_deref(e), out); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            esc_idents_expr(cond, out);
            esc_idents_stmts(then_block, out);
            esc_idents_opt_stmts(else_block, out);
        }
        Stmt::While(cond, body, _) => {
            esc_idents_expr(cond, out);
            esc_idents_stmts(body, out);
        }
        Stmt::For(_, iterator, body, _) => {
            esc_idents_expr(iterator, out);
            esc_idents_stmts(body, out);
        }
        Stmt::Match(expr, arms, _) => {
            esc_idents_expr(expr, out);
            var ai: i64 = 0;
            while ai < arms.len() {
                esc_idents_stmts(arms.get(ai).body, out);
                ai = ai + 1;
            }
        }
        Stmt::Loop(body, _) => { esc_idents_stmts(body, out); }
        Stmt::Defer(body, _) => { esc_idents_stmts(body, out); }
        Stmt::Unsafe(body, _) => { esc_idents_stmts(body, out); }
        Stmt::Sandbox(body, _) => { esc_idents_stmts(body, out); }
        Stmt::Txn(body, _) => { esc_idents_stmts(body, out); }
        Stmt::Handle(body, _, _) => { esc_idents_stmts(body, out); }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => { esc_idents_stmts(body, out); }
        Stmt::SpawnScope(body, _) => { esc_idents_stmts(body, out); }
        Stmt::Query(_, body, _) => { esc_idents_stmts(body, out); }
        Stmt::GradBlock(_, body, _) => { esc_idents_stmts(body, out); }
        _ => {}
    }
}

fn esc_idents_exprs(es: Vec<Expr>, out: Vec<str>) {
    var i: i64 = 0;
    while i < es.len() {
        esc_idents_expr(es.get(i), out);
        i = i + 1;
    }
}

fn esc_idents_expr(e: Expr, out: Vec<str>) {
    match e {
        Expr::Ident(n) => { esc_note(out, n); }
        Expr::Binary(_, l, r) => {
            esc_idents_expr(box_expr_deref(l), out);
            esc_idents_expr(box_expr_deref(r), out);
        }
        Expr::StrConcat(l, r) => {
            esc_idents_expr(box_expr_deref(l), out);
            esc_idents_expr(box_expr_deref(r), out);
        }
        Expr::PipeForward(l, r) => {
            esc_idents_expr(box_expr_deref(l), out);
            esc_idents_expr(box_expr_deref(r), out);
        }
        Expr::Range(l, r, _) => {
            esc_idents_expr(box_expr_deref(l), out);
            esc_idents_expr(box_expr_deref(r), out);
        }
        Expr::Coalesce(l, r) => {
            esc_idents_expr(box_expr_deref(l), out);
            esc_idents_expr(box_expr_deref(r), out);
        }
        Expr::Index(l, r) => {
            esc_idents_expr(box_expr_deref(l), out);
            esc_idents_expr(box_expr_deref(r), out);
        }
        Expr::Unary(_, x) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::FieldAccess(x, _) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::OptionalFieldAccess(x, _) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::Ref(x, _) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::Deref(x) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::Try(x) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::IsCheck(x, _) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::Cast(x, _) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::QuantCast(x, _) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::Await(x) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::Spawn(x) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::Comptime(x) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::Yield(x) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::NamedArg(_, x) => { esc_idents_expr(box_expr_deref(x), out); }
        Expr::Call(callee, args) => {
            esc_note(out, callee);
            esc_idents_exprs(args, out);
        }
        Expr::MethodCall(recv, _, args) => {
            esc_idents_expr(box_expr_deref(recv), out);
            esc_idents_exprs(args, out);
        }
        Expr::EnumLit(_, _, args) => { esc_idents_exprs(args, out); }
        Expr::TupleLit(args) => { esc_idents_exprs(args, out); }
        Expr::ArrayLit(_, args) => { esc_idents_exprs(args, out); }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                esc_idents_expr(fields.get(fi).value, out);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => { esc_idents_expr(box_expr_deref(s), out); }
                OptBoxExpr::None => {}
            }
        }
        Expr::If(cond, then_block, else_block) => {
            esc_idents_expr(box_expr_deref(cond), out);
            esc_idents_stmts(then_block, out);
            esc_idents_opt_stmts(else_block, out);
        }
        Expr::Match(x, arms) => {
            esc_idents_expr(box_expr_deref(x), out);
            var ai: i64 = 0;
            while ai < arms.len() {
                esc_idents_stmts(arms.get(ai).body, out);
                ai = ai + 1;
            }
        }
        Expr::Block(b) => { esc_idents_stmts(b, out); }
        Expr::TryBlock(b) => { esc_idents_stmts(b, out); }
        Expr::ComptimeBlock(b) => { esc_idents_stmts(b, out); }
        Expr::Closure(_, b, _) => { esc_idents_stmts(b, out); }
        Expr::FString(parts) => {
            var pi: i64 = 0;
            while pi < parts.len() {
                match parts.get(pi) {
                    FStringPart::Expr(x) => { esc_idents_expr(x, out); }
                    FStringPart::Literal(_) => {}
                }
                pi = pi + 1;
            }
        }
        _ => {}
    }
}

// --- Entry point ----------------------------------------------------------

/// Run the escape check over every function of `program`.
pub fn escape_check(program: Program) -> Vec<str> {
    var c: EscapeChecker = EscapeChecker_new(program);
    esc_check_decls(&mut c, program);
    // Infer which parameters reach each function's result, to a fixpoint.
    // Summaries only grow, so an unchanged total means nothing changed.
    var before: i64 = -1;
    while before != esc_summary_total(&c) {
        before = esc_summary_total(&c);
        var i: i64 = 0;
        while i < c.all.len() {
            var ef: EscFunc = c.all.get(i);
            esc_analyze_func(&mut c, ef.key, ef.func);
            i = i + 1;
        }
    }
    c.report = true;
    var j: i64 = 0;
    while j < c.all.len() {
        var ef2: EscFunc = c.all.get(j);
        esc_analyze_func(&mut c, ef2.key, ef2.func);
        j = j + 1;
    }
    return c.errors;
}
