// escape.fd -- Reference escape check, rewritten from src/escape.rs
//
// References are second-class values: they may be passed to calls, held in
// locals and returned when they come from one of the function's reference
// parameters, but never kept anywhere they could outlive what they point to.
// src/escape.rs lists the rules; docs/reference/language-guide.md §4.6 explains the
// design. Runs after type checking.
//
// Adaptations from Rust:
// 1. BTreeSet<Root> -> sorted Vec<EscRoot>, in the order Rust derives
// 2. HashMap<String, _> -> core HashMap (str -> index + 1) over Vecs
// 3. Box<Expr>/Box<Type> -> box_expr_deref / box_type_unbox
//
// Dependencies: compiler::ast

module compiler::escape;
use core;
use vec;
use string;
use compiler::ast;
/// What a reference-holding value points into: a local variable (or
/// by-value parameter) declared at block depth `depth`, or the function's
/// `index`-th parameter, a reference the caller supplied.
pub struct EscRoot {
    pub is_param: bool,
    pub name: str,
    pub depth: i64,
    pub index: i64,
}

pub struct EscVar {
    pub name: str,
    pub depth: i64,
    pub roots: Vec<EscRoot>,
    // The value is itself a reference (rather than an Option, Result or
    // tuple holding one): what it points to holds no reference (rule 2).
    pub is_ref: bool,
    // The value is a function whose declared result holds no reference
    // (`fn(&S) -> i64`, or a named function returning i64/bool/str/a
    // struct): calling it gives no reference back, whatever it was passed
    // or captured (bugs 15/33/39/48).
    pub fn_noref: bool,
}

pub enum OptEscVar {
    Some(EscVar),
    None,
}

/// A function body with the name it is called by (`Type_method` for methods).
pub struct EscFunc {
    pub key: str,
    pub skey: str,
    // skip-set key ("fn:n" / "impl:s:m" / "trait:t:m")
    pub func: Func,
}

pub struct EscapeChecker {
    pub all: Vec<EscFunc>,
    pub func_index: i64,
    // HashMap: key -> index + 1 into all
    pub method_index: i64,
    // HashMap: method name -> index + 1 into method_keys
    pub method_keys: Vec<Vec<str>>,
    pub globals: i64,
    // HashMap: global or const name -> 1
    pub summary_index: i64,
    // HashMap: key -> index + 1 into summaries
    pub summaries: Vec<Vec<i64>>,
    pub scopes: Vec<Vec<EscVar>>,
    pub func_name: str,
    pub flows: Vec<i64>,
    pub loop_depths: Vec<i64>,
    pub closure_base: i64,
    pub unsafe_depth: i64,
    pub line: i64,
    pub report: bool,
    pub errors: Vec<str>,
    pub type_names: i64,
    // HashMap: declared struct or enum name -> 1
    // Facts about each function of `all`, computed once (release D8: the
    // method-call check copied a whole Func per candidate method)
    pub ret_has_ref: Vec<bool>,
    // esc_contains_ref(ret_ty)
    pub ret_is_ref: Vec<bool>,
    // esc_is_ref_type(ret_ty)
    pub param_has_ref: Vec<Vec<bool>>,  // esc_contains_ref(params[j].ty)
    // LG3: a function whose result names lifetimes (`-> &'a T`): its result
    // borrows from exactly the parameters carrying one of them. Declared
    // flows replace the inferred summary, and a body returning a borrow of
    // another parameter is an error.
    pub has_decl_flows: Vec<bool>,
    pub decl_flows: Vec<Vec<i64>>,
    // CS5: what a call needs of its callee's parameters, so no analysis
    // copies another function's Func (a parallel worker must not touch
    // what another worker's function owns): each parameter's name, and
    // whether the lowering reads a value through it (esc_read_through).
    pub param_names: Vec<Vec<str>>,
    pub param_rt: Vec<Vec<bool>>,
    // CS5: a worker of the parallel reporting pass (esc_par_worker): `all`
    // is empty, and the type of a callee's parameter an error names comes
    // from param_tys (filled only in a worker's copy)
    pub par: bool,
    pub param_tys: Vec<Vec<str>>,
    // esc_ret_noref(ret_ty) per function: a call of it returns no reference
    pub ret_noref: Vec<bool>,
}

// --- Root sets ------------------------------------------------------------

fn esc_local(name: str, depth: i64) -> EscRoot {
    return EscRoot {
        is_param: false, name: name, depth: depth, index: 0
    };
}

fn esc_param(index: i64) -> EscRoot {
    return EscRoot {
        is_param: true, name: "", depth: 0, index: index
    };
}

// Rust's derived order: every Local before every Param; Locals by name, then
// depth; Params by index.
fn esc_root_cmp(a: EscRoot, b: EscRoot) -> i64 {
    if a.is_param != b.is_param {
        if a.is_param {
            return 1;
        }
        return -1;
    }
    if a.is_param {
        return a.index - b.index;
    }
    var c: i64 = str_compare(a.name, b.name);
    if c != 0 {
        return c;
    }
    return a.depth - b.depth;
}

// A new set with `r` added. Sets are small sorted Vecs, never changed in
// place (a Vec value is a shared handle).
fn esc_with(rs: Vec<EscRoot>, r: EscRoot) -> Vec<EscRoot> {
    var out: Vec<EscRoot> = Vec::new();
    var placed: bool = false;
    var i: i64 = 0;
    while i < rs.len() {
        var x: EscRoot = rs.get(i);
        if !placed {
            var c: i64 = esc_root_cmp(r, x);
            if c == 0 {
                placed = true;
            } else if c < 0 {
                out.push(r);
                placed = true;
            }
        }
        out.push(x);
        i = i + 1;
    }
    if !placed {
        out.push(r);
    }
    return out;
}

fn esc_union(a: Vec<EscRoot>, b: Vec<EscRoot>) -> Vec<EscRoot> {
    // Root sets are never changed in place, so an empty side shares the
    // other (most sets are empty; this avoids most allocations).
    if b.len() == 0 {
        return a;
    }
    if a.len() == 0 {
        return b;
    }
    var out: Vec<EscRoot> = Vec::new();
    var i: i64 = 0;
    while i < a.len() {
        out.push(a.get(i));
        i = i + 1;
    }
    var j: i64 = 0;
    while j < b.len() {
        out = esc_with(out, b.get(j));
        j = j + 1;
    }
    return out;
}

fn esc_one(r: EscRoot) -> Vec<EscRoot> {
    var out: Vec<EscRoot> = Vec::new();
    out.push(r);
    return out;
}

fn esc_none() -> Vec<EscRoot> {
    return Vec::new();
}

// --- Types ----------------------------------------------------------------

/// `Option`, `Result` and tuples pass a reference through without storing it.
fn esc_is_transparent(name: str) -> bool {
    return name == "Option" || name == "Result";
}

// LG3: structs with lifetime parameters (`struct View<'a> { r: &'a i64 }`)
// hold references the way Option and tuples do: a value of one is rooted
// where its references point (its literal's fields), may be held in a
// local, passed and returned like a reference, and is never stored.
// Struct name -> 1, and the name of each of their fields that holds a
// reference -> 1 (`v.r` reads one). Built by EscapeChecker_new; the
// parallel workers only read them.
var g_esc_lt_structs: i64 = 0;
var g_esc_lt_fields: i64 = 0;

fn esc_is_lt_struct(name: str) -> bool {
    return g_esc_lt_structs != 0 && HashMap_get(g_esc_lt_structs, name) != 0;
}

fn esc_lt_struct_type(t: Type) -> bool {
    match t {
        Type::Named(n) => {
            return esc_is_lt_struct(n);
        }
        Type::Generic(gn, _) => {
            return esc_is_lt_struct(gn);
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// The variable `e` names, or "".
fn esc_ident_of(e: Expr) -> str {
    match e {
        Expr::Ident(n) => {
            return n;
        }
        _ => {
            return "";
        }
    }
    return "";
}

fn esc_is_lt_field(name: str) -> bool {
    return g_esc_lt_fields != 0 && HashMap_get(g_esc_lt_fields, name) != 0;
}

fn esc_collect_lt_structs(program: Program) {
    if g_esc_lt_structs == 0 {
        g_esc_lt_structs = HashMap_new();
        g_esc_lt_fields = HashMap_new();
    } else {
        HashMap_clear(g_esc_lt_structs);
        HashMap_clear(g_esc_lt_fields);
    }
    var si: i64 = 0;
    while si < program.structs.len() {
        var s: StructDef = program.structs.get(si);
        if ann_lifetimes(s.annotations).len() > 0 {
            HashMap_insert(g_esc_lt_structs, s.name, 1);
        }
        si = si + 1;
    }
    // fields after every struct is known: a field may be another such struct
    var sj: i64 = 0;
    while sj < program.structs.len() {
        var s2: StructDef = program.structs.get(sj);
        if esc_is_lt_struct(s2.name) {
            var fi: i64 = 0;
            while fi < s2.fields.len() {
                if esc_contains_ref(s2.fields.get(fi).ty) {
                    HashMap_insert(g_esc_lt_fields, s2.fields.get(fi).name, 1);
                }
                fi = fi + 1;
            }
        }
        sj = sj + 1;
    }
}

/// Whether `t` holds a reference anywhere (function types do not hold their
/// parameters' or result's references).
pub fn esc_contains_ref(t: Type) -> bool {
    match t {
        Type::Ref(_, _) => {
            return true;
        }
        Type::Named(sn) => {
            // LG3: a struct with lifetime parameters holds references
            return esc_is_lt_struct(sn);
        }
        Type::Generic(gn, args) => {
            if esc_is_lt_struct(gn) {
                return true;
            }
            return esc_any_ref(args);
        }
        Type::Tuple(args) => {
            return esc_any_ref(args);
        }
        Type::Array(e, _) => {
            return esc_contains_ref(box_type_unbox(e));
        }
        Type::ArrayConst(e, _) => {
            return esc_contains_ref(box_type_unbox(e));
        }
        Type::ShapedTensor(e, _) => {
            return esc_contains_ref(box_type_unbox(e));
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn esc_any_ref(ts: Vec<Type>) -> bool {
    var i: i64 = 0;
    while i < ts.len() {
        if esc_contains_ref(ts.get(i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn esc_all_digits(s: str) -> bool {
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c < 48 || c > 57 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Read-only builtins that may be handed a reference.
fn esc_read_only_call(name: str) -> bool {
    return name == "print" || name == "println" || name == "eprint" || name == "eprintln" || name == "assert" || name == "assert_eq" || name == "format" || name == "panic" || name == "debug";
}

fn esc_read_only_method(name: str) -> bool {
    // extend copies its argument's elements (a reference cannot be one):
    // it keeps nothing of it (stdlib-agent-bugs 8)
    return name == "extend" || name == "contains_key" || name == "contains" || name == "starts_with" || name == "ends_with" || name == "find" || name == "index_of" || name == "eq" || name == "equals" || name == "cmp" || name == "compare" || name == "len" || name == "get";
}

// --- Setup ----------------------------------------------------------------

pub fn EscapeChecker_new(program: Program) -> EscapeChecker {
    // LG3: first, so the facts below see which types hold references
    esc_collect_lt_structs(program);
    var all: Vec<EscFunc> = Vec::new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        var f: Func = program.funcs.get(i);
        all.push(EscFunc {
            key: f.name, skey: "fn:" + f.name, func: f
        });
        i = i + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var m: Func = imp.methods.get(mi);
            all.push(EscFunc {
                key: imp.struct_name + "_" + m.name, skey: "impl:" + imp.struct_name + ":" + m.name, func: m
            });
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var ti: i64 = 0;
    while ti < program.trait_impls.len() {
        var timp: TraitImpl = program.trait_impls.get(ti);
        var tmi: i64 = 0;
        while tmi < timp.methods.len() {
            var tm: Func = timp.methods.get(tmi);
            all.push(EscFunc {
                key: timp.type_name + "_" + tm.name, skey: "trait:" + timp.type_name + ":" + tm.name, func: tm
            });
            tmi = tmi + 1;
        }
        ti = ti + 1;
    }
    var func_index: i64 = HashMap_new();
    var method_index: i64 = HashMap_new();
    var method_keys: Vec<Vec<str>> = Vec::new();
    var k: i64 = 0;
    while k < all.len() {
        var key: str = all.get(k).key;
        if HashMap_get(func_index, key) == 0 {
            HashMap_insert(func_index, key, k + 1);
        }
        // `Type_method` is callable as `.method()`; the type name may itself
        // contain underscores, so register every suffix.
        var p: i64 = 0;
        while p < str_len(key) {
            if str_byte_at(key, p) == 95 {
                var suffix: str = str_slice(key, p + 1, str_len(key));
                var slot: i64 = HashMap_get(method_index, suffix);
                if slot == 0 {
                    method_keys.push(Vec::new());
                    slot = method_keys.len();
                    HashMap_insert(method_index, suffix, slot);
                }
                method_keys.get(slot - 1).push(key);
            }
            p = p + 1;
        }
        k = k + 1;
    }
    var globals: i64 = HashMap_new();
    var gi: i64 = 0;
    while gi < program.globals.len() {
        HashMap_insert(globals, program.globals.get(gi).name, 1);
        gi = gi + 1;
    }
    var ci: i64 = 0;
    while ci < program.consts.len() {
        HashMap_insert(globals, program.consts.get(ci).name, 1);
        ci = ci + 1;
    }
    // Declared types: a struct or enum cannot hold a reference (rule 2), so
    // a function returning one has no parameter reaching its result
    var type_names: i64 = HashMap_new();
    var si: i64 = 0;
    while si < program.structs.len() {
        HashMap_insert(type_names, program.structs.get(si).name, 1);
        si = si + 1;
    }
    var ei: i64 = 0;
    while ei < program.enums.len() {
        HashMap_insert(type_names, program.enums.get(ei).name, 1);
        ei = ei + 1;
    }
    var ret_has_ref: Vec<bool> = Vec::new();
    var ret_is_ref: Vec<bool> = Vec::new();
    var param_has_ref: Vec<Vec<bool>> = Vec::new();
    var has_decl_flows: Vec<bool> = Vec::new();
    var decl_flows: Vec<Vec<i64>> = Vec::new();
    var param_names: Vec<Vec<str>> = Vec::new();
    var param_rt: Vec<Vec<bool>> = Vec::new();
    var fk: i64 = 0;
    while fk < all.len() {
        var ff: Func = all.get(fk).func;
        ret_has_ref.push(esc_contains_ref(ff.ret_ty));
        ret_is_ref.push(esc_is_ref_type(ff.ret_ty));
        has_decl_flows.push(func_has_lifetimes(ff));
        decl_flows.push(func_lifetime_ties(ff));
        var pr: Vec<bool> = Vec::new();
        var pn: Vec<str> = Vec::new();
        var prt: Vec<bool> = Vec::new();
        var pj: i64 = 0;
        while pj < ff.params.len() {
            var pp: Param = ff.params.get(pj);
            pr.push(esc_contains_ref(pp.ty));
            pn.push(pp.name);
            prt.push(esc_reads_through_type(pp.ty));
            pj = pj + 1;
        }
        param_has_ref.push(pr);
        param_names.push(pn);
        param_rt.push(prt);
        fk = fk + 1;
    }
    var c: EscapeChecker = EscapeChecker {
        ret_noref: Vec::new(), param_names: param_names, param_rt: param_rt, par: false, param_tys: Vec::new(), ret_has_ref: ret_has_ref, ret_is_ref: ret_is_ref, param_has_ref: param_has_ref, has_decl_flows: has_decl_flows, decl_flows: decl_flows, all: all, func_index: func_index, method_index: method_index, method_keys: method_keys, globals: globals, summary_index: HashMap_new(), summaries: Vec::new(), scopes: Vec::new(), func_name: "", flows: Vec::new(), loop_depths: Vec::new(), closure_base: 0, unsafe_depth: 0, line: 0, report: false, errors: Vec::new(), type_names: type_names,
    };
    var rk: i64 = 0;
    while rk < c.all.len() {
        var rn: bool = esc_ret_noref(&c, c.all.get(rk).func.ret_ty);
        c.ret_noref.push(rn);
        rk = rk + 1;
    }
    return c;
}

/// A result type no reference can be in: a scalar, str, void, or a
/// declared struct or enum (not a type parameter, which a call could make
/// a reference). Such a function's summary is always empty (CS3).
fn esc_ret_noref(self: &EscapeChecker, t: Type) -> bool {
    match t {
        Type::I8 => {
            return true;
        }
        Type::I16 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        Type::I64 => {
            return true;
        }
        Type::I128 => {
            return true;
        }
        Type::U8 => {
            return true;
        }
        Type::U16 => {
            return true;
        }
        Type::U32 => {
            return true;
        }
        Type::U64 => {
            return true;
        }
        Type::U128 => {
            return true;
        }
        Type::F32 => {
            return true;
        }
        Type::F64 => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        Type::Str => {
            return true;
        }
        Type::Void => {
            return true;
        }
        Type::Never => {
            return true;
        }
        Type::Named(n) => {
            // LG3: a struct with lifetime parameters holds references
            return HashMap_get(self.type_names, n) != 0 && !esc_is_lt_struct(n);
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// A function type whose declared result holds no reference
/// (`fn(&S) -> i64`): calling a value of it gives no reference back.
fn esc_fn_ret_noref(self: &EscapeChecker, t: Type) -> bool {
    match t {
        Type::Func(_, ret) => {
            return esc_ret_noref(self, box_type_unbox(ret));
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// For a local declared without a type: whether its initializer is a
/// function value whose result holds no reference (a named function
/// returning one of esc_ret_noref's types, a closure declaring such a
/// result, or another such local).
fn esc_expr_fn_noref(self: &EscapeChecker, e: Expr) -> bool {
    match e {
        Expr::Ident(name) => {
            match esc_lookup(self, name) {
                OptEscVar::Some(v) => {
                    return v.fn_noref;
                }
                OptEscVar::None => {
                }
            }
            var slot: i64 = HashMap_get(self.func_index, name);
            if slot == 0 {
                return false;
            }
            return self.ret_noref.get(slot - 1);
        }
        Expr::Closure(_, _, rt) => {
            match rt {
                OptType::Some(t) => {
                    return esc_ret_noref(self, t);
                }
                OptType::None => {
                    return false;
                }
            }
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// A `&mut`/`&` parameter holding a Vec, HashMap or str, given to a value
/// parameter: the lowering reads the value through it, so the callee gets a
/// value, not the reference (as src/escape.rs read_through).
fn esc_read_through(self: &EscapeChecker, arg: Expr) -> bool {
    var n: str = "";
    match arg {
        Expr::Ident(name) => {
            n = name;
        }
        _ => {
            return false;
        }
    }
    var slot: i64 = HashMap_get(self.func_index, self.func_name);
    if slot == 0 {
        return false;
    }
    // CS5: from the tables EscapeChecker_new made (the first parameter so
    // named decides), not from a copy of the Func
    var names: Vec<str> = self.param_names.get(slot - 1);
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == n {
            return self.param_rt.get(slot - 1).get(i);
        }
        i = i + 1;
    }
    return false;
}

/// A parameter of this type is read through by the lowering when given to
/// a value parameter: `&Vec`, `&HashMap` or `&str` (esc_read_through).
fn esc_reads_through_type(t: Type) -> bool {
    match t {
        Type::Ref(inner, _) => {
            match box_type_unbox(inner) {
                Type::Generic(gn, _) => {
                    return gn == "Vec" || gn == "HashMap";
                }
                Type::Named(nn) => {
                    return nn == "Vec" || nn == "HashMap";
                }
                Type::Str => {
                    return true;
                }
                _ => {
                    return false;
                }
            }
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn esc_error(self: &mut EscapeChecker, msg: str) {
    if self.report && self.unsafe_depth == 0 {
        var full: str = "Reference error (line " + int_to_str(self.line) + "): in '" + self.func_name + "', " + msg;
        if !str_vec_contains(self.errors, full) {
            self.errors.push(full);
        }
    }
}

fn esc_is_global(self: &EscapeChecker, name: str) -> bool {
    return HashMap_get(self.globals, name) != 0;
}

fn esc_summary(self: &EscapeChecker, key: str) -> Vec<i64> {
    var slot: i64 = HashMap_get(self.summary_index, key);
    if slot == 0 {
        return Vec::new();
    }
    return self.summaries.get(slot - 1);
}

fn esc_set_summary(self: &mut EscapeChecker, key: str, flows: Vec<i64>) {
    var slot: i64 = HashMap_get(self.summary_index, key);
    if slot == 0 {
        self.summaries.push(flows);
        HashMap_insert(self.summary_index, key, self.summaries.len());
    } else {
        self.summaries.set(slot - 1, flows);
    }
}

fn esc_summary_total(self: &EscapeChecker) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < self.summaries.len() {
        n = n + self.summaries.get(i).len();
        i = i + 1;
    }
    return n;
}

// --- Types ----------------------------------------------------------------

/// A parameter, local or return type: a reference may sit at the top or
/// inside Option/Result/tuples, never inside storage.
fn esc_check_value_type(self: &mut EscapeChecker, t: Type, what: str) {
    match t {
        Type::Ref(inner, ref_mut) => {
            var pointee: Type = box_type_unbox(inner);
            // LG3: `&View` reads a struct holding references (a value of
            // it is rooted where they point); `&mut View` could store a
            // shorter-lived reference into the caller's struct
            if !ref_mut && esc_lt_struct_type(pointee) {
                return;
            }
            if esc_contains_ref(pointee) {
                esc_error(self, what + " has type '" + type_to_str(t) + "': a reference cannot point to another reference");
            }
        }
        Type::Generic(name, args) => {
            // LG3: a struct with lifetime parameters is held like a
            // reference; its type arguments are checked as its fields are
            if esc_is_transparent(name) || esc_is_lt_struct(name) {
                var i: i64 = 0;
                while i < args.len() {
                    esc_check_value_type(self, args.get(i), what);
                    i = i + 1;
                }
            } else {
                esc_check_storage_type(self, t, what);
            }
        }
        Type::Named(sn) => {
            if !esc_is_lt_struct(sn) {
                esc_check_storage_type(self, t, what);
            }
        }
        Type::Tuple(args) => {
            var j: i64 = 0;
            while j < args.len() {
                esc_check_value_type(self, args.get(j), what);
                j = j + 1;
            }
        }
        _ => {
            esc_check_storage_type(self, t, what);
        }
    }
}

fn esc_check_storage_type(self: &mut EscapeChecker, t: Type, what: str) {
    if esc_contains_ref(t) {
        esc_error(self, what + " has type '" + type_to_str(t) + "', which stores a reference; references can only be passed to calls, held in locals and returned");
    }
}

fn esc_check_decls(self: &mut EscapeChecker, program: Program) {
    self.report = true;
    var si: i64 = 0;
    while si < program.structs.len() {
        var s: StructDef = program.structs.get(si);
        self.func_name = s.name;
        self.line = 0;
        var fi: i64 = 0;
        while fi < s.fields.len() {
            var fld: Param = s.fields.get(fi);
            if esc_is_lt_struct(s.name) {
                // LG3: a struct with lifetime parameters may hold a
                // reference (or another such struct) where a local could;
                // never a Vec of them or a reference to a reference
                esc_check_value_type(self, fld.ty, "field '" + s.name + "." + fld.name + "'");
            } else if esc_contains_ref(fld.ty) {
                esc_error(self, "field '" + s.name + "." + fld.name + "' has type '" + type_to_str(fld.ty) + "', which stores a reference; references can only be passed to calls, held in locals and returned; to hold one, give the struct a lifetime parameter: `struct " + s.name + "<'a> { " + fld.name + ": &'a T }`");
            }
            fi = fi + 1;
        }
        si = si + 1;
    }
    var ei: i64 = 0;
    while ei < program.enums.len() {
        var en: EnumDef = program.enums.get(ei);
        self.func_name = en.name;
        self.line = 0;
        var vi: i64 = 0;
        while vi < en.variants.len() {
            var v: EnumVariant = en.variants.get(vi);
            match v.data {
                OptParams::Some(ps) => {
                    var pi: i64 = 0;
                    while pi < ps.len() {
                        esc_check_storage_type(self, ps.get(pi).ty, "variant '" + en.name + "::" + v.name + "'");
                        pi = pi + 1;
                    }
                }
                OptParams::None => {
                }
            }
            vi = vi + 1;
        }
        ei = ei + 1;
    }
    var gi: i64 = 0;
    while gi < program.globals.len() {
        var g: GlobalVar = program.globals.get(gi);
        self.func_name = g.name;
        self.line = 0;
        esc_check_storage_type(self, g.ty, "global '" + g.name + "'");
        gi = gi + 1;
    }
    self.report = false;
}

// --- Scopes ---------------------------------------------------------------

fn esc_depth(self: &EscapeChecker) -> i64 {
    return self.scopes.len();
}

fn esc_push_scope(self: &mut EscapeChecker) {
    self.scopes.push(Vec::new());
}

fn esc_pop_scope(self: &mut EscapeChecker) {
    self.scopes.pop();
}

fn esc_declare(self: &mut EscapeChecker, name: str, roots: Vec<EscRoot>, is_ref: bool) {
    esc_declare_fn(self, name, roots, is_ref, false);
}

/// esc_declare, saying whether the variable is a function value whose
/// result holds no reference (EscVar.fn_noref).
fn esc_declare_fn(self: &mut EscapeChecker, name: str, roots: Vec<EscRoot>, is_ref: bool, fn_noref: bool) {
    var last: i64 = self.scopes.len() - 1;
    // A redeclaration in the same block shadows the earlier one.
    // SP12: the block's list is read in place. A copy of it held here made
    // the push below copy the whole list (two owners), once per variable:
    // quadratic in a block's variables.
    var i: i64 = 0;
    while i < self.scopes.get(last).len() {
        if self.scopes.get(last).get(i).name == name {
            self.scopes.get(last).set(i, EscVar {
                name: name, depth: self.scopes.len(), roots: roots, is_ref: is_ref, fn_noref: fn_noref
            });
            return;
        }
        i = i + 1;
    }
    self.scopes.get(last).push(EscVar {
        name: name, depth: self.scopes.len(), roots: roots, is_ref: is_ref, fn_noref: fn_noref
    });
}

fn esc_is_ref_type(t: Type) -> bool {
    match t {
        Type::Ref(_, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// Whether `e` evaluates to a reference itself (so a `match` on it binds
/// plain payload values, which hold no reference).
fn esc_is_reference(self: &EscapeChecker, e: Expr) -> bool {
    match e {
        Expr::Ref(_, _) => {
            return true;
        }
        Expr::Ident(name) => {
            match esc_lookup(self, name) {
                OptEscVar::Some(v) => {
                    return v.is_ref;
                }
                OptEscVar::None => {
                    return false;
                }
            }
        }
        Expr::Call(callee, _) => {
            var slot: i64 = HashMap_get(self.func_index, callee);
            if slot == 0 {
                return false;
            }
            return self.ret_is_ref.get(slot - 1);
        }
        Expr::MethodCall(_, method, _) => {
            var mslot: i64 = HashMap_get(self.method_index, method);
            if mslot == 0 {
                return false;
            }
            var keys: Vec<str> = self.method_keys.get(mslot - 1);
            if keys.len() == 0 {
                return false;
            }
            var k: i64 = 0;
            while k < keys.len() {
                if !self.ret_is_ref.get(HashMap_get(self.func_index, keys.get(k)) - 1) {
                    return false;
                }
                k = k + 1;
            }
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// The roots a `match` on `e` passes to its bindings.
fn esc_binding_roots(self: &mut EscapeChecker, e: Expr) -> Vec<EscRoot> {
    var r: Vec<EscRoot> = esc_expr(self, e);
    if esc_is_reference(self, e) {
        return esc_none();
    }
    return r;
}

fn esc_lookup(self: &EscapeChecker, name: str) -> OptEscVar {
    var s: i64 = self.scopes.len() - 1;
    while s >= 0 {
        var scope: Vec<EscVar> = self.scopes.get(s);
        // SP12: names compared in place, only the one found copied (the
        // first match from the start, as before)
        var at: i64 = -1;
        var k: i64 = 0;
        while k < scope.len() && at < 0 {
            if scope.get(k).name == name {
                at = k;
            }
            k = k + 1;
        }
        if at >= 0 {
            return OptEscVar::Some(scope.get(at));
        }
        s = s - 1;
    }
    return OptEscVar::None;
}

fn esc_var_roots(self: &EscapeChecker, name: str) -> Vec<EscRoot> {
    match esc_lookup(self, name) {
        OptEscVar::Some(v) => {
            return v.roots;
        }
        OptEscVar::None => {
            return esc_none();
        }
    }
    return esc_none();
}

// Add `extra` to the roots of the innermost variable called `name`.
fn esc_add_roots(self: &mut EscapeChecker, name: str, extra: Vec<EscRoot>) {
    var s: i64 = self.scopes.len() - 1;
    while s >= 0 {
        var i: i64 = 0;
        // SP12: no copy of the block's list is held (the set below would
        // copy the whole list) and only the variable found is copied
        while i < self.scopes.get(s).len() {
            if self.scopes.get(s).get(i).name == name {
                var v: EscVar = self.scopes.get(s).get(i);
                self.scopes.get(s).set(i, EscVar {
                    name: v.name, depth: v.depth, roots: esc_union(v.roots, extra), is_ref: v.is_ref, fn_noref: v.fn_noref
                });
                return;
            }
            i = i + 1;
        }
        s = s - 1;
    }
}

/// Drop the roots that point into blocks deeper than `depth`, reporting each
/// one: a value leaving those blocks would dangle.
fn esc_leave_blocks(self: &mut EscapeChecker, roots: Vec<EscRoot>, depth: i64, what: str) -> Vec<EscRoot> {
    var kept: Vec<EscRoot> = Vec::new();
    var i: i64 = 0;
    while i < roots.len() {
        var r: EscRoot = roots.get(i);
        if !r.is_param && r.depth > depth {
            esc_error(self, what + " refers to '" + r.name + "', which is freed at the end of its block");
        } else {
            kept.push(r);
        }
        i = i + 1;
    }
    return kept;
}

// --- Functions ------------------------------------------------------------

fn esc_analyze_func(self: &mut EscapeChecker, key: str, f: Func) {
    self.func_name = f.name;
    // TL2: what is reported before its first statement (a parameter's
    // type) is placed at its `fn`, not at "line 0"
    self.line = f.line;
    var no_flows: Vec<i64> = Vec::new();
    var no_scopes: Vec<Vec<EscVar>> = Vec::new();
    var no_loops: Vec<i64> = Vec::new();
    self.flows = no_flows;
    self.scopes = no_scopes;
    esc_push_scope(self);
    self.loop_depths = no_loops;
    self.closure_base = 0;
    self.unsafe_depth = 0;
    var i: i64 = 0;
    while i < f.params.len() {
        var p: Param = f.params.get(i);
        esc_check_value_type(self, p.ty, "parameter '" + p.name + "'");
        if esc_contains_ref(p.ty) {
            esc_declare(self, p.name, esc_one(esc_param(i)), esc_is_ref_type(p.ty));
        } else {
            esc_declare_fn(self, p.name, esc_none(), false, esc_fn_ret_noref(self, p.ty));
        }
        i = i + 1;
    }
    esc_check_value_type(self, f.ret_ty, "the return type");
    var is_void: bool = false;
    match f.ret_ty {
        Type::Void => {
            is_void = true;
        }
        _ => {
        }
    }
    if is_void {
        var si: i64 = 0;
        while si < f.body.len() {
            esc_stmt(self, f.body.get(si));
            si = si + 1;
        }
    } else {
        var tail: Vec<EscRoot> = esc_stmts_value(self, f.body);
        esc_check_return(self, tail);
    }
    // LG3: a signature naming the result's lifetimes is the summary callers
    // see; the body may return borrows of those parameters only
    var fslot: i64 = HashMap_get(self.func_index, key);
    if fslot > 0 && self.has_decl_flows.get(fslot - 1) {
        var declared: Vec<i64> = self.decl_flows.get(fslot - 1);
        var ret_lts: Vec<str> = ann_lifetimes(f.annotations);
        var lt_list: str = "";
        var li: i64 = 0;
        while li < ret_lts.len() {
            if li > 0 {
                lt_list = lt_list + ", ";
            }
            lt_list = lt_list + ret_lts.get(li);
            li = li + 1;
        }
        var di: i64 = 0;
        while di < self.flows.len() {
            var pidx: i64 = self.flows.get(di);
            if !vec_contains_i64(declared, pidx) && pidx < f.params.len() {
                esc_error(self, "'" + f.name + "' returns a borrow of parameter '" + f.params.get(pidx).name + "', but its signature ties the result to " + lt_list + "; give '" + f.params.get(pidx).name + "' that lifetime or return a borrow of a parameter that has it");
            }
            di = di + 1;
        }
        if !self.report {
            esc_set_summary(self, key, declared);
        }
        return;
    }
    // CS5: the reporting pass reads the summaries the fixpoint found and
    // changes none. A function the fixpoint did not analyze (its result
    // holds no reference) keeps the empty summary it had there, whatever
    // order the reporting pass takes: the order of the functions, or a
    // chunk per parallel worker, cannot change what a call sees.
    if !self.report {
        esc_set_summary(self, key, self.flows);
    }
}

fn esc_check_return(self: &mut EscapeChecker, roots: Vec<EscRoot>) {
    var i: i64 = 0;
    while i < roots.len() {
        var r: EscRoot = roots.get(i);
        if r.is_param {
            if self.closure_base == 0 && !vec_contains_i64(self.flows, r.index) {
                self.flows = esc_sorted_insert_i64(self.flows, r.index);
            }
        } else if r.depth > self.closure_base {
            var what: str = "a closure";
            if self.closure_base == 0 {
                what = "'" + self.func_name + "'";
            }
            esc_error(self, what + " returns a reference to local '" + r.name + "', which is freed when it returns");
        }
        i = i + 1;
    }
}

fn esc_sorted_insert_i64(v: Vec<i64>, x: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var placed: bool = false;
    var i: i64 = 0;
    while i < v.len() {
        var y: i64 = v.get(i);
        if !placed && x < y {
            out.push(x);
            placed = true;
        }
        out.push(y);
        i = i + 1;
    }
    if !placed {
        out.push(x);
    }
    return out;
}

// --- Statements -----------------------------------------------------------

/// Process `stmts` in the current scope and return the roots of their value
/// (the last statement's, when it is an expression or a branch).
fn esc_stmts_value(self: &mut EscapeChecker, stmts: Vec<Stmt>) -> Vec<EscRoot> {
    var n: i64 = stmts.len();
    if n == 0 {
        return esc_none();
    }
    var i: i64 = 0;
    while i < n - 1 {
        esc_stmt(self, stmts.get(i));
        i = i + 1;
    }
    return esc_stmt_value(self, stmts.get(n - 1));
}

fn esc_stmt_value(self: &mut EscapeChecker, s: Stmt) -> Vec<EscRoot> {
    self.line = stmt_line(s);
    match s {
        Stmt::Expr(e, _) => {
            return esc_expr(self, e);
        }
        Stmt::If(cond, then_block, else_block, _) => {
            esc_expr(self, cond);
            var r: Vec<EscRoot> = esc_block_value(self, then_block, "the value of this branch");
            match else_block {
                OptStmts::Some(eb) => {
                    r = esc_union(r, esc_block_value(self, eb, "the value of this branch"));
                }
                OptStmts::None => {
                }
            }
            return r;
        }
        Stmt::Match(expr, arms, _) => {
            var scrutinee: Vec<EscRoot> = esc_binding_roots(self, expr);
            return esc_arms(self, arms, scrutinee, true);
        }
        Stmt::Unsafe(body, _) => {
            self.unsafe_depth = self.unsafe_depth + 1;
            var ur: Vec<EscRoot> = esc_block_value(self, body, "the value of this block");
            self.unsafe_depth = self.unsafe_depth - 1;
            return ur;
        }
        Stmt::Sandbox(body, _) => {
            return esc_block_value(self, body, "the value of this block");
        }
        Stmt::Txn(body, _) => {
            return esc_block_value(self, body, "the value of this block");
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            return esc_block_value(self, body, "the value of this block");
        }
        Stmt::Handle(body, _, _) => {
            return esc_block_value(self, body, "the value of this block");
        }
        _ => {
            esc_stmt(self, s);
            return esc_none();
        }
    }
    return esc_none();
}

/// Evaluate a nested block's value; it must not point at the block's own locals.
fn esc_block_value(self: &mut EscapeChecker, stmts: Vec<Stmt>, what: str) -> Vec<EscRoot> {
    var outer: i64 = esc_depth(self);
    esc_push_scope(self);
    var r: Vec<EscRoot> = esc_stmts_value(self, stmts);
    esc_pop_scope(self);
    return esc_leave_blocks(self, r, outer, what);
}

fn esc_block(self: &mut EscapeChecker, stmts: Vec<Stmt>) {
    esc_push_scope(self);
    var i: i64 = 0;
    while i < stmts.len() {
        esc_stmt(self, stmts.get(i));
        i = i + 1;
    }
    esc_pop_scope(self);
}

/// Check the arms of a `match`; with `want_value`, also return the roots of
/// the value it produces.
fn esc_arms(self: &mut EscapeChecker, arms: Vec<MatchArm>, scrutinee: Vec<EscRoot>, want_value: bool) -> Vec<EscRoot> {
    var outer: i64 = esc_depth(self);
    var out: Vec<EscRoot> = Vec::new();
    var ai: i64 = 0;
    while ai < arms.len() {
        var arm: MatchArm = arms.get(ai);
        esc_push_scope(self);
        match arm.pattern {
            // A binding is the reference an Option/Result/tuple held.
            Pattern::Ident(name) => {
                esc_declare(self, name, scrutinee, scrutinee.len() > 0);
            }
            Pattern::EnumVariant(_, _, bindings) => {
                var bi: i64 = 0;
                while bi < bindings.len() {
                    esc_declare(self, bindings.get(bi).name, scrutinee, scrutinee.len() > 0);
                    bi = bi + 1;
                }
            }
            _ => {
            }
        }
        match arm.guard {
            OptBoxExpr::Some(g) => {
                esc_expr(self, box_expr_deref(g));
            }
            OptBoxExpr::None => {
            }
        }
        if want_value {
            var r: Vec<EscRoot> = esc_stmts_value(self, arm.body);
            esc_pop_scope(self);
            out = esc_union(out, esc_leave_blocks(self, r, outer, "the value of this match arm"));
        } else {
            var si: i64 = 0;
            while si < arm.body.len() {
                esc_stmt(self, arm.body.get(si));
                si = si + 1;
            }
            esc_pop_scope(self);
        }
        ai = ai + 1;
    }
    return out;
}

fn esc_loop_body(self: &mut EscapeChecker, body: Vec<Stmt>) {
    self.loop_depths.push(esc_depth(self));
    esc_block(self, body);
    self.loop_depths.pop();
}

fn esc_stmt(self: &mut EscapeChecker, s: Stmt) {
    self.line = stmt_line(s);
    match s {
        Stmt::Let(name, ty, expr, _, _, _, _) => {
            match ty {
                OptType::Some(t) => {
                    esc_check_value_type(self, t, "local '" + name + "'");
                }
                OptType::None => {
                }
            }
            var r: Vec<EscRoot> = esc_expr(self, expr);
            var is_ref: bool = false;
            var fn_noref: bool = false;
            match ty {
                OptType::Some(t2) => {
                    is_ref = esc_is_ref_type(t2);
                    fn_noref = esc_fn_ret_noref(self, t2);
                    // A local of a type no reference can be in (i64, bool,
                    // str, a struct) holds none, whatever its initializer
                    // was given (bugs 15/33/39/48)
                    if esc_ret_noref(self, t2) {
                        r = esc_none();
                    }
                }
                OptType::None => {
                    is_ref = esc_is_reference(self, expr);
                    fn_noref = esc_expr_fn_noref(self, expr);
                }
            }
            esc_declare_fn(self, name, r, is_ref, fn_noref);
        }
        Stmt::LetTuple(names, expr, _) => {
            var tr: Vec<EscRoot> = esc_expr(self, expr);
            var ni: i64 = 0;
            while ni < names.len() {
                esc_declare(self, names.get(ni), tr, false);
                ni = ni + 1;
            }
        }
        Stmt::LetUninit(name, ty, _, _) => {
            esc_check_value_type(self, ty, "local '" + name + "'");
            esc_declare(self, name, esc_none(), esc_is_ref_type(ty));
        }
        Stmt::Assign(target, _, expr, _) => {
            var ar: Vec<EscRoot> = esc_expr(self, expr);
            esc_assign_to(self, target, ar);
        }
        Stmt::IndexAssign(array, index, _, expr, _) => {
            esc_expr(self, index);
            var ir: Vec<EscRoot> = esc_expr(self, expr);
            if ir.len() > 0 {
                esc_error(self, "a reference cannot be stored in an element of '" + array + "'");
            }
        }
        Stmt::FieldAssign(object, field, _, expr, _) => {
            esc_expr(self, object);
            var fr: Vec<EscRoot> = esc_expr(self, expr);
            if fr.len() > 0 {
                if esc_all_digits(field) {
                    match object {
                        Expr::Ident(base) => {
                            esc_assign_to(self, base, fr);
                        }
                        _ => {
                        }
                    }
                } else if esc_is_lt_field(field) && esc_ident_of(object) != "" {
                    // LG3: `v.r = &b` in a struct with lifetime
                    // parameters: v is rooted at b too (and must not
                    // outlive it)
                    esc_assign_to(self, esc_ident_of(object), fr);
                } else {
                    esc_error(self, "a reference cannot be stored in field '" + field + "'");
                }
            }
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            esc_expr(self, ptr_expr);
            var dr: Vec<EscRoot> = esc_expr(self, expr);
            if dr.len() > 0 {
                esc_error(self, "a reference cannot be stored through another reference");
            }
        }
        Stmt::Expr(e, _) => {
            esc_expr(self, e);
        }
        Stmt::Return(value, _) => {
            match value {
                OptBoxExpr::Some(e) => {
                    var rr: Vec<EscRoot> = esc_expr(self, box_expr_deref(e));
                    esc_check_return(self, rr);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::Break(value, _) => {
            match value {
                OptBoxExpr::Some(e) => {
                    var br: Vec<EscRoot> = esc_expr(self, box_expr_deref(e));
                    if self.loop_depths.len() > 0 {
                        esc_leave_blocks(self, br, self.loop_depths.get(self.loop_depths.len() - 1), "the value of this loop");
                    }
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            esc_expr(self, cond);
            esc_block(self, then_block);
            match else_block {
                OptStmts::Some(eb) => {
                    esc_block(self, eb);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(cond, body, _) => {
            esc_expr(self, cond);
            esc_loop_body(self, body);
        }
        Stmt::For(var_name, iterator, body, _) => {
            esc_expr(self, iterator);
            self.loop_depths.push(esc_depth(self));
            esc_push_scope(self);
            esc_declare(self, var_name, esc_none(), false);
            var fi: i64 = 0;
            while fi < body.len() {
                esc_stmt(self, body.get(fi));
                fi = fi + 1;
            }
            esc_pop_scope(self);
            self.loop_depths.pop();
        }
        Stmt::Loop(body, _) => {
            esc_loop_body(self, body);
        }
        Stmt::Match(expr, arms, _) => {
            var mr: Vec<EscRoot> = esc_binding_roots(self, expr);
            esc_arms(self, arms, mr, false);
        }
        Stmt::Unsafe(body, _) => {
            self.unsafe_depth = self.unsafe_depth + 1;
            esc_block(self, body);
            self.unsafe_depth = self.unsafe_depth - 1;
        }
        Stmt::Defer(body, _) => {
            esc_block(self, body);
        }
        Stmt::Sandbox(body, _) => {
            esc_block(self, body);
        }
        Stmt::Txn(body, _) => {
            esc_block(self, body);
        }
        Stmt::Handle(body, _, _) => {
            esc_block(self, body);
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            esc_block(self, body);
        }
        Stmt::SpawnScope(body, _) => {
            esc_block(self, body);
        }
        Stmt::Query(_, body, _) => {
            esc_block(self, body);
        }
        Stmt::GradBlock(_, body, _) => {
            esc_block(self, body);
        }
        Stmt::Parallel(branches, _) => {
            var pi: i64 = 0;
            while pi < branches.len() {
                esc_block(self, branches.get(pi));
                pi = pi + 1;
            }
        }
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                var c: SelectCase = cases.get(ci);
                esc_expr(self, c.channel);
                esc_push_scope(self);
                esc_declare(self, c.var_name, esc_none(), false);
                var cs: i64 = 0;
                while cs < c.body.len() {
                    esc_stmt(self, c.body.get(cs));
                    cs = cs + 1;
                }
                esc_pop_scope(self);
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(d) => {
                    esc_block(self, d);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::Do(_, _, args, _) => {
            var di: i64 = 0;
            while di < args.len() {
                esc_expr(self, args.get(di));
                di = di + 1;
            }
        }
        Stmt::Resume(cont, value, _) => {
            esc_expr(self, cont);
            esc_expr(self, value);
        }
        Stmt::Backward(loss, _) => {
            esc_expr(self, loss);
        }
        _ => {
        }
    }
}

/// `target = <value with roots r>`: the target must not outlive any root.
fn esc_assign_to(self: &mut EscapeChecker, target: str, r: Vec<EscRoot>) {
    if r.len() == 0 {
        return;
    }
    var target_depth: i64 = 0;
    match esc_lookup(self, target) {
        OptEscVar::Some(v) => {
            target_depth = v.depth;
        }
        OptEscVar::None => {
            if esc_is_global(self, target) {
                esc_error(self, "global '" + target + "' cannot hold a reference");
            }
            return;
        }
    }
    var kept: Vec<EscRoot> = Vec::new();
    var i: i64 = 0;
    while i < r.len() {
        var x: EscRoot = r.get(i);
        if !x.is_param && x.depth > target_depth {
            esc_error(self, "'" + target + "' would outlive '" + x.name + "': '" + x.name + "' is freed at the end of its block while '" + target + "' is still in scope");
        } else {
            kept.push(x);
        }
        i = i + 1;
    }
    esc_add_roots(self, target, kept);
}

// --- Expressions ----------------------------------------------------------

fn esc_exprs(self: &mut EscapeChecker, es: Vec<Expr>) -> Vec<Vec<EscRoot>> {
    var out: Vec<Vec<EscRoot>> = Vec::new();
    var i: i64 = 0;
    while i < es.len() {
        out.push(esc_expr(self, es.get(i)));
        i = i + 1;
    }
    return out;
}

fn esc_union_all(rs: Vec<Vec<EscRoot>>) -> Vec<EscRoot> {
    var out: Vec<EscRoot> = Vec::new();
    var i: i64 = 0;
    while i < rs.len() {
        out = esc_union(out, rs.get(i));
        i = i + 1;
    }
    return out;
}

/// The roots of `e`'s value (empty when it holds no reference).
fn esc_expr(self: &mut EscapeChecker, e: Expr) -> Vec<EscRoot> {
    match e {
        Expr::Ident(name) => {
            return esc_var_roots(self, name);
        }
        Expr::Ref(inner, _) => {
            return esc_place(self, box_expr_deref(inner));
        }
        Expr::Deref(inner) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::FieldAccess(inner, field) => {
            // A tuple field passes its reference through; any other field
            // cannot hold one (rule 2).
            var fr: Vec<EscRoot> = esc_expr(self, box_expr_deref(inner));
            if esc_all_digits(field) {
                return fr;
            }
            // LG3: a field of a struct with lifetime parameters holding a
            // reference points where that struct's references do
            if esc_is_lt_field(field) {
                return fr;
            }
            return esc_none();
        }
        Expr::OptionalFieldAccess(inner, _) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::Index(array, index) => {
            esc_expr(self, box_expr_deref(array));
            esc_expr(self, box_expr_deref(index));
            return esc_none();
        }
        Expr::Binary(_, left, right) => {
            esc_expr(self, box_expr_deref(left));
            esc_expr(self, box_expr_deref(right));
            return esc_none();
        }
        Expr::StrConcat(left, right) => {
            esc_expr(self, box_expr_deref(left));
            esc_expr(self, box_expr_deref(right));
            return esc_none();
        }
        Expr::Range(start, end, _) => {
            esc_expr(self, box_expr_deref(start));
            esc_expr(self, box_expr_deref(end));
            return esc_none();
        }
        Expr::Unary(_, inner) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::IsCheck(inner, _) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::Cast(inner, _) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::QuantCast(inner, _) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::Comptime(inner) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::Yield(inner) => {
            esc_expr(self, box_expr_deref(inner));
            return esc_none();
        }
        Expr::Await(inner) => {
            return esc_expr(self, box_expr_deref(inner));
        }
        Expr::NamedArg(_, inner) => {
            return esc_expr(self, box_expr_deref(inner));
        }
        Expr::Spawn(inner) => {
            // Everything handed to the task: a call's arguments as well as its result.
            var task: Expr = box_expr_deref(inner);
            var sr: Vec<EscRoot> = esc_expr(self, task);
            match task {
                Expr::Call(_, args) => {
                    sr = esc_union(sr, esc_union_all(esc_exprs(self, args)));
                }
                Expr::MethodCall(recv, _, margs) => {
                    sr = esc_union(sr, esc_expr(self, box_expr_deref(recv)));
                    sr = esc_union(sr, esc_union_all(esc_exprs(self, margs)));
                }
                _ => {
                }
            }
            if sr.len() > 0 {
                esc_error(self, "a reference cannot be sent to another task");
            }
            return esc_none();
        }
        Expr::Try(inner) => {
            return esc_expr(self, box_expr_deref(inner));
        }
        Expr::Coalesce(inner, default) => {
            var cr: Vec<EscRoot> = esc_expr(self, box_expr_deref(inner));
            return esc_union(cr, esc_expr(self, box_expr_deref(default)));
        }
        Expr::Call(callee, args) => {
            return esc_call(self, callee, args);
        }
        Expr::MethodCall(receiver, method, args) => {
            return esc_method_call(self, box_expr_deref(receiver), method, args);
        }
        Expr::PipeForward(left, right) => {
            var pr: Vec<EscRoot> = esc_expr(self, box_expr_deref(left));
            return esc_union(pr, esc_expr(self, box_expr_deref(right)));
        }
        Expr::StructLit(name, fields, spread) => {
            // LG3: a struct with lifetime parameters holds the references
            // its fields are given: the literal is rooted where they point
            var lt_held: bool = esc_is_lt_struct(name);
            var held: Vec<EscRoot> = esc_none();
            var fi: i64 = 0;
            while fi < fields.len() {
                var init: FieldInit = fields.get(fi);
                var vr: Vec<EscRoot> = esc_expr(self, init.value);
                if vr.len() > 0 {
                    if lt_held {
                        held = esc_union(held, vr);
                    } else {
                        esc_error(self, "a reference cannot be stored in field '" + name + "." + init.name + "'");
                    }
                }
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(sp) => {
                    var spr: Vec<EscRoot> = esc_expr(self, box_expr_deref(sp));
                    if lt_held {
                        held = esc_union(held, spr);
                    }
                }
                OptBoxExpr::None => {
                }
            }
            return held;
        }
        Expr::EnumLit(enum_name, variant, args) => {
            var rs: Vec<Vec<EscRoot>> = esc_exprs(self, args);
            var joined: Vec<EscRoot> = esc_union_all(rs);
            if esc_is_transparent(enum_name) {
                return joined;
            }
            if joined.len() > 0 {
                esc_error(self, "a reference cannot be stored in variant '" + enum_name + "::" + variant + "'");
            }
            return esc_none();
        }
        Expr::TupleLit(items) => {
            return esc_union_all(esc_exprs(self, items));
        }
        Expr::ArrayLit(_, elements) => {
            var ai: i64 = 0;
            while ai < elements.len() {
                var er: Vec<EscRoot> = esc_expr(self, elements.get(ai));
                if er.len() > 0 {
                    esc_error(self, "a reference cannot be stored in an array");
                }
                ai = ai + 1;
            }
            return esc_none();
        }
        Expr::If(cond, then_block, else_block) => {
            esc_expr(self, box_expr_deref(cond));
            var ir: Vec<EscRoot> = esc_block_value(self, then_block, "the value of this `if`");
            match else_block {
                OptStmts::Some(eb) => {
                    ir = esc_union(ir, esc_block_value(self, eb, "the value of this `if`"));
                }
                OptStmts::None => {
                }
            }
            return ir;
        }
        Expr::Match(scrut, arms) => {
            var s: Vec<EscRoot> = esc_binding_roots(self, box_expr_deref(scrut));
            return esc_arms(self, arms, s, true);
        }
        Expr::Block(b) => {
            return esc_block_value(self, b, "the value of this block");
        }
        Expr::TryBlock(b) => {
            return esc_block_value(self, b, "the value of this block");
        }
        Expr::Closure(params, body, _) => {
            return esc_closure(self, params, body);
        }
        Expr::FString(parts) => {
            var pi: i64 = 0;
            while pi < parts.len() {
                match parts.get(pi) {
                    FStringPart::Expr(x) => {
                        esc_expr(self, x);
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                pi = pi + 1;
            }
            return esc_none();
        }
        _ => {
            return esc_none();
        }
    }
    return esc_none();
}

/// The roots of `&place`.
fn esc_place(self: &mut EscapeChecker, e: Expr) -> Vec<EscRoot> {
    match e {
        // The variable's own storage (for a reference variable `r`, `&r`
        // points at `r` itself, a local).
        Expr::Ident(name) => {
            match esc_lookup(self, name) {
                OptEscVar::Some(v) => {
                    return esc_one(esc_local(name, v.depth));
                }
                OptEscVar::None => {
                    return esc_none();
                }
            }
        }
        Expr::FieldAccess(inner, _) => {
            return esc_place_inside(self, box_expr_deref(inner));
        }
        Expr::OptionalFieldAccess(inner, _) => {
            return esc_place_inside(self, box_expr_deref(inner));
        }
        Expr::Index(array, index) => {
            esc_expr(self, box_expr_deref(index));
            return esc_place_inside(self, box_expr_deref(array));
        }
        Expr::Deref(inner) => {
            return esc_expr(self, box_expr_deref(inner));
        }
        _ => {
            // `&f()`, `&(a + b)`: a temporary in the current block.
            esc_expr(self, e);
            return esc_one(esc_local("a temporary value", esc_depth(self)));
        }
    }
    return esc_none();
}

/// The roots of a place inside `base` (`base.field`, `base[i]`): when `base`
/// is a reference the place is behind it, otherwise it is part of `base`'s
/// own storage.
fn esc_place_inside(self: &mut EscapeChecker, base: Expr) -> Vec<EscRoot> {
    var through: Vec<EscRoot> = esc_expr(self, base);
    if through.len() == 0 {
        return esc_place(self, base);
    }
    return through;
}

fn esc_is_closure(e: Expr) -> bool {
    match e {
        Expr::Closure(_, _, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn esc_call(self: &mut EscapeChecker, callee: str, args: Vec<Expr>) -> Vec<EscRoot> {
    var rs: Vec<Vec<EscRoot>> = esc_exprs(self, args);
    if callee == "Some" || callee == "Ok" || callee == "Err" {
        return esc_union_all(rs);
    }
    // Calling a closure held in a local: its result may be any reference it
    // captured or was given.
    // A function value whose declared result holds no reference (`f:
    // fn(&S) -> i64`) gives none back (bugs 15/33/39/48).
    match esc_lookup(self, callee) {
        OptEscVar::Some(v) => {
            if v.fn_noref {
                return esc_none();
            }
            return esc_union(v.roots, esc_union_all(rs));
        }
        OptEscVar::None => {
        }
    }
    var slot: i64 = HashMap_get(self.func_index, callee);
    if slot == 0 {
        return esc_none();
    }
    // CS5: the callee's parameters from the tables, not a copy of its Func
    var phr: Vec<bool> = self.param_has_ref.get(slot - 1);
    var i: i64 = 0;
    while i < rs.len() {
        if rs.get(i).len() > 0 && !esc_read_only_call(callee) && i < phr.len() && !esc_read_through(self, args.get(i)) {
            if !phr.get(i) {
                var what: str = "a reference";
                if esc_is_closure(args.get(i)) {
                    what = "a closure that captures a reference";
                }
                var pname: str = self.param_names.get(slot - 1).get(i);
                esc_error(self, what + " cannot be passed to parameter '" + pname + "' of '" + callee + "' (type '" + esc_param_ty_str(self, slot, i) + "'), which may keep it; only reference parameters can borrow");
            }
        }
        i = i + 1;
    }
    // Nor does a function whose declared result holds no reference, whatever
    // its summary says
    if self.ret_noref.get(slot - 1) {
        return esc_none();
    }
    var flows: Vec<i64> = esc_summary(self, callee);
    var out: Vec<EscRoot> = Vec::new();
    var fi: i64 = 0;
    while fi < flows.len() {
        var idx: i64 = flows.get(fi);
        if idx < rs.len() {
            out = esc_union(out, rs.get(idx));
        }
        fi = fi + 1;
    }
    return out;
}

/// The type of parameter `i` of the function at `slot` (index + 1 into
/// `all`), as an error names it. A parallel worker has no `all`: its copy
/// of the checker carries the names (esc_par_copy).
fn esc_param_ty_str(self: &EscapeChecker, slot: i64, i: i64) -> str {
    if self.par {
        return self.param_tys.get(slot - 1).get(i);
    }
    return type_to_str(self.all.get(slot - 1).func.params.get(i).ty);
}

fn esc_method_call(self: &mut EscapeChecker, receiver: Expr, method: str, args: Vec<Expr>) -> Vec<EscRoot> {
    var recv: Vec<EscRoot> = esc_expr(self, receiver);
    var rs: Vec<Vec<EscRoot>> = esc_exprs(self, args);
    var keys: Vec<str> = Vec::new();
    var mslot: i64 = HashMap_get(self.method_index, method);
    if mslot != 0 {
        keys = self.method_keys.get(mslot - 1);
    }
    var j: i64 = 0;
    while j < rs.len() {
        if rs.get(j).len() > 0 {
            // Argument j is the method's parameter j + 1 (after `self`).
            var borrows: bool = false;
            var ki: i64 = 0;
            while ki < keys.len() && !borrows {
                var pr: Vec<bool> = self.param_has_ref.get(HashMap_get(self.func_index, keys.get(ki)) - 1);
                if j + 1 < pr.len() && pr.get(j + 1) {
                    borrows = true;
                }
                ki = ki + 1;
            }
            if !borrows && !esc_read_only_method(method) {
                esc_error(self, "a reference cannot be passed to method '" + method + "', which may keep it");
            }
        }
        j = j + 1;
    }
    var out: Vec<EscRoot> = Vec::new();
    var k: i64 = 0;
    while k < keys.len() {
        var key: str = keys.get(k);
        if self.ret_has_ref.get(HashMap_get(self.func_index, key) - 1) {
            var flows: Vec<i64> = esc_summary(self, key);
            var fi: i64 = 0;
            while fi < flows.len() {
                var idx: i64 = flows.get(fi);
                if idx == 0 {
                    out = esc_union(out, recv);
                } else if idx - 1 < rs.len() {
                    out = esc_union(out, rs.get(idx - 1));
                }
                fi = fi + 1;
            }
        }
        k = k + 1;
    }
    return out;
}

fn esc_closure(self: &mut EscapeChecker, params: Vec<Param>, body: Vec<Stmt>) -> Vec<EscRoot> {
    // Captured references root the closure value (captures are by value).
    var used: Vec<str> = Vec::new();
    esc_idents_stmts(body, &mut used);
    var roots: Vec<EscRoot> = Vec::new();
    var ui: i64 = 0;
    while ui < used.len() {
        var name: str = used.get(ui);
        var is_param: bool = false;
        var pi: i64 = 0;
        while pi < params.len() {
            if params.get(pi).name == name {
                is_param = true;
            }
            pi = pi + 1;
        }
        if !is_param {
            roots = esc_union(roots, esc_var_roots(self, name));
        }
        ui = ui + 1;
    }
    // Check the body as its own function: its locals must not escape it.
    var saved_base: i64 = self.closure_base;
    var saved_loops: Vec<i64> = self.loop_depths;
    var no_loops: Vec<i64> = Vec::new();
    self.loop_depths = no_loops;
    esc_push_scope(self);
    self.closure_base = esc_depth(self) - 1;
    var qi: i64 = 0;
    while qi < params.len() {
        var p: Param = params.get(qi);
        esc_check_value_type(self, p.ty, "closure parameter '" + p.name + "'");
        esc_declare_fn(self, p.name, esc_none(), esc_is_ref_type(p.ty), esc_fn_ret_noref(self, p.ty));
        qi = qi + 1;
    }
    var tail: Vec<EscRoot> = esc_stmts_value(self, body);
    esc_check_return(self, tail);
    esc_pop_scope(self);
    self.closure_base = saved_base;
    self.loop_depths = saved_loops;
    return roots;
}

// --- Identifiers a closure body reads (a superset of its captures) ---------

fn esc_note(out: &mut Vec<str>, name: str) {
    if !str_vec_contains(out, name) {
        out.push(name);
    }
}

pub fn esc_idents_stmts(stmts: Vec<Stmt>, out: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        esc_idents_stmt(stmts.get(i), out);
        i = i + 1;
    }
}

fn esc_idents_opt_stmts(stmts: OptStmts, out: &mut Vec<str>) {
    match stmts {
        OptStmts::Some(b) => {
            esc_idents_stmts(b, out);
        }
        OptStmts::None => {
        }
    }
}

fn esc_idents_stmt(s: Stmt, out: &mut Vec<str>) {
    match s {
        Stmt::Let(_, _, expr, _, _, _, _) => {
            esc_idents_expr(expr, out);
        }
        Stmt::LetTuple(_, expr, _) => {
            esc_idents_expr(expr, out);
        }
        Stmt::Assign(_, _, expr, _) => {
            esc_idents_expr(expr, out);
        }
        Stmt::Expr(expr, _) => {
            esc_idents_expr(expr, out);
        }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            esc_idents_expr(index, out);
            esc_idents_expr(expr, out);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            esc_idents_expr(ptr_expr, out);
            esc_idents_expr(expr, out);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            esc_idents_expr(object, out);
            esc_idents_expr(expr, out);
        }
        Stmt::Return(value, _) => {
            match value {
                OptBoxExpr::Some(e) => {
                    esc_idents_expr(box_expr_deref(e), out);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::Break(value, _) => {
            match value {
                OptBoxExpr::Some(e) => {
                    esc_idents_expr(box_expr_deref(e), out);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            esc_idents_expr(cond, out);
            esc_idents_stmts(then_block, out);
            esc_idents_opt_stmts(else_block, out);
        }
        Stmt::While(cond, body, _) => {
            esc_idents_expr(cond, out);
            esc_idents_stmts(body, out);
        }
        Stmt::For(_, iterator, body, _) => {
            esc_idents_expr(iterator, out);
            esc_idents_stmts(body, out);
        }
        Stmt::Match(expr, arms, _) => {
            esc_idents_expr(expr, out);
            var ai: i64 = 0;
            while ai < arms.len() {
                esc_idents_stmts(arms.get(ai).body, out);
                ai = ai + 1;
            }
        }
        Stmt::Loop(body, _) => {
            esc_idents_stmts(body, out);
        }
        Stmt::Defer(body, _) => {
            esc_idents_stmts(body, out);
        }
        Stmt::Unsafe(body, _) => {
            esc_idents_stmts(body, out);
        }
        Stmt::Sandbox(body, _) => {
            esc_idents_stmts(body, out);
        }
        Stmt::Txn(body, _) => {
            esc_idents_stmts(body, out);
        }
        Stmt::Handle(body, _, _) => {
            esc_idents_stmts(body, out);
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            esc_idents_stmts(body, out);
        }
        Stmt::SpawnScope(body, _) => {
            esc_idents_stmts(body, out);
        }
        Stmt::Query(_, body, _) => {
            esc_idents_stmts(body, out);
        }
        Stmt::GradBlock(_, body, _) => {
            esc_idents_stmts(body, out);
        }
        _ => {
        }
    }
}

fn esc_idents_exprs(es: Vec<Expr>, out: &mut Vec<str>) {
    var i: i64 = 0;
    while i < es.len() {
        esc_idents_expr(es.get(i), out);
        i = i + 1;
    }
}

fn esc_idents_expr(e: Expr, out: &mut Vec<str>) {
    match e {
        Expr::Ident(n) => {
            esc_note(out, n);
        }
        Expr::Binary(_, l, r) => {
            esc_idents_expr(box_expr_deref(l), out);
            esc_idents_expr(box_expr_deref(r), out);
        }
        Expr::StrConcat(l, r) => {
            esc_idents_expr(box_expr_deref(l), out);
            esc_idents_expr(box_expr_deref(r), out);
        }
        Expr::PipeForward(l, r) => {
            esc_idents_expr(box_expr_deref(l), out);
            esc_idents_expr(box_expr_deref(r), out);
        }
        Expr::Range(l, r, _) => {
            esc_idents_expr(box_expr_deref(l), out);
            esc_idents_expr(box_expr_deref(r), out);
        }
        Expr::Coalesce(l, r) => {
            esc_idents_expr(box_expr_deref(l), out);
            esc_idents_expr(box_expr_deref(r), out);
        }
        Expr::Index(l, r) => {
            esc_idents_expr(box_expr_deref(l), out);
            esc_idents_expr(box_expr_deref(r), out);
        }
        Expr::Unary(_, x) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::FieldAccess(x, _) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::OptionalFieldAccess(x, _) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::Ref(x, _) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::Deref(x) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::Try(x) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::IsCheck(x, _) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::Cast(x, _) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::QuantCast(x, _) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::Await(x) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::Spawn(x) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::Comptime(x) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::Yield(x) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::NamedArg(_, x) => {
            esc_idents_expr(box_expr_deref(x), out);
        }
        Expr::Call(callee, args) => {
            esc_note(out, callee);
            esc_idents_exprs(args, out);
        }
        Expr::MethodCall(recv, _, args) => {
            esc_idents_expr(box_expr_deref(recv), out);
            esc_idents_exprs(args, out);
        }
        Expr::EnumLit(_, _, args) => {
            esc_idents_exprs(args, out);
        }
        Expr::TupleLit(args) => {
            esc_idents_exprs(args, out);
        }
        Expr::ArrayLit(_, args) => {
            esc_idents_exprs(args, out);
        }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                esc_idents_expr(fields.get(fi).value, out);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => {
                    esc_idents_expr(box_expr_deref(s), out);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::If(cond, then_block, else_block) => {
            esc_idents_expr(box_expr_deref(cond), out);
            esc_idents_stmts(then_block, out);
            esc_idents_opt_stmts(else_block, out);
        }
        Expr::Match(x, arms) => {
            esc_idents_expr(box_expr_deref(x), out);
            var ai: i64 = 0;
            while ai < arms.len() {
                esc_idents_stmts(arms.get(ai).body, out);
                ai = ai + 1;
            }
        }
        Expr::Block(b) => {
            esc_idents_stmts(b, out);
        }
        Expr::TryBlock(b) => {
            esc_idents_stmts(b, out);
        }
        Expr::ComptimeBlock(b) => {
            esc_idents_stmts(b, out);
        }
        Expr::Closure(_, b, _) => {
            esc_idents_stmts(b, out);
        }
        Expr::FString(parts) => {
            var pi: i64 = 0;
            while pi < parts.len() {
                match parts.get(pi) {
                    FStringPart::Expr(x) => {
                        esc_idents_expr(x, out);
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                pi = pi + 1;
            }
        }
        _ => {
        }
    }
}

// --- Parallel reporting pass (CS5) ----------------------------------------
// FID_PAR=N (opt-in, as for the borrow check: borrowck.fd bc_par_workers)
// runs the reporting pass in up to N threads. The summaries are final
// before it starts (the fixpoint) and the pass changes none
// (esc_analyze_func), so a function's messages depend on that function
// alone; all one function's check does to another's is drop a message
// already given (esc_error). Each worker checks a contiguous chunk of the
// functions with a checker of its own; the chunks' messages, merged in
// order by the same rule, are the sequential output byte for byte.
//
// Owner counts are not atomic (core.fd "Copies for another thread"), so no
// two threads may copy or drop the same string, Vec or Box at once. Only
// keeping a value (let, field, element, return) copies it; reading one, or
// passing it as an argument, does not. So:
//  - each worker makes its own checker (esc_par_copy) from the master's,
//    which it only reads: its tables are copies in buffers of its own
//    (par_own_*), and the HashMaps (raw handles) are only looked up;
//  - no analysis keeps another function's Func: a call reads its callee's
//    parameters from param_names/param_rt/param_has_ref/param_tys, and a
//    worker passes its units to esc_analyze_func without keeping them;
//  - a function's AST is touched by the one worker that checks it. Before
//    this pass, AST pieces are shared only inside one impl block (its type
//    name) and among trait impls (compiler.fd gives every impl that lacks
//    it the same default body of a trait method), so a chunk never splits
//    an impl block, and the trait impls' methods stay in one chunk.
// Spawn arguments must be @send: a worker gets its chunk bounds and reads
// the master checker and the functions from the module globals below, set
// before the spawns and reset after the last await.
pub var g_esc_par_units: Vec<EscFunc> = Vec::new();
pub var g_esc_par_master: Vec<EscapeChecker> = Vec::new();
pub var g_esc_par_tys: Vec<Vec<str>> = Vec::new();

/// The worker count FID_PAR asks for: 1 (sequential) unless it is a number
/// of 2 or more (16 at most).
pub fn esc_par_workers() -> i64 {
    var r: i64 = p_getenv("FID_PAR");
    if r == 0 {
        return 1;
    }
    var s: str = p_str_adopt(r);
    var n: i64 = 0;
    var i: i64 = 0;
    while i < str_len(s) {
        var ch: i64 = str_byte_at(s, i);
        if ch < 48 || ch > 57 {
            return 1;
        }
        n = n * 10 + (ch - 48);
        i = i + 1;
    }
    if n < 1 {
        return 1;
    }
    if n > 16 {
        return 16;
    }
    return n;
}

/// `s` in a buffer of its own: it shares no owner count with `s`.
pub fn par_own_str(s: str) -> str {
    return p_str_adopt(p_str_send_copy(s as i64));
}

pub fn par_own_strs(v: Vec<str>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        out.push(par_own_str(v.get(i)));
        i = i + 1;
    }
    return out;
}

pub fn par_own_strss(v: Vec<Vec<str>>) -> Vec<Vec<str>> {
    var out: Vec<Vec<str>> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        out.push(par_own_strs(v.get(i)));
        i = i + 1;
    }
    return out;
}

pub fn par_own_i64s(v: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        out.push(v.get(i));
        i = i + 1;
    }
    return out;
}

pub fn par_own_i64ss(v: Vec<Vec<i64>>) -> Vec<Vec<i64>> {
    var out: Vec<Vec<i64>> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        out.push(par_own_i64s(v.get(i)));
        i = i + 1;
    }
    return out;
}

pub fn par_own_bools(v: Vec<bool>) -> Vec<bool> {
    var out: Vec<bool> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        out.push(v.get(i));
        i = i + 1;
    }
    return out;
}

pub fn par_own_boolss(v: Vec<Vec<bool>>) -> Vec<Vec<bool>> {
    var out: Vec<Vec<bool>> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        out.push(par_own_bools(v.get(i)));
        i = i + 1;
    }
    return out;
}

/// The group a reporting unit (by its skip-set key) must share a chunk
/// with: "" for a free function (any chunk), "impl:S" for a method of an
/// impl block of S, "trait:" for every trait impl's method.
pub fn par_unit_group(skey: str) -> str {
    if str_starts_with(skey, "impl:") {
        var p: i64 = 5;
        while p < str_len(skey) && str_byte_at(skey, p) != 58 {
            p = p + 1;
        }
        return str_slice(skey, 0, p);
    }
    if str_starts_with(skey, "trait:") {
        return "trait:";
    }
    return "";
}

/// Chunks of `skeys` (in order, about n / nw each, none splitting a group
/// of par_unit_group) as [start0, end0, start1, end1, ...]; nw at most.
pub fn par_chunk_bounds(skeys: Vec<str>, nw: i64) -> Vec<i64> {
    var n: i64 = skeys.len();
    var target: i64 = (n + nw - 1) / nw;
    var out: Vec<i64> = Vec::new();
    var s: i64 = 0;
    var prev: str = "";
    var i: i64 = 0;
    while i < n {
        var g: str = par_unit_group(skeys.get(i));
        if i - s >= target && (g == "" || g != prev) {
            out.push(s);
            out.push(i);
            s = i;
        }
        prev = g;
        i = i + 1;
    }
    if s < n {
        out.push(s);
        out.push(n);
    }
    return out;
}

/// A worker's checker: the tables of `c` (the master, only read), copied so
/// they share no buffer and no string with it, and `par` set (no `all`;
/// the callee parameter types of `tys`).
fn esc_par_copy(c: EscapeChecker, tys: Vec<Vec<str>>) -> EscapeChecker {
    var no_all: Vec<EscFunc> = Vec::new();
    var no_scopes: Vec<Vec<EscVar>> = Vec::new();
    var no_flows: Vec<i64> = Vec::new();
    var no_loops: Vec<i64> = Vec::new();
    var no_errors: Vec<str> = Vec::new();
    return EscapeChecker {
        all: no_all, func_index: c.func_index, method_index: c.method_index, method_keys: par_own_strss(c.method_keys), globals: c.globals, summary_index: c.summary_index, summaries: par_own_i64ss(c.summaries), scopes: no_scopes, func_name: "", flows: no_flows, loop_depths: no_loops, closure_base: 0, unsafe_depth: 0, line: 0, report: true, errors: no_errors, type_names: c.type_names, ret_has_ref: par_own_bools(c.ret_has_ref), ret_is_ref: par_own_bools(c.ret_is_ref), param_has_ref: par_own_boolss(c.param_has_ref), has_decl_flows: par_own_bools(c.has_decl_flows), decl_flows: par_own_i64ss(c.decl_flows), param_names: par_own_strss(c.param_names), param_rt: par_own_boolss(c.param_rt), par: true, param_tys: par_own_strss(tys), ret_noref: par_own_bools(c.ret_noref),
    };
}

/// A worker of the parallel reporting pass: units s..e of g_esc_par_units,
/// with a checker of its own; its messages in order. The units are passed
/// to esc_analyze_func, never kept (that would copy what the master holds).
pub fn esc_par_worker(s: i64, e: i64) -> Vec<str> {
    var c: EscapeChecker = esc_par_copy(g_esc_par_master.get(0), g_esc_par_tys);
    var i: i64 = s;
    while i < e {
        esc_analyze_func(&mut c, g_esc_par_units.get(i).key, g_esc_par_units.get(i).func);
        i = i + 1;
    }
    var out: Vec<str> = c.errors;
    return out;
}

/// The reporting pass over `units` in up to `nw` threads (CS5), with `c`
/// (after the fixpoint) as the master: the workers' messages, each
/// worker's in order, workers in order. The caller merges them into
/// c.errors by esc_error's rule.
fn esc_par_report(c: EscapeChecker, units: Vec<EscFunc>, nw: i64) -> Vec<str> {
    var skeys: Vec<str> = Vec::new();
    var ui: i64 = 0;
    while ui < units.len() {
        skeys.push(units.get(ui).skey);
        ui = ui + 1;
    }
    var bounds: Vec<i64> = par_chunk_bounds(skeys, nw);
    var nch: i64 = bounds.len() / 2;
    // the parameter types an error may name, made once here
    var tys: Vec<Vec<str>> = Vec::new();
    var k: i64 = 0;
    while k < c.all.len() {
        var ff: Func = c.all.get(k).func;
        var ts: Vec<str> = Vec::new();
        var pj: i64 = 0;
        while pj < ff.params.len() {
            ts.push(type_to_str(ff.params.get(pj).ty));
            pj = pj + 1;
        }
        tys.push(ts);
        k = k + 1;
    }
    var master: Vec<EscapeChecker> = Vec::new();
    master.push(c);
    g_esc_par_master = master;
    g_esc_par_tys = tys;
    g_esc_par_units = units;
    var futs: Vec<Future<Vec<str>> > = Vec::new();
    var wi: i64 = 0;
    while wi < nch {
        var s: i64 = bounds.get(2 * wi);
        var e: i64 = bounds.get(2 * wi + 1);
        futs.push(spawn esc_par_worker(s, e));
        wi = wi + 1;
    }
    var out: Vec<str> = Vec::new();
    wi = 0;
    while wi < futs.len() {
        var errs: Vec<str> = await futs.get(wi);
        var ei: i64 = 0;
        while ei < errs.len() {
            out.push(errs.get(ei));
            ei = ei + 1;
        }
        wi = wi + 1;
    }
    var no_master: Vec<EscapeChecker> = Vec::new();
    g_esc_par_master = no_master;
    var no_tys: Vec<Vec<str>> = Vec::new();
    g_esc_par_tys = no_tys;
    var no_units: Vec<EscFunc> = Vec::new();
    g_esc_par_units = no_units;
    return out;
}

// --- Entry point ----------------------------------------------------------

/// Run the escape check over every function of `program`.
pub fn escape_check(program: Program) -> Vec<str> {
    return escape_check_skipped(program, 0);
}

// Trusted bodies were checked clean once: the summary fixpoint still runs
// over every function (user code may receive references back), but the
// reporting pass skips bodies in the skip set.
pub fn escape_check_skipped(program: Program, skip: i64) -> Vec<str> {
    var c: EscapeChecker = EscapeChecker_new(program);
    esc_check_decls(&mut c, program);
    // Infer which parameters reach each function's result, to a fixpoint.
    // Summaries only grow, so an unchanged total means nothing changed.
    // Only a function whose result can hold a reference has a summary to
    // find; the rest are analyzed once, in the reporting pass (CS3: the
    // fixpoint used to go over every function several times).
    var with_ref: Vec<i64> = Vec::new();
    var wi: i64 = 0;
    while wi < c.all.len() {
        if !esc_ret_noref(&c, c.all.get(wi).func.ret_ty) {
            with_ref.push(wi);
        }
        wi = wi + 1;
    }
    var before: i64 = -1;
    while before != esc_summary_total(&c) {
        before = esc_summary_total(&c);
        var i: i64 = 0;
        while i < with_ref.len() {
            var ef: EscFunc = c.all.get(with_ref.get(i));
            esc_analyze_func(&mut c, ef.key, ef.func);
            i = i + 1;
        }
    }
    c.report = true;
    // CS5: FID_PAR=N checks the bodies in N threads (the same messages in
    // the same order), when there are enough to be worth the threads
    var nw: i64 = esc_par_workers();
    if nw > 1 {
        var punits: Vec<EscFunc> = Vec::new();
        var pj: i64 = 0;
        while pj < c.all.len() {
            var pef: EscFunc = c.all.get(pj);
            if skip == 0 || !HashMap_contains(skip, pef.skey) {
                punits.push(pef);
            }
            pj = pj + 1;
        }
        if punits.len() >= 64 {
            var perrs: Vec<str> = esc_par_report(c, punits, nw);
            var pe: i64 = 0;
            while pe < perrs.len() {
                var pm: str = perrs.get(pe);
                if !str_vec_contains(c.errors, pm) {
                    c.errors.push(pm);
                }
                pe = pe + 1;
            }
            return c.errors;
        }
    }
    var j: i64 = 0;
    while j < c.all.len() {
        var ef2: EscFunc = c.all.get(j);
        if skip == 0 || !HashMap_contains(skip, ef2.skey) {
            esc_analyze_func(&mut c, ef2.key, ef2.func);
        }
        j = j + 1;
    }
    return c.errors;
}
