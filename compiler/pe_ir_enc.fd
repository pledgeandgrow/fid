// pe_ir_enc.fd -- x86-64 machine-code encoder and PE file-format writer for
// the IR -> .exe backend (compiler/pe_ir.fd). Ported line-by-line from the
// top half of src/pe.rs: PeirEnc (bytes, labels, RIP-relative refs),
// the kernel32/msvcrt import tables, PeirRdata, and build_pe_file.
//
// Adaptations from Rust (same as arm64_enc.fd):
// 1. u8/u16/u32/u64/usize -> i64; byte emission masks with & 0xFF
// 2. Reg/XmmReg enums -> i64 register ids (PEIR_RAX..PEIR_R15, XMM0..XMM15)
// 3. HashMap<u32, usize> labels -> Vec<i64> indexed by label id (-1 = unset)
// 4. struct methods -> free functions with `self: &mut PeirEnc` /
//    `self: &mut PeirRdata`
// 5. Option<usize> -> i64 (-1 = None)
//
// Windows x64 calling convention (for reference):
//   - Integer args: RCX, RDX, R8, R9 (then stack); return: RAX
//   - Shadow space: 32 bytes; stack 16-byte aligned before CALL

module compiler::pe_ir_enc;

use core;
use vec;
use string;

// ===========================================================================
// Register ids (Reg / XmmReg in Rust)
// ===========================================================================

pub const PEIR_RAX: i64 = 0;
pub const PEIR_RCX: i64 = 1;
pub const PEIR_RDX: i64 = 2;
pub const PEIR_RBX: i64 = 3;
pub const PEIR_RSP: i64 = 4;
pub const PEIR_RBP: i64 = 5;
pub const PEIR_RSI: i64 = 6;
pub const PEIR_RDI: i64 = 7;
pub const PEIR_R8: i64 = 8;
pub const PEIR_R9: i64 = 9;
pub const PEIR_R10: i64 = 10;
pub const PEIR_R11: i64 = 11;
pub const PEIR_R12: i64 = 12;
pub const PEIR_R13: i64 = 13;
pub const PEIR_R14: i64 = 14;
pub const PEIR_R15: i64 = 15;

pub const XMM0: i64 = 0;
pub const XMM1: i64 = 1;
pub const XMM2: i64 = 2;
pub const XMM3: i64 = 3;
pub const XMM4: i64 = 4;
pub const XMM5: i64 = 5;
pub const XMM6: i64 = 6;
pub const XMM7: i64 = 7;
pub const XMM8: i64 = 8;
pub const XMM9: i64 = 9;
pub const XMM10: i64 = 10;
pub const XMM11: i64 = 11;
pub const XMM12: i64 = 12;
pub const XMM13: i64 = 13;
pub const XMM14: i64 = 14;
pub const XMM15: i64 = 15;

/// Low 3 bits (ModR/M encoding) — Reg::code
pub fn peir_reg_code(r: i64) -> i64 {
    return r & 7;
}

/// True if this is an extended register (R8-R15, needs REX.B/R)
pub fn reg_ext(r: i64) -> bool {
    return r >= 8;
}

/// Is this a high XMM register (8-15) requiring REX prefix? — XmmReg::is_high
pub fn xmm_high(x: i64) -> bool {
    return x >= 8;
}

// ===========================================================================
// Relocation kinds (RelocKind in Rust)
// ===========================================================================

/// Relative jump/call (rel32): disp32 = target - (code_offset + 4)
pub const PEIR_RELOC_REL32: i64 = 0;
/// RIP-relative data access: disp32 = target_rva - (code_rva + 4)
/// (marker only — rip refs use PeirRipRef, not PeirReloc)
pub const PEIR_RELOC_RIPREL32: i64 = 1;
/// RIP-relative lea to a code label: disp32 = target_code - (code_offset + 4)
pub const PEIR_RELOC_LEALABEL: i64 = 2;

/// Pending relocation — a location in code that needs to be patched
/// after all labels are resolved
pub struct PeirReloc {
    /// Offset in code buffer where the 4-byte displacement should be written
    pub code_offset: i64,
    /// Target label ID
    pub target_label: i64,
    /// Type of relocation (PEIR_RELOC_*)
    pub kind: i64,
}

pub fn PeirReloc_new(code_offset: i64, target_label: i64, kind: i64) -> PeirReloc {
    return PeirReloc { code_offset: code_offset, target_label: target_label, kind: kind };
}

/// Pending RIP-relative reference to .rdata section
pub struct PeirRipRef {
    /// Offset in code buffer where the 4-byte displacement should be written
    pub code_offset: i64,
    /// Offset within .rdata section of the target
    pub rdata_offset: i64,
}

pub fn PeirRipRef_new(code_offset: i64, rdata_offset: i64) -> PeirRipRef {
    return PeirRipRef { code_offset: code_offset, rdata_offset: rdata_offset };
}

// ===========================================================================
// PeirEnc — the x86_64 machine code encoder
// ===========================================================================

pub struct PeirEnc {
    /// Accumulated machine code bytes
    pub code: Vec<i64>,
    /// Label positions: label_id -> code offset, -1 = not placed
    pub labels: Vec<i64>,
    /// Pending label relocations (jumps, calls within .text)
    pub pending_labels: Vec<PeirReloc>,
    /// Pending RIP-relative references to .rdata
    pub pending_rip_refs: Vec<PeirRipRef>,
    /// Next label ID
    pub next_label: i64,
    /// Peephole: (disp, src reg, code position after the instruction) of
    /// the last emitted `mov [rbp+disp], src`. last_store_end = -1 = none.
    /// mov_reg_mem_rbp forwards the register instead of reloading when no
    /// byte was emitted in between (code is append-only). place_label
    /// clears it — a load at a branch target is never wrongly forwarded.
    pub last_store_disp: i64,
    pub last_store_reg: i64,
    pub last_store_end: i64,
}

pub fn PeirEnc_new() -> PeirEnc {
    return PeirEnc {
        code: Vec::new(),
        labels: Vec::new(),
        pending_labels: Vec::new(),
        pending_rip_refs: Vec::new(),
        next_label: 0,
        last_store_disp: 0,
        last_store_reg: 0,
        last_store_end: -1,
    };
}

/// Allocate a new label ID
pub fn PeirEnc_alloc_label(self: &mut PeirEnc) -> i64 {
    var id: i64 = self.next_label;
    self.next_label = self.next_label + 1;
    self.labels.push(-1);
    return id;
}

/// Mark a label at the current code position
pub fn PeirEnc_place_label(self: &mut PeirEnc, label: i64) -> void {
    self.last_store_end = -1;
    self.labels.set(label, self.code.len());
}

/// Align code output to a boundary using multi-byte NOPs.
pub fn PeirEnc_align_to(self: &mut PeirEnc, boundary: i64) -> void {
    if boundary == 0 { return; }
    var cur: i64 = self.code.len();
    var rem: i64 = cur % boundary;
    if rem == 0 { return; }
    var pad: i64 = boundary - rem;
    var remaining: i64 = pad;
    while remaining >= 8 {
        // NOPS[7]: 0F 1F 84 00 00 00 00 00
        self.code.push(0x0F); self.code.push(0x1F); self.code.push(0x84);
        self.code.push(0x00); self.code.push(0x00); self.code.push(0x00);
        self.code.push(0x00); self.code.push(0x00);
        remaining = remaining - 8;
    }
    if remaining == 1 {
        self.code.push(0x90);
    } else if remaining == 2 {
        self.code.push(0x66); self.code.push(0x90);
    } else if remaining == 3 {
        self.code.push(0x0F); self.code.push(0x1F); self.code.push(0x00);
    } else if remaining == 4 {
        self.code.push(0x0F); self.code.push(0x1F); self.code.push(0x40);
        self.code.push(0x00);
    } else if remaining == 5 {
        self.code.push(0x0F); self.code.push(0x1F); self.code.push(0x44);
        self.code.push(0x00); self.code.push(0x00);
    } else if remaining == 6 {
        self.code.push(0x66); self.code.push(0x0F); self.code.push(0x1F);
        self.code.push(0x44); self.code.push(0x00); self.code.push(0x00);
    } else if remaining == 7 {
        self.code.push(0x0F); self.code.push(0x1F); self.code.push(0x80);
        self.code.push(0x00); self.code.push(0x00); self.code.push(0x00);
        self.code.push(0x00);
    }
}

/// Get current code offset
pub fn PeirEnc_offset(self: &PeirEnc) -> i64 {
    return self.code.len();
}

/// Emit raw bytes (masked to 0..255)
pub fn PeirEnc_emit(self: &mut PeirEnc, bytes: Vec<i64>) -> void {
    var i: i64 = 0;
    while i < bytes.len() {
        self.code.push(bytes.get(i) & 0xFF);
        i = i + 1;
    }
}

pub fn PeirEnc_emit_u8(self: &mut PeirEnc, b: i64) -> void {
    self.code.push(b & 0xFF);
}

pub fn PeirEnc_emit_u16(self: &mut PeirEnc, w: i64) -> void {
    self.code.push(w & 0xFF);
    self.code.push((w >> 8) & 0xFF);
}

pub fn PeirEnc_emit_u32(self: &mut PeirEnc, d: i64) -> void {
    self.code.push(d & 0xFF);
    self.code.push((d >> 8) & 0xFF);
    self.code.push((d >> 16) & 0xFF);
    self.code.push((d >> 24) & 0xFF);
}

/// emit_i32 — same little-endian byte layout as emit_u32
pub fn PeirEnc_emit_i32(self: &mut PeirEnc, d: i64) -> void {
    PeirEnc_emit_u32(self, d);
}

pub fn PeirEnc_emit_u64(self: &mut PeirEnc, q: i64) -> void {
    self.code.push(q & 0xFF);
    self.code.push((q >> 8) & 0xFF);
    self.code.push((q >> 16) & 0xFF);
    self.code.push((q >> 24) & 0xFF);
    self.code.push((q >> 32) & 0xFF);
    self.code.push((q >> 40) & 0xFF);
    self.code.push((q >> 48) & 0xFF);
    self.code.push((q >> 56) & 0xFF);
}

/// Emit REX prefix
/// w: 64-bit operand size
/// r: extends ModR/M.reg (dst register)
/// x: extends SIB.index
/// b: extends ModR/M.r/m or SIB.base or opcode reg
pub fn PeirEnc_rex(self: &mut PeirEnc, w: bool, r: bool, x: bool, b: bool) -> void {
    var rex: i64 = 0x40;
    if w { rex = rex | 0x08; }
    if r { rex = rex | 0x04; }
    if x { rex = rex | 0x02; }
    if b { rex = rex | 0x01; }
    self.code.push(rex);
}

/// Emit REX.W prefix (64-bit operand, no extended regs)
pub fn PeirEnc_rex_w(self: &mut PeirEnc) -> void {
    PeirEnc_rex(self, true, false, false, false);
}

/// Emit ModR/M byte
pub fn PeirEnc_modrm(self: &mut PeirEnc, m: i64, reg: i64, rm: i64) -> void {
    self.code.push(((m & 3) << 6) | ((reg & 7) << 3) | (rm & 7));
}

/// Encode a register-to-register ModR/M (mod=11)
pub fn PeirEnc_modrm_rr(self: &mut PeirEnc, reg: i64, rm: i64) -> void {
    PeirEnc_modrm(self, 3, peir_reg_code(reg), peir_reg_code(rm));
}

// ─── Common instruction encodings ───

/// push r64
pub fn PeirEnc_push(self: &mut PeirEnc, r: i64) -> void {
    if reg_ext(r) {
        PeirEnc_rex(self, false, false, false, true);
    }
    self.code.push(0x50 + peir_reg_code(r));
}

/// pop r64
pub fn PeirEnc_pop(self: &mut PeirEnc, r: i64) -> void {
    if reg_ext(r) {
        PeirEnc_rex(self, false, false, false, true);
    }
    self.code.push(0x58 + peir_reg_code(r));
}

/// ret
pub fn PeirEnc_ret(self: &mut PeirEnc) -> void {
    self.code.push(0xC3);
}

/// nop
pub fn PeirEnc_nop(self: &mut PeirEnc) -> void {
    self.code.push(0x90);
}

/// ud2
pub fn PeirEnc_ud2(self: &mut PeirEnc) -> void {
    self.code.push(0x0F);
    self.code.push(0x0B);
}

// ─── SSE2 packed double-precision (f64x2) instructions ───
// These operate on XMM registers. Encoding: 66 0F <opcode> ModR/M
// For register-to-register: ModR/M = 11 (mod) | reg (dst) | rm (src)

/// Emit REX prefix for XMM register pair (dst, src)
pub fn PeirEnc_rex_sse(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    var w: bool = false;
    var r: bool = xmm_high(dst);
    var b: bool = xmm_high(src);
    if w || r || b {
        var rex: i64 = 0x40;
        if w { rex = rex | 0x08; }
        if r { rex = rex | 0x04; }
        if b { rex = rex | 0x01; }
        self.code.push(rex);
    }
}

/// ModR/M byte for XMM reg-to-reg: 11 | dst_code | src_code
pub fn PeirEnc_modrm_xmm(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    var modrm: i64 = 0xC0 | ((dst & 7) << 3) | (src & 7);
    self.code.push(modrm);
}

/// addpd xmm_dst, xmm_src — SSE2 packed double add
/// Encoding: 66 0F 58 ModR/M
pub fn PeirEnc_addpd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x58);
    PeirEnc_modrm_xmm(self, dst, src);
}

/// subpd xmm_dst, xmm_src — SSE2 packed double subtract
/// Encoding: 66 0F 5C ModR/M
pub fn PeirEnc_subpd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x5C);
    PeirEnc_modrm_xmm(self, dst, src);
}

/// mulpd xmm_dst, xmm_src — SSE2 packed double multiply
/// Encoding: 66 0F 59 ModR/M
pub fn PeirEnc_mulpd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x59);
    PeirEnc_modrm_xmm(self, dst, src);
}

/// divpd xmm_dst, xmm_src — SSE2 packed double divide
/// Encoding: 66 0F 5E ModR/M
pub fn PeirEnc_divpd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x5E);
    PeirEnc_modrm_xmm(self, dst, src);
}

/// movapd xmm_dst, xmm_src — SSE2 move aligned packed double
/// Encoding: 66 0F 28 ModR/M
pub fn PeirEnc_movapd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x28);
    PeirEnc_modrm_xmm(self, dst, src);
}

/// movsd xmm_dst, xmm_src — SSE2 move scalar double
/// Encoding: F2 0F 10 ModR/M
pub fn PeirEnc_movsd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0xF2);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x10);
    PeirEnc_modrm_xmm(self, dst, src);
}

/// addpd xmm_dst, [rbp+disp] — SSE2 add from memory
pub fn PeirEnc_addpd_mem_rbp(self: &mut PeirEnc, dst: i64, disp: i64) -> void {
    self.code.push(0x66);
    if xmm_high(dst) {
        var rex: i64 = 0x40 | 0x04;
        self.code.push(rex);
    }
    self.code.push(0x0F);
    self.code.push(0x58);
    // ModR/M: mod=01 (disp8) or 10 (disp32) | reg=dst | rm=rbp(5)
    if disp >= 0 - 128 && disp <= 127 {
        self.code.push(0x40 | ((dst & 7) << 3) | 5);
        self.code.push(disp & 0xFF);
    } else {
        self.code.push(0x80 | ((dst & 7) << 3) | 5);
        PeirEnc_emit_i32(self, disp);
    }
}

/// movapd [rbp+disp], xmm_src — SSE2 store to memory
pub fn PeirEnc_movapd_mem_rbp(self: &mut PeirEnc, disp: i64, src: i64) -> void {
    self.code.push(0x66);
    if xmm_high(src) {
        var rex: i64 = 0x40 | 0x01;
        self.code.push(rex);
    }
    self.code.push(0x0F);
    self.code.push(0x29); // movapd m128, xmm
    if disp >= 0 - 128 && disp <= 127 {
        self.code.push(0x40 | ((src & 7) << 3) | 5);
        self.code.push(disp & 0xFF);
    } else {
        self.code.push(0x80 | ((src & 7) << 3) | 5);
        PeirEnc_emit_i32(self, disp);
    }
}

/// movapd xmm_dst, [rbp+disp] — SSE2 load from memory
pub fn PeirEnc_movapd_rbp_reg(self: &mut PeirEnc, dst: i64, disp: i64) -> void {
    self.code.push(0x66);
    if xmm_high(dst) {
        var rex: i64 = 0x40 | 0x04;
        self.code.push(rex);
    }
    self.code.push(0x0F);
    self.code.push(0x28);
    if disp >= 0 - 128 && disp <= 127 {
        self.code.push(0x40 | ((dst & 7) << 3) | 5);
        self.code.push(disp & 0xFF);
    } else {
        self.code.push(0x80 | ((dst & 7) << 3) | 5);
        PeirEnc_emit_i32(self, disp);
    }
}

// ─── AVX packed double-precision (f64x4) instructions ───
// VEX prefix encoding: C5 or C4 prefix + opcode + ModR/M
// For simplicity, we use 2-byte VEX (C5) when possible.

/// Emit 2-byte VEX prefix for AVX instruction
/// v_dst = destination XMM, v_src = source XMM (second operand)
pub fn PeirEnc_vex2(self: &mut PeirEnc, dst: i64, src: i64, opcode_len: i64) -> void {
    // C5 [R.vvvv:1=L'.0 | R:1=~R | V:4=~vvvv]
    // For 2-byte VEX: implied 0F leading opcode byte
    var r_bit: i64 = 1;
    if xmm_high(dst) { r_bit = 0; } // inverted
    var vvvv: i64 = (~(src & 0x0F)) & 0x0F; // inverted
    var vex_byte: i64 = 0xC0 | (r_bit << 7) | (vvvv << 3);
    self.code.push(0xC5);
    self.code.push(vex_byte);
}

/// vaddpd xmm_dst, xmm_src1, xmm_src2 — AVX packed double add
/// Encoding: C5 [vex] 58 ModR/M
pub fn PeirEnc_vaddpd_rr(self: &mut PeirEnc, dst: i64, src1: i64, src2: i64) -> void {
    PeirEnc_vex2(self, dst, src1, 1);
    self.code.push(0x58);
    // ModR/M: 11 | dst | src2
    var modrm: i64 = 0xC0 | ((dst & 7) << 3) | (src2 & 7);
    self.code.push(modrm);
    // If src2 is high, we need REX.B via VEX.X bit — but 2-byte VEX doesn't
    // have X. For simplicity, only support src2 in 0-7 when using 2-byte VEX.
}

/// vmulpd xmm_dst, xmm_src1, xmm_src2 — AVX packed double multiply
pub fn PeirEnc_vmulpd_rr(self: &mut PeirEnc, dst: i64, src1: i64, src2: i64) -> void {
    PeirEnc_vex2(self, dst, src1, 1);
    self.code.push(0x59);
    var modrm: i64 = 0xC0 | ((dst & 7) << 3) | (src2 & 7);
    self.code.push(modrm);
}

/// mov r64, imm64 (10 bytes)
pub fn PeirEnc_mov_imm64(self: &mut PeirEnc, r: i64, val: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xB8 + peir_reg_code(r));
    PeirEnc_emit_u64(self, val);
}

/// mov r64, imm in its shortest form: mov r32 (zero-extends), imm32
/// sign-extended, or movabs. Flags are left alone.
pub fn PeirEnc_mov_imm(self: &mut PeirEnc, r: i64, val: i64) -> void {
    if val >= 0 && val <= 0xFFFFFFFF {
        if reg_ext(r) { self.code.push(0x41); }
        self.code.push(0xB8 + peir_reg_code(r));
        PeirEnc_emit_u32(self, val);
    } else if val >= 0 - 2147483648 && val <= 2147483647 {
        PeirEnc_mov_imm32(self, r, val);
    } else {
        PeirEnc_mov_imm64(self, r, val);
    }
}

/// mov r64, imm32 (sign-extended, 7 bytes)
pub fn PeirEnc_mov_imm32(self: &mut PeirEnc, r: i64, val: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xC7);
    PeirEnc_modrm(self, 3, 0, peir_reg_code(r));
    PeirEnc_emit_i32(self, val);
}

/// mov r64, r64
pub fn PeirEnc_mov_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x89);
    PeirEnc_modrm_rr(self, src, dst);
}

// A frame offset at or above this names register peir_value_reg(offset -
// PEIR_REG_SLOT). Values are read and written through mov_reg_mem_rbp and
// mov_mem_rbp_reg, so every instruction works on a register value unchanged;
// anything else that takes an offset must not get one (emit_mem_rbp panics).
pub const PEIR_REG_SLOT: i64 = 0x7F000000;
pub const PEIR_VALUE_REGS: i64 = 7;

/// The callee-saved registers that hold values instead of stack slots.
pub fn peir_value_reg(i: i64) -> i64 {
    if i == 0 { return PEIR_RBX; }
    if i == 1 { return PEIR_RSI; }
    if i == 2 { return PEIR_RDI; }
    return PEIR_R12 + i - 3;
}

/// mov r64, [rbp + disp]
pub fn PeirEnc_mov_reg_mem_rbp(self: &mut PeirEnc, dst: i64, disp: i64) -> void {
    if disp >= PEIR_REG_SLOT {
        self.last_store_end = -1;
        var src: i64 = peir_value_reg(disp - PEIR_REG_SLOT);
        if dst != src { PeirEnc_mov_rr(self, dst, src); }
        return;
    }
    if self.last_store_end == self.code.len() && disp == self.last_store_disp {
        // The slot was just written from a register and nothing was emitted
        // since — forward the register, skip the reload.
        self.last_store_end = -1;
        if dst != self.last_store_reg {
            PeirEnc_mov_rr(self, dst, self.last_store_reg);
        }
        return;
    }
    self.last_store_end = -1;
    PeirEnc_rex(self, true, reg_ext(dst), false, false);
    self.code.push(0x8B);
    PeirEnc_emit_mem_rbp(self, peir_reg_code(dst), disp);
}

/// mov [rbp + disp], r64
pub fn PeirEnc_mov_mem_rbp_reg(self: &mut PeirEnc, disp: i64, src: i64) -> void {
    if disp >= PEIR_REG_SLOT {
        PeirEnc_mov_rr(self, peir_value_reg(disp - PEIR_REG_SLOT), src);
        return;
    }
    PeirEnc_rex(self, true, reg_ext(src), false, false);
    self.code.push(0x89);
    PeirEnc_emit_mem_rbp(self, peir_reg_code(src), disp);
    self.last_store_disp = disp;
    self.last_store_reg = src;
    self.last_store_end = self.code.len();
}

/// Emit RBP-relative memory operand (ModR/M + optional SIB + displacement)
/// For RBP base: mod=01 for disp8, mod=10 for disp32
/// RBP with mod=00 means RIP-relative, so we always need a displacement.
pub fn PeirEnc_emit_mem_rbp(self: &mut PeirEnc, regc: i64, disp: i64) -> void {
    if disp >= PEIR_REG_SLOT { panic("pe_ir: a register value used as memory"); }
    if disp == 0 {
        // RBP with mod=00 is RIP-relative, so we must use disp8=0
        PeirEnc_modrm(self, 1, regc, 5); // RBP = 5
        self.code.push(0);
    } else if disp >= 0 - 128 && disp <= 127 {
        PeirEnc_modrm(self, 1, regc, 5);
        self.code.push(disp & 0xFF);
    } else {
        PeirEnc_modrm(self, 2, regc, 5);
        PeirEnc_emit_i32(self, disp);
    }
}

/// Emit memory operand for [reg + disp] where reg is NOT RBP/RSP
pub fn PeirEnc_emit_mem_reg(self: &mut PeirEnc, regc: i64, base: i64, disp: i64) -> void {
    if peir_reg_code(base) == 4 {
        // RSP/R12 require SIB byte
        if disp == 0 {
            PeirEnc_modrm(self, 0, regc, 4);
            self.code.push(0x24);
        } else if disp >= 0 - 128 && disp <= 127 {
            PeirEnc_modrm(self, 1, regc, 4);
            self.code.push(0x24);
            self.code.push(disp & 0xFF);
        } else {
            PeirEnc_modrm(self, 2, regc, 4);
            self.code.push(0x24);
            PeirEnc_emit_i32(self, disp);
        }
    } else if disp == 0 && peir_reg_code(base) != 5 {
        PeirEnc_modrm(self, 0, regc, peir_reg_code(base));
    } else if disp == 0 && peir_reg_code(base) == 5 {
        // RBP/R13 with disp=0 needs mod=01 disp8=0
        PeirEnc_modrm(self, 1, regc, 5);
        self.code.push(0);
    } else if disp >= 0 - 128 && disp <= 127 {
        PeirEnc_modrm(self, 1, regc, peir_reg_code(base));
        self.code.push(disp & 0xFF);
    } else {
        PeirEnc_modrm(self, 2, regc, peir_reg_code(base));
        PeirEnc_emit_i32(self, disp);
    }
}

/// lea r64, [rbp + disp32] — compute address of RBP-relative slot
pub fn PeirEnc_lea_rbp(self: &mut PeirEnc, dst: i64, disp: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, false);
    self.code.push(0x8D);
    PeirEnc_emit_mem_rbp(self, peir_reg_code(dst), disp);
}

/// lea r64, [rip + rdata_offset] — RIP-relative, patched later
pub fn PeirEnc_lea_rip(self: &mut PeirEnc, dst: i64, rdata_offset: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, false);
    self.code.push(0x8D);
    // RIP-relative: mod=00, rm=101
    PeirEnc_modrm(self, 0, peir_reg_code(dst), 5);
    // Record pending RIP-relative reference
    self.pending_rip_refs.push(PeirRipRef_new(self.code.len(), rdata_offset));
    PeirEnc_emit_i32(self, 0); // placeholder, patched later
}

/// lea r64, [rip + disp32] — load address of a code label (for function ptrs)
pub fn PeirEnc_lea_label(self: &mut PeirEnc, dst: i64, label: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, false);
    self.code.push(0x8D);
    // RIP-relative: mod=00, rm=101
    PeirEnc_modrm(self, 0, peir_reg_code(dst), 5);
    self.pending_labels.push(PeirReloc_new(self.code.len(), label, PEIR_RELOC_LEALABEL));
    PeirEnc_emit_i32(self, 0); // placeholder, patched later
}

/// call [rip + rdata_offset] — call through IAT, patched later
pub fn PeirEnc_call_rip(self: &mut PeirEnc, rdata_offset: i64) -> void {
    self.code.push(0xFF);
    // mod=00, reg=2 (CALL r/m64), rm=101 (RIP-relative)
    PeirEnc_modrm(self, 0, 2, 5);
    self.pending_rip_refs.push(PeirRipRef_new(self.code.len(), rdata_offset));
    PeirEnc_emit_i32(self, 0); // placeholder
}

/// mov r64, [rip + rdata_offset] — load from .rdata, patched later
pub fn PeirEnc_mov_reg_rip(self: &mut PeirEnc, dst: i64, rdata_offset: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, false);
    self.code.push(0x8B);
    PeirEnc_modrm(self, 0, peir_reg_code(dst), 5);
    self.pending_rip_refs.push(PeirRipRef_new(self.code.len(), rdata_offset));
    PeirEnc_emit_i32(self, 0); // placeholder, patched later
}

/// mov [rip + rdata_offset], r64 — store to .rdata, patched later
pub fn PeirEnc_mov_rip_reg(self: &mut PeirEnc, rdata_offset: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, false);
    self.code.push(0x89);
    PeirEnc_modrm(self, 0, peir_reg_code(src), 5);
    self.pending_rip_refs.push(PeirRipRef_new(self.code.len(), rdata_offset));
    PeirEnc_emit_i32(self, 0); // placeholder, patched later
}

/// call rel32 — direct call to a local label
pub fn PeirEnc_call_label(self: &mut PeirEnc, label: i64) -> void {
    self.code.push(0xE8);
    self.pending_labels.push(PeirReloc_new(self.code.len(), label, PEIR_RELOC_REL32));
    PeirEnc_emit_i32(self, 0); // placeholder
}

/// jmp rel32 — unconditional jump to a local label
pub fn PeirEnc_jmp_label(self: &mut PeirEnc, label: i64) -> void {
    self.code.push(0xE9);
    self.pending_labels.push(PeirReloc_new(self.code.len(), label, PEIR_RELOC_REL32));
    PeirEnc_emit_i32(self, 0); // placeholder
}

/// jcc rel32 — conditional jump to a local label
/// cc is the condition code (e.g., 0x0=jo, 0x4=je, 0x5=jne, etc.)
pub fn PeirEnc_jcc_label(self: &mut PeirEnc, cc: i64, label: i64) -> void {
    self.code.push(0x0F);
    self.code.push((0x80 + cc) & 0xFF);
    self.pending_labels.push(PeirReloc_new(self.code.len(), label, PEIR_RELOC_REL32));
    PeirEnc_emit_i32(self, 0); // placeholder
}

// ─── Arithmetic instructions ───

/// add r64, r64
pub fn PeirEnc_add_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x01);
    PeirEnc_modrm_rr(self, src, dst);
}

/// sub r64, r64
pub fn PeirEnc_sub_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x29);
    PeirEnc_modrm_rr(self, src, dst);
}

/// imul r, r, imm32: OF is set as by imul r, r/m
pub fn PeirEnc_imul_r_i32(self: &mut PeirEnc, r: i64, imm: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(r), false, reg_ext(r));
    self.code.push(0x69);
    PeirEnc_modrm_rr(self, r, r);
    PeirEnc_emit_i32(self, imm);
}

/// imul r64, r64
pub fn PeirEnc_imul_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(src));
    self.code.push(0x0F);
    self.code.push(0xAF);
    PeirEnc_modrm_rr(self, dst, src);
}

/// idiv r/m64
pub fn PeirEnc_idiv_r(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xF7);
    PeirEnc_modrm(self, 3, 7, peir_reg_code(r));
}

/// and r64, r64
pub fn PeirEnc_and_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x21);
    PeirEnc_modrm_rr(self, src, dst);
}

/// or r64, r64
pub fn PeirEnc_or_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x09);
    PeirEnc_modrm_rr(self, src, dst);
}

/// xor r64, r64
pub fn PeirEnc_xor_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x31);
    PeirEnc_modrm_rr(self, src, dst);
}

/// not r64
pub fn PeirEnc_not_r(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xF7);
    PeirEnc_modrm(self, 3, 2, peir_reg_code(r));
}

/// neg r64
pub fn PeirEnc_neg_r(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xF7);
    PeirEnc_modrm(self, 3, 3, peir_reg_code(r));
}

/// cmp r64, r64
pub fn PeirEnc_cmp_rr(self: &mut PeirEnc, left: i64, right: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(left), false, reg_ext(right));
    self.code.push(0x3B);
    PeirEnc_modrm_rr(self, left, right);
}

/// cmp r8, imm8 (compare low byte of reg with immediate)
pub fn PeirEnc_cmp_r8_i8(self: &mut PeirEnc, r: i64, val: i64) -> void {
    var need_rex: bool = reg_ext(r) || peir_reg_code(r) >= 4;
    if need_rex {
        PeirEnc_rex(self, false, false, false, reg_ext(r));
    }
    self.code.push(0x80);
    PeirEnc_modrm(self, 3, 7, peir_reg_code(r) & 7);
    self.code.push(val & 0xFF);
}

/// test r64, r64
pub fn PeirEnc_test_rr(self: &mut PeirEnc, left: i64, right: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(right), false, reg_ext(left));
    self.code.push(0x85);
    PeirEnc_modrm_rr(self, right, left);
}

/// shl r64, cl
pub fn PeirEnc_shl_cl(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xD3);
    PeirEnc_modrm(self, 3, 4, peir_reg_code(r));
}

/// shl r64, imm8
pub fn PeirEnc_shl_r_i8(self: &mut PeirEnc, r: i64, count: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xC1);
    PeirEnc_modrm(self, 3, 4, peir_reg_code(r));
    self.code.push(count & 0xFF);
}

/// div r/m64 (unsigned divide RDX:RAX by operand, quotient RAX, rem RDX)
pub fn PeirEnc_div_rr(self: &mut PeirEnc, src: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(src));
    self.code.push(0xF7);
    PeirEnc_modrm(self, 3, 6, peir_reg_code(src));
}

/// mul r/m64 (unsigned RDX:RAX = RAX * operand; OF and CF set when RDX != 0)
pub fn PeirEnc_mul_r(self: &mut PeirEnc, src: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(src));
    self.code.push(0xF7);
    PeirEnc_modrm(self, 3, 4, peir_reg_code(src));
}

/// shr r64, cl
pub fn PeirEnc_shr_cl(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xD3);
    PeirEnc_modrm(self, 3, 5, peir_reg_code(r));
}

/// mov r32, r32 (zero-extends into the 64-bit register)
pub fn PeirEnc_mov_r32_r32(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x89);
    PeirEnc_modrm(self, 3, peir_reg_code(src), peir_reg_code(dst));
}

/// sar r64, cl
pub fn PeirEnc_sar_cl(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xD3);
    PeirEnc_modrm(self, 3, 7, peir_reg_code(r));
}

/// cqo (sign-extend RAX into RDX:RAX)
pub fn PeirEnc_cqo(self: &mut PeirEnc) -> void {
    PeirEnc_rex_w(self);
    self.code.push(0x99);
}

/// movzx r32, r/m8 (zero-extend byte to dword)
pub fn PeirEnc_movzx_r32_r8(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    var need_rex: bool = reg_ext(dst) || reg_ext(src) || peir_reg_code(src) == 4; // RSP/SP needs REX
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(dst), false, reg_ext(src));
    }
    self.code.push(0x0F);
    self.code.push(0xB6);
    PeirEnc_modrm_rr(self, dst, src);
}

/// movzx r32, r16 (zero-extend word to dword)
pub fn PeirEnc_movzx_r32_r16(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    if reg_ext(dst) || reg_ext(src) {
        PeirEnc_rex(self, false, reg_ext(dst), false, reg_ext(src));
    }
    self.code.push(0x0F);
    self.code.push(0xB7);
    PeirEnc_modrm_rr(self, dst, src);
}

/// movsxd r64, r32 (sign-extend dword to qword)
pub fn PeirEnc_movsxd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(src));
    self.code.push(0x63);
    PeirEnc_modrm_rr(self, dst, src);
}

/// movsx r64, r8 (sign-extend byte to qword)
pub fn PeirEnc_movsx_r64_r8(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(src));
    self.code.push(0x0F);
    self.code.push(0xBE);
    PeirEnc_modrm_rr(self, dst, src);
}

/// movsx r64, r16 (sign-extend word to qword)
pub fn PeirEnc_movsx_r64_r16(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(src));
    self.code.push(0x0F);
    self.code.push(0xBF);
    PeirEnc_modrm_rr(self, dst, src);
}

/// setcc r/m8 — set byte on condition
pub fn PeirEnc_setcc_r(self: &mut PeirEnc, cc: i64, r: i64) -> void {
    if reg_ext(r) {
        PeirEnc_rex(self, false, false, false, true);
    }
    self.code.push(0x0F);
    self.code.push((0x90 + cc) & 0xFF);
    PeirEnc_modrm(self, 3, 0, peir_reg_code(r));
}

/// sub rsp, imm8
pub fn PeirEnc_sub_rsp_i8(self: &mut PeirEnc, val: i64) -> void {
    PeirEnc_rex_w(self);
    self.code.push(0x83);
    PeirEnc_modrm(self, 3, 5, 4); // /5 = sub, rm=RSP
    self.code.push(val & 0xFF);
}

/// sub rsp, imm32
pub fn PeirEnc_sub_rsp_i32(self: &mut PeirEnc, val: i64) -> void {
    PeirEnc_rex_w(self);
    self.code.push(0x81);
    PeirEnc_modrm(self, 3, 5, 4); // /5 = sub, rm=RSP
    PeirEnc_emit_i32(self, val);
}

/// add rsp, imm8
pub fn PeirEnc_add_rsp_i8(self: &mut PeirEnc, val: i64) -> void {
    PeirEnc_rex_w(self);
    self.code.push(0x83);
    PeirEnc_modrm(self, 3, 0, 4); // /0 = add, rm=RSP
    self.code.push(val & 0xFF);
}

/// add rsp, imm32
pub fn PeirEnc_add_rsp_i32(self: &mut PeirEnc, val: i64) -> void {
    PeirEnc_rex_w(self);
    self.code.push(0x81);
    PeirEnc_modrm(self, 3, 0, 4); // /0 = add, rm=RSP
    PeirEnc_emit_i32(self, val);
}

/// add r64, imm32
pub fn PeirEnc_add_r_i32(self: &mut PeirEnc, r: i64, val: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0x81);
    PeirEnc_modrm(self, 3, 0, peir_reg_code(r));
    PeirEnc_emit_i32(self, val);
}

/// add r64, imm8
pub fn PeirEnc_add_r_i8(self: &mut PeirEnc, r: i64, val: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0x83);
    PeirEnc_modrm(self, 3, 0, peir_reg_code(r));
    self.code.push(val & 0xFF);
}

/// mov r8, imm8 (for byte stores)
pub fn PeirEnc_mov_r8_imm(self: &mut PeirEnc, r: i64, val: i64) -> void {
    if reg_ext(r) {
        PeirEnc_rex(self, false, false, false, true);
    }
    self.code.push((0xB0 + peir_reg_code(r)) & 0xFF);
    self.code.push(val & 0xFF);
}

/// mov r8b, [reg] (byte load through pointer, handles RBP/R13 and RSP/R12)
pub fn PeirEnc_mov_reg8_mem(self: &mut PeirEnc, dst: i64, base: i64) -> void {
    var need_rex: bool = reg_ext(dst) || reg_ext(base) || peir_reg_code(dst) >= 4 || peir_reg_code(base) >= 4;
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(dst), false, reg_ext(base));
    }
    self.code.push(0x8A);
    var low3: i64 = peir_reg_code(base) & 7;
    if low3 == 4 {
        // RSP/R12: need SIB
        PeirEnc_modrm(self, 0, peir_reg_code(dst) & 7, 4);
        self.code.push(0x24);
    } else if low3 == 5 {
        // RBP/R13: mod=00 means RIP-relative, use mod=01 with disp8=0
        PeirEnc_modrm(self, 1, peir_reg_code(dst) & 7, 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst) & 7, low3);
    }
}

/// mov [reg], r8b (byte store through pointer, handles RBP/R13 and RSP/R12)
pub fn PeirEnc_mov_mem_reg8_ptr(self: &mut PeirEnc, base: i64, src: i64) -> void {
    var need_rex: bool = reg_ext(src) || reg_ext(base) || peir_reg_code(src) >= 4 || peir_reg_code(base) >= 4;
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(base));
    }
    self.code.push(0x88);
    var low3: i64 = peir_reg_code(base) & 7;
    if low3 == 4 {
        // RSP/R12: need SIB
        PeirEnc_modrm(self, 0, peir_reg_code(src) & 7, 4);
        self.code.push(0x24);
    } else if low3 == 5 {
        // RBP/R13: mod=00 means RIP-relative, use mod=01 with disp8=0
        PeirEnc_modrm(self, 1, peir_reg_code(src) & 7, 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src) & 7, low3);
    }
}

/// mov [reg], r8 (byte store through pointer)
pub fn PeirEnc_mov_mem_reg8(self: &mut PeirEnc, base: i64, src: i64) -> void {
    var need_rex: bool = reg_ext(src) || reg_ext(base) || peir_reg_code(src) >= 4 || peir_reg_code(base) >= 4;
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(base));
    }
    self.code.push(0x88);
    if (peir_reg_code(base) & 7) == 4 {
        // RSP or R12: need SIB byte
        PeirEnc_modrm(self, 0, peir_reg_code(src), 4);
        self.code.push(0x24); // SIB: scale=0, index=none, base=RSP/R12
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src), peir_reg_code(base));
    }
}

/// mov [reg + disp], r8 (byte store with displacement)
pub fn PeirEnc_mov_mem_disp_reg8(self: &mut PeirEnc, base: i64, disp: i64, src: i64) -> void {
    var need_rex: bool = reg_ext(src) || reg_ext(base) || peir_reg_code(src) >= 4 || peir_reg_code(base) >= 4;
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(base));
    }
    self.code.push(0x88);
    if (peir_reg_code(base) & 7) == 4 {
        // RSP or R12: need SIB byte
        if disp >= 0 - 128 && disp <= 127 {
            PeirEnc_modrm(self, 1, peir_reg_code(src), 4);
            self.code.push(0x24);
            self.code.push(disp & 0xFF);
        } else {
            PeirEnc_modrm(self, 2, peir_reg_code(src), 4);
            self.code.push(0x24);
            PeirEnc_emit_i32(self, disp);
        }
    } else if disp >= 0 - 128 && disp <= 127 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), peir_reg_code(base));
        self.code.push(disp & 0xFF);
    } else {
        PeirEnc_modrm(self, 2, peir_reg_code(src), peir_reg_code(base));
        PeirEnc_emit_i32(self, disp);
    }
}

/// mov [reg + reg], r8 (byte store with index)
pub fn PeirEnc_mov_mem_idx_reg8(self: &mut PeirEnc, base: i64, index: i64, src: i64) -> void {
    PeirEnc_rex(self, false, reg_ext(src), reg_ext(index), reg_ext(base));
    self.code.push(0x88);
    // Use SIB: mod=00, reg=src, rm=100 (SIB follows)
    // But if base is RBP/R13 (code 5), mod=00 means [disp32 + index], not
    // [base + index]. Use mod=01 with 0 displacement instead.
    if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), 4);
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
        self.code.push(0); // disp8 = 0
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src), 4);
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
    }
}

/// mov r8, [reg + reg] (byte load with index)
pub fn PeirEnc_mov_reg8_mem_idx(self: &mut PeirEnc, dst: i64, base: i64, index: i64) -> void {
    PeirEnc_rex(self, false, reg_ext(dst), reg_ext(index), reg_ext(base));
    self.code.push(0x8A);
    if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(dst), 4);
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
        self.code.push(0); // disp8 = 0
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), 4);
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
    }
}

/// cmp byte [reg + reg], imm8
pub fn PeirEnc_cmp_mem_idx_imm8(self: &mut PeirEnc, base: i64, index: i64, val: i64) -> void {
    PeirEnc_rex(self, false, false, reg_ext(index), reg_ext(base));
    self.code.push(0x80);
    if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, 7, 4); // /7 = cmp, rm=100 (SIB), mod=01 for RBP/R13
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
        self.code.push(0); // disp8 = 0
    } else {
        PeirEnc_modrm(self, 0, 7, 4); // /7 = cmp, rm=100 (SIB)
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
    }
    self.code.push(val & 0xFF);
}

/// inc r64
pub fn PeirEnc_inc_r(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xFF);
    PeirEnc_modrm(self, 3, 0, peir_reg_code(r));
}

/// dec r64
pub fn PeirEnc_dec_r(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xFF);
    PeirEnc_modrm(self, 3, 1, peir_reg_code(r));
}

/// xor r64, r64 (zero a register)
pub fn PeirEnc_xor_self(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_xor_rr(self, r, r);
}

/// mov rax, [reg] (load through pointer, 64-bit)
pub fn PeirEnc_mov_reg_ptr(self: &mut PeirEnc, dst: i64, base: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(base));
    self.code.push(0x8B);
    if peir_reg_code(base) == 4 {
        // RSP/R12 require SIB byte
        PeirEnc_modrm(self, 0, peir_reg_code(dst), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        // RBP/R13 require mod=01 with disp8=0
        PeirEnc_modrm(self, 1, peir_reg_code(dst), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), peir_reg_code(base));
    }
}

/// mov [reg], r64 (store through pointer, 64-bit)
pub fn PeirEnc_mov_ptr_reg(self: &mut PeirEnc, base: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(base));
    self.code.push(0x89);
    if peir_reg_code(base) == 4 {
        PeirEnc_modrm(self, 0, peir_reg_code(src), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src), peir_reg_code(base));
    }
}

/// mov [reg], r32 (32-bit store through pointer, no REX.W)
pub fn PeirEnc_mov_ptr_reg32(self: &mut PeirEnc, base: i64, src: i64) -> void {
    var need_rex: bool = reg_ext(src) || reg_ext(base);
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(base));
    }
    self.code.push(0x89);
    if peir_reg_code(base) == 4 {
        PeirEnc_modrm(self, 0, peir_reg_code(src), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src), peir_reg_code(base));
    }
}

/// mov [reg], r16 (16-bit store through pointer, 0x66 prefix)
pub fn PeirEnc_mov_ptr_reg16(self: &mut PeirEnc, base: i64, src: i64) -> void {
    self.code.push(0x66); // operand-size override
    var need_rex: bool = reg_ext(src) || reg_ext(base);
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(base));
    }
    self.code.push(0x89);
    if peir_reg_code(base) == 4 {
        PeirEnc_modrm(self, 0, peir_reg_code(src), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src), peir_reg_code(base));
    }
}

/// mov r8, [reg] (byte load through pointer)
pub fn PeirEnc_mov_reg8_ptr(self: &mut PeirEnc, dst: i64, base: i64) -> void {
    var need_rex: bool = reg_ext(dst) || reg_ext(base) || peir_reg_code(dst) >= 4 || peir_reg_code(base) >= 4;
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(dst), false, reg_ext(base));
    }
    self.code.push(0x8A);
    if peir_reg_code(base) == 4 {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(dst), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), peir_reg_code(base));
    }
}

/// mov r32, [reg] (32-bit load through pointer, no REX.W)
pub fn PeirEnc_mov_reg32_ptr(self: &mut PeirEnc, dst: i64, base: i64) -> void {
    var need_rex: bool = reg_ext(dst) || reg_ext(base);
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(dst), false, reg_ext(base));
    }
    self.code.push(0x8B);
    if peir_reg_code(base) == 4 {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(dst), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), peir_reg_code(base));
    }
}

/// mov r16, [reg] (16-bit load through pointer, 0x66 prefix)
pub fn PeirEnc_mov_reg16_ptr(self: &mut PeirEnc, dst: i64, base: i64) -> void {
    self.code.push(0x66); // operand-size override
    var need_rex: bool = reg_ext(dst) || reg_ext(base);
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(dst), false, reg_ext(base));
    }
    self.code.push(0x8B);
    if peir_reg_code(base) == 4 {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(dst), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), peir_reg_code(base));
    }
}

/// mov rax, [reg + reg*1] (load with index, 64-bit)
pub fn PeirEnc_mov_reg_mem_idx(self: &mut PeirEnc, dst: i64, base: i64, index: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), reg_ext(index), reg_ext(base));
    self.code.push(0x8B);
    if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(dst), 4); // SIB with disp8=0 for RBP/R13
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), 4); // SIB
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
    }
}

/// mov [reg + reg*1], r64 (store with index, 64-bit)
pub fn PeirEnc_mov_mem_idx_reg(self: &mut PeirEnc, base: i64, index: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), reg_ext(index), reg_ext(base));
    self.code.push(0x89);
    if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), 4); // SIB with disp8=0 for RBP/R13
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src), 4); // SIB
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
    }
}

/// mov rax, [reg + disp32] (load through pointer with displacement)
pub fn PeirEnc_mov_reg_mem_disp(self: &mut PeirEnc, dst: i64, base: i64, disp: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(base));
    self.code.push(0x8B);
    if peir_reg_code(base) == 4 {
        if disp >= 0 - 128 && disp <= 127 {
            PeirEnc_modrm(self, 1, peir_reg_code(dst), 4);
            self.code.push(0x24);
            self.code.push(disp & 0xFF);
        } else {
            PeirEnc_modrm(self, 2, peir_reg_code(dst), 4);
            self.code.push(0x24);
            PeirEnc_emit_i32(self, disp);
        }
    } else if disp >= 0 - 128 && disp <= 127 {
        PeirEnc_modrm(self, 1, peir_reg_code(dst), peir_reg_code(base));
        self.code.push(disp & 0xFF);
    } else {
        PeirEnc_modrm(self, 2, peir_reg_code(dst), peir_reg_code(base));
        PeirEnc_emit_i32(self, disp);
    }
}

/// mov [reg + disp32], r64 (store through pointer with displacement)
pub fn PeirEnc_mov_mem_disp_reg(self: &mut PeirEnc, base: i64, disp: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(base));
    self.code.push(0x89);
    if peir_reg_code(base) == 4 {
        if disp >= 0 - 128 && disp <= 127 {
            PeirEnc_modrm(self, 1, peir_reg_code(src), 4);
            self.code.push(0x24);
            self.code.push(disp & 0xFF);
        } else {
            PeirEnc_modrm(self, 2, peir_reg_code(src), 4);
            self.code.push(0x24);
            PeirEnc_emit_i32(self, disp);
        }
    } else if disp >= 0 - 128 && disp <= 127 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), peir_reg_code(base));
        self.code.push(disp & 0xFF);
    } else {
        PeirEnc_modrm(self, 2, peir_reg_code(src), peir_reg_code(base));
        PeirEnc_emit_i32(self, disp);
    }
}

/// mov [reg + disp], r32 (32-bit store, no REX.W)
pub fn PeirEnc_mov_mem_disp_reg32(self: &mut PeirEnc, base: i64, disp: i64, src: i64) -> void {
    var need_rex: bool = reg_ext(src) || reg_ext(base);
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(base));
    }
    self.code.push(0x89);
    if peir_reg_code(base) == 4 {
        if disp >= 0 - 128 && disp <= 127 {
            PeirEnc_modrm(self, 1, peir_reg_code(src), 4);
            self.code.push(0x24);
            self.code.push(disp & 0xFF);
        } else {
            PeirEnc_modrm(self, 2, peir_reg_code(src), 4);
            self.code.push(0x24);
            PeirEnc_emit_i32(self, disp);
        }
    } else if disp >= 0 - 128 && disp <= 127 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), peir_reg_code(base));
        self.code.push(disp & 0xFF);
    } else {
        PeirEnc_modrm(self, 2, peir_reg_code(src), peir_reg_code(base));
        PeirEnc_emit_i32(self, disp);
    }
}

/// imul r64, r64, imm32 (three-operand imul)
pub fn PeirEnc_imul_r_r_imm32(self: &mut PeirEnc, dst: i64, src: i64, val: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(src));
    self.code.push(0x69);
    PeirEnc_modrm_rr(self, dst, src);
    PeirEnc_emit_i32(self, val);
}

/// call r64 (indirect call through register)
/// NOTE: Rust emits the REX byte unconditionally (0x40 when not extended).
pub fn PeirEnc_call_reg(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, false, false, false, reg_ext(r));
    self.code.push(0xFF);
    PeirEnc_modrm(self, 3, 2, peir_reg_code(r));
}

