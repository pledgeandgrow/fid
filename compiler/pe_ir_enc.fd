// pe_ir_enc.fd -- x86-64 machine-code encoder and PE file-format writer for
// the IR -> .exe backend (compiler/pe_ir.fd). Ported line-by-line from the
// top half of src/pe.rs: PeirEnc (bytes, labels, RIP-relative refs),
// the kernel32/msvcrt import tables, PeirRdata, and build_pe_file.
//
// Adaptations from Rust (same as arm64_enc.fd):
// 1. u8/u16/u32/u64/usize -> i64; byte emission masks with & 0xFF
// 2. Reg/XmmReg enums -> i64 register ids (PEIR_RAX..PEIR_R15, XMM0..XMM15)
// 3. HashMap<u32, usize> labels -> Vec<i64> indexed by label id (-1 = unset)
// 4. struct methods -> free functions with `self: &mut PeirEnc` /
//    `self: &mut PeirRdata`
// 5. Option<usize> -> i64 (-1 = None)
//
// Windows x64 calling convention (for reference):
//   - Integer args: RCX, RDX, R8, R9 (then stack); return: RAX
//   - Shadow space: 32 bytes; stack 16-byte aligned before CALL

module compiler::pe_ir_enc;
use core;
use vec;
use string;
use compiler::image_writer;
use compiler::nat_enc;
// ===========================================================================
// Register ids (Reg / XmmReg in Rust)
// ===========================================================================

pub const PEIR_RAX: i64 = 0;
pub const PEIR_RCX: i64 = 1;
pub const PEIR_RDX: i64 = 2;
pub const PEIR_RBX: i64 = 3;
pub const PEIR_RSP: i64 = 4;
pub const PEIR_RBP: i64 = 5;
pub const PEIR_RSI: i64 = 6;
pub const PEIR_RDI: i64 = 7;
pub const PEIR_R8: i64 = 8;
pub const PEIR_R9: i64 = 9;
pub const PEIR_R10: i64 = 10;
pub const PEIR_R11: i64 = 11;
pub const PEIR_R12: i64 = 12;
pub const PEIR_R13: i64 = 13;
pub const PEIR_R14: i64 = 14;
pub const PEIR_R15: i64 = 15;
pub const XMM0: i64 = 0;
pub const XMM1: i64 = 1;
pub const XMM2: i64 = 2;
pub const XMM3: i64 = 3;
pub const XMM4: i64 = 4;
pub const XMM5: i64 = 5;
pub const XMM6: i64 = 6;
pub const XMM7: i64 = 7;
pub const XMM8: i64 = 8;
pub const XMM9: i64 = 9;
pub const XMM10: i64 = 10;
pub const XMM11: i64 = 11;
pub const XMM12: i64 = 12;
pub const XMM13: i64 = 13;
pub const XMM14: i64 = 14;
pub const XMM15: i64 = 15;
/// Low 3 bits (ModR/M encoding) — Reg::code
pub fn peir_reg_code(r: i64) -> i64 {
    return r & 7;
}

/// True if this is an extended register (R8-R15, needs REX.B/R)
pub fn reg_ext(r: i64) -> bool {
    return r >= 8;
}

/// Is this a high XMM register (8-15) requiring REX prefix? — XmmReg::is_high
pub fn xmm_high(x: i64) -> bool {
    return x >= 8;
}

// ===========================================================================
// Relocation kinds (RelocKind in Rust)
// ===========================================================================

/// Relative jump/call (rel32): disp32 = target - (code_offset + 4)
pub const PEIR_RELOC_REL32: i64 = 0;
/// RIP-relative data access: disp32 = target_rva - (code_rva + 4)
/// (marker only — rip refs use PeirRipRef, not PeirReloc)
pub const PEIR_RELOC_RIPREL32: i64 = 1;
/// RIP-relative lea to a code label: disp32 = target_code - (code_offset + 4)
pub const PEIR_RELOC_LEALABEL: i64 = 2;
/// Pending relocation — a location in code that needs to be patched
/// after all labels are resolved
pub struct PeirReloc {
    /// Offset in code buffer where the 4-byte displacement should be written
    pub code_offset: i64,
    /// Target label ID
    pub target_label: i64,
    /// Type of relocation (PEIR_RELOC_*)
    pub kind: i64,
}

pub fn PeirReloc_new(code_offset: i64, target_label: i64, kind: i64) -> PeirReloc {
    return PeirReloc {
        code_offset: code_offset, target_label: target_label, kind: kind
    };
}

/// Pending RIP-relative reference to .rdata section
pub struct PeirRipRef {
    /// Offset in code buffer where the 4-byte displacement should be written
    pub code_offset: i64,
    /// Offset within .rdata section of the target
    pub rdata_offset: i64,
}

pub fn PeirRipRef_new(code_offset: i64, rdata_offset: i64) -> PeirRipRef {
    return PeirRipRef {
        code_offset: code_offset, rdata_offset: rdata_offset
    };
}

// ===========================================================================
// PeirEnc — the x86_64 machine code encoder
// ===========================================================================

pub struct PeirEnc {
    /// Accumulated machine code bytes
    pub code: Vec<i64>,
    /// Label positions: label_id -> code offset, -1 = not placed
    pub labels: Vec<i64>,
    /// Pending label relocations (jumps, calls within .text)
    pub pending_labels: Vec<PeirReloc>,
    /// Pending RIP-relative references to .rdata
    pub pending_rip_refs: Vec<PeirRipRef>,
    /// Next label ID
    pub next_label: i64,
    /// Peephole: (disp, src reg, code position after the instruction) of
    /// the last emitted `mov [rbp+disp], src`. last_store_end = -1 = none.
    /// mov_reg_mem_rbp forwards the register instead of reloading when no
    /// byte was emitted in between (code is append-only). place_label
    /// clears it — a load at a branch target is never wrongly forwarded.
    pub last_store_disp: i64,
    pub last_store_reg: i64,
    pub last_store_end: i64,
    /// Copy propagation (D13): the last move emitted through
    /// PeirEnc_mov_rr_cp (kind 1: `mov dst, src`) or PeirEnc_mov_imm_cp
    /// (kind 2: `mov dst, imm`, src = imm) and the code position after it;
    /// last_mov_end = -1 = none. A _cp move right after it that repeats it,
    /// or (kind 1) copies back, is not emitted: the registers already hold
    /// that. Cleared like last_store_end (place_label, emit_bytes).
    pub last_mov_kind: i64,
    pub last_mov_dst: i64,
    pub last_mov_src: i64,
    pub last_mov_end: i64,
}

pub fn PeirEnc_new() -> PeirEnc {
    return PeirEnc {
        code: Vec::new(), labels: Vec::new(), pending_labels: Vec::new(), pending_rip_refs: Vec::new(), next_label: 0, last_store_disp: 0, last_store_reg: 0, last_store_end: -1, last_mov_kind: 0, last_mov_dst: 0, last_mov_src: 0, last_mov_end: -1,
    };
}

/// Allocate a new label ID
pub fn PeirEnc_alloc_label(self: &mut PeirEnc) -> i64 {
    var id: i64 = self.next_label;
    self.next_label = self.next_label + 1;
    self.labels.push(-1);
    return id;
}

/// Mark a label at the current code position
pub fn PeirEnc_place_label(self: &mut PeirEnc, label: i64) -> void {
    self.last_store_end = -1;
    self.last_mov_end = -1;
    self.labels.set(label, self.code.len());
}

/// B5 (the per-function cache): a label at code offset `pos`
pub fn PeirEnc_set_label(self: &mut PeirEnc, label: i64, pos: i64) -> void {
    self.labels.set(label, pos);
}

/// B5: bytes copied in as they are (their references come after)
pub fn PeirEnc_emit_bytes(self: &mut PeirEnc, bytes: Vec<i64>) -> void {
    self.last_store_end = -1;
    self.last_mov_end = -1;
    var i: i64 = 0;
    while i < bytes.len() {
        self.code.push(bytes.get(i));
        i = i + 1;
    }
}

/// B5: a label reference at code offset `pos` (4 bytes)
pub fn PeirEnc_add_reloc(self: &mut PeirEnc, pos: i64, label: i64, kind: i64) -> void {
    self.pending_labels.push(PeirReloc_new(pos, label, kind));
}

/// B5: an .rdata reference at code offset `pos` (4 bytes)
pub fn PeirEnc_add_rip_ref(self: &mut PeirEnc, pos: i64, rdata_offset: i64) -> void {
    self.pending_rip_refs.push(PeirRipRef_new(pos, rdata_offset));
}

/// Align code output to a boundary using multi-byte NOPs.
pub fn PeirEnc_align_to(self: &mut PeirEnc, boundary: i64) -> void {
    if boundary == 0 {
        return;
    }
    var cur: i64 = self.code.len();
    var rem: i64 = cur % boundary;
    if rem == 0 {
        return;
    }
    var pad: i64 = boundary - rem;
    var remaining: i64 = pad;
    while remaining >= 8 {
        // NOPS[7]: 0F 1F 84 00 00 00 00 00
        self.code.push(0x0F);
        self.code.push(0x1F);
        self.code.push(0x84);
        self.code.push(0x00);
        self.code.push(0x00);
        self.code.push(0x00);
        self.code.push(0x00);
        self.code.push(0x00);
        remaining = remaining - 8;
    }
    if remaining == 1 {
        self.code.push(0x90);
    } else if remaining == 2 {
        self.code.push(0x66);
        self.code.push(0x90);
    } else if remaining == 3 {
        self.code.push(0x0F);
        self.code.push(0x1F);
        self.code.push(0x00);
    } else if remaining == 4 {
        self.code.push(0x0F);
        self.code.push(0x1F);
        self.code.push(0x40);
        self.code.push(0x00);
    } else if remaining == 5 {
        self.code.push(0x0F);
        self.code.push(0x1F);
        self.code.push(0x44);
        self.code.push(0x00);
        self.code.push(0x00);
    } else if remaining == 6 {
        self.code.push(0x66);
        self.code.push(0x0F);
        self.code.push(0x1F);
        self.code.push(0x44);
        self.code.push(0x00);
        self.code.push(0x00);
    } else if remaining == 7 {
        self.code.push(0x0F);
        self.code.push(0x1F);
        self.code.push(0x80);
        self.code.push(0x00);
        self.code.push(0x00);
        self.code.push(0x00);
        self.code.push(0x00);
    }
}

/// Get current code offset
pub fn PeirEnc_offset(self: &PeirEnc) -> i64 {
    return self.code.len();
}

/// Emit raw bytes (masked to 0..255)
pub fn PeirEnc_emit(self: &mut PeirEnc, bytes: Vec<i64>) -> void {
    var i: i64 = 0;
    while i < bytes.len() {
        self.code.push(bytes.get(i) & 0xFF);
        i = i + 1;
    }
}

pub fn PeirEnc_emit_u8(self: &mut PeirEnc, b: i64) -> void {
    self.code.push(b & 0xFF);
}

pub fn PeirEnc_emit_u16(self: &mut PeirEnc, w: i64) -> void {
    self.code.push(w & 0xFF);
    self.code.push((w >> 8) & 0xFF);
}

pub fn PeirEnc_emit_u32(self: &mut PeirEnc, d: i64) -> void {
    self.code.push(d & 0xFF);
    self.code.push((d >> 8) & 0xFF);
    self.code.push((d >> 16) & 0xFF);
    self.code.push((d >> 24) & 0xFF);
}

/// emit_i32 — same little-endian byte layout as emit_u32
pub fn PeirEnc_emit_i32(self: &mut PeirEnc, d: i64) -> void {
    PeirEnc_emit_u32(self, d);
}

pub fn PeirEnc_emit_u64(self: &mut PeirEnc, q: i64) -> void {
    self.code.push(q & 0xFF);
    self.code.push((q >> 8) & 0xFF);
    self.code.push((q >> 16) & 0xFF);
    self.code.push((q >> 24) & 0xFF);
    self.code.push((q >> 32) & 0xFF);
    self.code.push((q >> 40) & 0xFF);
    self.code.push((q >> 48) & 0xFF);
    self.code.push((q >> 56) & 0xFF);
}

/// Emit REX prefix
/// w: 64-bit operand size
/// r: extends ModR/M.reg (dst register)
/// x: extends SIB.index
/// b: extends ModR/M.r/m or SIB.base or opcode reg
pub fn PeirEnc_rex(self: &mut PeirEnc, w: bool, r: bool, x: bool, b: bool) -> void {
    var rex: i64 = 0x40;
    if w {
        rex = rex | 0x08;
    }
    if r {
        rex = rex | 0x04;
    }
    if x {
        rex = rex | 0x02;
    }
    if b {
        rex = rex | 0x01;
    }
    self.code.push(rex);
}

/// Emit REX.W prefix (64-bit operand, no extended regs)
pub fn PeirEnc_rex_w(self: &mut PeirEnc) -> void {
    PeirEnc_rex(self, true, false, false, false);
}

/// Emit ModR/M byte
pub fn PeirEnc_modrm(self: &mut PeirEnc, m: i64, reg: i64, rm: i64) -> void {
    self.code.push(((m & 3) << 6) | ((reg & 7) << 3) | (rm & 7));
}

/// Encode a register-to-register ModR/M (mod=11)
pub fn PeirEnc_modrm_rr(self: &mut PeirEnc, reg: i64, rm: i64) -> void {
    PeirEnc_modrm(self, 3, peir_reg_code(reg), peir_reg_code(rm));
}

// ─── Common instruction encodings ───

/// push r64
pub fn PeirEnc_push(self: &mut PeirEnc, r: i64) -> void {
    if reg_ext(r) {
        PeirEnc_rex(self, false, false, false, true);
    }
    self.code.push(0x50 + peir_reg_code(r));
}

/// pop r64
pub fn PeirEnc_pop(self: &mut PeirEnc, r: i64) -> void {
    if reg_ext(r) {
        PeirEnc_rex(self, false, false, false, true);
    }
    self.code.push(0x58 + peir_reg_code(r));
}

/// ret
pub fn PeirEnc_ret(self: &mut PeirEnc) -> void {
    self.code.push(0xC3);
}

/// nop
pub fn PeirEnc_nop(self: &mut PeirEnc) -> void {
    self.code.push(0x90);
}

/// ud2
pub fn PeirEnc_ud2(self: &mut PeirEnc) -> void {
    self.code.push(0x0F);
    self.code.push(0x0B);
}

// ─── SSE2 packed double-precision (f64x2) instructions ───
// These operate on XMM registers. Encoding: 66 0F <opcode> ModR/M
// For register-to-register: ModR/M = 11 (mod) | reg (dst) | rm (src)

/// Emit REX prefix for XMM register pair (dst, src)
pub fn PeirEnc_rex_sse(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    var w: bool = false;
    var r: bool = xmm_high(dst);
    var b: bool = xmm_high(src);
    if w || r || b {
        var rex: i64 = 0x40;
        if w {
            rex = rex | 0x08;
        }
        if r {
            rex = rex | 0x04;
        }
        if b {
            rex = rex | 0x01;
        }
        self.code.push(rex);
    }
}

/// BG89: the REX prefix of an SSE instruction whose ModRM.reg register is
/// `reg` and ModRM.rm register is `rm` (xmm or general registers, numbered
/// 0-15): 0100WR0B, left out when W, R and B are all 0. It goes after the
/// mandatory 66/F2/F3 prefix, right before 0F.
pub fn PeirEnc_rex_sse_rm(self: &mut PeirEnc, w: bool, reg: i64, rm: i64) -> void {
    if w || reg >= 8 || rm >= 8 {
        PeirEnc_rex(self, w, reg >= 8, false, rm >= 8);
    }
}

/// ModR/M byte for XMM reg-to-reg: 11 | dst_code | src_code
pub fn PeirEnc_modrm_xmm(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    var modrm: i64 = 0xC0 | ((dst & 7) << 3) | (src & 7);
    self.code.push(modrm);
}

/// addpd xmm_dst, xmm_src — SSE2 packed double add
/// Encoding: 66 0F 58 ModR/M
pub fn PeirEnc_addpd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x58);
    PeirEnc_modrm_xmm(self, dst, src);
}

/// subpd xmm_dst, xmm_src — SSE2 packed double subtract
/// Encoding: 66 0F 5C ModR/M
pub fn PeirEnc_subpd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x5C);
    PeirEnc_modrm_xmm(self, dst, src);
}

/// mulpd xmm_dst, xmm_src — SSE2 packed double multiply
/// Encoding: 66 0F 59 ModR/M
pub fn PeirEnc_mulpd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x59);
    PeirEnc_modrm_xmm(self, dst, src);
}

/// divpd xmm_dst, xmm_src — SSE2 packed double divide
/// Encoding: 66 0F 5E ModR/M
pub fn PeirEnc_divpd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x5E);
    PeirEnc_modrm_xmm(self, dst, src);
}

/// movapd xmm_dst, xmm_src — SSE2 move aligned packed double
/// Encoding: 66 0F 28 ModR/M
pub fn PeirEnc_movapd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x28);
    PeirEnc_modrm_xmm(self, dst, src);
}

/// movsd xmm_dst, xmm_src — SSE2 move scalar double
/// Encoding: F2 0F 10 ModR/M
pub fn PeirEnc_movsd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0xF2);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x10);
    PeirEnc_modrm_xmm(self, dst, src);
}

/// addpd xmm_dst, [rbp+disp] — SSE2 add from memory
pub fn PeirEnc_addpd_mem_rbp(self: &mut PeirEnc, dst: i64, disp: i64) -> void {
    self.code.push(0x66);
    if xmm_high(dst) {
        var rex: i64 = 0x40 | 0x04;
        self.code.push(rex);
    }
    self.code.push(0x0F);
    self.code.push(0x58);
    // ModR/M: mod=01 (disp8) or 10 (disp32) | reg=dst | rm=rbp(5)
    if disp >= 0 - 128 && disp <= 127 {
        self.code.push(0x40 | ((dst & 7) << 3) | 5);
        self.code.push(disp & 0xFF);
    } else {
        self.code.push(0x80 | ((dst & 7) << 3) | 5);
        PeirEnc_emit_i32(self, disp);
    }
}

/// movapd [rbp+disp], xmm_src — SSE2 store to memory
pub fn PeirEnc_movapd_mem_rbp(self: &mut PeirEnc, disp: i64, src: i64) -> void {
    self.code.push(0x66);
    if xmm_high(src) {
        // BG89: 66 0F 29 /r has the xmm register in ModRM.reg: REX.R (44),
        // not REX.B (41, which extended rbp to r13)
        var rex: i64 = 0x40 | 0x04;
        self.code.push(rex);
    }
    self.code.push(0x0F);
    self.code.push(0x29);
    // movapd m128, xmm
    if disp >= 0 - 128 && disp <= 127 {
        self.code.push(0x40 | ((src & 7) << 3) | 5);
        self.code.push(disp & 0xFF);
    } else {
        self.code.push(0x80 | ((src & 7) << 3) | 5);
        PeirEnc_emit_i32(self, disp);
    }
}

/// movapd xmm_dst, [rbp+disp] — SSE2 load from memory
pub fn PeirEnc_movapd_rbp_reg(self: &mut PeirEnc, dst: i64, disp: i64) -> void {
    self.code.push(0x66);
    if xmm_high(dst) {
        var rex: i64 = 0x40 | 0x04;
        self.code.push(rex);
    }
    self.code.push(0x0F);
    self.code.push(0x28);
    if disp >= 0 - 128 && disp <= 127 {
        self.code.push(0x40 | ((dst & 7) << 3) | 5);
        self.code.push(disp & 0xFF);
    } else {
        self.code.push(0x80 | ((dst & 7) << 3) | 5);
        PeirEnc_emit_i32(self, disp);
    }
}

// ─── AVX packed double-precision (f64x4) instructions ───
// VEX prefix encoding: C5 or C4 prefix + opcode + ModR/M
// For simplicity, we use 2-byte VEX (C5) when possible.

/// The VEX prefix of an instruction in map 0F (BG90: the old one set bit 6
/// always, dropped L and pp, and had no 3-byte form). `reg` is ModRM.reg,
/// `v` the vvvv register, `rm` ModRM.rm (0-15 each), `l` VEX.L (1 = 256
/// bits), `pp` the implied prefix (0 none, 1 66, 2 F3, 3 F2); W is 0.
/// When rm is 0-7 it is the 2-byte form C5 [~R ~vvvv L pp]; otherwise the
/// 3-byte form C4 [~R ~X ~B 00001] [W=0 ~vvvv L pp] (B extends rm).
pub fn PeirEnc_vex2(self: &mut PeirEnc, reg: i64, v: i64, rm: i64, l: i64, pp: i64) -> void {
    var nr: i64 = (((reg >> 3) & 1) ^ 1) << 7;
    var tail: i64 = (((v & 15) ^ 15) << 3) | ((l & 1) << 2) | (pp & 3);
    if rm < 8 {
        self.code.push(0xC5);
        self.code.push(nr | tail);
    } else {
        // ~X = 1 (no index), ~B = 0 (rm is 8-15), map 0F = 00001
        self.code.push(0xC4);
        self.code.push(nr | 0x40 | 0x01);
        self.code.push(tail);
    }
}

/// vaddpd ymm_dst, ymm_src1, ymm_src2 — AVX packed double add (f64x4):
/// VEX.256.66.0F.WIG 58 /r, ModRM.reg = dst, vvvv = src1, ModRM.rm = src2.
/// `vaddpd ymm0, ymm1, ymm2` = C5 F5 58 C2.
pub fn PeirEnc_vaddpd_rr(self: &mut PeirEnc, dst: i64, src1: i64, src2: i64) -> void {
    PeirEnc_vex2(self, dst, src1, src2, 1, 1);
    self.code.push(0x58);
    // ModR/M: 11 | dst | src2 (the high bits are in the VEX prefix)
    var modrm: i64 = 0xC0 | ((dst & 7) << 3) | (src2 & 7);
    self.code.push(modrm);
}

/// vmulpd ymm_dst, ymm_src1, ymm_src2 — AVX packed double multiply:
/// VEX.256.66.0F.WIG 59 /r. `vmulpd ymm0, ymm1, ymm2` = C5 F5 59 C2.
pub fn PeirEnc_vmulpd_rr(self: &mut PeirEnc, dst: i64, src1: i64, src2: i64) -> void {
    PeirEnc_vex2(self, dst, src1, src2, 1, 1);
    self.code.push(0x59);
    var modrm: i64 = 0xC0 | ((dst & 7) << 3) | (src2 & 7);
    self.code.push(modrm);
}

/// mov r64, imm64 (10 bytes)
pub fn PeirEnc_mov_imm64(self: &mut PeirEnc, r: i64, val: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xB8 + peir_reg_code(r));
    PeirEnc_emit_u64(self, val);
}

/// mov r64, imm in its shortest form: mov r32 (zero-extends), imm32
/// sign-extended, or movabs. Flags are left alone.
pub fn PeirEnc_mov_imm(self: &mut PeirEnc, r: i64, val: i64) -> void {
    if val >= 0 && val <= 0xFFFFFFFF {
        if reg_ext(r) {
            self.code.push(0x41);
        }
        self.code.push(0xB8 + peir_reg_code(r));
        PeirEnc_emit_u32(self, val);
    } else if val >= 0 - 2147483648 && val <= 2147483647 {
        PeirEnc_mov_imm32(self, r, val);
    } else {
        PeirEnc_mov_imm64(self, r, val);
    }
}

/// mov r64, imm32 (sign-extended, 7 bytes)
pub fn PeirEnc_mov_imm32(self: &mut PeirEnc, r: i64, val: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xC7);
    PeirEnc_modrm(self, 3, 0, peir_reg_code(r));
    PeirEnc_emit_i32(self, val);
}

/// mov r64, r64
pub fn PeirEnc_mov_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x89);
    PeirEnc_modrm_rr(self, src, dst);
}

/// D13: whether the _cp moves leave out repeated moves (pe_ir.fd sets it
/// per function from FID_PE_OFF=cprop).
pub var g_peir_cp: bool = true;

/// D13 copy propagation: `mov dst, src`, left out when dst is src or when
/// the move emitted just before (through a _cp move, nothing in between)
/// was this one or `mov src, dst`. Only for the moves between values that
/// pe_ir.fd's generator emits (no hand-counted jump crosses them).
pub fn PeirEnc_mov_rr_cp(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    if dst == src {
        return;
    }
    if g_peir_cp && self.last_mov_end == self.code.len() && self.last_mov_kind == 1 {
        if (self.last_mov_dst == src && self.last_mov_src == dst) || (self.last_mov_dst == dst && self.last_mov_src == src) {
            return;
        }
    }
    PeirEnc_mov_rr(self, dst, src);
    self.last_mov_kind = 1;
    self.last_mov_dst = dst;
    self.last_mov_src = src;
    self.last_mov_end = self.code.len();
}

/// D13 copy propagation: `mov r, val` (PeirEnc_mov_imm), left out when the
/// move emitted just before (through a _cp move) put the same value in r.
pub fn PeirEnc_mov_imm_cp(self: &mut PeirEnc, r: i64, val: i64) -> void {
    if g_peir_cp && self.last_mov_end == self.code.len() && self.last_mov_kind == 2 && self.last_mov_dst == r && self.last_mov_src == val {
        return;
    }
    PeirEnc_mov_imm(self, r, val);
    self.last_mov_kind = 2;
    self.last_mov_dst = r;
    self.last_mov_src = val;
    self.last_mov_end = self.code.len();
}

// A frame offset at or above this names register peir_value_reg(offset -
// PEIR_REG_SLOT). Values are read and written through mov_reg_mem_rbp and
// mov_mem_rbp_reg, so every instruction works on a register value unchanged;
// anything else that takes an offset must not get one (emit_mem_rbp panics).
pub const PEIR_REG_SLOT: i64 = 0x7F000000;
pub const PEIR_VALUE_REGS: i64 = 7;
/// Value registers 7 and 8 are r10 and r11: caller-saved, so only a value
/// whose live range has no call (and nothing else that uses them) gets one
/// (competitive OP16). Value registers 9 and 10 are r8 and r9 (D4): also
/// argument registers, so only a value whose live range neither holds a
/// call nor starts or ends at one (nor is a parameter) gets one.
pub const PEIR_ALL_REGS: i64 = 11;
/// The first of the value registers that are argument registers (r8, r9)
pub const PEIR_ARG_VALUE_REGS: i64 = 9;
/// A frame offset at or above this names xmm register (offset -
/// PEIR_XMM_SLOT): an f64 value kept in a register (competitive OP17).
pub const PEIR_XMM_SLOT: i64 = 0x7F000100;
/// The registers that hold values instead of stack slots: seven
/// callee-saved ones, then r10 and r11, then r8 and r9 (D4).
pub fn peir_value_reg(i: i64) -> i64 {
    if i == 0 {
        return PEIR_RBX;
    }
    if i == 1 {
        return PEIR_RSI;
    }
    if i == 2 {
        return PEIR_RDI;
    }
    if i == 7 {
        return PEIR_R10;
    }
    if i == 8 {
        return PEIR_R11;
    }
    if i == 9 {
        return PEIR_R8;
    }
    if i == 10 {
        return PEIR_R9;
    }
    return PEIR_R12 + i - 3;
}

pub fn peir_is_xmm_slot(disp: i64) -> bool {
    return disp >= PEIR_XMM_SLOT;
}

/// movq r64, xmm: 66 REX.W 0F 7E /r, ModRM.reg = xmm (REX.R for
/// xmm8-15, BG89), ModRM.rm = r64 (REX.B for r8-r15)
pub fn PeirEnc_movq_r64_xmm(self: &mut PeirEnc, r: i64, xmm: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex(self, true, xmm_high(xmm), false, reg_ext(r));
    self.code.push(0x0F);
    self.code.push(0x7E);
    PeirEnc_modrm(self, 3, xmm, peir_reg_code(r));
}

/// movdqu [rbp + disp], xmm (a callee-saved xmm register, all 128 bits):
/// F3 [REX.R for xmm8-15, BG89] 0F 7F /r
pub fn PeirEnc_movdqu_mem_rbp_xmm(self: &mut PeirEnc, disp: i64, xmm: i64) -> void {
    self.code.push(0xF3);
    PeirEnc_rex_sse_rm(self, false, xmm, 0);
    self.code.push(0x0F);
    self.code.push(0x7F);
    PeirEnc_emit_mem_rbp(self, xmm & 7, disp);
}

/// movdqu xmm, [rbp + disp]: F3 [REX.R for xmm8-15, BG89] 0F 6F /r
pub fn PeirEnc_movdqu_xmm_mem_rbp(self: &mut PeirEnc, xmm: i64, disp: i64) -> void {
    self.code.push(0xF3);
    PeirEnc_rex_sse_rm(self, false, xmm, 0);
    self.code.push(0x0F);
    self.code.push(0x6F);
    PeirEnc_emit_mem_rbp(self, xmm & 7, disp);
}

/// cmp r64, imm (the 8-bit form when it fits)
pub fn PeirEnc_cmp_r_imm(self: &mut PeirEnc, r: i64, imm: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    if imm >= -128 && imm <= 127 {
        self.code.push(0x83);
        PeirEnc_modrm(self, 3, 7, peir_reg_code(r));
        self.code.push(imm & 0xFF);
    } else {
        self.code.push(0x81);
        PeirEnc_modrm(self, 3, 7, peir_reg_code(r));
        PeirEnc_emit_i32(self, imm);
    }
}

/// add r64, imm (the 8-bit form when it fits)
pub fn PeirEnc_add_r_imm(self: &mut PeirEnc, r: i64, imm: i64) -> void {
    if imm >= -128 && imm <= 127 {
        PeirEnc_add_r_i8(self, r, imm);
    } else {
        PeirEnc_add_r_i32(self, r, imm);
    }
}

/// imul dst, src, imm (the 8-bit form when it fits)
pub fn PeirEnc_imul_r_r_imm(self: &mut PeirEnc, dst: i64, src: i64, imm: i64) -> void {
    if imm >= -128 && imm <= 127 {
        PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(src));
        self.code.push(0x6B);
        PeirEnc_modrm_rr(self, dst, src);
        self.code.push(imm & 0xFF);
    } else {
        PeirEnc_imul_r_r_imm32(self, dst, src, imm);
    }
}

/// lea dst, [base + disp]
pub fn PeirEnc_lea_base_disp(self: &mut PeirEnc, dst: i64, base: i64, disp: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(base));
    self.code.push(0x8D);
    var bc: i64 = peir_reg_code(base);
    var small: bool = disp >= -128 && disp <= 127;
    var m: i64 = 2;
    if small {
        m = 1;
    }
    PeirEnc_modrm(self, m, peir_reg_code(dst), bc);
    // rsp and r12 as a base need a SIB byte
    if bc == 4 {
        self.code.push(0x24);
    }
    if small {
        self.code.push(disp & 0xFF);
    } else {
        PeirEnc_emit_i32(self, disp);
    }
}

/// lea dst, [base + index * (1 << scale)]
pub fn PeirEnc_lea_base_index(self: &mut PeirEnc, dst: i64, base: i64, index: i64, scale: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), reg_ext(index), reg_ext(base));
    self.code.push(0x8D);
    var bc: i64 = peir_reg_code(base);
    // rbp and r13 as a base need a displacement: [base + index*s + 0]
    if bc == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(dst), 4);
        self.code.push(((scale & 3) << 6) | (peir_reg_code(index) << 3) | bc);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), 4);
        self.code.push(((scale & 3) << 6) | (peir_reg_code(index) << 3) | bc);
    }
}

/// A 64-bit instruction `opcode` with a memory operand [base + disp], or
/// [base + index*8 + disp] when index >= 0; `reg` is the ModRM reg field
/// (a register, or an opcode extension when `reg_is_reg` is false).
pub fn PeirEnc_mem_op(self: &mut PeirEnc, opcode: i64, reg: i64, reg_is_reg: bool, base: i64, index: i64, disp: i64) -> void {
    PeirEnc_rex(self, true, reg_is_reg && reg_ext(reg), index >= 0 && reg_ext(index), reg_ext(base));
    self.code.push(opcode);
    var bc: i64 = peir_reg_code(base);
    var m: i64 = 2;
    if disp == 0 && bc != 5 {
        m = 0;
    } else if disp >= -128 && disp <= 127 {
        m = 1;
    }
    var rf: i64 = reg & 7;
    if index >= 0 {
        PeirEnc_modrm(self, m, rf, 4);
        self.code.push((3 << 6) | (peir_reg_code(index) << 3) | bc);
    } else if bc == 4 {
        PeirEnc_modrm(self, m, rf, 4);
        self.code.push(0x24);
    } else {
        PeirEnc_modrm(self, m, rf, bc);
    }
    if m == 1 {
        self.code.push(disp & 0xFF);
    }
    if m == 2 {
        PeirEnc_emit_i32(self, disp);
    }
}

/// movzx r32, byte [base + index] (zero-extends into all of r64)
pub fn PeirEnc_movzx_r_byte_idx(self: &mut PeirEnc, r: i64, base: i64, index: i64) -> void {
    if reg_ext(r) || reg_ext(index) || reg_ext(base) {
        PeirEnc_rex(self, false, reg_ext(r), reg_ext(index), reg_ext(base));
    }
    self.code.push(0x0F);
    self.code.push(0xB6);
    PeirEnc_byte_idx_modrm(self, r, base, index);
}

/// mov byte [base + index], r8 (the low byte of r)
pub fn PeirEnc_mov_byte_idx_r(self: &mut PeirEnc, base: i64, index: i64, r: i64) -> void {
    // without a REX prefix, byte registers 4-7 are ah..bh, not spl..dil
    if reg_ext(r) || reg_ext(index) || reg_ext(base) || peir_reg_code(r) >= 4 {
        PeirEnc_rex(self, false, reg_ext(r), reg_ext(index), reg_ext(base));
    }
    self.code.push(0x88);
    PeirEnc_byte_idx_modrm(self, r, base, index);
}

/// ModRM + SIB of [base + index*1]
fn PeirEnc_byte_idx_modrm(self: &mut PeirEnc, r: i64, base: i64, index: i64) -> void {
    var bc: i64 = peir_reg_code(base);
    if bc == 5 {
        PeirEnc_modrm(self, 1, r & 7, 4);
        self.code.push((peir_reg_code(index) << 3) | bc);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, r & 7, 4);
        self.code.push((peir_reg_code(index) << 3) | bc);
    }
}

/// cmp r64, [base + disp]
pub fn PeirEnc_cmp_r_mem(self: &mut PeirEnc, r: i64, base: i64, disp: i64) -> void {
    PeirEnc_mem_op(self, 0x3B, r, true, base, -1, disp);
}

/// cmp qword [base + disp], imm8
pub fn PeirEnc_cmp_mem_imm8(self: &mut PeirEnc, base: i64, disp: i64, imm: i64) -> void {
    PeirEnc_mem_op(self, 0x83, 7, false, base, -1, disp);
    self.code.push(imm & 0xFF);
}

/// or r64, [base + disp]
pub fn PeirEnc_or_r_mem(self: &mut PeirEnc, r: i64, base: i64, disp: i64) -> void {
    PeirEnc_mem_op(self, 0x0B, r, true, base, -1, disp);
}

/// mov r64, [base + index*8]
pub fn PeirEnc_mov_r_idx8(self: &mut PeirEnc, r: i64, base: i64, index: i64) -> void {
    PeirEnc_mem_op(self, 0x8B, r, true, base, index, 0);
}

/// mov [base + index*8], r64
pub fn PeirEnc_mov_idx8_r(self: &mut PeirEnc, base: i64, index: i64, r: i64) -> void {
    PeirEnc_mem_op(self, 0x89, r, true, base, index, 0);
}

/// mov r64, [rbp + disp]
pub fn PeirEnc_mov_reg_mem_rbp(self: &mut PeirEnc, dst: i64, disp: i64) -> void {
    if disp >= PEIR_XMM_SLOT {
        self.last_store_end = -1;
        PeirEnc_movq_r64_xmm(self, dst, disp - PEIR_XMM_SLOT);
        return;
    }
    if disp >= PEIR_REG_SLOT {
        self.last_store_end = -1;
        var src: i64 = peir_value_reg(disp - PEIR_REG_SLOT);
        if dst != src {
            PeirEnc_mov_rr_cp(self, dst, src);
        }
        return;
    }
    if self.last_store_end == self.code.len() && disp == self.last_store_disp {
        // The slot was just written from a register and nothing was emitted
        // since — forward the register, skip the reload.
        self.last_store_end = -1;
        if dst != self.last_store_reg {
            PeirEnc_mov_rr_cp(self, dst, self.last_store_reg);
        }
        return;
    }
    self.last_store_end = -1;
    PeirEnc_rex(self, true, reg_ext(dst), false, false);
    self.code.push(0x8B);
    PeirEnc_emit_mem_rbp(self, peir_reg_code(dst), disp);
}

/// mov [rbp + disp], r64
pub fn PeirEnc_mov_mem_rbp_reg(self: &mut PeirEnc, disp: i64, src: i64) -> void {
    if disp >= PEIR_XMM_SLOT {
        self.last_store_end = -1;
        PeirEnc_movq_xmm_r64(self, disp - PEIR_XMM_SLOT, src);
        return;
    }
    if disp >= PEIR_REG_SLOT {
        self.last_store_end = -1;
        var rd: i64 = peir_value_reg(disp - PEIR_REG_SLOT);
        if rd != src {
            PeirEnc_mov_rr_cp(self, rd, src);
        }
        return;
    }
    PeirEnc_rex(self, true, reg_ext(src), false, false);
    self.code.push(0x89);
    PeirEnc_emit_mem_rbp(self, peir_reg_code(src), disp);
    self.last_store_disp = disp;
    self.last_store_reg = src;
    self.last_store_end = self.code.len();
}

/// Emit RBP-relative memory operand (ModR/M + optional SIB + displacement)
/// For RBP base: mod=01 for disp8, mod=10 for disp32
/// RBP with mod=00 means RIP-relative, so we always need a displacement.
pub fn PeirEnc_emit_mem_rbp(self: &mut PeirEnc, regc: i64, disp: i64) -> void {
    if disp >= PEIR_REG_SLOT {
        panic("pe_ir: a register value used as memory");
    }
    if disp == 0 {
        // RBP with mod=00 is RIP-relative, so we must use disp8=0
        PeirEnc_modrm(self, 1, regc, 5);
        // RBP = 5
        self.code.push(0);
    } else if disp >= 0 - 128 && disp <= 127 {
        PeirEnc_modrm(self, 1, regc, 5);
        self.code.push(disp & 0xFF);
    } else {
        PeirEnc_modrm(self, 2, regc, 5);
        PeirEnc_emit_i32(self, disp);
    }
}

/// Emit memory operand for [reg + disp] where reg is NOT RBP/RSP
pub fn PeirEnc_emit_mem_reg(self: &mut PeirEnc, regc: i64, base: i64, disp: i64) -> void {
    if peir_reg_code(base) == 4 {
        // RSP/R12 require SIB byte
        if disp == 0 {
            PeirEnc_modrm(self, 0, regc, 4);
            self.code.push(0x24);
        } else if disp >= 0 - 128 && disp <= 127 {
            PeirEnc_modrm(self, 1, regc, 4);
            self.code.push(0x24);
            self.code.push(disp & 0xFF);
        } else {
            PeirEnc_modrm(self, 2, regc, 4);
            self.code.push(0x24);
            PeirEnc_emit_i32(self, disp);
        }
    } else if disp == 0 && peir_reg_code(base) != 5 {
        PeirEnc_modrm(self, 0, regc, peir_reg_code(base));
    } else if disp == 0 && peir_reg_code(base) == 5 {
        // RBP/R13 with disp=0 needs mod=01 disp8=0
        PeirEnc_modrm(self, 1, regc, 5);
        self.code.push(0);
    } else if disp >= 0 - 128 && disp <= 127 {
        PeirEnc_modrm(self, 1, regc, peir_reg_code(base));
        self.code.push(disp & 0xFF);
    } else {
        PeirEnc_modrm(self, 2, regc, peir_reg_code(base));
        PeirEnc_emit_i32(self, disp);
    }
}

/// lea r64, [rbp + disp32] — compute address of RBP-relative slot
pub fn PeirEnc_lea_rbp(self: &mut PeirEnc, dst: i64, disp: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, false);
    self.code.push(0x8D);
    PeirEnc_emit_mem_rbp(self, peir_reg_code(dst), disp);
}

/// lea r64, [rip + rdata_offset] — RIP-relative, patched later
pub fn PeirEnc_lea_rip(self: &mut PeirEnc, dst: i64, rdata_offset: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, false);
    self.code.push(0x8D);
    // RIP-relative: mod=00, rm=101
    PeirEnc_modrm(self, 0, peir_reg_code(dst), 5);
    // Record pending RIP-relative reference
    self.pending_rip_refs.push(PeirRipRef_new(self.code.len(), rdata_offset));
    PeirEnc_emit_i32(self, 0);
    // placeholder, patched later
}

/// lea r64, [rip + disp32] — load address of a code label (for function ptrs)
pub fn PeirEnc_lea_label(self: &mut PeirEnc, dst: i64, label: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, false);
    self.code.push(0x8D);
    // RIP-relative: mod=00, rm=101
    PeirEnc_modrm(self, 0, peir_reg_code(dst), 5);
    self.pending_labels.push(PeirReloc_new(self.code.len(), label, PEIR_RELOC_LEALABEL));
    PeirEnc_emit_i32(self, 0);
    // placeholder, patched later
}

/// call [rip + rdata_offset] — call through IAT, patched later
pub fn PeirEnc_call_rip(self: &mut PeirEnc, rdata_offset: i64) -> void {
    self.code.push(0xFF);
    // mod=00, reg=2 (CALL r/m64), rm=101 (RIP-relative)
    PeirEnc_modrm(self, 0, 2, 5);
    self.pending_rip_refs.push(PeirRipRef_new(self.code.len(), rdata_offset));
    PeirEnc_emit_i32(self, 0);
    // placeholder
}

/// mov r64, [rip + rdata_offset] — load from .rdata, patched later
pub fn PeirEnc_mov_reg_rip(self: &mut PeirEnc, dst: i64, rdata_offset: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, false);
    self.code.push(0x8B);
    PeirEnc_modrm(self, 0, peir_reg_code(dst), 5);
    self.pending_rip_refs.push(PeirRipRef_new(self.code.len(), rdata_offset));
    PeirEnc_emit_i32(self, 0);
    // placeholder, patched later
}

/// mov [rip + rdata_offset], r64 — store to .rdata, patched later
pub fn PeirEnc_mov_rip_reg(self: &mut PeirEnc, rdata_offset: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, false);
    self.code.push(0x89);
    PeirEnc_modrm(self, 0, peir_reg_code(src), 5);
    self.pending_rip_refs.push(PeirRipRef_new(self.code.len(), rdata_offset));
    PeirEnc_emit_i32(self, 0);
    // placeholder, patched later
}

/// call rel32 — direct call to a local label
pub fn PeirEnc_call_label(self: &mut PeirEnc, label: i64) -> void {
    self.code.push(0xE8);
    self.pending_labels.push(PeirReloc_new(self.code.len(), label, PEIR_RELOC_REL32));
    PeirEnc_emit_i32(self, 0);
    // placeholder
}

/// jmp rel32 — unconditional jump to a local label
pub fn PeirEnc_jmp_label(self: &mut PeirEnc, label: i64) -> void {
    self.code.push(0xE9);
    self.pending_labels.push(PeirReloc_new(self.code.len(), label, PEIR_RELOC_REL32));
    PeirEnc_emit_i32(self, 0);
    // placeholder
}

/// jcc rel32 — conditional jump to a local label
/// cc is the condition code (e.g., 0x0=jo, 0x4=je, 0x5=jne, etc.)
pub fn PeirEnc_jcc_label(self: &mut PeirEnc, cc: i64, label: i64) -> void {
    self.code.push(0x0F);
    self.code.push((0x80 + cc) & 0xFF);
    self.pending_labels.push(PeirReloc_new(self.code.len(), label, PEIR_RELOC_REL32));
    PeirEnc_emit_i32(self, 0);
    // placeholder
}

// ─── Arithmetic instructions ───

/// add r64, r64
pub fn PeirEnc_add_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x01);
    PeirEnc_modrm_rr(self, src, dst);
}

/// sub r64, r64
pub fn PeirEnc_sub_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x29);
    PeirEnc_modrm_rr(self, src, dst);
}

/// imul r, r, imm32: OF is set as by imul r, r/m
pub fn PeirEnc_imul_r_i32(self: &mut PeirEnc, r: i64, imm: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(r), false, reg_ext(r));
    self.code.push(0x69);
    PeirEnc_modrm_rr(self, r, r);
    PeirEnc_emit_i32(self, imm);
}

/// imul r64, r64
pub fn PeirEnc_imul_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(src));
    self.code.push(0x0F);
    self.code.push(0xAF);
    PeirEnc_modrm_rr(self, dst, src);
}

/// idiv r/m64
pub fn PeirEnc_idiv_r(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xF7);
    PeirEnc_modrm(self, 3, 7, peir_reg_code(r));
}

/// and r64, r64
pub fn PeirEnc_and_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x21);
    PeirEnc_modrm_rr(self, src, dst);
}

/// or r64, r64
pub fn PeirEnc_or_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x09);
    PeirEnc_modrm_rr(self, src, dst);
}

/// xor r64, r64
pub fn PeirEnc_xor_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x31);
    PeirEnc_modrm_rr(self, src, dst);
}

/// not r64
pub fn PeirEnc_not_r(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xF7);
    PeirEnc_modrm(self, 3, 2, peir_reg_code(r));
}

/// neg r64
pub fn PeirEnc_neg_r(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xF7);
    PeirEnc_modrm(self, 3, 3, peir_reg_code(r));
}

/// cmp r64, r64
pub fn PeirEnc_cmp_rr(self: &mut PeirEnc, left: i64, right: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(left), false, reg_ext(right));
    self.code.push(0x3B);
    PeirEnc_modrm_rr(self, left, right);
}

/// cmp r8, imm8 (compare low byte of reg with immediate)
pub fn PeirEnc_cmp_r8_i8(self: &mut PeirEnc, r: i64, val: i64) -> void {
    var need_rex: bool = reg_ext(r) || peir_reg_code(r) >= 4;
    if need_rex {
        PeirEnc_rex(self, false, false, false, reg_ext(r));
    }
    self.code.push(0x80);
    PeirEnc_modrm(self, 3, 7, peir_reg_code(r) & 7);
    self.code.push(val & 0xFF);
}

/// test r64, r64
pub fn PeirEnc_test_rr(self: &mut PeirEnc, left: i64, right: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(right), false, reg_ext(left));
    self.code.push(0x85);
    PeirEnc_modrm_rr(self, right, left);
}

/// shl r64, cl
pub fn PeirEnc_shl_cl(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xD3);
    PeirEnc_modrm(self, 3, 4, peir_reg_code(r));
}

/// shl r64, imm8
pub fn PeirEnc_shl_r_i8(self: &mut PeirEnc, r: i64, count: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xC1);
    PeirEnc_modrm(self, 3, 4, peir_reg_code(r));
    self.code.push(count & 0xFF);
}

/// div r/m64 (unsigned divide RDX:RAX by operand, quotient RAX, rem RDX)
pub fn PeirEnc_div_rr(self: &mut PeirEnc, src: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(src));
    self.code.push(0xF7);
    PeirEnc_modrm(self, 3, 6, peir_reg_code(src));
}

/// mul r/m64 (unsigned RDX:RAX = RAX * operand; OF and CF set when RDX != 0)
pub fn PeirEnc_mul_r(self: &mut PeirEnc, src: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(src));
    self.code.push(0xF7);
    PeirEnc_modrm(self, 3, 4, peir_reg_code(src));
}

/// shr r64, cl
pub fn PeirEnc_shr_cl(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xD3);
    PeirEnc_modrm(self, 3, 5, peir_reg_code(r));
}

/// mov r32, r32 (zero-extends into the 64-bit register)
pub fn PeirEnc_mov_r32_r32(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(dst));
    self.code.push(0x89);
    PeirEnc_modrm(self, 3, peir_reg_code(src), peir_reg_code(dst));
}

/// sar r64, cl
pub fn PeirEnc_sar_cl(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xD3);
    PeirEnc_modrm(self, 3, 7, peir_reg_code(r));
}

// --- OP20: BMI1/BMI2 forms (`fid emit --cpu x86-64-v3|v4`, g_pe_cpu) ---
// The same encodings as the machine layer's x64_shiftx / x64_blsr /
// x64_andn (compiler/nat_enc.fd, checked against clang's assembler): a
// three-byte VEX prefix C4, then R'X'B' and map 0F38 (00010), then W=1,
// the inverted vvvv register, L=0 and pp.

/// The second VEX byte: ModRM.reg's and ModRM.rm's high bits inverted
/// (R and B; X is always 1, no index), map 0F38.
fn peir_vex1(reg: i64, rm: i64) -> i64 {
    return ((((reg >> 3) & 1) ^ 1) << 7) | (1 << 6) | ((((rm >> 3) & 1) ^ 1) << 5) | 0x02;
}

/// The third VEX byte: W=1, vvvv = ~v, L=0, pp.
fn peir_vex2(v: i64, pp: i64) -> i64 {
    return 0x80 | (((v & 15) ^ 15) << 3) | (pp & 3);
}

/// OP20 (BMI2): d = a shifted by b (count masked to 6 bits, as by CL;
/// flags untouched): VEX.LZ.pp.0F38.W1 F7 /r, ModRM.reg = d, ModRM.rm =
/// a, vvvv = b. pp 1 SHLX, 2 SARX, 3 SHRX. `shlx rax, rbx, rcx` =
/// C4 E2 F1 F7 C3.
pub fn PeirEnc_shiftx(self: &mut PeirEnc, pp: i64, d: i64, a: i64, b: i64) -> void {
    self.code.push(0xC4);
    self.code.push(peir_vex1(d, a));
    self.code.push(peir_vex2(b, pp));
    self.code.push(0xF7);
    PeirEnc_modrm_rr(self, d, a);
}

/// OP20 (BMI1): d = a & (a - 1): VEX.LZ.0F38.W1 F3 /1, vvvv = d,
/// ModRM.rm = a. `blsr rax, rcx` = C4 E2 F8 F3 C9.
pub fn PeirEnc_blsr(self: &mut PeirEnc, d: i64, a: i64) -> void {
    self.code.push(0xC4);
    self.code.push(peir_vex1(0, a));
    self.code.push(peir_vex2(d, 0));
    self.code.push(0xF3);
    PeirEnc_modrm(self, 3, 1, peir_reg_code(a));
}

/// OP20 (BMI1): d = ~s & o: VEX.LZ.0F38.W1 F2 /r, ModRM.reg = d, vvvv =
/// s, ModRM.rm = o. `andn rax, rbx, rcx` = C4 E2 E0 F2 C1.
pub fn PeirEnc_andn(self: &mut PeirEnc, d: i64, s: i64, o: i64) -> void {
    self.code.push(0xC4);
    self.code.push(peir_vex1(d, o));
    self.code.push(peir_vex2(s, 0));
    self.code.push(0xF2);
    PeirEnc_modrm_rr(self, d, o);
}

/// cqo (sign-extend RAX into RDX:RAX)
pub fn PeirEnc_cqo(self: &mut PeirEnc) -> void {
    PeirEnc_rex_w(self);
    self.code.push(0x99);
}

/// movzx r32, r/m8 (zero-extend byte to dword)
pub fn PeirEnc_movzx_r32_r8(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    // BG91: without a REX prefix byte registers 4-7 are ah/ch/dh/bh, so
    // spl/bpl/sil/dil (rsp, rbp, rsi, rdi) need one (40), not only spl
    var need_rex: bool = reg_ext(dst) || reg_ext(src) || peir_reg_code(src) >= 4;
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(dst), false, reg_ext(src));
    }
    self.code.push(0x0F);
    self.code.push(0xB6);
    PeirEnc_modrm_rr(self, dst, src);
}

/// movzx r32, r16 (zero-extend word to dword)
pub fn PeirEnc_movzx_r32_r16(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    if reg_ext(dst) || reg_ext(src) {
        PeirEnc_rex(self, false, reg_ext(dst), false, reg_ext(src));
    }
    self.code.push(0x0F);
    self.code.push(0xB7);
    PeirEnc_modrm_rr(self, dst, src);
}

/// movsxd r64, r32 (sign-extend dword to qword)
pub fn PeirEnc_movsxd_rr(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(src));
    self.code.push(0x63);
    PeirEnc_modrm_rr(self, dst, src);
}

/// movsx r64, r8 (sign-extend byte to qword)
pub fn PeirEnc_movsx_r64_r8(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(src));
    self.code.push(0x0F);
    self.code.push(0xBE);
    PeirEnc_modrm_rr(self, dst, src);
}

/// movsx r64, r16 (sign-extend word to qword)
pub fn PeirEnc_movsx_r64_r16(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(src));
    self.code.push(0x0F);
    self.code.push(0xBF);
    PeirEnc_modrm_rr(self, dst, src);
}

/// setcc r/m8 — set byte on condition
pub fn PeirEnc_setcc_r(self: &mut PeirEnc, cc: i64, r: i64) -> void {
    // BG91: [REX] 0F 90+cc /0; registers 4-7 need a REX prefix (40) to be
    // spl/bpl/sil/dil instead of ah/ch/dh/bh. `setl sil` = 40 0F 9C C6.
    if reg_ext(r) || peir_reg_code(r) >= 4 {
        PeirEnc_rex(self, false, false, false, reg_ext(r));
    }
    self.code.push(0x0F);
    self.code.push((0x90 + cc) & 0xFF);
    PeirEnc_modrm(self, 3, 0, peir_reg_code(r));
}

/// sub rsp, imm8
pub fn PeirEnc_sub_rsp_i8(self: &mut PeirEnc, val: i64) -> void {
    PeirEnc_rex_w(self);
    self.code.push(0x83);
    PeirEnc_modrm(self, 3, 5, 4);
    // /5 = sub, rm=RSP
    self.code.push(val & 0xFF);
}

/// sub rsp, imm32
pub fn PeirEnc_sub_rsp_i32(self: &mut PeirEnc, val: i64) -> void {
    PeirEnc_rex_w(self);
    self.code.push(0x81);
    PeirEnc_modrm(self, 3, 5, 4);
    // /5 = sub, rm=RSP
    PeirEnc_emit_i32(self, val);
}

/// add rsp, imm8
pub fn PeirEnc_add_rsp_i8(self: &mut PeirEnc, val: i64) -> void {
    PeirEnc_rex_w(self);
    self.code.push(0x83);
    PeirEnc_modrm(self, 3, 0, 4);
    // /0 = add, rm=RSP
    self.code.push(val & 0xFF);
}

/// add rsp, imm32
pub fn PeirEnc_add_rsp_i32(self: &mut PeirEnc, val: i64) -> void {
    PeirEnc_rex_w(self);
    self.code.push(0x81);
    PeirEnc_modrm(self, 3, 0, 4);
    // /0 = add, rm=RSP
    PeirEnc_emit_i32(self, val);
}

/// add r64, imm32
pub fn PeirEnc_add_r_i32(self: &mut PeirEnc, r: i64, val: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0x81);
    PeirEnc_modrm(self, 3, 0, peir_reg_code(r));
    PeirEnc_emit_i32(self, val);
}

/// add r64, imm8
pub fn PeirEnc_add_r_i8(self: &mut PeirEnc, r: i64, val: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0x83);
    PeirEnc_modrm(self, 3, 0, peir_reg_code(r));
    self.code.push(val & 0xFF);
}

/// mov r8, imm8 (for byte stores)
pub fn PeirEnc_mov_r8_imm(self: &mut PeirEnc, r: i64, val: i64) -> void {
    // BG91: [REX] B0+r ib; registers 4-7 need a REX prefix (40) to be
    // spl/bpl/sil/dil instead of ah/ch/dh/bh. `mov sil, 1` = 40 B6 01.
    if reg_ext(r) || peir_reg_code(r) >= 4 {
        PeirEnc_rex(self, false, false, false, reg_ext(r));
    }
    self.code.push((0xB0 + peir_reg_code(r)) & 0xFF);
    self.code.push(val & 0xFF);
}

/// mov r8b, [reg] (byte load through pointer, handles RBP/R13 and RSP/R12)
pub fn PeirEnc_mov_reg8_mem(self: &mut PeirEnc, dst: i64, base: i64) -> void {
    var need_rex: bool = reg_ext(dst) || reg_ext(base) || peir_reg_code(dst) >= 4 || peir_reg_code(base) >= 4;
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(dst), false, reg_ext(base));
    }
    self.code.push(0x8A);
    var low3: i64 = peir_reg_code(base) & 7;
    if low3 == 4 {
        // RSP/R12: need SIB
        PeirEnc_modrm(self, 0, peir_reg_code(dst) & 7, 4);
        self.code.push(0x24);
    } else if low3 == 5 {
        // RBP/R13: mod=00 means RIP-relative, use mod=01 with disp8=0
        PeirEnc_modrm(self, 1, peir_reg_code(dst) & 7, 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst) & 7, low3);
    }
}

/// mov [reg], r8b (byte store through pointer, handles RBP/R13 and RSP/R12)
pub fn PeirEnc_mov_mem_reg8_ptr(self: &mut PeirEnc, base: i64, src: i64) -> void {
    var need_rex: bool = reg_ext(src) || reg_ext(base) || peir_reg_code(src) >= 4 || peir_reg_code(base) >= 4;
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(base));
    }
    self.code.push(0x88);
    var low3: i64 = peir_reg_code(base) & 7;
    if low3 == 4 {
        // RSP/R12: need SIB
        PeirEnc_modrm(self, 0, peir_reg_code(src) & 7, 4);
        self.code.push(0x24);
    } else if low3 == 5 {
        // RBP/R13: mod=00 means RIP-relative, use mod=01 with disp8=0
        PeirEnc_modrm(self, 1, peir_reg_code(src) & 7, 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src) & 7, low3);
    }
}

/// mov [reg], r8 (byte store through pointer)
pub fn PeirEnc_mov_mem_reg8(self: &mut PeirEnc, base: i64, src: i64) -> void {
    var need_rex: bool = reg_ext(src) || reg_ext(base) || peir_reg_code(src) >= 4 || peir_reg_code(base) >= 4;
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(base));
    }
    self.code.push(0x88);
    if (peir_reg_code(base) & 7) == 4 {
        // RSP or R12: need SIB byte
        PeirEnc_modrm(self, 0, peir_reg_code(src), 4);
        self.code.push(0x24);
        // SIB: scale=0, index=none, base=RSP/R12
    } else if (peir_reg_code(base) & 7) == 5 {
        // BG92: RBP or R13: mod=00 rm=101 is [rip + disp32], so use mod=01
        // with disp8 = 0 (`mov [rbp], al` = 88 45 00)
        PeirEnc_modrm(self, 1, peir_reg_code(src), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src), peir_reg_code(base));
    }
}

/// mov [reg + disp], r8 (byte store with displacement)
pub fn PeirEnc_mov_mem_disp_reg8(self: &mut PeirEnc, base: i64, disp: i64, src: i64) -> void {
    var need_rex: bool = reg_ext(src) || reg_ext(base) || peir_reg_code(src) >= 4 || peir_reg_code(base) >= 4;
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(base));
    }
    self.code.push(0x88);
    if (peir_reg_code(base) & 7) == 4 {
        // RSP or R12: need SIB byte
        if disp >= 0 - 128 && disp <= 127 {
            PeirEnc_modrm(self, 1, peir_reg_code(src), 4);
            self.code.push(0x24);
            self.code.push(disp & 0xFF);
        } else {
            PeirEnc_modrm(self, 2, peir_reg_code(src), 4);
            self.code.push(0x24);
            PeirEnc_emit_i32(self, disp);
        }
    } else if disp >= 0 - 128 && disp <= 127 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), peir_reg_code(base));
        self.code.push(disp & 0xFF);
    } else {
        PeirEnc_modrm(self, 2, peir_reg_code(src), peir_reg_code(base));
        PeirEnc_emit_i32(self, disp);
    }
}

/// mov [reg + reg], r8 (byte store with index)
pub fn PeirEnc_mov_mem_idx_reg8(self: &mut PeirEnc, base: i64, index: i64, src: i64) -> void {
    PeirEnc_rex(self, false, reg_ext(src), reg_ext(index), reg_ext(base));
    self.code.push(0x88);
    // Use SIB: mod=00, reg=src, rm=100 (SIB follows)
    // But if base is RBP/R13 (code 5), mod=00 means [disp32 + index], not
    // [base + index]. Use mod=01 with 0 displacement instead.
    if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), 4);
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
        self.code.push(0);
        // disp8 = 0
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src), 4);
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
    }
}

/// mov r8, [reg + reg] (byte load with index)
pub fn PeirEnc_mov_reg8_mem_idx(self: &mut PeirEnc, dst: i64, base: i64, index: i64) -> void {
    PeirEnc_rex(self, false, reg_ext(dst), reg_ext(index), reg_ext(base));
    self.code.push(0x8A);
    if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(dst), 4);
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
        self.code.push(0);
        // disp8 = 0
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), 4);
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
    }
}

/// cmp byte [reg + reg], imm8
pub fn PeirEnc_cmp_mem_idx_imm8(self: &mut PeirEnc, base: i64, index: i64, val: i64) -> void {
    PeirEnc_rex(self, false, false, reg_ext(index), reg_ext(base));
    self.code.push(0x80);
    if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, 7, 4);
        // /7 = cmp, rm=100 (SIB), mod=01 for RBP/R13
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
        self.code.push(0);
        // disp8 = 0
    } else {
        PeirEnc_modrm(self, 0, 7, 4);
        // /7 = cmp, rm=100 (SIB)
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
    }
    self.code.push(val & 0xFF);
}

/// inc r64
pub fn PeirEnc_inc_r(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xFF);
    PeirEnc_modrm(self, 3, 0, peir_reg_code(r));
}

/// dec r64
pub fn PeirEnc_dec_r(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, true, false, false, reg_ext(r));
    self.code.push(0xFF);
    PeirEnc_modrm(self, 3, 1, peir_reg_code(r));
}

/// xor r64, r64 (zero a register)
pub fn PeirEnc_xor_self(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_xor_rr(self, r, r);
}

/// mov rax, [reg] (load through pointer, 64-bit)
pub fn PeirEnc_mov_reg_ptr(self: &mut PeirEnc, dst: i64, base: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(base));
    self.code.push(0x8B);
    if peir_reg_code(base) == 4 {
        // RSP/R12 require SIB byte
        PeirEnc_modrm(self, 0, peir_reg_code(dst), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        // RBP/R13 require mod=01 with disp8=0
        PeirEnc_modrm(self, 1, peir_reg_code(dst), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), peir_reg_code(base));
    }
}

/// mov [reg], r64 (store through pointer, 64-bit)
pub fn PeirEnc_mov_ptr_reg(self: &mut PeirEnc, base: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(base));
    self.code.push(0x89);
    if peir_reg_code(base) == 4 {
        PeirEnc_modrm(self, 0, peir_reg_code(src), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src), peir_reg_code(base));
    }
}

/// mov [reg], r32 (32-bit store through pointer, no REX.W)
pub fn PeirEnc_mov_ptr_reg32(self: &mut PeirEnc, base: i64, src: i64) -> void {
    var need_rex: bool = reg_ext(src) || reg_ext(base);
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(base));
    }
    self.code.push(0x89);
    if peir_reg_code(base) == 4 {
        PeirEnc_modrm(self, 0, peir_reg_code(src), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src), peir_reg_code(base));
    }
}

/// mov [reg], r16 (16-bit store through pointer, 0x66 prefix)
pub fn PeirEnc_mov_ptr_reg16(self: &mut PeirEnc, base: i64, src: i64) -> void {
    self.code.push(0x66);
    // operand-size override
    var need_rex: bool = reg_ext(src) || reg_ext(base);
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(base));
    }
    self.code.push(0x89);
    if peir_reg_code(base) == 4 {
        PeirEnc_modrm(self, 0, peir_reg_code(src), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src), peir_reg_code(base));
    }
}

/// mov r8, [reg] (byte load through pointer)
pub fn PeirEnc_mov_reg8_ptr(self: &mut PeirEnc, dst: i64, base: i64) -> void {
    var need_rex: bool = reg_ext(dst) || reg_ext(base) || peir_reg_code(dst) >= 4 || peir_reg_code(base) >= 4;
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(dst), false, reg_ext(base));
    }
    self.code.push(0x8A);
    if peir_reg_code(base) == 4 {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(dst), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), peir_reg_code(base));
    }
}

/// mov r32, [reg] (32-bit load through pointer, no REX.W)
pub fn PeirEnc_mov_reg32_ptr(self: &mut PeirEnc, dst: i64, base: i64) -> void {
    var need_rex: bool = reg_ext(dst) || reg_ext(base);
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(dst), false, reg_ext(base));
    }
    self.code.push(0x8B);
    if peir_reg_code(base) == 4 {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(dst), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), peir_reg_code(base));
    }
}

/// mov r16, [reg] (16-bit load through pointer, 0x66 prefix)
pub fn PeirEnc_mov_reg16_ptr(self: &mut PeirEnc, dst: i64, base: i64) -> void {
    self.code.push(0x66);
    // operand-size override
    var need_rex: bool = reg_ext(dst) || reg_ext(base);
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(dst), false, reg_ext(base));
    }
    self.code.push(0x8B);
    if peir_reg_code(base) == 4 {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), 4);
        self.code.push(0x24);
    } else if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(dst), 5);
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), peir_reg_code(base));
    }
}

/// mov rax, [reg + reg*1] (load with index, 64-bit)
pub fn PeirEnc_mov_reg_mem_idx(self: &mut PeirEnc, dst: i64, base: i64, index: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), reg_ext(index), reg_ext(base));
    self.code.push(0x8B);
    if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(dst), 4);
        // SIB with disp8=0 for RBP/R13
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(dst), 4);
        // SIB
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
    }
}

/// mov [reg + reg*1], r64 (store with index, 64-bit)
pub fn PeirEnc_mov_mem_idx_reg(self: &mut PeirEnc, base: i64, index: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), reg_ext(index), reg_ext(base));
    self.code.push(0x89);
    if peir_reg_code(base) == 5 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), 4);
        // SIB with disp8=0 for RBP/R13
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
        self.code.push(0);
    } else {
        PeirEnc_modrm(self, 0, peir_reg_code(src), 4);
        // SIB
        self.code.push((0 << 6) | (peir_reg_code(index) << 3) | peir_reg_code(base));
    }
}

/// mov rax, [reg + disp32] (load through pointer with displacement)
pub fn PeirEnc_mov_reg_mem_disp(self: &mut PeirEnc, dst: i64, base: i64, disp: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(base));
    self.code.push(0x8B);
    if peir_reg_code(base) == 4 {
        if disp >= 0 - 128 && disp <= 127 {
            PeirEnc_modrm(self, 1, peir_reg_code(dst), 4);
            self.code.push(0x24);
            self.code.push(disp & 0xFF);
        } else {
            PeirEnc_modrm(self, 2, peir_reg_code(dst), 4);
            self.code.push(0x24);
            PeirEnc_emit_i32(self, disp);
        }
    } else if disp >= 0 - 128 && disp <= 127 {
        PeirEnc_modrm(self, 1, peir_reg_code(dst), peir_reg_code(base));
        self.code.push(disp & 0xFF);
    } else {
        PeirEnc_modrm(self, 2, peir_reg_code(dst), peir_reg_code(base));
        PeirEnc_emit_i32(self, disp);
    }
}

/// mov [reg + disp32], r64 (store through pointer with displacement)
pub fn PeirEnc_mov_mem_disp_reg(self: &mut PeirEnc, base: i64, disp: i64, src: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(src), false, reg_ext(base));
    self.code.push(0x89);
    if peir_reg_code(base) == 4 {
        if disp >= 0 - 128 && disp <= 127 {
            PeirEnc_modrm(self, 1, peir_reg_code(src), 4);
            self.code.push(0x24);
            self.code.push(disp & 0xFF);
        } else {
            PeirEnc_modrm(self, 2, peir_reg_code(src), 4);
            self.code.push(0x24);
            PeirEnc_emit_i32(self, disp);
        }
    } else if disp >= 0 - 128 && disp <= 127 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), peir_reg_code(base));
        self.code.push(disp & 0xFF);
    } else {
        PeirEnc_modrm(self, 2, peir_reg_code(src), peir_reg_code(base));
        PeirEnc_emit_i32(self, disp);
    }
}

/// mov [reg + disp], r32 (32-bit store, no REX.W)
pub fn PeirEnc_mov_mem_disp_reg32(self: &mut PeirEnc, base: i64, disp: i64, src: i64) -> void {
    var need_rex: bool = reg_ext(src) || reg_ext(base);
    if need_rex {
        PeirEnc_rex(self, false, reg_ext(src), false, reg_ext(base));
    }
    self.code.push(0x89);
    if peir_reg_code(base) == 4 {
        if disp >= 0 - 128 && disp <= 127 {
            PeirEnc_modrm(self, 1, peir_reg_code(src), 4);
            self.code.push(0x24);
            self.code.push(disp & 0xFF);
        } else {
            PeirEnc_modrm(self, 2, peir_reg_code(src), 4);
            self.code.push(0x24);
            PeirEnc_emit_i32(self, disp);
        }
    } else if disp >= 0 - 128 && disp <= 127 {
        PeirEnc_modrm(self, 1, peir_reg_code(src), peir_reg_code(base));
        self.code.push(disp & 0xFF);
    } else {
        PeirEnc_modrm(self, 2, peir_reg_code(src), peir_reg_code(base));
        PeirEnc_emit_i32(self, disp);
    }
}

/// imul r64, r64, imm32 (three-operand imul)
pub fn PeirEnc_imul_r_r_imm32(self: &mut PeirEnc, dst: i64, src: i64, val: i64) -> void {
    PeirEnc_rex(self, true, reg_ext(dst), false, reg_ext(src));
    self.code.push(0x69);
    PeirEnc_modrm_rr(self, dst, src);
    PeirEnc_emit_i32(self, val);
}

/// call r64 (indirect call through register)
/// NOTE: Rust emits the REX byte unconditionally (0x40 when not extended).
pub fn PeirEnc_call_reg(self: &mut PeirEnc, r: i64) -> void {
    PeirEnc_rex(self, false, false, false, reg_ext(r));
    self.code.push(0xFF);
    PeirEnc_modrm(self, 3, 2, peir_reg_code(r));
}

// ─── SSE/float instructions (minimal) ───

/// movsd xmm, [rbp + disp]
pub fn PeirEnc_movsd_xmm_mem_rbp(self: &mut PeirEnc, xmm: i64, disp: i64) -> void {
    if disp >= PEIR_XMM_SLOT {
        var src: i64 = disp - PEIR_XMM_SLOT;
        if src != xmm {
            PeirEnc_movapd_rr(self, xmm, src);
        }
        return;
    }
    if disp >= PEIR_REG_SLOT {
        // an f64 value in a general register (moved as its bits)
        PeirEnc_movq_xmm_r64(self, xmm, peir_value_reg(disp - PEIR_REG_SLOT));
        return;
    }
    // F2 REX.W 0F 10 /r (W is ignored; REX.R for xmm8-15, BG89)
    self.code.push(0xF2);
    PeirEnc_rex(self, true, xmm_high(xmm), false, false);
    self.code.push(0x0F);
    self.code.push(0x10);
    PeirEnc_emit_mem_rbp(self, xmm, disp);
}

/// movsd [rbp + disp], xmm
pub fn PeirEnc_movsd_mem_rbp_xmm(self: &mut PeirEnc, disp: i64, xmm: i64) -> void {
    if disp >= PEIR_XMM_SLOT {
        var dst: i64 = disp - PEIR_XMM_SLOT;
        if dst != xmm {
            PeirEnc_movapd_rr(self, dst, xmm);
        }
        return;
    }
    if disp >= PEIR_REG_SLOT {
        PeirEnc_movq_r64_xmm(self, peir_value_reg(disp - PEIR_REG_SLOT), xmm);
        return;
    }
    // F2 REX.W 0F 11 /r (W is ignored; REX.R for xmm8-15, BG89)
    self.code.push(0xF2);
    PeirEnc_rex(self, true, xmm_high(xmm), false, false);
    self.code.push(0x0F);
    self.code.push(0x11);
    PeirEnc_emit_mem_rbp(self, xmm, disp);
}

/// movss xmm, [rbp + disp]
pub fn PeirEnc_movss_xmm_mem_rbp(self: &mut PeirEnc, xmm: i64, disp: i64) -> void {
    // F3 REX.W 0F 10 /r (W is ignored; REX.R for xmm8-15, BG89)
    self.code.push(0xF3);
    PeirEnc_rex(self, true, xmm_high(xmm), false, false);
    self.code.push(0x0F);
    self.code.push(0x10);
    PeirEnc_emit_mem_rbp(self, xmm, disp);
}

/// movss [rbp + disp], xmm
pub fn PeirEnc_movss_mem_rbp_xmm(self: &mut PeirEnc, disp: i64, xmm: i64) -> void {
    // F3 REX.W 0F 11 /r (W is ignored; REX.R for xmm8-15, BG89)
    self.code.push(0xF3);
    PeirEnc_rex(self, true, xmm_high(xmm), false, false);
    self.code.push(0x0F);
    self.code.push(0x11);
    PeirEnc_emit_mem_rbp(self, xmm, disp);
}

/// addsd xmm0, xmm1
pub fn PeirEnc_addsd(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0xF2);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x58);
    PeirEnc_modrm(self, 3, dst, src);
}

/// subsd xmm0, xmm1
pub fn PeirEnc_subsd(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0xF2);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x5C);
    PeirEnc_modrm(self, 3, dst, src);
}

/// mulsd xmm0, xmm1
pub fn PeirEnc_mulsd(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0xF2);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x59);
    PeirEnc_modrm(self, 3, dst, src);
}

/// divsd xmm0, xmm1
pub fn PeirEnc_divsd(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0xF2);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x5E);
    PeirEnc_modrm(self, 3, dst, src);
}

/// xorpd xmm, [rbp + disp]
pub fn PeirEnc_xorpd_xmm_mem_rbp(self: &mut PeirEnc, xmm: i64, disp: i64) -> void {
    // 66 [REX.R for xmm8-15, BG89] 0F 57 /r
    self.code.push(0x66);
    PeirEnc_rex_sse_rm(self, false, xmm, 0);
    self.code.push(0x0F);
    self.code.push(0x57);
    PeirEnc_emit_mem_rbp(self, xmm, disp);
}

/// xorpd xmm, xmm (register-to-register)
pub fn PeirEnc_xorpd_xmm_xmm(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x57);
    PeirEnc_modrm(self, 3, dst, src);
}

/// movq xmm, r64 (move 64-bit GPR to XMM): 66 REX.W 0F 6E /r, ModRM.reg
/// = xmm (REX.R for xmm8-15, BG89), ModRM.rm = r64 (REX.B)
pub fn PeirEnc_movq_xmm_r64(self: &mut PeirEnc, xmm: i64, r: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex(self, true, xmm_high(xmm), false, reg_ext(r));
    self.code.push(0x0F);
    self.code.push(0x6E);
    PeirEnc_modrm(self, 3, xmm, peir_reg_code(r));
}

/// ucomisd xmm0, xmm1
pub fn PeirEnc_ucomisd(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0x66);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x2E);
    PeirEnc_modrm(self, 3, dst, src);
}

/// ucomiss xmm0, xmm1
pub fn PeirEnc_ucomiss(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    // 0F 2E, no prefix (F3 0F 2E is no instruction: an f32 comparison
    // stopped with "Illegal instruction")
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x2E);
    PeirEnc_modrm(self, 3, dst, src);
}

/// cvtsi2sd xmm, r64: F2 REX.W 0F 2A /r, ModRM.reg = xmm (REX.R, BG89),
/// ModRM.rm = r64 (REX.B)
pub fn PeirEnc_cvtsi2sd_r64(self: &mut PeirEnc, xmm: i64, r: i64) -> void {
    self.code.push(0xF2);
    PeirEnc_rex(self, true, xmm_high(xmm), false, reg_ext(r));
    self.code.push(0x0F);
    self.code.push(0x2A);
    PeirEnc_modrm(self, 3, xmm, peir_reg_code(r));
}

/// cvttsd2si r64, xmm: F2 REX.W 0F 2C /r, ModRM.reg = r64 (REX.R),
/// ModRM.rm = xmm (REX.B). BG88: r8-r15 set REX.B, which named xmm8-15
/// and left the result in the low register. `cvttsd2si rax, xmm0` =
/// F2 48 0F 2C C0; `cvttsd2si r9, xmm0` = F2 4C 0F 2C C8.
pub fn PeirEnc_cvttsd2si_r64(self: &mut PeirEnc, r: i64, xmm: i64) -> void {
    self.code.push(0xF2);
    PeirEnc_rex(self, true, reg_ext(r), false, xmm_high(xmm));
    self.code.push(0x0F);
    self.code.push(0x2C);
    PeirEnc_modrm(self, 3, peir_reg_code(r), xmm);
}

/// addss xmm0, xmm1
pub fn PeirEnc_addss(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0xF3);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x58);
    PeirEnc_modrm(self, 3, dst, src);
}

/// subss xmm0, xmm1
pub fn PeirEnc_subss(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0xF3);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x5C);
    PeirEnc_modrm(self, 3, dst, src);
}

/// mulss xmm0, xmm1
pub fn PeirEnc_mulss(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0xF3);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x59);
    PeirEnc_modrm(self, 3, dst, src);
}

/// divss xmm0, xmm1
pub fn PeirEnc_divss(self: &mut PeirEnc, dst: i64, src: i64) -> void {
    self.code.push(0xF3);
    PeirEnc_rex_sse(self, dst, src);
    self.code.push(0x0F);
    self.code.push(0x5E);
    PeirEnc_modrm(self, 3, dst, src);
}

/// movq xmm, [rbp + disp] (64-bit SSE move)
pub fn PeirEnc_movq_xmm_mem_rbp(self: &mut PeirEnc, xmm: i64, disp: i64) -> void {
    PeirEnc_movsd_xmm_mem_rbp(self, xmm, disp);
}

/// movq [rbp + disp], xmm
pub fn PeirEnc_movq_mem_rbp_xmm(self: &mut PeirEnc, disp: i64, xmm: i64) -> void {
    PeirEnc_movsd_mem_rbp_xmm(self, disp, xmm);
}

// ─── Label resolution ───

/// Resolve all pending label relocations (local jumps/calls)
pub fn PeirEnc_resolve_labels(self: &mut PeirEnc) -> void {
    var i: i64 = 0;
    while i < self.pending_labels.len() {
        var reloc: PeirReloc = self.pending_labels.get(i);
        var target_offset: i64 = -1;
        if reloc.target_label >= 0 && reloc.target_label < self.labels.len() {
            target_offset = self.labels.get(reloc.target_label);
        }
        if target_offset >= 0 {
            var disp: i64 = target_offset - (reloc.code_offset + 4);
            var j: i64 = 0;
            while j < 4 {
                self.code.set(reloc.code_offset + j, (disp >> (j * 8)) & 0xFF);
                j = j + 1;
            }
        } else {
            p_eprint_str("[PE] WARNING: unresolved label " + int_to_str(reloc.target_label) + " at code offset 0x" + pe_to_hex(reloc.code_offset) + "\n");
        }
        i = i + 1;
    }
}

/// Resolve all RIP-relative references to .rdata
/// text_rva: virtual address of .text section start
/// rdata_rva: virtual address of .rdata section start
pub fn PeirEnc_resolve_rip_refs(self: &mut PeirEnc, text_rva: i64, rdata_rva: i64) -> void {
    var i: i64 = 0;
    while i < self.pending_rip_refs.len() {
        var ref_: PeirRipRef = self.pending_rip_refs.get(i);
        var code_rva: i64 = text_rva + ref_.code_offset;
        var target_rva: i64 = rdata_rva + ref_.rdata_offset;
        var disp: i64 = target_rva - (code_rva + 4);
        var j: i64 = 0;
        while j < 4 {
            self.code.set(ref_.code_offset + j, (disp >> (j * 8)) & 0xFF);
            j = j + 1;
        }
        i = i + 1;
    }
}

// ===========================================================================
// Import table
// ===========================================================================

/// Names of kernel32.dll functions we import (the first 13 have PIAT_*
/// constants; the rest are reached by name through `pe_import_slot`).
pub fn pe_kernel32_imports() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("GetStdHandle");
    v.push("WriteFile");
    v.push("ExitProcess");
    v.push("GetProcessHeap");
    v.push("HeapAlloc");
    v.push("HeapFree");
    v.push("CreateFileA");
    v.push("ReadFile");
    v.push("CloseHandle");
    v.push("GetFileSize");
    v.push("GetCommandLineA");
    v.push("CreateProcessA");
    v.push("WaitForSingleObject");
    // Threads, locks, thread-local storage, clocks, files, libraries
    v.push("CreateThread");
    v.push("Sleep");
    v.push("GetTickCount64");
    v.push("QueryPerformanceCounter");
    v.push("QueryPerformanceFrequency");
    v.push("GetSystemTimeAsFileTime");
    v.push("DeleteFileA");
    v.push("GetFileAttributesA");
    v.push("GetCurrentProcessId");
    v.push("CreateDirectoryA");
    v.push("RemoveDirectoryA");
    v.push("FindFirstFileA");
    v.push("FindNextFileA");
    v.push("FindClose");
    v.push("InitializeSRWLock");
    v.push("AcquireSRWLockExclusive");
    v.push("ReleaseSRWLockExclusive");
    v.push("InitializeConditionVariable");
    v.push("SleepConditionVariableSRW");
    v.push("WakeConditionVariable");
    v.push("WakeAllConditionVariable");
    v.push("TlsAlloc");
    v.push("TlsGetValue");
    v.push("TlsSetValue");
    v.push("LoadLibraryA");
    v.push("GetProcAddress");
    v.push("FreeLibrary");
    v.push("AddVectoredExceptionHandler");
    v.push("ConvertThreadToFiber");
    v.push("CreateFiberEx");
    v.push("SwitchToFiber");
    v.push("DeleteFiber");
    // The scheduler's start-up lock and core count (pe_runtime/conc.fd)
    v.push("CreateMutexA");
    v.push("ReleaseMutex");
    v.push("GetSystemInfo");
    // emit --checked-alloc (release M7): a block's own pages
    v.push("VirtualAlloc");
    v.push("VirtualProtect");
    // Task stacks (pe_runtime/conc.fd, RT9) and socket readiness (RT11)
    v.push("VirtualFree");
    v.push("CreateIoCompletionPort");
    v.push("GetQueuedCompletionStatusEx");
    v.push("PostQueuedCompletionStatus");
    // emit --checked-alloc: the fault report finds the block an access hit
    // (PeirGen_gen_checked_fault)
    v.push("VirtualQuery");
    // p_signal_register (pe_runtime/base.fd): Ctrl-C and console close
    v.push("SetConsoleCtrlHandler");
    // RT7: pert_mem_resident (pe_runtime/base.fd), the working set
    v.push("K32GetProcessMemoryInfo");
    // P12: p_free gives a large block's bytes back to FID_MEM_LIMIT's count
    // (PeirGen_gen_free, pert_lim_give)
    v.push("HeapSize");
    // stdlib/sys.fd sys_total_memory / sys_available_memory (sw_memstatus)
    v.push("GlobalMemoryStatusEx");
    return v;
}

/// msvcrt.dll functions: the C library behind `extern "C"` declarations
/// (math.h, string.h, stdio.h, stdlib.h, ctype.h) and the Fides PE runtime
/// (src/pe_runtime/). Every name here must be an msvcrt.dll export: the
/// loader refuses to start a program importing one that is not.
pub fn pe_msvcrt_imports() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("sqrt");
    v.push("pow");
    v.push("floor");
    v.push("ceil");
    v.push("fabs");
    v.push("fmod");
    // RL25: test_verify_abi_c_mixed.fd's c_ldexp/c_frexp/c_modf
    v.push("ldexp");
    v.push("frexp");
    v.push("modf");
    v.push("exp");
    v.push("log");
    v.push("log10");
    v.push("sin");
    v.push("cos");
    v.push("tan");
    v.push("asin");
    v.push("acos");
    v.push("atan");
    v.push("atan2");
    v.push("sinh");
    v.push("cosh");
    v.push("tanh");
    v.push("strtod");
    v.push("_strtoi64");
    v.push("atof");
    v.push("atoi");
    v.push("atol");
    v.push("strlen");
    v.push("strcmp");
    v.push("strncmp");
    v.push("strcpy");
    v.push("strncpy");
    v.push("strcat");
    v.push("strchr");
    v.push("strstr");
    v.push("memcpy");
    v.push("memmove");
    v.push("memset");
    v.push("memcmp");
    // pert_mem_find_byte (stdlib/pe_runtime/base.fd) calls it (2g.58)
    v.push("memchr");
    v.push("toupper");
    v.push("tolower");
    v.push("isalpha");
    v.push("isdigit");
    v.push("isspace");
    v.push("isalnum");
    v.push("abs");
    v.push("labs");
    v.push("_abs64");
    v.push("rand");
    v.push("srand");
    v.push("time");
    v.push("clock");
    v.push("malloc");
    v.push("calloc");
    v.push("realloc");
    v.push("free");
    v.push("getenv");
    v.push("exit");
    v.push("qsort");
    // CI3: test_c_callback_user_data.fd (a comparator with a context pointer)
    v.push("qsort_s");
    v.push("bsearch");
    v.push("ldiv");
    v.push("_snprintf");
    v.push("putchar");
    v.push("puts");
    v.push("getchar");
    v.push("fopen");
    v.push("fclose");
    v.push("fread");
    v.push("fwrite");
    v.push("fflush");
    v.push("fgets");
    v.push("fputs");
    v.push("fseek");
    v.push("ftell");
    v.push("_fseeki64");
    v.push("remove");
    v.push("rand_s");
    v.push("rename");
    v.push("_access");
    v.push("system");
    return v;
}

/// One DLL and its imported names, in IAT order (DLL_IMPORTS in Rust).
pub struct PeDllImport {
    pub dll: str,
    pub names: Vec<str>,
}

// What this program imports beyond kernel32 and msvcrt: `extern "C" link "x"`
var g_pe_extra_imports: Vec<PeDllImport> = Vec::new();
pub fn pe_clear_extra_imports() {
    g_pe_extra_imports = Vec::new();
}

/// Import `name` from `dll` as well.
pub fn pe_add_extra_import(dll: str, name: str) {
    var i: i64 = 0;
    while i < g_pe_extra_imports.len() {
        var e: PeDllImport = g_pe_extra_imports.get(i);
        if e.dll == dll {
            var k: i64 = 0;
            while k < e.names.len() {
                if e.names.get(k) == name {
                    return;
                }
                k = k + 1;
            }
            g_pe_extra_imports.get(i).names.push(name);
            return;
        }
        i = i + 1;
    }
    var names: Vec<str> = Vec::new();
    names.push(name);
    g_pe_extra_imports.push(PeDllImport {
        dll: dll, names: names
    });
}

/// The DLL of a `link` library, "" for the Unix libraries the C runtime covers.
pub fn pe_link_dll(lib: str) -> str {
    if lib == "" || lib == "m" || lib == "c" || lib == "pthread" || lib == "dl" || lib == "rt" || lib == "msvcrt" || lib == "kernel32" {
        return "";
    }
    if lib == "GL" {
        return "opengl32.dll";
    }
    if lib == "GLU" {
        return "glu32.dll";
    }
    if str_ends_with(lib, ".dll") {
        return lib;
    }
    return lib + ".dll";
}

/// The DLLs the loader binds before the program starts (kernel32, msvcrt).
/// The others (`link "x"`) have IAT slots too, but the program loads them
/// itself at start-up (PeirGen_gen_dll_loader), so that a missing library
/// is reported by name instead of the loader failing silently (release E4).
pub const PE_STATIC_DLLS: i64 = 2;
/// The files to try, in order, for a `link` DLL: SQLite's own sqlite3.dll,
/// else the copy every Windows 10 and 11 has (winsqlite3.dll, same API).
pub fn pe_link_dll_candidates(dll: str) -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push(dll);
    if dll == "sqlite3.dll" {
        v.push("winsqlite3.dll");
    }
    return v;
}

/// Is `dll` where LoadLibraryA looks for it (beside `out_dir`, the current
/// folder, the system folder or a PATH entry)? For a compile-time warning.
pub fn pe_dll_found(dll: str, out_dir: str) -> bool {
    var dirs: Vec<str> = Vec::new();
    if out_dir != "" {
        dirs.push(out_dir);
    }
    dirs.push(".");
    // env_var (core): None when unset, else a str of its own. p_getenv
    // gives a raw word (proposal 0004) that older and newer compilers type
    // differently (str vs i64): read through core only.
    match env_var("SystemRoot") {
        Option::Some(root) => {
            dirs.push(root + "\\System32");
        }
        Option::None => {
            dirs.push("C:\\Windows\\System32");
        }
    }
    match env_var("PATH") {
        Option::Some(path) => {
            var parts: Vec<str> = str_split(path, ";");
            var pi: i64 = 0;
            while pi < parts.len() {
                if str_len(parts.get(pi)) > 0 {
                    dirs.push(parts.get(pi));
                }
                pi = pi + 1;
            }
        }
        Option::None => {
        }
    }
    var di: i64 = 0;
    while di < dirs.len() {
        if p_file_exists(dirs.get(di) + "\\" + dll) != 0 {
            return true;
        }
        di = di + 1;
    }
    return false;
}

/// The DLLs of the import table, in IAT order.
pub fn pe_dll_imports() -> Vec<PeDllImport> {
    var v: Vec<PeDllImport> = Vec::new();
    v.push(PeDllImport {
        dll: "kernel32.dll", names: pe_kernel32_imports()
    });
    v.push(PeDllImport {
        dll: "msvcrt.dll", names: pe_msvcrt_imports()
    });
    var i: i64 = 0;
    while i < g_pe_extra_imports.len() {
        v.push(g_pe_extra_imports.get(i));
        i = i + 1;
    }
    return v;
}

/// The IAT slot of an imported function (an index into `iat_rdata_offsets`).
/// Returns -1 when `name` is not imported (Rust: Option<usize> -> None).
pub fn pe_import_slot(name: str) -> i64 {
    var base: i64 = 0;
    var dlls: Vec<PeDllImport> = pe_dll_imports();
    var d: i64 = 0;
    while d < dlls.len() {
        var names: Vec<str> = dlls.get(d).names;
        var i: i64 = 0;
        while i < names.len() {
            if names.get(i) == name {
                return base + i;
            }
            i = i + 1;
        }
        base = base + names.len();
        d = d + 1;
    }
    return -1;
}

/// IAT indices for each imported function (first 13 kernel32 imports)
pub const PIAT_GET_STD_HANDLE: i64 = 0;
pub const PIAT_WRITE_FILE: i64 = 1;
pub const PIAT_EXIT_PROCESS: i64 = 2;
pub const PIAT_GET_PROCESS_HEAP: i64 = 3;
pub const PIAT_HEAP_ALLOC: i64 = 4;
pub const PIAT_HEAP_FREE: i64 = 5;
pub const PIAT_CREATE_FILE_A: i64 = 6;
pub const PIAT_READ_FILE: i64 = 7;
pub const PIAT_CLOSE_HANDLE: i64 = 8;
pub const PIAT_GET_FILE_SIZE: i64 = 9;
pub const PIAT_GET_COMMAND_LINE_A: i64 = 10;
pub const PIAT_CREATE_PROCESS_A: i64 = 11;
pub const PIAT_WAIT_FOR_SINGLE_OBJECT: i64 = 12;
// ===========================================================================
// PeirRdata — builds the .rdata section: string constants + import table
// ===========================================================================

pub struct PeirRdata {
    pub data: Vec<i64>,
    /// Offset of each IAT entry within .rdata (indexed by import position)
    pub iat_offsets: Vec<i64>,
    /// Offset of import directory table within .rdata
    pub import_dir_offset: i64,
    /// Offset+1 of each string constant within .rdata (str -> i64 map; 0 = absent)
    pub string_offsets: i64,
    /// Offset of each DLL's ILT within .rdata
    pub ilt_offsets: Vec<i64>,
    /// Offset of the whole IAT within .rdata, and its size in bytes
    pub iat_offset: i64,
    pub iat_size: i64,
    /// Offset of each DLL's part of the IAT within .rdata
    pub dll_iat_offsets: Vec<i64>,
    /// Offset of each DLL name string within .rdata
    pub dll_name_offs: Vec<i64>,
    /// Offsets of IMAGE_IMPORT_BY_NAME entries within .rdata (IAT order)
    pub import_by_name_offsets: Vec<i64>,
}

pub fn PeirRdata_new() -> PeirRdata {
    return PeirRdata {
        data: Vec::new(), iat_offsets: Vec::new(), import_dir_offset: 0, string_offsets: HashMap_new(), ilt_offsets: Vec::new(), iat_offset: 0, iat_size: 0, dll_iat_offsets: Vec::new(), dll_name_offs: Vec::new(), import_by_name_offsets: Vec::new(),
    };
}

/// Add a null-terminated string to .rdata, return its offset
pub fn PeirRdata_add_string(self: &mut PeirRdata, s: str) -> i64 {
    var prev: i64 = HashMap_get(self.string_offsets, s);
    if prev != 0 {
        return prev - 1;
    }  // [static magic][length] before the bytes, 8-aligned, as core's strings
    // carry them (release D16): the length is O(1) and comparisons of
    // different lengths stop at once
    while (self.data.len() % 8) != 0 {
        self.data.push(0);
    }
    var n: i64 = str_len(s);
    self.data = pe_push_u64(self.data, 0x4649444553545202);
    self.data = pe_push_u64(self.data, n);
    var offset: i64 = self.data.len();
    var i: i64 = 0;
    while i < n {
        self.data.push(str_byte_at(s, i));
        i = i + 1;
    }
    self.data.push(0);
    // null terminator
    HashMap_insert(self.string_offsets, s, offset + 1);
    return offset;
}

/// Look up a string's .rdata offset, or -1 (Rust Option<usize> -> None).
pub fn PeirRdata_string_offset(self: &PeirRdata, s: str) -> i64 {
    var prev: i64 = HashMap_get(self.string_offsets, s);
    if prev == 0 {
        return -1;
    }
    return prev - 1;
}

/// Insertion sort of a string vector (str_compare order), deterministic.
fn pe_sort_strings(v: Vec<str>) -> Vec<str> {
    var v = v;
    var i: i64 = 1;
    while i < v.len() {
        var key: str = v.get(i);
        var j: i64 = i - 1;
        while j >= 0 && str_compare(v.get(j), key) > 0 {
            v.set(j + 1, v.get(j));
            j = j - 1;
        }
        v.set(j + 1, key);
        i = i + 1;
    }
    return v;
}

/// The data of a bare build: the string constants, no import table.
pub fn PeirRdata_build_strings(self: &mut PeirRdata, string_constants: Vec<str>) -> void {
    var keys: Vec<str> = pe_sort_strings(string_constants);
    var ki: i64 = 0;
    while ki < keys.len() {
        PeirRdata_add_string(self, keys.get(ki));
        ki = ki + 1;
    }
    PeirRdata_add_string(self, "true");
    PeirRdata_add_string(self, "false");
    while (self.data.len() % 8) != 0 {
        self.data.push(0);
    }
}

/// Build the complete .rdata section
/// string_constants: all string literals from the IR
pub fn PeirRdata_build(self: &mut PeirRdata, string_constants: Vec<str>) -> void {
    // 1. String constants from user code (sorted: HashMap order would
    //    make the .rdata layout, and so the binary, differ per build)
    var keys: Vec<str> = Vec::new();
    var ki: i64 = 0;
    while ki < string_constants.len() {
        keys.push(string_constants.get(ki));
        ki = ki + 1;
    }
    keys = pe_sort_strings(keys);
    ki = 0;
    while ki < keys.len() {
        PeirRdata_add_string(self, keys.get(ki));
        ki = ki + 1;
    }

    // 2. Boolean strings
    PeirRdata_add_string(self, "true");
    PeirRdata_add_string(self, "false");

    // 3. DLL names
    var dlls: Vec<PeDllImport> = pe_dll_imports();
    var d: i64 = 0;
    while d < dlls.len() {
        self.dll_name_offs.push(PeirRdata_add_string(self, dlls.get(d).dll));
        d = d + 1;
    }

    // 4. IMAGE_IMPORT_BY_NAME for each import, in IAT order
    // Each: 2-byte hint (0) + null-terminated name
    var k: i64 = 0;
    d = 0;
    while d < dlls.len() {
        var names: Vec<str> = dlls.get(d).names;
        var i: i64 = 0;
        while i < names.len() {
            if (self.data.len() % 2) != 0 {
                self.data.push(0);
                // entries are 2-byte aligned
            }
            var off: i64 = self.data.len();
            self.data.push(0);
            // hint low
            self.data.push(0);
            // hint high
            var name: str = names.get(i);
            var ci: i64 = 0;
            while ci < str_len(name) {
                self.data.push(str_byte_at(name, ci));
                ci = ci + 1;
            }
            self.data.push(0);
            // null terminator
            self.import_by_name_offsets.push(off);
            i = i + 1;
        }
        d = d + 1;
    }  // Align to 8 bytes for tables
    while (self.data.len() % 8) != 0 {
        self.data.push(0);
    }

    // 5. Import Lookup Tables (ILT), one per DLL — 8-byte entries,
    //    null-terminated (RVAs filled in by patch_rvas)
    d = 0;
    while d < dlls.len() {
        self.ilt_offsets.push(self.data.len());
        var names: Vec<str> = dlls.get(d).names;
        var i: i64 = 0;
        while i < names.len() {
            var z: i64 = 0;
            while z < 8 {
                self.data.push(0);
                z = z + 1;
            }
            i = i + 1;
        }
        var z2: i64 = 0;
        while z2 < 8 {
            self.data.push(0);
            z2 = z2 + 1;
        }
        // null terminator
        d = d + 1;
    }

    // 6. Import Address Table (IAT): one null-terminated part per DLL,
    //    contiguous, so a single data directory entry covers it
    self.iat_offset = self.data.len();
    k = 0;
    d = 0;
    while d < dlls.len() {
        self.dll_iat_offsets.push(self.data.len());
        var names: Vec<str> = dlls.get(d).names;
        var i: i64 = 0;
        while i < names.len() {
            self.iat_offsets.push(self.data.len());
            // RVA to IMAGE_IMPORT_BY_NAME (placeholder, filled later)
            self.data = pe_push_u64(self.data, self.import_by_name_offsets.get(k));
            k = k + 1;
            i = i + 1;
        }
        var z3: i64 = 0;
        while z3 < 8 {
            self.data.push(0);
            z3 = z3 + 1;
        }
        // null terminator
        d = d + 1;
    }
    self.iat_size = self.data.len() - self.iat_offset;

    // 7. Import Directory Table — one 20-byte IMAGE_IMPORT_DESCRIPTOR
    //    per DLL, then a null one:
    // OriginalFirstThunk (4): RVA to ILT
    // TimeDateStamp (4): 0
    // ForwarderChain (4): 0
    // Name (4): RVA to DLL name
    // FirstThunk (4): RVA to IAT
    // (placeholders; RVAs filled in by patch_rvas)
    while (self.data.len() % 4) != 0 {
        self.data.push(0);
    }
    self.import_dir_offset = self.data.len();
    d = 0;
    while d < dlls.len() {
        var z4: i64 = 0;
        while z4 < 20 {
            self.data.push(0);
            z4 = z4 + 1;
        }
        d = d + 1;
    }
    var z5: i64 = 0;
    while z5 < 20 {
        self.data.push(0);
        z5 = z5 + 1;
    }
    // null terminator descriptor
}

/// Patch RVAs in the import table now that we know the .rdata RVA
pub fn PeirRdata_patch_rvas(self: &mut PeirRdata, rdata_rva: i64) -> void {
    var dlls: Vec<PeDllImport> = pe_dll_imports();
    var k: i64 = 0;
    var d: i64 = 0;
    while d < dlls.len() {
        var names: Vec<str> = dlls.get(d).names;
        // ILT and IAT entries: RVAs to IMAGE_IMPORT_BY_NAME
        var j: i64 = 0;
        while j < names.len() {
            var rva: i64 = rdata_rva + self.import_by_name_offsets.get(k);
            var ilt_entry: i64 = self.ilt_offsets.get(d) + j * 8;
            var iat_entry: i64 = self.dll_iat_offsets.get(d) + j * 8;
            if d < PE_STATIC_DLLS {
                self.data = pe_put_u32(self.data, ilt_entry, rva);
                self.data = pe_put_u32(self.data, iat_entry, rva);
            } else {
                // Filled by the start-up loader: no descriptor names it
                self.data = pe_put_u32(self.data, iat_entry, 0);
            }
            k = k + 1;
            j = j + 1;
        }
        if d >= PE_STATIC_DLLS {
            d = d + 1;
            continue;
        }
        // Import descriptor (TimeDateStamp and ForwarderChain stay 0)
        var dir: i64 = self.import_dir_offset + d * 20;
        var ilt_rva: i64 = rdata_rva + self.ilt_offsets.get(d);
        var name_rva: i64 = rdata_rva + self.dll_name_offs.get(d);
        var iat_rva: i64 = rdata_rva + self.dll_iat_offsets.get(d);
        self.data = pe_put_u32(self.data, dir, ilt_rva);
        self.data = pe_put_u32(self.data, dir + 12, name_rva);
        self.data = pe_put_u32(self.data, dir + 16, iat_rva);
        d = d + 1;
    }
}

// ===========================================================================
// Byte-vector helpers (by-value + return; `&mut Vec` params don't write back
// on the C backend — see the note in arm64_enc.fd)
// ===========================================================================

/// Lowercase hex of a non-negative i64 (no 0x prefix), for diagnostics/dumps.
pub fn pe_to_hex(v: i64) -> str {
    if v == 0 {
        return "0";
    }
    var digits: str = "0123456789abcdef";
    var out: str = "";
    var n: i64 = v;
    while n > 0 {
        var d: i64 = n % 16;
        out = str_slice(digits, d, d + 1) + out;
        n = n / 16;
    }
    return out;
}

/// Hex dump of a byte vector (contiguous lowercase hex).
pub fn pe_bytes_hex(bytes: Vec<i64>) -> str {
    var digits: str = "0123456789abcdef";
    var out: str = "";
    var i: i64 = 0;
    while i < bytes.len() {
        var b: i64 = bytes.get(i) & 0xFF;
        out = out + str_slice(digits, b / 16, b / 16 + 1);
        out = out + str_slice(digits, b % 16, b % 16 + 1);
        i = i + 1;
    }
    return out;
}

pub fn pe_push_u64(t: Vec<i64>, v: i64) -> Vec<i64> {
    var t = t;
    t.push(v & 0xFF);
    t.push((v >> 8) & 0xFF);
    t.push((v >> 16) & 0xFF);
    t.push((v >> 24) & 0xFF);
    t.push((v >> 32) & 0xFF);
    t.push((v >> 40) & 0xFF);
    t.push((v >> 48) & 0xFF);
    t.push((v >> 56) & 0xFF);
    return t;
}

pub fn pe_push_u32(t: Vec<i64>, v: i64) -> Vec<i64> {
    var t = t;
    t.push(v & 0xFF);
    t.push((v >> 8) & 0xFF);
    t.push((v >> 16) & 0xFF);
    t.push((v >> 24) & 0xFF);
    return t;
}

pub fn pe_push_u16(t: Vec<i64>, v: i64) -> Vec<i64> {
    var t = t;
    t.push(v & 0xFF);
    t.push((v >> 8) & 0xFF);
    return t;
}

pub fn pe_put_u32(t: Vec<i64>, at: i64, v: i64) -> Vec<i64> {
    var t = t;
    t.set(at, v & 0xFF);
    t.set(at + 1, (v >> 8) & 0xFF);
    t.set(at + 2, (v >> 16) & 0xFF);
    t.set(at + 3, (v >> 24) & 0xFF);
    return t;
}

pub fn pe_push_str(t: Vec<i64>, s: str) -> Vec<i64> {
    var t = t;
    var i: i64 = 0;
    while i < str_len(s) {
        t.push(str_byte_at(s, i));
        i = i + 1;
    }
    return t;
}

// ===========================================================================
// PE file builder
// ===========================================================================

pub const PE_IMAGE_BASE: i64 = 0x140000000;
pub const PE_SECTION_ALIGN: i64 = 0x1000;
pub const PE_FILE_ALIGN: i64 = 0x200;
pub const PE_TEXT_RVA: i64 = 0x1000;
pub fn pe_align_up(val: i64, align: i64) -> i64 {
    return (val + align - 1) & (~(align - 1));
}

/// ImageBase of a UEFI application. The firmware loads it where it likes
/// and applies the .reloc section (pe_build_efi).
pub const PE_EFI_IMAGE_BASE: i64 = 0x400000;
/// PE subsystem of a UEFI application (EFI_APPLICATION)
pub const PE_SUBSYSTEM_EFI_APPLICATION: i64 = 10;

/// A UEFI application (`fid emit --uefi`, pe_ir_generate_uefi): PE32+,
/// machine AMD64, subsystem EFI_APPLICATION, no imports (the firmware hands
/// the entry point its system table), three sections:
///   .text   RVA 0x1000: the flat binary's code, `code_size` bytes (a
///           multiple of 4 KB); the entry point is its first byte
///   .data   right after it: the rest of `flat` (strings, globals, the
///           allocator state), read/write
///   .reloc  DIR64 base relocations of `abs`: offsets in `flat` of 8-byte
///           absolute addresses linked at PE_EFI_IMAGE_BASE
/// The relocations are kept (no IMAGE_FILE_RELOCS_STRIPPED), so the image
/// loads at any address.
pub fn pe_build_efi(flat: Vec, code_size: i64, abs: Vec<i64>) -> Vec<i64> {
    // TG13: a layout over image_writer (pe_build_efi_img; the old body,
    // checked byte for byte against it on Nov 17, is gone:
    // docs/reference/image-writer.md)
    return pe_build_efi_img(flat, code_size, abs);
}

/// TG13: pe_build_efi as a layout over image_writer (same bytes): the
/// DOS stub, COFF header, PE32+ optional header (subsystem
/// EFI_APPLICATION, DYNAMIC_BASE | NX_COMPAT, the base relocation table in
/// directory 5), .text, .data and .reloc.
fn pe_build_efi_img(flat: Vec, code_size: i64, abs: Vec<i64>) -> Vec<i64> {
    var data_len: i64 = flat.len() - code_size;
    var data_rva: i64 = PE_TEXT_RVA + code_size;
    var reloc: Vec<i64> = pe_efi_relocs(abs);
    var reloc_rva: i64 = data_rva + pe_align_up(data_len, PE_SECTION_ALIGN);
    var size_of_image: i64 = reloc_rva + pe_align_up(reloc.len(), PE_SECTION_ALIGN);
    // DOS(64) + signature(4) + COFF(20) + optional(240) + 3 sections(120)
    var header_size: i64 = pe_align_up(64 + 4 + 20 + 240 + 3 * 40, PE_FILE_ALIGN);
    var text_raw: i64 = pe_align_up(code_size, PE_FILE_ALIGN);
    var data_raw: i64 = pe_align_up(data_len, PE_FILE_ALIGN);
    var reloc_raw: i64 = pe_align_up(reloc.len(), PE_FILE_ALIGN);
    var text_off: i64 = header_size;
    var data_off: i64 = text_off + text_raw;
    var reloc_off: i64 = data_off + data_raw;
    var pe: Vec<i64> = Vec::new();
    img_pe_dos(&mut pe, false);
    img_pe_signature(&mut pe);
    img_coff_header(&mut pe, 0x8664, 3, 0, 0, 240, 0x0022);
    // AMD64; EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE (relocations kept)
    var o: ImgPeOpt = ImgPeOpt {
        linker_major: 14, code_size: text_raw, init_size: data_raw + reloc_raw, entry: PE_TEXT_RVA, base_of_code: PE_TEXT_RVA, image_base: PE_EFI_IMAGE_BASE, sect_align: PE_SECTION_ALIGN, file_align: PE_FILE_ALIGN, os_major: 0, subsys_major: 0, image_size: size_of_image, header_size: header_size, subsystem: PE_SUBSYSTEM_EFI_APPLICATION, dll_chars: 0x0140, stack_reserve: 0x100000, stack_commit: 0x1000, heap_reserve: 0x100000, heap_commit: 0x1000
    };
    var dirs: Vec<i64> = img_pe_dirs();
    img_pe_dir(&mut dirs, 5, reloc_rva, reloc.len());
    img_pe_optional(&mut pe, &o, &dirs);
    img_pe_section(&mut pe, ".text", code_size, PE_TEXT_RVA, text_raw, text_off, 0x60000020);
    // CODE | EXECUTE | READ
    img_pe_section(&mut pe, ".data", data_len, data_rva, data_raw, data_off, 0xC0000040);
    // INITIALIZED_DATA | READ | WRITE
    img_pe_section(&mut pe, ".reloc", reloc.len(), reloc_rva, reloc_raw, reloc_off, 0x42000040);
    // INITIALIZED_DATA | DISCARDABLE | READ
    img_pad_to(&mut pe, header_size);
    var i: i64 = 0;
    while i < code_size {
        pe.push(flat.get(i));
        i = i + 1;
    }
    img_pad_to(&mut pe, data_off);
    while i < flat.len() {
        pe.push(flat.get(i));
        i = i + 1;
    }
    img_pad_to(&mut pe, reloc_off);
    img_append(&mut pe, &reloc);
    img_pad_to(&mut pe, reloc_off + reloc_raw);
    return pe;
}

/// The .reloc section of a UEFI image: one block per 4 KB page of DIR64
/// entries (type 10) for each offset in `abs` (RVA = PE_TEXT_RVA + offset),
/// each block padded to 4 bytes with an ABSOLUTE entry. Without any, one
/// block of padding only: the image still says it can be relocated.
pub fn pe_efi_relocs(abs: Vec<i64>) -> Vec<i64> {
    // TG13: the blocks from image_writer (the old body, checked byte for
    // byte against it on Nov 17, is gone: docs/reference/image-writer.md)
    var at: Vec<i64> = Vec::new();
    var a: i64 = 0;
    while a < abs.len() {
        at.push(PE_TEXT_RVA + abs.get(a));
        a = a + 1;
    }
    return img_pe_base_relocs(&at, PE_TEXT_RVA);
}

/// Build a complete PE32+ executable from .text and .rdata section data
pub fn pe_build_file(text: Vec<i64>, rdata: Vec<i64>, entry_point_rva: i64, import_dir_rva: i64, iat_rva: i64, iat_size: i64, rdata_rva: i64) -> Vec<i64> {
    // TG13: a layout over image_writer (pe_build_file_img; the old body,
    // checked byte for byte against it on Nov 17, is gone:
    // docs/reference/image-writer.md)
    return pe_build_file_img(&text, &rdata, entry_point_rva, import_dir_rva, iat_rva, iat_size, rdata_rva);
}

/// TG13: pe_build_file as a layout over image_writer (same bytes): a full
/// DOS header, COFF header, PE32+ optional header (console, 4 GB stack
/// reserve, imports in directories 1 and 12), .text and .rdata.
pub fn pe_build_file_img(text: &Vec<i64>, rdata: &Vec<i64>, entry_point_rva: i64, import_dir_rva: i64, iat_rva: i64, iat_size: i64, rdata_rva: i64) -> Vec<i64> {
    var pe: Vec<i64> = Vec::new();
    // DOS(64) + PE sig(4) + COFF(20) + Optional(240) + 2 sections(80),
    // aligned up to FILE_ALIGN: 512
    var header_size: i64 = pe_align_up(64 + 4 + 20 + 240 + 2 * 40, PE_FILE_ALIGN);
    var text_raw_size: i64 = pe_align_up(text.len(), PE_FILE_ALIGN);
    var rdata_raw_size: i64 = pe_align_up(rdata.len(), PE_FILE_ALIGN);
    var text_virt_size: i64 = pe_align_up(text.len(), PE_SECTION_ALIGN);
    var rdata_virt_size: i64 = pe_align_up(rdata.len(), PE_SECTION_ALIGN);
    var size_of_image: i64 = pe_align_up(header_size, PE_SECTION_ALIGN) + text_virt_size + rdata_virt_size;
    img_pe_dos(&mut pe, true);
    img_pe_signature(&mut pe);
    img_coff_header(&mut pe, 0x8664, 2, 0, 0, 240, 0x0022);
    // AMD64, .text and .rdata; EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE
    // The stack reserve is 4 GB: native frames are large (one slot per IR
    // value, no reuse) and the checker and parser recurse deeply
    var o: ImgPeOpt = ImgPeOpt {
        linker_major: 14, code_size: text_raw_size, init_size: rdata_raw_size, entry: entry_point_rva, base_of_code: PE_TEXT_RVA, image_base: PE_IMAGE_BASE, sect_align: PE_SECTION_ALIGN, file_align: PE_FILE_ALIGN, os_major: 6, subsys_major: 6, image_size: size_of_image, header_size: header_size, subsystem: 3, dll_chars: 0, stack_reserve: 0x100000000, stack_commit: 0x100000, heap_reserve: 0x100000, heap_commit: 0x1000
    };
    var dirs: Vec<i64> = img_pe_dirs();
    img_pe_dir(&mut dirs, 1, import_dir_rva, 20);
    // one descriptor + the null one
    img_pe_dir(&mut dirs, 12, iat_rva, iat_size);
    img_pe_optional(&mut pe, &o, &dirs);
    img_pe_section(&mut pe, ".text", text_virt_size, PE_TEXT_RVA, text_raw_size, PE_FILE_ALIGN, 0x60000020);
    // CODE | EXECUTE | READ
    img_pe_section(&mut pe, ".rdata", rdata_virt_size, rdata_rva, rdata_raw_size, PE_FILE_ALIGN + text_raw_size, 0xC0000040);
    // INITIALIZED_DATA | READ | WRITE (the IAT is written)
    img_pad_to(&mut pe, header_size);
    img_append(&mut pe, text);
    img_pad_to(&mut pe, header_size + text_raw_size);
    img_append(&mut pe, rdata);
    img_pad_to(&mut pe, header_size + text_raw_size + rdata_raw_size);
    return pe;
}

// ===========================================================================
// COFF symbol table (own-backend roadmap DB3, first step)
// ===========================================================================

/// File offsets in the COFF header of a pe_build_file image (DOS header 64
/// bytes, "PE\0\0" 4, then Machine, NumberOfSections, TimeDateStamp).
pub const PE_COFF_SYMTAB_PTR_AT: i64 = 76;
pub const PE_COFF_NSYMS_AT: i64 = 80;

fn pe_sym_u16(out: &mut Vec<i64>, v: i64) {
    out.push(v & 0xFF);
    out.push((v >> 8) & 0xFF);
}

fn pe_sym_u32(out: &mut Vec<i64>, v: i64) {
    pe_sym_u16(out, v);
    pe_sym_u16(out, v >> 16);
}

/// Append a COFF symbol table to `image`, one function symbol per entry of
/// `names` at .text offset `offs[i]`, and point the COFF header at it.
/// The table goes after the last section (the loader maps sections only,
/// so it is not part of the image in memory), as MinGW's linker writes it:
/// llvm-nm, llvm-objdump -t, dumpbin /symbols and gdb name our functions
/// from it. It is not a PDB: Visual Studio and WinDbg want one (DB3, left).
/// Record (18 bytes): Name (8: inline when at most 8 bytes, else 0 then the
/// string table offset), Value (offset in the section), SectionNumber 1
/// (.text), Type 0x20 (function), StorageClass 2 (external), 0 aux records.
/// Then the string table: its size (4 bytes, counted) and NUL-ended names.
pub fn pe_append_coff_symbols(image: &mut Vec<i64>, names: Vec<str>, offs: Vec<i64>) {
    pe_append_coff_symbols_pre(image, Vec::new(), names, offs);
}

/// pe_append_coff_symbols with the string table starting with the names
/// `pre` (DB3: the long names of the debug sections, which their section
/// headers name as "/4", "/18", ... : pe_add_debug_sections).
pub fn pe_append_coff_symbols_pre(image: &mut Vec<i64>, pre: Vec<str>, names: Vec<str>, offs: Vec<i64>) {
    if (names.len() == 0 && pre.len() == 0) || names.len() != offs.len() {
        return;
    }
    // TG13: the records and string table from image_writer (global
    // functions of section 1, .text; the old body, checked byte for byte
    // against it on Nov 17, is gone: docs/reference/image-writer.md)
    var none: Vec<i64> = Vec::new();
    var syms: Vec<ImgSym> = img_func_syms(&names, &offs, &none, 0, 1, IMG_GLOBAL);
    img_coff_symbols(image, &pre, &syms, PE_COFF_SYMTAB_PTR_AT, PE_COFF_NSYMS_AT);
}

// ===========================================================================
// DWARF line tables in the image (own-backend roadmap DB3; release N9,
// competitive TL5). A debug build (pe_lines_setup) gets .debug_abbrev,
// .debug_info and .debug_line sections after .rdata, as MinGW's linker
// writes them: gdb, lldb and llvm-dwarfdump read DWARF from a PE image, so
// they show the input file's functions and lines. The names are longer than
// 8 bytes: each header says "/<offset>" into the COFF string table, which
// starts with them (pe_append_coff_symbols_pre). A PDB (what Visual Studio
// and WinDbg read) is not written yet.
// ===========================================================================

/// The DWARF sections pe_add_debug_sections adds, in that order (N9:
/// pe_add_dwarf adds the fourth, .debug_frame, too; a three-section image
/// leaves its name unused in the string table).
pub fn pe_dwarf_section_names() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push(".debug_abbrev");
    v.push(".debug_info");
    v.push(".debug_line");
    v.push(".debug_frame");
    return v;
}

fn pe_dw_u64(out: &mut Vec<i64>, v: i64) {
    pe_sym_u32(out, v);
    pe_sym_u32(out, v >> 32);
}

fn pe_dw_str(out: &mut Vec<i64>, s: str) {
    var i: i64 = 0;
    while i < str_len(s) {
        out.push(str_byte_at(s, i));
        i = i + 1;
    }
    out.push(0);
}

fn pe_dw_uleb(out: &mut Vec<i64>, v: i64) {
    var x: i64 = v;
    while true {
        var b: i64 = x & 127;
        x = x >> 7;
        if x == 0 {
            out.push(b);
            return;
        }
        out.push(b | 128);
    }
}

fn pe_dw_sleb(out: &mut Vec<i64>, v: i64) {
    var x: i64 = v;
    while true {
        var b: i64 = x & 127;
        x = x >> 7;
        if (x == 0 && (b & 64) == 0) || (x == 0 - 1 && (b & 64) != 0) {
            out.push(b);
            return;
        }
        out.push(b | 128);
    }
}

pub fn pe_get_u32(v: &Vec<i64>, at: i64) -> i64 {
    return v.get(at) | (v.get(at + 1) << 8) | (v.get(at + 2) << 16) | (v.get(at + 3) << 24);
}

pub fn pe_set_u32(v: &mut Vec<i64>, at: i64, val: i64) {
    var i: i64 = 0;
    while i < 4 {
        v.set(at + i, (val >> (8 * i)) & 0xFF);
        i = i + 1;
    }
}

/// The address of .text offset `off` in the loaded image.
fn pe_dw_addr(off: i64) -> i64 {
    return PE_IMAGE_BASE + PE_TEXT_RVA + off;
}

/// .debug_abbrev: 1 the compile unit (producer, language, name, low_pc,
/// high_pc as a length, stmt_list), 2 a function (name, low_pc, high_pc,
/// external). The same as nat_enc.fd's ELF debug sections.
pub fn pe_dwarf_abbrev() -> Vec<i64> {
    var a: Vec<i64> = Vec::new();
    a.push(1);
    a.push(0x11);
    a.push(1);
    a.push(0x25);
    a.push(0x08);
    a.push(0x13);
    a.push(0x05);
    a.push(0x03);
    a.push(0x08);
    a.push(0x11);
    a.push(0x01);
    a.push(0x12);
    a.push(0x07);
    a.push(0x10);
    a.push(0x17);
    a.push(0);
    a.push(0);
    a.push(2);
    a.push(0x2E);
    a.push(0);
    a.push(0x03);
    a.push(0x08);
    a.push(0x11);
    a.push(0x01);
    a.push(0x12);
    a.push(0x07);
    a.push(0x3F);
    a.push(0x19);
    a.push(0);
    a.push(0);
    a.push(0);
    return a;
}

/// .debug_info (DWARF 4): the compile unit of `file`, a function entry per
/// [names, starts, ends) (.text offsets, in address order).
pub fn pe_dwarf_info(file: str, names: Vec<str>, starts: Vec<i64>, ends: Vec<i64>) -> Vec<i64> {
    var info: Vec<i64> = Vec::new();
    pe_sym_u32(&mut info, 0);
    // unit length, set below
    pe_sym_u16(&mut info, 4);
    pe_sym_u32(&mut info, 0);
    // abbrev offset
    info.push(8);
    info.push(1);
    pe_dw_str(&mut info, "fid (Fides)");
    pe_sym_u16(&mut info, 0x0C);
    // DW_LANG_C99: what debuggers expect
    if file == "" {
        pe_dw_str(&mut info, "fides");
    } else {
        pe_dw_str(&mut info, file);
    }
    var lo: i64 = 0;
    var hi: i64 = 0;
    if starts.len() > 0 && ends.len() > 0 {
        lo = starts.get(0);
        hi = ends.get(ends.len() - 1);
    }
    pe_dw_u64(&mut info, pe_dw_addr(lo));
    pe_dw_u64(&mut info, hi - lo);
    pe_sym_u32(&mut info, 0);
    // the line program at .debug_line + 0
    var i: i64 = 0;
    while i < names.len() && i < starts.len() && i < ends.len() {
        info.push(2);
        pe_dw_str(&mut info, names.get(i));
        pe_dw_u64(&mut info, pe_dw_addr(starts.get(i)));
        pe_dw_u64(&mut info, ends.get(i) - starts.get(i));
        i = i + 1;
    }
    info.push(0);
    pe_set_u32(&mut info, 0, info.len() - 4);
    return info;
}

/// .debug_line (DWARF 4) of the rows [.text offset, line, end?]: one file,
/// a sequence per function (an end row closes it).
pub fn pe_dwarf_line(file: str, rows: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    pe_sym_u32(&mut out, 0);
    // unit length, set below
    pe_sym_u16(&mut out, 4);
    pe_sym_u32(&mut out, 0);
    // header length, set below
    var hstart: i64 = out.len();
    out.push(1);
    // minimum instruction length
    out.push(1);
    // maximum operations per instruction
    out.push(1);
    // default is_stmt
    out.push(0xFB);
    // line_base -5
    out.push(14);
    // line_range
    out.push(13);
    // opcode_base, then the standard opcodes' operand counts
    out.push(0);
    out.push(1);
    out.push(1);
    out.push(1);
    out.push(1);
    out.push(0);
    out.push(0);
    out.push(0);
    out.push(1);
    out.push(0);
    out.push(0);
    out.push(1);
    out.push(0);
    // no include directories
    pe_dw_str(&mut out, file);
    out.push(0);
    out.push(0);
    out.push(0);
    // directory, time, size
    out.push(0);
    pe_set_u32(&mut out, 6, out.len() - hstart);
    var open: bool = false;
    var addr: i64 = 0;
    var line: i64 = 1;
    var i: i64 = 0;
    while i + 2 < rows.len() {
        var at: i64 = pe_dw_addr(rows.get(i));
        var l: i64 = rows.get(i + 1);
        if rows.get(i + 2) == 1 {
            if open {
                out.push(0x02);
                pe_dw_uleb(&mut out, at - addr);
                // advance_pc
                out.push(0);
                out.push(1);
                out.push(1);
                // end_sequence
                open = false;
                line = 1;
            }
        } else {
            if !open {
                out.push(0);
                out.push(9);
                out.push(2);
                // set_address
                pe_dw_u64(&mut out, at);
                addr = at;
                open = true;
            } else if at != addr {
                out.push(0x02);
                pe_dw_uleb(&mut out, at - addr);
                addr = at;
            }
            if l != line {
                out.push(0x03);
                pe_dw_sleb(&mut out, l - line);
                // advance_line
                line = l;
            }
            out.push(0x01);
            // copy
        }
        i = i + 3;
    }
    pe_set_u32(&mut out, 0, out.len() - 4);
    return out;
}

/// One debug section: header `k` (after .text and .rdata), its data at the
/// end of the file (file-aligned), at `rva` in memory; returns the next RVA.
fn pe_put_debug_section(out: &mut Vec<i64>, k: i64, name_off: i64, data: Vec<i64>, rva: i64) -> i64 {
    while out.len() % PE_FILE_ALIGN != 0 {
        out.push(0);
    }
    var pos: i64 = out.len();
    var raw: i64 = pe_align_up(data.len(), PE_FILE_ALIGN);
    var h: i64 = 408 + 40 * k;
    var hn: str = "/" + int_to_str(name_off);
    // TG13: the header from image_writer (its relocation and line number
    // fields were zero already; the old body, checked byte for byte
    // against it on Nov 17, is gone: docs/reference/image-writer.md);
    // INITIALIZED_DATA | MEM_DISCARDABLE | MEM_READ
    img_pe_section_at(out, h, hn, data.len(), rva, raw, pos, 0x42000040);
    img_append(out, &data);
    img_pad_to(out, pos + raw);
    return rva + pe_align_up(data.len(), PE_SECTION_ALIGN);
}

/// A pe_build_file image (two sections, 512 bytes of headers) with the
/// three DWARF sections after .rdata. The headers grow to 1024 bytes for
/// the five section headers: .text and .rdata move 512 bytes down the file
/// (their addresses in memory do not change), SizeOfImage covers the new
/// sections. Another image comes back as it is. The COFF string table
/// with the section names is written after (pe_append_coff_symbols_pre).
pub fn pe_add_debug_sections(image: Vec<i64>, abbrev: Vec<i64>, info: Vec<i64>, line: Vec<i64>) -> Vec<i64> {
    var parts: Vec<Vec<i64>> = Vec::new();
    parts.push(abbrev);
    parts.push(info);
    parts.push(line);
    return pe_add_debug_sections_n(image, parts);
}

/// N9: pe_add_debug_sections with the sections `parts`, named in the
/// order of pe_dwarf_section_names (at most its four: .debug_abbrev,
/// .debug_info, .debug_line, .debug_frame). Three parts give the bytes
/// pe_add_debug_sections always wrote.
pub fn pe_add_debug_sections_n(image: Vec<i64>, parts: Vec<Vec<i64>>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    var ok: bool = image.len() >= 2 * PE_FILE_ALIGN;
    if ok {
        ok = (image.get(70) | (image.get(71) << 8)) == 2 && pe_get_u32(&image, 148) == PE_FILE_ALIGN;
    }
    if !ok {
        while i < image.len() {
            out.push(image.get(i));
            i = i + 1;
        }
        return out;
    }
    while i < PE_FILE_ALIGN {
        out.push(image.get(i));
        i = i + 1;
    }
    var z: i64 = 0;
    while z < PE_FILE_ALIGN {
        out.push(0);
        z = z + 1;
    }
    while i < image.len() {
        out.push(image.get(i));
        i = i + 1;
    }
    pe_set_u32(&mut out, 148, 2 * PE_FILE_ALIGN);
    // SizeOfHeaders
    pe_set_u32(&mut out, 328 + 20, pe_get_u32(&out, 328 + 20) + PE_FILE_ALIGN);
    pe_set_u32(&mut out, 368 + 20, pe_get_u32(&out, 368 + 20) + PE_FILE_ALIGN);
    // .text and .rdata PointerToRawData
    var rva: i64 = pe_align_up(pe_get_u32(&out, 368 + 12) + pe_get_u32(&out, 368 + 8), PE_SECTION_ALIGN);
    var init0: i64 = pe_get_u32(&out, 96);
    var names: Vec<str> = pe_dwarf_section_names();
    var noff: i64 = 4;
    var sinit: i64 = 0;
    var k: i64 = 0;
    while k < parts.len() && k < names.len() {
        var part: Vec<i64> = parts.get(k);
        rva = pe_put_debug_section(&mut out, k, noff, part, rva);
        noff = noff + str_len(names.get(k)) + 1;
        sinit = sinit + pe_align_up(part.len(), PE_FILE_ALIGN);
        k = k + 1;
    }
    out.set(70, 2 + k);
    out.set(71, 0);
    // NumberOfSections
    pe_set_u32(&mut out, 144, rva);
    // SizeOfImage
    pe_set_u32(&mut out, 96, init0 + sinit);
    // SizeOfInitializedData
    return out;
}

// --- N9 (DB4 for pe_ir): variables, types and frames ----------------------
// A debug build of the default Windows backend describes, besides its
// functions and lines, each function's parameters and variables with
// their types (structs with their fields, str as text) and where they
// are, and each function's frame, as the machine layer's images do: the
// .debug_info and .debug_frame come from nat_enc.fd nat_dwarf_build, fed
// what pe_ir.fd recorded (PeirGen_dbg_vars_note: g_nat_dbg_vars' format;
// peir_dbg_type_descs: g_nat_dbg_types'). A variable's location is
// "f<off>" (its frame slot at CFA + off: pe_ir keeps a debug build's
// values in their rbp slots, CFA = rbp + 16 after the prologue
// `push rbp; mov rbp, rsp`, which the FDE describes), "c<v>" (a constant)
// or "" (shown as optimized out). FID_PE_OFF=dbgvars: the three sections
// of pe_add_debug_sections only, as before.

/// CT9: the functions whose debugger name differs from their symbol, as
/// pairs [symbol, shown, ...] (compiler/nat_ir.fd ng_dbg_shown_pairs, set
/// by compiler/main.fd before a pe_ir debug build); empty: every
/// function shows its symbol.
pub var g_pe_dbg_shown_pairs: Vec<str> = Vec::new();

/// CT9: the name a debugger shows for each of `names`, in the same order
/// (g_nat_dbg_shown's format): its g_pe_dbg_shown_pairs entry, else the
/// symbol. Empty when no name differs.
fn pe_dbg_shown_for(names: Vec<str>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if g_pe_dbg_shown_pairs.len() == 0 {
        return out;
    }
    // symbol -> index of its shown name + 1 (0: not there)
    var idx: i64 = HashMap_new();
    var k: i64 = 0;
    while k + 1 < g_pe_dbg_shown_pairs.len() {
        HashMap_insert(idx, g_pe_dbg_shown_pairs.get(k), k + 2);
        k = k + 2;
    }
    var any: bool = false;
    var i: i64 = 0;
    while i < names.len() {
        var at: i64 = HashMap_get(idx, names.get(i));
        if at > 0 {
            out.push(g_pe_dbg_shown_pairs.get(at - 1));
            any = true;
        } else {
            out.push(names.get(i));
        }
        i = i + 1;
    }
    if !any {
        return Vec::new();
    }
    return out;
}

/// N9: `image` (a pe_build_file image whose .text is `code`) with the
/// DWARF of a debug build: .debug_abbrev, .debug_info (functions with
/// their declaration lines, parameters, variables and types), .debug_line
/// (pe_dwarf_line of `rows`) and .debug_frame (an FDE per function).
/// `vars` and `types` are in nat_enc.fd's g_nat_dbg_vars / g_nat_dbg_types
/// formats (vars: one entry per name of `names`, same order). nat_enc's
/// globals are set for the call and given back after.
/// CT9: a function shows under its name as written (`Point::len` for
/// `Point_len`, `max<i64>` for `max__i64`) when g_pe_dbg_shown_pairs
/// names it (pe_dbg_shown_for).
pub fn pe_add_dwarf(image: Vec<i64>, code: Vec<i64>, names: Vec<str>, starts: Vec<i64>, ends: Vec<i64>, rows: Vec<i64>, file: str, vars: Vec<str>, types: Vec<str>) -> Vec<i64> {
    var line: Vec<i64> = pe_dwarf_line(file, rows);
    if vars.len() != names.len() {
        return pe_add_debug_sections(image, pe_dwarf_abbrev(), pe_dwarf_info(file, names, starts, ends), line);
    }
    var old_ext: bool = g_nat_dbg_ext;
    var old_vars: Vec<str> = g_nat_dbg_vars;
    var old_types: Vec<str> = g_nat_dbg_types;
    var old_shown: Vec<str> = g_nat_dbg_shown;
    var old_files: Vec<str> = g_nat_line_files;
    g_nat_dbg_ext = true;
    g_nat_dbg_vars = vars;
    g_nat_dbg_types = types;
    g_nat_dbg_shown = pe_dbg_shown_for(names);
    // pe_ir's rows name one file (field 3 is 0 or 1, the end bit): the
    // declaration lines are read from `file`
    g_nat_line_files = Vec::new();
    var dw: NatDwarf = nat_dwarf_build(NAT_X64, code, PE_IMAGE_BASE + PE_TEXT_RVA, names, starts, ends, file, rows, Vec::new(), false);
    g_nat_dbg_ext = old_ext;
    g_nat_dbg_vars = old_vars;
    g_nat_dbg_types = old_types;
    g_nat_dbg_shown = old_shown;
    g_nat_line_files = old_files;
    var parts: Vec<Vec<i64>> = Vec::new();
    parts.push(dw.abbrev);
    parts.push(dw.info);
    parts.push(line);
    parts.push(dw.frame);
    return pe_add_debug_sections_n(image, parts);
}
