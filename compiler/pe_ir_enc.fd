// ─── Label resolution ───

/// Resolve all pending label relocations (local jumps/calls)
pub fn PeirEnc_resolve_labels(self: &mut PeirEnc) -> void {
    var i: i64 = 0;
    while i < self.pending_labels.len() {
        var reloc: PeirReloc = self.pending_labels.get(i);
        var target_offset: i64 = -1;
        if reloc.target_label >= 0 && reloc.target_label < self.labels.len() {
            target_offset = self.labels.get(reloc.target_label);
        }
        if target_offset >= 0 {
            var disp: i64 = target_offset - (reloc.code_offset + 4);
            var j: i64 = 0;
            while j < 4 {
                self.code.set(reloc.code_offset + j, (disp >> (j * 8)) & 0xFF);
                j = j + 1;
            }
        } else {
            p_eprint_str("[PE] WARNING: unresolved label " + int_to_str(reloc.target_label) + " at code offset 0x" + pe_to_hex(reloc.code_offset) + "\n");
        }
        i = i + 1;
    }
}

/// Resolve all RIP-relative references to .rdata
/// text_rva: virtual address of .text section start
/// rdata_rva: virtual address of .rdata section start
pub fn PeirEnc_resolve_rip_refs(self: &mut PeirEnc, text_rva: i64, rdata_rva: i64) -> void {
    var i: i64 = 0;
    while i < self.pending_rip_refs.len() {
        var ref_: PeirRipRef = self.pending_rip_refs.get(i);
        var code_rva: i64 = text_rva + ref_.code_offset;
        var target_rva: i64 = rdata_rva + ref_.rdata_offset;
        var disp: i64 = target_rva - (code_rva + 4);
        var j: i64 = 0;
        while j < 4 {
            self.code.set(ref_.code_offset + j, (disp >> (j * 8)) & 0xFF);
            j = j + 1;
        }
        i = i + 1;
    }
}

// ===========================================================================
// Import table
// ===========================================================================

/// Names of kernel32.dll functions we import (the first 13 have PIAT_*
/// constants; the rest are reached by name through `pe_import_slot`).
pub fn pe_kernel32_imports() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("GetStdHandle");
    v.push("WriteFile");
    v.push("ExitProcess");
    v.push("GetProcessHeap");
    v.push("HeapAlloc");
    v.push("HeapFree");
    v.push("CreateFileA");
    v.push("ReadFile");
    v.push("CloseHandle");
    v.push("GetFileSize");
    v.push("GetCommandLineA");
    v.push("CreateProcessA");
    v.push("WaitForSingleObject");
    // Threads, locks, thread-local storage, clocks, files, libraries
    v.push("CreateThread");
    v.push("Sleep");
    v.push("GetTickCount64");
    v.push("QueryPerformanceCounter");
    v.push("QueryPerformanceFrequency");
    v.push("GetSystemTimeAsFileTime");
    v.push("DeleteFileA");
    v.push("GetFileAttributesA");
    v.push("GetCurrentProcessId");
    v.push("CreateDirectoryA");
    v.push("RemoveDirectoryA");
    v.push("FindFirstFileA");
    v.push("FindNextFileA");
    v.push("FindClose");
    v.push("InitializeSRWLock");
    v.push("AcquireSRWLockExclusive");
    v.push("ReleaseSRWLockExclusive");
    v.push("InitializeConditionVariable");
    v.push("SleepConditionVariableSRW");
    v.push("WakeConditionVariable");
    v.push("WakeAllConditionVariable");
    v.push("TlsAlloc");
    v.push("TlsGetValue");
    v.push("TlsSetValue");
    v.push("LoadLibraryA");
    v.push("GetProcAddress");
    v.push("FreeLibrary");
    v.push("AddVectoredExceptionHandler");
    v.push("ConvertThreadToFiber");
    v.push("CreateFiberEx");
    v.push("SwitchToFiber");
    v.push("DeleteFiber");
    return v;
}

/// msvcrt.dll functions: the C library behind `extern "C"` declarations
/// (math.h, string.h, stdio.h, stdlib.h, ctype.h) and the Fides PE runtime
/// (src/pe_runtime/). Every name here must be an msvcrt.dll export: the
/// loader refuses to start a program importing one that is not.
pub fn pe_msvcrt_imports() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("sqrt"); v.push("pow"); v.push("floor"); v.push("ceil");
    v.push("fabs"); v.push("fmod"); v.push("exp"); v.push("log");
    v.push("log10");
    v.push("sin"); v.push("cos"); v.push("tan"); v.push("asin");
    v.push("acos"); v.push("atan"); v.push("atan2"); v.push("sinh");
    v.push("cosh"); v.push("tanh");
    v.push("strtod"); v.push("_strtoi64"); v.push("atof"); v.push("atoi");
    v.push("atol");
    v.push("strlen"); v.push("strcmp"); v.push("strncmp"); v.push("strcpy");
    v.push("strncpy"); v.push("strcat"); v.push("strchr"); v.push("strstr");
    v.push("memcpy"); v.push("memmove"); v.push("memset"); v.push("memcmp");
    v.push("toupper"); v.push("tolower"); v.push("isalpha"); v.push("isdigit");
    v.push("isspace"); v.push("isalnum");
    v.push("abs"); v.push("labs"); v.push("_abs64"); v.push("rand");
    v.push("srand"); v.push("time"); v.push("clock");
    v.push("malloc"); v.push("calloc"); v.push("realloc"); v.push("free");
    v.push("getenv"); v.push("exit"); v.push("qsort"); v.push("bsearch"); v.push("ldiv");
    v.push("_snprintf"); v.push("putchar"); v.push("puts"); v.push("getchar");
    v.push("fopen"); v.push("fclose"); v.push("fread"); v.push("fwrite");
    v.push("fflush"); v.push("fgets"); v.push("fputs");
    v.push("fseek"); v.push("ftell"); v.push("_fseeki64"); v.push("remove"); v.push("rand_s");
    v.push("rename"); v.push("_access");
    v.push("system");
    return v;
}

/// One DLL and its imported names, in IAT order (DLL_IMPORTS in Rust).
pub struct PeDllImport {
    pub dll: str,
    pub names: Vec<str>,
}

// What this program imports beyond kernel32 and msvcrt: `extern "C" link "x"`
var g_pe_extra_imports: Vec<PeDllImport> = Vec::new();

pub fn pe_clear_extra_imports() {
    g_pe_extra_imports = Vec::new();
}

/// Import `name` from `dll` as well.
pub fn pe_add_extra_import(dll: str, name: str) {
    var i: i64 = 0;
    while i < g_pe_extra_imports.len() {
        var e: PeDllImport = g_pe_extra_imports.get(i);
        if e.dll == dll {
            var k: i64 = 0;
            while k < e.names.len() {
                if e.names.get(k) == name { return; }
                k = k + 1;
            }
            e.names.push(name);
            return;
        }
        i = i + 1;
    }
    var names: Vec<str> = Vec::new();
    names.push(name);
    g_pe_extra_imports.push(PeDllImport { dll: dll, names: names });
}

/// The DLL of a `link` library, "" for the Unix libraries the C runtime covers.
pub fn pe_link_dll(lib: str) -> str {
    if lib == "" || lib == "m" || lib == "c" || lib == "pthread" || lib == "dl" || lib == "rt"
        || lib == "msvcrt" || lib == "kernel32" { return ""; }
    if lib == "GL" { return "opengl32.dll"; }
    if lib == "GLU" { return "glu32.dll"; }
    if str_ends_with(lib, ".dll") { return lib; }
    return lib + ".dll";
}

/// The DLLs of the import table, in IAT order.
pub fn pe_dll_imports() -> Vec<PeDllImport> {
    var v: Vec<PeDllImport> = Vec::new();
    v.push(PeDllImport { dll: "kernel32.dll", names: pe_kernel32_imports() });
    v.push(PeDllImport { dll: "msvcrt.dll", names: pe_msvcrt_imports() });
    var i: i64 = 0;
    while i < g_pe_extra_imports.len() {
        v.push(g_pe_extra_imports.get(i));
        i = i + 1;
    }
    return v;
}

/// The IAT slot of an imported function (an index into `iat_rdata_offsets`).
/// Returns -1 when `name` is not imported (Rust: Option<usize> -> None).
pub fn pe_import_slot(name: str) -> i64 {
    var base: i64 = 0;
    var dlls: Vec<PeDllImport> = pe_dll_imports();
    var d: i64 = 0;
    while d < dlls.len() {
        var names: Vec<str> = dlls.get(d).names;
        var i: i64 = 0;
        while i < names.len() {
            if names.get(i) == name {
                return base + i;
            }
            i = i + 1;
        }
        base = base + names.len();
        d = d + 1;
    }
    return -1;
}

/// IAT indices for each imported function (first 13 kernel32 imports)
pub const PIAT_GET_STD_HANDLE: i64 = 0;
pub const PIAT_WRITE_FILE: i64 = 1;
pub const PIAT_EXIT_PROCESS: i64 = 2;
pub const PIAT_GET_PROCESS_HEAP: i64 = 3;
pub const PIAT_HEAP_ALLOC: i64 = 4;
pub const PIAT_HEAP_FREE: i64 = 5;
pub const PIAT_CREATE_FILE_A: i64 = 6;
pub const PIAT_READ_FILE: i64 = 7;
pub const PIAT_CLOSE_HANDLE: i64 = 8;
pub const PIAT_GET_FILE_SIZE: i64 = 9;
pub const PIAT_GET_COMMAND_LINE_A: i64 = 10;
pub const PIAT_CREATE_PROCESS_A: i64 = 11;
pub const PIAT_WAIT_FOR_SINGLE_OBJECT: i64 = 12;

// ===========================================================================
// PeirRdata — builds the .rdata section: string constants + import table
// ===========================================================================

pub struct PeirRdata {
    pub data: Vec<i64>,
    /// Offset of each IAT entry within .rdata (indexed by import position)
    pub iat_offsets: Vec<i64>,
    /// Offset of import directory table within .rdata
    pub import_dir_offset: i64,
    /// Offset+1 of each string constant within .rdata (str -> i64 map; 0 = absent)
    pub string_offsets: i64,
    /// Offset of each DLL's ILT within .rdata
    pub ilt_offsets: Vec<i64>,
    /// Offset of the whole IAT within .rdata, and its size in bytes
    pub iat_offset: i64,
    pub iat_size: i64,
    /// Offset of each DLL's part of the IAT within .rdata
    pub dll_iat_offsets: Vec<i64>,
    /// Offset of each DLL name string within .rdata
    pub dll_name_offs: Vec<i64>,
    /// Offsets of IMAGE_IMPORT_BY_NAME entries within .rdata (IAT order)
    pub import_by_name_offsets: Vec<i64>,
}

pub fn PeirRdata_new() -> PeirRdata {
    return PeirRdata {
        data: Vec::new(),
        iat_offsets: Vec::new(),
        import_dir_offset: 0,
        string_offsets: HashMap_new(),
        ilt_offsets: Vec::new(),
        iat_offset: 0,
        iat_size: 0,
        dll_iat_offsets: Vec::new(),
        dll_name_offs: Vec::new(),
        import_by_name_offsets: Vec::new(),
    };
}

/// Add a null-terminated string to .rdata, return its offset
pub fn PeirRdata_add_string(self: &mut PeirRdata, s: str) -> i64 {
    var prev: i64 = HashMap_get(self.string_offsets, s);
    if prev != 0 {
        return prev - 1;
    }
    var offset: i64 = self.data.len();
    var i: i64 = 0;
    while i < str_len(s) {
        self.data.push(str_byte_at(s, i));
        i = i + 1;
    }
    self.data.push(0); // null terminator
    HashMap_insert(self.string_offsets, s, offset + 1);
    return offset;
}

/// Look up a string's .rdata offset, or -1 (Rust Option<usize> -> None).
pub fn PeirRdata_string_offset(self: &PeirRdata, s: str) -> i64 {
    var prev: i64 = HashMap_get(self.string_offsets, s);
    if prev == 0 { return -1; }
    return prev - 1;
}

/// Insertion sort of a string vector (str_compare order), deterministic.
fn pe_sort_strings(v: Vec<str>) -> Vec<str> {
    var i: i64 = 1;
    while i < v.len() {
        var key: str = v.get(i);
        var j: i64 = i - 1;
        while j >= 0 && str_compare(v.get(j), key) > 0 {
            v.set(j + 1, v.get(j));
            j = j - 1;
        }
        v.set(j + 1, key);
        i = i + 1;
    }
    return v;
}

/// Build the complete .rdata section
/// string_constants: all string literals from the IR
pub fn PeirRdata_build(self: &mut PeirRdata, string_constants: Vec<str>) -> void {
    // 1. String constants from user code (sorted: HashMap order would
    //    make the .rdata layout, and so the binary, differ per build)
    var keys: Vec<str> = Vec::new();
    var ki: i64 = 0;
    while ki < string_constants.len() {
        keys.push(string_constants.get(ki));
        ki = ki + 1;
    }
    keys = pe_sort_strings(keys);
    ki = 0;
    while ki < keys.len() {
        PeirRdata_add_string(self, keys.get(ki));
        ki = ki + 1;
    }

    // 2. Boolean strings
    PeirRdata_add_string(self, "true");
    PeirRdata_add_string(self, "false");

    // 3. DLL names
    var dlls: Vec<PeDllImport> = pe_dll_imports();
    var d: i64 = 0;
    while d < dlls.len() {
        self.dll_name_offs.push(PeirRdata_add_string(self, dlls.get(d).dll));
        d = d + 1;
    }

    // 4. IMAGE_IMPORT_BY_NAME for each import, in IAT order
    // Each: 2-byte hint (0) + null-terminated name
    var k: i64 = 0;
    d = 0;
    while d < dlls.len() {
        var names: Vec<str> = dlls.get(d).names;
        var i: i64 = 0;
        while i < names.len() {
            if (self.data.len() % 2) != 0 {
                self.data.push(0); // entries are 2-byte aligned
            }
            var off: i64 = self.data.len();
            self.data.push(0); // hint low
            self.data.push(0); // hint high
            var name: str = names.get(i);
            var ci: i64 = 0;
            while ci < str_len(name) {
                self.data.push(str_byte_at(name, ci));
                ci = ci + 1;
            }
            self.data.push(0); // null terminator
            self.import_by_name_offsets.push(off);
            i = i + 1;
        }
        d = d + 1;
    }

    // Align to 8 bytes for tables
    while (self.data.len() % 8) != 0 {
        self.data.push(0);
    }

    // 5. Import Lookup Tables (ILT), one per DLL — 8-byte entries,
    //    null-terminated (RVAs filled in by patch_rvas)
    d = 0;
    while d < dlls.len() {
        self.ilt_offsets.push(self.data.len());
        var names: Vec<str> = dlls.get(d).names;
        var i: i64 = 0;
        while i < names.len() {
            var z: i64 = 0;
            while z < 8 { self.data.push(0); z = z + 1; }
            i = i + 1;
        }
        var z2: i64 = 0;
        while z2 < 8 { self.data.push(0); z2 = z2 + 1; } // null terminator
        d = d + 1;
    }

    // 6. Import Address Table (IAT): one null-terminated part per DLL,
    //    contiguous, so a single data directory entry covers it
    self.iat_offset = self.data.len();
    k = 0;
    d = 0;
    while d < dlls.len() {
        self.dll_iat_offsets.push(self.data.len());
        var names: Vec<str> = dlls.get(d).names;
        var i: i64 = 0;
        while i < names.len() {
            self.iat_offsets.push(self.data.len());
            // RVA to IMAGE_IMPORT_BY_NAME (placeholder, filled later)
            self.data = pe_push_u64(self.data, self.import_by_name_offsets.get(k));
            k = k + 1;
            i = i + 1;
        }
        var z3: i64 = 0;
        while z3 < 8 { self.data.push(0); z3 = z3 + 1; } // null terminator
        d = d + 1;
    }
    self.iat_size = self.data.len() - self.iat_offset;

    // 7. Import Directory Table — one 20-byte IMAGE_IMPORT_DESCRIPTOR
    //    per DLL, then a null one:
    // OriginalFirstThunk (4): RVA to ILT
    // TimeDateStamp (4): 0
    // ForwarderChain (4): 0
    // Name (4): RVA to DLL name
    // FirstThunk (4): RVA to IAT
    // (placeholders; RVAs filled in by patch_rvas)
    while (self.data.len() % 4) != 0 {
        self.data.push(0);
    }
    self.import_dir_offset = self.data.len();
    d = 0;
    while d < dlls.len() {
        var z4: i64 = 0;
        while z4 < 20 { self.data.push(0); z4 = z4 + 1; }
        d = d + 1;
    }
    var z5: i64 = 0;
    while z5 < 20 { self.data.push(0); z5 = z5 + 1; } // null terminator descriptor
}

/// Patch RVAs in the import table now that we know the .rdata RVA
pub fn PeirRdata_patch_rvas(self: &mut PeirRdata, rdata_rva: i64) -> void {
    var dlls: Vec<PeDllImport> = pe_dll_imports();
    var k: i64 = 0;
    var d: i64 = 0;
    while d < dlls.len() {
        var names: Vec<str> = dlls.get(d).names;
        // ILT and IAT entries: RVAs to IMAGE_IMPORT_BY_NAME
        var j: i64 = 0;
        while j < names.len() {
            var rva: i64 = rdata_rva + self.import_by_name_offsets.get(k);
            var ilt_entry: i64 = self.ilt_offsets.get(d) + j * 8;
            var iat_entry: i64 = self.dll_iat_offsets.get(d) + j * 8;
            self.data = pe_put_u32(self.data, ilt_entry, rva);
            self.data = pe_put_u32(self.data, iat_entry, rva);
            k = k + 1;
            j = j + 1;
        }
        // Import descriptor (TimeDateStamp and ForwarderChain stay 0)
        var dir: i64 = self.import_dir_offset + d * 20;
        var ilt_rva: i64 = rdata_rva + self.ilt_offsets.get(d);
        var name_rva: i64 = rdata_rva + self.dll_name_offs.get(d);
        var iat_rva: i64 = rdata_rva + self.dll_iat_offsets.get(d);
        self.data = pe_put_u32(self.data, dir, ilt_rva);
        self.data = pe_put_u32(self.data, dir + 12, name_rva);
        self.data = pe_put_u32(self.data, dir + 16, iat_rva);
        d = d + 1;
    }
}

// ===========================================================================
// Byte-vector helpers (by-value + return; `&mut Vec` params don't write back
// on the C backend — see the note in arm64_enc.fd)
// ===========================================================================

/// Lowercase hex of a non-negative i64 (no 0x prefix), for diagnostics/dumps.
pub fn pe_to_hex(v: i64) -> str {
    if v == 0 { return "0"; }
    var digits: str = "0123456789abcdef";
    var out: str = "";
    var n: i64 = v;
    while n > 0 {
        var d: i64 = n % 16;
        out = str_slice(digits, d, d + 1) + out;
        n = n / 16;
    }
    return out;
}

/// Hex dump of a byte vector (contiguous lowercase hex).
pub fn pe_bytes_hex(bytes: Vec<i64>) -> str {
    var digits: str = "0123456789abcdef";
    var out: str = "";
    var i: i64 = 0;
    while i < bytes.len() {
        var b: i64 = bytes.get(i) & 0xFF;
        out = out + str_slice(digits, b / 16, b / 16 + 1);
        out = out + str_slice(digits, b % 16, b % 16 + 1);
        i = i + 1;
    }
    return out;
}

pub fn pe_push_u64(t: Vec<i64>, v: i64) -> Vec<i64> {
    t.push(v & 0xFF);
    t.push((v >> 8) & 0xFF);
    t.push((v >> 16) & 0xFF);
    t.push((v >> 24) & 0xFF);
    t.push((v >> 32) & 0xFF);
    t.push((v >> 40) & 0xFF);
    t.push((v >> 48) & 0xFF);
    t.push((v >> 56) & 0xFF);
    return t;
}

pub fn pe_push_u32(t: Vec<i64>, v: i64) -> Vec<i64> {
    t.push(v & 0xFF);
    t.push((v >> 8) & 0xFF);
    t.push((v >> 16) & 0xFF);
    t.push((v >> 24) & 0xFF);
    return t;
}

pub fn pe_push_u16(t: Vec<i64>, v: i64) -> Vec<i64> {
    t.push(v & 0xFF);
    t.push((v >> 8) & 0xFF);
    return t;
}

pub fn pe_put_u32(t: Vec<i64>, at: i64, v: i64) -> Vec<i64> {
    t.set(at, v & 0xFF);
    t.set(at + 1, (v >> 8) & 0xFF);
    t.set(at + 2, (v >> 16) & 0xFF);
    t.set(at + 3, (v >> 24) & 0xFF);
    return t;
}

pub fn pe_push_str(t: Vec<i64>, s: str) -> Vec<i64> {
    var i: i64 = 0;
    while i < str_len(s) {
        t.push(str_byte_at(s, i));
        i = i + 1;
    }
    return t;
}

// ===========================================================================
// PE file builder
// ===========================================================================

pub const PE_IMAGE_BASE: i64 = 0x140000000;
pub const PE_SECTION_ALIGN: i64 = 0x1000;
pub const PE_FILE_ALIGN: i64 = 0x200;
pub const PE_TEXT_RVA: i64 = 0x1000;

pub fn pe_align_up(val: i64, align: i64) -> i64 {
    return (val + align - 1) & (~(align - 1));
}

/// Build a complete PE32+ executable from .text and .rdata section data
pub fn pe_build_file(text: Vec<i64>, rdata: Vec<i64>, entry_point_rva: i64, import_dir_rva: i64, iat_rva: i64, iat_size: i64, rdata_rva: i64) -> Vec<i64> {
    var pe: Vec<i64> = Vec::new();

    // Header size: DOS(64) + PE sig(4) + COFF(20) + Optional(240) + 2
    // sections(80) = 408 bytes, aligned up to FILE_ALIGN (512).
    var header_size: i64 = pe_align_up(64 + 4 + 20 + 240 + 2 * 40, PE_FILE_ALIGN); // = 512

    // Section sizes (aligned to FILE_ALIGN for raw data)
    var text_raw_size: i64 = pe_align_up(text.len(), PE_FILE_ALIGN);
    var rdata_raw_size: i64 = pe_align_up(rdata.len(), PE_FILE_ALIGN);

    // Virtual sizes (aligned to SECTION_ALIGN)
    var text_virt_size: i64 = pe_align_up(text.len(), PE_SECTION_ALIGN);
    var rdata_virt_size: i64 = pe_align_up(rdata.len(), PE_SECTION_ALIGN);

    // SizeOfImage: headers + .text + .rdata (aligned)
    var size_of_image: i64 = pe_align_up(header_size, PE_SECTION_ALIGN) + text_virt_size + rdata_virt_size;

    // ─── DOS Header (64 bytes) ───
    pe = pe_push_u16(pe, 0x5A4D); // e_magic = "MZ"
    pe = pe_push_u16(pe, 0x90); // e_cblp
    pe = pe_push_u16(pe, 0x03); // e_cp
    pe = pe_push_u16(pe, 0); // e_crlc
    pe = pe_push_u16(pe, 0x04); // e_cparhdr
    pe = pe_push_u16(pe, 0); // e_minalloc
    pe = pe_push_u16(pe, 0xFFFF); // e_maxalloc
    pe = pe_push_u16(pe, 0); // e_ss
    pe = pe_push_u16(pe, 0xB8); // e_sp
    pe = pe_push_u16(pe, 0); // e_csum
    pe = pe_push_u16(pe, 0); // e_ip
    pe = pe_push_u16(pe, 0); // e_cs
    pe = pe_push_u16(pe, 0x40); // e_lfarlc
    pe = pe_push_u16(pe, 0); // e_ovno
    var z: i64 = 0;
    while z < 8 { pe.push(0); z = z + 1; } // e_res
    pe = pe_push_u16(pe, 0); // e_oemid
    pe = pe_push_u16(pe, 0); // e_oeminfo
    z = 0;
    while z < 20 { pe.push(0); z = z + 1; } // e_res2
    pe = pe_push_u32(pe, 64); // e_lfanew = 64

    // ─── PE Signature (4 bytes) ───
    pe = pe_push_str(pe, "PE");
    pe.push(0);
    pe.push(0);

    // ─── COFF Header (20 bytes) ───
    pe = pe_push_u16(pe, 0x8664); // Machine = AMD64
    pe = pe_push_u16(pe, 2); // NumberOfSections = 2 (.text, .rdata)
    pe = pe_push_u32(pe, 0); // TimeDateStamp
    pe = pe_push_u32(pe, 0); // PointerToSymbolTable
    pe = pe_push_u32(pe, 0); // NumberOfSymbols
    pe = pe_push_u16(pe, 240); // SizeOfOptionalHeader (PE32+)
    pe = pe_push_u16(pe, 0x0022); // Characteristics: EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE

    // ─── Optional Header PE32+ (240 bytes) ───
    // Standard fields (24 bytes)
    pe = pe_push_u16(pe, 0x020B); // Magic = PE32+
    pe.push(14); // MajorLinkerVersion
    pe.push(0); // MinorLinkerVersion
    pe = pe_push_u32(pe, text_raw_size); // SizeOfCode
    pe = pe_push_u32(pe, rdata_raw_size); // SizeOfInitializedData
    pe = pe_push_u32(pe, 0); // SizeOfUninitializedData
    pe = pe_push_u32(pe, entry_point_rva); // AddressOfEntryPoint
    pe = pe_push_u32(pe, PE_TEXT_RVA); // BaseOfCode

    // Windows-specific fields (88 bytes)
    pe = pe_push_u64(pe, PE_IMAGE_BASE); // ImageBase
    pe = pe_push_u32(pe, PE_SECTION_ALIGN); // SectionAlignment
    pe = pe_push_u32(pe, PE_FILE_ALIGN); // FileAlignment
    pe = pe_push_u16(pe, 6); // MajorOperatingSystemVersion
    pe = pe_push_u16(pe, 0); // MinorOperatingSystemVersion
    pe = pe_push_u16(pe, 0); // MajorImageVersion
    pe = pe_push_u16(pe, 0); // MinorImageVersion
    pe = pe_push_u16(pe, 6); // MajorSubsystemVersion
    pe = pe_push_u16(pe, 0); // MinorSubsystemVersion
    pe = pe_push_u32(pe, 0); // Win32VersionValue
    pe = pe_push_u32(pe, size_of_image); // SizeOfImage
    pe = pe_push_u32(pe, header_size); // SizeOfHeaders
    pe = pe_push_u32(pe, 0); // CheckSum
    pe = pe_push_u16(pe, 3); // Subsystem = CONSOLE
    pe = pe_push_u16(pe, 0x0000); // DllCharacteristics: none (testing)
    pe = pe_push_u64(pe, 0x100000000); // SizeOfStackReserve = 4GB (native frames are large: one slot per IR value, no reuse — deep recursion in checker/parser needs it)
    pe = pe_push_u64(pe, 0x100000); // SizeOfStackCommit = 1MB
    pe = pe_push_u64(pe, 0x100000); // SizeOfHeapReserve
    pe = pe_push_u64(pe, 0x1000); // SizeOfHeapCommit
    pe = pe_push_u32(pe, 0); // LoaderFlags
    pe = pe_push_u32(pe, 16); // NumberOfRvaAndSizes

    // Data directories (16 x 8 = 128 bytes)
    // Entry 0: Export Table
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }
    // Entry 1: Import Table
    pe = pe_push_u32(pe, import_dir_rva);
    pe = pe_push_u32(pe, 20); // size = 1 descriptor + null = 20 bytes
    // Entry 2: Resource Table
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }
    // Entry 3: Exception Table
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }
    // Entry 4: Certificate Table
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }
    // Entry 5: Base Relocation Table
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }
    // Entry 6: Debug
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }
    // Entry 7: Architecture
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }
    // Entry 8: Global Ptr
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }
    // Entry 9: TLS Table
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }
    // Entry 10: Load Config Table
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }
    // Entry 11: Bound Import
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }
    // Entry 12: IAT
    pe = pe_push_u32(pe, iat_rva);
    pe = pe_push_u32(pe, iat_size);
    // Entry 13: Delay Import Descriptor
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }
    // Entry 14: CLR Runtime Header
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }
    // Entry 15: Reserved
    z = 0;
    while z < 8 { pe.push(0); z = z + 1; }

    // ─── Section Headers ───
    // .text section (40 bytes)
    pe = pe_push_str(pe, ".text");
    pe.push(0); pe.push(0); pe.push(0); // Name (8 bytes)
    pe = pe_push_u32(pe, text_virt_size); // VirtualSize
    pe = pe_push_u32(pe, PE_TEXT_RVA); // VirtualAddress
    pe = pe_push_u32(pe, text_raw_size); // SizeOfRawData
    pe = pe_push_u32(pe, PE_FILE_ALIGN); // PointerToRawData
    pe = pe_push_u32(pe, 0); // PointerToRelocations
    pe = pe_push_u32(pe, 0); // PointerToLinenumbers
    pe = pe_push_u16(pe, 0); // NumberOfRelocations
    pe = pe_push_u16(pe, 0); // NumberOfLinenumbers
    pe = pe_push_u32(pe, 0x60000020); // Characteristics: CODE|EXECUTE|READ

    // .rdata section (40 bytes)
    pe = pe_push_str(pe, ".rdata");
    pe.push(0); pe.push(0); // Name (8 bytes)
    pe = pe_push_u32(pe, rdata_virt_size); // VirtualSize
    pe = pe_push_u32(pe, rdata_rva); // VirtualAddress
    pe = pe_push_u32(pe, rdata_raw_size); // SizeOfRawData
    pe = pe_push_u32(pe, PE_FILE_ALIGN + text_raw_size); // PointerToRawData
    pe = pe_push_u32(pe, 0); // PointerToRelocations
    pe = pe_push_u32(pe, 0); // PointerToLinenumbers
    pe = pe_push_u16(pe, 0); // NumberOfRelocations
    pe = pe_push_u16(pe, 0); // NumberOfLinenumbers
    pe = pe_push_u32(pe, 0xC0000040); // Characteristics: INITIALIZED_DATA|READ|WRITE (IAT needs write)

    // Pad headers to FILE_ALIGN
    while pe.len() < header_size {
        pe.push(0);
    }

    // ─── .text section data ───
    var ti: i64 = 0;
    while ti < text.len() {
        pe.push(text.get(ti));
        ti = ti + 1;
    }
    while pe.len() < header_size + text_raw_size {
        pe.push(0);
    }

    // ─── .rdata section data ───
    var ri: i64 = 0;
    while ri < rdata.len() {
        pe.push(rdata.get(ri));
        ri = ri + 1;
    }
    while pe.len() < header_size + text_raw_size + rdata_raw_size {
        pe.push(0);
    }

    return pe;
}
