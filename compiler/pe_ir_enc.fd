/// movsd xmm, [rbp + disp]
pub fn PeirEnc_movsd_xmm_mem_rbp(self: &mut PeirEnc, xmm: i64, disp: i64) -> void {
    self.code.push(0xF2);
    PeirEnc_rex_w(self);
    self.code.push(0x0F);
    self.code.push(0x10);
    PeirEnc_emit_mem_rbp(self, xmm, disp);
}

/// movsd [rbp + disp], xmm
pub fn PeirEnc_movsd_mem_rbp_xmm(self: &mut PeirEnc, disp: i64, xmm: i64) -> void {
    self.code.push(0xF2);
    PeirEnc_rex_w(self);
    self.code.push(0x0F);
    self.code.push(0x11);
    PeirEnc_emit_mem_rbp(self, xmm, disp);
}

