    Lowerer_add_extern_2(self, "p_allocator_alloc", alloc_ty, IrType::I64, IrType::I64);
    Lowerer_add_extern_2(self, "p_allocator_free", alloc_ty, IrType::I64, IrType::Void);
    Lowerer_add_extern_1(self, "p_allocator_stats", alloc_ty, IrType::I64);

    // Interrupt handler
    Lowerer_add_extern_0(self, "p_cli", IrType::Void);
    Lowerer_add_extern_0(self, "p_sti", IrType::Void);
    Lowerer_add_extern_1(self, "p_lidt", lw_ptr_u8(), IrType::Void);
    // F29: p_idt_set_entry(idt_ptr, vector, handler, flags) — 4 params
    Lowerer_add_extern_4(self, "p_idt_set_entry", IrType::I64, IrType::I64, IrType::I64, IrType::I64, IrType::Void);
    Lowerer_add_extern_0(self, "p_hlt", IrType::Void);
    Lowerer_add_extern_1(self, "p_inb", IrType::I64, IrType::I64);
    Lowerer_add_extern_2(self, "p_outb", IrType::I64, IrType::I64, IrType::Void);
    Lowerer_add_extern_1(self, "p_inw", IrType::I64, IrType::I64);
    Lowerer_add_extern_2(self, "p_outw", IrType::I64, IrType::I64, IrType::Void);
    Lowerer_add_extern_1(self, "p_inl", IrType::I64, IrType::I64);
    Lowerer_add_extern_2(self, "p_outl", IrType::I64, IrType::I64, IrType::Void);

    // GDT
    Lowerer_add_extern_1(self, "p_lgdt", IrType::I64, IrType::Void);
    Lowerer_add_extern_5(self, "p_gdt_set_entry", IrType::I64, IrType::I64, IrType::I64, IrType::I64, IrType::I64, IrType::Void);

    // Serial port (bare-metal)
    Lowerer_add_extern_0(self, "p_serial_init", IrType::Void);
    Lowerer_add_extern_1(self, "p_serial_write", IrType::I64, IrType::Void);
    Lowerer_add_extern_0(self, "p_serial_read", IrType::I64);
    Lowerer_add_extern_0(self, "p_serial_ready", IrType::I64);

    // User mode transition
    Lowerer_add_extern_2(self, "p_enter_user_mode", IrType::I64, IrType::I64, IrType::Void);

    // Memory
    Lowerer_add_extern_3(self, "p_memset", IrType::I64, IrType::I32, IrType::I64, IrType::Void);

    // MMU/page table
    Lowerer_add_extern_0(self, "p_cr3_read", IrType::I64);
    Lowerer_add_extern_1(self, "p_cr3_write", IrType::I64, IrType::Void);
    Lowerer_add_extern_0(self, "p_cr0_read", IrType::I64);
    Lowerer_add_extern_1(self, "p_cr0_write", IrType::I64, IrType::Void);
    Lowerer_add_extern_0(self, "p_cr4_read", IrType::I64);
    Lowerer_add_extern_1(self, "p_cr4_write", IrType::I64, IrType::Void);
    Lowerer_add_extern_1(self, "p_invlpg", IrType::I64, IrType::Void);
    Lowerer_add_extern_4(self, "p_page_map", IrType::I64, IrType::I64, IrType::I64, IrType::I64, IrType::Void);
    Lowerer_add_extern_2(self, "p_page_unmap", IrType::I64, IrType::I64, IrType::Void);
    Lowerer_add_extern_1(self, "p_phys_read64", IrType::I64, IrType::I64);
    Lowerer_add_extern_2(self, "p_phys_write64", IrType::I64, IrType::I64, IrType::Void);

    // Volatile memory access (MMIO)
    Lowerer_add_extern_1(self, "p_volatile_load", IrType::I64, IrType::I64);
    Lowerer_add_extern_2(self, "p_volatile_store", IrType::I64, IrType::I64, IrType::Void);
