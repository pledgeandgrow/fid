            // is not told apart here: Lowerer_infer_expr_ast_type says i64
            // for what it does not know; the type checker rejects it.)
            var is_ty: Type = lw_rc_strip_ref(Lowerer_resolve_type(self, Lowerer_rc_expr_type(self, lw_box_expr_unbox(e))));
            var is_none: bool = false;
            match lw_box_expr_unbox(e) {
                Expr::IntLit(_) => {
                    is_none = true;
                }
                Expr::FloatLit(_) => {
                    is_none = true;
                }
                Expr::BoolLit(_) => {
                    is_none = true;
                }
                Expr::StringLit(_) => {
                    is_none = true;
                }
                _ => {
                }
            }
            var is_en: str = lw_rc_type_name(is_ty);
