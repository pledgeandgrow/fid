    Lowerer_add_extern_1(self, "p_tensor_clone", tensor_ty, tensor_ty);

    // Autograd
    Lowerer_add_extern_1(self, "p_grad_get", tensor_ty, tensor_ty);
    Lowerer_add_extern_0(self, "p_grad_zero", IrType::Void);
    Lowerer_add_extern_0(self, "p_autograd_begin", IrType::Void);
    Lowerer_add_extern_0(self, "p_autograd_end", IrType::Void);
    Lowerer_add_extern_1(self, "p_autograd_backward", tensor_ty, IrType::Void);
    Lowerer_add_extern_0(self, "p_checkpoint_begin", IrType::Void);
    Lowerer_add_extern_0(self, "p_checkpoint_end", IrType::Void);

    // KV Cache
    Lowerer_add_extern_4(self, "p_kv_cache_new", IrType::I64, IrType::I64, IrType::I64, IrType::I64, IrType::I64);
    Lowerer_add_extern_4(self, "p_kv_cache_append", IrType::I64, IrType::I64, tensor_ty, tensor_ty, IrType::Void);
