// --- Lower program --------------------------------------------------------

/// `fn f() -> _` (reference §2.1): each top-level function the type checker
/// inferred a return type for (ast.fd infer_ret_of) gets it in place of
/// Type::Infer, so its signature, its `return`s and its callers lower with
/// the real type (a struct result was a word: s2_1_infer_return_struct
/// printed 0). The program as it is when no function writes `-> _`.
fn lw_apply_infer_rets(p: Program) -> Program {
    var any: bool = false;
    var i: i64 = 0;
    while i < p.funcs.len() && !any {
        match p.funcs.get(i).ret_ty {
            Type::Infer => {
                any = true;
            }
            _ => {
            }
        }
        i = i + 1;
    }
    if !any {
        return p;
    }
    var fs: Vec<Func> = Vec::new();
    i = 0;
    while i < p.funcs.len() {
        var f: Func = p.funcs.get(i);
        match f.ret_ty {
            Type::Infer => {
                match infer_ret_of(f.name) {
                    OptType::Some(irt) => {
                        f.ret_ty = irt;
                    }
                    OptType::None => {
                    }
                }
            }
            _ => {
            }
        }
        fs.push(f);
        i = i + 1;
    }
    var out: Program = p;
    out.funcs = fs;
    return out;
}

// --- BG424: a default parameter value is evaluated in the callee's scope ---

/// BG424: a default value that names something (a global, a constant, an
/// earlier parameter) is computed by a function of its own,
/// `__dflt_<fn>_<i>(<the earlier parameters it names>)`, whose only locals
/// are those parameters, so its names resolve where the callee is declared.
/// Pasted into the call as written (Lowerer_resolve_call_args), it was
/// looked up in the caller's scope: a caller's local `LIMIT` hid the global
/// `LIMIT`, and `b: i64 = a * 2` read the caller's `a`. The parameter's
/// default becomes the call `__dflt_..(a, ..)`, whose arguments name the
/// parameters; the call filling it in puts its own arguments for those in
/// their place (lw_dflt_bind). A default naming nothing (a literal) is
/// pasted as before. Generic and comptime functions are left as they are
/// (a generic function's instances are concrete functions here). Impl
/// methods get helpers too (`Self` is the impl's type).
fn Lowerer_dflt_helpers(self: & Lowerer, p: Program) -> Program {
    var helpers: Vec<Func> = Vec::new();
    var fs: Vec<Func> = Vec::new();
    var i: i64 = 0;
    while i < p.funcs.len() {
        var f: Func = p.funcs.get(i);
        fs.push(Lowerer_dflt_func(self, f, f.name, "", & mut helpers));
        i = i + 1;
    }
    var ims: Vec<ImplDef> = Vec::new();
    i = 0;
    while i < p.impls.len() {
        var imp: ImplDef = p.impls.get(i);
        if imp.type_params.len() == 0 {
            var ms: Vec<Func> = Vec::new();
            var j: i64 = 0;
            while j < imp.methods.len() {
                var m: Func = imp.methods.get(j);
                ms.push(Lowerer_dflt_func(self, m, imp.struct_name + "_" + m.name, imp.struct_name, & mut helpers));
                j = j + 1;
            }
            imp.methods = ms;
        }
        ims.push(imp);
        i = i + 1;
    }
    if helpers.len() == 0 {
        return p;
    }
    i = 0;
    while i < helpers.len() {
        fs.push(helpers.get(i));
        i = i + 1;
    }
    var out: Program = p;
    out.funcs = fs;
    out.impls = ims;
    return out;
}

/// BG424: `f` with each default that names something replaced by a call
/// of its helper (pushed to `helpers`); `key` names the helpers, `self_ty`
/// is the impl's type for a method ("" for a function).
fn Lowerer_dflt_func(self: & Lowerer, f: Func, key: str, self_ty: str, helpers: & mut Vec<Func>) -> Func {
    if f.type_params.len() > 0 || f.const_params.len() > 0 || f.is_comptime || f.is_async {
        return f;
    }
    var changed: bool = false;
    var ps: Vec<Param> = Vec::new();
    var pi: i64 = 0;
    while pi < f.params.len() {
        var p: Param = f.params.get(pi);
        var typed: bool = true;
        match p.ty {
            Type::Infer => {
                typed = false;
            }
            _ => {
            }
        }
        if p.has_default && !p.is_variadic && typed {
            var fv: Vec<str> = Vec::new();
            var ln: Vec<str> = Vec::new();
            Lowerer_collect_free_vars_expr(self, p.default_expr, & mut fv, & mut ln);
            if fv.len() > 0 {
                var hname: str = "__dflt_" + key + "_" + int_to_str(pi);
                var hps: Vec<Param> = Vec::new();
                var hargs: Vec<Expr> = Vec::new();
                var ej: i64 = 0;
                while ej < pi {
                    var ep: Param = f.params.get(ej);
                    if lw_c_str_vec_contains(fv, ep.name) {
                        hps.push(Param_new(ep.name, lw_dflt_self_type(ep.ty, self_ty), false));
                        hargs.push(Expr::Ident(ep.name));
                    }
                    ej = ej + 1;
                }
                var hbody: Vec<Stmt> = Vec::new();
                hbody.push(Stmt::Return(OptBoxExpr::Some(Box::new(p.default_expr)), f.line));
                helpers.push(Func_new_full(hname, hps, lw_dflt_self_type(p.ty, self_ty), hbody, false));
                p.default_expr = Expr::Call(hname, hargs);
                changed = true;
            }
        }
        ps.push(p);
        pi = pi + 1;
    }
    if changed {
        var g: Func = f;
        g.params = ps;
        return g;
    }
    return f;
}

/// `Self` (also behind a reference) as the impl's type `self_ty`.
fn lw_dflt_self_type(t: Type, self_ty: str) -> Type {
    if str_len(self_ty) == 0 {
        return t;
    }
    match t {
        Type::Named(n) => {
            if n == "Self" {
                return Type::Named(self_ty);
            }
        }
        Type::Ref(inner, m) => {
            return Type::Ref(Box::new(lw_dflt_self_type(lw_box_type_unbox(inner), self_ty)), m);
        }
        _ => {
        }
    }
    return t;
}

/// BG424: default `d` for a call whose parameters are `names`, the
/// arguments so far `got` (one per parameter before it): a helper call
/// `__dflt_..(a, ..)` gets the call's own argument for each parameter it
/// names (`recv` for `self`, a method's receiver; Expr::IntLit(0) when
/// there is none). Anything else is `d` as it is.
fn lw_dflt_bind(d: Expr, names: Vec<str>, got: Vec<Expr>, recv: OptBoxExpr) -> Expr {
    match d {
        Expr::Call(hn, hargs) => {
            if !str_starts_with(hn, "__dflt_") {
                return d;
            }
            var bound: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < hargs.len() {
                var a: Expr = hargs.get(i);
                match hargs.get(i) {
                    Expr::Ident(pn) => {
                        var found: bool = false;
                        var k: i64 = 0;
                        while k < names.len() && k < got.len() && !found {
                            if names.get(k) == pn {
                                a = got.get(k);
                                found = true;
                            }
                            k = k + 1;
                        }
                        if !found && pn == "self" {
                            match recv {
                                OptBoxExpr::Some(rb) => {
                                    a = lw_box_expr_unbox(rb);
                                    found = true;
                                }
                                OptBoxExpr::None => {
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                bound.push(a);
                i = i + 1;
            }
            return Expr::Call(hn, bound);
        }
        _ => {
        }
    }
    return d;
}

pub fn Lowerer_lower_program(self: & mut Lowerer, program_in: Program) -> IrModule {
    // 0008: the parser's sequential vars (Vec<E..>) route to VecV_*
    g_lw_sequential_vars = Vec::new();
    var sv_i: i64 = 0;
    val sv_src: Vec<str> = parser_sequential_vars();
    while sv_i < sv_src.len() {
        g_lw_sequential_vars.push(sv_src.get(sv_i));
        sv_i = sv_i + 1;
    }
    var program: Program = lw_apply_infer_rets(program_in);
    // BG424: defaults that name something are computed in the callee's scope
    program = Lowerer_dflt_helpers(self, program);
    // Register constants
    var i: i64 = 0;
    while i < program.consts.len() {
        var c: ConstDef = program.consts.get(i);
        // BG276: a typed numeric const is its value as the declared type
        // (`const CU: u8 = 200`: `CU + CU` is a u8 add that panics; a u64
        // const prints and compares unsigned), not the bare i64 literal
        if lw_const_cast_type(c.ty) {
            Lowerer_insert_constant(self, c.name, Expr::Cast(Box::new(c.expr), c.ty));
        } else {
            Lowerer_insert_constant(self, c.name, c.expr);
        }
        i = i + 1;
    }

    // Register module-level mutable globals
    i = 0;
    while i < program.globals.len() {
        var g: GlobalVar = program.globals.get(i);
        var ir_ty: IrType = Lowerer_lower_type(self, g.ty);
        // 2g.119: fold what a compile-time constant the initializer is
        // (`0 - 1` -> -1) so it is written into the program's data, never
        // assigned at the top of main after the boot hooks.
        val init: Expr = lw_fold_const_init(g.init);
        self.module.globals.push(GlobalEntry_new(g.name, ir_ty, init));
        if !lw_is_const_init(init) {
            self.global_inits.push(g);
        }
        i = i + 1;
    }

    // Register type aliases
    i = 0;
    while i < program.type_aliases.len() {
        var ta: TypeAlias = program.type_aliases.get(i);
        Lowerer_insert_type_alias(self, ta.name, ta.alias_for);
        i = i + 1;
    }

    // Register struct definitions
    i = 0;
    while i < program.structs.len() {
        var s: StructDef = program.structs.get(i);
        Lowerer_insert_struct(self, s.name, s);
        // Track @linear structs
        var j: i64 = 0;
        while j < s.annotations.len() {
            if s.annotations.get(j).name == "linear" {
                Lowerer_insert_linear_struct(self, s.name);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Register enum definitions
    i = 0;
    while i < program.enums.len() {
        var e: EnumDef = program.enums.get(i);
        Lowerer_insert_enum(self, e.name, e);
        i = i + 1;
    }

    // Register user-defined extern functions
    i = 0;
    while i < program.extern_decls.len() {
        var ext: ExternDecl = program.extern_decls.get(i);
        var param_types: Vec<IrType> = Vec::new();
        var j: i64 = 0;
        while j < ext.params.len() {
            // TG15: a C `...rest: T` adds no parameter: each argument after
            // the fixed ones is passed as it is, unpacked (C's `...`; the
            // declaration keeps is_variadic for codegen_c and nat_ir)
            if !(j == ext.params.len() - 1 && ext.params.get(j).is_variadic) {
                param_types.push(Lowerer_lower_type(self, ext.params.get(j).ty));
            }
            j = j + 1;
        }
        var ret_type: IrType = Lowerer_lower_type(self, ext.ret_ty);
        IrModule_add_extern(& mut self.module, ext.pledge_name, param_types, ret_type);
        match ext.ret_ty {
            Type::Str => {
                self.own_str_externs.push(ext.pledge_name);
            }
            _ => {
            }
        }
        var fp: i64 = 0;
        while fp < ext.params.len() {
            match ext.params.get(fp).ty {
                Type::Func(_, _) => {
                    self.fn_externs.push(ext.pledge_name);
                }
                _ => {
                }
            }
            fp = fp + 1;
        }
        self.module.extern_decls.push(ext);
        i = i + 1;
    }

    // BG144: which trait impls name their methods `Type__Trait_method`
    Lowerer_tq_setup(self, program);

    // Register impl methods
    // (the bare names of methods given a return type here: a function of
    // the program by the same name takes the name's lookup over below,
    // stdlib-agent-bugs 32)
    var lw_method_names: i64 = HashMap_new();
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var j: i64 = 0;
        while j < imp.methods.len() {
            var method: Func = imp.methods.get(j);
            Lowerer_insert_impl_method(self, imp.struct_name, method.name, method);
            Lowerer_insert_func_ret_type(self, method.name, method.ret_ty);
            HashMap_insert(lw_method_names, method.name, 1);
            // Pre-register mangled name in IR module so calls can look up return type
            var mangled_name: str = imp.struct_name + "_" + method.name;
            // BG392: the call is emitted under the mangled name, so its
            // result's owner (Lowerer_rc_note_call / Lowerer_rc_ret_type)
            // is found under that name too
            Lowerer_reg_method_ret(self, imp.struct_name, mangled_name, method.ret_ty, lw_method_names);
            var mangled_ret_ty: IrType = Lowerer_lower_type(self, method.ret_ty);
            var ir_func: IrFunction = IrFunction_new(mangled_name, mangled_ret_ty);
            IrModule_add_function(& mut self.module, ir_func);
            j = j + 1;
        }
        i = i + 1;
    }

    // Register trait impl methods
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        // BG144: `Type__Trait` when a method's plain name is another's
        var ti_pre: str = lw_tq_prefix(ti.type_name, ti.trait_name);
        var j: i64 = 0;
        while j < ti.methods.len() {
            var method: Func = ti.methods.get(j);
            Lowerer_insert_impl_method(self, ti.type_name, method.name, method);
            if ti_pre != ti.type_name {
                Lowerer_insert_impl_method(self, ti_pre, method.name, method);
            }
            Lowerer_insert_func_ret_type(self, method.name, method.ret_ty);
            HashMap_insert(lw_method_names, method.name, 1);
            // Pre-register mangled name in IR module so calls can look up return type
            var ti_mangled_name: str = ti_pre + "_" + method.name;
            // BG392: as for an impl method above
            Lowerer_reg_method_ret(self, ti.type_name, ti_mangled_name, method.ret_ty, lw_method_names);
            if ti_pre != ti.type_name && lw_tq_aliased(ti.type_name, ti.trait_name, method.name) {
                Lowerer_reg_method_ret(self, ti.type_name, ti.type_name + "_" + method.name, method.ret_ty, lw_method_names);
            }
            var ti_mangled_ret_ty: IrType = Lowerer_lower_type(self, method.ret_ty);
            var ti_ir_func: IrFunction = IrFunction_new(ti_mangled_name, ti_mangled_ret_ty);
            IrModule_add_function(& mut self.module, ti_ir_func);
            if ti_pre != ti.type_name && lw_tq_aliased(ti.type_name, ti.trait_name, method.name) {
                var ti_alias_func: IrFunction = IrFunction_new(ti.type_name + "_" + method.name, ti_mangled_ret_ty);
                IrModule_add_function(& mut self.module, ti_alias_func);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Register trait method names
    i = 0;
    while i < program.traits.len() {
        var td: TraitDef = program.traits.get(i);
        var methods: Vec<str> = Vec::new();
        var j: i64 = 0;
        while j < td.methods.len() {
            methods.push(td.methods.get(j).name);
            // Return type of each trait method, for DynCall on `dyn Trait`
            // receivers (src/lower.rs trait_method_rets).
            Lowerer_insert_func_ret_type(self, "dyn:" + td.name + "::" + td.methods.get(j).name, td.methods.get(j).ret_ty);
            j = j + 1;
        }
        self.module.trait_methods.push(StringVecStr_new(td.name, methods));
        i = i + 1;
    }

    // Register trait implementations
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        // BG144: a qualified impl's dyn values carry `Type__Trait`
        var ti_dyn: str = lw_tq_prefix(ti.type_name, ti.trait_name);
        // Find or create entry for trait_name
        var found: bool = false;
        var j: i64 = 0;
        while j < self.module.trait_impls.len() {
            if self.module.trait_impls.get(j).name == ti.trait_name {
                self.module.trait_impls.get(j).items.push(ti_dyn);
                found = true;
            }
            j = j + 1;
        }
        if !found {
            var types: Vec<str> = Vec::new();
            types.push(ti_dyn);
            self.module.trait_impls.push(StringVecStr_new(ti.trait_name, types));
        }
        i = i + 1;
    }

    // Compute enum and struct layouts iteratively to a fixpoint.
    // Enums may contain structs, and structs may contain enums.
    // We interleave both passes until no size changes.
    var changed: bool = true;
    var iterations: i64 = 0;
    while changed && iterations < 20 {
        changed = false;
        i = 0;
        while i < program.enums.len() {
            var e: EnumDef = program.enums.get(i);
            var old_size: i64 = 0;
            match IrModule_get_struct(& self.module, e.name) {
                OptStructLayout::Some(old_layout) => {
                    old_size = old_layout.size;
                }
                OptStructLayout::None => {
                    old_size = 0;
                }
            }
            Lowerer_compute_enum_layout(self, e);
            var new_size: i64 = 0;
            match IrModule_get_struct(& self.module, e.name) {
                OptStructLayout::Some(new_layout) => {
                    new_size = new_layout.size;
                }
                OptStructLayout::None => {
                    new_size = 0;
                }
            }
            if new_size != old_size {
                changed = true;
            }
            i = i + 1;
        }
        i = 0;
        while i < program.structs.len() {
            var s: StructDef = program.structs.get(i);
            var old_size: i64 = 0;
            match IrModule_get_struct(& self.module, s.name) {
                OptStructLayout::Some(old_layout) => {
                    old_size = old_layout.size;
                }
                OptStructLayout::None => {
                    old_size = 0;
                }
            }
            Lowerer_compute_struct_layout(self, s);
            var new_size: i64 = 0;
            match IrModule_get_struct(& self.module, s.name) {
                OptStructLayout::Some(new_layout) => {
                    new_size = new_layout.size;
                }
                OptStructLayout::None => {
                    new_size = 0;
                }
            }
            if new_size != old_size {
                changed = true;
            }
            i = i + 1;
        }
        iterations = iterations + 1;
    }

    // Register runtime
    Lowerer_register_runtime(self);

    // Pre-register all function signatures
    i = 0;
    while i < program.funcs.len() {
        var func: Func = program.funcs.get(i);
        Lowerer_register_ret_tuple(self, func.ret_ty);
        var ret_ty: IrType = Lowerer_lower_type_sret(self, lw_body_ret_type(func));
        var ir_func: IrFunction = IrFunction_new(func.name, ret_ty);
        IrModule_add_function(& mut self.module, ir_func);
        Lowerer_insert_func_ret_type(self, func.name, func.ret_ty);
        // A call `take(b)` is this function's, not a method `take` of some
        // type registered above: its result type is this one's (bug 32: a
        // program's `fn take(b: Bag) -> Bag` had vec.fd's Vec.take result,
        // Vec<i64>, and the result was dropped as a Vec). The first function
        // of the name keeps it, as before.
        if HashMap_get(lw_method_names, func.name) == 1 {
            HashMap_insert(self.own_ret_index, func.name, self.func_ret_types.len());
            HashMap_insert(lw_method_names, func.name, 2);
        }
        if func.is_async {
            Lowerer_insert_async_func(self, func.name);
            if lw_is_async_task(func) {
                self.async_tasks.push(func.name);
            } else if Lowerer_task_adaptable(self, func) {
                self.async_tasks.push(func.name);
                self.async_adapted.push(func.name);
            }
        }
        // Store parameter names for named argument resolution
        var param_names: Vec<str> = Vec::new();
        var defaults: Vec<Expr> = Vec::new();
        var pi: i64 = 0;
        while pi < func.params.len() {
            param_names.push(func.params.get(pi).name);
            if func.params.get(pi).has_default {
                defaults.push(func.params.get(pi).default_expr);
            } else {
                defaults.push(Expr::IntLit(0));
            }
            pi = pi + 1;
        }
        if HashMap_get(self.func_info_at, func.name) == 0 {
            HashMap_insert(self.func_info_at, func.name, self.func_defaults.len() + 1);
        }
        self.func_param_names.push(StringVecStrEntry_new(func.name, param_names));
        self.func_defaults.push(StringVecExprEntry_new(func.name, defaults));
        var pasts: Vec<Type> = Vec::new();
        var pai: i64 = 0;
        while pai < func.params.len() {
            pasts.push(func.params.get(pai).ty);
            pai = pai + 1;
        }
        self.func_param_asts.push(pasts);
        // L8E: a function whose last parameter is `...xs: T` takes its
        // extra arguments packed into one Vec<T> (Lowerer_pack_variadic)
        if func.params.len() > 0 && func.params.get(func.params.len() - 1).is_variadic {
            HashMap_insert(self.func_info_at, lw_va_key(func.name), func.params.len());
            HashMap_insert(self.func_info_at, "...?", 1);
        }
        i = i + 1;
    }
    HashMap_drop(lw_method_names);

    // Lower each function
    i = 0;
    while i < program.funcs.len() {
        // (BG424: a default's helper is not in the keep set, which was made
        // before it existed)
        if lw_keep("fn:" + program.funcs.get(i).name) || str_starts_with(program.funcs.get(i).name, "__dflt_") {
            // the body function of an async method: `Self` is its type (LG14)
            var async_self: str = lw_async_body_self(program.funcs.get(i).name);
            if str_len(async_self) > 0 {
                var saved_async_self: OptStringLower = self.current_self_type;
                self.current_self_type = OptStringLower::Some(async_self);
                Lowerer_lower_func(self, program.funcs.get(i));
                self.current_self_type = saved_async_self;
            } else {
                Lowerer_lower_func(self, program.funcs.get(i));
            }
        }
        i = i + 1;
    }

    // Lower impl methods (mangled as {StructName}_{method})
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var saved_self: OptStringLower = self.current_self_type;
        self.current_self_type = OptStringLower::Some(imp.struct_name);
        var j: i64 = 0;
        while j < imp.methods.len() {
            var method: Func = imp.methods.get(j);
            if !lw_keep("impl:" + imp.struct_name + ":" + method.name) {
                j = j + 1;
                continue;
            }
            var mangled: Func = method;
            mangled.name = imp.struct_name + "_" + method.name;
            // Resolve Self in param types and return type
            var new_params: Vec<Param> = Vec::new();
            var k: i64 = 0;
            while k < mangled.params.len() {
                var p: Param = mangled.params.get(k);
                p.ty = Lowerer_resolve_self_in_type(self, p.ty);
                new_params.push(p);
                k = k + 1;
            }
            mangled.params = new_params;
            mangled.ret_ty = Lowerer_resolve_self_in_type(self, mangled.ret_ty);
            Lowerer_lower_func(self, mangled);
            j = j + 1;
        }
        self.current_self_type = saved_self;
        i = i + 1;
    }

    // Lower trait impl methods
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        var saved_self: OptStringLower = self.current_self_type;
        self.current_self_type = OptStringLower::Some(ti.type_name);
        // BG144: `Type__Trait_method` for a qualified impl
        var ti_lpre: str = lw_tq_prefix(ti.type_name, ti.trait_name);
        var j: i64 = 0;
        while j < ti.methods.len() {
            var method: Func = ti.methods.get(j);
            var mangled: Func = method;
            mangled.name = ti_lpre + "_" + method.name;
            var new_params: Vec<Param> = Vec::new();
            var k: i64 = 0;
            while k < mangled.params.len() {
                var p: Param = mangled.params.get(k);
                p.ty = Lowerer_resolve_self_in_type(self, p.ty);
                new_params.push(p);
                k = k + 1;
            }
            mangled.params = new_params;
            mangled.ret_ty = Lowerer_resolve_self_in_type(self, mangled.ret_ty);
            // a qualified impl's `self.m()` of its own trait's method (a
            // default method's too) is that impl's
            if ti_lpre != ti.type_name {
                var own_b: Vec<str> = Vec::new();
                own_b.push(ti.type_name);
                own_b.push(ti.trait_name);
                mangled.annotations.push(Annotation_new("__trait_bound", own_b));
            }
            Lowerer_lower_func(self, mangled);
            // its plain name, when nobody else has it
            if ti_lpre != ti.type_name && lw_tq_aliased(ti.type_name, ti.trait_name, method.name) {
                var plain_fn: Func = mangled;
                plain_fn.name = ti.type_name + "_" + method.name;
                Lowerer_lower_func(self, plain_fn);
            }
            j = j + 1;
        }
        self.current_self_type = saved_self;
        i = i + 1;
    }

    // Word adapters of the async tasks with f64 or struct parameters, and of
    // those that own an argument (BG228: the adapter drops it)
    i = 0;
    while i < program.funcs.len() {
        var ad_name: str = program.funcs.get(i).name;
        if lw_c_str_vec_contains(self.async_adapted, ad_name) || (lw_c_str_vec_contains(self.async_tasks, ad_name) && lw_keep("fn:" + ad_name) && Lowerer_task_owns_args(self, ad_name)) {
            Lowerer_emit_task_adapter(self, program.funcs.get(i));
        }
        i = i + 1;
    }

    // Ownership (proposal 0004): the drop/dup functions of the struct and
    // enum types the program's values use
    Lowerer_rc_gen_types(self);

    // Propagate linear_structs to IR module
    self.module.linear_structs = self.linear_structs;

    return self.module;
}

/// An async function whose parameters are words, f64 or structs and whose
/// result is a word: it can run as a task through a word adapter (release
/// H9; before, such a function ran to completion at the call).
fn Lowerer_task_adaptable(self: & Lowerer, func: Func) -> bool {
    var ret: Type = func.ret_ty;
    match func.ret_ty {
        Type::Generic(n, args) => {
            if n == "Future" {
                ret = Type::Void;
                if args.len() > 0 {
                    ret = args.get(0);
                }
            }
        }
        _ => {
        }
    }
    if !lw_task_word(ret) {
        match Lowerer_lower_type(self, ret) {
            IrType::F64 => {
            }
            IrType::Struct(_) => {
            }
            _ => {
                // LG14: a generic struct (`-> Future<Cell<T>>`) is a struct
                if str_len(Lowerer_task_gstruct(self, ret)) == 0 {
                    return false;
                }
            }
        }
    }
    if func.params.len() > 8 {
        return false;
    }
    var i: i64 = 0;
    while i < func.params.len() {
        var pty: Type = func.params.get(i).ty;
        if !lw_task_word(pty) {
            match Lowerer_lower_type(self, pty) {
                IrType::F64 => {
                }
                IrType::Struct(_) => {
                }
                _ => {
                    // LG14: `self: Cell<T>` of a generic impl's async
                    // method (each instance of it) is a struct too
                    if str_len(Lowerer_task_gstruct(self, pty)) == 0 {
                        return false;
                    }
                }
            }
        }
        i = i + 1;
    }
    return true;
}

/// LG14: the struct a generic struct type names (`Cell<str>`; every
/// instance shares the one layout `Cell`, its type parameters being words),
/// so a task's word adapter can carry it as a heap copy as it does a plain
/// struct; "" for any other type (Vec, HashMap, Box, Future, an enum).
fn Lowerer_task_gstruct(self: & Lowerer, ty: Type) -> str {
    match Lowerer_resolve_type(self, ty) {
        Type::Generic(gn, _) => {
            return Lowerer_task_gstruct_named(self, gn);
        }
        _ => {
        }
    }
    return "";
}

/// Lowerer_task_gstruct for the name of a generic type.
fn Lowerer_task_gstruct_named(self: & Lowerer, gn: str) -> str {
    var rn: str = Lowerer_resolve_struct_name(self, gn);
    if rn == "Vec" || rn == "HashMap" || rn == "Box" || rn == "Future" {
        return "";
    }
    match Lowerer_lookup_enum(self, rn) {
        OptEnumDef::Some(_) => {
            return "";
        }
        OptEnumDef::None => {
        }
    }
    match Lowerer_lookup_struct(self, rn) {
        OptStructDef::Some(_) => {
            return rn;
        }
        OptStructDef::None => {
        }
    }
    return "";
}

/// Lowerer_task_gstruct for a lowered value's type: a generic struct value
/// is its address (`Generic(Cell, ..)` or a pointer to one).
fn Lowerer_task_gstruct_ir(self: & Lowerer, ty: IrType) -> str {
    match ty {
        IrType::Generic(gn, _) => {
            return Lowerer_task_gstruct_named(self, gn);
        }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Generic(gn2, _) => {
                    return Lowerer_task_gstruct_named(self, gn2);
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return "";
}

/// A heap copy of struct value `av` (of layout `sn`) for a task: the caller
/// goes on (and may return) while the task runs (LG14, as the plain
/// struct case of Lowerer_lower_call_expr does).
fn Lowerer_task_heap_copy(self: & mut Lowerer, av: i64, sn: str) -> i64 {
    var size: i64 = 8;
    match IrModule_get_struct(& self.module, sn) {
        OptStructLayout::Some(layout) => {
            size = layout.size;
        }
        OptStructLayout::None => {
        }
    }
    var ma: Vec<i64> = Vec::new();
    ma.push(Lowerer_emit_inst(self, Inst::ConstInt(size, IrType::I64)));
    var aeff: EffectSet = EffectSet_new();
    EffectSet_add(& mut aeff, Effect::Alloc);
    var raw: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", ma, lw_ptr_u8(), aeff));
    var sty: IrType = IrType::Struct(sn);
    var heap: i64 = Lowerer_emit_inst(self, Inst::BitCast(raw, lw_ptr_u8(), IrType::Ptr(Box::new(sty))));
    var src: i64 = Lowerer_emit_inst(self, Inst::BitCast(av, Lowerer_get_value_type(self, av), IrType::Ptr(Box::new(IrType::Struct(sn)))));
    Lowerer_emit_inst(self, Inst::StructCopy(heap, src, IrType::Struct(sn)));
    return heap;
}

/// BG228: the declared type of parameter `i` of task `name` when the task
/// owns what it is given there (a str, Vec, map, or a struct holding one),
/// else Infer. The caller hands the task an owner of that type and the
/// task's word adapter drops it when the task function returns (parameters
/// are borrowed: the body never drops them).
fn Lowerer_task_owned_param(self: & mut Lowerer, name: str, i: i64) -> Type {
    var at: i64 = HashMap_get(self.func_info_at, name);
    if at <= 0 || at > self.func_param_asts.len() {
        return Type::Infer;
    }
    var ps: Vec<Type> = self.func_param_asts.get(at - 1);
    if i < 0 || i >= ps.len() {
        return Type::Infer;
    }
    var t: Type = ps.get(i);
    var k: i64 = Lowerer_rc_kind(self, t);
    if k == RC_STR || k == RC_VEC || k == RC_MAP || k == RC_MEM {
        return t;
    }
    return Type::Infer;
}

/// BG228: whether task `name` owns any of its arguments: it then starts
/// through its word adapter (`name__task`), which drops them.
fn Lowerer_task_owns_args(self: & mut Lowerer, name: str) -> bool {
    if !LOWER_RC {
        return false;
    }
    var at: i64 = HashMap_get(self.func_info_at, name);
    if at <= 0 || at > self.func_param_asts.len() {
        return false;
    }
    var n: i64 = self.func_param_asts.get(at - 1).len();
    var i: i64 = 0;
    while i < n {
        match Lowerer_task_owned_param(self, name, i) {
            Type::Infer => {
            }
            _ => {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

/// `<name>__task(env, w0, .., wn) -> i64`: turns each word back into the
/// parameter it carries (f64 bits, or a pointer to the struct's heap copy)
/// and calls the task function.
fn Lowerer_emit_task_adapter(self: & mut Lowerer, func: Func) {
    var aname: str = func.name + "__task";
    var ret_ty: IrType = Lowerer_lookup_func_ret_ty_ir(self, func.name);
    var adapter: IrFunction = IrFunction_new(aname, IrType::I64);
    var env_ty: IrType = IrType::Ptr(Box::new(IrType::U8));
    var env_val: i64 = IrFunction_new_value(& mut adapter, ValueMeta_new(env_ty));
    adapter.params.push(ValueIdType_new(env_val, env_ty));
    var words: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < func.params.len() {
        var w: i64 = IrFunction_new_value(& mut adapter, ValueMeta_new(IrType::I64));
        adapter.params.push(ValueIdType_new(w, IrType::I64));
        words.push(w);
        i = i + 1;
    }

    var prev_func: IrFunction = self.current_func;
    var prev_has: bool = self.has_current_func;
    var prev_block: i64 = self.current_block;
    self.current_func = adapter;
    self.current_func.name = aname;
    self.has_current_func = true;
    self.current_block = 0;
    self.current_func.current_block_idx = 0;

    var args: Vec<i64> = Vec::new();
    // A struct result goes to a heap block the future hands to `await`
    var sret_heap: i64 = - 1;
    match ret_ty {
        IrType::Struct(rsn) => {
            var rsize: i64 = 8;
            match IrModule_get_struct(& self.module, rsn) {
                OptStructLayout::Some(rl) => {
                    rsize = rl.size;
                }
                OptStructLayout::None => {
                }
            }
            var rma: Vec<i64> = Vec::new();
            rma.push(Lowerer_emit_inst(self, Inst::ConstInt(rsize, IrType::I64)));
            var reff: EffectSet = EffectSet_new();
            EffectSet_add(& mut reff, Effect::Alloc);
            var rraw: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", rma, lw_ptr_u8(), reff));
            sret_heap = Lowerer_emit_inst(self, Inst::BitCast(rraw, lw_ptr_u8(), IrType::Ptr(Box::new(ret_ty))));
            args.push(sret_heap);
        }
        // An array result is sret too: a heap block of elem*count bytes
        IrType::Array(_, _) => {
            var rma: Vec<i64> = Vec::new();
            rma.push(Lowerer_emit_inst(self, Inst::ConstInt(ir_type_size(ret_ty), IrType::I64)));
            var reff: EffectSet = EffectSet_new();
            EffectSet_add(& mut reff, Effect::Alloc);
            var rraw: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", rma, lw_ptr_u8(), reff));
            sret_heap = Lowerer_emit_inst(self, Inst::BitCast(rraw, lw_ptr_u8(), IrType::Ptr(Box::new(ret_ty))));
            args.push(sret_heap);
        }
        _ => {
        }
    }
    args.push(env_val);
    var copies: Vec<i64> = Vec::new();
    // BG228: the owners the caller handed over, dropped after the call
    var owned_vals: Vec<i64> = Vec::new();
    var owned_tys: Vec<Type> = Vec::new();
    i = 0;
    while i < func.params.len() {
        var w: i64 = words.get(i);
        var arg: i64 = w;
        var ncopies: i64 = copies.len();
        if !lw_task_word(func.params.get(i).ty) {
            var lty: IrType = Lowerer_lower_type(self, func.params.get(i).ty);
            match lty {
                IrType::F64 => {
                    var fa: Vec<i64> = Vec::new();
                    fa.push(w);
                    arg = Lowerer_emit_inst(self, Inst::Call("p_f64_from_bits", fa, IrType::F64, EffectSet_new()));
                }
                IrType::Struct(_) => {
                    arg = Lowerer_emit_inst(self, Inst::BitCast(w, IrType::I64, IrType::Ptr(Box::new(lty))));
                    copies.push(w);
                }
                _ => {
                    // LG14: a generic struct's heap copy, as a struct's
                    var agsn: str = Lowerer_task_gstruct(self, func.params.get(i).ty);
                    if str_len(agsn) > 0 {
                        arg = Lowerer_emit_inst(self, Inst::BitCast(w, IrType::I64, IrType::Ptr(Box::new(IrType::Struct(agsn)))));
                        copies.push(w);
                    }
                }
            }
        }
        // BG228: what the caller gave the task an owner of (a struct: its
        // heap copy, whose fields the caller counted once more)
        var opt: Type = Lowerer_task_owned_param(self, func.name, i);
        var ok: i64 = Lowerer_rc_kind(self, opt);
        if ok == RC_STR || ok == RC_VEC || ok == RC_MAP {
            owned_vals.push(w);
            owned_tys.push(opt);
        } else if ok == RC_MEM && copies.len() > ncopies {
            owned_vals.push(arg);
            owned_tys.push(opt);
        }
        args.push(arg);
        i = i + 1;
    }
    var eff: EffectSet = EffectSet_new();
    EffectSet_add(& mut eff, Effect::IO);
    var call_ty: IrType = ret_ty;
    if sret_heap >= 0 {
        call_ty = IrType::Void;
    }
    var r: i64 = Lowerer_emit_inst(self, Inst::Call(func.name, args, call_ty, eff));
    // BG228: the task function has returned (its parameters were borrowed):
    // the owners its caller handed it are dropped
    var oi: i64 = 0;
    while oi < owned_vals.len() {
        Lowerer_rc_drop(self, owned_vals.get(oi), owned_tys.get(oi));
        oi = oi + 1;
    }
    // The callee has returned: the struct copies made for it are done with
    var ci: i64 = 0;
    while ci < copies.len() {
        var fa: Vec<i64> = Vec::new();
        fa.push(Lowerer_emit_inst(self, Inst::BitCast(copies.get(ci), IrType::I64, lw_ptr_u8())));
        var feff: EffectSet = EffectSet_new();
        EffectSet_add(& mut feff, Effect::Alloc);
        Lowerer_emit_inst(self, Inst::Call("p_free", fa, IrType::Void, feff));
        ci = ci + 1;
    }
    var result: i64 = r;
    if sret_heap >= 0 {
        result = Lowerer_emit_inst(self, Inst::BitCast(sret_heap, IrType::Ptr(Box::new(ret_ty)), IrType::I64));
    } else {
        match ret_ty {
            IrType::Void => {
                result = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            }
            IrType::F64 => {
                var ba: Vec<i64> = Vec::new();
                ba.push(r);
                result = Lowerer_emit_inst(self, Inst::Call("p_f64_to_bits", ba, IrType::I64, EffectSet_new()));
            }
            _ => {
            }
        }
    }
    Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(result)));
    IrModule_add_function(& mut self.module, self.current_func);

    self.current_func = prev_func;
    self.has_current_func = prev_has;
    self.current_block = prev_block;
}

// --- Public entry point ---------------------------------------------------

/// The functions to lower (compile time, CS4): a HashMap of "fn:<name>" /
/// "impl:<type>:<method>" keys computed on the AST by compiler/reach.fd for
/// `fid emit`, or 0 to lower every function (the C path, `fid run`). Trait
/// impl methods are always lowered. The ownership helpers are generated
/// after the bodies from what was lowered.
pub var g_lower_keep: i64 = 0; fn lw_keep(key: str) -> bool {
    if g_lower_keep == 0 {
        return true;
    }
    return HashMap_contains(g_lower_keep, key);
}

/// ME28/MI27: form Switch terminators from the match compare chains right
/// after lowering (ir.fd IrFunction_form_switches). Off: the mid-end
/// (iropt_me's CFG walks) and pe_ir do not know Switch yet, so the C
/// generator and nat_ir form them themselves after the mid-end.
const LOWER_SWITCH: bool = false;
pub fn lower(program0: Program) -> IrModule {
    // async methods: a body function and a method returning its future (LG14)
    var program: Program = program0;
    if LOWER_ASYNC_METHODS {
        program = lw_split_async_methods(program0);
    }
    irc_begin(program, g_lower_keep != 0);
    var l: Lowerer = Lowerer_new();
    l.rg_on = lw_rg_env_on();
    var module: IrModule = Lowerer_lower_program(& mut l, program);
    irc_finish();
    Lowerer_free_maps(& mut l);
    // With ownership (proposal 0004) every value is dropped by its owner:
    // the passes that freed some finished locals would free them twice
    if !LOWER_RC {
        lw_auto_drop_vecs(& mut module);
        lw_auto_drop_strs(& mut module);
    } else {
        lw_rc_cancel_pairs(& mut module);
        if LOWER_STACK_VECS {
            lw_rc_stack_vecs(& mut module);
        }
    }
    // regions freed in one step (proposal 0005)
    if l.rg_on {
        lw_rg_finish(& mut module);
    }
    // closure envs that stay in their frame (LG6)
    if LOWER_STACK_ENVS {
        lw_stack_envs(& mut module);
    }
    // --profile-use: the run's hot functions first (OP30)
    pgo_apply(& mut module);
    if LOWER_SWITCH && ir_switch_on() {
        IrModule_form_switches(& mut module);
    }
    return module;
}

/// Builtins that keep nothing they are given beyond the call, or keep it
/// where the caller's regions decide (a value they return): anything else,
/// and C functions, may keep a value no region's end reaches.
fn lw_rg_safe_builtin(n: str) -> bool {
    if n == "p_region_word" || n == "print" || n == "println" || n == "eprint" || n == "eprintln" {
        return true;
    }
    if !str_starts_with(n, "p_") {
        return false;
    }
    return str_starts_with(n, "p_str") || str_starts_with(n, "p_to_str") || str_starts_with(n, "p_vec_") || str_starts_with(n, "p_char") || str_starts_with(n, "p_float") || str_starts_with(n, "p_bool") || str_starts_with(n, "p_int") || n == "p_malloc" || n == "p_malloc_uninit" || n == "p_alloc" || n == "p_free" || n == "p_panic" || str_starts_with(n, "p_print") || str_starts_with(n, "p_eprint") || str_starts_with(n, "p_flush") || str_starts_with(n, "p_mem") || str_starts_with(n, "p_zero") || str_starts_with(n, "p_copy") || str_starts_with(n, "p_bytes") || str_starts_with(n, "p_sensitive") || str_starts_with(n, "p_math") || n == "p_sqrt" || n == "p_pow" || n == "p_exp" || n == "p_ln" || n == "p_sin" || n == "p_cos" || n == "p_tan" || n == "p_atan" || n == "p_atan2" || n == "p_floor" || n == "p_ceil" || n == "p_round" || n == "p_abs" || n == "p_fabs" || str_starts_with(n, "p_clock") || str_starts_with(n, "p_parse") || n == "p_file_read" || n == "p_file_exists" || n == "p_read_line" || n == "p_read_stdin" || n == "p_getenv" || n == "p_argv" || n == "p_argc" || str_starts_with(n, "p_hash") || n == "p_os_random_u64" || n == "p_exit" || str_starts_with(n, "p_assert");
}

/// The p_region_word call `id` with constant op `op`, or not.
fn lw_rg_is_op(f: & IrFunction, id: i64, op: i64) -> bool {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Call(n, args, _, _) => {
                    if n == "p_region_word" && args.len() == 2 {
                        match IrFunction_get_inst(f, args.get(0)) {
                            OptInst::Some(ai) => {
                                match ai {
                                    Inst::ConstInt(c, _) => {
                                        return c == op;
                                    }
                                    _ => {
                                    }
                                }
                            }
                            OptInst::None => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return false;
}

/// Per function (by position in the module): whether it may keep a value
/// where no region's end reaches it — a global, persistent storage, a call
/// through a function value or a trait object, a C function or a builtin
/// lw_rg_safe_builtin does not know, or a function that does.
fn lw_rg_retains(module: & IrModule) -> Vec<bool> {
    var n: i64 = module.functions.len();
    var ret: Vec<bool> = Vec::new();
    var callees: Vec<Vec<i64>> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var f: IrFunction = module.functions.get(i).func;
        var direct: bool = false;
        var cs: Vec<i64> = Vec::new();
        var b: i64 = 0;
        while b < f.blocks.len() && !direct {
            var ins: Vec<i64> = f.blocks.get(b).instructions;
            var k: i64 = 0;
            while k < ins.len() && !direct {
                match IrFunction_get_inst(& f, ins.get(k)) {
                    OptInst::Some(inst) => {
                        match inst {
                            Inst::GlobalAddr(_, _) => {
                                direct = true;
                            }
                            Inst::CallPtr(_, _, _, _, _) => {
                                direct = true;
                            }
                            Inst::DynCall(_, _, _, _, _) => {
                                direct = true;
                            }
                            Inst::PersistSave(_, _) => {
                                direct = true;
                            }
                            Inst::Call(cn, _, _, _) => {
                                var pos: i64 = IrModule_fn_pos(module, cn);
                                if pos >= 0 {
                                    cs.push(pos);
                                } else if !lw_rg_safe_builtin(cn) {
                                    direct = true;
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    OptInst::None => {
                    }
                }
                k = k + 1;
            }
            b = b + 1;
        }
        ret.push(direct);
        callees.push(cs);
        i = i + 1;
    }
    var changed: bool = true;
    while changed {
        changed = false;
        i = 0;
        while i < n {
            if !ret.get(i) {
                var cs2: Vec<i64> = callees.get(i);
                var j: i64 = 0;
                while j < cs2.len() {
                    if ret.get(cs2.get(j)) {
                        ret.set(i, true);
                        changed = true;
                        j = cs2.len();
                    } else {
                        j = j + 1;
                    }
                }
            }
            i = i + 1;
        }
    }
    return ret;
}

/// p_region_word(op, x) as instructions of `f` not yet in a block, appended
/// to `out`: the call's id.
fn lw_rg_detached_call(f: & mut IrFunction, op: i64, x: i64, out: & mut Vec<i64>) -> i64 {
    var ko: i64 = lw_detached(f, Inst::ConstInt(op, IrType::I64));
    out.push(ko);
    var a: Vec<i64> = Vec::new();
    a.push(ko);
    a.push(x);
    var c: i64 = lw_detached(f, Inst::Call("p_region_word", a, IrType::I64, lw_rc_eff()));
    out.push(c);
    return c;
}

/// Whether function `f` begins a region with an arena (p_region_word(7, 0)).
fn lw_rg_has_region(f: & IrFunction) -> bool {
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ins: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ins.len() {
            if lw_rg_is_op(f, ins.get(k), 7) {
                return true;
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return false;
}

/// After lowering, with regions that have arenas (proposal 0005):
/// - in a function with one, each return first ends the regions it leaves
///   open (a return or `?` inside one: their values were made outside):
///   p_region_word(10, 0) at entry saves the region state, p_region_word(9,
///   it) before each return restores it;
/// - in the functions such a region's code can reach, a call that may keep
///   a value where no region's end reaches (lw_rg_retains) runs with no
///   region current: p_region_word(3, -1) before, (2, the previous) after.
///   FID_REGION_DEBUG=1 prints each such call.
fn lw_rg_finish(module: & mut IrModule) {
    var n: i64 = module.functions.len();
    var has: Vec<bool> = Vec::new();
    var any: bool = false;
    var i: i64 = 0;
    while i < n {
        var f: IrFunction = module.functions.get(i).func;
        var h: bool = lw_rg_has_region(& f);
        has.push(h);
        if h {
            any = true;
        }
        i = i + 1;
    }
    if !any {
        return;
    }
    var ret: Vec<bool> = lw_rg_retains(module);
    // the functions region code reaches through calls that run in it
    var reach: Vec<bool> = Vec::new();
    var work: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        reach.push(has.get(i));
        if has.get(i) {
            work.push(i);
        }
        i = i + 1;
    }
    while work.len() > 0 {
        var fi: i64 = work.pop();
        var f2: IrFunction = module.functions.get(fi).func;
        var b2: i64 = 0;
        while b2 < f2.blocks.len() {
            var ins2: Vec<i64> = f2.blocks.get(b2).instructions;
            var k2: i64 = 0;
            while k2 < ins2.len() {
                match IrFunction_get_inst(& f2, ins2.get(k2)) {
                    OptInst::Some(inst) => {
                        match inst {
                            Inst::Call(cn, _, _, _) => {
                                var pos: i64 = IrModule_fn_pos(module, cn);
                                if pos >= 0 {
                                    if !ret.get(pos) && !reach.get(pos) {
                                        reach.set(pos, true);
                                        work.push(pos);
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    OptInst::None => {
                    }
                }
                k2 = k2 + 1;
            }
            b2 = b2 + 1;
        }
    }
    var debug: bool = false;
    match env_var("FID_REGION_DEBUG") {
        Option::Some(_) => {
            debug = true;
        }
        Option::None => {
        }
    }
    i = 0;
    while i < n {
        if reach.get(i) {
            var entry: IrFunctionEntry = module.functions.get(i);
            var func: IrFunction = entry.func;
            var saved: i64 = - 1;
            if has.get(i) && func.blocks.len() > 0 {
                var pro: Vec<i64> = Vec::new();
                var zero: i64 = lw_detached(& mut func, Inst::ConstInt(0, IrType::I64));
                pro.push(zero);
                saved = lw_rg_detached_call(& mut func, 10, zero, & mut pro);
                var eb: BasicBlock = func.blocks.get(0);
                var k3: i64 = 0;
                while k3 < eb.instructions.len() {
                    pro.push(eb.instructions.get(k3));
                    k3 = k3 + 1;
                }
                eb.instructions = pro;
                func.blocks.set(0, eb);
            }
            var b3: i64 = 0;
            while b3 < func.blocks.len() {
                var blk: BasicBlock = func.blocks.get(b3);
                var fresh: Vec<i64> = Vec::new();
                var k4: i64 = 0;
                while k4 < blk.instructions.len() {
                    var id: i64 = blk.instructions.get(k4);
                    var wrap: bool = false;
                    var is_ret: bool = false;
                    var what: str = "";
                    match IrFunction_get_inst(& func, id) {
                        OptInst::Some(inst) => {
                            match inst {
                                Inst::Call(cn, _, _, _) => {
                                    var pos: i64 = IrModule_fn_pos(module, cn);
                                    if pos >= 0 {
                                        wrap = ret.get(pos);
                                    } else {
                                        wrap = !lw_rg_safe_builtin(cn);
                                    }
                                    what = cn;
                                }
                                Inst::CallPtr(_, _, _, _, _) => {
                                    wrap = true;
                                    what = "a call through a function value";
                                }
                                Inst::DynCall(_, mn, _, _, _) => {
                                    wrap = true;
                                    what = mn;
                                }
                                Inst::Return(_) => {
                                    is_ret = true;
                                }
                                _ => {
                                }
                            }
                        }
                        OptInst::None => {
                        }
                    }
                    if is_ret && saved >= 0 {
                        lw_rg_detached_call(& mut func, 9, saved, & mut fresh);
                    }
                    if wrap {
                        if debug {
                            p_eprint_str("fid: region: in " + entry.name + ", " + what + " runs with no region current\n");
                        }
                        var all: i64 = lw_detached(& mut func, Inst::ConstInt(0 - 1, IrType::I64));
                        fresh.push(all);
                        var prev: i64 = lw_rg_detached_call(& mut func, 3, all, & mut fresh);
                        fresh.push(id);
                        lw_rg_detached_call(& mut func, 2, prev, & mut fresh);
                    } else {
                        fresh.push(id);
                    }
                    k4 = k4 + 1;
                }
                blk.instructions = fresh;
                func.blocks.set(b3, blk);
                b3 = b3 + 1;
            }
            entry.func = func;
            module.functions.set(i, entry);
        }
        i = i + 1;
    }
}

/// Free the lowerer's index maps (raw handles) once the module is made.
fn Lowerer_free_maps(self: & mut Lowerer) {
    HashMap_drop(self.enum_index);
    self.enum_index = HashMap_new();
    HashMap_drop(self.func_info_at);
    self.func_info_at = HashMap_new();
    HashMap_drop(self.own_type_index);
    self.own_type_index = HashMap_new();
    HashMap_drop(self.own_kind_cache);
    self.own_kind_cache = HashMap_new();
    HashMap_drop(self.own_ret_index);
    self.own_ret_index = HashMap_new();
    HashMap_drop(self.struct_index);
    self.struct_index = HashMap_new();
    HashMap_drop(self.impl_index);
    self.impl_index = HashMap_new();
    HashMap_drop(self.extern_index);
    self.extern_index = HashMap_new();
    // SP12: the variable tables' name indexes, made again for what is left
    Lowerer_ix_reset_tables(self);
}

/// core.fd functions that use a Vec through its handle and keep no reference
/// to it.
fn lw_vec_local_call(name: str) -> bool {
    if !str_starts_with(name, "Vec_") {
        return false;
    }
    return name == "Vec_push" || name == "Vec_pop" || name == "Vec_len" || name == "Vec_is_empty" || name == "Vec_get" || name == "Vec_set" || name == "Vec_clear" || name == "Vec_capacity" || name == "Vec_contains" || name == "Vec_first" || name == "Vec_last" || name == "Vec_truncate" || name == "Vec_reverse" || name == "Vec_sort"  // A share uses the Vec, keeping no reference: the share's count is
    // what the new owner drops, the source keeps its own.
    || name == "Vec_share" || name == "Vec_share_deep";
}

/// Per function, per argument: 1 for a Vec it only uses, keeping no reference
/// to it and leaving it to the caller to free.
pub struct LwBorrows {
    pub index: i64,
    // function name -> row
    pub rows: Vec<Vec<i64>>,
    pub funcs: Vec<i64>,  // row -> function
}

fn lw_is_vec_type(t: IrType) -> bool {
    match t {
        IrType::Generic(n, _) => {
            return n == "Vec";
        }
        IrType::Opaque(n) => {
            return n == "Vec";
        }
        _ => {
            return false;
        }
    }
}

/// A by-value collection of this drop kind: 0 Vec, 1 HashMap. `&Vec`
/// (`Ptr`) is not — it points at the caller's header.
fn lw_is_coll_type(t: IrType, kind: i64) -> bool {
    var want: str = "Vec";
    if kind == 1 {
        want = "HashMap";
    }
    match t {
        IrType::Generic(n, _) => {
            return n == want;
        }
        IrType::Opaque(n) => {
            return n == want;
        }
        _ => {
            return false;
        }
    }
}

/// Calls that use a local HashMap without keeping it (the map is argument 1).
fn lw_map_local_call(name: str) -> bool {
    if !str_starts_with(name, "HashMap_") {
        return false;
    }
    return name == "HashMap_insert" || name == "HashMap_get" || name == "HashMap_contains" || name == "HashMap_remove" || name == "HashMap_len" || name == "HashMap_is_empty" || name == "HashMap_clear" || name == "HashMap_get_or" || name == "HashMap_keys" || name == "HashMap_values" || name == "HashMap_share" || name == "HashMap_keys_u64" || name == "HashMap_values_u64";
}

/// What a Vec slot's elements are, from its type: 1 strings, 2 Vecs, else 0.
fn lw_vec_elem_kind(t: IrType) -> i64 {
    match ir_type_generic_elem(t) {
        OptIrType::Some(e) => {
            if ir_type_eq(e, ptr_u8()) {
                return 1;
            }
            if lw_is_vec_type(e) {
                return 2;
            }
        }
        OptIrType::None => {
        }
    }
    return 0;
}

/// A fresh value nobody else holds: a new string (kind 1) or a new Vec (2).
fn lw_is_fresh_elem(f: & IrFunction, id: i64, ekind: i64) -> bool {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Call(name, _, _, _) => {
                    if ekind == 2 {
                        return name == "Vec_new" || name == "Vec_new_sized" || name == "Vec_clone";
                    }
                    return name == "p_str_concat" || name == "int_to_str" || name == "p_to_str" || name == "p_char_to_str" || name == "float_to_str" || name == "p_str_literal_dup" || name == "String_slice_len" || name == "str_slice";
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return false;
}

/// An element read out of an owning Vec may only be looked at, never kept:
/// printed, compared, measured, or (for an inner Vec) read from.
fn lw_is_elem_read(inst: Inst, op: i64, ekind: i64) -> bool {
    match inst {
        Inst::Print(_, _) => {
            return true;
        }
        Inst::Call(name, args, _, _) => {
            if ekind == 2 {
                if (name == "Vec_len" || name == "Vec_get" || name == "Vec_is_empty" || name == "Vec_contains") && args.len() >= 2 && args.get(1) == op {
                    var k: i64 = 2;
                    while k < args.len() {
                        if args.get(k) == op {
                            return false;
                        }
                        k = k + 1;
                    }
                    return true;
                }
                return false;
            }
            return name == "p_str_equal" || name == "str_equal" || name == "p_str_length" || name == "str_len" || name == "p_string_len" || name == "str_contains" || name == "str_starts_with" || name == "str_ends_with" || name == "str_find" || name == "p_str_concat" || name == "p_string_contains" || name == "p_string_starts_with" || name == "p_string_ends_with" || name == "p_string_find" || name == "str_byte_at" || name == "p_str_compare";
        }
        Inst::BinOp(_, _, _, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// Per slot, 1 when the Vec it holds owns its elements (release C5): every
/// element pushed or set is a fresh value used only there, and every element
/// read with get/first/last is only looked at. A popped element has left the
/// Vec, so pops are free. Worst case a leak, never a dangling element.
fn lw_vec_owns_elements(f: & IrFunction, order: Vec<i64>, kept: Vec<i64>, elem_kind: Vec<i64>, loaded: Vec<i64>, n: i64) -> Vec<i64> {
    var owns: Vec<i64> = lw_zeros(n);
    var ki: i64 = 0;
    var any: bool = false;
    while ki < kept.len() {
        if elem_kind.get(kept.get(ki)) != 0 {
            owns.set(kept.get(ki), 1);
            any = true;
        }
        ki = ki + 1;
    }
    if !any {
        return owns;
    }
    // How often each value is used, and which values are elements read out
    var uses: Vec<i64> = lw_zeros(n);
    var read_from: Vec<i64> = lw_zeros(n);
    // value -> slot + 1
    var i: i64 = 0;
    while i < order.len() {
        var id: i64 = order.get(i);
        match IrFunction_get_inst(f, id) {
            OptInst::Some(inst) => {
                var ops: Vec<i64> = Vec::new();
                peir_inst_operands(inst, & mut ops);
                var k: i64 = 0;
                while k < ops.len() {
                    if ops.get(k) >= 0 && ops.get(k) < n {
                        uses.set(ops.get(k), uses.get(ops.get(k)) + 1);
                    }
                    k = k + 1;
                }
                match inst {
                    Inst::Call(name, args, _, _) => {
                        if args.len() >= 2 && args.get(1) >= 0 && args.get(1) < n && loaded.get(args.get(1)) != 0 {
                            var slot: i64 = loaded.get(args.get(1)) - 1;
                            if name == "Vec_get" || name == "Vec_first" || name == "Vec_last" {
                                read_from.set(id, slot + 1);
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            OptInst::None => {
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < order.len() {
        var id: i64 = order.get(i);
        match IrFunction_get_inst(f, id) {
            OptInst::Some(inst) => {
                match inst {
                    Inst::Call(name, args, _, _) => {
                        if args.len() >= 2 && args.get(1) >= 0 && args.get(1) < n && loaded.get(args.get(1)) != 0 {
                            var slot: i64 = loaded.get(args.get(1)) - 1;
                            var ek: i64 = elem_kind.get(slot);
                            if ek != 0 {
                                var put: i64 = - 1;
                                if name == "Vec_push" && args.len() >= 3 {
                                    put = args.get(2);
                                }
                                if name == "Vec_set" && args.len() >= 4 {
                                    put = args.get(3);
                                }
                                if put >= 0 {
                                    if put >= n || uses.get(put) != 1 || !lw_is_fresh_elem(f, put, ek) {
                                        owns.set(slot, 0);
                                    }
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                var ops: Vec<i64> = Vec::new();
                peir_inst_operands(inst, & mut ops);
                var k: i64 = 0;
                while k < ops.len() {
                    var op: i64 = ops.get(k);
                    if op >= 0 && op < n && read_from.get(op) != 0 {
                        var rs: i64 = read_from.get(op) - 1;
                        if !lw_is_elem_read(inst, op, elem_kind.get(rs)) {
                            owns.set(rs, 0);
                        }
                    }
                    // The Vec itself handed to anything but its own methods
                    // (a function taking it by `&mut`, for one) may get
                    // elements that are not its own: no deep drop
                    if op >= 0 && op < n && owns.get(op) == 1 {
                        var own_access: bool = false;
                        match inst {
                            Inst::Load(lp, _) => {
                                own_access = lp == op;
                            }
                            Inst::Store(sp, _, _) => {
                                own_access = sp == op;
                            }
                            _ => {
                            }
                        }
                        if !own_access {
                            owns.set(op, 0);
                        }
                    }
                    if op >= 0 && op < n && loaded.get(op) != 0 && owns.get(loaded.get(op) - 1) == 1 {
                        var own_call: bool = false;
                        match inst {
                            Inst::Print(_, _) => {
                                own_call = true;
                            }
                            Inst::Call(cname, cargs, _, _) => {
                                own_call = lw_vec_local_call(cname) && cargs.len() >= 2 && cargs.get(1) == op;
                            }
                            _ => {
                            }
                        }
                        if !own_call {
                            owns.set(loaded.get(op) - 1, 0);
                        }
                    }
                    k = k + 1;
                }
            }
            OptInst::None => {
            }
        }
        i = i + 1;
    }
    return owns;
}

fn lw_vec_borrows(module: & IrModule) -> LwBorrows {
    var b: LwBorrows = LwBorrows {
        index: HashMap_new(), rows: Vec::new(), funcs: Vec::new()
    };
    var i: i64 = 0;
    while i < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(i);
        var row: Vec<i64> = Vec::new();
        var any: bool = false;
        var p: i64 = 0;
        while p < entry.func.params.len() {
            var flag: bool = false;
            var ty: IrType = entry.func.params.get(p).ty;
            match ty {
                IrType::Ptr(inner) => {
                    flag = lw_is_vec_type(inner);
                }
                _ => {
                    flag = lw_is_vec_type(ty);
                }
            }
            if flag {
                row.push(1);
                any = true;
            } else {
                row.push(0);
            }
            p = p + 1;
        }
        if any {
            HashMap_insert(b.index, entry.name, b.rows.len());
            b.rows.push(row);
            b.funcs.push(i);
        }
        i = i + 1;
    }
    // Every candidate holds until a use disproves it: functions may call each
    // other. One scan of each function gives what it hands on to whom (an edge per
    // argument), and the rest needs no more scans.
    var edge_from: Vec<i64> = Vec::new();
    var edge_to: Vec<i64> = Vec::new();
    var r: i64 = 0;
    while r < b.rows.len() {
        var f: IrFunction = module.functions.get(b.funcs.get(r)).func;
        lw_scan_borrows(& f, r, & mut b, & mut edge_from, & mut edge_to);
        r = r + 1;
    }
    var changed: bool = true;
    while changed {
        changed = false;
        var e: i64 = 0;
        while e < edge_from.len() {
            var from: i64 = edge_from.get(e);
            var to: i64 = edge_to.get(e);
            if b.rows.get(to >> 12).get(to & 4095) == 0 && b.rows.get(from >> 12).get(from & 4095) != 0 {
                b.rows.get(from >> 12).set(from & 4095, 0);
                changed = true;
            }
            e = e + 1;
        }
    }
    return b;
}

// What function `r`'s uses of its Vec parameters decide: a parameter it keeps is
// cleared, and one it hands to another function adds an edge.
fn lw_scan_borrows(f: & IrFunction, r: i64, b: & mut LwBorrows, edge_from: & mut Vec<i64>, edge_to: & mut Vec<i64>) {
    var row: Vec<i64> = b.rows.get(r);
    // Per value: 1 + the parameter it is, or for `&Vec` the handle read through it
    var owner: Vec<i64> = lw_zeros(f.next_value);
    var is_param: Vec<i64> = lw_zeros(f.next_value);
    var p: i64 = 0;
    while p < row.len() {
        if row.get(p) != 0 {
            owner.set(f.params.get(p).id, p + 1);
            is_param.set(f.params.get(p).id, 1);
        }
        p = p + 1;
    }
    var order: Vec<i64> = lw_block_order(f);
    var i: i64 = 0;
    while i < order.len() {
        var id: i64 = order.get(i);
        match IrFunction_get_inst(f, id) {
            OptInst::Some(inst) => {
                match inst {
                    Inst::Load(ptr, _) => {
                        if is_param.get(ptr) != 0 {
                            owner.set(id, owner.get(ptr));
                        }
                    }
                    _ => {
                    }
                }
            }
            OptInst::None => {
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < order.len() {
        match IrFunction_get_inst(f, order.get(i)) {
            OptInst::Some(inst) => {
                var is_load: bool = false;
                match inst {
                    Inst::Load(_, _) => {
                        is_load = true;
                    }
                    _ => {
                    }
                }
                if !is_load {
                    var ops: Vec<i64> = Vec::new();
                    peir_inst_operands(inst, & mut ops);
                    var k: i64 = 0;
                    while k < ops.len() {
                        var op: i64 = ops.get(k);
                        if owner.get(op) != 0 {
                            lw_borrow_use(inst, op, b, & mut row, r, owner.get(op) - 1, edge_from, edge_to);
                        }
                        k = k + 1;
                    }
                }
            }
            OptInst::None => {
            }
        }
        i = i + 1;
    }
    // `row` is a copy (proposal 0001): the row keeps what the scan cleared
    b.rows.set(r, row);
}

fn lw_borrow_use(inst: Inst, op: i64, b: & LwBorrows, row: & mut Vec<i64>, r: i64, param: i64, edge_from: & mut Vec<i64>, edge_to: & mut Vec<i64>) {
    match inst {
        Inst::Print(_, _) => {
            return;
        }
        Inst::Call(name, args, _, _) => {
            if lw_vec_local_call(name) && args.len() >= 2 && args.get(1) == op {
                var once: bool = true;
                var k: i64 = 2;
                while k < args.len() {
                    if args.get(k) == op {
                        once = false;
                    }
                    k = k + 1;
                }
                if once {
                    return;
                }
            }
            if HashMap_contains(b.index, name) {
                var to: i64 = HashMap_get(b.index, name);
                var to_row: Vec<i64> = b.rows.get(to);
                var i: i64 = 0;
                var fits: bool = true;
                while i < args.len() {
                    if args.get(i) == op {
                        if i >= to_row.len() || to_row.get(i) == 0 {
                            fits = false;
                        } else {
                            edge_from.push(r * 4096 + param);
                            edge_to.push(to * 4096 + i);
                        }
                    }
                    i = i + 1;
                }
                if fits {
                    return;
                }
            }
        }
        _ => {
        }
    }
    row.set(param, 0);
}

/// Free the Vecs that provably never leave their local variable (as
/// src/lower.rs auto_drop_vecs): a slot that only ever receives a fresh
/// `Vec_new`, read only as the receiver of those calls, by a function that
/// only borrows it, or to print it. The previous Vec is freed when the slot
/// is written again and the last one at each return. The worst case is a
/// leak, never a dangling Vec.
fn lw_auto_drop_vecs(module: & mut IrModule) {
    var has_drop: bool = false;
    var i: i64 = 0;
    while i < module.functions.len() {
        if module.functions.get(i).name == "Vec_drop" {
            has_drop = true;
        }
        i = i + 1;
    }
    if !has_drop {
        return;
    }
    var borrows: LwBorrows = lw_vec_borrows(module);
    // Deep drops (release C5) and map drops (C7) only where core has them
    var deep_ok: bool = false;
    var maps_ok: bool = false;
    i = 0;
    while i < module.functions.len() {
        var fname: str = module.functions.get(i).name;
        if fname == "Vec_drop_strs" {
            deep_ok = true;
        }
        if fname == "HashMap_drop" {
            maps_ok = true;
        }
        i = i + 1;
    }
    i = 0;
    while i < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(i);
        var func: IrFunction = entry.func;
        var changed: bool = lw_drop_function_vecs(& mut func, borrows, 0, deep_ok);
        if maps_ok && lw_drop_function_vecs(& mut func, borrows, 1, false) {
            changed = true;
        }
        if changed {
            entry.func = func;
            module.functions.set(i, entry);
        }
        i = i + 1;
    }
}

fn lw_zeros(n: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        v.push(0);
        i = i + 1;
    }
    return v;
}

fn lw_block_order(f: & IrFunction) -> Vec<i64> {
    var order: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            order.push(ids.get(k));
            k = k + 1;
        }
        b = b + 1;
    }
    return order;
}

fn lw_is_vec_new(f: & IrFunction, id: i64) -> bool {
    return lw_is_ctor(f, id, 0);
}

/// Whether `id` is a fresh collection header: `Vec_new`/`Vec_share`/
/// `Vec_share_deep` (kind 0) or `HashMap_new`/`HashMap_share` (kind 1). A
/// share makes a header the slot owns (its buffer is counted), so the slot
/// may be dropped like one holding a Vec_new.
fn lw_is_share_call(f: & IrFunction, id: i64) -> bool {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Call(name, _, _, _) => {
                    return name == "Vec_share" || name == "Vec_share_deep" || name == "HashMap_share";
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return false;
}

fn lw_is_ctor(f: & IrFunction, id: i64, kind: i64) -> bool {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Call(name, _, _, _) => {
                    if kind == 1 {
                        return name == "HashMap_new" || name == "HashMap_share";
                    }
                    return name == "Vec_new" || name == "Vec_new_sized" || name == "Vec_share" || name == "Vec_share_deep";
                }
                _ => {
                    return false;
                }
            }
        }
        OptInst::None => {
            return false;
        }
    }
}

fn lw_drop_function_vecs(f: & mut IrFunction, borrows: LwBorrows, kind: i64, deep_ok: bool) -> bool {
    var order: Vec<i64> = lw_block_order(f);
    var i: i64 = 0;
    var any: bool = false;
    while i < order.len() && !any {
        any = lw_is_ctor(f, order.get(i), kind);
        i = i + 1;
    }
    if !any {
        return false;
    }
    var n: i64 = f.next_value;
    // Per value: slot (1 = a slot), loaded (slot + 1), stored_in (slot + 1),
    // bad and written (per slot)
    var is_slot: Vec<i64> = lw_zeros(n);
    var loaded: Vec<i64> = lw_zeros(n);
    var stored_in: Vec<i64> = lw_zeros(n);
    var bad: Vec<i64> = lw_zeros(n);
    var written: Vec<i64> = lw_zeros(n);
    var from_share: Vec<i64> = lw_zeros(n);
    // Per slot: 1 a Vec<str>, 2 a Vec<Vec<T>> (from the slot's type)
    var elem_kind: Vec<i64> = lw_zeros(n);
    // Per slot: the region it was declared in ("" outside any)
    var slot_region: Vec<str> = Vec::new();
    var sr: i64 = 0;
    while sr < n {
        slot_region.push("");
        sr = sr + 1;
    }
    var slots: Vec<i64> = Vec::new();
    i = 0;
    while i < order.len() {
        var id: i64 = order.get(i);
        match IrFunction_get_inst(f, id) {
            OptInst::Some(inst) => {
                match inst {
                    Inst::Alloca(sty, sreg) => {
                        is_slot.set(id, 1);
                        slots.push(id);
                        if kind == 0 {
                            elem_kind.set(id, lw_vec_elem_kind(sty));
                        }
                        match sreg {
                            Region::Named(rn) => {
                                slot_region.set(id, rn);
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            OptInst::None => {
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < order.len() {
        var id: i64 = order.get(i);
        match IrFunction_get_inst(f, id) {
            OptInst::Some(inst) => {
                match inst {
                    Inst::Load(ptr, _) => {
                        if is_slot.get(ptr) != 0 {
                            loaded.set(id, ptr + 1);
                        }
                    }
                    Inst::Store(ptr, value, _) => {
                        if is_slot.get(ptr) != 0 {
                            if lw_is_ctor(f, value, kind) {
                                written.set(ptr, 1);
                                stored_in.set(value, ptr + 1);
                                if lw_is_share_call(f, value) {
                                    from_share.set(ptr, 1);
                                }
                            } else {
                                bad.set(ptr, 1);
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            OptInst::None => {
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < order.len() {
        match IrFunction_get_inst(f, order.get(i)) {
            OptInst::Some(inst) => {
                lw_check_slot_uses(inst, is_slot, loaded, stored_in, & mut bad, borrows, kind);
            }
            OptInst::None => {
            }
        }
        i = i + 1;
    }
    var kept: Vec<i64> = Vec::new();
    i = 0;
    while i < slots.len() {
        var s: i64 = slots.get(i);
        if written.get(s) != 0 && bad.get(s) == 0 {
            kept.push(s);
        }
        i = i + 1;
    }
    if kept.len() == 0 {
        return false;
    }
    // Which drop each kept slot gets: a Vec that owns its strings or Vecs
    // frees them too (release C5)
    var drop_fn: Vec<str> = Vec::new();
    i = 0;
    while i < n {
        if kind == 1 {
            drop_fn.push("HashMap_drop");
        } else {
            drop_fn.push("Vec_drop");
        }
        i = i + 1;
    }
    // A slot that holds a copy-on-write share has elements someone else
    // put there: freeing its header is all it may do (its elements belong to
    // the Vec it was copied from)
    if kind == 0 && deep_ok {
        var owns: Vec<i64> = lw_vec_owns_elements(f, order, kept, elem_kind, loaded, n);
        i = 0;
        while i < kept.len() {
            var ks: i64 = kept.get(i);
            if owns.get(ks) == 1 && from_share.get(ks) == 0 && elem_kind.get(ks) == 1 {
                drop_fn.set(ks, "Vec_drop_strs");
            }
            if owns.get(ks) == 1 && from_share.get(ks) == 0 && elem_kind.get(ks) == 2 {
                drop_fn.set(ks, "Vec_drop_vecs");
            }
            i = i + 1;
        }
    }
    // The Vec a slot last held, kept apart from the slot: an Alloca in a
    // loop body zeroes the slot at each iteration.
    var shadows: Vec<i64> = lw_zeros(n);
    var prologue: Vec<i64> = Vec::new();
    i = 0;
    while i < kept.len() {
        var zero: i64 = lw_detached(f, Inst::ConstInt(0, IrType::I64));
        var shadow: i64 = lw_detached(f, Inst::Alloca(IrType::I64, Region::Stack));
        var init: i64 = lw_detached(f, Inst::Store(shadow, zero, OptIrType::None));
        prologue.push(zero);
        prologue.push(shadow);
        prologue.push(init);
        shadows.set(kept.get(i), shadow + 1);
        i = i + 1;
    }
    var b: i64 = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var old: Vec<i64> = blk.instructions;
        var fresh: Vec<i64> = Vec::new();
        if b == 0 {
            fresh = prologue;
        }
        var k: i64 = 0;
        while k < old.len() {
            var id: i64 = old.get(k);
            var done: bool = false;
            match IrFunction_get_inst(f, id) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::Store(ptr, value, _) => {
                            if is_slot.get(ptr) != 0 && shadows.get(ptr) != 0 {
                                var shadow: i64 = shadows.get(ptr) - 1;
                                lw_drop_shadow(f, drop_fn.get(ptr), shadow, & mut fresh);
                                fresh.push(id);
                                fresh.push(lw_detached(f, Inst::Store(shadow, value, OptIrType::None)));
                                done = true;
                            }
                        }
                        Inst::Return(_) => {
                            // CM3: the retired copy-on-write (LOWER_COW with
                            // LOWER_ARG_SHARE) also dropped here the
                            // parameters a caller had shared into; callers
                            // pass their own header, so nothing of theirs
                            // is dropped
                            var ki: i64 = 0;
                            while ki < kept.len() {
                                lw_drop_shadow(f, drop_fn.get(kept.get(ki)), shadows.get(kept.get(ki)) - 1, & mut fresh);
                                ki = ki + 1;
                            }
                        }
                        // A region frees what was declared in it (release
                        // C6): only slots that never escape are kept, so
                        // nothing outside the region holds them
                        Inst::RegionEnd(rname, _, _) => {
                            var rk: i64 = 0;
                            while rk < kept.len() {
                                var rslot: i64 = kept.get(rk);
                                if slot_region.get(rslot) == rname {
                                    var rshadow: i64 = shadows.get(rslot) - 1;
                                    lw_drop_shadow(f, drop_fn.get(rslot), rshadow, & mut fresh);
                                    var rzero: i64 = lw_detached(f, Inst::ConstInt(0, IrType::I64));
                                    fresh.push(rzero);
                                    fresh.push(lw_detached(f, Inst::Store(rshadow, rzero, OptIrType::None)));
                                }
                                rk = rk + 1;
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            if !done {
                fresh.push(id);
            }
            k = k + 1;
        }
        blk.instructions = fresh;
        f.blocks.set(b, blk);
        b = b + 1;
    }
    return true;
}

fn lw_check_slot_uses(inst: Inst, is_slot: Vec<i64>, loaded: Vec<i64>, stored_in: Vec<i64>, bad: & mut Vec<i64>, borrows: LwBorrows, kind: i64) {
    var ops: Vec<i64> = Vec::new();
    peir_inst_operands(inst, & mut ops);
    var target: i64 = - 1;
    var own_store: bool = false;
    match inst {
        Inst::Load(ptr, _) => {
            if is_slot.get(ptr) != 0 {
                target = ptr;
            }
        }
        Inst::Store(ptr, _, _) => {
            if is_slot.get(ptr) != 0 {
                target = ptr;
                own_store = true;
            }
        }
        _ => {
        }
    }
    var i: i64 = 0;
    while i < ops.len() {
        var op: i64 = ops.get(i);
        if is_slot.get(op) != 0 && op != target && !lw_is_local_use(inst, op, borrows, kind) {
            bad.set(op, 1);
        }
        if loaded.get(op) != 0 && !lw_is_local_use(inst, op, borrows, kind) {
            bad.set(loaded.get(op) - 1, 1);
        }
        if stored_in.get(op) != 0 && !own_store {
            bad.set(stored_in.get(op) - 1, 1);
        }
        i = i + 1;
    }
}

fn lw_is_local_use(inst: Inst, op: i64, borrows: LwBorrows, kind: i64) -> bool {
    match inst {
        Inst::Print(_, _) => {
            return true;
        }
        Inst::Call(name, args, _, _) => {
            var local_call: bool = lw_vec_local_call(name);
            if kind == 1 {
                local_call = lw_map_local_call(name);
            }
            if local_call && args.len() >= 2 && args.get(1) == op {
                var once: bool = true;
                var k: i64 = 2;
                while k < args.len() {
                    if args.get(k) == op {
                        once = false;
                    }
                    k = k + 1;
                }
                if once {
                    return true;
                }
            }
            // The borrow summaries are for Vec parameters
            if kind == 1 {
                return false;
            }
            if !HashMap_contains(borrows.index, name) {
                return false;
            }
            var row: Vec<i64> = borrows.rows.get(HashMap_get(borrows.index, name));
            var i: i64 = 0;
            while i < args.len() {
                if args.get(i) == op {
                    if i >= row.len() || row.get(i) == 0 {
                        return false;
                    }
                }
                i = i + 1;
            }
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// `Vec_drop(*shadow)`, appended to `out`.
/// 2g.119: |v| small enough that a sum, difference or product of two of
/// them cannot overflow i64 — the interpreter traps overflow where the
/// compiled target wraps, so wider arithmetic is left to run as written.
fn lw_fold_small(v: i64) -> bool {
    return v >= (0 - 4294967296) && v <= 4294967296;
}

/// 2g.119: fold a constant global initializer to a literal, so every
/// backend bakes it into the program's data with no runtime assignment.
/// The assignment otherwise ran at the top of main, after the boot hooks
/// (pert_limits_boot, pert_prof_boot): a hook read the zero fill where the
/// initializer was `-1` (`var x: i64 = 0 - 1`, the runtime's "not read
/// yet" idiom, 119 uses in the tree) and a hook's own write was
/// overwritten when main started. Arithmetic wraps as the target's; what
/// the interpreter would trap or the target mask is not folded: a division
/// or modulo by zero, and shifts of 64 bits or more.
fn lw_fold_const_init(expr: Expr) -> Expr {
    match expr {
        Expr::Unary(op, e) => {
            val inner: Expr = lw_fold_const_init(box_expr_unbox(e));
            match inner {
                Expr::IntLit(v) => {
                    match op {
                        UnaryOp::Neg => {
                            if lw_fold_small(v) {
                                return Expr::IntLit(0 - v);
                            }
                        }
                        UnaryOp::BitNot => {
                            return Expr::IntLit((0 - v) - 1);
                        }
                        _ => {
                        }
                    }
                }
                Expr::FloatLit(f) => {
                    match op {
                        UnaryOp::Neg => {
                            return Expr::FloatLit(0.0 - f);
                        }
                        _ => {
                        }
                    }
                }
                Expr::BoolLit(b) => {
                    match op {
                        UnaryOp::Not => {
                            if b {
                                return Expr::BoolLit(false);
                            }
                            return Expr::BoolLit(true);
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            return Expr::Unary(op, Box::new(inner));
        }
        Expr::Binary(op, l, r) => {
            val le: Expr = lw_fold_const_init(box_expr_unbox(l));
            val re: Expr = lw_fold_const_init(box_expr_unbox(r));
            match le {
                Expr::IntLit(lv) => {
                    match re {
                        Expr::IntLit(rv) => {
                            match op {
                                BinOp::Add => {
                                    if lw_fold_small(lv) && lw_fold_small(rv) {
                                        return Expr::IntLit(lv + rv);
                                    }
                                }
                                BinOp::Sub => {
                                    if lw_fold_small(lv) && lw_fold_small(rv) {
                                        return Expr::IntLit(lv - rv);
                                    }
                                }
                                BinOp::Mul => {
                                    if lw_fold_small(lv) && lw_fold_small(rv) {
                                        return Expr::IntLit(lv * rv);
                                    }
                                }
                                BinOp::Div => {
                                    if rv != 0 && !(lv == ((0 - 9223372036854775807) - 1) && rv == (0 - 1)) {
                                        return Expr::IntLit(lv / rv);
                                    }
                                }
                                BinOp::Mod => {
                                    if rv != 0 && !(lv == ((0 - 9223372036854775807) - 1) && rv == (0 - 1)) {
                                        return Expr::IntLit(lv % rv);
                                    }
                                }
                                BinOp::BitAnd => {
                                    return Expr::IntLit(lv & rv);
                                }
                                BinOp::BitOr => {
                                    return Expr::IntLit(lv | rv);
                                }
                                BinOp::BitXor => {
                                    return Expr::IntLit(lv ^ rv);
                                }
                                BinOp::Shl => {
                                    if rv >= 0 && rv < 64 && lw_fold_small(lv) {
                                        return Expr::IntLit(lv << rv);
                                    }
                                }
                                BinOp::Shr => {
                                    if rv >= 0 && rv < 64 {
                                        return Expr::IntLit(lv >> rv);
                                    }
                                }
                                BinOp::Eq => {
                                    return Expr::BoolLit(lv == rv);
                                }
                                BinOp::Neq => {
                                    return Expr::BoolLit(lv != rv);
                                }
                                BinOp::Lt => {
                                    return Expr::BoolLit(lv < rv);
                                }
                                BinOp::Gt => {
                                    return Expr::BoolLit(lv > rv);
                                }
                                BinOp::LtEq => {
                                    return Expr::BoolLit(lv <= rv);
                                }
                                BinOp::GtEq => {
                                    return Expr::BoolLit(lv >= rv);
                                }
                                _ => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                Expr::FloatLit(lf) => {
                    match re {
                        Expr::FloatLit(rf) => {
                            match op {
                                BinOp::Add => {
                                    return Expr::FloatLit(lf + rf);
                                }
                                BinOp::Sub => {
                                    return Expr::FloatLit(lf - rf);
                                }
                                BinOp::Mul => {
                                    return Expr::FloatLit(lf * rf);
                                }
                                BinOp::Div => {
                                    return Expr::FloatLit(lf / rf);
                                }
                                BinOp::Eq => {
                                    return Expr::BoolLit(lf == rf);
                                }
                                BinOp::Neq => {
                                    return Expr::BoolLit(lf != rf);
                                }
                                BinOp::Lt => {
                                    return Expr::BoolLit(lf < rf);
                                }
                                BinOp::Gt => {
                                    return Expr::BoolLit(lf > rf);
                                }
                                BinOp::LtEq => {
                                    return Expr::BoolLit(lf <= rf);
                                }
                                BinOp::GtEq => {
                                    return Expr::BoolLit(lf >= rf);
                                }
                                _ => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                Expr::BoolLit(lb) => {
                    match re {
                        Expr::BoolLit(rb) => {
                            match op {
                                BinOp::And => {
                                    if lb && rb {
                                        return Expr::BoolLit(true);
                                    }
                                    return Expr::BoolLit(false);
                                }
                                BinOp::Or => {
                                    if lb || rb {
                                        return Expr::BoolLit(true);
                                    }
                                    return Expr::BoolLit(false);
                                }
                                BinOp::Eq => {
                                    return Expr::BoolLit(lb == rb);
                                }
                                BinOp::Neq => {
                                    return Expr::BoolLit(lb != rb);
                                }
                                _ => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            return Expr::Binary(op, Box::new(le), Box::new(re));
        }
        _ => {
        }
    }
    return expr;
}

/// Whether a global's initializer is written into the program's data.
fn lw_is_const_init(expr: Expr) -> bool {
    match expr {
        Expr::IntLit(_) => {
            return true;
        }
        Expr::FloatLit(_) => {
            return true;
        }
        Expr::StringLit(_) => {
            return true;
        }
        Expr::BoolLit(_) => {
            return true;
        }
        Expr::Unary(_, e) => {
            return lw_is_const_init(box_expr_unbox(e));
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// src/lower.rs auto_drop_strs: free the strings that provably die where
/// they are used. The worst case is a leak, never a dangling string.
fn lw_auto_drop_strs(module: & mut IrModule) {
    var has_drop: bool = false;
    var i: i64 = 0;
    while i < module.functions.len() {
        if module.functions.get(i).name == "Str_drop" {
            has_drop = true;
        }
        i = i + 1;
    }
    if !has_drop {
        return;
    }
    i = 0;
    while i < module.functions.len() {
        var entry: IrFunctionEntry = module.functions.get(i);
        var func: IrFunction = entry.func;
        if lw_drop_function_strs(& mut func) {
            entry.func = func;
            module.functions.set(i, entry);
        }
        i = i + 1;
    }
}

fn lw_is_fresh_str(f: & IrFunction, id: i64) -> bool {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Call(name, _, _, _) => {
                    return name == "p_str_concat" || name == "int_to_str";
                }
                _ => {
                    return false;
                }
            }
        }
        OptInst::None => {
            return false;
        }
    }
}

fn lw_is_const_str(f: & IrFunction, id: i64) -> bool {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::ConstStr(_) => {
                    return true;
                }
                _ => {
                    return false;
                }
            }
        }
        OptInst::None => {
            return false;
        }
    }
}

fn lw_reads_str(inst: Inst) -> bool {
    match inst {
        Inst::Call(name, _, _, _) => {
            return name == "p_str_concat" || name == "str_len" || name == "str_byte_at" || name == "str_equal" || name == "str_starts_with" || name == "str_ends_with" || name == "str_contains" || name == "str_find" || name == "str_parse_int";
        }
        Inst::Print(_, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

fn lw_drop_function_strs(f: & mut IrFunction) -> bool {
    var order: Vec<i64> = lw_block_order(f);
    var i: i64 = 0;
    var any: bool = false;
    while i < order.len() && !any {
        any = lw_is_fresh_str(f, order.get(i));
        i = i + 1;
    }
    if !any {
        return false;
    }
    var n: i64 = f.next_value;
    // Per value: position + 1, block, use count, last user + 1, slot,
    // loaded (slot + 1), and per slot: bad, written, last store position + 1
    var pos: Vec<i64> = lw_zeros(n);
    var block_of: Vec<i64> = lw_zeros(n);
    var uses: Vec<i64> = lw_zeros(n);
    var user: Vec<i64> = lw_zeros(n);
    var is_slot: Vec<i64> = lw_zeros(n);
    var loaded: Vec<i64> = lw_zeros(n);
    var bad: Vec<i64> = lw_zeros(n);
    var written: Vec<i64> = lw_zeros(n);
    var last_store: Vec<i64> = lw_zeros(n);
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            block_of.set(ids.get(k), b);
            k = k + 1;
        }
        b = b + 1;
    }
    i = 0;
    while i < order.len() {
        var id: i64 = order.get(i);
        pos.set(id, i + 1);
        match IrFunction_get_inst(f, id) {
            OptInst::Some(inst) => {
                match inst {
                    Inst::Alloca(_, _) => {
                        is_slot.set(id, 1);
                    }
                    _ => {
                    }
                }
                var ops: Vec<i64> = Vec::new();
                peir_inst_operands(inst, & mut ops);
                var o: i64 = 0;
                while o < ops.len() {
                    var op: i64 = ops.get(o);
                    uses.set(op, uses.get(op) + 1);
                    user.set(op, id + 1);
                    o = o + 1;
                }
            }
            OptInst::None => {
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < order.len() {
        var id: i64 = order.get(i);
        match IrFunction_get_inst(f, id) {
            OptInst::Some(inst) => {
                var target: i64 = - 1;
                match inst {
                    Inst::Load(ptr, _) => {
                        if is_slot.get(ptr) != 0 {
                            loaded.set(id, ptr + 1);
                            target = ptr;
                        }
                    }
                    Inst::Store(ptr, value, _) => {
                        if is_slot.get(ptr) != 0 {
                            target = ptr;
                            if lw_is_fresh_str(f, value) && uses.get(value) == 1 {
                                written.set(ptr, 1);
                            } else if !lw_is_const_str(f, value) {
                                bad.set(ptr, 1);
                            }
                            last_store.set(ptr, pos.get(id));
                        }
                    }
                    _ => {
                    }
                }
                var ops: Vec<i64> = Vec::new();
                peir_inst_operands(inst, & mut ops);
                var o: i64 = 0;
                while o < ops.len() {
                    var op: i64 = ops.get(o);
                    if is_slot.get(op) != 0 && op != target {
                        bad.set(op, 1);
                    }
                    if loaded.get(op) != 0 {
                        var slot: i64 = loaded.get(op) - 1;
                        // Read in the same block, before the slot is written again
                        if !lw_reads_str(inst) || block_of.get(id) != block_of.get(op) || last_store.get(slot) > pos.get(op) {
                            bad.set(slot, 1);
                        }
                    }
                    o = o + 1;
                }
            }
            OptInst::None => {
            }
        }
        i = i + 1;
    }
    var kept: Vec<i64> = Vec::new();
    i = 0;
    while i < order.len() {
        var s: i64 = order.get(i);
        if written.get(s) != 0 && bad.get(s) == 0 {
            kept.push(s);
        }
        i = i + 1;
    }
    // Per user: the temporaries it is the last to read (value + 1)
    var temp1: Vec<i64> = lw_zeros(n);
    var temp2: Vec<i64> = lw_zeros(n);
    var any_temp: bool = false;
    i = 0;
    while i < order.len() {
        var id: i64 = order.get(i);
        if lw_is_fresh_str(f, id) && uses.get(id) == 1 {
            var u: i64 = user.get(id) - 1;
            if block_of.get(u) == block_of.get(id) {
                match IrFunction_get_inst(f, u) {
                    OptInst::Some(inst) => {
                        if lw_reads_str(inst) {
                            if temp1.get(u) == 0 {
                                temp1.set(u, id + 1);
                                any_temp = true;
                            } else if temp2.get(u) == 0 {
                                temp2.set(u, id + 1);
                            }
                        }
                    }
                    OptInst::None => {
                    }
                }
            }
        }
        i = i + 1;
    }
    if kept.len() == 0 && !any_temp {
        return false;
    }
    // The string a slot last held, kept apart from the slot, as for Vecs
    var shadows: Vec<i64> = lw_zeros(n);
    var prologue: Vec<i64> = Vec::new();
    i = 0;
    while i < kept.len() {
        var zero: i64 = lw_detached(f, Inst::ConstInt(0, IrType::I64));
        var shadow: i64 = lw_detached(f, Inst::Alloca(IrType::I64, Region::Stack));
        var init: i64 = lw_detached(f, Inst::Store(shadow, zero, OptIrType::None));
        prologue.push(zero);
        prologue.push(shadow);
        prologue.push(init);
        shadows.set(kept.get(i), shadow + 1);
        i = i + 1;
    }
    b = 0;
    while b < f.blocks.len() {
        var blk: BasicBlock = f.blocks.get(b);
        var old: Vec<i64> = blk.instructions;
        var fresh: Vec<i64> = Vec::new();
        if b == 0 {
            fresh = prologue;
        }
        var k: i64 = 0;
        while k < old.len() {
            var id: i64 = old.get(k);
            var done: bool = false;
            match IrFunction_get_inst(f, id) {
                OptInst::Some(inst) => {
                    match inst {
                        Inst::Store(ptr, value, _) => {
                            if shadows.get(ptr) != 0 {
                                var shadow: i64 = shadows.get(ptr) - 1;
                                lw_drop_shadow(f, "Str_drop", shadow, & mut fresh);
                                fresh.push(id);
                                var held: i64 = value;
                                if !lw_is_fresh_str(f, value) {
                                    held = lw_detached(f, Inst::ConstInt(0, IrType::I64));
                                    fresh.push(held);
                                }
                                fresh.push(lw_detached(f, Inst::Store(shadow, held, OptIrType::None)));
                                done = true;
                            }
                        }
                        Inst::Return(_) => {
                            var ki: i64 = 0;
                            while ki < kept.len() {
                                lw_drop_shadow(f, "Str_drop", shadows.get(kept.get(ki)) - 1, & mut fresh);
                                ki = ki + 1;
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
            if !done {
                fresh.push(id);
                if id < n {
                    if temp1.get(id) != 0 {
                        lw_drop_value(f, "Str_drop", temp1.get(id) - 1, & mut fresh);
                    }
                    if temp2.get(id) != 0 {
                        lw_drop_value(f, "Str_drop", temp2.get(id) - 1, & mut fresh);
                    }
                }
            }
            k = k + 1;
        }
        blk.instructions = fresh;
        f.blocks.set(b, blk);
        b = b + 1;
    }
    return true;
}

fn lw_drop_shadow(f: & mut IrFunction, drop_fn: str, shadow: i64, out: & mut Vec<i64>) {
    var old: i64 = lw_detached(f, Inst::Load(shadow, IrType::I64));
    out.push(old);
    lw_drop_value(f, drop_fn, old, out);
}

fn lw_drop_value(f: & mut IrFunction, drop_fn: str, value: i64, out: & mut Vec<i64>) {
    var env: i64 = lw_detached(f, Inst::ConstInt(0, IrType::I64));
    var effects: EffectSet = EffectSet_new();
    EffectSet_add(& mut effects, Effect::Write);
    EffectSet_add(& mut effects, Effect::Alloc);
    var args: Vec<i64> = Vec::new();
    args.push(env);
    args.push(value);
    var call: i64 = lw_detached(f, Inst::Call(drop_fn, args, IrType::Void, effects));
    out.push(env);
    out.push(call);
}

/// A new instruction not yet placed in a block.
fn lw_detached(f: & mut IrFunction, inst: Inst) -> i64 {
    var id: i64 = IrFunction_emit(f, inst);
    var last: i64 = f.current_block_idx;
    var blk: BasicBlock = f.blocks.get(last);
    // SP12: the block is taken out first, so its instruction list has one
    // owner and the pop changes it in place; with the block still in
    // f.blocks the pop copied the whole list (quadratic in a long block)
    f.blocks.set(last, BasicBlock_new(last));
    blk.instructions.pop();
    f.blocks.set(last, blk);
    return id;
}

// --- Lower function (stub - implemented in Part 3) ------------------------

// --- Annotation helpers ---------------------------------------------------

pub fn has_annotation(annotations: Vec<Annotation>, name: str) -> bool {
    var i: i64 = 0;
    while i < annotations.len() {
        if annotations.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn find_annotation(annotations: Vec<Annotation>, name: str) -> OptAnnotation {
    var i: i64 = 0;
    while i < annotations.len() {
        if annotations.get(i).name == name {
            return OptAnnotation::Some(annotations.get(i));
        }
        i = i + 1;
    }
    return OptAnnotation::None;
}

pub enum OptAnnotation {
    Some(Annotation),
    None,
}

// --- BG144: impl methods of one name on one type ---------------------------
//
// An impl method is lowered as `Type_method` whatever its trait, so two
// traits' methods of one name on a type, or an inherent method and a
// trait's, became one function (the last lowered won). The plain name
// `Type_method` stays its first definer's: the inherent method, else the
// first trait impl (in program order) that has it. A trait impl with a
// method whose plain name is taken has all its methods named
// `Type__Trait_method`, and a `dyn Trait` made of that type carries
// `Type__Trait` as its type name (and the module's trait_impls list it), so
// every backend's dispatch (type name + "_" + method) finds them; its
// methods whose plain name nobody has are lowered under that name too. A
// call through a generic bound (`fn f<T: Tr>(t: T) { t.m() }`: the
// instance's `__trait_bound` annotations, mono.fd instantiate) takes the
// bound trait's method. Without a collision nothing changes.

/// "Type::Trait" of each trait impl whose methods are qualified
var g_lw_tq_keys: Vec<str> = Vec::new();
/// "Type::Trait::method" of their methods also lowered as `Type_method`
var g_lw_tq_aliases: Vec<str> = Vec::new();
/// a plain name `Type_method` taken by another definer, its type, and for
/// each: the qualified names of the trait impls' methods of that name and
/// their traits
var g_lw_tq_plains: Vec<str> = Vec::new();
var g_lw_tq_types: Vec<str> = Vec::new();
var g_lw_tq_alts: Vec<Vec<str>> = Vec::new();
var g_lw_tq_alt_traits: Vec<Vec<str>> = Vec::new();
/// [type, trait, type, trait, ...]: the bounds of the function being lowered
var g_lw_tq_bounds: Vec<str> = Vec::new();
/// functions being lowered, one inside another
var g_lw_tq_depth: i64 = 0;

/// Decides which trait impls of `program` have qualified method names.
fn Lowerer_tq_setup(self: & mut Lowerer, program: Program) {
    g_lw_tq_keys = Vec::new();
    g_lw_tq_aliases = Vec::new();
    g_lw_tq_plains = Vec::new();
    g_lw_tq_types = Vec::new();
    g_lw_tq_alts = Vec::new();
    g_lw_tq_alt_traits = Vec::new();
    g_lw_tq_bounds = Vec::new();
    var taken: i64 = HashMap_new();
    var i: i64 = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var j: i64 = 0;
        while j < imp.methods.len() {
            var ik: str = imp.struct_name + "_" + imp.methods.get(j).name;
            HashMap_insert(taken, ik, 1);
            j = j + 1;
        }
        i = i + 1;
    }
    // the same impl listed twice keeps the plain names of before
    var seen: i64 = HashMap_new();
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        var sk: str = ti.type_name + "::" + ti.trait_name;
        var dup: bool = HashMap_contains(seen, sk);
        HashMap_insert(seen, sk, 1);
        var clash: bool = false;
        var j: i64 = 0;
        while j < ti.methods.len() && !dup {
            var ck: str = ti.type_name + "_" + ti.methods.get(j).name;
            if HashMap_contains(taken, ck) {
                clash = true;
            }
            j = j + 1;
        }
        if clash {
            var key: str = ti.type_name + "::" + ti.trait_name;
            g_lw_tq_keys.push(key);
            j = 0;
            while j < ti.methods.len() {
                var mn: str = ti.methods.get(j).name;
                var plain: str = ti.type_name + "_" + mn;
                if HashMap_contains(taken, plain) {
                    var qn: str = ti.type_name + "__" + ti.trait_name + "_" + mn;
                    var pi: i64 = 0;
                    var at: i64 = - 1;
                    while pi < g_lw_tq_plains.len() {
                        if at < 0 && g_lw_tq_plains.get(pi) == plain {
                            at = pi;
                        }
                        pi = pi + 1;
                    }
                    if at < 0 {
                        g_lw_tq_plains.push(plain);
                        g_lw_tq_types.push(ti.type_name);
                        var na: Vec<str> = Vec::new();
                        g_lw_tq_alts.push(na);
                        var nt: Vec<str> = Vec::new();
                        g_lw_tq_alt_traits.push(nt);
                        at = g_lw_tq_plains.len() - 1;
                    }
                    var alts: Vec<str> = g_lw_tq_alts.get(at);
                    alts.push(qn);
                    g_lw_tq_alts.set(at, alts);
                    var trs: Vec<str> = g_lw_tq_alt_traits.get(at);
                    trs.push(ti.trait_name);
                    g_lw_tq_alt_traits.set(at, trs);
                } else {
                    HashMap_insert(taken, plain, 1);
                    g_lw_tq_aliases.push(key + "::" + mn);
                }
                j = j + 1;
            }
        } else {
            j = 0;
            while j < ti.methods.len() {
                var tk: str = ti.type_name + "_" + ti.methods.get(j).name;
                HashMap_insert(taken, tk, 1);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    HashMap_drop(taken);
    HashMap_drop(seen);
}

/// The prefix of trait impl (`type_name`, `trait_name`)'s method names and
/// its dyn values' type name: `Type__Trait` when it is qualified, else the
/// type's name.
fn lw_tq_prefix(type_name: str, trait_name: str) -> str {
    if g_lw_tq_keys.len() > 0 && lw_c_str_vec_contains(g_lw_tq_keys, type_name + "::" + trait_name) {
        return type_name + "__" + trait_name;
    }
    return type_name;
}

/// Whether method `method` of qualified trait impl (`type_name`,
/// `trait_name`) is also lowered under its plain name.
fn lw_tq_aliased(type_name: str, trait_name: str, method: str) -> bool {
    return g_lw_tq_aliases.len() > 0 && lw_c_str_vec_contains(g_lw_tq_aliases, type_name + "::" + trait_name + "::" + method);
}

/// A method call's name `mangled` (`Type_method`): the bound trait's
/// qualified method when the function being lowered has a bound of that
/// type with a trait whose method of that name is qualified, else itself.
fn lw_tq_resolve(mangled: str) -> str {
    if g_lw_tq_plains.len() == 0 || g_lw_tq_bounds.len() == 0 {
        return mangled;
    }
    var pi: i64 = 0;
    while pi < g_lw_tq_plains.len() {
        if g_lw_tq_plains.get(pi) == mangled {
            var ty: str = g_lw_tq_types.get(pi);
            var alts: Vec<str> = g_lw_tq_alts.get(pi);
            var trs: Vec<str> = g_lw_tq_alt_traits.get(pi);
            var bi: i64 = 0;
            while bi + 1 < g_lw_tq_bounds.len() {
                if g_lw_tq_bounds.get(bi) == ty {
                    var ai: i64 = 0;
                    while ai < alts.len() {
                        if trs.get(ai) == g_lw_tq_bounds.get(bi + 1) {
                            return alts.get(ai);
                        }
                        ai = ai + 1;
                    }
                }
                bi = bi + 2;
            }
            return mangled;
        }
        pi = pi + 1;
    }
    return mangled;
}

/// [type, trait, ...] of `func`'s `__trait_bound` annotations (mono.fd).
fn lw_tq_func_bounds(func: Func) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < func.annotations.len() {
        var a: Annotation = func.annotations.get(i);
        if a.name == "__trait_bound" && a.args.len() == 2 {
            out.push(a.args.get(0));
            out.push(a.args.get(1));
        }
        i = i + 1;
    }
    return out;
}

// --- Lower function -------------------------------------------------------

pub fn Lowerer_lower_func(self: & mut Lowerer, func: Func) {
    if g_irc_on {
        var irc_key: i64 = irc_fn_key(func);
        var irc_bytes: Vec<i64> = irc_lookup(irc_key, func.name);
        if irc_bytes.len() > 0 {
            var rr: ArBuf = arbuf_new(irc_bytes);
            var cached_fn: IrFunction = irc_replay(& mut rr, & mut self.module, self);
            if rr.ok && cached_fn.name == func.name {
                var ri: i64 = 0;
                while ri < g_irc_rtypes.len() {
                    // (a tuple too: a struct of its shape, its layout
                    // registered by Lowerer_rc_type_index)
                    var _rix: i64 = Lowerer_rc_type_index(self, g_irc_rtypes.get(ri));
                    ri = ri + 1;
                }
                g_irc_rtypes = Vec::new();
                Lowerer_register_ret_tuple(self, func.ret_ty);
                // its tuple literals' layouts, from their names
                Lowerer_irc_tuple_layouts(self, cached_fn);
                irc_reintern(& mut self.module, cached_fn);
                IrModule_add_function(& mut self.module, cached_fn);
                return;
            }
        }
        var irc_before: i64 = self.module.functions.len();
        var irc_own_before: i64 = self.own_types.len();
        Lowerer_lower_func_uncached(self, func);
        var irc_types: Vec<Type> = Vec::new();
        var ti: i64 = irc_own_before;
        while ti < self.own_types.len() {
            irc_types.push(self.own_types.get(ti).ty);
            ti = ti + 1;
        }
        var irc_spawned: Vec<IrFunction> = Vec::new();
        var si: i64 = irc_before;
        while si < self.module.functions.len() {
            irc_spawned.push(self.module.functions.get(si).func);
            si = si + 1;
        }
        // SP10: the first function of this name, through fn_index (a scan of
        // every function per lowered function was quadratic)
        var ci: i64 = IrModule_fn_pos(& self.module, func.name);
        if ci >= 0 {
            irc_record(irc_key, self.module.functions.get(ci).func, irc_spawned, irc_types);
        }
        return;
    }
    Lowerer_lower_func_uncached(self, func);
}

fn Lowerer_lower_func_uncached(self: & mut Lowerer, func: Func) {
    var saved_body: Vec<Stmt> = self.cur_body;
    var saved_lists: Vec<Vec<Stmt>> = self.fr_lists;
    var saved_idx: Vec<i64> = self.fr_idx;
    // A function lowered inside another (a closure, a continuation) has
    // ownership state of its own
    var saved_slots: Vec<OwnSlot> = self.own_slots;
    var saved_marks: Vec<i64> = self.own_marks;
    var saved_temps: Vec<OwnTemp> = self.own_temps;
    var saved_lslots: Vec<i64> = self.own_loop_slots;
    var saved_ltemps: Vec<i64> = self.own_loop_temps;
    var saved_prologue: Vec<i64> = self.own_prologue;
    var saved_txn: Vec<LwTxn> = self.txn_stack;
    self.txn_stack = Vec::new();
    var saved_nomove: Vec<str> = self.own_nomove;
    var saved_on: bool = self.own_on;
    var saved_ret: Type = self.own_ret_ty;
    var saved_raw: bool = self.own_raw_ret;
    var saved_has_defer: bool = self.cur_has_defer;
    // BG28: Lowerer_lower_func_body empties the defer stack and the AST
    // parameter types; the enclosing function's own come back after it
    // (a closure dropped the `defer`s of the function that made it)
    var saved_defers: Vec<DeferEntry> = self.defer_stack;
    var saved_param_types: Vec<StringTypeEntry> = self.current_func_param_types;
    self.cur_body = func.body;
    self.cur_has_defer = lw_has_defer(func.body);
    // OW7: the variables this function takes a reference to (Lowerer_last_use)
    var saved_ref_taken: i64 = g_lw_ref_taken;
    g_lw_ref_taken = lw_ref_taken_of(func.body);
    var base: Vec<Vec<Stmt>> = Vec::new();
    base.push(func.body);
    var base_idx: Vec<i64> = Vec::new();
    base_idx.push(0);
    self.fr_lists = base;
    self.fr_idx = base_idx;
    var saved_lu: Vec<i64> = self.fr_lu;
    var base_lu: Vec<i64> = Vec::new();
    base_lu.push(HashMap_new());
    self.fr_lu = base_lu;
    self.rest_lv = - 1;
    // DB1: what is lowered outside any statement (parameter copies, the
    // drops and return at the end) takes the body's first line, so every
    // instruction has one and the line table covers the whole function
    var saved_fn_line: i64 = self.cur_line;
    if func.body.len() > 0 && stmt_line(func.body.get(0)) > 0 {
        self.cur_line = stmt_line(func.body.get(0));
    }
    // CA8: a function lowered inside another (a closure, a continuation, a
    // parallel branch) leaves only its own timeout blocks at a return
    var saved_to_base: i64 = self.to_base;
    self.to_base = self.to_toks.len();
    // BG144: the bounds a call of a trait's method follows (a closure or a
    // continuation keeps its enclosing function's)
    var saved_tq_bounds: Vec<str> = g_lw_tq_bounds;
    var tq_fb: Vec<str> = lw_tq_func_bounds(func);
    if tq_fb.len() > 0 || g_lw_tq_depth == 0 {
        g_lw_tq_bounds = tq_fb;
    }
    g_lw_tq_depth = g_lw_tq_depth + 1;
    Lowerer_lower_func_body(self, func);
    g_lw_tq_depth = g_lw_tq_depth - 1;
    g_lw_tq_bounds = saved_tq_bounds;
    self.to_base = saved_to_base;
    self.cur_line = saved_fn_line;
    self.cur_body = saved_body;
    self.cur_has_defer = saved_has_defer;
    self.defer_stack = saved_defers;
    self.current_func_param_types = saved_param_types;
    if g_lw_ref_taken != 0 {
        HashMap_drop(g_lw_ref_taken);
    }
    g_lw_ref_taken = saved_ref_taken;
    self.fr_lists = saved_lists;
    self.fr_idx = saved_idx;
    var lui: i64 = 0;
    while lui < self.fr_lu.len() {
        HashMap_drop(self.fr_lu.get(lui));
        lui = lui + 1;
    }
    self.fr_lu = saved_lu;
    // rest_of is left as the inner function's list
    self.rest_lv = - 1;
    self.own_slots = saved_slots;
    self.own_marks = saved_marks;
    self.own_temps = saved_temps;
    self.own_loop_slots = saved_lslots;
    self.own_loop_temps = saved_ltemps;
    self.own_prologue = saved_prologue;
    self.txn_stack = saved_txn;
    self.own_nomove = saved_nomove;
    self.own_on = saved_on;
    self.own_ret_ty = saved_ret;
    self.own_raw_ret = saved_raw;
}

fn Lowerer_lower_func_body(self: & mut Lowerer, func: Func) {
    Lowerer_register_ret_tuple(self, func.ret_ty);
    var ret_ty: IrType = Lowerer_lower_type_sret(self, lw_body_ret_type(func));
    var ir_func: IrFunction = IrFunction_new(func.name, ret_ty);
    ir_func.is_interrupt = func.is_interrupt;
    // F29: @interrupt(N) annotation — store the IDT vector number
    ir_func.interrupt_vector = - 1;
    var ai: i64 = 0;
    while ai < func.annotations.len() {
        var ann: Annotation = func.annotations.get(ai);
        if ann.name == "interrupt" {
            if ann.args.len() > 0 {
                var vec_str: str = ann.args.get(0);
                var result: i64 = 0;
                var si: i64 = 0;
                // Check for 0x prefix (hex)
                // (>= 1: a one-digit vector such as @interrupt(3) was read as 0)
                if str_len(vec_str) >= 1 {
                    if str_len(vec_str) >= 2 && str_byte_at(vec_str, 0) == 48 && (str_byte_at(vec_str, 1) == 120 || str_byte_at(vec_str, 1) == 88) {
                        si = 2;
                        while si < str_len(vec_str) {
                            var b: i64 = str_byte_at(vec_str, si);
                            if b >= 48 && b <= 57 {
                                result = result * 16 + (b - 48);
                            } else if b >= 97 && b <= 102 {
                                result = result * 16 + (b - 87);
                            } else if b >= 65 && b <= 70 {
                                result = result * 16 + (b - 55);
                            }
                            si = si + 1;
                        }
                    } else {
                        while si < str_len(vec_str) {
                            var b: i64 = str_byte_at(vec_str, si);
                            if b >= 48 && b <= 57 {
                                result = result * 10 + (b - 48);
                            }
                            si = si + 1;
                        }
                    }
                }
                ir_func.interrupt_vector = result;
            }
        }
        ai = ai + 1;
    }
    ir_func.is_constant_time = has_annotation(func.annotations, "constant_time");
    // CI7: `@export` functions get a C name in a library build
    if has_annotation(func.annotations, "export") && !str_contains(g_ir_exports, "," + func.name + ",") {
        g_ir_exports = g_ir_exports + func.name + ",";
    }
    // LF20: the function holds a secret (it, a parameter, or a local below
    // is @secret / @sensitive): nat_ir wipes its frame when it returns
    ir_func.has_secret = ir_func.is_constant_time || has_annotation(func.annotations, "secret") || has_annotation(func.annotations, "sensitive");
    var lf20_pi: i64 = 0;
    while lf20_pi < func.params.len() {
        if has_annotation(func.params.get(lf20_pi).annotations, "secret") || has_annotation(func.params.get(lf20_pi).annotations, "sensitive") {
            ir_func.has_secret = true;
        }
        lf20_pi = lf20_pi + 1;
    }
    ir_func.is_wrapping = has_annotation(func.annotations, "wrapping");
    ir_func.is_deterministic = has_annotation(func.annotations, "deterministic");
    ir_func.is_crashfree = has_annotation(func.annotations, "crashfree");
    ir_func.is_no_alloc = has_annotation(func.annotations, "no-alloc") || has_annotation(func.annotations, "medical");
    ir_func.is_medical = has_annotation(func.annotations, "medical");
    ir_func.is_kernel = has_annotation(func.annotations, "kernel") || has_annotation(func.annotations, "shader");
    ir_func.is_simd = has_annotation(func.annotations, "simd");

    // Parse @gas(N) annotation
    match find_annotation(func.annotations, "gas") {
        OptAnnotation::Some(kann) => {
            if kann.args.len() > 0 {
                match str_parse_u64(kann.args.get(0)) {
                    OptU64::Some(v) => {
                        ir_func.gas_limit = OptU64::Some(v);
                    }
                    OptU64::None => {
                    }
                }
            }
        }
        OptAnnotation::None => {
        }
    }

    // Parse @kernel/@shader workgroup size
    if ir_func.is_kernel {
        var kern_ann: OptAnnotation = find_annotation(func.annotations, "kernel");
        match kern_ann {
            OptAnnotation::Some(_) => {
            }
            OptAnnotation::None => {
                kern_ann = find_annotation(func.annotations, "shader");
            }
        }
        match kern_ann {
            OptAnnotation::Some(kann) => {
                if kann.args.len() > 0 {
                    // Join args with "," and parse as [x,y,z] or x,y,z
                    var args_str: str = "";
                    var ai: i64 = 0;
                    while ai < kann.args.len() {
                        if ai > 0 {
                            args_str = args_str + ",";
                        }
                        args_str = args_str + kann.args.get(ai);
                        ai = ai + 1;
                    }
                    // Simple parsing: split by ',' and parse each part
                    var parts: Vec<str> = str_split_char(args_str, 44);
                    // 44 = ','
                    if parts.len() >= 3 {
                        match str_parse_u64(str_trim(parts.get(0))) {
                            OptU64::Some(x) => {
                                match str_parse_u64(str_trim(parts.get(1))) {
                                    OptU64::Some(y) => {
                                        match str_parse_u64(str_trim(parts.get(2))) {
                                            OptU64::Some(z) => {
                                                ir_func.workgroup_size = Vec::new();
                                                ir_func.workgroup_size.push(x);
                                                ir_func.workgroup_size.push(y);
                                                ir_func.workgroup_size.push(z);
                                            }
                                            OptU64::None => {
                                            }
                                        }
                                    }
                                    OptU64::None => {
                                    }
                                }
                            }
                            OptU64::None => {
                            }
                        }
                    } else if parts.len() == 1 {
                        match str_parse_u64(str_trim(parts.get(0))) {
                            OptU64::Some(x) => {
                                ir_func.workgroup_size = Vec::new();
                                ir_func.workgroup_size.push(x);
                                ir_func.workgroup_size.push(1);
                                ir_func.workgroup_size.push(1);
                            }
                            OptU64::None => {
                            }
                        }
                    }
                }
            }
            OptAnnotation::None => {
            }
        }
    }

    // SRET parameter for struct-returning functions
    var is_struct_ret: bool = false;
    match ret_ty {
        IrType::Struct(_) => {
            is_struct_ret = true;
        }
        // An array result goes out through the hidden parameter too: an
        // array value is a pointer to its data, so a plain return handed
        // the caller a pointer into the callee's dead frame (BG126)
        IrType::Array(_, _) => {
            is_struct_ret = true;
        }
        _ => {
            is_struct_ret = false;
        }
    }

    if is_struct_ret {
        var sret_ty: IrType = IrType::Ptr(Box::new(ret_ty));
        var sret_meta: ValueMeta = ValueMeta_new(sret_ty);
        sret_meta.region = Lowerer_current_region(self);
        var sret_val: i64 = IrFunction_new_value(& mut ir_func, sret_meta);
        ir_func.params.push(ValueIdType_new(sret_val, sret_ty));
        self.current_sret = OptValueId::Some(sret_val);
    } else {
        self.current_sret = OptValueId::None;
    }

    // __env parameter (for uniform CallPtr calling convention)
    var env_meta: ValueMeta = ValueMeta_new(IrType::Ptr(Box::new(IrType::U8)));
    env_meta.region = Lowerer_current_region(self);
    var env_val: i64 = IrFunction_new_value(& mut ir_func, env_meta);
    ir_func.params.push(ValueIdType_new(env_val, IrType::Ptr(Box::new(IrType::U8))));
    IrFunction_bind_local(& mut ir_func, "__env", env_val);

    // User parameters
    var pb_names: Vec<str> = Vec::new();
    var pb_vals: Vec<i64> = Vec::new();
    var pb_tys: Vec<IrType> = Vec::new();
    var i: i64 = 0;
    while i < func.params.len() {
        var param: Param = func.params.get(i);
        var raw_ty: IrType = Lowerer_lower_type(self, param.ty);
        var is_linear: bool = Lowerer_is_linear_ir_type(self, raw_ty);
        // Struct params are passed as pointers (by-ref)
        var ir_ty: IrType = raw_ty;
        match raw_ty {
            IrType::Struct(_) => {
                ir_ty = IrType::Ptr(Box::new(raw_ty));
            }
            // M21: an array value is the pointer to its data (as a declared
            // `[T; N]` variable's slot holds it); the body copies it below
            IrType::Array(_, _) => {
                ir_ty = IrType::Ptr(Box::new(raw_ty));
            }
            _ => {
                ir_ty = raw_ty;
            }
        }
        var meta: ValueMeta = ValueMeta_new(ir_ty);
        meta.region = Lowerer_current_region(self);
        meta.is_linear = is_linear;
        // A reference parameter says so (LF1): `&mut T` is the only way the
        // function writes the caller's T, `&T` never does
        match param.ty {
            Type::Ref(_, pmut) => {
                if pmut {
                    meta.borrow_kind = BorrowKind::Mut;
                } else {
                    meta.borrow_kind = BorrowKind::Shared;
                }
            }
            _ => {
            }
        }
        var val: i64 = IrFunction_new_value(& mut ir_func, meta);
        ir_func.params.push(ValueIdType_new(val, ir_ty));
        IrFunction_bind_local(& mut ir_func, param.name, val);
        pb_names.push(param.name);
        pb_vals.push(val);
        pb_tys.push(ir_ty);
        i = i + 1;
    }

    // Set as current function
    var prev_func: IrFunction = self.current_func;
    var prev_has_func: bool = self.has_current_func;
    // Save the name separately - struct assignment can corrupt string fields
    // in the Fides interpreter.
    var func_name_saved: str = func.name;
    self.current_func = ir_func;
    // Re-assign the name to ensure it's valid
    self.current_func.name = func_name_saved;
    self.has_current_func = true;
    self.current_block = 0;
    self.current_func.current_block_idx = 0;

    // Clear per-function state
    var empty_allocas: Vec<StringValueIdEntry> = Vec::new();
    self.allocas = empty_allocas;
    var empty_alloca_types: Vec<I64IrTypeEntry> = Vec::new();
    self.alloca_types = empty_alloca_types;
    var empty_var_ast_types: Vec<StringTypeEntry> = Vec::new();
    self.var_ast_types = empty_var_ast_types;
    Lowerer_ix_reset_tables(self);
    var empty_defer_stack: Vec<DeferEntry> = Vec::new();
    self.defer_stack = empty_defer_stack;
    var empty_param_types: Vec<StringTypeEntry> = Vec::new();
    self.current_func_param_types = empty_param_types;
    // Ownership (proposal 0004): this body's values are counted; the
    // function's own scope holds the parameters it copies
    self.own_slots = Vec::new();
    self.own_marks = Vec::new();
    self.own_temps = Vec::new();
    self.own_loop_slots = Vec::new();
    self.own_loop_temps = Vec::new();
    self.own_prologue = Vec::new();
    self.own_nomove = Vec::new();
    self.own_on = LOWER_RC;
    self.own_ret_ty = lw_body_ret_type(func);
    self.own_raw_ret = str_starts_with(func.name, "String_") || str_starts_with(func.name, "p_str_");
    Lowerer_rc_scope_open(self);

    // Register parameter AST types (after clearing per-function state)
    var pi: i64 = 0;
    while pi < func.params.len() {
        var pparam: Param = func.params.get(pi);
        Lowerer_insert_var_ast_type(self, pparam.name, pparam.ty);
        pi = pi + 1;
    }

    // Save AST parameter types
    i = 0;
    while i < func.params.len() {
        var p: Param = func.params.get(i);
        Lowerer_insert_param_type(self, p.name, p.ty);
        i = i + 1;
    }

    // M21: an array parameter arrives as the pointer to the caller's data;
    // the body works on a copy of its own, so writes to it do not reach the
    // caller (by-value, §8.1)
    var api: i64 = 0;
    while api < func.params.len() && api < pb_vals.len() {
        var ap: Param = func.params.get(api);
        var ap_raw: IrType = Lowerer_lower_type(self, ap.ty);
        match ap_raw {
            IrType::Array(_, _) => {
                var ap_buf: i64 = Lowerer_emit_inst(self, Inst::Alloca(ap_raw, Lowerer_current_region(self)));
                var ap_words: i64 = (IrModule_type_size(& self.module, ap_raw) + 7) / 8;
                var ap_args: Vec<i64> = Vec::new();
                ap_args.push(Lowerer_rc_env(self));
                ap_args.push(Lowerer_rc_as_i64(self, ap_buf));
                ap_args.push(Lowerer_rc_as_i64(self, pb_vals.get(api)));
                ap_args.push(Lowerer_emit_inst(self, Inst::ConstInt(ap_words, IrType::I64)));
                Lowerer_emit_inst(self, Inst::Call("p_copy_words", ap_args, IrType::Void, lw_rc_eff()));
                IrFunction_bind_local(& mut self.current_func, ap.name, ap_buf);
                pb_vals.set(api, ap_buf);
            }
            _ => {
            }
        }
        api = api + 1;
    }

    // Parameters assigned in the body need an alloca: a bare SSA binding
    // cannot be updated across block boundaries (a `while` loop would
    // re-read the entry value forever). Spill them in the entry block.
    var assigned_params: Vec<str> = Vec::new();
    collect_assign_targets(func.body, & mut assigned_params);
    // CM3: the retired copy-on-write (LOWER_COW) took a share of a by-value
    // Vec parameter the body changes here; ownership copies it below.
    // Ownership (proposal 0004): parameters are borrowed; one the body
    // assigns or changes is copied first, an owner of its own dropped when
    // the function ends (copy-on-write makes the copy O(1))
    var owned_params: Vec<str> = Vec::new();
    if LOWER_RC {
        var rpi: i64 = 0;
        while rpi < func.params.len() && rpi < pb_vals.len() {
            var rp: Param = func.params.get(rpi);
            var rk: i64 = Lowerer_rc_kind(self, rp.ty);
            if rk != RC_NONE && (lw_c_str_vec_contains(assigned_params, rp.name) || cow_first_change(func.body, rp.name, 0) > 0) {
                var mine: i64 = Lowerer_rc_dup(self, pb_vals.get(rpi), rp.ty);
                if rk == RC_MEM {
                    // The copy is the parameter's struct from here on
                    IrFunction_bind_local(& mut self.current_func, rp.name, mine);
                    pb_vals.set(rpi, mine);
                    Lowerer_rc_add_slot(self, mine, rp.ty);
                    // A tuple parameter the body assigns: the copy is its
                    // slot, held inline as a tuple variable's (its word
                    // slot took a whole tuple's copy). BG82: a struct one
                    // too, as `var p: P = p;` holds it: its slot of a
                    // pointer to the copy took the new value's pointer,
                    // which nothing dropped (the copy was dropped instead)
                    if lw_c_str_vec_contains(assigned_params, rp.name) {
                        Lowerer_insert_alloca(self, rp.name, mine);
                        Lowerer_insert_alloca_type(self, mine, Lowerer_rc_mem_ir(self, rp.ty));
                        owned_params.push(rp.name);
                    }
                } else {
                    var pslot: i64 = Lowerer_rc_new_slot(self, pb_tys.get(rpi), rp.ty);
                    Lowerer_emit_inst(self, Inst::Store(pslot, mine, OptIrType::None));
                    Lowerer_insert_alloca(self, rp.name, pslot);
                    Lowerer_insert_alloca_type(self, pslot, pb_tys.get(rpi));
                    Lowerer_rc_add_slot(self, pslot, rp.ty);
                    owned_params.push(rp.name);
                }
            }
            rpi = rpi + 1;
        }
    }
    var pbi: i64 = 0;
    while pbi < pb_names.len() {
        // a tuple parameter (of plain elements) the body assigns: a copy
        // held inline, as a tuple variable's
        var sp_tes: Vec<Type> = Vec::new();
        if lw_c_str_vec_contains(assigned_params, pb_names.get(pbi)) && !lw_c_str_vec_contains(owned_params, pb_names.get(pbi)) {
            var spi: i64 = 0;
            while spi < func.params.len() {
                if func.params.get(spi).name == pb_names.get(pbi) {
                    sp_tes = Lowerer_rc_tuple_elems(self, func.params.get(spi).ty);
                }
                spi = spi + 1;
            }
        }
        if sp_tes.len() > 0 {
            var tslot_ty: IrType = Lowerer_key_tuple_ir(self, sp_tes);
            var tslot: i64 = Lowerer_emit_inst(self, Inst::Alloca(tslot_ty, Lowerer_current_region(self)));
            var tsrc: i64 = Lowerer_rc_tuple_ptr(self, pb_vals.get(pbi), Type::Tuple(sp_tes));
            Lowerer_emit_inst(self, Inst::Store(tslot, tsrc, OptIrType::Some(tslot_ty)));
            Lowerer_insert_alloca(self, pb_names.get(pbi), tslot);
            Lowerer_insert_alloca_type(self, tslot, tslot_ty);
        } else if lw_c_str_vec_contains(assigned_params, pb_names.get(pbi)) && !lw_c_str_vec_contains(owned_params, pb_names.get(pbi)) {
            var slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(pb_tys.get(pbi), Lowerer_current_region(self)));
            var _st: i64 = Lowerer_emit_inst(self, Inst::Store(slot, pb_vals.get(pbi), OptIrType::None));
            Lowerer_insert_alloca(self, pb_names.get(pbi), slot);
            Lowerer_insert_alloca_type(self, slot, pb_tys.get(pbi));
        }
        pbi = pbi + 1;
    }
    // LF20: the @secret / @sensitive parameters' values (and the slot of one
    // the body assigns) seed the values nat_ir keeps in registers first
    var lf20_sp: i64 = 0;
    while lf20_sp < func.params.len() && lf20_sp < pb_vals.len() {
        var lfp: Param = func.params.get(lf20_sp);
        if has_annotation(lfp.annotations, "secret") || has_annotation(lfp.annotations, "sensitive") {
            self.current_func.secret_values.push(pb_vals.get(lf20_sp));
            if lw_c_str_vec_contains(assigned_params, lfp.name) || lw_c_str_vec_contains(owned_params, lfp.name) {
                var lf20_slot: i64 = - 1;
                match Lowerer_lookup_alloca(self, lfp.name) {
                    OptValueId::Some(lf20_a) => {
                        lf20_slot = lf20_a;
                    }
                    OptValueId::None => {
                    }
                }
                if lf20_slot >= 0 {
                    self.current_func.secret_values.push(lf20_slot);
                }
            }
        }
        lf20_sp = lf20_sp + 1;
    }

    // @audit annotation: emit log calls at function entry/exit
    var is_audited: bool = has_annotation(func.annotations, "audit");
    if is_audited {
        // Entry log with parameter values:
        // [AUDIT] enter func_name(param1=val1, param2=val2)
        var header: str = "[AUDIT] enter " + func.name + "(";
        var n_logged: i64 = 0;
        var api: i64 = 0;
        while api < func.params.len() {
            var ap: Param = func.params.get(api);
            match Lowerer_lookup_local(self, ap.name) {
                OptValueId::Some(pval) => {
                    if n_logged > 0 {
                        header = header + ", ";
                    }
                    header = header + ap.name + "=";
                    var hdr: i64 = Lowerer_emit_inst(self, Inst::ConstStr(header));
                    var _ph: i64 = Lowerer_emit_inst(self, Inst::Print(hdr, IrType::Ptr(Box::new(IrType::U8))));
                    var _pv: i64 = Lowerer_emit_inst(self, Inst::Print(pval, Lowerer_lower_type(self, ap.ty)));
                    header = "";
                    n_logged = n_logged + 1;
                }
                OptValueId::None => {
                }
            }
            api = api + 1;
        }
        if n_logged == 0 {
            var entry_msg: i64 = Lowerer_emit_inst(self, Inst::ConstStr("[AUDIT] enter " + func.name + "\n"));
            var _p: i64 = Lowerer_emit_inst(self, Inst::Print(entry_msg, IrType::Ptr(Box::new(IrType::U8))));
        } else {
            var close: i64 = Lowerer_emit_inst(self, Inst::ConstStr(")\n"));
            var _pc: i64 = Lowerer_emit_inst(self, Inst::Print(close, IrType::Ptr(Box::new(IrType::U8))));
        }
        // Exit log via defer
        var exit_stmts: Vec<Stmt> = Vec::new();
        var exit_args: Vec<Expr> = Vec::new();
        exit_args.push(Expr::StringLit("[AUDIT] exit " + func.name + "\n"));
        exit_stmts.push(Stmt::Expr(Expr::Call("print", exit_args), 0));
        self.defer_stack.push(DeferEntry_new(exit_stmts, - 1, - 1));
    }

    if func.name == "main" {
        var gi: i64 = 0;
        while gi < self.global_inits.len() {
            var ginit: GlobalVar = self.global_inits.get(gi);
            Lowerer_lower_stmt(self, Stmt::Assign(ginit.name, AssignOp::Assign, ginit.init, 0));
            gi = gi + 1;
        }
    }

    // Lower the function body
    var last_expr_val: OptValueId = OptValueId::None;
    // L3A: a body with a top-level `do` goes through lower_stmts, which
    // captures the statements after the `do` in a continuation closure.
    var has_do: bool = false;
    i = 0;
    while i < func.body.len() {
        match func.body.get(i) {
            Stmt::Do(_, _, _, _) => {
                has_do = true;
            }
            _ => {
            }
        }
        i = i + 1;
    }
    if has_do {
        Lowerer_lower_stmts(self, func.body);
        i = func.body.len();
    } else {
        i = 0;
    } while i < func.body.len() {
        var stmt: Stmt = func.body.get(i);
        var smark: i64 = self.own_temps.len();
        self.rest_of = func.body;
        self.rest_from = i + 1;
        // SP12: fr_lists' level 0 is func.body (Lowerer_lower_func_uncached)
        self.rest_lv = 0;
        if self.fr_idx.len() > 0 {
            self.fr_idx.set(0, i);
        }
        // DB1: the statement's own line, as Lowerer_lower_stmt gives it: a
        // top-level expression statement (`println(x);`) and the body's
        // value are lowered here, not through it, and took the body's
        // first line; its temporaries' drops below keep it too
        var body_saved_line: i64 = self.cur_line;
        var body_sl: i64 = stmt_line(stmt);
        if body_sl > 0 {
            self.cur_line = body_sl;
        }
        match stmt {
            Stmt::Expr(expr, _) => {
                var val: i64 = Lowerer_lower_expr(self, expr);
                last_expr_val = OptValueId::Some(val);
            }
            Stmt::Handle(_, _, _) => {
                last_expr_val = OptValueId::None;
                if i + 1 == func.body.len() {
                    last_expr_val = Lowerer_lower_tail_handle(self, stmt);
                } else {
                    Lowerer_lower_stmt(self, stmt);
                }
            }
            _ => {
                last_expr_val = OptValueId::None;
                // `fn max(a, b) -> i64 { if a > b { a } else { b } }`: a
                // trailing if/else or match is the function's value
                var as_value: bool = i + 1 == func.body.len() && !ir_type_eq(self.current_func.ret_ty, IrType::Void);
                match self.current_sret {
                    OptValueId::Some(_) => {
                        as_value = false;
                    }
                    OptValueId::None => {
                    }
                }
                var lowered: bool = false;
                if as_value {
                    var single: Vec<Stmt> = Vec::new();
                    single.push(stmt);
                    match lw_value_tail(single).get(0) {
                        Stmt::Expr(tail_e, _) => {
                            last_expr_val = OptValueId::Some(Lowerer_lower_expr(self, tail_e));
                            lowered = true;
                        }
                        _ => {
                        }
                    }
                }
                if !lowered {
                    Lowerer_lower_stmt(self, stmt);
                }
            }
        }
        // The statement's temporaries end with it; the body's value is
        // handed to the caller (proposal 0004)
        if i + 1 == func.body.len() && self.own_on && !ir_type_eq(self.current_func.ret_ty, IrType::Void) {
            match last_expr_val {
                OptValueId::Some(lv) => {
                    last_expr_val = OptValueId::Some(Lowerer_rc_own_value(self, lv, self.own_ret_ty));
                }
                OptValueId::None => {
                }
            }
        }
        Lowerer_rc_flush(self, smark);
        self.cur_line = body_saved_line;
        i = i + 1;
    }

    // Ensure the function ends with a return
    if !Lowerer_current_block_has_terminator(self) {
        // Emit drops, defers, and persist saves
        Lowerer_emit_drops(self);
        Lowerer_emit_defers(self);
        Lowerer_emit_persist_saves(self);
        Lowerer_rc_drop_all(self);

        match self.current_sret {
            OptValueId::Some(_) => {
                // Struct-returning function: copy struct data to sret, return void
                match last_expr_val {
                    OptValueId::Some(sret_val) => {
                        Lowerer_emit_sret_copy(self, sret_val);
                    }
                    OptValueId::None => {
                    }
                }
                Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
            }
            OptValueId::None => {
                // Non-struct return
                if ir_type_eq(self.current_func.ret_ty, IrType::Void) {
                    Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
                } else {
                    match last_expr_val {
                        OptValueId::Some(ret_val) => {
                            var coerced: i64 = Lowerer_coerce_return(self, ret_val);
                            Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(coerced)));
                        }
                        OptValueId::None => {
                            // Implicit return of 0 for non-void functions
                            var ret_ty2: IrType = self.current_func.ret_ty;
                            var zero_meta: ValueMeta = ValueMeta_new(ret_ty2);
                            zero_meta.region = Lowerer_current_region(self);
                            var zid: i64 = IrFunction_new_value(& mut self.current_func, zero_meta);
                            var zero_inst: Inst;
                            match ret_ty2 {
                                IrType::F32 => {
                                    zero_inst = Inst::ConstFloat(0.0, ret_ty2);
                                }
                                IrType::F64 => {
                                    zero_inst = Inst::ConstFloat(0.0, ret_ty2);
                                }
                                IrType::Bool => {
                                    zero_inst = Inst::ConstBool(false);
                                }
                                _ => {
                                    zero_inst = Inst::ConstInt(0, ret_ty2);
                                }
                            }
                            IrFunction_set_inst(& mut self.current_func, zid, zero_inst);
                            // Add to current block
                            self.current_func.blocks.get(self.current_block).instructions.push(zid);
                            Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(zid)));
                        }
                    }
                }
            }
        }
    }

    // Compute function effects from all instructions
    var func_effects: EffectSet = EffectSet_new();
    var fi: i64 = 0;
    while fi < self.current_func.insts.len() {
        // CS4: the instruction read in place, not copied
        var inst_eff: EffectSet = inst_effects(& self.current_func.insts.get(fi).inst);
        EffectSet_add_all(& mut func_effects, & inst_eff);
        fi = fi + 1;
    }
    self.current_func.effects = func_effects;

    // Store function effects in module
    self.module.function_effects.push(StringEffectSetEntry_new(func.name, func_effects));

    // Store the function in the module (replacing pre-registered entry)
    // Save the name first to avoid string corruption when moving the struct.
    var finished_name: str = self.current_func.name;
    Lowerer_rc_finish_func(self);
    IrModule_replace_function_named(& mut self.module, self.current_func, finished_name);
}

// --- Lower statements -----------------------------------------------------

/// The slot a `handle` in this function leaves its value in, or -1.
fn Lowerer_handle_target(self: & Lowerer) -> i64 {
    if self.handle_slot >= 0 && self.handle_slot_fn == self.current_func.name {
        return self.handle_slot;
    }
    return - 1;
}

/// src/lower.rs lower_tail_handle: a `handle` ending a function gives the
/// function its value.
fn Lowerer_lower_tail_handle(self: & mut Lowerer, stmt: Stmt) -> OptValueId {
    var is_void: bool = false;
    match self.current_func.ret_ty {
        IrType::Void => {
            is_void = true;
        }
        _ => {
        }
    }
    var has_sret: bool = false;
    match self.current_sret {
        OptValueId::Some(_) => {
            has_sret = true;
        }
        OptValueId::None => {
        }
    }
    if is_void || has_sret {
        Lowerer_lower_stmt(self, stmt);
        return OptValueId::None;
    }
    var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
    Lowerer_emit_inst(self, Inst::Store(slot, zero, OptIrType::None));
    var outer_fn: str = self.handle_slot_fn;
    var outer: i64 = self.handle_slot;
    self.handle_slot_fn = self.current_func.name;
    self.handle_slot = slot;
    Lowerer_lower_stmt(self, stmt);
    self.handle_slot_fn = outer_fn;
    self.handle_slot = outer;
    return OptValueId::Some(Lowerer_emit_inst(self, Inst::Load(slot, IrType::I64)));
}

pub fn Lowerer_lower_stmts(self: & mut Lowerer, stmts: Vec<Stmt>) {
    self.fr_lists.push(stmts);
    self.fr_idx.push(0);
    self.fr_lu.push(HashMap_new());
    // A block: its variables are dropped at its end (proposal 0004)
    Lowerer_rc_scope_open(self);
    Lowerer_lower_stmts_in(self, stmts);
    Lowerer_rc_scope_close(self);
    self.fr_lists.pop();
    self.fr_idx.pop();
    if self.fr_lu.len() > 0 {
        HashMap_drop(self.fr_lu.get(self.fr_lu.len() - 1));
        self.fr_lu.pop();
    }
    // rest_of may still be the list just left: no level holds it now
    if self.rest_lv >= self.fr_lu.len() {
        self.rest_lv = - 1;
    }
}

// --- A `do` nested in a block of a handle ---------------------------------
// Reference section 9.4: `cont` is the rest of the handle block. A `do` at
// the handle block's own level captures it (Lowerer_lower_stmts_in); one in
// an `if`, a loop or a `match` of the block captured only the rest of that
// inner block, so a handler that does not resume ran and the handle block
// went on after the inner block (`if true { do Check.reject(1); }
// println("valid");` printed both lines). Such a handler now leaves the
// handle block: a jump to the handle's end, in the function the handle is
// lowered in, after dropping what the block made (Lowerer_hx_abort); or,
// in the continuation that holds the rest of the handle block, a return
// from it. One entry per effect_handler_stack level (the Handle arm of
// Lowerer_lower_stmt_inner pushes and pops both).
var g_lw_hx_fn: Vec<str> = Vec::new();
// the handle's end block, -1 when its block has no nested `do`
var g_lw_hx_exit: Vec<i64> = Vec::new();
// own_slots / own_temps lengths, open regions and timeout blocks at its start
var g_lw_hx_slots: Vec<i64> = Vec::new();
var g_lw_hx_temps: Vec<i64> = Vec::new();
var g_lw_hx_rg: Vec<i64> = Vec::new();
var g_lw_hx_to: Vec<i64> = Vec::new();
// The continuations that hold the rest of a handle block (made at a `do`
// of the block's own level): leaving the block from one is returning.
var g_lw_hx_direct_conts: Vec<str> = Vec::new();
// Set just before lowering a list whose own `do`s capture the rest of the
// handle block (the handle body, or the body of such a continuation);
// Lowerer_lower_stmts_in takes it at entry.
var g_lw_hx_direct_next: bool = false;

/// Whether `stmts` holds a `do` below its own level (in an `if`, a loop, a
/// `match`, an inner block); `top` is false for an inner list.
fn lw_hx_nested_do(stmts: Vec<Stmt>, top: bool) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        if lw_hx_stmt_nested_do(stmts.get(i), top) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn lw_hx_stmt_nested_do(s: Stmt, top: bool) -> bool {
    match s {
        Stmt::Do(_, _, _, _) => {
            return !top;
        }
        Stmt::If(c, t, e, _) => {
            if lw_hx_expr_nested_do(c) || lw_hx_nested_do(t, false) {
                return true;
            }
            match e {
                OptStmts::Some(es) => {
                    return lw_hx_nested_do(es, false);
                }
                OptStmts::None => {
                }
            }
            return false;
        }
        Stmt::While(_, b, _) => {
            return lw_hx_nested_do(b, false);
        }
        Stmt::For(_, _, b, _) => {
            return lw_hx_nested_do(b, false);
        }
        Stmt::Loop(b, _) => {
            return lw_hx_nested_do(b, false);
        }
        Stmt::Match(_, arms, _) => {
            var ai: i64 = 0;
            while ai < arms.len() {
                if lw_hx_nested_do(arms.get(ai).body, false) {
                    return true;
                }
                ai = ai + 1;
            }
            return false;
        }
        Stmt::Handle(b, _, _) => {
            return lw_hx_nested_do(b, false);
        }
        Stmt::Unsafe(b, _) => {
            return lw_hx_nested_do(b, false);
        }
        Stmt::Sandbox(b, _) => {
            return lw_hx_nested_do(b, false);
        }
        Stmt::Txn(b, _) => {
            return lw_hx_nested_do(b, false);
        }
        Stmt::Expr(e, _) => {
            return lw_hx_expr_nested_do(e);
        }
        _ => {
        }
    }
    return false;
}

fn lw_hx_expr_nested_do(e: Expr) -> bool {
    match e {
        Expr::If(_, t, el) => {
            if lw_hx_nested_do(t, false) {
                return true;
            }
            match el {
                OptStmts::Some(es) => {
                    return lw_hx_nested_do(es, false);
                }
                OptStmts::None => {
                }
            }
            return false;
        }
        Expr::Block(b) => {
            return lw_hx_nested_do(b, false);
        }
        Expr::Match(_, arms) => {
            var ai: i64 = 0;
            while ai < arms.len() {
                if lw_hx_nested_do(arms.get(ai).body, false) {
                    return true;
                }
                ai = ai + 1;
            }
            return false;
        }
        _ => {
        }
    }
    return false;
}

/// Whether a handler body may resume its continuation: a `resume` in it,
/// or something not looked into (a closure, a statement kind not listed
/// below). Only a handler that cannot resume ends the handle block.
fn lw_hx_may_resume(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        if lw_hx_stmt_may_resume(stmts.get(i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn lw_hx_stmt_may_resume(s: Stmt) -> bool {
    match s {
        Stmt::Resume(_, _, _) => {
            return true;
        }
        Stmt::If(c, t, e, _) => {
            if lw_hx_expr_may_resume(c) || lw_hx_may_resume(t) {
                return true;
            }
            match e {
                OptStmts::Some(es) => {
                    return lw_hx_may_resume(es);
                }
                OptStmts::None => {
                }
            }
            return false;
        }
        Stmt::While(c, b, _) => {
            return lw_hx_expr_may_resume(c) || lw_hx_may_resume(b);
        }
        Stmt::For(_, it, b, _) => {
            return lw_hx_expr_may_resume(it) || lw_hx_may_resume(b);
        }
        Stmt::Loop(b, _) => {
            return lw_hx_may_resume(b);
        }
        Stmt::Defer(b, _) => {
            return lw_hx_may_resume(b);
        }
        Stmt::Unsafe(b, _) => {
            return lw_hx_may_resume(b);
        }
        Stmt::Sandbox(b, _) => {
            return lw_hx_may_resume(b);
        }
        Stmt::Txn(b, _) => {
            return lw_hx_may_resume(b);
        }
        Stmt::Match(e, arms, _) => {
            if lw_hx_expr_may_resume(e) {
                return true;
            }
            var ai: i64 = 0;
            while ai < arms.len() {
                if lw_hx_may_resume(arms.get(ai).body) {
                    return true;
                }
                ai = ai + 1;
            }
            return false;
        }
        Stmt::Handle(b, hs, _) => {
            if lw_hx_may_resume(b) {
                return true;
            }
            var hi: i64 = 0;
            while hi < hs.len() {
                if lw_hx_may_resume(hs.get(hi).body) {
                    return true;
                }
                hi = hi + 1;
            }
            return false;
        }
        Stmt::Expr(e, _) => {
            return lw_hx_expr_may_resume(e);
        }
        Stmt::Let(_, _, e, _, _, _, _) => {
            return lw_hx_expr_may_resume(e);
        }
        Stmt::LetTuple(_, e, _, _) => {
            return lw_hx_expr_may_resume(e);
        }
        Stmt::Assign(_, _, e, _) => {
            return lw_hx_expr_may_resume(e);
        }
        Stmt::IndexAssign(_, ix, _, e, _) => {
            return lw_hx_expr_may_resume(ix) || lw_hx_expr_may_resume(e);
        }
        Stmt::DerefAssign(p, _, e, _) => {
            return lw_hx_expr_may_resume(p) || lw_hx_expr_may_resume(e);
        }
        Stmt::FieldAssign(o, _, _, e, _) => {
            return lw_hx_expr_may_resume(o) || lw_hx_expr_may_resume(e);
        }
        Stmt::Return(oe, _) => {
            match oe {
                OptBoxExpr::Some(re) => {
                    return lw_hx_expr_may_resume(lw_box_expr_unbox(re));
                }
                OptBoxExpr::None => {
                }
            }
            return false;
        }
        Stmt::Break(oe, _) => {
            match oe {
                OptBoxExpr::Some(be) => {
                    return lw_hx_expr_may_resume(lw_box_expr_unbox(be));
                }
                OptBoxExpr::None => {
                }
            }
            return false;
        }
        Stmt::Continue(_) => {
            return false;
        }
        Stmt::Do(_, _, _, _) => {
            return false;
        }
        Stmt::LetUninit(_, _, _, _) => {
            return false;
        }
        Stmt::Use(_, _, _) => {
            return false;
        }
        _ => {
        }
    }
    return true;
}

fn lw_hx_expr_may_resume(e: Expr) -> bool {
    match e {
        Expr::If(c, t, el) => {
            if lw_hx_expr_may_resume(lw_box_expr_unbox(c)) || lw_hx_may_resume(t) {
                return true;
            }
            match el {
                OptStmts::Some(es) => {
                    return lw_hx_may_resume(es);
                }
                OptStmts::None => {
                }
            }
            return false;
        }
        Expr::Block(b) => {
            return lw_hx_may_resume(b);
        }
        Expr::TryBlock(b) => {
            return lw_hx_may_resume(b);
        }
        Expr::ComptimeBlock(b) => {
            return lw_hx_may_resume(b);
        }
        Expr::Match(x, arms) => {
            if lw_hx_expr_may_resume(lw_box_expr_unbox(x)) {
                return true;
            }
            var ai: i64 = 0;
            while ai < arms.len() {
                if lw_hx_may_resume(arms.get(ai).body) {
                    return true;
                }
                ai = ai + 1;
            }
            return false;
        }
        Expr::Closure(_, _, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// After the body of the handler at handle level `lv` ran for a `do` that
/// is not at the handle block's own level (`direct` false): a handler that
/// cannot resume ends the handle block. In the handle's own function the
/// block's temporaries and variables are dropped (as a `break` drops a
/// loop body's) and control jumps to the handle's end; in the continuation
/// holding the rest of the block it returns from it. Anywhere else (a
/// closure lowered inside the block, a region or a timeout block opened
/// since the handle began) the old behaviour stays: the block goes on.
fn Lowerer_hx_abort(self: & mut Lowerer, lv: i64, h_body: Vec<Stmt>) {
    if lv < 0 || lv >= g_lw_hx_exit.len() {
        return;
    }
    if lw_hx_may_resume(h_body) || Lowerer_current_block_has_terminator(self) {
        return;
    }
    // BG197: in a continuation lowered in place, to its resume point (as
    // the continuation closure returned)
    if Lowerer_hx_abort_in_place(self, lv) {
        return;
    }
    if g_lw_hx_fn.get(lv) == self.current_func.name {
        val exit_bb: i64 = g_lw_hx_exit.get(lv);
        if exit_bb < 0 {
            return;
        }
        if Lowerer_rg_open(self) != g_lw_hx_rg.get(lv) || self.to_toks.len() != g_lw_hx_to.get(lv) {
            return;
        }
        if self.own_on {
            Lowerer_rc_drop_temps(self, g_lw_hx_temps.get(lv));
            Lowerer_rc_drop_slots(self, g_lw_hx_slots.get(lv));
        }
        Lowerer_emit_terminator(self, Inst::Jump(exit_bb));
        return;
    }
    if lw_c_str_vec_contains(g_lw_hx_direct_conts, self.current_func.name) {
        Lowerer_lower_stmt(self, Stmt::Return(OptBoxExpr::Some(Box::new(Expr::IntLit(0))), 0));
    }
}

fn Lowerer_lower_stmts_in(self: & mut Lowerer, stmts: Vec<Stmt>) {
    // L3A: at a `do` statement the remaining statements become the
    // continuation: a closure passed to the handler as `cont`, which the
    // handler runs with resume(cont, value) (src/lower.rs lower_stmts).
    // `hx_direct`: this list is a handle block's own level (or the rest of
    // one), so a `do` here captures the rest of the handle block
    val hx_direct: bool = g_lw_hx_direct_next;
    g_lw_hx_direct_next = false;
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Do(effect, op, args, _line) => {
                var remaining: Vec<Stmt> = Vec::new();
                var ri: i64 = i + 1;
                while ri < stmts.len() {
                    remaining.push(stmts.get(ri));
                    ri = ri + 1;
                }
                Lowerer_lower_do_with_continuation(self, effect, op, args, remaining, hx_direct);
                return;
            }
            _ => {
            }
        }
        self.rest_of = stmts;
        self.rest_from = i + 1;
        // SP12: Lowerer_lower_stmts pushed `stmts` as the top level
        self.rest_lv = self.fr_lu.len() - 1;
        if self.fr_idx.len() > 0 {
            self.fr_idx.set(self.fr_idx.len() - 1, i);
        }
        Lowerer_lower_stmt(self, stmts.get(i));
        i = i + 1;
    }
}

/// L3A: `do Effect.op(args)` with continuation capture: the handler body
/// runs with its params bound to the args and `cont` bound to a closure
/// over `remaining`.
fn Lowerer_lower_do_with_continuation(self: & mut Lowerer, effect: str, op: str, args: Vec<Expr>, remaining: Vec<Stmt>, direct: bool) {
    var found: bool = false;
    var found_lv: i64 = - 1;
    var h_params: Vec<str> = Vec::new();
    var h_body: Vec<Stmt> = Vec::new();
    var stack_idx: i64 = self.effect_handler_stack.len() - 1;
    while stack_idx >= 0 && !found {
        var handlers: Vec<EffectHandler> = self.effect_handler_stack.get(stack_idx);
        var hi: i64 = 0;
        while hi < handlers.len() && !found {
            var h: EffectHandler = handlers.get(hi);
            if h.effect == effect && h.op == op {
                found = true;
                found_lv = stack_idx;
                h_params = h.params;
                h_body = h.body;
            }
            hi = hi + 1;
        }
        stack_idx = stack_idx - 1;
    }
    if !found {
        // No handler: evaluate the args, then run the rest as usual.
        var ai: i64 = 0;
        while ai < args.len() {
            var _v: i64 = Lowerer_lower_expr(self, args.get(ai));
            ai = ai + 1;
        }
        var ri: i64 = 0;
        while ri < remaining.len() {
            Lowerer_lower_stmt(self, remaining.get(ri));
            ri = ri + 1;
        }
        return;
    }
    var arg_vals: Vec<i64> = Vec::new();
    var ai2: i64 = 0;
    while ai2 < args.len() {
        arg_vals.push(Lowerer_lower_expr(self, args.get(ai2)));
        ai2 = ai2 + 1;
    }
    // BG197: a continuation the handler only resumes runs in place (each
    // `resume(cont, v)` lowers `remaining` there: Lowerer_hx_resume_inline);
    // otherwise it is a closure
    var in_place: bool = Lowerer_hx_cont_inline(self, h_body);
    var cont_val: i64 = - 1;
    if !in_place {
        cont_val = Lowerer_create_continuation_hx(self, remaining, direct);
    }
    // what the handler's names are at the `do`, for `remaining`
    var hide: Vec<str> = Vec::new();
    var hslot: Vec<i64> = Vec::new();
    var hlocal: Vec<i64> = Vec::new();
    var pi: i64 = 0;
    while pi < arg_vals.len() {
        if pi < h_params.len() {
            hide.push(h_params.get(pi));
            match Lowerer_lookup_alloca(self, h_params.get(pi)) {
                OptValueId::Some(ds) => {
                    hslot.push(ds);
                }
                OptValueId::None => {
                    hslot.push(- 1);
                }
            }
            match Lowerer_lookup_local(self, h_params.get(pi)) {
                OptValueId::Some(dl) => {
                    hlocal.push(dl);
                }
                OptValueId::None => {
                    hlocal.push(- 1);
                }
            }
        }
        pi = pi + 1;
    }
    pi = 0;
    while pi < arg_vals.len() {
        if pi < h_params.len() {
            var slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
            Lowerer_insert_alloca_type(self, slot, IrType::I64);
            var _s: i64 = Lowerer_emit_inst(self, Inst::Store(slot, arg_vals.get(pi), OptIrType::None));
            Lowerer_insert_alloca(self, h_params.get(pi), slot);
            Lowerer_bind_local(self, h_params.get(pi), slot);
        }
        pi = pi + 1;
    }
    if !in_place {
        var cont_slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Opaque("closure"), Lowerer_current_region(self)));
        Lowerer_insert_alloca_type(self, cont_slot, IrType::Opaque("closure"));
        var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(cont_slot, cont_val, OptIrType::None));
        Lowerer_insert_alloca(self, "cont", cont_slot);
        Lowerer_bind_local(self, "cont", cont_slot);
    }
    var inl_on: i64 = 0;
    if in_place {
        inl_on = 1;
    }
    var inl_direct: i64 = 0;
    if direct {
        inl_direct = 1;
    }
    lw_hx_inl_push(self.current_func.name, remaining, inl_direct, inl_on, hide, hslot, hlocal, found_lv);
    Lowerer_lower_stmts(self, h_body);
    lw_hx_inl_pop();
    // a `do` below the handle block's own level: a handler that does not
    // resume ends the handle block (reference section 9.4)
    if !direct {
        Lowerer_hx_abort(self, found_lv, h_body);
    }
}

/// Lowerer_create_continuation for the statements after a `do`. When the
/// `do` is at a handle block's own level (`direct`), they are the rest of
/// the handle block: the continuation's own `do`s are direct too, and a
/// handler that ends the block from inside it returns from it (g_lw_hx_*).
fn Lowerer_create_continuation_hx(self: & mut Lowerer, remaining: Vec<Stmt>, direct: bool) -> i64 {
    if direct && remaining.len() > 0 {
        // the name Lowerer_create_continuation gives it
        g_lw_hx_direct_conts.push("__cont_" + int_to_str(self.continuation_counter + 1));
        var has_do: bool = false;
        var i: i64 = 0;
        while i < remaining.len() {
            match remaining.get(i) {
                Stmt::Do(_, _, _, _) => {
                    has_do = true;
                }
                _ => {
                }
            }
            i = i + 1;
        }
        // Lowerer_lower_func lowers a body with a `do` of its own level
        // through Lowerer_lower_stmts, which takes the flag
        g_lw_hx_direct_next = has_do;
    }
    var cont_val: i64 = Lowerer_create_continuation(self, remaining);
    g_lw_hx_direct_next = false;
    return cont_val;
}

/// L3A: closure `(env, __resume_val: i64) -> i64` running `remaining`
/// (a no-op returning 0 when nothing follows the `do`), capturing the
/// in-scope variables it uses.
fn Lowerer_create_continuation(self: & mut Lowerer, remaining: Vec<Stmt>) -> i64 {
    // A counter, not functions.len(): a nested `do` lowers its own
    // continuation before the enclosing one is added to the module.
    self.continuation_counter = self.continuation_counter + 1;
    var body: Vec<Stmt> = remaining;
    var closure_name: str = "__cont_" + int_to_str(self.continuation_counter);
    if remaining.len() == 0 {
        body = Vec::new();
        body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::IntLit(0))), 0));
        closure_name = "__cont_noop_" + int_to_str(self.continuation_counter);
    }
    var param_names: Vec<str> = Vec::new();
    param_names.push("__resume_val");
    var captures: Vec<StringTypeEntry> = Lowerer_find_captures(self, body, param_names);

    var saved_captures: Vec<ClosureCapture> = self.current_captures;
    var empty_captures: Vec<ClosureCapture> = Vec::new();
    self.current_captures = empty_captures;
    var ci: i64 = 0;
    while ci < captures.len() {
        var cap: StringTypeEntry = captures.get(ci);
        self.current_captures.push(ClosureCapture_new(cap.key, ci + 1, cap.val));
        ci = ci + 1;
    }

    var params: Vec<Param> = Vec::new();
    params.push(Param_new("__resume_val", Type::I64, false));
    var cont_func: Func = Func_new_full(closure_name, params, Type::I64, body, false);

    var saved_func: IrFunction = self.current_func;
    var saved_has_func: bool = self.has_current_func;
    var saved_allocas: Vec<StringValueIdEntry> = self.allocas;
    var saved_alloca_types: Vec<I64IrTypeEntry> = self.alloca_types;
    var saved_var_ast_types: Vec<StringTypeEntry> = self.var_ast_types;
    var saved_block: i64 = self.current_block;
    var saved_sret: OptValueId = self.current_sret;

    Lowerer_lower_func(self, cont_func);

    self.current_func = saved_func;
    self.has_current_func = saved_has_func;
    self.allocas = saved_allocas;
    self.alloca_types = saved_alloca_types;
    self.var_ast_types = saved_var_ast_types;
    Lowerer_ix_reset_tables(self);
    self.current_block = saved_block;
    self.current_sret = saved_sret;
    self.current_captures = saved_captures;

    if remaining.len() == 0 {
        return Lowerer_make_fn_env(self, closure_name, Vec::new());
    }
    return Lowerer_make_fn_env(self, closure_name, captures);
}

// --- BG197: a continuation run in place ------------------------------------
// The continuation was a closure over copies of the variables (the
// captures of Lowerer_create_continuation): its writes were lost (`do
// E.tick(1); count = 3;` left count 0 after the handle), a `return` in it
// left only `__cont_N` (the function went on and returned something else),
// and a `do` in a loop whose handler resumes never ended (`i = i + 1` was
// the rest of the loop body, done on a copy). When the handler uses `cont`
// only as `resume(cont, v)` statements outside its loops and closures
// (Lowerer_hx_cont_inline), each such resume lowers the statements after
// the `do` right there, in the function the handle is in: the same
// variables, a `return` that returns, a `break` that leaves the user's
// loop. A handler that does anything else with `cont` keeps the closure.
// One entry per `do` whose handler is being lowered: its function, the
// statements after it, whether it is at the handle block's own level, and
// 1 when its continuation runs in place. The handler's own names (its
// parameters, bound over the handle block's) are hidden again while the
// statements after the `do` are lowered: the do-site slot (or -1) and
// local value (or -1) of each, in g_lw_hx_inl_hide*.
var g_lw_hx_inl_fn: Vec<str> = Vec::new();
var g_lw_hx_inl_rest: Vec<Vec<Stmt>> = Vec::new();
var g_lw_hx_inl_direct: Vec<i64> = Vec::new();
var g_lw_hx_inl_on: Vec<i64> = Vec::new();
var g_lw_hx_inl_hide: Vec<Vec<str>> = Vec::new();
var g_lw_hx_inl_hslot: Vec<Vec<i64>> = Vec::new();
var g_lw_hx_inl_hlocal: Vec<Vec<i64>> = Vec::new();
// the handle level (effect_handler_stack) of the `do`'s handler
var g_lw_hx_inl_lv: Vec<i64> = Vec::new();

/// BG197: whether a handler body's `cont` can run in place: it is named
/// only as the first argument of `resume` statements, none of them inside
/// a loop of the handler (a `break` of the rest would leave that loop), a
/// closure, a nested handle or a statement not looked into.
fn Lowerer_hx_cont_inline(self: & Lowerer, h_body: Vec<Stmt>) -> bool {
    // `cont` as a value (resume statements are not walked)
    var free: Vec<str> = Vec::new();
    var locals: Vec<str> = Vec::new();
    Lowerer_collect_free_vars(self, h_body, & mut free, & mut locals);
    if lw_c_str_vec_contains(free, "cont") {
        return false;
    }
    return lw_hx_resume_plain(h_body);
}

fn lw_hx_resume_plain(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        if !lw_hx_stmt_resume_plain(stmts.get(i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn lw_hx_stmt_resume_plain(s: Stmt) -> bool {
    match s {
        Stmt::Resume(c, v, _) => {
            match c {
                Expr::Ident(cn) => {
                    if cn != "cont" {
                        return false;
                    }
                }
                _ => {
                    return false;
                }
            }
            return !lw_hx_expr_may_resume(v);
        }
        Stmt::If(c, t, e, _) => {
            if lw_hx_expr_may_resume(c) || !lw_hx_resume_plain(t) {
                return false;
            }
            match e {
                OptStmts::Some(es) => {
                    return lw_hx_resume_plain(es);
                }
                OptStmts::None => {
                }
            }
            return true;
        }
        Stmt::Match(e, arms, _) => {
            if lw_hx_expr_may_resume(e) {
                return false;
            }
            var ai: i64 = 0;
            while ai < arms.len() {
                if !lw_hx_resume_plain(arms.get(ai).body) {
                    return false;
                }
                ai = ai + 1;
            }
            return true;
        }
        _ => {
        }
    }
    // anything else: no resume in it at all (lw_hx_stmt_may_resume is true
    // for a closure and for what it does not look into)
    return !lw_hx_stmt_may_resume(s);
}

/// BG197: `resume(cont, value)` of a continuation that runs in place (the
/// top entry of g_lw_hx_inl_*, made in this function): `value` is
/// evaluated, then the statements after the `do` are lowered here. false
/// when the resume is a call of the continuation closure.
fn Lowerer_hx_resume_inline(self: & mut Lowerer, cont: Expr, value: Expr) -> bool {
    var n: i64 = g_lw_hx_inl_fn.len();
    if n == 0 {
        return false;
    }
    match cont {
        Expr::Ident(cn) => {
            if cn != "cont" {
                return false;
            }
        }
        _ => {
            return false;
        }
    }
    if g_lw_hx_inl_on.get(n - 1) == 0 || g_lw_hx_inl_fn.get(n - 1) != self.current_func.name {
        return false;
    }
    // the continuation does not read the value (`__resume_val`)
    var _rv: i64 = Lowerer_lower_expr(self, value);
    var e_fn: str = g_lw_hx_inl_fn.get(n - 1);
    var e_rest: Vec<Stmt> = g_lw_hx_inl_rest.get(n - 1);
    var e_direct: i64 = g_lw_hx_inl_direct.get(n - 1);
    var e_hide: Vec<str> = g_lw_hx_inl_hide.get(n - 1);
    var e_hslot: Vec<i64> = g_lw_hx_inl_hslot.get(n - 1);
    var e_hlocal: Vec<i64> = g_lw_hx_inl_hlocal.get(n - 1);
    var e_lv: i64 = g_lw_hx_inl_lv.get(n - 1);
    // a resume in the statements after the `do` is an enclosing handler's
    lw_hx_inl_pop();
    var sa: i64 = self.allocas.len();
    var sv: i64 = self.var_ast_types.len();
    var sl: i64 = self.current_func.locals.len();
    var hi: i64 = 0;
    while hi < e_hide.len() {
        Lowerer_insert_alloca(self, e_hide.get(hi), e_hslot.get(hi));
        if e_hlocal.get(hi) >= 0 {
            Lowerer_bind_local(self, e_hide.get(hi), e_hlocal.get(hi));
        }
        hi = hi + 1;
    }
    // where the handler goes on after the resume; a handler of a `do` in
    // the rest that ends the handle block (Lowerer_hx_abort) jumps here,
    // as it returned from the continuation closure
    var rx: i64 = Lowerer_new_block(self);
    g_lw_hx_rx_fn.push(self.current_func.name);
    g_lw_hx_rx_lv.push(e_lv);
    g_lw_hx_rx_block.push(rx);
    g_lw_hx_rx_slots.push(self.own_slots.len());
    g_lw_hx_rx_temps.push(self.own_temps.len());
    g_lw_hx_rx_rg.push(Lowerer_rg_open(self));
    g_lw_hx_rx_to.push(self.to_toks.len());
    Lowerer_hx_lower_rest(self, e_rest, e_direct != 0);
    g_lw_hx_rx_fn.pop();
    g_lw_hx_rx_lv.pop();
    g_lw_hx_rx_block.pop();
    g_lw_hx_rx_slots.pop();
    g_lw_hx_rx_temps.pop();
    g_lw_hx_rx_rg.pop();
    g_lw_hx_rx_to.pop();
    self.allocas.truncate(sa);
    self.var_ast_types.truncate(sv);
    self.current_func.locals.truncate(sl);
    lw_hx_inl_push(e_fn, e_rest, e_direct, 1, e_hide, e_hslot, e_hlocal, e_lv);
    // (a rest that returned or left a loop: what the handler does after the
    // resume is reached only from such a handler)
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(rx));
    }
    Lowerer_set_current_block(self, rx);
    return true;
}

// BG197: the resume points of the continuations being lowered in place
// (Lowerer_hx_resume_inline): function, handle level, block, and the
// own_slots / own_temps lengths, open regions and timeout blocks there.
var g_lw_hx_rx_fn: Vec<str> = Vec::new();
var g_lw_hx_rx_lv: Vec<i64> = Vec::new();
var g_lw_hx_rx_block: Vec<i64> = Vec::new();
var g_lw_hx_rx_slots: Vec<i64> = Vec::new();
var g_lw_hx_rx_temps: Vec<i64> = Vec::new();
var g_lw_hx_rx_rg: Vec<i64> = Vec::new();
var g_lw_hx_rx_to: Vec<i64> = Vec::new();

/// BG197: Lowerer_hx_abort inside a continuation lowered in place for
/// handle level `lv`: what the rest made is dropped and control goes to the
/// resume point (the handler that resumed goes on). false when there is no
/// such resume point here.
fn Lowerer_hx_abort_in_place(self: & mut Lowerer, lv: i64) -> bool {
    var i: i64 = g_lw_hx_rx_block.len() - 1;
    while i >= 0 {
        if g_lw_hx_rx_lv.get(i) == lv && g_lw_hx_rx_fn.get(i) == self.current_func.name {
            if Lowerer_rg_open(self) != g_lw_hx_rx_rg.get(i) || self.to_toks.len() != g_lw_hx_rx_to.get(i) {
                return false;
            }
            if self.own_on {
                Lowerer_rc_drop_temps(self, g_lw_hx_rx_temps.get(i));
                Lowerer_rc_drop_slots(self, g_lw_hx_rx_slots.get(i));
            }
            Lowerer_emit_terminator(self, Inst::Jump(g_lw_hx_rx_block.get(i)));
            return true;
        }
        i = i - 1;
    }
    return false;
}

fn lw_hx_inl_push(f: str, rest: Vec<Stmt>, direct: i64, on: i64, hide: Vec<str>, hslot: Vec<i64>, hlocal: Vec<i64>, lv: i64) {
    g_lw_hx_inl_fn.push(f);
    g_lw_hx_inl_rest.push(rest);
    g_lw_hx_inl_direct.push(direct);
    g_lw_hx_inl_on.push(on);
    g_lw_hx_inl_hide.push(hide);
    g_lw_hx_inl_hslot.push(hslot);
    g_lw_hx_inl_hlocal.push(hlocal);
    g_lw_hx_inl_lv.push(lv);
}

fn lw_hx_inl_pop() {
    g_lw_hx_inl_fn.pop();
    g_lw_hx_inl_rest.pop();
    g_lw_hx_inl_direct.pop();
    g_lw_hx_inl_on.pop();
    g_lw_hx_inl_hide.pop();
    g_lw_hx_inl_hslot.pop();
    g_lw_hx_inl_hlocal.pop();
    g_lw_hx_inl_lv.pop();
}

/// BG197: the statements after a `do`, lowered in place. At the handle
/// block's own level (`direct`) a `do` among them captures the rest of the
/// block again; when the handle gives its function its value, the block's
/// last expression is that value (as the Handle arm stores it).
fn Lowerer_hx_lower_rest(self: & mut Lowerer, rest: Vec<Stmt>, direct: bool) {
    if rest.len() == 0 {
        return;
    }
    var hslot: i64 = Lowerer_handle_target(self);
    if direct && hslot >= 0 {
        match rest.get(rest.len() - 1) {
            Stmt::Expr(last, _) => {
                var head: Vec<Stmt> = Vec::new();
                var head_do: bool = false;
                var k: i64 = 0;
                while k + 1 < rest.len() {
                    match rest.get(k) {
                        Stmt::Do(_, _, _, _) => {
                            head_do = true;
                        }
                        _ => {
                        }
                    }
                    head.push(rest.get(k));
                    k = k + 1;
                }
                if !head_do {
                    g_lw_hx_direct_next = true;
                    Lowerer_lower_stmts(self, head);
                    g_lw_hx_direct_next = false;
                    if !Lowerer_current_block_has_terminator(self) {
                        var hval: i64 = Lowerer_lower_expr(self, last);
                        Lowerer_emit_inst(self, Inst::Store(hslot, hval, OptIrType::None));
                    }
                    return;
                }
            }
            _ => {
            }
        }
    }
    g_lw_hx_direct_next = direct;
    Lowerer_lower_stmts(self, rest);
    g_lw_hx_direct_next = false;
}

// --- BG199: leaving a `spawn scope` early -----------------------------------
// The function each open `spawn scope` (an entry of scope_executor_stack)
// is lowered in, and the loop depth at its start.
var g_lw_ss_fn: Vec<str> = Vec::new();
var g_lw_ss_loops: Vec<i64> = Vec::new();

/// BG199: a `return` or `?` (`loop_exit` false) leaves every `spawn scope`
/// of this function it is in, a `break` or `continue` (`loop_exit` true)
/// those opened inside the innermost loop: their tasks are joined first,
/// as at the block's end (reference §10.4, CA6). Only the fall-through end
/// joined: an early return left with the tasks still running.
fn Lowerer_ss_join_exits(self: & mut Lowerer, loop_exit: bool) {
    var i: i64 = self.scope_executor_stack.len() - 1;
    while i >= 0 {
        if i < g_lw_ss_fn.len() && g_lw_ss_fn.get(i) == self.current_func.name {
            if !loop_exit || g_lw_ss_loops.get(i) >= self.loop_stack.len() {
                var _j: i64 = Lowerer_emit_inst(self, Inst::Call("p_executor_run_all", lw_c_vec1_i64(self.scope_executor_stack.get(i)), IrType::I64, EffectSet_new()));
            }
        }
        i = i - 1;
    }
}

// --- BG200: the type of an awaited future ---------------------------------

/// The `Future<T>` type `e` (an `await` operand) has, or None. It was found
/// only for a call, a method call (by the method's name alone) and a
/// variable; an element (`fs.get(i)`), an `if` or a `match` gave the raw
/// word.
fn Lowerer_await_fut_type(self: & Lowerer, e: Expr) -> OptType {
    match e {
        Expr::Call(fut_callee, _) => {
            return Lowerer_lookup_func_ret_type(self, fut_callee);
        }
        Expr::Ident(fut_var) => {
            return Lowerer_lookup_var_ast_type(self, fut_var);
        }
        Expr::MethodCall(_, fut_method, _) => {
            // an element of a Vec or map of futures, a struct's method
            var mt: Type = Lowerer_rc_expr_type(self, e);
            if lw_is_future_type(mt) {
                return OptType::Some(mt);
            }
            // an async method (LG14): its declared Future<T>
            return Lowerer_lookup_func_ret_type(self, fut_method);
        }
        Expr::If(_, then_b, _) => {
            match if_branch_tail_expr(then_b) {
                OptExpr::Some(te) => {
                    return Lowerer_await_fut_type(self, te);
                }
                OptExpr::None => {
                }
            }
            return OptType::None;
        }
        Expr::Match(_, arms) => {
            var ai: i64 = 0;
            while ai < arms.len() {
                match if_branch_tail_expr(arms.get(ai).body) {
                    OptExpr::Some(te) => {
                        var at: OptType = Lowerer_await_fut_type(self, te);
                        match at {
                            OptType::Some(att) => {
                                if lw_is_future_type(att) {
                                    return at;
                                }
                            }
                            OptType::None => {
                            }
                        }
                    }
                    OptExpr::None => {
                    }
                }
                ai = ai + 1;
            }
            return OptType::None;
        }
        Expr::Block(bs) => {
            match if_branch_tail_expr(bs) {
                OptExpr::Some(be) => {
                    return Lowerer_await_fut_type(self, be);
                }
                OptExpr::None => {
                }
            }
            return OptType::None;
        }
        _ => {
        }
    }
    var t: Type = Lowerer_rc_expr_type(self, e);
    if lw_is_future_type(t) {
        return OptType::Some(t);
    }
    return OptType::None;
}

fn lw_is_future_type(t: Type) -> bool {
    match t {
        Type::Generic(n, a) => {
            return n == "Future" && a.len() > 0;
        }
        _ => {
        }
    }
    return false;
}

/// `&str`: a borrowed string (release M11), lowered as the string itself.
fn lw_is_borrowed_str(t: Type) -> bool {
    match t {
        Type::Ref(inner, is_mut) => {
            return !is_mut && lw_is_str_type(box_type_unbox(inner));
        }
        _ => {
        }
    }
    return false;
}

fn lw_is_str_type(t: Type) -> bool {
    match t {
        Type::Str => {
            return true;
        }
        Type::Named(n) => {
            return n == "str";
        }
        _ => {
        }
    }
    return false;
}

fn lw_is_int_type(t: Type) -> bool {
    match t {
        Type::I8 => {
            return true;
        }
        Type::I16 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        Type::I64 => {
            return true;
        }
        Type::U8 => {
            return true;
        }
        Type::U16 => {
            return true;
        }
        Type::U32 => {
            return true;
        }
        Type::U64 => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

fn lw_ir_int_type(t: IrType) -> bool {
    match t {
        IrType::I8 => {
            return true;
        }
        IrType::I16 => {
            return true;
        }
        IrType::I32 => {
            return true;
        }
        IrType::I64 => {
            return true;
        }
        IrType::U8 => {
            return true;
        }
        IrType::U16 => {
            return true;
        }
        IrType::U32 => {
            return true;
        }
        IrType::U64 => {
            return true;
        }
        IrType::Bool => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// Whether a HashMap receiver has integer keys: from its IR type arguments,
/// else from the declared type of the variable or field it is.
fn Lowerer_map_has_int_keys(self: & Lowerer, receiver: Box<Expr>, recv_ty: IrType) -> bool {
    match recv_ty {
        IrType::Generic(gn, gargs) => {
            if gn == "HashMap" && gargs.len() > 0 {
                return lw_ir_int_type(gargs.get(0));
            }
        }
        _ => {
        }
    }
    var at: Type = Lowerer_infer_expr_ast_type(self, lw_box_expr_unbox(receiver));
    match at {
        Type::Ref(inner, _) => {
            at = lw_box_type_unbox(inner);
        }
        _ => {
        }
    }
    match at {
        Type::Generic(an, aargs) => {
            if an == "HashMap" && aargs.len() > 0 {
                return lw_is_int_type(Lowerer_resolve_type(self, aargs.get(0)));
            }
        }
        _ => {
        }
    }
    return false;
}

/// A value a thread can take or give back as one word (release H7).
fn lw_par_word(ty: IrType) -> bool {
    match ty {
        IrType::I64 => {
            return true;
        }
        IrType::I32 => {
            return true;
        }
        IrType::I16 => {
            return true;
        }
        IrType::I8 => {
            return true;
        }
        IrType::U64 => {
            return true;
        }
        IrType::U32 => {
            return true;
        }
        IrType::U16 => {
            return true;
        }
        IrType::U8 => {
            return true;
        }
        IrType::Bool => {
            return true;
        }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::U8 => {
                    return true;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// Whether statements leave their block other than by falling through.
fn lw_stmts_exit(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Return(_, _) => {
                return true;
            }
            Stmt::Break(_, _) => {
                return true;
            }
            Stmt::Continue(_) => {
                return true;
            }
            Stmt::If(_, tb, eb, _) => {
                if lw_stmts_exit(tb) {
                    return true;
                }
                match eb {
                    OptStmts::Some(b) => {
                        if lw_stmts_exit(b) {
                            return true;
                        }
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::Match(_, arms, _) => {
                var ai: i64 = 0;
                while ai < arms.len() {
                    if lw_stmts_exit(arms.get(ai).body) {
                        return true;
                    }
                    ai = ai + 1;
                }
            }
            Stmt::Defer(_, _) => {
                return true;
            }
            Stmt::Do(_, _, _, _) => {
                return true;
            }
            Stmt::Handle(_, _, _) => {
                return true;
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return false;
}

/// A `parallel` branch as a function on its own thread: its free locals are
/// passed by value, so it may read but not assign them (a branch that
/// assigns one, uses a non-word local, or returns/breaks out is run in
/// place: returns -1). Loops inside the branch may break on their own;
/// only a top-level-reaching exit counts, which lw_stmts_exit approximates
/// by refusing any.
fn Lowerer_lift_parallel_branch(self: & mut Lowerer, branch: Vec<Stmt>) -> i64 {
    if branch.len() == 0 || lw_stmts_exit(branch) {
        return - 1;
    }
    var captures: Vec<StringTypeEntry> = Lowerer_find_captures(self, branch, Vec::new());
    var assigned: Vec<str> = Vec::new();
    collect_assign_targets(branch, & mut assigned);
    var names: Vec<str> = Vec::new();
    var tys: Vec<IrType> = Vec::new();
    var ci: i64 = 0;
    while ci < captures.len() {
        var cname: str = captures.get(ci).key;
        var cty: IrType = IrType::Void;
        var is_local: bool = false;
        match Lowerer_lookup_alloca(self, cname) {
            OptValueId::Some(a) => {
                is_local = true;
                match Lowerer_lookup_alloca_type(self, a) {
                    OptIrType::Some(t) => {
                        cty = t;
                    }
                    OptIrType::None => {
                    }
                }
            }
            OptValueId::None => {
                match Lowerer_lookup_local(self, cname) {
                    OptValueId::Some(v) => {
                        is_local = true;
                        cty = Lowerer_get_value_type(self, v);
                    }
                    OptValueId::None => {
                    }
                }
            }
        }
        if is_local {
            if lw_c_str_vec_contains(assigned, cname) {
                return - 1;
            }
            if !lw_par_word(cty) {
                return - 1;
            }
            names.push(cname);
            tys.push(cty);
        }
        ci = ci + 1;
    }
    // every runtime's task block holds 8 argument words: a branch reading
    // more outer locals runs in place, as an assigning one does
    if names.len() > 8 {
        return - 1;
    }

    self.continuation_counter = self.continuation_counter + 1;
    var fname: str = "__par_" + int_to_str(self.continuation_counter);
    var params: Vec<Param> = Vec::new();
    var pi: i64 = 0;
    while pi < names.len() {
        params.push(Param_new(names.get(pi), ir_type_to_ast_type(tys.get(pi)), false));
        pi = pi + 1;
    }
    var body: Vec<Stmt> = branch;
    body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::IntLit(0))), 0));
    var par_func: Func = Func_new_full(fname, params, Type::I64, body, false);

    // Argument values, read before the function is lowered (that resets
    // the per-function tables)
    var arg_vals: Vec<i64> = Vec::new();
    pi = 0;
    while pi < names.len() {
        arg_vals.push(Lowerer_lower_expr(self, Expr::Ident(names.get(pi))));
        pi = pi + 1;
    }

    var saved_func: IrFunction = self.current_func;
    var saved_has_func: bool = self.has_current_func;
    var saved_allocas: Vec<StringValueIdEntry> = self.allocas;
    var saved_alloca_types: Vec<I64IrTypeEntry> = self.alloca_types;
    var saved_var_ast_types: Vec<StringTypeEntry> = self.var_ast_types;
    var saved_block: i64 = self.current_block;
    var saved_sret: OptValueId = self.current_sret;
    var saved_captures: Vec<ClosureCapture> = self.current_captures;
    self.current_captures = Vec::new();
    Lowerer_insert_func_ret_type(self, fname, Type::I64);

    Lowerer_lower_func(self, par_func);

    self.current_func = saved_func;
    self.has_current_func = saved_has_func;
    self.allocas = saved_allocas;
    self.alloca_types = saved_alloca_types;
    self.var_ast_types = saved_var_ast_types;
    Lowerer_ix_reset_tables(self);
    self.current_block = saved_block;
    self.current_sret = saved_sret;
    self.current_captures = saved_captures;

    // Strings it reads are copied for its thread, as for spawn: two
    // branches counting the same string's owners would race
    var arg_exprs: Vec<Expr> = Vec::new();
    pi = 0;
    while pi < names.len() {
        arg_exprs.push(Expr::Ident(names.get(pi)));
        pi = pi + 1;
    }
    return Lowerer_spawn_call(self, fname, arg_exprs, arg_vals);
}

// --- Values handed to another thread -------------------------------------

/// Start `callee(args)` on a thread of its own (p_thread_spawn). A string,
/// Vec or HashMap argument is first copied whole (core's p_send_copy: no
/// buffer and no owner count shared with the caller's value, so neither
/// thread writes what the other reads); the thread runs a wrapper that
/// calls `callee` and then frees those copies. `vals` are the lowered args.
fn Lowerer_spawn_call(self: & mut Lowerer, callee: str, args: Vec<Expr>, vals: Vec<i64>) -> i64 {
    var tys: Vec<Type> = Vec::new();
    var irtys: Vec<IrType> = Vec::new();
    var copied: Vec<bool> = Vec::new();
    var heaped: Vec<bool> = Vec::new();
    var out: Vec<i64> = Vec::new();
    var any: bool = false;
    var any_heap: bool = false;
    var i: i64 = 0;
    while i < vals.len() {
        var v: i64 = vals.get(i);
        var t: Type = Type::Infer;
        if i < args.len() {
            t = Lowerer_rc_value_type(self, args.get(i), v);
        }
        var irty: IrType = Lowerer_get_value_type(self, v);
        var k: i64 = Lowerer_rc_kind(self, t);
        var tid: i64 = 0;
        if k == RC_STR {
            tid = 1;
        }
        // core P_TID_STR
        if k == RC_VEC {
            tid = 2;
        }
        // P_TID_VEC
        if k == RC_MAP {
            tid = 3;
        }
        // P_TID_MAP
        var nv: i64 = v;
        if tid != 0 {
            var ca: Vec<i64> = Vec::new();
            ca.push(Lowerer_rc_env(self));
            ca.push(Lowerer_rc_as_i64(self, v));
            ca.push(Lowerer_emit_inst(self, Inst::ConstInt(tid, IrType::I64)));
            nv = Lowerer_emit_inst(self, Inst::Call("p_send_copy", ca, IrType::I64, lw_rc_eff()));
            match irty {
                IrType::I64 => {
                }
                _ => {
                    nv = Lowerer_emit_inst(self, Inst::BitCast(nv, IrType::I64, irty));
                }
            }
            any = true;
        }
        // BG385: a struct, enum or fixed array passed by value is a heap
        // copy of its own (the thread's wrapper frees it after the call):
        // the value as lowered is the address of the caller's slot, which
        // the caller goes on writing (or leaves, returning) while the
        // thread reads it. As the async-task path copies it.
        var heap_agg: bool = false;
        if tid == 0 && !lw_spawn_is_ref(t) {
            var sagg: IrType = IrType::Void;
            var sagg_ok: bool = false;
            match irty {
                IrType::Ptr(sp_in) => {
                    match box_ir_type_unbox(sp_in) {
                        IrType::Struct(_) => {
                            sagg = box_ir_type_unbox(sp_in);
                            sagg_ok = true;
                        }
                        IrType::Array(_, _) => {
                            sagg = box_ir_type_unbox(sp_in);
                            sagg_ok = true;
                        }
                        _ => {
                        }
                    }
                }
                IrType::Struct(_) => {
                    sagg = irty;
                    sagg_ok = true;
                }
                _ => {
                }
            }
            if sagg_ok {
                var ssize: i64 = IrModule_type_size(& self.module, sagg);
                if ssize < 8 {
                    ssize = 8;
                }
                var sma: Vec<i64> = Vec::new();
                sma.push(Lowerer_emit_inst(self, Inst::ConstInt(ssize, IrType::I64)));
                var smeff: EffectSet = EffectSet_new();
                EffectSet_add(& mut smeff, Effect::Alloc);
                var sraw: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", sma, lw_ptr_u8(), smeff));
                var sheap: i64 = Lowerer_emit_inst(self, Inst::BitCast(sraw, lw_ptr_u8(), IrType::Ptr(Box::new(sagg))));
                Lowerer_emit_inst(self, Inst::StructCopy(sheap, v, sagg));
                nv = sheap;
                irty = IrType::Ptr(Box::new(sagg));
                heap_agg = true;
                any_heap = true;
            }
        }
        match t {
            Type::Infer => {
                t = ir_type_to_ast_type(irty);
            }
            _ => {
            }
        }
        tys.push(t);
        irtys.push(irty);
        copied.push(tid != 0);
        heaped.push(heap_agg);
        out.push(nv);
        i = i + 1;
    }
    var entry: str = callee;
    // BG383: a struct or fixed-array result goes through a result pointer
    // the callee takes first (before the env); the thread calls its entry
    // as (env, args..), so such a callee runs through a wrapper that passes
    // a heap block for the result and returns its address (await copies a
    // struct out of it and frees it, an array result is the block itself,
    // as for an async task). The wrapper also frees BG385's heap copies.
    var ret_ir: IrType = IrType::Void;
    var ret_known: bool = false;
    match Lowerer_lookup_func_ret_type(self, callee) {
        OptType::Some(srt) => {
            ret_ir = Lowerer_lower_type(self, srt);
            ret_known = true;
        }
        OptType::None => {
        }
    }
    var ret_agg: bool = false;
    match ret_ir {
        IrType::Struct(_) => {
            ret_agg = true;
        }
        IrType::Array(_, _) => {
            ret_agg = true;
        }
        _ => {
        }
    }
    if ret_known && (ret_agg || any_heap) {
        entry = Lowerer_spawn_ir_wrapper(self, callee, tys, irtys, copied, heaped, ret_ir, ret_agg);
    } else if any {
        var w: str = Lowerer_spawn_wrapper(self, callee, tys, copied);
        if w != "" {
            entry = w;
        }
    }
    // BG272: a thread function taking or returning an f32 starts through a
    // word wrapper (Lowerer_spawn_float_wrapper): every backend then hands
    // it the same words and `await` reads the same word back
    if ret_known && !ret_agg && entry == callee {
        var fptys: Vec<IrType> = Lowerer_spawn_entry_ptys(self, entry, callee, irtys);
        if lw_spawn_needs_float_words(fptys, ret_ir) {
            var fwi: i64 = 0;
            while fwi < out.len() && fwi < fptys.len() {
                out.set(fwi, Lowerer_spawn_float_word(self, out.get(fwi), fptys.get(fwi)));
                fwi = fwi + 1;
            }
            entry = Lowerer_spawn_float_wrapper(self, callee, fptys, ret_ir);
        }
    }
    var all_args: Vec<i64> = Vec::new();
    all_args.push(Lowerer_emit_inst(self, Inst::ConstStr(entry)));
    all_args.push(Lowerer_emit_inst(self, Inst::ConstInt(out.len(), IrType::I64)));
    i = 0;
    while i < out.len() {
        all_args.push(out.get(i));
        i = i + 1;
    }
    return Lowerer_emit_inst(self, Inst::Call("p_thread_spawn", all_args, IrType::I64, EffectSet_new()));
}

/// CA6: `spawn detached f(x)`, which the parser makes
/// `__spawn_detached(spawn f(x))`: the task starts as `spawn f(x)` does and
/// is let go. A green task (an async function's, a tagged future) is
/// detached, so its block is freed when it finishes (`p_co_detach` takes the
/// untagged block); a thread runs to its end with nobody waiting for it.
fn Lowerer_lower_spawn_detached(self: & mut Lowerer, sp: Expr) -> i64 {
    var green: bool = false;
    match sp {
        Expr::Spawn(inner) => {
            match lw_box_expr_unbox(inner) {
                Expr::Call(dcallee, _) => {
                    green = lw_c_str_vec_contains(self.async_adapted, dcallee);
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    var handle: i64 = Lowerer_lower_expr(self, sp);
    var h64: i64 = handle;
    match Lowerer_get_value_type(self, handle) {
        IrType::I64 => {
        }
        _ => {
            h64 = Lowerer_emit_inst(self, Inst::BitCast(handle, Lowerer_get_value_type(self, handle), IrType::I64));
        }
    }
    var detach_arg: i64 = h64;
    if green {
        var mask: i64 = Lowerer_emit_inst(self, Inst::ConstInt(281474976710655, IrType::I64));
        detach_arg = Lowerer_emit_inst(self, Inst::BinOp(BinOp::BitAnd, h64, mask, IrType::I64));
    }
    // BG119: a thread's future goes to p_co_detach as a green block does —
    // every runtime's p_co_detach takes it now (codegen_c's P_FT_IS, the
    // native runtimes' negative word). Before, a detached thread in a
    // scope was joined anyway at the scope's end. A `spawn detached` that
    // is not a call is eager — a bare value, nothing to detach.
    var detach: bool = green;
    match sp {
        Expr::Spawn(dinner) => {
            match lw_box_expr_unbox(dinner) {
                Expr::Call(_, _) => {
                    detach = true;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    if detach {
        Lowerer_emit_inst(self, Inst::Call("p_co_detach", lw_c_vec1_i64(detach_arg), IrType::Void, lw_rc_eff()));
    }
    return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
}

/// `fn __spawn_N(a0: T0, ..) -> R { var r = callee(a0, ..); free the copied
/// args; return r; }`, lowered now; its name, or "" when callee's result is
/// not one word (a struct): the copies then live until the program ends.
fn Lowerer_spawn_wrapper(self: & mut Lowerer, callee: str, tys: Vec<Type>, copied: Vec<bool>) -> str {
    var ret: Type = Type::Void;
    match Lowerer_lookup_func_ret_type(self, callee) {
        OptType::Some(rt) => {
            ret = rt;
        }
        OptType::None => {
            return "";
        }
    }
    var is_void: bool = false;
    match ret {
        Type::Void => {
            is_void = true;
        }
        _ => {
        }
    }
    if !is_void {
        var rk: i64 = Lowerer_rc_kind(self, ret);
        if rk == RC_MEM || rk == RC_BOX {
            return "";
        }
        // a str, Vec or map result is one word too (a handle): without the
        // wrapper a task returning a Vec never freed its argument copies
        // (tests/leaks/await_results.fd)
        if !lw_par_word(Lowerer_lower_type(self, ret)) && rk != RC_STR && rk != RC_VEC && rk != RC_MAP {
            return "";
        }
    }
    self.continuation_counter = self.continuation_counter + 1;
    var fname: str = "__spawn_" + int_to_str(self.continuation_counter);
    var params: Vec<Param> = Vec::new();
    var cargs: Vec<Expr> = Vec::new();
    var i: i64 = 0;
    while i < tys.len() {
        var pn: str = "__sa" + int_to_str(i);
        params.push(Param_new(pn, tys.get(i), false));
        cargs.push(Expr::Ident(pn));
        i = i + 1;
    }
    var call: Expr = Expr::Call(callee, cargs);
    var body: Vec<Stmt> = Vec::new();
    if is_void {
        body.push(Stmt::Expr(call, 0));
    } else {
        body.push(Stmt::Let("__sr", OptType::Some(ret), call, true, false, Vec::new(), 0));
    }
    i = 0;
    while i < tys.len() {
        if copied.get(i) {
            var da: Vec<Expr> = Vec::new();
            da.push(Expr::Ident("__sa" + int_to_str(i)));
            body.push(Stmt::Expr(Expr::Call("__thread_drop", da), 0));
        }
        i = i + 1;
    }
    if !is_void {
        body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::Ident("__sr"))), 0));
    }
    var wf: Func = Func_new_full(fname, params, ret, body, false);

    var saved_func: IrFunction = self.current_func;
    var saved_has_func: bool = self.has_current_func;
    var saved_allocas: Vec<StringValueIdEntry> = self.allocas;
    var saved_alloca_types: Vec<I64IrTypeEntry> = self.alloca_types;
    var saved_var_ast_types: Vec<StringTypeEntry> = self.var_ast_types;
    var saved_block: i64 = self.current_block;
    var saved_sret: OptValueId = self.current_sret;
    var saved_captures: Vec<ClosureCapture> = self.current_captures;
    self.current_captures = Vec::new();
    Lowerer_insert_func_ret_type(self, fname, ret);
    Lowerer_lower_func(self, wf);
    self.current_func = saved_func;
    self.has_current_func = saved_has_func;
    self.allocas = saved_allocas;
    self.alloca_types = saved_alloca_types;
    self.var_ast_types = saved_var_ast_types;
    Lowerer_ix_reset_tables(self);
    self.current_block = saved_block;
    self.current_sret = saved_sret;
    self.current_captures = saved_captures;
    return fname;
}

/// BG385: whether a spawn argument's type is a reference (passed as it is).
fn lw_spawn_is_ref(t: Type) -> bool {
    match t {
        Type::Ref(_, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// BG383/BG385: `__spawn_N(env, a0, ..)` built as IR: calls `callee` with a
/// heap block for its result first when `ret_agg` (a struct or fixed-array
/// result, `ret_ir`) and returns the block's address, else returns what the
/// callee returns; after the call it drops the arguments copied for the
/// thread (`copied`, p_send_copy) and frees the heap copies of struct and
/// array arguments (`heaped`). `ptys` are the IR types of the words the
/// thread is given. Its name.
fn Lowerer_spawn_ir_wrapper(self: & mut Lowerer, callee: str, tys: Vec<Type>, ptys: Vec<IrType>, copied: Vec<bool>, heaped: Vec<bool>, ret_ir: IrType, ret_agg: bool) -> str {
    self.continuation_counter = self.continuation_counter + 1;
    var wname: str = "__spawn_" + int_to_str(self.continuation_counter);
    var wret: IrType = ret_ir;
    if ret_agg {
        wret = IrType::I64;
    }
    var w: IrFunction = IrFunction_new(wname, wret);
    var env_ty: IrType = lw_ptr_u8();
    var env_val: i64 = IrFunction_new_value(& mut w, ValueMeta_new(env_ty));
    w.params.push(ValueIdType_new(env_val, env_ty));
    var pvals: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < ptys.len() {
        var pv: i64 = IrFunction_new_value(& mut w, ValueMeta_new(ptys.get(i)));
        w.params.push(ValueIdType_new(pv, ptys.get(i)));
        pvals.push(pv);
        i = i + 1;
    }
    var prev_func: IrFunction = self.current_func;
    var prev_has: bool = self.has_current_func;
    var prev_block: i64 = self.current_block;
    // nothing emitted here is a temporary of the spawning statement
    var prev_own: bool = self.own_on;
    self.own_on = false;
    self.current_func = w;
    self.current_func.name = wname;
    self.has_current_func = true;
    self.current_block = 0;
    self.current_func.current_block_idx = 0;
    var eff: EffectSet = EffectSet_new();
    EffectSet_add(& mut eff, Effect::Read);
    EffectSet_add(& mut eff, Effect::Write);
    EffectSet_add(& mut eff, Effect::IO);
    EffectSet_add(& mut eff, Effect::Alloc);
    var heap: i64 = - 1;
    var args: Vec<i64> = Vec::new();
    if ret_agg {
        var rsize: i64 = IrModule_type_size(& self.module, ret_ir);
        if rsize < 8 {
            rsize = 8;
        }
        var rma: Vec<i64> = Vec::new();
        rma.push(Lowerer_emit_inst(self, Inst::ConstInt(rsize, IrType::I64)));
        var rraw: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", rma, lw_ptr_u8(), eff));
        heap = Lowerer_emit_inst(self, Inst::BitCast(rraw, lw_ptr_u8(), IrType::Ptr(Box::new(ret_ir))));
        args.push(heap);
    }
    args.push(env_val);
    i = 0;
    while i < pvals.len() {
        args.push(pvals.get(i));
        i = i + 1;
    }
    var call_ty: IrType = ret_ir;
    if ret_agg {
        call_ty = IrType::Void;
    }
    var res: i64 = Lowerer_emit_inst(self, Inst::Call(callee, args, call_ty, eff));
    i = 0;
    while i < pvals.len() {
        if i < copied.len() && copied.get(i) && i < tys.len() {
            Lowerer_rc_drop(self, pvals.get(i), tys.get(i));
        }
        if i < heaped.len() && heaped.get(i) {
            var fa: Vec<i64> = Vec::new();
            fa.push(Lowerer_emit_inst(self, Inst::BitCast(pvals.get(i), ptys.get(i), lw_ptr_u8())));
            Lowerer_emit_inst(self, Inst::Call("p_free", fa, IrType::Void, eff));
        }
        i = i + 1;
    }
    if ret_agg {
        var hres: i64 = Lowerer_emit_inst(self, Inst::BitCast(heap, IrType::Ptr(Box::new(ret_ir)), IrType::I64));
        Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(hres)));
    } else {
        match ret_ir {
            IrType::Void => {
                Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
            }
            _ => {
                Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(res)));
            }
        }
    }
    IrModule_add_function(& mut self.module, self.current_func);
    self.current_func = prev_func;
    self.has_current_func = prev_has;
    self.current_block = prev_block;
    self.own_on = prev_own;
    return wname;
}

// --- txn { } and abort; ----------------------------------------------------

/// A plain stack slot of type `ty` in the entry block (not owned).
fn Lowerer_txn_raw_slot(self: & mut Lowerer, ty: IrType) -> i64 {
    var a: i64 = lw_detached(& mut self.current_func, Inst::Alloca(ty, Region::Stack));
    self.own_prologue.push(a);
    return a;
}

/// Copy the bytes of a local of aggregate type `ty` from `src` to `dst`: a
/// struct by a struct store, an array word by word.
fn Lowerer_txn_copy(self: & mut Lowerer, dst: i64, src: i64, ty: IrType) {
    match ty {
        IrType::Array(_, _) => {
            var size: i64 = IrModule_type_size(& self.module, ty);
            var a: Vec<i64> = Vec::new();
            a.push(Lowerer_rc_env(self));
            a.push(Lowerer_rc_as_i64(self, dst));
            a.push(Lowerer_rc_as_i64(self, src));
            a.push(Lowerer_emit_inst(self, Inst::ConstInt((size + 7) / 8, IrType::I64)));
            Lowerer_emit_inst(self, Inst::Call("p_copy_words", a, IrType::Void, lw_rc_eff()));
            return;
        }
        _ => {
        }
    }
    Lowerer_emit_inst(self, Inst::Store(dst, src, OptIrType::Some(ty)));
}

/// Whether allocas[i] is the binding its name refers to now (not shadowed).
fn Lowerer_txn_latest(self: & Lowerer, i: i64) -> bool {
    var name: str = self.allocas.get(i).key;
    var j: i64 = i + 1;
    while j < self.allocas.len() {
        if self.allocas.get(j).key == name {
            return false;
        }
        j = j + 1;
    }
    return true;
}

/// Open a txn: an ownership scope (the snapshots are its slots), a
/// snapshot of each live local, and the block after the txn.
fn Lowerer_txn_open(self: & mut Lowerer) -> LwTxn {
    var tx: LwTxn = LwTxn {
        slots: Vec::new(), snaps: Vec::new(), tys: Vec::new(), irtys: Vec::new(), aggs: Vec::new(), owned: Vec::new(), end_block: Lowerer_new_block(self), mark: self.own_slots.len(),
    };
    Lowerer_rc_scope_open(self);
    var n: i64 = self.allocas.len();
    var i: i64 = 0;
    while i < n {
        var ent: StringValueIdEntry = self.allocas.get(i);
        if ent.val >= 0 && Lowerer_txn_latest(self, i) {
            var slot: i64 = ent.val;
            var irty: IrType = IrType::Void;
            match Lowerer_lookup_alloca_type(self, slot) {
                OptIrType::Some(at) => {
                    irty = at;
                }
                OptIrType::None => {
                }
            }
            var t: Type = Type::Infer;
            match Lowerer_lookup_var_ast_type(self, ent.key) {
                OptType::Some(vt) => {
                    t = vt;
                }
                OptType::None => {
                }
            }
            var is_void: bool = false;
            match irty {
                IrType::Void => {
                    is_void = true;
                }
                _ => {
                }
            }
            if !is_void {
                Lowerer_txn_snapshot(self, & mut tx, slot, irty, t);
            }
        }
        i = i + 1;
    }
    return tx;
}

/// Snapshot one local: an owned value gets one more owner (a Vec, a map or
/// a string is shared copy-on-write, so later changes leave the snapshot
/// alone); anything else is copied as it is.
fn Lowerer_txn_snapshot(self: & mut Lowerer, tx: & mut LwTxn, slot: i64, irty: IrType, t: Type) {
    var agg: bool = false;
    match irty {
        IrType::Struct(_) => {
            agg = true;
        }
        IrType::Array(_, _) => {
            agg = true;
        }
        _ => {
        }
    }
    var k: i64 = RC_NONE;
    if self.own_on && Lowerer_rc_owns_slot(self, slot) {
        k = Lowerer_rc_kind(self, t);
    }
    var owned: bool = k != RC_NONE;
    var snap: i64 = 0;
    if agg {
        if owned && k == RC_MEM {
            snap = Lowerer_rc_new_slot(self, irty, t);
        } else {
            snap = Lowerer_txn_raw_slot(self, irty);
            owned = false;
        }
        Lowerer_txn_copy(self, snap, slot, irty);
        if owned {
            Lowerer_rc_call_mem(self, "__own_dup_", snap, t);
            Lowerer_rc_add_slot(self, snap, t);
        }
    } else {
        if k == RC_MEM {
            owned = false;
        }
        var cur: i64 = Lowerer_emit_inst(self, Inst::Load(slot, irty));
        if owned {
            snap = Lowerer_rc_new_slot(self, irty, t);
            var dup: i64 = Lowerer_rc_dup(self, cur, t);
            Lowerer_emit_inst(self, Inst::Store(snap, dup, OptIrType::None));
            Lowerer_rc_add_slot(self, snap, t);
        } else {
            snap = Lowerer_txn_raw_slot(self, irty);
            Lowerer_emit_inst(self, Inst::Store(snap, cur, OptIrType::None));
        }
    }
    tx.slots.push(slot);
    tx.snaps.push(snap);
    tx.tys.push(t);
    tx.irtys.push(irty);
    tx.aggs.push(agg);
    tx.owned.push(owned);
}

/// `abort;`: drop what the body declared, put every snapshotted local back
/// (an owned one drops what it holds now and takes the snapshot over), and
/// leave the innermost txn.
fn Lowerer_txn_abort(self: & mut Lowerer) {
    if self.txn_stack.len() == 0 {
        return;
    }
    var tx: LwTxn = self.txn_stack.get(self.txn_stack.len() - 1);
    var j: i64 = self.own_slots.len() - 1;
    while j >= tx.mark {
        var os: OwnSlot = self.own_slots.get(j);
        var is_snap: bool = false;
        var q: i64 = 0;
        while q < tx.snaps.len() {
            if tx.snaps.get(q) == os.slot {
                is_snap = true;
            }
            q = q + 1;
        }
        if !is_snap {
            Lowerer_rc_drop_slot(self, os);
        }
        j = j - 1;
    }
    var i: i64 = 0;
    while i < tx.slots.len() {
        var slot: i64 = tx.slots.get(i);
        var snap: i64 = tx.snaps.get(i);
        var t: Type = tx.tys.get(i);
        var irty: IrType = tx.irtys.get(i);
        if tx.aggs.get(i) {
            if tx.owned.get(i) {
                Lowerer_rc_call_mem(self, "__own_drop_", slot, t);
            }
            Lowerer_txn_copy(self, slot, snap, irty);
            // the snapshot moved back: its slot no longer owns it
            if tx.owned.get(i) {
                Lowerer_rc_clear_slot(self, snap, t);
            }
        } else {
            if tx.owned.get(i) {
                var now: i64 = Lowerer_emit_inst(self, Inst::Load(slot, irty));
                Lowerer_rc_drop(self, now, t);
            }
            var back: i64 = Lowerer_emit_inst(self, Inst::Load(snap, irty));
            Lowerer_emit_inst(self, Inst::Store(slot, back, OptIrType::None));
            if tx.owned.get(i) {
                Lowerer_rc_clear_slot(self, snap, t);
            }
        }
        i = i + 1;
    }
    Lowerer_emit_inst(self, Inst::TxnEnd);
    Lowerer_emit_terminator(self, Inst::Jump(tx.end_block));
    // what follows `abort;` in its block is not reached
    var dead: i64 = Lowerer_new_block(self);
    Lowerer_set_current_block(self, dead);
}

// --- Lowerer_lower_stmt helper functions ----------------------------------
// Split out to avoid the statement-dropping bug in long functions.

/// The element code of a `Vec<T>` type (release D14): the size of a small
/// integer or bool element, negative when it is signed; 0 (one word per
/// element) for anything else.
fn lw_vec_elem_code(t: Type) -> i64 {
    match t {
        Type::Generic(n, args) => {
            if n == "Vec" && args.len() == 1 {
                match args.get(0) {
                    Type::U8 => {
                        return 1;
                    }
                    Type::Bool => {
                        return 1;
                    }
                    Type::I8 => {
                        return - 1;
                    }
                    Type::U16 => {
                        return 2;
                    }
                    Type::I16 => {
                        return - 2;
                    }
                    Type::U32 => {
                        return 4;
                    }
                    Type::I32 => {
                        return - 4;
                    }
                    _ => {
                    }
                }
            }
        }
        _ => {
        }
    }
    return 0;
}

/// Is `e` the call `Vec::new()`?
/// The parts appended by `name = name + a + b ...` or `name += a`, in
/// order; empty when the statement is not one, or when a part reads `name`
/// itself after the first (it would see the string already grown).
fn lw_rc_append_parts(name: str, op: AssignOp, expr: Expr) -> Vec<Expr> {
    var out: Vec<Expr> = Vec::new();
    match op {
        AssignOp::AddAssign => {
            out.push(expr);
            return out;
        }
        AssignOp::Assign => {
        }
        _ => {
            return out;
        }
    }
    // Walk down the left of `((name + a) + b) + c`
    var rev: Vec<Expr> = Vec::new();
    var cur: Expr = expr;
    var done: bool = false;
    while !done {
        match cur {
            Expr::Binary(bop, l, r) => {
                if !binop_eq(bop, BinOp::Add) {
                    return Vec::new();
                }
                rev.push(lw_box_expr_unbox(r));
                cur = lw_box_expr_unbox(l);
            }
            Expr::Ident(ln) => {
                if ln != name {
                    return Vec::new();
                }
                done = true;
            }
            _ => {
                return Vec::new();
            }
        }
    }
    var i: i64 = rev.len() - 1;
    while i >= 0 {
        if rev.len() > 1 && cow_uses_expr(rev.get(i), name) > 0 {
            return Vec::new();
        }
        out.push(rev.get(i));
        i = i - 1;
    }
    return out;
}

/// `HashMap::new()`.
fn lw_rc_is_map_new_expr(e: Expr) -> bool {
    match e {
        Expr::MethodCall(recv, m, args) => {
            if m != "new" || args.len() != 0 {
                return false;
            }
            match lw_box_expr_unbox(recv) {
                Expr::Ident(rn) => {
                    return rn == "HashMap";
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// `expr` lowered to be kept as a `t`: an empty collection gets the element
/// types `t` gives it, and the value becomes an owner (proposal 0004).
fn Lowerer_lower_owned_new(self: & mut Lowerer, expr: Expr, t: Type) -> i64 {
    var v: i64 = - 1;
    if lw_is_vec_new_expr(expr) || lw_rc_is_map_new_expr(expr) {
        v = Lowerer_rc_new_coll(self, t);
    }
    var fargs: Vec<Expr> = lw_vec_filled_args(expr);
    if v < 0 && fargs.len() == 2 && Lowerer_has_function(self, "Vec_filled_typed") {
        v = Lowerer_lower_vec_filled(self, fargs, t);
    }
    if v < 0 {
        v = Lowerer_lower_keep(self, expr);
    }
    return Lowerer_rc_own_value(self, v, t);
}

/// The declared AST type of field `field` of struct `sn`, or Infer.
fn Lowerer_rc_field_ast_type(self: & Lowerer, sn: str, field: str) -> Type {
    match Lowerer_lookup_struct(self, sn) {
        OptStructDef::Some(sd) => {
            var i: i64 = 0;
            while i < sd.fields.len() {
                if sd.fields.get(i).name == field {
                    return sd.fields.get(i).ty;
                }
                i = i + 1;
            }
        }
        OptStructDef::None => {
        }
    }
    return Type::Infer;
}

fn lw_rc_strip_ref(t: Type) -> Type {
    match t {
        Type::Ref(inner, _) => {
            return lw_box_type_unbox(inner);
        }
        _ => {
        }
    }
    return t;
}

/// The AST type of `e` as far as ownership needs it: Lowerer_infer_expr_ast_type
/// plus fields, indexing and the methods of Vec, HashMap, Option, Result,
/// str and user structs.
fn Lowerer_rc_expr_type(self: & Lowerer, e: Expr) -> Type {
    match e {
        Expr::FieldAccess(obj, f) => {
            var ot: Type = lw_rc_strip_ref(Lowerer_resolve_type(self, Lowerer_rc_expr_type(self, lw_box_expr_unbox(obj))));
            var sn: str = lw_rc_type_name(ot);
            if sn == "" {
                return Type::Infer;
            }
            match Lowerer_lookup_struct(self, sn) {
                OptStructDef::Some(sd) => {
                    var i: i64 = 0;
                    while i < sd.fields.len() {
                        if sd.fields.get(i).name == f {
                            return lw_rc_subst(sd.fields.get(i).ty, sd.type_params, lw_rc_type_args(ot));
                        }
                        i = i + 1;
                    }
                }
                OptStructDef::None => {
                }
            }
            return Type::Infer;
        }
        Expr::Index(arr, _) => {
            var at: Type = lw_rc_strip_ref(Lowerer_resolve_type(self, Lowerer_rc_expr_type(self, lw_box_expr_unbox(arr))));
            match at {
                Type::Generic(n, a) => {
                    if n == "Vec" && a.len() == 1 {
                        return a.get(0);
                    }
                }
                _ => {
                }
            }
            return Type::Infer;
        }
        Expr::MethodCall(recv, m, _) => {
            var rt: Type = lw_rc_strip_ref(Lowerer_resolve_type(self, Lowerer_rc_expr_type(self, lw_box_expr_unbox(recv))));
            match rt {
                Type::Str => {
                    if m == "len" || m == "find" || m == "rfind" || m == "byte_at" || m == "parse_int" || m == "char_count" {
                        return Type::I64;
                    }
                    if m == "contains" || m == "starts_with" || m == "ends_with" || m == "is_empty" {
                        return Type::Bool;
                    }
                    if m == "split" || m == "lines" {
                        return Type::Generic("Vec", lw_rc_one(Type::Str));
                    }
                    return Type::Str;
                }
                Type::Generic(n, a) => {
                    if n == "Vec" && a.len() == 1 {
                        if m == "get" || m == "first" || m == "last" || m == "pop" || m == "remove" {
                            return a.get(0);
                        }
                        if m == "clone" {
                            return rt;
                        }
                    }
                    if n == "HashMap" && a.len() == 2 {
                        if m == "get" || m == "get_or" || m == "remove" {
                            return a.get(1);
                        }
                        if m == "keys" {
                            return Type::Generic("Vec", lw_rc_one(a.get(0)));
                        }
                        if m == "values" {
                            return Type::Generic("Vec", lw_rc_one(a.get(1)));
                        }
                        if m == "clone" {
                            return rt;
                        }
                    }
                    if (n == "Option" || n == "Result") && a.len() > 0 && (m == "unwrap" || m == "unwrap_or" || m == "expect") {
                        return a.get(0);
                    }
                }
                _ => {
                }
            }
            var sn2: str = lw_rc_type_name(rt);
            if sn2 != "" {
                var ret: Type = Lowerer_rc_ret_type(self, sn2 + "_" + m);
                match ret {
                    Type::Infer => {
                    }
                    _ => {
                        return ret;
                    }
                }
            }
            return Lowerer_infer_expr_ast_type(self, e);
        }
        // CL10: `a op b` on a struct is `a.op(b)` (or `b.rop(a)` with a
        // struct only on the right): the method's type, as above. Without
        // it a struct holding a string or Vec made by `+` was typed i64.
        Expr::Binary(bop, bl, br) => {
            var bm: str = binop_operator_method(bop);
            if str_len(bm) > 0 {
                // the left operand's type is found once (a chain `a + b + c`
                // must not infer it again at every level)
                var blt: Type = Lowerer_rc_expr_type(self, lw_box_expr_unbox(bl));
                var bret: Type = Lowerer_rc_operator_type(self, blt, bm);
                match bret {
                    Type::Infer => {
                    }
                    _ => {
                        return bret;
                    }
                }
                match lw_rc_strip_ref(Lowerer_resolve_type(self, blt)) {
                    Type::Named(_) => {
                    }
                    Type::Generic(_, _) => {
                    }
                    _ => {
                        bret = Lowerer_rc_operator_type(self, Lowerer_rc_expr_type(self, lw_box_expr_unbox(br)), "r" + bm);
                        match bret {
                            Type::Infer => {
                            }
                            _ => {
                                return bret;
                            }
                        }
                    }
                }
            }
        }
        _ => {
        }
    }
    return Lowerer_infer_expr_ast_type(self, e);
}

/// CL10: the return type of operator method `m` of the struct `t` names
/// (not a vecN, not a unit: those make plain f64 structs), or Infer.
fn Lowerer_rc_operator_type(self: & Lowerer, t: Type, m: str) -> Type {
    match lw_rc_strip_ref(Lowerer_resolve_type(self, t)) {
        Type::Named(sn) => {
            if is_vec_type_name(sn) || Lowerer_struct_dim(self, sn) != 0 {
                return Type::Infer;
            }
            match Lowerer_lookup_struct(self, sn) {
                OptStructDef::Some(_) => {
                    return Lowerer_rc_ret_type(self, sn + "_" + m);
                }
                OptStructDef::None => {
                }
            }
        }
        _ => {
        }
    }
    return Type::Infer;
}

/// The type the value of an `if` or `match` is owned as: the let's declared
/// type, else the first branch value whose type is known to own something.
fn Lowerer_rc_result_type(self: & mut Lowerer, tails: Vec<Expr>) -> Type {
    match self.let_hint {
        OptType::Some(lh) => {
            if Lowerer_rc_kind(self, lh) != RC_NONE {
                return lh;
            }
        }
        OptType::None => {
        }
    }
    var i: i64 = 0;
    while i < tails.len() {
        var t: Type = Lowerer_rc_expr_type(self, tails.get(i));
        match tails.get(i) {
            Expr::StringLit(_) => {
                t = Type::Str;
            }
            _ => {
            }
        }
        if Lowerer_rc_kind(self, t) != RC_NONE {
            return t;
        }
        i = i + 1;
    }
    return Type::Infer;
}

fn lw_rc_one(t: Type) -> Vec<Type> {
    var v: Vec<Type> = Vec::new();
    v.push(t);
    return v;
}

/// The type to count value `v` (the lowering of `e`) as when nothing else
/// says: its AST type, else what its IR type stands for.
fn Lowerer_rc_value_type(self: & mut Lowerer, e: Expr, v: i64) -> Type {
    var tt: Type = Lowerer_rc_temp_type(self, v);
    if Lowerer_rc_kind(self, tt) != RC_NONE {
        return tt;
    }
    var et: Type = Lowerer_rc_expr_type(self, e);
    if Lowerer_rc_kind(self, et) != RC_NONE {
        return et;
    }
    var it: IrType = Lowerer_get_value_type(self, v);
    var ht: Type = lw_rc_handle_of_ir(it);
    if Lowerer_rc_kind(self, ht) != RC_NONE {
        return ht;
    }
    var sn: str = "";
    match it {
        IrType::Struct(n) => {
            sn = n;
        }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Struct(n2) => {
                    sn = n2;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    if sn != "" {
        return Type::Named(sn);
    }
    return Type::Infer;
}

/// The element type of the Vec `e` is (through a reference), or Infer.
fn Lowerer_rc_vec_elem_ast(self: & Lowerer, e: Expr) -> Type {
    var t: Type = Lowerer_resolve_type(self, Lowerer_rc_expr_type(self, e));
    match t {
        Type::Ref(inner, _) => {
            t = lw_box_type_unbox(inner);
        }
        _ => {
        }
    }
    match t {
        Type::Generic(n, a) => {
            if n == "Vec" && a.len() == 1 {
                return a.get(0);
            }
        }
        _ => {
        }
    }
    return Type::Infer;
}

/// The IR type of the elements of the Vec `e` is, from its AST type
/// (Lowerer_rc_vec_elem_ast: a field of a generic instance has its type
/// arguments put in), or I64 when it is not known.
fn Lowerer_vec_elem_ir_of(self: & Lowerer, e: Expr) -> IrType {
    var et: Type = Lowerer_rc_vec_elem_ast(self, e);
    match et {
        Type::Infer => {
            return IrType::I64;
        }
        _ => {
        }
    }
    return Lowerer_lower_type(self, et);
}

/// The key and value types of the HashMap `e` is, or an empty list.
fn Lowerer_rc_map_kv_ast(self: & Lowerer, e: Expr) -> Vec<Type> {
    var out: Vec<Type> = Vec::new();
    var t: Type = Lowerer_resolve_type(self, Lowerer_rc_expr_type(self, e));
    match t {
        Type::Ref(inner, _) => {
            t = lw_box_type_unbox(inner);
        }
        _ => {
        }
    }
    match t {
        Type::Generic(n, a) => {
            if n == "HashMap" && a.len() == 2 {
                out.push(a.get(0));
                out.push(a.get(1));
            }
        }
        _ => {
        }
    }
    return out;
}

/// The AST type of variable `name` (a local or a parameter), or Infer.
fn Lowerer_rc_var_type(self: & Lowerer, name: str) -> Type {
    match Lowerer_lookup_var_ast_type(self, name) {
        OptType::Some(vt) => {
            return vt;
        }
        OptType::None => {
        }
    }
    match Lowerer_lookup_param_type(self, name) {
        OptType::Some(pt) => {
            return pt;
        }
        OptType::None => {
        }
    }
    return Type::Infer;
}

/// The handle type an IR type stands for (a global's), or Infer.
fn lw_rc_handle_of_ir(t: IrType) -> Type {
    match t {
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::U8 => {
                    return Type::Str;
                }
                _ => {
                }
            }
        }
        IrType::Generic(gn, _) => {
            if gn == "Vec" || gn == "HashMap" {
                return Type::Named(gn);
            }
        }
        IrType::Opaque(onm) => {
            if onm == "Vec" || onm == "HashMap" {
                return Type::Named(onm);
            }
        }
        _ => {
        }
    }
    return Type::Infer;
}

/// `left + right` where `right` is the result of core's `int_to_str(n)`,
/// lowered just before and used by nothing else: p_str_concat_int(left, n),
/// with the int_to_str call removed. -1 when it does not apply.
fn Lowerer_concat_int(self: & mut Lowerer, left: i64, right: i64) -> i64 {
    if !Lowerer_has_function(self, "p_str_concat_int") {
        return - 1;
    }
    if self.current_func.name == "p_str_concat_int" || self.current_func.name == "int_to_str" {
        return - 1;
    }
    var nv: i64 = - 1;
    match IrFunction_get_inst(& self.current_func, right) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Call(cn, cargs, _, _) => {
                    if cn == "int_to_str" && cargs.len() == 2 {
                        nv = cargs.get(1);
                    }
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    if nv < 0 {
        return - 1;
    }
    // The call must be the current block's last instruction (nothing in
    // between uses it), so it can be taken out
    var bi: i64 = self.current_func.current_block_idx;
    if bi < 0 || bi >= self.current_func.blocks.len() {
        return - 1;
    }
    var blk: BasicBlock = self.current_func.blocks.get(bi);
    var ins: Vec<i64> = blk.instructions;
    if ins.len() == 0 || ins.get(ins.len() - 1) != right {
        return - 1;
    }
    ins.pop();
    blk.instructions = ins;
    self.current_func.blocks.set(bi, blk);
    // nor is it a temporary of the statement any more
    Lowerer_rc_claim(self, right);
    var a: Vec<i64> = Vec::new();
    a.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
    // the string as it is (the interpreter keeps its own string values)
    a.push(left);
    a.push(nv);
    return Lowerer_emit_inst(self, Inst::Call("p_str_concat_int", a, lw_ptr_u8(), lw_rc_eff()));
}

/// The arguments of `Vec::filled(n, x)`, or none.
fn lw_vec_filled_args(e: Expr) -> Vec<Expr> {
    var none: Vec<Expr> = Vec::new();
    match e {
        Expr::MethodCall(recv, m, args) => {
            if m != "filled" || args.len() != 2 {
                return none;
            }
            match lw_box_expr_unbox(recv) {
                Expr::Ident(rn) => {
                    if rn == "Vec" {
                        return args;
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return none;
}

/// `Vec::filled(n, x)` made as a `t` (a Vec<T>; Infer: the element type
/// from `x`): Vec_filled_typed(n, x, code, tid), a new Vec whose elements
/// are at their size and each one more owner of `x`.
fn Lowerer_lower_vec_filled(self: & mut Lowerer, args: Vec<Expr>, t: Type) -> i64 {
    var nv: i64 = Lowerer_lower_expr(self, args.get(0));
    var xv: i64 = Lowerer_lower_expr(self, args.get(1));
    var vt: Type = Lowerer_resolve_type(self, t);
    var known: bool = false;
    match vt {
        Type::Generic(gn, ga) => {
            known = gn == "Vec" && ga.len() == 1;
        }
        _ => {
        }
    }
    if !known {
        var et: Type = Type::Infer;
        if self.own_on {
            et = Lowerer_rc_value_type(self, args.get(1), xv);
        }
        if Lowerer_rc_kind(self, et) == RC_NONE {
            et = Type::I64;
            match Lowerer_get_value_type(self, xv) {
                IrType::U8 => {
                    et = Type::U8;
                }
                IrType::Bool => {
                    et = Type::Bool;
                }
                IrType::F64 => {
                    et = Type::F64;
                }
                _ => {
                }
            }
        }
        var ea: Vec<Type> = Vec::new();
        ea.push(et);
        vt = Type::Generic("Vec", ea);
    }
    var code: i64 = lw_vec_elem_code(vt);
    var tid: i64 = 0;
    if self.own_on {
        var tids: Vec<i64> = Lowerer_rc_coll_tids(self, vt);
        if tids.len() == 1 {
            tid = tids.get(0);
        }
    }
    var a: Vec<i64> = Vec::new();
    a.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
    a.push(Lowerer_rc_as_i64(self, nv));
    // An f64 element is stored as its bits (stdlib-agent-bugs 4/43): a
    // BitCast to i64 converts the number (0.5 -> 0, 3.0 -> a denormal)
    var xw: i64 = - 1;
    // BG299: an f64 (a literal: `Vec::filled(3, 1.5)`) filling a Vec<f32>
    // is made an f32 first and stored as an f32 value is (an f32 variable
    // worked); stored as the double's bits, --nat read their low half: 0
    var filled_f32: bool = false;
    match vt {
        Type::Generic(fgn, fga) => {
            if fgn == "Vec" && fga.len() == 1 {
                match fga.get(0) {
                    Type::F32 => {
                        filled_f32 = true;
                    }
                    _ => {
                    }
                }
            }
        }
        _ => {
        }
    }
    match Lowerer_get_value_type(self, xv) {
        IrType::F64 => {
            if filled_f32 {
                var xv32: i64 = Lowerer_lower_cast(self, xv, IrType::F64, IrType::F32);
                xw = Lowerer_rc_as_i64(self, xv32);
            } else {
                var xba: Vec<i64> = Vec::new();
                xba.push(xv);
                xw = Lowerer_emit_inst(self, Inst::Call("p_f64_to_bits", xba, IrType::I64, EffectSet_new()));
            }
        }
        _ => {
            xw = Lowerer_rc_as_i64(self, xv);
        }
    }
    a.push(xw);
    a.push(Lowerer_emit_inst(self, Inst::ConstInt(code, IrType::I64)));
    a.push(Lowerer_emit_inst(self, Inst::ConstInt(tid, IrType::I64)));
    return Lowerer_emit_inst(self, Inst::Call("Vec_filled_typed", a, Lowerer_lower_type(self, vt), lw_rc_eff()));
}

fn lw_is_vec_new_expr(e: Expr) -> bool {
    match e {
        Expr::MethodCall(recv, m, args) => {
            if m != "new" || args.len() != 0 {
                return false;
            }
            match lw_box_expr_unbox(recv) {
                Expr::Ident(rn) => {
                    return rn == "Vec";
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// Whether `e` is `HashMap::new()`.
fn lw_is_map_new_expr(e: Expr) -> bool {
    match e {
        Expr::MethodCall(recv, m, args) => {
            if m != "new" || args.len() != 0 {
                return false;
            }
            match lw_box_expr_unbox(recv) {
                Expr::Ident(rn) => {
                    return rn == "HashMap";
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// A `let`'s value: `var v: Vec<u8> = Vec::new()` makes a Vec with its
/// elements at their size (D14); anything else lowers as usual.
fn Lowerer_lower_let_value_typed(self: & mut Lowerer, ty: OptType, expr: Expr, plain_copy: bool) -> i64 {
    match ty {
        OptType::Some(vt) => {
            var vcode: i64 = lw_vec_elem_code(vt);
            if vcode != 0 && lw_is_vec_new_expr(expr) && Lowerer_has_function(self, "Vec_new_sized") {
                return Lowerer_emit_vec_new_sized(self, vcode);
            }
        }
        OptType::None => {
        }
    }
    return Lowerer_lower_let_value(self, expr, plain_copy);
}

/// An empty Vec of element code `code` (core's Vec_new_sized).
fn Lowerer_emit_vec_new_sized(self: & mut Lowerer, code: i64) -> i64 {
    var env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var c: i64 = Lowerer_emit_inst(self, Inst::ConstInt(code, IrType::I64));
    var args: Vec<i64> = Vec::new();
    args.push(env);
    args.push(c);
    return Lowerer_emit_inst(self, Inst::Call("Vec_new_sized", args, IrType::Opaque("Vec"), EffectSet_new()));
}

/// roadmap L6C: the function type of a `let` bound straight from a symbol
/// lookup (`val f: fn(f64) -> f64 = p_dl_find(lib, "sqrt")`, or p_dl_sym),
/// aliases resolved; None for any other `let`.
fn Lowerer_dl_fn_let_type(self: & Lowerer, ty: OptType, expr: Expr) -> OptType {
    match expr {
        Expr::Call(callee, _) => {
            if callee != "p_dl_find" && callee != "p_dl_sym" {
                return OptType::None;
            }
        }
        _ => {
            return OptType::None;
        }
    }
    match ty {
        OptType::Some(t) => {
            var rt: Type = Lowerer_resolve_type(self, t);
            match rt {
                Type::Func(_, _) => {
                    return OptType::Some(rt);
                }
                _ => {
                }
            }
        }
        OptType::None => {
        }
    }
    return OptType::None;
}

/// IrType::Struct(name) for `ir`, the IR type of an instance of a generic
/// struct of the program (IrType::Generic("Pair", ..): its values are laid
/// out as the struct's one layout), else `ir`.
fn Lowerer_generic_struct_ir(self: & Lowerer, ir: IrType) -> IrType {
    match ir {
        IrType::Generic(gname, _) => {
            var rn: str = Lowerer_resolve_struct_name(self, gname);
            if rn == "Vec" || rn == "HashMap" || rn == "Box" || rn == "Rc" || rn == "Arc" {
                return ir;
            }
            match Lowerer_lookup_struct(self, rn) {
                OptStructDef::Some(sd) => {
                    if sd.type_params.len() == 0 {
                        return ir;
                    }
                    match IrModule_get_struct(& self.module, rn) {
                        OptStructLayout::Some(_) => {
                            return IrType::Struct(rn);
                        }
                        OptStructLayout::None => {
                        }
                    }
                }
                OptStructDef::None => {
                }
            }
        }
        _ => {
        }
    }
    return ir;
}

fn Lowerer_lower_let_stmt(self: & mut Lowerer, name: str, ty: OptType, expr: Expr, _is_mut: bool, is_persist: bool, annotations: Vec<Annotation>, _line: i64) {
    // RT6: `var v = Vec::new()` the type checker typed from its first push
    match Lowerer_rt6_let_type(self, name, ty, expr, _line) {
        OptType::Some(rt6_ty) => {
            Lowerer_lower_let_stmt(self, name, OptType::Some(rt6_ty), expr, _is_mut, is_persist, annotations, _line);
            return;
        }
        OptType::None => {
        }
    }
    // roadmap L6C: `val f: fn(f64) -> f64 = p_dl_find(lib, "sqrt")` (or
    // p_dl_sym) binds a C function's address with the function type the
    // type checker checked (TypeChecker_check_dl_sym). It is lowered as
    // `addr as fn(..)`: the env with the `__fid_c_fnptr` marker, so a call
    // through `f` calls the address as a plain C function (no __env), with
    // the call's C types (codegen_c CallPtr), instead of as a closure.
    match Lowerer_dl_fn_let_type(self, ty, expr) {
        OptType::Some(dl_fty) => {
            Lowerer_lower_let_stmt(self, name, ty, Expr::Cast(Box::new(expr), dl_fty), _is_mut, is_persist, annotations, _line);
            return;
        }
        OptType::None => {
        }
    }
    // V1a (miscompile-log): a literal on the left of `<<`/`>>` in the value
    // of a narrow integer `val`/`var` has the declared type (§3.5):
    // `var b: u16 = (2 << a) - 62` shifts and subtracts in u16
    match ty {
        OptType::Some(v1a_t) => {
            if lw_ast_narrow_int(v1a_t) && lw_has_lit_shift(expr) {
                var v1a_e: Expr = lw_ctx_type_literals(expr, v1a_t, Lowerer_lower_type(self, v1a_t));
                if !lw_has_lit_shift(v1a_e) {
                    Lowerer_lower_let_stmt(self, name, ty, v1a_e, _is_mut, is_persist, annotations, _line);
                    return;
                }
            }
        }
        OptType::None => {
        }
    }
    var saved_hint: OptType = self.let_hint;
    match ty {
        OptType::Some(t) => {
            self.let_hint = OptType::Some(Lowerer_resolve_self_in_type(self, t));
        }
        OptType::None => {
        }
    }

    // A copy nobody writes needed no copy-on-write share (proposal 0001);
    // CM3: with that sharing retired there is none to leave out
    var plain_copy: bool = false;
    var lval: i64 = - 1;
    // A copy only read while its source cannot change borrows it: no count,
    // and the variable drops nothing (proposal 0004)
    var borrow_copy: bool = self.own_on && Lowerer_rc_borrow_copy_ok(self, name, expr);
    if borrow_copy {
        lval = Lowerer_lower_expr(self, expr);
    }
    if self.own_on && !borrow_copy {
        match ty {
            OptType::Some(dt) => {
                if lw_is_vec_new_expr(expr) || lw_rc_is_map_new_expr(expr) {
                    lval = Lowerer_rc_new_coll(self, Lowerer_resolve_self_in_type(self, dt));
                }
                var fargs: Vec<Expr> = lw_vec_filled_args(expr);
                if fargs.len() == 2 && Lowerer_has_function(self, "Vec_filled_typed") {
                    lval = Lowerer_lower_vec_filled(self, fargs, Lowerer_resolve_self_in_type(self, dt));
                }
            }
            OptType::None => {
            }
        }
    }
    if lval < 0 {
        lval = Lowerer_rc_move_last(self, expr);
    }
    if lval < 0 {
        lval = Lowerer_lower_let_value_typed(self, ty, expr, plain_copy);
    }
    // An integer initialiser of a float variable is the number (`val f: f64 = 3`,
    // `val f: f64 = n`): Lowerer_int_to_float_value
    match ty {
        OptType::Some(i2f_t) => {
            lval = Lowerer_int_to_float_value(self, lval, Lowerer_lower_type(self, Lowerer_resolve_self_in_type(self, i2f_t)));
        }
        OptType::None => {
        }
    }
    // Ownership (proposal 0004): the variable keeps its value
    var own_ty: Type = Type::Infer;
    if self.own_on && !borrow_copy {
        match ty {
            OptType::Some(dt2) => {
                own_ty = Lowerer_resolve_self_in_type(self, dt2);
            }
            OptType::None => {
                own_ty = Lowerer_rc_temp_type(self, lval);
                match own_ty {
                    Type::Infer => {
                        // (a tuple literal that is no temporary owns
                        // nothing: its inferred type may not place its
                        // elements as it does)
                        match expr {
                            Expr::TupleLit(_) => {
                            }
                            _ => {
                                own_ty = Lowerer_rc_expr_type(self, expr);
                            }
                        }
                    }
                    _ => {
                    }
                }
                // a generic struct literal: Pair<i64, str>, not Pair (the
                // literal's own temporary already says which it owns)
                match expr {
                    Expr::StructLit(_, _, _) => {
                        if Lowerer_rc_kind(self, own_ty) == RC_NONE {
                            match Lowerer_infer_expr_ast_type(self, expr) {
                                Type::Generic(gsn, gsa) => {
                                    own_ty = Type::Generic(gsn, gsa);
                                }
                                _ => {
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
        }
        lval = Lowerer_rc_own_value(self, lval, own_ty);
    }
    self.let_hint = saved_hint;
    // A tuple variable holds the tuple inline, a struct of its shape: a
    // value that is its address as a word (a Vec's or a map's element, a
    // parameter) is typed as that address
    var let_tes: Vec<Type> = Vec::new();
    match ty {
        OptType::Some(lt0) => {
            let_tes = Lowerer_rc_tuple_elems(self, Lowerer_resolve_self_in_type(self, lt0));
        }
        OptType::None => {
            let_tes = Lowerer_rc_tuple_elems(self, own_ty);
        }
    }
    if let_tes.len() > 0 {
        lval = Lowerer_rc_tuple_ptr(self, lval, Type::Tuple(let_tes));
    }

    var val_ty: IrType = Lowerer_get_value_type(self, lval);
    var ir_ty: IrType = val_ty;
    match ty {
        OptType::Some(t) => {
            // A generic struct instance (`Pair<str, i64>`) is held inline as
            // the struct, as an unannotated `val p = Pair { .. }` is: as a
            // Generic its slot kept a pointer to the value, which no owner
            // dropped (its strings leaked)
            var declared_ir: IrType = Lowerer_generic_struct_ir(self, Lowerer_lower_type(self, t));
            // CI5: an array value is its pointer (as the OptType::None
            // branch below keeps it), so a declared `[T; N]` slot holds that
            // pointer; an Array-typed slot got the pointer stored into it
            // (the interpreter read garbage, C wrote `int64_t[3] v = 0`)
            var declared_arr: bool = false;
            match declared_ir {
                IrType::Array(_, _) => {
                    declared_arr = true;
                }
                _ => {
                }
            }
            // a declared tuple: the slot is the value's tuple struct when
            // it places the elements as the declared type's layout does
            // (the drop reads them there), else the declared layout
            var let_tuple_slot: str = "";
            if let_tes.len() > 0 {
                var ltn: str = "";
                match Lowerer_key_tuple_ir(self, let_tes) {
                    IrType::Struct(ltd) => {
                        ltn = ltd;
                    }
                    _ => {
                    }
                }
                var lvn: str = lw_tuple_struct_name(val_ty);
                if str_len(lvn) > 0 && str_len(ltn) > 0 && Lowerer_tuple_layouts_agree(self, lvn, ltn) {
                    let_tuple_slot = lvn;
                }
            }
            if str_len(let_tuple_slot) > 0 {
                ir_ty = IrType::Struct(let_tuple_slot);
            } else if declared_arr {
                ir_ty = IrType::Ptr(Box::new(declared_ir));
            } else if ir_type_is_aggregate(declared_ir) && ir_type_is_ptr(val_ty) {
                match val_ty {
                    IrType::Ptr(inner) => {
                        if ir_type_eq(box_ir_type_unbox(inner), declared_ir) {
                            ir_ty = declared_ir;
                        } else {
                            ir_ty = val_ty;
                        }
                    }
                    _ => {
                        ir_ty = val_ty;
                    }
                }
            } else {
                ir_ty = declared_ir;
            }
        }
        OptType::None => {
            // Bug 3.18 fix: When there's no declared type and the value is a
            // Ptr(Struct(...)) returned from a function (SRET pattern), use
            // the inner struct type for the alloca so it holds the full struct
            // data inline. Otherwise the alloca is only 8 bytes (pointer size),
            // and a later Assign with store_ty=Some(Struct) will memcpy the
            // full struct into an 8-byte buffer, causing a buffer overflow.
            match val_ty {
                IrType::Ptr(inner) => {
                    var inner_ty: IrType = box_ir_type_unbox(inner);
                    // Structs only: an array value is its pointer (as in
                    // src/lower.rs), and the slot must hold that pointer;
                    // an Array-typed slot got the pointer stored into it
                    // and `int64_t[N] v = 0` declarations in the C.
                    match inner_ty {
                        IrType::Struct(_) => {
                            ir_ty = inner_ty;
                        }
                        _ => {
                            ir_ty = val_ty;
                        }
                    }
                }
                IrType::I64 => {
                    // `var w = v.clone()`: core's Vec_clone returns the Vec as
                    // an i64; the method's own result type keeps it a Vec (it
                    // printed as a number)
                    ir_ty = val_ty;
                    match expr {
                        Expr::MethodCall(_, _, _) => {
                            match Lowerer_infer_expr_type(self, expr) {
                                IrType::Generic(gn, gargs) => {
                                    if gn == "Vec" || gn == "HashMap" {
                                        ir_ty = IrType::Generic(gn, gargs);
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                    ir_ty = val_ty;
                }
            }
        }
    }

    // An owning variable's slot is made and zeroed in the entry block
    var own_kind: i64 = RC_NONE;
    if self.own_on && !is_persist {
        own_kind = Lowerer_rc_kind(self, own_ty);
    }
    if own_kind == RC_MEM {
        match ir_ty {
            IrType::Struct(_) => {
            }
            _ => {
                own_kind = RC_NONE;
            }
        }
    }
    var alloca: i64 = 0;
    if own_kind != RC_NONE {
        alloca = Lowerer_rc_new_slot(self, ir_ty, own_ty);
    } else {
        alloca = Lowerer_emit_inst(self, Inst::Alloca(ir_ty, Lowerer_current_region(self)));
    }
    Lowerer_insert_alloca_type(self, alloca, ir_ty);

    if is_persist {
        var loaded: i64 = Lowerer_emit_inst(self, Inst::PersistLoad(name, lval, ir_ty));
        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, loaded, OptIrType::None));
        self.current_func.persist_vars.push(StringValueId_new(name, alloca));
    } else {
        var store_ty: OptIrType = OptIrType::None;
        match ir_ty {
            IrType::Struct(_) => {
                store_ty = OptIrType::Some(ir_ty);
            }
            _ => {
            }
        }
        // M5/M21: an array variable holds a pointer to its data, so
        // `var b = a` of a place (a variable, a field, an element) copies
        // the data into a buffer of b's own — sharing the pointer made
        // `b[0] = x` write a's array
        var store_val: i64 = lval;
        match ir_ty {
            IrType::Ptr(slot_ptr_ty) => {
                var slot_arr_ty: IrType = box_ir_type_unbox(slot_ptr_ty);
                match slot_arr_ty {
                    IrType::Array(_, _) => {
                        if lw_is_place_expr(expr) {
                            var arr_buf: i64 = Lowerer_emit_inst(self, Inst::Alloca(slot_arr_ty, Lowerer_current_region(self)));
                            var arr_words: i64 = (IrModule_type_size(& self.module, slot_arr_ty) + 7) / 8;
                            var ac_args: Vec<i64> = Vec::new();
                            ac_args.push(Lowerer_rc_env(self));
                            ac_args.push(Lowerer_rc_as_i64(self, arr_buf));
                            ac_args.push(Lowerer_rc_as_i64(self, lval));
                            ac_args.push(Lowerer_emit_inst(self, Inst::ConstInt(arr_words, IrType::I64)));
                            Lowerer_emit_inst(self, Inst::Call("p_copy_words", ac_args, IrType::Void, lw_rc_eff()));
                            store_val = arr_buf;
                        }
                    }
                    _ => {
                    }
                }
            }
            // BG369: `var q = s.a` of a `[T; N]` field: the field's value
            // is typed as the array itself (a struct field holds the
            // address of its elements, read back as that word), so the
            // slot is too; q gets a buffer of its own as for a variable
            // (`q[1] = x` wrote into s.a, and into every copy of s)
            IrType::Array(_, _) => {
                if lw_is_place_expr(expr) {
                    var farr_buf: i64 = Lowerer_emit_inst(self, Inst::Alloca(ir_ty, Lowerer_current_region(self)));
                    var farr_words: i64 = (IrModule_type_size(& self.module, ir_ty) + 7) / 8;
                    var fac_args: Vec<i64> = Vec::new();
                    fac_args.push(Lowerer_rc_env(self));
                    fac_args.push(Lowerer_rc_as_i64(self, farr_buf));
                    fac_args.push(Lowerer_rc_as_i64(self, lval));
                    fac_args.push(Lowerer_emit_inst(self, Inst::ConstInt(farr_words, IrType::I64)));
                    Lowerer_emit_inst(self, Inst::Call("p_copy_words", fac_args, IrType::Void, lw_rc_eff()));
                    store_val = farr_buf;
                }
            }
            _ => {
            }
        }
        // A struct copied from a place has its Vec fields shared by the
        // Store (Lowerer_emit_inst); a fresh struct or a copy nobody writes
        // keeps the handles it has (proposal 0001)
        self.no_struct_share = plain_copy || !lw_is_place_expr(expr) || lw_is_last_use(self, expr);
        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, store_val, store_ty));
        self.no_struct_share = false;
        if own_kind != RC_NONE {
            Lowerer_rc_add_slot(self, alloca, own_ty);
        } else {
            // BG431: a closure only called afterwards releases its env
            Lowerer_rc_note_closure_var(self, name, expr, lval, alloca);
        }
    }

    Lowerer_insert_alloca(self, name, alloca);

    match ty {
        OptType::Some(ast_ty) => {
            Lowerer_insert_var_ast_type(self, name, ast_ty);
        }
        OptType::None => {
            // The type ownership worked out for the value (a struct
            // literal's, a call's): without it `var t = s` of an
            // unannotated struct `s` took no owner of its Vec fields, so
            // `t.v.push(..)` changed `s.v` too (known-bugs 2g.3)
            var known_own: bool = false;
            if self.own_on && Lowerer_rc_kind(self, own_ty) != RC_NONE {
                Lowerer_insert_var_ast_type(self, name, own_ty);
                known_own = true;
            }
            if !known_own {
                var inferred: Type = Lowerer_infer_expr_ast_type(self, expr);
                match inferred {
                    Type::I64 => {
                    }
                    _ => {
                        Lowerer_insert_var_ast_type(self, name, inferred);
                    }
                }
            }
        }
    }

    var drop_struct: OptStringLower = OptStringLower::None;
    match ty {
        OptType::Some(t) => {
            var sn: OptStringLower = Lowerer_type_struct_name(self, t);
            match sn {
                OptStringLower::Some(name2) => {
                    if Lowerer_has_drop_impl(self, name2) {
                        drop_struct = OptStringLower::Some(name2);
                    }
                }
                OptStringLower::None => {
                }
            }
        }
        OptType::None => {
            // A fresh value of a struct with `drop` (a struct literal or a
            // call's result) is dropped at scope exit as with an annotated
            // `val g: Guard = ...`: `val g = Guard { id: 5 };` dropped
            // nothing (test_drop_untyped.fd). A copy of another variable
            // (borrow_copy, or any other expression) stays as it was.
            var fresh_val: bool = false;
            match expr {
                Expr::StructLit(_, _, _) => {
                    fresh_val = true;
                }
                Expr::Call(_, _) => {
                    fresh_val = true;
                }
                Expr::MethodCall(_, _, _) => {
                    fresh_val = true;
                }
                _ => {
                }
            }
            if fresh_val && !borrow_copy {
                match Lowerer_type_struct_name(self, Lowerer_infer_expr_ast_type(self, expr)) {
                    OptStringLower::Some(name3) => {
                        if Lowerer_has_drop_impl(self, name3) {
                            drop_struct = OptStringLower::Some(name3);
                        }
                    }
                    OptStringLower::None => {
                    }
                }
            }
        }
    }

    Lowerer_bind_local(self, name, alloca);
    match drop_struct {
        OptStringLower::Some(struct_name) => {
            self.current_func.drop_locals.push(lw_ValueIdString_new(alloca, struct_name));
        }
        OptStringLower::None => {
        }
    }
    // LF20: a secret local: the function's frame is wiped at exit (nat_ir),
    // and its slot seeds the values nat_ir keeps in registers first
    if has_annotation(annotations, "secret") || has_annotation(annotations, "sensitive") || has_annotation(annotations, "zeroize") {
        self.current_func.has_secret = true;
        self.current_func.secret_values.push(alloca);
    }
    // F88: @zeroize — track locals to zero at scope exit
    if has_annotation(annotations, "zeroize") {
        var size: i64 = ir_type_size(ir_ty);
        if size > 0 {
            self.current_func.zeroize_locals.push(ValueIdU64_new(alloca, size));
            Lowerer_mark_sensitive(self, alloca, ir_ty);
        }
    }
}

fn Lowerer_lower_index_assign_stmt(self: & mut Lowerer, array_name: Box<Expr>, index: Expr, op: AssignOp, expr: Expr, _line: i64) {
    var arr_val: i64 = 0;
    var ia_global: bool = false;
    match lw_box_expr_unbox(array_name) {
        Expr::Ident(name) => {
            match Lowerer_lookup_alloca(self, name) {
                OptValueId::Some(alloca) => {
                    var alloca_ty: IrType = IrType::I64;
                    match Lowerer_lookup_alloca_type(self, alloca) {
                        OptIrType::Some(t) => {
                            alloca_ty = t;
                        }
                        OptIrType::None => {
                        }
                    }
                    arr_val = Lowerer_emit_inst(self, Inst::Load(alloca, alloca_ty));
                }
                OptValueId::None => {
                    match Lowerer_lookup_local(self, name) {
                        OptValueId::Some(local) => {
                            arr_val = local;
                        }
                        OptValueId::None => {
                            // A module-level global Vec or array (known-bugs
                            // 2g.74): read as an identifier is (the Vec handle
                            // it holds; a struct global is its address)
                            match IrModule_get_global(& self.module, name) {
                                OptGlobalLookup::Some(_, _) => {
                                    arr_val = Lowerer_lower_expr(self, Expr::Ident(name));
                                    ia_global = true;
                                }
                                OptGlobalLookup::None => {
                                    arr_val = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                                }
                            }
                        }
                    }
                }
            }
        }
        _ => {
            arr_val = Lowerer_lower_expr(self, lw_box_expr_unbox(array_name));
        }
    }

    // `v[i] = x` through a `&mut Vec<T>` (a parameter's slot holds the
    // address of the caller's Vec): the Vec it points at, as a method call
    // on it reads it (it was written as a plain array, into the pointer)
    arr_val = Lowerer_auto_deref_recv(self, arr_val, Lowerer_get_value_type(self, arr_val));
    var idx_val: i64 = Lowerer_lower_expr(self, index);
    var arr_ty: IrType = Lowerer_get_value_type(self, arr_val);

    if ir_type_is_opaque_named(arr_ty, "Vec") {
        var vec_elem_ty: IrType = IrType::I64;
        match arr_ty {
            IrType::Generic(gname, gargs) => {
                if gname == "Vec" && gargs.len() > 0 {
                    vec_elem_ty = gargs.get(0);
                }
            }
            IrType::Opaque(_) => {
                match lw_box_expr_unbox(array_name) {
                    Expr::Ident(vname) => {
                        match Lowerer_lookup_var_ast_type(self, vname) {
                            OptType::Some(at) => {
                                var inner_ty: Type = at;
                                match at {
                                    Type::Ref(inner, _) => {
                                        inner_ty = lw_box_type_unbox(inner);
                                    }
                                    _ => {
                                    }
                                }
                                match inner_ty {
                                    Type::Generic(an, aargs) => {
                                        if an == "Vec" && aargs.len() > 0 {
                                            vec_elem_ty = Lowerer_lower_type(self, aargs.get(0));
                                        }
                                    }
                                    _ => {
                                    }
                                }
                            }
                            OptType::None => {
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            _ => {
            }
        }
        // Ownership (proposal 0004): the Vec keeps an owner of the element
        // (Vec_set drops the old one)
        var iet: Type = Type::Infer;
        if self.own_on {
            iet = Lowerer_rc_vec_elem_ast(self, lw_box_expr_unbox(array_name));
            // a global's AST type is not recorded here: a Vec<str> global
            // (2g.74) still keeps an owner of the string it is given
            match iet {
                Type::Infer => {
                    if ia_global && ir_type_eq(vec_elem_ty, lw_ptr_u8()) {
                        iet = Type::Str;
                    }
                }
                _ => {
                }
            }
        }
        // a tuple element is a struct of its shape (as a push stores it,
        // Lowerer_box_vec_element)
        var ia_tes: Vec<Type> = Lowerer_rc_tuple_elems(self, Lowerer_rc_vec_elem_ast(self, lw_box_expr_unbox(array_name)));
        if ia_tes.len() > 0 {
            vec_elem_ty = Lowerer_key_tuple_ir(self, ia_tes);
            iet = Type::Tuple(ia_tes);
        }
        match op {
            AssignOp::Assign => {
                var set_val: i64 = Lowerer_lower_owned(self, expr, iet);
                set_val = Lowerer_rc_tuple_ptr(self, set_val, iet);
                // BG131: an instance of a generic enum (Option<T>, Result<T,
                // E>) or struct is stored as its layout, as a push stores it
                // (Lowerer_box_vec_element), not as the address of its slot
                var set_ety: IrType = vec_elem_ty;
                match set_ety {
                    IrType::Struct(_) => {
                    }
                    _ => {
                        set_ety = Lowerer_generic_inst_struct_ir(self, Lowerer_rc_vec_elem_ast(self, lw_box_expr_unbox(array_name)));
                    }
                }
                if Lowerer_vec_set_mem(self, arr_val, idx_val, set_val, set_ety, iet) {
                    return;
                }
                match vec_elem_ty {
                    IrType::Struct(_) => {
                        var size: i64 = IrModule_type_size(& self.module, vec_elem_ty);
                        if size <= 0 {
                            size = 8;
                        }
                        var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(size, IrType::I64));
                        var heap_ptr: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", lw_c_vec1_i64(size_val), IrType::Ptr(Box::new(vec_elem_ty)), EffectSet_new()));
                        Lowerer_emit_inst(self, Inst::Store(heap_ptr, set_val, OptIrType::Some(vec_elem_ty)));
                        set_val = heap_ptr;
                    }
                    _ => {
                    }
                }
                var args: Vec<i64> = Vec::new();
                args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
                // __env
                args.push(arr_val);
                args.push(idx_val);
                args.push(set_val);
                var _c: i64 = Lowerer_emit_inst(self, Inst::Call("Vec_set", args, IrType::Void, EffectSet_new()));
            }
            _ => {
                var get_args: Vec<i64> = Vec::new();
                get_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
                // __env
                get_args.push(arr_val);
                get_args.push(idx_val);
                var get_ret_ty: IrType = word_repr(vec_elem_ty);
                var current: i64 = Lowerer_emit_inst(self, Inst::Call("Vec_get", get_args, get_ret_ty, EffectSet_new()));
                // BG30: a string element read as a word is a string, so
                // `v[i] += s` concatenates (Lowerer_lower_compound_assign)
                if Lowerer_rc_kind(self, iet) == RC_STR && !ir_type_eq(get_ret_ty, lw_ptr_u8()) {
                    current = Lowerer_emit_inst(self, Inst::BitCast(current, get_ret_ty, lw_ptr_u8()));
                }
                var rhs: i64 = Lowerer_lower_expr(self, expr);
                var new_val: i64 = Lowerer_lower_compound_assign(self, op, current, rhs);
                new_val = Lowerer_rc_own_value(self, new_val, iet);
                if Lowerer_vec_set_mem(self, arr_val, idx_val, new_val, vec_elem_ty, iet) {
                    return;
                }
                match vec_elem_ty {
                    IrType::Struct(_) => {
                        var size: i64 = IrModule_type_size(& self.module, vec_elem_ty);
                        if size <= 0 {
                            size = 8;
                        }
                        var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(size, IrType::I64));
                        var heap_ptr: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", lw_c_vec1_i64(size_val), IrType::Ptr(Box::new(vec_elem_ty)), EffectSet_new()));
                        Lowerer_emit_inst(self, Inst::Store(heap_ptr, new_val, OptIrType::Some(vec_elem_ty)));
                        new_val = heap_ptr;
                    }
                    _ => {
                    }
                }
                var set_args: Vec<i64> = Vec::new();
                set_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
                // __env
                set_args.push(arr_val);
                set_args.push(idx_val);
                set_args.push(new_val);
                var _c2: i64 = Lowerer_emit_inst(self, Inst::Call("Vec_set", set_args, IrType::Void, EffectSet_new()));
            }
        }
    } else {
        var elem_ty: IrType = IrType::I64;
        match arr_ty {
            IrType::Array(inner, _) => {
                elem_ty = inner;
            }
            _ => {
            }
        }
        // M6: the index is checked against the array's length
        Lowerer_emit_array_bound_check(self, arr_ty, idx_val);
        var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(arr_val, idx_val, elem_ty));
        match op {
            AssignOp::Assign => {
                var val: i64 = Lowerer_lower_expr(self, expr);
                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(elem_ptr, val, OptIrType::None));
            }
            _ => {
                var current: i64 = Lowerer_emit_inst(self, Inst::Load(elem_ptr, elem_ty));
                var rhs: i64 = Lowerer_lower_expr(self, expr);
                var new_val: i64 = Lowerer_lower_compound_assign(self, op, current, rhs);
                var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(elem_ptr, new_val, OptIrType::None));
                // BG30: the element keeps the new string (an array's `=`
                // takes no owner, so the old one is left as it is)
                var _ac: bool = Lowerer_rc_claim(self, new_val);
            }
        }
    }
}

/// BG241: `select` asks p_chan_try_recv_into whether a value was taken (1
/// or 0, the value written to a slot), not p_chan_try_recv's in-band
/// "nothing ready" word, which is a value a channel can carry. Off: the old
/// in-band test (for a runtime without p_chan_try_recv_into).
const LOWER_SELECT_READY_OUT: bool = true;

fn Lowerer_lower_select_stmt(self: & mut Lowerer, cases: Vec<SelectCase>, default: OptStmts, _line: i64) {
    var merge_block: i64 = Lowerer_new_block(self);

    if cases.len() == 0 {
        match default {
            OptStmts::Some(def_body) => {
                var di: i64 = 0;
                while di < def_body.len() {
                    Lowerer_lower_stmt(self, def_body.get(di));
                    di = di + 1;
                }
            }
            OptStmts::None => {
            }
        }
        if !Lowerer_current_block_has_terminator(self) {
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));
        }
        Lowerer_set_current_block(self, merge_block);
        return;
    }

    var chan_vals: Vec<i64> = Vec::new();
    var ci: i64 = 0;
    while ci < cases.len() {
        var case: SelectCase = cases.get(ci);
        chan_vals.push(Lowerer_lower_expr(self, case.channel));
        ci = ci + 1;
    }

    // 2g.109: the slots in the entry block (a case's variable, made in one
    // case's block, was found by name in the next case and in a later
    // select, blocks it does not dominate)
    var recv_alloca: i64 = Lowerer_txn_raw_slot(self, IrType::I64);

    var case_blocks: Vec<i64> = Vec::new();
    var next_poll_blocks: Vec<i64> = Vec::new();
    ci = 0;
    while ci < cases.len() {
        case_blocks.push(Lowerer_new_block(self));
        next_poll_blocks.push(Lowerer_new_block(self));
        ci = ci + 1;
    }
    var default_block: i64 = Lowerer_new_block(self);

    Lowerer_emit_terminator(self, Inst::Jump(next_poll_blocks.get(0)));

    ci = 0;
    while ci < cases.len() {
        Lowerer_set_current_block(self, next_poll_blocks.get(ci));
        var try_recv_args: Vec<i64> = Vec::new();
        try_recv_args.push(chan_vals.get(ci));
        var is_ready: i64 = 0;
        if LOWER_SELECT_READY_OUT {
            // BG241: whether a value was taken comes out of band (the
            // runtime's 1 or 0); the value, or 0 from a closed channel, is
            // written to the slot. The in-band "nothing ready" word
            // -9223372036854775807 was a value a channel can carry: one
            // received was taken from the channel and treated as nothing.
            try_recv_args.push(Lowerer_rc_as_i64(self, recv_alloca));
            // it writes the slot: never dropped, merged or moved
            var rr_eff: EffectSet = EffectSet_new();
            EffectSet_add(& mut rr_eff, Effect::Write);
            EffectSet_add(& mut rr_eff, Effect::IO);
            var ready_word: i64 = Lowerer_emit_inst(self, Inst::Call("p_chan_try_recv_into", try_recv_args, IrType::I64, rr_eff));
            var not_ready: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            is_ready = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Neq, ready_word, not_ready, IrType::Bool));
        } else {
            var try_recv: i64 = Lowerer_emit_inst(self, Inst::Call("p_chan_try_recv", try_recv_args, IrType::I64, EffectSet_new()));
            var _s: i64 = Lowerer_emit_inst(self, Inst::Store(recv_alloca, try_recv, OptIrType::None));
            var sentinel: i64 = Lowerer_emit_inst(self, Inst::ConstInt(- 9223372036854775807, IrType::I64));
            is_ready = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Neq, try_recv, sentinel, IrType::Bool));
        }
        var next_block: i64 = 0;
        if ci + 1 < cases.len() {
            next_block = next_poll_blocks.get(ci + 1);
        } else {
            next_block = default_block;
        }
        Lowerer_emit_terminator(self, Inst::Branch(is_ready, case_blocks.get(ci), next_block));
        ci = ci + 1;
    }

    ci = 0;
    while ci < cases.len() {
        Lowerer_set_current_block(self, case_blocks.get(ci));
        var recv_val: i64 = Lowerer_emit_inst(self, Inst::Load(recv_alloca, IrType::I64));
        var case: SelectCase = cases.get(ci);
        // BG78: the case's variable is a new one, seen in its body only (as
        // a match arm's binding). It was stored into an outer variable of
        // the same name, which the select changed, and kept after the case.
        var saved_allocas_len: i64 = self.allocas.len();
        var saved_alloca_types_len: i64 = self.alloca_types.len();
        var saved_var_ast_types_len: i64 = self.var_ast_types.len();
        var saved_locals_len: i64 = self.current_func.locals.len();
        var alloca: i64 = Lowerer_txn_raw_slot(self, IrType::I64);
        Lowerer_insert_alloca_type(self, alloca, IrType::I64);
        var _s3: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, recv_val, OptIrType::None));
        Lowerer_insert_alloca(self, case.var_name, alloca);
        Lowerer_bind_local(self, case.var_name, alloca);
        // an outer variable's type is not the received word's
        match Lowerer_lookup_var_ast_type(self, case.var_name) {
            OptType::Some(_) => {
                Lowerer_insert_var_ast_type(self, case.var_name, Type::Infer);
            }
            OptType::None => {
            }
        }
        var bi: i64 = 0;
        while bi < case.body.len() {
            Lowerer_lower_stmt(self, case.body.get(bi));
            bi = bi + 1;
        }
        if !Lowerer_current_block_has_terminator(self) {
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));
        }
        self.allocas.truncate(saved_allocas_len);
        self.alloca_types.truncate(saved_alloca_types_len);
        self.var_ast_types.truncate(saved_var_ast_types_len);
        self.current_func.locals.truncate(saved_locals_len);
        ci = ci + 1;
    }

    Lowerer_set_current_block(self, default_block);
    match default {
        OptStmts::Some(def_body) => {
            var di: i64 = 0;
            while di < def_body.len() {
                Lowerer_lower_stmt(self, def_body.get(di));
                di = di + 1;
            }
        }
        OptStmts::None => {
        }
    }
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(merge_block));
    }
    Lowerer_set_current_block(self, merge_block);
}

/// A statement owns the temporaries it makes: they are dropped at its end
/// unless something kept them (proposal 0004).
// --- Regions freed in one step (proposal 0005) ---
//
// With FID_REGION_ARENA=1 at compile time, a region with no `await`,
// `yield` or effect operation in it gets an arena of its own: at its start
// p_region_word(7, 0) makes the region the current one, and at its end
// p_region_word(8, 0) releases everything allocated in it at once (the C
// runtime; elsewhere p_region_word is 0 and regions stay scopes). Core
// copies a value out of a region when something outside keeps it (Str_dup,
// Vec_share, HashMap_share, Box_dup_t); the lowering's part is to run the
// code that keeps a value outside a region with that place's region current
// ("parent mode"):
// - a statement that assigns to a variable declared outside, changes one
//   through a method or `&mut`, sends or spawns (Lowerer_rg_stmt_out);
// - a return, `?` or break leaves the regions it exits before its value is
//   kept (Lowerer_rg_leave);
// - a call that may keep a value in a global, a channel, another task or
//   C code runs with no region current (lw_rg_calls, after lowering), and a
//   function with regions leaves them at each return (lw_rg_unwind).
// In parent mode a value handed over (a temporary) is copied out too
// (Lowerer_rg_keep_out).

/// Regions more than any function has: "leave them all, to the heap".
const RG_ALL: i64 = 1000000;

fn lw_rg_env_on() -> bool {
    match env_var("FID_REGION_ARENA") {
        Option::Some(v) => {
            return v == "1";
        }
        Option::None => {
        }
    }
    return false;
}

/// The regions with arenas of the function being lowered open here.
fn Lowerer_rg_open(self: & Lowerer) -> i64 {
    var n: i64 = 0;
    var i: i64 = self.rg_fns.len() - 1;
    while i >= 0 {
        if self.rg_fns.get(i) != self.current_func.name {
            return n;
        }
        n = n + 1;
        i = i - 1;
    }
    return n;
}

/// How many of those regions were open where variable `name` was declared:
/// a parameter or anything not found 0, a global -1. A reference variable
/// counts as declared outside them all (what it refers to may be).
fn Lowerer_rg_var_depth(self: & Lowerer, name: str) -> i64 {
    match Lowerer_lookup_var_ast_type(self, name) {
        OptType::Some(t) => {
            match t {
                Type::Ref(_, _) => {
                    return 0;
                }
                _ => {
                }
            }
        }
        OptType::None => {
        }
    }
    match Lowerer_lookup_alloca(self, name) {
        OptValueId::Some(id) => {
            var open: i64 = Lowerer_rg_open(self);
            var base: i64 = self.rg_ids.len() - open;
            var d: i64 = 0;
            var i: i64 = 0;
            while i < open {
                if self.rg_ids.get(base + i) < id {
                    d = i + 1;
                }
                i = i + 1;
            }
            return d;
        }
        OptValueId::None => {
        }
    }
    match IrModule_get_global(& self.module, name) {
        OptGlobalLookup::Some(_, _) => {
            return - 1;
        }
        OptGlobalLookup::None => {
        }
    }
    // not a variable here: a type (`HashMap::new()`) changes nothing; any
    // other name counts as declared outside every region
    var c0: i64 = str_byte_at(name, 0);
    if c0 >= 65 && c0 <= 90 {
        return Lowerer_rg_open(self);
    }
    return 0;
}

/// Regions to leave for a change to variable `name`: those opened since
/// it was declared (RG_ALL for a global).
fn Lowerer_rg_levels_for(self: & Lowerer, name: str) -> i64 {
    var d: i64 = Lowerer_rg_var_depth(self, name);
    if d < 0 {
        return RG_ALL;
    }
    var open: i64 = Lowerer_rg_open(self);
    if d >= open {
        return 0;
    }
    return open - d;
}

/// Whether variable `name` holds a plain number or bool: writing one keeps
/// nothing (`total = total + n` in a region needs no parent mode).
fn Lowerer_rg_scalar_var(self: & Lowerer, name: str) -> bool {
    match Lowerer_lookup_var_ast_type(self, name) {
        OptType::Some(t) => {
            match t {
                Type::I8 => {
                    return true;
                }
                Type::I16 => {
                    return true;
                }
                Type::I32 => {
                    return true;
                }
                Type::I64 => {
                    return true;
                }
                Type::U8 => {
                    return true;
                }
                Type::U16 => {
                    return true;
                }
                Type::U32 => {
                    return true;
                }
                Type::U64 => {
                    return true;
                }
                Type::F32 => {
                    return true;
                }
                Type::F64 => {
                    return true;
                }
                Type::Bool => {
                    return true;
                }
                _ => {
                }
            }
        }
        OptType::None => {
        }
    }
    return false;
}

/// The variable a place expression starts from ("" for a temporary).
fn lw_rg_root(e: Expr) -> str {
    match e {
        Expr::Ident(n) => {
            return n;
        }
        Expr::FieldAccess(b, _) => {
            return lw_rg_root(lw_box_expr_unbox(b));
        }
        Expr::OptionalFieldAccess(b, _) => {
            return lw_rg_root(lw_box_expr_unbox(b));
        }
        Expr::Index(b, _) => {
            return lw_rg_root(lw_box_expr_unbox(b));
        }
        Expr::Deref(b) => {
            return lw_rg_root(lw_box_expr_unbox(b));
        }
        Expr::Ref(b, _) => {
            return lw_rg_root(lw_box_expr_unbox(b));
        }
        _ => {
        }
    }
    return "";
}

/// Methods that only read their receiver (anything else may change it).
fn lw_rg_reads_only(m: str) -> bool {
    return m == "len" || m == "get" || m == "contains" || m == "contains_key" || m == "is_empty" || m == "starts_with" || m == "ends_with" || m == "find" || m == "to_str" || m == "to_string" || m == "clone" || m == "get_or" || m == "first" || m == "last" || m == "index_of" || m == "keys" || m == "values" || m == "split" || m == "trim" || m == "to_upper" || m == "to_lower" || m == "to_uppercase" || m == "to_lowercase" || m == "byte_at" || m == "char_at" || m == "substring" || m == "slice" || m == "eq" || m == "cmp" || m == "hash" || m == "is_some" || m == "is_none" || m == "is_ok" || m == "is_err" || m == "unwrap" || m == "unwrap_or" || m == "expect" || m == "parse_int" || m == "to_int" || m == "abs" || m == "min" || m == "max" || m == "sqrt"
        || m == "find_opt" || m == "position_opt" || m == "take" || m == "skip" || m == "zip" || m == "enumerate" || m == "flat_map" || m == "chunk" || m == "window" || m == "contains_val";
}

fn lw_rg_max(a: i64, b: i64) -> i64 {
    if a > b {
        return a;
    }
    return b;
}

fn Lowerer_rg_exprs_out(self: & Lowerer, es: Vec<Expr>) -> i64 {
    var m: i64 = 0;
    var i: i64 = 0;
    while i < es.len() {
        m = lw_rg_max(m, Lowerer_rg_expr_out(self, es.get(i)));
        i = i + 1;
    }
    return m;
}

fn Lowerer_rg_stmts_out(self: & Lowerer, ss: Vec<Stmt>) -> i64 {
    var m: i64 = 0;
    var i: i64 = 0;
    while i < ss.len() {
        m = lw_rg_max(m, Lowerer_rg_any_stmt_out(self, ss.get(i)));
        i = i + 1;
    }
    return m;
}

fn Lowerer_rg_opt_out(self: & Lowerer, e: OptBoxExpr) -> i64 {
    match e {
        OptBoxExpr::Some(b) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(b));
        }
        OptBoxExpr::None => {
        }
    }
    return 0;
}

/// Regions an expression's evaluation must leave for what it keeps or
/// changes (0 none, RG_ALL to the heap): a method that may change a place
/// declared outside a region, a `&mut` argument of one, a send or a spawn.
/// A closure's body is its own function (calls through it run with no
/// region current: lw_rg_calls).
fn Lowerer_rg_expr_out(self: & Lowerer, e: Expr) -> i64 {
    match e {
        Expr::Call(name, args) => {
            var m: i64 = Lowerer_rg_exprs_out(self, args);
            if str_starts_with(name, "spawn") || str_starts_with(name, "thread_spawn") || name == "p_chan_send" || name == "chan_send" || str_starts_with(name, "p_spawn") {
                return RG_ALL;
            }
            var i: i64 = 0;
            while i < args.len() {
                match args.get(i) {
                    Expr::Ref(inner, is_mut) => {
                        if is_mut {
                            var r: str = lw_rg_root(lw_box_expr_unbox(inner));
                            if str_len(r) > 0 {
                                m = lw_rg_max(m, Lowerer_rg_levels_for(self, r));
                            }
                        }
                    }
                    _ => {
                    }
                }
                i = i + 1;
            }
            return m;
        }
        Expr::MethodCall(recv, mname, args) => {
            var re: Expr = lw_box_expr_unbox(recv);
            var m: i64 = lw_rg_max(Lowerer_rg_expr_out(self, re), Lowerer_rg_exprs_out(self, args));
            if mname == "send" || mname == "try_send" || mname == "send_timeout" {
                return RG_ALL;
            }
            if !lw_rg_reads_only(mname) {
                var r: str = lw_rg_root(re);
                if str_len(r) > 0 {
                    m = lw_rg_max(m, Lowerer_rg_levels_for(self, r));
                }
            }
            var i: i64 = 0;
            while i < args.len() {
                match args.get(i) {
                    Expr::Ref(inner, is_mut) => {
                        if is_mut {
                            var r2: str = lw_rg_root(lw_box_expr_unbox(inner));
                            if str_len(r2) > 0 {
                                m = lw_rg_max(m, Lowerer_rg_levels_for(self, r2));
                            }
                        }
                    }
                    _ => {
                    }
                }
                i = i + 1;
            }
            return m;
        }
        Expr::Spawn(_) => {
            return RG_ALL;
        }
        Expr::Binary(_, a, b) => {
            return lw_rg_max(Lowerer_rg_expr_out(self, lw_box_expr_unbox(a)), Lowerer_rg_expr_out(self, lw_box_expr_unbox(b)));
        }
        Expr::StrConcat(a, b) => {
            return lw_rg_max(Lowerer_rg_expr_out(self, lw_box_expr_unbox(a)), Lowerer_rg_expr_out(self, lw_box_expr_unbox(b)));
        }
        Expr::Coalesce(a, b) => {
            return lw_rg_max(Lowerer_rg_expr_out(self, lw_box_expr_unbox(a)), Lowerer_rg_expr_out(self, lw_box_expr_unbox(b)));
        }
        Expr::PipeForward(a, b) => {
            return lw_rg_max(Lowerer_rg_expr_out(self, lw_box_expr_unbox(a)), Lowerer_rg_expr_out(self, lw_box_expr_unbox(b)));
        }
        Expr::Range(a, b, _) => {
            return lw_rg_max(Lowerer_rg_expr_out(self, lw_box_expr_unbox(a)), Lowerer_rg_expr_out(self, lw_box_expr_unbox(b)));
        }
        Expr::Index(a, b) => {
            return lw_rg_max(Lowerer_rg_expr_out(self, lw_box_expr_unbox(a)), Lowerer_rg_expr_out(self, lw_box_expr_unbox(b)));
        }
        Expr::Unary(_, a) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(a));
        }
        Expr::Deref(a) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(a));
        }
        Expr::Try(a) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(a));
        }
        Expr::IsCheck(a, _) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(a));
        }
        Expr::Cast(a, _) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(a));
        }
        Expr::QuantCast(a, _) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(a));
        }
        Expr::Comptime(a) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(a));
        }
        Expr::FieldAccess(a, _) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(a));
        }
        Expr::OptionalFieldAccess(a, _) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(a));
        }
        Expr::Ref(a, _) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(a));
        }
        Expr::NamedArg(_, a) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(a));
        }
        Expr::Await(a) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(a));
        }
        Expr::Yield(a) => {
            return Lowerer_rg_expr_out(self, lw_box_expr_unbox(a));
        }
        Expr::StructLit(_, fields, base) => {
            var m: i64 = Lowerer_rg_opt_out(self, base);
            var i: i64 = 0;
            while i < fields.len() {
                m = lw_rg_max(m, Lowerer_rg_expr_out(self, fields.get(i).value));
                i = i + 1;
            }
            return m;
        }
        Expr::EnumLit(_, _, args) => {
            return Lowerer_rg_exprs_out(self, args);
        }
        Expr::TupleLit(es) => {
            return Lowerer_rg_exprs_out(self, es);
        }
        Expr::ArrayLit(_, es) => {
            return Lowerer_rg_exprs_out(self, es);
        }
        Expr::FString(parts) => {
            var m: i64 = 0;
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(pe) => {
                        m = lw_rg_max(m, Lowerer_rg_expr_out(self, pe));
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                i = i + 1;
            }
            return m;
        }
        Expr::If(c, t, el) => {
            var m: i64 = lw_rg_max(Lowerer_rg_expr_out(self, lw_box_expr_unbox(c)), Lowerer_rg_stmts_out(self, t));
            match el {
                OptStmts::Some(es) => {
                    m = lw_rg_max(m, Lowerer_rg_stmts_out(self, es));
                }
                OptStmts::None => {
                }
            }
            return m;
        }
        Expr::Block(ss) => {
            return Lowerer_rg_stmts_out(self, ss);
        }
        Expr::TryBlock(ss) => {
            return Lowerer_rg_stmts_out(self, ss);
        }
        Expr::ComptimeBlock(ss) => {
            return Lowerer_rg_stmts_out(self, ss);
        }
        Expr::Match(sc, arms) => {
            var m: i64 = Lowerer_rg_expr_out(self, lw_box_expr_unbox(sc));
            var i: i64 = 0;
            while i < arms.len() {
                m = lw_rg_max(m, Lowerer_rg_opt_out(self, arms.get(i).guard));
                m = lw_rg_max(m, Lowerer_rg_stmts_out(self, arms.get(i).body));
                i = i + 1;
            }
            return m;
        }
        _ => {
        }
    }
    return 0;
}

/// What a statement anywhere inside an expression must leave (every kind
/// of statement, with what it nests).
fn Lowerer_rg_any_stmt_out(self: & Lowerer, s: Stmt) -> i64 {
    match s {
        Stmt::If(c, t, el, _) => {
            var m: i64 = lw_rg_max(Lowerer_rg_expr_out(self, c), Lowerer_rg_stmts_out(self, t));
            match el {
                OptStmts::Some(es) => {
                    m = lw_rg_max(m, Lowerer_rg_stmts_out(self, es));
                }
                OptStmts::None => {
                }
            }
            return m;
        }
        Stmt::While(c, b, _) => {
            return lw_rg_max(Lowerer_rg_expr_out(self, c), Lowerer_rg_stmts_out(self, b));
        }
        Stmt::For(_, it, b, _) => {
            return lw_rg_max(Lowerer_rg_expr_out(self, it), Lowerer_rg_stmts_out(self, b));
        }
        Stmt::Loop(b, _) => {
            return Lowerer_rg_stmts_out(self, b);
        }
        Stmt::Match(sc, arms, _) => {
            var m: i64 = Lowerer_rg_expr_out(self, sc);
            var i: i64 = 0;
            while i < arms.len() {
                m = lw_rg_max(m, Lowerer_rg_opt_out(self, arms.get(i).guard));
                m = lw_rg_max(m, Lowerer_rg_stmts_out(self, arms.get(i).body));
                i = i + 1;
            }
            return m;
        }
        Stmt::RegionBlock(_, _, _, _, _, b, _) => {
            return Lowerer_rg_stmts_out(self, b);
        }
        Stmt::Unsafe(b, _) => {
            return Lowerer_rg_stmts_out(self, b);
        }
        Stmt::Sandbox(b, _) => {
            return Lowerer_rg_stmts_out(self, b);
        }
        Stmt::Txn(b, _) => {
            return Lowerer_rg_stmts_out(self, b);
        }
        Stmt::Defer(b, _) => {
            return Lowerer_rg_stmts_out(self, b);
        }
        Stmt::Return(e, _) => {
            return Lowerer_rg_opt_out(self, e);
        }
        Stmt::Break(e, _) => {
            return Lowerer_rg_opt_out(self, e);
        }
        _ => {
        }
    }
    return Lowerer_rg_stmt_out(self, s);
}

/// Regions a statement must leave, lowered as one piece (0: it runs in
/// its region): an assignment to a place declared outside, or what its
/// expressions change (Lowerer_rg_expr_out). A statement that holds other
/// statements leaves for its own head only (a loop's condition, a match's
/// value) — those statements are lowered one by one; one that changes
/// control (a send in a `select`, a spawn scope, a parallel block, a
/// handler) leaves all. Return and break leave on their own
/// (Lowerer_rg_leave).
fn Lowerer_rg_stmt_out(self: & Lowerer, s: Stmt) -> i64 {
    match s {
        Stmt::Let(_, _, e, _, _, _, _) => {
            return Lowerer_rg_expr_out(self, e);
        }
        Stmt::LetTuple(_, e, _, _) => {
            return Lowerer_rg_expr_out(self, e);
        }
        Stmt::Assign(name, _, e, _) => {
            if Lowerer_rg_scalar_var(self, name) {
                return Lowerer_rg_expr_out(self, e);
            }
            return lw_rg_max(Lowerer_rg_levels_for(self, name), Lowerer_rg_expr_out(self, e));
        }
        Stmt::IndexAssign(name, idx, _, e, _) => {
            return lw_rg_max(Lowerer_rg_levels_for(self, name), lw_rg_max(Lowerer_rg_expr_out(self, idx), Lowerer_rg_expr_out(self, e)));
        }
        Stmt::FieldAssign(target, _, _, e, _) => {
            var m: i64 = lw_rg_max(Lowerer_rg_expr_out(self, target), Lowerer_rg_expr_out(self, e));
            var r: str = lw_rg_root(target);
            if str_len(r) > 0 {
                m = lw_rg_max(m, Lowerer_rg_levels_for(self, r));
            } else {
                m = lw_rg_max(m, Lowerer_rg_open(self));
            }
            return m;
        }
        Stmt::DerefAssign(target, _, e, _) => {
            var m: i64 = lw_rg_max(Lowerer_rg_expr_out(self, target), Lowerer_rg_expr_out(self, e));
            var r: str = lw_rg_root(target);
            if str_len(r) > 0 {
                m = lw_rg_max(m, Lowerer_rg_levels_for(self, r));
            } else {
                m = lw_rg_max(m, Lowerer_rg_open(self));
            }
            return m;
        }
        Stmt::Expr(e, _) => {
            return Lowerer_rg_expr_out(self, e);
        }
        Stmt::If(c, _, _, _) => {
            return Lowerer_rg_expr_out(self, c);
        }
        Stmt::While(c, _, _) => {
            return Lowerer_rg_expr_out(self, c);
        }
        Stmt::For(_, it, _, _) => {
            return Lowerer_rg_expr_out(self, it);
        }
        Stmt::Match(sc, arms, _) => {
            var m: i64 = Lowerer_rg_expr_out(self, sc);
            var i: i64 = 0;
            while i < arms.len() {
                m = lw_rg_max(m, Lowerer_rg_opt_out(self, arms.get(i).guard));
                i = i + 1;
            }
            return m;
        }
        Stmt::Do(_, _, _, _) => {
            return RG_ALL;
        }
        Stmt::Resume(_, _, _) => {
            return RG_ALL;
        }
        Stmt::Select(_, _, _) => {
            return RG_ALL;
        }
        Stmt::SpawnScope(_, _) => {
            return RG_ALL;
        }
        Stmt::Parallel(_, _) => {
            return RG_ALL;
        }
        Stmt::Handle(_, _, _) => {
            return RG_ALL;
        }
        Stmt::Query(_, _, _) => {
            return RG_ALL;
        }
        Stmt::GradBlock(_, _, _) => {
            return RG_ALL;
        }
        Stmt::Backward(_, _) => {
            return RG_ALL;
        }
        _ => {
        }
    }
    return 0;
}

/// Whether a region's body may suspend or capture its rest (`await`,
/// `yield`, an effect operation): such a region keeps no arena.
fn lw_rg_suspends(ss: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < ss.len() {
        if lw_rg_stmt_suspends(ss.get(i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn lw_rg_stmt_suspends(s: Stmt) -> bool {
    match s {
        Stmt::Do(_, _, _, _) => {
            return true;
        }
        Stmt::Resume(_, _, _) => {
            return true;
        }
        Stmt::Select(_, _, _) => {
            return true;
        }
        Stmt::Handle(_, _, _) => {
            return true;
        }
        Stmt::Let(_, _, e, _, _, _, _) => {
            return lw_rg_expr_suspends(e);
        }
        Stmt::LetTuple(_, e, _, _) => {
            return lw_rg_expr_suspends(e);
        }
        Stmt::Assign(_, _, e, _) => {
            return lw_rg_expr_suspends(e);
        }
        Stmt::IndexAssign(_, i, _, e, _) => {
            return lw_rg_expr_suspends(i) || lw_rg_expr_suspends(e);
        }
        Stmt::FieldAssign(t, _, _, e, _) => {
            return lw_rg_expr_suspends(t) || lw_rg_expr_suspends(e);
        }
        Stmt::DerefAssign(t, _, e, _) => {
            return lw_rg_expr_suspends(t) || lw_rg_expr_suspends(e);
        }
        Stmt::Expr(e, _) => {
            return lw_rg_expr_suspends(e);
        }
        Stmt::Return(e, _) => {
            match e {
                OptBoxExpr::Some(b) => {
                    return lw_rg_expr_suspends(lw_box_expr_unbox(b));
                }
                OptBoxExpr::None => {
                }
            }
            return false;
        }
        Stmt::If(c, t, el, _) => {
            if lw_rg_expr_suspends(c) || lw_rg_suspends(t) {
                return true;
            }
            match el {
                OptStmts::Some(es) => {
                    return lw_rg_suspends(es);
                }
                OptStmts::None => {
                }
            }
            return false;
        }
        Stmt::While(c, b, _) => {
            return lw_rg_expr_suspends(c) || lw_rg_suspends(b);
        }
        Stmt::For(_, it, b, _) => {
            return lw_rg_expr_suspends(it) || lw_rg_suspends(b);
        }
        Stmt::Loop(b, _) => {
            return lw_rg_suspends(b);
        }
        Stmt::Match(sc, arms, _) => {
            if lw_rg_expr_suspends(sc) {
                return true;
            }
            var i: i64 = 0;
            while i < arms.len() {
                if lw_rg_suspends(arms.get(i).body) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        Stmt::RegionBlock(_, _, _, _, _, b, _) => {
            return lw_rg_suspends(b);
        }
        Stmt::Unsafe(b, _) => {
            return lw_rg_suspends(b);
        }
        Stmt::Sandbox(b, _) => {
            return lw_rg_suspends(b);
        }
        Stmt::Txn(b, _) => {
            return lw_rg_suspends(b);
        }
        Stmt::Defer(b, _) => {
            return lw_rg_suspends(b);
        }
        _ => {
        }
    }
    return false;
}

/// Whether an expression awaits or yields (outside closures, which are
/// functions of their own).
fn lw_rg_expr_suspends(e: Expr) -> bool {
    match e {
        Expr::Await(_) => {
            return true;
        }
        Expr::Yield(_) => {
            return true;
        }
        Expr::Call(_, args) => {
            return lw_rg_exprs_suspend(args);
        }
        Expr::MethodCall(r, _, args) => {
            return lw_rg_expr_suspends(lw_box_expr_unbox(r)) || lw_rg_exprs_suspend(args);
        }
        Expr::Binary(_, a, b) => {
            return lw_rg_expr_suspends(lw_box_expr_unbox(a)) || lw_rg_expr_suspends(lw_box_expr_unbox(b));
        }
        Expr::StrConcat(a, b) => {
            return lw_rg_expr_suspends(lw_box_expr_unbox(a)) || lw_rg_expr_suspends(lw_box_expr_unbox(b));
        }
        Expr::Coalesce(a, b) => {
            return lw_rg_expr_suspends(lw_box_expr_unbox(a)) || lw_rg_expr_suspends(lw_box_expr_unbox(b));
        }
        Expr::PipeForward(a, b) => {
            return lw_rg_expr_suspends(lw_box_expr_unbox(a)) || lw_rg_expr_suspends(lw_box_expr_unbox(b));
        }
        Expr::Index(a, b) => {
            return lw_rg_expr_suspends(lw_box_expr_unbox(a)) || lw_rg_expr_suspends(lw_box_expr_unbox(b));
        }
        Expr::Unary(_, a) => {
            return lw_rg_expr_suspends(lw_box_expr_unbox(a));
        }
        Expr::Try(a) => {
            return lw_rg_expr_suspends(lw_box_expr_unbox(a));
        }
        Expr::Cast(a, _) => {
            return lw_rg_expr_suspends(lw_box_expr_unbox(a));
        }
        Expr::FieldAccess(a, _) => {
            return lw_rg_expr_suspends(lw_box_expr_unbox(a));
        }
        Expr::Ref(a, _) => {
            return lw_rg_expr_suspends(lw_box_expr_unbox(a));
        }
        Expr::Deref(a) => {
            return lw_rg_expr_suspends(lw_box_expr_unbox(a));
        }
        Expr::StructLit(_, fields, _) => {
            var i: i64 = 0;
            while i < fields.len() {
                if lw_rg_expr_suspends(fields.get(i).value) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        Expr::EnumLit(_, _, args) => {
            return lw_rg_exprs_suspend(args);
        }
        Expr::TupleLit(es) => {
            return lw_rg_exprs_suspend(es);
        }
        Expr::ArrayLit(_, es) => {
            return lw_rg_exprs_suspend(es);
        }
        Expr::If(c, t, el) => {
            if lw_rg_expr_suspends(lw_box_expr_unbox(c)) || lw_rg_suspends(t) {
                return true;
            }
            match el {
                OptStmts::Some(es) => {
                    return lw_rg_suspends(es);
                }
                OptStmts::None => {
                }
            }
            return false;
        }
        Expr::Block(ss) => {
            return lw_rg_suspends(ss);
        }
        Expr::TryBlock(ss) => {
            return lw_rg_suspends(ss);
        }
        Expr::Match(sc, arms) => {
            if lw_rg_expr_suspends(lw_box_expr_unbox(sc)) {
                return true;
            }
            var i: i64 = 0;
            while i < arms.len() {
                if lw_rg_suspends(arms.get(i).body) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        _ => {
        }
    }
    return false;
}

fn lw_rg_exprs_suspend(es: Vec<Expr>) -> bool {
    var i: i64 = 0;
    while i < es.len() {
        if lw_rg_expr_suspends(es.get(i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// p_region_word(op, x), a call the optimizer keeps.
fn Lowerer_rg_call(self: & mut Lowerer, op: i64, x: i64) -> i64 {
    var a: Vec<i64> = Vec::new();
    a.push(Lowerer_emit_inst(self, Inst::ConstInt(op, IrType::I64)));
    a.push(Lowerer_emit_inst(self, Inst::ConstInt(x, IrType::I64)));
    return Lowerer_emit_inst(self, Inst::Call("p_region_word", a, IrType::I64, lw_rc_eff()));
}

/// p_region_word(op, v) for a value `v`.
fn Lowerer_rg_call_v(self: & mut Lowerer, op: i64, v: i64) {
    var a: Vec<i64> = Vec::new();
    a.push(Lowerer_emit_inst(self, Inst::ConstInt(op, IrType::I64)));
    a.push(v);
    Lowerer_emit_inst(self, Inst::Call("p_region_word", a, IrType::I64, lw_rc_eff()));
}

/// Leave `n` regions (RG_ALL: all) before keeping a value outside them:
/// the region current before returns (-1 when n is 0). `dirty` marks them:
/// what is kept in them now may come from outside.
fn Lowerer_rg_leave(self: & mut Lowerer, n: i64, dirty: bool) -> i64 {
    if n == 0 {
        return - 1;
    }
    var k: i64 = n;
    if n >= RG_ALL {
        k = - 1;
    }
    if dirty {
        return Lowerer_rg_call(self, 3, k);
    }
    return Lowerer_rg_call(self, 6, k);
}

/// Regions with arenas opened inside the innermost loop being lowered.
fn Lowerer_rg_loop_regions(self: & Lowerer) -> i64 {
    if !self.rg_on || self.rg_loop_marks.len() == 0 {
        return 0;
    }
    var n: i64 = Lowerer_rg_open(self) - self.rg_loop_marks.get(self.rg_loop_marks.len() - 1);
    if n < 0 {
        return 0;
    }
    return n;
}

/// End `n` regions (a break or continue out of them).
fn Lowerer_rg_end_n(self: & mut Lowerer, n: i64) {
    var i: i64 = 0;
    while i < n {
        Lowerer_rg_call(self, 8, 0);
        i = i + 1;
    }
}

/// `nv` (an i64 a dup call gave) as the type of `v`, the value it stands for.
fn Lowerer_rg_as_type(self: & mut Lowerer, nv: i64, v: i64) -> i64 {
    var vt: IrType = Lowerer_get_value_type(self, v);
    match vt {
        IrType::I64 => {
            return nv;
        }
        _ => {
        }
    }
    return Lowerer_emit_inst(self, Inst::BitCast(nv, IrType::I64, vt));
}

/// A value `v` of type `t` kept in parent mode: an owner of its own made
/// here (copied out of a deeper region by core), the original dropped.
fn Lowerer_rg_keep_out(self: & mut Lowerer, v: i64, t: Type) -> i64 {
    if Lowerer_rc_kind(self, t) == RC_NONE {
        return v;
    }
    var nv: i64 = Lowerer_rc_dup(self, v, t);
    Lowerer_rc_drop(self, v, t);
    return nv;
}

pub fn Lowerer_lower_stmt(self: & mut Lowerer, stmt: Stmt) {
    // A statement that keeps or changes something outside the regions it
    // runs in runs with that place's region current (proposal 0005)
    if self.rg_on && Lowerer_rg_open(self) > 0 {
        var rk: i64 = Lowerer_rg_stmt_out(self, stmt);
        if rk > 0 {
            var prev: i64 = Lowerer_rg_leave(self, rk, true);
            var saved_ko: bool = self.rg_keep_out;
            self.rg_keep_out = true;
            Lowerer_lower_stmt_plain(self, stmt);
            self.rg_keep_out = saved_ko;
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_rg_call_v(self, 2, prev);
            }
            return;
        }
    }
    Lowerer_lower_stmt_plain(self, stmt);
}

fn Lowerer_lower_stmt_plain(self: & mut Lowerer, stmt: Stmt) {
    var saved_line: i64 = self.cur_line;
    var sl: i64 = stmt_line(stmt);
    if sl > 0 {
        self.cur_line = sl;
    }
    if !self.own_on {
        Lowerer_lower_stmt_inner(self, stmt);
        self.cur_line = saved_line;
        return;
    }
    var mark: i64 = self.own_temps.len();
    Lowerer_lower_stmt_inner(self, stmt);
    Lowerer_rc_flush(self, mark);
    self.cur_line = saved_line;
}

fn Lowerer_lower_stmt_inner(self: & mut Lowerer, stmt: Stmt) {
    match stmt {
        Stmt::Let(name, ty, expr, _is_mut, is_persist, annotations, _line) => {
            Lowerer_lower_let_stmt(self, name, ty, expr, _is_mut, is_persist, annotations, _line);
        }
        Stmt::LetUninit(name, ty, annotations, _line) => {
            var ir_ty: IrType = Lowerer_lower_type(self, ty);
            // a tuple is held inline, a struct of its shape (as `val t:
            // (A, B) = ..` holds it): one word took a whole tuple's copy
            var lu_tes: Vec<Type> = Lowerer_rc_tuple_elems(self, ty);
            if lu_tes.len() > 0 {
                ir_ty = Lowerer_key_tuple_ir(self, lu_tes);
            }
            var alloca: i64 = 0;
            // An owning variable starts empty (zeroed in the entry block)
            var uk: i64 = Lowerer_rc_kind(self, ty);
            if self.own_on && uk != RC_NONE && (uk != RC_MEM || ir_type_is_aggregate(ir_ty)) {
                alloca = Lowerer_rc_new_slot(self, ir_ty, ty);
                Lowerer_rc_add_slot(self, alloca, ty);
            } else {
                alloca = Lowerer_emit_inst(self, Inst::Alloca(ir_ty, Lowerer_current_region(self)));
            }
            Lowerer_insert_alloca_type(self, alloca, ir_ty);
            Lowerer_insert_alloca(self, name, alloca);
            // Its type, as a `let` records it: `m = mm` later must know it
            // owns an M, or it takes no owner of the value it keeps while
            // the slot is still dropped as an M (known-bugs 2g.2: a match
            // payload assigned to `var m: M;` was freed twice)
            Lowerer_insert_var_ast_type(self, name, ty);
            Lowerer_bind_local(self, name, alloca);
            // LF20: a secret local: the function's frame is wiped at exit (nat_ir),
            // and its slot seeds the values nat_ir keeps in registers first
            if has_annotation(annotations, "secret") || has_annotation(annotations, "sensitive") || has_annotation(annotations, "zeroize") {
                self.current_func.has_secret = true;
                self.current_func.secret_values.push(alloca);
            }
            // F88: @zeroize — track locals to zero at scope exit
            if has_annotation(annotations, "zeroize") {
                var size: i64 = ir_type_size(ir_ty);
                if size > 0 {
                    self.current_func.zeroize_locals.push(ValueIdU64_new(alloca, size));
                    Lowerer_mark_sensitive(self, alloca, ir_ty);
                }
            }
        }
        Stmt::LetTuple(names, expr, _line, _) => {
            var tuple_ptr: i64 = Lowerer_lower_expr(self, expr);
            // the value as lowered (a temporary of the statement, maybe)
            var tuple_src: i64 = tuple_ptr;
            var n: i64 = names.len();
            // Element types: the callee's tuple return type, or the
            // variable's recorded AST type (src/lower.rs).
            var elem_ast: Vec<Type> = Vec::new();
            match expr {
                Expr::Call(callee, _) => {
                    match Lowerer_lookup_func_ret_type(self, callee) {
                        OptType::Some(rt) => {
                            match rt {
                                Type::Tuple(ets) => {
                                    elem_ast = ets;
                                }
                                _ => {
                                }
                            }
                        }
                        OptType::None => {
                        }
                    }
                }
                Expr::Ident(vname) => {
                    match Lowerer_lookup_var_ast_type(self, vname) {
                        OptType::Some(vt) => {
                            match vt {
                                Type::Tuple(ets2) => {
                                    elem_ast = ets2;
                                }
                                _ => {
                                }
                            }
                        }
                        OptType::None => {
                        }
                    }
                }
                _ => {
                }
            }
            // any other expression whose type is known (a Vec's get, a
            // method's result, an alias of a tuple type)
            if elem_ast.len() == 0 {
                match lw_rc_strip_ref(Lowerer_resolve_type(self, Lowerer_rc_expr_type(self, expr))) {
                    Type::Tuple(ets3) => {
                        elem_ast = ets3;
                    }
                    _ => {
                    }
                }
            }
            // The tuple's layout (its shape's, lw_tuple_layout_name): the
            // value's own when it is a tuple struct (a literal, a call's
            // result), else the one its element types give, the value's
            // address typed as it. Its fields are read at the layout's
            // offsets with its types: a nested tuple and a struct are
            // inline (as a literal stores them), not words (index * 8 and
            // Opaque("tuple") read a nested tuple's first word as its
            // address).
            var tup_fields: Vec<StringIrTypeOffset> = Vec::new();
            var tup_name: str = lw_tuple_struct_name(Lowerer_get_value_type(self, tuple_ptr));
            if str_len(tup_name) == 0 && elem_ast.len() == n && n > 0 {
                match Lowerer_key_tuple_ir(self, elem_ast) {
                    IrType::Struct(ktn) => {
                        tup_name = ktn;
                        var tpv: IrType = Lowerer_get_value_type(self, tuple_ptr);
                        tuple_ptr = Lowerer_emit_inst(self, Inst::BitCast(tuple_ptr, tpv, IrType::Ptr(Box::new(IrType::Struct(ktn)))));
                    }
                    _ => {
                    }
                }
            }
            if str_len(tup_name) > 0 {
                match IrModule_get_struct(& self.module, tup_name) {
                    OptStructLayout::Some(tlay) => {
                        tup_fields = tlay.fields;
                    }
                    OptStructLayout::None => {
                    }
                }
            }
            var field_tys: Vec<IrType> = Vec::new();
            var fti: i64 = 0;
            while fti < n {
                var fty0: IrType = IrType::I64;
                if fti < tup_fields.len() {
                    fty0 = tup_fields.get(fti).ty;
                } else if fti < elem_ast.len() {
                    fty0 = Lowerer_lower_type(self, elem_ast.get(fti));
                }
                field_tys.push(fty0);
                fti = fti + 1;
            }
            // Ownership (proposal 0004): each name owns its element, as a
            // variable owns what it keeps. The tuple's own type says how
            // (a temporary's, else its element types); a temporary (a
            // literal, a call's result) hands its elements over and is not
            // dropped, any other tuple (a variable, a parameter, a Vec's
            // element) keeps its own and each name gets one more owner. An
            // element owned inline must be read as a struct (else it stays
            // a borrowed copy, as before).
            var own_es: Vec<Type> = Vec::new();
            var lt_moving: bool = false;
            if self.own_on {
                var src_tes: Vec<Type> = Lowerer_rc_tuple_elems(self, Lowerer_rc_temp_type(self, tuple_src));
                if src_tes.len() == n {
                    own_es = src_tes;
                    lt_moving = true;
                } else if elem_ast.len() == n {
                    own_es = elem_ast;
                }
            }
            var own_ok: Vec<bool> = Vec::new();
            var oi: i64 = 0;
            while oi < n {
                var ok: bool = false;
                if oi < own_es.len() {
                    var ok_k: i64 = Lowerer_rc_kind(self, own_es.get(oi));
                    if ok_k != RC_NONE {
                        ok = true;
                        if ok_k == RC_MEM {
                            match field_tys.get(oi) {
                                IrType::Struct(_) => {
                                }
                                _ => {
                                    ok = false;
                                    lt_moving = false;
                                }
                            }
                        }
                    }
                }
                own_ok.push(ok);
                oi = oi + 1;
            }
            if lt_moving {
                lt_moving = Lowerer_rc_claim(self, tuple_src);
            }
            var ti: i64 = 0;
            while ti < n {
                var field_ty: IrType = field_tys.get(ti);
                var name: str = names.get(ti);
                var owns: bool = own_ok.get(ti);
                var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(tuple_ptr, ti, field_ty));
                var alloca: i64 = 0;
                if owns {
                    alloca = Lowerer_rc_new_slot(self, field_ty, own_es.get(ti));
                } else {
                    alloca = Lowerer_emit_inst(self, Inst::Alloca(field_ty, Lowerer_current_region(self)));
                }
                Lowerer_insert_alloca_type(self, alloca, field_ty);
                match field_ty {
                    IrType::Struct(_) => {
                        // Struct element stored inline: copy it out.
                        var _c: i64 = Lowerer_emit_inst(self, Inst::StructCopy(alloca, elem_ptr, field_ty));
                        if owns && !lt_moving {
                            Lowerer_rc_call_mem(self, "__own_dup_", alloca, own_es.get(ti));
                        }
                    }
                    _ => {
                        var elem_val: i64 = Lowerer_emit_inst(self, Inst::Load(elem_ptr, field_ty));
                        if owns && !lt_moving {
                            elem_val = Lowerer_rc_dup(self, elem_val, own_es.get(ti));
                        }
                        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, elem_val, OptIrType::None));
                    }
                }
                if owns {
                    Lowerer_rc_add_slot(self, alloca, own_es.get(ti));
                }
                Lowerer_insert_alloca(self, name, alloca);
                // its element type, so a nested tuple destructures and a
                // string reads as one
                if owns {
                    Lowerer_insert_var_ast_type(self, name, own_es.get(ti));
                } else if ti < elem_ast.len() {
                    Lowerer_insert_var_ast_type(self, name, elem_ast.get(ti));
                }
                Lowerer_bind_local(self, name, alloca);
                ti = ti + 1;
            }
        }
        Stmt::Assign(name, op, expr, _line) => {
            // CL10: `x += e` on a struct is `x = x + e` (its operator
            // method, a unit's dimension rule, vecN's operators)
            if Lowerer_compound_struct_assign(self, name, op, expr, _line) {
                return;
            }
            // Check if target is a module-level mutable global; a local of
            // the name hides it (VF5 O1, miscompile-log M26)
            var g_hidden: bool = false;
            match Lowerer_lookup_alloca(self, name) {
                OptValueId::Some(_) => {
                    g_hidden = true;
                }
                OptValueId::None => {
                    // BG149: a closure's capture (which hides a global too)
                    match Lowerer_lookup_local(self, name) {
                        OptValueId::Some(_) => {
                        }
                        OptValueId::None => {
                            if Lowerer_assign_capture(self, name, op, expr) {
                                return;
                            }
                        }
                    }
                }
            }
            var g_look: OptGlobalLookup = OptGlobalLookup::None;
            if !g_hidden {
                g_look = IrModule_get_global(& self.module, name);
            }
            match g_look {
                OptGlobalLookup::Some(ir_ty, _init) => {
                    var addr: i64 = Lowerer_emit_inst(self, Inst::GlobalAddr(name, ir_ty));
                    match op {
                        AssignOp::Assign => {
                            // A global owns a string, Vec or map it holds
                            // (proposal 0004)
                            var gty: Type = Type::Infer;
                            if self.own_on {
                                gty = lw_rc_handle_of_ir(ir_ty);
                            }
                            var v_lw: i64 = Lowerer_lower_owned(self, expr, gty);
                            v_lw = Lowerer_int_to_float_value(self, v_lw, ir_ty);
                            var gold: i64 = - 1;
                            if Lowerer_rc_kind(self, gty) != RC_NONE {
                                gold = Lowerer_emit_inst(self, Inst::Load(addr, ir_ty));
                            }
                            var _s: i64 = Lowerer_emit_inst(self, Inst::Store(addr, v_lw, OptIrType::None));
                            if gold >= 0 {
                                Lowerer_rc_drop(self, gold, gty);
                            }
                        }
                        _ => {
                            // Compound assignment: load current, apply op, store
                            var current: i64 = Lowerer_emit_inst(self, Inst::Load(addr, ir_ty));
                            var rhs: i64 = Lowerer_lower_expr(self, expr);
                            var new_val: i64 = Lowerer_lower_compound_assign(self, op, current, rhs);
                            var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(addr, new_val, OptIrType::None));
                            // BG30: `G += s` on a string global: the global
                            // keeps the new string and drops the old, as
                            // `G = G + s` does above
                            if Lowerer_rc_claim(self, new_val) && self.own_on && Lowerer_rc_kind(self, lw_rc_handle_of_ir(ir_ty)) == RC_STR {
                                Lowerer_rc_drop(self, current, Type::Str);
                            }
                        }
                    }
                    return;
                }
                OptGlobalLookup::None => {
                }
            }
            // Look up alloca for mutable variable
            match Lowerer_lookup_alloca(self, name) {
                OptValueId::Some(alloca) => {
                    var rv: i64 = 0;
                    // Ownership (proposal 0004): the variable keeps the new
                    // value and drops the old one
                    var avty: Type = Type::Infer;
                    if self.own_on {
                        avty = Lowerer_rc_var_type(self, name);
                    }
                    var akind: i64 = Lowerer_rc_kind(self, avty);
                    // A variable that borrows (a loop variable, a binding)
                    // has no old value of its own to drop
                    var a_owned: bool = Lowerer_rc_owns_slot(self, alloca);
                    // `s = s + x` / `s += x` on a string it owns: appended in
                    // place when it has one owner and room (core's p_str_append)
                    if self.own_on && a_owned && akind == RC_STR && Lowerer_has_function(self, "p_str_append") {
                        var parts: Vec<Expr> = lw_rc_append_parts(name, op, expr);
                        if parts.len() > 0 {
                            var sty: IrType = IrType::Ptr(Box::new(IrType::U8));
                            match Lowerer_lookup_alloca_type(self, alloca) {
                                OptIrType::Some(st0) => {
                                    sty = st0;
                                }
                                OptIrType::None => {
                                }
                            }
                            var pi2: i64 = 0;
                            while pi2 < parts.len() {
                                var tv: i64 = Lowerer_lower_expr(self, parts.get(pi2));
                                var oldv: i64 = Lowerer_emit_inst(self, Inst::Load(alloca, sty));
                                var aa: Vec<i64> = Vec::new();
                                aa.push(Lowerer_rc_env(self));
                                aa.push(Lowerer_rc_as_i64(self, oldv));
                                aa.push(Lowerer_rc_as_i64(self, tv));
                                var nv: i64 = Lowerer_emit_inst(self, Inst::Call("p_str_append", aa, sty, lw_rc_eff()));
                                Lowerer_rc_claim(self, nv);
                                Lowerer_emit_inst(self, Inst::Store(alloca, nv, OptIrType::None));
                                pi2 = pi2 + 1;
                            }
                            return;
                        }
                    }
                    match op {
                        AssignOp::Assign => {
                            if self.own_on {
                                rv = Lowerer_lower_owned_new(self, expr, avty);
                            } else {
                                rv = Lowerer_lower_let_value(self, expr, false);
                            }
                        }
                        _ => {
                            rv = Lowerer_lower_expr(self, expr);
                        }
                    }
                    match op {
                        AssignOp::Assign => {
                            // A slot holding the struct itself takes a full
                            // copy (memcpy); a slot holding a pointer to the
                            // struct takes the new pointer: copying the struct
                            // into an 8-byte pointer slot overflowed it.
                            var store_ty: OptIrType = OptIrType::None;
                            var slot_holds_ptr: bool = false;
                            var slot_inline: bool = false;
                            match Lowerer_lookup_alloca_type(self, alloca) {
                                OptIrType::Some(slot_ty) => {
                                    slot_holds_ptr = ir_type_is_ptr(slot_ty);
                                    match slot_ty {
                                        IrType::Struct(_) => {
                                            slot_inline = true;
                                        }
                                        _ => {
                                        }
                                    }
                                }
                                OptIrType::None => {
                                }
                            }
                            // a tuple slot holds the tuple inline: a value
                            // that is its address as a word is copied from
                            // that address
                            if slot_inline {
                                rv = Lowerer_rc_tuple_ptr(self, rv, avty);
                            }
                            var val_ty: IrType = Lowerer_get_value_type(self, rv);
                            // An integer assigned to a float variable is the
                            // number (`f = 3`): as in a declaration
                            match Lowerer_lookup_alloca_type(self, alloca) {
                                OptIrType::Some(i2f_at) => {
                                    rv = Lowerer_int_to_float_value(self, rv, i2f_at);
                                }
                                OptIrType::None => {
                                }
                            }
                            match val_ty {
                                IrType::Ptr(inner) => {
                                    var inner_ty: IrType = box_ir_type_unbox(inner);
                                    if ir_type_is_aggregate(inner_ty) && !slot_holds_ptr {
                                        store_ty = OptIrType::Some(inner_ty);
                                    }
                                }
                                _ => {
                                }
                            }
                            var aold: i64 = - 1;
                            if !a_owned {  // nothing of its own to drop
                            } else if akind == RC_MEM && !slot_holds_ptr {
                                // The old struct's fields go; the new one is a
                                // separate owned value, so `x = f(x)` is safe
                                Lowerer_rc_call_mem(self, "__own_drop_", alloca, avty);
                            } else if akind != RC_NONE && akind != RC_MEM {
                                var aslot_ty: IrType = IrType::I64;
                                match Lowerer_lookup_alloca_type(self, alloca) {
                                    OptIrType::Some(ast2) => {
                                        aslot_ty = ast2;
                                    }
                                    OptIrType::None => {
                                    }
                                }
                                aold = Lowerer_emit_inst(self, Inst::Load(alloca, aslot_ty));
                            }
                            // M5: an array variable's slot holds a pointer to
                            // its data; `a = b` copies b's data into the
                            // buffer the slot already names, not the pointer
                            var slot_arr: bool = false;
                            var slot_arr_ty: IrType = IrType::Void;
                            match Lowerer_lookup_alloca_type(self, alloca) {
                                OptIrType::Some(saty) => {
                                    match saty {
                                        IrType::Ptr(sp) => {
                                            var sp2: IrType = box_ir_type_unbox(sp);
                                            match sp2 {
                                                IrType::Array(_, _) => {
                                                    slot_arr = true;
                                                    slot_arr_ty = sp2;
                                                }
                                                _ => {
                                                }
                                            }
                                        }
                                        _ => {
                                        }
                                    }
                                }
                                OptIrType::None => {
                                }
                            }
                            if slot_arr {
                                var arr_dst: i64 = Lowerer_emit_inst(self, Inst::Load(alloca, IrType::Ptr(Box::new(slot_arr_ty))));
                                var arr_words2: i64 = (IrModule_type_size(& self.module, slot_arr_ty) + 7) / 8;
                                var as_args: Vec<i64> = Vec::new();
                                as_args.push(Lowerer_rc_env(self));
                                as_args.push(Lowerer_rc_as_i64(self, arr_dst));
                                as_args.push(Lowerer_rc_as_i64(self, rv));
                                as_args.push(Lowerer_emit_inst(self, Inst::ConstInt(arr_words2, IrType::I64)));
                                Lowerer_emit_inst(self, Inst::Call("p_copy_words", as_args, IrType::Void, lw_rc_eff()));
                            } else {
                                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, rv, store_ty));
                            }
                            if aold >= 0 {
                                Lowerer_rc_drop(self, aold, avty);
                            }
                        }
                        _ => {
                            // Compound assignment: load current, apply op, store
                            var alloca_ty: IrType = IrType::I64;
                            match Lowerer_lookup_alloca_type(self, alloca) {
                                OptIrType::Some(t) => {
                                    alloca_ty = t;
                                }
                                OptIrType::None => {
                                }
                            }
                            var current: i64 = Lowerer_emit_inst(self, Inst::Load(alloca, alloca_ty));
                            var result: i64 = Lowerer_lower_compound_assign(self, op, current, rv);
                            var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, result, OptIrType::None));
                            // `s += t`: the slot keeps the new string, drops the old
                            // (BG30: claimed first, so a variable that borrows
                            // or of unknown type does not keep a string the
                            // statement's end frees; it leaks the new one)
                            if Lowerer_rc_claim(self, result) && akind == RC_STR && a_owned {
                                Lowerer_rc_drop(self, current, avty);
                            }
                        }
                    }
                }
                OptValueId::None => {
                    // Not an alloca - try local binding
                    match Lowerer_lookup_local(self, name) {
                        OptValueId::Some(local) => {
                            var v_lw: i64 = Lowerer_lower_expr(self, expr);
                            // Direct assignment to local ( SSA - but we support it)
                            Lowerer_set_value_type(self, local, Lowerer_get_value_type(self, v_lw));
                        }
                        OptValueId::None => {
                        }
                    }
                }
            }
        }
        Stmt::Expr(expr, _line) => {
            var _v: i64 = Lowerer_lower_expr(self, expr);
        }
        Stmt::Return(expr, _line) => {
            // Evaluate the returned value first. Drops, @zeroize wipes,
            // defers and persist saves then run, as at the closing brace;
            // running them first made `return f(key)` read a wiped key and
            // `defer { x = 0 } return x` return 0.
            var ret_val: OptValueId = OptValueId::None;
            // The value is made for the caller, outside this function's
            // regions (proposal 0005); lw_rg_unwind ends them at the return
            var rg_saved_ko: bool = self.rg_keep_out;
            if self.rg_on && Lowerer_rg_open(self) > 0 {
                Lowerer_rg_leave(self, Lowerer_rg_open(self), false);
                self.rg_keep_out = true;
            }
            // BG267/BG269: a tuple or enum literal returned as it is takes
            // the function's result type, as a let's literal takes the
            // let's (`return (a, 2.5)` of a `-> (f32, f32)`)
            var ret_saved_hint: OptType = self.let_hint;
            match expr {
                OptBoxExpr::Some(he) => {
                    if lw_ret_hint_expr(lw_box_expr_unbox(he)) {
                        self.let_hint = OptType::Some(self.own_ret_ty);
                    }
                    // BG434: `return if c { f".." } else { f".." }` / `return
                    // match ..`: the branches' values are owned as the
                    // function's result type, as a let's declared type makes
                    // them (Lowerer_rc_result_type). Without it an f-string
                    // arm's type was not known: each arm's string was handed
                    // to the result unowned, the result was no temporary,
                    // and the return took a copy (Str_dup), leaking the
                    // arm's string on every call.
                    if self.own_on && lw_is_branch_value_expr(lw_box_expr_unbox(he)) && Lowerer_rc_kind(self, self.own_ret_ty) != RC_NONE {
                        self.let_hint = OptType::Some(self.own_ret_ty);
                    }
                }
                OptBoxExpr::None => {
                }
            }
            match expr {
                OptBoxExpr::Some(e) => {
                    // The caller gets an owner of the value (proposal 0004)
                    match self.current_sret {
                        OptValueId::Some(sret) => {
                            var mv: i64 = Lowerer_rc_try_move(self, lw_box_expr_unbox(e));
                            if mv < 0 {
                                mv = Lowerer_lower_owned(self, lw_box_expr_unbox(e), self.own_ret_ty);
                            }
                            Lowerer_emit_sret_copy(self, mv);
                        }
                        OptValueId::None => {
                            var rval: i64 = 0;
                            var re: Expr = lw_box_expr_unbox(e);
                            if self.own_on && self.own_raw_ret && Lowerer_rc_kind(self, Lowerer_rc_expr_type(self, re)) == RC_NONE {
                                // A core builder's new buffer: handed over
                                rval = Lowerer_lower_expr(self, re);
                                Lowerer_rc_claim(self, rval);
                            } else if self.own_on {
                                rval = Lowerer_rc_try_move(self, re);
                                if rval < 0 {
                                    rval = Lowerer_lower_owned_new(self, re, self.own_ret_ty);
                                }
                            } else {
                                rval = Lowerer_lower_value(self, lw_box_expr_unbox(e));
                            }
                            ret_val = OptValueId::Some(Lowerer_coerce_return(self, rval));
                        }
                    }
                }
                OptBoxExpr::None => {
                }
            }
            self.let_hint = ret_saved_hint;
            self.rg_keep_out = rg_saved_ko;
