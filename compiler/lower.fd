// --- Utility functions ----------------------------------------------------

/// Check if a string is contained in a Vec<str>.
pub fn lw_c_str_vec_contains(vec: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < vec.len() {
        if vec.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn is_vec_type_name(name: str) -> bool {
    if name == "vec2" {
        return true;
    }
    if name == "vec3" {
        return true;
    }
    if name == "vec4" {
        return true;
    }
    return false;
}

pub fn get_vec_type_name(ty: IrType) -> OptStringLower {
    match ty {
        IrType::Struct(name) => {
            if is_vec_type_name(name) {
                return OptStringLower::Some(name);
            }
            return OptStringLower::None;
        }
        IrType::Ptr(inner) => {
            return get_vec_type_name(box_ir_type_unbox(inner));
        }
        _ => {
            return OptStringLower::None;
        }
    }
    return OptStringLower::None;
}

pub fn is_valid_swizzle(field: str) -> bool {
    var len: i64 = str_len(field);
    if len < 2 {
        return false;
    }
    if len > 4 {
        return false;
    }
    // Check all chars are valid swizzle components
    var i: i64 = 0;
    while i < len {
        var c: i64 = str_byte_at(field, i);
        if c != 120 && c != 121 && c != 122 && c != 119 &&  // x y z w
        c != 114 && c != 103 && c != 98 && c != 97 &&  // r g b a
        c != 115 && c != 116 && c != 112 && c != 113 {
            // s t p q
            return false;
        }
        i = i + 1;
    }
    // Check consistent group
    var first: i64 = str_byte_at(field, 0);
    var group: i64 = 0;
    // 0=xyzw, 1=rgba, 2=stpq
    if first == 120 || first == 121 || first == 122 || first == 119 {
        group = 0;
    } else if first == 114 || first == 103 || first == 98 || first == 97 {
        group = 1;
    } else {
        group = 2;
    }

    i = 0;
    while i < len {
        var c: i64 = str_byte_at(field, i);
        if group == 0 {
            if c != 120 && c != 121 && c != 122 && c != 119 {
                return false;
            }
        } else if group == 1 {
            if c != 114 && c != 103 && c != 98 && c != 97 {
                return false;
            }
        } else {
            if c != 115 && c != 116 && c != 112 && c != 113 {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

pub fn swizzle_index(c: i64) -> i64 {
    // x|r|s => 0, y|g|t => 1, z|b|p => 2, w|a|q => 3
    if c == 120 || c == 114 || c == 115 {
        return 0;
    }
    if c == 121 || c == 103 || c == 116 {
        return 1;
    }
    if c == 122 || c == 98 || c == 112 {
        return 2;
    }
    if c == 119 || c == 97 || c == 113 {
        return 3;
    }
    return 0;
}

// --- Runtime effects ------------------------------------------------------

pub fn runtime_effects(name: str) -> OptEffectSet {
    // CS4: every name below starts "p_": any other call is answered at once
    if !str_starts_with(name, "p_") {
        return OptEffectSet::None;
    }
    var effects: EffectSet = EffectSet_new();

    // Mutating vec operations
    if name == "p_vec_push" || name == "p_vec_push_str" || name == "p_vec_set" || name == "p_vec_clear" || name == "p_vec_insert" || name == "p_vec_remove" || name == "p_vec_reverse" || name == "p_vec_extend" || name == "p_vec_truncate" || name == "p_vec_sort" || name == "p_vec_resize" {
        EffectSet_add(& mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // Allocating functions
    if name == "p_vec_new" || name == "p_vec_new_with" || name == "p_vec_clone" || name == "p_malloc" || name == "p_malloc_uninit" || name == "p_alloc" || name == "p_free" || name == "p_arena_save" || name == "p_arena_restore" || name == "p_str_concat" || name == "p_to_str" || name == "p_char_to_str" || name == "p_float_to_str" || name == "p_bool_to_str" || name == "p_str_to_float" || name == "p_string_replace" || name == "p_string_split" || name == "p_string_trim" || name == "p_string_to_uppercase" || name == "p_string_to_lowercase" {
        EffectSet_add(&mut effects, Effect::Alloc);
        return OptEffectSet::Some(effects);
    }
    // IO functions
    if str_starts_with(name, "p_print") || str_starts_with(name, "p_eprint") || name == "p_panic" || str_starts_with(name, "p_write") {
        EffectSet_add(& mut effects, Effect::IO);
        return OptEffectSet::Some(effects);
    }
    // Map mutation
    if name == "p_map_insert" || name == "p_map_remove" || name == "p_map_clear" || name == "p_map_set" {
        EffectSet_add(& mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // String mutation
    if name == "p_string_copy" || name == "p_str_copy" || name == "p_str_free" {
        EffectSet_add(& mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // Atomic operations
    if str_starts_with(name, "p_atomic_") {
        EffectSet_add(& mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // Channel operations
    if str_starts_with(name, "p_chan_") {
        EffectSet_add(& mut effects, Effect::IO);
        return OptEffectSet::Some(effects);
    }
    // SL15: the profiler's calls (p_prof_start/stop/report/samples) are
    // never dropped, merged or moved across the code they measure
    if str_starts_with(name, "p_prof_") {
        EffectSet_add(& mut effects, Effect::IO);
        return OptEffectSet::Some(effects);
    }
    // CA8: the task's token slot changes at timeout blocks: never merged or
    // moved across them
    if name == "p_task_token" || name == "p_task_set_token" {
        EffectSet_add(& mut effects, Effect::IO);
        EffectSet_add(& mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // Mutex operations
    if str_starts_with(name, "p_mutex_") {
        EffectSet_add(& mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // RC operations
    if str_starts_with(name, "p_rc_") {
        EffectSet_add(& mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // Tensor operations
    if str_starts_with(name, "p_tensor_") {
        EffectSet_add(& mut effects, Effect::Alloc);
        return OptEffectSet::Some(effects);
    }
    // File/IO operations
    if str_starts_with(name, "p_file_") || str_starts_with(name, "p_fs_") || str_starts_with(name, "p_socket_") || str_starts_with(name, "p_dir_") || str_starts_with(name, "p_process_") || name == "p_mkdir" || name == "p_rmdir" || name == "p_rename" || name == "p_is_dir" || name == "p_getpid" {
        EffectSet_add(& mut effects, Effect::IO);
        return OptEffectSet::Some(effects);
    }
    // DL operations
    if str_starts_with(name, "p_dl_") {
        EffectSet_add(& mut effects, Effect::IO);
        return OptEffectSet::Some(effects);
    }
    // KV cache, quantization
    if str_starts_with(name, "p_kv_cache_") || str_starts_with(name, "p_quantize") || str_starts_with(name, "p_dequantize") {
        EffectSet_add(& mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // Noise operations
    if str_starts_with(name, "p_dp_") || str_starts_with(name, "p_gaussian_") || str_starts_with(name, "p_dropout") {
        EffectSet_add(& mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // Comm operations
    if name == "p_all_reduce" || name == "p_broadcast" || name == "p_all_gather" || name == "p_scatter" || name == "p_send_tensor" || name == "p_recv_tensor" || name == "p_tp_init" {
        EffectSet_add(& mut effects, Effect::IO);
        return OptEffectSet::Some(effects);
    }
    // F8: thread-local slots: a get reads what a set wrote, so neither
    // is merged or moved across the other (rules.fd purecse)
    if name == "p_tls_set" || name == "p_tls_create" {
        EffectSet_add(& mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    if name == "p_tls_get" {
        EffectSet_add(& mut effects, Effect::Read);
        return OptEffectSet::Some(effects);
    }
    // MI17: any other runtime builtin may keep state (p_tls_*, p_sb_*,
    // p_co_*, p_gt_*, p_task_*, p_volatile_*, p_os_random_u64, ...). With no
    // effect, iropt iro_absent_call_mask counted its call as pure, and the
    // native mid-end merged two calls of a wrapper (rules.fd purecse: the
    // second sync_tls_get read the first's 0). Write, not IO: IO is what
    // strip_ungranted_caps (compiler.fd) and capability checks look at.
    EffectSet_add(& mut effects, Effect::Write);
    return OptEffectSet::Some(effects);
}

// --- OptEffectSet ---------------------------------------------------------

pub enum OptEffectSet {
    Some(EffectSet),
    None,
}

/// A variable slot that owns its value.
pub struct OwnSlot {
    pub slot: i64,
    pub ty: Type,
}

// --- Lowerer struct -------------------------------------------------------

pub struct Lowerer {
    pub module: IrModule,
    pub current_func: IrFunction,
    pub has_current_func: bool,
    pub current_block: i64,
    pub loop_stack: Vec<LoopContext>,
    pub structs: Vec<StringStructDefEntry>,
    pub allocas: Vec<StringValueIdEntry>,
    pub alloca_types: Vec<I64IrTypeEntry>,
    pub var_ast_types: Vec<StringTypeEntry>,
    /// SP12: raw name indexes of allocas and var_ast_types (lw_ix_link,
    /// lw_ix_last): every lookup by name scanned the whole list
    pub alloca_ix: i64,
    pub var_ast_ix: i64,
    /// SP12: an index of alloca_types (Lowerer_at_ix_add), 0 while the
    /// table is short or was replaced whole
    pub alloca_type_ix: i64,
    // The AST type of the value being matched, for the bindings of a generic
    // enum's variants (Option<f64>: Some(v) is an f64)
    pub match_scrutinee_ty: Type,
    pub constants: Vec<StringExprEntry>,
    pub current_sret: OptValueId,
    pub enums: Vec<StringEnumDefEntry>,
    // Name -> position in enums + 1 (Lowerer_insert_enum keeps it, D10)
    pub enum_index: i64,
    // CS4: name -> position in structs + 1 (Lowerer_insert_struct keeps it)
    pub struct_index: i64,
    // CS4: "<type>\n<method>" -> position in impl_methods + 1
    // (Lowerer_insert_impl_method keeps it)
    pub impl_index: i64,
    // CS4: name -> position in module.extern_functions + 1, caught up on
    // lookup (Lowerer_extern_at); "#" holds how many entries it covers + 1
    pub extern_index: i64,
    pub impl_methods: Vec<StringStringFuncEntry>,
    pub defer_stack: Vec<DeferEntry>,
    pub current_captures: Vec<ClosureCapture>,
    pub try_stack: Vec<TryContext>,
    pub effect_handler_stack: Vec<Vec<EffectHandler>>,
    // Globals assigned when `main` starts: their initializers are not constants
    pub global_inits: Vec<GlobalVar>,
    // Where a `handle` ending this function leaves its value
    pub handle_slot_fn: str,
    pub handle_slot: i64,
    pub scope_executor_stack: Vec<i64>,
    pub current_line: OptU64,
    pub type_aliases: Vec<StringTypeEntry>,
    pub current_self_type: OptStringLower,
    pub region_stack: Vec<str>,
    pub gpu_region_stack: Vec<str>,
    pub sandbox_depth: i64,
    pub func_ret_types: Vec<StringTypeEntry>,
    pub async_funcs: Vec<str>,
    // Those whose calls start a task: their arguments and result are words
    pub async_tasks: Vec<str>,
    /// Async tasks with f64 or struct parameters (release H9): started
    /// through `<name>__task`, which takes every argument as one word.
    pub async_adapted: Vec<str>,
    /// The body of the function being lowered: copy-on-write leaves out the
    /// share of a copy that is never written (Lowerer_readonly_copy)
    pub cur_body: Vec<Stmt>,
    /// SP12: lw_has_defer(cur_body), worked out once where cur_body is set
    /// (Lowerer_last_use asked it, a walk of the whole body, per kept value)
    pub cur_has_defer: bool,
    /// Set while a `let` stores a struct that needs no share: a fresh value
    /// (a literal, a call's result) or a copy that is never written
    pub no_struct_share: bool,
    /// The statement list being lowered and the index after the current
    /// statement: a copy declared there lives only in the rest of it
    pub rest_of: Vec<Stmt>,
    pub rest_from: i64,
    /// The statement lists being lowered, outermost (the function body)
    /// first, and the index of the statement lowered in each: a variable's
    /// last use is moved, not shared (Lowerer_last_use)
    pub fr_lists: Vec<Vec<Stmt>>,
    pub fr_idx: Vec<i64>,
    /// SP12: one raw map per fr_lists entry, made with it and dropped with
    /// it: name -> 1 + the last statement of that list that uses the name
    /// (cowcheck's cow_names_stmt), "#all" -> 1 + the last one that counts
    /// for every name, "#built" -> 1 once filled (Lowerer_used_after)
    pub fr_lu: Vec<i64>,
    /// SP12: the fr_lists level whose list rest_of is (its fr_lu map
    /// answers Lowerer_readonly_rest), or -1 when rest_of is a list no level
    /// holds any more (a block or a function lowered since)
    pub rest_lv: i64,
    // Externs with a function parameter
    pub fn_externs: Vec<str>,
    pub current_func_param_types: Vec<StringTypeEntry>,
    pub vec_allocas: Vec<i64>,
    pub linear_structs: Vec<str>,
    pub let_hint: OptType,
    pub func_param_names: Vec<StringVecStrEntry>,
    pub func_defaults: Vec<StringVecExprEntry>,
    // Name -> position in func_param_names and func_defaults + 1
    pub func_info_at: i64,
    // AST parameter types of each function (same index as func_param_names),
    // to read a reference argument through when the callee takes the value
    pub func_param_asts: Vec<Vec<Type>>,
    /// L3A: numbers the continuation closures (__cont_N).
    pub continuation_counter: i64,
    /// CA8: the `timeout(ms) { }` blocks open around what is being lowered,
    /// innermost last: each one's token (an i64 value), and the loop and try
    /// depths it opened at (Lowerer_to_unwind); `to_base` is where the
    /// function being lowered starts in them; `to_hit` is the "ran past its
    /// deadline" value of the block lowered last (-1: none)
    pub to_toks: Vec<i64>,
    pub to_loops: Vec<i64>,
    pub to_trys: Vec<i64>,
    pub to_base: i64,
    pub to_hit: i64,
    /// Ownership (proposal 0004): the owned variable slots of the function
    /// being lowered, where each open scope starts in them, the current
    /// statements' temporaries, where each open loop's slots and
    /// temporaries start, and the entry-block instructions of the slots
    pub own_slots: Vec<OwnSlot>,
    pub own_marks: Vec<i64>,
    pub own_temps: Vec<OwnTemp>,
    pub own_loop_slots: Vec<i64>,
    pub own_loop_temps: Vec<i64>,
    pub own_prologue: Vec<i64>,
    /// txn { } blocks around the statement being lowered
    pub txn_stack: Vec<LwTxn>,
    /// Lowering a function body whose values are counted
    pub own_on: bool,
    /// Its AST return type
    pub own_ret_ty: Type,
    /// A core string builder (String_*, p_str_*): a raw buffer it returns
    /// as a str is the new string it made, handed over, not counted again
    pub own_raw_ret: bool,
    /// The source line of the statement being lowered (0: none); every
    /// instruction emitted gets it as its ValueMeta.source_line (DWARF line
    /// tables, IrModule_source_map)
    pub cur_line: i64,
    /// extern "C" functions declared to return a str: what C returns is
    /// copied into a counted string at the call (proposal 0004)
    pub own_str_externs: Vec<str>,
    /// Variables another variable borrows from (a read-only copy): their
    /// value is never moved out
    pub own_nomove: Vec<str>,
    /// Struct and enum types with generated drop/dup functions, their index
    /// by type text, the ownership kind of types by text, and function name
    /// -> position in func_ret_types + 1
    pub own_types: Vec<OwnType>,
    pub own_type_index: i64,
    pub own_kind_cache: i64,
    pub own_ret_index: i64,
    /// Regions freed in one step (proposal 0005, FID_REGION_ARENA=1): on;
    /// the regions with arenas open around the code being lowered (their
    /// function and RegionBegin id, innermost last); how many were open at
    /// each loop being lowered; whether a value kept now is copied out of
    /// the regions it leaves (a statement in parent mode)
    pub rg_on: bool,
    pub rg_fns: Vec<str>,
    pub rg_ids: Vec<i64>,
    pub rg_loop_marks: Vec<i64>,
    pub rg_keep_out: bool,
}

// --- Lowerer methods ------------------------------------------------------

pub fn lw_c_vec1_i64(x: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(x);
    return v;
}

pub fn c_vec2_i64(x: i64, y: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(x);
    v.push(y);
    return v;
}

pub fn Lowerer_new() -> Lowerer {
    return Lowerer {
        module: IrModule_new(), current_func: IrFunction_new("", IrType::Void), has_current_func: false, current_block: 0, loop_stack: Vec::new(), structs: Vec::new(), allocas: Vec::new(), alloca_types: Vec::new(), var_ast_types: Vec::new(), alloca_ix: HashMap_new(), var_ast_ix: HashMap_new(), alloca_type_ix: 0, match_scrutinee_ty: Type::I64, constants: Vec::new(), current_sret: OptValueId::None, enums: Vec::new(), enum_index: HashMap_new(), struct_index: HashMap_new(), impl_index: HashMap_new(), extern_index: HashMap_new(), impl_methods: Vec::new(), defer_stack: Vec::new(), current_captures: Vec::new(), try_stack: Vec::new(), effect_handler_stack: Vec::new(), global_inits: Vec::new(), handle_slot_fn: "", handle_slot: - 1, scope_executor_stack: Vec::new(), current_line: OptU64::None, type_aliases: Vec::new(), current_self_type: OptStringLower::None, region_stack: Vec::new(), gpu_region_stack: Vec::new(), sandbox_depth: 0, func_ret_types: Vec::new(), async_funcs: Vec::new(), async_tasks: Vec::new(), async_adapted: Vec::new(), cur_body: Vec::new(), cur_has_defer: false, no_struct_share: false, rest_of: Vec::new(), rest_from: 0, fr_lists: Vec::new(), fr_idx: Vec::new(), fr_lu: Vec::new(), rest_lv: - 1, fn_externs: Vec::new(), current_func_param_types: Vec::new(), vec_allocas: Vec::new(), linear_structs: Vec::new(), let_hint: OptType::None, func_param_names: Vec::new(), func_defaults: Vec::new(), func_info_at: HashMap_new(), func_param_asts: Vec::new(), continuation_counter: 0, to_toks: Vec::new(), to_loops: Vec::new(), to_trys: Vec::new(), to_base: 0, to_hit: - 1, own_slots: Vec::new(), own_marks: Vec::new(), own_temps: Vec::new(), own_loop_slots: Vec::new(), own_loop_temps: Vec::new(), own_prologue: Vec::new(), txn_stack: Vec::new(), own_on: false, own_ret_ty: Type::Void, own_raw_ret: false, cur_line: 0, own_str_externs: Vec::new(), own_nomove: Vec::new(), own_types: Vec::new(), own_type_index: HashMap_new(), own_kind_cache: HashMap_new(), own_ret_index: HashMap_new(), rg_on: false, rg_fns: Vec::new(), rg_ids: Vec::new(), rg_loop_marks: Vec::new(), rg_keep_out: false,
    };
}

pub fn Lowerer_current_region(self: & Lowerer) -> Region {
    if self.region_stack.len() > 0 {
        return Region::Named(self.region_stack.get(self.region_stack.len() - 1));
    }
    return Region::Stack;
}

// Load a field from an enum variant's inline storage.
// When the field type is a struct (enum), the data is stored inline within
// the parent enum. A plain Inst::Load with a struct type only reads 8 bytes
// (a pointer) because the C codegen treats IrType::Struct as a pointer type.
// To correctly extract the full struct, we allocate a new buffer and use
// Inst::Store with the explicit store_ty to emit a memcpy in the C backend.
pub fn Lowerer_load_enum_field(self: & mut Lowerer, field_ptr: i64, field_ty: IrType) -> i64 {
    match field_ty {
        IrType::Struct(_) => {
            var buf: i64 = Lowerer_emit_inst(self, Inst::Alloca(field_ty, Lowerer_current_region(self)));
            Lowerer_emit_inst(self, Inst::Store(buf, field_ptr, OptIrType::Some(field_ty)));
            return buf;
        }
        _ => {
            return Lowerer_emit_inst(self, Inst::Load(field_ptr, field_ty));
        }
    }
}

/// If `val` is a Box<T> (Ptr(Ptr(Struct(..))) or Generic("Box", [Struct(..)])),
/// load through it once so enum/struct pattern matching sees the inner struct
/// pointer directly. Otherwise return `val` unchanged.
///
/// NOTE: Box::new stores the struct data directly in the heap allocation (via
/// memcpy), so the Box pointer already points to the struct data. This function
/// is a no-op - the match code can read the tag/fields directly from the Box
/// pointer.
pub fn Lowerer_maybe_deref_box(self: & mut Lowerer, val: i64) -> i64 {
    // Box::new copies the full struct data into the heap allocation via
    // memcpy, so the Box pointer already points to the struct data.
    // No dereference needed - return val unchanged.
    return val;
}

/// Compute the number of 8-byte slots a field occupies in an enum layout.
/// Struct/enum types use their full layout size (rounded up to 8);
/// all other types use 1 slot.
pub fn Lowerer_enum_field_slots(self: & Lowerer, ty: IrType) -> i64 {
    match ty {
        IrType::Struct(name) => {
            match IrModule_get_struct(& self.module, name) {
                OptStructLayout::Some(layout) => {
                    return (layout.size + 7) / 8;
                }
                OptStructLayout::None => {
                    return 1;
                }
            }
        }
        _ => {
            return 1;
        }
    }
    return 1;
}

pub fn Lowerer_set_linear_structs(self: & mut Lowerer, structs: Vec<str>) {
    var i: i64 = 0;
    while i < structs.len() {
        self.linear_structs.push(structs.get(i));
        i = i + 1;
    }
}

pub fn Lowerer_is_linear_ir_type(self: & Lowerer, ty: IrType) -> bool {
    match ty {
        IrType::Struct(name) => {
            var i: i64 = 0;
            while i < self.linear_structs.len() {
                if self.linear_structs.get(i) == name {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        _ => {
            return false;
        }
    }
    return false;
}

// --- Map lookup helpers ---------------------------------------------------

pub fn Lowerer_lookup_struct(self: & Lowerer, name: str) -> OptStructDef {
    // CS4: struct_index holds the first entry of every name (only
    // Lowerer_insert_struct adds to `structs`); not in it: no such struct
    var sat: i64 = HashMap_get(self.struct_index, name) - 1;
    if sat < 0 {
        return OptStructDef::None;
    }
    if sat < self.structs.len() && self.structs.get(sat).key == name {
        return OptStructDef::Some(self.structs.get(sat).val);
    }
    var i: i64 = 0;
    while i < self.structs.len() {
        if self.structs.get(i).key == name {
            return OptStructDef::Some(self.structs.get(i).val);
        }
        i = i + 1;
    }
    return OptStructDef::None;
}

pub fn Lowerer_lookup_enum(self: & Lowerer, name: str) -> OptEnumDef {
    var at: i64 = HashMap_get(self.enum_index, name) - 1;
    if at >= 0 && at < self.enums.len() && self.enums.get(at).key == name {
        return OptEnumDef::Some(self.enums.get(at).val);
    }
    var i: i64 = 0;
    while i < self.enums.len() {
        if self.enums.get(i).key == name {
            return OptEnumDef::Some(self.enums.get(i).val);
        }
        i = i + 1;
    }
    return OptEnumDef::None;
}

/// Look up the EnumDef a variant pattern refers to. `enum_name` may be
/// empty for shorthand patterns like `Some(x)`, in which case we search
/// all enums for a variant with that name.
pub fn Lowerer_lookup_pattern_enum(self: & Lowerer, enum_name: str, variant: str) -> OptEnumDef {
    if str_len(enum_name) > 0 {
        match Lowerer_lookup_enum(self, enum_name) {
            OptEnumDef::Some(def) => {
                return OptEnumDef::Some(def);
            }
            OptEnumDef::None => {
            }
        }
    }
    var i: i64 = 0;
    while i < self.enums.len() {
        var def: EnumDef = self.enums.get(i).val;
        var vi: i64 = 0;
        while vi < def.variants.len() {
            if def.variants.get(vi).name == variant {
                return OptEnumDef::Some(def);
            }
            vi = vi + 1;
        }
        i = i + 1;
    }
    return OptEnumDef::None;
}

/// BG11: the enum name to look a variant pattern written without its enum
/// (`X(n)`, `Ok(v)`) up by: the enum of the scrutinee's AST type `scrut`
/// when it has that variant (as TypeChecker_resolve_pattern_enum decides),
/// else "" (Lowerer_lookup_pattern_enum's search: the first enum with it).
/// The tag index and the payload types are both taken from the enum
/// Lowerer_lookup_pattern_enum gives for this name, so they always agree.
fn Lowerer_scrutinee_pattern_enum(self: & Lowerer, scrut: Type, variant: str) -> str {
    var sn: str = lw_rc_type_name(lw_rc_strip_ref(Lowerer_resolve_type(self, scrut)));
    if str_len(sn) == 0 {
        return "";
    }
    match Lowerer_lookup_enum(self, sn) {
        OptEnumDef::Some(sdef) => {
            var vi: i64 = 0;
            while vi < sdef.variants.len() {
                if sdef.variants.get(vi).name == variant {
                    return sn;
                }
                vi = vi + 1;
            }
        }
        OptEnumDef::None => {
        }
    }
    return "";
}

/// BG11: the index of `variant` in the enum Lowerer_lookup_pattern_enum
/// gives for `enum_name` (the one the payload types come from), or 0.
fn Lowerer_pattern_variant_index(self: & Lowerer, enum_name: str, variant: str) -> i64 {
    match Lowerer_lookup_pattern_enum(self, enum_name, variant) {
        OptEnumDef::Some(pdef) => {
            var vi: i64 = 0;
            while vi < pdef.variants.len() {
                if pdef.variants.get(vi).name == variant {
                    return vi;
                }
                vi = vi + 1;
            }
        }
        OptEnumDef::None => {
        }
    }
    return 0;
}

/// A bare name in a match arm that is a unit variant of the scrutinee's enum
/// (`None =>` on an `Option`) is that variant, as `Some(x)` is (reference
/// §6): the type checker binds no variable for it
/// (TypeChecker_bare_pattern_is_unit_variant). Before, the lowering bound the
/// name to the scrutinee, so the arm matched every value and the arms after
/// it could not run.
pub fn Lowerer_bare_pattern_is_unit_variant(self: & Lowerer, scrut_expr: Expr, name: str) -> bool {
    var pen: str = Lowerer_scrutinee_pattern_enum(self, Lowerer_rc_expr_type(self, scrut_expr), name);
    if str_len(pen) == 0 {
        return false;
    }
    match Lowerer_lookup_enum(self, pen) {
        OptEnumDef::Some(bdef) => {
            var vi: i64 = 0;
            while vi < bdef.variants.len() {
                if bdef.variants.get(vi).name == name {
                    match bdef.variants.get(vi).data {
                        OptParams::Some(bps) => {
                            return bps.len() == 0;
                        }
                        OptParams::None => {
                            return true;
                        }
                    }
                }
                vi = vi + 1;
            }
        }
        OptEnumDef::None => {
        }
    }
    return false;
}

/// IR types for the values bound by an enum-variant pattern.
/// Enum-typed fields (structs/enums declared directly, not Box/Ptr) are
/// stored INLINE in the parent enum (per Lowerer_make_enum_layout). Returning
/// `Struct(name)` for these lets `load_enum_field` copy the full inline data
/// via alloca+memcpy.
/// Box/Ptr/Vec/str fields are one machine word wide (a pointer) and pass
/// through `word_repr` unchanged.
pub fn Lowerer_pattern_binding_ir_types(self: & Lowerer, enum_name: str, variant: str, bindings: Vec<Binding>) -> Vec<IrType> {
    var ast_tys: Vec<Type> = Lowerer_pattern_binding_ast_types(self, enum_name, variant, bindings);
    // The declared payload types: a tuple or a generic struct instance is
    // held inline (Lowerer_held_ir, as the enum's layout keeps it)
    var decl_tys: Vec<Type> = Vec::new();
    var decl_params: Vec<str> = Vec::new();
    match Lowerer_lookup_pattern_enum(self, enum_name, variant) {
        OptEnumDef::Some(pdef) => {
            decl_params = pdef.type_params;
            var pvi: i64 = 0;
            while pvi < pdef.variants.len() {
                if pdef.variants.get(pvi).name == variant {
                    match pdef.variants.get(pvi).data {
                        OptParams::Some(pps) => {
                            var ppi: i64 = 0;
                            while ppi < pps.len() {
                                decl_tys.push(pps.get(ppi).ty);
                                ppi = ppi + 1;
                            }
                        }
                        OptParams::None => {
                        }
                    }
                }
                pvi = pvi + 1;
            }
        }
        OptEnumDef::None => {
        }
    }
    var result: Vec<IrType> = Vec::new();
    var bi: i64 = 0;
    while bi < ast_tys.len() {
        // Keep struct/enum types as-is so load_enum_field copies the full
        // inline data. Box<T> lowers to Ptr(Struct(T)) which is already a
        // word - word_repr leaves it unchanged.
        var lowered: IrType = Lowerer_lower_type(self, ast_tys.get(bi));
        if bi < decl_tys.len() && !lw_rc_is_param(decl_tys.get(bi), decl_params) {
            match lowered {
                IrType::Struct(_) => {
                }
                _ => {
                    match Lowerer_held_ir(self, decl_tys.get(bi), decl_params) {
                        IrType::Struct(hsn) => {
                            lowered = IrType::Struct(hsn);
                        }
                        _ => {
                        }
                    }
                }
            }
        }
        match lowered {
            IrType::Struct(_) => {
                result.push(lowered);
            }
            _ => {
                result.push(word_repr(lowered));
            }
        }
        bi = bi + 1;
    }
    return result;
}

/// For each payload of `En::Variant`: whether it is a type parameter of the
/// enum (one word, holding a struct or enum by pointer to a heap copy).
pub fn Lowerer_pattern_binding_params(self: & Lowerer, enum_name: str, variant: str) -> Vec<bool> {
    var out: Vec<bool> = Vec::new();
    match Lowerer_lookup_pattern_enum(self, enum_name, variant) {
        OptEnumDef::Some(def) => {
            var vi: i64 = 0;
            while vi < def.variants.len() {
                if def.variants.get(vi).name == variant {
                    match def.variants.get(vi).data {
                        OptParams::Some(params) => {
                            var pi: i64 = 0;
                            while pi < params.len() {
                                out.push(Lowerer_is_opaque_type_param(self, params.get(pi).ty));
                                pi = pi + 1;
                            }
                        }
                        OptParams::None => {
                        }
                    }
                    break;
                }
                vi = vi + 1;
            }
        }
        OptEnumDef::None => {
        }
    }
    return out;
}

/// Read a type-parameter payload: a struct or enum is copied out of its heap
/// box into a local of its own; anything else is the word itself.
pub fn Lowerer_load_param_payload(self: & mut Lowerer, match_val: i64, field_idx: i64, field_ty: IrType) -> i64 {
    match field_ty {
        IrType::Struct(_) => {
            var slot: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, field_idx, IrType::I64));
            var boxed: i64 = Lowerer_emit_inst(self, Inst::Load(slot, IrType::Ptr(Box::new(field_ty))));
            var buf: i64 = Lowerer_emit_inst(self, Inst::Alloca(field_ty, Lowerer_current_region(self)));
            Lowerer_emit_inst(self, Inst::Store(buf, boxed, OptIrType::Some(field_ty)));
            return buf;
        }
        _ => {
        }
    }
    var fp: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, field_idx, field_ty));
    return Lowerer_emit_inst(self, Inst::Load(fp, field_ty));
}

/// Like `pattern_binding_ir_types` but returns the AST types, which
/// we need to register in `var_ast_types` so that `infer_expr_type`
/// can recover generic element types (e.g. `Vec<FieldInit>`).
pub fn Lowerer_pattern_binding_ast_types(self: & Lowerer, enum_name: str, variant: str, bindings: Vec<Binding>) -> Vec<Type> {
    var payload_tys: Vec<Type> = Vec::new();
    match Lowerer_lookup_pattern_enum(self, enum_name, variant) {
        OptEnumDef::Some(def) => {
            var vi: i64 = 0;
            while vi < def.variants.len() {
                if def.variants.get(vi).name == variant {
                    match def.variants.get(vi).data {
                        OptParams::Some(params) => {
                            var pi: i64 = 0;
                            while pi < params.len() {
                                payload_tys.push(params.get(pi).ty);
                                pi = pi + 1;
                            }
                        }
                        OptParams::None => {
                        }
                    }
                    break;
                }
                vi = vi + 1;
            }
        }
        OptEnumDef::None => {
        }
    }
    var result: Vec<Type> = Vec::new();
    var bi: i64 = 0;
    while bi < bindings.len() {
        var binding: Binding = bindings.get(bi);
        var ast_ty: Type = Type::I64;
        if bi < payload_tys.len() {
            var declared: Type = payload_tys.get(bi);
            if !Lowerer_is_opaque_type_param(self, declared) {
                ast_ty = declared;
            } else {
                match Lowerer_ast_type_from_name(self, binding.ty) {
                    OptType::Some(t) => {
                        ast_ty = t;
                    }
                    OptType::None => {
                        ast_ty = Lowerer_scrutinee_type_arg(self, enum_name, variant, declared);
                    }
                }
            }
        } else {
            match Lowerer_ast_type_from_name(self, binding.ty) {
                OptType::Some(t) => {
                    ast_ty = t;
                }
                OptType::None => {
                    ast_ty = Type::I64;
                }
            }
        }
        result.push(ast_ty);
        bi = bi + 1;
    }
    return result;
}

/// A payload that is a type parameter of a generic enum: the scrutinee's type
/// argument for it, else i64 (as src/lower.rs pattern_binding_ast_types).
fn Lowerer_scrutinee_type_arg(self: & Lowerer, enum_name: str, variant: str, payload: Type) -> Type {
    var tp: str = "";
    match payload {
        Type::Named(n) => {
            tp = n;
        }
        _ => {
            return Type::I64;
        }
    }
    match Lowerer_lookup_pattern_enum(self, enum_name, variant) {
        OptEnumDef::Some(def) => {
            match self.match_scrutinee_ty {
                Type::Generic(gname, gargs) => {
                    if gname == def.name {
                        var k: i64 = 0;
                        while k < def.type_params.len() && k < gargs.len() {
                            if def.type_params.get(k) == tp {
                                return gargs.get(k);
                            }
                            k = k + 1;
                        }
                    }
                }
                _ => {
                }
            }
        }
        OptEnumDef::None => {
        }
    }
    return Type::I64;
}

pub fn Lowerer_lookup_alloca(self: & Lowerer, name: str) -> OptValueId {
    // SP12: the last entry of the name from the index (lw_ix_last_alloca)
    var at: i64 = lw_ix_last_alloca(self.alloca_ix, & self.allocas, name);
    if at >= 0 {
        if self.allocas.get(at).val < 0 {
            return OptValueId::None;
        }
        return OptValueId::Some(self.allocas.get(at).val);
    }
    if at == - 1 {
        return OptValueId::None;
    }
    // Search from the end so shadowed variables find the most recent binding.
    var i: i64 = self.allocas.len() - 1;
    while i >= 0 {
        if self.allocas.get(i).key == name {
            if self.allocas.get(i).val < 0 {
                return OptValueId::None;
            }
            return OptValueId::Some(self.allocas.get(i).val);
        }
        i = i - 1;
    }
    return OptValueId::None;
}

pub fn Lowerer_lookup_alloca_type(self: & Lowerer, id: i64) -> OptIrType {
    // SP12: the first entry of the id from the index (lw_at_ix_first)
    if self.alloca_type_ix != 0 {
        val at: i64 = lw_at_ix_first(self.alloca_type_ix, & self.alloca_types, id);
        if at >= 0 {
            return OptIrType::Some(self.alloca_types.get(at).val);
        }
        if at == - 1 {
            return OptIrType::None;
        }
    }
    var i: i64 = 0;
    while i < self.alloca_types.len() {
        if self.alloca_types.get(i).key == id {
            return OptIrType::Some(self.alloca_types.get(i).val);
        }
        i = i + 1;
    }
    return OptIrType::None;
}

pub fn Lowerer_lookup_var_ast_type(self: & Lowerer, name: str) -> OptType {
    // SP12: the last entry of the name from the index (lw_ix_last_var)
    var at: i64 = lw_ix_last_var(self.var_ast_ix, & self.var_ast_types, name);
    if at >= 0 {
        return OptType::Some(self.var_ast_types.get(at).val);
    }
    if at == - 1 {
        return OptType::None;
    }
    // Search from the end so shadowed variables find the most recent binding.
    var i: i64 = self.var_ast_types.len() - 1;
    while i >= 0 {
        if self.var_ast_types.get(i).key == name {
            return OptType::Some(self.var_ast_types.get(i).val);
        }
        i = i - 1;
    }
    return OptType::None;
}

pub fn Lowerer_lookup_constant(self: & Lowerer, name: str) -> OptExpr {
    var i: i64 = 0;
    while i < self.constants.len() {
        if self.constants.get(i).key == name {
            return OptExpr::Some(self.constants.get(i).val);
        }
        i = i + 1;
    }
    return OptExpr::None;
}

pub fn Lowerer_lookup_impl_method(self: & Lowerer, struct_name: str, method_name: str) -> OptFunc {
    // CS4: impl_index holds the first entry of every "<type>\n<method>"
    // (only Lowerer_insert_impl_method adds to impl_methods). The scan
    // below copied every entry it passed, the method's whole tree.
    var mat: i64 = HashMap_get(self.impl_index, lw_impl_key(struct_name, method_name)) - 1;
    if mat < 0 {
        return OptFunc::None;
    }
    if mat < self.impl_methods.len() && self.impl_methods.get(mat).key1 == struct_name && self.impl_methods.get(mat).key2 == method_name {
        return OptFunc::Some(self.impl_methods.get(mat).val);
    }
    var i: i64 = 0;
    while i < self.impl_methods.len() {
        if self.impl_methods.get(i).key1 == struct_name && self.impl_methods.get(i).key2 == method_name {
            return OptFunc::Some(self.impl_methods.get(i).val);
        }
        i = i + 1;
    }
    return OptFunc::None;
}

/// CS4: impl_index's key of a type's method (a name holds no newline).
fn lw_impl_key(struct_name: str, method_name: str) -> str {
    return struct_name + "\n" + method_name;
}

/// Whether `mangled_name` (Vec_x/HashMap_x/String_x) resolves to an impl
/// method whose self parameter is `& mut` — those need the receiver's
/// slot address at the call site, not the collection word.
pub fn Lowerer_mut_self_impl(self: & Lowerer, mangled_name: str) -> bool {
    var sname: str = "";
    if str_starts_with(mangled_name, "Vec_") {
        sname = "Vec";
    }
    if str_starts_with(mangled_name, "HashMap_") {
        sname = "HashMap";
    }
    if str_starts_with(mangled_name, "String_") {
        sname = "String";
    }
    if sname == "" {
        return false;
    }
    var mname: str = str_slice(mangled_name, str_len(sname) + 1, str_len(mangled_name));
    match Lowerer_lookup_impl_method(self, sname, mname) {
        OptFunc::Some(mf) => {
            if mf.params.len() > 0 {
                match mf.params.get(0).ty {
                    Type::Ref(_, pm) => {
                        return pm;
                    }
                    _ => {
                    }
                }
            }
        }
        OptFunc::None => {
        }
    }
    return false;
}

pub fn Lowerer_lookup_func_ret_type(self: & Lowerer, name: str) -> OptType {
    // CS4: own_ret_index holds the first entry of every name (only
    // Lowerer_insert_func_ret_type adds to func_ret_types)
    var rat: i64 = HashMap_get(self.own_ret_index, name) - 1;
    if rat >= 0 && rat < self.func_ret_types.len() && self.func_ret_types.get(rat).key == name {
        return OptType::Some(self.func_ret_types.get(rat).val);
    }
    var i: i64 = 0;
    if rat < 0 {
        // not a function's name: no entry to scan for
        i = self.func_ret_types.len();
    }
    while i < self.func_ret_types.len() {
        if self.func_ret_types.get(i).key == name {
            return OptType::Some(self.func_ret_types.get(i).val);
        }
        i = i + 1;
    }
    // roadmap L8F: a type's name (Lowerer_lower_call_expr); LG9: a gensym
    // name (Lowerer_lower_gensym_rt)
    if name == "type_name_of" || name == "p_type_name" || name == "gensym" {
        return OptType::Some(Type::Str);
    }
    return OptType::None;
}

pub fn Lowerer_lookup_type_alias(self: & Lowerer, name: str) -> OptType {
    var i: i64 = 0;
    while i < self.type_aliases.len() {
        if self.type_aliases.get(i).key == name {
            return OptType::Some(self.type_aliases.get(i).val);
        }
        i = i + 1;
    }
    return OptType::None;
}

pub fn Lowerer_is_async_func(self: & Lowerer, name: str) -> bool {
    var i: i64 = 0;
    while i < self.async_funcs.len() {
        if self.async_funcs.get(i) == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Check if a function is an extern (declared, not defined).
pub fn Lowerer_is_extern_func(self: & Lowerer, name: str) -> bool {
    return Lowerer_extern_at(self, name) >= 0;
}

/// CS4: the position of the first extern named `name` in
/// module.extern_functions, or -1. extern_index (a raw map handle, so a
/// shared `self` can add to it) maps each name to its first position + 1
/// and "#" to how many entries it covers + 1: externs are only ever added
/// at the end (IrModule_add_extern), and the entries added since the last
/// lookup are taken in first. Every call lowered asked this by a scan.
fn Lowerer_extern_at(self: & Lowerer, name: str) -> i64 {
    var n: i64 = self.module.extern_functions.len();
    var done: i64 = HashMap_get(self.extern_index, "#") - 1;
    if done < 0 {
        done = 0;
    }
    if done < n {
        var k: i64 = done;
        while k < n {
            if !HashMap_contains(self.extern_index, self.module.extern_functions.get(k).name) {
                HashMap_insert(self.extern_index, self.module.extern_functions.get(k).name, k + 1);
            }
            k = k + 1;
        }
        HashMap_insert(self.extern_index, "#", n + 1);
    }
    var at: i64 = HashMap_get(self.extern_index, name) - 1;
    if at < 0 {
        return - 1;
    }
    if at < n && self.module.extern_functions.get(at).name == name {
        return at;
    }
    var i: i64 = 0;
    while i < n {
        if self.module.extern_functions.get(i).name == name {
            return i;
        }
        i = i + 1;
    }
    return - 1;
}

pub fn Lowerer_lookup_param_type(self: & Lowerer, name: str) -> OptType {
    var i: i64 = 0;
    while i < self.current_func_param_types.len() {
        if self.current_func_param_types.get(i).key == name {
            return OptType::Some(self.current_func_param_types.get(i).val);
        }
        i = i + 1;
    }
    return OptType::None;
}

pub fn Lowerer_is_vec_alloca(self: & Lowerer, id: i64) -> bool {
    var i: i64 = 0;
    while i < self.vec_allocas.len() {
        if self.vec_allocas.get(i) == id {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// --- Map insert helpers ---------------------------------------------------

pub fn Lowerer_insert_struct(self: & mut Lowerer, name: str, val: StructDef) {
    self.structs.push(StringStructDefEntry_new(name, val));
    // CS4: the first entry for a name is the one lookups find
    if !HashMap_contains(self.struct_index, name) {
        HashMap_insert(self.struct_index, name, self.structs.len());
    }
}

pub fn Lowerer_insert_enum(self: & mut Lowerer, name: str, val: EnumDef) {
    self.enums.push(StringEnumDefEntry_new(name, val));
    if !HashMap_contains(self.enum_index, name) {
        HashMap_insert(self.enum_index, name, self.enums.len());
    }
}

pub fn Lowerer_insert_alloca(self: & mut Lowerer, name: str, val: i64) {
    var below: i64 = lw_ix_last_alloca(self.alloca_ix, & self.allocas, name);
    if below == - 2 {
        below = lw_scan_last_alloca(& self.allocas, name, self.allocas.len());
    }
    self.allocas.push(StringValueIdEntry_new(name, val));
    lw_ix_link(self.alloca_ix, name, self.allocas.len() - 1, below);
}

// --- SP12: name indexes of the variable tables ------------------------------
//
// allocas and var_ast_types are stacks (pushed by Lowerer_insert_alloca /
// Lowerer_insert_var_ast_type, cut back with truncate at a scope's end,
// replaced whole around a function lowered inside another). A lookup wants
// the last entry of a name; it scanned the stack, quadratic in a function's
// variables. The index (a raw map) holds name -> 1 + the position of the
// name's newest push, and "name@p" -> 1 + the last entry of the name below p
// when p was pushed (0: none). Entries cut off by a truncate are not
// removed: a lookup checks each position it is led to (still there, still
// that name) and otherwise follows the link down. That finds the last
// entry: an entry of the name above the one found would have been pushed
// later, so the walk would have met it first. After a whole replacement
// the index is built again (lw_ix_reset_tables).

/// Record that the entry at position `p` is named `name`; `below` is the
/// position of the name's last entry under p (-1: none).
fn lw_ix_link(m: i64, name: str, p: i64, below: i64) {
    HashMap_insert(m, name + "@" + int_to_str(p), below + 1);
    HashMap_insert(m, name, p + 1);
}

/// The position of the last entry of `v` named `name` (-1: none), from
/// the index `m`; -2 when the index cannot tell (the scan decides).
fn lw_ix_last_alloca(m: i64, v: & Vec<StringValueIdEntry>, name: str) -> i64 {
    var p: i64 = HashMap_get(m, name) - 1;
    while p >= 0 {
        if p < v.len() && v.get(p).key == name {
            return p;
        }
        var q: i64 = HashMap_get(m, name + "@" + int_to_str(p)) - 1;
        if q >= p {
            return - 2;
        }
        p = q;
    }
    return - 1;
}

/// As lw_ix_last_alloca, for var_ast_types.
fn lw_ix_last_var(m: i64, v: & Vec<StringTypeEntry>, name: str) -> i64 {
    var p: i64 = HashMap_get(m, name) - 1;
    while p >= 0 {
        if p < v.len() && v.get(p).key == name {
            return p;
        }
        var q: i64 = HashMap_get(m, name + "@" + int_to_str(p)) - 1;
        if q >= p {
            return - 2;
        }
        p = q;
    }
    return - 1;
}

/// The last entry of `v` named `name` below position `lim`, by a scan.
fn lw_scan_last_alloca(v: & Vec<StringValueIdEntry>, name: str, lim: i64) -> i64 {
    var i: i64 = lim - 1;
    while i >= 0 {
        if v.get(i).key == name {
            return i;
        }
        i = i - 1;
    }
    return - 1;
}

/// As lw_scan_last_alloca, for var_ast_types.
fn lw_scan_last_var(v: & Vec<StringTypeEntry>, name: str, lim: i64) -> i64 {
    var i: i64 = lim - 1;
    while i >= 0 {
        if v.get(i).key == name {
            return i;
        }
        i = i - 1;
    }
    return - 1;
}

/// SP12: after allocas and var_ast_types were replaced whole, their indexes
/// are made again from the entries, in order.
fn Lowerer_ix_reset_tables(self: & mut Lowerer) {
    HashMap_drop(self.alloca_ix);
    self.alloca_ix = HashMap_new();
    var i: i64 = 0;
    while i < self.allocas.len() {
        // the entries below i are indexed: the index finds the name's last
        var an: str = self.allocas.get(i).key;
        var ab: i64 = lw_ix_last_alloca(self.alloca_ix, & self.allocas, an);
        if ab < - 1 || ab >= i {
            ab = lw_scan_last_alloca(& self.allocas, an, i);
        }
        lw_ix_link(self.alloca_ix, an, i, ab);
        i = i + 1;
    }
    HashMap_drop(self.var_ast_ix);
    self.var_ast_ix = HashMap_new();
    i = 0;
    while i < self.var_ast_types.len() {
        var vn: str = self.var_ast_types.get(i).key;
        var vb: i64 = lw_ix_last_var(self.var_ast_ix, & self.var_ast_types, vn);
        if vb < - 1 || vb >= i {
            vb = lw_scan_last_var(& self.var_ast_types, vn, i);
        }
        lw_ix_link(self.var_ast_ix, vn, i, vb);
        i = i + 1;
    }
    // alloca_types: made again at the next insert into a long table
    if self.alloca_type_ix != 0 {
        HashMap_drop(self.alloca_type_ix);
        self.alloca_type_ix = 0;
    }
}

pub fn Lowerer_insert_alloca_type(self: & mut Lowerer, id: i64, ty: IrType) {
    self.alloca_types.push(I64IrTypeEntry_new(id, ty));
    // SP12: a long function's table is indexed (a lookup scanned it all)
    if self.alloca_type_ix != 0 {
        Lowerer_at_ix_add(self, self.alloca_types.len() - 1);
    } else if self.alloca_types.len() >= g_lw_at_ix_min {
        self.alloca_type_ix = HashMap_new();
        var i: i64 = 0;
        while i < self.alloca_types.len() {
            Lowerer_at_ix_add(self, i);
            i = i + 1;
        }
    }
}

// --- SP12: the index of alloca_types ----------------------------------------
//
// alloca_types (slot id -> IR type) is a stack like allocas: pushed by
// Lowerer_insert_alloca_type, cut back with truncate, replaced whole around
// a function lowered inside another (then Lowerer_ix_reset_tables drops the
// index), changed in place only with the same id. A lookup wants the FIRST
// entry of an id. The index holds "#id" -> 1 + the position of the id's
// newest push and "#id@p" -> 1 + the id's last entry below p when p was
// pushed (0: none), as lw_ix_link does for names: every entry of the id
// still in the table is on that chain, newest first, so its lowest entry
// still there is the first. Positions cut off are skipped (no longer there,
// or holding another id); a link that does not go down sends the lookup to
// the scan.

/// Tables shorter than this are scanned (no index; a test may raise it).
var g_lw_at_ix_min: i64 = 32;

/// Link entry `p` of alloca_types into the index.
fn Lowerer_at_ix_add(self: & mut Lowerer, p: i64) {
    val id: i64 = self.alloca_types.get(p).key;
    val k: str = "#" + int_to_str(id);
    val below: i64 = lw_at_ix_last_below(self.alloca_type_ix, & self.alloca_types, id, p);
    HashMap_insert(self.alloca_type_ix, k + "@" + int_to_str(p), below + 1);
    HashMap_insert(self.alloca_type_ix, k, p + 1);
}

/// The last entry of `id` in `v` below position `lim` (-1: none).
fn lw_at_ix_last_below(m: i64, v: & Vec<I64IrTypeEntry>, id: i64, lim: i64) -> i64 {
    val k: str = "#" + int_to_str(id);
    var p: i64 = HashMap_get(m, k) - 1;
    while p >= 0 {
        if p < lim && p < v.len() && v.get(p).key == id {
            return p;
        }
        val q: i64 = HashMap_get(m, k + "@" + int_to_str(p)) - 1;
        if q >= p {
            break;
        }
        p = q;
    }
    if p < 0 {
        return - 1;
    }
    // a link that does not go down: the scan decides
    var i: i64 = lim - 1;
    if i >= v.len() {
        i = v.len() - 1;
    }
    while i >= 0 {
        if v.get(i).key == id {
            return i;
        }
        i = i - 1;
    }
    return - 1;
}

/// The first entry of `id` in `v` from the index `m` (-1: none), or -2
/// when the index cannot tell (the scan decides).
fn lw_at_ix_first(m: i64, v: & Vec<I64IrTypeEntry>, id: i64) -> i64 {
    val k: str = "#" + int_to_str(id);
    var p: i64 = HashMap_get(m, k) - 1;
    var first: i64 = - 1;
    while p >= 0 {
        if p < v.len() && v.get(p).key == id {
            first = p;
        }
        val q: i64 = HashMap_get(m, k + "@" + int_to_str(p)) - 1;
        if q >= p {
            return - 2;
        }
        p = q;
    }
    return first;
}

/// A struct, or a pointer to one (CI3).
fn lw_ir_struct_or_ptr(t: IrType) -> bool {
    match t {
        IrType::Struct(_) => {
            return true;
        }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Struct(_) => {
                    return true;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// B19 (RT6's rest): `var v = Vec::new()` written without a type is a
/// `Vec<i64>` slot to the lowering, and the parser types it only from a
/// pushed literal. A push of a float value (a variable, a call) onto such a
/// slot makes it a `Vec<f64>` from there on, so `v.get(i)` is a float and
/// `print(v.get(0))` prints 1.5, not its bits. Only f64: it is stored as
/// the same 8-byte word with no element type to own (code and tid 0), so
/// the Vec made as a Vec<i64> is already a Vec<f64>. A slot written as
/// `Vec<i64>` never gets a float pushed (the type checker refuses it).
fn Lowerer_retype_untyped_vec(self: & mut Lowerer, receiver: Expr, arg: i64) {
    match Lowerer_get_value_type(self, arg) {
        IrType::F64 => {
        }
        _ => {
            return;
        }
    }
    var vn: str = "";
    match receiver {
        Expr::Ident(n) => {
            vn = n;
        }
        _ => {
            return;
        }
    }
    var slot: i64 = - 1;
    match Lowerer_lookup_alloca(self, vn) {
        OptValueId::Some(a) => {
            slot = a;
        }
        OptValueId::None => {
            return;
        }
    }
    var i: i64 = 0;
    while i < self.alloca_types.len() {
        var e: I64IrTypeEntry = self.alloca_types.get(i);
        if e.key == slot {
            var is_vec_i64: bool = false;
            match e.val {
                IrType::Generic(gn, ga) => {
                    if gn == "Vec" && ga.len() == 1 {
                        match ga.get(0) {
                            IrType::I64 => {
                                is_vec_i64 = true;
                            }
                            _ => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
            if !is_vec_i64 {
                return;
            }
            var fa: Vec<IrType> = Vec::new();
            fa.push(IrType::F64);
            self.alloca_types.set(i, I64IrTypeEntry_new(slot, IrType::Generic("Vec", fa)));
            var ta: Vec<Type> = Vec::new();
            ta.push(Type::F64);
            Lowerer_insert_var_ast_type(self, vn, Type::Generic("Vec", ta));
            return;
        }
        i = i + 1;
    }
}

/// RT6: the type of `var name = Vec::new()` (no type written) at `line`
/// when the type checker typed it from its first push (a string, bool,
/// float, struct, enum, Vec, map or Box value: ast.fd rt6_elem_at): `Vec<T>`,
/// so the Vec is made with T's element code and owns what it holds. None
/// for any other `let`, and when the checker found no type.
fn Lowerer_rt6_let_type(self: & Lowerer, name: str, ty: OptType, expr: Expr, line: i64) -> OptType {
    match ty {
        OptType::Some(_) => {
            return OptType::None;
        }
        OptType::None => {
        }
    }
    // RT5: `var m = HashMap::new()` the type checker typed from its first
    // insert of a struct or tuple key: the `HashMap<K, V>` it found, so the
    // map takes the path of a written type (ast.fd rt6_map_at)
    if lw_is_map_new_expr(expr) && self.has_current_func {
        match rt6_map_at(self.current_func.name, name, line) {
            OptType::Some(mt) => {
                match mt {
                    Type::Generic(mn, margs) => {
                        if mn == "HashMap" && margs.len() == 2 {
                            return OptType::Some(mt);
                        }
                    }
                    _ => {
                    }
                }
            }
            OptType::None => {
            }
        }
        return OptType::None;
    }
    if !lw_is_vec_new_expr(expr) || !self.has_current_func {
        return OptType::None;
    }
    match rt6_elem_at(self.current_func.name, name, line) {
        OptType::Some(et) => {
            var ta: Vec<Type> = Vec::new();
            ta.push(et);
            return OptType::Some(Type::Generic("Vec", ta));
        }
        OptType::None => {
        }
    }
    return OptType::None;
}

pub fn Lowerer_insert_var_ast_type(self: & mut Lowerer, name: str, ty: Type) {
    var below: i64 = lw_ix_last_var(self.var_ast_ix, & self.var_ast_types, name);
    if below == - 2 {
        below = lw_scan_last_var(& self.var_ast_types, name, self.var_ast_types.len());
    }
    self.var_ast_types.push(StringTypeEntry_new(name, ty));
    lw_ix_link(self.var_ast_ix, name, self.var_ast_types.len() - 1, below);
}

/// BG276: a const's declared type its value is cast to: a number type other
/// than i64 (the type a bare integer literal lowers to).
fn lw_const_cast_type(t: Type) -> bool {
    match t {
        Type::I8 => {
            return true;
        }
        Type::I16 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        Type::U8 => {
            return true;
        }
        Type::U16 => {
            return true;
        }
        Type::U32 => {
            return true;
        }
        Type::U64 => {
            return true;
        }
        Type::F32 => {
            return true;
        }
        Type::F64 => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

pub fn Lowerer_insert_constant(self: & mut Lowerer, name: str, expr: Expr) {
    self.constants.push(StringExprEntry_new(name, expr));
}

pub fn Lowerer_insert_impl_method(self: & mut Lowerer, struct_name: str, method_name: str, val: Func) {
    self.impl_methods.push(StringStringFuncEntry_new(struct_name, method_name, val));
    // CS4: the first entry for a type's method is the one lookups find
    var ik: str = lw_impl_key(struct_name, method_name);
    if !HashMap_contains(self.impl_index, ik) {
        HashMap_insert(self.impl_index, ik, self.impl_methods.len());
    }
}

pub fn Lowerer_insert_func_ret_type(self: & mut Lowerer, name: str, ty: Type) {
    self.func_ret_types.push(StringTypeEntry_new(name, ty));
    // The first entry for a name is the one lookups find
    if !HashMap_contains(self.own_ret_index, name) {
        HashMap_insert(self.own_ret_index, name, self.func_ret_types.len());
    }
}

/// BG392: the return type of method `mangled` (`Type_method`, the name its
/// calls are emitted under), `Self` resolved to `owner`. Without it
/// Lowerer_rc_ret_type found nothing for the call and a returned str/Vec/map
/// was never made a temporary of the statement: it leaked on every call. The
/// name goes into `taken` like a bare method name, so a program function of
/// the same name (registered later) takes the lookup over.
fn Lowerer_reg_method_ret(self: & mut Lowerer, owner: str, mangled: str, ret: Type, taken: i64) {
    var saved_self: OptStringLower = self.current_self_type;
    self.current_self_type = OptStringLower::Some(owner);
    var rt: Type = Lowerer_resolve_self_in_type(self, ret);
    self.current_self_type = saved_self;
    if !HashMap_contains(self.own_ret_index, mangled) {
        Lowerer_insert_func_ret_type(self, mangled, rt);
        HashMap_insert(taken, mangled, 1);
    }
}

pub fn Lowerer_insert_type_alias(self: & mut Lowerer, name: str, ty: Type) {
    self.type_aliases.push(StringTypeEntry_new(name, ty));
}

pub fn Lowerer_insert_param_type(self: & mut Lowerer, name: str, ty: Type) {
    self.current_func_param_types.push(StringTypeEntry_new(name, ty));
}

pub fn Lowerer_insert_async_func(self: & mut Lowerer, name: str) {
    self.async_funcs.push(name);
}

/// A value a task can hold across a suspension and hand back: one word that
/// does not point into its caller's stack.
fn lw_task_word(ty: Type) -> bool {
    match ty {
        Type::I8 => {
            return true;
        }
        Type::I16 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        Type::I64 => {
            return true;
        }
        Type::U8 => {
            return true;
        }
        Type::U16 => {
            return true;
        }
        Type::U32 => {
            return true;
        }
        Type::U64 => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        Type::Str => {
            return true;
        }
        Type::Void => {
            return true;
        }
        Type::Named(n) => {
            return n == "str";
        }
        Type::Generic(n, _) => {
            return n == "Vec" || n == "VecV" || n == "HashMap";
        }
        _ => {
            return false;
        }
    }
}

/// The type a function's body returns: for an `async fn ... -> Future<T>`,
/// T (the future is made by the caller or the task runtime). An f64 result
/// was lowered as a word and truncated (2.5 came back as 2).
fn lw_body_ret_type(func: Func) -> Type {
    if func.is_async {
        match func.ret_ty {
            Type::Generic(n, args) => {
                if n == "Future" && args.len() > 0 {
                    return args.get(0);
                }
            }
            _ => {
            }
        }
    }
    return func.ret_ty;
}

fn lw_is_async_task(func: Func) -> bool {
    var ret: Type = func.ret_ty;
    match func.ret_ty {
        Type::Generic(n, args) => {
            if n == "Future" {
                ret = Type::Void;
                if args.len() > 0 {
                    ret = args.get(0);
                }
            }
        }
        _ => {
        }
    }
    if !lw_task_word(ret) {
        return false;
    }
    var i: i64 = 0;
    while i < func.params.len() {
        if !lw_task_word(func.params.get(i).ty) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn Lowerer_insert_linear_struct(self: & mut Lowerer, name: str) {
    self.linear_structs.push(name);
}

pub fn Lowerer_insert_vec_alloca(self: & mut Lowerer, id: i64) {
    self.vec_allocas.push(id);
}

/// Whether a match arm's binding `name` of type `t` gets a copy of its own
/// (Lowerer_lower_match): a struct that owns something (RC_MEM) which the
/// arm body assigns (`p = q`), replaces a field of (`p.v = w`, `p.a.b = w`)
/// or changes otherwise (`& mut p`, `p.v.push(x)`: cow_first_change).
fn Lowerer_mb_owns_copy(self: & mut Lowerer, name: str, t: Type, body: Vec<Stmt>) -> bool {
    if !self.own_on {
        return false;
    }
    // BG30: a string binding the arm assigns (`s = t`, `s += t`) is a
    // variable of its own too (an owner of a copy, dropped when the arm
    // ends): a binding has no slot, and the assignment was lost
    if Lowerer_rc_kind(self, t) == RC_STR {
        var sassigned: Vec<str> = Vec::new();
        collect_assign_targets(body, & mut sassigned);
        return lw_c_str_vec_contains(sassigned, name);
    }
    if Lowerer_rc_kind(self, t) != RC_MEM {
        return false;
    }
    // a struct with `drop` stays as it was (a `let` of one registers a
    // drop at the function's exit, which other arms' paths would run too)
    match Lowerer_type_struct_name(self, t) {
        OptStringLower::Some(dsn) => {
            if Lowerer_has_drop_impl(self, dsn) {
                return false;
            }
        }
        OptStringLower::None => {
        }
    }
    var assigned: Vec<str> = Vec::new();
    collect_assign_targets(body, & mut assigned);
    if lw_c_str_vec_contains(assigned, name) {
        return true;
    }
    if lw_mb_field_assigned(body, name) {
        return true;
    }
    return cow_first_change(body, name, 0) > 0;
}

/// BG258: whether a match arm's binding `name` of type `t`, a value that
/// owns nothing (a number, a bool, a plain struct), is assigned by the arm
/// body (`x = x * 2`, `x += 1`): it then becomes a variable of its own, as
/// `var x = binding;`. A binding has no slot, so the assignment stored
/// nowhere and every later read saw the payload.
fn Lowerer_mb_plain_assigned(self: & mut Lowerer, name: str, t: Type, body: Vec<Stmt>) -> bool {
    if Lowerer_rc_kind(self, t) != RC_NONE {
        return false;
    }
    match t {
        Type::Infer => {
            return false;
        }
        _ => {
        }
    }
    var assigned: Vec<str> = Vec::new();
    collect_assign_targets(body, & mut assigned);
    return lw_c_str_vec_contains(assigned, name);
}

/// BG32: whether an arm's value (its last expression) is the variable `name`.
fn lw_arm_tail_is(body: Vec<Stmt>, name: str) -> bool {
    match if_branch_tail_expr(body) {
        OptExpr::Some(te) => {
            match te {
                Expr::Ident(tn) => {
                    return tn == name;
                }
                _ => {
                }
            }
        }
        OptExpr::None => {
        }
    }
    return false;
}

/// Whether a statement list (all nested bodies) assigns a field of a place
/// rooted at `name` (`name.f = ..`, `name.f.g += ..`).
fn lw_mb_field_assigned(stmts: Vec<Stmt>, name: str) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::FieldAssign(obj, _f, _op, _e, _line) => {
                if cow_root(obj) == name {
                    return true;
                }
            }
            Stmt::If(_c, tb, eb, _line) => {
                if lw_mb_field_assigned(tb, name) {
                    return true;
                }
                match eb {
                    OptStmts::Some(ebs) => {
                        if lw_mb_field_assigned(ebs, name) {
                            return true;
                        }
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::While(_c, b, _line) => {
                if lw_mb_field_assigned(b, name) {
                    return true;
                }
            }
            Stmt::For(_v, _it, b, _line) => {
                if lw_mb_field_assigned(b, name) {
                    return true;
                }
            }
            Stmt::Loop(b, _line) => {
                if lw_mb_field_assigned(b, name) {
                    return true;
                }
            }
            Stmt::Defer(b, _line) => {
                if lw_mb_field_assigned(b, name) {
                    return true;
                }
            }
            Stmt::Unsafe(b, _line) => {
                if lw_mb_field_assigned(b, name) {
                    return true;
                }
            }
            Stmt::Sandbox(b, _line) => {
                if lw_mb_field_assigned(b, name) {
                    return true;
                }
            }
            Stmt::Txn(b, _line) => {
                if lw_mb_field_assigned(b, name) {
                    return true;
                }
            }
            Stmt::RegionBlock(_n, _b, _g, _kv, _w, b, _line) => {
                if lw_mb_field_assigned(b, name) {
                    return true;
                }
            }
            Stmt::SpawnScope(b, _line) => {
                if lw_mb_field_assigned(b, name) {
                    return true;
                }
            }
            Stmt::Match(_e, arms, _line) => {
                var ai: i64 = 0;
                while ai < arms.len() {
                    if lw_mb_field_assigned(arms.get(ai).body, name) {
                        return true;
                    }
                    ai = ai + 1;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return false;
}

// Names rebound by `x = ...` anywhere in a statement list (all nested
// bodies). IndexAssign/DerefAssign/FieldAssign write through a value —
// they mutate contents, not the binding — so they do not count.
fn collect_assign_targets(stmts: Vec<Stmt>, out: & mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        var stmt: Stmt = stmts.get(i);
        match stmt {
            Stmt::Assign(target, _op, _expr, _line) => {
                if !lw_c_str_vec_contains(out, target) {
                    out.push(target);
                }
            }
            Stmt::If(_c, then_block, else_block, _line) => {
                collect_assign_targets(then_block, out);
                match else_block {
                    OptStmts::Some(eb) => {
                        collect_assign_targets(eb, out);
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::While(_c, body, _line) => {
                collect_assign_targets(body, out);
            }
            Stmt::For(_v, _it, body, _line) => {
                collect_assign_targets(body, out);
            }
            Stmt::Loop(body, _line) => {
                collect_assign_targets(body, out);
            }
            Stmt::Defer(body, _line) => {
                collect_assign_targets(body, out);
            }
            Stmt::Unsafe(body, _line) => {
                collect_assign_targets(body, out);
            }
            Stmt::Sandbox(body, _line) => {
                collect_assign_targets(body, out);
            }
            Stmt::Txn(body, _line) => {
                collect_assign_targets(body, out);
            }
            Stmt::RegionBlock(_n, _b, _g, _kv, _w, body, _line) => {
                collect_assign_targets(body, out);
            }
            Stmt::GradBlock(_v, body, _line) => {
                collect_assign_targets(body, out);
            }
            Stmt::Query(_n, body, _line) => {
                collect_assign_targets(body, out);
            }
            Stmt::ComptimeGen(body, _line) => {
                collect_assign_targets(body, out);
            }
            Stmt::SpawnScope(body, _line) => {
                collect_assign_targets(body, out);
            }
            Stmt::Match(_e, arms, _line) => {
                var ai: i64 = 0;
                while ai < arms.len() {
                    var arm: MatchArm = arms.get(ai);
                    collect_assign_targets(arm.body, out);
                    ai = ai + 1;
                }
            }
            Stmt::Handle(body, handlers, _line) => {
                collect_assign_targets(body, out);
                var hi: i64 = 0;
                while hi < handlers.len() {
                    var h: EffectHandler = handlers.get(hi);
                    collect_assign_targets(h.body, out);
                    hi = hi + 1;
                }
            }
            Stmt::Select(cases, default, _line) => {
                var ci: i64 = 0;
                while ci < cases.len() {
                    var c: SelectCase = cases.get(ci);
                    collect_assign_targets(c.body, out);
                    ci = ci + 1;
                }
                match default {
                    OptStmts::Some(db) => {
                        collect_assign_targets(db, out);
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::Parallel(branches, _line) => {
                var bi: i64 = 0;
                while bi < branches.len() {
                    collect_assign_targets(branches.get(bi), out);
                    bi = bi + 1;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
}

// --- Emit helpers ---------------------------------------------------------

/// Check if a function name is a user-defined function (not a runtime builtin).
/// User functions get __env as first argument; runtime functions (p_*, __ecs_*) don't.
pub fn Lowerer_is_user_func(self: & Lowerer, name: str) -> bool {
    return lw_fn_at(& self.module, name) >= 0;
}

/// CS4: the position in `m.functions` that IrModule_get_function finds
/// `name` at (the same lazy fn_index: entries pushed since the last lookup
/// indexed first, the first of a name wins), or -1. IrModule_get_function
/// hands back a copy of the whole function (every Vec of it shared, then
/// dropped): asking whether a name is a function, for every call lowered,
/// paid for that.
fn lw_fn_at(m: & IrModule, name: str) -> i64 {
    var i: i64 = HashMap_len(m.fn_index);
    while i < m.functions.len() {
        if HashMap_get(m.fn_index, m.functions.get(i).name) == 0 {
            HashMap_insert(m.fn_index, m.functions.get(i).name, i + 1);
        }
        i = i + 1;
    }
    return HashMap_get(m.fn_index, name) - 1;
}

/// Check if a function exists in the module (user functions only).
pub fn Lowerer_has_function(self: & Lowerer, name: str) -> bool {
    return Lowerer_is_user_func(self, name);
}

pub fn Lowerer_is_struct(self: & Lowerer, name: str) -> bool {
    // CS4: as Lowerer_lookup_struct
    var sat: i64 = HashMap_get(self.struct_index, name) - 1;
    if sat < 0 {
        return false;
    }
    if sat < self.structs.len() && self.structs.get(sat).key == name {
        return true;
    }
    var i: i64 = 0;
    while i < self.structs.len() {
        if self.structs.get(i).key == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn Lowerer_emit_inst(self: & mut Lowerer, inst: Inst) -> i64 {
    // The statement's line, set as the value's meta is made (CS4: no
    // get/set copy of the meta afterwards)
    var line: OptU64 = OptU64::None;
    if self.cur_line > 0 {
        line = OptU64::Some(self.cur_line as u64);
    }
    var id: i64 = IrFunction_emit_line(& mut self.current_func, inst, line);
    // A call's result is a temporary the statement owns (proposal 0004)
    if self.own_on {
        match inst {
            Inst::Call(cname, _, cty, _) => {
                Lowerer_rc_note_call(self, id, cname, cty);
            }
            _ => {
            }
        }
    }
    // CM3: a struct stored whole no longer shares its Vec fields
    // copy-on-write here (the retired LOWER_COW); ownership (proposal 0004)
    // gives the copy owners of its own (Lowerer_rc_own_value)
    return id;
}

/// Whether a stored struct value is a temporary nobody else holds: an
/// Alloca that is no variable's slot (a struct literal, a call's result
/// slot) or a variable read for the last time. Its Vec fields need no
/// copy-on-write share.
fn Lowerer_fresh_struct(self: & Lowerer, v: i64) -> bool {
    match IrFunction_get_inst(& self.current_func, v) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Alloca(_, _) => {
                    var i: i64 = 0;
                    while i < self.allocas.len() {
                        if self.allocas.get(i).val == v {
                            return Lowerer_last_use(self, self.allocas.get(i).key);
                        }
                        i = i + 1;
                    }
                    return true;
                }
                _ => {
                }
            }
        }
        OptInst::None => {
            // a parameter (it has no instruction) on its last use
            var j: i64 = self.current_func.locals.len() - 1;
            while j >= 0 {
                if self.current_func.locals.get(j).id == v {
                    return Lowerer_last_use(self, self.current_func.locals.get(j).name);
                }
                j = j - 1;
            }
        }
    }
    return false;
}

/// The Vec fields of the struct at `ptr` (nested struct fields too) become
/// copy-on-write shares of the ones they were copied from.
fn Lowerer_emit_struct_share(self: & mut Lowerer, ptr: i64, name: str, depth: i64) {
    if depth > 8 {
        return;
    }
    match Lowerer_lookup_enum(self, name) {
        OptEnumDef::Some(_) => {
            return;
        }
        OptEnumDef::None => {
        }
    }
    match IrModule_get_struct(& self.module, name) {
        OptStructLayout::Some(layout) => {
            // The field addresses are taken from a pointer typed as this
            // struct: `ptr` may be typed as what holds it (an enum's payload),
            // whose layout gives other offsets
            var sty: IrType = IrType::Ptr(Box::new(IrType::Struct(name)));
            var sptr: i64 = IrFunction_emit(& mut self.current_func, Inst::BitCast(ptr, Lowerer_get_value_type(self, ptr), sty));
            Lowerer_set_value_type(self, sptr, sty);
            var fi: i64 = 0;
            while fi < layout.fields.len() {
                var fty: IrType = layout.fields.get(fi).ty;
                var is_vec: bool = false;
                var sub: str = "";
                match fty {
                    IrType::Generic(gn, _) => {
                        is_vec = gn == "Vec";
                    }
                    IrType::Opaque(oname) => {
                        is_vec = oname == "Vec";
                    }
                    IrType::Struct(sn) => {
                        sub = sn;
                    }
                    _ => {
                    }
                }
                if is_vec || str_len(sub) > 0 {
                    var fp: i64 = IrFunction_emit(& mut self.current_func, Inst::GetFieldPtr(sptr, fi, fty));
                    if str_len(sub) > 0 {
                        Lowerer_emit_struct_share(self, fp, sub, depth + 1);
                    } else {
                        var v: i64 = IrFunction_emit(& mut self.current_func, Inst::Load(fp, fty));
                        var shared: i64 = Lowerer_emit_vec_share(self, v, fty);
                        IrFunction_emit(& mut self.current_func, Inst::Store(fp, shared, OptIrType::None));
                    }
                }
                fi = fi + 1;
            }
        }
        OptStructLayout::None => {
        }
    }
}

pub fn Lowerer_new_value(self: & mut Lowerer, meta: ValueMeta) -> i64 {
    return IrFunction_new_value(& mut self.current_func, meta);
}

pub fn Lowerer_new_block(self: & mut Lowerer) -> i64 {
    var bb: i64 = IrFunction_new_block(& mut self.current_func);
    return bb;
}

pub fn Lowerer_set_current_block(self: & mut Lowerer, block: i64) {
    self.current_block = block;
    self.current_func.current_block_idx = block;
}

pub fn Lowerer_current_block_has_terminator(self: & Lowerer) -> bool {
    if !self.has_current_func {
        return false;
    }
    if self.current_block < 0 {
        return false;
    }
    if self.current_block >= self.current_func.blocks.len() {
        return false;
    }
    // CS4: the block and its last instruction read in place (a copy of the
    // block made a header and a share box for each of its lists, a copy of
    // the instruction one for each of its operand lists)
    var nins: i64 = self.current_func.blocks.get(self.current_block).instructions.len();
    if nins == 0 {
        return false;
    }
    var last_id: i64 = self.current_func.blocks.get(self.current_block).instructions.get(nins - 1);
    var at: i64 = lw_inst_pos(& self.current_func, last_id);
    if at < 0 {
        return false;
    }
    return inst_is_terminator(self.current_func.insts.get(at).inst);
}

pub fn Lowerer_set_value_type(self: & mut Lowerer, id: i64, ty: IrType) {
    match IrFunction_get_meta(& self.current_func, id) {
        OptValueMeta::Some(meta) => {
            IrFunction_set_meta(& mut self.current_func, id, ValueMeta_with_type(meta, ty));
        }
        OptValueMeta::None => {
        }
    }
}

pub fn Lowerer_get_value_type(self: & Lowerer, val: i64) -> IrType {
    // CS4: the meta IrFunction_get_meta would find, read in place (it
    // hands back a copy of the whole meta, its effect list shared)
    if val >= 0 && val < self.current_func.value_metas.len() && self.current_func.value_metas.get(val).id == val {
        return self.current_func.value_metas.get(val).meta.ty;
    }
    var i: i64 = 0;
    while i < self.current_func.value_metas.len() {
        if self.current_func.value_metas.get(i).id == val {
            return self.current_func.value_metas.get(i).meta.ty;
        }
        i = i + 1;
    }
    return IrType::I64;
}

pub fn Lowerer_emit_terminator(self: & mut Lowerer, inst: Inst) {
    var _v: i64 = Lowerer_emit_inst(self, inst);
}

pub fn Lowerer_bind_local(self: & mut Lowerer, name: str, val: i64) {
    IrFunction_bind_local(& mut self.current_func, name, val);
}

pub fn Lowerer_lookup_local(self: & Lowerer, name: str) -> OptValueId {
    return IrFunction_lookup_local(& self.current_func, name);
}

pub fn Lowerer_add_block_param(self: & mut Lowerer, block: i64, ty: IrType) -> i64 {
    return IrFunction_add_block_param(& mut self.current_func, block, ty);
}

// --- Extern registration helpers ------------------------------------------
// These avoid creating temporary Vec<IrType> for each add_extern call.

pub fn Lowerer_add_extern_0(self: & mut Lowerer, name: str, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    IrModule_add_extern(& mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_1(self: & mut Lowerer, name: str, p1: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    IrModule_add_extern(& mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_2(self: & mut Lowerer, name: str, p1: IrType, p2: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    params.push(p2);
    IrModule_add_extern(& mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_3(self: & mut Lowerer, name: str, p1: IrType, p2: IrType, p3: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    params.push(p2);
    params.push(p3);
    IrModule_add_extern(& mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_4(self: & mut Lowerer, name: str, p1: IrType, p2: IrType, p3: IrType, p4: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    params.push(p2);
    params.push(p3);
    params.push(p4);
    IrModule_add_extern(& mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_5(self: & mut Lowerer, name: str, p1: IrType, p2: IrType, p3: IrType, p4: IrType, p5: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    params.push(p2);
    params.push(p3);
    params.push(p4);
    params.push(p5);
    IrModule_add_extern(& mut self.module, name, params, ret);
}

// Common type aliases
pub fn lw_ptr_u8() -> IrType {
    return IrType::Ptr(Box::new(IrType::U8));
}
pub fn opaque_ty(name: str) -> IrType {
    return IrType::Opaque(name);
}

// --- Type resolution ------------------------------------------------------

pub fn Lowerer_resolve_type(self: & Lowerer, ty: Type) -> Type {
    match ty {
        Type::Named(name) => {
            match Lowerer_lookup_type_alias(self, name) {
                OptType::Some(alias) => {
                    return Lowerer_resolve_type(self, alias);
                }
                OptType::None => {
                    return Type::Named(name);
                }
            }
            return Type::Named(name);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(Lowerer_resolve_type(self, lw_box_type_unbox(inner))), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(Box::new(Lowerer_resolve_type(self, lw_box_type_unbox(inner))), is_mut);
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(Lowerer_resolve_type(self, lw_box_type_unbox(elem))), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(Box::new(Lowerer_resolve_type(self, lw_box_type_unbox(elem))), size_param);
        }
        Type::Generic(name, args) => {
            var resolved_args: Vec<Type> = Vec::new();
            var gi: i64 = 0;
            while gi < args.len() {
                resolved_args.push(Lowerer_resolve_type(self, args.get(gi)));
                gi = gi + 1;
            }
            return Type::Generic(name, resolved_args);
        }
        other => {
            return other;
        }
    }
    return ty;
}

pub fn Lowerer_lower_type(self: & Lowerer, ty: Type) -> IrType {
    var resolved: Type = Lowerer_resolve_type(self, ty);
    // A borrowed string (`&str`, release M11) is the string's pointer, as an
    // owned `str` is: the type checker keeps it from outliving its owner
    if lw_is_borrowed_str(resolved) {
        return lw_ptr_u8();
    }
    // An `Rc<T>` or an `Arc<T>` is the address of its block [count, value]:
    // a word (Lowerer_lower_rc_new)
    match resolved {
        Type::Generic(rcn, _) => {
            if rcn == "Rc" || rcn == "Arc" {
                return IrType::I64;
            }
        }
        _ => {
        }
    }
    // A generic enum (Option<f64>) is laid out as the enum itself: its type
    // arguments only say what its payloads hold
    match resolved {
        Type::Generic(gname, _) => {
            match Lowerer_lookup_enum(self, gname) {
                OptEnumDef::Some(_) => {
                    return lower_type(Type::Named(gname));
                }
                OptEnumDef::None => {
                }
            }
        }
        _ => {
        }
    }
    return lower_type(resolved);
}

/// Like lower_type, but converts enum types (e.g. Result<T,E>, Option<T>)
/// from Generic("Result", ...) to Struct("Result") so that SRET calling
/// convention treats them as aggregate types.
/// Used only at function signature boundaries (return type + call sites).
/// Field type of a tuple element: a struct pointer is stored inline as the
/// struct (src/lower.rs TupleLit; Lowerer_register_tuple_layout).
pub fn lw_tuple_field_ty(ty: IrType) -> IrType {
    match ty {
        IrType::Ptr(inner) => {
            var it: IrType = box_ir_type_unbox(inner);
            match it {
                IrType::Struct(_) => {
                    return it;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return ty;
}

/// The tuple layout a value of IR type `t` is (a `__tuple_` struct, or a
/// pointer to one), or "".
fn lw_tuple_struct_name(t: IrType) -> str {
    match t {
        IrType::Struct(sn) => {
            if str_starts_with(sn, "__tuple_") {
                return sn;
            }
        }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Struct(sn2) => {
                    if str_starts_with(sn2, "__tuple_") {
                        return sn2;
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return "";
}

/// The code of a tuple field's IR type in its layout's name
/// (lw_tuple_layout_name): a letter for each scalar, `p` a pointer (a
/// string), `s<len>_<name>` a struct held inline (a nested tuple too), `v`
/// nothing, `w` any other word, `x<size>_` any other room.
fn lw_tuple_field_code(ty: IrType) -> str {
    match ty {
        IrType::I8 => {
            return "b";
        }
        IrType::I16 => {
            return "h";
        }
        IrType::I32 => {
            return "i";
        }
        IrType::I64 => {
            return "l";
        }
        IrType::U8 => {
            return "B";
        }
        IrType::U16 => {
            return "H";
        }
        IrType::U32 => {
            return "I";
        }
        IrType::U64 => {
            return "L";
        }
        IrType::F32 => {
            return "f";
        }
        IrType::F64 => {
            return "d";
        }
        IrType::Bool => {
            return "z";
        }
        IrType::Ptr(_) => {
            return "p";
        }
        IrType::Struct(sn) => {
            return "s" + int_to_str(str_len(sn)) + "_" + sn;
        }
        IrType::Void => {
            return "v";
        }
        _ => {
        }
    }
    var size: i64 = ir_type_size(ty);
    if size == 8 {
        return "w";
    }
    return "x" + int_to_str(size) + "_";
}

/// The name of the layout of a tuple whose fields (lw_tuple_field_ty of
/// the element types) are `ftys`: `__tuple_<n>_<codes>`, one code per field
/// (lw_tuple_field_code), `__tuple_0` for the empty tuple. Named by its
/// shape, so two tuples of one length, `(str, i64)` and `((str, i64),
/// i64)`, have a layout each (a name made of the length alone gave both
/// one layout, the last registered, and the other's fields were read at
/// its offsets). The name holds the field types: a cached function's
/// layouts are made again from it (Lowerer_irc_tuple_layouts).
pub fn lw_tuple_layout_name(ftys: Vec<IrType>) -> str {
    var name: str = "__tuple_" + int_to_str(ftys.len());
    if ftys.len() == 0 {
        return name;
    }
    name = name + "_";
    var i: i64 = 0;
    while i < ftys.len() {
        name = name + lw_tuple_field_code(ftys.get(i));
        i = i + 1;
    }
    return name;
}

/// The digits of `s` from byte `at` on, as a number, and where they end
/// (lw_tuple_name_fields): [value, end]; end == at when there are none.
fn lw_tuple_name_num(s: str, at: i64) -> Vec<i64> {
    var v: i64 = 0;
    var i: i64 = at;
    while i < str_len(s) && str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 57 {
        v = v * 10 + (str_byte_at(s, i) - 48);
        i = i + 1;
    }
    var out: Vec<i64> = Vec::new();
    out.push(v);
    out.push(i);
    return out;
}

/// The field types a tuple layout name (lw_tuple_layout_name) holds, as
/// types that lay it out the same (a pointer is a `*u8`, a word an opaque
/// word, other room a byte array); an empty list when `name` is no such
/// name (or is `__tuple_0`).
pub fn lw_tuple_name_fields(name: str) -> Vec<IrType> {
    var out: Vec<IrType> = Vec::new();
    var none: Vec<IrType> = Vec::new();
    if !str_starts_with(name, "__tuple_") {
        return none;
    }
    var nn: Vec<i64> = lw_tuple_name_num(name, 8);
    var n: i64 = nn.get(0);
    var at: i64 = nn.get(1);
    if at == 8 || n <= 0 || at >= str_len(name) || str_byte_at(name, at) != 95 {
        return none;
    }
    at = at + 1;
    while at < str_len(name) {
        var c: i64 = str_byte_at(name, at);
        at = at + 1;
        if c == 98 {
            out.push(IrType::I8);
        } else if c == 104 {
            out.push(IrType::I16);
        } else if c == 105 {
            out.push(IrType::I32);
        } else if c == 108 {
            out.push(IrType::I64);
        } else if c == 66 {
            out.push(IrType::U8);
        } else if c == 72 {
            out.push(IrType::U16);
        } else if c == 73 {
            out.push(IrType::U32);
        } else if c == 76 {
            out.push(IrType::U64);
        } else if c == 102 {
            out.push(IrType::F32);
        } else if c == 100 {
            out.push(IrType::F64);
        } else if c == 122 {
            out.push(IrType::Bool);
        } else if c == 112 {
            out.push(lw_ptr_u8());
        } else if c == 118 {
            out.push(IrType::Void);
        } else if c == 119 {
            out.push(IrType::Opaque("tuple"));
        } else if c == 115 || c == 120 {
            var ln: Vec<i64> = lw_tuple_name_num(name, at);
            if ln.get(1) == at || ln.get(1) >= str_len(name) || str_byte_at(name, ln.get(1)) != 95 {
                return none;
            }
            at = ln.get(1) + 1;
            if c == 120 {
                out.push(IrType::Array(Box::new(IrType::U8), ln.get(0)));
            } else {
                if at + ln.get(0) > str_len(name) {
                    return none;
                }
                out.push(IrType::Struct(str_slice(name, at, at + ln.get(0))));
                at = at + ln.get(0);
            }
        } else {
            return none;
        }
    }
    if out.len() != n {
        return none;
    }
    return out;
}

/// Register the layout of a tuple of IR element types (a field each,
/// lw_tuple_field_ty of its type, every field at a multiple of 8) under
/// its shape's name (lw_tuple_layout_name), and return that name.
pub fn Lowerer_register_tuple_layout(self: & mut Lowerer, elem_tys: Vec<IrType>) -> str {
    var ftys: Vec<IrType> = Vec::new();
    var i: i64 = 0;
    while i < elem_tys.len() {
        ftys.push(lw_tuple_field_ty(elem_tys.get(i)));
        i = i + 1;
    }
    var name: str = lw_tuple_layout_name(ftys);
    var layout: StructLayout = StructLayout_new(name);
    var offset: i64 = 0;
    i = 0;
    while i < ftys.len() {
        var field_ty: IrType = ftys.get(i);
        layout.fields.push(StringIrTypeOffset_new("_" + int_to_str(i), field_ty, offset));
        offset = offset + IrModule_type_size(& self.module, field_ty);
        offset = (offset + 7) / 8 * 8;
        i = i + 1;
    }
    layout.size = offset;
    layout.align = 8;
    IrModule_add_struct(& mut self.module, layout);
    return name;
}

/// Register the layout tuple name `name` (lw_tuple_layout_name) stands for
/// when the module has none, its nested tuples' first (an IR cache hit
/// replays a function without lowering its tuple literals).
fn Lowerer_register_tuple_name(self: & mut Lowerer, name: str, depth: i64) {
    if depth > 16 || !str_starts_with(name, "__tuple_") {
        return;
    }
    match IrModule_get_struct(& self.module, name) {
        OptStructLayout::Some(_) => {
            return;
        }
        OptStructLayout::None => {
        }
    }
    var ftys: Vec<IrType> = lw_tuple_name_fields(name);
    if ftys.len() == 0 {
        return;
    }
    var i: i64 = 0;
    while i < ftys.len() {
        match ftys.get(i) {
            IrType::Struct(sub) => {
                Lowerer_register_tuple_name(self, sub, depth + 1);
            }
            _ => {
            }
        }
        i = i + 1;
    }
    var _n: str = Lowerer_register_tuple_layout(self, ftys);
}

/// The tuple layout names IR type `t` holds (through pointers), registered
/// (Lowerer_register_tuple_name).
fn Lowerer_register_tuple_names_in(self: & mut Lowerer, t: IrType, depth: i64) {
    if depth > 8 {
        return;
    }
    match t {
        IrType::Struct(sn) => {
            Lowerer_register_tuple_name(self, sn, 0);
        }
        IrType::Ptr(inner) => {
            Lowerer_register_tuple_names_in(self, box_ir_type_unbox(inner), depth + 1);
        }
        _ => {
        }
    }
}

/// An IR cache hit (FID_IRCACHE): the layouts of the tuples cached function
/// `f` uses, made again from their names (its tuple literals registered
/// them when it was lowered, and they are not lowered now).
fn Lowerer_irc_tuple_layouts(self: & mut Lowerer, f: IrFunction) {
    var i: i64 = 0;
    while i < f.value_metas.len() {
        Lowerer_register_tuple_names_in(self, f.value_metas.get(i).meta.ty, 0);
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Alloca(at, _) => {
                Lowerer_register_tuple_names_in(self, at, 0);
            }
            Inst::StructCopy(_, _, ct) => {
                Lowerer_register_tuple_names_in(self, ct, 0);
            }
            _ => {
            }
        }
        i = i + 1;
    }
}

/// A function returning a tuple registers its layout, as a tuple literal
/// of its element types lays it out (Lowerer_key_tuple_ir: a nested tuple
/// and a struct inline).
pub fn Lowerer_register_ret_tuple(self: & mut Lowerer, ret: Type) {
    match Lowerer_resolve_type(self, ret) {
        Type::Tuple(types) => {
            var _rt: IrType = Lowerer_key_tuple_ir(self, types);
        }
        _ => {
        }
    }
}

pub fn Lowerer_lower_type_sret(self: & mut Lowerer, ty: Type) -> IrType {
    // Tuples are structs (their shape's layout, Lowerer_key_tuple_ir), so
    // the SRET convention returns them (Opaque("tuple") returned a
    // dangling pointer to a stack alloca).
    match Lowerer_resolve_type(self, ty) {
        Type::Tuple(types) => {
            return Lowerer_key_tuple_ir(self, types);
        }
        _ => {
        }
    }
    var ir_ty: IrType = Lowerer_lower_type(self, ty);
    match ir_ty {
        IrType::Generic(name, _args) => {
            var resolved_name: str = Lowerer_resolve_struct_name(self, name);
            match Lowerer_lookup_enum(self, resolved_name) {
                OptEnumDef::Some(_def) => {
                    return IrType::Struct(resolved_name);
                }
                OptEnumDef::None => {
                }
            }
            // A generic struct is returned through SRET too: as a plain
            // Generic its value was a pointer to the callee's stack alloca,
            // dangling once the callee returned (a C build crashed reading it)
            if resolved_name != "Vec" && resolved_name != "HashMap" && resolved_name != "Box" {
                match Lowerer_lookup_struct(self, resolved_name) {
                    OptStructDef::Some(_sd) => {
                        return IrType::Struct(resolved_name);
                    }
                    OptStructDef::None => {
                    }
                }
            }
        }
        _ => {
        }
    }
    return ir_ty;
}

pub fn Lowerer_resolve_struct_name(self: & Lowerer, name: str) -> str {
    match Lowerer_lookup_type_alias(self, name) {
        OptType::Some(alias) => {
            match alias {
                Type::Named(inner) => {
                    return Lowerer_resolve_struct_name(self, inner);
                }
                _ => {
                    return name;
                }
            }
            return name;
        }
        OptType::None => {
            return name;
        }
    }
    return name;
}

pub fn Lowerer_is_opaque_type_param(self: & Lowerer, ty: Type) -> bool {
    match ty {
        Type::Named(n) => {
            match Lowerer_lookup_enum(self, n) {
                OptEnumDef::Some(_) => {
                    return false;
                }
                OptEnumDef::None => {
                }
            }
            match IrModule_get_struct(& self.module, n) {
                OptStructLayout::Some(_) => {
                    return false;
                }
                OptStructLayout::None => {
                }
            }
            match Lowerer_lookup_type_alias(self, n) {
                OptType::Some(_) => {
                    return false;
                }
                OptType::None => {
                }
            }
            if n == "Vec" {
                return false;
            }
            if n == "HashMap" {
                return false;
            }
            if n == "Tensor" {
                return false;
            }
            if n == "Allocator" {
                return false;
            }
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

// Auto-deref helper: for &mut Vec<T> / &mut HashMap<K,V> / &mut String,
// the receiver is Ptr(Opaque("Vec")) - a pointer to the Vec pointer.
// Vec_len/Vec_get/Vec_push expect the Vec pointer directly, so we
// must Load the actual value from the reference before passing it.
// Returns the dereferenced value if needed, or the original value otherwise.
pub fn Lowerer_auto_deref_recv(self: & mut Lowerer, recv_val: i64, recv_ty: IrType) -> i64 {
    match recv_ty {
        IrType::Ptr(inner) => {
            var inner_ty: IrType = box_ir_type_unbox(inner);
            var is_collection: bool = false;
            match inner_ty {
                IrType::Opaque(oname) => {
                    if oname == "Vec" || oname == "HashMap" || oname == "String" {
                        is_collection = true;
                    }
                }
                IrType::Generic(gname, _) => {
                    if gname == "Vec" || gname == "HashMap" || gname == "String" {
                        is_collection = true;
                    }
                }
                _ => {
                }
            }
            if is_collection {
                return Lowerer_emit_inst(self, Inst::Load(recv_val, inner_ty));
            }
        }
        _ => {
        }
    }
    return recv_val;
}

pub fn word_repr(ty: IrType) -> IrType {
    match ty {
        IrType::Struct(_) => {
            return IrType::Ptr(Box::new(ty));
        }
        IrType::Array(_, _) => {
            return IrType::Ptr(Box::new(ty));
        }
        other => {
            return other;
        }
    }
    return ty;
}

pub fn ir_types_repr_compatible(a: IrType, b: IrType) -> bool {
    if ir_type_eq(a, b) {
        return true;
    }
    if ir_type_is_scalar(a) && ir_type_is_scalar(b) {
        return true;
    }
    if ir_type_is_ptr_like(a) && ir_type_is_ptr_like(b) {
        return true;
    }
    return false;
}

pub fn Lowerer_ast_type_from_name(self: & Lowerer, name: str) -> OptType {
    if name == "" {
        return OptType::None;
    }
    var ty: Type = Type::Named(name);
    if name == "i8" {
        ty = Type::I8;
    }
    if name == "i16" {
        ty = Type::I16;
    }
    if name == "i32" {
        ty = Type::I32;
    }
    if name == "i64" {
        ty = Type::I64;
    }
    if name == "i128" {
        ty = Type::I128;
    }
    if name == "u8" {
        ty = Type::U8;
    }
    if name == "u16" {
        ty = Type::U16;
    }
    if name == "u32" {
        ty = Type::U32;
    }
    if name == "u64" {
        ty = Type::U64;
    }
    if name == "u128" {
        ty = Type::U128;
    }
    if name == "f32" {
        ty = Type::F32;
    }
    if name == "f64" {
        ty = Type::F64;
    }
    if name == "bool" {
        ty = Type::Bool;
    }
    if name == "str" {
        ty = Type::Str;
    }

    if Lowerer_is_opaque_type_param(self, ty) {
        return OptType::None;
    }
    return OptType::Some(ty);
}

pub fn Lowerer_resolve_self_in_type(self: & Lowerer, ty: Type) -> Type {
    match ty {
        Type::Named(name) => {
            if name == "Self" {
                var saved_self: OptStringLower = self.current_self_type;
                match saved_self {
                    OptStringLower::Some(self_name) => {
                        return Type::Named(self_name);
                    }
                    OptStringLower::None => {
                        return Type::Named(name);
                    }
                }
                return Type::Named(name);
            }
            return Type::Named(name);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(Lowerer_resolve_self_in_type(self, lw_box_type_unbox(inner))), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(Box::new(Lowerer_resolve_self_in_type(self, lw_box_type_unbox(inner))), is_mut);
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(Lowerer_resolve_self_in_type(self, lw_box_type_unbox(elem))), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(Box::new(Lowerer_resolve_self_in_type(self, lw_box_type_unbox(elem))), size_param);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(Lowerer_resolve_self_in_type(self, args.get(i)));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(Lowerer_resolve_self_in_type(self, types.get(i)));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        other => {
            return other;
        }
    }
    return ty;
}

// --- Struct/Enum layout computation ---------------------------------------

pub fn Lowerer_compute_struct_layout(self: & mut Lowerer, def: StructDef) {
    // the layouts of the tuples its fields hold inline (Lowerer_held_ir),
    // again at each round of the layout fixpoint (a struct in a tuple may
    // have grown)
    var hi: i64 = 0;
    while hi < def.fields.len() {
        if !lw_rc_is_param(def.fields.get(hi).ty, def.type_params) {
            Lowerer_register_held_layouts(self, def.fields.get(hi).ty, def.type_params);
        }
        hi = hi + 1;
    }
    var layout: StructLayout = Lowerer_make_struct_layout(self, def);
    // CS4: in place (as Lowerer_lower_program's own add_struct). Taking
    // the module out and putting it back copied it: its layout list, the
    // one written, was copied whole for every struct.
    IrModule_add_struct(& mut self.module, layout);
}

// Build a StructLayout from a StructDef (without modifying the Lowerer)
pub fn Lowerer_make_struct_layout(self: & Lowerer, def: StructDef) -> StructLayout {
    var struct_name: str = def.name;
    var fields: Vec<StringIrTypeOffset> = Vec::new();
    var offset: i64 = 0;

    // Check for @repr(C) annotation
    var repr_c: bool = false;
    var packed_layout: bool = false;
    var ai: i64 = 0;
    while ai < def.annotations.len() {
        var ann: Annotation = def.annotations.get(ai);
        if ann.name == "repr" {
            var bi: i64 = 0;
            while bi < ann.args.len() {
                if ann.args.get(bi) == "C" {
                    repr_c = true;
                }
                bi = bi + 1;
            }
        }
        if ann.name == "packed" {
            packed_layout = true;
        }
        ai = ai + 1;
    }

    var max_align: i64 = 8;
    if repr_c {
        max_align = 1;
    }
    if packed_layout {
        max_align = 1;
    }

    var i: i64 = 0;
    while i < def.fields.len() {
        var field: Param = def.fields.get(i);
        // A tuple field and a generic struct instance field are held inline
        // (Lowerer_held_ir), as their values and their drops (__own_drop_)
        // keep them: as one word the field held the address of a value on
        // the stack, and the drop read that word as the value
        var ir_ty: IrType = Lowerer_held_ir(self, field.ty, def.type_params);
        // A field typed by one of the struct's type parameters is one word
        // (as a generic enum's payload): `first: A` lowered as a struct
        // named A, and a literal stored nothing in it (2f.11)
        match field.ty {
            Type::Named(tpn) => {
                if lw_c_str_vec_contains(def.type_params, tpn) {
                    ir_ty = IrType::I64;
                }
            }
            _ => {
            }
        }
        // A type parameter inside a field's type (`vals: Vec<V>`) is a word
        // too: Vec<V> lowered as a Vec of inline structs named V, so a push
        // boxed the value and a get read the box's address
        // (stdlib-agent-bugs 17). Only where the field keeps its size.
        if def.type_params.len() > 0 {
            var tp_words: Vec<Type> = Vec::new();
            var twi: i64 = 0;
            while twi < def.type_params.len() {
                tp_words.push(Type::I64);
                twi = twi + 1;
            }
            var ir_sub: IrType = Lowerer_lower_type(self, lw_rc_subst(field.ty, def.type_params, tp_words));
            if IrModule_type_size(& self.module, ir_sub) == IrModule_type_size(& self.module, ir_ty) {
                ir_ty = ir_sub;
            }
        }

        if repr_c || packed_layout {
            // C-compatible or packed layout: use natural type sizes and alignment
            var field_size: i64 = 8;
            var field_align: i64 = 8;
            match ir_ty {
                IrType::I8 => {
                    field_size = 1;
                    field_align = 1;
                }
                IrType::U8 => {
                    field_size = 1;
                    field_align = 1;
                }
                IrType::Bool => {
                    field_size = 1;
                    field_align = 1;
                }
                IrType::I16 => {
                    field_size = 2;
                    field_align = 2;
                }
                IrType::U16 => {
                    field_size = 2;
                    field_align = 2;
                }
                IrType::I32 => {
                    field_size = 4;
                    field_align = 4;
                }
                IrType::U32 => {
                    field_size = 4;
                    field_align = 4;
                }
                IrType::F32 => {
                    field_size = 4;
                    field_align = 4;
                }
                IrType::I64 => {
                    field_size = 8;
                    field_align = 8;
                }
                IrType::U64 => {
                    field_size = 8;
                    field_align = 8;
                }
                IrType::F64 => {
                    field_size = 8;
                    field_align = 8;
                }
                IrType::Ptr(_) => {
                    field_size = 8;
                    field_align = 8;
                }
                IrType::Struct(name) => {
                    match IrModule_get_struct(& self.module, name) {
                        OptStructLayout::Some(layout) => {
                            field_size = layout.size;
                            field_align = layout.align;
                        }
                        OptStructLayout::None => {
                            field_size = 8;
                            field_align = 8;
                        }
                    }
                }
                _ => {
                    field_size = 8;
                    field_align = 8;
                }
            }
            if packed_layout {
                // Packed: no alignment padding between fields
                field_align = 1;
            }
            // Align offset to field's natural alignment
            offset = (offset + field_align - 1) & (0 - field_align);
            fields.push(StringIrTypeOffset_new(field.name, ir_ty, offset));
            offset = offset + field_size;
            if field_align > max_align {
                max_align = field_align;
            }
        } else {
            // Default Fides layout: uniform 8-byte slots
            var field_size: i64 = 8;
            match ir_ty {
                IrType::Struct(name) => {
                    match IrModule_get_struct(& self.module, name) {
                        OptStructLayout::Some(layout) => {
                            field_size = layout.size;
                        }
                        OptStructLayout::None => {
                            field_size = 8;
                        }
                    }
                }
                _ => {
                    field_size = 8;
                }
            }
            fields.push(StringIrTypeOffset_new(field.name, ir_ty, offset));
            offset = offset + field_size;
        }
        i = i + 1;
    }

    // Align struct size to its alignment
    var size: i64 = (offset + max_align - 1) & (0 - max_align);

    var layout: StructLayout = StructLayout_new(struct_name);
    layout.size = size;
    if repr_c {
        layout.align = max_align;
    } else {
        layout.align = 8;
    }
    layout.fields = fields;
    layout.repr_c = repr_c;
    layout.packed_layout = packed_layout;
    return layout;
}

pub fn Lowerer_compute_enum_layout(self: & mut Lowerer, def: EnumDef) {
    // the layouts of the tuples its payloads hold inline (Lowerer_held_ir)
    var hv: i64 = 0;
    while hv < def.variants.len() {
        match def.variants.get(hv).data {
            OptParams::Some(hps) => {
                var hp: i64 = 0;
                while hp < hps.len() {
                    if !lw_rc_is_param(hps.get(hp).ty, def.type_params) {
                        Lowerer_register_held_layouts(self, hps.get(hp).ty, def.type_params);
                    }
                    hp = hp + 1;
                }
            }
            OptParams::None => {
            }
        }
        hv = hv + 1;
    }
    var layout: StructLayout = Lowerer_make_enum_layout(self, def);
    // CS4: in place, as Lowerer_compute_struct_layout
    IrModule_add_struct(& mut self.module, layout);
}

pub fn Lowerer_make_enum_layout(self: & Lowerer, def: EnumDef) -> StructLayout {
    // Compute the max payload size across all variants.
    // Each field in a variant gets at least 8 bytes, but struct/enum-typed
    // fields need their full size (looked up from the module's struct layouts).
    var max_payload_size: i64 = 0;
    var i: i64 = 0;
    while i < def.variants.len() {
        var variant: EnumVariant = def.variants.get(i);
        match variant.data {
            OptParams::Some(data) => {
                var variant_size: i64 = 0;
                var fi: i64 = 0;
                while fi < data.len() {
                    // a tuple or a generic struct instance inline
                    // (Lowerer_held_ir)
                    var ir_ty: IrType = Lowerer_lower_type(self, data.get(fi).ty);
                    if !lw_rc_is_param(data.get(fi).ty, def.type_params) {
                        ir_ty = Lowerer_held_ir(self, data.get(fi).ty, def.type_params);
                    }
                    var field_size: i64 = 8;
                    match ir_ty {
                        IrType::Struct(sname) => {
                            match IrModule_get_struct(& self.module, sname) {
                                OptStructLayout::Some(layout) => {
                                    field_size = layout.size;
                                }
                                OptStructLayout::None => {
                                    field_size = 8;
                                }
                            }
                        }
                        _ => {
                            field_size = 8;
                        }
                    }
                    variant_size = variant_size + field_size;
                    fi = fi + 1;
                }
                if variant_size > max_payload_size {
                    max_payload_size = variant_size;
                }
            }
            OptParams::None => {
            }
        }
        i = i + 1;
    }

    // Round up to a multiple of 8 and count how many 8-byte slots we need.
    var payload_slots: i64 = (max_payload_size + 7) / 8;

    var fields: Vec<StringIrTypeOffset> = Vec::new();
    fields.push(StringIrTypeOffset_new("__tag", IrType::I64, 0));
    var j: i64 = 0;
    while j < payload_slots {
        fields.push(StringIrTypeOffset_new("__data" + int_to_str(j), IrType::I64, (j + 1) * 8));
        j = j + 1;
    }

    var size: i64 = (1 + payload_slots) * 8;
    var layout: StructLayout = StructLayout_new(def.name);
    layout.size = size;
    layout.align = 8;
    layout.fields = fields;
    return layout;
}

// --- Register runtime functions -------------------------------------------

pub fn Lowerer_register_runtime(self: & mut Lowerer) {
    // Print/panic
    Lowerer_add_extern_1(self, "p_print_int", IrType::I64, IrType::Void);
    Lowerer_add_extern_1(self, "p_print_str", lw_ptr_u8(), IrType::Void);
    Lowerer_add_extern_1(self, "p_eprint_str", lw_ptr_u8(), IrType::Void);
    Lowerer_add_extern_1(self, "p_print_bool", IrType::Bool, IrType::Void);
    Lowerer_add_extern_1(self, "p_print_float", IrType::F64, IrType::Void);
    Lowerer_add_extern_0(self, "p_print_newline", IrType::Void);
    Lowerer_add_extern_1(self, "p_panic", lw_ptr_u8(), IrType::Void);

    // Alloc/free
    Lowerer_add_extern_1(self, "p_alloc", IrType::I64, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_malloc", IrType::I64, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_free", lw_ptr_u8(), IrType::Void);
    // Arena marks: save returns a mark, restore frees what came after it.
    Lowerer_add_extern_0(self, "p_arena_save", IrType::I64);
    Lowerer_add_extern_1(self, "p_arena_restore", IrType::I64, IrType::Void);

    // String conversions
    Lowerer_add_extern_2(self, "p_str_concat", lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_str_join_n", lw_ptr_u8(), lw_ptr_u8());
    // Mutable string builder (avoids O(n^2) memory from string concat)
    Lowerer_add_extern_0(self, "p_sb_new", IrType::I64);
    Lowerer_add_extern_2(self, "p_sb_append", IrType::I64, lw_ptr_u8(), IrType::Void);
    Lowerer_add_extern_1(self, "p_sb_to_str", IrType::I64, lw_ptr_u8());
    // (sb_ptr) -> str
    Lowerer_add_extern_1(self, "p_to_str", IrType::I64, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_char_to_str", IrType::I64, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_float_to_str", IrType::F64, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_str_to_float", lw_ptr_u8(), IrType::F64);
    Lowerer_add_extern_1(self, "p_bool_to_str", IrType::Bool, lw_ptr_u8());
    // B5: Float bit-pattern conversion for ConstFloat codegen
    Lowerer_add_extern_1(self, "p_f64_to_bits", IrType::F64, IrType::I64);
    Lowerer_add_extern_1(self, "p_f64_from_bits", IrType::I64, IrType::F64);
    Lowerer_add_extern_1(self, "p_f32_to_bits", IrType::F32, IrType::I64);

    // String operations
    Lowerer_add_extern_2(self, "p_string_contains", lw_ptr_u8(), lw_ptr_u8(), IrType::Bool);
    Lowerer_add_extern_3(self, "p_string_replace", lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_2(self, "p_string_starts_with", lw_ptr_u8(), lw_ptr_u8(), IrType::Bool);
    Lowerer_add_extern_2(self, "p_string_ends_with", lw_ptr_u8(), lw_ptr_u8(), IrType::Bool);
    Lowerer_add_extern_2(self, "p_string_find", lw_ptr_u8(), lw_ptr_u8(), IrType::I64);
    Lowerer_add_extern_1(self, "p_string_len", lw_ptr_u8(), IrType::I64);
    Lowerer_add_extern_2(self, "p_string_copy", lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_2(self, "p_str_copy", lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8());
    // p_str_free is core's own function (length-headed strings): declared
    // extern, the interpreter took it for a C function and every string
    // drop panicked
    Lowerer_add_extern_2(self, "p_string_split", lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_string_trim", lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_string_to_uppercase", lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_string_to_lowercase", lw_ptr_u8(), lw_ptr_u8());

    // JSON
    var json_ty: IrType = opaque_ty("Json");
    Lowerer_add_extern_1(self, "p_json_parse", lw_ptr_u8(), json_ty);
    Lowerer_add_extern_1(self, "p_json_dump", json_ty, lw_ptr_u8());
    Lowerer_add_extern_2(self, "p_json_get", json_ty, lw_ptr_u8(), json_ty);
    Lowerer_add_extern_1(self, "p_json_type", json_ty, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_json_len", json_ty, IrType::I64);
    Lowerer_add_extern_2(self, "p_json_at", json_ty, IrType::I64, json_ty);
    Lowerer_add_extern_1(self, "p_json_pretty", json_ty, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_json_string", json_ty, lw_ptr_u8());

    // Tensor
    var tensor_ty: IrType = opaque_ty("Tensor");
    var vec_i64_ty: IrType = opaque_ty("Vec");
    Lowerer_add_extern_1(self, "p_tensor_zeros", vec_i64_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_tensor_ones", vec_i64_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_filled", vec_i64_ty, IrType::F64, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_from_vec", vec_i64_ty, vec_i64_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_get", tensor_ty, vec_i64_ty, IrType::F64);
    Lowerer_add_extern_3(self, "p_tensor_set", tensor_ty, vec_i64_ty, IrType::F64, IrType::Void);
    Lowerer_add_extern_1(self, "p_tensor_shape", tensor_ty, vec_i64_ty);
    Lowerer_add_extern_1(self, "p_tensor_ndim", tensor_ty, IrType::I64);
    Lowerer_add_extern_1(self, "p_tensor_size", tensor_ty, IrType::I64);
    Lowerer_add_extern_2(self, "p_tensor_reshape", tensor_ty, vec_i64_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_tensor_transpose", tensor_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_add", tensor_ty, tensor_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_sub", tensor_ty, tensor_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_mul", tensor_ty, tensor_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_scale", tensor_ty, IrType::F64, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_matmul", tensor_ty, tensor_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_dot", tensor_ty, tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_sum", tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_mean", tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_max", tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_min", tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_relu", tensor_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_tensor_sigmoid", tensor_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_tensor_softmax", tensor_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_tensor_to_str", tensor_ty, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_tensor_to_json", tensor_ty, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_tensor_clone", tensor_ty, tensor_ty);

    // Autograd
    Lowerer_add_extern_1(self, "p_grad_get", tensor_ty, tensor_ty);
    Lowerer_add_extern_0(self, "p_grad_zero", IrType::Void);
    Lowerer_add_extern_0(self, "p_autograd_begin", IrType::Void);
    Lowerer_add_extern_0(self, "p_autograd_end", IrType::Void);
    Lowerer_add_extern_1(self, "p_autograd_backward", tensor_ty, IrType::Void);
    Lowerer_add_extern_0(self, "p_checkpoint_begin", IrType::Void);
    Lowerer_add_extern_0(self, "p_checkpoint_end", IrType::Void);

    // KV Cache
    Lowerer_add_extern_4(self, "p_kv_cache_new", IrType::I64, IrType::I64, IrType::I64, IrType::I64, IrType::I64);
    Lowerer_add_extern_4(self, "p_kv_cache_append", IrType::I64, IrType::I64, tensor_ty, tensor_ty, IrType::Void);
    Lowerer_add_extern_2(self, "p_kv_cache_get", IrType::I64, IrType::I64, tensor_ty);
    Lowerer_add_extern_2(self, "p_kv_cache_len", IrType::I64, IrType::I64, IrType::I64);
    Lowerer_add_extern_1(self, "p_kv_cache_clear", IrType::I64, IrType::Void);
    Lowerer_add_extern_2(self, "p_kv_cache_evict", IrType::I64, IrType::I64, IrType::Void);

    // Quantization
    Lowerer_add_extern_3(self, "p_quantize_q8", tensor_ty, IrType::F64, IrType::I64, tensor_ty);
    Lowerer_add_extern_3(self, "p_dequantize_q8", tensor_ty, IrType::F64, IrType::I64, tensor_ty);
    Lowerer_add_extern_2(self, "p_qmatmul", tensor_ty, tensor_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_find_quant_params", tensor_ty, lw_ptr_u8());

    // DP noise
    Lowerer_add_extern_2(self, "p_dp_noise", tensor_ty, IrType::F64, tensor_ty);
    Lowerer_add_extern_2(self, "p_gaussian_noise", vec_i64_ty, IrType::F64, tensor_ty);
    Lowerer_add_extern_2(self, "p_dropout", tensor_ty, IrType::F64, tensor_ty);

    // Tensor parallelism
    // roadmap P6: start n ranks (one process each), give this one's rank
    Lowerer_add_extern_1(self, "p_tp_init", IrType::I64, IrType::I64);
    Lowerer_add_extern_1(self, "p_all_reduce", tensor_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_broadcast", tensor_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_all_gather", tensor_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_scatter", tensor_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_send_tensor", tensor_ty, IrType::Void);
    Lowerer_add_extern_1(self, "p_recv_tensor", vec_i64_ty, tensor_ty);

    // SIMD
    var simd_ty: IrType = opaque_ty("Vec");
    Lowerer_add_extern_2(self, "p_simd_add", simd_ty, simd_ty, simd_ty);
    Lowerer_add_extern_2(self, "p_simd_sub", simd_ty, simd_ty, simd_ty);
    Lowerer_add_extern_2(self, "p_simd_mul", simd_ty, simd_ty, simd_ty);
    Lowerer_add_extern_2(self, "p_simd_div", simd_ty, simd_ty, simd_ty);
    Lowerer_add_extern_2(self, "p_simd_dot", simd_ty, simd_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_simd_sum", simd_ty, IrType::F64);
    Lowerer_add_extern_2(self, "p_simd_scale", simd_ty, IrType::F64, simd_ty);
    Lowerer_add_extern_1(self, "p_simd_from_vec", vec_i64_ty, simd_ty);
    Lowerer_add_extern_1(self, "p_simd_to_str", simd_ty, lw_ptr_u8());

    // HTTP/Socket
    Lowerer_add_extern_1(self, "p_socket_listen", IrType::I64, IrType::I64);
    Lowerer_add_extern_1(self, "p_socket_accept", IrType::I64, IrType::I64);
    Lowerer_add_extern_2(self, "p_socket_read", IrType::I64, vec_i64_ty, IrType::I64);
    Lowerer_add_extern_2(self, "p_socket_write", IrType::I64, vec_i64_ty, IrType::I64);
    Lowerer_add_extern_1(self, "p_socket_close", IrType::I64, IrType::Void);
    Lowerer_add_extern_1(self, "p_socket_recv_str", IrType::I64, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_http_parse_request", lw_ptr_u8(), opaque_ty("HttpRequest"));
    Lowerer_add_extern_3(self, "p_http_build_response", IrType::I64, lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8());

    // stdin / stdout
    Lowerer_add_extern_0(self, "p_flush_stdout", IrType::Void);
    Lowerer_add_extern_0(self, "p_stdin_eof", IrType::I64);
    Lowerer_add_extern_0(self, "p_read_line", lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_read_stdin", IrType::I64, lw_ptr_u8());

    // File I/O
    Lowerer_add_extern_1(self, "p_file_read", lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_2(self, "p_file_write", lw_ptr_u8(), lw_ptr_u8(), IrType::I64);
