            // type (src/lower.rs).
            if variant == "i8" || variant == "i16" || variant == "i32" || variant == "i64" || variant == "i128" || variant == "u8" || variant == "u16" || variant == "u32" || variant == "u64" || variant == "u128" || variant == "f32" || variant == "f64" || variant == "bool" || variant == "str" || variant == "void" {
