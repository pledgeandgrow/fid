    Lowerer_add_extern_2(self, "p_tensor_scale", tensor_ty, IrType::F64, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_matmul", tensor_ty, tensor_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_dot", tensor_ty, tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_sum", tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_mean", tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_max", tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_min", tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_relu", tensor_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_tensor_sigmoid", tensor_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_tensor_softmax", tensor_ty, tensor_ty);
