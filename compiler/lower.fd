            // that type, otherwise left as it was
            var is_type_name: bool = Lowerer_is_struct(self, variant);
            match Lowerer_lookup_enum(self, variant) {
                OptEnumDef::Some(_) => {
                    is_type_name = true;
                }
                OptEnumDef::None => {
                }
            }
