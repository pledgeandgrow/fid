    Lowerer_add_extern_1(self, "p_task_poll_nonblocking", IrType::I64, IrType::I64);

    // Non-blocking IO
    Lowerer_add_extern_2(self, "p_net_connect", lw_ptr_u8(), IrType::I64, IrType::I64);
    Lowerer_add_extern_3(self, "p_net_read", IrType::I64, lw_ptr_u8(), IrType::I64, IrType::I64);
