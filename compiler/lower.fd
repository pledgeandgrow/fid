// ─── Emit helpers ─────────────────────────────────────────────────────────

pub fn Lowerer_emit_inst(self: &mut Lowerer, inst: Inst) -> i64 {
    return IrFunction_emit(&mut self.current_func, inst);
}

pub fn Lowerer_new_value(self: &mut Lowerer, meta: ValueMeta) -> i64 {
    return IrFunction_new_value(&mut self.current_func, meta);
}

pub fn Lowerer_new_block(self: &mut Lowerer) -> i64 {
    var bb: i64 = IrFunction_new_block(&mut self.current_func);
    return bb;
}

pub fn Lowerer_set_current_block(self: &mut Lowerer, block: i64) {
    self.current_block = block;
}

pub fn Lowerer_current_block_has_terminator(self: &Lowerer) -> bool {
    if !self.has_current_func { return false; }
    if self.current_block < 0 { return false; }
    if self.current_block >= self.current_func.blocks.len() { return false; }
    var blk: BasicBlock = self.current_func.blocks.get(self.current_block);
    if blk.instructions.len() == 0 { return false; }
    var last_id: i64 = blk.instructions.get(blk.instructions.len() - 1);
    match IrFunction_get_inst(&self.current_func, last_id) {
        OptInst::Some(inst) => { return inst_is_terminator(inst); }
        OptInst::None => { return false; }
    }
    return false;
}

pub fn Lowerer_set_value_type(self: &mut Lowerer, id: i64, ty: IrType) {
    match IrFunction_get_meta(&self.current_func, id) {
        OptValueMeta::Some(meta) => {
            IrFunction_set_meta(&mut self.current_func, id, ValueMeta_with_type(meta, ty));
        }
        OptValueMeta::None => {}
    }
}

pub fn Lowerer_get_value_type(self: &Lowerer, val: i64) -> IrType {
    match IrFunction_get_meta(&self.current_func, val) {
        OptValueMeta::Some(meta) => { return meta.ty; }
        OptValueMeta::None => { return IrType::I64; }
    }
    return IrType::I64;
}

pub fn Lowerer_emit_terminator(self: &mut Lowerer, inst: Inst) {
    var _v: i64 = Lowerer_emit_inst(self, inst);
}

pub fn Lowerer_bind_local(self: &mut Lowerer, name: str, val: i64) {
    IrFunction_bind_local(&mut self.current_func, name, val);
}

pub fn Lowerer_lookup_local(self: &Lowerer, name: str) -> OptValueId {
    return IrFunction_lookup_local(&self.current_func, name);
}

pub fn Lowerer_add_block_param(self: &mut Lowerer, block: i64, ty: IrType) -> i64 {
    return IrFunction_add_block_param(&mut self.current_func, block, ty);
}

// ─── Extern registration helpers ──────────────────────────────────────────
// These avoid creating temporary Vec<IrType> for each add_extern call.

pub fn Lowerer_add_extern_0(self: &mut Lowerer, name: str, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    IrModule_add_extern(&mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_1(self: &mut Lowerer, name: str, p1: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    IrModule_add_extern(&mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_2(self: &mut Lowerer, name: str, p1: IrType, p2: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    params.push(p2);
    IrModule_add_extern(&mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_3(self: &mut Lowerer, name: str, p1: IrType, p2: IrType, p3: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    params.push(p2);
    params.push(p3);
    IrModule_add_extern(&mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_4(self: &mut Lowerer, name: str, p1: IrType, p2: IrType, p3: IrType, p4: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    params.push(p2);
    params.push(p3);
    params.push(p4);
    IrModule_add_extern(&mut self.module, name, params, ret);
}

// Common type aliases
pub fn ptr_u8() -> IrType { return IrType::Ptr(Box::new(IrType::U8)); }
pub fn opaque_ty(name: str) -> IrType { return IrType::Opaque(name); }

// ─── Type resolution ──────────────────────────────────────────────────────

pub fn Lowerer_resolve_type(self: &Lowerer, ty: Type) -> Type {
    match ty {
        Type::Named(name) => {
            match Lowerer_lookup_type_alias(self, name) {
                OptType::Some(alias) => { return Lowerer_resolve_type(self, alias); }
                OptType::None => { return Type::Named(name); }
            }
            return Type::Named(name);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(Lowerer_resolve_type(self, box_type_unbox(inner))), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(Box::new(Lowerer_resolve_type(self, box_type_unbox(inner))), is_mut);
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(Lowerer_resolve_type(self, box_type_unbox(elem))), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(Box::new(Lowerer_resolve_type(self, box_type_unbox(elem))), size_param);
        }
        other => { return other; }
    }
    return ty;
}

pub fn Lowerer_lower_type(self: &Lowerer, ty: Type) -> IrType {
    var resolved: Type = Lowerer_resolve_type(self, ty);
    return lower_type(resolved);
}

pub fn Lowerer_resolve_struct_name(self: &Lowerer, name: str) -> str {
    match Lowerer_lookup_type_alias(self, name) {
        OptType::Some(alias) => {
            match alias {
                Type::Named(inner) => { return Lowerer_resolve_struct_name(self, inner); }
                _ => { return name; }
            }
            return name;
        }
        OptType::None => { return name; }
    }
    return name;
}

pub fn Lowerer_is_opaque_type_param(self: &Lowerer, ty: Type) -> bool {
    match ty {
        Type::Named(n) => {
            match Lowerer_lookup_enum(self, n) {
                OptEnumDef::Some(_) => { return false; }
                OptEnumDef::None => {}
            }
            match IrModule_get_struct(&self.module, n) {
                OptStructLayout::Some(_) => { return false; }
                OptStructLayout::None => {}
            }
            match Lowerer_lookup_type_alias(self, n) {
                OptType::Some(_) => { return false; }
                OptType::None => {}
            }
            if n == "Vec" { return false; }
            if n == "HashMap" { return false; }
            if n == "Tensor" { return false; }
            if n == "Allocator" { return false; }
            return true;
        }
        _ => { return false; }
    }
    return false;
}

pub fn word_repr(ty: IrType) -> IrType {
    match ty {
        IrType::Struct(_) => { return IrType::Ptr(Box::new(ty)); }
        IrType::Array(_, _) => { return IrType::Ptr(Box::new(ty)); }
        other => { return other; }
    }
    return ty;
}

pub fn ir_types_repr_compatible(a: IrType, b: IrType) -> bool {
    if ir_type_eq(a, b) { return true; }
    if ir_type_is_scalar(a) && ir_type_is_scalar(b) { return true; }
    if ir_type_is_ptr_like(a) && ir_type_is_ptr_like(b) { return true; }
    return false;
}

pub fn Lowerer_ast_type_from_name(self: &Lowerer, name: str) -> OptType {
    if name == "" { return OptType::None; }
    var ty: Type = Type::Named(name);
    if name == "i8" { ty = Type::I8; }
    if name == "i16" { ty = Type::I16; }
    if name == "i32" { ty = Type::I32; }
    if name == "i64" { ty = Type::I64; }
    if name == "i128" { ty = Type::I128; }
    if name == "u8" { ty = Type::U8; }
    if name == "u16" { ty = Type::U16; }
    if name == "u32" { ty = Type::U32; }
    if name == "u64" { ty = Type::U64; }
    if name == "u128" { ty = Type::U128; }
    if name == "f32" { ty = Type::F32; }
    if name == "f64" { ty = Type::F64; }
    if name == "bool" { ty = Type::Bool; }
    if name == "str" { ty = Type::Str; }

    if Lowerer_is_opaque_type_param(self, ty) { return OptType::None; }
    return OptType::Some(ty);
}

pub fn Lowerer_resolve_self_in_type(self: &Lowerer, ty: Type) -> Type {
    match ty {
        Type::Named(name) => {
            if name == "Self" {
                var saved_self: OptStringLower = self.current_self_type;
                match saved_self {
                    OptStringLower::Some(self_name) => { return Type::Named(self_name); }
                    OptStringLower::None => { return Type::Named(name); }
                }
                return Type::Named(name);
            }
            return Type::Named(name);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(Lowerer_resolve_self_in_type(self, box_type_unbox(inner))), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(Box::new(Lowerer_resolve_self_in_type(self, box_type_unbox(inner))), is_mut);
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(Lowerer_resolve_self_in_type(self, box_type_unbox(elem))), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(Box::new(Lowerer_resolve_self_in_type(self, box_type_unbox(elem))), size_param);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(Lowerer_resolve_self_in_type(self, args.get(i)));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(Lowerer_resolve_self_in_type(self, types.get(i)));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        other => { return other; }
    }
    return ty;
}

// ─── Struct/Enum layout computation ───────────────────────────────────────

pub fn Lowerer_compute_struct_layout(self: &mut Lowerer, def: StructDef) {
    var layout: StructLayout = Lowerer_make_struct_layout(self, def);
    // Workaround: extract module, modify, put back (nested borrow issue)
    var mod: IrModule = self.module;
    IrModule_add_struct(&mut mod, layout);
    self.module = mod;
}

// Build a StructLayout from a StructDef (without modifying the Lowerer)
pub fn Lowerer_make_struct_layout(self: &Lowerer, def: StructDef) -> StructLayout {
    var struct_name: str = def.name;
    var fields: Vec<StringIrTypeOffset> = Vec::new();
    var offset: i64 = 0;

    var i: i64 = 0;
    while i < def.fields.len() {
        var field: Param = def.fields.get(i);
        var ir_ty: IrType = Lowerer_lower_type(self, field.ty);
        var field_size: i64 = 8;
        match ir_ty {
            IrType::Struct(name) => {
                match IrModule_get_struct(&self.module, name) {
                    OptStructLayout::Some(layout) => { field_size = layout.size; }
                    OptStructLayout::None => { field_size = 8; }
                }
            }
            _ => { field_size = 8; }
        }
        fields.push(StringIrTypeOffset_new(field.name, ir_ty, offset));
        offset = offset + field_size;
        i = i + 1;
    }

    var size: i64 = (offset + 7) & (0 - 8);

    var layout: StructLayout = StructLayout_new(struct_name);
    layout.size = size;
    layout.align = 8;
    layout.fields = fields;
    return layout;
}

pub fn Lowerer_compute_enum_layout(self: &mut Lowerer, def: EnumDef) {
    var layout: StructLayout = Lowerer_make_enum_layout(self, def);
    var mod: IrModule = self.module;
    IrModule_add_struct(&mut mod, layout);
    self.module = mod;
}

pub fn Lowerer_make_enum_layout(self: &Lowerer, def: EnumDef) -> StructLayout {
    var max_fields: i64 = 0;
    var i: i64 = 0;
    while i < def.variants.len() {
        var variant: EnumVariant = def.variants.get(i);
        match variant.data {
            OptParams::Some(data) => {
                if data.len() > max_fields { max_fields = data.len(); }
            }
            OptParams::None => {}
        }
        i = i + 1;
    }

    var fields: Vec<StringIrTypeOffset> = Vec::new();
    fields.push(StringIrTypeOffset_new("__tag", IrType::I64, 0));
    var j: i64 = 0;
    while j < max_fields {
        fields.push(StringIrTypeOffset_new("__data" + int_to_str(j), IrType::I64, (j + 1) * 8));
        j = j + 1;
    }

    var size: i64 = (1 + max_fields) * 8;
    var layout: StructLayout = StructLayout_new(def.name);
    layout.size = size;
    layout.align = 8;
    layout.fields = fields;
    return layout;
}

// ─── Register runtime functions ───────────────────────────────────────────

pub fn Lowerer_register_runtime(self: &mut Lowerer) {
    // Print/panic
    Lowerer_add_extern_1(self, "p_print_int", IrType::I64, IrType::Void);
    Lowerer_add_extern_1(self, "p_print_str", ptr_u8(), IrType::Void);
    Lowerer_add_extern_1(self, "p_print_bool", IrType::Bool, IrType::Void);
    Lowerer_add_extern_1(self, "p_print_float", IrType::F64, IrType::Void);
    Lowerer_add_extern_0(self, "p_print_newline", IrType::Void);
    Lowerer_add_extern_1(self, "p_panic", ptr_u8(), IrType::Void);

    // Alloc/free
    Lowerer_add_extern_1(self, "p_alloc", IrType::I64, ptr_u8());
    Lowerer_add_extern_1(self, "p_malloc", IrType::I64, ptr_u8());
    Lowerer_add_extern_1(self, "p_free", ptr_u8(), IrType::Void);

    // String conversions
    Lowerer_add_extern_2(self, "p_str_concat", ptr_u8(), ptr_u8(), ptr_u8());
    Lowerer_add_extern_1(self, "p_to_str", IrType::I64, ptr_u8());
    Lowerer_add_extern_1(self, "p_char_to_str", IrType::I64, ptr_u8());
    Lowerer_add_extern_1(self, "p_float_to_str", IrType::F64, ptr_u8());
    Lowerer_add_extern_1(self, "p_str_to_float", ptr_u8(), IrType::F64);
    Lowerer_add_extern_1(self, "p_bool_to_str", IrType::Bool, ptr_u8());

    // String operations
    Lowerer_add_extern_2(self, "p_string_contains", ptr_u8(), ptr_u8(), IrType::Bool);
    Lowerer_add_extern_3(self, "p_string_replace", ptr_u8(), ptr_u8(), ptr_u8(), ptr_u8());
    Lowerer_add_extern_2(self, "p_string_starts_with", ptr_u8(), ptr_u8(), IrType::Bool);
    Lowerer_add_extern_2(self, "p_string_ends_with", ptr_u8(), ptr_u8(), IrType::Bool);
    Lowerer_add_extern_2(self, "p_string_find", ptr_u8(), ptr_u8(), IrType::I64);
    Lowerer_add_extern_1(self, "p_string_len", ptr_u8(), IrType::I64);
    Lowerer_add_extern_2(self, "p_string_copy", ptr_u8(), ptr_u8(), ptr_u8());
    Lowerer_add_extern_2(self, "p_str_copy", ptr_u8(), ptr_u8(), ptr_u8());
    Lowerer_add_extern_1(self, "p_str_free", ptr_u8(), IrType::Void);
    Lowerer_add_extern_2(self, "p_string_split", ptr_u8(), ptr_u8(), ptr_u8());
    Lowerer_add_extern_1(self, "p_string_trim", ptr_u8(), ptr_u8());
    Lowerer_add_extern_1(self, "p_string_to_uppercase", ptr_u8(), ptr_u8());
    Lowerer_add_extern_1(self, "p_string_to_lowercase", ptr_u8(), ptr_u8());

    // JSON
    var json_ty: IrType = opaque_ty("Json");
    Lowerer_add_extern_1(self, "p_json_parse", ptr_u8(), json_ty);
    Lowerer_add_extern_1(self, "p_json_dump", json_ty, ptr_u8());
    Lowerer_add_extern_2(self, "p_json_get", json_ty, ptr_u8(), json_ty);
    Lowerer_add_extern_1(self, "p_json_type", json_ty, ptr_u8());
    Lowerer_add_extern_1(self, "p_json_len", json_ty, IrType::I64);
    Lowerer_add_extern_2(self, "p_json_at", json_ty, IrType::I64, json_ty);
    Lowerer_add_extern_1(self, "p_json_pretty", json_ty, ptr_u8());
    Lowerer_add_extern_1(self, "p_json_string", json_ty, ptr_u8());

    // Tensor
    var tensor_ty: IrType = opaque_ty("Tensor");
    var vec_i64_ty: IrType = opaque_ty("Vec");
    Lowerer_add_extern_1(self, "p_tensor_zeros", vec_i64_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_tensor_ones", vec_i64_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_filled", vec_i64_ty, IrType::F64, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_from_vec", vec_i64_ty, vec_i64_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_get", tensor_ty, vec_i64_ty, IrType::F64);
    Lowerer_add_extern_3(self, "p_tensor_set", tensor_ty, vec_i64_ty, IrType::F64, IrType::Void);
    Lowerer_add_extern_1(self, "p_tensor_shape", tensor_ty, vec_i64_ty);
    Lowerer_add_extern_1(self, "p_tensor_ndim", tensor_ty, IrType::I64);
    Lowerer_add_extern_1(self, "p_tensor_size", tensor_ty, IrType::I64);
    Lowerer_add_extern_2(self, "p_tensor_reshape", tensor_ty, vec_i64_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_tensor_transpose", tensor_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_add", tensor_ty, tensor_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_sub", tensor_ty, tensor_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_mul", tensor_ty, tensor_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_scale", tensor_ty, IrType::F64, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_matmul", tensor_ty, tensor_ty, tensor_ty);
    Lowerer_add_extern_2(self, "p_tensor_dot", tensor_ty, tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_sum", tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_mean", tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_max", tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_min", tensor_ty, IrType::F64);
    Lowerer_add_extern_1(self, "p_tensor_relu", tensor_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_tensor_sigmoid", tensor_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_tensor_softmax", tensor_ty, tensor_ty);
    Lowerer_add_extern_1(self, "p_tensor_to_str", tensor_ty, ptr_u8());
    Lowerer_add_extern_1(self, "p_tensor_to_json", tensor_ty, ptr_u8());
    Lowerer_add_extern_1(self, "p_tensor_clone", tensor_ty, tensor_ty);

    // Autograd
    Lowerer_add_extern_1(self, "p_grad_get", tensor_ty, tensor_ty);
    Lowerer_add_extern_0(self, "p_grad_zero", IrType::Void);
    Lowerer_add_extern_0(self, "p_autograd_begin", IrType::Void);
    Lowerer_add_extern_0(self, "p_autograd_end", IrType::Void);
    Lowerer_add_extern_1(self, "p_autograd_backward", tensor_ty, IrType::Void);
    Lowerer_add_extern_0(self, "p_checkpoint_begin", IrType::Void);
    Lowerer_add_extern_0(self, "p_checkpoint_end", IrType::Void);

    // KV Cache
    Lowerer_add_extern_4(self, "p_kv_cache_new", IrType::I64, IrType::I64, IrType::I64, IrType::I64, IrType::I64);
    Lowerer_add_extern_4(self, "p_kv_cache_append", IrType::I64, IrType::I64, tensor_ty, tensor_ty, IrType::Void);
    Lowerer_add_extern_2(self, "p_kv_cache_get", IrType::I64, IrType::I64, tensor_ty);
    Lowerer_add_extern_2(self, "p_kv_cache_len", IrType::I64, IrType::I64, IrType::I64);
    Lowerer_add_extern_1(self, "p_kv_cache_clear", IrType::I64, IrType::Void);
    Lowerer_add_extern_2(self, "p_kv_cache_evict", IrType::I64, IrType::I64, IrType::Void);

    // Quantization
    Lowerer_add_extern_3(self, "p_quantize_q8", tensor_ty, IrType::F64, IrType::I64, tensor_ty);
    Lowerer_add_extern_3(self, "p_dequantize_q8", tensor_ty, IrType::F64, IrType::I64, tensor_ty);
    Lowerer_add_extern_2(self, "p_qmatmul", tensor_ty, tensor_ty, tensor_ty);
