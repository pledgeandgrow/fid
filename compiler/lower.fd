                            // the word is the address of a heap copy (it was
                            // the local array's, dead after the return; a
                            // match reads the payload as that address)
                            IrType::Array(_, _) => {
                                is_inline_struct = false;
                                arg_val = Lowerer_arr_heap_copy(self, arg_val, declared_ir_ty);
                                arg_ty = Lowerer_get_value_type(self, arg_val);
                            }
                            _ => {
                                is_inline_struct = false;
