    Lowerer_add_extern_3(self, "p_http_build_response", IrType::I64, lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8());

    // File I/O
    Lowerer_add_extern_1(self, "p_file_read", lw_ptr_u8(), lw_ptr_u8());
